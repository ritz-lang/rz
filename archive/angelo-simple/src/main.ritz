# Angelo - Minimal Render Test
#
# A minimal test that writes a PGM image
#
# Run: ./rz run angelo-simple
# View: feh test_output.pgm

import ritzlib.sys { sys_open, sys_write, sys_close, O_WRONLY, O_CREAT, O_TRUNC }
import ritzlib.strview
import ritzlib.gvec
import ritzlib.str { streq }
import ritzlib.io { prints }

pub fn main(argc: i32, argv: **u8) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if argc > 1
        let arg1: *u8 = *(argv + 1)
        if streq(arg1, c"-h") != 0 or streq(arg1, c"--help") != 0
            prints("Usage: simple-render\n")
            prints("  Writes a 50x50 gradient to test_output.pgm in the current directory.\n")
            return 0
    print("Angelo Minimal Render Test\n")

    let width: u32 = 50
    let height: u32 = 50

    # Create image data
    var data = vec_with_cap<u8>((width * height) as i64)

    # Fill with gradient
    var y: u32 = 0
    while y < height
        var x: u32 = 0
        while x < width
            let val = ((x + y) * 255 / (width + height)) as u8
            data.push(val)
            x = x + 1
        y = y + 1

    # Write PGM
    let flags = O_WRONLY | O_CREAT | O_TRUNC
    let path: StrView = "test_output.pgm"
    let cstr = path.as_ptr()
    let fd = sys_open(cstr, flags)
    if fd < 0
        print("Failed to open file\n")
        return 1

    # Build header: "P5\n50 50\n255\n"
    var header = vec_new<u8>()
    header.push(80 as u8)   # 'P'
    header.push(53 as u8)   # '5'
    header.push(10 as u8)   # '\n'
    header.push(53 as u8)   # '5'
    header.push(48 as u8)   # '0'
    header.push(32 as u8)   # ' '
    header.push(53 as u8)   # '5'
    header.push(48 as u8)   # '0'
    header.push(10 as u8)   # '\n'
    header.push(50 as u8)   # '2'
    header.push(53 as u8)   # '5'
    header.push(53 as u8)   # '5'
    header.push(10 as u8)   # '\n'

    # Write header
    let h_ptr = header.as_ptr()
    let h_len = header.len()
    let w1 = sys_write(fd, h_ptr, h_len)
    if w1 < 0
        sys_close(fd)
        print("Failed to write header\n")
        return 1

    # Write pixel data
    let d_ptr = data.as_ptr()
    let d_len = data.len()
    let w2 = sys_write(fd, d_ptr, d_len)
    if w2 < 0
        sys_close(fd)
        print("Failed to write data\n")
        return 1

    sys_close(fd)

    print("Wrote test_output.pgm successfully!\n")
    print("View with: feh test_output.pgm\n")
    0
