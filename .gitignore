# Build artifacts
build/
.build/
*.o
*.ll
*.bc
*.s

# Task-room worktrees (spawned agent rooms live here)
.claude/worktrees/

# Temp dirs (repo root and cryptosec compile temps)
/tmp*/
projects/cryptosec/tmp*/

# Compiled project binaries (reproducible via make build)
projects/nexus/nexus
projects/zeus/zeus
projects/zeus/test_client
projects/tome/tome-cli
projects/tome/tome-server
projects/tome/run-tests
projects/goliath/goliath-tests
projects/rzrz/rzrz

# Incremental-compilation cache (per-function token hash + cached LLVM IR).
# These are build artifacts — regenerated on every compile. Never commit.
*.ritz.sig

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# Logs
logs/

# Temporary files
*.tmp
*.bak

# Core dumps (never commit these — one slipped into mausoleum before,
# removed in Phase II-E cleanup)
core
core.*
**/core.[0-9]*

# Agent migration docs (temporary)
MIGRATION_INSTRUCTIONS.md
.claude/scheduled_tasks.lock

# Machine-local room permissions, written by .claude/provision-room.sh.
# Contains this host's permission grants for a headless agent; it is per-worktree
# state, not project configuration, and must never be committed from a task room.
.claude/settings.json
.claude/settings.local.json
