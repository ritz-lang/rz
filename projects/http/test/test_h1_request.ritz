    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request_line(@req, @input)
    if result >= 0
        return 1  # Should fail

    return 0

# ============================================================================
# Header Parsing Tests
# ============================================================================

[[test]]
fn test_parse_header_content_length() -> i32
    var input: Span<u8> = "Content-Length: 42\r\n"
    var name: Span<u8>
    var value: Span<u8>

    let result: i32 = h1_parse_header(@input, @name, @value)
    if result < 0
        return 1

    var expected_name: Span<u8> = "Content-Length"
    var expected_value: Span<u8> = "42"

    if not span_eq(@name, @expected_name)
        return 2

    if not span_eq(@value, @expected_value)
        return 3

    return 0

[[test]]
fn test_parse_header_content_type() -> i32
    var input: Span<u8> = "Content-Type: application/json\r\n"
    var name: Span<u8>
    var value: Span<u8>

    let result: i32 = h1_parse_header(@input, @name, @value)
    if result < 0
        return 1

    var expected_value: Span<u8> = "application/json"
    if not span_eq(@value, @expected_value)
        return 2

    return 0

[[test]]
fn test_parse_header_with_spaces() -> i32
    var input: Span<u8> = "Host:   example.com  \r\n"
    var name: Span<u8>
    var value: Span<u8>

    let result: i32 = h1_parse_header(@input, @name, @value)
    if result < 0
        return 1

    # Value should be trimmed
    var expected_value: Span<u8> = "example.com"
    if not span_eq(@value, @expected_value)
        return 2

    return 0

[[test]]
fn test_parse_header_empty_line() -> i32
    var input: Span<u8> = "\r\n"
    var name: Span<u8>
    var value: Span<u8>

    let result: i32 = h1_parse_header(@input, @name, @value)
    # Empty line signals end of headers - should return 0 with empty name
    if result != 0
        return 1

    if name.len != 0
        return 2

    return 0

# ============================================================================
# Full Request Parsing Tests
# ============================================================================

[[test]]
fn test_parse_full_request_no_body() -> i32
    var input: Span<u8> = "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    if req.method != METHOD_GET
        return 2

    if req.header_count != 2
        return 3

    return 0

[[test]]
fn test_parse_full_request_with_body() -> i32
    var input: Span<u8> = "POST /api HTTP/1.1\r\nContent-Length: 13\r\n\r\nHello, World!"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    if req.method != METHOD_POST
        return 2

    if req.content_length != 13
        return 3

    var expected_body: Span<u8> = "Hello, World!"
    if not span_eq(@req.body, @expected_body)
        return 4

    return 0

[[test]]
fn test_parse_request_get_header() -> i32
    var input: Span<u8> = "GET / HTTP/1.1\r\nHost: localhost:8080\r\nUser-Agent: test\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    var host: Span<u8> = h1_request_get_header(@req, c"Host")
    var expected: Span<u8> = "localhost:8080"
    if not span_eq(@host, @expected)
        return 2

    var ua: Span<u8> = h1_request_get_header(@req, c"User-Agent")
    var expected_ua: Span<u8> = "test"
    if not span_eq(@ua, @expected_ua)
        return 3

    return 0

[[test]]
fn test_parse_request_header_case_insensitive() -> i32
    var input: Span<u8> = "GET / HTTP/1.1\r\nhost: localhost\r\ncontent-type: text/html\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    # Should find headers regardless of case
    var host: Span<u8> = h1_request_get_header(@req, c"HOST")
    if host.len == 0
        return 2

    var ct: Span<u8> = h1_request_get_header(@req, c"Content-Type")
    if ct.len == 0
        return 3

    return 0

[[test]]
fn test_parse_request_keep_alive_http11() -> i32
    var input: Span<u8> = "GET / HTTP/1.1\r\nHost: test\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    # HTTP/1.1 defaults to keep-alive
    if h1_request_is_keep_alive(@req) != 1
        return 2

    return 0

[[test]]
fn test_parse_request_keep_alive_http10() -> i32
    var input: Span<u8> = "GET / HTTP/1.0\r\nHost: test\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    # HTTP/1.0 defaults to close
    if h1_request_is_keep_alive(@req) != 0
        return 2

    return 0

[[test]]
fn test_parse_request_connection_close() -> i32
    var input: Span<u8> = "GET / HTTP/1.1\r\nConnection: close\r\n\r\n"
    var req: H1Request
    h1_request_init(@req)

    let result: i32 = h1_parse_request(@req, @input)
    if result < 0
        return 1

    # Explicit close overrides default
    if h1_request_is_keep_alive(@req) != 0
        return 2

    return 0

# ============================================================================
# Framing (AGAST #1865): h1_parse_request decides where a request ends with
# lib.h1_framing, so it rejects what could be smuggled and decodes chunked.
# ============================================================================

# Copy a C string into buf so a chunked body can be decoded in place.
fn copy_in(buf: *u8, s: *u8) -> Span<u8>
    let n: i64 = strlen(s)
    for i in 0..n
        *(buf + i) = *(s + i)
    var sp: Span<u8>
    sp.ptr = buf
    sp.len = n
    return sp

fn parse_text(s: StrView) -> i32
    var input: Span<u8> = span_from_strview(s)
    var req: H1Request
    return h1_parse_request(@req, @input)

[[test]]
fn test_parse_request_cl_and_te_is_invalid() -> i32
    if parse_text("POST / HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n") != H1_ERR_INVALID
        return 1
    return 0

[[test]]
fn test_parse_request_duplicate_cl_is_invalid() -> i32
    if parse_text("POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc") != H1_ERR_INVALID
        return 1
    return 0

[[test]]
fn test_parse_request_invalid_cl_is_invalid() -> i32
    # Was parsed as "no body", leaving "abc" to be read as the next request.
    if parse_text("POST / HTTP/1.1\r\nContent-Length: x3\r\n\r\nabc") != H1_ERR_INVALID
        return 1
    return 0

[[test]]
fn test_parse_request_unsupported_te_is_not_implemented() -> i32
    if parse_text("POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n") != H1_ERR_NOT_IMPLEMENTED
        return 1
    return 0

[[test]]
fn test_parse_request_cl_is_i64() -> i32
    var input: Span<u8> = "POST / HTTP/1.1\r\nContent-Length: 9999999999\r\n\r\n"
    var req: H1Request
    if h1_parse_request(@req, @input) != H1_ERR_INCOMPLETE
        return 1
    if req.content_length != 9999999999
        return 2
    return 0

[[test]]
fn test_parse_request_chunked_body() -> i32
    var buf: [256]u8
    var input: Span<u8> = copy_in(@buf[0], c"POST /up HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nHello,\r\n7\r\n World!\r\n0\r\n\r\n")
    var req: H1Request
    let result: i32 = h1_parse_request(@req, @input)
    if result as i64 != input.len
        return 1
    if req.content_length != 13
        return 2
    var expected: Span<u8> = "Hello, World!"
    if not span_eq(@req.body, @expected)
        return 3
    return 0

[[test]]
fn test_parse_request_body_split_is_incomplete() -> i32
    var input: Span<u8> = "POST / HTTP/1.1\r\nContent-Length: 13\r\n\r\nHello, World!"
    input.len = input.len - 1
    var req: H1Request
    if h1_parse_request(@req, @input) != H1_ERR_INCOMPLETE
        return 1
    var buf: [256]u8
    var chunked: Span<u8> = copy_in(@buf[0], c"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nHello,\r\n0\r\n")
    if h1_parse_request(@req, @chunked) != H1_ERR_INCOMPLETE
        return 2
    return 0

[[test]]
fn test_parse_request_pipelined_consumes_one() -> i32
    var input: Span<u8> = "POST /a HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcGET /b HTTP/1.1\r\n\r\n"
    var req: H1Request
    if h1_parse_request(@req, @input) != 42
        return 1
    var expected: Span<u8> = "abc"
    if not span_eq(@req.body, @expected)
        return 2
    return 0

[[test]]
fn test_parse_request_split_line_is_incomplete() -> i32
    # A read can end anywhere in the request line or a header name: wait
    # for more instead of calling it malformed.
    if parse_text("POST /u") != H1_ERR_INCOMPLETE
        return 1
    if parse_text("POST") != H1_ERR_INCOMPLETE
        return 2
    if parse_text("POST /u HTTP/1.1\r\nContent-Le") != H1_ERR_INCOMPLETE
        return 3
    # A whole line without its parts is still malformed.
    if parse_text("POST\r\n\r\n") != H1_ERR_INVALID
        return 4
    if parse_text("POST /u HTTP/1.1\r\nNoColon\r\n\r\n") != H1_ERR_INVALID
        return 5
    return 0
