# test/test_h1_framing.ritz - HTTP/1 request framing (AGAST #1865)
#
# h1_frame_request decides where a request ends in a byte stream, so a
# server can keep reading until it is whole and keep the bytes behind it
# (a pipelined next request).  It is the one place valet and this package
# decide message length: Content-Length as an i64, chunked
# Transfer-Encoding, and the smuggling cases RFC 9112 6.3 says to reject.

import ritzlib.strview
import ritzlib.span
import lib.h1_framing

# The first `n` bytes of `s`.
fn bytes_to(s: StrView, n: i64) -> [u8]
    return span_from_strview(s).to(n)

fn frame(s: StrView, max_body: i64, f: *H1Frame) -> i64
    return h1_frame_request(span_from_strview(s), max_body, f)

fn frame_of(s: StrView) -> i64
    var f: H1Frame
    return frame(s, 0, @f)

# 1 when `got` equals `want`.
fn bytes_eq(got: [u8], want: StrView) -> i32
    if got.as_strview().eq(want)
        return 1
    return 0


# ============================================================================
# Content-Length
# ============================================================================

[[test]]
fn test_no_body() -> i32
    var f: H1Frame
    let r = "GET / HTTP/1.1\r\nHost: x\r\n\r\n"
    if frame(r, 0, @f) != r.len()
        return 1
    if f.body_kind != H1F_BODY_NONE or f.body_len != 0
        return 2
    if f.headers_end != r.len()
        return 3
    return 0

[[test]]
fn test_content_length_body() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"
    if frame(r, 0, @f) != r.len()
        return 1
    if f.body_kind != H1F_BODY_LENGTH or f.body_len != 5
        return 2
    if f.headers_end != r.len() - 5
        return 3
    return 0

[[test]]
fn test_content_length_is_i64() -> i32
    # 5000000000 does not fit an i32; it is a valid length, still on the wire.
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nContent-Length: 5000000000\r\n\r\n"
    if frame(r, 0, @f) != H1F_INCOMPLETE
        return 1
    if f.body_len != 5000000000
        return 2
    if f.total != r.len() + 5000000000
        return 3
    return 0

[[test]]
fn test_content_length_over_max_is_too_large() -> i32
    var f: H1Frame
    if frame("POST / HTTP/1.1\r\nContent-Length: 1001\r\n\r\n", 1000, @f) != H1F_TOO_LARGE
        return 1
    return 0

[[test]]
fn test_content_length_overflowing_i64_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 99999999999999999999\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    return 0

# The value is read by ritzlib's strview_parse_i64 (#4036): digits only,
# the whole i64 range.  i64::MAX parses, and is too large to frame (the
# request's total would overflow i64); anything past it, or signed, is bad.
[[test]]
fn test_content_length_extremes() -> i32
    var f: H1Frame
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n") != 38
        return 1
    if frame("POST / HTTP/1.1\r\nContent-Length: 9223372036854775807\r\n\r\n", 0, @f) != H1F_TOO_LARGE
        return 2
    if frame("POST / HTTP/1.1\r\nContent-Length: 9223372036854775807\r\n\r\n", 1000, @f) != H1F_TOO_LARGE
        return 3
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 9223372036854775808\r\n\r\n") != H1F_BAD_REQUEST
        return 4
    if frame_of("POST / HTTP/1.1\r\nContent-Length: -9223372036854775808\r\n\r\n") != H1F_BAD_REQUEST
        return 5
    if frame_of("POST / HTTP/1.1\r\nContent-Length: +0\r\n\r\n") != H1F_BAD_REQUEST
        return 6
    if frame_of("POST / HTTP/1.1\r\nContent-Length: x\r\n\r\n") != H1F_BAD_REQUEST
        return 7
    return 0

[[test]]
fn test_content_length_overflowing_total_is_too_large() -> i32
    # Fits an i64, but the header bytes plus it do not.
    var f: H1Frame
    if frame("POST / HTTP/1.1\r\nContent-Length: 9223372036854775790\r\n\r\n", 0, @f) != H1F_TOO_LARGE
        return 1
    return 0

[[test]]
fn test_content_length_ows_is_trimmed() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nContent-Length: \t3 \r\n\r\nabc"
    if frame(r, 0, @f) != r.len()
        return 1
    return 0

[[test]]
fn test_invalid_content_length_is_bad() -> i32
    # Was "no body": the bytes after the headers then parsed as a request.
    if frame_of("POST / HTTP/1.1\r\nContent-Length: abc\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 12abc\r\n\r\n") != H1F_BAD_REQUEST
        return 2
    if frame_of("POST / HTTP/1.1\r\nContent-Length: -1\r\n\r\n") != H1F_BAD_REQUEST
        return 3
    if frame_of("POST / HTTP/1.1\r\nContent-Length:\r\n\r\n") != H1F_BAD_REQUEST
        return 4
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 5, 5\r\n\r\nhello") != H1F_BAD_REQUEST
        return 5
    if frame_of("POST / HTTP/1.1\r\nContent-Length: +5\r\n\r\nhello") != H1F_BAD_REQUEST
        return 6
    return 0

[[test]]
fn test_duplicate_content_length_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!") != H1F_BAD_REQUEST
        return 1
    # Even when they agree: one length, one header.
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 5\r\ncontent-length: 5\r\n\r\nhello") != H1F_BAD_REQUEST
        return 2
    return 0

[[test]]
fn test_header_name_case_insensitive() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\ncOnTeNt-LeNgTh: 2\r\n\r\nhi"
    if frame(r, 0, @f) != r.len()
        return 1
    return 0

[[test]]
fn test_similar_header_names_are_not_framing() -> i32
    var f: H1Frame
    let r = "GET / HTTP/1.1\r\nX-Content-Length: 5\r\nContent-Lengthy: 7\r\nTransfer-Encodings: gzip\r\n\r\n"
    if frame(r, 0, @f) != r.len()
        return 1
    if f.body_kind != H1F_BODY_NONE
        return 2
    return 0

[[test]]
fn test_space_before_colon_is_bad() -> i32
    # RFC 9112 5.1: a server MUST reject whitespace between name and colon,
    # or "Content-Length : 5" frames differently here and in a proxy.
    if frame_of("POST / HTTP/1.1\r\nContent-Length : 5\r\n\r\nhello") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_obs_fold_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nX-A: 1\r\n Content-Length: 5\r\n\r\nhello") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_bare_lf_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 5\nX: y\r\n\r\nhello") != H1F_BAD_REQUEST
        return 1
    if frame_of("GET / HTTP/1.1\n\n") != H1F_BAD_REQUEST
        return 2
    return 0


# ============================================================================
# Transfer-Encoding
# ============================================================================

[[test]]
fn test_cl_and_te_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n0\r\n\r\n") != H1F_BAD_REQUEST
        return 2
    return 0

[[test]]
fn test_unsupported_te_is_not_implemented() -> i32
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n") != H1F_NOT_IMPLEMENTED
        return 1
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n") != H1F_NOT_IMPLEMENTED
        return 2
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n") != H1F_NOT_IMPLEMENTED
        return 3
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked, identity\r\n\r\n") != H1F_NOT_IMPLEMENTED
        return 4
    return 0

[[test]]
fn test_chunked_body() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: Chunked \r\n\r\n5\r\nhello\r\n7;ext=1\r\n, world\r\n0\r\nX-Trailer: t\r\n\r\n"
    if frame(r, 0, @f) != r.len()
        return 1
    if f.body_kind != H1F_BODY_CHUNKED or f.body_len != 12
        return 2
    return 0

[[test]]
fn test_chunked_dechunk_in_place() -> i32
    var storage: [128]u8
    let buf: [u8] = @storage
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\nA\r\n, world!!!\r\n0\r\n\r\nGET /next"
    let n: i64 = r.len()
    for i in 0..n
        buf[i] = r.get(i)
    var f: H1Frame
    let total: i64 = h1_frame_request(buf.to(n), 0, @f)
    if total != n - 9
        return 1
    if h1_frame_dechunk(buf.to(n), @f) != 15
        return 2
    if bytes_eq(buf.slice(f.headers_end, f.headers_end + 15), "hello, world!!!") == 0
        return 3
    # The pipelined bytes behind it are untouched.
    if bytes_eq(buf.slice(total, total + 9), "GET /next") == 0
        return 4
    return 0

[[test]]
fn test_chunked_incomplete_at_every_split() -> i32
    # Every proper prefix of a chunked request is incomplete, never an error:
    # a body split across recv() calls must keep being read.
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4;a=b\r\nWiki\r\n10\r\n0123456789abcdef\r\n0\r\nT: 1\r\n\r\n"
    let n: i64 = r.len()
    var f: H1Frame
    for cut in 0..n
        if h1_frame_request(bytes_to(r, cut), 0, @f) != H1F_INCOMPLETE
            return (cut + 1) as i32
    if h1_frame_request(bytes_to(r, n), 0, @f) != n
        return 1000
    if f.body_len != 20
        return 1001
    return 0

[[test]]
fn test_content_length_incomplete_at_every_split() -> i32
    let r = "POST /p HTTP/1.1\r\nContent-Length: 11\r\n\r\nhello world"
    let n: i64 = r.len()
    var f: H1Frame
    for cut in 0..n
        if h1_frame_request(bytes_to(r, cut), 0, @f) != H1F_INCOMPLETE
            return (cut + 1) as i32
    if h1_frame_request(bytes_to(r, n), 0, @f) != n
        return 1000
    return 0

[[test]]
fn test_chunked_bad_size_line() -> i32
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n") != H1F_BAD_REQUEST
        return 1
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n\r\n") != H1F_BAD_REQUEST
        return 2
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n-5\r\n") != H1F_BAD_REQUEST
        return 3
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\nhello\r\n0\r\n\r\n") != H1F_BAD_REQUEST
        return 4
    # 17 hex digits overflow an i64's 15-digit budget.
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n10000000000000000\r\n") != H1F_BAD_REQUEST
        return 5
    return 0

[[test]]
fn test_chunked_leading_zeros_are_fine() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n00000000000000000002\r\nhi\r\n000\r\n\r\n"
    if frame(r, 0, @f) != r.len()
        return 1
    if f.body_len != 2
        return 2
    return 0

[[test]]
fn test_chunked_data_without_crlf_is_bad() -> i32
    if frame_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabcX\r\n0\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_chunked_over_max_is_too_large() -> i32
    var f: H1Frame
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello!\r\n6\r\nhello!\r\n0\r\n\r\n"
    if frame(r, 10, @f) != H1F_TOO_LARGE
        return 1
    # A declared chunk over the limit fails before its data arrives.
    if frame("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nFFFFFF\r\n", 10, @f) != H1F_TOO_LARGE
        return 2
    return 0


# ============================================================================
# Pipelining and status mapping
# ============================================================================

[[test]]
fn test_pipelined_requests_frame_one_at_a_time() -> i32
    let r = "POST /a HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcGET /b HTTP/1.1\r\n\r\nPOST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nz\r\n0\r\n\r\n"
    let n: i64 = r.len()
    var f: H1Frame
    let a: i64 = h1_frame_request(bytes_to(r, n), 0, @f)
    if a != 42
        return 1
    let b: i64 = h1_frame_request(span_from_strview(r).slice(a, n), 0, @f)
    if b != 19
        return 2
    let c: i64 = h1_frame_request(span_from_strview(r).slice(a + b, n), 0, @f)
    if c != n - a - b
        return 3
    if f.body_kind != H1F_BODY_CHUNKED or f.body_len != 1
        return 4
    return 0

[[test]]
fn test_status_for_errors() -> i32
    if h1_frame_status(H1F_BAD_REQUEST) != 400
        return 1
    if h1_frame_status(H1F_NOT_IMPLEMENTED) != 501
        return 2
    if h1_frame_status(H1F_TOO_LARGE) != 413
        return 3
    if h1_frame_status(H1F_INCOMPLETE) != 0
        return 4
    if h1_frame_status(42) != 0
        return 5
    return 0


# ============================================================================
# Resuming (h1_frame_continue): a server reading a big body calls again as
# each recv lands; it must not re-walk every chunk from the start each time,
# or a body of tiny chunks dripped in costs time quadratic in its size.
# ============================================================================

[[test]]
fn test_continue_matches_fresh_at_every_length() -> i32
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4;a=b\r\nWiki\r\n10\r\n0123456789abcdef\r\n1\r\nz\r\n0\r\nT: 1\r\n\r\nGET"
    let n: i64 = r.len()
    var f: H1Frame
    h1_frame_init(@f)
    var fresh: H1Frame
    for cut in 0..n + 1
        let a: i64 = h1_frame_continue(bytes_to(r, cut), 0, @f)
        let b: i64 = h1_frame_request(bytes_to(r, cut), 0, @fresh)
        if a != b
            return (cut + 1) as i32
    if f.body_len != 21 or f.total != n - 3
        return 1000
    return 0

[[test]]
fn test_continue_resumes_after_the_last_whole_chunk() -> i32
    var storage: [128]u8
    let buf: [u8] = @storage
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n"
    let n: i64 = r.len()
    for i in 0..n
        buf[i] = r.get(i)
    var f: H1Frame
    h1_frame_init(@f)
    if h1_frame_continue(buf.to(n), 0, @f) != H1F_INCOMPLETE
        return 1
    if f.walk_pos != n or f.walk_sum != 6
        return 2
    # The chunks already walked are not looked at again: garble one.
    buf[f.headers_end] = 'z'
    let tail = "0\r\n\r\n"
    for i in 0..5
        buf[n + i] = tail.get(i)
    if h1_frame_continue(buf.to(n + 5), 0, @f) != n + 5
        return 3
    if f.body_len != 6
        return 4
    return 0

[[test]]
fn test_continue_content_length_waits_without_rescanning() -> i32
    var f: H1Frame
    h1_frame_init(@f)
    let r = "POST / HTTP/1.1\r\nContent-Length: 4\r\n\r\nab"
    if h1_frame_continue(bytes_to(r, r.len()), 0, @f) != H1F_INCOMPLETE
        return 1
    if h1_frame_continue(bytes_to("garbage, never rescanned......................", r.len() + 2), 0, @f) != r.len() + 2
        return 2
    return 0

[[test]]
fn test_continue_limit_applies_across_calls() -> i32
    let r = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello!\r\n6\r\nhello!\r\n0\r\n\r\n"
    var f: H1Frame
    h1_frame_init(@f)
    if h1_frame_continue(bytes_to(r, 60), 10, @f) != H1F_INCOMPLETE
        return 1
    if h1_frame_continue(bytes_to(r, r.len()), 10, @f) != H1F_TOO_LARGE
        return 2
    return 0
