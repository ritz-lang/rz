# Request Writing Tests
# ============================================================================

[[test]]
fn test_write_request_line_get() -> i32
    var buf: [64]u8
    let len: i32 = h1_write_request_line(@buf[0], 64, METHOD_GET, c"/", VERSION_HTTP11)

    if len <= 0
        return 1

    var written: Span<u8> = span_from_ptr<u8>(@buf[0], len as i64)
    var expected: Span<u8> = span_from_cstr(c"GET / HTTP/1.1\r\n")
    if span_eq(@written, @expected) != 1
        return 2

    return 0

