[[test]]
fn test_write_crlf() -> i32
    var buf: [8]u8
    let len: i32 = h1_write_crlf(@buf[0], 8)

    if len != 2
        return 1

    if buf[0] != '\r'
        return 2
    if buf[1] != '\n'
        return 3

    return 0

# AGAST #1950: Content-Length goes through ritzlib.fmt. Zero and i64::MAX
# print in full; a negative length is not a valid header and writes nothing
# (it used to write "Content-Length: \r\n").
[[test]]
fn test_write_content_length_extremes() -> i32
    var buf: [64]u8
    var len: i32 = h1_write_content_length(@buf[0], 64, 0)
    var written: Span<u8> = span_from_ptr<u8>(@buf[0], len as i64)
    var expected: Span<u8> = span_from_cstr(c"Content-Length: 0\r\n")
    if span_eq(@written, @expected) != 1
        return 1

    len = h1_write_content_length(@buf[0], 64, 9223372036854775807)
    written = span_from_ptr<u8>(@buf[0], len as i64)
    expected = span_from_cstr(c"Content-Length: 9223372036854775807\r\n")
    if span_eq(@written, @expected) != 1
        return 2

    if h1_write_content_length(@buf[0], 64, -1) != 0
        return 3
    if h1_write_content_length(@buf[0], 64, -9223372036854775807 - 1) != 0
        return 4

    # Too small for the digits: nothing written.
    if h1_write_content_length(@buf[0], 20, 9223372036854775807) != 0
        return 5
    return 0

# AGAST #1950: the status code must be exactly three digits. It used to be
# taken mod 1000, so 1200 wrote "200" and negatives wrote non-digits.
[[test]]
fn test_write_status_line_out_of_range() -> i32
    var buf: [64]u8
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 1200) != 0
        return 1
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 99) != 0
        return 2
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 0) != 0
        return 3
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 2147483647) != 0
        return 4
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, -2147483647 - 1) != 0
        return 5

    # 100 and 999 are the edges that stay valid.
    let len: i32 = h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 100)
    if len < 13
        return 6
    if buf[9] != '1' || buf[10] != '0' || buf[11] != '0' || buf[12] != ' '
        return 7
    if h1_write_status_line(@buf[0], 64, VERSION_HTTP11, 999) < 13
        return 8
    if buf[9] != '9' || buf[10] != '9' || buf[11] != '9'
        return 9
    return 0

