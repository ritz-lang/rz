# lib/main_helpers.ritz - Helper functions for Zeus main entry point
#
# This module provides:
#   - CLI argument parsing
#   - String utilities
#   - Worker environment setup
#
# The actual main() function is in src/main.ritz

import ritzlib.sys
import ritzlib.option
import ritzlib.strview { StrView }
import ritzlib.span { Span }
import ritzlib.fd { Fd, fd_adopt }
import ritzlib.process { Exec, ForkResult, exec_prepare, fork, process_id, parent_process_id, SigSet, sigset_empty, sigset_of, SIGNALFD_NONBLOCK, SIGNALFD_CLOEXEC }
import ritzlib.string { String, string_from_i64 }
import ritzlib.result
import ritzlib.errno

# ============================================================================
# Constants
# ============================================================================

pub const DEFAULT_WORKER_COUNT: i32 = 4
pub const DEFAULT_SHM_SIZE: i64 = 2097152      # 2 MB
pub const DEFAULT_RING_CAPACITY: i64 = 256

# ============================================================================
# Options Structure
# ============================================================================

pub struct ZeusOptions
    worker_count: i32           # 0: Number of workers
    _pad1: i32                  # 4: Padding
    shm_size: i64               # 8: Shared memory size per worker
    ring_capacity: i64          # 16: Ring buffer capacity
    socket_path: StrView        # Unix socket path
    pid_file: StrView           # PID file path
    app_module: StrView         # Application module to load (empty: none given)
    foreground: i32             # 48: Run in foreground (don't daemonize)
    verbose: i32                # 52: Verbose logging

# Initialize with defaults
pub fn zeus_options_init(opts: *ZeusOptions)
    opts.worker_count = DEFAULT_WORKER_COUNT
    opts.shm_size = DEFAULT_SHM_SIZE
    opts.ring_capacity = DEFAULT_RING_CAPACITY
    opts.socket_path = "/run/zeus/zeus.sock"
    opts.pid_file = "/run/zeus/zeus.pid"
    opts.app_module = ""
    opts.foreground = 0
    opts.verbose = 0

# ============================================================================
# Argument Parsing
# ============================================================================

# Parse command line arguments from main's argument span (args[0] is the
# program name).  Values are kept as StrViews into `args`.
# Returns 0 on success, 1 if help was requested, -1 on error.
pub fn zeus_parse_args(opts: *ZeusOptions, args: Span<StrView>) -> i32
    var i: i64 = 1  # Skip program name
    while i < args.len
        let arg: StrView = args[i]

        if arg.eq("-w")
            # Worker count
            i = i + 1
            if i >= args.len
                return -1
            match args[i].parse_i64()
                Some(n) =>
                    if n < -2147483647 - 1 or n > 2147483647
                        return -1
                    opts.worker_count = n as i32
                None => return -1
        else if arg.eq("-m")
            # SHM size
            i = i + 1
            if i >= args.len
                return -1
            match args[i].parse_i64()
                Some(n) => opts.shm_size = n
                None => return -1
        else if arg.eq("-r")
            # Ring capacity
            i = i + 1
            if i >= args.len
                return -1
            match args[i].parse_i64()
                Some(n) => opts.ring_capacity = n
                None => return -1
        else if arg.eq("-s")
            # Socket path
            i = i + 1
            if i >= args.len
                return -1
            opts.socket_path = args[i]
        else if arg.eq("-p")
            # PID file
            i = i + 1
            if i >= args.len
                return -1
            opts.pid_file = args[i]
        else if arg.eq("-f")
            # Foreground mode
            opts.foreground = 1
        else if arg.eq("-v")
            # Verbose
            opts.verbose = 1
        else if arg.eq("-h") or arg.eq("--help")
            # Help (caller should print usage)
            return 1
        else if arg.len > 0 and arg.get(0) == 0x2D  # Starts with '-'
            # Unknown flag
            return -1
        else
            # Positional arg - app module
            opts.app_module = arg

        i = i + 1

    return 0

# ============================================================================
# String Utilities
# ============================================================================

# The whole of `s` as a decimal i64, read by ritzlib's strview_parse_i64
# (optional sign, digits only, range-checked; AGAST #4038), or None.  The
# digit loop this replaces wrapped on overflow and stopped at the first
# non-digit.
pub fn str_to_i64(s: StrView) -> Option<i64>
    s.parse_i64()

# As str_to_i64, and the value must also fit an i32.
pub fn str_to_i32(s: StrView) -> Option<i32>
    match s.parse_i64()
        Some(n) =>
            if n < -2147483647 - 1 or n > 2147483647
                return None
            Some(n as i32)
        None => None

# ============================================================================
# Worker Environment
# ============================================================================
# Environment passed to worker processes

pub struct WorkerEnv
    shm_fd: i32                 # 0: Shared memory fd
    _pad1: i32                  # 4: Padding
    shm_size: i64               # 8: Shared memory size
    worker_id: i32              # 16: Worker slot index
    _pad2: i32                  # 20: Padding

# Initialize worker env
pub fn worker_env_init(env: *WorkerEnv)
    env.shm_fd = -1
    env.shm_size = 0
    env.worker_id = -1

# Set fd
pub fn worker_env_set_fd(env: *WorkerEnv, fd: i32)
    env.shm_fd = fd

# Set size
pub fn worker_env_set_size(env: *WorkerEnv, size: i64)
    env.shm_size = size

# Set worker id
pub fn worker_env_set_id(env: *WorkerEnv, id: i32)
    env.worker_id = id

# ============================================================================
# Process Helpers
# ============================================================================

# Fork and exec a worker process:  <app> <shm_size> <worker_id> <worker_count>
#
# worker_count is how many workers this zeus runs (-w). A worker that keeps
# state of its own must know it has siblings: consecutive requests land on
# different workers (nexus refuses private in-memory pages with > 1, AGAST
# #2459). A worker that doesn't care ignores argv[3].
#
# The worker gets zeus's environment, which is how a worker is configured
# (nexus's MAUSOLEUM_HOST / MAUSOLEUM_PORT, AGAST #3065); it used to get none.
# Returns the child's pid (in the parent), or None if the exec arguments or
# the fork failed; the child never returns.
pub fn spawn_worker(shm_fd: i32, shm_size: i64, worker_id: i32, worker_count: i32, app: StrView) -> Option<i32>
    let zeus_pid: i32 = process_id()

    # Build argv for exec
    # zeus-worker <shm_size> <worker_id> <worker_count>
    let size_s: String = string_from_i64(shm_size)
    let id_s: String = string_from_i64(worker_id as i64)
    let count_s: String = string_from_i64(worker_count as i64)

    var argv: [4]StrView
    argv[0] = app
    argv[1] = size_s.as_view()
    argv[2] = id_s.as_view()
    argv[3] = count_s.as_view()

    # argv, and zeus's environment, built in zeus, so the child allocates
    # nothing after fork.
    var ex: Exec = match exec_prepare(app, @argv)
        Ok(e) => e
        Err(_) => return None
    match fork()
        Err(_) =>
            ex.free()
            return None
        Ok(fr) => match fr
            Parent(pid) =>
                # Parent: the child has its own copy of the arrays.
                ex.free()
                return Some(pid)
            Child => pass

    # Child process
    worker_child_signal_setup(zeus_pid)

    # The fd is inherited, we just need to pass it via environment or args
    # For now, we'll use a simple approach: fd 3 is always the shm fd

    # Dup shm_fd to fd 3 if it's not already
    if shm_fd != 3
        var shm: Fd = fd_adopt(shm_fd)
        shm.dup_to(3)
        shm.close()

    # Exec (doesn't return on success); the arrays were built before fork.
    ex.run()

    # If we get here, exec failed
    sys_exit(127)
    None  # Never reached

# ============================================================================
# Signal Helpers
# ============================================================================

# Signal numbers
pub const SIGHUP: i32 = 1
pub const SIGINT: i32 = 2
pub const SIGTERM: i32 = 15
pub const SIGCHLD: i32 = 17
pub const SIGUSR1: i32 = 10
pub const SIGUSR2: i32 = 12

pub const SIGKILL: i32 = 9

const PR_SET_PDEATHSIG: i64 = 1

# The signals zeus takes through its signalfd instead of their default
# action: SIGTERM/SIGINT (stop and reap the workers) and SIGHUP (reload).
pub fn zeus_signal_mask() -> SigSet
    var set: SigSet = sigset_of(SIGTERM)
    set.add(SIGINT)
    set.add(SIGHUP)
    set

# Block zeus_signal_mask() and return a nonblocking signalfd that reads
# them (read it with ritzlib.process signalfd_read). Call before spawning
# workers, so a SIGTERM during startup is queued for the event loop, not
# fatal with workers out.
pub fn zeus_open_signalfd() -> Result<Fd, Errno>
    let set: SigSet = zeus_signal_mask()
    match set.block()
        Ok(_) => set.signalfd(SIGNALFD_NONBLOCK | SIGNALFD_CLOEXEC)
        Err(e) => Err(e)

# In a forked worker, before exec (AGAST #2465):
#   - unblock everything: the signal mask survives exec, and a worker with
#     SIGTERM still blocked from zeus's signalfd setup could not be stopped;
#   - PR_SET_PDEATHSIG: if zeus dies without stopping us (SIGKILL, crash)
#     the kernel kills the worker instead of reparenting it to init;
#   - zeus may already have died between fork and prctl, which arms
#     nothing: then our parent is no longer zeus, so exit now.
pub fn worker_child_signal_setup(zeus_pid: i32)
    # A failed unblock leaves the inherited mask: nothing to do about it
    # here, and the worker still runs (the old raw call was unchecked too).
    let none: SigSet = sigset_empty()
    match none.set_mask()
        Ok(_) => pass
        Err(_) => pass
    syscall2(SYS_PRCTL, PR_SET_PDEATHSIG, SIGKILL as i64)
    if parent_process_id() != zeus_pid
        sys_exit(1)

# Write signal to self-pipe (async-signal-safe)
pub fn signal_self_pipe_write(fd: i32, signum: i32)
    var buf: [1]u8
    buf[0] = signum as u8
    let pipe_end: Fd = fd_borrow(fd)
    let b: [u8] = @buf
    pipe_end.write(b)
