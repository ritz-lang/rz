# lib/sockaddr.ritz - the AF_UNIX socket address zeus's daemon binds and
# its clients connect to

import ritzlib.span
import ritzlib.strview

# Fill `addr` (a sockaddr_un buffer, 110 bytes) for AF_UNIX `path`: family,
# then the path, cut to leave at least one zero byte after it, then zeros.
# Returns the address length to pass to bind/connect.
pub fn sockaddr_un_fill(addr: [u8], path: StrView) -> i64
    var a: [u8] = addr
    a.zero()
    a[0] = 1   # AF_UNIX
    var name: [u8] = a[2..a.len - 1]
    let n: i64 = name.copy_from(path.as_bytes())
    2 + n
