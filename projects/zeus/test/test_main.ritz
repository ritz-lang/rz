# ============================================================================
# Test: Worker argv (AGAST #2459)
#
# A worker needs to know how many siblings it has: nexus must refuse to serve
# private in-memory pages when it is one of several, since consecutive
# requests land on different workers. zeus passes the count as argv[3].
# ============================================================================

# A scratch dir for a test that execs a script from it: `<base>/<tag><pid>`,
# NUL-terminated. An empty `base` means /tmp. (AGAST #3710)
fn scratch_dir_in(base: StrView, tag: *u8) -> String
    var b: StrView = base
    if b.len == 0
        b = "/tmp"
    var dir: String = string_from(b)
    dir.push('/')
    dir.push_cstr(tag)
    dir.push_i64(sys_getpid() as i64)
    dir.push(0)
    dir


# scratch_dir_in under $TMPDIR, not a literal /tmp: a host may mount /tmp
# noexec (a CIS policy does), and then execve of the script fails with EACCES.
fn scratch_dir(tag: *u8) -> String
    scratch_dir_in(env_get_or("TMPDIR", ""), tag)


# Exec a script that writes its arguments to `out`, wait, read them back.
fn spawn_and_capture(dir: *u8, worker_count: i32, out: *u8, out_cap: i64) -> i64
    var script: [256]u8
    var record: [256]u8
    let d: i64 = strlen(dir)
    memcpy(@script[0], dir, d)
    memcpy(@script[d], c"/w.sh", 6)
    memcpy(@record[0], dir, d)
    memcpy(@record[d], c"/argv", 6)

    # #!/bin/sh + `echo "$@" > <dir>/argv`
    let fd: i32 = sys_open3(@script[0], 577, 493)    # O_WRONLY|O_CREAT|O_TRUNC, 0755
    if fd < 0
        return -1
    let head: *u8 = c"#!/bin/sh\necho \"$@\" > "
    sys_write(fd, head, strlen(head))
    sys_write(fd, @record[0], strlen(@record[0]))
    sys_write(fd, c"\n", 1)
    sys_close(fd)

    let shm: i32 = sys_open(c"/dev/null", 0)
    let pid: i32 = spawn_worker(shm, 4096, 7, worker_count, @script[0])
    if pid <= 0
        return -2
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)

    let rfd: i32 = sys_open(@record[0], 0)
    if rfd < 0
        return -3
    let got: i64 = sys_read(rfd, out, out_cap)
    sys_close(rfd)
    sys_unlink(@record[0])
    sys_unlink(@script[0])
    got


# ============================================================================
# Test: scratch dirs follow $TMPDIR (AGAST #3710)
#
# The spawn tests exec a script from their scratch dir. A literal /tmp broke
# them on hosts that mount /tmp noexec (EACCES from execve), so the dir is
# built from $TMPDIR, falling back to /tmp only when it is unset or empty.
# ============================================================================

# `<base>/<tag><pid>` as a C string, for comparing against a scratch dir.
fn expected_scratch(base: *u8, tag: *u8) -> String
    var want: String = string_from_cstr(base)
    want.push_cstr(c"/")
    want.push_cstr(tag)
    want.push_i64(sys_getpid() as i64)
    want.push(0)
    want


[[test]]
fn test_scratch_dir_in_puts_the_dir_under_the_base() -> i32
    var dir: String = scratch_dir_in("/srv/scratch", c"zeus-argv-")
    var want: String = expected_scratch(c"/srv/scratch", c"zeus-argv-")
    let ok: i32 = streq(dir.as_ptr(), want.as_ptr()) as i32
    if ok == 0
        return 1
    0


[[test]]
fn test_scratch_dir_in_falls_back_to_tmp_for_an_empty_base() -> i32
    var dir: String = scratch_dir_in("", c"zeus-env-")
    var want: String = expected_scratch(c"/tmp", c"zeus-env-")
    let ok: i32 = streq(dir.as_ptr(), want.as_ptr()) as i32
    if ok == 0
        return 1
    0


# Whatever TMPDIR this test runs under, scratch_dir honours it, and a script
# written there is the one that runs. Run under TMPDIR=<exec-able dir> this is
# the noexec-/tmp case; with TMPDIR unset it checks the /tmp fallback.
[[test]]
fn test_scratch_dir_follows_tmpdir() -> i32
    var base: StrView = env_get_or("TMPDIR", "")
    var dir: String = scratch_dir(c"zeus-tmpdir-")
    var want: String = scratch_dir_in(base, c"zeus-tmpdir-")
    let ok: i32 = streq(dir.as_ptr(), want.as_ptr()) as i32
    if ok == 0
        return 1
    let d: *u8 = dir.as_ptr()
    sys_mkdir(d, 448)
    var out: [64]u8
    let n: i64 = spawn_and_capture(d, 2, @out[0], 64)
    sys_rmdir(d)
    if n <= 0
        return 2
    0


[[test]]
fn test_spawn_worker_passes_worker_count() -> i32
    var dir: String = scratch_dir(c"zeus-argv-")
    sys_mkdir(dir.as_ptr(), 448)
    var out: [64]u8
    let n: i64 = spawn_and_capture(dir.as_ptr(), 3, @out[0], 64)
    sys_rmdir(dir.as_ptr())
    if n < 0
        return 1
    # "<shm_size> <worker_id> <worker_count>\n"
    let want: *u8 = c"4096 7 3\n"
    if n != strlen(want)
        return 2
    for i in 0..n
        if out[i] != *(want + i)
            return 3
    0


# ============================================================================
# Test: Worker environment (AGAST #3065)
#
# zeus used to exec workers with an empty environment, so a worker could not
# be configured: nexus's MAUSOLEUM_HOST / MAUSOLEUM_PORT never arrived, and
# a test stack's nexus dialed whatever mausoleum held 127.0.0.1:7777.
# ============================================================================

fn has_prefix(s: *u8, p: *u8) -> bool
    var i: i64 = 0
    while *(p + i) != 0
        if *(s + i) != *(p + i)
            return false
        i += 1
    true


# An entry of our environment that /bin/sh would not set by itself.
fn probe_entry() -> *u8
    let envp: **u8 = env_raw_envp()
    var i: i64 = 0
    while envp != null and *(envp + i) != null
        let e: *u8 = *(envp + i)
        let skip: bool = has_prefix(e, c"PWD=") or has_prefix(e, c"OLDPWD=") or has_prefix(e, c"SHLVL=") or has_prefix(e, c"_=")
        if not skip and strchr(e, 10) == null
            return e
        i += 1
    null


[[test]]
fn test_spawn_worker_passes_the_environment() -> i32
    let want: *u8 = probe_entry()
    if want == null
        return 100     # no usable variable to look for
    var dir: String = scratch_dir(c"zeus-env-")
    let d: *u8 = dir.as_ptr()
    sys_mkdir(d, 448)
    let dl: i64 = strlen(d)
    var script: [256]u8
    var record: [256]u8
    memcpy(@script[0], d, dl)
    memcpy(@script[dl], c"/w.sh", 6)
    memcpy(@record[0], d, dl)
    memcpy(@record[dl], c"/env", 5)

    # #!/bin/sh + `env > <dir>/env`
    let fd: i32 = sys_open3(@script[0], 577, 493)
    if fd < 0
        return 1
    let head: *u8 = c"#!/bin/sh\nenv > "
    sys_write(fd, head, strlen(head))
    sys_write(fd, @record[0], strlen(@record[0]))
    sys_write(fd, c"\n", 1)
    sys_close(fd)

    let shm: i32 = sys_open(c"/dev/null", 0)
    let pid: i32 = spawn_worker(shm, 4096, 0, 1, @script[0])
    if pid <= 0
        return 2
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)

    let cap: i64 = 262144
    let out: *u8 = malloc(cap + 1)
    let rfd: i32 = sys_open(@record[0], 0)
    var n: i64 = 0
    if rfd >= 0
        loop
            let r: i64 = sys_read(rfd, out + n, cap - n)
            if r <= 0
                break
            n += r
        sys_close(rfd)
    *(out + n) = 0
    sys_unlink(@record[0])
    sys_unlink(@script[0])
    sys_rmdir(d)
    if rfd < 0
        return 3
    let found: bool = strstr(out, want) != null
    free(out)
    if found then 0 else 4

# ============================================================================
# Test: worker argv number formatting (#1957)
# ============================================================================

# i64_to_str's old `while v > 0` loop wrote an empty string for any negative
# value, i64's minimum included. Each type's extremes and 0.
[[test]]
fn test_i64_to_str_extremes() -> i32
    var buf: [21]u8
    i64_to_str(0, @buf[0])
    if not streq(@buf[0], c"0")
        return 1
    i64_to_str(9223372036854775807, @buf[0])
    if not streq(@buf[0], c"9223372036854775807")
        return 2
    i64_to_str(-9223372036854775807 - 1, @buf[0])
    if not streq(@buf[0], c"-9223372036854775808")
        return 3
    0

[[test]]
fn test_i32_to_str_extremes() -> i32
    var buf: [12]u8
    i32_to_str(0, @buf[0])
    if not streq(@buf[0], c"0")
        return 1
    i32_to_str(2147483647, @buf[0])
    if not streq(@buf[0], c"2147483647")
        return 2
    i32_to_str(-2147483648, @buf[0])
    if not streq(@buf[0], c"-2147483648")
        return 3
    0
