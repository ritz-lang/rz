[[test]]
fn test_build_worker_env() -> i32
    var env: WorkerEnv
    worker_env_init(@env)

    worker_env_set_fd(@env, 5)
    worker_env_set_size(@env, 2097152)

    if env.shm_fd != 5
        prints("FAIL: shm_fd should be 5\n")
        return 1

    if env.shm_size != 2097152
        prints("FAIL: shm_size should be 2097152\n")
        return 1

    return 0

