    return 0


# ============================================================================
# Test: Worker argv (AGAST #2459)
#
# A worker needs to know how many siblings it has: nexus must refuse to serve
# private in-memory pages when it is one of several, since consecutive
# requests land on different workers. zeus passes the count as argv[3].
# ============================================================================

# A scratch dir for a test that execs a script from it: `<base>/<tag><pid>`,
# An empty `base` means /tmp. (AGAST #3710)
fn scratch_dir_in(base: StrView, tag: StrView) -> String
    var b: StrView = base
    if b.len == 0
        b = "/tmp"
    var dir: String = string_from(b)
    dir.push('/')
    dir.push_str(tag)
    dir.push_i64(process_id() as i64)
    dir


# scratch_dir_in under $TMPDIR, not a literal /tmp: a host may mount /tmp
# noexec (a CIS policy does), and then execve of the script fails with EACCES.
fn scratch_dir(tag: StrView) -> String
    scratch_dir_in(env_get_or("TMPDIR", ""), tag)


# `<dir><name>`
fn path_in(dir: StrView, name: StrView) -> String
    var p: String = string_from(dir)
    p.push_str(name)
    p

# Write `<head><record>\n` to `script` as an executable (0755) file.
fn write_script(script: StrView, head: StrView, record: StrView) -> bool
    match fd_open(script, O_WRONLY | O_CREAT | O_TRUNC, 493)
        Ok(f) =>
            var file: Fd = f
            file.write_str(head)
            file.write_str(record)
            file.write_str("\n")
            file.close()
            true
        Err(_) => false


# A descriptor for spawn_worker's shm_fd: /dev/null, left open as before.
fn dev_null_raw() -> i32
    match fd_open("/dev/null", O_RDONLY, 0)
        Ok(f) => f.raw()
        Err(e) => -e.code()


# Exec a script that writes its arguments to `out`, wait, read them back.
fn spawn_and_capture(dir: StrView, worker_count: i32, out: [u8]) -> i64
    let script: String = path_in(dir, "/w.sh")
    let record: String = path_in(dir, "/argv")

    # #!/bin/sh + `echo "$@" > <dir>/argv`
    if !write_script(script.as_view(), "#!/bin/sh\necho \"$@\" > ", record.as_view())
        return -1

    let shm: i32 = dev_null_raw()
    let pid: i32 = match spawn_worker(shm, 4096, 7, worker_count, script.as_view())
        Some(p) => p
        None => return -2
    wait_pid(pid)

    var got: i64 = 0
    match fd_open(record.as_view(), O_RDONLY, 0)
        Ok(f) =>
            var rf: Fd = f
            match rf.read(out)
                Ok(k) => got = k
                Err(e) => got = -(e.code() as i64)
            rf.close()
        Err(_) => return -3
    unlink(record.as_view())
    unlink(script.as_view())
    got


# ============================================================================
# Test: scratch dirs follow $TMPDIR (AGAST #3710)
#
# The spawn tests exec a script from their scratch dir. A literal /tmp broke
# them on hosts that mount /tmp noexec (EACCES from execve), so the dir is
# built from $TMPDIR, falling back to /tmp only when it is unset or empty.
# ============================================================================

# `<base>/<tag><pid>`, for comparing against a scratch dir.
fn expected_scratch(base: StrView, tag: StrView) -> String
    var want: String = string_from(base)
    want.push('/')
    want.push_str(tag)
    want.push_i64(process_id() as i64)
    want


[[test]]
fn test_scratch_dir_in_puts_the_dir_under_the_base() -> i32
    var dir: String = scratch_dir_in("/srv/scratch", "zeus-argv-")
    var want: String = expected_scratch("/srv/scratch", "zeus-argv-")
    if not dir.eq(want.as_view())
        return 1
    0


[[test]]
fn test_scratch_dir_in_falls_back_to_tmp_for_an_empty_base() -> i32
    var dir: String = scratch_dir_in("", "zeus-env-")
    var want: String = expected_scratch("/tmp", "zeus-env-")
    if not dir.eq(want.as_view())
        return 1
    0


# Whatever TMPDIR this test runs under, scratch_dir honours it, and a script
# written there is the one that runs. Run under TMPDIR=<exec-able dir> this is
# the noexec-/tmp case; with TMPDIR unset it checks the /tmp fallback.
[[test]]
fn test_scratch_dir_follows_tmpdir() -> i32
    var base: StrView = env_get_or("TMPDIR", "")
    var dir: String = scratch_dir("zeus-tmpdir-")
    var want: String = scratch_dir_in(base, "zeus-tmpdir-")
    if not dir.eq(want.as_view())
        return 1
    let d: StrView = dir.as_view()
    mkdir(d, 448)
    var out: [64]u8
    let n: i64 = spawn_and_capture(d, 2, @out)
    rmdir(d)
    if n <= 0
        return 2
    0


[[test]]
fn test_spawn_worker_passes_worker_count() -> i32
    var dir: String = scratch_dir("zeus-argv-")
    let d: StrView = dir.as_view()
    mkdir(d, 448)
    var out: [64]u8
    let n: i64 = spawn_and_capture(d, 3, @out)
    rmdir(d)
    if n < 0
        return 1
    # "<shm_size> <worker_id> <worker_count>\n"
    let all: [u8] = @out
    let got: [u8] = all[0..n]
    if not got.as_strview().eq("4096 7 3\n")
        return 2
    0


# ============================================================================
# Test: Worker environment (AGAST #3065)
#
# zeus used to exec workers with an empty environment, so a worker could not
# be configured: nexus's MAUSOLEUM_HOST / MAUSOLEUM_PORT never arrived, and
# a test stack's nexus dialed whatever mausoleum held 127.0.0.1:7777.
# ============================================================================

# An entry of our environment that /bin/sh would not set by itself, from
# env_iter: the environment exec_prepare hands the worker.  Empty if none.
fn probe_entry() -> StrView
    let entries: Span<StrView> = env_iter()
    for i in 0..entries.len
        let e: StrView = entries[i]
        let skip: bool = e.starts_with("PWD=") or e.starts_with("OLDPWD=") or e.starts_with("SHLVL=") or e.starts_with("_=")
        if not skip and e.len > 0 and e.find_byte(10) == e.len
            return e
    ""


[[test]]
fn test_spawn_worker_passes_the_environment() -> i32
    let want: StrView = probe_entry()
    if want.len == 0
        return 100     # no usable variable to look for
    var dir: String = scratch_dir("zeus-env-")
    let d: StrView = dir.as_view()
    mkdir(d, 448)
    let script: String = path_in(d, "/w.sh")
    let record: String = path_in(d, "/env")

    # #!/bin/sh + `env > <dir>/env`
    if !write_script(script.as_view(), "#!/bin/sh\nenv > ", record.as_view())
        return 1

    let shm: i32 = dev_null_raw()
    let pid: i32 = match spawn_worker(shm, 4096, 0, 1, script.as_view())
        Some(p) => p
        None => return 2
    wait_pid(pid)

    var out: String = string_new()
    var opened: bool = false
    match fd_open(record.as_view(), O_RDONLY, 0)
        Ok(f) =>
            opened = true
            var rf: Fd = f
            rf.read_to_end(@&out)
            rf.close()
        Err(_) => pass
    unlink(record.as_view())
    unlink(script.as_view())
    rmdir(d)
    if !opened
        return 3
    if out.as_view().contains(want) then 0 else 4
