# test/test_main.ritz - Tests for Zeus main entry point helpers
#
# The main entry point handles:
#   - CLI argument parsing
#   - Worker process spawning (fork/exec)
#   - Signal handling
#   - Event loop
#
# Note: We can't easily test fork/exec or signal handlers in unit tests,
# so we focus on the helper functions and argument parsing.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.string { String, string_from, string_from_cstr }
import ritzlib.os.env { env_raw_envp, env_get_or }
import ritzlib.strview
import zeus.main_helpers

# ============================================================================
# Test: CLI Argument Parsing
# ============================================================================

[[test]]
fn test_parse_args_defaults() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Check defaults
    if opts.worker_count != 4
        prints("FAIL: default worker_count should be 4\n")
        return 1

    if opts.socket_path == null
        prints("FAIL: socket_path should have default\n")
        return 1

    return 0

[[test]]
fn test_parse_args_worker_count() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -w 8
    var argv: [3]*u8
    argv[0] = c"zeus"
    argv[1] = c"-w"
    argv[2] = c"8"

    let result: i32 = zeus_parse_args(@opts, 3, @argv[0])
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.worker_count != 8
        prints("FAIL: worker_count should be 8\n")
        return 1

    return 0

[[test]]
fn test_parse_args_socket_path() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -s /run/zeus.sock
    var argv: [3]*u8
    argv[0] = c"zeus"
    argv[1] = c"-s"
    argv[2] = c"/run/zeus.sock"

    let result: i32 = zeus_parse_args(@opts, 3, @argv[0])
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    # Check socket path was set (compare first char)
    if opts.socket_path == null
        prints("FAIL: socket_path should be set\n")
        return 1

    return 0

[[test]]
fn test_parse_args_shm_size() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -m 4194304 (4MB)
    var argv: [3]*u8
    argv[0] = c"zeus"
    argv[1] = c"-m"
    argv[2] = c"4194304"

    let result: i32 = zeus_parse_args(@opts, 3, @argv[0])
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.shm_size != 4194304
        prints("FAIL: shm_size should be 4194304\n")
        return 1

    return 0

[[test]]
fn test_parse_args_multiple() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -w 16 -m 8388608 -s /run/z.sock
    var argv: [7]*u8
    argv[0] = c"zeus"
    argv[1] = c"-w"
    argv[2] = c"16"
    argv[3] = c"-m"
    argv[4] = c"8388608"
    argv[5] = c"-s"
    argv[6] = c"/run/z.sock"

    let result: i32 = zeus_parse_args(@opts, 7, @argv[0])
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.worker_count != 16
        prints("FAIL: worker_count should be 16\n")
        return 1

    if opts.shm_size != 8388608
        prints("FAIL: shm_size should be 8388608\n")
        return 1

    return 0

[[test]]
fn test_parse_args_invalid() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -x (unknown flag)
    var argv: [2]*u8
    argv[0] = c"zeus"
    argv[1] = c"-x"

    let result: i32 = zeus_parse_args(@opts, 2, @argv[0])
    if result >= 0
        prints("FAIL: should fail on unknown flag\n")
        return 1

    return 0

# ============================================================================
# Test: String to Integer Conversion
# ============================================================================

# str_to_i32/str_to_i64 read the whole string through ritzlib's
# strview_parse_i64 and range-check it (AGAST #4038).  The old digit loops
# wrapped on overflow and stopped at the first non-digit, reporting success.

# true if `s` parses to exactly `want`
fn i32_reads(s: *u8, want: i32) -> bool
    var out: i32 = 77
    return str_to_i32(s, @out) == 1 and out == want

# true if `s` is rejected and *out is left alone
fn i32_rejects(s: *u8) -> bool
    var out: i32 = 77
    return str_to_i32(s, @out) == 0 and out == 77

fn i64_reads(s: *u8, want: i64) -> bool
    var out: i64 = 77
    return str_to_i64(s, @out) == 1 and out == want

fn i64_rejects(s: *u8) -> bool
    var out: i64 = 77
    return str_to_i64(s, @out) == 0 and out == 77

[[test]]
fn test_str_to_i32() -> i32
    assert i32_reads(c"123", 123)
    assert i32_reads(c"0", 0)
    assert i32_reads(c"65536", 65536)
    assert i32_reads(c"-42", -42)
    return 0

[[test]]
fn test_str_to_i32_extremes() -> i32
    assert i32_reads(c"2147483647", 2147483647)
    assert i32_reads(c"-2147483648", -2147483647 - 1)
    return 0

[[test]]
fn test_str_to_i32_out_of_range() -> i32
    # Old loop: 2147483648 wrapped to i32::MIN, 4294967297 to 1
    assert i32_rejects(c"2147483648")
    assert i32_rejects(c"-2147483649")
    assert i32_rejects(c"4294967297")
    assert i32_rejects(c"9223372036854775807")
    assert i32_rejects(c"-9223372036854775808")
    assert i32_rejects(c"9223372036854775808")
    return 0

[[test]]
fn test_str_to_i32_non_digit() -> i32
    # Old loop: "12a" read as 12, "abc" and "" as 0
    assert i32_rejects(c"12a")
    assert i32_rejects(c"abc")
    assert i32_rejects(c"")
    assert i32_rejects(c"-")
    return 0

[[test]]
fn test_str_to_i64() -> i32
    assert i64_reads(c"1048576", 1048576)
    assert i64_reads(c"4294967296", 4294967296)
    assert i64_reads(c"0", 0)
    return 0

[[test]]
fn test_str_to_i64_extremes() -> i32
    assert i64_reads(c"9223372036854775807", 9223372036854775807)
    assert i64_reads(c"-9223372036854775808", -9223372036854775807 - 1)
    return 0

[[test]]
fn test_str_to_i64_out_of_range() -> i32
    # Old loop: i64::MAX + 1 wrapped to i64::MIN
    assert i64_rejects(c"9223372036854775808")
    assert i64_rejects(c"-9223372036854775809")
    assert i64_rejects(c"18446744073709551617")
    return 0

[[test]]
fn test_str_to_i64_non_digit() -> i32
    assert i64_rejects(c"4M")
    assert i64_rejects(c"abc")
    assert i64_rejects(c"")
    assert i64_rejects(c"-")
    return 0

# zeus_parse_args fails on a number its option can't hold
fn parse_flag(flag: *u8, value: *u8) -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)
    var argv: [3]*u8
    argv[0] = c"zeus"
    argv[1] = flag
    argv[2] = value
    return zeus_parse_args(@opts, 3, @argv[0])

[[test]]
fn test_parse_args_rejects_bad_worker_count() -> i32
    assert parse_flag(c"-w", c"2147483648") == -1
    assert parse_flag(c"-w", c"8x") == -1
    return 0

[[test]]
fn test_parse_args_rejects_bad_shm_size() -> i32
    assert parse_flag(c"-m", c"9223372036854775808") == -1
    assert parse_flag(c"-m", c"4M") == -1
    return 0

[[test]]
fn test_parse_args_rejects_bad_ring_capacity() -> i32
    assert parse_flag(c"-r", c"9223372036854775808") == -1
    assert parse_flag(c"-r", c"") == -1
    return 0

# ============================================================================
# Test: String Comparison
# ============================================================================

[[test]]
fn test_str_eq_cstr() -> i32
    if str_eq_cstr(c"-w", c"-w") != 1
        prints("FAIL: -w should equal -w\n")
        return 1

    if str_eq_cstr(c"-w", c"-s") != 0
        prints("FAIL: -w should not equal -s\n")
        return 1

    if str_eq_cstr(c"hello", c"hello") != 1
        prints("FAIL: hello should equal hello\n")
        return 1

    return 0

