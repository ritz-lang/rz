# test/test_main.ritz - Tests for Zeus main entry point helpers
#
# The main entry point handles:
#   - CLI argument parsing
#   - Worker process spawning (fork/exec)
#   - Signal handling
#   - Event loop
#
# Note: We can't easily test fork/exec or signal handlers in unit tests,
# so we focus on the helper functions and argument parsing.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.string { String, string_from, string_new }
import ritzlib.os.env { env_iter, env_get_or }
import ritzlib.strview
import ritzlib.span { Span }
import ritzlib.fd { Fd, fd_open }
import ritzlib.fs { mkdir, rmdir, unlink }
import ritzlib.process { ProcessResult, wait_pid, process_id }
import ritzlib.result
import ritzlib.errno
import zeus.main_helpers

# ============================================================================
# Test: CLI Argument Parsing
# ============================================================================

[[test]]
fn test_parse_args_defaults() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Check defaults
    if opts.worker_count != 4
        prints("FAIL: default worker_count should be 4\n")
        return 1

    if not opts.socket_path.eq("/run/zeus/zeus.sock")
        prints("FAIL: socket_path should have default\n")
        return 1

    return 0

[[test]]
fn test_parse_args_worker_count() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -w 8
    var argv: [3]StrView
    argv[0] = "zeus"
    argv[1] = "-w"
    argv[2] = "8"

    let result: i32 = zeus_parse_args(@opts, @argv)
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.worker_count != 8
        prints("FAIL: worker_count should be 8\n")
        return 1

    return 0

[[test]]
fn test_parse_args_socket_path() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -s /run/zeus.sock
    var argv: [3]StrView
    argv[0] = "zeus"
    argv[1] = "-s"
    argv[2] = "/run/zeus.sock"

    let result: i32 = zeus_parse_args(@opts, @argv)
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    # Check socket path was set
    if not opts.socket_path.eq("/run/zeus.sock")
        prints("FAIL: socket_path should be set\n")
        return 1

    return 0

[[test]]
fn test_parse_args_shm_size() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -m 4194304 (4MB)
    var argv: [3]StrView
    argv[0] = "zeus"
    argv[1] = "-m"
    argv[2] = "4194304"

    let result: i32 = zeus_parse_args(@opts, @argv)
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.shm_size != 4194304
        prints("FAIL: shm_size should be 4194304\n")
        return 1

    return 0

[[test]]
fn test_parse_args_multiple() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -w 16 -m 8388608 -s /run/z.sock
    var argv: [7]StrView
    argv[0] = "zeus"
    argv[1] = "-w"
    argv[2] = "16"
    argv[3] = "-m"
    argv[4] = "8388608"
    argv[5] = "-s"
    argv[6] = "/run/z.sock"

    let result: i32 = zeus_parse_args(@opts, @argv)
    if result < 0
        prints("FAIL: parse_args failed\n")
        return 1

    if opts.worker_count != 16
        prints("FAIL: worker_count should be 16\n")
        return 1

    if opts.shm_size != 8388608
        prints("FAIL: shm_size should be 8388608\n")
        return 1

    return 0

[[test]]
fn test_parse_args_invalid() -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)

    # Simulate: zeus -x (unknown flag)
    var argv: [2]StrView
    argv[0] = "zeus"
    argv[1] = "-x"

    let result: i32 = zeus_parse_args(@opts, @argv)
    if result >= 0
        prints("FAIL: should fail on unknown flag\n")
        return 1

    return 0

# ============================================================================
# Test: String to Integer Conversion
# ============================================================================

# str_to_i32/str_to_i64 read the whole string through ritzlib's
# strview_parse_i64 and range-check it (AGAST #4038).  The old digit loops
# wrapped on overflow and stopped at the first non-digit, reporting success.

# true if `s` parses to exactly `want`
fn i32_reads(s: StrView, want: i32) -> bool
    match str_to_i32(s)
        Some(n) => n == want
        None => false

# true if `s` is rejected
fn i32_rejects(s: StrView) -> bool
    str_to_i32(s).is_none()

fn i64_reads(s: StrView, want: i64) -> bool
    match str_to_i64(s)
        Some(n) => n == want
        None => false

fn i64_rejects(s: StrView) -> bool
    str_to_i64(s).is_none()

[[test]]
fn test_str_to_i32() -> i32
    assert i32_reads("123", 123)
    assert i32_reads("0", 0)
    assert i32_reads("65536", 65536)
    assert i32_reads("-42", -42)
    return 0

[[test]]
fn test_str_to_i32_extremes() -> i32
    assert i32_reads("2147483647", 2147483647)
    assert i32_reads("-2147483648", -2147483647 - 1)
    return 0

[[test]]
fn test_str_to_i32_out_of_range() -> i32
    # Old loop: 2147483648 wrapped to i32::MIN, 4294967297 to 1
    assert i32_rejects("2147483648")
    assert i32_rejects("-2147483649")
    assert i32_rejects("4294967297")
    assert i32_rejects("9223372036854775807")
    assert i32_rejects("-9223372036854775808")
    assert i32_rejects("9223372036854775808")
    return 0

[[test]]
fn test_str_to_i32_non_digit() -> i32
    # Old loop: "12a" read as 12, "ab" and "" as 0
    assert i32_rejects("12a")
    assert i32_rejects("ab")
    assert i32_rejects("")
    assert i32_rejects("-")
    return 0

[[test]]
fn test_str_to_i64() -> i32
    assert i64_reads("1048576", 1048576)
    assert i64_reads("4294967296", 4294967296)
    assert i64_reads("0", 0)
    return 0

[[test]]
fn test_str_to_i64_extremes() -> i32
    assert i64_reads("9223372036854775807", 9223372036854775807)
    assert i64_reads("-9223372036854775808", -9223372036854775807 - 1)
    return 0

[[test]]
fn test_str_to_i64_out_of_range() -> i32
    # Old loop: i64::MAX + 1 wrapped to i64::MIN
    assert i64_rejects("9223372036854775808")
    assert i64_rejects("-9223372036854775809")
    assert i64_rejects("18446744073709551617")
    return 0

[[test]]
fn test_str_to_i64_non_digit() -> i32
    assert i64_rejects("4M")
    assert i64_rejects("ab")
    assert i64_rejects("")
    assert i64_rejects("-")
    return 0

# zeus_parse_args fails on a number its option can't hold
fn parse_flag(flag: StrView, value: StrView) -> i32
    var opts: ZeusOptions
    zeus_options_init(@opts)
    var argv: [3]StrView
    argv[0] = "zeus"
    argv[1] = flag
    argv[2] = value
    return zeus_parse_args(@opts, @argv)

[[test]]
fn test_parse_args_rejects_bad_worker_count() -> i32
    assert parse_flag("-w", "2147483648") == -1
    assert parse_flag("-w", "8x") == -1
    return 0

[[test]]
fn test_parse_args_rejects_bad_shm_size() -> i32
    assert parse_flag("-m", "9223372036854775808") == -1
    assert parse_flag("-m", "4M") == -1
    return 0

[[test]]
fn test_parse_args_rejects_bad_ring_capacity() -> i32
    assert parse_flag("-r", "9223372036854775808") == -1
    assert parse_flag("-r", "") == -1
    return 0

