# examples/test_client.ritz - Reference client for Zeus daemon
#
# A minimal client that proves the request/response shm-ring path works:
#
#   1. Connect to zeus daemon over Unix socket
#   2. Handshake (HELLO → WELCOME)
#   3. Receive WORKER_INFO + shm fd via SCM_RIGHTS, mmap the region
#   4. Write a path string into the data arena
#   5. Build a GET RequestSlot, submit it
#   6. Poll for the response, print status + body
#
# This is the harness valet's `--zeus-socket` mode will eventually use, and
# the integration test future devs need to verify zeus workers from the
# outside without spinning up valet.
#
# Usage:
#
#   $ zeus -f -v -w 1 -m 65536 -s /tmp/zeus.sock ./nexus &
#   $ test_client /tmp/zeus.sock /wiki/welcome
#   GET /wiki/welcome → 200 OK
#   <html body...>

import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.fd { fd_stdout }
import ritzlib.time { sleep_ms }

import zeus.zeus_client {
    ZeusClient,
    ZeusClientConfig,
    zeus_client_config_default,
    zeus_client_init,
    zeus_client_destroy,
    zeus_client_connect,
    zeus_client_handshake,
    zeus_client_recv_worker,
    zeus_client_get_worker,
    zeus_client_select_worker,
    zeus_client_next_request_id,
    zeus_client_submit_request,
    zeus_client_poll_response,
    worker_handle_get_arena
}
import zeus.zeus_client { WorkerHandle }
import zeus.ring {
    RequestSlot,
    ResponseSlot,
    request_slot_init,
    response_slot_init,
    HTTP_METHOD_GET,
    REQ_FLAG_COMPLETE,
    RESP_FLAG_COMPLETE
}
import zeus.arena {
    DataArena,
    data_arena_alloc,
    data_arena_ptr_to_offset,
    data_arena_bytes,
    data_arena_valid
}


# ============================================================================
# Helpers
# ============================================================================

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if args.len > 1
        let arg1: StrView = args[1]
        if arg1.eq("-h") or arg1.eq("--help")
            print("Usage: test_client <socket-path> <request-path>\n")
            print("Example: test_client /tmp/zeus.sock /wiki/welcome\n")
            print("  Sends one GET through a running zeus daemon's shm ring and prints the response.\n")
            return 0
    if args.len < 3
        print("Usage: test_client <socket-path> <request-path>\n")
        print("Example: test_client /tmp/zeus.sock /wiki/welcome\n")
        return 1

    let socket_path: StrView = args[1]
    let req_path: StrView = args[2]
    let req_path_len: i32 = req_path.len as i32

    # ------------------------------------------------------------------
    # 1. Initialize client
    # ------------------------------------------------------------------
    var cfg: ZeusClientConfig
    zeus_client_config_default(@cfg)

    var client = ZeusClient {}
    let init_rc: i32 = zeus_client_init(@client, @cfg)
    if init_rc != 0
        let rc: i64 = init_rc as i64
        print("FAIL: zeus_client_init returned {rc}\n")
        return 1

    # ------------------------------------------------------------------
    # 2. Connect + handshake
    # ------------------------------------------------------------------
    match zeus_client_connect(@client, socket_path)
        Ok(_) => pass
        Err(e) =>
            let rc: i64 = e.code() as i64
            print("FAIL: zeus_client_connect failed, errno {rc}\n  socket: {socket_path}\n")
            zeus_client_destroy(@client)
            return 1

    let hs_rc: i32 = zeus_client_handshake(@client)
    if hs_rc < 0
        let rc: i64 = hs_rc as i64
        print("FAIL: zeus_client_handshake returned {rc}\n")
        zeus_client_destroy(@client)
        return 1

    let welcomed: i64 = hs_rc as i64
    print("connected; received {welcomed} worker(s) in welcome\n")

    # ------------------------------------------------------------------
    # 3. Receive worker(s) — handshake says how many to expect
    # ------------------------------------------------------------------
    var workers_attached: i32 = 0
    while workers_attached < hs_rc
        let widx: i32 = zeus_client_recv_worker(@client)
        if widx < 0
            let rc: i64 = widx as i64
            print("FAIL: zeus_client_recv_worker returned {rc}\n")
            zeus_client_destroy(@client)
            return 1
        workers_attached += 1

    let attached: i64 = workers_attached as i64
    print("attached {attached} worker(s) via SCM_RIGHTS\n")

    # ------------------------------------------------------------------
    # 4. Pick a worker, get its arena, write the path
    # ------------------------------------------------------------------
    let worker_idx: i32 = zeus_client_select_worker(@client)
    if worker_idx < 0
        print("FAIL: no worker available for dispatch\n")
        zeus_client_destroy(@client)
        return 1

    let handle: *WorkerHandle = zeus_client_get_worker(@client, worker_idx)
    if handle == null
        print("FAIL: zeus_client_get_worker returned null\n")
        zeus_client_destroy(@client)
        return 1

    var arena: DataArena
    worker_handle_get_arena(handle, @arena)
    if not data_arena_valid(@arena)
        print("FAIL: worker arena is empty\n")
        zeus_client_destroy(@client)
        return 1

    # Allocate path bytes in arena and copy.
    let path_dst: *u8 = data_arena_alloc(@arena, req_path_len as i64)
    if path_dst == null
        print("FAIL: arena alloc for path returned null\n")
        zeus_client_destroy(@client)
        return 1
    let path_offset: i64 = data_arena_ptr_to_offset(@arena, path_dst)
    var path_bytes: [u8] = data_arena_bytes(@arena, path_offset, req_path_len as i64)
    path_bytes.copy_from(req_path.as_bytes())

    # ------------------------------------------------------------------
    # 5. Build + submit the request
    # ------------------------------------------------------------------
    var req: RequestSlot
    request_slot_init(@req)
    req.id = zeus_client_next_request_id(@client)
    req.method = HTTP_METHOD_GET
    req.flags = REQ_FLAG_COMPLETE
    req.path_offset = path_offset as u32
    req.path_len = req_path_len as u16

    let submit_rc: i32 = zeus_client_submit_request(@client, worker_idx, @req)
    if submit_rc != 0
        let rc: i64 = submit_rc as i64
        print("FAIL: zeus_client_submit_request returned {rc}\n")
        zeus_client_destroy(@client)
        return 1

    let req_id: i64 = req.id as i64
    print("submitted GET {req_path} (id={req_id})\n")

    # ------------------------------------------------------------------
    # 6. Poll for response (up to 2s)
    # ------------------------------------------------------------------
    var resp: ResponseSlot
    response_slot_init(@resp)
    var got_worker_idx: i32 = -1
    var attempts: i32 = 0
    var poll_rc: i32 = -1

    # 200 attempts × 10ms = 2s ceiling
    while attempts < 200
        poll_rc = zeus_client_poll_response(@client, @resp, @got_worker_idx)
        if poll_rc == 0
            break
        sleep_ms(10)
        attempts += 1

    if poll_rc != 0
        print("FAIL: timed out waiting for response after 2s\n")
        zeus_client_destroy(@client)
        return 1

    if resp.id != req.id
        let got_id: i64 = resp.id as i64
        let want_id: i64 = req.id as i64
        print("WARN: response id {got_id} != request id {want_id}\n")

    # ------------------------------------------------------------------
    # 7. Render the response
    # ------------------------------------------------------------------
    let status_n: i64 = resp.status as i64
    let body_n: i64 = resp.body_len as i64
    let headers_n: i64 = resp.headers_len as i64
    print("response: status={status_n} body_len={body_n} headers_len={headers_n}\n")

    if resp.body_len > 0
        # Re-derive arena (offset reset is intentional — base is what we want).
        var arena2: DataArena
        worker_handle_get_arena(handle, @arena2)
        let body: [u8] = data_arena_bytes(@arena2, resp.body_offset as i64, resp.body_len as i64)
        print("--- body ---\n")
        fd_stdout().write_all(body)
        print("\n--- end ---\n")

    # ------------------------------------------------------------------
    # 8. Cleanup
    # ------------------------------------------------------------------
    zeus_client_destroy(@client)

    if resp.status >= 200 and resp.status < 400
        return 0
    return 1
