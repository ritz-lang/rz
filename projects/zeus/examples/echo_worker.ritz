# zeus/examples/echo_worker.ritz - Simple echo worker for testing
#
# This worker echoes back the request path as the response body.
# Useful for testing the valet → zeus → worker pipeline.
#
# Usage (spawned by zeus):
#   echo_worker <shm_size> <worker_id>

import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.fd { fd_stdout }
import ritzlib.time { sleep_ms }

import zeus.worker { WorkerContext }
import zeus.worker { worker_init, worker_destroy }
import zeus.worker { worker_set_running }
import zeus.worker { worker_poll_request, worker_request_path_bytes }
import zeus.ring { RequestSlot }
import zeus.echo_handler { EchoArgs, echo_serve_request, echo_parse_args }

# ============================================================================
# Constants
# ============================================================================

const SHM_FD: i32 = 3  # Zeus always passes shm fd as fd 3

# ============================================================================
# Helpers
# ============================================================================

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if args.len > 1
        let arg1: StrView = args[1]
        if arg1.eq("-h") or arg1.eq("--help")
            print("Usage: echo_worker <shm_size> <worker_id>\n")
            print("  Zeus worker that answers each request with \"Echo: <path>\".\n")
            print("  Spawned by zeus, which passes the shared memory region as fd 3.\n")
            return 0

    print("Echo worker starting...\n")

    # Parse arguments: echo_worker <shm_size> <worker_id>
    if args.len < 3
        print("Usage: echo_worker <shm_size> <worker_id>\n")
        return 1

    let parsed: EchoArgs = match echo_parse_args(args[1], args[2])
        Some(a) => a
        None =>
            print("echo_worker: shm_size must be 1..9223372036854775807 and worker_id 0..2147483647\n")
            return 1
    let shm_size: i64 = parsed.shm_size
    let worker_id: i32 = parsed.worker_id

    print("Worker {worker_id} attaching to shm (size={shm_size})\n")

    # Initialize worker context
    var ctx: WorkerContext
    let result: i32 = worker_init(@ctx, SHM_FD, shm_size)
    if result != 0
        print("Failed to init worker context\n")
        return 1

    print("Worker ready, entering serve loop\n")

    # Mark as running
    worker_set_running(@ctx)

    # Serve loop.  echo_serve_request answers then acks; if the response
    # ring stays full it leaves the request unacked, and the next poll
    # returns the same request (AGAST #2467, as nexus does since #2464).
    var running: i32 = 1
    while running != 0
        let req: *RequestSlot = worker_poll_request(@ctx)

        if req != null
            print("Request: ")
            fd_stdout().write_all(worker_request_path_bytes(@ctx, req))
            print("\n")

            echo_serve_request(@ctx, req, 100)
        else
            # No request, sleep briefly
            sleep_ms(10)

    print("Worker shutting down\n")
    worker_destroy(@ctx)
    return 0
