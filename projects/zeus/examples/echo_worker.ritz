# zeus/examples/echo_worker.ritz - Simple echo worker for testing
#
# This worker echoes back the request path as the response body.
# Useful for testing the valet → zeus → worker pipeline.
#
# Usage (spawned by zeus):
#   echo_worker <shm_size> <worker_id>

import ritzlib.sys
import ritzlib.io
import ritzlib.str { streq }

import zeus.worker { WorkerContext }
import zeus.worker { worker_init, worker_destroy }
import zeus.worker { worker_set_running }
import zeus.worker { worker_poll_request, worker_get_request_path }
import zeus.ring { RequestSlot }
import zeus.echo_handler { echo_serve_request }

# ============================================================================
# Constants
# ============================================================================

const SHM_FD: i32 = 3  # Zeus always passes shm fd as fd 3

# ============================================================================
# Helpers
# ============================================================================

fn cstr_len(s: *u8) -> i32
    var len: i32 = 0
    while *(s + len) != 0
        len += 1
    return len

# ============================================================================
# Main
# ============================================================================

pub fn main(argc: i32, argv: **u8) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if argc > 1
        let arg1: *u8 = *(argv + 1)
        if streq(arg1, c"-h") != 0 or streq(arg1, c"--help") != 0
            prints("Usage: echo_worker <shm_size> <worker_id>\n")
            prints("  Zeus worker that answers each request with \"Echo: <path>\".\n")
            prints("  Spawned by zeus, which passes the shared memory region as fd 3.\n")
            return 0

    prints("Echo worker starting...\n")

    # Parse arguments: echo_worker <shm_size> <worker_id>
    if argc < 3
        prints("Usage: echo_worker <shm_size> <worker_id>\n")
        return 1

    let shm_size_str: *u8 = *(argv + 1)
    let worker_id_str: *u8 = *(argv + 2)

    # Parse shm_size
    var shm_size: i64 = 0
    var i: i32 = 0
    while *(shm_size_str + i) != 0
        shm_size = shm_size * 10 + (*(shm_size_str + i) - 0x30) as i64
        i += 1

    # Parse worker_id
    var worker_id: i32 = 0
    i = 0
    while *(worker_id_str + i) != 0
        worker_id = worker_id * 10 + (*(worker_id_str + i) - 0x30) as i32
        i += 1

    prints("Worker ")
    print_int(worker_id as i64)
    prints(" attaching to shm (size=")
    print_int(shm_size)
    prints(")\n")

    # Initialize worker context
    var ctx: WorkerContext
    let result: i32 = worker_init(@ctx, SHM_FD, shm_size)
    if result != 0
        prints("Failed to init worker context\n")
        return 1

    prints("Worker ready, entering serve loop\n")

    # Mark as running
    worker_set_running(@ctx)

    # Serve loop.  echo_serve_request answers then acks; if the response
    # ring stays full it leaves the request unacked, and the next poll
    # returns the same request (AGAST #2467, as nexus does since #2464).
    var running: i32 = 1
    while running != 0
        let req: *RequestSlot = worker_poll_request(@ctx)

        if req != null
            let path: *u8 = worker_get_request_path(@ctx, req)
            let path_len: i32 = req.path_len as i32
            prints("Request: ")
            for j in 0..path_len
                let c: u8 = *(path + j)
                sys_write(1, @c, 1)
            prints("\n")

            echo_serve_request(@ctx, req, 100)
        else
            # No request, sleep briefly
            var ts: [2]i64
            ts[0] = 0
            ts[1] = 10000000  # 10ms
            sys_nanosleep(@ts[0], null)

    prints("Worker shutting down\n")
    worker_destroy(@ctx)
    return 0
