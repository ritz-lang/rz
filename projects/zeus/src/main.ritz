# src/main.ritz - Zeus daemon entry point
#
# Zeus is a process manager for Ritz applications.
# It owns the shared memory ring buffers and spawns worker processes.
#
# Usage:
#   zeus [options] <app-module>
#
# Options:
#   -w <count>     Number of workers (default: 4)
#   -m <bytes>     Data arena size per worker (default: 2MB; raised to
#                  ring capacity * 128 KiB so every slot fits a full page)
#   -r <capacity>  Ring buffer capacity (default: 256)
#   -s <path>      Unix socket path (default: /run/zeus/zeus.sock)
#   -p <path>      PID file path (default: /run/zeus/zeus.pid)
#   -f             Run in foreground (don't daemonize)
#   -v             Verbose logging
#   -h, --help     Show help

import ritzlib.sys
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.span { Span, span_from_ptr }
import ritzlib.strview { StrView, strview_from_cstr }
import ritzlib.fd { Fd, fd_adopt, fd_stdout, poll, PollFd, POLLIN }
import ritzlib.fs { unlink }
import ritzlib.process { ProcessResult, kill, wait_pid, try_wait_pid, signalfd_read }
import ritzlib.time { sleep_ms }
import ritzlib.option
import ritzlib.result
import ritzlib.errno
import zeus.daemon
import zeus.main_helpers
import zeus.control

# ============================================================================
# Simple Print Helpers
# ============================================================================

# One write(2) per line (AGAST #3121). zeus's workers inherit its stdout, so
# a line printed in pieces ("spawned worker " "0" " (pid " then one write
# per digit) could take a worker's line between two pieces, and
# smoke_stack's "zeus: spawned worker N (pid P)" match never saw it.
# print_str and print_i32 append to g_line; the '\n' that ends a line writes
# the whole line at once. A write to a shared file description lands whole
# at the shared offset, and a pipe write up to PIPE_BUF is atomic.
# smoke_stack's stack.zeus_log_one_write_per_line counts zeus's write(2)s.

const LINE_CAP: i64 = 256
var g_line: [256]u8
var g_line_len: i64 = 0

fn line_flush()
    if g_line_len > 0
        fd_stdout().write(Span<u8> { ptr: @g_line[0], len: g_line_len })
        g_line_len = 0

fn line_push(c: u8)
    if g_line_len == LINE_CAP
        line_flush()  # an over-long line goes out in pieces rather than lost
    g_line[g_line_len] = c
    g_line_len = g_line_len + 1
    if c == 10
        line_flush()

fn print_str(s: *u8)
    var i: i64 = 0
    while *(s + i) != 0
        line_push(*(s + i))
        i = i + 1

fn print_i32(n: i32)
    var buf: [20]u8
    let digits: StrView = fmt_i64_into(@buf, n as i64)
    for i in 0..digits.len
        line_push(*(digits.ptr + i))

# ============================================================================
# Global State
# ============================================================================

# Signal pipe for async-safe signal handling
var g_signal_pipe_read: i32 = -1
var g_signal_pipe_write: i32 = -1

# signalfd for SIGTERM/SIGINT/SIGHUP (blocked; read in the event loop)
var g_signal_fd: Fd = Fd { fd: -1 }

# Daemon context (global for signal handler access)
var g_daemon: DaemonContext

# Running flag
var g_running: i32 = 1

# App module and worker count (-w) for respawning workers
var g_app_module: *u8 = null
var g_worker_count: i32 = 1

# ============================================================================
# Main Event Loop
# ============================================================================

fn run_event_loop(ctx: *DaemonContext, opts: *ZeusOptions) -> i32
    print_str(c"zeus: entering event loop\n")

    # Poll fds: signal pipe + listen socket
    var poll_fds: [2]PollFd

    poll_fds[0].fd = g_signal_fd.raw()
    poll_fds[0].events = POLLIN
    poll_fds[0].revents = 0

    poll_fds[1].fd = ctx.listen_fd.raw()
    poll_fds[1].events = POLLIN
    poll_fds[1].revents = 0

    while g_running != 0
        # Poll with 1 second timeout
        let nready: i32 = match poll(span_from_ptr<PollFd>(@poll_fds[0], 2), 1000)
            Ok(n) => n
            Err(_) => continue  # Err(Intr) from a signal, or another error

        if nready == 0
            # Timeout - check worker health
            check_workers(ctx)
            continue

        # Handle signal pipe
        if (poll_fds[0].revents & POLLIN) != 0
            handle_signals(ctx)

        # Handle new connections
        if (poll_fds[1].revents & POLLIN) != 0
            handle_accept(ctx)

        # Check workers periodically
        check_workers(ctx)

    print_str(c"zeus: exiting event loop\n")
    return 0

# Handle every signal queued on the signalfd
fn handle_signals(ctx: *DaemonContext)
    loop
        let pending: Option<i32> = match signalfd_read(@g_signal_fd)
            Ok(p) => p
            Err(_) => return
        let sig: i32 = match pending
            Some(s) => s
            None => return
        if sig == SIGTERM || sig == SIGINT
            print_str(c"zeus: received shutdown signal\n")
            g_running = 0
            initiate_shutdown(ctx)
        else if sig == SIGHUP
            print_str(c"zeus: received reload signal, restarting workers...\n")
            initiate_hot_reload(ctx)

# Protocol constants (must match lib/zeus_client.ritz)
const ZEUS_PROTOCOL_VERSION: u8 = 1
const CLIENT_MSG_HELLO: u8 = 1
const DAEMON_MSG_WELCOME: u8 = 1
const DAEMON_MSG_WORKER_INFO: u8 = 2

# Protocol message structures
struct ClientMessage
    msg_type: u8
    version: u8
    _reserved: [6]u8

struct DaemonMessage
    msg_type: u8
    _pad1: u8
    payload_len: u16
    worker_idx: i32
    shm_size: i64

# SCM_RIGHTS constants
const SOL_SOCKET: i32 = 1
const SCM_RIGHTS: i32 = 1

# IoVec for sendmsg
struct IoVec
    iov_base: *u8
    iov_len: u64

# msghdr for sendmsg
struct MsgHdr
    msg_name: *u8
    msg_namelen: u32
    _pad1: u32
    msg_iov: *IoVec
    msg_iovlen: u64
    msg_control: *u8
    msg_controllen: u64
    msg_flags: i32
    _pad2: i32

# Handle new Valet connection
fn handle_accept(ctx: *DaemonContext)
    var addr: [110]u8
    var addrlen: i32 = 110

    let client_fd: i32 = syscall3(SYS_ACCEPT, ctx.listen_fd.raw() as i64, @addr[0] as i64, @addrlen as i64) as i32
    if client_fd < 0
        return
    var client: Fd = fd_adopt(client_fd)

    print_str(c"zeus: accepted connection\n")

    # Wait for HELLO message from client
    var hello: ClientMessage
    var n: i64 = -1
    match client.read(Span<u8> { ptr: @hello as *u8, len: 8 })
        Ok(got) => n = got
        Err(_) => pass
    if n != 8 || hello.msg_type != CLIENT_MSG_HELLO
        print_str(c"zeus: invalid handshake\n")
        client.close()
        return

    if hello.version != ZEUS_PROTOCOL_VERSION
        print_str(c"zeus: protocol version mismatch\n")
        client.close()
        return

    # Send WELCOME response with worker count
    var welcome: DaemonMessage
    welcome.msg_type = DAEMON_MSG_WELCOME
    welcome._pad1 = 0
    welcome.payload_len = 0
    welcome.worker_idx = daemon_get_running_worker_count(ctx)
    welcome.shm_size = 0
    client.write(Span<u8> { ptr: @welcome as *u8, len: 16 })

    # Send WORKER_INFO + fd for each running worker
    send_worker_info(ctx, client_fd)

    print_str(c"zeus: handshake complete\n")
    # Keep connection open - client may request more workers later
    # For now, close it (TODO: keep alive for wakeup signaling)
    client.close()

# Send worker shm fds to client
fn send_worker_info(ctx: *DaemonContext, client_fd: i32)
    var i: i32 = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if slot != null && slot.state == WORKER_SLOT_RUNNING
            # Send WORKER_INFO message with fd via SCM_RIGHTS
            var msg: DaemonMessage
            msg.msg_type = DAEMON_MSG_WORKER_INFO
            msg._pad1 = 0
            msg.payload_len = 8
            msg.worker_idx = i
            msg.shm_size = slot.shm.size

            send_msg_with_fd(client_fd, @msg, slot.shm.fd)
        i = i + 1

# Send a DaemonMessage with an fd attached via SCM_RIGHTS
fn send_msg_with_fd(sock: i32, msg: *DaemonMessage, fd: i32)
    var iov: IoVec
    iov.iov_base = msg as *u8
    iov.iov_len = 16  # sizeof(DaemonMessage)

    # Control message buffer: cmsghdr (16 bytes) + fd (4 bytes) + padding
    var cmsg_buf: [24]u8
    var j: i32 = 0
    while j < 24
        cmsg_buf[j] = 0
        j = j + 1

    # cmsg_len = 20 (CMSG_LEN(sizeof(int)))
    let cmsg_len_ptr: *u64 = @cmsg_buf[0] as *u64
    *cmsg_len_ptr = 20

    # cmsg_level = SOL_SOCKET
    let level_ptr: *i32 = @cmsg_buf[8] as *i32
    *level_ptr = SOL_SOCKET

    # cmsg_type = SCM_RIGHTS
    let type_ptr: *i32 = @cmsg_buf[12] as *i32
    *type_ptr = SCM_RIGHTS

    # fd at offset 16
    let fd_ptr: *i32 = @cmsg_buf[16] as *i32
    *fd_ptr = fd

    var hdr: MsgHdr
    hdr.msg_name = null
    hdr.msg_namelen = 0
    hdr.msg_iov = @iov
    hdr.msg_iovlen = 1
    hdr.msg_control = @cmsg_buf[0]
    hdr.msg_controllen = 24  # CMSG_SPACE(sizeof(int))
    hdr.msg_flags = 0

    syscall3(SYS_SENDMSG, sock as i64, @hdr as i64, 0)

# Check worker health and respawn if needed
fn check_workers(ctx: *DaemonContext)
    var i: i32 = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if slot == null
            i = i + 1
            continue

        if slot.state == WORKER_SLOT_RUNNING
            if worker_exited(slot)
                # Process is dead (and now reaped) - respawn it
                print_str(c"zeus: worker ")
                print_i32(i)
                print_str(c" died, respawning...\n")

                # The old process is reaped: give the slot a fresh control
                # block before the replacement attaches (AGAST #4179)
                daemon_mark_worker_reaped(ctx, i)
                if !reprepare_worker(ctx, i)
                    i = i + 1
                    continue

                # Spawn new worker
                let pid: i32 = spawn_worker(slot.shm.fd, slot.shm.size, i, g_worker_count, g_app_module)
                if pid > 0
                    daemon_mark_worker_running(ctx, i, pid)
                    print_str(c"zeus: respawned worker ")
                    print_i32(i)
                    print_str(c" (pid ")
                    print_i32(pid)
                    print_str(c")\n")
                else
                    print_str(c"zeus: failed to respawn worker\n")
                    slot.state = WORKER_SLOT_DEAD

        i = i + 1

# Initiate graceful shutdown
fn initiate_shutdown(ctx: *DaemonContext)
    daemon_stop(ctx)

    # Request all workers to stop
    var i: i32 = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if slot != null && slot.state == WORKER_SLOT_RUNNING
            daemon_request_worker_stop(ctx, i)
        i = i + 1

const STOP_GRACE_POLLS: i32 = 100   # x 10ms: SIGTERM'd workers get 1s

# A slot whose process has not been reaped yet: running, or asked to stop
# through its control block (initiate_shutdown) but not yet gone.
fn worker_live(slot: *WorkerSlot) -> bool
    if slot == null || slot.pid <= 0
        return false
    return slot.state == WORKER_SLOT_RUNNING || slot.state == WORKER_SLOT_STOPPING

# Reap the slot's process if it has exited; true once it is gone (AGAST
# #3075). kill(pid, 0) can't answer this: it succeeds on an unreaped zombie,
# so a crashed worker looked alive forever and was never respawned. r < 0
# (ECHILD) means it is not our child any more: gone all the same.
fn worker_exited(slot: *WorkerSlot) -> bool
    match try_wait_pid(slot.pid)
        Ok(r) => match r
            Some(_) => return true
            None => return false
        Err(_) => return true

# smoke_stack's stack.zeus_{term,int}_stops_workers read this line: it is
# how they tell zeus's own shutdown from the PDEATHSIG fallback.
fn mark_reaped(slot: *WorkerSlot, idx: i32)
    print_str(c"zeus: reaped worker ")
    print_i32(idx)
    print_str(c" (pid ")
    print_i32(slot.pid)
    print_str(c")\n")
    slot.state = WORKER_SLOT_DEAD
    slot.pid = 0

# Re-prepare a reaped slot for its replacement worker. On failure the slot
# stays DEAD and nothing is spawned on a stale control block (AGAST #4179).
fn reprepare_worker(ctx: *DaemonContext, idx: i32) -> bool
    if daemon_prepare_worker(ctx, idx) == 0
        return true
    print_str(c"zeus: failed to prepare worker ")
    print_i32(idx)
    print_str(c"\n")
    return false

# Stop and reap every worker (AGAST #2465): SIGTERM, up to 1s for them to
# exit, then SIGKILL whatever is left and wait for it. A supervisor that
# returns without this leaves its workers running, reparented to init.
fn stop_workers(ctx: *DaemonContext)
    var i: i32 = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if worker_live(slot)
            kill(slot.pid, SIGTERM)
        i = i + 1

    var polls: i32 = 0
    loop
        var left: i32 = 0
        i = 0
        while i < MAX_WORKERS
            let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
            if worker_live(slot)
                if worker_exited(slot)
                    # Reaped, or not our child any more (ECHILD)
                    mark_reaped(slot, i)
                else
                    left = left + 1
            i = i + 1
        if left == 0
            return
        if polls >= STOP_GRACE_POLLS
            break
        sleep_ms(10)
        polls = polls + 1

    i = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if worker_live(slot)
            print_str(c"zeus: worker ")
            print_i32(i)
            print_str(c" ignored SIGTERM, killing\n")
            kill(slot.pid, SIGKILL)
            wait_pid(slot.pid)
            mark_reaped(slot, i)
        i = i + 1

# Stop and reap one worker before its slot is reused (AGAST #3084): SIGTERM,
# up to 1s to exit, then SIGKILL and wait. Spawning the replacement on the
# same shm while the old process still runs leaves both on the same rings,
# and the old pid, overwritten in the slot, is never reaped.
fn stop_worker(slot: *WorkerSlot, idx: i32)
    kill(slot.pid, SIGTERM)
    var polls: i32 = 0
    while polls < STOP_GRACE_POLLS
        if worker_exited(slot)
            mark_reaped(slot, idx)
            return
        sleep_ms(10)
        polls = polls + 1
    print_str(c"zeus: worker ")
    print_i32(idx)
    print_str(c" ignored SIGTERM, killing\n")
    kill(slot.pid, SIGKILL)
    wait_pid(slot.pid)
    mark_reaped(slot, idx)

# Initiate hot reload - restart all workers one by one
fn initiate_hot_reload(ctx: *DaemonContext)
    var i: i32 = 0
    while i < MAX_WORKERS
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, i)
        if slot == null
            i = i + 1
            continue

        if slot.state == WORKER_SLOT_RUNNING
            # The control-block request is advisory (nexus never reads it);
            # stop_worker's SIGTERM is what ends the old process.
            daemon_request_worker_stop(ctx, i)
            stop_worker(slot, i)

            # Respawn worker
            print_str(c"zeus: reloading worker ")
            print_i32(i)
            print_str(c"\n")

            if !reprepare_worker(ctx, i)
                i = i + 1
                continue
            let pid: i32 = spawn_worker(slot.shm.fd, slot.shm.size, i, g_worker_count, g_app_module)
            if pid > 0
                daemon_mark_worker_running(ctx, i, pid)
            else
                print_str(c"zeus: failed to reload worker\n")
                slot.state = WORKER_SLOT_DEAD

        i = i + 1

    print_str(c"zeus: hot reload complete\n")

# ============================================================================
# Startup
# ============================================================================

fn spawn_workers(ctx: *DaemonContext, opts: *ZeusOptions) -> i32
    print_str(c"zeus: spawning workers...\n")

    var i: i32 = 0
    while i < opts.worker_count
        let slot_idx: i32 = daemon_alloc_worker_slot(ctx)
        if slot_idx < 0
            print_str(c"zeus: failed to allocate worker slot\n")
            return -1

        let result: i32 = daemon_prepare_worker(ctx, slot_idx)
        if result < 0
            print_str(c"zeus: failed to prepare worker\n")
            return -1

        # Fork worker
        let slot: *WorkerSlot = daemon_get_worker_slot(ctx, slot_idx)
        let pid: i32 = spawn_worker(slot.shm.fd, slot.shm.size, slot_idx, opts.worker_count, opts.app_module)
        if pid < 0
            print_str(c"zeus: failed to spawn worker\n")
            return -1

        daemon_mark_worker_running(ctx, slot_idx, pid)
        print_str(c"zeus: spawned worker ")
        print_i32(slot_idx)
        print_str(c" (pid ")
        print_i32(pid)
        print_str(c")\n")

        i = i + 1

    return 0

fn print_usage()
    print_str(c"Usage: zeus [options] <app-module>\n")
    print_str(c"\n")
    print_str(c"Options:\n")
    print_str(c"  -w <count>     Number of workers (default: 4)\n")
    print_str(c"  -m <bytes>     Data arena per worker (default: 2MB, min ring*128KiB)\n")
    print_str(c"  -r <capacity>  Ring buffer capacity (default: 256)\n")
    print_str(c"  -s <path>      Unix socket path (default: /run/zeus/zeus.sock)\n")
    print_str(c"  -p <path>      PID file path (default: /run/zeus/zeus.pid)\n")
    print_str(c"  -f             Run in foreground (don't daemonize)\n")
    print_str(c"  -v             Verbose logging\n")
    print_str(c"  -h, --help     Show this help\n")

# ============================================================================
# Poll structures
# ============================================================================

# Note: poll and PollFd are imported from ritzlib.fd

# ============================================================================
# Entry Point
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    print_str(c"zeus: starting\n")

    # Parse arguments
    var opts: ZeusOptions
    zeus_options_init(@opts)

    let parse_result: i32 = zeus_parse_args(@opts, args)
    if parse_result < 0
        print_str(c"zeus: invalid arguments\n")
        print_usage()
        return 1
    if parse_result > 0
        print_usage()
        return 0

    # Check we have an app module
    if opts.app_module == null
        print_str(c"zeus: no application module specified\n")
        print_usage()
        return 1

    # Store app module globally for respawning
    g_app_module = opts.app_module
    g_worker_count = opts.worker_count

    # Initialize daemon
    var cfg: DaemonConfig
    daemon_config_init(@cfg)
    cfg.worker_count = opts.worker_count
    cfg.shm_size = opts.shm_size
    cfg.ring_capacity = opts.ring_capacity
    cfg.socket_path = opts.socket_path

    let init_result: i32 = daemon_init(@g_daemon, @cfg)
    if init_result < 0
        print_str(c"zeus: failed to initialize daemon\n")
        return 1

    # Store signal pipe fds globally
    g_signal_pipe_read = g_daemon.signal_read_fd.raw()
    g_signal_pipe_write = g_daemon.signal_write_fd.raw()

    # Create socket
    let sock_result: i32 = daemon_create_socket(@g_daemon, opts.socket_path)
    if sock_result < 0
        print_str(c"zeus: failed to create socket\n")
        daemon_destroy(@g_daemon)
        return 1
    print_str(c"zeus: listening on socket\n")

    # Take SIGTERM/SIGINT/SIGHUP through a signalfd before any worker
    # exists: their default action would kill zeus and leave the workers
    # running (AGAST #2465).
    match zeus_open_signalfd()
        Ok(sfd) => g_signal_fd = sfd
        Err(_) =>
            print_str(c"zeus: failed to create signalfd\n")
            daemon_destroy(@g_daemon)
            return 1

    # Start daemon
    daemon_start(@g_daemon)

    # Spawn workers
    let spawn_result: i32 = spawn_workers(@g_daemon, @opts)
    if spawn_result < 0
        print_str(c"zeus: failed to spawn workers\n")
        stop_workers(@g_daemon)
        daemon_destroy(@g_daemon)
        return 1

    # Mark running
    daemon_set_running(@g_daemon)
    print_str(c"zeus: ")
    print_i32(opts.worker_count)
    print_str(c" workers running\n")

    # Enter event loop
    let loop_result: i32 = run_event_loop(@g_daemon, @opts)

    # Cleanup
    print_str(c"zeus: shutting down\n")
    stop_workers(@g_daemon)
    daemon_destroy(@g_daemon)

    # Remove socket file
    unlink(strview_from_cstr(opts.socket_path))

    print_str(c"zeus: done\n")
    return loop_result
