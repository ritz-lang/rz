# encode's encoder-only SSE and SSE2 moves, floating-point arithmetic,
# compares, logic and conversions (DESIGN.md "Library"), against `as --64`
# (test/support/check.ritz). The text parser rejects each of these.
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_movss_movsd_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movss (%rdi), %xmm0", "f3 0f 10 07",
        ins2("movss", "", mem(0, "%rdi"), r("%xmm0")))
    n += check(Code64, "movss %xmm1, 4(%rsp)", "f3 0f 11 4c 24 04",
        ins2("movss", "", r("%xmm1"), mem(4, "%rsp")))
    n += check(Code64, "movss %xmm2, %xmm3", "f3 0f 10 da",
        ins2("movss", "", r("%xmm2"), r("%xmm3")))
    n += check(Code64, "movsd foo(%rip), %xmm8", "f2 44 0f 10 05 00 00 00 00 | 5:pc4:foo-4",
        ins2("movsd", "", rip("foo", 0), r("%xmm8")))
    n += check(Code64, "movsd %xmm15, (%r12)", "f2 45 0f 11 3c 24",
        ins2("movsd", "", r("%xmm15"), mem(0, "%r12")))
    n += check(Code64, "movsd %xmm9, %xmm1", "f2 41 0f 10 c9",
        ins2("movsd", "", r("%xmm9"), r("%xmm1")))
    n += check_err(Code64, "movss %eax, %xmm0", ins2("movss", "", r("%eax"), r("%xmm0")))
    n += check_err(Code64, "movsd (%rax), (%rdi)",
        ins2("movsd", "", mem(0, "%rax"), mem(0, "%rdi")))
    n


[[test]]
fn test_encode_movaps_movups_movdqa_movdqu_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movaps %xmm1, %xmm0", "0f 28 c1",
        ins2("movaps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "movaps 16(%rsp), %xmm10", "44 0f 28 54 24 10",
        ins2("movaps", "", mem(16, "%rsp"), r("%xmm10")))
    n += check(Code64, "movaps %xmm2, (%rax)", "0f 29 10",
        ins2("movaps", "", r("%xmm2"), mem(0, "%rax")))
    n += check(Code64, "movups (%rsi), %xmm0", "0f 10 06",
        ins2("movups", "", mem(0, "%rsi"), r("%xmm0")))
    n += check(Code64, "movups %xmm11, -16(%rbp)", "44 0f 11 5d f0",
        ins2("movups", "", r("%xmm11"), mem(-16, "%rbp")))
    n += check(Code64, "movdqa %xmm3, %xmm4", "66 0f 6f e3",
        ins2("movdqa", "", r("%xmm3"), r("%xmm4")))
    n += check(Code64, "movdqa (%rdi), %xmm12", "66 44 0f 6f 27",
        ins2("movdqa", "", mem(0, "%rdi"), r("%xmm12")))
    n += check(Code64, "movdqa %xmm5, 32(%rsp)", "66 0f 7f 6c 24 20",
        ins2("movdqa", "", r("%xmm5"), mem(32, "%rsp")))
    n += check(Code64, "movdqu (%rsi,%rcx), %xmm1", "f3 0f 6f 0c 0e",
        ins2("movdqu", "", sib(0, "%rsi", "%rcx", 1), r("%xmm1")))
    n += check(Code64, "movdqu %xmm14, (%rdi)", "f3 44 0f 7f 37",
        ins2("movdqu", "", r("%xmm14"), mem(0, "%rdi")))
    n


[[test]]
fn test_encode_movd_movq_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movd %eax, %xmm0", "66 0f 6e c0", ins2("movd", "", r("%eax"), r("%xmm0")))
    n += check(Code64, "movd %r9d, %xmm9", "66 45 0f 6e c9",
        ins2("movd", "", r("%r9d"), r("%xmm9")))
    n += check(Code64, "movd (%rdi), %xmm1", "66 0f 6e 0f",
        ins2("movd", "", mem(0, "%rdi"), r("%xmm1")))
    n += check(Code64, "movd %xmm2, %ecx", "66 0f 7e d1", ins2("movd", "", r("%xmm2"), r("%ecx")))
    n += check(Code64, "movd %xmm3, 4(%rsp)", "66 0f 7e 5c 24 04",
        ins2("movd", "", r("%xmm3"), mem(4, "%rsp")))
    n += check(Code64, "movq %rax, %xmm0", "66 48 0f 6e c0",
        ins2("movq", "", r("%rax"), r("%xmm0")))
    n += check(Code64, "movq %xmm8, %r10", "66 4d 0f 7e c2",
        ins2("movq", "", r("%xmm8"), r("%r10")))
    n += check(Code64, "movq (%rsi), %xmm4", "f3 0f 7e 26",
        ins2("movq", "", mem(0, "%rsi"), r("%xmm4")))
    n += check(Code64, "movq %xmm5, 8(%rsp)", "66 0f d6 6c 24 08",
        ins2("movq", "", r("%xmm5"), mem(8, "%rsp")))
    n += check(Code64, "movq %xmm6, %xmm7", "f3 0f 7e fe", ins2("movq", "", r("%xmm6"), r("%xmm7")))
    n += check(Code64, "movq %xmm1, %xmm12", "f3 44 0f 7e e1",
        ins2("movq", "", r("%xmm1"), r("%xmm12")))
    n += check(Code64, "movq %rdx, %xmm13", "66 4c 0f 6e ea",
        ins2("mov", "q", r("%rdx"), r("%xmm13")))
    n += check(Code64, "movq %xmm0, %rax", "66 48 0f 7e c0",
        ins2("mov", "q", r("%xmm0"), r("%rax")))
    n += check_err(Code64, "movd %ax, %xmm0", ins2("movd", "", r("%ax"), r("%xmm0")))
    n += check_err(Code64, "movq %eax, %xmm0", ins2("movq", "", r("%eax"), r("%xmm0")))
    n


[[test]]
fn test_encode_float_arithmetic_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "addss %xmm1, %xmm0", "f3 0f 58 c1",
        ins2("addss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "addsd (%rdi), %xmm2", "f2 0f 58 17",
        ins2("addsd", "", mem(0, "%rdi"), r("%xmm2")))
    n += check(Code64, "addps %xmm9, %xmm3", "41 0f 58 d9",
        ins2("addps", "", r("%xmm9"), r("%xmm3")))
    n += check(Code64, "addpd %xmm4, %xmm10", "66 44 0f 58 d4",
        ins2("addpd", "", r("%xmm4"), r("%xmm10")))
    n += check(Code64, "subss %xmm1, %xmm0", "f3 0f 5c c1",
        ins2("subss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "subsd 8(%rsp), %xmm1", "f2 0f 5c 4c 24 08",
        ins2("subsd", "", mem(8, "%rsp"), r("%xmm1")))
    n += check(Code64, "subps %xmm1, %xmm0", "0f 5c c1", ins2("subps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "subpd %xmm1, %xmm0", "66 0f 5c c1",
        ins2("subpd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "mulss %xmm1, %xmm0", "f3 0f 59 c1",
        ins2("mulss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "mulsd foo(%rip), %xmm0", "f2 0f 59 05 00 00 00 00 | 4:pc4:foo-4",
        ins2("mulsd", "", rip("foo", 0), r("%xmm0")))
    n += check(Code64, "mulps %xmm1, %xmm0", "0f 59 c1", ins2("mulps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "mulpd %xmm15, %xmm14", "66 45 0f 59 f7",
        ins2("mulpd", "", r("%xmm15"), r("%xmm14")))
    n += check(Code64, "divss %xmm1, %xmm0", "f3 0f 5e c1",
        ins2("divss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "divsd %xmm1, %xmm0", "f2 0f 5e c1",
        ins2("divsd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "divps (%rax), %xmm0", "0f 5e 00",
        ins2("divps", "", mem(0, "%rax"), r("%xmm0")))
    n += check(Code64, "divpd %xmm1, %xmm0", "66 0f 5e c1",
        ins2("divpd", "", r("%xmm1"), r("%xmm0")))
    n += check_err(Code64, "addss %xmm1, (%rdi)", ins2("addss", "", r("%xmm1"), mem(0, "%rdi")))
    n += check_err(Code64, "addsd %rax, %xmm0", ins2("addsd", "", r("%rax"), r("%xmm0")))
    n


[[test]]
fn test_encode_ucomis_and_cmp_predicates_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "ucomiss %xmm1, %xmm0", "0f 2e c1",
        ins2("ucomiss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "ucomiss (%rdi), %xmm8", "44 0f 2e 07",
        ins2("ucomiss", "", mem(0, "%rdi"), r("%xmm8")))
    n += check(Code64, "ucomisd %xmm1, %xmm0", "66 0f 2e c1",
        ins2("ucomisd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "ucomisd %xmm11, %xmm2", "66 41 0f 2e d3",
        ins2("ucomisd", "", r("%xmm11"), r("%xmm2")))
    n += check(Code64, "cmpss $1, %xmm1, %xmm0", "f3 0f c2 c1 01",
        ins3("cmpss", "", imm(1), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpsd $4, (%rdi), %xmm2", "f2 0f c2 17 04",
        ins3("cmpsd", "", imm(4), mem(0, "%rdi"), r("%xmm2")))
    n += check(Code64, "cmpps $2, %xmm9, %xmm3", "41 0f c2 d9 02",
        ins3("cmpps", "", imm(2), r("%xmm9"), r("%xmm3")))
    n += check(Code64, "cmppd $7, %xmm1, %xmm0", "66 0f c2 c1 07",
        ins3("cmppd", "", imm(7), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpeqss %xmm1, %xmm0", "f3 0f c2 c1 00",
        ins2("cmpeqss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpltsd %xmm1, %xmm0", "f2 0f c2 c1 01",
        ins2("cmpltsd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpleps %xmm1, %xmm0", "0f c2 c1 02",
        ins2("cmpleps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpunordpd %xmm1, %xmm0", "66 0f c2 c1 03",
        ins2("cmpunordpd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpneqss %xmm1, %xmm0", "f3 0f c2 c1 04",
        ins2("cmpneqss", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpnltsd %xmm1, %xmm0", "f2 0f c2 c1 05",
        ins2("cmpnltsd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cmpnleps (%rax), %xmm0", "0f c2 00 06",
        ins2("cmpnleps", "", mem(0, "%rax"), r("%xmm0")))
    n += check(Code64, "cmpordpd %xmm1, %xmm0", "66 0f c2 c1 07",
        ins2("cmpordpd", "", r("%xmm1"), r("%xmm0")))
    n += check_err(Code64, "cmpss $256, %xmm1, %xmm0",
        ins3("cmpss", "", imm(256), r("%xmm1"), r("%xmm0")))
    n


[[test]]
fn test_encode_float_logic_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "andps %xmm1, %xmm0", "0f 54 c1", ins2("andps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "andpd foo(%rip), %xmm2", "66 0f 54 15 00 00 00 00 | 4:pc4:foo-4",
        ins2("andpd", "", rip("foo", 0), r("%xmm2")))
    n += check(Code64, "andnps %xmm1, %xmm0", "0f 55 c1",
        ins2("andnps", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "andnpd %xmm1, %xmm0", "66 0f 55 c1",
        ins2("andnpd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "orps %xmm8, %xmm0", "41 0f 56 c0", ins2("orps", "", r("%xmm8"), r("%xmm0")))
    n += check(Code64, "orpd %xmm1, %xmm0", "66 0f 56 c1", ins2("orpd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "xorps %xmm0, %xmm0", "0f 57 c0", ins2("xorps", "", r("%xmm0"), r("%xmm0")))
    n += check(Code64, "xorpd %xmm1, %xmm9", "66 44 0f 57 c9",
        ins2("xorpd", "", r("%xmm1"), r("%xmm9")))
    n


[[test]]
fn test_encode_float_conversions_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "cvtsi2ss %eax, %xmm0", "f3 0f 2a c0",
        ins2("cvtsi2ss", "", r("%eax"), r("%xmm0")))
    n += check(Code64, "cvtsi2ss %rax, %xmm1", "f3 48 0f 2a c8",
        ins2("cvtsi2ss", "", r("%rax"), r("%xmm1")))
    n += check(Code64, "cvtsi2ssl (%rdi), %xmm2", "f3 0f 2a 17",
        ins2("cvtsi2ss", "l", mem(0, "%rdi"), r("%xmm2")))
    n += check(Code64, "cvtsi2sd %r9d, %xmm10", "f2 45 0f 2a d1",
        ins2("cvtsi2sd", "", r("%r9d"), r("%xmm10")))
    n += check(Code64, "cvtsi2sd %r11, %xmm0", "f2 49 0f 2a c3",
        ins2("cvtsi2sd", "", r("%r11"), r("%xmm0")))
    n += check(Code64, "cvtsi2sdq 8(%rsp), %xmm3", "f2 48 0f 2a 5c 24 08",
        ins2("cvtsi2sd", "q", mem(8, "%rsp"), r("%xmm3")))
    n += check(Code64, "cvttss2si %xmm0, %eax", "f3 0f 2c c0",
        ins2("cvttss2si", "", r("%xmm0"), r("%eax")))
    n += check(Code64, "cvttss2si %xmm9, %rcx", "f3 49 0f 2c c9",
        ins2("cvttss2si", "", r("%xmm9"), r("%rcx")))
    n += check(Code64, "cvttss2si (%rdi), %r8d", "f3 44 0f 2c 07",
        ins2("cvttss2si", "", mem(0, "%rdi"), r("%r8d")))
    n += check(Code64, "cvttsd2si %xmm1, %rax", "f2 48 0f 2c c1",
        ins2("cvttsd2si", "", r("%xmm1"), r("%rax")))
    n += check(Code64, "cvttsd2si %xmm2, %edx", "f2 0f 2c d2",
        ins2("cvttsd2si", "", r("%xmm2"), r("%edx")))
    n += check(Code64, "cvtss2sd %xmm1, %xmm0", "f3 0f 5a c1",
        ins2("cvtss2sd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "cvtss2sd (%rax), %xmm8", "f3 44 0f 5a 00",
        ins2("cvtss2sd", "", mem(0, "%rax"), r("%xmm8")))
    n += check(Code64, "cvtsd2ss %xmm1, %xmm0", "f2 0f 5a c1",
        ins2("cvtsd2ss", "", r("%xmm1"), r("%xmm0")))
    n += check_err(Code64, "cvtsi2ss %ax, %xmm0", ins2("cvtsi2ss", "", r("%ax"), r("%xmm0")))
    n += check_err(Code64, "cvttsd2si %xmm1, %ax", ins2("cvttsd2si", "", r("%xmm1"), r("%ax")))
    n
