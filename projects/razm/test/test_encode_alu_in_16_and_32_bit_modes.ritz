# encode: the ALU group (add, or, and, sub, xor, cmp), test and bt, in every
# operand form and mode, against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_alu_in_16_and_32_bit_modes_match_as() -> i32
    var n: i32 = 0
    n += check(Code32, "orl $0x20, %eax", "83 c8 20", ins2("or", "l", imm(0x20), r("%eax")))
    n += check(Code32, "orl $0x80000000, %eax", "0d 00 00 00 80",
        ins2("or", "l", imm(0x80000000), r("%eax")))
    n += check(Code32, "andl $0xFFFF, %ebx", "81 e3 ff ff 00 00",
        ins2("and", "l", imm(0xFFFF), r("%ebx")))
    n += check(Code32, "addl $8, %esp", "83 c4 08", ins2("add", "l", imm(8), r("%esp")))
    n += check(Code32, "cmpl $0x80000001, %eax", "3d 01 00 00 80",
        ins2("cmp", "l", imm(0x80000001), r("%eax")))
    n += check(Code32, "cmpl %eax, %ecx", "39 c1", ins2("cmp", "l", r("%eax"), r("%ecx")))
    n += check(Code32, "xorl %eax, %eax", "31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code32, "xorw %ax, %ax", "66 31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code32, "addw $1, %bx", "66 83 c3 01", ins2("add", "w", imm(1), r("%bx")))
    n += check(Code32, "orb $1, %al", "0c 01", ins2("or", "b", imm(1), r("%al")))
    n += check(Code32, "cmpl $0, 4(%edi)", "83 7f 04 00", ins2("cmp", "l", imm(0), mem(4, "%edi")))
    n += check(Code32, "addl $foo, %ecx", "81 c1 00 00 00 00 | 2:abs4:foo+0",
        ins2("add", "l", isym("foo", 0), r("%ecx")))
    n += check(Code32, "cmpl $1, foo", "83 3d 00 00 00 00 01 | 2:abs4:foo+0",
        ins2("cmp", "l", imm(1), sym("foo")))
    n += check(Code16, "xorw %ax, %ax", "31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code16, "xorl %eax, %eax", "66 31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code16, "orb $0x02, %al", "0c 02", ins2("or", "b", imm(2), r("%al")))
    n += check(Code16, "andb $0xFE, %al", "24 fe", ins2("and", "b", imm(0xFE), r("%al")))
    n += check(Code16, "orl $0x01, %eax", "66 83 c8 01", ins2("or", "l", imm(1), r("%eax")))
    n += check(Code16, "orl $0x10000, %eax", "66 0d 00 00 01 00",
        ins2("or", "l", imm(0x10000), r("%eax")))
    n += check(Code16, "addw $0x1234, %bx", "81 c3 34 12", ins2("add", "w", imm(0x1234), r("%bx")))
    n += check(Code16, "cmpw $foo, %ax", "3d 00 00 | 1:abs2:foo+0",
        ins2("cmp", "w", isym("foo", 0), r("%ax")))
    n += check(Code16, "subl %ecx, %edx", "66 29 ca", ins2("sub", "l", r("%ecx"), r("%edx")))
    n += check_err(Code32, "addq $1, %rax", ins2("add", "q", imm(1), r("%rax")))
    n += check_err(Code32, "xorl %r8d, %eax", ins2("xor", "l", r("%r8d"), r("%eax")))
    n += check_err(Code16, "orb $1, %sil", ins2("or", "b", imm(1), r("%sil")))
    n += check_err(Code64, "orb %ah, %sil", ins2("or", "b", r("%ah"), r("%sil")))
    n += check_err(Code64, "addq $0x100000000, %rax", ins2("add", "q", imm(0x100000000), r("%rax")))
    n += check_err(Code64, "addl %eax, %rbx", ins2("add", "l", r("%eax"), r("%rbx")))
    n
