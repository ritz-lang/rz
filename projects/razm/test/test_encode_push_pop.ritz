# encode: the stack, inc/dec, shifts, the operand-less and system
# instructions, port I/O, string instructions and the lock/rep prefixes,
# against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_push_pop_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pushq %rax", "50", ins1("push", "q", r("%rax")))
    n += check(Code64, "pushq %r15", "41 57", ins1("push", "q", r("%r15")))
    n += check(Code64, "push %rbp", "55", ins1("push", "", r("%rbp")))
    n += check(Code64, "pushq $0", "6a 00", ins1("push", "q", imm(0)))
    n += check(Code64, "pushq $0x23", "6a 23", ins1("push", "q", imm(0x23)))
    n += check(Code64, "pushq $255", "68 ff 00 00 00", ins1("push", "q", imm(255)))
    n += check(Code64, "pushq $-1", "6a ff", ins1("push", "q", imm(-1)))
    n += check(Code64, "pushq $foo", "68 00 00 00 00 | 1:sabs4:foo+0",
        ins1("push", "q", isym("foo", 0)))
    n += check(Code64, "pushq 88(%rsp)", "ff 74 24 58", ins1("push", "q", mem(88, "%rsp")))
    n += check(Code64, "pushq %gs:0x18", "65 ff 34 25 18 00 00 00",
        ins1("push", "q", seg_at("%gs", 0x18)))
    n += check(Code64, "pushw %ax", "66 50", ins1("push", "w", r("%ax")))
    n += check(Code64, "popq %rax", "58", ins1("pop", "q", r("%rax")))
    n += check(Code64, "popq %r12", "41 5c", ins1("pop", "q", r("%r12")))
    n += check(Code64, "popq 32(%rsp)", "8f 44 24 20", ins1("pop", "q", mem(32, "%rsp")))
    n += check(Code64, "popq %gs:0x18", "65 8f 04 25 18 00 00 00",
        ins1("pop", "q", seg_at("%gs", 0x18)))
    n += check(Code64, "pushfq", "9c", ins0("pushf", "q"))
    n += check(Code64, "popfq", "9d", ins0("popf", "q"))
    n += check(Code32, "pushl %eax", "50", ins1("push", "l", r("%eax")))
    n += check(Code32, "pushl $0x10", "6a 10", ins1("push", "l", imm(0x10)))
    n += check(Code32, "pushl $foo", "68 00 00 00 00 | 1:abs4:foo+0",
        ins1("push", "l", isym("foo", 0)))
    n += check(Code32, "popl %ebx", "5b", ins1("pop", "l", r("%ebx")))
    n += check(Code32, "pushfl", "9c", ins0("pushf", "l"))
    n += check(Code32, "popfl", "9d", ins0("popf", "l"))
    n += check(Code16, "pushl %eax", "66 50", ins1("push", "l", r("%eax")))
    n += check(Code16, "pushw %ax", "50", ins1("push", "w", r("%ax")))
    n += check(Code16, "pushfl", "66 9c", ins0("pushf", "l"))
    n += check(Code16, "popl %eax", "66 58", ins1("pop", "l", r("%eax")))
    n += check_err(Code64, "pushl %eax", ins1("push", "l", r("%eax")))
    n += check_err(Code64, "pushfl", ins0("pushf", "l"))
    n += check_err(Code32, "pushq %rax", ins1("push", "q", r("%rax")))
    n
