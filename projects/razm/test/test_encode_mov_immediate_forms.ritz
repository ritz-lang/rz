# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.encode
import test.support.check


[[test]]
fn test_encode_mov_immediate_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movq $60, %rax", "48 c7 c0 3c 00 00 00",
        ins2("mov", "q", imm(60), r("%rax")))
    n += check(Code64, "movq $-1, %rax", "48 c7 c0 ff ff ff ff",
        ins2("mov", "q", imm(-1), r("%rax")))
    n += check(Code64, "movq $0xffffffff, %rax", "48 b8 ff ff ff ff 00 00 00 00",
        ins2("mov", "q", imm(0xffffffff), r("%rax")))
    n += check(Code64, "movq $0x123456789, %r10", "49 ba 89 67 45 23 01 00 00 00",
        ins2("mov", "q", imm(0x123456789), r("%r10")))
    n += check(Code64, "movq $foo, %rsi", "48 c7 c6 00 00 00 00 | 3:sabs4:foo+0",
        ins2("mov", "q", isym("foo", 0), r("%rsi")))
    n += check(Code64, "movl $0xC0000080, %ecx", "b9 80 00 00 c0",
        ins2("mov", "l", imm(0xC0000080), r("%ecx")))
    n += check(Code64, "movl $foo, %edi", "bf 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), r("%edi")))
    n += check(Code64, "movl $1, %r9d", "41 b9 01 00 00 00", ins2("mov", "l", imm(1), r("%r9d")))
    n += check(Code64, "movw $0x10, %ax", "66 b8 10 00", ins2("mov", "w", imm(0x10), r("%ax")))
    n += check(Code64, "movw $foo, %r8w", "66 41 b8 00 00 | 3:abs2:foo+0",
        ins2("mov", "w", isym("foo", 0), r("%r8w")))
    n += check(Code64, "movb $1, %al", "b0 01", ins2("mov", "b", imm(1), r("%al")))
    n += check(Code64, "movb $1, %ah", "b4 01", ins2("mov", "b", imm(1), r("%ah")))
    n += check(Code64, "movb $0xff, %sil", "40 b6 ff", ins2("mov", "b", imm(0xff), r("%sil")))
    n += check(Code64, "movb $foo, %r11b", "41 b3 00 | 2:abs1:foo+0",
        ins2("mov", "b", isym("foo", 0), r("%r11b")))
    n += check(Code64, "movq $0, 40(%rsp)", "48 c7 44 24 28 00 00 00 00",
        ins2("mov", "q", imm(0), mem(40, "%rsp")))
    n += check(Code64, "movq $1, 80(%rsp)", "48 c7 44 24 50 01 00 00 00",
        ins2("mov", "q", imm(1), mem(80, "%rsp")))
    n += check(Code64, "movq $0, 56(%rax)", "48 c7 40 38 00 00 00 00",
        ins2("mov", "q", imm(0), mem(56, "%rax")))
    n += check(Code64, "movl $5, 24(%r14)", "41 c7 46 18 05 00 00 00",
        ins2("mov", "l", imm(5), mem(24, "%r14")))
    n += check(Code64, "movl $foo, 8(%rax)", "c7 40 08 00 00 00 00 | 3:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), mem(8, "%rax")))
    n += check(Code64, "movw $7, (%rax)", "66 c7 00 07 00",
        ins2("mov", "w", imm(7), mem(0, "%rax")))
    n += check(Code64, "movb $0x41, (%rdi)", "c6 07 41",
        ins2("mov", "b", imm(0x41), mem(0, "%rdi")))
    n += check(Code64, "movl $1, foo(%rip)", "c7 05 00 00 00 00 01 00 00 00 | 2:pc4:foo-8",
        ins2("mov", "l", imm(1), rip("foo", 0)))
    n += check(Code64, "movq $0, foo(%rip)", "48 c7 05 00 00 00 00 00 00 00 00 | 3:pc4:foo-8",
        ins2("mov", "q", imm(0), rip("foo", 0)))
    n += check(Code64, "movb $1, foo(%rip)", "c6 05 00 00 00 00 01 | 2:pc4:foo-5",
        ins2("mov", "b", imm(1), rip("foo", 0)))
    n += check(Code64, "movw $2, foo(%rip)", "66 c7 05 00 00 00 00 02 00 | 3:pc4:foo-6",
        ins2("mov", "w", imm(2), rip("foo", 0)))
    n += check(Code64, "movabsq $0x123456789abcdef0, %rax", "48 b8 f0 de bc 9a 78 56 34 12",
        ins2("movabs", "q", imm(0x123456789abcdef0), r("%rax")))
    n += check(Code64, "movabsq $foo, %rcx", "48 b9 00 00 00 00 00 00 00 00 | 2:abs8:foo+0",
        ins2("movabs", "q", isym("foo", 0), r("%rcx")))
    n += check(Code64, "movabsq $foo+16, %r12", "49 bc 00 00 00 00 00 00 00 00 | 2:abs8:foo+16",
        ins2("movabs", "q", isym("foo", 16), r("%r12")))
    n += check(Code64, "movabsq $1, %rdx", "48 ba 01 00 00 00 00 00 00 00",
        ins2("movabs", "q", imm(1), r("%rdx")))
    n += check_err(Code64, "movq $0x100000000, 8(%rax)",
        ins2("mov", "q", imm(0x100000000), mem(8, "%rax")))
    n
