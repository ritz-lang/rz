# encode's encoder-only SSE2 integer forms (DESIGN.md "Library"), against
# `as --64` (test/support/check.ritz). The text parser rejects each of these.
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_padd_psub_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "paddb %xmm1, %xmm0", "66 0f fc c1",
        ins2("paddb", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "paddw %xmm1, %xmm0", "66 0f fd c1",
        ins2("paddw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "paddd (%rdi), %xmm8", "66 44 0f fe 07",
        ins2("paddd", "", mem(0, "%rdi"), r("%xmm8")))
    n += check(Code64, "paddq %xmm12, %xmm3", "66 41 0f d4 dc",
        ins2("paddq", "", r("%xmm12"), r("%xmm3")))
    n += check(Code64, "psubb %xmm1, %xmm0", "66 0f f8 c1",
        ins2("psubb", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psubw %xmm1, %xmm0", "66 0f f9 c1",
        ins2("psubw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psubd %xmm1, %xmm0", "66 0f fa c1",
        ins2("psubd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psubq 16(%rsp), %xmm0", "66 0f fb 44 24 10",
        ins2("psubq", "", mem(16, "%rsp"), r("%xmm0")))
    n


[[test]]
fn test_encode_pmullw_pmuludq_psadbw_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pmullw %xmm1, %xmm0", "66 0f d5 c1",
        ins2("pmullw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pmuludq %xmm9, %xmm2", "66 41 0f f4 d1",
        ins2("pmuludq", "", r("%xmm9"), r("%xmm2")))
    n += check(Code64, "pmuludq (%rax), %xmm2", "66 0f f4 10",
        ins2("pmuludq", "", mem(0, "%rax"), r("%xmm2")))
    n += check(Code64, "psadbw %xmm1, %xmm0", "66 0f f6 c1",
        ins2("psadbw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psadbw %xmm15, %xmm14", "66 45 0f f6 f7",
        ins2("psadbw", "", r("%xmm15"), r("%xmm14")))
    n


[[test]]
fn test_encode_integer_logic_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pand %xmm1, %xmm0", "66 0f db c1", ins2("pand", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pandn %xmm1, %xmm0", "66 0f df c1",
        ins2("pandn", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "por foo(%rip), %xmm0", "66 0f eb 05 00 00 00 00 | 4:pc4:foo-4",
        ins2("por", "", rip("foo", 0), r("%xmm0")))
    n += check(Code64, "pxor %xmm10, %xmm10", "66 45 0f ef d2",
        ins2("pxor", "", r("%xmm10"), r("%xmm10")))
    n


[[test]]
fn test_encode_pcmpeq_pcmpgt_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pcmpeqb %xmm1, %xmm0", "66 0f 74 c1",
        ins2("pcmpeqb", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pcmpeqw %xmm1, %xmm0", "66 0f 75 c1",
        ins2("pcmpeqw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pcmpeqd %xmm8, %xmm0", "66 41 0f 76 c0",
        ins2("pcmpeqd", "", r("%xmm8"), r("%xmm0")))
    n += check(Code64, "pcmpgtb %xmm1, %xmm0", "66 0f 64 c1",
        ins2("pcmpgtb", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pcmpgtw (%rdi), %xmm0", "66 0f 65 07",
        ins2("pcmpgtw", "", mem(0, "%rdi"), r("%xmm0")))
    n += check(Code64, "pcmpgtd %xmm1, %xmm11", "66 44 0f 66 d9",
        ins2("pcmpgtd", "", r("%xmm1"), r("%xmm11")))
    n


[[test]]
fn test_encode_vector_shifts_by_immediate_and_register_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "psllw $3, %xmm0", "66 0f 71 f0 03", ins2("psllw", "", imm(3), r("%xmm0")))
    n += check(Code64, "pslld $31, %xmm9", "66 41 0f 72 f1 1f",
        ins2("pslld", "", imm(31), r("%xmm9")))
    n += check(Code64, "psllq $1, %xmm2", "66 0f 73 f2 01", ins2("psllq", "", imm(1), r("%xmm2")))
    n += check(Code64, "psrlw $8, %xmm0", "66 0f 71 d0 08", ins2("psrlw", "", imm(8), r("%xmm0")))
    n += check(Code64, "psrld $4, %xmm0", "66 0f 72 d0 04", ins2("psrld", "", imm(4), r("%xmm0")))
    n += check(Code64, "psrlq $32, %xmm15", "66 41 0f 73 d7 20",
        ins2("psrlq", "", imm(32), r("%xmm15")))
    n += check(Code64, "psraw $2, %xmm0", "66 0f 71 e0 02", ins2("psraw", "", imm(2), r("%xmm0")))
    n += check(Code64, "psrad $31, %xmm3", "66 0f 72 e3 1f", ins2("psrad", "", imm(31), r("%xmm3")))
    n += check(Code64, "pslldq $8, %xmm1", "66 0f 73 f9 08", ins2("pslldq", "", imm(8), r("%xmm1")))
    n += check(Code64, "psrldq $4, %xmm12", "66 41 0f 73 dc 04",
        ins2("psrldq", "", imm(4), r("%xmm12")))
    n += check(Code64, "psllw %xmm1, %xmm0", "66 0f f1 c1",
        ins2("psllw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pslld (%rdi), %xmm0", "66 0f f2 07",
        ins2("pslld", "", mem(0, "%rdi"), r("%xmm0")))
    n += check(Code64, "psllq %xmm9, %xmm0", "66 41 0f f3 c1",
        ins2("psllq", "", r("%xmm9"), r("%xmm0")))
    n += check(Code64, "psrlw %xmm1, %xmm0", "66 0f d1 c1",
        ins2("psrlw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psrld %xmm1, %xmm0", "66 0f d2 c1",
        ins2("psrld", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psrlq %xmm1, %xmm10", "66 44 0f d3 d1",
        ins2("psrlq", "", r("%xmm1"), r("%xmm10")))
    n += check(Code64, "psraw %xmm1, %xmm0", "66 0f e1 c1",
        ins2("psraw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "psrad %xmm1, %xmm0", "66 0f e2 c1",
        ins2("psrad", "", r("%xmm1"), r("%xmm0")))
    n += check_err(Code64, "pslld $3, (%rdi)", ins2("pslld", "", imm(3), mem(0, "%rdi")))
    n += check_err(Code64, "pslldq %xmm1, %xmm0", ins2("pslldq", "", r("%xmm1"), r("%xmm0")))
    n


[[test]]
fn test_encode_shuffles_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pshufd $0x1b, %xmm1, %xmm0", "66 0f 70 c1 1b",
        ins3("pshufd", "", imm(0x1b), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pshufd $0, (%rdi), %xmm9", "66 44 0f 70 0f 00",
        ins3("pshufd", "", imm(0), mem(0, "%rdi"), r("%xmm9")))
    n += check(Code64, "pshuflw $0xe4, %xmm1, %xmm0", "f2 0f 70 c1 e4",
        ins3("pshuflw", "", imm(0xe4), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pshufhw $0x4e, %xmm10, %xmm0", "f3 41 0f 70 c2 4e",
        ins3("pshufhw", "", imm(0x4e), r("%xmm10"), r("%xmm0")))
    n += check(Code64, "shufps $0x88, %xmm1, %xmm0", "0f c6 c1 88",
        ins3("shufps", "", imm(0x88), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "shufps $1, 16(%rsp), %xmm13", "44 0f c6 6c 24 10 01",
        ins3("shufps", "", imm(1), mem(16, "%rsp"), r("%xmm13")))
    n += check_err(Code64, "pshufd %xmm1, %xmm0", ins2("pshufd", "", r("%xmm1"), r("%xmm0")))
    n


[[test]]
fn test_encode_unpacks_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "punpcklbw %xmm1, %xmm0", "66 0f 60 c1",
        ins2("punpcklbw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "punpcklwd %xmm1, %xmm0", "66 0f 61 c1",
        ins2("punpcklwd", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "punpckldq %xmm1, %xmm0", "66 0f 62 c1",
        ins2("punpckldq", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "punpcklqdq %xmm9, %xmm0", "66 41 0f 6c c1",
        ins2("punpcklqdq", "", r("%xmm9"), r("%xmm0")))
    n += check(Code64, "punpckhbw %xmm1, %xmm0", "66 0f 68 c1",
        ins2("punpckhbw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "punpckhwd (%rax), %xmm0", "66 0f 69 00",
        ins2("punpckhwd", "", mem(0, "%rax"), r("%xmm0")))
    n += check(Code64, "punpckhdq %xmm1, %xmm0", "66 0f 6a c1",
        ins2("punpckhdq", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "punpckhqdq %xmm1, %xmm8", "66 44 0f 6d c1",
        ins2("punpckhqdq", "", r("%xmm1"), r("%xmm8")))
    n


[[test]]
fn test_encode_packs_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "packsswb %xmm1, %xmm0", "66 0f 63 c1",
        ins2("packsswb", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "packssdw %xmm1, %xmm0", "66 0f 6b c1",
        ins2("packssdw", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "packuswb (%rdi), %xmm11", "66 44 0f 67 1f",
        ins2("packuswb", "", mem(0, "%rdi"), r("%xmm11")))
    n


[[test]]
fn test_encode_pextrw_pinsrw_pmovmskb_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pextrw $1, %xmm0, %eax", "66 0f c5 c0 01",
        ins3("pextrw", "", imm(1), r("%xmm0"), r("%eax")))
    n += check(Code64, "pextrw $7, %xmm9, %r10d", "66 45 0f c5 d1 07",
        ins3("pextrw", "", imm(7), r("%xmm9"), r("%r10d")))
    n += check(Code64, "pextrw $2, %xmm1, %rcx", "66 0f c5 c9 02",
        ins3("pextrw", "", imm(2), r("%xmm1"), r("%rcx")))
    n += check(Code64, "pinsrw $3, %eax, %xmm0", "66 0f c4 c0 03",
        ins3("pinsrw", "", imm(3), r("%eax"), r("%xmm0")))
    n += check(Code64, "pinsrw $0, %r8d, %xmm12", "66 45 0f c4 e0 00",
        ins3("pinsrw", "", imm(0), r("%r8d"), r("%xmm12")))
    n += check(Code64, "pinsrw $5, (%rdi), %xmm1", "66 0f c4 0f 05",
        ins3("pinsrw", "", imm(5), mem(0, "%rdi"), r("%xmm1")))
    n += check(Code64, "pmovmskb %xmm0, %eax", "66 0f d7 c0",
        ins2("pmovmskb", "", r("%xmm0"), r("%eax")))
    n += check(Code64, "pmovmskb %xmm11, %r9d", "66 45 0f d7 cb",
        ins2("pmovmskb", "", r("%xmm11"), r("%r9d")))
    n += check_err(Code64, "pextrw $1, (%rdi), %eax",
        ins3("pextrw", "", imm(1), mem(0, "%rdi"), r("%eax")))
    n += check_err(Code64, "pmovmskb (%rdi), %eax", ins2("pmovmskb", "", mem(0, "%rdi"), r("%eax")))
    n
