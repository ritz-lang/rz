# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.encode
import test.support.check


# `as` truncates these with a warning; razm refuses them.
[[test]]
fn test_encode_refuses_an_immediate_wider_than_its_field()
    let b = ins2("mov", "b", imm(256), r("%al"))
    assert encode_spec(Code64, b).is_err(), "movb $256"
    let w = ins2("mov", "w", imm(0x10000), r("%ax"))
    assert encode_spec(Code64, w).is_err(), "movw $0x10000"
    let l = ins2("mov", "l", imm(0x100000000), r("%eax"))
    assert encode_spec(Code64, l).is_err(), "movl $0x100000000"
    let port = ins2("in", "b", imm(0x100), r("%al"))
    assert encode_spec(Code64, port).is_err(), "inb $0x100"
