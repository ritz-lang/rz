# encode: the ALU group (add, or, and, sub, xor, cmp), test and bt, in every
# operand form and mode, against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_alu_memory_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "addq $1, 8(%rsp)", "48 83 44 24 08 01",
        ins2("add", "q", imm(1), mem(8, "%rsp")))
    n += check(Code64, "subl $300, (%rax)", "81 28 2c 01 00 00",
        ins2("sub", "l", imm(300), mem(0, "%rax")))
    n += check(Code64, "orb $1, (%rdi)", "80 0f 01", ins2("or", "b", imm(1), mem(0, "%rdi")))
    n += check(Code64, "cmpl $5, 40(%r14)", "41 83 7e 28 05",
        ins2("cmp", "l", imm(5), mem(40, "%r14")))
    n += check(Code64, "cmpq $0, 0x100(%rbp)", "48 83 bd 00 01 00 00 00",
        ins2("cmp", "q", imm(0), mem(0x100, "%rbp")))
    n += check(Code64, "addq %rax, %rbx", "48 01 c3", ins2("add", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "addq %r13, %rax", "4c 01 e8", ins2("add", "q", r("%r13"), r("%rax")))
    n += check(Code64, "subq %rcx, %r8", "49 29 c8", ins2("sub", "q", r("%rcx"), r("%r8")))
    n += check(Code64, "orq %rdx, %rax", "48 09 d0", ins2("or", "q", r("%rdx"), r("%rax")))
    n += check(Code64, "orl %edx, %eax", "09 d0", ins2("or", "l", r("%edx"), r("%eax")))
    n += check(Code64, "andq %rsi, %rdi", "48 21 f7", ins2("and", "q", r("%rsi"), r("%rdi")))
    n += check(Code64, "xorq %rax, %rax", "48 31 c0", ins2("xor", "q", r("%rax"), r("%rax")))
    n += check(Code64, "xorq %r12, %r12", "4d 31 e4", ins2("xor", "q", r("%r12"), r("%r12")))
    n += check(Code64, "xorl %eax, %eax", "31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code64, "xorw %ax, %ax", "66 31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code64, "xorb %al, %al", "30 c0", ins2("xor", "b", r("%al"), r("%al")))
    n += check(Code64, "xorb %dil, %r9b", "41 30 f9", ins2("xor", "b", r("%dil"), r("%r9b")))
    n += check(Code64, "cmpq %rdx, 8(%rsp)", "48 39 54 24 08",
        ins2("cmp", "q", r("%rdx"), mem(8, "%rsp")))
    n += check(Code64, "cmpq %rax, %rbx", "48 39 c3", ins2("cmp", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "cmpl %ecx, %eax", "39 c8", ins2("cmp", "l", r("%ecx"), r("%eax")))
    n += check(Code64, "xorq %rsi, (%rcx)", "48 31 31", ins2("xor", "q", r("%rsi"), mem(0, "%rcx")))
    n += check(Code64, "addq 8(%rsp), %rax", "48 03 44 24 08",
        ins2("add", "q", mem(8, "%rsp"), r("%rax")))
    n += check(Code64, "subl (%rdi), %r10d", "44 2b 17",
        ins2("sub", "l", mem(0, "%rdi"), r("%r10d")))
    n += check(Code64, "andb (%rsi), %cl", "22 0e", ins2("and", "b", mem(0, "%rsi"), r("%cl")))
    n += check(Code64, "cmpq (%rax), %r11", "4c 3b 18", ins2("cmp", "q", mem(0, "%rax"), r("%r11")))
    n += check(Code64, "orq foo(%rip), %rax", "48 0b 05 00 00 00 00 | 3:pc4:foo-4",
        ins2("or", "q", rip("foo", 0), r("%rax")))
    n += check(Code64, "cmpl $0, foo(%rip)", "83 3d 00 00 00 00 00 | 2:pc4:foo-5",
        ins2("cmp", "l", imm(0), rip("foo", 0)))
    n += check(Code64, "addl $1000, foo(%rip)", "81 05 00 00 00 00 e8 03 00 00 | 2:pc4:foo-8",
        ins2("add", "l", imm(1000), rip("foo", 0)))
    n
