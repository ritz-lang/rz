# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.encode
import test.support.check


[[test]]
fn test_encode_mov_segment_and_control_registers_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code64, "movw %ax, %ss", "8e d0", ins2("mov", "w", r("%ax"), r("%ss")))
    n += check(Code64, "movw %ax, %gs", "8e e8", ins2("mov", "w", r("%ax"), r("%gs")))
    n += check(Code64, "movl %eax, %fs", "8e e0", ins2("mov", "l", r("%eax"), r("%fs")))
    n += check(Code64, "movw %r9w, %es", "41 8e c1", ins2("mov", "w", r("%r9w"), r("%es")))
    n += check(Code64, "movw (%rax), %ds", "8e 18", ins2("mov", "w", mem(0, "%rax"), r("%ds")))
    n += check(Code64, "movl %cs, %eax", "8c c8", ins2("mov", "l", r("%cs"), r("%eax")))
    n += check(Code64, "movw %ds, %ax", "66 8c d8", ins2("mov", "w", r("%ds"), r("%ax")))
    n += check(Code64, "movq %ss, %rax", "8c d0", ins2("mov", "q", r("%ss"), r("%rax")))
    n += check(Code64, "movw %ds, (%rax)", "8c 18", ins2("mov", "w", r("%ds"), mem(0, "%rax")))
    n += check(Code32, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code32, "movw %ax, %fs", "8e e0", ins2("mov", "w", r("%ax"), r("%fs")))
    n += check(Code32, "movl %cs, %eax", "8c c8", ins2("mov", "l", r("%cs"), r("%eax")))
    n += check(Code16, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code16, "movw %ax, %ss", "8e d0", ins2("mov", "w", r("%ax"), r("%ss")))
    n += check(Code16, "movw %cs, %ax", "8c c8", ins2("mov", "w", r("%cs"), r("%ax")))
    n += check(Code64, "movq %cr3, %rax", "0f 20 d8", ins2("mov", "q", r("%cr3"), r("%rax")))
    n += check(Code64, "movq %rax, %cr3", "0f 22 d8", ins2("mov", "q", r("%rax"), r("%cr3")))
    n += check(Code64, "movq %cr2, %rdi", "0f 20 d7", ins2("mov", "q", r("%cr2"), r("%rdi")))
    n += check(Code64, "movq %r8, %cr4", "41 0f 22 e0", ins2("mov", "q", r("%r8"), r("%cr4")))
    n += check(Code64, "movq %cr0, %r12", "41 0f 20 c4", ins2("mov", "q", r("%cr0"), r("%r12")))
    n += check(Code32, "movl %cr0, %eax", "0f 20 c0", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check(Code32, "movl %eax, %cr0", "0f 22 c0", ins2("mov", "l", r("%eax"), r("%cr0")))
    n += check(Code32, "movl %eax, %cr3", "0f 22 d8", ins2("mov", "l", r("%eax"), r("%cr3")))
    n += check(Code32, "movl %cr4, %eax", "0f 20 e0", ins2("mov", "l", r("%cr4"), r("%eax")))
    n += check(Code32, "movl %edi, %cr4", "0f 22 e7", ins2("mov", "l", r("%edi"), r("%cr4")))
    n += check(Code16, "movl %cr0, %eax", "0f 20 c0", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check(Code16, "movl %eax, %cr0", "0f 22 c0", ins2("mov", "l", r("%eax"), r("%cr0")))
    n += check_err(Code64, "movl %cr0, %eax", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check_err(Code32, "movw %cr0, %ax", ins2("mov", "w", r("%cr0"), r("%ax")))
    n
