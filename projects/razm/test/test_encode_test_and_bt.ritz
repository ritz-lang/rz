# encode: the ALU group (add, or, and, sub, xor, cmp), test and bt, in every
# operand form and mode, against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_test_and_bt_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "testq %rax, %rax", "48 85 c0", ins2("test", "q", r("%rax"), r("%rax")))
    n += check(Code64, "testq %r8, %rsp", "4c 85 c4", ins2("test", "q", r("%r8"), r("%rsp")))
    n += check(Code64, "testl %edx, %ecx", "85 d1", ins2("test", "l", r("%edx"), r("%ecx")))
    n += check(Code64, "testb %al, %al", "84 c0", ins2("test", "b", r("%al"), r("%al")))
    n += check(Code64, "testb $1, %al", "a8 01", ins2("test", "b", imm(1), r("%al")))
    n += check(Code64, "testb $0x20, %dl", "f6 c2 20", ins2("test", "b", imm(0x20), r("%dl")))
    n += check(Code64, "testl $0x20000000, %edx", "f7 c2 00 00 00 20",
        ins2("test", "l", imm(0x20000000), r("%edx")))
    n += check(Code64, "testl $1, %eax", "a9 01 00 00 00", ins2("test", "l", imm(1), r("%eax")))
    n += check(Code64, "testq $3, 16(%rsp)", "48 f7 44 24 10 03 00 00 00",
        ins2("test", "q", imm(3), mem(16, "%rsp")))
    n += check(Code64, "testq $3, 144(%rsp)", "48 f7 84 24 90 00 00 00 03 00 00 00",
        ins2("test", "q", imm(3), mem(144, "%rsp")))
    n += check(Code64, "testq $1024, %rax", "48 a9 00 04 00 00",
        ins2("test", "q", imm(1024), r("%rax")))
    n += check(Code64, "testb $1, (%rax)", "f6 00 01", ins2("test", "b", imm(1), mem(0, "%rax")))
    n += check(Code32, "testl $0x200000, %eax", "a9 00 00 20 00",
        ins2("test", "l", imm(0x200000), r("%eax")))
    n += check(Code32, "testl %eax, %eax", "85 c0", ins2("test", "l", r("%eax"), r("%eax")))
    n += check(Code32, "testb %al, %al", "84 c0", ins2("test", "b", r("%al"), r("%al")))
    n += check(Code16, "testw $1, %ax", "a9 01 00", ins2("test", "w", imm(1), r("%ax")))
    n += check(Code64, "btl $29, %edx", "0f ba e2 1d", ins2("bt", "l", imm(29), r("%edx")))
    n += check(Code64, "btq $63, %rax", "48 0f ba e0 3f", ins2("bt", "q", imm(63), r("%rax")))
    n += check(Code64, "btl $3, (%rdi)", "0f ba 27 03", ins2("bt", "l", imm(3), mem(0, "%rdi")))
    n += check(Code64, "btq %rcx, %rax", "48 0f a3 c8", ins2("bt", "q", r("%rcx"), r("%rax")))
    n += check(Code32, "btl $21, %eax", "0f ba e0 15", ins2("bt", "l", imm(21), r("%eax")))
    n
