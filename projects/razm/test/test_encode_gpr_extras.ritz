# encode's encoder-only GPR forms, the ones rllvm selects beyond the text
# dialect (DESIGN.md "Library"), against `as --64` (test/support/check.ritz).
# The text parser rejects each of these mnemonics; only `encode` takes them.
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_mov_at_every_width_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movb %r9b, (%rdi)", "44 88 0f", ins2("mov", "b", r("%r9b"), mem(0, "%rdi")))
    n += check(Code64, "movw %si, 2(%rdi)", "66 89 77 02",
        ins2("mov", "w", r("%si"), mem(2, "%rdi")))
    n += check(Code64, "movw $-1, (%rax)", "66 c7 00 ff ff",
        ins2("mov", "w", imm(-1), mem(0, "%rax")))
    n += check(Code64, "movl (%rsi,%rcx,4), %r10d", "44 8b 14 8e",
        ins2("mov", "l", sib(0, "%rsi", "%rcx", 4), r("%r10d")))
    n += check(Code64, "movq %r15, -8(%rbp)", "4c 89 7d f8",
        ins2("mov", "q", r("%r15"), mem(-8, "%rbp")))
    n += check(Code64, "movb $7, %sil", "40 b6 07", ins2("mov", "b", imm(7), r("%sil")))
    n


[[test]]
fn test_encode_movzx_movsx_movslq_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movzbw %al, %cx", "66 0f b6 c8", ins2("movzb", "w", r("%al"), r("%cx")))
    n += check(Code64, "movzbq (%rdi), %rax", "48 0f b6 07",
        ins2("movzb", "q", mem(0, "%rdi"), r("%rax")))
    n += check(Code64, "movzwl %dx, %eax", "0f b7 c2", ins2("movzw", "l", r("%dx"), r("%eax")))
    n += check(Code64, "movzwq 6(%rsi), %r8", "4c 0f b7 46 06",
        ins2("movzw", "q", mem(6, "%rsi"), r("%r8")))
    n += check(Code64, "movsbl %sil, %eax", "40 0f be c6", ins2("movsb", "l", r("%sil"), r("%eax")))
    n += check(Code64, "movsbw %al, %ax", "66 0f be c0", ins2("movsb", "w", r("%al"), r("%ax")))
    n += check(Code64, "movsbq (%rax), %rcx", "48 0f be 08",
        ins2("movsb", "q", mem(0, "%rax"), r("%rcx")))
    n += check(Code64, "movswl %cx, %edx", "0f bf d1", ins2("movsw", "l", r("%cx"), r("%edx")))
    n += check(Code64, "movswq (%rdi), %r11", "4c 0f bf 1f",
        ins2("movsw", "q", mem(0, "%rdi"), r("%r11")))
    n += check(Code64, "movslq %eax, %rcx", "48 63 c8", ins2("movsl", "q", r("%eax"), r("%rcx")))
    n += check(Code64, "movslq 4(%rsp), %r9", "4c 63 4c 24 04",
        ins2("movsl", "q", mem(4, "%rsp"), r("%r9")))
    n += check_err(Code64, "movzwl %al, %eax", ins2("movzw", "l", r("%al"), r("%eax")))
    n += check_err(Code64, "movslq %eax, %ecx", ins2("movsl", "q", r("%eax"), r("%ecx")))
    n


[[test]]
fn test_encode_adc_sbb_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "adcq %rdx, %rax", "48 11 d0", ins2("adc", "q", r("%rdx"), r("%rax")))
    n += check(Code64, "adcq $0, %rcx", "48 83 d1 00", ins2("adc", "q", imm(0), r("%rcx")))
    n += check(Code64, "adcl $1000, %eax", "15 e8 03 00 00", ins2("adc", "l", imm(1000), r("%eax")))
    n += check(Code64, "sbbq 8(%rsi), %rax", "48 1b 46 08",
        ins2("sbb", "q", mem(8, "%rsi"), r("%rax")))
    n += check(Code64, "sbbl %eax, %eax", "19 c0", ins2("sbb", "l", r("%eax"), r("%eax")))
    n += check(Code64, "sbbb $1, %dl", "80 da 01", ins2("sbb", "b", imm(1), r("%dl")))
    n


[[test]]
fn test_encode_neg_not_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "negq %rax", "48 f7 d8", ins1("neg", "q", r("%rax")))
    n += check(Code64, "negl %r12d", "41 f7 dc", ins1("neg", "l", r("%r12d")))
    n += check(Code64, "negb (%rdi)", "f6 1f", ins1("neg", "b", mem(0, "%rdi")))
    n += check(Code64, "notq %rcx", "48 f7 d1", ins1("not", "q", r("%rcx")))
    n += check(Code64, "notw %ax", "66 f7 d0", ins1("not", "w", r("%ax")))
    n += check(Code64, "notl 16(%rsp)", "f7 54 24 10", ins1("not", "l", mem(16, "%rsp")))
    n += check_err(Code64, "negq $1", ins1("neg", "q", imm(1)))
    n


[[test]]
fn test_encode_imul_one_two_and_three_operands_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "imulq %rcx", "48 f7 e9", ins1("imul", "q", r("%rcx")))
    n += check(Code64, "imulb %dl", "f6 ea", ins1("imul", "b", r("%dl")))
    n += check(Code64, "imull (%rdi)", "f7 2f", ins1("imul", "l", mem(0, "%rdi")))
    n += check(Code64, "imulq %rsi, %rax", "48 0f af c6", ins2("imul", "q", r("%rsi"), r("%rax")))
    n += check(Code64, "imull 8(%rbp), %r9d", "44 0f af 4d 08",
        ins2("imul", "l", mem(8, "%rbp"), r("%r9d")))
    n += check(Code64, "imulw %cx, %dx", "66 0f af d1", ins2("imul", "w", r("%cx"), r("%dx")))
    n += check(Code64, "imulq $10, %rax", "48 6b c0 0a", ins2("imul", "q", imm(10), r("%rax")))
    n += check(Code64, "imulq $3, %rcx, %rdx", "48 6b d1 03",
        ins3("imul", "q", imm(3), r("%rcx"), r("%rdx")))
    n += check(Code64, "imull $1000, %esi, %eax", "69 c6 e8 03 00 00",
        ins3("imul", "l", imm(1000), r("%esi"), r("%eax")))
    n += check(Code64, "imulq $-7, (%rdi), %r10", "4c 6b 17 f9",
        ins3("imul", "q", imm(-7), mem(0, "%rdi"), r("%r10")))
    n += check(Code64, "imulw $300, %ax, %cx", "66 69 c8 2c 01",
        ins3("imul", "w", imm(300), r("%ax"), r("%cx")))
    n += check_err(Code64, "imulb %cl, %dl", ins2("imul", "b", r("%cl"), r("%dl")))
    n += check_err(Code64, "imulq $3, %rcx, (%rax)",
        ins3("imul", "q", imm(3), r("%rcx"), mem(0, "%rax")))
    n


[[test]]
fn test_encode_mul_div_idiv_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "mulq %rcx", "48 f7 e1", ins1("mul", "q", r("%rcx")))
    n += check(Code64, "mull 4(%rsp)", "f7 64 24 04", ins1("mul", "l", mem(4, "%rsp")))
    n += check(Code64, "mulb %bl", "f6 e3", ins1("mul", "b", r("%bl")))
    n += check(Code64, "divq %r8", "49 f7 f0", ins1("div", "q", r("%r8")))
    n += check(Code64, "divw %cx", "66 f7 f1", ins1("div", "w", r("%cx")))
    n += check(Code64, "idivq %rsi", "48 f7 fe", ins1("idiv", "q", r("%rsi")))
    n += check(Code64, "idivl (%rax)", "f7 38", ins1("idiv", "l", mem(0, "%rax")))
    n += check(Code64, "idivb %sil", "40 f6 fe", ins1("idiv", "b", r("%sil")))
    n


[[test]]
fn test_encode_sign_extensions_of_the_accumulator_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "cbtw", "66 98", ins0("cbtw", ""))
    n += check(Code64, "cwtl", "98", ins0("cwtl", ""))
    n += check(Code64, "cltq", "48 98", ins0("cltq", ""))
    n += check(Code64, "cwtd", "66 99", ins0("cwtd", ""))
    n += check(Code64, "cltd", "99", ins0("cltd", ""))
    n += check(Code64, "cqto", "48 99", ins0("cqto", ""))
    n += check(Code64, "cbw", "66 98", ins0("cbw", ""))
    n += check(Code64, "cwde", "98", ins0("cwde", ""))
    n += check(Code64, "cdqe", "48 98", ins0("cdqe", ""))
    n += check(Code64, "cwd", "66 99", ins0("cwd", ""))
    n += check(Code64, "cdq", "99", ins0("cdq", ""))
    n += check(Code64, "cqo", "48 99", ins0("cqo", ""))
    n += check(Code32, "cltd", "99", ins0("cltd", ""))
    n += check_err(Code32, "cqto", ins0("cqto", ""))
    n


[[test]]
fn test_encode_rotates_and_shifts_by_immediate_and_cl_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "rolq $13, %rax", "48 c1 c0 0d", ins2("rol", "q", imm(13), r("%rax")))
    n += check(Code64, "roll $1, %ecx", "d1 c1", ins2("rol", "l", imm(1), r("%ecx")))
    n += check(Code64, "rolw %cl, %dx", "66 d3 c2", ins2("rol", "w", r("%cl"), r("%dx")))
    n += check(Code64, "rorq $7, %r9", "49 c1 c9 07", ins2("ror", "q", imm(7), r("%r9")))
    n += check(Code64, "rorb %cl, %al", "d2 c8", ins2("ror", "b", r("%cl"), r("%al")))
    n += check(Code64, "rorl $3, 8(%rdi)", "c1 4f 08 03", ins2("ror", "l", imm(3), mem(8, "%rdi")))
    n += check(Code64, "sarl %cl, %esi", "d3 fe", ins2("sar", "l", r("%cl"), r("%esi")))
    n += check(Code64, "shrw $2, %ax", "66 c1 e8 02", ins2("shr", "w", imm(2), r("%ax")))
    n += check(Code64, "shlb %cl, (%rax)", "d2 20", ins2("shl", "b", r("%cl"), mem(0, "%rax")))
    n


[[test]]
fn test_encode_shld_shrd_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "shldq $3, %rbx, %rax", "48 0f a4 d8 03",
        ins3("shld", "q", imm(3), r("%rbx"), r("%rax")))
    n += check(Code64, "shldl %cl, %edx, %eax", "0f a5 d0",
        ins3("shld", "l", r("%cl"), r("%edx"), r("%eax")))
    n += check(Code64, "shrdq $60, %r8, %r9", "4d 0f ac c1 3c",
        ins3("shrd", "q", imm(60), r("%r8"), r("%r9")))
    n += check(Code64, "shrdq %cl, %rdx, (%rdi)", "48 0f ad 17",
        ins3("shrd", "q", r("%cl"), r("%rdx"), mem(0, "%rdi")))
    n += check(Code64, "shldw $4, %cx, %ax", "66 0f a4 c8 04",
        ins3("shld", "w", imm(4), r("%cx"), r("%ax")))
    n += check_err(Code64, "shldq %dl, %rbx, %rax",
        ins3("shld", "q", r("%dl"), r("%rbx"), r("%rax")))
    n


[[test]]
fn test_encode_bsf_bsr_bswap_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "bsfq %rdi, %rax", "48 0f bc c7", ins2("bsf", "q", r("%rdi"), r("%rax")))
    n += check(Code64, "bsfl (%rsi), %ecx", "0f bc 0e", ins2("bsf", "l", mem(0, "%rsi"), r("%ecx")))
    n += check(Code64, "bsrq %r10, %r11", "4d 0f bd da", ins2("bsr", "q", r("%r10"), r("%r11")))
    n += check(Code64, "bsrw %ax, %dx", "66 0f bd d0", ins2("bsr", "w", r("%ax"), r("%dx")))
    n += check(Code64, "bswapl %eax", "0f c8", ins1("bswap", "l", r("%eax")))
    n += check(Code64, "bswapq %rcx", "48 0f c9", ins1("bswap", "q", r("%rcx")))
    n += check(Code64, "bswapq %r13", "49 0f cd", ins1("bswap", "q", r("%r13")))
    n += check(Code64, "bswapl %r8d", "41 0f c8", ins1("bswap", "l", r("%r8d")))
    n += check_err(Code64, "bsfb %al, %cl", ins2("bsf", "b", r("%al"), r("%cl")))
    n += check_err(Code64, "bswapl (%rax)", ins1("bswap", "l", mem(0, "%rax")))
    n


[[test]]
fn test_encode_setcc_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "seto %al", "0f 90 c0", ins1("seto", "", r("%al")))
    n += check(Code64, "setno %cl", "0f 91 c1", ins1("setno", "", r("%cl")))
    n += check(Code64, "setb %dl", "0f 92 c2", ins1("setb", "", r("%dl")))
    n += check(Code64, "setc %dl", "0f 92 c2", ins1("setc", "", r("%dl")))
    n += check(Code64, "setae %bl", "0f 93 c3", ins1("setae", "", r("%bl")))
    n += check(Code64, "sete %al", "0f 94 c0", ins1("sete", "", r("%al")))
    n += check(Code64, "setz %sil", "40 0f 94 c6", ins1("setz", "", r("%sil")))
    n += check(Code64, "setne %r8b", "41 0f 95 c0", ins1("setne", "", r("%r8b")))
    n += check(Code64, "setbe %al", "0f 96 c0", ins1("setbe", "", r("%al")))
    n += check(Code64, "seta (%rdi)", "0f 97 07", ins1("seta", "", mem(0, "%rdi")))
    n += check(Code64, "sets %al", "0f 98 c0", ins1("sets", "", r("%al")))
    n += check(Code64, "setns %al", "0f 99 c0", ins1("setns", "", r("%al")))
    n += check(Code64, "setp %al", "0f 9a c0", ins1("setp", "", r("%al")))
    n += check(Code64, "setnp %al", "0f 9b c0", ins1("setnp", "", r("%al")))
    n += check(Code64, "setl %al", "0f 9c c0", ins1("setl", "", r("%al")))
    n += check(Code64, "setge %al", "0f 9d c0", ins1("setge", "", r("%al")))
    n += check(Code64, "setle %al", "0f 9e c0", ins1("setle", "", r("%al")))
    n += check(Code64, "setg %r15b", "41 0f 9f c7", ins1("setg", "", r("%r15b")))
    n += check(Code64, "setnae %al", "0f 92 c0", ins1("setnae", "", r("%al")))
    n += check(Code64, "setnle %al", "0f 9f c0", ins1("setnle", "", r("%al")))
    n += check_err(Code64, "sete $1", ins1("sete", "", imm(1)))
    n


[[test]]
fn test_encode_cmovcc_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "cmove %rcx, %rax", "48 0f 44 c1", ins2("cmove", "", r("%rcx"), r("%rax")))
    n += check(Code64, "cmovne %edx, %eax", "0f 45 c2", ins2("cmovne", "", r("%edx"), r("%eax")))
    n += check(Code64, "cmovl %r9, %r10", "4d 0f 4c d1", ins2("cmovl", "", r("%r9"), r("%r10")))
    n += check(Code64, "cmovge (%rdi), %rsi", "48 0f 4d 37",
        ins2("cmovge", "", mem(0, "%rdi"), r("%rsi")))
    n += check(Code64, "cmova %cx, %dx", "66 0f 47 d1", ins2("cmova", "", r("%cx"), r("%dx")))
    n += check(Code64, "cmovbe 8(%rsp), %eax", "0f 46 44 24 08",
        ins2("cmovbe", "", mem(8, "%rsp"), r("%eax")))
    n += check(Code64, "cmovs %rax, %rbx", "48 0f 48 d8", ins2("cmovs", "", r("%rax"), r("%rbx")))
    n += check(Code64, "cmovo %rax, %rbx", "48 0f 40 d8", ins2("cmovo", "", r("%rax"), r("%rbx")))
    n += check(Code64, "cmovp %rax, %rbx", "48 0f 4a d8", ins2("cmovp", "", r("%rax"), r("%rbx")))
    n += check(Code64, "cmovg %rax, %rbx", "48 0f 4f d8", ins2("cmovg", "", r("%rax"), r("%rbx")))
    n += check(Code64, "cmovneq %rax, %rbx", "48 0f 45 d8",
        ins2("cmovne", "q", r("%rax"), r("%rbx")))
    n += check_err(Code64, "cmove %al, %bl", ins2("cmove", "", r("%al"), r("%bl")))
    n += check_err(Code64, "cmove %rax, (%rdi)", ins2("cmove", "", r("%rax"), mem(0, "%rdi")))
    n


[[test]]
fn test_encode_jcc_on_every_condition_matches_as() -> i32
    var n: i32 = 0
    n += check_short(Code64, "jl L", "7c fe", ins1("jl", "", sym("L")))
    n += check_short(Code64, "jge L", "7d fe", ins1("jge", "", sym("L")))
    n += check_short(Code64, "jo L", "70 fe", ins1("jo", "", sym("L")))
    n += check_short(Code64, "jp L", "7a fe", ins1("jp", "", sym("L")))
    n += check(Code64, "jg L", "0f 8f fa ff ff ff", ins1("jg", "", sym("L")))
    n += check(Code64, "jle L", "0f 8e fa ff ff ff", ins1("jle", "", sym("L")))
    n += check(Code64, "jbe L", "0f 86 fa ff ff ff", ins1("jbe", "", sym("L")))
    n += check(Code64, "js L", "0f 88 fa ff ff ff", ins1("js", "", sym("L")))
    n += check(Code64, "jns foo", "0f 89 00 00 00 00 | 2:plt4:foo-4", ins1("jns", "", sym("foo")))
    n


[[test]]
fn test_encode_xadd_cmpxchg_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "lock xaddq %rax, (%rdi)", "f0 48 0f c1 07",
        with_prefix(Prefix.Lock, ins2("xadd", "q", r("%rax"), mem(0, "%rdi"))))
    n += check(Code64, "lock xaddl %ecx, 8(%rsi)", "f0 0f c1 4e 08",
        with_prefix(Prefix.Lock, ins2("xadd", "l", r("%ecx"), mem(8, "%rsi"))))
    n += check(Code64, "lock xaddb %al, (%rdx)", "f0 0f c0 02",
        with_prefix(Prefix.Lock, ins2("xadd", "b", r("%al"), mem(0, "%rdx"))))
    n += check(Code64, "lock xaddw %r9w, (%rdx)", "66 f0 44 0f c1 0a",
        with_prefix(Prefix.Lock, ins2("xadd", "w", r("%r9w"), mem(0, "%rdx"))))
    n += check(Code64, "xaddq %rax, %rcx", "48 0f c1 c1", ins2("xadd", "q", r("%rax"), r("%rcx")))
    n += check(Code64, "lock cmpxchgq %rcx, (%rdi)", "f0 48 0f b1 0f",
        with_prefix(Prefix.Lock, ins2("cmpxchg", "q", r("%rcx"), mem(0, "%rdi"))))
    n += check(Code64, "lock cmpxchgl %edx, 4(%r8)", "f0 41 0f b1 50 04",
        with_prefix(Prefix.Lock, ins2("cmpxchg", "l", r("%edx"), mem(4, "%r8"))))
    n += check(Code64, "lock cmpxchgb %cl, (%rsi)", "f0 0f b0 0e",
        with_prefix(Prefix.Lock, ins2("cmpxchg", "b", r("%cl"), mem(0, "%rsi"))))
    n += check_err(Code64, "lock xaddq %rax, $1",
        with_prefix(Prefix.Lock, ins2("xadd", "q", r("%rax"), imm(1))))
    n


[[test]]
fn test_encode_lock_alu_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "lock addq $1, (%rdi)", "f0 48 83 07 01",
        with_prefix(Prefix.Lock, ins2("add", "q", imm(1), mem(0, "%rdi"))))
    n += check(Code64, "lock addl %eax, 8(%rsi)", "f0 01 46 08",
        with_prefix(Prefix.Lock, ins2("add", "l", r("%eax"), mem(8, "%rsi"))))
    n += check(Code64, "lock subq %rcx, (%rdi)", "f0 48 29 0f",
        with_prefix(Prefix.Lock, ins2("sub", "q", r("%rcx"), mem(0, "%rdi"))))
    n += check(Code64, "lock andl $-2, (%rdi)", "f0 83 27 fe",
        with_prefix(Prefix.Lock, ins2("and", "l", imm(-2), mem(0, "%rdi"))))
    n += check(Code64, "lock orq %rax, (%rdx)", "f0 48 09 02",
        with_prefix(Prefix.Lock, ins2("or", "q", r("%rax"), mem(0, "%rdx"))))
    n += check(Code64, "lock xorb $1, (%rdi)", "f0 80 37 01",
        with_prefix(Prefix.Lock, ins2("xor", "b", imm(1), mem(0, "%rdi"))))
    n += check(Code64, "lock adcq %rax, (%rdi)", "f0 48 11 07",
        with_prefix(Prefix.Lock, ins2("adc", "q", r("%rax"), mem(0, "%rdi"))))
    n += check(Code64, "lock sbbl $5, (%rdi)", "f0 83 1f 05",
        with_prefix(Prefix.Lock, ins2("sbb", "l", imm(5), mem(0, "%rdi"))))
    n += check(Code64, "lock incq (%rdi)", "f0 48 ff 07",
        with_prefix(Prefix.Lock, ins1("inc", "q", mem(0, "%rdi"))))
    n += check(Code64, "lock decl 4(%rax)", "f0 ff 48 04",
        with_prefix(Prefix.Lock, ins1("dec", "l", mem(4, "%rax"))))
    n += check(Code64, "lock negq (%rdi)", "f0 48 f7 1f",
        with_prefix(Prefix.Lock, ins1("neg", "q", mem(0, "%rdi"))))
    n += check(Code64, "lock notl (%rdi)", "f0 f7 17",
        with_prefix(Prefix.Lock, ins1("not", "l", mem(0, "%rdi"))))
    n
