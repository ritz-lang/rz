# encode: the stack, inc/dec, shifts, the operand-less and system
# instructions, port I/O, string instructions and the lock/rep prefixes,
# against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_operandless_instructions_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "ret", "c3", ins0("ret", ""))
    n += check(Code64, "retq", "c3", ins0("ret", "q"))
    n += check(Code64, "lretq", "48 cb", ins0("lret", "q"))
    n += check(Code64, "iretq", "48 cf", ins0("iret", "q"))
    n += check(Code64, "sysretq", "48 0f 07", ins0("sysret", "q"))
    n += check(Code64, "syscall", "0f 05", ins0("syscall", ""))
    n += check(Code64, "swapgs", "0f 01 f8", ins0("swapgs", ""))
    n += check(Code64, "cli", "fa", ins0("cli", ""))
    n += check(Code64, "sti", "fb", ins0("sti", ""))
    n += check(Code64, "cld", "fc", ins0("cld", ""))
    n += check(Code64, "std", "fd", ins0("std", ""))
    n += check(Code64, "hlt", "f4", ins0("hlt", ""))
    n += check(Code64, "nop", "90", ins0("nop", ""))
    n += check(Code64, "pause", "f3 90", ins0("pause", ""))
    n += check(Code64, "ud2", "0f 0b", ins0("ud2", ""))
    n += check(Code64, "cpuid", "0f a2", ins0("cpuid", ""))
    n += check(Code64, "rdtsc", "0f 31", ins0("rdtsc", ""))
    n += check(Code64, "rdmsr", "0f 32", ins0("rdmsr", ""))
    n += check(Code64, "wrmsr", "0f 30", ins0("wrmsr", ""))
    n += check(Code64, "xgetbv", "0f 01 d0", ins0("xgetbv", ""))
    n += check(Code64, "lfence", "0f ae e8", ins0("lfence", ""))
    n += check(Code64, "mfence", "0f ae f0", ins0("mfence", ""))
    n += check(Code64, "sfence", "0f ae f8", ins0("sfence", ""))
    n += check(Code32, "ret", "c3", ins0("ret", ""))
    n += check(Code32, "cli", "fa", ins0("cli", ""))
    n += check(Code32, "hlt", "f4", ins0("hlt", ""))
    n += check(Code32, "cpuid", "0f a2", ins0("cpuid", ""))
    n += check(Code32, "rdmsr", "0f 32", ins0("rdmsr", ""))
    n += check(Code32, "wrmsr", "0f 30", ins0("wrmsr", ""))
    n += check(Code32, "iretl", "cf", ins0("iret", "l"))
    n += check(Code16, "cli", "fa", ins0("cli", ""))
    n += check(Code16, "cld", "fc", ins0("cld", ""))
    n += check(Code16, "ret", "c3", ins0("ret", ""))
    n += check(Code32, "syscall", "0f 05", ins0("syscall", ""))
    n += check_err(Code32, "swapgs", ins0("swapgs", ""))
    n += check_err(Code32, "iretq", ins0("iret", "q"))
    n += check_err(Code32, "retq", ins0("ret", "q"))
    n
