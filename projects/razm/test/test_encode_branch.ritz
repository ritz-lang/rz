# encode: call, jmp, jcc and loop, near and short, direct and `*%reg`, with
# the relocation each mode takes, against `as --64`
# (test/support/check.ritz). `L` is the instruction's own address.
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.emit
import razm.encode
import test.support.check


[[test]]
fn test_encode_branches_in_64_bit_mode_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "call foo", "e8 00 00 00 00 | 1:plt4:foo-4", ins1("call", "", sym("foo")))
    n += check(Code64, "callq foo", "e8 00 00 00 00 | 1:plt4:foo-4", ins1("call", "q", sym("foo")))
    n += check(Code64, "jmp foo", "e9 00 00 00 00 | 1:plt4:foo-4", ins1("jmp", "", sym("foo")))
    n += check(Code64, "je foo", "0f 84 00 00 00 00 | 2:plt4:foo-4", ins1("je", "", sym("foo")))
    n += check(Code64, "jne foo", "0f 85 00 00 00 00 | 2:plt4:foo-4", ins1("jne", "", sym("foo")))
    n += check(Code64, "ja foo", "0f 87 00 00 00 00 | 2:plt4:foo-4", ins1("ja", "", sym("foo")))
    n += check(Code64, "jb foo", "0f 82 00 00 00 00 | 2:plt4:foo-4", ins1("jb", "", sym("foo")))
    n += check(Code64, "jae foo", "0f 83 00 00 00 00 | 2:plt4:foo-4", ins1("jae", "", sym("foo")))
    n += check(Code64, "call *%rax", "ff d0", ins1("call", "", star("%rax")))
    n += check(Code64, "callq *%rdi", "ff d7", ins1("call", "q", star("%rdi")))
    n += check(Code64, "call *%r8", "41 ff d0", ins1("call", "", star("%r8")))
    n += check(Code64, "jmp *%rax", "ff e0", ins1("jmp", "", star("%rax")))
    n += check(Code64, "jmpq *%r11", "41 ff e3", ins1("jmp", "q", star("%r11")))
    n += check(Code64, "jmp L", "e9 fb ff ff ff", ins1("jmp", "", sym("L")))
    n += check(Code64, "je L", "0f 84 fa ff ff ff", ins1("je", "", sym("L")))
    n += check(Code64, "call L", "e8 fb ff ff ff", ins1("call", "", sym("L")))
    n += check(Code64, "loop foo", "e2 00 | 1:pc1:foo-1", ins1("loop", "", sym("foo")))
    n += check_short(Code64, "jmp L", "eb fe", ins1("jmp", "", sym("L")))
    n += check_short(Code64, "ja L", "77 fe", ins1("ja", "", sym("L")))
    n += check_short(Code64, "jb L", "72 fe", ins1("jb", "", sym("L")))
    n += check_short(Code64, "jae L", "73 fe", ins1("jae", "", sym("L")))
    n += check_short(Code64, "je L", "74 fe", ins1("je", "", sym("L")))
    n += check_short(Code64, "jne L", "75 fe", ins1("jne", "", sym("L")))
    n += check_short(Code64, "loop L", "e2 fe", ins1("loop", "", sym("L")))
    n += check(Code64, "jz foo", "0f 84 00 00 00 00 | 2:plt4:foo-4", ins1("jz", "", sym("foo")))
    n += check(Code64, "jnz foo", "0f 85 00 00 00 00 | 2:plt4:foo-4", ins1("jnz", "", sym("foo")))
    n += check(Code64, "jc foo", "0f 82 00 00 00 00 | 2:plt4:foo-4", ins1("jc", "", sym("foo")))
    n += check(Code64, "jnc foo", "0f 83 00 00 00 00 | 2:plt4:foo-4", ins1("jnc", "", sym("foo")))
    n += check_short(Code64, "jz L", "74 fe", ins1("jz", "", sym("L")))
    n += check_short(Code64, "jnz L", "75 fe", ins1("jnz", "", sym("L")))
    n += check_short(Code64, "jc L", "72 fe", ins1("jc", "", sym("L")))
    n += check_short(Code64, "jnc L", "73 fe", ins1("jnc", "", sym("L")))
    n += check(Code32, "jz L", "0f 84 fa ff ff ff", ins1("jz", "", sym("L")))
    n += check(Code16, "jnz foo", "0f 85 00 00 | 2:pc2:foo-2", ins1("jnz", "", sym("foo")))
    n += check_err(Code64, "call *%eax", ins1("call", "", star("%eax")))
    n += check_err(Code64, "jmpl *%eax", ins1("jmp", "l", star("%eax")))
    n


[[test]]
fn test_encode_branches_in_16_and_32_bit_modes_match_as() -> i32
    var n: i32 = 0
    n += check(Code32, "call foo", "e8 00 00 00 00 | 1:pc4:foo-4", ins1("call", "", sym("foo")))
    n += check(Code32, "jmp foo", "e9 00 00 00 00 | 1:pc4:foo-4", ins1("jmp", "", sym("foo")))
    n += check(Code32, "jne foo", "0f 85 00 00 00 00 | 2:pc4:foo-4", ins1("jne", "", sym("foo")))
    n += check(Code32, "call *%eax", "ff d0", ins1("call", "", star("%eax")))
    n += check(Code32, "jmp *%ecx", "ff e1", ins1("jmp", "", star("%ecx")))
    n += check(Code32, "jmp L", "e9 fb ff ff ff", ins1("jmp", "", sym("L")))
    n += check(Code32, "jb L", "0f 82 fa ff ff ff", ins1("jb", "", sym("L")))
    n += check_short(Code32, "jmp L", "eb fe", ins1("jmp", "", sym("L")))
    n += check_short(Code32, "je L", "74 fe", ins1("je", "", sym("L")))
    n += check_short(Code32, "loop L", "e2 fe", ins1("loop", "", sym("L")))
    n += check(Code16, "call foo", "e8 00 00 | 1:pc2:foo-2", ins1("call", "", sym("foo")))
    n += check(Code16, "jmp foo", "e9 00 00 | 1:pc2:foo-2", ins1("jmp", "", sym("foo")))
    n += check(Code16, "je foo", "0f 84 00 00 | 2:pc2:foo-2", ins1("je", "", sym("foo")))
    n += check(Code16, "jmp L", "e9 fd ff", ins1("jmp", "", sym("L")))
    n += check(Code16, "jne L", "0f 85 fc ff", ins1("jne", "", sym("L")))
    n += check(Code16, "call *%ax", "ff d0", ins1("call", "", star("%ax")))
    n += check_short(Code16, "jmp L", "eb fe", ins1("jmp", "", sym("L")))
    n += check_short(Code16, "jae L", "73 fe", ins1("jae", "", sym("L")))
    n += check_err(Code32, "call *%rax", ins1("call", "", star("%rax")))
    n


[[test]]
fn test_encode_short_refuses_forms_without_rel8()
    let call = ins1("call", "", sym("foo"))
    assert encode_spec_short(Code64, call).is_err(), "call has no rel8 form"
    let indirect = ins1("jmp", "", star("%rax"))
    assert encode_spec_short(Code64, indirect).is_err(), "jmp *%reg has no rel8 form"
    let add = ins2("add", "q", imm(1), r("%rax"))
    assert encode_spec_short(Code64, add).is_err(), "add is not a branch"
