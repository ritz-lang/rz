# encode: the stack, inc/dec, shifts, the operand-less and system
# instructions, port I/O, string instructions and the lock/rep prefixes,
# against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_system_and_memory_operand_instructions_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "lgdt foo", "0f 01 14 25 00 00 00 00 | 4:sabs4:foo+0",
        ins1("lgdt", "", sym("foo")))
    n += check(Code64, "lgdt (0x9000)", "0f 01 14 25 00 90 00 00", ins1("lgdt", "", at(0x9000)))
    n += check(Code64, "lgdt (%rdi)", "0f 01 17", ins1("lgdt", "", mem(0, "%rdi")))
    n += check(Code64, "lidt (%rdi)", "0f 01 1f", ins1("lidt", "", mem(0, "%rdi")))
    n += check(Code64, "lidt foo(%rip)", "0f 01 1d 00 00 00 00 | 3:pc4:foo-4",
        ins1("lidt", "", rip("foo", 0)))
    n += check(Code64, "ltr %ax", "0f 00 d8", ins1("ltr", "", r("%ax")))
    n += check(Code64, "ltr %di", "0f 00 df", ins1("ltr", "", r("%di")))
    n += check(Code64, "ltr (%rax)", "0f 00 18", ins1("ltr", "", mem(0, "%rax")))
    n += check(Code64, "invlpg (%rdi)", "0f 01 3f", ins1("invlpg", "", mem(0, "%rdi")))
    n += check(Code64, "invlpg (%r8)", "41 0f 01 38", ins1("invlpg", "", mem(0, "%r8")))
    n += check(Code64, "clflush (%rdi)", "0f ae 3f", ins1("clflush", "", mem(0, "%rdi")))
    n += check(Code64, "clflush 64(%rax)", "0f ae 78 40", ins1("clflush", "", mem(64, "%rax")))
    n += check(Code64, "nopl (%rax)", "0f 1f 00", ins1("nop", "l", mem(0, "%rax")))
    n += check(Code64, "nopl 0(%rax,%rax,1)", "0f 1f 04 00",
        ins1("nop", "l", sib(0, "%rax", "%rax", 1)))
    n += check(Code64, "nopw 0(%rax,%rax,1)", "66 0f 1f 04 00",
        ins1("nop", "w", sib(0, "%rax", "%rax", 1)))
    n += check(Code64, "rdrand %rax", "48 0f c7 f0", ins1("rdrand", "", r("%rax")))
    n += check(Code64, "rdrand %ecx", "0f c7 f1", ins1("rdrand", "", r("%ecx")))
    n += check(Code64, "rdrand %r9", "49 0f c7 f1", ins1("rdrand", "", r("%r9")))
    n += check(Code64, "rdrand %ax", "66 0f c7 f0", ins1("rdrand", "", r("%ax")))
    n += check(Code32, "lgdt foo", "0f 01 15 00 00 00 00 | 3:abs4:foo+0",
        ins1("lgdt", "", sym("foo")))
    n += check(Code32, "lgdt (0x9000)", "0f 01 15 00 90 00 00", ins1("lgdt", "", at(0x9000)))
    n += check(Code32, "lidt (%eax)", "0f 01 18", ins1("lidt", "", mem(0, "%eax")))
    n += check(Code16, "lgdt (0x8100)", "0f 01 16 00 81", ins1("lgdt", "", at(0x8100)))
    n += check(Code16, "lgdt foo", "0f 01 16 00 00 | 3:abs2:foo+0", ins1("lgdt", "", sym("foo")))
    n += check_err(Code64, "lgdt %rax", ins1("lgdt", "", r("%rax")))
    n += check_err(Code64, "rdrandb %al", ins1("rdrand", "b", r("%al")))
    n
