# encode: the stack, inc/dec, shifts, the operand-less and system
# instructions, port I/O, string instructions and the lock/rep prefixes,
# against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_inc_dec_and_shifts_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "incq %rax", "48 ff c0", ins1("inc", "q", r("%rax")))
    n += check(Code64, "incl %r9d", "41 ff c1", ins1("inc", "l", r("%r9d")))
    n += check(Code64, "incl (%rax)", "ff 00", ins1("inc", "l", mem(0, "%rax")))
    n += check(Code64, "incb %al", "fe c0", ins1("inc", "b", r("%al")))
    n += check(Code64, "decq %rcx", "48 ff c9", ins1("dec", "q", r("%rcx")))
    n += check(Code64, "decl %ecx", "ff c9", ins1("dec", "l", r("%ecx")))
    n += check(Code64, "decw %dx", "66 ff ca", ins1("dec", "w", r("%dx")))
    n += check(Code64, "incq foo(%rip)", "48 ff 05 00 00 00 00 | 3:pc4:foo-4",
        ins1("inc", "q", rip("foo", 0)))
    n += check(Code32, "incl %eax", "40", ins1("inc", "l", r("%eax")))
    n += check(Code32, "decl %ecx", "49", ins1("dec", "l", r("%ecx")))
    n += check(Code32, "decw %cx", "66 49", ins1("dec", "w", r("%cx")))
    n += check(Code32, "incl (%eax)", "ff 00", ins1("inc", "l", mem(0, "%eax")))
    n += check(Code16, "incw %si", "46", ins1("inc", "w", r("%si")))
    n += check(Code16, "decl %ecx", "66 49", ins1("dec", "l", r("%ecx")))
    n += check(Code64, "shlq $12, %rax", "48 c1 e0 0c", ins2("shl", "q", imm(12), r("%rax")))
    n += check(Code64, "shlq $1, %rax", "48 d1 e0", ins2("shl", "q", imm(1), r("%rax")))
    n += check(Code64, "shlq $4, %r10", "49 c1 e2 04", ins2("shl", "q", imm(4), r("%r10")))
    n += check(Code64, "shll $16, %edx", "c1 e2 10", ins2("shl", "l", imm(16), r("%edx")))
    n += check(Code64, "shrq $21, %rcx", "48 c1 e9 15", ins2("shr", "q", imm(21), r("%rcx")))
    n += check(Code64, "shrq $1, %rdi", "48 d1 ef", ins2("shr", "q", imm(1), r("%rdi")))
    n += check(Code64, "sarq $63, %rax", "48 c1 f8 3f", ins2("sar", "q", imm(63), r("%rax")))
    n += check(Code64, "shlq $3, 8(%rsp)", "48 c1 64 24 08 03",
        ins2("shl", "q", imm(3), mem(8, "%rsp")))
    n += check(Code64, "shlb $2, %al", "c0 e0 02", ins2("shl", "b", imm(2), r("%al")))
    n += check(Code64, "shlq %cl, %rax", "48 d3 e0", ins2("shl", "q", r("%cl"), r("%rax")))
    n += check(Code64, "shrl %cl, %edx", "d3 ea", ins2("shr", "l", r("%cl"), r("%edx")))
    n += check(Code32, "shll $4, %eax", "c1 e0 04", ins2("shl", "l", imm(4), r("%eax")))
    n += check(Code32, "shrl $1, %eax", "d1 e8", ins2("shr", "l", imm(1), r("%eax")))
    n += check(Code16, "shlw $4, %ax", "c1 e0 04", ins2("shl", "w", imm(4), r("%ax")))
    n += check_err(Code64, "shlq %dl, %rax", ins2("shl", "q", r("%dl"), r("%rax")))
    n
