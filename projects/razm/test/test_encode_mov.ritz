# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.encode
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_mov_immediate_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movq $60, %rax", "48 c7 c0 3c 00 00 00",
        ins2("mov", "q", imm(60), r("%rax")))
    n += check(Code64, "movq $-1, %rax", "48 c7 c0 ff ff ff ff",
        ins2("mov", "q", imm(-1), r("%rax")))
    n += check(Code64, "movq $0xffffffff, %rax", "48 b8 ff ff ff ff 00 00 00 00",
        ins2("mov", "q", imm(0xffffffff), r("%rax")))
    n += check(Code64, "movq $0x123456789, %r10", "49 ba 89 67 45 23 01 00 00 00",
        ins2("mov", "q", imm(0x123456789), r("%r10")))
    n += check(Code64, "movq $foo, %rsi", "48 c7 c6 00 00 00 00 | 3:sabs4:foo+0",
        ins2("mov", "q", isym("foo", 0), r("%rsi")))
    n += check(Code64, "movl $0xC0000080, %ecx", "b9 80 00 00 c0",
        ins2("mov", "l", imm(0xC0000080), r("%ecx")))
    n += check(Code64, "movl $foo, %edi", "bf 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), r("%edi")))
    n += check(Code64, "movl $1, %r9d", "41 b9 01 00 00 00", ins2("mov", "l", imm(1), r("%r9d")))
    n += check(Code64, "movw $0x10, %ax", "66 b8 10 00", ins2("mov", "w", imm(0x10), r("%ax")))
    n += check(Code64, "movw $foo, %r8w", "66 41 b8 00 00 | 3:abs2:foo+0",
        ins2("mov", "w", isym("foo", 0), r("%r8w")))
    n += check(Code64, "movb $1, %al", "b0 01", ins2("mov", "b", imm(1), r("%al")))
    n += check(Code64, "movb $1, %ah", "b4 01", ins2("mov", "b", imm(1), r("%ah")))
    n += check(Code64, "movb $0xff, %sil", "40 b6 ff", ins2("mov", "b", imm(0xff), r("%sil")))
    n += check(Code64, "movb $foo, %r11b", "41 b3 00 | 2:abs1:foo+0",
        ins2("mov", "b", isym("foo", 0), r("%r11b")))
    n += check(Code64, "movq $0, 40(%rsp)", "48 c7 44 24 28 00 00 00 00",
        ins2("mov", "q", imm(0), mem(40, "%rsp")))
    n += check(Code64, "movq $1, 80(%rsp)", "48 c7 44 24 50 01 00 00 00",
        ins2("mov", "q", imm(1), mem(80, "%rsp")))
    n += check(Code64, "movq $0, 56(%rax)", "48 c7 40 38 00 00 00 00",
        ins2("mov", "q", imm(0), mem(56, "%rax")))
    n += check(Code64, "movl $5, 24(%r14)", "41 c7 46 18 05 00 00 00",
        ins2("mov", "l", imm(5), mem(24, "%r14")))
    n += check(Code64, "movl $foo, 8(%rax)", "c7 40 08 00 00 00 00 | 3:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), mem(8, "%rax")))
    n += check(Code64, "movw $7, (%rax)", "66 c7 00 07 00",
        ins2("mov", "w", imm(7), mem(0, "%rax")))
    n += check(Code64, "movb $0x41, (%rdi)", "c6 07 41",
        ins2("mov", "b", imm(0x41), mem(0, "%rdi")))
    n += check(Code64, "movl $1, foo(%rip)", "c7 05 00 00 00 00 01 00 00 00 | 2:pc4:foo-8",
        ins2("mov", "l", imm(1), rip("foo", 0)))
    n += check(Code64, "movq $0, foo(%rip)", "48 c7 05 00 00 00 00 00 00 00 00 | 3:pc4:foo-8",
        ins2("mov", "q", imm(0), rip("foo", 0)))
    n += check(Code64, "movb $1, foo(%rip)", "c6 05 00 00 00 00 01 | 2:pc4:foo-5",
        ins2("mov", "b", imm(1), rip("foo", 0)))
    n += check(Code64, "movw $2, foo(%rip)", "66 c7 05 00 00 00 00 02 00 | 3:pc4:foo-6",
        ins2("mov", "w", imm(2), rip("foo", 0)))
    n += check(Code64, "movabsq $0x123456789abcdef0, %rax", "48 b8 f0 de bc 9a 78 56 34 12",
        ins2("movabs", "q", imm(0x123456789abcdef0), r("%rax")))
    n += check(Code64, "movabsq $foo, %rcx", "48 b9 00 00 00 00 00 00 00 00 | 2:abs8:foo+0",
        ins2("movabs", "q", isym("foo", 0), r("%rcx")))
    n += check(Code64, "movabsq $foo+16, %r12", "49 bc 00 00 00 00 00 00 00 00 | 2:abs8:foo+16",
        ins2("movabs", "q", isym("foo", 16), r("%r12")))
    n += check(Code64, "movabsq $1, %rdx", "48 ba 01 00 00 00 00 00 00 00",
        ins2("movabs", "q", imm(1), r("%rdx")))
    n += check_err(Code64, "movq $0x100000000, 8(%rax)",
        ins2("mov", "q", imm(0x100000000), mem(8, "%rax")))
    n


[[test]]
fn test_encode_mov_register_and_memory_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movq %rsp, %rbp", "48 89 e5", ins2("mov", "q", r("%rsp"), r("%rbp")))
    n += check(Code64, "movq %r11, %rax", "4c 89 d8", ins2("mov", "q", r("%r11"), r("%rax")))
    n += check(Code64, "movq %rax, %r15", "49 89 c7", ins2("mov", "q", r("%rax"), r("%r15")))
    n += check(Code64, "movl %edi, %eax", "89 f8", ins2("mov", "l", r("%edi"), r("%eax")))
    n += check(Code64, "movl %r8d, %r9d", "45 89 c1", ins2("mov", "l", r("%r8d"), r("%r9d")))
    n += check(Code64, "movw %ax, %bx", "66 89 c3", ins2("mov", "w", r("%ax"), r("%bx")))
    n += check(Code64, "movb %al, %dil", "40 88 c7", ins2("mov", "b", r("%al"), r("%dil")))
    n += check(Code64, "movb %ah, %bl", "88 e3", ins2("mov", "b", r("%ah"), r("%bl")))
    n += check(Code64, "movq %rax, 8(%rsp)", "48 89 44 24 08",
        ins2("mov", "q", r("%rax"), mem(8, "%rsp")))
    n += check(Code64, "movq %rbx, 0(%rax)", "48 89 18",
        ins2("mov", "q", r("%rbx"), mem(0, "%rax")))
    n += check(Code64, "movq %rsp, (%rdi)", "48 89 27", ins2("mov", "q", r("%rsp"), mem(0, "%rdi")))
    n += check(Code64, "movq %rdi, 136(%rax)", "48 89 b8 88 00 00 00",
        ins2("mov", "q", r("%rdi"), mem(136, "%rax")))
    n += check(Code64, "movl %r8d, 0x10(%rdi)", "44 89 47 10",
        ins2("mov", "l", r("%r8d"), mem(16, "%rdi")))
    n += check(Code64, "movl %eax, (%rdi)", "89 07", ins2("mov", "l", r("%eax"), mem(0, "%rdi")))
    n += check(Code64, "movw %si, 2(%rbx)", "66 89 73 02",
        ins2("mov", "w", r("%si"), mem(2, "%rbx")))
    n += check(Code64, "movb %cl, -1(%rbp)", "88 4d ff",
        ins2("mov", "b", r("%cl"), mem(-1, "%rbp")))
    n += check(Code64, "movq (%rax), %rax", "48 8b 00", ins2("mov", "q", mem(0, "%rax"), r("%rax")))
    n += check(Code64, "movq 80(%rsp), %r8", "4c 8b 44 24 50",
        ins2("mov", "q", mem(80, "%rsp"), r("%r8")))
    n += check(Code64, "movq 0(%rsp), %rcx", "48 8b 0c 24",
        ins2("mov", "q", mem(0, "%rsp"), r("%rcx")))
    n += check(Code64, "movq 8(%rbx), %rax", "48 8b 43 08",
        ins2("mov", "q", mem(8, "%rbx"), r("%rax")))
    n += check(Code64, "movq 0(%rbx), %rbx", "48 8b 1b",
        ins2("mov", "q", mem(0, "%rbx"), r("%rbx")))
    n += check(Code64, "movl 4(%r12), %eax", "41 8b 44 24 04",
        ins2("mov", "l", mem(4, "%r12"), r("%eax")))
    n += check(Code64, "movb (%rdi), %al", "8a 07", ins2("mov", "b", mem(0, "%rdi"), r("%al")))
    n += check(Code64, "movw (%r13), %dx", "66 41 8b 55 00",
        ins2("mov", "w", mem(0, "%r13"), r("%dx")))
    n += check(Code64, "movq foo(%rip), %rax", "48 8b 05 00 00 00 00 | 3:pc4:foo-4",
        ins2("mov", "q", rip("foo", 0), r("%rax")))
    n += check(Code64, "movl foo+8(%rip), %edi", "8b 3d 00 00 00 00 | 2:pc4:foo+4",
        ins2("mov", "l", rip("foo", 8), r("%edi")))
    n += check(Code64, "movq %rsp, foo(%rip)", "48 89 25 00 00 00 00 | 3:pc4:foo-4",
        ins2("mov", "q", r("%rsp"), rip("foo", 0)))
    n += check(Code64, "movq foo(%rax), %rbx", "48 8b 98 00 00 00 00 | 3:sabs4:foo+0",
        ins2("mov", "q", msym("foo", 0, "%rax"), r("%rbx")))
    n


[[test]]
fn test_encode_mov_in_16_and_32_bit_modes_match_as() -> i32
    var n: i32 = 0
    n += check(Code32, "movl $foo, %esp", "bc 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), r("%esp")))
    n += check(Code32, "movl $0x1000, %edi", "bf 00 10 00 00",
        ins2("mov", "l", imm(0x1000), r("%edi")))
    n += check(Code32, "movl %eax, (%edi)", "89 07", ins2("mov", "l", r("%eax"), mem(0, "%edi")))
    n += check(Code32, "movl $0, 4(%edi)", "c7 47 04 00 00 00 00",
        ins2("mov", "l", imm(0), mem(4, "%edi")))
    n += check(Code32, "movl %ebx, foo", "89 1d 00 00 00 00 | 2:abs4:foo+0",
        ins2("mov", "l", r("%ebx"), sym("foo")))
    n += check(Code32, "movl %eax, foo", "a3 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", r("%eax"), sym("foo")))
    n += check(Code32, "movl foo, %eax", "a1 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", sym("foo"), r("%eax")))
    n += check(Code32, "movl foo, %ecx", "8b 0d 00 00 00 00 | 2:abs4:foo+0",
        ins2("mov", "l", sym("foo"), r("%ecx")))
    n += check(Code32, "movl (0x8ff0), %eax", "a1 f0 8f 00 00",
        ins2("mov", "l", at(0x8ff0), r("%eax")))
    n += check(Code32, "movb (%esi), %al", "8a 06", ins2("mov", "b", mem(0, "%esi"), r("%al")))
    n += check(Code32, "movb %al, foo", "a2 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "b", r("%al"), sym("foo")))
    n += check(Code32, "movw $0x10, %ax", "66 b8 10 00", ins2("mov", "w", imm(0x10), r("%ax")))
    n += check(Code32, "movb $0x0f, %ah", "b4 0f", ins2("mov", "b", imm(0x0f), r("%ah")))
    n += check(Code32, "movl %esp, %ebp", "89 e5", ins2("mov", "l", r("%esp"), r("%ebp")))
    n += check(Code16, "movw $0x7C00, %sp", "bc 00 7c", ins2("mov", "w", imm(0x7C00), r("%sp")))
    n += check(Code16, "movw $foo, %si", "be 00 00 | 1:abs2:foo+0",
        ins2("mov", "w", isym("foo", 0), r("%si")))
    n += check(Code16, "movl $0x1000, %eax", "66 b8 00 10 00 00",
        ins2("mov", "l", imm(0x1000), r("%eax")))
    n += check(Code16, "movw %ax, %bx", "89 c3", ins2("mov", "w", r("%ax"), r("%bx")))
    n += check(Code16, "movl %eax, (%edi)", "67 66 89 07",
        ins2("mov", "l", r("%eax"), mem(0, "%edi")))
    n += check(Code16, "movw (0x500), %ax", "a1 00 05", ins2("mov", "w", at(0x500), r("%ax")))
    n += check(Code16, "movw (0x500), %cx", "8b 0e 00 05", ins2("mov", "w", at(0x500), r("%cx")))
    n += check(Code16, "movb %al, (0x500)", "a2 00 05", ins2("mov", "b", r("%al"), at(0x500)))
    n += check_err(Code32, "movq %rax, %rbx", ins2("mov", "q", r("%rax"), r("%rbx")))
    n += check_err(Code32, "movl %eax, foo(%rip)", ins2("mov", "l", r("%eax"), rip("foo", 0)))
    n += check_err(Code32, "movl (%rax), %eax", ins2("mov", "l", mem(0, "%rax"), r("%eax")))
    n


[[test]]
fn test_encode_movzb_lea_xchg_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movzbl %al, %edi", "0f b6 f8", ins2("movzb", "l", r("%al"), r("%edi")))
    n += check(Code64, "movzbl %sil, %eax", "40 0f b6 c6", ins2("movzb", "l", r("%sil"), r("%eax")))
    n += check(Code64, "movzbl %ah, %ecx", "0f b6 cc", ins2("movzb", "l", r("%ah"), r("%ecx")))
    n += check(Code64, "movzbl (%rdi), %r8d", "44 0f b6 07",
        ins2("movzb", "l", mem(0, "%rdi"), r("%r8d")))
    n += check(Code64, "movzbq %al, %rax", "48 0f b6 c0", ins2("movzb", "q", r("%al"), r("%rax")))
    n += check(Code64, "movzbw %al, %ax", "66 0f b6 c0", ins2("movzb", "w", r("%al"), r("%ax")))
    n += check(Code32, "movzbl %al, %eax", "0f b6 c0", ins2("movzb", "l", r("%al"), r("%eax")))
    n += check(Code64, "leaq 48(%rsp), %rdx", "48 8d 54 24 30",
        ins2("lea", "q", mem(48, "%rsp"), r("%rdx")))
    n += check(Code64, "leaq (%rax,%r13), %r14", "4e 8d 34 28",
        ins2("lea", "q", sib(0, "%rax", "%r13", 1), r("%r14")))
    n += check(Code64, "leaq 16(%r14), %rax", "49 8d 46 10",
        ins2("lea", "q", mem(16, "%r14"), r("%rax")))
    n += check(Code64, "leaq foo(%rip), %rdi", "48 8d 3d 00 00 00 00 | 3:pc4:foo-4",
        ins2("lea", "q", rip("foo", 0), r("%rdi")))
    n += check(Code64, "lea foo(%rip), %rdi", "48 8d 3d 00 00 00 00 | 3:pc4:foo-4",
        ins2("lea", "", rip("foo", 0), r("%rdi")))
    n += check(Code64, "leaq foo-8(%rip), %rcx", "48 8d 0d 00 00 00 00 | 3:pc4:foo-12",
        ins2("lea", "q", rip("foo", -8), r("%rcx")))
    n += check(Code64, "leal 1(%rax), %eax", "8d 40 01",
        ins2("lea", "l", mem(1, "%rax"), r("%eax")))
    n += check(Code32, "leal 4(%esp), %eax", "8d 44 24 04",
        ins2("lea", "l", mem(4, "%esp"), r("%eax")))
    n += check(Code64, "xchgq %rax, %rbx", "48 93", ins2("xchg", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "xchgq %rbx, %rax", "48 93", ins2("xchg", "q", r("%rbx"), r("%rax")))
    n += check(Code64, "xchgq %rbx, %rcx", "48 87 d9", ins2("xchg", "q", r("%rbx"), r("%rcx")))
    n += check(Code64, "xchgq %rax, %r9", "49 91", ins2("xchg", "q", r("%rax"), r("%r9")))
    n += check(Code64, "xchgl %eax, %eax", "87 c0", ins2("xchg", "l", r("%eax"), r("%eax")))
    n += check(Code64, "xchgb %al, %bl", "86 c3", ins2("xchg", "b", r("%al"), r("%bl")))
    n += check(Code64, "xchgq %rsp, (0x8ff8)", "48 87 24 25 f8 8f 00 00",
        ins2("xchg", "q", r("%rsp"), at(0x8ff8)))
    n += check(Code64, "xchgq %rdx, (%rdi)", "48 87 17",
        ins2("xchg", "q", r("%rdx"), mem(0, "%rdi")))
    n += check(Code64, "xchgq (%rdi), %rdx", "48 87 17",
        ins2("xchg", "q", mem(0, "%rdi"), r("%rdx")))
    n


[[test]]
fn test_encode_mov_segment_and_control_registers_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code64, "movw %ax, %ss", "8e d0", ins2("mov", "w", r("%ax"), r("%ss")))
    n += check(Code64, "movw %ax, %gs", "8e e8", ins2("mov", "w", r("%ax"), r("%gs")))
    n += check(Code64, "movl %eax, %fs", "8e e0", ins2("mov", "l", r("%eax"), r("%fs")))
    n += check(Code64, "movw %r9w, %es", "41 8e c1", ins2("mov", "w", r("%r9w"), r("%es")))
    n += check(Code64, "movw (%rax), %ds", "8e 18", ins2("mov", "w", mem(0, "%rax"), r("%ds")))
    n += check(Code64, "movl %cs, %eax", "8c c8", ins2("mov", "l", r("%cs"), r("%eax")))
    n += check(Code64, "movw %ds, %ax", "66 8c d8", ins2("mov", "w", r("%ds"), r("%ax")))
    n += check(Code64, "movq %ss, %rax", "8c d0", ins2("mov", "q", r("%ss"), r("%rax")))
    n += check(Code64, "movw %ds, (%rax)", "8c 18", ins2("mov", "w", r("%ds"), mem(0, "%rax")))
    n += check(Code32, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code32, "movw %ax, %fs", "8e e0", ins2("mov", "w", r("%ax"), r("%fs")))
    n += check(Code32, "movl %cs, %eax", "8c c8", ins2("mov", "l", r("%cs"), r("%eax")))
    n += check(Code16, "movw %ax, %ds", "8e d8", ins2("mov", "w", r("%ax"), r("%ds")))
    n += check(Code16, "movw %ax, %ss", "8e d0", ins2("mov", "w", r("%ax"), r("%ss")))
    n += check(Code16, "movw %cs, %ax", "8c c8", ins2("mov", "w", r("%cs"), r("%ax")))
    n += check(Code64, "movq %cr3, %rax", "0f 20 d8", ins2("mov", "q", r("%cr3"), r("%rax")))
    n += check(Code64, "movq %rax, %cr3", "0f 22 d8", ins2("mov", "q", r("%rax"), r("%cr3")))
    n += check(Code64, "movq %cr2, %rdi", "0f 20 d7", ins2("mov", "q", r("%cr2"), r("%rdi")))
    n += check(Code64, "movq %r8, %cr4", "41 0f 22 e0", ins2("mov", "q", r("%r8"), r("%cr4")))
    n += check(Code64, "movq %cr0, %r12", "41 0f 20 c4", ins2("mov", "q", r("%cr0"), r("%r12")))
    n += check(Code32, "movl %cr0, %eax", "0f 20 c0", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check(Code32, "movl %eax, %cr0", "0f 22 c0", ins2("mov", "l", r("%eax"), r("%cr0")))
    n += check(Code32, "movl %eax, %cr3", "0f 22 d8", ins2("mov", "l", r("%eax"), r("%cr3")))
    n += check(Code32, "movl %cr4, %eax", "0f 20 e0", ins2("mov", "l", r("%cr4"), r("%eax")))
    n += check(Code32, "movl %edi, %cr4", "0f 22 e7", ins2("mov", "l", r("%edi"), r("%cr4")))
    n += check(Code16, "movl %cr0, %eax", "0f 20 c0", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check(Code16, "movl %eax, %cr0", "0f 22 c0", ins2("mov", "l", r("%eax"), r("%cr0")))
    n += check_err(Code64, "movl %cr0, %eax", ins2("mov", "l", r("%cr0"), r("%eax")))
    n += check_err(Code32, "movw %cr0, %ax", ins2("mov", "w", r("%cr0"), r("%ax")))
    n


# `as` truncates these with a warning; razm refuses them.
[[test]]
fn test_encode_refuses_an_immediate_wider_than_its_field()
    let b = ins2("mov", "b", imm(256), r("%al"))
    assert encode_spec(Code64, b).is_err(), "movb $256"
    let w = ins2("mov", "w", imm(0x10000), r("%ax"))
    assert encode_spec(Code64, w).is_err(), "movw $0x10000"
    let l = ins2("mov", "l", imm(0x100000000), r("%eax"))
    assert encode_spec(Code64, l).is_err(), "movl $0x100000000"
    let port = ins2("in", "b", imm(0x100), r("%al"))
    assert encode_spec(Code64, port).is_err(), "inb $0x100"
