# encode: the ALU group (add, or, and, sub, xor, cmp), test and bt, in every
# operand form and mode, against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_alu_immediate_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "addq $8, %rsp", "48 83 c4 08", ins2("add", "q", imm(8), r("%rsp")))
    n += check(Code64, "addq $-8, %r9", "49 83 c1 f8", ins2("add", "q", imm(-8), r("%r9")))
    n += check(Code64, "addq $0x1000, %rax", "48 05 00 10 00 00",
        ins2("add", "q", imm(0x1000), r("%rax")))
    n += check(Code64, "addq $0x1000, %rbx", "48 81 c3 00 10 00 00",
        ins2("add", "q", imm(0x1000), r("%rbx")))
    n += check(Code64, "addl $1, %eax", "83 c0 01", ins2("add", "l", imm(1), r("%eax")))
    n += check(Code64, "addl $200, %eax", "05 c8 00 00 00", ins2("add", "l", imm(200), r("%eax")))
    n += check(Code64, "subq $4096, %rsp", "48 81 ec 00 10 00 00",
        ins2("sub", "q", imm(4096), r("%rsp")))
    n += check(Code64, "subq $16, %r15", "49 83 ef 10", ins2("sub", "q", imm(16), r("%r15")))
    n += check(Code64, "orl $0x80000000, %eax", "0d 00 00 00 80",
        ins2("or", "l", imm(0x80000000), r("%eax")))
    n += check(Code64, "orl $0xffffffff, %eax", "83 c8 ff",
        ins2("or", "l", imm(0xffffffff), r("%eax")))
    n += check(Code64, "orl $0x100, %edx", "81 ca 00 01 00 00",
        ins2("or", "l", imm(0x100), r("%edx")))
    n += check(Code64, "orq $1, %rax", "48 83 c8 01", ins2("or", "q", imm(1), r("%rax")))
    n += check(Code64, "andq $-16, %rsp", "48 83 e4 f0", ins2("and", "q", imm(-16), r("%rsp")))
    n += check(Code64, "andl $0xfffff000, %ecx", "81 e1 00 f0 ff ff",
        ins2("and", "l", imm(0xfffff000), r("%ecx")))
    n += check(Code64, "xorl $1, %r8d", "41 83 f0 01", ins2("xor", "l", imm(1), r("%r8d")))
    n += check(Code64, "xorq $0x7fffffff, %rax", "48 35 ff ff ff 7f",
        ins2("xor", "q", imm(0x7fffffff), r("%rax")))
    n += check(Code64, "cmpq $-22, %rax", "48 83 f8 ea", ins2("cmp", "q", imm(-22), r("%rax")))
    n += check(Code64, "cmpl $0x12345, %esi", "81 fe 45 23 01 00",
        ins2("cmp", "l", imm(0x12345), r("%esi")))
    n += check(Code64, "cmpw $1, %ax", "66 83 f8 01", ins2("cmp", "w", imm(1), r("%ax")))
    n += check(Code64, "cmpw $0x1234, %cx", "66 81 f9 34 12",
        ins2("cmp", "w", imm(0x1234), r("%cx")))
    n += check(Code64, "andb $0xFE, %al", "24 fe", ins2("and", "b", imm(0xFE), r("%al")))
    n += check(Code64, "andb $1, %bl", "80 e3 01", ins2("and", "b", imm(1), r("%bl")))
    n += check(Code64, "orb $2, %sil", "40 80 ce 02", ins2("or", "b", imm(2), r("%sil")))
    n += check(Code64, "orb $2, %ah", "80 cc 02", ins2("or", "b", imm(2), r("%ah")))
    n += check(Code64, "xorb $0x80, %r10b", "41 80 f2 80", ins2("xor", "b", imm(0x80), r("%r10b")))
    n += check(Code64, "addq $foo, %rax", "48 05 00 00 00 00 | 2:sabs4:foo+0",
        ins2("add", "q", isym("foo", 0), r("%rax")))
    n += check(Code64, "addl $foo+4, %ecx", "81 c1 00 00 00 00 | 2:abs4:foo+4",
        ins2("add", "l", isym("foo", 4), r("%ecx")))
    n += check(Code64, "cmpb $foo, %al", "3c 00 | 1:abs1:foo+0",
        ins2("cmp", "b", isym("foo", 0), r("%al")))
    n += check(Code64, "cmpw $foo, %dx", "66 81 fa 00 00 | 3:abs2:foo+0",
        ins2("cmp", "w", isym("foo", 0), r("%dx")))
    n


[[test]]
fn test_encode_alu_memory_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "addq $1, 8(%rsp)", "48 83 44 24 08 01",
        ins2("add", "q", imm(1), mem(8, "%rsp")))
    n += check(Code64, "subl $300, (%rax)", "81 28 2c 01 00 00",
        ins2("sub", "l", imm(300), mem(0, "%rax")))
    n += check(Code64, "orb $1, (%rdi)", "80 0f 01", ins2("or", "b", imm(1), mem(0, "%rdi")))
    n += check(Code64, "cmpl $5, 40(%r14)", "41 83 7e 28 05",
        ins2("cmp", "l", imm(5), mem(40, "%r14")))
    n += check(Code64, "cmpq $0, 0x100(%rbp)", "48 83 bd 00 01 00 00 00",
        ins2("cmp", "q", imm(0), mem(0x100, "%rbp")))
    n += check(Code64, "addq %rax, %rbx", "48 01 c3", ins2("add", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "addq %r13, %rax", "4c 01 e8", ins2("add", "q", r("%r13"), r("%rax")))
    n += check(Code64, "subq %rcx, %r8", "49 29 c8", ins2("sub", "q", r("%rcx"), r("%r8")))
    n += check(Code64, "orq %rdx, %rax", "48 09 d0", ins2("or", "q", r("%rdx"), r("%rax")))
    n += check(Code64, "orl %edx, %eax", "09 d0", ins2("or", "l", r("%edx"), r("%eax")))
    n += check(Code64, "andq %rsi, %rdi", "48 21 f7", ins2("and", "q", r("%rsi"), r("%rdi")))
    n += check(Code64, "xorq %rax, %rax", "48 31 c0", ins2("xor", "q", r("%rax"), r("%rax")))
    n += check(Code64, "xorq %r12, %r12", "4d 31 e4", ins2("xor", "q", r("%r12"), r("%r12")))
    n += check(Code64, "xorl %eax, %eax", "31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code64, "xorw %ax, %ax", "66 31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code64, "xorb %al, %al", "30 c0", ins2("xor", "b", r("%al"), r("%al")))
    n += check(Code64, "xorb %dil, %r9b", "41 30 f9", ins2("xor", "b", r("%dil"), r("%r9b")))
    n += check(Code64, "cmpq %rdx, 8(%rsp)", "48 39 54 24 08",
        ins2("cmp", "q", r("%rdx"), mem(8, "%rsp")))
    n += check(Code64, "cmpq %rax, %rbx", "48 39 c3", ins2("cmp", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "cmpl %ecx, %eax", "39 c8", ins2("cmp", "l", r("%ecx"), r("%eax")))
    n += check(Code64, "xorq %rsi, (%rcx)", "48 31 31", ins2("xor", "q", r("%rsi"), mem(0, "%rcx")))
    n += check(Code64, "addq 8(%rsp), %rax", "48 03 44 24 08",
        ins2("add", "q", mem(8, "%rsp"), r("%rax")))
    n += check(Code64, "subl (%rdi), %r10d", "44 2b 17",
        ins2("sub", "l", mem(0, "%rdi"), r("%r10d")))
    n += check(Code64, "andb (%rsi), %cl", "22 0e", ins2("and", "b", mem(0, "%rsi"), r("%cl")))
    n += check(Code64, "cmpq (%rax), %r11", "4c 3b 18", ins2("cmp", "q", mem(0, "%rax"), r("%r11")))
    n += check(Code64, "orq foo(%rip), %rax", "48 0b 05 00 00 00 00 | 3:pc4:foo-4",
        ins2("or", "q", rip("foo", 0), r("%rax")))
    n += check(Code64, "cmpl $0, foo(%rip)", "83 3d 00 00 00 00 00 | 2:pc4:foo-5",
        ins2("cmp", "l", imm(0), rip("foo", 0)))
    n += check(Code64, "addl $1000, foo(%rip)", "81 05 00 00 00 00 e8 03 00 00 | 2:pc4:foo-8",
        ins2("add", "l", imm(1000), rip("foo", 0)))
    n


[[test]]
fn test_encode_alu_in_16_and_32_bit_modes_match_as() -> i32
    var n: i32 = 0
    n += check(Code32, "orl $0x20, %eax", "83 c8 20", ins2("or", "l", imm(0x20), r("%eax")))
    n += check(Code32, "orl $0x80000000, %eax", "0d 00 00 00 80",
        ins2("or", "l", imm(0x80000000), r("%eax")))
    n += check(Code32, "andl $0xFFFF, %ebx", "81 e3 ff ff 00 00",
        ins2("and", "l", imm(0xFFFF), r("%ebx")))
    n += check(Code32, "addl $8, %esp", "83 c4 08", ins2("add", "l", imm(8), r("%esp")))
    n += check(Code32, "cmpl $0x80000001, %eax", "3d 01 00 00 80",
        ins2("cmp", "l", imm(0x80000001), r("%eax")))
    n += check(Code32, "cmpl %eax, %ecx", "39 c1", ins2("cmp", "l", r("%eax"), r("%ecx")))
    n += check(Code32, "xorl %eax, %eax", "31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code32, "xorw %ax, %ax", "66 31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code32, "addw $1, %bx", "66 83 c3 01", ins2("add", "w", imm(1), r("%bx")))
    n += check(Code32, "orb $1, %al", "0c 01", ins2("or", "b", imm(1), r("%al")))
    n += check(Code32, "cmpl $0, 4(%edi)", "83 7f 04 00", ins2("cmp", "l", imm(0), mem(4, "%edi")))
    n += check(Code32, "addl $foo, %ecx", "81 c1 00 00 00 00 | 2:abs4:foo+0",
        ins2("add", "l", isym("foo", 0), r("%ecx")))
    n += check(Code32, "cmpl $1, foo", "83 3d 00 00 00 00 01 | 2:abs4:foo+0",
        ins2("cmp", "l", imm(1), sym("foo")))
    n += check(Code16, "xorw %ax, %ax", "31 c0", ins2("xor", "w", r("%ax"), r("%ax")))
    n += check(Code16, "xorl %eax, %eax", "66 31 c0", ins2("xor", "l", r("%eax"), r("%eax")))
    n += check(Code16, "orb $0x02, %al", "0c 02", ins2("or", "b", imm(2), r("%al")))
    n += check(Code16, "andb $0xFE, %al", "24 fe", ins2("and", "b", imm(0xFE), r("%al")))
    n += check(Code16, "orl $0x01, %eax", "66 83 c8 01", ins2("or", "l", imm(1), r("%eax")))
    n += check(Code16, "orl $0x10000, %eax", "66 0d 00 00 01 00",
        ins2("or", "l", imm(0x10000), r("%eax")))
    n += check(Code16, "addw $0x1234, %bx", "81 c3 34 12", ins2("add", "w", imm(0x1234), r("%bx")))
    n += check(Code16, "cmpw $foo, %ax", "3d 00 00 | 1:abs2:foo+0",
        ins2("cmp", "w", isym("foo", 0), r("%ax")))
    n += check(Code16, "subl %ecx, %edx", "66 29 ca", ins2("sub", "l", r("%ecx"), r("%edx")))
    n += check_err(Code32, "addq $1, %rax", ins2("add", "q", imm(1), r("%rax")))
    n += check_err(Code32, "xorl %r8d, %eax", ins2("xor", "l", r("%r8d"), r("%eax")))
    n += check_err(Code16, "orb $1, %sil", ins2("or", "b", imm(1), r("%sil")))
    n += check_err(Code64, "orb %ah, %sil", ins2("or", "b", r("%ah"), r("%sil")))
    n += check_err(Code64, "addq $0x100000000, %rax", ins2("add", "q", imm(0x100000000), r("%rax")))
    n += check_err(Code64, "addl %eax, %rbx", ins2("add", "l", r("%eax"), r("%rbx")))
    n


[[test]]
fn test_encode_test_and_bt_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "testq %rax, %rax", "48 85 c0", ins2("test", "q", r("%rax"), r("%rax")))
    n += check(Code64, "testq %r8, %rsp", "4c 85 c4", ins2("test", "q", r("%r8"), r("%rsp")))
    n += check(Code64, "testl %edx, %ecx", "85 d1", ins2("test", "l", r("%edx"), r("%ecx")))
    n += check(Code64, "testb %al, %al", "84 c0", ins2("test", "b", r("%al"), r("%al")))
    n += check(Code64, "testb $1, %al", "a8 01", ins2("test", "b", imm(1), r("%al")))
    n += check(Code64, "testb $0x20, %dl", "f6 c2 20", ins2("test", "b", imm(0x20), r("%dl")))
    n += check(Code64, "testl $0x20000000, %edx", "f7 c2 00 00 00 20",
        ins2("test", "l", imm(0x20000000), r("%edx")))
    n += check(Code64, "testl $1, %eax", "a9 01 00 00 00", ins2("test", "l", imm(1), r("%eax")))
    n += check(Code64, "testq $3, 16(%rsp)", "48 f7 44 24 10 03 00 00 00",
        ins2("test", "q", imm(3), mem(16, "%rsp")))
    n += check(Code64, "testq $3, 144(%rsp)", "48 f7 84 24 90 00 00 00 03 00 00 00",
        ins2("test", "q", imm(3), mem(144, "%rsp")))
    n += check(Code64, "testq $1024, %rax", "48 a9 00 04 00 00",
        ins2("test", "q", imm(1024), r("%rax")))
    n += check(Code64, "testb $1, (%rax)", "f6 00 01", ins2("test", "b", imm(1), mem(0, "%rax")))
    n += check(Code32, "testl $0x200000, %eax", "a9 00 00 20 00",
        ins2("test", "l", imm(0x200000), r("%eax")))
    n += check(Code32, "testl %eax, %eax", "85 c0", ins2("test", "l", r("%eax"), r("%eax")))
    n += check(Code32, "testb %al, %al", "84 c0", ins2("test", "b", r("%al"), r("%al")))
    n += check(Code16, "testw $1, %ax", "a9 01 00", ins2("test", "w", imm(1), r("%ax")))
    n += check(Code64, "btl $29, %edx", "0f ba e2 1d", ins2("bt", "l", imm(29), r("%edx")))
    n += check(Code64, "btq $63, %rax", "48 0f ba e0 3f", ins2("bt", "q", imm(63), r("%rax")))
    n += check(Code64, "btl $3, (%rdi)", "0f ba 27 03", ins2("bt", "l", imm(3), mem(0, "%rdi")))
    n += check(Code64, "btq %rcx, %rax", "48 0f a3 c8", ins2("bt", "q", r("%rcx"), r("%rax")))
    n += check(Code32, "btl $21, %eax", "0f ba e0 15", ins2("bt", "l", imm(21), r("%eax")))
    n
