# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.encode
import test.support.check


[[test]]
fn test_encode_mov_in_16_and_32_bit_modes_match_as() -> i32
    var n: i32 = 0
    n += check(Code32, "movl $foo, %esp", "bc 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", isym("foo", 0), r("%esp")))
    n += check(Code32, "movl $0x1000, %edi", "bf 00 10 00 00",
        ins2("mov", "l", imm(0x1000), r("%edi")))
    n += check(Code32, "movl %eax, (%edi)", "89 07", ins2("mov", "l", r("%eax"), mem(0, "%edi")))
    n += check(Code32, "movl $0, 4(%edi)", "c7 47 04 00 00 00 00",
        ins2("mov", "l", imm(0), mem(4, "%edi")))
    n += check(Code32, "movl %ebx, foo", "89 1d 00 00 00 00 | 2:abs4:foo+0",
        ins2("mov", "l", r("%ebx"), sym("foo")))
    n += check(Code32, "movl %eax, foo", "a3 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", r("%eax"), sym("foo")))
    n += check(Code32, "movl foo, %eax", "a1 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "l", sym("foo"), r("%eax")))
    n += check(Code32, "movl foo, %ecx", "8b 0d 00 00 00 00 | 2:abs4:foo+0",
        ins2("mov", "l", sym("foo"), r("%ecx")))
    n += check(Code32, "movl (0x8ff0), %eax", "a1 f0 8f 00 00",
        ins2("mov", "l", at(0x8ff0), r("%eax")))
    n += check(Code32, "movb (%esi), %al", "8a 06", ins2("mov", "b", mem(0, "%esi"), r("%al")))
    n += check(Code32, "movb %al, foo", "a2 00 00 00 00 | 1:abs4:foo+0",
        ins2("mov", "b", r("%al"), sym("foo")))
    n += check(Code32, "movw $0x10, %ax", "66 b8 10 00", ins2("mov", "w", imm(0x10), r("%ax")))
    n += check(Code32, "movb $0x0f, %ah", "b4 0f", ins2("mov", "b", imm(0x0f), r("%ah")))
    n += check(Code32, "movl %esp, %ebp", "89 e5", ins2("mov", "l", r("%esp"), r("%ebp")))
    n += check(Code16, "movw $0x7C00, %sp", "bc 00 7c", ins2("mov", "w", imm(0x7C00), r("%sp")))
    n += check(Code16, "movw $foo, %si", "be 00 00 | 1:abs2:foo+0",
        ins2("mov", "w", isym("foo", 0), r("%si")))
    n += check(Code16, "movl $0x1000, %eax", "66 b8 00 10 00 00",
        ins2("mov", "l", imm(0x1000), r("%eax")))
    n += check(Code16, "movw %ax, %bx", "89 c3", ins2("mov", "w", r("%ax"), r("%bx")))
    n += check(Code16, "movl %eax, (%edi)", "67 66 89 07",
        ins2("mov", "l", r("%eax"), mem(0, "%edi")))
    n += check(Code16, "movw (0x500), %ax", "a1 00 05", ins2("mov", "w", at(0x500), r("%ax")))
    n += check(Code16, "movw (0x500), %cx", "8b 0e 00 05", ins2("mov", "w", at(0x500), r("%cx")))
    n += check(Code16, "movb %al, (0x500)", "a2 00 05", ins2("mov", "b", r("%al"), at(0x500)))
    n += check_err(Code32, "movq %rax, %rbx", ins2("mov", "q", r("%rax"), r("%rbx")))
    n += check_err(Code32, "movl %eax, foo(%rip)", ins2("mov", "l", r("%eax"), rip("foo", 0)))
    n += check_err(Code32, "movl (%rax), %eax", ins2("mov", "l", mem(0, "%rax"), r("%eax")))
    n
