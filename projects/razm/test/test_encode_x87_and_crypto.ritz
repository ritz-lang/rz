# encode's encoder-only x87 return moves and the SHA, AES and PCLMUL forms
# rllvm selects behind "target-features" (DESIGN.md "Library"), against
# `as --64` (test/support/check.ritz). The text parser rejects each of these.
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_x87_loads_and_stores_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "flds (%rdi)", "d9 07", ins1("flds", "", mem(0, "%rdi")))
    n += check(Code64, "flds -4(%rsp)", "d9 44 24 fc", ins1("flds", "", mem(-4, "%rsp")))
    n += check(Code64, "fldl 8(%rsp)", "dd 44 24 08", ins1("fldl", "", mem(8, "%rsp")))
    n += check(Code64, "fldl foo(%rip)", "dd 05 00 00 00 00 | 2:pc4:foo-4",
        ins1("fldl", "", rip("foo", 0)))
    n += check(Code64, "fstps (%rax)", "d9 18", ins1("fstps", "", mem(0, "%rax")))
    n += check(Code64, "fstps 4(%r12)", "41 d9 5c 24 04", ins1("fstps", "", mem(4, "%r12")))
    n += check(Code64, "fstpl -8(%rbp)", "dd 5d f8", ins1("fstpl", "", mem(-8, "%rbp")))
    n += check(Code32, "fldl 4(%esp)", "dd 44 24 04", ins1("fldl", "", mem(4, "%esp")))
    n += check_err(Code64, "flds %eax", ins1("flds", "", r("%eax")))
    n


[[test]]
fn test_encode_sha256_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "sha256rnds2 %xmm0, %xmm1, %xmm2", "0f 38 cb d1",
        ins3("sha256rnds2", "", r("%xmm0"), r("%xmm1"), r("%xmm2")))
    n += check(Code64, "sha256rnds2 %xmm9, %xmm10", "45 0f 38 cb d1",
        ins2("sha256rnds2", "", r("%xmm9"), r("%xmm10")))
    n += check(Code64, "sha256rnds2 (%rdi), %xmm3", "0f 38 cb 1f",
        ins2("sha256rnds2", "", mem(0, "%rdi"), r("%xmm3")))
    n += check(Code64, "sha256msg1 %xmm1, %xmm0", "0f 38 cc c1",
        ins2("sha256msg1", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "sha256msg1 16(%rsp), %xmm8", "44 0f 38 cc 44 24 10",
        ins2("sha256msg1", "", mem(16, "%rsp"), r("%xmm8")))
    n += check(Code64, "sha256msg2 %xmm11, %xmm4", "41 0f 38 cd e3",
        ins2("sha256msg2", "", r("%xmm11"), r("%xmm4")))
    n += check_err(Code64, "sha256rnds2 %xmm1, %xmm1, %xmm2",
        ins3("sha256rnds2", "", r("%xmm1"), r("%xmm1"), r("%xmm2")))
    n


[[test]]
fn test_encode_aes_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "aesenc %xmm1, %xmm0", "66 0f 38 dc c1",
        ins2("aesenc", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "aesenc (%rdi), %xmm9", "66 44 0f 38 dc 0f",
        ins2("aesenc", "", mem(0, "%rdi"), r("%xmm9")))
    n += check(Code64, "aesenclast %xmm1, %xmm0", "66 0f 38 dd c1",
        ins2("aesenclast", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "aesdec %xmm10, %xmm0", "66 41 0f 38 de c2",
        ins2("aesdec", "", r("%xmm10"), r("%xmm0")))
    n += check(Code64, "aesdeclast %xmm1, %xmm0", "66 0f 38 df c1",
        ins2("aesdeclast", "", r("%xmm1"), r("%xmm0")))
    n += check(Code64, "aesimc %xmm1, %xmm2", "66 0f 38 db d1",
        ins2("aesimc", "", r("%xmm1"), r("%xmm2")))
    n += check(Code64, "aeskeygenassist $1, %xmm1, %xmm2", "66 0f 3a df d1 01",
        ins3("aeskeygenassist", "", imm(1), r("%xmm1"), r("%xmm2")))
    n += check(Code64, "aeskeygenassist $0x36, (%rsi), %xmm12", "66 44 0f 3a df 26 36",
        ins3("aeskeygenassist", "", imm(0x36), mem(0, "%rsi"), r("%xmm12")))
    n


[[test]]
fn test_encode_pclmulqdq_matches_as() -> i32
    var n: i32 = 0
    n += check(Code64, "pclmulqdq $0, %xmm1, %xmm0", "66 0f 3a 44 c1 00",
        ins3("pclmulqdq", "", imm(0), r("%xmm1"), r("%xmm0")))
    n += check(Code64, "pclmulqdq $0x11, %xmm9, %xmm2", "66 41 0f 3a 44 d1 11",
        ins3("pclmulqdq", "", imm(0x11), r("%xmm9"), r("%xmm2")))
    n += check(Code64, "pclmulqdq $0x10, (%rdi), %xmm13", "66 44 0f 3a 44 2f 10",
        ins3("pclmulqdq", "", imm(0x10), mem(0, "%rdi"), r("%xmm13")))
    n
