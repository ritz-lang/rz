# encode: mov at every width and operand form, movabs, movzb, lea, xchg, and
# moves of %cr and segment registers, against `as --64`
# (test/support/check.ritz).
import ritzlib.result
import razm.insn { Prefix }
import razm.parse { Mode }
import razm.encode
import test.support.check


[[test]]
fn test_encode_movzb_lea_xchg_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "movzbl %al, %edi", "0f b6 f8", ins2("movzb", "l", r("%al"), r("%edi")))
    n += check(Code64, "movzbl %sil, %eax", "40 0f b6 c6", ins2("movzb", "l", r("%sil"), r("%eax")))
    n += check(Code64, "movzbl %ah, %ecx", "0f b6 cc", ins2("movzb", "l", r("%ah"), r("%ecx")))
    n += check(Code64, "movzbl (%rdi), %r8d", "44 0f b6 07",
        ins2("movzb", "l", mem(0, "%rdi"), r("%r8d")))
    n += check(Code64, "movzbq %al, %rax", "48 0f b6 c0", ins2("movzb", "q", r("%al"), r("%rax")))
    n += check(Code64, "movzbw %al, %ax", "66 0f b6 c0", ins2("movzb", "w", r("%al"), r("%ax")))
    n += check(Code32, "movzbl %al, %eax", "0f b6 c0", ins2("movzb", "l", r("%al"), r("%eax")))
    n += check(Code64, "leaq 48(%rsp), %rdx", "48 8d 54 24 30",
        ins2("lea", "q", mem(48, "%rsp"), r("%rdx")))
    n += check(Code64, "leaq (%rax,%r13), %r14", "4e 8d 34 28",
        ins2("lea", "q", sib(0, "%rax", "%r13", 1), r("%r14")))
    n += check(Code64, "leaq 16(%r14), %rax", "49 8d 46 10",
        ins2("lea", "q", mem(16, "%r14"), r("%rax")))
    n += check(Code64, "leaq foo(%rip), %rdi", "48 8d 3d 00 00 00 00 | 3:pc4:foo-4",
        ins2("lea", "q", rip("foo", 0), r("%rdi")))
    n += check(Code64, "lea foo(%rip), %rdi", "48 8d 3d 00 00 00 00 | 3:pc4:foo-4",
        ins2("lea", "", rip("foo", 0), r("%rdi")))
    n += check(Code64, "leaq foo-8(%rip), %rcx", "48 8d 0d 00 00 00 00 | 3:pc4:foo-12",
        ins2("lea", "q", rip("foo", -8), r("%rcx")))
    n += check(Code64, "leal 1(%rax), %eax", "8d 40 01",
        ins2("lea", "l", mem(1, "%rax"), r("%eax")))
    n += check(Code32, "leal 4(%esp), %eax", "8d 44 24 04",
        ins2("lea", "l", mem(4, "%esp"), r("%eax")))
    n += check(Code64, "xchgq %rax, %rbx", "48 93", ins2("xchg", "q", r("%rax"), r("%rbx")))
    n += check(Code64, "xchgq %rbx, %rax", "48 93", ins2("xchg", "q", r("%rbx"), r("%rax")))
    n += check(Code64, "xchgq %rbx, %rcx", "48 87 d9", ins2("xchg", "q", r("%rbx"), r("%rcx")))
    n += check(Code64, "xchgq %rax, %r9", "49 91", ins2("xchg", "q", r("%rax"), r("%r9")))
    n += check(Code64, "xchgl %eax, %eax", "87 c0", ins2("xchg", "l", r("%eax"), r("%eax")))
    n += check(Code64, "xchgb %al, %bl", "86 c3", ins2("xchg", "b", r("%al"), r("%bl")))
    n += check(Code64, "xchgq %rsp, (0x8ff8)", "48 87 24 25 f8 8f 00 00",
        ins2("xchg", "q", r("%rsp"), at(0x8ff8)))
    n += check(Code64, "xchgq %rdx, (%rdi)", "48 87 17",
        ins2("xchg", "q", r("%rdx"), mem(0, "%rdi")))
    n += check(Code64, "xchgq (%rdi), %rdx", "48 87 17",
        ins2("xchg", "q", mem(0, "%rdi"), r("%rdx")))
    n
