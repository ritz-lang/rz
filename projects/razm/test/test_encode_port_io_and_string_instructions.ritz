# encode: the stack, inc/dec, shifts, the operand-less and system
# instructions, port I/O, string instructions and the lock/rep prefixes,
# against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_port_io_and_string_instructions_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "inb %dx, %al", "ec", ins2("in", "b", r("%dx"), r("%al")))
    n += check(Code64, "inw %dx, %ax", "66 ed", ins2("in", "w", r("%dx"), r("%ax")))
    n += check(Code64, "inl %dx, %eax", "ed", ins2("in", "l", r("%dx"), r("%eax")))
    n += check(Code64, "inb $0x60, %al", "e4 60", ins2("in", "b", imm(0x60), r("%al")))
    n += check(Code64, "inw $0x60, %ax", "66 e5 60", ins2("in", "w", imm(0x60), r("%ax")))
    n += check(Code64, "inl $0xcf, %eax", "e5 cf", ins2("in", "l", imm(0xcf), r("%eax")))
    n += check(Code64, "outb %al, %dx", "ee", ins2("out", "b", r("%al"), r("%dx")))
    n += check(Code64, "outw %ax, %dx", "66 ef", ins2("out", "w", r("%ax"), r("%dx")))
    n += check(Code64, "outl %eax, %dx", "ef", ins2("out", "l", r("%eax"), r("%dx")))
    n += check(Code64, "outb %al, $0x80", "e6 80", ins2("out", "b", r("%al"), imm(0x80)))
    n += check(Code64, "outw %ax, $0x80", "66 e7 80", ins2("out", "w", r("%ax"), imm(0x80)))
    n += check(Code64, "outl %eax, $0x80", "e7 80", ins2("out", "l", r("%eax"), imm(0x80)))
    n += check(Code32, "inb %dx, %al", "ec", ins2("in", "b", r("%dx"), r("%al")))
    n += check(Code32, "outb %al, %dx", "ee", ins2("out", "b", r("%al"), r("%dx")))
    n += check(Code32, "inw %dx, %ax", "66 ed", ins2("in", "w", r("%dx"), r("%ax")))
    n += check(Code16, "inb $0x92, %al", "e4 92", ins2("in", "b", imm(0x92), r("%al")))
    n += check(Code16, "outb %al, $0x92", "e6 92", ins2("out", "b", r("%al"), imm(0x92)))
    n += check(Code16, "inw %dx, %ax", "ed", ins2("in", "w", r("%dx"), r("%ax")))
    n += check(Code16, "inl %dx, %eax", "66 ed", ins2("in", "l", r("%dx"), r("%eax")))
    n += check(Code64, "lodsb", "ac", ins0("lods", "b"))
    n += check(Code64, "stosl", "ab", ins0("stos", "l"))
    n += check(Code64, "stosw", "66 ab", ins0("stos", "w"))
    n += check(Code64, "stosq", "48 ab", ins0("stos", "q"))
    n += check(Code64, "rep stosl", "f3 ab", with_prefix(Rep, ins0("stos", "l")))
    n += check(Code64, "rep stosw", "66 f3 ab", with_prefix(Rep, ins0("stos", "w")))
    n += check(Code64, "rep stosb", "f3 aa", with_prefix(Rep, ins0("stos", "b")))
    n += check(Code32, "lodsb", "ac", ins0("lods", "b"))
    n += check(Code32, "rep stosl", "f3 ab", with_prefix(Rep, ins0("stos", "l")))
    n += check(Code32, "stosw", "66 ab", ins0("stos", "w"))
    n += check(Code16, "stosw", "ab", ins0("stos", "w"))
    n += check(Code16, "stosl", "66 ab", ins0("stos", "l"))
    n += check(Code64, "lock incl foo(%rip)", "f0 ff 05 00 00 00 00 | 3:pc4:foo-4",
        with_prefix(Lock, ins1("inc", "l", rip("foo", 0))))
    n += check(Code64, "lock incq foo(%rip)", "f0 48 ff 05 00 00 00 00 | 4:pc4:foo-4",
        with_prefix(Lock, ins1("inc", "q", rip("foo", 0))))
    n += check(Code64, "lock incw (%rax)", "66 f0 ff 00",
        with_prefix(Lock, ins1("inc", "w", mem(0, "%rax"))))
    n += check(Code64, "lock addq %rax, (%rdi)", "f0 48 01 07",
        with_prefix(Lock, ins2("add", "q", r("%rax"), mem(0, "%rdi"))))
    n += check(Code64, "lock orl $1, %gs:8", "65 f0 83 0c 25 08 00 00 00 01",
        with_prefix(Lock, ins2("or", "l", imm(1), seg_at("%gs", 8))))
    n += check_err(Code64, "inb %cx, %al", ins2("in", "b", r("%cx"), r("%al")))
    n += check_err(Code64, "outb %bl, %dx", ins2("out", "b", r("%bl"), r("%dx")))
    n
