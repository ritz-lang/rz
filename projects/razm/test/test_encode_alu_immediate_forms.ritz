# encode: the ALU group (add, or, and, sub, xor, cmp), test and bt, in every
# operand form and mode, against `as --64` (test/support/check.ritz).
import razm.insn { Prefix }
import razm.parse { Mode }
import test.support.check


[[test]]
fn test_encode_alu_immediate_forms_match_as() -> i32
    var n: i32 = 0
    n += check(Code64, "addq $8, %rsp", "48 83 c4 08", ins2("add", "q", imm(8), r("%rsp")))
    n += check(Code64, "addq $-8, %r9", "49 83 c1 f8", ins2("add", "q", imm(-8), r("%r9")))
    n += check(Code64, "addq $0x1000, %rax", "48 05 00 10 00 00",
        ins2("add", "q", imm(0x1000), r("%rax")))
    n += check(Code64, "addq $0x1000, %rbx", "48 81 c3 00 10 00 00",
        ins2("add", "q", imm(0x1000), r("%rbx")))
    n += check(Code64, "addl $1, %eax", "83 c0 01", ins2("add", "l", imm(1), r("%eax")))
    n += check(Code64, "addl $200, %eax", "05 c8 00 00 00", ins2("add", "l", imm(200), r("%eax")))
    n += check(Code64, "subq $4096, %rsp", "48 81 ec 00 10 00 00",
        ins2("sub", "q", imm(4096), r("%rsp")))
    n += check(Code64, "subq $16, %r15", "49 83 ef 10", ins2("sub", "q", imm(16), r("%r15")))
    n += check(Code64, "orl $0x80000000, %eax", "0d 00 00 00 80",
        ins2("or", "l", imm(0x80000000), r("%eax")))
    n += check(Code64, "orl $0xffffffff, %eax", "83 c8 ff",
        ins2("or", "l", imm(0xffffffff), r("%eax")))
    n += check(Code64, "orl $0x100, %edx", "81 ca 00 01 00 00",
        ins2("or", "l", imm(0x100), r("%edx")))
    n += check(Code64, "orq $1, %rax", "48 83 c8 01", ins2("or", "q", imm(1), r("%rax")))
    n += check(Code64, "andq $-16, %rsp", "48 83 e4 f0", ins2("and", "q", imm(-16), r("%rsp")))
    n += check(Code64, "andl $0xfffff000, %ecx", "81 e1 00 f0 ff ff",
        ins2("and", "l", imm(0xfffff000), r("%ecx")))
    n += check(Code64, "xorl $1, %r8d", "41 83 f0 01", ins2("xor", "l", imm(1), r("%r8d")))
    n += check(Code64, "xorq $0x7fffffff, %rax", "48 35 ff ff ff 7f",
        ins2("xor", "q", imm(0x7fffffff), r("%rax")))
    n += check(Code64, "cmpq $-22, %rax", "48 83 f8 ea", ins2("cmp", "q", imm(-22), r("%rax")))
    n += check(Code64, "cmpl $0x12345, %esi", "81 fe 45 23 01 00",
        ins2("cmp", "l", imm(0x12345), r("%esi")))
    n += check(Code64, "cmpw $1, %ax", "66 83 f8 01", ins2("cmp", "w", imm(1), r("%ax")))
    n += check(Code64, "cmpw $0x1234, %cx", "66 81 f9 34 12",
        ins2("cmp", "w", imm(0x1234), r("%cx")))
    n += check(Code64, "andb $0xFE, %al", "24 fe", ins2("and", "b", imm(0xFE), r("%al")))
    n += check(Code64, "andb $1, %bl", "80 e3 01", ins2("and", "b", imm(1), r("%bl")))
    n += check(Code64, "orb $2, %sil", "40 80 ce 02", ins2("or", "b", imm(2), r("%sil")))
    n += check(Code64, "orb $2, %ah", "80 cc 02", ins2("or", "b", imm(2), r("%ah")))
    n += check(Code64, "xorb $0x80, %r10b", "41 80 f2 80", ins2("xor", "b", imm(0x80), r("%r10b")))
    n += check(Code64, "addq $foo, %rax", "48 05 00 00 00 00 | 2:sabs4:foo+0",
        ins2("add", "q", isym("foo", 0), r("%rax")))
    n += check(Code64, "addl $foo+4, %ecx", "81 c1 00 00 00 00 | 2:abs4:foo+4",
        ins2("add", "l", isym("foo", 4), r("%ecx")))
    n += check(Code64, "cmpb $foo, %al", "3c 00 | 1:abs1:foo+0",
        ins2("cmp", "b", isym("foo", 0), r("%al")))
    n += check(Code64, "cmpw $foo, %dx", "66 81 fa 00 00 | 3:abs2:foo+0",
        ins2("cmp", "w", isym("foo", 0), r("%dx")))
    n
