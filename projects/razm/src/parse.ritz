# parse: AT&T text in razm's dialect (DESIGN.md "Text razm accepts") to
# structured statements: labels, directives and instructions.
#
# One pass over the lines. `.macro` bodies are kept as lines and expanded at
# each call (with `\param` substituted into any token), `.rept` bodies are
# run their count of times, numeric local labels (`N:`, `Nb`, `Nf`) get
# unique `.L` names, and the operands that must be absolute (`.rept`,
# `.space`, `.align`, `.incbin`) are evaluated here, against the constants
# defined earlier in the file. Everything else keeps its expression for the
# layout to evaluate.
#
# Anything outside the dialect is a `ParseError` naming the construct and its
# line: a directive, a prefix, a register, an operator, or a mnemonic, even
# one the encoder knows.
import ritzlib.fs { read_file }
import ritzlib.gvec { Vec, vec_new }
import ritzlib.option { Option }
import ritzlib.ptr { ptr_read }
import ritzlib.result { Result }
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new, string_from }
import razm.expr { BinOp, Expr, ExprNode, Exprs, SymDef, SymTable, Value, eval, exprs_new, first_undefined, symtable_new }
import razm.insn { Insn, Mem, OpSize, Operand, Prefix, Reg, RegClass, insn_new, reg_from_name }

# Macro calls and `.rept` blocks nest at most this deep: a macro that calls
# itself is an error, not a hang.
const MAX_NEST: i64 = 64

# ---------------------------------------------------------------------------
# What a parse produces
# ---------------------------------------------------------------------------

pub struct SectionFlags
    alloc: bool                 # a
    write: bool                 # w
    exec: bool                  # x

pub struct SectionDecl
    name: StrView
    flags: SectionFlags
    nobits: bool                # SHT_NOBITS: `@nobits`, or the name `.bss`

pub enum Mode
    Code16
    Code32
    Code64

# One statement. Statements before the first `.section` are in `.text`, and
# the mode starts at `.code64`.
pub enum Item
    Label(StrView)              # `name:`; a numeric local's unique `.L` name
    Instruction(Insn)
    Section(SectionDecl)
    CodeMode(Mode)
    Global(StrView)
    Extern(StrView)
    TypeFunction(StrView)       # `.type name, @function`
    Size(StrView, Expr)
    Align(i64)                  # bytes, a power of two
    Set(StrView, Expr)          # `.set`, `.equ`, `name = expr`
    Data(i64, Expr)             # width in bytes (1, 2, 4, 8), value
    Bytes(StrView)              # `.ascii` / `.asciz` (decoded), `.incbin` contents
    Space(i64, u8)              # count, fill byte

pub struct Stmt
    line: i64                   # 1-based source line
    item: Item

# Text a parse made: substituted macro lines, numeric local names, decoded
# strings and `.incbin` contents. A Vec frees its buffer, not its elements,
# so the pool drops each String itself. The views it hands out stay valid
# while the pool lives: moving a String into the Vec does not move its bytes.
pub struct TextPool
    texts: Vec<String>

impl Drop for TextPool
    fn drop(self: @&TextPool)
        let base: *String = self.texts.as_ptr()
        let n: i64 = self.texts.len
        self.texts.len = 0
        var i: i64 = 0
        while i < n
            let text: String = ptr_read<String>(base + i)
            i += 1

impl TextPool
    pub fn keep(self: @&TextPool, text: String) -> StrView
        self.texts.push(text)
        let kept: *String = self.texts.get_ptr(self.texts.len - 1)
        kept.as_view()

# A parsed file. Its views point into the source text and into `texts`, so
# the source must outlive it. `syms` holds what the parse could evaluate:
# constants, and labels by section (not yet laid out).
pub struct Program
    stmts: Vec<Stmt>
    exprs: Exprs
    syms: SymTable
    texts: TextPool

pub struct ParseError
    line: i64
    what: String

fn error(line: i64, what: String) -> ParseError
    ParseError { line: line, what: what }

# ---------------------------------------------------------------------------
# The dialect's mnemonics
# ---------------------------------------------------------------------------

# A mnemonic as written, its base and its operand size in bytes (0: none).
# Aliases fold: `jmpq` is `jmp`, `callq` is `call`, `retq` is `ret`.
struct Mnemonic
    spelled: StrView
    base: StrView
    bytes: i64

