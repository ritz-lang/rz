# parse: AT&T text in razm's dialect (DESIGN.md "Text razm accepts") to
# structured instructions and directives.
import ritzlib.strview { StrView }

# The first construct razm does not accept, and its 1-based line.
pub struct Unsupported
    line: i64
    what: StrView

# Parse a whole file. Nothing is accepted yet, so every file stops at line 1.
pub fn parse(text: StrView) -> Result<i64, Unsupported>
    Err(Unsupported { line: 1, what: "the parser is not implemented" })
