# razm --64 -o OUT FILE.s: assemble FILE.s into the relocatable ELF64 OUT.
#
# Exit status: 0 assembled (or --help/-h printed the usage), 1 failed (usage,
# unreadable input, a value that does not lay out or fit), 2 the input holds a
# construct outside razm's dialect or encoder set. stderr names FILE:LINE and
# the construct.
import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.string { String }
import ritzlib.fs { read_file }
import razm.parse { Program, parse }
import razm.assemble { AsmError, assemble, object_error_message }

const EXIT_FAILED: i32 = 1
const EXIT_UNSUPPORTED: i32 = 2
const USAGE: StrView = "Usage: razm --64 -o OUT FILE.s"

fn usage_error(msg: StrView) -> i32
    eprint("razm: {msg}\n{USAGE}\n")
    EXIT_FAILED

pub fn main(args: Span<StrView>) -> i32
    var mode64: bool = false
    var out: StrView = ""
    var input: StrView = ""
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]
        if arg.eq("--help") or arg.eq("-h")
            print("{USAGE}\n")
            return 0
        else if arg.eq("--64")
            mode64 = true
        else if arg.eq("--32")
            return usage_error("--32 is not supported: the object is always ELF64")
        else if arg.eq("-o")
            if i + 1 >= args.len
                return usage_error("-o needs a path")
            i += 1
            out = args[i]
        else if arg.starts_with("-")
            return usage_error("unknown option")
        else if input.len > 0
            return usage_error("more than one input file")
        else
            input = arg
        i += 1

    if not mode64
        return usage_error("--64 is required")
    if out.len == 0
        return usage_error("-o OUT is required")
    if input.len == 0
        return usage_error("no input file")

    let text: String = match read_file(input)
        Ok(bytes) => bytes
        Err(_) =>
            eprint("razm: {input}: cannot read file\n")
            return EXIT_FAILED
    var prog: Program = match parse(text.as_view())
        Ok(p) => p
        Err(e) =>
            let line: i64 = e.line
            eprint("razm: {input}:{line}: {e.what.as_view()}\n")
            return EXIT_UNSUPPORTED
    match assemble(@&prog)
        Ok(obj) =>
            match obj.write(out)
                Ok(_) => 0
                Err(e) =>
                    let why: String = object_error_message(e)
                    eprint("razm: {input}: {out}: {why.as_view()}\n")
                    EXIT_FAILED
        Err(e) =>
            let line: i64 = e.line
            eprint("razm: {input}:{line}: {e.what.as_view()}\n")
            if e.unsupported then EXIT_UNSUPPORTED else EXIT_FAILED
