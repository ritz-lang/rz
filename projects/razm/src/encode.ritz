# encode: a structured instruction to bytes plus fixups, in a .code16,
# .code32 or .code64 mode. DESIGN.md "Library".
#
# The operands' expressions are evaluated against `syms`: a constant is
# absolute, and a label or undefined symbol becomes a fixup against it, which
# the Object resolves or turns into a relocation.
#
# The encoder set is the text dialect plus the encoder-only forms rllvm
# selects (encode_gpr, encode_sse): the parser rejects those mnemonics, and
# rllvm builds their `Insn` directly.
#
# A branch (jmp, jcc) has two forms: `encode` gives the near one (rel16 in
# .code16, else rel32) and `encode_short` the rel8 one, so the assembler can
# start short and grow a branch whose target is out of range. `loop` has
# only the rel8 form, and `call` only the near one.
import ritzlib.option
import ritzlib.result
import ritzlib.strview { StrView }
import razm.expr { Exprs, SymTable, Value }
import razm.fixup { FixupKind }
import razm.insn { Insn, OpSize, Operand }
import razm.parse { Mode }
import razm.emit
import razm.encode_ops
import razm.encode_mov
import razm.encode_gpr
import razm.encode_sse


# `insn` in `mode`, a branch in its near form.
pub fn encode(insn: @Insn, mode: Mode, exprs: @Exprs, syms: @SymTable) -> Result<Encoded, EncodeError>
    let op: Op = op_of(insn.name)?
    var e = emitter(mode)
    e.resolve(insn, exprs, syms)
    e.prefix(insn.prefix)
    lay_out(@&e, insn, op, false)
    e.finish()


# The rel8 form of the branch `insn`: jmp, jcc or loop to a target.
pub fn encode_short(insn: @Insn, mode: Mode, exprs: @Exprs, syms: @SymTable) -> Result<Encoded, EncodeError>
    let op: Op = op_of(insn.name)?
    var e = emitter(mode)
    e.resolve(insn, exprs, syms)
    if not has_short_form(@&e, insn, op)
        return Err(EncodeError.NoShortForm)
    e.prefix(insn.prefix)
    lay_out(@&e, insn, op, true)
    e.finish()


# What an instruction name encodes as. Aliases share one: jc is jb, jnc
# jae, jz je, jnz jne, and likewise for setcc and cmovcc.
enum Op
    Add
    Or
    Adc
    Sbb
    And
    Sub
    Xor
    Cmp
    Test
    Bt
    Mov
    Movabs
    Widen(OpSize, u8)       # a widening move from a source of that size, by 0f op (63: movslq)
    Lea
    Xchg
    Xadd
    Cmpxchg
    Inc
    Dec
    Unary(u8)               # not, neg, mul, div, idiv: f6/f7 /ext
    Imul
    Convert(u8, OpSize)     # cbw/cwde/cdqe (98) and cwd/cdq/cqo (99)
    Shift(u8)               # rol, ror, shl, shr, sar: group 2 /ext
    DoubleShift(u8)         # shld (0f a4), shrd (0f ac)
    Bsf
    Bsr
    Bswap
    Setcc(u8)
    Cmovcc(u8)
    Jcc(u8)
    Vector(Sse)
    X87(u8, u8)             # an x87 load or store: opcode, /ext
    Push
    Pop
    Pushf
    Popf
    Call
    Jmp
    Loop
    Ret
    Lret
    Iret
    Sysret
    Syscall
    Swapgs
    Cli
    Sti
    Cld
    Std
    Hlt
    Nop
    Pause
    Ud2
    Cpuid
    Rdtsc
    Rdmsr
    Wrmsr
    Xgetbv
    Lfence
    Mfence
    Sfence
    Rdrand
    Clflush
    Invlpg
    Lgdt
    Lidt
    Ltr
    In
    Out
    Lods
    Stos


# The base mnemonic `name` (the suffix removed, as parse writes it).
fn op_of(name: StrView) -> Result<Op, EncodeError>
    match name
        "add" => Ok(Op.Add)
        "or" => Ok(Op.Or)
        "adc" => Ok(Op.Adc)
        "sbb" => Ok(Op.Sbb)
        "and" => Ok(Op.And)
        "sub" => Ok(Op.Sub)
        "xor" => Ok(Op.Xor)
        "cmp" => Ok(Op.Cmp)
        "test" => Ok(Op.Test)
        "bt" => Ok(Op.Bt)
        "mov" => Ok(Op.Mov)
        "movabs" => Ok(Op.Movabs)
        "movzb" => Ok(Op.Widen(OpSize.Byte, 0xB6))
        "movzw" => Ok(Op.Widen(OpSize.Word, 0xB7))
        "movsb" => Ok(Op.Widen(OpSize.Byte, 0xBE))
        "movsw" => Ok(Op.Widen(OpSize.Word, 0xBF))
        "movsl" => Ok(Op.Widen(OpSize.Long, 0x63))
        "lea" => Ok(Op.Lea)
        "xchg" => Ok(Op.Xchg)
        "xadd" => Ok(Op.Xadd)
        "cmpxchg" => Ok(Op.Cmpxchg)
        "inc" => Ok(Op.Inc)
        "dec" => Ok(Op.Dec)
        "not" => Ok(Op.Unary(2))
        "neg" => Ok(Op.Unary(3))
        "mul" => Ok(Op.Unary(4))
        "div" => Ok(Op.Unary(6))
        "idiv" => Ok(Op.Unary(7))
        "imul" => Ok(Op.Imul)
        "cbtw" | "cbw" => Ok(Op.Convert(0x98, OpSize.Word))
        "cwtl" | "cwde" => Ok(Op.Convert(0x98, OpSize.Long))
        "cltq" | "cdqe" => Ok(Op.Convert(0x98, OpSize.Quad))
        "cwtd" | "cwd" => Ok(Op.Convert(0x99, OpSize.Word))
        "cltd" | "cdq" => Ok(Op.Convert(0x99, OpSize.Long))
        "cqto" | "cqo" => Ok(Op.Convert(0x99, OpSize.Quad))
        "rol" => Ok(Op.Shift(0))
        "ror" => Ok(Op.Shift(1))
        "shl" => Ok(Op.Shift(4))
        "shr" => Ok(Op.Shift(5))
        "sar" => Ok(Op.Shift(7))
        "shld" => Ok(Op.DoubleShift(0xA4))
        "shrd" => Ok(Op.DoubleShift(0xAC))
        "bsf" => Ok(Op.Bsf)
        "bsr" => Ok(Op.Bsr)
        "bswap" => Ok(Op.Bswap)
        "flds" => Ok(Op.X87(0xD9, 0))
        "fldl" => Ok(Op.X87(0xDD, 0))
        "fstps" => Ok(Op.X87(0xD9, 3))
        "fstpl" => Ok(Op.X87(0xDD, 3))
        "push" => Ok(Op.Push)
        "pop" => Ok(Op.Pop)
        "pushf" => Ok(Op.Pushf)
        "popf" => Ok(Op.Popf)
        "call" => Ok(Op.Call)
        "jmp" => Ok(Op.Jmp)
        "loop" => Ok(Op.Loop)
        "ret" => Ok(Op.Ret)
        "lret" => Ok(Op.Lret)
        "iret" => Ok(Op.Iret)
        "sysret" => Ok(Op.Sysret)
        "syscall" => Ok(Op.Syscall)
        "swapgs" => Ok(Op.Swapgs)
        "cli" => Ok(Op.Cli)
        "sti" => Ok(Op.Sti)
        "cld" => Ok(Op.Cld)
        "std" => Ok(Op.Std)
        "hlt" => Ok(Op.Hlt)
        "nop" => Ok(Op.Nop)
        "pause" => Ok(Op.Pause)
        "ud2" => Ok(Op.Ud2)
        "cpuid" => Ok(Op.Cpuid)
        "rdtsc" => Ok(Op.Rdtsc)
        "rdmsr" => Ok(Op.Rdmsr)
        "wrmsr" => Ok(Op.Wrmsr)
        "xgetbv" => Ok(Op.Xgetbv)
        "lfence" => Ok(Op.Lfence)
        "mfence" => Ok(Op.Mfence)
        "sfence" => Ok(Op.Sfence)
        "rdrand" => Ok(Op.Rdrand)
        "clflush" => Ok(Op.Clflush)
        "invlpg" => Ok(Op.Invlpg)
        "lgdt" => Ok(Op.Lgdt)
        "lidt" => Ok(Op.Lidt)
        "ltr" => Ok(Op.Ltr)
        "in" => Ok(Op.In)
        "out" => Ok(Op.Out)
        "lods" => Ok(Op.Lods)
        "stos" => Ok(Op.Stos)
        _ => conditional_or_vector(name)


# jcc, setcc, cmovcc on a condition, or an SSE form.
fn conditional_or_vector(name: StrView) -> Result<Op, EncodeError>
    match condition_after(name, "j")
        Some(cc) => return Ok(Op.Jcc(cc))
        None => pass
    match condition_after(name, "set")
        Some(cc) => return Ok(Op.Setcc(cc))
        None => pass
    match condition_after(name, "cmov")
        Some(cc) => return Ok(Op.Cmovcc(cc))
        None => pass
    match vector_of(name)
        Some(s) => Ok(Op.Vector(s))
        None => Err(EncodeError.UnknownMnemonic)


# The condition `name` names after `head` (`jge`, `setnz`), if it does.
fn condition_after(name: StrView, head: StrView) -> Option<u8>
    if not name.starts_with(head)
        return None
    condition_of(name.skip(head.len))


fn has_short_form(e: @&Emitter, insn: @Insn, op: Op) -> bool
    let direct: bool = insn.n_ops == 1 and target_of(e, insn.ops[0]).is_some()
    match op
        Jmp | Loop => direct
        Jcc(_) => direct
        _ => false


fn lay_out(e: @&Emitter, insn: @Insn, op: Op, short: bool)
    match op
        Add => alu(e, insn, 0)
        Or => alu(e, insn, 1)
        Adc => alu(e, insn, 2)
        Sbb => alu(e, insn, 3)
        And => alu(e, insn, 4)
        Sub => alu(e, insn, 5)
        Xor => alu(e, insn, 6)
        Cmp => alu(e, insn, 7)
        Test => test(e, insn)
        Bt => bt(e, insn)
        Mov =>
            if has_xmm(insn)
                mov_xmm(e, insn)
            else
                mov(e, insn)
        Movabs => movabs(e, insn)
        Widen(from, code) => widen(e, insn, from, code)
        Lea => lea(e, insn)
        Xchg => xchg(e, insn)
        Xadd => exchange(e, insn, 0xC0)
        Cmpxchg => exchange(e, insn, 0xB0)
        Inc => inc_dec(e, insn, 0)
        Dec => inc_dec(e, insn, 1)
        Unary(ext) => unary(e, insn, ext)
        Imul => imul(e, insn)
        Convert(code, size) => convert(e, insn, code, size)
        Shift(ext) => shift(e, insn, ext)
        DoubleShift(code) => double_shift(e, insn, code)
        Bsf => load_wide(e, insn, 0xBC)
        Bsr => load_wide(e, insn, 0xBD)
        Bswap => bswap(e, insn)
        Setcc(cc) => setcc(e, insn, cc)
        Cmovcc(cc) => load_wide(e, insn, 0x40 + cc)
        Jcc(cc) => jcc(e, insn, cc, short)
        Vector(s) => vector(e, insn, s)
        X87(code, ext) => x87(e, insn, code, ext)
        Push => push(e, insn)
        Pop => pop(e, insn)
        Pushf => flags(e, insn, 0x9C)
        Popf => flags(e, insn, 0x9D)
        Call => call_or_jump(e, insn, 0xE8, 2, short)
        Jmp => call_or_jump(e, insn, 0xE9, 4, short)
        Loop => rel8(e, insn, 0xE2)
        Ret => ret(e, insn)
        Lret => only(e, insn, true, 0xCB)
        Iret => only(e, insn, true, 0xCF)
        Sysret => sysret(e, insn)
        Syscall => fixed2(e, insn, 0x0F, 0x05)
        Swapgs => swapgs(e, insn)
        Cli => only(e, insn, false, 0xFA)
        Sti => only(e, insn, false, 0xFB)
        Cld => only(e, insn, false, 0xFC)
        Std => only(e, insn, false, 0xFD)
        Hlt => only(e, insn, false, 0xF4)
        Nop => nop(e, insn)
        Pause => fixed2(e, insn, 0xF3, 0x90)
        Ud2 => fixed2(e, insn, 0x0F, 0x0B)
        Cpuid => fixed2(e, insn, 0x0F, 0xA2)
        Rdtsc => fixed2(e, insn, 0x0F, 0x31)
        Rdmsr => fixed2(e, insn, 0x0F, 0x32)
        Wrmsr => fixed2(e, insn, 0x0F, 0x30)
        Xgetbv => fixed3(e, insn, 0xD0)
        Lfence => fixed3_ae(e, insn, 0xE8)
        Mfence => fixed3_ae(e, insn, 0xF0)
        Sfence => fixed3_ae(e, insn, 0xF8)
        Rdrand => rdrand(e, insn)
        Clflush => system_mem(e, insn, 0xAE, 7)
        Invlpg => system_mem(e, insn, 0x01, 7)
        Lgdt => system_mem(e, insn, 0x01, 2)
        Lidt => system_mem(e, insn, 0x01, 3)
        Ltr => ltr(e, insn)
        In => port_io(e, insn, 0xE4, 0xEC, 1)
        Out => port_io(e, insn, 0xE6, 0xEE, 0)
        Lods => string_op(e, insn, 0xAC)
        Stos => string_op(e, insn, 0xAA)


# The target of a direct branch: a bare expression, which reaches encode as
# an absolute memory operand.
fn target_of(e: @&Emitter, o: Operand) -> Option<Value>
    match o
        Operand.Memory(m) =>
            if m.base.is_some() or m.index.is_some() or m.seg.is_some()
                return None
            match m.disp
                Some(x) => Some(e.value(x))
                None => None
        _ => None


# A suffix on a branch or ret names the mode's own size, or it is an error.
fn natural_suffix(e: @&Emitter, insn: @Insn)
    if not size_is(insn.size, OpSize.Unsized) and not size_is(insn.size, default_size(e.mode))
        e.fail(EncodeError.NotInMode)


# The near displacement: rel16 in .code16, else rel32; through the PLT in
# 64-bit mode, as `as` writes a branch to a global, undefined or
# other-section symbol (the Object resolves a same-section local itself).
fn near(e: @&Emitter, target: Value)
    let width: i64 = if e.mode_is(Mode.Code16) then 2 else 4
    let kind: FixupKind = if e.is64() then FixupKind.Plt else FixupKind.PcRelative
    e.relative(target, width, kind)


# call (e8 rel, ff /2) and jmp (e9 rel or eb rel8, ff /4).
fn call_or_jump(e: @&Emitter, insn: @Insn, near_op: u8, ext: u8, short: bool)
    operands(e, insn, 1)
    natural_suffix(e, insn)
    match insn.ops[0]
        Operand.Indirect(r) =>
            if not size_is(gpr_size(r), default_size(e.mode))
                e.fail(EncodeError.SizeMismatch)
            e.opcode(0xFF)
            e.ext(ext)
            e.rm_reg(r)
        o =>
            match target_of(e, o)
                Some(t) =>
                    if short
                        e.opcode(0xEB)
                        e.relative(t, 1, FixupKind.PcRelative)
                    else
                        e.opcode(near_op)
                        near(e, t)
                None => e.fail(EncodeError.BadOperands)


# jcc on condition code `cc`: 0f 80+cc rel, or 70+cc rel8.
fn jcc(e: @&Emitter, insn: @Insn, cc: u8, short: bool)
    operands(e, insn, 1)
    natural_suffix(e, insn)
    match target_of(e, insn.ops[0])
        Some(t) =>
            if short
                e.opcode(0x70 + cc)
                e.relative(t, 1, FixupKind.PcRelative)
            else
                e.opcode2(0x0F, 0x80 + cc)
                near(e, t)
        None => e.fail(EncodeError.BadOperands)


# A branch with only a rel8 form (loop).
fn rel8(e: @&Emitter, insn: @Insn, op: u8)
    operands(e, insn, 1)
    match target_of(e, insn.ops[0])
        Some(t) =>
            e.opcode(op)
            e.relative(t, 1, FixupKind.PcRelative)
        None => e.fail(EncodeError.BadOperands)


fn ret(e: @&Emitter, insn: @Insn)
    operands(e, insn, 0)
    natural_suffix(e, insn)
    e.opcode(0xC3)


# A one-byte instruction with no operands; `sized` lets a suffix pick the
# operand size (lretq, iretq).
fn only(e: @&Emitter, insn: @Insn, sized: bool, op: u8)
    if sized
        sized_operandless(e, insn)
    else
        operands(e, insn, 0)
    e.opcode(op)


fn fixed2(e: @&Emitter, insn: @Insn, a: u8, b: u8)
    operands(e, insn, 0)
    e.opcode2(a, b)


# 0f 01 `c`.
fn fixed3(e: @&Emitter, insn: @Insn, c: u8)
    operands(e, insn, 0)
    e.opcode3(0x0F, 0x01, c)


# 0f ae `c`: the fences.
fn fixed3_ae(e: @&Emitter, insn: @Insn, c: u8)
    operands(e, insn, 0)
    e.opcode3(0x0F, 0xAE, c)


fn sysret(e: @&Emitter, insn: @Insn)
    sized_operandless(e, insn)
    if not e.is64()
        e.fail(EncodeError.NotInMode)
    e.opcode2(0x0F, 0x07)


fn swapgs(e: @&Emitter, insn: @Insn)
    if not e.is64()
        e.fail(EncodeError.NotInMode)
    fixed3(e, insn, 0xF8)
