# insn: the structured instruction parse produces and encode consumes
# (DESIGN.md "Library"). rllvm builds the same values directly.
#
# An instruction is a base mnemonic, an operand size, an optional prefix and
# up to three operands. Every type here is a copy type: an operand's numbers
# are `Expr` handles into the `Exprs` arena that owns them.
import ritzlib.option { Option }
import ritzlib.strview { StrView }
import razm.expr { Expr }

pub enum RegClass
    Gpr8                        # al cl dl bl spl bpl sil dil r8b..r15b (num 0..15)
    Gpr8High                    # ah ch dh bh (num 4..7, encodable only without REX)
    Gpr16
    Gpr32
    Gpr64
    Control                     # %cr0 %cr2 %cr3 %cr4 (num 0, 2, 3, 4)
    Segment                     # %es %cs %ss %ds %fs %gs (num 0..5, the sreg field)
    Rip                         # %rip, only as a memory base
    Xmm                         # %xmm0..%xmm15: encoder-only, outside the text dialect

# A register: its class and its hardware number.
pub struct Reg
    class: RegClass
    num: u8

const GPR64: [16]StrView = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi",
                            "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
const GPR32: [16]StrView = ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi",
                            "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"]
const GPR16: [16]StrView = ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di",
                            "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w"]
const GPR8: [16]StrView = ["al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil",
                           "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"]
const GPR8_HIGH: [4]StrView = ["ah", "ch", "dh", "bh"]
const SEGMENT: [6]StrView = ["es", "cs", "ss", "ds", "fs", "gs"]
const CONTROL: [4]StrView = ["cr0", "cr2", "cr3", "cr4"]
const XMM: [16]StrView = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
                          "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]
const CONTROL_NUM: [4]u8 = [0, 2, 3, 4]

fn reg(class: RegClass, num: i64) -> Option<Reg>
    Some(Reg { class: class, num: num as u8 })

# The register a name (without its `%`) spells, in razm's dialect.
pub fn reg_from_name(name: StrView) -> Option<Reg>
    for i in 0..16
        if GPR64[i].eq(name)
            return reg(RegClass.Gpr64, i)
        if GPR32[i].eq(name)
            return reg(RegClass.Gpr32, i)
        if GPR16[i].eq(name)
            return reg(RegClass.Gpr16, i)
        if GPR8[i].eq(name)
            return reg(RegClass.Gpr8, i)
    for i in 0..4
        if GPR8_HIGH[i].eq(name)
            return reg(RegClass.Gpr8High, i + 4)
        if CONTROL[i].eq(name)
            return reg(RegClass.Control, CONTROL_NUM[i] as i64)
    for i in 0..6
        if SEGMENT[i].eq(name)
            return reg(RegClass.Segment, i)
    if name.eq("rip")
        return reg(RegClass.Rip, 0)
    None

# The register a name (without its `%`) spells in the encoder set, which is
# the dialect's registers plus %xmm0..%xmm15. rllvm and the encode tests name
# registers this way; the text parser keeps to `reg_from_name`.
pub fn reg_from_encoder_name(name: StrView) -> Option<Reg>
    for i in 0..16
        if XMM[i].eq(name)
            return reg(RegClass.Xmm, i)
    reg_from_name(name)

# The operand size an instruction's suffix (or its rllvm builder) chose.
pub enum OpSize
    Unsized                     # no suffix: the operands or the mode decide
    Byte                        # b
    Word                        # w
    Long                        # l
    Quad                        # q

pub enum Prefix
    NoPrefix
    Lock
    Rep

# An AT&T memory operand, `seg:disp(base, index, scale)`, any part omitted.
# A `sym(%rip)` operand has base class Rip. An absolute memory operand
# (`lgdt gdt64_ptr`) has only `disp`, and so does a branch's direct target
# (`call main`, `jz 8f`): AT&T writes both the same way, and the mnemonic
# tells them apart.
pub struct Mem
    seg: Option<Reg>
    disp: Option<Expr>
    base: Option<Reg>
    index: Option<Reg>
    scale: u8                   # 1, 2, 4 or 8; 1 when there is no index

pub enum Operand
    Register(Reg)
    Imm(Expr)                   # `$expr`
    Memory(Mem)
    Indirect(Reg)               # `*%reg`, an indirect jmp/call target

pub const MAX_OPERANDS: i64 = 3

# One instruction. `name` is the base mnemonic with the size suffix removed
# and aliases folded (`movq` is `mov` + Quad; `jmpq` is `jmp`, `retq` is
# `ret`). Operands are in AT&T order, source first; `ops[0..n_ops]` are set.
# A fixed array keeps Insn a copy type: no dialect form has more than three.
pub struct Insn
    prefix: Prefix
    name: StrView
    size: OpSize
    ops: [3]Operand
    n_ops: i64

impl Insn
    pub fn operand(self: @Insn, i: i64) -> Option<Operand>
        if i < 0 or i >= self.n_ops
            return None
        Some(self.ops[i])

pub fn insn_new(prefix: Prefix, name: StrView, size: OpSize) -> Insn
    let none: Operand = Operand.Imm(Expr { id: -1 })
    Insn { prefix: prefix, name: name, size: size, ops: [none, none, none], n_ops: 0 }

impl Insn
    # Append an operand; false when the instruction already has three.
    pub fn push(self: @&Insn, op: Operand) -> bool
        if self.n_ops >= MAX_OPERANDS
            return false
        self.ops[self.n_ops] = op
        self.n_ops += 1
        true
