# Fixup: a field of an encoded instruction or datum that the Object resolves
# or turns into a relocation. DESIGN.md "Library".
import ritzlib.strview { StrView }


# How a fixup's field is computed from its target.
pub enum FixupKind
    Absolute          # S + A, zero-extended to the field
    AbsoluteSigned    # S + A, sign-extended from the field (R_X86_64_32S)
    PcRelative        # S + A - P
    Plt               # L + A - P, through the PLT when the target needs one
    GotPcRelx         # G + GOT + A - P, relaxable by the linker


# One field to resolve: `width` bytes at `offset` from the instruction's (or
# datum's) first byte hold `kind` of `target` plus `addend`.
pub struct Fixup
    offset: i64
    width: i64
    kind: FixupKind
    target: StrView
    addend: i64
