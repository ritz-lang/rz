# ritz-stats: Source code analytics for Ritz
#
# Provides metrics similar to cloc/sloccount but tailored for Ritz:
# - Lines of code (total, source, comments, blank)
# - Function count, struct/enum count
# - Cyclomatic complexity metrics

import ritzlib.sys
import ritzlib.io
import ritzlib.strview { StrView }
import ritzlib.span { Span }
import ritzlib.fd { Fd, fd_open, O_RDONLY }

# Statistics accumulator
struct Stats
    file_count: i32
    total_lines: i32
    blank_lines: i32
    comment_lines: i32
    code_lines: i32
    function_count: i32
    struct_count: i32
    enum_count: i32
    max_complexity: i32
    total_complexity: i32
    total_fn_lines: i32
    max_nesting: i32

# `line` without its leading spaces.  Its indent level is the number of
# spaces skipped over 4 (4 spaces = 1 indent level).
fn skip_spaces(line: StrView) -> StrView
    var i: i64 = 0
    while i < line.len and *(line.ptr + i) == ' '
        i += 1
    line.slice(i, line.len)

# Complexity contribution of one line, given without its leading spaces.
fn line_complexity(body: StrView) -> i32
    var cc: i32 = 0

    if body.starts_with("if ")
        cc = cc + 1
    if body.starts_with("else if ")
        cc = cc + 1
    if body.starts_with("while ")
        cc = cc + 1
    if body.starts_with("for ")
        cc = cc + 1
    if body.starts_with("loop")
        cc = cc + 1
    if body.contains(" => ")
        cc = cc + 1
    if body.contains(" and ")
        cc = cc + 1
    if body.contains(" or ")
        cc = cc + 1

    cc

# Analyze a file
fn analyze_file(path: StrView, stats: *Stats) -> i32
    var f: Fd = match fd_open(path, O_RDONLY, 0)
        Ok(opened) => opened
        Err(_) => return -1

    # Read file into buffer (max 1MB): one read, as before
    var buf: [1048576]u8
    var n: i64 = -1
    match f.read(Span<u8> { ptr: @buf as *u8, len: 1048576 })
        Ok(k) => n = k
        Err(_) => pass
    f.close()

    if n <= 0
        return -1

    var line_start: i32 = 0
    var i: i32 = 0

    var in_fn: i32 = 0
    var fn_indent: i32 = 0
    var fn_lines: i32 = 0
    var fn_cc: i32 = 1
    var fn_max_indent: i32 = 0

    while i < n as i32
        if buf[i] == '\n' or i == n as i32 - 1
            let line = StrView { ptr: @buf[line_start], len: (i - line_start) as i64 }
            let body: StrView = skip_spaces(line)
            let indent: i32 = ((line.len - body.len) / 4) as i32

            if body.len == 0
                stats.blank_lines = stats.blank_lines + 1
            else if body.starts_with("#")
                stats.comment_lines = stats.comment_lines + 1
            else
                stats.code_lines = stats.code_lines + 1

                # Check for function start (fn or pub fn)
                if body.starts_with("fn ") or body.starts_with("pub fn ")
                    # Close previous function
                    if in_fn == 1
                        stats.function_count = stats.function_count + 1
                        stats.total_fn_lines = stats.total_fn_lines + fn_lines
                        stats.total_complexity = stats.total_complexity + fn_cc
                        if fn_cc > stats.max_complexity
                            stats.max_complexity = fn_cc
                        if fn_max_indent > stats.max_nesting
                            stats.max_nesting = fn_max_indent

                    in_fn = 1
                    fn_indent = indent
                    fn_lines = 0
                    fn_cc = 1
                    fn_max_indent = 0

                else if in_fn == 1
                    if indent > fn_indent
                        fn_lines = fn_lines + 1
                        fn_cc = fn_cc + line_complexity(body)
                        if indent > fn_max_indent
                            fn_max_indent = indent
                    else
                        # Dedented - end of function
                        stats.function_count = stats.function_count + 1
                        stats.total_fn_lines = stats.total_fn_lines + fn_lines
                        stats.total_complexity = stats.total_complexity + fn_cc
                        if fn_cc > stats.max_complexity
                            stats.max_complexity = fn_cc
                        if fn_max_indent > stats.max_nesting
                            stats.max_nesting = fn_max_indent
                        in_fn = 0

                # Check for struct/enum
                if body.starts_with("struct ")
                    stats.struct_count = stats.struct_count + 1
                else if body.starts_with("enum ")
                    stats.enum_count = stats.enum_count + 1

            stats.total_lines = stats.total_lines + 1
            line_start = i + 1

        i = i + 1

    # Close final function
    if in_fn == 1
        stats.function_count = stats.function_count + 1
        stats.total_fn_lines = stats.total_fn_lines + fn_lines
        stats.total_complexity = stats.total_complexity + fn_cc
        if fn_cc > stats.max_complexity
            stats.max_complexity = fn_cc
        if fn_max_indent > stats.max_nesting
            stats.max_nesting = fn_max_indent

    stats.file_count = stats.file_count + 1
    0

fn print_bar(n: i32)
    var i: i32 = 0
    while i < n
        prints("-")
        i = i + 1
    prints("\n")

# `part` as a whole percentage of `total`; 0 when there is no total.
fn pct(part: i32, total: i32) -> i32
    per(part * 100, total)

# `sum / count`, truncated; 0 when there is nothing to average.
fn per(sum: i32, count: i32) -> i32
    if count > 0
        return sum / count
    0

fn print_summary(stats: *Stats)
    prints("============================================================\n")
    prints("                    RITZ SOURCE STATISTICS\n")
    prints("============================================================\n\n")

    prints("LINES OF CODE\n")
    print_bar(40)

    print("  Total lines:      {stats.total_lines}\n")
    print("  Code lines:       {stats.code_lines} ({pct(stats.code_lines, stats.total_lines)}%)\n")
    print("  Comment lines:    {stats.comment_lines} ({pct(stats.comment_lines, stats.total_lines)}%)\n")
    print("  Blank lines:      {stats.blank_lines} ({pct(stats.blank_lines, stats.total_lines)}%)\n")

    prints("\nDEFINITIONS\n")
    print_bar(40)

    print("  Functions:        {stats.function_count}\n")
    print("  Structs:          {stats.struct_count}\n")
    print("  Enums:            {stats.enum_count}\n")
    print("  Files:            {stats.file_count}\n")

    prints("\nCOMPLEXITY\n")
    print_bar(40)

    print("  Avg fn length:    {per(stats.total_fn_lines, stats.function_count)} lines\n")
    print("  Avg complexity:   {per(stats.total_complexity, stats.function_count)}\n")
    print("  Max complexity:   {stats.max_complexity}\n")
    print("  Max nesting:      {stats.max_nesting} levels\n\n")

pub fn main(args: Span<StrView>) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if args.len > 1
        let arg1: StrView = *(args.ptr + 1)
        if arg1.eq("-h") or arg1.eq("--help")
            prints("Usage: ritz-stats <file.ritz>\n")
            prints("  Prints line, function and complexity statistics for one Ritz source file.\n")
            return 0
    if args.len < 2
        prints("Usage: ritz-stats <file.ritz>\n")
        return 1

    var stats: Stats
    stats.file_count = 0
    stats.total_lines = 0
    stats.blank_lines = 0
    stats.comment_lines = 0
    stats.code_lines = 0
    stats.function_count = 0
    stats.struct_count = 0
    stats.enum_count = 0
    stats.max_complexity = 0
    stats.total_complexity = 0
    stats.total_fn_lines = 0
    stats.max_nesting = 0

    let path: StrView = *(args.ptr + 1)
    let result = analyze_file(path, @stats)

    if result < 0
        prints("Error reading file\n")
        return 1

    print_summary(@stats)
    0
