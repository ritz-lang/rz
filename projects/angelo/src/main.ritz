# Angelo - Font Loading and Rendering Library
#
# Main entry point and public API.
#
# Users import submodules directly:
#   import angelo.font
#   import angelo.shaper
#   import angelo.raster

# Core types
pub import types

# Loader module (TTF/OTF parsing)
pub import loader.loader

# High-level Font API
pub import font

# Text shaper
pub import shaper.shaper

# Rasterizer
pub import raster.raster

# Glyph cache
pub import cache

# Font discovery
pub import discovery

# Hinting (TrueType bytecode interpreter)
pub import hinting.hinting

# Tests
import tests

import ritzlib.str { streq }
import ritzlib.io { prints }

# Main function for testing
pub fn main(argc: i32, argv: **u8) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if argc > 1
        let arg1: *u8 = *(argv + 1)
        if streq(arg1, c"-h") != 0 or streq(arg1, c"--help") != 0
            prints("Usage: angelo-test\n")
            prints("  Placeholder entry point for the angelo font library; does nothing.\n")
            prints("  The library's tests run with: ./rz test angelo\n")
            return 0
    # For now, just a placeholder
    # Real tests are in the test functions
    0
