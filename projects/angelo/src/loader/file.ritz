# Angelo - File I/O
#
# File loading utilities for reading font files.
# Uses ritzlib's filesystem primitives.

import ritzlib.fd { Fd, fd_open, O_RDONLY }
import ritzlib.span { Span }
import ritzlib.gvec
import ritzlib.strview

# Read an entire file into a Vec<u8>
pub fn read_file_bytes(path: StrView) -> Result<Vec<u8>, StrView>
    var f: Fd = match fd_open(path, O_RDONLY, 0)
        Ok(opened) => opened
        Err(_) => return Err("failed to open file")

    # Get file size
    var file_size: i64 = 0
    match f.stat()
        Ok(st) => file_size = st.st_size
        Err(_) =>
            f.close()
            return Err("failed to stat file")

    if file_size <= 0
        f.close()
        return Err("invalid file size")

    # Allocate buffer
    var data = vec_with_cap<u8>(file_size as usize)

    # Read in chunks
    var total_read: i64 = 0
    var buf: [8192]u8

    while total_read < file_size
        let remaining = file_size - total_read
        let to_read = if remaining > 8192
            8192
        else
            remaining

        var n: i64 = 0
        match f.read(Span<u8> { ptr: @&buf[0], len: to_read })
            Ok(k) => n = k
            Err(_) =>
                f.close()
                return Err("failed to read file")
        if n == 0
            break

        # Append to vector
        for i in 0..n as usize
            data.push(buf[i])

        total_read = total_read + n

    f.close()
    Ok(data)

# Tests

[[test]]
fn test_read_nonexistent_file() -> i32
    let result = read_file_bytes("nonexistent_file_12345.ttf")
    assert result.is_err()
    0
