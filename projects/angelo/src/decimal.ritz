# Angelo - decimal numbers as ASCII (PGM headers)
#
# The digits come from ritzlib.fmt (AGAST #4118), not a `% 10` loop of our
# own. Its own module so the [[test]] can sit beside it: a module with
# `main` (simple_test.ritz) can't hold one.

import ritzlib.gvec
import ritzlib.fmt.digits { fmt_u64_into }

# Append n to out as ASCII decimal digits.
pub fn append_decimal(out:& Vec<u8>, n: u32)
    var digits: [20]u8
    let len: i64 = fmt_u64_into(@digits[0], n as u64)
    for i in 0..len
        out.push(digits[i])

# u32's extremes and 0 (AGAST #4118).
[[test]]
fn test_append_decimal_extremes() -> i32
    var out = vec_new<u8>()
    append_decimal(@&out, 0)
    out.push(32 as u8)
    append_decimal(@&out, 4294967295)
    let want = "0 4294967295"
    assert vec_len<u8>(@out) == want.len
    for i in 0..want.len
        assert vec_get<u8>(@out, i) == *(want.ptr + i)
    0
