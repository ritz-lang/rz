# test/test_simple.ritz - Simple verification tests
#
# Verifies the Ritz compiler works correctly.

import ritzlib.sys
import ritzlib.strview { StrView }


[[test]]
fn test_arithmetic() -> i32
    if 2 + 2 != 4
        return 1
    0


[[test]]
fn test_comparison() -> i32
    let x: i32 = 42
    if x < 40
        return 1
    if x > 50
        return 1
    0


[[test]]
fn test_string_literal() -> i32
    let msg: StrView = "hello"
    if msg.len() != 5 or msg.get(0) != 'h'
        return 1
    0
