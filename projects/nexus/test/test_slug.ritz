# test/test_slug.ritz - slug extraction and validation (AGAST #1870)
#
# extract_slug used to accept any byte except '/', and GET /wiki/:slug and
# /wiki/:slug/edit never validated it, so a slug of `"><script>` reached an
# href unescaped.  Every route now rejects slugs outside the one slug rule
# (AGAST #2209): 1-128 bytes of '/'-separated [a-z0-9-] segments.

import ritzlib.str { strlen }

import slug { extract_slug, slug_valid, slug_from_path }
import slug { slug_check, SLUG_OK, SLUG_BAD_CHAR, SLUG_EMPTY_SEGMENT, SLUG_RESERVED }


fn valid(s: *u8) -> i32
    return slug_valid(s, strlen(s) as i32)


[[test]]
fn test_validate_slug_accepts_lower_digits_hyphen() -> i32
    if valid(c"hello-world-42") != 1
        return 1
    if valid(c"a") != 1
        return 2
    0


[[test]]
fn test_validate_slug_rejects_html_specials() -> i32
    if valid(c"a\"b") != 0
        return 1
    if valid(c"<script>") != 0
        return 2
    if valid(c"x>y") != 0
        return 3
    if valid(c"a&b") != 0
        return 4
    if valid(c"it's") != 0
        return 5
    0


[[test]]
fn test_validate_slug_rejects_other_bytes() -> i32
    if valid(c"Upper") != 0
        return 1
    if valid(c"..") != 0
        return 2
    if valid(c"a b") != 0
        return 3
    if valid(c"a%22b") != 0
        return 4
    if slug_valid(c"x", 0) != 0
        return 5
    0


[[test]]
fn test_validate_slug_length_cap() -> i32
    var buf: [129]u8
    for i in 0..129
        buf[i] = 'a'
    if slug_valid(@buf[0], 128) != 1
        return 1
    if slug_valid(@buf[0], 129) != 0
        return 2
    0


[[test]]
fn test_extract_slug_takes_the_whole_rest_of_the_path() -> i32
    var out: [128]u8
    let p = c"/wiki/foo/bar"
    let n = extract_slug(p, strlen(p) as i32, @out[0], 128)
    if n != 7
        return 1
    if out[0] != 'f' or out[3] != '/' or out[6] != 'r'
        return 2
    0


# The route-level helper: extract, then validate.  A hostile slug in the
# path is refused (returns -1) rather than handed to a renderer.
[[test]]
fn test_slug_from_path_rejects_hostile_slug() -> i32
    var out: [128]u8
    let bad = c"/wiki/\"><script>"
    if slug_from_path(bad, strlen(bad) as i32, @out[0]) != -1
        return 1
    let good = c"/wiki/home/edit"
    if slug_from_path(good, strlen(good) as i32, @out[0]) != 4
        return 2
    let empty = c"/wiki/"
    if slug_from_path(empty, strlen(empty) as i32, @out[0]) != -1
        return 3
    let nested = c"/wiki/language/syntax/edit"
    if slug_from_path(nested, strlen(nested) as i32, @out[0]) != 15
        return 4
    if out[8] != '/'
        return 5
    let up = c"/wiki/../etc"
    if slug_from_path(up, strlen(up) as i32, @out[0]) != -1
        return 6
    0


# An over-long slug is rejected, not silently truncated to a different page.
[[test]]
fn test_slug_from_path_rejects_overlong() -> i32
    var path: [140]u8
    path[0] = '/'
    path[1] = 'w'
    path[2] = 'i'
    path[3] = 'k'
    path[4] = 'i'
    path[5] = '/'
    for i in 6..140
        path[i] = 'a'
    var out: [128]u8
    if slug_from_path(@path[0], 140, @out[0]) != -1
        return 1
    if slug_from_path(@path[0], 134, @out[0]) != 128
        return 2
    0


# ============================================================================
# The one slug rule (AGAST #2209): the routes (slug_valid) and the wiki
# service (services/validation) both call slug_check.
# ============================================================================

fn check(s: *u8) -> i32
    return slug_check(s, strlen(s) as i32)


[[test]]
fn test_slug_allows_hierarchy() -> i32
    if valid(c"language/syntax") != 1
        return 1
    if valid(c"stdlib/io/file") != 1
        return 2
    if valid(c"2026-roadmap") != 1
        return 3
    0


[[test]]
fn test_slug_refuses_empty_segments() -> i32
    if check(c"/lead") != SLUG_EMPTY_SEGMENT
        return 1
    if check(c"trail/") != SLUG_EMPTY_SEGMENT
        return 2
    if check(c"a//b") != SLUG_EMPTY_SEGMENT
        return 3
    if check(c"/") != SLUG_EMPTY_SEGMENT
        return 4
    0


[[test]]
fn test_slug_refuses_upper_case() -> i32
    # One page per name: /wiki/Home and /wiki/home are not two pages.
    if check(c"Home") != SLUG_BAD_CHAR
        return 1
    if check(c"language/Syntax") != SLUG_BAD_CHAR
        return 2
    0


[[test]]
fn test_slug_reserves_route_words() -> i32
    # /wiki/new is the create form, and /wiki/<slug>/edit the edit form, so
    # neither can be a page's own name.
    if check(c"new") != SLUG_RESERVED
        return 1
    if check(c"a/edit") != SLUG_RESERVED
        return 2
    if check(c"edit") != SLUG_OK
        return 3
    if check(c"news") != SLUG_OK
        return 4
    if check(c"a/editor") != SLUG_OK
        return 5
    if check(c"a/new") != SLUG_OK
        return 6
    0
