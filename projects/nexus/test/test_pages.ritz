# test/test_pages.ritz - HTML page renderers (AGAST #1870)
#
# The renderers build into a growable String.  Before #1870 they wrote into
# fixed [16384]u8 / [8192]u8 / [4096]u8 stack buffers with no bounds checks,
# and a stored page of 8192 `"` (escaped to 6 bytes each) overflowed by ~33 KB.

import ritzlib.strview { StrView }
import ritzlib.string { String, string_new, string_drop, string_len, string_contains, string_as_ptr }
import ritzlib.str { strneq }

import pages { render_view_page, render_titled_view_page, render_edit_page, render_index_page, render_not_found_page, render_error_page, push_headers }


# A page body of `n` copies of `"`, in a caller buffer of 8192 bytes.
fn fill_quotes(buf: *u8, n: i32)
    for i in 0..n
        *(buf + i) = '"'


fn view_len(content: *u8, content_len: i32) -> i64
    var s: String = string_new()
    render_view_page(@s, c"page", 4, content, content_len)
    let n: i64 = string_len(@s)
    string_drop(@s)
    return n


fn edit_len(content: *u8, content_len: i32) -> i64
    var s: String = string_new()
    render_edit_page(@s, c"page", 4, content, content_len)
    let n: i64 = string_len(@s)
    string_drop(@s)
    return n


# Every content byte must land in the output: 8192 `"` grow the view page by
# exactly 8192 * 6 bytes over the same page with empty content.
[[test]]
fn test_view_page_holds_max_escaped_content() -> i32
    var content: [8192]u8
    fill_quotes(@content[0], 8192)
    let empty: i64 = view_len(@content[0], 0)
    let full: i64 = view_len(@content[0], 8192)
    if full - empty != 49152
        return 1
    if full <= 16384
        return 2
    0


[[test]]
fn test_edit_page_holds_max_escaped_content() -> i32
    var content: [8192]u8
    fill_quotes(@content[0], 8192)
    let empty: i64 = edit_len(@content[0], 0)
    let full: i64 = edit_len(@content[0], 8192)
    if full - empty != 49152
        return 1
    0


# The page renders whole: the footer follows the 48 KB of content.
[[test]]
fn test_view_page_ends_with_footer() -> i32
    var content: [8192]u8
    fill_quotes(@content[0], 8192)
    var s: String = string_new()
    render_view_page(@s, c"page", 4, @content[0], 8192)
    let n: i64 = string_len(@s)
    var rc: i32 = 0
    if n < 14 or strneq(string_as_ptr(@s) + n - 14, c"</body></html>", 14) == 0
        rc = 1
    string_drop(@s)
    rc


# Slugs listed on the index come from the store, not the router, so the index
# escapes them in both the href and the link text.
[[test]]
fn test_index_escapes_stored_slugs() -> i32
    let slugs = c"ok-page\n\"><script>x\n"
    var s: String = string_new()
    render_index_page(@s, slugs, 20)
    var rc: i32 = 0
    if string_contains(@s, "<script>")
        rc = 1
    else if string_contains(@s, "\"><script")
        rc = 2
    else if not string_contains(@s, "href=\"/wiki/&quot;&gt;&lt;script&gt;x\"")
        rc = 3
    else if not string_contains(@s, "href=\"/wiki/ok-page\">ok-page</a>")
        rc = 4
    string_drop(@s)
    rc


[[test]]
fn test_index_empty_store() -> i32
    var s: String = string_new()
    render_index_page(@s, c"", 0)
    var rc: i32 = 0
    if not string_contains(@s, "No pages yet")
        rc = 1
    string_drop(@s)
    rc


# Defence in depth: even a slug that slipped past validation is escaped in the
# view and edit pages' hrefs and form action.
[[test]]
fn test_view_and_edit_escape_slug_in_href() -> i32
    let bad = c"a\"b"
    var s: String = string_new()
    render_view_page(@s, bad, 3, c"x", 1)
    render_edit_page(@s, bad, 3, c"x", 1)
    render_not_found_page(@s, bad, 3)
    var rc: i32 = 0
    if string_contains(@s, "a\"b")
        rc = 1
    else if not string_contains(@s, "href=\"/wiki/a&quot;b/edit\"")
        rc = 2
    else if not string_contains(@s, "action=\"/wiki/a&quot;b\"")
        rc = 3
    string_drop(@s)
    rc


[[test]]
fn test_error_page_has_title_and_message() -> i32
    var s: String = string_new()
    render_error_page(@s, c"Bad Request", c"Missing field.")
    var rc: i32 = 0
    if not string_contains(@s, "<h1>Bad Request</h1>")
        rc = 1
    else if not string_contains(@s, "<p>Missing field.</p>")
        rc = 2
    string_drop(@s)
    rc


[[test]]
fn test_titled_view_heads_the_page_with_the_title_and_escapes_it() -> i32
    var out: String = string_new()
    render_titled_view_page(@&out, c"home", 4, c"<T>", 3, c"body", 4)
    let ok: bool = string_contains(@out, "<h1>&lt;T&gt;</h1>") and string_contains(@out, "/wiki/home/edit")
    string_drop(@&out)
    if ok
        return 0
    1


fn status_line_is(status: i32, line: StrView) -> bool
    var out: String = string_new()
    push_headers(@&out, status, c"text/plain", 0)
    let ok: bool = string_contains(@out, line)
    string_drop(@&out)
    ok


# An unknown status used to go out as "200 OK".
[[test]]
fn test_every_presenter_status_has_its_own_status_line() -> i32
    if not status_line_is(204, "HTTP/1.1 204 No Content")
        return 1
    if not status_line_is(403, "HTTP/1.1 403 Forbidden")
        return 2
    if not status_line_is(413, "HTTP/1.1 413 Content Too Large")
        return 3
    if not status_line_is(599, "HTTP/1.1 500 Internal Server Error")
        return 4
    0
