# test/test_pages.ritz - HTML page renderers (AGAST #1870)
#
# The renderers build into a growable String.  Before #1870 they wrote into
# fixed [16384]u8 / [8192]u8 / [4096]u8 stack buffers with no bounds checks,
# and a stored page of 8192 `"` (escaped to 6 bytes each) overflowed by ~33 KB.

import ritzlib.strview { StrView }
import ritzlib.string { String, string_new, string_with_cap }

import pages { render_view_page, render_titled_view_page, render_edit_page, render_index_page, render_not_found_page, render_error_page, push_headers, push_redirect_to_page }


# A page body of `n` copies of `"`.
fn quotes(n: i64) -> String
    var s: String = string_with_cap(n)
    for i in 0..n
        s.push('"')
    s


fn view_len(content: StrView) -> i64
    var s: String = string_new()
    render_view_page(@&s, "page", content)
    let n: i64 = s.len()
    return n


fn edit_len(content: StrView) -> i64
    var s: String = string_new()
    render_edit_page(@&s, "page", content)
    let n: i64 = s.len()
    return n


# Every content byte must land in the output: 8192 `"` grow the view page by
# exactly 8192 * 6 bytes over the same page with empty content.
[[test]]
fn test_view_page_holds_max_escaped_content() -> i32
    var content: String = quotes(8192)
    let empty: i64 = view_len("")
    let full: i64 = view_len(content.as_view())
    if full - empty != 49152
        return 1
    if full <= 16384
        return 2
    0


[[test]]
fn test_edit_page_holds_max_escaped_content() -> i32
    var content: String = quotes(8192)
    let empty: i64 = edit_len("")
    let full: i64 = edit_len(content.as_view())
    if full - empty != 49152
        return 1
    0


# The page renders whole: the footer follows the 48 KB of content.
[[test]]
fn test_view_page_ends_with_footer() -> i32
    var content: String = quotes(8192)
    var s: String = string_new()
    render_view_page(@&s, "page", content.as_view())
    var rc: i32 = 0
    if not s.ends_with("</body></html>")
        rc = 1
    rc


# Slugs listed on the index come from the store, not the router, so the index
# escapes them in both the href and the link text.
[[test]]
fn test_index_escapes_stored_slugs() -> i32
    var s: String = string_new()
    render_index_page(@&s, "ok-page\n\"><script>x\n")
    var rc: i32 = 0
    if s.contains("<script>")
        rc = 1
    else if s.contains("\"><script")
        rc = 2
    else if not s.contains("href=\"/wiki/&quot;&gt;&lt;script&gt;x\"")
        rc = 3
    else if not s.contains("href=\"/wiki/ok-page\">ok-page</a>")
        rc = 4
    rc


[[test]]
fn test_index_empty_store() -> i32
    var s: String = string_new()
    render_index_page(@&s, "")
    var rc: i32 = 0
    if not s.contains("No pages yet")
        rc = 1
    rc


# Defence in depth: even a slug that slipped past validation is escaped in the
# view and edit pages' hrefs and form action.
[[test]]
fn test_view_and_edit_escape_slug_in_href() -> i32
    let bad: StrView = "a\"b"
    var s: String = string_new()
    render_view_page(@&s, bad, "x")
    render_edit_page(@&s, bad, "x")
    render_not_found_page(@&s, bad)
    var rc: i32 = 0
    if s.contains("a\"b")
        rc = 1
    else if not s.contains("href=\"/wiki/a&quot;b/edit\"")
        rc = 2
    else if not s.contains("action=\"/wiki/a&quot;b\"")
        rc = 3
    rc


[[test]]
fn test_error_page_has_title_and_message() -> i32
    var s: String = string_new()
    render_error_page(@&s, "Bad Request", "Missing field.")
    var rc: i32 = 0
    if not s.contains("<h1>Bad Request</h1>")
        rc = 1
    else if not s.contains("<p>Missing field.</p>")
        rc = 2
    rc


[[test]]
fn test_titled_view_heads_the_page_with_the_title_and_escapes_it() -> i32
    var out: String = string_new()
    render_titled_view_page(@&out, "home", "<T>", "body")
    let ok: bool = out.contains("<h1>&lt;T&gt;</h1>") and out.contains("/wiki/home/edit")
    if ok
        return 0
    1


fn status_line_is(status: i32, line: StrView) -> bool
    var out: String = string_new()
    push_headers(@&out, status, "text/plain", 0)
    let ok: bool = out.contains(line)
    ok


# An unknown status used to go out as "200 OK".
[[test]]
fn test_every_presenter_status_has_its_own_status_line() -> i32
    if not status_line_is(204, "HTTP/1.1 204 No Content")
        return 1
    if not status_line_is(403, "HTTP/1.1 403 Forbidden")
        return 2
    if not status_line_is(413, "HTTP/1.1 413 Content Too Large")
        return 3
    if not status_line_is(599, "HTTP/1.1 500 Internal Server Error")
        return 4
    0


# The store's outage answer (AGAST #2459): a 503, not a 500.
[[test]]
fn test_store_unavailable_has_its_own_status_line() -> i32
    if status_line_is(503, "HTTP/1.1 503 Service Unavailable") then 0 else 1


# The 303 after a save names the page's slug, a StrView (AGAST #3461).
[[test]]
fn test_redirect_to_page_names_the_slug() -> i32
    var out: String = string_new()
    push_redirect_to_page(@&out, "language/syntax")
    var rc: i32 = 0
    if not out.contains("HTTP/1.1 303 See Other\r\nLocation: /wiki/language/syntax\r\n")
        rc = 1
    rc
