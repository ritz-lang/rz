# test/test_html_writer.ritz - HTML buffer writer tests
#
# write_cstr / write_bytes / write_escaped append into a byte buffer at a
# position and return the new position (AGAST #1951: built on ritzlib.str,
# not hand-rolled byte loops).

import ritzlib.str { strneq }

import html_writer { write_cstr, write_bytes, write_escaped }


# 1 if buf[0..len] equals the NUL-terminated `want` exactly, else 0.
fn buf_is(buf: *u8, len: i32, want: *u8) -> i32
    var n: i32 = 0
    while *(want + n) != 0
        n += 1
    if n != len
        return 0
    if strneq(buf, want, len as i64) == 0
        return 0
    1


[[test]]
fn test_write_cstr_appends_and_returns_end() -> i32
    var buf: [32]u8
    var p: i32 = write_cstr(@buf[0], 0, c"ab")
    p = write_cstr(@buf[0], p, c"cde")
    if p != 5
        return 1
    if buf_is(@buf[0], p, c"abcde") == 0
        return 2
    0


[[test]]
fn test_write_cstr_empty_is_noop() -> i32
    var buf: [8]u8
    buf[0] = 'x'
    let p = write_cstr(@buf[0], 0, c"")
    if p != 0
        return 1
    if buf[0] != 'x'
        return 2
    0


[[test]]
fn test_write_bytes_copies_exactly_len() -> i32
    var buf: [16]u8
    buf[3] = 'z'
    # Copy 3 bytes of a longer string; the 4th byte must be untouched.
    let p = write_bytes(@buf[0], 0, c"hello", 3)
    if p != 3
        return 1
    if buf_is(@buf[0], p, c"hel") == 0
        return 2
    if buf[3] != 'z'
        return 3
    0


[[test]]
fn test_write_bytes_at_offset() -> i32
    var buf: [16]u8
    var p: i32 = write_cstr(@buf[0], 0, c"<")
    p = write_bytes(@buf[0], p, c"abc", 2)
    if p != 3
        return 1
    if buf_is(@buf[0], p, c"<ab") == 0
        return 2
    0


[[test]]
fn test_write_escaped_escapes_html_specials() -> i32
    var buf: [64]u8
    let src = c"<a href='x'>&\"</a>"
    var n: i32 = 0
    while *(src + n) != 0
        n += 1
    let p = write_escaped(@buf[0], 0, src, n)
    if buf_is(@buf[0], p, c"&lt;a href=&#39;x&#39;&gt;&amp;&quot;&lt;/a&gt;") == 0
        return 1
    0


[[test]]
fn test_write_escaped_passes_plain_bytes() -> i32
    var buf: [16]u8
    let p = write_escaped(@buf[0], 0, c"plain-text", 10)
    if buf_is(@buf[0], p, c"plain-text") == 0
        return 1
    0
