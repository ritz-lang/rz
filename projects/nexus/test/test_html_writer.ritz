# test/test_html_writer.ritz - HTML String appender tests
#
# html_bytes / html_bytes / html_escaped append onto a growable ritzlib
# String (AGAST #1870: the old fixed-buffer writers never bound-checked, so
# escaping 8192 bytes of `"` wrote ~49 KB into a 16 KB stack buffer).
# html_bytes / html_escaped take a StrView (AGAST #3461).

import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new }

import html_writer { html_bytes, html_escaped }


# 1 if `s` equals `want` exactly, else 0.
fn str_is(s: @&String, want: StrView) -> i32
    if s.as_view().eq(want) then 1 else 0


[[test]]
fn test_html_bytes_appends() -> i32
    var s: String = string_new()
    html_bytes(@&s, "ab")
    html_bytes(@&s, "cde")
    var rc: i32 = 0
    if str_is(@&s, "abcde") == 0
        rc = 1
    rc


[[test]]
fn test_html_bytes_empty_is_noop() -> i32
    var s: String = string_new()
    html_bytes(@&s, "")
    var rc: i32 = 0
    if s.len() != 0
        rc = 1
    rc


[[test]]
fn test_html_bytes_copies_exactly_len() -> i32
    var s: String = string_new()
    let hello: StrView = "hello"
    html_bytes(@&s, hello.take(3))
    var rc: i32 = 0
    if str_is(@&s, "hel") == 0
        rc = 1
    rc


[[test]]
fn test_html_escaped_escapes_html_specials() -> i32
    var s: String = string_new()
    html_escaped(@&s, "<a href='x'>&\"</a>")
    var rc: i32 = 0
    if str_is(@&s, "&lt;a href=&#39;x&#39;&gt;&amp;&quot;&lt;/a&gt;") == 0
        rc = 1
    rc


[[test]]
fn test_html_escaped_passes_plain_bytes() -> i32
    var s: String = string_new()
    s.push_str("<")
    html_escaped(@&s, "plain-text")
    var rc: i32 = 0
    if str_is(@&s, "<plain-text") == 0
        rc = 1
    rc


# The #1870 overflow input: a maximal (8192-byte) page of `"`, every byte
# of which expands to the 6-byte `&quot;`.  The String must grow to hold
# all 49152 bytes; the old [16384]u8 buffer took 16 KB of it.
[[test]]
fn test_html_escaped_grows_past_old_fixed_buffer() -> i32
    var src: [8192]u8
    for i in 0..8192
        src[i] = '"'
    var s: String = string_new()
    let all: [u8] = @src
    html_escaped(@&s, all.as_strview())
    var rc: i32 = 0
    if s.len() != 49152
        rc = 1
    else
        let v: StrView = s.as_view()
        for i in 0..8192
            let at: i64 = (i * 6) as i64
            if not v.slice(at, at + 6).eq("&quot;")
                rc = 2
                break
    rc
