# test/test_form.ritz - form bodies (AGAST #4692)
#
# form_field finds `name=` among the body's `&`-separated pairs and returns
# its value URL-decoded into a String; the body itself is only read.

import ritzlib.strview { StrView }
import ritzlib.string { String }

import form { form_field, url_decode }


# True if `body`'s field `name` is present and decodes to `want`.
fn field_is(body: StrView, name: StrView, want: StrView) -> bool
    match form_field(body, name)
        Some(v) => v.eq(want)
        None => false


fn field_absent(body: StrView, name: StrView) -> bool
    match form_field(body, name)
        Some(_) => false
        None => true


[[test]]
fn test_url_decode_plus_and_percent() -> i32
    var a: String = url_decode("a+b%2Fc%3d%41")
    if not a.eq("a b/c=A")
        return 1
    # A '%' without two bytes after it is kept as it is.
    var b: String = url_decode("50%")
    if not b.eq("50%")
        return 2
    var c: String = url_decode("%4")
    if not c.eq("%4") then 3 else 0


[[test]]
fn test_form_field_finds_each_pair() -> i32
    let body: StrView = "slug=my%2Fpage&content=hello+world"
    if not field_is(body, "slug", "my/page")
        return 1
    if not field_is(body, "content", "hello world")
        return 2
    if not field_absent(body, "title") then 3 else 0


[[test]]
fn test_form_field_matches_whole_names_only() -> i32
    # "content" is not "content2", and "slug" inside a value is not a name.
    let body: StrView = "content2=x&a=slug=no&content=yes"
    if not field_is(body, "content", "yes")
        return 1
    if not field_absent(body, "slug")
        return 2
    # A name with no '=' is not a field.
    if not field_absent("slug&content=", "slug")
        return 3
    if not field_is("slug&content=", "content", "") then 4 else 0
