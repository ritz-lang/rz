# test/test_models.ritz - Model tests
#
# Tests for WikiPage and PageLink models.

import ritzlib.strview { StrView, strview_eq }
import ritzlib.string { String, string_from, string_eq }

import models.wiki_page {
    WikiPage,
    wiki_page_new,
    wiki_page_new_child,
    wiki_page_update_content,
    wiki_page_update_title,
    wiki_page_is_root,
    wiki_page_name,
    wiki_page_is_ancestor_of
}
import models.page_link {
    PageLink,
    LinkKind,
    page_link_new,
    page_link_is_reference,
    page_link_is_redirect
}
import mausoleum.document { doc_id_new, doc_id_invalid }


[[test]]
fn test_wiki_page_new() -> i32
    let page = wiki_page_new(
        string_from("language/syntax"),
        string_from("Syntax Guide"),
        string_from("# Syntax\n\nRitz syntax guide...")
    )

    assert page.version == 1
    assert page.parent_id.is_none()
    assert wiki_page_is_root(@page)
    0


[[test]]
fn test_wiki_page_update_content() -> i32
    var page = wiki_page_new(
        string_from("test-page"),
        string_from("Test Page"),
        string_from("Original content")
    )

    assert page.version == 1

    wiki_page_update_content(@page, string_from("Updated content"))

    assert page.version == 2
    assert string_eq(@page.content, "Updated content")
    0


[[test]]
fn test_wiki_page_update_title() -> i32
    var page = wiki_page_new(
        string_from("test-page"),
        string_from("Original Title"),
        string_from("Content")
    )

    assert page.version == 1

    wiki_page_update_title(@page, string_from("New Title"))

    assert page.version == 2
    assert string_eq(@page.title, "New Title")
    0


[[test]]
fn test_wiki_page_child() -> i32
    var parent = wiki_page_new(
        string_from("language"),
        string_from("Language"),
        string_from("Language overview")
    )
    parent.id = doc_id_new(0, 42)  # Simulate assigned ID

    let child = wiki_page_new_child(
        string_from("language/syntax"),
        string_from("Syntax"),
        string_from("Syntax details"),
        @parent
    )

    assert not wiki_page_is_root(@child)
    assert parent_id_value(@child) == 42
    0


# The parent's id value, or -1 for a root page. `assert` is a statement and
# match arms take expressions, so the match yields the value it checks.
fn parent_id_value(page: @WikiPage) -> i64
    match page.parent_id
        Some(id) => id.value
        None => -1


[[test]]
fn test_page_link_new() -> i32
    let source = doc_id_new(0, 1)
    let target = doc_id_new(0, 2)
    let link = page_link_new(source, target, LinkKind.Reference)

    assert link.source_id.value == source.value
    assert link.target_id.value == target.value
    assert page_link_is_reference(@link)
    assert not page_link_is_redirect(@link)
    0


[[test]]
fn test_link_kind_variants() -> i32
    let source = doc_id_new(0, 1)
    let target = doc_id_new(0, 2)

    let ref_link = page_link_new(source, target, LinkKind.Reference)
    assert page_link_is_reference(@ref_link)

    let see_also = page_link_new(source, target, LinkKind.SeeAlso)
    assert not page_link_is_reference(@see_also)

    let redirect = page_link_new(source, target, LinkKind.Redirects)
    assert page_link_is_redirect(@redirect)

    0


[[test]]
fn test_wiki_page_name() -> i32
    let nested = wiki_page_new(string_from("stdlib/io/file"), string_from("File"), string_from(""))
    let want_file: StrView = "file"
    let got_file: StrView = wiki_page_name(@nested)
    assert strview_eq(@got_file, @want_file)

    let root = wiki_page_new(string_from("language"), string_from("Language"), string_from(""))
    let want_lang: StrView = "language"
    let got_lang: StrView = wiki_page_name(@root)
    assert strview_eq(@got_lang, @want_lang)
    0


[[test]]
fn test_wiki_page_is_ancestor_of() -> i32
    let lang = wiki_page_new(string_from("language"), string_from("Language"), string_from(""))
    let syntax = wiki_page_new(string_from("language/syntax"), string_from("Syntax"), string_from(""))
    let langs = wiki_page_new(string_from("languages/other"), string_from("Other"), string_from(""))

    assert wiki_page_is_ancestor_of(@lang, @syntax)
    assert not wiki_page_is_ancestor_of(@syntax, @lang)
    assert not wiki_page_is_ancestor_of(@lang, @lang)
    # A shared prefix is not ancestry: "languages/..." is not under "language"
    assert not wiki_page_is_ancestor_of(@lang, @langs)
    0
