# test/test_repos.ritz - WikiPage document codec and repository (AGAST #1377)
#
# The codec tests are pure. The repository tests run against a real Mausoleum
# server (test/support/live_db.ritz): the server rejects anything that is not
# a Document, so only a live server proves a page can actually be stored.

import ritzlib.memory
import ritzlib.strview { StrView }
import ritzlib.string { String, string_from, string_new }
import ritzlib.gvec

import spire.repo.mausoleum { Db, db_empty, DbField, db_field, db_serialize_doc, db_extract_field }
import spire.repo.mausoleum { db_init, db_set_encryption, db_connect, db_close, db_insert, db_scan, db_delete, db_get }
import mausoleum.document { DocumentId, doc_id_invalid, doc_id_is_valid, doc_id_eq }
import mausoleum.collection { MAX_DOC_SIZE }
import services.validation { MAX_CONTENT_SIZE, MAX_SLUG_LENGTH, MAX_TITLE_LENGTH }

import models.wiki_page { WikiPage, wiki_page_new, wiki_page_new_child, wiki_page_update_content }
import errors.repo_error { RepoError }
import repos.wiki_page_codec { wiki_page_encode, wiki_page_encode_bound, wiki_page_decode, wiki_page_decode_legacy }
import repos.wiki_page_repo {
    WikiPageRepository,
    wiki_page_repo_new,
    wiki_page_repo_connect,
    wiki_page_repo_disconnect,
    wiki_page_repo_is_connected,
    wiki_page_repo_get_by_id,
    wiki_page_repo_get_by_slug,
    wiki_page_repo_insert,
    wiki_page_repo_update,
    wiki_page_repo_delete,
    wiki_page_repo_list_all,
    wiki_page_repo_delete_slug,
    wiki_page_repo_open,
    wiki_page_repo_open_memory,
    wiki_page_repo_max_content_len,
    wiki_page_repo_scan_count,
    MEMORY_MAX_CONTENT_LEN
}
import test.support.live_db { LiveDb, live_db_start, live_db_stop, live_db_restart, live_db_start_store, live_db_remove_store }


fn page_of(slug: StrView, title: StrView, content: StrView) -> WikiPage
    wiki_page_new(string_from(slug), string_from(title), string_from(content))


# `n` bytes of 'x', as a String.
fn big_string(n: i64) -> String
    var s: String = string_new()
    var i: i64 = 0
    while i < n
        s.push('x' as u8)
        i += 1
    s


# Encode then decode, as both the database and the cache do.
fn round_trip(page: *WikiPage) -> Result<WikiPage, RepoError>
    let bound: i64 = wiki_page_encode_bound(page)
    var buf: Vec<u8> = vec_with_cap<u8>(bound)
    let n: i64 = wiki_page_encode(page, buf.as_ptr(), bound)
    if n <= 0
        return Err(RepoError.SerializationError)
    wiki_page_decode(buf.as_ptr(), n as i32)


# 0 = `e` is the variant the name says, 1 = any other variant.
fn expect_not_found(e: @RepoError) -> i32
    match *e
        RepoError.NotFound => 0
        _ => 1


fn expect_network(e: @RepoError) -> i32
    match *e
        RepoError.NetworkError(_) => 0
        _ => 1


fn expect_database(e: @RepoError) -> i32
    match *e
        RepoError.DatabaseError(_) => 0
        _ => 1


fn expect_serialization(e: @RepoError) -> i32
    match *e
        RepoError.SerializationError => 0
        _ => 1


# Connect `repo` to the plaintext test server.
fn connect(repo: *WikiPageRepository, db: *LiveDb) -> i32
    match wiki_page_repo_connect(repo, "127.0.0.1", db.port, false)
        Ok(_) => 0
        Err(_) => 1


# ============================================================================
# Codec
# ============================================================================

[[test]]
fn test_codec_round_trips_every_field() -> i32
    var parent = page_of("language", "Language", "root")
    parent.id.value = 41
    var page = wiki_page_new_child(string_from("language/syntax"), string_from("Syntax"), string_from("# Body"), @parent)
    page.id.value = 42
    page.author_id.value = 7
    page.version = 9
    page.created_at.nanos = 1000
    page.updated_at.nanos = 2000

    match round_trip(@page)
        Ok(got) =>
            if not (got.slug).eq("language/syntax")
                return 1
            if not (got.title).eq("Syntax")
                return 2
            if not (got.content).eq("# Body")
                return 3
            if got.id.value != 42
                return 4
            if got.author_id.value != 7
                return 5
            if got.version != 9
                return 6
            if got.created_at.nanos != 1000
                return 7
            if got.updated_at.nanos != 2000
                return 8
            match got.parent_id
                Some(id) => if id.value == 41 then 0 else 9
                None => 10
        Err(_) => 11


[[test]]
fn test_codec_root_page_has_no_parent() -> i32
    var page = page_of("home", "Home", "")
    match round_trip(@page)
        Ok(got) =>
            if (got.content).len() != 0
                return 1
            if got.parent_id.is_some()
                return 2
            0
        Err(_) => 3


[[test]]
fn test_codec_has_no_fixed_size_limit() -> i32
    # The old codec wrote into a [4096]u8 stack buffer with no bounds check.
    var page = wiki_page_new(string_from("big"), string_from("Big"), big_string(100000))
    match round_trip(@page)
        Ok(got) => if (got.content).len() == 100000 then 0 else 1
        Err(_) => 2


[[test]]
fn test_encode_refuses_a_buffer_too_small() -> i32
    var page = page_of("home", "Home", "content")
    var buf: [8]u8
    if wiki_page_encode(@page, @buf[0], 8) < 0
        return 0
    1


[[test]]
fn test_decode_rejects_garbage() -> i32
    var junk: [64]u8
    var i: i32 = 0
    while i < 64
        junk[i] = 0xFF
        i += 1
    match wiki_page_decode(@junk[0], 64)
        Ok(_) => 1
        Err(e) => expect_serialization(@e)


[[test]]
fn test_decode_rejects_a_truncated_document() -> i32
    var page = page_of("home", "Home", "some content that will be cut off")
    let bound: i64 = wiki_page_encode_bound(@page)
    var buf: Vec<u8> = vec_with_cap<u8>(bound)
    let n: i64 = wiki_page_encode(@page, buf.as_ptr(), bound)
    let result = wiki_page_decode(buf.as_ptr(), (n / 2) as i32)
    match result
        Ok(_) => 1
        Err(e) => expect_serialization(@e)


[[test]]
fn test_decode_rejects_a_document_missing_fields() -> i32
    # What store.ritz writes: a Document, but with only slug and content.
    var buf: [512]u8
    var fields: [2]DbField
    fields[0] = db_field(c"slug", 4, c"home", 4)
    fields[1] = db_field(c"content", 7, c"hi", 2)
    let n: i64 = db_serialize_doc(@buf[0], 512, @fields[0], 2)
    if n <= 0
        return 2
    match wiki_page_decode(@buf[0], n as i32)
        Ok(_) => 1
        Err(e) => expect_serialization(@e)


# Every field but one: a page must not decode with a blank where its title was.
[[test]]
fn test_decode_rejects_a_document_missing_only_the_title() -> i32
    var buf: [512]u8
    var fields: [8]DbField
    fields[0] = db_field(c"slug", 4, c"home", 4)
    fields[1] = db_field(c"content", 7, c"hi", 2)
    fields[2] = db_field(c"id", 2, c"1", 1)
    fields[3] = db_field(c"version", 7, c"1", 1)
    fields[4] = db_field(c"created_at", 10, c"1", 1)
    fields[5] = db_field(c"updated_at", 10, c"1", 1)
    fields[6] = db_field(c"author_id", 9, c"1", 1)
    fields[7] = db_field(c"parent_id", 9, c"1", 1)
    let n: i64 = db_serialize_doc(@buf[0], 512, @fields[0], 8)
    if n <= 0
        return 2
    match wiki_page_decode(@buf[0], n as i32)
        Ok(_) => 1
        Err(e) => expect_serialization(@e)


# ============================================================================
# Repository, not connected
# ============================================================================

[[test]]
fn test_repo_starts_disconnected() -> i32
    var repo = wiki_page_repo_new()
    if wiki_page_repo_is_connected(@repo)
        return 1
    0


[[test]]
fn test_repo_operations_fail_when_disconnected() -> i32
    var repo = wiki_page_repo_new()
    var page = page_of("home", "Home", "hi")
    match wiki_page_repo_get_by_slug(@repo, "home")
        Ok(_) => return 1
        Err(e) =>
            if expect_network(@e) != 0
                return 2
    match wiki_page_repo_get_by_id(@repo, doc_id_invalid())
        Ok(_) => return 3
        Err(e) =>
            if expect_network(@e) != 0
                return 4
    match wiki_page_repo_insert(@repo, @page)
        Ok(_) => return 5
        Err(e) =>
            if expect_network(@e) != 0
                return 6
    match wiki_page_repo_update(@repo, @page)
        Ok(_) => return 7
        Err(e) =>
            if expect_network(@e) != 0
                return 8
    match wiki_page_repo_delete(@repo, doc_id_invalid())
        Ok(_) => return 9
        Err(e) =>
            if expect_network(@e) != 0
                return 10
    match wiki_page_repo_list_all(@repo)
        Ok(_) => 11
        Err(e) => expect_network(@e)


[[test]]
fn test_repo_connect_failure_is_a_network_error() -> i32
    var repo = wiki_page_repo_new()
    # Port 1 is privileged and nothing in the test environment listens on it.
    match wiki_page_repo_connect(@repo, "127.0.0.1", 1, false)
        Ok(_) => 1
        Err(e) => expect_network(@e)


# ============================================================================
# Repository, against a live server
# ============================================================================

[[test]]
fn test_insert_assigns_an_id_and_get_by_id_returns_the_page() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        var page = page_of("home", "Home", "Welcome")
        match wiki_page_repo_insert(@repo, @page)
            Ok(id) =>
                rc = check_inserted(@repo, @page, id)
            Err(_) =>
                rc = 2
    else
        rc = 1
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_inserted(repo: *WikiPageRepository, page: *WikiPage, id: DocumentId) -> i32
    if doc_id_is_valid(@id) != 1
        return 3
    if page.id.value != id.value
        return 4
    match wiki_page_repo_get_by_id(repo, id)
        Ok(got) =>
            if not (got.slug).eq("home")
                return 5
            if not (got.content).eq("Welcome")
                return 6
            if got.id.value != id.value
                return 7
            0
        Err(_) => 8


[[test]]
fn test_get_by_id_missing_is_not_found() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        var id: DocumentId = doc_id_invalid()
        id.value = 12345
        match wiki_page_repo_get_by_id(@repo, id)
            Ok(_) =>
                rc = 2
            Err(e) =>
                rc = expect_not_found(@e)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn insert_page(repo: *WikiPageRepository, slug: StrView, content: StrView) -> i32
    var page = page_of(slug, "Title", content)
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => 0
        Err(_) => 1


fn check_slug_lookup(repo: *WikiPageRepository) -> i32
    # The longer and shorter slugs go in first, so a prefix match would find
    # them before the exact one.
    if insert_page(repo, "alpha/beta", "second") != 0
        return 3
    if insert_page(repo, "alph", "third") != 0
        return 4
    if insert_page(repo, "alpha", "first") != 0
        return 2
    match wiki_page_repo_get_by_slug(repo, "alpha")
        Ok(got) =>
            if not (got.content).eq("first")
                return 5
            if doc_id_is_valid(@got.id) != 1
                return 6
        Err(_) => return 7
    match wiki_page_repo_get_by_slug(repo, "alpha/beta")
        Ok(got) =>
            if not (got.content).eq("second")
                return 8
        Err(_) => return 9
    match wiki_page_repo_get_by_slug(repo, "missing")
        Ok(_) => 10
        Err(e) => expect_not_found(@e)


[[test]]
fn test_get_by_slug_matches_the_whole_slug() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_slug_lookup(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_update(repo: *WikiPageRepository) -> i32
    var page = page_of("home", "Home", "before")
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => pass
        Err(_) => return 2
    let old_id: DocumentId = page.id

    wiki_page_update_content(@page, string_from("after"))
    match wiki_page_repo_update(repo, @page)
        Ok(_) => pass
        Err(_) => return 3

    # A second update must use the id the first one assigned.
    wiki_page_update_content(@page, string_from("after again"))
    match wiki_page_repo_update(repo, @page)
        Ok(_) => pass
        Err(_) => return 4

    match wiki_page_repo_get_by_slug(repo, "home")
        Ok(got) =>
            if not (got.content).eq("after again")
                return 5
            if got.version != 3
                return 6
            if got.id.value != page.id.value
                return 7
        Err(_) => return 8

    match wiki_page_repo_get_by_id(repo, old_id)
        Ok(_) => return 9
        Err(e) =>
            if expect_not_found(@e) != 0
                return 10

    match wiki_page_repo_list_all(repo)
        Ok(pages) => if pages.len() == 1 then 0 else 11
        Err(_) => 12


[[test]]
fn test_update_replaces_the_page() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_update(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_update_of_deleted_page(repo: *WikiPageRepository) -> i32
    var page = page_of("home", "Home", "before")
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => pass
        Err(_) => return 2
    match wiki_page_repo_delete(repo, page.id)
        Ok(_) => pass
        Err(_) => return 3
    match wiki_page_repo_update(repo, @page)
        Ok(_) => return 4
        Err(e) =>
            if expect_not_found(@e) != 0
                return 5
    # The insert half of the update must not resurrect the page.
    match wiki_page_repo_list_all(repo)
        Ok(pages) => if pages.len() == 0 then 0 else 6
        Err(_) => 7


[[test]]
fn test_update_of_a_deleted_page_is_not_found_and_leaves_nothing() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_update_of_deleted_page(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_failed_update(repo: *WikiPageRepository) -> i32
    var page = page_of("home", "Home", "kept")
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => pass
        Err(_) => return 2
    # Past what one document holds (AGAST #3638: no longer 4000 bytes).
    wiki_page_update_content(@page, big_string(MAX_DOC_SIZE))
    match wiki_page_repo_update(repo, @page)
        Ok(_) => return 3
        Err(e) =>
            if expect_database(@e) != 0
                return 4
    match wiki_page_repo_get_by_slug(repo, "home")
        Ok(got) => if (got.content).eq("kept") then 0 else 5
        Err(_) => 6


# Update writes before it deletes, so a refused write cannot lose the page.
[[test]]
fn test_failed_update_keeps_the_old_page() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_failed_update(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_delete(repo: *WikiPageRepository) -> i32
    var page = page_of("home", "Home", "hi")
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => pass
        Err(_) => return 2
    match wiki_page_repo_delete(repo, page.id)
        Ok(_) => pass
        Err(_) => return 3
    match wiki_page_repo_get_by_slug(repo, "home")
        Ok(_) => return 4
        Err(e) =>
            if expect_not_found(@e) != 0
                return 5
    match wiki_page_repo_delete(repo, page.id)
        Ok(_) => 6
        Err(e) => expect_not_found(@e)


[[test]]
fn test_delete_removes_the_page() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_delete(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_list(repo: *WikiPageRepository) -> i32
    match wiki_page_repo_list_all(repo)
        Ok(pages) =>
            if pages.len() != 0
                return 2
        Err(_) => return 3
    if insert_page(repo, "one", "1") != 0
        return 4
    if insert_page(repo, "two", "2") != 0
        return 5
    match wiki_page_repo_list_all(repo)
        Ok(pages) =>
            if pages.len() != 2
                return 6
            let first: *WikiPage = pages.get_ptr(0)
            if not (first.slug).eq("one")
                return 7
            0
        Err(_) => 8


[[test]]
fn test_list_all_returns_every_page() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_list(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


fn check_oversize(repo: *WikiPageRepository, size: i64) -> i32
    var page = wiki_page_new(string_from("big"), string_from("Big"), big_string(size))
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => return 2
        Err(e) =>
            if expect_database(@e) != 0
                return 3
    # The failure must not cost us the connection.
    if insert_page(repo, "small", "still works") != 0
        return 4
    match wiki_page_repo_get_by_slug(repo, "small")
        Ok(_) => 0
        Err(_) => 5


# A page bigger than the server's document limit is a clean error, not a crash.
[[test]]
fn test_oversize_page_is_a_database_error() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_oversize(@repo, MAX_DOC_SIZE)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


# Bigger than the client's 64 KB message buffer too.
[[test]]
fn test_page_over_the_client_buffer_is_a_database_error() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_oversize(@repo, 100000)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


# ============================================================================
# Page size limit (AGAST #2208)
# ============================================================================

fn letters(c: u8, n: i64) -> String
    var s: String = string_new()
    var i: i64 = 0
    while i < n
        s.push(c)
        i += 1
    s


# The longest page validation accepts: longest slug, title and content, and
# every number at its longest decimal (i64 min, 20 characters).
fn worst_case_page(content_len: i64) -> WikiPage
    let longest: i64 = -9223372036854775807 - 1
    var parent: DocumentId = doc_id_invalid()
    parent.value = longest
    var page = wiki_page_new(letters('s' as u8, MAX_SLUG_LENGTH), letters('t' as u8, MAX_TITLE_LENGTH), letters('c' as u8, content_len))
    page.id.value = longest
    page.author_id.value = longest
    page.version = longest as u64
    page.created_at.nanos = longest
    page.updated_at.nanos = longest
    page.parent_id = Some(parent)
    page


fn encoded_len(page: *WikiPage) -> i64
    let bound: i64 = wiki_page_encode_bound(page)
    var buf: Vec<u8> = vec_with_cap<u8>(bound)
    wiki_page_encode(page, buf.as_ptr(), bound)


# MAX_CONTENT_SIZE is exactly what one mausoleum document leaves for content
# once everything else on the page is as long as validation allows.
[[test]]
fn test_codec_longest_valid_page_is_one_max_document() -> i32
    var page = worst_case_page(MAX_CONTENT_SIZE)
    if encoded_len(@page) != MAX_DOC_SIZE
        return 1
    var over = worst_case_page(MAX_CONTENT_SIZE + 1)
    if encoded_len(@over) != MAX_DOC_SIZE + 1
        return 2
    0


fn check_max_page(repo: *WikiPageRepository) -> i32
    var page = wiki_page_new(letters('s' as u8, MAX_SLUG_LENGTH), letters('t' as u8, MAX_TITLE_LENGTH), letters('c' as u8, MAX_CONTENT_SIZE))
    match wiki_page_repo_insert(repo, @page)
        Ok(_) => pass
        Err(_) => return 1
    let slug = letters('s' as u8, MAX_SLUG_LENGTH)
    match wiki_page_repo_get_by_slug(repo, slug.as_view())
        Ok(got) =>
            if (got.content).len() != MAX_CONTENT_SIZE
                return 2
            if not (got.content).eq((page.content).as_view())
                return 3
            0
        Err(_) => 4


# A page at the limit is stored and read back whole by a real server.
[[test]]
fn test_page_at_the_limit_round_trips() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = check_max_page(@repo)
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


# ============================================================================
# Many workers, one database (AGAST #2459, #2209)
#
# zeus runs several nexus workers, each with its own repository. These tests
# play one worker (`repo`) and use a second repository or a raw connection as
# "another worker" writing behind its back: every worker must see every other
# worker's writes on its next request.
# ============================================================================

fn repos_on(db: *LiveDb, a: *WikiPageRepository, b: *WikiPageRepository) -> i32
    if connect(a, db) != 0
        return 1
    connect(b, db)


# A raw connection to the repository's collection, writing as store.ritz
# (before #2209) or a foreign app did.  The server keeps each CONNECT name's
# documents apart (AGAST #3637), so it names the repo's collection.
fn raw_connect(raw: *Db, port: i32) -> i32
    db_init(raw, c"127.0.0.1", 9, port, c"nexus_pages", 11)
    db_set_encryption(raw, 0)
    db_connect(raw)


# A store.ritz page: a Document with only `slug` and `content`.
fn raw_put(raw: *Db, k1: StrView, v1: StrView, k2: StrView, v2: StrView) -> i64
    var fields: [2]DbField
    fields[0] = db_field(k1.as_ptr(), k1.len() as i32, v1.as_ptr(), v1.len() as i32)
    fields[1] = db_field(k2.as_ptr(), k2.len() as i32, v2.as_ptr(), v2.len() as i32)
    var buf: [1024]u8
    let n: i64 = db_serialize_doc(@buf[0], 1024, @fields[0], 2)
    if n < 0
        return -1
    db_insert(raw, @buf[0], n as i32)


fn legacy_put(raw: *Db, slug: StrView, content: StrView) -> i64
    raw_put(raw, "slug", slug, "content", content)


struct SlugCount
    slug: StrView
    n: i32


fn slug_count_step(doc_id: i64, data: *u8, len: i32, user: *u8) -> i32
    let sc: *SlugCount = user as *SlugCount
    var got: [129]u8
    let n: i32 = db_extract_field(data, len, c"slug", 4, @got[0], 129)
    if n as i64 != (sc.slug).len()
        return 0
    for i in 0..n
        if got[i] != *((sc.slug).as_ptr() + i)
            return 0
    sc.n += 1
    0


# How many documents in the database hold `slug`.
fn docs_for(raw: *Db, slug: StrView) -> i32
    var sc: SlugCount
    sc.slug = slug
    sc.n = 0
    if db_scan(raw, slug_count_step as *u8, @sc as *u8) < 0
        return -1
    sc.n


# `repo` serves `slug` with exactly `want`.
fn serves(repo: *WikiPageRepository, slug: StrView, want: StrView) -> bool
    match wiki_page_repo_get_by_slug(repo, slug)
        Ok(got) =>
            let ok: bool = (got.content).eq(want)
            ok
        Err(_) => false


fn listed_count(repo: *WikiPageRepository) -> i64
    match wiki_page_repo_list_all(repo)
        Ok(pages) =>
            let n: i64 = pages.len()
            n
        Err(_) => -1


[[test]]
fn test_repo_serves_a_page_another_worker_created() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var rc: i32 = repos_on(@db, @a, @b)
    if rc == 0
        rc = insert_page(@b, "made-elsewhere", "hello from worker b")
    if rc == 0 and not serves(@a, "made-elsewhere", "hello from worker b")
        rc = 3
    live_db_stop(@db)
    rc


# 0 = the lookup reports NotFound; 1 = it found a page or failed otherwise.
fn expect_missing(repo: *WikiPageRepository, slug: StrView) -> i32
    match wiki_page_repo_get_by_slug(repo, slug)
        Ok(_got) =>
            1
        Err(e) => expect_not_found(@e)


# AGAST #3644: a slug lookup asks the server's index, it does not scan the
# collection. The scan counter is the proof: it must not move across a hit
# or a miss.
[[test]]
fn test_repo_get_by_slug_does_not_scan_the_collection() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = insert_page(@repo, "indexed-slug", "body")
    var before: i64 = 0
    if rc == 0
        before = wiki_page_repo_scan_count(@repo)
    if rc == 0 and not serves(@repo, "indexed-slug", "body")
        rc = 3
    if rc == 0 and wiki_page_repo_scan_count(@repo) != before
        rc = 4
    if rc == 0 and expect_missing(@repo, "no-such-page") != 0
        rc = 5
    if rc == 0 and wiki_page_repo_scan_count(@repo) != before
        rc = 6
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc


[[test]]
fn test_repo_serves_the_newest_copy_of_a_slug() -> i32
    # Two documents for one slug: a save interrupted between its insert and
    # its delete, or two workers saving at once. The newest is the page.
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var rc: i32 = repos_on(@db, @a, @b)
    if rc == 0
        rc = insert_page(@b, "twice", "older")
    if rc == 0
        rc = insert_page(@b, "twice", "newer")
    if rc == 0 and not serves(@a, "twice", "newer")
        rc = 3
    live_db_stop(@db)
    rc


fn check_update_cleans_up(a: *WikiPageRepository, b: *WikiPageRepository, raw: *Db) -> i32
    if insert_page(b, "twice", "older") != 0
        return 2
    if insert_page(b, "twice", "newer") != 0
        return 3
    match wiki_page_repo_get_by_slug(a, "twice")
        Ok(got) =>
            var page: WikiPage = got
            wiki_page_update_content(@page, string_from("newest"))
            match wiki_page_repo_update(a, @page)
                Ok(_) => pass
                Err(_) => return 4
        Err(_) => return 5
    if docs_for(raw, "twice") != 1
        return 6
    if not serves(a, "twice", "newest")
        return 7
    if listed_count(a) == 1 then 0 else 8


[[test]]
fn test_repo_update_leaves_one_document_per_slug() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var raw: Db = db_empty()
    var rc: i32 = repos_on(@db, @a, @b)
    if rc == 0 and raw_connect(@raw, db.port) < 0
        rc = 10
    if rc == 0
        rc = check_update_cleans_up(@a, @b, @raw)
    live_db_stop(@db)
    rc


[[test]]
fn test_repo_lists_a_slug_with_two_copies_once() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var rc: i32 = repos_on(@db, @a, @b)
    if rc == 0
        rc = insert_page(@b, "twice", "older")
    if rc == 0
        rc = insert_page(@b, "twice", "newer")
    if rc == 0
        rc = insert_page(@b, "once", "only")
    if rc == 0
        match wiki_page_repo_list_all(@a)
            Ok(pages) =>
                if pages.len() != 2
                    rc = 4
                else
                    # The surviving copy is the newest.
                    let first: *WikiPage = pages.get_ptr(0)
                    if not (first.content).eq("newer")
                        rc = 5
            Err(_) => rc = 6
    live_db_stop(@db)
    rc


[[test]]
fn test_repo_delete_slug_removes_every_copy() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var rc: i32 = repos_on(@db, @a, @b)
    if rc == 0
        rc = insert_page(@b, "twice", "older")
    if rc == 0
        rc = insert_page(@b, "twice", "newer")
    if rc == 0
        match wiki_page_repo_delete_slug(@a, "twice")
            Ok(_) => pass
            Err(_) => rc = 3
    if rc == 0
        # Deleting the newest copy alone would bring the older one back.
        match wiki_page_repo_get_by_slug(@a, "twice")
            Ok(_) => rc = 4
            Err(e) => rc = expect_not_found(@e)
    if rc == 0
        match wiki_page_repo_delete_slug(@a, "twice")
            Ok(_) => rc = 5
            Err(e) => rc = expect_not_found(@e)
    live_db_stop(@db)
    rc


# ============================================================================
# Database trouble is a NetworkError (a 503), never a missing page
# ============================================================================

[[test]]
fn test_repo_reports_a_lost_database_as_a_network_error() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0
        rc = insert_page(@repo, "kept", "safe")
    live_db_stop(@db)
    if rc != 0
        return rc
    # Before #2209 a lost scan was a DatabaseError; a 404 before #2459.
    match wiki_page_repo_get_by_slug(@repo, "kept")
        Ok(_) => return 3
        Err(e) =>
            if expect_network(@e) != 0
                return 4
    var page = page_of("orphan", "Orphan", "lost")
    match wiki_page_repo_insert(@repo, @page)
        Ok(_) => 5
        Err(e) => if expect_network(@e) == 0 then 0 else 6


[[test]]
fn test_repo_reconnects_when_the_database_comes_back() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var rc: i32 = connect(@repo, @db)
    if rc == 0 and live_db_restart(@db) != 0
        rc = 91
    # The old connection is dead; the next request dials again.
    if rc == 0
        rc = insert_page(@repo, "after", "restart")
    if rc == 0 and not serves(@repo, "after", "restart")
        rc = 3
    live_db_stop(@db)
    rc


[[test]]
fn test_repo_opened_while_the_database_is_down_dials_on_each_request() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    live_db_stop(@db)
    var repo = wiki_page_repo_new()
    if wiki_page_repo_open(@repo, "127.0.0.1", db.port, false) >= 0
        return 1
    match wiki_page_repo_get_by_slug(@repo, "x")
        Ok(_) => return 2
        Err(e) =>
            if expect_network(@e) != 0
                return 3
    if live_db_restart(@db) != 0
        return 91
    var rc: i32 = insert_page(@repo, "late", "arrival")
    if rc == 0 and not serves(@repo, "late", "arrival")
        rc = 4
    live_db_stop(@db)
    rc


# ============================================================================
# Data written before #2209, and documents that aren't pages
#
# store.ritz stored a page as {slug, content}; collection names are ignored
# server-side, so those documents (and any other app's) share the pages'
# collection. Old pages stay readable, and become full pages on their next
# save; documents that aren't pages are skipped.
# ============================================================================

[[test]]
fn test_codec_decodes_a_legacy_page() -> i32
    var fields: [2]DbField
    fields[0] = db_field(c"slug", 4, c"welcome", 7)
    fields[1] = db_field(c"content", 7, c"hi", 2)
    var buf: [256]u8
    let n: i64 = db_serialize_doc(@buf[0], 256, @fields[0], 2)
    if n < 0
        return 1
    # The strict decoder still refuses it.
    match wiki_page_decode(@buf[0], n as i32)
        Ok(_) => return 2
        Err(_) => pass
    match wiki_page_decode_legacy(@buf[0], n as i32)
        Ok(page) =>
            if not (page.slug).eq("welcome")
                return 3
            if not (page.title).eq("welcome")
                return 4
            if not (page.content).eq("hi")
                return 5
            if page.version != 1 then 6 else 0
        Err(_) => 7


# wiki-seed, before #3637, wrote {slug, title, content, version}: the title
# is kept, since adopting a store's pages rewrites them (AGAST #3681).
[[test]]
fn test_codec_legacy_decode_keeps_a_stored_title() -> i32
    var fields: [3]DbField
    fields[0] = db_field(c"slug", 4, c"ritz", 4)
    fields[1] = db_field(c"title", 5, c"The Ritz Language", 17)
    fields[2] = db_field(c"content", 7, c"hi", 2)
    var buf: [256]u8
    let n: i64 = db_serialize_doc(@buf[0], 256, @fields[0], 3)
    if n < 0
        return 1
    match wiki_page_decode_legacy(@buf[0], n as i32)
        Ok(page) =>
            if not (page.title).eq("The Ritz Language")
                return 2
            if not (page.content).eq("hi") then 3 else 0
        Err(_) => 4


[[test]]
fn test_codec_legacy_decode_refuses_a_document_without_a_slug() -> i32
    var fields: [2]DbField
    fields[0] = db_field(c"kind", 4, c"user", 4)
    fields[1] = db_field(c"content", 7, c"hi", 2)
    var buf: [256]u8
    let n: i64 = db_serialize_doc(@buf[0], 256, @fields[0], 2)
    match wiki_page_decode_legacy(@buf[0], n as i32)
        Ok(_) => 1
        Err(e) => expect_serialization(@e)


fn check_legacy(repo: *WikiPageRepository, raw: *Db) -> i32
    if legacy_put(raw, "welcome", "old content") < 0
        return 2
    raw_put(raw, "kind", "session", "token", "abc")       # not a page
    if insert_page(repo, "fresh", "new content") != 0
        return 3
    if not serves(repo, "welcome", "old content")
        return 4
    if listed_count(repo) != 2
        return 5
    # Its next save rewrites it as a full page, leaving one document.
    match wiki_page_repo_get_by_slug(repo, "welcome")
        Ok(got) =>
            var page: WikiPage = got
            wiki_page_update_content(@page, string_from("edited"))
            match wiki_page_repo_update(repo, @page)
                Ok(_) => pass
                Err(_) => return 6
        Err(_) => return 7
    if docs_for(raw, "welcome") != 1
        return 8
    match wiki_page_repo_get_by_slug(repo, "welcome")
        Ok(got) =>
            if not (got.content).eq("edited")
                return 9
            if got.version != 2 then 10 else 0
        Err(_) => 11


[[test]]
fn test_repo_serves_lists_and_upgrades_legacy_pages() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var repo = wiki_page_repo_new()
    var raw: Db = db_empty()
    var rc: i32 = connect(@repo, @db)
    if rc == 0 and raw_connect(@raw, db.port) < 0
        rc = 1
    if rc == 0
        rc = check_legacy(@repo, @raw)
    live_db_stop(@db)
    rc


# ============================================================================
# Stores written before #3637 (AGAST #3681)
#
# Before #3637 every CONNECT name shared one collection, so a deployed store
# holds nexus's pages (and wiki-seed's) in what #3637 opens as the "default"
# collection. On its first dial the repository moves the pages there into
# "nexus_pages"; documents that aren't pages stay where they are.
#
# test/fixtures/store_v1_wiki was written by the pre-#3637 binaries: `mausoleum
# serve --data-dir`, `wiki-seed --seed` (welcome, getting-started, ritz,
# ritz/syntax, mausoleum), then `mausoleum shell` putting a store.ritz page
# "old-home" twice ("first draft", then "second draft") and one
# {kind: "session", token: "abc123"} document, and a clean shutdown.
# ============================================================================

const V1_WIKI: StrView = "test/fixtures/store_v1_wiki"
const V1_WIKI_PAGES: i64 = 6
# Its documents' ids, in insertion order: 0-4 wiki-seed's pages, 5 and 7
# old-home's copies, 6 the session.
const V1_FIRST_ID: i64 = 4294967297
const V1_DOCS: i64 = 8
const V1_SESSION: i64 = 6


# Default holds the session document and none of the pages. Checked by id,
# not by SCAN: a B-tree leaf the move's deletes empty ends a scan early
# (AGAST #3687), which would make "nothing left" pass for the wrong reason.
fn v1_default_has_only_the_session(legacy: *Db) -> bool
    var i: i64 = 0
    while i < V1_DOCS
        var data: *u8 = null
        var len: i32 = 0
        let found: i32 = db_get(legacy, V1_FIRST_ID + i, @data, @len)
        if found < 0 or (found == 1) != (i == V1_SESSION)
            return false
        i += 1
    true


# A raw connection to the default collection, where pre-#3637 documents are.
fn raw_connect_default(raw: *Db, port: i32) -> i32
    db_init(raw, c"127.0.0.1", 9, port, c"default", 7)
    db_set_encryption(raw, 0)
    db_connect(raw)


fn count_step(doc_id: i64, data: *u8, len: i32, user: *u8) -> i32
    let n: *i64 = user as *i64
    *n = *n + 1
    0


# How many documents `raw`'s collection holds, -1 if the scan failed.
fn doc_total(raw: *Db) -> i64
    var n: i64 = 0
    if db_scan(raw, count_step as *u8, @n as *u8) < 0
        return -1
    n


fn start_v1_wiki(db: *LiveDb) -> i32
    live_db_start_store(db, V1_WIKI)


# The fixture's pages, read through `repo`, are all there.
fn check_v1_pages(repo: *WikiPageRepository) -> i32
    if listed_count(repo) != V1_WIKI_PAGES
        return 20
    if not serves(repo, "old-home", "second draft")    # the newest copy
        return 21
    match wiki_page_repo_get_by_slug(repo, "ritz/syntax")
        Ok(got) =>
            let ok: bool = (got.title).eq("Ritz Syntax Guide")
            if not ok
                return 22
        Err(_) => return 23
    0


# Every page now lives in nexus_pages, one document per slug, and default
# keeps only the session document.
fn check_v1_moved(port: i32) -> i32
    var pages: Db = db_empty()
    var legacy: Db = db_empty()
    if raw_connect(@pages, port) < 0 or raw_connect_default(@legacy, port) < 0
        return 30
    if doc_total(@pages) != V1_WIKI_PAGES
        return 31
    if docs_for(@pages, "old-home") != 1
        return 32
    if not v1_default_has_only_the_session(@legacy)
        return 33
    db_close(@pages)
    db_close(@legacy)
    0


fn edit_page(repo: *WikiPageRepository, slug: StrView, content: StrView) -> i32
    match wiki_page_repo_get_by_slug(repo, slug)
        Ok(got) =>
            var page: WikiPage = got
            wiki_page_update_content(@page, string_from(content))
            var rc: i32 = 0
            match wiki_page_repo_update(repo, @page)
                Ok(_) => rc = 0
                Err(_) => rc = 1
            rc
        Err(_) => 2


fn check_v1_upgrade(db: *LiveDb) -> i32
    var repo = wiki_page_repo_new()
    if connect(@repo, db) != 0
        return 1
    var rc: i32 = check_v1_pages(@repo)
    if rc != 0
        return rc
    rc = check_v1_moved(db.port)
    if rc != 0
        return rc
    # Old pages edit like any other; new ones land in nexus_pages.
    if edit_page(@repo, "welcome", "edited after the upgrade") != 0
        return 40
    if insert_page(@repo, "fresh", "new after the upgrade") != 0
        return 41
    var pages: Db = db_empty()
    var legacy: Db = db_empty()
    if raw_connect(@pages, db.port) < 0 or raw_connect_default(@legacy, db.port) < 0
        return 42
    if docs_for(@pages, "fresh") != 1 or docs_for(@legacy, "fresh") != 0
        return 43
    if docs_for(@pages, "welcome") != 1
        return 44
    db_close(@pages)
    db_close(@legacy)
    wiki_page_repo_disconnect(@repo)

    # The move is durable: a restarted server serves the same wiki.
    if live_db_restart(db) != 0
        return 91
    var again = wiki_page_repo_new()
    if connect(@again, db) != 0
        return 50
    if listed_count(@again) != V1_WIKI_PAGES + 1
        return 51
    if not serves(@again, "welcome", "edited after the upgrade")
        return 52
    if not serves(@again, "old-home", "second draft")
        return 53
    wiki_page_repo_disconnect(@again)
    if raw_connect_default(@legacy, db.port) < 0
        return 54
    if v1_default_has_only_the_session(@legacy) then 0 else 55


[[test]]
fn test_repo_adopts_the_wiki_a_pre_3637_store_kept_in_default() -> i32
    var db: LiveDb
    if start_v1_wiki(@db) != 0
        live_db_remove_store(@db)
        return 90
    let rc: i32 = check_v1_upgrade(@db)
    live_db_remove_store(@db)
    rc


# Mausoleum down when nexus starts: the move happens on the first dial that
# reaches it, not at open.
[[test]]
fn test_repo_adopts_default_pages_when_mausoleum_comes_up_late() -> i32
    var db: LiveDb
    if start_v1_wiki(@db) != 0
        live_db_remove_store(@db)
        return 90
    live_db_stop(@db)
    var repo = wiki_page_repo_new()
    var rc: i32 = 0
    if wiki_page_repo_open(@repo, "127.0.0.1", db.port, false) >= 0
        rc = 1
    if rc == 0 and live_db_restart(@db) != 0
        rc = 91
    if rc == 0
        rc = check_v1_pages(@repo)
    if rc == 0
        rc = check_v1_moved(db.port)
    wiki_page_repo_disconnect(@repo)
    live_db_remove_store(@db)
    rc


fn check_keeps_current(a: *WikiPageRepository, b: *WikiPageRepository, db: *LiveDb) -> i32
    let port: i32 = db.port
    # b is up (and found default empty) before the stale copies appear, as
    # when another worker moved the pages and the page was edited since.
    if insert_page(b, "welcome", "current") != 0
        return 2
    var pages: Db = db_empty()
    var legacy: Db = db_empty()
    if raw_connect(@pages, port) < 0 or raw_connect_default(@legacy, port) < 0
        return 3
    if legacy_put(@legacy, "welcome", "stale") < 0 or legacy_put(@legacy, "other", "moved") < 0
        return 4
    if connect(a, db) != 0
        return 5
    if not serves(a, "welcome", "current")
        return 6
    if not serves(a, "other", "moved")
        return 7
    if docs_for(@pages, "welcome") != 1
        return 8
    if doc_total(@legacy) != 0 then 9 else 0


# A store.ritz page as long as one document holds: rewritten in the current
# format it no longer fits, so its move into nexus_pages is refused. Returns
# its id, < 0 if the server took no such page.
fn put_unmovable(raw: *Db) -> i64
    var buf: Vec<u8> = vec_with_cap<u8>(MAX_DOC_SIZE + 64)
    let content: String = big_string(MAX_DOC_SIZE)
    # The longest content whose document fits.
    var len: i64 = MAX_DOC_SIZE
    var n: i64 = -1
    while (n <= 0 or n > MAX_DOC_SIZE) and len > 0
        var fields: [2]DbField
        fields[0] = db_field(c"slug", 4, c"huge", 4)
        fields[1] = db_field(c"content", 7, content.as_view().ptr, len as i32)
        n = db_serialize_doc(buf.as_ptr(), MAX_DOC_SIZE + 64, @fields[0], 2)
        len -= 1
    var id: i64 = -1
    if n > 0 and n <= MAX_DOC_SIZE
        id = db_insert(raw, buf.as_ptr(), n as i32)
    id


fn check_cut_short(db: *LiveDb) -> i32
    var legacy: Db = db_empty()
    if raw_connect_default(@legacy, db.port) < 0
        return 1
    let huge: i64 = put_unmovable(@legacy)
    if huge < 0
        return 2
    var repo = wiki_page_repo_new()
    if connect(@repo, db) != 0
        return 3
    # The move failed, so default still has all its documents: the fixture's
    # eight and the huge page.
    if doc_total(@legacy) != 9
        return 4
    db_close(@legacy)
    # Mausoleum restarts without the page; the next dial finishes the move.
    if live_db_restart(db) != 0
        return 91
    if raw_connect_default(@legacy, db.port) < 0 or db_delete(@legacy, huge) < 0
        return 5
    db_close(@legacy)
    var rc: i32 = check_v1_pages(@repo)
    if rc == 0
        rc = check_v1_moved(db.port)
    wiki_page_repo_disconnect(@repo)
    rc


# A move that fails leaves default's pages there, and the next dial tries
# again.
[[test]]
fn test_repo_finishes_an_adoption_that_failed() -> i32
    var db: LiveDb
    if start_v1_wiki(@db) != 0
        live_db_remove_store(@db)
        return 90
    let rc: i32 = check_cut_short(@db)
    live_db_remove_store(@db)
    rc


# A slug nexus_pages already holds keeps its page there: default's copy is
# older (a crash between a move's copy and its cleanup, or two workers moving
# at once) and goes.
[[test]]
fn test_repo_adoption_keeps_the_page_nexus_pages_already_has() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var a = wiki_page_repo_new()
    var b = wiki_page_repo_new()
    var rc: i32 = connect(@b, @db)
    if rc == 0
        rc = check_keeps_current(@a, @b, @db)
    live_db_stop(@db)
    rc


# A moved page that is then deleted stays deleted for a worker that starts
# later: the move empties default of pages, so nothing brings it back.
[[test]]
fn test_repo_deleted_adopted_page_stays_deleted() -> i32
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var legacy: Db = db_empty()
    if raw_connect_default(@legacy, db.port) < 0
        live_db_stop(@db)
        return 1
    var rc: i32 = 0
    if legacy_put(@legacy, "gone", "soon") < 0
        rc = 2
    var a = wiki_page_repo_new()
    if rc == 0 and connect(@a, @db) != 0
        rc = 3
    if rc == 0 and not serves(@a, "gone", "soon")
        rc = 4
    if rc == 0
        match wiki_page_repo_delete_slug(@a, "gone")
            Ok(_) => pass
            Err(_) => rc = 5
    var c = wiki_page_repo_new()
    if rc == 0 and connect(@c, @db) != 0
        rc = 6
    if rc == 0
        match wiki_page_repo_get_by_slug(@c, "gone")
            Ok(_) => rc = 7
            Err(e) => rc = expect_not_found(@e)
    live_db_stop(@db)
    rc


# ============================================================================
# In memory: one worker with no database (the e2e's mode)
# ============================================================================

[[test]]
fn test_memory_repo_round_trips_pages() -> i32
    var repo = wiki_page_repo_new()
    wiki_page_repo_open_memory(@repo)
    if not wiki_page_repo_is_connected(@repo)
        return 1
    if insert_page(@repo, "one", "1") != 0
        return 2
    if insert_page(@repo, "two", "2") != 0
        return 3
    if not serves(@repo, "one", "1")
        return 4
    match wiki_page_repo_get_by_slug(@repo, "missing")
        Ok(_) => return 5
        Err(e) =>
            if expect_not_found(@e) != 0
                return 6
    if listed_count(@repo) != 2
        return 7
    match wiki_page_repo_get_by_slug(@repo, "two")
        Ok(got) =>
            var page: WikiPage = got
            wiki_page_update_content(@page, string_from("2b"))
            match wiki_page_repo_update(@repo, @page)
                Ok(_) => pass
                Err(_) => return 8
        Err(_) => return 9
    if not serves(@repo, "two", "2b")
        return 10
    if listed_count(@repo) != 2
        return 11
    match wiki_page_repo_delete_slug(@repo, "one")
        Ok(_) => pass
        Err(_) => return 12
    if listed_count(@repo) == 1 then 0 else 13


[[test]]
fn test_memory_repo_keeps_a_page_bigger_than_mausoleum_takes() -> i32
    # The repository stores what it's given; the 8192 limit is the service's
    # (wiki_page_repo_max_content_len), so this page is bigger than both.
    var repo = wiki_page_repo_new()
    wiki_page_repo_open_memory(@repo)
    var page = wiki_page_new(string_from("big"), string_from("Big"), big_string(100000))
    match wiki_page_repo_insert(@repo, @page)
        Ok(_) => pass
        Err(_) => return 1
    match wiki_page_repo_get_by_slug(@repo, "big")
        Ok(got) => if (got.content).len() == 100000 then 0 else 2
        Err(_) => 3


# The longest content each backend takes (#2208's limits, AGAST #2209): one
# mausoleum document's worth on Mausoleum, the in-memory store's own 8192
# (the e2e's max-size page) in memory.
[[test]]
fn test_repo_max_content_len_follows_the_backend() -> i32
    if MEMORY_MAX_CONTENT_LEN != 8192
        return 1
    var repo = wiki_page_repo_new()
    if wiki_page_repo_max_content_len(@repo) != MAX_CONTENT_SIZE
        return 2
    wiki_page_repo_open_memory(@repo)
    if wiki_page_repo_max_content_len(@repo) != MEMORY_MAX_CONTENT_LEN
        return 3
    wiki_page_repo_disconnect(@repo)
    var db: LiveDb
    if live_db_start(@db) != 0
        return 90
    var rc: i32 = connect(@repo, @db)
    if rc == 0 and wiki_page_repo_max_content_len(@repo) != MAX_CONTENT_SIZE
        rc = 4
    wiki_page_repo_disconnect(@repo)
    live_db_stop(@db)
    rc
