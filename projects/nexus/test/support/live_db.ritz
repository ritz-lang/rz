# test/support/live_db.ritz - a real Mausoleum server for nexus's tests
#
# Forks a child running mausoleum's own async server loop (the default
# `mausoleum serve --no-encryption` path) with an in-memory collection, so the
# repository tests exercise the real wire protocol and the server's document
# validation rather than a fake. It is hosted in-process because `rz test
# nexus` does not build the mausoleum binary.
#
# Each test starts its own server, so every test sees an empty collection,
# unless it starts one on a copy of a data directory (live_db_start_store):
# then the server opens it as `mausoleum serve --data-dir` would.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.net
import ritzlib.option
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new }
import ritzlib.span { Span }
import ritzlib.fd { fd_open, O_RDWR }
import ritzlib.fs { copy_file, path_join, mkdir, remove_dir_all }
import ritzlib.process { fork, try_wait_pid, wait_pid, kill, process_id }
import ritzlib.time { sleep_ms }

import mausoleum.buffer_pool
import mausoleum.collection { Collection, collection_empty, collection_init, collection_open_storage }
import mausoleum.storage { Storage, storage_open, storage_pool }
import mausoleum.m7m_types { DEFAULT_COLLECTION_ID }
import ritzlib.box
import mausoleum.client { Client, client_new, client_free, client_connect, client_disconnect }
import mausoleum.server_async { serve_async }

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const POOL_FRAMES: i32 = 1024
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9

var g_next_offset: i32 = 0


pub struct LiveDb
    pid: i32
    port: i32
    has_dir: bool       # serving the data directory `dir`, not memory
    dir: [128]u8        # dir_len bytes; live_db_dir views them
    dir_len: i64


# Bind `sock` to 0.0.0.0:`port`.
fn bind_any(sock: @&Socket, port: i32) -> bool
    match sock.bind("0.0.0.0", port)
        Ok(_) => true
        Err(_) => false

fn listen_ok(sock: @&Socket) -> bool
    match sock.listen(128)
        Ok(_) => true
        Err(_) => false


# Point the child's stdin, stdout and stderr at /dev/null (left open: the
# child serves until killed).
fn quiet_stdio()
    match fd_open("/dev/null", O_RDWR, 0)
        Ok(devnull) =>
            devnull.dup_to(0)
            devnull.dup_to(1)
            devnull.dup_to(2)
        Err(_) => pass


# The child: serve an empty in-memory collection until killed.
fn serve_forever(port: i32)
    syscall2(SYS_PRCTL, PR_SET_PDEATHSIG, SIG_KILL as i64)
    quiet_stdio()

    var pool_owner: Box<BufferPool> = box_empty<BufferPool>()
    match buffer_pool_new(POOL_FRAMES)
        Some(p) => pool_owner = box_new<BufferPool>(p)
        None => sys_exit(2)
    let pool: *BufferPool = pool_owner.as_ptr()

    var collection: Collection = collection_empty()
    if collection_init(@collection, pool, 1) < 0
        sys_exit(3)

    var sock: Socket
    match socket_tcp_nonblock()
        Ok(s) => sock = s
        Err(_) => sys_exit(4)
    sock.set_reuseaddr()
    if not bind_any(@&sock, port)
        sys_exit(5)
    if not listen_ok(@&sock)
        sys_exit(6)

    serve_async(sock.fd, pool, null, @collection)
    sys_exit(0)


# The child: serve the data directory `dir` until killed.
fn serve_store_forever(port: i32, dir: StrView)
    syscall2(SYS_PRCTL, PR_SET_PDEATHSIG, SIG_KILL as i64)
    quiet_stdio()

    var storage_owner: Box<Storage> = box_empty<Storage>()
    match storage_open(dir)
        Some(s) => storage_owner = s
        None => sys_exit(2)
    let storage: *Storage = storage_owner.as_ptr()
    let pool: *BufferPool = storage_pool(storage)

    var collection: Collection = collection_empty()
    if collection_open_storage(@collection, storage, DEFAULT_COLLECTION_ID) < 0
        sys_exit(3)

    var sock: Socket
    match socket_tcp_nonblock()
        Ok(s) => sock = s
        Err(_) => sys_exit(4)
    sock.set_reuseaddr()
    if not bind_any(@&sock, port)
        sys_exit(5)
    if not listen_ok(@&sock)
        sys_exit(6)

    serve_async(sock.fd, pool, storage, @collection)
    sys_exit(0)


fn serve_child(db: *LiveDb, port: i32)
    if db.has_dir
        serve_store_forever(port, live_db_dir(db))
    else
        serve_forever(port)


# 1 if the child already exited (and was reaped), else 0.
fn exited(pid: i32) -> i32
    match try_wait_pid(pid)
        Ok(done) =>
            match done
                Some(_) => return 1
                None => return 0
        Err(_) => return 0


# Poll until the server completes a real handshake.
# 0 = ready, 1 = child exited (port taken: try another), 2 = timed out.
fn wait_ready(db: *LiveDb) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if exited(db.pid) == 1
            db.pid = 0
            return 1
        var probe_owner: Box<Client> = client_new()
        let probe: *Client = probe_owner.as_ptr()
        if probe != null
            if client_connect(probe, "127.0.0.1", db.port, "probe") == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2


# Start a server. Returns 0 once it accepts connections, < 0 if it never did.
pub fn live_db_start(db: *LiveDb) -> i32
    db.has_dir = false
    db.dir_len = 0
    live_db_serve(db)


# Fork servers on fresh ports until one accepts connections.
fn live_db_serve(db: *LiveDb) -> i32
    db.pid = 0
    db.port = 0
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        g_next_offset += 1
        let port: i32 = PORT_BASE + ((process_id() * 37 + g_next_offset) % PORT_SPAN)
        var pid: i32 = 0
        match fork()
            Ok(side) =>
                match side
                    Child =>
                        serve_child(db, port)
                        sys_exit(1)
                    Parent(child) => pid = child
            Err(_) => return -1
        db.pid = pid
        db.port = port
        let state: i32 = wait_ready(db)
        if state == 0
            return 0
        if state == 2
            live_db_stop(db)
            return -2
        attempt += 1
    return -3


# Start a fresh server on the port `db` last used (after live_db_stop), as a
# restarted database would come back: empty, or on the same data directory. Returns 0 once it
# accepts connections, < 0 if it never did.
pub fn live_db_restart(db: *LiveDb) -> i32
    live_db_stop(db)
    let port: i32 = db.port
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        var pid: i32 = 0
        match fork()
            Ok(side) =>
                match side
                    Child =>
                        serve_child(db, port)
                        sys_exit(1)
                    Parent(child) => pid = child
            Err(_) => return -1
        db.pid = pid
        db.port = port
        let state: i32 = wait_ready(db)
        if state == 0
            return 0
        if state == 2
            live_db_stop(db)
            return -2
        sleep_ms(100)     # the old socket may still hold the port
        attempt += 1
    return -3


# Kill and reap the server. Safe to call on a server that failed to start.
pub fn live_db_stop(db: *LiveDb)
    if db.pid <= 0
        return
    kill(db.pid, SIG_KILL)
    wait_pid(db.pid)
    db.pid = 0


# ============================================================================
# A server on a data directory
# ============================================================================

# Copy <src_dir>/<name> to <dst_dir>/<name> (mode 0644). 0 = ok.
fn copy_into(src_dir: StrView, dst_dir: StrView, name: StrView) -> i32
    var src: String = path_join(src_dir, name)
    var dst: String = path_join(dst_dir, name)
    var rc: i32 = 0
    match copy_file(src.as_view(), dst.as_view(), 420)
        Ok(_) => pass
        Err(_) => rc = 1
    src.deinit()
    dst.deinit()
    rc


# The data directory, a view of the LiveDb's own bytes.
fn live_db_dir(db: *LiveDb) -> StrView
    let dir: [u8] = @db.dir
    dir.to(db.dir_len).as_strview()


# Remove the data directory and everything in it (absent is fine).
fn rm_dir(dir: StrView)
    remove_dir_all(dir)


# Start a server on a copy of the data directory `fixture` (meta.m7m,
# data.m7m and wal.wal.000000, as a stopped `mausoleum serve --data-dir`
# leaves them), made under /tmp. Returns 0 once it accepts connections, < 0
# if it never did. live_db_remove_store deletes the copy.
pub fn live_db_start_store(db: *LiveDb, fixture: StrView) -> i32
    g_next_offset += 1
    let pid: i32 = process_id()
    let seq: i32 = g_next_offset
    var name: String = string_new()
    format_into(@&name, "/tmp/nexus_live_db_{pid}_{seq}")
    var dir_buf: Span<u8> = @db.dir
    db.dir_len = dir_buf.copy_from(name.as_view().as_bytes())
    db.has_dir = true
    db.pid = 0
    let dir: StrView = live_db_dir(db)
    rm_dir(dir)
    match mkdir(dir, 493)
        Ok(_) => pass
        Err(_) => return -10
    if copy_into(fixture, dir, "meta.m7m") != 0
        return -11
    if copy_into(fixture, dir, "data.m7m") != 0
        return -12
    if copy_into(fixture, dir, "wal.wal.000000") != 0
        return -13
    live_db_serve(db)


# Stop the server and delete its data directory (live_db_start_store's copy).
pub fn live_db_remove_store(db: *LiveDb)
    live_db_stop(db)
    if db.has_dir
        rm_dir(live_db_dir(db))
        db.has_dir = false
