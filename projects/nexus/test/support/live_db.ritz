# test/support/live_db.ritz - a real Mausoleum server for nexus's tests
#
# Forks a child running mausoleum's own async server loop (the default
# `mausoleum serve --no-encryption` path) with an in-memory collection, so the
# repository tests exercise the real wire protocol and the server's document
# validation rather than a fake. It is hosted in-process because `rz test
# nexus` does not build the mausoleum binary.
#
# Each test starts its own server, so every test sees an empty collection.

import ritzlib.sys
import ritzlib.net
import ritzlib.option

import mausoleum.buffer_pool
import mausoleum.collection { Collection, collection_init }
import mausoleum.client { Client, client_new, client_free, client_connect, client_disconnect }
import mausoleum.server_async { serve_async }

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const POOL_FRAMES: i32 = 1024
const SYS_PRCTL_NR: i64 = 157
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9
const WAIT_NOHANG: i32 = 1

var g_next_offset: i32 = 0


pub struct LiveDb
    pid: i32
    port: i32


fn sleep_ms(ms: i64)
    var ts: [2]i64
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    sys_nanosleep(@ts[0], null)


# The child: serve an empty in-memory collection until killed.
fn serve_forever(port: i32)
    syscall2(SYS_PRCTL_NR, PR_SET_PDEATHSIG, SIG_KILL as i64)
    let devnull: i32 = sys_open(c"/dev/null", 2)   # O_RDWR
    if devnull >= 0
        sys_dup2(devnull, 0)
        sys_dup2(devnull, 1)
        sys_dup2(devnull, 2)

    let pool_opt = buffer_pool_new(POOL_FRAMES)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        sys_exit(2)
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    var collection: Collection
    if collection_init(@collection, pool, 1) < 0
        sys_exit(3)

    var sock: Socket = socket_tcp_nonblock()
    if sock.fd < 0
        sys_exit(4)
    socket_set_reuseaddr(@sock)
    if socket_bind_any(@sock, port) < 0
        sys_exit(5)
    if socket_listen(@sock, 128) < 0
        sys_exit(6)

    serve_async(sock.fd, pool, null, @collection)
    sys_exit(0)


# 1 if the child already exited (and was reaped), else 0.
fn exited(pid: i32) -> i32
    var status: i32 = 0
    if sys_wait4(pid, @status, WAIT_NOHANG, null) == pid
        return 1
    return 0


# Poll until the server completes a real handshake.
# 0 = ready, 1 = child exited (port taken: try another), 2 = timed out.
fn wait_ready(db: *LiveDb) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if exited(db.pid) == 1
            db.pid = 0
            return 1
        let probe: *Client = client_new()
        if probe != null
            if client_connect(probe, c"127.0.0.1", db.port, c"probe", 5) == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2


# Start a server. Returns 0 once it accepts connections, < 0 if it never did.
pub fn live_db_start(db: *LiveDb) -> i32
    db.pid = 0
    db.port = 0
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        g_next_offset += 1
        let port: i32 = PORT_BASE + ((sys_getpid() * 37 + g_next_offset) % PORT_SPAN)
        let pid: i32 = sys_fork()
        if pid < 0
            return -1
        if pid == 0
            serve_forever(port)
            sys_exit(1)
        db.pid = pid
        db.port = port
        let state: i32 = wait_ready(db)
        if state == 0
            return 0
        if state == 2
            live_db_stop(db)
            return -2
        attempt += 1
    return -3


# Kill and reap the server. Safe to call on a server that failed to start.
pub fn live_db_stop(db: *LiveDb)
    if db.pid <= 0
        return
    sys_kill(db.pid, SIG_KILL)
    var status: i32 = 0
    sys_wait4(db.pid, @status, 0, null)
    db.pid = 0
