# test/test_services.ritz - Service layer tests
#
# Tests for WikiService business logic, including slug validation.

import services.validation {
    validate_slug,
    validate_title,
    validate_content,
    validate_content_within,
    MAX_CONTENT_SIZE
}
import ritzlib.string { String, string_new }
import errors.service_error { ServiceError }


# Nested variant patterns (`Err(ServiceError.InvalidSlug(_))`) are not
# supported, so a test matches `Err(e)` and checks the variant here.
# 0 = the expected variant, 1 = any other error.
fn expect_invalid_slug(e: @ServiceError) -> i32
    match *e
        ServiceError.InvalidSlug(_) => 0
        _ => 1


fn expect_invalid_title(e: @ServiceError) -> i32
    match *e
        ServiceError.InvalidTitle => 0
        _ => 1


# ============================================================================
# Slug validation tests
# ============================================================================

[[test]]
fn test_valid_slug_simple() -> i32
    match validate_slug("hello")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_with_hyphen() -> i32
    match validate_slug("hello-world")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_with_numbers() -> i32
    match validate_slug("chapter1")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_hierarchical() -> i32
    match validate_slug("language/syntax")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_deep_hierarchy() -> i32
    match validate_slug("stdlib/io/file")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_invalid_slug_empty() -> i32
    match validate_slug("")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


# The service and the routes share one rule (src/slug.ritz, AGAST #2209),
# which has no leading-letter requirement: the routes always took "2026-plan".
[[test]]
fn test_valid_slug_starts_with_number() -> i32
    match validate_slug("1chapter")
        Ok(_) => 0
        Err(_) => 1


# Upper case is refused, as the routes refuse it: one page per name.
[[test]]
fn test_invalid_slug_upper_case() -> i32
    match validate_slug("Language/Syntax")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


# A slug the routes can't reach is refused, so no page is created that can
# never be viewed.
[[test]]
fn test_invalid_slug_reserved_route_word() -> i32
    match validate_slug("new")
        Ok(_) => return 1
        Err(e) =>
            if expect_invalid_slug(@e) != 0
                return 2
    match validate_slug("language/edit")
        Ok(_) => 3
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_ends_with_slash() -> i32
    match validate_slug("language/")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_double_slash() -> i32
    match validate_slug("language//syntax")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_special_chars() -> i32
    match validate_slug("hello@world")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_spaces() -> i32
    match validate_slug("hello world")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_slug_length_limit() -> i32
    # 128 bytes (MAX_SLUG_LENGTH) is accepted, 129 is not
    let at_limit = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwx"
    let over_limit = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxy"
    match validate_slug(at_limit)
        Ok(_) => pass
        Err(_) => return 1
    match validate_slug(over_limit)
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


# ============================================================================
# Title validation tests
# ============================================================================

[[test]]
fn test_valid_title() -> i32
    match validate_title("Hello World")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_invalid_title_empty() -> i32
    match validate_title("")
        Ok(_) => 1
        Err(e) => expect_invalid_title(@e)


# ============================================================================
# Content validation tests
# ============================================================================

[[test]]
fn test_valid_content() -> i32
    match validate_content("# Hello\n\nThis is content.")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_content_empty() -> i32
    # Empty content is allowed
    match validate_content("")
        Ok(_) => 0
        Err(_) => 1


# ============================================================================
# Content size limit (AGAST #2208)
# ============================================================================

fn content_of(n: i64) -> String
    var s: String = string_new()
    var i: i64 = 0
    while i < n
        s.push('x' as u8)
        i += 1
    s


# What mausoleum can store, not 1 MB (see test_repos for where it comes
# from): room for the longest wiki pages (14.5 KB), not one 2 KB document
# (AGAST #3638).
[[test]]
fn test_content_at_the_limit_is_valid() -> i32
    if MAX_CONTENT_SIZE < 16384 or MAX_CONTENT_SIZE >= 32768
        return 1
    let c = content_of(MAX_CONTENT_SIZE)
    match validate_content(c.as_view())
        Ok(_) => 0
        Err(_) => 2


[[test]]
fn test_content_one_over_the_limit_is_too_large() -> i32
    let c = content_of(MAX_CONTENT_SIZE + 1)
    match validate_content(c.as_view())
        Ok(_) => 1
        Err(e) =>
            match e
                ServiceError.ContentTooLarge => 0
                _ => 2


# The limit is the store's: the in-memory store holds more than one mausoleum
# document (AGAST #2209 carries #2208's fallback limit into the repository).
[[test]]
fn test_content_within_a_given_limit() -> i32
    let c = content_of(MAX_CONTENT_SIZE + 1)
    match validate_content_within(c.as_view(), MAX_CONTENT_SIZE + 1)
        Ok(_) => pass
        Err(_) => return 1
    match validate_content_within(c.as_view(), MAX_CONTENT_SIZE)
        Ok(_) => return 2
        Err(e) =>
            match e
                ServiceError.ContentTooLarge => 0
                _ => 3
