# test/test_services.ritz - Service layer tests
#
# Tests for WikiService business logic, including slug validation.

import services.validation {
    validate_slug,
    validate_title,
    validate_content
}
import errors.service_error { ServiceError }


# Nested variant patterns (`Err(ServiceError.InvalidSlug(_))`) are not
# supported, so a test matches `Err(e)` and checks the variant here.
# 0 = the expected variant, 1 = any other error.
fn expect_invalid_slug(e: @ServiceError) -> i32
    match *e
        ServiceError.InvalidSlug(_) => 0
        _ => 1


fn expect_invalid_title(e: @ServiceError) -> i32
    match *e
        ServiceError.InvalidTitle => 0
        _ => 1


# ============================================================================
# Slug validation tests
# ============================================================================

[[test]]
fn test_valid_slug_simple() -> i32
    match validate_slug("hello")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_with_hyphen() -> i32
    match validate_slug("hello-world")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_with_numbers() -> i32
    match validate_slug("chapter1")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_hierarchical() -> i32
    match validate_slug("language/syntax")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_slug_deep_hierarchy() -> i32
    match validate_slug("stdlib/io/file")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_invalid_slug_empty() -> i32
    match validate_slug("")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_starts_with_number() -> i32
    match validate_slug("1chapter")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_ends_with_slash() -> i32
    match validate_slug("language/")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_double_slash() -> i32
    match validate_slug("language//syntax")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_special_chars() -> i32
    match validate_slug("hello@world")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_invalid_slug_spaces() -> i32
    match validate_slug("hello world")
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


[[test]]
fn test_slug_length_limit() -> i32
    # 128 bytes (MAX_SLUG_LENGTH) is accepted, 129 is not
    let at_limit = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwx"
    let over_limit = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxy"
    match validate_slug(at_limit)
        Ok(_) => 0
        Err(_) => return 1
    match validate_slug(over_limit)
        Ok(_) => 1
        Err(e) => expect_invalid_slug(@e)


# ============================================================================
# Title validation tests
# ============================================================================

[[test]]
fn test_valid_title() -> i32
    match validate_title("Hello World")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_invalid_title_empty() -> i32
    match validate_title("")
        Ok(_) => 1
        Err(e) => expect_invalid_title(@e)


# ============================================================================
# Content validation tests
# ============================================================================

[[test]]
fn test_valid_content() -> i32
    match validate_content("# Hello\n\nThis is content.")
        Ok(_) => 0
        Err(_) => 1


[[test]]
fn test_valid_content_empty() -> i32
    # Empty content is allowed
    match validate_content("")
        Ok(_) => 0
        Err(_) => 1
