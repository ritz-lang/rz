# src/main.ritz - Nexus Wiki Application (Zeus Worker)
#
# A wiki built on the Ritz stack as a Zeus worker process:
# - zeus: Zero-copy IPC with Valet HTTP server
# - mausoleum: Document database (src/repos), or memory for a lone worker
#   with no database (src/wiki_app.ritz)
#
# This binary is spawned by Zeus daemon and communicates via shared memory.
#
# Each route is a thin adapter (AGAST #2209): parse the request, call a
# transport-neutral presenter (src/presenters/page_presenter.ritz) that runs
# it through the wiki service and renders the page, then send its status and
# body. STATUS_SAVED means the save worked: send the 303 to the page.
#
# Usage (spawned by zeus):
#   nexus <shm_size> <worker_id>
#
# Environment:
#   - fd 3 is the shared memory file descriptor
#
# Routes:
#   GET /           - Home page (list of pages)
#   GET /health     - Health check
#   GET /wiki/:slug - View a wiki page (slugs may be nested: a/b/c)
#   GET /wiki/:slug/edit - Edit form
#   POST /wiki/:slug - Save changes (creates the page if it is new)
#   GET /wiki/new   - Create new page form
#   POST /wiki      - Create new page (409 if the slug is taken)

import ritzlib.sys
import ritzlib.fmt
import ritzlib.str
import ritzlib.memory
import ritzlib.strview { StrView, strview_from_ptr }
import ritzlib.string { String, string_new }
import ritzlib.gvec { Vec, vec_new }

import zeus.worker { WorkerContext }
import zeus.worker { worker_init, worker_destroy }
import zeus.worker { worker_set_running, worker_set_busy }
import zeus.worker { worker_poll_request, worker_wait_request, worker_ack_request }
import zeus.worker { worker_begin_response, worker_commit_response, worker_wait_response_slot }
import zeus.worker { worker_get_request_path, worker_get_request_body }
import zeus.worker { worker_alloc_response_data, worker_ptr_to_offset }
import zeus.ring { RequestSlot, ResponseSlot }
import zeus.ring { HTTP_METHOD_GET, HTTP_METHOD_POST }
import zeus.ring { response_slot_set_status, response_slot_set_flags }
import zeus.ring { response_slot_set_body, response_slot_set_headers }
import zeus.ring { RESP_FLAG_COMPLETE }

import src.log { log_set_worker, log_begin, log_end, log_cstr }
import src.slug { slug_valid, slug_from_path }
import src.pages { render_new_page, render_error_page }
import src.pages { push_headers, push_redirect_to_page }

import store_config { StoreConfig, store_config_from_env }
import wiki_app { APP_UNAVAILABLE, wiki_app_open, wiki_app_seed }
import repos.wiki_page_repo { WikiPageRepository, wiki_page_repo_new, wiki_page_repo_disconnect }
import repos.page_cache { PageCache, page_cache_new }
import services.wiki_service { WikiService, wiki_service_new }
import presenters.page_presenter { STATUS_SAVED, present_index, present_page_view, present_page_edit }
import presenters.page_presenter { present_page_save, present_page_create }


# ============================================================================
# Constants
# ============================================================================

const SHM_FD: i32 = 3  # Zeus always passes shm fd as fd 3


# ============================================================================
# The wiki: one repository, cache and service per worker process
#
# The cache is never connected, so every read goes to the repository. It is
# per-process (embedded Tome), and zeus runs several workers: a page cached
# by one would go stale when another saved it (AGAST #2459).
# ============================================================================

# WikiPageRepository owns a Vec (through MemDocs), so it has drop glue and a
# module-level value is never dropped.  Keep it in raw memory instead: it is
# allocated once in main and lives for the process.
var g_repo: *WikiPageRepository = null
var g_cache: *PageCache = null
var g_svc: WikiService


# ============================================================================
# Print Helpers (using ritzlib)
# ============================================================================

# Using ritzlib.fmt: print is the interpolating builtin


# ============================================================================
# Form Parsing
# ============================================================================

fn url_decode(buf: *u8, len: i32) -> i32
    var read: i32 = 0
    var write: i32 = 0

    while read < len
        let c: u8 = *(buf + read)
        if c == '+'
            *(buf + write) = ' '
            read += 1
            write += 1
        else if c == '%' and read + 2 < len
            let h1: u8 = *(buf + read + 1)
            let h2: u8 = *(buf + read + 2)
            var val: u8 = 0

            if h1 >= '0' and h1 <= '9'
                val = (h1 - '0') << 4
            else if h1 >= 'A' and h1 <= 'F'
                val = (h1 - 'A' + 10) << 4
            else if h1 >= 'a' and h1 <= 'f'
                val = (h1 - 'a' + 10) << 4

            if h2 >= '0' and h2 <= '9'
                val = val | (h2 - '0')
            else if h2 >= 'A' and h2 <= 'F'
                val = val | (h2 - 'A' + 10)
            else if h2 >= 'a' and h2 <= 'f'
                val = val | (h2 - 'a' + 10)

            *(buf + write) = val
            read += 3
            write += 1
        else
            *(buf + write) = c
            read += 1
            write += 1

    return write


fn parse_form_field(body: *u8, body_len: i32, field: *u8, value_out: *u8, max_len: i32) -> i32
    let field_len: i32 = strlen(field) as i32

    var pos: i32 = 0
    while pos < body_len
        var found: i32 = 1
        if pos + field_len + 1 > body_len
            found = 0
        else
            for i in 0..field_len
                if *(body + pos + i) != *(field + i)
                    found = 0
                    break
            if found == 1 and *(body + pos + field_len) != '='
                found = 0

        if found == 1
            var start: i32 = pos + field_len + 1
            var end: i32 = start

            while end < body_len and *(body + end) != '&'
                end += 1

            var value_len: i32 = end - start
            if value_len > max_len
                value_len = max_len

            for i in 0..value_len
                *(value_out + i) = *(body + start + i)

            return url_decode(value_out, value_len)

        while pos < body_len and *(body + pos) != '&'
            pos += 1
        pos += 1

    return -1


# ============================================================================
# Response plumbing
#
# Pages and headers are rendered into growable Strings (src/pages.ritz), then
# copied once into the worker's response arena.  No response is ever built in
# a fixed-size buffer (AGAST #1870).
# ============================================================================

# Copy `len` bytes into a fresh arena block; null if the arena is full.
fn arena_copy(ctx: *WorkerContext, src: *u8, len: i64) -> *u8
    let dst: *u8 = worker_alloc_response_data(ctx, len)
    if dst != null
        memcpy(dst, src, len)
    return dst


# Commit `headers` + `body` (either may be empty) as the response.  If the
# arena cannot hold them, or the headers overflow the slot's u16 length, the
# response degrades to a bare 500 with no body rather than a truncated page.
fn send_raw(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, headers: @&String, body: @&String) -> i32
    let headers_len: i64 = headers.len()
    let body_len: i64 = body.len()
    var h: *u8 = null
    var b: *u8 = null
    var ok: i32 = 1
    if headers_len > 65535 or body_len > 4294967295
        ok = 0
    if ok == 1
        h = arena_copy(ctx, headers.as_ptr(), headers_len)
        if h == null
            ok = 0
    if ok == 1 and body_len > 0
        b = arena_copy(ctx, body.as_ptr(), body_len)
        if b == null
            ok = 0

    if ok == 0
        response_slot_set_status(resp, 500)
        response_slot_set_headers(resp, 0, 0)
        response_slot_set_body(resp, 0, 0)
        response_slot_set_flags(resp, RESP_FLAG_COMPLETE)
        return -1

    response_slot_set_status(resp, status as u16)
    response_slot_set_headers(resp, worker_ptr_to_offset(ctx, h) as u32, headers_len as u16)
    if b == null
        response_slot_set_body(resp, 0, 0)
    else
        response_slot_set_body(resp, worker_ptr_to_offset(ctx, b) as u32, body_len as u32)
    response_slot_set_flags(resp, RESP_FLAG_COMPLETE)
    return 0


# Send `body` with status and content type, then free it.
fn send_body(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, content_type: *u8, body: @&String) -> i32
    var headers: String = string_new()
    push_headers(@&headers, status, content_type, body.len())
    let rc: i32 = send_raw(ctx, resp, status, @&headers, body)
    return rc


fn send_text(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, text: *u8) -> i32
    var body: String = string_new()
    body.push_cstr(text)
    return send_body(ctx, resp, status, c"text/plain", @&body)


# 303 to /wiki/<slug>; the slug must already be validated.
fn send_redirect(ctx: *WorkerContext, resp: *ResponseSlot, slug: StrView) -> i32
    var headers: String = string_new()
    var body: String = string_new()
    push_redirect_to_page(@&headers, slug)
    let rc: i32 = send_raw(ctx, resp, 303, @&headers, @&body)
    return rc


# A styled HTML error page.  `title` and `message` are literals.
fn send_error_page(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, title: *u8, message: *u8) -> i32
    var body: String = string_new()
    render_error_page(@&body, title, message)
    return send_body(ctx, resp, status, c"text/html; charset=utf-8", @&body)


fn send_html(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, body: @&String) -> i32
    return send_body(ctx, resp, status, c"text/html; charset=utf-8", body)


# A presenter's outcome: STATUS_SAVED is the 303 to the saved page (its body
# is empty), anything else is `body` with that status.
fn send_presented(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, body: @&String, slug: StrView) -> i32
    if status == STATUS_SAVED
        return send_redirect(ctx, resp, slug)
    return send_html(ctx, resp, status, body)


# Form field `name` of the request body, URL-decoded into `buf` (grown to
# the body's size: no field can be longer).  Returns a view of it in `buf`,
# or None if the field is absent.
fn form_field(body: StrView, name: *u8, buf: @&Vec<u8>) -> Option<StrView>
    let cap: i32 = body.len as i32
    if not buf.ensure_cap(body.len)
        return None
    let n: i32 = parse_form_field(body.ptr, cap, name, buf.as_ptr(), cap)
    if n < 0
        return None
    Some(strview_from_ptr(buf.as_ptr(), n as i64))


# The request's path.  Views into it (the slug) live as long as the request.
fn request_path(ctx: *WorkerContext, req: *RequestSlot) -> StrView
    return strview_from_ptr(worker_get_request_path(ctx, req), req.path_len as i64)


# ============================================================================
# Handlers
# ============================================================================

fn handle_index(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    var body: String = string_new()
    let status: i32 = present_index(@g_svc, @&body)
    return send_html(ctx, resp, status, @&body)


fn handle_health(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    return send_text(ctx, resp, 200, c"OK")


fn handle_not_found(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    return send_text(ctx, resp, 404, c"404 Not Found")


# GET /wiki/:slug - View a wiki page
#
# A slug outside the slug rule (src/slug.ritz) is a plain 404; a valid slug
# with no page gets a styled 404 offering to create it; mausoleum down is a
# 503 (src/presenters/page_presenter.ritz).
fn handle_wiki_view(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let slug: StrView = slug_from_path(request_path(ctx, req))
    if slug.is_empty()
        return handle_not_found(ctx, req, resp)

    var body: String = string_new()
    let status: i32 = present_page_view(@g_svc, slug, @&body)
    return send_html(ctx, resp, status, @&body)


fn handle_wiki_new(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    var body: String = string_new()
    render_new_page(@&body)
    return send_html(ctx, resp, 200, @&body)


# POST /wiki - Create a new wiki page from form data.
#
# Body shape: application/x-www-form-urlencoded with fields `slug` and
# `content`, both URL-decoded by parse_form_field.  The slug must follow the
# slug rule; content is capped by the service (services/validation).  A slug
# that already has a page is a 409 rather than a silent overwrite — use POST
# /wiki/:slug for explicit updates.  On success we 303-redirect to the new
# page so the browser ends up on a GET.  The page's title is its slug.
fn handle_wiki_create(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let body_ptr: *u8 = worker_get_request_body(ctx, req)
    let body_len: i32 = req.body_len as i32
    if body_len <= 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Empty request body.")

    let body: StrView = strview_from_ptr(body_ptr, body_len as i64)
    var slug_buf: Vec<u8> = vec_new<u8>()
    var slug_view: StrView
    match form_field(body, c"slug", @&slug_buf)
        Some(v) => slug_view = v
        None => return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'slug' field.")
    if not slug_valid(slug_view)
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Slug must be 1-128 chars of [a-z], [0-9] or '-', in segments separated by '/'.")

    var content_buf: Vec<u8> = vec_new<u8>()
    var content: StrView
    match form_field(body, c"content", @&content_buf)
        Some(v) => content = v
        None => return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'content' field.")

    var page: String = string_new()
    let status: i32 = present_page_create(@g_svc, slug_view, slug_view, content, @&page)
    return send_presented(ctx, resp, status, @&page, slug_view)


# POST /wiki/:slug - Update a page, creating it if it is new.
#
# Body shape: same as create but only `content` is read; the slug comes from
# the URL.  Replaying it overwrites with the same bytes.
fn handle_wiki_update(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let slug_view: StrView = slug_from_path(request_path(ctx, req))
    if slug_view.is_empty()
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Slug must be 1-128 chars of [a-z], [0-9] or '-', in segments separated by '/'.")

    let body_ptr: *u8 = worker_get_request_body(ctx, req)
    let body_len: i32 = req.body_len as i32
    if body_len <= 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Empty request body.")

    var content_buf: Vec<u8> = vec_new<u8>()
    var content: StrView
    match form_field(strview_from_ptr(body_ptr, body_len as i64), c"content", @&content_buf)
        Some(v) => content = v
        None => return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'content' field.")

    var page: String = string_new()
    let status: i32 = present_page_save(@g_svc, slug_view, slug_view, content, @&page)
    return send_presented(ctx, resp, status, @&page, slug_view)


# GET /wiki/:slug/edit - the edit form pre-populated with the current page
# content; for a slug with no page yet, the new-page form.  An invalid slug is
# a plain 404.
fn handle_wiki_edit_form(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let slug: StrView = slug_from_path(request_path(ctx, req))
    if slug.is_empty()
        return handle_not_found(ctx, req, resp)

    var body: String = string_new()
    let status: i32 = present_page_edit(@g_svc, slug, @&body)
    return send_html(ctx, resp, status, @&body)


# Detect the trailing "/edit" suffix for a /wiki/:slug/edit GET.  We
# match exactly five trailing bytes so /wiki/foo-edit-pet still routes
# to the page view, not the edit form.
fn path_ends_with_edit(path: StrView) -> bool
    # /wiki/x/edit is the shortest edit route.
    path.len() >= 11 and path.ends_with("/edit")


# ============================================================================
# Router
# ============================================================================

fn route_request(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let path: StrView = request_path(ctx, req)
    let method: u8 = req.method

    # GET /
    if method == HTTP_METHOD_GET and path.eq("/")
        return handle_index(ctx, req, resp)

    # GET /health
    if method == HTTP_METHOD_GET and path.starts_with("/health")
        return handle_health(ctx, req, resp)

    # GET /wiki/new — must come before /wiki/:slug so "new" isn't treated as
    # a slug (the slug rule reserves it).  Exactly /wiki/new: /wiki/news is a
    # page.
    if method == HTTP_METHOD_GET and path.eq("/wiki/new")
        return handle_wiki_new(ctx, req, resp)

    # POST /wiki — create a new page from the form on /wiki/new.  Must
    # be checked before the longer-prefix POST below.
    if method == HTTP_METHOD_POST and path.eq("/wiki")
        return handle_wiki_create(ctx, req, resp)

    # POST /wiki/:slug — update an existing page (called by the edit form).
    if method == HTTP_METHOD_POST and path.starts_with("/wiki/")
        return handle_wiki_update(ctx, req, resp)

    # GET /wiki/:slug/edit — render the edit form, pre-populated.
    if method == HTTP_METHOD_GET and path.starts_with("/wiki/") and path_ends_with_edit(path)
        return handle_wiki_edit_form(ctx, req, resp)

    # GET /wiki/:slug — view a wiki page
    if method == HTTP_METHOD_GET and path.starts_with("/wiki/")
        return handle_wiki_view(ctx, req, resp)

    return handle_not_found(ctx, req, resp)


# ============================================================================
# Argument Parsing
# ============================================================================

fn parse_i64(s: *u8) -> i64
    var result: i64 = 0
    var i: i32 = 0
    while *(s + i) != 0
        let c: u8 = *(s + i)
        if c >= '0' and c <= '9'
            result = result * 10 + (c - 48) as i64
        else
            break
        i += 1
    return result


fn parse_i32(s: *u8) -> i32
    return parse_i64(s) as i32


# ============================================================================
# Main - Zeus Worker Entry Point
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    # -h/--help: usage on stdout, exit 0, before any work (AGAST #2462)
    if args.len > 1
        let arg1: StrView = args[1]
        if arg1.eq("-h") or arg1.eq("--help")
            print("Usage: nexus <shm_size> <worker_id> [<worker_count>]\n")
            print("  Nexus wiki worker. Spawned by the zeus daemon, which passes the shared\n")
            print("  memory region as fd 3; not meant to be run by hand.\n")
            return 0
    # Expect: nexus <shm_size> <worker_id> [<worker_count>]
    if args.len < 3
        print("Usage: nexus <shm_size> <worker_id> [<worker_count>]\n")
        print("  (This binary is spawned by Zeus daemon)\n")
        return 1

    let shm_size: i64 = parse_i64(args[1].as_ptr())
    let worker_id: i32 = parse_i32(args[2].as_ptr())
    # zeus passes how many workers it runs (AGAST #2459); an older zeus
    # doesn't, so assume one.
    var worker_count: i32 = 1
    if args.len >= 4
        worker_count = parse_i32(args[3].as_ptr())
        if worker_count < 1
            worker_count = 1

    # One write per line: workers share stdout (src/log.ritz).
    log_set_worker(worker_id)
    var line: String = log_begin()
    line.push_cstr(c"Nexus Wiki Worker starting: worker ")
    line.push_i64(worker_id as i64)
    line.push_cstr(c" of ")
    line.push_i64(worker_count as i64)
    line.push_cstr(c", SHM ")
    line.push_i64(shm_size)
    line.push_cstr(c" bytes")
    log_end(@&line)

    # Open the page store: mausoleum at MAUSOLEUM_HOST:MAUSOLEUM_PORT (default
    # 127.0.0.1:7777, AGAST #3065), encrypted unless MAUSOLEUM_PLAINTEXT=1
    # (#2466); memory for a lone worker without it (src/wiki_app.ritz).
    var cfg: StoreConfig = store_config_from_env()
    let repo_ptr: *WikiPageRepository = malloc(sizeof(WikiPageRepository)) as *WikiPageRepository
    if repo_ptr == null
        log_cstr(c"Failed to allocate the repository")
        return 1
    *repo_ptr = wiki_page_repo_new()
    g_repo = repo_ptr
    g_cache = malloc(sizeof(PageCache)) as *PageCache
    *g_cache = page_cache_new()
    g_svc = wiki_service_new(g_repo, g_cache)
    if wiki_app_open(g_repo, @cfg, worker_count) != APP_UNAVAILABLE
        let pages: i64 = wiki_app_seed(@g_svc)
        var count_line: String = log_begin()
        count_line.push_cstr(c"Store initialized with ")
        count_line.push_i64(pages)
        count_line.push_cstr(c" pages")
        log_end(@&count_line)

    # Initialize zeus worker context
    var ctx: WorkerContext
    let init_result: i32 = worker_init(@ctx, SHM_FD, shm_size)
    if init_result != 0
        log_cstr(c"Failed to initialize worker context")
        return 1

    log_cstr(c"Worker attached to shared memory; ready to process requests")

    worker_set_running(@ctx)

    # Main request loop.  Use the futex-backed wait helper instead of a
    # nanosleep poll — this drops idle CPU from ~1.5% (1ms-poll loop) to
    # 0% (kernel-blocked on the request futex until valet wakes us).
    # Spin 100 iters to avoid syscall overhead for fast back-to-back
    # requests; otherwise sleep up to 1s before checking the running
    # flag (the upper bound on shutdown latency).
    var running: i32 = 1
    while running != 0
        let req: *RequestSlot = worker_wait_request(@ctx, 100, 1000)

        if req != null
            # AGAST #2464: never ack a request we couldn't answer. If the
            # response ring is full, leave the request where it is and retry
            # once valet has drained a response; acking it unanswered breaks
            # valet's request/response pairing and wedges it into 504s.
            if worker_wait_response_slot(@ctx, 100) != 0
                worker_set_busy(@ctx)

                # Route and handle request
                let resp: *ResponseSlot = worker_begin_response(@ctx, req.id)
                if resp != null
                    route_request(@ctx, req, resp)
                    worker_commit_response(@ctx)
                    worker_ack_request(@ctx)
                worker_set_running(@ctx)

    worker_destroy(@ctx)
    wiki_page_repo_disconnect(g_repo)
    log_cstr(c"Worker shutting down")

    return 0
