# src/main.ritz - Nexus Wiki Application (Zeus Worker)
#
# A wiki built on the Ritz stack as a Zeus worker process:
# - zeus: Zero-copy IPC with Valet HTTP server
# - mausoleum: Document database
# - tome: Caching (TODO)
#
# This binary is spawned by Zeus daemon and communicates via shared memory.
#
# Usage (spawned by zeus):
#   nexus <shm_size> <worker_id>
#
# Environment:
#   - fd 3 is the shared memory file descriptor
#
# Routes:
#   GET /           - Home page (list of pages)
#   GET /health     - Health check
#   GET /wiki/:slug - View a wiki page
#   GET /wiki/:slug/edit - Edit form
#   POST /wiki/:slug - Save changes
#   GET /wiki/new   - Create new page form
#   POST /wiki      - Create new page

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.string { String, string_new, string_drop, string_len, string_as_ptr, string_push_cstr }

import zeus.worker { WorkerContext }
import zeus.worker { worker_init, worker_destroy }
import zeus.worker { worker_set_running, worker_set_busy }
import zeus.worker { worker_poll_request, worker_wait_request, worker_ack_request }
import zeus.worker { worker_begin_response, worker_commit_response }
import zeus.worker { worker_get_request_path, worker_get_request_body }
import zeus.worker { worker_alloc_response_data, worker_ptr_to_offset }
import zeus.ring { RequestSlot, ResponseSlot }
import zeus.ring { HTTP_METHOD_GET, HTTP_METHOD_POST }
import zeus.ring { response_slot_set_status, response_slot_set_flags }
import zeus.ring { response_slot_set_body, response_slot_set_headers }
import zeus.ring { RESP_FLAG_COMPLETE }

import src.store
import src.slug { MAX_SLUG, path_starts_with, validate_slug, slug_from_path }
import src.pages { render_index_page, render_not_found_page, render_view_page }
import src.pages { render_new_page, render_edit_page, render_error_page }
import src.pages { push_headers, push_redirect_to_page }


# ============================================================================
# Constants
# ============================================================================

const SHM_FD: i32 = 3  # Zeus always passes shm fd as fd 3


# ============================================================================
# Print Helpers (using ritzlib)
# ============================================================================

# Using ritzlib.io: prints, print_int are already imported


# ============================================================================
# Form Parsing
# ============================================================================

fn url_decode(buf: *u8, len: i32) -> i32
    var read: i32 = 0
    var write: i32 = 0

    while read < len
        let c: u8 = *(buf + read)
        if c == '+'
            *(buf + write) = ' '
            read += 1
            write += 1
        else if c == '%' and read + 2 < len
            let h1: u8 = *(buf + read + 1)
            let h2: u8 = *(buf + read + 2)
            var val: u8 = 0

            if h1 >= '0' and h1 <= '9'
                val = (h1 - '0') << 4
            else if h1 >= 'A' and h1 <= 'F'
                val = (h1 - 'A' + 10) << 4
            else if h1 >= 'a' and h1 <= 'f'
                val = (h1 - 'a' + 10) << 4

            if h2 >= '0' and h2 <= '9'
                val = val | (h2 - '0')
            else if h2 >= 'A' and h2 <= 'F'
                val = val | (h2 - 'A' + 10)
            else if h2 >= 'a' and h2 <= 'f'
                val = val | (h2 - 'a' + 10)

            *(buf + write) = val
            read += 3
            write += 1
        else
            *(buf + write) = c
            read += 1
            write += 1

    return write


fn parse_form_field(body: *u8, body_len: i32, field: *u8, value_out: *u8, max_len: i32) -> i32
    let field_len: i32 = strlen(field) as i32

    var pos: i32 = 0
    while pos < body_len
        var found: i32 = 1
        if pos + field_len + 1 > body_len
            found = 0
        else
            for i in 0..field_len
                if *(body + pos + i) != *(field + i)
                    found = 0
                    break
            if found == 1 and *(body + pos + field_len) != '='
                found = 0

        if found == 1
            var start: i32 = pos + field_len + 1
            var end: i32 = start

            while end < body_len and *(body + end) != '&'
                end += 1

            var value_len: i32 = end - start
            if value_len > max_len
                value_len = max_len

            for i in 0..value_len
                *(value_out + i) = *(body + start + i)

            return url_decode(value_out, value_len)

        while pos < body_len and *(body + pos) != '&'
            pos += 1
        pos += 1

    return -1


# ============================================================================
# Response plumbing
#
# Pages and headers are rendered into growable Strings (src/pages.ritz), then
# copied once into the worker's response arena.  No response is ever built in
# a fixed-size buffer (AGAST #1870).
# ============================================================================

# Copy `len` bytes into a fresh arena block; null if the arena is full.
fn arena_copy(ctx: *WorkerContext, src: *u8, len: i64) -> *u8
    let dst: *u8 = worker_alloc_response_data(ctx, len)
    if dst != null
        memcpy(dst, src, len)
    return dst


# Commit `headers` + `body` (either may be empty) as the response.  If the
# arena cannot hold them, or the headers overflow the slot's u16 length, the
# response degrades to a bare 500 with no body rather than a truncated page.
fn send_raw(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, headers: @&String, body: @&String) -> i32
    let headers_len: i64 = string_len(headers)
    let body_len: i64 = string_len(body)
    var h: *u8 = null
    var b: *u8 = null
    var ok: i32 = 1
    if headers_len > 65535 or body_len > 4294967295
        ok = 0
    if ok == 1
        h = arena_copy(ctx, string_as_ptr(headers), headers_len)
        if h == null
            ok = 0
    if ok == 1 and body_len > 0
        b = arena_copy(ctx, string_as_ptr(body), body_len)
        if b == null
            ok = 0

    if ok == 0
        response_slot_set_status(resp, 500)
        response_slot_set_headers(resp, 0, 0)
        response_slot_set_body(resp, 0, 0)
        response_slot_set_flags(resp, RESP_FLAG_COMPLETE)
        return -1

    response_slot_set_status(resp, status as u16)
    response_slot_set_headers(resp, worker_ptr_to_offset(ctx, h) as u32, headers_len as u16)
    if b == null
        response_slot_set_body(resp, 0, 0)
    else
        response_slot_set_body(resp, worker_ptr_to_offset(ctx, b) as u32, body_len as u32)
    response_slot_set_flags(resp, RESP_FLAG_COMPLETE)
    return 0


# Send `body` with status and content type, then free it.
fn send_body(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, content_type: *u8, body: @&String) -> i32
    var headers: String = string_new()
    push_headers(@headers, status, content_type, string_len(body))
    let rc: i32 = send_raw(ctx, resp, status, @headers, body)
    string_drop(@headers)
    string_drop(body)
    return rc


fn send_text(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, text: *u8) -> i32
    var body: String = string_new()
    string_push_cstr(@body, text)
    return send_body(ctx, resp, status, c"text/plain", @body)


# 303 to /wiki/<slug>; the slug must already be validated.
fn send_redirect(ctx: *WorkerContext, resp: *ResponseSlot, slug: *u8, slug_len: i32) -> i32
    var headers: String = string_new()
    var body: String = string_new()
    push_redirect_to_page(@headers, slug, slug_len)
    let rc: i32 = send_raw(ctx, resp, 303, @headers, @body)
    string_drop(@headers)
    string_drop(@body)
    return rc


# A styled HTML error page.  `title` and `message` are literals.
fn send_error_page(ctx: *WorkerContext, resp: *ResponseSlot, status: i32, title: *u8, message: *u8) -> i32
    var body: String = string_new()
    render_error_page(@body, title, message)
    return send_body(ctx, resp, status, c"text/html; charset=utf-8", @body)


# ============================================================================
# Handlers
# ============================================================================

fn handle_index(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    # wiki_store_list writes '\n'-terminated slugs but no end marker, so
    # zero the buffer: the renderer stops at the first NUL.
    var slugs: [2048]u8
    memset(@slugs[0], 0, 2048)
    wiki_store_list(@slugs[0], 2048)
    var body: String = string_new()
    render_index_page(@body, @slugs[0], 2048)
    return send_body(ctx, resp, 200, c"text/html; charset=utf-8", @body)


fn handle_health(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    return send_text(ctx, resp, 200, c"OK")


fn handle_not_found(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    return send_text(ctx, resp, 404, c"404 Not Found")


# GET /wiki/:slug - View a wiki page
#
# Looks up the page in the store (mausoleum or fallback) and renders its
# content inside the standard Nexus chrome.  A slug outside [a-z0-9-]{1,128}
# is a plain 404; a valid slug with no page gets a styled 404 offering to
# create it.
fn handle_wiki_view(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let path: *u8 = worker_get_request_path(ctx, req)
    let path_len: i32 = req.path_len as i32

    var slug: [128]u8
    let slug_len: i32 = slug_from_path(path, path_len, @slug[0])
    if slug_len <= 0
        return handle_not_found(ctx, req, resp)

    var content: [8192]u8
    var content_len: i32 = 0
    var body: String = string_new()
    if wiki_store_get(@slug[0], slug_len, @content[0], @content_len) == 0
        render_not_found_page(@body, @slug[0], slug_len)
        return send_body(ctx, resp, 404, c"text/html; charset=utf-8", @body)

    render_view_page(@body, @slug[0], slug_len, @content[0], content_len)
    return send_body(ctx, resp, 200, c"text/html; charset=utf-8", @body)


fn handle_wiki_new(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    var body: String = string_new()
    render_new_page(@body)
    return send_body(ctx, resp, 200, c"text/html; charset=utf-8", @body)


# POST /wiki - Create a new wiki page from form data.
#
# Body shape: application/x-www-form-urlencoded with fields `slug` and
# `content`.  Both are URL-decoded by parse_form_field.  Slug is then
# validated against [a-z0-9-]{1,128}; content has no character restrictions
# beyond a length cap.  If a page with the slug already exists we refuse
# with 409 rather than silently overwriting — use POST /wiki/:slug for
# explicit updates.  On success we 303-redirect to the new page so the
# browser ends up on a GET.
fn handle_wiki_create(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let body_ptr: *u8 = worker_get_request_body(ctx, req)
    let body_len: i32 = req.body_len as i32

    if body_len <= 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Empty request body.")

    # One byte past MAX_SLUG, so an over-long slug fails validation instead
    # of being truncated to a valid, different one.
    var slug: [129]u8
    let slug_len: i32 = parse_form_field(body_ptr, body_len, c"slug", @slug[0], MAX_SLUG + 1)
    if slug_len < 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'slug' field.")
    if validate_slug(@slug[0], slug_len) == 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Slug must be 1-128 chars of [a-z], [0-9], or '-'.")

    var content: [8192]u8
    let content_len: i32 = parse_form_field(body_ptr, body_len, c"content", @content[0], 8192)
    if content_len < 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'content' field.")

    # Reject duplicate slug — caller should POST to /wiki/:slug to update
    var probe: [8192]u8
    var probe_len: i32 = 0
    if wiki_store_get(@slug[0], slug_len, @probe[0], @probe_len) == 1
        return send_error_page(ctx, resp, 409, c"Slug Already Exists", c"A page with that slug already exists. Edit it from its page, or pick a different slug.")

    if wiki_store_save(@slug[0], slug_len, @content[0], content_len) == 0
        return send_error_page(ctx, resp, 500, c"Save Failed", c"Could not persist the new page.")

    return send_redirect(ctx, resp, @slug[0], slug_len)


# POST /wiki/:slug - Update an existing page (also creates if missing).
#
# Body shape: same as create but only `content` is read; the slug
# comes from the URL.  This is the only POST that's idempotent in
# practice — replaying it overwrites with the same bytes.
fn handle_wiki_update(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let path: *u8 = worker_get_request_path(ctx, req)
    let path_len: i32 = req.path_len as i32

    var slug: [128]u8
    let slug_len: i32 = slug_from_path(path, path_len, @slug[0])
    if slug_len <= 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Slug must be 1-128 chars of [a-z], [0-9], or '-'.")

    let body_ptr: *u8 = worker_get_request_body(ctx, req)
    let body_len: i32 = req.body_len as i32
    if body_len <= 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Empty request body.")

    var content: [8192]u8
    let content_len: i32 = parse_form_field(body_ptr, body_len, c"content", @content[0], 8192)
    if content_len < 0
        return send_error_page(ctx, resp, 400, c"Bad Request", c"Missing 'content' field.")

    if wiki_store_save(@slug[0], slug_len, @content[0], content_len) == 0
        return send_error_page(ctx, resp, 500, c"Save Failed", c"Could not persist the page.")

    return send_redirect(ctx, resp, @slug[0], slug_len)


# GET /wiki/:slug/edit - Render the edit form pre-populated with the
# current page content.  404s if the slug is invalid or has no page.
fn handle_wiki_edit_form(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let path: *u8 = worker_get_request_path(ctx, req)
    let path_len: i32 = req.path_len as i32

    var slug: [128]u8
    let slug_len: i32 = slug_from_path(path, path_len, @slug[0])
    if slug_len <= 0
        return handle_not_found(ctx, req, resp)

    var content: [8192]u8
    var content_len: i32 = 0
    if wiki_store_get(@slug[0], slug_len, @content[0], @content_len) == 0
        return handle_not_found(ctx, req, resp)

    var body: String = string_new()
    render_edit_page(@body, @slug[0], slug_len, @content[0], content_len)
    return send_body(ctx, resp, 200, c"text/html; charset=utf-8", @body)


# Detect the trailing "/edit" suffix for a /wiki/:slug/edit GET.  We
# match exactly five trailing bytes so /wiki/foo-edit-pet still routes
# to the page view, not the edit form.
fn path_ends_with_edit(path: *u8, path_len: i32) -> i32
    if path_len < 11        # /wiki/x/edit minimum
        return 0
    let suffix: *u8 = c"/edit"
    for i in 0..5
        if *(path + path_len - 5 + i) != *(suffix + i)
            return 0
    return 1


# ============================================================================
# Router
# ============================================================================

fn route_request(ctx: *WorkerContext, req: *RequestSlot, resp: *ResponseSlot) -> i32
    let path: *u8 = worker_get_request_path(ctx, req)
    let path_len: i32 = req.path_len as i32
    let method: u8 = req.method

    # GET /
    if method == HTTP_METHOD_GET and path_len == 1 and *path == '/'
        return handle_index(ctx, req, resp)

    # GET /health
    if method == HTTP_METHOD_GET and path_starts_with(path, path_len, c"/health") != 0
        return handle_health(ctx, req, resp)

    # GET /wiki/new — must come before /wiki/:slug so "new" isn't treated as a slug
    if method == HTTP_METHOD_GET and path_starts_with(path, path_len, c"/wiki/new") != 0
        return handle_wiki_new(ctx, req, resp)

    # POST /wiki — create a new page from the form on /wiki/new.  Must
    # be checked before the longer-prefix POST below.
    if method == HTTP_METHOD_POST and path_len == 5 and path_starts_with(path, path_len, c"/wiki") != 0
        return handle_wiki_create(ctx, req, resp)

    # POST /wiki/:slug — update an existing page (called by the edit form).
    if method == HTTP_METHOD_POST and path_starts_with(path, path_len, c"/wiki/") != 0
        return handle_wiki_update(ctx, req, resp)

    # GET /wiki/:slug/edit — render the edit form, pre-populated.
    if method == HTTP_METHOD_GET and path_starts_with(path, path_len, c"/wiki/") != 0 and path_ends_with_edit(path, path_len) != 0
        return handle_wiki_edit_form(ctx, req, resp)

    # GET /wiki/:slug — view a wiki page (mausoleum-backed via wiki_store_get)
    if method == HTTP_METHOD_GET and path_starts_with(path, path_len, c"/wiki/") != 0
        return handle_wiki_view(ctx, req, resp)

    return handle_not_found(ctx, req, resp)


# ============================================================================
# Argument Parsing
# ============================================================================

fn parse_i64(s: *u8) -> i64
    var result: i64 = 0
    var i: i32 = 0
    while *(s + i) != 0
        let c: u8 = *(s + i)
        if c >= '0' and c <= '9'
            result = result * 10 + (c - 48) as i64
        else
            break
        i += 1
    return result


fn parse_i32(s: *u8) -> i32
    return parse_i64(s) as i32


# ============================================================================
# Main - Zeus Worker Entry Point
# ============================================================================

pub fn main(argc: i32, argv: **u8) -> i32
    prints_cstr(c"Nexus Wiki Worker starting...\n")

    # Expect: nexus <shm_size> <worker_id>
    if argc < 3
        prints_cstr(c"Usage: nexus <shm_size> <worker_id>\n")
        prints_cstr(c"  (This binary is spawned by Zeus daemon)\n")
        return 1

    let shm_size: i64 = parse_i64(*(argv + 1))
    let worker_id: i32 = parse_i32(*(argv + 2))

    prints_cstr(c"  Worker ID: ")
    print_int(worker_id as i64)
    prints_cstr(c"\n  SHM Size: ")
    print_int(shm_size)
    prints_cstr(c" bytes\n")

    # Initialize store (connects to mausoleum)
    wiki_store_init()
    store_seed()
    prints_cstr(c"  Store initialized with ")
    print_int(wiki_store_count() as i64)
    prints_cstr(c" pages\n")

    # Initialize zeus worker context
    var ctx: WorkerContext
    let init_result: i32 = worker_init(@ctx, SHM_FD, shm_size)
    if init_result != 0
        prints_cstr(c"Failed to initialize worker context\n")
        return 1

    prints_cstr(c"  Worker attached to shared memory\n")
    prints_cstr(c"  Ready to process requests\n\n")

    worker_set_running(@ctx)

    # Main request loop.  Use the futex-backed wait helper instead of a
    # nanosleep poll — this drops idle CPU from ~1.5% (1ms-poll loop) to
    # 0% (kernel-blocked on the request futex until valet wakes us).
    # Spin 100 iters to avoid syscall overhead for fast back-to-back
    # requests; otherwise sleep up to 1s before checking the running
    # flag (the upper bound on shutdown latency).
    var running: i32 = 1
    while running != 0
        let req: *RequestSlot = worker_wait_request(@ctx, 100, 1000)

        if req != null
            worker_set_busy(@ctx)

            # Route and handle request
            let resp: *ResponseSlot = worker_begin_response(@ctx, req.id)
            if resp != null
                route_request(@ctx, req, resp)
                worker_commit_response(@ctx)

            worker_ack_request(@ctx)
            worker_set_running(@ctx)

    worker_destroy(@ctx)
    wiki_store_close()
    prints_cstr(c"Worker shutting down\n")

    return 0
