# src/presenters/page_presenter.ritz - Wiki pages as HTTP responses
#
# Each presenter runs one wiki request through the service and appends the
# response body to `out`, returning the HTTP status. They take parsed input and
# know nothing about the transport, so the caller owns routing, form parsing
# and sending: nexus is a Zeus worker (src/main.ritz), not an in-process Valet
# handler. HTML comes from src/pages.ritz, which escapes everything it writes.

import ritzlib.strview { StrView, strview_len, strview_as_ptr }
import ritzlib.string { String, string_new, string_drop, string_push, string_push_str, string_as_view }
import ritzlib.gvec { Vec, vec_len, vec_get, vec_drop }

import src.pages {
    render_index_page,
    render_not_found_page,
    render_titled_view_page,
    render_new_page,
    render_edit_page,
    render_error_page
}

import models.wiki_page { WikiPage, wiki_page_drop }
import errors.service_error { ServiceError }
import errors.nexus_error { NexusError, nexus_error_from_service, nexus_error_status_code }
import services.wiki_service {
    WikiService,
    wiki_service_get_page,
    wiki_service_create_page,
    wiki_service_update_content,
    wiki_service_delete_page,
    wiki_service_page_exists,
    wiki_service_list_pages
}


# HTTP status for a successful save (POST -> GET redirect to the page)
pub const STATUS_SAVED: i32 = 303

# HTTP status for a successful delete
pub const STATUS_DELETED: i32 = 204


fn view_ptr(view: StrView) -> *u8
    strview_as_ptr(@view)


fn view_len(view: StrView) -> i32
    strview_len(@view) as i32


# Render the error page for `err`, returning its status. The body is generic:
# error text can carry database detail that does not belong in a response.
fn present_error(err: ServiceError, out: @&String) -> i32
    var wrapped: NexusError = nexus_error_from_service(err)
    let status: i32 = nexus_error_status_code(@wrapped)
    if status == 400
        render_error_page(out, c"Bad Request", c"That page name, title or content is not valid.")
    else if status == 403
        render_error_page(out, c"Forbidden", c"You do not have permission to do that.")
    else if status == 409
        render_error_page(out, c"Conflict", c"That page already exists or was changed by someone else.")
    else if status == 413
        render_error_page(out, c"Too Large", c"That page is too large to save.")
    else
        render_error_page(out, c"Error", c"An error occurred processing your request.")
    status


fn is_not_found(err: @ServiceError) -> bool
    match *err
        ServiceError.NotFound => true
        _ => false


# GET / - the page index
pub fn present_index(svc: *WikiService, out: @&String) -> i32
    match wiki_service_list_pages(svc)
        Ok(pages) =>
            var slugs: String = string_new()
            var i: i64 = 0
            while i < vec_len<WikiPage>(@pages)
                var page: WikiPage = vec_get<WikiPage>(@pages, i)
                string_push_str(@&slugs, string_as_view(@page.slug))
                string_push(@&slugs, '\n' as u8)
                wiki_page_drop(@page)
                i += 1
            vec_drop<WikiPage>(@&pages)
            let view: StrView = string_as_view(@slugs)
            render_index_page(out, view_ptr(view), view_len(view))
            string_drop(@&slugs)
            200
        Err(e) => present_error(e, out)


# GET /wiki/:slug - view a page
pub fn present_page_view(svc: *WikiService, slug: StrView, out: @&String) -> i32
    match wiki_service_get_page(svc, slug)
        Ok(page) =>
            let title: StrView = string_as_view(@page.title)
            let content: StrView = string_as_view(@page.content)
            render_titled_view_page(out, view_ptr(slug), view_len(slug), view_ptr(title), view_len(title), view_ptr(content), view_len(content))
            wiki_page_drop(@page)
            200
        Err(e) =>
            if is_not_found(@e)
                render_not_found_page(out, view_ptr(slug), view_len(slug))
                return 404
            present_error(e, out)


# GET /wiki/:slug/edit - edit form, or the create form for a page not yet there
pub fn present_page_edit(svc: *WikiService, slug: StrView, out: @&String) -> i32
    match wiki_service_get_page(svc, slug)
        Ok(page) =>
            let content: StrView = string_as_view(@page.content)
            render_edit_page(out, view_ptr(slug), view_len(slug), view_ptr(content), view_len(content))
            wiki_page_drop(@page)
            200
        Err(e) =>
            if is_not_found(@e)
                render_new_page(out)
                return 200
            present_error(e, out)


# POST /wiki/:slug - save parsed form fields, creating the page if it is new.
# Returns STATUS_SAVED with an empty body; the caller sends the redirect.
pub fn present_page_save(svc: *WikiService, slug: StrView, title: StrView, content: StrView, out: @&String) -> i32
    if wiki_service_page_exists(svc, slug)
        match wiki_service_update_content(svc, slug, content)
            Ok(page) =>
                wiki_page_drop(@page)
                STATUS_SAVED
            Err(e) => present_error(e, out)
    else
        match wiki_service_create_page(svc, slug, title, content)
            Ok(page) =>
                wiki_page_drop(@page)
                STATUS_SAVED
            Err(e) => present_error(e, out)


# DELETE /wiki/:slug - delete a page
pub fn present_page_delete(svc: *WikiService, slug: StrView, out: @&String) -> i32
    match wiki_service_delete_page(svc, slug)
        Ok(_) => STATUS_DELETED
        Err(e) =>
            if is_not_found(@e)
                render_not_found_page(out, view_ptr(slug), view_len(slug))
                return 404
            present_error(e, out)
