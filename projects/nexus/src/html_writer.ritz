# src/html_writer.ritz - HTML appenders onto a growable ritzlib String
#
# Every nexus response is built in a String, which grows as needed, so
# escaping can never write past a buffer (AGAST #1870).  Before that, these
# appended into caller-sized fixed buffers with no bounds checks, and a page
# of 8192 `"` (6 bytes each when escaped) wrote ~49 KB into 16 KB of stack.
#
# The byte copying is ritzlib.string's (string_push_bytes); this module only
# adds HTML escaping.  A failed grow (out of memory) leaves the String short,
# never overruns it.

import ritzlib.string { String, string_push_bytes, string_push_cstr }


# Append `len` bytes of `src`, verbatim.
pub fn html_bytes(out: @&String, src: *u8, len: i32)
    string_push_bytes(out, src, len as i64)


# Append the NUL-terminated `src` (without its terminator), verbatim.
pub fn html_cstr(out: @&String, src: *u8)
    string_push_cstr(out, src)


# Append `len` bytes of `src`, escaping the HTML-special characters.  Safe in
# element text and in double- or single-quoted attribute values.
pub fn html_escaped(out: @&String, src: *u8, len: i32)
    # Copy runs of plain bytes in one push; escape the specials between them.
    var run: i32 = 0
    for i in 0..len
        let c: u8 = *(src + i)
        var esc: *u8 = null
        if c == '<'
            esc = c"&lt;"
        else if c == '>'
            esc = c"&gt;"
        else if c == '&'
            esc = c"&amp;"
        else if c == '"'
            esc = c"&quot;"
        else if c == '\''
            esc = c"&#39;"
        if esc != null
            string_push_bytes(out, src + run, (i - run) as i64)
            string_push_cstr(out, esc)
            run = i + 1
    string_push_bytes(out, src + run, (len - run) as i64)
