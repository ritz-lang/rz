# src/html_writer.ritz - Append-at-position writers for the HTML response buffer
#
# Each writer copies into `buf` starting at `pos` and returns the position
# just past what it wrote, so calls chain: `p = write_cstr(buf, p, c"...")`.
# The byte copying and length scanning are ritzlib.str's (memcpy / strlen);
# this module only adds the position bookkeeping (AGAST #1951).
#
# The caller owns `buf` and must size it for everything it appends.

import ritzlib.str { strlen, memcpy }


# Append `len` bytes of `src`.
pub fn write_bytes(buf: *u8, pos: i32, src: *u8, len: i32) -> i32
    memcpy(buf + pos, src, len as i64)
    return pos + len


# Append the NUL-terminated `src` (without its terminator).
pub fn write_cstr(buf: *u8, pos: i32, src: *u8) -> i32
    return write_bytes(buf, pos, src, strlen(src) as i32)


# Append `len` bytes of `src`, escaping the HTML-special characters.
pub fn write_escaped(buf: *u8, pos: i32, src: *u8, len: i32) -> i32
    var p: i32 = pos
    for i in 0..len
        let c: u8 = *(src + i)
        if c == '<'
            p = write_cstr(buf, p, c"&lt;")
        else if c == '>'
            p = write_cstr(buf, p, c"&gt;")
        else if c == '&'
            p = write_cstr(buf, p, c"&amp;")
        else if c == '"'
            p = write_cstr(buf, p, c"&quot;")
        else if c == '\''
            p = write_cstr(buf, p, c"&#39;")
        else
            *(buf + p) = c
            p += 1
    return p
