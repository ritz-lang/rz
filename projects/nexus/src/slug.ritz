# src/slug.ritz - Wiki page slugs: the one slug rule, and extraction from
# /wiki/... paths
#
# A slug is 1-128 bytes of '/'-separated segments, each one or more of
# [a-z0-9-]. This is the only slug rule (AGAST #2209): the routes call
# slug_valid / slug_from_path, the wiki service calls slug_check through
# services/validation. Why this rule:
#
#   - [a-z0-9-] needs no URL, HTML or header escaping, so a slug can go into
#     an href or a Location header as is, and can't smuggle markup, traversal
#     ("..") or percent-escapes (AGAST #1870: `"><script>` reached an href);
#   - lower case only, so /wiki/Home and /wiki/home can't be two pages;
#   - '/' between non-empty segments, for the service's page hierarchy
#     (wiki_service_get_children: "language/syntax" is a child of "language");
#   - "new" and any slug ending in "/edit" are refused: /wiki/new is the
#     create form and /wiki/<slug>/edit the edit form, so such a page could
#     never be viewed.
#
# Every route that takes a slug from the request validates it before use.
#
# Slugs and paths are StrViews and yes/no answers are bool (AGAST #3461).  A
# slug taken from a path is a view into that path, not a copy.

import ritzlib.strview { StrView, strview_empty }
import ritzlib.strview

pub const MAX_SLUG: i64 = 128


# slug_check's verdict.
pub enum SlugVerdict
    Ok
    Empty
    TooLong
    BadChar                 # a byte outside [a-z0-9-/]
    EmptySegment            # leading, trailing or doubled '/'
    Reserved                # "new", or ending in "/edit"


fn is_slug_byte(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '-'


# Check `slug` against the slug rule: SlugVerdict.Ok, or why not.
pub fn slug_check(slug: StrView) -> SlugVerdict
    let n: i64 = slug.len()
    if n <= 0
        return SlugVerdict.Empty
    if n > MAX_SLUG
        return SlugVerdict.TooLong
    var seg_start: i64 = 0
    for i in 0..n
        let c: u8 = slug.get(i)
        if c == '/'
            if i == seg_start
                return SlugVerdict.EmptySegment
            seg_start = i + 1
        else if not is_slug_byte(c)
            return SlugVerdict.BadChar
    if seg_start == n
        return SlugVerdict.EmptySegment
    if slug.eq("new")
        return SlugVerdict.Reserved
    if seg_start > 0 and (slug.skip(seg_start)).eq("edit")
        return SlugVerdict.Reserved
    SlugVerdict.Ok


# Whether `slug` follows the slug rule.
pub fn slug_valid(slug: StrView) -> bool
    slug_check(slug) == SlugVerdict.Ok


# The rest of a /wiki/... path, as a view into `path`.  Empty if the path has
# no slug or it is longer than max_len (an over-long slug is refused rather
# than truncated to a different page's name).
pub fn extract_slug(path: StrView, max_len: i64) -> StrView
    if not path.starts_with("/wiki/")
        return strview_empty()
    let slug: StrView = path.skip(6)
    if slug.len() > max_len
        return strview_empty()
    slug


# The slug of /wiki/<slug> or /wiki/<slug>/edit, as a view into `path`.  Empty
# if absent or invalid (no valid slug is empty).  No valid slug ends in
# "/edit", so a trailing "/edit" is always the edit route's.
pub fn slug_from_path(path: StrView) -> StrView
    if not path.starts_with("/wiki/")
        return strview_empty()
    var route: StrView = path
    if path.len() - 6 > 5 and path.ends_with("/edit")
        route = path.take(path.len() - 5)
    let slug: StrView = extract_slug(route, MAX_SLUG)
    if not slug_valid(slug)
        return strview_empty()
    slug
