# src/slug.ritz - Wiki page slugs: extraction from /wiki/... paths and validation
#
# A slug is 1-128 bytes of [a-z0-9-].  Every route that takes a slug from the
# request (path or form) validates it before use (AGAST #1870): GET
# /wiki/:slug and /wiki/:slug/edit used to accept any byte except '/', so a
# slug of `"><script>` reached an href unescaped.

import ritzlib.str { strlen }

pub const MAX_SLUG: i32 = 128


# Check whether `path` starts with the NUL-terminated `prefix`.  1 or 0.
pub fn path_starts_with(path: *u8, path_len: i32, prefix: *u8) -> i32
    let prefix_len: i32 = strlen(prefix) as i32
    if path_len < prefix_len
        return 0
    for i in 0..prefix_len
        if *(path + i) != *(prefix + i)
            return 0
    return 1


# Copy the slug of /wiki/:slug[/...] into slug_out.  Returns its length, or
# -1 if the path has no slug or the slug is longer than max_len (an over-long
# slug is refused rather than truncated to a different page's name).
pub fn extract_slug(path: *u8, path_len: i32, slug_out: *u8, max_len: i32) -> i32
    if path_starts_with(path, path_len, c"/wiki/") == 0
        return -1

    let start: i32 = 6
    var end: i32 = start
    while end < path_len and *(path + end) != '/'
        end += 1

    let len: i32 = end - start
    if len == 0 or len > max_len
        return -1

    for i in 0..len
        *(slug_out + i) = *(path + start + i)
    return len


# 1 if slug[0..slug_len] is 1-128 bytes of [a-z0-9-], else 0.  Guards against
# markup injection, directory traversal, URL-escaping ambiguity and DB key
# abuse on user-supplied input.
pub fn validate_slug(slug: *u8, slug_len: i32) -> i32
    if slug_len <= 0 or slug_len > MAX_SLUG
        return 0
    for i in 0..slug_len
        let c: u8 = *(slug + i)
        var ok: i32 = 0
        if c >= 'a' and c <= 'z'
            ok = 1
        else if c >= '0' and c <= '9'
            ok = 1
        else if c == '-'
            ok = 1
        if ok == 0
            return 0
    return 1


# Extract and validate the slug of a /wiki/:slug path into slug_out, which
# must hold MAX_SLUG bytes.  Returns its length, or -1 if absent or invalid.
pub fn slug_from_path(path: *u8, path_len: i32, slug_out: *u8) -> i32
    let len: i32 = extract_slug(path, path_len, slug_out, MAX_SLUG)
    if len <= 0
        return -1
    if validate_slug(slug_out, len) == 0
        return -1
    return len
