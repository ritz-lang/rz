# src/repos/memory_docs.ritz - Documents in this process's memory
#
# The repository's backend when nexus runs as one worker with no Mausoleum
# (src/wiki_app.ritz): the same encoded Documents, ids and scan callback as
# Spire's db_* calls, so every repository operation runs unchanged on top. The
# pages are the only copy, so they are coherent, but they die with the process.

import ritzlib.span { Span }
import ritzlib.gvec { Vec, vec_new, vec_with_cap }


# One stored document: `data` owns a copy of its bytes.
struct MemDoc
    id: i64
    data: Vec<u8>


pub struct MemDocs
    docs: Vec<MemDoc>
    next_id: i64


# A Vec drops only its buffer, not its elements: drop each document's bytes.
impl Drop for MemDocs
    fn drop(self: @&MemDocs)
        mem_docs_clear(self)


pub fn mem_docs_new() -> MemDocs
    MemDocs {
        docs: vec_new<MemDoc>(),
        next_id: 1
    }


# Index of document `id`, or -1.
fn mem_docs_find(m: @&MemDocs, id: i64) -> i64
    var i: i64 = 0
    while i < m.docs.len()
        let d: *MemDoc = m.docs.get_ptr(i)
        if d.id == id
            return i
        i += 1
    -1


# Store a copy of `data`. Returns its id (ids only grow, as Mausoleum's do), or
# -1 if `data` is empty or out of memory.
pub fn mem_docs_insert(m: @&MemDocs, data: [u8]) -> i64
    if data.len <= 0
        return -1
    var copy: Vec<u8> = vec_with_cap<u8>(data.len)
    if not copy.push_span(data)
        return -1
    let id: i64 = m.next_id
    if not m.docs.push(MemDoc { id: id, data: copy })
        return -1
    m.next_id += 1
    id


# Document `id`'s stored bytes (a view of `m`'s copy, valid until it is
# deleted), or None.
pub fn mem_docs_get(m: @&MemDocs, id: i64) -> Option<[u8]>
    let i: i64 = mem_docs_find(m, id)
    if i < 0
        return None
    let d: *MemDoc = m.docs.get_ptr(i)
    Some(d.data[0..d.data.len()])


# True if document `id` was deleted, false if there was none.
pub fn mem_docs_delete(m: @&MemDocs, id: i64) -> bool
    let i: i64 = mem_docs_find(m, id)
    if i < 0
        return false
    # Shift the ones after it down a place, so scans keep insertion (= id)
    # order, as Mausoleum's do: each takes the place of the one before it,
    # and the one at `i` comes out last and is dropped.
    var moving: MemDoc = m.docs.pop()
    var j: i64 = m.docs.len() - 1
    while j >= i
        moving = m.docs.replace(j, moving)
        j -= 1
    true


# Call `callback(id, doc, user)` for each document in id order, until it
# returns non-zero. Returns how many it was called for.
pub fn mem_docs_scan(m: @&MemDocs, callback: *u8, user: *u8) -> i32
    let cb: fn(i64, [u8], *u8) -> i32 = callback as fn(i64, [u8], *u8) -> i32
    var n: i32 = 0
    var i: i64 = 0
    while i < m.docs.len()
        let d: *MemDoc = m.docs.get_ptr(i)
        n += 1
        let doc: [u8] = d.data[0..d.data.len()]
        if cb(d.id, doc, user) != 0
            return n
        i += 1
    n


# Drop every document.
pub fn mem_docs_clear(m: @&MemDocs)
    while m.docs.len() > 0
        let gone: MemDoc = m.docs.pop()
