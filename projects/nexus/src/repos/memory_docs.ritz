# src/repos/memory_docs.ritz - Documents in this process's memory
#
# The repository's backend when nexus runs as one worker with no Mausoleum
# (src/wiki_app.ritz): the same encoded Documents, ids and scan callback as
# Spire's db_* calls, so every repository operation runs unchanged on top. The
# pages are the only copy, so they are coherent, but they die with the process.

import ritzlib.memory
import ritzlib.str
import ritzlib.gvec { Vec, vec_new }


struct MemDoc
    id: i64
    data: *u8
    len: i32


pub struct MemDocs
    docs: Vec<MemDoc>
    next_id: i64


pub fn mem_docs_new() -> MemDocs
    MemDocs {
        docs: vec_new<MemDoc>(),
        next_id: 1
    }


# Index of document `id`, or -1.
fn mem_docs_find(m: *MemDocs, id: i64) -> i64
    var i: i64 = 0
    while i < m.docs.len()
        let d: MemDoc = m.docs.get(i)
        if d.id == id
            return i
        i += 1
    -1


# Store a copy of `data`. Returns its id (ids only grow, as Mausoleum's do), or
# -1 if out of memory.
pub fn mem_docs_insert(m: *MemDocs, data: *u8, len: i32) -> i64
    if len <= 0
        return -1
    let copy: *u8 = malloc(len as i64)
    if copy == null
        return -1
    memcpy(copy, data, len as i64)
    let id: i64 = m.next_id
    if not m.docs.push(MemDoc { id: id, data: copy, len: len })
        free(copy)
        return -1
    m.next_id += 1
    id


# 1 and the stored bytes (owned by `m`), 0 if there is no document `id`.
pub fn mem_docs_get(m: *MemDocs, id: i64, data_out: **u8, len_out: *i32) -> i32
    let i: i64 = mem_docs_find(m, id)
    if i < 0
        return 0
    let d: MemDoc = m.docs.get(i)
    *data_out = d.data
    *len_out = d.len
    1


# 1 if document `id` was deleted, 0 if there was none.
pub fn mem_docs_delete(m: *MemDocs, id: i64) -> i32
    let i: i64 = mem_docs_find(m, id)
    if i < 0
        return 0
    let d: MemDoc = m.docs.get(i)
    free(d.data)
    # Shift the rest down: scans keep insertion (= id) order, as Mausoleum's do.
    var j: i64 = i
    let last: i64 = m.docs.len() - 1
    while j < last
        m.docs.set(j, m.docs.get(j + 1))
        j += 1
    m.docs.pop()
    1


# Call `callback(id, data, len, user)` for each document in id order, until it
# returns non-zero. Returns how many it was called for.
pub fn mem_docs_scan(m: *MemDocs, callback: *u8, user: *u8) -> i32
    let cb: fn(i64, *u8, i32, *u8) -> i32 = callback as fn(i64, *u8, i32, *u8) -> i32
    var n: i32 = 0
    var i: i64 = 0
    while i < m.docs.len()
        let d: MemDoc = m.docs.get(i)
        n += 1
        if cb(d.id, d.data, d.len, user) != 0
            return n
        i += 1
    n


# Free every document.
pub fn mem_docs_drop(m: *MemDocs)
    var i: i64 = 0
    while i < m.docs.len()
        let d: MemDoc = m.docs.get(i)
        free(d.data)
        i += 1
    m.docs.deinit()
