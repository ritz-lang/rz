# src/repos/wiki_page_repo.ritz - WikiPage repository
#
# Data access for wiki pages stored in Mausoleum, through Spire's adapter (the
# layer store.ritz uses too). Mausoleum has no secondary indexes or update
# operation yet, which shapes two operations here:
#   - slug lookups scan the collection, O(pages) per lookup;
#   - update writes the new document, then deletes the old one, so a page's
#     document id changes on every update.

import ritzlib.memory
import ritzlib.strview { StrView, strview_len, strview_get, strview_as_ptr }
import ritzlib.string { string_from }
import ritzlib.gvec { Vec, vec_new, vec_push, vec_drop }

import spire.repo.mausoleum {
    Db,
    db_init,
    db_set_encryption,
    db_connect,
    db_close,
    db_is_connected,
    db_insert,
    db_get,
    db_delete,
    db_scan,
    db_extract_field
}
import mausoleum.document { DocumentId, doc_id_invalid }

import models.wiki_page { WikiPage }
import errors.repo_error { RepoError }
import repos.wiki_page_codec { wiki_page_encode, wiki_page_encode_bound, wiki_page_decode }


# WikiPage repository - handles persistence to Mausoleum
pub struct WikiPageRepository
    db: Db
    connected: bool


# Create a new repository (not yet connected)
pub fn wiki_page_repo_new() -> WikiPageRepository
    var repo: WikiPageRepository
    repo.connected = false
    repo


# Connect to Mausoleum. `encrypted` must match the server: false only for a
# server running with --no-encryption.
pub fn wiki_page_repo_connect(repo: *WikiPageRepository, host: StrView, port: i32, encrypted: bool) -> Result<(), RepoError>
    if repo.connected
        return Ok(())

    db_init(@repo.db, strview_as_ptr(@host), strview_len(@host) as i32, port, c"nexus_pages", 11)
    if encrypted
        db_set_encryption(@repo.db, 1)
    else
        db_set_encryption(@repo.db, 0)

    if db_connect(@repo.db) < 0
        return Err(RepoError.NetworkError(string_from("Connection failed")))

    repo.connected = true
    Ok(())


# Disconnect from Mausoleum
pub fn wiki_page_repo_disconnect(repo: *WikiPageRepository)
    if repo.connected
        db_close(@repo.db)
        repo.connected = false


# Check if connected
pub fn wiki_page_repo_is_connected(repo: *WikiPageRepository) -> bool
    repo.connected and db_is_connected(@repo.db) == 1


fn not_connected() -> RepoError
    RepoError.NetworkError(string_from("Not connected"))


# Decode a stored document. The id comes from the database, not the bytes: the
# id field is only meaningful for a cached copy.
fn decode_stored(doc_id: i64, data: *u8, len: i32) -> Result<WikiPage, RepoError>
    var page: WikiPage = wiki_page_decode(data, len)?
    page.id.value = doc_id
    Ok(page)


# Get a page by its document ID
pub fn wiki_page_repo_get_by_id(repo: *WikiPageRepository, id: DocumentId) -> Result<WikiPage, RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    var data: *u8 = null
    var len: i32 = 0
    let result: i32 = db_get(@repo.db, id.value, @data, @len)
    if result == 0
        return Err(RepoError.NotFound)
    if result < 0
        return Err(RepoError.DatabaseError(string_from("Get failed")))

    decode_stored(id.value, data, len)


# State for one slug scan. `tmp` holds slug length + 1 bytes, so a longer
# stored slug is cut to a length that cannot match.
struct SlugScan
    slug: StrView
    tmp: *u8
    doc_id: i64
    found: bool


fn slug_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *SlugScan = user_data as *SlugScan
    let want: i64 = strview_len(@scan.slug)
    let n: i32 = db_extract_field(data, len, c"slug", 4, scan.tmp, (want + 1) as i32)
    if n as i64 != want
        return 0
    var i: i64 = 0
    while i < want
        if *(scan.tmp + i) != strview_get(@scan.slug, i)
            return 0
        i += 1
    scan.doc_id = doc_id
    scan.found = true
    1


# Get a page by its slug (e.g., "language/syntax")
pub fn wiki_page_repo_get_by_slug(repo: *WikiPageRepository, slug: StrView) -> Result<WikiPage, RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    var scan: SlugScan
    scan.slug = slug
    scan.tmp = malloc(strview_len(@slug) + 1)
    if scan.tmp == null
        return Err(RepoError.DatabaseError(string_from("Out of memory")))
    scan.doc_id = 0
    scan.found = false
    let scanned: i32 = db_scan(@repo.db, slug_scan_step as *u8, @scan as *u8)
    free(scan.tmp)

    if scanned < 0
        return Err(RepoError.DatabaseError(string_from("Scan failed")))
    if not scan.found
        return Err(RepoError.NotFound)

    # The client can't issue a request mid-scan, so the fetch comes after it.
    var id: DocumentId = doc_id_invalid()
    id.value = scan.doc_id
    wiki_page_repo_get_by_id(repo, id)


# Encode and insert `page`, returning its new document id.
fn insert_document(repo: *WikiPageRepository, page: *WikiPage) -> Result<i64, RepoError>
    let bound: i64 = wiki_page_encode_bound(page)
    let buf: *u8 = malloc(bound)
    if buf == null
        return Err(RepoError.SerializationError)
    let n: i64 = wiki_page_encode(page, buf, bound)
    if n < 0
        free(buf)
        return Err(RepoError.SerializationError)

    let doc_id: i64 = db_insert(@repo.db, buf, n as i32)
    free(buf)
    if doc_id < 0
        return Err(RepoError.DatabaseError(string_from("Insert failed")))
    Ok(doc_id)


# Save a new page, setting page.id to the id the database assigned
pub fn wiki_page_repo_insert(repo: *WikiPageRepository, page: *WikiPage) -> Result<DocumentId, RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    page.id.value = insert_document(repo, page)?
    Ok(page.id)


# Update an existing page, setting page.id to its new document id.
#
# The new document goes in first, so a failure can't lose the page. If the old
# one can't be removed, the new one is taken back out. A crash between the two
# steps leaves both; slug lookup then returns the first, the older version.
pub fn wiki_page_repo_update(repo: *WikiPageRepository, page: *WikiPage) -> Result<(), RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    let new_id: i64 = insert_document(repo, page)?
    let deleted: i32 = db_delete(@repo.db, page.id.value)
    if deleted <= 0
        db_delete(@repo.db, new_id)
        if deleted == 0
            return Err(RepoError.NotFound)
        return Err(RepoError.DatabaseError(string_from("Update failed (delete)")))

    page.id.value = new_id
    Ok(())


# Delete a page by ID
pub fn wiki_page_repo_delete(repo: *WikiPageRepository, id: DocumentId) -> Result<(), RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    let result: i32 = db_delete(@repo.db, id.value)
    if result == 0
        return Err(RepoError.NotFound)
    if result < 0
        return Err(RepoError.DatabaseError(string_from("Delete failed")))
    Ok(())


# State for one list scan: a document that won't decode stops the scan.
struct ListScan
    pages: Vec<WikiPage>
    corrupt: bool


fn list_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *ListScan = user_data as *ListScan
    match decode_stored(doc_id, data, len)
        Ok(page) =>
            vec_push<WikiPage>(@&scan.pages, page)
            0
        Err(_) =>
            scan.corrupt = true
            1


# List all pages
pub fn wiki_page_repo_list_all(repo: *WikiPageRepository) -> Result<Vec<WikiPage>, RepoError>
    if not wiki_page_repo_is_connected(repo)
        return Err(not_connected())

    var scan: ListScan
    scan.pages = vec_new<WikiPage>()
    scan.corrupt = false
    let scanned: i32 = db_scan(@repo.db, list_scan_step as *u8, @scan as *u8)
    if scanned < 0
        vec_drop<WikiPage>(@&scan.pages)
        return Err(RepoError.DatabaseError(string_from("Scan failed")))
    if scan.corrupt
        vec_drop<WikiPage>(@&scan.pages)
        return Err(RepoError.SerializationError)
    Ok(scan.pages)
