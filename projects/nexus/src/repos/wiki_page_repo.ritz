# src/repos/wiki_page_repo.ritz - WikiPage repository
#
# Data access for wiki pages stored in Mausoleum, through Spire's adapter, or
# in this process's memory (repos/memory_docs) when nexus runs as one worker
# with no Mausoleum. Mausoleum has a secondary index but no update operation,
# which shapes the operations here:
#
#   - slug lookups ask Mausoleum's "slug" index which documents hold the slug,
#     O(log pages) per lookup (AGAST #3644). The index lives on the server,
#     the only writer, so every worker sees every other worker's writes; a
#     per-worker index or cache would not (AGAST #2459). The first dial
#     creates it, the server rebuilds it from the collection if it ever drops
#     it, and until it exists a lookup falls back to the scan it replaced;
#   - update writes the new document, then deletes every older one for the
#     slug, so a page's document id changes on every update. A crash (or a
#     second worker saving) in between leaves two documents for the slug;
#     lookups serve the newest (ids only grow), list shows it once, and the
#     next save or delete removes the rest;
#   - documents that aren't pages are skipped. Pages that src/store.ritz
#     wrote before #2209 ({slug, content} only) are read as version-1 pages
#     titled by their slug, and rewritten on their next save;
#   - before #3637 the server put every CONNECT name in one collection, which
#     an upgraded store opens as "default". The first dial that reaches
#     Mausoleum moves the pages found there into "nexus_pages" (adopt_default,
#     AGAST #3681); other apps' documents stay in "default".
#
# A connection that fails mid-request is dropped and dialled again once, so
# nexus recovers when Mausoleum comes back. An unreachable Mausoleum is a
# NetworkError (a 503), never a missing page.

import ritzlib.memory
import ritzlib.strview { StrView }
import ritzlib.string { String, string_from }
import ritzlib.gvec { Vec, vec_new, vec_push, vec_len, vec_get, vec_get_ptr, vec_set, vec_drop }

import spire.repo.mausoleum {
    Db,
    db_init,
    db_set_encryption,
    db_connect,
    db_close,
    db_is_connected,
    db_insert,
    db_get,
    db_delete,
    db_scan,
    db_extract_field,
    db_index_create,
    db_find_ids,
    DB_REFUSED
}
import mausoleum.document { DocumentId, doc_id_invalid }

import models.wiki_page { WikiPage, wiki_page_drop }
import errors.repo_error { RepoError }
import repos.wiki_page_codec { wiki_page_encode, wiki_page_encode_bound, wiki_page_decode, wiki_page_decode_legacy }
import services.validation { MAX_CONTENT_SIZE }
import repos.memory_docs { MemDocs, mem_docs_new, mem_docs_insert, mem_docs_get, mem_docs_delete, mem_docs_scan, mem_docs_drop }


# A db_* result meaning "could not reach Mausoleum at all" (vs. a refused op).
const UNREACHABLE: i64 = -1000

# Documents per slug that one save or delete will clean up.
const MAX_COPIES: i64 = 64

# The longest page content the in-memory store takes: #2208 kept the old
# store's 8192-byte buffer for its fallback, and the e2e's max-size page is
# exactly that long. In Mausoleum a page is one document, so there it is
# validation's MAX_CONTENT_SIZE (AGAST #2208, #2209).
pub const MEMORY_MAX_CONTENT_LEN: i64 = 8192


# WikiPage repository - handles persistence to Mausoleum, or to memory
pub struct WikiPageRepository
    db: Db
    connected: bool          # opened: on Mausoleum (dialled per need) or memory
    memory: bool             # pages live in `mem`, not Mausoleum
    mem: MemDocs
    connect_error: i32       # the last failed dial's error, 0 if none
    adopted: bool            # "default"'s pages moved here (or being moved)
    indexed: bool            # this connection has the server's "slug" index
    index_unsupported: bool  # the server has no secondary indexes: don't ask
    scans: i64               # collection scans issued (see scan_count)


# Create a new repository (not yet connected)
pub fn wiki_page_repo_new() -> WikiPageRepository
    var repo: WikiPageRepository
    repo.connected = false
    repo.memory = false
    repo.connect_error = 0
    repo.adopted = false
    repo.indexed = false
    repo.index_unsupported = false
    repo.scans = 0
    repo.db.client = null
    repo.db.connected = 0
    repo.mem = mem_docs_new()
    repo


# Dial Mausoleum if the connection is down. 0 = connected, < 0 = the error.
# The first dial that connects also moves "default"'s pages here; if that
# fails they stay where they are, and the next dial tries again.
fn ensure_db(repo: *WikiPageRepository) -> i32
    if db_is_connected(@repo.db) == 1
        ensure_index(repo)
        return 0
    # A new connection may reach a server that has no index yet (a restart,
    # another worker's first dial), so assert it again below.
    repo.indexed = false
    let rc: i32 = db_connect(@repo.db)
    if rc < 0
        repo.connect_error = rc
        return rc
    repo.connect_error = 0
    if not repo.adopted
        # Set first: the move's own requests dial through here.
        repo.adopted = true
        if adopt_default(repo) < 0
            repo.adopted = false
    ensure_index(repo)
    0


# Best effort: ask the server for the "slug" index, building it from the
# documents it already holds. A failure is not fatal — a lookup scans instead,
# and the next dial asks again — so the result only tells callers whether the
# index is now there. A server that doesn't know the request is remembered
# (`index_unsupported`) so it is asked once, not on every request.
fn ensure_index(repo: *WikiPageRepository) -> i32
    if repo.indexed or repo.index_unsupported or repo.memory
        return 0
    if db_is_connected(@repo.db) == 0
        return 0
    let rc: i32 = db_index_create(@repo.db, c"slug", 4)
    if rc == 0
        repo.indexed = true
    else if rc == DB_REFUSED
        repo.index_unsupported = true
    rc


# Open the repository on Mausoleum at host:port and dial it. `encrypted` must
# match the server: false only for a server running with --no-encryption.
# Returns 0, or the dial's error (< 0): the repository stays open either way,
# and every operation dials again until Mausoleum answers.
pub fn wiki_page_repo_open(repo: *WikiPageRepository, host: StrView, port: i32, encrypted: bool) -> i32
    if repo.connected
        return 0
    db_init(@repo.db, host.as_ptr(), host.len() as i32, port, c"nexus_pages", 11)
    if encrypted
        db_set_encryption(@repo.db, 1)
    else
        db_set_encryption(@repo.db, 0)
    repo.memory = false
    repo.connected = true
    ensure_db(repo)


# Connect to Mausoleum, failing (and staying closed) if it doesn't answer now.
pub fn wiki_page_repo_connect(repo: *WikiPageRepository, host: StrView, port: i32, encrypted: bool) -> Result<(), RepoError>
    if repo.connected
        return Ok(())
    if wiki_page_repo_open(repo, host, port, encrypted) < 0
        wiki_page_repo_disconnect(repo)
        return Err(RepoError.NetworkError(string_from("Connection failed")))
    Ok(())


# Open the repository on this process's memory: no Mausoleum, no durability.
pub fn wiki_page_repo_open_memory(repo: *WikiPageRepository)
    if repo.connected
        return
    repo.mem = mem_docs_new()
    repo.memory = true
    repo.connected = true


# The longest page content this repository's backend holds: what one
# Mausoleum document leaves (MAX_CONTENT_SIZE), or MEMORY_MAX_CONTENT_LEN
# in memory. The service validates content against it, so a longer page is
# ContentTooLarge (413), never a database error (500).
pub fn wiki_page_repo_max_content_len(repo: *WikiPageRepository) -> i64
    if repo.memory
        return MEMORY_MAX_CONTENT_LEN
    MAX_CONTENT_SIZE


# The error of the last failed dial (for the log), 0 if none.
pub fn wiki_page_repo_connect_error(repo: *WikiPageRepository) -> i32
    repo.connect_error


# Disconnect from Mausoleum (or drop the in-memory pages)
pub fn wiki_page_repo_disconnect(repo: *WikiPageRepository)
    if repo.connected
        if repo.memory
            mem_docs_drop(@repo.mem)
        else
            db_close(@repo.db)
        repo.connected = false
        repo.memory = false


# Check if connected
pub fn wiki_page_repo_is_connected(repo: *WikiPageRepository) -> bool
    repo.connected and (repo.memory or db_is_connected(@repo.db) == 1)


fn not_connected() -> RepoError
    RepoError.NetworkError(string_from("Not connected"))


fn unreachable_error() -> RepoError
    RepoError.NetworkError(string_from("Mausoleum unreachable"))


# ============================================================================
# Documents: Mausoleum (dialled again once if the connection had gone stale)
# or memory
# ============================================================================

fn doc_insert(repo: *WikiPageRepository, data: *u8, len: i32) -> i64
    if repo.memory
        return mem_docs_insert(@repo.mem, data, len)
    var rc: i64 = UNREACHABLE
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db(repo) == 0
            rc = db_insert(@repo.db, data, len)
            if rc >= 0
                return rc
            db_close(@repo.db)
        else
            rc = UNREACHABLE
        attempt += 1
    rc


# 1 = found (data_out set), 0 = no such document, < 0 = failed.
fn doc_get(repo: *WikiPageRepository, id: i64, data_out: **u8, len_out: *i32) -> i64
    if repo.memory
        return mem_docs_get(@repo.mem, id, data_out, len_out) as i64
    var rc: i64 = UNREACHABLE
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db(repo) == 0
            rc = db_get(@repo.db, id, data_out, len_out) as i64
            if rc >= 0
                return rc
            db_close(@repo.db)
        else
            rc = UNREACHABLE
        attempt += 1
    rc


# 1 = deleted, 0 = no such document, < 0 = failed.
fn doc_delete(repo: *WikiPageRepository, id: i64) -> i64
    if repo.memory
        return mem_docs_delete(@repo.mem, id) as i64
    var rc: i64 = UNREACHABLE
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db(repo) == 0
            rc = db_delete(@repo.db, id) as i64
            if rc >= 0
                return rc
            db_close(@repo.db)
        else
            rc = UNREACHABLE
        attempt += 1
    rc


# `reset(user)` runs before each attempt, so a retried scan starts clean.
fn doc_scan(repo: *WikiPageRepository, step: *u8, reset: *u8, user: *u8) -> i64
    let reset_fn: fn(*u8) -> i32 = reset as fn(*u8) -> i32
    repo.scans += 1
    if repo.memory
        reset_fn(user)
        return mem_docs_scan(@repo.mem, step, user) as i64
    var rc: i64 = UNREACHABLE
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db(repo) == 0
            reset_fn(user)
            rc = db_scan(@repo.db, step, user) as i64
            if rc >= 0
                return rc
            db_close(@repo.db)
        else
            rc = UNREACHABLE
        attempt += 1
    rc


# How many collection scans this repository has issued. A slug lookup must
# not add to it (AGAST #3644): the count is what proves the index answered.
pub fn wiki_page_repo_scan_count(repo: *WikiPageRepository) -> i64
    repo.scans


# Document ids holding `slug`, ascending, into `out` (at most `max`).
# Returns the count, DB_REFUSED when the server has no usable "slug" index
# (the caller scans), or UNREACHABLE/another error. Dialled again once if the
# connection had gone stale, like the doc_* helpers.
fn doc_find(repo: *WikiPageRepository, slug: StrView, out: *i64, max: i32) -> i64
    var rc: i64 = UNREACHABLE
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db(repo) == 0
            rc = db_find_ids(@repo.db, c"slug", 4, slug.as_ptr(), slug.len() as i32, out, max) as i64
            if rc >= 0
                return rc
            if rc == DB_REFUSED as i64
                return rc
            db_close(@repo.db)
        else
            rc = UNREACHABLE
        attempt += 1
    rc


# A failed doc_* result as a RepoError.
fn doc_error(rc: i64, what: StrView) -> RepoError
    if rc == UNREACHABLE
        return unreachable_error()
    RepoError.DatabaseError(string_from(what))


# Decode a stored document. The id comes from the database, not the bytes: the
# id field is only meaningful for a cached copy.
# A document that isn't wiki_page_encode's is tried as a pre-#2209 page.
fn decode_stored(doc_id: i64, data: *u8, len: i32) -> Result<WikiPage, RepoError>
    var page: WikiPage = decode_any(data, len)?
    page.id.value = doc_id
    Ok(page)


fn decode_any(data: *u8, len: i32) -> Result<WikiPage, RepoError>
    match wiki_page_decode(data, len)
        Ok(page) => Ok(page)
        Err(_) => wiki_page_decode_legacy(data, len)


# Get a page by its document ID
pub fn wiki_page_repo_get_by_id(repo: *WikiPageRepository, id: DocumentId) -> Result<WikiPage, RepoError>
    if not repo.connected
        return Err(not_connected())

    var data: *u8 = null
    var len: i32 = 0
    let result: i64 = doc_get(repo, id.value, @data, @len)
    if result == 0
        return Err(RepoError.NotFound)
    if result < 0
        return Err(doc_error(result, "Get failed"))

    decode_stored(id.value, data, len)


# State for one slug scan: every document holding the slug. `tmp` holds slug
# length + 1 bytes, so a longer stored slug is cut to a length that can't match.
struct SlugScan
    slug: StrView
    tmp: *u8
    newest: i64              # the newest document holding the slug, -1 if none
    ids: [64]i64             # every document holding it (MAX_COPIES)
    n_ids: i64


fn slug_scan_reset(user_data: *u8) -> i32
    let scan: *SlugScan = user_data as *SlugScan
    scan.newest = -1
    scan.n_ids = 0
    0


fn slug_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *SlugScan = user_data as *SlugScan
    let want: i64 = (scan.slug).len()
    let n: i32 = db_extract_field(data, len, c"slug", 4, scan.tmp, (want + 1) as i32)
    if n as i64 != want
        return 0
    var i: i64 = 0
    while i < want
        if *(scan.tmp + i) != (scan.slug).get(i)
            return 0
        i += 1
    if scan.n_ids < MAX_COPIES
        scan.ids[scan.n_ids] = doc_id
        scan.n_ids += 1
    # Ids only grow, so the largest is the latest save.
    if doc_id > scan.newest
        scan.newest = doc_id
    0   # never stop early: every copy counts


# Fill `scan` with every document holding `slug`: from the server's "slug"
# index when it has one (no collection scan), otherwise by scanning.
fn find_slug(repo: *WikiPageRepository, slug: StrView, scan: *SlugScan) -> Result<(), RepoError>
    scan.slug = slug
    scan.newest = -1
    scan.n_ids = 0
    if not repo.memory and not repo.index_unsupported
        let found: i64 = doc_find(repo, slug, @scan.ids[0], MAX_COPIES as i32)
        if found >= 0
            scan.n_ids = found
            var i: i64 = 0
            while i < found
                # Ids only grow, so the largest is the latest save.
                if scan.ids[i] > scan.newest
                    scan.newest = scan.ids[i]
                i += 1
            return Ok(())
        if found == DB_REFUSED as i64
            # The server dropped the index (maintenance failed, or it was
            # never built here). Scan now; the next dial rebuilds it.
            repo.indexed = false
        # Any other failure falls through too: the scan below redials and
        # reports the error the way every operation does.

    scan.tmp = malloc(slug.len() + 1)
    if scan.tmp == null
        return Err(RepoError.DatabaseError(string_from("Out of memory")))
    let scanned: i64 = doc_scan(repo, slug_scan_step as *u8, slug_scan_reset as *u8, scan as *u8)
    free(scan.tmp)
    if scanned < 0
        return Err(doc_error(scanned, "Scan failed"))
    Ok(())


# Get a page by its slug (e.g., "language/syntax"): its newest document
pub fn wiki_page_repo_get_by_slug(repo: *WikiPageRepository, slug: StrView) -> Result<WikiPage, RepoError>
    if not repo.connected
        return Err(not_connected())

    var scan: SlugScan
    find_slug(repo, slug, @scan)?
    if scan.newest < 0
        return Err(RepoError.NotFound)

    # The client can't issue a request mid-scan, so the fetch comes after it.
    var id: DocumentId = doc_id_invalid()
    id.value = scan.newest
    wiki_page_repo_get_by_id(repo, id)


# Encode and insert `page`, returning its new document id.
fn insert_document(repo: *WikiPageRepository, page: *WikiPage) -> Result<i64, RepoError>
    let bound: i64 = wiki_page_encode_bound(page)
    let buf: *u8 = malloc(bound)
    if buf == null
        return Err(RepoError.SerializationError)
    let n: i64 = wiki_page_encode(page, buf, bound)
    if n < 0
        free(buf)
        return Err(RepoError.SerializationError)

    let doc_id: i64 = doc_insert(repo, buf, n as i32)
    free(buf)
    if doc_id < 0
        return Err(doc_error(doc_id, "Insert failed"))
    Ok(doc_id)


# Save a new page, setting page.id to the id the database assigned
pub fn wiki_page_repo_insert(repo: *WikiPageRepository, page: *WikiPage) -> Result<DocumentId, RepoError>
    if not repo.connected
        return Err(not_connected())

    page.id.value = insert_document(repo, page)?
    Ok(page.id)


# Update an existing page, setting page.id to its new document id.
#
# The new document goes in first, so a failure can't lose the page; then every
# document the slug had before it goes. Only those: a copy another worker
# saved meanwhile is newer than ours and stays, for the next save to clean up.
# A crash in between leaves extra copies, which readers never see (the newest
# wins). NotFound if the slug has no document at all (deleted meanwhile).
pub fn wiki_page_repo_update(repo: *WikiPageRepository, page: *WikiPage) -> Result<(), RepoError>
    if not repo.connected
        return Err(not_connected())

    var scan: SlugScan
    find_slug(repo, (page.slug).as_view(), @scan)?
    if scan.newest < 0
        return Err(RepoError.NotFound)

    let new_id: i64 = insert_document(repo, page)?
    var i: i64 = 0
    while i < scan.n_ids
        doc_delete(repo, scan.ids[i])     # a failure leaves an older copy: harmless
        i += 1

    page.id.value = new_id
    Ok(())


# Delete a page by ID
pub fn wiki_page_repo_delete(repo: *WikiPageRepository, id: DocumentId) -> Result<(), RepoError>
    if not repo.connected
        return Err(not_connected())

    let result: i64 = doc_delete(repo, id.value)
    if result == 0
        return Err(RepoError.NotFound)
    if result < 0
        return Err(doc_error(result, "Delete failed"))
    Ok(())


# Delete every document holding `slug`: deleting only the newest would bring
# an older copy back. NotFound if there is none.
pub fn wiki_page_repo_delete_slug(repo: *WikiPageRepository, slug: StrView) -> Result<(), RepoError>
    if not repo.connected
        return Err(not_connected())

    var scan: SlugScan
    find_slug(repo, slug, @scan)?
    if scan.n_ids == 0
        return Err(RepoError.NotFound)
    var i: i64 = 0
    while i < scan.n_ids
        let result: i64 = doc_delete(repo, scan.ids[i])
        if result < 0
            return Err(doc_error(result, "Delete failed"))
        i += 1
    Ok(())


# State for one list scan: one page per slug, the newest.
struct ListScan
    pages: Vec<WikiPage>


fn list_scan_reset(user_data: *u8) -> i32
    let scan: *ListScan = user_data as *ListScan
    list_scan_clear(@scan.pages)
    0


fn list_scan_clear(pages: *Vec<WikiPage>)
    var i: i64 = 0
    while i < vec_len<WikiPage>(@*pages)
        let page: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, i)
        wiki_page_drop(page)
        i += 1
    vec_drop<WikiPage>(@&*pages)
    *pages = vec_new<WikiPage>()


# Index of the listed page with `page`'s slug, or -1.
fn list_index_of(pages: *Vec<WikiPage>, page: *WikiPage) -> i64
    let want: StrView = (page.slug).as_view()
    var i: i64 = 0
    while i < vec_len<WikiPage>(@*pages)
        let other: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, i)
        let have: StrView = (other.slug).as_view()
        if have.len() == want.len()
            var same: bool = true
            var j: i64 = 0
            while j < want.len()
                if have.get(j) != want.get(j)
                    same = false
                    break
                j += 1
            if same
                return i
        i += 1
    -1


# Add `page` to `pages`, one per slug: a second copy of a slug replaces the
# first, in its place, only if it is newer (`newest`) or older (not `newest`).
fn list_keep(pages: *Vec<WikiPage>, page: WikiPage, newest: bool)
    var p: WikiPage = page
    let at: i64 = list_index_of(pages, @p)
    if at < 0
        vec_push<WikiPage>(@&*pages, p)
        return
    let other: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, at)
    if (p.id.value > other.id.value) == newest
        wiki_page_drop(other)
        vec_set<WikiPage>(@&*pages, at, p)
    else
        pass


fn list_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *ListScan = user_data as *ListScan
    match decode_stored(doc_id, data, len)
        Ok(page) =>
            list_keep(@&scan.pages, page, true)
            0
        Err(_) =>
            0   # not a page: another app's document


# List all pages, one per slug, in database order
pub fn wiki_page_repo_list_all(repo: *WikiPageRepository) -> Result<Vec<WikiPage>, RepoError>
    if not repo.connected
        return Err(not_connected())

    var scan: ListScan
    scan.pages = vec_new<WikiPage>()
    let scanned: i64 = doc_scan(repo, list_scan_step as *u8, list_scan_reset as *u8, @scan as *u8)
    if scanned < 0
        list_scan_clear(@scan.pages)
        return Err(doc_error(scanned, "Scan failed"))
    Ok(scan.pages)


# ============================================================================
# Pages a pre-#3637 store kept in "default" (AGAST #3681)
#
# Before #3637 every CONNECT name shared one collection, so a deployed store
# holds nexus's pages (and wiki-seed's) in what #3637 opens as the default
# collection, while this repository CONNECTs to "nexus_pages". adopt_default
# moves them on the first dial, so an upgrade needs no operator step:
#
#   1. scan "default" for pages: the newest copy of each slug, and the id of
#      every page document. Anything that isn't a page (another app's) stays;
#   2. insert each page into "nexus_pages", rewritten in the current format;
#   3. delete each inserted copy whose slug "nexus_pages" already held in an
#      older document: that one is the page (a previous move cut short by a
#      crash, another worker moving at once, or a save since). The oldest
#      copy is kept, so a save, always newer than every copy, still wins;
#   4. delete the page documents from "default". A page moved and then
#      deleted can't come back, and the next dial finds nothing to move.
#
# Every step is safe to repeat, so a move cut short is finished by the next
# dial. A worker moving the same pages at the same moment that another deletes
# one could keep a copy of it; that window is the upgrade's first seconds.
# ============================================================================

# The page documents in "default".
struct AdoptScan
    pages: Vec<WikiPage>     # newest copy per slug, id = its "default" id
    ids: Vec<i64>            # every page document


fn adopt_scan_reset(user_data: *u8) -> i32
    let scan: *AdoptScan = user_data as *AdoptScan
    list_scan_clear(@scan.pages)
    vec_drop<i64>(@&scan.ids)
    scan.ids = vec_new<i64>()
    0


fn adopt_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *AdoptScan = user_data as *AdoptScan
    match decode_stored(doc_id, data, len)
        Ok(page) =>
            vec_push<i64>(@&scan.ids, doc_id)
            list_keep(@&scan.pages, page, true)
            0
        Err(_) =>
            0   # not a page: another app's, and it stays in "default"


# Oldest document per slug in "nexus_pages".
fn oldest_scan_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let scan: *ListScan = user_data as *ListScan
    match decode_stored(doc_id, data, len)
        Ok(page) =>
            list_keep(@&scan.pages, page, false)
            0
        Err(_) =>
            0


# The id `pages` holds for `page`'s slug, -1 if none.
fn listed_id(pages: *Vec<WikiPage>, page: *WikiPage) -> i64
    let at: i64 = list_index_of(pages, page)
    if at < 0
        return -1
    let other: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, at)
    other.id.value


# Scan the default collection on `legacy` (connected). < 0 = failed.
fn legacy_scan(legacy: *Db, scan: *AdoptScan) -> i64
    adopt_scan_reset(scan as *u8)
    db_scan(legacy, adopt_scan_step as *u8, scan as *u8) as i64


# Copy `pages` into this repository's collection (steps 2 and 3). 0 = ok.
fn adopt_pages(repo: *WikiPageRepository, pages: *Vec<WikiPage>) -> i64
    let n: i64 = vec_len<WikiPage>(@*pages)
    if n == 0
        return 0
    var copies: Vec<i64> = vec_new<i64>()
    var i: i64 = 0
    var rc: i64 = 0
    while i < n
        let page: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, i)
        match insert_document(repo, page)
            Ok(id) => vec_push<i64>(@&copies, id)
            Err(_) =>
                rc = -1
                break
        i += 1
    if rc == 0
        var oldest: ListScan
        oldest.pages = vec_new<WikiPage>()
        rc = doc_scan(repo, oldest_scan_step as *u8, list_scan_reset as *u8, @oldest as *u8)
        i = 0
        while rc >= 0 and i < vec_len<i64>(@copies)
            let page: *WikiPage = vec_get_ptr<WikiPage>(@&*pages, i)
            let copy: i64 = vec_get<i64>(@copies, i)
            if listed_id(@oldest.pages, page) != copy
                doc_delete(repo, copy)    # a failure leaves a copy: harmless
            i += 1
        list_scan_clear(@oldest.pages)
    if rc < 0 then -1 else 0


# Move the default collection's pages into this repository's collection.
# 0 = done (or nothing to move), < 0 = failed, leaving "default" as it was
# or with fewer pages, every one of them still somewhere.
fn adopt_default(repo: *WikiPageRepository) -> i64
    var legacy: Db
    db_init(@legacy, @repo.db.host[0], repo.db.host_len, repo.db.port, c"default", 7)
    db_set_encryption(@legacy, repo.db.encrypted)
    if db_connect(@legacy) < 0
        return -1
    var scan: AdoptScan
    scan.pages = vec_new<WikiPage>()
    scan.ids = vec_new<i64>()
    var rc: i64 = legacy_scan(@legacy, @scan)
    if rc >= 0
        rc = adopt_pages(repo, @scan.pages)
    var i: i64 = 0
    while rc >= 0 and i < vec_len<i64>(@scan.ids)
        if db_delete(@legacy, vec_get<i64>(@scan.ids, i)) < 0
            rc = -1
        i += 1
    list_scan_clear(@scan.pages)
    db_close(@legacy)
    rc
