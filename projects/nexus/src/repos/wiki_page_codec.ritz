# src/repos/wiki_page_codec.ritz - WikiPage <-> Mausoleum Document bytes
#
# A page is stored as a real Mausoleum Document: the server deserializes every
# insert and rejects anything else. The same bytes are the Tome cache value, so
# a cache hit restores exactly what the database holds. Spire's document
# helpers carry string fields only, so numeric fields are stored in page_doc_decimal.

import ritzlib.gvec { Vec, vec_zeroed }
import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new, string_from, string_from_bytes }
import mausoleum.m7m_types { m7m_timestamp_zero }

import spire.repo.mausoleum { DbField, db_field, db_serialize_doc, db_extract_field }
import mausoleum.document { DocumentId, doc_id_invalid }

import models.wiki_page { WikiPage, wiki_page_new }
import errors.repo_error { RepoError }


const FIELD_COUNT: i32 = 9

# Room for the Document header and the 9 keys around the variable-length
# values. wiki_page_encode reports an error rather than overrun if it is wrong.
const ENCODE_OVERHEAD: i64 = 1024


fn page_doc_text_field(key: StrView, value: @String) -> DbField
    db_field(key, value.as_view())


fn page_doc_decimal(n: i64) -> String
    var s: String = string_new()
    s.push_i64(n)
    s


# The parent's id value, or the invalid id for a root page.
fn parent_value(page: *WikiPage) -> i64
    match page.parent_id
        Some(id) => id.value
        None => doc_id_invalid().value


# Upper bound on the bytes wiki_page_encode writes for `page`.
pub fn wiki_page_encode_bound(page: *WikiPage) -> i64
    (page.slug).len() + (page.title).len() + (page.content).len() + ENCODE_OVERHEAD


# Serialize `page` into `buf`. Returns the byte count, or < 0 if it won't fit.
pub fn wiki_page_encode(page: *WikiPage, buf: [u8]) -> i64
    var id: String = page_doc_decimal(page.id.value)
    var version: String = page_doc_decimal(page.version as i64)
    var created: String = page_doc_decimal(page.created_at.nanos)
    var updated: String = page_doc_decimal(page.updated_at.nanos)
    var author: String = page_doc_decimal(page.author_id.value)
    var parent: String = page_doc_decimal(parent_value(page))

    var fields: [9]DbField
    fields[0] = page_doc_text_field("slug", @page.slug)
    fields[1] = page_doc_text_field("title", @page.title)
    fields[2] = page_doc_text_field("content", @page.content)
    fields[3] = page_doc_text_field("id", @id)
    fields[4] = page_doc_text_field("version", @version)
    fields[5] = page_doc_text_field("created_at", @created)
    fields[6] = page_doc_text_field("updated_at", @updated)
    fields[7] = page_doc_text_field("author_id", @author)
    fields[8] = page_doc_text_field("parent_id", @parent)
    let all: [DbField] = @fields
    db_serialize_doc(buf, all.to(FIELD_COUNT as i64))


# Field `name` of `doc`, extracted into `tmp`, which is as long as `doc`: no
# field can be longer than its document, so db_extract_field can never
# truncate it. The result is a view of `tmp`.
fn page_doc_field(doc: [u8], name: StrView, tmp: [u8]) -> Result<[u8], RepoError>
    let n: i32 = db_extract_field(doc, name, tmp)
    if n < 0
        return Err(RepoError.SerializationError)
    Ok(tmp.to(n as i64))


fn page_doc_text(doc: [u8], name: StrView, tmp: [u8]) -> Result<String, RepoError>
    Ok(string_from_bytes(page_doc_field(doc, name, tmp)?))


fn page_doc_i64(doc: [u8], name: StrView, tmp: [u8]) -> Result<i64, RepoError>
    let digits: [u8] = page_doc_field(doc, name, tmp)?
    match digits.as_strview().parse_i64()
        Some(v) => Ok(v)
        None => Err(RepoError.SerializationError)


fn page_doc_decode(doc: [u8], tmp: [u8]) -> Result<WikiPage, RepoError>
    # Numbers first: a bad document fails before any String is allocated.
    let id: i64 = page_doc_i64(doc, "id", tmp)?
    let version: i64 = page_doc_i64(doc, "version", tmp)?
    let created: i64 = page_doc_i64(doc, "created_at", tmp)?
    let updated: i64 = page_doc_i64(doc, "updated_at", tmp)?
    let author: i64 = page_doc_i64(doc, "author_id", tmp)?
    let parent: i64 = page_doc_i64(doc, "parent_id", tmp)?

    let slug: String = page_doc_text(doc, "slug", tmp)?
    let title: String = page_doc_text(doc, "title", tmp)?
    let content: String = page_doc_text(doc, "content", tmp)?

    var page: WikiPage = wiki_page_new(slug, title, content)
    page.id.value = id
    page.version = version as u64
    page.created_at.nanos = created
    page.updated_at.nanos = updated
    page.author_id.value = author
    if parent != doc_id_invalid().value
        var parent_id: DocumentId = doc_id_invalid()
        parent_id.value = parent
        page.parent_id = Some(parent_id)
    Ok(page)


# Rebuild a page from wiki_page_encode's bytes. Anything else, including a
# Document that lacks a field, is a SerializationError.
pub fn wiki_page_decode(doc: [u8]) -> Result<WikiPage, RepoError>
    if doc.len <= 0
        return Err(RepoError.SerializationError)
    var tmp: Vec<u8> = vec_zeroed<u8>(doc.len)
    if tmp.len() != doc.len
        return Err(RepoError.SerializationError)
    page_doc_decode(doc, tmp[0..doc.len])


fn page_doc_decode_legacy(doc: [u8], tmp: [u8]) -> Result<WikiPage, RepoError>
    let slug: String = page_doc_text(doc, "slug", tmp)?
    if slug.len() == 0
        return Err(RepoError.SerializationError)
    match page_doc_text(doc, "content", tmp)
        Ok(content) =>
            let title: String = legacy_title(doc, @slug, tmp)
            Ok(wiki_page_new(slug, title, content))
        Err(e) =>
            Err(e)


# A legacy page's title: the one wiki-seed stored, else its slug.
fn legacy_title(doc: [u8], slug: *String, tmp: [u8]) -> String
    match page_doc_text(doc, "title", tmp)
        Ok(title) =>
            if title.len() > 0
                return title
            pass
        Err(_) => pass
    string_from(slug.as_view())


# A page as src/store.ritz stored it before AGAST #2209: a Document with only
# `slug` and `content` (wiki-seed's also have a `title`, which is kept,
# AGAST #3681). It becomes a version-1 page titled by its slug, with
# no id (the repository sets it) and zero timestamps; its next save writes it
# back in wiki_page_encode's format. Anything without both fields is a
# SerializationError.
pub fn wiki_page_decode_legacy(doc: [u8]) -> Result<WikiPage, RepoError>
    if doc.len <= 0
        return Err(RepoError.SerializationError)
    var tmp: Vec<u8> = vec_zeroed<u8>(doc.len)
    if tmp.len() != doc.len
        return Err(RepoError.SerializationError)
    let result = page_doc_decode_legacy(doc, tmp[0..doc.len])
    match result
        Ok(page) =>
            var p: WikiPage = page
            p.created_at = m7m_timestamp_zero()
            p.updated_at = m7m_timestamp_zero()
            Ok(p)
        Err(e) => Err(e)
