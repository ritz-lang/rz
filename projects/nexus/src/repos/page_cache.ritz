# src/repos/page_cache.ritz - Page caching layer
#
# Caches WikiPages in an embedded Tome store through Spire's adapter, for the
# wiki service's cache-aside reads. Embedded is the only working mode: Spire's
# TCP mode is not wired, and tome.client cannot link next to mausoleum.client
# (both define client_*).
#
# Values are the same encoded Document the database holds, so a hit returns the
# whole page. Keys are "nexus:page:<slug>".

import ritzlib.memory
import ritzlib.strview { StrView, strview_len, strview_as_ptr }
import ritzlib.string { String, string_from, string_drop, string_as_view, string_push_str }

import spire.repo.tome {
    Cache,
    CACHE_OK,
    cache_init_embedded,
    cache_connect,
    cache_close,
    cache_is_connected,
    cache_get,
    cache_setex,
    cache_del
}

import models.wiki_page { WikiPage }
import errors.repo_error { RepoError }
import repos.wiki_page_codec { wiki_page_encode, wiki_page_encode_bound, wiki_page_decode }


# Default cache TTL in seconds (5 minutes)
const DEFAULT_TTL: i64 = 300


# Page cache backed by Tome
pub struct PageCache
    cache: Cache
    ttl_seconds: i64


# Create a new cache (not connected)
pub fn page_cache_new() -> PageCache
    var pc: PageCache
    pc.cache.initialized = 0
    pc.cache.connected = 0
    pc.ttl_seconds = DEFAULT_TTL
    pc


# Open the embedded store, holding at most `max_memory_bytes` (0 = no limit)
pub fn page_cache_connect(pc: *PageCache, max_memory_bytes: i64) -> Result<(), RepoError>
    if page_cache_is_connected(pc)
        return Ok(())

    if cache_init_embedded(@pc.cache, max_memory_bytes) != CACHE_OK
        return Err(RepoError.CacheError(string_from("Cache init failed")))
    if cache_connect(@pc.cache) != CACHE_OK
        return Err(RepoError.CacheError(string_from("Cache connect failed")))
    Ok(())


# Close the cache, dropping everything in it
pub fn page_cache_disconnect(pc: *PageCache)
    if page_cache_is_connected(pc)
        cache_close(@pc.cache)


# Check connection
pub fn page_cache_is_connected(pc: *PageCache) -> bool
    cache_is_connected(@pc.cache) == 1


# Set cache TTL
pub fn page_cache_set_ttl(pc: *PageCache, ttl_seconds: i64)
    pc.ttl_seconds = ttl_seconds


fn page_cache_key(slug: StrView) -> String
    var key: String = string_from("nexus:page:")
    string_push_str(@&key, slug)
    key


# Get a page from cache by slug. An entry that won't decode counts as a miss.
pub fn page_cache_get(pc: *PageCache, slug: StrView) -> Option<WikiPage>
    if not page_cache_is_connected(pc)
        return None

    var key: String = page_cache_key(slug)
    let view: StrView = string_as_view(@key)
    var data: *u8 = null
    var len: i32 = 0
    let hit: i32 = cache_get(@pc.cache, strview_as_ptr(view), strview_len(view) as i32, @data, @len)
    string_drop(@&key)
    if hit != 1
        return None

    match wiki_page_decode(data, len)
        Ok(page) => Some(page)
        Err(_) => None


# Store a page in cache
pub fn page_cache_set(pc: *PageCache, page: *WikiPage) -> Result<(), RepoError>
    if not page_cache_is_connected(pc)
        return Err(RepoError.CacheError(string_from("Not connected")))

    let bound: i64 = wiki_page_encode_bound(page)
    let buf: *u8 = malloc(bound)
    if buf == null
        return Err(RepoError.CacheError(string_from("Out of memory")))
    let n: i64 = wiki_page_encode(page, buf, bound)
    if n < 0
        free(buf)
        return Err(RepoError.SerializationError)

    var key: String = page_cache_key(string_as_view(@page.slug))
    let view: StrView = string_as_view(@key)
    let result: i32 = cache_setex(@pc.cache, strview_as_ptr(view), strview_len(view) as i32, buf, n as i32, pc.ttl_seconds)
    string_drop(@&key)
    free(buf)
    if result != CACHE_OK
        return Err(RepoError.CacheError(string_from("Cache write failed")))
    Ok(())


# Invalidate a page in cache (on update/delete)
pub fn page_cache_invalidate(pc: *PageCache, slug: StrView) -> Result<(), RepoError>
    if not page_cache_is_connected(pc)
        return Err(RepoError.CacheError(string_from("Not connected")))

    var key: String = page_cache_key(slug)
    let view: StrView = string_as_view(@key)
    let result: i32 = cache_del(@pc.cache, strview_as_ptr(view), strview_len(view) as i32)
    string_drop(@&key)
    if result < 0
        return Err(RepoError.CacheError(string_from("Cache invalidation failed")))
    Ok(())
