# src/services/validation.ritz - Wiki input validation
#
# Pure checks on a page's slug, title and content, shared by the wiki
# service. Split out of wiki_service.ritz (AGAST #2108) so they compile and
# are tested on their own: wiki_service also pulls in the repository and
# cache layers, which do not compile yet (#1377).

import ritzlib.strview { StrView, strview_len, strview_get }
import ritzlib.string { String, string_from }
import errors.service_error { ServiceError }


# Maximum page content size (1 MB)
pub const MAX_CONTENT_SIZE: i64 = 1048576

# Maximum title length
pub const MAX_TITLE_LENGTH: i64 = 256

# Maximum slug length
pub const MAX_SLUG_LENGTH: i64 = 128


# Validate slug format
# Valid: letters, numbers, hyphens, forward slashes
# Must start with a letter, not end with a slash, no double slashes
pub fn validate_slug(slug: StrView) -> Result<(), ServiceError>
    let n: i64 = strview_len(@slug)
    if n == 0
        return Err(ServiceError.InvalidSlug(string_from("Slug cannot be empty")))

    if n > MAX_SLUG_LENGTH
        return Err(ServiceError.InvalidSlug(string_from("Slug too long")))

    # Check first character is a letter
    if not is_letter(strview_get(@slug, 0))
        return Err(ServiceError.InvalidSlug(string_from("Slug must start with letter")))

    # Check last character is not a slash
    if strview_get(@slug, n - 1) == '/' as u8
        return Err(ServiceError.InvalidSlug(string_from("Slug cannot end with slash")))

    # Check all characters are valid
    var i: i64 = 0
    var prev_slash: bool = false
    while i < n
        let c: u8 = strview_get(@slug, i)
        if not (is_letter(c) or is_digit(c) or c == '-' as u8 or c == '/' as u8)
            return Err(ServiceError.InvalidSlug(string_from("Invalid character in slug")))

        # No double slashes
        if c == '/' as u8
            if prev_slash
                return Err(ServiceError.InvalidSlug(string_from("Double slashes not allowed")))
            prev_slash = true
        else
            prev_slash = false

        i += 1

    return Ok(())


# Validate title: non-empty and at most MAX_TITLE_LENGTH bytes
pub fn validate_title(title: StrView) -> Result<(), ServiceError>
    let n: i64 = strview_len(@title)
    if n == 0
        return Err(ServiceError.InvalidTitle)

    if n > MAX_TITLE_LENGTH
        return Err(ServiceError.InvalidTitle)

    return Ok(())


# Validate content: at most MAX_CONTENT_SIZE bytes (empty is allowed)
pub fn validate_content(content: StrView) -> Result<(), ServiceError>
    if strview_len(@content) > MAX_CONTENT_SIZE
        return Err(ServiceError.ContentTooLarge)

    return Ok(())


# Character helpers
fn is_letter(c: u8) -> bool
    return (c >= 'a' as u8 and c <= 'z' as u8) or (c >= 'A' as u8 and c <= 'Z' as u8)


fn is_digit(c: u8) -> bool
    return c >= '0' as u8 and c <= '9' as u8
