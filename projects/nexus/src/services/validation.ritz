# src/services/validation.ritz - Wiki input validation
#
# Pure checks on a page's slug, title and content, used by the wiki service.

import ritzlib.strview { StrView, strview_len }
import slug { SlugVerdict, slug_check }
import ritzlib.string { String, string_from }
import errors.service_error { ServiceError }


# Maximum page content size: what one mausoleum document (MAX_DOC_SIZE,
# 32768 bytes since overflow pages, AGAST #3638) leaves once the rest of
# the page is as long as allowed (AGAST #2208). wiki_page_codec stores 9
# string fields: 52 bytes of document header, 16 bytes framing per field,
# 63 bytes of field names, slug (128), title (256) and six numbers of up to
# 20 digits (120) = 763 bytes. It was 1 MB, so a page mausoleum refused got
# past validation and became a database error (HTTP 500) instead of
# ContentTooLarge (413).
# test_codec_longest_valid_page_is_one_max_document pins this.
pub const MAX_CONTENT_SIZE: i64 = 32005

# Maximum title length
pub const MAX_TITLE_LENGTH: i64 = 256

# Maximum slug length
pub const MAX_SLUG_LENGTH: i64 = 128


# Validate a slug against the one slug rule (src/slug.ritz, AGAST #2209),
# the rule the routes use too.
pub fn validate_slug(slug: StrView) -> Result<(), ServiceError>
    let n: i64 = strview_len(slug)
    if n > MAX_SLUG_LENGTH
        return Err(ServiceError.InvalidSlug(string_from("Slug too long")))
    let verdict: SlugVerdict = slug_check(slug)
    if verdict == SlugVerdict.Ok
        return Ok(())
    if verdict == SlugVerdict.Empty
        return Err(ServiceError.InvalidSlug(string_from("Slug cannot be empty")))
    if verdict == SlugVerdict.EmptySegment
        return Err(ServiceError.InvalidSlug(string_from("Slug cannot start or end with a slash, or have two in a row")))
    if verdict == SlugVerdict.Reserved
        return Err(ServiceError.InvalidSlug(string_from("Slug is a route word (new, or ending in /edit)")))
    Err(ServiceError.InvalidSlug(string_from("Slug may hold only a-z, 0-9, '-' and '/'")))


# Validate title: non-empty and at most MAX_TITLE_LENGTH bytes
pub fn validate_title(title: StrView) -> Result<(), ServiceError>
    let n: i64 = strview_len(title)
    if n == 0
        return Err(ServiceError.InvalidTitle)

    if n > MAX_TITLE_LENGTH
        return Err(ServiceError.InvalidTitle)

    return Ok(())


# Validate content: at most MAX_CONTENT_SIZE bytes (empty is allowed)
pub fn validate_content(content: StrView) -> Result<(), ServiceError>
    validate_content_within(content, MAX_CONTENT_SIZE)


# Validate content against a store's own limit (wiki_page_repo_max_content_len:
# the in-memory store holds more than one Mausoleum document).
pub fn validate_content_within(content: StrView, limit: i64) -> Result<(), ServiceError>
    if strview_len(content) > limit
        return Err(ServiceError.ContentTooLarge)

    return Ok(())
