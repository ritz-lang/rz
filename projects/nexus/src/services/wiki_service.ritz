# src/services/wiki_service.ritz - Wiki business logic
#
# Core business logic for wiki operations:
# - Page creation with slug validation
# - Page updates with version tracking
# - Cache-aside reads through the page cache
# - Slug hierarchy queries
#
# Cache failures never fail a request: the database is the source of truth, and
# a write only reaches the cache-invalidation step once the database has it.

import ritzlib.strview { StrView, strview_starts_with }
import ritzlib.string { String, string_from, string_push, string_as_view }
import ritzlib.gvec { Vec, vec_new, vec_push, vec_len, vec_get, vec_drop }

import models.wiki_page {
    WikiPage,
    wiki_page_new,
    wiki_page_update_content,
    wiki_page_update_title,
    wiki_page_drop
}
import repos.wiki_page_repo {
    WikiPageRepository,
    wiki_page_repo_get_by_slug,
    wiki_page_repo_insert,
    wiki_page_repo_update,
    wiki_page_repo_delete,
    wiki_page_repo_list_all
}
import repos.page_cache {
    PageCache,
    page_cache_get,
    page_cache_set,
    page_cache_invalidate
}
import errors.service_error { ServiceError, service_error_from_repo }
import errors.repo_error { RepoError, repo_error_is_not_found }
import services.validation { validate_slug, validate_title, validate_content }


# Wiki service - manages wiki page operations
pub struct WikiService
    repo: *WikiPageRepository
    cache: *PageCache


# Create a new wiki service
pub fn wiki_service_new(repo: *WikiPageRepository, cache: *PageCache) -> WikiService
    WikiService {
        repo: repo,
        cache: cache
    }


# The authoritative page, straight from the database
fn load_page(svc: *WikiService, slug: StrView) -> Result<WikiPage, ServiceError>
    match wiki_page_repo_get_by_slug(svc.repo, slug)
        Ok(page) => Ok(page)
        Err(e) => Err(service_error_from_repo(e))


# A repository outcome as a service outcome, for `?`
fn from_repo(result: Result<(), RepoError>) -> Result<(), ServiceError>
    match result
        Ok(_) => Ok(())
        Err(e) => Err(service_error_from_repo(e))


# Write `page` back to the database, then drop any cached copy
fn store_page(svc: *WikiService, page: *WikiPage) -> Result<(), ServiceError>
    from_repo(wiki_page_repo_update(svc.repo, page))?
    page_cache_invalidate(svc.cache, string_as_view(@page.slug))
    Ok(())


# Ok only if no page has this slug yet
fn ensure_absent(svc: *WikiService, slug: StrView) -> Result<(), ServiceError>
    match wiki_page_repo_get_by_slug(svc.repo, slug)
        Ok(existing) =>
            wiki_page_drop(@existing)
            Err(ServiceError.AlreadyExists)
        Err(e) =>
            if repo_error_is_not_found(@e)
                Ok(())
            else
                Err(service_error_from_repo(e))


# Insert a new page, freeing it if the database refuses it
fn insert_page(svc: *WikiService, page: *WikiPage) -> Result<(), ServiceError>
    match wiki_page_repo_insert(svc.repo, page)
        Ok(_) => Ok(())
        Err(e) =>
            wiki_page_drop(page)
            Err(service_error_from_repo(e))


# The page from the database, cached for the next read
fn load_and_cache_page(svc: *WikiService, slug: StrView) -> Result<WikiPage, ServiceError>
    var page: WikiPage = load_page(svc, slug)?
    page_cache_set(svc.cache, @page)
    Ok(page)


# Get a page by slug, using cache-aside pattern
pub fn wiki_service_get_page(svc: *WikiService, slug: StrView) -> Result<WikiPage, ServiceError>
    match page_cache_get(svc.cache, slug)
        Some(cached) => Ok(cached)
        None => load_and_cache_page(svc, slug)


# Create a new page
pub fn wiki_service_create_page(svc: *WikiService, slug: StrView, title: StrView, content: StrView) -> Result<WikiPage, ServiceError>
    validate_slug(slug)?
    validate_title(title)?
    validate_content(content)?

    ensure_absent(svc, slug)?

    var page: WikiPage = wiki_page_new(string_from(slug), string_from(title), string_from(content))
    insert_page(svc, @page)?
    page_cache_set(svc.cache, @page)
    Ok(page)


# Update page content
pub fn wiki_service_update_content(svc: *WikiService, slug: StrView, new_content: StrView) -> Result<WikiPage, ServiceError>
    validate_content(new_content)?

    var page: WikiPage = load_page(svc, slug)?
    wiki_page_update_content(@page, string_from(new_content))
    store_page(svc, @page)?
    Ok(page)


# Update page title
pub fn wiki_service_update_title(svc: *WikiService, slug: StrView, new_title: StrView) -> Result<WikiPage, ServiceError>
    validate_title(new_title)?

    var page: WikiPage = load_page(svc, slug)?
    wiki_page_update_title(@page, string_from(new_title))
    store_page(svc, @page)?
    Ok(page)


# Delete a page
pub fn wiki_service_delete_page(svc: *WikiService, slug: StrView) -> Result<(), ServiceError>
    var page: WikiPage = load_page(svc, slug)?
    let result = wiki_page_repo_delete(svc.repo, page.id)
    wiki_page_drop(@page)
    from_repo(result)?
    page_cache_invalidate(svc.cache, slug)
    Ok(())


# Check if a page exists
pub fn wiki_service_page_exists(svc: *WikiService, slug: StrView) -> bool
    match wiki_service_get_page(svc, slug)
        Ok(page) =>
            wiki_page_drop(@page)
            true
        Err(_) => false


# Every page, in database order
pub fn wiki_service_list_pages(svc: *WikiService) -> Result<Vec<WikiPage>, ServiceError>
    match wiki_page_repo_list_all(svc.repo)
        Ok(pages) => Ok(pages)
        Err(e) => Err(service_error_from_repo(e))


# Pages below `parent_slug`: every slug starting with parent_slug + "/"
pub fn wiki_service_get_children(svc: *WikiService, parent_slug: StrView) -> Result<Vec<WikiPage>, ServiceError>
    var prefix: String = string_from(parent_slug)
    string_push(@&prefix, '/' as u8)
    let prefix_view: StrView = string_as_view(@prefix)

    var pages: Vec<WikiPage> = wiki_service_list_pages(svc)?
    var children: Vec<WikiPage> = vec_new<WikiPage>()
    var i: i64 = 0
    while i < vec_len<WikiPage>(@pages)
        var page: WikiPage = vec_get<WikiPage>(@pages, i)
        let slug: StrView = string_as_view(@page.slug)
        if strview_starts_with(slug, prefix_view)
            vec_push<WikiPage>(@&children, page)
        else
            wiki_page_drop(@page)
        i += 1
    vec_drop<WikiPage>(@&pages)
    Ok(children)
