# src/form.ritz - application/x-www-form-urlencoded request bodies
#
# The create and edit forms POST `slug=...&content=...`. A field's value is a
# String of its URL-decoded bytes, owned by the caller; the body is only read.

import ritzlib.strview { StrView }
import ritzlib.string { String, string_with_cap }


# One hex digit's value; 0 for anything else.
fn hex_value(c: u8) -> u8
    if c >= '0' and c <= '9'
        return c - '0'
    if c >= 'A' and c <= 'F'
        return c - 'A' + 10
    if c >= 'a' and c <= 'f'
        return c - 'a' + 10
    0


# `src` URL-decoded: '+' is a space, %XX the byte XX.
pub fn url_decode(src: StrView) -> String
    var out: String = string_with_cap(src.len())
    let len: i64 = src.len()
    var i: i64 = 0
    while i < len
        let c: u8 = src.get(i)
        if c == '+'
            out.push(' ')
            i += 1
        else if c == '%' and i + 2 < len
            out.push((hex_value(src.get(i + 1)) << 4) | hex_value(src.get(i + 2)))
            i += 3
        else
            out.push(c)
            i += 1
    out


# Form field `name` of an application/x-www-form-urlencoded body,
# URL-decoded, or None if the body has no `name=` pair.
pub fn form_field(body: StrView, name: StrView) -> Option<String>
    var rest: StrView = body
    var more: bool = true
    while more
        var pair: StrView = rest
        let amp: i64 = rest.find_byte('&')      # rest.len() if there is none
        if amp < rest.len()
            pair = rest.take(amp)
            rest = rest.skip(amp + 1)
        else
            more = false
        if pair.len() > name.len() and pair.starts_with(name) and pair.get(name.len()) == '='
            return Some(url_decode(pair.skip(name.len() + 1)))
    None
