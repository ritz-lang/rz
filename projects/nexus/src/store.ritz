# src/store.ritz - Wiki page store backed by Mausoleum via Spire
#
# Each page is one mausoleum Document with two string fields, `slug` and
# `content`.
#
# The database is the only copy of a page (AGAST #2459). zeus runs several
# nexus workers, each a separate process with its own store, and consecutive
# requests land on different workers. This store used to keep a per-worker
# slug -> doc-id index (built once at startup) and a per-worker tome cache, so
# a page created through one worker was a 404 on the other, and an edit showed
# on alternate requests only. Now every operation asks mausoleum:
#
#   - get scans for the slug and returns the newest document holding it, so
#     a save interrupted between its insert and its delete, or two workers
#     saving at once, still serves one consistent (the latest) version;
#   - save inserts the new document first (a failure can't lose the page),
#     then deletes every older document for the slug;
#   - list and count scan, de-duplicating slugs.
#
# Mausoleum has no secondary index, so a slug lookup is O(pages) per request
# (as in src/repos/wiki_page_repo.ritz). That is the price of coherence until
# it has one; a per-worker cache can't be invalidated by another worker.
#
# Without mausoleum, a single worker serves an in-memory store (its pages are
# the only copy, so they are coherent, if not durable). With several workers
# that would be several divergent wikis, so the store refuses instead:
# STORE_UNAVAILABLE, every request fails. A connection lost after startup is
# an error for that request (never a silent switch to private pages); the
# next request dials again, so nexus recovers when mausoleum comes back.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.string { String, string_drop, string_push_cstr, string_push_i64 }
import ritzlib.strview { StrView }
import ritzlib.os.env { env_get_or }

import spire.repo.mausoleum { Db, DbField }
import spire.repo.mausoleum { db_init, db_set_encryption, db_connect, db_close, db_is_connected }
import spire.repo.mausoleum { db_insert, db_delete, db_scan }
import spire.repo.mausoleum { db_serialize_doc, db_field, db_extract_field }

import src.log { log_begin, log_end, log_cstr }

# ============================================================================
# Constants
# ============================================================================

const STORE_MAX_PAGES: i32 = 100
const MAX_SLUG_LEN: i32 = 128
const MAX_CONTENT_LEN: i32 = 8192
const MAX_COPIES: i32 = 64          # documents per slug a save will clean up
const LIST_SCRATCH: i32 = 65536

# wiki_store_init's outcome, which is the store's mode for the process.
pub const STORE_MAUSOLEUM: i32 = 0       # pages live in mausoleum
pub const STORE_FALLBACK: i32 = 1        # one worker, in-memory pages
pub const STORE_UNAVAILABLE: i32 = -1    # several workers, no mausoleum: refuse

# client_connect / client_connect_encrypted results worth explaining.
const CONNECT_REFUSED: i32 = -4          # nothing accepted the TCP connection
const CONNECT_NO_REPLY: i32 = -6         # handshake / CONNECT reply never came

# ============================================================================
# Configuration and state
# ============================================================================

var g_host: [64]u8
var g_host_len: i32 = 0
var g_port: i32 = 7777
var g_encrypted: i32 = 1     # mausoleum's default serve mode
var g_workers: i32 = 1       # how many workers zeus runs (argv[3])

var g_config_error: i32 = 0  # MAUSOLEUM_HOST / _PORT unusable: refuse to serve

var g_db: Db
var g_mode: i32 = -1       # STORE_UNAVAILABLE until wiki_store_init
var g_db_down_logged: i32 = 0


# Set mausoleum connection info
pub fn wiki_store_set_connection(host: *u8, host_len: i32, port: i32)
    if host_len > 63
        g_host_len = 63
    else
        g_host_len = host_len

    for i in 0..g_host_len
        g_host[i] = *(host + i)
    g_host[g_host_len] = 0  # Null terminate
    g_port = port


# Where mausoleum is, from MAUSOLEUM_HOST / MAUSOLEUM_PORT's values (AGAST
# #3065). "" means unset: keep what is configured (127.0.0.1:7777 by
# default). Before this nexus always dialed 127.0.0.1:7777, so a test stack
# talked to whatever mausoleum another process had up there.
#
# A value that is set but unusable (port not 1..65535, host over 63 bytes)
# returns -1 and makes wiki_store_init refuse (STORE_UNAVAILABLE): falling
# back to the default address would reach the wrong store, silently.
pub fn wiki_store_configure(host: StrView, port: StrView) -> i32
    if host.len > 63
        log_config_error(c"MAUSOLEUM_HOST is longer than 63 bytes")
        return -1
    var p: i64 = g_port as i64
    if port.len > 0
        p = 0
        for i in 0..port.len
            let c: u8 = *(port.ptr + i)
            if c < '0' or c > '9' or p > 65535
                p = 0
                break
            p = p * 10 + (c - 48) as i64
        if p < 1 or p > 65535
            log_config_error(c"MAUSOLEUM_PORT is not a port number (1..65535)")
            return -1
    if host.len > 0
        wiki_store_set_connection(host.ptr, host.len as i32, p as i32)
    else
        if g_host_len == 0
            wiki_store_set_connection(c"127.0.0.1", 9, p as i32)
        else
            g_port = p as i32
    0


# wiki_store_configure with this process's MAUSOLEUM_HOST / MAUSOLEUM_PORT.
pub fn wiki_store_configure_from_env() -> i32
    wiki_store_configure(env_get_or("MAUSOLEUM_HOST", ""), env_get_or("MAUSOLEUM_PORT", ""))


fn log_config_error(why: *u8)
    g_config_error = 1
    var line: String = log_begin()
    string_push_cstr(@&line, c"[STORE] ")
    string_push_cstr(@&line, why)
    string_push_cstr(@&line, c"; REFUSING to serve pages until it is fixed")
    log_end(@&line)


# For tests: forget a rejected configuration.
pub fn wiki_store_clear_config_error()
    g_config_error = 0


# The configured mausoleum address (NUL-terminated host).
pub fn wiki_store_host() -> *u8
    @g_host[0]


pub fn wiki_store_port() -> i32
    g_port


# 1 = encrypted transport (the default, as mausoleum serves), 0 = plaintext
# for a mausoleum running with --no-encryption.
pub fn wiki_store_set_encryption(enabled: i32)
    g_encrypted = enabled


# How many workers serve this wiki. With more than one, a missing mausoleum is
# fatal to every request rather than a private in-memory wiki per worker.
pub fn wiki_store_set_worker_count(n: i32)
    g_workers = n


# Why a connect failed, for the log; null if there is nothing to add.
pub fn wiki_store_connect_hint(err: i32, encrypted: i32) -> *u8
    if err == CONNECT_NO_REPLY
        if encrypted != 0
            return c"it accepted the connection but never completed the encrypted handshake: is it running with --no-encryption? nexus speaks the encrypted protocol"
        return c"it accepted the connection but never answered the plaintext CONNECT: is it running encrypted (mausoleum's default)?"
    if err == CONNECT_REFUSED
        return c"nothing accepted the connection: is mausoleum running there?"
    return null


# ============================================================================
# Connection
# ============================================================================

fn log_connect_failure(err: i32)
    var line: String = log_begin()
    string_push_cstr(@&line, c"[STORE] Failed to connect to mausoleum at ")
    string_push_cstr(@&line, @g_host[0])
    string_push_cstr(@&line, c":")
    string_push_i64(@&line, g_port as i64)
    string_push_cstr(@&line, c" (error ")
    string_push_i64(@&line, err as i64)
    string_push_cstr(@&line, c")")
    let hint: *u8 = wiki_store_connect_hint(err, g_encrypted)
    if hint != null
        string_push_cstr(@&line, c": ")
        string_push_cstr(@&line, hint)
    log_end(@&line)


# Dial mausoleum if not connected. 0 = connected, < 0 = the connect error.
fn ensure_db() -> i32
    if db_is_connected(@g_db) == 1
        return 0
    db_init(@g_db, @g_host[0], g_host_len, g_port, c"wiki", 4)
    db_set_encryption(@g_db, g_encrypted)
    let rc: i32 = db_connect(@g_db)
    if rc < 0
        # Once per outage, not once per request.
        if g_db_down_logged == 0
            log_connect_failure(rc)
            g_db_down_logged = 1
        return rc
    if g_db_down_logged != 0
        log_cstr(c"[STORE] Reconnected to mausoleum")
        g_db_down_logged = 0
    return 0


# Forget a connection that failed mid-request; the next ensure_db redials.
fn drop_db()
    db_close(@g_db)


# Initialize the store and connect to mausoleum via Spire. Returns the mode.
pub fn wiki_store_init() -> i32
    fallback_init()
    g_db_down_logged = 0
    g_db.client = null
    g_db.connected = 0

    # Set default connection if not configured
    if g_host_len == 0
        wiki_store_set_connection(c"127.0.0.1", 9, g_port)

    if g_config_error != 0
        log_cstr(c"[STORE] Not connecting: the mausoleum address is misconfigured (see above)")
        g_mode = STORE_UNAVAILABLE
        return g_mode

    var line: String = log_begin()
    string_push_cstr(@&line, c"[STORE] Connecting to mausoleum via Spire at ")
    string_push_cstr(@&line, @g_host[0])
    string_push_cstr(@&line, c":")
    string_push_i64(@&line, g_port as i64)
    if g_encrypted == 0
        string_push_cstr(@&line, c" (plaintext)")
    log_end(@&line)

    if ensure_db() == 0
        log_cstr(c"[STORE] Connected to mausoleum via Spire!")
        g_mode = STORE_MAUSOLEUM
        return g_mode

    if g_workers > 1
        var refuse: String = log_begin()
        string_push_cstr(@&refuse, c"[STORE] REFUSING to serve pages: ")
        string_push_i64(@&refuse, g_workers as i64)
        string_push_cstr(@&refuse, c" workers would each keep a private in-memory wiki. Start mausoleum (or run zeus -w 1); every page request fails until then")
        log_end(@&refuse)
        g_mode = STORE_UNAVAILABLE
        return g_mode

    log_cstr(c"[STORE] Falling back to in-memory mode (single worker; pages are lost on restart)")
    g_mode = STORE_FALLBACK
    return g_mode


# The store's mode, as wiki_store_init returned it.
pub fn wiki_store_mode() -> i32
    g_mode


# Close the store connection
pub fn wiki_store_close()
    db_close(@g_db)


# ============================================================================
# Document encoding (using Spire's Mausoleum helpers)
# ============================================================================

# Encode a wiki page using Spire's db_serialize_doc
# Returns serialized length, or -1 on error
fn encode_page(buf: *u8, buf_len: i64, slug: *u8, slug_len: i32, content: *u8, content_len: i32) -> i32
    var fields: [2]DbField
    fields[0] = db_field(c"slug", 4, slug, slug_len)
    fields[1] = db_field(c"content", 7, content, content_len)

    let size: i64 = db_serialize_doc(buf, buf_len, @fields[0], 2)
    if size < 0
        return -1
    return size as i32


fn store_bytes_eq(a: *u8, b: *u8, len: i32) -> bool
    for i in 0..len
        if *(a + i) != *(b + i)
            return false
    true


# ============================================================================
# Slug lookup: one scan per request
# ============================================================================

# State for one slug scan. `content_out` may be null (save only wants ids).
struct Lookup
    slug: *u8
    slug_len: i32
    tmp: [129]u8             # stored slug, one byte past the longest valid
    best_id: i64             # newest document holding the slug, -1 if none
    content_out: *u8
    content_len_out: *i32
    ids: [64]i64             # every document holding the slug (MAX_COPIES)
    n_ids: i32


fn lookup_reset(lk: *Lookup)
    lk.best_id = -1
    lk.n_ids = 0


fn lookup_step(doc_id: i64, data: *u8, len: i32, user: *u8) -> i32
    let lk: *Lookup = user as *Lookup
    let n: i32 = db_extract_field(data, len, c"slug", 4, @lk.tmp[0], MAX_SLUG_LEN + 1)
    if n != lk.slug_len or not store_bytes_eq(@lk.tmp[0], lk.slug, n)
        return 0
    if lk.n_ids < MAX_COPIES
        lk.ids[lk.n_ids] = doc_id
        lk.n_ids += 1
    # Ids grow with every insert, so the largest is the latest save.
    if doc_id > lk.best_id
        lk.best_id = doc_id
        if lk.content_out != null
            let c: i32 = db_extract_field(data, len, c"content", 7, lk.content_out, MAX_CONTENT_LEN)
            if c < 0
                *lk.content_len_out = 0
            else
                *lk.content_len_out = c
    0   # never stop early: always read the whole collection


# Scan for `lk.slug`, redialling once if the connection had gone stale.
# 0 = scanned (lk.best_id < 0 if absent), < 0 = mausoleum unreachable.
fn lookup(lk: *Lookup) -> i32
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db() == 0
            lookup_reset(lk)
            if db_scan(@g_db, lookup_step as *u8, lk as *u8) >= 0
                return 0
            drop_db()
        attempt += 1
    return -1


# ============================================================================
# In-memory fallback (one worker, no mausoleum)
# ============================================================================

struct FallbackPage
    used: i32
    slug: [128]u8
    slug_len: i32
    content: [8192]u8
    content_len: i32

var g_fallback: [100]FallbackPage
var g_fallback_count: i32

fn fallback_init()
    g_fallback_count = 0
    for i in 0..STORE_MAX_PAGES
        g_fallback[i].used = 0

fn fallback_find(slug: *u8, slug_len: i32) -> i32
    for i in 0..STORE_MAX_PAGES
        if g_fallback[i].used == 1
            if g_fallback[i].slug_len == slug_len and store_bytes_eq(@g_fallback[i].slug[0], slug, slug_len)
                return i
    return -1

fn fallback_get(slug: *u8, slug_len: i32, content_out: *u8, content_len_out: *i32) -> i32
    let idx: i32 = fallback_find(slug, slug_len)
    if idx < 0
        return 0

    let page: *FallbackPage = @g_fallback[idx]
    *content_len_out = page.content_len
    for i in 0..page.content_len
        *(content_out + i) = page.content[i]

    return 1

fn fallback_save(slug: *u8, slug_len: i32, content: *u8, content_len: i32) -> i32
    var idx: i32 = fallback_find(slug, slug_len)

    if idx < 0
        for i in 0..STORE_MAX_PAGES
            if g_fallback[i].used == 0
                idx = i
                break

        if idx < 0
            return 0

        g_fallback_count += 1

    let page: *FallbackPage = @g_fallback[idx]
    page.used = 1
    page.slug_len = slug_len
    page.content_len = content_len

    for i in 0..slug_len
        page.slug[i] = *(slug + i)

    for i in 0..content_len
        page.content[i] = *(content + i)

    return 1

fn fallback_delete(slug: *u8, slug_len: i32) -> i32
    let idx: i32 = fallback_find(slug, slug_len)
    if idx < 0
        return 0

    g_fallback[idx].used = 0
    g_fallback_count -= 1
    return 1

fn fallback_list(buf: *u8, max_len: i32) -> i32
    var pos: i32 = 0
    var count: i32 = 0

    for i in 0..STORE_MAX_PAGES
        if g_fallback[i].used == 1
            let page: *FallbackPage = @g_fallback[i]

            if pos + page.slug_len + 1 > max_len
                break

            for j in 0..page.slug_len
                *(buf + pos) = page.slug[j]
                pos += 1

            *(buf + pos) = 10
            pos += 1
            count += 1

    return count


# ============================================================================
# Listing: one scan, slugs de-duplicated
# ============================================================================

struct Listing
    buf: *u8
    max_len: i32
    pos: i32
    count: i32
    tmp: [129]u8


# Is `slug` already a line of the listing?
fn listing_has(ls: *Listing, slug: *u8, slug_len: i32) -> bool
    var start: i32 = 0
    var i: i32 = 0
    while i < ls.pos
        if *(ls.buf + i) == 10
            if i - start == slug_len and store_bytes_eq(ls.buf + start, slug, slug_len)
                return true
            start = i + 1
        i += 1
    false


fn listing_step(doc_id: i64, data: *u8, len: i32, user: *u8) -> i32
    let ls: *Listing = user as *Listing
    let n: i32 = db_extract_field(data, len, c"slug", 4, @ls.tmp[0], MAX_SLUG_LEN + 1)
    if n <= 0 or n > MAX_SLUG_LEN
        return 0                  # not a page document
    if listing_has(ls, @ls.tmp[0], n)
        return 0                  # an older copy of a listed page
    if ls.pos + n + 1 > ls.max_len
        return 0                  # full: keep draining the scan
    for j in 0..n
        *(ls.buf + ls.pos) = ls.tmp[j]
        ls.pos += 1
    *(ls.buf + ls.pos) = 10
    ls.pos += 1
    ls.count += 1
    0


fn mausoleum_list(buf: *u8, max_len: i32) -> i32
    var ls: Listing
    ls.buf = buf
    ls.max_len = max_len
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db() == 0
            ls.pos = 0
            ls.count = 0
            if db_scan(@g_db, listing_step as *u8, @ls as *u8) >= 0
                return ls.count
            drop_db()
        attempt += 1
    return -1


# ============================================================================
# Public API
# ============================================================================

# Get a page by slug.
# Returns 1 (content copied out), 0 (no such page), < 0 (store unavailable).
pub fn wiki_store_get(slug: *u8, slug_len: i32, content_out: *u8, content_len_out: *i32) -> i32
    if g_mode == STORE_FALLBACK
        return fallback_get(slug, slug_len, content_out, content_len_out)
    if g_mode != STORE_MAUSOLEUM
        return -1
    if slug_len <= 0 or slug_len > MAX_SLUG_LEN
        return 0

    var lk: Lookup
    lk.slug = slug
    lk.slug_len = slug_len
    lk.content_out = content_out
    lk.content_len_out = content_len_out
    *content_len_out = 0
    if lookup(@lk) < 0
        return -1
    if lk.best_id < 0
        return 0
    return 1


# Insert `buf`, redialling once if the connection had gone stale.
fn insert_doc(buf: *u8, len: i32) -> i64
    var attempt: i32 = 0
    while attempt < 2
        if ensure_db() == 0
            let id: i64 = db_insert(@g_db, buf, len)
            if id >= 0
                return id
            drop_db()
        attempt += 1
    return -1


# Save a page (insert or update). Returns 1 on success, 0 on failure.
pub fn wiki_store_save(slug: *u8, slug_len: i32, content: *u8, content_len: i32) -> i32
    if slug_len <= 0 or slug_len > MAX_SLUG_LEN or content_len > MAX_CONTENT_LEN
        return 0
    if g_mode == STORE_FALLBACK
        return fallback_save(slug, slug_len, content, content_len)
    if g_mode != STORE_MAUSOLEUM
        return 0

    # The documents this save replaces.
    var lk: Lookup
    lk.slug = slug
    lk.slug_len = slug_len
    lk.content_out = null
    if lookup(@lk) < 0
        return 0

    var buf: [8500]u8  # 4 + 128 + 8192 + field headers
    let encoded_len: i32 = encode_page(@buf[0], 8500, slug, slug_len, content, content_len)
    if encoded_len < 0
        return 0

    # New document first: if the deletes below fail, readers already see it
    # (it is the newest), and the next save cleans up what's left.
    if insert_doc(@buf[0], encoded_len) < 0
        log_cstr(c"[STORE] Insert failed")
        return 0

    for i in 0..lk.n_ids
        db_delete(@g_db, lk.ids[i])

    return 1


# Delete a page (every document holding the slug).
# Returns 1 if deleted, 0 if there was no such page, < 0 if unavailable.
pub fn wiki_store_delete(slug: *u8, slug_len: i32) -> i32
    if g_mode == STORE_FALLBACK
        return fallback_delete(slug, slug_len)
    if g_mode != STORE_MAUSOLEUM
        return -1

    var lk: Lookup
    lk.slug = slug
    lk.slug_len = slug_len
    lk.content_out = null
    if lookup(@lk) < 0
        return -1
    if lk.n_ids == 0
        return 0
    for i in 0..lk.n_ids
        if db_delete(@g_db, lk.ids[i]) < 0
            drop_db()
            return -1
    return 1


# List page slugs, each followed by '\n', into `buf`.
# Returns how many were written, or < 0 if the store is unavailable.
pub fn wiki_store_list(buf: *u8, max_len: i32) -> i32
    if g_mode == STORE_FALLBACK
        return fallback_list(buf, max_len)
    if g_mode != STORE_MAUSOLEUM
        return -1
    mausoleum_list(buf, max_len)


# Number of pages, or < 0 if the store is unavailable.
pub fn wiki_store_count() -> i32
    if g_mode == STORE_FALLBACK
        return g_fallback_count
    let scratch: *u8 = malloc(LIST_SCRATCH as i64)
    if scratch == null
        return -1
    let n: i32 = wiki_store_list(scratch, LIST_SCRATCH)
    free(scratch)
    n


# Seed with initial pages when the wiki is empty. Several workers may race to
# do this; a save replaces any copy another worker wrote, so they converge.
pub fn store_seed()
    if wiki_store_count() != 0
        return

    log_cstr(c"[STORE] Seeding initial pages...")
    wiki_store_save(c"welcome", 7, c"# Welcome to Nexus Wiki\n\nThis is your knowledge base powered by Ritz.\n\nThe entire stack - HTTP server, database, and this wiki - is written in Ritz!", 152)
    wiki_store_save(c"getting-started", 15, c"# Getting Started\n\nLearn how to use the Nexus Wiki.\n\n1. Browse pages from the home page\n2. Click 'Edit' to modify a page\n3. Click '+ New Page' to create a page", 166)
    wiki_store_save(c"ritz-language", 13, c"# Ritz Language\n\nRitz is a systems programming language that compiles to LLVM IR.\n\n- No libc dependency\n- Direct Linux syscalls\n- Memory safe (coming soon)", 168)
    log_cstr(c"[STORE] Seeded 3 pages")
