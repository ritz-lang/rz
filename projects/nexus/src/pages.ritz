# src/pages.ritz - Nexus HTML pages and HTTP headers, rendered into a String
#
# Each renderer appends a complete page to `out`, a growable ritzlib String,
# so no input size can overrun a buffer (AGAST #1870: these were fixed
# [16384]u8 / [8192]u8 / [4096]u8 stack buffers with no bounds checks).
#
# Every byte that did not come from this file is escaped: page content and
# slugs (in text, hrefs and form actions alike).  Routes also validate slugs
# to [a-z0-9-] (src/slug.ritz), so escaping a slug is defence in depth; the
# index's slugs come from the store, which the router never saw.

import ritzlib.strview { StrView }
import ritzlib.string { String }

import src.html_writer { html_bytes, html_escaped }


# ============================================================================
# Page chrome
# ============================================================================

# `title` is always a literal from this program, never request data.
fn write_html_head(out: @&String, title: StrView)
    html_bytes(out, "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>")
    html_bytes(out, title)
    html_bytes(out, "</title><style>")
    html_bytes(out, "body{font-family:system-ui,sans-serif;max-width:800px;margin:2rem auto;padding:0 1rem;line-height:1.6}")
    html_bytes(out, "h1{color:#333}a{color:#0066cc}")
    html_bytes(out, ".pages{list-style:none;padding:0}")
    html_bytes(out, ".pages li{margin:.5rem 0;padding:.5rem;background:#f5f5f5;border-radius:4px}")
    html_bytes(out, ".content{background:#f9f9f9;padding:1rem;border-radius:4px;margin:1rem 0;white-space:pre-wrap}")
    html_bytes(out, "textarea{width:100%;height:300px;font-family:monospace;padding:.5rem}")
    html_bytes(out, "input[type=text]{width:100%;padding:.5rem;margin:.5rem 0}")
    html_bytes(out, "button{background:#0066cc;color:white;border:none;padding:.5rem 1rem;cursor:pointer;border-radius:4px}")
    html_bytes(out, "button:hover{background:#0055aa}")
    html_bytes(out, ".nav{margin-bottom:1rem}")
    html_bytes(out, ".actions{margin-top:1rem}")
    html_bytes(out, ".success{background:#d4edda;padding:1rem;border-radius:4px;margin:1rem 0}")
    html_bytes(out, "</style></head><body>")


fn write_html_footer(out: @&String)
    html_bytes(out, "<hr><small>Powered by <a href=\"https://ritz-lang.org\">Ritz</a> | ")
    html_bytes(out, "<a href=\"/\">Home</a></small></body></html>")


# ============================================================================
# Pages
# ============================================================================

# GET / - `slugs` is present_index's list: slugs each ending in '\n' (a NUL
# also ends it).
pub fn render_index_page(out: @&String, slugs: StrView)
    write_html_head(out, "Nexus Wiki")
    html_bytes(out, "<h1>Nexus Wiki</h1>")
    html_bytes(out, "<p>The Ritz Knowledge Base</p>")
    html_bytes(out, "<nav class=\"nav\"><a href=\"/wiki/new\">+ New Page</a></nav>")
    html_bytes(out, "<h2>Pages</h2>")
    html_bytes(out, "<ul class=\"pages\">")

    let n: i64 = slugs.len()
    var listed: i32 = 0
    var pos: i64 = 0
    var start: i64 = 0
    while pos < n and slugs.get(pos) != 0
        if slugs.get(pos) == '\n'
            if pos > start
                let slug: StrView = slugs.slice(start, pos)
                html_bytes(out, "<li><a href=\"/wiki/")
                html_escaped(out, slug)
                html_bytes(out, "\">")
                html_escaped(out, slug)
                html_bytes(out, "</a></li>")
                listed += 1
            start = pos + 1
        pos += 1

    if listed == 0
        html_bytes(out, "<li><em>No pages yet. <a href=\"/wiki/new\">Create one!</a></em></li>")

    html_bytes(out, "</ul>")
    write_html_footer(out)


# 404 for a well-formed slug with no page, offering to create one.
pub fn render_not_found_page(out: @&String, slug: StrView)
    write_html_head(out, "Not Found - Nexus Wiki")
    html_bytes(out, "<nav class=\"nav\"><a href=\"/\">&larr; Home</a></nav>")
    html_bytes(out, "<h1>Page Not Found</h1>")
    html_bytes(out, "<p>No page exists with the slug <code>")
    html_escaped(out, slug)
    html_bytes(out, "</code>.</p>")
    html_bytes(out, "<p><a href=\"/wiki/new\">Create a new page &rarr;</a></p>")
    write_html_footer(out)


# GET /wiki/:slug - content is rendered as escaped pre-formatted text
# (`white-space: pre-wrap` in the head); Markdown rendering is a follow-up.
pub fn render_view_page(out: @&String, slug: StrView, content: StrView)
    render_titled_view_page(out, slug, slug, content)


# The same page headed by `title`, for pages that have one apart from their slug.
pub fn render_titled_view_page(out: @&String, slug: StrView, title: StrView, content: StrView)
    write_html_head(out, "Nexus Wiki")
    html_bytes(out, "<nav class=\"nav\"><a href=\"/\">&larr; Home</a></nav>")
    html_bytes(out, "<h1>")
    html_escaped(out, title)
    html_bytes(out, "</h1>")
    html_bytes(out, "<div class=\"content\">")
    html_escaped(out, content)
    html_bytes(out, "</div>")
    html_bytes(out, "<div class=\"actions\">")
    html_bytes(out, "<a href=\"/wiki/")
    html_escaped(out, slug)
    html_bytes(out, "/edit\">Edit this page</a>")
    html_bytes(out, "</div>")
    write_html_footer(out)


# GET /wiki/new
pub fn render_new_page(out: @&String)
    write_html_head(out, "New Page - Nexus Wiki")
    html_bytes(out, "<nav class=\"nav\"><a href=\"/\">&larr; Home</a></nav>")
    html_bytes(out, "<h1>New Page</h1>")
    html_bytes(out, "<form method=\"POST\" action=\"/wiki\">")
    html_bytes(out, "<p><label>Slug (URL-friendly name):</label></p>")
    html_bytes(out, "<input type=\"text\" name=\"slug\" placeholder=\"my-page-name\" required pattern=\"[a-z0-9-]+\">")
    html_bytes(out, "<p><label>Content:</label></p>")
    html_bytes(out, "<textarea name=\"content\" placeholder=\"Enter your page content here...\"></textarea>")
    html_bytes(out, "<p><button type=\"submit\">Create Page</button></p>")
    html_bytes(out, "</form>")
    write_html_footer(out)


# GET /wiki/:slug/edit - the form pre-populated with the current content.
pub fn render_edit_page(out: @&String, slug: StrView, content: StrView)
    write_html_head(out, "Edit - Nexus Wiki")
    html_bytes(out, "<nav class=\"nav\"><a href=\"/wiki/")
    html_escaped(out, slug)
    html_bytes(out, "\">&larr; ")
    html_escaped(out, slug)
    html_bytes(out, "</a></nav>")
    html_bytes(out, "<h1>Edit: ")
    html_escaped(out, slug)
    html_bytes(out, "</h1>")
    html_bytes(out, "<form method=\"POST\" action=\"/wiki/")
    html_escaped(out, slug)
    html_bytes(out, "\">")
    html_bytes(out, "<p><label>Content:</label></p>")
    html_bytes(out, "<textarea name=\"content\">")
    html_escaped(out, content)
    html_bytes(out, "</textarea>")
    html_bytes(out, "<p><button type=\"submit\">Save</button></p>")
    html_bytes(out, "</form>")
    write_html_footer(out)


# A styled error page.  `title` and `message` are literals from this program.
pub fn render_error_page(out: @&String, title: StrView, message: StrView)
    write_html_head(out, title)
    html_bytes(out, "<nav class=\"nav\"><a href=\"/\">&larr; Home</a></nav>")
    html_bytes(out, "<h1>")
    html_bytes(out, title)
    html_bytes(out, "</h1>")
    html_bytes(out, "<p>")
    html_bytes(out, message)
    html_bytes(out, "</p>")
    write_html_footer(out)


# ============================================================================
# HTTP headers
# ============================================================================

pub fn push_headers(out: @&String, status: i32, content_type: StrView, content_len: i64)
    html_bytes(out, "HTTP/1.1 ")
    if status == 200
        html_bytes(out, "200 OK")
    else if status == 204
        html_bytes(out, "204 No Content")
    else if status == 400
        html_bytes(out, "400 Bad Request")
    else if status == 403
        html_bytes(out, "403 Forbidden")
    else if status == 404
        html_bytes(out, "404 Not Found")
    else if status == 409
        html_bytes(out, "409 Conflict")
    else if status == 413
        html_bytes(out, "413 Content Too Large")
    else if status == 503
        html_bytes(out, "503 Service Unavailable")
    else
        html_bytes(out, "500 Internal Server Error")
    html_bytes(out, "\r\nContent-Type: ")
    html_bytes(out, content_type)
    html_bytes(out, "\r\nContent-Length: ")
    out.push_i64(content_len)
    html_bytes(out, "\r\nConnection: keep-alive\r\n\r\n")


# 303 See Other (POST -> GET, RFC 7231 §6.4.4) to /wiki/<slug>.  303 forces
# the user agent onto GET, which every wiki create/update flow wants; 302
# leaves method preservation implementation-defined.  The slug has been
# validated to [a-z0-9-], so it needs no URL- or header-escaping.
pub fn push_redirect_to_page(out: @&String, slug: StrView)
    html_bytes(out, "HTTP/1.1 303 See Other\r\nLocation: /wiki/")
    html_bytes(out, slug)
    html_bytes(out, "\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n")
