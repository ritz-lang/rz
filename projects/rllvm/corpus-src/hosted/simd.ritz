# Each x86 intrinsic row once: SHA-NI, AES-NI, psadbw and pclmulqdq. Linked,
# never run: SHA-NI on a host without it is SIGILL.

fn sha(a: @[4]i32, b: @[4]i32, c: @[4]i32, out: @&[4]i32)
    let va: v4i32 = simd_loadu(@a[0])
    let vb: v4i32 = simd_loadu(@b[0])
    let vc: v4i32 = simd_loadu(@c[0])
    let r1: v4i32 = sha256rnds2(va, vb, vc)
    let r2: v4i32 = sha256msg1(r1, vb)
    let r3: v4i32 = sha256msg2(r2, vc)
    simd_storeu(@out[0], r3)

fn aes(state: @[2]i64, key: @[2]i64, out: @&[2]i64)
    let s: v2i64 = simd_loadu(@state[0])
    let k: v2i64 = simd_loadu(@key[0])
    let r1: v2i64 = aesenc(s, k)
    let r2: v2i64 = aesenclast(r1, k)
    let r3: v2i64 = aesdec(r2, k)
    let r4: v2i64 = aesdeclast(r3, k)
    let r5: v2i64 = aesimc(r4)
    let r6: v2i64 = aeskeygenassist(r5, 0x01)
    simd_storeu(@out[0], r6)

fn sad(a: @[16]u8, b: @[16]u8, out: @&[2]i64)
    let va: v16i8 = simd_loadu(@a[0])
    let vb: v16i8 = simd_loadu(@b[0])
    let r: v2i64 = simd_sad(va, vb)
    simd_storeu(@out[0], r)

fn clmul(a: @[2]i64, b: @[2]i64, out: @&[2]i64)
    let va: v2i64 = simd_loadu(@a[0])
    let vb: v2i64 = simd_loadu(@b[0])
    let r: v2i64 = simd_clmul(va, vb, 0x11)
    simd_storeu(@out[0], r)

pub fn main() -> i32
    0
