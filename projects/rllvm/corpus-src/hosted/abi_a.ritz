# The caller side of abi_b.ritz, and the callee of abi_b's callbacks: every
# ABI rule rllvm matches LLVM on has a call across the two objects, linked
# once with a from rllvm and b from clang and once the other way round.
import abi_b

extern fn rt_write(buf: *u8, n: i64) -> i64
extern fn rt_hex(v: u64)

fn say(s: StrView)
    rt_write(s.ptr, s.len)

# Local helpers (ritz1 declares an imported fn's float or vector return
# wrongly, so each file keeps its own). 256-bit vectors only cross private
# impl methods, which are internal.
fn bits64(x: f64) -> u64
    var v: f64 = x
    let p: *u64 = (@v) as *u64
    *p

fn bits32(x: f32) -> u64
    var v: f32 = x
    let p: *u32 = (@v) as *u32
    (*p) as u64

fn vec_of(base: i32) -> v4i32
    let xs: [4]i32 = [base, base + 1, base + 2, base + 3]
    simd_loadu(@xs[0])

fn vec_sum(v: v4i32) -> u64
    var xs: [4]i32 = [0; 4]
    simd_storeu(@xs[0], v)
    (xs[0] as i64 + xs[1] as i64 + xs[2] as i64 + xs[3] as i64) as u64


struct LanesA
    n: i64

impl LanesA
    fn lane7(self: @LanesA, v: v8i32) -> u64
        simd_extract(v, 7) as u64

    # An internal fn taking a 256-bit vector. (ritz1 cannot return one
    # from a method.)
    fn twice(self: @LanesA, v: v8i32) -> u64
        (simd_extract(simd_add(v, v), 7) as u64) + (self.n as u64)

pub fn a_pair(p: Pair) -> Pair
    say("a_pair\n")
    rt_hex(p.a as u64)
    rt_hex(p.b as u64)
    Pair { a: p.a + p.b, b: p.a - p.b }

pub fn a_mixed(m: Mixed) -> Mixed
    say("a_mixed\n")
    rt_hex(m.a as u64)
    rt_hex(m.b as u64)
    rt_hex(bits32(m.c))
    Mixed { a: m.a * 2, b: m.b * 2, c: m.c + 1.0 }

pub fn a_straddle_int(a: i64, b: i64, c: i64, d: i64, e: i64, p: Two) -> i64
    say("a_straddle_int\n")
    rt_hex((a + b + c + d + e) as u64)
    p.a * p.b

pub fn a_straddle_float(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, p: D2) -> u64
    say("a_straddle_float\n")
    rt_hex(bits64(a + b + c + d + e + f + g))
    bits64(p.a * p.b)

pub fn a_three(x: i64) -> Three
    Three { a: x * 3, b: x * 5, c: x * 7 }

pub fn a_d3(x: f64) -> D3
    D3 { a: x, b: x * 2.0, c: x * 4.0 }

pub fn a_v4(base: i32) -> V4
    V4 { a: vec_of(base), b: vec_of(base * 2), c: vec_of(base * 3), d: vec_of(base * 4) }

pub fn a_sret(x: i64) -> Big
    var b: Big = Big { xs: [0; 40] }
    b.xs[0] = x + 1
    b.xs[39] = x + 2
    b

fn internal_wide() -> u64
    let l: LanesA = LanesA { n: 3 }
    let xs: [8]i32 = [7, 7, 7, 7, 7, 7, 7, 8]
    let w: v8i32 = simd_loadu(@xs[0])
    l.twice(w)

pub fn main() -> i32
    say("a_calls_b\n")
    let p: Pair = b_pair(Pair { a: 1, b: 2 })
    rt_hex(p.a as u64)
    rt_hex(p.b as u64)
    let m: Mixed = b_mixed(Mixed { a: -3, b: 1234567890123, c: 1.25 })
    rt_hex(m.a as u64)
    rt_hex(m.b as u64)
    rt_hex(bits32(m.c))
    rt_hex(b_straddle_int(1, 2, 3, 4, 5, Two { a: 6, b: 7 }) as u64)
    rt_hex((b_straddle_float(0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, D2 { a: 7.25, b: 8.75 })))
    let t: Three = b_three(10)
    rt_hex(t.a as u64)
    rt_hex(t.b as u64)
    rt_hex(t.c as u64)
    let f: Four = b_four(20)
    rt_hex((f.a + f.b + f.c + f.d) as u64)
    let d2: D2 = b_d2(1.0)
    rt_hex(bits64(d2.a))
    rt_hex(bits64(d2.b))
    let d3: D3 = b_d3(2.0)
    rt_hex(bits64(d3.c))
    let d4: D4 = b_d4(3.0)
    rt_hex(bits64(d4.c))
    rt_hex(bits64(d4.d))
    let d5: D5 = b_d5(4.0)
    rt_hex(bits64(d5.e))
    let v4: V4 = b_v4(1)
    rt_hex(vec_sum(v4.a) + vec_sum(v4.d))
    let v5: V5 = b_v5(2)
    rt_hex(vec_sum(v5.a) + vec_sum(v5.e))
    var big: Big = Big { xs: [0; 40] }
    big.xs[0] = 11
    big.xs[39] = 22
    rt_hex(b_big(big) as u64)
    rt_hex(b_packed(Packed { a: 1, b: 0x01020304, c: 0x0506 }) as u64)
    let wx: [8]i32 = [41, 41, 41, 41, 41, 41, 41, 42]
    let wv: v8i32 = simd_loadu(@wx[0])
    var bw: BigWide = BigWide { xs: [0; 40], w: wv }
    bw.xs[1] = 33
    rt_hex(b_big_wide(bw) as u64)
    let s: Big = b_sret(5)
    rt_hex((s.xs[0] + s.xs[39]) as u64)
    rt_hex(b_aligned())
    rt_hex(b_internal_wide())
    rt_hex(internal_wide())
    b_calls_a()
    0
