# A strong ritz_platform_fatal beside the shim's weak one. Linked with the
# shim, the strong definition runs: it prints its message and exits 7.
extern fn rt_write(buf: *u8, n: i64) -> i64

pub fn ritz_platform_fatal(msg: *u8, len: i64, status: i32)
    rt_write(msg, len)
    var nr: u64 = 60
    var code: u64 = 7
    asm x86_64 (inout nr: rax, in code: rdi, clobber rcx, clobber r11):
        syscall

pub fn main() -> i32
    let s: StrView = "strong ritz_platform_fatal\n"
    ritz_platform_fatal(s.ptr, s.len, 1)
    0
