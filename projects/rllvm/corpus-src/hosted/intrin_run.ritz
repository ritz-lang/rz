# Every scalar intrinsic row but llvm.trap, at each width it names, on edge
# values; each result is printed. The operands come through parameters so
# the IR keeps the intrinsic calls. Checked arithmetic stops the program on
# overflow, so the last line overflows `+` at i32 and the status is 1.
extern fn rt_write(buf: *u8, n: i64) -> i64
extern fn rt_hex(v: u64)

fn say(s: StrView)
    rt_write(s.ptr, s.len)

fn put(v: i64)
    rt_hex(v as u64)

# with.overflow: s/u add, sub, mul at 8, 16, 32 and 64 bits.
fn sadd8(a: i8, b: i8) -> i8
    a + b
fn ssub8(a: i8, b: i8) -> i8
    a - b
fn smul8(a: i8, b: i8) -> i8
    a * b
fn uadd8(a: u8, b: u8) -> u8
    a + b
fn usub8(a: u8, b: u8) -> u8
    a - b
fn umul8(a: u8, b: u8) -> u8
    a * b
fn sadd16(a: i16, b: i16) -> i16
    a + b
fn ssub16(a: i16, b: i16) -> i16
    a - b
fn smul16(a: i16, b: i16) -> i16
    a * b
fn uadd16(a: u16, b: u16) -> u16
    a + b
fn usub16(a: u16, b: u16) -> u16
    a - b
fn umul16(a: u16, b: u16) -> u16
    a * b
fn sadd32(a: i32, b: i32) -> i32
    a + b
fn ssub32(a: i32, b: i32) -> i32
    a - b
fn smul32(a: i32, b: i32) -> i32
    a * b
fn uadd32(a: u32, b: u32) -> u32
    a + b
fn usub32(a: u32, b: u32) -> u32
    a - b
fn umul32(a: u32, b: u32) -> u32
    a * b
fn sadd64(a: i64, b: i64) -> i64
    a + b
fn ssub64(a: i64, b: i64) -> i64
    a - b
fn smul64(a: i64, b: i64) -> i64
    a * b
fn uadd64(a: u64, b: u64) -> u64
    a + b
fn usub64(a: u64, b: u64) -> u64
    a - b
fn umul64(a: u64, b: u64) -> u64
    a * b

# Results at the edges that stay in range: 0, 1, -1, the minimum and the
# maximum, and each operation up to its bound exactly.
fn overflow_rows()
    say("with.overflow\n")
    put(sadd8(0, 0) as i64)
    put(sadd8(126, 1) as i64)
    put(sadd8(-127, -1) as i64)
    put(sadd8(127, -128) as i64)
    put(ssub8(-1, 127) as i64)
    put(ssub8(126, -1) as i64)
    put(smul8(-1, 127) as i64)
    put(smul8(-128, 1) as i64)
    put(uadd8(254, 1) as i64)
    put(usub8(1, 1) as i64)
    put(umul8(15, 17) as i64)
    put(sadd16(32766, 1) as i64)
    put(sadd16(-32767, -1) as i64)
    put(ssub16(-1, 32767) as i64)
    put(smul16(-1, 32767) as i64)
    put(uadd16(65534, 1) as i64)
    put(usub16(65535, 65535) as i64)
    put(umul16(255, 257) as i64)
    put(sadd32(2147483646, 1) as i64)
    put(sadd32(-2147483647, -1) as i64)
    put(ssub32(-1, 2147483647) as i64)
    put(smul32(-1, 2147483647) as i64)
    put(smul32(46340, 46340) as i64)
    put(uadd32(4294967294, 1) as i64)
    put(usub32(1, 0) as i64)
    put(umul32(65535, 65537) as i64)
    put(sadd64(9223372036854775806, 1))
    put(sadd64(-9223372036854775807, -1))
    put(ssub64(-1, 9223372036854775807))
    put(smul64(-1, 9223372036854775807))
    put(smul64(3037000499, 3037000499))
    rt_hex(uadd64(18446744073709551614, 1))
    rt_hex(usub64(1, 1))
    rt_hex(umul64(4294967295, 4294967297))

# fshl / fshr, as ritz writes them: rotl / rotr, counts 0, 1, N-1, N, N+1, 2N-1.
fn rot8(x: u8, n: u8)
    rt_hex(x.rotl(n) as u64)
    rt_hex(x.rotr(n) as u64)
fn rot16(x: u16, n: u16)
    rt_hex(x.rotl(n) as u64)
    rt_hex(x.rotr(n) as u64)
fn rot32(x: u32, n: u32)
    rt_hex(x.rotl(n) as u64)
    rt_hex(x.rotr(n) as u64)
fn rot64(x: u64, n: u64)
    rt_hex(x.rotl(n))
    rt_hex(x.rotr(n))

fn rotate_rows()
    say("fshl/fshr\n")
    let c8: [6]u8 = [0, 1, 7, 8, 9, 15]
    for i in 0..6
        rot8(0x81, c8[i])
    let c16: [6]u16 = [0, 1, 15, 16, 17, 31]
    for i in 0..6
        rot16(0x8001, c16[i])
    let c32: [6]u32 = [0, 1, 31, 32, 33, 63]
    for i in 0..6
        rot32(0x80000001, c32[i])
    let c64: [6]u64 = [0, 1, 63, 64, 65, 127]
    for i in 0..6
        rot64(0x8000000000000001, c64[i])

# ctlz / cttz on 0, 1, the top bit alone and all ones; ctpop on 0, all ones
# and alternating bits.
fn bits8(x: u8)
    rt_hex(x.clz() as u64)
    rt_hex(x.ctz() as u64)
    rt_hex(x.popcnt() as u64)
fn bits16(x: u16)
    rt_hex(x.clz() as u64)
    rt_hex(x.ctz() as u64)
    rt_hex(x.popcnt() as u64)
fn bits32(x: u32)
    rt_hex(x.clz() as u64)
    rt_hex(x.ctz() as u64)
    rt_hex(x.popcnt() as u64)
fn bits64(x: u64)
    rt_hex(x.clz() as u64)
    rt_hex(x.ctz() as u64)
    rt_hex(x.popcnt() as u64)

fn count_rows()
    say("ctlz/cttz/ctpop\n")
    let v8: [5]u8 = [0, 1, 0x80, 0xFF, 0x55]
    for i in 0..5
        bits8(v8[i])
    let v16: [5]u16 = [0, 1, 0x8000, 0xFFFF, 0x5555]
    for i in 0..5
        bits16(v16[i])
    let v32: [5]u32 = [0, 1, 0x80000000, 0xFFFFFFFF, 0x55555555]
    for i in 0..5
        bits32(v32[i])
    let v64: [5]u64 = [0, 1, 0x8000000000000000, 0xFFFFFFFFFFFFFFFF, 0x5555555555555555]
    for i in 0..5
        bits64(v64[i])

fn swap16(x: u16) -> u16
    x.swap_bytes()
fn swap32(x: u32) -> u32
    x.swap_bytes()
fn swap64(x: u64) -> u64
    x.swap_bytes()

fn bswap_rows()
    say("bswap\n")
    rt_hex(swap16(0x1234) as u64)
    rt_hex(swap32(0x12345678) as u64)
    rt_hex(swap64(0x0123456789ABCDEF))

# Float bits in and out, so every value is exact.
fn f64_of(bits: u64) -> f64
    var b: u64 = bits
    let p: *f64 = (@b) as *f64
    *p
fn f64_bits(x: f64) -> u64
    var v: f64 = x
    let p: *u64 = (@v) as *u64
    *p
fn f32_of(bits: u32) -> f32
    var b: u32 = bits
    let p: *f32 = (@b) as *f32
    *p
fn f32_bits(x: f32) -> u64
    var v: f32 = x
    let p: *u32 = (@v) as *u32
    (*p) as u64

fn abs64(x: f64) -> f64
    x.abs()
fn abs32(x: f32) -> f32
    x.abs()

fn fabs_rows()
    say("fabs\n")
    let d: [4]u64 = [0x8000000000000000, 0x7FF8000000000000, 0x7FF0000000000000, 0xFFF0000000000000]
    for i in 0..4
        let a: f64 = f64_of(d[i])
        rt_hex(f64_bits(abs64(a)))
    let s: [4]u32 = [0x80000000, 0x7FC00000, 0x7F800000, 0xFF800000]
    for i in 0..4
        let b: f32 = f32_of(s[i])
        rt_hex(f32_bits(abs32(b)))

# All eight saturating conversions of one value.
fn sat64(x: f64)
    put((x as i8) as i64)
    put((x as i16) as i64)
    put((x as i32) as i64)
    put(x as i64)
    rt_hex((x as u8) as u64)
    rt_hex((x as u16) as u64)
    rt_hex((x as u32) as u64)
    rt_hex(x as u64)
fn sat32(x: f32)
    put((x as i8) as i64)
    put((x as i16) as i64)
    put((x as i32) as i64)
    put(x as i64)
    rt_hex((x as u8) as u64)
    rt_hex((x as u16) as u64)
    rt_hex((x as u32) as u64)
    rt_hex(x as u64)

# NaN, both infinities, -0.0, each bound and one ulp past it (2^63 for
# fptoui.sat.i64 is the i64 maximum's neighbour), as f64 bit patterns.
const SAT_F64: [24]u64 = [0x7FF8000000000000, 0x7FF0000000000000, 0xFFF0000000000000, 0x8000000000000000, 0xC060000000000000, 0xC060000000000001, 0x405FC00000000000, 0x405FC00000000001, 0xC0E0000000000000, 0xC0E0000000000001, 0x40DFFFC000000000, 0x40DFFFC000000001, 0xC1E0000000000000, 0xC1E0000000000001, 0x41DFFFFFFFC00000, 0x41DFFFFFFFC00001, 0xC3E0000000000000, 0xC3E0000000000001, 0x43E0000000000000, 0x43DFFFFFFFFFFFFF, 0x406FE00000000000, 0x40EFFFE000000000, 0x41EFFFFFFFE00000, 0x43F0000000000000]
const SAT_F32: [20]u32 = [0x7FC00000, 0x7F800000, 0xFF800000, 0x80000000, 0xC3000000, 0xC3000001, 0x42FE0000, 0x42FE0001, 0xC7000000, 0xC7000001, 0x46FFFE00, 0x46FFFE01, 0xCF000000, 0xCF000001, 0x4F000000, 0x4EFFFFFF, 0x437F0000, 0x477FFF00, 0x4F800000, 0x5F800000]

fn sat_rows()
    say("fptosi.sat/fptoui.sat f64\n")
    for i in 0..24
        sat64(f64_of(SAT_F64[i]))
    say("fptosi.sat/fptoui.sat f32\n")
    for i in 0..20
        sat32(f32_of(SAT_F32[i]))

pub fn main() -> i32
    overflow_rows()
    rotate_rows()
    count_rows()
    bswap_rows()
    fabs_rows()
    sat_rows()
    say("overflow\n")
    put(sadd32(2147483647, 1) as i64)
    0
