# Integer arithmetic, a write and main's return code.
extern fn rt_write(buf: *u8, n: i64) -> i64
extern fn rt_hex(v: u64)

fn say(s: StrView)
    rt_write(s.ptr, s.len)

fn fib(n: i64) -> i64
    var a: i64 = 0
    var b: i64 = 1
    for i in 0..n
        let t: i64 = a + b
        a = b
        b = t
    a

fn mix(x: u64, y: u64) -> u64
    ((x ^ (y << 7)) +% (y >> 3)) *% 0x9E3779B97F4A7C15

pub fn main() -> i32
    say("hello from the rllvm corpus\n")
    rt_hex(fib(50) as u64)
    var sum: i64 = 0
    for i in 0..1000
        sum += i * i - (i / 3) + (i % 7)
    rt_hex(sum as u64)
    var h: u64 = 1
    for i in 0..64
        h = mix(h, i as u64)
    rt_hex(h)
    (sum % 100) as i32
