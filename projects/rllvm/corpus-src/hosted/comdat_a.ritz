# ODR functions in comdats, as ritz1 emits them: an async fn's poll is
# linkonce_odr, and each unit's injected future_poll is weak_odr; both
# comdat_a and comdat_b define future_poll, and the link keeps one.
import comdat_b

extern fn rt_hex(v: u64)

pub async fn shared_a(n: i32) -> i32
    return n * 3

fn poll_it(f: @&Future) -> bool
    future_poll(f)

# Polls shared_a to completion; the number of Pending answers.
pub fn drive_a(n: i32) -> i64
    var f = shared_a(n)
    var pending: i64 = 0
    while not poll_it(@&f)
        pending += 1
    rt_hex(pending as u64)
    pending + (n as i64)

pub fn main() -> i32
    rt_hex(drive_a(5) as u64)
    rt_hex(drive_b(6) as u64)
    0
