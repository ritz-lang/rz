# Every scalar intrinsic row at every width it names, for disassembly and
# for the absence of compiler-rt and libc references. Not executed: the
# unwrap's llvm.trap is a ud2. intrin_run.ritz runs the values.

# with.overflow: s/u add, sub, mul at 8, 16, 32 and 64 bits.
fn sadd8(a: i8, b: i8) -> i8
    a + b
fn ssub8(a: i8, b: i8) -> i8
    a - b
fn smul8(a: i8, b: i8) -> i8
    a * b
fn uadd8(a: u8, b: u8) -> u8
    a + b
fn usub8(a: u8, b: u8) -> u8
    a - b
fn umul8(a: u8, b: u8) -> u8
    a * b
fn sadd16(a: i16, b: i16) -> i16
    a + b
fn ssub16(a: i16, b: i16) -> i16
    a - b
fn smul16(a: i16, b: i16) -> i16
    a * b
fn uadd16(a: u16, b: u16) -> u16
    a + b
fn usub16(a: u16, b: u16) -> u16
    a - b
fn umul16(a: u16, b: u16) -> u16
    a * b
fn sadd32(a: i32, b: i32) -> i32
    a + b
fn ssub32(a: i32, b: i32) -> i32
    a - b
fn smul32(a: i32, b: i32) -> i32
    a * b
fn uadd32(a: u32, b: u32) -> u32
    a + b
fn usub32(a: u32, b: u32) -> u32
    a - b
fn umul32(a: u32, b: u32) -> u32
    a * b
fn sadd64(a: i64, b: i64) -> i64
    a + b
fn ssub64(a: i64, b: i64) -> i64
    a - b
fn smul64(a: i64, b: i64) -> i64
    a * b
fn uadd64(a: u64, b: u64) -> u64
    a + b
fn usub64(a: u64, b: u64) -> u64
    a - b
fn umul64(a: u64, b: u64) -> u64
    a * b

# fshl / fshr as rotates, ctlz / cttz with the i1 false, ctpop.
fn rot8(x: u8, n: u8) -> u8
    x.rotl(n) ^ x.rotr(n)
fn counts8(x: u8) -> u8
    x.clz() +% x.ctz() +% x.popcnt()
fn rot16(x: u16, n: u16) -> u16
    x.rotl(n) ^ x.rotr(n)
fn counts16(x: u16) -> u16
    x.clz() +% x.ctz() +% x.popcnt()
fn rot32(x: u32, n: u32) -> u32
    x.rotl(n) ^ x.rotr(n)
fn counts32(x: u32) -> u32
    x.clz() +% x.ctz() +% x.popcnt()
fn rot64(x: u64, n: u64) -> u64
    x.rotl(n) ^ x.rotr(n)
fn counts64(x: u64) -> u64
    x.clz() +% x.ctz() +% x.popcnt()
fn swap16(x: u16) -> u16
    x.swap_bytes()
fn swap32(x: u32) -> u32
    x.swap_bytes()
fn swap64(x: u64) -> u64
    x.swap_bytes()

fn abs64(x: f64) -> f64
    x.abs()
fn abs32(x: f32) -> f32
    x.abs()

# All sixteen fptosi.sat / fptoui.sat combinations.
fn i8_of_f32(x: f32) -> i8
    x as i8
fn i16_of_f32(x: f32) -> i16
    x as i16
fn i32_of_f32(x: f32) -> i32
    x as i32
fn i64_of_f32(x: f32) -> i64
    x as i64
fn u8_of_f32(x: f32) -> u8
    x as u8
fn u16_of_f32(x: f32) -> u16
    x as u16
fn u32_of_f32(x: f32) -> u32
    x as u32
fn u64_of_f32(x: f32) -> u64
    x as u64
fn i8_of_f64(x: f64) -> i8
    x as i8
fn i16_of_f64(x: f64) -> i16
    x as i16
fn i32_of_f64(x: f64) -> i32
    x as i32
fn i64_of_f64(x: f64) -> i64
    x as i64
fn u8_of_f64(x: f64) -> u8
    x as u8
fn u16_of_f64(x: f64) -> u16
    x as u16
fn u32_of_f64(x: f64) -> u32
    x as u32
fn u64_of_f64(x: f64) -> u64
    x as u64

# llvm.trap: the unwrap of a None.
fn first(o: Option<i64>) -> i64
    o.unwrap()

pub fn main() -> i32
    0
