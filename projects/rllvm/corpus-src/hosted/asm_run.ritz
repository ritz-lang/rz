# Inline asm that is safe on the host, each result printed: a tied inout, an
# early-clobber unpinned output beside inputs, pinned inputs and outputs, a
# multi-output literal struct and `$$`.
extern fn rt_write(buf: *u8, n: i64) -> i64
extern fn rt_hex(v: u64)

fn say(s: StrView)
    rt_write(s.ptr, s.len)

# A tied inout, unpinned: `=&r` tied to its input by number.
fn add_tied(x: u64, y: u64) -> u64
    var acc: u64 = x
    asm x86_64 (inout acc, in y):
        addq {y}, {acc}
    acc

# An early-clobber output (`=&r`) written before both inputs are read.
fn early(a: u64, b: u64) -> u64
    var out: u64 = 0
    asm x86_64 (out out, in a, in b):
        movq {a}, {out}
        shlq $3, {out}
        addq {b}, {out}
        xorq {a}, {out}
    out

# Pinned inputs and a pinned output.
fn pinned(a: u64, b: u64) -> u64
    var r: u64 = 0
    asm x86_64 (out r: rax, in a: rdi, in b: rsi):
        leaq (%rdi,%rsi,4), %rax
    r

# Two outputs: a literal struct.
fn swap_pair(a: u64, b: u64) -> u64
    var x: u64 = a
    var y: u64 = b
    asm x86_64 (inout x, inout y):
        xchgq {x}, {y}
    (x << 8) | y

# bswap through a template.
fn swapped(v: u64) -> u64
    var x: u64 = v
    asm x86_64 (inout x):
        bswap {x}
    x

# `$$`: a literal immediate in the template.
fn plus_forty_two(v: u64) -> u64
    var x: u64 = v
    asm x86_64 (inout x: rcx):
        addq $42, %rcx
    x

# rdtsc, for its constraints only: two pinned 32-bit outputs.
fn tsc_ok() -> u64
    var lo: u32 = 0
    var hi: u32 = 0
    asm x86_64 (out lo: rax, out hi: rdx):
        rdtsc
    let t: u64 = ((hi as u64) << 32) | (lo as u64)
    if t != 0 then 1 else 0

pub fn main() -> i32
    say("asm\n")
    rt_hex(add_tied(40, 2))
    rt_hex(early(5, 7))
    rt_hex(pinned(100, 3))
    rt_hex(swap_pair(1, 2))
    rt_hex(swapped(0x0102030405060708))
    rt_hex(plus_forty_two(8))
    rt_hex(tsc_ok())
    0
