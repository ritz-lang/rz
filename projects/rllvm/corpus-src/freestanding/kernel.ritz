# The kernel profile: noredzone and sspstrong on every function, external
# data through the GOT, internal data at sign-extended 32-bit addresses in
# the high 2 GiB, and a pointer in a data initializer. Linked, never run.
extern var rt_ticks: i64
extern fn rt_tick(n: i64) -> i64

var g_value: i64 = 41
var g_table: [4]i64 = [10, 20, 30, 40]
var g_names: [2]StrView = ["alpha", "beta"]

# A local array: the stack protector's canary guards it.
fn checksum(n: i64) -> i64
    var buf: [32]u8 = [0; 32]
    for i in 0..32
        buf[i] = ((n + i) & 0xFF) as u8
    var s: i64 = 0
    for i in 0..32
        s += buf[i] as i64
    s

fn sum_table() -> i64
    var s: i64 = 0
    for i in 0..4
        s += g_table[i]
    s

pub fn kmain(x: i64) -> i64
    g_value = g_value + g_names[1].len
    rt_ticks = rt_ticks + sum_table()
    rt_tick(checksum(x) + g_value)
