# The small PIC profile on a freestanding triple: external data and calls,
# internal data, and a pointer in a data initializer, linked with the
# Harland shim. Linked, never run: the shim exits with Harland's syscall.
extern var rt_ticks: i64
extern fn rt_tick(n: i64) -> i64

var g_value: i64 = 41
var g_table: [4]i64 = [10, 20, 30, 40]
var g_names: [2]StrView = ["alpha", "beta"]

fn sum_table() -> i64
    var s: i64 = 0
    for i in 0..4
        s += g_table[i]
    s

pub fn main() -> i32
    g_value = g_value + g_names[1].len
    rt_ticks = rt_ticks + sum_table()
    rt_tick(g_value) as i32
