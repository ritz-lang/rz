# subset: the closed lists of DESIGN.md "LLVM IR subset" that are names, not
# grammar: intrinsics, target features, triples and the words that name a
# construct outside the subset.
import ritzlib.strview { StrView }

fn int_width_in(w: StrView, allow8: bool) -> bool
    (allow8 and w.eq("8")) or w.eq("16") or w.eq("32") or w.eq("64")

# `rest` is `iN` with N one of 8, 16, 32, 64 (16, 32, 64 when not allow8).
fn int_suffix(rest: StrView, allow8: bool) -> bool
    rest.starts_with("i") and int_width_in(rest.skip(1), allow8)

# llvm.fptosi.sat.iN.fM / llvm.fptoui.sat.iN.fM after the `sat.` prefix.
fn sat_suffix(rest: StrView) -> bool
    let dot: i64 = rest.find_byte('.')
    if dot >= rest.len
        return false
    let tail: StrView = rest.skip(dot + 1)
    int_suffix(rest.take(dot), true) and (tail.eq("f32") or tail.eq("f64"))

# Is `name` (without the @) an intrinsic in DESIGN.md "Intrinsics"?
pub fn intrinsic_allowed(name: StrView) -> bool
    if name.eq("llvm.x86.sha256rnds2") or name.eq("llvm.x86.sha256msg1") or name.eq("llvm.x86.sha256msg2")
        return true
    if name.eq("llvm.x86.aesni.aesenc") or name.eq("llvm.x86.aesni.aesenclast") or name.eq("llvm.x86.aesni.aesdec") or name.eq("llvm.x86.aesni.aesdeclast") or name.eq("llvm.x86.aesni.aesimc") or name.eq("llvm.x86.aesni.aeskeygenassist")
        return true
    if name.eq("llvm.x86.sse2.psad.bw") or name.eq("llvm.x86.pclmulqdq") or name.eq("llvm.trap")
        return true
    if name.eq("llvm.fabs.f32") or name.eq("llvm.fabs.f64")
        return true
    if name.starts_with("llvm.bswap.")
        return int_suffix(name.skip(11), false)
    if name.starts_with("llvm.ctpop.") or name.starts_with("llvm.ctlz.") or name.starts_with("llvm.cttz.")
        let dot: i64 = name.skip(5).find_byte('.')
        return int_suffix(name.skip(5 + dot + 1), true)
    if name.starts_with("llvm.fshl.") or name.starts_with("llvm.fshr.")
        return int_suffix(name.skip(10), true)
    if name.starts_with("llvm.fptosi.sat.") or name.starts_with("llvm.fptoui.sat.")
        return sat_suffix(name.skip(16))
    if name.starts_with("llvm.sadd.with.overflow.") or name.starts_with("llvm.uadd.with.overflow.") or name.starts_with("llvm.ssub.with.overflow.") or name.starts_with("llvm.usub.with.overflow.") or name.starts_with("llvm.smul.with.overflow.") or name.starts_with("llvm.umul.with.overflow.")
        return int_suffix(name.skip(24), true)
    false

pub fn feature_allowed(f: StrView) -> bool
    f.eq("+aes") or f.eq("+pclmul") or f.eq("+sha")

# The four ELF triples (DESIGN.md "Triples").
pub fn triple_is_elf(t: StrView) -> bool
    t.eq("x86_64-unknown-linux-gnu") or t.eq("x86_64-pc-linux-gnu") or t.eq("x86_64-none-elf") or t.eq("x86_64-unknown-none")

pub const DEFAULT_TRIPLE: StrView = "x86_64-unknown-linux-gnu"

# Instruction keywords LLVM has and the subset does not.
pub fn calling_convention(w: StrView) -> bool
    w.eq("win64cc") or w.eq("fastcc") or w.eq("ccc") or w.eq("coldcc") or w.eq("cc") or w.eq("x86_64_sysvcc") or w.eq("tailcc") or w.eq("swiftcc") or w.eq("preserve_mostcc") or w.eq("preserve_allcc") or w.eq("x86_vectorcallcc") or w.eq("x86_regcallcc") or w.eq("ghccc")

pub fn return_attribute(w: StrView) -> bool
    w.eq("noundef") or w.eq("zeroext") or w.eq("signext") or w.eq("noalias") or w.eq("nonnull") or w.eq("inreg") or w.eq("dereferenceable") or w.eq("dereferenceable_or_null") or w.eq("align") or w.eq("range")

pub fn linkage_word(w: StrView) -> bool
    w.eq("linkonce") or w.eq("common") or w.eq("extern_weak") or w.eq("appending")

pub fn fast_math_flag(w: StrView) -> bool
    w.eq("fast") or w.eq("nnan") or w.eq("ninf") or w.eq("nsz") or w.eq("arcp") or w.eq("contract") or w.eq("afn") or w.eq("reassoc")

pub fn int_flag(w: StrView) -> bool
    w.eq("nsw") or w.eq("nuw") or w.eq("exact") or w.eq("disjoint") or w.eq("nneg") or w.eq("samesign")

pub fn icmp_predicate(w: StrView) -> bool
    w.eq("eq") or w.eq("ne") or w.eq("ugt") or w.eq("uge") or w.eq("ult") or w.eq("ule") or w.eq("sgt") or w.eq("sge") or w.eq("slt") or w.eq("sle")

pub fn fcmp_predicate(w: StrView) -> bool
    w.eq("false") or w.eq("oeq") or w.eq("ogt") or w.eq("oge") or w.eq("olt") or w.eq("ole") or w.eq("one") or w.eq("ord") or w.eq("ueq") or w.eq("ugt") or w.eq("uge") or w.eq("ult") or w.eq("ule") or w.eq("une") or w.eq("uno") or w.eq("true")

pub fn atomicrmw_op(w: StrView) -> bool
    w.eq("xchg") or w.eq("add") or w.eq("sub") or w.eq("and") or w.eq("or") or w.eq("xor")

pub fn ordering_word(w: StrView) -> bool
    w.eq("unordered") or w.eq("monotonic") or w.eq("acquire") or w.eq("release") or w.eq("acq_rel") or w.eq("seq_cst")

# Words that begin a type the subset lacks.
pub fn foreign_type_word(w: StrView) -> bool
    w.eq("half") or w.eq("bfloat") or w.eq("fp128") or w.eq("x86_fp80") or w.eq("ppc_fp128") or w.eq("x86_amx") or w.eq("x86_mmx") or w.eq("token") or w.eq("metadata") or w.eq("opaque") or w.eq("target")

# An iN word: i followed by digits only.
pub fn int_type_word(w: StrView) -> bool
    if w.len < 2 or w.get(0) != 'i'
        return false
    for k in 1..w.len
        if w.get(k) < '0' or w.get(k) > '9'
            return false
    true
