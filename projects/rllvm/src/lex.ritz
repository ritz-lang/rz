# lex: LLVM IR text to tokens. A token is a span of the source plus its
# 1-based line; comments are dropped.
import ritzlib.strview { StrView }
import ritzlib.gvec { Vec, vec_new }

pub enum Tok
    Eof
    Word        # keyword, type or bare name: i32, define, x, seq_cst
    Local       # %name, %"name", %0
    Global      # @name, @"name"
    Comdat      # $name
    Group       # #0, an attribute group reference
    Meta        # !name, !0, or a lone ! before {
    Label       # name: (a block label definition; text excludes the ':')
    Int         # -?[0-9]+
    Float       # 1.5e+00, 1.0, 0x3FF0000000000000
    Str         # "..." (text includes the quotes)
    CStr        # c"..." (text includes c and the quotes)
    Punct       # one byte of = , ( ) [ ] { } < > * :
    Ellipsis    # ...
    Bad         # a byte no token starts with

pub struct Token
    kind: Tok
    start: i64
    len: i64
    line: i64

fn lex_is_digit(c: u8) -> bool
    c >= '0' and c <= '9'

fn is_hex(c: u8) -> bool
    lex_is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

# The bytes of an LLVM identifier: [-a-zA-Z$._0-9].
fn lex_is_name(c: u8) -> bool
    lex_is_digit(c) or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '-' or c == '$' or c == '.' or c == '_'

fn is_punct(c: u8) -> bool
    c == '=' or c == ',' or c == '(' or c == ')' or c == '[' or c == ']' or c == '{' or c == '}' or c == '<' or c == '>' or c == '*' or c == ':'

# The end of a "..." string starting at `i` (the opening quote), past the
# closing quote, or the end of the text when it is unterminated. A string may
# hold literal newlines (the shims' asm templates); `lines` counts them.
fn quoted_end(src: StrView, i: i64) -> i64
    var j: i64 = i + 1
    while j < src.len and src.get(j) != '"'
        j += 1
    if j < src.len
        j += 1
    j

fn newlines_in(src: StrView, start: i64, end: i64) -> i64
    var n: i64 = 0
    for k in start..end
        if src.get(k) == '\n'
            n += 1
    n

# The end of a number starting at `i`, and whether it is a float.
fn number_end(src: StrView, i: i64) -> i64
    var j: i64 = i
    if src.get(j) == '-'
        j += 1
    if j + 1 < src.len and src.get(j) == '0' and src.get(j + 1) == 'x'
        j += 2
        while j < src.len and (is_hex(src.get(j)) or src.get(j) == 'K' or src.get(j) == 'L' or src.get(j) == 'M' or src.get(j) == 'H' or src.get(j) == 'R')
            j += 1
        return j
    while j < src.len and lex_is_digit(src.get(j))
        j += 1
    if j < src.len and src.get(j) == '.'
        j += 1
        while j < src.len and lex_is_digit(src.get(j))
            j += 1
        if j < src.len and (src.get(j) == 'e' or src.get(j) == 'E')
            j += 1
            if j < src.len and (src.get(j) == '+' or src.get(j) == '-')
                j += 1
            while j < src.len and lex_is_digit(src.get(j))
                j += 1
    j

fn number_is_float(text: StrView) -> bool
    text.find_byte('.') < text.len or text.find_byte('x') < text.len

fn name_end(src: StrView, i: i64) -> i64
    var j: i64 = i
    while j < src.len and lex_is_name(src.get(j))
        j += 1
    j

# The end of a sigil name (%x, @x, $x, !x, #0) whose sigil is at `i`.
fn sigil_end(src: StrView, i: i64) -> i64
    if i + 1 < src.len and src.get(i + 1) == '"'
        return quoted_end(src, i + 1)
    name_end(src, i + 1)

fn push_tok(toks: @&Vec<Token>, kind: Tok, start: i64, end: i64, line: i64)
    toks.push(Token { kind: kind, start: start, len: end - start, line: line })

# Every token of `src`, ending with one Eof.
pub fn lex(src: StrView) -> Vec<Token>
    var toks = vec_new<Token>()
    var i: i64 = 0
    var line: i64 = 1
    while i < src.len
        let c: u8 = src.get(i)
        if c == '\n'
            line += 1
            i += 1
        else if c == ' ' or c == '\t' or c == '\r'
            i += 1
        else if c == ';'
            while i < src.len and src.get(i) != '\n'
                i += 1
        else if c == '"'
            let end: i64 = quoted_end(src, i)
            push_tok(@&toks, Tok.Str, i, end, line)
            line += newlines_in(src, i, end)
            i = end
        else if c == 'c' and i + 1 < src.len and src.get(i + 1) == '"'
            let end: i64 = quoted_end(src, i + 1)
            push_tok(@&toks, Tok.CStr, i, end, line)
            line += newlines_in(src, i, end)
            i = end
        else if c == '%' or c == '@' or c == '$' or c == '!' or c == '#'
            let end: i64 = sigil_end(src, i)
            var kind: Tok = Tok.Local
            if c == '@'
                kind = Tok.Global
            else if c == '$'
                kind = Tok.Comdat
            else if c == '!'
                kind = Tok.Meta
            else if c == '#'
                kind = Tok.Group
            push_tok(@&toks, kind, i, end, line)
            i = end
        else if lex_is_digit(c) or (c == '-' and i + 1 < src.len and lex_is_digit(src.get(i + 1)))
            let end: i64 = number_end(src, i)
            var kind: Tok = Tok.Int
            if number_is_float(src.slice(i, end))
                kind = Tok.Float
            push_tok(@&toks, kind, i, end, line)
            i = end
        else if c == '.' and i + 2 < src.len and src.get(i + 1) == '.' and src.get(i + 2) == '.'
            push_tok(@&toks, Tok.Ellipsis, i, i + 3, line)
            i += 3
        else if lex_is_name(c)
            let end: i64 = name_end(src, i)
            if end < src.len and src.get(end) == ':'
                push_tok(@&toks, Tok.Label, i, end, line)
                i = end + 1
            else
                push_tok(@&toks, Tok.Word, i, end, line)
                i = end
        else if is_punct(c)
            push_tok(@&toks, Tok.Punct, i, i + 1, line)
            i += 1
        else
            push_tok(@&toks, Tok.Bad, i, i + 1, line)
            i += 1
    push_tok(@&toks, Tok.Eof, src.len, src.len, line)
    toks
