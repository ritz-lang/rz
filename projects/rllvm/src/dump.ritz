# rllvm-ir FILE.ll: parse FILE.ll as rllvm does and print the module it read,
# for the round-trip tests. Exit status as rllvm's.
import ritzlib.fmt
import ritzlib.io { prints }
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.string { String }
import ritzlib.fs { read_file }
import rllvm.cli { EXIT_FAILED, report }
import rllvm.parse { parse_ir }
import rllvm.print { print_module }

const USAGE: StrView = "Usage: rllvm-ir FILE.ll"

pub fn main(args: Span<StrView>) -> i32
    if args.len != 2
        eprint("{USAGE}\n")
        return EXIT_FAILED
    let input: StrView = args[1]
    if input.eq("--help") or input.eq("-h")
        print("{USAGE}\n")
        return 0
    let text: String = match read_file(input)
        Ok(bytes) => bytes
        Err(_) =>
            eprint("rllvm-ir: {input}: cannot read file\n")
            return EXIT_FAILED
    match parse_ir(text.as_view())
        Ok(m) =>
            let out: String = print_module(@m)
            prints(out.as_view())
            0
        Err(f) => report("rllvm-ir", input, @f)
