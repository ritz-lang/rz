# rllvm -c [flags] FILE.ll [-o OUT]: compile one .ll in the closed subset to a
# relocatable ELF64 object, encoded and written by razm.
#
# Exit status: 0 compiled (or --help/-h printed the usage), 1 failed (usage,
# unreadable or malformed input), 2 the input is outside the subset; stderr
# names FILE:LINE and the construct, and the pipeline compiles it with clang.
import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.string { String }
import ritzlib.fs { read_file }
import rllvm.cli
import rllvm.ir { Module }
import rllvm.parse { parse }
import rllvm.subset { triple_is_elf }

const USAGE: StrView = "Usage: rllvm -c [-fPIC] [-mcmodel=small|kernel|large] [--target=TRIPLE] [-O0..-Oz] FILE.ll [-o OUT]"

pub fn main(args: Span<StrView>) -> i32
    let o: Options = match parse_args(args)
        Ok(opts) => opts
        Err(e) =>
            let msg: StrView = e.message.as_view()
            eprint("rllvm: {msg}\n{USAGE}\n")
            return EXIT_FAILED
    if o.help
        print("{USAGE}\n")
        return 0
    let input: StrView = o.input
    let text: String = match read_file(input)
        Ok(bytes) => bytes
        Err(_) =>
            eprint("rllvm: {input}: cannot read file\n")
            return EXIT_FAILED
    let target: StrView = o.target
    if target.len > 0 and not triple_is_elf(target)
        eprint("rllvm: {input}: unsupported: target triple '{target}'\n")
        return EXIT_UNSUPPORTED
    let m: Module = match parse(text.as_view())
        Ok(module) => module
        Err(f) => return report("rllvm", input, @f)
    let triple: StrView = m.triple
    let line: i64 = m.triple_line
    if target.len == 0 and triple.len > 0 and not triple_is_elf(triple)
        eprint("rllvm: {input}:{line}: unsupported: target triple '{triple}'\n")
        return EXIT_UNSUPPORTED
    eprint("rllvm: {input}: unsupported: lowering is not implemented\n")
    EXIT_UNSUPPORTED
