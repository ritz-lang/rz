# server.ritz - LSP Server Core
#
# Main server loop and request dispatch.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.option
import ritzlib.string
import ritzlib.json
import ritzlib.strview
import ritzlib.span

import transport
import protocol
import documents
import symbols
import diagnostics

# =============================================================================
# Server State
# =============================================================================

struct Server
    initialized: i32
    shutdown_requested: i32
    documents: DocumentStore
    response_buf: Vec<u8>
    result_buf: Vec<u8>

pub fn server_new() -> Server
    return Server {
        initialized: 0,
        shutdown_requested: 0,
        documents: document_store_new(),
        response_buf: vec_with_cap<u8>(4096),
        result_buf: vec_with_cap<u8>(1024)
    }

# A Server is an owned value: its documents and buffers go at the owner's
# scope end, so there is no server_drop to call.

# =============================================================================
# Request Handlers
# =============================================================================

# Handle initialize request
fn handle_initialize(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Handling initialize\n")

    # Advertise only what this server does (#2460): full-text document sync,
    # and hover / definition for function names in the open document
    # (#2789, symbols.ritz). Diagnostics are pushed, not advertised. Any
    # other request gets MethodNotFound from dispatch_message.
    let result: Span<u8> = span_from_strview("{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true},\"serverInfo\":{\"name\":\"ritz-lsp\",\"version\":\"0.1.0\"}}")

    build_response(msg.id, result, @s.response_buf)
    write_message_vec(@s.response_buf)

    s.initialized = 1

# Handle initialized notification
fn handle_initialized(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Client initialized\n")
    # No response needed for notifications

# Handle shutdown request
fn handle_shutdown(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Handling shutdown\n")
    s.shutdown_requested = 1

    # Every open document gets its diagnostics, even if input never paused.
    publish_pending(s)
    build_response(msg.id, span_from_strview("null"), @s.response_buf)
    write_message_vec(@s.response_buf)

# Handle exit notification
fn handle_exit(s: *Server, msg: *LspMessage) -> i32
    eprints("[ritz-lsp] Handling exit\n")
    if s.shutdown_requested != 0
        return 0  # Clean exit
    return 1  # Error exit (exit without shutdown)

# Handle textDocument/didOpen
fn handle_did_open(s: *Server, msg: *LspMessage)
    let params: @Json = match msg.params()
        Some(p) => p
        None => return
    let text_doc: @Json = match params.get_field("textDocument")
        Some(t) => t
        None => return
    let uri_val: @Json = match text_doc.get_field("uri")
        Some(u) => u
        None => return
    let text_val: @Json = match text_doc.get_field("text")
        Some(t) => t
        None => return

    let uri: StrView = lsp_view(Some(uri_val))
    let text: StrView = lsp_view(Some(text_val))
    let version: i64 = lsp_number(text_doc.get_field("version"))

    eprint("[ritz-lsp] Document opened: {uri}\n")

    # Marks it dirty; published once input pauses (publish_pending).
    document_open(@s.documents, uri, text, version)

# Handle textDocument/didChange
fn handle_did_change(s: *Server, msg: *LspMessage)
    let params: @Json = match msg.params()
        Some(p) => p
        None => return
    let text_doc: @Json = match params.get_field("textDocument")
        Some(t) => t
        None => return

    # Get content changes (full sync mode - single change with full text)
    let changes: @Json = match params.get_field("contentChanges")
        Some(c) => c
        None => return
    let first_change: @Json = match changes.get_index(0)
        Some(c) => c
        None => return
    let text_val: @Json = match first_change.get_field("text")
        Some(t) => t
        None => return

    let uri: StrView = lsp_view(text_doc.get_field("uri"))
    let text: StrView = lsp_view(Some(text_val))
    let version: i64 = lsp_number(text_doc.get_field("version"))

    eprint("[ritz-lsp] Document changed: {uri}\n")

    # Marks it dirty; a burst of changes compiles once, for the last.
    document_change(@s.documents, uri, text, version)

# Handle textDocument/didClose
fn handle_did_close(s: *Server, msg: *LspMessage)
    let params: @Json = match msg.params()
        Some(p) => p
        None => return
    let text_doc: @Json = match params.get_field("textDocument")
        Some(t) => t
        None => return
    let uri_val: @Json = match text_doc.get_field("uri")
        Some(u) => u
        None => return

    let uri: StrView = lsp_view(Some(uri_val))

    eprint("[ritz-lsp] Document closed: {uri}\n")

    document_close(@s.documents, uri)

    # A closed document's diagnostics go with it (the editor keeps the last
    # published list until told otherwise).
    s.result_buf.clear()
    s.result_buf.push_view("{\"uri\":")
    json_emit_string(uri, @&s.result_buf)
    s.result_buf.push_view(",\"diagnostics\":[]}")
    build_notification("textDocument/publishDiagnostics", span_from_vec(@s.result_buf), @s.response_buf)
    write_message_vec(@s.response_buf)

# textDocument/publishDiagnostics for open document `doc`, from a ritz1
# compile of its text (diagnostics.ritz).
fn publish_diagnostics(s: *Server, doc: *Document)
    diagnostics_json(doc.uri.as_view(), doc.version, doc.content.as_view(), @s.result_buf)
    build_notification("textDocument/publishDiagnostics", span_from_vec(@s.result_buf), @s.response_buf)
    write_message_vec(@s.response_buf)

# Publish every document opened or changed since its last publish, each for
# its latest version only (#3902). Compiling per didChange would cost a ritz1
# run per keystroke in a burst before the next request is answered.
fn publish_pending(s: *Server)
    loop
        let doc: *Document = document_take_dirty(@s.documents)
        if doc == null
            return
        publish_diagnostics(s, doc)

# The open document and position a hover/definition request names, or null
# (the request names no open document). Sets *line / *col.
fn request_doc(s: *Server, msg: *LspMessage, line: *i64, col: *i64) -> *Document
    let params: @Json = match msg.params()
        Some(p) => p
        None => return null
    let text_doc: @Json = match params.get_field("textDocument")
        Some(t) => t
        None => return null
    let pos: @Json = match params.get_field("position")
        Some(p) => p
        None => return null
    let uri_val: @Json = match text_doc.get_field("uri")
        Some(u) => u
        None => return null
    let uri: StrView = match uri_val.get_string()
        Some(u) => u
        None => return null
    *line = lsp_number(pos.get_field("line"))
    *col = lsp_number(pos.get_field("character"))
    document_get(@s.documents, uri)

# textDocument/hover: the signature of the function named at the position.
fn handle_hover(s: *Server, msg: *LspMessage)
    var line: i64 = 0
    var col: i64 = 0
    let doc: *Document = request_doc(s, msg, @line, @col)
    s.result_buf.clear()
    if doc == null
        let _: bool = s.result_buf.push_view("null")
    else
        hover_json(doc.uri.as_view(), doc.content.as_view(), line, col, @s.result_buf)
    build_response(msg.id, span_from_vec(@s.result_buf), @s.response_buf)
    write_message_vec(@s.response_buf)

# textDocument/definition: where the function named at the position is
# declared in the document.
fn handle_definition(s: *Server, msg: *LspMessage)
    var line: i64 = 0
    var col: i64 = 0
    let doc: *Document = request_doc(s, msg, @line, @col)
    s.result_buf.clear()
    if doc == null
        let _: bool = s.result_buf.push_view("null")
    else
        definition_json(doc.uri.as_view(), doc.content.as_view(), line, col, @s.result_buf)
    build_response(msg.id, span_from_vec(@s.result_buf), @s.response_buf)
    write_message_vec(@s.response_buf)

# =============================================================================
# Request Dispatch
# =============================================================================

pub fn dispatch_message(s: *Server, msg: *LspMessage) -> i32
    if not msg.has_method
        return 0

    # Check method and dispatch
    if msg.method.eq("initialize")
        handle_initialize(s, msg)
    else if msg.method.eq("initialized")
        handle_initialized(s, msg)
    else if msg.method.eq("shutdown")
        handle_shutdown(s, msg)
    else if msg.method.eq("exit")
        return handle_exit(s, msg)
    else if msg.method.eq("textDocument/didOpen")
        handle_did_open(s, msg)
    else if msg.method.eq("textDocument/didChange")
        handle_did_change(s, msg)
    else if msg.method.eq("textDocument/didClose")
        handle_did_close(s, msg)
    else if msg.method.eq("textDocument/hover")
        handle_hover(s, msg)
    else if msg.method.eq("textDocument/definition")
        handle_definition(s, msg)
    else
        eprint("[ritz-lsp] Unknown method: {msg.method}\n")

        # Return method not found for requests
        if msg.kind == MSG_REQUEST
            build_error_response(msg.id, LSP_ERR_METHOD_NOT_FOUND, "Method not found", @s.response_buf)
            write_message_vec(@s.response_buf)

    return 0

# =============================================================================
# Main Server Loop
# =============================================================================

pub fn server_run(s: *Server) -> i32
    eprints("[ritz-lsp] Server starting...\n")

    loop
        # Compile only when no more input is waiting: the changes already
        # queued would replace the text before anyone saw its diagnostics.
        if not input_pending()
            publish_pending(s)
        match read_message()
            Some(json) =>
                var msg: LspMessage = parse_message(json.as_view())
                let exit_code: i32 = dispatch_message(s, @msg)
                # msg.method borrows from msg.root, which is still alive here.
                if s.shutdown_requested != 0 and msg.method.eq("exit")
                    return exit_code
            None =>
                eprints("[ritz-lsp] Connection closed\n")
                return 0
