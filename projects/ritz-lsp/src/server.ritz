# server.ritz - LSP Server Core
#
# Main server loop and request dispatch.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.json
import ritzlib.strview

import transport
import protocol
import documents
import symbols
import diagnostics

# =============================================================================
# Server State
# =============================================================================

struct Server
    initialized: i32
    shutdown_requested: i32
    documents: DocumentStore
    response_buf: Vec<u8>
    result_buf: Vec<u8>

pub fn server_new() -> Server
    return Server {
        initialized: 0,
        shutdown_requested: 0,
        documents: document_store_new(),
        response_buf: vec_with_cap<u8>(4096),
        result_buf: vec_with_cap<u8>(1024)
    }

pub fn server_drop(s: *Server)
    document_store_drop(@s.documents)

# =============================================================================
# Request Handlers
# =============================================================================

# Handle initialize request
fn handle_initialize(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Handling initialize\n")

    # Advertise only what this server does (#2460): full-text document sync,
    # and hover / definition for function names in the open document
    # (#2789, symbols.ritz). Diagnostics are pushed, not advertised. Any
    # other request gets MethodNotFound from dispatch_message.
    let result: *u8 = c"{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true},\"serverInfo\":{\"name\":\"ritz-lsp\",\"version\":\"0.1.0\"}}"

    build_response(msg.id, result, @s.response_buf)
    write_message_vec(@s.response_buf)

    s.initialized = 1

# Handle initialized notification
fn handle_initialized(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Client initialized\n")
    # No response needed for notifications

# Handle shutdown request
fn handle_shutdown(s: *Server, msg: *LspMessage)
    eprints("[ritz-lsp] Handling shutdown\n")
    s.shutdown_requested = 1

    # Every open document gets its diagnostics, even if input never paused.
    publish_pending(s)
    build_response(msg.id, c"null", @s.response_buf)
    write_message_vec(@s.response_buf)

# Handle exit notification
fn handle_exit(s: *Server, msg: *LspMessage) -> i32
    eprints("[ritz-lsp] Handling exit\n")
    if s.shutdown_requested != 0
        return 0  # Clean exit
    return 1  # Error exit (exit without shutdown)

# Handle textDocument/didOpen
fn handle_did_open(s: *Server, msg: *LspMessage)
    if msg.params == null
        return

    let text_doc: *JsonValue = lsp_field(msg.params, "textDocument")
    if text_doc == null
        return

    let uri_val: *JsonValue = lsp_field(text_doc, "uri")
    let text_val: *JsonValue = lsp_field(text_doc, "text")
    let version_val: *JsonValue = lsp_field(text_doc, "version")

    if uri_val == null || text_val == null
        return

    let uri: *u8 = lsp_string(uri_val)
    let text: *u8 = lsp_string(text_val)
    let version: i64 = lsp_number(version_val)

    eprint("[ritz-lsp] Document opened: {lsp_view(uri_val)}\n")

    # Marks it dirty; published once input pauses (publish_pending).
    document_open(@s.documents, uri, text, version)

# Handle textDocument/didChange
fn handle_did_change(s: *Server, msg: *LspMessage)
    if msg.params == null
        return

    let text_doc: *JsonValue = lsp_field(msg.params, "textDocument")
    if text_doc == null
        return

    let uri_val: *JsonValue = lsp_field(text_doc, "uri")
    let version_val: *JsonValue = lsp_field(text_doc, "version")

    # Get content changes (full sync mode - single change with full text)
    let changes: *JsonValue = lsp_field(msg.params, "contentChanges")
    if changes == null || changes.kind != JSON_ARRAY || changes.count == 0
        return

    let first_change: *JsonValue = lsp_index(changes, 0)
    if first_change == null
        return

    let text_val: *JsonValue = lsp_field(first_change, "text")
    if text_val == null
        return

    let uri: *u8 = lsp_string(uri_val)
    let text: *u8 = lsp_string(text_val)
    let version: i64 = lsp_number(version_val)

    eprint("[ritz-lsp] Document changed: {lsp_view(uri_val)}\n")

    # Marks it dirty; a burst of changes compiles once, for the last.
    document_change(@s.documents, uri, text, version)

# Handle textDocument/didClose
fn handle_did_close(s: *Server, msg: *LspMessage)
    if msg.params == null
        return

    let text_doc: *JsonValue = lsp_field(msg.params, "textDocument")
    if text_doc == null
        return

    let uri_val: *JsonValue = lsp_field(text_doc, "uri")
    if uri_val == null
        return

    let uri: *u8 = lsp_string(uri_val)

    eprint("[ritz-lsp] Document closed: {lsp_view(uri_val)}\n")

    document_close(@s.documents, uri)

    # A closed document's diagnostics go with it (the editor keeps the last
    # published list until told otherwise).
    s.result_buf.clear()
    s.result_buf.push_str(c"{\"uri\":")
    json_emit_string(strview_from_cstr(uri), @&s.result_buf)
    s.result_buf.push_str(c",\"diagnostics\":[]}")
    s.result_buf.push(0)
    build_notification(c"textDocument/publishDiagnostics", s.result_buf.data, @s.response_buf)
    write_message_vec(@s.response_buf)

# textDocument/publishDiagnostics for open document `doc`, from a ritz1
# compile of its text (diagnostics.ritz).
fn publish_diagnostics(s: *Server, doc: *Document)
    if doc.content == null
        return
    diagnostics_json(doc.uri, doc.version, doc.content, doc.content_len, @s.result_buf)
    s.result_buf.push(0)
    build_notification(c"textDocument/publishDiagnostics", s.result_buf.data, @s.response_buf)
    write_message_vec(@s.response_buf)

# Publish every document opened or changed since its last publish, each for
# its latest version only (#3902). Compiling per didChange would cost a ritz1
# run per keystroke in a burst before the next request is answered.
fn publish_pending(s: *Server)
    loop
        let doc: *Document = document_take_dirty(@s.documents)
        if doc == null
            return
        publish_diagnostics(s, doc)

# The open document and position a hover/definition request names, or null
# (the request names no open document). Sets *line / *col.
fn request_doc(s: *Server, msg: *LspMessage, line: *i64, col: *i64) -> *Document
    if msg.params == null
        return null
    let text_doc: *JsonValue = lsp_field(msg.params, "textDocument")
    let pos: *JsonValue = lsp_field(msg.params, "position")
    if text_doc == null or pos == null
        return null
    let uri: *u8 = lsp_string(lsp_field(text_doc, "uri"))
    if uri == null
        return null
    *line = lsp_number(lsp_field(pos, "line"))
    *col = lsp_number(lsp_field(pos, "character"))
    let doc: *Document = document_get(@s.documents, uri)
    if doc == null or doc.content == null
        return null
    doc

# textDocument/hover: the signature of the function named at the position.
fn handle_hover(s: *Server, msg: *LspMessage)
    var line: i64 = 0
    var col: i64 = 0
    let doc: *Document = request_doc(s, msg, @line, @col)
    s.result_buf.clear()
    if doc == null
        let _: bool = s.result_buf.push_str(c"null")
    else
        hover_json(doc.uri, doc.content, doc.content_len, line, col, @s.result_buf)
    s.result_buf.push(0)
    build_response(msg.id, s.result_buf.data, @s.response_buf)
    write_message_vec(@s.response_buf)

# textDocument/definition: where the function named at the position is
# declared in the document.
fn handle_definition(s: *Server, msg: *LspMessage)
    var line: i64 = 0
    var col: i64 = 0
    let doc: *Document = request_doc(s, msg, @line, @col)
    s.result_buf.clear()
    if doc == null
        let _: bool = s.result_buf.push_str(c"null")
    else
        definition_json(doc.uri, doc.content, doc.content_len, line, col, @s.result_buf)
    s.result_buf.push(0)
    build_response(msg.id, s.result_buf.data, @s.response_buf)
    write_message_vec(@s.response_buf)

# =============================================================================
# Request Dispatch
# =============================================================================

pub fn dispatch_message(s: *Server, msg: *LspMessage) -> i32
    if msg.method == null
        return 0

    # Check method and dispatch
    if streq(msg.method, c"initialize")
        handle_initialize(s, msg)
    else if streq(msg.method, c"initialized")
        handle_initialized(s, msg)
    else if streq(msg.method, c"shutdown")
        handle_shutdown(s, msg)
    else if streq(msg.method, c"exit")
        return handle_exit(s, msg)
    else if streq(msg.method, c"textDocument/didOpen")
        handle_did_open(s, msg)
    else if streq(msg.method, c"textDocument/didChange")
        handle_did_change(s, msg)
    else if streq(msg.method, c"textDocument/didClose")
        handle_did_close(s, msg)
    else if streq(msg.method, c"textDocument/hover")
        handle_hover(s, msg)
    else if streq(msg.method, c"textDocument/definition")
        handle_definition(s, msg)
    else
        eprint("[ritz-lsp] Unknown method: {strview_from_cstr(msg.method)}\n")

        # Return method not found for requests
        if msg.kind == MSG_REQUEST
            build_error_response(msg.id, LSP_ERR_METHOD_NOT_FOUND, c"Method not found", @s.response_buf)
            write_message_vec(@s.response_buf)

    return 0

# =============================================================================
# Main Server Loop
# =============================================================================

pub fn server_run(s: *Server) -> i32
    eprints("[ritz-lsp] Server starting...\n")

    loop
        # Compile only when no more input is waiting: the changes already
        # queued would replace the text before anyone saw its diagnostics.
        if not input_pending()
            publish_pending(s)
        let json_str: *u8 = read_message()
        if json_str == null
            eprints("[ritz-lsp] Connection closed\n")
            break

        var msg: LspMessage = parse_message(json_str)

        let exit_code: i32 = dispatch_message(s, @msg)

        lsp_message_free(@msg)
        free(json_str)

        if s.shutdown_requested != 0 && streq(msg.method, c"exit")
            return exit_code

    return 0
