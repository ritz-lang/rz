# paths.ritz - file paths, file:// uris and the import roots (AGAST #2789, #3884)
#
# The diagnostics compile (diagnostics.ritz) and the import lookup behind
# hover / definition (symbols.ritz) resolve a document's imports from the same
# roots, so both read them from import_path() here.

import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.option
import ritzlib.os.env
import ritzlib.fs { read_link, access }

# The monorepo's projects/ directory, four levels above this binary, or ""
# if /proc/self/exe cannot be read.
pub fn projects_dir() -> String
    var exe: String = string_new()
    match read_link("/proc/self/exe")
        Ok(s) => exe = s
        Err(_) => return string_new()
    let p: *u8 = exe.as_ptr()
    let n: i64 = exe.len()
    var end: i64 = n
    var up: i32 = 0
    while up < 4 and end > 0
        end -= 1
        while end > 0 and *(p + end) != '/'
            end -= 1
        up += 1
    if n <= 0 or end <= 0
        return string_new()
    string_from_bytes(Span<u8> { ptr: (p), len: (end) as i64 })

pub fn exists(path: @&String, mode: i32) -> bool
    match access(path.as_view(), mode)
        Ok(_) => true
        Err(_) => false

# The decoded file-system path of a file:// uri, or "" for any other uri.
pub fn uri_path(uri: *u8) -> String
    var out: String = string_new()
    let n: i64 = strlen(uri)
    if n < 7 or memcmp(uri, c"file://", 7) != 0
        return out
    var i: i64 = 7
    while i < n
        let c: u8 = *(uri + i)
        if c == '%' and i + 2 < n and hex_val(*(uri + i + 1)) >= 0 and hex_val(*(uri + i + 2)) >= 0
            out.push((hex_val(*(uri + i + 1)) * 16 + hex_val(*(uri + i + 2))) as u8)
            i += 3
        else
            out.push(c)
            i += 1
    out

fn hex_val(c: u8) -> i32
    if c >= '0' and c <= '9'
        return (c - '0') as i32
    if c >= 'a' and c <= 'f'
        return (c - 'a') as i32 + 10
    if c >= 'A' and c <= 'F'
        return (c - 'A') as i32 + 10
    -1

# Whether `c` stands for itself in a uri path: RFC 3986's unreserved
# characters and '/'.  Everything else is %XX-encoded.
fn uri_plain(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '-' or c == '.' or c == '_' or c == '~' or c == '/'

# The file:// uri of the absolute path `path` (the inverse of uri_path).
pub fn uri_from_path(path: @&String) -> String
    var out: String = string_from("file://")
    let p: *u8 = path.as_ptr()
    let n: i64 = path.len()
    var i: i64 = 0
    while i < n
        let c: u8 = *(p + i)
        if uri_plain(c)
            out.push(c)
        else
            out.push('%')
            out.push(*(c"0123456789ABCDEF" + (c >> 4) as i64))
            out.push(*(c"0123456789ABCDEF" + (c & 15) as i64))
        i += 1
    out

# Offset of the last '/' in s, or -1.
pub fn last_slash(s: *u8, len: i64) -> i64
    var i: i64 = len - 1
    while i >= 0 and *(s + i) != '/'
        i -= 1
    i

# `-I`: the document's directory and up to 7 ancestors, then projects/ritz.
pub fn import_path(doc_path: @&String) -> String
    var out: String = string_new()
    let p: *u8 = doc_path.as_ptr()
    var end: i64 = last_slash(p, doc_path.len())
    var levels: i32 = 0
    while end > 0 and levels < 8
        if out.len() > 0
            out.push(':')
        out.push_span(Span<u8> { ptr: (p), len: (end) as i64 })
        end = last_slash(p, end)
        levels += 1
    var root: String = projects_dir()
    if root.len() > 0
        root.push_str("/ritz")
        var lib: String = root.clone()
        lib.push_str("/ritzlib")
        if exists(@&lib, 0)
            if out.len() > 0
                out.push(':')
            out.push_string(@root)
    out

# Every root ritz1 searches for the document `doc_path`'s imports: the `-I`
# it is given (import_path), then $RITZ_PATH, which ritz1 appends itself.
pub fn lookup_roots(doc_path: @&String) -> String
    var out: String = import_path(doc_path)
    match env_get("RITZ_PATH")
        Some(v) =>
            if v.len > 0
                if out.len() > 0
                    out.push(':')
                out.push_str(v)
        None => pass
    out
