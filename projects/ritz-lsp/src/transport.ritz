# transport.ritz - JSON-RPC over stdio transport for LSP
#
# LSP uses JSON-RPC 2.0 over stdio with HTTP-style headers:
#   Content-Length: <length>\r\n
#   \r\n
#   <JSON payload>

import ritzlib.io
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.string
import ritzlib.strview
import ritzlib.fd { fd_stdin, fd_stdout, poll, PollFd, POLLIN }
import ritzlib.span

# =============================================================================
# Transport State
# =============================================================================

struct Transport
    read_buf: Vec<u8>       # Buffer for reading
    write_buf: Vec<u8>      # Buffer for writing

pub fn transport_new() -> Transport
    return Transport {
        read_buf: vec_with_cap<u8>(4096),
        write_buf: vec_with_cap<u8>(4096)
    }

# A Transport is an owned value: the compiler frees its Vec fields at the
# owner's scope end, so there is no transport_drop to call (#2159).

# =============================================================================
# Reading Messages
# =============================================================================

# Read a single byte from stdin, returns -1 on EOF
fn read_byte() -> i32
    var buf: [1]u8
    let one: [u8] = @buf
    match fd_stdin().read(one)
        Ok(n) =>
            if n <= 0
                return -1
        Err(_) => return -1
    return buf[0] as i32

# A Content-Length header value as a byte count, or -1. Whitespace around it
# is allowed; the rest must be digits only (no sign) within i64 (#1958).
# i64::MAX parses, and read_message reaches EOF before that many bytes,
# closing the connection like any other bad length.
fn content_length_value(value: StrView) -> i64
    let v: StrView = value.trim()
    if v.len == 0 or v.get(0) < '0' or v.get(0) > '9'
        return -1
    match v.parse_i64()
        Some(n) => n
        None => -1

# Read until we see \r\n\r\n (end of headers)
# Returns content length, or -1 on error
pub fn read_headers() -> i64
    var content_length: i64 = -1
    var line_buf: Vec<u8> = vec_with_cap<u8>(256)

    loop
        # Read a line (until \r\n)
        line_buf.clear()
        loop
            let ch: i32 = read_byte()
            if ch == -1
                return -1
            if ch == '\r'
                let next: i32 = read_byte()
                if next == '\n'
                    break
                # Weird, shouldn't happen
                line_buf.push(ch as u8)
                if next != -1
                    line_buf.push(next as u8)
            else
                line_buf.push(ch as u8)

        # Empty line means end of headers
        if line_buf.len == 0
            break

        # Check for Content-Length header; its value runs from after the colon.
        let bytes: [u8] = line_buf[0..line_buf.len]
        let line: StrView = bytes.as_strview()
        if line.starts_with("Content-Length:")
            content_length = content_length_value(line.skip(15))

    return content_length

# Whether a message (or part of one) is waiting on stdin. Reads are
# unbuffered (read_byte, read_message), so what poll reports is everything not
# yet consumed. EOF alone is not input.
pub fn input_pending() -> bool
    var fds: [1]PollFd
    fds[0].fd = fd_stdin().raw()
    fds[0].events = POLLIN
    fds[0].revents = 0
    let polled: [PollFd] = @fds
    match poll(polled, 0)
        Ok(n) =>
            if n <= 0
                return false
        Err(_) => return false
    (fds[0].revents & POLLIN) != 0

# Read a complete LSP message: its JSON payload, or None once the connection
# is closed or the header is bad.  The payload is read a chunk at a time, so
# a Content-Length larger than what follows (up to i64::MAX) ends at EOF
# instead of asking for that much memory up front.
pub fn read_message() -> Option<String>
    let content_length: i64 = read_headers()
    if content_length <= 0
        return None

    var payload: String = string_new()
    var chunk: [4096]u8
    let scratch: [u8] = @chunk
    var left: i64 = content_length
    while left > 0
        var n: i64 = left
        if n > scratch.len
            n = scratch.len
        let part: [u8] = scratch[0..n]
        match fd_stdin().read_exact(part)
            Ok(_) => pass
            Err(_) => return None
        payload.push_span(part)
        left -= n
    Some(payload)

# =============================================================================
# Writing Messages
# =============================================================================

# Write a complete LSP message
pub fn write_message(json: Span<u8>)
    print("Content-Length: {json.len}\r\n\r\n")
    fd_stdout().write_all(json)

# Write message from Vec<u8> buffer
pub fn write_message_vec(buf: *Vec<u8>)
    let json: [u8] = buf[0..buf.len]
    write_message(json)
