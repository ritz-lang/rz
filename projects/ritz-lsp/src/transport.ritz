# transport.ritz - JSON-RPC over stdio transport for LSP
#
# LSP uses JSON-RPC 2.0 over stdio with HTTP-style headers:
#   Content-Length: <length>\r\n
#   \r\n
#   <JSON payload>

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.strview
import ritzlib.fd { fd_stdin, fd_stdout }
import ritzlib.span { Span }

# =============================================================================
# Transport State
# =============================================================================

struct Transport
    read_buf: Vec<u8>       # Buffer for reading
    write_buf: Vec<u8>      # Buffer for writing

pub fn transport_new() -> Transport
    return Transport {
        read_buf: vec_with_cap<u8>(4096),
        write_buf: vec_with_cap<u8>(4096)
    }

# A Transport is an owned value: the compiler frees its Vec fields at the
# owner's scope end, so there is no transport_drop to call (#2159).

# =============================================================================
# Reading Messages
# =============================================================================

# Read a single byte from stdin, returns -1 on EOF
fn read_byte() -> i32
    var buf: [1]u8
    match fd_stdin().read(Span<u8> { ptr: @buf[0], len: 1 })
        Ok(n) =>
            if n <= 0
                return -1
        Err(_) => return -1
    return buf[0] as i32

# A Content-Length header value as a byte count, or -1. Whitespace around it
# is allowed; the rest must be digits only (no sign) within i64 (#1958).
# i64::MAX parses, and read_message's allocation of it fails, closing the
# connection like any other bad length.
fn content_length_value(value: StrView) -> i64
    let v: StrView = value.trim()
    if v.len == 0 or v.get(0) < '0' or v.get(0) > '9'
        return -1
    match v.parse_i64()
        Some(n) => n
        None => -1

# Read until we see \r\n\r\n (end of headers)
# Returns content length, or -1 on error
pub fn read_headers() -> i64
    var content_length: i64 = -1
    var line_buf: Vec<u8> = vec_with_cap<u8>(256)

    loop
        # Read a line (until \r\n)
        line_buf.clear()
        loop
            let ch: i32 = read_byte()
            if ch == -1
                return -1
            if ch == '\r'
                let next: i32 = read_byte()
                if next == '\n'
                    break
                # Weird, shouldn't happen
                line_buf.push(ch as u8)
                if next != -1
                    line_buf.push(next as u8)
            else
                line_buf.push(ch as u8)

        # Empty line means end of headers
        if line_buf.len == 0
            break

        # Null-terminate for string comparison
        line_buf.push(0)

        # Check for Content-Length header
        if strneq(line_buf.data, c"Content-Length:", 15)
            # The value runs from after the colon to before the NUL pushed above.
            let value: StrView = strview_from_ptr(line_buf.data + 15, line_buf.len - 16)
            content_length = content_length_value(value)

    return content_length

# Read exactly n bytes from stdin into buffer
pub fn read_exact(buf: *u8, n: i64) -> i32
    match fd_stdin().read_exact(Span<u8> { ptr: buf, len: n })
        Ok(_) => 0
        Err(_) => -1

# Whether a message (or part of one) is waiting on stdin. Reads are
# unbuffered (read_byte, read_exact), so what poll reports is everything not
# yet consumed. EOF alone is not input.
pub fn input_pending() -> bool
    var fds: [1]PollFd
    fds[0].fd = STDIN
    fds[0].events = POLLIN
    fds[0].revents = 0
    if sys_poll(@fds[0], 1, 0) <= 0
        return false
    (fds[0].revents & POLLIN) != 0

# Read a complete LSP message
# Returns the JSON payload as a null-terminated string (caller must free)
pub fn read_message() -> *u8
    let content_length: i64 = read_headers()
    if content_length <= 0
        return null

    # One byte for the NUL.  i64::MAX parses as a length, but i64::MAX + 1
    # overflows i64, and no allocation that large can succeed: treat it as
    # a length we cannot buffer, like any other that malloc refuses.
    if content_length == 9223372036854775807
        return null

    # Allocate buffer for content + null terminator
    let buf: *u8 = malloc(content_length + 1)
    if buf == null
        return null

    if read_exact(buf, content_length) != 0
        free(buf)
        return null

    # Null-terminate
    *(buf + content_length) = 0
    return buf

# =============================================================================
# Writing Messages
# =============================================================================

# Write a complete LSP message
pub fn write_message(json: *u8, len: i64)
    # Write headers
    print("Content-Length: {len}\r\n\r\n")

    # Write content
    fd_stdout().write_all(Span<u8> { ptr: json, len: len })

# Write message from Vec<u8> buffer
pub fn write_message_vec(buf: *Vec<u8>)
    write_message(buf.data, buf.len)
