# main.ritz - ritz-lsp Entry Point
#
# Language Server Protocol implementation for the Ritz programming language.
# Communicates over stdio using JSON-RPC 2.0.

import ritzlib.sys
import ritzlib.io
import ritzlib.str { streq }

import server

const USAGE: StrView = "Usage: ritz-lsp [--stdio | -h | --help]\n  Ritz Language Server: speaks the Language Server Protocol (JSON-RPC 2.0)\n  over stdin/stdout until the client sends `exit` or closes stdin. Start it\n  from your editor's LSP client; --stdio is accepted and is the default.\n"

# Command line (AGAST #3159): answer -h/--help and reject anything unknown
# before the server starts, since a started server reads stdin until EOF and
# an editor never closes it. Returns -1 to serve, else the exit code.
fn parse_args(argc: i32, argv: **u8) -> i32
    var i: i32 = 1
    while i < argc
        let arg: *u8 = *(argv + i)
        if streq(arg, c"-h") or streq(arg, c"--help")
            prints(USAGE)
            return 0
        if not streq(arg, c"--stdio")
            eprints_cstr(c"ritz-lsp: unknown argument: ")
            eprints_cstr(arg)
            eprints_cstr(c"\n")
            eprints(USAGE)
            return 2
        i = i + 1
    return -1

pub fn main(argc: i32, argv: **u8) -> i32
    let early: i32 = parse_args(argc, argv)
    if early >= 0
        return early

    eprints_cstr(c"[ritz-lsp] Ritz Language Server v0.1.0\n")

    var s: Server = server_new()
    let exit_code: i32 = server_run(@s)
    server_drop(@s)

    return exit_code
