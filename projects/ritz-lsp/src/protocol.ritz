# protocol.ritz - LSP Protocol Message Handling
#
# Handles JSON-RPC 2.0 messages for LSP communication.
# Parses incoming requests and builds responses.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.json

# =============================================================================
# JSON Value Types (mirrored from ritzlib/json.ritz)
# =============================================================================

const MSG_REQUEST: i32 = 1      # Has "id" and "method"
const MSG_RESPONSE: i32 = 2     # Has "id" and "result" or "error"
const MSG_NOTIFICATION: i32 = 3 # Has "method" but no "id"

# The message owns its parsed `Json` root and frees it when it goes out of
# scope; `method` and the params()/result() borrows point into that root (a
# String's buffer does not move when the message does).
struct LspMessage
    kind: i32               # MSG_* type
    id: i64                 # Request/response ID (-1 if notification)
    id_is_string: i32       # 1 if ID was a string
    method: StrView         # Method name (borrowed from root; "" if none)
    has_method: bool        # The message has a string "method" (false for responses)
    error_code: i32         # Error code (for error responses)
    error_msg: *u8          # Error message (for error responses)
    root: Json              # The parsed message (Null if it did not parse)

pub fn lsp_message_new() -> LspMessage
    return LspMessage {
        kind: 0,
        id: -1,
        id_is_string: 0,
        method: "",
        has_method: false,
        error_code: 0,
        error_msg: null,
        root: Json.Null
    }

impl LspMessage
    # The "params" value, if the message has one.
    pub fn params(self: @LspMessage) -> Option<@Json>
        self.root.get_field("params")

    # The "result" value (for responses), if the message has one.
    pub fn result(self: @LspMessage) -> Option<@Json>
        self.root.get_field("result")

# =============================================================================
# JSON access adapters
# =============================================================================

# The text of string `v`, or "" if `v` is not a string.  Borrows from `v`.
pub fn lsp_view(v: Option<@Json>) -> StrView
    match v
        Some(j) =>
            let r: @Json = j
            match r.get_string()
                Some(s) => s
                None => ""
        None => ""

# The value of number `v`, or 0 if `v` is not a number.
pub fn lsp_number(v: Option<@Json>) -> i64
    match v
        Some(j) =>
            let r: @Json = j
            match r.get_number()
                Some(n) => n
                None => 0
        None => 0

# =============================================================================
# Message Parsing
# =============================================================================

# Parse a JSON-RPC message; on a parse error the message has kind 0.
pub fn parse_message(json_str: *u8) -> LspMessage
    var msg: LspMessage = lsp_message_new()

    match json_parse(strview_from_cstr(json_str))
        Ok(root) =>
            fill_message(@&msg, root)
        Err(err) =>
            eprint("[ritz-lsp] JSON parse error at position {err.pos}\n")
    return msg

# Classify `root` into `msg` and move it in as msg.root.
fn fill_message(msg: @&LspMessage, root: Json)
    # Check for "jsonrpc": "2.0"
    if root.get_field("jsonrpc").is_none()
        eprints("[ritz-lsp] Missing jsonrpc field\n")
        msg.root = root
        return

    # Get ID if present
    let has_id: bool = root.get_field("id").is_some()
    match root.get_field("id")
        Some(idv) =>
            let r: @Json = idv
            match *r
                Number(n) =>
                    msg.id = n
                Str(_) =>
                    # For string IDs, store as number (hash or just use 0)
                    msg.id_is_string = 1
                    msg.id = 0
                _ =>
                    pass
        None =>
            pass

    # Get method if present
    match root.get_field("method")
        Some(mv) =>
            let r: @Json = mv
            match r.get_string()
                Some(m) =>
                    msg.method = m
                    msg.has_method = true
                None =>
                    pass
        None =>
            pass

    # Determine message type
    if msg.has_method
        if msg.id >= 0 || has_id
            msg.kind = MSG_REQUEST
        else
            msg.kind = MSG_NOTIFICATION
    else if root.get_field("result").is_some() || root.get_field("error").is_some()
        msg.kind = MSG_RESPONSE
    msg.root = root

# =============================================================================
# Response Building
# =============================================================================

# Build a success response
pub fn build_response(id: i64, result_json: Span<u8>, buf: *Vec<u8>)
    buf.clear()
    buf.push_view("{\"jsonrpc\":\"2.0\",\"id\":")

    let id_s: String = string_from_i64(id)
    buf.push_span(id_s.as_view().as_bytes())

    buf.push_view(",\"result\":")
    buf.push_span(result_json)
    buf.push('}')

# Build an error response
pub fn build_error_response(id: i64, code: i32, message: StrView, buf: *Vec<u8>)
    buf.clear()
    buf.push_view("{\"jsonrpc\":\"2.0\",\"id\":")

    let id_s: String = string_from_i64(id)
    buf.push_span(id_s.as_view().as_bytes())

    buf.push_view(",\"error\":{\"code\":")

    let code_s: String = string_from_i64(code as i64)
    buf.push_span(code_s.as_view().as_bytes())

    buf.push_view(",\"message\":\"")
    buf.push_view(message)
    buf.push_view("\"}}")

# Build a notification (no ID, no response expected)
pub fn build_notification(method: StrView, params_json: Span<u8>, buf: *Vec<u8>)
    buf.clear()
    buf.push_view("{\"jsonrpc\":\"2.0\",\"method\":\"")
    buf.push_view(method)
    buf.push_view("\",\"params\":")
    buf.push_span(params_json)
    buf.push('}')

# =============================================================================
# LSP Error Codes
# =============================================================================

const LSP_ERR_PARSE: i32 = -32700
const LSP_ERR_INVALID_REQUEST: i32 = -32600
const LSP_ERR_METHOD_NOT_FOUND: i32 = -32601
const LSP_ERR_INVALID_PARAMS: i32 = -32602
const LSP_ERR_INTERNAL: i32 = -32603
const LSP_ERR_SERVER_NOT_INITIALIZED: i32 = -32002
const LSP_ERR_REQUEST_CANCELLED: i32 = -32800
