# symbols.ritz - function names in an open document and its imports
# (AGAST #2789, #3884)
#
# Hover and go-to-definition for a function name the open document declares
# or imports (see "Imports" below for how imported modules are found).
# These read the buffer the editor sent, not a ritz1 compile: they answer
# while the buffer is half-typed and does not parse, and they need no
# compiler on the machine.
#
# A function declaration is a line whose first words are `fn <name>`,
# optionally after `pub`, `extern` or `async` and any indentation (methods
# in an `impl` are indented).  Ritz has no block comments and no multi-line
# string literals, so a `fn` that starts a line is never inside either.
#
# Positions are 0-based.  LSP's `character` counts UTF-16 code units (the
# encoding every server must support; ritz-lsp offers no other), while the
# text is UTF-8 and the code here works in byte offsets.  doc_offset turns an
# incoming position into a byte offset and push_word_range turns a byte range
# back into LSP positions (#3885).

import ritzlib.sys
import ritzlib.str
import ritzlib.gvec
import ritzlib.json
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.fs

import paths

# =============================================================================
# Bytes and lines
# =============================================================================

fn is_ident_start(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

fn is_ident_char(c: u8) -> bool
    is_ident_start(c) or (c >= '0' and c <= '9')

fn is_blank(c: u8) -> bool
    c == ' ' or c == '\t'

# Offset of the first byte of line `line`, or -1 if the text has fewer lines.
pub fn line_start(text: *u8, len: i64, line: i64) -> i64
    if line < 0
        return -1
    var i: i64 = 0
    var l: i64 = 0
    while l < line
        if i >= len
            return -1
        if *(text + i) == '\n'
            l += 1
        i += 1
    i

# Offset of the end of the line starting at `start` (its '\n', or `len`).
pub fn line_end(text: *u8, len: i64, start: i64) -> i64
    var i: i64 = start
    while i < len and *(text + i) != '\n'
        i += 1
    i

# UTF-16 code units taken by the character whose UTF-8 encoding starts with
# byte `c`: 2 for a 4-byte sequence (a surrogate pair), 1 for any other lead
# byte, 0 for a continuation byte (it is part of a character already counted).
fn utf16_units(c: u8) -> i64
    if (c & 0xC0) == 0x80
        return 0
    if c >= 0xF0
        return 2
    1

# The UTF-16 column of byte offset `off` on the line starting at `start`.
fn utf16_col(text: *u8, start: i64, off: i64) -> i64
    var n: i64 = 0
    var i: i64 = start
    while i < off
        n += utf16_units(*(text + i))
        i += 1
    n

# Offset of the character at LSP position (line, character), where character
# counts UTF-16 code units, or -1 if no character on that line is there.  A
# position inside a surrogate pair gives that character's first byte.
pub fn doc_offset(text: *u8, len: i64, line: i64, character: i64) -> i64
    let start: i64 = line_start(text, len, line)
    if start < 0 or character < 0
        return -1
    let end: i64 = line_end(text, len, start)
    var units: i64 = 0
    var i: i64 = start
    while i < end
        let n: i64 = utf16_units(*(text + i))
        if n > 0
            if character < units + n
                return i
            units += n
        i += 1
    -1

# Offset of byte column `col` on `line`, or -1 if that is not a byte on that
# line.  (ritz1's columns count bytes.)
pub fn byte_offset(text: *u8, len: i64, line: i64, col: i64) -> i64
    let start: i64 = line_start(text, len, line)
    if start < 0 or col < 0
        return -1
    if start + col >= line_end(text, len, start)
        return -1
    start + col

# The LSP character (UTF-16 column) of byte column `col` on `line`.  Bytes
# past the end of the line, or the whole column on a line past the end of the
# text, count one unit each, so an out-of-range position stays out of range.
pub fn lsp_char(text: *u8, len: i64, line: i64, col: i64) -> i64
    let start: i64 = line_start(text, len, line)
    if start < 0
        return col
    let end: i64 = line_end(text, len, start)
    if start + col <= end
        return utf16_col(text, start, start + col)
    utf16_col(text, start, end) + start + col - end

# The line holding offset `off` (0-based).
fn line_of(text: *u8, off: i64) -> i64
    var l: i64 = 0
    var i: i64 = 0
    while i < off
        if *(text + i) == '\n'
            l += 1
        i += 1
    l

# Whether offset `off` on the line starting at `start` is code: not inside
# a string or char literal, and not after a `#` comment.
fn is_code(text: *u8, start: i64, off: i64) -> bool
    var i: i64 = start
    var quote: u8 = 0
    while i < off
        let c: u8 = *(text + i)
        if quote != 0
            if c == '\\'
                i += 1
            else if c == quote
                quote = 0
        else if c == '"' or c == '\''
            quote = c
        else if c == '#'
            return false
        i += 1
    quote == 0

# =============================================================================
# Words and declarations
# =============================================================================

# A name in the document: bytes [start, end).
struct Word
    start: i64
    end: i64

fn no_word() -> Word
    Word { start: -1, end: -1 }

# The identifier covering LSP position (line, character), or no_word() if the
# character there is not part of an identifier in code.
pub fn word_at(text: *u8, len: i64, line: i64, character: i64) -> Word
    word_at_offset(text, len, line, doc_offset(text, len, line, character))

# The identifier covering byte offset `off` on `line`, or no_word() if that
# byte is not part of an identifier in code (or `off` is -1).
pub fn word_at_offset(text: *u8, len: i64, line: i64, off: i64) -> Word
    if off < 0 or not is_ident_char(*(text + off))
        return no_word()
    var s: i64 = off
    while s > 0 and is_ident_char(*(text + s - 1))
        s -= 1
    var e: i64 = off
    while e < len and is_ident_char(*(text + e))
        e += 1
    if not is_code(text, line_start(text, len, line), s)
        return no_word()
    Word { start: s, end: e }

# If bytes [i, end) start with keyword `kw` followed by a blank, the offset
# after the keyword and its blanks; else -1.
fn skip_keyword(text: *u8, i: i64, end: i64, kw: *u8) -> i64
    let n: i64 = strlen(kw)
    if i + n >= end
        return -1
    if memcmp(text + i, kw, n) != 0 or not is_blank(*(text + i + n))
        return -1
    var j: i64 = i + n
    while j < end and is_blank(*(text + j))
        j += 1
    j

# The name declared by the line [start, end) if it declares a function.
# `*exported` says whether another file may call it: it is `pub` or `extern`
# (LANGUAGE_SPEC §15.2 leaves an extern fn's privacy unchecked).
fn decl_name(text: *u8, start: i64, end: i64, exported: *bool) -> Word
    *exported = false
    var i: i64 = start
    while i < end and is_blank(*(text + i))
        i += 1
    loop
        var j: i64 = skip_keyword(text, i, end, c"pub")
        if j < 0
            j = skip_keyword(text, i, end, c"extern")
        if j >= 0
            *exported = true
        else
            j = skip_keyword(text, i, end, c"async")
        if j < 0
            break
        i = j
    i = skip_keyword(text, i, end, c"fn")
    if i < 0 or not is_ident_start(*(text + i))
        return no_word()
    var e: i64 = i
    while e < end and is_ident_char(*(text + e))
        e += 1
    Word { start: i, end: e }

# The first function declaration in text[0, len) named name[0, n), or
# no_word().  With `exported_only`, only one another file may call.
fn find_decl_named(text: *u8, len: i64, name: *u8, n: i64, exported_only: bool) -> Word
    var start: i64 = 0
    while start < len
        let end: i64 = line_end(text, len, start)
        var exported: bool = false
        let d: Word = decl_name(text, start, end, @exported)
        if d.start >= 0 and d.end - d.start == n and (exported or not exported_only) and memcmp(text + d.start, name, n) == 0
            return d
        start = end + 1
    no_word()

# The first function declaration named text[w.start, w.end), or no_word().
pub fn find_fn_decl(text: *u8, len: i64, w: Word) -> Word
    find_decl_named(text, len, text + w.start, w.end - w.start, false)

# =============================================================================
# Imports (#3884)
# =============================================================================
#
# A function the document does not declare is looked up in the modules it
# imports.  Modules are found the way ritz1 finds them when diagnostics.ritz
# compiles the document: its -I roots (paths.ritz import_path) and then
# $RITZ_PATH.  What a module exports is its `pub` (or `extern`) fns plus what
# its `pub import`s export.  A module's plain imports are private to it
# (#3891), so they are not followed.  The search reads the files on disk, not
# any open editor buffers for them.

# An import declaration: the module path text[start, end) (`a.b.c`) and
# whether it is a `pub import`.
struct ImportLine
    start: i64
    end: i64
    is_pub: bool

# The import declared by the line [start, end), or one whose start is -1.  An
# import is top-level, so it starts the line.  Anything after the path (a
# selective `{ ... }` list or an `as` alias) is ignored, since neither filters
# what is imported (LANGUAGE_SPEC §15.1).
fn import_decl(text: *u8, start: i64, end: i64) -> ImportLine
    var i: i64 = start
    var is_pub: bool = false
    let j: i64 = skip_keyword(text, i, end, c"pub")
    if j >= 0
        is_pub = true
        i = j
    i = skip_keyword(text, i, end, c"import")
    if i < 0 or not is_ident_start(*(text + i))
        return ImportLine { start: -1, end: -1, is_pub: false }
    var e: i64 = i
    while e < end and (is_ident_char(*(text + e)) or *(text + e) == '.')
        e += 1
    ImportLine { start: i, end: e, is_pub: is_pub }

# A new String holding dir[0, dir_len) + "/" + the module path with each '.'
# turned into '/', + ".ritz".  If `sub` is non-empty it goes after the first
# segment (<pkg>/<sub>/<rest>.ritz), and a single-segment module gives "".
fn module_file(dir: *u8, dir_len: i64, text: *u8, imp: ImportLine, sub: *u8) -> String
    var out: String = string_from_bytes(Span<u8> { ptr: (dir), len: (dir_len) as i64 })
    if dir_len > 0 and *(dir + dir_len - 1) != '/'
        out.push('/')
    var first: bool = true
    var i: i64 = imp.start
    while i < imp.end
        let c: u8 = *(text + i)
        if c == '.'
            out.push('/')
            if first and *sub != 0
                out.push_cstr(sub)
                out.push('/')
            first = false
        else
            out.push(c)
        i += 1
    if first and *sub != 0
        return string_new()
    out.push_str(".ritz")
    out

# Whether module_file(dir, dir_len, text, imp, sub) exists.  If it does, it is
# appended to `found`.
fn try_file(found: @&String, dir: *u8, dir_len: i64, text: *u8, imp: ImportLine, sub: *u8) -> bool
    var c: String = module_file(dir, dir_len, text, imp, sub)
    var hit: bool = false
    if c.len() > 0 and exists(@&c, 0)
        found.push_string(@c)
        hit = true
    hit

# The file the import `imp` in `text` names, or "" if none is found.  The
# search follows ritz1's try_open_import.  For any import except ritzlib's,
# it first tries `from_dir` (the importing file's directory) and up to 7 of
# its ancestors.  It then tries each colon-separated root in `roots` as
# <root>/<a>/<b>.ritz, <root>/<a>/lib/<b>.ritz and <root>/<a>/src/<b>.ritz.
fn resolve_module(text: *u8, imp: ImportLine, from_dir: @&String, roots: @&String) -> String
    var found: String = string_new()
    let n: i64 = imp.end - imp.start
    let is_ritzlib: bool = (n == 7 or (n > 7 and *(text + imp.start + 7) == '.')) and memcmp(text + imp.start, c"ritzlib", 7) == 0
    if not is_ritzlib
        let d: *u8 = from_dir.as_ptr()
        var end: i64 = from_dir.len()
        var levels: i32 = 0
        while end > 0 and levels < 8
            if try_file(@&found, d, end, text, imp, c"")
                return found
            end = last_slash(d, end)
            levels += 1
    let r: *u8 = roots.as_ptr()
    let rn: i64 = roots.len()
    var s: i64 = 0
    while s < rn
        var e: i64 = s
        while e < rn and *(r + e) != ':'
            e += 1
        if e > s
            if try_file(@&found, r + s, e - s, text, imp, c"")
                return found
            if try_file(@&found, r + s, e - s, text, imp, c"lib")
                return found
            if try_file(@&found, r + s, e - s, text, imp, c"src")
                return found
        s = e + 1
    found

# Where a function was found.  `path` is "" if it is in the document itself.
# Otherwise it is the file it is in, and `text` holds that file.  `w` is the
# name in that text, or no_word() if nothing was found.
struct Found
    path: String
    text: String
    w: Word

fn found_new() -> Found
    Found { path: string_new(), text: string_new(), w: no_word() }

# The contents of the file `path`, or "" if it cannot be read.
fn read_text(path: @&String) -> String
    match read_file(path.as_view())
        Ok(s) => s
        Err(e) => string_new()

# Whether `seen` (a "\n" followed by paths, each ended by "\n") holds `path`.
fn seen_has(seen: @&String, path: @&String) -> bool
    let s: *u8 = seen.as_ptr()
    let sn: i64 = seen.len()
    let p: *u8 = path.as_ptr()
    let pn: i64 = path.len()
    var i: i64 = 0
    while i + pn + 2 <= sn
        if *(s + i) == '\n' and *(s + i + pn + 1) == '\n' and memcmp(s + i + 1, p, pn) == 0
            return true
        i += 1
    false

# Search the modules imported by text[0, len) for an exported fn named
# name[0, n), depth first and in import order, and put the result in `f`.
# `dir` is the directory of `text`'s file.  With `pub_only`, only
# `pub import`s are followed.  Every file visited is added to `seen`, so an
# import cycle ends.
fn search_imports(f: *Found, text: *u8, len: i64, dir: @&String, roots: @&String, name: *u8, n: i64, pub_only: bool, seen: @&String) -> bool
    var start: i64 = 0
    while start < len
        let end: i64 = line_end(text, len, start)
        let imp: ImportLine = import_decl(text, start, end)
        start = end + 1
        if imp.start >= 0 and (imp.is_pub or not pub_only)
            var path: String = resolve_module(text, imp, dir, roots)
            if path.len() > 0 and not seen_has(seen, @&path)
                seen.push_string(@path)
                seen.push('\n')
                var content: String = read_text(@&path)
                let ct: *u8 = content.as_ptr()
                let cl: i64 = content.len()
                let d: Word = find_decl_named(ct, cl, name, n, true)
                if d.start >= 0
                    f.path = path
                    f.text = content
                    f.w = d
                    return true
                let p: *u8 = path.as_ptr()
                var child: String = string_from_bytes(Span<u8> { ptr: (p), len: (last_slash(p, path.len())) as i64 })
                let hit: bool = search_imports(f, ct, cl, @&child, roots, name, n, true, seen)
                if hit
                    return true
    false

# The declaration of the function named text[w.start, w.end) that the
# document `uri` can call goes in `f`.  The document's own declaration comes
# first, then one its imports export.  If neither exists, f.w.start < 0.
fn lookup(f: *Found, uri: *u8, text: *u8, len: i64, w: Word)
    f.w = find_fn_decl(text, len, w)
    if f.w.start >= 0
        return
    var doc_path: String = uri_path(uri)
    var roots: String = lookup_roots(@&doc_path)
    # ritz1 compiles a scratch copy of the document.  Its directory holds no
    # modules, so the document's own imports come only from the roots (which
    # start at the document's directory).  An imported module's imports start
    # at that module's directory.
    var no_dir: String = string_new()
    var seen: String = string_from("\n")
    search_imports(f, text, len, @&no_dir, @&roots, text + w.start, w.end - w.start, false, @&seen)

# =============================================================================
# LSP answers
# =============================================================================

fn push_i64(buf: *Vec<u8>, n: i64)
    var tmp: [32]u8
    itoa(n, @tmp[0])
    buf.push_str(@tmp[0])

# `{"line":L,"character":C}`
pub fn push_position(buf: *Vec<u8>, line: i64, col: i64)
    buf.push_str(c"{\"line\":")
    push_i64(buf, line)
    buf.push_str(c",\"character\":")
    push_i64(buf, col)
    buf.push('}')

# `{"start":...,"end":...}`
pub fn push_range(buf: *Vec<u8>, l0: i64, c0: i64, l1: i64, c1: i64)
    buf.push_str(c"{\"start\":")
    push_position(buf, l0, c0)
    buf.push_str(c",\"end\":")
    push_position(buf, l1, c1)
    buf.push('}')

# The range of word `w` in `text`.  The word lies on one line.  This is the
# only place a byte offset in symbols.ritz becomes an LSP position, so the
# only place its columns turn from bytes into UTF-16 units (#3885).
fn push_word_range(buf: *Vec<u8>, text: *u8, w: Word)
    let line: i64 = line_of(text, w.start)
    let start: i64 = line_start(text, w.end, line)
    push_range(buf, line, utf16_col(text, start, w.start), line, utf16_col(text, start, w.end))

# `{"uri":...,"range":...}`: the Location of word `w` in `text`, the file `uri`.
fn push_location(buf: *Vec<u8>, uri: *u8, text: *u8, w: Word)
    buf.push_str(c"{\"uri\":")
    json_emit_string(strview_from_cstr(uri), buf)
    buf.push_str(c",\"range\":")
    push_word_range(buf, text, w)
    buf.push('}')

# The text `f` was found in: the document's `text` or the imported file's.
fn found_text(f: *Found, text: *u8) -> *u8
    if (f.path).len() == 0
        return text
    (f.text).as_ptr()

fn found_len(f: *Found, len: i64) -> i64
    if (f.path).len() == 0
        return len
    (f.text).len()

# Hover: the result JSON for (line, col) in the document `uri` into `out`.  It
# is "null" if the word there names no function that the document declares or
# imports.
pub fn hover_json(uri: *u8, text: *u8, len: i64, line: i64, col: i64, out: *Vec<u8>)
    out.clear()
    let w: Word = word_at(text, len, line, col)
    var f: Found = found_new()
    if w.start >= 0
        lookup(@f, uri, text, len, w)
    if f.w.start < 0
        out.push_str(c"null")
        return
    let dt: *u8 = found_text(@f, text)
    let dl: i64 = found_len(@f, len)
    let d: Word = f.w
    # The declaration's line, without its indentation or trailing blanks.
    var s: i64 = line_start(dt, dl, line_of(dt, d.start))
    var e: i64 = line_end(dt, dl, d.start)
    while s < e and is_blank(*(dt + s))
        s += 1
    while e > s and (is_blank(*(dt + e - 1)) or *(dt + e - 1) == '\r')
        e -= 1
    var md: Vec<u8> = vec_with_cap<u8>(64 + e - s)
    md.push_str(c"```ritz\n")
    md.push_span(Span<u8> { ptr: (dt + s), len: (e - s) as i64 })
    md.push_str(c"\n```")
    md.push(0)
    out.push_str(c"{\"contents\":{\"kind\":\"markdown\",\"value\":")
    json_emit_string(strview_from_cstr(md.data), out)
    out.push_str(c"},\"range\":")
    push_word_range(out, text, w)
    out.push('}')

# Definition: the Location JSON for (line, col) in the document `uri` into
# `out`.  It is "null" if the word there names no function that the document
# declares or imports.
pub fn definition_json(uri: *u8, text: *u8, len: i64, line: i64, col: i64, out: *Vec<u8>)
    out.clear()
    let w: Word = word_at(text, len, line, col)
    var f: Found = found_new()
    if w.start >= 0
        lookup(@f, uri, text, len, w)
    if f.w.start < 0
        out.push_str(c"null")
    else if (f.path).len() == 0
        push_location(out, uri, text, f.w)
    else
        var furi: String = uri_from_path(@&f.path)
        push_location(out, furi.as_ptr(), (f.text).as_ptr(), f.w)
