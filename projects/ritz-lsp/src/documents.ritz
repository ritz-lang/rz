# documents.ritz - Document Store for LSP
#
# Tracks open documents and their contents.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.strview

# =============================================================================
# Document Structure
# =============================================================================

const MAX_DOCUMENTS: i32 = 256

struct Document
    uri: *u8            # Document URI (owned)
    uri_len: i64        # URI length
    content: *u8        # Document content (owned)
    content_len: i64    # Content length
    version: i64        # Document version
    dirty: i32          # 1: changed since its diagnostics were last published

struct DocumentStore
    docs: [256]Document
    count: i32

pub fn document_store_new() -> DocumentStore
    var store: DocumentStore
    store.count = 0
    for i in 0..MAX_DOCUMENTS
        store.docs[i].uri = null
        store.docs[i].uri_len = 0
        store.docs[i].content = null
        store.docs[i].content_len = 0
        store.docs[i].version = 0
        store.docs[i].dirty = 0
    return store

pub fn document_store_drop(store: *DocumentStore)
    for i in 0..store.count
        if store.docs[i].uri != null
            free(store.docs[i].uri)
        if store.docs[i].content != null
            free(store.docs[i].content)

# =============================================================================
# Document Operations
# =============================================================================

# The URI of `doc` (borrowed from the store).
pub fn document_uri(doc: *Document) -> StrView
    strview_from_ptr(doc.uri, doc.uri_len)

# Find document by URI, returns index or -1
pub fn document_find(store: *DocumentStore, uri: StrView) -> i32
    for i in 0..store.count
        if store.docs[i].uri != null
            if document_uri(@store.docs[i]).eq(uri)
                return i
    return -1

# Open a document (add to store)
pub fn document_open(store: *DocumentStore, uri: StrView, content: StrView, version: i64) -> i32
    # Check if already open
    let existing: i32 = document_find(store, uri)
    if existing >= 0
        # Update existing
        if store.docs[existing].content != null
            free(store.docs[existing].content)
        let content_len: i64 = content.len()
        store.docs[existing].content = malloc(content_len + 1)
        if store.docs[existing].content != null
            memcpy(store.docs[existing].content, content.as_ptr(), content_len)
            *(store.docs[existing].content + content_len) = 0
            store.docs[existing].content_len = content_len
        store.docs[existing].version = version
        store.docs[existing].dirty = 1
        return existing

    # Add new document
    if store.count >= MAX_DOCUMENTS
        return -1

    let idx: i32 = store.count
    store.count += 1

    # Copy URI
    let uri_len: i64 = uri.len()
    store.docs[idx].uri = malloc(uri_len + 1)
    if store.docs[idx].uri != null
        memcpy(store.docs[idx].uri, uri.as_ptr(), uri_len)
        *(store.docs[idx].uri + uri_len) = 0
        store.docs[idx].uri_len = uri_len

    # Copy content
    let content_len: i64 = content.len()
    store.docs[idx].content = malloc(content_len + 1)
    if store.docs[idx].content != null
        memcpy(store.docs[idx].content, content.as_ptr(), content_len)
        *(store.docs[idx].content + content_len) = 0
        store.docs[idx].content_len = content_len

    store.docs[idx].version = version
    store.docs[idx].dirty = 1

    return idx

# Update document content
pub fn document_change(store: *DocumentStore, uri: StrView, content: StrView, version: i64) -> i32
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return -1

    # Free old content
    if store.docs[idx].content != null
        free(store.docs[idx].content)

    # Copy new content
    let content_len: i64 = content.len()
    store.docs[idx].content = malloc(content_len + 1)
    if store.docs[idx].content != null
        memcpy(store.docs[idx].content, content.as_ptr(), content_len)
        *(store.docs[idx].content + content_len) = 0
        store.docs[idx].content_len = content_len

    store.docs[idx].version = version
    store.docs[idx].dirty = 1

    return idx

# Close a document (remove from store)
pub fn document_close(store: *DocumentStore, uri: StrView) -> i32
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return -1

    # Free resources
    if store.docs[idx].uri != null
        free(store.docs[idx].uri)
    if store.docs[idx].content != null
        free(store.docs[idx].content)

    # Shift remaining documents
    var i: i32 = idx
    let end: i32 = store.count - 1
    while i < end
        store.docs[i] = store.docs[i + 1]
        i += 1

    store.count -= 1

    # Clear last slot
    store.docs[store.count].uri = null
    store.docs[store.count].uri_len = 0
    store.docs[store.count].content = null
    store.docs[store.count].content_len = 0
    store.docs[store.count].version = 0
    store.docs[store.count].dirty = 0

    return 0

# Get document content
pub fn document_get(store: *DocumentStore, uri: StrView) -> *Document
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return null
    return @store.docs[idx]

# Diagnostics are published once input pauses, not per change (#3902): an
# open or change marks the document dirty, and the server publishes each
# dirty document for its latest version. The next dirty document, clearing
# its mark, or null when none is.
pub fn document_take_dirty(store: *DocumentStore) -> *Document
    for i in 0..store.count
        if store.docs[i].dirty != 0
            store.docs[i].dirty = 0
            return @store.docs[i]
    return null
