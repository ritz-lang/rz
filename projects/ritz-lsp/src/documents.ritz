# documents.ritz - Document Store for LSP
#
# Tracks open documents and their contents.

import ritzlib.gvec
import ritzlib.string
import ritzlib.strview

# =============================================================================
# Document Structure
# =============================================================================

const MAX_DOCUMENTS: i32 = 256

struct Document
    uri: String         # Document URI
    content: String     # Document content
    version: i64        # Document version
    dirty: bool         # changed since its diagnostics were last published

# The open documents, in the order they were opened.
struct DocumentStore
    docs: Vec<Document>

# A Vec frees its buffer, not its elements: each Document's Strings go here,
# dropped as it is popped.
impl Drop for DocumentStore
    fn drop(self: @&DocumentStore)
        while self.docs.len > 0
            self.docs.pop()

pub fn document_store_new() -> DocumentStore
    DocumentStore { docs: vec_new<Document>() }

# =============================================================================
# Document Operations
# =============================================================================

# Find document by URI, returns index or -1
pub fn document_find(store: *DocumentStore, uri: StrView) -> i32
    for i in 0..store.docs.len
        let d: *Document = store.docs.get_ptr(i)
        if d.uri.as_view().eq(uri)
            return i as i32
    return -1

# Replace document `idx`'s text and version, and mark it dirty.
fn document_set(store: *DocumentStore, idx: i32, content: StrView, version: i64)
    let d: *Document = store.docs.get_ptr(idx as i64)
    d.content.clear()
    d.content.push_str(content)
    d.version = version
    d.dirty = true

# Open a document (add to store)
pub fn document_open(store: *DocumentStore, uri: StrView, content: StrView, version: i64) -> i32
    let existing: i32 = document_find(store, uri)
    if existing >= 0
        document_set(store, existing, content, version)
        return existing

    if store.docs.len >= MAX_DOCUMENTS as i64
        return -1
    store.docs.push(Document {
        uri: string_from(uri),
        content: string_from(content),
        version: version,
        dirty: true
    })
    (store.docs.len - 1) as i32

# Update document content
pub fn document_change(store: *DocumentStore, uri: StrView, content: StrView, version: i64) -> i32
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return -1
    document_set(store, idx, content, version)
    return idx

# Close a document (remove from store)
pub fn document_close(store: *DocumentStore, uri: StrView) -> i32
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return -1

    # Set aside the documents after it, drop it, and put them back: the
    # others keep their order.
    var after: Vec<Document> = vec_new<Document>()
    while store.docs.len > (idx as i64) + 1
        after.push(store.docs.pop())
    store.docs.pop()
    while after.len > 0
        store.docs.push(after.pop())
    return 0

# Get document content
pub fn document_get(store: *DocumentStore, uri: StrView) -> *Document
    let idx: i32 = document_find(store, uri)
    if idx < 0
        return null
    store.docs.get_ptr(idx as i64)

# Diagnostics are published once input pauses, not per change (#3902): an
# open or change marks the document dirty, and the server publishes each
# dirty document for its latest version. The next dirty document, clearing
# its mark, or null when none is.
pub fn document_take_dirty(store: *DocumentStore) -> *Document
    for i in 0..store.docs.len
        let d: *Document = store.docs.get_ptr(i)
        if d.dirty
            d.dirty = false
            return d
    return null
