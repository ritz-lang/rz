# Tests for the line editor's per-key handlers (AGAST #3940)
#
# editor_handle_key is what main's read loop calls for each decoded key; it
# edits the line buffer in common.ritz and tells the loop what to do next.
# Terminal escape output from the handlers goes to stdout and is ignored here.



import ritzlib.io { println }
import ritzlib.string
import ritzlib.strview { StrView }

import src.state { ShellState, shell_state_new }
import src.common {
    line_view, line_clear, line_length, line_cursor_pos
}
import src.history { history_clear, history_count, history_reset_nav }
import ritzlib.termsession { Key }
import src.editor {
    editor_handle_key, cli_mode,
    EDIT_CONTINUE, EDIT_LINE_DONE, EDIT_EXIT,
    CLI_INTERACTIVE, CLI_HELP, CLI_COMMAND
}

fn key_char(c: u8) -> Key
    return Key.Char(c as u32)

# Type each byte of `s` as a Char key.
fn type_str(s: StrView)
    var i: i64 = 0
    while i < s.len
        editor_handle_key(key_char(s.get(i)))
        i = i + 1

# 0 when the line buffer is exactly `want` with the cursor at `cur`.
fn line_is(want: StrView, cur: i64) -> i32
    if not line_view().eq(want) or line_length() != want.len
        return 1
    if line_cursor_pos() != cur
        return 1
    return 0

fn fresh()
    line_clear()
    history_reset_nav()

[[test]]
fn test_chars_insert_at_cursor() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    fresh()
    type_str("ac")
    if line_is("ac", 2) != 0
        return 1
    if editor_handle_key(Key.Left) != EDIT_CONTINUE
        return 2
    type_str("b")
    if line_is("abc", 2) != 0
        return 3
    return 0

[[test]]
fn test_cursor_keys() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    fresh()
    type_str("abcd")
    editor_handle_key(Key.Home)
    if line_is("abcd", 0) != 0
        return 1
    editor_handle_key(Key.Right)
    if line_is("abcd", 1) != 0
        return 2
    editor_handle_key(Key.End)
    if line_is("abcd", 4) != 0
        return 3
    editor_handle_key(Key.Ctrl('a'))
    if line_is("abcd", 0) != 0
        return 4
    editor_handle_key(Key.Ctrl('e'))
    if line_is("abcd", 4) != 0
        return 5
    # Right at the end and left at the start are no-ops.
    editor_handle_key(Key.Right)
    if line_is("abcd", 4) != 0
        return 6
    editor_handle_key(Key.Home)
    editor_handle_key(Key.Left)
    if line_is("abcd", 0) != 0
        return 7
    return 0

[[test]]
fn test_backspace_and_delete() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    fresh()
    type_str("abcd")
    editor_handle_key(Key.Backspace)
    if line_is("abc", 3) != 0
        return 1
    editor_handle_key(Key.Home)
    editor_handle_key(Key.Backspace)
    if line_is("abc", 0) != 0
        return 2
    editor_handle_key(Key.Delete)
    if line_is("bc", 0) != 0
        return 3
    editor_handle_key(Key.End)
    editor_handle_key(Key.Delete)
    if line_is("bc", 2) != 0
        return 4
    return 0

[[test]]
fn test_kill_keys() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    fresh()
    type_str("abcd")
    editor_handle_key(Key.Left)
    editor_handle_key(Key.Left)
    editor_handle_key(Key.Ctrl('k'))
    if line_is("ab", 2) != 0
        return 1
    editor_handle_key(Key.Left)
    editor_handle_key(Key.Ctrl('u'))
    if line_is("b", 0) != 0
        return 2
    return 0

[[test]]
fn test_history_keys() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    history_clear()
    fresh()
    type_str("#one")
    if editor_handle_key(Key.Enter) != EDIT_LINE_DONE
        return 1
    if history_count() != 1
        return 2
    fresh()
    type_str("xy")
    editor_handle_key(Key.Up)
    if line_is("#one", 4) != 0
        return 3
    editor_handle_key(Key.Down)
    if line_is("", 0) != 0
        return 4
    return 0

# A 2000-byte line, Enter, then Up recalls all 2000 bytes (AGAST #4083).
[[test]]
fn test_history_recalls_long_line() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    history_clear()
    fresh()
    var long_line: String = string_new()
    var i: i64 = 0
    while i < 2000
        long_line.push(97 + ((i % 26) as u8))
        i = i + 1
    type_str(long_line.as_view())
    if editor_handle_key(Key.Enter) != EDIT_LINE_DONE
        return 1
    fresh()
    editor_handle_key(Key.Up)
    if line_is(long_line.as_view(), 2000) != 0
        return 2
    return 0

[[test]]
fn test_line_ending_keys() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    history_clear()
    fresh()
    # Enter on an empty line ends it without adding history.
    if editor_handle_key(Key.Enter) != EDIT_LINE_DONE
        return 1
    if history_count() != 0
        return 2
    type_str("abc")
    if editor_handle_key(Key.Ctrl('c')) != EDIT_LINE_DONE
        return 3
    if line_is("", 0) != 0
        return 4
    # Ctrl-D exits only on an empty line.
    type_str("a")
    if editor_handle_key(Key.Ctrl('d')) != EDIT_CONTINUE
        return 5
    line_clear()
    if editor_handle_key(Key.Ctrl('d')) != EDIT_EXIT
        return 6
    # Unhandled keys leave the line alone.
    type_str("q")
    if editor_handle_key(Key.Tab) != EDIT_CONTINUE
        return 7
    if line_is("q", 1) != 0
        return 8
    return 0

# The line buffer grows (AGAST #3529): it was a fixed [512]u8 that silently
# dropped every key past byte 511.
[[test]]
fn test_line_longer_than_512() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    fresh()
    var i: i32 = 0
    while i < 2000
        editor_handle_key(key_char('a' + ((i % 26) as u8)))
        i = i + 1
    if line_length() != 2000 or line_cursor_pos() != 2000
        return 1
    # Insert at the front: every byte shifts right by one.
    editor_handle_key(Key.Home)
    type_str("Z")
    if line_length() != 2001 or line_cursor_pos() != 1
        return 2
    let line: StrView = line_view()
    if line.len != 2001 or line.get(0) != 'Z' or line.get(1) != 'a' or line.get(2000) != 'x'
        return 3
    # Backspace undoes it.
    editor_handle_key(Key.Backspace)
    if line_length() != 2000 or line_view().get(0) != 'a'
        return 4
    return 0

[[test]]
fn test_cli_mode() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    if cli_mode("--help") != CLI_HELP
        return 1
    if cli_mode("-c") != CLI_COMMAND
        return 2
    if cli_mode("-cx") != CLI_INTERACTIVE
        return 3
    if cli_mode("--hel") != CLI_INTERACTIVE
        return 4
    if cli_mode("") != CLI_INTERACTIVE
        return 5
    println("editor key dispatch OK")
    return 0
