# test/test_common.ritz - common.ritz integer output
#
# AGAST #1932: the old printer was print_num, which recursed on `n / 10`
# and printed `n % 10 + '0'`, so a negative (e.g. os_enable_raw_mode's
# -errno) came out as garbage bytes. cmd_pid and the raw-mode warning now
# go through print_pid / print_raw_warning, whose bodies are print("{n}").

import ritzlib.sys {
    sys_pipe, sys_fork, sys_dup2, sys_close, sys_exit, sys_wait4
}
import ritzlib.fd { fd_borrow }
import ritzlib.span { Span }

import src.common { print_pid, print_raw_warning }

var g_out: [128]u8
var g_out_len: i64 = 0

fn read_all(fd: i32, buf: [u8]) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < buf.len
        n = match fd_borrow(fd).read(buf[got..buf.len])
            Ok(k) => k
            Err(_) => 0
        if n > 0
            got = got + n
    got

# 0 when g_out is exactly `want`.
fn out_differs(want: StrView) -> i32
    if g_out_len != want.len
        return 1
    var i: i64 = 0
    while i < g_out_len
        if g_out[i] != *(want.ptr + i)
            return 2
        i += 1
    0

fn case_body(which: i32) -> i32
    if which == 1
        let n: i64 = -25
        print_pid(n)
    else if which == 2
        let n: i64 = -9223372036854775807 - 1
        print_pid(n)
    else if which == 3
        let zero: i64 = 0
        let maxn: i64 = 9223372036854775807
        print_pid(zero)
        print_pid(maxn)
    else if which == 4
        print_raw_warning(-25)
    0

# Run one case in a child with stdout piped back into g_out.
fn run_case(which: i32) -> i32
    var o: [2]i32
    sys_pipe(@o[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_close(o[0])
        sys_close(o[1])
        sys_exit(case_body(which))
    sys_close(o[1])
    g_out_len = read_all(o[0], @g_out)
    sys_close(o[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

[[test]]
fn test_print_negative() -> i32
    assert run_case(1) == 0
    assert out_differs("PID: -25\n") == 0
    0

[[test]]
fn test_print_i64_min() -> i32
    assert run_case(2) == 0
    assert out_differs("PID: -9223372036854775808\n") == 0
    0

[[test]]
fn test_print_zero_and_max() -> i32
    assert run_case(3) == 0
    assert out_differs("PID: 0\nPID: 9223372036854775807\n") == 0
    0

[[test]]
fn test_raw_warning_negative() -> i32
    assert run_case(4) == 0
    assert out_differs("Warning: Could not enable raw mode (-25)\n") == 0
    0
