# test/test_shell.ritz - run_line end to end (AGAST #2461)
#
# Each case runs one line through shell.run_line in a forked child (so `cd`
# and variables don't leak between tests) with its stdout piped back.
# Before #2461: cd was an external command with no effect, $X/$? stayed
# literal, and `>`/`|` were passed to the command as arguments.

import ritzlib.sys {
    sys_pipe, sys_fork, sys_dup2, sys_close, sys_exit, sys_wait4,
    sys_mkdir, sys_rmdir
}
import src.rawio { shell_pid }
import ritzlib.fd { fd_borrow }
import ritzlib.fs { unlink }
import ritzlib.span { span_from_ptr }
import ritzlib.string
import ritzlib.strview { StrView }

import src.shell { run_line }

var g_out: [512]u8
var g_out_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = match fd_borrow(fd).read(span_from_ptr<u8>(buf + got, cap - got))
            Ok(k) => k
            Err(_) => 0
        if n > 0
            got = got + n
    got

# 0 when the captured stdout is exactly `want`.
fn out_differs(want: StrView) -> i32
    if g_out_len != want.len
        return 1
    var i: i64 = 0
    while i < g_out_len
        if g_out[i as i32] != want.get(i)
            return 2
        i += 1
    0

# Runs `line` in a child; returns run_line's status, stdout in g_out.
fn run(line: StrView) -> i32
    var o: [2]i32
    sys_pipe(@o[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_close(o[0])
        sys_close(o[1])
        sys_exit(run_line(line))
    sys_close(o[1])
    g_out_len = read_all(o[0], @g_out[0], 512)
    sys_close(o[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

# A scratch dir in the cwd, named per process: ".rzsh_test_<pid>".
fn scratch_dir() -> String
    var dir: String = string_from(".rzsh_test_")
    dir.push_i64(shell_pid() as i64)
    sys_mkdir(dir.as_ptr(), 448)
    dir

fn in_dir(dir: @String, name: StrView) -> String
    var path: String = dir.clone()
    path.push_str("/")
    path.push_str(name)
    path

# ----------------------------------------------------------------------------

[[test]]
fn test_cd_changes_directory() -> i32
    assert run("cd / ; pwd") == 0
    assert out_differs("/\n") == 0
    assert run("cd /nonexistent_2461 ; pwd") == 0
    assert out_differs("") != 0   # pwd still ran, in the old directory
    assert run("cd /nonexistent_2461") == 1
    0

[[test]]
fn test_variables_expand() -> i32
    assert run("export X=5 ; echo X=$X") == 0
    assert out_differs("X=5\n") == 0
    assert run("Y=a ; Y=${Y}b ; echo \"$Y\" '$Y'") == 0
    assert out_differs("ab $Y\n") == 0
    0

[[test]]
fn test_exported_reaches_child() -> i32
    # Only exported variables go into an external command's environment.
    assert run("export X=5 ; L=1 ; env | grep -c -e ^X=5 -e ^L=") == 0
    assert out_differs("1\n") == 0
    0

[[test]]
fn test_status_expands() -> i32
    assert run("false ; echo status=$?") == 0
    assert out_differs("status=1\n") == 0
    assert run("true ; echo status=$?") == 0
    assert out_differs("status=0\n") == 0
    assert run("no_such_command_2461 ; echo $?") == 0
    assert out_differs("127\n") == 0
    assert run("false") == 1
    0

[[test]]
fn test_redirect_out_append_in() -> i32
    var dir: String = scratch_dir()
    # Paths name the scratch dir directly, so a broken `cd` or `;` can't
    # make the test write into its cwd.
    var f: String = in_dir(@dir, "f.txt")
    var line: String = string_from("echo one > ")
    line.push_string(@f)
    line.push_str(" ; echo two >> ")
    line.push_string(@f)
    line.push_str(" ; echo shown ; cat < ")
    line.push_string(@f)
    let st: i32 = run(line.as_view())
    let _ = unlink(f.as_view())
    sys_rmdir(dir.as_ptr())
    assert st == 0
    # The builtin's redirect is undone: "shown" reached the real stdout.
    assert out_differs("shown\none\ntwo\n") == 0
    0

[[test]]
fn test_redirect_truncates_external() -> i32
    var dir: String = scratch_dir()
    var g: String = in_dir(@dir, "g.txt")
    var line: String = string_from("echo long-line > ")
    line.push_string(@g)
    line.push_str(" ; printf x > ")
    line.push_string(@g)
    line.push_str(" ; cat ")
    line.push_string(@g)
    let st: i32 = run(line.as_view())
    let _ = unlink(g.as_view())
    sys_rmdir(dir.as_ptr())
    assert st == 0
    assert out_differs("x") == 0
    0

[[test]]
fn test_pipe() -> i32
    assert run("echo piped | tr p P") == 0
    assert out_differs("PiPed\n") == 0
    assert run("echo abc | tr a A | tr c C") == 0
    assert out_differs("AbC\n") == 0
    # A pipeline's status is its last command's.
    assert run("echo x | false") == 1
    assert run("false | cat ; echo $?") == 0
    assert out_differs("0\n") == 0
    0

# ----------------------------------------------------------------------------
# No fixed tables (AGAST #3459): parse.ritz kept 64 tokens, 32 variables and
# an 8 KB child envp in global arrays. Each line below is sized to cross one.
# ----------------------------------------------------------------------------

[[test]]
fn test_hundred_tokens_run() -> i32
    # `echo ok` plus 49 `< /dev/null` is 100 tokens; 64 was the cap.
    var long: String = string_from("echo ok")
    var i: i32 = 0
    while i < 49
        long.push_str(" < /dev/null")
        i += 1
    assert run(long.as_view()) == 0
    assert out_differs("ok\n") == 0
    0

[[test]]
fn test_sixty_four_variables() -> i32
    # V0=0 ; ... ; V63=63 ; echo $V0 $V31 $V32 $V63 — the 33rd failed.
    var long: String = string_new()
    var i: i64 = 0
    while i < 64
        long.push_str("V")
        long.push_i64(i)
        long.push_str("=")
        long.push_i64(i)
        long.push_str(" ; ")
        i += 1
    long.push_str("echo $V0 $V31 $V32 $V63")
    assert run(long.as_view()) == 0
    assert out_differs("0 31 32 63\n") == 0
    0

[[test]]
fn test_exported_past_8k_reach_child() -> i32
    # 32 exported "EXPORTED_NN=<250 x>" entries are 263 bytes each, 8416 in
    # all: past the old 8 KB envp buffer, which silently dropped the last two.
    var long: String = string_new()
    var i: i64 = 10
    while i < 42
        long.push_str("export EXPORTED_")
        long.push_i64(i)
        long.push_str("=")
        var k: i32 = 0
        while k < 250
            long.push_str("x")
            k += 1
        long.push_str(" ; ")
        i += 1
    long.push_str("env | grep -c ^EXPORTED_")
    assert run(long.as_view()) == 0
    assert out_differs("32\n") == 0
    0

# ----------------------------------------------------------------------------
# No fixed execution tables (AGAST #3529): argv was a global [32]*u8 and a
# pipeline kept [17] stage bounds / [16] pids, so `echo` past 31 words failed
# with "too many arguments" and a 17th stage with "pipeline too long".
# ----------------------------------------------------------------------------

[[test]]
fn test_echo_hundred_args() -> i32
    # echo 0 1 ... 99 prints all hundred, space-separated.
    var long: String = string_from("echo")
    var want: String = string_new()
    var i: i64 = 0
    while i < 100
        long.push_str(" ")
        long.push_i64(i)
        if i > 0
            want.push_str(" ")
        want.push_i64(i)
        i += 1
    want.push_str("\n")
    assert run(long.as_view()) == 0
    assert out_differs(want.as_view()) == 0
    0

[[test]]
fn test_twenty_stage_pipeline() -> i32
    # echo deep | cat | ... — 20 stages; 16 was the cap.
    var long: String = string_from("echo deep")
    var i: i32 = 1
    while i < 20
        long.push_str(" | cat")
        i += 1
    assert run(long.as_view()) == 0
    assert out_differs("deep\n") == 0
    0

[[test]]
fn test_syntax_errors() -> i32
    assert run("echo 'open") == 2
    assert run("echo a | | cat") == 2
    assert run("echo a >") == 2
    assert run("| cat") == 2
    assert out_differs("") == 0
    0
