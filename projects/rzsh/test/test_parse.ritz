# test/test_parse.ritz - tokenizer, $-expansion and variables (AGAST #2461)
#
# Before #2461 a line was split on whitespace only, so `$X`, `$?`, `>` and
# `|` reached the command as literal arguments.

import ritzlib.str { strlen, strcmp, strcat }
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.memory

import src.parse {
    TokKind, Tokens, tokenize, tokens_len, tokens_kind, tokens_word,
    tokens_drop, g_last_status, g_environ, PARSE_UNTERMINATED,
    vars_clear, var_set, var_lookup, var_unset, var_export, assignment_pos,
    Envp, vars_build_envp, envp_len, envp_ptr, envp_drop
}

# The last lex() result; lex() frees the one before. Tokens has Drop, so it
# cannot live at module level (§13.6); the global is a pointer to a heap one.
var g_tk: *Tokens = null

# Tokenizes `line` from `pos`: the token count, or PARSE_UNTERMINATED.
fn lex(line: *u8, pos: i64) -> i64
    var tk: Tokens = tokenize(line, pos)
    if g_tk == null
        g_tk = malloc(sizeof(Tokens)) as *Tokens
    else
        tokens_drop(@&*g_tk)
    *g_tk = tk
    if g_tk.err != 0
        return g_tk.err as i64
    tokens_len(@*g_tk)

fn next() -> i64
    g_tk.next

fn kind_is(idx: i64, want: TokKind) -> bool
    tokens_kind(@*g_tk, idx) == want

fn word_is(idx: i64, want: *u8) -> bool
    return kind_is(idx, TokKind.Word) and strcmp(tokens_word(@*g_tk, idx), want) == 0

# ----------------------------------------------------------------------------
# Words and operators
# ----------------------------------------------------------------------------

[[test]]
fn test_tokenize_words() -> i32
    vars_clear()
    assert lex(c"  echo   hello\tworld ", 0) == 3
    assert word_is(0, c"echo")
    assert word_is(1, c"hello")
    assert word_is(2, c"world")
    0

[[test]]
fn test_tokenize_operators() -> i32
    vars_clear()
    # Operators split words even without surrounding blanks.
    assert lex(c"a|b>d>>e<f", 0) == 9
    assert word_is(0, c"a")
    assert kind_is(1, TokKind.Pipe)
    assert word_is(2, c"b")
    assert kind_is(3, TokKind.Out)
    assert word_is(4, c"d")
    assert kind_is(5, TokKind.Append)
    assert word_is(6, c"e")
    assert kind_is(7, TokKind.In)
    assert word_is(8, c"f")
    assert next() == -1
    0

[[test]]
fn test_tokenize_semicolon_items() -> i32
    vars_clear()
    # Each ';' item is tokenized on its own, so expansion in a later item
    # sees what an earlier item set.
    let line: *u8 = c"X=1;echo $X ; ';' ;"
    assert lex(line, 0) == 1
    assert word_is(0, c"X=1")
    assert next() == 4
    var_set(c"X", 1, c"1", 1, 0)
    assert lex(line, next()) == 2
    assert word_is(1, c"1")
    assert lex(line, next()) == 1
    assert word_is(0, c";")
    assert lex(line, next()) == 0
    assert next() == -1
    0

[[test]]
fn test_tokenize_quotes() -> i32
    vars_clear()
    var_set(c"X", 1, c"5", 1, 0)
    # '' is literal, "" expands, \ escapes; quoted operators are words.
    assert lex(c"'$X | y' \"x=$X >\" a\\ b \"\"", 0) == 4
    assert word_is(0, c"$X | y")
    assert word_is(1, c"x=5 >")
    assert word_is(2, c"a b")
    assert word_is(3, c"")
    assert lex(c"echo 'oops", 0) == PARSE_UNTERMINATED
    assert lex(c"echo \"oops", 0) == PARSE_UNTERMINATED
    0

[[test]]
fn test_tokenize_comment() -> i32
    vars_clear()
    assert lex(c"echo a # b c", 0) == 2
    assert lex(c"echo a#b", 0) == 2
    assert word_is(1, c"a#b")
    0

# ----------------------------------------------------------------------------
# Expansion
# ----------------------------------------------------------------------------

[[test]]
fn test_expand_var() -> i32
    vars_clear()
    assert var_set(c"X", 1, c"5", 1, 0) == 0
    assert lex(c"echo X=$X ${X}y $Xy", 0) == 3
    assert word_is(1, c"X=5")
    assert word_is(2, c"5y")
    # $Xy names the unset variable Xy: the unquoted empty word is dropped.
    0

[[test]]
fn test_expand_unset_and_literal_dollar() -> i32
    vars_clear()
    assert lex(c"echo $NOPE \"$NOPE\" $ a$ ${", 0) == 5
    assert word_is(1, c"")
    assert word_is(2, c"$")
    assert word_is(3, c"a$")
    assert word_is(4, c"${")
    0

[[test]]
fn test_expand_status() -> i32
    vars_clear()
    g_last_status = 1
    assert lex(c"echo status=$?", 0) == 2
    assert word_is(1, c"status=1")
    g_last_status = 127
    assert lex(c"echo \"$?\"", 0) == 2
    assert word_is(1, c"127")
    g_last_status = 0
    0

# ----------------------------------------------------------------------------
# Variables and environment
# ----------------------------------------------------------------------------

[[test]]
fn test_var_table() -> i32
    vars_clear()
    assert var_set(c"1X", 2, c"v", 1, 0) == -1
    assert var_set(c"FOO", 3, c"one", 3, 0) == 0
    assert var_set(c"FOO", 3, c"two", 3, 0) == 0
    assert strcmp(var_lookup(c"FOO", 3), c"two") == 0
    assert var_lookup(c"FO", 2) == null
    var_unset(c"FOO", 3)
    assert var_lookup(c"FOO", 3) == null
    assert assignment_pos(c"X=5") == 1
    assert assignment_pos(c"LONG_NAME=") == 9
    assert assignment_pos(c"=5") == -1
    assert assignment_pos(c"1X=5") == -1
    assert assignment_pos(c"echo") == -1
    0

fn envp_has(out: **u8, want: *u8) -> bool
    var k: i64 = 0
    while *(out + k) != null
        if strcmp(*(out + k), want) == 0
            return true
        k += 1
    false

[[test]]
fn test_envp_inherit_and_export() -> i32
    vars_clear()
    var env: [4]*u8
    env[0] = c"HOME=/home/u"
    env[1] = c"PATH=/bin"
    env[2] = null
    g_environ = @env[0]

    # Lookups fall back to the inherited environment.
    assert strcmp(var_lookup(c"HOME", 4), c"/home/u") == 0

    # Unexported shell variables stay out of the child; exported ones and
    # overrides of inherited ones go in.
    var_set(c"LOCAL", 5, c"x", 1, 0)
    var_set(c"X", 1, c"5", 1, 1)
    var_set(c"PATH", 4, c"/usr/bin", 8, 0)
    var_unset(c"HOME", 4)
    assert var_lookup(c"HOME", 4) == null

    var e: Envp = vars_build_envp()
    assert envp_len(@e) == 2
    let out: **u8 = envp_ptr(@e)
    assert *(out + 2) == null
    assert envp_has(out, c"X=5")
    assert envp_has(out, c"PATH=/usr/bin")
    envp_drop(@&e)

    # export of an unset name fails; of a local one marks it exported.
    assert var_export(c"NOPE", 4) == -1
    assert var_export(c"LOCAL", 5) == 0
    e = vars_build_envp()
    assert envp_len(@e) == 3
    envp_drop(@&e)

    g_environ = null
    vars_clear()
    0

# ----------------------------------------------------------------------------
# No fixed tables (AGAST #3459): 64 tokens, 32 variables and an 8 KB envp
# were hard limits.
# ----------------------------------------------------------------------------

var g_line: [16384]u8

fn num_cstr(buf: *u8, n: i64) -> *u8
    let k: i64 = fmt_i64_into(buf, n)
    *(buf + k) = 0
    buf

[[test]]
fn test_tokenize_hundred_tokens() -> i32
    vars_clear()
    # 50 words alternating with 50 pipes: 100 tokens.
    g_line[0] = 0
    var i: i32 = 0
    while i < 50
        strcat(@g_line[0], c"w |")
        i += 1
    assert lex(@g_line[0], 0) == 100
    assert word_is(0, c"w")
    assert kind_is(99, TokKind.Pipe)
    assert word_is(98, c"w")
    # A long word: the old 2048-byte word buffer overflowed.
    g_line[0] = 0
    i = 0
    while i < 300
        strcat(@g_line[0], c"abcdefgh")
        i += 1
    assert lex(@g_line[0], 0) == 1
    assert strlen(tokens_word(@*g_tk, 0)) == 2400
    0

[[test]]
fn test_sixty_four_variables() -> i32
    vars_clear()
    var name: [32]u8
    var value: [32]u8
    var i: i64 = 0
    while i < 64
        name[0] = 'V'
        let nl: i64 = strlen(num_cstr(@name[1], i)) + 1
        assert var_set(@name[0], nl, num_cstr(@value[0], i * 7), strlen(@value[0]), 0) == 0
        i += 1
    i = 0
    while i < 64
        name[0] = 'V'
        let nl: i64 = strlen(num_cstr(@name[1], i)) + 1
        assert strcmp(var_lookup(@name[0], nl), num_cstr(@value[0], i * 7)) == 0
        i += 1
    vars_clear()
    0

[[test]]
fn test_envp_past_8k() -> i32
    vars_clear()
    # 30 exported 400-byte values (under the old 32-variable cap): ~12 KB of
    # environment, all of it present.
    var big: [401]u8
    var k: i32 = 0
    while k < 400
        big[k] = 'x'
        k += 1
    big[400] = 0
    var name: [32]u8
    var i: i64 = 0
    while i < 30
        name[0] = 'E'
        let nl: i64 = strlen(num_cstr(@name[1], i)) + 1
        big[0] = ('a' as i64 + i % 26) as u8
        assert var_set(@name[0], nl, @big[0], 400, 1) == 0
        i += 1
    var e: Envp = vars_build_envp()
    assert envp_len(@e) == 30
    let out: **u8 = envp_ptr(@e)
    assert strlen(*(out + 29)) == 404          # "E29=" + 400
    assert *(*(out + 29) + 4) == ('a' as i64 + 29 % 26) as u8
    assert *(out + 30) == null
    envp_drop(@&e)
    vars_clear()
    0
