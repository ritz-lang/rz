# test/test_parse.ritz - tokenizer, $-expansion and variables (AGAST #2461)
#
# Before #2461 a line was split on whitespace only, so `$X`, `$?`, `>` and
# `|` reached the command as literal arguments.

import ritzlib.span { Span, span_empty }
import ritzlib.memory
import ritzlib.option
import ritzlib.string
import ritzlib.strview { StrView }

import src.state { ShellState, shell_state_new }
import src.parse {
    TokKind, Tokens, tokenize, tokens_len, tokens_kind, tokens_word,
    tokens_drop, g_last_status, g_environ, PARSE_UNTERMINATED, PARSE_AND_LIST,
    vars_clear, var_set, var_lookup, var_unset, var_export, assignment_pos,
    Envp, vars_build_envp, envp_len, envp_ptr, envp_drop
}

# The last lex() result; lex() frees the one before. Tokens has Drop, so it
# cannot live at module level (§13.6): each test owns one on its frame and
# points the global at it.
var g_tk: *Tokens = null

# Tokenizes `line` from `pos`: the token count, or PARSE_UNTERMINATED.
fn lex(line: StrView, pos: i64) -> i64
    var tk: Tokens = tokenize(line, pos)
    tokens_drop(@&*g_tk)
    *g_tk = tk
    if g_tk.err != 0
        return g_tk.err as i64
    tokens_len(@*g_tk)

fn next() -> i64
    g_tk.next

fn background() -> bool
    g_tk.background

fn kind_is(idx: i64, want: TokKind) -> bool
    tokens_kind(@*g_tk, idx) == want

fn word_is(idx: i64, want: StrView) -> bool
    return kind_is(idx, TokKind.Word) and tokens_word(@*g_tk, idx).eq(want)

# True when `name` is set to exactly `want`.
fn lookup_is(name: StrView, want: StrView) -> bool
    match var_lookup(name)
        Some(v) => v.eq(want)
        None => false

# ----------------------------------------------------------------------------
# Words and operators
# ----------------------------------------------------------------------------

[[test]]
fn test_tokenize_words() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    assert lex("  echo   hello\tworld ", 0) == 3
    assert word_is(0, "echo")
    assert word_is(1, "hello")
    assert word_is(2, "world")
    0

[[test]]
fn test_tokenize_operators() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    # Operators split words even without surrounding blanks.
    assert lex("a|b>d>>e<f", 0) == 9
    assert word_is(0, "a")
    assert kind_is(1, TokKind.Pipe)
    assert word_is(2, "b")
    assert kind_is(3, TokKind.Out)
    assert word_is(4, "d")
    assert kind_is(5, TokKind.Append)
    assert word_is(6, "e")
    assert kind_is(7, TokKind.In)
    assert word_is(8, "f")
    assert next() == -1
    0

[[test]]
fn test_tokenize_semicolon_items() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    # Each ';' item is tokenized on its own, so expansion in a later item
    # sees what an earlier item set.
    let line: StrView = "X=1;echo $X ; ';' ;"
    assert lex(line, 0) == 1
    assert word_is(0, "X=1")
    assert next() == 4
    var_set("X", "1", 0)
    assert lex(line, next()) == 2
    assert word_is(1, "1")
    assert lex(line, next()) == 1
    assert word_is(0, ";")
    assert lex(line, next()) == 0
    assert next() == -1
    0

[[test]]
fn test_tokenize_quotes() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    var_set("X", "5", 0)
    # '' is literal, "" expands, \ escapes; quoted operators are words.
    assert lex("'$X | y' \"x=$X >\" a\\ b \"\"", 0) == 4
    assert word_is(0, "$X | y")
    assert word_is(1, "x=5 >")
    assert word_is(2, "a b")
    assert word_is(3, "")
    assert lex("echo 'oops", 0) == PARSE_UNTERMINATED
    assert lex("echo \"oops", 0) == PARSE_UNTERMINATED
    0

[[test]]
fn test_tokenize_comment() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    assert lex("echo a # b c", 0) == 2
    assert lex("echo a#b", 0) == 2
    assert word_is(1, "a#b")
    0

# ----------------------------------------------------------------------------
# Expansion
# ----------------------------------------------------------------------------

[[test]]
fn test_expand_var() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    assert var_set("X", "5", 0) == 0
    assert lex("echo X=$X ${X}y $Xy", 0) == 3
    assert word_is(1, "X=5")
    assert word_is(2, "5y")
    # $Xy names the unset variable Xy: the unquoted empty word is dropped.
    0

[[test]]
fn test_expand_unset_and_literal_dollar() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    assert lex("echo $NOPE \"$NOPE\" $ a$ ${", 0) == 5
    assert word_is(1, "")
    assert word_is(2, "$")
    assert word_is(3, "a$")
    assert word_is(4, "${")
    0

[[test]]
fn test_expand_status() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    g_last_status = 1
    assert lex("echo status=$?", 0) == 2
    assert word_is(1, "status=1")
    g_last_status = 127
    assert lex("echo \"$?\"", 0) == 2
    assert word_is(1, "127")
    g_last_status = 0
    0

# ----------------------------------------------------------------------------
# Variables and environment
# ----------------------------------------------------------------------------

[[test]]
fn test_var_table() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    assert var_set("1X", "v", 0) == -1
    assert var_set("FOO", "one", 0) == 0
    assert var_set("FOO", "two", 0) == 0
    assert lookup_is("FOO", "two")
    assert var_lookup("FO").is_none()
    var_unset("FOO")
    assert var_lookup("FOO").is_none()
    assert assignment_pos("X=5") == 1
    assert assignment_pos("LONG_NAME=") == 9
    assert assignment_pos("=5") == -1
    assert assignment_pos("1X=5") == -1
    assert assignment_pos("echo") == -1
    0

# Whether `want` is one of the child envp's entries: each is "K=V\0" in
# e.buf, where its pointer in the exec array points.
fn envp_has(e: @Envp, want: StrView) -> bool
    var rest: StrView = (e.buf).as_view()
    while rest.len > 0
        let end: i64 = rest.find_byte(0)
        if end < 0
            return false
        if rest.take(end).eq(want)
            return true
        rest = rest.skip(end + 1)
    false

[[test]]
fn test_envp_inherit_and_export() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    var env: [2]StrView
    env[0] = "HOME=/home/u"
    env[1] = "PATH=/bin"
    let inherited: [StrView] = @env
    g_environ = inherited

    # Lookups fall back to the inherited environment.
    assert lookup_is("HOME", "/home/u")

    # Unexported shell variables stay out of the child; exported ones and
    # overrides of inherited ones go in.
    var_set("LOCAL", "x", 0)
    var_set("X", "5", 1)
    var_set("PATH", "/usr/bin", 0)
    var_unset("HOME")
    assert var_lookup("HOME").is_none()

    var e: Envp = vars_build_envp()
    assert envp_len(@e) == 2
    let out: **u8 = envp_ptr(@e)
    assert *(out + 2) == null
    assert envp_has(@e, "X=5")
    assert envp_has(@e, "PATH=/usr/bin")
    envp_drop(@&e)

    # export of an unset name fails; of a local one marks it exported.
    assert var_export("NOPE") == -1
    assert var_export("LOCAL") == 0
    e = vars_build_envp()
    assert envp_len(@e) == 3
    envp_drop(@&e)

    g_environ = span_empty<StrView>()
    vars_clear()
    0

# ----------------------------------------------------------------------------
# No fixed tables (AGAST #3459): 64 tokens, 32 variables and an 8 KB envp
# were hard limits.
# ----------------------------------------------------------------------------

# `prefix` followed by `n` in decimal.
fn numbered(prefix: StrView, n: i64) -> String
    var s: String = string_from(prefix)
    s.push_i64(n)
    s

[[test]]
fn test_tokenize_hundred_tokens() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    # 50 words alternating with 50 pipes: 100 tokens.
    var line: String = string_new()
    var i: i32 = 0
    while i < 50
        line.push_str("w |")
        i += 1
    assert lex(line.as_view(), 0) == 100
    assert word_is(0, "w")
    assert kind_is(99, TokKind.Pipe)
    assert word_is(98, "w")
    # A long word: the old 2048-byte word buffer overflowed.
    line.clear()
    i = 0
    while i < 300
        line.push_str("abcdefgh")
        i += 1
    assert lex(line.as_view(), 0) == 1
    assert tokens_word(@*g_tk, 0).len == 2400
    0

[[test]]
fn test_sixty_four_variables() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    var i: i64 = 0
    while i < 64
        let name: String = numbered("V", i)
        let value: String = numbered("", i * 7)
        assert var_set(name.as_view(), value.as_view(), 0) == 0
        i += 1
    i = 0
    while i < 64
        let name: String = numbered("V", i)
        let value: String = numbered("", i * 7)
        assert lookup_is(name.as_view(), value.as_view())
        i += 1
    vars_clear()
    0

[[test]]
fn test_envp_past_8k() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    vars_clear()
    # 30 exported 400-byte values (under the old 32-variable cap): ~12 KB of
    # environment, all of it present.
    var big: String = string_new()
    var k: i32 = 0
    while k < 400
        big.push('x')
        k += 1
    var i: i64 = 0
    while i < 30
        let name: String = numbered("E", i)
        big.set_char(0, ('a' as i64 + i % 26) as u8)
        assert var_set(name.as_view(), big.as_view(), 1) == 0
        i += 1
    var e: Envp = vars_build_envp()
    assert envp_len(@e) == 30
    let out: **u8 = envp_ptr(@e)
    var last: String = numbered("E", 29)          # "E29=" + 400
    last.push('=')
    last.push_str(big.as_view())
    assert envp_has(@e, last.as_view())
    assert *(*(out + 29) + 4) == ('a' as i64 + 29 % 26) as u8
    assert *(out + 30) == null
    envp_drop(@&e)
    vars_clear()
    0

[[test]]
fn test_tokenize_background_items() -> i32
    var sh_state: ShellState = shell_state_new()
    sh_state.install()
    var toks: Tokens = tokenize("", 0)
    g_tk = @&toks
    # `&` ends an item like `;` and marks it to run in the background
    # (AGAST #4752); an `&` inside a word or quotes is the character.
    let line: StrView = "udp-recv 7777& udp-recv 7777 ; a'&'b &"
    assert lex(line, 0) == 2
    assert word_is(1, "7777")
    assert background()
    assert next() == 14
    assert lex(line, next()) == 2
    assert not background()
    assert lex(line, next()) == 1
    assert word_is(0, "a&b")
    assert background()
    # A trailing `&` leaves an empty last item, as a trailing `;` does.
    assert next() == 38
    assert lex(line, next()) == 0
    assert not background()
    assert next() == -1
    # `&&` is not a list operator here: an error, not two background items.
    assert lex("true && echo x", 0) == PARSE_AND_LIST as i64
    0
