# Test file for terminal I/O support
#
# Tests termios structures and syscalls for raw mode terminal support.
# These tests run on Linux only since that's where we develop/test.

import ritzlib.sys {
    sys_write,
    ECHO, ICANON, ISIG, IEXTEN, ICRNL, IXON,
    VMIN, VTIME,
    STDIN, STDOUT
}
import ritzlib.term { tcgetattr, tcsetattr, get_winsize, TcsetWhen, Termios, Winsize, Errno }
import ritzlib.result
import ritzlib.fmt
import ritzlib.strview { StrView }

fn puts(s: StrView) -> i64
    return sys_write(STDOUT, s.ptr, s.len)

fn failed(r: Result<(), Errno>) -> bool
    match r
        Ok(_) => false
        Err(_) => true

fn print_u32(n: u32)
    let v: i64 = n as i64
    print("{v}")

# ============================================================================
# Test: Termios structure size
# ============================================================================

[[test]]
fn test_termios_get() -> i32
    print("Testing tcgetattr...\n")

    # Get current terminal attributes
    let termios: Termios = match tcgetattr(STDIN)
        Ok(t) => t
        Err(e) =>
            # ENOTTY (25) is expected when running without a terminal
            # (e.g., in CI, piped, or under test harness)
            let code: i32 = e.code()
            print("  tcgetattr: errno {code}\n")
            print("  SKIP: stdin is not a tty (expected in CI)\n")
            return 0  # Skip, not fail

    # Print some values to verify structure is being read correctly
    puts("  c_lflag: ")
    print_u32(termios.c_lflag)
    print("\n")

    puts("  c_iflag: ")
    print_u32(termios.c_iflag)
    print("\n")

    puts("  c_oflag: ")
    print_u32(termios.c_oflag)
    print("\n")

    puts("  c_cflag: ")
    print_u32(termios.c_cflag)
    print("\n")

    # Verify ECHO is set (should be for normal terminal)
    # Note: When run via test harness, ECHO may not be set
    puts("  ECHO flag: ")
    if (termios.c_lflag & ECHO) != 0
        print("set\n")
    else
        print("not set\n")

    puts("  ICANON flag: ")
    if (termios.c_lflag & ICANON) != 0
        print("set\n")
    else
        print("not set\n")

    print("  PASS: tcgetattr succeeded\n")
    return 0

# ============================================================================
# Test: Get window size
# ============================================================================

[[test]]
fn test_winsize() -> i32
    print("Testing get_winsize...\n")

    # Note: This may fail if stdout is not a tty (e.g., piped output)
    let ws: Winsize = match get_winsize(STDOUT)
        Ok(w) => w
        Err(_) =>
            print("  INFO: get_winsize failed (stdout may not be a tty)\n")
            # Don't fail the test - this is expected when running under a test harness
            return 0

    print("  Rows: {ws.ws_row}\n")
    print("  Cols: {ws.ws_col}\n")

    print("  PASS: get_winsize succeeded\n")
    return 0

# ============================================================================
# Test: Raw mode enable/disable
# ============================================================================

[[test]]
fn test_raw_mode_roundtrip() -> i32
    print("Testing raw mode roundtrip...\n")

    # Get original termios
    var orig: Termios = match tcgetattr(STDIN)
        Ok(t) => t
        Err(_) =>
            # ENOTTY (25) is expected when running without a terminal
            print("  SKIP: stdin is not a tty (expected in CI)\n")
            return 0  # Skip, not fail

    let orig_lflag: u32 = orig.c_lflag
    puts("  Original c_lflag: ")
    print_u32(orig_lflag)
    print("\n")

    # Modify to raw mode - work on orig directly since we already saved orig_lflag
    # We'll restore from a fresh tcgetattr call

    # Disable canonical mode, echo, signals, extended processing
    orig.c_lflag = orig.c_lflag & (0xFFFFFFFF ^ (ECHO | ICANON | ISIG | IEXTEN))

    # Disable CR->NL translation and XON/XOFF
    orig.c_iflag = orig.c_iflag & (0xFFFFFFFF ^ (ICRNL | IXON))

    # Set minimum characters for read to 1, timeout to 0
    orig.c_cc[VMIN] = 1
    orig.c_cc[VTIME] = 0

    puts("  Modified c_lflag: ")
    print_u32(orig.c_lflag)
    print("\n")

    # Apply raw mode
    if failed(tcsetattr(STDIN, @orig, TcsetWhen.Now))
        print("  FAIL: tcsetattr (raw) failed\n")
        return 1

    print("  Raw mode applied\n")

    # Get fresh copy of terminal state and restore original lflag
    # (We can't easily copy structs, so we modify in place)
    var restore: Termios = match tcgetattr(STDIN)
        Ok(t) => t
        Err(_) =>
            print("  FAIL: tcgetattr for restore failed\n")
            return 1

    # Restore original flags
    restore.c_lflag = orig_lflag
    restore.c_iflag = restore.c_iflag | ICRNL | IXON

    if failed(tcsetattr(STDIN, @restore, TcsetWhen.Now))
        print("  FAIL: tcsetattr (restore) failed\n")
        return 1

    print("  Original mode restored\n")

    # Verify restoration
    let verify: Termios = match tcgetattr(STDIN)
        Ok(t) => t
        Err(_) =>
            print("  FAIL: Verification tcgetattr failed\n")
            return 1

    if verify.c_lflag != orig_lflag
        puts("  FAIL: c_lflag not restored. Expected: ")
        print_u32(orig_lflag)
        puts(", got: ")
        print_u32(verify.c_lflag)
        print("\n")
        return 1

    print("  PASS: Raw mode roundtrip succeeded\n")
    return 0
