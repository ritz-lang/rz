# Tests for command history

import ritzlib.fd { fd_stdout }
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.option
import ritzlib.string
import ritzlib.strview { StrView }

import src.history {
    history_add, history_reset_nav, history_up, history_down,
    history_nav_pos, history_count, history_get, history_clear,
    history_install, history_release, HISTORY_SIZE
}

fn puts(s: StrView)
    fd_stdout().write_str(s)

# 0 when `got` is `want`; else reports what came back and returns 1.
fn expect(got: Option<StrView>, want: StrView, what: StrView) -> i32
    match got
        Some(h) =>
            if h.eq(want)
                return 0
            puts("  FAIL: expected '")
            puts(want)
            puts("', got '")
            puts(h)
            print("'\n")
        None =>
            puts("  FAIL: ")
            puts(what)
            print(" returned null\n")
    return 1

# True when `got` is exactly `want`.
fn is(got: Option<StrView>, want: StrView) -> bool
    match got
        Some(h) => h.eq(want)
        None => false

# ============================================================================
# Test: Basic add and count
# ============================================================================

[[test]]
fn test_history_add() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing history add...\n")
    history_clear()

    if history_count() != 0
        print("  FAIL: count should be 0 after clear\n")
        return 1

    history_add("first command")
    if history_count() != 1
        let n: i32 = history_count()
        print("  FAIL: count should be 1, got {n}\n")
        return 1

    history_add("second command")
    if history_count() != 2
        print("  FAIL: count should be 2\n")
        return 1

    # Empty strings should not be added
    history_add("")
    if history_count() != 2
        print("  FAIL: empty string should not be added\n")
        return 1

    print("  PASS: History add works\n")
    return 0

# ============================================================================
# Test: Duplicate detection
# ============================================================================

[[test]]
fn test_history_no_duplicates() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing history duplicate detection...\n")
    history_clear()

    history_add("cmd1")
    history_add("cmd1")  # Duplicate - should not be added
    if history_count() != 1
        let n: i32 = history_count()
        print("  FAIL: count should be 1, got {n}\n")
        return 1

    history_add("cmd2")
    history_add("cmd1")  # Different from last - should be added
    if history_count() != 3
        let n: i32 = history_count()
        print("  FAIL: count should be 3, got {n}\n")
        return 1

    print("  PASS: Duplicate detection works\n")
    return 0

# ============================================================================
# Test: Navigation up
# ============================================================================

[[test]]
fn test_history_up() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing history navigation up...\n")
    history_clear()

    history_add("oldest")
    history_add("middle")
    history_add("newest")
    history_reset_nav()

    # First up should get "newest"
    if expect(history_up(), "newest", "first up") != 0
        return 1

    # Second up should get "middle"
    if expect(history_up(), "middle", "second up") != 0
        return 1

    # Third up should get "oldest"
    if expect(history_up(), "oldest", "third up") != 0
        return 1

    # Fourth up should return null (at oldest)
    if history_up().is_some()
        print("  FAIL: fourth up should return null\n")
        return 1

    print("  PASS: Navigation up works\n")
    return 0

# ============================================================================
# Test: Navigation down
# ============================================================================

[[test]]
fn test_history_down() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing history navigation down...\n")
    history_clear()

    history_add("oldest")
    history_add("newest")
    history_reset_nav()

    # Go up twice (to oldest)
    history_up()  # newest
    history_up()  # oldest

    # Now go down - should get "newest"
    if expect(history_down(), "newest", "first down") != 0
        return 1

    # Second down should return null (back at prompt)
    if history_down().is_some()
        print("  FAIL: second down should return null (at prompt)\n")
        return 1

    # Navigation position should be -1 (at prompt)
    if history_nav_pos() != -1
        let n: i32 = history_nav_pos()
        print("  FAIL: nav_pos should be -1, got {n}\n")
        return 1

    print("  PASS: Navigation down works\n")
    return 0

# ============================================================================
# Test: Get by index
# ============================================================================

[[test]]
fn test_history_get() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing history_get...\n")
    history_clear()

    history_add("cmd0")
    history_add("cmd1")
    history_add("cmd2")

    # Index 0 should be oldest
    if not is(history_get(0), "cmd0")
        print("  FAIL: get(0) should return 'cmd0'\n")
        return 1

    # Index 2 should be newest
    if not is(history_get(2), "cmd2")
        print("  FAIL: get(2) should return 'cmd2'\n")
        return 1

    # Out of range should return null
    if history_get(3).is_some()
        print("  FAIL: get(3) should return null\n")
        return 1

    if history_get(-1).is_some()
        print("  FAIL: get(-1) should return null\n")
        return 1

    print("  PASS: history_get works\n")
    return 0

# ============================================================================
# Test: Empty history navigation
# ============================================================================

[[test]]
fn test_history_empty() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    print("Testing empty history navigation...\n")
    history_clear()
    history_reset_nav()

    if history_up().is_some()
        print("  FAIL: up on empty history should return null\n")
        return 1

    if history_down().is_some()
        print("  FAIL: down on empty history should return null\n")
        return 1

    print("  PASS: Empty history handled correctly\n")
    return 0

# ============================================================================
# Test: Long entries are stored whole (AGAST #4083)
# ============================================================================
# Entries were fixed [512]u8 rows: a longer line came back cut at byte 511.

# `n` bytes ending in `last`.
fn long_line(n: i64, last: u8) -> String
    var s: String = string_new()
    var i: i64 = 0
    while i < n - 1
        s.push(97 + ((i % 26) as u8))
        i = i + 1
    s.push(last)
    return s

[[test]]
fn test_history_long_entry() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    history_clear()
    history_reset_nav()
    let z: String = long_line(2000, 90)
    history_add(z.as_view())
    if not is(history_up(), z.as_view())
        print("  FAIL: up should recall all 2000 bytes\n")
        return 1
    # A line that differs only past byte 511 is a new entry, not a duplicate.
    let y: String = long_line(2000, 89)
    history_add(y.as_view())
    if history_count() != 2
        print("  FAIL: lines differing past byte 511 are distinct\n")
        return 2
    if not is(history_get(1), y.as_view())
        return 3
    return 0

# ============================================================================
# Test: The ring overwrites the oldest entry when full
# ============================================================================

[[test]]
fn test_history_ring_wraps() -> i32
    var entries: Vec<String> = vec_new<String>()
    history_install(@&entries)
    defer history_release()
    history_clear()
    var i: i32 = 0
    while i < HISTORY_SIZE + 3
        # Distinct entries: length i+1 (and a 600-byte tail to exercise reuse).
        let entry: String = long_line((i + 1) as i64 + 600, 65)
        history_add(entry.as_view())
        i = i + 1
    if history_count() != HISTORY_SIZE
        return 1
    # Oldest surviving is entry 3 (length 604); newest is length HISTORY_SIZE+603.
    if not is(history_get(0), long_line(604, 65).as_view())
        return 2
    if not is(history_get(HISTORY_SIZE - 1), long_line((HISTORY_SIZE + 603) as i64, 65).as_view())
        return 3
    history_clear()
    if history_count() != 0 or history_get(0).is_some()
        return 4
    return 0
