# Tests for command history

import ritzlib.sys { sys_write, STDOUT }
import ritzlib.fmt
import ritzlib.str { strlen, strcmp }

import src.history {
    history_add, history_reset_nav, history_up, history_down,
    history_nav_pos, history_count, history_get, history_clear,
    HISTORY_SIZE
}

fn puts(s: *u8) -> i64
    return sys_write(STDOUT, s, strlen(s))

# ============================================================================
# Test: Basic add and count
# ============================================================================

[[test]]
fn test_history_add() -> i32
    print("Testing history add...\n")
    history_clear()

    if history_count() != 0
        print("  FAIL: count should be 0 after clear\n")
        return 1

    history_add(c"first command")
    if history_count() != 1
        let n: i32 = history_count()
        print("  FAIL: count should be 1, got {n}\n")
        return 1

    history_add(c"second command")
    if history_count() != 2
        print("  FAIL: count should be 2\n")
        return 1

    # Empty strings should not be added
    history_add(c"")
    if history_count() != 2
        print("  FAIL: empty string should not be added\n")
        return 1

    print("  PASS: History add works\n")
    return 0

# ============================================================================
# Test: Duplicate detection
# ============================================================================

[[test]]
fn test_history_no_duplicates() -> i32
    print("Testing history duplicate detection...\n")
    history_clear()

    history_add(c"cmd1")
    history_add(c"cmd1")  # Duplicate - should not be added
    if history_count() != 1
        let n: i32 = history_count()
        print("  FAIL: count should be 1, got {n}\n")
        return 1

    history_add(c"cmd2")
    history_add(c"cmd1")  # Different from last - should be added
    if history_count() != 3
        let n: i32 = history_count()
        print("  FAIL: count should be 3, got {n}\n")
        return 1

    print("  PASS: Duplicate detection works\n")
    return 0

# ============================================================================
# Test: Navigation up
# ============================================================================

[[test]]
fn test_history_up() -> i32
    print("Testing history navigation up...\n")
    history_clear()

    history_add(c"oldest")
    history_add(c"middle")
    history_add(c"newest")
    history_reset_nav()

    # First up should get "newest"
    let h1: *u8 = history_up()
    if h1 == null
        print("  FAIL: first up returned null\n")
        return 1
    if strcmp(h1, c"newest") != 0
        puts(c"  FAIL: expected 'newest', got '")
        puts(h1)
        print("'\n")
        return 1

    # Second up should get "middle"
    let h2: *u8 = history_up()
    if h2 == null
        print("  FAIL: second up returned null\n")
        return 1
    if strcmp(h2, c"middle") != 0
        puts(c"  FAIL: expected 'middle', got '")
        puts(h2)
        print("'\n")
        return 1

    # Third up should get "oldest"
    let h3: *u8 = history_up()
    if h3 == null
        print("  FAIL: third up returned null\n")
        return 1
    if strcmp(h3, c"oldest") != 0
        puts(c"  FAIL: expected 'oldest', got '")
        puts(h3)
        print("'\n")
        return 1

    # Fourth up should return null (at oldest)
    let h4: *u8 = history_up()
    if h4 != null
        print("  FAIL: fourth up should return null\n")
        return 1

    print("  PASS: Navigation up works\n")
    return 0

# ============================================================================
# Test: Navigation down
# ============================================================================

[[test]]
fn test_history_down() -> i32
    print("Testing history navigation down...\n")
    history_clear()

    history_add(c"oldest")
    history_add(c"newest")
    history_reset_nav()

    # Go up twice (to oldest)
    history_up()  # newest
    history_up()  # oldest

    # Now go down - should get "newest"
    let h1: *u8 = history_down()
    if h1 == null
        print("  FAIL: first down returned null\n")
        return 1
    if strcmp(h1, c"newest") != 0
        puts(c"  FAIL: expected 'newest', got '")
        puts(h1)
        print("'\n")
        return 1

    # Second down should return null (back at prompt)
    let h2: *u8 = history_down()
    if h2 != null
        print("  FAIL: second down should return null (at prompt)\n")
        return 1

    # Navigation position should be -1 (at prompt)
    if history_nav_pos() != -1
        let n: i32 = history_nav_pos()
        print("  FAIL: nav_pos should be -1, got {n}\n")
        return 1

    print("  PASS: Navigation down works\n")
    return 0

# ============================================================================
# Test: Get by index
# ============================================================================

[[test]]
fn test_history_get() -> i32
    print("Testing history_get...\n")
    history_clear()

    history_add(c"cmd0")
    history_add(c"cmd1")
    history_add(c"cmd2")

    # Index 0 should be oldest
    let h0: *u8 = history_get(0)
    if h0 == null or strcmp(h0, c"cmd0") != 0
        print("  FAIL: get(0) should return 'cmd0'\n")
        return 1

    # Index 2 should be newest
    let h2: *u8 = history_get(2)
    if h2 == null or strcmp(h2, c"cmd2") != 0
        print("  FAIL: get(2) should return 'cmd2'\n")
        return 1

    # Out of range should return null
    let h3: *u8 = history_get(3)
    if h3 != null
        print("  FAIL: get(3) should return null\n")
        return 1

    let h_neg: *u8 = history_get(-1)
    if h_neg != null
        print("  FAIL: get(-1) should return null\n")
        return 1

    print("  PASS: history_get works\n")
    return 0

# ============================================================================
# Test: Empty history navigation
# ============================================================================

[[test]]
fn test_history_empty() -> i32
    print("Testing empty history navigation...\n")
    history_clear()
    history_reset_nav()

    if history_up() != null
        print("  FAIL: up on empty history should return null\n")
        return 1

    if history_down() != null
        print("  FAIL: down on empty history should return null\n")
        return 1

    print("  PASS: Empty history handled correctly\n")
    return 0

# ============================================================================
# Test: Long entries are stored whole (AGAST #4083)
# ============================================================================
# Entries were fixed [512]u8 rows: a longer line came back cut at byte 511.

var g_long: [2001]u8

# Fills g_long with `n` bytes ending in `last`, NUL-terminated.
fn fill_long(n: i64, last: u8) -> *u8
    var i: i64 = 0
    while i < n
        g_long[i as i32] = 97 + ((i % 26) as u8)
        i = i + 1
    g_long[(n - 1) as i32] = last
    g_long[n as i32] = 0
    return @g_long[0]

[[test]]
fn test_history_long_entry() -> i32
    history_clear()
    history_reset_nav()
    history_add(fill_long(2000, 90))
    let up: *u8 = history_up()
    if up == null or strlen(up) != 2000 or strcmp(up, fill_long(2000, 90)) != 0
        print("  FAIL: up should recall all 2000 bytes\n")
        return 1
    # A line that differs only past byte 511 is a new entry, not a duplicate.
    history_add(fill_long(2000, 89))
    if history_count() != 2
        print("  FAIL: lines differing past byte 511 are distinct\n")
        return 2
    let got: *u8 = history_get(1)
    if got == null or strcmp(got, fill_long(2000, 89)) != 0
        return 3
    return 0

# ============================================================================
# Test: The ring overwrites the oldest entry when full
# ============================================================================

[[test]]
fn test_history_ring_wraps() -> i32
    history_clear()
    var i: i32 = 0
    while i < HISTORY_SIZE + 3
        # Distinct entries: length i+1 (and a 600-byte tail to exercise reuse).
        history_add(fill_long((i + 1) as i64 + 600, 65))
        i = i + 1
    if history_count() != HISTORY_SIZE
        return 1
    # Oldest surviving is entry 3 (length 604); newest is length HISTORY_SIZE+603.
    let oldest: *u8 = history_get(0)
    if oldest == null or strlen(oldest) != 604
        return 2
    let newest: *u8 = history_get(HISTORY_SIZE - 1)
    if newest == null or strlen(newest) != (HISTORY_SIZE + 603) as i64
        return 3
    history_clear()
    if history_count() != 0 or history_get(0) != null
        return 4
    return 0
