# Tests for escape sequence parsing

import ritzlib.fmt
import ritzlib.strview { StrView }

import src.input {
    input_reset, input_parse_byte, input_in_escape, input_get_char,
    KEY_NONE, KEY_CHAR, KEY_UP, KEY_DOWN, KEY_RIGHT, KEY_LEFT,
    KEY_HOME, KEY_END, KEY_DELETE, KEY_BACKSPACE, KEY_ENTER, KEY_TAB,
    KEY_CTRL_C, KEY_CTRL_D, KEY_CTRL_A, KEY_CTRL_E,
    KEY_ESCAPE, KEY_UNKNOWN, csi_n
}

fn assert_eq(name: StrView, expected: i32, actual: i32) -> bool
    if expected != actual
        print("  FAIL: {name} expected {expected} got {actual}\n")
        return false
    return true

# ============================================================================
# Test: Regular characters
# ============================================================================

[[test]]
fn test_regular_chars() -> i32
    print("Testing regular character parsing...\n")
    input_reset()

    # Test printable characters
    let key_a: i32 = input_parse_byte(97)  # 'a'
    if (key_a & 0xFFFF) != KEY_CHAR
        print("  FAIL: 'a' should return KEY_CHAR\n")
        return 1

    let char_a: u8 = input_get_char(key_a)
    if char_a != 97
        print("  FAIL: char should be 'a' (97), got {char_a}\n")
        return 1

    # Test space
    let key_sp: i32 = input_parse_byte(32)  # ' '
    if (key_sp & 0xFFFF) != KEY_CHAR
        print("  FAIL: space should return KEY_CHAR\n")
        return 1

    if input_get_char(key_sp) != 32
        print("  FAIL: space char wrong\n")
        return 1

    print("  PASS: Regular characters parsed correctly\n")
    return 0

# ============================================================================
# Test: Control characters
# ============================================================================

[[test]]
fn test_control_chars() -> i32
    print("Testing control character parsing...\n")
    input_reset()

    # Backspace (127)
    if not assert_eq("backspace 127", KEY_BACKSPACE, input_parse_byte(127))
        return 1

    # Backspace (8)
    if not assert_eq("backspace 8", KEY_BACKSPACE, input_parse_byte(8))
        return 1

    # Enter (13)
    if not assert_eq("enter CR", KEY_ENTER, input_parse_byte(13))
        return 1

    # Enter (10)
    if not assert_eq("enter LF", KEY_ENTER, input_parse_byte(10))
        return 1

    # Tab
    if not assert_eq("tab", KEY_TAB, input_parse_byte(9))
        return 1

    # Ctrl+C
    if not assert_eq("ctrl-c", KEY_CTRL_C, input_parse_byte(3))
        return 1

    # Ctrl+D
    if not assert_eq("ctrl-d", KEY_CTRL_D, input_parse_byte(4))
        return 1

    # Ctrl+A
    if not assert_eq("ctrl-a", KEY_CTRL_A, input_parse_byte(1))
        return 1

    # Ctrl+E
    if not assert_eq("ctrl-e", KEY_CTRL_E, input_parse_byte(5))
        return 1

    print("  PASS: Control characters parsed correctly\n")
    return 0

# ============================================================================
# Test: Arrow keys
# ============================================================================

[[test]]
fn test_arrow_keys() -> i32
    print("Testing arrow key parsing...\n")

    # Up arrow: ESC [ A
    input_reset()
    if not assert_eq("up esc", KEY_NONE, input_parse_byte(27))
        return 1
    if not input_in_escape()
        print("  FAIL: should be in escape state\n")
        return 1
    if not assert_eq("up bracket", KEY_NONE, input_parse_byte(91))
        return 1
    if not assert_eq("up A", KEY_UP, input_parse_byte(65))
        return 1
    if input_in_escape()
        print("  FAIL: should not be in escape state\n")
        return 1

    # Down arrow: ESC [ B
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("down B", KEY_DOWN, input_parse_byte(66))
        return 1

    # Right arrow: ESC [ C
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("right C", KEY_RIGHT, input_parse_byte(67))
        return 1

    # Left arrow: ESC [ D
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("left D", KEY_LEFT, input_parse_byte(68))
        return 1

    print("  PASS: Arrow keys parsed correctly\n")
    return 0

# ============================================================================
# Test: Home/End keys
# ============================================================================

[[test]]
fn test_home_end() -> i32
    print("Testing Home/End key parsing...\n")

    # Home: ESC [ H
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("home H", KEY_HOME, input_parse_byte(72))
        return 1

    # End: ESC [ F
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("end F", KEY_END, input_parse_byte(70))
        return 1

    # Home alternate: ESC [ 1 ~
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    if not assert_eq("home 1", KEY_NONE, input_parse_byte(49))  # '1'
        return 1
    if not assert_eq("home ~", KEY_HOME, input_parse_byte(126))  # '~'
        return 1

    # End alternate: ESC [ 4 ~
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    input_parse_byte(52)  # '4'
    if not assert_eq("end 4~", KEY_END, input_parse_byte(126))
        return 1

    print("  PASS: Home/End keys parsed correctly\n")
    return 0

# ============================================================================
# Test: Delete key
# ============================================================================

[[test]]
fn test_delete() -> i32
    print("Testing Delete key parsing...\n")

    # Delete: ESC [ 3 ~
    input_reset()
    input_parse_byte(27)
    input_parse_byte(91)
    input_parse_byte(51)  # '3'
    if not assert_eq("delete 3~", KEY_DELETE, input_parse_byte(126))
        return 1

    print("  PASS: Delete key parsed correctly\n")
    return 0

# ============================================================================
# Test: Escape key (bare ESC)
# ============================================================================

[[test]]
fn test_bare_escape() -> i32
    print("Testing bare ESC handling...\n")

    # ESC followed by non-sequence character
    input_reset()
    let r1: i32 = input_parse_byte(27)
    if r1 != KEY_NONE
        print("  FAIL: ESC should return KEY_NONE\n")
        return 1

    # Non-bracket character after ESC
    let r2: i32 = input_parse_byte(120)  # 'x' - not a valid sequence start
    if r2 != KEY_ESCAPE
        print("  FAIL: ESC+x should return KEY_ESCAPE, got {r2}\n")
        return 1

    print("  PASS: Bare ESC handled correctly\n")
    return 0

# ============================================================================
# Test: CSI cursor sequences (AGAST #1872)
# ============================================================================
# cursor_left / cursor_right / cursor_column each built `ESC [ n X` by hand,
# capped at three digits: n >= 1000 wrote ':' (48 + 10) for the thousands.

# `buf[0..len]` is exactly the bytes of `want`.
fn bytes_are(buf: *u8, len: i32, want: StrView) -> bool
    if len as i64 != want.len
        let rest: StrView = want.skip(1)
        print("  FAIL: length {len} for {rest}\n")
        return false
    for i in 0..len
        if *(buf + i) != want.get(i as i64)
            let rest: StrView = want.skip(1)
            print("  FAIL: byte {i} of {rest}\n")
            return false
    return true

[[test]]
fn test_csi_n() -> i32
    print("Testing CSI cursor sequences...\n")
    var buf: [16]u8
    if not bytes_are(@buf[0], csi_n(@buf[0], 1, 'D'), "\e[1D")
        return 1
    if not bytes_are(@buf[0], csi_n(@buf[0], 42, 'C'), "\x1b[42C")
        return 2
    if not bytes_are(@buf[0], csi_n(@buf[0], 512, 'G'), "\e[512G")
        return 3
    if not bytes_are(@buf[0], csi_n(@buf[0], 1000, 'D'), "\e[1000D")
        return 4
    if not bytes_are(@buf[0], csi_n(@buf[0], 2147483647, 'G'), "\e[2147483647G")
        return 5
    # i32's extremes and 0 (#1957): the old `while v > 9` loop wrote
    # '0' + (v as u8) for a negative n, so i32's minimum came out as junk.
    if not bytes_are(@buf[0], csi_n(@buf[0], 0, 'G'), "\e[0G")
        return 6
    if not bytes_are(@buf[0], csi_n(@buf[0], -2147483648, 'D'), "\e[-2147483648D")
        return 7
    print("  PASS\n")
    return 0
