# state.ritz - what the shell owns: the line buffer, the history ring, the
# variable table and the background jobs
#
# A Vec has Drop, so none of these can be a module-level value (§13.6: one
# is never dropped). main owns a ShellState on its frame, and a test owns its
# own; install() points common's, history's, parse's and shell's globals at
# its Vecs, and its drop frees the elements (a Vec doesn't drop them) and
# unhooks them.

import ritzlib.gvec
import ritzlib.string
import common { line_install, line_release }
import history { history_install, history_release }
import parse { ShellVar, vars_install, vars_release }
import shell { jobs_install, jobs_release }

pub struct ShellState
    line: Vec<u8>
    history: Vec<String>
    vars: Vec<ShellVar>
    jobs: Vec<i32>                   # `cmd &` pids `wait` has not reaped

impl Drop for ShellState
    fn drop(self: @&ShellState)
        jobs_release()
        vars_release()
        history_release()
        line_release()

pub fn shell_state_new() -> ShellState
    ShellState { line: vec_new<u8>(), history: vec_new<String>(), vars: vec_new<ShellVar>(), jobs: vec_new<i32>() }

impl ShellState
    # Make this the shell's state. It must stay put (not move) while installed.
    pub fn install(self: @&ShellState)
        line_install(@&self.line)
        history_install(@&self.history)
        vars_install(@&self.vars)
        jobs_install(@&self.jobs)
