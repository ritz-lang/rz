# rzsh's write(2)/read(2) layer (AGAST #4691)
#
# Every byte rzsh writes or reads on its standard streams goes through
# these, and its pid comes from here. They stay raw syscalls because src/ also builds the
# freestanding Harland bin, where ritzlib.fd does not build (Stat and most
# fd syscalls are Linux-only). A module of its own, with nothing else in it,
# so a module can use it without importing common's println (which
# collides with ritzlib.io's in tests that import both).

import ritzlib.sys { sys_read, sys_write, sys_getpid, STDIN, STDOUT, STDERR }
import ritzlib.span { Span }
import ritzlib.strview { StrView }

# `s` on stdout: bytes written, or -errno.
pub fn out_str(s: StrView) -> i64
    return sys_write(STDOUT, s.ptr, s.len)

# `s` on stderr.
pub fn err_str(s: StrView)
    sys_write(STDERR, s.ptr, s.len)

# One read(2) of stdin into `buf`: bytes read, 0 at EOF, or -errno.
pub fn in_read(buf: Span<u8>) -> i64
    return sys_read(STDIN, buf.ptr, buf.len)

# This process's id (getpid(2); the Harland pid on Harland).
pub fn shell_pid() -> i32
    return sys_getpid()
