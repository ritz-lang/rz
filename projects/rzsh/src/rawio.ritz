# rzsh's standard-stream layer (AGAST #4691)
#
# Every byte rzsh writes or reads on its standard streams goes through
# these, and its pid comes from here. The streams are ritzlib.fd's borrowed
# standard Fds, which build for both the Linux bin and the freestanding
# Harland bin (AGAST #4832). A module of its own, with nothing else in it,
# so a module can use it without importing common.

import ritzlib.fd { Fd, fd_stdin, fd_stdout, fd_stderr }
import ritzlib.errno { Errno }
import ritzlib.sys { sys_getpid }
import ritzlib.result
import ritzlib.span { Span }
import ritzlib.strview { StrView }

# All of `s` on stdout.
pub fn out_str(s: StrView) -> Result<(), Errno>
    fd_stdout().write_str(s)

# All of `s` on stderr. Best effort: a failed write to stderr has nowhere
# left to be reported.
pub fn err_str(s: StrView)
    match fd_stderr().write_str(s)
        Ok(_) => pass
        Err(_) => pass

# One read of stdin into `buf`: Ok(bytes read, 0 at EOF).
pub fn in_read(buf: Span<u8>) -> Result<i64, Errno>
    fd_stdin().read(buf)

# This process's id (the Harland pid on Harland). getpid stays raw:
# ritzlib.process (process_id) does not build for the Harland bin; it
# names fork/execve/wait4/kill/access/signalfd4, which have no Harland
# ritzlib.sys wrappers.
pub fn shell_pid() -> i32
    sys_getpid()
