# rzsh command history
#
# Simple ring buffer for command history with navigation.

import ritzlib.gvec
import ritzlib.memory
import ritzlib.option
import ritzlib.string { String, string_new }
import ritzlib.strview { StrView }

# ============================================================================
# History configuration
# ============================================================================

pub const HISTORY_SIZE: i32 = 100

# ============================================================================
# History buffer (ring buffer)
# ============================================================================

# The history buffer stores up to HISTORY_SIZE entries, each a String of any
# length (entries were fixed [512]u8 rows that cut a line at byte 511, AGAST
# #4083). g_history grows one String per slot until it holds HISTORY_SIZE;
# after that the ring reuses slots, keeping each String's allocation.
# g_history_write is where the next entry will be written.
# g_history_count is the number of valid entries.
# g_history_nav is the current navigation position (for up/down arrows).

# A Vec has Drop, so it cannot live at module level (§13.6: a module-level
# value is never dropped). The entries live in a heap Vec allocated once;
# the global is the pointer to it.
var g_history: *Vec<String> = null
var g_history_write: i32 = 0      # Next slot to write
var g_history_count: i32 = 0      # Number of valid entries
var g_history_nav: i32 = -1       # Navigation position (-1 = at prompt)

fn history_vec() -> *Vec<String>
    if g_history == null
        let p: *Vec<String> = malloc(sizeof(Vec<String>)) as *Vec<String>
        *p = vec_new<String>()
        g_history = p
    g_history

# The entry in ring slot `slot`. Valid until that slot is next written.
fn slot_view(slot: i32) -> StrView
    return (history_vec().get_ptr(slot as i64)).as_view()

# ============================================================================
# Add a line to history
# ============================================================================
# Only adds non-empty lines that differ from the previous entry.

pub fn history_add(line: StrView)
    # Skip empty lines
    if line.len == 0
        return

    # Skip if same as last entry
    if g_history_count > 0
        let last: i32 = (g_history_write + HISTORY_SIZE - 1) % HISTORY_SIZE
        if slot_view(last).eq(line)
            return

    # A slot past the end of g_history is new; otherwise reuse its String.
    if g_history_write as i64 >= history_vec().len
        if not history_vec().push(string_new())
            return  # Out of memory: drop the entry
    let entry: *String = history_vec().get_ptr(g_history_write as i64)
    entry.clear()
    if not entry.push_str(line)
        entry.clear()
        return  # Out of memory: the slot stays unused

    # Advance write pointer
    g_history_write = (g_history_write + 1) % HISTORY_SIZE

    # Increment count (up to max)
    if g_history_count < HISTORY_SIZE
        g_history_count = g_history_count + 1

# ============================================================================
# Reset navigation position
# ============================================================================
# Call this when starting a new prompt.

pub fn history_reset_nav()
    g_history_nav = -1

# ============================================================================
# Navigate up (older entries)
# ============================================================================
# Returns the history line, or None if at oldest entry.

pub fn history_up() -> Option<StrView>
    if g_history_count == 0
        return None

    # If at prompt (nav = -1), start at most recent
    if g_history_nav == -1
        g_history_nav = g_history_count - 1
        let idx: i32 = (g_history_write + HISTORY_SIZE - 1) % HISTORY_SIZE
        return Some(slot_view(idx))

    # If already at oldest, return None
    if g_history_nav == 0
        return None

    # Move to older entry
    g_history_nav = g_history_nav - 1
    let idx: i32 = (g_history_write + HISTORY_SIZE - g_history_count + g_history_nav) % HISTORY_SIZE
    return Some(slot_view(idx))

# ============================================================================
# Navigate down (newer entries)
# ============================================================================
# Returns the history line, or None if at prompt position.

pub fn history_down() -> Option<StrView>
    if g_history_count == 0
        return None

    # If at prompt, stay there
    if g_history_nav == -1
        return None

    # If at most recent, return to prompt
    if g_history_nav >= g_history_count - 1
        g_history_nav = -1
        return None

    # Move to newer entry
    g_history_nav = g_history_nav + 1
    let idx: i32 = (g_history_write + HISTORY_SIZE - g_history_count + g_history_nav) % HISTORY_SIZE
    return Some(slot_view(idx))

# ============================================================================
# Get current navigation position
# ============================================================================
# Returns -1 if at prompt, otherwise 0-based index into history.

pub fn history_nav_pos() -> i32
    return g_history_nav

# ============================================================================
# Get history count
# ============================================================================

pub fn history_count() -> i32
    return g_history_count

# ============================================================================
# Get history entry by index (0 = oldest)
# ============================================================================

pub fn history_get(index: i32) -> Option<StrView>
    if index < 0 or index >= g_history_count
        return None

    let idx: i32 = (g_history_write + HISTORY_SIZE - g_history_count + index) % HISTORY_SIZE
    return Some(slot_view(idx))

# ============================================================================
# Clear history
# ============================================================================

# Slots keep their Strings' storage for reuse.
pub fn history_clear()
    g_history_write = 0
    g_history_count = 0
    g_history_nav = -1
