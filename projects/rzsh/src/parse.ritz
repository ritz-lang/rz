# parse.ritz - rzsh command-line tokenizer, $-expansion and shell variables
#
# AGAST #2461: the shell used to split a line on whitespace and nothing else,
# so `$X`, `$?`, `>` and `|` reached the command as literal arguments. A line
# is now tokenized into words and operators, with expansion done while the
# word is built (so quoting decides what expands):
#
#   words      foo  'single quoted'  "double $QUOTED"  back\ slash
#   operators  |  >  >>  <     (';' separates items: see tokenize)
#   expansion  $NAME  ${NAME}  $?   (no field splitting, no globbing)
#   comments   # to end of line, at the start of a word
#
# An unquoted word that expands to nothing (`echo $UNSET`) is dropped, as in
# sh. Variable lookups fall back to the environment the shell was started
# with (g_environ, Linux only).
#
# AGAST #3459: tokens, variables and the child envp used to live in fixed
# global arrays (64 tokens, 32 variables, an 8 KB envp), so a long line
# overflowed, the 33rd variable failed and exports past 8 KB were silently
# left out of a child's environment. They are now a Vec<Token>, a
# Vec<ShellVar> and an Envp built in a String, with no size limit but memory.

import ritzlib.str { strlen }
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview { StrView, strview_from_ptr }

# ============================================================================
# Tokens
# ============================================================================

pub enum TokKind
    Word
    Pipe      # |
    Out       # >
    Append    # >>
    In        # <

# A token. For a Word, `word` is its text after quoting and expansion; the
# bytes are NUL-terminated (word.ptr works as a C string) and owned by the
# Tokens it came from. Operators have an empty word.
pub struct Token
    kind: TokKind
    word: StrView

# The result of tokenizing one list item.
pub struct Tokens
    toks: Vec<Token>
    words: Vec<String>   # owns the bytes every Word token's StrView borrows
    next: i64            # index just past the ';' that ended the item, or -1
    err: i32             # 0, or PARSE_UNTERMINATED

# tokenize() errors
pub const PARSE_UNTERMINATED: i32 = -1

# Exit status of the last command, for `$?`.
pub var g_last_status: i32 = 0

pub fn tokens_len(t: @Tokens) -> i64
    return t.toks.len

pub fn tokens_kind(t: @Tokens, idx: i64) -> TokKind
    let tok: Token = vec_get<Token>(@t.toks, idx)
    return tok.kind

pub fn tokens_is_word(t: @Tokens, idx: i64) -> bool
    return tokens_kind(t, idx) == TokKind.Word

# Word `idx` as a C string (null for an operator).
pub fn tokens_word(t: @Tokens, idx: i64) -> *u8
    let tok: Token = vec_get<Token>(@t.toks, idx)
    if tok.kind != TokKind.Word
        return null
    return tok.word.ptr

pub fn tokens_drop(t: @&Tokens)
    while t.words.len > 0
        var w: String = vec_pop<String>(@&t.words)
        string_drop(@&w)
    vec_drop<String>(@&t.words)
    vec_drop<Token>(@&t.toks)

# ============================================================================
# Character classes
# ============================================================================

fn is_blank(c: u8) -> bool
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

fn is_operator(c: u8) -> bool
    return c == '|' or c == ';' or c == '>' or c == '<'

pub fn is_name_start(c: u8) -> bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or c == '_'

pub fn is_name_char(c: u8) -> bool
    return is_name_start(c) or (c >= '0' and c <= '9')

# ============================================================================
# Lexer state
# ============================================================================

struct Lexer
    line: *u8
    i: i64
    word: String     # the word being built
    quoted: bool     # it had quotes or an escape, so it's kept even if empty
    out: Tokens

fn at(lx: @Lexer, off: i64) -> u8
    return *(lx.line + lx.i + off)

fn emit(lx: @&Lexer, c: u8)
    string_push(@&lx.word, c)

fn emit_cstr(lx: @&Lexer, s: *u8)
    string_push_cstr(@&lx.word, s)

fn push_op(lx: @&Lexer, kind: TokKind, width: i64)
    vec_push<Token>(@&lx.out.toks, Token { kind: kind, word: strview_from_ptr(c"", 0) })
    lx.i += width

# Ends the current word: a token if it has text or was quoted, else nothing.
# The String moves into out.words, whose growth moves only the String header,
# never the bytes the token's StrView points at.
fn finish_word(lx: @&Lexer)
    let n: i64 = string_len(@lx.word)
    if not lx.quoted and n == 0
        return
    let p: *u8 = string_as_ptr(@&lx.word)   # NUL-terminates
    let view: StrView = strview_from_ptr(p, n)
    vec_push<Token>(@&lx.out.toks, Token { kind: TokKind.Word, word: view })
    vec_push<String>(@&lx.out.words, lx.word)
    lx.word = string_new()
    lx.quoted = false

# ============================================================================
# $-expansion
# ============================================================================

# Length of the variable name at `p` (0 if none).
fn name_len(p: *u8) -> i64
    if not is_name_start(*p)
        return 0
    var n: i64 = 1
    while is_name_char(*(p + n))
        n += 1
    return n

fn emit_var(lx: @&Lexer, name: *u8, len: i64)
    let v: *u8 = var_lookup(name, len)
    if v != null
        emit_cstr(lx, v)

# lx is at '$'. Emits the expansion and moves past it.
fn expand_dollar(lx: @&Lexer)
    let c: u8 = at(lx, 1)
    if c == '?'
        string_push_i64(@&lx.word, g_last_status as i64)
        lx.i += 2
        return
    if c == '{'
        let n: i64 = name_len(lx.line + lx.i + 2)
        if n == 0 or at(lx, 2 + n) != '}'
            # Not a well-formed ${NAME}: keep the '$' literally.
            emit(lx, '$')
            lx.i += 1
            return
        emit_var(lx, lx.line + lx.i + 2, n)
        lx.i += n + 3
        return
    let n: i64 = name_len(lx.line + lx.i + 1)
    if n == 0
        # A lone '$' (end of word, "$ ", "$1"...) stays literal.
        emit(lx, '$')
        lx.i += 1
        return
    emit_var(lx, lx.line + lx.i + 1, n)
    lx.i += n + 1

# ============================================================================
# Word pieces
# ============================================================================

# '...': everything literal. Returns false when the quote never closes.
fn lex_single(lx: @&Lexer) -> bool
    lx.quoted = true
    lx.i += 1
    while at(lx, 0) != '\''
        if at(lx, 0) == '\0'
            return false
        emit(lx, at(lx, 0))
        lx.i += 1
    lx.i += 1
    return true

fn escapable_in_double(c: u8) -> bool
    return c == '$' or c == '"' or c == '\\' or c == '`'

# "...": $ expands, \ escapes $ " \ `. Returns false when it never closes.
fn lex_double(lx: @&Lexer) -> bool
    lx.quoted = true
    lx.i += 1
    while at(lx, 0) != '"'
        let d: u8 = at(lx, 0)
        if d == '\0'
            return false
        if d == '\\' and escapable_in_double(at(lx, 1))
            emit(lx, at(lx, 1))
            lx.i += 2
        else if d == '$'
            expand_dollar(lx)
        else
            emit(lx, d)
            lx.i += 1
    lx.i += 1
    return true

# \x outside quotes: x literally.
fn lex_escape(lx: @&Lexer)
    lx.quoted = true
    if at(lx, 1) == '\0'
        lx.i += 1
        return
    emit(lx, at(lx, 1))
    lx.i += 2

# A word runs until a blank or operator outside quotes. Returns false on an
# unterminated quote.
fn lex_word(lx: @&Lexer) -> bool
    while at(lx, 0) != '\0' and not is_blank(at(lx, 0)) and not is_operator(at(lx, 0))
        let w: u8 = at(lx, 0)
        if w == '\''
            if not lex_single(lx)
                return false
        else if w == '"'
            if not lex_double(lx)
                return false
        else if w == '\\'
            lex_escape(lx)
        else if w == '$'
            expand_dollar(lx)
        else
            emit(lx, w)
            lx.i += 1
    finish_word(lx)
    return true

# An operator at lx (| < > >>): pushes it and returns true, else false.
fn lex_operator(lx: @&Lexer) -> bool
    let c: u8 = at(lx, 0)
    if c == '|'
        push_op(lx, TokKind.Pipe, 1)
    else if c == '<'
        push_op(lx, TokKind.In, 1)
    else if c == '>' and at(lx, 1) == '>'
        push_op(lx, TokKind.Append, 2)
    else if c == '>'
        push_op(lx, TokKind.Out, 1)
    else
        return false
    return true

# ============================================================================
# Tokenizer
# ============================================================================

# Splits one list item of `line`, from `pos` up to the next unquoted ';' or
# the end. Items are tokenized one at a time, right before they run, so
# `export X=5 ; echo $X` and `false ; echo $?` see the earlier item's effect.
# The caller owns the result and frees it with tokens_drop.
pub fn tokenize(line: *u8, pos: i64) -> Tokens
    var lx: Lexer
    lx.line = line
    lx.i = pos
    lx.word = string_new()
    lx.quoted = false
    lx.out = Tokens { toks: vec_new<Token>(), words: vec_new<String>(), next: -1, err: 0 }

    while true
        while is_blank(at(@lx, 0))
            lx.i += 1
        let c: u8 = at(@lx, 0)
        if c == '\0' or c == '#'   # end, or a '#' comment
            break
        if c == ';'
            lx.out.next = lx.i + 1
            break
        if not lex_operator(@&lx) and not lex_word(@&lx)
            lx.out.err = PARSE_UNTERMINATED
            break

    string_drop(@&lx.word)
    return lx.out

# ============================================================================
# Shell variables
# ============================================================================

pub struct ShellVar
    name: String
    value: String    # kept NUL-terminated (see var_store)
    exported: bool
    hidden: bool     # unset tombstone: hides an inherited environ entry

var g_vars: Vec<ShellVar>

# The environment rzsh was started with (NULL-terminated "K=V" array), or
# null. Set once by main on Linux; harland has no environment.
pub var g_environ: **u8 = null

fn var_at(idx: i64) -> *ShellVar
    return vec_get_ptr<ShellVar>(@&g_vars, idx)

# True when `name` (len bytes) is a valid shell variable name.
pub fn is_valid_name(name: *u8, len: i64) -> bool
    return len > 0 and name_len(name) >= len

fn var_find(name: *u8, len: i64) -> i64
    let want: StrView = strview_from_ptr(name, len)
    var idx: i64 = 0
    while idx < g_vars.len
        let v: *ShellVar = var_at(idx)
        if string_eq(@v.name, want)
            return idx
        idx += 1
    return -1

# The value part of the environ entry for `name`, or null.
fn env_find(name: *u8, len: i64) -> *u8
    if g_environ == null
        return null
    var k: i64 = 0
    while *(g_environ + k) != null
        let e: *u8 = *(g_environ + k)
        var i: i64 = 0
        while i < len and *(e + i) == *(name + i)
            i += 1
        if i == len and *(e + len) == '='
            return e + len + 1
        k += 1
    return null

fn var_free(v: *ShellVar)
    string_drop(@&v.name)
    string_drop(@&v.value)

pub fn vars_clear()
    var idx: i64 = 0
    while idx < g_vars.len
        var_free(var_at(idx))
        idx += 1
    vec_drop<ShellVar>(@&g_vars)

# The slot for `name`. A new one is appended, exported when the name is
# inherited from the environment (an inherited variable stays exported).
fn var_slot(name: *u8, len: i64) -> *ShellVar
    let idx: i64 = var_find(name, len)
    if idx >= 0
        return var_at(idx)
    let v: ShellVar = ShellVar {
        name: string_from_bytes(Span<u8> { ptr: (name), len: (len) as i64 }), value: string_new(),
        exported: env_find(name, len) != null, hidden: false
    }
    vec_push<ShellVar>(@&g_vars, v)
    return var_at(g_vars.len - 1)

fn var_store(v: *ShellVar, value: *u8, vlen: i64)
    string_clear(@&v.value)
    string_push_bytes(@&v.value, Span<u8> { ptr: (value), len: (vlen) as i64 })
    string_as_ptr(@&v.value)   # NUL-terminate, so lookups can hand out *u8

# Sets `name` to `value` (byte lengths given). export != 0 marks it exported;
# a variable inherited from the environment stays exported. Returns 0, or -1
# for a bad name.
pub fn var_set(name: *u8, len: i64, value: *u8, vlen: i64, export: i32) -> i32
    if not is_valid_name(name, len)
        return -1
    let v: *ShellVar = var_slot(name, len)
    v.hidden = false
    var_store(v, value, vlen)
    if export != 0
        v.exported = true
    return 0

# Marks an existing variable exported, importing it from the environment
# first if needed. Returns 0, or -1 if it isn't set anywhere.
pub fn var_export(name: *u8, len: i64) -> i32
    let idx: i64 = var_find(name, len)
    if idx >= 0
        let v: *ShellVar = var_at(idx)
        if v.hidden
            return -1
        v.exported = true
        return 0
    if idx < 0
        let e: *u8 = env_find(name, len)
        if e != null
            return var_set(name, len, e, strlen(e), 1)
    return -1

pub fn var_unset(name: *u8, len: i64)
    let idx: i64 = var_find(name, len)
    let inherited: bool = env_find(name, len) != null
    if idx < 0 and not inherited
        return
    # An inherited variable keeps a hidden slot as a tombstone, to hide the
    # environ entry from lookups and from children.
    let v: *ShellVar = var_slot(name, len)
    v.hidden = true
    v.exported = false
    string_clear(@&v.value)

# The value of `name`, or null when unset. Shell table first, then environ.
pub fn var_lookup(name: *u8, len: i64) -> *u8
    let idx: i64 = var_find(name, len)
    if idx < 0
        return env_find(name, len)
    let v: *ShellVar = var_at(idx)
    if v.hidden
        return null
    return string_as_ptr(@&v.value)

# Index of '=' when `word` is an assignment (NAME=...), else -1.
pub fn assignment_pos(word: *u8) -> i64
    var i: i64 = 0
    while *(word + i) != '\0' and *(word + i) != '='
        i += 1
    if *(word + i) != '=' or not is_valid_name(word, i)
        return -1
    return i

# Table walk for `export` with no arguments: slots are 0..vars_count().
pub fn vars_count() -> i64
    return g_vars.len

# The name of slot `idx` if it holds an exported variable, else null.
pub fn var_exported_name(idx: i64) -> *u8
    if idx < 0 or idx >= g_vars.len
        return null
    let v: *ShellVar = var_at(idx)
    if v.hidden or not v.exported
        return null
    return string_as_ptr(@&v.name)

pub fn var_value(idx: i64) -> *u8
    let v: *ShellVar = var_at(idx)
    return string_as_ptr(@&v.value)

# ============================================================================
# Child environment
# ============================================================================

# A child's envp: `ptrs` is the NULL-terminated array to pass to exec. The
# shell's own exported entries live in `buf` ("K=V\0K=V\0..."); inherited
# entries point into g_environ.
pub struct Envp
    buf: String
    ptrs: Vec<*u8>

# Number of entries, excluding the NULL.
pub fn envp_len(e: @Envp) -> i64
    return e.ptrs.len - 1

pub fn envp_ptr(e: @Envp) -> **u8
    return e.ptrs.data

pub fn envp_drop(e: @&Envp)
    string_drop(@&e.buf)
    vec_drop<*u8>(@&e.ptrs)

# Inherited entries the shell table doesn't shadow (a tombstone shadows too).
fn envp_add_inherited(e: @&Envp)
    if g_environ == null
        return
    var k: i64 = 0
    while *(g_environ + k) != null
        let ent: *u8 = *(g_environ + k)
        var nl: i64 = 0
        while *(ent + nl) != '\0' and *(ent + nl) != '='
            nl += 1
        if var_find(ent, nl) < 0
            vec_push<*u8>(@&e.ptrs, ent)
        k += 1

# Builds the envp for a child: exported shell variables, then inherited
# entries. The caller frees it with envp_drop.
pub fn vars_build_envp() -> Envp
    var e: Envp = Envp { buf: string_new(), ptrs: vec_new<*u8>() }
    # Pass 1 fills buf; its buffer may move as it grows, so the pointers to
    # the entries are taken in pass 2, once it's complete.
    var count: i64 = 0
    var idx: i64 = 0
    while idx < g_vars.len
        let v: *ShellVar = var_at(idx)
        if v.exported and not v.hidden
            string_push_string(@&e.buf, @v.name)
            string_push(@&e.buf, '=')
            string_push_string(@&e.buf, @v.value)
            string_push(@&e.buf, '\0')
            count += 1
        idx += 1

    var p: *u8 = string_as_ptr(@&e.buf)
    while count > 0
        vec_push<*u8>(@&e.ptrs, p)
        p = p + strlen(p) + 1
        count -= 1

    envp_add_inherited(@&e)
    vec_push<*u8>(@&e.ptrs, null)
    return e
