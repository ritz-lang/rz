# parse.ritz - rzsh command-line tokenizer, $-expansion and shell variables
#
# AGAST #2461: the shell used to split a line on whitespace and nothing else,
# so `$X`, `$?`, `>` and `|` reached the command as literal arguments. A line
# is now tokenized into words and operators, with expansion done while the
# word is built (so quoting decides what expands):
#
#   words      foo  'single quoted'  "double $QUOTED"  back\ slash
#   operators  |  >  >>  <     (';' separates items: see tokenize)
#   expansion  $NAME  ${NAME}  $?   (no field splitting, no globbing)
#   comments   # to end of line, at the start of a word
#
# An unquoted word that expands to nothing (`echo $UNSET`) is dropped, as in
# sh. Variable lookups fall back to the environment the shell was started
# with (g_environ, Linux only).
#
# AGAST #3459: tokens, variables and the child envp used to live in fixed
# global arrays (64 tokens, 32 variables, an 8 KB envp), so a long line
# overflowed, the 33rd variable failed and exports past 8 KB were silently
# left out of a child's environment. They are now a Vec<Token>, a
# Vec<ShellVar> and an Envp built in a String, with no size limit but memory.

import ritzlib.cstr
import ritzlib.gvec
import ritzlib.memory
import ritzlib.option
import ritzlib.ptr { ptr_read }
import ritzlib.string
import ritzlib.strview { StrView }

# ============================================================================
# Tokens
# ============================================================================

pub enum TokKind
    Word
    Pipe      # |
    Out       # >
    Append    # >>
    In        # <

# A token. For a Word, `word` is its text after quoting and expansion; the
# bytes are owned by the Tokens it came from. Operators have an empty word.
pub struct Token
    kind: TokKind
    word: StrView

# The result of tokenizing one list item.
pub struct Tokens
    toks: Vec<Token>
    words: Vec<String>   # owns the bytes every Word token's StrView borrows
    next: i64            # index just past the ';' that ended the item, or -1
    err: i32             # 0, or PARSE_UNTERMINATED

# tokenize() errors
pub const PARSE_UNTERMINATED: i32 = -1

# Exit status of the last command, for `$?`.
pub var g_last_status: i32 = 0

pub fn tokens_len(t: @Tokens) -> i64
    return t.toks.len

pub fn tokens_kind(t: @Tokens, idx: i64) -> TokKind
    let tok: Token = t.toks.get(idx)
    return tok.kind

pub fn tokens_is_word(t: @Tokens, idx: i64) -> bool
    return tokens_kind(t, idx) == TokKind.Word

# Word `idx` (empty for an operator). Valid until tokens_drop.
pub fn tokens_word(t: @Tokens, idx: i64) -> StrView
    let tok: Token = t.toks.get(idx)
    return tok.word

pub fn tokens_drop(t: @&Tokens)
    # A Vec's own drop frees its buffer, not the Strings in it; pop each one
    # so it is dropped at the end of this loop iteration.
    while t.words.len > 0
        let w: String = t.words.pop()
    t.words.deinit()
    t.toks.deinit()

# ============================================================================
# Character classes
# ============================================================================

fn is_blank(c: u8) -> bool
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

fn is_operator(c: u8) -> bool
    return c == '|' or c == ';' or c == '>' or c == '<'

pub fn is_name_start(c: u8) -> bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or c == '_'

pub fn is_name_char(c: u8) -> bool
    return is_name_start(c) or (c >= '0' and c <= '9')

# ============================================================================
# Lexer state
# ============================================================================

struct Lexer
    line: StrView
    i: i64
    word: String     # the word being built
    quoted: bool     # it had quotes or an escape, so it's kept even if empty
    out: Tokens

# The byte `off` past the cursor; '\0' past the end of the line.
fn at(lx: @Lexer, off: i64) -> u8
    let k: i64 = lx.i + off
    if k >= lx.line.len
        return '\0'
    return lx.line.get(k)

# The rest of the line from `off` past the cursor.
fn rest(lx: @Lexer, off: i64) -> StrView
    return lx.line.skip(lx.i + off)

fn emit(lx: @&Lexer, c: u8)
    (lx.word).push(c)

fn emit_str(lx: @&Lexer, s: StrView)
    (lx.word).push_str(s)

fn push_op(lx: @&Lexer, kind: TokKind, width: i64)
    lx.out.toks.push(Token { kind: kind, word: "" })
    lx.i += width

# Ends the current word: a token if it has text or was quoted, else nothing.
# The String moves into out.words, whose growth moves only the String header,
# never the bytes the token's StrView points at.
fn finish_word(lx: @&Lexer)
    if not lx.quoted and (lx.word).len() == 0
        return
    let view: StrView = (lx.word).as_view()
    lx.out.toks.push(Token { kind: TokKind.Word, word: view })
    # `lx` is a mutable borrow, so moving `lx.word` out of it is refused
    # (§13.2). ptr_read takes the value out of the field's memory; the raw
    # store then re-initialises the field without dropping what was moved.
    let slot: *String = @lx.word
    lx.out.words.push(ptr_read<String>(slot))
    *slot = string_new()
    lx.quoted = false

# ============================================================================
# $-expansion
# ============================================================================

# Length of the variable name at the start of `s` (0 if none).
fn name_len(s: StrView) -> i64
    if s.len == 0 or not is_name_start(s.get(0))
        return 0
    var n: i64 = 1
    while n < s.len and is_name_char(s.get(n))
        n += 1
    return n

fn emit_var(lx: @&Lexer, name: StrView)
    match var_lookup(name)
        Some(v) => emit_str(lx, v)
        None => pass

# lx is at '$'. Emits the expansion and moves past it.
fn expand_dollar(lx: @&Lexer)
    let c: u8 = at(lx, 1)
    if c == '?'
        (lx.word).push_i64(g_last_status as i64)
        lx.i += 2
        return
    if c == '{'
        let n: i64 = name_len(rest(lx, 2))
        if n == 0 or at(lx, 2 + n) != '}'
            # Not a well-formed ${NAME}: keep the '$' literally.
            emit(lx, '$')
            lx.i += 1
            return
        emit_var(lx, rest(lx, 2).take(n))
        lx.i += n + 3
        return
    let n: i64 = name_len(rest(lx, 1))
    if n == 0
        # A lone '$' (end of word, "$ ", "$1"...) stays literal.
        emit(lx, '$')
        lx.i += 1
        return
    emit_var(lx, rest(lx, 1).take(n))
    lx.i += n + 1

# ============================================================================
# Word pieces
# ============================================================================

# '...': everything literal. Returns false when the quote never closes.
fn lex_single(lx: @&Lexer) -> bool
    lx.quoted = true
    lx.i += 1
    while at(lx, 0) != '\''
        if at(lx, 0) == '\0'
            return false
        emit(lx, at(lx, 0))
        lx.i += 1
    lx.i += 1
    return true

fn escapable_in_double(c: u8) -> bool
    return c == '$' or c == '"' or c == '\\' or c == '`'

# "...": $ expands, \ escapes $ " \ `. Returns false when it never closes.
fn lex_double(lx: @&Lexer) -> bool
    lx.quoted = true
    lx.i += 1
    while at(lx, 0) != '"'
        let d: u8 = at(lx, 0)
        if d == '\0'
            return false
        if d == '\\' and escapable_in_double(at(lx, 1))
            emit(lx, at(lx, 1))
            lx.i += 2
        else if d == '$'
            expand_dollar(lx)
        else
            emit(lx, d)
            lx.i += 1
    lx.i += 1
    return true

# \x outside quotes: x literally.
fn lex_escape(lx: @&Lexer)
    lx.quoted = true
    if at(lx, 1) == '\0'
        lx.i += 1
        return
    emit(lx, at(lx, 1))
    lx.i += 2

# A word runs until a blank or operator outside quotes. Returns false on an
# unterminated quote.
fn lex_word(lx: @&Lexer) -> bool
    while at(lx, 0) != '\0' and not is_blank(at(lx, 0)) and not is_operator(at(lx, 0))
        let w: u8 = at(lx, 0)
        if w == '\''
            if not lex_single(lx)
                return false
        else if w == '"'
            if not lex_double(lx)
                return false
        else if w == '\\'
            lex_escape(lx)
        else if w == '$'
            expand_dollar(lx)
        else
            emit(lx, w)
            lx.i += 1
    finish_word(lx)
    return true

# An operator at lx (| < > >>): pushes it and returns true, else false.
fn lex_operator(lx: @&Lexer) -> bool
    let c: u8 = at(lx, 0)
    if c == '|'
        push_op(lx, TokKind.Pipe, 1)
    else if c == '<'
        push_op(lx, TokKind.In, 1)
    else if c == '>' and at(lx, 1) == '>'
        push_op(lx, TokKind.Append, 2)
    else if c == '>'
        push_op(lx, TokKind.Out, 1)
    else
        return false
    return true

# ============================================================================
# Tokenizer
# ============================================================================

# Splits one list item of `line`, from `pos` up to the next unquoted ';' or
# the end. Items are tokenized one at a time, right before they run, so
# `export X=5 ; echo $X` and `false ; echo $?` see the earlier item's effect.
# The caller owns the result and frees it with tokens_drop.
pub fn tokenize(line: StrView, pos: i64) -> Tokens
    var lx: Lexer
    lx.line = line
    lx.i = pos
    lx.word = string_new()
    lx.quoted = false
    lx.out = Tokens { toks: vec_new<Token>(), words: vec_new<String>(), next: -1, err: 0 }

    while true
        while is_blank(at(@lx, 0))
            lx.i += 1
        let c: u8 = at(@lx, 0)
        if c == '\0' or c == '#'   # end, or a '#' comment
            break
        if c == ';'
            lx.out.next = lx.i + 1
            break
        if not lex_operator(@&lx) and not lex_word(@&lx)
            lx.out.err = PARSE_UNTERMINATED
            break

    return lx.out

# ============================================================================
# Shell variables
# ============================================================================

pub struct ShellVar
    name: String
    value: String
    exported: bool
    hidden: bool     # unset tombstone: hides an inherited environ entry

var g_vars: *Vec<ShellVar> = null

# A Vec (and the ShellVar elements it holds) has Drop, so it cannot live at
# module level (§13.6: a module-level value is never dropped). The table is a
# heap Vec allocated once; the global is the pointer to it.
fn vars_vec() -> *Vec<ShellVar>
    if g_vars == null
        let p: *Vec<ShellVar> = malloc(sizeof(Vec<ShellVar>)) as *Vec<ShellVar>
        *p = vec_new<ShellVar>()
        g_vars = p
    g_vars

# The environment rzsh was started with (NULL-terminated "K=V" array), or
# null. Set once by main on Linux; harland has no environment.
pub var g_environ: **u8 = null

fn var_at(idx: i64) -> *ShellVar
    return vars_vec().get_ptr(idx)

# True when `name` is a valid shell variable name.
pub fn is_valid_name(name: StrView) -> bool
    return name.len > 0 and name_len(name) >= name.len

fn var_find(name: StrView) -> i64
    var idx: i64 = 0
    while idx < vars_vec().len
        let v: *ShellVar = var_at(idx)
        if (v.name).eq(name)
            return idx
        idx += 1
    return -1

# Entry `k` of g_environ ("K=V"), or None past its end. The environ array is
# C's, so this is where its NUL-terminated strings become StrViews.
fn environ_at(k: i64) -> Option<StrView>
    if g_environ == null or *(g_environ + k) == null
        return None
    return Some(strview_from_cstr(*(g_environ + k)))

# The value part of the environ entry for `name`, or None.
fn env_find(name: StrView) -> Option<StrView>
    var k: i64 = 0
    while true
        match environ_at(k)
            Some(e) =>
                if e.len > name.len and e.take(name.len).eq(name) and e.get(name.len) == '='
                    return Some(e.skip(name.len + 1))
            None => return None
        k += 1

fn var_free(v: *ShellVar)
    (v.name).deinit()
    (v.value).deinit()

pub fn vars_clear()
    if g_vars == null
        return
    var idx: i64 = 0
    while idx < g_vars.len
        var_free(var_at(idx))
        idx += 1
    g_vars.deinit()

# The slot for `name`. A new one is appended, exported when the name is
# inherited from the environment (an inherited variable stays exported).
fn var_slot(name: StrView) -> *ShellVar
    let idx: i64 = var_find(name)
    if idx >= 0
        return var_at(idx)
    let v: ShellVar = ShellVar {
        name: string_from(name), value: string_new(),
        exported: env_find(name).is_some(), hidden: false
    }
    vars_vec().push(v)
    return var_at(vars_vec().len - 1)

fn var_store(v: *ShellVar, value: StrView)
    (v.value).clear()
    (v.value).push_str(value)

# Sets `name` to `value`. export != 0 marks it exported; a variable inherited
# from the environment stays exported. Returns 0, or -1 for a bad name.
pub fn var_set(name: StrView, value: StrView, export: i32) -> i32
    if not is_valid_name(name)
        return -1
    let v: *ShellVar = var_slot(name)
    v.hidden = false
    var_store(v, value)
    if export != 0
        v.exported = true
    return 0

# Marks an existing variable exported, importing it from the environment
# first if needed. Returns 0, or -1 if it isn't set anywhere.
pub fn var_export(name: StrView) -> i32
    let idx: i64 = var_find(name)
    if idx >= 0
        let v: *ShellVar = var_at(idx)
        if v.hidden
            return -1
        v.exported = true
        return 0
    match env_find(name)
        Some(e) => var_set(name, e, 1)
        None => -1

pub fn var_unset(name: StrView)
    let idx: i64 = var_find(name)
    let inherited: bool = env_find(name).is_some()
    if idx < 0 and not inherited
        return
    # An inherited variable keeps a hidden slot as a tombstone, to hide the
    # environ entry from lookups and from children.
    let v: *ShellVar = var_slot(name)
    v.hidden = true
    v.exported = false
    (v.value).clear()

# The value of `name`, or None when unset. Shell table first, then environ.
# Valid until the variable is next set or unset.
pub fn var_lookup(name: StrView) -> Option<StrView>
    let idx: i64 = var_find(name)
    if idx < 0
        return env_find(name)
    let v: *ShellVar = var_at(idx)
    if v.hidden
        return None
    return Some((v.value).as_view())

# Index of '=' when `word` is an assignment (NAME=...), else -1.
pub fn assignment_pos(word: StrView) -> i64
    let i: i64 = word.find_byte('=')
    if i >= word.len or not is_valid_name(word.take(i))
        return -1
    return i

# Table walk for `export` with no arguments: slots are 0..vars_count().
pub fn vars_count() -> i64
    return vars_vec().len

# The name of slot `idx` if it holds an exported variable, else None.
pub fn var_exported_name(idx: i64) -> Option<StrView>
    if idx < 0 or idx >= vars_vec().len
        return None
    let v: *ShellVar = var_at(idx)
    if v.hidden or not v.exported
        return None
    return Some((v.name).as_view())

pub fn var_value(idx: i64) -> StrView
    let v: *ShellVar = var_at(idx)
    return (v.value).as_view()

# ============================================================================
# Child environment
# ============================================================================

# A child's envp: `ptrs` is the NULL-terminated array to pass to exec. The
# shell's own exported entries live in `buf` ("K=V\0K=V\0..."); inherited
# entries point into g_environ.
pub struct Envp
    buf: String
    ptrs: Vec<*u8>

# Number of entries, excluding the NULL.
pub fn envp_len(e: @Envp) -> i64
    return e.ptrs.len - 1

pub fn envp_ptr(e: @Envp) -> **u8
    return e.ptrs.data

pub fn envp_drop(e: @&Envp)
    (e.buf).deinit()
    e.ptrs.deinit()

# Inherited entries the shell table doesn't shadow (a tombstone shadows too).
fn envp_add_inherited(e: @&Envp)
    var k: i64 = 0
    while true
        match environ_at(k)
            Some(ent) =>
                if var_find(ent.take(ent.find_byte('='))) < 0
                    e.ptrs.push(ent.ptr)
            None => return
        k += 1

# Builds the envp for a child: exported shell variables, then inherited
# entries. The caller frees it with envp_drop.
pub fn vars_build_envp() -> Envp
    var e: Envp = Envp { buf: string_new(), ptrs: vec_new<*u8>() }
    # Pass 1 fills buf; its buffer may move as it grows, so the pointers to
    # the entries are taken in pass 2, once it's complete.
    var count: i64 = 0
    var idx: i64 = 0
    while idx < vars_vec().len
        let v: *ShellVar = var_at(idx)
        if v.exported and not v.hidden
            (e.buf).push_string(@v.name)
            (e.buf).push('=')
            (e.buf).push_string(@v.value)
            (e.buf).push('\0')
            count += 1
        idx += 1

    var p: *u8 = (e.buf).as_ptr()
    idx = 0
    while count > 0
        let v: *ShellVar = var_at(idx)
        if v.exported and not v.hidden
            e.ptrs.push(p)
            p = p + (v.name).len() + (v.value).len() + 2   # "K=V\0"
            count -= 1
        idx += 1

    envp_add_inherited(@&e)
    e.ptrs.push(null)
    return e
