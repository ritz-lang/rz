# shell.ritz - rzsh command execution (AGAST #2461)
#
# run_line() takes one input line through parse.tokenize() and runs it:
#
#   list       pipeline ; pipeline ; ...
#   pipeline   command | command | ...         (Linux only)
#   command    [NAME=VALUE...] | word... [< file] [> file] [>> file]
#
# Builtins run in the shell process (so `cd` and `export` stick); a
# redirection around a builtin swaps fds 0/1 for its duration. Each stage of
# a pipeline runs in a forked child. `$?` is the last command's status.

import common {
    puts, println, putchar,
    cmd_help, cmd_exit, cmd_pid, cmd_echo, cmd_clear
}

import parse {
    TokKind, Tokens, tokenize, tokens_len, tokens_kind, tokens_word,
    tokens_is_word, tokens_drop, g_last_status, PARSE_UNTERMINATED,
    var_set, var_lookup, var_unset, var_export, assignment_pos, is_valid_name,
    vars_count, var_exported_name, var_value,
    Envp, vars_build_envp, envp_ptr, envp_drop
}

import os {
    os_readdir, os_default_ls_path, os_default_path, os_spawn_search,
    os_has_fd_control, os_fork, os_pipe, os_dup, os_dup2, os_close,
    os_open_write, os_open_read, os_wait, os_chdir, os_getcwd,
    os_disable_raw_mode, os_tty_suspend, os_tty_resume, os_tty_window_probe
}

import ritzlib.sys { sys_write, sys_exit }
import ritzlib.gvec
import ritzlib.option
import ritzlib.string
import ritzlib.span { Span, span_from_vec }
import ritzlib.strview { StrView }

# ============================================================================
# stderr
# ============================================================================

# Raw write(2): ritzlib.fd does not build for the harland target (no Stat).
fn eputs(s: StrView)
    sys_write(2, s.ptr, s.len)

fn eputs3(a: StrView, b: StrView, c: StrView)
    eputs(a)
    eputs(b)
    eputs(c)

# ============================================================================
# Builtins
# ============================================================================
# Each takes the command's words; args[0] is the builtin's name.

fn cmd_cd(args: Span<StrView>) -> i32
    if args.len > 2
        eputs("rzsh: cd: too many arguments\n")
        return 1
    var dir: StrView = "/"
    if args.len == 2
        dir = args[1]
    else
        dir = var_lookup("HOME").unwrap_or("/")
    if os_chdir(dir) != 0
        eputs3("rzsh: cd: ", dir, ": cannot change directory\n")
        return 1
    return 0

fn cmd_pwd() -> i32
    var buf: [4096]u8
    match os_getcwd(@buf)
        Some(cwd) => println(cwd)
        None =>
            eputs("rzsh: pwd: cannot get working directory\n")
            return 1
    return 0

fn cmd_export(args: Span<StrView>) -> i32
    if args.len == 1
        var idx: i64 = 0
        while idx < vars_count()
            match var_exported_name(idx)
                Some(name) =>
                    puts("export ")
                    puts(name)
                    puts("=")
                    println(var_value(idx))
                None => pass
            idx = idx + 1
        return 0

    var status: i32 = 0
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]
        let eq: i64 = assignment_pos(arg)
        if eq >= 0
            if var_set(arg.take(eq), arg.skip(eq + 1), 1) != 0
                eputs3("rzsh: export: cannot set ", arg, "\n")
                status = 1
        else if is_valid_name(arg)
            var_export(arg)  # exporting an unset name is a no-op
        else
            eputs3("rzsh: export: not a valid name: ", arg, "\n")
            status = 1
        i = i + 1
    return status

fn cmd_unset(args: Span<StrView>) -> i32
    var i: i64 = 1
    while i < args.len
        var_unset(args[i])
        i = i + 1
    return 0

pub fn cmd_ls(args: Span<StrView>) -> i32
    var path: StrView = os_default_ls_path()
    if args.len > 1
        path = args[1]

    var names: String = string_new()
    if not os_readdir(path, @&names)
        eputs3("ls: cannot access '", path, "'\n")
        return 1

    # names is "a\0b\0...": one entry per NUL.
    var rest: StrView = names.as_view()
    while rest.len > 0
        let end: i64 = rest.find_byte(0)
        let entry: StrView = rest.take(end)
        if entry.len > 0
            puts("  ")
            println(entry)
        rest = rest.skip(end + 1)

    return 0

fn exec_external(args: Span<StrView>) -> i32
    var envp: Envp = vars_build_envp()
    let search: StrView = var_lookup("PATH").unwrap_or(os_default_path())
    let was_raw: bool = os_tty_suspend()
    if var_lookup("RZSH_DEBUG_TTY_WINDOW").is_some()
        os_tty_window_probe()
    let status: i32 = os_spawn_search(args, search, envp_ptr(@envp))
    os_tty_resume(was_raw)
    return status

# The builtin `ls` takes only `ls [DIR]`; with options, the system's ls runs.
fn has_option(args: Span<StrView>) -> bool
    var i: i64 = 1
    while i < args.len
        if args[i].starts_with("-")
            return true
        i = i + 1
    return false

# Runs the command `args` (args[0] names it) as a builtin or external command.
fn dispatch(args: Span<StrView>) -> i32
    let cmd: StrView = args[0]
    if cmd.eq("cd")
        return cmd_cd(args)
    if cmd.eq("pwd")
        return cmd_pwd()
    if cmd.eq("export")
        return cmd_export(args)
    if cmd.eq("unset")
        return cmd_unset(args)
    if cmd.eq("help")
        return cmd_help()
    if cmd.eq("exit")
        os_disable_raw_mode()
        return cmd_exit(args)
    if cmd.eq("pid")
        return cmd_pid()
    if cmd.eq("echo")
        return cmd_echo(args)
    if cmd.eq("ls") and not has_option(args)
        return cmd_ls(args)
    if cmd.eq("clear")
        return cmd_clear()
    return exec_external(args)

# ============================================================================
# Simple command: words + redirections over tokens [start, end)
# ============================================================================

# argv is built per command, so a command takes any number of words (it was a
# global [32]*u8: "too many arguments" past 31, AGAST #3529).
fn run_command(tk: @Tokens, start: i64, end: i64) -> i32
    var words: Vec<StrView> = vec_new<StrView>()
    let status: i32 = run_command_with(tk, start, end, @&words)
    return status

# Collects the words of [start, end) into `words` (empty on entry) and runs them.
fn run_command_with(tk: @Tokens, start: i64, end: i64, words: @&Vec<StrView>) -> i32
    var out_path: Option<StrView> = None
    var out_append: bool = false
    var in_path: Option<StrView> = None

    var t: i64 = start
    while t < end
        let kind: TokKind = tokens_kind(tk, t)
        if kind == TokKind.Word
            if not words.push(tokens_word(tk, t))
                eputs("rzsh: out of memory\n")
                return 1
        else
            if t + 1 >= end or not tokens_is_word(tk, t + 1)
                eputs("rzsh: syntax error: redirection needs a file name\n")
                return 2
            if kind == TokKind.In
                in_path = Some(tokens_word(tk, t + 1))
            else
                out_path = Some(tokens_word(tk, t + 1))
                out_append = kind == TokKind.Append
            t = t + 1
        t = t + 1

    let args: Span<StrView> = span_from_vec(words)
    let argc: i64 = args.len

    # NAME=VALUE ... with no command sets shell variables.
    if argc > 0 and assignment_pos(args[0]) >= 0
        var all: bool = true
        var i: i64 = 0
        while i < argc
            if assignment_pos(args[i]) < 0
                all = false
            i = i + 1
        if all
            i = 0
            while i < argc
                let a: StrView = args[i]
                let eq: i64 = assignment_pos(a)
                if var_set(a.take(eq), a.skip(eq + 1), 0) != 0
                    eputs3("rzsh: cannot set ", a, "\n")
                    return 1
                i = i + 1
            return 0

    if out_path.is_none() and in_path.is_none()
        if argc == 0
            return 0
        return dispatch(args)

    if not os_has_fd_control()
        eputs("rzsh: redirection is not supported on this system\n")
        return 2

    var saved_in: i32 = -1
    var saved_out: i32 = -1
    match in_path
        Some(p) =>
            let fd: i32 = os_open_read(p)
            if fd < 0
                eputs3("rzsh: cannot open ", p, "\n")
                return 1
            saved_in = os_dup(0)
            os_dup2(fd, 0)
            os_close(fd)
        None => pass
    match out_path
        Some(p) =>
            let fd: i32 = os_open_write(p, out_append)
            if fd < 0
                eputs3("rzsh: cannot create ", p, "\n")
                if saved_in >= 0
                    os_dup2(saved_in, 0)
                    os_close(saved_in)
                return 1
            saved_out = os_dup(1)
            os_dup2(fd, 1)
            os_close(fd)
        None => pass

    var status: i32 = 0
    if argc > 0
        status = dispatch(args)

    if saved_out >= 0
        os_dup2(saved_out, 1)
        os_close(saved_out)
    if saved_in >= 0
        os_dup2(saved_in, 0)
        os_close(saved_in)
    return status

# ============================================================================
# Pipeline over tokens [start, end)
# ============================================================================

# Stage bounds and pids are Vecs, so a pipeline takes any number of stages
# (they were [17]i64 / [16]i32: "pipeline too long" past 16, AGAST #3529).
fn run_pipeline(tk: @Tokens, start: i64, end: i64) -> i32
    var bounds: Vec<i64> = vec_new<i64>()
    var pids: Vec<i32> = vec_new<i32>()
    let status: i32 = run_pipeline_with(tk, start, end, @&bounds, @&pids)
    return status

# `bounds` and `pids` are empty on entry. Stage s is tokens
# [bounds[s], bounds[s + 1] - 1); bounds ends one past `end`.
fn run_pipeline_with(tk: @Tokens, start: i64, end: i64, bounds: @&Vec<i64>, pids: @&Vec<i32>) -> i32
    # Stage boundaries; an empty stage is a syntax error.
    if not bounds.push(start)
        eputs("rzsh: out of memory\n")
        return 1
    var t: i64 = start
    while t <= end
        if t == end or tokens_kind(tk, t) == TokKind.Pipe
            if t == bounds.last()
                eputs("rzsh: syntax error near '|'\n")
                return 2
            if not bounds.push(t + 1)
                eputs("rzsh: out of memory\n")
                return 1
        t = t + 1
    let stages: i64 = bounds.len - 1

    if stages == 1
        return run_command(tk, start, end)

    if not os_has_fd_control()
        eputs("rzsh: pipes are not supported on this system\n")
        return 2

    var prev_read: i32 = -1
    var s: i64 = 0
    while s < stages
        let last: bool = s == stages - 1
        var fds: [2]i32
        if not last
            if os_pipe(@fds[0]) < 0
                eputs("rzsh: pipe failed\n")
                return 1
        let pid: i32 = os_fork()
        if pid == 0
            if prev_read >= 0
                os_dup2(prev_read, 0)
                os_close(prev_read)
            if not last
                os_dup2(fds[1], 1)
                os_close(fds[1])
                os_close(fds[0])
            sys_exit(run_command(tk, bounds.get(s), bounds.get(s + 1) - 1))
        if prev_read >= 0
            os_close(prev_read)
            prev_read = -1
        if not last
            os_close(fds[1])
            prev_read = fds[0]
        pids.push(pid)  # out of memory: that child goes unwaited
        s = s + 1

    var status: i32 = 0
    var k: i64 = 0
    while k < pids.len
        let pid: i32 = pids.get(k)
        if pid > 0
            status = os_wait(pid)
        else
            status = 1
        k = k + 1
    return status

# ============================================================================
# Entry point
# ============================================================================

# Runs one input line; returns (and records for `$?`) the last status.
pub fn run_line(line: StrView) -> i32
    var pos: i64 = 0
    while pos >= 0
        var tk: Tokens = tokenize(line, pos)
        if tk.err == PARSE_UNTERMINATED
            eputs("rzsh: syntax error: unterminated quote\n")
            tokens_drop(@&tk)
            g_last_status = 2
            return 2
        let n: i64 = tokens_len(@tk)
        if n > 0
            g_last_status = run_pipeline(@tk, 0, n)
        pos = tk.next
        tokens_drop(@&tk)
    return g_last_status
