# shell.ritz - rzsh command execution (AGAST #2461)
#
# run_line() takes one input line through parse.tokenize() and runs it:
#
#   list       pipeline ; pipeline ; ...
#   pipeline   command | command | ...         (Linux only)
#   command    [NAME=VALUE...] | word... [< file] [> file] [>> file]
#
# Builtins run in the shell process (so `cd` and `export` stick); a
# redirection around a builtin swaps fds 0/1 for its duration. Each stage of
# a pipeline runs in a forked child. `$?` is the last command's status.

import common {
    puts, println, putchar, print_int,
    cmd_help, cmd_exit, cmd_pid, cmd_echo, cmd_clear
}

import parse {
    TokKind, Tokens, tokenize, tokens_len, tokens_kind, tokens_word,
    tokens_is_word, tokens_drop, g_last_status, PARSE_UNTERMINATED,
    var_set, var_lookup, var_unset, var_export, assignment_pos, is_valid_name,
    vars_count, var_exported_name, var_value,
    Envp, vars_build_envp, envp_ptr, envp_drop
}

import os {
    os_readdir, os_default_ls_path, os_default_path, os_spawn_search,
    os_has_fd_control, os_fork, os_pipe, os_dup, os_dup2, os_close,
    os_open_write, os_open_read, os_wait, os_chdir, os_getcwd,
    os_disable_raw_mode, os_tty_suspend, os_tty_resume, os_tty_window_probe
}

import ritzlib.sys { sys_write, sys_exit }
import ritzlib.str { strlen, strcmp }
import ritzlib.gvec

# ============================================================================
# stderr
# ============================================================================

fn eputs(s: *u8)
    sys_write(2, s, strlen(s))

fn eputs3(a: *u8, b: *u8, c: *u8)
    eputs(a)
    eputs(b)
    eputs(c)

# ============================================================================
# Builtins
# ============================================================================
# Each takes the command's words as argv[0..argc]; argv[argc] is null.

fn cmd_cd(argc: i32, argv: **u8) -> i32
    var dir: *u8 = null
    if argc > 2
        eputs(c"rzsh: cd: too many arguments\n")
        return 1
    if argc == 2
        dir = *(argv + 1)
    else
        dir = var_lookup(c"HOME", 4)
        if dir == null
            dir = c"/"
    if os_chdir(dir) != 0
        eputs3(c"rzsh: cd: ", dir, c": cannot change directory\n")
        return 1
    return 0

fn cmd_pwd() -> i32
    var buf: [4096]u8
    if os_getcwd(@buf[0], 4096) < 0
        eputs(c"rzsh: pwd: cannot get working directory\n")
        return 1
    println(@buf[0])
    return 0

fn cmd_export(argc: i32, argv: **u8) -> i32
    if argc == 1
        var idx: i64 = 0
        while idx < vars_count()
            let name: *u8 = var_exported_name(idx)
            if name != null
                puts(c"export ")
                puts(name)
                puts(c"=")
                println(var_value(idx))
            idx = idx + 1
        return 0

    var status: i32 = 0
    var i: i32 = 1
    while i < argc
        let arg: *u8 = *(argv + i)
        let eq: i64 = assignment_pos(arg)
        if eq >= 0
            if var_set(arg, eq, arg + eq + 1, strlen(arg + eq + 1), 1) != 0
                eputs3(c"rzsh: export: cannot set ", arg, c"\n")
                status = 1
        else if is_valid_name(arg, strlen(arg))
            var_export(arg, strlen(arg))  # exporting an unset name is a no-op
        else
            eputs3(c"rzsh: export: not a valid name: ", arg, c"\n")
            status = 1
        i = i + 1
    return status

fn cmd_unset(argc: i32, argv: **u8) -> i32
    var i: i32 = 1
    while i < argc
        var_unset(*(argv + i), strlen(*(argv + i)))
        i = i + 1
    return 0

pub fn cmd_ls(argc: i32, argv: **u8) -> i32
    var path: *u8 = os_default_ls_path()
    if argc > 1
        path = *(argv + 1)

    var buf: [4096]u8
    let n: i64 = os_readdir(path, @buf[0], 4096)

    if n < 0
        eputs3(c"ls: cannot access '", path, c"'\n")
        return 1

    var pos: i64 = 0
    while pos < n
        let entry: *u8 = @buf[0] + pos
        let entry_len: i64 = strlen(entry)
        if entry_len > 0
            puts(c"  ")
            println(entry)
        pos = pos + entry_len + 1

    return 0

fn exec_external(argv: **u8) -> i32
    var envp: Envp = vars_build_envp()
    var search: *u8 = var_lookup(c"PATH", 4)
    if search == null
        search = os_default_path()
    let was_raw: bool = os_tty_suspend()
    if var_lookup(c"RZSH_DEBUG_TTY_WINDOW", 21) != null
        os_tty_window_probe()
    let status: i32 = os_spawn_search(*argv, search, argv, envp_ptr(@envp))
    os_tty_resume(was_raw)
    return status

# The builtin `ls` takes only `ls [DIR]`; with options, the system's ls runs.
fn has_option(argc: i32, argv: **u8) -> bool
    var i: i32 = 1
    while i < argc
        if **(argv + i) == 45
            return true
        i = i + 1
    return false

# Runs argv[0..argc] (argv[argc] null) as a builtin or external command.
fn dispatch(argc: i32, argv: **u8) -> i32
    let cmd: *u8 = *argv
    if strcmp(cmd, c"cd") == 0
        return cmd_cd(argc, argv)
    if strcmp(cmd, c"pwd") == 0
        return cmd_pwd()
    if strcmp(cmd, c"export") == 0
        return cmd_export(argc, argv)
    if strcmp(cmd, c"unset") == 0
        return cmd_unset(argc, argv)
    if strcmp(cmd, c"help") == 0
        return cmd_help()
    if strcmp(cmd, c"exit") == 0
        os_disable_raw_mode()
        return cmd_exit(argc, argv)
    if strcmp(cmd, c"pid") == 0
        return cmd_pid()
    if strcmp(cmd, c"echo") == 0
        return cmd_echo(argc, argv)
    if strcmp(cmd, c"ls") == 0 and not has_option(argc, argv)
        return cmd_ls(argc, argv)
    if strcmp(cmd, c"clear") == 0
        return cmd_clear()
    return exec_external(argv)

# ============================================================================
# Simple command: words + redirections over tokens [start, end)
# ============================================================================

# argv is built per command, so a command takes any number of words (it was a
# global [32]*u8: "too many arguments" past 31, AGAST #3529).
fn run_command(tk: @Tokens, start: i64, end: i64) -> i32
    var argv: Vec<*u8> = vec_new<*u8>()
    let status: i32 = run_command_with(tk, start, end, @&argv)
    return status

# Collects the words of [start, end) into `words` (empty on entry) and runs them.
fn run_command_with(tk: @Tokens, start: i64, end: i64, words: @&Vec<*u8>) -> i32
    var out_path: *u8 = null
    var out_append: bool = false
    var in_path: *u8 = null

    var t: i64 = start
    while t < end
        let kind: TokKind = tokens_kind(tk, t)
        if kind == TokKind.Word
            if not words.push(tokens_word(tk, t))
                eputs(c"rzsh: out of memory\n")
                return 1
        else
            if t + 1 >= end or not tokens_is_word(tk, t + 1)
                eputs(c"rzsh: syntax error: redirection needs a file name\n")
                return 2
            if kind == TokKind.In
                in_path = tokens_word(tk, t + 1)
            else
                out_path = tokens_word(tk, t + 1)
                out_append = kind == TokKind.Append
            t = t + 1
        t = t + 1

    let argc: i32 = words.len as i32
    if not words.push(null)
        eputs(c"rzsh: out of memory\n")
        return 1
    let argv: **u8 = words.data

    # NAME=VALUE ... with no command sets shell variables.
    if argc > 0 and assignment_pos(*argv) >= 0
        var all: bool = true
        var i: i32 = 0
        while i < argc
            if assignment_pos(*(argv + i)) < 0
                all = false
            i = i + 1
        if all
            i = 0
            while i < argc
                let a: *u8 = *(argv + i)
                let eq: i64 = assignment_pos(a)
                if var_set(a, eq, a + eq + 1, strlen(a + eq + 1), 0) != 0
                    eputs3(c"rzsh: cannot set ", a, c"\n")
                    return 1
                i = i + 1
            return 0

    if out_path == null and in_path == null
        if argc == 0
            return 0
        return dispatch(argc, argv)

    if not os_has_fd_control()
        eputs(c"rzsh: redirection is not supported on this system\n")
        return 2

    var saved_in: i32 = -1
    var saved_out: i32 = -1
    if in_path != null
        let fd: i32 = os_open_read(in_path)
        if fd < 0
            eputs3(c"rzsh: cannot open ", in_path, c"\n")
            return 1
        saved_in = os_dup(0)
        os_dup2(fd, 0)
        os_close(fd)
    if out_path != null
        let fd: i32 = os_open_write(out_path, out_append)
        if fd < 0
            eputs3(c"rzsh: cannot create ", out_path, c"\n")
            if saved_in >= 0
                os_dup2(saved_in, 0)
                os_close(saved_in)
            return 1
        saved_out = os_dup(1)
        os_dup2(fd, 1)
        os_close(fd)

    var status: i32 = 0
    if argc > 0
        status = dispatch(argc, argv)

    if saved_out >= 0
        os_dup2(saved_out, 1)
        os_close(saved_out)
    if saved_in >= 0
        os_dup2(saved_in, 0)
        os_close(saved_in)
    return status

# ============================================================================
# Pipeline over tokens [start, end)
# ============================================================================

# Stage bounds and pids are Vecs, so a pipeline takes any number of stages
# (they were [17]i64 / [16]i32: "pipeline too long" past 16, AGAST #3529).
fn run_pipeline(tk: @Tokens, start: i64, end: i64) -> i32
    var bounds: Vec<i64> = vec_new<i64>()
    var pids: Vec<i32> = vec_new<i32>()
    let status: i32 = run_pipeline_with(tk, start, end, @&bounds, @&pids)
    return status

# `bounds` and `pids` are empty on entry. Stage s is tokens
# [bounds[s], bounds[s + 1] - 1); bounds ends one past `end`.
fn run_pipeline_with(tk: @Tokens, start: i64, end: i64, bounds: @&Vec<i64>, pids: @&Vec<i32>) -> i32
    # Stage boundaries; an empty stage is a syntax error.
    if not bounds.push(start)
        eputs(c"rzsh: out of memory\n")
        return 1
    var t: i64 = start
    while t <= end
        if t == end or tokens_kind(tk, t) == TokKind.Pipe
            if t == bounds.last()
                eputs(c"rzsh: syntax error near '|'\n")
                return 2
            if not bounds.push(t + 1)
                eputs(c"rzsh: out of memory\n")
                return 1
        t = t + 1
    let stages: i64 = bounds.len - 1

    if stages == 1
        return run_command(tk, start, end)

    if not os_has_fd_control()
        eputs(c"rzsh: pipes are not supported on this system\n")
        return 2

    var prev_read: i32 = -1
    var s: i64 = 0
    while s < stages
        let last: bool = s == stages - 1
        var fds: [2]i32
        if not last
            if os_pipe(@fds[0]) < 0
                eputs(c"rzsh: pipe failed\n")
                return 1
        let pid: i32 = os_fork()
        if pid == 0
            if prev_read >= 0
                os_dup2(prev_read, 0)
                os_close(prev_read)
            if not last
                os_dup2(fds[1], 1)
                os_close(fds[1])
                os_close(fds[0])
            sys_exit(run_command(tk, bounds.get(s), bounds.get(s + 1) - 1))
        if prev_read >= 0
            os_close(prev_read)
            prev_read = -1
        if not last
            os_close(fds[1])
            prev_read = fds[0]
        pids.push(pid)  # out of memory: that child goes unwaited
        s = s + 1

    var status: i32 = 0
    var k: i64 = 0
    while k < pids.len
        let pid: i32 = pids.get(k)
        if pid > 0
            status = os_wait(pid)
        else
            status = 1
        k = k + 1
    return status

# ============================================================================
# Entry point
# ============================================================================

# Runs one input line; returns (and records for `$?`) the last status.
pub fn run_line(line: *u8) -> i32
    var pos: i64 = 0
    while pos >= 0
        var tk: Tokens = tokenize(line, pos)
        if tk.err == PARSE_UNTERMINATED
            eputs(c"rzsh: syntax error: unterminated quote\n")
            tokens_drop(@&tk)
            g_last_status = 2
            return 2
        let n: i64 = tokens_len(@tk)
        if n > 0
            g_last_status = run_pipeline(@tk, 0, n)
        pos = tk.next
        tokens_drop(@&tk)
    return g_last_status
