# shell.ritz - rzsh command execution (AGAST #2461)
#
# run_line() takes one input line through parse.tokenize() and runs it:
#
#   list       pipeline ; pipeline ; ...     (an item ended by `&` instead
#                                            of `;` runs in the background)
#   pipeline   command | command | ...         (Linux only)
#   command    [NAME=VALUE...] | word... [< file] [> file] [>> file]
#
# Builtins run in the shell process (so `cd` and `export` stick); a
# redirection around a builtin swaps fds 0/1 for its duration. Each stage of
# a pipeline runs in a forked child. `$?` is the last command's status.

import common {
    puts, putchar,
    cmd_help, cmd_exit, cmd_pid, cmd_echo, cmd_clear
}

import parse {
    TokKind, Tokens, tokenize, tokens_len, tokens_kind, tokens_word,
    tokens_is_word, tokens_drop, g_last_status, PARSE_UNTERMINATED, PARSE_AND_LIST,
    var_set, var_lookup, var_unset, var_export, assignment_pos, is_valid_name,
    vars_count, var_exported_name, var_value,
    Envp, vars_build_envp, envp_ptr, envp_drop
}

import os {
    os_directory_names, os_stdout_is_terminal, os_default_path, os_spawn_search, os_spawn_start,
    SpawnError, spawn_error_status,
    os_has_fd_control, os_fork, os_pipe, os_dup, os_dup2, os_close,
    os_open_write, os_open_read, os_wait, os_chdir, os_getcwd,
    os_disable_raw_mode, os_tty_suspend, os_tty_resume, os_tty_window_probe
}

import ritzlib.sys { sys_exit }
import rawio { err_str }
import ritzlib.io { println }
import ritzlib.gvec
import ritzlib.option
import ritzlib.cmp { Ordering }
import ritzlib.string
import ritzlib.span { Span, span_from_vec }
import ritzlib.strview { StrView }

# ============================================================================
# stderr
# ============================================================================

fn eputs3(a: StrView, b: StrView, c: StrView)
    err_str(a)
    err_str(b)
    err_str(c)

# ============================================================================
# Builtins
# ============================================================================
# Each takes the command's words; args[0] is the builtin's name.

fn cmd_cd(args: Span<StrView>) -> i32
    if args.len > 2
        err_str("rzsh: cd: too many arguments\n")
        return 1
    var dir: StrView = "/"
    if args.len == 2
        dir = args[1]
    else
        # A typed default: ritz1 emits a Span-typed literal for unwrap_or("/").
        let root: StrView = "/"
        dir = var_lookup("HOME").unwrap_or(root)
    if os_chdir(dir) != 0
        eputs3("rzsh: cd: ", dir, ": cannot change directory\n")
        return 1
    return 0

fn cmd_pwd() -> i32
    var buf: [4096]u8
    match os_getcwd(@buf)
        Some(cwd) => println(cwd)
        None =>
            err_str("rzsh: pwd: cannot get working directory\n")
            return 1
    return 0

fn cmd_export(args: Span<StrView>) -> i32
    if args.len == 1
        var idx: i64 = 0
        while idx < vars_count()
            match var_exported_name(idx)
                Some(name) =>
                    puts("export ")
                    puts(name)
                    puts("=")
                    println(var_value(idx))
                None => pass
            idx = idx + 1
        return 0

    var status: i32 = 0
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]
        let eq: i64 = assignment_pos(arg)
        if eq >= 0
            if var_set(arg.take(eq), arg.skip(eq + 1), 1) != 0
                eputs3("rzsh: export: cannot set ", arg, "\n")
                status = 1
        else if is_valid_name(arg)
            var_export(arg)  # exporting an unset name is a no-op
        else
            eputs3("rzsh: export: not a valid name: ", arg, "\n")
            status = 1
        i = i + 1
    return status

fn cmd_unset(args: Span<StrView>) -> i32
    var i: i64 = 1
    while i < args.len
        var_unset(args[i])
        i = i + 1
    return 0

# Default to the width of a conventional serial terminal.
const LS_WIDTH: i64 = 80

pub fn cmd_ls(args: Span<StrView>) -> i32
    var columns: bool = os_stdout_is_terminal()
    var arg: i64 = 1
    while arg < args.len and args.get(arg).starts_with("-")
        let option: StrView = args.get(arg)
        arg += 1
        if option.eq("--")
            break
        if option.eq("-1")
            columns = false
        else if option.eq("-C")
            columns = true
        else
            err_str("ls: unknown option '")
            err_str(option)
            err_str("'\n")
            return 2
    if args.len - arg > 1
        err_str("Usage: ls [-1|-C] [directory]\n")
        return 2

    var path: StrView = "."
    if arg < args.len
        path = args.get(arg)
    var entries: String = string_new()
    var names: Vec<StrView> = vec_new<StrView>()
    if not os_directory_names(path, @&entries, @&names)
        err_str("ls: cannot access '")
        err_str(path)
        err_str("'\n")
        return 1
    if names.is_empty()
        return 0

    var widest: i64 = 0
    for position in 0..names.len
        let name: StrView = names.get(position)
        var index: i64 = position
        while index > 0 and names.get(index - 1).cmp(name) == Ordering.Greater
            names.swap(index - 1, index)
            index -= 1
        if name.len > widest
            widest = name.len

    let stride: i64 = widest + 2
    var rows: i64 = names.len
    if columns and stride <= LS_WIDTH
        let per_row: i64 = LS_WIDTH / stride
        rows = (names.len + per_row - 1) / per_row

    # Fill columns top to bottom, as ls -C does.
    let spaces: StrView = "                                                                                "
    for row in 0..rows
        var index: i64 = row
        while index < names.len
            let name: StrView = names.get(index)
            print("{name}")
            index += rows
            if index < names.len
                let padding: StrView = spaces.take(stride - name.len)
                print("{padding}")
        print("\n")
    return 0

fn exec_external(args: Span<StrView>) -> i32
    var envp: Envp = vars_build_envp()
    let search: StrView = var_lookup("PATH").unwrap_or(os_default_path())
    let was_raw: bool = os_tty_suspend()
    if var_lookup("RZSH_DEBUG_TTY_WINDOW").is_some()
        os_tty_window_probe()
    let status: i32 = os_spawn_search(args, search, envp_ptr(@envp))
    os_tty_resume(was_raw)
    return status

# Linux can delegate richer options to its system ls.
[[target_os = "linux"]]
fn ls_uses_builtin(args: Span<StrView>) -> bool
    for index in 1..args.len
        let arg: StrView = args.get(index)
        if arg.eq("--")
            return true
        if arg.starts_with("-") and not arg.eq("-1") and not arg.eq("-C")
            return false
    return true

[[target_os = "harland"]]
fn ls_uses_builtin(args: Span<StrView>) -> bool
    return true

# ============================================================================
# Background jobs (AGAST #4752)
# ============================================================================
# `cmd &` starts one external command and goes on without waiting; `wait`
# reaps every job it started, oldest first. No job control beyond that:
# no `jobs`, `fg` or `%n`, and the console's Ctrl-C reaches a job like any
# other child of rzsh (os_tty_suspend). The pids are a Vec in ShellState
# (state.ritz: a Vec can't be module-level, §13.6); g_jobs points at it
# while it is installed.

var g_jobs: *Vec<i32> = null

pub fn jobs_install(v: @&Vec<i32>)
    g_jobs = v

pub fn jobs_release()
    g_jobs = null

# `wait`: reap every background job, oldest first. The last one's status,
# 0 with none.
fn cmd_wait(args: Span<StrView>) -> i32
    if args.len > 1
        err_str("rzsh: wait: takes no arguments\n")
        return 2
    if g_jobs == null
        return 0
    # A typed local: ritz1 can't resolve a generic method's T through the
    # `*Vec` global itself.
    let jobs: *Vec<i32> = g_jobs
    var status: i32 = 0
    var k: i64 = 0
    while k < jobs.len
        let pid: i32 = jobs.get(k)
        status = os_wait(pid)
        k += 1
    jobs.clear()
    return status

# The commands dispatch() runs inside the shell, so none can be a job.
fn is_builtin(args: Span<StrView>) -> bool
    let cmd: StrView = args[0]
    if cmd.eq("ls")
        return ls_uses_builtin(args)
    if cmd.eq("cd") or cmd.eq("pwd") or cmd.eq("export") or cmd.eq("unset")
        return true
    if cmd.eq("help") or cmd.eq("exit") or cmd.eq("pid") or cmd.eq("echo")
        return true
    return cmd.eq("clear") or cmd.eq("wait")

# The item [start, end) ended with `&`: start its one external command and
# return without waiting. 0 once it started ("[n] pid" on stderr, as a
# shell's job notice is); 2, starting nothing, for anything but a simple
# external command; a failed start's status (127: not found).
fn run_background(tk: @Tokens, start: i64, end: i64) -> i32
    if start == end
        err_str("rzsh: syntax error near '&'\n")
        return 2
    var words: Vec<StrView> = vec_new<StrView>()
    var t: i64 = start
    while t < end
        if not tokens_is_word(tk, t)
            err_str("rzsh: only a simple command can run in the background\n")
            return 2
        if not words.push(tokens_word(tk, t))
            err_str("rzsh: out of memory\n")
            return 1
        t += 1
    let args: Span<StrView> = span_from_vec(@words)
    if assignment_pos(args[0]) >= 0 or is_builtin(args)
        eputs3("rzsh: ", args[0], ": a builtin cannot run in the background\n")
        return 2
    if g_jobs == null
        err_str("rzsh: out of memory\n")
        return 1
    # A typed local, as in cmd_wait.
    let jobs: *Vec<i32> = g_jobs
    var envp: Envp = vars_build_envp()
    let search: StrView = var_lookup("PATH").unwrap_or(os_default_path())
    let pid: i32 = match os_spawn_start(args, search, envp_ptr(@envp), true)
        Ok(started) => started
        Err(e) => return spawn_error_status(e)
    let pushed: bool = jobs.push(pid)
    if not pushed
        # Running but untracked: `wait` won't reap it.
        err_str("rzsh: out of memory\n")
        return 1
    var notice: String = string_from("[")
    notice.push_i64(jobs.len)
    notice.push_str("] ")
    notice.push_i64(pid as i64)
    notice.push_str("\n")
    err_str(notice.as_view())
    return 0

# Runs the command `args` (args[0] names it) as a builtin or external command.
fn dispatch(args: Span<StrView>) -> i32
    let cmd: StrView = args[0]
    if cmd.eq("cd")
        return cmd_cd(args)
    if cmd.eq("pwd")
        return cmd_pwd()
    if cmd.eq("export")
        return cmd_export(args)
    if cmd.eq("unset")
        return cmd_unset(args)
    if cmd.eq("help")
        return cmd_help()
    if cmd.eq("exit")
        os_disable_raw_mode()
        return cmd_exit(args)
    if cmd.eq("pid")
        return cmd_pid()
    if cmd.eq("echo")
        return cmd_echo(args)
    if cmd.eq("ls") and ls_uses_builtin(args)
        return cmd_ls(args)
    if cmd.eq("clear")
        return cmd_clear()
    if cmd.eq("wait")
        return cmd_wait(args)
    return exec_external(args)

# ============================================================================
# Simple command: words + redirections over tokens [start, end)
# ============================================================================

# argv is built per command, so a command takes any number of words (it was a
# global [32]*u8: "too many arguments" past 31, AGAST #3529).
fn run_command(tk: @Tokens, start: i64, end: i64) -> i32
    var words: Vec<StrView> = vec_new<StrView>()
    let status: i32 = run_command_with(tk, start, end, @&words)
    return status

# Collects the words of [start, end) into `words` (empty on entry) and runs them.
fn run_command_with(tk: @Tokens, start: i64, end: i64, words: @&Vec<StrView>) -> i32
    var out_path: Option<StrView> = None
    var out_append: bool = false
    var in_path: Option<StrView> = None

    var t: i64 = start
    while t < end
        let kind: TokKind = tokens_kind(tk, t)
        if kind == TokKind.Word
            if not words.push(tokens_word(tk, t))
                err_str("rzsh: out of memory\n")
                return 1
        else
            if t + 1 >= end or not tokens_is_word(tk, t + 1)
                err_str("rzsh: syntax error: redirection needs a file name\n")
                return 2
            if kind == TokKind.In
                in_path = Some(tokens_word(tk, t + 1))
            else
                out_path = Some(tokens_word(tk, t + 1))
                out_append = kind == TokKind.Append
            t = t + 1
        t = t + 1

    let args: Span<StrView> = span_from_vec(words)
    let argc: i64 = args.len

    # NAME=VALUE ... with no command sets shell variables.
    if argc > 0 and assignment_pos(args[0]) >= 0
        var all: bool = true
        var i: i64 = 0
        while i < argc
            if assignment_pos(args[i]) < 0
                all = false
            i = i + 1
        if all
            i = 0
            while i < argc
                let a: StrView = args[i]
                let eq: i64 = assignment_pos(a)
                if var_set(a.take(eq), a.skip(eq + 1), 0) != 0
                    eputs3("rzsh: cannot set ", a, "\n")
                    return 1
                i = i + 1
            return 0

    if out_path.is_none() and in_path.is_none()
        if argc == 0
            return 0
        return dispatch(args)

    if not os_has_fd_control()
        err_str("rzsh: redirection is not supported on this system\n")
        return 2

    var saved_in: i32 = -1
    var saved_out: i32 = -1
    match in_path
        Some(p) =>
            let fd: i32 = os_open_read(p)
            if fd < 0
                eputs3("rzsh: cannot open ", p, "\n")
                return 1
            saved_in = os_dup(0)
            os_dup2(fd, 0)
            os_close(fd)
        None => pass
    match out_path
        Some(p) =>
            let fd: i32 = os_open_write(p, out_append)
            if fd < 0
                eputs3("rzsh: cannot create ", p, "\n")
                if saved_in >= 0
                    os_dup2(saved_in, 0)
                    os_close(saved_in)
                return 1
            saved_out = os_dup(1)
            os_dup2(fd, 1)
            os_close(fd)
        None => pass

    var status: i32 = 0
    if argc > 0
        status = dispatch(args)

    if saved_out >= 0
        os_dup2(saved_out, 1)
        os_close(saved_out)
    if saved_in >= 0
        os_dup2(saved_in, 0)
        os_close(saved_in)
    return status

# ============================================================================
# Pipeline over tokens [start, end)
# ============================================================================

# Stage bounds and pids are Vecs, so a pipeline takes any number of stages
# (they were [17]i64 / [16]i32: "pipeline too long" past 16, AGAST #3529).
fn run_pipeline(tk: @Tokens, start: i64, end: i64) -> i32
    var bounds: Vec<i64> = vec_new<i64>()
    var pids: Vec<i32> = vec_new<i32>()
    let status: i32 = run_pipeline_with(tk, start, end, @&bounds, @&pids)
    return status

# `bounds` and `pids` are empty on entry. Stage s is tokens
# [bounds[s], bounds[s + 1] - 1); bounds ends one past `end`.
fn run_pipeline_with(tk: @Tokens, start: i64, end: i64, bounds: @&Vec<i64>, pids: @&Vec<i32>) -> i32
    # Stage boundaries; an empty stage is a syntax error.
    if not bounds.push(start)
        err_str("rzsh: out of memory\n")
        return 1
    var t: i64 = start
    while t <= end
        if t == end or tokens_kind(tk, t) == TokKind.Pipe
            if t == bounds.last()
                err_str("rzsh: syntax error near '|'\n")
                return 2
            if not bounds.push(t + 1)
                err_str("rzsh: out of memory\n")
                return 1
        t = t + 1
    let stages: i64 = bounds.len - 1

    if stages == 1
        return run_command(tk, start, end)

    if not os_has_fd_control()
        err_str("rzsh: pipes are not supported on this system\n")
        return 2

    var prev_read: i32 = -1
    var s: i64 = 0
    while s < stages
        let last: bool = s == stages - 1
        var fds: [2]i32
        if not last
            if os_pipe(@fds[0]) < 0
                err_str("rzsh: pipe failed\n")
                return 1
        let pid: i32 = os_fork()
        if pid == 0
            if prev_read >= 0
                os_dup2(prev_read, 0)
                os_close(prev_read)
            if not last
                os_dup2(fds[1], 1)
                os_close(fds[1])
                os_close(fds[0])
            sys_exit(run_command(tk, bounds.get(s), bounds.get(s + 1) - 1))
        if prev_read >= 0
            os_close(prev_read)
            prev_read = -1
        if not last
            os_close(fds[1])
            prev_read = fds[0]
        pids.push(pid)  # out of memory: that child goes unwaited
        s = s + 1

    var status: i32 = 0
    var k: i64 = 0
    while k < pids.len
        let pid: i32 = pids.get(k)
        if pid > 0
            status = os_wait(pid)
        else
            status = 1
        k = k + 1
    return status

# ============================================================================
# Entry point
# ============================================================================

# Runs one input line; returns (and records for `$?`) the last status.
pub fn run_line(line: StrView) -> i32
    var pos: i64 = 0
    while pos >= 0
        var tk: Tokens = tokenize(line, pos)
        if tk.err == PARSE_UNTERMINATED
            err_str("rzsh: syntax error: unterminated quote\n")
            tokens_drop(@&tk)
            g_last_status = 2
            return 2
        if tk.err == PARSE_AND_LIST
            err_str("rzsh: syntax error: `&&` is not supported\n")
            tokens_drop(@&tk)
            g_last_status = 2
            return 2
        let n: i64 = tokens_len(@tk)
        if tk.background
            g_last_status = run_background(@tk, 0, n)
        else if n > 0
            g_last_status = run_pipeline(@tk, 0, n)
        pos = tk.next
        tokens_drop(@&tk)
    return g_last_status
