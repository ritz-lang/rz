# rzsh OS abstraction layer
#
# This module provides OS-independent wrappers for operations that differ
# between Linux and Harland. The appropriate implementation is selected
# at compile time via [[target_os]] attributes.
#
# Import all syscalls - unused ones for a target will be optimized out.

import ritzlib.sys {
    # Linux-specific (only used when target_os=linux)
    sys_open, sys_open3, sys_close, sys_getdents64, sys_fork, sys_execve, sys_wait4, sys_exit,
    sys_pipe, sys_dup, sys_dup2, sys_chdir, sys_getcwd,
    O_RDONLY, O_DIRECTORY, STDIN, STDOUT,
    # Harland-specific (only used when target_os=harland)
    sys_readdir, sys_spawn_args, sys_spawn_bg, sys_wait,
    sys_tty_setfg, TTY_FG_CHILDREN
}

import ritzlib.term { tcgetattr, Errno }
import ritzlib.termsession { TermState, term_state_raw }
import rawio { out_str, err_str, in_read }
import ritzlib.result
import ritzlib.gvec
import ritzlib.option
import ritzlib.path { path_absolute }
import ritzlib.span { Span }
import ritzlib.os.env { env_iter }
import ritzlib.string
import ritzlib.strview { StrView }

# ============================================================================
# Directory listing
# ============================================================================

# os_readdir appends the name of each entry of the directory `path` to
# `names`, each followed by a NUL ("a\0b\0"), "." and ".." left out. Returns
# false when the directory can't be read.

# Linux implementation uses sys_open + sys_getdents64 + sys_close
[[target_os = "linux"]]
fn os_readdir(path: StrView, names: @&String) -> bool
    var cpath: String = string_from(path)
    let raw: *u8 = cpath.as_ptr()
    if not cpath.eq(path) or raw == null
        return false
    let fd: i32 = sys_open(raw, O_RDONLY | O_DIRECTORY)
    if fd < 0
        return false

    defer sys_close(fd)
    var temp_buf: [4096]u8
    let dents: Span<u8> = @temp_buf

    while true
        let n: i64 = sys_getdents64(fd, dents.ptr, dents.len)
        if n < 0
            return false
        if n == 0
            break

        # Parse dirent64 entries (d_reclen at 16, d_name at 19) and extract names
        var pos: i64 = 0
        while pos < n
            if n - pos <= 19
                return false
            let reclen: i64 = (dents.get(pos + 16) as i64) | ((dents.get(pos + 17) as i64) << 8)
            if reclen <= 19 or reclen > n - pos
                return false
            let field: StrView = dents.slice(pos + 19, pos + reclen).as_strview()
            let end: i64 = field.find_byte(0)
            if end < 0
                return false
            let name: StrView = field.take(end)
            if not name.eq(".") and not name.eq("..")
                if not names.push_str(name) or not names.push(0)
                    return false

            pos = pos + reclen

    return true

# Harland implementation uses sys_readdir, which fills a buffer with names
# in the same "a\0b\0" form. Harland's kernel takes absolute paths only
# (AGAST #4776), so `ls etc` and `ls ..` resolve against the cwd first.
[[target_os = "harland"]]
fn os_readdir(path: StrView, names: @&String) -> bool
    var absolute: String = match path_absolute(path)
        Ok(resolved) => resolved
        Err(_) => return false
    let raw: *u8 = absolute.as_ptr()
    if raw == null
        return false
    var bytes: [16384]u8
    let listing: Span<u8> = @bytes
    let length: i64 = sys_readdir(raw, listing.ptr, listing.len)
    if length < 0 or length > listing.len
        return false
    return names.push_span(listing.to(length))

# Directory views borrow the caller's string.
pub fn os_directory_names(path: StrView, storage: @&String, names: @&Vec<StrView>) -> bool
    if not os_readdir(path, storage)
        return false
    var entries: StrView = storage.as_view()
    while not entries.is_empty()
        let end: i64 = entries.find_byte(0)
        if end < 0
            return false
        let name: StrView = entries.take(end)
        if not name.is_empty() and not name.starts_with(".") and not names.push(name)
            return false
        entries = entries.skip(end + 1)
    return true

# ============================================================================
# Process spawning
# ============================================================================

# os_spawn_search runs the command `args` (args[0] names it) and returns its
# exit status. A name containing '/' is run as given; otherwise each
# ':'-separated directory of `search` is tried in turn. Returns 127 (after
# printing "command not found" to stderr) when nothing could be executed.

# The C argv an exec takes: `ptrs` is NULL-terminated and points into `buf`
# ("arg0\0arg1\0..."). Built from the words just before the exec.
struct CArgv
    buf: String
    ptrs: Vec<*u8>

fn cargv_build(args: Span<StrView>) -> CArgv
    var a: CArgv = CArgv { buf: string_new(), ptrs: vec_new<*u8>() }
    # buf may move while it grows: take the pointers once it is complete.
    var i: i64 = 0
    while i < args.len
        (a.buf).push_str(args[i])
        (a.buf).push(0)
        i = i + 1
    var p: *u8 = (a.buf).as_ptr()
    i = 0
    while i < args.len
        a.ptrs.push(p)
        p = p + args[i].len + 1
        i = i + 1
    a.ptrs.push(null)
    return a

fn has_slash(s: StrView) -> bool
    return s.find_byte('/') < s.len

# Sets `path` to "<dir>/<cmd>" for the directory of `search` starting at
# `pos`. Returns the index of the next directory, or -1 when none are left.
fn next_candidate(search: StrView, pos: i64, cmd: StrView, path: @&String) -> i64
    if pos >= search.len
        return -1
    let rest: StrView = search.skip(pos)
    let end: i64 = rest.find_byte(':')
    let dir: StrView = rest.take(end)
    path.clear()
    if dir.len == 0  # an empty PATH entry means the current directory
        path.push('.')
    else
        path.push_str(dir)
    if not path.ends_with("/")
        path.push('/')
    path.push_str(cmd)
    if end < rest.len
        return pos + end + 1
    return pos + end

fn not_found(cmd: StrView)
    err_str("rzsh: command not found: ")
    err_str(cmd)
    err_str("\n")

# Why os_spawn_start started nothing; the message is reported already.
pub enum SpawnError
    NotFound    # no candidate on the search path starts
    NotStarted  # the process couldn't be created

# The shell exit status for a failed start: 127 not found, 126 not started.
pub fn spawn_error_status(e: SpawnError) -> i32
    return match e
        SpawnError.NotFound => 127
        SpawnError.NotStarted => 126

# Runs `args` (args[0] names it, found on `search`) and waits for it: its
# exit status, or spawn_error_status when it doesn't start.
pub fn os_spawn_search(args: Span<StrView>, search: StrView, envp: **u8) -> i32
    return match os_spawn_start(args, search, envp, false)
        Ok(pid) => os_wait(pid)
        Err(e) => spawn_error_status(e)

# Starts `args` for os_spawn_search, or as a background job (`cmd &`,
# AGAST #4752): its pid for os_wait.
# Linux: fork, then the child tries each candidate with execve; a command
# that isn't found is the child's exit 127. A fork never blocks, so
# `background` changes nothing here.
[[target_os = "linux"]]
pub fn os_spawn_start(args: Span<StrView>, search: StrView, envp: **u8, background: bool) -> Result<i32, SpawnError>
    let cmd: StrView = args[0]
    let argv: CArgv = cargv_build(args)
    var path: String = string_new()
    let pid: i32 = sys_fork()
    if pid < 0
        return Err(SpawnError.NotStarted)

    if pid == 0
        if has_slash(cmd)
            path.push_str(cmd)
            sys_execve(path.as_ptr(), argv.ptrs.data, envp)
        else
            var pos: i64 = 0
            while pos >= 0
                pos = next_candidate(search, pos, cmd, @&path)
                if pos >= 0
                    sys_execve(path.as_ptr(), argv.ptrs.data, envp)
        not_found(cmd)
        sys_exit(127)

    return Ok(pid)

# Harland: spawn `path` (`./prog`, `bin/cat` or a PATH candidate) once it
# is resolved against the cwd; the kernel takes absolute paths only.
# spawn_args runs the child to its exit before it returns (the console
# handoff, os_tty_fg_children, counts on that); a background job is
# spawn_bg's, which returns at once with both running (#3629).
[[target_os = "harland"]]
fn spawn_resolved(path: StrView, argv: @CArgv, argc: i32, background: bool) -> i64
    var absolute: String = match path_absolute(path)
        Ok(resolved) => resolved
        Err(_) => return -1
    let raw: *u8 = absolute.as_ptr()
    if raw == null
        return -1
    if background
        return sys_spawn_bg(raw, argv.ptrs.data, argc)
    return sys_spawn_args(raw, argv.ptrs.data, argc)

# Harland: try sys_spawn_args on each candidate until one starts. No
# environment is passed (harland has none).
[[target_os = "harland"]]
pub fn os_spawn_start(args: Span<StrView>, search: StrView, envp: **u8, background: bool) -> Result<i32, SpawnError>
    let cmd: StrView = args[0]
    let argv: CArgv = cargv_build(args)
    let argc: i32 = args.len as i32
    var path: String = string_new()

    var pid: i64 = -1
    if has_slash(cmd)
        path.push_str(cmd)
        pid = spawn_resolved(path.as_view(), @argv, argc, background)
    else
        var pos: i64 = 0
        while pos >= 0 and pid < 0
            pos = next_candidate(search, pos, cmd, @&path)
            if pos >= 0
                pid = spawn_resolved(path.as_view(), @argv, argc, background)

    if pid < 0
        not_found(cmd)
        return Err(SpawnError.NotFound)
    return Ok(pid as i32)

# ============================================================================
# Process and file-descriptor control (pipes, redirection)
# ============================================================================
# Linux has fork/pipe/dup2, so `|`, `>`, `>>` and `<` work. Harland has none
# of these syscalls yet: os_has_fd_control() is false there and the shell
# reports those operators as unsupported instead of calling the stubs below.

# Waits for `pid`; its exit code, or 128+signal when a signal killed it.
[[target_os = "linux"]]
pub fn os_wait(pid: i32) -> i32
    var status: i32 = 0
    if sys_wait4(pid, @status, 0, null) < 0
        return 1
    if (status & 127) != 0
        return 128 + (status & 127)
    return (status >> 8) & 255

[[target_os = "linux"]]
pub fn os_has_fd_control() -> bool
    return true

[[target_os = "linux"]]
pub fn os_fork() -> i32
    return sys_fork()

[[target_os = "linux"]]
pub fn os_pipe(fds: *i32) -> i32
    return sys_pipe(fds)

[[target_os = "linux"]]
pub fn os_dup(fd: i32) -> i32
    return sys_dup(fd)

[[target_os = "linux"]]
pub fn os_dup2(oldfd: i32, newfd: i32) -> i32
    return sys_dup2(oldfd, newfd)

[[target_os = "linux"]]
pub fn os_close(fd: i32) -> i32
    return sys_close(fd)

# O_WRONLY|O_CREAT|O_TRUNC = 577, O_WRONLY|O_CREAT|O_APPEND = 1089, mode 0644
# (ritzlib.sys keeps those O_* private).
[[target_os = "linux"]]
pub fn os_open_write(path: StrView, append: bool) -> i32
    var cpath: String = string_from(path)
    if append
        return sys_open3(cpath.as_ptr(), 1089, 420)
    return sys_open3(cpath.as_ptr(), 577, 420)

[[target_os = "linux"]]
pub fn os_open_read(path: StrView) -> i32
    var cpath: String = string_from(path)
    return sys_open(cpath.as_ptr(), O_RDONLY)

[[target_os = "harland"]]
pub fn os_wait(pid: i32) -> i32
    return sys_wait(pid) as i32

[[target_os = "harland"]]
pub fn os_has_fd_control() -> bool
    return false

[[target_os = "harland"]]
pub fn os_fork() -> i32
    return -1

[[target_os = "harland"]]
pub fn os_pipe(fds: *i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_dup(fd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_dup2(oldfd: i32, newfd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_close(fd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_open_write(path: StrView, append: bool) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_open_read(path: StrView) -> i32
    return -1

# ============================================================================
# Working directory
# ============================================================================

[[target_os = "linux"]]
pub fn os_chdir(path: StrView) -> i32
    var cpath: String = string_from(path)
    return sys_chdir(cpath.as_ptr())

# Harland's kernel takes absolute paths only (AGAST #4776): `cd etc`,
# `cd ..` and `cd ../etc` are resolved against the cwd first.
[[target_os = "harland"]]
pub fn os_chdir(path: StrView) -> i32
    var absolute: String = match path_absolute(path)
        Ok(resolved) => resolved
        Err(_) => return -1
    let raw: *u8 = absolute.as_ptr()
    if raw == null
        return -1
    return sys_chdir(raw)

# The cwd, read into `buf`; None on error.
pub fn os_getcwd(buf: Span<u8>) -> Option<StrView>
    if sys_getcwd(buf.ptr, buf.len) < 0
        return None
    # The kernel NUL-terminates the path in `buf`.
    return Some(buf.to(buf.find_byte(0)).as_strview())

# ============================================================================
# Environment
# ============================================================================

# Linux: the environment rzsh was started with, its "K=V" entries as views.
[[target_os = "linux"]]
pub fn os_environ() -> Vec<StrView>
    var out: Vec<StrView> = vec_new<StrView>()
    out.push_span(env_iter())
    out

# Harland passes no environment.
[[target_os = "harland"]]
pub fn os_environ() -> Vec<StrView>
    return vec_new<StrView>()

# ============================================================================
# Directory listing layout
# ============================================================================

[[target_os = "linux"]]
pub fn os_stdout_is_terminal() -> bool
    return tcgetattr(STDOUT).is_ok()

[[target_os = "harland"]]
pub fn os_stdout_is_terminal() -> bool
    return true

# ============================================================================
# Search paths for external commands
# ============================================================================

# Used when $PATH is unset.
[[target_os = "linux"]]
pub fn os_default_path() -> StrView
    return "/usr/local/bin:/usr/bin:/bin"

[[target_os = "harland"]]
pub fn os_default_path() -> StrView
    return "/bin"

# ============================================================================
# Terminal raw mode
# ============================================================================
# Raw mode (ritzlib.termsession, both targets) turns off canonical input and
# echo, so keys arrive one at a time with their escape sequences, and Ctrl-C
# is a key for the editor instead of a signal.

# The raw mode rzsh entered; g_tty_open once there is one. A TermState, not a
# TermSession: this lives for the process, `exit` leaves through sys_exit,
# and every path out restores it by hand (os_disable_raw_mode).
var g_tty: TermState
var g_tty_open: bool = false

# Raw mode on stdin; Err (ENOTTY for a pipe) leaves it as it is. Raw mode
# entered before is resumed, with the attributes it first saved.
pub fn os_enable_raw_mode() -> Result<(), Errno>
    if g_tty_open
        return g_tty.resume()
    g_tty = term_state_raw(STDIN)?
    g_tty_open = true
    Ok(())

# Back to the attributes raw mode found.
pub fn os_disable_raw_mode()
    if g_tty_open
        match g_tty.restore()
            Ok(_) => pass
            Err(_) => pass     # nothing better to do than carry on

pub fn os_is_raw_mode() -> bool
    g_tty_open and g_tty.is_raw()

# The console's Ctrl-C goes to rzsh's children, never to rzsh (#4276, the
# kernel's tty/fg.ritz). Spawn is blocking, so rzsh can't name the command's
# pid before it runs; "my children" covers it and whatever it spawns. A
# Ctrl-C typed while rzsh is still between tty_setattr and spawn is then
# dropped instead of killing rzsh. Set before every command, not once: a
# nested rzsh (a script) hands the console to its own children.
[[target_os = "harland"]]
fn os_tty_fg_children()
    sys_tty_setfg(STDIN, TTY_FG_CHILDREN, 0)

# Linux: the job-control shell's tcsetpgrp is not rzsh's yet.
[[target_os = "linux"]]
fn os_tty_fg_children()
    return

# A command gets the terminal as rzsh found it (echo, line editing, Ctrl-C),
# not rzsh's raw mode: os_tty_suspend before it runs, os_tty_resume(the
# result) after. Only a raw mode that was on is turned back on. The console's
# foreground moves to rzsh's children first, before ISIG is back on.
pub fn os_tty_suspend() -> bool
    os_tty_fg_children()
    if not os_is_raw_mode()
        return false
    os_disable_raw_mode()
    return true

pub fn os_tty_resume(was_raw: bool)
    if was_raw
        match os_enable_raw_mode()
            Ok(_) => pass
            Err(_) => pass     # the prompt still works, echoed by the kernel

# RZSH_DEBUG_TTY_WINDOW (exec_external): hold rzsh between os_tty_suspend
# (ISIG back on) and spawn, in a read(0) of one line, so a test can type
# Ctrl-C into that window every time (#4276).
pub fn os_tty_window_probe()
    out_str("rzsh: tty window\n")
    var buf: [256]u8
    in_read(@buf)
