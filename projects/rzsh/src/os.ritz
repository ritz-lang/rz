# rzsh OS abstraction layer
#
# This module provides OS-independent wrappers for operations that differ
# between Linux and Harland. The appropriate implementation is selected
# at compile time via [[target_os]] attributes.
#
# Import all syscalls - unused ones for a target will be optimized out.

import ritzlib.sys {
    # Linux-specific (only used when target_os=linux)
    sys_open, sys_open3, sys_close, sys_getdents64, sys_fork, sys_execve, sys_wait4, sys_exit,
    sys_pipe, sys_dup, sys_dup2, sys_chdir, sys_getcwd,
    O_RDONLY, O_DIRECTORY,
    ECHO, ICANON, ISIG, IEXTEN, ICRNL, IXON,
    VMIN, VTIME, STDIN,
    # Harland-specific (only used when target_os=harland)
    sys_readdir, sys_spawn_args, sys_wait, sys_yield,
    sys_tty_getattr, sys_tty_setattr, TtyAttrs, TTY_ECHO, TTY_ICANON, TTY_ISIG,
    sys_tty_setfg, TTY_FG_CHILDREN
}

import ritzlib.term { tcgetattr, tcsetattr, TcsetWhen, Termios, Errno }
import rawio { out_str, err_str, in_read }
import ritzlib.result
import ritzlib.gvec
import ritzlib.option
import ritzlib.span { Span }
import ritzlib.string
import ritzlib.strview { StrView, strview_from_cstr }

# ============================================================================
# Directory listing
# ============================================================================

# os_readdir appends the name of each entry of the directory `path` to
# `names`, each followed by a NUL ("a\0b\0"), "." and ".." left out. Returns
# false when the directory can't be read.

# Linux implementation uses sys_open + sys_getdents64 + sys_close
[[target_os = "linux"]]
pub fn os_readdir(path: StrView, names: @&String) -> bool
    var cpath: String = string_from(path)
    let fd: i32 = sys_open(cpath.as_ptr(), O_RDONLY | O_DIRECTORY)
    if fd < 0
        return false

    var temp_buf: [4096]u8

    while true
        let n: i64 = sys_getdents64(fd, @temp_buf[0], 4096)
        if n <= 0
            break

        # Parse dirent64 entries and extract names
        var pos: i64 = 0
        while pos < n
            let entry: *u8 = @temp_buf[0] + pos
            let reclen_lo: u8 = *(entry + 16)
            let reclen_hi: u8 = *(entry + 17)
            let reclen: i64 = (reclen_lo as i64) | ((reclen_hi as i64) << 8)
            let name: *u8 = entry + 19

            # Skip . and .. (d_name is the kernel's NUL-terminated string)
            let name_view: StrView = strview_from_cstr(name)
            if not name_view.eq(".") and not name_view.eq("..")
                names.push_str(name_view)
                names.push(0)

            pos = pos + reclen

    sys_close(fd)
    return true

# Harland implementation uses sys_readdir, which fills a buffer with names
# in the same "a\0b\0" form.
[[target_os = "harland"]]
pub fn os_readdir(path: StrView, names: @&String) -> bool
    var cpath: String = string_from(path)
    var buf: [4096]u8
    let n: i64 = sys_readdir(cpath.as_ptr(), @buf[0], 4096)
    if n < 0
        return false
    push_prefix(names, @buf, n)
    return true

fn push_prefix(names: @&String, bytes: Span<u8>, n: i64)
    names.push_span(bytes.to(n))

# ============================================================================
# Process spawning
# ============================================================================

# os_spawn_search runs the command `args` (args[0] names it) and returns its
# exit status. A name containing '/' is run as given; otherwise each
# ':'-separated directory of `search` is tried in turn. Returns 127 (after
# printing "command not found" to stderr) when nothing could be executed.

# The C argv an exec takes: `ptrs` is NULL-terminated and points into `buf`
# ("arg0\0arg1\0..."). Built from the words just before the exec.
struct CArgv
    buf: String
    ptrs: Vec<*u8>

fn cargv_build(args: Span<StrView>) -> CArgv
    var a: CArgv = CArgv { buf: string_new(), ptrs: vec_new<*u8>() }
    # buf may move while it grows: take the pointers once it is complete.
    var i: i64 = 0
    while i < args.len
        (a.buf).push_str(args[i])
        (a.buf).push(0)
        i = i + 1
    var p: *u8 = (a.buf).as_ptr()
    i = 0
    while i < args.len
        a.ptrs.push(p)
        p = p + args[i].len + 1
        i = i + 1
    a.ptrs.push(null)
    return a

fn has_slash(s: StrView) -> bool
    return s.find_byte('/') < s.len

# Sets `path` to "<dir>/<cmd>" for the directory of `search` starting at
# `pos`. Returns the index of the next directory, or -1 when none are left.
fn next_candidate(search: StrView, pos: i64, cmd: StrView, path: @&String) -> i64
    if pos >= search.len
        return -1
    let rest: StrView = search.skip(pos)
    let end: i64 = rest.find_byte(':')
    let dir: StrView = rest.take(end)
    path.clear()
    if dir.len == 0  # an empty PATH entry means the current directory
        path.push('.')
    else
        path.push_str(dir)
    if not path.ends_with("/")
        path.push('/')
    path.push_str(cmd)
    if end < rest.len
        return pos + end + 1
    return pos + end

fn not_found(cmd: StrView)
    err_str("rzsh: command not found: ")
    err_str(cmd)
    err_str("\n")

# Linux: fork, then the child tries each candidate with execve.
[[target_os = "linux"]]
pub fn os_spawn_search(args: Span<StrView>, search: StrView, envp: **u8) -> i32
    let cmd: StrView = args[0]
    let argv: CArgv = cargv_build(args)
    var path: String = string_new()
    let pid: i32 = sys_fork()
    if pid < 0
        return 126

    if pid == 0
        if has_slash(cmd)
            path.push_str(cmd)
            sys_execve(path.as_ptr(), argv.ptrs.data, envp)
        else
            var pos: i64 = 0
            while pos >= 0
                pos = next_candidate(search, pos, cmd, @&path)
                if pos >= 0
                    sys_execve(path.as_ptr(), argv.ptrs.data, envp)
        not_found(cmd)
        sys_exit(127)

    return os_wait(pid)

# Harland: try sys_spawn_args on each candidate until one starts. No
# environment is passed (harland has none).
[[target_os = "harland"]]
pub fn os_spawn_search(args: Span<StrView>, search: StrView, envp: **u8) -> i32
    let cmd: StrView = args[0]
    let argv: CArgv = cargv_build(args)
    let argc: i32 = args.len as i32
    var path: String = string_new()

    var pid: i64 = -1
    if has_slash(cmd)
        path.push_str(cmd)
        pid = sys_spawn_args(path.as_ptr(), argv.ptrs.data, argc)
    else
        var pos: i64 = 0
        while pos >= 0 and pid < 0
            pos = next_candidate(search, pos, cmd, @&path)
            if pos >= 0
                pid = sys_spawn_args(path.as_ptr(), argv.ptrs.data, argc)

    if pid < 0
        not_found(cmd)
        return 127
    return sys_wait(pid as i32) as i32

# ============================================================================
# Process and file-descriptor control (pipes, redirection)
# ============================================================================
# Linux has fork/pipe/dup2, so `|`, `>`, `>>` and `<` work. Harland has none
# of these syscalls yet: os_has_fd_control() is false there and the shell
# reports those operators as unsupported instead of calling the stubs below.

# Waits for `pid`; its exit code, or 128+signal when a signal killed it.
[[target_os = "linux"]]
pub fn os_wait(pid: i32) -> i32
    var status: i32 = 0
    if sys_wait4(pid, @status, 0, null) < 0
        return 1
    if (status & 127) != 0
        return 128 + (status & 127)
    return (status >> 8) & 255

[[target_os = "linux"]]
pub fn os_has_fd_control() -> bool
    return true

[[target_os = "linux"]]
pub fn os_fork() -> i32
    return sys_fork()

[[target_os = "linux"]]
pub fn os_pipe(fds: *i32) -> i32
    return sys_pipe(fds)

[[target_os = "linux"]]
pub fn os_dup(fd: i32) -> i32
    return sys_dup(fd)

[[target_os = "linux"]]
pub fn os_dup2(oldfd: i32, newfd: i32) -> i32
    return sys_dup2(oldfd, newfd)

[[target_os = "linux"]]
pub fn os_close(fd: i32) -> i32
    return sys_close(fd)

# O_WRONLY|O_CREAT|O_TRUNC = 577, O_WRONLY|O_CREAT|O_APPEND = 1089, mode 0644
# (ritzlib.sys keeps those O_* private).
[[target_os = "linux"]]
pub fn os_open_write(path: StrView, append: bool) -> i32
    var cpath: String = string_from(path)
    if append
        return sys_open3(cpath.as_ptr(), 1089, 420)
    return sys_open3(cpath.as_ptr(), 577, 420)

[[target_os = "linux"]]
pub fn os_open_read(path: StrView) -> i32
    var cpath: String = string_from(path)
    return sys_open(cpath.as_ptr(), O_RDONLY)

[[target_os = "harland"]]
pub fn os_wait(pid: i32) -> i32
    return sys_wait(pid) as i32

[[target_os = "harland"]]
pub fn os_has_fd_control() -> bool
    return false

[[target_os = "harland"]]
pub fn os_fork() -> i32
    return -1

[[target_os = "harland"]]
pub fn os_pipe(fds: *i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_dup(fd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_dup2(oldfd: i32, newfd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_close(fd: i32) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_open_write(path: StrView, append: bool) -> i32
    return -1

[[target_os = "harland"]]
pub fn os_open_read(path: StrView) -> i32
    return -1

# ============================================================================
# Working directory
# ============================================================================

pub fn os_chdir(path: StrView) -> i32
    var cpath: String = string_from(path)
    return sys_chdir(cpath.as_ptr())

# The cwd, read into `buf`; None on error.
pub fn os_getcwd(buf: Span<u8>) -> Option<StrView>
    if sys_getcwd(buf.ptr, buf.len) < 0
        return None
    return Some(strview_from_cstr(buf.ptr))   # the kernel NUL-terminates it

# ============================================================================
# Environment
# ============================================================================

# `_start` stores the kernel envp here (AGAST #3737). A Span<StrView> main
# no longer has the C argv array to walk past.
extern var __ritz_envp: **u8

# Linux: the kernel's envp. Null when this binary's `_start` did not set it.
[[target_os = "linux"]]
pub fn os_environ() -> **u8
    return __ritz_envp

[[target_os = "harland"]]
pub fn os_environ() -> **u8
    return null

# ============================================================================
# Input waiting
# ============================================================================

# True when a stdin read result means "no more input, ever". On Linux a
# blocking read returns 0 only at EOF (a closed pipe, ^D in cooked mode):
# without this the shell spun on EOF forever. EINTR (-4) is not the end.
[[target_os = "linux"]]
pub fn os_input_ended(n: i64) -> bool
    return n == 0 or (n < 0 and n != -4)

# Harland's console read blocks too (AGAST #4254): 0 is ^D on an empty
# line in cooked mode, a negative errno an unreadable stdin.
[[target_os = "harland"]]
pub fn os_input_ended(n: i64) -> bool
    return n <= 0

# Linux: blocking read handles waiting, no need to do anything
[[target_os = "linux"]]
pub fn os_yield()
    # No-op on Linux - blocking I/O handles this
    return

# Harland: call sys_yield to let other processes run
[[target_os = "harland"]]
pub fn os_yield()
    sys_yield()

# ============================================================================
# Default directory for ls
# ============================================================================

[[target_os = "linux"]]
pub fn os_default_ls_path() -> StrView
    return "."

[[target_os = "harland"]]
pub fn os_default_ls_path() -> StrView
    return "/"

# ============================================================================
# Search paths for external commands
# ============================================================================

# Used when $PATH is unset.
[[target_os = "linux"]]
pub fn os_default_path() -> StrView
    return "/usr/local/bin:/usr/bin:/bin"

[[target_os = "harland"]]
pub fn os_default_path() -> StrView
    return "/bin"

# ============================================================================
# Terminal raw mode
# ============================================================================
# Raw mode disables canonical input (line buffering) and echo, allowing
# character-by-character input with escape sequence detection.

# Shared state for raw mode tracking (used by both targets)
# Note: g_orig_termios storage is platform-specific but we need one buffer
# that holds Termios (60 bytes) or TtyAttrs (4 bytes) depending on target.
# We allocate enough for Termios (the larger one).
var g_termios_storage: [64]u8
# 0 = not in raw mode, 1 = in raw mode
var g_raw_mode_active: i32 = 0

# Linux: Save original termios and apply raw mode settings
[[target_os = "linux"]]
pub fn os_enable_raw_mode() -> i32
    if g_raw_mode_active != 0
        return 0  # Already in raw mode

    # Cast storage to Termios pointer
    let orig_termios: *Termios = @g_termios_storage[0] as *Termios

    # Get current terminal settings
    match tcgetattr(STDIN)
        Ok(t) => *orig_termios = t
        Err(e) => return -e.code()  # Failed (probably not a tty)

    # Create raw mode settings
    var raw: Termios = *orig_termios

    # Disable canonical mode, echo, signals, extended processing
    raw.c_lflag = raw.c_lflag & (0xFFFFFFFF ^ (ECHO | ICANON | ISIG | IEXTEN))

    # Disable CR->NL translation and XON/XOFF
    raw.c_iflag = raw.c_iflag & (0xFFFFFFFF ^ (ICRNL | IXON))

    # Set minimum characters for read to 1, timeout to 0
    raw.c_cc[VMIN] = 1
    raw.c_cc[VTIME] = 0

    # Apply raw mode
    match tcsetattr(STDIN, @raw, TcsetWhen.Now)
        Ok(_) =>
            g_raw_mode_active = 1
            0
        Err(e) => -e.code()

[[target_os = "linux"]]
pub fn os_disable_raw_mode() -> i32
    if g_raw_mode_active == 0
        return 0  # Not in raw mode

    # Restore original terminal settings
    let orig_termios: *Termios = @g_termios_storage[0] as *Termios
    let saved: Termios = *orig_termios
    g_raw_mode_active = 0
    match tcsetattr(STDIN, @saved, TcsetWhen.Now)
        Ok(_) => 0
        Err(e) => -e.code()

[[target_os = "linux"]]
pub fn os_is_raw_mode() -> bool
    return g_raw_mode_active != 0

# Harland: the console has three flags (ritzlib TtyAttrs, AGAST #4254). Raw
# mode clears them all: no kernel echo or line editing, and Ctrl-C reaches
# the editor as a byte instead of killing the shell.
[[target_os = "harland"]]
pub fn os_enable_raw_mode() -> i32
    if g_raw_mode_active != 0
        return 0
    let orig: *TtyAttrs = @g_termios_storage[0] as *TtyAttrs
    let r1: i32 = sys_tty_getattr(STDIN, orig)
    if r1 != 0
        return r1
    var raw: TtyAttrs = *orig
    raw.flags = raw.flags & (0xFFFFFFFF ^ (TTY_ECHO | TTY_ICANON | TTY_ISIG))
    let r2: i32 = sys_tty_setattr(STDIN, @raw)
    if r2 != 0
        return r2
    g_raw_mode_active = 1
    return 0

[[target_os = "harland"]]
pub fn os_disable_raw_mode() -> i32
    if g_raw_mode_active == 0
        return 0
    let r: i32 = sys_tty_setattr(STDIN, @g_termios_storage[0] as *TtyAttrs)
    g_raw_mode_active = 0
    return r

[[target_os = "harland"]]
pub fn os_is_raw_mode() -> bool
    return g_raw_mode_active != 0

# The console's Ctrl-C goes to rzsh's children, never to rzsh (#4276, the
# kernel's tty/fg.ritz). Spawn is blocking, so rzsh can't name the command's
# pid before it runs; "my children" covers it and whatever it spawns. A
# Ctrl-C typed while rzsh is still between tty_setattr and spawn is then
# dropped instead of killing rzsh. Set before every command, not once: a
# nested rzsh (a script) hands the console to its own children.
[[target_os = "harland"]]
fn os_tty_fg_children()
    sys_tty_setfg(STDIN, TTY_FG_CHILDREN, 0)

# Linux: the job-control shell's tcsetpgrp is not rzsh's yet.
[[target_os = "linux"]]
fn os_tty_fg_children()
    return

# A command gets the terminal as rzsh found it (echo, line editing, Ctrl-C),
# not rzsh's raw mode: os_tty_suspend before it runs, os_tty_resume(the
# result) after. Only a raw mode that was on is turned back on. The console's
# foreground moves to rzsh's children first, before ISIG is back on.
pub fn os_tty_suspend() -> bool
    os_tty_fg_children()
    if g_raw_mode_active == 0
        return false
    os_disable_raw_mode()
    return true

pub fn os_tty_resume(was_raw: bool)
    if was_raw
        os_enable_raw_mode()

# RZSH_DEBUG_TTY_WINDOW (exec_external): hold rzsh between os_tty_suspend
# (ISIG back on) and spawn, in a read(0) of one line, so a test can type
# Ctrl-C into that window every time (#4276).
pub fn os_tty_window_probe()
    out_str("rzsh: tty window\n")
    var buf: [256]u8
    in_read(Span<u8> { ptr: @buf[0], len: 256 })
