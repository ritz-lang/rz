# Line editor: one handler per key (AGAST #3940, LARB v4 packages.md M9)
#
# main's read loop decodes bytes into keys (ritzlib.termsession's KeyReader)
# and hands each key to
# editor_handle_key, which edits the line buffer (common.ritz), echoes the
# change to the terminal, and returns what the loop does next.

import common {
    puts, putchar,
    line_view,
    line_clear, line_add_char, line_backspace, line_delete,
    line_cursor_left, line_cursor_right, line_cursor_home, line_cursor_end,
    line_kill_to_end, line_kill_to_start, line_set, line_length, line_cursor_pos,
    print_prompt
}

import shell { run_line }
import ritzlib.io { println }

import ritzlib.termsession { Key, TermOut, term_out }
import ritzlib.sys { STDOUT }

import history { history_add, history_up, history_down }

import ritzlib.option
import ritzlib.strview { StrView }

# What the read loop does after a key.
pub const EDIT_CONTINUE: i32 = 0     # keep reading this line
pub const EDIT_LINE_DONE: i32 = 1    # line finished: print a new prompt
pub const EDIT_EXIT: i32 = 2         # leave the shell

# What argv[1] asks for.
pub const CLI_INTERACTIVE: i32 = 0
pub const CLI_HELP: i32 = 1          # --help
pub const CLI_COMMAND: i32 = 2       # -c LINE

pub fn cli_mode(arg: StrView) -> i32
    match arg
        "--help" => CLI_HELP
        "-c" => CLI_COMMAND
        _ => CLI_INTERACTIVE

# ============================================================================
# Terminal helpers
# ============================================================================

# Each escape sequence is written as soon as it is built, so it stays in order
# with the text puts writes around it.
fn emit(out: @&TermOut)
    match out.flush(STDOUT)
        Ok(_) => pass
        Err(_) => pass     # a terminal that can't be written can't be told

fn cursor_left(n: i32)
    var out: TermOut = term_out()
    out.cursor_left(n)
    emit(@&out)

fn cursor_right(n: i32)
    var out: TermOut = term_out()
    out.cursor_right(n)
    emit(@&out)

fn clear_to_eol()
    var out: TermOut = term_out()
    out.clear_to_eol()
    emit(@&out)

# After modifying text mid-line, redraw the remainder and reposition cursor.
fn redraw_line_from_cursor()
    let cur: i64 = line_cursor_pos()
    let len: i64 = line_length()
    if cur < len
        let tail: StrView = line_view().skip(cur)
        puts(tail)
    # Clear anything after (in case line got shorter)
    clear_to_eol()
    move_left(len - cur)

fn move_left(n: i64)
    if n > 0
        cursor_left(n as i32)

fn move_right(n: i64)
    if n > 0
        cursor_right(n as i32)

# Blank the visible line, leaving the terminal cursor at the prompt.
fn erase_visible_line()
    move_left(line_cursor_pos())
    clear_to_eol()

fn process_line() -> i32
    if line_length() == 0
        return 0
    return run_line(line_view())

# ============================================================================
# Line-ending keys
# ============================================================================

fn on_enter() -> i32
    println("")
    if line_length() > 0
        history_add(line_view())
    process_line()
    return EDIT_LINE_DONE

fn on_ctrl_c() -> i32
    println("^C")
    line_clear()
    return EDIT_LINE_DONE

# Ctrl-D leaves the shell on an empty line and does nothing otherwise.
fn on_ctrl_d() -> i32
    if line_length() != 0
        return EDIT_CONTINUE
    println("")
    return EDIT_EXIT

# ============================================================================
# Editing keys
# ============================================================================

fn on_char(c: u8)
    let at_end: bool = line_cursor_pos() == line_length()
    line_add_char(c)
    putchar(c)
    if not at_end
        redraw_line_from_cursor()

fn on_backspace()
    if line_cursor_pos() > 0
        line_backspace()
        cursor_left(1)
        redraw_line_from_cursor()

fn on_delete()
    if line_cursor_pos() < line_length()
        line_delete()
        redraw_line_from_cursor()

fn on_kill_to_end()
    line_kill_to_end()
    clear_to_eol()

fn on_kill_to_start()
    move_left(line_cursor_pos())
    line_kill_to_start()
    redraw_line_from_cursor()

# Clear the screen and redraw the prompt and line.
fn on_clear_screen()
    var out: TermOut = term_out()
    out.clear_screen()
    out.cursor_to(1, 1)
    emit(@&out)
    print_prompt()
    let len: i64 = line_length()
    if len > 0
        let line: StrView = line_view()
        puts(line)
        move_left(len - line_cursor_pos())

# ============================================================================
# Motion and history keys
# ============================================================================

fn on_left()
    if line_cursor_left()
        cursor_left(1)

fn on_right()
    if line_cursor_right()
        cursor_right(1)

fn on_home()
    move_left(line_cursor_pos())
    line_cursor_home()

fn on_end()
    move_right(line_length() - line_cursor_pos())
    line_cursor_end()

fn on_history_up()
    match history_up()
        Some(hist) =>
            erase_visible_line()
            line_set(hist)
            puts(hist)
        None => pass

# Past the newest entry, history_down returns None: back to an empty prompt.
fn on_history_down()
    erase_visible_line()
    match history_down()
        Some(hist) =>
            line_set(hist)
            puts(hist)
        None => line_clear()

# ============================================================================
# Dispatch
# ============================================================================

# Keys that change the line's text. False if `key` is not one of them.
fn edit_key(key: Key) -> bool
    match key
        Key.Backspace => on_backspace()
        Key.Delete => on_delete()
        Key.Ctrl(c) => return ctrl_edit_key(c)
        _ => return false
    return true

# Ctrl-K kills to the end, Ctrl-U to the start, Ctrl-L clears the screen.
fn ctrl_edit_key(c: u8) -> bool
    match c
        'k' => on_kill_to_end()
        'u' => on_kill_to_start()
        'l' => on_clear_screen()
        _ => return false
    return true

# Keys that move the cursor or swap in a history entry.
fn motion_key(key: Key) -> bool
    match key
        Key.Left => on_left()
        Key.Right => on_right()
        Key.Home => on_home()
        Key.End => on_end()
        Key.Ctrl(c) =>
            if c == 'a'
                on_home()
            else if c == 'e'
                on_end()
            else
                return false
        Key.Up => on_history_up()
        Key.Down => on_history_down()
        _ => return false
    return true

# Handle one decoded key. Unhandled keys (Tab, Ctrl-W, Escape, ...) are
# ignored. The line holds bytes, so text past ASCII is ignored too.
pub fn editor_handle_key(key: Key) -> i32
    match key
        Key.Char(c) =>
            if c < 128
                on_char(c as u8)
        Key.Enter => return on_enter()
        Key.Ctrl(c) =>
            if c == 'c'
                return on_ctrl_c()
            if c == 'd'
                return on_ctrl_d()
        _ => pass
    if not edit_key(key)
        motion_key(key)
    return EDIT_CONTINUE
