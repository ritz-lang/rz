# rzsh_common - Shared code between rzsh platforms
#
# This module contains platform-agnostic code shared between
# rzsh.harland.ritz and rzsh.linux.ritz

import ritzlib.sys { sys_exit }

import ritzlib.gvec
import ritzlib.memory
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import rawio { out_str, shell_pid }

# ============================================================================
# String Utilities
# ============================================================================
# The bytes go through rawio, rzsh's one write(2)/read(2) layer.

pub fn puts(s: StrView) -> i64
    return out_str(s)

pub fn println(s: StrView) -> i64
    puts(s)
    return puts("\n")

pub fn putchar(c: u8) -> i64
    return out_str(StrView { ptr: @c, len: 1 })

# `print` is the compiler builtin. It lowers `{n}` through __ritz_fmt_int and
# does not import ritzlib.fmt, so it neither collides with println above nor
# pulls hosted fmt into the freestanding Harland bin.
pub fn print_pid(pid: i64)
    print("PID: {pid}\n")

pub fn print_raw_warning(raw_result: i32)
    print("Warning: Could not enable raw mode ({raw_result})\n")

# ============================================================================
# Line Buffer
# ============================================================================
# The line buffer stores the current input line. g_line_len is the total
# length of the line, g_line_cursor is the current cursor position within
# the line (for cursor movement with arrow keys).
#
# g_line holds g_line_len bytes and a NUL, and grows as keys arrive (it was a
# fixed [512]u8 that dropped every key past byte 511, AGAST #3529). Growing
# may move it, so read it through line_view() rather than keeping a view.

# A Vec has Drop, so it cannot live at module level (§13.6: a module-level
# value is never dropped). The buffer is a heap Vec allocated once, and the
# module-level global is only the pointer to it.
var g_line: *Vec<u8> = null
pub var g_line_len: i64 = 0       # Total length of line
pub var g_line_cursor: i64 = 0    # Cursor position within line

fn line_vec() -> *Vec<u8>
    if g_line == null
        let p: *Vec<u8> = malloc(sizeof(Vec<u8>)) as *Vec<u8>
        *p = vec_new<u8>()
        g_line = p
    g_line

# Room for `extra` more bytes plus the NUL; false when out of memory.
fn line_reserve(extra: i64) -> bool
    return line_vec().ensure_cap(g_line_len + extra + 1)

# NUL-terminates the line at g_line_len.
fn line_terminate()
    *(line_vec().data + g_line_len) = 0
    line_vec().len = g_line_len

# The current line. Valid until the next edit.
pub fn line_view() -> StrView
    if not line_reserve(0)
        return ""
    line_terminate()
    return StrView { ptr: line_vec().data, len: g_line_len }

pub fn line_clear() -> i32
    g_line_len = 0
    g_line_cursor = 0
    if line_reserve(0)
        line_terminate()
    return 0

# Add character at cursor position (may insert in middle of line)
pub fn line_add_char(c: u8) -> i32
    if not line_reserve(1)
        return 0  # Out of memory: drop the key
    let buf: *u8 = line_vec().data

    # Shift characters right of the cursor (none when it is at the end)
    var i: i64 = g_line_len
    while i > g_line_cursor
        *(buf + i) = *(buf + i - 1)
        i = i - 1

    *(buf + g_line_cursor) = c
    g_line_len = g_line_len + 1
    g_line_cursor = g_line_cursor + 1
    line_terminate()
    return 0

# Delete character before cursor (backspace)
pub fn line_backspace() -> i32
    if g_line_cursor == 0
        return 0  # Nothing to delete
    let buf: *u8 = line_vec().data

    # Shift characters left from cursor position
    var i: i64 = g_line_cursor - 1
    while i < g_line_len - 1
        *(buf + i) = *(buf + i + 1)
        i = i + 1

    g_line_len = g_line_len - 1
    g_line_cursor = g_line_cursor - 1
    line_terminate()
    return 0

# Delete character at cursor (delete key)
pub fn line_delete() -> i32
    if g_line_cursor >= g_line_len
        return 0  # Nothing to delete
    let buf: *u8 = line_vec().data

    # Shift characters left
    var i: i64 = g_line_cursor
    while i < g_line_len - 1
        *(buf + i) = *(buf + i + 1)
        i = i + 1

    g_line_len = g_line_len - 1
    line_terminate()
    return 0

# Move cursor left
pub fn line_cursor_left() -> bool
    if g_line_cursor > 0
        g_line_cursor = g_line_cursor - 1
        return true
    return false

# Move cursor right
pub fn line_cursor_right() -> bool
    if g_line_cursor < g_line_len
        g_line_cursor = g_line_cursor + 1
        return true
    return false

# Move cursor to start of line
pub fn line_cursor_home()
    g_line_cursor = 0

# Move cursor to end of line
pub fn line_cursor_end()
    g_line_cursor = g_line_len

# Kill from cursor to end of line
pub fn line_kill_to_end()
    if g_line_cursor >= g_line_len
        return
    g_line_len = g_line_cursor
    line_terminate()

# Kill from start to cursor
pub fn line_kill_to_start()
    if g_line_cursor == 0
        return

    # Shift remaining characters to start
    let buf: *u8 = line_vec().data
    var i: i64 = 0
    while g_line_cursor + i < g_line_len
        *(buf + i) = *(buf + g_line_cursor + i)
        i = i + 1

    g_line_len = g_line_len - g_line_cursor
    g_line_cursor = 0
    line_terminate()

# Set line content (for history navigation)
pub fn line_set(s: StrView)
    line_clear()
    let len: i64 = s.len
    if not line_reserve(len)
        return
    var i: i64 = 0
    while i < len
        *(line_vec().data + i) = s.get(i)
        i = i + 1
    g_line_len = len
    g_line_cursor = len
    line_terminate()

# Get line length
pub fn line_length() -> i64
    return g_line_len

# Get cursor position
pub fn line_cursor_pos() -> i64
    return g_line_cursor

# ============================================================================
# Built-in Commands (platform-agnostic)
# ============================================================================

pub fn cmd_help() -> i32
    println("rzsh - Ritz Shell")
    println("")
    println("Built-in commands:")
    println("  help            Show this help")
    println("  exit [code]     Exit the shell")
    println("  cd [dir]        Change directory (default $HOME, else /)")
    println("  pwd             Print the working directory")
    println("  export [N[=V]]  Set/export variables; no args lists them")
    println("  unset N...      Remove variables")
    println("  pid             Show process ID")
    println("  echo [args]     Print arguments")
    println("  ls [-1|-C] [dir]  List directory contents")
    println("  clear           Clear the screen")
    println("")
    println("Syntax:")
    println("  N=V             Set a shell variable")
    println("  $N $\{N\} $?      Expand a variable / the last exit status")
    println("  '...'           Literal quoting; double quotes still expand $")
    println("  a ; b           Run a, then b")
    println("  a > f, a >> f   Write / append stdout to f      (Linux only)")
    println("  a < f           Read stdin from f                (Linux only)")
    println("  a | b           Pipe a's stdout into b           (Linux only)")
    println("  # ...           Comment")
    println("  Not supported: &&, ||, &, globbing, $(...), here-docs.")
    println("")
    println("External commands are searched for in $PATH.")
    return 0

# Builtins take the command's words; args[0] is the builtin's name.

pub fn cmd_exit(args: Span<StrView>) -> i32
    var code: i32 = 0
    if args.len > 1
        let arg: StrView = args[1]
        var i: i64 = 0
        while i < arg.len
            let c: u8 = arg.get(i)
            if c >= 48 and c <= 57
                code = code * 10 + ((c - 48) as i32)
            i = i + 1
    println("Goodbye!")
    sys_exit(code)
    return 0

pub fn cmd_pid() -> i32
    print_pid(shell_pid() as i64)
    return 0

pub fn cmd_echo(args: Span<StrView>) -> i32
    var i: i64 = 1
    while i < args.len
        if i > 1
            putchar(32)
        puts(args[i])
        i = i + 1
    println("")
    return 0

pub fn cmd_clear() -> i32
    puts("\e[2J\e[H")    # clear screen, cursor home
    return 0

pub fn print_prompt() -> i32
    puts("rzsh> ")
    return 0
