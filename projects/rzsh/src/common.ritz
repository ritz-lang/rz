# rzsh_common - Shared code between rzsh platforms
#
# This module contains platform-agnostic code shared between
# rzsh.harland.ritz and rzsh.linux.ritz

import ritzlib.sys {
    sys_read, sys_write, sys_exit, sys_getpid,
    STDIN, STDOUT, STDERR
}

import ritzlib.str { strlen, strcmp }
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.gvec
import ritzlib.memory

# ============================================================================
# String Utilities
# ============================================================================

pub fn puts(s: *u8) -> i64
    return sys_write(STDOUT, s, strlen(s))

pub fn println(s: *u8) -> i64
    puts(s)
    var newline: u8 = 10
    return sys_write(STDOUT, @newline, 1)

pub fn putchar(c: u8) -> i64
    return sys_write(STDOUT, @c, 1)

# Digits come from ritzlib.fmt (AGAST #1932: the old recursive print_num
# printed garbage for negatives, e.g. a -errno from os_enable_raw_mode).
pub fn print_int(n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    sys_write(STDOUT, @buf[0], len)

# ============================================================================
# Line Buffer
# ============================================================================
# The line buffer stores the current input line. g_line_len is the total
# length of the line, g_line_cursor is the current cursor position within
# the line (for cursor movement with arrow keys).
#
# g_line holds g_line_len bytes and a NUL, and grows as keys arrive (it was a
# fixed [512]u8 that dropped every key past byte 511, AGAST #3529). Growing
# may move it, so read it through line_ptr() rather than keeping a pointer.

# A Vec has Drop, so it cannot live at module level (§13.6: a module-level
# value is never dropped). The buffer is a heap Vec allocated once, and the
# module-level global is only the pointer to it.
var g_line: *Vec<u8> = null
pub var g_line_len: i64 = 0       # Total length of line
pub var g_line_cursor: i64 = 0    # Cursor position within line

fn line_vec() -> *Vec<u8>
    if g_line == null
        let p: *Vec<u8> = malloc(sizeof(Vec<u8>)) as *Vec<u8>
        *p = vec_new<u8>()
        g_line = p
    g_line

# Room for `extra` more bytes plus the NUL; false when out of memory.
fn line_reserve(extra: i64) -> bool
    return line_vec().ensure_cap(g_line_len + extra + 1)

# NUL-terminates the line at g_line_len.
fn line_terminate()
    *(line_vec().data + g_line_len) = 0
    line_vec().len = g_line_len

# The current line, NUL-terminated. Valid until the next edit.
pub fn line_ptr() -> *u8
    if not line_reserve(0)
        return c""
    line_terminate()
    return line_vec().data

pub fn line_clear() -> i32
    g_line_len = 0
    g_line_cursor = 0
    if line_reserve(0)
        line_terminate()
    return 0

# Add character at cursor position (may insert in middle of line)
pub fn line_add_char(c: u8) -> i32
    if not line_reserve(1)
        return 0  # Out of memory: drop the key
    let buf: *u8 = line_vec().data

    # Shift characters right of the cursor (none when it is at the end)
    var i: i64 = g_line_len
    while i > g_line_cursor
        *(buf + i) = *(buf + i - 1)
        i = i - 1

    *(buf + g_line_cursor) = c
    g_line_len = g_line_len + 1
    g_line_cursor = g_line_cursor + 1
    line_terminate()
    return 0

# Delete character before cursor (backspace)
pub fn line_backspace() -> i32
    if g_line_cursor == 0
        return 0  # Nothing to delete
    let buf: *u8 = line_vec().data

    # Shift characters left from cursor position
    var i: i64 = g_line_cursor - 1
    while i < g_line_len - 1
        *(buf + i) = *(buf + i + 1)
        i = i + 1

    g_line_len = g_line_len - 1
    g_line_cursor = g_line_cursor - 1
    line_terminate()
    return 0

# Delete character at cursor (delete key)
pub fn line_delete() -> i32
    if g_line_cursor >= g_line_len
        return 0  # Nothing to delete
    let buf: *u8 = line_vec().data

    # Shift characters left
    var i: i64 = g_line_cursor
    while i < g_line_len - 1
        *(buf + i) = *(buf + i + 1)
        i = i + 1

    g_line_len = g_line_len - 1
    line_terminate()
    return 0

# Move cursor left
pub fn line_cursor_left() -> bool
    if g_line_cursor > 0
        g_line_cursor = g_line_cursor - 1
        return true
    return false

# Move cursor right
pub fn line_cursor_right() -> bool
    if g_line_cursor < g_line_len
        g_line_cursor = g_line_cursor + 1
        return true
    return false

# Move cursor to start of line
pub fn line_cursor_home()
    g_line_cursor = 0

# Move cursor to end of line
pub fn line_cursor_end()
    g_line_cursor = g_line_len

# Kill from cursor to end of line
pub fn line_kill_to_end()
    if g_line_cursor >= g_line_len
        return
    g_line_len = g_line_cursor
    line_terminate()

# Kill from start to cursor
pub fn line_kill_to_start()
    if g_line_cursor == 0
        return

    # Shift remaining characters to start
    let buf: *u8 = line_vec().data
    var i: i64 = 0
    while g_line_cursor + i < g_line_len
        *(buf + i) = *(buf + g_line_cursor + i)
        i = i + 1

    g_line_len = g_line_len - g_line_cursor
    g_line_cursor = 0
    line_terminate()

# Set line content (for history navigation)
pub fn line_set(s: *u8)
    line_clear()
    let len: i64 = strlen(s)
    if not line_reserve(len)
        return
    var i: i64 = 0
    while i < len
        *(line_vec().data + i) = *(s + i)
        i = i + 1
    g_line_len = len
    g_line_cursor = len
    line_terminate()

# Get line length
pub fn line_length() -> i64
    return g_line_len

# Get cursor position
pub fn line_cursor_pos() -> i64
    return g_line_cursor

# ============================================================================
# Built-in Commands (platform-agnostic)
# ============================================================================

pub fn cmd_help() -> i32
    println(c"rzsh - Ritz Shell")
    println(c"")
    println(c"Built-in commands:")
    println(c"  help            Show this help")
    println(c"  exit [code]     Exit the shell")
    println(c"  cd [dir]        Change directory (default $HOME, else /)")
    println(c"  pwd             Print the working directory")
    println(c"  export [N[=V]]  Set/export variables; no args lists them")
    println(c"  unset N...      Remove variables")
    println(c"  pid             Show process ID")
    println(c"  echo [args]     Print arguments")
    println(c"  ls [dir]        List directory contents")
    println(c"  clear           Clear the screen")
    println(c"")
    println(c"Syntax:")
    println(c"  N=V             Set a shell variable")
    println(c"  $N ${N} $?      Expand a variable / the last exit status")
    println(c"  '...'           Literal quoting; double quotes still expand $")
    println(c"  a ; b           Run a, then b")
    println(c"  a > f, a >> f   Write / append stdout to f      (Linux only)")
    println(c"  a < f           Read stdin from f                (Linux only)")
    println(c"  a | b           Pipe a's stdout into b           (Linux only)")
    println(c"  # ...           Comment")
    println(c"  Not supported: &&, ||, &, globbing, $(...), here-docs.")
    println(c"")
    println(c"External commands are searched for in $PATH.")
    return 0

# Builtins take the command's words as argv[0..argc] (argv[argc] is null).

pub fn cmd_exit(argc: i32, argv: **u8) -> i32
    var code: i32 = 0
    if argc > 1
        let arg: *u8 = *(argv + 1)
        var i: i64 = 0
        while *(arg + i) != 0
            let c: u8 = *(arg + i)
            if c >= 48 and c <= 57
                code = code * 10 + ((c - 48) as i32)
            i = i + 1
    println(c"Goodbye!")
    sys_exit(code)
    return 0

pub fn cmd_pid() -> i32
    let pid: i32 = sys_getpid()
    puts(c"PID: ")
    print_int(pid as i64)
    println(c"")
    return 0

pub fn cmd_echo(argc: i32, argv: **u8) -> i32
    var i: i32 = 1
    while i < argc
        if i > 1
            putchar(32)
        puts(*(argv + i))
        i = i + 1
    println(c"")
    return 0

pub fn cmd_clear() -> i32
    puts(c"\e[2J\e[H")    # clear screen, cursor home
    return 0

pub fn print_prompt() -> i32
    puts(c"rzsh> ")
    return 0
