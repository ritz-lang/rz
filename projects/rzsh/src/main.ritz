# rzsh - Ritz Shell
#
# A simple interactive shell that runs on both Linux and Harland.
# OS-specific details are abstracted in the 'os' module using
# [[target_os]] conditional compilation.
#
# Runtime _start calls main() and then sys_exit(return_value).

import ritzlib.io { println }
import common { print_prompt, line_clear, print_raw_warning }
import os {
    os_environ, os_enable_raw_mode, os_disable_raw_mode
}

import parse { g_environ }
import state { ShellState, shell_state_new }
import shell { run_line }
import ritzlib.termsession { Key, KeyReader, key_reader }
import ritzlib.sys { STDIN }
import ritzlib.result
import history { history_reset_nav }
import editor {
    editor_handle_key, cli_mode,
    EDIT_CONTINUE, EDIT_EXIT,
    CLI_INTERACTIVE, CLI_HELP
}

import ritzlib.span { Span }
import ritzlib.gvec
import ritzlib.strview { StrView }

# ============================================================================
# Version string (selected at compile time)
# ============================================================================

[[target_os = "linux"]]
fn version_string() -> StrView
    return "rzsh - Ritz Shell v0.1 (linux)"

[[target_os = "harland"]]
fn version_string() -> StrView
    return "rzsh - Ritz Shell v0.1 (harland)"

# ============================================================================
# Help message
# ============================================================================

fn print_help()
    println(version_string())
    println("")
    println("Usage: rzsh [--help | -c LINE]")
    println("")
    println("Options:")
    println("  --help    Show this help message and exit")
    println("  -c LINE   Run LINE and exit with its status")
    println("")
    println("Built-in commands:")
    println("  help      Show available commands")
    println("  exit [N]  Exit the shell with code N (default 0)")
    println("  pid       Show current process ID")
    println("  echo ...  Print arguments")
    println("  ls [DIR]  List directory contents")
    println("  clear     Clear the screen")
    println("  cd [DIR]  Change directory      pwd        Print it")
    println("  export N[=V], unset N, N=V      Shell variables")
    println("")
    println("Syntax: $N $\{N\} $? expansion, '...' and double quotes, \\x,")
    println("  a ; b, # comments. Linux only: a > f, a >> f, a < f, a | b.")
    println("  Not supported: &&, ||, &, globbing, $(...), here-docs.")

# ============================================================================
# Main
# ============================================================================

# args[1] as a CLI mode; CLI_INTERACTIVE when there is none.
fn argv_mode(args: Span<StrView>) -> i32
    if args.len < 2
        return CLI_INTERACTIVE
    return cli_mode(args[1])

# --help and -c LINE run without a terminal (AGAST #3459).
fn run_cli(mode: i32, args: Span<StrView>) -> i32
    if mode == CLI_HELP
        print_help()
        return 0
    if args.len < 3
        println("rzsh: -c needs a command line")
        return 2
    return run_line(args[2])

fn print_banner()
    match os_enable_raw_mode()
        Ok(_) => pass
        Err(e) => print_raw_warning(-e.code())    # -errno, as the syscall said
    println("")
    println("===========================================")
    println(version_string())
    println("  Type 'help' for available commands")
    println("===========================================")
    println("")

# Read and edit one line. Returns EDIT_LINE_DONE or EDIT_EXIT.
fn read_line() -> i32
    print_prompt()
    line_clear()
    history_reset_nav()
    # A fresh reader per line: no half-read sequence carries over.
    var reader: KeyReader = key_reader(STDIN)
    var action: i32 = EDIT_CONTINUE
    while action == EDIT_CONTINUE
        action = match reader.read_key()
            Ok(key) => editor_handle_key(key)
            Err(_) => EDIT_EXIT     # end of input, or stdin unreadable
    return action

pub fn main(args: Span<StrView>) -> i32
    var st: ShellState = shell_state_new()
    st.install()
    # main's `env` owns the entries for the life of the shell.
    let env: Vec<StrView> = os_environ()
    let entries: [StrView] = env[0..env.len()]
    g_environ = entries
    let mode: i32 = argv_mode(args)
    if mode != CLI_INTERACTIVE
        return run_cli(mode, args)
    print_banner()
    while read_line() != EDIT_EXIT
        pass
    os_disable_raw_mode()
    println("Goodbye!")
    return 0
