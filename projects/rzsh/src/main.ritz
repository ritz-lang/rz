# rzsh - Ritz Shell
#
# A simple interactive shell that runs on both Linux and Harland.
# OS-specific details are abstracted in the 'os' module using
# [[target_os]] conditional compilation.
#
# Runtime _start calls main() and then sys_exit(return_value).

import common { puts, println, print_int, print_prompt, line_clear }

import os {
    os_yield, os_environ, os_input_ended,
    os_enable_raw_mode, os_disable_raw_mode
}

import parse { g_environ }
import shell { run_line }
import input { input_reset, input_parse_byte, KEY_NONE }
import history { history_reset_nav }
import editor {
    editor_handle_key, cli_mode,
    EDIT_CONTINUE, EDIT_EXIT,
    CLI_INTERACTIVE, CLI_HELP
}

import ritzlib.sys { sys_read, STDIN }

# ============================================================================
# Version string (selected at compile time)
# ============================================================================

[[target_os = "linux"]]
fn version_string() -> *u8
    return c"rzsh - Ritz Shell v0.1 (linux)"

[[target_os = "harland"]]
fn version_string() -> *u8
    return c"rzsh - Ritz Shell v0.1 (harland)"

# ============================================================================
# Help message
# ============================================================================

fn print_help()
    println(version_string())
    println(c"")
    println(c"Usage: rzsh [--help | -c LINE]")
    println(c"")
    println(c"Options:")
    println(c"  --help    Show this help message and exit")
    println(c"  -c LINE   Run LINE and exit with its status")
    println(c"")
    println(c"Built-in commands:")
    println(c"  help      Show available commands")
    println(c"  exit [N]  Exit the shell with code N (default 0)")
    println(c"  pid       Show current process ID")
    println(c"  echo ...  Print arguments")
    println(c"  ls [DIR]  List directory contents")
    println(c"  clear     Clear the screen")
    println(c"  cd [DIR]  Change directory      pwd        Print it")
    println(c"  export N[=V], unset N, N=V      Shell variables")
    println(c"")
    println(c"Syntax: $N ${N} $? expansion, '...' and double quotes, \\x,")
    println(c"  a ; b, # comments. Linux only: a > f, a >> f, a < f, a | b.")
    println(c"  Not supported: &&, ||, &, globbing, $(...), here-docs.")

# ============================================================================
# Main
# ============================================================================

# argv[1] as a CLI mode; CLI_INTERACTIVE when there is none.
fn argv_mode(argc: i32, argv: **u8) -> i32
    if argc < 2
        return CLI_INTERACTIVE
    return cli_mode(*(argv + 1))

# --help and -c LINE run without a terminal (AGAST #3459).
fn run_cli(mode: i32, argc: i32, argv: **u8) -> i32
    if mode == CLI_HELP
        print_help()
        return 0
    if argc < 3
        println(c"rzsh: -c needs a command line")
        return 2
    return run_line(*(argv + 2))

fn print_banner()
    let raw_result: i32 = os_enable_raw_mode()
    if raw_result != 0
        puts(c"Warning: Could not enable raw mode (")
        print_int(raw_result as i64)
        println(c")")
    println(c"")
    println(c"===========================================")
    println(version_string())
    println(c"  Type 'help' for available commands")
    println(c"===========================================")
    println(c"")

# Read and edit one line. Returns EDIT_LINE_DONE or EDIT_EXIT.
fn read_line() -> i32
    print_prompt()
    line_clear()
    history_reset_nav()
    input_reset()
    var read_buf: [1]u8
    var action: i32 = EDIT_CONTINUE
    while action == EDIT_CONTINUE
        let n: i64 = sys_read(STDIN, @read_buf[0], 1)
        if n > 0
            let key: i32 = input_parse_byte(read_buf[0])
            # KEY_NONE: in the middle of an escape sequence, keep reading
            if key != KEY_NONE
                action = editor_handle_key(key)
        else if os_input_ended(n)
            action = EDIT_EXIT
        else
            os_yield()
    return action

pub fn main(argc: i32, argv: **u8) -> i32
    g_environ = os_environ(argc, argv)
    let mode: i32 = argv_mode(argc, argv)
    if mode != CLI_INTERACTIVE
        return run_cli(mode, argc, argv)
    print_banner()
    while read_line() != EDIT_EXIT
        pass
    os_disable_raw_mode()
    println(c"Goodbye!")
    return 0
