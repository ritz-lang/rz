# lib/layout/block.ritz - Block formatting context layout
#
# Implements block-level layout: vertical stacking of block boxes,
# sibling margin collapsing, and auto-width fill of the containing block.
#
# Block Formatting Context (BFC):
# - Block boxes stack vertically
# - Each box's left margin edge touches the container's content edge
# - Vertical margins collapse between adjacent siblings
# - Parent/child margins do NOT collapse (the last child's bottom margin
#   is inside the parent's content height)
# - Floats and inline formatting are not implemented yet
#
# Coordinates: a node's LayoutResult x/y is its content box position relative
# to its parent's content box. layout_block writes every laid-out node's result
# into node.layout; the root keeps x = y = 0.
#
# Usage:
#   import lib.layout.block { layout_block }

import lib.style.mod {
    NodeId,
    node_id_is_valid,
    ComputedStyle,
    UNIT_AUTO,
    DISPLAY_NONE,
    DISPLAY_INLINE,
    DISPLAY_INLINE_FLEX,
    DISPLAY_INLINE_GRID
}
import lib.tree.mod { RenderTree, LayoutResult, layout_result_empty, render_tree_get_mut }
import lib.layout.box { LayoutConstraints, BoxDimensions, resolve_box_model }

# =============================================================================
# Block Layout
# =============================================================================

# Lay out the block box `node_id` and its subtree in `constraints`.
# Returns the node's result (also stored in node.layout); an unknown id
# yields layout_result_empty().
pub fn layout_block(tree: @&RenderTree, node_id: @NodeId, constraints: @LayoutConstraints) -> LayoutResult
    let node = render_tree_get_mut(tree, node_id)
    if node == null
        return layout_result_empty()
    # Copy what we need: the recursive calls below re-borrow the tree
    let style = node.style
    var child_id = node.first_child

    let box = resolve_box_model(@style, constraints)

    # Content width: auto fills the containing block
    var content_width = box.content_width
    if style.width.unit == UNIT_AUTO
        let h_extra = box.padding_left + box.padding_right + box.border_left + box.border_right + box.margin_left + box.margin_right
        content_width = constraints.available_width - h_extra
        if content_width < 0.0
            content_width = 0.0

    var height_definite: i32 = 1
    var available_height = box.content_height
    if style.height.unit == UNIT_AUTO
        height_definite = 0
        available_height = constraints.available_height

    let child_constraints = LayoutConstraints {
        available_width: content_width,
        available_height: available_height,
        viewport_width: constraints.viewport_width,
        viewport_height: constraints.viewport_height,
        font_size: style.text.font_size,
        root_font_size: constraints.root_font_size,
        width_definite: 1,
        height_definite: height_definite
    }

    # Lay out in-flow children, stacking border boxes vertically
    var content_height: f64 = 0.0
    var prev_margin_bottom: f64 = 0.0
    while node_id_is_valid(@child_id) != 0
        let child = render_tree_get_mut(tree, @child_id)
        if child == null
            break
        let display = child.style.display
        let next_id = child.next_sibling
        if display != DISPLAY_NONE
            var r = layout_child(tree, @child_id, display, @child_constraints)

            let collapsed = margin_collapse(prev_margin_bottom, r.margin_top as f64)
            let top = content_height + collapsed
            r.x = r.margin_left + r.border_left + r.padding_left
            r.y = top as i32 + r.border_top + r.padding_top

            let border_height = r.border_top + r.padding_top + r.height as i32 + r.padding_bottom + r.border_bottom
            content_height = top + border_height as f64
            prev_margin_bottom = r.margin_bottom as f64

            # Re-fetch: the recursion may have moved the node
            let placed = render_tree_get_mut(tree, @child_id)
            placed.layout = r
        child_id = next_id
    content_height = content_height + prev_margin_bottom

    # Explicit height wins over content height
    if style.height.unit != UNIT_AUTO
        content_height = box.content_height

    let result = LayoutResult {
        x: 0,
        y: 0,
        width: content_width as u32,
        height: content_height as u32,
        padding_top: box.padding_top as i32,
        padding_right: box.padding_right as i32,
        padding_bottom: box.padding_bottom as i32,
        padding_left: box.padding_left as i32,
        border_top: box.border_top as i32,
        border_right: box.border_right as i32,
        border_bottom: box.border_bottom as i32,
        border_left: box.border_left as i32,
        margin_top: box.margin_top as i32,
        margin_right: box.margin_right as i32,
        margin_bottom: box.margin_bottom as i32,
        margin_left: box.margin_left as i32,
        baseline: 0
    }
    let self_node = render_tree_get_mut(tree, node_id)
    self_node.layout = result
    result

# Dispatch on the child's display type (DISPLAY_*)
fn layout_child(tree: @&RenderTree, id: @NodeId, display: i32, c: @LayoutConstraints) -> LayoutResult
    # TODO: inline formatting context (line boxes); inline-level boxes are empty for now
    if display == DISPLAY_INLINE or display == DISPLAY_INLINE_FLEX or display == DISPLAY_INLINE_GRID
        return layout_result_empty()
    # Block, inline-block, flex, grid, contents: block layout until those
    # formatting contexts exist
    layout_block(tree, id, c)

# =============================================================================
# Margin Collapsing
# =============================================================================

# CSS margin collapsing of two adjacent vertical margins
pub fn margin_collapse(margin1: f64, margin2: f64) -> f64
    # Both non-negative: the larger
    if margin1 >= 0.0 and margin2 >= 0.0
        if margin1 > margin2
            return margin1
        return margin2
    # Both negative: the more negative
    if margin1 < 0.0 and margin2 < 0.0
        if margin1 < margin2
            return margin1
        return margin2
    # Mixed: positive plus negative
    margin1 + margin2
