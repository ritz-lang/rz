# lib/zlib_stream.ritz - Streaming Zlib compression/decompression (RFC 1950)
#
# Implements streaming API for zlib format:
# - ZlibWriter: incremental compression with persistent LZ77 state
# - ZlibReader: incremental decompression with buffering
#
# Zlib differs from gzip:
# - 2-byte header (CMF + FLG) instead of 10-byte gzip header
# - Adler-32 checksum instead of CRC32
# - Big-endian trailer instead of little-endian
#
# Compression is the shared streaming core (deflate_stream.ritz, also behind
# GzipWriter); this file adds the zlib header, Adler-32 and trailer.
#
# API:
# - zlib_writer_init(w, level) -> Initialize compressor
# - zlib_writer_write(w, data, len, out, cap) -> Write and maybe produce output
# - zlib_writer_flush(w, out, cap) -> Force output of pending data
# - zlib_writer_finish(w, out, cap) -> Finalize and write trailer
# - zlib_writer_free(w) -> Clean up resources
#
# - zlib_reader_init(r) -> Initialize decompressor
# - zlib_reader_read(r, data, len, out, cap) -> Read compressed data
# - zlib_reader_finish(r) -> Verify checksum
# - zlib_reader_free(r) -> Clean up resources

import ritzlib.sys
import ritzlib.io

import adler32
import deflate_stream
import inflate


# ============================================================================
# Constants
# ============================================================================

pub const ZLIB_STREAM_OK: i64 = 0
pub const ZLIB_STREAM_ERR_OUTPUT_FULL: i64 = -1
pub const ZLIB_STREAM_ERR_INVALID_LEVEL: i64 = -2
pub const ZLIB_STREAM_ERR_NOT_FINISHED: i64 = -3
pub const ZLIB_STREAM_ERR_CHECKSUM_MISMATCH: i64 = -4
pub const ZLIB_STREAM_ERR_INVALID_HEADER: i64 = -5
pub const ZLIB_STREAM_ERR_INFLATE_FAILED: i64 = -6

# Zlib header constants
const ZLIB_CM_DEFLATE: u8 = 8
const ZLIB_CINFO_32K: u8 = 7
const ZLIB_HEADER_SIZE: i64 = 2
const ZLIB_TRAILER_SIZE: i64 = 4

# Reader states
const RSTATE_HEADER: i32 = 0
const RSTATE_DATA: i32 = 1
const RSTATE_TRAILER: i32 = 2
const RSTATE_DONE: i32 = 3


# ============================================================================
# ZlibWriter - Streaming Compression
# ============================================================================

pub struct ZlibWriter
    core: DeflateStream             # Shared streaming deflate (deflate_stream.ritz)

    # Checksum state
    adler: u32                      # Running Adler-32
    total_in: i64                   # Total bytes input


# Initialize a ZlibWriter
pub fn zlib_writer_init(w: *ZlibWriter, level: i32) -> i32
    if level < 0
        return -1
    if level > 9
        return -1

    deflate_stream_init(@w.core, level)
    w.adler = adler32_init()
    w.total_in = 0
    return 0


# Write zlib header to output
fn write_zlib_header(out: *u8, cap: i64) -> i64
    if cap < ZLIB_HEADER_SIZE
        return ZLIB_STREAM_ERR_OUTPUT_FULL

    # CMF byte: CINFO=7 (32K window), CM=8 (deflate)
    let cmf: u8 = (ZLIB_CINFO_32K << 4) | ZLIB_CM_DEFLATE  # 0x78

    # FLG byte: FLEVEL=2, FDICT=0, FCHECK calculated
    let flevel: u8 = 2 << 6  # 0x80 (default compression)
    let base_flg: u8 = flevel

    # Calculate FCHECK
    let header_base: u32 = ((cmf as u32) << 8) | (base_flg as u32)
    let remainder: u32 = header_base % 31
    var fcheck: u8 = 0
    if remainder != 0
        fcheck = (31 - remainder) as u8

    let flg: u8 = base_flg | fcheck

    out[0] = cmf
    out[1] = flg

    return ZLIB_HEADER_SIZE


# Write data to the compressor; the first call also writes the zlib header.
# Returns bytes written to `out`, or a negative error.
pub fn zlib_writer_write(w: *ZlibWriter, data: *u8, len: i64, out: *u8, out_cap: i64) -> i64
    var out_start: i64 = 0
    if w.core.state == DEFLATE_STREAM_INIT
        let header_len: i64 = write_zlib_header(out, out_cap)
        if header_len < 0
            return header_len
        out_start = header_len

    w.adler = adler32_update(w.adler, data, len)
    w.total_in = w.total_in + len

    return deflate_stream_write(@w.core, data, len, out, out_start, out_cap)


# Flush pending data: ends the current deflate block and starts a new
# non-final one. The bit stream is NOT byte-aligned after flush.
pub fn zlib_writer_flush(w: *ZlibWriter, out: *u8, out_cap: i64) -> i64
    return deflate_stream_flush(@w.core, out, out_cap)


# Finish compression and write the Adler-32 trailer (big-endian). With no
# data written, also writes the header and an empty final block.
pub fn zlib_writer_finish(w: *ZlibWriter, out: *u8, out_cap: i64) -> i64
    if w.core.state == DEFLATE_STREAM_FINISHED
        return 0

    var out_start: i64 = 0
    if w.core.state == DEFLATE_STREAM_INIT
        let header_len: i64 = write_zlib_header(out, out_cap)
        if header_len < 0
            return header_len
        out_start = header_len

    var pos: i64 = deflate_stream_finish(@w.core, out, out_start, out_cap)

    if pos + ZLIB_TRAILER_SIZE > out_cap
        return ZLIB_STREAM_ERR_OUTPUT_FULL

    let checksum: u32 = w.adler
    for i in 0..4
        out[pos + i] = ((checksum >> (24 - 8 * i) as u32) & 0xFF) as u8

    return pos + ZLIB_TRAILER_SIZE


# Free resources
pub fn zlib_writer_free(w: *ZlibWriter)
    deflate_stream_free(@w.core)
    return


# ============================================================================
# ZlibReader - Streaming Decompression
# ============================================================================

pub struct ZlibReader
    # State
    state: i32                      # Current reader state

    # Input buffering
    in_buf: [256]u8                 # Buffer for partial input
    in_buf_len: i64                 # Valid bytes in buffer

    # Output buffer pointer (set on first read with non-null output)
    out_buf: *u8
    out_cap: i64

    # Decompression state
    adler: u32                      # Running Adler-32
    total_out: i64                  # Total bytes output

    # Expected values from trailer
    expected_adler: u32


# Initialize a ZlibReader
pub fn zlib_reader_init(r: *ZlibReader) -> i32
    r.state = RSTATE_HEADER
    r.in_buf_len = 0
    r.out_buf = nil
    r.out_cap = 0
    r.adler = adler32_init()
    r.total_out = 0
    r.expected_adler = 0
    return 0


# Read compressed data into internal buffer
# Returns 0 while buffering, or bytes decompressed on success
# For chunked input, call multiple times then finish()
pub fn zlib_reader_read(r: *ZlibReader, data: *u8, len: i64, out: *u8, out_cap: i64) -> i64
    # Save output buffer info for finish()
    if r.out_buf == nil
        r.out_buf = out
        r.out_cap = out_cap

    # Copy data to internal buffer
    for i in 0..len
        if r.in_buf_len < 256
            r.in_buf[r.in_buf_len] = data[i]
            r.in_buf_len = r.in_buf_len + 1

    # Parse header if needed
    if r.state == RSTATE_HEADER
        if r.in_buf_len < ZLIB_HEADER_SIZE
            return 0

        let cmf: u8 = r.in_buf[0]
        let cm: u8 = cmf & 0x0F
        let cinfo: u8 = cmf >> 4

        if cm != ZLIB_CM_DEFLATE
            return ZLIB_STREAM_ERR_INVALID_HEADER
        if cinfo > 7
            return ZLIB_STREAM_ERR_INVALID_HEADER

        let flg: u8 = r.in_buf[1]

        # Verify checksum
        let header_check: u32 = ((cmf as u32) << 8) | (flg as u32)
        if header_check % 31 != 0
            return ZLIB_STREAM_ERR_INVALID_HEADER

        # Check FDICT (not supported)
        if (flg & 0x20) != 0
            return ZLIB_STREAM_ERR_INVALID_HEADER

        r.state = RSTATE_DATA

    # Return 0 while buffering - actual decompression happens in finish()
    return 0


# Finish decompression and verify checksum
# This is where actual decompression happens
pub fn zlib_reader_finish(r: *ZlibReader) -> i32
    if r.state == RSTATE_DONE
        # Already finished
        if r.adler != r.expected_adler
            return -2
        return 0

    if r.state != RSTATE_DATA
        return -1  # Not enough data for header

    # Calculate deflate data length
    let deflate_len: i64 = r.in_buf_len - ZLIB_HEADER_SIZE - ZLIB_TRAILER_SIZE
    if deflate_len < 0
        return -1  # Need more data

    # Decompress
    let result: i64 = inflate(@r.in_buf[ZLIB_HEADER_SIZE], deflate_len, r.out_buf, r.out_cap)
    if result < 0
        return -3  # Decompression failed

    # Compute Adler-32 checksum
    r.adler = adler32(r.out_buf, result)
    r.total_out = result

    # Read trailer (big-endian)
    let trailer_pos: i64 = r.in_buf_len - ZLIB_TRAILER_SIZE
    let adler_b0: u32 = r.in_buf[trailer_pos] as u32
    let adler_b1: u32 = r.in_buf[trailer_pos + 1] as u32
    let adler_b2: u32 = r.in_buf[trailer_pos + 2] as u32
    let adler_b3: u32 = r.in_buf[trailer_pos + 3] as u32
    r.expected_adler = (adler_b0 << 24) | (adler_b1 << 16) | (adler_b2 << 8) | adler_b3

    r.state = RSTATE_DONE

    # Verify checksum
    if r.adler != r.expected_adler
        return -2

    return 0


# Free resources
pub fn zlib_reader_free(r: *ZlibReader)
    r.state = RSTATE_HEADER
    return
