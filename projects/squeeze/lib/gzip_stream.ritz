# lib/gzip_stream.ritz - Streaming Gzip compression/decompression (RFC 1952)
#
# Implements streaming API for gzip format:
# - GzipWriter: incremental compression with persistent LZ77 state
# - GzipReader: incremental decompression with buffering
#
# Key design decisions:
# - Fixed memory footprint after init (no dynamic allocation)
# - Compression is the shared streaming core (deflate_stream.ritz, also
#   behind ZlibWriter); this file adds the gzip header, CRC32 and trailer
# - Incremental CRC32 checksum
#
# API:
# - gzip_writer_init(w, level) -> Initialize compressor
# - gzip_writer_write(w, data, len, out, cap) -> Write and maybe produce output
# - gzip_writer_flush(w, out, cap) -> Force output of pending data
# - gzip_writer_finish(w, out, cap) -> Finalize and write trailer
# - gzip_writer_free(w) -> Clean up resources
#
# - gzip_reader_init(r) -> Initialize decompressor
# - gzip_reader_read(r, data, len, out, cap) -> Read compressed data
# - gzip_reader_finish(r) -> Verify checksum and size
# - gzip_reader_free(r) -> Clean up resources

import ritzlib.sys
import ritzlib.io

import crc32
import deflate_stream
import inflate


# ============================================================================
# Constants
# ============================================================================

pub const GZIP_STREAM_OK: i64 = 0
pub const GZIP_STREAM_ERR_OUTPUT_FULL: i64 = -1
pub const GZIP_STREAM_ERR_INVALID_LEVEL: i64 = -2
pub const GZIP_STREAM_ERR_NOT_FINISHED: i64 = -3
pub const GZIP_STREAM_ERR_CRC_MISMATCH: i64 = -4
pub const GZIP_STREAM_ERR_SIZE_MISMATCH: i64 = -5
pub const GZIP_STREAM_ERR_INVALID_HEADER: i64 = -6
pub const GZIP_STREAM_ERR_INFLATE_FAILED: i64 = -7

# Gzip header constants
const GZIP_MAGIC_1: u8 = 0x1f
const GZIP_MAGIC_2: u8 = 0x8b
const GZIP_CM_DEFLATE: u8 = 8
const GZIP_OS_UNIX: u8 = 3
const GZIP_HEADER_SIZE: i64 = 10
const GZIP_TRAILER_SIZE: i64 = 8

# Reader states
const RSTATE_HEADER: i32 = 0
const RSTATE_DATA: i32 = 1
const RSTATE_TRAILER: i32 = 2
const RSTATE_DONE: i32 = 3


# ============================================================================
# GzipWriter - Streaming Compression
# ============================================================================

pub struct GzipWriter
    core: DeflateStream             # Shared streaming deflate (deflate_stream.ritz)

    # Checksum state
    crc: u32                        # Running CRC32
    total_in: i64                   # Total bytes input


# Initialize a GzipWriter
pub fn gzip_writer_init(w: *GzipWriter, level: i32) -> i32
    if level < 0
        return -1
    if level > 9
        return -1

    deflate_stream_init(@w.core, level)
    w.crc = crc32_init()
    w.total_in = 0
    return 0


# Write gzip header to output
fn write_gzip_header(out: *u8, cap: i64) -> i64
    if cap < GZIP_HEADER_SIZE
        return GZIP_STREAM_ERR_OUTPUT_FULL

    out[0] = GZIP_MAGIC_1
    out[1] = GZIP_MAGIC_2
    out[2] = GZIP_CM_DEFLATE
    out[3] = 0  # FLG = 0 (no optional fields)
    out[4] = 0  # MTIME = 0
    out[5] = 0
    out[6] = 0
    out[7] = 0
    out[8] = 0  # XFL = 0
    out[9] = GZIP_OS_UNIX

    return GZIP_HEADER_SIZE


# Write data to the compressor; the first call also writes the gzip header.
# Returns bytes written to `out`, or a negative error.
pub fn gzip_writer_write(w: *GzipWriter, data: *u8, len: i64, out: *u8, out_cap: i64) -> i64
    var out_start: i64 = 0
    if w.core.state == DEFLATE_STREAM_INIT
        let header_len: i64 = write_gzip_header(out, out_cap)
        if header_len < 0
            return header_len
        out_start = header_len

    w.crc = crc32_update(w.crc, data, len)
    w.total_in = w.total_in + len

    return deflate_stream_write(@w.core, data, len, out, out_start, out_cap)


# Flush pending data (for chunked responses): ends the current deflate block
# and starts a new non-final one. The bit stream is NOT byte-aligned after
# flush, which is intentional: deflate blocks can span byte boundaries.
pub fn gzip_writer_flush(w: *GzipWriter, out: *u8, out_cap: i64) -> i64
    return deflate_stream_flush(@w.core, out, out_cap)


# Finish compression and write the trailer (CRC32 + ISIZE, little-endian).
# With no data written, also writes the header and an empty final block.
pub fn gzip_writer_finish(w: *GzipWriter, out: *u8, out_cap: i64) -> i64
    if w.core.state == DEFLATE_STREAM_FINISHED
        return 0  # Already finished

    var out_start: i64 = 0
    if w.core.state == DEFLATE_STREAM_INIT
        let header_len: i64 = write_gzip_header(out, out_cap)
        if header_len < 0
            return header_len
        out_start = header_len

    var pos: i64 = deflate_stream_finish(@w.core, out, out_start, out_cap)

    if pos + GZIP_TRAILER_SIZE > out_cap
        return GZIP_STREAM_ERR_OUTPUT_FULL

    let final_crc: u32 = crc32_final(w.crc)
    let isize: u32 = (w.total_in & 0xFFFFFFFF) as u32
    for i in 0..4
        out[pos + i] = ((final_crc >> (8 * i) as u32) & 0xFF) as u8
    for i in 0..4
        out[pos + 4 + i] = ((isize >> (8 * i) as u32) & 0xFF) as u8

    return pos + GZIP_TRAILER_SIZE


# Free resources (no-op for stack-allocated buffers)
pub fn gzip_writer_free(w: *GzipWriter)
    deflate_stream_free(@w.core)
    return


# ============================================================================
# GzipReader - Streaming Decompression
# ============================================================================

pub struct GzipReader
    # State
    state: i32                      # Current reader state

    # Input buffering for incomplete reads
    in_buf: [256]u8                 # Buffer for partial input
    in_buf_len: i64                 # Valid bytes in buffer

    # Output buffer pointer (set on first read)
    out_buf: *u8
    out_cap: i64

    # Header info
    flags: u8                       # Gzip flags

    # Decompression state
    crc: u32                        # Running CRC32
    total_out: i64                  # Total bytes output

    # Expected values from trailer
    expected_crc: u32
    expected_size: u32


# Initialize a GzipReader
pub fn gzip_reader_init(r: *GzipReader) -> i32
    r.state = RSTATE_HEADER
    r.in_buf_len = 0
    r.out_buf = nil
    r.out_cap = 0
    r.flags = 0
    r.crc = crc32_init()
    r.total_out = 0
    r.expected_crc = 0
    r.expected_size = 0
    return 0


# Read compressed data into internal buffer
# Returns 0 while buffering, or negative on error
# For chunked input, call multiple times then finish()
pub fn gzip_reader_read(r: *GzipReader, data: *u8, len: i64, out: *u8, out_cap: i64) -> i64
    # Save output buffer info for finish()
    if r.out_buf == nil
        r.out_buf = out
        r.out_cap = out_cap

    # Copy data to internal buffer
    for i in 0..len
        if r.in_buf_len < 256
            r.in_buf[r.in_buf_len] = data[i]
            r.in_buf_len = r.in_buf_len + 1

    # Parse header if needed
    if r.state == RSTATE_HEADER
        if r.in_buf_len < GZIP_HEADER_SIZE
            return 0  # Need more data

        # Verify magic bytes
        if r.in_buf[0] != GZIP_MAGIC_1
            return GZIP_STREAM_ERR_INVALID_HEADER
        if r.in_buf[1] != GZIP_MAGIC_2
            return GZIP_STREAM_ERR_INVALID_HEADER
        if r.in_buf[2] != GZIP_CM_DEFLATE
            return GZIP_STREAM_ERR_INVALID_HEADER

        r.flags = r.in_buf[3]
        r.state = RSTATE_DATA

    # Return 0 while buffering - actual decompression happens in finish()
    return 0


# Helper to compute header skip amount
fn gzip_reader_header_skip(r: *GzipReader) -> i64
    var header_skip: i64 = GZIP_HEADER_SIZE

    # Skip optional fields based on flags
    # FEXTRA
    if (r.flags & 0x04) != 0
        if r.in_buf_len < header_skip + 2
            return -1
        let xlen: i64 = (r.in_buf[header_skip] as i64) | ((r.in_buf[header_skip + 1] as i64) << 8)
        header_skip = header_skip + 2 + xlen

    # FNAME
    if (r.flags & 0x08) != 0
        while header_skip < r.in_buf_len
            if r.in_buf[header_skip] == 0
                header_skip = header_skip + 1
                break
            header_skip = header_skip + 1

    # FCOMMENT
    if (r.flags & 0x10) != 0
        while header_skip < r.in_buf_len
            if r.in_buf[header_skip] == 0
                header_skip = header_skip + 1
                break
            header_skip = header_skip + 1

    # FHCRC
    if (r.flags & 0x02) != 0
        header_skip = header_skip + 2

    return header_skip


# Finish decompression and verify checksum
# This is where actual decompression happens
pub fn gzip_reader_finish(r: *GzipReader) -> i32
    if r.state == RSTATE_DONE
        # Already finished, verify
        let actual_crc: u32 = crc32_final(r.crc)
        if actual_crc != r.expected_crc
            return -2
        let actual_size: u32 = (r.total_out & 0xFFFFFFFF) as u32
        if actual_size != r.expected_size
            return -3
        return 0

    if r.state != RSTATE_DATA
        return -1  # Not enough data for header

    # Calculate header skip amount
    let header_skip: i64 = gzip_reader_header_skip(r)
    if header_skip < 0
        return -1

    # Calculate deflate data length
    let deflate_len: i64 = r.in_buf_len - header_skip - GZIP_TRAILER_SIZE
    if deflate_len < 0
        return -1  # Need more data

    # Decompress
    let result: i64 = inflate(@r.in_buf[header_skip], deflate_len, r.out_buf, r.out_cap)
    if result < 0
        return -3  # Decompression failed

    # Compute CRC32 directly
    r.crc = crc32(r.out_buf, result)
    r.total_out = result

    # Read trailer (little-endian)
    let trailer_pos: i64 = r.in_buf_len - GZIP_TRAILER_SIZE
    let crc_b0: u32 = r.in_buf[trailer_pos] as u32
    let crc_b1: u32 = r.in_buf[trailer_pos + 1] as u32
    let crc_b2: u32 = r.in_buf[trailer_pos + 2] as u32
    let crc_b3: u32 = r.in_buf[trailer_pos + 3] as u32
    r.expected_crc = crc_b0 | (crc_b1 << 8) | (crc_b2 << 16) | (crc_b3 << 24)

    let size_b0: u32 = r.in_buf[trailer_pos + 4] as u32
    let size_b1: u32 = r.in_buf[trailer_pos + 5] as u32
    let size_b2: u32 = r.in_buf[trailer_pos + 6] as u32
    let size_b3: u32 = r.in_buf[trailer_pos + 7] as u32
    r.expected_size = size_b0 | (size_b1 << 8) | (size_b2 << 16) | (size_b3 << 24)

    r.state = RSTATE_DONE

    # Verify checksum
    if r.crc != r.expected_crc
        return -2

    # Verify size
    let actual_size: u32 = (r.total_out & 0xFFFFFFFF) as u32
    if actual_size != r.expected_size
        return -4

    return 0


# Free resources
pub fn gzip_reader_free(r: *GzipReader)
    r.state = RSTATE_HEADER
    return
