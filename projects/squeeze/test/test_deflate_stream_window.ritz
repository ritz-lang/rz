# test/test_deflate_stream_window.ritz - The streaming match search reads only
# bytes that are really in the window (AGAST #4611)
#
# deflate_stream.ritz keeps a 32KB ring window that init never clears.  The
# match search must compare input only against bytes it has written there:
#
# - an overlapping match (distance < length) runs past window_pos into slots
#   this pass has not written; those bytes are the input itself
# - at distance 32768 the candidate's first slot is the one the current byte
#   just overwrote
#
# Reading either from the ring makes the output depend on leftover memory
# (Valet mallocs these writers, so that is heap garbage) or emits a match the
# decoder expands to different bytes.  So: a writer pre-filled with any
# garbage must give the same bytes as a zeroed one, and every stream must
# decode back to its input.

import ritzlib.sys
import ritzlib.io
import ritzlib.str

import lib.gzip
import lib.gzip_stream
import lib.zlib
import lib.zlib_stream

const IN_CAP: i64 = 40000
const OUT_CAP: i64 = 65536

var g_in: [40000]u8
var g_out_a: [65536]u8
var g_out_b: [65536]u8
var g_chunk: [65536]u8
var g_back: [40000]u8
var g_gz: GzipWriter
var g_zl: ZlibWriter


# Deterministic LCG step; stays below 2^31 so i64 never overflows.
fn win_lcg(seed: i64) -> i64
    return (seed * 1103515245 + 12345) & 0x7FFFFFFF


# Runs and repeats: overlapping matches (distance 1 and short periods) that
# reach past window_pos, mixed with literal noise.  Returns its length.
fn win_build_runs() -> i64
    var pos: i64 = 0
    var seed: i64 = 4611
    while pos < 20000
        seed = win_lcg(seed)
        let kind: i64 = (seed >> 8) % 3
        seed = win_lcg(seed)
        let n: i64 = 4 + (seed >> 8) % 300
        if kind == 0
            # A run of one byte ('Z' or 'Q').
            var c: u8 = 'Z'
            if ((seed >> 4) & 1) == 1
                c = 'Q'
            for i in 0..n
                g_in[pos] = c
                pos = pos + 1
        else if kind == 1
            # A short period: "abc" repeated.
            for i in 0..n
                g_in[pos] = ('a' as i64 + i % 3) as u8
                pos = pos + 1
        else
            for i in 0..n
                seed = win_lcg(seed)
                g_in[pos] = ((seed >> 16) & 0xFF) as u8
                pos = pos + 1
    return pos


# Gzip `len` bytes of g_in into `out` with a writer pre-filled with `fill`:
# writes of `chunk` bytes, a flush after each.  Returns the stream length.
fn win_gzip(len: i64, fill: u8, chunk: i64, out: *u8) -> i64
    memset(@g_gz as *u8, fill, sizeof(GzipWriter))
    gzip_writer_init(@g_gz, 6)
    var pos: i64 = 0
    var off: i64 = 0
    while off < len
        var n: i64 = len - off
        if n > chunk
            n = chunk
        let w: i64 = gzip_writer_write(@g_gz, @g_in[off], n, out + pos, OUT_CAP - pos)
        if w < 0
            return -100
        pos = pos + w
        let f: i64 = gzip_writer_flush(@g_gz, out + pos, OUT_CAP - pos)
        if f < 0
            return -101
        pos = pos + f
        off = off + n
    let t: i64 = gzip_writer_finish(@g_gz, out + pos, OUT_CAP - pos)
    if t < 0
        return -102
    return pos + t


# ZlibWriter twin of win_gzip, at level 9 (longest chains).
fn win_zlib(len: i64, fill: u8, chunk: i64, out: *u8) -> i64
    memset(@g_zl as *u8, fill, sizeof(ZlibWriter))
    zlib_writer_init(@g_zl, 9)
    var pos: i64 = 0
    var off: i64 = 0
    while off < len
        var n: i64 = len - off
        if n > chunk
            n = chunk
        let w: i64 = zlib_writer_write(@g_zl, @g_in[off], n, out + pos, OUT_CAP - pos)
        if w < 0
            return -100
        pos = pos + w
        let f: i64 = zlib_writer_flush(@g_zl, out + pos, OUT_CAP - pos)
        if f < 0
            return -101
        pos = pos + f
        off = off + n
    let t: i64 = zlib_writer_finish(@g_zl, out + pos, OUT_CAP - pos)
    if t < 0
        return -102
    return pos + t


# 0 if stream `out[0..n]` decodes to g_in[0..len]; prints and 1 otherwise.
fn win_roundtrip(name: StrView, out: *u8, n: i64, len: i64, is_gzip: bool) -> i32
    if n < 0
        prints(name)
        print(": writer error ")
        print_i64(n)
        print("\n")
        return 1
    var got: i64 = 0
    if is_gzip
        got = gzip_decompress(out, n, @g_back[0], IN_CAP)
    else
        got = zlib_decompress(out, n, @g_back[0], IN_CAP)
    var bad: i64 = -1
    if got == len
        for i in 0..len
            if g_back[i] != g_in[i]
                bad = i
                break
    if got != len or bad >= 0
        prints(name)
        print(": does not round-trip, got ")
        print_i64(got)
        print(" bytes, first bad byte ")
        print_i64(bad)
        print("\n")
        return 1
    return 0


# 0 if out_a[0..na] == out_b[0..nb]; prints and 1 otherwise.
fn win_same(name: StrView, na: i64, nb: i64) -> i32
    var diff: i64 = -1
    if na == nb
        for i in 0..na
            if g_out_a[i] != g_out_b[i]
                diff = i
                break
    if na != nb or diff >= 0
        prints(name)
        print(": output depends on window garbage: len ")
        print_i64(na)
        print(" vs ")
        print_i64(nb)
        print(", first diff at ")
        print_i64(diff)
        print("\n")
        return 1
    return 0


[[test]]
fn test_stream_window_garbage_gzip() -> i32
    # Zeroed writer vs writers full of 'Z', 'a' and 0xA5: same bytes, and
    # every stream decodes back.  Chunks of 1000 with a flush after each.
    let len: i64 = win_build_runs()
    var fails: i32 = 0
    let na: i64 = win_gzip(len, 0, 1000, @g_out_a[0])
    fails = fails + win_roundtrip("gzip zeroed", @g_out_a[0], na, len, true)
    var nb: i64 = win_gzip(len, 'Z', 1000, @g_out_b[0])
    fails = fails + win_roundtrip("gzip fill Z", @g_out_b[0], nb, len, true)
    fails = fails + win_same("gzip fill Z", na, nb)
    nb = win_gzip(len, 'a', 1000, @g_out_b[0])
    fails = fails + win_roundtrip("gzip fill a", @g_out_b[0], nb, len, true)
    fails = fails + win_same("gzip fill a", na, nb)
    nb = win_gzip(len, 0xA5, 1000, @g_out_b[0])
    fails = fails + win_roundtrip("gzip fill A5", @g_out_b[0], nb, len, true)
    fails = fails + win_same("gzip fill A5", na, nb)
    return fails


[[test]]
fn test_stream_window_garbage_zlib() -> i32
    let len: i64 = win_build_runs()
    var fails: i32 = 0
    let na: i64 = win_zlib(len, 0, 777, @g_out_a[0])
    fails = fails + win_roundtrip("zlib zeroed", @g_out_a[0], na, len, false)
    let nb: i64 = win_zlib(len, 'Z', 777, @g_out_b[0])
    fails = fails + win_roundtrip("zlib fill Z", @g_out_b[0], nb, len, false)
    fails = fails + win_same("zlib fill Z", na, nb)
    return fails


[[test]]
fn test_stream_run_uses_overlapping_match() -> i32
    # 1000 'Z's: after the first literal, distance-1 matches cover the rest
    # (the decoder copies byte by byte).  Reading only written slots, that
    # is ~4 length-258 matches: well under 40 bytes, not ~1000 literals.
    for i in 0..1000
        g_in[i] = 'Z'
    let n: i64 = win_gzip(1000, 0, 1000, @g_out_a[0])
    if win_roundtrip("gzip run", @g_out_a[0], n, 1000, true) != 0
        return 1
    if n > 60
        print("gzip run: ")
        print_i64(n)
        print(" bytes for 1000 'Z', overlapping matches not found\n")
        return 1
    return 0


[[test]]
fn test_stream_distance_32768_roundtrip() -> i32
    # 'A' (0x41) and 'a' (0x61) differ only in bit 5, which the hash shifts
    # out (b0 << 10, masked to 15 bits), so "Abc" and "abc" share a chain.
    # "abc" sits exactly 32768 after "Abc": at that distance the candidate's
    # first slot is the one 'a' just overwrote.  Reading it there says the
    # match starts with 'a'; the decoder copies the 'A' from 32768 back.
    var pos: i64 = 0
    g_in[0] = 'x'
    g_in[1] = 'y'
    g_in[2] = 'A'
    g_in[3] = 'b'
    g_in[4] = 'c'
    g_in[5] = 'd'
    g_in[6] = 'e'
    g_in[7] = 'f'
    pos = 8
    while pos < 2 + 32768
        g_in[pos] = '.'
        pos = pos + 1
    g_in[pos] = 'a'
    g_in[pos + 1] = 'b'
    g_in[pos + 2] = 'c'
    g_in[pos + 3] = 'd'
    g_in[pos + 4] = 'e'
    g_in[pos + 5] = 'f'
    g_in[pos + 6] = '!'
    let len: i64 = pos + 7
    var fails: i32 = 0
    let ng: i64 = win_gzip(len, 0, len, @g_out_a[0])
    fails = fails + win_roundtrip("gzip distance 32768", @g_out_a[0], ng, len, true)
    let nz: i64 = win_zlib(len, 0, len, @g_out_a[0])
    fails = fails + win_roundtrip("zlib distance 32768", @g_out_a[0], nz, len, false)
    return fails
