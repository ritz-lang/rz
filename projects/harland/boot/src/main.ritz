# Harland UEFI Bootloader
#
# A minimal UEFI bootloader written in Ritz that:
# 1. Initializes serial for debug output
# 2. Gets memory map from UEFI
# 3. Sets up higher-half page tables
# 4. Exits boot services
# 5. Jumps to kernel at higher-half address
#
# UEFI is nice because we're already in 64-bit long mode!
#
# This code is compiled with clang for Windows/UEFI target, so it uses
# Microsoft x64 calling convention (RCX, RDX, R8, R9). UEFI also uses
# MS x64, so we can call UEFI services directly without wrappers!
#
# At the end, we use inline assembly to jump to the kernel with
# System V calling convention (RDI, RSI, RDX, RCX, R8, R9).

# Shared with the kernel through the boot_abi package (AGAST #4578): the boot handoff, the
# ELF64 layouts and the polled COM1 driver are declared once.
import boot_abi.handoff { HarlandBootInfo, HarlandMemEntry, HARLAND_BOOT_MAGIC, HARLAND_BOOT_VERSION, HARLAND_BOOT_FLAG_NET_SELFTEST, HARLAND_BOOT_FLAG_NET_RESPONDER, HARLAND_BOOT_FLAG_KLOG_DUMP, HARLAND_BOOT_FLAG_BOOT_TEST, HARLAND_MEM_USABLE, HARLAND_MEM_RESERVED, HARLAND_MEM_ACPI_RECLAIMABLE }
import boot_abi.elf64 { Elf64Ehdr, Elf64Phdr, Elf64Shdr, Elf64Sym, ELF_MAGIC, PT_LOAD, SHT_SYMTAB }
import boot_abi.serial { serial_init, serial_write, print_hex_prefix, serial_print_udec }

# ============================================================================
# UEFI Types and Constants
# ============================================================================

const EFI_SUCCESS: u64 = 0
const EFI_LOAD_ERROR: u64 = 1
const EFI_INVALID_PARAMETER: u64 = 2
const EFI_UNSUPPORTED: u64 = 3
const EFI_BAD_BUFFER_SIZE: u64 = 4
const EFI_BUFFER_TOO_SMALL: u64 = 5
const EFI_NOT_READY: u64 = 6
const EFI_DEVICE_ERROR: u64 = 7
const EFI_OUT_OF_RESOURCES: u64 = 9
const EFI_NOT_FOUND: u64 = 14

# Memory types
const EFI_RESERVED_MEMORY: u32 = 0
const EFI_LOADER_CODE: u32 = 1
const EFI_LOADER_DATA: u32 = 2
const EFI_BOOT_SERVICES_CODE: u32 = 3
const EFI_BOOT_SERVICES_DATA: u32 = 4
const EFI_RUNTIME_SERVICES_CODE: u32 = 5
const EFI_RUNTIME_SERVICES_DATA: u32 = 6
const EFI_CONVENTIONAL_MEMORY: u32 = 7
const EFI_UNUSABLE_MEMORY: u32 = 8
const EFI_ACPI_RECLAIM_MEMORY: u32 = 9
const EFI_ACPI_MEMORY_NVS: u32 = 10
const EFI_MEMORY_MAPPED_IO: u32 = 11
const EFI_MEMORY_MAPPED_IO_PORT: u32 = 12
const EFI_PAL_CODE: u32 = 13

# Allocation types
const ALLOCATE_ANY_PAGES: u32 = 0
const ALLOCATE_MAX_ADDRESS: u32 = 1
const ALLOCATE_ADDRESS: u32 = 2

# ============================================================================
# UEFI Structures
# ============================================================================

[[packed]]
struct EfiTableHeader
    signature: u64
    revision: u32
    header_size: u32
    crc32: u32
    reserved: u32

[[packed]]
struct EfiSystemTable
    hdr: EfiTableHeader
    firmware_vendor: *u16
    firmware_revision: u32
    _pad1: u32
    console_in_handle: u64
    con_in: *u8
    console_out_handle: u64
    con_out: *EfiSimpleTextOutput
    stderr_handle: u64
    std_err: *u8
    runtime_services: *u8
    boot_services: *EfiBootServices
    number_of_table_entries: u64
    configuration_table: *u8

[[packed]]
struct EfiSimpleTextOutput
    reset: *u8
    output_string: *u8
    test_string: *u8
    query_mode: *u8
    set_mode: *u8
    set_attribute: *u8
    clear_screen: *u8
    set_cursor_position: *u8
    enable_cursor: *u8
    mode: *u8

# EfiBootServices - we only define the fields we need
# Full table is much larger, but we access by offset
[[packed]]
struct EfiBootServices
    hdr: EfiTableHeader              # 0-23 (24 bytes)
    raise_tpl: *u8                   # 24
    restore_tpl: *u8                 # 32
    allocate_pages: *u8              # 40
    free_pages: *u8                  # 48
    get_memory_map: *u8              # 56
    allocate_pool: *u8               # 64
    free_pool: *u8                   # 72
    create_event: *u8                # 80
    set_timer: *u8                   # 88
    wait_for_event: *u8              # 96
    signal_event: *u8                # 104
    close_event: *u8                 # 112
    check_event: *u8                 # 120
    install_protocol_interface: *u8  # 128
    reinstall_protocol_interface: *u8 # 136
    uninstall_protocol_interface: *u8 # 144
    handle_protocol: *u8             # 152
    reserved: *u8                    # 160
    register_protocol_notify: *u8    # 168
    locate_handle: *u8               # 176
    locate_device_path: *u8          # 184
    install_configuration_table: *u8 # 192
    load_image: *u8                  # 200
    start_image: *u8                 # 208
    exit: *u8                        # 216
    unload_image: *u8                # 224
    exit_boot_services: *u8          # 232
    get_next_monotonic_count: *u8    # 240
    stall: *u8                       # 248
    set_watchdog_timer: *u8          # 256
    connect_controller: *u8          # 264
    disconnect_controller: *u8       # 272
    open_protocol: *u8               # 280
    close_protocol: *u8              # 288
    open_protocol_information: *u8   # 296
    protocols_per_handle: *u8        # 304
    locate_handle_buffer: *u8        # 312
    locate_protocol: *u8             # 320

[[packed]]
struct EfiMemoryDescriptor
    mem_type: u32
    _pad: u32
    physical_start: u64
    virtual_start: u64
    number_of_pages: u64
    attribute: u64

# ============================================================================
# UEFI Filesystem Protocol Structures
# ============================================================================

# EFI_LOADED_IMAGE_PROTOCOL - to find the device we booted from
[[packed]]
struct EfiLoadedImage
    revision: u32
    _pad: u32
    parent_handle: u64
    system_table: *u8
    device_handle: u64          # The device we loaded from!
    file_path: *u8
    reserved: *u8
    load_options_size: u32
    _pad2: u32
    load_options: *u8
    image_base: *u8
    image_size: u64
    image_code_type: u32
    image_data_type: u32
    unload: *u8

# GUID for Loaded Image Protocol
# {5B1B31A1-9562-11D2-8E3F-00A0C969723B}
var loaded_image_guid: EfiGuid = EfiGuid { data1: 0x5B1B31A1, data2: 0x9562, data3: 0x11D2, data4: [0x8E, 0x3F, 0x00, 0xA0, 0xC9, 0x69, 0x72, 0x3B] }

# File open modes
const EFI_FILE_MODE_READ: u64 = 0x0000000000000001
const EFI_FILE_MODE_WRITE: u64 = 0x0000000000000002
const EFI_FILE_MODE_CREATE: u64 = 0x8000000000000000

# File attributes
const EFI_FILE_READ_ONLY: u64 = 0x0000000000000001
const EFI_FILE_DIRECTORY: u64 = 0x0000000000000010

# EFI_GUID structure
[[packed]]
struct EfiGuid
    data1: u32
    data2: u16
    data3: u16
    data4: [8]u8

# EFI_CONFIGURATION_TABLE entry
[[packed]]
struct EfiConfigurationTable
    vendor_guid: EfiGuid
    vendor_table: u64

# ACPI 2.0 RSDP GUID: {8868E871-E4F1-11D3-BC22-0080C73C8881}
var acpi20_guid: EfiGuid = EfiGuid { data1: 0x8868E871, data2: 0xE4F1, data3: 0x11D3, data4: [0xBC, 0x22, 0x00, 0x80, 0xC7, 0x3C, 0x88, 0x81] }

# ACPI 1.0 RSDP GUID: {EB9D2D30-2D88-11D3-9A16-0090273FC14D}
var acpi10_guid: EfiGuid = EfiGuid { data1: 0xEB9D2D30, data2: 0x2D88, data3: 0x11D3, data4: [0x9A, 0x16, 0x00, 0x90, 0x27, 0x3F, 0xC1, 0x4D] }

# ============================================================================
# UEFI Graphics Output Protocol (GOP)
# ============================================================================

# EFI_GRAPHICS_OUTPUT_PROTOCOL GUID: {9042A9DE-23DC-4A38-96FB-7ADED080516A}
var gop_guid: EfiGuid = EfiGuid { data1: 0x9042A9DE, data2: 0x23DC, data3: 0x4A38, data4: [0x96, 0xFB, 0x7A, 0xDE, 0xD0, 0x80, 0x51, 0x6A] }

# Pixel format constants
const EFI_PIXEL_RGBX_8BIT: u32 = 0     # RedGreenBlueReserved 8bit per color
const EFI_PIXEL_BGRX_8BIT: u32 = 1     # BlueGreenRedReserved 8bit per color
const EFI_PIXEL_BITMASK: u32 = 2       # Use PixelInformation bitmask
const EFI_PIXEL_BLT_ONLY: u32 = 3      # No direct framebuffer access

[[packed]]
struct EfiPixelBitmask
    red_mask: u32
    green_mask: u32
    blue_mask: u32
    reserved_mask: u32

[[packed]]
struct EfiGopModeInfo
    version: u32
    horizontal_resolution: u32
    vertical_resolution: u32
    pixel_format: u32                    # EFI_PIXEL_* constants
    pixel_info: EfiPixelBitmask          # Only valid if pixel_format == 2
    pixels_per_scan_line: u32            # May differ from horizontal_resolution!

[[packed]]
struct EfiGopMode
    max_mode: u32
    mode_number: u32                     # Current mode index
    info: *EfiGopModeInfo
    info_size: u64
    frame_buffer_base: u64               # Physical address of framebuffer!
    frame_buffer_size: u64

[[packed]]
struct EfiGraphicsOutputProtocol
    query_mode: *u8                      # QueryMode function pointer
    set_mode: *u8                        # SetMode function pointer
    blt: *u8                             # Blt (Block Transfer) function pointer
    mode: *EfiGopMode                    # Current mode information

# EFI_SIMPLE_FILE_SYSTEM_PROTOCOL
[[packed]]
struct EfiSimpleFileSystem
    revision: u64
    open_volume: *u8              # EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_OPEN_VOLUME

# EFI_FILE_PROTOCOL - file handle operations
[[packed]]
struct EfiFile
    revision: u64
    open: *u8                     # EFI_FILE_OPEN
    close: *u8                    # EFI_FILE_CLOSE
    delete: *u8                   # EFI_FILE_DELETE
    read: *u8                     # EFI_FILE_READ
    write: *u8                    # EFI_FILE_WRITE
    get_position: *u8             # EFI_FILE_GET_POSITION
    set_position: *u8             # EFI_FILE_SET_POSITION
    get_info: *u8                 # EFI_FILE_GET_INFO
    set_info: *u8                 # EFI_FILE_SET_INFO
    flush: *u8                    # EFI_FILE_FLUSH

# EFI_FILE_INFO structure (variable size due to filename at end)
[[packed]]
struct EfiFileInfo
    size: u64
    file_size: u64
    physical_size: u64
    create_time: [16]u8           # EFI_TIME
    last_access_time: [16]u8      # EFI_TIME
    modification_time: [16]u8     # EFI_TIME
    attribute: u64
    # filename: [...]u16 follows (variable length, null-terminated UCS-2)

# ============================================================================
# Page Table Constants
# ============================================================================

const PTE_PRESENT: u64 = 1
const PTE_WRITABLE: u64 = 2
const PTE_USER: u64 = 4
const PTE_WRITE_THROUGH: u64 = 8
const PTE_CACHE_DISABLE: u64 = 16
const PTE_HUGE: u64 = 128            # 2MB page
const PTE_GLOBAL: u64 = 256
const PTE_NO_EXECUTE: u64 = 0x8000000000000000

const KERNEL_VIRT_BASE: u64 = 0xFFFFFFFF80000000
const KERNEL_PHYS_BASE: u64 = 0x100000

# ============================================================================
# Serial output: boot_abi/src/serial.ritz, plus the loader's own StrView
# ============================================================================

# StrView - Zero-copy string view (matches ritzlib layout). "hello" literals
# are StrViews. The loader can't link ritzlib.strview (it needs malloc), so
# it declares the layout itself and wraps serial_write.
pub struct StrView
    ptr: *u8
    len: i64

fn prints(s: StrView) -> i32
    return serial_write(s.ptr, s.len)

# ============================================================================
# UEFI Service Calls
#
# UEFI firmware functions use the Microsoft x64 convention. A function
# pointer read from a firmware table has no declaration of its own, so its
# convention lives on the fn type it is called through (LANGUAGE_SPEC §17.7).
# EfiFnN takes N integer arguments; every UEFI service returns EFI_STATUS.
# ============================================================================

[[callconv = "win64"]]
type EfiFn1 = fn(u64) -> u64

[[callconv = "win64"]]
type EfiFn2 = fn(u64, u64) -> u64

[[callconv = "win64"]]
type EfiFn3 = fn(u64, u64, u64) -> u64

[[callconv = "win64"]]
type EfiFn4 = fn(u64, u64, u64, u64) -> u64

[[callconv = "win64"]]
type EfiFn5 = fn(u64, u64, u64, u64, u64) -> u64

# Global state
var g_image_handle: u64 = 0
var g_system_table: *EfiSystemTable = 0 as *EfiSystemTable
var g_boot_services: *EfiBootServices = 0 as *EfiBootServices

# ============================================================================
# UEFI Service Wrappers
# ============================================================================

fn efi_get_memory_map(map_size: *u64, memory_map: *u8, map_key: *u64, desc_size: *u64, desc_version: *u32) -> u64
    return (g_boot_services.get_memory_map as EfiFn5)(map_size as u64, memory_map as u64, map_key as u64, desc_size as u64, desc_version as u64)

fn efi_exit_boot_services(map_key: u64) -> u64
    return (g_boot_services.exit_boot_services as EfiFn2)(g_image_handle, map_key)

fn efi_allocate_pages(alloc_type: u32, mem_type: u32, pages: u64, addr: *u64) -> u64
    return (g_boot_services.allocate_pages as EfiFn4)(alloc_type as u64, mem_type as u64, pages, addr as u64)

# ============================================================================
# Page Table Setup
# ============================================================================

var pml4_addr: u64 = 0
var pdpt_identity_addr: u64 = 0
var pdpt_highhalf_addr: u64 = 0
var pd_addr: u64 = 0            # First of map_gbs PDs, one per GiB (0-1GB first)
var detected_memory_mb: u64 = 0  # Top of RAM in MB, rounded up to 256 MB

# Identity-mapped GiBs, one PD each: up to top of RAM, not 4 GiB (AGAST
# #4183). Firmware loads this image and its data (HarlandBootInfo, the memory map)
# wherever it likes; with -m 6G OVMF put them at 0x140000000, and a 4 GiB
# map faulted on the first instruction after the CR3 switch. One identity
# PDPT holds 512.
const MAX_MAP_GBS: u64 = 512
var map_gbs: u64 = 0

# MB of memory to identity map: top of RAM, never less than 256 MB.
fn memory_to_map_mb() -> u64
    var mb: u64 = detected_memory_mb
    if mb < 256
        mb = 256
    if mb > MAX_MAP_GBS * 1024
        mb = MAX_MAP_GBS * 1024
    return mb

fn allocate_page_tables() -> i32
    prints("  Allocating page tables...\n")
    # PML4, the identity PDPT, the higher-half PDPT, then one PD per GiB.
    map_gbs = (memory_to_map_mb() + 1023) / 1024
    let pages: u64 = 3 + map_gbs
    var addr: u64 = 0
    var status: u64 = efi_allocate_pages(ALLOCATE_ANY_PAGES, EFI_LOADER_DATA, pages, @addr)
    if status != EFI_SUCCESS
        prints("    ERROR: Failed to allocate page tables\n")
        return -1
    pml4_addr = addr
    pdpt_identity_addr = addr + 0x1000
    pdpt_highhalf_addr = addr + 0x2000
    pd_addr = addr + 0x3000
    prints("    PML4 at ")
    print_hex_prefix(pml4_addr)
    prints("\n")
    var p: *u64 = pml4_addr as *u64
    var i: u64 = 0
    while i < pages * 512
        *p = 0
        p = p + 1
        i = i + 1
    return 0

# Whether any RAM (is_ram_type) overlaps the 2 MB chunk at base, by the
# memory map get_memory_map last read.
fn chunk_has_ram(base: u64) -> bool
    let num_entries: u64 = memory_map_size / memory_map_desc_size
    var i: u64 = 0
    while i < num_entries
        let desc: *EfiMemoryDescriptor = (@memory_map_buffer[0] + i * memory_map_desc_size) as *EfiMemoryDescriptor
        if is_ram_type(desc.mem_type)
            let end: u64 = desc.physical_start + desc.number_of_pages * 4096
            if desc.physical_start < base + 0x200000 and end > base
                return true
        i = i + 1
    return false

fn setup_page_tables() -> i32
    prints("  Setting up page tables based on detected memory...\n")
    let flags: u64 = PTE_PRESENT | PTE_WRITABLE
    let huge_flags: u64 = PTE_PRESENT | PTE_WRITABLE | PTE_HUGE

    let mapped_mb: u64 = memory_to_map_mb()
    prints("    Will map ")
    serial_print_udec(mapped_mb)
    prints(" MB of memory\n")

    # PML4[0] -> pdpt_identity (for identity mapping)
    let pml4: *u64 = pml4_addr as *u64
    *pml4 = pdpt_identity_addr | flags

    # PML4[511] -> pdpt_highhalf (for higher-half kernel at 0xFFFFFFFF80000000)
    let pml4_511: *u64 = (pml4_addr + 511 * 8) as *u64
    *pml4_511 = pdpt_highhalf_addr | flags

    # Identity PDPT[g] -> PD g, whose 2 MB pages map GiB g up to mapped_mb
    # (the rest of the last PD stays empty, as before). Above 1 GiB only
    # chunks holding RAM: the PCI hole below 4 GiB (framebuffer, LAPIC,
    # I/O APIC) stays unmapped, so the kernel can map its 4 KiB device
    # pages there (vmm_map_page refuses to split a 2 MB page).
    let huge_pages: u64 = mapped_mb / 2
    var g: u64 = 0
    while g < map_gbs
        let pd_g: u64 = pd_addr + g * 0x1000
        let pdpt_e: *u64 = (pdpt_identity_addr + g * 8) as *u64
        *pdpt_e = pd_g | flags
        var e: u64 = 0
        while e < 512 and g * 512 + e < huge_pages
            let chunk: u64 = (g * 512 + e) * 0x200000
            if g == 0 or chunk_has_ram(chunk)
                let pde: *u64 = (pd_g + e * 8) as *u64
                *pde = chunk | huge_flags
            e = e + 1
        g = g + 1

    # Higher-half mapping: PDPT[510] -> the first PD
    # The kernel at 0xFFFFFFFF80000000 only needs the first 1GB (where kernel lives)
    let pdpt_hh_510: *u64 = (pdpt_highhalf_addr + 510 * 8) as *u64
    *pdpt_hh_510 = pd_addr | flags

    prints("    Identity map: 0-")
    serial_print_udec(mapped_mb)
    prints("MB -> 0-")
    serial_print_udec(mapped_mb)
    prints("MB\n")
    prints("    Higher-half:  0xFFFFFFFF80000000 -> 0-1GB\n")
    return 0

fn load_page_tables() -> i32
    prints("  Loading page tables into CR3...\n")
    asm x86_64:
        movq {pml4_addr}, %rax
        movq %rax, %cr3
    return 0

# ============================================================================
# Memory Map Processing
# ============================================================================

var memory_map_buffer: [16384]u8
var memory_map_size: u64 = 16384
var memory_map_key: u64 = 0
var memory_map_desc_size: u64 = 0
var memory_map_desc_version: u32 = 0

# RAM, as opposed to MMIO or firmware-reserved ranges.
fn is_ram_type(t: u32) -> bool
    return (t >= EFI_LOADER_CODE and t <= EFI_CONVENTIONAL_MEMORY) or t == EFI_ACPI_RECLAIM_MEMORY or t == EFI_ACPI_MEMORY_NVS

fn get_memory_map() -> i32
    prints("  Getting memory map...\n")
    memory_map_size = 16384
    let map_ptr: *u8 = @memory_map_buffer[0]
    let status: u64 = efi_get_memory_map(@memory_map_size, map_ptr, @memory_map_key, @memory_map_desc_size, @memory_map_desc_version)
    if status != EFI_SUCCESS
        prints("    ERROR: GetMemoryMap failed with status ")
        print_hex_prefix(status)
        prints("\n")
        return -1
    let num_entries: u64 = memory_map_size / memory_map_desc_size
    prints("    Got ")
    serial_print_udec(num_entries)
    prints(" memory map entries\n")
    prints("    Descriptor size: ")
    serial_print_udec(memory_map_desc_size)
    prints(" bytes\n")
    var usable_pages: u64 = 0
    var highest_usable_addr: u64 = 0
    var i: u64 = 0
    while i < num_entries
        let desc: *EfiMemoryDescriptor = (@memory_map_buffer[0] + i * memory_map_desc_size) as *EfiMemoryDescriptor
        if desc.mem_type == EFI_CONVENTIONAL_MEMORY
            usable_pages = usable_pages + desc.number_of_pages
        # Track the top of RAM to know how much to map: any RAM, since this
        # image and its data (LoaderCode/LoaderData) must be mapped too.
        if is_ram_type(desc.mem_type)
            let region_end: u64 = desc.physical_start + (desc.number_of_pages * 4096)
            if region_end > highest_usable_addr
                highest_usable_addr = region_end
        i = i + 1
    let usable_mb: u64 = (usable_pages * 4096) / (1024 * 1024)
    # Round up to nearest 256MB for simpler page table setup
    detected_memory_mb = ((highest_usable_addr + 0x0FFFFFFF) / 0x10000000) * 256
    prints("    Usable memory: ")
    serial_print_udec(usable_mb)
    prints(" MB\n")
    prints("    Highest address: ")
    print_hex_prefix(highest_usable_addr)
    prints(" -> mapping ")
    serial_print_udec(detected_memory_mb)
    prints(" MB\n")
    return 0

# ============================================================================
# UEFI Filesystem Loading
# ============================================================================

# Simple File System Protocol GUID: {964E5B22-6459-11D2-8E39-00A0C969723B}
var fs_guid: EfiGuid = EfiGuid { data1: 0x964E5B22, data2: 0x6459, data3: 0x11D2, data4: [0x8E, 0x39, 0x00, 0xA0, 0xC9, 0x69, 0x72, 0x3B] }

# Handle protocol wrapper
fn efi_handle_protocol(handle: u64, protocol: *EfiGuid, iface: *u64) -> u64
    return (g_boot_services.handle_protocol as EfiFn3)(handle, protocol as u64, iface as u64)

# Locate protocol wrapper (finds first handle supporting a protocol)
fn efi_locate_protocol(protocol: *EfiGuid, registration: u64, iface: *u64) -> u64
    return (g_boot_services.locate_protocol as EfiFn3)(protocol as u64, registration, iface as u64)

# LocateHandleBuffer wrapper - finds all handles supporting a protocol
# ByProtocol search type = 2
fn efi_locate_handle_buffer(protocol: *EfiGuid, num_handles: *u64, buffer: *u64) -> u64
    # LocateHandleBuffer(SearchType, Protocol, SearchKey, NoHandles, Buffer)
    # SearchType=2 (ByProtocol), SearchKey=NULL
    return (g_boot_services.locate_handle_buffer as EfiFn5)(2, protocol as u64, 0, num_handles as u64, buffer as u64)

# ============================================================================
# ACPI RSDP Discovery from UEFI Configuration Table
# ============================================================================

fn guid_equals(a: *EfiGuid, b: *EfiGuid) -> i32
    if (*a).data1 != (*b).data1
        return 0
    if (*a).data2 != (*b).data2
        return 0
    if (*a).data3 != (*b).data3
        return 0
    var i: i32 = 0
    while i < 8
        if (*a).data4[i] != (*b).data4[i]
            return 0
        i = i + 1
    return 1

var rsdp_address: u64 = 0

fn find_rsdp_from_uefi() -> i32
    prints("  Finding ACPI RSDP from UEFI...\n")

    let num_entries: u64 = g_system_table.number_of_table_entries
    let config_table: *EfiConfigurationTable = g_system_table.configuration_table as *EfiConfigurationTable

    prints("    Configuration table entries: ")
    serial_print_udec(num_entries)
    prints("\n")

    var i: u64 = 0
    while i < num_entries
        let entry: *EfiConfigurationTable = config_table + i

        # Check for ACPI 2.0 RSDP first (preferred)
        if guid_equals(@(*entry).vendor_guid, @acpi20_guid) == 1
            rsdp_address = (*entry).vendor_table
            prints("    Found ACPI 2.0 RSDP at: ")
            print_hex_prefix(rsdp_address)
            prints("\n")
            return 0

        # Fall back to ACPI 1.0 RSDP
        if guid_equals(@(*entry).vendor_guid, @acpi10_guid) == 1
            rsdp_address = (*entry).vendor_table
            prints("    Found ACPI 1.0 RSDP at: ")
            print_hex_prefix(rsdp_address)
            prints("\n")
            return 0

        i = i + 1

    prints("    WARNING: No ACPI RSDP found in configuration table\n")
    return -1

# ============================================================================
# Graphics Initialization (UEFI GOP)
# ============================================================================

# Global framebuffer info (populated by init_graphics)
var fb_addr: u64 = 0
var fb_width: u32 = 0
var fb_height: u32 = 0
var fb_pitch: u32 = 0
var fb_bpp: u8 = 0
var fb_format: u32 = 0

fn init_graphics() -> i32
    prints("  Initializing graphics (UEFI GOP)...\n")

    # Locate GOP protocol
    var gop_ptr: u64 = 0
    let status: u64 = efi_locate_protocol(@gop_guid, 0, @gop_ptr)
    if status != EFI_SUCCESS
        prints("    WARNING: No GOP found (headless mode)\n")
        return -1

    let gop: *EfiGraphicsOutputProtocol = gop_ptr as *EfiGraphicsOutputProtocol
    let mode: *EfiGopMode = (*gop).mode
    let info: *EfiGopModeInfo = (*mode).info

    prints("    GOP found at: ")
    print_hex_prefix(gop_ptr)
    prints("\n")

    # Print current mode info
    prints("    Current mode: ")
    serial_print_udec((*mode).mode_number as u64)
    prints(" of ")
    serial_print_udec((*mode).max_mode as u64)
    prints("\n")

    prints("    Resolution: ")
    serial_print_udec((*info).horizontal_resolution as u64)
    prints("x")
    serial_print_udec((*info).vertical_resolution as u64)
    prints("\n")

    prints("    Pixels per scanline: ")
    serial_print_udec((*info).pixels_per_scan_line as u64)
    prints("\n")

    prints("    Pixel format: ")
    if (*info).pixel_format == EFI_PIXEL_RGBX_8BIT
        prints("RGBX\n")
    else if (*info).pixel_format == EFI_PIXEL_BGRX_8BIT
        prints("BGRX\n")
    else if (*info).pixel_format == EFI_PIXEL_BITMASK
        prints("Bitmask\n")
    else if (*info).pixel_format == EFI_PIXEL_BLT_ONLY
        prints("BLT-only (no direct framebuffer!)\n")
        return -1
    else
        prints("Unknown\n")

    prints("    Framebuffer: ")
    print_hex_prefix((*mode).frame_buffer_base)
    prints(" (")
    serial_print_udec((*mode).frame_buffer_size / 1024)
    prints(" KB)\n")

    # Store framebuffer info for HarlandBootInfo
    fb_addr = (*mode).frame_buffer_base
    fb_width = (*info).horizontal_resolution
    fb_height = (*info).vertical_resolution
    fb_pitch = (*info).pixels_per_scan_line * 4  # Assuming 32bpp
    fb_bpp = 32
    fb_format = (*info).pixel_format

    # Quick visual test: fill framebuffer with a color
    # This happens before ExitBootServices, so we can access it directly
    prints("    Drawing test pattern...\n")
    let fb: *u32 = fb_addr as *u32
    var y: u32 = 0
    while y < fb_height
        var x: u32 = 0
        while x < fb_width
            # Simple gradient: blue in top-left, red in bottom-right
            let r: u32 = (x * 255) / fb_width
            let b: u32 = (y * 255) / fb_height
            let g: u32 = 128
            var pixel: u32 = 0

            # Pack pixel based on format
            if fb_format == EFI_PIXEL_RGBX_8BIT
                # RGBX: R in low byte
                pixel = r | (g << 8) | (b << 16)
            else
                # BGRX: B in low byte (default for most UEFI)
                pixel = b | (g << 8) | (r << 16)

            let offset: u64 = (y as u64) * ((*info).pixels_per_scan_line as u64) + (x as u64)
            *(fb + offset) = pixel
            x = x + 1
        y = y + 1

    prints("    Graphics initialized!\n")
    return 0

# ============================================================================
# HarlandBootInfo Population
# ============================================================================

# Global HarlandBootInfo struct that will be passed to kernel
var boot_info: HarlandBootInfo

# Memory map entries for HarlandBootInfo: every descriptor memory_map_buffer can
# hold (16384 / 48 = 341). 128 dropped the top of RAM, sorted last, on a
# -m 6G OVMF's 135-entry map (AGAST #4183).
const BOOT_MEMORY_MAP_MAX: u32 = 384
var boot_memory_map: [384]HarlandMemEntry
var boot_memory_map_count: u32 = 0

fn convert_efi_memory_type(efi_type: u32) -> u32
    if efi_type == EFI_CONVENTIONAL_MEMORY
        return HARLAND_MEM_USABLE
    if efi_type == EFI_ACPI_RECLAIM_MEMORY
        return HARLAND_MEM_ACPI_RECLAIMABLE
    # Everything else is reserved
    return HARLAND_MEM_RESERVED

fn build_boot_info() -> i32
    prints("  Building BootInfo structure...\n")

    # Set magic and version
    boot_info.magic = HARLAND_BOOT_MAGIC
    boot_info.version = HARLAND_BOOT_VERSION

    # Convert UEFI memory map to our format
    let num_entries: u64 = memory_map_size / memory_map_desc_size
    boot_memory_map_count = 0

    var i: u64 = 0
    while i < num_entries && boot_memory_map_count < BOOT_MEMORY_MAP_MAX
        let desc: *EfiMemoryDescriptor = (@memory_map_buffer[0] + i * memory_map_desc_size) as *EfiMemoryDescriptor

        # Only include usable and ACPI reclaimable memory in our map
        # (kernel needs to know about usable memory for PMM)
        let our_type: u32 = convert_efi_memory_type(desc.mem_type)

        boot_memory_map[boot_memory_map_count].base = desc.physical_start
        boot_memory_map[boot_memory_map_count].length = desc.number_of_pages * 4096
        boot_memory_map[boot_memory_map_count].mem_type = our_type
        boot_memory_map[boot_memory_map_count].reserved = 0
        boot_memory_map_count = boot_memory_map_count + 1

        i = i + 1

    boot_info.memory_map = @boot_memory_map[0]
    boot_info.memory_map_entries = boot_memory_map_count

    prints("    Memory map entries: ")
    serial_print_udec(boot_memory_map_count as u64)
    prints("\n")

    # Set RSDP address
    boot_info.rsdp_addr = rsdp_address

    # Set kernel info
    boot_info.kernel_phys = kernel_entry
    boot_info.kernel_size = kernel_size

    # Set page table info
    boot_info.pml4_phys = pml4_addr

    # The initramfs read from the ESP (0/0 if none)
    boot_info.initramfs_phys = initramfs_addr
    boot_info.initramfs_size = initramfs_size

    # Boot options from the boot volume (AGAST #4335)
    boot_info.flags = boot_flags

    # Set framebuffer info (populated by init_graphics)
    boot_info.framebuffer_addr = fb_addr
    boot_info.framebuffer_width = fb_width
    boot_info.framebuffer_height = fb_height
    boot_info.framebuffer_pitch = fb_pitch
    boot_info.framebuffer_bpp = fb_bpp
    boot_info.framebuffer_format = fb_format as u8

    if fb_addr != 0
        prints("    Framebuffer: ")
        serial_print_udec(fb_width as u64)
        prints("x")
        serial_print_udec(fb_height as u64)
        prints(" @ ")
        print_hex_prefix(fb_addr)
        prints("\n")

    prints("    BootInfo ready at: ")
    print_hex_prefix(@boot_info as u64)
    prints("\n")

    return 0

# Kernel path as UCS-2 string: L"\\harland\\kernel.elf"
# Each character is 2 bytes, null-terminated
var kernel_path: [32]u16

fn init_kernel_path() -> i32
    # "\\harland\\kernel.elf" in UCS-2
    kernel_path[0] = 0x5C    # '\'
    kernel_path[1] = 0x68    # 'h'
    kernel_path[2] = 0x61    # 'a'
    kernel_path[3] = 0x72    # 'r'
    kernel_path[4] = 0x6C    # 'l'
    kernel_path[5] = 0x61    # 'a'
    kernel_path[6] = 0x6E    # 'n'
    kernel_path[7] = 0x64    # 'd'
    kernel_path[8] = 0x5C    # '\'
    kernel_path[9] = 0x6B    # 'k'
    kernel_path[10] = 0x65   # 'e'
    kernel_path[11] = 0x72   # 'r'
    kernel_path[12] = 0x6E   # 'n'
    kernel_path[13] = 0x65   # 'e'
    kernel_path[14] = 0x6C   # 'l'
    kernel_path[15] = 0x2E   # '.'
    kernel_path[16] = 0x65   # 'e'
    kernel_path[17] = 0x6C   # 'l'
    kernel_path[18] = 0x66   # 'f'
    kernel_path[19] = 0      # null terminator
    return 0

# Buffer to hold loaded kernel
var kernel_buffer: *u8 = 0 as *u8
var kernel_size: u64 = 0
var kernel_entry: u64 = 0

# File read buffer (also used for file info)
var file_info_buffer: [256]u8

fn load_kernel_from_fs() -> i32
    prints("  Loading kernel from filesystem...\n")
    init_kernel_path()

    # Find filesystem handles using LocateHandleBuffer
    var num_handles: u64 = 0
    var handle_buffer: u64 = 0
    let lhb_status: u64 = efi_locate_handle_buffer(@fs_guid, @num_handles, @handle_buffer)
    if lhb_status != EFI_SUCCESS
        prints("    ERROR: Failed to locate filesystem handles: ")
        print_hex_prefix(lhb_status)
        prints("\n")
        return -1

    prints("    Found ")
    serial_print_udec(num_handles)
    prints(" filesystem handle(s)\n")

    if num_handles == 0
        prints("    ERROR: No filesystems found\n")
        return -1

    # Try each filesystem handle to find our kernel
    var handles: *u64 = handle_buffer as *u64
    var fs_protocol: u64 = 0
    var found_fs: i32 = 0

    var i: u64 = 0
    while i < num_handles && found_fs == 0
        let handle: u64 = *(handles + i)
        prints("    Trying handle ")
        serial_print_udec(i)
        prints(": ")
        print_hex_prefix(handle)

        # Get filesystem protocol from this handle
        var fs_iface: u64 = 0
        let fs_status: u64 = efi_handle_protocol(handle, @fs_guid, @fs_iface)
        if fs_status == EFI_SUCCESS
            fs_protocol = fs_iface
            found_fs = 1
            prints(" OK\n")
        else
            prints(" FAIL\n")

        i = i + 1

    if found_fs == 0
        prints("    ERROR: Could not get filesystem protocol from any handle\n")
        return -1

    prints("    Got filesystem protocol at ")
    print_hex_prefix(fs_protocol)
    prints("\n")

    let fs: *EfiSimpleFileSystem = fs_protocol as *EfiSimpleFileSystem

    # Open the root volume
    var root_file: u64 = 0
    let status2: u64 = (fs.open_volume as EfiFn2)(fs_protocol, @root_file as u64)
    if status2 != EFI_SUCCESS
        prints("    ERROR: Failed to open root volume: ")
        print_hex_prefix(status2)
        prints("\n")
        return -1

    prints("    Opened root volume\n")

    let root: *EfiFile = root_file as *EfiFile

    # Open the kernel file
    var kernel_file: u64 = 0
    # EFI_FILE_OPEN: Open(This, NewHandle, FileName, OpenMode, Attributes)
    let kpath_ptr: u64 = @kernel_path[0] as u64
    let kfile_ptr: u64 = @kernel_file as u64
    let status3: u64 = (root.open as EfiFn5)(root_file, kfile_ptr, kpath_ptr, EFI_FILE_MODE_READ, 0)
    if status3 != EFI_SUCCESS
        prints("    ERROR: Failed to open \\harland\\kernel.elf: ")
        print_hex_prefix(status3)
        prints("\n")
        return -1

    prints("    Opened kernel file: \\harland\\kernel.elf\n")

    let kfile: *EfiFile = kernel_file as *EfiFile

    # Get file size using GetInfo
    # We need EFI_FILE_INFO_GUID and call GetInfo
    # For simplicity, let's read in chunks and track size
    # Or we can use SetPosition to end and GetPosition

    # Seek to end to get file size
    # SetPosition to 0xFFFFFFFFFFFFFFFF means end of file
    let status4: u64 = (kfile.set_position as EfiFn2)(kernel_file, 0xFFFFFFFFFFFFFFFF)
    if status4 != EFI_SUCCESS
        prints("    ERROR: Failed to seek to end: ")
        print_hex_prefix(status4)
        prints("\n")
        return -1

    var file_size: u64 = 0
    let status5: u64 = (kfile.get_position as EfiFn2)(kernel_file, @file_size as u64)
    if status5 != EFI_SUCCESS
        prints("    ERROR: Failed to get file size: ")
        print_hex_prefix(status5)
        prints("\n")
        return -1

    prints("    Kernel file size: ")
    serial_print_udec(file_size)
    prints(" bytes\n")

    kernel_size = file_size

    # Seek back to beginning
    let status6: u64 = (kfile.set_position as EfiFn2)(kernel_file, 0)
    if status6 != EFI_SUCCESS
        prints("    ERROR: Failed to seek to start: ")
        print_hex_prefix(status6)
        prints("\n")
        return -1

    # Allocate memory for kernel (round up to pages)
    let pages_needed: u64 = (file_size + 4095) / 4096
    var kernel_addr: u64 = 0
    let status7: u64 = efi_allocate_pages(ALLOCATE_ANY_PAGES, EFI_LOADER_DATA, pages_needed, @kernel_addr)
    if status7 != EFI_SUCCESS
        prints("    ERROR: Failed to allocate kernel buffer: ")
        print_hex_prefix(status7)
        prints("\n")
        return -1

    kernel_buffer = kernel_addr as *u8
    prints("    Allocated ")
    serial_print_udec(pages_needed)
    prints(" pages at ")
    print_hex_prefix(kernel_addr)
    prints("\n")

    # Read the kernel file
    var bytes_to_read: u64 = file_size
    let status8: u64 = (kfile.read as EfiFn3)(kernel_file, @bytes_to_read as u64, kernel_addr)
    if status8 != EFI_SUCCESS
        prints("    ERROR: Failed to read kernel: ")
        print_hex_prefix(status8)
        prints("\n")
        return -1

    prints("    Read ")
    serial_print_udec(bytes_to_read)
    prints(" bytes\n")

    # Close kernel file
    (kfile.close as EfiFn1)(kernel_file)

    # The initramfs beside it, if the volume has one. A read error is not
    # fatal here: the kernel can still find a virtio-blk initramfs disk.
    load_initramfs_from_fs(root_file)

    # Boot options from the same volume (AGAST #4335).
    load_boot_options_from_fs(root_file)
    load_test_options(root_file)

    # Close root
    (root.close as EfiFn1)(root_file)

    prints("    Kernel loaded successfully!\n")
    return 0

# ============================================================================
# Initramfs from the boot volume (AGAST #4253)
# ============================================================================

# Path of the initramfs on the boot volume, beside the kernel. Machines with
# no virtio-blk disk (EC2 Nitro's NVMe, laptops) boot with it: the kernel
# unpacks the TAR from memory instead of reading a raw TAR disk.
var initramfs_path: [32]u16
var initramfs_addr: u64 = 0
var initramfs_size: u64 = 0

# Write s into out as a null-terminated UCS-2 string (ASCII only); out must
# hold s.len + 1 code units.
fn ascii_to_ucs2(s: StrView, out: *u16) -> i32
    var i: i64 = 0
    while i < s.len
        *(out + i) = *(s.ptr + i) as u16
        i = i + 1
    *(out + i) = 0
    return 0

# Read \harland\initramfs.tar from the open root directory root_file into
# EfiLoaderData pages, and record where in initramfs_addr / initramfs_size.
# A missing file is not an error (returns 1): the kernel falls back to a
# virtio-blk disk. Returns 0 when loaded, -1 on a read error.
fn load_initramfs_from_fs(root_file: u64) -> i32
    ascii_to_ucs2("\\harland\\initramfs.tar", @initramfs_path[0])
    let root: *EfiFile = root_file as *EfiFile
    var file: u64 = 0
    let st_open: u64 = (root.open as EfiFn5)(root_file, @file as u64, @initramfs_path[0] as u64, EFI_FILE_MODE_READ, 0)
    if st_open != EFI_SUCCESS
        prints("    No \\harland\\initramfs.tar on the boot volume (kernel will try virtio-blk)\n")
        return 1
    let f: *EfiFile = file as *EfiFile

    # Size: seek to the end (all ones) and read the position back
    var size: u64 = 0
    var status: u64 = (f.set_position as EfiFn2)(file, 0xFFFFFFFFFFFFFFFF)
    if status == EFI_SUCCESS
        status = (f.get_position as EfiFn2)(file, @size as u64)
    if status == EFI_SUCCESS
        status = (f.set_position as EfiFn2)(file, 0)
    if status != EFI_SUCCESS or size == 0
        prints("    ERROR: Cannot size initramfs.tar: ")
        print_hex_prefix(status)
        prints("\n")
        (f.close as EfiFn1)(file)
        return -1

    var addr: u64 = 0
    status = efi_allocate_pages(ALLOCATE_ANY_PAGES, EFI_LOADER_DATA, (size + 4095) / 4096, @addr)
    if status != EFI_SUCCESS
        prints("    ERROR: Cannot allocate initramfs buffer: ")
        print_hex_prefix(status)
        prints("\n")
        (f.close as EfiFn1)(file)
        return -1

    var got: u64 = size
    status = (f.read as EfiFn3)(file, @got as u64, addr)
    (f.close as EfiFn1)(file)
    if status != EFI_SUCCESS or got != size
        prints("    ERROR: Cannot read initramfs.tar: ")
        print_hex_prefix(status)
        prints(", ")
        serial_print_udec(got)
        prints(" of ")
        serial_print_udec(size)
        prints(" bytes\n")
        return -1

    initramfs_addr = addr
    initramfs_size = size
    prints("    Read initramfs: ")
    serial_print_udec(size)
    prints(" bytes at ")
    print_hex_prefix(addr)
    prints("\n")
    return 0

# ============================================================================
# Boot options from the boot volume (AGAST #4335)
# ============================================================================

# \harland\net-selftest on the boot volume asks the kernel for its pre-init
# network self-tests (DHCP, a gateway ping, the 300-frame TX burst). The NIC
# gate (tools/test_msix_boot.sh) writes it, so the tests keep running under
# QEMU's virtio-net. Every other boot -- EC2, laptops, no NIC at all --
# leaves it out, and the kernel then leaves the NIC alone until init is up:
# a broken driver can no longer keep init_interactive and rzsh from starting.
# The file's contents do not matter; it only has to exist.
var boot_options_path: [32]u16
var boot_flags: u32 = 0

fn load_boot_options_from_fs(root_file: u64) -> i32
    ascii_to_ucs2("\\harland\\net-selftest", @boot_options_path[0])
    let root: *EfiFile = root_file as *EfiFile
    var file: u64 = 0
    let st_open: u64 = (root.open as EfiFn5)(root_file, @file as u64, @boot_options_path[0] as u64, EFI_FILE_MODE_READ, 0)
    if st_open != EFI_SUCCESS
        prints("    No \\harland\\net-selftest (network self-tests off)\n")
        return 1
    let f: *EfiFile = file as *EfiFile
    (f.close as EfiFn1)(file)
    boot_flags = boot_flags | HARLAND_BOOT_FLAG_NET_SELFTEST
    prints("    Boot option \\harland\\net-selftest: network self-tests on\n")

    # AGAST #1851: a second, independent file asks for the peer-ping window.
    # Only the EC2 acceptance image writes it, so the QEMU NIC gate's boot is
    # unchanged.
    ascii_to_ucs2("\\harland\\net-responder", @boot_options_path[0])
    file = 0
    let st_peer: u64 = (root.open as EfiFn5)(root_file, @file as u64, @boot_options_path[0] as u64, EFI_FILE_MODE_READ, 0)
    if st_peer != EFI_SUCCESS
        prints("    No \\harland\\net-responder (no peer-ping window)\n")
        return 0
    let pf: *EfiFile = file as *EfiFile
    (pf.close as EfiFn1)(file)
    boot_flags = boot_flags | HARLAND_BOOT_FLAG_NET_RESPONDER
    prints("    Boot option \\harland\\net-responder: peer-ping window on\n")
    return 0

# A marker file on the boot volume sets one boot flag; only its existence
# matters, like net-selftest. Returns true if the marker was there.
fn load_marker_option(root_file: u64, path: StrView, flag: u32) -> bool
    ascii_to_ucs2(path, @boot_options_path[0])
    let root: *EfiFile = root_file as *EfiFile
    var file: u64 = 0
    let st: u64 = (root.open as EfiFn5)(root_file, @file as u64, @boot_options_path[0] as u64, EFI_FILE_MODE_READ, 0)
    if st != EFI_SUCCESS
        return false
    let f: *EfiFile = file as *EfiFile
    (f.close as EfiFn1)(file)
    boot_flags = boot_flags | flag
    return true

# \harland\klog-dump asks the kernel to write its crash ring buffer to
# serial just before it starts init (AGAST #1885); \harland\boot-test asks
# it to run its self-tests before init (AGAST #1887). The boot test
# (tools/test_tier1_boot.sh) writes both and checks what the kernel logs.
fn load_test_options(root_file: u64)
    if load_marker_option(root_file, "\\harland\\klog-dump", HARLAND_BOOT_FLAG_KLOG_DUMP)
        prints("    Boot option \\harland\\klog-dump: ring buffer dump before init\n")
    if load_marker_option(root_file, "\\harland\\boot-test", HARLAND_BOOT_FLAG_BOOT_TEST)
        prints("    Boot option \\harland\\boot-test: kernel self-tests before init\n")

# ============================================================================
# ELF Loading
# ============================================================================

# Compare two null-terminated C strings
fn streq(a: *u8, b: *u8) -> i32
    var i: u64 = 0
    while true
        let ca: u8 = *(a + i)
        let cb: u8 = *(b + i)
        if ca != cb
            return 0
        if ca == 0
            return 1
        i = i + 1

# Find a symbol by name in the ELF symbol table
# Returns the symbol value (address), or 0 if not found
fn elf_find_symbol(elf_data: *u8, name: *u8) -> u64
    let elf: *Elf64Ehdr = elf_data as *Elf64Ehdr

    # Need section headers to find symbol table
    if elf.e_shoff == 0 || elf.e_shnum == 0
        prints("    No section headers\n")
        return 0

    var symtab_offset: u64 = 0
    var symtab_size: u64 = 0
    var symtab_entsize: u64 = 0
    var strtab_offset: u64 = 0

    # Find .symtab and its linked .strtab
    var i: u16 = 0
    while i < elf.e_shnum
        let sh_off: u64 = elf.e_shoff + (i as u64) * (elf.e_shentsize as u64)
        let sh: *Elf64Shdr = (elf_data + sh_off) as *Elf64Shdr

        if sh.sh_type == SHT_SYMTAB
            symtab_offset = sh.sh_offset
            symtab_size = sh.sh_size
            symtab_entsize = sh.sh_entsize

            # sh_link points to the string table section
            let strtab_idx: u32 = sh.sh_link
            let strtab_sh_off: u64 = elf.e_shoff + (strtab_idx as u64) * (elf.e_shentsize as u64)
            let strtab_sh: *Elf64Shdr = (elf_data + strtab_sh_off) as *Elf64Shdr
            strtab_offset = strtab_sh.sh_offset
            break

        i = i + 1

    if symtab_offset == 0
        prints("    No symbol table found\n")
        return 0

    # Search for the symbol
    let num_symbols: u64 = symtab_size / symtab_entsize
    var j: u64 = 0
    while j < num_symbols
        let sym_off: u64 = symtab_offset + j * symtab_entsize
        let sym: *Elf64Sym = (elf_data + sym_off) as *Elf64Sym

        # Get symbol name from string table
        let sym_name: *u8 = elf_data + strtab_offset + (sym.st_name as u64)

        if streq(sym_name, name) == 1
            return sym.st_value

        j = j + 1

    return 0

fn parse_and_load_elf() -> i32
    prints("  Parsing ELF kernel...\n")

    if kernel_buffer == 0 as *u8
        prints("    ERROR: No kernel loaded\n")
        return -1

    let elf: *Elf64Ehdr = kernel_buffer as *Elf64Ehdr

    # Check ELF magic
    let magic: u32 = *(kernel_buffer as *u32)
    if magic != ELF_MAGIC
        prints("    ERROR: Invalid ELF magic: ")
        print_hex_prefix(magic as u64)
        prints("\n")
        return -1

    prints("    Valid ELF header\n")
    prints("    ELF entry point: ")
    print_hex_prefix(elf.e_entry)
    prints("\n")
    prints("    Program headers: ")
    serial_print_udec(elf.e_phnum as u64)
    prints(" at offset ")
    print_hex_prefix(elf.e_phoff)
    prints("\n")

    # Find kernel_main in the symbol table
    # This is proper 64-bit code we can jump to directly from UEFI
    kernel_entry = elf_find_symbol(kernel_buffer, c"kernel_main")
    if kernel_entry == 0
        prints("    ERROR: kernel_main symbol not found!\n")
        return -1

    prints("    kernel_main found at: ")
    print_hex_prefix(kernel_entry)
    prints("\n")

    # Process program headers and load segments
    var i: u16 = 0
    while i < elf.e_phnum
        let ph_offset: u64 = elf.e_phoff + (i as u64) * (elf.e_phentsize as u64)
        let ph: *Elf64Phdr = (kernel_buffer + ph_offset) as *Elf64Phdr

        if ph.p_type == PT_LOAD
            prints("    LOAD segment: vaddr=")
            print_hex_prefix(ph.p_vaddr)
            prints(" paddr=")
            print_hex_prefix(ph.p_paddr)
            prints(" filesz=")
            serial_print_udec(ph.p_filesz)
            prints(" memsz=")
            serial_print_udec(ph.p_memsz)
            prints("\n")

            # Copy segment to physical address
            let src: *u8 = kernel_buffer + ph.p_offset
            let dst: *u8 = ph.p_paddr as *u8

            # Copy file contents
            var j: u64 = 0
            while j < ph.p_filesz
                *(dst + j) = *(src + j)
                j = j + 1

            # Zero BSS (memsz > filesz)
            while j < ph.p_memsz
                *(dst + j) = 0
                j = j + 1

        i = i + 1

    prints("    ELF segments loaded\n")
    return 0

# ============================================================================
# Kernel Jump
# ============================================================================

fn jump_to_kernel() -> i32
    prints("\n========================================\n")
    prints("  Jumping to kernel at higher-half!\n")
    prints("========================================\n\n")

    # Use ELF entry point if kernel was loaded from filesystem
    # Otherwise fall back to default (for testing bootloader alone)
    var kernel_virt: u64 = kernel_entry
    if kernel_virt == 0
        # No kernel loaded - use default fallback at higher-half
        kernel_virt = KERNEL_VIRT_BASE + 0x101000

    # Check if this is already a higher-half address (true higher-half kernel)
    # or a physical address (flat/legacy kernel that needs translation)
    if kernel_virt < KERNEL_VIRT_BASE
        # Legacy flat kernel - convert physical to virtual
        prints("  Kernel entry (physical): ")
        print_hex_prefix(kernel_virt)
        prints("\n")
        kernel_virt = KERNEL_VIRT_BASE + kernel_virt

    prints("  Kernel entry (virtual):  ")
    print_hex_prefix(kernel_virt)
    prints("\n")

    # Pass HarlandBootInfo address to kernel
    let boot_info_addr: u64 = @boot_info as u64
    prints("  BootInfo at:     ")
    print_hex_prefix(boot_info_addr)
    prints("\n")

    # Jump to kernel with System V calling convention (RDI = boot_info)
    # The kernel uses System V, but we've been using MS x64 (Windows target)
    # So we use inline asm to set up the registers correctly
    asm x86_64:
        movq {boot_info_addr}, %rdi
        movq {kernel_virt}, %rax
        jmpq *%rax
    return 0

# ============================================================================
# EFI Main Entry Point
# ============================================================================

# UEFI entry: ImageHandle in RCX, SystemTable in RDX (MS x64 ABI)
# Since we compile for Windows target, our function receives these correctly
pub fn efi_main(image_handle: u64, system_table: *EfiSystemTable) -> u64
    serial_init()
    prints("\n")
    prints("========================================\n")
    prints("    Harland UEFI Bootloader\n")
    prints("========================================\n")
    prints("\n")
    g_image_handle = image_handle
    g_system_table = system_table
    g_boot_services = system_table.boot_services
    prints("UEFI handles saved:\n")
    prints("  ImageHandle:   ")
    print_hex_prefix(image_handle)
    prints("\n")
    prints("  SystemTable:   ")
    print_hex_prefix(system_table as u64)
    prints("\n")
    prints("  BootServices:  ")
    print_hex_prefix(g_boot_services as u64)
    prints("\n\n")
    prints("Initialization:\n")

    # Find ACPI RSDP from UEFI configuration table (must happen before ExitBootServices)
    find_rsdp_from_uefi()

    # Initialize graphics (must happen before ExitBootServices)
    # This is optional - system will work in headless mode without GOP
    init_graphics()

    # Load kernel from filesystem (must happen before ExitBootServices)
    if load_kernel_from_fs() != 0
        prints("  WARNING: Kernel not found on filesystem\n")
        prints("  (Bootloader test mode - no kernel to load)\n")
    else
        if parse_and_load_elf() != 0
            prints("FATAL: Failed to parse/load kernel ELF\n")
            return 1

    if get_memory_map() != 0
        prints("FATAL: Failed to get memory map\n")
        return 1
    if allocate_page_tables() != 0
        prints("FATAL: Failed to allocate page tables\n")
        return 1
    if setup_page_tables() != 0
        prints("FATAL: Failed to set up page tables\n")
        return 1

    # Get final memory map (needed for ExitBootServices and HarlandBootInfo)
    if get_memory_map() != 0
        prints("FATAL: Failed to get final memory map\n")
        return 1

    # Build HarlandBootInfo structure with memory map and RSDP
    build_boot_info()

    prints("\n  Exiting boot services...\n")
    let status: u64 = efi_exit_boot_services(memory_map_key)
    if status != EFI_SUCCESS
        prints("    WARNING: ExitBootServices failed, retrying...\n")
        memory_map_size = 16384
        let map_ptr2: *u8 = @memory_map_buffer[0]
        let s2: u64 = efi_get_memory_map(@memory_map_size, map_ptr2, @memory_map_key, @memory_map_desc_size, @memory_map_desc_version)
        if s2 == EFI_SUCCESS
            # Rebuild HarlandBootInfo with updated memory map
            build_boot_info()
            let s3: u64 = efi_exit_boot_services(memory_map_key)
            if s3 != EFI_SUCCESS
                prints("    FATAL: ExitBootServices failed twice!\n")
                return 1
    prints("    Boot services exited successfully\n")
    load_page_tables()
    jump_to_kernel()
    return 0
