# Harland ring-1 driver boot record (AGAST #4734, #4875; docs/RING1_DRIVER.md
# sections 5 and 8, docs/RING2_NET.md "Drivers inside netd (D9)")
#
# What the kernel-spawned process that drives a device is handed besides
# its capabilities: the handles the kernel granted it, the MSI-X table
# indexes it may program into the device, and which kind of NIC it is.
# Under D9 that process is /bin/netd.
# Before it first runs, the kernel maps its link page into it at
# DRV_RING_BASE (the ShmMap path an attach uses, so that is the process's
# first shared mapping) and writes one DriverBoot at DRIVER_BOOT_OFF in that
# page, past NetInfo and link_seq, the only bytes NetPublish samples, as
# ServiceBoot sits past the address record. A restart has no frame object,
# so the record cannot live in one: the link page is the one page every
# spawn of netd gets.
#
# The record is advisory to the kernel, never authority: DrvMmioMap maps a
# window from the kernel's own record of it (drivers/virtio/window.ritz),
# and a handle the process does not hold is Errno.Perm whatever the record
# says. The process copies the record into private memory once, before it
# publishes anything, and checks the copy (the link handle's ShmMap must
# return DRV_RING_BASE, every window's offset and length must fit the pages
# DrvMmioMap grants). Imports only this package.

# Where the kernel maps the link page before the process runs: the first
# address of the shared-object window (kernel mm/vmm.ritz DRV_RING_BASE,
# PML4[251]).
pub const DRV_RING_BASE: u64 = 0x7D8000000000

# DriverBoot's offset in the link page: the first cache line past NetInfo
# (0x00..0x0C) and link_seq (0x20..0x28), as ADDR_BOOT_OFF is in the
# address page.
pub const DRIVER_BOOT_OFF: u64 = 0x40

# DriverBoot.magic: "VBR1", the first layout. A record with any other value
# is not one the kernel wrote; the process exits.
pub const DRIVER_BOOT_MAGIC: u32 = 0x31524256

# The most windows a record carries. A modern virtio-pci device has four
# that matter (common, notify, ISR, device config).
pub const DRIVER_BOOT_WINDOWS: u32 = 8

# DriverWindow.cfg_type: the virtio PCI capability's cfg_type (virtio 1.1
# section 4.1.4), so the driver knows which register block a window holds.
pub const VIRTIO_WINDOW_COMMON: u8 = 1
pub const VIRTIO_WINDOW_NOTIFY: u8 = 2
pub const VIRTIO_WINDOW_ISR: u8 = 3
pub const VIRTIO_WINDOW_DEVICE: u8 = 4

# DriverBoot.nic: which `Nic` netd runs (docs/E1000E.md "One netd, chosen at
# boot", AGAST #4893). The kernel hands netd the first NIC it finds, a
# virtio-net before an e1000e; netd matches the kind once and runs its loop
# on that implementation. 0 is no kind the kernel writes: netd exits.
pub const NIC_KIND_VIRTIO: u16 = 1
pub const NIC_KIND_E1000E: u16 = 2

# DriverWindow.cfg_type of an e1000e's one window: BAR0 from its first byte,
# E1000E_BAR0_LEN bytes of registers (the same offsets on the 82574L and the
# I218-V). Past every virtio cfg_type, so neither kind's check takes the
# other's window. BAR3, the 82574L's MSI-X table, is never granted.
pub const E1000E_WINDOW_BAR0: u8 = 0x80
pub const E1000E_BAR0_LEN: u32 = 0x20000

# One granted MMIO window: its CAP_TYPE_MMIO handle and where its register
# block sits in the pages DrvMmioMap (221) returns (the capability's byte
# offset within the first page, and its length).
pub struct DriverWindow
    handle: u64                      # CAP_TYPE_MMIO
    offset: u32                      # < 4096: first byte within the first page
    length: u32                      # bytes of the capability
    notify_multiplier: u32           # VIRTIO_WINDOW_NOTIFY only, else 0
    cfg_type: u8                     # VIRTIO_WINDOW_*, or E1000E_WINDOW_BAR0
    _pad: [3]u8

# The record at DRIVER_BOOT_OFF of the link page.
pub struct DriverBoot
    magic: u32                       # DRIVER_BOOT_MAGIC
    window_count: u32                # 0..=DRIVER_BOOT_WINDOWS
    irq: u64                         # CAP_TYPE_IRQ: DrvIrqWait, DrvDmaAlloc
    frame: u64                       # CAP_TYPE_SHM: the frame object while the kernel holds the seat; 0 on a restart
    link: u64                        # CAP_TYPE_SHM with CAP_RIGHT_PUBLISH: this page
    # The MSI-X table indexes: virtio's config, RX and TX queues; the
    # 82574L's Other (link changes), RXQ0 and TXQ0 (e1000e_msix).
    msix_config: u16                 # MSI-X table index for config changes
    msix_rx: u16                     # ... for the RX queue (queue 0)
    msix_tx: u16                     # ... for the TX queue (queue 1)
    nic: u16                         # NIC_KIND_*
    windows: [8]DriverWindow

# The record's address in a link page mapped at `page`.
pub fn driver_boot_at(page: u64) -> *DriverBoot
    (page + DRIVER_BOOT_OFF) as *DriverBoot

# ============================================================================
# The ring-2 service's boot record (AGAST #4743, docs/RING2_NET.md "Service
# binary and respawn")
# ============================================================================
#
# What /bin/netd is handed when it becomes the service: the record lives in
# netd's address page, at ADDR_BOOT_OFF, past the NetAddr record and its
# seqlock word. The kernel writes it through its physmap and enqueues the
# page's handle as ATTACH on netd's inbox (D9, #4875: netd is running by
# then, as the seat's driver); netd ShmMaps the handle and checks the record
# at the address that returns. The kernel's NetPublish samples only the
# record and the word, never these bytes.
#
# Harland has no user clock (ShmWait's deadline is relative for that
# reason), and netd runs DHCP and ARP timers, so the record also carries the
# kernel's TSC calibration: netd reads the TSC (CR4.TSD is clear) and
# divides by tsc_hz / 1000 for its millisecond clock.
#
# As with DriverBoot the record is advisory, never authority: a handle netd
# does not hold is Errno.Perm whatever the record says. netd copies it into
# private memory once, before it publishes anything, and checks the copy
# (the magic, a usable tsc_hz). The two seat indexes are the exception: the
# kernel fills them in at the handoff, and netd reads them after its ready
# NetPublish.

# ServiceBoot.magic: "NSB1", the first layout.
pub const SERVICE_BOOT_MAGIC: u32 = 0x3142534E

# The record's offset in the address page: the first cache line past
# NetAddr (0x00..0x20) and the seqlock word (0x20..0x28).
pub const ADDR_BOOT_OFF: u64 = 0x40

# The slowest TSC netd accepts: 1 MHz, so a millisecond is at least 1000
# ticks and the clock never divides by zero.
pub const SERVICE_BOOT_TSC_MIN_HZ: u64 = 1000000

# The record at ADDR_BOOT_OFF of the address page.
pub struct ServiceBoot
    magic: u32                       # SERVICE_BOOT_MAGIC
    _pad: u32
    frame: u64                       # unused since D9 (#4875): DriverBoot names the frame object; 0
    addr: u64                        # CAP_TYPE_SHM with CAP_RIGHT_PUBLISH: this page
    tsc_hz: u64                      # the kernel's calibrated TSC rate
    # The frame-seat handoff (AGAST #4744): the kernel seat's private RX
    # read_idx and TX write_idx when it gave the rings up. Written after
    # netd's ready NetPublish has committed and before that call returns,
    # so netd reads them only once NetPublish has returned.
    seat_rx_read: u64
    seat_tx_write: u64

# The record's address in an address page mapped at `page`.
pub fn service_boot_at(page: u64) -> *ServiceBoot
    (page + ADDR_BOOT_OFF) as *ServiceBoot
