# Harland wait and notify ABI (AGAST #4718, docs/RING1_DRIVER.md
# "Wait and notify")
#
# DrvIrqWait (220) and ShmWait (229) both take a pointer to a WaitRequest.
# The kernel copies the request and the source array before it clears a
# latch, collects matches (the IRQ, then the listed sources in order, then
# inbox records), and writes out_count and that many WaitEvents to out.
# This module imports nothing, so the kernel and a ring-1 process compile
# the same bytes.

# Event bits on a latch, a WaitSource.mask and a WaitEvent.bits.
pub const EVENT_DATA: u32 = 1          # a frame or request was published
pub const EVENT_SPACE: u32 = 2         # the consumer freed a slot
pub const EVENT_PEER_CLOSE: u32 = 4    # kernel: the peer exited, object retired
pub const EVENT_DRIVER_GONE: u32 = 8   # kernel: the driver exited, object retired
pub const EVENT_LINK: u32 = 16         # kernel: NetPublish took a new snapshot
pub const EVENT_RESERVED_32: u32 = 32  # reserved and unused; not an ack
pub const EVENT_ATTACH: u32 = 64       # kernel: an inbox record for a new handle

# The only bits a userspace ShmNotify may post. Any other bit, a mix that
# contains one, or zero is Errno.Inval. The rest are kernel posts.
pub const EVENT_USER_MASK: u32 = EVENT_DATA | EVENT_SPACE

# WaitRequest.source_count is at most this: the frame object, five app
# exchanges and two spare.
pub const WAIT_SOURCE_CAP: u32 = 8
# WaitRequest.out_cap is 1 through this. The process inbox holds as many
# records.
pub const WAIT_OUT_CAP: u32 = 8

# DrvIrqWait ignores WaitRequest.deadline and waits until now + this.
pub const DEVICE_WAIT_MS: u64 = 100
# A peer that has not detached from a retired shared object this long after
# PEER_CLOSE or DRIVER_GONE is unmapped by the kernel.
pub const SHM_DETACH_TIMEOUT_MS: u64 = 1000

# One source a wait lists: a CAP_TYPE_SHM handle and the bits it waits for.
# The mask picks among DATA and SPACE; a kernel post on the source
# (PEER_CLOSE, DRIVER_GONE, LINK) is copied whatever the mask.
pub struct WaitSource
    handle: u64
    mask: u32                        # EVENT_*
    _pad: u32

# One collected event. For DrvIrqWait's IRQ record, handle is the
# CAP_TYPE_IRQ handle and bits is EVENT_DATA.
pub struct WaitEvent
    handle: u64
    bits: u32                        # EVENT_*
    _pad: u32

# The argument of both waits. The caller sets out_count to 0; the kernel
# writes it on returns 0, 1 and 2 and never on an errno. The user source
# array is not written.
pub struct WaitRequest
    sources: *WaitSource
    source_count: u32                # 0..=WAIT_SOURCE_CAP
    out_cap: u32                     # 1..=WAIT_OUT_CAP
    out: *WaitEvent
    deadline: u64                    # ShmWait only: ms from the call; 0 checks once
    out_count: u32                   # written by the kernel
    _pad: u32
