# Harland link and address snapshot ABI (AGAST #4718, #4742;
# docs/RING1_DRIVER.md section 7, docs/RING2_NET.md "Address publication")
#
# The link object is one page, mapped only into the ring-1 driver: NetInfo
# at LINK_INFO_OFF and the seqlock word link_seq (a u64) at LINK_SEQ_OFF.
# The driver publishes with the seqlock (odd while writing) and calls
# NetPublish (226); the kernel samples a stable generation into its
# snapshot, which the NetInfo syscall (224) copies out. Imports only this
# package.

import driver_abi.frame_ring { FRAME_MAX }

pub const LINK_INFO_OFF: u64 = 0
pub const LINK_SEQ_OFF: u64 = 0x20

# Zeroed memory starts at 0, which is unpublished and never a generation.
pub const LINK_SEQ_UNPUBLISHED: u64 = 0
# The first stable generation; every later one is the next even number.
pub const LINK_SEQ_FIRST_STABLE: u64 = 2

pub const ETH_HEADER_LEN: u32 = 14
# The driver stores min(device MTU, this): 2034.
pub const NETINFO_MTU_MAX: u32 = (FRAME_MAX as u32) - ETH_HEADER_LEN

# NetInfo.device_type when the virtio-net driver publishes. The kernel's
# drivers/netdev.ritz uses the same value.
pub const NETDEV_TYPE_VIRTIO: u8 = 1
# ... when the e1000e Nic publishes (nic/src/e1000e.ritz, AGAST #4892). 2 is
# the kernel's NETDEV_TYPE_ENA.
pub const NETDEV_TYPE_E1000E: u8 = 3

pub struct NetInfo
    mac: [6]u8
    link_up: u8                      # 1 when the link is up (virtio-net status bit 0, e1000e STATUS.LU)
    device_type: u8                  # NETDEV_TYPE_*
    mtu: u32                         # min(device MTU, NETINFO_MTU_MAX)

# The address record NetAddr (225) copies out of the kernel's snapshot of
# the ring-2 service's address page (docs/RING2_NET.md "Address
# publication"): the lease the service's DHCP client holds. Addresses are
# IPv4 in wire order. `configured` is 1 once DHCP has an ACK and 0 in the
# cleared record a NAK, expiry or link loss publishes; `generation` is the
# stable seqlock value the snapshot was taken at (2, 4, ...). A ring-3 tool
# calls NetAddr for this (indium's user/net_tool.ritz, AGAST #4751); the
# service's page and its seqlock word are #4742's.
pub struct NetAddr
    address: [4]u8
    gateway: [4]u8
    netmask: [4]u8
    dns: [4]u8
    configured: u8
    _pad: [7]u8                      # zero
    generation: u64

# The address object is one page, mapped only into the ring-2 service, on
# the link page's layout: the NetAddr record at ADDR_RECORD_OFF and the
# seqlock word (a u64) at ADDR_SEQ_OFF, the same offset as link_seq, so the
# link_write_* / link_read_* steps below run on either page. The page's
# NetAddr.generation is not the seqlock word: the kernel's snapshot sets it
# to the generation it sampled.
pub const ADDR_RECORD_OFF: u64 = 0
pub const ADDR_SEQ_OFF: u64 = 0x20

# ============================================================================
# The seqlock (section 7, AGAST #4730)
# ============================================================================
#
# `page` is the link page's address: the driver's mapping, or the kernel's
# physmap view of it. Ritz atomics are seq_cst loads and stores; fence() is
# what orders the plain NetInfo accesses against them (LANGUAGE_SPEC §18.5).

fn link_seq_word(page: u64) -> *u64
    (page + LINK_SEQ_OFF) as *u64

fn link_info(page: u64) -> *NetInfo
    (page + LINK_INFO_OFF) as *NetInfo

# Writer step 1-2: store the next odd value (1 on a fresh page: a write is
# in progress), then fence() so the NetInfo stores that follow cannot
# become visible under the previous even generation. Returns that odd
# value for link_write_end. Only the driver writes the page.
pub fn link_write_begin(page: u64) -> u64
    let odd: u64 = (atomic_load(link_seq_word(page)) + 1) | 1
    atomic_store(link_seq_word(page), odd)
    fence()
    odd

# Writer step 4: the NetInfo bytes are written; store `odd + 1`, the new
# stable generation (2 first, then the next even number, never 0).
pub fn link_write_end(page: u64, odd: u64)
    atomic_store(link_seq_word(page), odd + 1)

# Writer steps 1-4 for `info`; returns the generation it published. Step 5,
# NetPublish (226), is the driver's next call.
pub fn link_publish(page: u64, info: *NetInfo) -> u64
    let odd: u64 = link_write_begin(page)
    *link_info(page) = *info
    link_write_end(page, odd)
    odd + 1

# Reader step 1: link_seq if it is a stable generation, else
# LINK_SEQ_UNPUBLISHED (odd: a write is in progress; below 2: never
# published).
pub fn link_read_begin(page: u64) -> u64
    let s1: u64 = atomic_load(link_seq_word(page))
    if s1 < LINK_SEQ_FIRST_STABLE or (s1 & 1) != 0
        return LINK_SEQ_UNPUBLISHED
    s1

# Reader step 2: a plain copy of the record, maybe torn until steps 3-4
# say otherwise.
pub fn link_read_copy(page: u64) -> NetInfo
    *link_info(page)

# Reader steps 3-4: fence() so the copy cannot sink below the second load,
# then whether link_seq is still `s1` (the copy is one generation).
pub fn link_read_end(page: u64, s1: u64) -> bool
    fence()
    atomic_load(link_seq_word(page)) == s1

# What one sample took: `info` at stable `generation`, or generation
# LINK_SEQ_UNPUBLISHED and no record (this package imports nothing, so not
# an Option).
pub struct LinkSample
    generation: u64
    info: NetInfo

# One sample (steps 1-4): the stable generation and its record, or
# LINK_SEQ_UNPUBLISHED (odd, unpublished, or a write that started during
# the copy). The kernel's NetPublish retries a bounded number of times.
pub fn link_sample(page: u64) -> LinkSample
    var got: LinkSample
    got.generation = LINK_SEQ_UNPUBLISHED
    let s1: u64 = link_read_begin(page)
    if s1 == LINK_SEQ_UNPUBLISHED
        return got
    let copy: NetInfo = link_read_copy(page)
    if link_read_end(page, s1)
        got.generation = s1
        got.info = copy
    got

# ============================================================================
# The address page (RING2_NET.md "Address publication", AGAST #4742)
# ============================================================================
#
# The ring-2 service is the only writer, with the same seqlock as link_seq
# (generation 0 unpublished, the first stable value 2); NetPublish (226)
# with the page's handle samples it into the kernel's snapshot, which
# NetAddr (225) copies out.

fn addr_record(page: u64) -> *NetAddr
    (page + ADDR_RECORD_OFF) as *NetAddr

# Writer steps 1-4 for `rec`; returns the generation it published (2, 4,
# ...). The page's copy of rec.generation is that generation too, so the
# service reading its own page sees it. Step 5, NetPublish, is the
# service's next call.
pub fn addr_publish(page: u64, rec: *NetAddr) -> u64
    let odd: u64 = link_write_begin(page)
    let dst: *NetAddr = addr_record(page)
    *dst = *rec
    dst.generation = odd + 1
    link_write_end(page, odd)
    odd + 1

# What one sample of an address page took: `addr` at stable `generation`
# (addr.generation is it too), or generation LINK_SEQ_UNPUBLISHED and no
# record.
pub struct AddrSample
    generation: u64
    addr: NetAddr

# One sample (reader steps 1-4) of an address page; as link_sample.
pub fn addr_sample(page: u64) -> AddrSample
    var got: AddrSample
    got.generation = LINK_SEQ_UNPUBLISHED
    let s1: u64 = link_read_begin(page)
    if s1 == LINK_SEQ_UNPUBLISHED
        return got
    let copy: NetAddr = *addr_record(page)
    if link_read_end(page, s1)
        got.generation = s1
        got.addr = copy
        got.addr.generation = s1
    got
