# Harland link snapshot ABI (AGAST #4718, docs/RING1_DRIVER.md section 7)
#
# The link object is one page, mapped only into the ring-1 driver: NetInfo
# at LINK_INFO_OFF and the seqlock word link_seq (a u64) at LINK_SEQ_OFF.
# The driver publishes with the seqlock (odd while writing) and calls
# NetPublish (226); the kernel samples a stable generation into its
# snapshot, which the NetInfo syscall (224) copies out. Imports only this
# package.

import driver_abi.frame_ring { FRAME_MAX }

pub const LINK_INFO_OFF: u64 = 0
pub const LINK_SEQ_OFF: u64 = 0x20

# Zeroed memory starts at 0, which is unpublished and never a generation.
pub const LINK_SEQ_UNPUBLISHED: u64 = 0
# The first stable generation; every later one is the next even number.
pub const LINK_SEQ_FIRST_STABLE: u64 = 2

pub const ETH_HEADER_LEN: u32 = 14
# The driver stores min(device MTU, this): 2034.
pub const NETINFO_MTU_MAX: u32 = (FRAME_MAX as u32) - ETH_HEADER_LEN

# NetInfo.device_type when the virtio-net driver publishes. The kernel's
# drivers/netdev.ritz uses the same value.
pub const NETDEV_TYPE_VIRTIO: u8 = 1

pub struct NetInfo
    mac: [6]u8
    link_up: u8                      # 1 when virtio-net status bit 0 is set
    device_type: u8                  # NETDEV_TYPE_*
    mtu: u32                         # min(device MTU, NETINFO_MTU_MAX)

# The address record NetAddr (225) copies out of the kernel's snapshot of
# the ring-2 service's address page (docs/RING2_NET.md "Address
# publication"): the lease the service's DHCP client holds. Addresses are
# IPv4 in wire order. `configured` is 1 once DHCP has an ACK and 0 in the
# cleared record a NAK, expiry or link loss publishes; `generation` is the
# stable seqlock value the snapshot was taken at (2, 4, ...). A ring-3 tool
# calls NetAddr for this (indium's user/net_tool.ritz, AGAST #4751); the
# service's page and its seqlock word are #4742's.
pub struct NetAddr
    address: [4]u8
    gateway: [4]u8
    netmask: [4]u8
    dns: [4]u8
    configured: u8
    _pad: [7]u8                      # zero
    generation: u64
