# Harland DMA allocation ABI (AGAST #4718, docs/RING1_DRIVER.md section 5)
#
# DrvDmaAlloc (222) returns the run's user VA in rax and copies a DmaAlloc
# out through the caller's pointer. Imports nothing.

# DrvDmaAlloc rejects a size of 0 or above this.
pub const DMA_ALLOC_MAX: u64 = 4 * 1024 * 1024

# What DrvDmaAlloc copies out: the IOVA in this device's DMA domain (the
# address the driver programs into a queue register) and the granted size,
# rounded up to pages.
pub struct DmaAlloc
    iova: u64
    size: u64
