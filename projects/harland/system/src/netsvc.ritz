# The ring-2 network service's loop body (AGAST #4743, docs/RING2_NET.md
# "Service wait", "Ethernet demux", "Address publication", "Frame seat")
#
# Everything /bin/netd does that is not a syscall: the frame-ring halves it
# owns (RX consumer, TX producer), RX through netstack (Ethernet demux, ARP,
# IPv4, ICMP echo, UDP, the DHCP client), the send side with its pending-TX
# queue, the protocol timers, and the address page's seqlock writes. The
# frame region and the address page are plain memory here, so
# test/test_netsvc.ritz drives this file with the driver's halves of the
# rings in the same process and a fake clock; netd.ritz adds the ShmWait,
# the notifies, NetPublish and the clock.
#
# The send side (RING2_NET.md "Ethernet demux"): a frame goes straight onto
# the TX ring while it has a free slot and nothing is queued ahead of it.
# A full ring queues it, up to PENDING_TX_CAP (32, one virtio posted pool),
# and the service goes back to RX, timers and the rest; a send that finds
# the queue full fails to its caller and RX continues. SPACE is in the wait
# mask only while that queue is non-empty, which with the queue drained into
# every free slot first means only while the TX ring is full, so a free
# slot with nothing queued is idle and a queued frame leaves on the driver's
# SPACE notify alone, with no RX frame needed.
#
# An IPv4 send to a next hop ARP has not resolved waits in ArpWaits (the
# service "keeps the pending send and finishes it when the reply arrives")
# and is dropped when ARP gives up on that hop.
#
# The app exchanges (RING2_NET.md "Ring-3 app exchange", AGAST #4748): at
# most APP_ATTACH_CAP attachments, each a request ring the service consumes
# and an event ring it produces (libnet.ring's halves over net_abi's
# AppDesc). A pass drains each attachment's requests: one private copy,
# validated; a bad slot is skipped and the index advances; an impossible
# occupancy closes that attachment only. A reply-producing request is
# consumed at that read and its reply is owed in private state until the
# event ring has a slot; an APP_SEND_TO behind it is not held up. A UDP
# datagram for a bound port is posted as EV_DATAGRAM only while one event
# slot stays free for a reply, else dropped and counted. The endpoint table
# is netstack.app's AppPorts; netd maps an ATTACH record, lists each
# attachment in its wait, posts the notifies this file asks for and
# CapRevokes an attachment this file closed.
#
# APP_PING (AGAST #4749, RING2_NET.md "ICMP"): one echo in flight per
# attachment. The request is consumed at read like every reply kind; while
# ARP resolves the next hop the echo is one ArpWait on that hop. The echo
# is published once and PING_DEADLINE_MS starts then (handed to the TX
# side: the ring, or the pending-TX queue it leaves in order), never
# restarted. Exactly one terminal event: a matching echo reply before the
# deadline is EV_PING_REPLY, the deadline or ARP giving up is EV_ERROR
# Errno.Io, and a reply after that is dropped. While the echo is in flight
# it keeps one owed slot, so its terminal event always fits OWED_CAP.

import driver_abi.frame_ring { FRAME_MAX, FRAME_RING_CAP }
import driver_abi.link { NetInfo, NetAddr, addr_publish }
import driver_abi.spsc { SpscProducer, SpscConsumer, SpscClose, Publish, Take, FrameBytes, spsc_rx_ring, spsc_tx_ring }
import driver_abi.wait { WaitEvent, WaitSource, EVENT_DATA, EVENT_SPACE, EVENT_PEER_CLOSE, EVENT_DRIVER_GONE, EVENT_LINK }
import netstack.ethernet { MacAddr, EtherType, EthRx, SendError, ETH_PAYLOAD_OFF, eth_demux }
import netstack.arp { ArpOp, ArpRx, ArpLearn, ArpSend, ArpEvent, ArpTable, ARP_HOP_CAP, arp_parse, arp_request_write, arp_reply_write, arp_should_reply, arp_broadcast_mac }
import netstack.ipv4 { Ipv4Config, Ipv4Rx, IpProto, IPV4_HEADER_MIN, IPV4_BROADCAST, DHCP_SERVER_PORT, DHCP_CLIENT_PORT, ipv4_parse, ipv4_next_hop }
import netstack.icmp { IcmpRx, IcmpType, icmp_parse, icmp_should_reply, icmp_reply_next_hop, icmp_echo_reply_frame_write, icmp_echo_request_frame_write }
import netstack.udp { UdpRx, UDP_HEADER_LEN, udp_parse, udp_frame_write }
import netstack.dhcp { DhcpClient, DhcpStep, DhcpSend, DhcpRecord, DhcpTx, DhcpLease }
import netstack.app { AppPorts, AppOwner, AppReq, BindError, APP_ATTACH_CAP, APP_EBADF, APP_EEXIST, APP_EINVAL, APP_EIO, APP_ENFILE, APP_ENOSYS, app_request }
import net_abi.app { AppDesc, APP_DEPTH, APP_SLOT, EV_DATAGRAM, EV_PING_REPLY, EV_BOUND, EV_CLOSED, EV_ERROR, PING_DEADLINE_MS }
import libnet.ring { AppConsumer, AppProducer, AppPoll, AppTake, AppPublish, AppBytes, app_req_ring, app_ev_ring }
import ritzlib.span

# The pending-TX queue's depth: one virtio posted pool (RING2_NET.md
# "Ethernet demux").
pub const PENDING_TX_CAP: i64 = 32

# IPv4 frames waiting for ARP, across every hop. ARP caps each hop at 16
# (ARP_PENDING_CAP); this store is the frames themselves, sized for one
# hop's worth so the service's private memory stays bounded.
pub const ARP_WAIT_CAP: i64 = 16

# The longest the service parks with no protocol timer armed (an infinite
# lease, or no link): a wake that only re-arms the wait.
pub const WAIT_IDLE_MS: u64 = 60000

# The most RX frames one service pass takes, one ring's worth, so a driver
# that keeps the ring full cannot keep the timers from running; netd checks
# again without parking when a pass stopped there.
pub const RX_BUDGET: i64 = FRAME_RING_CAP as i64

# The DHCP payload buffer: a 576-byte minimum datagram covers every
# message the client writes.
const DHCP_BUF_LEN: i64 = 576

# Replies owed to one attachment, consumed requests whose event has not
# found an event slot. One per request slot: a drain stops taking requests
# from an attachment whose owed replies fill this.
pub const OWED_CAP: i64 = 32

# The longest the service parks while a reply is owed to an app that has
# not freed an event slot: the app frees slots without a notify.
pub const OWED_RETRY_MS: u64 = 100

# The ICMP sequence number of every APP_PING echo: one echo per request, so
# the ICMP identifier alone (a fresh one per echo) tells echoes apart.
pub const PING_SEQ: u16 = 1

# What happened to one send.
pub enum Sent
    Published                        # on the TX ring
    Queued                           # on the pending-TX queue
    Waiting                          # waiting for ARP to resolve the next hop
    Failed                           # the pending queue (or the ARP wait store) was full, or the frame did not build

# One IPv4 frame waiting for its next hop's MAC (bytes 0..6 are filled in
# when ARP resolves `hop`).
pub struct ArpWait
    frame: FrameBytes
    len: u32
    hop: u32
    live: bool
    # The attachment whose APP_SEND_TO this is (None: the service's own)
    # and its serial, so a give-up counts in that attachment's send_drops
    # and not in a later one's in the same slot.
    app: Option<i64>
    serial: u32
    # The frame is that attachment's APP_PING echo: ARP resolving the hop
    # starts its deadline, ARP giving up is its EV_ERROR.
    ping: bool

pub struct NetCounters
    rx_frames: u64                   # taken off the RX ring
    rx_rejects: u64                  # bad RX slots (the driver's descriptor)
    rx_drops: u64                    # dropped by a protocol check
    udp_unbound: u64                 # UDP for a port no one serves
    tx_frames: u64                   # published on the TX ring
    tx_queued: u64                   # sends that waited on the pending-TX queue
    send_fails: u64                  # sends that failed to their caller
    arp_drops: u64                   # frames dropped when ARP gave up

# One reply owed to an attachment.
pub struct Owed
    kind: u16
    id: u32
    handle: u32
    port: u16
    status: i16
    addr: [4]u8                      # the peer of an EV_PING_REPLY, else zero

# Where an attachment's one APP_PING is.
pub enum PingState
    Idle                             # none in flight: the next one is served
    Arp                              # the echo waits for ARP on its next hop
    Echo                             # the echo is out; the deadline runs
    Replied                          # EV_PING_REPLY is owed, its bytes in ping_bufs

pub struct AppCounters
    requests: u64                    # requests dispatched
    rejects: u64                     # bad slots and requests not dispatched
    send_drops: u64                  # APP_SEND_TOs that did not reach the wire
    ev_drops: u64                    # datagrams dropped to keep the reply slot

# One app attachment.
pub struct AppAttach
    live: bool
    # The service closed or detached it and netd still holds the handle:
    # netd CapRevokes it (take_revoke) before the slot is reused.
    revoke: bool
    handle: u64                      # netd's CAP_TYPE_SHM handle
    serial: u32                      # which attachment this slot holds
    req: AppConsumer
    ev: AppProducer
    owed: [32]Owed                   # OWED_CAP, a FIFO
    owed_head: i64
    owed_count: i64
    taken: u32                       # requests consumed since the last notify
    posted: u32                      # events posted since the last notify
    counters: AppCounters
    # The one APP_PING: its request id, peer, ICMP identifier, and the
    # deadline while Echo.
    ping: PingState
    ping_id: u32
    ping_dst: u32
    ping_ident: u16
    ping_deadline: u64
    ping_len: u32                    # the echoed bytes in ping_bufs while Replied

# A ShmNotify netd owes an attachment: DATA for posted events, SPACE for
# consumed requests.
pub struct AppNotify
    handle: u64
    bits: u32

# The IPv4 address in wire-order bytes `b` as a u32.
fn ip_of(b: [4]u8) -> u32
    ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | (b[3] as u32)

# What a wait's events mean to the service.
pub struct Wake
    # DRIVER_GONE or PEER_CLOSE on the frame object: the driver is gone
    # (this cutover does not replace it), so the service exits.
    gone: bool
    # LINK on the frame object: NetPublish took a new link snapshot; read
    # NetInfo again.
    link: bool

# Sort one wait's events. DATA, SPACE and the deadline need nothing but a
# service pass, which runs after every wait.
pub fn wake_of(events: [WaitEvent], frame: u64) -> Wake
    var w = Wake { gone: false, link: false }
    for i in 0..events.len
        let ev = events[i]
        if ev.handle != frame
            continue
        if (ev.bits & (EVENT_DRIVER_GONE | EVENT_PEER_CLOSE)) != 0
            w.gone = true
        if (ev.bits & EVENT_LINK) != 0
            w.link = true
    w

# The IPv4 address `ip` (a.b.c.d as a << 24 | ...) in wire order.
fn ip_bytes(ip: u32) -> [4]u8
    [(ip >> 24) as u8, ((ip >> 16) & 0xFF) as u8, ((ip >> 8) & 0xFF) as u8, (ip & 0xFF) as u8]

fn opt_ip_bytes(ip: Option<u32>) -> [4]u8
    match ip
        Some(a) => ip_bytes(a)
        None => [0, 0, 0, 0]

# The address record a lease writes, or the cleared one (configured 0).
pub fn addr_record(lease: Option<DhcpLease>) -> NetAddr
    var rec: NetAddr
    rec.address = [0, 0, 0, 0]
    rec.gateway = [0, 0, 0, 0]
    rec.netmask = [0, 0, 0, 0]
    rec.dns = [0, 0, 0, 0]
    rec.configured = 0
    rec._pad = [0, 0, 0, 0, 0, 0, 0]
    rec.generation = 0
    match lease
        Some(l) =>
            rec.address = ip_bytes(l.addr)
            rec.gateway = opt_ip_bytes(l.router)
            rec.netmask = opt_ip_bytes(l.netmask)
            rec.dns = opt_ip_bytes(l.dns)
            rec.configured = 1
        None => pass
    rec

pub struct NetSvc
    rx: SpscConsumer
    tx: SpscProducer
    # The address page (netd's mapping): only this service writes it.
    addr_page: u64
    # The last link snapshot NetInfo copied, and whether DHCP is running
    # on it (link_up was 1 when it was taken).
    link: NetInfo
    up: bool
    dhcp: DhcpClient
    arp: ArpTable
    # The pending-TX queue: a FIFO of whole frames, PENDING_TX_CAP deep.
    # Its fields sit directly in NetSvc: a 64 KiB nested struct is loaded
    # whole by a field read, which clang's instruction selection crashes on.
    pend_frames: [32]FrameBytes
    pend_lens: [32]u32
    pend_head: i64
    pend_count: i64
    waits: [16]ArpWait               # ARP_WAIT_CAP
    # The last generation published on the address page, and whether the
    # kernel has not sampled it yet (netd calls NetPublish).
    generation: u64
    publish_due: bool
    # TX slots published since netd last posted DATA.
    published: u32
    # The frame ring is unusable: the driver's index is impossible.
    closed: Option<SpscClose>
    # The last RX pass stopped at RX_BUDGET with frames maybe left.
    rx_more: bool
    rand: u32
    counters: NetCounters
    rx_buf: FrameBytes               # the private copy of one RX slot
    out: FrameBytes                  # where one TX frame is built
    dhcp_buf: [576]u8                # DHCP_BUF_LEN
    # The app exchanges.
    apps: [5]AppAttach               # APP_ATTACH_CAP
    ports: AppPorts
    app_serial: u32
    # The last pass stopped draining an attachment at APP_DEPTH requests.
    app_more: bool
    # The attachment whose send is being built, and whether it is that
    # attachment's ping echo.
    out_app: Option<i64>
    out_ping: bool
    req_buf: AppBytes                # the private copy of one request's payload
    # Each attachment's echoed bytes while its EV_PING_REPLY is owed.
    ping_bufs: [5]AppBytes           # APP_ATTACH_CAP
    # The last ICMP identifier an echo used.
    ping_ident: u16

impl NetSvc
    # The service over the frame region at `region` and the address page
    # at `addr_page`, both private indexes at 0, nothing published. `seed`
    # (any non-zero value) seeds the DHCP jitter and transaction ids.
    pub fn init(self: @&NetSvc, region: u64, addr_page: u64, seed: u32)
        self.rx = SpscConsumer.new(spsc_rx_ring(region))
        self.tx = SpscProducer.new(spsc_tx_ring(region))
        self.addr_page = addr_page
        self.link = NetInfo { mac: [0, 0, 0, 0, 0, 0], link_up: 0, device_type: 0, mtu: 0 }
        self.up = false
        self.dhcp = DhcpClient.new([0, 0, 0, 0, 0, 0], 1)
        self.arp.init()
        self.pend_head = 0
        self.pend_count = 0
        for i in 0..ARP_WAIT_CAP
            self.waits[i].live = false
        for a in 0..APP_ATTACH_CAP
            self.apps[a].live = false
            self.apps[a].revoke = false
        self.ports.init()
        self.app_serial = 0
        self.app_more = false
        self.out_app = None
        self.out_ping = false
        self.ping_ident = 0
        self.generation = 0
        self.publish_due = false
        self.published = 0
        self.closed = None
        self.rx_more = false
        self.rand = seed
        if self.rand == 0
            self.rand = 0x6E657464           # "netd": xorshift needs a non-zero state
        self.counters = NetCounters { rx_frames: 0, rx_rejects: 0, rx_drops: 0, udp_unbound: 0, tx_frames: 0, tx_queued: 0, send_fails: 0, arp_drops: 0 }

    # The ready state (RING2_NET.md "Frame seat"): the rings are mapped and
    # the wait is about to be installed; publish the cleared record,
    # generation 2 on a fresh page, configured 0, before DHCP starts. The
    # NIC's MAC from the first link snapshot is DHCP's client hardware
    # address. Returns the generation; netd's next call is NetPublish.
    pub fn ready(self: @&NetSvc, link: NetInfo) -> u64
        self.link = link
        self.dhcp = DhcpClient.new(link.mac, self.next_rand())
        self.publish(None)
        self.generation

    # The frame seat (RING2_NET.md "Frame seat", AGAST #4744): the kernel
    # consumed RX and produced TX on these rings before netd, and its
    # private indexes stopped at `rx_read` and `tx_write`. netd's halves
    # resume there; halves at 0 would find an impossible occupancy and
    # close the ring. Called once, after the ready NetPublish returned.
    pub fn take_seat(self: @&NetSvc, rx_read: u64, tx_write: u64)
        self.rx = SpscConsumer.resume(self.rx.ring, rx_read)
        self.tx = SpscProducer.resume(self.tx.ring, tx_write)

    # The leased address, the one netd's last record carries as
    # configured; None once DHCP has cleared the lease (link down, NAK,
    # expiry).
    pub fn address(self: @NetSvc) -> Option<u32>
        match self.dhcp.lease
            Some(l) => Some(l.addr)
            None => None

    # A new link snapshot. Link up starts DHCP from Idle; link down clears
    # the record and leaves DHCP in Idle (RING2_NET.md "UDP and DHCP").
    pub fn set_link(self: @&NetSvc, link: NetInfo, now: u64)
        let mac = self.link.mac
        self.link = NetInfo { mac: mac, link_up: link.link_up, device_type: link.device_type, mtu: link.mtu }
        let want = link.link_up != 0
        if want and not self.up
            self.up = true
            let r = self.next_rand()
            let step = self.dhcp.start(now, r)
            self.dhcp_apply(step, now)
        else if not want and self.up
            self.up = false
            let step = self.dhcp.link_down()
            self.dhcp_apply(step, now)

    # One pass: move queued frames into free TX slots, take up to
    # RX_BUDGET RX frames through the stack, run the protocol timers, and
    # move queued frames again. Err when the frame ring is unusable.
    pub fn service(self: @&NetSvc, now: u64) -> Result<(), SpscClose>
        self.flush()
        self.rx_pass(now)
        self.tick(now)
        self.apps_pass(now)
        self.flush()
        match self.closed
            Some(why) => Err(why)
            None => Ok(())

    # The ShmWait mask for the frame object: DATA always (an RX frame),
    # SPACE only while the pending-TX queue holds a frame.
    pub fn wait_mask(self: @&NetSvc) -> u32
        if self.pend_count > 0
            return EVENT_DATA | EVENT_SPACE
        EVENT_DATA

    # The ShmWait deadline, in ms from `now`: 0 when a timer is due or the
    # last RX pass left frames, else the nearest DHCP or ARP timer, at most
    # WAIT_IDLE_MS.
    pub fn deadline(self: @&NetSvc, now: u64) -> u64
        if self.rx_more or self.app_more
            return 0
        var at: u64 = now + WAIT_IDLE_MS
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live and self.apps[a].owed_count > 0 and now + OWED_RETRY_MS < at
                at = now + OWED_RETRY_MS
            if self.apps[a].live and self.apps[a].ping == PingState.Echo and self.apps[a].ping_deadline < at
                at = self.apps[a].ping_deadline
        match self.dhcp.next_deadline()
            Some(d) =>
                if d < at
                    at = d
            None => pass
        match self.arp.next_deadline()
            Some(d) =>
                if d < at
                    at = d
            None => pass
        if at <= now
            return 0
        at - now

    # TX slots published since the last call: netd posts DATA when it is
    # non-zero.
    pub fn take_published(self: @&NetSvc) -> u32
        let n = self.published
        self.published = 0
        n

    # Whether the address page has a generation the kernel has not
    # sampled; clears it (netd calls NetPublish, and marks it due again
    # with publish_failed when that is refused).
    pub fn take_publish_due(self: @&NetSvc) -> bool
        let due = self.publish_due
        self.publish_due = false
        due

    pub fn publish_failed(self: @&NetSvc)
        self.publish_due = true

    pub fn pending_count(self: @&NetSvc) -> i64
        self.pend_count

    # Send one whole Ethernet frame: straight onto the TX ring when it has
    # room and nothing is queued ahead, else onto the pending-TX queue, else
    # it fails.
    pub fn send_frame(self: @&NetSvc, frame: [u8]) -> Sent
        if frame.len == 0 or frame.len as u64 > FRAME_MAX
            self.counters.send_fails += 1
            return Sent.Failed
        if self.pend_count == 0
            match self.tx.publish(frame)
                Publish.Done =>
                    self.published += 1
                    self.counters.tx_frames += 1
                    return Sent.Published
                Publish.Full => pass
                Publish.BadLength =>
                    self.counters.send_fails += 1
                    return Sent.Failed
                Publish.Close(why) =>
                    self.closed = Some(why)
                    self.counters.send_fails += 1
                    return Sent.Failed
        self.enqueue(frame)

    # ------------------------------------------------------------------
    # The send side
    # ------------------------------------------------------------------

    fn enqueue(self: @&NetSvc, frame: [u8]) -> Sent
        if self.pend_count >= PENDING_TX_CAP
            self.counters.send_fails += 1
            return Sent.Failed
        let slot = (self.pend_head + self.pend_count) % PENDING_TX_CAP
        for i in 0..frame.len
            self.pend_frames[slot][i] = frame[i]
        self.pend_lens[slot] = frame.len as u32
        self.pend_count += 1
        self.counters.tx_queued += 1
        Sent.Queued

    # Publish queued frames, oldest first, into every free TX slot.
    fn flush(self: @&NetSvc)
        while self.pend_count > 0
            let slot = self.pend_head
            let len = self.pend_lens[slot] as i64
            # span_from_ptr, not `@self.pend_frames[slot]`: ritz1 stores
            # the element's address where the span belongs.
            let frame: [u8] = span_from_ptr<u8>(@self.pend_frames[slot][0], len)
            match self.tx.publish(frame)
                Publish.Done =>
                    self.published += 1
                    self.counters.tx_frames += 1
                Publish.Full => return
                Publish.BadLength =>
                    self.counters.send_fails += 1
                Publish.Close(why) =>
                    self.closed = Some(why)
                    return
            self.pend_head = (self.pend_head + 1) % PENDING_TX_CAP
            self.pend_count -= 1

    # Send the IPv4 frame of `len` bytes built in `out`, whose destination
    # MAC is not yet written, to next hop `hop`: the broadcast MAC for the
    # limited broadcast, the cached MAC, or a wait for ARP.
    fn send_ip(self: @&NetSvc, hop: u32, len: i64, now: u64) -> Sent
        if hop == IPV4_BROADCAST
            self.set_out_mac(arp_broadcast_mac())
            return self.send_out(len)
        match self.arp.send(hop, now)
            ArpSend.Resolved(mac) =>
                self.set_out_mac(mac)
                self.send_out(len)
            ArpSend.Request =>
                let parked = self.park(hop, len)
                self.send_arp_request(hop)
                parked
            ArpSend.Queued => self.park(hop, len)
            ArpSend.Refused =>
                self.counters.send_fails += 1
                Sent.Failed

    fn set_out_mac(self: @&NetSvc, mac: MacAddr)
        for i in 0..6
            self.out[i] = mac[i]

    fn send_out(self: @&NetSvc, len: i64) -> Sent
        let out: [u8] = @self.out
        self.send_frame(out[0..len])

    # Keep the frame in `out` until ARP resolves `hop`.
    fn park(self: @&NetSvc, hop: u32, len: i64) -> Sent
        for w in 0..ARP_WAIT_CAP
            if not self.waits[w].live
                for i in 0..len
                    self.waits[w].frame[i] = self.out[i]
                self.waits[w].len = len as u32
                self.waits[w].hop = hop
                self.waits[w].live = true
                self.waits[w].app = self.out_app
                self.waits[w].serial = match self.out_app
                    Some(a) => self.apps[a].serial
                    None => 0
                self.waits[w].ping = self.out_ping
                return Sent.Waiting
        self.counters.send_fails += 1
        Sent.Failed

    # ARP resolved `hop` to `mac` at `now`: send every frame waiting on it.
    fn release_waits(self: @&NetSvc, hop: u32, mac: MacAddr, now: u64)
        for w in 0..ARP_WAIT_CAP
            if self.waits[w].live and self.waits[w].hop == hop
                self.waits[w].live = false
                for i in 0..6
                    self.waits[w].frame[i] = mac[i]
                let frame: [u8] = span_from_ptr<u8>(@self.waits[w].frame[0], self.waits[w].len as i64)
                let sent = self.send_frame(frame)
                if self.waits[w].ping
                    match self.ping_of_wait(w)
                        Some(a) => self.ping_sent(a, sent, now)
                        None => pass

    # ARP gave up on `hop`: drop what waits on it.
    fn drop_waits(self: @&NetSvc, hop: u32)
        for w in 0..ARP_WAIT_CAP
            if self.waits[w].live and self.waits[w].hop == hop
                self.waits[w].live = false
                self.counters.arp_drops += 1
                if self.waits[w].ping
                    # The ping's terminal event, not a send_drop.
                    match self.ping_of_wait(w)
                        Some(a) => self.ping_fail(a)
                        None => pass
                    continue
                match self.waits[w].app
                    Some(a) =>
                        if self.apps[a].live and self.apps[a].serial == self.waits[w].serial
                            self.apps[a].counters.send_drops += 1
                    None => pass

    # The attachment whose ping echo wait `w` holds, while that attachment
    # is the one that parked it and its ping still waits for ARP.
    fn ping_of_wait(self: @NetSvc, w: i64) -> Option<i64>
        match self.waits[w].app
            Some(a) =>
                if self.apps[a].live and self.apps[a].serial == self.waits[w].serial and self.apps[a].ping == PingState.Arp
                    return Some(a)
                None
            None => None

    fn our_ip(self: @&NetSvc) -> Option<u32>
        self.dhcp.config().addr

    fn send_arp_request(self: @&NetSvc, target: u32)
        let ours = match self.our_ip()
            Some(a) => a
            None => 0
        let out: [u8] = @self.out
        match arp_request_write(out, self.link, ours, target)
            Ok(len) => self.send_frame(out[0..len])
            Err(_) => pass

    # ------------------------------------------------------------------
    # Receive
    # ------------------------------------------------------------------

    fn rx_pass(self: @&NetSvc, now: u64)
        self.rx_more = false
        var taken: i64 = 0
        while taken < RX_BUDGET
            match self.rx.next(@&self.rx_buf, now, now + 1)
                Take.Frame(len) =>
                    self.counters.rx_frames += 1
                    let buf: [u8] = @self.rx_buf
                    self.on_frame(buf[0..len as i64], now)
                Take.Rejected(_) =>
                    self.counters.rx_rejects += 1
                Take.Empty => return
                Take.Timeout => return
                Take.Close(why) =>
                    self.closed = Some(why)
                    return
            taken += 1
        self.rx_more = true

    fn on_frame(self: @&NetSvc, frame: [u8], now: u64)
        match eth_demux(frame, self.link.mac)
            Err(_) =>
                self.counters.rx_drops += 1
            Ok(eth) =>
                match eth.ethertype
                    EtherType.Arp => self.on_arp(eth.payload, now)
                    EtherType.Ipv4 => self.on_ipv4(eth, now)

    fn on_arp(self: @&NetSvc, payload: [u8], now: u64)
        let rx = match arp_parse(payload)
            Ok(r) => r
            Err(_) =>
                self.counters.rx_drops += 1
                return
        let ours = self.our_ip()
        let our_ip = match ours
            Some(a) => a
            None => 0
        # Unconfigured, no request targets us: 0.0.0.0 is not our address.
        if ours.is_none() and rx.op == ArpOp.Request
            return
        match self.arp.observe(rx, our_ip, now)
            ArpLearn.Resolved(_) => self.release_waits(rx.sender_ip, rx.sender_mac, now)
            _ => pass
        if arp_should_reply(rx, our_ip, ours.is_some())
            let out: [u8] = @self.out
            match arp_reply_write(out, self.link, our_ip, rx.sender_mac, rx.sender_ip)
                Ok(len) => self.send_frame(out[0..len])
                Err(_) => pass

    fn on_ipv4(self: @&NetSvc, eth: EthRx, now: u64)
        let cfg = self.dhcp.config()
        let ip = match ipv4_parse(eth.payload, cfg)
            Ok(p) => p
            Err(_) =>
                self.counters.rx_drops += 1
                return
        match ip.protocol
            IpProto.Udp => self.on_udp(ip, now)
            IpProto.Icmp => self.on_icmp(ip, eth.dst, cfg, now)

    fn on_udp(self: @&NetSvc, ip: Ipv4Rx, now: u64)
        let udp = match udp_parse(ip.body, ip.src, ip.dst)
            Ok(u) => u
            Err(_) =>
                self.counters.rx_drops += 1
                return
        if udp.src_port != DHCP_SERVER_PORT or udp.dst_port != DHCP_CLIENT_PORT
            match self.ports.owner(udp.dst_port)
                Some(o) => self.deliver(o, ip.src, udp.src_port, udp.payload)
                None =>
                    self.counters.udp_unbound += 1
            return
        let r = self.next_rand()
        match self.dhcp.receive(udp.payload, now, r)
            Ok(step) => self.dhcp_apply(step, now)
            Err(_) =>
                self.counters.rx_drops += 1

    fn on_icmp(self: @&NetSvc, ip: Ipv4Rx, eth_dst: MacAddr, cfg: Ipv4Config, now: u64)
        let msg = match icmp_parse(ip.body)
            Ok(m) => m
            Err(_) =>
                self.counters.rx_drops += 1
                return
        let ours = match cfg.addr
            Some(a) => a
            None => return
        if msg.kind == IcmpType.EchoReply
            self.on_echo_reply(ip.src, msg, now)
            return
        if not icmp_should_reply(msg.kind, ip.dst, eth_dst)
            return
        let hop = match icmp_reply_next_hop(cfg, ip.src)
            Ok(h) => h
            Err(_) =>
                self.counters.send_fails += 1
                return
        let out: [u8] = @self.out
        match icmp_echo_reply_frame_write(out, self.link, [0, 0, 0, 0, 0, 0], ours, ip.src, msg.id, msg.seq, msg.body)
            Ok(len) => self.send_ip(hop, len, now)
            Err(_) =>
                self.counters.send_fails += 1

    # An echo reply from `src`: the EV_PING_REPLY of the attachment whose
    # echo it answers, before that echo's deadline; else dropped (no echo
    # of ours, or a late or duplicate reply).
    fn on_echo_reply(self: @&NetSvc, src: u32, msg: IcmpRx, now: u64)
        for a in 0..APP_ATTACH_CAP
            if self.ping_answers(a, src, msg, now)
                var n = msg.body.len
                if n > APP_SLOT as i64
                    n = APP_SLOT as i64
                for i in 0..n
                    self.ping_bufs[a][i] = msg.body[i]
                self.apps[a].ping_len = n as u32
                self.owe_at(a, EV_PING_REPLY, self.apps[a].ping_id, 0, 0, 0, ip_bytes(src))
                self.apps[a].ping = PingState.Replied
                return
        self.counters.rx_drops += 1

    # Whether `msg` from `src` at `now` answers attachment `a`'s echo:
    # that peer, that identifier and PING_SEQ, before the deadline.
    fn ping_answers(self: @NetSvc, a: i64, src: u32, msg: IcmpRx, now: u64) -> bool
        if not self.apps[a].live or self.apps[a].ping != PingState.Echo
            return false
        self.apps[a].ping_dst == src and self.apps[a].ping_ident == msg.id and msg.seq == PING_SEQ and now < self.apps[a].ping_deadline

    # ------------------------------------------------------------------
    # The app exchanges
    # ------------------------------------------------------------------

    # Serve the exchange netd mapped at `region` for its handle `handle`
    # (an ATTACH record). The next pass drains its requests before netd
    # parks. False when APP_ATTACH_CAP attachments are live: netd revokes
    # the handle. A handle already attached is true and changes nothing.
    pub fn attach(self: @&NetSvc, handle: u64, region: u64) -> bool
        if self.app_slot(handle).is_some()
            return true
        for a in 0..APP_ATTACH_CAP
            if not self.apps[a].live and not self.apps[a].revoke
                self.app_serial += 1
                self.apps[a].live = true
                self.apps[a].handle = handle
                self.apps[a].serial = self.app_serial
                self.apps[a].req = AppConsumer.new(app_req_ring(region))
                self.apps[a].ev = AppProducer.new(app_ev_ring(region))
                self.apps[a].owed_head = 0
                self.apps[a].owed_count = 0
                self.apps[a].taken = 0
                self.apps[a].posted = 0
                self.apps[a].counters = AppCounters { requests: 0, rejects: 0, send_drops: 0, ev_drops: 0 }
                self.apps[a].ping = PingState.Idle
                self.ports.attach(a)
                self.app_more = true
                return true
        false

    # The live attachment for `handle`.
    pub fn app_slot(self: @NetSvc, handle: u64) -> Option<i64>
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live and self.apps[a].handle == handle
                return Some(a)
        None

    pub fn app_count(self: @NetSvc) -> i64
        var n: i64 = 0
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live
                n += 1
        n

    # A wait's events for the exchanges: PEER_CLOSE (the app exited or
    # revoked) or DRIVER_GONE on one detaches it, without a slot ack.
    pub fn app_wake(self: @&NetSvc, events: [WaitEvent])
        for i in 0..events.len
            if (events[i].bits & (EVENT_PEER_CLOSE | EVENT_DRIVER_GONE)) != 0
                match self.app_slot(events[i].handle)
                    Some(a) => self.close_app(a)
                    None => pass

    # The wait sources for the live attachments, written to `out` from 0;
    # their count. DATA is a request; SPACE joins while a reply is owed.
    pub fn app_sources(self: @NetSvc, out: [WaitSource]) -> i64
        var n: i64 = 0
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live and n < out.len
                var mask = EVENT_DATA
                if self.apps[a].owed_count > 0
                    mask = EVENT_DATA | EVENT_SPACE
                out[n] = WaitSource { handle: self.apps[a].handle, mask: mask, _pad: 0 }
                n += 1
        n

    # The next notify netd owes an attachment, cleared as it is taken.
    pub fn take_notify(self: @&NetSvc) -> Option<AppNotify>
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live and (self.apps[a].posted > 0 or self.apps[a].taken > 0)
                var bits: u32 = 0
                if self.apps[a].posted > 0
                    bits = bits | EVENT_DATA
                if self.apps[a].taken > 0
                    bits = bits | EVENT_SPACE
                self.apps[a].posted = 0
                self.apps[a].taken = 0
                return Some(AppNotify { handle: self.apps[a].handle, bits: bits })
        None

    # The next handle of an attachment this service closed or detached:
    # netd CapRevokes it, which frees the slot.
    pub fn take_revoke(self: @&NetSvc) -> Option<u64>
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].revoke
                self.apps[a].revoke = false
                return Some(self.apps[a].handle)
        None

    # Stop serving attachment `a`: its ports are free, its owed replies
    # and unread requests are discarded, and netd revokes its handle.
    fn close_app(self: @&NetSvc, a: i64)
        if not self.apps[a].live
            return
        self.apps[a].live = false
        self.apps[a].revoke = true
        self.apps[a].owed_count = 0
        self.apps[a].ping = PingState.Idle
        self.ports.detach(a)

    fn apps_pass(self: @&NetSvc, now: u64)
        self.app_more = false
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live
                self.post_owed(a)
                self.drain(a, now)
                self.post_owed(a)

    # Replies attachment `a` owes or will owe: the FIFO, and the terminal
    # event of a ping still in flight.
    fn owed_load(self: @NetSvc, a: i64) -> i64
        match self.apps[a].ping
            PingState.Arp => self.apps[a].owed_count + 1
            PingState.Echo => self.apps[a].owed_count + 1
            # Replied: the EV_PING_REPLY is already in the FIFO.
            PingState.Replied => self.apps[a].owed_count
            PingState.Idle => self.apps[a].owed_count

    # Take up to APP_DEPTH requests of attachment `a`. Stops while its
    # owed replies fill OWED_CAP: the app is not reading events.
    fn drain(self: @&NetSvc, a: i64, now: u64)
        var n: u64 = 0
        while n < APP_DEPTH
            if not self.apps[a].live or self.owed_load(a) >= OWED_CAP
                return
            # The consumer is copied out and back: one private read_idx.
            var req = self.apps[a].req
            let polled = req.poll()
            let d = match polled
                AppPoll.Ready(desc) => desc
                AppPoll.Empty => return
                AppPoll.Close(_) =>
                    self.close_app(a)
                    return
            let took = req.take(d, @&self.req_buf)
            self.apps[a].req = req
            self.apps[a].taken += 1
            match took
                AppTake.Desc(desc, len) => self.dispatch(a, desc, len, now)
                AppTake.Rejected(_) =>
                    self.apps[a].counters.rejects += 1
                AppTake.Close(_) =>
                    self.close_app(a)
                    return
            n += 1
        self.app_more = true

    # One validated request of attachment `a`, its payload `len` bytes of
    # req_buf.
    fn dispatch(self: @&NetSvc, a: i64, d: AppDesc, len: u32, now: u64)
        self.apps[a].counters.requests += 1
        match app_request(d)
            AppReq.Bind(id, port) =>
                match self.ports.bind(a, port)
                    Ok(b) => self.owe(a, EV_BOUND, id, b.handle, b.port, 0)
                    Err(e) =>
                        let status = match e
                            BindError.Exist => APP_EEXIST
                            BindError.NFile => APP_ENFILE
                        self.owe(a, EV_ERROR, id, 0, 0, status)
            AppReq.Close(id, handle) =>
                # The port is free at once; no datagram is held unposted
                # (delivery posts or drops at RX), so none follows.
                match self.ports.close(a, handle)
                    Some(port) => self.owe(a, EV_CLOSED, id, handle, port, 0)
                    None => self.owe(a, EV_ERROR, id, 0, 0, APP_EBADF)
            AppReq.SendTo =>
                if not self.app_send(a, d, len, now)
                    self.apps[a].counters.send_drops += 1
            AppReq.Ping(id) => self.ping_start(a, id, d, len, now)
            AppReq.NoSys(id) => self.owe(a, EV_ERROR, id, 0, 0, APP_ENOSYS)
            AppReq.Inval(id) => self.owe(a, EV_ERROR, id, 0, 0, APP_EINVAL)
            AppReq.BadF(id) => self.owe(a, EV_ERROR, id, 0, 0, APP_EBADF)
            AppReq.Bad =>
                self.apps[a].counters.rejects += 1

    fn owe(self: @&NetSvc, a: i64, kind: u16, id: u32, handle: u32, port: u16, status: i16)
        self.owe_at(a, kind, id, handle, port, status, [0, 0, 0, 0])

    fn owe_at(self: @&NetSvc, a: i64, kind: u16, id: u32, handle: u32, port: u16, status: i16, addr: [4]u8)
        let slot = (self.apps[a].owed_head + self.apps[a].owed_count) % OWED_CAP
        self.apps[a].owed[slot] = Owed { kind: kind, id: id, handle: handle, port: port, status: status, addr: addr }
        self.apps[a].owed_count += 1

    # Attachment `a`'s APP_PING `id` to d.addr, its echo bytes
    # req_buf[0..len]. A second one while one is not Idle is Inval (the
    # library keeps one reply outstanding); no address or no route is Io,
    # and bytes past the link MTU are Inval.
    fn ping_start(self: @&NetSvc, a: i64, id: u32, d: AppDesc, len: u32, now: u64)
        if self.apps[a].ping != PingState.Idle
            self.owe(a, EV_ERROR, id, 0, 0, APP_EINVAL)
            return
        let cfg = self.dhcp.config()
        let src = match cfg.addr
            Some(s) => s
            None =>
                self.owe(a, EV_ERROR, id, 0, 0, APP_EIO)
                return
        let dst = ip_of(d.addr)
        let hop = match ipv4_next_hop(cfg, dst)
            Ok(h) => h
            Err(_) =>
                self.owe(a, EV_ERROR, id, 0, 0, APP_EIO)
                return
        self.ping_ident += 1
        if self.ping_ident == 0
            self.ping_ident = 1
        let buf: [u8] = @self.req_buf
        let out: [u8] = @self.out
        let n = match icmp_echo_request_frame_write(out, self.link, [0, 0, 0, 0, 0, 0], src, dst, self.ping_ident, PING_SEQ, buf[0..len as i64])
            Ok(n) => n
            Err(_) =>
                self.owe(a, EV_ERROR, id, 0, 0, APP_EINVAL)
                return
        self.apps[a].ping_id = id
        self.apps[a].ping_dst = dst
        self.apps[a].ping_ident = self.ping_ident
        self.apps[a].ping = PingState.Arp
        self.out_app = Some(a)
        self.out_ping = true
        let sent = self.send_ip(hop, n, now)
        self.out_app = None
        self.out_ping = false
        self.ping_sent(a, sent, now)

    # Where attachment `a`'s echo went at `now`: out (the deadline starts,
    # once), waiting for ARP (still Arp), or failed (EV_ERROR Io).
    fn ping_sent(self: @&NetSvc, a: i64, sent: Sent, now: u64)
        match sent
            Sent.Published => self.ping_echo_out(a, now)
            Sent.Queued => self.ping_echo_out(a, now)
            Sent.Waiting => pass
            Sent.Failed => self.ping_fail(a)

    fn ping_echo_out(self: @&NetSvc, a: i64, now: u64)
        self.apps[a].ping = PingState.Echo
        self.apps[a].ping_deadline = now + PING_DEADLINE_MS

    # Attachment `a`'s ping ends in its one EV_ERROR, Errno.Io.
    fn ping_fail(self: @&NetSvc, a: i64)
        self.owe(a, EV_ERROR, self.apps[a].ping_id, 0, 0, APP_EIO)
        self.apps[a].ping = PingState.Idle

    # Every echo whose deadline has passed: EV_ERROR Io.
    fn ping_tick(self: @&NetSvc, now: u64)
        for a in 0..APP_ATTACH_CAP
            if self.apps[a].live and self.apps[a].ping == PingState.Echo and now >= self.apps[a].ping_deadline
                self.ping_fail(a)

    # Post attachment `a`'s owed replies, oldest first, while the event
    # ring has a slot.
    fn post_owed(self: @&NetSvc, a: i64)
        let none: [u8] = @self.req_buf
        while self.apps[a].live and self.apps[a].owed_count > 0
            let o = self.apps[a].owed[self.apps[a].owed_head]
            var body: [u8] = none[0..0]
            if o.kind == EV_PING_REPLY
                # span_from_ptr, not `@self.ping_bufs[a]`: ritz1 stores
                # the element's address where the span belongs.
                body = span_from_ptr<u8>(@self.ping_bufs[a][0], self.apps[a].ping_len as i64)
            var ev = self.apps[a].ev
            let r = ev.publish(o.kind, o.id, o.handle, o.port, o.status, o.addr, body)
            self.apps[a].ev = ev
            match r
                AppPublish.Done =>
                    self.apps[a].posted += 1
                AppPublish.Full => return
                AppPublish.BadLength => pass
                AppPublish.Close(_) =>
                    self.close_app(a)
                    return
            self.apps[a].owed_head = (self.apps[a].owed_head + 1) % OWED_CAP
            self.apps[a].owed_count -= 1
            if o.kind == EV_PING_REPLY
                self.apps[a].ping = PingState.Idle

    # A UDP datagram for `o`'s port from `src`:`src_port`. Posted as
    # EV_DATAGRAM only while one event slot stays free for a reply. `o` is
    # live: AppPorts holds only live attachments' ports.
    fn deliver(self: @&NetSvc, o: AppOwner, src: u32, src_port: u16, payload: [u8])
        let a = o.att
        self.post_owed(a)
        var ev = self.apps[a].ev
        let used = match ev.used()
            Ok(n) => n
            Err(_) =>
                self.close_app(a)
                return
        # post_owed ran first: a reply still owed means the ring is full.
        if used + 1 >= APP_DEPTH
            self.apps[a].counters.ev_drops += 1
            return
        match ev.publish(EV_DATAGRAM, 0, o.handle, src_port, 0, ip_bytes(src), payload)
            AppPublish.Done =>
                self.apps[a].posted += 1
            AppPublish.Full =>
                self.apps[a].counters.ev_drops += 1
            AppPublish.BadLength =>
                self.apps[a].counters.ev_drops += 1
            AppPublish.Close(_) =>
                self.apps[a].ev = ev
                self.close_app(a)
                return
        self.apps[a].ev = ev

    # Wrap attachment `a`'s APP_SEND_TO payload (req_buf[0..len]) in UDP,
    # IPv4 and Ethernet. False when it cannot reach the wire: no live
    # handle, no address, unroutable, over the MTU (udp_frame_write's
    # check: IPv4 + UDP + payload), or no room.
    fn app_send(self: @&NetSvc, a: i64, d: AppDesc, len: u32, now: u64) -> bool
        let port = match self.ports.port_of(a, d.handle)
            Some(p) => p
            None => return false
        let cfg = self.dhcp.config()
        let src = match cfg.addr
            Some(s) => s
            None => return false
        let dst = ip_of(d.addr)
        let hop = match ipv4_next_hop(cfg, dst)
            Ok(h) => h
            Err(_) => return false
        let buf: [u8] = @self.req_buf
        let out: [u8] = @self.out
        let n = match udp_frame_write(out, self.link, [0, 0, 0, 0, 0, 0], src, dst, port, d.port, buf[0..len as i64])
            Ok(n) => n
            Err(_) => return false
        self.out_app = Some(a)
        let sent = self.send_ip(hop, n, now)
        self.out_app = None
        match sent
            Sent.Failed => false
            _ => true

    # ------------------------------------------------------------------
    # DHCP, timers and the address record
    # ------------------------------------------------------------------

    fn dhcp_apply(self: @&NetSvc, step: DhcpStep, now: u64)
        match step.record
            DhcpRecord.Write => self.publish(self.dhcp.lease)
            DhcpRecord.Clear => self.publish(None)
            DhcpRecord.Keep => pass
        match step.send
            Some(kind) => self.dhcp_send(kind, now)
            None => pass

    # Write and send one DHCP message: UDP 68 to 67, broadcast or (a
    # renew) unicast to the selected server through ARP.
    fn dhcp_send(self: @&NetSvc, kind: DhcpSend, now: u64) -> Sent
        let buf: [u8] = @self.dhcp_buf
        let msg = match self.dhcp.payload_write(buf, kind)
            Ok(t) => t
            Err(_) =>
                self.counters.send_fails += 1
                return Sent.Failed
        let hop = match ipv4_next_hop(self.dhcp.config(), msg.dst)
            Ok(h) => h
            Err(_) =>
                self.counters.send_fails += 1
                return Sent.Failed
        let out: [u8] = @self.out
        match udp_frame_write(out, self.link, [0, 0, 0, 0, 0, 0], msg.src, msg.dst, DHCP_CLIENT_PORT, DHCP_SERVER_PORT, buf[0..msg.len])
            Ok(len) => self.send_ip(hop, len, now)
            Err(_) =>
                self.counters.send_fails += 1
                Sent.Failed

    # DHCP retransmits and lease timers, ARP retries and give-ups, then
    # ping deadlines.
    fn tick(self: @&NetSvc, now: u64)
        let r = self.next_rand()
        let step = self.dhcp.tick(now, r)
        self.dhcp_apply(step, now)
        var events: [16]ArpEvent      # ARP_HOP_CAP: one per hop at most
        let n = self.arp.poll(now, @events)
        for i in 0..n
            match events[i]
                ArpEvent.Retry(hop) => self.send_arp_request(hop)
                ArpEvent.GiveUp(hop, _) => self.drop_waits(hop)
        self.ping_tick(now)

    # Writer steps 1-4 of the address page (the T36 seqlock) for `lease`,
    # or the cleared record; NetPublish is netd's.
    fn publish(self: @&NetSvc, lease: Option<DhcpLease>)
        let rec = addr_record(lease)
        self.generation = addr_publish(self.addr_page, @rec)
        self.publish_due = true

    # xorshift32: the DHCP jitter and transaction ids. Not a secret.
    fn next_rand(self: @&NetSvc) -> u32
        var x = self.rand
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        self.rand = x
        x
