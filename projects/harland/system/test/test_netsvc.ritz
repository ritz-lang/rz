# Host tests of the ring-2 network service's loop body (AGAST #4743; app
# exchanges #4748, APP_PING #4749; harland docs/RING2_NET.md "Service
# wait", "Ethernet demux", "Address publication", "Frame seat", "ICMP")
#
# src/netsvc.ritz against a frame region and an address page that are host
# globals. The driver's halves of the rings (the RX producer, the TX
# consumer) are driver_abi.spsc halves in this process, and the clock is a
# number the test advances, in the stack_example style: the required case
# fills both rings at once and still sees a DHCP retransmit fire on a link
# that delivers nothing but foreign frames.

import driver_abi.frame_ring { FRAME_MAX, FRAME_RING_CAP, FRAME_RX_ARENA_OFF, FRAME_REGION_SIZE }
import driver_abi.link { NetInfo, NetAddr, AddrSample, addr_sample }
import driver_abi.spsc { SpscProducer, SpscConsumer, Publish, Take, FrameBytes, spsc_rx_ring, spsc_tx_ring }
import driver_abi.wait { WaitEvent, WaitSource, EVENT_DATA, EVENT_SPACE, EVENT_PEER_CLOSE, EVENT_DRIVER_GONE, EVENT_LINK, EVENT_ATTACH }
import netstack.bytes { be16_get, be16_put, be32_get, be32_put }
import netstack.ethernet { MacAddr, ETH_PAYLOAD_OFF, mac_eq, mac_is_broadcast }
import netstack.ipv4 { IPV4_HEADER_MIN, IPV4_BROADCAST }
import netstack.udp { UDP_HEADER_LEN, udp_frame_write }
import netstack.icmp { icmp_echo_request_write, icmp_echo_reply_write }
import netstack.ipv4 { IpProto, ipv4_frame_write }
import netstack.arp { ARP_RETRY_INTERVAL_MS, ARP_RETRY_LIMIT }
import netstack.dhcp { DHCP_MAGIC, DhcpState }
import system.netsvc { NetSvc, Sent, Wake, PENDING_TX_CAP, WAIT_IDLE_MS, RX_BUDGET, OWED_RETRY_MS, wake_of, addr_record }
import net_abi.app { AppDesc, APP_DEPTH, APP_REQ_DESC_OFF, APP_BIND, APP_SEND_TO, APP_PING, APP_CLOSE, APP_CONNECT, APP_WRITE, EV_DATAGRAM, EV_PING_REPLY, EV_BOUND, EV_CLOSED, EV_ERROR, PING_DEADLINE_MS }
import libnet.ring { AppProducer, AppConsumer, AppPublish, AppPoll, AppTake, AppBytes, app_req_ring, app_ev_ring }

const SERVER_IP: u32 = 0x0A000202      # 10.0.2.2, also the router
const OUR_IP: u32 = 0x0A00020F         # 10.0.2.15
const PEER_IP: u32 = 0x0A000203        # 10.0.2.3, on-link
const NETMASK: u32 = 0xFFFFFF00
const DNS_IP: u32 = 0x0A000203
const FRAME_HANDLE: u64 = 7

# The UDP payload offset in a frame netsvc writes (no IPv4 options).
const UDP_AT: i64 = 14 + 20
const PAYLOAD_AT: i64 = 14 + 20 + 8

var g_region: [FRAME_REGION_SIZE / 8]u64
var g_page: [512]u64
var g_svc: NetSvc
var g_drv_rx: SpscProducer
var g_drv_tx: SpscConsumer
var g_got: FrameBytes
var g_frame: [2048]u8
var g_msg: [576]u8
var g_at: i64 = 0

fn our_mac() -> MacAddr
    [0x52, 0x54, 0x00, 0x12, 0x34, 0x56]

fn server_mac() -> MacAddr
    [0x52, 0x55, 0x0A, 0x00, 0x02, 0x02]

fn peer_mac() -> MacAddr
    [0x52, 0x54, 0x00, 0xAA, 0xBB, 0xCC]

fn link_info(up: u8) -> NetInfo
    NetInfo { mac: [0x52, 0x54, 0x00, 0x12, 0x34, 0x56], link_up: up, device_type: 1, mtu: 1500 }

fn server_link() -> NetInfo
    NetInfo { mac: [0x52, 0x55, 0x0A, 0x00, 0x02, 0x02], link_up: 1, device_type: 1, mtu: 1500 }

fn page() -> u64
    @g_page as u64

# A zeroed region and page and a service over them, plus the driver's ring
# halves. Only the control and descriptor pages need zeroing: no slot is
# read before it is written.
fn fresh() -> @&NetSvc
    for i in 0..FRAME_RX_ARENA_OFF / 8
        g_region[i] = 0
    for i in 0..512
        g_page[i] = 0
    let region: u64 = @g_region as u64
    g_svc.init(region, page(), 0x1234)
    g_drv_rx = SpscProducer.new(spsc_rx_ring(region))
    g_drv_tx = SpscConsumer.new(spsc_tx_ring(region))
    @&g_svc

# ready + link up at `now`: one discover on the TX ring.
fn started(now: u64) -> @&NetSvc
    let svc = fresh()
    svc.ready(link_info(1))
    svc.set_link(link_info(1), now)
    svc

# The driver takes one TX frame into g_got; its length, or 0 for none.
fn drv_take() -> i64
    match g_drv_tx.next(@&g_got, 0, 1)
        Take.Frame(len) => len as i64
        _ => 0

fn drv_take_all() -> i64
    var n: i64 = 0
    while drv_take() > 0
        n += 1
    n

fn got() -> [u8]
    let g: [u8] = @g_got
    g

fn got_mac(at: i64) -> MacAddr
    let g = got()
    [g[at], g[at + 1], g[at + 2], g[at + 3], g[at + 4], g[at + 5]]

# g_got is a UDP 68 -> 67 frame (a DHCP message) of DHCP type `kind`.
fn got_is_dhcp(kind: u8) -> bool
    let g = got()
    if be16_get(g, 12) != 0x0800 or g[14 + 9] != 17
        return false
    if be16_get(g, UDP_AT) != 68 or be16_get(g, UDP_AT + 2) != 67
        return false
    # Option 53 is the first option the client writes.
    g[PAYLOAD_AT + 240] == 53 and g[PAYLOAD_AT + 242] == kind

fn got_ip_dst() -> u32
    be32_get(got(), 14 + 16)

# ---------------------------------------------------------------------------
# Frames from the network, published by the driver on the RX ring
# ---------------------------------------------------------------------------

fn drv_publish(frame: [u8]) -> bool
    match g_drv_rx.publish(frame)
        Publish.Done => true
        _ => false

# A server reply in g_msg: reply_begin, options, reply_end.
fn reply_begin(kind: u8, xid: u32)
    let m: [u8] = @g_msg
    for i in 0..m.len
        m[i] = 0
    m[0] = 2
    m[1] = 1
    m[2] = 6
    be32_put(m, 4, xid)
    be32_put(m, 16, OUR_IP)
    let mac = our_mac()
    for i in 0..6
        m[28 + i] = mac[i]
    be32_put(m, 236, DHCP_MAGIC)
    m[240] = 53
    m[241] = 1
    m[242] = kind
    g_at = 243

fn opt4(code: u8, v: u32)
    let m: [u8] = @g_msg
    m[g_at] = code
    m[g_at + 1] = 4
    be32_put(m, g_at + 2, v)
    g_at += 6

fn reply_end() -> [u8]
    let m: [u8] = @g_msg
    m[g_at] = 255
    m[0..g_at + 1]

# A DHCP server message as a broadcast UDP 67 -> 68 frame on the RX ring.
fn drv_dhcp(kind: u8, lease: u32) -> bool
    reply_begin(kind, g_svc.dhcp.xid)
    opt4(54, SERVER_IP)
    if kind != 6
        opt4(51, lease)
        opt4(1, NETMASK)
        opt4(3, SERVER_IP)
        opt4(6, DNS_IP)
    let payload = reply_end()
    let f: [u8] = @g_frame
    match udp_frame_write(f, server_link(), [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF], SERVER_IP, IPV4_BROADCAST, 67, 68, payload)
        Ok(len) => drv_publish(f[0..len])
        Err(_) => false

# A 28-byte ARP packet from `sender` in an Ethernet frame to `eth_dst`.
fn drv_arp(op: u16, eth_dst: MacAddr, sender_ip: u32, sender_mac: MacAddr, target_ip: u32) -> bool
    let f: [u8] = @g_frame
    for i in 0..6
        f[i] = eth_dst[i]
        f[6 + i] = sender_mac[i]
    be16_put(f, 12, 0x0806)
    let a = f[14..f.len]
    be16_put(a, 0, 1)
    be16_put(a, 2, 0x0800)
    a[4] = 6
    a[5] = 4
    be16_put(a, 6, op)
    for i in 0..6
        a[8 + i] = sender_mac[i]
        a[18 + i] = 0
    be32_put(a, 14, sender_ip)
    be32_put(a, 24, target_ip)
    drv_publish(f[0..14 + 28])

# An echo request from `src` to us, from `src_mac`.
fn drv_ping(src: u32, src_mac: MacAddr) -> bool
    let f: [u8] = @g_frame
    let body: [u8] = "ping"
    let icmp = f[14 + 20..f.len]
    let len = match icmp_echo_request_write(icmp, 0x77, 1, body)
        Ok(n) => n
        Err(_) => return false
    let peer = NetInfo { mac: src_mac, link_up: 1, device_type: 1, mtu: 1500 }
    match ipv4_frame_write(f, peer, our_mac(), IpProto.Icmp, src, OUR_IP, len)
        Ok(n) => drv_publish(f[0..n])
        Err(_) => false

# A frame for some other NIC: the link's noise.
fn drv_foreign(n: i64) -> bool
    let f: [u8] = @g_frame
    for i in 0..64
        f[i] = 0x11
    be16_put(f, 12, 0x0800)
    drv_publish(f[0..n])

# A filler frame the service sends, tagged with `tag` in its last byte.
fn filler(tag: u8) -> [u8]
    let f: [u8] = @g_frame
    for i in 0..60
        f[i] = 0
    f[59] = tag
    f[0..60]

# The service bound: discover, offer -> request, ack. The lease is 3600 s.
fn bound(now: u64) -> @&NetSvc
    let svc = started(now)
    drv_take_all()
    drv_dhcp(2, 3600)
    svc.service(now)
    drv_take_all()
    drv_dhcp(5, 3600)
    svc.service(now)
    drv_take_all()
    svc.take_published()
    svc.take_publish_due()
    svc

fn sample() -> AddrSample
    addr_sample(page())

fn bytes_are(b: [4]u8, ip: u32) -> bool
    b[0] == (ip >> 24) as u8 and b[1] == ((ip >> 16) & 0xFF) as u8 and b[2] == ((ip >> 8) & 0xFF) as u8 and b[3] == (ip & 0xFF) as u8

# ---------------------------------------------------------------------------
# Ready, DHCP and the address record
# ---------------------------------------------------------------------------

[[test]]
fn test_ready_publishes_generation_2_unconfigured() -> i32
    let svc = fresh()
    if svc.ready(link_info(1)) != 2
        return 1
    let s = sample()
    if s.generation != 2 or s.addr.configured != 0 or s.addr.generation != 2
        return 2
    if not bytes_are(s.addr.address, 0) or not bytes_are(s.addr.gateway, 0)
        return 3
    # NetPublish is due once.
    if not svc.take_publish_due() or svc.take_publish_due()
        return 4
    # A refused NetPublish is due again on the next pass.
    svc.publish_failed()
    if not svc.take_publish_due()
        return 6
    # Ready is before DHCP: nothing on the TX ring yet.
    if drv_take() != 0 or svc.take_published() != 0
        return 5
    0

[[test]]
fn test_link_up_broadcasts_one_discover() -> i32
    let svc = started(100)
    if svc.take_published() != 1
        return 1
    if drv_take() == 0 or not got_is_dhcp(1)
        return 2
    if not mac_is_broadcast(got_mac(0)) or not mac_eq(got_mac(6), our_mac())
        return 3
    if got_ip_dst() != IPV4_BROADCAST
        return 4
    # The discover went out, so SPACE is not in the mask; the deadline is
    # the first retransmit, 4 s +-1 s.
    if svc.wait_mask() != EVENT_DATA
        return 5
    let d = svc.deadline(100)
    if d < 3000 or d > 5000
        return 6
    # A second link-up snapshot starts nothing.
    svc.set_link(link_info(1), 200)
    if drv_take() != 0
        return 7
    0

[[test]]
fn test_link_down_before_up_sends_nothing_and_waits_idle() -> i32
    let svc = fresh()
    svc.ready(link_info(0))
    svc.set_link(link_info(0), 0)
    if drv_take() != 0
        return 1
    if svc.deadline(0) != WAIT_IDLE_MS
        return 2
    # The link comes up later: discover.
    svc.set_link(link_info(1), 500)
    if drv_take() == 0 or not got_is_dhcp(1)
        return 3
    0

[[test]]
fn test_offer_and_ack_write_the_lease() -> i32
    let svc = started(0)
    drv_take_all()
    if not drv_dhcp(2, 3600)
        return 1
    if svc.service(10).is_err()
        return 2
    # The offer is answered with a broadcast request.
    if drv_take() == 0 or not got_is_dhcp(3) or got_ip_dst() != IPV4_BROADCAST
        return 3
    if svc.take_publish_due() and sample().generation != 2
        return 4
    drv_dhcp(5, 3600)
    svc.service(20)
    if svc.dhcp.state != DhcpState.Bound
        return 5
    let s = sample()
    if s.generation != 4 or s.addr.configured != 1
        return 6
    if not bytes_are(s.addr.address, OUR_IP) or not bytes_are(s.addr.gateway, SERVER_IP)
        return 7
    if not bytes_are(s.addr.netmask, NETMASK) or not bytes_are(s.addr.dns, DNS_IP)
        return 8
    if not svc.take_publish_due()
        return 9
    # Bound: the next timer is T1, half the lease from the request (10 ms),
    # past the idle cap, so the wait is the cap.
    match svc.dhcp.next_deadline()
        Some(d) =>
            if d != 10 + 1800000
                return 10
        None => return 11
    if svc.deadline(20) != WAIT_IDLE_MS
        return 12
    0

[[test]]
fn test_link_down_publishes_a_cleared_record() -> i32
    let svc = bound(0)
    svc.set_link(link_info(0), 50)
    let s = sample()
    if s.generation != 6 or s.addr.configured != 0 or not bytes_are(s.addr.address, 0)
        return 1
    if not svc.take_publish_due()
        return 2
    if svc.dhcp.state != DhcpState.Idle
        return 3
    0

[[test]]
fn test_addr_record_carries_only_what_the_lease_has() -> i32
    let cleared = addr_record(None)
    if cleared.configured != 0 or not bytes_are(cleared.address, 0)
        return 1
    0

# ---------------------------------------------------------------------------
# The pending-TX queue and SPACE
# ---------------------------------------------------------------------------

[[test]]
fn test_full_tx_ring_queues_32_then_fails_the_send() -> i32
    let svc = fresh()
    svc.ready(link_info(1))
    for i in 0..FRAME_RING_CAP
        if svc.send_frame(filler(0)) != Sent.Published
            return 1
    if svc.wait_mask() != EVENT_DATA
        return 2
    for i in 0..PENDING_TX_CAP
        if svc.send_frame(filler((i + 1) as u8)) != Sent.Queued
            return 3
    if svc.pending_count() != PENDING_TX_CAP
        return 4
    # The queue is full: the send fails to its caller.
    if svc.send_frame(filler(0xEE)) != Sent.Failed
        return 5
    if svc.counters.send_fails != 1
        return 6
    # SPACE is listed while the queue is non-empty.
    if svc.wait_mask() != (EVENT_DATA | EVENT_SPACE)
        return 7
    0

[[test]]
fn test_space_alone_moves_the_queue_in_order() -> i32
    let svc = fresh()
    svc.ready(link_info(1))
    for i in 0..FRAME_RING_CAP
        svc.send_frame(filler(0))
    svc.send_frame(filler(1))
    svc.send_frame(filler(2))
    svc.take_published()
    # The driver frees one slot (its SPACE notify); no RX frame arrives.
    drv_take()
    let rx_before = svc.counters.rx_frames
    svc.service(0)
    if svc.pending_count() != 1 or svc.take_published() != 1
        return 1
    if svc.counters.rx_frames != rx_before
        return 2
    # A send behind a non-empty queue stays behind it, even with a free slot.
    drv_take()
    if svc.send_frame(filler(3)) != Sent.Queued
        return 3
    # Drain the 254 fillers still ahead, then the queued ones in order.
    for i in 0..FRAME_RING_CAP - 2
        drv_take()
    svc.service(0)
    if svc.pending_count() != 0 or svc.wait_mask() != EVENT_DATA
        return 4
    for tag in 1..4
        if drv_take() != 60 or got()[59] != tag as u8
            return 5
    0

# The required case (RING2_NET.md "Ethernet demux"): both rings full at
# once, on a link that delivers only foreign frames, and the DHCP
# retransmit still fires and its frame still reaches the TX ring.
[[test]]
fn test_both_rings_full_still_fire_the_dhcp_retransmit() -> i32
    let svc = started(0)
    let first_deadline = svc.dhcp.next_deadline().unwrap_or(0)
    if first_deadline == 0 or svc.deadline(0) != first_deadline
        return 12
    # The driver stops taking TX: fill the rest of the ring and some queue.
    for i in 0..FRAME_RING_CAP - 1
        svc.send_frame(filler(0))
    svc.send_frame(filler(9))
    if svc.pending_count() != 1
        return 1
    # ...and keeps the RX ring full.
    for i in 0..FRAME_RING_CAP
        if not drv_foreign(60)
            return 2
    if drv_foreign(60)
        return 3
    let xid_before = svc.dhcp.xid
    # A pass before the deadline drains RX and sends nothing new.
    svc.service(first_deadline - 1)
    if svc.counters.rx_frames != FRAME_RING_CAP or svc.pending_count() != 1
        return 4
    # The ring is full again when the timer is due.
    for i in 0..FRAME_RING_CAP
        drv_foreign(60)
    if svc.service(first_deadline).is_err()
        return 5
    # The retransmit fired: a second discover, queued behind the filler,
    # and the next retransmit is armed past now.
    if svc.pending_count() != 2 or svc.dhcp.xid != xid_before
        return 6
    match svc.dhcp.next_deadline()
        Some(d) =>
            if d <= first_deadline
                return 7
        None => return 7
    if svc.wait_mask() != (EVENT_DATA | EVENT_SPACE)
        return 8
    # SPACE with no RX frame: the queued frames leave, the discover last.
    let rx_before = svc.counters.rx_frames
    drv_take_all()
    svc.service(first_deadline + 1)
    if svc.counters.rx_frames != rx_before or svc.pending_count() != 0
        return 9
    if drv_take() != 60 or got()[59] != 9
        return 10
    if drv_take() == 0 or not got_is_dhcp(1)
        return 11
    0

[[test]]
fn test_rx_pass_stops_at_the_budget_and_does_not_park() -> i32
    let svc = started(0)
    drv_take_all()
    for i in 0..FRAME_RING_CAP
        drv_foreign(60)
    svc.service(1)
    # Exactly one ring's worth taken: the pass cannot know the ring is
    # empty, so the next wait checks once.
    if svc.counters.rx_frames != RX_BUDGET as u64 or svc.deadline(1) != 0
        return 1
    svc.service(2)
    if svc.deadline(2) == 0
        return 2
    0

# ---------------------------------------------------------------------------
# ARP and ICMP through the loop
# ---------------------------------------------------------------------------

[[test]]
fn test_arp_request_for_us_is_answered_once_configured() -> i32
    let svc = started(0)
    drv_take_all()
    # Unconfigured: not answered.
    drv_arp(1, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF], PEER_IP, peer_mac(), OUR_IP)
    svc.service(1)
    if drv_take() != 0
        return 1
    let b = bound(0)
    drv_arp(1, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF], PEER_IP, peer_mac(), OUR_IP)
    b.service(10)
    if drv_take() != 42 or be16_get(got(), 12) != 0x0806
        return 2
    if not mac_eq(got_mac(0), peer_mac()) or be16_get(got(), 14 + 6) != 2
        return 3
    0

[[test]]
fn test_echo_request_is_answered_through_a_cached_hop() -> i32
    let svc = bound(0)
    # The peer ARPs us first, so it is cached.
    drv_arp(1, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF], PEER_IP, peer_mac(), OUR_IP)
    svc.service(10)
    drv_take_all()
    drv_ping(PEER_IP, peer_mac())
    svc.service(20)
    if drv_take() == 0 or be16_get(got(), 12) != 0x0800 or got()[14 + 9] != 1
        return 1
    if not mac_eq(got_mac(0), peer_mac()) or got_ip_dst() != PEER_IP
        return 2
    # Type 0, echo reply.
    if got()[14 + 20] != 0
        return 3
    0

[[test]]
fn test_echo_reply_waits_for_arp_and_leaves_on_the_reply() -> i32
    let svc = bound(0)
    # An uncached requester: the reply waits and a broadcast request goes.
    drv_ping(PEER_IP, peer_mac())
    svc.service(10)
    if drv_take() != 42 or not mac_is_broadcast(got_mac(0)) or be16_get(got(), 14 + 6) != 1
        return 1
    if drv_take() != 0
        return 2
    # The ARP reply resolves the hop and releases the echo reply.
    drv_arp(2, our_mac(), PEER_IP, peer_mac(), OUR_IP)
    svc.service(20)
    if drv_take() == 0 or got()[14 + 20] != 0 or not mac_eq(got_mac(0), peer_mac())
        return 3
    0

[[test]]
fn test_arp_give_up_drops_the_waiting_frame() -> i32
    let svc = bound(0)
    drv_ping(PEER_IP, peer_mac())
    svc.service(10)
    drv_take_all()
    # The ARP timer is the nearest deadline.
    if svc.deadline(10) != ARP_RETRY_INTERVAL_MS
        return 1
    var now: u64 = 10
    for i in 0..ARP_RETRY_LIMIT
        now += ARP_RETRY_INTERVAL_MS
        svc.service(now)
        if drv_take() != 42
            return 2
    now += ARP_RETRY_INTERVAL_MS
    svc.service(now)
    if drv_take() != 0 or svc.counters.arp_drops != 1
        return 3
    0

[[test]]
fn test_foreign_and_unbound_frames_are_dropped() -> i32
    let svc = bound(0)
    drv_foreign(60)
    let f: [u8] = @g_frame
    let body: [u8] = "x"
    match udp_frame_write(f, server_link(), our_mac(), SERVER_IP, OUR_IP, 4000, 5000, body)
        Ok(len) => drv_publish(f[0..len])
        Err(_) => return 1
    svc.service(10)
    if svc.counters.rx_drops != 1 or svc.counters.udp_unbound != 1
        return 2
    if drv_take() != 0
        return 3
    0

# ---------------------------------------------------------------------------
# Wakes
# ---------------------------------------------------------------------------

[[test]]
fn test_wake_of_sorts_the_frame_object_events() -> i32
    var evs: [3]WaitEvent
    evs[0] = WaitEvent { handle: FRAME_HANDLE, bits: EVENT_DATA | EVENT_SPACE, _pad: 0 }
    evs[1] = WaitEvent { handle: 99, bits: EVENT_ATTACH | EVENT_DRIVER_GONE, _pad: 0 }
    evs[2] = WaitEvent { handle: FRAME_HANDLE, bits: EVENT_LINK, _pad: 0 }
    let w = wake_of(@evs, FRAME_HANDLE)
    if w.gone or not w.link
        return 1
    evs[2] = WaitEvent { handle: FRAME_HANDLE, bits: EVENT_DRIVER_GONE, _pad: 0 }
    if not wake_of(@evs, FRAME_HANDLE).gone
        return 2
    evs[2] = WaitEvent { handle: FRAME_HANDLE, bits: EVENT_PEER_CLOSE, _pad: 0 }
    let pc = wake_of(@evs, FRAME_HANDLE)
    if not pc.gone or pc.link
        return 3
    # Another handle's bits are not the frame object's.
    let all: [WaitEvent] = @evs
    let none = wake_of(all[1..2], FRAME_HANDLE)
    if none.gone or none.link
        return 4
    0

# ---------------------------------------------------------------------------
# App exchanges (AGAST #4748)
# ---------------------------------------------------------------------------

const APP_H: u64 = 21
const APP_H2: u64 = 22

var g_app: [0x23000 / 8]u64
var g_app2: [0x23000 / 8]u64
var g_req: AppProducer                 # the app's halves of g_app
var g_ev: AppConsumer
var g_evbuf: AppBytes
var g_evd: AppDesc

fn zero_app(r: u64)
    let words = r as *[0x600]u64           # the controls and both descriptor pages
    for i in 0..0x600
        (*words)[i] = 0

# A fresh exchange at g_app, the app's halves over it, and the service
# attached to it as APP_H.
fn app_attach(svc: @&NetSvc) -> u64
    let r: u64 = @g_app as u64
    zero_app(r)
    g_req = AppProducer.new(app_req_ring(r))
    g_ev = AppConsumer.new(app_ev_ring(r))
    if not svc.attach(APP_H, r)
        return 0
    r

fn no_addr() -> [4]u8
    [0, 0, 0, 0]

fn app_req(kind: u16, id: u32, handle: u32, port: u16, addr: [4]u8, payload: [u8]) -> bool
    match g_req.publish(kind, id, handle, port, 0, addr, payload)
        AppPublish.Done => true
        _ => false

fn app_bind(id: u32, port: u16) -> bool
    let none: [u8] = @g_evbuf
    app_req(APP_BIND, id, 0, port, no_addr(), none[0..0])

fn app_close(id: u32, handle: u32) -> bool
    let none: [u8] = @g_evbuf
    app_req(APP_CLOSE, id, handle, 0, no_addr(), none[0..0])

# The app takes one event into g_evd (payload in g_evbuf); false for none.
fn app_event() -> bool
    let d = match g_ev.poll()
        AppPoll.Ready(d) => d
        _ => return false
    match g_ev.take(d, @&g_evbuf)
        AppTake.Desc(desc, _) =>
            g_evd = desc
            true
        _ => false

fn ev_is(kind: u16, id: u32, status: i16) -> bool
    g_evd.kind == kind and g_evd.id == id and g_evd.status == status

# A UDP datagram from PEER_IP:`src_port` to us at `dst_port` on the RX ring.
fn drv_udp(src_port: u16, dst_port: u16, body: [u8]) -> bool
    let f: [u8] = @g_frame
    let peer = NetInfo { mac: peer_mac(), link_up: 1, device_type: 1, mtu: 1500 }
    match udp_frame_write(f, peer, our_mac(), PEER_IP, OUR_IP, src_port, dst_port, body)
        Ok(len) => drv_publish(f[0..len])
        Err(_) => false

[[test]]
fn test_attach_drains_a_request_published_before_it() -> i32
    let svc = bound(0)
    # The app binds before the service has seen the ATTACH record.
    let r: u64 = @g_app as u64
    zero_app(r)
    g_req = AppProducer.new(app_req_ring(r))
    g_ev = AppConsumer.new(app_ev_ring(r))
    if not app_bind(1, 5000)
        return 1
    if not svc.attach(APP_H, r)
        return 2
    # Attach alone asks for a pass before the park.
    if svc.deadline(0) != 0
        return 3
    svc.service(1)
    if not app_event() or not ev_is(EV_BOUND, 1, 0) or g_evd.handle != 1 or g_evd.port != 5000
        return 4
    # One notify: DATA for the event, SPACE for the consumed request.
    match svc.take_notify()
        Some(n) =>
            if n.handle != APP_H or n.bits != (EVENT_DATA | EVENT_SPACE)
                return 5
        None => return 6
    if svc.take_notify().is_some()
        return 7
    # The wait lists the exchange with DATA.
    var srcs: [5]WaitSource
    if svc.app_sources(@srcs) != 1 or srcs[0].handle != APP_H or srcs[0].mask != EVENT_DATA
        return 8
    0

[[test]]
fn test_second_bind_is_exist_and_allocates_no_handle() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_bind(1, 5000)
    app_bind(2, 5000)
    app_bind(3, 67)
    app_bind(4, 5001)
    svc.service(1)
    if not app_event() or not ev_is(EV_BOUND, 1, 0) or g_evd.handle != 1
        return 1
    if not app_event() or not ev_is(EV_ERROR, 2, -17) or g_evd.handle != 0
        return 2
    if not app_event() or not ev_is(EV_ERROR, 3, -17)
        return 3
    if not app_event() or not ev_is(EV_BOUND, 4, 0) or g_evd.handle != 2
        return 4
    0

[[test]]
fn test_repeated_close_and_rebind() -> i32
    let svc = bound(0)
    app_attach(svc)
    var id: u32 = 1
    for round in 0..3
        app_bind(id, 5000)
        svc.service(1)
        if not app_event() or not ev_is(EV_BOUND, id, 0) or g_evd.handle != round as u32 + 1
            return 1
        let h = g_evd.handle
        app_close(id + 1, h)
        app_close(id + 2, h)
        svc.service(1)
        if not app_event() or not ev_is(EV_CLOSED, id + 1, 0) or g_evd.handle != h
            return 2
        # The second close of the same handle is BadF.
        if not app_event() or not ev_is(EV_ERROR, id + 2, -9)
            return 3
        id += 3
    # A closed port takes no datagram.
    drv_udp(4000, 5000, "x")
    svc.service(2)
    if app_event() or svc.counters.udp_unbound != 1
        return 4
    0

[[test]]
fn test_datagram_is_delivered_with_its_peer() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(1)
    app_event()
    svc.take_notify()
    drv_udp(4000, 5000, "hello")
    svc.service(2)
    if not app_event() or not ev_is(EV_DATAGRAM, 0, 0) or g_evd.handle != 1 or g_evd.port != 4000 or g_evd.length != 5
        return 1
    if not bytes_are(g_evd.addr, PEER_IP) or g_evbuf[0] != 'h' as u8 or g_evbuf[4] != 'o' as u8
        return 2
    match svc.take_notify()
        Some(n) =>
            if n.bits != EVENT_DATA
                return 3
        None => return 4
    0

[[test]]
fn test_full_event_ring_still_fits_a_reply() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(1)
    app_event()
    # The app stops reading: 32 datagrams, 31 posted, the last dropped.
    for i in 0..APP_DEPTH
        drv_udp(4000, 5000, "d")
    svc.service(2)
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.apps[a].counters.ev_drops != 1
        return 1
    # The reply still fits, in the last slot.
    app_close(2, 1)
    svc.service(3)
    for i in 0..APP_DEPTH - 1
        if not app_event() or g_evd.kind != EV_DATAGRAM
            return 2
    if not app_event() or not ev_is(EV_CLOSED, 2, 0)
        return 3
    if app_event()
        return 4
    0

[[test]]
fn test_owed_reply_waits_for_an_event_slot() -> i32
    let svc = bound(0)
    app_attach(svc)
    # 65 binds with no event read: 32 replies fill the event ring, 32 are
    # owed, and the 65th stays on the request ring: owed replies cap the
    # drain.
    for i in 0..2 * APP_DEPTH + 1
        if i > 0 and i % APP_DEPTH == 0
            svc.service(1)
        if not app_bind(i as u32 + 1, (6000 + i) as u16)
            return 1
    svc.service(1)
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.apps[a].owed_count != OWED_CAP or svc.apps[a].counters.requests != 2 * APP_DEPTH
        return 2
    # The owed replies keep SPACE in the mask and the wait short.
    var srcs: [5]WaitSource
    svc.app_sources(@srcs)
    if srcs[0].mask != (EVENT_DATA | EVENT_SPACE) or svc.deadline(1) != OWED_RETRY_MS
        return 3
    # Reading the ring posts the owed replies in order, then the 65th.
    var want: u32 = 1
    for round in 0..3
        while app_event()
            if g_evd.id != want
                return 4
            want += 1
        svc.service(2)
    if want != 2 * APP_DEPTH as u32 + 2 or svc.apps[a].owed_count != 0
        return 5
    0

[[test]]
fn test_bad_appdesc_is_skipped() -> i32
    let svc = bound(0)
    let r = app_attach(svc)
    # Slot 0 is bad (flags), slot 1 is a good bind.
    let none: [u8] = @g_evbuf
    match g_req.stage(APP_BIND, 1, 0, 5000, 0, no_addr(), none[0..0])
        AppPublish.Done => pass
        _ => return 1
    let descs = (r + APP_REQ_DESC_OFF) as *[32]AppDesc
    (*descs)[0].flags = 1
    g_req.commit()
    app_bind(2, 5001)
    svc.service(1)
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.apps[a].counters.rejects != 1
        return 2
    if not app_event() or not ev_is(EV_BOUND, 2, 0) or g_evd.port != 5001
        return 3
    if app_event()
        return 4
    0

[[test]]
fn test_overfull_request_ring_closes_that_attachment_only() -> i32
    let svc = bound(0)
    app_attach(svc)
    let r2: u64 = @g_app2 as u64
    zero_app(r2)
    if not svc.attach(APP_H2, r2)
        return 1
    # APP_H's app stores an impossible write_idx.
    let ctrl = (@g_app as u64) as *u64
    atomic_store(ctrl, APP_DEPTH + 1)
    svc.service(1)
    if svc.app_slot(APP_H).is_some() or svc.app_count() != 1
        return 2
    match svc.take_revoke()
        Some(h) =>
            if h != APP_H
                return 3
        None => return 4
    if svc.take_revoke().is_some()
        return 5
    # The other attachment still serves.
    g_req = AppProducer.new(app_req_ring(r2))
    g_ev = AppConsumer.new(app_ev_ring(r2))
    app_bind(1, 5000)
    svc.service(2)
    if not app_event() or not ev_is(EV_BOUND, 1, 0)
        return 6
    0

[[test]]
fn test_peer_close_detaches_and_frees_its_ports() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(1)
    var evs: [1]WaitEvent
    evs[0] = WaitEvent { handle: APP_H, bits: EVENT_PEER_CLOSE, _pad: 0 }
    svc.app_wake(@evs)
    if svc.app_slot(APP_H).is_some()
        return 1
    match svc.take_revoke()
        Some(h) =>
            if h != APP_H
                return 2
        None => return 3
    # A new attachment can bind the port, and its handles start at 1.
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(2)
    if not app_event() or not ev_is(EV_BOUND, 1, 0) or g_evd.handle != 1
        return 4
    0

[[test]]
fn test_sixth_attachment_is_refused() -> i32
    let svc = bound(0)
    let r: u64 = @g_app as u64
    zero_app(r)
    for i in 0..5
        if not svc.attach(30 + i as u64, r)
            return 1
    if svc.attach(40, r)
        return 2
    0

[[test]]
fn test_reserved_kinds_answer_nosys() -> i32
    let svc = bound(0)
    app_attach(svc)
    let none: [u8] = @g_evbuf
    app_req(APP_CONNECT, 1, 0, 80, no_addr(), none[0..0])
    app_req(APP_WRITE, 2, 0, 0, no_addr(), none[0..0])
    svc.service(1)
    if not app_event() or not ev_is(EV_ERROR, 1, -38)
        return 1
    if not app_event() or not ev_is(EV_ERROR, 2, -38)
        return 2
    0

[[test]]
fn test_send_to_wraps_udp_ipv4_ethernet() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(1)
    app_event()
    let body: [u8] = "abc"
    let peer: [4]u8 = [10, 0, 2, 3]
    if not app_req(APP_SEND_TO, 0, 1, 7000, peer, body)
        return 1
    svc.service(2)
    # The peer is not cached: one ARP request, the datagram waits.
    if drv_take() != 14 + 28 or drv_take() != 0
        return 2
    drv_arp(2, our_mac(), PEER_IP, peer_mac(), OUR_IP)
    svc.service(3)
    let n = drv_take()
    if n != PAYLOAD_AT + 3
        return 3
    if not mac_eq(got_mac(0), peer_mac()) or got_ip_dst() != PEER_IP
        return 4
    let g = got()
    if be16_get(g, UDP_AT) != 5000 or be16_get(g, UDP_AT + 2) != 7000 or g[PAYLOAD_AT] != 'a' as u8 or g[PAYLOAD_AT + 2] != 'c' as u8
        return 5
    # No event for a send.
    if app_event()
        return 6
    0

[[test]]
fn test_send_to_failures_count_in_send_drops_with_no_event() -> i32
    let svc = bound(0)
    app_attach(svc)
    let body: [u8] = "abc"
    let peer: [4]u8 = [10, 0, 2, 3]
    # Handle 1 is not bound yet.
    app_req(APP_SEND_TO, 0, 1, 7000, peer, body)
    svc.service(1)
    app_bind(1, 5000)
    svc.service(2)
    app_event()
    # Over the MTU (1500 - 28).
    let big: [u8] = @g_frame
    app_req(APP_SEND_TO, 0, 1, 7000, peer, big[0..1473])
    svc.service(3)
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.apps[a].counters.send_drops != 2 or app_event() or drv_take() != 0
        return 1
    # ARP gives up on an unanswered hop: the waiting datagram is a drop.
    app_req(APP_SEND_TO, 0, 1, 7000, peer, body)
    svc.service(4)
    drv_take_all()
    var t: u64 = 4
    for i in 0..ARP_RETRY_LIMIT + 2
        t += ARP_RETRY_INTERVAL_MS
        svc.service(t)
    if svc.apps[a].counters.send_drops != 3 or app_event()
        return 2
    0

# ---------------------------------------------------------------------------
# APP_PING (AGAST #4749): one echo in flight, PING_DEADLINE_MS from the
# echo's publish, exactly one terminal event
# ---------------------------------------------------------------------------

fn peer_addr() -> [4]u8
    [10, 0, 2, 3]

fn app_ping(id: u32, body: [u8]) -> bool
    app_req(APP_PING, id, 0, 0, peer_addr(), body)

# The peer ARPs us, so its MAC is cached; our ARP reply is taken.
fn cache_peer(svc: @&NetSvc, now: u64)
    drv_arp(1, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF], PEER_IP, peer_mac(), OUR_IP)
    svc.service(now)
    drv_take_all()

# g_got is an echo request to the peer's MAC and address.
fn got_is_echo_request() -> bool
    let g = got()
    be16_get(g, 12) == 0x0800 and g[14 + 9] == 1 and g[14 + 20] == 8 and mac_eq(got_mac(0), peer_mac()) and got_ip_dst() == PEER_IP

fn got_echo_id() -> u16
    be16_get(got(), 14 + 20 + 4)

fn got_echo_seq() -> u16
    be16_get(got(), 14 + 20 + 6)

# An echo reply from `src` (through the peer's MAC) on the RX ring.
fn drv_echo_reply(src: u32, id: u16, seq: u16, body: [u8]) -> bool
    let f: [u8] = @g_frame
    let icmp = f[14 + 20..f.len]
    let len = match icmp_echo_reply_write(icmp, id, seq, body)
        Ok(n) => n
        Err(_) => return false
    let peer = NetInfo { mac: peer_mac(), link_up: 1, device_type: 1, mtu: 1500 }
    match ipv4_frame_write(f, peer, our_mac(), IpProto.Icmp, src, OUR_IP, len)
        Ok(n) => drv_publish(f[0..n])
        Err(_) => false

[[test]]
fn test_ping_to_a_quiet_peer_is_one_eio_and_a_send_to_passes_it() -> i32
    let svc = bound(0)
    cache_peer(svc, 10)
    app_attach(svc)
    app_bind(1, 5000)
    svc.service(20)
    app_event()
    # A ping, and a datagram behind it.
    app_ping(2, "abc")
    app_req(APP_SEND_TO, 0, 1, 7000, peer_addr(), "xyz")
    svc.service(100)
    if drv_take() == 0 or not got_is_echo_request()
        return 1
    let id = got_echo_id()
    let seq = got_echo_seq()
    # The send_to reached TX while the echo is in flight.
    if drv_take() != PAYLOAD_AT + 3 or got()[PAYLOAD_AT] != 'x' as u8 or drv_take() != 0
        return 2
    if app_event()
        return 3
    # The deadline is the wait's.
    if svc.deadline(100) != PING_DEADLINE_MS
        return 4
    svc.service(100 + PING_DEADLINE_MS - 1)
    if app_event()
        return 5
    # A reply taken in the pass that reaches the deadline is too late.
    drv_echo_reply(PEER_IP, id, seq, "abc")
    svc.service(100 + PING_DEADLINE_MS)
    if not app_event() or not ev_is(EV_ERROR, 2, -5) or app_event()
        return 6
    # No second echo, and a late reply is dropped.
    if drv_take() != 0
        return 7
    drv_echo_reply(PEER_IP, id, seq, "abc")
    svc.service(1200)
    svc.service(5000)
    if app_event() or drv_take() != 0
        return 8
    0

[[test]]
fn test_ping_reply_is_one_ev_ping_reply() -> i32
    let svc = bound(0)
    cache_peer(svc, 10)
    app_attach(svc)
    app_ping(3, "abc")
    svc.service(100)
    if drv_take() == 0 or not got_is_echo_request()
        return 1
    let id = got_echo_id()
    let seq = got_echo_seq()
    # Another id, or another source, is not this echo's reply.
    drv_echo_reply(PEER_IP, id + 1, seq, "abc")
    drv_echo_reply(SERVER_IP, id, seq, "abc")
    svc.service(300)
    if app_event()
        return 2
    drv_echo_reply(PEER_IP, id, seq, "abc")
    svc.service(600)
    if not app_event() or not ev_is(EV_PING_REPLY, 3, 0) or g_evd.length != 3
        return 3
    if not bytes_are(g_evd.addr, PEER_IP) or g_evbuf[0] != 'a' as u8 or g_evbuf[2] != 'c' as u8
        return 4
    # A duplicate reply and the deadline post nothing more.
    drv_echo_reply(PEER_IP, id, seq, "abc")
    svc.service(700)
    svc.service(100 + PING_DEADLINE_MS)
    svc.service(5000)
    if app_event()
        return 5
    0

[[test]]
fn test_ping_deadline_starts_when_the_echo_is_published() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_ping(4, "abc")
    svc.service(0)
    # The peer is not cached: an ARP request and no echo.
    if drv_take() != 14 + 28 or drv_take() != 0
        return 1
    # ARP resolves at 900: the echo goes, and its deadline starts then.
    drv_arp(2, our_mac(), PEER_IP, peer_mac(), OUR_IP)
    svc.service(900)
    if drv_take() == 0 or not got_is_echo_request() or drv_take() != 0
        return 2
    if svc.deadline(900) != PING_DEADLINE_MS
        return 3
    svc.service(900 + PING_DEADLINE_MS - 1)
    if app_event()
        return 4
    svc.service(900 + PING_DEADLINE_MS)
    if not app_event() or not ev_is(EV_ERROR, 4, -5) or app_event()
        return 5
    0

[[test]]
fn test_ping_arp_give_up_is_one_eio_and_no_echo() -> i32
    let svc = bound(0)
    app_attach(svc)
    app_ping(5, "abc")
    svc.service(0)
    var now: u64 = 0
    for i in 0..ARP_RETRY_LIMIT + 1
        # Only ARP requests go out; no event while ARP retries.
        while drv_take() > 0
            if be16_get(got(), 12) != 0x0806
                return 1
        if app_event()
            return 2
        now += ARP_RETRY_INTERVAL_MS
        svc.service(now)
    if drv_take() != 0
        return 3
    if not app_event() or not ev_is(EV_ERROR, 5, -5) or app_event()
        return 4
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.counters.arp_drops != 1 or svc.apps[a].counters.send_drops != 0
        return 5
    # ARP answering late sends no echo and posts nothing.
    drv_arp(2, our_mac(), PEER_IP, peer_mac(), OUR_IP)
    svc.service(now + 10)
    if drv_take() != 0 or app_event()
        return 6
    0

[[test]]
fn test_second_ping_in_flight_is_inval() -> i32
    let svc = bound(0)
    cache_peer(svc, 10)
    app_attach(svc)
    app_ping(1, "a")
    app_ping(2, "b")
    svc.service(100)
    # One echo; the second ping is answered at once.
    if drv_take() == 0 or not got_is_echo_request() or drv_take() != 0
        return 1
    if not app_event() or not ev_is(EV_ERROR, 2, -22) or app_event()
        return 2
    svc.service(100 + PING_DEADLINE_MS)
    if not app_event() or not ev_is(EV_ERROR, 1, -5) or app_event()
        return 3
    # Then the next ping is served.
    app_ping(3, "c")
    svc.service(2000)
    if drv_take() == 0 or not got_is_echo_request()
        return 4
    0

[[test]]
fn test_ping_with_no_address_is_eio_at_once() -> i32
    let svc = started(0)
    drv_take_all()
    app_attach(svc)
    app_ping(1, "a")
    svc.service(10)
    if not app_event() or not ev_is(EV_ERROR, 1, -5) or app_event()
        return 1
    if drv_take() != 0
        return 2
    0

[[test]]
fn test_in_flight_ping_keeps_an_owed_slot() -> i32
    let svc = bound(0)
    cache_peer(svc, 10)
    app_attach(svc)
    app_ping(1, "a")
    svc.service(100)
    drv_take_all()
    # Binds with no event read: 32 replies fill the event ring and 31 are
    # owed, since the ping's terminal event keeps the last owed slot; the
    # rest wait on the request ring.
    var next_id: u32 = 2
    for round in 0..4
        while app_bind(next_id, (6000 + next_id) as u16)
            next_id += 1
        svc.service(200 + round as u64)
    let a = svc.app_slot(APP_H).unwrap_or(0)
    if svc.apps[a].owed_count != OWED_CAP - 1
        return 1
    svc.service(100 + PING_DEADLINE_MS)
    if svc.apps[a].owed_count != OWED_CAP
        return 2
    # In order: the binds, the ping's EIO, then the binds that waited.
    let eio_at: u32 = 2 + APP_DEPTH as u32 + OWED_CAP as u32 - 1
    var want: u32 = 2
    var eio = false
    for round in 0..8
        while app_event()
            if want == eio_at and not eio
                if not ev_is(EV_ERROR, 1, -5)
                    return 3
                eio = true
            else
                if g_evd.id != want
                    return 4
                want += 1
        svc.service(1200 + round as u64)
    if not eio or want != next_id
        return 5
    0

[[test]]
fn test_owed_ping_reply_is_the_only_terminal_event() -> i32
    let svc = bound(0)
    cache_peer(svc, 10)
    app_attach(svc)
    app_ping(1, "abc")
    svc.service(100)
    if drv_take() == 0 or not got_is_echo_request()
        return 1
    let id = got_echo_id()
    let seq = got_echo_seq()
    # Binds with no event read fill the event ring.
    var next_id: u32 = 2
    for round in 0..2
        while app_bind(next_id, (6000 + next_id) as u16)
            next_id += 1
        svc.service(200 + round as u64)
    # The reply is owed behind a full ring when the deadline passes.
    drv_echo_reply(PEER_IP, id, seq, "abc")
    svc.service(300)
    svc.service(100 + PING_DEADLINE_MS)
    var replies: u32 = 0
    var errors: u32 = 0
    for round in 0..8
        while app_event()
            if g_evd.id == 1
                if ev_is(EV_PING_REPLY, 1, 0) and g_evd.length == 3 and g_evbuf[0] == 'a' as u8
                    replies += 1
                else
                    errors += 1
        svc.service(2000 + round as u64)
    if replies != 1 or errors != 0
        return 2
    0

# ---------------------------------------------------------------------------
# The frame-seat handoff (AGAST #4744, RING2_NET.md "Frame seat")
# ---------------------------------------------------------------------------

# The kernel seat ran the self-test on this region first: RX consumed to
# 300 and TX produced to 300, then one frame each way while netd waited in
# its ready NetPublish (the kernel's DHCPRELEASE, an RX frame). take_seat
# moves netd's halves to the kernel's private indexes; at 0 the next pass
# would find 301 frames in a 256-slot ring and close it.
[[test]]
fn test_take_seat_resumes_at_the_kernels_indexes() -> i32
    let svc = fresh()
    let region: u64 = @g_region as u64
    var k_rx = SpscConsumer.new(spsc_rx_ring(region))
    var k_tx = SpscProducer.new(spsc_tx_ring(region))
    let filler: [1]u8 = [0]
    for i in 0..300
        drv_publish(@filler)
        match k_rx.next(@&g_got, 0, 1)
            Take.Frame(_) => pass
            _ => return 1
        match k_tx.publish(@filler)
            Publish.Done => pass
            _ => return 2
        if drv_take() != 1
            return 3
    svc.ready(link_info(1))
    match k_tx.publish(@filler)
        Publish.Done => pass
        _ => return 4
    drv_take()
    drv_publish(@filler)
    svc.take_seat(k_rx.read, k_tx.write)
    # The RX frame at 300 is netd's (a one-byte frame: a reject, counted).
    if svc.service(0).is_err()
        return 5
    if svc.counters.rx_frames + svc.counters.rx_rejects != 1
        return 6
    # DHCP's discover is TX sequence 301, and the driver takes it.
    svc.set_link(link_info(1), 0)
    if svc.take_published() != 1
        return 7
    if drv_take() == 0 or not got_is_dhcp(1)
        return 8
    0

# netd logs "configured <address>" from this once a lease is bound.
[[test]]
fn test_address_is_the_bound_lease_only() -> i32
    let svc = started(0)
    match svc.address()
        Some(_) => return 1
        None => pass
    let b = bound(0)
    match b.address()
        Some(a) =>
            if a != OUR_IP
                return 2
        None => return 3
    b.set_link(link_info(0), 50)
    match b.address()
        Some(_) => return 4
        None => pass
    0
