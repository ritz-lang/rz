# Harland virtio feature negotiation (AGAST #4732, docs/RING1_DRIVER.md
# sections 5 and 8)
#
# Feature bits as one u64 (virtio 1.1 section 2.2): bits 0-31 are device
# specific and transport word 0, bits 32 and up are reserved for the
# transport and the queue and are word 1. The legacy transport has word 0
# only. Reading and writing the words is the transport's; this file only
# decides what the driver accepts.

# VIRTIO_F_VERSION_1, bit 32: the device is virtio 1.x. A modern device
# may refuse FEATURES_OK, or behave as legacy, without it (section 6.1),
# so the driver accepts it whenever the device offers it.
pub const VIRTIO_F_VERSION_1: u64 = 0x100000000

# VIRTIO_F_ACCESS_PLATFORM, bit 33: the device's DMA goes through the
# platform's translation (an IOMMU domain). Without it the device DMAs to
# guest-physical addresses and the domain proves nothing, so a driver on a
# translating boot asks for it (RING1_DRIVER.md "DMA domain").
pub const VIRTIO_F_ACCESS_PLATFORM: u64 = 0x200000000

# The features the driver writes: what it `wanted` of what the device
# `offered`, plus VERSION_1 whenever offered. Nothing the device did not
# offer is accepted.
pub fn virtio_driver_features(offered: u64, wanted: u64) -> u64
    offered & (wanted | VIRTIO_F_VERSION_1)

# Transport word 0 (bits 0-31) and word 1 (bits 32-63) of `features`.
pub fn virtio_features_lo(features: u64) -> u32
    (features & 0xFFFFFFFF) as u32

pub fn virtio_features_hi(features: u64) -> u32
    (features >> 32) as u32

# `features` from its two transport words.
pub fn virtio_features_join(lo: u32, hi: u32) -> u64
    ((hi as u64) << 32) | (lo as u64)
