# Harland usb_abi context tests (AGAST #4887)
#
# Input and device context layout at both context sizes (HCCPARAMS1.CSZ:
# 32 or 64 bytes), the endpoint's device context index, and the words of
# the input control, slot and endpoint contexts the driver writes for
# Address Device, Evaluate Context and Configure Endpoint. The contexts lie
# over a host global, as the driver's lie over a DMA page.

import usb_abi.context { CtxWords, InputContext, DeviceContext, SlotState, EpType, ctx_bytes, input_ctx_bytes, device_ctx_bytes, dci_of, input_control, slot_ctx, ep_ctx, slot_state, slot_address, ADD_SLOT, ADD_EP0, add_flag }
import usb_abi.regs { UsbSpeed }

# Room for an input context at 64-byte contexts: 33 * 64 bytes.
var g_ctx: [33 * 64 / 8]u64

fn ctx_base() -> u64
    for i in 0..33 * 64 / 8
        g_ctx[i] = 0
    @g_ctx as u64

[[test]]
fn test_context_sizes() -> i32
    assert sizeof(CtxWords) == 32
    assert ctx_bytes(false) == 32
    assert ctx_bytes(true) == 64
    # Input: control + slot + 31 endpoints. Device: slot + 31 endpoints.
    assert input_ctx_bytes(false) == 33 * 32
    assert input_ctx_bytes(true) == 33 * 64
    assert device_ctx_bytes(false) == 32 * 32
    assert device_ctx_bytes(true) == 32 * 64
    0

[[test]]
fn test_dci_from_endpoint_address() -> i32
    assert dci_of(0x00) == 1           # EP0
    assert dci_of(0x01) == 2           # EP1 OUT
    assert dci_of(0x81) == 3           # EP1 IN
    assert dci_of(0x82) == 5           # EP2 IN
    assert dci_of(0x8F) == 31          # EP15 IN, the last
    0

[[test]]
fn test_input_context_offsets_32() -> i32
    let base: u64 = ctx_base()
    let ic = InputContext.over(base, false)
    assert ic.control() as u64 == base
    assert ic.slot() as u64 == base + 32
    assert ic.ep(1) as u64 == base + 64
    assert ic.ep(31) as u64 == base + 32 * 32
    0

[[test]]
fn test_input_context_offsets_64() -> i32
    let base: u64 = ctx_base()
    let ic = InputContext.over(base, true)
    assert ic.slot() as u64 == base + 64
    assert ic.ep(1) as u64 == base + 128
    assert ic.ep(3) as u64 == base + 4 * 64
    assert ic.ep(31) as u64 == base + 32 * 64
    0

[[test]]
fn test_device_context_offsets() -> i32
    let base: u64 = ctx_base()
    let d32 = DeviceContext.over(base, false)
    assert d32.slot() as u64 == base
    assert d32.ep(1) as u64 == base + 32
    let d64 = DeviceContext.over(base, true)
    assert d64.ep(1) as u64 == base + 64
    assert d64.ep(31) as u64 == base + 31 * 64
    0

[[test]]
fn test_input_control_words() -> i32
    let w: CtxWords = input_control(0, ADD_SLOT | ADD_EP0)
    assert w.dw[0] == 0
    assert w.dw[1] == 3
    assert ADD_SLOT == 1
    assert ADD_EP0 == 2
    assert add_flag(1) == ADD_EP0
    assert add_flag(3) == 8
    assert add_flag(31) == 0x80000000
    0

[[test]]
fn test_slot_context_words() -> i32
    # A full-speed device on root port 3, contexts up to EP0.
    let w: CtxWords = slot_ctx(UsbSpeed.Full, 3, 1)
    assert w.dw[0] == ((1 << 20) | (1 << 27))
    assert w.dw[1] == 3 << 16
    assert w.dw[2] == 0                # interrupter 0, no TT
    assert w.dw[3] == 0
    let s: CtxWords = slot_ctx(UsbSpeed.Super, 5, 3)
    assert s.dw[0] == ((4 << 20) | (3 << 27))
    assert s.dw[1] == 5 << 16
    0

[[test]]
fn test_ep0_context_words() -> i32
    # Control, MPS 8, three error retries, dequeue 0x5000 with cycle 1.
    let w: CtxWords = ep_ctx(EpType.Control, 8, 0, 0x5000 | 1)
    assert w.dw[0] == 0
    assert w.dw[1] == ((3 << 1) | (4 << 3) | (8 << 16))
    assert w.dw[2] == 0x5001
    assert w.dw[3] == 0
    assert w.dw[4] == 8                # average TRB length of a control
    0

[[test]]
fn test_interrupt_in_context_words() -> i32
    # A boot keyboard's endpoint: interrupt IN, MPS 8, interval 6.
    let w: CtxWords = ep_ctx(EpType.InterruptIn, 8, 6, 0x0001234000 | 1)
    assert w.dw[0] == 6 << 16
    assert w.dw[1] == ((3 << 1) | (7 << 3) | (8 << 16))
    assert w.dw[2] == 0x01234001
    assert w.dw[3] == 0
    # Average TRB length and Max ESIT Payload: one packet.
    assert w.dw[4] == (8 | (8 << 16))
    0

[[test]]
fn test_context_written_through_view() -> i32
    let base: u64 = ctx_base()
    let ic = InputContext.over(base, true)
    *ic.control() = input_control(0, ADD_SLOT | ADD_EP0)
    *ic.slot() = slot_ctx(UsbSpeed.High, 2, 1)
    *ic.ep(1) = ep_ctx(EpType.Control, 64, 0, 0x9000 | 1)
    # Raw dwords at the 64-byte offsets: control, slot, EP0.
    assert g_ctx[0] == 3 << 32
    assert g_ctx[8] == (((3 << 20) | (1 << 27)) as u64 | ((2 << 16) as u64 << 32))
    assert g_ctx[16] == (((64 << 16) | (4 << 3) | (3 << 1)) as u64 << 32)
    assert g_ctx[17] == 0x9001
    0

[[test]]
fn test_slot_state_and_address() -> i32
    var w: CtxWords = slot_ctx(UsbSpeed.Full, 1, 1)
    assert slot_state(w) == SlotState.DisabledOrEnabled
    w.dw[3] = (2 << 27) | 5
    assert slot_state(w) == SlotState.Addressed
    assert slot_address(w) == 5
    w.dw[3] = (3 << 27) | 5
    assert slot_state(w) == SlotState.Configured
    w.dw[3] = 1 << 27
    assert slot_state(w) == SlotState.Default
    w.dw[3] = 7 << 27
    assert slot_state(w) == SlotState.Reserved
    0
