# Harland xHCI contexts (AGAST #4887, docs/USB.md)
#
# The input context the driver hands to Address Device, Evaluate Context
# and Configure Endpoint, and the device context the controller keeps for
# each slot (xHCI 1.2 section 6.2). Every context is 32 bytes, or 64 when
# HCCPARAMS1.CSZ is set; the defined fields are in the first 32 either way,
# so a context's words are one CtxWords and only the stride differs.
#
# Input context: input control, slot, then endpoint contexts by device
# context index (DCI) 1..31. Device context: slot, then DCI 1..31.

import usb_abi.regs { UsbSpeed, speed_psiv }

pub const CTX_COUNT: u64 = 32              # slot + 31 endpoints

# The defined words of one context.
pub struct CtxWords
    dw: [8]u32

pub fn ctx_bytes(ctx64: bool) -> u64
    if ctx64 then 64 else 32

pub fn input_ctx_bytes(ctx64: bool) -> u64
    (CTX_COUNT + 1) * ctx_bytes(ctx64)

pub fn device_ctx_bytes(ctx64: bool) -> u64
    CTX_COUNT * ctx_bytes(ctx64)

# The DCI of the endpoint at `address` (bit 7 IN, bits 3:0 the number):
# 2 * number + IN. EP0, bidirectional, is 1.
pub fn dci_of(address: u8) -> u8
    let n: u8 = address & 0x0F
    if n == 0
        return 1
    let dir_in: u8 = if (address & 0x80) != 0 then 1 else 0
    n * 2 + dir_in

# An input context at CPU address `base`.
pub struct InputContext
    base: u64
    ctx64: bool

impl InputContext
    pub fn over(base: u64, ctx64: bool) -> InputContext
        InputContext { base: base, ctx64: ctx64 }

    fn at(self: @InputContext, index: u64) -> *CtxWords
        (self.base + index * ctx_bytes(self.ctx64)) as *CtxWords

    pub fn control(self: @InputContext) -> *CtxWords
        self.at(0)

    pub fn slot(self: @InputContext) -> *CtxWords
        self.at(1)

    # Endpoint context `dci` (1..31).
    pub fn ep(self: @InputContext, dci: u8) -> *CtxWords
        self.at(1 + dci as u64)

# A device context at CPU address `base`: the controller's to write.
pub struct DeviceContext
    base: u64
    ctx64: bool

impl DeviceContext
    pub fn over(base: u64, ctx64: bool) -> DeviceContext
        DeviceContext { base: base, ctx64: ctx64 }

    pub fn slot(self: @DeviceContext) -> *CtxWords
        self.base as *CtxWords

    pub fn ep(self: @DeviceContext, dci: u8) -> *CtxWords
        (self.base + (dci as u64) * ctx_bytes(self.ctx64)) as *CtxWords

# ============================================================================
# Input control context
# ============================================================================

# Add-context flags: A0 the slot, A1 EP0, A(dci) endpoint dci.
pub const ADD_SLOT: u32 = 1 << 0
pub const ADD_EP0: u32 = 1 << 1

pub fn add_flag(dci: u8) -> u32
    1 << (dci as u32)

pub fn input_control(drop: u32, add: u32) -> CtxWords
    var w = CtxWords { dw: [0, 0, 0, 0, 0, 0, 0, 0] }
    w.dw[0] = drop
    w.dw[1] = add
    w

# ============================================================================
# Slot context
# ============================================================================

# A root-hub device's slot context: its speed, its root port (1-based), and
# the last valid endpoint DCI (`entries`). Route string 0, interrupter 0.
pub fn slot_ctx(speed: UsbSpeed, root_port: u8, entries: u8) -> CtxWords
    var w = CtxWords { dw: [0, 0, 0, 0, 0, 0, 0, 0] }
    w.dw[0] = (speed_psiv(speed) << 20) | (((entries as u32) & 0x1F) << 27)
    w.dw[1] = (root_port as u32) << 16
    w

# The Slot State the controller keeps in dword 3.
pub enum SlotState
    DisabledOrEnabled
    Default
    Addressed
    Configured
    Reserved

pub fn slot_state(w: CtxWords) -> SlotState
    match (w.dw[3] >> 27) & 0x1F
        0 => SlotState.DisabledOrEnabled
        1 => SlotState.Default
        2 => SlotState.Addressed
        3 => SlotState.Configured
        _ => SlotState.Reserved

# The USB address the controller gave the device.
pub fn slot_address(w: CtxWords) -> u8
    (w.dw[3] & 0xFF) as u8

# ============================================================================
# Endpoint context
# ============================================================================

# The endpoint context's EP Type (dword 1, bits 5:3).
pub enum EpType: u32
    NotValid = 0
    IsochOut = 1
    BulkOut = 2
    InterruptOut = 3
    Control = 4
    IsochIn = 5
    BulkIn = 6
    InterruptIn = 7

# Errors the controller retries before it halts the endpoint.
const EP_CERR: u32 = 3

# An endpoint context for one packet per service interval: `mps` bytes,
# Interval `interval` (regs.ep_interval), the transfer ring at `dequeue`
# (its device address with the cycle state in bit 0). A control endpoint's
# average TRB is the 8-byte setup; a periodic one moves one packet.
pub fn ep_ctx(ep_type: EpType, mps: u16, interval: u8, dequeue: u64) -> CtxWords
    var w = CtxWords { dw: [0, 0, 0, 0, 0, 0, 0, 0] }
    w.dw[0] = (interval as u32) << 16
    w.dw[1] = (EP_CERR << 1) | ((ep_type as u32) << 3) | ((mps as u32) << 16)
    w.dw[2] = (dequeue & 0xFFFFFFFF) as u32
    w.dw[3] = (dequeue >> 32) as u32
    let periodic: bool = match ep_type
        IsochOut => true
        IsochIn => true
        InterruptOut => true
        InterruptIn => true
        _ => false
    if periodic
        w.dw[4] = (mps as u32) | ((mps as u32) << 16)
    else
        w.dw[4] = 8
    w
