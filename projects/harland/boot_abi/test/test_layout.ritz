# Harland boot ABI layout (AGAST #4578)
#
# The UEFI loader (boot/src) and the kernel (kernel/src) both import
# HarlandBootInfo, HarlandMemEntry and the ELF64 structs from this package.
# These tests pin the byte offsets of every field the two sides exchange,
# so a field added, dropped or resized here fails a test rather than a boot.
#
# Offsets are taken from a live global: &field - &struct.

import boot_abi.handoff { HarlandBootInfo, HarlandMemEntry, HARLAND_BOOT_MAGIC, HARLAND_BOOT_VERSION, HARLAND_BOOT_VERSION_INITRAMFS, HARLAND_BOOT_VERSION_FLAGS, HARLAND_BOOT_FLAG_NET_SELFTEST, HARLAND_BOOT_FLAG_NET_RESPONDER, HARLAND_MEM_USABLE, HARLAND_MEM_RESERVED, HARLAND_MEM_ACPI_RECLAIMABLE }
import boot_abi.elf64 { Elf64Ehdr, Elf64Phdr, Elf64Shdr, Elf64Sym, ELF64_EHDR_SIZE, ELF64_PHDR_SIZE }

var g_info: HarlandBootInfo
var g_mem: HarlandMemEntry
var g_ehdr: Elf64Ehdr
var g_phdr: Elf64Phdr
var g_shdr: Elf64Shdr
var g_sym: Elf64Sym

fn off(field: u64, base: u64) -> u64
    return field - base

# ---------------------------------------------------------------------------
# Boot handoff
# ---------------------------------------------------------------------------

[[test]]
fn test_boot_info_size() -> i32
    # Version 3: 104 bytes. A new field means a new version and a new size.
    if sizeof(HarlandBootInfo) != 104
        return 1
    return 0

[[test]]
fn test_boot_info_offsets() -> i32
    let b: u64 = @g_info as u64
    if off(@g_info.magic as u64, b) != 0
        return 1
    if off(@g_info.version as u64, b) != 4
        return 2
    if off(@g_info.memory_map as u64, b) != 8
        return 3
    if off(@g_info.memory_map_entries as u64, b) != 16
        return 4
    if off(@g_info.framebuffer_addr as u64, b) != 24
        return 5
    if off(@g_info.framebuffer_width as u64, b) != 32
        return 6
    if off(@g_info.framebuffer_height as u64, b) != 36
        return 7
    if off(@g_info.framebuffer_pitch as u64, b) != 40
        return 8
    if off(@g_info.framebuffer_bpp as u64, b) != 44
        return 9
    if off(@g_info.framebuffer_format as u64, b) != 45
        return 10
    if off(@g_info.rsdp_addr as u64, b) != 48
        return 11
    if off(@g_info.kernel_phys as u64, b) != 56
        return 12
    if off(@g_info.kernel_size as u64, b) != 64
        return 13
    if off(@g_info.pml4_phys as u64, b) != 72
        return 14
    if off(@g_info.initramfs_phys as u64, b) != 80
        return 15
    if off(@g_info.initramfs_size as u64, b) != 88
        return 16
    # flags is the version-3 tail; a version-2 kernel reads no further.
    if off(@g_info.flags as u64, b) != 96
        return 17
    return 0

[[test]]
fn test_mem_entry_layout() -> i32
    if sizeof(HarlandMemEntry) != 24
        return 1
    let b: u64 = @g_mem as u64
    if off(@g_mem.base as u64, b) != 0
        return 2
    if off(@g_mem.length as u64, b) != 8
        return 3
    if off(@g_mem.mem_type as u64, b) != 16
        return 4
    return 0

[[test]]
fn test_boot_protocol_constants() -> i32
    if HARLAND_BOOT_MAGIC != 0x4841524C
        return 1
    # The loader writes HARLAND_BOOT_VERSION; the kernel gates fields on the
    # per-feature versions, which must not run ahead of it.
    if HARLAND_BOOT_VERSION != 3
        return 2
    if HARLAND_BOOT_VERSION_INITRAMFS != 2
        return 3
    if HARLAND_BOOT_VERSION_FLAGS != 3
        return 4
    if HARLAND_BOOT_FLAG_NET_SELFTEST != 1 or HARLAND_BOOT_FLAG_NET_RESPONDER != 2
        return 5
    if HARLAND_MEM_USABLE != 1 or HARLAND_MEM_RESERVED != 2 or HARLAND_MEM_ACPI_RECLAIMABLE != 3
        return 6
    return 0

# ---------------------------------------------------------------------------
# ELF64 (System V gABI)
# ---------------------------------------------------------------------------

[[test]]
fn test_elf64_ehdr_layout() -> i32
    if sizeof(Elf64Ehdr) != 64 or ELF64_EHDR_SIZE != 64
        return 1
    let b: u64 = @g_ehdr as u64
    if off(@g_ehdr.e_type as u64, b) != 16
        return 2
    if off(@g_ehdr.e_machine as u64, b) != 18
        return 3
    if off(@g_ehdr.e_entry as u64, b) != 24
        return 4
    if off(@g_ehdr.e_phoff as u64, b) != 32
        return 5
    if off(@g_ehdr.e_shoff as u64, b) != 40
        return 6
    if off(@g_ehdr.e_flags as u64, b) != 48
        return 7
    if off(@g_ehdr.e_phentsize as u64, b) != 54
        return 8
    if off(@g_ehdr.e_phnum as u64, b) != 56
        return 9
    if off(@g_ehdr.e_shentsize as u64, b) != 58
        return 10
    if off(@g_ehdr.e_shnum as u64, b) != 60
        return 11
    if off(@g_ehdr.e_shstrndx as u64, b) != 62
        return 12
    return 0

[[test]]
fn test_elf64_phdr_layout() -> i32
    if sizeof(Elf64Phdr) != 56 or ELF64_PHDR_SIZE != 56
        return 1
    let b: u64 = @g_phdr as u64
    if off(@g_phdr.p_flags as u64, b) != 4
        return 2
    if off(@g_phdr.p_offset as u64, b) != 8
        return 3
    if off(@g_phdr.p_vaddr as u64, b) != 16
        return 4
    if off(@g_phdr.p_filesz as u64, b) != 32
        return 5
    if off(@g_phdr.p_memsz as u64, b) != 40
        return 6
    if off(@g_phdr.p_align as u64, b) != 48
        return 7
    return 0

[[test]]
fn test_elf64_shdr_layout() -> i32
    if sizeof(Elf64Shdr) != 64
        return 1
    let b: u64 = @g_shdr as u64
    if off(@g_shdr.sh_type as u64, b) != 4
        return 2
    if off(@g_shdr.sh_flags as u64, b) != 8
        return 3
    if off(@g_shdr.sh_offset as u64, b) != 24
        return 4
    if off(@g_shdr.sh_size as u64, b) != 32
        return 5
    if off(@g_shdr.sh_link as u64, b) != 40
        return 6
    if off(@g_shdr.sh_entsize as u64, b) != 56
        return 7
    return 0

[[test]]
fn test_elf64_sym_layout() -> i32
    if sizeof(Elf64Sym) != 24
        return 1
    let b: u64 = @g_sym as u64
    if off(@g_sym.st_info as u64, b) != 4
        return 2
    if off(@g_sym.st_shndx as u64, b) != 6
        return 3
    if off(@g_sym.st_value as u64, b) != 8
        return 4
    if off(@g_sym.st_size as u64, b) != 16
        return 5
    return 0
