# ELF64 file layouts (AGAST #4578)
#
# The one set of ELF64 structs and constants Harland reads ELF files with:
# the UEFI loader parses the kernel image (and its symbol table) with them,
# and the kernel's loader/image.ritz validates user programs with them.
# Layouts follow the System V gABI; boot_abi/test/test_layout.ritz pins
# every offset either side reads.
#
# Imports nothing, so it builds for every Harland target.

# ============================================================================
# Constants
# ============================================================================

# e_ident[0..4] as one little-endian u32: 0x7F 'E' 'L' 'F'
pub const ELF_MAGIC: u32 = 0x464C457F

# ELF magic bytes: 0x7F 'E' 'L' 'F'
pub const ELF_MAGIC_0: u8 = 0x7F
pub const ELF_MAGIC_1: u8 = 0x45  # 'E'
pub const ELF_MAGIC_2: u8 = 0x4C  # 'L'
pub const ELF_MAGIC_3: u8 = 0x46  # 'F'

# e_ident indices
pub const EI_MAG0: i32 = 0
pub const EI_MAG1: i32 = 1
pub const EI_MAG2: i32 = 2
pub const EI_MAG3: i32 = 3
pub const EI_CLASS: i32 = 4     # 1=32-bit, 2=64-bit
pub const EI_DATA: i32 = 5      # 1=little-endian, 2=big-endian
pub const EI_VERSION: i32 = 6
pub const EI_OSABI: i32 = 7
pub const EI_ABIVERSION: i32 = 8

# ELF class values
pub const ELFCLASS64: u8 = 2

# ELF data encoding
pub const ELFDATA2LSB: u8 = 1  # Little-endian

# e_type values
pub const ET_EXEC: u16 = 2   # Executable file
pub const ET_DYN: u16 = 3    # Shared object file (PIE)

# e_machine values
pub const EM_X86_64: u16 = 62

# Program header types
pub const PT_NULL: u32 = 0
pub const PT_LOAD: u32 = 1    # Loadable segment
pub const PT_DYNAMIC: u32 = 2
pub const PT_INTERP: u32 = 3
pub const PT_NOTE: u32 = 4
pub const PT_PHDR: u32 = 6
pub const PT_GNU_STACK: u32 = 0x6474E551
pub const PT_GNU_RELRO: u32 = 0x6474E552

# Program header flags
pub const PF_X: u32 = 1       # Execute
pub const PF_W: u32 = 2       # Write
pub const PF_R: u32 = 4       # Read

# Section header types
pub const SHT_NULL: u32 = 0
pub const SHT_SYMTAB: u32 = 2   # Symbol table
pub const SHT_STRTAB: u32 = 3   # String table

# Symbol types (lower 4 bits of st_info)
pub const STT_FUNC: u8 = 2

# sizeof(Elf64Ehdr) and sizeof(Elf64Phdr), as e_ehsize/e_phentsize carry them.
pub const ELF64_EHDR_SIZE: u16 = 64
pub const ELF64_PHDR_SIZE: u16 = 56

# ============================================================================
# Structures
# ============================================================================

# ELF64 file header (64 bytes)
pub struct Elf64Ehdr
    e_ident: [16]u8       # Magic number and other info
    e_type: u16           # Object file type
    e_machine: u16        # Architecture
    e_version: u32        # Object file version
    e_entry: u64          # Entry point virtual address
    e_phoff: u64          # Program header table file offset
    e_shoff: u64          # Section header table file offset
    e_flags: u32          # Processor-specific flags
    e_ehsize: u16         # ELF header size in bytes
    e_phentsize: u16      # Program header table entry size
    e_phnum: u16          # Program header table entry count
    e_shentsize: u16      # Section header table entry size
    e_shnum: u16          # Section header table entry count
    e_shstrndx: u16       # Section header string table index

# ELF64 program header (56 bytes)
pub struct Elf64Phdr
    p_type: u32           # Segment type
    p_flags: u32          # Segment flags
    p_offset: u64         # Segment file offset
    p_vaddr: u64          # Segment virtual address
    p_paddr: u64          # Segment physical address
    p_filesz: u64         # Segment size in file
    p_memsz: u64          # Segment size in memory
    p_align: u64          # Segment alignment

# ELF64 section header (64 bytes)
pub struct Elf64Shdr
    sh_name: u32          # Section name (string table index)
    sh_type: u32          # Section type
    sh_flags: u64         # Section flags
    sh_addr: u64          # Virtual address
    sh_offset: u64        # File offset
    sh_size: u64          # Section size
    sh_link: u32          # Link to another section
    sh_info: u32          # Additional info
    sh_addralign: u64     # Alignment
    sh_entsize: u64       # Entry size if table

# ELF64 symbol table entry (24 bytes)
pub struct Elf64Sym
    st_name: u32          # Symbol name (string table index)
    st_info: u8           # Type and binding
    st_other: u8          # Visibility
    st_shndx: u16         # Section index
    st_value: u64         # Symbol value (address)
    st_size: u64          # Symbol size
