# x86-64 port I/O primitives shared by the UEFI loader and the kernel
# (AGAST #4578). kernel/src/io.ritz re-exports these beside its wider
# port and CPU helpers; boot_abi/src/serial.ritz drives COM1 with them.
#
# Inline asm only, no imports: builds for x86_64-unknown-uefi and the
# freestanding kernel.

pub fn outb(port: u16, value: u8) -> i32
    asm x86_64:
        movw {port}, %dx
        movb {value}, %al
        outb %al, %dx
    return 0

pub fn inb(port: u16) -> u8
    var result: u8 = 0
    var result_ptr: *u8 = @result
    asm x86_64:
        movw {port}, %dx
        inb %dx, %al
        movq {result_ptr}, %rcx
        movb %al, (%rcx)
    return result

# Spin-wait hint
pub fn cpu_pause() -> i32
    asm x86_64:
        pause
    return 0
