# Harland netstack: Internet checksum vectors (AGAST #4738)
#
# Independent vectors, not values this package computed: RFC 1071's
# section 3 example and a textbook IPv4 header whose checksum is 0xb861.

import netstack.checksum { inet_sum, inet_fold, inet_checksum }

[[test]]
fn test_rfc1071_example() -> i32
    let data: [8]u8 = [0x00, 0x01, 0xF2, 0x03, 0xF4, 0xF5, 0xF6, 0xF7]
    # The folded sum is 0xddf2; the field is its complement.
    if inet_checksum(@data) != 0x220D
        return 1
    0

[[test]]
fn test_odd_length_pads_a_zero_low_byte() -> i32
    let one: [1]u8 = [0x01]
    if inet_checksum(@one) != 0xFEFF
        return 1
    let three: [3]u8 = [0x00, 0x01, 0xF2]
    let four: [4]u8 = [0x00, 0x01, 0xF2, 0x00]
    if inet_checksum(@three) != inet_checksum(@four)
        return 2
    0

[[test]]
fn test_ipv4_header_vector() -> i32
    var hdr: [20]u8 = [0x45, 0x00, 0x00, 0x73, 0x00, 0x00, 0x40, 0x00, 0x40, 0x11, 0xB8, 0x61, 0xC0, 0xA8, 0x00, 0x01, 0xC0, 0xA8, 0x00, 0xC7]
    # A correct header, its field included, checks to 0.
    if inet_checksum(@hdr) != 0
        return 1
    hdr[10] = 0
    hdr[11] = 0
    if inet_checksum(@hdr) != 0xB861
        return 2
    0

[[test]]
fn test_running_sum_matches_one_pass() -> i32
    let all: [8]u8 = [0x00, 0x01, 0xF2, 0x03, 0xF4, 0xF5, 0xF6, 0xF7]
    let s: [u8] = @all
    let lo = s[0..4]
    let hi = s[4..8]
    let split = inet_sum(inet_sum(0, lo), hi)
    if inet_fold(split) != inet_checksum(s)
        return 1
    # Many carries: 0xFFFF words fold back to 0xFFFF, field 0.
    var ones: [64]u8
    for i in 0..64
        ones[i] = 0xFF
    if inet_checksum(@ones) != 0
        return 2
    0
