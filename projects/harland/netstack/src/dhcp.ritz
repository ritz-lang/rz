# Harland netstack: DHCP client (AGAST #4741, docs/RING2_NET.md "UDP and
# DHCP"; RFC 2131)
#
# The client the service runs, as a caller-owned DhcpClient and pure
# methods. The caller owns the clock (`now_ms`, milliseconds, any epoch),
# the randomness (`rand`, any u32: it picks the +-1 s retransmit jitter),
# the UDP wrap (udp_frame_write) and the address record: every event
# returns a DhcpStep naming what to send and whether to write or clear the
# record. No globals, so the host tests drive it on a fake clock.
#
# States, with their RFC 2131 names: Idle (INIT), Selecting, Requesting,
# Bound, Renewing, Rebinding.
#
# - Every message is checked in every state: a BOOTREPLY with the
#   Ethernet layout and the magic cookie, our transaction id, our client
#   hardware address, and options that fit the payload (a known option of
#   the wrong length drops it too). A message that fails is dropped.
# - Selecting takes an OFFER; its option 54 becomes the selected server.
#   Requesting and Renewing take an ACK or NAK only from that server.
#   Rebinding takes them from any server, and an ACK's option 54 becomes
#   the selected server. Idle and Bound take nothing.
# - A NAK returns to Idle and clears the record; the client starts a new
#   discover after one randomized retransmit interval. Expiry clears the
#   record and starts a new discover at once. Link down clears it and
#   waits in Idle for start().
# - Discover and request retransmit at 4 s +-1 s, doubling, capped at
#   64 s. Selecting retries at the cap for as long as it takes; Requesting
#   gives up after the wait at the cap and discovers again.
# - T1 defaults to 1/2 of the lease and T2 to 7/8, used too when the
#   server's pair is not T1 <= T2 <= lease; all three count from the
#   request that was ACKed. At T1 the client unicasts a request to the
#   server, at T2 it broadcasts one; each retransmits after half the time
#   left to the next deadline, at least 60 s (RFC 2131 4.4.5). A lease of
#   0xFFFFFFFF never expires.
# - The record holds only what the ACK carried: no router leaves the
#   gateway unset and no netmask installs no prefix. Nothing is invented.

import netstack.bytes { be16_put, be32_get, be32_put }
import netstack.ethernet { MacAddr, SendError }
import netstack.ipv4 { Ipv4Config, IPV4_BROADCAST, ipv4_unconfigured }

pub const DHCP_MAGIC: u32 = 0x63825363
# The fixed BOOTP header plus the magic cookie: the options start here.
pub const DHCP_OPTIONS_OFF: i64 = 240

pub const DHCP_RETX_BASE_MS: u64 = 4000
pub const DHCP_RETX_CAP_MS: u64 = 64000
pub const DHCP_RETX_JITTER_MS: u64 = 1000
pub const DHCP_RENEW_RETX_MIN_MS: u64 = 60000
# A deadline that never comes: the timers of an infinite lease.
pub const DHCP_NEVER: u64 = 0xFFFFFFFFFFFFFFFF
pub const DHCP_LEASE_INFINITE: u32 = 0xFFFFFFFF

const BOOTREQUEST: u8 = 1
const BOOTREPLY: u8 = 2
const HTYPE_ETHERNET: u8 = 1
const HLEN_ETHERNET: u8 = 6
const FLAG_BROADCAST: u16 = 0x8000
const OFF_XID: i64 = 4
const OFF_FLAGS: i64 = 10
const OFF_CIADDR: i64 = 12
const OFF_YIADDR: i64 = 16
const OFF_CHADDR: i64 = 28
const OFF_MAGIC: i64 = 236

const OPT_PAD: u8 = 0
const OPT_NETMASK: u8 = 1
const OPT_ROUTER: u8 = 3
const OPT_DNS: u8 = 6
const OPT_REQUESTED_IP: u8 = 50
const OPT_LEASE: u8 = 51
const OPT_MSG_TYPE: u8 = 53
const OPT_SERVER_ID: u8 = 54
const OPT_PARAMS: u8 = 55
const OPT_T1: u8 = 58
const OPT_T2: u8 = 59
const OPT_END: u8 = 255

const MSG_DISCOVER: u8 = 1
const MSG_OFFER: u8 = 2
const MSG_REQUEST: u8 = 3
const MSG_ACK: u8 = 5
const MSG_NAK: u8 = 6

# Option 53 (3 bytes), option 55 asking for 1, 3, 6 and 51 (6), the end.
const SEND_OPTS_LEN: i64 = 10
# Options 50 and 54, 6 bytes each: only the request in Requesting.
const SELECT_OPTS_LEN: i64 = 12

pub enum DhcpState
    Idle                             # INIT
    Selecting                        # discover sent
    Requesting                       # request sent for the selected offer
    Bound                            # configured
    Renewing                         # T1 passed: unicast to the server
    Rebinding                        # T2 passed: broadcast to any server

# Why a received message was dropped.
pub enum DhcpDrop
    Short                            # under DHCP_OPTIONS_OFF bytes
    Layout                           # not a BOOTREPLY, not Ethernet, no magic cookie
    Xid                              # not our transaction id
    Chaddr                           # not our hardware address
    Option                           # an option past the payload, or a known one of the wrong length
    Kind                             # no message type, or not OFFER, ACK or NAK
    State                            # a message this state does not take
    Server                           # no server id, or not the pinned server
    Lease                            # an OFFER or ACK without an address, or an ACK without a lease time

# The three messages the client takes.
pub enum DhcpKind
    Offer
    Ack
    Nak

# One checked server message. Address options carry their first address.
pub struct DhcpMsg
    kind: DhcpKind
    yiaddr: u32
    server: Option<u32>
    netmask: Option<u32>
    router: Option<u32>
    dns: Option<u32>
    lease_secs: Option<u32>
    t1_secs: Option<u32>
    t2_secs: Option<u32>

# The address record a valid ACK writes. Only what the ACK carried.
pub struct DhcpLease
    addr: u32
    server: u32
    netmask: Option<u32>
    router: Option<u32>
    dns: Option<u32>
    lease_secs: u32

# What the caller sends for one step.
pub enum DhcpSend
    Discover                         # broadcast, 0.0.0.0 -> 255.255.255.255
    Request                          # broadcast, for the selected offer (options 50, 54)
    Renew                            # unicast to the selected server, ciaddr ours
    Rebind                           # broadcast, ciaddr ours

# What the caller does with the address record for one step.
pub enum DhcpRecord
    Keep
    Write                            # publish client.lease
    Clear                            # publish a cleared record

pub struct DhcpStep
    record: DhcpRecord
    send: Option<DhcpSend>

# One message written by DhcpClient.payload_write: the payload is
# out[0..len], to go from src:68 to dst:67.
pub struct DhcpTx
    src: u32
    dst: u32
    len: i64

fn step(record: DhcpRecord, send: Option<DhcpSend>) -> DhcpStep
    DhcpStep { record: record, send: send }

fn idle_step() -> DhcpStep
    step(DhcpRecord.Keep, None)

fn is_server(pinned: Option<u32>, sid: u32) -> bool
    match pinned
        Some(s) => s == sid
        None => false

# The first address of an option whose length must be a multiple of 4.
fn addr_list(payload: [u8], at: i64, len: i64) -> Result<u32, DhcpDrop>
    if len < 4 or len % 4 != 0
        return Err(DhcpDrop.Option)
    Ok(be32_get(payload, at))

fn word4(payload: [u8], at: i64, len: i64) -> Result<u32, DhcpDrop>
    if len != 4
        return Err(DhcpDrop.Option)
    Ok(be32_get(payload, at))

# Check one UDP payload from port 67 against our transaction id and
# hardware address, and read the options the client uses. Every option's
# length is checked against the payload before its data is read.
pub fn dhcp_parse(payload: [u8], xid: u32, chaddr: MacAddr) -> Result<DhcpMsg, DhcpDrop>
    if payload.len < DHCP_OPTIONS_OFF
        return Err(DhcpDrop.Short)
    if payload[0] != BOOTREPLY or payload[1] != HTYPE_ETHERNET or payload[2] != HLEN_ETHERNET or be32_get(payload, OFF_MAGIC) != DHCP_MAGIC
        return Err(DhcpDrop.Layout)
    if be32_get(payload, OFF_XID) != xid
        return Err(DhcpDrop.Xid)
    for i in 0..6
        if payload[OFF_CHADDR + i] != chaddr[i]
            return Err(DhcpDrop.Chaddr)
    var msg = DhcpMsg { kind: DhcpKind.Offer, yiaddr: be32_get(payload, OFF_YIADDR), server: None, netmask: None, router: None, dns: None, lease_secs: None, t1_secs: None, t2_secs: None }
    var msg_type: u8 = 0
    var at = DHCP_OPTIONS_OFF
    while at < payload.len
        let code = payload[at]
        if code == OPT_END
            break
        if code == OPT_PAD
            at += 1
            continue
        if at + 2 > payload.len
            return Err(DhcpDrop.Option)
        let len = payload[at + 1] as i64
        let data = at + 2
        if data + len > payload.len
            return Err(DhcpDrop.Option)
        if code == OPT_MSG_TYPE
            if len != 1
                return Err(DhcpDrop.Option)
            msg_type = payload[data]
        else if code == OPT_NETMASK
            msg.netmask = Some(word4(payload, data, len)?)
        else if code == OPT_ROUTER
            msg.router = Some(addr_list(payload, data, len)?)
        else if code == OPT_DNS
            msg.dns = Some(addr_list(payload, data, len)?)
        else if code == OPT_LEASE
            msg.lease_secs = Some(word4(payload, data, len)?)
        else if code == OPT_SERVER_ID
            msg.server = Some(word4(payload, data, len)?)
        else if code == OPT_T1
            msg.t1_secs = Some(word4(payload, data, len)?)
        else if code == OPT_T2
            msg.t2_secs = Some(word4(payload, data, len)?)
        at = data + len
    if msg_type == MSG_OFFER
        msg.kind = DhcpKind.Offer
    else if msg_type == MSG_ACK
        msg.kind = DhcpKind.Ack
    else if msg_type == MSG_NAK
        msg.kind = DhcpKind.Nak
    else
        return Err(DhcpDrop.Kind)
    Ok(msg)

# A retransmit wait: `rto` moved by -1 s..=+1 s, chosen by `rand`.
fn jittered(rto: u64, rand: u32) -> u64
    rto - DHCP_RETX_JITTER_MS + (rand as u64) % (2 * DHCP_RETX_JITTER_MS + 1)

# The renew and rebind retransmit: half the time left until `until`, at
# least DHCP_RENEW_RETX_MIN_MS, and never past `until` itself.
fn renew_deadline(now: u64, until: u64) -> u64
    var wait = (until - now) / 2
    if wait < DHCP_RENEW_RETX_MIN_MS
        wait = DHCP_RENEW_RETX_MIN_MS
    if wait > until - now
        return until
    now + wait

fn secs_ms(secs: u32) -> u64
    secs as u64 * 1000

pub struct DhcpClient
    state: DhcpState
    xid: u32
    chaddr: MacAddr
    # yiaddr of the selected offer, for option 50.
    offered: u32
    # The selected server: option 54 of the offer, or of a rebind ACK.
    server: Option<u32>
    # The address record; None is cleared.
    lease: Option<DhcpLease>
    # The retransmit interval before jitter: 4 s, doubling to 64 s.
    rto_ms: u64
    # The next retransmit, or Idle's restart after a NAK. None waits.
    deadline: Option<u64>
    # When the last request went out: T1, T2 and expiry count from it.
    sent_at: u64
    t1_at: u64
    t2_at: u64
    expires_at: u64

impl DhcpClient
    # A client in Idle for the NIC `chaddr`. `xid` is the first
    # transaction id; each later discover cycle takes the next one, so a
    # late reply to an abandoned cycle is dropped.
    pub fn new(chaddr: MacAddr, xid: u32) -> DhcpClient
        DhcpClient { state: DhcpState.Idle, xid: xid, chaddr: chaddr, offered: 0, server: None, lease: None, rto_ms: DHCP_RETX_BASE_MS, deadline: None, sent_at: 0, t1_at: DHCP_NEVER, t2_at: DHCP_NEVER, expires_at: DHCP_NEVER }

    # The IPv4 configuration the record gives receive and send.
    pub fn config(self: @DhcpClient) -> Ipv4Config
        match self.lease
            Some(l) => Ipv4Config { addr: Some(l.addr), netmask: l.netmask, gateway: l.router }
            None => ipv4_unconfigured()

    # Start a discover from Idle (the link came up). Any other state is
    # already running and takes nothing.
    pub fn start(self: @&DhcpClient, now_ms: u64, rand: u32) -> DhcpStep
        if self.state != DhcpState.Idle
            return idle_step()
        self.discover(now_ms, rand)
        step(DhcpRecord.Keep, Some(DhcpSend.Discover))

    # Link down: clear the record and wait in Idle for start().
    pub fn link_down(self: @&DhcpClient) -> DhcpStep
        self.forget()
        self.deadline = None
        step(DhcpRecord.Clear, None)

    # One UDP payload from port 67.
    pub fn receive(self: @&DhcpClient, payload: [u8], now_ms: u64, rand: u32) -> Result<DhcpStep, DhcpDrop>
        let msg = dhcp_parse(payload, self.xid, self.chaddr)?
        if self.state == DhcpState.Idle or self.state == DhcpState.Bound
            return Err(DhcpDrop.State)
        let sid = match msg.server
            Some(s) => s
            None => return Err(DhcpDrop.Server)
        if self.state == DhcpState.Selecting
            if msg.kind != DhcpKind.Offer
                return Err(DhcpDrop.State)
            if msg.yiaddr == 0
                return Err(DhcpDrop.Lease)
            self.offered = msg.yiaddr
            self.server = Some(sid)
            self.state = DhcpState.Requesting
            self.arm(DHCP_RETX_BASE_MS, now_ms, rand)
            self.sent_at = now_ms
            return Ok(step(DhcpRecord.Keep, Some(DhcpSend.Request)))
        # Requesting, Renewing or Rebinding: an ACK or a NAK.
        if msg.kind == DhcpKind.Offer
            return Err(DhcpDrop.State)
        if self.state != DhcpState.Rebinding and not is_server(self.server, sid)
            return Err(DhcpDrop.Server)
        if msg.kind == DhcpKind.Nak
            self.forget()
            self.arm(DHCP_RETX_BASE_MS, now_ms, rand)
            return Ok(step(DhcpRecord.Clear, None))
        let lease_secs = match msg.lease_secs
            Some(s) => s
            None => return Err(DhcpDrop.Lease)
        if msg.yiaddr == 0
            return Err(DhcpDrop.Lease)
        self.bind(msg, sid, lease_secs)
        Ok(step(DhcpRecord.Write, None))

    # Run the timers up to `now_ms`: retransmits, Idle's restart, T1, T2
    # and expiry.
    pub fn tick(self: @&DhcpClient, now_ms: u64, rand: u32) -> DhcpStep
        let due = match self.deadline
            Some(d) => now_ms >= d
            None => false
        if self.state == DhcpState.Idle
            if not due
                return idle_step()
            self.next_xid()
            self.discover(now_ms, rand)
            return step(DhcpRecord.Keep, Some(DhcpSend.Discover))
        if self.state == DhcpState.Selecting
            if not due
                return idle_step()
            self.arm(self.doubled(), now_ms, rand)
            return step(DhcpRecord.Keep, Some(DhcpSend.Discover))
        if self.state == DhcpState.Requesting
            if not due
                return idle_step()
            if self.rto_ms >= DHCP_RETX_CAP_MS
                self.next_xid()
                self.discover(now_ms, rand)
                return step(DhcpRecord.Keep, Some(DhcpSend.Discover))
            self.arm(self.doubled(), now_ms, rand)
            self.sent_at = now_ms
            return step(DhcpRecord.Keep, Some(DhcpSend.Request))
        # Bound, Renewing, Rebinding: the lease timers, latest first.
        if now_ms >= self.expires_at
            self.forget()
            self.next_xid()
            self.discover(now_ms, rand)
            return step(DhcpRecord.Clear, Some(DhcpSend.Discover))
        if now_ms >= self.t2_at and self.state != DhcpState.Rebinding
            self.state = DhcpState.Rebinding
            return self.resend(DhcpSend.Rebind, now_ms, self.expires_at)
        if now_ms >= self.t1_at and self.state == DhcpState.Bound
            self.state = DhcpState.Renewing
            return self.resend(DhcpSend.Renew, now_ms, self.t2_at)
        if self.state == DhcpState.Bound or not due
            return idle_step()
        if self.state == DhcpState.Renewing
            return self.resend(DhcpSend.Renew, now_ms, self.t2_at)
        self.resend(DhcpSend.Rebind, now_ms, self.expires_at)

    # The earliest time tick() has work to do, or None when nothing is
    # timed (Idle after link down, or Bound on an infinite lease): what the
    # service's ShmWait deadline is. Only the timers this state's tick reads
    # count, so a T1 that has already moved the client to Renewing is not a
    # deadline that is always due.
    pub fn next_deadline(self: @DhcpClient) -> Option<u64>
        var at: u64 = DHCP_NEVER
        match self.deadline
            Some(d) => at = d
            None => pass
        let leased = self.state == DhcpState.Bound or self.state == DhcpState.Renewing or self.state == DhcpState.Rebinding
        if self.state == DhcpState.Bound and self.t1_at < at
            at = self.t1_at
        if (self.state == DhcpState.Bound or self.state == DhcpState.Renewing) and self.t2_at < at
            at = self.t2_at
        if leased and self.expires_at < at
            at = self.expires_at
        if at == DHCP_NEVER
            return None
        Some(at)

    # Write the payload for `send` into `out`. Nothing is written when it
    # does not fit; Renew and Rebind need a lease, Request a server.
    pub fn payload_write(self: @DhcpClient, out: [u8], send: DhcpSend) -> Result<DhcpTx, SendError>
        var opts = SEND_OPTS_LEN
        if send == DhcpSend.Request
            opts += SELECT_OPTS_LEN
        let len = DHCP_OPTIONS_OFF + opts
        if out.len < len
            return Err(SendError.TooBig)
        var ciaddr: u32 = 0
        var src: u32 = 0
        var dst = IPV4_BROADCAST
        var flags = FLAG_BROADCAST
        if send == DhcpSend.Renew or send == DhcpSend.Rebind
            let ours = match self.lease
                Some(l) => l.addr
                None => return Err(SendError.Unroutable)
            ciaddr = ours
            src = ours
            flags = 0
        var server: u32 = 0
        if send == DhcpSend.Request or send == DhcpSend.Renew
            let pinned = match self.server
                Some(s) => s
                None => return Err(SendError.Unroutable)
            server = pinned
        if send == DhcpSend.Renew
            dst = server
        for i in 0..len
            out[i] = 0
        out[0] = BOOTREQUEST
        out[1] = HTYPE_ETHERNET
        out[2] = HLEN_ETHERNET
        be32_put(out, OFF_XID, self.xid)
        be16_put(out, OFF_FLAGS, flags)
        be32_put(out, OFF_CIADDR, ciaddr)
        for i in 0..6
            out[OFF_CHADDR + i] = self.chaddr[i]
        be32_put(out, OFF_MAGIC, DHCP_MAGIC)
        var at = DHCP_OPTIONS_OFF
        out[at] = OPT_MSG_TYPE
        out[at + 1] = 1
        out[at + 2] = MSG_REQUEST
        if send == DhcpSend.Discover
            out[at + 2] = MSG_DISCOVER
        at += 3
        if send == DhcpSend.Request
            out[at] = OPT_REQUESTED_IP
            out[at + 1] = 4
            be32_put(out, at + 2, self.offered)
            out[at + 6] = OPT_SERVER_ID
            out[at + 7] = 4
            be32_put(out, at + 8, server)
            at += SELECT_OPTS_LEN
        out[at] = OPT_PARAMS
        out[at + 1] = 4
        out[at + 2] = OPT_NETMASK
        out[at + 3] = OPT_ROUTER
        out[at + 4] = OPT_DNS
        out[at + 5] = OPT_LEASE
        out[at + 6] = OPT_END
        Ok(DhcpTx { src: src, dst: dst, len: len })

    # Enter Selecting with a fresh offer slot and the first discover wait.
    fn discover(self: @&DhcpClient, now_ms: u64, rand: u32)
        self.state = DhcpState.Selecting
        self.offered = 0
        self.server = None
        self.arm(DHCP_RETX_BASE_MS, now_ms, rand)

    # Clear the record and the selection, back to Idle.
    fn forget(self: @&DhcpClient)
        self.state = DhcpState.Idle
        self.offered = 0
        self.server = None
        self.lease = None
        self.t1_at = DHCP_NEVER
        self.t2_at = DHCP_NEVER
        self.expires_at = DHCP_NEVER

    fn next_xid(self: @&DhcpClient)
        if self.xid == 0xFFFFFFFF
            self.xid = 1
        else
            self.xid += 1

    fn doubled(self: @DhcpClient) -> u64
        if self.rto_ms * 2 > DHCP_RETX_CAP_MS
            return DHCP_RETX_CAP_MS
        self.rto_ms * 2

    fn arm(self: @&DhcpClient, rto: u64, now_ms: u64, rand: u32)
        self.rto_ms = rto
        self.deadline = Some(now_ms + jittered(rto, rand))

    # Send a renew or rebind request now; the next goes after half the
    # time left until `until`.
    fn resend(self: @&DhcpClient, send: DhcpSend, now_ms: u64, until: u64) -> DhcpStep
        self.sent_at = now_ms
        self.deadline = Some(renew_deadline(now_ms, until))
        step(DhcpRecord.Keep, Some(send))

    # A valid ACK from `sid`: write the record, set T1, T2 and expiry from
    # the request it answers, enter Bound.
    fn bind(self: @&DhcpClient, msg: DhcpMsg, sid: u32, lease_secs: u32)
        self.server = Some(sid)
        self.lease = Some(DhcpLease { addr: msg.yiaddr, server: sid, netmask: msg.netmask, router: msg.router, dns: msg.dns, lease_secs: lease_secs })
        self.state = DhcpState.Bound
        self.deadline = None
        if lease_secs == DHCP_LEASE_INFINITE
            self.t1_at = DHCP_NEVER
            self.t2_at = DHCP_NEVER
            self.expires_at = DHCP_NEVER
            return
        let lease = secs_ms(lease_secs)
        var t1 = lease / 2
        var t2 = lease * 7 / 8
        let want_t1 = match msg.t1_secs
            Some(s) => secs_ms(s)
            None => t1
        let want_t2 = match msg.t2_secs
            Some(s) => secs_ms(s)
            None => t2
        if want_t1 <= want_t2 and want_t2 <= lease
            t1 = want_t1
            t2 = want_t2
        self.t1_at = self.sent_at + t1
        self.t2_at = self.sent_at + t2
        self.expires_at = self.sent_at + lease
