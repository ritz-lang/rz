# Harland netstack: the Internet checksum (AGAST #4738, RFC 1071)
#
# The one's-complement sum of big-endian 16-bit words that IPv4, ICMP and
# UDP share. A sum is carried in a u32 across calls so a pseudo-header and
# a segment add up without a copy; inet_fold folds the carries and
# complements once at the end.

# Add `data` to the running sum `acc`, as big-endian 16-bit words. An odd
# trailing byte is the high byte of a last word padded with zero. Folds as
# it goes, so the u32 never overflows however long `data` is.
pub fn inet_sum(acc: u32, data: [u8]) -> u32
    var sum = acc
    var i: i64 = 0
    while i + 1 < data.len
        sum = inet_carry(sum + (((data[i] as u32) << 8) | data[i + 1] as u32))
        i += 2
    if i < data.len
        sum = inet_carry(sum + ((data[i] as u32) << 8))
    sum

# Add one 16-bit word to the running sum.
pub fn inet_sum_word(acc: u32, word: u16) -> u32
    inet_carry(acc + word as u32)

# Fold the carries of `acc` and complement: the checksum field value.
pub fn inet_fold(acc: u32) -> u16
    let folded = inet_carry(inet_carry(acc))
    (0xFFFF - folded) as u16

# Fold the high half of `x` into the low half once.
fn inet_carry(x: u32) -> u32
    (x & 0xFFFF) + (x >> 16)

# The checksum of `data` alone.
pub fn inet_checksum(data: [u8]) -> u16
    inet_fold(inet_sum(0, data))
