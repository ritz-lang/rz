# Harland netstack: big-endian field access (AGAST #4738)
#
# Every multi-byte field on the wire is big-endian. Callers bound `at`
# against the span first; these read and write exactly the bytes named.

pub fn be16_get(s: [u8], at: i64) -> u16
    ((s[at] as u16) << 8) | s[at + 1] as u16

pub fn be32_get(s: [u8], at: i64) -> u32
    ((s[at] as u32) << 24) | ((s[at + 1] as u32) << 16) | ((s[at + 2] as u32) << 8) | s[at + 3] as u32

pub fn be16_put(s: [u8], at: i64, v: u16)
    s[at] = (v >> 8) as u8
    s[at + 1] = (v & 0xFF) as u8

pub fn be32_put(s: [u8], at: i64, v: u32)
    s[at] = (v >> 24) as u8
    s[at + 1] = ((v >> 16) & 0xFF) as u8
    s[at + 2] = ((v >> 8) & 0xFF) as u8
    s[at + 3] = (v & 0xFF) as u8
