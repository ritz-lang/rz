# sync/mbox.ritz's rings and drain, and sync/idle.ritz's kick decisions
# (AGAST #4879, SMP_USER.md §2 "The mailbox", §4 "CPU-level sleep"), on one
# thread: the CPU is whatever g_me says. The cross-CPU interleavings are
# test_smp_proto.ritz's model; the boot's `[mbox] round trip OK` line runs
# the real thing.

import ritzlib.option
import klog { klog_serial }
import arch.x86_64.cpu_map { cpu_apic_ids }
import sync.mbox { MboxMsg, KICK_VECTOR, MBOX_SLOTS, MBOX_CALL, MBOX_CALL_DONE, MBOX_PING, MBOX_PONG, MBOX_UNMAP, MBOX_UNMAP_DONE, MBOX_KERNEL_INVLPG, MBOX_KERNEL_INVLPG_DONE, MBOX_FORWARD, MBOX_RETURN, MBOX_CAP_INSERT, MBOX_CAP_INSERT_DONE, mbox_init, mbox_msg, mbox_post, mbox_take, mbox_has_work, mbox_drain, mbox_kick_irq, mbox_stray_count, mbox_moves_in_count, mbox_wait_reply }
import sync.idle { cpu_idle_begin, cpu_idle_cancel, cpu_is_idle, cpu_kick, cpu_kick_if_idle }

# The kernel hooks sync/mbox.ritz and sync/idle.ritz declare `extern`.
var g_me: i32 = 0
var g_ipis: i32 = 0
var g_ipi_dest: u32 = 0
var g_ipi_vector: u8 = 0
var g_eois: i32 = 0
var g_call_kind: u32 = 0
var g_call_status: i32 = 0

pub fn cpu_index() -> i32
    g_me

pub fn lapic_send_fixed_ipi(dest_apic: u32, vector: u8)
    g_ipis = g_ipis + 1
    g_ipi_dest = dest_apic
    g_ipi_vector = vector

pub fn lapic_eoi()
    g_eois = g_eois + 1

pub fn ap_call_run(kind: u32) -> i32
    g_call_kind = kind
    g_call_status

# mm/tlb.ritz's hook: records what it was asked, on which CPU, and answers
# g_tlb_answer.
var g_tlb_calls: i32 = 0
var g_tlb_cpu: i32 = -1
var g_tlb_kind: u32 = 0
var g_tlb_args: [4]u64
var g_tlb_answer: u64 = 0

pub fn tlb_serve(kind: u32, pml4: u64, vaddr: u64, pages: u64, mode: u64) -> u64
    g_tlb_calls = g_tlb_calls + 1
    g_tlb_cpu = g_me
    g_tlb_kind = kind
    g_tlb_args = [pml4, vaddr, pages, mode]
    g_tlb_answer

# cap/table.ritz's CAP_INSERT hook, on the owner.
var g_cap_calls: i32 = 0
var g_cap_cpu: i32 = -1
var g_cap_args: [4]u64
var g_cap_answer: u64 = 0

pub fn cap_insert_serve(pid: u64, cap_type: u32, rights: u32, object_id: u64) -> u64
    g_cap_calls = g_cap_calls + 1
    g_cap_cpu = g_me
    g_cap_args = [pid, cap_type as u64, rights as u64, object_id]
    g_cap_answer

fn fresh()
    # A hosted test has no COM1: the drop's log line goes to the ring only.
    klog_serial(false)
    mbox_init()
    g_me = 0
    g_ipis = 0
    g_eois = 0
    g_call_kind = 0
    g_call_status = 0
    g_tlb_calls = 0
    g_tlb_cpu = -1
    g_tlb_kind = 0
    g_tlb_args = [0, 0, 0, 0]
    g_tlb_answer = 0
    var i: i32 = 0
    while i < 4
        cpu_apic_ids[i] = 10 + (i as u32)
        i = i + 1

fn ping(n: u64) -> MboxMsg
    var m: MboxMsg = mbox_msg(MBOX_PING)
    m.arg[0] = n
    m

# The next message in `cpu`'s box, or one of kind 0 if it is empty.
fn take(cpu: i32) -> MboxMsg
    match mbox_take(cpu)
        Some(m) => m
        None => MboxMsg { kind: 0, from: 0, flags: 0, pid: 0, arg: [0, 0, 0, 0, 0] }

[[test]]
fn test_empty_box_has_nothing() -> i32
    fresh()
    if take(1).kind != 0
        return 1
    if mbox_has_work(1)
        return 2
    0

[[test]]
fn test_post_kicks_the_owner_and_take_returns_the_body() -> i32
    fresh()
    var m: MboxMsg = mbox_msg(MBOX_CALL)
    m.flags = 3
    m.pid = 77
    m.arg[0] = 5
    m.arg[4] = 9
    mbox_post(2, m)
    if g_ipis != 1 or g_ipi_dest != 12 or g_ipi_vector != KICK_VECTOR
        return 1
    if not mbox_has_work(2) or mbox_has_work(1)
        return 2
    let got: MboxMsg = take(2)
    if got.kind != MBOX_CALL or got.from != 0 or got.flags != 3 or got.pid != 77
        return 3
    if got.arg[0] != 5 or got.arg[4] != 9
        return 4
    if mbox_has_work(2) or take(2).kind != 0
        return 5
    0

[[test]]
fn test_post_to_this_cpu_sends_no_ipi() -> i32
    fresh()
    g_me = 1
    mbox_post(1, ping(4))
    if g_ipis != 0
        return 1
    if take(1).arg[0] != 4
        return 2
    0

# 16 posts fill the ring exactly, and 40 more in batches of 10 wrap it
# three times: every body comes back once, in order.
[[test]]
fn test_ring_is_fifo_across_wraps() -> i32
    fresh()
    var n: u64 = 0
    while n < MBOX_SLOTS
        mbox_post(1, ping(n))
        n = n + 1
    var want: u64 = 0
    while want < MBOX_SLOTS
        if take(1).arg[0] != want
            return 1
        want = want + 1
    var batch: i32 = 0
    while batch < 4
        var k: i32 = 0
        while k < 10
            mbox_post(1, ping(n))
            n = n + 1
            k = k + 1
        k = 0
        while k < 10
            let got: MboxMsg = take(1)
            if got.kind != MBOX_PING or got.arg[0] != want
                return 2
            want = want + 1
            k = k + 1
        batch = batch + 1
    if take(1).kind != 0
        return 3
    0

# The drain answers a PING with a PONG echoing it and a CALL with a
# CALL_DONE carrying the request id and the callee's status, each to the
# sender's box.
[[test]]
fn test_drain_answers_ping_and_call() -> i32
    fresh()
    mbox_post(1, ping(42))
    var call: MboxMsg = mbox_msg(MBOX_CALL)
    call.arg[0] = 7
    call.arg[1] = 1
    mbox_post(1, call)
    g_me = 1
    g_call_status = -1
    g_ipis = 0
    mbox_drain()
    if mbox_has_work(1)
        return 1
    if g_ipis != 2 or g_ipi_dest != 10
        return 2
    let pong: MboxMsg = take(0)
    if pong.kind != MBOX_PONG or pong.from != 1 or pong.arg[0] != 42
        return 3
    let done: MboxMsg = take(0)
    if done.kind != MBOX_CALL_DONE or done.from != 1 or done.arg[0] != 7
        return 4
    if g_call_kind != 1 or done.arg[1] as i64 != -1
        return 5
    0

# The owner's drain serves an UNMAP (SMP_USER.md §3): mm/tlb.ritz's hook gets
# the PML4, VA, page count and mode on the owner, and the UNMAP_DONE that
# goes back to the sender's box echoes the request id and the pid and
# carries the hook's count of leaves changed.
[[test]]
fn test_drain_serves_unmap_and_replies_done() -> i32
    fresh()
    var req: MboxMsg = mbox_msg(MBOX_UNMAP)
    req.pid = 6
    req.arg[0] = 31
    req.arg[1] = 0x7000
    req.arg[2] = 0x10000000000
    req.arg[3] = 3
    req.arg[4] = 1
    mbox_post(2, req)
    g_me = 2
    g_tlb_answer = 3
    g_ipis = 0
    mbox_drain()
    if g_tlb_calls != 1 or g_tlb_cpu != 2 or g_tlb_kind != MBOX_UNMAP
        return 1
    if g_tlb_args[0] != 0x7000 or g_tlb_args[1] != 0x10000000000 or g_tlb_args[2] != 3 or g_tlb_args[3] != 1
        return 2
    if g_ipis != 1 or g_ipi_dest != 10
        return 3
    let done: MboxMsg = take(0)
    if done.kind != MBOX_UNMAP_DONE or done.from != 2 or done.pid != 6
        return 4
    if done.arg[0] != 31 or done.arg[1] != 3
        return 5
    if take(0).kind != 0
        return 6
    0

# A KERNEL_INVLPG is served the same way and acknowledged with
# KERNEL_INVLPG_DONE carrying its id.
[[test]]
fn test_drain_serves_kernel_invlpg_and_acks() -> i32
    fresh()
    var req: MboxMsg = mbox_msg(MBOX_KERNEL_INVLPG)
    req.arg[0] = 8
    req.arg[2] = 0xFFFF808000001000
    mbox_post(3, req)
    g_me = 3
    mbox_drain()
    if g_tlb_calls != 1 or g_tlb_cpu != 3 or g_tlb_kind != MBOX_KERNEL_INVLPG
        return 1
    if g_tlb_args[1] != 0xFFFF808000001000 or g_tlb_args[2] != 0
        return 2
    let ack: MboxMsg = take(0)
    if ack.kind != MBOX_KERNEL_INVLPG_DONE or ack.from != 3 or ack.arg[0] != 8
        return 3
    0

# The owner's drain serves a CAP_INSERT (AGAST #4881): cap/table.ritz's hook
# writes the entry on the owner, and CAP_INSERT_DONE goes back to the sender
# with the request id, the pid and the packed handle.
[[test]]
fn test_drain_serves_cap_insert_and_replies_the_handle() -> i32
    fresh()
    g_cap_calls = 0
    var req: MboxMsg = mbox_msg(MBOX_CAP_INSERT)
    req.pid = 9
    req.arg[0] = 44
    req.arg[1] = 9
    req.arg[2] = 3
    req.arg[3] = 0xAB
    mbox_post(3, req)
    g_me = 3
    g_cap_answer = 0x500000002
    mbox_drain()
    if g_cap_calls != 1 or g_cap_cpu != 3
        return 1
    if g_cap_args[0] != 9 or g_cap_args[1] != 9 or g_cap_args[2] != 3 or g_cap_args[3] != 0xAB
        return 2
    let done: MboxMsg = take(0)
    if done.kind != MBOX_CAP_INSERT_DONE or done.from != 3 or done.pid != 9
        return 3
    if done.arg[0] != 44 or done.arg[1] != 0x500000002
        return 4
    0

# A reply wait (the BSP's, for CAP_INSERT_DONE) keeps a FORWARD or RETURN it
# meets as the move it is, drops a late reply of its kind, and returns its
# own reply.
[[test]]
fn test_reply_wait_keeps_moves_and_drops_late_replies() -> i32
    fresh()
    g_me = 3
    mbox_post(0, mbox_msg(MBOX_FORWARD))
    var late: MboxMsg = mbox_msg(MBOX_CAP_INSERT_DONE)
    late.arg[0] = 6
    mbox_post(0, late)
    mbox_post(0, mbox_msg(MBOX_RETURN))
    var mine: MboxMsg = mbox_msg(MBOX_CAP_INSERT_DONE)
    mine.arg[0] = 7
    mine.arg[1] = 0x100000004
    mbox_post(0, mine)
    g_me = 0
    let moves: u64 = mbox_moves_in_count(0)
    let got: MboxMsg = mbox_wait_reply(MBOX_CAP_INSERT_DONE, 3, 7)
    if got.arg[0] != 7 or got.arg[1] != 0x100000004
        return 1
    if mbox_moves_in_count(0) != moves + 2
        return 2
    if mbox_stray_count(0) != 1 or mbox_has_work(0)
        return 3
    0

# A reply that reaches the drain had no waiter: dropped and counted.
[[test]]
fn test_drain_drops_a_late_reply() -> i32
    fresh()
    g_me = 1
    mbox_post(0, mbox_msg(MBOX_PONG))
    mbox_post(0, mbox_msg(MBOX_UNMAP_DONE))
    mbox_post(0, mbox_msg(MBOX_KERNEL_INVLPG_DONE))
    g_me = 0
    g_ipis = 0
    mbox_drain()
    if mbox_stray_count(0) != 3 or g_ipis != 0 or g_tlb_calls != 0
        return 1
    if mbox_has_work(0)
        return 2
    0

# The kick's IRQ sends EOI and marks work pending; only the drain clears it.
[[test]]
fn test_kick_irq_marks_work_until_drained() -> i32
    fresh()
    g_me = 2
    mbox_kick_irq()
    if g_eois != 1 or not mbox_has_work(2)
        return 1
    mbox_drain()
    if mbox_has_work(2)
        return 2
    0

# A waker kicks only a CPU that announced idle, and never itself.
[[test]]
fn test_kick_if_idle_follows_the_announce() -> i32
    fresh()
    g_me = 3
    cpu_idle_begin()
    if not cpu_is_idle(3)
        return 1
    g_me = 0
    cpu_kick_if_idle(3)
    if g_ipis != 1 or g_ipi_dest != 13 or g_ipi_vector != KICK_VECTOR
        return 2
    g_me = 3
    cpu_idle_cancel()
    g_me = 0
    cpu_kick_if_idle(3)
    if cpu_is_idle(3) or g_ipis != 1
        return 3
    cpu_kick(0)
    if g_ipis != 1
        return 4
    0
