# Harland device capability tests (AGAST #4716)
#
# docs/RING1_DRIVER.md, Grants: only the kernel grants CAP_TYPE_IRQ and
# CAP_TYPE_MMIO, to the process it spawned for the device; CapGrant of
# either is Errno.Perm; CapRevoke drops only the caller's handle; and
# CAP_RIGHT_PUBLISH is bit 4096.
#
# Like test_cap_policy.ritz, these call the table directly and never call
# cap_table_init (it prints through the serial port). Pids are unique per
# test because the registry outlives each test function.

import syscall.errno { Errno }
import cap.types { CapHandle, CapEntry, CAP_TYPE_IRQ, CAP_TYPE_MMIO, CAP_TYPE_SHM, CAP_TYPE_POWER, CAP_TYPE_CHANNEL, CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_GRANT, CAP_RIGHT_LIST, CAP_RIGHT_PUBLISH, CAP_RIGHT_ALL, cap_handle_init }
import cap.table { CapTable, cap_table_alloc, cap_table_get, cap_table_free_pid, cap_table_lookup, cap_grant, cap_kernel_grant, cap_irq_owner }
import cap.syscall { sys_cap_grant, sys_cap_revoke }
import cap.selftest { cap_device_selftest }
import proc.waitset { shm_latch_held }

# cap/table.ritz declares syscall/runtime/driver.ritz driver_quiesce_object
# (#4733) for the last IRQ handle dropped; on the host no device is bound,
# so there is nothing to quiesce.
pub fn driver_quiesce_object(pid: u32, object_id: u64)
    return

# mm/pmm.ritz, proc/table.ritz and fs/syscall.ritz (reached through the cap
# table's shm and page-table code) declare the kernel's
# arch/x86_64/percpu.ritz cpu_index, and proc/table.ritz sync/idle.ritz's
# cpu_kick_if_idle (AGAST #4879). On the host there is one CPU, never idle.
pub fn cpu_index() -> i32
    0

pub fn cpu_kick_if_idle(cpu: i32)
    return

# mm/shm.ritz unmaps through mm/tlb.ritz (AGAST #4880), which posts to
# sync/mbox.ritz, and that declares the kernel's apic.ritz IPI and EOI and
# apcall.ritz ap_call_run. On the host every process is on CPU 0, so every
# unmap is local and none of them is ever called.
pub fn lapic_send_fixed_ipi(dest_apic: u32, vector: u8)
    return

pub fn lapic_eoi()
    return

pub fn ap_call_run(kind: u32) -> i32
    -1

const IRQ_OBJECT: u64 = 0x2B
const MMIO_OBJECT: u64 = 0xFEB00000
const SHM_OBJECT: u64 = 7

# A handle packed as the syscalls take it: index | generation << 32.
fn pack(h: CapHandle) -> u64
    return (h.index as u64) | ((h.generation as u64) << 32)

fn holds(pid: u32, cap_type: u8, object_id: u64) -> bool
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return false
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*table).entries[i]
        if (*entry).cap_type == cap_type and (*entry).object_id == object_id
            return true
        i = i + 1
    return false

# PUBLISH is the next right after LIST.
[[test]]
fn test_publish_right_is_4096() -> i32
    if CAP_RIGHT_PUBLISH != 4096
        return 1
    if CAP_RIGHT_PUBLISH != CAP_RIGHT_LIST << 1
        return 2
    return 0

# The kernel grants an IRQ cap by object id and records its owner.
[[test]]
fn test_kernel_grant_irq_records_owner() -> i32
    if cap_table_alloc(60) == 0 as *CapTable
        return 1
    if cap_irq_owner(IRQ_OBJECT) != 0
        return 2
    let h: CapHandle = cap_kernel_grant(60, CAP_TYPE_IRQ, CAP_RIGHT_READ, IRQ_OBJECT)
    if h.index == 0xFFFFFFFF
        return 3
    let entry: *CapEntry = cap_table_lookup(cap_table_get(60), h)
    if entry == 0 as *CapEntry
        return 4
    if (*entry).cap_type != CAP_TYPE_IRQ or (*entry).object_id != IRQ_OBJECT
        return 5
    if cap_irq_owner(IRQ_OBJECT) != 60
        return 6
    return 0

# Only IRQ, MMIO and SHM are kernel-granted by object id, and only into a
# process that has a table.
[[test]]
fn test_kernel_grant_refuses_other_types() -> i32
    if cap_table_alloc(61) == 0 as *CapTable
        return 1
    if cap_kernel_grant(61, CAP_TYPE_POWER, CAP_RIGHT_ALL, 0).index != 0xFFFFFFFF
        return 2
    if cap_kernel_grant(61, CAP_TYPE_CHANNEL, CAP_RIGHT_ALL, 0).index != 0xFFFFFFFF
        return 3
    if cap_kernel_grant(61, CAP_TYPE_MMIO, CAP_RIGHT_READ, MMIO_OBJECT).index == 0xFFFFFFFF
        return 4
    if cap_kernel_grant(61, CAP_TYPE_SHM, CAP_RIGHT_READ, SHM_OBJECT).index == 0xFFFFFFFF
        return 5
    if cap_kernel_grant(9999, CAP_TYPE_MMIO, CAP_RIGHT_READ, MMIO_OBJECT).index != 0xFFFFFFFF
        return 6
    return 0

# One device, one IRQ owner: a second process is refused.
[[test]]
fn test_kernel_grant_irq_second_owner_refused() -> i32
    if cap_table_alloc(62) == 0 as *CapTable or cap_table_alloc(63) == 0 as *CapTable
        return 1
    if cap_kernel_grant(62, CAP_TYPE_IRQ, CAP_RIGHT_READ, 0x2C).index == 0xFFFFFFFF
        return 2
    if cap_kernel_grant(63, CAP_TYPE_IRQ, CAP_RIGHT_READ, 0x2C).index != 0xFFFFFFFF
        return 3
    if holds(63, CAP_TYPE_IRQ, 0x2C)
        return 4
    if cap_irq_owner(0x2C) != 62
        return 5
    return 0

# CapGrant of a ring-3-held MMIO handle is Errno.Perm, even with GRANT.
[[test]]
fn test_cap_grant_refuses_mmio() -> i32
    if cap_table_alloc(64) == 0 as *CapTable or cap_table_alloc(65) == 0 as *CapTable
        return 1
    let h: CapHandle = cap_kernel_grant(64, CAP_TYPE_MMIO, CAP_RIGHT_ALL, MMIO_OBJECT)
    if h.index == 0xFFFFFFFF
        return 2
    if sys_cap_grant(64, pack(h), 65, CAP_RIGHT_ALL) != Errno.Perm as i64
        return 3
    if holds(65, CAP_TYPE_MMIO, MMIO_OBJECT)
        return 4
    return 0

# The kernel's own cap_grant refuses a device cap too, not just the syscall.
[[test]]
fn test_table_grant_refuses_device_caps() -> i32
    if cap_table_alloc(74) == 0 as *CapTable or cap_table_alloc(75) == 0 as *CapTable
        return 1
    let from: *CapTable = cap_table_get(74)
    let to: *CapTable = cap_table_get(75)
    let bar: CapHandle = cap_kernel_grant(74, CAP_TYPE_MMIO, CAP_RIGHT_ALL, MMIO_OBJECT)
    let irq: CapHandle = cap_kernel_grant(74, CAP_TYPE_IRQ, CAP_RIGHT_ALL, 0x30)
    if bar.index == 0xFFFFFFFF or irq.index == 0xFFFFFFFF
        return 2
    if cap_grant(from, cap_handle_init(bar.index, bar.generation), to, CAP_RIGHT_ALL).index != 0xFFFFFFFF
        return 3
    if cap_grant(from, cap_handle_init(irq.index, irq.generation), to, CAP_RIGHT_ALL).index != 0xFFFFFFFF
        return 4
    return 0

# CapGrant of an IRQ handle is Errno.Perm, even with GRANT.
[[test]]
fn test_cap_grant_refuses_irq() -> i32
    if cap_table_alloc(66) == 0 as *CapTable or cap_table_alloc(67) == 0 as *CapTable
        return 1
    let h: CapHandle = cap_kernel_grant(66, CAP_TYPE_IRQ, CAP_RIGHT_ALL, 0x2D)
    if h.index == 0xFFFFFFFF
        return 2
    if sys_cap_grant(66, pack(h), 67, CAP_RIGHT_ALL) != Errno.Perm as i64
        return 3
    if holds(67, CAP_TYPE_IRQ, 0x2D)
        return 4
    if cap_irq_owner(0x2D) != 66
        return 5
    return 0

# The refusal is by type: a SHM handle with GRANT still grants.
[[test]]
fn test_cap_grant_still_grants_shm() -> i32
    if cap_table_alloc(68) == 0 as *CapTable or cap_table_alloc(69) == 0 as *CapTable
        return 1
    let h: CapHandle = cap_kernel_grant(68, CAP_TYPE_SHM, CAP_RIGHT_READ | CAP_RIGHT_GRANT, SHM_OBJECT)
    if h.index == 0xFFFFFFFF
        return 2
    if sys_cap_grant(68, pack(h), 69, CAP_RIGHT_READ) < 0
        return 3
    if not holds(69, CAP_TYPE_SHM, SHM_OBJECT)
        return 4
    return 0

# CapRevoke drops the caller's copy and leaves the other holder's.
[[test]]
fn test_revoke_drops_only_callers_copy() -> i32
    if cap_table_alloc(70) == 0 as *CapTable or cap_table_alloc(71) == 0 as *CapTable
        return 1
    let a: CapHandle = cap_kernel_grant(70, CAP_TYPE_SHM, CAP_RIGHT_READ | CAP_RIGHT_WRITE, SHM_OBJECT)
    let b: CapHandle = cap_kernel_grant(71, CAP_TYPE_SHM, CAP_RIGHT_READ | CAP_RIGHT_WRITE, SHM_OBJECT)
    if a.index == 0xFFFFFFFF or b.index == 0xFFFFFFFF
        return 2
    if sys_cap_revoke(70, pack(a)) != 0
        return 3
    if holds(70, CAP_TYPE_SHM, SHM_OBJECT)
        return 4
    if not holds(71, CAP_TYPE_SHM, SHM_OBJECT)
        return 5
    if sys_cap_revoke(70, pack(a)) != Errno.BadF as i64
        return 6
    return 0

# A shm handle brings its holder's latch for the object, made when the
# handle is inserted, not when the object is mapped (#4727): one per
# (object, pid), dropped with that pid's last handle and with its table.
[[test]]
fn test_shm_handle_carries_one_latch() -> i32
    if cap_table_alloc(76) == 0 as *CapTable or cap_table_alloc(77) == 0 as *CapTable
        return 1
    let a: CapHandle = cap_kernel_grant(76, CAP_TYPE_SHM, CAP_RIGHT_READ, SHM_OBJECT)
    let b: CapHandle = cap_kernel_grant(76, CAP_TYPE_SHM, CAP_RIGHT_READ, SHM_OBJECT)
    if a.index == 0xFFFFFFFF or b.index == 0xFFFFFFFF or not shm_latch_held(SHM_OBJECT, 76)
        return 2
    # Another type for the same id makes none.
    cap_kernel_grant(77, CAP_TYPE_MMIO, CAP_RIGHT_READ, SHM_OBJECT)
    if shm_latch_held(SHM_OBJECT, 77)
        return 3
    # The latch outlives the first revoke and goes with the last.
    if sys_cap_revoke(76, pack(a)) != 0 or not shm_latch_held(SHM_OBJECT, 76)
        return 4
    if sys_cap_revoke(76, pack(b)) != 0 or shm_latch_held(SHM_OBJECT, 76)
        return 5
    # A process that exits holding the handle loses its latch with its table.
    cap_kernel_grant(77, CAP_TYPE_SHM, CAP_RIGHT_READ, SHM_OBJECT)
    if not shm_latch_held(SHM_OBJECT, 77)
        return 6
    cap_table_free_pid(77)
    if shm_latch_held(SHM_OBJECT, 77)
        return 7
    cap_table_free_pid(76)
    return 0

# The IRQ owner is cleared when it revokes its last handle for the device,
# not before.
[[test]]
fn test_revoke_last_irq_clears_owner() -> i32
    if cap_table_alloc(72) == 0 as *CapTable
        return 1
    let a: CapHandle = cap_kernel_grant(72, CAP_TYPE_IRQ, CAP_RIGHT_READ, 0x2E)
    let b: CapHandle = cap_kernel_grant(72, CAP_TYPE_IRQ, CAP_RIGHT_READ, 0x2E)
    if a.index == 0xFFFFFFFF or b.index == 0xFFFFFFFF
        return 2
    if sys_cap_revoke(72, pack(a)) != 0
        return 3
    if cap_irq_owner(0x2E) != 72
        return 4
    if sys_cap_revoke(72, pack(b)) != 0
        return 5
    if cap_irq_owner(0x2E) != 0
        return 6
    return 0

# A process that exits (its table freed) no longer owns its IRQ.
[[test]]
fn test_table_free_clears_irq_owner() -> i32
    if cap_table_alloc(73) == 0 as *CapTable
        return 1
    if cap_kernel_grant(73, CAP_TYPE_IRQ, CAP_RIGHT_READ, 0x2F).index == 0xFFFFFFFF
        return 2
    if cap_table_free_pid(73) != 0
        return 3
    if cap_irq_owner(0x2F) != 0
        return 4
    return 0

# The "cap-device" boot self-test passes hosted too.
[[test]]
fn test_cap_device_selftest() -> i32
    return cap_device_selftest()
