# Host checks for the plain MSI capability layout (AGAST #4885): where the
# address, data and mask registers sit for each Message Control shape, and
# the control value that enables exactly one message. drivers/msix.ritz
# programs a device through these offsets; a wrong one writes the vector
# into the upper address dword, or enables more messages than the driver
# set up.

import drivers.msi_cap {
    MsiLayout, msi_layout, msi_ctrl_one, msi_ctrl_off, PCI_CAP_MSI
}

[[test]]
fn test_msi_cap_id_is_05() -> i32
    if PCI_CAP_MSI != 0x05
        return 1
    0

[[test]]
fn test_msi_layout_32_bit_puts_data_at_8() -> i32
    # X99's HBA: message control 0x0000, 1 message, 32-bit, no masking.
    let l: MsiLayout = msi_layout(0x0000)
    if l.is64
        return 1
    if l.data != 0x08
        return 2
    if l.mask != 0
        return 3
    0

[[test]]
fn test_msi_layout_64_bit_has_upper_address_and_data_at_12() -> i32
    # Bit 7: 64-bit address capable (ich9-ahci sets it).
    let l: MsiLayout = msi_layout(0x0080)
    if not l.is64
        return 1
    if l.data != 0x0C
        return 2
    if l.mask != 0
        return 3
    0

[[test]]
fn test_msi_layout_per_vector_masking_mask_register() -> i32
    # Bit 8: per-vector masking; mask bits follow the data register.
    let l32: MsiLayout = msi_layout(0x0100)
    if l32.mask != 0x0C
        return 1
    let l64: MsiLayout = msi_layout(0x0180)
    if l64.mask != 0x10
        return 2
    0

[[test]]
fn test_msi_ctrl_one_enables_a_single_message() -> i32
    # MMC = 4 (16 requested), MME already 2 by firmware, 64-bit, disabled.
    let ctrl: u16 = 0x0080 | 0x0008 | 0x0020
    let on: u16 = msi_ctrl_one(ctrl)
    if (on & 0x0001) == 0
        return 1
    # Multiple Message Enable (bits 6:4) is 0: one message.
    if (on & 0x0070) != 0
        return 2
    # The read-only capability bits are written back as read.
    if (on & 0x008E) != 0x0088
        return 3
    0

[[test]]
fn test_msi_ctrl_off_clears_enable_only() -> i32
    let off: u16 = msi_ctrl_off(0x0081)
    if off != 0x0080
        return 1
    0
