# Harland u16 counters that wrap by design (AGAST #4548)
#
# Since LARB R63 (AGAST #3488) plain `+`/`-` stop the program on overflow, so
# a counter that must roll over from 0xFFFF to 0 is spelled `+%`/`-%`:
#
# - the virtio avail-ring idx and the driver's last_used_idx are free-running
#   u16s (virtio 1.x §2.7: only `idx % num` selects the slot); the 65,536th
#   submission or completion used to stop the kernel;
# - the IPv4 Identification field (ip_packet_id) wraps per RFC 791/6864;
#   every packet the kernel sends steps it.
#
# The rings are built in local memory: vq_submit, vq_get_used and
# vq_get_used_len only read and write the ring, never the device.

import drivers.virtio.common { Virtqueue, VringAvail, VringUsed, vq_submit, vq_get_used, vq_get_used_len }
import net.ip { ip_init, ip_build_header }

# net.arp and net.eth call the NIC through these externs (net/stack.ritz
# defines them in the kernel); building a header never sends.
pub fn net_get_mac(mac_out: *u8)
    return

pub fn net_send(data: *u8, len: u32) -> i32
    0

var g_avail: VringAvail
var g_used: VringUsed

fn ring_at(vq: *Virtqueue, num: u16)
    vq.num = num
    vq.avail = @g_avail
    vq.used = @g_used

[[test]]
fn test_avail_idx_wraps() -> i32
    var vq: Virtqueue
    ring_at(@vq, 8)
    g_avail.idx = 0xFFFF
    vq_submit(@vq, 3)
    assert g_avail.idx == 0
    assert g_avail.ring[7] == 3    # 0xFFFF % 8
    0

[[test]]
fn test_last_used_idx_wraps() -> i32
    var vq: Virtqueue
    ring_at(@vq, 8)
    vq.last_used_idx = 0xFFFF
    g_used.idx = 0
    g_used.ring[7].id = 5
    g_used.ring[7].len = 99
    assert vq_get_used(@vq) == 5
    assert vq.last_used_idx == 0
    # The previous slot is 0xFFFF % 8, reached across the wrap.
    assert vq_get_used_len(@vq) == 99
    0

[[test]]
fn test_ip_packet_id_wraps() -> i32
    ip_init()
    var buf: [20]u8
    var dst: [4]u8
    var i: i32 = 0
    # The id starts at 1; 65,536 headers take it past 0xFFFF and back to 1.
    while i < 65536
        ip_build_header(@buf[0], @dst[0], 17, 0)
        i = i + 1
    ip_build_header(@buf[0], @dst[0], 17, 0)
    assert buf[4] == 0
    assert buf[5] == 1
    0
