# Harland - multiboot2 cmdline boot options (AGAST #1887)
#
# GRUB boots have no boot volume for the loader's \harland\<option> markers,
# so the kernel reads the same options as words on the multiboot2 cmdline:
# `multiboot2 /boot/harland.elf boot-test` puts it in boot-test mode. A word
# only counts whole: "boot-tests" or "xboot-test" set nothing.

import boot_options { mb2_cmdline_flags, cmdline_has_word }
import boot_abi.handoff { HARLAND_BOOT_FLAG_BOOT_TEST, HARLAND_BOOT_FLAG_KLOG_DUMP }

# A multiboot2 info block: 8-byte header, then tags, each 8-byte aligned
var g_mbi: [32]u64

fn put_u32(off: u64, v: u32)
    let p: *u32 = (@g_mbi as u64 + off) as *u32
    *p = v

# Lay out [header][cmdline tag holding `cmdline`][end tag]; returns the address.
fn build_mbi(cmdline: *u8) -> u64
    var i: i32 = 0
    while i < 32
        g_mbi[i] = 0
        i = i + 1
    var n: u64 = 0
    while *(cmdline + n as i64) != 0
        n = n + 1
    let tag_size: u64 = 8 + n + 1
    put_u32(8, 1)
    put_u32(12, tag_size as u32)
    var k: u64 = 0
    while k <= n
        let dst: *u8 = (@g_mbi as u64 + 16 + k) as *u8
        *dst = *(cmdline + k as i64)
        k = k + 1
    let end_off: u64 = (8 + tag_size + 7) & ~7
    put_u32(end_off, 0)
    put_u32(end_off + 4, 8)
    put_u32(0, (end_off + 8) as u32)
    return @g_mbi as u64

[[test]]
fn test_boot_test_word_sets_the_flag() -> i32
    if mb2_cmdline_flags(build_mbi(c"boot-test")) != HARLAND_BOOT_FLAG_BOOT_TEST
        return 1
    if mb2_cmdline_flags(build_mbi(c"/boot/harland.elf boot-test")) != HARLAND_BOOT_FLAG_BOOT_TEST
        return 2
    return 0

[[test]]
fn test_both_words_set_both_flags() -> i32
    let want: u32 = HARLAND_BOOT_FLAG_BOOT_TEST | HARLAND_BOOT_FLAG_KLOG_DUMP
    if mb2_cmdline_flags(build_mbi(c"klog-dump  boot-test")) != want
        return 1
    return 0

[[test]]
fn test_partial_words_set_nothing() -> i32
    if mb2_cmdline_flags(build_mbi(c"boot-tests xboot-test boot")) != 0
        return 1
    if mb2_cmdline_flags(build_mbi(c"")) != 0
        return 2
    return 0

[[test]]
fn test_no_info_block_sets_nothing() -> i32
    if mb2_cmdline_flags(0) != 0
        return 1
    return 0

[[test]]
fn test_cmdline_has_word() -> i32
    if not cmdline_has_word(c"a boot-test b", c"boot-test")
        return 1
    if cmdline_has_word(c"a boot-tes", c"boot-test")
        return 2
    if cmdline_has_word(c"boot-test-x", c"boot-test")
        return 3
    return 0
