# Host tests of the e1000e Nic (AGAST #4892; harland docs/E1000E.md "Tests")
#
# src/e1000e.ritz over a register model of the 82574L: BAR0 is a host
# array, and the writes that start a handshake answer it as the device
# does. CTRL.GIO_MASTER_DISABLE clears STATUS.GIO_MASTER_EN, CTRL.RST
# self-clears, MDIC completes at once with ready (or the error bit for a
# PHY address other than 1), ICR is write-1-to-clear and IMS/IMC set and
# clear the mask. Each handshake can be held stuck to test its timeout.
# The device's DMA is the tests': device_receive writes a frame into the
# buffer an RX descriptor names and sets DD, device_send sets DD on the TX
# descriptors up to TDT. The IOVAs are arbitrary numbers distinct from the
# CPU addresses, so a mix-up of the two names no buffer.

import driver_abi.boot { DriverBoot }
import driver_abi.link { NetInfo, NETDEV_TYPE_E1000E, ETH_HEADER_LEN }
import nic.nic { Nic, RxFrame, TxFrame, DmaRun }
import nic.e1000e
import ritzlib.span
import ritzlib.strview { StrView }

# ---------------------------------------------------------------------------
# The register model
# ---------------------------------------------------------------------------

# BAR0's 128 KiB, a word per register.
var g_reg: [32768]u32
var g_phy: [32]u16
# Handshakes held stuck, and MDIC's error bit forced.
var g_stuck_master: bool
var g_stuck_rst: bool
var g_stuck_mdic: bool
var g_stuck_own: bool
var g_mdic_error: bool
# Every write in order, and the TDT/RDT writes counted.
var g_log_off: [4096]u32
var g_log_val: [4096]u32
var g_log_len: u32
var g_tdt_writes: u32
var g_rdt_writes: u32
# The PHY addresses MDIC was asked for.
var g_mdic_addr_bad: bool
# Reads of the register held stuck, for the timeout bounds.
var g_reads: u64

struct Model
    unused: u32

fn reg(off: u32) -> u32
    g_reg[off / 4]

fn set_reg(off: u32, v: u32)
    g_reg[off / 4] = v

impl Regs for Model
    fn rd(self: @Model, off: u32) -> u32
        g_reads = g_reads + 1
        reg(off)

    fn wr(self: @&Model, off: u32, v: u32)
        if g_log_len < 4096
            g_log_off[g_log_len] = off
            g_log_val[g_log_len] = v
            g_log_len = g_log_len + 1
        if off == REG_CTRL
            var c: u32 = v
            if (c & CTRL_GIO_MASTER_DISABLE) != 0 and not g_stuck_master
                set_reg(REG_STATUS, reg(REG_STATUS) & (0xFFFFFFFF ^ STATUS_GIO_MASTER_EN))
            if (c & CTRL_RST) != 0 and not g_stuck_rst
                # The reset clears itself and GIO_MASTER_DISABLE, and bus
                # mastering is back on.
                c = c & (0xFFFFFFFF ^ (CTRL_RST | CTRL_GIO_MASTER_DISABLE))
                set_reg(REG_STATUS, reg(REG_STATUS) | STATUS_GIO_MASTER_EN)
            set_reg(REG_CTRL, c)
        else if off == REG_ICR
            set_reg(REG_ICR, reg(REG_ICR) & (0xFFFFFFFF ^ v))
        else if off == REG_IMS
            set_reg(REG_IMS, reg(REG_IMS) | v)
        else if off == REG_IMC
            set_reg(REG_IMS, reg(REG_IMS) & (0xFFFFFFFF ^ v))
        else if off == REG_MDIC
            set_reg(REG_MDIC, mdic_answer(v))
        else if off == REG_EXTCNF_CTRL
            if g_stuck_own
                set_reg(off, v & (0xFFFFFFFF ^ EXTCNF_MDIO_SW_OWNERSHIP))
            else
                set_reg(off, v)
        else
            if off == REG_TDT
                g_tdt_writes = g_tdt_writes + 1
            if off == REG_RDT
                g_rdt_writes = g_rdt_writes + 1
            set_reg(off, v)

# MDIC after the driver wrote `v`: ready, with the register's data on a
# read, unless it is held busy; the error bit for another PHY address.
fn mdic_answer(v: u32) -> u32
    if g_stuck_mdic
        return v & (0xFFFFFFFF ^ MDIC_READY)
    let phy: u32 = (v >> MDIC_PHY_SHIFT) & 0x1F
    let r: u32 = (v >> MDIC_REG_SHIFT) & 0x1F
    if phy != PHY_ADDR
        g_mdic_addr_bad = true
        return v | MDIC_READY | MDIC_ERROR
    if g_mdic_error
        return v | MDIC_READY | MDIC_ERROR
    if (v & MDIC_OP_READ) != 0
        return (v & 0xFFFF0000) | (g_phy[r] as u32) | MDIC_READY
    g_phy[r] = (v & 0xFFFF) as u16
    v | MDIC_READY

# The 82574L as QEMU powers it up with mac=52:54:00:12:34:56: bus
# mastering on, link up at full duplex, the address loaded with AV, a
# pending LSC, and stale values where the driver must write its own.
fn model_reset()
    for i in 0..32768
        g_reg[i] = 0
    for i in 0..32
        g_phy[i] = 0
    g_phy[MII_BMCR] = 0x1140
    set_reg(REG_STATUS, STATUS_GIO_MASTER_EN | STATUS_LU | 1)
    set_reg(REG_RAL0, 0x12005452)
    set_reg(REG_RAH0, 0x5634 | RAH_AV)
    set_reg(REG_ICR, ICR_LSC)
    set_reg(REG_IMS, 0xFF)
    set_reg(REG_ITR, 0x1234)
    set_reg(REG_RDTR, 7)
    set_reg(REG_RADV, 9)
    for i in 0..MTA_WORDS
        set_reg(REG_MTA + 4 * i, 0xFFFFFFFF)
    g_stuck_master = false
    g_stuck_rst = false
    g_stuck_mdic = false
    g_stuck_own = false
    g_mdic_error = false
    g_mdic_addr_bad = false
    g_log_len = 0
    g_tdt_writes = 0
    g_rdt_writes = 0
    g_reads = 0

# The index of the first write to `off` with `v` at or after `from`, or
# the log length when there is none.
fn find_write(off: u32, v: u32, from: u32) -> u32
    var i: u32 = from
    while i < g_log_len
        if g_log_off[i] == off and g_log_val[i] == v
            return i
        i = i + 1
    g_log_len

# The first write to `off` whose value has every bit of `bits`.
fn find_bits(off: u32, bits: u32, from: u32) -> u32
    var i: u32 = from
    while i < g_log_len
        if g_log_off[i] == off and (g_log_val[i] & bits) == bits
            return i
        i = i + 1
    g_log_len

# ---------------------------------------------------------------------------
# The DMA runs and the device's side of them
# ---------------------------------------------------------------------------

const RX_RING_IOVA: u64 = 0x1_1000_0000
const TX_RING_IOVA: u64 = 0x1_1001_0000
const RX_POOL_IOVA: u64 = 0x2000_0000
const TX_POOL_IOVA: u64 = 0x3000_0000

var g_rx_ring: [32 * 16 / 8]u64
var g_tx_ring: [32 * 16 / 8]u64
var g_rx_pool: [32 * 2048 / 8]u64
var g_tx_pool: [32 * 2048 / 8]u64
var g_nic: E1000eNic<Model>
# The device's own RDH and TDH.
var g_rdh: u32
var g_tdh: u32

fn dma() -> E1000eDma
    E1000eDma { rx_ring: DmaRun { virt: @g_rx_ring as u64, iova: RX_RING_IOVA }, tx_ring: DmaRun { virt: @g_tx_ring as u64, iova: TX_RING_IOVA }, rx_pool: DmaRun { virt: @g_rx_pool as u64, iova: RX_POOL_IOVA }, tx_pool: DmaRun { virt: @g_tx_pool as u64, iova: TX_POOL_IOVA } }

fn msix() -> E1000eMsix
    E1000eMsix { rx: 0, tx: 1, other: 2 }

# up() over the model as model_reset left it (and as a test then changed
# it), with dirty rings, so up() must write them.
fn try_up() -> Result<NetInfo, UpError>
    for i in 0..32 * 16 / 8
        g_rx_ring[i] = 0xFFFFFFFFFFFFFFFF
        g_tx_ring[i] = 0xFFFFFFFFFFFFFFFF
    g_rdh = 0
    g_tdh = 0
    g_nic.up(Model { unused: 0 }, dma(), msix())

# A NIC that is up, its first kick done (RDT written).
[[test_helper]]
fn fresh() -> @&E1000eNic<Model>
    model_reset()
    match try_up()
        Ok(_) => pass
        Err(_) =>
            assert false
    # Counted from here: up() wrote RDT and TDT 0 with the rings.
    g_rdt_writes = 0
    g_tdt_writes = 0
    g_nic.tx_kick()
    @&g_nic

fn rx_desc(s: u32) -> *RxDesc
    (@g_rx_ring as u64 + (s as u64) * 16) as *RxDesc

fn tx_desc(s: u32) -> *TxDesc
    (@g_tx_ring as u64 + (s as u64) * 16) as *TxDesc

# The CPU address of the buffer at device address `iova` in `pool`.
fn rx_virt(iova: u64) -> u64
    @g_rx_pool as u64 + (iova - RX_POOL_IOVA)

fn rx_buf_id(iova: u64) -> u32
    ((iova - RX_POOL_IOVA) / 2048) as u32

# The device receives `n` bytes from `seed` into the slot at its RDH, with
# `status` and `errors`, and advances RDH. It only uses slots software
# posted: RDH stops at RDT.
fn device_receive(n: u32, seed: u8, status: u8, errors: u8) -> bool
    if g_rdh == reg(REG_RDT)
        return false
    let d: *RxDesc = rx_desc(g_rdh)
    let bytes: [u8] = span_from_ptr<u8>(rx_virt(d.addr) as *u8, 2048)
    for i in 0..n as i64
        bytes[i] = seed +% (i as u8)
    d.length = n as u16
    d.errors = errors
    d.status = status
    g_rdh = (g_rdh + 1) % E1000E_RING
    true

fn receive(n: u32, seed: u8) -> bool
    device_receive(n, seed, RXD_STAT_DD | RXD_STAT_EOP, 0)

# The device sends every descriptor from its TDH up to TDT: DD on each.
fn device_send() -> u32
    var sent: u32 = 0
    while g_tdh != reg(REG_TDT)
        let d: *TxDesc = tx_desc(g_tdh)
        d.status = d.status | TXD_STAT_DD
        g_tdh = (g_tdh + 1) % E1000E_RING
        sent = sent + 1
    sent

const NONE: u32 = 0xFFFFFFFF
var g_empty: [1]u8

fn must_rx(n: @&E1000eNic<Model>) -> RxFrame
    match n.rx_poll()
        Some(f) => f
        None =>
            let none: [u8] = @g_empty
            RxFrame { bytes: none[0..0], token: NONE }

fn must_tx(n: @&E1000eNic<Model>) -> TxFrame
    match n.tx_buffer()
        Some(t) => t
        None =>
            let none: [u8] = @g_empty
            TxFrame { bytes: none[0..0], token: NONE }

# UpError carries a payload, so its variants are told apart by match.
fn up_error_kind(e: UpError) -> u32
    match e
        UpError.MasterDisable => 1
        UpError.Reset => 2
        UpError.NoMac => 3
        UpError.Phy(_) => 4

fn is_up_error(r: Result<NetInfo, UpError>, want: UpError) -> bool
    match r
        Ok(_) => false
        Err(e) => up_error_kind(e) == up_error_kind(want)

fn is_phy_error(r: Result<u16, PhyError>, want: PhyError) -> bool
    match r
        Ok(_) => false
        Err(e) => e == want

# ---------------------------------------------------------------------------
# Sizes and the boot record
# ---------------------------------------------------------------------------

[[test]]
fn test_rings_and_pools_are_sized_for_32_descriptors() -> i32
    assert ring_bytes() == 512 and ring_bytes() % 128 == 0
    assert pool_bytes() == 16 * 4096
    assert E1000E_RING_USABLE == 31
    0

[[test]]
fn test_msix_entries_come_from_the_boot_record() -> i32
    var b: DriverBoot
    b.msix_config = 2
    b.msix_rx = 0
    b.msix_tx = 1
    let m: E1000eMsix = e1000e_msix(b)
    assert m.rx == 0 and m.tx == 1 and m.other == 2
    # RxQ0 -> entry 0, TxQ0 -> 1, Other -> 2, each valid; a TX interrupt on
    # every write-back.
    assert ivar_value(m) == 0x800A0908
    0

# MmioRegs is a 32-bit access at its byte offset from base: here over host
# memory standing in for BAR0.
[[test]]
fn test_mmio_regs_read_and_write_at_byte_offsets() -> i32
    var bar: [8]u32
    for i in 0..8
        bar[i] = 0
    var r: MmioRegs = MmioRegs { base: @bar as u64 }
    r.wr(0x08, 0xDEADBEEF)
    r.wr(0x1C, 7)
    assert bar[2] == 0xDEADBEEF and bar[7] == 7 and bar[1] == 0
    bar[3] = 0x1234
    assert r.rd(0x0C) == 0x1234 and r.rd(0x08) == 0xDEADBEEF
    0

# ---------------------------------------------------------------------------
# Reset
# ---------------------------------------------------------------------------

[[test]]
fn test_reset_masters_off_masks_resets_and_acks() -> i32
    let n = fresh()
    let gio: u32 = find_bits(REG_CTRL, CTRL_GIO_MASTER_DISABLE, 0)
    let imc: u32 = find_write(REG_IMC, 0xFFFFFFFF, gio)
    let rst: u32 = find_bits(REG_CTRL, CTRL_RST, imc)
    let imc2: u32 = find_write(REG_IMC, 0xFFFFFFFF, rst)
    let ack: u32 = find_write(REG_ICR, ICR_LSC, imc2)
    assert gio < imc and imc < rst and rst < imc2 and imc2 < ack and ack < g_log_len
    # No DMA engine runs across the reset.
    assert find_write(REG_RCTL, 0, imc) < rst and find_write(REG_TCTL, 0, imc) < rst
    # The reset bit cleared; the pending LSC was acknowledged before
    # irq_arm, and every cause is masked until it.
    assert (reg(REG_CTRL) & CTRL_RST) == 0
    assert reg(REG_ICR) == 0 and reg(REG_IMS) == 0
    0

[[test]]
fn test_reset_times_out_when_master_enable_stays_set() -> i32
    model_reset()
    g_stuck_master = true
    assert is_up_error(try_up(), UpError.MasterDisable)
    # The wait is bounded, and no reset is issued with DMA in flight.
    assert g_reads >= MASTER_POLLS as u64 and g_reads < MASTER_POLLS as u64 + 100
    assert find_bits(REG_CTRL, CTRL_RST, 0) == g_log_len
    0

[[test]]
fn test_reset_times_out_when_rst_never_clears() -> i32
    model_reset()
    g_stuck_rst = true
    assert is_up_error(try_up(), UpError.Reset)
    assert g_reads >= RESET_POLLS as u64 and g_reads < RESET_POLLS as u64 + 100
    # Stopped there: no rings programmed.
    assert find_write(REG_RCTL, RCTL_VALUE, 0) == g_log_len
    0

# ---------------------------------------------------------------------------
# The MAC and the PHY
# ---------------------------------------------------------------------------

[[test]]
fn test_mac_comes_from_ral0_rah0() -> i32
    let n = fresh()
    let info: NetInfo = n.link()
    assert info.mac[0] == 0x52 and info.mac[1] == 0x54 and info.mac[2] == 0x00
    assert info.mac[3] == 0x12 and info.mac[4] == 0x34 and info.mac[5] == 0x56
    0

[[test]]
fn test_up_refuses_a_nic_without_av() -> i32
    model_reset()
    set_reg(REG_RAH0, 0x5634)
    let r: Result<NetInfo, UpError> = try_up()
    assert is_up_error(r, UpError.NoMac)
    # netd's log line names it.
    match r
        Ok(_) => return 1
        Err(e) =>
            assert up_error_name(e).eq("RAH0.AV clear: no MAC address")
    assert find_write(REG_RCTL, RCTL_VALUE, 0) == g_log_len
    0

[[test]]
fn test_mdic_reads_and_writes_phy_address_1_holding_ownership() -> i32
    let n = fresh()
    g_phy[2] = 0x0141
    assert n.phy_read(2).unwrap_or(0) == 0x0141
    let at: u32 = g_log_len
    match n.phy_write(4, 0x01E1)
        Ok(_) => pass
        Err(_) => return 1
    assert g_phy[4] == 0x01E1 and not g_mdic_addr_bad
    # The MDIC write is made holding the flag, which is let go after.
    let own: u32 = find_bits(REG_EXTCNF_CTRL, EXTCNF_MDIO_SW_OWNERSHIP, at)
    let op: u32 = find_write(REG_MDIC, MDIC_OP_WRITE | (4 << MDIC_REG_SHIFT) | (PHY_ADDR << MDIC_PHY_SHIFT) | 0x01E1, at)
    assert own < op and op < g_log_len
    assert (reg(REG_EXTCNF_CTRL) & EXTCNF_MDIO_SW_OWNERSHIP) == 0
    0

[[test]]
fn test_mdic_error_timeout_and_ownership_fail() -> i32
    let n = fresh()
    g_mdic_error = true
    assert is_phy_error(n.phy_read(1), PhyError.Device)
    # The flag is let go on the error path too.
    assert (reg(REG_EXTCNF_CTRL) & EXTCNF_MDIO_SW_OWNERSHIP) == 0
    g_mdic_error = false
    g_stuck_mdic = true
    g_reads = 0
    assert is_phy_error(n.phy_read(1), PhyError.Timeout)
    assert g_reads >= MDIC_POLLS as u64 and g_reads < MDIC_POLLS as u64 + 100
    g_stuck_mdic = false
    g_stuck_own = true
    assert is_phy_error(n.phy_read(1), PhyError.Ownership)
    match n.phy_write(1, 0)
        Ok(_) => return 1
        Err(e) =>
            assert e == PhyError.Ownership
    0

# An MDIC error during bring-up stops it, named.
[[test]]
fn test_up_fails_on_a_phy_error() -> i32
    model_reset()
    g_mdic_error = true
    let r: Result<NetInfo, UpError> = try_up()
    match r
        Ok(_) => return 1
        Err(e) =>
            match e
                UpError.Phy(p) =>
                    assert p == PhyError.Device
                _ => return 2
            assert up_error_name(e).eq("MDIC reported an error")
    0

# ---------------------------------------------------------------------------
# Bring-up
# ---------------------------------------------------------------------------

[[test]]
fn test_up_programs_rings_filters_interrupts_and_link() -> i32
    let n = fresh()
    assert reg(REG_RDBAL) == 0x10000000 and reg(REG_RDBAH) == 1 and reg(REG_RDLEN) == 512
    assert reg(REG_TDBAL) == 0x10010000 and reg(REG_TDBAH) == 1 and reg(REG_TDLEN) == 512
    assert reg(REG_RDH) == 0 and reg(REG_TDH) == 0 and reg(REG_TDT) == 0
    assert reg(REG_RCTL) == (RCTL_EN | RCTL_BAM | RCTL_SECRC)
    assert reg(REG_TCTL) == (TCTL_EN | TCTL_PSP) and reg(REG_TIPG) == TIPG_VALUE
    for i in 0..MTA_WORDS
        assert reg(REG_MTA + 4 * i) == 0
    assert reg(REG_ITR) == 0 and reg(REG_RDTR) == 0 and reg(REG_RADV) == 0
    assert reg(REG_IVAR) == 0x800A0908
    # Link up from autonegotiation: SLU, nothing forced, AN restarted.
    assert (reg(REG_CTRL) & CTRL_SLU) != 0 and (reg(REG_CTRL) & (CTRL_FRCSPD | CTRL_FRCDPLX)) == 0
    assert g_phy[MII_BMCR] == (0x1140 | BMCR_ANENABLE | BMCR_ANRESTART)
    # Every slot the ring holds is posted, each with its own buffer.
    assert reg(REG_RDT) == 31 and g_rdt_writes == 1
    for s in 0..E1000E_RING_USABLE
        let d: *RxDesc = rx_desc(s)
        assert d.addr == RX_POOL_IOVA + (s as u64) * 2048 and d.status == 0
    0

[[test]]
fn test_link_reads_status_lu() -> i32
    let n = fresh()
    var info: NetInfo = n.link()
    assert info.link_up == 1 and info.mtu == 1500 and info.device_type == NETDEV_TYPE_E1000E
    assert NETDEV_TYPE_E1000E == 3
    set_reg(REG_STATUS, reg(REG_STATUS) & (0xFFFFFFFF ^ STATUS_LU))
    info = n.link()
    assert info.link_up == 0
    0

[[test]]
fn test_irq_arm_acks_icr_and_enables_the_msix_causes() -> i32
    let n = fresh()
    set_reg(REG_ICR, ICR_RXQ0 | ICR_LSC)
    n.irq_arm()
    assert reg(REG_ICR) == 0
    assert reg(REG_IMS) == (ICR_RXQ0 | ICR_TXQ0 | ICR_OTHER | ICR_LSC)
    0

# ---------------------------------------------------------------------------
# RX
# ---------------------------------------------------------------------------

[[test]]
fn test_rx_poll_hands_out_the_frame_in_its_buffer() -> i32
    let n = fresh()
    assert n.rx_poll().is_none()
    assert receive(60, 0x30)
    let f: RxFrame = must_rx(n)
    # Buffer 0, from the Ethernet header: no NIC header to strip.
    assert f.token == 0 and f.bytes.len == 60
    assert f.bytes[0] == 0x30 and f.bytes[59] == 0x30 + 59
    assert f.bytes.ptr as u64 == @g_rx_pool as u64
    assert n.rx_poll().is_none()
    # Not reposted until it is released.
    n.tx_kick()
    assert g_rdt_writes == 1
    n.rx_release(f)
    n.tx_kick()
    assert g_rdt_writes == 2
    0

# The device takes RX slots in ring order, so a release out of order still
# fills the slots at RDT in order, with whichever buffers came back.
[[test]]
fn test_out_of_order_release_refills_in_ring_order() -> i32
    let n = fresh()
    assert receive(20, 1) and receive(30, 2) and receive(40, 3)
    let a: RxFrame = must_rx(n)
    let b: RxFrame = must_rx(n)
    let c: RxFrame = must_rx(n)
    assert a.token == 0 and b.token == 1 and c.token == 2 and c.bytes.len == 40
    # Releasing c first: the spare buffer 31 and buffer 2 fill slots 31
    # and 0, the next two after RDT.
    n.rx_release(c)
    n.tx_kick()
    assert reg(REG_RDT) == 1
    assert rx_buf_id(rx_desc(31).addr) == 2 or rx_buf_id(rx_desc(31).addr) == 31
    assert rx_buf_id(rx_desc(0).addr) == 2 or rx_buf_id(rx_desc(0).addr) == 31
    assert rx_buf_id(rx_desc(31).addr) != rx_buf_id(rx_desc(0).addr)
    n.rx_release(a)
    n.tx_kick()
    assert reg(REG_RDT) == 2 and rx_buf_id(rx_desc(1).addr) == 0
    # The ring holds 31 again (slots 3..31 and 0..1), so b is the spare: no
    # slot for it, and no RDT write.
    n.rx_release(b)
    n.tx_kick()
    assert reg(REG_RDT) == 2 and g_rdt_writes == 3 and n.rx_free.count == 1
    # A double release does nothing.
    n.rx_release(b)
    assert n.rx_free.count == 1
    # The device keeps going in ring order over the refilled slots.
    var got: u32 = 0
    while receive(60, 9)
        let f: RxFrame = must_rx(n)
        assert f.token != NONE and f.bytes.len == 60
        n.rx_release(f)
        n.tx_kick()
        got = got + 1
        if got == 100
            break
    assert got == 100
    0

[[test]]
fn test_bad_frames_are_skipped_and_reposted() -> i32
    let n = fresh()
    # A CRC error, then a frame without EOP, then a good one.
    assert device_receive(60, 1, RXD_STAT_DD | RXD_STAT_EOP, 0x01)
    assert device_receive(60, 2, RXD_STAT_DD, 0)
    assert receive(42, 3)
    let f: RxFrame = must_rx(n)
    assert f.token == 2 and f.bytes.len == 42 and f.bytes[0] == 3
    assert n.rx_dropped == 2
    # Both bad buffers went back on the ring at once.
    n.tx_kick()
    assert reg(REG_RDT) == 1
    n.rx_release(f)
    0

# ---------------------------------------------------------------------------
# TX
# ---------------------------------------------------------------------------

[[test]]
fn test_tx_submit_writes_eop_ifcs_rs_and_kick_writes_tdt_once() -> i32
    let n = fresh()
    let t: TxFrame = must_tx(n)
    assert t.token != NONE and t.bytes.len == 2048
    for i in 0..42
        t.bytes[i] = 0x40 +% (i as u8)
    n.tx_submit(t, 42)
    let d: *TxDesc = tx_desc(0)
    # No NIC header: the descriptor names the buffer's first byte, and a
    # 42-byte frame goes as it is (TCTL.PSP pads it).
    assert d.addr == TX_POOL_IOVA + (t.token as u64) * 2048 and d.length == 42
    assert d.cmd == (TXD_CMD_EOP | TXD_CMD_IFCS | TXD_CMD_RS) and d.status == 0
    assert g_tdt_writes == 0
    let u: TxFrame = must_tx(n)
    n.tx_submit(u, 60)
    n.tx_kick()
    assert g_tdt_writes == 1 and reg(REG_TDT) == 2
    n.tx_kick()
    assert g_tdt_writes == 1
    0

[[test]]
fn test_a_runt_or_overlong_submit_gives_the_buffer_back() -> i32
    let n = fresh()
    let t: TxFrame = must_tx(n)
    n.tx_submit(t, ETH_HEADER_LEN - 1)
    let u: TxFrame = must_tx(n)
    n.tx_submit(u, 2049)
    assert n.tx_refused == 2 and n.tx_busy == 0
    n.tx_kick()
    assert g_tdt_writes == 0
    # A token not held is ignored.
    n.tx_submit(u, 60)
    assert n.tx_busy == 0 and n.tx_next == 0
    0

[[test]]
fn test_tx_buffer_is_none_with_every_buffer_in_flight() -> i32
    let n = fresh()
    var held: [32]u32
    for i in 0..E1000E_RING_USABLE
        let t: TxFrame = must_tx(n)
        assert t.token != NONE
        held[i] = t.token
        for j in 0..i
            assert held[j] != held[i]
        n.tx_submit(t, 60)
    assert n.tx_buffer().is_none()
    n.tx_kick()
    assert reg(REG_TDT) == 31
    # Without DD nothing comes back, however often it is asked.
    assert n.tx_buffer().is_none()
    # The device finishes them: buffers again.
    assert device_send() == 31
    let again: TxFrame = must_tx(n)
    assert again.token != NONE
    n.tx_submit(again, 60)
    0

# AGAST #4073: 300 sends through a 32-descriptor ring, each reclaimed only
# after its DD, so the descriptors and buffers recycle.
[[test]]
fn test_300_sends_recycle_descriptors() -> i32
    let n = fresh()
    var sent: u32 = 0
    var completed: u32 = 0
    while sent < 300
        let t: TxFrame = match n.tx_buffer()
            Some(x) => x
            None =>
                # Every buffer in flight: the device sends what TDT shows.
                completed = completed + device_send()
                continue
        t.bytes[0] = sent as u8
        n.tx_submit(t, 60)
        sent = sent + 1
        if sent % 8 == 0
            n.tx_kick()
    n.tx_kick()
    completed = completed + device_send()
    assert completed == 300
    assert reg(REG_TDT) == 300 % E1000E_RING
    # All reclaimed on the next ask.
    let t: TxFrame = must_tx(n)
    assert t.token != NONE and n.tx_busy == 1
    0
