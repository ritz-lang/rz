# net/stack.ritz - Network Stack
#
# Main network stack initialization, packet polling, and dispatch.
# This is the central coordination point for all network layers.
#
# Uses the netdev abstraction layer to support multiple network backends
# (VirtIO-net, ENA, etc) without protocol-level changes.

import klog { klog, klog_cstr }
import net.types { ETHERTYPE_ARP, ETHERTYPE_IPV4, IP_PROTO_ICMP, IP_PROTO_UDP, IP_PROTO_TCP, IP_HEADER_SIZE, ETH_HEADER_SIZE, DHCP_SERVER_PORT, DHCP_CLIENT_PORT, UDP_HEADER_SIZE }
import net.eth { eth_parse_header, EthHeader }
import net.arp { arp_init, arp_handle_packet }
import net.ip { ip_init, ip_is_configured, ip_print_config, ip_get_header_len, ip_get_protocol }
import net.icmp { icmp_handle_packet }
import net.udp { udp_get_src_port, udp_get_dst_port }
import net.dhcp { dhcp_discover, dhcp_handle_packet, dhcp_is_configured }
import drivers.netdev { NetDevice, NETDEV_TYPE_NONE, netdev_init, netdev_get_default, netdev_poll, netdev_wait_rx, netdev_send, netdev_is_running, netdev_print_mac, netdev_type, netdev_type_name, netdev_get_mac }

# ============================================================================
# Network Stack State
# ============================================================================

var net_rx_buf: [2048]u8
var net_initialized: bool = false
var net_device: *NetDevice = 0 as *NetDevice

# ============================================================================
# Initialization
# ============================================================================

pub fn net_stack_init() -> i32
    klog("[net] Initializing network stack...\n")

    # Initialize protocol layers
    arp_init()
    ip_init()

    # Probe for network devices via netdev abstraction
    let dev_count: i32 = netdev_init()
    if dev_count <= 0
        klog("[net] No network devices found!\n")
        return -1

    # Get the default network device
    net_device = netdev_get_default()
    if net_device == 0 as *NetDevice
        klog("[net] Failed to get default network device!\n")
        return -2

    net_initialized = true
    klog("[net] Network stack initialized\n")

    return 0

# ============================================================================
# DHCP Configuration
# ============================================================================

pub fn net_configure_dhcp() -> i32
    if not net_initialized
        klog("[net] Stack not initialized!\n")
        return -1

    klog("[net] Starting DHCP configuration...\n")
    return dhcp_discover()

# ============================================================================
# Packet Reception & Dispatch
# ============================================================================

pub fn net_poll() -> i32
    if not net_initialized
        return 0

    # Poll via netdev abstraction
    let len: i32 = netdev_poll(net_device, @net_rx_buf[0], 2048)
    if len <= 0
        return 0

    # Parse Ethernet header
    if len < ETH_HEADER_SIZE as i32
        return 0

    var eth_hdr: EthHeader
    eth_parse_header(@net_rx_buf[0], @eth_hdr)

    let payload: *u8 = @net_rx_buf[0] + ETH_HEADER_SIZE as i64
    let payload_len: u32 = (len as u32) - ETH_HEADER_SIZE

    # Dispatch by ethertype
    if eth_hdr.ethertype == ETHERTYPE_ARP
        arp_handle_packet(payload, payload_len)
        return 1

    else if eth_hdr.ethertype == ETHERTYPE_IPV4
        return handle_ipv4_packet(payload, payload_len, @eth_hdr.src_mac[0])

    return 0

# ============================================================================
# IPv4 Packet Handling
# ============================================================================

fn handle_ipv4_packet(ip_data: *u8, ip_len: u32, src_mac: *u8) -> i32
    if ip_len < IP_HEADER_SIZE
        return 0

    # Check IP version
    let ip_version: u8 = (*(ip_data + 0) >> 4) & 0x0F
    if ip_version != 4
        return 0

    let ip_hdr_len: u32 = ip_get_header_len(ip_data)
    if ip_hdr_len < IP_HEADER_SIZE or ip_hdr_len > ip_len
        return 0

    let protocol: u8 = ip_get_protocol(ip_data)
    let src_ip: *u8 = ip_data + 12
    let ip_payload: *u8 = ip_data + ip_hdr_len as i64
    let ip_payload_len: u32 = ip_len - ip_hdr_len

    if protocol == IP_PROTO_ICMP
        icmp_handle_packet(ip_payload, ip_payload_len, src_ip, src_mac)
        return 1

    else if protocol == IP_PROTO_UDP
        return handle_udp_packet(ip_payload, ip_payload_len, src_ip)

    else if protocol == IP_PROTO_TCP
        # TODO: TCP handling
        return 0

    return 0

# ============================================================================
# UDP Packet Handling
# ============================================================================

fn handle_udp_packet(udp_data: *u8, udp_len: u32, src_ip: *u8) -> i32
    if udp_len < UDP_HEADER_SIZE
        return 0

    let src_port: u16 = udp_get_src_port(udp_data)
    let dst_port: u16 = udp_get_dst_port(udp_data)

    # DHCP response
    if src_port == DHCP_SERVER_PORT and dst_port == DHCP_CLIENT_PORT
        let dhcp_data: *u8 = udp_data + UDP_HEADER_SIZE as i64
        let dhcp_len: u32 = udp_len - UDP_HEADER_SIZE
        dhcp_handle_packet(dhcp_data, dhcp_len)
        return 1

    # TODO: Add more UDP handlers (DNS, user sockets, etc.)

    return 0

# ============================================================================
# Status Queries
# ============================================================================

pub fn net_is_ready() -> bool
    return net_initialized and net_device != 0 as *NetDevice and netdev_is_running(net_device)

pub fn net_is_configured() -> bool
    return ip_is_configured()

# Get the active network device
pub fn net_get_device() -> *NetDevice
    net_device

# The active device's NETDEV_TYPE_* (NETDEV_TYPE_NONE before init). The EC2
# peer-ping responder window (#1851) only runs over ENA: QEMU's virtio-net
# gate must not wait for a peer that is not there.
# Sleep until the NIC may have a frame for net_poll (AGAST #3631). False,
# without waiting, when the NIC can't wait on its RX interrupt.
pub fn net_wait_rx() -> bool
    if not net_initialized
        return false
    netdev_wait_rx(net_device)

pub fn net_device_type() -> u8
    if net_device == 0 as *NetDevice
        return NETDEV_TYPE_NONE
    netdev_type(net_device)

# Get the MAC address of the active network device
pub fn net_get_mac(mac_out: *u8)
    netdev_get_mac(net_device, mac_out)
    return

# Send a packet through the active network device
pub fn net_send(data: *u8, len: u32) -> i32
    if net_device == 0 as *NetDevice
        return -1
    netdev_send(net_device, data, len)

# ============================================================================
# Debug
# ============================================================================

pub fn net_print_status()
    klog("[net] Status:\n")
    klog("  Initialized: ")
    if net_initialized
        klog("yes\n")
    else
        klog("no\n")

    klog("  Device:      ")
    if net_device != 0 as *NetDevice
        klog_cstr(netdev_type_name(net_device))
        klog(" (")
        netdev_print_mac(net_device)
        klog(")\n")
    else
        klog("none\n")

    klog("  Running:     ")
    if net_device != 0 as *NetDevice and netdev_is_running(net_device)
        klog("yes\n")
    else
        klog("no\n")

    klog("  DHCP:        ")
    if dhcp_is_configured()
        klog("configured\n")
    else
        klog("pending\n")

    if ip_is_configured()
        ip_print_config()
