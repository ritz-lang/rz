# net/dhcp.ritz - Dynamic Host Configuration Protocol Client
#
# DHCP client for obtaining IP address configuration from a DHCP server.
# Supports DISCOVER/OFFER/REQUEST/ACK flow.

import klog { klog, klog_dec }
import net.types { DHCP_SERVER_PORT, DHCP_CLIENT_PORT, DHCP_OP_REQUEST, DHCP_DISCOVER, DHCP_OFFER, DHCP_REQUEST, DHCP_ACK, DHCP_MAGIC, DHCP_HEADER_SIZE, IP_PROTO_UDP, ETHERTYPE_IPV4 }
import net.ip { ip_build_header, ip_set_config, ip_set_dns }
import net.udp { udp_build_header }
import net.eth { eth_build_frame, eth_get_broadcast_mac }
import ritzlib.span { span_from_ptr }
import ritzlib.endian

# Forward declarations - use network stack's device abstraction
extern fn net_send(data: *u8, len: u32) -> i32
extern fn net_get_mac(mac_out: *u8)

# ============================================================================
# DHCP Client State
# ============================================================================

var dhcp_xid: u32 = 0x12345678
var dhcp_state: u8 = 0  # 0=idle, 1=discover sent, 2=request sent, 3=configured

# Offered configuration (saved to send REQUEST for)
var dhcp_offered_ip: [4]u8
var dhcp_offered_server: [4]u8
var dhcp_offered_gateway: [4]u8
var dhcp_offered_netmask: [4]u8
var dhcp_offered_dns: [4]u8

# ============================================================================
# DHCP Discover
# ============================================================================

pub fn dhcp_discover() -> i32
    var frame: [576]u8
    var ip_buf: [320]u8
    var udp_buf: [300]u8
    var dhcp_buf: [280]u8

    # Zero DHCP buffer
    var i: u32 = 0
    while i < 280
        dhcp_buf[i as i32] = 0
        i = i + 1

    # DHCP header
    dhcp_buf[0] = DHCP_OP_REQUEST  # op
    dhcp_buf[1] = 1                # htype = Ethernet
    dhcp_buf[2] = 6                # hlen = 6 bytes MAC
    dhcp_buf[3] = 0                # hops

    # Transaction ID
    dhcp_xid = dhcp_xid + 1
    dhcp_buf[4] = ((dhcp_xid >> 24) & 0xFF) as u8
    dhcp_buf[5] = ((dhcp_xid >> 16) & 0xFF) as u8
    dhcp_buf[6] = ((dhcp_xid >> 8) & 0xFF) as u8
    dhcp_buf[7] = (dhcp_xid & 0xFF) as u8

    # secs, flags (broadcast)
    dhcp_buf[8] = 0
    dhcp_buf[9] = 0
    dhcp_buf[10] = 0x80  # Broadcast flag
    dhcp_buf[11] = 0

    # ciaddr, yiaddr, siaddr, giaddr all zero (bytes 12-27)

    # Client MAC at offset 28
    net_get_mac(@dhcp_buf[28])

    # DHCP Magic cookie at offset 236
    dhcp_buf[236] = 0x63
    dhcp_buf[237] = 0x82
    dhcp_buf[238] = 0x53
    dhcp_buf[239] = 0x63

    # DHCP Options starting at 240
    # Option 53: DHCP Message Type = Discover
    dhcp_buf[240] = 53
    dhcp_buf[241] = 1
    dhcp_buf[242] = DHCP_DISCOVER

    # Option 55: Parameter Request List
    dhcp_buf[243] = 55
    dhcp_buf[244] = 4
    dhcp_buf[245] = 1    # Subnet mask
    dhcp_buf[246] = 3    # Router
    dhcp_buf[247] = 6    # DNS
    dhcp_buf[248] = 15   # Domain name

    # End option
    dhcp_buf[249] = 255

    let dhcp_len: u32 = 250

    # Build UDP header
    let udp_hdr_len: u32 = udp_build_header(@udp_buf[0], DHCP_CLIENT_PORT, DHCP_SERVER_PORT, dhcp_len)

    # Copy DHCP after UDP header
    i = 0
    while i < dhcp_len
        udp_buf[udp_hdr_len as i32 + i as i32] = dhcp_buf[i as i32]
        i = i + 1

    let udp_total: u32 = udp_hdr_len + dhcp_len

    # Build IP header (broadcast destination 255.255.255.255)
    var broadcast_ip: [4]u8
    broadcast_ip[0] = 255
    broadcast_ip[1] = 255
    broadcast_ip[2] = 255
    broadcast_ip[3] = 255

    let ip_len: u32 = ip_build_header(@ip_buf[0], @broadcast_ip[0], IP_PROTO_UDP, udp_total)

    # Copy UDP after IP header
    i = 0
    while i < udp_total
        ip_buf[ip_len as i32 + i as i32] = udp_buf[i as i32]
        i = i + 1

    # Build Ethernet frame (broadcast)
    let bcast_mac: *u8 = eth_get_broadcast_mac()
    let frame_len: u32 = eth_build_frame(@frame[0], bcast_mac, ETHERTYPE_IPV4, @ip_buf[0], ip_len + udp_total)

    dhcp_state = 1
    klog("[dhcp] Sending DISCOVER\n")

    return net_send(@frame[0], frame_len)

# ============================================================================
# DHCP Request
# ============================================================================

fn dhcp_send_request() -> i32
    var frame: [576]u8
    var ip_buf: [320]u8
    var udp_buf: [300]u8
    var dhcp_buf: [280]u8

    # Zero DHCP buffer
    var i: u32 = 0
    while i < 280
        dhcp_buf[i as i32] = 0
        i = i + 1

    # DHCP header
    dhcp_buf[0] = DHCP_OP_REQUEST
    dhcp_buf[1] = 1
    dhcp_buf[2] = 6
    dhcp_buf[3] = 0

    # Same transaction ID
    dhcp_buf[4] = ((dhcp_xid >> 24) & 0xFF) as u8
    dhcp_buf[5] = ((dhcp_xid >> 16) & 0xFF) as u8
    dhcp_buf[6] = ((dhcp_xid >> 8) & 0xFF) as u8
    dhcp_buf[7] = (dhcp_xid & 0xFF) as u8

    # Broadcast flag
    dhcp_buf[10] = 0x80

    # Client MAC at offset 28
    net_get_mac(@dhcp_buf[28])

    # DHCP Magic cookie
    dhcp_buf[236] = 0x63
    dhcp_buf[237] = 0x82
    dhcp_buf[238] = 0x53
    dhcp_buf[239] = 0x63

    # Option 53: DHCP Message Type = Request
    dhcp_buf[240] = 53
    dhcp_buf[241] = 1
    dhcp_buf[242] = DHCP_REQUEST

    # Option 50: Requested IP Address
    dhcp_buf[243] = 50
    dhcp_buf[244] = 4
    dhcp_buf[245] = dhcp_offered_ip[0]
    dhcp_buf[246] = dhcp_offered_ip[1]
    dhcp_buf[247] = dhcp_offered_ip[2]
    dhcp_buf[248] = dhcp_offered_ip[3]

    # Option 54: Server Identifier
    dhcp_buf[249] = 54
    dhcp_buf[250] = 4
    dhcp_buf[251] = dhcp_offered_server[0]
    dhcp_buf[252] = dhcp_offered_server[1]
    dhcp_buf[253] = dhcp_offered_server[2]
    dhcp_buf[254] = dhcp_offered_server[3]

    # End option
    dhcp_buf[255] = 255

    let dhcp_len: u32 = 256

    # Build UDP header
    let udp_hdr_len: u32 = udp_build_header(@udp_buf[0], DHCP_CLIENT_PORT, DHCP_SERVER_PORT, dhcp_len)

    # Copy DHCP after UDP header
    i = 0
    while i < dhcp_len
        udp_buf[udp_hdr_len as i32 + i as i32] = dhcp_buf[i as i32]
        i = i + 1

    let udp_total: u32 = udp_hdr_len + dhcp_len

    # Broadcast
    var broadcast_ip: [4]u8
    broadcast_ip[0] = 255
    broadcast_ip[1] = 255
    broadcast_ip[2] = 255
    broadcast_ip[3] = 255

    let ip_len: u32 = ip_build_header(@ip_buf[0], @broadcast_ip[0], IP_PROTO_UDP, udp_total)

    i = 0
    while i < udp_total
        ip_buf[ip_len as i32 + i as i32] = udp_buf[i as i32]
        i = i + 1

    let bcast_mac: *u8 = eth_get_broadcast_mac()
    let frame_len: u32 = eth_build_frame(@frame[0], bcast_mac, ETHERTYPE_IPV4, @ip_buf[0], ip_len + udp_total)

    dhcp_state = 2
    klog("[dhcp] Sending REQUEST\n")

    return net_send(@frame[0], frame_len)

# ============================================================================
# Handle DHCP Response
# ============================================================================

# Copy a 4-byte address (IPv4 / netmask) from src to dst
fn dhcp_copy4(dst: *u8, src: *u8)
    var j: i64 = 0
    while j < 4
        *(dst + j) = *(src + j)
        j = j + 1

# Record one 4-byte option we care about (subnet mask, router, DNS, server id).
# Other options, and ones shorter than 4 bytes, are ignored.
fn dhcp_store_addr_option(opt: u8, opt_len: u8, opt_data: *u8)
    if opt_len < 4
        return
    if opt == 1
        dhcp_copy4(@dhcp_offered_netmask[0], opt_data)    # Subnet Mask
    else if opt == 3
        dhcp_copy4(@dhcp_offered_gateway[0], opt_data)    # Router
    else if opt == 6
        dhcp_copy4(@dhcp_offered_dns[0], opt_data)        # DNS Server
    else if opt == 54
        dhcp_copy4(@dhcp_offered_server[0], opt_data)     # Server Identifier

# Walk the options (from offset 240), storing the address options.
# Returns the DHCP message type (option 53), or 0 if there is none.
fn dhcp_parse_options(dhcp_data: *u8, dhcp_len: u32) -> u8
    var msg_type: u8 = 0
    var i: u32 = 240
    while i < dhcp_len
        let opt: u8 = *(dhcp_data + i as i64)
        if opt == 255
            break  # End option
        if opt == 0
            i = i + 1  # Padding
            continue

        let opt_len: u8 = *(dhcp_data + i as i64 + 1)
        let opt_data: *u8 = dhcp_data + i as i64 + 2

        if opt == 53 and opt_len >= 1
            # DHCP Message Type
            msg_type = *opt_data
        else
            dhcp_store_addr_option(opt, opt_len, opt_data)

        i = i + 2 + opt_len as u32
    return msg_type

# OFFER (after DISCOVER): save the offered IP (yiaddr) and send REQUEST
fn dhcp_on_offer(offered_ip: *u8)
    dhcp_copy4(@dhcp_offered_ip[0], offered_ip)

    klog("[dhcp] OFFER: ")
    dhcp_print_ip(@dhcp_offered_ip[0])
    klog("\n")

    # Send REQUEST
    dhcp_send_request()

# ACK (after REQUEST): configure the IP stack
fn dhcp_on_ack()
    klog("[dhcp] ACK: ")
    dhcp_print_ip(@dhcp_offered_ip[0])
    klog("\n")

    # Set default netmask if not provided
    if dhcp_offered_netmask[0] == 0 and dhcp_offered_netmask[1] == 0
        dhcp_offered_netmask[0] = 255
        dhcp_offered_netmask[1] = 255
        dhcp_offered_netmask[2] = 255
        dhcp_offered_netmask[3] = 0

    # Set default gateway if not provided (QEMU SLIRP default)
    if dhcp_offered_gateway[0] == 0 and dhcp_offered_gateway[1] == 0
        dhcp_offered_gateway[0] = 10
        dhcp_offered_gateway[1] = 0
        dhcp_offered_gateway[2] = 2
        dhcp_offered_gateway[3] = 2

    # Configure IP layer
    ip_set_config(@dhcp_offered_ip[0], @dhcp_offered_gateway[0], @dhcp_offered_netmask[0])

    if dhcp_offered_dns[0] != 0 or dhcp_offered_dns[1] != 0
        ip_set_dns(@dhcp_offered_dns[0])

    dhcp_state = 3
    klog("[dhcp] Configured!\n")

pub fn dhcp_handle_packet(dhcp_data: *u8, dhcp_len: u32)
    if dhcp_len < DHCP_HEADER_SIZE
        return

    # Need the magic cookie at offset 236
    if dhcp_len < 240
        return
    # The packet as a span: a field read past dhcp_len stops the kernel
    # rather than reading the next frame's bytes (AGAST #4644).
    let pkt: [u8] = span_from_ptr<u8>(dhcp_data, dhcp_len as i64)
    if endian_read_u32_be(pkt, 236) != DHCP_MAGIC
        return

    # Check transaction ID
    if endian_read_u32_be(pkt, 4) != dhcp_xid
        return

    # Parse options to find message type and other info
    let msg_type: u8 = dhcp_parse_options(dhcp_data, dhcp_len)

    if msg_type == DHCP_OFFER and dhcp_state == 1
        # Offered IP is yiaddr, at offset 16
        dhcp_on_offer(dhcp_data + 16)
    else if msg_type == DHCP_ACK and dhcp_state == 2
        dhcp_on_ack()

# ============================================================================
# State Query
# ============================================================================

pub fn dhcp_is_configured() -> bool
    return dhcp_state == 3

pub fn dhcp_get_state() -> u8
    return dhcp_state

pub fn dhcp_reset()
    dhcp_state = 0

# ============================================================================
# Debug
# ============================================================================

fn dhcp_print_ip(ip: *u8)
    klog_dec(*(ip + 0) as i64)
    klog(".")
    klog_dec(*(ip + 1) as i64)
    klog(".")
    klog_dec(*(ip + 2) as i64)
    klog(".")
    klog_dec(*(ip + 3) as i64)

pub fn dhcp_print_config()
    klog("[dhcp] Configuration:\n")
    klog("  IP:      ")
    dhcp_print_ip(@dhcp_offered_ip[0])
    klog("\n  Gateway: ")
    dhcp_print_ip(@dhcp_offered_gateway[0])
    klog("\n  Netmask: ")
    dhcp_print_ip(@dhcp_offered_netmask[0])
    klog("\n  DNS:     ")
    dhcp_print_ip(@dhcp_offered_dns[0])
    klog("\n")
