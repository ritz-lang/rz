# net/ring1.ritz - the NIC cutover (AGAST #4735, #4875, #4893;
# docs/RING1_DRIVER.md sections 8-9 and PR 8, docs/RING2_NET.md "Drivers
# inside netd (D9)", docs/E1000E.md "Kernel side", ring plan T29)
#
# On every boot with a ring NIC and a translated DMA domain the NIC's
# queues belong to /bin/netd, a CPL-3 process the kernel spawns that runs
# the NIC's driver as a library beside the network stack (D9), and
# virtio_net_init never runs (D7: the boot picks the owner, not a marker
# file). The ring NIC is one per boot: a virtio-net, else an e1000e
# (drivers/nic.ritz), and DriverBoot names its kind so netd runs that
# driver. An untranslated boot keeps virtio_net_init and spawns nothing
# (it has no e1000e driver at all).
# kernel_main runs steps 1-4 before postinit_diagnostics and run_init,
# whether or not \harland\net-selftest is set:
#
#   1. net_ring1_prepare: the probe (virtio_net_ring1_probe, else
#      e1000e_ring1_probe: the NIC isolated in its private domain, MSI-X
#      entries 0-2 on one vector at the BSP, its windows recorded), then
#      process_create_init. Pid 1
#      exists, at CPL 0, with the scheduler stopped. kernel_main moves onto
#      pid 1's kernel stack (the boot stack is not in a child's page table)
#      and calls net_ring1_spawn there.
#   2. net_ring1_spawn: the device's IRQ object (latched by the vector,
#      bound to the domain, recorded for driver_quiesce); the spawn of
#      /bin/netd with no capabilities of its own; then the grants
#      (ring1_grant_to): a link page with the publish right, mapped first
#      (DRV_RING_BASE) with the DriverBoot record in it; the frame object
#      (ring_seat_open: mapped into netd, and into pid 1, the kernel seat);
#      the IRQ; one MMIO handle per window.
#   3. Pid 1 yields while the scheduler is stopped: nothing preempts netd,
#      which resets the device, brings it up, publishes generation 2
#      (NetPublish), posts its RX buffers and parks in DrvIrqWait; that
#      park is the switch back.
#   4. sched_start, once: run_init does not call it again.
#
# Step 5 is the self-test window (postinit.ritz network_dhcp_ping), only
# with \harland\net-selftest: net_stack_init finds the published snapshot
# and the stack's I/O is the frame ring, with netd as its driver.
#
# Step 6 is the frame-seat handoff (AGAST #4744, ring plan T38,
# docs/RING2_NET.md "Frame seat"), net_seat_handoff, after the self-test
# window (or in its place) and before run_init:
#
#   a. The kernel spawns nothing (D9). A fresh address page (read-write,
#      publish) is granted to netd, not mapped, with the ServiceBoot record
#      written in it, registered as the address object, and its handle
#      enqueued as ATTACH on netd's inbox; then netd is registered as the
#      service and the NetPublish gate is armed for it. NetAttach is NoDev
#      until that registration, so the page is the first ATTACH netd sees.
#   b. Pid 1 yields until netd's ready NetPublish has committed; that call
#      then holds netd in the kernel.
#   c. Still the seat, pid 1 tries one DHCPRELEASE for the self-test's
#      lease: the server's MAC from the ARP cache or not at all, one TX
#      publish with no second try. Unsent, the lease is left to expire.
#   d. Whether or not it went out: the kernel's stack stops (net_poll,
#      ip_set_config, ip_set_dns) and the seat closes. The kernel's indexes
#      go into the record and the held NetPublish returns; netd sends the
#      TX slots the kernel published, passes the RX slots it did not
#      consume to its stack, revokes the frame object and runs DHCP from
#      idle. The kernel copies no lease into the page: netd is its one
#      writer.
#
# Step 7 (AGAST #4745, #4875, ring plan T39) is netd's death and restart,
# armed once step d has run: sys_exit_impl quiesces the NIC first
# (driver_quiesce: MSI-X masked, its reset read back, its DMA out of the
# domain, NetInfo NoDev), invalidates NetAddr, retires netd's exchanges
# and restarts /bin/netd at most NETD_RESTARTS times a boot
# (net_netd_respawn), only while every quiesce left the NIC fit, each with
# the device grants and new link and address pages, and no frame object.
# The \harland\netd-restart boot option runs net_netd_restart_test before
# init: pid 1 kills each netd after its lease and checks NetAddr, until
# the budget is spent.
#
# A refused NIC, a missing ELF or a netd that exits before it parks leaves
# the boot with no NIC owner: logged, and the boot goes on. A netd that
# does not publish ready leaves the seat with the kernel, logged, and stays
# the seat's driver.

import klog { klog, klog_dec }
import serial { StrView }
import ritzlib.option
import ritzlib.result { Result }
import mm.shm { shm_create, shm_destroy, shm_page, shm_map }
import mm.vmm { phys_to_virt }
import cap.types { CapHandle, CAP_TYPE_IRQ, CAP_TYPE_MMIO, CAP_TYPE_SHM, CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_PUBLISH }
import cap.table { CapTable, cap_kernel_grant, cap_table_get }
import proc.table { Proc, MAX_PROCS, PROC_BLOCKED, BLOCK_WAIT, proc_state_of, proc_at, proc_current, proc_current_slot, proc_detach }
import proc.sched { sched_is_running, sched_start, sched_yield, sched_block }
import proc.table { proc_block }
import proc.waitset { irq_object_register, irq_object_bind_domain, waitset_arm, waitset_disarm }
import io { enable_interrupts, disable_interrupts, interrupts_enabled }
import driver_abi.link { NetAddr }
import net.latency { LatencyMark, NET_LATENCY_WINDOW_US, latency_open, latency_close }
import net.ring { SeatOpen, Send, SeatIndexes, ring_seat_open, ring_seat_object, ring_send_once, ring_seat_handoff }
import net.dhcp { Release, dhcp_release_frame, dhcp_print_lease }
import net.stack { net_stack_release }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import syscall.runtime.net { net_link_register, ring_driver_published, net_addr_register, net_service_register, net_handoff_arm, net_handoff_ready, net_handoff_done }
import syscall.runtime.net { ServicePage, NETD_RESTARTS, net_service_page, net_service_boot, net_service_attach_page, net_restart_arm, net_restart_armed, net_service_pid, net_addr_configured_by, net_addr_snapshot, pml4_of }
import syscall.runtime.driver { drv_device_bind, drv_device_fit, drv_device_unmask }
import syscall.runtime.process { process_create_init, process_spawn_program, process_mark_exit }
import drivers.nic { NicGrant }
import drivers.virtio.net { virtio_net_ring1_probe }
import drivers.e1000e { e1000e_ring1_probe }
import drivers.virtio.window { VioWindow, vio_window_find }
import syscall.stack { kstack_top }
import driver_abi.boot { DriverBoot, DriverWindow, DRV_RING_BASE, DRIVER_BOOT_MAGIC, DRIVER_BOOT_WINDOWS, NIC_KIND_E1000E, driver_boot_at }
import driver_abi.boot { ServiceBoot, service_boot_at }

# The driver's MSI-X table indexes: config changes (the 82574L's Other), the
# RX and TX queues (each probe aims all three at the grant's vector).
const MSIX_CONFIG: u16 = 0
const MSIX_RX: u16 = 1
const MSIX_TX: u16 = 2
const MSIX_ENTRIES: u32 = 3

# The NIC's IRQ object: above every id a boot test uses, one per requester.
const NIC_IRQ_OBJECT_BASE: u64 = 1 << 40

# Run body() on the kernel stack whose top is `top` (proc_switch.s).
extern fn kstack_call(body: u64, top: u64)

# How many times pid 1 yields for netd's first park (step 3). One is
# enough when netd parks; it yields back only on DrvIrqWait's Again.
const FIRST_PARK_YIELDS: i32 = 16

# The probe's grant, from net_ring1_prepare to net_ring1_spawn (which runs
# on another stack, through kstack_call, so takes no arguments), and the
# device's IRQ object; both again for each restart (net_netd_respawn).
var ring1_grant: NicGrant
var ring1_probed: bool = false
var ring1_obj: u64 = 0
# The first netd's pid (step 2), 0 before or without one.
var ring1_pid: u64 = 0

# Step 1, then the rest of the boot, `tail` (which starts with
# net_ring1_spawn, and never returns). When the NIC went to the ring-1
# driver, pid 1 exists and `tail` runs on pid 1's own kernel stack: the
# spawn switches to the driver's page table, which lacks the boot stack.
# On any other boot `tail` runs on the boot stack, as before.
pub fn net_ring1_boot(tail: fn())
    if net_ring1_prepare()
        kstack_call(tail as u64, kstack_top(proc_current_slot()))
    else
        tail()

# Step 1. True when the NIC was handed to the ring-1 driver: pid 1 exists
# (process_create_init).
fn net_ring1_prepare() -> bool
    let probed: Option<NicGrant> = match virtio_net_ring1_probe()
        Some(g) => Some(g)
        None => e1000e_ring1_probe()
    match probed
        Some(g) =>
            ring1_grant = g
            ring1_probed = true
        None => return false
    process_create_init()
    proc_current() != 0 as *Proc

# The pid of the first netd (step 2), 0 before or without one.
pub fn net_ring1_pid() -> u64
    ring1_pid

# The ring NIC's vector, None when no NIC was handed over (step 1).
pub fn net_ring1_vector() -> Option<u8>
    if not ring1_probed
        return None
    Some(ring1_grant.vector)

# The ring NIC's kind as the boot log names it: "virtio-net" or "e1000e".
pub fn net_ring1_nic_name() -> StrView
    if ring1_grant.kind == NIC_KIND_E1000E
        return "e1000e"
    "virtio-net"

fn packed(h: CapHandle) -> u64
    let index: u32 = h.index
    let generation: u32 = h.generation
    (index as u64) | ((generation as u64) << 32)

fn granted(h: CapHandle) -> bool
    let index: u32 = h.index
    index != 0xFFFFFFFF

fn ring1_fail(why: StrView) -> bool
    klog("[net-ring1] ")
    klog(why)
    klog(": the NIC has no owner on this boot\n")
    false

# The device as an IRQ object: latched by the grant's vector, its runs
# mapped in its private domain, and recorded for driver_quiesce (its reset
# and MSI-X table through the kernel's own mappings).
fn ring1_device_object(g: NicGrant) -> Option<u64>
    let obj: u64 = NIC_IRQ_OBJECT_BASE | g.sid as u64
    if not irq_object_register(obj, g.vector)
        return None
    if not irq_object_bind_domain(obj, g.dom)
        return None
    if not drv_device_bind(obj, g.reset, g.msix_table_va, MSIX_ENTRIES)
        return None
    Some(obj)

# The device grants to netd `pid`, a child that has not run, and its boot
# record (step 2, and each restart): a link page with the publish right,
# mapped first so it sits at DRV_RING_BASE, where netd finds DriverBoot;
# with `with_seat` (step 2 only, as pid 1) the frame object, mapped into
# netd and pid 1 (the seat); the IRQ; one MMIO handle per window. The
# record is written on the link page through the physmap before netd runs;
# netd copies it once and checks it, and the kernel trusts none of it. A
# restart's record names no frame object.
fn ring1_grant_to(pid: u64, obj: u64, g: NicGrant, with_seat: bool) -> bool
    let pml4: u64 = pml4_of(pid as u32)
    if pml4 == 0
        return ring1_fail("netd has no page table")
    # The link page: only netd maps it; NetPublish samples it.
    let link_obj: u64 = match shm_create(1)
        Some(id) => id
        None => return ring1_fail("no link page")
    let link: CapHandle = cap_kernel_grant(pid as u32, CAP_TYPE_SHM, CAP_RIGHT_READ | CAP_RIGHT_WRITE | CAP_RIGHT_PUBLISH, link_obj)
    if not granted(link)
        shm_destroy(link_obj)
        return ring1_fail("the link page was not granted")
    if shm_map(pid as u32, pml4, link_obj, true) != DRV_RING_BASE as i64
        # netd's exit (the caller marks it) drops the handle and the object.
        return ring1_fail("the link page is not netd's first mapping")
    net_link_register(link_obj)
    var frame: u64 = 0
    if with_seat
        frame = match ring_seat_open(pid)
            SeatOpen.Opened(h) => h
            _ => return ring1_fail("the frame object was not made")
    let irq: CapHandle = cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, obj)
    if not granted(irq)
        return ring1_fail("the IRQ capability was not granted")
    var boot: DriverBoot
    boot.magic = DRIVER_BOOT_MAGIC
    boot.window_count = 0
    boot.irq = packed(irq)
    boot.frame = frame
    boot.link = packed(link)
    boot.msix_config = MSIX_CONFIG
    boot.msix_rx = MSIX_RX
    boot.msix_tx = MSIX_TX
    boot.nic = g.kind
    var i: u32 = 0
    while i < g.window_count and i < DRIVER_BOOT_WINDOWS
        let w: VioWindow = match vio_window_find(g.window_ids[i])
            Some(x) => x
            None => return ring1_fail("a recorded window is gone")
        let h: CapHandle = cap_kernel_grant(pid as u32, CAP_TYPE_MMIO, CAP_RIGHT_READ | CAP_RIGHT_WRITE, w.id)
        if not granted(h)
            return ring1_fail("an MMIO window was not granted")
        boot.windows[i] = DriverWindow { handle: packed(h), offset: w.offset as u32, length: w.length as u32, notify_multiplier: w.notify_multiplier, cfg_type: g.window_types[i], _pad: [0, 0, 0] }
        boot.window_count = i + 1
        i = i + 1
    *driver_boot_at(phys_to_virt(shm_page(link_obj, 0))) = boot
    true

# `pid` is parked on its own wait set (DrvIrqWait).
fn ring1_parked(pid: u64) -> bool
    var i: i32 = 0
    while i < MAX_PROCS
        let p: *Proc = proc_at(i)
        if p.pid == pid
            return proc_state_of(p) == PROC_BLOCKED and p.block == BLOCK_WAIT
        i = i + 1
    false

# Steps 2-4, as pid 1 on its own kernel stack (kstack_call), the scheduler
# stopped. Logs "[net-ring1] /bin/netd pid P parked: generation 2
# published" when netd is the NIC's owner. Step 4 runs whether or not netd
# did: step 1 made pid 1, so run_init starts no scheduler of its own, and a
# boot whose netd never ran (no /bin/netd in its initramfs, say: a q35
# boot test's default e1000e, AGAST #4893) would otherwise run init with no
# tick.
pub fn net_ring1_spawn()
    if not ring1_probed or ring1_pid != 0 or sched_is_running()
        return
    let netd: Option<u64> = ring1_spawn_netd()
    # Step 4: the tick from now on; run_init does not start it again.
    sched_start(proc_current_slot())
    let spawned: u64 = match netd
        Some(p) => p
        None => return
    if ring1_parked(spawned) and ring_driver_published()
        klog("[net-ring1] /bin/netd pid ")
        klog_dec(spawned as i64)
        klog(" parked: generation 2 published\n")
    else
        klog("[net-ring1] /bin/netd pid ")
        klog_dec(spawned as i64)
        klog(" did not park with its link published: the NIC has no owner on this boot\n")

# Steps 2 and 3: the device object, netd's spawn and grants, and netd's run
# to its first park. Its pid, or None when there is no netd (logged).
fn ring1_spawn_netd() -> Option<u64>
    let g: NicGrant = ring1_grant
    let obj: u64 = match ring1_device_object(g)
        Some(id) => id
        None =>
            ring1_fail("the device's IRQ object was not made")
            return None
    ring1_obj = obj
    let pid: u64 = match process_spawn_program("/bin/netd")
        Result.Ok(p) => p
        Result.Err(e) =>
            klog("[net-ring1] /bin/netd was not spawned (errno ")
            klog_dec(e as i64)
            klog("): the NIC has no owner on this boot\n")
            return None
    # Nobody waits for netd: its exit leaves no zombie (#4745).
    proc_detach(pid)
    if not ring1_grant_to(pid, obj, g, true)
        # It exits on its way to user mode (reap_if_marked); the seat and
        # every grant go with it.
        process_mark_exit(pid)
        sched_yield()
        return None
    ring1_pid = pid
    # Step 3: netd runs, uninterrupted, until its first park.
    var yields: i32 = 0
    while not ring1_parked(pid) and yields < FIRST_PARK_YIELDS
        sched_yield()
        yields = yields + 1
    Some(pid)

# ============================================================================
# Step 6: the frame-seat handoff to /bin/netd (AGAST #4744)
# ============================================================================

# How long pid 1 waits for netd's ready NetPublish. netd makes a handful of
# syscalls before it, with no network wait (the link is already published).
const NETD_READY_US: u64 = 2000000

fn seat_kept(why: StrView)
    klog("[net] seat stays with the kernel: ")
    klog(why)
    klog("\n")

# netd `pid`'s address page (step a, and each restart): granted, its
# ServiceBoot written, registered as the address object, and its handle
# enqueued as ATTACH on netd's inbox, all before netd is the registered
# service. The page, or None with nothing of it registered (a handle that
# was granted goes with netd's exit, or stays unused).
fn netd_service_page(pid: u64) -> Option<ServicePage>
    let page: ServicePage = match net_service_page(pid as u32)
        Some(p) => p
        None => return None
    net_service_boot(page)
    net_addr_register(page.object_id)
    if not net_service_attach_page(pid as u32, page)
        net_addr_register(0)
        return None
    Some(page)

# netd `pid` still has its capability table: it has not exited.
fn netd_alive(pid: u64) -> bool
    cap_table_get(pid as u32) != 0 as *CapTable

# Step c: one DHCPRELEASE for the kernel's lease, if it has one. Logs
# "[net] DHCPRELEASE sent for A" or "... not sent: why"; nothing when
# there was no lease (no self-test window ran DHCP).
fn seat_release()
    var frame: [576]u8
    let len: u32 = match dhcp_release_frame(@frame)
        Release.Frame(n) => n
        Release.NoLease => return
        Release.NoServerMac =>
            klog("[net] DHCPRELEASE not sent: the server's MAC is not in the ARP cache\n")
            return
        Release.TooSmall =>
            klog("[net] DHCPRELEASE not sent: no room for the frame\n")
            return
    let f: [u8] = @frame
    match ring_send_once(f[0..len as i64])
        Send.Sent =>
            klog("[net] DHCPRELEASE sent for ")
            dhcp_print_lease()
            klog("\n")
        Send.Full => klog("[net] DHCPRELEASE not sent: the TX ring is full\n")
        Send.NoDriver => klog("[net] DHCPRELEASE not sent: the driver is gone\n")
        Send.BadLength => klog("[net] DHCPRELEASE not sent: a bad frame length\n")

# Step 6, as pid 1 after the diagnostics: a no-op unless this boot's NIC
# went to netd and its link is published (D7: an untranslated boot has no
# netd). Logs "[net] seat -> netd pid P" once netd's stack owns the seat:
# the pid of step 2, since nothing is spawned here.
pub fn net_seat_handoff()
    if ring1_pid == 0 or not ring_driver_published()
        return
    let pid: u64 = ring1_pid
    match ring_seat_object()
        Some(_) => pass
        None =>
            seat_kept("no frame seat is open")
            return
    if not netd_alive(pid)
        seat_kept("netd is gone")
        return
    let page: ServicePage = match netd_service_page(pid)
        Some(p) => p
        None =>
            seat_kept("netd's address page was not made")
            return
    net_service_register(pid as u32)
    net_handoff_arm(pid as u32)
    # Step b: netd maps the page and runs to its ready NetPublish, which
    # holds it there.
    let deadline: u64 = deadline_after_us(NETD_READY_US)
    while not net_handoff_ready() and netd_alive(pid) and not deadline_passed(deadline)
        sched_yield()
    if not net_handoff_ready()
        # netd stays the seat's driver; its ready publish, if it comes, is
        # refused (the address object is no longer registered).
        net_handoff_done()
        net_service_register(0)
        net_addr_register(0)
        seat_kept("netd did not publish ready")
        return
    # Steps c and d: the release, then the switch, whatever the release did.
    seat_release()
    net_stack_release()
    let at: SeatIndexes = match ring_seat_handoff(pid)
        Some(i) => i
        None =>
            # netd went meanwhile: its exit runs the driver's death.
            net_handoff_done()
            seat_kept("netd is gone")
            return
    let boot: *ServiceBoot = service_boot_at(phys_to_virt(shm_page(page.object_id, 0)))
    boot.seat_rx_read = at.rx_read
    boot.seat_tx_write = at.tx_write
    klog("[net] seat -> netd pid ")
    klog_dec(pid as i64)
    klog("\n")
    # Step 7: from now on netd's death is restarted.
    net_restart_arm()
    net_handoff_done()

# ============================================================================
# Step 7: netd's restart (AGAST #4745, #4875)
# ============================================================================

# What net_netd_respawn did. Not a Result: VtdDma and goliath's ErrorCode,
# in this module's import closure, declare `Ok` too (driver.ritz).
pub enum Respawn
    Started(u64)                     # the replacement's pid
    Unfit                            # a quiesce did not confirm the reset, or quarantined DMA
    Spawn                            # /bin/netd was not spawned
    Grants                           # its device grants or link page were not made
    Page                             # its address page was not made

# A replacement netd, in the dead one's sys_exit_impl after its backoff
# (syscall/runtime/process.ritz netd_restart): only onto a NIC whose
# quiesces all confirmed the reset and quarantined nothing, with what the
# first netd got but the seat: a new IRQ-owner record on the same IRQ
# object with its MSI-X entries unmasked, one MMIO handle per window, a new
# link page (DriverBoot names no frame object) and a new address page as
# ATTACH, then the registration. It resets the device itself, as every
# bring-up does. Its pid, or why there is none.
pub fn net_netd_respawn() -> Respawn
    if not drv_device_fit(ring1_obj)
        return Respawn.Unfit
    let pid: u64 = match process_spawn_program("/bin/netd")
        Result.Ok(p) => p
        Result.Err(_) => return Respawn.Spawn
    proc_detach(pid)
    drv_device_unmask(ring1_obj)
    if not ring1_grant_to(pid, ring1_obj, ring1_grant, false)
        # Never the registered service: its exit restarts nothing.
        process_mark_exit(pid)
        return Respawn.Grants
    match netd_service_page(pid)
        Some(_) => pass
        None =>
            process_mark_exit(pid)
            return Respawn.Page
    net_service_register(pid as u32)
    Respawn.Started(pid)

# ============================================================================
# The netd restart test (AGAST #4745, the \harland\netd-restart option)
# ============================================================================

# How long pid 1 waits for each netd's lease: slirp answers DHCP at once,
# and a restart's backoff is at most 1 s.
const NETD_LEASE_US: u64 = 15000000
# How long a killed netd may take to be unregistered (its exit path runs
# before the backoff).
const NETD_DEATH_US: u64 = 2000000
# How long NetAddr must stay NoDev once the budget is spent: past the
# longest backoff and a spawn.
const NETD_BUDGET_SETTLE_US: u64 = 2000000

fn restart_fail(why: StrView, pid: u32)
    klog("[net-restart] FAIL: netd pid ")
    klog_dec(pid as i64)
    klog(" ")
    klog(why)
    klog("\n")

fn restart_wait(us: u64)
    let deadline: u64 = deadline_after_us(us)
    while not deadline_passed(deadline)
        sched_yield()

# As pid 1 after the handoff, before init (kernel_tail), when `enabled`:
# NETD_RESTARTS + 1 rounds of waiting for the running netd's lease (its own
# configured NetPublish, then its park in ShmWait: netd logs "[netd]
# configured A" between the two, so the line is out before the kill,
# AGAST #4855), killing it ("[net-restart] killing netd pid P after its
# lease") and checking that NetAddr answers NoDev once it is unregistered
# ("[net-restart] NetAddr NoDev after netd pid P died"); the kernel
# restarts it between rounds.
# Then NetAddr must still be NoDev NETD_BUDGET_SETTLE_US later ("[net-restart]
# NetAddr still NoDev 2000 ms after the budget was spent"). Any other
# outcome logs "[net-restart] FAIL: ..." and stops. Nothing on a boot with
# no netd.
pub fn net_netd_restart_test(enabled: bool)
    if not enabled
        return
    if not net_restart_armed()
        return
    var round: u32 = 0
    while round <= NETD_RESTARTS
        let leased: u64 = deadline_after_us(NETD_LEASE_US)
        var pid: u32 = 0
        var leased_here: bool = false
        while not leased_here and not deadline_passed(leased)
            pid = net_service_pid()
            leased_here = net_addr_configured_by(pid) and ring1_parked(pid as u64)
            if not leased_here
                sched_yield()
        if not leased_here
            restart_fail("never reached configured", pid)
            return
        klog("[net-restart] killing netd pid ")
        klog_dec(pid as i64)
        klog(" after its lease\n")
        match process_mark_exit(pid as u64)
            Result.Ok(_) => pass
            Result.Err(_) =>
                restart_fail("could not be marked to exit", pid)
                return
        let died: u64 = deadline_after_us(NETD_DEATH_US)
        var gone: bool = false
        while not gone and not deadline_passed(died)
            gone = net_service_pid() != pid
            if not gone
                sched_yield()
        if not gone
            restart_fail("did not die", pid)
            return
        match net_addr_snapshot()
            Some(_) =>
                restart_fail("died and NetAddr still answers", pid)
                return
            None => pass
        klog("[net-restart] NetAddr NoDev after netd pid ")
        klog_dec(pid as i64)
        klog(" died\n")
        round = round + 1
    restart_wait(NETD_BUDGET_SETTLE_US)
    match net_addr_snapshot()
        Some(_) =>
            restart_fail("was restarted past the budget: NetAddr answers", net_service_pid())
            return
        None => pass
    if net_service_pid() != 0
        restart_fail("was restarted past the budget", net_service_pid())
        return
    klog("[net-restart] NetAddr still NoDev 2000 ms after the budget was spent\n")

# ============================================================================
# The netd latency window (AGAST #4768, the \harland\net-responder option)
# ============================================================================

# Pid 1 sleeps until TSC `deadline`, parked on its own wait set, so the
# window's switches are the driver's and netd's and none of them is a pid 1
# that yields in a loop. A wake before the deadline (a latch on a handle
# pid 1 still holds) parks it again.
fn pid1_sleep_until(deadline: u64)
    let was: bool = interrupts_enabled()
    let slot: i32 = proc_current_slot()
    disable_interrupts()
    while not deadline_passed(deadline)
        waitset_arm(slot, deadline)
        proc_block(BLOCK_WAIT, 0)
        sched_block()
    waitset_disarm(slot)
    if was
        enable_interrupts()

# As pid 1 after the handoff, before init (kernel_tail), when `enabled`: wait
# for netd's lease as the restart test does, then open the latency window
# (net/latency.ritz, owner "netd") on that address and sleep through it,
# then the UDP window (owner "netd-udp", net_latency_udp_window).
# Nothing on a boot with no netd.
pub fn net_latency_netd_window(enabled: bool)
    if not enabled or not net_restart_armed()
        return
    let leased: u64 = deadline_after_us(NETD_LEASE_US)
    var pid: u32 = 0
    var ready: bool = false
    while not ready and not deadline_passed(leased)
        pid = net_service_pid()
        ready = net_addr_configured_by(pid) and ring1_parked(pid as u64)
        if not ready
            sched_yield()
    if not ready
        klog("[net-latency] netd has no lease: no window\n")
        return
    let addr: NetAddr = match net_addr_snapshot()
        Some(a) => a
        None =>
            klog("[net-latency] netd has no lease: no window\n")
            return
    let mark: LatencyMark = latency_open("netd", addr.address)
    pid1_sleep_until(deadline_after_us(NET_LATENCY_WINDOW_US))
    latency_close("netd", mark)
    net_latency_udp_window(addr.address)

# How long /bin/udp-echo gets to attach and bind before the UDP window opens:
# a bind is a few ring rounds, so this is slack, and the script's warm-up
# datagrams cover a late one.
const UDP_ECHO_SETTLE_US: u64 = 500000

# The UDP round trip (AGAST #4768 part 2), right after netd's ICMP window:
# spawn /bin/udp-echo (indium, port 7), let it bind, open the "netd-udp"
# window on netd's address and sleep through it, then reap udp-echo. The
# window's switches and syscalls are the driver's, netd's and udp-echo's,
# so the script's per-round-trip counts carry the app hop the ICMP window
# lacks.
fn net_latency_udp_window(address: [4]u8)
    let pid: u64 = match process_spawn_program("/bin/udp-echo")
        Result.Ok(p) => p
        Result.Err(e) =>
            klog("[net-latency] /bin/udp-echo was not spawned (errno ")
            klog_dec(e as i64)
            klog("): no udp window\n")
            return
    # Nobody waits for it: its exit leaves no zombie (#4745).
    proc_detach(pid)
    pid1_sleep_until(deadline_after_us(UDP_ECHO_SETTLE_US))
    let mark: LatencyMark = latency_open("netd-udp", address)
    pid1_sleep_until(deadline_after_us(NET_LATENCY_WINDOW_US))
    latency_close("netd-udp", mark)
    match process_mark_exit(pid)
        Result.Ok(_) => sched_yield()
        Result.Err(_) => klog("[net-latency] udp-echo exited inside its window\n")
