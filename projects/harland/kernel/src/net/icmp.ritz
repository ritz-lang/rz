# net/icmp.ritz - Internet Control Message Protocol
#
# Handles ICMP echo (ping) request and reply.

import klog { klog, klog_dec }
import net.types { IP_PROTO_ICMP, ETHERTYPE_IPV4, ICMP_ECHO_REQUEST, ICMP_ECHO_REPLY, ICMP_HEADER_SIZE }
import net.ip { ip_checksum, ip_build_header, ip_get_next_hop }
import net.arp { arp_cache_lookup, arp_send_request }
import net.eth { eth_build_frame }

# Forward declaration - send through active network device
extern fn net_send(data: *u8, len: u32) -> i32

# ============================================================================
# ICMP State
# ============================================================================

var icmp_seq: u16 = 0
var icmp_waiting: bool = false
var icmp_last_rtt: u64 = 0

# Echo replies seen, counted once per sequence number below 1024 (a bit per
# seq). A frame the NIC sent twice because its TX buffer was overwritten
# before the device read it (AGAST #4073) shows up as a repeated seq, so
# this counts the requests that really crossed the wire, not the replies.
var icmp_reply_seen: [128]u8
var icmp_distinct_replies: u32 = 0

# Inbound echo requests answered (AGAST #1851). The pre-init responder window
# stops polling once a peer's request has been answered, and these totals are
# printed into the serial log as the acceptance evidence.
var icmp_echo_requests: u32 = 0
var icmp_echo_replies_sent: u32 = 0

# Whether each inbound echo request and its reply is logged. The latency
# window (net/latency.ritz, AGAST #4768) turns it off: klog writes COM1
# synchronously, a VM exit per byte under QEMU, and two lines per echo
# measured the serial port, not the stack. The counters above still count.
var icmp_log_echoes: bool = true

# ============================================================================
# ICMP Echo Header Structure
# ============================================================================

pub struct IcmpEchoHeader
    type_code: u8       # Type (8=request, 0=reply)
    code: u8            # Code (always 0 for echo)
    checksum: u16
    id: u16
    seq: u16

# ============================================================================
# Send ICMP Echo Request (Ping)
# ============================================================================

pub fn icmp_ping(dst_ip: *u8) -> i32
    var frame: [128]u8
    var ip_buf: [64]u8
    var icmp_buf: [40]u8

    # Build ICMP header
    icmp_buf[0] = ICMP_ECHO_REQUEST
    icmp_buf[1] = 0
    icmp_buf[2] = 0  # Checksum placeholder
    icmp_buf[3] = 0
    icmp_buf[4] = 0  # ID high
    icmp_buf[5] = 1  # ID low
    icmp_seq = icmp_seq +% 1    # the u16 echo sequence wraps (R63)
    icmp_buf[6] = ((icmp_seq >> 8) & 0xFF) as u8
    icmp_buf[7] = (icmp_seq & 0xFF) as u8

    # Add some data payload
    var i: i32 = 8
    while i < 40
        icmp_buf[i] = ((i - 8) as u8)
        i = i + 1

    let icmp_len: u32 = 40

    # Calculate ICMP checksum
    let cksum: u16 = ip_checksum(@icmp_buf[0], icmp_len)
    icmp_buf[2] = ((cksum >> 8) & 0xFF) as u8
    icmp_buf[3] = (cksum & 0xFF) as u8

    # Build IP header
    let ip_len: u32 = ip_build_header(@ip_buf[0], dst_ip, IP_PROTO_ICMP, icmp_len)

    # Copy ICMP after IP header
    var j: i32 = 0
    while j < icmp_len as i32
        ip_buf[ip_len as i32 + j] = icmp_buf[j]
        j = j + 1

    # Get next hop IP (gateway if not local, direct if local)
    let next_hop: *u8 = ip_get_next_hop(dst_ip)

    # Look up MAC address
    var dst_mac: [6]u8
    if arp_cache_lookup(next_hop, @dst_mac[0]) < 0
        # Need to ARP for next hop
        klog("[icmp] ARP lookup needed for next hop\n")
        arp_send_request(next_hop)
        return -1  # Caller should retry

    # Build Ethernet frame
    let frame_len: u32 = eth_build_frame(@frame[0], @dst_mac[0], ETHERTYPE_IPV4, @ip_buf[0], ip_len + icmp_len)

    icmp_waiting = true

    # Send
    return net_send(@frame[0], frame_len)

# ============================================================================
# Handle Received ICMP Packet
# ============================================================================

pub fn icmp_handle_packet(icmp_buf: *u8, len: u32, src_ip: *u8, src_mac: *u8)
    if len < ICMP_HEADER_SIZE
        return

    let icmp_type: u8 = *(icmp_buf + 0)

    if icmp_type == ICMP_ECHO_REPLY
        klog("[icmp] Reply from ")
        icmp_print_ip(src_ip)
        klog(" seq=")
        let seq: u16 = ((*(icmp_buf + 6) as u16) << 8) | (*(icmp_buf + 7) as u16)
        klog_dec(seq as i64)
        klog("\n")
        icmp_waiting = false
        icmp_note_reply(seq)

    else if icmp_type == ICMP_ECHO_REQUEST
        # Respond to ping
        icmp_echo_requests = icmp_echo_requests + 1
        if icmp_log_echoes
            klog("[icmp] Echo request from ")
            icmp_print_ip(src_ip)
            klog("\n")

        # Send echo reply
        icmp_send_reply(icmp_buf, len, src_ip, src_mac)

# ============================================================================
# Send ICMP Echo Reply
# ============================================================================

fn icmp_send_reply(request_buf: *u8, request_len: u32, dst_ip: *u8, next_hop_mac: *u8)
    # A standard Linux ping carries 56 bytes of data, so the ICMP message is
    # 64 bytes; the IP header adds 20 and the Ethernet header 14. The old
    # 64-byte ip_buf overflowed on exactly that size and corrupted the frame
    # being built, which is why a peer's ping went unanswered (AGAST #1851).
    var frame: [192]u8
    var ip_buf: [160]u8
    var icmp_buf: [160]u8

    # Copy the request data
    var i: i32 = 0
    while i < request_len as i32 and i < 128
        icmp_buf[i] = *(request_buf + i as i64)
        i = i + 1

    let icmp_len: u32 = request_len
    if icmp_len > 128
        return  # Too large

    # Change type to reply
    icmp_buf[0] = ICMP_ECHO_REPLY
    icmp_buf[1] = 0

    # Zero checksum and recalculate
    icmp_buf[2] = 0
    icmp_buf[3] = 0
    let cksum: u16 = ip_checksum(@icmp_buf[0], icmp_len)
    icmp_buf[2] = ((cksum >> 8) & 0xFF) as u8
    icmp_buf[3] = (cksum & 0xFF) as u8

    # Build IP header
    let ip_len: u32 = ip_build_header(@ip_buf[0], dst_ip, IP_PROTO_ICMP, icmp_len)

    # Copy ICMP after IP header
    var j: i32 = 0
    while j < icmp_len as i32
        ip_buf[ip_len as i32 + j] = icmp_buf[j]
        j = j + 1

    # The L2 destination is the frame's source MAC: the peer itself when it
    # is on-link, or the router that relayed the request. ARP cannot supply
    # this when the request arrived through a router that resolved us on the
    # peer's behalf (AGAST #1851: on EC2 the VPC relayed the peer's ping and
    # the ARP cache held no entry for the peer's address).
    var dst_mac: [6]u8
    var have_mac: u8 = 0
    if next_hop_mac != (0 as *u8)
        var k: i32 = 0
        while k < 6
            dst_mac[k] = *(next_hop_mac + k as i64)
            if dst_mac[k] != 0
                have_mac = 1
            k = k + 1

    # Fall back to the neighbour table when no source MAC was carried.
    if have_mac == 0
        let next_hop: *u8 = ip_get_next_hop(dst_ip)
        if arp_cache_lookup(next_hop, @dst_mac[0]) < 0
            klog("[icmp] Cannot send reply: no MAC for sender\n")
            return

    # Build Ethernet frame
    let frame_len: u32 = eth_build_frame(@frame[0], @dst_mac[0], ETHERTYPE_IPV4, @ip_buf[0], ip_len + icmp_len)

    # Send
    let sent: i32 = net_send(@frame[0], frame_len)
    if sent >= 0
        icmp_echo_replies_sent = icmp_echo_replies_sent + 1
        if icmp_log_echoes
            klog("[icmp] Sent reply to ")
            icmp_print_ip(dst_ip)
            klog("\n")

# ============================================================================
# Query State
# ============================================================================

pub fn icmp_is_waiting() -> bool
    return icmp_waiting

pub fn icmp_get_last_rtt() -> u64
    return icmp_last_rtt

pub fn icmp_clear_waiting()
    icmp_waiting = false

fn icmp_note_reply(seq: u16)
    if seq >= 1024
        return
    let byte: u16 = seq >> 3
    let bit: u8 = (1 as u8) << ((seq & 7) as u8)
    if (icmp_reply_seen[byte] & bit) != 0
        return
    icmp_reply_seen[byte] = icmp_reply_seen[byte] | bit
    icmp_distinct_replies = icmp_distinct_replies + 1

# Echo replies with a sequence number not seen before (seq < 1024 only)
pub fn icmp_distinct_reply_count() -> u32
    return icmp_distinct_replies

# Inbound echo requests seen, and replies we actually sent for them (#1851).
pub fn icmp_echo_request_count() -> u32
    return icmp_echo_requests

pub fn icmp_echo_reply_sent_count() -> u32
    return icmp_echo_replies_sent

# Log each inbound echo request and reply (the default), or count them only.
pub fn icmp_set_echo_log(on: bool)
    icmp_log_echoes = on

# ============================================================================
# Debug
# ============================================================================

fn icmp_print_ip(ip: *u8)
    klog_dec(*(ip + 0) as i64)
    klog(".")
    klog_dec(*(ip + 1) as i64)
    klog(".")
    klog_dec(*(ip + 2) as i64)
    klog(".")
    klog_dec(*(ip + 3) as i64)
