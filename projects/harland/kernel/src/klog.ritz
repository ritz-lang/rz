# Harland Kernel Logging (klog) and the Crash Ring Buffer
#
# The kernel's one log API (AGAST #1885). Every kernel message, text and
# numbers alike, goes through klog_bytes, which writes it to COM1 and to the
# ring buffer that exceptions.ritz dumps on a crash (ring_dump, bound there
# by `extern fn`). Before #1885 the kernel had four entry points and most of
# kernel_main used prints(), which wrote serial only: the crash dump showed
# almost none of the boot. Numbers are formatted by ritzlib.fmt.digits, the
# one digit routine; klog_dec is signed, so -1 prints "-1" (serial_print_dec
# took a u64 and printed 18446744073709551615).
#
# Moved out of main.ritz by AGAST #2752.
#
# The framebuffer console (drivers/display/fbcon.ritz, AGAST #4868) is the
# third sink, once display_console_start has registered it:
# klog_console_start replays the ring onto it, so the screen shows the boot
# from its first line, and the panic screen ends with klog_console_tail, the
# log's last lines. klog holds the console as a function so it links without
# the display driver: every host test that logs links klog alone.
#
# klog_lock (AGAST #4879, docs/SMP_USER.md §2 "The leaf locks"): the log is
# the one piece of kernel state every CPU writes, so it has a leaf lock
# rather than an owner. One klog call is atomic: its bytes reach COM1, the
# console and the ring together, and another CPU's call goes wholly before
# or after it. A line built from several calls can interleave with another
# CPU's at call boundaries, never inside one. The lock also covers COM1's
# output ring (serial.ritz), which sys_write fills and the COM1 IRQ drains:
# both go through klog_serial_write and klog_serial_drain, so polled klog
# output and the ring's bytes never meet on the wire mid-call. It is a
# ticket lock taken with IF saved and cleared, and it calls up into nothing
# but the sinks (fbcon_write takes the console's own lock inside it).
# A kernel panic calls klog_emergency: from then on klog takes the lock
# only if it is free and writes anyway, so a CPU that dies holding it
# cannot silence the report. The lock starts zeroed: free, and leaving IF
# alone, because every host test that logs links klog and cli faults there.
# kernel_main turns the IF save on (klog_irqsave(true)) before it first
# enables interrupts; until then IF is clear anyway. The lock is the same
# ticket lock as sync/spin.ritz's, written out here so klog stays a leaf:
# the host tests that log compile klog, serial and io alone.

import serial { StrView, serial_present, serial_out, serial_out_byte, serial_buffer_write, serial_drain_output }
import io { interrupts_enabled, disable_interrupts, enable_interrupts, cpu_pause }
import ritzlib.fmt.digits { fmt_i64_into, fmt_u64_into, fmt_u64_radix_into }

# klog_lock's tickets: `next` the one the next taker draws, `serving` the
# holder's. Zeroed: free. IF save off until kernel_main (above).
var klog_next: u32 = 0
var klog_serving: u32 = 0
var klog_save_if: bool = false
var klog_unlocked: bool = false

# Whether klog_lock saves and clears IF (kernel_main: on; a hosted test
# leaves it off).
pub fn klog_irqsave(on: bool)
    klog_save_if = on

# A kernel panic is being reported: klog no longer waits for the lock.
pub fn klog_emergency()
    klog_unlocked = true

# Some CPU holds klog_lock (or waits for it): for test/test_klog.ritz.
pub fn klog_lock_held() -> bool
    atomic_load(@klog_next) != atomic_load(@klog_serving)

# What klog_take took: release it with klog_give.
pub struct LogHold
    held: bool              # the lock is ours (not an emergency write past it)
    was_on: bool            # IF was set before the take

fn klog_take() -> LogHold
    var was_on: bool = false
    if klog_save_if
        was_on = interrupts_enabled()
        disable_interrupts()
    if klog_unlocked
        # A panic: take the lock only if it is free, and write anyway.
        let serving: u32 = atomic_load(@klog_serving)
        let got: bool = atomic_cmpxchg(@klog_next, serving, serving +% 1) == serving
        return LogHold { held: got, was_on: was_on }
    let ticket: u32 = atomic_fetch_add(@klog_next, 1)
    while atomic_load(@klog_serving) != ticket
        cpu_pause()
    LogHold { held: true, was_on: was_on }

fn klog_give(h: LogHold)
    if h.held
        atomic_store(@klog_serving, atomic_load(@klog_serving) +% 1)
    if h.was_on
        enable_interrupts()

# Take and keep klog_lock as another CPU would, until klog_test_release:
# test/test_klog.ritz proves klog_emergency writes past a held lock.
pub fn klog_test_hold() -> LogHold
    klog_take()

pub fn klog_test_release(h: LogHold)
    klog_give(h)

# ============================================================================
# Ring Buffer
# ============================================================================
#
# Statically allocated (BSS), usable before the heap exists. Overwrites the
# oldest bytes when full. 16 KiB holds a whole QEMU boot log (~7 KiB up to
# init) with room for what follows.

pub const RING_BUFFER_SIZE: u64 = 16384

var ring_buffer: [16384]u8
var ring_head: u64 = 0         # Next write position
var ring_wrapped: bool = false # Has the buffer wrapped around?
var ring_total: u64 = 0        # Bytes ever written (klog_mark)

fn ring_write_byte(c: u8)
    ring_buffer[ring_head as i64] = c
    ring_total = ring_total + 1
    ring_head = ring_head + 1
    if ring_head >= RING_BUFFER_SIZE
        ring_head = 0
        ring_wrapped = true

# Forget the ring's contents.
pub fn ring_clear()
    ring_head = 0
    ring_wrapped = false
    ring_total = 0

# Valid bytes in the ring.
fn ring_len() -> u64
    if ring_wrapped
        return RING_BUFFER_SIZE
    ring_head

# Byte i of the ring in chronological order (0 = oldest).
fn ring_at(i: u64) -> u8
    if ring_wrapped
        return ring_buffer[((ring_head + i) % RING_BUFFER_SIZE) as i64]
    ring_buffer[i as i64]

# Copy the newest min(ring length, max) bytes, oldest first, into dst.
# Returns the count.
pub fn ring_copy(dst: *u8, max: i64) -> i64
    var n: u64 = ring_len()
    var skip: u64 = 0
    if max >= 0 and n > max as u64
        skip = n - max as u64
        n = max as u64
    var i: u64 = 0
    while i < n
        *(dst + i as i64) = ring_at(skip + i)
        i = i + 1
    n as i64

# Write the whole ring to serial, oldest first, between markers. Serial
# only: the dump must not feed the ring it is reading.
pub fn ring_dump()
    serial_out("\n=== RING BUFFER DUMP (kernel log) ===\n")
    let n: u64 = ring_len()
    var i: u64 = 0
    while i < n
        serial_out_byte(ring_at(i))
        i = i + 1
    serial_out("\n=== END RING BUFFER ===\n")

# The console sink (fbcon_write once registered); writes before then go to
# serial and the ring only.
var klog_console_on: bool = false
var klog_console_sink: fn(StrView)

# Make `sink` the console from here on, without a replay
# (klog_console_start replays; test/test_fbcon.ritz registers alone).
pub fn klog_console(sink: fn(StrView))
    klog_console_sink = sink
    klog_console_on = true

# Ring bytes [from, to) (0 = oldest) onto the console alone, in chunks: a
# write per byte would redraw the cursor per byte.
fn ring_to_console(from: u64, to: u64)
    if not klog_console_on
        return
    let sink: fn(StrView) = klog_console_sink
    var chunk: [256]u8
    let n: u64 = to
    var i: u64 = from
    while i < n
        var k: i64 = 0
        while k < 256 and i < n
            chunk[k] = ring_at(i)
            k = k + 1
            i = i + 1
        sink(StrView { ptr: @chunk[0], len: k })

# The console just started: register it, then show it everything logged so
# far.
pub fn klog_console_start(sink: fn(StrView))
    klog_console(sink)
    ring_to_console(0, ring_len())

# Where the log is now, for klog_console_tail: the count of bytes ever
# logged.
pub fn klog_mark() -> u64
    ring_total

# The last `lines` lines logged before `mark` (klog_mark), onto the console:
# the panic screen's recent log, without the report logged after the mark.
# A final '\n' does not count as a line of its own.
pub fn klog_console_tail(lines: u32, mark: u64)
    if lines == 0 or mark > ring_total
        return
    let after: u64 = ring_total - mark
    let len: u64 = ring_len()
    if after >= len
        return
    let n: u64 = len - after
    var start: u64 = n
    var seen: u32 = 0
    while start > 0
        if ring_at(start - 1) == 10 and start < n
            seen = seen + 1
            if seen == lines
                break
        start = start - 1
    ring_to_console(start, n)

# ============================================================================
# klog: the one sink
# ============================================================================

# COM1 as well as the ring. A hosted unit test has no I/O ports and turns
# this off to read the ring alone (test/test_klog.ritz).
var klog_to_serial: bool = true

pub fn klog_serial(on: bool)
    klog_to_serial = on

# Every kernel message ends here: serial, the screen, then the ring, all
# under klog_lock.
fn klog_bytes(ptr: *u8, len: i64)
    let h: LogHold = klog_take()
    klog_bytes_locked(StrView { ptr: ptr, len: len })
    klog_give(h)

fn klog_bytes_locked(text: StrView)
    let ptr: *u8 = text.ptr
    let len: i64 = text.len
    if klog_to_serial
        serial_out(StrView { ptr: ptr, len: len })
    if klog_console_on
        let sink: fn(StrView) = klog_console_sink
        sink(StrView { ptr: ptr, len: len })
    var i: i64 = 0
    while i < len
        ring_write_byte(*(ptr + i))
        i = i + 1

# sys_write's bytes onto COM1's output ring, under klog_lock: how many it
# took (fewer than `bytes` when the ring is full).
pub fn klog_serial_write(bytes: StrView) -> i64
    let h: LogHold = klog_take()
    let n: i64 = serial_buffer_write(bytes.ptr, bytes.len)
    klog_give(h)
    n

# Drain COM1's output ring to the UART (its IRQ, and sys_write when the ring
# is full), under klog_lock.
pub fn klog_serial_drain()
    let h: LogHold = klog_take()
    serial_drain_output()
    klog_give(h)

# Log a string: a "..." literal, or a runtime view (a path, a process name).
pub fn klog(s: StrView)
    klog_bytes(s.ptr, s.len)

# The boot banner, kernel_main's first log lines (tools/test_tier1_boot.sh
# matches them byte for byte), then whether serial_start found a COM1: with
# none, the screen is the only place the log shows (AGAST #4868).
pub fn klog_banner()
    klog("\n")
    klog("========================================\n")
    klog("    Hello from Harland!\n")
    klog("========================================\n")
    klog("\n")
    klog("Harland kernel starting...\n")
    if not serial_present()
        klog("No COM1 (serial probe): the console is the framebuffer alone\n")

# ============================================================================
# Numbers (digits from ritzlib.fmt.digits)
# ============================================================================

# Signed decimal: -1 is "-1", i64's minimum is "-9223372036854775808".
pub fn klog_dec(n: i64)
    var buf: [20]u8
    klog(fmt_i64_into(@buf, n))

# Unsigned decimal, for values that may exceed i64's range.
pub fn klog_udec(n: u64)
    var buf: [20]u8
    klog(fmt_u64_into(@buf, n))

# Uppercase hex, no leading zeros, no "0x": 0x1234 is "1234".
pub fn klog_hex(n: u64)
    var buf: [64]u8   # fmt_u64_radix_into takes room for any radix
    klog(fmt_u64_radix_into(@buf, n, 16, true))

# Uppercase hex in exactly `width` digits (1..16): the low width*4 bits,
# zero-padded.
pub fn klog_hex_width(n: u64, width: i32)
    var v: u64 = n
    if width < 16
        v = n & ((1 << (width * 4) as u64) - 1)
    var buf: [64]u8
    let digits: StrView = fmt_u64_radix_into(@buf, v, 16, true)
    var pad: i64 = width as i64 - digits.len
    while pad > 0
        klog("0")
        pad = pad - 1
    klog(digits)

# "0x" then klog_hex.
pub fn klog_hex_prefix(n: u64)
    klog("0x")
    klog_hex(n)
