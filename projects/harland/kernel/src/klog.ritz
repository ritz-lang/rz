# Harland Kernel Logging (klog) and the Crash Ring Buffer
#
# The kernel's one log API (AGAST #1885). Every kernel message, text and
# numbers alike, goes through klog_bytes, which writes it to COM1 and to the
# ring buffer that exceptions.ritz dumps on a crash (ring_dump, bound there
# by `extern fn`). Before #1885 the kernel had four entry points and most of
# kernel_main used prints(), which wrote serial only: the crash dump showed
# almost none of the boot. Numbers are formatted by ritzlib.fmt.digits, the
# one digit routine; klog_dec is signed, so -1 prints "-1" (serial_print_dec
# took a u64 and printed 18446744073709551615).
#
# Moved out of main.ritz by AGAST #2752.

import serial { StrView, serial_print, serial_write, serial_write_byte }
import ritzlib.fmt.digits { fmt_i64_into, fmt_u64_into, fmt_u64_radix_into }

# ============================================================================
# Ring Buffer
# ============================================================================
#
# Statically allocated (BSS), usable before the heap exists. Overwrites the
# oldest bytes when full. 16 KiB holds a whole QEMU boot log (~7 KiB up to
# init) with room for what follows.

pub const RING_BUFFER_SIZE: u64 = 16384

var ring_buffer: [16384]u8
var ring_head: u64 = 0         # Next write position
var ring_wrapped: bool = false # Has the buffer wrapped around?

fn ring_write_byte(c: u8)
    ring_buffer[ring_head as i64] = c
    ring_head = ring_head + 1
    if ring_head >= RING_BUFFER_SIZE
        ring_head = 0
        ring_wrapped = true

# Forget the ring's contents.
pub fn ring_clear()
    ring_head = 0
    ring_wrapped = false

# Valid bytes in the ring.
fn ring_len() -> u64
    if ring_wrapped
        return RING_BUFFER_SIZE
    ring_head

# Byte i of the ring in chronological order (0 = oldest).
fn ring_at(i: u64) -> u8
    if ring_wrapped
        return ring_buffer[((ring_head + i) % RING_BUFFER_SIZE) as i64]
    ring_buffer[i as i64]

# Copy the newest min(ring length, max) bytes, oldest first, into dst.
# Returns the count.
pub fn ring_copy(dst: *u8, max: i64) -> i64
    var n: u64 = ring_len()
    var skip: u64 = 0
    if max >= 0 and n > max as u64
        skip = n - max as u64
        n = max as u64
    var i: u64 = 0
    while i < n
        *(dst + i as i64) = ring_at(skip + i)
        i = i + 1
    n as i64

# Write the whole ring to serial, oldest first, between markers. Serial
# only: the dump must not feed the ring it is reading.
pub fn ring_dump()
    serial_print(c"\n=== RING BUFFER DUMP (kernel log) ===\n")
    let n: u64 = ring_len()
    var i: u64 = 0
    while i < n
        serial_write_byte(ring_at(i))
        i = i + 1
    serial_print(c"\n=== END RING BUFFER ===\n")

# ============================================================================
# klog: the one sink
# ============================================================================

# COM1 as well as the ring. A hosted unit test has no I/O ports and turns
# this off to read the ring alone (test/test_klog.ritz).
var klog_to_serial: bool = true

pub fn klog_serial(on: bool)
    klog_to_serial = on

# Every kernel message ends here: serial, then the ring.
fn klog_bytes(ptr: *u8, len: i64)
    if klog_to_serial
        serial_write(ptr, len)
    var i: i64 = 0
    while i < len
        ring_write_byte(*(ptr + i))
        i = i + 1

# Log a string: a "..." literal, or a runtime view (a path, a process name).
pub fn klog(s: StrView)
    klog_bytes(s.ptr, s.len)

# ============================================================================
# Numbers (digits from ritzlib.fmt.digits)
# ============================================================================

# Signed decimal: -1 is "-1", i64's minimum is "-9223372036854775808".
pub fn klog_dec(n: i64)
    var buf: [20]u8
    klog(fmt_i64_into(@buf, n))

# Unsigned decimal, for values that may exceed i64's range.
pub fn klog_udec(n: u64)
    var buf: [20]u8
    klog(fmt_u64_into(@buf, n))

# Uppercase hex, no leading zeros, no "0x": 0x1234 is "1234".
pub fn klog_hex(n: u64)
    var buf: [64]u8   # fmt_u64_radix_into takes room for any radix
    klog(fmt_u64_radix_into(@buf, n, 16, true))

# Uppercase hex in exactly `width` digits (1..16): the low width*4 bits,
# zero-padded.
pub fn klog_hex_width(n: u64, width: i32)
    var v: u64 = n
    if width < 16
        v = n & ((1 << (width * 4) as u64) - 1)
    var buf: [64]u8
    let digits: StrView = fmt_u64_radix_into(@buf, v, 16, true)
    var pad: i64 = width as i64 - digits.len
    while pad > 0
        klog("0")
        pad = pad - 1
    klog(digits)

# "0x" then klog_hex.
pub fn klog_hex_prefix(n: u64)
    klog("0x")
    klog_hex(n)
