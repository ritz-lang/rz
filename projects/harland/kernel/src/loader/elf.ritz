# Harland Kernel - ELF Loader
#
# Parses and loads ELF64 executables for user processes.
# Supports:
#   - ELF64 format (x86-64)
#   - PT_LOAD segments (code, data, bss)
#   - Position-independent executables (PIE) or static
#
# ELF Header Format (64-bit):
#   0x00: e_ident[16]     - Magic number and other info
#   0x10: e_type          - Object file type (u16)
#   0x12: e_machine       - Architecture (u16)
#   0x14: e_version       - Object file version (u32)
#   0x18: e_entry         - Entry point virtual address (u64)
#   0x20: e_phoff         - Program header table file offset (u64)
#   0x28: e_shoff         - Section header table file offset (u64)
#   0x30: e_flags         - Processor-specific flags (u32)
#   0x34: e_ehsize        - ELF header size in bytes (u16)
#   0x36: e_phentsize     - Program header table entry size (u16)
#   0x38: e_phnum         - Program header table entry count (u16)
#   0x3A: e_shentsize     - Section header table entry size (u16)
#   0x3C: e_shnum         - Section header table entry count (u16)
#   0x3E: e_shstrndx      - Section header string table index (u16)

import serial { prints, serial_print_hex, serial_print_dec }
import mm.pmm { pmm_alloc_page, pmm_free_page, PAGE_SIZE }
import mm.vmm { vmm_map_page, vmm_virt_to_phys, vmm_flush_tlb_all, phys_to_virt, PTE_USER, PTE_WRITABLE }
# ELF structures, constants and the pure image gate (AGAST #1888).
# pub: loader.elf is still the module callers (and test_harland_errno.py)
# import for ElfStatus, so re-export what moved to loader.image.
pub import loader.image

# External functions from main.ritz
extern fn alloc_user_stack() -> u64
extern fn jump_to_userspace(entry: u64, stack: u64)

# ELF loader result
pub struct ElfLoadResult
    entry_point: u64      # Entry point address
    load_base: u64        # Base address where ELF was loaded
    error: ElfStatus      # ElfStatus.Ok, or why the load failed

# ============================================================================
# ELF Functions
# ============================================================================

# Convert ELF flags to page table flags
fn elf_flags_to_pte(p_flags: u32) -> u64
    var pte_flags: u64 = PTE_USER  # Always user accessible

    # Writable
    if (p_flags & PF_W) != 0
        pte_flags = pte_flags | PTE_WRITABLE

    # Note: x86-64 doesn't have page-level execute disable by default
    # NX bit requires checking EFER.NXE - for now, all pages are executable

    return pte_flags

# Allocate a fresh physical page and zero it (through the physmap).
# Returns 0 if the PMM is out of pages.
fn elf_alloc_zeroed_page() -> u64
    let page_phys: u64 = pmm_alloc_page()
    if page_phys == 0
        return 0
    var zero_ptr: *u8 = phys_to_virt(page_phys) as *u8
    var zero_i: u64 = 0
    while zero_i < PAGE_SIZE
        *(zero_ptr + zero_i as i64) = 0
        zero_i = zero_i + 1
    return page_phys

# Copy the part of a segment's file data that lands in the page at page_vaddr.
#   copy_ptr: the page, through the physmap
#   seg_vaddr: the segment's (load_base-adjusted) virtual address
#   src / filesz: the segment's file bytes in the ELF image
fn elf_copy_to_page(copy_ptr: *u8, page_vaddr: u64, seg_vaddr: u64, src: *u8, filesz: u64)
    if seg_vaddr > page_vaddr
        # Segment starts partway into this page: copy starting at offset
        let offset: u64 = seg_vaddr - page_vaddr
        var copy_i: u64 = 0
        while copy_i < filesz and (offset + copy_i) < PAGE_SIZE
            *(copy_ptr + (offset + copy_i) as i64) = *(src + copy_i as i64)
            copy_i = copy_i + 1
        return

    # Segment started before or at this page: skip what earlier pages took
    let already_copied: u64 = page_vaddr - seg_vaddr
    if already_copied >= filesz
        return
    let remaining: u64 = filesz - already_copied
    var copy_i: u64 = 0
    while copy_i < remaining and copy_i < PAGE_SIZE
        *(copy_ptr + copy_i as i64) = *(src + (already_copied + copy_i) as i64)
        copy_i = copy_i + 1

# Load one page of a PT_LOAD segment at page_vaddr: allocate it (or reuse the
# page an earlier segment already allocated there), copy its share of the
# file data, and map it (or upgrade the existing mapping to writable).
fn elf_load_page(page_vaddr: u64, seg_vaddr: u64, src: *u8, filesz: u64, pte_flags: u64) -> ElfStatus
    # For user ELF segments, we always need to allocate NEW physical
    # pages and map them with USER permissions. The identity mapping
    # of low memory is kernel-only and would cause page faults.
    #
    # Check if WE already mapped this page (with USER bit).
    # For the ELF loader, we track pages we've allocated by checking
    # if the physical address differs from the virtual address.
    # Identity mapping has phys == virt, our allocations have phys > 32MB
    # (where PMM allocates from available RAM)
    let existing_phys: u64 = vmm_virt_to_phys(page_vaddr)
    # If physical != virtual, we already mapped it (not identity mapped).
    # Also check it's a reasonable physical address (our allocations
    # come from PMM which allocates from free RAM, typically above kernel)
    let already_mapped: bool = existing_phys != page_vaddr and existing_phys >= 0x200000

    var page_phys: u64 = existing_phys
    if not already_mapped
        page_phys = elf_alloc_zeroed_page()
        if page_phys == 0
            prints("[elf] Failed to allocate page!\n")
            return ElfStatus.AllocFailed

    # Copy data to this page (through the physmap)
    elf_copy_to_page(phys_to_virt(page_phys) as *u8, page_vaddr, seg_vaddr, src, filesz)

    if not already_mapped
        if vmm_map_page(page_vaddr, page_phys, pte_flags) != 0
            prints("[elf] Failed to map page at 0x")
            serial_print_hex(page_vaddr)
            prints("!\n")
            pmm_free_page(page_phys)
            return ElfStatus.MapFailed
    else if (pte_flags & PTE_WRITABLE) != 0
        # Page was already mapped by an earlier segment but we need to upgrade
        # permissions (e.g., a read-only segment followed by a writable
        # segment sharing the same page): use the most permissive combination
        if vmm_map_page(page_vaddr, page_phys, pte_flags) != 0
            prints("[elf] Failed to upgrade page permissions at 0x")
            serial_print_hex(page_vaddr)
            prints("!\n")
            return ElfStatus.MapFailed

    return ElfStatus.Ok

# Allocate, map, and copy one PT_LOAD segment, page by page.
# We copy data through the physical addresses (the physmap) since the
# virtual addresses may be outside the identity-mapped region.
# The rest of each page (from p_filesz to p_memsz) is already zeroed.
fn elf_load_segment(elf_data: *u8, phdr: *Elf64Phdr, seg_vaddr: u64) -> ElfStatus
    # Calculate number of pages needed
    let seg_start_page: u64 = seg_vaddr & 0xFFFFFFFFFFFFF000  # Page-align down
    let seg_end: u64 = seg_vaddr + (*phdr).p_memsz
    let seg_end_page: u64 = (seg_end + 0xFFF) & 0xFFFFFFFFFFFFF000  # Page-align up
    let num_pages: u64 = (seg_end_page - seg_start_page) / PAGE_SIZE

    # Get page table flags for this segment
    let pte_flags: u64 = elf_flags_to_pte((*phdr).p_flags)
    let src: *u8 = elf_data + (*phdr).p_offset as i64

    var page_offset: u64 = 0
    while page_offset < num_pages * PAGE_SIZE
        let status: ElfStatus = elf_load_page(seg_start_page + page_offset, seg_vaddr, src, (*phdr).p_filesz, pte_flags)
        if status != ElfStatus.Ok
            return status
        page_offset = page_offset + PAGE_SIZE

    return ElfStatus.Ok

# Load an ELF executable from memory
#
# Parameters:
#   elf_data: Pointer to ELF file in memory
#   elf_size: Size of ELF file in bytes
#   load_base: Virtual address base for loading (0 to use ELF's addresses)
#
# Returns:
#   ElfLoadResult with entry point and error code
pub fn elf_load(elf_data: *u8, elf_size: u64, load_base: u64) -> ElfLoadResult
    var result: ElfLoadResult
    result.entry_point = 0
    result.load_base = load_base
    result.error = ElfStatus.Ok

    # Parse ELF header
    let ehdr: *Elf64Ehdr = elf_data as *Elf64Ehdr

    # Validate the whole image before touching a page: header, program
    # header table, every segment's file range and user address, overlaps
    # (AGAST #1888). Nothing below reads outside [elf_data, +elf_size).
    let validate_result: ElfStatus = elf_validate_image(elf_data, elf_size, load_base)
    if validate_result != ElfStatus.Ok
        result.error = validate_result
        return result

    # For PIE executables (ET_DYN), add the load_base offset to the entry
    # point and every segment; static executables (ET_EXEC) load as-is
    let bias: u64 = elf_bias((*ehdr).e_type, load_base)
    result.entry_point = (*ehdr).e_entry + bias

    # Process program headers
    let phdr_base: *u8 = elf_data + (*ehdr).e_phoff as i64
    var phdr_idx: u16 = 0

    while phdr_idx < (*ehdr).e_phnum
        let phdr: *Elf64Phdr = (phdr_base + (phdr_idx as i64 * (*ehdr).e_phentsize as i64)) as *Elf64Phdr

        # Only process PT_LOAD segments
        if (*phdr).p_type == PT_LOAD
            let status: ElfStatus = elf_load_segment(elf_data, phdr, (*phdr).p_vaddr + bias)
            if status != ElfStatus.Ok
                result.error = status
                return result

        phdr_idx = phdr_idx + 1

    # Flush TLB for the new mappings
    vmm_flush_tlb_all()

    return result

# Load an ELF and execute it in userspace
pub fn elf_exec(elf_data: *u8, elf_size: u64) -> ElfStatus
    # Default load base for PIE executables
    # Using a user-space address that's easy to debug
    let default_load_base: u64 = 0x400000

    # Load the ELF
    let load_result: ElfLoadResult = elf_load(elf_data, elf_size, default_load_base)
    if load_result.error != ElfStatus.Ok
        prints("[elf] Load failed with error ")
        serial_print_dec(elf_status_code(load_result.error))
        prints("\n")
        return load_result.error

    # Allocate 64KB user stack (16 pages)
    let stack_top: u64 = alloc_user_stack()
    if stack_top == 0
        prints("[elf] Failed to allocate user stack!\n")
        return ElfStatus.AllocFailed

    # Flush TLB
    vmm_flush_tlb_all()

    # Jump to userspace
    jump_to_userspace(load_result.entry_point, stack_top)

    # Should not return
    return ElfStatus.Ok

# Test ELF loader with validation
pub fn test_elf_loader() -> i32
    prints("\n=== Testing ELF Loader ===\n")

    # Show we have the ELF structures defined
    prints("  Elf64Ehdr size: 64 bytes\n")
    prints("  Elf64Phdr size: 56 bytes\n")

    # Create a minimal ELF header for testing validation
    var test_ehdr: Elf64Ehdr
    test_ehdr.e_ident[0] = ELF_MAGIC_0
    test_ehdr.e_ident[1] = ELF_MAGIC_1
    test_ehdr.e_ident[2] = ELF_MAGIC_2
    test_ehdr.e_ident[3] = ELF_MAGIC_3
    test_ehdr.e_ident[4] = ELFCLASS64
    test_ehdr.e_ident[5] = ELFDATA2LSB
    test_ehdr.e_type = ET_EXEC
    test_ehdr.e_machine = EM_X86_64
    test_ehdr.e_phnum = 1

    let validate_result: ElfStatus = elf_validate_header(@test_ehdr)
    prints("  Validation test: ")
    if validate_result == ElfStatus.Ok
        prints("PASSED\n")
    else
        prints("FAILED (error=")
        serial_print_dec(elf_status_code(validate_result))
        prints(")\n")

    # Test invalid magic
    test_ehdr.e_ident[0] = 0x00
    let invalid_result: ElfStatus = elf_validate_header(@test_ehdr)
    prints("  Invalid magic test: ")
    if invalid_result == ElfStatus.InvalidMagic
        prints("PASSED (correctly rejected)\n")
    else
        prints("FAILED\n")

    prints("=== ELF Loader Test Complete ===\n\n")
    return 0
