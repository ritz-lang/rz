# Harland Kernel - ELF Image Validation
#
# The pure gate elf_load (loader/elf.ritz) runs before it maps anything
# (AGAST #1888). An ELF is user-writable and spawnable, so every field the
# loader acts on is checked against the buffer it actually has:
#
#   - elf_size covers the ELF header and the whole program header table
#     (e_phoff + e_phnum * e_phentsize), and e_phentsize is the size of
#     Elf64Phdr;
#   - each PT_LOAD's p_offset + p_filesz lies inside elf_size and
#     p_filesz <= p_memsz;
#   - each PT_LOAD lands in the user half, entirely, without wrapping, and
#     no two PT_LOAD memory ranges overlap;
#   - the entry point is a user address.
#
# Nothing here imports the pmm, the vmm or the serial port: a hosted test
# (harland/test/test_elf_image.ritz) links this module alone and feeds it
# truncated, overlapping and kernel-address images.

# ELF constants and the Elf64Ehdr/Elf64Phdr layouts are boot_abi/src/elf64.ritz, the
# one set the UEFI loader also parses the kernel with (AGAST #4578).
# Re-exported whole: kernel modules and tests import them from here.
pub import boot_abi.elf64

# Highest user address (end of the canonical lower half) and the exclusive
# limit above it: the same range mm/uptr.ritz validates syscall pointers
# against.
pub const USER_SPACE_END: u64 = 140737488355327   # 0x00007FFF_FFFFFFFF
const USER_SPACE_LIMIT: u64 = 140737488355328    # 0x00008000_000000

# The most PT_LOAD segments elf_validate_image tracks for overlap. Real
# images have a handful (text, rodata, data, bss); a file claiming more is
# rejected rather than held in an unbounded stack array.
pub const MAX_LOAD_SEGMENTS: i32 = 32

# Why a load failed (or Ok). Not an errno: a spawn maps it to the errno user
# space sees (main.ritz: elf_status_errno), so a loader code can't reach rax
# as -EPERM..-ENOEXEC by accident (AGAST #2123).
pub enum ElfStatus
    Ok
    InvalidMagic        # e_ident does not start 0x7F 'E' 'L' 'F'
    NotElf64            # not ELFCLASS64
    NotLittleEndian     # not ELFDATA2LSB
    NotExecutable       # neither ET_EXEC nor ET_DYN
    WrongMachine        # not EM_X86_64
    NoSegments          # no program headers, or no PT_LOAD among them
    AllocFailed         # out of physical pages
    MapFailed           # vmm_map_page failed
    Truncated           # elf_size does not cover a structure it names
    BadPhdr             # program header table or segment sizes are unusable
    BadAddress          # a segment or the entry point is not a user address
    Overlap             # two PT_LOAD segments claim the same memory

# Numeric code for serial logs (Ok = 0).
pub fn elf_status_code(s: ElfStatus) -> u64
    s as u64

# ============================================================================
# Validation
# ============================================================================

# Validate ELF header
pub fn elf_validate_header(ehdr: *Elf64Ehdr) -> ElfStatus
    # Check magic number
    if (*ehdr).e_ident[EI_MAG0] != ELF_MAGIC_0
        return ElfStatus.InvalidMagic
    if (*ehdr).e_ident[EI_MAG1] != ELF_MAGIC_1
        return ElfStatus.InvalidMagic
    if (*ehdr).e_ident[EI_MAG2] != ELF_MAGIC_2
        return ElfStatus.InvalidMagic
    if (*ehdr).e_ident[EI_MAG3] != ELF_MAGIC_3
        return ElfStatus.InvalidMagic

    # Check 64-bit class
    if (*ehdr).e_ident[EI_CLASS] != ELFCLASS64
        return ElfStatus.NotElf64

    # Check little-endian encoding
    if (*ehdr).e_ident[EI_DATA] != ELFDATA2LSB
        return ElfStatus.NotLittleEndian

    # Check executable type (accept both ET_EXEC and ET_DYN for PIE)
    if (*ehdr).e_type != ET_EXEC and (*ehdr).e_type != ET_DYN
        return ElfStatus.NotExecutable

    # Check x86-64 architecture
    if (*ehdr).e_machine != EM_X86_64
        return ElfStatus.WrongMachine

    # Check program headers exist
    if (*ehdr).e_phnum == 0
        return ElfStatus.NoSegments

    return ElfStatus.Ok

# The load bias elf_load applies to ET_DYN images: load_base, or 0.
pub fn elf_bias(e_type: u16, load_base: u64) -> u64
    if e_type == ET_DYN and load_base != 0
        return load_base
    return 0

# Validate the whole image before a page is allocated or mapped. elf_data
# points at elf_size bytes; every access stays inside [elf_data, +elf_size).
pub fn elf_validate_image(elf_data: *u8, elf_size: u64, load_base: u64) -> ElfStatus
    # The ELF header itself must be in the buffer.
    if elf_size < ELF64_EHDR_SIZE as u64
        return ElfStatus.Truncated

    let ehdr: *Elf64Ehdr = elf_data as *Elf64Ehdr
    let header_status: ElfStatus = elf_validate_header(ehdr)
    if header_status != ElfStatus.Ok
        return header_status

    # The program header table is elf_data[e_phoff .. + e_phnum * e_phentsize].
    # A table that does not fit in the file, or entries whose size is not
    # struct Elf64Phdr, would walk off the buffer.
    if (*ehdr).e_phentsize != ELF64_PHDR_SIZE
        return ElfStatus.BadPhdr
    if (*ehdr).e_phoff < ELF64_EHDR_SIZE as u64 or (*ehdr).e_phoff > elf_size
        return ElfStatus.BadPhdr
    let table_bytes: u64 = (*ehdr).e_phnum as u64 * ELF64_PHDR_SIZE as u64
    if table_bytes > elf_size - (*ehdr).e_phoff
        return ElfStatus.BadPhdr

    let bias: u64 = elf_bias((*ehdr).e_type, load_base)
    if bias > USER_SPACE_END
        return ElfStatus.BadAddress

    # The entry point must be a user address.
    if (*ehdr).e_entry > USER_SPACE_END - bias
        return ElfStatus.BadAddress

    # Track each PT_LOAD's memory range to reject overlaps. Adjacent ranges
    # (end == next start) are fine: that is how text/rodata/data are linked.
    var seg_starts: [32]u64
    var seg_ends: [32]u64
    var seg_count: i32 = 0
    var phdr_idx: u64 = 0

    while phdr_idx < (*ehdr).e_phnum as u64
        let phdr: *Elf64Phdr = (elf_data + (*ehdr).e_phoff + phdr_idx * ELF64_PHDR_SIZE as u64) as *Elf64Phdr

        if (*phdr).p_type == PT_LOAD
            # File bytes must be in the image, and never exceed memory bytes.
            if (*phdr).p_filesz > (*phdr).p_memsz
                return ElfStatus.BadPhdr
            if (*phdr).p_offset > elf_size
                return ElfStatus.Truncated
            if (*phdr).p_filesz > elf_size - (*phdr).p_offset
                return ElfStatus.Truncated

            # A zero-length segment maps nothing: legal, and no range to track.
            if (*phdr).p_memsz > 0
                if seg_count >= MAX_LOAD_SEGMENTS
                    return ElfStatus.BadPhdr

                # The whole memory range must be user space, without wrapping.
                if (*phdr).p_vaddr > USER_SPACE_END - bias
                    return ElfStatus.BadAddress
                let seg_vaddr: u64 = (*phdr).p_vaddr + bias
                if (*phdr).p_memsz > USER_SPACE_LIMIT - seg_vaddr
                    return ElfStatus.BadAddress
                let seg_end: u64 = seg_vaddr + (*phdr).p_memsz

                # Overlap check against the segments accepted so far.
                var prev: i32 = 0
                while prev < seg_count
                    if seg_vaddr < seg_ends[prev] and seg_starts[prev] < seg_end
                        return ElfStatus.Overlap
                    prev = prev + 1

                seg_starts[seg_count] = seg_vaddr
                seg_ends[seg_count] = seg_end
                seg_count = seg_count + 1

        phdr_idx = phdr_idx + 1

    if seg_count == 0
        return ElfStatus.NoSegments

    return ElfStatus.Ok
