# Harland Serial Port Driver (COM1)
#
# Provides serial I/O for kernel logging, debugging, and user input.

import io { outb, inb, cpu_pause }
# The polled COM1 driver is boot_abi/src/serial.ritz, shared with the UEFI
# loader (AGAST #4578); the kernel wraps it below (COM1 may be absent).
# Kernel messages go through klog.ritz, the one sink for COM1 and the crash
# ring (AGAST #1885); only klog.ritz and the console echo write COM1 here.
import boot_abi.serial { COM1_DATA, COM1_IER, COM1_LSR, COM1_SCR, LSR_DR, LSR_THRE }
import boot_abi.serial { serial_init, serial_write_byte, serial_write }

# ============================================================================
# Is there a COM1? (AGAST #4868)
# ============================================================================
#
# The Acer has no UART. Port reads at 0x3F8.. then float to 0xFF, so LSR's
# data-ready bit always reads set: tty_console_pull's `while
# serial_data_available()` never ended and fed 0xFF into the line
# discipline, and the first console read hung the boot. serial_init probes
# first; with no COM1 every function here is a no-op (reads find nothing,
# writes are dropped) and the framebuffer console is the only one.

# Scratch-register patterns: a 16550 keeps what is written to SCR.
pub const COM1_PROBE_A: u8 = 0x5A
pub const COM1_PROBE_B: u8 = 0xA5
const LSR_FLOATING: u8 = 0xFF

var g_com1_present: bool = true

# The probe's verdict from what it read back: both scratch patterns, and an
# LSR that is not all ones (no 16550 reports every status bit at once).
pub fn com1_probe_verdict(scratch_a: u8, scratch_b: u8, lsr: u8) -> bool
    scratch_a == COM1_PROBE_A and scratch_b == COM1_PROBE_B and lsr != LSR_FLOATING

fn com1_probe() -> bool
    outb(COM1_SCR, COM1_PROBE_A)
    let a: u8 = inb(COM1_SCR)
    outb(COM1_SCR, COM1_PROBE_B)
    let b: u8 = inb(COM1_SCR)
    com1_probe_verdict(a, b, inb(COM1_LSR))

# Whether serial_init found a COM1.
pub fn serial_present() -> bool
    g_com1_present

# Probe COM1, then set it up (boot_abi's serial_init: 115200 8N1) if it is
# there. Returns whether it is.
pub fn serial_start() -> bool
    g_com1_present = com1_probe()
    if g_com1_present
        serial_init()
    g_com1_present

# The kernel's polled COM1 output: boot_abi's, dropped with no COM1.
pub fn serial_out_byte(c: u8)
    if g_com1_present
        serial_write_byte(c)

pub fn serial_out(s: StrView)
    if g_com1_present
        serial_write(s.ptr, s.len)

# ============================================================================
# Serial Port Constants
# ============================================================================

# COM1 registers and LSR bits: boot_abi/src/serial.ritz.

# Interrupt Enable Register bits
const IER_RDA: u8 = 0x01         # Received Data Available interrupt
const IER_THRE: u8 = 0x02        # Transmitter Holding Register Empty
const IER_LSR: u8 = 0x04         # Line Status Register change
const IER_MSR: u8 = 0x08         # Modem Status Register change

# ============================================================================
# Serial Input Buffer
# ============================================================================
#
# Circular buffer for storing incoming serial data.
# This allows interrupt-driven or polled input without data loss.

const SERIAL_BUF_SIZE: i32 = 256

var serial_input_buf: [256]u8
var serial_input_head: i32 = 0   # Write position
var serial_input_tail: i32 = 0   # Read position
var serial_input_count: i32 = 0  # Bytes in buffer

# ============================================================================
# Serial Output Buffer
# ============================================================================
#
# Circular buffer for outgoing serial data.
# Enables interrupt-driven TX without blocking the CPU.
# When userspace calls sys_write, data goes into this buffer.
# COM1 THRE interrupt drains the buffer to hardware.

const SERIAL_OUT_BUF_SIZE: i32 = 4096

var serial_output_buf: [4096]u8
var serial_output_head: i32 = 0   # Write position (producer)
var serial_output_tail: i32 = 0   # Read position (consumer/IRQ)
var serial_output_count: i32 = 0  # Bytes in buffer

# ============================================================================
# StrView - Zero-copy string view
# ============================================================================
#
# "hello" string literals are StrViews: a pointer and a compile-time length,
# no null terminator scanning. The type is ritzlib's (re-exported here, so
# kernel modules keep importing it from serial): a second, identical
# declaration in the kernel would own the type, and ritzlib.strview's impls,
# which goliath brings in, may only sit where it is declared (AGAST #1881).

pub import ritzlib.strview { StrView }

# ============================================================================
# Serial Input Functions
# ============================================================================

# Check if data is available to read
pub fn serial_data_available() -> bool
    if not g_com1_present
        return false
    return (inb(COM1_LSR) & LSR_DR) != 0

# Read a single byte (blocking)
pub fn serial_read_byte() -> u8
    while not serial_data_available()
        cpu_pause()
    return inb(COM1_DATA)

# Read a single byte (non-blocking)
# Returns the byte read, or -1 if no data available
pub fn serial_read_byte_nonblock() -> i32
    if not serial_data_available()
        return -1
    return inb(COM1_DATA) as i32

# Poll serial port and buffer any available data
# Called from interrupt handler or main loop
pub fn serial_poll() -> i32
    var bytes_read: i32 = 0
    while serial_data_available()
        let c: u8 = inb(COM1_DATA)
        # Add to buffer if not full
        if serial_input_count < SERIAL_BUF_SIZE
            serial_input_buf[serial_input_head] = c
            serial_input_head = (serial_input_head + 1) % SERIAL_BUF_SIZE
            serial_input_count = serial_input_count + 1
            bytes_read = bytes_read + 1
    return bytes_read

# Check how many bytes are in the input buffer
pub fn serial_input_available() -> i32
    return serial_input_count

# Read from the input buffer (non-blocking)
# Returns the byte, or -1 if buffer is empty
pub fn serial_buf_read() -> i32
    if serial_input_count == 0
        return -1
    let c: u8 = serial_input_buf[serial_input_tail]
    serial_input_tail = (serial_input_tail + 1) % SERIAL_BUF_SIZE
    serial_input_count = serial_input_count - 1
    return c as i32

# Read multiple bytes from input buffer into user buffer
# Returns number of bytes actually read
pub fn serial_buf_read_many(buf: *u8, max_len: i64) -> i64
    var bytes_read: i64 = 0
    while bytes_read < max_len and serial_input_count > 0
        let c: u8 = serial_input_buf[serial_input_tail]
        serial_input_tail = (serial_input_tail + 1) % SERIAL_BUF_SIZE
        serial_input_count = serial_input_count - 1
        *(buf + bytes_read) = c
        bytes_read = bytes_read + 1
    return bytes_read

# Enable receive interrupts on COM1
pub fn serial_enable_rx_interrupt()
    # Enable Received Data Available interrupt
    if g_com1_present
        outb(COM1_IER, IER_RDA)

# Disable receive interrupts on COM1
pub fn serial_disable_rx_interrupt()
    if g_com1_present
        outb(COM1_IER, 0x00)

# ============================================================================
# Serial Output Buffer Functions (Interrupt-driven TX)
# ============================================================================

# Current IER state (tracks which interrupts are enabled)
var serial_ier_state: u8 = 0

# Update IER register with current state
fn serial_update_ier()
    if g_com1_present
        outb(COM1_IER, serial_ier_state)

# Enable TX interrupt (THRE - Transmitter Holding Register Empty)
pub fn serial_enable_tx_interrupt()
    serial_ier_state = serial_ier_state | IER_THRE
    serial_update_ier()

# Disable TX interrupt
pub fn serial_disable_tx_interrupt()
    serial_ier_state = serial_ier_state & (0xFF ^ IER_THRE)
    serial_update_ier()

# Enable RX interrupt (wrapper that updates state tracking)
pub fn serial_enable_rx()
    serial_ier_state = serial_ier_state | IER_RDA
    serial_update_ier()

# Check if output buffer has space
pub fn serial_output_space() -> i32
    return SERIAL_OUT_BUF_SIZE - serial_output_count

# Check if output buffer has data
pub fn serial_output_pending() -> i32
    return serial_output_count

# Write bytes to the output buffer (non-blocking)
# Returns number of bytes actually written (may be less than len if buffer full)
pub fn serial_buffer_write(buf: *u8, len: i64) -> i64
    # No COM1: the bytes are taken and dropped (the screen has them).
    if not g_com1_present
        return len
    var bytes_written: i64 = 0

    while bytes_written < len
        # Check if buffer is full
        if serial_output_count >= SERIAL_OUT_BUF_SIZE
            # Buffer full - enable TX interrupt and return what we wrote
            if serial_output_count > 0
                serial_enable_tx_interrupt()
            return bytes_written

        # Add byte to buffer
        serial_output_buf[serial_output_head] = *(buf + bytes_written)
        serial_output_head = (serial_output_head + 1) % SERIAL_OUT_BUF_SIZE
        serial_output_count = serial_output_count + 1
        bytes_written = bytes_written + 1

    # Enable TX interrupt to start draining
    if serial_output_count > 0
        serial_enable_tx_interrupt()

    return bytes_written

# Write a single byte to output buffer
pub fn serial_buffer_write_byte(c: u8) -> i32
    if not g_com1_present
        return 1
    if serial_output_count >= SERIAL_OUT_BUF_SIZE
        # Buffer full
        return 0

    serial_output_buf[serial_output_head] = c
    serial_output_head = (serial_output_head + 1) % SERIAL_OUT_BUF_SIZE
    serial_output_count = serial_output_count + 1

    # Enable TX interrupt
    serial_enable_tx_interrupt()
    return 1

# Drain output buffer to hardware (called from IRQ handler)
# Sends bytes while hardware is ready (THRE set)
# Returns number of bytes sent
pub fn serial_drain_output() -> i32
    var bytes_sent: i32 = 0
    if not g_com1_present
        serial_output_count = 0
        return 0

    # While buffer has data and hardware is ready
    while serial_output_count > 0 and (inb(COM1_LSR) & LSR_THRE) != 0
        # Get byte from buffer
        let c: u8 = serial_output_buf[serial_output_tail]
        serial_output_tail = (serial_output_tail + 1) % SERIAL_OUT_BUF_SIZE
        serial_output_count = serial_output_count - 1

        # Send to hardware
        outb(COM1_DATA, c)
        bytes_sent = bytes_sent + 1

    # If buffer is empty, disable TX interrupt
    if serial_output_count == 0
        serial_disable_tx_interrupt()

    return bytes_sent

# Blocking write - waits until all bytes are written
# Used for kernel logging where we need to ensure output
pub fn serial_write_blocking(buf: *u8, len: i64) -> i64
    var total_written: i64 = 0

    while total_written < len
        let written: i64 = serial_buffer_write(buf + total_written, len - total_written)
        total_written = total_written + written

        if total_written < len
            # Buffer was full, drain some to hardware directly
            serial_drain_output()

    return total_written

# Flush output buffer - blocks until all pending data is sent
pub fn serial_flush()
    while serial_output_count > 0
        serial_drain_output()
        # Small pause to let hardware catch up
        cpu_pause()
