# AHCI register file and the BIOS/OS handoff sequence (AHCI 1.3.1 §10.6.3).
#
# Host tests drive a byte span. The kernel copies CAP2 and BOHC into the
# same shape, so the sequence under test is the one the probe runs.
# AGAST #4882.

pub const AHCI_REG_CAP: u32 = 0x00
pub const AHCI_REG_GHC: u32 = 0x04
pub const AHCI_REG_IS: u32 = 0x08
pub const AHCI_REG_PI: u32 = 0x0C
pub const AHCI_REG_VS: u32 = 0x10
pub const AHCI_REG_CAP2: u32 = 0x24
pub const AHCI_REG_BOHC: u32 = 0x28

pub const AHCI_CAP_SSS: u32 = 0x08000000
pub const AHCI_CAP_S64A: u32 = 0x80000000
pub const AHCI_CAP2_BOH: u32 = 0x00000001
pub const AHCI_GHC_HR: u32 = 0x00000001
pub const AHCI_GHC_AE: u32 = 0x80000000
pub const AHCI_BOHC_BOS: u32 = 0x00000001
pub const AHCI_BOHC_OOS: u32 = 0x00000002
pub const AHCI_BOHC_BB: u32 = 0x00000010

pub const AHCI_PORT_BASE: u32 = 0x100
pub const AHCI_PORT_STRIDE: u32 = 0x80
pub const AHCI_PX_CLB: u32 = 0x00
pub const AHCI_PX_CLBU: u32 = 0x04
pub const AHCI_PX_FB: u32 = 0x08
pub const AHCI_PX_FBU: u32 = 0x0C
pub const AHCI_PX_IS: u32 = 0x10
pub const AHCI_PX_IE: u32 = 0x14
pub const AHCI_PX_CMD: u32 = 0x18
pub const AHCI_PX_TFD: u32 = 0x20
pub const AHCI_PX_SIG: u32 = 0x24
pub const AHCI_PX_SSTS: u32 = 0x28
pub const AHCI_PX_SCTL: u32 = 0x2C
pub const AHCI_PX_SERR: u32 = 0x30
pub const AHCI_PX_CI: u32 = 0x38

pub const AHCI_PXCMD_ST: u32 = 0x0001
pub const AHCI_PXCMD_SUD: u32 = 0x0002
pub const AHCI_PXCMD_FRE: u32 = 0x0010
pub const AHCI_PXCMD_FR: u32 = 0x4000
pub const AHCI_PXCMD_CR: u32 = 0x8000

pub const AHCI_TFD_ERR: u32 = 0x01
pub const AHCI_TFD_DRQ: u32 = 0x08
pub const AHCI_TFD_BSY: u32 = 0x80
pub const AHCI_SSTS_DET_MASK: u32 = 0x0F
pub const AHCI_SSTS_DET_UP: u32 = 0x03
pub const AHCI_IS_TFES: u32 = 0x40000000

pub const AHCI_SIG_ATA: u32 = 0x00000101
pub const AHCI_SIG_ATAPI: u32 = 0xEB140101
pub const AHCI_SIG_SEMB: u32 = 0xC33C0101
pub const AHCI_SIG_PM: u32 = 0x96690101

# What PxSIG names. Other is anything that is not one of the four signatures.
pub enum SigKind
    Ata
    Atapi
    Semb
    Pm
    Other

# Class 01:06:01 is driven. Class 01:04 (RAID mode) is logged and left alone.
pub enum ClassAction
    Ignore
    Drive
    Raid

# One step of the BIOS/OS handoff. Busy means call again later.
pub enum Handoff
    Busy
    Taken
    Kept

# Where a handoff is in its sequence. Not the value ahci_handoff_step returns.
pub enum HandoffPhase
    Start
    WaitBos
    WaitBb
    DoneTaken
    DoneKept

pub const AHCI_HANDOFF_BOS_MS: i64 = 25
pub const AHCI_HANDOFF_BB_MS: i64 = 2000

# One shared wait for every port on a controller, from the HBA reset.
pub const AHCI_PORT_DEADLINE_MS: i64 = 1000
pub const AHCI_QUIESCE_MS: i64 = 500
pub const AHCI_RESET_MS: i64 = 1000

pub const AHCI_DMA32_LIMIT: u64 = 0x100000000

pub struct AhciHandoff
    phase: HandoffPhase
    t_oos: i64
    t_bos_clear: i64

pub fn ahci_port_reg(port: i32, reg: u32) -> u32
    AHCI_PORT_BASE + (port as u32) * AHCI_PORT_STRIDE + reg

pub fn ahci_pi_has(pi: u32, port: i32) -> bool
    if port < 0 or port > 31
        return false
    let bit: u32 = 1
    (pi & (bit << (port as u32))) != 0

pub fn ahci_class_action(class_code: u8, subclass: u8, prog_if: u8) -> ClassAction
    if class_code != 0x01
        return ClassAction.Ignore
    if subclass == 0x04
        return ClassAction.Raid
    if subclass == 0x06 and prog_if == 0x01
        return ClassAction.Drive
    ClassAction.Ignore

pub fn ahci_sig_kind(sig: u32) -> SigKind
    if sig == AHCI_SIG_ATA
        return SigKind.Ata
    if sig == AHCI_SIG_ATAPI
        return SigKind.Atapi
    if sig == AHCI_SIG_SEMB
        return SigKind.Semb
    if sig == AHCI_SIG_PM
        return SigKind.Pm
    SigKind.Other

fn rf_in_range(mem: [u8], off: u32) -> bool
    let o: i64 = off as i64
    o <= mem.len and mem.len - o >= 4

pub fn ahci_rf_read(mem: [u8], off: u32) -> u32
    if not rf_in_range(mem, off)
        return 0
    let o: i64 = off as i64
    let b0: u32 = mem[o] as u32
    let b1: u32 = mem[o + 1] as u32
    let b2: u32 = mem[o + 2] as u32
    let b3: u32 = mem[o + 3] as u32
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

pub fn ahci_rf_write(mem: [u8], off: u32, value: u32)
    if not rf_in_range(mem, off)
        return
    let o: i64 = off as i64
    mem[o] = (value & 0xFF) as u8
    mem[o + 1] = ((value >> 8) & 0xFF) as u8
    mem[o + 2] = ((value >> 16) & 0xFF) as u8
    mem[o + 3] = ((value >> 24) & 0xFF) as u8

pub fn ahci_handoff_init(h: @&AhciHandoff)
    h.phase = HandoffPhase.Start
    h.t_oos = 0
    h.t_bos_clear = 0

# One observation of the handoff. `now_ms` is milliseconds since the probe
# started the sequence. Taken means the OS owns the HBA (or the firmware
# never asked for a handoff). Kept means the firmware kept it and the
# controller must not be driven.
pub fn ahci_handoff_step(h: @&AhciHandoff, mem: [u8], now_ms: i64) -> Handoff
    match h.phase
        HandoffPhase.DoneTaken => return Handoff.Taken
        HandoffPhase.DoneKept => return Handoff.Kept
        HandoffPhase.Start =>
            let cap2: u32 = ahci_rf_read(mem, AHCI_REG_CAP2)
            if (cap2 & AHCI_CAP2_BOH) == 0
                h.phase = HandoffPhase.DoneTaken
                return Handoff.Taken
            let bohc: u32 = ahci_rf_read(mem, AHCI_REG_BOHC)
            ahci_rf_write(mem, AHCI_REG_BOHC, bohc | AHCI_BOHC_OOS)
            h.phase = HandoffPhase.WaitBos
            h.t_oos = now_ms
            return Handoff.Busy
        HandoffPhase.WaitBos =>
            let bohc: u32 = ahci_rf_read(mem, AHCI_REG_BOHC)
            if (bohc & AHCI_BOHC_BOS) == 0
                if (bohc & AHCI_BOHC_BB) != 0
                    h.phase = HandoffPhase.WaitBb
                    h.t_bos_clear = now_ms
                    return Handoff.Busy
                h.phase = HandoffPhase.DoneTaken
                return Handoff.Taken
            if now_ms - h.t_oos >= AHCI_HANDOFF_BOS_MS
                h.phase = HandoffPhase.DoneKept
                return Handoff.Kept
            return Handoff.Busy
        HandoffPhase.WaitBb =>
            let bohc: u32 = ahci_rf_read(mem, AHCI_REG_BOHC)
            if (bohc & AHCI_BOHC_BB) == 0
                h.phase = HandoffPhase.DoneTaken
                return Handoff.Taken
            if now_ms - h.t_bos_clear >= AHCI_HANDOFF_BB_MS
                h.phase = HandoffPhase.DoneKept
                return Handoff.Kept
            return Handoff.Busy
