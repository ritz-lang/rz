# Harland xHCI host controllers (AGAST #4887, #4889, docs/USB.md)
#
# Every PCI function of class 0C/03/30 (chungus has three), each with its
# own state here and its own interrupter-0 vector aimed at the BSP (MSI-X,
# else plain MSI, else none and the BSP's tick polls it: setup_vector,
# #4891), brought up once in kernel_main (docs/USB.md "xHCI bring-up, in order", steps 1-6):
# BAR0, the USB Legacy Support handoff, halt and reset, the DCBAA,
# scratchpad, command ring, event ring and ERST, interrupter 0, then
# Run/Stop and port power. The layouts, rings and decoders are usb_abi's;
# this file is the register access and the memory. Callers name a
# controller by its index, `hc`, 0 for the first function found.
#
# Ownership (SMP_USER.md section 2, the "In-kernel drivers" row): every
# field here is BSP-owned and has no lock. Only the BSP touches it: the
# boot (interrupts off, before any AP runs a process), xhci_irq
# (drivers/usb/usb.ritz) from each controller's vector, aimed at the BSP,
# and the BSP's tick (usb_tick, which also polls a controller with no
# working vector). It is never lent to an AP.
#
# Waiting: at boot the halt, reset and BIOS handoff are busy-waits, each
# under a TSC deadline. After boot nothing spins: a controller that fails
# (USBSTS.HSE or HCE, or registers reading all-ones) is reset alone by a
# state machine the BSP's tick steps (xhci_tick: halt, reset, restart, each
# checked once a tick under its deadline), while the others keep running.

import ritzlib.option
import ritzlib.result
import klog { klog, klog_dec, klog_hex, klog_hex_width }
import io { cpu_pause }
import drivers.pci { PciDevice, PCI_CLASS_SERIAL_BUS, pci_get_device_count, pci_get_device, pci_enable_bus_master, pci_enable_memory, pci_disable_intx }
import drivers.msix { MsixInfo, msix_probe, msix_enable, msix_vector_alloc, msix_set_entry, msix_vector_count, msi_probe, msi_enable }
import drivers.usb.irq_mode { UsbIrqMode, VectorWatch }
import mm.vmm { vmm_map_mmio, phys_to_virt }
import mm.dma { dma_alloc_zeroed, dma_free_pages }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import usb_abi.regs { HcParams, hc_params, cap_length, hci_version, CAP_LENGTH_VERSION, CAP_HCSPARAMS1, CAP_HCSPARAMS2, CAP_HCCPARAMS1, CAP_DBOFF, CAP_RTSOFF, DBOFF_MASK, RTSOFF_MASK, OP_USBCMD, OP_USBSTS, OP_PAGESIZE, OP_CRCR, OP_DCBAAP, OP_CONFIG, USBCMD_RS, USBCMD_HCRST, USBCMD_INTE, USBCMD_HSEE, USBSTS_HCH, USBSTS_HSE, USBSTS_EINT, USBSTS_PCD, USBSTS_CNR, USBSTS_HCE, PAGESIZE_4K, RT_IR0, IR_IMAN, IR_IMOD, IR_ERSTSZ, IR_ERSTBA, IR_ERDP, IMAN_IP, IMAN_IE, ERDP_EHB, DB_HOST, PORTSC_PP, portsc_reg, portsc_power_on, XCap, xcap_decode, XCAP_LEGACY, XCAP_PROTOCOL, LEGSUP_BIOS_OWNED, LEGSUP_OS_OWNED, LEGCTL_OFFSET, legctl_quiet, PortProtocol, protocol_decode }
import usb_abi.trb { Trb, Event, event_decode }
import usb_abi.ring { TrbPage, TrbRing, RingError, EventRing, ErstEntry, erst_entry, RING_TRBS }

const PCI_SUBCLASS_USB: u8 = 0x03
const PCI_PROGIF_XHCI: u8 = 0x30

# Controllers driven at once: chungus has three xHCI functions.
pub const XHCS_MAX: u8 = 4

# Deadlines (docs/USB.md): the BIOS may hold the controller for up to a
# second of SMI work; halt and reset take tens of milliseconds.
const HANDOFF_US: u64 = 1000000
const HALT_US: u64 = 100000
const RESET_US: u64 = 1000000

# A running controller's USBSTS is checked every HEALTH_TICKS BSP ticks
# (100 ms): a Host Controller Error and a vanished controller raise no
# interrupt, so only a look finds them.
const HEALTH_TICKS: u32 = 10

# Supported Protocol capabilities kept; a controller lists two or three.
const PROTOCOLS_MAX: u32 = 8
# The extended-capability walk stops here whatever the list says: a
# looping or garbage list cannot hang the boot.
const XCAPS_MAX: u32 = 64
# Events handled per xhci_irq before the ERDP write; the rest are taken
# on the next interrupt (the controller re-asserts while any remain).
pub const EVENTS_PER_IRQ: u32 = 64

pub enum XhciError
    NotFound                # no 0C/03/30 function
    BadBar                  # BAR0 missing, I/O space, or not mappable
    PageSize                # the controller cannot do 4 KiB pages
    HaltTimeout             # HCHalted not set within HALT_US
    ResetTimeout            # HCRST or CNR still set after RESET_US
    StartTimeout            # HCHalted still set after Run/Stop
    NoMemory                # dma_alloc_zeroed failed
    Above4G                 # a DMA page above 4 GiB, without AC64

pub fn xhci_error_name(e: XhciError) -> StrView
    match e
        NotFound => "no xHCI controller"
        BadBar => "BAR0 unusable"
        PageSize => "no 4 KiB page size"
        HaltTimeout => "halt timed out"
        ResetTimeout => "reset timed out"
        StartTimeout => "start timed out"
        NoMemory => "out of DMA memory"
        Above4G => "DMA page above 4 GiB without AC64"

# Where a controller is. Recovery (docs/USB.md "Hot-plug") walks Halting,
# Resetting and Starting, one check per BSP tick under each deadline.
enum HcState
    Off                     # not brought up (or its bring-up failed)
    Running
    Halting                 # Run/Stop cleared: waiting for HCHalted
    Resetting               # HCRST set: waiting for HCRST and CNR to clear
    Starting                # reprogrammed, Run/Stop set: HCHalted to clear
    Failed                  # recovery gave up; the controller stays off

# How a controller's interrupter 0 reaches the BSP (setup_vector). Poll is
# first, so a controller never brought up reads as one.
enum IrqVia
    Poll                    # no vector: the BSP's tick runs xhci_irq
    MsiX                    # MSI-X entry 0
    Msi                     # plain MSI, one message

fn via_name(v: IrqVia) -> StrView
    match v
        Poll => "polled"
        MsiX => "MSI-X"
        Msi => "MSI"

# What xhci_tick tells usb.ritz about a controller.
pub enum HcStep
    Idle                    # nothing changed
    Died                    # it failed: recovery began, its devices are gone
    Restarted               # recovery done: it runs again, ports to scan
    GaveUp                  # recovery failed: it stays off

# One controller. BSP-owned (see the header).
struct Xhci
    pci: *PciDevice
    index: u8               # its hc number, the order xhci_init found it in
    mmio: u64               # BAR0, the capability registers
    op: u64                 # the operational registers
    rt: u64                 # the runtime registers
    db: u64                 # the doorbell array
    params: HcParams
    dcbaa: u64              # device context base address array (phys)
    scratch: u64            # the scratchpad buffer array (phys), 0 if none
    cmd_page: u64           # the command ring (phys)
    cmd: TrbRing
    cmd_owner: [256]u8      # the device entry (usb.ritz's) each outstanding command is for
    dev_cmds: [256]u8       # commands outstanding per device entry
    ev_page: u64            # event ring segment 0 (phys)
    events: EventRing
    erst: u64               # the event ring segment table (phys)
    msix: MsixInfo
    via: IrqVia
    vector: u8              # interrupter 0's vector, 0 if none
    watch: VectorWatch      # does the vector fire (health checks, #4891)
    protocols: [8]PortProtocol
    nprotocols: u32
    state: HcState
    deadline: u64           # the recovery step's TSC deadline
    ticks: u32              # BSP ticks since the last health check

var xhcs: [4]Xhci
var nxhcs: u8 = 0

# ============================================================================
# Register access
# ============================================================================

fn rd32(addr: u64) -> u32
    volatile_load(addr as *u32)

fn wr32(addr: u64, v: u32)
    volatile_store(addr as *u32, v)

# A 64-bit register as two dwords, low first: the high write is the one a
# controller acts on (QEMU's CRCR and ERSTBA among them).
fn wr64(addr: u64, v: u64)
    wr32(addr, (v & 0xFFFFFFFF) as u32)
    wr32(addr + 4, (v >> 32) as u32)

fn hc_of(hc: u8) -> *Xhci
    @xhcs[hc]

fn op_rd(h: *Xhci, reg: u64) -> u32
    rd32(h.op + reg)

fn op_wr(h: *Xhci, reg: u64, v: u32)
    wr32(h.op + reg, v)

fn ir0(h: *Xhci) -> u64
    h.rt + RT_IR0

# Poll operational register `reg` until (value & mask) == want, or the
# deadline `us` from now passes. Boot only.
fn op_wait(h: *Xhci, reg: u64, mask: u32, want: u32, us: u64) -> bool
    let deadline: u64 = deadline_after_us(us)
    while (op_rd(h, reg) & mask) != want
        if deadline_passed(deadline)
            return false
        cpu_pause()
    true

fn log_hc(h: *Xhci)
    klog("[xhci] hc")
    klog_dec(h.index as i64)

# ============================================================================
# Memory
# ============================================================================

fn alloc_for(h: *Xhci, n: u32) -> Result<u64, XhciError>
    let p: u64 = match dma_alloc_zeroed(n)
        Some(p) => p
        None => return Err(XhciError.NoMemory)
    if not h.params.ac64 and p + (n as u64) * 4096 > 0x100000000
        dma_free_pages(p, n)
        return Err(XhciError.Above4G)
    Ok(p)

# One zeroed DMA page controller `hc` can address: below 4 GiB unless it
# does 64-bit addresses. Kernel DMA is physical (docs/USB.md step 4).
pub fn xhci_alloc_page(hc: u8) -> Result<u64, XhciError>
    alloc_for(hc_of(hc), 1)

# A page xhci_alloc_page gave, once the controller can no longer reach it
# (its slot disabled, or the controller reset).
pub fn xhci_free_page(phys: u64)
    if phys != 0
        dma_free_pages(phys, 1)

fn zero_page(phys: u64)
    let w: *u64 = phys_to_virt(phys) as *u64
    for i in 0..512
        *(w + i) = 0

# The DCBAA's entry `i` (0: the scratchpad array; a slot ID otherwise).
fn dcbaa_entry(h: *Xhci, i: u8) -> *u64
    (phys_to_virt(h.dcbaa) + (i as u64) * 8) as *u64

# ============================================================================
# Bring-up
# ============================================================================

fn is_xhci(d: *PciDevice) -> bool
    d.class_code == PCI_CLASS_SERIAL_BUS and d.subclass == PCI_SUBCLASS_USB and d.prog_if == PCI_PROGIF_XHCI

fn log_bdf(d: *PciDevice)
    klog_hex_width(d.bus as u64, 2)
    klog(":")
    klog_hex_width(d.device as u64, 2)
    klog(".")
    klog_dec(d.function as i64)

# USB Legacy Support at `cap` (BAR0-relative): take the controller from
# the BIOS (docs/USB.md step 2). After HANDOFF_US the BIOS's claim is
# cleared by hand and the boot goes on; either way every SMI is turned off.
fn bios_handoff(h: *Xhci, cap: u64)
    let addr: u64 = h.mmio + cap
    let v: u32 = rd32(addr)
    if (v & LEGSUP_BIOS_OWNED) != 0
        wr32(addr, v | LEGSUP_OS_OWNED)
        let deadline: u64 = deadline_after_us(HANDOFF_US)
        var held: bool = true
        while held
            held = (rd32(addr) & LEGSUP_BIOS_OWNED) != 0
            if held and deadline_passed(deadline)
                break
            cpu_pause()
        log_hc(h)
        if held
            klog(": BIOS kept ownership past 1 s: taking it\n")
            wr32(addr, (rd32(addr) & (0xFFFFFFFF ^ LEGSUP_BIOS_OWNED)) | LEGSUP_OS_OWNED)
        else
            klog(": BIOS handoff done\n")
    else
        wr32(addr, v | LEGSUP_OS_OWNED)
    let ctl: u64 = addr + LEGCTL_OFFSET
    wr32(ctl, legctl_quiet(rd32(ctl)))

# Walk the extended capabilities: hand off from the BIOS and keep each
# Supported Protocol.
fn walk_xcaps(h: *Xhci)
    var off: u64 = h.params.xecp as u64
    var n: u32 = 0
    while off != 0 and n < XCAPS_MAX
        let cap: XCap = xcap_decode(rd32(h.mmio + off))
        if cap.id == XCAP_LEGACY
            bios_handoff(h, off)
        if cap.id == XCAP_PROTOCOL and h.nprotocols < PROTOCOLS_MAX
            let a: u64 = h.mmio + off
            match protocol_decode(rd32(a), rd32(a + 4), rd32(a + 8), rd32(a + 12))
                Ok(p) =>
                    h.protocols[h.nprotocols] = p
                    h.nprotocols += 1
                    log_hc(h)
                    klog(" ports ")
                    klog_dec(p.first_port as i64)
                    klog("-")
                    klog_dec((p.first_port as i64) + (p.count as i64) - 1)
                    klog(": USB ")
                    klog_dec(p.major as i64)
                    klog(".")
                    klog_hex(p.minor as u64)
                    klog("\n")
                Err(_) => pass
        if cap.next == 0
            return
        off += cap.next as u64
        n += 1

# Clear Run/Stop (and the interrupt enable): the first step of a halt.
fn stop(h: *Xhci)
    op_wr(h, OP_USBCMD, op_rd(h, OP_USBCMD) & (0xFFFFFFFF ^ (USBCMD_RS | USBCMD_INTE)))

# Halt, then reset (docs/USB.md step 3). Boot only.
fn halt_and_reset(h: *Xhci) -> Result<bool, XhciError>
    stop(h)
    if not op_wait(h, OP_USBSTS, USBSTS_HCH, USBSTS_HCH, HALT_US)
        return Err(XhciError.HaltTimeout)
    op_wr(h, OP_USBCMD, USBCMD_HCRST)
    if not op_wait(h, OP_USBCMD, USBCMD_HCRST, 0, RESET_US)
        return Err(XhciError.ResetTimeout)
    if not op_wait(h, OP_USBSTS, USBSTS_CNR, 0, RESET_US)
        return Err(XhciError.ResetTimeout)
    Ok(true)

# The scratchpad buffer array and its pages (HCSPARAMS2). Allocated once;
# the controller owns their contents.
fn alloc_scratchpad(h: *Xhci) -> Result<bool, XhciError>
    let n: u32 = h.params.scratchpads
    if n == 0
        return Ok(true)
    let array: u64 = alloc_for(h, (n * 8 + 4095) / 4096)?
    for i in 0..n
        let page: u64 = alloc_for(h, 1)?
        *((phys_to_virt(array) + (i as u64) * 8) as *u64) = page
    h.scratch = array
    Ok(true)

# The controller's own pages, allocated at its bring-up and kept across
# its resets.
fn alloc_memory(h: *Xhci) -> Result<bool, XhciError>
    h.dcbaa = alloc_for(h, 1)?
    alloc_scratchpad(h)?
    h.cmd_page = alloc_for(h, 1)?
    h.ev_page = alloc_for(h, 1)?
    h.erst = alloc_for(h, 1)?
    Ok(true)

# DCBAA, command ring, event ring and ERST, cleared and programmed into the
# halted, reset controller (docs/USB.md step 4): at bring-up and after each
# recovery reset, which forgets every slot and both rings.
fn program_memory(h: *Xhci)
    zero_page(h.dcbaa)
    *dcbaa_entry(h, 0) = h.scratch
    zero_page(h.cmd_page)
    h.cmd = TrbRing.new(phys_to_virt(h.cmd_page) as *TrbPage, h.cmd_page, RING_TRBS)
    for i in 0..256
        h.cmd_owner[i] = 0
        h.dev_cmds[i] = 0
    zero_page(h.ev_page)
    h.events = EventRing.new(phys_to_virt(h.ev_page) as *TrbPage, h.ev_page, RING_TRBS)
    *(phys_to_virt(h.erst) as *ErstEntry) = erst_entry(h.ev_page, RING_TRBS)

    op_wr(h, OP_CONFIG, (op_rd(h, OP_CONFIG) & 0xFFFFFF00) | (h.params.max_slots as u32))
    wr64(h.op + OP_DCBAAP, h.dcbaa)
    wr64(h.op + OP_CRCR, h.cmd.dequeue_ptr())
    # Interrupter 0: one segment, the dequeue pointer at its start, then
    # the table's address (the write that makes the controller read it).
    wr32(ir0(h) + IR_ERSTSZ, 1)
    wr64(ir0(h) + IR_ERDP, h.ev_page)
    wr64(ir0(h) + IR_ERSTBA, h.erst)

# How controller `h`'s interrupter 0 reaches the BSP: the one place a
# controller's interrupt source is chosen, once per controller (a recovery
# reset leaves the PCI function's MSI-X table and MSI registers alone).
# Each vector is a new one of its own, aimed at this CPU, the BSP
# (irq_route_dest, and an IRTE when remapping is on), from the first of
# these `mode` allows that works:
#   - MSI-X entry 0 (msix_set_entry);
#   - plain MSI, one message (msi_enable, AGAST #4885), when the function
#     has no MSI-X: the X99's Intel 8086:8d31;
#   - none: INTx is masked and the BSP's tick polls the controller.
# A function whose MSI-X was turned on and then could not be aimed is
# polled rather than tried on MSI: the two must never be on together. A
# controller left to the poll says why.
fn setup_vector(h: *Xhci, mode: UsbIrqMode) -> IrqVia
    if not mode.allows_msi()
        return poll(h, "usb-poll")
    if mode.allows_msix() and msix_probe(h.pci, @h.msix) == 0
        return match msix_vector(h)
            Ok(v) =>
                h.vector = v
                IrqVia.MsiX
            Err(why) => poll(h, why)
    match msi_vector(h)
        Ok(v) =>
            h.vector = v
            IrqVia.Msi
        Err(why) => poll(h, why)

# MSI-X entry 0 of a function msix_probe found it on, on a new vector.
fn msix_vector(h: *Xhci) -> Result<u8, StrView>
    if msix_enable(@h.msix) != 0
        return Err("MSI-X table not mappable")
    let v: u8 = msix_vector_alloc()
    if v == 0
        return Err("out of MSI-X vectors")
    if msix_set_entry(@h.msix, 0, v) != 0
        return Err("MSI-X entry not aimed at a CPU")
    Ok(v)

# Plain MSI, one message, on a new vector.
fn msi_vector(h: *Xhci) -> Result<u8, StrView>
    let m = match msi_probe(h.pci)
        Some(m) => m
        None => return Err("no MSI-X or MSI capability")
    let v: u8 = msix_vector_alloc()
    if v == 0
        return Err("out of MSI vectors")
    match msi_enable(m, v)
        Ok(_) => Ok(v)
        Err(_) => Err("MSI not aimed at a CPU")

# No vector, for the reason `why`: mask INTx, which USBCMD.INTE would
# otherwise raise with no handler, and leave the controller to the BSP's
# tick.
fn poll(h: *Xhci, why: StrView) -> IrqVia
    log_hc(h)
    klog(": no vector (")
    klog(why)
    klog("): the BSP tick polls it\n")
    pci_disable_intx(h.pci)
    IrqVia.Poll

# Interrupter 0 on (moderation off at first, docs/USB.md step 5), the
# status bits cleared, then Run/Stop and the interrupt enables.
fn start(h: *Xhci)
    wr32(ir0(h) + IR_IMOD, 0)
    wr32(ir0(h) + IR_IMAN, IMAN_IE | IMAN_IP)
    op_wr(h, OP_USBSTS, USBSTS_EINT | USBSTS_PCD | USBSTS_HSE)
    op_wr(h, OP_USBCMD, USBCMD_RS | USBCMD_INTE | USBCMD_HSEE)

# Power every port when the controller switches port power (PPC); a port
# that is already powered is left alone.
fn power_ports(h: *Xhci)
    if not h.params.ppc
        return
    for p in 1..=h.params.max_ports
        let v: u32 = op_rd(h, portsc_reg(p))
        if (v & PORTSC_PP) == 0
            op_wr(h, portsc_reg(p), portsc_power_on(v))

fn log_found(h: *Xhci, dw0: u32)
    let d: *PciDevice = h.pci
    log_hc(h)
    klog(" ")
    log_bdf(d)
    klog(" ")
    klog_hex_width(d.vendor_id as u64, 4)
    klog(":")
    klog_hex_width(d.device_id as u64, 4)
    let ver: u16 = hci_version(dw0)
    klog(" v")
    klog_hex((ver >> 8) as u64)
    klog(".")
    klog_hex_width((ver & 0xFF) as u64, 2)
    klog(": ")
    klog_dec(h.params.max_slots as i64)
    klog(" slots, ")
    klog_dec(h.params.max_ports as i64)
    klog(" ports, ")
    klog_dec(if h.params.ctx64 then 64 else 32)
    klog("-byte contexts, ")
    klog_dec(h.params.scratchpads as i64)
    klog(" scratchpads")
    if h.params.ac64
        klog(", 64-bit DMA")
    klog("\n")

fn bring_up(h: *Xhci, mode: UsbIrqMode) -> Result<bool, XhciError>
    let d: *PciDevice = h.pci
    if d.bar[0] == 0 or d.bar_is_io[0] != 0 or d.bar_size[0] == 0
        return Err(XhciError.BadBar)
    h.mmio = vmm_map_mmio(d.bar[0], d.bar_size[0])
    if h.mmio == 0
        return Err(XhciError.BadBar)
    pci_enable_memory(d)
    pci_enable_bus_master(d)

    let dw0: u32 = rd32(h.mmio + CAP_LENGTH_VERSION)
    h.op = h.mmio + (cap_length(dw0) as u64)
    h.rt = h.mmio + ((rd32(h.mmio + CAP_RTSOFF) & RTSOFF_MASK) as u64)
    h.db = h.mmio + ((rd32(h.mmio + CAP_DBOFF) & DBOFF_MASK) as u64)
    h.params = hc_params(rd32(h.mmio + CAP_HCSPARAMS1), rd32(h.mmio + CAP_HCSPARAMS2), rd32(h.mmio + CAP_HCCPARAMS1))
    log_found(h, dw0)

    walk_xcaps(h)
    halt_and_reset(h)?
    if (op_rd(h, OP_PAGESIZE) & PAGESIZE_4K) == 0
        return Err(XhciError.PageSize)
    alloc_memory(h)?
    program_memory(h)

    h.via = setup_vector(h, mode)
    h.watch = VectorWatch.new()
    start(h)
    if not op_wait(h, OP_USBSTS, USBSTS_HCH, 0, HALT_US)
        return Err(XhciError.StartTimeout)
    h.state = HcState.Running
    power_ports(h)

    log_hc(h)
    klog(" running: ")
    match h.via
        Poll => klog("no vector, polled from the BSP tick\n")
        MsiX | Msi =>
            klog(via_name(h.via))
            klog(" vector ")
            klog_dec(h.vector as i64)
            klog(" -> BSP\n")
    Ok(true)

# Bring up every xHCI controller, at most XHCS_MAX. Boot only, on the BSP,
# with interrupts off and before any AP runs a process; `mode` is the
# interrupt sources the boot options allow (setup_vector). One that fails is
# logged and left off; the others still come up. The number running, or
# NotFound if there is no controller, or the first one's error if none came
# up.
pub fn xhci_init(mode: UsbIrqMode) -> Result<u8, XhciError>
    let n: i32 = pci_get_device_count()
    var first_err: Option<XhciError> = None
    var running: u8 = 0
    for i in 0..n
        let d: *PciDevice = pci_get_device(i)
        if not is_xhci(d)
            continue
        if nxhcs >= XHCS_MAX
            klog("[xhci] ")
            log_bdf(d)
            klog(": more than ")
            klog_dec(XHCS_MAX as i64)
            klog(" controllers; not driven\n")
            continue
        let h: *Xhci = hc_of(nxhcs)
        h.pci = d
        h.index = nxhcs
        nxhcs += 1
        match bring_up(h, mode)
            Ok(_) =>
                running += 1
            Err(e) =>
                h.state = HcState.Off
                log_hc(h)
                klog(": ")
                klog(xhci_error_name(e))
                klog("; controller left off\n")
                if first_err.is_none()
                    first_err = Some(e)
    if running > 0
        return Ok(running)
    match first_err
        Some(e) => Err(e)
        None => Err(XhciError.NotFound)

# ============================================================================
# Recovery (docs/USB.md "Hot-plug"): one controller reset alone
# ============================================================================

# USBSTS reads all-ones (the controller is gone) or reports a host system
# error or a host controller error.
fn dead(h: *Xhci) -> bool
    let s: u32 = op_rd(h, OP_USBSTS)
    s == 0xFFFFFFFF or (s & (USBSTS_HSE | USBSTS_HCE)) != 0

# A healthy controller's vector, at its health check: an event that has
# waited on the event ring a whole check period for an interrupt that never
# came (VectorWatch) moves the controller to the BSP tick's poll for good.
# The ring is asked, not IMAN.IP: an event posted between xhci_irq's ack
# and its drain sets IP again and is drained in the same pass, leaving IP
# set over an empty ring (seen on QEMU, #4891's enumerate boot). Its vector stays
# bound, so one that comes back late does no harm: xhci_irq finds the ring
# already drained.
fn watch_vector(h: *Xhci)
    if h.via == IrqVia.Poll
        return
    if not h.watch.stalled(h.events.pending(), msix_vector_count(h.vector))
        return
    log_hc(h)
    klog(": ")
    klog(via_name(h.via))
    klog(" vector ")
    klog_dec(h.vector as i64)
    klog(" never fired: polled from the BSP tick\n")
    h.via = IrqVia.Poll

fn give_up(h: *Xhci, why: StrView) -> HcStep
    h.state = HcState.Failed
    log_hc(h)
    klog(": recovery failed (")
    klog(why)
    klog("); controller left off\n")
    HcStep.GaveUp

# One BSP tick for controller `hc`: a running controller's health is
# checked every HEALTH_TICKS; a recovering one's step is checked every
# tick. Interrupts are off (the tick's handler).
pub fn xhci_tick(hc: u8) -> HcStep
    let h: *Xhci = hc_of(hc)
    match h.state
        Running =>
            h.ticks += 1
            if h.ticks < HEALTH_TICKS
                return HcStep.Idle
            h.ticks = 0
            if not dead(h)
                watch_vector(h)
                return HcStep.Idle
            log_hc(h)
            klog(": controller error (USBSTS 0x")
            klog_hex_width(op_rd(h, OP_USBSTS) as u64, 8)
            klog("): resetting it alone\n")
            stop(h)
            h.state = HcState.Halting
            h.deadline = deadline_after_us(HALT_US)
            HcStep.Died
        Halting =>
            # A controller that will not halt is reset anyway: HCRST is
            # the way out of a Host Controller Error.
            if (op_rd(h, OP_USBSTS) & USBSTS_HCH) == 0 and not deadline_passed(h.deadline)
                return HcStep.Idle
            op_wr(h, OP_USBCMD, USBCMD_HCRST)
            h.state = HcState.Resetting
            h.deadline = deadline_after_us(RESET_US)
            HcStep.Idle
        Resetting =>
            let busy: bool = (op_rd(h, OP_USBCMD) & USBCMD_HCRST) != 0 or (op_rd(h, OP_USBSTS) & USBSTS_CNR) != 0
            if busy
                if deadline_passed(h.deadline)
                    return give_up(h, "reset timed out: the controller may be gone")
                return HcStep.Idle
            program_memory(h)
            start(h)
            h.state = HcState.Starting
            h.deadline = deadline_after_us(HALT_US)
            HcStep.Idle
        Starting =>
            if (op_rd(h, OP_USBSTS) & USBSTS_HCH) != 0
                if deadline_passed(h.deadline)
                    return give_up(h, "start timed out")
                return HcStep.Idle
            h.state = HcState.Running
            h.ticks = 0
            power_ports(h)
            log_hc(h)
            klog(": reset done, ports re-enumerating\n")
            HcStep.Restarted
        Off | Failed => HcStep.Idle

# The fault-usb boot option (AGAST #4889, test only): make controller `hc`
# fail as a Host Controller Error does. Interrupter 0's segment table is
# rewritten with a size the controller cannot take (QEMU's qemu-xhci has
# one segment, and asserts HCE), so the next health check finds it.
pub fn xhci_inject_fault(hc: u8)
    let h: *Xhci = hc_of(hc)
    if h.state != HcState.Running
        return
    log_hc(h)
    klog(": fault-usb: forcing a controller error\n")
    wr32(ir0(h) + IR_ERSTSZ, 2)
    wr64(ir0(h) + IR_ERSTBA, h.erst)

# ============================================================================
# What usb.ritz drives a controller with (all BSP, see the header)
# ============================================================================

# Controllers xhci_init found (running, failed or off): their indices are
# 0 .. xhci_count() - 1.
pub fn xhci_count() -> u8
    nxhcs

pub fn xhci_running(hc: u8) -> bool
    hc < nxhcs and hc_of(hc).state == HcState.Running

# How controller `hc` is serviced now: "MSI-X", "MSI" or "polled"
# (setup_vector, watch_vector), for the log.
pub fn xhci_irq_via(hc: u8) -> StrView
    via_name(hc_of(hc).via)

# A running controller the BSP's tick must poll: it has no vector, or its
# vector never fired (setup_vector, watch_vector).
pub fn xhci_polled(hc: u8) -> bool
    xhci_running(hc) and hc_of(hc).via == IrqVia.Poll

pub fn xhci_ctx64(hc: u8) -> bool
    hc_of(hc).params.ctx64

pub fn xhci_max_ports(hc: u8) -> u8
    hc_of(hc).params.max_ports

# The Supported Protocol that covers root port `port`.
pub fn xhci_port_protocol(hc: u8, port: u8) -> Option<PortProtocol>
    let h: *Xhci = hc_of(hc)
    for i in 0..h.nprotocols
        let p: PortProtocol = h.protocols[i]
        if p.covers(port)
            return Some(p)
    None

pub fn xhci_portsc(hc: u8, port: u8) -> u32
    op_rd(hc_of(hc), portsc_reg(port))

# Write PORTSC; `v` is built from usb_abi's portsc_* helpers so it acts
# only as meant.
pub fn xhci_portsc_write(hc: u8, port: u8, v: u32)
    op_wr(hc_of(hc), portsc_reg(port), v)

# Point slot `slot`'s DCBAA entry at its device context (0: none).
pub fn xhci_set_device_context(hc: u8, slot: u8, ctx: u64)
    *dcbaa_entry(hc_of(hc), slot) = ctx

# Ring slot `slot`'s doorbell for endpoint `dci` (0 and DB_HOST: the
# command ring). The TRBs it announces are written before it.
pub fn xhci_doorbell(hc: u8, slot: u8, dci: u8)
    fence()
    wr32(hc_of(hc).db + (slot as u64) * 4, dci as u32)

# Queue command `t` on behalf of usb.ritz's device entry `dev` (a root
# port's device, or one behind a hub) and ring the host doorbell. Its
# Command Completion Event names the TRB; xhci_command_done gives `dev`
# back.
pub fn xhci_command(hc: u8, t: Trb, dev: u8) -> Result<u64, RingError>
    let h: *Xhci = hc_of(hc)
    let p: u64 = h.cmd.push(t)?
    match h.cmd.index_of(p)
        Some(i) =>
            h.cmd_owner[i] = dev
            h.dev_cmds[dev] += 1
        None => pass
    xhci_doorbell(hc, 0, DB_HOST as u8)
    Ok(p)

# The command TRB at `trb` completed: retire it and return the device entry
# it was queued for.
pub fn xhci_command_done(hc: u8, trb: u64) -> Option<u8>
    let h: *Xhci = hc_of(hc)
    match h.cmd.retire(trb)
        Ok(i) =>
            let dev: u8 = h.cmd_owner[i]
            if h.dev_cmds[dev] > 0
                h.dev_cmds[dev] -= 1
            Some(dev)
        Err(_) => None

# Commands queued for device entry `dev` whose completion has not arrived:
# a detach waits for them before it frees the device's pages.
pub fn xhci_dev_commands(hc: u8, dev: u8) -> u8
    hc_of(hc).dev_cmds[dev]

# The interrupter's pending bit and the controller's event bit, cleared
# before the event ring is drained so a later event raises a new interrupt.
pub fn xhci_irq_ack(hc: u8)
    let h: *Xhci = hc_of(hc)
    wr32(ir0(h) + IR_IMAN, IMAN_IE | IMAN_IP)
    op_wr(h, OP_USBSTS, USBSTS_EINT)

pub fn xhci_next_event(hc: u8) -> Option<Event>
    let h: *Xhci = hc_of(hc)
    match h.events.next()
        Some(t) => Some(event_decode(t))
        None => None

# Tell the controller how far the driver has read, clearing Event Handler
# Busy.
pub fn xhci_events_done(hc: u8)
    let h: *Xhci = hc_of(hc)
    wr64(ir0(h) + IR_ERDP, h.events.erdp() | ERDP_EHB)

# The running controller whose vector is `vector` (irq_handler), if any.
pub fn xhci_of_vector(vector: u64) -> Option<u8>
    for i in 0..nxhcs
        let h: *Xhci = hc_of(i)
        if h.state == HcState.Running and h.vector != 0 and vector == h.vector as u64
            return Some(i)
    None
