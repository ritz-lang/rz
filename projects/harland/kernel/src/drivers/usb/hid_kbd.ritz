# Harland USB HID boot keyboard (AGAST #4888, docs/USB.md "Data path")
#
# A configured device whose configuration has a HID boot keyboard
# interface (class 3, subclass 1, protocol 1) with an interrupt IN endpoint
# is handed here by drivers/usb/usb.ritz, and every later event for it
# comes here too. Bring-up, each step on its completion event:
# SET_PROTOCOL(boot), SET_IDLE(0) (a stall is allowed: the request is
# optional), Configure Endpoint for the interrupt IN endpoint, then one
# Normal TRB on its ring, requeued as each report lands.
#
# Each 8-byte boot report goes through usb_abi.hid (diff against the last
# report, US keymap, Caps Lock) and its bytes into the console through
# tty_console_input, as COM1's and the PS/2 keyboard's do. A Caps Lock
# press sets the LED with SET_REPORT on EP0. A boot keyboard under
# SET_IDLE(0) does not repeat, so the BSP tick (hid_kbd_tick) repeats the
# newest held key: 500 ms, then every 3 ticks.
#
# Keyboards on every controller (#4889) are told apart by controller and
# slot, or controller and usb.ritz's device entry (a root port's, or one
# behind a hub: #4890). A detach, or its controller failing,
# releases the keyboard's held keys at once (hid_kbd_detach: no repeat
# outlives the device); its pages are freed (hid_kbd_free) only once its
# slot is disabled or its controller reset, when nothing can DMA to them.
#
# Ownership: BSP-owned with no lock, as the rest of drivers/usb (usb.ritz's
# header): xhci_irq's events and the BSP tick, both with interrupts off.

import ritzlib.option
import ritzlib.strview { StrView }
import ritzlib.span { span_from_ptr }
import klog { klog, klog_dec, klog_hex_width }
import mm.vmm { phys_to_virt }
import arch.x86_64.apic { lapic_is_bsp }
import tty.console { tty_console_input }
import drivers.usb.xhci { xhci_irq_via, xhci_ctx64, xhci_doorbell, xhci_command, xhci_alloc_page, xhci_free_page }
import usb_abi.regs { UsbSpeed, EpKind, ep_interval }
import usb_abi.trb { Completion, completion_ok, TransferEvent, trb_configure_endpoint, trb_setup_stage, trb_data_stage, trb_status_stage, trb_normal }
import ritzlib.result
import usb_abi.ring { TrbPage, TrbRing, RingError, RING_TRBS }
import usb_abi.context { SlotPlace, InputContext, EpType, ADD_SLOT, input_control, slot_ctx, ep_ctx, add_flag, dci_of }
import usb_abi.desc { SetupPacket, DescWalk }
import usb_abi.hid { HidKbd, KeyOut, BOOT_REPORT_LEN, setup_set_protocol, setup_set_idle, setup_set_report_leds }

# Keyboards driven at once.
const KBDS_MAX: u32 = 4
const HID_CLASS: u8 = 3
const HID_SUBCLASS_BOOT: u8 = 1
const HID_PROTOCOL_KEYBOARD: u8 = 1
const DCI_EP0: u8 = 1
# The buffer page: the report at its start, the LED byte SET_REPORT sends
# at LED_OFFSET.
const LED_OFFSET: u64 = 64

enum KbdState
    Free
    SettingProtocol         # SET_PROTOCOL(boot) on EP0
    SettingIdle             # SET_IDLE(0) on EP0
    ConfiguringEndpoint     # Configure Endpoint queued
    Running                 # a Normal TRB is always queued
    Failed                  # stopped; waits for a disconnect
    Detached                # gone, keys released; pages wait for hid_kbd_free

# What usb.ritz hands over with a configured device.
pub struct HidAttach
    hc: u8                  # its controller
    slot: u8
    dev: u8                 # usb.ritz's device entry, the owner of its commands
    speed: UsbSpeed
    place: SlotPlace        # where it is: root port, route string, TT
    in_ctx: u64             # the device's input context page (phys)
    ep0: *TrbRing           # its EP0 transfer ring, usb.ritz's

struct Kbd
    state: KbdState
    hc: u8
    slot: u8
    dev: u8
    speed: UsbSpeed
    place: SlotPlace
    iface: u8
    ep_addr: u8
    dci: u8
    mps: u16
    interval: u8            # the endpoint context's Interval
    in_ctx: u64
    ep0: *TrbRing
    ring_page: u64          # the interrupt IN transfer ring (phys)
    ring: TrbRing
    buf: u64                # report and LED byte (phys)
    ep_on: bool             # its interrupt IN endpoint is configured
    ep0_busy: bool          # a SET_REPORT in flight
    leds_dirty: bool        # Caps Lock changed while it was
    keys: HidKbd

var kbds: [4]Kbd
# Running keyboards: the tick's quick way out when there are none.
var kbds_running: u32 = 0

# The boot keyboard interface a configuration offers: its number, and its
# interrupt IN endpoint's address, size and bInterval.
struct KbdIface
    number: u8
    ep_addr: u8
    mps: u16
    binterval: u8

fn log_slot(k: *Kbd)
    klog("[usb] hc")
    klog_dec(k.hc as i64)
    klog(" slot ")
    klog_dec(k.slot as i64)

fn fail(k: *Kbd, what: StrView)
    log_slot(k)
    klog(": keyboard ")
    klog(what)
    klog("; keyboard stopped\n")
    if k.state == KbdState.Running
        kbds_running -= 1
    k.state = KbdState.Failed

fn zero_page(phys: u64)
    let w: *u64 = phys_to_virt(phys) as *u64
    for i in 0..512
        *(w + i) = 0

# The first HID boot keyboard interface (alternate setting 0) with an
# interrupt IN endpoint, in the configuration `config`.
fn find_iface(config: [u8]) -> Option<KbdIface>
    var w = match DescWalk.new(config)
        Ok(w) => w
        Err(_) => return None
    var in_kbd: bool = false
    var number: u8 = 0
    while true
        match w.next()
            Ok(item) =>
                match item
                    Interface(i) =>
                        in_kbd = i.alternate == 0 and i.class == HID_CLASS and i.subclass == HID_SUBCLASS_BOOT and i.protocol == HID_PROTOCOL_KEYBOARD
                        number = i.number
                    Endpoint(e) =>
                        if in_kbd and e.is_in() and e.kind() == EpKind.Interrupt
                            return Some(KbdIface { number: number, ep_addr: e.address, mps: e.max_packet(), binterval: e.interval })
                    Other(_) => pass
                    End => return None
            Err(_) => return None

# The keyboard on slot `slot` of controller `hc`, still driven.
fn kbd_of_slot(hc: u8, slot: u8) -> Option<*Kbd>
    for i in 0..KBDS_MAX
        let k: *Kbd = @kbds[i]
        if k.state != KbdState.Free and k.state != KbdState.Detached and k.hc == hc and k.slot == slot
            return Some(k)
    None

# The keyboard on usb.ritz's device entry `dev` of controller `hc`,
# detached or not.
fn kbd_of_dev(hc: u8, dev: u8) -> Option<*Kbd>
    for i in 0..KBDS_MAX
        let k: *Kbd = @kbds[i]
        if k.state != KbdState.Free and k.hc == hc and k.dev == dev
            return Some(k)
    None

# A free entry with its two pages from controller `hc`; hid_kbd_free gives
# them back.
fn kbd_entry(hc: u8) -> Option<*Kbd>
    for i in 0..KBDS_MAX
        let k: *Kbd = @kbds[i]
        if k.state == KbdState.Free
            let ring: u64 = match xhci_alloc_page(hc)
                Ok(p) => p
                Err(_) => return None
            match xhci_alloc_page(hc)
                Ok(p) => k.buf = p
                Err(_) =>
                    xhci_free_page(ring)
                    return None
            k.ring_page = ring
            return Some(k)
    None

# A class request on EP0 with no data stage, or with SET_REPORT's one LED
# byte (OUT): Setup, Data, Status (IN, the interrupt). The Status TRB's
# address, or Full with nothing queued.
fn control(k: *Kbd, s: SetupPacket, next: KbdState) -> Result<u64, RingError>
    let need: u32 = if s.length == 0 then 2 else 3
    if k.ep0.free() < need
        return Err(RingError.Full)
    k.ep0.push(trb_setup_stage(s))
    if s.length != 0
        k.ep0.push(trb_data_stage(k.buf + LED_OFFSET, s.length as u32, false))
    let status: Result<u64, RingError> = k.ep0.push(trb_status_stage(true))
    k.state = next
    xhci_doorbell(k.hc, k.slot, DCI_EP0)
    status

# Send the Caps Lock LED, or mark it to send when the SET_REPORT in flight
# completes.
fn send_leds(k: *Kbd)
    if k.ep0_busy
        k.leds_dirty = true
        return
    *((phys_to_virt(k.buf) + LED_OFFSET) as *u8) = k.keys.leds()
    k.leds_dirty = false
    k.ep0_busy = control(k, setup_set_report_leds(k.iface), KbdState.Running).is_ok()

# One Normal TRB for the next report, and the endpoint's doorbell. The
# TRB's address, or Full.
fn queue_report(k: *Kbd) -> Result<u64, RingError>
    let r: Result<u64, RingError> = k.ring.push(trb_normal(k.buf, BOOT_REPORT_LEN as u32))
    if r.is_ok()
        xhci_doorbell(k.hc, k.slot, k.dci)
    r

# SET_IDLE done: add the interrupt IN endpoint to the slot.
fn configure_endpoint(k: *Kbd)
    zero_page(k.in_ctx)
    zero_page(k.ring_page)
    k.ring = TrbRing.new(phys_to_virt(k.ring_page) as *TrbPage, k.ring_page, RING_TRBS)
    let ic: InputContext = InputContext.over(phys_to_virt(k.in_ctx), xhci_ctx64(k.hc))
    *ic.control() = input_control(0, ADD_SLOT | add_flag(k.dci))
    *ic.slot() = slot_ctx(k.speed, k.place, k.dci)
    *ic.ep(k.dci) = ep_ctx(EpType.InterruptIn, k.mps, k.interval, k.ring.dequeue_ptr())
    match xhci_command(k.hc, trb_configure_endpoint(k.in_ctx, k.slot), k.dev)
        Ok(_) => k.state = KbdState.ConfiguringEndpoint
        Err(_) => fail(k, "command ring full")

# What `out` sends into the console; true for a Ctrl-C that must kill the
# process `from_user` says was interrupted.
fn deliver(out: KeyOut, from_user: bool) -> bool
    if out.len == 0
        return false
    var o: KeyOut = out
    tty_console_input(StrView { ptr: @o.bytes[0], len: o.len }, from_user)

# A keyboard there is no entry or DMA page for: logged and left to
# usb.ritz. False, hid_kbd_attach's answer.
fn not_driven(a: HidAttach) -> bool
    klog("[usb] hc")
    klog_dec(a.hc as i64)
    klog(" slot ")
    klog_dec(a.slot as i64)
    klog(": HID boot keyboard not driven (no free keyboard or DMA page)\n")
    false

# ============================================================================
# What usb.ritz calls
# ============================================================================

# A configured device: take it if its configuration (`config`) has a boot
# keyboard interface, and start the keyboard's bring-up. False leaves the
# device to usb.ritz.
pub fn hid_kbd_attach(a: HidAttach, config: [u8]) -> bool
    let f: KbdIface = match find_iface(config)
        Some(f) => f
        None => return false
    let k: *Kbd = match kbd_entry(a.hc)
        Some(k) => k
        None => return not_driven(a)
    k.hc = a.hc
    k.slot = a.slot
    k.dev = a.dev
    k.speed = a.speed
    k.place = a.place
    k.in_ctx = a.in_ctx
    k.ep0 = a.ep0
    k.iface = f.number
    k.ep_addr = f.ep_addr
    k.dci = dci_of(f.ep_addr)
    k.mps = f.mps
    k.interval = ep_interval(a.speed, EpKind.Interrupt, f.binterval)
    k.ep0_busy = false
    k.leds_dirty = false
    k.ep_on = false
    k.keys = HidKbd.new()
    log_slot(k)
    klog(": HID boot keyboard on interface ")
    klog_dec(f.number as i64)
    klog(", endpoint 0x")
    klog_hex_width(f.ep_addr as u64, 2)
    klog("\n")
    if control(k, setup_set_protocol(k.iface), KbdState.SettingProtocol).is_err()
        fail(k, "EP0 ring full")
    true

# A command completed for the keyboard on device entry `dev` of
# controller `hc`. True when it made the keyboard ready.
pub fn hid_kbd_command(hc: u8, dev: u8, code: Completion) -> bool
    let k: *Kbd = match kbd_of_dev(hc, dev)
        Some(k) => k
        None => return false
    if k.state != KbdState.ConfiguringEndpoint
        return false
    if not completion_ok(code)
        fail(k, "Configure Endpoint failed")
        return false
    k.ep_on = true
    if queue_report(k).is_err()
        fail(k, "report ring full")
        return false
    k.state = KbdState.Running
    kbds_running += 1
    log_slot(k)
    klog(": keyboard ready (endpoint 0x")
    klog_hex_width(k.ep_addr as u64, 2)
    klog(", interval ")
    klog_dec(k.interval as i64)
    # How its controller is serviced (#4891): MSI-X, MSI or polled.
    klog(", ")
    klog(xhci_irq_via(k.hc))
    klog(")\n")
    true

# A transfer completed on one of a keyboard's endpoints. True for a Ctrl-C
# that must kill the process `from_user` says was interrupted.
pub fn hid_kbd_transfer(hc: u8, x: TransferEvent, from_user: bool) -> bool
    let k: *Kbd = match kbd_of_slot(hc, x.slot)
        Some(k) => k
        None => return false
    if x.dci == DCI_EP0
        on_ep0(k, x)
        return false
    if x.dci != k.dci or k.state != KbdState.Running
        return false
    let _ = k.ring.retire(x.trb)
    if not completion_ok(x.code)
        fail(k, "report failed")
        return false
    var n: i64 = BOOT_REPORT_LEN
    if x.residual as i64 <= n
        n = n - x.residual as i64
    # Decoded before the next TRB is queued: the controller writes the
    # next report into the same bytes.
    let out: KeyOut = k.keys.report(span_from_ptr<u8>(phys_to_virt(k.buf) as *u8, n))
    if queue_report(k).is_err()
        fail(k, "report ring full")
    if out.leds_changed
        send_leds(k)
    deliver(out, from_user)

fn on_ep0(k: *Kbd, x: TransferEvent)
    let _ = k.ep0.retire(x.trb)
    match k.state
        SettingProtocol =>
            if not completion_ok(x.code)
                fail(k, "SET_PROTOCOL failed")
            else if control(k, setup_set_idle(k.iface), KbdState.SettingIdle).is_err()
                fail(k, "EP0 ring full")
        SettingIdle =>
            # SET_IDLE is optional (HID 1.11 7.2.4): a stall is an answer.
            match x.code
                Stall => configure_endpoint(k)
                _ =>
                    if completion_ok(x.code)
                        configure_endpoint(k)
                    else
                        fail(k, "SET_IDLE failed")
        Running =>
            # A SET_REPORT finished. A device that will not take its LEDs
            # still types.
            k.ep0_busy = false
            if k.leds_dirty
                send_leds(k)
        _ => pass

# The keyboard on device entry `dev` of controller `hc` went away, or its
# controller failed: release its held keys now, so no repeat outlives it,
# and stop driving it. The DCI of its interrupt IN endpoint if it was
# configured (the endpoint the detach stops), else 0. Its pages stay until
# hid_kbd_free.
pub fn hid_kbd_detach(hc: u8, dev: u8) -> u8
    let k: *Kbd = match kbd_of_dev(hc, dev)
        Some(k) => k
        None => return 0
    if k.state == KbdState.Detached
        return 0
    if k.state == KbdState.Running
        kbds_running -= 1
    k.keys.release_all()
    k.state = KbdState.Detached
    log_slot(k)
    klog(": keyboard gone, keys released\n")
    if k.ep_on then k.dci else 0

# The keyboard's slot is disabled or its controller reset: nothing can
# reach its pages, so they are freed and its entry is free again.
pub fn hid_kbd_free(hc: u8, dev: u8)
    let k: *Kbd = match kbd_of_dev(hc, dev)
        Some(k) => k
        None => return
    if k.state == KbdState.Running
        kbds_running -= 1
    xhci_free_page(k.ring_page)
    xhci_free_page(k.buf)
    k.ring_page = 0
    k.buf = 0
    k.ep_on = false
    k.state = KbdState.Free

# The periodic tick, on every CPU (irq_handler, after its EOI). On the BSP,
# each running keyboard's held key repeats when due. True for a Ctrl-C
# that must kill the process `from_user` says was interrupted.
pub fn hid_kbd_tick(from_user: bool) -> bool
    if kbds_running == 0 or not lapic_is_bsp()
        return false
    var kill: bool = false
    for i in 0..KBDS_MAX
        let k: *Kbd = @kbds[i]
        if k.state == KbdState.Running
            if deliver(k.keys.tick(), from_user)
                kill = true
    kill
