# Harland Kernel - plain MSI capability layout (AGAST #4885)
#
# The MSI capability (ID 05h, PCI Local Bus 3.0 §6.8.1) has a fixed header
# and then a layout chosen by two Message Control bits:
#
#   +0  ID, next          +2  Message Control
#   +4  Message Address (low dword)
#   bit 7 clear (32-bit):  +8 Message Data,   +0x0C Mask Bits (bit 8 set)
#   bit 7 set (64-bit):    +8 Message Address (high dword),
#                          +0x0C Message Data, +0x10 Mask Bits (bit 8 set)
#
# Message Control bits 6:4 (Multiple Message Enable) say how many vectors
# the function may use; 0 is one. drivers/msix.ritz programs the device; this
# module only does the arithmetic, so the host tests (test/test_msi_cap.ritz)
# can check it without hardware.

pub const PCI_CAP_MSI: u8 = 0x05

pub const MSI_CAP_CONTROL: u8 = 2
pub const MSI_CAP_ADDR_LO: u8 = 4
pub const MSI_CAP_ADDR_HI: u8 = 8

const MSI_CTRL_ENABLE: u16 = 0x0001
const MSI_CTRL_MME: u16 = 0x0070
const MSI_CTRL_64BIT: u16 = 0x0080
const MSI_CTRL_PVM: u16 = 0x0100

# Where a function's MSI registers sit, as offsets from the capability.
pub struct MsiLayout
    is64: bool      # an upper address dword at MSI_CAP_ADDR_HI
    data: u8        # Message Data (16 bits)
    mask: u8        # Mask Bits, 0 when the function has no per-vector masking

pub fn msi_layout(ctrl: u16) -> MsiLayout
    let is64: bool = (ctrl & MSI_CTRL_64BIT) != 0
    let data: u8 = if is64 then 0x0C else 0x08
    var mask: u8 = 0
    if (ctrl & MSI_CTRL_PVM) != 0
        mask = data + 4
    MsiLayout { is64: is64, data: data, mask: mask }

# Message Control with MSI on and exactly one message (MME = 0).
pub fn msi_ctrl_one(ctrl: u16) -> u16
    (ctrl & ~MSI_CTRL_MME) | MSI_CTRL_ENABLE

# Message Control with MSI off, the rest as read.
pub fn msi_ctrl_off(ctrl: u16) -> u16
    ctrl & ~MSI_CTRL_ENABLE
