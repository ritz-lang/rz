# VirtIO Network Device Driver
#
# Implements a driver for VirtIO network devices (virtio-net).
# This allows sending and receiving Ethernet frames via QEMU's virtual NIC.
#
# Built on drivers/virtio/common.ritz, so it drives the NIC over either PCI
# transport: legacy (BAR0 I/O ports, QEMU's transitional default) or modern
# (virtio 1.x MMIO capabilities: disable-legacy=on, real hardware), AGAST #3576.
#
# Reference: https://docs.oasis-open.org/virtio/virtio/v1.1/cs01/virtio-v1.1-cs01.html
#
# The NIC's private DMA domain (AGAST #4724, docs/RING1_DRIVER.md "DMA
# domain"). On a boot that translates DMA the NIC and its aliases have no
# context (ir_init held them out of the identity domain), and this probe:
#   - turns the NIC's bus master off (vio_init_device_isolated) and names
#     every requester its DMA can carry (pci_dma_requesters); an alias it
#     can't name refuses the NIC: bus master stays off and DrvMmioMap
#     grants none of its queue-register pages;
#   - makes their private domain (dma_private_domain), and only then sets
#     bus master;
#   - proves the domain is the NIC's: a TX descriptor naming an IOVA that
#     nothing maps must fault with the NIC's source ID (the fault probe),
#     then resets the device;
#   - maps only its rings and its two buffer pools into the domain, at
#     fresh IOVAs (dma_domain_enter, DrvDmaAlloc's path), and programs
#     those: the first frame received logs its IOVA and the page the
#     domain maps it to.
# Without translation the rings and pools are programmed at their physical
# addresses, as before. net_ring1_allowed says whether a ring-1 owner could
# take the NIC: translation, remapping and blocked compatibility format,
# read from the unit, and the NIC isolated. The owner stays in the kernel.

import klog { klog, klog_dec, klog_hex, klog_hex_width }
import serial { StrView }
import io { memory_barrier, read_barrier, interrupts_enabled, cpu_pause }
import ritzlib.option
import ritzlib.span
import drivers.irq_wait { irq_wait_vector }
import drivers.pci { PciDevice, DmaRequesters, pci_find_virtio, pci_enable_bus_master, pci_dev_sid, pci_dma_requesters, VIRTIO_DEVICE_NET }
import mm.vmm { phys_to_virt }
import mm.dma { dma_alloc_zeroed, dma_free_pages, dma_quarantine }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import drivers.msix { MsixInfo, msix_probe, msix_enable, msix_vector_alloc, msix_set_entry, msix_set_entry_to, msix_entry_dest, msix_vector_count }
import drivers.virtio.common { VirtioDevice, VIO_TRANSPORT_MMIO, VIRTIO_MSI_NO_VECTOR, VIRTIO_STATUS_FAILED, VIRTIO_STATUS_ACKNOWLEDGE, VIRTIO_STATUS_DRIVER, vio_init_device, vio_init_device_isolated, vio_add_status, vio_reset, vio_get_status, vio_device_ready, vio_get_features, vio_set_features, vio_features_ok, vio_get_queue_size, vio_queue_alloc, vio_queue_reset, vio_queue_program, vio_queue_pages, vio_read_isr, vio_note_msix_on, vio_set_config_msix_vector, vio_read_config8, vio_read_config16, vq_notify }
import virtio_abi.features { VIRTIO_F_ACCESS_PLATFORM }
import drivers.iommu.vtd { VtdEnter }
import drivers.iommu.ir { dma_translation_on, dma_private_domain, dma_requester_isolated, dma_domain_enter, dma_domain_hole, dma_domain_phys, dma_fault_next, dma_isolation_live }
import virtio_abi.virtq { Virtqueue, VringDesc, TxSlots, vq_alloc_desc, vq_free_desc, vq_get_desc, vq_submit, vq_has_used, vq_get_used, vq_get_used_len, VRING_DESC_F_WRITE, tx_slots_init, tx_slots_take, tx_slots_post, vq_reclaim_tx }

extern fn lapic_id() -> u32

# MSI-X table entries this driver uses: config changes, RX queue, TX queue
const VIRTIO_NET_MSIX_ENTRIES: u16 = 3

# ============================================================================
# VirtIO-Net Feature Bits
# ============================================================================

pub const VIRTIO_NET_F_CSUM: u32 = 0x0001        # Device handles checksums
pub const VIRTIO_NET_F_GUEST_CSUM: u32 = 0x0002  # Guest handles checksums
pub const VIRTIO_NET_F_MAC: u32 = 0x0020         # Device has given MAC address
pub const VIRTIO_NET_F_GSO: u32 = 0x0040         # Deprecated, not used
pub const VIRTIO_NET_F_GUEST_TSO4: u32 = 0x0080  # Guest can receive TSOv4
pub const VIRTIO_NET_F_GUEST_TSO6: u32 = 0x0100  # Guest can receive TSOv6
pub const VIRTIO_NET_F_HOST_TSO4: u32 = 0x0800   # Device can receive TSOv4
pub const VIRTIO_NET_F_HOST_TSO6: u32 = 0x1000   # Device can receive TSOv6
pub const VIRTIO_NET_F_MRG_RXBUF: u32 = 0x8000   # Driver can merge receive buffers
pub const VIRTIO_NET_F_STATUS: u32 = 0x10000     # Device provides link status
pub const VIRTIO_NET_F_CTRL_VQ: u32 = 0x20000    # Control virtqueue available

# Device-specific config (virtio 1.1 §5.1.4): mac[6] then status u16
const VIRTIO_NET_CFG_MAC: u16 = 0
const VIRTIO_NET_CFG_STATUS: u16 = 6

# ============================================================================
# VirtIO Network Device State
# ============================================================================

pub struct VirtioNetDevice
    pci_dev: *PciDevice
    vdev: *VirtioDevice     # Common-layer device (either transport)
    rx_queue: *Virtqueue
    tx_queue: *Virtqueue
    hdr_size: u32           # VIRTIO_NET_HDR_SIZE[_V1]
    features: u32
    mac: [6]u8
    initialized: u8

# ============================================================================
# VirtIO-Net Header
# ============================================================================

struct VirtioNetHdr
    flags: u8
    gso_type: u8
    hdr_len: u16
    gso_size: u16
    csum_start: u16
    csum_offset: u16
    # num_buffers: u16  # Only with VERSION_1 or MRG_RXBUF

# The legacy header without MRG_RXBUF is 10 bytes; with VIRTIO_F_VERSION_1
# it always carries num_buffers and is 12 (virtio 1.1 §5.1.6).
const VIRTIO_NET_HDR_SIZE: u32 = 10
const VIRTIO_NET_HDR_SIZE_V1: u32 = 12

const VIRTIO_NET_HDR_GSO_NONE: u8 = 0
const VIRTIO_NET_HDR_GSO_TCPV4: u8 = 1
const VIRTIO_NET_HDR_GSO_UDP: u8 = 3
const VIRTIO_NET_HDR_GSO_TCPV6: u8 = 4

const VIRTIO_NET_HDR_F_NEEDS_CSUM: u8 = 1
const VIRTIO_NET_HDR_F_DATA_VALID: u8 = 2

# ============================================================================
# Buffer Configuration
# ============================================================================

const VIRTIO_NET_RX_BUFFER_SIZE: u32 = 2048
const VIRTIO_NET_RX_BUFFER_COUNT: u32 = 32
const VIRTIO_NET_TX_BUFFER_SIZE: u32 = 2048
const VIRTIO_NET_TX_BUFFER_COUNT: u32 = 32

# ============================================================================
# Buffers
# ============================================================================

# Global device (single NIC support for now)
var virtio_net: VirtioNetDevice

# A buffer pool: one zeroed contiguous run from the PMM, with the CPU's
# address and the device's (the IOVA in the NIC's private domain, else the
# physical address). Only these runs and the rings are in the domain: a
# kernel .bss array would share its first and last page with other data.
struct NicPool
    virt: u64
    dev: u64

const VIRTIO_NET_POOL_PAGES: u64 = 16       # 32 * 2048 bytes

# RX and TX buffers, VIRTIO_NET_*_BUFFER_COUNT of VIRTIO_NET_*_BUFFER_SIZE
var virtio_rx_pool: NicPool
var virtio_tx_pool: NicPool

# The NIC's private DMA domain, 0 when DMA isn't translated (AGAST #4724);
# the first received frame's DMA is logged once.
var virtio_net_dom: u32 = 0
var virtio_net_dma_logged: bool = false

# How long the fault probe waits for the NIC's fault record (100 ms).
const VIRTIO_NET_PROBE_US: u64 = 100000
# ... and for the device to read back status 0 after a reset.
const VIRTIO_NET_RESET_US: u64 = 100000
const NIC_PROBE_LEN: u32 = 64

# TX buffer ownership (AGAST #4073): slot b is buffer b of the TX pool,
# busy from the send that posts it until the device returns its
# descriptor through the used ring (virtio_abi.virtq TxSlots).
var virtio_tx_slots: TxSlots

# MSI-X state (AGAST #1852). Entry 0 signals config changes, entry 1 the RX
# queue and entry 2 the TX queue, each on its own IDT vector. Without MSI-X
# the device stays on INTx (masked at the I/O APIC) and is only polled.
var virtio_net_msix: MsixInfo
var virtio_net_msix_on: bool = false
var virtio_net_vectors: [3]u8

# RX waits (AGAST #3631): a caller with nothing to do until a frame arrives
# sleeps on the RX vector (virtio_net_wait_rx) for at most
# VIRTIO_NET_RX_WAIT_TICKS of LAPIC bus clock / 16 (~2 ms at QEMU's 1 GHz;
# a tick, 10 ms, once the scheduler tick runs). Counted: waits that slept,
# and the hlts they slept in.
const VIRTIO_NET_RX_WAIT_TICKS: u32 = 0x00020000
var virtio_net_rx_waits: u64 = 0
var virtio_net_rx_halts: u64 = 0

# ============================================================================
# VirtQueue Operations
# ============================================================================

# Post one buffer, at the device's address `dev_addr` (a pool's), to `vq`.
# Returns its descriptor index, or -1 if the queue is full.
fn virtq_add_buf(vq: *Virtqueue, dev_addr: u64, len: u32, flags: u16) -> i32
    let desc_idx: i32 = vq_alloc_desc(vq)
    if desc_idx < 0
        return -1

    let desc_ptr: *VringDesc = vq_get_desc(vq, desc_idx as u16)
    (*desc_ptr).addr = dev_addr
    (*desc_ptr).len = len
    (*desc_ptr).flags = flags
    (*desc_ptr).next = 0

    vq_submit(vq, desc_idx as u16)
    return desc_idx

fn virtq_kick(vq: *Virtqueue)
    # The new avail index must be visible before the device is told
    memory_barrier()
    vq_notify(vq)

# Next used descriptor of `vq`, or -1. Reads the ISR first, which deasserts
# a pending INTx (the polled, non-MSI-X mode).
fn virtq_get_used(vq: *Virtqueue) -> i32
    vio_read_isr(virtio_net.vdev)
    read_barrier()
    if not vq_has_used(vq)
        return -1
    return vq_get_used(vq)

# ============================================================================
# VirtQueue Initialization
# ============================================================================

# A new pool of VIRTIO_NET_POOL_PAGES, in the NIC's domain when it has one.
fn nic_pool_new() -> Option<NicPool>
    let phys: u64 = match dma_alloc_zeroed(VIRTIO_NET_POOL_PAGES as u32)
        Some(p) => p
        None => return None
    var dev: u64 = phys
    if virtio_net_dom != 0
        match dma_domain_enter(virtio_net_dom, phys, VIRTIO_NET_POOL_PAGES)
            VtdEnter.Entered(iova) => dev = iova
            VtdEnter.Refused =>
                dma_free_pages(phys, VIRTIO_NET_POOL_PAGES as u32)
                return None
            VtdEnter.Stuck =>
                dma_quarantine(phys, VIRTIO_NET_POOL_PAGES)
                return None
    Some(NicPool { virt: phys_to_virt(phys), dev: dev })

# Allocate queue `queue_index` (0 RX, 1 TX) at up to 256 entries, its
# rings in the NIC's domain when it has one (their IOVA is the address the
# device is given). Not yet told to the device.
fn virtio_net_alloc_queue(queue_index: u16) -> *Virtqueue
    let vq: *Virtqueue = vio_queue_alloc(virtio_net.vdev, queue_index)
    if vq == 0 as *Virtqueue
        klog("[virtio-net] ERROR: Queue ")
        klog_dec(queue_index as i64)
        klog(" not available\n")
        return vq
    if virtio_net_dom != 0
        match dma_domain_enter(virtio_net_dom, (*vq).phys_addr, vio_queue_pages(vq))
            VtdEnter.Entered(iova) => (*vq).phys_addr = iova
            VtdEnter.Refused =>
                klog("[nic-dma] queue rings not mapped in the NIC's domain\n")
                return 0 as *Virtqueue
            VtdEnter.Stuck =>
                dma_quarantine((*vq).phys_addr, vio_queue_pages(vq))
                return 0 as *Virtqueue
    return vq

# Both queues, allocated once: the fault probe uses the TX queue before the
# device's reset, and the setup that follows programs the same rings.
fn virtio_net_alloc_queues() -> bool
    if virtio_net.rx_queue == 0 as *Virtqueue
        virtio_net.rx_queue = virtio_net_alloc_queue(0)
    if virtio_net.tx_queue == 0 as *Virtqueue
        virtio_net.tx_queue = virtio_net_alloc_queue(1)
    virtio_net.rx_queue != 0 as *Virtqueue and virtio_net.tx_queue != 0 as *Virtqueue

# Program queue `vq` into the device from empty rings; under MSI-X it
# signals table entry queue_index + 1 (entry 0 is config). False if the
# queue refused its vector.
fn virtio_net_start_queue(vq: *Virtqueue) -> bool
    let vdev: *VirtioDevice = virtio_net.vdev
    let queue_index: u16 = (*vq).queue_index
    let max: u16 = vio_get_queue_size(vdev, queue_index)
    var vector: u16 = VIRTIO_MSI_NO_VECTOR
    if virtio_net_msix_on
        vector = queue_index + 1
    vio_queue_reset(vq)
    if not vio_queue_program(vdev, vq, vector)
        klog("[virtio-net] ERROR: Queue ")
        klog_dec(queue_index as i64)
        klog(" refused its vector\n")
        return false

    klog("[virtio-net] Queue ")
    klog_dec(queue_index as i64)
    klog(": size=")
    klog_dec((*vq).num as i64)
    klog(" (device max ")
    klog_dec(max as i64)
    klog(")\n")
    klog("[virtio-net]   Queue device address: 0x")
    klog_hex((*vq).phys_addr)
    klog("\n")
    return true

# Put the device in MSI-X mode: one IDT vector each for config changes, RX
# and TX. Must run before anything reads the device-specific config, which
# moves from offset 20 to 24 on the legacy transport once MSI-X is on.
# Returns 0 if MSI-X is on; -1 leaves the device on (polled) INTx.
fn virtio_net_setup_msix(pci_dev: *PciDevice) -> i32
    if msix_probe(pci_dev, @virtio_net_msix) != 0
        klog("[msix] virtio-net: no MSI-X capability, polling\n")
        return -1
    if virtio_net_msix.table_size < VIRTIO_NET_MSIX_ENTRIES
        klog("[msix] virtio-net: MSI-X table too small, polling\n")
        return -1
    var i: i32 = 0
    while i < VIRTIO_NET_MSIX_ENTRIES as i32
        virtio_net_vectors[i] = msix_vector_alloc()
        if virtio_net_vectors[i] == 0
            klog("[msix] virtio-net: out of MSI-X vectors, polling\n")
            return -1
        i = i + 1
    if msix_enable(@virtio_net_msix) != 0
        klog("[msix] virtio-net: can't map the MSI-X table, polling\n")
        return -1
    i = 0
    while i < VIRTIO_NET_MSIX_ENTRIES as i32
        msix_set_entry(@virtio_net_msix, i as u16, virtio_net_vectors[i])
        i = i + 1

    virtio_net_msix_on = true
    vio_note_msix_on(virtio_net.vdev)
    if vio_set_config_msix_vector(virtio_net.vdev, 0) != 0
        klog("[virtio-net] WARNING: config change vector refused\n")

    klog("[msix] virtio-net: MSI-X on, vectors config=")
    klog_dec(virtio_net_vectors[0] as i64)
    klog(" rx=")
    klog_dec(virtio_net_vectors[1] as i64)
    klog(" tx=")
    klog_dec(virtio_net_vectors[2] as i64)
    klog("\n")
    return 0

# ============================================================================
# Device Initialization
# ============================================================================

# Has the device read back status 0 since vio_reset (virtio 1.1 §4.1.4.3.1)?
fn virtio_net_reset_done(vdev: *VirtioDevice) -> bool
    vio_reset(vdev)
    let deadline: u64 = deadline_after_us(VIRTIO_NET_RESET_US)
    while vio_get_status(vdev) != 0
        if deadline_passed(deadline)
            return false
        cpu_pause()
    true

fn klog_sid(sid: u32)
    klog_hex_width(((sid >> 16) & 0xFFFF) as u64, 4)
    klog(":")
    klog_hex_width(((sid >> 8) & 0xFF) as u64, 2)
    klog(":")
    klog_hex_width(((sid >> 3) & 0x1F) as u64, 2)
    klog(".")
    klog_dec((sid & 7) as i64)

# The fault probe (AGAST #4724): with the device's DMA going through the
# NIC's private domain (VIRTIO_F_ACCESS_PLATFORM) and the TX rings mapped
# there, post one TX buffer at an IOVA nothing maps and kick. The device
# reads the descriptor from a granted page, then faults on the buffer: the
# unit's fault record must name the NIC's source ID `sid` and that page.
# The device then marks itself broken, so it is reset. True if that
# record was found.
fn virtio_net_fault_probe(vdev: *VirtioDevice, sid: u32) -> bool
    vio_set_features(vdev, VIRTIO_F_ACCESS_PLATFORM)
    if vio_features_ok(vdev) != 0 or not (*vdev).access_platform
        klog("[nic-dma] fault probe: the device did not take VIRTIO_F_ACCESS_PLATFORM\n")
        return false
    if not virtio_net_alloc_queues()
        return false
    let txq: *Virtqueue = virtio_net.tx_queue
    vio_queue_reset(txq)
    if not vio_queue_program(vdev, txq, VIRTIO_MSI_NO_VECTOR)
        return false
    let hole: u64 = match dma_domain_hole(virtio_net_dom)
        Some(iova) => iova
        None => return false
    if vio_device_ready(vdev) != 0
        return false
    # whatever a unit recorded before: not this probe's
    var stale: i32 = 0
    while stale < 64 and dma_fault_next().is_some()
        stale = stale + 1
    if virtq_add_buf(txq, hole, NIC_PROBE_LEN, 0) < 0
        return false
    virtq_kick(txq)
    var found: bool = false
    let deadline: u64 = deadline_after_us(VIRTIO_NET_PROBE_US)
    while not found and not deadline_passed(deadline)
        match dma_fault_next()
            Some(f) =>
                klog("[nic-dma] fault record: source ")
                klog_sid(f.sid)
                klog(" IOVA 0x")
                klog_hex(f.iova)
                klog(" reason ")
                klog_dec(f.reason as i64)
                if f.read
                    klog(" (read)\n")
                else
                    klog(" (write)\n")
                found = f.sid == sid and f.iova == hole
            None => cpu_pause()
    if found
        klog("[nic-dma] fault probe: the NIC's DMA to unmapped IOVA 0x")
        klog_hex(hole)
        klog(" faulted with its source ID ")
        klog_sid(sid)
        klog("\n")
    else
        klog("[nic-dma] fault probe: no fault record from the NIC for IOVA 0x")
        klog_hex(hole)
        klog("\n")
    if not virtio_net_reset_done(vdev)
        klog("[nic-dma] fault probe: the device did not reset\n")
        return false
    found

# Isolate the NIC on a translating boot (the header): name its requesters,
# give them a private domain, set bus master, run the fault probe and
# leave the device reset with ACKNOWLEDGE | DRIVER. False refuses the NIC:
# its bus master stays off.
fn virtio_net_isolate(pci_dev: *PciDevice, vdev: *VirtioDevice) -> bool
    var req: DmaRequesters = pci_dma_requesters(pci_dev)
    let sid: u32 = req.sids[0]
    if not req.named
        klog("[nic-dma] refused: a DMA alias of ")
        klog_sid(sid)
        klog(" can't be named; bus master stays off\n")
        return false
    virtio_net_dom = dma_private_domain(span_from_ptr<u32>(@req.sids[0], req.count as i64)).unwrap_or(0)
    if virtio_net_dom == 0
        klog("[nic-dma] refused: no private domain for ")
        klog_sid(sid)
        klog("; bus master stays off\n")
        return false
    pci_enable_bus_master(pci_dev)
    klog("[nic-dma] private domain ")
    klog_dec(virtio_net_dom as i64)
    klog(" for ")
    klog_sid(sid)
    klog(" and ")
    klog_dec((req.count - 1) as i64)
    klog(" alias(es), never in the identity map; bus master on\n")
    virtio_net_fault_probe(vdev, sid)
    if vio_get_status(vdev) != 0 and not virtio_net_reset_done(vdev)
        return false
    vio_add_status(vdev, VIRTIO_STATUS_ACKNOWLEDGE)
    vio_add_status(vdev, VIRTIO_STATUS_DRIVER)
    return true

# Could a ring-1 driver own the NIC (RING1_DRIVER.md "DMA domain")? Only
# with DMA translated, interrupts remapped and compatibility-format
# interrupts blocked, as every unit reports it now, and the NIC in its
# private domain with every alias named.
pub fn net_ring1_allowed() -> bool
    if not dma_isolation_live() or virtio_net_dom == 0 or virtio_net.pci_dev == 0 as *PciDevice
        return false
    dma_requester_isolated(pci_dev_sid(virtio_net.pci_dev))

pub fn virtio_net_init() -> i32
    let pci_dev: *PciDevice = pci_find_virtio(VIRTIO_DEVICE_NET)
    if pci_dev == (0 as *PciDevice)
        klog("[virtio-net] No network device found\n")
        return -1

    klog("\n[virtio-net] Initializing device at ")
    klog_dec((*pci_dev).bus as i64)
    klog(":")
    klog_dec((*pci_dev).device as i64)
    klog(".")
    klog_dec((*pci_dev).function as i64)
    klog("\n")

    virtio_net.pci_dev = pci_dev
    virtio_net.initialized = 0
    virtio_net.rx_queue = 0 as *Virtqueue
    virtio_net.tx_queue = 0 as *Virtqueue
    virtio_net_dom = 0
    virtio_net_dma_logged = false

    # Picks the transport, enables the PCI function, resets the device and
    # sets ACKNOWLEDGE | DRIVER. On a translating boot the NIC's bus master
    # stays off until its private domain is live (AGAST #4724).
    let isolate: bool = dma_translation_on()
    var vdev: *VirtioDevice = 0 as *VirtioDevice
    if isolate
        vdev = vio_init_device_isolated(pci_dev)
    else
        vdev = vio_init_device(pci_dev)
    if vdev == 0 as *VirtioDevice
        klog("[virtio-net] ERROR: no usable virtio transport\n")
        return -1
    virtio_net.vdev = vdev
    if (*vdev).transport == VIO_TRANSPORT_MMIO
        klog("[virtio-net] Transport: modern (MMIO)\n")
    else
        klog("[virtio-net] Transport: legacy (I/O port 0x")
        klog_hex((*vdev).io_base as u64)
        klog(")\n")
    if isolate and not virtio_net_isolate(pci_dev, vdev)
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return -1

    # MSI-X before any device-config read: it moves the legacy config to 24
    virtio_net_msix_on = false
    virtio_net_setup_msix(pci_dev)

    # Read device features (bits 0-31; the common layer handles VERSION_1)
    let device_features: u32 = vio_get_features(vdev)
    klog("[virtio-net] Device Features: 0x")
    klog_hex(device_features as u64)
    klog("\n")

    if (device_features & VIRTIO_NET_F_MAC) != 0
        klog("[virtio-net]   - MAC address provided\n")
    if (device_features & VIRTIO_NET_F_STATUS) != 0
        klog("[virtio-net]   - Link status available\n")

    # Negotiate features
    var accepted_features: u32 = 0
    if (device_features & VIRTIO_NET_F_MAC) != 0
        accepted_features = accepted_features | VIRTIO_NET_F_MAC
    if (device_features & VIRTIO_NET_F_STATUS) != 0
        accepted_features = accepted_features | VIRTIO_NET_F_STATUS

    # On a boot that translates DMA (AGAST #4723), VIRTIO_F_ACCESS_PLATFORM
    # (bit 33) too: a device created with iommu_platform=on then DMAs
    # through the IOMMU, here the NIC's private domain (AGAST #4724), not
    # to guest-physical addresses behind it.
    var wanted: u64 = accepted_features as u64
    if dma_translation_on()
        wanted = wanted | VIRTIO_F_ACCESS_PLATFORM
    vio_set_features(vdev, wanted)
    virtio_net.features = accepted_features
    if vio_features_ok(vdev) != 0
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return -1
    if (*vdev).access_platform
        klog("[virtio-net] VIRTIO_F_ACCESS_PLATFORM negotiated: DMA through the IOMMU\n")

    virtio_net.hdr_size = VIRTIO_NET_HDR_SIZE
    if (*vdev).version_1 != 0
        virtio_net.hdr_size = VIRTIO_NET_HDR_SIZE_V1

    # Read MAC address
    if (accepted_features & VIRTIO_NET_F_MAC) != 0
        var i: i32 = 0
        while i < 6
            virtio_net.mac[i] = vio_read_config8(vdev, VIRTIO_NET_CFG_MAC + (i as u16))
            i = i + 1
        klog("[virtio-net] MAC: ")
        i = 0
        while i < 6
            if i > 0
                klog(":")
            let byte: u8 = virtio_net.mac[i]
            klog_hex_width(byte as u64, 2)
            i = i + 1
        klog("\n")

    # The rings and buffer pools, in the NIC's domain when it has one
    if not virtio_net_alloc_queues()
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return -1
    let rx_pool: NicPool = match nic_pool_new()
        Some(pool) => pool
        None => return virtio_net_fail(vdev, "no RX buffers")
    let tx_pool: NicPool = match nic_pool_new()
        Some(pool) => pool
        None => return virtio_net_fail(vdev, "no TX buffers")
    virtio_rx_pool = rx_pool
    virtio_tx_pool = tx_pool

    # Initialize RX queue
    klog("[virtio-net] Initializing RX queue...\n")
    if not virtio_net_start_queue(virtio_net.rx_queue)
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return -1

    # Initialize TX queue
    klog("[virtio-net] Initializing TX queue...\n")
    if not virtio_net_start_queue(virtio_net.tx_queue)
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return -1

    tx_slots_init(@virtio_tx_slots, VIRTIO_NET_TX_BUFFER_COUNT)

    # Populate RX buffers
    klog("[virtio-net] Populating RX buffers...\n")
    var buf_idx: u32 = 0
    while buf_idx < VIRTIO_NET_RX_BUFFER_COUNT
        let buf_dev: u64 = virtio_rx_pool.dev + (buf_idx as u64 * VIRTIO_NET_RX_BUFFER_SIZE as u64)
        let result: i32 = virtq_add_buf(virtio_net.rx_queue, buf_dev, VIRTIO_NET_RX_BUFFER_SIZE, VRING_DESC_F_WRITE)
        if result < 0
            klog("[virtio-net] WARNING: Could only add ")
            klog_dec(buf_idx as i64)
            klog(" RX buffers\n")
            break
        buf_idx = buf_idx + 1
    klog("[virtio-net]   Added ")
    klog_dec(buf_idx as i64)
    klog(" RX buffers\n")

    # Mark driver ready (a modern device may not be notified before DRIVER_OK)
    if vio_device_ready(vdev) != 0
        klog("[virtio-net] ERROR: device needs reset\n")
        return -1

    virtq_kick(virtio_net.rx_queue)

    # Check link status
    let link_status: u16 = vio_read_config16(vdev, VIRTIO_NET_CFG_STATUS)
    klog("[virtio-net] Link status: ")
    if (link_status & 1) != 0
        klog("UP\n")
    else
        klog("DOWN\n")

    virtio_net.initialized = 1
    klog("[virtio-net] Initialization complete!\n")
    if net_ring1_allowed()
        klog("[nic-dma] ring-1 owner allowed: translation on, remapping on, compatibility format blocked (read from the unit), NIC isolated; the owner stays in the kernel\n")
    else
        klog("[nic-dma] ring-1 owner refused: the NIC is not isolated on this boot; the owner stays in the kernel\n")

    return 0

fn virtio_net_fail(vdev: *VirtioDevice, why: StrView) -> i32
    klog("[virtio-net] ERROR: ")
    klog(why)
    klog("\n")
    vio_add_status(vdev, VIRTIO_STATUS_FAILED)
    return -1

# ============================================================================
# The ring-1 owner's probe (AGAST #4735, docs/RING1_DRIVER.md sections 8-9)
# ============================================================================
#
# On a boot that translates DMA the NIC's owner is /bin/netd (D9, #4875:
# the driver is a library in it), never virtio_net_init (D7: the boot
# chooses, not a marker file). The kernel
# keeps PCI, bus mastering, the MSI-X table and the private domain: this
# probe finds the device, isolates it (virtio_net_isolate: its domain, then
# bus master, then the fault probe), records its capability windows and
# points MSI-X table entries 0-2 (config, RX, TX) at one vector on the BSP.
# It allocates no virtqueue for the device to use and never sets
# DRIVER_OK: the driver does, after its own reset. net/ring1.ritz makes the
# IRQ object and spawns the driver from what this returns.

# What net/ring1.ritz hands the driver, besides the frame and link objects.
pub struct NicGrant
    vector: u8                       # the IDT vector of entries 0-2
    sid: u32                         # the NIC's requester
    dom: u32                         # its private DMA domain
    status_va: u64                   # the kernel's VA of device_status
    msix_table_va: u64               # the kernel's VA of MSI-X entry 0
    window_count: u32
    window_ids: [8]u64               # CAP_TYPE_MMIO objects (VIO_WINDOW_NOTES)
    window_types: [8]u8              # their virtio cfg_type

# virtio_pci_common_cfg.device_status (virtio 1.1 section 4.1.4.3)
const VIRTIO_COMMON_DEVICE_STATUS: u64 = 0x14

# A virtio-net was found on a translating boot: its owner is the ring-1
# driver, so netdev_init leaves it alone, whether or not the probe below
# then handed it over (a refused NIC has no owner on that boot).
var virtio_net_ring1: bool = false
# 0 until the probe hands the NIC over: msix_vector_alloc never gives 0.
var virtio_net_ring1_vec: u8 = 0

pub fn virtio_net_ring1_boot() -> bool
    virtio_net_ring1

# The NIC's vector on the ring-1 boot, None when it was not handed over.
pub fn virtio_net_ring1_vector() -> Option<u8>
    if virtio_net_ring1_vec == 0
        return None
    Some(virtio_net_ring1_vec)

fn virtio_net_ring1_refused(why: StrView) -> Option<NicGrant>
    klog("[nic-dma] ring-1 owner refused: ")
    klog(why)
    klog("; the NIC has no owner on this boot\n")
    None

# MSI-X table entries 0-2 on one vector aimed at this CPU, the BSP: the
# vector, or None (no table, no vector, or an entry routed anywhere else).
fn virtio_net_ring1_msix(pci_dev: *PciDevice) -> Option<u8>
    if msix_probe(pci_dev, @virtio_net_msix) != 0 or virtio_net_msix.table_size < VIRTIO_NET_MSIX_ENTRIES
        klog("[msix] virtio-net: no MSI-X table of 3 entries\n")
        return None
    # msix_vector_alloc's own convention: vector 0 means none was free.
    let vector: u8 = msix_vector_alloc()
    if vector == 0 or msix_enable(@virtio_net_msix) != 0
        klog("[msix] virtio-net: no vector or the table did not map\n")
        return None
    let bsp: u32 = lapic_id()
    var e: u16 = 0
    while e < VIRTIO_NET_MSIX_ENTRIES
        if msix_set_entry_to(@virtio_net_msix, e, vector, bsp) != 0 or msix_entry_dest(@virtio_net_msix, e) != bsp
            klog("[msix] virtio-net: entry ")
            klog_dec(e as i64)
            klog(" is not routed to the BSP (APIC ID ")
            klog_dec(bsp as i64)
            klog(")\n")
            return None
        e = e + 1
    klog("[msix] virtio-net: MSI-X on, vector ")
    klog_dec(vector as i64)
    klog(" for config, rx and tx (entries 0-2), routed to the BSP\n")
    Some(vector)

# The probe (above): the NIC's grant, or None when there is no virtio-net,
# DMA is not translated (virtio_net_init owns it), or the NIC is refused.
pub fn virtio_net_ring1_probe() -> Option<NicGrant>
    let pci_dev: *PciDevice = pci_find_virtio(VIRTIO_DEVICE_NET)
    if pci_dev == 0 as *PciDevice or not dma_translation_on()
        return None
    virtio_net_ring1 = true
    klog("\n[virtio-net] Probing device at ")
    klog_dec((*pci_dev).bus as i64)
    klog(":")
    klog_dec((*pci_dev).device as i64)
    klog(".")
    klog_dec((*pci_dev).function as i64)
    klog(" for the ring-1 driver\n")
    virtio_net.pci_dev = pci_dev
    virtio_net.initialized = 0
    virtio_net.rx_queue = 0 as *Virtqueue
    virtio_net.tx_queue = 0 as *Virtqueue
    virtio_net_dom = 0
    let vdev: *VirtioDevice = vio_init_device_isolated(pci_dev)
    if vdev == 0 as *VirtioDevice
        return virtio_net_ring1_refused("no usable virtio transport")
    virtio_net.vdev = vdev
    if (*vdev).transport != VIO_TRANSPORT_MMIO
        return virtio_net_ring1_refused("a legacy-only virtio-net, and /bin/netd drives the modern transport")
    klog("[virtio-net] Transport: modern (MMIO)\n")
    if not virtio_net_isolate(pci_dev, vdev)
        vio_add_status(vdev, VIRTIO_STATUS_FAILED)
        return virtio_net_ring1_refused("the NIC is not isolated")
    if not net_ring1_allowed()
        return virtio_net_ring1_refused("translation, remapping or blocked compatibility format is off")
    let vector: u8 = match virtio_net_ring1_msix(pci_dev)
        Some(v) => v
        None => return virtio_net_ring1_refused("MSI-X is not on at the BSP")
    vio_note_msix_on(vdev)
    virtio_net_ring1_vec = vector
    klog("[nic-dma] ring-1 owner allowed: translation on, remapping on, compatibility format blocked (read from the unit), NIC isolated; the owner is /bin/netd\n")
    var grant: NicGrant = NicGrant { vector: vector, sid: pci_dev_sid(pci_dev), dom: virtio_net_dom, status_va: (*vdev).mmio_common + VIRTIO_COMMON_DEVICE_STATUS, msix_table_va: virtio_net_msix.table_virt, window_count: (*vdev).window_count, window_ids: [0, 0, 0, 0, 0, 0, 0, 0], window_types: [0, 0, 0, 0, 0, 0, 0, 0] }
    for i in 0..8
        grant.window_ids[i] = (*vdev).window_ids[i]
        grant.window_types[i] = (*vdev).window_types[i]
    Some(grant)

# ============================================================================
# Packet Send/Receive
# ============================================================================

# Return every TX descriptor the device has finished with to the free list
# and release its buffer. Without this the ring runs dry after queue-size
# sends (AGAST #4073).
fn virtio_net_reclaim_tx()
    read_barrier()
    vq_reclaim_tx(virtio_net.tx_queue, @virtio_tx_slots)

pub fn virtio_net_send(data: *u8, len: u32) -> i32
    if virtio_net.initialized == 0
        return -1

    if len > 1514
        return -1

    virtio_net_reclaim_tx()
    # The next buffer the device isn't reading; none while all
    # VIRTIO_NET_TX_BUFFER_COUNT are in flight.
    var tx_buf_idx: u32 = 0
    match tx_slots_take(@virtio_tx_slots)
        Some(b) => tx_buf_idx = b
        None => return -1

    let buf_off: u64 = tx_buf_idx as u64 * VIRTIO_NET_TX_BUFFER_SIZE as u64
    let buf_addr: u64 = virtio_tx_pool.virt + buf_off
    let hdr_size: u32 = virtio_net.hdr_size

    # Set up VirtIO-net header
    let hdr: *VirtioNetHdr = buf_addr as *VirtioNetHdr
    (*hdr).flags = 0
    (*hdr).gso_type = VIRTIO_NET_HDR_GSO_NONE
    (*hdr).hdr_len = 0
    (*hdr).gso_size = 0
    (*hdr).csum_start = 0
    (*hdr).csum_offset = 0
    if hdr_size > VIRTIO_NET_HDR_SIZE
        *((buf_addr + VIRTIO_NET_HDR_SIZE as u64) as *u16) = 0   # num_buffers
    # Copy packet data after header
    var i: u32 = 0
    while i < len
        *((buf_addr + hdr_size as u64 + i as u64) as *u8) = *(data + i as i64)
        i = i + 1

    let total_len: u32 = hdr_size + len
    let result: i32 = virtq_add_buf(virtio_net.tx_queue, virtio_tx_pool.dev + buf_off, total_len, 0)
    if result < 0
        return -1
    tx_slots_post(@virtio_tx_slots, tx_buf_idx, result as u16)

    virtq_kick(virtio_net.tx_queue)
    return 0

pub fn virtio_net_poll(buf: *u8, max_len: u32) -> i32
    if virtio_net.initialized == 0
        return -1

    let rxq: *Virtqueue = virtio_net.rx_queue
    let hdr_size: u32 = virtio_net.hdr_size
    let desc_idx: i32 = virtq_get_used(rxq)
    if desc_idx < 0
        return 0

    let desc_ptr: *VringDesc = vq_get_desc(rxq, desc_idx as u16)
    # The descriptor names the device's address of an RX pool buffer (an
    # IOVA, or physical); the CPU reads it through the pool's physmap view
    # (a process's address space has no identity map).
    let rx_addr: u64 = (*desc_ptr).addr
    let rx_virt: u64 = virtio_rx_pool.virt + (rx_addr - virtio_rx_pool.dev)
    # Bytes the device wrote (header + frame), not the buffer size
    let rx_len: u32 = vq_get_used_len(rxq)
    if virtio_net_dom != 0 and not virtio_net_dma_logged
        virtio_net_dma_logged = true
        virtio_net_log_dma(rx_addr, rx_len)

    # The descriptor is reposted below as a fresh one
    vq_free_desc(rxq, desc_idx as u16)

    if rx_len <= hdr_size
        if virtq_add_buf(rxq, rx_addr, VIRTIO_NET_RX_BUFFER_SIZE, VRING_DESC_F_WRITE) >= 0
            virtq_kick(rxq)
        return 0

    let payload_len: u32 = rx_len - hdr_size
    var copy_len: u32 = payload_len
    if copy_len > max_len
        copy_len = max_len

    var i: u32 = 0
    while i < copy_len
        *(buf + i as i64) = *((rx_virt + hdr_size as u64 + i as u64) as *u8)
        i = i + 1

    let result: i32 = virtq_add_buf(rxq, rx_addr, VIRTIO_NET_RX_BUFFER_SIZE, VRING_DESC_F_WRITE)
    if result >= 0
        virtq_kick(rxq)

    return copy_len as i32

# The first frame the NIC wrote through its private domain: the IOVA it
# wrote and the page the domain maps it to (the acceptance's "device DMA
# into a granted page", AGAST #4724).
fn virtio_net_log_dma(iova: u64, len: u32)
    klog("[nic-dma] device DMA: ")
    klog_dec(len as i64)
    klog(" bytes received into granted IOVA 0x")
    klog_hex(iova)
    match dma_domain_phys(virtio_net_dom, iova)
        Some(phys) =>
            klog(" -> physical 0x")
            klog_hex(phys)
            klog(" in domain ")
            klog_dec(virtio_net_dom as i64)
            klog("\n")
        None => klog(", which the domain does not map\n")

# ============================================================================
# Utility Functions
# ============================================================================

pub fn virtio_net_is_ready() -> u8
    return virtio_net.initialized

pub fn virtio_net_get_mac(mac_out: *u8)
    var i: i32 = 0
    while i < 6
        *(mac_out + i as i64) = virtio_net.mac[i]
        i = i + 1

pub fn virtio_net_get_device() -> *VirtioNetDevice
    return @virtio_net

# True if the NIC signals through MSI-X (virtio_net_setup_msix succeeded)
pub fn virtio_net_msix_enabled() -> bool
    return virtio_net_msix_on

# Sleep until a frame arrives (the RX vector fires) or a short watchdog
# runs out: what a receive loop does between net_poll calls. Returns at
# once if a frame is already waiting. Returns false, without waiting, when
# it can't sleep (no MSI-X, or IF=0): the caller then delays as it did
# before. Returns with IF unchanged.
pub fn virtio_net_wait_rx() -> bool
    if virtio_net.initialized == 0 or not virtio_net_msix_on or not interrupts_enabled()
        return false
    let vec: u8 = virtio_net_vectors[1]
    # Snapshot before the check: a frame landing after it ends the sleep
    let seen: u64 = msix_vector_count(vec)
    if vq_has_used(virtio_net.rx_queue)
        return true
    virtio_net_rx_waits = virtio_net_rx_waits + 1
    irq_wait_vector(vec, seen, VIRTIO_NET_RX_WAIT_TICKS, 1, false, @virtio_net_rx_halts)
    return true

# RX waits that slept, and the hlts they slept in
pub fn virtio_net_rx_wait_count() -> u64
    return virtio_net_rx_waits

pub fn virtio_net_rx_halt_count() -> u64
    return virtio_net_rx_halts

# MSI-X interrupts the NIC has delivered so far, over all its vectors
pub fn virtio_net_irq_count() -> u64
    if not virtio_net_msix_on
        return 0
    var total: u64 = 0
    var i: i32 = 0
    while i < VIRTIO_NET_MSIX_ENTRIES as i32
        total = total + msix_vector_count(virtio_net_vectors[i])
        i = i + 1
    return total
