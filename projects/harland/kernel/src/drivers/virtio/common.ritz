# VirtIO Common Layer
#
# The kernel's virtio PCI transport (legacy port I/O and modern MMIO):
# device status, feature words, queue setup and notification, and config
# space. The virtqueue itself and the feature negotiation are the
# transport-independent virtio_abi package (AGAST #4732), which the ring-1
# driver shares; this file allocates the rings and does the register
# access virtio_abi leaves to its caller.
#
# Reference: https://docs.oasis-open.org/virtio/virtio/v1.1/virtio-v1.1.html

import klog { klog, klog_dec }
import io { inb, outb, inw, outw, inl, outl }
import mm.pmm { pmm_alloc_contig, PAGE_SIZE }
import mm.heap { kalloc, kfree }
import mm.vmm { vmm_map_mmio, phys_to_virt }
import drivers.pci { PciDevice, pci_enable_bus_master, pci_disable_bus_master, pci_enable_memory, pci_enable_io, pci_find_capability, pci_find_capability_nth, pci_dev_read_config8, pci_dev_read_config16, pci_dev_read_config32, pci_dev_sid, PCI_CAP_VENDOR }
import ritzlib.option
import drivers.msix { PCI_CAP_MSIX }
import drivers.virtio.window { PhysRange, phys_range, phys_range_none, vio_window_add }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
# The transport-independent virtqueue and feature negotiation (AGAST #4732):
# this file is the transport, the allocation and the register access.
import virtio_abi.virtq { Virtqueue, VIRTQ_MAX_SIZE, virtq_ring_bytes, virtq_init, virtq_desc_phys, virtq_avail_phys, virtq_used_phys }
import virtio_abi.features { VIRTIO_F_VERSION_1, VIRTIO_F_ACCESS_PLATFORM, virtio_driver_features, virtio_features_lo, virtio_features_hi, virtio_features_join }

# ============================================================================
# VirtIO Device Status Bits
# ============================================================================

pub const VIRTIO_STATUS_ACKNOWLEDGE: u8 = 1
pub const VIRTIO_STATUS_DRIVER: u8 = 2
pub const VIRTIO_STATUS_DRIVER_OK: u8 = 4
pub const VIRTIO_STATUS_FEATURES_OK: u8 = 8
pub const VIRTIO_STATUS_DEVICE_NEEDS_RESET: u8 = 64
pub const VIRTIO_STATUS_FAILED: u8 = 128

# ============================================================================
# VirtIO PCI Legacy Register Offsets (BAR0 I/O space)
# ============================================================================

const VIRTIO_PCI_HOST_FEATURES: u16 = 0    # R: Device features
const VIRTIO_PCI_GUEST_FEATURES: u16 = 4   # W: Driver features
const VIRTIO_PCI_QUEUE_PFN: u16 = 8        # W: Queue PFN
const VIRTIO_PCI_QUEUE_SIZE: u16 = 12      # R: Queue size (16-bit)
const VIRTIO_PCI_QUEUE_SEL: u16 = 14       # W: Queue select (16-bit)
const VIRTIO_PCI_QUEUE_NOTIFY: u16 = 16    # W: Queue notify (16-bit)
const VIRTIO_PCI_STATUS: u16 = 18          # R/W: Device status (8-bit)
const VIRTIO_PCI_ISR: u16 = 19             # R: ISR status (8-bit)
const VIRTIO_PCI_CONFIG: u16 = 20          # Device-specific config starts here

# With MSI-X enabled the legacy header grows by two 16-bit vector registers
# and the device-specific config moves to 24 (virtio 1.1 §4.1.4.8).
const VIRTIO_PCI_MSI_CONFIG_VECTOR: u16 = 20   # R/W: config change vector
const VIRTIO_PCI_MSI_QUEUE_VECTOR: u16 = 22    # R/W: selected queue's vector
const VIRTIO_PCI_CONFIG_MSIX: u16 = 24

# MSI-X vector register value for "no vector"; a device also reads it back
# when it can't take the vector it was given.
pub const VIRTIO_MSI_NO_VECTOR: u16 = 0xFFFF

# How many recorded windows a VirtioDevice keeps the ids of: the length of
# window_ids, and driver_abi.boot DRIVER_BOOT_WINDOWS.
pub const VIO_WINDOW_NOTES: u32 = 8

# ============================================================================
# VirtIO PCI Capability Types (Modern MMIO transport)
# ============================================================================

const VIRTIO_PCI_CAP_COMMON_CFG: u8 = 1    # Common configuration
const VIRTIO_PCI_CAP_NOTIFY_CFG: u8 = 2    # Notifications
const VIRTIO_PCI_CAP_ISR_CFG: u8 = 3       # ISR status
const VIRTIO_PCI_CAP_DEVICE_CFG: u8 = 4    # Device-specific configuration
const VIRTIO_PCI_CAP_PCI_CFG: u8 = 5       # PCI configuration access

# VirtIO PCI capability structure offsets
const VIRTIO_PCI_CAP_TYPE: u8 = 3          # Capability type
const VIRTIO_PCI_CAP_BAR: u8 = 4           # BAR number
const VIRTIO_PCI_CAP_OFFSET: u8 = 8        # Offset within BAR (32-bit)
const VIRTIO_PCI_CAP_LENGTH: u8 = 12       # Length of structure (32-bit)
const VIRTIO_PCI_CAP_NOTIFY_MULT: u8 = 16  # Notify multiplier (for NOTIFY_CFG only)

# ============================================================================
# VirtIO Modern Common Config Register Offsets (MMIO)
# ============================================================================

const VIRTIO_MMIO_DEVICE_FEATURES_SEL: u32 = 0x00  # W: Select features word
const VIRTIO_MMIO_DEVICE_FEATURES: u32 = 0x04      # R: Device features
const VIRTIO_MMIO_DRIVER_FEATURES_SEL: u32 = 0x08  # W: Select features word
const VIRTIO_MMIO_DRIVER_FEATURES: u32 = 0x0C      # W: Driver features
const VIRTIO_MMIO_QUEUE_SEL: u32 = 0x16            # W: Queue select (16-bit)
const VIRTIO_MMIO_QUEUE_SIZE: u32 = 0x18           # R/W: Queue size (16-bit)
const VIRTIO_MMIO_QUEUE_MSIX_VEC: u32 = 0x1A       # R/W: MSI-X vector
const VIRTIO_MMIO_QUEUE_ENABLE: u32 = 0x1C         # R/W: Queue enable
const VIRTIO_MMIO_QUEUE_NOTIFY_OFF: u32 = 0x1E     # R: Notify offset
const VIRTIO_MMIO_QUEUE_DESC_LO: u32 = 0x20        # W: Desc table addr (low)
const VIRTIO_MMIO_QUEUE_DESC_HI: u32 = 0x24        # W: Desc table addr (high)
const VIRTIO_MMIO_QUEUE_AVAIL_LO: u32 = 0x28       # W: Avail ring addr (low)
const VIRTIO_MMIO_QUEUE_AVAIL_HI: u32 = 0x2C       # W: Avail ring addr (high)
const VIRTIO_MMIO_QUEUE_USED_LO: u32 = 0x30        # W: Used ring addr (low)
const VIRTIO_MMIO_QUEUE_USED_HI: u32 = 0x34        # W: Used ring addr (high)
const VIRTIO_MMIO_DEVICE_STATUS: u32 = 0x14        # R/W: Device status (8-bit)
const VIRTIO_MMIO_MSIX_CONFIG: u32 = 0x10          # R/W: Config change MSI-X vector

# ============================================================================
# VirtIO Transport Type
# ============================================================================

pub const VIO_TRANSPORT_LEGACY: u8 = 0    # Legacy port I/O transport
pub const VIO_TRANSPORT_MMIO: u8 = 1      # Modern MMIO transport

# ============================================================================
# VirtIO Device Structure
# ============================================================================

pub struct VirtioDevice
    pci_dev: *PciDevice     # PCI device handle
    io_base: u16            # I/O port base address (legacy transport)
    num_queues: u16         # Number of virtqueues
    queues: [16]*Virtqueue  # Up to 16 queues per device
    status: u8              # Current device status
    transport: u8           # VIO_TRANSPORT_LEGACY or VIO_TRANSPORT_MMIO
    msix_on: u8             # 1 once the driver enabled MSI-X (moves legacy config to 24)
    version_1: u8           # 1 if VIRTIO_F_VERSION_1 was negotiated
    access_platform: bool   # VIRTIO_F_ACCESS_PLATFORM was negotiated: DMA goes through the IOMMU
    # Modern MMIO transport addresses (from PCI capabilities)
    mmio_common: u64        # Common config MMIO base
    mmio_notify: u64        # Notification MMIO base
    mmio_isr: u64           # ISR status MMIO base
    mmio_device: u64        # Device-specific MMIO base
    notify_multiplier: u32  # Notify offset multiplier
    # The CAP_TYPE_MMIO window each modern capability was recorded as
    # (vio_note_window), with its cfg_type: what the ring-1 cutover grants
    # the driver (AGAST #4735). window_count of VIO_WINDOW_NOTES.
    window_ids: [8]u64
    window_types: [8]u8
    window_count: u32

# kalloc sizes

# ============================================================================
# Device I/O Helpers (Legacy port I/O)
# ============================================================================

fn vio_read8(dev: *VirtioDevice, offset: u16) -> u8
    return inb((*dev).io_base + offset)

fn vio_write8(dev: *VirtioDevice, offset: u16, value: u8)
    outb((*dev).io_base + offset, value)

fn vio_read16(dev: *VirtioDevice, offset: u16) -> u16
    return inw((*dev).io_base + offset)

fn vio_write16(dev: *VirtioDevice, offset: u16, value: u16)
    outw((*dev).io_base + offset, value)

fn vio_read32(dev: *VirtioDevice, offset: u16) -> u32
    return inl((*dev).io_base + offset)

fn vio_write32(dev: *VirtioDevice, offset: u16, value: u32)
    outl((*dev).io_base + offset, value)

# ============================================================================
# MMIO Helpers (Modern transport)
# ============================================================================

fn mmio_read8(addr: u64) -> u8
    return volatile_load(addr as *u8)

fn mmio_write8(addr: u64, value: u8)
    volatile_store(addr as *u8, value)

fn mmio_read16(addr: u64) -> u16
    return volatile_load(addr as *u16)

fn mmio_write16(addr: u64, value: u16)
    volatile_store(addr as *u16, value)

fn mmio_read32(addr: u64) -> u32
    return volatile_load(addr as *u32)

fn mmio_write32(addr: u64, value: u32)
    volatile_store(addr as *u32, value)

# ============================================================================
# Device Status Management
# ============================================================================

pub fn vio_set_status(dev: *VirtioDevice, status: u8)
    (*dev).status = status
    if (*dev).transport == VIO_TRANSPORT_MMIO
        mmio_write8((*dev).mmio_common + VIRTIO_MMIO_DEVICE_STATUS as u64, status)
    else
        vio_write8(dev, VIRTIO_PCI_STATUS, status)

pub fn vio_get_status(dev: *VirtioDevice) -> u8
    if (*dev).transport == VIO_TRANSPORT_MMIO
        return mmio_read8((*dev).mmio_common + VIRTIO_MMIO_DEVICE_STATUS as u64)
    else
        return vio_read8(dev, VIRTIO_PCI_STATUS)

pub fn vio_reset(dev: *VirtioDevice)
    vio_set_status(dev, 0)
    (*dev).status = 0

# How long a reset may take to read back 0 (Virtio 1.2 §2.1.2: the driver
# treats the device as reset only once device_status reads 0). 100 ms.
# The virtio code's own bound, not vtd.ritz's private VTD_TIMEOUT_US.
pub const VIRTIO_RESET_TIMEOUT_US: u64 = 100000

# A boot-test hook (drv-quiesce, postinit.ritz): the status byte at this
# kernel VA belongs to a device double that never finishes its reset (each
# read sees DEVICE_NEEDS_RESET again). 0: none.
var vio_reset_stuck_va: u64 = 0

pub fn vio_reset_force_stuck(status_va: u64)
    vio_reset_stuck_va = status_va

# Reset the device whose device_status byte the kernel maps at `status_va`
# (driver_quiesce, #4733): write 0, then read until it is 0 or
# VIRTIO_RESET_TIMEOUT_US has passed. The last value read: 0 means the
# reset completed and the device is idle.
pub fn vio_status_reset(status_va: u64) -> u8
    let reg: *u8 = status_va as *u8
    volatile_store(reg, 0)
    let deadline: u64 = deadline_after_us(VIRTIO_RESET_TIMEOUT_US)
    var status: u8 = vio_status_read(reg)
    while status != 0 and not deadline_passed(deadline)
        status = vio_status_read(reg)
    status

# One read of the status byte at `reg`; the stuck double (above) shows
# DEVICE_NEEDS_RESET to every read.
fn vio_status_read(reg: *u8) -> u8
    if reg as u64 == vio_reset_stuck_va
        volatile_store(reg, VIRTIO_STATUS_DEVICE_NEEDS_RESET)
    volatile_load(reg)

pub fn vio_add_status(dev: *VirtioDevice, status: u8)
    (*dev).status = (*dev).status | status
    vio_set_status(dev, (*dev).status)

# ============================================================================
# Feature Negotiation
# ============================================================================

pub fn vio_get_features(dev: *VirtioDevice) -> u32
    if (*dev).transport == VIO_TRANSPORT_MMIO
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_DEVICE_FEATURES_SEL as u64, 0)
        return mmio_read32((*dev).mmio_common + VIRTIO_MMIO_DEVICE_FEATURES as u64)
    else
        return vio_read32(dev, VIRTIO_PCI_HOST_FEATURES)

# Accept the `wanted` features the device offers, as virtio_abi decides
# (virtio_driver_features): that includes VIRTIO_F_VERSION_1 (bit 32)
# whenever a modern device offers it, since a modern device must be driven
# as virtio 1.x and may refuse FEATURES_OK (or behave as legacy) without it
# (§6.1). The legacy transport has feature word 0 only.
pub fn vio_set_features(dev: *VirtioDevice, wanted: u64)
    if (*dev).transport == VIO_TRANSPORT_MMIO
        let common: u64 = (*dev).mmio_common
        mmio_write32(common + VIRTIO_MMIO_DEVICE_FEATURES_SEL as u64, 0)
        let dev_lo: u32 = mmio_read32(common + VIRTIO_MMIO_DEVICE_FEATURES as u64)
        mmio_write32(common + VIRTIO_MMIO_DEVICE_FEATURES_SEL as u64, 1)
        let dev_hi: u32 = mmio_read32(common + VIRTIO_MMIO_DEVICE_FEATURES as u64)
        let accepted: u64 = virtio_driver_features(virtio_features_join(dev_lo, dev_hi), wanted)
        mmio_write32(common + VIRTIO_MMIO_DRIVER_FEATURES_SEL as u64, 0)
        mmio_write32(common + VIRTIO_MMIO_DRIVER_FEATURES as u64, virtio_features_lo(accepted))
        mmio_write32(common + VIRTIO_MMIO_DRIVER_FEATURES_SEL as u64, 1)
        mmio_write32(common + VIRTIO_MMIO_DRIVER_FEATURES as u64, virtio_features_hi(accepted))
        if (accepted & VIRTIO_F_VERSION_1) != 0
            (*dev).version_1 = 1
        else
            (*dev).version_1 = 0
        (*dev).access_platform = (accepted & VIRTIO_F_ACCESS_PLATFORM) != 0
    else
        let offered: u64 = vio_read32(dev, VIRTIO_PCI_HOST_FEATURES) as u64
        vio_write32(dev, VIRTIO_PCI_GUEST_FEATURES, virtio_features_lo(virtio_driver_features(offered, wanted)))

# Complete feature negotiation (call after vio_set_features for modern transport)
# Returns 0 on success, -1 on failure
pub fn vio_features_ok(dev: *VirtioDevice) -> i32
    if (*dev).transport == VIO_TRANSPORT_MMIO
        # Modern transport requires FEATURES_OK
        vio_add_status(dev, VIRTIO_STATUS_FEATURES_OK)

        # Verify device accepted features
        let status: u8 = vio_get_status(dev)
        if (status & VIRTIO_STATUS_FEATURES_OK) == 0
            klog("[virtio] Device did not accept features!\n")
            return -1
        klog("[virtio] Features OK\n")
    # Legacy transport doesn't need this step
    return 0

# ============================================================================
# Queue Setup
# ============================================================================

pub fn vio_get_queue_size(dev: *VirtioDevice, queue_idx: u16) -> u16
    if (*dev).transport == VIO_TRANSPORT_MMIO
        mmio_write16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_SEL as u64, queue_idx)
        return mmio_read16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_SIZE as u64)
    else
        vio_write16(dev, VIRTIO_PCI_QUEUE_SEL, queue_idx)
        return vio_read16(dev, VIRTIO_PCI_QUEUE_SIZE)

pub fn vio_setup_queue(dev: *VirtioDevice, queue_idx: u16) -> *Virtqueue
    return vio_setup_queue_vec(dev, queue_idx, VIRTIO_MSI_NO_VECTOR)

# Set up queue `queue_idx`, signalling MSI-X table entry `msix_vector`
# (VIRTIO_MSI_NO_VECTOR for none; MSI-X must already be enabled otherwise):
# vio_queue_alloc, then vio_queue_program with the ring's physical address.
# Returns 0 if the queue doesn't exist, is legacy and larger than
# VIRTQ_MAX_SIZE, or refuses the vector.
pub fn vio_setup_queue_vec(dev: *VirtioDevice, queue_idx: u16, msix_vector: u16) -> *Virtqueue
    let vq: *Virtqueue = vio_queue_alloc(dev, queue_idx)
    if vq == 0 as *Virtqueue
        return vq
    if not vio_queue_program(dev, vq, msix_vector)
        kfree(vq as *u8)
        return 0 as *Virtqueue
    return vq

# The pages queue `vq`'s rings take.
pub fn vio_queue_pages(vq: *Virtqueue) -> u64
    return (virtq_ring_bytes((*vq).num) + PAGE_SIZE - 1) / PAGE_SIZE

# Allocate queue `queue_idx`'s rings, min(device max, VIRTQ_MAX_SIZE)
# entries, zeroed, with the device address (vq.phys_addr) their physical
# one. Nothing is told to the device: a caller whose device DMAs through a
# domain sets phys_addr to the rings' IOVA before vio_queue_program
# (AGAST #4724). 0 if the queue doesn't exist, is legacy and larger than
# VIRTQ_MAX_SIZE, or there's no memory.
pub fn vio_queue_alloc(dev: *VirtioDevice, queue_idx: u16) -> *Virtqueue
    var num: u16 = vio_get_queue_size(dev, queue_idx)
    if num == 0
        return 0 as *Virtqueue
    if num > VIRTQ_MAX_SIZE
        if (*dev).transport != VIO_TRANSPORT_MMIO
            klog("[virtio] legacy queue ")
            klog_dec(queue_idx as i64)
            klog(" has ")
            klog_dec(num as i64)
            klog(" entries, more than the 256 supported\n")
            return 0 as *Virtqueue
        # Modern queue_size is R/W: take only what the rings hold (§4.1.4.3);
        # vio_queue_program writes it
        num = VIRTQ_MAX_SIZE

    # Allocate virtqueue structure
    let vq: *Virtqueue = kalloc(sizeof(Virtqueue) as u64) as *Virtqueue
    if vq == 0 as *Virtqueue
        klog("[virtio] Failed to allocate virtqueue\n")
        return 0 as *Virtqueue

    # Calculate memory needed and allocate
    let pages_needed: u64 = (virtq_ring_bytes(num) + PAGE_SIZE - 1) / PAGE_SIZE

    # One physically contiguous run (3 pages for a VIRTQ_MAX_SIZE queue): the
    # device reads every ring at ring_phys plus its offset. Not one
    # pmm_alloc_page per page: a per-CPU frame cache is a stack, so once it
    # holds freed frames consecutive pages are not adjacent, and the rings
    # ran over whoever had the next ones (VT-d's own table, AGAST #4880).
    let ring_phys: u64 = pmm_alloc_contig(pages_needed)
    if ring_phys == 0
        klog("[virtio] Failed to allocate ring memory\n")
        kfree(vq as *u8)
        return 0 as *Virtqueue

    # The device is told the physical address; the CPU reaches the ring
    # through the physmap (a process's address space has no identity map,
    # AGAST #1878).
    let ring_virt: u64 = phys_to_virt(ring_phys)
    virtq_init(vq, queue_idx, num, ring_virt, ring_phys)
    vio_queue_reset(vq)
    (*vq).transport = (*dev).transport
    return vq

# Zero queue `vq`'s rings and start its indices and free list over, at the
# same device address: a queue being programmed again after a device reset.
pub fn vio_queue_reset(vq: *Virtqueue)
    let ring_virt: u64 = (*vq).desc as u64
    var i: u64 = 0
    let total_size: u64 = vio_queue_pages(vq) * PAGE_SIZE
    while i < total_size
        *((ring_virt + i) as *u8) = 0
        i = i + 1
    # Rings, free list and cursors (virtio_abi); the notify target is ours
    virtq_init(vq, (*vq).queue_index, (*vq).num, ring_virt, (*vq).phys_addr)

# Tell the device where queue `vq` is (its device address, vq.phys_addr),
# with MSI-X table entry `msix_vector` (VIRTIO_MSI_NO_VECTOR for none), and
# enable it. False if the queue refused the vector.
pub fn vio_queue_program(dev: *VirtioDevice, vq: *Virtqueue, msix_vector: u16) -> bool
    let queue_idx: u16 = (*vq).queue_index
    # Select the queue
    if (*dev).transport == VIO_TRANSPORT_MMIO
        mmio_write16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_SEL as u64, queue_idx)
        mmio_write16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_SIZE as u64, (*vq).num)
    else
        vio_write16(dev, VIRTIO_PCI_QUEUE_SEL, queue_idx)

    # The queue's MSI-X vector, while the queue is selected and before it is
    # enabled. The device reads back NO_VECTOR if it couldn't take it.
    if msix_vector != VIRTIO_MSI_NO_VECTOR
        var got: u16 = 0
        if (*dev).transport == VIO_TRANSPORT_MMIO
            mmio_write16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_MSIX_VEC as u64, msix_vector)
            got = mmio_read16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_MSIX_VEC as u64)
        else
            vio_write16(dev, VIRTIO_PCI_MSI_QUEUE_VECTOR, msix_vector)
            got = vio_read16(dev, VIRTIO_PCI_MSI_QUEUE_VECTOR)
        if got == VIRTIO_MSI_NO_VECTOR
            klog("[virtio] queue ")
            klog_dec(queue_idx as i64)
            klog(" refused its MSI-X vector\n")
            return false

    # Tell device where the queue is
    if (*dev).transport == VIO_TRANSPORT_MMIO
        # The queue's notify word: mmio_notify + notify_off * notify_multiplier
        let notify_off: u16 = mmio_read16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_NOTIFY_OFF as u64)
        (*vq).notify_addr = (*dev).mmio_notify + ((notify_off as u32) * (*dev).notify_multiplier) as u64

        # Modern: set descriptor, avail, used addresses separately
        let desc_phys: u64 = virtq_desc_phys(vq)
        let avail_phys: u64 = virtq_avail_phys(vq)
        let used_phys: u64 = virtq_used_phys(vq)

        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_DESC_LO as u64, (desc_phys & 0xFFFFFFFF) as u32)
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_DESC_HI as u64, (desc_phys >> 32) as u32)
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_AVAIL_LO as u64, (avail_phys & 0xFFFFFFFF) as u32)
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_AVAIL_HI as u64, (avail_phys >> 32) as u32)
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_USED_LO as u64, (used_phys & 0xFFFFFFFF) as u32)
        mmio_write32((*dev).mmio_common + VIRTIO_MMIO_QUEUE_USED_HI as u64, (used_phys >> 32) as u32)

        # Enable the queue
        mmio_write16((*dev).mmio_common + VIRTIO_MMIO_QUEUE_ENABLE as u64, 1)
    else
        # The queue's notify port
        (*vq).notify_addr = ((*dev).io_base + VIRTIO_PCI_QUEUE_NOTIFY) as u64
        # Legacy: set PFN (page frame number)
        let pfn: u32 = (virtq_desc_phys(vq) / PAGE_SIZE) as u32
        vio_write32(dev, VIRTIO_PCI_QUEUE_PFN, pfn)

    return true

# ============================================================================
# Queue Notification
# ============================================================================

# Notify device that there are buffers available on `vq` (after vq_submit):
# write the queue index to the notify target vio_setup_queue_vec set.
pub fn vq_notify(vq: *Virtqueue)
    if (*vq).transport == VIO_TRANSPORT_MMIO
        mmio_write16((*vq).notify_addr, (*vq).queue_index)
    else
        outw((*vq).notify_addr as u16, (*vq).queue_index)

# ============================================================================
# Device Initialization
# ============================================================================

# Pick the transport, enable the function (bus mastering included), reset
# the device and set ACKNOWLEDGE | DRIVER.
pub fn vio_init_device(pci_dev: *PciDevice) -> *VirtioDevice
    return vio_init(pci_dev, true)

# The same, with the function's bus mastering turned off and left off
# (AGAST #4724): on a translating boot the NIC may not DMA until its
# private domain is live, and its probe sets bus master only then.
pub fn vio_init_device_isolated(pci_dev: *PciDevice) -> *VirtioDevice
    return vio_init(pci_dev, false)

fn vio_init(pci_dev: *PciDevice, bus_master: bool) -> *VirtioDevice
    if not bus_master
        pci_disable_bus_master(pci_dev)
    # Allocate device structure
    let dev: *VirtioDevice = kalloc(sizeof(VirtioDevice) as u64) as *VirtioDevice
    if dev == 0 as *VirtioDevice
        klog("[virtio] Failed to allocate device\n")
        return 0 as *VirtioDevice

    (*dev).pci_dev = pci_dev
    (*dev).status = 0
    (*dev).num_queues = 0
    (*dev).mmio_common = 0
    (*dev).mmio_notify = 0
    (*dev).mmio_isr = 0
    (*dev).mmio_device = 0
    (*dev).notify_multiplier = 0
    (*dev).msix_on = 0
    (*dev).version_1 = 0
    (*dev).access_platform = false
    (*dev).window_count = 0

    # Try legacy I/O transport first (BAR0 as I/O space)
    if (*pci_dev).bar_is_io[0] != 0
        (*dev).transport = VIO_TRANSPORT_LEGACY
        (*dev).io_base = (*pci_dev).bar[0] as u16

        # Enable PCI bus mastering and I/O space
        if bus_master
            pci_enable_bus_master(pci_dev)
        pci_enable_io(pci_dev)

        # Reset the device
        vio_reset(dev)

        # Acknowledge we found the device
        vio_add_status(dev, VIRTIO_STATUS_ACKNOWLEDGE)

        # Acknowledge we know how to drive it
        vio_add_status(dev, VIRTIO_STATUS_DRIVER)

        return dev

    # Enable PCI bus mastering and memory space BEFORE accessing MMIO
    if bus_master
        pci_enable_bus_master(pci_dev)
    pci_enable_memory(pci_dev)

    # Try modern MMIO transport via PCI capabilities
    let common_result: i32 = vio_find_mmio_caps(dev, pci_dev)
    if common_result != 0
        klog("[virtio] BAR0 is not I/O space and no MMIO caps found\n")
        kfree(dev as *u8)
        return 0 as *VirtioDevice

    (*dev).transport = VIO_TRANSPORT_MMIO

    # Reset the device
    vio_reset(dev)

    # Acknowledge we found the device
    vio_add_status(dev, VIRTIO_STATUS_ACKNOWLEDGE)

    # Acknowledge we know how to drive it
    vio_add_status(dev, VIRTIO_STATUS_DRIVER)

    return dev

# The MSI-X capability's table and PBA registers (PCI 3.0 §6.8.2): each a
# BIR in bits 0-2 and an offset in the rest; the table size is in bits 0-10
# of Message Control.
const MSIX_CAP_CONTROL: u8 = 2
const MSIX_CAP_TABLE: u8 = 4
const MSIX_CAP_PBA: u8 = 8
const MSIX_ENTRY_BYTES: u64 = 16

# The physical bytes the MSI-X register at `reg` (table or PBA) names, `len`
# long, or no range when its BIR is not a memory BAR.
fn msix_register_range(pci_dev: *PciDevice, reg: u8, len: u64) -> PhysRange
    let loc: u32 = pci_dev_read_config32(pci_dev, reg)
    let bir: i32 = (loc & 0x7) as i32
    if bir > 5 or (*pci_dev).bar_is_io[bir] != 0 or (*pci_dev).bar[bir] == 0
        return phys_range_none()
    phys_range((*pci_dev).bar[bir] + ((loc & 0xFFFFFFF8) as u64), len)

# The physical bytes of the device's common configuration (its queue-
# address registers), or no range.
fn vio_common_range(pci_dev: *PciDevice) -> PhysRange
    var idx: i32 = 0
    while idx < 16
        let cap_ptr: u8 = pci_find_capability_nth(pci_dev, PCI_CAP_VENDOR, idx)
        if cap_ptr == 0
            break
        idx = idx + 1
        if pci_dev_read_config8(pci_dev, cap_ptr + VIRTIO_PCI_CAP_TYPE) == VIRTIO_PCI_CAP_COMMON_CFG
            let bar: u8 = pci_dev_read_config8(pci_dev, cap_ptr + VIRTIO_PCI_CAP_BAR)
            if bar <= 5 and (*pci_dev).bar_is_io[bar as i32] == 0 and (*pci_dev).bar[bar as i32] != 0
                let offset: u32 = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_OFFSET)
                let length: u32 = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_LENGTH)
                return phys_range((*pci_dev).bar[bar as i32] + (offset as u64), length as u64)
    phys_range_none()

# Record the capability window at physical `phys`, `length` bytes, as a
# CAP_TYPE_MMIO object (drivers/virtio/window.ritz, AGAST #4720), with the
# device's MSI-X table and PBA so DrvMmioMap can refuse a page holding
# either, and its common configuration and requester so DrvMmioMap grants
# a page holding its queue-address registers only to a device in a
# private DMA domain (AGAST #4724). The kernel's own mapping above is
# unaffected; a full record table only means that window can't be granted.
fn vio_note_window(dev: *VirtioDevice, pci_dev: *PciDevice, cap_ptr: u8, cap_type: u8, phys: u64, length: u64)
    var notify: u32 = 0
    if cap_type == VIRTIO_PCI_CAP_NOTIFY_CFG
        notify = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_NOTIFY_MULT)
    var table: PhysRange = phys_range_none()
    var pba: PhysRange = phys_range_none()
    let msix: u8 = pci_find_capability(pci_dev, PCI_CAP_MSIX)
    if msix != 0
        let entries: u64 = ((pci_dev_read_config16(pci_dev, msix + MSIX_CAP_CONTROL) & 0x7FF) as u64) + 1
        table = msix_register_range(pci_dev, msix + MSIX_CAP_TABLE, entries * MSIX_ENTRY_BYTES)
        pba = msix_register_range(pci_dev, msix + MSIX_CAP_PBA, (entries + 63) / 64 * 8)
    match vio_window_add(phys, length, notify, table, pba, vio_common_range(pci_dev), pci_dev_sid(pci_dev))
        Some(id) =>
            let n: u32 = (*dev).window_count
            if n < VIO_WINDOW_NOTES
                (*dev).window_ids[n] = id
                (*dev).window_types[n] = cap_type
                (*dev).window_count = n + 1
        None => klog("[virtio] window table full: this window can't be granted\n")

# Find the virtio modern PCI capabilities (virtio 1.x §4.1.4) and map the
# BAR regions they describe through the kernel MMIO window (vmm_map_mmio).
# COMMON_CFG and NOTIFY_CFG are required; ISR_CFG and DEVICE_CFG are mapped
# when present. Returns 0 on success, -1 if a required region is missing or
# can't be mapped.
fn vio_find_mmio_caps(dev: *VirtioDevice, pci_dev: *PciDevice) -> i32
    var cap_idx: i32 = 0
    var found_common: bool = false
    var found_notify: bool = false

    while cap_idx < 16
        let cap_ptr: u8 = pci_find_capability_nth(pci_dev, PCI_CAP_VENDOR, cap_idx)
        if cap_ptr == 0
            break
        cap_idx = cap_idx + 1

        let cap_type: u8 = pci_dev_read_config8(pci_dev, cap_ptr + VIRTIO_PCI_CAP_TYPE)
        if cap_type < VIRTIO_PCI_CAP_COMMON_CFG or cap_type > VIRTIO_PCI_CAP_DEVICE_CFG
            continue    # PCI_CFG (config-space window) or a vendor's own cap
        let bar: u8 = pci_dev_read_config8(pci_dev, cap_ptr + VIRTIO_PCI_CAP_BAR)
        let offset: u32 = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_OFFSET)
        let length: u32 = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_LENGTH)
        if bar > 5 or (*pci_dev).bar_is_io[bar as i32] != 0 or (*pci_dev).bar[bar as i32] == 0 or length == 0
            klog("[virtio] skipping cap type ")
            klog_dec(cap_type as i32)
            klog(": BAR ")
            klog_dec(bar as i32)
            klog(" is not a mapped memory BAR\n")
            continue

        # Each cap gets its own pages in the window; caps sharing a BAR page
        # just map it twice.
        let mapped: u64 = vmm_map_mmio((*pci_dev).bar[bar as i32] + (offset as u64), length as u64)
        if mapped == 0
            return -1
        vio_note_window(dev, pci_dev, cap_ptr, cap_type, (*pci_dev).bar[bar as i32] + (offset as u64), length as u64)

        if cap_type == VIRTIO_PCI_CAP_COMMON_CFG and not found_common
            (*dev).mmio_common = mapped
            found_common = true
        else if cap_type == VIRTIO_PCI_CAP_NOTIFY_CFG and not found_notify
            (*dev).mmio_notify = mapped
            (*dev).notify_multiplier = pci_dev_read_config32(pci_dev, cap_ptr + VIRTIO_PCI_CAP_NOTIFY_MULT)
            found_notify = true
        else if cap_type == VIRTIO_PCI_CAP_ISR_CFG and (*dev).mmio_isr == 0
            (*dev).mmio_isr = mapped
        else if cap_type == VIRTIO_PCI_CAP_DEVICE_CFG and (*dev).mmio_device == 0
            (*dev).mmio_device = mapped

    if found_common and found_notify
        return 0
    return -1

# Finalize device initialization (call after feature negotiation and queue setup)
pub fn vio_device_ready(dev: *VirtioDevice) -> i32
    vio_add_status(dev, VIRTIO_STATUS_DRIVER_OK)

    if (vio_get_status(dev) & VIRTIO_STATUS_DEVICE_NEEDS_RESET) != 0
        return -1

    return 0

# Read (and so acknowledge) the ISR status: bit 0 queue interrupt, bit 1
# config change. 0 on a modern device without an ISR region.
pub fn vio_read_isr(dev: *VirtioDevice) -> u8
    if (*dev).transport == VIO_TRANSPORT_MMIO
        if (*dev).mmio_isr == 0
            return 0
        return mmio_read8((*dev).mmio_isr)
    return vio_read8(dev, VIRTIO_PCI_ISR)

# Note that the driver enabled MSI-X on the PCI function: on the legacy
# transport this moves the device-specific config from offset 20 to 24.
pub fn vio_note_msix_on(dev: *VirtioDevice)
    (*dev).msix_on = 1

# Route config-change interrupts to MSI-X table entry `vector`. Returns 0, or
# -1 if the device read back VIRTIO_MSI_NO_VECTOR (it couldn't take it).
pub fn vio_set_config_msix_vector(dev: *VirtioDevice, vector: u16) -> i32
    var got: u16 = 0
    if (*dev).transport == VIO_TRANSPORT_MMIO
        mmio_write16((*dev).mmio_common + VIRTIO_MMIO_MSIX_CONFIG as u64, vector)
        got = mmio_read16((*dev).mmio_common + VIRTIO_MMIO_MSIX_CONFIG as u64)
    else
        vio_write16(dev, VIRTIO_PCI_MSI_CONFIG_VECTOR, vector)
        got = vio_read16(dev, VIRTIO_PCI_MSI_CONFIG_VECTOR)
    if got == VIRTIO_MSI_NO_VECTOR
        return -1
    return 0

# ============================================================================
# Config Space Access (device-specific configuration)
# ============================================================================

# I/O port of legacy device-config byte `offset` (it follows the MSI-X
# vector registers once MSI-X is on)
fn vio_legacy_config_port(dev: *VirtioDevice, offset: u16) -> u16
    if (*dev).msix_on != 0
        return (*dev).io_base + VIRTIO_PCI_CONFIG_MSIX + offset
    return (*dev).io_base + VIRTIO_PCI_CONFIG + offset

pub fn vio_read_config8(dev: *VirtioDevice, offset: u16) -> u8
    if (*dev).transport == VIO_TRANSPORT_MMIO
        return mmio_read8((*dev).mmio_device + (offset as u64))
    else
        return inb(vio_legacy_config_port(dev, offset))

pub fn vio_read_config16(dev: *VirtioDevice, offset: u16) -> u16
    if (*dev).transport == VIO_TRANSPORT_MMIO
        return mmio_read16((*dev).mmio_device + (offset as u64))
    else
        return inw(vio_legacy_config_port(dev, offset))

pub fn vio_read_config32(dev: *VirtioDevice, offset: u16) -> u32
    if (*dev).transport == VIO_TRANSPORT_MMIO
        return mmio_read32((*dev).mmio_device + (offset as u64))
    else
        return inl(vio_legacy_config_port(dev, offset))

pub fn vio_read_config64(dev: *VirtioDevice, offset: u16) -> u64
    var low: u32 = 0
    var high: u32 = 0
    if (*dev).transport == VIO_TRANSPORT_MMIO
        low = mmio_read32((*dev).mmio_device + (offset as u64))
        high = mmio_read32((*dev).mmio_device + (offset as u64) + 4)
    else
        low = inl(vio_legacy_config_port(dev, offset))
        high = inl(vio_legacy_config_port(dev, offset + 4))
    return ((high as u64) << 32) | (low as u64)
