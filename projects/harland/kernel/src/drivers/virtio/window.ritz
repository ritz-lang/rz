# Harland virtio MMIO windows (AGAST #4720, docs/RING1_DRIVER.md §5 "MMIO
# and DMA syscalls")
#
# One record per virtio capability window vio_find_mmio_caps found: the
# physical page base, the byte offset of the capability inside that first
# page, its length in bytes and the notify multiplier, plus the device's
# MSI-X table and PBA byte ranges. The record is the CAP_TYPE_MMIO object:
# its id is the object id the kernel grants a device process, and
# DrvMmioMap (221) maps the complete pages that cover the window from this
# record alone. It never reads the bytes the shared page repeats at 0x0300
# (advisory: the driver can overwrite them).
#
# A window whose pages hold any byte of the MSI-X table or PBA is not a
# grant (vio_window_guarded): the kernel programs those registers through
# its own U/S = 0 mapping.
#
# A window whose pages hold any byte of the device's common configuration
# (its queue-address registers) is a grant only once the device's requester
# is in a private DMA domain (vio_window_queue_regs; DrvMmioMap asks the
# IOMMU about `sid`, AGAST #4724): whoever writes those registers chooses
# where the device DMAs.
#
# Imports nothing, so ritz0/tests/test_harland_drv_windows.py compiles it
# into a host program. Records are written at boot (device probe, or the
# boot-test doubles) and only read from syscalls, so there is no lock.

import ritzlib.option

const WINDOW_PAGE: u64 = 4096
const MAX_WINDOWS: i32 = 16

# A physical byte range; len 0 is no range.
pub struct PhysRange
    base: u64
    len: u64

pub struct VioWindow
    id: u64                     # the CAP_TYPE_MMIO object id; never reused
    page_base: u64              # physical, page aligned
    offset: u64                 # the capability's first byte within page_base
    length: u64                 # the capability's bytes
    table: PhysRange            # the device's MSI-X table
    pba: PhysRange              # and its pending-bit array
    queue_regs: PhysRange       # the device's common configuration (queue addresses)
    notify_multiplier: u32
    sid: u32                    # the device's requester: segment << 16 | bus:dev.fn
    in_use: bool
    _padding: [7]u8

var vio_windows: [16]VioWindow
# 0 names no window: a handle with object id 0 is never a grant.
var vio_window_next_id: u64 = 1

pub fn phys_range(base: u64, len: u64) -> PhysRange
    PhysRange { base: base, len: len }

pub fn phys_range_none() -> PhysRange
    PhysRange { base: 0, len: 0 }

# Record the window of `length` bytes at physical `phys`, with the device's
# MSI-X table and PBA ranges, its common configuration and its requester
# `sid`. Its object id, or None for length 0 or a full table.
pub fn vio_window_add(phys: u64, length: u64, notify_multiplier: u32, table: PhysRange, pba: PhysRange, queue_regs: PhysRange, sid: u32) -> Option<u64>
    if length == 0
        return None
    var slot: i32 = 0
    while slot < MAX_WINDOWS and vio_windows[slot].in_use
        slot = slot + 1
    if slot == MAX_WINDOWS
        return None
    let id: u64 = vio_window_next_id
    vio_window_next_id = vio_window_next_id + 1
    vio_windows[slot].id = id
    vio_windows[slot].page_base = phys - phys % WINDOW_PAGE
    vio_windows[slot].offset = phys % WINDOW_PAGE
    vio_windows[slot].length = length
    vio_windows[slot].table = table
    vio_windows[slot].pba = pba
    vio_windows[slot].queue_regs = queue_regs
    vio_windows[slot].notify_multiplier = notify_multiplier
    vio_windows[slot].sid = sid
    vio_windows[slot].in_use = true
    Some(id)

# Forget window `id` (the boot-test doubles only: a probed window lives
# until reboot). False for an unknown id.
pub fn vio_window_remove(id: u64) -> bool
    var slot: i32 = 0
    while slot < MAX_WINDOWS
        if vio_windows[slot].in_use and vio_windows[slot].id == id
            vio_windows[slot].in_use = false
            vio_windows[slot].id = 0
            return true
        slot = slot + 1
    false

# The record of window `id`, copied, or None.
pub fn vio_window_find(id: u64) -> Option<VioWindow>
    if id == 0
        return None
    var slot: i32 = 0
    while slot < MAX_WINDOWS
        if vio_windows[slot].in_use and vio_windows[slot].id == id
            return Some(vio_windows[slot])
        slot = slot + 1
    None

# The pages that cover the window's bytes: a grant is every one of them.
pub fn vio_window_pages(w: VioWindow) -> u64
    (w.offset + w.length + WINDOW_PAGE - 1) / WINDOW_PAGE

fn range_touches(r: PhysRange, lo: u64, hi: u64) -> bool
    r.len != 0 and r.base < hi and r.base + r.len > lo

# Any page of the window holds a byte of the MSI-X table or PBA.
pub fn vio_window_guarded(w: VioWindow) -> bool
    let lo: u64 = w.page_base
    let hi: u64 = lo + vio_window_pages(w) * WINDOW_PAGE
    range_touches(w.table, lo, hi) or range_touches(w.pba, lo, hi)

# Any page of the window holds a byte of the device's queue-address
# registers: a grant only once the device is isolated (above).
pub fn vio_window_queue_regs(w: VioWindow) -> bool
    let lo: u64 = w.page_base
    range_touches(w.queue_regs, lo, lo + vio_window_pages(w) * WINDOW_PAGE)
