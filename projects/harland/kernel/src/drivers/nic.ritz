# drivers/nic.ritz - the ring NIC's probe and grant, whatever its kind
# (AGAST #4735, #4875, #4893; docs/RING1_DRIVER.md sections 8-9,
# docs/E1000E.md "Kernel side")
#
# On a boot that translates DMA the NIC's owner is /bin/netd, with the
# driver a library in it (D9). The kernel hands it one NIC a boot: a
# virtio-net (drivers/virtio/net.ritz virtio_net_ring1_probe), else an
# e1000e (drivers/e1000e.ritz e1000e_ring1_probe). Each probe isolates the
# device, aims MSI-X table entries 0-2 at one vector on the BSP and records
# its register windows as CAP_TYPE_MMIO objects; what it hands net/ring1.ritz
# is a NicGrant. This file is the part the kinds share: the grant, how the
# kernel stops the device without netd (NicReset, syscall/runtime/driver.ritz
# quiesce_device), the private DMA domain before bus master, the MSI-X
# routing, and the ring-1 rule (nic_ring1_allowed).

import klog { klog, klog_dec, klog_hex, klog_hex_width }
import io { cpu_pause }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import serial { StrView }
import ritzlib.option
import ritzlib.span
import drivers.pci { PciDevice, DmaRequesters, pci_enable_bus_master, pci_dev_sid, pci_dma_requesters }
import drivers.msix { MsixInfo, msix_probe, msix_enable, msix_vector_alloc, msix_set_entry_to, msix_entry_dest }
import drivers.iommu.ir { dma_private_domain, dma_requester_isolated, dma_isolation_live, dma_fault_next }

extern fn lapic_id() -> u32

# The MSI-X table entries every ring NIC is given, all on the grant's one
# vector: virtio's config, RX and TX queues; the 82574L's Other, RXQ0 and
# TXQ0 (its IVAR routes each cause to one of them).
pub const NIC_MSIX_ENTRIES: u16 = 3

# The fault probe's frame (AGAST #4724): the bytes a probe asks the NIC to
# send from an IOVA nothing maps, and how long it waits for the unit's
# record of that fault (100 ms).
pub const NIC_PROBE_LEN: u32 = 64
const NIC_PROBE_US: u64 = 100000

# How the kernel resets the device when netd dies (driver_quiesce), through
# the kernel's own mapping of its registers, which outlives netd.
pub enum NicReset
    Virtio(u64)                      # the kernel VA of the virtio device_status byte
    E1000e(u64)                      # the kernel VA of BAR0 (CTRL, STATUS, IMC)

# What net/ring1.ritz hands netd, besides the frame and link objects.
pub struct NicGrant
    kind: u16                        # driver_abi.boot NIC_KIND_*: DriverBoot.nic
    vector: u8                       # the IDT vector of entries 0-2
    sid: u32                         # the NIC's requester
    dom: u32                         # its private DMA domain
    reset: NicReset
    msix_table_va: u64               # the kernel's VA of MSI-X entry 0
    window_count: u32
    window_ids: [8]u64               # CAP_TYPE_MMIO objects (drivers/virtio/window.ritz)
    window_types: [8]u8              # their DriverWindow.cfg_type

pub fn klog_sid(sid: u32)
    klog_hex_width(((sid >> 16) & 0xFFFF) as u64, 4)
    klog(":")
    klog_hex_width(((sid >> 8) & 0xFF) as u64, 2)
    klog(":")
    klog_hex_width(((sid >> 3) & 0x1F) as u64, 2)
    klog(".")
    klog_dec((sid & 7) as i64)

pub fn klog_bdf(dev: *PciDevice)
    klog_dec((*dev).bus as i64)
    klog(":")
    klog_dec((*dev).device as i64)
    klog(".")
    klog_dec((*dev).function as i64)

# The probe found the NIC and will not hand it over: logged, and the boot
# has no NIC owner.
pub fn nic_ring1_refused(why: StrView) -> Option<NicGrant>
    klog("[nic-dma] ring-1 owner refused: ")
    klog(why)
    klog("; the NIC has no owner on this boot\n")
    None

# `dev`'s private DMA domain on a translating boot, its bus master set only
# once the domain is live (RING1_DRIVER.md "DMA domain", AGAST #4724): every
# requester its DMA can carry named, their domain made, then bus master.
# None refuses the NIC: an alias it can't name, or no domain, and bus
# master stays off. The caller has turned bus master off.
pub fn nic_private_domain(dev: *PciDevice) -> Option<u32>
    var req: DmaRequesters = pci_dma_requesters(dev)
    let sid: u32 = req.sids[0]
    if not req.named
        klog("[nic-dma] refused: a DMA alias of ")
        klog_sid(sid)
        klog(" can't be named; bus master stays off\n")
        return None
    let dom: u32 = dma_private_domain(span_from_ptr<u32>(@req.sids[0], req.count as i64)).unwrap_or(0)
    if dom == 0
        klog("[nic-dma] refused: no private domain for ")
        klog_sid(sid)
        klog("; bus master stays off\n")
        return None
    pci_enable_bus_master(dev)
    klog("[nic-dma] private domain ")
    klog_dec(dom as i64)
    klog(" for ")
    klog_sid(sid)
    klog(" and ")
    klog_dec((req.count - 1) as i64)
    klog(" alias(es), never in the identity map; bus master on\n")
    Some(dom)

# Could a ring-1 driver own `dev`, in domain `dom` (RING1_DRIVER.md "DMA
# domain")? Only with DMA translated, interrupts remapped and
# compatibility-format interrupts blocked, as every unit reports it now,
# and the NIC in its private domain with every alias named.
pub fn nic_ring1_allowed(dev: *PciDevice, dom: u32) -> bool
    if not dma_isolation_live() or dom == 0 or dev == 0 as *PciDevice
        return false
    dma_requester_isolated(pci_dev_sid(dev))

# MSI-X table entries 0-2 of `dev` on one vector aimed at this CPU, the
# BSP, with `info` probed and mapped: the vector, or None (no table of 3
# entries, no vector, or an entry routed anywhere else). `name` is the
# kind's log prefix, `causes` what entries 0-2 carry.
pub fn nic_msix_bsp(dev: *PciDevice, info: *MsixInfo, name: StrView, causes: StrView) -> Option<u8>
    if msix_probe(dev, info) != 0 or (*info).table_size < NIC_MSIX_ENTRIES
        klog("[msix] ")
        klog(name)
        klog(": no MSI-X table of 3 entries\n")
        return None
    # msix_vector_alloc's own convention: vector 0 means none was free.
    let vector: u8 = msix_vector_alloc()
    if vector == 0 or msix_enable(info) != 0
        klog("[msix] ")
        klog(name)
        klog(": no vector or the table did not map\n")
        return None
    let bsp: u32 = lapic_id()
    var e: u16 = 0
    while e < NIC_MSIX_ENTRIES
        if msix_set_entry_to(info, e, vector, bsp) != 0 or msix_entry_dest(info, e) != bsp
            klog("[msix] ")
            klog(name)
            klog(": entry ")
            klog_dec(e as i64)
            klog(" is not routed to the BSP (APIC ID ")
            klog_dec(bsp as i64)
            klog(")\n")
            return None
        e = e + 1
    klog("[msix] ")
    klog(name)
    klog(": MSI-X on, vector ")
    klog_dec(vector as i64)
    klog(" for ")
    klog(causes)
    klog(" (entries 0-2), routed to the BSP\n")
    Some(vector)

# The fault probe (AGAST #4724), before the kick: whatever a unit recorded
# before is not this probe's.
pub fn nic_faults_drain()
    var stale: i32 = 0
    while stale < 64 and dma_fault_next().is_some()
        stale = stale + 1

# ... after it: did a unit record, within NIC_PROBE_US, a fault naming the
# NIC's source ID `sid` and the unmapped IOVA `hole` the probe gave it? Each
# record is logged, then the verdict:
#   [nic-dma] fault probe: the NIC's DMA to unmapped IOVA 0xH faulted with its source ID S
pub fn nic_fault_seen(sid: u32, hole: u64) -> bool
    var found: bool = false
    let deadline: u64 = deadline_after_us(NIC_PROBE_US)
    while not found and not deadline_passed(deadline)
        match dma_fault_next()
            Some(f) =>
                klog("[nic-dma] fault record: source ")
                klog_sid(f.sid)
                klog(" IOVA 0x")
                klog_hex(f.iova)
                klog(" reason ")
                klog_dec(f.reason as i64)
                if f.read
                    klog(" (read)\n")
                else
                    klog(" (write)\n")
                found = f.sid == sid and f.iova == hole
            None => cpu_pause()
    if found
        klog("[nic-dma] fault probe: the NIC's DMA to unmapped IOVA 0x")
        klog_hex(hole)
        klog(" faulted with its source ID ")
        klog_sid(sid)
        klog("\n")
    else
        klog("[nic-dma] fault probe: no fault record from the NIC for IOVA 0x")
        klog_hex(hole)
        klog("\n")
    found
