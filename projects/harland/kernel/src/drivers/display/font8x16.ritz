# Harland kernel console font: 8x16 bitmaps for printable ASCII (AGAST #4868)
#
# Glyphs 0x20..0x7E of console-setup's Uni2-Fixed16 (the X11 misc-fixed
# 8x16 face). console-setup's copyright.fonts: "All console fonts are
# public domain by nature"; the 8x16 BDF source is (c) 1987-1989 Sony
# Corp., 1996 BIZNET Poland, 2000 Dmitry Yu. Bolkhovityanov, under a
# permission notice to use, copy, modify and distribute for any purpose
# with that notice kept, as here.
#
# Each glyph is 16 rows, top first; bit 7 of a row is its leftmost pixel.
# No imports: hosted tests (test/test_fbcon.ritz) and the screen decoder
# (tools/fbcon_screen.py, which parses FONT_8X16 out of this file) read
# the same table the kernel draws with.

pub const FONT_W: u32 = 8
pub const FONT_H: u32 = 16
pub const FONT_FIRST: u8 = 32     # ' '
pub const FONT_LAST: u8 = 126     # '~'
const FONT_FALLBACK: u8 = 63      # '?': drawn for bytes outside FONT_FIRST..FONT_LAST

