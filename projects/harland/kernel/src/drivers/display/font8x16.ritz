# Row `row` (0 = top) of the glyph for byte c; bytes with no glyph get '?'.
pub fn font_row(c: u8, row: u32) -> u8
    var g: u8 = c
    if g < FONT_FIRST or g > FONT_LAST
        g = FONT_FALLBACK
    FONT_8X16[((g - FONT_FIRST) as i64) * 16 + (row & 15) as i64]
