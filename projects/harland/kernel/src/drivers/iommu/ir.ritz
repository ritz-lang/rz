# Harland interrupt remapping, vendor-neutral (AGAST #4329).
#
# Intel VT-d (drivers/iommu/vtd.ritz, #4316) and AMD-Vi (drivers/iommu/
# amdvi.ritz, #4329) both let a device interrupt reach a CPU whose APIC ID
# doesn't fit the MSI address's or redirection entry's 8 bits: the message
# names a table entry (a handle) and the entry the vector and a 32-bit
# destination. They differ in how the message names the entry:
#   - VT-d: the remappable format, the handle in MSI address bits 19:5 / 2
#     (data 0) or redirection-entry bits 63:49 / 11 with bit 48 set;
#   - AMD-Vi: the compatibility format, the handle in MSI data bits 10:0 or
#     the redirection entry's vector field; the IOMMU picks the table from
#     the requester's device table entry.
# drivers/msix.ritz and ioapic_set_irq (arch/x86_64/apic.ritz) call only
# this module: ir_set for the entry, ir_msi_* / ir_ioapic_rte_* for the
# message, with the handles from drivers/iommu/dmar.ritz (I/O APIC pin N:
# N; MSI vector V: 128 + (V & 127)) under either vendor.
#
# ir_init picks the vendor by the ACPI table firmware provides: DMAR for
# VT-d, else IVRS for AMD-Vi.

import klog { klog }
import drivers.acpi.tables { acpi_find_table }
import drivers.iommu.dmar {
    ACPI_SIG_DMAR, msi_addr_remap, msi_addr_is_remap, msi_addr_handle,
    ioapic_rte_remap_hi, ioapic_rte_remap_lo, ioapic_rte_is_remap, ioapic_rte_handle, irte_dest
}
import mm.pmm { pmm_top_phys }
import drivers.iommu.vtd { vtd_ir_init, vtd_ir_enabled, vtd_ir_x2apic, vtd_ir_set, vtd_ir_get_lo, vtd_ioapic_sid, vtd_dma_init, vtd_dma_translation_on }
import drivers.iommu.vtd { VtdFault, VtdEnter, vtd_private_domain, vtd_requester_isolated, vtd_domain_iova_alloc, vtd_domain_enter, vtd_domain_enter_at, vtd_domain_leave, vtd_domain_entry, vtd_fault_next, vtd_isolation_live }
import drivers.iommu.dmar { sl_present, vtd_entry_addr }
import drivers.pci { PciDevice, DmaRequesters, pci_find_virtio, pci_dma_requesters, VIRTIO_DEVICE_NET }
import ritzlib.option
import ritzlib.span
import drivers.iommu.ivrs { AMDVI_MSI_ADDR, amdvi_msi_data, amdvi_msi_handle, amdvi_rte_lo, amdvi_rte_handle }
import drivers.iommu.amdvi { amdvi_ir_init, amdvi_ir_enabled, amdvi_ir_x2apic, amdvi_ir_set, amdvi_ir_get_dest, amdvi_ioapic_sid }

# No handle: the message isn't in a format that names a table entry.
pub const IR_NO_HANDLE: u32 = 0xFFFFFFFF

# Bring interrupt remapping up, VT-d or AMD-Vi. `x2apic`: the LAPIC is in
# x2APIC mode, so table entries carry 32-bit destinations where the
# hardware can. Returns 0 with remapping on, -1 with it off (logged why).
# With VT-d remapping on, DMA translation comes on too where every unit
# can translate: an identity context for every requester, then TE
# (AGAST #4723). The NIC and its DMA aliases are held out of the identity
# domain (AGAST #4724): its probe gives them a private one. AMD-Vi stays
# DMA pass-through (decision D6).
pub fn ir_init(x2apic: bool) -> i32
    if acpi_find_table(ACPI_SIG_DMAR) != 0
        if vtd_ir_init(x2apic) == 0
            var nic: DmaRequesters = nic_requesters()
            vtd_dma_init(pmm_top_phys(), span_from_ptr<u32>(@nic.sids[0], nic.count as i64))
            return 0
        return -1
    let rc: i32 = amdvi_ir_init(x2apic)
    if rc == -2
        klog("      Interrupt remapping: off (no DMAR or IVRS table)\n")
        return -1
    return rc

# Is device DMA translated by an IOMMU on this boot (VT-d TE on, every
# requester in a context)? Then a virtio device is asked for
# VIRTIO_F_ACCESS_PLATFORM so its DMA goes through the domain.
pub fn dma_translation_on() -> bool
    return vtd_dma_translation_on()

# ============================================================================
# Private DMA domains (AGAST #4724, RING1_DRIVER.md "DMA domain")
# ============================================================================
#
# VT-d only: AMD-Vi is DMA pass-through, so every call here refuses there,
# and a boot without translation keeps the NIC on physical addresses.

# The virtio-net function's requesters, the ones vtd_dma_init holds out of
# the identity domain; none without a NIC (PCI segment 0 is enumerated by
# now; a NIC on a later segment is moved off identity by its probe).
fn nic_requesters() -> DmaRequesters
    let nic: *PciDevice = pci_find_virtio(VIRTIO_DEVICE_NET)
    if nic == 0 as *PciDevice
        var none: DmaRequesters
        none.count = 0
        none.named = true
        return none
    pci_dma_requesters(nic)

# A private domain for the requesters `sids` (vtd_private_domain).
pub fn dma_private_domain(sids: Span<u32>) -> Option<u32>
    if not vtd_dma_translation_on()
        return None
    vtd_private_domain(sids)

# Is requester `sid` in a private domain? What a queue-register grant
# (DrvMmioMap) and the ring-1 cutover check.
pub fn dma_requester_isolated(sid: u32) -> bool
    vtd_requester_isolated(sid)

# Map the contiguous run of `pages` pages at `phys` into domain `dom`
# (vtd_domain_enter: Entered(iova), Refused, or Stuck).
pub fn dma_domain_enter(dom: u32, phys: u64, pages: u64) -> VtdEnter
    vtd_domain_enter(dom, phys, pages)

# ... at `iova` (fresh from dma_domain_iova_alloc, or a confirmed free's).
pub fn dma_domain_enter_at(dom: u32, iova: u64, phys: u64, pages: u64) -> VtdEnter
    vtd_domain_enter_at(dom, iova, phys, pages)

# `pages` pages of IOVA in `dom` never handed out before: the first.
pub fn dma_domain_iova_alloc(dom: u32, pages: u64) -> Option<u64>
    vtd_domain_iova_alloc(dom, pages)

# Take it out again: true once the device reaches none of it.
pub fn dma_domain_leave(dom: u32, iova: u64, pages: u64) -> bool
    vtd_domain_leave(dom, iova, pages)

# An IOVA page in `dom` that nothing will map (a fault probe's target).
pub fn dma_domain_hole(dom: u32) -> Option<u64>
    vtd_domain_iova_alloc(dom, 1)

# The physical page domain `dom` maps `iova` to, None if unmapped.
pub fn dma_domain_phys(dom: u32, iova: u64) -> Option<u64>
    let leaf: u64 = vtd_domain_entry(dom, iova - iova % 4096).unwrap_or(0)
    if not sl_present(leaf)
        return None
    Some(vtd_entry_addr(leaf) + iova % 4096)

# The next recorded DMA fault, cleared (vtd_fault_next).
pub fn dma_fault_next() -> Option<VtdFault>
    vtd_fault_next()

# Is the platform isolating devices now, read from the hardware: DMA
# translated, interrupts remapped, compatibility format blocked.
pub fn dma_isolation_live() -> bool
    vtd_isolation_live()

# Is interrupt remapping on? Then every MSI and redirection entry must name
# a table entry (ir_msi_*, ir_ioapic_rte_*).
pub fn ir_enabled() -> bool
    return vtd_ir_enabled() or amdvi_ir_enabled()

# ... and do table entries hold 32-bit x2APIC destinations?
pub fn ir_x2apic() -> bool
    return vtd_ir_x2apic() or amdvi_ir_x2apic()

# Point table entry `handle` of requester `sid` (segment << 16 | bus << 8 |
# dev << 3 | fn; AMD-Vi picks the segment's device table by it, #4339) at
# `vector` on APIC ID `dest`. The source should be masked. Returns 0,
# or -1 if remapping is off or the entry can't be set.
pub fn ir_set(handle: u32, vector: u8, dest: u32, level: bool, sid: u32) -> i32
    if vtd_ir_enabled()
        return vtd_ir_set(handle, vector, dest, level, sid)
    if amdvi_ir_enabled()
        return amdvi_ir_set(handle, vector, dest, level, sid)
    return -1

# The APIC ID table entry `handle` of requester `sid` sends to, for the
# boot logs.
pub fn ir_get_dest(handle: u32, sid: u32) -> u32
    if vtd_ir_enabled()
        return irte_dest(vtd_ir_get_lo(handle, sid), vtd_ir_x2apic())
    return amdvi_ir_get_dest(handle, sid)

# The requester ID I/O APIC `ioapic_id` sends with (DMAR scope / IVRS
# special entry), or 0xFFFFFFFF if firmware names none.
pub fn ir_ioapic_sid(ioapic_id: u8) -> u32
    if vtd_ir_enabled()
        return vtd_ioapic_sid(ioapic_id)
    return amdvi_ioapic_sid(ioapic_id)

# ============================================================================
# Messages that name table entry `handle`
# ============================================================================

pub fn ir_msi_addr(handle: u32) -> u32
    if amdvi_ir_enabled()
        return AMDVI_MSI_ADDR
    return msi_addr_remap(handle)

pub fn ir_msi_data(handle: u32) -> u32
    if amdvi_ir_enabled()
        return amdvi_msi_data(handle)
    return 0

# The handle an MSI address/data pair names, IR_NO_HANDLE if none.
pub fn ir_msi_handle(addr_lo: u32, data: u32) -> u32
    if amdvi_ir_enabled()
        return amdvi_msi_handle(data)
    if vtd_ir_enabled() and msi_addr_is_remap(addr_lo)
        return msi_addr_handle(addr_lo)
    return IR_NO_HANDLE

pub fn ir_ioapic_rte_hi(handle: u32) -> u32
    if amdvi_ir_enabled()
        return 0
    return ioapic_rte_remap_hi(handle)

pub fn ir_ioapic_rte_lo(vector: u8, handle: u32, masked: bool) -> u32
    if amdvi_ir_enabled()
        return amdvi_rte_lo(handle, masked)
    return ioapic_rte_remap_lo(vector, handle, masked)

# The handle a redirection entry names, IR_NO_HANDLE if none.
pub fn ir_ioapic_rte_handle(rte_hi: u32, rte_lo: u32) -> u32
    if amdvi_ir_enabled()
        return amdvi_rte_handle(rte_lo)
    if vtd_ir_enabled() and ioapic_rte_is_remap(rte_hi)
        return ioapic_rte_handle(rte_hi, rte_lo)
    return IR_NO_HANDLE
