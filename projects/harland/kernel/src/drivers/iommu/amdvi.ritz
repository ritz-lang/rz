# Harland AMD-Vi interrupt remapping (AGAST #4329).
#
# The AMD counterpart of drivers/iommu/vtd.ritz, for AMD machines with APIC
# IDs past 254 (EPYC). Where VT-d has one interrupt remapping table per
# unit, AMD-Vi finds a table per device: the IOMMU looks the requester's
# device ID up in the device table, and the device table entry (DTE) names
# that device's table, so interrupt remapping needs the device table even
# with DMA passing through untranslated.
#
# amdvi_ir_init, from drivers/iommu/ir.ritz (apic_select_mode) when there is
# no DMAR table:
#   - finds the ACPI IVRS table and parses it (drivers/iommu/ivrs.ritz);
#   - picks GA mode (128-bit IRTEs) if every IOMMU has it, and XT (32-bit
#     x2APIC destinations) in x2APIC mode if every IOMMU has that too;
#   - builds one device table covering device IDs 0..last, every entry
#     DMA pass-through (V, TV, Mode 0, IR, IW) and interrupts blocked (IV,
#     IntCtl 00b: aborted) until a table is set;
#   - gives every IOMMU its own command buffer, points it at the device
#     table, turns it on and invalidates everything it may have cached.
# amdvi_ir_set then gives the device its 256-entry IRT on first use (DTE
# IntCtl 10b, INVALIDATE_DEVTAB_ENTRY), writes the IRTE and issues
# INVALIDATE_INTERRUPT_TABLE + COMPLETION_WAIT on every IOMMU.
#
# The handles are drivers/iommu/dmar.ritz's (I/O APIC pin N: N, MSI vector
# V: 128 + (V & 127)), so the boot logs read the same under either vendor.
#
# amdvi_ir_set takes no lock: today only the BSP calls it, during boot. A
# caller on another CPU needs one around the table writes and the buffer.
#
# Only PCI segment 0: a device ID is 16 bits and the table is the
# segment's.

import io { memory_barrier, cpu_pause }
import serial { prints, serial_print_dec, serial_print_hex }
import mm.pmm { pmm_alloc_page, pmm_alloc_contig }
import mm.vmm { vmm_map_mmio, vmm_ensure_mapped, phys_to_virt }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import drivers.acpi.tables { acpi_find_table }
import drivers.iommu.ivrs {
    ACPI_SIG_IVRS, IVRS_DEVID_NONE,
    ivrs_parse, ivrs_ivhd_type, ivrs_num_units, ivrs_unit_base, ivrs_unit_segment, ivrs_unit_efr,
    ivrs_last_devid, ivrs_num_special, ivrs_ioapic_devid, ivrs_alias,
    DTE_SIZE, AMDVI_IRT_ENTRIES,
    dte_q0_passthrough, dte_q2_blocked, dte_q2_remap, dte_q2_is_remap, dte_q2_irt,
    amdvi_devtab_reg, amdvi_devtab_pages,
    irte32, irte32_dest, irte_ga_lo, irte_ga_hi, irte_ga_dest,
    AMDVI_MMIO_SIZE, AMDVI_REG_DEVTAB, AMDVI_REG_CMDBUF, AMDVI_REG_CONTROL, AMDVI_REG_EFR,
    AMDVI_REG_CMD_HEAD, AMDVI_REG_CMD_TAIL, AMDVI_REG_STATUS,
    EFR_IA_SUP, STATUS_CMDBUF_RUN,
    amdvi_control, amdvi_pick_modes, amdvi_cmdbuf_reg,
    CMD_SIZE, CMD_ENTRIES, cmd_wait_lo, cmd_inv_irt_lo, cmd_inv_dte_lo, cmd_inv_all_lo, cmd_next_tail
}

# How long an IOMMU gets to work through its command buffer.
const AMDVI_TIMEOUT_US: u64 = 100000

var amdvi_on: u8 = 0
var amdvi_ga: u8 = 0                # 128-bit IRTEs
var amdvi_xt: u8 = 0                # 32-bit destinations
var amdvi_units: i32 = 0
var amdvi_regs: [8]u64              # kernel virtual address of each IOMMU's registers
var amdvi_ia: [8]u8                 # EFR.IASup: INVALIDATE_ALL works
var amdvi_cmd_phys: [8]u64          # each IOMMU's command buffer (one page)
var amdvi_cmd_tail: [8]u32          # its next free command
var amdvi_devtab_phys: u64 = 0
var amdvi_devtab_last: u32 = 0      # the last device ID the table covers
var amdvi_status_phys: u64 = 0      # COMPLETION_WAIT stores its sequence number here
var amdvi_seq: u64 = 0

pub fn amdvi_ir_enabled() -> bool
    return amdvi_on != 0

pub fn amdvi_ir_x2apic() -> bool
    return amdvi_on != 0 and amdvi_xt != 0

# ============================================================================
# Registers
# ============================================================================

fn amdvi_reg32(u: i32, off: u64) -> u32
    return volatile_load((amdvi_regs[u] + off) as *u32)

fn amdvi_wreg32(u: i32, off: u64, v: u32)
    volatile_store((amdvi_regs[u] + off) as *u32, v)

fn amdvi_reg64(u: i32, off: u64) -> u64
    return (amdvi_reg32(u, off) as u64) | ((amdvi_reg32(u, off + 4) as u64) << 32)

# 64-bit registers take two aligned dword writes, low first.
fn amdvi_wreg64(u: i32, off: u64, v: u64)
    amdvi_wreg32(u, off, (v & 0xFFFFFFFF) as u32)
    amdvi_wreg32(u, off + 4, (v >> 32) as u32)

# The control register high dword first: XTEn (bit 50) is in place before
# the low dword turns the IOMMU on.
fn amdvi_wcontrol(u: i32, v: u64)
    amdvi_wreg32(u, AMDVI_REG_CONTROL + 4, (v >> 32) as u32)
    amdvi_wreg32(u, AMDVI_REG_CONTROL, (v & 0xFFFFFFFF) as u32)

# ============================================================================
# Command buffer
# ============================================================================

# Queue one command; waits while the buffer is full. False on a timeout.
fn amdvi_cmd_submit(u: i32, lo: u64, hi: u64) -> bool
    let next: u32 = cmd_next_tail(amdvi_cmd_tail[u])
    let deadline: u64 = deadline_after_us(AMDVI_TIMEOUT_US)
    while ((amdvi_reg32(u, AMDVI_REG_CMD_HEAD) >> 4) & (CMD_ENTRIES - 1)) == next
        if deadline_passed(deadline)
            return false
        cpu_pause()
    let c: u64 = phys_to_virt(amdvi_cmd_phys[u]) + (amdvi_cmd_tail[u] as u64) * CMD_SIZE
    volatile_store(c as *u64, lo)
    volatile_store((c + 8) as *u64, hi)
    amdvi_cmd_tail[u] = next
    memory_barrier()
    amdvi_wreg64(u, AMDVI_REG_CMD_TAIL, (next as u64) << 4)
    return true

# Queue COMPLETION_WAIT and spin until the IOMMU has done everything before
# it. False on a timeout.
fn amdvi_cmd_sync(u: i32) -> bool
    amdvi_seq = amdvi_seq + 1
    let status: *u64 = phys_to_virt(amdvi_status_phys) as *u64
    volatile_store(status, 0)
    memory_barrier()
    if not amdvi_cmd_submit(u, cmd_wait_lo(amdvi_status_phys), amdvi_seq)
        prints("      [amdvi] IOMMU ")
        serial_print_dec(u as u64)
        prints(": command buffer full\n")
        return false
    let deadline: u64 = deadline_after_us(AMDVI_TIMEOUT_US)
    while volatile_load(status) != amdvi_seq
        if deadline_passed(deadline)
            prints("      [amdvi] IOMMU ")
            serial_print_dec(u as u64)
            prints(": COMPLETION_WAIT timed out (status ")
            serial_print_hex(amdvi_reg32(u, AMDVI_REG_STATUS) as u64)
            prints(")\n")
            return false
        cpu_pause()
    return true

# Queue `lo` (a 128-bit command whose hi half is 0) on every IOMMU and wait
# for each. False if any didn't confirm.
fn amdvi_cmd_all(lo: u64) -> bool
    var ok: bool = true
    var u: i32 = 0
    while u < amdvi_units
        if not amdvi_cmd_submit(u, lo, 0) or not amdvi_cmd_sync(u)
            ok = false
        u = u + 1
    return ok

# ============================================================================
# Device table and IRTEs
# ============================================================================

fn amdvi_dte(devid: u32) -> u64
    return phys_to_virt(amdvi_devtab_phys) + (devid as u64) * DTE_SIZE

fn amdvi_zero_page(p: u64)
    let v: *u64 = phys_to_virt(p) as *u64
    var i: i64 = 0
    while i < 512
        *(v + i) = 0
        i = i + 1

fn amdvi_alloc_page() -> u64
    let p: u64 = pmm_alloc_page()
    if p != 0
        amdvi_zero_page(p)
    return p

# The device ID requests from requester ID `sid` arrive with (IVRS alias
# entries), or IVRS_DEVID_NONE if the device table doesn't cover it.
fn amdvi_devid(sid: u32) -> u32
    if sid == IVRS_DEVID_NONE or sid > 0xFFFF
        return IVRS_DEVID_NONE
    let d: u32 = ivrs_alias(sid)
    if d > amdvi_devtab_last
        return IVRS_DEVID_NONE
    return d

# Device `devid`'s IRT (physical), given one on first use: a zeroed page
# (every entry RemapEn 0), then the DTE pointing at it, invalidated
# everywhere. 0 on failure.
fn amdvi_irt(devid: u32) -> u64
    let q2p: *u64 = (amdvi_dte(devid) + 16) as *u64
    let q2: u64 = volatile_load(q2p)
    if dte_q2_is_remap(q2)
        return dte_q2_irt(q2)
    let irt: u64 = amdvi_alloc_page()
    if irt == 0
        return 0
    memory_barrier()
    volatile_store(q2p, dte_q2_remap(irt))
    memory_barrier()
    if not amdvi_cmd_all(cmd_inv_dte_lo(devid))
        return 0
    return irt

# Point IRTE `handle` of the device with requester ID `sid` at `vector` on
# APIC ID `dest` (32-bit with XT, else 8-bit), and make every IOMMU drop
# its cached copy. `level` is the source's business (the redirection
# entry's trigger mode); an AMD-Vi IRTE has no trigger bit. The source
# should be masked. Returns 0, or -1 if remapping is off, the handle or
# device is out of range, or an IOMMU didn't confirm.
pub fn amdvi_ir_set(handle: u32, vector: u8, dest: u32, level: bool, sid: u32) -> i32
    if amdvi_on == 0 or handle >= AMDVI_IRT_ENTRIES
        return -1
    let devid: u32 = amdvi_devid(sid)
    if devid == IVRS_DEVID_NONE
        return -1
    let irt: u64 = amdvi_irt(devid)
    if irt == 0
        return -1
    if amdvi_ga != 0
        let e: u64 = phys_to_virt(irt) + (handle as u64) * 16
        # RemapEn off while the vector and high destination change.
        volatile_store(e as *u64, 0)
        memory_barrier()
        volatile_store((e + 8) as *u64, irte_ga_hi(vector, dest))
        memory_barrier()
        volatile_store(e as *u64, irte_ga_lo(dest))
    else
        volatile_store((phys_to_virt(irt) + (handle as u64) * 4) as *u32, irte32(vector, dest))
    memory_barrier()
    if not amdvi_cmd_all(cmd_inv_irt_lo(devid))
        return -1
    return 0

# The destination IRTE `handle` of requester `sid` holds, for the boot
# log; 0xFFFFFFFF if there is none.
pub fn amdvi_ir_get_dest(handle: u32, sid: u32) -> u32
    if amdvi_on == 0 or handle >= AMDVI_IRT_ENTRIES
        return 0xFFFFFFFF
    let devid: u32 = amdvi_devid(sid)
    if devid == IVRS_DEVID_NONE
        return 0xFFFFFFFF
    let q2: u64 = volatile_load((amdvi_dte(devid) + 16) as *u64)
    if not dte_q2_is_remap(q2)
        return 0xFFFFFFFF
    let irt: u64 = phys_to_virt(dte_q2_irt(q2))
    if amdvi_ga != 0
        let lo: u64 = volatile_load((irt + (handle as u64) * 16) as *u64)
        let hi: u64 = volatile_load((irt + (handle as u64) * 16 + 8) as *u64)
        return irte_ga_dest(lo, hi)
    return irte32_dest(volatile_load((irt + (handle as u64) * 4) as *u32))

# The device ID IVRS gives I/O APIC `ioapic_id`, or IVRS_DEVID_NONE.
pub fn amdvi_ioapic_sid(ioapic_id: u8) -> u32
    return ivrs_ioapic_devid(ioapic_id)

# ============================================================================
# Bring-up
# ============================================================================

fn amdvi_fail(u: i32, what: StrView) -> i32
    prints("      Interrupt remapping: off (AMD-Vi IOMMU ")
    serial_print_dec(u as u64)
    prints(": ")
    prints(what)
    prints(")\n")
    return -1

# Turn IOMMUs 0..n-1 back off after a later one failed.
fn amdvi_units_disable(n: i32)
    var u: i32 = 0
    while u < n
        amdvi_wcontrol(u, 0)
        u = u + 1

# Turn IOMMU `u` on: command buffer, device table, control; then drop
# whatever it cached from firmware's tables.
fn amdvi_unit_enable(u: i32) -> i32
    # Firmware may have left it on: off first, so the new tables take.
    let ctrl: u64 = amdvi_reg64(u, AMDVI_REG_CONTROL)
    amdvi_wcontrol(u, 0)
    amdvi_cmd_tail[u] = 0
    amdvi_wreg64(u, AMDVI_REG_CMDBUF, amdvi_cmdbuf_reg(amdvi_cmd_phys[u]))
    amdvi_wreg64(u, AMDVI_REG_CMD_HEAD, 0)
    amdvi_wreg64(u, AMDVI_REG_CMD_TAIL, 0)
    amdvi_wreg64(u, AMDVI_REG_DEVTAB, amdvi_devtab_reg(amdvi_devtab_phys, amdvi_devtab_pages(amdvi_devtab_last)))
    amdvi_wcontrol(u, amdvi_control(ctrl, amdvi_ga != 0, amdvi_xt != 0))
    let deadline: u64 = deadline_after_us(AMDVI_TIMEOUT_US)
    while (amdvi_reg32(u, AMDVI_REG_STATUS) & STATUS_CMDBUF_RUN) == 0
        if deadline_passed(deadline)
            return amdvi_fail(u, "command buffer won't run")
        cpu_pause()
    if amdvi_ia[u] != 0
        if not amdvi_cmd_submit(u, cmd_inv_all_lo(), 0)
            return amdvi_fail(u, "INVALIDATE_ALL not queued")
    else
        var d: u32 = 0
        while d <= amdvi_devtab_last
            if not amdvi_cmd_submit(u, cmd_inv_dte_lo(d), 0) or not amdvi_cmd_submit(u, cmd_inv_irt_lo(d), 0)
                return amdvi_fail(u, "invalidation not queued")
            d = d + 1
    if not amdvi_cmd_sync(u)
        return amdvi_fail(u, "invalidation not confirmed")
    return 0

# Bring up interrupt remapping on every IOMMU IVRS lists. `x2apic`: the
# LAPIC is in x2APIC mode, so IRTEs carry 32-bit destinations if the
# IOMMUs have GA and XT. ACPI must be parsed. Returns 0 with remapping on,
# -1 with it off (logged why), -2 if there is no IVRS table (nothing
# logged: drivers/iommu/ir.ritz says so).
pub fn amdvi_ir_init(x2apic: bool) -> i32
    amdvi_on = 0
    amdvi_units = 0
    let ivrs: u64 = acpi_find_table(ACPI_SIG_IVRS)
    if ivrs == 0
        return -2
    let len: u32 = *((ivrs + 4) as *u32)
    if vmm_ensure_mapped(ivrs, len as u64) != 0
        prints("      Interrupt remapping: off (IVRS table not mappable)\n")
        return -1
    let n: i32 = ivrs_parse(ivrs as *u8, len)
    prints("      IVRS at ")
    serial_print_hex(ivrs)
    prints(": ")
    serial_print_dec(ivrs_num_units as u64)
    prints(" IOMMU(s) (IVHD type ")
    serial_print_hex(ivrs_ivhd_type as u64)
    prints("), last device ID ")
    serial_print_hex(ivrs_last_devid as u64)
    prints(", ")
    serial_print_dec(ivrs_num_special as u64)
    prints(" I/O APIC/HPET entr(ies)\n")
    if n <= 0
        prints("      Interrupt remapping: off (IVRS lists no IOMMU)\n")
        return -1
    var modes: u32 = 3
    var u: i32 = 0
    while u < n
        if ivrs_unit_segment[u] != 0
            return amdvi_fail(u, "PCI segment other than 0")
        let regs: u64 = vmm_map_mmio(ivrs_unit_base[u], AMDVI_MMIO_SIZE)
        if regs == 0
            return amdvi_fail(u, "registers not mappable")
        amdvi_regs[u] = regs
        let efr: u64 = amdvi_reg64(u, AMDVI_REG_EFR) | ivrs_unit_efr[u]
        modes = modes & amdvi_pick_modes(efr, x2apic)
        amdvi_ia[u] = 0
        if (efr & EFR_IA_SUP) != 0
            amdvi_ia[u] = 1
        amdvi_cmd_phys[u] = amdvi_alloc_page()
        if amdvi_cmd_phys[u] == 0
            return amdvi_fail(u, "no page for the command buffer")
        u = u + 1
    amdvi_ga = (modes & 1) as u8
    amdvi_xt = ((modes >> 1) & 1) as u8
    # The device table: every device DMA pass-through, interrupts blocked.
    amdvi_devtab_last = ivrs_last_devid & 0xFFFF
    let pages: u64 = amdvi_devtab_pages(amdvi_devtab_last)
    amdvi_devtab_phys = pmm_alloc_contig(pages)
    amdvi_status_phys = amdvi_alloc_page()
    if amdvi_devtab_phys == 0 or amdvi_status_phys == 0
        prints("      Interrupt remapping: off (no memory for the device table)\n")
        return -1
    var p: u64 = 0
    while p < pages
        amdvi_zero_page(amdvi_devtab_phys + p * 4096)
        p = p + 1
    var d: u32 = 0
    while d <= amdvi_devtab_last
        let e: u64 = amdvi_dte(d)
        volatile_store(e as *u64, dte_q0_passthrough())
        volatile_store((e + 16) as *u64, dte_q2_blocked())
        d = d + 1
    memory_barrier()
    amdvi_units = n
    u = 0
    while u < n
        if amdvi_unit_enable(u) != 0
            amdvi_units_disable(u + 1)
            amdvi_units = 0
            return -1
        u = u + 1
    amdvi_on = 1
    prints("      Interrupt remapping: AMD-Vi on, ")
    serial_print_dec(n as u64)
    prints(" unit(s), device table at ")
    serial_print_hex(amdvi_devtab_phys)
    if amdvi_xt != 0
        prints(", 32-bit x2APIC destinations (GA, XT)\n")
    else if amdvi_ga != 0
        prints(", 8-bit xAPIC destinations (GA)\n")
    else
        prints(", 8-bit xAPIC destinations (legacy IRTEs)\n")
    return 0
