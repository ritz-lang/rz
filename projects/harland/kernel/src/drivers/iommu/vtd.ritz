# Harland Intel VT-d interrupt remapping (AGAST #4316).
#
# MSI and I/O APIC interrupts name their CPU with 8 bits (arch/x86_64/
# irq_dest.ritz), so on bare metal a CPU with APIC ID 255 or more gets no
# device interrupt of its own. Interrupt remapping fixes that: each device
# message carries a handle, and the remapping unit looks up that handle's
# entry (IRTE) in a table the kernel owns. In extended interrupt mode (EIM)
# an IRTE holds a full 32-bit x2APIC destination.
#
# vtd_ir_init, from apic_select_mode once the LAPIC mode is known and before
# the I/O APIC is programmed:
#   - finds the ACPI DMAR table and parses it (drivers/iommu/dmar.ritz);
#   - checks every remapping unit can remap (ECAP.IR, queued invalidation,
#     and EIM in x2APIC mode); if any can't, remapping stays off and device
#     interrupts keep the 8-bit / extended-destination-ID rules;
#   - gives every PCI segment with a unit its own 256-entry IRT, and every
#     unit its segment's table and its own invalidation queue, sets the table pointer, flushes the interrupt entry cache and
#     turns remapping on with compatibility-format interrupts blocked (CFI
#     clear): an unremapped MSI or redirection entry would bypass the table.
# vtd_ir_set then writes an IRTE in the table of the requester's segment
# (its source ID's bits 31:16, AGAST #4598) and invalidates it in that
# segment's units; drivers/msix.ritz and
# ioapic_set_irq (arch/x86_64/apic.ritz) program their sources in the
# remappable format with handles from ir_handle_msi / ir_handle_ioapic.
#
# DMA remapping (AGAST #4722) has its mechanics here and is not turned on:
# TE is never set, so no DMA is translated yet. For a requester on a
# segment where vtd_translation_capable holds:
#   - vtd_domain_new makes a domain: a domain ID and an empty second-level
#     page table; vtd_domain_map / vtd_domain_unmap map and unmap one 4 KiB
#     IOVA in it, and unmap waits for the IOTLB invalidation;
#   - vtd_context_attach points the requester's context entry (in its
#     segment's root and context tables, the root table installed in the
#     segment's units on first use) at the domain; vtd_context_detach
#     clears it and waits for the context-cache and IOTLB invalidations;
#   - vtd_fault_next reads and clears a pending fault record: the requester,
#     the page, the reason.
# Every invalidation waits on the queue for at most VTD_TIMEOUT_US and
# reports a unit that didn't confirm (VtdDma.Timeout): the old entry
# may still be cached, so the caller must not hand the page out again.
# The firmware's RMRRs (dmar_rmrr_*) are what an identity context for a
# device that DMAs behind the OS's back must map.
#
# vtd_ir_set and the DMA functions take no lock: today only the BSP calls
# them, during boot. A caller on another CPU needs one around the table
# writes and the queue.
#
# AMD-Vi (IVRS) is drivers/iommu/amdvi.ritz (AGAST #4329); drivers/iommu/ir.ritz
# picks between them, and the rest of the kernel calls only it.

import klog { klog, klog_dec, klog_hex }
import io { memory_barrier, cpu_pause }
import mm.pmm { pmm_alloc_page }
import mm.vmm { vmm_map_mmio, vmm_ensure_mapped, phys_to_virt }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import ritzlib.option
import drivers.acpi.tables { acpi_find_table }
import drivers.iommu.dmar {
    ACPI_SIG_DMAR, DMAR_INTR_REMAP, DMAR_X2APIC_OPT_OUT,
    dmar_parse, dmar_flags, dmar_num_units, dmar_unit_base, dmar_num_ioapics,
    dmar_ioapic_source_id, dmar_num_segs, dmar_seg_id, dmar_unit_seg_index,
    dmar_sid_seg_index, DMAR_SEG_ALL,
    irte_lo, irte_hi, IRTE_SVT_VERIFY_SID, IRT_ENTRIES,
    VTD_REG_CAP, VTD_REG_ECAP, VTD_REG_GCMD, VTD_REG_GSTS, VTD_REG_RTADDR, VTD_REG_FSTS,
    VTD_REG_IQH, VTD_REG_IQT, VTD_REG_IQA, VTD_REG_IRTA,
    ECAP_C, GCMD_QIE, GCMD_IRE, GCMD_SIRTP, GCMD_CFI, GCMD_SRTP, GCMD_WBF,
    vtd_gcmd_from_gsts, vtd_irta, vtd_ecap_can_remap,
    QI_DESC_SIZE, qi_iec_global_lo, qi_iec_index_lo, qi_wait_lo, qi_wait_hi, qi_next_tail,
    CAP_RWBF, CAP_CM, CAP_SAGAW_39, CAP_SAGAW_48, DMAR_SID_NONE, vtd_cap_domains, vtd_cap_sl_levels, vtd_iova_bits,
    vtd_cap_fault_offset, vtd_cap_fault_count, vtd_can_translate,
    FSTS_PFO, FSTS_PPF, FSTS_IQE, FSTS_ITE, fsts_fri,
    vtd_rtaddr, vtd_sid_bus, vtd_sid_devfn, vtd_root_lo, vtd_ctx_lo, vtd_ctx_hi, vtd_ctx_did,
    vtd_entry_present, vtd_entry_addr, sl_index, sl_table, sl_leaf, sl_present,
    frcd_pending, frcd_sid, frcd_reason, frcd_is_read, frcd_addr,
    QI_G_GLOBAL, QI_G_DOMAIN, qi_cc_global_lo, qi_cc_device_lo, qi_iotlb_lo,
    qi_iotlb_unmap_lo, qi_iotlb_unmap_hi
}

# How long a unit gets to acknowledge a command or finish the queue.
const VTD_TIMEOUT_US: u64 = 100000

var vtd_on: bool = false
var vtd_x2: bool = false
var vtd_units: i32 = 0
var vtd_regs: [8]u64            # kernel virtual address of each unit's registers
var vtd_coherent: [8]u8         # ECAP.C: the unit snoops the IRT, no flush needed
var vtd_qi_phys: [8]u64         # each unit's invalidation queue (one page)
var vtd_qi_tail: [8]u32         # its next free descriptor
var vtd_seg_irt_phys: [8]u64     # each PCI segment's IRT, by dmar_seg_id index
var vtd_status_phys: u64 = 0    # wait descriptors write their sequence number here
var vtd_seq: u32 = 0
var vtd_cap: [8]u64             # each unit's CAP and ECAP
var vtd_ecap: [8]u64

# DMA remapping (AGAST #4722). Domain d (0-based) has domain ID d + 1: with
# caching mode, ID 0 tags cached not-present entries.
pub const VTD_MAX_DOMAINS: i32 = 8
var vtd_seg_root_phys: [8]u64   # each segment's root table, 0 until a context is attached
var vtd_num_doms: i32 = 0
var vtd_dom_sl_phys: [8]u64     # each domain's second-level table
var vtd_dom_seg: [8]i32         # the segment index it serves
var vtd_dom_levels: [8]u32      # its depth: 3 or 4

# Why a DMA remapping call failed (or Ok).
pub enum VtdDma
    Ok
    NoSegment       # remapping is off, no source ID, or no unit on the requester's segment
    NoDomain        # not a domain, or not one of the requester's segment
    NoPage          # out of physical pages for a table
    BadAddress      # not page-aligned, or past what the domain translates
    Mapped          # the IOVA is mapped already
    NotMapped       # the IOVA isn't mapped
    Busy            # the requester's context names another domain
    Timeout         # a unit didn't confirm a command or an invalidation: the old entry may be cached

# A recorded DMA fault.
pub struct VtdFault
    sid: u32        # the requester: segment << 16 | bus:dev.fn
    iova: u64       # the page it addressed
    reason: u8      # the fault reason (VT-d specification, appendix A)
    read: bool      # a read; else a write

# Is interrupt remapping on? Then every MSI and redirection entry must be
# programmed in the remappable format.
pub fn vtd_ir_enabled() -> bool
    return vtd_on

# ... and are IRTE destinations 32-bit x2APIC IDs (EIM)?
pub fn vtd_ir_x2apic() -> bool
    return vtd_on and vtd_x2

# ============================================================================
# Registers
# ============================================================================

fn vtd_reg32(u: i32, off: u64) -> u32
    return volatile_load((vtd_regs[u] + off) as *u32)

fn vtd_wreg32(u: i32, off: u64, v: u32)
    volatile_store((vtd_regs[u] + off) as *u32, v)

fn vtd_reg64(u: i32, off: u64) -> u64
    return (vtd_reg32(u, off) as u64) | ((vtd_reg32(u, off + 4) as u64) << 32)

# 64-bit registers take two aligned dword writes, low first.
fn vtd_wreg64(u: i32, off: u64, v: u64)
    vtd_wreg32(u, off, (v & 0xFFFFFFFF) as u32)
    vtd_wreg32(u, off + 4, (v >> 32) as u32)

# Wait until GSTS has all of `bits` set (`want_set`) or clear.
fn vtd_wait_gsts(u: i32, bits: u32, want_set: bool) -> bool
    let deadline: u64 = deadline_after_us(VTD_TIMEOUT_US)
    while true
        let now: u32 = vtd_reg32(u, VTD_REG_GSTS) & bits
        if (want_set and now == bits) or (not want_set and now == 0)
            return true
        if deadline_passed(deadline)
            return false
        cpu_pause()

# Issue a GCMD: the current persistent state plus `set`, minus `clear`;
# wait for GSTS to show `wait_bits` set (or clear when `want_set` is false).
fn vtd_gcmd(u: i32, set: u32, clear: u32, wait_bits: u32, want_set: bool) -> bool
    let cmd: u32 = (vtd_gcmd_from_gsts(vtd_reg32(u, VTD_REG_GSTS)) | set) & (0xFFFFFFFF ^ clear)
    vtd_wreg32(u, VTD_REG_GCMD, cmd)
    return vtd_wait_gsts(u, wait_bits, want_set)

# Write back an IRTE's cache line when the unit doesn't snoop the table.
fn vtd_clflush(addr: u64)
    asm x86_64:
        movq {addr}, %r8
        clflush (%r8)

# ============================================================================
# Queued invalidation
# ============================================================================

fn vtd_qi_submit(u: i32, lo: u64, hi: u64)
    let d: u64 = phys_to_virt(vtd_qi_phys[u]) + (vtd_qi_tail[u] as u64) * QI_DESC_SIZE
    volatile_store(d as *u64, lo)
    volatile_store((d + 8) as *u64, hi)
    vtd_qi_tail[u] = qi_next_tail(vtd_qi_tail[u])
    memory_barrier()
    vtd_wreg64(u, VTD_REG_IQT, (vtd_qi_tail[u] as u64) << 4)

# Queue a wait descriptor and spin until the unit has done everything
# before it. False on a timeout or a queue error.
fn vtd_qi_sync(u: i32) -> bool
    vtd_seq = vtd_seq + 1
    let status: *u32 = phys_to_virt(vtd_status_phys) as *u32
    volatile_store(status, 0)
    vtd_qi_submit(u, qi_wait_lo(vtd_seq), qi_wait_hi(vtd_status_phys))
    let deadline: u64 = deadline_after_us(VTD_TIMEOUT_US)
    while volatile_load(status) != vtd_seq
        if (vtd_reg32(u, VTD_REG_FSTS) & (FSTS_IQE | FSTS_ITE)) != 0
            klog("      [vtd] unit ")
            klog_dec(u as i64)
            klog(": invalidation queue error\n")
            return false
        if deadline_passed(deadline)
            klog("      [vtd] unit ")
            klog_dec(u as i64)
            klog(": invalidation wait timed out\n")
            return false
        cpu_pause()
    return true

# ============================================================================
# IRTEs
# ============================================================================

# Write IRTE `handle` of segment index `si`'s table and make that
# segment's units drop their cached copy. -1 if a unit didn't confirm.
fn vtd_irte_write(si: i32, handle: u32, lo: u64, hi: u64) -> i32
    let e: u64 = phys_to_virt(vtd_seg_irt_phys[si]) + (handle as u64) * 16
    if volatile_load((e + 8) as *u64) != hi
        # Not present while the source ID changes: no half-old entry.
        volatile_store(e as *u64, 0)
        memory_barrier()
        volatile_store((e + 8) as *u64, hi)
        memory_barrier()
    volatile_store(e as *u64, lo)
    memory_barrier()
    var rc: i32 = 0
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si
            if vtd_coherent[u] == 0
                vtd_clflush(e)
                memory_barrier()
            vtd_qi_submit(u, qi_iec_index_lo(handle), 0)
            if not vtd_qi_sync(u)
                rc = -1
        u = u + 1
    return rc

# Point IRT entry `handle` at `vector` on APIC ID `dest` (32-bit in EIM,
# else 8-bit), edge or level, from requester `sid` (segment << 16 |
# bus:dev.fn; DMAR_SID_NONE: not validated), in the table of its segment
# (every table for DMAR_SID_NONE), and make those units drop their cached
# copy. The source should be masked: a live entry is cleared before its
# source ID changes. Returns 0, or -1 if remapping is off, the handle is
# out of range, no unit is on the segment or a unit didn't confirm the
# invalidation.
pub fn vtd_ir_set(handle: u32, vector: u8, dest: u32, level: bool, sid: u32) -> i32
    if not vtd_on or handle >= IRT_ENTRIES
        return -1
    let lo: u64 = irte_lo(vector, dest, level, vtd_x2)
    let hi: u64 = irte_hi(sid, IRTE_SVT_VERIFY_SID)
    let si: i32 = dmar_sid_seg_index(sid)
    if si == DMAR_SEG_ALL
        var rc: i32 = 0
        var k: i32 = 0
        while k < dmar_num_segs
            if vtd_irte_write(k, handle, lo, hi) != 0
                rc = -1
            k = k + 1
        return rc
    if si < 0
        return -1
    return vtd_irte_write(si, handle, lo, hi)

# The low 64 bits of IRT entry `handle` (vector, destination, present) in
# the table of requester `sid`'s segment, for the boot log; 0 if remapping
# is off or no unit is on the segment. DMAR_SID_NONE entries are the same
# in every table: read the first.
pub fn vtd_ir_get_lo(handle: u32, sid: u32) -> u64
    if not vtd_on or handle >= IRT_ENTRIES
        return 0
    var si: i32 = dmar_sid_seg_index(sid)
    if si == DMAR_SEG_ALL
        si = 0
    if si < 0
        return 0
    return volatile_load((phys_to_virt(vtd_seg_irt_phys[si]) + (handle as u64) * 16) as *u64)

# The source ID DMAR gives I/O APIC `ioapic_id`, or DMAR_SID_NONE.
pub fn vtd_ioapic_sid(ioapic_id: u8) -> u32
    return dmar_ioapic_source_id(ioapic_id)

# ============================================================================
# Bring-up
# ============================================================================

fn vtd_alloc_page() -> u64
    let p: u64 = pmm_alloc_page()
    if p == 0
        return 0
    let v: *u64 = phys_to_virt(p) as *u64
    var i: i64 = 0
    while i < 512
        *(v + i) = 0
        i = i + 1
    return p

fn vtd_fail(u: i32, what: StrView) -> i32
    klog("      Interrupt remapping: off (unit ")
    klog_dec(u as i64)
    klog(": ")
    klog(what)
    klog(")\n")
    return -1

# Turn remapping on in unit `u`: take over the invalidation queue, set the
# table, flush the entry cache, enable with compatibility format blocked.
fn vtd_unit_enable(u: i32, x2: bool) -> i32
    let gsts: u32 = vtd_reg32(u, VTD_REG_GSTS)
    # Firmware may have left remapping or its own queue on.
    if (gsts & GCMD_IRE) != 0 and not vtd_gcmd(u, 0, GCMD_IRE, GCMD_IRE, false)
        return vtd_fail(u, "IRE won't clear")
    if (gsts & GCMD_QIE) != 0
        let deadline: u64 = deadline_after_us(VTD_TIMEOUT_US)
        while vtd_reg64(u, VTD_REG_IQH) != vtd_reg64(u, VTD_REG_IQT) and not deadline_passed(deadline)
            cpu_pause()
        if not vtd_gcmd(u, 0, GCMD_QIE, GCMD_QIE, false)
            return vtd_fail(u, "firmware's invalidation queue won't stop")
    # Queue: 256 128-bit descriptors (QS = 0, DW = 0), empty.
    vtd_qi_tail[u] = 0
    vtd_wreg64(u, VTD_REG_IQT, 0)
    vtd_wreg64(u, VTD_REG_IQA, vtd_qi_phys[u])
    if not vtd_gcmd(u, GCMD_QIE, 0, GCMD_QIE, true)
        return vtd_fail(u, "queued invalidation won't start")
    vtd_wreg64(u, VTD_REG_IRTA, vtd_irta(vtd_seg_irt_phys[dmar_unit_seg_index[u]], x2))
    if not vtd_gcmd(u, GCMD_SIRTP, 0, GCMD_SIRTP, true)
        return vtd_fail(u, "table pointer not taken")
    vtd_qi_submit(u, qi_iec_global_lo(), 0)
    if not vtd_qi_sync(u)
        return vtd_fail(u, "entry cache flush failed")
    if not vtd_gcmd(u, GCMD_IRE, GCMD_CFI, GCMD_IRE, true)
        return vtd_fail(u, "IRE won't set")
    if (vtd_reg32(u, VTD_REG_GSTS) & GCMD_CFI) != 0
        return vtd_fail(u, "compatibility format still passes")
    return 0

# Turn remapping back off in units 0..n-1 after a later unit failed.
fn vtd_units_disable(n: i32)
    var u: i32 = 0
    while u < n
        vtd_gcmd(u, 0, GCMD_IRE, GCMD_IRE, false)
        u = u + 1

# Bring up interrupt remapping on every DMAR unit. `x2apic`: the LAPIC is
# in x2APIC mode, so IRTEs carry 32-bit destinations (EIM). ACPI must be
# parsed. Returns 0 with remapping on, -1 with it off (logged why).
pub fn vtd_ir_init(x2apic: bool) -> i32
    vtd_on = false
    vtd_units = 0
    vtd_num_doms = 0
    var k: i32 = 0
    while k < 8
        vtd_seg_root_phys[k] = 0
        k = k + 1
    let dmar: u64 = acpi_find_table(ACPI_SIG_DMAR)
    if dmar == 0
        klog("      Interrupt remapping: off (no DMAR table)\n")
        return -1
    let len: u32 = *((dmar + 4) as *u32)
    if vmm_ensure_mapped(dmar, len as u64) != 0
        klog("      Interrupt remapping: off (DMAR table not mappable)\n")
        return -1
    let n: i32 = dmar_parse(dmar as *u8, len)
    klog("      DMAR at ")
    klog_hex(dmar)
    klog(": ")
    klog_dec(dmar_num_units as i64)
    klog(" remapping unit(s), ")
    klog_dec(dmar_num_ioapics as i64)
    klog(" I/O APIC scope(s), flags ")
    klog_hex(dmar_flags as u64)
    klog("\n")
    if n <= 0
        klog("      Interrupt remapping: off (DMAR lists no remapping unit)\n")
        return -1
    if (dmar_flags & DMAR_INTR_REMAP) == 0
        klog("      Interrupt remapping: off (DMAR: the platform doesn't support it)\n")
        return -1
    if x2apic and (dmar_flags & DMAR_X2APIC_OPT_OUT) != 0
        klog("      Interrupt remapping: off (DMAR: firmware opts out of x2APIC)\n")
        return -1
    var u: i32 = 0
    while u < n
        let regs: u64 = vmm_map_mmio(dmar_unit_base[u], 4096)
        if regs == 0
            return vtd_fail(u, "registers not mappable")
        vtd_regs[u] = regs
        let ecap: u64 = vtd_reg64(u, VTD_REG_ECAP)
        if not vtd_ecap_can_remap(ecap, x2apic)
            klog("      [vtd] unit at ")
            klog_hex(dmar_unit_base[u])
            klog(": ECAP ")
            klog_hex(ecap)
            klog("\n")
            return vtd_fail(u, "no IR, queued invalidation or EIM")
        vtd_ecap[u] = ecap
        vtd_cap[u] = vtd_reg64(u, VTD_REG_CAP)
        vtd_coherent[u] = 0
        if (ecap & ECAP_C) != 0
            vtd_coherent[u] = 1
        vtd_qi_phys[u] = vtd_alloc_page()
        if vtd_qi_phys[u] == 0
            return vtd_fail(u, "no page for the invalidation queue")
        u = u + 1
    var si: i32 = 0
    while si < dmar_num_segs
        vtd_seg_irt_phys[si] = vtd_alloc_page()
        if vtd_seg_irt_phys[si] == 0
            klog("      Interrupt remapping: off (no page for PCI segment ")
            klog_dec(dmar_seg_id[si] as i64)
            klog("'s table)\n")
            return -1
        si = si + 1
    vtd_status_phys = vtd_alloc_page()
    if vtd_status_phys == 0
        klog("      Interrupt remapping: off (no page for the wait status)\n")
        return -1
    u = 0
    while u < n
        if vtd_unit_enable(u, x2apic) != 0
            vtd_units_disable(u)
            return -1
        u = u + 1
    vtd_units = n
    vtd_x2 = false
    if x2apic
        vtd_x2 = true
    vtd_on = true
    klog("      Interrupt remapping: VT-d on, ")
    klog_dec(n as i64)
    if dmar_num_segs == 1
        klog(" unit(s), table at ")
        klog_hex(vtd_seg_irt_phys[0])
    else
        klog(" unit(s), ")
        klog_dec(dmar_num_segs as i64)
        klog(" PCI segment tables")
    if x2apic
        klog(", 32-bit x2APIC destinations (EIM)\n")
    else
        klog(", 8-bit xAPIC destinations\n")
    return 0

# ============================================================================
# DMA remapping (AGAST #4722): tables, domains, contexts, faults
# ============================================================================

# Make segment `si`'s units see a table write at `addr`: write the cache
# line back where a unit doesn't snoop the tables (ECAP.C clear), and flush
# the write buffer where a unit needs that (CAP.RWBF).
fn vtd_seg_publish(si: i32, addr: u64)
    memory_barrier()
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si
            if vtd_coherent[u] == 0
                vtd_clflush(addr)
                memory_barrier()
            if (vtd_cap[u] & CAP_RWBF) != 0
                vtd_gcmd(u, GCMD_WBF, 0, GCMD_WBF, false)
        u = u + 1

# ... a whole new (zeroed) table page.
fn vtd_seg_publish_page(si: i32, phys: u64)
    let v: u64 = phys_to_virt(phys)
    var off: u64 = 0
    while off < 4096
        vtd_seg_publish(si, v + off)
        off = off + 64

# The segment index whose root table and units serve requester `sid`, or
# -1: remapping is off, `sid` has no source ID or no unit is on its segment.
fn vtd_sid_seg(sid: u32) -> i32
    if not vtd_on or sid == DMAR_SID_NONE
        return -1
    let si: i32 = dmar_sid_seg_index(sid)
    if si == DMAR_SEG_ALL
        return -1
    return si

# The second-level depth every unit on segment `si` walks; 0 if one can't
# translate (or none is there).
fn vtd_seg_levels(si: i32) -> u32
    var sagaw: u64 = CAP_SAGAW_48 | CAP_SAGAW_39
    var any: bool = false
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si
            if not vtd_can_translate(vtd_cap[u], vtd_ecap[u])
                return 0
            sagaw = sagaw & vtd_cap[u]
            any = true
        u = u + 1
    if not any
        return 0
    return vtd_cap_sl_levels(sagaw)

# Can DMA from requester `sid` (segment << 16 | bus:dev.fn) be translated:
# remapping is on and every unit on its segment can walk a second-level
# table? The ring-1 cutover refuses a requester for which this is false.
pub fn vtd_translation_capable(sid: u32) -> bool
    let si: i32 = vtd_sid_seg(sid)
    return si >= 0 and vtd_seg_levels(si) != 0

# Domain `dom`'s index, -1 if it isn't one.
fn vtd_dom_index(dom: u32) -> i32
    if dom == 0 or dom > (vtd_num_doms as u32)
        return -1
    return (dom - 1) as i32

# A new, empty domain for requesters on `sid`'s segment: its domain ID,
# the handle vtd_domain_map and vtd_context_attach take. None if the
# segment can't translate, every domain or ID is taken, or there's no page.
pub fn vtd_domain_new(sid: u32) -> Option<u32>
    let si: i32 = vtd_sid_seg(sid)
    if si < 0
        return None
    let levels: u32 = vtd_seg_levels(si)
    if levels == 0 or vtd_num_doms >= VTD_MAX_DOMAINS
        return None
    let d: i32 = vtd_num_doms
    let did: u32 = (d + 1) as u32
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si and did >= vtd_cap_domains(vtd_cap[u])
            return None
        u = u + 1
    let sl: u64 = vtd_alloc_page()
    if sl == 0
        return None
    vtd_seg_publish_page(si, sl)
    vtd_dom_sl_phys[d] = sl
    vtd_dom_seg[d] = si
    vtd_dom_levels[d] = levels
    vtd_num_doms = d + 1
    return Some(did)

# Is `iova` a page every unit of domain index `d`'s segment translates?
fn vtd_dom_iova_ok(d: i32, iova: u64) -> bool
    if (iova & 0xFFF) != 0
        return false
    let si: i32 = vtd_dom_seg[d]
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si and (iova >> vtd_iova_bits(vtd_cap[u], vtd_dom_levels[d])) != 0
            return false
        u = u + 1
    return true

# The kernel address of the leaf entry for `iova` in domain index `d`. A
# missing table is made with `alloc`; else (or with no page for it) 0.
# Internal; 0 is never a table entry's address (as pmm_alloc_page's 0).
fn vtd_sl_leaf_entry(d: i32, iova: u64, alloc: bool) -> u64
    let si: i32 = vtd_dom_seg[d]
    var table: u64 = vtd_dom_sl_phys[d]
    var level: u32 = vtd_dom_levels[d]
    while level > 1
        let e: u64 = phys_to_virt(table) + sl_index(iova, level) * 8
        var v: u64 = volatile_load(e as *u64)
        if not sl_present(v)
            if not alloc
                return 0
            let next: u64 = vtd_alloc_page()
            if next == 0
                return 0
            vtd_seg_publish_page(si, next)
            v = sl_table(next)
            volatile_store(e as *u64, v)
            vtd_seg_publish(si, e)
        table = vtd_entry_addr(v)
        level = level - 1
    return phys_to_virt(table) + sl_index(iova, 1) * 8

# Drop domain `did`'s mapping of `iova` from every IOTLB on segment `si`
# (with `cm_only`, only units in caching mode, which may have cached the
# entry while it was not present) and wait. False if a unit didn't confirm.
fn vtd_seg_iotlb_page(si: i32, did: u32, iova: u64, cm_only: bool) -> bool
    var ok: bool = true
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si and (not cm_only or (vtd_cap[u] & CAP_CM) != 0)
            vtd_qi_submit(u, qi_iotlb_unmap_lo(did, vtd_cap[u]), qi_iotlb_unmap_hi(iova, vtd_cap[u]))
            if not vtd_qi_sync(u)
                ok = false
        u = u + 1
    return ok

# Map the 4 KiB page at `iova` in domain `dom` to physical `phys`: the
# device reads it, and writes it if `write`.
pub fn vtd_domain_map(dom: u32, iova: u64, phys: u64, write: bool) -> VtdDma
    let d: i32 = vtd_dom_index(dom)
    if d < 0
        return VtdDma.NoDomain
    if not vtd_dom_iova_ok(d, iova) or (phys & 0xFFF) != 0
        return VtdDma.BadAddress
    let e: u64 = vtd_sl_leaf_entry(d, iova, true)
    if e == 0
        return VtdDma.NoPage
    if sl_present(volatile_load(e as *u64))
        return VtdDma.Mapped
    volatile_store(e as *u64, sl_leaf(phys, write))
    vtd_seg_publish(vtd_dom_seg[d], e)
    if not vtd_seg_iotlb_page(vtd_dom_seg[d], dom, iova, true)
        return VtdDma.Timeout
    return VtdDma.Ok

# Unmap `iova` from domain `dom` and wait until no unit can still use the
# old entry. On Timeout the page may still be reachable by the device: the
# caller keeps it out of the PMM (RING1_DRIVER.md, dma_quarantine).
pub fn vtd_domain_unmap(dom: u32, iova: u64) -> VtdDma
    let d: i32 = vtd_dom_index(dom)
    if d < 0
        return VtdDma.NoDomain
    if not vtd_dom_iova_ok(d, iova)
        return VtdDma.BadAddress
    let e: u64 = vtd_sl_leaf_entry(d, iova, false)
    if e == 0 or not sl_present(volatile_load(e as *u64))
        return VtdDma.NotMapped
    volatile_store(e as *u64, 0)
    vtd_seg_publish(vtd_dom_seg[d], e)
    if not vtd_seg_iotlb_page(vtd_dom_seg[d], dom, iova, false)
        return VtdDma.Timeout
    return VtdDma.Ok

# Domain `dom`'s leaf entry for `iova` (sl_leaf: the page and R/W), None
# if it isn't mapped.
pub fn vtd_domain_entry(dom: u32, iova: u64) -> Option<u64>
    let d: i32 = vtd_dom_index(dom)
    if d < 0 or not vtd_dom_iova_ok(d, iova)
        return None
    let e: u64 = vtd_sl_leaf_entry(d, iova, false)
    if e == 0
        return None
    let v: u64 = volatile_load(e as *u64)
    if not sl_present(v)
        return None
    return Some(v)

# Segment `si`'s root table, installed in its units on first use: RTADDR,
# SRTP, then the context caches and IOTLBs dropped (firmware may have
# translated with tables of its own). TE stays as it is: clear.
fn vtd_seg_root(si: i32) -> VtdDma
    if vtd_seg_root_phys[si] != 0
        return VtdDma.Ok
    let root: u64 = vtd_alloc_page()
    if root == 0
        return VtdDma.NoPage
    vtd_seg_publish_page(si, root)
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si
            vtd_wreg64(u, VTD_REG_RTADDR, vtd_rtaddr(root))
            if not vtd_gcmd(u, GCMD_SRTP, 0, GCMD_SRTP, true)
                klog("      [vtd] unit ")
                klog_dec(u as i64)
                klog(": root table pointer not taken\n")
                return VtdDma.Timeout
            vtd_qi_submit(u, qi_cc_global_lo(), 0)
            vtd_qi_submit(u, qi_iotlb_lo(QI_G_GLOBAL, 0, vtd_cap[u]), 0)
            if not vtd_qi_sync(u)
                return VtdDma.Timeout
        u = u + 1
    vtd_seg_root_phys[si] = root
    return VtdDma.Ok

# The kernel address of requester `sid`'s context entry on segment `si`.
# A missing context table is made with `alloc`; else (or with no root
# table, or no page) 0.
# Internal; 0 is never an entry's address (as pmm_alloc_page's 0).
fn vtd_ctx_entry(si: i32, sid: u32, alloc: bool) -> u64
    if vtd_seg_root_phys[si] == 0
        return 0
    let re: u64 = phys_to_virt(vtd_seg_root_phys[si]) + vtd_sid_bus(sid) * 16
    var lo: u64 = volatile_load(re as *u64)
    if not vtd_entry_present(lo)
        if not alloc
            return 0
        let ctx: u64 = vtd_alloc_page()
        if ctx == 0
            return 0
        vtd_seg_publish_page(si, ctx)
        lo = vtd_root_lo(ctx)
        volatile_store((re + 8) as *u64, 0)
        volatile_store(re as *u64, lo)
        vtd_seg_publish(si, re)
    return phys_to_virt(vtd_entry_addr(lo)) + vtd_sid_devfn(sid) * 16

# Point requester `sid`'s context entry at domain `dom`, which must serve
# its segment. Attaching it to the domain it has already is Ok; to another,
# Busy. Translation isn't on (TE clear), so nothing is translated yet.
pub fn vtd_context_attach(dom: u32, sid: u32) -> VtdDma
    let d: i32 = vtd_dom_index(dom)
    if d < 0
        return VtdDma.NoDomain
    let si: i32 = vtd_sid_seg(sid)
    if si < 0
        return VtdDma.NoSegment
    if si != vtd_dom_seg[d]
        return VtdDma.NoDomain
    let r: VtdDma = vtd_seg_root(si)
    if r != VtdDma.Ok
        return r
    let ce: u64 = vtd_ctx_entry(si, sid, true)
    if ce == 0
        return VtdDma.NoPage
    if vtd_entry_present(volatile_load(ce as *u64))
        if vtd_ctx_did(volatile_load((ce + 8) as *u64)) == dom
            return VtdDma.Ok
        return VtdDma.Busy
    # The domain first, then present: the unit never sees half an entry.
    volatile_store((ce + 8) as *u64, vtd_ctx_hi(dom, vtd_dom_levels[d]))
    memory_barrier()
    volatile_store(ce as *u64, vtd_ctx_lo(vtd_dom_sl_phys[d]))
    vtd_seg_publish(si, ce)
    # A unit in caching mode may have cached the not-present entry, under
    # domain ID 0.
    var ok: bool = true
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si and (vtd_cap[u] & CAP_CM) != 0
            vtd_qi_submit(u, qi_cc_device_lo(0, sid), 0)
            vtd_qi_submit(u, qi_iotlb_lo(QI_G_DOMAIN, 0, vtd_cap[u]), 0)
            if not vtd_qi_sync(u)
                ok = false
        u = u + 1
    if not ok
        return VtdDma.Timeout
    return VtdDma.Ok

# The domain requester `sid`'s context entry names, None if it has none.
pub fn vtd_context_domain(sid: u32) -> Option<u32>
    let si: i32 = vtd_sid_seg(sid)
    if si < 0
        return None
    let ce: u64 = vtd_ctx_entry(si, sid, false)
    if ce == 0 or not vtd_entry_present(volatile_load(ce as *u64))
        return None
    return Some(vtd_ctx_did(volatile_load((ce + 8) as *u64)))

# Clear requester `sid`'s context entry and wait until no unit on its
# segment has the entry or a translation under its domain cached. On
# Timeout the requester may still reach the domain's pages.
pub fn vtd_context_detach(sid: u32) -> VtdDma
    let si: i32 = vtd_sid_seg(sid)
    if si < 0
        return VtdDma.NoSegment
    let ce: u64 = vtd_ctx_entry(si, sid, false)
    if ce == 0 or not vtd_entry_present(volatile_load(ce as *u64))
        return VtdDma.NotMapped
    let did: u32 = vtd_ctx_did(volatile_load((ce + 8) as *u64))
    volatile_store(ce as *u64, 0)
    vtd_seg_publish(si, ce)
    var ok: bool = true
    var u: i32 = 0
    while u < vtd_units
        if dmar_unit_seg_index[u] == si
            vtd_qi_submit(u, qi_cc_device_lo(did, sid), 0)
            vtd_qi_submit(u, qi_iotlb_lo(QI_G_DOMAIN, did, vtd_cap[u]), 0)
            if not vtd_qi_sync(u)
                ok = false
        u = u + 1
    if not ok
        return VtdDma.Timeout
    return VtdDma.Ok

# The next recorded DMA fault, cleared so the unit can record another; None
# if no unit has one. Records past the mapped register page are skipped.
pub fn vtd_fault_next() -> Option<VtdFault>
    if not vtd_on
        return None
    var u: i32 = 0
    while u < vtd_units
        let fsts: u32 = vtd_reg32(u, VTD_REG_FSTS)
        if (fsts & FSTS_PFO) != 0
            # write 1 to clear: the unit records faults again once a record is free
            vtd_wreg32(u, VTD_REG_FSTS, FSTS_PFO)
        if (fsts & FSTS_PPF) != 0
            let base: u64 = vtd_cap_fault_offset(vtd_cap[u])
            let n: u32 = vtd_cap_fault_count(vtd_cap[u])
            var i: u32 = 0
            while i < n
                let off: u64 = base + (((fsts_fri(fsts) + i) % n) as u64) * 16
                if off + 16 <= 4096
                    let hi: u64 = vtd_reg64(u, off + 8)
                    if frcd_pending(hi)
                        let lo: u64 = vtd_reg64(u, off)
                        # F (bit 127) is write 1 to clear
                        vtd_wreg32(u, off + 12, 0x80000000)
                        let seg: u32 = dmar_seg_id[dmar_unit_seg_index[u]] as u32
                        return Some(VtdFault { sid: (seg << 16) | frcd_sid(hi), iova: frcd_addr(lo), reason: frcd_reason(hi), read: frcd_is_read(hi) })
                i = i + 1
        u = u + 1
    return None
