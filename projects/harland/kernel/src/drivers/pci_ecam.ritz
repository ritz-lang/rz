# Harland PCI segments: MCFG parsing, ECAM addresses, requester IDs (AGAST #4582)
#
# Port I/O (0xCF8/0xCFC) reaches PCI segment 0 only. A multi-segment machine
# (EPYC) puts devices on segments 1+, whose config space is reachable only
# through ECAM, the memory-mapped config space the ACPI MCFG table describes
# (PCI Firmware Spec 3.0 §4.1.2). Each MCFG entry gives one segment's ECAM
# base and the bus range it decodes; bus B, device D, function F, register R
# sits at base + (B << 20 | D << 15 | F << 12 | R). The base names bus 0
# even when the range starts later.
#
# Requester IDs (AMD-Vi device table lookups, VT-d source IDs) are
# segment << 16 | bus << 8 | device << 3 | function: the same packing as
# drivers/iommu/ivrs.ritz amdvi_sid.
#
# Import-free so the host tests can compile it on its own
# (projects/ritz/ritz0/tests/test_harland_pci_segments.py). drivers/pci.ritz
# maps the ECAM windows and does the accesses.

# MCFG layout: 36-byte ACPI header, 8 reserved bytes, then 16-byte entries:
# base (8), segment (2), start bus (1), end bus (1), reserved (4).
const MCFG_SIGNATURE: u32 = 0x4746434D   # "MCFG"
const MCFG_ENTRIES: u32 = 44
const MCFG_ENTRY_SIZE: u32 = 16

# Entries kept; more are ignored.
pub const PCI_MCFG_MAX: i32 = 8

# What mcfg_parse found.
pub var mcfg_count: i32 = 0
pub var mcfg_base: [8]u64
pub var mcfg_seg: [8]u16
pub var mcfg_bus_start: [8]u8
pub var mcfg_bus_end: [8]u8

# Root-bus discovery (AGAST #4599): entry * 256 + bus is 1 once something
# accounts for that bus (a device found on it, or a bridge's secondary..
# subordinate range covers it). A bus still 0 after the bridge walks may be
# another host bridge's root bus (EPYC root complexes, QEMU pxb-pcie).
pub var pci_bus_reached: [2048]u8      # PCI_MCFG_MAX * 256

fn mcfg_rd8(t: *u8, off: u32) -> u32
    return *(t + off as i64) as u32

fn mcfg_rd16(t: *u8, off: u32) -> u32
    return mcfg_rd8(t, off) | (mcfg_rd8(t, off + 1) << 8)

fn mcfg_rd32(t: *u8, off: u32) -> u32
    return mcfg_rd16(t, off) | (mcfg_rd16(t, off + 2) << 16)

fn mcfg_rd64(t: *u8, off: u32) -> u64
    return (mcfg_rd32(t, off) as u64) | ((mcfg_rd32(t, off + 4) as u64) << 32)

# Parse the MCFG at `table`, of which `len` bytes are readable. Keeps each
# usable entry (non-zero base, end bus >= start bus, wholly inside the
# table), up to PCI_MCFG_MAX. Returns the number kept, or -1 if it isn't an
# MCFG or its header is cut short or claims more bytes than `len`.
pub fn mcfg_parse(table: *u8, len: u32) -> i32
    mcfg_count = 0
    var k: i32 = 0
    while k < 2048
        pci_bus_reached[k] = 0
        k = k + 1
    if len < MCFG_ENTRIES or mcfg_rd32(table, 0) != MCFG_SIGNATURE
        return -1
    let tlen: u32 = mcfg_rd32(table, 4)
    if tlen < MCFG_ENTRIES or tlen > len
        return -1
    var off: u32 = MCFG_ENTRIES
    while off + MCFG_ENTRY_SIZE <= tlen and mcfg_count < PCI_MCFG_MAX
        let base: u64 = mcfg_rd64(table, off)
        let start: u32 = mcfg_rd8(table, off + 10)
        let end: u32 = mcfg_rd8(table, off + 11)
        if base != 0 and end >= start
            mcfg_base[mcfg_count] = base
            mcfg_seg[mcfg_count] = mcfg_rd16(table, off + 8) as u16
            mcfg_bus_start[mcfg_count] = start as u8
            mcfg_bus_end[mcfg_count] = end as u8
            mcfg_count = mcfg_count + 1
        off = off + MCFG_ENTRY_SIZE
    return mcfg_count

# The entry whose range decodes (segment, bus), or -1.
pub fn mcfg_find(seg: u32, bus: u32) -> i32
    var i: i32 = 0
    while i < mcfg_count
        if (mcfg_seg[i] as u32) == seg and bus >= (mcfg_bus_start[i] as u32) and bus <= (mcfg_bus_end[i] as u32)
            return i
        i = i + 1
    return -1

# Mark buses lo..hi of segment `seg` reached, in whichever entries cover
# them; buses no entry covers are ignored.
pub fn pci_bus_mark(seg: u32, lo: u32, hi: u32)
    var b: u32 = lo
    while b <= hi and b <= 0xFF
        let i: i32 = mcfg_find(seg, b)
        if i >= 0
            pci_bus_reached[i * 256 + b as i32] = 1
        b = b + 1

# The first bus at or after `from` in entry `entry`'s range that nothing has
# reached, or -1. A bus counts for the entry mcfg_find picks for it: buses
# below the range, and buses an earlier entry of the segment also covers,
# are skipped, so no bus is a candidate twice.
pub fn pci_bus_unreached(entry: i32, from: u32) -> i32
    if entry < 0 or entry >= mcfg_count
        return -1
    var b: u32 = from
    while b <= (mcfg_bus_end[entry] as u32)
        if pci_bus_reached[entry * 256 + b as i32] == 0 and mcfg_find(mcfg_seg[entry] as u32, b) == entry
            return b as i32
        b = b + 1
    return -1

# Physical address of bus `bus`'s 1 MiB of config space in segment `seg`,
# or 0 if no entry decodes it.
pub fn ecam_bus_phys(seg: u32, bus: u32) -> u64
    let i: i32 = mcfg_find(seg, bus)
    if i < 0
        return 0
    return mcfg_base[i] + (((bus & 0xFF) as u64) << 20)

# Physical address of register `reg` (0-0xFFF) of seg/bus:dev.func, or 0 if
# no entry decodes that bus.
pub fn ecam_addr(seg: u32, bus: u32, dev: u32, func: u32, reg: u32) -> u64
    let b: u64 = ecam_bus_phys(seg, bus)
    if b == 0
        return 0
    return b + (((dev & 0x1F) as u64) << 15) + (((func & 0x7) as u64) << 12) + ((reg & 0xFFF) as u64)

# True if an entry describes a segment other than 0.
pub fn mcfg_has_other_segments() -> bool
    var i: i32 = 0
    while i < mcfg_count
        if mcfg_seg[i] != 0
            return true
        i = i + 1
    return false

# Requester ID: segment << 16 | bus << 8 | device << 3 | function.
pub fn pci_sid(seg: u32, bus: u32, dev: u32, func: u32) -> u32
    return ((seg & 0xFFFF) << 16) | ((bus & 0xFF) << 8) | ((dev & 0x1F) << 3) | (func & 0x7)
