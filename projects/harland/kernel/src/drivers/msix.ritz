# Harland Kernel - PCI MSI-X (AGAST #1852)
#
# Message Signalled Interrupts, extended (PCI Local Bus 3.0 §6.8.2). A device
# with an MSI-X capability (ID 0x11) has a table of up to 2048 entries in one
# of its memory BARs. Each 16-byte entry holds a message address, message data
# and a mask bit; when the device raises entry N it writes N's data to N's
# address. Address 0xFEE0_0000 | (APIC ID << 12) with data = vector delivers
# that vector, edge-triggered, to that CPU's Local APIC: no I/O APIC, no
# shared INTx line. The APIC ID field is 8 bits: a CPU with ID 255 or more
# is reached only with the extended destination ID, else its entries go to
# another CPU (arch/x86_64/irq_dest.ritz, AGAST #4233).
#
# This module:
#   - finds a device's MSI-X capability and its table (msix_probe);
#   - maps the table through the kernel MMIO window, masks every entry and
#     enables MSI-X (msix_enable);
#   - hands out IDT vectors MSIX_VECTOR_BASE.. (msix_vector_alloc) and points
#     a table entry at one, aimed at the current CPU if an MSI can reach
#     it, else the BSP (msix_set_entry);
#   - hands out a second pool, MSIX_LOCAL_VECTOR_BASE.., for interrupts aimed
#     at whichever CPU submits a command (msix_vector_alloc_local, #4220).
#     Its IDT gates have no IST, so an AP (which has no TSS) can take one;
#   - counts each vector's interrupts (msix_dispatch, from irq_handler), so a
#     driver or a test can see interrupts were delivered (msix_vector_count).
#
# It also programs plain MSI (capability 05h, AGAST #4885) for a function
# with no MSI-X, such as an AHCI HBA: one message (msi_probe, msi_enable),
# from the same vector pool and counted by the same msix_dispatch, through
# interrupt remapping when it is on, as MSI-X entries are. The register
# layout is in drivers/msi_cap.ritz.
#
# IDT gates for the vectors are set in arch/x86_64/idt.ritz; the stubs are
# irq_stub_32..47 in isr_stubs.s (vector = 32 + stub number).

import klog { klog, klog_dec, klog_hex, klog_hex_width }
import mm.vmm { vmm_map_mmio }
import drivers.pci { PciDevice, pci_find_capability, pci_dev_read_config16, pci_dev_read_config32, pci_dev_write_config16, pci_dev_write_config32, pci_dev_sid, pci_enable_memory, pci_get_device_count, pci_get_device }
import drivers.msi_cap { MsiLayout, msi_layout, msi_ctrl_one, msi_ctrl_off, PCI_CAP_MSI, MSI_CAP_CONTROL, MSI_CAP_ADDR_LO, MSI_CAP_ADDR_HI }
import arch.x86_64.irq_dest { msi_addr_lo, msi_addr_dest, IRQ_DEST_NONE }
import drivers.iommu.ir { ir_enabled, ir_set, ir_get_dest, ir_msi_addr, ir_msi_data, ir_msi_handle }
import drivers.iommu.dmar { ir_handle_msi }
import proc.waitset { irq_object_fire_vector }

# Current CPU's Local APIC ID, the CPU an interrupt meant for an APIC ID
# goes to, and why it isn't that one (arch/x86_64/apic.ritz)
extern fn lapic_id() -> u32
extern fn irq_route_dest(want: u32) -> u32
extern fn irq_route_print_reason(apic_id: u32)

# ============================================================================
# Constants
# ============================================================================

pub const PCI_CAP_MSIX: u8 = 0x11

# Capability layout (offsets from the capability pointer)
const MSIX_CAP_CONTROL: u8 = 2      # 16-bit Message Control
const MSIX_CAP_TABLE: u8 = 4        # 32-bit Table Offset / BIR

# Message Control bits
const MSIX_CTRL_TABLE_SIZE: u16 = 0x07FF    # table size - 1
const MSIX_CTRL_FUNCTION_MASK: u16 = 0x4000
const MSIX_CTRL_ENABLE: u16 = 0x8000

# Table entry layout (16 bytes each)
const MSIX_ENTRY_SIZE: u64 = 16
const MSIX_ENTRY_ADDR_LO: u64 = 0
const MSIX_ENTRY_ADDR_HI: u64 = 4
const MSIX_ENTRY_DATA: u64 = 8
const MSIX_ENTRY_CTRL: u64 = 12
const MSIX_ENTRY_CTRL_MASKED: u32 = 1

# IDT vectors handed out to MSI-X entries: 0x40-0x4F, above the I/O APIC's
# 32-47 and below anything else the kernel uses (spurious is 0xFF).
pub const MSIX_VECTOR_BASE: u8 = 64
pub const MSIX_VECTOR_COUNT: u8 = 16

# A second pool, 0x50-0x5F, for interrupts aimed at the CPU that submits a
# command (AGAST #4220). These get IST-free IDT gates, so an AP (which has no
# TSS) can take one; the pool above keeps its IST2 gate for the BSP.
pub const MSIX_LOCAL_VECTOR_BASE: u8 = 80
pub const MSIX_LOCAL_VECTOR_COUNT: u8 = 16

# ============================================================================
# State
# ============================================================================

# A device's MSI-X capability, as msix_probe found it and msix_enable mapped it
pub struct MsixInfo
    dev: *PciDevice
    cap: u8             # capability offset in config space (0 = none)
    table_bar: u8       # BAR holding the table
    table_size: u16     # number of entries
    table_offset: u32   # table offset within that BAR
    table_virt: u64     # kernel virtual address of entry 0 (0 until enabled)

var msix_next_vector: u8 = 0                # next free slot past MSIX_VECTOR_BASE
var msix_irq_count: [16]u64                 # interrupts seen, per slot
var msix_local_next_vector: u8 = 0          # next free local slot
var msix_local_irq_count: [16]u64           # local pools' interrupts

# ============================================================================
# Capability discovery
# ============================================================================

# Find dev's MSI-X capability and describe its table in *out. Returns 0 if
# the device has MSI-X and its table sits in a usable memory BAR, else -1
# (out.cap is 0 when there is no capability at all).
pub fn msix_probe(dev: *PciDevice, out: *MsixInfo) -> i32
    (*out).dev = dev
    (*out).cap = 0
    (*out).table_bar = 0
    (*out).table_size = 0
    (*out).table_offset = 0
    (*out).table_virt = 0

    let cap: u8 = pci_find_capability(dev, PCI_CAP_MSIX)
    if cap == 0
        return -1
    let ctrl: u16 = pci_dev_read_config16(dev, cap + MSIX_CAP_CONTROL)
    let table: u32 = pci_dev_read_config32(dev, cap + MSIX_CAP_TABLE)

    (*out).cap = cap
    (*out).table_size = (ctrl & MSIX_CTRL_TABLE_SIZE) + 1
    (*out).table_bar = (table & 0x7) as u8
    (*out).table_offset = table & 0xFFFFFFF8

    let bar: i32 = (*out).table_bar as i32
    if bar > 5 or (*dev).bar_is_io[bar] != 0 or (*dev).bar[bar] == 0
        return -1
    return 0

# ============================================================================
# Enabling
# ============================================================================

# Map info's table, mask every entry and turn MSI-X on for the device. Its
# INTx line is off from here on (the PCI spec ties that to MSI-X Enable).
# Entries stay masked until msix_set_entry programs them. Returns 0 on
# success, -1 if the table can't be mapped.
pub fn msix_enable(info: *MsixInfo) -> i32
    let dev: *PciDevice = (*info).dev
    let bar: i32 = (*info).table_bar as i32
    let phys: u64 = (*dev).bar[bar] + ((*info).table_offset as u64)
    let virt: u64 = vmm_map_mmio(phys, ((*info).table_size as u64) * MSIX_ENTRY_SIZE)
    if virt == 0
        return -1
    (*info).table_virt = virt
    pci_enable_memory(dev)

    let ctrl_off: u8 = (*info).cap + MSIX_CAP_CONTROL

    # Enable with the whole function masked, mask each entry, then unmask the
    # function: no entry can fire with a stale address/data in between.
    var ctrl: u16 = pci_dev_read_config16(dev, ctrl_off)
    pci_dev_write_config16(dev, ctrl_off, ctrl | MSIX_CTRL_ENABLE | MSIX_CTRL_FUNCTION_MASK)
    var i: u16 = 0
    while i < (*info).table_size
        let entry: u64 = virt + (i as u64) * MSIX_ENTRY_SIZE
        volatile_store((entry + MSIX_ENTRY_CTRL) as *u32, MSIX_ENTRY_CTRL_MASKED)
        i = i + 1
    ctrl = pci_dev_read_config16(dev, ctrl_off)
    pci_dev_write_config16(dev, ctrl_off, (ctrl | MSIX_CTRL_ENABLE) & (0xFFFF ^ MSIX_CTRL_FUNCTION_MASK))
    return 0

# Mask the `entries` table entries from kernel VA `table_virt` (driver_quiesce,
# #4733: the device of a dead ring-1 driver raises nothing more). The table
# is the kernel's mapping; no process ever maps it.
pub fn msix_mask_entries(table_virt: u64, entries: u32)
    if table_virt == 0
        return
    var i: u64 = 0
    while i < entries as u64
        volatile_store((table_virt + i * MSIX_ENTRY_SIZE + MSIX_ENTRY_CTRL) as *u32, MSIX_ENTRY_CTRL_MASKED)
        i = i + 1

# Unmask the `entries` table entries from kernel VA `table_virt`: the
# device's next owner may be signalled again (D9, #4875: netd's restart,
# after driver_quiesce masked them). Each entry's address and data are the
# ones the kernel programmed at the probe and stay as they were.
pub fn msix_unmask_entries(table_virt: u64, entries: u32)
    if table_virt == 0
        return
    var i: u64 = 0
    while i < entries as u64
        volatile_store((table_virt + i * MSIX_ENTRY_SIZE + MSIX_ENTRY_CTRL) as *u32, 0)
        i = i + 1

# Allocate one IDT vector for an MSI-X entry. Returns the vector, or 0 when
# all MSIX_VECTOR_COUNT are taken. Vectors are never freed: drivers come up
# once per boot.
pub fn msix_vector_alloc() -> u8
    if msix_next_vector >= MSIX_VECTOR_COUNT
        return 0
    let vector: u8 = MSIX_VECTOR_BASE + msix_next_vector
    msix_irq_count[msix_next_vector as i32] = 0
    msix_next_vector = msix_next_vector + 1
    return vector

# Allocate one CPU-local IDT vector for an MSI-X entry. Returns the vector,
# or 0 when all MSIX_LOCAL_VECTOR_COUNT are taken.
pub fn msix_vector_alloc_local() -> u8
    if msix_local_next_vector >= MSIX_LOCAL_VECTOR_COUNT
        return 0
    let vector: u8 = MSIX_LOCAL_VECTOR_BASE + msix_local_next_vector
    msix_local_irq_count[msix_local_next_vector as i32] = 0
    msix_local_next_vector = msix_local_next_vector + 1
    return vector

# Point table entry `entry` at `vector` on the current CPU (the BSP during
# boot) and unmask it. A CPU an MSI can't reach (APIC ID 255 or more with
# no extended destination ID) gets the entry sent to the BSP, or the first
# CPU an MSI reaches, and says so. With interrupt remapping on (VT-d #4316,
# AMD-Vi #4329) the entry names table entry ir_handle_msi(vector) (in the
# format drivers/iommu/ir.ritz gives), and that entry holds the vector and
# the (32-bit) destination; the device's requester ID picks (AMD-Vi) or
# validates (VT-d) the table. Returns 0, or -1 if the entry is out of range, the table
# isn't mapped, no CPU can take the interrupt or the IRTE can't be set.
pub fn msix_set_entry(info: *MsixInfo, entry: u16, vector: u8) -> i32
    return msix_set_entry_to(info, entry, vector, lapic_id())

# Like msix_set_entry, but aimed at the CPU with APIC ID `want` rather than
# the current CPU: a per-CPU completion vector (AGAST #4220). If `want` can't
# take device interrupts the entry goes to the CPU irq_route_dest picks, as
# msix_set_entry does.
pub fn msix_set_entry_to(info: *MsixInfo, entry: u16, vector: u8, want: u32) -> i32
    if (*info).table_virt == 0 or entry >= (*info).table_size
        return -1
    let e: u64 = (*info).table_virt + (entry as u64) * MSIX_ENTRY_SIZE
    let here: u32 = want
    let dest: u32 = irq_route_dest(here)
    if dest == IRQ_DEST_NONE
        klog("[msix] no CPU can take MSI-X vector ")
        klog_dec(vector as i64)
        klog(" (APIC ID ")
        klog_dec(here as i64)
        klog(": ")
        irq_route_print_reason(here)
        klog(")\n")
        return -1
    if dest != here
        klog("[msix] vector ")
        klog_dec(vector as i64)
        klog(" -> APIC ID ")
        klog_dec(dest as i64)
        klog(", not this CPU's ")
        klog_dec(here as i64)
        klog(": ")
        irq_route_print_reason(here)
        klog("\n")
    # Mask while rewriting, so the device never sees half an entry.
    volatile_store((e + MSIX_ENTRY_CTRL) as *u32, MSIX_ENTRY_CTRL_MASKED)
    # Fixed delivery, edge-triggered: data is just the vector.
    var addr: u32 = msi_addr_lo(dest)
    var data: u32 = vector as u32
    if ir_enabled()
        let handle: u32 = ir_handle_msi(vector)
        if ir_set(handle, vector, dest, false, msix_sid(info)) != 0
            klog("[msix] vector ")
            klog_dec(vector as i64)
            klog(": IRTE not set; entry left masked\n")
            return -1
        addr = ir_msi_addr(handle)
        data = ir_msi_data(handle)
    volatile_store((e + MSIX_ENTRY_ADDR_LO) as *u32, addr)
    volatile_store((e + MSIX_ENTRY_ADDR_HI) as *u32, 0)
    volatile_store((e + MSIX_ENTRY_DATA) as *u32, data)
    volatile_store((e + MSIX_ENTRY_CTRL) as *u32, 0)
    return 0

# ============================================================================
# Plain MSI (AGAST #4885)
# ============================================================================

# Why msi_enable left a function's MSI off.
pub enum MsiError
    # No CPU an MSI can reach (irq_route_dest).
    NoCpu
    # Interrupt remapping is on and the IRTE could not be set.
    Irte

# A function's MSI capability, and once msi_enable ran, where its one
# message goes.
pub struct Msi
    dev: *PciDevice
    cap: u8             # capability offset in config space
    layout: MsiLayout
    vector: u8          # 0 until enabled
    dest: u32           # APIC ID the message reaches
    irte: u32           # IRT handle the message names; MSIX_NO_IRTE if none

# dev's MSI capability, or None when it has none.
pub fn msi_probe(dev: *PciDevice) -> Option<Msi>
    let cap: u8 = pci_find_capability(dev, PCI_CAP_MSI)
    if cap == 0
        return None
    let ctrl: u16 = pci_dev_read_config16(dev, cap + MSI_CAP_CONTROL)
    Some(Msi { dev: dev, cap: cap, layout: msi_layout(ctrl), vector: 0, dest: IRQ_DEST_NONE, irte: MSIX_NO_IRTE })

# Point the function's single message at `vector` on the current CPU (the
# BSP during boot), or the CPU irq_route_dest picks when an MSI can't reach
# this one, and enable MSI with one message (MME = 0). With interrupt
# remapping on, the message names IRTE ir_handle_msi(vector), which holds
# the vector, the destination and the function's requester ID, as
# msix_set_entry_to does. MSI stays off while the address and data are
# rewritten. On an error MSI is left off.
pub fn msi_enable(m: Msi, vector: u8) -> Result<Msi, MsiError>
    let dev: *PciDevice = m.dev
    let ctrl_off: u8 = m.cap + MSI_CAP_CONTROL
    let ctrl: u16 = pci_dev_read_config16(dev, ctrl_off)
    pci_dev_write_config16(dev, ctrl_off, msi_ctrl_off(ctrl))
    let here: u32 = lapic_id()
    let dest: u32 = irq_route_dest(here)
    if dest == IRQ_DEST_NONE
        klog("[msix] no CPU can take MSI vector ")
        klog_dec(vector as i64)
        klog(" (APIC ID ")
        klog_dec(here as i64)
        klog(": ")
        irq_route_print_reason(here)
        klog(")\n")
        return Err(MsiError.NoCpu)
    if dest != here
        klog("[msix] MSI vector ")
        klog_dec(vector as i64)
        klog(" -> APIC ID ")
        klog_dec(dest as i64)
        klog(", not this CPU's ")
        klog_dec(here as i64)
        klog(": ")
        irq_route_print_reason(here)
        klog("\n")
    # Fixed delivery, edge-triggered: data is just the vector.
    var addr: u32 = msi_addr_lo(dest)
    var data: u32 = vector as u32
    var irte: u32 = MSIX_NO_IRTE
    if ir_enabled()
        let handle: u32 = ir_handle_msi(vector)
        if ir_set(handle, vector, dest, false, pci_dev_sid(dev)) != 0
            klog("[msix] MSI vector ")
            klog_dec(vector as i64)
            klog(": IRTE not set; MSI left off\n")
            return Err(MsiError.Irte)
        addr = ir_msi_addr(handle)
        data = ir_msi_data(handle)
        irte = handle
    pci_dev_write_config32(dev, m.cap + MSI_CAP_ADDR_LO, addr)
    if m.layout.is64
        pci_dev_write_config32(dev, m.cap + MSI_CAP_ADDR_HI, 0)
    pci_dev_write_config16(dev, m.cap + m.layout.data, (data & 0xFFFF) as u16)
    # Per-vector masking: unmask message 0, the only one enabled.
    if m.layout.mask != 0
        let bits: u32 = pci_dev_read_config32(dev, m.cap + m.layout.mask)
        pci_dev_write_config32(dev, m.cap + m.layout.mask, bits & 0xFFFFFFFE)
    pci_dev_write_config16(dev, ctrl_off, msi_ctrl_one(ctrl))
    Ok(Msi { dev: dev, cap: m.cap, layout: m.layout, vector: vector, dest: dest, irte: irte })

# ============================================================================
# Interrupt accounting
# ============================================================================

# Called by irq_handler for every hardware vector. Counts the interrupt and
# returns true if `vector` is an MSI-X vector (the caller still sends EOI).
# A vector bound to an IRQ object (proc/waitset.ritz, #4719) also latches
# that object and wakes its owner's DrvIrqWait, and no other wait set.
pub fn msix_dispatch(vector: u64) -> bool
    if vector >= MSIX_VECTOR_BASE as u64 and vector < (MSIX_VECTOR_BASE + MSIX_VECTOR_COUNT) as u64
        let slot: u64 = vector - (MSIX_VECTOR_BASE as u64)
        msix_irq_count[slot as i32] = msix_irq_count[slot as i32] + 1
        irq_object_fire_vector(vector)
        return true
    if vector >= MSIX_LOCAL_VECTOR_BASE as u64 and vector < (MSIX_LOCAL_VECTOR_BASE + MSIX_LOCAL_VECTOR_COUNT) as u64
        let slot: u64 = vector - (MSIX_LOCAL_VECTOR_BASE as u64)
        msix_local_irq_count[slot as i32] = msix_local_irq_count[slot as i32] + 1
        return true
    return false

# Interrupts delivered on `vector` so far (0 for a vector that isn't MSI-X).
pub fn msix_vector_count(vector: u8) -> u64
    if vector >= MSIX_VECTOR_BASE and vector < MSIX_VECTOR_BASE + MSIX_VECTOR_COUNT
        return volatile_load(@msix_irq_count[(vector - MSIX_VECTOR_BASE) as i32])
    if vector >= MSIX_LOCAL_VECTOR_BASE and vector < MSIX_LOCAL_VECTOR_BASE + MSIX_LOCAL_VECTOR_COUNT
        return volatile_load(@msix_local_irq_count[(vector - MSIX_LOCAL_VECTOR_BASE) as i32])
    return 0

# ============================================================================
# Diagnostics
# ============================================================================

# Log every PCI device's MSI-X table:
#   [msix] BB:DD.FF VVVV:DDDD: N vectors, table BARn+0xOFFSET (hex)
pub fn msix_print_all()
    var found: i32 = 0
    var i: i32 = 0
    while i < pci_get_device_count()
        let dev: *PciDevice = pci_get_device(i)
        var info: MsixInfo
        if msix_probe(dev, @info) == 0
            klog("[msix] ")
            if (*dev).segment != 0
                klog_hex_width((*dev).segment as u64, 4)
                klog(":")
            klog_hex_width((*dev).bus as u64, 2)
            klog(":")
            klog_hex_width((*dev).device as u64, 2)
            klog(".")
            klog_hex_width((*dev).function as u64, 2)
            klog(" ")
            klog_hex_width((*dev).vendor_id as u64, 4)
            klog(":")
            klog_hex_width((*dev).device_id as u64, 4)
            klog(": ")
            klog_dec(info.table_size as i64)
            klog(" vectors, table BAR")
            klog_dec(info.table_bar as i64)
            klog("+0x")
            klog_hex(info.table_offset as u64)
            klog("\n")
            found = found + 1
        i = i + 1
    klog("[msix] ")
    klog_dec(found as i64)
    klog(" PCI devices with MSI-X\n")

# The device's requester ID: segment << 16 | bus << 8 | device << 3 |
# function (AGAST #4582). AMD-Vi picks the segment's device table by it
# (#4339); VT-d compares the low 16 bits.
fn msix_sid(info: *MsixInfo) -> u32
    return pci_dev_sid((*info).dev)

# The IRT handle table entry `entry` sends through, read back from the
# device's table: MSIX_NO_IRTE if the entry names none (no interrupt
# remapping) or is out of range.
pub const MSIX_NO_IRTE: u32 = 0xFFFFFFFF          # = IR_NO_HANDLE

pub fn msix_entry_irte(info: *MsixInfo, entry: u16) -> u32
    if (*info).table_virt == 0 or entry >= (*info).table_size
        return MSIX_NO_IRTE
    let e: u64 = (*info).table_virt + (entry as u64) * MSIX_ENTRY_SIZE
    return ir_msi_handle(volatile_load((e + MSIX_ENTRY_ADDR_LO) as *u32), volatile_load((e + MSIX_ENTRY_DATA) as *u32))

# The APIC ID table entry `entry` reaches, read back: from its IRTE when
# remapped, else from the address itself.
pub fn msix_entry_dest(info: *MsixInfo, entry: u16) -> u32
    let handle: u32 = msix_entry_irte(info, entry)
    if handle != MSIX_NO_IRTE
        return ir_get_dest(handle, msix_sid(info))
    if (*info).table_virt == 0 or entry >= (*info).table_size
        return IRQ_DEST_NONE
    return msi_addr_dest(volatile_load(((*info).table_virt + (entry as u64) * MSIX_ENTRY_SIZE + MSIX_ENTRY_ADDR_LO) as *u32))
