# Harland PCI Driver
#
# PCI bus enumeration and configuration space access.
# Segment 0 is enumerated early over I/O ports 0xCF8 (CONFIG_ADDRESS) and
# 0xCFC (CONFIG_DATA). Once ACPI is up, pci_init_segments parses the MCFG,
# switches config access to ECAM (checked against port I/O on segment 0) and
# enumerates segments 1+, which port I/O can't reach (AGAST #4582). Without
# an MCFG, port I/O stays the only access and segment 0 the only segment.

# Import from parent directory - Ritz should resolve relative to source dirs
# Note: This is kernel/src/io.ritz and kernel/src/serial.ritz
import klog { klog, klog_dec, klog_hex, klog_hex_width }
import io { outl, inl }
import mm.vmm { vmm_map_mmio, vmm_ensure_mapped }
import drivers.pci_ecam { mcfg_parse, mcfg_count, mcfg_seg, mcfg_base, mcfg_bus_start, mcfg_bus_end, mcfg_find, ecam_bus_phys, pci_sid, pci_bus_mark, pci_bus_unreached }

# ============================================================================
# PCI Configuration Space Constants
# ============================================================================

const PCI_CONFIG_ADDRESS: u16 = 0xCF8
const PCI_CONFIG_DATA: u16 = 0xCFC

# PCI header type masks
const PCI_HEADER_TYPE_MASK: u8 = 0x7F
const PCI_HEADER_MULTIFUNCTION: u8 = 0x80

# PCI header types
const PCI_HEADER_TYPE_DEVICE: u8 = 0x00
const PCI_HEADER_TYPE_BRIDGE: u8 = 0x01
const PCI_HEADER_TYPE_CARDBUS: u8 = 0x02

# PCI class codes
pub const PCI_CLASS_UNCLASSIFIED: u8 = 0x00
pub const PCI_CLASS_STORAGE: u8 = 0x01
pub const PCI_CLASS_NETWORK: u8 = 0x02
pub const PCI_CLASS_DISPLAY: u8 = 0x03
pub const PCI_CLASS_MULTIMEDIA: u8 = 0x04
pub const PCI_CLASS_MEMORY: u8 = 0x05
pub const PCI_CLASS_BRIDGE: u8 = 0x06
pub const PCI_CLASS_SIMPLE_COMM: u8 = 0x07
pub const PCI_CLASS_BASE_PERIPHERAL: u8 = 0x08
pub const PCI_CLASS_INPUT: u8 = 0x09
pub const PCI_CLASS_DOCKING: u8 = 0x0A
pub const PCI_CLASS_PROCESSOR: u8 = 0x0B
pub const PCI_CLASS_SERIAL_BUS: u8 = 0x0C
pub const PCI_CLASS_WIRELESS: u8 = 0x0D
pub const PCI_CLASS_INTELLIGENT: u8 = 0x0E
pub const PCI_CLASS_SATELLITE: u8 = 0x0F
pub const PCI_CLASS_ENCRYPTION: u8 = 0x10
pub const PCI_CLASS_SIGNAL_PROC: u8 = 0x11

# Well-known vendor IDs
pub const PCI_VENDOR_INVALID: u16 = 0xFFFF
pub const PCI_VENDOR_INTEL: u16 = 0x8086
pub const PCI_VENDOR_QEMU: u16 = 0x1234
pub const PCI_VENDOR_REDHAT: u16 = 0x1AF4   # VirtIO devices
pub const PCI_VENDOR_AMAZON: u16 = 0x1D0F   # Amazon ENA devices

# VirtIO device IDs (when vendor is 0x1AF4)
pub const VIRTIO_DEVICE_NET: u16 = 0x1000
pub const VIRTIO_DEVICE_BLOCK: u16 = 0x1001
pub const VIRTIO_DEVICE_CONSOLE: u16 = 0x1003
pub const VIRTIO_DEVICE_RNG: u16 = 0x1005
pub const VIRTIO_DEVICE_GPU: u16 = 0x1050
pub const VIRTIO_DEVICE_INPUT: u16 = 0x1052

# Amazon ENA device IDs (when vendor is 0x1D0F)
pub const ENA_DEVICE_PF: u16 = 0x0EC2       # ENA Physical Function
pub const ENA_DEVICE_LLQ_PF: u16 = 0x1EC2   # ENA Low Latency Queue PF
pub const ENA_DEVICE_VF: u16 = 0xEC20       # ENA Virtual Function (EC2)
pub const ENA_DEVICE_LLQ_VF: u16 = 0xEC21   # ENA Low Latency Queue VF
pub const ENA_DEVICE_RESRV0: u16 = 0x0051   # Reserved

# BAR type masks
const PCI_BAR_TYPE_MASK: u32 = 0x01
const PCI_BAR_TYPE_MEMORY: u32 = 0x00
const PCI_BAR_TYPE_IO: u32 = 0x01
const PCI_BAR_MEMORY_TYPE_MASK: u32 = 0x06
const PCI_BAR_MEMORY_32BIT: u32 = 0x00
const PCI_BAR_MEMORY_64BIT: u32 = 0x04
const PCI_BAR_MEMORY_PREFETCH: u32 = 0x08

# PCI configuration space register offsets
const PCI_REG_VENDOR_ID: u8 = 0x00
const PCI_REG_DEVICE_ID: u8 = 0x02
const PCI_REG_COMMAND: u8 = 0x04
const PCI_REG_STATUS: u8 = 0x06
const PCI_REG_REVISION: u8 = 0x08
const PCI_REG_PROG_IF: u8 = 0x09
const PCI_REG_SUBCLASS: u8 = 0x0A
const PCI_REG_CLASS: u8 = 0x0B
const PCI_REG_CACHE_LINE: u8 = 0x0C
const PCI_REG_LATENCY: u8 = 0x0D
const PCI_REG_HEADER_TYPE: u8 = 0x0E
const PCI_REG_BIST: u8 = 0x0F
const PCI_REG_BAR0: u8 = 0x10
const PCI_REG_BAR1: u8 = 0x14
const PCI_REG_BAR2: u8 = 0x18
const PCI_REG_BAR3: u8 = 0x1C
const PCI_REG_BAR4: u8 = 0x20
const PCI_REG_BAR5: u8 = 0x24
const PCI_REG_SUBSYSTEM_VENDOR: u8 = 0x2C
const PCI_REG_SUBSYSTEM_ID: u8 = 0x2E
const PCI_REG_CAP_PTR: u8 = 0x34      # Capabilities pointer
const PCI_REG_INTERRUPT_LINE: u8 = 0x3C
const PCI_REG_INTERRUPT_PIN: u8 = 0x3D

# PCI command register bits
pub const PCI_CMD_IO_SPACE: u16 = 0x0001
pub const PCI_CMD_MEMORY_SPACE: u16 = 0x0002
pub const PCI_CMD_BUS_MASTER: u16 = 0x0004
pub const PCI_CMD_INTERRUPT_DISABLE: u16 = 0x0400

# PCI status register bits
pub const PCI_STATUS_CAP_LIST: u16 = 0x0010   # Device has capabilities list

# PCI capability IDs
pub const PCI_CAP_VENDOR: u8 = 0x09           # Vendor-specific capability

# ============================================================================
# PCI Device Structure
# ============================================================================

pub struct PciDevice
    segment: u16          # PCI segment (MCFG); 0 on machines without one
    bus: u8
    device: u8
    function: u8
    vendor_id: u16
    device_id: u16
    class_code: u8
    subclass: u8
    prog_if: u8
    revision: u8
    header_type: u8
    interrupt_line: u8
    interrupt_pin: u8
    bar: [6]u64           # Base Address Registers (decoded)
    bar_size: [6]u64      # Size of each BAR region
    bar_is_io: [6]u8      # 1 if I/O space, 0 if memory space
    bar_is_64bit: [6]u8   # 1 if 64-bit BAR (uses next slot too)

# Functions we can track, over every segment (AGAST #4599): a two-socket
# EPYC lists a few hundred. Functions past the table are counted, not kept,
# and pci_init_segments logs how many.
const PCI_MAX_DEVICES: i32 = 256
var pci_devices: [256]PciDevice
var pci_device_count: i32 = 0
var pci_devices_dropped: i32 = 0

# ============================================================================
# PCI Configuration Space Access
# ============================================================================

fn pci_config_address(bus: u8, device: u8, func: u8, offset: u8) -> u32
    var addr: u32 = 0x80000000
    addr = addr | ((bus as u32) << 16)
    addr = addr | ((device as u32) << 11)
    addr = addr | ((func as u32) << 8)
    addr = addr | ((offset as u32) & 0xFC)
    return addr

# ECAM (AGAST #4582): on once pci_init_segments has parsed the MCFG and found
# segment 0's ECAM agrees with port I/O. Each bus's 1 MiB is mapped the first
# time it is reached, not a whole segment's 256 MiB up front; slot
# entry * 256 + bus holds its kernel virtual address (0 = not yet mapped).
var pci_ecam_on: bool = false
var pci_ecam_bus_virt: [2048]u64       # PCI_MCFG_MAX * 256

# Kernel virtual address of register `reg` of seg/bus:dev.func through ECAM,
# or 0 if no MCFG entry decodes that bus or it can't be mapped.
fn pci_ecam_virt(seg: u32, bus: u32, dev: u32, func: u32, reg: u32) -> u64
    let i: i32 = mcfg_find(seg, bus)
    if i < 0
        return 0
    let slot: i32 = i * 256 + (bus & 0xFF) as i32
    if pci_ecam_bus_virt[slot] == 0
        pci_ecam_bus_virt[slot] = vmm_map_mmio(ecam_bus_phys(seg, bus), 0x100000)
        if pci_ecam_bus_virt[slot] == 0
            return 0
    return pci_ecam_bus_virt[slot] + (((dev & 0x1F) as u64) << 15) + (((func & 0x7) as u64) << 12) + ((reg & 0xFFC) as u64)

# Config dword at `offset` of seg/bus:dev.func: through ECAM where the MCFG
# covers the bus, else port I/O, which reaches segment 0 only. A segment
# nothing reaches reads as all ones (no device).
pub fn pci_seg_read_config32(seg: u16, bus: u8, device: u8, func: u8, offset: u8) -> u32
    if pci_ecam_on
        let va: u64 = pci_ecam_virt(seg as u32, bus as u32, device as u32, func as u32, offset as u32)
        if va != 0
            return volatile_load(va as *u32)
    if seg == 0
        outl(PCI_CONFIG_ADDRESS, pci_config_address(bus, device, func, offset))
        return inl(PCI_CONFIG_DATA)
    return 0xFFFFFFFF

pub fn pci_seg_write_config32(seg: u16, bus: u8, device: u8, func: u8, offset: u8, value: u32)
    if pci_ecam_on
        let va: u64 = pci_ecam_virt(seg as u32, bus as u32, device as u32, func as u32, offset as u32)
        if va != 0
            volatile_store(va as *u32, value)
            return
    if seg == 0
        outl(PCI_CONFIG_ADDRESS, pci_config_address(bus, device, func, offset))
        outl(PCI_CONFIG_DATA, value)

pub fn pci_seg_read_config16(seg: u16, bus: u8, device: u8, func: u8, offset: u8) -> u16
    let data: u32 = pci_seg_read_config32(seg, bus, device, func, offset & 0xFC)
    let shift: u32 = ((offset & 0x02) * 8) as u32
    return ((data >> shift) & 0xFFFF) as u16

pub fn pci_seg_read_config8(seg: u16, bus: u8, device: u8, func: u8, offset: u8) -> u8
    let data: u32 = pci_seg_read_config32(seg, bus, device, func, offset & 0xFC)
    let shift: u32 = ((offset & 0x03) * 8) as u32
    return ((data >> shift) & 0xFF) as u8

pub fn pci_seg_write_config16(seg: u16, bus: u8, device: u8, func: u8, offset: u8, value: u16)
    let data: u32 = pci_seg_read_config32(seg, bus, device, func, offset & 0xFC)
    let shift: u32 = ((offset & 0x02) * 8) as u32
    let mask: u32 = 0xFFFF << shift
    let new_data: u32 = (data & (0xFFFFFFFF ^ mask)) | ((value as u32) << shift)
    pci_seg_write_config32(seg, bus, device, func, offset & 0xFC, new_data)

pub fn pci_seg_write_config8(seg: u16, bus: u8, device: u8, func: u8, offset: u8, value: u8)
    let data: u32 = pci_seg_read_config32(seg, bus, device, func, offset & 0xFC)
    let shift: u32 = ((offset & 0x03) * 8) as u32
    let mask: u32 = 0xFF << shift
    let new_data: u32 = (data & (0xFFFFFFFF ^ mask)) | ((value as u32) << shift)
    pci_seg_write_config32(seg, bus, device, func, offset & 0xFC, new_data)

# Segment 0 by bus/device/function. Drivers use the pci_dev_* forms below,
# which follow the device's segment.
pub fn pci_read_config32(bus: u8, device: u8, func: u8, offset: u8) -> u32
    return pci_seg_read_config32(0, bus, device, func, offset)

pub fn pci_read_config16(bus: u8, device: u8, func: u8, offset: u8) -> u16
    return pci_seg_read_config16(0, bus, device, func, offset)

pub fn pci_read_config8(bus: u8, device: u8, func: u8, offset: u8) -> u8
    return pci_seg_read_config8(0, bus, device, func, offset)

pub fn pci_write_config32(bus: u8, device: u8, func: u8, offset: u8, value: u32)
    pci_seg_write_config32(0, bus, device, func, offset, value)

pub fn pci_write_config16(bus: u8, device: u8, func: u8, offset: u8, value: u16)
    pci_seg_write_config16(0, bus, device, func, offset, value)

pub fn pci_write_config8(bus: u8, device: u8, func: u8, offset: u8, value: u8)
    pci_seg_write_config8(0, bus, device, func, offset, value)

# A device's own config space, in its segment.
pub fn pci_dev_read_config32(dev: *PciDevice, offset: u8) -> u32
    return pci_seg_read_config32((*dev).segment, (*dev).bus, (*dev).device, (*dev).function, offset)

pub fn pci_dev_read_config16(dev: *PciDevice, offset: u8) -> u16
    return pci_seg_read_config16((*dev).segment, (*dev).bus, (*dev).device, (*dev).function, offset)

pub fn pci_dev_read_config8(dev: *PciDevice, offset: u8) -> u8
    return pci_seg_read_config8((*dev).segment, (*dev).bus, (*dev).device, (*dev).function, offset)

pub fn pci_dev_write_config32(dev: *PciDevice, offset: u8, value: u32)
    pci_seg_write_config32((*dev).segment, (*dev).bus, (*dev).device, (*dev).function, offset, value)

pub fn pci_dev_write_config16(dev: *PciDevice, offset: u8, value: u16)
    pci_seg_write_config16((*dev).segment, (*dev).bus, (*dev).device, (*dev).function, offset, value)

# The device's requester ID: segment << 16 | bus << 8 | device << 3 | function
# (the IOMMU's device table / source-ID key).
pub fn pci_dev_sid(dev: *PciDevice) -> u32
    return pci_sid((*dev).segment as u32, (*dev).bus as u32, (*dev).device as u32, (*dev).function as u32)

# ============================================================================
# PCI Capability Walking
# ============================================================================

# Find a PCI capability by ID
# Returns capability offset or 0 if not found
pub fn pci_find_capability(dev: *PciDevice, cap_id: u8) -> u8
    # Check if device has capabilities
    let status: u16 = pci_dev_read_config16(dev, PCI_REG_STATUS)
    if (status & PCI_STATUS_CAP_LIST) == 0
        return 0

    # Get capabilities pointer (offset 0x34)
    var cap_ptr: u8 = pci_dev_read_config8(dev, PCI_REG_CAP_PTR)
    cap_ptr = cap_ptr & 0xFC  # Align to dword

    # Walk capability list (max 48 iterations to prevent infinite loops)
    var iterations: i32 = 0
    while cap_ptr != 0 and iterations < 48
        let id: u8 = pci_dev_read_config8(dev, cap_ptr)
        if id == cap_id
            return cap_ptr
        # Next capability is at offset+1
        cap_ptr = pci_dev_read_config8(dev, cap_ptr + 1)
        cap_ptr = cap_ptr & 0xFC
        iterations = iterations + 1

    return 0

# Find the Nth capability with a given ID
# Returns capability offset or 0 if not found
pub fn pci_find_capability_nth(dev: *PciDevice, cap_id: u8, n: i32) -> u8
    # Check if device has capabilities
    let status: u16 = pci_dev_read_config16(dev, PCI_REG_STATUS)
    if (status & PCI_STATUS_CAP_LIST) == 0
        return 0

    # Get capabilities pointer
    var cap_ptr: u8 = pci_dev_read_config8(dev, PCI_REG_CAP_PTR)
    cap_ptr = cap_ptr & 0xFC

    # Walk capability list
    var found: i32 = 0
    var iterations: i32 = 0
    while cap_ptr != 0 and iterations < 48
        let id: u8 = pci_dev_read_config8(dev, cap_ptr)
        if id == cap_id
            if found == n
                return cap_ptr
            found = found + 1
        cap_ptr = pci_dev_read_config8(dev, cap_ptr + 1)
        cap_ptr = cap_ptr & 0xFC
        iterations = iterations + 1

    return 0

# ============================================================================
# PCI BAR Parsing
# ============================================================================

fn pci_decode_bar(seg: u16, bus: u8, device: u8, func: u8, bar_index: u8, dev: *PciDevice) -> u64
    let offset: u8 = PCI_REG_BAR0 + (bar_index * 4)
    let bar_val: u32 = pci_seg_read_config32(seg, bus, device, func, offset)

    if (bar_val & PCI_BAR_TYPE_MASK) == PCI_BAR_TYPE_IO
        (*dev).bar_is_io[bar_index as i32] = 1
        (*dev).bar_is_64bit[bar_index as i32] = 0

        pci_seg_write_config32(seg, bus, device, func, offset, 0xFFFFFFFF)
        let size_read: u32 = pci_seg_read_config32(seg, bus, device, func, offset)
        pci_seg_write_config32(seg, bus, device, func, offset, bar_val)

        let size_mask: u32 = size_read & 0xFFFFFFFC
        if size_mask == 0
            (*dev).bar_size[bar_index as i32] = 0
            (*dev).bar[bar_index as i32] = 0
            return 0

        let size: u64 = ((0xFFFFFFFF ^ size_mask) + 1) as u64
        (*dev).bar_size[bar_index as i32] = size
        (*dev).bar[bar_index as i32] = (bar_val & 0xFFFFFFFC) as u64
        return (*dev).bar[bar_index as i32]
    else
        (*dev).bar_is_io[bar_index as i32] = 0
        let mem_type: u32 = (bar_val & PCI_BAR_MEMORY_TYPE_MASK) >> 1

        if mem_type == 2
            (*dev).bar_is_64bit[bar_index as i32] = 1
            let bar_high: u32 = pci_seg_read_config32(seg, bus, device, func, offset + 4)
            let base_addr: u64 = ((bar_high as u64) << 32) | ((bar_val & 0xFFFFFFF0) as u64)

            pci_seg_write_config32(seg, bus, device, func, offset, 0xFFFFFFFF)
            pci_seg_write_config32(seg, bus, device, func, offset + 4, 0xFFFFFFFF)
            let size_low: u32 = pci_seg_read_config32(seg, bus, device, func, offset)
            let size_high: u32 = pci_seg_read_config32(seg, bus, device, func, offset + 4)
            pci_seg_write_config32(seg, bus, device, func, offset, bar_val)
            pci_seg_write_config32(seg, bus, device, func, offset + 4, bar_high)

            let size_val: u64 = ((size_high as u64) << 32) | ((size_low & 0xFFFFFFF0) as u64)
            if size_val == 0
                (*dev).bar_size[bar_index as i32] = 0
                (*dev).bar[bar_index as i32] = 0
                return 0

            let size: u64 = (0xFFFFFFFFFFFFFFFF ^ size_val) + 1
            (*dev).bar_size[bar_index as i32] = size
            (*dev).bar[bar_index as i32] = base_addr
            return base_addr
        else
            (*dev).bar_is_64bit[bar_index as i32] = 0

            pci_seg_write_config32(seg, bus, device, func, offset, 0xFFFFFFFF)
            let size_read: u32 = pci_seg_read_config32(seg, bus, device, func, offset)
            pci_seg_write_config32(seg, bus, device, func, offset, bar_val)

            let size_mask: u32 = size_read & 0xFFFFFFF0
            if size_mask == 0
                (*dev).bar_size[bar_index as i32] = 0
                (*dev).bar[bar_index as i32] = 0
                return 0

            let size: u64 = ((0xFFFFFFFF ^ size_mask) + 1) as u64
            (*dev).bar_size[bar_index as i32] = size
            (*dev).bar[bar_index as i32] = (bar_val & 0xFFFFFFF0) as u64
            return (*dev).bar[bar_index as i32]

# ============================================================================
# PCI Device Enumeration
# ============================================================================

fn pci_device_exists(seg: u16, bus: u8, device: u8, func: u8) -> bool
    let vendor: u16 = pci_seg_read_config16(seg, bus, device, func, PCI_REG_VENDOR_ID)
    return vendor != PCI_VENDOR_INVALID

fn pci_probe_function(seg: u16, bus: u8, device: u8, func: u8) -> bool
    if not pci_device_exists(seg, bus, device, func)
        return false

    if pci_device_count >= PCI_MAX_DEVICES
        pci_devices_dropped = pci_devices_dropped + 1
        return false

    var dev: PciDevice
    dev.segment = seg
    dev.bus = bus
    dev.device = device
    dev.function = func
    dev.vendor_id = pci_seg_read_config16(seg, bus, device, func, PCI_REG_VENDOR_ID)
    dev.device_id = pci_seg_read_config16(seg, bus, device, func, PCI_REG_DEVICE_ID)
    dev.class_code = pci_seg_read_config8(seg, bus, device, func, PCI_REG_CLASS)
    dev.subclass = pci_seg_read_config8(seg, bus, device, func, PCI_REG_SUBCLASS)
    dev.prog_if = pci_seg_read_config8(seg, bus, device, func, PCI_REG_PROG_IF)
    dev.revision = pci_seg_read_config8(seg, bus, device, func, PCI_REG_REVISION)
    dev.header_type = pci_seg_read_config8(seg, bus, device, func, PCI_REG_HEADER_TYPE) & PCI_HEADER_TYPE_MASK
    dev.interrupt_line = pci_seg_read_config8(seg, bus, device, func, PCI_REG_INTERRUPT_LINE)
    dev.interrupt_pin = pci_seg_read_config8(seg, bus, device, func, PCI_REG_INTERRUPT_PIN)

    var i: i32 = 0
    while i < 6
        dev.bar[i] = 0
        dev.bar_size[i] = 0
        dev.bar_is_io[i] = 0
        dev.bar_is_64bit[i] = 0
        i = i + 1

    if dev.header_type == PCI_HEADER_TYPE_DEVICE
        var bar_idx: u8 = 0
        while bar_idx < 6
            pci_decode_bar(seg, bus, device, func, bar_idx, @dev)
            if dev.bar_is_64bit[bar_idx as i32] != 0
                bar_idx = bar_idx + 1
            bar_idx = bar_idx + 1

    pci_devices[pci_device_count] = dev
    pci_device_count = pci_device_count + 1
    return true

fn pci_probe_device(seg: u16, bus: u8, device: u8)
    if not pci_device_exists(seg, bus, device, 0)
        return

    pci_probe_function(seg, bus, device, 0)

    let header_type: u8 = pci_seg_read_config8(seg, bus, device, 0, PCI_REG_HEADER_TYPE)
    if (header_type & PCI_HEADER_MULTIFUNCTION) != 0
        var func: u8 = 1
        while func < 8
            pci_probe_function(seg, bus, device, func)
            func = func + 1

fn pci_scan_bus(seg: u16, bus: u8)
    var device: u8 = 0
    while device < 32
        pci_probe_device(seg, bus, device)
        device = device + 1

# Scan the secondary bus of every PCI-to-PCI bridge from device `from` on,
# in the bridge's segment; bridges found there are reached in turn.
fn pci_scan_bridges(from: i32)
    var i: i32 = from
    while i < pci_device_count
        let dev: *PciDevice = @pci_devices[i]
        if (*dev).class_code == PCI_CLASS_BRIDGE and (*dev).subclass == 0x04
            let secondary_bus: u8 = pci_dev_read_config8(dev, 0x19)
            if secondary_bus != 0
                pci_scan_bus((*dev).segment, secondary_bus)
        i = i + 1

# ============================================================================
# Public API
# ============================================================================

# Mark reached (pci_bus_reached) the bus of every device from `from` on and
# the secondary..subordinate range of every bridge among them: buses the
# bridge walk has scanned or that sit behind a bridge, so not root buses.
fn pci_mark_reached(from: i32)
    var i: i32 = from
    while i < pci_device_count
        let dev: *PciDevice = @pci_devices[i]
        pci_bus_mark((*dev).segment as u32, (*dev).bus as u32, (*dev).bus as u32)
        if (*dev).class_code == PCI_CLASS_BRIDGE and (*dev).subclass == 0x04
            let secondary: u8 = pci_dev_read_config8(dev, 0x19)
            let subordinate: u8 = pci_dev_read_config8(dev, 0x1A)
            if secondary != 0
                pci_bus_mark((*dev).segment as u32, secondary as u32, subordinate as u32)
        i = i + 1

# Whether any device answers on seg/bus (function 0 of each slot: a device
# without function 0 has none). Segment 0 asks over port I/O, which reaches
# every bus; other segments map only function 0's 4 KiB of each slot, not
# the bus's 1 MiB, since most candidate buses are empty.
fn pci_bus_has_device(seg: u16, bus: u8) -> bool
    let phys: u64 = ecam_bus_phys(seg as u32, bus as u32)
    var slot: u32 = 0
    while slot < 32
        var id: u32 = 0xFFFFFFFF
        if seg == 0
            outl(PCI_CONFIG_ADDRESS, pci_config_address(bus, slot as u8, 0, 0))
            id = inl(PCI_CONFIG_DATA)
        else if phys != 0
            let va: u64 = vmm_map_mmio(phys + ((slot as u64) << 15), 0x1000)
            if va != 0
                id = volatile_load(va as *u32)
        if (id & 0xFFFF) != 0xFFFF
            return true
        slot = slot + 1
    return false

# Root buses no bridge leads to (AGAST #4599): other host bridges in a
# segment (an EPYC root complex per quadrant, QEMU pxb-pcie) and every
# segment past 0. harland parses no AML, so instead of the PNP0A03/PNP0A08
# _BBN it probes each MCFG bus nothing has reached, lowest first, and scans
# the ones that answer with their bridges. A root's own buses lie above it,
# so they are marked before the walk gets to them. Returns how many root
# buses were found.
fn pci_scan_roots() -> i32
    var roots: i32 = 0
    var i: i32 = 0
    while i < mcfg_count
        let seg: u16 = mcfg_seg[i]
        var b: i32 = pci_bus_unreached(i, 0)
        while b >= 0
            pci_bus_mark(seg as u32, b as u32, b as u32)
            if pci_bus_has_device(seg, b as u8)
                let from: i32 = pci_device_count
                pci_scan_bus(seg, b as u8)
                pci_scan_bridges(from)
                pci_mark_reached(from)
                roots = roots + 1
                klog("[pci] root bus ")
                klog_hex_width(seg as u64, 4)
                klog(":")
                klog_hex_width(b as u64, 2)
                klog(": ")
                klog_dec((pci_device_count - from) as i64)
                klog(" functions\n")
            b = pci_bus_unreached(i, (b + 1) as u32)
        i = i + 1
    return roots

# Functions the table had no room for, if any.
fn pci_log_dropped()
    if pci_devices_dropped > 0
        klog("[pci] device table full: ")
        klog_dec(pci_devices_dropped as i64)
        klog(" functions not recorded\n")

pub fn pci_init() -> i32
    pci_device_count = 0
    pci_devices_dropped = 0
    pci_scan_bus(0, 0)
    pci_scan_bridges(0)
    pci_log_dropped()
    return pci_device_count

# Every function pci_init found on segment 0 reads the same vendor/device
# dword through ECAM as through port I/O (for buses the MCFG covers). False
# on the first mismatch: then the MCFG can't be trusted.
fn pci_ecam_check() -> bool
    var compared: i32 = 0
    var i: i32 = 0
    while i < pci_device_count
        let dev: *PciDevice = @pci_devices[i]
        if (*dev).segment == 0 and mcfg_find(0, (*dev).bus as u32) >= 0
            let va: u64 = pci_ecam_virt(0, (*dev).bus as u32, (*dev).device as u32, (*dev).function as u32, 0)
            outl(PCI_CONFIG_ADDRESS, pci_config_address((*dev).bus, (*dev).device, (*dev).function, 0))
            let port: u32 = inl(PCI_CONFIG_DATA)
            if va == 0 or volatile_load(va as *u32) != port
                klog("[pci] ECAM disagrees with port I/O at ")
                klog_hex_width((*dev).bus as u64, 2)
                klog(":")
                klog_hex_width((*dev).device as u64, 2)
                klog(".")
                klog_hex_width((*dev).function as u64, 2)
                klog(": ECAM off\n")
                return false
            compared = compared + 1
        i = i + 1
    klog("[pci] ECAM matches port I/O on segment 0 (")
    klog_dec(compared as i64)
    klog(" functions)\n")
    return true

# After ACPI init: parse the MCFG at `mcfg_addr` (0 = none), turn ECAM on if
# it agrees with port I/O on segment 0, and enumerate every root bus the
# bridge walk from bus 0 missed (pci_scan_roots): other host bridges on
# segment 0 and every other segment. Returns the number of devices found.
pub fn pci_init_segments(mcfg_addr: u64) -> i32
    if mcfg_addr == 0
        klog("[pci] no MCFG: segment 0 only, port I/O\n")
        return 0
    let len: u32 = *((mcfg_addr + 4) as *u32)
    if vmm_ensure_mapped(mcfg_addr, len as u64) != 0 or mcfg_parse(mcfg_addr as *u8, len) <= 0
        klog("[pci] MCFG unusable: segment 0 only, port I/O\n")
        return 0
    var i: i32 = 0
    while i < mcfg_count
        klog("[pci] MCFG segment ")
        klog_hex_width(mcfg_seg[i] as u64, 4)
        klog(" buses ")
        klog_hex_width(mcfg_bus_start[i] as u64, 2)
        klog("-")
        klog_hex_width(mcfg_bus_end[i] as u64, 2)
        klog(" ECAM ")
        klog_hex(mcfg_base[i] as u64)
        klog("\n")
        i = i + 1
    pci_ecam_on = true
    if not pci_ecam_check()
        pci_ecam_on = false
        return 0
    let before: i32 = pci_device_count
    pci_mark_reached(0)
    pci_scan_roots()
    pci_log_dropped()
    return pci_device_count - before

pub fn pci_find_device(vendor_id: u16, device_id: u16) -> *PciDevice
    var i: i32 = 0
    while i < pci_device_count
        if pci_devices[i].vendor_id == vendor_id and pci_devices[i].device_id == device_id
            return @pci_devices[i]
        i = i + 1
    return 0 as *PciDevice

pub fn pci_find_by_class(class_code: u8, subclass: u8) -> *PciDevice
    var i: i32 = 0
    while i < pci_device_count
        if pci_devices[i].class_code == class_code and pci_devices[i].subclass == subclass
            return @pci_devices[i]
        i = i + 1
    return 0 as *PciDevice

# The modern (virtio 1.x, §4.1.2.1) PCI device ID for a virtio device ID
# constant: transitional IDs 0x1000-0x103F map to 0x1040 + virtio device type;
# IDs already in the modern range (GPU, input) map to themselves. A modern-only
# device (QEMU disable-legacy=on, most real hardware) only carries this ID.
pub fn pci_virtio_modern_id(virtio_device_id: u16) -> u16
    if virtio_device_id == VIRTIO_DEVICE_NET
        return 0x1041
    if virtio_device_id == VIRTIO_DEVICE_BLOCK
        return 0x1042
    if virtio_device_id == VIRTIO_DEVICE_CONSOLE
        return 0x1043
    if virtio_device_id == VIRTIO_DEVICE_RNG
        return 0x1044
    return virtio_device_id

# Find the first VirtIO device of a given type, transitional or modern-only
pub fn pci_find_virtio(virtio_device_id: u16) -> *PciDevice
    return pci_find_virtio_nth(virtio_device_id, 0)

# Find any Amazon ENA network device
pub fn pci_find_ena() -> *PciDevice
    # Try each known ENA device ID
    var dev: *PciDevice = pci_find_device(PCI_VENDOR_AMAZON, ENA_DEVICE_VF)
    if dev != 0 as *PciDevice
        return dev
    dev = pci_find_device(PCI_VENDOR_AMAZON, ENA_DEVICE_LLQ_VF)
    if dev != 0 as *PciDevice
        return dev
    dev = pci_find_device(PCI_VENDOR_AMAZON, ENA_DEVICE_PF)
    if dev != 0 as *PciDevice
        return dev
    dev = pci_find_device(PCI_VENDOR_AMAZON, ENA_DEVICE_LLQ_PF)
    if dev != 0 as *PciDevice
        return dev
    dev = pci_find_device(PCI_VENDOR_AMAZON, ENA_DEVICE_RESRV0)
    return dev

# Find the Nth VirtIO device of a given type (0-indexed), matching both its
# transitional and its modern-only PCI device ID
pub fn pci_find_virtio_nth(virtio_device_id: u16, n: i32) -> *PciDevice
    let modern_id: u16 = pci_virtio_modern_id(virtio_device_id)
    var found: i32 = 0
    var i: i32 = 0
    while i < pci_device_count
        if pci_devices[i].vendor_id == PCI_VENDOR_REDHAT and (pci_devices[i].device_id == virtio_device_id or pci_devices[i].device_id == modern_id)
            if found == n
                return @pci_devices[i]
            found = found + 1
        i = i + 1
    return 0 as *PciDevice

pub fn pci_enable_bus_master(dev: *PciDevice)
    let cmd: u16 = pci_dev_read_config16(dev, PCI_REG_COMMAND)
    pci_dev_write_config16(dev, PCI_REG_COMMAND, cmd | PCI_CMD_BUS_MASTER)

pub fn pci_enable_memory(dev: *PciDevice)
    let cmd: u16 = pci_dev_read_config16(dev, PCI_REG_COMMAND)
    pci_dev_write_config16(dev, PCI_REG_COMMAND, cmd | PCI_CMD_MEMORY_SPACE)

pub fn pci_enable_io(dev: *PciDevice)
    let cmd: u16 = pci_dev_read_config16(dev, PCI_REG_COMMAND)
    pci_dev_write_config16(dev, PCI_REG_COMMAND, cmd | PCI_CMD_IO_SPACE)

pub fn pci_get_device_count() -> i32
    return pci_device_count

pub fn pci_get_device(index: i32) -> *PciDevice
    if index < 0 or index >= pci_device_count
        return 0 as *PciDevice
    return @pci_devices[index]

# ============================================================================
# Debug Printing
# ============================================================================

fn pci_print_class_name(class_code: u8)
    if class_code == PCI_CLASS_UNCLASSIFIED
        klog("Unclassified")
    else if class_code == PCI_CLASS_STORAGE
        klog("Storage")
    else if class_code == PCI_CLASS_NETWORK
        klog("Network")
    else if class_code == PCI_CLASS_DISPLAY
        klog("Display")
    else if class_code == PCI_CLASS_MULTIMEDIA
        klog("Multimedia")
    else if class_code == PCI_CLASS_MEMORY
        klog("Memory")
    else if class_code == PCI_CLASS_BRIDGE
        klog("Bridge")
    else if class_code == PCI_CLASS_SIMPLE_COMM
        klog("Communication")
    else if class_code == PCI_CLASS_BASE_PERIPHERAL
        klog("Peripheral")
    else if class_code == PCI_CLASS_INPUT
        klog("Input")
    else if class_code == PCI_CLASS_SERIAL_BUS
        klog("Serial Bus")
    else
        klog("Class ")
        klog_hex_width(class_code as u64, 2)

pub fn pci_print_device(dev: *PciDevice)
    klog("  ")
    if (*dev).segment != 0
        klog_hex_width((*dev).segment as u64, 4)
        klog(":")
    klog_hex_width((*dev).bus as u64, 2)
    klog(":")
    klog_hex_width((*dev).device as u64, 2)
    klog(".")
    klog_hex_width((*dev).function as u64, 2)
    klog(" ")

    klog_hex_width((*dev).vendor_id as u64, 4)
    klog(":")
    klog_hex_width((*dev).device_id as u64, 4)
    klog(" ")

    pci_print_class_name((*dev).class_code)

    if (*dev).vendor_id == PCI_VENDOR_REDHAT
        klog(" (VirtIO ")
        if (*dev).device_id == VIRTIO_DEVICE_NET
            klog("Network")
        else if (*dev).device_id == VIRTIO_DEVICE_BLOCK
            klog("Block")
        else if (*dev).device_id == VIRTIO_DEVICE_CONSOLE
            klog("Console")
        else if (*dev).device_id == VIRTIO_DEVICE_RNG
            klog("RNG")
        else if (*dev).device_id == VIRTIO_DEVICE_GPU
            klog("GPU")
        else if (*dev).device_id == VIRTIO_DEVICE_INPUT
            klog("Input")
        else
            klog_hex_width((*dev).device_id as u64, 4)
        klog(")")

    if (*dev).vendor_id == PCI_VENDOR_AMAZON
        klog(" (Amazon ENA")
        if (*dev).device_id == ENA_DEVICE_VF
            klog(" VF")
        else if (*dev).device_id == ENA_DEVICE_LLQ_VF
            klog(" LLQ VF")
        else if (*dev).device_id == ENA_DEVICE_PF
            klog(" PF")
        else if (*dev).device_id == ENA_DEVICE_LLQ_PF
            klog(" LLQ PF")
        klog(")")

    klog("\n")

    var i: i32 = 0
    while i < 6
        if (*dev).bar_size[i] > 0
            klog("    BAR")
            klog_dec(i as i64)
            klog(": ")
            if (*dev).bar_is_io[i] != 0
                klog("I/O  ")
            else
                klog("MEM  ")
            klog_hex((*dev).bar[i])
            klog(" size=")
            klog_dec((*dev).bar_size[i])
            if (*dev).bar_is_64bit[i] != 0
                klog(" (64-bit)")
            klog("\n")
        i = i + 1

pub fn pci_print_all_devices()
    klog("PCI Devices (")
    klog_dec(pci_device_count as i64)
    klog(" found):\n")

    var i: i32 = 0
    while i < pci_device_count
        pci_print_device(@pci_devices[i])
        i = i + 1
