# ritzlib platform hooks for the kernel (AGAST #1881)
#
# ritzlib's core (str, strview, span, memory, ...; AGAST #4119) reaches the
# platform only through three hooks it declares `extern fn`. A hosted program
# gets them from ritzlib.sys; a freestanding one defines them itself. The
# kernel links the core because goliath, its filesystem, uses StrView and
# Span, so it defines them here: pages from the kernel heap, and a fatal
# error is a kernel panic. (See projects/ritz/docs/STDLIB_REFERENCE.md,
# "Core and hosted".)

import klog { klog }
import serial { StrView }
import io { halt_loop }
import mm.heap { kalloc, kfree }

# `len` bytes of zeroed memory from the kernel heap (8-byte aligned), or null
pub fn ritz_platform_page_map(len: i64) -> *u8
    if len <= 0
        return 0 as *u8
    let p: *u8 = kalloc(len as u64)
    if p == 0 as *u8
        return p
    var i: i64 = 0
    while i < len
        *(p + i) = 0
        i = i + 1
    p

# Give back what one ritz_platform_page_map returned: 0, or -1
pub fn ritz_platform_page_unmap(p: *u8, len: i64) -> i32
    kfree(p)

# A ritzlib core invariant failed (a hashmap's missing key): panic
pub fn ritz_platform_fatal(msg: *u8, len: i64, status: i32)
    klog("\n*** KERNEL PANIC: ritzlib: ")
    klog(StrView { ptr: msg, len: len })
    klog(" ***\n")
    halt_loop()
