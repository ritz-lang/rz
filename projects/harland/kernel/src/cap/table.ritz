# Harland Capability System - Capability Table
#
# Each process has its own capability table that maps handles to
# kernel objects with associated rights.
#
# A table is owned by the CPU its process is on (AGAST #4881,
# docs/SMP_USER.md §2: proc/table.ritz proc_on_cpu), and only that CPU
# writes its entries. A grant into a table on another CPU is a CAP_INSERT
# request (sync/mbox.ritz): the BSP posts it and waits for CAP_INSERT_DONE,
# and the owner writes the entry at its next safe point (cap_insert_serve).
# Only the BSP waits on another CPU; every grant into another process's
# table runs there (CapGrant and the kernel's grants are not SYS_LOCAL), so
# an AP inserts only into the tables of processes on it. The process cannot
# move meanwhile: a move to the BSP has to be run there, and a move off it
# is the BSP's own, and it is busy waiting.

import klog { klog, klog_dec }
import mm.shm { shm_unmap, shm_forget_pid, shm_retire }
import driver_abi.wait { EVENT_PEER_CLOSE, EVENT_DRIVER_GONE }
import proc.waitset { shm_latch_create, shm_latch_drop, shm_latch_held, waitset_forget_pid }
import proc.table { PROC_BSP_CPU, proc_on_cpu }
import sync.mbox { MboxMsg, MBOX_CAP_INSERT, MBOX_CAP_INSERT_DONE, mbox_msg, mbox_post, mbox_wait_reply }
import arch.x86_64.cpu_map { MAX_CPUS, cpu_map_started }
# The kernel's is arch/x86_64/percpu.ritz cpu_index (SMP_USER.md §2 "The
# cpu-index hook").
extern fn cpu_index() -> i32
# syscall/runtime/driver.ritz: quiesce the device when its IRQ owner drops
# its last handle (#4733). Declared, not imported: driver.ritz imports this
# module.
extern fn driver_quiesce_object(pid: u32, object_id: u64)
import cap.types { CapHandle, CapEntry, CapInfo, CAP_TYPE_NONE, CAP_TYPE_IRQ, CAP_TYPE_SHM, CAP_TYPE_POWER, CAP_TYPE_DISPLAY, CAP_TYPE_CHANNEL, CAP_TYPE_NAMESPACE, CAP_RIGHT_ALL, cap_entry_init, cap_handle_init, cap_handle_invalid, cap_type_is_device, cap_type_is_kernel_granted }

# ============================================================================
# Constants
# ============================================================================

# Maximum capabilities per process
pub const CAP_TABLE_SIZE: u32 = 64

# Maximum number of capability tables (one per process)
const MAX_CAP_TABLES: i32 = 64

# ============================================================================
# Capability Table
# ============================================================================
#
# A per-process table of capability entries.

pub struct CapTable
    pid: u32                        # Owning process ID
    entries: [64]CapEntry           # CAP_TABLE_SIZE entries
    next_generation: u32            # For handle generation
    active_count: u32               # Number of active capabilities
    in_use: bool                    # Whether this table is allocated
    _padding: [3]u8

# ============================================================================
# Global Table Registry
# ============================================================================
#
# Maps PIDs to capability tables.

var cap_tables: [64]CapTable
var cap_tables_count: i32 = 0

# ============================================================================
# Initialization
# ============================================================================

pub fn cap_table_init()
    klog("Initializing capability tables... ")

    var i: i32 = 0
    while i < MAX_CAP_TABLES
        cap_tables[i].pid = 0
        cap_tables[i].next_generation = 1
        cap_tables[i].active_count = 0
        cap_tables[i].in_use = false

        var j: i32 = 0
        while j < 64
            cap_tables[i].entries[j] = cap_entry_init()
            j = j + 1

        i = i + 1

    cap_tables_count = 0
    klog("OK\n")

# ============================================================================
# Table Allocation
# ============================================================================

# Allocate a capability table for a new process
pub fn cap_table_alloc(pid: u32) -> *CapTable
    var i: i32 = 0
    while i < MAX_CAP_TABLES
        if not cap_tables[i].in_use
            cap_tables[i].pid = pid
            cap_tables[i].next_generation = 1
            cap_tables[i].active_count = 0
            cap_tables[i].in_use = true

            var j: i32 = 0
            while j < 64
                cap_tables[i].entries[j] = cap_entry_init()
                j = j + 1

            cap_tables_count = cap_tables_count + 1
            return @cap_tables[i]
        i = i + 1

    return 0 as *CapTable

# Free a capability table when process exits
pub fn cap_table_free(table: *CapTable) -> i32
    if table == 0 as *CapTable
        return -1

    if not (*table).in_use
        return -1

    irq_owner_release_pid((*table).pid)
    # Its shm mappings end with it; its PML4's teardown leaves their frames
    # to the objects (#4717)
    shm_forget_pid((*table).pid)
    # So do its shm latches and its inbox (#4727)
    waitset_forget_pid((*table).pid as u64)
    (*table).in_use = false
    (*table).pid = 0
    (*table).active_count = 0
    cap_tables_count = cap_tables_count - 1
    return 0

# Process `pid` is exiting (sys_exit_impl, before cap_table_free): retire
# each shm object it holds a handle for, posting PEER_CLOSE on every other
# holder's latch, or DRIVER_GONE when `pid` owns a device IRQ (it is a
# ring-1 driver, RING1_DRIVER.md "Driver death"). An app's exit closes its
# exchange and wakes the service; the service's closes every exchange and
# the frame object. An object already retired is left as it is.
pub fn cap_retire_held_shm(pid: u32)
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return
    var bits: u32 = EVENT_PEER_CLOSE
    if cap_table_holds_type(table, CAP_TYPE_IRQ)
        bits = EVENT_DRIVER_GONE
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*table).entries[i]
        if (*entry).cap_type == CAP_TYPE_SHM
            shm_retire((*entry).object_id, pid as u64, bits)
        i = i + 1

# True if `table` holds any handle of `cap_type`.
fn cap_table_holds_type(table: *CapTable, cap_type: u8) -> bool
    var i: i32 = 0
    while i < 64
        if (*table).entries[i].cap_type == cap_type
            return true
        i = i + 1
    return false

# Look up a process's capability table
pub fn cap_table_get(pid: u32) -> *CapTable
    var i: i32 = 0
    while i < MAX_CAP_TABLES
        if cap_tables[i].in_use and cap_tables[i].pid == pid
            return @cap_tables[i]
        i = i + 1

    return 0 as *CapTable

# ============================================================================
# Capability Operations
# ============================================================================

# The id of the last CAP_INSERT the BSP sent: a reply carrying another is a
# late one.
var cap_insert_id: u64 = 0
# CAP_INSERTs each CPU has served (the owner's count).
var cap_inserts_served: [64]u64

# A handle as it travels in a message: index | generation << 32.
fn handle_pack(h: CapHandle) -> u64
    (h.index as u64) | ((h.generation as u64) << 32)

fn handle_unpack(packed: u64) -> CapHandle
    cap_handle_init((packed & 0xFFFFFFFF) as u32, (packed >> 32) as u32)

fn is_invalid(h: CapHandle) -> bool
    h.index == 0xFFFFFFFF

# Write the entry into `table`'s first free slot, on the CPU that owns it.
fn table_put(table: *CapTable, cap_type: u8, rights: u32, object_id: u64) -> CapHandle
    if table == 0 as *CapTable
        return cap_handle_invalid()
    var i: i32 = 0
    while i < 64
        if (*table).entries[i].cap_type == CAP_TYPE_NONE
            (*table).entries[i].cap_type = cap_type
            (*table).entries[i].rights = rights
            (*table).entries[i].object_id = object_id
            (*table).entries[i].generation = (*table).next_generation
            (*table).entries[i].flags = 0

            let gen: u32 = (*table).next_generation
            (*table).next_generation = (*table).next_generation + 1
            (*table).active_count = (*table).active_count + 1

            return cap_handle_init(i as u32, gen)
        i = i + 1
    cap_handle_invalid()

# CAP_INSERT to `cpu`, the CPU process `pid` is on, and its reply's handle.
fn insert_remote(cpu: i32, pid: u32, cap_type: u8, rights: u32, object_id: u64) -> CapHandle
    cap_insert_id = cap_insert_id + 1
    var req: MboxMsg = mbox_msg(MBOX_CAP_INSERT)
    req.pid = pid as u64
    req.arg[0] = cap_insert_id
    req.arg[1] = cap_type as u64
    req.arg[2] = rights as u64
    req.arg[3] = object_id
    mbox_post(cpu, req)
    handle_unpack(mbox_wait_reply(MBOX_CAP_INSERT_DONE, cpu, cap_insert_id).arg[1])

# sync/mbox.ritz's handler for CAP_INSERT, on the CPU process `pid` is on
# (its `extern` hook): the entry alone. The BSP made the shm latch before it
# asked. The packed handle, index 0xFFFFFFFF when refused.
pub fn cap_insert_serve(pid: u64, cap_type: u32, rights: u32, object_id: u64) -> u64
    let me: i32 = cpu_index()
    if me >= 0 and me < MAX_CPUS
        cap_inserts_served[me] = cap_inserts_served[me] + 1
    handle_pack(table_put(cap_table_get(pid as u32), cap_type as u8, rights, object_id))

# CAP_INSERTs CPU `cpu` has served (the smp-user boot test).
pub fn cap_inserts_served_count(cpu: i32) -> u64
    if cpu < 0 or cpu >= MAX_CPUS
        return 0
    cap_inserts_served[cpu]

# Insert a new capability into the table, on the CPU that owns it: here, or
# a CAP_INSERT to the CPU its process is on. Returns a handle to the
# capability, or invalid handle on failure (the table is full, or an AP
# asked for a table on another CPU, which only the BSP may do).
pub fn cap_table_insert(table: *CapTable, cap_type: u8, rights: u32, object_id: u64) -> CapHandle
    if table == 0 as *CapTable
        return cap_handle_invalid()
    let pid: u32 = (*table).pid

    # A shm handle comes with its holder's latch for the object, made here
    # so a notify reaches a peer that has not mapped it (#4727,
    # RING1_DRIVER.md "Wait and notify"). No latch to be had: no handle.
    # The latch is the BSP's row, made before the owner writes the entry.
    let had_latch: bool = cap_type == CAP_TYPE_SHM and shm_latch_held(object_id, pid as u64)
    if cap_type == CAP_TYPE_SHM and not shm_latch_create(object_id, pid as u64)
        return cap_handle_invalid()

    let me: i32 = cpu_index()
    let owner: i32 = proc_on_cpu(pid as u64)
    var h: CapHandle = cap_handle_invalid()
    if owner == me or cpu_map_started(owner) == 0
        h = table_put(table, cap_type, rights, object_id)
    else if me == PROC_BSP_CPU
        h = insert_remote(owner, pid, cap_type, rights, object_id)

    # Refused: a latch made for this handle goes, unless an earlier handle
    # for the object holds it
    if is_invalid(h) and cap_type == CAP_TYPE_SHM and not had_latch
        shm_latch_drop(object_id, pid as u64)
    h

# Look up a capability by handle
# Returns pointer to entry or null if invalid
pub fn cap_table_lookup(table: *CapTable, handle: CapHandle) -> *CapEntry
    if table == 0 as *CapTable
        return 0 as *CapEntry

    if handle.index >= 64
        return 0 as *CapEntry

    let entry: *CapEntry = @(*table).entries[handle.index as i32]

    # Check generation to detect stale handles
    if (*entry).generation != handle.generation
        return 0 as *CapEntry

    # Check if slot is actually in use
    if (*entry).cap_type == CAP_TYPE_NONE
        return 0 as *CapEntry

    return entry

# Remove a capability from the table
pub fn cap_table_remove(table: *CapTable, handle: CapHandle) -> i32
    let entry: *CapEntry = cap_table_lookup(table, handle)
    if entry == 0 as *CapEntry
        return -1

    (*entry).cap_type = CAP_TYPE_NONE
    (*entry).rights = 0
    (*entry).object_id = 0
    # Keep generation so old handles are detected as stale
    (*table).active_count = (*table).active_count - 1
    return 0

# ============================================================================
# Capability Derivation
# ============================================================================

# Derive a new capability with reduced rights
# The new capability refers to the same object but with fewer rights
pub fn cap_table_derive(table: *CapTable, handle: CapHandle, new_rights: u32) -> CapHandle
    let entry: *CapEntry = cap_table_lookup(table, handle)
    if entry == 0 as *CapEntry
        return cap_handle_invalid()

    # Can only derive with equal or fewer rights
    let effective_rights: u32 = (*entry).rights & new_rights

    # Check if caller has DERIVE right
    if ((*entry).rights & 16) == 0  # CAP_RIGHT_DERIVE = 16
        return cap_handle_invalid()

    # Create new capability with restricted rights
    return cap_table_insert(table, (*entry).cap_type, effective_rights, (*entry).object_id)

# ============================================================================
# Capability Grant (between processes)
# ============================================================================

# Grant a capability to another process
# The recipient gets a copy with optional rights restriction
pub fn cap_grant(from_table: *CapTable, handle: CapHandle, to_table: *CapTable, new_rights: u32) -> CapHandle
    if from_table == 0 as *CapTable or to_table == 0 as *CapTable
        return cap_handle_invalid()

    let entry: *CapEntry = cap_table_lookup(from_table, handle)
    if entry == 0 as *CapEntry
        return cap_handle_invalid()

    # Device capabilities are the kernel's to grant (cap_kernel_grant), never
    # a holder's, whatever its rights (AGAST #4716)
    if cap_type_is_device((*entry).cap_type)
        return cap_handle_invalid()

    # Check if caller has GRANT right
    if ((*entry).rights & 8) == 0  # CAP_RIGHT_GRANT = 8
        return cap_handle_invalid()

    # Effective rights are intersection of current and requested
    let effective_rights: u32 = (*entry).rights & new_rights

    # Insert into recipient's table
    return cap_table_insert(to_table, (*entry).cap_type, effective_rights, (*entry).object_id)

# ============================================================================
# Query Operations
# ============================================================================

# Get info about a capability
pub fn cap_table_info(table: *CapTable, handle: CapHandle, info: *CapInfo) -> i32
    let entry: *CapEntry = cap_table_lookup(table, handle)
    if entry == 0 as *CapEntry
        return -1

    (*info).cap_type = (*entry).cap_type
    (*info).rights = (*entry).rights
    (*info).object_id = (*entry).object_id
    return 0

# Check if a handle has specific rights
pub fn cap_has_rights(table: *CapTable, handle: CapHandle, required_rights: u32) -> bool
    let entry: *CapEntry = cap_table_lookup(table, handle)
    if entry == 0 as *CapEntry
        return false

    return ((*entry).rights & required_rights) == required_rights

# ============================================================================
# Debug
# ============================================================================

pub fn cap_table_debug_print(table: *CapTable) -> i32
    if table == 0 as *CapTable
        klog("CapTable: NULL\n")
        return -1

    klog("CapTable for PID ")
    klog_dec((*table).pid as i64)
    klog(": ")
    klog_dec((*table).active_count as i64)
    klog(" active capabilities\n")
    return 0

pub fn cap_system_debug_print()
    klog("Capability tables: ")
    klog_dec(cap_tables_count as i64)
    klog(" allocated\n")

# ============================================================================
# Process-wide checks and bootstrap (AGAST #1888)
# ============================================================================

# True if process `pid` holds a capability of `cap_type` with `right`.
# A process with no table (or no such capability) has no access.
pub fn cap_process_has(pid: u32, cap_type: u8, right: u32) -> bool
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return false
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*table).entries[i]
        if (*entry).cap_type == cap_type and ((*entry).rights & right) == right
            return true
        i = i + 1
    return false

# True if process `pid` holds a capability of `cap_type` with at least one
# of `rights`. Used where several rights are interchangeable at the
# boundary: closing a channel needs SEND or RECV, and closing/seeking a
# file needs READ or WRITE (AGAST #4472).
pub fn cap_process_has_any(pid: u32, cap_type: u8, rights: u32) -> bool
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return false
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*table).entries[i]
        if (*entry).cap_type == cap_type and ((*entry).rights & rights) != 0
            return true
        i = i + 1
    return false

# Free the table of `pid` if it has one (a process exiting or a spawn undo).
pub fn cap_table_free_pid(pid: u32) -> i32
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return -1
    return cap_table_free(table)

# Give init (pid 1) the capabilities the kernel reserves for the first
# process: power off the machine, map the display, and use the ambient IPC
# and filesystem facilities every process starts with. A spawned child
# inherits the latter three (see cap_inherit_ambient); POWER is init's alone.
#
# AGAST #1888 seeded POWER and DISPLAY; #4472 added CHANNEL and NAMESPACE
# when the IPC and filesystem syscalls were gated.
pub fn cap_init_bootstrap() -> i32
    let table: *CapTable = cap_table_alloc(1)
    if table == 0 as *CapTable
        return -1
    if cap_table_insert(table, CAP_TYPE_POWER, CAP_RIGHT_ALL, 0).index == 0xFFFFFFFF
        return -2
    if cap_table_insert(table, CAP_TYPE_DISPLAY, CAP_RIGHT_ALL, 0).index == 0xFFFFFFFF
        return -3
    if cap_table_insert(table, CAP_TYPE_CHANNEL, CAP_RIGHT_ALL, 0).index == 0xFFFFFFFF
        return -4
    if cap_table_insert(table, CAP_TYPE_NAMESPACE, CAP_RIGHT_ALL, 0).index == 0xFFFFFFFF
        return -5
    return 0

# Copy every capability of `cap_type` from `from` to `to`, with the source
# entry's rights. 0, or -2 when the destination table is full.
fn cap_inherit_type(from: *CapTable, to: *CapTable, cap_type: u8) -> i32
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*from).entries[i]
        if (*entry).cap_type == cap_type
            if cap_table_insert(to, cap_type, (*entry).rights, (*entry).object_id).index == 0xFFFFFFFF
                return -2
        i = i + 1
    return 0

# Give a new child the capabilities its parent passes on implicitly: DISPLAY
# (a compositor's client runs with its parent's framebuffer access), CHANNEL
# (IPC) and NAMESPACE (the filesystem). Rights are copied, never widened.
# POWER is never inherited - only init has it, so no child can power the
# machine off (AGAST #1888).
#
# The insertion order is part of the boot-gate contract: a child's inherited
# handles are DISPLAY=index 0, CHANNEL=index 1, NAMESPACE=index 2 (each with
# generation i+1), which is how projects/indium/user/cap_*_child.ritz
# revokes the capability it is testing. Explicitly granted capabilities are
# the other route: SYS_CAP_GRANT copies an entry from a holder with
# CAP_RIGHT_GRANT, intersected with the requested rights (cap_grant).
pub fn cap_inherit_ambient(parent_pid: u32, child_pid: u32) -> i32
    let from: *CapTable = cap_table_get(parent_pid)
    let to: *CapTable = cap_table_get(child_pid)
    if from == 0 as *CapTable or to == 0 as *CapTable
        return -1
    let display: i32 = cap_inherit_type(from, to, CAP_TYPE_DISPLAY)
    if display != 0
        return display
    let channel: i32 = cap_inherit_type(from, to, CAP_TYPE_CHANNEL)
    if channel != 0
        return channel
    return cap_inherit_type(from, to, CAP_TYPE_NAMESPACE)

# ============================================================================
# Device capabilities (AGAST #4716, docs/RING1_DRIVER.md "Grants")
# ============================================================================
#
# Only the kernel grants CAP_TYPE_IRQ and CAP_TYPE_MMIO, to the process it
# spawned for the device; cap_grant refuses both. CAP_TYPE_SHM handles are
# kernel-granted too (NetAttach and the spawn of the driver and service),
# though a holder with GRANT may still pass one on.
#
# The IRQ-cap owner is the process the kernel granted a device's IRQ to. It
# is recorded per object id so the kernel can quiesce the device when that
# owner exits or revokes its last IRQ handle for it (syscall/runtime/driver.ritz
# driver_quiesce, #4733).

const MAX_IRQ_CAP_OWNERS: i32 = 16

struct IrqCapOwner
    object_id: u64
    pid: u32
    in_use: bool
    _padding: [3]u8

var irq_cap_owners: [16]IrqCapOwner

# Slot recording `object_id`'s owner, or -1.
fn irq_owner_slot(object_id: u64) -> i32
    var i: i32 = 0
    while i < MAX_IRQ_CAP_OWNERS
        if irq_cap_owners[i].in_use and irq_cap_owners[i].object_id == object_id
            return i
        i = i + 1
    return -1

# Record `pid` as `object_id`'s IRQ owner. False when another process owns
# it or the registry is full; true (and no change) when `pid` already does.
fn irq_owner_claim(object_id: u64, pid: u32) -> bool
    let slot: i32 = irq_owner_slot(object_id)
    if slot >= 0
        return irq_cap_owners[slot].pid == pid
    var i: i32 = 0
    while i < MAX_IRQ_CAP_OWNERS
        if not irq_cap_owners[i].in_use
            irq_cap_owners[i].object_id = object_id
            irq_cap_owners[i].pid = pid
            irq_cap_owners[i].in_use = true
            return true
        i = i + 1
    return false

# Forget `object_id`'s owner if it is `pid`.
fn irq_owner_release(object_id: u64, pid: u32)
    let slot: i32 = irq_owner_slot(object_id)
    if slot >= 0 and irq_cap_owners[slot].pid == pid
        irq_cap_owners[slot].in_use = false
        irq_cap_owners[slot].pid = 0
        irq_cap_owners[slot].object_id = 0

# Forget every IRQ `pid` owns (its table is being freed: exit or spawn undo).
fn irq_owner_release_pid(pid: u32)
    var i: i32 = 0
    while i < MAX_IRQ_CAP_OWNERS
        if irq_cap_owners[i].in_use and irq_cap_owners[i].pid == pid
            irq_cap_owners[i].in_use = false
            irq_cap_owners[i].pid = 0
            irq_cap_owners[i].object_id = 0
        i = i + 1

# The pid that owns the IRQ capability for `object_id`, or 0 for none.
pub fn cap_irq_owner(object_id: u64) -> u32
    let slot: i32 = irq_owner_slot(object_id)
    if slot < 0
        return 0
    return irq_cap_owners[slot].pid

# Kernel-internal grant of an IRQ, MMIO or SHM capability for `object_id`
# into `pid`'s table. Never reached from a syscall argument: the kernel calls
# it for the process it spawned for a device, or for the two ends of a shared
# object. An IRQ grant records `pid` as the device's IRQ owner and is refused
# when another process owns that IRQ. Invalid handle on refusal, for a pid
# with no table, or when the table is full.
pub fn cap_kernel_grant(pid: u32, cap_type: u8, rights: u32, object_id: u64) -> CapHandle
    if not cap_type_is_kernel_granted(cap_type)
        return cap_handle_invalid()
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return cap_handle_invalid()
    if cap_type == CAP_TYPE_IRQ
        if irq_owner_slot(object_id) < 0
            # A new owner: claimed first, and released if the insert is
            # refused, so a full table leaves no owner behind and nothing
            # is ever removed from a table on another CPU
            if not irq_owner_claim(object_id, pid)
                return cap_handle_invalid()
            let h: CapHandle = cap_table_insert(table, cap_type, rights, object_id)
            if is_invalid(h)
                irq_owner_release(object_id, pid)
            return h
        if cap_irq_owner(object_id) != pid
            return cap_handle_invalid()
    return cap_table_insert(table, cap_type, rights, object_id)

# True if process `pid` holds a handle of `cap_type` for `object_id`
# (false for a pid with no table). NetAttach asks it of the app (one live
# exchange per process) and the wait asks it before dropping a retired
# ATTACH record's handle.
pub fn cap_holds_object(pid: u32, cap_type: u8, object_id: u64) -> bool
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return false
    return cap_table_holds_object(table, cap_type, object_id)

# True if `table` still holds a handle of `cap_type` for `object_id`.
fn cap_table_holds_object(table: *CapTable, cap_type: u8, object_id: u64) -> bool
    var i: i32 = 0
    while i < 64
        let entry: *CapEntry = @(*table).entries[i]
        if (*entry).cap_type == cap_type and (*entry).object_id == object_id
            return true
        i = i + 1
    return false

# The CapRevoke hook: `table`'s process dropped its last handle of
# `cap_type` for `object_id`. An IRQ owner stops owning the device's IRQ,
# once a device recorded for it is quiesced (#4733). A shm object is
# unmapped from that process only (#4717), and its latch for
# the object goes (#4727). MMIO leaves are
# unmapped here once a later ring-1 task maps them (docs/RING1_DRIVER.md,
# Grants); today nothing maps them. Other types have no per-process
# mapping. Another process's handles and mappings are never touched.
fn cap_last_handle_dropped(table: *CapTable, cap_type: u8, object_id: u64)
    if cap_type == CAP_TYPE_IRQ
        # While it is still the owner: driver_quiesce_object checks that.
        driver_quiesce_object((*table).pid, object_id)
        irq_owner_release(object_id, (*table).pid)
    else if cap_type == CAP_TYPE_SHM
        shm_unmap((*table).pid, object_id)
        shm_latch_drop(object_id, (*table).pid as u64)

# CapRevoke: remove `handle` from `table` (only the caller's copy) and, when
# the caller holds no other handle for the same object, run the hook. False
# for a handle the caller does not hold.
pub fn cap_revoke(table: *CapTable, handle: CapHandle) -> bool
    let idx: u32 = handle.index
    let gen: u32 = handle.generation
    let entry: *CapEntry = cap_table_lookup(table, cap_handle_init(idx, gen))
    if entry == 0 as *CapEntry
        return false
    let cap_type: u8 = (*entry).cap_type
    let object_id: u64 = (*entry).object_id
    if cap_table_remove(table, cap_handle_init(idx, gen)) != 0
        return false
    if cap_type_is_kernel_granted(cap_type) and not cap_table_holds_object(table, cap_type, object_id)
        cap_last_handle_dropped(table, cap_type, object_id)
    return true
