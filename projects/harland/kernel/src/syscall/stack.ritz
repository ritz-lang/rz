# Syscall Stack Sentinel (AGAST #2761)
#
# Every syscall, and every IRQ taken during one, runs on the single
# syscall_stack in syscall_entry.s. Its lowest quadword holds a sentinel; a
# syscall that runs off the bottom overwrites it. syscall_stack_check runs
# when a syscall leaves the kernel (syscall_handler's return, and sys_exit
# before it resumes the parent) and panics if the sentinel is gone, instead
# of letting the overflow corrupt whatever lies below. Before #2761 the stack
# was 4 KiB in .data, directly above g_child_pid and fs_current, and a deep
# write-back flush overwrote them without a trace (#4064).

import serial { prints, serial_print_dec }
import io { halt_loop }

extern fn syscall_stack_guard_init()
extern fn syscall_stack_guard_intact() -> u64
extern fn syscall_stack_high_water() -> u64
extern fn syscall_stack_size() -> u64

# Write the sentinel. Call once, before the first syscall.
pub fn syscall_stack_init()
    syscall_stack_guard_init()

# Bytes of the syscall stack ever used (a lower bound, see syscall_entry.s).
pub fn syscall_stack_used() -> u64
    syscall_stack_high_water()

# Panic if a syscall has run off the bottom of the syscall stack.
pub fn syscall_stack_check()
    if syscall_stack_guard_intact() != 0
        return
    prints("\n*** KERNEL PANIC: syscall stack overflow (")
    serial_print_dec(syscall_stack_size())
    prints(" bytes) ***\n")
    halt_loop()
