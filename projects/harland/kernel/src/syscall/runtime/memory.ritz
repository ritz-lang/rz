# Harland Syscall Runtime - Memory (AGAST #2751, from main.ritz)
#
# User stacks (alloc_user_stack is also bound by `extern fn` from
# loader/elf.ritz) and anonymous mmap/munmap.
# Each sys_*_handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import klog { klog, klog_hex, klog_dec }
import serial { StrView }
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_free_page, pmm_get_free_pages, pmm_fail_allocs_after, pmm_fail_allocs_off }
import mm.vmm { PTE_PRESENT, PTE_WRITABLE, PTE_USER, vmm_map_page, vmm_unmap_page, vmm_virt_to_phys, vmm_nx_flag, phys_to_virt }
import fs.syscall { fs_process_pid, fs_process_mmap_next, fs_process_set_mmap_next }
import syscall.errno { Errno }

# ============================================================================
# Memory Mapping (mmap/munmap)
# ============================================================================
#
# Harland uses a simplified mmap interface:
#   sys_mmap(addr_hint, length, prot, flags) -> mapped_addr or -errno
#   sys_munmap(addr, length) -> 0 or -errno
#
# We only support anonymous mappings (no file-backed mmap yet).
# The kernel allocates physical pages and maps them into the process.

# Protection flags (simplified - we always allow read)
const PROT_READ: u64 = 1
const PROT_WRITE: u64 = 2
const PROT_EXEC: u64 = 4

# Mapping flags
const MAP_PRIVATE: u64 = 0x02     # Private mapping (copy-on-write if file-backed)
const MAP_ANONYMOUS: u64 = 0x20   # No file backing
const MAP_FIXED: u64 = 0x10       # Map at exact address (hint is required)

# User address space limits (AGAST #3530).
# The mmap region starts at 512 GiB, PML4[1]: every table under it is the
# process's own. It used to start at 256 MiB, under PML4[0] -> PDPT[0], the
# kernel's identity-map PD that every process shares: built from 2 MiB pages
# (so no 4 KiB page could be mapped there) and, where it had room, a PT there
# put one process's pages in every process's address space.
const USER_MMAP_START: u64 = 0x8000000000    # 512 GiB, PML4[1]
const USER_MMAP_END: u64 = 0x7FFFFFF00000    # Just below stack

# User stack configuration
# Stack grows DOWN from the top of the stack region.
# We map 16 pages (64KB) from USER_STACK_BASE to USER_STACK_TOP.
# The stack pointer starts at USER_STACK_TOP + PAGE_SIZE (one byte past the top page).
#
# Memory layout:
#   USER_STACK_BASE   = 0x7FFFFFFEF000  (page 0, lowest address)
#   ...
#   USER_STACK_TOP    = 0x7FFFFFFFE000  (page 15, highest mapped page)
#   Stack grows DOWN from USER_STACK_TOP + PAGE_SIZE - 16
const USER_STACK_PAGES: u64 = 16
const USER_STACK_SIZE: u64 = 65536  # 16 * 4096 = 64KB
pub const USER_STACK_TOP: u64 = 0x7FFFFFFFE000   # Highest mapped page of user stack
const USER_STACK_BASE: u64 = 0x7FFFFFFEF000  # Lowest page of stack (TOP - 15*PAGE_SIZE)

# Kernel-chosen mmaps bump a per-process cursor (FsProc.mmap_next, 0 = not
# yet used = USER_MMAP_START), so every process's region starts at the same
# address and one process's mappings don't move another's.
fn mmap_cursor(num_pages: u64) -> u64
    return mmap_cursor_pick(fs_process_mmap_next(), num_pages)

# The address a kernel-chosen mmap of num_pages uses, given the cursor value
# next (0 = USER_MMAP_START). Takes the cursor as an argument so the boot
# self-test can drive it without a process.
#
# The cursor only moves past the cursor's own mappings, so a MAP_FIXED (or
# hint) mapping can sit ahead of it. vmm_map_page would overwrite such a
# page's PTE and leak its page (#4142), so the range starts after the last
# mapped page it would cover, until num_pages free pages in a row are found.
# Each restart moves addr forward by at least a page. A range that runs past
# USER_MMAP_END is returned as is: sys_mmap_impl's bounds check gives NoMem.
fn mmap_cursor_pick(next: u64, num_pages: u64) -> u64
    var addr: u64 = next
    if addr == 0
        addr = USER_MMAP_START
    var i: u64 = 0
    while i < num_pages
        if addr >= USER_MMAP_END or num_pages > (USER_MMAP_END - addr) / PAGE_SIZE
            return addr
        if vmm_virt_to_phys(addr + i * PAGE_SIZE) != 0
            addr = addr + (i + 1) * PAGE_SIZE
            i = 0
        else
            i = i + 1
    return addr

# Zero a freshly allocated frame through the physmap before any process can
# see it: a frame comes back from pmm holding whatever its last owner left,
# often another process's code or data (AGAST #4332).
fn zero_user_frame(page_phys: u64)
    let zero: *u64 = phys_to_virt(page_phys) as *u64
    var w: i64 = 0
    while w < 512
        *(zero + w) = 0
        w = w + 1

# ============================================================================
# User Stack Allocation Helper
# ============================================================================
#
# Allocates, zeroes and maps a multi-page user stack. The stack grows DOWN
# from USER_STACK_TOP. We allocate USER_STACK_PAGES physical pages and map
# them contiguously.
#
# The pages are zeroed (AGAST #4332): unzeroed, a child's stack leaks the
# previous owner's bytes, and in the Tier-1 preempt test busy A's stack was a
# recycled frame that had recently held executable code. QEMU's TCG still had
# a translation for that physical page, so every store to A's stack took the
# self-modifying-code slow path: A's eight steps cost 735 timer ticks against
# B's 98 and the children interleaved as BBBBBBBABAAAAAAA instead of ABAB..
# Writing the frame through the physmap before mapping it drops TCG's stale
# translation; zeroing is also what a fresh user stack must be.
#
# Returns: Stack pointer (top of usable stack), or 0 on failure
pub fn alloc_user_stack() -> u64
    # Allocate and map USER_STACK_PAGES pages starting from USER_STACK_BASE
    var i: u64 = 0
    while i < USER_STACK_PAGES
        let phys_page: u64 = pmm_alloc_page()
        if phys_page == 0
            # Allocation failed - unmap what we've done so far
            unmap_user_pages(USER_STACK_BASE, i)
            return 0
        zero_user_frame(phys_page)

        # Map page at USER_STACK_BASE + (i * PAGE_SIZE)
        let vaddr: u64 = USER_STACK_BASE + (i * PAGE_SIZE)
        let map_result: i32 = vmm_map_page(vaddr, phys_page, PTE_WRITABLE | PTE_USER)
        if map_result != 0
            # Map failed - free this page and unmap previous pages
            pmm_free_page(phys_page)
            unmap_user_pages(USER_STACK_BASE, i)
            return 0

        i = i + 1

    # Stack pointer points to top of mapped region (stack grows DOWN)
    # USER_STACK_TOP + PAGE_SIZE is the first unmapped address
    # So stack_ptr = USER_STACK_TOP + PAGE_SIZE - 16 (aligned, with some headroom)
    let stack_ptr: u64 = USER_STACK_TOP + PAGE_SIZE - 16
    return stack_ptr

# Free a user stack allocated by alloc_user_stack
fn free_user_stack()
    unmap_user_pages(USER_STACK_BASE, USER_STACK_PAGES)

# True when a hint range is unusable because some page of it is already
# mapped: the hint is then ignored, as on Linux, rather than mapped over
# (#4114). A range outside the mmap region is left to sys_mmap_impl's
# bounds check (NoMem), as before. The PMM never hands out page 0, so a
# 0 from vmm_virt_to_phys means unmapped.
fn mmap_hint_taken(addr: u64, num_pages: u64) -> bool
    if addr < USER_MMAP_START or addr >= USER_MMAP_END
        return false
    if num_pages > (USER_MMAP_END - addr) / PAGE_SIZE
        return false
    var i: u64 = 0
    while i < num_pages
        if vmm_virt_to_phys(addr + i * PAGE_SIZE) != 0
            return true
        i = i + 1
    return false

# Unmap and free `count` pages mapped at addr: a failed sys_mmap_impl's
# rollback, so NoMem leaves no page behind (AGAST #3552), and the user
# stack's teardown and allocation unwind. Each page was mapped to a frame
# its caller allocated, so freeing exactly what vmm_unmap_page hands back
# cannot free anything else. Page tables built stay, as with munmap.
fn unmap_user_pages(addr: u64, count: u64)
    var i: u64 = 0
    while i < count
        let phys: u64 = vmm_unmap_page(addr + i * PAGE_SIZE)
        if phys != 0
            pmm_free_page(phys)
        i = i + 1

# ============================================================================
# sys_mmap: Map anonymous memory pages
# ============================================================================
#
# Arguments:
#   addr_hint: Suggested address (0 = kernel chooses)
#   length: Number of bytes to map (will be rounded up to page size)
#   prot: Protection flags (PROT_READ | PROT_WRITE | PROT_EXEC)
#   flags: Mapping flags (MAP_ANONYMOUS | MAP_PRIVATE)
#
# Returns:
#   Address of mapped region, or Errno.Inval / Errno.NoMem
#
# Note: We only support anonymous private mappings for now.
fn sys_mmap_impl(addr_hint: u64, length: u64, prot: u64, flags: u64) -> i64
    # Validate flags - we only support anonymous private mappings
    if (flags & MAP_ANONYMOUS) == 0
        klog("[mmap] ERROR: only anonymous mappings supported\n")
        return Errno.Inval as i64

    if length == 0
        klog("[mmap] ERROR: length cannot be zero\n")
        return Errno.Inval as i64

    # Round length up to page size
    let num_pages: u64 = (length + PAGE_SIZE - 1) / PAGE_SIZE

    # Determine the mapping address
    var map_addr: u64 = 0
    var kernel_chose: bool = false
    if (flags & MAP_FIXED) != 0
        # Must map at the exact address
        if addr_hint == 0 or (addr_hint & 0xFFF) != 0
            klog("[mmap] ERROR: MAP_FIXED requires page-aligned address\n")
            return Errno.Inval as i64
        map_addr = addr_hint
    else if addr_hint != 0 and (addr_hint & 0xFFF) == 0 and not mmap_hint_taken(addr_hint, num_pages)
        # Try the hint address if it's page-aligned and nothing lives there
        map_addr = addr_hint
    else
        # Kernel chooses: this process's bump cursor, advanced on success
        if fs_process_pid() == 0
            klog("[mmap] ERROR: no current process\n")
            return Errno.Srch as i64
        map_addr = mmap_cursor(num_pages)
        kernel_chose = true

    # Validate address is in user mmap region
    if map_addr < USER_MMAP_START or map_addr >= USER_MMAP_END
        klog("[mmap] ERROR: address outside user mmap region\n")
        return Errno.NoMem as i64

    if (map_addr + num_pages * PAGE_SIZE) > USER_MMAP_END
        klog("[mmap] ERROR: mapping would exceed mmap region\n")
        return Errno.NoMem as i64

    # Compute page table flags from protection
    var pte_flags: u64 = PTE_PRESENT | PTE_USER
    if (prot & PROT_WRITE) != 0
        pte_flags = pte_flags | PTE_WRITABLE
    if (prot & PROT_EXEC) == 0
        pte_flags = pte_flags | vmm_nx_flag()

    # MAP_FIXED replaces whatever is mapped in the range (Linux semantics):
    # vmm_map_page would overwrite a live leaf PTE and leak its page, so
    # unmap and free the overlap first (#4114). It must happen here, not in
    # unmap_user_pages: the rollback frees what it unmaps, and on failure it only
    # covers the pages this call mapped. As on Linux, a MAP_FIXED that then
    # fails leaves the old mapping gone.
    if (flags & MAP_FIXED) != 0
        unmap_user_pages(map_addr, num_pages)

    # Allocate, zero (through the physmap, before the user can see it) and
    # map each page.
    var i: u64 = 0
    while i < num_pages
        let page_phys: u64 = pmm_alloc_page()
        if page_phys == 0
            klog("[mmap] ERROR: out of physical memory\n")
            unmap_user_pages(map_addr, i)
            return Errno.NoMem as i64

        zero_user_frame(page_phys)

        let page_virt: u64 = map_addr + (i * PAGE_SIZE)
        let result: i32 = vmm_map_page(page_virt, page_phys, pte_flags)
        if result != 0
            klog("[mmap] ERROR: failed to map page at 0x")
            klog_hex(page_virt)
            klog("\n")
            pmm_free_page(page_phys)
            unmap_user_pages(map_addr, i)
            return Errno.NoMem as i64

        i = i + 1

    if kernel_chose
        fs_process_set_mmap_next(map_addr + num_pages * PAGE_SIZE)

    # No success log: every `main(args: Span<StrView>)` program maps its
    # arg views at entry, so a line here lands in each command's console
    # output (the shell session's exact `ping` checks). Failures still log.

    return map_addr as i64

# ============================================================================
# sys_munmap: Unmap memory pages
# ============================================================================
#
# Arguments:
#   addr: Address of region to unmap (must be page-aligned)
#   length: Number of bytes to unmap (will be rounded up to page size)
#
# Returns:
#   0 on success, Errno.Inval for a bad address
fn sys_munmap_impl(addr: u64, length: u64) -> i64
    # Validate address alignment
    if (addr & 0xFFF) != 0
        klog("[munmap] ERROR: address not page-aligned\n")
        return Errno.Inval as i64

    if length == 0
        return 0  # Nothing to do

    # Validate address is in user mmap region
    if addr < USER_MMAP_START or addr >= USER_MMAP_END
        klog("[munmap] ERROR: address outside user mmap region\n")
        return Errno.Inval as i64

    # Round length up to page size
    let num_pages: u64 = (length + PAGE_SIZE - 1) / PAGE_SIZE

    # Unmap each page
    var i: u64 = 0
    while i < num_pages
        let page_virt: u64 = addr + (i * PAGE_SIZE)

        # vmm_unmap_page returns the physical address that WAS mapped, or 0
        # if nothing was -- not a 0=success status. Treating it as a status
        # (through an i32 that truncated it) meant no page was ever freed
        # (#1443). Every page in the mmap region comes from sys_mmap_impl's
        # pmm_alloc_page and nothing else maps it, so freeing exactly what
        # was unmapped cannot double-free.
        let unmapped_phys: u64 = vmm_unmap_page(page_virt)
        if unmapped_phys != 0
            pmm_free_page(unmapped_phys)

        i = i + 1

    # Debug output
    klog("[munmap] Unmapped ")
    klog_dec(num_pages as i64)
    klog(" pages at 0x")
    klog_hex(addr)
    klog("\n")

    return 0

# ============================================================================
# Boot self-test: munmap gives back every page mmap took (#1443)
# ============================================================================
#
# sys_munmap_impl once read vmm_unmap_page's u64 physical address into an
# i32 and tested it as a 0=success status, so it never freed a page (except
# one whose address truncated to 0). This maps MUNMAP_TEST_PAGES pages,
# unmaps them and checks the PMM free count is back where it started.
#
# Runs from postinit_self_tests on the kernel PML4, before any process
# exists, with interrupts off: nothing else allocates in between, so the
# count is deterministic. PML4[1] (the mmap region) is never shared into
# user PML4s, and the page tables mmap builds under it stay (munmap frees
# leaf pages only), so a warm-up mmap/munmap builds them first and the
# measured round trip allocates leaf pages only.
const MUNMAP_TEST_PAGES: u64 = 8

# Returns true when every page came back, false (after saying why) if not.
pub fn munmap_self_test() -> bool
    klog("\nTesting mmap/munmap page accounting...\n")
    let flags: u64 = MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED
    let prot: u64 = PROT_READ | PROT_WRITE
    let length: u64 = MUNMAP_TEST_PAGES * PAGE_SIZE

    # Warm-up: builds the PDPT/PD/PT the measured round trip reuses.
    if sys_mmap_impl(USER_MMAP_START, length, prot, flags) != USER_MMAP_START as i64
        klog("  munmap test FAILED: warm-up mmap failed\n")
        return false
    sys_munmap_impl(USER_MMAP_START, length)

    let before: u64 = pmm_get_free_pages()
    if sys_mmap_impl(USER_MMAP_START, length, prot, flags) != USER_MMAP_START as i64
        klog("  munmap test FAILED: mmap failed\n")
        return false
    let mapped: u64 = pmm_get_free_pages()
    let munmap_result: i64 = sys_munmap_impl(USER_MMAP_START, length)
    let after: u64 = pmm_get_free_pages()

    klog("  free pages: before=")
    klog_dec(before)
    klog(" mapped=")
    klog_dec(mapped)
    klog(" after=")
    klog_dec(after)
    klog("\n")

    if before - mapped != MUNMAP_TEST_PAGES
        klog("  munmap test FAILED: mmap did not take exactly the pages it mapped\n")
        return false
    if munmap_result != 0 or after != before
        klog("  munmap test FAILED: munmap did not free the pages it unmapped\n")
        return false
    if vmm_virt_to_phys(USER_MMAP_START) != 0
        klog("  munmap test FAILED: page still mapped after munmap\n")
        return false
    klog("  munmap test PASSED!\n")
    return true

# ============================================================================
# Boot self-test: a failed mmap gives back the pages it already took (#3552)
# ============================================================================
#
# sys_mmap_impl once returned NoMem from page i with pages 0..i-1 still
# mapped and allocated. OOM injection (pmm_fail_allocs_after) reaches both
# failure points; each case checks NoMem came back, the PMM free count is
# unchanged and no page of the range is left mapped.
#
# Runs after munmap_self_test, on the same terms: kernel PML4, no process,
# interrupts off. That test built the PT covering USER_MMAP_START's first
# 2 MiB, and nothing maps the next 2 MiB, so:
#   - data page:  8 pages at USER_MMAP_START with 5 allocations allowed:
#                 page 5's pmm_alloc_page fails.
#   - page table: 8 pages at USER_MMAP_START + 2 MiB - 4 pages with 5
#                 allowed: pages 0-3 land in the existing PT, page 4's data
#                 page is the 5th allocation and the new PT vmm_map_page
#                 needs for it is the 6th, so vmm_map_page fails.
const MMAP_FAIL_TEST_PAGES: u64 = 8
const MMAP_FAIL_TEST_BUDGET: u64 = 5
const MMAP_PT_SPAN: u64 = 0x200000     # 2 MiB: what one PT maps

# One case: mmap MMAP_FAIL_TEST_PAGES at addr with MMAP_FAIL_TEST_BUDGET
# allocations allowed. True when it failed cleanly.
fn mmap_fail_case(name: StrView, addr: u64) -> bool
    let flags: u64 = MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED
    let prot: u64 = PROT_READ | PROT_WRITE
    let length: u64 = MMAP_FAIL_TEST_PAGES * PAGE_SIZE

    let before: u64 = pmm_get_free_pages()
    pmm_fail_allocs_after(MMAP_FAIL_TEST_BUDGET)
    let result: i64 = sys_mmap_impl(addr, length, prot, flags)
    pmm_fail_allocs_off()
    let after: u64 = pmm_get_free_pages()

    klog("  ")
    klog(name)
    klog(": free pages before=")
    klog_dec(before)
    klog(" after=")
    klog_dec(after)
    klog("\n")

    if result != Errno.NoMem as i64
        klog("  mmap failure test FAILED: mmap did not return NoMem\n")
        # It may have mapped the range: give it back so later tests start clean.
        if result == addr as i64
            sys_munmap_impl(addr, length)
        return false
    var still_mapped: bool = false
    var i: u64 = 0
    while i < MMAP_FAIL_TEST_PAGES
        if vmm_virt_to_phys(addr + i * PAGE_SIZE) != 0
            still_mapped = true
        i = i + 1
    if still_mapped
        klog("  mmap failure test FAILED: a page is still mapped after NoMem\n")
        return false
    if after != before
        klog("  mmap failure test FAILED: NoMem leaked physical pages\n")
        return false
    return true

# Returns true when both failure points roll back, false (after saying why)
# if not.
pub fn mmap_failure_self_test() -> bool
    klog("\nTesting mmap rollback on out-of-memory...\n")
    if not mmap_fail_case("data page", USER_MMAP_START)
        return false
    let pt_addr: u64 = USER_MMAP_START + MMAP_PT_SPAN - 4 * PAGE_SIZE
    if not mmap_fail_case("page table", pt_addr)
        return false
    klog("  mmap failure test PASSED!\n")
    return true

# ============================================================================
# Boot self-test: mmap over a live mapping leaks no page (#4114)
# ============================================================================
#
# vmm_map_page never checks the leaf PTE, so sys_mmap_impl once mapped a
# MAP_FIXED or hint range over live pages by overwriting their PTEs: the old
# physical pages were never freed. The semantics now (Linux's):
#   - hint: if any page of the range is mapped, the hint is ignored and the
#     kernel picks the address from the process's cursor;
#   - MAP_FIXED: the overlap is unmapped (and freed) first, then replaced.
#
# Runs after mmap_failure_self_test, on the same terms: kernel PML4, no
# process, interrupts off, the PT under USER_MMAP_START already built and
# nothing mapped. With no process the hint's fallback has no cursor and
# returns Srch, which takes nothing; what matters is that the live pages are
# untouched. Both overlaps are partial: the live mapping is the last
# MMAP_OVERLAP_LIVE pages of the MMAP_OVERLAP_PAGES-page range.
const MMAP_OVERLAP_PAGES: u64 = 8
const MMAP_OVERLAP_LIVE: u64 = 4

# Returns true when neither overlap leaked or clobbered a page, false
# (after saying why) if not.
pub fn mmap_overlap_self_test() -> bool
    klog("\nTesting mmap over a live mapping...\n")
    let fixed: u64 = MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED
    let hint: u64 = MAP_ANONYMOUS | MAP_PRIVATE
    let prot: u64 = PROT_READ | PROT_WRITE
    let addr: u64 = USER_MMAP_START
    let live: u64 = addr + (MMAP_OVERLAP_PAGES - MMAP_OVERLAP_LIVE) * PAGE_SIZE
    let length: u64 = MMAP_OVERLAP_PAGES * PAGE_SIZE

    let base: u64 = pmm_get_free_pages()
    if sys_mmap_impl(live, MMAP_OVERLAP_LIVE * PAGE_SIZE, prot, fixed) != live as i64
        klog("  mmap overlap test FAILED: mapping the live pages failed\n")
        return false
    let live_phys: u64 = vmm_virt_to_phys(live)
    let held: u64 = pmm_get_free_pages()

    # Hint over the live pages: must not map at the hint.
    let hinted: i64 = sys_mmap_impl(addr, length, prot, hint)
    let after_hint: u64 = pmm_get_free_pages()
    klog("  hint: result=0x")
    klog_hex(hinted as u64)
    klog(" free pages held=")
    klog_dec(held)
    klog(" after=")
    klog_dec(after_hint)
    klog("\n")
    if hinted == addr as i64
        klog("  mmap overlap test FAILED: hint mapped over a live mapping\n")
        return false
    if after_hint != held
        klog("  mmap overlap test FAILED: refused hint changed the free count\n")
        return false
    if vmm_virt_to_phys(addr) != 0 or vmm_virt_to_phys(live) != live_phys
        klog("  mmap overlap test FAILED: hint touched the live mapping\n")
        return false

    # MAP_FIXED over the live pages: replaces them, freeing the old ones.
    let replaced: i64 = sys_mmap_impl(addr, length, prot, fixed)
    let after_fixed: u64 = pmm_get_free_pages()
    klog("  MAP_FIXED: free pages base=")
    klog_dec(base)
    klog(" after=")
    klog_dec(after_fixed)
    klog("\n")
    if replaced != addr as i64
        klog("  mmap overlap test FAILED: MAP_FIXED over a live mapping failed\n")
        return false
    if base - after_fixed != MMAP_OVERLAP_PAGES
        klog("  mmap overlap test FAILED: MAP_FIXED leaked the pages it replaced\n")
        return false

    sys_munmap_impl(addr, length)
    if pmm_get_free_pages() != base
        klog("  mmap overlap test FAILED: munmap did not give every page back\n")
        return false
    klog("  mmap overlap test PASSED!\n")
    return true

# ============================================================================
# Boot self-test: the kernel-chosen cursor skips mapped pages (#4142)
# ============================================================================
#
# The cursor (FsProc.mmap_next) only ever moves forward past the cursor's
# own mappings, so a MAP_FIXED mapping ahead of it was once picked by a later
# mmap(0, ...), its PTEs overwritten and its pages leaked. mmap_cursor_pick
# must start the range after the last mapped page it would overlap.
#
# Runs after mmap_overlap_self_test, on the same terms: kernel PML4, no
# process, interrupts off, nothing mapped under USER_MMAP_START. There is no
# process, so the test passes cursor values to mmap_cursor_pick directly.
# The live mapping is MMAP_CURSOR_LIVE pages, MMAP_CURSOR_GAP pages past
# USER_MMAP_START:
#   - a range that fits in the gap is placed at the cursor;
#   - a range that would overlap the live pages starts just after them;
#   - a cursor inside the live pages moves just past them;
#   - cursor 0 means USER_MMAP_START.
const MMAP_CURSOR_GAP: u64 = 2
const MMAP_CURSOR_LIVE: u64 = 3

# One case: true when mmap_cursor_pick(next, num_pages) is want.
fn mmap_cursor_case(name: StrView, next: u64, num_pages: u64, want: u64) -> bool
    let got: u64 = mmap_cursor_pick(next, num_pages)
    if got == want
        return true
    klog("  mmap cursor test FAILED: ")
    klog(name)
    klog(": got 0x")
    klog_hex(got)
    klog(" want 0x")
    klog_hex(want)
    klog("\n")
    return false

# Returns true when every case picks a free range, false (after saying why)
# if not.
pub fn mmap_cursor_self_test() -> bool
    klog("\nTesting the mmap cursor skips mapped pages...\n")
    let fixed: u64 = MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED
    let prot: u64 = PROT_READ | PROT_WRITE
    let start: u64 = USER_MMAP_START
    let live: u64 = start + MMAP_CURSOR_GAP * PAGE_SIZE
    let past: u64 = live + MMAP_CURSOR_LIVE * PAGE_SIZE
    let live_len: u64 = MMAP_CURSOR_LIVE * PAGE_SIZE

    if sys_mmap_impl(live, live_len, prot, fixed) != live as i64
        klog("  mmap cursor test FAILED: mapping the live pages failed\n")
        return false
    var ok: bool = mmap_cursor_case("fits in the gap", start, MMAP_CURSOR_GAP, start)
    if ok
        ok = mmap_cursor_case("cursor 0", 0, MMAP_CURSOR_GAP, start)
    if ok
        ok = mmap_cursor_case("overlaps the live pages", start, MMAP_CURSOR_GAP + 1, past)
    if ok
        ok = mmap_cursor_case("cursor inside the live pages", live + PAGE_SIZE, 1, past)
    if ok
        ok = mmap_cursor_case("cursor past the live pages", past, 4, past)
    sys_munmap_impl(live, live_len)
    if not ok
        return false
    klog("  mmap cursor test PASSED!\n")
    return true

# ============================================================================
# Memory syscall handlers
# ============================================================================

# mmap(addr, length, prot, flags)
pub fn sys_mmap_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_mmap_impl(rdi, rsi, rdx, r10)

# munmap(addr, length)
pub fn sys_munmap_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_munmap_impl(rdi, rsi)
