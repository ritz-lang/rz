# Harland Syscall Runtime - driver waits (AGAST #4719, docs/RING1_DRIVER.md
# §4 "One waitable interrupt" and "Wait and notify")
#
# DrvIrqWait (220): drv_irq_wait(irq_handle, *WaitRequest). A driver process
# parks on its own wait set (proc/waitset.ritz) until the IRQ object its
# CAP_TYPE_IRQ handle names is hot, a listed shm source or its inbox has an
# event (#4727), or DEVICE_WAIT_MS has passed. One return copies every hot
# source that fits in out_cap, in order: the IRQ, the listed sources in the
# caller's order, then inbox records (waitset_collect). What does not fit
# stays latched for the next call, and only what was copied is cleared.
#
#   0   the IRQ record was copied: out[0] = { irq_handle, EVENT_DATA },
#       seen = latched (the same interrupt does not complete the next
#       call), and out[1..out_count] are any other events that fit
#   2   events were copied and the IRQ was not hot: out_count of them
#   1   the deadline passed: out_count = 0 and out is not written
#   <0  an errno, with nothing consumed and nothing written:
#       Errno.Perm   the caller holds no CAP_TYPE_IRQ handle `irq_handle`
#                    (every process the kernel did not spawn for a device),
#                    or lists a source that is not its CAP_TYPE_SHM handle
#       Errno.Fault  the request, the source array or the out range is not
#                    the caller's memory
#       Errno.Inval  source_count above WAIT_SOURCE_CAP, out_cap 0 or above
#                    WAIT_OUT_CAP
#       Errno.NoDev  the handle names no registered IRQ object
#       Errno.Again  this CPU cannot park (not the BSP, or no process)
#
# The request and the source array are copied into kernel memory before a
# latch is cleared; the user source array is never written. The deadline is
# now + DEVICE_WAIT_MS on this process's wait set; WaitRequest.deadline is
# ShmWait's (229) and is ignored here. A wake that matches nothing before
# the deadline (another object's interrupt reaching this owner, a notify of
# a bit outside a source's mask) parks again; it is not a return of 1. The shared LAPIC
# watchdog and the BLOCK_IRQ queue that irq_wait_vector (NVMe, virtio) uses
# are not touched. A process marked PROC_REAP stops waiting: its return to
# user exits instead (syscall_entry.s reap_if_marked).
#
# ShmWait (229): shm_wait(*WaitRequest) is the same wait with no IRQ, for a
# process with no IRQ capability (the ring-2 service). Its deadline is
# WaitRequest.deadline milliseconds from the call (Harland has no user
# clock to name an absolute one); 0 checks once. 2 events, 1 the deadline,
# or Perm / Fault / Inval / Again as above.
#
# ShmNotify (230): shm_notify(shm_handle, bits) ORs DATA and/or SPACE into
# the latch of every other process holding that shm object, mapped or not,
# and wakes the one parked on its wait set. 0, or Errno.Perm (no such
# CAP_TYPE_SHM handle), Errno.Inval (bits 0 or any other bit: PEER_CLOSE,
# DRIVER_GONE, LINK and ATTACH are kernel posts, proc/waitset.ritz
# shm_latch_post and waitset_inbox_post), Errno.NoDev (no other holder).
# Nothing is posted on an errno.

import io { disable_interrupts, enable_interrupts }
import mm.uptr { uptr_check_read, uptr_check_write }
import ritzlib.option
import syscall.errno { Errno }
import cap.types { CapEntry, CAP_TYPE_IRQ, CAP_TYPE_MMIO, CAP_TYPE_SHM, cap_handle_init }
import cap.table { CapTable, cap_table_get, cap_table_lookup }
import proc.table { BLOCK_WAIT, proc_current, proc_current_pid, proc_current_slot, proc_block, proc_reap_pending }
import proc.sched { sched_block }
import proc.waitq { waitq_can_park }
import proc.waitset { irq_object_known, waitset_arm, waitset_disarm }
import proc.waitset { WaitPlan, Collected, Notify, wait_plan_new, wait_plan_irq, wait_plan_add, waitset_collect, shm_notify }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import driver_abi.wait { WaitRequest, WaitSource, WaitEvent, WAIT_SOURCE_CAP, WAIT_OUT_CAP, DEVICE_WAIT_MS }
import mm.pmm { PAGE_SIZE }
import mm.vmm { PTE_WRITABLE, PTE_USER, PTE_WRITE_THROUGH, PTE_CACHE_DISABLE, PTE_DEVICE, DRV_DMA_BASE, DRV_MMIO_BASE, vmm_map_page_in, vmm_unmap_page_in, vmm_nx_flag, vmm_slot_end, vmm_get_current_pml4 }
import mm.dma { dma_alloc_zeroed, dma_free_pages }
import drivers.virtio.window { VioWindow, vio_window_find, vio_window_pages, vio_window_guarded }
import driver_abi.dma { DmaAlloc, DMA_ALLOC_MAX }

const US_PER_MS: u64 = 1000

# Parks DrvIrqWait and ShmWait have made, re-parks included (the
# drv-irq-wait and shm-wait boot tests read it to see a wait park).
var drv_irq_wait_parks: u64 = 0

pub fn drv_irq_wait_park_count() -> u64
    drv_irq_wait_parks

# The object id behind packed handle `packed` (index | generation << 32) in
# `pid`'s table, if it is a `cap_type` handle the process holds.
fn held_object(pid: u32, packed: u64, cap_type: u8) -> Option<u64>
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return None
    let index: u32 = (packed & 0xFFFFFFFF) as u32
    let generation: u32 = (packed >> 32) as u32
    let entry: *CapEntry = cap_table_lookup(table, cap_handle_init(index, generation))
    if entry == 0 as *CapEntry or entry.cap_type != cap_type
        return None
    Some(entry.object_id)

# What copy_request found: the plan, with the listed sources resolved to
# their objects, or the errno. Not a Result: VtdDma and goliath's
# ErrorCode, both in this module's import closure, declare `Ok` too, so a
# bare `Ok(x)` is ambiguous here and Result has no qualified constructor.
enum RequestCheck
    Valid(CheckedRequest)
    Refused(Errno)

# A request copied into kernel memory and checked.
struct CheckedRequest
    plan: WaitPlan
    out: *WaitEvent         # the caller's out range, checked writable
    out_cap: u32
    _pad: u32
    deadline_ms: u64        # ShmWait's WaitRequest.deadline

# The caller's request (`ureq`), copied into kernel memory and checked
# against `plan` (the IRQ, or none), or the errno that refuses it: Fault,
# Inval or Perm (above). Each listed source is copied before its handle is
# checked, so the check reads the kernel's copy and never a second read of
# the user array. The out range is checked too, so storing the result
# cannot fault. Nothing is consumed here.
fn copy_request(pid: u32, ureq: *WaitRequest, plan: WaitPlan) -> RequestCheck
    # Writable, for out_count.
    if uptr_check_write(ureq as *u8, sizeof(WaitRequest) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    let req: WaitRequest = *ureq
    if req.source_count > WAIT_SOURCE_CAP or req.out_cap == 0 or req.out_cap > WAIT_OUT_CAP
        return RequestCheck.Refused(Errno.Inval)
    let count: u64 = req.source_count as u64
    if count > 0 and uptr_check_read(req.sources as *u8, count * sizeof(WaitSource) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    var checked: CheckedRequest
    checked.plan = plan
    var i: u64 = 0
    while i < count
        let source: WaitSource = *(req.sources + i)
        let object_id: u64 = match held_object(pid, source.handle, CAP_TYPE_SHM)
            Some(id) => id
            None => return RequestCheck.Refused(Errno.Perm)
        wait_plan_add(@checked.plan, source.handle, object_id, source.mask)
        i = i + 1
    if uptr_check_write(req.out as *u8, req.out_cap as u64 * sizeof(WaitEvent) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    checked.out = req.out
    checked.out_cap = req.out_cap
    checked._pad = 0
    checked.deadline_ms = req.deadline
    RequestCheck.Valid(checked)

# Collect for the calling process (`pid`) under `checked`, parking on its
# wait set until something matches or TSC `deadline` passes: 0 (the IRQ
# record was copied), 2 (events without the IRQ) or 1 (the deadline), with
# out_count written; Errno.Again when this CPU cannot park or the process
# is marked to exit (nothing consumed; its return to user exits instead).
fn wait_collect(pid: u32, ureq: *WaitRequest, checked: *CheckedRequest, deadline: u64) -> i64
    disable_interrupts()
    if not waitq_can_park()
        enable_interrupts()
        return Errno.Again as i64
    let slot: i32 = proc_current_slot()
    var result: i64 = 1
    while true
        if proc_reap_pending(proc_current())
            result = Errno.Again as i64
            break
        let got: Collected = waitset_collect(@checked.plan, pid as u64, checked.out_cap)
        if got.count > 0
            var i: u32 = 0
            while i < got.count
                *(checked.out + i as u64) = got.events[i as i32]
                i = i + 1
            (*ureq).out_count = got.count
            result = if got.irq then 0 else 2
            break
        if deadline_passed(deadline)
            (*ureq).out_count = 0
            result = 1
            break
        waitset_arm(slot, deadline)
        drv_irq_wait_parks = drv_irq_wait_parks + 1
        proc_block(BLOCK_WAIT, 0)
        sched_block()
    waitset_disarm(slot)
    enable_interrupts()
    result

# drv_irq_wait for process `pid` (above). `ureq` is the caller's request.
fn drv_irq_wait(pid: u32, irq_handle: u64, ureq: *WaitRequest) -> i64
    # Authority first: a process without the handle learns nothing else.
    let object_id: u64 = match held_object(pid, irq_handle, CAP_TYPE_IRQ)
        Some(id) => id
        None => return Errno.Perm as i64
    var checked: CheckedRequest = match copy_request(pid, ureq, wait_plan_irq(irq_handle, object_id))
        RequestCheck.Valid(c) => c
        RequestCheck.Refused(e) => return e as i64
    if not irq_object_known(object_id)
        return Errno.NoDev as i64
    wait_collect(pid, ureq, @checked, deadline_after_us(DEVICE_WAIT_MS * US_PER_MS))

# drv_irq_wait(irq_handle, request): the caller's page table is loaded.
pub fn sys_drv_irq_wait_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_irq_wait(proc_current_pid() as u32, rdi, rsi as *WaitRequest)

# ============================================================================
# DrvMmioMap (221) and DrvDmaAlloc (222), AGAST #4720 and #4721
# (docs/RING1_DRIVER.md §5 "MMIO and DMA syscalls", PR 5)
# ============================================================================
#
# DrvMmioMap(mmio_handle) maps every page of the window that the caller's
# CAP_TYPE_MMIO handle names, uncached, into the caller's PML4 only, from
# the next free page of its MMIO window (DRV_MMIO_BASE, PML4[253]). It
# returns the VA of the window's first page; the driver adds the window's
# byte offset itself. The window is the kernel's record
# (drivers/virtio/window.ritz); the advisory copy in the shared page is
# never read.
#
#   Errno.Perm   the caller holds no CAP_TYPE_MMIO handle `mmio_handle`
#   Errno.Inval  the object is no recorded window, or a page of it holds the
#                MSI-X table or PBA: nothing is mapped
#   Errno.NoMem  the window has no room, or a page table could not be had:
#                the pages this call installed are unmapped again
#
# DrvDmaAlloc(irq_handle, size, *DmaAlloc) allocates one zeroed contiguous
# run of `size` bytes rounded up to pages and maps it write-back into the
# caller's DMA window (DRV_DMA_BASE, PML4[252]). It returns the run's VA and
# copies out { iova, size }. Until the device's DMA domain exists (PR 5b,
# ring plan T18) nothing the device can use is published: iova is 0, and the
# run is for the CPU only. The run is not a DmaRegion: the PML4 owns it, and
# exit frees it once (no PTE_DEVICE).
#
#   Errno.Perm   the caller holds no CAP_TYPE_IRQ handle `irq_handle`
#   Errno.Inval  size 0
#   Errno.NoMem  size above DMA_ALLOC_MAX (4 MiB), no contiguous run free, no
#                room in the window, or no page table: nothing stays mapped
#                or allocated
#   Errno.Fault  the DmaAlloc is not the caller's writable memory (checked
#                before anything is allocated)

# MMIO leaves: the kernel's vmm_map_mmio type (PCD|PWT, uncached) plus user
# and PTE_DEVICE, so the frame is never returned to the PMM on exit.
pub fn drv_mmio_leaf() -> u64
    PTE_WRITABLE | PTE_USER | PTE_WRITE_THROUGH | PTE_CACHE_DISABLE | PTE_DEVICE | vmm_nx_flag()

# DMA leaves: write-back RAM the process owns (§5: virtio-pci on x86 is
# DMA-coherent).
pub fn drv_dma_leaf() -> u64
    PTE_WRITABLE | PTE_USER | vmm_nx_flag()

const SLOT_BYTES: u64 = 1 << 39        # one PML4 entry

# The next free address in the window at `base`, if `pages` more fit.
fn window_room(pml4: u64, base: u64, pages: u64) -> Option<u64>
    let vaddr: u64 = vmm_slot_end(pml4, base)
    if pages > (base + SLOT_BYTES - vaddr) / PAGE_SIZE
        return None
    Some(vaddr)

# Map `pages` frames from `phys` at `vaddr` in `pml4`. On a failure the
# leaves this call installed are cleared again (the frames stay the
# caller's) and it returns false.
fn map_run(pml4: u64, vaddr: u64, phys: u64, pages: u64, flags: u64) -> bool
    var p: u64 = 0
    while p < pages
        if vmm_map_page_in(pml4, vaddr + p * PAGE_SIZE, phys + p * PAGE_SIZE, flags) != 0
            var q: u64 = 0
            while q < p
                vmm_unmap_page_in(pml4, vaddr + q * PAGE_SIZE)
                q = q + 1
            return false
        p = p + 1
    true

# DrvMmioMap for process `pid`, whose page table is `pml4` (above).
pub fn drv_mmio_map(pid: u32, pml4: u64, mmio_handle: u64) -> i64
    let object_id: u64 = match held_object(pid, mmio_handle, CAP_TYPE_MMIO)
        Some(id) => id
        None => return Errno.Perm as i64
    let window: VioWindow = match vio_window_find(object_id)
        Some(w) => w
        None => return Errno.Inval as i64
    if vio_window_guarded(window)
        return Errno.Inval as i64
    let pages: u64 = vio_window_pages(window)
    let vaddr: u64 = match window_room(pml4, DRV_MMIO_BASE, pages)
        Some(v) => v
        None => return Errno.NoMem as i64
    if not map_run(pml4, vaddr, window.page_base, pages, drv_mmio_leaf())
        return Errno.NoMem as i64
    vaddr as i64

# DrvDmaAlloc for process `pid`, whose page table is `pml4` and loaded
# (`out` is checked against it), above.
fn drv_dma_alloc(pid: u32, pml4: u64, irq_handle: u64, size: u64, out: *DmaAlloc) -> i64
    if held_object(pid, irq_handle, CAP_TYPE_IRQ).is_none()
        return Errno.Perm as i64
    if size == 0
        return Errno.Inval as i64
    if size > DMA_ALLOC_MAX
        return Errno.NoMem as i64
    if uptr_check_write(out as *u8, sizeof(DmaAlloc) as u64) != 0
        return Errno.Fault as i64
    let pages: u64 = (size + PAGE_SIZE - 1) / PAGE_SIZE
    let vaddr: u64 = match window_room(pml4, DRV_DMA_BASE, pages)
        Some(v) => v
        None => return Errno.NoMem as i64
    let phys: u64 = match dma_alloc_zeroed(pages as u32)
        Some(p) => p
        None => return Errno.NoMem as i64
    if not map_run(pml4, vaddr, phys, pages, drv_dma_leaf())
        dma_free_pages(phys, pages as u32)
        return Errno.NoMem as i64
    (*out).iova = 0                     # no DMA domain yet (PR 5b)
    (*out).size = pages * PAGE_SIZE
    vaddr as i64

# drv_mmio_map(mmio_handle): the caller's page table is loaded.
pub fn sys_drv_mmio_map_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_mmio_map(proc_current_pid() as u32, vmm_get_current_pml4(), rdi)

# drv_dma_alloc(irq_handle, size, *DmaAlloc): the caller's page table is
# loaded.
pub fn sys_drv_dma_alloc_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_dma_alloc(proc_current_pid() as u32, vmm_get_current_pml4(), rdi, rsi, rdx as *DmaAlloc)

# ============================================================================
# ShmWait (229) and ShmNotify (230), #4727
# ============================================================================

# The longest ShmWait deadline, in ms, whose microseconds fit a u64: a
# longer one waits this long (about 585,000 years).
const SHM_WAIT_MAX_MS: u64 = 0xFFFFFFFFFFFFFFFF / US_PER_MS

# shm_wait for process `pid` (above). `ureq` is the caller's request.
fn shm_wait(pid: u32, ureq: *WaitRequest) -> i64
    var checked: CheckedRequest = match copy_request(pid, ureq, wait_plan_new())
        RequestCheck.Valid(c) => c
        RequestCheck.Refused(e) => return e as i64
    var ms: u64 = checked.deadline_ms
    if ms > SHM_WAIT_MAX_MS
        ms = SHM_WAIT_MAX_MS
    wait_collect(pid, ureq, @checked, deadline_after_us(ms * US_PER_MS))

# shm_notify for process `pid` (above). `bits` is the caller's whole
# register: a bit above the low 32 is no event bit either (Errno.Inval).
fn shm_notify_from(pid: u32, shm_handle: u64, bits: u64) -> i64
    let object_id: u64 = match held_object(pid, shm_handle, CAP_TYPE_SHM)
        Some(id) => id
        None => return Errno.Perm as i64
    if bits > 0xFFFFFFFF
        return Errno.Inval as i64
    disable_interrupts()
    let posted: Notify = shm_notify(object_id, pid as u64, bits as u32)
    enable_interrupts()
    match posted
        Notify.Posted => 0
        Notify.BadBits => Errno.Inval as i64
        Notify.NoPeer => Errno.NoDev as i64

# shm_wait(request): the caller's page table is loaded.
pub fn sys_shm_wait_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    shm_wait(proc_current_pid() as u32, rdi as *WaitRequest)

# shm_notify(shm_handle, bits).
pub fn sys_shm_notify_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    shm_notify_from(proc_current_pid() as u32, rdi, rsi)
