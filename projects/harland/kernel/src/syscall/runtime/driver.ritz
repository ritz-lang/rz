# Harland Syscall Runtime - driver waits (AGAST #4719, docs/RING1_DRIVER.md
# §4 "One waitable interrupt" and "Wait and notify")
#
# DrvIrqWait (220): drv_irq_wait(irq_handle, *WaitRequest). A driver process
# parks on its own wait set (proc/waitset.ritz) until the IRQ object its
# CAP_TYPE_IRQ handle names is hot, a listed shm source or its inbox has an
# event (#4727), or DEVICE_WAIT_MS has passed. One return copies every hot
# source that fits in out_cap, in order: the IRQ, the listed sources in the
# caller's order, then inbox records (waitset_collect). What does not fit
# stays latched for the next call, and only what was copied is cleared.
#
#   0   the IRQ record was copied: out[0] = { irq_handle, EVENT_DATA },
#       seen = latched (the same interrupt does not complete the next
#       call), and out[1..out_count] are any other events that fit
#   2   events were copied and the IRQ was not hot: out_count of them
#   1   the deadline passed: out_count = 0 and out is not written
#   <0  an errno, with nothing consumed and nothing written:
#       Errno.Perm   the caller holds no CAP_TYPE_IRQ handle `irq_handle`
#                    (every process the kernel did not spawn for a device),
#                    or lists a source that is not its CAP_TYPE_SHM handle
#       Errno.Fault  the request, the source array or the out range is not
#                    the caller's memory
#       Errno.Inval  source_count above WAIT_SOURCE_CAP, out_cap 0 or above
#                    WAIT_OUT_CAP
#       Errno.NoDev  the handle names no registered IRQ object
#       Errno.Again  this CPU cannot park (not the BSP, or no process)
#
# An ATTACH record copied out for an object already retired drops the
# caller's handle for it before the wait returns; the record still names
# the handle (#4728, RING1_DRIVER.md "Grants").
#
# The request and the source array are copied into kernel memory before a
# latch is cleared; the user source array is never written. The deadline is
# now + DEVICE_WAIT_MS on this process's wait set; WaitRequest.deadline is
# ShmWait's (229) and is ignored here. A wake that matches nothing before
# the deadline (another object's interrupt reaching this owner, a notify of
# a bit outside a source's mask) parks again; it is not a return of 1. The shared LAPIC
# watchdog and the BLOCK_IRQ queue that irq_wait_vector (NVMe, virtio) uses
# are not touched. A process marked PROC_REAP stops waiting: its return to
# user exits instead (syscall_entry.s reap_if_marked).
#
# ShmWait (229): shm_wait(*WaitRequest) is the same wait with no IRQ, for a
# process with no IRQ capability (the ring-2 service). Its deadline is
# WaitRequest.deadline milliseconds from the call (Harland has no user
# clock to name an absolute one); 0 checks once. 2 events, 1 the deadline,
# or Perm / Fault / Inval / Again as above.
#
# ShmNotify (230): shm_notify(shm_handle, bits) ORs DATA and/or SPACE into
# the latch of every other process holding that shm object, mapped or not,
# and wakes the one parked on its wait set. 0, or Errno.Perm (no such
# CAP_TYPE_SHM handle), Errno.Inval (bits 0 or any other bit: PEER_CLOSE,
# DRIVER_GONE, LINK and ATTACH are kernel posts, proc/waitset.ritz
# shm_latch_post and waitset_inbox_post), Errno.NoDev (no other holder).
# Nothing is posted on an errno.

import io { disable_interrupts, enable_interrupts }
import mm.uptr { uptr_check_read, uptr_check_write }
import ritzlib.option
import syscall.errno { Errno }
import cap.types { CapEntry, CAP_TYPE_IRQ, CAP_TYPE_MMIO, CAP_TYPE_SHM, cap_handle_init }
import cap.table { CapTable, cap_table_get, cap_table_lookup, cap_revoke, cap_irq_owner }
import mm.shm { shm_live, shm_detach_expired }
import proc.table { BLOCK_WAIT, proc_current, proc_current_pid, proc_current_slot, proc_block, proc_unblock_current, proc_reap_pending, proc_on_cpu }
import mm.tlb { TLB_CLEAR, TLB_QUARANTINE, tlb_unmap_on }
import proc.sched { sched_block }
import proc.waitq { waitq_can_park }
import proc.waitset { irq_object_known, irq_object_domain, waitset_arm, waitset_disarm }
import proc.waitset { WaitPlan, Collected, Notify, wait_plan_new, wait_plan_irq, wait_plan_add, waitset_collect, waitset_pending, shm_notify }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import driver_abi.wait { WaitRequest, WaitSource, WaitEvent, EVENT_ATTACH, WAIT_SOURCE_CAP, WAIT_OUT_CAP, DEVICE_WAIT_MS }
import mm.pmm { PAGE_SIZE }
import mm.vmm { PTE_WRITABLE, PTE_USER, PTE_WRITE_THROUGH, PTE_CACHE_DISABLE, PTE_DEVICE, DRV_DMA_BASE, DRV_MMIO_BASE, vmm_map_page_in, vmm_unmap_page_in, vmm_nx_flag, vmm_slot_end, vmm_get_current_pml4 }
import mm.dma { dma_alloc_zeroed, dma_free_pages, dma_quarantine_iova }
import mm.dma_runs { DmaRun, DmaRange, dma_run_room, dma_run_add, dma_run_take, dma_run_take_pid, dma_run_take_device, dma_hole_put, dma_hole_take, dma_hole_floor, dma_holes_drop_pid }
import drivers.virtio.window { VioWindow, vio_window_find, vio_window_pages, vio_window_guarded, vio_window_queue_regs }
import drivers.iommu.vtd { VtdEnter }
import drivers.iommu.ir { dma_requester_isolated, dma_domain_iova_alloc, dma_domain_enter_at, dma_domain_leave }
import driver_abi.dma { DmaAlloc, DMA_ALLOC_MAX }
import klog { klog, klog_dec, klog_hex }
import drivers.msix { msix_mask_entries }
import drivers.virtio.common { vio_status_reset }
import syscall.runtime.net { net_driver_quiesced, pml4_of }
import net.ring { ring_seat_driver_is, ring_driver_gone }

const US_PER_MS: u64 = 1000

# Parks DrvIrqWait and ShmWait have made, re-parks included (the
# drv-irq-wait and shm-wait boot tests read it to see a wait park).
var drv_irq_wait_parks: u64 = 0

pub fn drv_irq_wait_park_count() -> u64
    drv_irq_wait_parks

# The object id behind packed handle `packed` (index | generation << 32) in
# `pid`'s table, if it is a `cap_type` handle the process holds.
fn held_object(pid: u32, packed: u64, cap_type: u8) -> Option<u64>
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return None
    let index: u32 = (packed & 0xFFFFFFFF) as u32
    let generation: u32 = (packed >> 32) as u32
    let entry: *CapEntry = cap_table_lookup(table, cap_handle_init(index, generation))
    if entry == 0 as *CapEntry or entry.cap_type != cap_type
        return None
    Some(entry.object_id)

# What copy_request found: the plan, with the listed sources resolved to
# their objects, or the errno. Not a Result: VtdDma and goliath's
# ErrorCode, both in this module's import closure, declare `Ok` too, so a
# bare `Ok(x)` is ambiguous here and Result has no qualified constructor.
enum RequestCheck
    Valid(CheckedRequest)
    Refused(Errno)

# A request copied into kernel memory and checked.
struct CheckedRequest
    plan: WaitPlan
    out: *WaitEvent         # the caller's out range, checked writable
    out_cap: u32
    _pad: u32
    deadline_ms: u64        # ShmWait's WaitRequest.deadline

# The caller's request (`ureq`), copied into kernel memory and checked
# against `plan` (the IRQ, or none), or the errno that refuses it: Fault,
# Inval or Perm (above). Each listed source is copied before its handle is
# checked, so the check reads the kernel's copy and never a second read of
# the user array. The out range is checked too, so storing the result
# cannot fault. Nothing is consumed here.
fn copy_request(pid: u32, ureq: *WaitRequest, plan: WaitPlan) -> RequestCheck
    # Writable, for out_count.
    if uptr_check_write(ureq as *u8, sizeof(WaitRequest) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    let req: WaitRequest = *ureq
    if req.source_count > WAIT_SOURCE_CAP or req.out_cap == 0 or req.out_cap > WAIT_OUT_CAP
        return RequestCheck.Refused(Errno.Inval)
    let count: u64 = req.source_count as u64
    if count > 0 and uptr_check_read(req.sources as *u8, count * sizeof(WaitSource) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    var checked: CheckedRequest
    checked.plan = plan
    var i: u64 = 0
    while i < count
        let source: WaitSource = *(req.sources + i)
        let object_id: u64 = match held_object(pid, source.handle, CAP_TYPE_SHM)
            Some(id) => id
            None => return RequestCheck.Refused(Errno.Perm)
        wait_plan_add(@checked.plan, source.handle, object_id, source.mask)
        i = i + 1
    if uptr_check_write(req.out as *u8, req.out_cap as u64 * sizeof(WaitEvent) as u64) != 0
        return RequestCheck.Refused(Errno.Fault)
    checked.out = req.out
    checked.out_cap = req.out_cap
    checked._pad = 0
    checked.deadline_ms = req.deadline
    RequestCheck.Valid(checked)

# An ATTACH record copied out for an object that is already retired (an
# app that exited before the service mapped its exchange): the record still
# names the handle, and the handle goes before the wait returns (#4728,
# RING1_DRIVER.md "Grants"). Any other record, or a live object, is left.
fn drop_if_retired(pid: u32, event: WaitEvent)
    if (event.bits & EVENT_ATTACH) == 0
        return
    let object_id: u64 = match held_object(pid, event.handle, CAP_TYPE_SHM)
        Some(id) => id
        None => return
    if not shm_live(object_id)
        let index: u32 = (event.handle & 0xFFFFFFFF) as u32
        let generation: u32 = (event.handle >> 32) as u32
        cap_revoke(cap_table_get(pid), cap_handle_init(index, generation))

# Collect for the calling process (`pid`) under `checked`, parking on its
# wait set until something matches or TSC `deadline` passes: 0 (the IRQ
# record was copied), 2 (events without the IRQ) or 1 (the deadline), with
# out_count written; Errno.Again when this CPU cannot park or the process
# is marked to exit (nothing consumed; its return to user exits instead).
fn wait_collect(pid: u32, ureq: *WaitRequest, checked: *CheckedRequest, deadline: u64) -> i64
    disable_interrupts()
    if not waitq_can_park()
        enable_interrupts()
        return Errno.Again as i64
    let slot: i32 = proc_current_slot()
    var result: i64 = 1
    while true
        if proc_reap_pending(proc_current())
            result = Errno.Again as i64
            break
        # A retired object's mapping past SHM_DETACH_TIMEOUT_MS goes before
        # this wait returns to user with it (#4729): the tick over kernel
        # code only wakes a parked holder to run this.
        shm_detach_expired()
        let got: Collected = waitset_collect(@checked.plan, pid as u64, checked.out_cap)
        if got.count > 0
            var i: u32 = 0
            while i < got.count
                *(checked.out + i as u64) = got.events[i as i32]
                drop_if_retired(pid, got.events[i as i32])
                i = i + 1
            (*ureq).out_count = got.count
            result = if got.irq then 0 else 2
            break
        if deadline_passed(deadline)
            (*ureq).out_count = 0
            result = 1
            break
        waitset_arm(slot, deadline)
        drv_irq_wait_parks = drv_irq_wait_parks + 1
        # The eventcount sleep (SMP_USER.md §4): announce BLOCKED with a
        # locked xchg, then re-check; a post that landed after the collect
        # above keeps it running ("sleep.announce", "sleep.recheck").
        proc_block(BLOCK_WAIT, 0)
        if waitset_pending(@checked.plan, pid as u64)
            proc_unblock_current()
        sched_block()
    waitset_disarm(slot)
    enable_interrupts()
    result

# drv_irq_wait for process `pid` (above). `ureq` is the caller's request.
fn drv_irq_wait(pid: u32, irq_handle: u64, ureq: *WaitRequest) -> i64
    # Authority first: a process without the handle learns nothing else.
    let object_id: u64 = match held_object(pid, irq_handle, CAP_TYPE_IRQ)
        Some(id) => id
        None => return Errno.Perm as i64
    var checked: CheckedRequest = match copy_request(pid, ureq, wait_plan_irq(irq_handle, object_id))
        RequestCheck.Valid(c) => c
        RequestCheck.Refused(e) => return e as i64
    if not irq_object_known(object_id)
        return Errno.NoDev as i64
    wait_collect(pid, ureq, @checked, deadline_after_us(DEVICE_WAIT_MS * US_PER_MS))

# drv_irq_wait(irq_handle, request): the caller's page table is loaded.
pub fn sys_drv_irq_wait_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_irq_wait(proc_current_pid() as u32, rdi, rsi as *WaitRequest)

# ============================================================================
# DrvMmioMap (221), DrvDmaAlloc (222) and DrvDmaFree (223), AGAST #4720,
# #4721 and #4725 (docs/RING1_DRIVER.md §5 "MMIO and DMA syscalls", PR 5)
# ============================================================================
#
# DrvMmioMap(mmio_handle) maps every page of the window that the caller's
# CAP_TYPE_MMIO handle names, uncached, into the caller's PML4 only, from
# the next free page of its MMIO window (DRV_MMIO_BASE, PML4[253]). It
# returns the VA of the window's first page; the driver adds the window's
# byte offset itself. The window is the kernel's record
# (drivers/virtio/window.ritz); the advisory copy in the shared page is
# never read.
#
#   Errno.Perm   the caller holds no CAP_TYPE_MMIO handle `mmio_handle`, or
#                a page of the window holds the device's queue-address
#                registers (COMMON_CFG) and the device is not in a private
#                DMA domain with every alias named (AGAST #4724): those
#                registers would let it DMA anywhere its requester reaches
#   Errno.Inval  the object is no recorded window, or a page of it holds the
#                MSI-X table or PBA: nothing is mapped
#   Errno.NoMem  the window has no room, or a page table could not be had:
#                the pages this call installed are unmapped again
#
# DrvDmaAlloc(irq_handle, size, *DmaAlloc) allocates one zeroed contiguous
# run of `size` bytes rounded up to pages and maps it write-back into the
# caller's DMA window (DRV_DMA_BASE, PML4[252]). It returns the run's VA and
# copies out { iova, size }. When the IRQ object's device has a private DMA
# domain (irq_object_bind_domain, AGAST #4724) the run is mapped read-write
# into it first, and iova is where the device sees the run; otherwise
# nothing the device can use is published: iova is 0, and the run is for
# the CPU only. The VA and IOVA are the front of a range this process and
# device freed (mm/dma_runs.ritz), else fresh: past every such range and
# never handed out before. The run is not a DmaRegion: the PML4 owns it,
# exit frees it once (no PTE_DEVICE), and it is recorded live for
# DrvDmaFree. A failure after the run entered the domain takes it out
# again; if a unit doesn't confirm that, the device may still reach the
# pages and they go to dma_quarantine with the IOVA, never to the PMM, and
# that IOVA is never used again.
#
#   Errno.Perm   the caller holds no CAP_TYPE_IRQ handle `irq_handle`
#   Errno.Inval  size 0
#   Errno.NoMem  size above DMA_ALLOC_MAX (4 MiB), no contiguous run free, no
#                room in the window or the run table, or no page table:
#                nothing stays mapped or allocated
#   Errno.Fault  the DmaAlloc is not the caller's writable memory (checked
#                before anything is allocated)
#
# DrvDmaFree(irq_handle, vaddr, size) gives back the live run that starts at
# `vaddr` and is `size` bytes rounded up to pages, exactly as DrvDmaAlloc
# made it for this process and this device. The IOVA leaves the device's
# domain and the kernel waits for every unit's IOTLB invalidation; only
# then are the CPU leaves unmapped, the frames returned to the PMM, and
# both ranges put on the free list. If a unit doesn't confirm, the device
# may still reach the frames: the CPU leaves are quarantined (not present,
# PTE_DEVICE: a stale pointer faults and exit doesn't free them), the
# frames and the IOVA go on dma_quarantine, and neither the VA nor the IOVA
# is handed out again until reboot. The driver frees a run only once no
# queue register or descriptor names it; the kernel doesn't parse rings.
#
#   0            freed (or quarantined: the run is gone either way)
#   Errno.Perm   the caller holds no CAP_TYPE_IRQ handle `irq_handle`
#   Errno.Inval  size 0, or no live run of this process and device starts
#                at `vaddr` with that many pages (a part of a run, a run
#                already freed): nothing changes

# MMIO leaves: the kernel's vmm_map_mmio type (PCD|PWT, uncached) plus user
# and PTE_DEVICE, so the frame is never returned to the PMM on exit.
pub fn drv_mmio_leaf() -> u64
    PTE_WRITABLE | PTE_USER | PTE_WRITE_THROUGH | PTE_CACHE_DISABLE | PTE_DEVICE | vmm_nx_flag()

# DMA leaves: write-back RAM the process owns (§5: virtio-pci on x86 is
# DMA-coherent).
pub fn drv_dma_leaf() -> u64
    PTE_WRITABLE | PTE_USER | vmm_nx_flag()

const SLOT_BYTES: u64 = 1 << 39        # one PML4 entry

# The next free address in the window at `base`, if `pages` more fit.
fn window_room(pml4: u64, base: u64, pages: u64) -> Option<u64>
    let vaddr: u64 = vmm_slot_end(pml4, base)
    if pages > (base + SLOT_BYTES - vaddr) / PAGE_SIZE
        return None
    Some(vaddr)

# Map `pages` frames from `phys` at `vaddr` in `pml4`. On a failure the
# leaves this call installed are cleared again (the frames stay the
# caller's) and it returns false.
fn map_run(pml4: u64, vaddr: u64, phys: u64, pages: u64, flags: u64) -> bool
    var p: u64 = 0
    while p < pages
        if vmm_map_page_in(pml4, vaddr + p * PAGE_SIZE, phys + p * PAGE_SIZE, flags) != 0
            var q: u64 = 0
            while q < p
                vmm_unmap_page_in(pml4, vaddr + q * PAGE_SIZE)
                q = q + 1
            return false
        p = p + 1
    true

# DrvMmioMap for process `pid`, whose page table is `pml4` (above).
pub fn drv_mmio_map(pid: u32, pml4: u64, mmio_handle: u64) -> i64
    let object_id: u64 = match held_object(pid, mmio_handle, CAP_TYPE_MMIO)
        Some(id) => id
        None => return Errno.Perm as i64
    let window: VioWindow = match vio_window_find(object_id)
        Some(w) => w
        None => return Errno.Inval as i64
    if vio_window_guarded(window)
        return Errno.Inval as i64
    if vio_window_queue_regs(window) and not dma_requester_isolated(window.sid)
        return Errno.Perm as i64
    let pages: u64 = vio_window_pages(window)
    let vaddr: u64 = match window_room(pml4, DRV_MMIO_BASE, pages)
        Some(v) => v
        None => return Errno.NoMem as i64
    if not map_run(pml4, vaddr, window.page_base, pages, drv_mmio_leaf())
        return Errno.NoMem as i64
    vaddr as i64

# A boot-test hook (drv-dma-free, postinit.ritz): the next leave of the run
# at this VA reports an unconfirmed invalidation, once, as a unit that
# timed out would. 0: none.
var drv_dma_stuck_vaddr: u64 = 0

pub fn drv_dma_force_stuck(vaddr: u64)
    drv_dma_stuck_vaddr = vaddr

# Take `run` out of its device's domain and wait for every unit: true once
# the device can reach none of it (without a domain it never could).
fn run_left_domain(run: DmaRun) -> bool
    var confirmed: bool = true
    if run.dom != 0
        confirmed = dma_domain_leave(run.dom, run.iova, run.pages)
    if drv_dma_stuck_vaddr != 0 and run.vaddr == drv_dma_stuck_vaddr
        drv_dma_stuck_vaddr = 0
        confirmed = false
    confirmed

# Clear the `pages` leaves from `vaddr` in process `pid`'s `pml4`; the frames
# stay the caller's. The driver may be on another CPU (netd on its AP,
# #4875), so the CPU it is on clears and flushes them (mm/tlb.ritz), and
# this returns only once it has: the caller frees the frames after.
fn unmap_run(pid: u32, pml4: u64, vaddr: u64, pages: u64)
    tlb_unmap_on(proc_on_cpu(pid as u64), pid as u64, pml4, vaddr, pages, TLB_CLEAR)

# Quarantine the `pages` leaves from `vaddr` in process `pid`'s `pml4`
# (vmm_quarantine_page_in), on the CPU it is on as unmap_run.
fn quarantine_leaves(pid: u32, pml4: u64, vaddr: u64, pages: u64)
    tlb_unmap_on(proc_on_cpu(pid as u64), pid as u64, pml4, vaddr, pages, TLB_QUARANTINE)

# The next free address of `pid`'s DMA window for `pages` more pages: past
# its last leaf (a quarantined one included) and past every range on its
# free list, which has no leaves but is not free to bump over.
fn dma_window_room(pid: u32, pml4: u64, pages: u64) -> Option<u64>
    var vaddr: u64 = vmm_slot_end(pml4, DRV_DMA_BASE)
    let floor: u64 = dma_hole_floor(pid, DRV_DMA_BASE)
    if floor > vaddr
        vaddr = floor
    if pages > (DRV_DMA_BASE + SLOT_BYTES - vaddr) / PAGE_SIZE
        return None
    Some(vaddr)

# A VA (and, in domain `dom`, an IOVA) range never handed out before.
fn fresh_range(pid: u32, pml4: u64, dom: u32, pages: u64) -> Option<DmaRange>
    let vaddr: u64 = match dma_window_room(pid, pml4, pages)
        Some(v) => v
        None => return None
    if dom == 0
        return Some(DmaRange { vaddr: vaddr, iova: 0, pages: pages })
    let iova: u64 = match dma_domain_iova_alloc(dom, pages)
        Some(v) => v
        None => return None
    Some(DmaRange { vaddr: vaddr, iova: iova, pages: pages })

# DrvDmaAlloc for process `pid`, whose page table is `pml4` and loaded
# (`out` is checked against it), above.
fn drv_dma_alloc(pid: u32, pml4: u64, irq_handle: u64, size: u64, out: *DmaAlloc) -> i64
    let object_id: u64 = match held_object(pid, irq_handle, CAP_TYPE_IRQ)
        Some(id) => id
        None => return Errno.Perm as i64
    if size == 0
        return Errno.Inval as i64
    if size > DMA_ALLOC_MAX
        return Errno.NoMem as i64
    if uptr_check_write(out as *u8, sizeof(DmaAlloc) as u64) != 0
        return Errno.Fault as i64
    # Room to record the run first: a run that can't be freed is never made.
    if not dma_run_room()
        return Errno.NoMem as i64
    let pages: u64 = (size + PAGE_SIZE - 1) / PAGE_SIZE
    let dom: u32 = irq_object_domain(object_id)
    let range: DmaRange = match dma_hole_take(pid, object_id, pages, dom != 0)
        Some(r) => r
        None => match fresh_range(pid, pml4, dom, pages)
            Some(r) => r
            None => return Errno.NoMem as i64
    let phys: u64 = match dma_alloc_zeroed(pages as u32)
        Some(p) => p
        None =>
            dma_hole_put(pid, object_id, range)
            return Errno.NoMem as i64
    # The device's view first: a run the CPU can't map is taken out again.
    var iova: u64 = 0
    if dom != 0
        match dma_domain_enter_at(dom, range.iova, phys, pages)
            VtdEnter.Entered(v) => iova = v
            VtdEnter.Refused =>
                dma_free_pages(phys, pages as u32)
                dma_hole_put(pid, object_id, range)
                return Errno.NoMem as i64
            VtdEnter.Stuck =>
                dma_quarantine_iova(phys, pages, range.iova)
                return Errno.NoMem as i64
    let run: DmaRun = DmaRun { pid: pid, dom: dom, object_id: object_id, vaddr: range.vaddr, iova: iova, phys: phys, pages: pages }
    if not map_run(pml4, run.vaddr, phys, pages, drv_dma_leaf())
        if run_left_domain(run)
            dma_free_pages(phys, pages as u32)
            dma_hole_put(pid, object_id, range)
        else
            dma_quarantine_iova(phys, pages, iova)
        return Errno.NoMem as i64
    dma_run_add(run)                    # room was checked above
    if dom != 0
        # The evidence tools/test_msix_boot.sh matches a received frame's
        # IOVA against (AGAST #4735): a run in the device's private domain.
        klog("[nic-dma] DrvDmaAlloc: pid ")
        klog_dec(pid as i64)
        klog(", ")
        klog_dec(pages as i64)
        klog(" page(s) at IOVA 0x")
        klog_hex(iova)
        klog(" in domain ")
        klog_dec(dom as i64)
        klog("\n")
    (*out).iova = iova                  # 0: no private domain, the run is the CPU's only
    (*out).size = pages * PAGE_SIZE
    run.vaddr as i64

# DrvDmaFree for process `pid`, whose page table is `pml4` and loaded, above.
fn drv_dma_free(pid: u32, pml4: u64, irq_handle: u64, vaddr: u64, size: u64) -> i64
    let object_id: u64 = match held_object(pid, irq_handle, CAP_TYPE_IRQ)
        Some(id) => id
        None => return Errno.Perm as i64
    # No run is empty or above DMA_ALLOC_MAX (and the page count can't wrap).
    if size == 0 or size > DMA_ALLOC_MAX
        return Errno.Inval as i64
    let pages: u64 = (size + PAGE_SIZE - 1) / PAGE_SIZE
    let run: DmaRun = match dma_run_take(pid, object_id, vaddr, pages)
        Some(r) => r
        None => return Errno.Inval as i64
    if run_left_domain(run)
        unmap_run(pid, pml4, run.vaddr, run.pages)
        dma_free_pages(run.phys, run.pages as u32)
        dma_hole_put(pid, object_id, DmaRange { vaddr: run.vaddr, iova: run.iova, pages: run.pages })
    else
        quarantine_leaves(pid, pml4, run.vaddr, run.pages)
        dma_quarantine_iova(run.phys, run.pages, run.iova)
    0

# Process `pid` is exiting and its page table `pml4` (no longer loaded) is
# about to be freed: each live run leaves its device's domain, and one a
# unit doesn't confirm is quarantined so vmm_free_pml4 skips its frames;
# the confirmed ones vmm_free_pml4 frees once. Its free list is forgotten
# with the address space. Every process's exit calls this; one that never
# allocated a run has nothing recorded.
pub fn drv_dma_process_end(pid: u32, pml4: u64)
    while true
        let run: DmaRun = match dma_run_take_pid(pid)
            Some(r) => r
            None => break
        if not run_left_domain(run)
            quarantine_leaves(pid, pml4, run.vaddr, run.pages)
            dma_quarantine_iova(run.phys, run.pages, run.iova)
    dma_holes_drop_pid(pid)

# ============================================================================
# driver_quiesce (#4733, RING1_DRIVER.md "Driver death")
# ============================================================================
#
# What the kernel needs to stop a ring-1 driver's device without it: the
# kernel VAs (its own mappings, which outlive the process) of the device's
# virtio device_status byte and of its MSI-X table, recorded against the
# device's IRQ object when the kernel hands the device out. The process is
# never given the MSI-X table.

const DRV_DEVICE_MAX: i32 = 16      # one per IRQ object (waitset IRQ_OBJECT_MAX)

pub struct DrvDevice
    object_id: u64          # the CAP_TYPE_IRQ object: the device
    status_va: u64          # kernel VA of the virtio device_status byte
    msix_table_va: u64      # kernel VA of MSI-X entry 0, 0 for none
    msix_entries: u32
    in_use: bool
    _pad: [3]u8

var drv_devices: [16]DrvDevice      # DRV_DEVICE_MAX

fn drv_device_slot(object_id: u64) -> i32
    var i: i32 = 0
    while i < DRV_DEVICE_MAX
        if drv_devices[i].in_use and drv_devices[i].object_id == object_id
            return i
        i = i + 1
    -1

# The kernel records how to quiesce the device behind IRQ object
# `object_id`. False if it is already recorded or the table is full.
pub fn drv_device_bind(object_id: u64, status_va: u64, msix_table_va: u64, msix_entries: u32) -> bool
    if object_id == 0 or drv_device_slot(object_id) >= 0
        return false
    var i: i32 = 0
    while i < DRV_DEVICE_MAX
        if not drv_devices[i].in_use
            drv_devices[i] = DrvDevice { object_id: object_id, status_va: status_va, msix_table_va: msix_table_va, msix_entries: msix_entries, in_use: true, _pad: [0, 0, 0] }
            return true
        i = i + 1
    false

# Forget the record (the boot-test doubles only: a probed device lives
# until reboot).
pub fn drv_device_unbind(object_id: u64)
    let slot: i32 = drv_device_slot(object_id)
    if slot >= 0
        drv_devices[slot].in_use = false

# Stop device `dev`, whose IRQ owner `pid` (page table `pml4`, 0 for none)
# is dying or has let go of it: mask its MSI-X entries, reset it and read
# the reset back, then take each of `pid`'s DMA runs of the device out of
# its domain and wait for the IOTLB. A run is left for vmm_free_pml4 to
# free (once) only when both the reset and its invalidation completed;
# otherwise its leaves get PTE_DEVICE (the free walk skips them) and its
# frames and IOVA go on dma_quarantine until reboot. Never dma_free_pages:
# the PML4's teardown is the one free. Logs "[quiesce] pid P status S"
# (S is the last status read: 0 once the reset completed).
fn quiesce_device(pid: u32, pml4: u64, dev: DrvDevice)
    msix_mask_entries(dev.msix_table_va, dev.msix_entries)
    let status: u8 = vio_status_reset(dev.status_va)
    let reset_ok: bool = status == 0
    var quarantined: u64 = 0
    while true
        let run: DmaRun = match dma_run_take_device(pid, dev.object_id)
            Some(r) => r
            None => break
        let left: bool = run_left_domain(run)
        if reset_ok and left
            continue
        if pml4 != 0
            quarantine_leaves(pid, pml4, run.vaddr, run.pages)
        dma_quarantine_iova(run.phys, run.pages, run.iova)
        quarantined = quarantined + run.pages
    klog("[quiesce] pid ")
    klog_dec(pid as i64)
    klog(" status ")
    klog_dec(status as i64)
    klog("\n")
    if quarantined != 0
        klog("[quiesce] pid ")
        klog_dec(pid as i64)
        klog(" quarantined ")
        klog_dec(quarantined as i64)
        klog(" pages\n")

# Step 4 for driver `pid`, gone from its device: the snapshot and the frame
# registration go (net_driver_quiesced) and, if `pid` is the kernel seat's
# driver, so does the seat's registration (ring_driver_gone), so a parked
# take_rx answers NoDriver.
fn driver_gone(pid: u32)
    net_driver_quiesced(pid)
    if ring_seat_driver_is(pid)
        ring_driver_gone()

# Process `pid` is exiting (sys_exit_impl, on the kernel PML4, before its
# shm objects are retired, its capability table freed and `pml4` torn
# down): quiesce every recorded device it owns the IRQ of, then, if there
# was one, driver_gone: the link snapshot is invalidated (NetInfo is NoDev)
# and the frame object's registration (and the kernel seat's) goes.
# cap_retire_held_shm then retires the frame object and latches DRIVER_GONE
# on the consumer. A pid that owns no recorded device changes nothing.
pub fn driver_quiesce(pid: u32, pml4: u64)
    var owned: bool = false
    var i: i32 = 0
    while i < DRV_DEVICE_MAX
        if drv_devices[i].in_use and cap_irq_owner(drv_devices[i].object_id) == pid
            quiesce_device(pid, pml4, drv_devices[i])
            owned = true
        i = i + 1
    if owned
        driver_gone(pid)

# Process `pid` dropped its last IRQ handle for `object_id` (cap/table.ritz
# cap_last_handle_dropped, while it is still the recorded owner): the device
# is quiesced as on its death, the process's runs of it leave the domain
# (they stay mapped, and its exit frees the confirmed ones once), and the
# snapshot goes. Nothing for an object with no device record.
pub fn driver_quiesce_object(pid: u32, object_id: u64)
    let slot: i32 = drv_device_slot(object_id)
    if slot < 0 or cap_irq_owner(object_id) != pid
        return
    quiesce_device(pid, pml4_of(pid), drv_devices[slot])
    driver_gone(pid)

# drv_mmio_map(mmio_handle): the caller's page table is loaded.
pub fn sys_drv_mmio_map_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_mmio_map(proc_current_pid() as u32, vmm_get_current_pml4(), rdi)

# drv_dma_alloc(irq_handle, size, *DmaAlloc): the caller's page table is
# loaded.
pub fn sys_drv_dma_alloc_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_dma_alloc(proc_current_pid() as u32, vmm_get_current_pml4(), rdi, rsi, rdx as *DmaAlloc)

# drv_dma_free(irq_handle, vaddr, size): the caller's page table is loaded.
pub fn sys_drv_dma_free_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    drv_dma_free(proc_current_pid() as u32, vmm_get_current_pml4(), rdi, rsi, rdx)

# ============================================================================
# ShmWait (229) and ShmNotify (230), #4727
# ============================================================================

# The longest ShmWait deadline, in ms, whose microseconds fit a u64: a
# longer one waits this long (about 585,000 years).
const SHM_WAIT_MAX_MS: u64 = 0xFFFFFFFFFFFFFFFF / US_PER_MS

# shm_wait for process `pid` (above). `ureq` is the caller's request.
fn shm_wait(pid: u32, ureq: *WaitRequest) -> i64
    var checked: CheckedRequest = match copy_request(pid, ureq, wait_plan_new())
        RequestCheck.Valid(c) => c
        RequestCheck.Refused(e) => return e as i64
    var ms: u64 = checked.deadline_ms
    if ms > SHM_WAIT_MAX_MS
        ms = SHM_WAIT_MAX_MS
    wait_collect(pid, ureq, @checked, deadline_after_us(ms * US_PER_MS))

# shm_notify for process `pid` (above). `bits` is the caller's whole
# register: a bit above the low 32 is no event bit either (Errno.Inval).
fn shm_notify_from(pid: u32, shm_handle: u64, bits: u64) -> i64
    let object_id: u64 = match held_object(pid, shm_handle, CAP_TYPE_SHM)
        Some(id) => id
        None => return Errno.Perm as i64
    if bits > 0xFFFFFFFF
        return Errno.Inval as i64
    disable_interrupts()
    let posted: Notify = shm_notify(object_id, pid as u64, bits as u32)
    enable_interrupts()
    match posted
        Notify.Posted => 0
        Notify.BadBits => Errno.Inval as i64
        Notify.NoPeer => Errno.NoDev as i64

# shm_wait(request): the caller's page table is loaded.
pub fn sys_shm_wait_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    shm_wait(proc_current_pid() as u32, rdi as *WaitRequest)

# shm_notify(shm_handle, bits).
pub fn sys_shm_notify_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    shm_notify_from(proc_current_pid() as u32, rdi, rsi)
