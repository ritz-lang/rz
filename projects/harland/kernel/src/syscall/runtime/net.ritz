# Harland Syscall Runtime - Networking records and the app exchange
# (AGAST #4751; docs/RING1_DRIVER.md section 7, docs/RING2_NET.md)
#
# NetInfo (224) copies the ring-1 driver's link snapshot, NetAddr (225) the
# ring-2 service's address snapshot, and NetAttach (228) creates an app's
# exchange object with the registered service. No driver publishes a link
# record yet and no service registers, so each call answers what the spec
# names for that state: NetInfo and NetAddr "return Errno.NoDev while the
# generation is unpublished" and NetAttach with "no registered service ->
# Errno.NoDev". Nothing is written through the caller's pointer and nothing
# is allocated. #4730 (NetInfo), #4742 (NetAddr) and #4728 (NetAttach)
# replace these bodies with the snapshots and the exchange; the numbers and
# the NoDev answer they give on a boot without the service stay.
#
# Declaring the three now, with the answer the spec gives, is what lets
# indium's ping, udp-send and udp-recv end on NoDev rather than on the
# NoSys every undeclared number gets (and the "[syscall] unknown" log line).
# Each handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import syscall.errno { Errno }

# net_info(dst: *NetInfo) -> 0 or -errno
pub fn sys_net_info_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    Errno.NoDev as i64

# net_addr(dst: *NetAddr) -> 0 or -errno
pub fn sys_net_addr_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    Errno.NoDev as i64

# net_attach() -> the caller's exchange handle or -errno
pub fn sys_net_attach_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    Errno.NoDev as i64
