# Harland Syscall Runtime - Networking records and the app exchange
# (AGAST #4751, #4728, #4730, #4742; docs/RING1_DRIVER.md "Grants", section
# 7, docs/RING2_NET.md "Address publication")
#
# NetInfo (224): net_info(*NetInfo) copies the kernel's link snapshot. Any
# process may call it. 0, or:
#   Errno.NoDev  no stable generation is in the snapshot (none published
#                yet, or snapshot_invalidate ran): nothing is written
#   Errno.Fault  the NetInfo is not the caller's writable memory
#
# NetPublish (226): net_publish(handle) samples a registered seqlocked
# record (through the physmap) into its kernel snapshot. The armed
# service's ready publish is then held until the frame-seat handoff ends
# (#4744, below). For the link
# object, the ring-1 driver's NetInfo (driver_abi.link link_sample), and it
# ORs EVENT_LINK into the consumer's latch on the registered frame object;
# for the address object, the ring-2 service's NetAddr (addr_sample). 0, or:
#   Errno.Perm   the caller holds no CAP_TYPE_SHM handle `handle`, its
#                object is neither registered object, or the handle lacks
#                CAP_RIGHT_PUBLISH (every app-exchange handle)
#   Errno.Again  the seqlock word is odd, below 2, or changed during every
#                bounded retry: the previous snapshot stays
#
# NetAddr (225): net_addr(*NetAddr) copies the kernel's address snapshot,
# its generation the one NetPublish sampled. Any process may call it. It
# never reads the service's page and never returns a zeroed record. 0, or:
#   Errno.NoDev  no stable generation is in the snapshot: none published
#                yet, or the service exited or faulted (sys_exit_impl calls
#                net_service_exited), until a new service is registered and
#                publishes (the restart below), or for good once the
#                restart budget is spent
#   Errno.Fault  the NetAddr is not the caller's writable memory
#
# NetAttach (228): net_attach() creates the caller's exchange with the
# registered ring-2 service: a new ShmObject of APP_EXCHANGE_SIZE bytes, a
# read-write handle without the publish right (and without GRANT) in the
# app and in the service, and {service_handle, EVENT_ATTACH} on the
# service's inbox, which every wait of the service scans. Returns the app's
# packed handle, or (each creating nothing):
#   Errno.Exist  the caller still holds the handle of an exchange it
#                attached: one live exchange per app process, checked
#                first, so it holds after the service has gone (#4848)
#   Errno.NoDev  no service is registered (every boot today)
#   Errno.Again  the service's inbox holds INBOX_CAP records not yet copied
#                out; the app retries
#   Errno.Inval  the caller is the service
#   Errno.NoMem  no object, exchange record or handle slot to be had
#
# The service, the link object, the address object and the frame object's
# consumer are registered by the kernel (the boot that spawns them, and
# today the net-attach, net-info and net-addr boot tests); nothing else
# sets them.
#
# The restart (AGAST #4745, #4875, RING2_NET.md "Service binary and
# respawn", "Drivers inside netd (D9)"): once the frame seat is the
# service's, ring1.ritz arms it. Under D9 the service is the NIC's driver
# too, so its death is the one death path: driver_quiesce resets the NIC,
# then the death counts toward NETD_RESTARTS per boot (net_service_death);
# sys_exit_impl waits out net_restart_backoff_ms and ring1.ritz
# net_netd_respawn spawns /bin/netd again with the device grants, a new
# link page and a new address page (net_service_page, net_service_boot,
# net_service_attach_page), before it runs. It makes no frame object. Each
# handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import ritzlib.option
import io { disable_interrupts, enable_interrupts }
import syscall.errno { Errno }
import mm.uptr { uptr_check_write }
import mm.pmm { PAGE_SIZE }
import mm.vmm { phys_to_virt }
import mm.shm { shm_create, shm_destroy, shm_page, shm_map, shm_exists }
import cap.types { CapHandle, CapEntry, CAP_TYPE_SHM, CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_PUBLISH, cap_handle_init }
import cap.table { CapTable, cap_table_get, cap_table_lookup, cap_kernel_grant, cap_revoke, cap_holds_object }
import proc.table { MAX_PROCS, proc_at, proc_current_pid }
import proc.sched { sched_yield }
import proc.waitset { INBOX_CAP, waitset_inbox_len, waitset_inbox_post, shm_latch_post }
import driver_abi.wait { EVENT_ATTACH, EVENT_LINK, APP_EXCHANGE_SIZE }
import driver_abi.link { NetInfo, LinkSample, LINK_SEQ_UNPUBLISHED, LINK_SEQ_FIRST_STABLE, link_sample }
import driver_abi.link { NetAddr, AddrSample, addr_sample }
import driver_abi.boot { ServiceBoot, SERVICE_BOOT_MAGIC, service_boot_at }
import arch.x86_64.tsc { tsc_hz }

# ============================================================================
# Registration (the kernel only)
# ============================================================================

# The ring-2 service NetAttach attaches to, or 0.
var net_service: u32 = 0
# The driver's link object, and the frame object with its consumer (the
# process whose latch NetPublish posts LINK on); 0 for none.
var net_link_object: u64 = 0
var net_frame_object: u64 = 0
var net_frame_consumer: u64 = 0
# The service's address object (one page, mapped only into the service,
# the publish right on the service's handle), or 0.
var net_addr_object: u64 = 0

# Process `pid` is the ring-2 service: NetAttach hands it each exchange.
# 0 unregisters it.
pub fn net_service_register(pid: u32)
    net_service = pid

# Shm object `object_id` is the driver's link object: NetPublish samples it
# for a holder with CAP_RIGHT_PUBLISH. 0 unregisters it.
pub fn net_link_register(object_id: u64)
    net_link_object = object_id

# Shm object `object_id` is the service's address object: NetPublish
# samples it for a holder with CAP_RIGHT_PUBLISH. 0 unregisters it.
pub fn net_addr_register(object_id: u64)
    net_addr_object = object_id

# Shm object `object_id` is the frame object and `consumer` the process
# whose latch on it NetPublish posts EVENT_LINK to. 0 unregisters it.
pub fn net_frame_register(object_id: u64, consumer: u64)
    net_frame_object = object_id
    net_frame_consumer = consumer

# ============================================================================
# The frame-seat handoff gate (AGAST #4744, RING2_NET.md "Frame seat")
# ============================================================================
#
# The ready NetPublish of the service net_handoff_arm names commits its
# snapshot like any other (handoff_ready), then the call holds the service
# in the kernel, yielding, until pid 1 has tried its DHCPRELEASE and moved
# the seat (net_handoff_done): the kernel owns TX until then, and the
# service's next instruction may be a TX publish. Only that service, and
# only until the handoff ends either way; every other publish returns at
# once.

# The service whose ready publish the handoff waits on, or 0.
var handoff_service: u32 = 0
var handoff_ready: bool = false

# Pid 1, before service `pid` first runs.
pub fn net_handoff_arm(pid: u32)
    handoff_ready = false
    handoff_service = pid

# The armed service's NetPublish has committed a snapshot.
pub fn net_handoff_ready() -> bool
    handoff_ready

# The handoff is over (done, or given up): a held NetPublish returns.
pub fn net_handoff_done()
    handoff_service = 0

# ============================================================================
# The link snapshot: NetInfo (224) and NetPublish (226), #4730
# ============================================================================

# How many samples NetPublish takes while link_seq moves under it.
const LINK_SAMPLE_TRIES: i32 = 4

var link_snapshot: NetInfo
# The generation the snapshot was taken at; LINK_SEQ_UNPUBLISHED (0) until
# the first publish and after snapshot_invalidate.
var link_generation: u64 = 0

# The snapshot holds a stable generation: a ring-1 driver has published.
pub fn ring_driver_published() -> bool
    link_generation >= LINK_SEQ_FIRST_STABLE

# driver_quiesce's step 4 (#4733): NetInfo answers NoDev from now on, and
# the link object is no longer registered, so no later publish revives it.
# No zero MAC is stored into the snapshot.
pub fn snapshot_invalidate()
    disable_interrupts()
    link_generation = LINK_SEQ_UNPUBLISHED
    net_link_object = 0
    enable_interrupts()

# Driver `pid` died or gave up its device (driver_quiesce step 4, #4733):
# the snapshot is invalidated and, when `pid` holds the registered frame
# object, that registration goes too. The object itself is retired by
# cap_retire_held_shm (DRIVER_GONE); no replacement is made for it. Under
# D9 (#4875) the driver is netd, and whether it comes back is netd's
# restart, decided by the device's fitness (driver.ritz drv_device_fit),
# not here.
pub fn net_driver_quiesced(pid: u32)
    snapshot_invalidate()
    if net_frame_object != 0 and cap_holds_object(pid, CAP_TYPE_SHM, net_frame_object)
        net_frame_register(0, 0)

# The snapshot, if a stable generation is in it.
pub fn net_info_snapshot() -> Option<NetInfo>
    disable_interrupts()
    let published: bool = ring_driver_published()
    let copy: NetInfo = link_snapshot
    enable_interrupts()
    if not published
        return None
    Some(copy)

# NetInfo into `dst`, the caller's memory (checked here).
fn net_info(dst: *NetInfo) -> i64
    let copy: NetInfo = match net_info_snapshot()
        Some(n) => n
        None => return Errno.NoDev as i64
    if uptr_check_write(dst as *u8, sizeof(NetInfo) as u64) != 0
        return Errno.Fault as i64
    *dst = copy
    0

# The object behind `pid`'s CAP_TYPE_SHM handle `packed`, if it holds it
# with every right in `rights`.
fn held_shm(pid: u32, packed: u64, rights: u32) -> Option<u64>
    let table: *CapTable = cap_table_get(pid)
    if table == 0 as *CapTable
        return None
    let index: u32 = (packed & 0xFFFFFFFF) as u32
    let generation: u32 = (packed >> 32) as u32
    let entry: *CapEntry = cap_table_lookup(table, cap_handle_init(index, generation))
    if entry == 0 as *CapEntry or entry.cap_type != CAP_TYPE_SHM or (entry.rights & rights) != rights
        return None
    Some(entry.object_id)

# NetPublish for process `pid` (above).
pub fn net_publish_for(pid: u32, handle: u64) -> i64
    let object_id: u64 = match held_shm(pid, handle, CAP_RIGHT_PUBLISH)
        Some(id) => id
        None => return Errno.Perm as i64
    if object_id == 0 or (object_id != net_link_object and object_id != net_addr_object)
        return Errno.Perm as i64
    let frame: u64 = shm_page(object_id, 0)
    if frame == 0
        return Errno.Perm as i64
    let page: u64 = phys_to_virt(frame)
    if object_id == net_addr_object
        let r: i64 = addr_publish_page(page)
        if r == 0
            addr_publisher = pid
        if r == 0 and pid != 0 and pid == handoff_service
            handoff_ready = true
        return r
    link_publish_page(page)

# NetPublish of the link page at kernel address `page`.
fn link_publish_page(page: u64) -> i64
    var got: LinkSample = link_sample(page)
    var tries: i32 = 1
    while got.generation == LINK_SEQ_UNPUBLISHED and tries < LINK_SAMPLE_TRIES
        got = link_sample(page)
        tries = tries + 1
    if got.generation == LINK_SEQ_UNPUBLISHED
        return Errno.Again as i64
    disable_interrupts()
    link_snapshot = got.info
    link_generation = got.generation
    if net_frame_object != 0
        shm_latch_post(net_frame_object, net_frame_consumer, EVENT_LINK)
    enable_interrupts()
    0

# ============================================================================
# The address snapshot: NetAddr (225), #4742
# ============================================================================

var addr_snapshot: NetAddr
# The pid whose NetPublish committed the snapshot; 0 once it is invalidated
# (AGAST #4855: pid 1's restart test kills only after this instance's own
# configured publish).
var addr_publisher: u32 = 0
# The generation the snapshot was taken at; LINK_SEQ_UNPUBLISHED (0) until
# the service's first publish and after it exits or faults.
var addr_generation: u64 = 0

# NetPublish of the address page at kernel address `page`.
fn addr_publish_page(page: u64) -> i64
    var got: AddrSample = addr_sample(page)
    var tries: i32 = 1
    while got.generation == LINK_SEQ_UNPUBLISHED and tries < LINK_SAMPLE_TRIES
        got = addr_sample(page)
        tries = tries + 1
    if got.generation == LINK_SEQ_UNPUBLISHED
        return Errno.Again as i64
    disable_interrupts()
    addr_snapshot = got.addr
    addr_generation = got.generation
    enable_interrupts()
    0

# The address snapshot, if a stable generation is in it. Its _pad is zero
# whatever the service's page held.
pub fn net_addr_snapshot() -> Option<NetAddr>
    disable_interrupts()
    let published: bool = addr_generation >= LINK_SEQ_FIRST_STABLE
    var copy: NetAddr = addr_snapshot
    enable_interrupts()
    if not published
        return None
    for i in 0..7
        copy._pad[i] = 0
    Some(copy)

# The service's exit or fault path (sys_exit_impl, for every exiting
# process, after driver_quiesce has reset its NIC and cap_retire_held_shm
# has retired its exchanges, posting DRIVER_GONE to each app): when `pid` is
# the registered service, NetAddr answers NoDev from now on, the address
# object and the service are unregistered, so no later publish revives the
# snapshot and no NetAttach reaches the dead pid, and it is no longer the
# frame object's consumer. A restarted service is registered, and
# publishes, anew. Nothing is written to the page and no cleared record is
# stored. True when `pid` was the service.
pub fn net_service_exited(pid: u32) -> bool
    if pid == 0 or pid != net_service
        return false
    disable_interrupts()
    addr_generation = LINK_SEQ_UNPUBLISHED
    addr_publisher = 0
    net_addr_object = 0
    net_service = 0
    if net_frame_consumer == pid as u64
        net_frame_register(0, 0)
    enable_interrupts()
    true

# The registered service's pid, or 0.
pub fn net_service_pid() -> u32
    net_service

# The address snapshot holds a stable generation with a lease in it.
pub fn net_addr_configured() -> bool
    match net_addr_snapshot()
        Some(a) => a.configured != 0
        None => false

# The snapshot is configured and service `pid` published it: not a
# previous instance's lease, and not before `pid`'s own publish.
pub fn net_addr_configured_by(pid: u32) -> bool
    pid != 0 and addr_publisher == pid and net_addr_configured()

# NetAddr into `dst`, the caller's memory (checked here).
fn net_addr(dst: *NetAddr) -> i64
    let copy: NetAddr = match net_addr_snapshot()
        Some(a) => a
        None => return Errno.NoDev as i64
    if uptr_check_write(dst as *u8, sizeof(NetAddr) as u64) != 0
        return Errno.Fault as i64
    *dst = copy
    0

# net_info(dst: *NetInfo) -> 0 or -errno
pub fn sys_net_info_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    net_info(rdi as *NetInfo)

# net_addr(dst: *NetAddr) -> 0 or -errno
pub fn sys_net_addr_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    net_addr(rdi as *NetAddr)

# net_publish(handle) -> 0 or -errno
pub fn sys_net_publish_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let pid: u32 = proc_current_pid() as u32
    let r: i64 = net_publish_for(pid, rdi)
    # The armed service's ready publish: held until the seat is its own.
    while r == 0 and pid == handoff_service and handoff_ready
        sched_yield()
    r

# ============================================================================
# The app exchange: NetAttach (228), #4728
# ============================================================================

# Exchanges the kernel tracks at once: one per shm object slot.
const EXCHANGE_MAX: i32 = 16

# One exchange: the object and the app process it was attached for. Live
# while that process still holds a handle for the object; a dead record's
# slot is reused.
struct Exchange
    object_id: u64
    app_pid: u32
    in_use: bool
    _pad: [3]u8

var exchanges: [16]Exchange         # EXCHANGE_MAX

fn exchange_live(i: i32) -> bool
    exchanges[i].in_use and cap_holds_object(exchanges[i].app_pid, CAP_TYPE_SHM, exchanges[i].object_id)

# `pid` holds the handle of an exchange it attached.
fn exchange_held_by(pid: u32) -> bool
    var i: i32 = 0
    while i < EXCHANGE_MAX
        if exchanges[i].app_pid == pid and exchange_live(i)
            return true
        i = i + 1
    false

# A record slot no live exchange uses, or -1: an unused one first, then
# one whose app no longer holds its handle.
fn exchange_free_slot() -> i32
    var i: i32 = 0
    while i < EXCHANGE_MAX
        if not exchanges[i].in_use
            return i
        i = i + 1
    i = 0
    while i < EXCHANGE_MAX
        if not exchange_live(i)
            return i
        i = i + 1
    -1

fn packed(h: CapHandle) -> u64
    let index: u32 = h.index
    let generation: u32 = h.generation
    (index as u64) | ((generation as u64) << 32)

fn handle_ok(h: CapHandle) -> bool
    let index: u32 = h.index
    index != 0xFFFFFFFF

# Undo a half-made exchange: drop `app`'s handle (if made) and free the
# object, which nothing has mapped.
fn attach_undo(app_pid: u32, app: CapHandle, object_id: u64)
    if handle_ok(app)
        let index: u32 = app.index
        let generation: u32 = app.generation
        cap_revoke(cap_table_get(app_pid), cap_handle_init(index, generation))
    shm_destroy(object_id)

# NetAttach for app process `app_pid` (above). IF=1 on entry and on return;
# the checks and the inbox post run under cli, so a wait of the service
# cannot drain or fill the inbox between them. A process that still holds
# its exchange is Exist before anything else is asked (RING1_DRIVER.md
# "Grants"), whether or not the service is still there: the service can
# take the record and exit between an app's two attaches (#4848).
pub fn net_attach_for(app_pid: u32) -> i64
    if exchange_held_by(app_pid)
        return Errno.Exist as i64
    let service: u32 = net_service
    if service == 0 or cap_table_get(service) == 0 as *CapTable
        return Errno.NoDev as i64
    if app_pid == service
        return Errno.Inval as i64
    if cap_table_get(app_pid) == 0 as *CapTable
        return Errno.Perm as i64
    disable_interrupts()
    let result: i64 = attach_locked(app_pid, service)
    enable_interrupts()
    result

fn attach_locked(app_pid: u32, service: u32) -> i64
    if waitset_inbox_len(service as u64) >= INBOX_CAP
        return Errno.Again as i64
    let slot: i32 = exchange_free_slot()
    if slot < 0
        return Errno.NoMem as i64
    let object_id: u64 = match shm_create(APP_EXCHANGE_SIZE / PAGE_SIZE)
        Some(id) => id
        None => return Errno.NoMem as i64
    let rights: u32 = CAP_RIGHT_READ | CAP_RIGHT_WRITE
    let app: CapHandle = cap_kernel_grant(app_pid, CAP_TYPE_SHM, rights, object_id)
    if not handle_ok(app)
        attach_undo(app_pid, app, object_id)
        return Errno.NoMem as i64
    let svc: CapHandle = cap_kernel_grant(service, CAP_TYPE_SHM, rights, object_id)
    if not handle_ok(svc)
        attach_undo(app_pid, app, object_id)
        return Errno.NoMem as i64
    if not waitset_inbox_post(service as u64, packed(svc), EVENT_ATTACH)
        # The service has a table but no process slot: it is gone.
        let index: u32 = svc.index
        let generation: u32 = svc.generation
        cap_revoke(cap_table_get(service), cap_handle_init(index, generation))
        attach_undo(app_pid, app, object_id)
        return Errno.NoDev as i64
    exchanges[slot].object_id = object_id
    exchanges[slot].app_pid = app_pid
    exchanges[slot].in_use = true
    packed(app) as i64

# Boot tests only (net-attach): true when every exchange object the kernel
# recorded has been reclaimed (#4729: each app's exit retired its exchange,
# and the service's exit dropped its last mapping), freeing any that was
# not. The records are cleared either way.
pub fn net_exchanges_reclaimed() -> bool
    var all: bool = true
    var i: i32 = 0
    while i < EXCHANGE_MAX
        if exchanges[i].in_use
            if shm_exists(exchanges[i].object_id)
                all = false
                shm_destroy(exchanges[i].object_id)
            exchanges[i].in_use = false
            exchanges[i].object_id = 0
            exchanges[i].app_pid = 0
        i = i + 1
    all

# ============================================================================
# The replacement frame object, #4729
# ============================================================================

# The page table of live process `pid`, or 0.
pub fn pml4_of(pid: u32) -> u64
    var slot: i32 = 0
    while slot < MAX_PROCS
        if proc_at(slot).pid == pid as u64
            return proc_at(slot).pml4
        slot = slot + 1
    0

fn revoke_packed(pid: u32, h: CapHandle)
    if handle_ok(h)
        let index: u32 = h.index
        let generation: u32 = h.generation
        cap_revoke(cap_table_get(pid), cap_handle_init(index, generation))

# A replacement frame object between a surviving ring-1 driver and a new
# service. Under D9 (#4875) netd's restart makes none (the driver is netd);
# the shm-retire boot test (postinit.ritz, mode 13) still drives this
# primitive of the shared-object lifecycle (#4729). A replacement service
# `service_pid` was spawned while driver `driver_pid` survives
# (RING1_DRIVER.md "Shared object"): a new frame
# object of `page_count` zeroed pages (both ring indexes 0) at a new id,
# never the retired one's, created without waiting for the driver to
# detach from the old. The service gets a read-write handle and its mapping
# now, before it runs (it learns the address from ShmMap, which returns the
# one it has). The driver gets a read-write handle, whose insert makes its
# latch, and {handle, ATTACH} on its inbox, and no mapping: it ShmMaps the
# handle itself, with no ack and no ready bit. The new object is registered
# as the frame object, the service as its consumer. Returns the service's
# packed handle, for its entry arguments, or (each leaving nothing made):
#   Errno.NoDev  no live service process, or the driver has no table or
#                no process to queue the record on
#   Errno.Again  the driver's inbox holds INBOX_CAP records
#   Errno.NoMem  no object, handle or mapping to be had
pub fn net_frame_replace(service_pid: u32, driver_pid: u32, page_count: u64) -> i64
    let pml4: u64 = pml4_of(service_pid)
    if pml4 == 0 or cap_table_get(service_pid) == 0 as *CapTable or cap_table_get(driver_pid) == 0 as *CapTable
        return Errno.NoDev as i64
    if waitset_inbox_len(driver_pid as u64) >= INBOX_CAP
        return Errno.Again as i64
    let object_id: u64 = match shm_create(page_count)
        Some(id) => id
        None => return Errno.NoMem as i64
    let rights: u32 = CAP_RIGHT_READ | CAP_RIGHT_WRITE
    let svc: CapHandle = cap_kernel_grant(service_pid, CAP_TYPE_SHM, rights, object_id)
    let drv: CapHandle = cap_kernel_grant(driver_pid, CAP_TYPE_SHM, rights, object_id)
    var result: i64 = Errno.NoMem as i64
    if handle_ok(svc) and handle_ok(drv) and shm_map(service_pid, pml4, object_id, true) > 0
        disable_interrupts()
        if waitset_inbox_post(driver_pid as u64, packed(drv), EVENT_ATTACH)
            result = packed(svc) as i64
        else
            result = Errno.NoDev as i64
        enable_interrupts()
    if result < 0
        # The service's revoke unmaps it; then nothing maps the object.
        revoke_packed(driver_pid, drv)
        revoke_packed(service_pid, svc)
        shm_destroy(object_id)
        return result
    net_frame_register(object_id, service_pid as u64)
    result

# The registered frame object's id, or 0.
pub fn net_frame_object_id() -> u64
    net_frame_object

# ============================================================================
# The restart policy (AGAST #4745, RING2_NET.md "Service binary and respawn")
# ============================================================================

# Restarts per boot: one after each of the first three deaths.
pub const NETD_RESTARTS: u32 = 3

# A death of the registered service is restarted (or spends the budget):
# set once the frame seat is the service's; never cleared.
var net_restart_on: bool = false
# Deaths of the armed service since boot. Never reset: the budget is per
# boot, not per healthy stretch.
var net_service_deaths: u32 = 0

# Pid 1, once the frame seat is the service's (ring1.ritz
# net_seat_handoff): its deaths are restarted from now on.
pub fn net_restart_arm()
    net_restart_on = true

# A service death would be restarted (or would spend the budget).
pub fn net_restart_armed() -> bool
    net_restart_on

# The registered service has died (sys_exit_impl, after
# net_service_exited): which death this is, counting from 1, or 0 when no
# restart is armed (netd died before the handoff: the kernel seat sees
# NoDriver and nothing restarts).
pub fn net_service_death() -> u32
    if not net_restart_on
        return 0
    net_service_deaths = net_service_deaths + 1
    net_service_deaths

# The backoff before the restart after death `n`: 250 ms, 500 ms, 1 s;
# None once the budget is spent (and for 0).
pub fn net_restart_backoff_ms(n: u32) -> Option<u64>
    if n == 0 or n > NETD_RESTARTS
        return None
    if n == 1
        return Some(250)
    if n == 2
        return Some(500)
    Some(1000)

# A service's address page: the object and the service's packed handle.
pub struct ServicePage
    object_id: u64
    handle: u64

# A new address page for service `pid`: one zeroed page and a read-write
# handle with CAP_RIGHT_PUBLISH, not mapped (D9, #4875: netd ShmMaps it
# when its ATTACH comes, net_service_attach_page). None with nothing of it
# left.
pub fn net_service_page(pid: u32) -> Option<ServicePage>
    if cap_table_get(pid) == 0 as *CapTable
        return None
    let object_id: u64 = match shm_create(1)
        Some(id) => id
        None => return None
    let rights: u32 = CAP_RIGHT_READ | CAP_RIGHT_WRITE | CAP_RIGHT_PUBLISH
    let h: CapHandle = cap_kernel_grant(pid, CAP_TYPE_SHM, rights, object_id)
    if not handle_ok(h)
        shm_destroy(object_id)
        return None
    Some(ServicePage { object_id: object_id, handle: packed(h) })

# The ServiceBoot in `page`, written through the physmap before the service
# maps it: the page's own handle and the TSC rate, with the seat indexes at
# 0 (the handoff overwrites them for the first netd; a replacement has no
# seat). The frame field is 0: DriverBoot names the frame object (D9).
pub fn net_service_boot(page: ServicePage)
    var boot: ServiceBoot
    boot.magic = SERVICE_BOOT_MAGIC
    boot._pad = 0
    boot.frame = 0
    boot.addr = page.handle
    boot.tsc_hz = tsc_hz()
    boot.seat_rx_read = 0
    boot.seat_tx_write = 0
    *service_boot_at(phys_to_virt(shm_page(page.object_id, 0))) = boot

# {page.handle, ATTACH} on service `pid`'s inbox, before it is the
# registered service, so it is the first ATTACH the service sees (NetAttach
# is NoDev until the registration). False when the inbox is full or `pid`
# has no process: the caller drops the page.
pub fn net_service_attach_page(pid: u32, page: ServicePage) -> bool
    disable_interrupts()
    var posted: bool = false
    if waitset_inbox_len(pid as u64) < INBOX_CAP
        posted = waitset_inbox_post(pid as u64, page.handle, EVENT_ATTACH)
    enable_interrupts()
    posted

# net_attach() -> the caller's exchange handle or -errno
pub fn sys_net_attach_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    net_attach_for(proc_current_pid() as u32)
