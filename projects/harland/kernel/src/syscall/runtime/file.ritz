# Harland Syscall Runtime - File (AGAST #2751, from main.ritz)
#
# read/write/close/lseek/mkdir/readdir: filesystem fds go to fs/syscall.ritz,
# fds 0-2 to the serial console. (open lives in process.ritz: see there.)
# Each sys_*_handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import serial { StrView, serial_poll, serial_buf_read_many, serial_buffer_write, serial_drain_output }
import mm.uptr { uptr_validate_string, uptr_check_read, uptr_check_write }
import fs.knamespace { KNamespace, knamespace_get, knamespace_list }
import fs.kdir_entry { KDirEntry }
import fs.kpath { strview_from_ptr }
import fs.syscall { sys_close, sys_fs_read, sys_fs_write, sys_lseek, sys_mkdir, is_fs_fd }
import syscall.errno { Errno }
import syscall.runtime.process { syscall_strlen }

# sys_readdir: List directory contents
# Returns bytes written to buffer as null-terminated strings
fn sys_readdir_impl(dir_path: *u8, buf: *u8, buf_size: i64) -> i64
    let ns: *KNamespace = knamespace_get()
    if ns == 0 as *KNamespace
        return Errno.NoDev as i64

    # Create StrView from path
    let path_len: i64 = syscall_strlen(dir_path)
    let path_view: StrView = strview_from_ptr(dir_path, path_len)

    # Allocate entries array on stack (max 64)
    var entries: [64]KDirEntry
    let count: i32 = knamespace_list(ns, path_view, @entries[0], 64)

    if count < 0
        return count as i64  # an Errno: NoEnt or NotDir

    # Copy names to buffer as null-terminated strings
    var bytes_written: i64 = 0
    var i: i32 = 0

    while i < count
        let entry: *KDirEntry = @entries[i]

        # Find name length
        var name_len: i32 = (*entry).name_len as i32
        if name_len == 0
            # Fallback: count until null
            while name_len < 255 and (*entry).name[name_len] != 0
                name_len = name_len + 1

        # Check buffer space
        if bytes_written + name_len as i64 + 1 > buf_size
            break

        # Copy name
        var j: i32 = 0
        while j < name_len
            *(buf + bytes_written) = (*entry).name[j]
            bytes_written = bytes_written + 1
            j = j + 1

        # Null terminator
        *(buf + bytes_written) = 0
        bytes_written = bytes_written + 1

        i = i + 1

    return bytes_written

# ============================================================================
# File syscall handlers
# ============================================================================

# close(fd)
pub fn sys_close_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        return sys_close(fd)
    # Otherwise, return success (stdin/stdout/stderr don't close)
    return 0

# lseek(fd, offset, whence): only filesystem fds have a position.
pub fn sys_lseek_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    if not is_fs_fd(fd)
        return Errno.BadF as i64
    return sys_lseek(fd, rsi as i64, rdx as i32)

# mkdir(path, len): create a directory in the kernel namespace.
pub fn sys_mkdir_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate path buffer (same contract as open)
    if rsi == 0
        return Errno.Inval as i64
    let path_result: i64 = uptr_check_read(rdi as *u8, rsi as u64)
    if path_result != 0
        return Errno.Fault as i64
    return sys_mkdir(rdi as *u8, rsi)

# write(fd, buf, count), also debug_print: Linux/POSIX write convention.
pub fn sys_write_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    let buf: *u8 = rsi as *u8
    let len: i64 = rdx as i64

    # SECURITY: Validate user buffer is readable
    if len > 0
        let uptr_result: i64 = uptr_check_read(buf, len as u64)
        if uptr_result != 0
            return Errno.Fault as i64

    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        return sys_fs_write(fd, buf, len as u64)

    # Otherwise, write to serial (fd 1 = stdout, fd 2 = stderr)
    # Use interrupt-driven buffered output
    var total_written: i64 = 0
    while total_written < len
        let written: i64 = serial_buffer_write(buf + total_written, len - total_written)
        total_written = total_written + written

        if total_written < len
            # Buffer was full - drain some to hardware
            # This ensures we don't block indefinitely
            serial_drain_output()

    return total_written

# read(fd, buf, count): Linux/POSIX read convention.
pub fn sys_read_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    let buf: *u8 = rsi as *u8
    let count: i64 = rdx as i64

    # SECURITY: Validate user buffer is writable
    if count > 0
        let uptr_result: i64 = uptr_check_write(buf, count as u64)
        if uptr_result != 0
            return Errno.Fault as i64

    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        return sys_fs_read(fd, buf, count as u64)

    # Only support stdin (fd 0) for serial input
    if fd != 0
        return Errno.BadF as i64

    # First, poll for any new data
    serial_poll()

    # Read from the serial input buffer
    let bytes_read: i64 = serial_buf_read_many(buf, count)
    return bytes_read

# readdir(path, buf, size)
pub fn sys_readdir_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate path string and output buffer
    let path_result: i64 = uptr_validate_string(rdi as *u8, 4096)
    if path_result < 0
        return Errno.Fault as i64
    if rdx > 0
        let buf_result: i64 = uptr_check_write(rsi as *u8, rdx as u64)
        if buf_result != 0
            return Errno.Fault as i64
    return sys_readdir_impl(rdi as *u8, rsi as *u8, rdx as i64)
