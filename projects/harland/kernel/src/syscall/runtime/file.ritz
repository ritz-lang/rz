# Harland Syscall Runtime - File (AGAST #2751, from main.ritz)
#
# read/write/close/stat/fstat/lseek/mkdir/readdir: filesystem fds go to fs/syscall.ritz,
# fds 0-2 to the serial console. (open lives in process.ritz: see there.)
# Each sys_*_handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import klog { klog }
import serial { StrView, serial_buffer_write, serial_drain_output }
import tty.console { tty_console_read, tty_console_get_flags, tty_console_set_flags, tty_console_set_fg }
import mm.uptr { uptr_validate_string, uptr_check_read, uptr_check_write }
import fs.kfs { kfs_ns_for, kfs_local, kfs_list, kfs_errno }
import goliath.namespace { Namespace }
import goliath.dir_entry { NsEntry }
import goliath.path { GOLIATH_PATH_MAX, PATH_SEP }
import ritzlib.strview { strview_from_ptr }
import fs.syscall { sys_close, sys_fs_read, sys_fs_write, sys_fstat, sys_lseek, sys_mkdir, is_fs_fd, fs_sync }
import fs.stat { Stat, stat_at }
import ritzlib.result
import ritzlib.option
import syscall.errno { Errno }
import syscall.runtime.process { current_pid }
import cap.table { cap_process_has, cap_process_has_any }
import cap.types { CAP_TYPE_NAMESPACE, CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_CREATE, CAP_RIGHT_LIST }
import mm.heap { kalloc, kfree }

# Most entries one readdir returns.
const READDIR_MAX: i32 = 64

# sys_readdir: List directory contents
# Returns bytes written to buffer as null-terminated strings
fn sys_readdir_impl(path_view: StrView, buf: *u8, buf_size: i64) -> i64
    # /var and below are listed from the persistent subtree's namespace
    # (fs/kfs.ritz, #4321), where they are "/" and "/x".
    let ns: *Namespace = kfs_ns_for(path_view)
    if ns == 0 as *Namespace
        return Errno.NoDev as i64
    let local: StrView = kfs_local(path_view)

    # The entries go on the heap: 64 of them are ~21 KiB, which on the
    # syscall stack once overran it (AGAST #1877).
    let entries: *NsEntry = kalloc(sizeof(NsEntry) as u64 * READDIR_MAX as u64) as *NsEntry
    if entries == 0 as *NsEntry
        return Errno.NoMem as i64
    let count: i32 = kfs_list(ns, local, entries, READDIR_MAX)

    if count < 0
        kfree(entries as *u8)
        return count as i64  # an Errno: NoEnt or NotDir

    # Copy names to buffer as null-terminated strings
    var bytes_written: i64 = 0
    var i: i32 = 0

    while i < count
        let entry: *NsEntry = entries + i as i64

        # Find name length
        var name_len: i32 = (*entry).name_len as i32
        if name_len == 0
            # Fallback: count until null
            while name_len < 255 and (*entry).name[name_len] != 0
                name_len = name_len + 1

        # Check buffer space
        if bytes_written + name_len as i64 + 1 > buf_size
            break

        # Copy name
        var j: i32 = 0
        while j < name_len
            *(buf + bytes_written) = (*entry).name[j]
            bytes_written = bytes_written + 1
            j = j + 1

        # Null terminator
        *(buf + bytes_written) = 0
        bytes_written = bytes_written + 1

        i = i + 1

    kfree(entries as *u8)
    return bytes_written

# ============================================================================
# File syscall handlers
# ============================================================================

# close(fd)
pub fn sys_close_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        # Closing a file mutates the namespace-backed fd table, so either
        # namespace right makes the caller eligible (AGAST #4472).
        if not cap_process_has_any(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_READ | CAP_RIGHT_WRITE)
            klog("[syscall] close denied (no namespace capability)\n")
            return Errno.Perm as i64
        return sys_close(fd)
    # Otherwise, return success (stdin/stdout/stderr don't close)
    return 0

# stat(path, path_len, *Stat): fs/stat.ritz. Looking a path up needs READ in
# the namespace, as open does (AGAST #4832).
pub fn sys_stat_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_READ)
        klog("[syscall] stat denied (no namespace capability)\n")
        return Errno.Perm as i64
    # SECURITY: Validate the path (same contract as mkdir) and the record
    if rsi == 0
        return Errno.Inval as i64
    if rsi > GOLIATH_PATH_MAX as u64
        return Errno.NameTooLong as i64
    if uptr_check_read(rdi as *u8, rsi as u64) != 0
        return Errno.Fault as i64
    if uptr_check_write(rdx as *u8, sizeof(Stat) as u64) != 0
        return Errno.Fault as i64
    # Absolute paths only: userspace resolves a relative one (AGAST #4776)
    if *(rdi as *u8) != PATH_SEP
        return Errno.Inval as i64
    # /var and below are the persistent subtree's, as for open (fs/kfs.ritz)
    let path: StrView = StrView { ptr: rdi as *u8, len: rsi as i64 }
    let ns: *Namespace = kfs_ns_for(path)
    if ns == 0 as *Namespace
        return Errno.NoDev as i64
    match stat_at(ns, kfs_local(path))
        Ok(st) => return stat_to_user(st, rdx as *Stat)
        Err(e) => return kfs_errno(e) as i64

# fstat(fd, *Stat): a file fd's status needs a namespace right, as lseek
# does; the console fds' stays ungated, as their read and write do.
pub fn sys_fstat_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    if uptr_check_write(rsi as *u8, sizeof(Stat) as u64) != 0
        return Errno.Fault as i64
    if is_fs_fd(fd) and not cap_process_has_any(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_READ | CAP_RIGHT_WRITE)
        klog("[syscall] fstat denied (no namespace capability)\n")
        return Errno.Perm as i64
    match sys_fstat(fd)
        Some(st) => return stat_to_user(st, rsi as *Stat)
        None => return Errno.BadF as i64

# Write `st` to the caller's record `out` (checked writable): stat's and
# fstat's 0.
fn stat_to_user(st: Stat, out: *Stat) -> i64
    *out = st
    0

# lseek(fd, offset, whence): only filesystem fds have a position.
pub fn sys_lseek_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    if not is_fs_fd(fd)
        return Errno.BadF as i64
    if not cap_process_has_any(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_READ | CAP_RIGHT_WRITE)
        klog("[syscall] lseek denied (no namespace capability)\n")
        return Errno.Perm as i64
    return sys_lseek(fd, rsi as i64, rdx as i32)

# mkdir(path, len): create a directory in the kernel namespace.
pub fn sys_mkdir_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # Creating a directory entry needs CAP_RIGHT_CREATE in the namespace
    # (AGAST #4472).
    if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_CREATE)
        klog("[syscall] mkdir denied (no namespace capability)\n")
        return Errno.Perm as i64
    # SECURITY: Validate path buffer (same contract as open)
    if rsi == 0
        return Errno.Inval as i64
    if rsi > GOLIATH_PATH_MAX as u64
        return Errno.NameTooLong as i64
    let path_result: i64 = uptr_check_read(rdi as *u8, rsi as u64)
    if path_result != 0
        return Errno.Fault as i64
    # The kernel takes absolute paths only: userspace resolves a relative
    # one, `.` and `..` against its cwd first (ritzlib.path, AGAST #4776).
    let path: *u8 = rdi as *u8
    if *path != PATH_SEP
        return Errno.Inval as i64
    sys_mkdir(path, rsi)

# write(fd, buf, count), also debug_print: Linux/POSIX write convention.
pub fn sys_write_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    let buf: *u8 = rsi as *u8
    let len: i64 = rdx as i64

    # SECURITY: Validate user buffer is readable
    if len > 0
        let uptr_result: i64 = uptr_check_read(buf, len as u64)
        if uptr_result != 0
            return Errno.Fault as i64

    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        # Writing a file needs WRITE in the namespace. The console fds stay
        # ungated: a process denied the filesystem must still be able to
        # report why (AGAST #4472).
        if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_WRITE)
            klog("[syscall] write denied (no namespace capability)\n")
            return Errno.Perm as i64
        return sys_fs_write(fd, buf, len as u64)

    # Otherwise, write to serial (fd 1 = stdout, fd 2 = stderr)
    # Use interrupt-driven buffered output
    var total_written: i64 = 0
    while total_written < len
        let written: i64 = serial_buffer_write(buf + total_written, len - total_written)
        total_written = total_written + written

        if total_written < len
            # Buffer was full - drain some to hardware
            # This ensures we don't block indefinitely
            serial_drain_output()

    return total_written

# read(fd, buf, count): Linux/POSIX read convention.
pub fn sys_read_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let fd: i32 = rdi as i32
    let buf: *u8 = rsi as *u8
    let count: i64 = rdx as i64

    # SECURITY: Validate user buffer is writable
    if count > 0
        let uptr_result: i64 = uptr_check_write(buf, count as u64)
        if uptr_result != 0
            return Errno.Fault as i64

    # Check if it's a filesystem fd
    if is_fs_fd(fd)
        # Reading a file needs READ in the namespace; stdin stays ungated
        # (AGAST #4472).
        if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_READ)
            klog("[syscall] read denied (no namespace capability)\n")
            return Errno.Perm as i64
        return sys_fs_read(fd, buf, count as u64)

    # Only support stdin (fd 0) for serial input
    if fd != 0
        return Errno.BadF as i64

    # The console: sleeps until a line (or, raw, a byte) arrives (#4254).
    return tty_console_read(buf, count)

# readdir(path, buf, size)
pub fn sys_readdir_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # Listing a directory needs CAP_RIGHT_LIST in the namespace (#4472).
    if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_LIST)
        klog("[syscall] readdir denied (no namespace capability)\n")
        return Errno.Perm as i64
    # SECURITY: Validate path string and output buffer
    let path_result: i64 = uptr_validate_string(rdi as *u8, 4096)
    if path_result < 0
        return Errno.Fault as i64
    if rdx > 0
        let buf_result: i64 = uptr_check_write(rsi as *u8, rdx as u64)
        if buf_result != 0
            return Errno.Fault as i64
    return sys_readdir_impl(strview_from_ptr(rdi as *u8, path_result), rsi as *u8, rdx as i64)

# The console's terminal flags (#4254): tty/ldisc.ritz's TTY_ECHO,
# TTY_ICANON and TTY_ISIG in a 4-byte struct (ritzlib's TtyAttrs). fds 0-2
# are the console unless they name a file; anything else is not a terminal.
fn tty_fd_ok(fd: i32) -> bool
    fd >= 0 and fd <= 2 and not is_fs_fd(fd)

# tty_getattr(fd, attrs)
pub fn sys_tty_getattr_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    if not tty_fd_ok(rdi as i32)
        return Errno.NotTy as i64
    if uptr_check_write(rsi as *u8, 4) != 0
        return Errno.Fault as i64
    *(rsi as *u32) = tty_console_get_flags()
    return 0

# tty_setattr(fd, attrs)
pub fn sys_tty_setattr_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    if not tty_fd_ok(rdi as i32)
        return Errno.NotTy as i64
    if uptr_check_read(rsi as *u8, 4) != 0
        return Errno.Fault as i64
    tty_console_set_flags(*(rsi as *u32))
    return 0

# tty_setfg(fd, mode, pid): the console's foreground (tty/fg.ritz, #4276),
# whose Ctrl-C it is: TTY_FG_NONE (0), TTY_FG_CHILDREN (1) or TTY_FG_PID (2).
pub fn sys_tty_setfg_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    if not tty_fd_ok(rdi as i32)
        return Errno.NotTy as i64
    return tty_console_set_fg(rsi, rdx) as i64

# sync(): save the persistent subtree (/var) to the storage device now.
# Save-on-close is debounced (fs/syscall.ritz, #4321); Sync is the way a
# program says "now". Returns 0, or an Errno (NoDev without a disk).
pub fn sys_sync_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # Flushing the persistent subtree is a namespace write (AGAST #4472).
    if not cap_process_has(current_pid(), CAP_TYPE_NAMESPACE, CAP_RIGHT_WRITE)
        klog("[syscall] sync denied (no namespace capability)\n")
        return Errno.Perm as i64
    return fs_sync() as i64
