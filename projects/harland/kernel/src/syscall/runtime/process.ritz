# Harland Syscall Runtime - Process (AGAST #2751, from main.ritz)
#
# spawn/exit/wait on the process table (proc/table.ritz, AGAST #1882) and the
# scheduler (proc/sched.ritz, AGAST #3629), and the syscalls that read them
# (getpid, yield, acpi_poweroff).
#
# Every process runs on its own kernel stack. spawn builds the child (page
# table, ELF, user stack, argv, fd table) and a first frame on the child's
# kernel stack, then makes it runnable. spawn_bg returns its pid at once;
# spawn blocks in the scheduler until the child exits, and wait(pid) blocks
# until that child exits. A blocked process's syscall frame stays on its
# own kernel stack, so it simply returns when it runs again: there is no
# saved-frame copy to resume (#2132's syscall_save_user_frame and
# resume_user_frame are gone with the single syscall stack).
#
# The open handler lives here, not in file.ritz: it used to save and restore
# the running pid around sys_open. That guarded against the 4 KiB syscall
# stack overrunning .data, fixed in syscall_entry.s (#2761).
# Each sys_*_handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import klog { klog, klog_dec }
import io { halt_loop, disable_interrupts, enable_interrupts }
import serial { StrView }
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_free_page }
import mm.vmm { PTE_USER, phys_to_virt, vmm_map_page, vmm_create_user_pml4, vmm_switch_pml4, vmm_get_current_pml4, vmm_free_pml4 }
import mm.uptr { uptr_validate_string, uptr_check_read }
import fs.kfs { kfs_ns_for, kfs_local, kfs_read, kfs_save, kfs_save_pending }
import fs.vfs { O_CREAT }
import goliath.namespace { Namespace }
import ritzlib.strview { strview_from_ptr }
import ritzlib.span { Span, span_from_ptr }
import fs.syscall { sys_open, fs_process_end, fs_process_start, fs_process_select }
import syscall.stack { syscall_stack_check, syscall_stack_used }
import drivers.acpi.tables { acpi_poweroff }
import loader.image { ElfStatus }
import loader.elf { USER_IMAGE_BASE, ElfLoadResult, elf_load }
import syscall.errno { Errno }
import syscall.runtime.memory { USER_STACK_TOP, alloc_user_stack }
import syscall.runtime.argv { ArgvStatus, ArgvCapture, argv_capture, argv_buf, argv_offsets }
import proc.table { Proc, BLOCK_CHILD, PROC_CHILD_EXITED, PROC_CHILD_LIVE, proc_table_reset, proc_enter_init, proc_current, proc_current_pid, proc_current_slot, proc_at, proc_is_init, proc_new_child, proc_start, proc_abort_child, proc_block, proc_exit_current, proc_child_status, proc_wait, proc_mark_exit, MarkError }
import ritzlib.result { Result }
import proc.sched { sched_start, sched_yield, sched_block, sched_exit, sched_prepare_user, sched_report }
import cap.table { CapTable, cap_process_has, cap_table_alloc, cap_table_free_pid, cap_inherit_ambient }
import cap.types { CAP_TYPE_POWER, CAP_TYPE_NAMESPACE, CAP_RIGHT_EXECUTE, CAP_RIGHT_READ, CAP_RIGHT_CREATE }

extern fn syscall_stack_size() -> u64

# ============================================================================
# spawn
# ============================================================================

# The child's argv addresses on its stack, filled by spawn_push_argv.
# The strings themselves live in argv.ritz's capture buffer: argv is read
# from user memory exactly once, in the handler (AGAST #1888).
var g_spawn_child_argv: [64]u64

# init's page table: the kernel's own, mapped for as long as the kernel
# runs. An exiting process leaves its own for this one before freeing it.
var g_kernel_pml4: u64 = 0

# Get current process ID (for syscalls that need caller PID)
pub fn current_pid() -> u32
    return proc_current_pid() as u32

# Make the running boot thread init (PID 1, no parent, cwd "/", the
# kernel's page table) with its own fd table (#2753), without starting the
# scheduler: pid 1 stays on the boot stack at CPL 0 and nothing preempts it
# (RING1_DRIVER.md §9 step 1, #4712). Only when no process exists yet: a
# second call leaves the table, and pid 1, alone.
pub fn process_create_init()
    if proc_current() != 0 as *Proc
        return
    proc_table_reset()
    g_kernel_pml4 = vmm_get_current_pml4()
    if proc_enter_init(g_kernel_pml4) != 0
        klog("[init] No process table slot for init\n")
    if fs_process_start(1) != 0
        klog("[init] No fd table: init cannot open files\n")

# process_create_init, then start the scheduler's tick (#3629) on init's
# kernel stack: run_init, before it jumps to /bin/init.
pub fn process_enter_init()
    process_create_init()
    sched_start(proc_current_slot())

# Undo process_create_init (boot-test mode only, postinit.ritz
# boot_process_tests): free init's fd table and empty the process table,
# so run_init finds no process, as on a boot without the test. Only before
# the scheduler starts; a no-op when no process exists.
pub fn process_destroy_init()
    if proc_current() == 0 as *Proc
        return
    if fs_process_select(1) == 0
        fs_process_end()
    proc_table_reset()
    g_kernel_pml4 = 0

# The errno a failed spawn returns for a failed ELF load: out of memory, or
# a file that isn't a loadable x86-64 executable.
fn elf_status_errno(s: ElfStatus) -> i64
    match s
        AllocFailed => Errno.NoMem as i64
        MapFailed => Errno.NoMem as i64
        _ => Errno.NoExec as i64

# Undo a spawn that failed after the child's slot, fd table and page table
# were made, before it ran. The caller is back in its own page table. The
# parent keeps its pid throughout (AGAST #2762).
fn spawn_undo(slot: i32, parent_pid: u64)
    let c: *Proc = proc_at(slot)
    cap_table_free_pid(c.pid as u32)
    fs_process_select(c.pid)
    fs_process_end()
    fs_process_select(parent_pid)
    if c.pml4 != 0
        vmm_free_pml4(c.pml4)
    proc_abort_child(slot)

# The errno argv_capture's status maps to.
fn argv_status_errno(s: ArgvStatus) -> i64
    match s
        TooMany => Errno.TooBig as i64
        TooBig => Errno.TooBig as i64
        Fault => Errno.Fault as i64
        Invalid => Errno.Inval as i64
        _ => 0

# Capture the caller's argv before spawn_process switches page tables: one
# pass, validation fused with the copy (AGAST #1888). Returns the captured
# byte count, or a negative errno.
fn spawn_capture_argv(argv: **u8, argc: i32) -> i64
    let cap: ArgvCapture = argv_capture(argv, argc, uptr_check_read)
    if cap.status != ArgvStatus.Ok
        klog("[spawn_args] argv capture failed\n")
        return argv_status_errno(cap.status)
    return cap.bytes

# Lay out argv on the child's user stack (the child's page table is
# current): the strings at the top, below them the argv array and its NULL,
# 16-aligned. The child's RSP; *child_argv gets argv's address.
fn spawn_push_argv(argc: i32, total_string_bytes: i64, child_argv: *u64) -> u64
    # Stack top is USER_STACK_TOP + PAGE_SIZE (first unmapped address)
    var stack_ptr: u64 = USER_STACK_TOP + PAGE_SIZE
    stack_ptr = stack_ptr - (total_string_bytes as u64)
    stack_ptr = stack_ptr & 0xFFFFFFFFFFFFFFF0
    let strings_base: u64 = stack_ptr
    var i: i32 = 0
    var dst_offset: i64 = 0
    while i < argc
        g_spawn_child_argv[i] = strings_base + (dst_offset as u64)
        let src_offset: i64 = argv_offsets[i]
        var j: i64 = 0
        while argv_buf[(src_offset + j) as i32] != 0
            *((strings_base + dst_offset as u64 + j as u64) as *u8) = argv_buf[(src_offset + j) as i32]
            j = j + 1
        *((strings_base + dst_offset as u64 + j as u64) as *u8) = 0
        dst_offset = dst_offset + j + 1
        i = i + 1
    let argv_array_size: u64 = ((argc + 1) as u64) * 8  # pointers + NULL
    stack_ptr = stack_ptr - argv_array_size
    stack_ptr = stack_ptr & 0xFFFFFFFFFFFFFFF0
    let argv_addr: u64 = stack_ptr
    i = 0
    while i < argc
        *((argv_addr + (i as u64) * 8) as *u64) = g_spawn_child_argv[i]
        i = i + 1
    *((argv_addr + (argc as u64) * 8) as *u64) = 0
    *child_argv = argv_addr
    return stack_ptr & 0xFFFFFFFFFFFFFFF0

# The first half of every spawn, in the parent's address space: a child
# slot of the running process `parent_pid`, its capability table (the
# parent's ambient capabilities when `inherit_caps`), its own fd table, and
# an isolated page table (kernel mappings, empty user space) in its Proc.
# The parent's fd table is current again on return. The child's slot, or a
# negative errno with nothing left behind.
fn spawn_child_begin(parent_pid: u64, inherit_caps: bool) -> i64
    let slot: i32 = proc_new_child()
    if slot < 0
        klog("[spawn_args] No child process slot\n")
        return slot as i64
    let child: *Proc = proc_at(slot)
    let child_pid: u64 = child.pid

    # The child's capability table. A sys_spawn child inherits the ambient
    # capabilities of its parent (display, channel, namespace); POWER is
    # init's alone (AGAST #1888, extended by #4472). A kernel spawn inherits
    # nothing: the kernel grants what it holds (RING1_DRIVER.md section 2).
    if cap_table_alloc(child_pid as u32) == 0 as *CapTable
        proc_abort_child(slot)
        return Errno.NoMem as i64
    if inherit_caps
        cap_inherit_ambient(parent_pid as u32, child_pid as u32)

    # The child's own fd table (#2753); its exit releases it. Made here, in
    # the parent's address space: kalloc may grow the heap, and vmm_map_page
    # walks the page tables through the identity map, which a child's page
    # table lacks. fs_process_start makes it current: the parent's again
    # straight after.
    let fs_result: i32 = fs_process_start(child_pid)
    fs_process_select(parent_pid)
    if fs_result != 0
        klog("[spawn_args] No fd table for the child\n")
        cap_table_free_pid(child_pid as u32)
        proc_abort_child(slot)
        return fs_result as i64

    # An isolated address space: kernel mappings, empty user space.
    let child_pml4: u64 = vmm_create_user_pml4()
    if child_pml4 == 0
        spawn_undo(slot, parent_pid)
        return Errno.NoMem as i64
    (*child).pml4 = child_pml4
    slot as i64

# Start `path` as a child of the running process, with argc/argv (argc 0:
# none) in main's RDI/RSI. The child is runnable when this returns: its pid,
# or a negative errno with nothing changed.
#
# ISOLATION: each child gets its own page table (CR3); it cannot read or
# write the parent's user memory.
fn spawn_process(path_view: StrView, argc: i32, argv_bytes: i64) -> i64
    # Read file from namespace (using kernel's page table). A path under
    # /var comes from the persistent subtree (fs/kfs.ritz, #4321).
    let ns: *Namespace = kfs_ns_for(path_view)
    if ns == 0 as *Namespace
        klog("[spawn_args] No namespace\n")
        return Errno.NoDev as i64

    var file_size: u64 = 0
    let elf_data: *u8 = kfs_read(ns, kfs_local(path_view), @file_size)
    if elf_data == 0 as *u8
        if argc > 0
            klog("[spawn_args] File not found: ")
            klog(path_view)
            klog("\n")
        return Errno.NoEnt as i64

    # The caller's argv was captured in the handler, before this point
    # (AGAST #1888): use that copy and never re-read the user array.
    let total_string_bytes: i64 = argv_bytes

    let parent: *Proc = proc_current()
    let parent_pid: u64 = parent.pid
    let parent_pml4: u64 = vmm_get_current_pml4()
    (*parent).pml4 = parent_pml4
    let begun: i64 = spawn_child_begin(parent_pid, true)
    if begun < 0
        return begun
    let slot: i32 = begun as i32
    let child_pid: u64 = proc_at(slot).pid
    let child_pml4: u64 = proc_at(slot).pml4

    # Load in the child's address space, so elf_load maps its pages there.
    vmm_switch_pml4(child_pml4)
    let load_result: ElfLoadResult = elf_load(elf_data, file_size, USER_IMAGE_BASE)
    if load_result.error != ElfStatus.Ok
        klog("[spawn_args] Failed to load ELF\n")
        vmm_switch_pml4(parent_pml4)
        spawn_undo(slot, parent_pid)
        return elf_status_errno(load_result.error)

    # 64 KiB user stack (16 pages)
    let child_stack_top: u64 = alloc_user_stack()
    if child_stack_top == 0
        klog("[spawn_args] Failed to allocate child stack\n")
        vmm_switch_pml4(parent_pml4)
        spawn_undo(slot, parent_pid)
        return Errno.NoMem as i64

    var user_rsp: u64 = child_stack_top
    var child_argv: u64 = 0
    if argc > 0
        user_rsp = spawn_push_argv(argc, total_string_bytes, @child_argv)
    vmm_switch_pml4(parent_pml4)

    # main(argc, argv) in RDI/RSI; the first switch to the slot enters it.
    var arg0: u64 = 0
    if argc > 0
        arg0 = argc as u64
    sched_prepare_user(slot, load_result.entry_point, user_rsp, arg0, child_argv)
    proc_start(slot)
    return child_pid as i64

# Start a program the kernel chose as a child of the running process
# (RING1_DRIVER.md section 2, AGAST #4713): `image`, position-independent
# code of at most one page, copied into a user page at USER_IMAGE_BASE of
# its own page table and entered there at CPL 3, through the ordinary
# sched_prepare_user frame (CS 0x23, SS 0x1B), on a fresh user stack, with
# the kernel's arg0/arg1 in RDI/RSI. It inherits no capabilities: what it
# holds, the kernel grants. The child is runnable when this returns: its
# pid, or a negative errno with nothing changed.
pub fn process_spawn_image(image: Span<u8>, arg0: u64, arg1: u64) -> i64
    if image.is_empty() or image.len() as u64 > PAGE_SIZE
        return Errno.Inval as i64
    let parent: *Proc = proc_current()
    if parent == 0 as *Proc
        return Errno.Srch as i64
    let parent_pid: u64 = parent.pid
    let parent_pml4: u64 = vmm_get_current_pml4()
    (*parent).pml4 = parent_pml4

    # The code page, filled through the physmap before it is mapped (as
    # alloc_user_stack does, #4332): read-only and executable for the child.
    let code_phys: u64 = pmm_alloc_page()
    if code_phys == 0
        return Errno.NoMem as i64
    let code: Span<u8> = span_from_ptr<u8>(phys_to_virt(code_phys) as *u8, PAGE_SIZE as i64)
    code.zero()
    code.copy_from(image)

    let begun: i64 = spawn_child_begin(parent_pid, false)
    if begun < 0
        pmm_free_page(code_phys)
        return begun
    let slot: i32 = begun as i32
    let child_pid: u64 = proc_at(slot).pid

    # Map in the child's address space; from here its exit, or spawn_undo,
    # frees the page with the page table.
    vmm_switch_pml4(proc_at(slot).pml4)
    if vmm_map_page(USER_IMAGE_BASE, code_phys, PTE_USER) != 0
        vmm_switch_pml4(parent_pml4)
        pmm_free_page(code_phys)
        spawn_undo(slot, parent_pid)
        return Errno.NoMem as i64
    let user_rsp: u64 = alloc_user_stack()
    vmm_switch_pml4(parent_pml4)
    if user_rsp == 0
        spawn_undo(slot, parent_pid)
        return Errno.NoMem as i64

    sched_prepare_user(slot, USER_IMAGE_BASE, user_rsp, arg0, arg1)
    proc_start(slot)
    return child_pid as i64

# Sleep until the running process's child `pid` exits (or at once if it
# has): PROC_CHILD_EXITED with its code in *code, or Errno.Child if pid is
# no child of the caller. Doesn't reap it.
fn wait_for_child(pid: u64, code: *i64) -> i32
    disable_interrupts()
    var st: i32 = proc_child_status(pid, code)
    while st == PROC_CHILD_LIVE
        proc_block(BLOCK_CHILD, pid)
        sched_block()
        st = proc_child_status(pid, code)
    enable_interrupts()
    st

# spawn, blocking: start the child and sleep until it exits. Its pid, for
# sys_wait to collect the status; a negative exit code fails the spawn with
# -1 instead, and the child is reaped here since no wait will come.
fn spawn_and_block(path: StrView, argc: i32, argv_bytes: i64) -> i64
    let pid: i64 = spawn_process(path, argc, argv_bytes)
    if pid <= 0
        return pid
    var code: i64 = 0
    wait_for_child(pid as u64, @code)
    if code < 0
        proc_wait(pid as u64)
        return -1
    return pid

# sys_spawn: run a binary from the filesystem and wait for it to exit.
fn sys_spawn_impl(path: StrView) -> i64
    return spawn_and_block(path, 0, 0)

# sys_spawn_args: run a binary with arguments and wait for it to exit. The
# child's _start passes (argc, argv) to main; a `pub fn main(args:
# Span<StrView>)` gets them as views through the entry adapter (#200).
fn sys_spawn_args_impl(path: StrView, argc: i32, argv_bytes: i64) -> i64
    return spawn_and_block(path, argc, argv_bytes)

# sys_exit: the running process exits. Its fds are flushed and closed, its
# address space freed, and it becomes a zombie for its parent's wait (a
# parent blocked on it runs again); then the CPU goes to whoever runs next.
# init exiting powers off.
fn sys_exit_impl(code: i32) -> i64
    let me: *Proc = proc_current()
    if me != 0 as *Proc and not proc_is_init(me)
        let my_pml4: u64 = me.pml4
        # Leave the exiting address space for the kernel's, which stays
        # mapped, before freeing it.
        vmm_switch_pml4(g_kernel_pml4)

        # Close the fds it left open (flushing their writes) and free its
        # fd table, so none outlive it (#2753).
        fs_process_end()
        # Its capabilities die with it, so the slot can be reused.
        cap_table_free_pid(me.pid as u32)

        # Save-on-close is debounced (#4321): a write it deferred is not lost
        # when the process that made it goes away. Only then is a save owed,
        # so a boot full of children costs no disk writes.
        if kfs_save_pending()
            kfs_save()

        # Free its page table and all its user-space pages
        if my_pml4 != 0
            vmm_free_pml4(my_pml4)

        disable_interrupts()
        proc_exit_current(code as i64)

        # exit never returns through syscall_handler, so its stack check
        # runs here (#2761).
        syscall_stack_check()

        # Never returns: nothing switches back to an exited process.
        sched_exit()

    # No parent - this is init exiting. Its fds are closed (and their writes
    # flushed) like any process's (#2753), then the machine powers off
    # through ACPI S5 (#2755): under QEMU the VM exits instead of hanging.
    fs_process_end()
    # Its closes may have deferred a save (#4321); the machine is about to
    # lose RAM, so write the persistent subtree out now.
    if kfs_save_pending()
        kfs_save()
    # init's exit doesn't return through syscall_handler either: panic, not
    # power off as if fine, if a syscall ran off its stack (#2761), and
    # report how deep any went.
    syscall_stack_check()
    klog("[exit] syscall stack peak ")
    klog_dec(syscall_stack_used())
    klog(" of ")
    klog_dec(syscall_stack_size())
    klog(" bytes\n")
    sched_report()
    klog("[exit] init exited with code ")
    if code < 0
        klog("-")
        klog_dec((0 - code) as i64)
    else
        klog_dec(code as i64)
    klog(", powering off\n")
    acpi_poweroff()
    # Only reached if the poweroff failed.
    klog("[exit] ACPI poweroff failed, halting system\n")
    halt_loop()
    return 0

# Terminate the running process with `status`, as if it had called
# exit(status): its parent's wait sees it, or init's exit powers off. The
# exception handler calls this for a fault taken in ring 3 (#2755), the
# console for Ctrl-C (#4254). Never returns.
pub fn process_kill_current(status: i32) -> i64
    return sys_exit_impl(status)

# The exit status of a process reaped through PROC_REAP: 128 + 9, as if it
# had been sent SIGKILL (a fault is 128 + its vector, Ctrl-C 130).
pub const PROC_REAP_STATUS: i32 = 137

# The kernel tells process `pid` to exit (RING1_DRIVER.md "Driver death",
# #4714). Not process_kill_current: that exits the caller, and the caller here
# (pid 1, the kernel seat) is never the process that exits. The pid is marked
# PROC_REAP and woken if parked; its next return to user enters
# sys_exit_impl through process_reap_exit instead of resuming at CPL 3.
# MarkError.Init for pid 1, MarkError.NoProcess for no live process.
pub fn process_mark_exit(pid: u64) -> Result<(), MarkError>
    return proc_mark_exit(pid)

# The return to user of a PROC_REAP process (syscall_entry.s reap_if_marked,
# #4714): the frame it was returning through is abandoned and this runs at
# the top of the process's own kernel stack. It exits as if it had called
# exit(PROC_REAP_STATUS), with interrupts on as in a syscall. Never returns.
pub fn process_reap_exit()
    enable_interrupts()
    sys_exit_impl(PROC_REAP_STATUS)

# Reap the running process's child `pid`, sleeping until it exits: its exit
# code, or Errno.Child. The kernel's own wait, for a child it spawned with
# process_spawn_image (#4713); the same path as the wait syscall.
pub fn process_wait(pid: i32) -> i64
    return sys_wait_impl(pid)

# sys_wait: reap the caller's child `pid`, sleeping until it exits: its exit
# code, or Errno.Child if pid is no unreaped child of the caller.
fn sys_wait_impl(pid: i32) -> i64
    if pid <= 0
        return Errno.Child as i64
    var code: i64 = 0
    if wait_for_child(pid as u64, @code) != PROC_CHILD_EXITED
        return Errno.Child as i64
    return proc_wait(pid as u64)

# ============================================================================
# Process syscall handlers
# ============================================================================

# exit(code): sys_exit_impl handles both child exit (return to parent) and
# init exit (halt system). It may not return!
pub fn sys_exit_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_exit_impl(rdi as i32)

# open(path, path_len, flags)
pub fn sys_open_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # Resolving a path needs a namespace capability with READ; creating one
    # needs CREATE as well (AGAST #4472).
    let pid: u32 = current_pid()
    if not cap_process_has(pid, CAP_TYPE_NAMESPACE, CAP_RIGHT_READ)
        klog("[syscall] open denied (no namespace capability)\n")
        return Errno.Perm as i64
    let flags: i32 = rdx as i32
    if (flags & O_CREAT) != 0 and not cap_process_has(pid, CAP_TYPE_NAMESPACE, CAP_RIGHT_CREATE)
        klog("[syscall] open(O_CREAT) denied (no create right)\n")
        return Errno.Perm as i64
    # SECURITY: Validate path buffer
    if rsi > 0
        let path_result: i64 = uptr_check_read(rdi as *u8, rsi as u64)
        if path_result != 0
            return Errno.Fault as i64
    return sys_open(rdi as *u8, rsi, flags)

# spawn(path)
pub fn sys_spawn_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate path string
    let path_result: i64 = uptr_validate_string(rdi as *u8, 4096)
    if path_result < 0
        return Errno.Fault as i64
    return sys_spawn_impl(strview_from_ptr(rdi as *u8, path_result))

# spawn_args(path, argv, argc)
pub fn sys_spawn_args_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate path string
    let path_result: i64 = uptr_validate_string(rdi as *u8, 4096)
    if path_result < 0
        return Errno.Fault as i64
    # SECURITY: capture argv exactly once, validating each page as it is
    # copied (AGAST #1888). The impl and the child use only the copy.
    let argc: i32 = rdx as i32
    var argv_bytes: i64 = 0
    if argc > 0
        argv_bytes = spawn_capture_argv(rsi as **u8, argc)
        if argv_bytes < 0
            return argv_bytes
    return sys_spawn_args_impl(strview_from_ptr(rdi as *u8, path_result), argc, argv_bytes)

# spawn_bg(path, argv, argc): like spawn_args, but the caller doesn't wait:
# the child's pid comes back at once, both run (#3629), and wait(pid)
# collects its exit code.
pub fn sys_spawn_bg_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    let path_result: i64 = uptr_validate_string(rdi as *u8, 4096)
    if path_result < 0
        return Errno.Fault as i64
    let argc: i32 = rdx as i32
    if argc < 0
        return Errno.Inval as i64
    # Capture argv exactly once (AGAST #1888); spawn_process uses the copy.
    var argv_bytes: i64 = 0
    if argc > 0
        argv_bytes = spawn_capture_argv(rsi as **u8, argc)
        if argv_bytes < 0
            return argv_bytes
    return spawn_process(strview_from_ptr(rdi as *u8, path_result), argc, argv_bytes)

# wait(pid)
pub fn sys_wait_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_wait_impl(rdi as i32)

# getpid(): the running process's pid (1 = init, children from 2 up)
pub fn sys_getpid_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return proc_current_pid() as i64

# yield(): the next runnable process gets the CPU; the caller runs again
# when its turn comes round (at once, if nothing else can run).
pub fn sys_yield_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    sched_yield()
    return 0

# acpi_poweroff()
pub fn sys_acpi_poweroff_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # POWER is init's capability; a process without it cannot power the
    # machine off (AGAST #1888).
    if not cap_process_has(proc_current_pid() as u32, CAP_TYPE_POWER, CAP_RIGHT_EXECUTE)
        klog("[syscall] ACPI poweroff denied (no capability)\n")
        return Errno.Perm as i64
    klog("[syscall] ACPI poweroff requested\n")
    # Whatever save-on-close deferred (#4321) goes to the disk before the
    # machine goes down.
    if kfs_save_pending()
        kfs_save()
    let result: i32 = acpi_poweroff()
    # If we get here, poweroff failed
    return result as i64
