# Harland Syscall Runtime - a path argument (AGAST #4957)
#
# mkdir, unlink and rmdir take a path as (bytes, length) in two registers,
# as open and stat do. user_path is the checks they share, made once, on the
# caller's bytes, before the kernel reads them.
#
# Its own module: a bare `Ok(...)` is ambiguous in the handler modules,
# which import enums that declare `Ok` too (syscall/errno.ritz
# errno_result's note).

import serial { StrView }
import ritzlib.result { Result }
import syscall.errno { Errno }
import mm.uptr { uptr_check_read }
import goliath.path { GOLIATH_PATH_MAX, PATH_SEP }

# The (ptr, len) path argument as a view of the caller's bytes: non-empty,
# at most GOLIATH_PATH_MAX, readable, absolute. The kernel takes absolute
# paths only: userspace resolves a relative one, `.` and `..` against its
# cwd first (ritzlib.path, AGAST #4776).
pub fn user_path(ptr: u64, len: u64) -> Result<StrView, Errno>
    if len == 0
        return Err(Errno.Inval)
    if len > GOLIATH_PATH_MAX as u64
        return Err(Errno.NameTooLong)
    if uptr_check_read(ptr as *u8, len) != 0
        return Err(Errno.Fault)
    let path: StrView = StrView { ptr: ptr as *u8, len: len as i64 }
    if path.get(0) != PATH_SEP
        return Err(Errno.Inval)
    Ok(path)
