# Harland Syscall Runtime - IPC and Capabilities (AGAST #2751, from main.ritz)
#
# Channel/IPC and capability syscalls: user pointers are checked here, then
# ipc/syscall.ritz and cap/syscall.ritz act for the calling process.
# Each sys_*_handler is a `fn(rdi, rsi, rdx, r10) -> i64` registered in
# syscall/runtime/entry.ritz: syscall_table_init (AGAST #2121).

import mm.uptr { uptr_check_read, uptr_check_write }
import ipc.message { Message }
import ipc.syscall { sys_channel_create, sys_ipc_send, sys_ipc_recv, sys_ipc_close }
import cap.types { CapInfo }
import cap.syscall { sys_cap_grant, sys_cap_revoke, sys_cap_derive, sys_cap_info, sys_cap_check }
import syscall.errno { Errno }
import syscall.runtime.process { current_pid }

# IPC syscalls - use current_pid() instead of hardcoded 1
pub fn sys_channel_create_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_channel_create(current_pid())

pub fn sys_ipc_send_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate Message struct (4096 bytes) is readable
    let msg_result: i64 = uptr_check_read(rsi as *u8, 4096)
    if msg_result != 0
        return Errno.Fault as i64
    return sys_ipc_send(current_pid(), rdi as i32, rsi as *Message)

pub fn sys_ipc_recv_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate Message struct (4096 bytes) is writable
    let msg_result: i64 = uptr_check_write(rsi as *u8, 4096)
    if msg_result != 0
        return Errno.Fault as i64
    # Validate sender_pid output pointer (4 bytes for u32)
    if rdx != 0
        let sender_result: i64 = uptr_check_write(rdx as *u8, 4)
        if sender_result != 0
            return Errno.Fault as i64
    return sys_ipc_recv(current_pid(), rdi as i32, rsi as *Message, rdx as *u32)

pub fn sys_ipc_close_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_ipc_close(current_pid(), rdi as i32)

# Capability syscalls - use current_pid() instead of hardcoded 1
pub fn sys_cap_grant_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_cap_grant(current_pid(), rdi, rsi as u32, rdx as u32)

pub fn sys_cap_revoke_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_cap_revoke(current_pid(), rdi)

pub fn sys_cap_derive_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_cap_derive(current_pid(), rdi, rsi as u32)

pub fn sys_cap_info_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    # SECURITY: Validate CapInfo output struct (16 bytes) is writable
    let info_result: i64 = uptr_check_write(rsi as *u8, 16)
    if info_result != 0
        return Errno.Fault as i64
    return sys_cap_info(current_pid(), rdi, rsi as *CapInfo)

pub fn sys_cap_check_handler(rdi: u64, rsi: u64, rdx: u64, r10: u64) -> i64
    return sys_cap_check(current_pid(), rdi, rsi as u32)
