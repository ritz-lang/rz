# Harland Kernel Errno
#
# The kernel's one set of error codes (AGAST #2123). A syscall that fails
# returns -errno in rax, as on Linux, so each discriminant is the negated
# Linux errno number: user programs (ritzlib/sys.ritz E* constants) compare
# `-result` against the same numbers on either OS.
#
# Kernel code returns `Errno.X as i64` (or `as i32` where a module's own
# functions return i32) at the boundary; there are no loose E_*/EFAULT
# constants beside this enum. ritz0/test_harland_errno.py checks every
# discriminant against Linux's numbering and ritzlib's constants.
#
# Errors that are not errnos (the ELF loader's, loader/elf.ritz ElfStatus)
# have their own types, so they cannot be returned to user space as one.

# Errno.from (generated for every `enum E: T`) returns an Option.
import ritzlib.option

pub enum Errno: i64
    Perm = -1           # EPERM: operation not permitted
    NoEnt = -2          # ENOENT: no such file or directory
    Srch = -3           # ESRCH: no such process
    Io = -5             # EIO: I/O error
    TooBig = -7         # E2BIG: argument list too long
    NoExec = -8         # ENOEXEC: exec format error
    BadF = -9           # EBADF: bad file descriptor
    Child = -10         # ECHILD: no child processes
    Again = -11         # EAGAIN: resource temporarily unavailable
    NoMem = -12         # ENOMEM: out of memory
    Acces = -13         # EACCES: permission denied
    Fault = -14         # EFAULT: bad address
    Exist = -17         # EEXIST: file exists
    NoDev = -19         # ENODEV: no such device
    NotDir = -20        # ENOTDIR: not a directory
    IsDir = -21         # EISDIR: is a directory
    Inval = -22         # EINVAL: invalid argument
    NFile = -23         # ENFILE: too many open files
    NoSpc = -28         # ENOSPC: no space left on device
    Pipe = -32          # EPIPE: broken pipe
    Range = -34         # ERANGE: result too large (buffer too small)
    NameTooLong = -36   # ENAMETOOLONG: file name too long
    NoSys = -38         # ENOSYS: function not implemented
    NotEmpty = -39      # ENOTEMPTY: directory not empty
