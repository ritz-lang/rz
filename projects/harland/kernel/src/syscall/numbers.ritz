# Harland Syscall Numbers
#
# This is the SINGLE SOURCE OF TRUTH for all syscall numbers.
# All kernel subsystems should import from this file.
# DO NOT define syscall numbers anywhere else!
#
# Syscall numbering follows Linux conventions where practical,
# but diverges for Harland-specific syscalls.
#
# Each variant's discriminant is its syscall number (`Syscall.Write as u64`
# is 1); `Syscall.from(rax)` maps a number back, None if it is not a syscall
# (LANGUAGE_SPEC §10.4). syscall/dispatch.ritz keys its handler table on it.

import ritzlib.option

pub enum Syscall: u64
    # ========================================================================
    # File Operations (0-19)
    # ========================================================================

    Read = 0              # read(fd, buf, count) -> bytes_read
    Write = 1             # write(fd, buf, count) -> bytes_written
    Open = 2              # open(path, len, flags) -> fd
    Close = 3             # close(fd) -> 0
    Stat = 4              # stat(path, buf) -> 0
    Lseek = 8             # lseek(fd, offset, whence) -> position
    Mmap = 9              # mmap(addr, len, prot, flags) -> addr
    Munmap = 11           # munmap(addr, len) -> 0
    Readdir = 17          # readdir(path, buf, size) -> bytes

    # ========================================================================
    # Process Management (20-29)
    # ========================================================================

    Exit = 20             # exit(code) -> noreturn
    Spawn = 21            # spawn(path) -> pid
    Wait = 22             # wait(pid) -> exit_code
    Getpid = 23           # getpid() -> pid
    Yield = 24            # yield() -> 0
    SpawnArgs = 25        # spawn_args(path, argv, argc) -> pid
    Getcwd = 26           # getcwd(buf, size) -> len
    Chdir = 27            # chdir(path) -> 0
    SpawnEx = 28          # spawn_ex(path, argv, argc, stdin, stdout) -> pid
    Pipe = 29             # pipe() -> packed_fds

    # ========================================================================
    # IPC - Inter-Process Communication (30-39)
    # ========================================================================

    IpcSend = 30          # ipc_send(handle, msg) -> 0
    IpcRecv = 31          # ipc_recv(handle, msg, sender) -> 0
    IpcCall = 32          # ipc_call(handle, msg) -> 0 (send+recv)
    IpcClose = 33         # ipc_close(handle) -> 0

    # ========================================================================
    # Capabilities (40-49)
    # ========================================================================

    CapGrant = 40         # cap_grant(handle, target, rights) -> new_handle
    CapRevoke = 41        # cap_revoke(handle) -> 0
    CapDerive = 42        # cap_derive(handle, rights) -> new_handle
    CapInfo = 43          # cap_info(handle, info_buf) -> 0
    CapCheck = 44         # cap_check(handle, rights) -> 0 or -1

    # ========================================================================
    # Input Devices (50-59)
    # ========================================================================

    InputPoll = 50        # input_poll() -> count
    InputRead = 51        # input_read(event) -> 0 or -1

    # ========================================================================
    # Network (60-69)
    # ========================================================================

    NetInfo = 60          # net_info(info_buf) -> 0
    NetPing = 61          # net_ping(ip_addr, seq, timeout) -> rtt_ms

    # ========================================================================
    # Filesystem Extended (80-89)
    # ========================================================================

    Mkdir = 83            # mkdir(path, mode) -> 0

    # ========================================================================
    # Channels (100-109)
    # ========================================================================

    ChannelCreate = 100   # channel_create() -> handle

    # ========================================================================
    # Hardware/Power Management (200-209)
    # ========================================================================

    AcpiPoweroff = 200    # acpi_poweroff() -> noreturn

    # ========================================================================
    # Framebuffer/Graphics (210-219)
    # ========================================================================

    FbInfo = 210          # fb_info(info_buf) -> 0
    FbMap = 211           # fb_map() -> addr

    # ========================================================================
    # Debug (250-255)
    # ========================================================================

    DebugPrint = 255      # debug_print(buf, len) -> len
