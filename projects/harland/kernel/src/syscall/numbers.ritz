# Harland Syscall Numbers
#
# This is the SINGLE SOURCE OF TRUTH for all syscall numbers.
# All kernel subsystems should import from this file.
# DO NOT define syscall numbers anywhere else!
#
# Syscall numbering follows Linux conventions where practical,
# but diverges for Harland-specific syscalls.
#
# Every variant has a handler registered in syscall/runtime/entry.ritz
# (syscall_table_init):
# declare a syscall here only together with its handler. ritzlib/sys.ritz
# keeps its own copy of the numbers it wraps for harland; a test diffs it
# against this enum (ritz0/test_harland_syscall_dispatch.py, AGAST #2122).
# Numbers once declared without a handler, and so free: 29 (pipe), 32 (ipc_call), 60 and 61 (the old net_info and net_ping; NetInfo is 224).
#
# Each variant's discriminant is its syscall number (`Syscall.Write as u64`
# is 1); `Syscall.from(rax)` maps a number back, None if it is not a syscall
# (LANGUAGE_SPEC §10.4). syscall/dispatch.ritz keys its handler table on it.

import ritzlib.option

pub enum Syscall: u64
    # ========================================================================
    # File Operations (0-19)
    # ========================================================================

    Read = 0              # read(fd, buf, count) -> bytes_read
    Write = 1             # write(fd, buf, count) -> bytes_written
    Open = 2              # open(path, len, flags) -> fd
    Close = 3             # close(fd) -> 0
    Stat = 4              # stat(path, path_len, *Stat) -> 0 (Linux's struct stat, #4832)
    Fstat = 5             # fstat(fd, *Stat) -> 0
    Poll = 7              # poll(fds, nfds, timeout_ms) -> ready count (the console's timed read, #4829)
    Lseek = 8             # lseek(fd, offset, whence) -> position
    Mmap = 9              # mmap(addr, len, prot, flags) -> addr
    Munmap = 11           # munmap(addr, len) -> 0
    TtySetfg = 16         # tty_setfg(fd, mode, pid) -> 0 (the console's foreground, #4276)
    Readdir = 17          # readdir(path, buf, size) -> bytes
    TtyGetattr = 18       # tty_getattr(fd, attrs) -> 0 (the console's flags, #4254)
    TtySetattr = 19       # tty_setattr(fd, attrs) -> 0

    # ========================================================================
    # Process Management (20-29)
    # ========================================================================

    Exit = 20             # exit(code) -> noreturn
    Spawn = 21            # spawn(path) -> pid
    Wait = 22             # wait(pid) -> exit_code
    Getpid = 23           # getpid() -> pid
    Yield = 24            # yield() -> 0
    SpawnArgs = 25        # spawn_args(path, argv, argc) -> pid
    Getcwd = 26           # getcwd(buf, size) -> len
    Chdir = 27            # chdir(path) -> 0
    SpawnBg = 28          # spawn_bg(path, argv, argc) -> pid, without waiting (#3629)

    # ========================================================================
    # IPC - Inter-Process Communication (30-39)
    # ========================================================================

    IpcSend = 30          # ipc_send(handle, msg) -> 0
    IpcRecv = 31          # ipc_recv(handle, msg, sender) -> 0
    IpcClose = 33         # ipc_close(handle) -> 0

    # ========================================================================
    # Capabilities (40-49)
    # ========================================================================

    CapGrant = 40         # cap_grant(handle, target, rights) -> new_handle
    CapRevoke = 41        # cap_revoke(handle) -> 0
    CapDerive = 42        # cap_derive(handle, rights) -> new_handle
    CapInfo = 43          # cap_info(handle, info_buf) -> 0
    CapCheck = 44         # cap_check(handle, rights) -> 0 or -1

    # ========================================================================
    # Input Devices (50-59)
    # ========================================================================

    InputPoll = 50        # input_poll() -> count
    InputRead = 51        # input_read(event) -> 0 or -1

    # ========================================================================
    # Filesystem Extended (80-89)
    # ========================================================================

    Mkdir = 83            # mkdir(path, len) -> 0

    # ========================================================================
    # Channels (100-109)
    # ========================================================================

    ChannelCreate = 100   # channel_create() -> handle

    # ========================================================================
    # Synchronization (160-169)
    # ========================================================================

    # sync() -> 0. Linux's number (162), chosen over the free low numbers
    # (4, 29, 32, 60, 61): those are left for their Linux meanings (stat,
    # pipe, ...), and a program ported from Linux that calls sync asks for
    # 162. Saves the persistent /var subtree to the storage device (#4321).
    Sync = 162

    # ========================================================================
    # Hardware/Power Management (200-209)
    # ========================================================================

    AcpiPoweroff = 200    # acpi_poweroff() -> noreturn

    # ========================================================================
    # Framebuffer/Graphics (210-219)
    # ========================================================================

    FbInfo = 210          # fb_info(info_buf) -> 0
    FbMap = 211           # fb_map() -> addr

    # ========================================================================
    # Devices and shared objects (220-230, docs/RING1_DRIVER.md §5)
    # ========================================================================

    # drv_irq_wait(irq_handle, *WaitRequest) -> 0 IRQ, 1 deadline, 2 events
    # without the IRQ (#4719, #4727)
    DrvIrqWait = 220
    # drv_mmio_map(mmio_handle) -> user VA of the window's first page (#4720)
    DrvMmioMap = 221
    # drv_dma_alloc(irq_handle, size, *DmaAlloc) -> user VA of a zeroed run (#4721)
    DrvDmaAlloc = 222
    # drv_dma_free(irq_handle, vaddr, size) -> 0: the run leaves the device's
    # domain, then the PMM; the VA and IOVA go back on its free list (#4725)
    DrvDmaFree = 223
    NetInfo = 224         # net_info(*NetInfo) -> 0: the link snapshot (none: NoDev, #4730)
    NetAddr = 225         # net_addr(*NetAddr) -> 0 (no published lease: NoDev)
    # net_publish(link_handle) -> 0: sample the driver's link record (#4730)
    NetPublish = 226
    ShmMap = 227          # shm_map(shm_handle) -> user VA (#4717)
    NetAttach = 228       # net_attach() -> the app's exchange handle (no service: NoDev, #4728)
    # shm_wait(*WaitRequest) -> 2 events, 1 deadline (#4727)
    ShmWait = 229
    # shm_notify(shm_handle, bits) -> 0: DATA/SPACE to the other holders (#4727)
    ShmNotify = 230

    # ========================================================================
    # Debug (250-255)
    # ========================================================================

    DebugPrint = 255      # debug_print(buf, len) -> len

    # The kernel's boot-time SMP syscall-stack self-test (AGAST #4192): the
    # stub runs on every CPU at once, waits in the handler until all of them
    # are inside, and then leaves ring 3. Not a user ABI: no user program
    # calls it, and it exists so a boot can prove two CPUs take SYSCALL at
    # once on their own per-CPU stacks and frames.
    Smp = 254             # smp_test(phase) -> 0 (kernel self-test)

    # The kernel's smp-user boot test (AGAST #4881, docs/SMP_USER.md §6),
    # answered only while it runs (Errno.NoSys otherwise). Not a user ABI.
    # SmpUser is forwarded from an AP to the BSP like any syscall not marked
    # SYS_LOCAL; SmpUserLocal is SYS_LOCAL and runs on the caller's CPU.
    SmpUser = 253         # smp_user(op) -> op's result, on the BSP
    SmpUserLocal = 252    # smp_user_local(op) -> op's result, on the caller's CPU
