# Harland process table (AGAST #1882, #3629; LARB v4 M2)
#
# One Proc per process that is runnable, blocked, being built by spawn, or
# exited and not yet reaped. Spawn nests (init -> rzsh -> script -> command),
# each process with its own pid, cwd, page table and kernel stack, and with
# preemptive scheduling (#3629) several processes are runnable at once.
#
# A Proc's fds and mmap cursor are its FsProc (fs/syscall.ritz, #2753,
# #3530): syscall/runtime/process.ritz calls fs_process_start when it makes a
# child here and fs_process_end when the child exits, and proc/sched.ritz
# selects the running process's FsProc on every switch.
#
# This table only decides who runs: the state machine below and the
# round-robin pick. The switch itself (page table, TSS.rsp0, kernel stack,
# the saved kernel RSP `ksp`) is proc/sched.ritz. The table is pure Ritz
# (only errno), so the host tests in
# projects/ritz/ritz0/test_harland_process_model.py run it as it is.
#
# States:
#   NEW      spawn is building it (page table, ELF, stacks); never picked
#   RUNNING  runnable: the current process, or ready to be switched to
#   BLOCKED  waiting: for a child to exit (BLOCK_CHILD, wait_pid), for
#            console input (BLOCK_TTY), or on a pipe (BLOCK_PIPE); proc_exit_current / proc_wake make
#            it RUNNING again
#   ZOMBIE   exited; its parent hasn't reaped it
#
# A process whose parent exits first is detached: nobody can wait for it,
# and its own exit frees its slot instead of leaving a zombie.
#
# PROC_REAP in `flags` (proc_mark_exit, #4714): the kernel has told this
# process to exit. It is not killed where it stands: its next return to user
# (syscall_entry.s reap_if_marked) enters sys_exit_impl on its own kernel
# stack instead.
#
# The state word (AGAST #4879, docs/SMP_USER.md §4). A slot's state is one
# 64-bit atomic word, {generation: u32 (high), state: u32 (low)}, so a wake
# from any CPU is a compare-and-swap and needs no lock. The generation is
# bumped each time spawn reuses the slot, so a waker holding a stale view
# (the slot's previous process) fails its CAS and touches nothing. The
# transitions and who makes them:
#   (new) -> RUNNING   spawn (the BSP, which owns the table's shared part):
#                      fill the slot, then publish the word (atomic store)
#   RUNNING -> BLOCKED the process itself: atomic xchg ("sleep.announce" in
#                      test/test_smp_proto.ritz), then its caller re-checks
#                      what it waits for and CASes back if it is already
#                      there (proc_unblock_current, "sleep.recheck")
#   BLOCKED -> RUNNING any waker: CAS on the whole word ("notify.wake"); a
#                      failed CAS means it was already running or the slot
#                      was reused: nothing to do. Then the process's CPU is
#                      kicked if it is idle ("notify.kick")
# The other fields (block, wait_pid, flags) are written only by the CPU that
# owns the slot's part they belong to; a waker reads `block` after it has
# seen BLOCKED (TSO keeps the owner's earlier stores before its xchg).
#
# Per CPU (SMP_USER.md §2): each CPU has its own current slot (-1 on its
# idle context) and its own round-robin position. The CPU index comes from
# `extern fn cpu_index` (arch/x86_64/percpu.ritz in the kernel; a host test
# supplies a stub), declared rather than imported so this module stays pure.
#
# Pinning (AGAST #4881, SMP_USER.md §1, §5): every process has a home, the
# CPU its user code runs on, and `on`, the CPU it is on right now: its home,
# or the BSP while a forwarded syscall runs there (§2). A CPU picks only the
# processes on it. Every process is homed on the BSP (PROC_BSP_CPU), its
# children included, unless the kernel placed it elsewhere at spawn
# (proc_set_home, before proc_start). `on` is an atomic word: the CPU a
# process leaves publishes the move with it, after it is off the process's
# stack and out of its address space (proc/sched.ritz sched_move).

import syscall.errno { Errno }
import ritzlib.strview { StrView }
import ritzlib.result { Result }

# The kernel's are arch/x86_64/percpu.ritz cpu_index and sync/idle.ritz
# cpu_kick_if_idle.
extern fn cpu_index() -> i32
extern fn cpu_kick_if_idle(cpu: i32)

# Live and zombie processes at once; fs/syscall.ritz has FS_MAX_PROCS FsProcs
# and syscall_entry.s one kernel stack per slot (KSTACK_SLOTS), both pinned
# equal to it. 32 (#4954): init, rzsh, an editor, ritz-lsp and its ritz1
# take five before the ring-1 driver, netd or anything else.
pub const MAX_PROCS: i32 = 32

# The BSP's CPU index: every process's home unless the kernel placed it
# elsewhere, and the CPU a forwarded syscall runs on.
pub const PROC_BSP_CPU: i32 = 0

# MAX_CPUS (arch/x86_64/cpu_map.ritz): the per-CPU arrays' literal length.
const PROC_MAX_CPUS: i32 = 64

pub const PROC_FREE: u8 = 0
pub const PROC_RUNNING: u8 = 1
pub const PROC_BLOCKED: u8 = 2
pub const PROC_ZOMBIE: u8 = 3
pub const PROC_NEW: u8 = 4

# Why a BLOCKED process waits.
pub const BLOCK_NONE: u8 = 0
pub const BLOCK_CHILD: u8 = 1       # for child wait_pid to exit (wait, blocking spawn)
pub const BLOCK_TTY: u8 = 2         # for console input (read(0))
pub const BLOCK_IRQ: u8 = 3         # for a device interrupt (a driver wait, #4220)
pub const BLOCK_WAIT: u8 = 4        # on its own wait set (DrvIrqWait, proc/waitset.ritz, #4719)
pub const BLOCK_PIPE: u8 = 5        # for a pipe to take or give bytes (syscall/runtime/pipe.ritz, #4955)

# Proc.flags
pub const PROC_REAP: u8 = 1         # exit at the next return to user (proc_mark_exit)

# Why proc_mark_exit refused.
pub enum MarkError
    Init            # pid 1: init is never reaped this way
    NoProcess       # no live process (not a zombie) has that pid

# proc_child_status
pub const PROC_CHILD_EXITED: i32 = 0
pub const PROC_CHILD_LIVE: i32 = 1

pub const PROC_CWD_MAX: i64 = 255

# A working directory: up to PROC_CWD_MAX path bytes and their count, with a
# NUL just past them for getcwd's copy-out. Read it as a StrView
# (proc_cwd); write it from one (proc_set_cwd) (AGAST #4600).
pub struct Cwd
    bytes: [256]u8
    len: u16

pub struct Proc
    pid: u64
    word: u64               # the state word: generation << 32 | state (above); atomic only
    parent: i32             # procs index of the spawning process; -1 for init or detached
    block: u8               # BLOCKED: why (BLOCK_*)
    detached: u8            # its parent exited: its exit frees it, no zombie
    flags: u8               # PROC_REAP
    pml4: u64               # page table (CR3)
    ksp: u64                # kernel RSP saved by sched_switch while it isn't running
    wait_pid: u64           # BLOCK_CHILD: the child it waits for
    exit_code: i64          # valid in PROC_ZOMBIE
    home: i32               # the CPU its user code runs on (fixed once started)
    on: u32                 # the CPU it is on now (atomic only): home, or the BSP for a forwarded call
    cwd: Cwd

var procs: [MAX_PROCS]Proc
# This CPU's current slot plus one, by CPU index: 0 is none (before init, or
# on the CPU's idle context), so the zeroed BSS means "nothing running".
var proc_cur_by_cpu: [64]i32
# Where this CPU's round robin last switched to: the pick starts after it.
var proc_last_by_cpu: [64]i32
var proc_next_pid: u64 = 2

const STATE_MASK: u64 = 0xFFFFFFFF

fn word_state(w: u64) -> u8
    (w & STATE_MASK) as u8

fn word_gen(w: u64) -> u64
    w >> 32

fn word_make(gen: u64, state: u8) -> u64
    (gen << 32) | state as u64

fn word_of(i: i32) -> u64
    atomic_load(@procs[i].word)

# The state of slot `i` (PROC_*), read atomically.
pub fn proc_state(i: i32) -> u8
    word_state(word_of(i))

# The state of `p` (PROC_*), read atomically.
pub fn proc_state_of(p: *Proc) -> u8
    word_state(atomic_load(@(*p).word))

# The owner sets slot `i`'s state, keeping its generation.
fn set_state(i: i32, state: u8)
    atomic_store(@procs[i].word, word_make(word_gen(word_of(i)), state))

# This CPU's current slot, or -1.
fn cur() -> i32
    proc_cur_by_cpu[cpu_index()] - 1

# BLOCKED -> RUNNING for slot `i` as last seen in `w`: one CAS
# ("notify.wake"), then a kick if its CPU is idle ("notify.kick"). True if
# this call woke it.
fn wake_word(i: i32, w: u64) -> bool
    if word_state(w) != PROC_BLOCKED
        return false
    if atomic_cmpxchg(@procs[i].word, w, word_make(word_gen(w), PROC_RUNNING)) != w
        return false
    cpu_kick_if_idle(proc_on(i))
    true

# Slot `i`'s state word as a waker reads it before its CAS.
pub fn proc_word(i: i32) -> u64
    word_of(i)

# A wake of slot `i` from a waker that read `w` earlier (proc_word): true if
# it woke it, false if the slot moved on (another wake, or a reuse with a new
# generation) and nothing changed.
pub fn proc_wake_seen(i: i32, w: u64) -> bool
    wake_word(i, w)

fn proc_free(i: i32)
    set_state(i, PROC_FREE)
    procs[i].home = PROC_BSP_CPU
    atomic_store(@procs[i].on, PROC_BSP_CPU as u32)
    procs[i].pid = 0
    procs[i].parent = -1
    procs[i].block = BLOCK_NONE
    procs[i].detached = 0
    procs[i].flags = 0
    procs[i].wait_pid = 0

# Empty table, nothing running (boot; the host tests).
pub fn proc_table_reset()
    var i: i32 = 0
    while i < MAX_PROCS
        atomic_store(@procs[i].word, 0)
        proc_free(i)
        i = i + 1
    var c: i32 = 0
    while c < PROC_MAX_CPUS
        proc_cur_by_cpu[c] = 0
        proc_last_by_cpu[c] = 0
        c = c + 1
    proc_next_pid = 2

# The running process, or null before init.
pub fn proc_current() -> *Proc
    let c: i32 = cur()
    if c < 0
        return 0 as *Proc
    @procs[c]

# The running process's slot (its kernel stack's index), or -1 before init
# and on this CPU's idle context.
pub fn proc_current_slot() -> i32
    cur()

# The running process's pid, or 0 before init.
pub fn proc_current_pid() -> u64
    let c: i32 = cur()
    if c < 0
        return 0
    procs[c].pid

# The Proc in slot `slot` (0 <= slot < MAX_PROCS).
pub fn proc_at(slot: i32) -> *Proc
    @procs[slot]

# init is pid 1: it has no parent, Ctrl-C never kills it, its exit powers off.
pub fn proc_is_init(p: *Proc) -> bool
    p != 0 as *Proc and p.pid == 1

# Processes in the table: new, running, blocked or zombie.
pub fn proc_live_count() -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < MAX_PROCS
        if proc_state(i) != PROC_FREE
            n = n + 1
        i = i + 1
    n

# Processes that can run now on CPU `cpu` (RUNNING and on it), its current
# one included: what that CPU's tick and its waits compare against.
pub fn proc_runnable_on(cpu: i32) -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < MAX_PROCS
        if proc_state(i) == PROC_RUNNING and proc_on(i) == cpu
            n = n + 1
        i = i + 1
    n

# Live processes (new, running or blocked: not free, not zombie) homed on
# CPU `cpu`. An AP's tick runs only while it has two or more (§4).
pub fn proc_homed_count(cpu: i32) -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < MAX_PROCS
        let st: u8 = proc_state(i)
        if st != PROC_FREE and st != PROC_ZOMBIE and procs[i].home == cpu
            n = n + 1
        i = i + 1
    n

# Slot `slot`'s home CPU.
pub fn proc_home(slot: i32) -> i32
    procs[slot].home

# The CPU slot `slot` is on now (an atomic read: another CPU publishes it).
pub fn proc_on(slot: i32) -> i32
    atomic_load(@procs[slot].on) as i32

# Slot `slot` is on CPU `cpu` from now on: the CPU it left publishes the
# move (proc/sched.ritz sched_move), once it is off its stack and space.
pub fn proc_set_on(slot: i32, cpu: i32)
    atomic_store(@procs[slot].on, cpu as u32)

# Place NEW slot `slot` on CPU `cpu`, before proc_start: the kernel's
# placement (SMP_USER.md §5, syscall/runtime/process.ritz
# process_spawn_program_on). A started process never changes home: refused.
pub fn proc_set_home(slot: i32, cpu: i32)
    if proc_state(slot) != PROC_NEW
        return
    procs[slot].home = cpu
    atomic_store(@procs[slot].on, cpu as u32)

fn proc_free_slot() -> i32
    var i: i32 = 0
    while i < MAX_PROCS
        if proc_state(i) == PROC_FREE
            return i
        i = i + 1
    -1

# The running process becomes init: pid 1, no parent, cwd "/", page table
# `pml4`. 0, or Errno.Again if the table is full.
pub fn proc_enter_init(pml4: u64) -> i32
    let slot: i32 = proc_free_slot()
    if slot < 0
        return Errno.Again as i32
    let p: *Proc = @procs[slot]
    (*p).pid = 1
    (*p).parent = -1
    (*p).block = BLOCK_NONE
    (*p).detached = 0
    (*p).flags = 0
    (*p).pml4 = pml4
    (*p).ksp = 0
    (*p).wait_pid = 0
    (*p).exit_code = 0
    (*p).home = PROC_BSP_CPU
    atomic_store(@(*p).on, PROC_BSP_CPU as u32)
    (*p).cwd.bytes[0] = 47  # '/'
    (*p).cwd.bytes[1] = 0
    (*p).cwd.len = 1
    # Filled: publish it, a new generation, RUNNING.
    atomic_store(@(*p).word, word_make(word_gen(word_of(slot)) + 1, PROC_RUNNING))
    proc_set_current(slot)
    0

# The running process starts a child: a NEW Proc with the next pid and its
# parent's cwd. The parent stays current and runnable; the caller builds the
# child (page table, kernel stack) and proc_start()s it, or
# proc_abort_child()s it. The child's slot, or Errno.Srch with no running
# process, or Errno.Again if the table is full.
pub fn proc_new_child() -> i32
    let me: i32 = cur()
    if me < 0
        return Errno.Srch as i32
    let slot: i32 = proc_free_slot()
    if slot < 0
        return Errno.Again as i32
    let parent: *Proc = @procs[me]
    let c: *Proc = @procs[slot]
    # A new generation: a waker still holding the slot's last process fails
    # its CAS.
    atomic_store(@(*c).word, word_make(word_gen(word_of(slot)) + 1, PROC_NEW))
    (*c).pid = proc_next_pid
    proc_next_pid = proc_next_pid + 1
    (*c).parent = me
    (*c).block = BLOCK_NONE
    (*c).detached = 0
    (*c).flags = 0
    (*c).pml4 = 0
    (*c).ksp = 0
    (*c).wait_pid = 0
    (*c).exit_code = 0
    # The BSP, whatever the parent's home: only the kernel places a process
    # elsewhere (proc_set_home).
    (*c).home = PROC_BSP_CPU
    atomic_store(@(*c).on, PROC_BSP_CPU as u32)
    (*c).cwd = (*parent).cwd
    slot

# A NEW child is built: it becomes runnable.
pub fn proc_start(slot: i32)
    if proc_state(slot) == PROC_NEW
        # Every field is written: the store publishes them (TSO keeps them
        # before it), then its home is kicked if it idles. Its rows pass from
        # the BSP to its home here (SMP_USER.md §5).
        set_state(slot, PROC_RUNNING)
        cpu_kick_if_idle(proc_on(slot))

# Undo proc_new_child for a child that never ran (a failed load): its slot is
# freed, and nobody can wait for it.
pub fn proc_abort_child(slot: i32)
    if proc_state(slot) == PROC_NEW
        proc_free(slot)

# The running process blocks: for child `pid` to exit (BLOCK_CHILD) or for
# console input (BLOCK_TTY, pid 0). It stays current until the scheduler
# switches away. The reason is written first, then the state word is
# swapped to BLOCKED ("sleep.announce": a locked op, so the caller's
# re-check below cannot be ordered before it). The caller then re-checks
# what it waits for and, if it is already there, calls
# proc_unblock_current; every wait loops on its condition anyway, so a
# spurious wake costs one re-check.
pub fn proc_block(reason: u8, pid: u64)
    let me: i32 = cur()
    if me < 0
        return
    procs[me].block = reason
    procs[me].wait_pid = pid
    let w: u64 = word_of(me)
    atomic_xchg(@procs[me].word, word_make(word_gen(w), PROC_BLOCKED))

# The running process's re-check after proc_block found what it waits for
# ("sleep.recheck"): it is runnable again, unless a waker got there first
# (the CAS fails, and it is RUNNING either way).
pub fn proc_unblock_current()
    let me: i32 = cur()
    if me < 0
        return
    wake_word(me, word_of(me))

# Every process blocked for `reason` becomes runnable (BLOCK_TTY: input came).
pub fn proc_wake(reason: u8)
    var i: i32 = 0
    while i < MAX_PROCS
        let w: u64 = word_of(i)
        if word_state(w) == PROC_BLOCKED and procs[i].block == reason
            wake_word(i, w)
        i = i + 1

# Process `pid`, if it is blocked for `reason`, becomes runnable: true if
# it was. Only that process: a wait-set post (proc/waitset.ritz) or deadline
# wakes its one waiter, never everyone blocked for the same reason.
pub fn proc_wake_pid(pid: u64, reason: u8) -> bool
    if pid == 0
        return false
    var i: i32 = 0
    while i < MAX_PROCS
        # The word first, then pid and block: a slot reused in between has a
        # new generation, and the CAS fails.
        let w: u64 = word_of(i)
        if word_state(w) == PROC_BLOCKED and procs[i].pid == pid and procs[i].block == reason
            return wake_word(i, w)
        i = i + 1
    false

# The kernel tells process `pid` to exit (RING1_DRIVER.md "Driver death",
# #4714): PROC_REAP is set, and a parked pid is woken so it reaches its return
# to user, where the reap happens. The caller is not the process that exits,
# and nothing is torn down here.
pub fn proc_mark_exit(pid: u64) -> Result<(), MarkError>
    if pid == 0
        return Err(MarkError.NoProcess)
    var i: i32 = 0
    while i < MAX_PROCS
        let p: *Proc = @procs[i]
        let w: u64 = word_of(i)
        let st: u8 = word_state(w)
        if p.pid == pid and st != PROC_FREE and st != PROC_ZOMBIE
            if proc_is_init(p)
                return Err(MarkError.Init)
            (*p).flags = p.flags | PROC_REAP
            # The flag before the wake: the woken process sees it on its way
            # back to user.
            wake_word(i, w)
            return Ok(())
        i = i + 1
    Err(MarkError.NoProcess)

# Live process `pid` has no parent to wait for it from now on: its exit
# frees its slot and leaves no zombie (a kernel-spawned /bin/netd, AGAST
# #4745, which the kernel restarts and nobody reaps). False for no live
# process (or a zombie) of that pid.
pub fn proc_detach(pid: u64) -> bool
    var i: i32 = 0
    while i < MAX_PROCS
        let p: *Proc = @procs[i]
        let st: u8 = proc_state(i)
        if pid != 0 and p.pid == pid and st != PROC_FREE and st != PROC_ZOMBIE
            (*p).parent = -1
            (*p).detached = 1
            return true
        i = i + 1
    false

# `p` is marked to exit at its next return to user.
pub fn proc_reap_pending(p: *Proc) -> bool
    p != 0 as *Proc and (p.flags & PROC_REAP) != 0

# The running process is marked PROC_REAP: 1, else 0. A u64 for
# syscall_entry.s reap_if_marked, which tests it in RAX.
pub fn proc_reap_current() -> u64
    let me: i32 = cur()
    if me >= 0 and proc_reap_pending(@procs[me])
        return 1
    0

# The running process exits with `code`. Its unreaped children go with it,
# its live children are detached, and it becomes a zombie for its parent's
# wait (a parent blocked on it runs again), or free if it was detached. It
# stays current until the scheduler switches away. 0, or Errno.Srch with no
# running process; init (no parent) leaves the table as it is: -1.
pub fn proc_exit_current(code: i64) -> i32
    let me: i32 = cur()
    if me < 0
        return Errno.Srch as i32
    let c: *Proc = @procs[me]
    if proc_is_init(c)
        return -1
    var i: i32 = 0
    while i < MAX_PROCS
        let st: u8 = proc_state(i)
        if st != PROC_FREE and procs[i].parent == me and i != me
            if st == PROC_ZOMBIE
                proc_free(i)
            else
                procs[i].parent = -1
                procs[i].detached = 1
        i = i + 1
    (*c).exit_code = code
    (*c).block = BLOCK_NONE
    if (*c).detached != 0 or (*c).parent < 0
        # Nobody will wait: the slot is free once the scheduler leaves it.
        proc_free(me)
        return 0
    set_state(me, PROC_ZOMBIE)
    let pi: i32 = (*c).parent
    let pw: u64 = word_of(pi)
    if word_state(pw) == PROC_BLOCKED and procs[pi].block == BLOCK_CHILD and procs[pi].wait_pid == (*c).pid
        wake_word(pi, pw)
    0

# The running process's child `pid`: PROC_CHILD_EXITED with its exit code in
# *code (not reaped), PROC_CHILD_LIVE while it runs or blocks, or
# Errno.Child if `pid` is no child of the caller.
pub fn proc_child_status(pid: u64, code: *i64) -> i32
    let me: i32 = cur()
    if me < 0 or pid == 0
        return Errno.Child as i32
    var i: i32 = 0
    while i < MAX_PROCS
        let st: u8 = proc_state(i)
        if st != PROC_FREE and procs[i].pid == pid and procs[i].parent == me
            if st == PROC_ZOMBIE
                *code = procs[i].exit_code
                return PROC_CHILD_EXITED
            return PROC_CHILD_LIVE
        i = i + 1
    Errno.Child as i32

# The running process reaps its exited child `pid`: the child's exit code,
# or Errno.Child if `pid` is no exited child of the caller.
pub fn proc_wait(pid: u64) -> i64
    let me: i32 = cur()
    if me < 0 or pid == 0
        return Errno.Child as i64
    var i: i32 = 0
    while i < MAX_PROCS
        if procs[i].pid == pid and procs[i].parent == me and proc_state(i) == PROC_ZOMBIE
            let code: i64 = procs[i].exit_code
            proc_free(i)
            return code
        i = i + 1
    Errno.Child as i64

# The CPU process `pid` is on: the one that owns its per-process rows and is
# the only CPU that may load its PML4 (SMP_USER.md §2, §3). An unmap from
# its space is a request to that CPU (mm/tlb.ritz tlb_unmap_on). The BSP
# for no live process of that pid.
pub fn proc_on_cpu(pid: u64) -> i32
    var i: i32 = 0
    while i < MAX_PROCS
        if pid != 0 and procs[i].pid == pid and proc_state(i) != PROC_FREE
            return proc_on(i)
        i = i + 1
    PROC_BSP_CPU

# Round robin on this CPU: the first runnable slot on it after the one it
# last switched to, wrapping, that one last (so it keeps running when
# nothing else can). -1 if no process is runnable here.
pub fn proc_pick_next() -> i32
    let cpu: i32 = cpu_index()
    let start: i32 = proc_last_by_cpu[cpu]
    var n: i32 = 0
    while n < MAX_PROCS
        let i: i32 = (start + n) % MAX_PROCS
        if proc_state(i) == PROC_RUNNING and proc_on(i) == cpu
            return i
        n = n + 1
    -1

# Slot `slot` is now this CPU's running process (the scheduler has switched
# to it), or -1: the CPU is on its idle context.
pub fn proc_set_current(slot: i32)
    let cpu: i32 = cpu_index()
    proc_cur_by_cpu[cpu] = slot + 1
    if slot >= 0
        proc_last_by_cpu[cpu] = (slot + 1) % MAX_PROCS

# The running process's cwd. A NUL follows it (ptr[len] == 0).
pub fn proc_cwd() -> StrView
    let c: *Cwd = @procs[cur()].cwd
    StrView { ptr: @(*c).bytes[0], len: (*c).len as i64 }

# Set the running process's cwd to `path` (the caller checked it exists).
# 0, or Errno.NameTooLong.
pub fn proc_set_cwd(path: StrView) -> i32
    if path.len > PROC_CWD_MAX
        return Errno.NameTooLong as i32
    let c: *Cwd = @procs[cur()].cwd
    var i: i64 = 0
    while i < path.len
        (*c).bytes[i] = *(path.ptr + i)
        i = i + 1
    (*c).bytes[path.len] = 0
    (*c).len = path.len as u16
    0

# The running process descends from pid `root` (through `parent`), or is
# it when or_self. The console's foreground asks (tty/fg.ritz, #4276).
pub fn proc_current_descends_from(root: u64, or_self: bool) -> bool
    let me: i32 = cur()
    if me < 0 or root == 0
        return false
    var i: i32 = me
    if not or_self
        i = procs[i].parent
    var hops: i32 = 0
    while i >= 0 and hops < MAX_PROCS
        if procs[i].pid == root
            return true
        i = procs[i].parent
        hops = hops + 1
    false
