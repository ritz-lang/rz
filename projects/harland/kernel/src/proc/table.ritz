# Harland process table (AGAST #1882, LARB v4 M2)
#
# One Proc per process that is running, blocked in spawn, or exited and not
# yet reaped. It replaces the single-parent globals the blocking spawn kept
# (g_parent_ctx, g_parent_frame, g_has_parent, g_child_pid = 2,
# g_child_pml4) and the one g_cwd, so spawn nests: init -> rzsh -> script ->
# command, each with its own pid, saved frame and cwd.
#
# A Proc's fds and mmap cursor are its FsProc (fs/syscall.ritz, #2753,
# #3530): syscall/runtime/process.ritz calls fs_process_start when it makes
# a child here and fs_process_end when the child exits, so the two stacks
# move together.
#
# Spawn is still blocking: the parent sleeps in its saved syscall frame
# until the child exits, so exactly one Proc runs and it is the deepest.
# The table is pure Ritz (only errno), so the host tests in
# projects/ritz/ritz0/test_harland_process_model.py run it as it is.

import syscall.errno { Errno }

# Live and zombie processes at once; fs/syscall.ritz has FS_MAX_PROCS FsProcs.
pub const MAX_PROCS: i32 = 8

pub const PROC_FREE: u8 = 0
pub const PROC_RUNNING: u8 = 1
pub const PROC_BLOCKED: u8 = 2      # in spawn, waiting for its child to exit
pub const PROC_ZOMBIE: u8 = 3       # exited; its parent hasn't reaped it

# syscall_save_user_frame's layout (syscall_entry.s): GPRs, RIP, RFLAGS, RSP.
pub const PROC_FRAME_WORDS: i32 = 16
pub const PROC_CWD_MAX: i64 = 255

pub struct Proc
    pid: u64
    parent: i32             # procs index of the spawning process; -1 for init
    state: u8
    pml4: u64               # page table (CR3); the parent's is restored on exit
    frame: [16]u64          # the user frame spawn blocked in; resumed on exit
    exit_code: i64          # valid in PROC_ZOMBIE
    cwd: [256]u8            # null-terminated
    cwd_len: u16

var procs: [8]Proc
var proc_cur: i32 = -1
var proc_next_pid: u64 = 2

# Empty table, nothing running (boot; the host tests).
pub fn proc_table_reset()
    var i: i32 = 0
    while i < MAX_PROCS
        procs[i].state = PROC_FREE
        procs[i].pid = 0
        i = i + 1
    proc_cur = -1
    proc_next_pid = 2

# The running process, or null before init.
pub fn proc_current() -> *Proc
    if proc_cur < 0
        return 0 as *Proc
    @procs[proc_cur]

# The running process's pid, or 0 before init.
pub fn proc_current_pid() -> u64
    if proc_cur < 0
        return 0
    procs[proc_cur].pid

# Where p's user frame is saved while it is blocked in spawn.
pub fn proc_frame(p: *Proc) -> *u64
    @(*p).frame[0]

# Processes in the table: running, blocked or zombie.
pub fn proc_live_count() -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < MAX_PROCS
        if procs[i].state != PROC_FREE
            n = n + 1
        i = i + 1
    n

fn proc_free_slot() -> i32
    var i: i32 = 0
    while i < MAX_PROCS
        if procs[i].state == PROC_FREE
            return i
        i = i + 1
    -1

# The running process becomes init: pid 1, no parent, cwd "/", page table
# `pml4`. 0, or Errno.Again if the table is full.
pub fn proc_enter_init(pml4: u64) -> i32
    let slot: i32 = proc_free_slot()
    if slot < 0
        return Errno.Again as i32
    let p: *Proc = @procs[slot]
    (*p).pid = 1
    (*p).parent = -1
    (*p).state = PROC_RUNNING
    (*p).pml4 = pml4
    (*p).exit_code = 0
    (*p).cwd[0] = 47  # '/'
    (*p).cwd[1] = 0
    (*p).cwd_len = 1
    proc_cur = slot
    0

# The running process spawns: a new Proc, with the next pid and its parent's
# cwd, becomes current; the parent blocks. The caller saves the parent's
# frame and page table first and sets the child's pml4 after. 0,
# Errno.Srch with no running process, or Errno.Again if the table is full.
pub fn proc_spawn_child() -> i32
    if proc_cur < 0
        return Errno.Srch as i32
    let slot: i32 = proc_free_slot()
    if slot < 0
        return Errno.Again as i32
    let parent: *Proc = @procs[proc_cur]
    let c: *Proc = @procs[slot]
    (*c).pid = proc_next_pid
    proc_next_pid = proc_next_pid + 1
    (*c).parent = proc_cur
    (*c).state = PROC_RUNNING
    (*c).pml4 = 0
    (*c).exit_code = 0
    var i: i32 = 0
    while i <= (*parent).cwd_len as i32
        (*c).cwd[i] = (*parent).cwd[i]
        i = i + 1
    (*c).cwd_len = (*parent).cwd_len
    (*parent).state = PROC_BLOCKED
    proc_cur = slot
    0

# Undo proc_spawn_child for a child that never ran (a failed load): its slot
# is freed, unreapable, and the parent runs again.
pub fn proc_abort_child()
    let c: *Proc = @procs[proc_cur]
    let parent: i32 = (*c).parent
    (*c).state = PROC_FREE
    (*c).pid = 0
    proc_cur = parent
    procs[parent].state = PROC_RUNNING

# The running process exits with `code`. A child becomes a zombie for its
# parent's wait, its own unreaped children go with it, and its parent
# becomes current and running: returned, for the caller to switch to its
# page table and resume its frame. init has no parent: null, and the table
# is left as it is.
pub fn proc_exit_current(code: i64) -> *Proc
    if proc_cur < 0
        return 0 as *Proc
    let c: *Proc = @procs[proc_cur]
    if (*c).parent < 0
        return 0 as *Proc
    # Blocking spawn: anything below the exiting process has exited too.
    var i: i32 = 0
    while i < MAX_PROCS
        if procs[i].state == PROC_ZOMBIE and procs[i].parent == proc_cur
            procs[i].state = PROC_FREE
            procs[i].pid = 0
        i = i + 1
    (*c).exit_code = code
    (*c).state = PROC_ZOMBIE
    (*c).pml4 = 0
    proc_cur = (*c).parent
    procs[proc_cur].state = PROC_RUNNING
    @procs[proc_cur]

# The running process reaps its exited child `pid`: the child's exit code,
# or Errno.Child if `pid` is no exited child of the caller.
pub fn proc_wait(pid: u64) -> i64
    if proc_cur < 0 or pid == 0
        return Errno.Child as i64
    var i: i32 = 0
    while i < MAX_PROCS
        if procs[i].pid == pid and procs[i].parent == proc_cur and procs[i].state == PROC_ZOMBIE
            procs[i].state = PROC_FREE
            procs[i].pid = 0
            return procs[i].exit_code
        i = i + 1
    Errno.Child as i64

# The running process's cwd, null-terminated; its length goes to *len.
pub fn proc_cwd(len: *u16) -> *u8
    let p: *Proc = @procs[proc_cur]
    *len = (*p).cwd_len
    @(*p).cwd[0]

# Set the running process's cwd to path[0..n] (the caller checked it
# exists). 0, or Errno.NameTooLong.
pub fn proc_set_cwd(path: *u8, n: i64) -> i32
    if n > PROC_CWD_MAX
        return Errno.NameTooLong as i32
    let p: *Proc = @procs[proc_cur]
    var i: i64 = 0
    while i < n
        (*p).cwd[i] = *(path + i)
        i = i + 1
    (*p).cwd[n] = 0
    (*p).cwd_len = n as u16
    0
