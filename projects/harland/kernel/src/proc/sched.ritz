# Harland scheduler: preemptive round robin of user processes (AGAST #3629)
#
# proc/table.ritz decides who may run (states, the round-robin pick); this
# module makes the switch. A switch, always from inside the kernel with
# IF=0, points everything per-process at the next process:
#   * CR3                its page table
#   * TSS.rsp0           its kernel stack's top (a ring-3 IRQ lands there)
#   * PC_KSTACK_TOP      the same top (syscall_entry's RSP, per CPU)
#   * the fs layer       its FsProc (fs_process_select)
# then swaps kernel stacks (proc_switch.s sched_switch). The process
# switched to returns from its own sched_switch and unwinds to its own
# iretq: out of the timer IRQ that preempted it, or out of the syscall it
# blocked or yielded in. A new process starts from a frame
# sched_prepare_user builds on its kernel stack.
#
# Where switches happen:
#   * sched_tick: the periodic LAPIC timer (apic.ritz lapic_timer_start),
#     when it interrupted a process (any non-zero CPL). A tick in ring 0 (a syscall, a driver
#     wait, the idle hlt) only counts: the kernel is not preemptible, so its
#     globals need no locks.
#   * sched_yield: sys_yield.
#   * sched_block: wait / blocking spawn (BLOCK_CHILD), read(0) (BLOCK_TTY).
#     With nothing runnable the CPU switches to its idle context.
#   * sched_exit: an exiting or killed process leaves for good, always onto
#     the idle context, which picks what runs next.
#
# The idle context (AGAST #4879, docs/SMP_USER.md §4 "CPU-level sleep"):
# each CPU that runs the scheduler has one, on its own per-CPU stack
# (percpu.ritz CPU_IDLE), made by sched_start. It is "no process": the
# CPU's current slot is -1 there, so an IRQ that lands while it sleeps
# parks nobody (waitq_can_park), and a blocked or exited process's stack is
# never the one the CPU idles on. Its loop is the handshake with every
# waker and mailbox producer (sync/idle.ritz): announce idle with a locked
# op, re-check for a runnable process or a mailbox message, and only then
# sti;hlt. A kick sent after the announce is held while IF=0 and wakes the
# hlt, so no wake-up is lost. Until sched_start has made it (boot
# self-tests that block before the scheduler runs) sched_block idles in
# place as before.
#
# Per CPU: the counters and `running` are each CPU's own (SMP_USER.md §2
# inventory), summed for the reports. Each CPU runs the processes on it
# (proc/table.ritz proc_pick_next: `on == cpu`).
#
# APs (AGAST #4881, SMP_USER.md §1, §2): an AP leaves its boot idle loop for
# its idle context here (sched_ap_enter) and from then on runs the
# processes homed on it. Its tick runs only while it has two or more live
# homed processes (sched_ap_tick_update); the global duties (the NVMe
# watchdog, wait-set deadlines, shm detach timeouts) stay on the BSP's.
#
# A move (sched_move): a syscall an AP may not run locally carries its
# process to the BSP and back (FORWARD, then RETURN), as do Exit and a kill
# (sys_exit_impl). The process switches onto its CPU's idle context, which
# finishes the move: it drops the process's address space (the kernel's
# PML4 loaded), publishes `on` and posts the message. Only then can the
# other CPU pick it, so only one CPU holds its stack and space at a time.

import klog { klog, klog_dec }
import io { sti_hlt, disable_interrupts, enable_interrupts, interrupts_enabled, rdtsc }
import mm.vmm { vmm_switch_pml4, vmm_get_current_pml4, vmm_load_kernel_pml4 }
import arch.x86_64.gdt { gdt_set_kernel_stack_cpu }
import arch.x86_64.percpu { cpu_index, cpu_stack_top, CPU_IDLE }
import arch.x86_64.cpu_map { MAX_CPUS }
import sync.idle { cpu_idle_begin, cpu_idle_cancel, cpu_idle_sleep }
import sync.mbox { MboxMsg, MBOX_FORWARD, MBOX_RETURN, mbox_msg, mbox_post, mbox_has_work, mbox_drain }
import arch.x86_64.apic { lapic_timer_start, lapic_timer_stop, lapic_tick_advance, lapic_watchdog_expired, lapic_local_tick_start, lapic_local_tick_stop }
import fs.syscall { fs_process_select }
import syscall.stack { kstack_top }
import proc.table { Proc, PROC_RUNNING, PROC_BSP_CPU, BLOCK_IRQ, proc_at, proc_state, proc_current_slot, proc_pick_next, proc_set_current, proc_wake, proc_runnable_on, proc_homed_count, proc_home, proc_set_on }
import proc.waitset { waitset_tick }
import mm.shm { shm_detach_expired, shm_detach_wake_due }

extern fn sched_switch(save_ksp: *u64, new_ksp: u64)
extern fn proc_first_entry()
extern fn kstack_set_current(top: u64)

# Timer interrupts a second: a process runs at most 10 ms before the next
# runnable one gets the CPU.
pub const SCHED_HZ: u64 = 100

# isr_stubs.s's InterruptFrame: 15 GPRs (r15 first), vector, error code,
# RIP, CS, RFLAGS, RSP, SS.
const FRAME_WORDS: u64 = 22
const FRAME_RDI: u64 = 9
const FRAME_RSI: u64 = 10
const FRAME_RDX: u64 = 11
const FRAME_RIP: u64 = 17
const FRAME_CS: u64 = 18
const FRAME_RFLAGS: u64 = 19
const FRAME_RSP: u64 = 20
const FRAME_SS: u64 = 21
# sched_switch's saved frame: RFLAGS, r15, r14, r13, r12, rbx, rbp, return.
const SWITCH_WORDS: u64 = 8
const SWITCH_RET: u64 = 7

const USER_CS: u64 = 0x23         # arch/x86_64/gdt.ritz GDT_USER_CODE (#4610)
const USER_SS: u64 = 0x1B         # arch/x86_64/gdt.ritz GDT_USER_DATA
const USER_RFLAGS: u64 = 0x202     # IF=1: the timer can preempt it
const KERNEL_RFLAGS: u64 = 0x2     # IF=0 until proc_first_entry's iretq

# sched_switch's frame, then the fake return address an entered function
# expects above it (the idle context's first switch).
const IDLE_FRAME_WORDS: u64 = 9

# One CPU's scheduler counters.
struct SchedCounts
    ticks: u64
    switches: u64
    # Switches that loaded another page table (CR3): the address-space
    # switches a CPL-3 driver and netd add per frame (AGAST #4768, the
    # latency gate).
    cr3_switches: u64
    preemptions: u64
    # Ticks that found two or more processes runnable: each one a tick the
    # scheduler should have preempted on, whichever mode it interrupted. The
    # boot gate's #4332 check compares preemptions with these, not with
    # every tick: a program running alone (waiting on a slow disk, say) adds
    # ticks that no scheduler could preempt on (AGAST #4832).
    contended: u64

# Each CPU's own, by CPU index (literal length: MAX_CPUS); the reports sum
# them (sched_totals).
var sched_counts: [64]SchedCounts
var sched_running: [64]bool
# The idle context's saved kernel RSP while a process runs, and whether
# sched_start has made it.
var sched_idle_ksp: [64]u64
var sched_idle_made: [64]bool
# A move this CPU's idle context finishes (sched_move): the slot plus one
# (0: none), and the CPU it goes to.
var sched_move_slot: [64]i32
var sched_move_to: [64]i32
# The moves each CPU sent: FORWARDs from an AP, RETURNs from the BSP.
var sched_moves_out: [64]u64

# Every CPU's counters, summed (a racy sum: each is its CPU's own).
fn sched_totals() -> SchedCounts
    var t: SchedCounts = SchedCounts { ticks: 0, switches: 0, cr3_switches: 0, preemptions: 0, contended: 0 }
    var c: i32 = 0
    while c < MAX_CPUS
        t.ticks = t.ticks + sched_counts[c].ticks
        t.switches = t.switches + sched_counts[c].switches
        t.cr3_switches = t.cr3_switches + sched_counts[c].cr3_switches
        t.preemptions = t.preemptions + sched_counts[c].preemptions
        t.contended = t.contended + sched_counts[c].contended
        c = c + 1
    t

# The process in `slot` runs on its own kernel stack from now on: TSS.rsp0
# and the syscall stack point at it. Only the switch and sched_start call
# this.
fn sched_use_kstack(slot: i32)
    let top: u64 = kstack_top(slot)
    gdt_set_kernel_stack_cpu(cpu_index(), top)
    kstack_set_current(top)

# Switch to the runnable process in `next`, or to this CPU's idle context
# (next < 0). IF=0. Returns when something switches back to the caller
# (never, for an exiting caller). From the idle context (current slot -1)
# its RSP is saved as the idle context's. Onto the idle context the page
# table, TSS.rsp0 and the syscall stack stay as they were: it runs in ring
# 0 only, and keeping CR3 means a process that wakes on this CPU again
# costs no CR3 load.
fn sched_switch_to(next: i32)
    let cpu: i32 = cpu_index()
    let prev: i32 = proc_current_slot()
    if next == prev
        return
    var save_at: *u64 = @sched_idle_ksp[cpu]
    if prev >= 0
        save_at = @(*proc_at(prev)).ksp
    if next < 0
        proc_set_current(-1)
        sched_switch(save_at, sched_idle_ksp[cpu])
        return
    let p: *Proc = proc_at(next)
    proc_set_current(next)
    if p.pml4 != vmm_get_current_pml4()
        vmm_switch_pml4(p.pml4)
        sched_counts[cpu].cr3_switches = sched_counts[cpu].cr3_switches + 1
    sched_use_kstack(next)
    fs_process_select(p.pid)
    sched_counts[cpu].switches = sched_counts[cpu].switches + 1
    sched_switch(save_at, p.ksp)

# The idle context's loop: the CPU-level sleep of SMP_USER.md §4, step for
# step as test/test_smp_proto.ritz models it. IF=0 throughout but for the
# hlt. Entered by the first switch onto the idle context; never returns.
fn sched_idle_main()
    let cpu: i32 = cpu_index()
    while true
        # The process that just left this CPU for another (sched_move).
        sched_finish_move(cpu)
        sched_ap_tick_update(cpu)
        # The detach timeout (#4729) for holders whose waits do not sweep:
        # those on an AP (driver.ritz wait_collect). No kernel path is
        # part-way through the PMM or a page table here.
        if cpu == PROC_BSP_CPU
            shm_detach_expired()
        # idle.announce: a locked xchg of this CPU's idle flag to 1.
        cpu_idle_begin()
        # idle.recheck: a runnable process, or a mailbox message, after the
        # announce. A waker's CAS before our re-check is seen here; one
        # after it reads the flag and kicks.
        let next: i32 = proc_pick_next()
        if next >= 0
            cpu_idle_cancel()
            sched_switch_to(next)
        else if mbox_has_work(cpu)
            cpu_idle_cancel()
            mbox_drain()
        else
            # idle.sleep: sti;hlt. A kick held pending since the announce
            # ends the hlt at once.
            cpu_idle_sleep()

# On the idle context, after the process in sched_move_slot left this CPU
# for sched_move_to: this CPU drops its address space, then publishes the
# move and posts it (SMP_USER.md §2 steps 1 and 3). The other CPU can pick
# it from the publish on; the post is its wake (posts always kick).
fn sched_finish_move(cpu: i32)
    let held: i32 = sched_move_slot[cpu]
    if held == 0
        return
    sched_move_slot[cpu] = 0
    let slot: i32 = held - 1
    let to: i32 = sched_move_to[cpu]
    let p: *Proc = proc_at(slot)
    # Its space leaves this CPU: only the CPU a process is on loads it (§3).
    if vmm_get_current_pml4() == p.pml4
        vmm_load_kernel_pml4()
    proc_set_on(slot, to)
    var kind: u32 = MBOX_RETURN
    if to == PROC_BSP_CPU
        kind = MBOX_FORWARD
    var msg: MboxMsg = mbox_msg(kind)
    msg.pid = p.pid
    sched_moves_out[cpu] = sched_moves_out[cpu] + 1
    mbox_post(to, msg)

# Carry the running process to CPU `to`: it switches onto this CPU's idle
# context, which publishes the move (sched_finish_move), and resumes here
# once `to` picks it. A no-op on `to` itself, with no process, or on a CPU
# with no idle context (nothing can finish the move: the process stays).
# Keeps IF as it was.
fn sched_move(to: i32)
    let was: bool = interrupts_enabled()
    disable_interrupts()
    let cpu: i32 = cpu_index()
    let me: i32 = proc_current_slot()
    if to != cpu and me >= 0 and sched_idle_made[cpu]
        sched_move_slot[cpu] = me + 1
        sched_move_to[cpu] = to
        sched_switch_to(-1)
    if was
        enable_interrupts()

# FORWARD: an AP's process goes to the BSP for a syscall that is not
# SYS_LOCAL, or to exit (SMP_USER.md §2). Returns on the BSP. A no-op there.
pub fn sched_forward()
    sched_move(PROC_BSP_CPU)

# RETURN: a forwarded syscall is done on the BSP, and its process goes back
# to its home. Returns on the home. A no-op for a process homed on the BSP.
pub fn sched_return_home()
    let me: i32 = proc_current_slot()
    if me >= 0
        sched_move(proc_home(me))

# The moves CPU `cpu` sent (FORWARDs from an AP, RETURNs from the BSP).
pub fn sched_moves_out_count(cpu: i32) -> u64
    if cpu < 0 or cpu >= MAX_CPUS
        return 0
    sched_moves_out[cpu]

# An AP leaves its boot idle loop (arch/x86_64/cpu_smp.ritz smp_ap_idle) for
# its idle context, and runs the processes homed on it from then on. The
# stack it left (IST1, or its bootstrap stack) is never returned to.
pub fn sched_ap_enter()
    disable_interrupts()
    let cpu: i32 = cpu_index()
    sched_make_idle(cpu)
    var left: u64 = 0
    sched_switch(@left, sched_idle_ksp[cpu])

# An AP's tick runs only while two or more live processes are homed on it,
# to preempt between them; a lone pinned process sees no timer interrupt
# (SMP_USER.md §4). The BSP's tick is sched_start's.
fn sched_ap_tick_update(cpu: i32)
    if cpu == PROC_BSP_CPU
        return
    let want: bool = proc_homed_count(cpu) >= 2
    if want and not sched_running[cpu]
        if lapic_local_tick_start()
            sched_running[cpu] = true
    else if not want and sched_running[cpu]
        lapic_local_tick_stop()
        sched_running[cpu] = false

# A safe point on the way back to user (the end of a syscall, a kick that
# interrupted CPL 3): the mailbox is drained, since no kernel code is half
# done here (SMP_USER.md §2 "Safe points"). A drain may have brought a
# process onto this CPU (a FORWARD or RETURN): it runs now, not at the next
# tick. On an AP the tick follows its homed count.
pub fn sched_user_safe_point()
    let cpu: i32 = cpu_index()
    if not mbox_has_work(cpu)
        return
    let was: bool = interrupts_enabled()
    disable_interrupts()
    mbox_drain()
    sched_ap_tick_update(cpu)
    let next: i32 = proc_pick_next()
    if next >= 0 and next != proc_current_slot()
        sched_switch_to(next)
    if was
        enable_interrupts()

# Make this CPU's idle context: a sched_switch frame at the top of its idle
# stack that "returns" into sched_idle_main with IF=0, as
# sched_prepare_user's does into proc_first_entry.
fn sched_make_idle(cpu: i32)
    if sched_idle_made[cpu]
        return
    let top: u64 = cpu_stack_top(cpu, CPU_IDLE)
    let sw: *u64 = (top - IDLE_FRAME_WORDS * 8) as *u64
    var i: u64 = 0
    while i < IDLE_FRAME_WORDS
        *(sw + i) = 0
        i = i + 1
    *sw = KERNEL_RFLAGS
    *(sw + SWITCH_RET) = sched_idle_main as u64
    sched_idle_ksp[cpu] = sw as u64
    sched_idle_made[cpu] = true

# init (the running process, slot `slot`) is about to enter ring 3: it runs
# on its own kernel stack, and the periodic tick starts. Idempotent: once
# the scheduler runs, a second call changes nothing (RING1_DRIVER.md §9:
# pid 1 may start it before run_init does).
pub fn sched_start(slot: i32)
    let cpu: i32 = cpu_index()
    if sched_running[cpu]
        return
    sched_make_idle(cpu)
    sched_use_kstack(slot)
    lapic_timer_start(SCHED_HZ)
    sched_running[cpu] = true

# The periodic tick drives preemption on this CPU: sched_start ran and
# sched_stop has not undone it.
pub fn sched_is_running() -> bool
    sched_running[cpu_index()]

# Undo sched_start: the periodic tick stops and sched_tick preempts nothing
# until sched_start runs again. The kernel stack stays the one sched_start
# chose. A no-op when the scheduler is not running.
pub fn sched_stop()
    let cpu: i32 = cpu_index()
    if not sched_running[cpu]
        return
    lapic_timer_stop()
    sched_running[cpu] = false

# Give the CPU to the next runnable process, if there is another; the
# caller stays runnable and continues when its turn comes round.
pub fn sched_yield()
    let was: bool = interrupts_enabled()
    disable_interrupts()
    let next: i32 = proc_pick_next()
    if next >= 0
        sched_switch_to(next)
    if was
        enable_interrupts()

# The caller has marked itself blocked (proc_block): run others until
# something makes it runnable again. With nothing runnable the CPU sleeps
# in sti;hlt; the IRQ that ends the wait (COM1's, the timer's) runs, and the
# loop looks again.
pub fn sched_block()
    let was: bool = interrupts_enabled()
    disable_interrupts()
    let cpu: i32 = cpu_index()
    let me: i32 = proc_current_slot()
    while proc_state(me) != PROC_RUNNING
        let next: i32 = proc_pick_next()
        if next >= 0
            sched_switch_to(next)
        else if sched_idle_made[cpu]
            sched_switch_to(-1)
        else
            # No idle context yet (a boot self-test before sched_start):
            # idle here, as before #4879.
            sti_hlt()
            disable_interrupts()
    if was
        enable_interrupts()

# The caller has exited (proc_exit_current: a zombie, or a free slot): it
# leaves for this CPU's idle context, which runs whatever is runnable.
# Never returns; nothing switches back to an exited process, and nothing
# runs on its stack again.
pub fn sched_exit()
    disable_interrupts()
    let cpu: i32 = cpu_index()
    if sched_idle_made[cpu]
        sched_switch_to(-1)
    # No idle context (an exit before sched_start ever ran): as before.
    while true
        let next: i32 = proc_pick_next()
        if next < 0
            sti_hlt()
            disable_interrupts()
        else
            sched_switch_to(next)

# The timer IRQ (vector 32), after its EOI. from_user: it interrupted a
# process (any non-zero CPL), the only place a process is preempted.
pub fn sched_tick(from_user: bool)
    let cpu: i32 = cpu_index()
    sched_counts[cpu].ticks = sched_counts[cpu].ticks + 1
    if sched_running[cpu] and proc_runnable_on(cpu) >= 2
        sched_counts[cpu].contended = sched_counts[cpu].contended + 1
    # The global duties are the BSP's, for every slot (SMP_USER.md §4); an
    # AP's tick only preempts between its homed processes.
    if cpu == PROC_BSP_CPU
        sched_tick_global(from_user)
    if not from_user or not sched_running[cpu]
        return
    let next: i32 = proc_pick_next()
    if next >= 0 and next != proc_current_slot()
        sched_counts[cpu].preemptions = sched_counts[cpu].preemptions + 1
        sched_switch_to(next)

# The BSP tick's duties for the whole machine.
fn sched_tick_global(from_user: bool)
    # The NVMe watchdog rides this tick instead of reprogramming the timer
    # (#4220): count the tick, and wake a parked driver wait when it expires.
    lapic_tick_advance()
    if lapic_watchdog_expired()
        proc_wake(BLOCK_IRQ)
    # A DrvIrqWait deadline lives on its process's wait set, not on that
    # watchdog (#4719): wake the set whose deadline has passed.
    waitset_tick(rdtsc())
    # SHM_DETACH_TIMEOUT_MS (#4729): a retired object's mapping its holder
    # has not detached is unmapped here, but only over CPL-3 code: a tick
    # over kernel code may have interrupted the PMM or a page-table edit,
    # neither reentrant, so it only wakes the parked holders, whose waits
    # sweep before they collect.
    if from_user
        shm_detach_expired()
    else
        shm_detach_wake_due()

# Build a new process's first frames on slot's kernel stack: its user frame
# (ring 3 at `entry`, RSP `user_rsp`, RDI/RSI/RDX = arg0/arg1/arg2, every
# other register 0) at the top, and below it a sched_switch frame that "returns"
# into proc_first_entry, which pops the user frame and irets. The first
# switch to the slot then enters the program.
pub fn sched_prepare_user(slot: i32, entry: u64, user_rsp: u64, arg0: u64, arg1: u64, arg2: u64)
    let top: u64 = kstack_top(slot)
    let frame: *u64 = (top - FRAME_WORDS * 8) as *u64
    var i: u64 = 0
    while i < FRAME_WORDS
        *(frame + i) = 0
        i = i + 1
    *(frame + FRAME_RDI) = arg0
    *(frame + FRAME_RSI) = arg1
    *(frame + FRAME_RDX) = arg2
    *(frame + FRAME_RIP) = entry
    *(frame + FRAME_CS) = USER_CS
    *(frame + FRAME_RFLAGS) = USER_RFLAGS
    *(frame + FRAME_RSP) = user_rsp
    *(frame + FRAME_SS) = USER_SS
    let sw: *u64 = (top - (FRAME_WORDS + SWITCH_WORDS) * 8) as *u64
    i = 0
    while i < SWITCH_WORDS
        *(sw + i) = 0
        i = i + 1
    *sw = KERNEL_RFLAGS
    *(sw + SWITCH_RET) = proc_first_entry as u64
    let p: *Proc = proc_at(slot)
    (*p).ksp = sw as u64

# How many times sched_tick has preempted a process for another (the
# driver-preempt boot test, #4713).
pub fn sched_preemption_count() -> u64
    sched_totals().preemptions

# How many process switches, and how many of them loaded another page
# table, since boot (the latency window's before/after, AGAST #4768).
pub fn sched_switch_count() -> u64
    sched_totals().switches

pub fn sched_cr3_switch_count() -> u64
    sched_totals().cr3_switches

# Report the scheduler's counters (init's exit).
pub fn sched_report()
    let t: SchedCounts = sched_totals()
    klog("[sched] ")
    klog_dec(t.ticks as i64)
    klog(" ticks, ")
    klog_dec(t.switches as i64)
    klog(" switches, ")
    klog_dec(t.preemptions as i64)
    klog(" preemptions, ")
    klog_dec(t.contended as i64)
    klog(" contended ticks\n")
