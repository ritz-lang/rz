# Harland serial console terminal (AGAST #4254)
#
# COM1 is the console: fds 0, 1 and 2 when they are not files. Received bytes
# go through the line discipline (tty/ldisc.ritz) from the IRQ 4 handler;
# read(0) sleeps until it has something; Ctrl-C kills the foreground
# process.
#
# Sleeping: read(0) disables interrupts, pulls whatever COM1's FIFO holds,
# and if nothing is readable blocks in the scheduler (BLOCK_TTY,
# proc/sched.ritz, #3629): other processes run meanwhile, or, with none
# runnable, the CPU sleeps in sti;hlt. COM1's RX interrupt (serial_enable_rx
# at boot) wakes the reader. Interrupts stay off from the check to the
# block, so input landing in between still wakes it.
#
# Ctrl-C (TTY_ISIG) kills the running Proc if it is in the console's
# foreground (tty/fg.ritz, #4276: set by the shell, as tcsetpgrp does). With
# preemption (#3629) the running Proc is whichever process holds the CPU when
# the Ctrl-C lands. It exits with status 130 (128 + SIGINT, as a shell reports it)
# and its parent resumes. A Ctrl-C for a process outside the foreground
# (init always; rzsh between its tty_setattr and spawn) only drops the line.
# The kill happens
#   * in the IRQ 4 handler, when the interrupt came from a process (any
#     non-zero CPL: a program computing in a loop), after its EOI;
#   * at the end of the syscall it interrupted (syscall_handler calls
#     tty_console_check_intr), e.g. a program printing in a loop;
#   * in read(0), which the interrupt wakes.

import io { disable_interrupts, enable_interrupts }
import serial { serial_data_available, serial_read_byte_nonblock, serial_write_byte }
import tty.fg { tty_fg_is_current, tty_fg_set }
import proc.table { BLOCK_TTY, proc_block, proc_wake }
import proc.sched { sched_block }
import syscall.runtime.process { process_kill_current }
import tty.ldisc { ldisc_input, ldisc_readable, ldisc_read, ldisc_take_intr, ldisc_intr_pending, ldisc_take_echo, ldisc_get_flags, ldisc_set_flags }

# A process killed by Ctrl-C exits with this status.
pub const TTY_INTR_STATUS: i32 = 130

var g_console_echo: [64]u8

# Send the echo the line discipline queued, straight to COM1: this runs in
# the IRQ handler, which must not touch the TX ring a syscall it interrupted
# may be filling.
fn tty_console_send_echo()
    var n: i64 = ldisc_take_echo(@g_console_echo[0], 64)
    while n > 0
        var i: i64 = 0
        while i < n
            serial_write_byte(g_console_echo[i])
            i = i + 1
        n = ldisc_take_echo(@g_console_echo[0], 64)

# Move every byte COM1 holds through the line discipline. Interrupts off.
fn tty_console_pull()
    while serial_data_available()
        let c: i32 = serial_read_byte_nonblock()
        if c < 0
            return
        ldisc_input(c as u8)
    tty_console_send_echo()

# A Ctrl-C is waiting and the running process is in the foreground to take
# it. A Ctrl-C for anyone else is dropped here (the line already was).
fn tty_console_intr_due() -> bool
    if not ldisc_intr_pending()
        return false
    if not tty_fg_is_current()
        ldisc_take_intr()
        return false
    true

# Kill the foreground process for a Ctrl-C. Never returns.
fn tty_console_kill_foreground()
    ldisc_take_intr()
    process_kill_current(TTY_INTR_STATUS)

# The IRQ 4 handler's receive half. from_user: the interrupt came from a
# process (any non-zero CPL). Returns true if the caller must send its EOI
# and call tty_console_irq_kill: a process to kill for a Ctrl-C.
pub fn tty_console_irq(from_user: bool) -> bool
    tty_console_pull()
    # A reader blocked in read(0) looks again (a line, a byte, ^D or ^C).
    proc_wake(BLOCK_TTY)
    from_user and tty_console_intr_due()

pub fn tty_console_irq_kill()
    tty_console_kill_foreground()

# At the end of every syscall: deliver a Ctrl-C that arrived during it.
pub fn tty_console_check_intr()
    if ldisc_intr_pending()
        disable_interrupts()
        let due: bool = tty_console_intr_due()
        enable_interrupts()
        if due
            tty_console_kill_foreground()

# read(0): sleep until the line discipline has a line (canonical) or a byte
# (raw), or input ended (0), then copy up to count bytes into buf.
pub fn tty_console_read(buf: *u8, count: i64) -> i64
    if count <= 0
        return 0
    var n: i64 = -1
    while n < 0
        disable_interrupts()
        tty_console_pull()
        if tty_console_intr_due()
            enable_interrupts()
            tty_console_kill_foreground()
        if ldisc_readable()
            n = ldisc_read(buf, count)
            enable_interrupts()
        else
            # Until COM1's interrupt wakes it; returns with IF=0.
            proc_block(BLOCK_TTY, 0)
            sched_block()
    n

pub fn tty_console_get_flags() -> u32
    disable_interrupts()
    let f: u32 = ldisc_get_flags()
    enable_interrupts()
    f

pub fn tty_console_set_flags(flags: u32)
    disable_interrupts()
    ldisc_set_flags(flags)
    enable_interrupts()

# tty_setfg: TTY_FG_NONE, TTY_FG_CHILDREN, or TTY_FG_PID and a pid
# (tty/fg.ritz). 0, or Errno.Inval.
pub fn tty_console_set_fg(mode: u64, pid: u64) -> i32
    disable_interrupts()
    let r: i32 = tty_fg_set(mode, pid)
    enable_interrupts()
    r
