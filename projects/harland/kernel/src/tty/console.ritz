# Harland serial console terminal (AGAST #4254)
#
# COM1 is the console: fds 0, 1 and 2 when they are not files. Output and
# echo also go to the framebuffer console (drivers/display/fbcon.ritz,
# AGAST #4868); on a machine with no COM1 (serial.ritz's probe) that is
# the only one, and reads find no COM1 input. Received bytes (COM1's IRQ 4,
# the PS/2 keyboard's IRQ 1, a USB keyboard's xHCI interrupt and its
# repeat on the BSP tick) go through tty_console_input into the line
# discipline (tty/ldisc.ritz); read(0) sleeps until it has something;
# Ctrl-C kills the foreground process.
#
# Sleeping: read(0) disables interrupts, pulls whatever COM1's FIFO holds,
# and if nothing is readable blocks in the scheduler (BLOCK_TTY,
# proc/sched.ritz, #3629): other processes run meanwhile, or, with none
# runnable, the CPU sleeps in sti;hlt. COM1's RX interrupt (serial_enable_rx
# at boot) wakes the reader. Interrupts stay off from the check to the
# block, so input landing in between still wakes it.
#
# poll(2) on fd 0 (syscall/runtime/poll.ritz, #4829) asks tty_console_readable
# whether read(0) would return now, and to wait for that with a timeout
# parks in tty_console_wait on its own wait set (proc/waitset.ritz), with a
# TSC deadline and a console watch: COM1's interrupt wakes it as it wakes a
# reader, and sched_tick's waitset_tick at the deadline. The wait is
# monotonic (the TSC), so no wall clock is involved, and it is as fine as
# the 100 Hz tick: a 25 ms timeout ends 25 to 35 ms after the call.
#
# Ctrl-C (TTY_ISIG) kills the running Proc if it is in the console's
# foreground (tty/fg.ritz, #4276: set by the shell, as tcsetpgrp does). With
# preemption (#3629) the running Proc is whichever process holds the CPU when
# the Ctrl-C lands. It exits with status 130 (128 + SIGINT, as a shell reports it)
# and its parent resumes. A Ctrl-C for a process outside the foreground
# (init always; rzsh between its tty_setattr and spawn) only drops the line.
# The kill happens
#   * in the IRQ 4 handler, when the interrupt came from a process (any
#     non-zero CPL: a program computing in a loop), after its EOI;
#   * at the end of the syscall it interrupted (syscall_handler calls
#     tty_console_check_intr), e.g. a program printing in a loop;
#   * in read(0), which the interrupt wakes.

import io { disable_interrupts, enable_interrupts }
import serial { serial_data_available, serial_read_byte_nonblock, serial_out_byte }
import drivers.display.fbcon { fbcon_write }
import ritzlib.strview { StrView }
import tty.fg { tty_fg_is_current }
import tty.restore { tty_restore_set_attrs, tty_restore_set_fg }
import ritzlib.option
import ritzlib.result { Result }
import syscall.errno { Errno }
import proc.table { BLOCK_TTY, BLOCK_WAIT, proc_block, proc_wake, proc_current, proc_current_slot, proc_reap_pending }
import proc.waitset { waitset_arm, waitset_disarm, waitset_watch_console, waitset_console_ready }
import proc.waitq { waitq_can_park }
import arch.x86_64.tsc { deadline_passed }
import proc.sched { sched_block }
import syscall.runtime.process { process_kill_current }
import tty.ldisc { ldisc_input, ldisc_readable, ldisc_read, ldisc_take_intr, ldisc_intr_pending, ldisc_take_echo, ldisc_get_flags, ldisc_overruns }

# A process killed by Ctrl-C exits with this status.
pub const TTY_INTR_STATUS: i32 = 130

var g_console_echo: [64]u8

# Send the echo the line discipline queued, straight to COM1: this runs in
# the IRQ handler, which must not touch the TX ring a syscall it interrupted
# may be filling. The framebuffer console shows it too (AGAST #4868).
fn tty_console_send_echo()
    var n: i64 = ldisc_take_echo(@g_console_echo[0], 64)
    while n > 0
        var i: i64 = 0
        while i < n
            serial_out_byte(g_console_echo[i])
            i = i + 1
        fbcon_write(StrView { ptr: @g_console_echo[0], len: n })
        n = ldisc_take_echo(@g_console_echo[0], 64)

# Console input from any keyboard (AGAST #4888, docs/USB.md "Data path"):
# COM1's receive half (tty_console_pull), the PS/2 keyboard's IRQ 1 and the
# USB HID keyboard (drivers/usb/hid_kbd.ritz) all hand their bytes here, so
# echo, wake and Ctrl-C do not depend on where a byte came from. Each byte
# goes through the line discipline, its echo goes to COM1 and the
# framebuffer, then a reader blocked in read(0) and a timed poll watching
# the console look again. Interrupts off, on the CPU that took the input.
# from_user: the interrupt came from a process (any non-zero CPL). Returns
# true if the caller must send its EOI and call tty_console_irq_kill: a
# process to kill for a Ctrl-C.
pub fn tty_console_input(bytes: StrView, from_user: bool) -> bool
    for i in 0..bytes.len
        ldisc_input(bytes.get(i))
    tty_console_send_echo()
    proc_wake(BLOCK_TTY)
    waitset_console_ready()
    from_user and tty_console_intr_due()

var g_console_rx: [64]u8

# Move every byte COM1 holds through tty_console_input, a FIFO's worth at a
# time. Interrupts off. Returns tty_console_input's answer: a Ctrl-C for
# the process `from_user` says was interrupted.
fn tty_console_pull(from_user: bool) -> bool
    var kill: bool = false
    var more: bool = true
    while more
        var n: i64 = 0
        while n < 64 and serial_data_available()
            let c: i32 = serial_read_byte_nonblock()
            if c < 0
                more = false
                break
            g_console_rx[n] = c as u8
            n = n + 1
        if n == 0
            return kill
        if n < 64
            more = false
        if tty_console_input(StrView { ptr: @g_console_rx[0], len: n }, from_user)
            kill = true
    kill

# A Ctrl-C is waiting and the running process is in the foreground to take
# it. A Ctrl-C for anyone else is dropped here (the line already was).
fn tty_console_intr_due() -> bool
    if not ldisc_intr_pending()
        return false
    if not tty_fg_is_current()
        ldisc_take_intr()
        return false
    true

# Kill the foreground process for a Ctrl-C. Never returns.
fn tty_console_kill_foreground()
    ldisc_take_intr()
    process_kill_current(TTY_INTR_STATUS)

# The IRQ 4 handler's receive half: COM1's bytes into tty_console_input.
# from_user: the interrupt came from a
# process (any non-zero CPL). Returns true if the caller must send its EOI
# and call tty_console_irq_kill: a process to kill for a Ctrl-C.
pub fn tty_console_irq(from_user: bool) -> bool
    tty_console_pull(from_user)

pub fn tty_console_irq_kill()
    tty_console_kill_foreground()

# At the end of every syscall: deliver a Ctrl-C that arrived during it.
pub fn tty_console_check_intr()
    if ldisc_intr_pending()
        disable_interrupts()
        let due: bool = tty_console_intr_due()
        enable_interrupts()
        if due
            tty_console_kill_foreground()

# read(0): sleep until the line discipline has a line (canonical) or a byte
# (raw), or input ended (0), then copy up to count bytes into buf.
pub fn tty_console_read(buf: *u8, count: i64) -> i64
    if count <= 0
        return 0
    var n: i64 = -1
    while n < 0
        disable_interrupts()
        tty_console_pull(false)
        if tty_console_intr_due()
            enable_interrupts()
            tty_console_kill_foreground()
        if ldisc_readable()
            n = ldisc_read(buf, count)
            enable_interrupts()
        else
            # Until COM1's interrupt wakes it; returns with IF=0.
            proc_block(BLOCK_TTY, 0)
            sched_block()
    n

# Whether read(0) would return now (a line, a raw byte or an end of input),
# after pulling what COM1 holds. A Ctrl-C for the foreground kills it, as in
# read(0).
pub fn tty_console_readable() -> bool
    disable_interrupts()
    tty_console_pull(false)
    if tty_console_intr_due()
        enable_interrupts()
        tty_console_kill_foreground()
    let ready: bool = ldisc_readable()
    enable_interrupts()
    ready

# A timed poll's wait (#4829): sleep on the caller's wait set until TSC
# `deadline` passes (None: no deadline), or, with `for_input`, until read(0)
# would return. Console input wakes it either way, so a Ctrl-C for the
# foreground still kills it. Returns tty_console_readable's answer as the
# wait ended. A process marked to exit stops waiting (its return to user
# exits), and a CPU that cannot park (not the BSP, no process) does not wait.
pub fn tty_console_wait(for_input: bool, deadline: Option<u64>) -> bool
    disable_interrupts()
    let slot: i32 = proc_current_slot()
    var ready: bool = false
    while true
        tty_console_pull(false)
        if tty_console_intr_due()
            waitset_disarm(slot)
            enable_interrupts()
            tty_console_kill_foreground()
        ready = ldisc_readable()
        if (for_input and ready) or not waitq_can_park() or proc_reap_pending(proc_current())
            break
        match deadline
            Some(t) =>
                if deadline_passed(t)
                    break
                waitset_arm(slot, t)
            None => pass
        waitset_watch_console(slot)
        # Until COM1's interrupt or the deadline wakes it; returns with IF=0.
        proc_block(BLOCK_WAIT, 0)
        sched_block()
    if slot >= 0
        waitset_disarm(slot)
    enable_interrupts()
    ready

pub fn tty_console_get_flags() -> u32
    disable_interrupts()
    let f: u32 = ldisc_get_flags()
    enable_interrupts()
    f

# Input bytes dropped with the line discipline's queue full, since boot
# (#4831): tty_getattr's TtyAttrs.overruns.
pub fn tty_console_overruns() -> u32
    disable_interrupts()
    let n: u32 = ldisc_overruns()
    enable_interrupts()
    n

# tty_setattr. The flags it replaced are saved for the caller's death
# (tty/restore.ritz, #4958).
pub fn tty_console_set_flags(flags: u32)
    disable_interrupts()
    tty_restore_set_attrs(flags)
    enable_interrupts()

# tty_setfg: TTY_FG_NONE, TTY_FG_CHILDREN, or TTY_FG_PID and a pid
# (tty/fg.ritz); Errno.Inval otherwise. The foreground it replaced is saved for
# the caller's death (tty/restore.ritz, #4958).
pub fn tty_console_set_fg(mode: u64, pid: u64) -> Result<(), Errno>
    disable_interrupts()
    let r: Result<(), Errno> = tty_restore_set_fg(mode, pid)
    enable_interrupts()
    r
