# Kernel filesystem: goliath, bound to the kernel (AGAST #1881)
#
# The kernel's filesystem is goliath itself, the same code goliath's Linux
# tests run, not a fork of it (the kpath / kdir_entry / knamespace / kblob
# forks and a copy of cryptosec's SHA-256 lived here until #1881). This
# module only binds it to the kernel:
#
#   * memory: a goliath Allocator over the kernel heap (kalloc / kfree)
#   * disk:   a goliath BlockDevice over a virtio-blk device; the namespace
#             is restored from it at boot and saved with kfs_save, in
#             goliath's one on-disk image format (goliath.block_store)
#   * errors: goliath's ErrorCodes become Errno values for the syscall layer
#
# One global namespace (kfs_get). Calls take the *Namespace so callers read
# like the goliath API they wrap.

import klog { klog, klog_dec }
import serial { StrView }
import arch.x86_64.tsc { time_ns }
import mm.heap { kalloc, kfree }
import drivers.virtio.blk { VirtioBlkDevice, virtio_blk_read, virtio_blk_write }
import syscall.errno { Errno }
import ritzlib.span { Span, span_from_ptr }
import ritzlib.fmt.digits { fmt_u64_into }
import ritzlib.memory { Allocator }
import goliath.blob_store { MemoryBlobStore, memory_store_new_in, memory_store_count }
import goliath.namespace { Namespace, namespace_new, namespace_exists, namespace_read, namespace_write, namespace_mkdir, namespace_list }
import goliath.block_store { BlockDevice, block_store_save, block_store_load }
import goliath.dir_entry { DirEntry }
import goliath.error { ErrorCode }

pub const KFS_OK: i32 = 0

# ============================================================================
# Allocator and block device
# ============================================================================

fn kfs_alloc(ctx: *u8, len: i64) -> *u8
    kalloc(len as u64)

fn kfs_free(ctx: *u8, p: *u8, len: i64) -> i32
    kfree(p)

fn kfs_allocator() -> Allocator
    Allocator { ctx: null, alloc: kfs_alloc, free: kfs_free }

fn kfs_dev_read(dev: *u8, lba: u64, count: u32, buf: *u8) -> i32
    virtio_blk_read(dev as *VirtioBlkDevice, lba, count, buf)

fn kfs_dev_write(dev: *u8, lba: u64, count: u32, buf: *u8) -> i32
    virtio_blk_write(dev as *VirtioBlkDevice, lba, count, buf)

# ============================================================================
# Errors
# ============================================================================

# A goliath ErrorCode as the Errno a syscall returns (`as i32`; 0 for Ok)
pub fn kfs_errno(code: ErrorCode) -> i32
    if code == ErrorCode.Ok
        return KFS_OK
    if code == ErrorCode.NotFound
        return Errno.NoEnt as i32
    if code == ErrorCode.AlreadyExists
        return Errno.Exist as i32
    if code == ErrorCode.InvalidPath
        return Errno.Inval as i32
    if code == ErrorCode.OutOfSpace
        return Errno.NoSpc as i32
    if code == ErrorCode.NotADirectory
        return Errno.NotDir as i32
    if code == ErrorCode.NotAFile
        return Errno.IsDir as i32
    if code == ErrorCode.DirectoryNotEmpty
        return Errno.NotEmpty as i32
    if code == ErrorCode.PermissionDenied
        return Errno.Perm as i32
    if code == ErrorCode.PathTooLong
        return Errno.NameTooLong as i32
    Errno.Io as i32

# ============================================================================
# The global namespace
# ============================================================================

var g_kfs_store: MemoryBlobStore
var g_kfs_ns: Namespace
# The persistent subtree. What userspace writes at or below /var lives here
# and is what kfs_save writes to the storage device; the initramfs root above
# it never is, so the image can't grow by the initramfs (AGAST #4321).
var g_kfs_pstore: MemoryBlobStore
var g_kfs_pns: Namespace
var g_kfs_dev: BlockDevice
var g_kfs_has_dev: bool = false
var g_kfs_initialized: bool = false
# When kfs_save last ran (time_ns; 0 = never) and whether a debounced save
# was skipped since (fs_sync/power-off clear it).
var g_kfs_last_save_ns: u64 = 0
var g_kfs_save_pending: bool = false

# Start the kernel namespace. The storage device holds the persistent /var
# subtree's goliath image (what the last boot saved); a blank device starts
# it empty. The runtime tree starts empty and the initramfs loads into it, so
# the image holds what was written, not the initramfs. 0, or -1 if the root
# directory can't be allocated. A device whose image is damaged or unreadable
# is logged and not used, so a save can't replace what may still be
# recoverable.
pub fn kfs_init(storage: *VirtioBlkDevice) -> i32
    if g_kfs_initialized
        return 0
    g_kfs_store = memory_store_new_in(kfs_allocator())
    g_kfs_pstore = memory_store_new_in(kfs_allocator())
    g_kfs_ns = namespace_new(@g_kfs_store)
    g_kfs_pns = namespace_new(@g_kfs_pstore)
    if storage != 0 as *VirtioBlkDevice
        g_kfs_dev = BlockDevice { dev: storage as *u8, sectors: (*storage).capacity, read: kfs_dev_read, write: kfs_dev_write }
        let rc: ErrorCode = block_store_load(@g_kfs_dev, @g_kfs_pstore, @g_kfs_pns)
        if rc == ErrorCode.Ok
            g_kfs_has_dev = true
        else if rc == ErrorCode.NotFound
            g_kfs_has_dev = true
        else
            klog("kfs: storage image unreadable (goliath error " as StrView)
            klog_dec(rc as i64)
            klog("); not using it\n" as StrView)
            # A failed load may have stored part of the image
            g_kfs_pstore = memory_store_new_in(kfs_allocator())
            g_kfs_pns = namespace_new(@g_kfs_pstore)
    g_kfs_initialized = true
    if namespace_exists(@g_kfs_ns, "/") == false
        return -1
    0

# The kernel namespace (null before kfs_init): the runtime tree the initramfs
# loads into.
pub fn kfs_get() -> *Namespace
    if not g_kfs_initialized
        return 0 as *Namespace
    @g_kfs_ns

# The namespace that persists: its root is /var's contents.
pub fn kfs_persist_get() -> *Namespace
    if not g_kfs_initialized
        return 0 as *Namespace
    @g_kfs_pns

# Whether the namespace has a storage device to save to
pub fn kfs_has_storage() -> bool
    g_kfs_initialized and g_kfs_has_dev

# Blobs the runtime namespace holds
pub fn kfs_blob_count() -> i32
    memory_store_count(@g_kfs_store)

# Save the persistent subtree to the storage device: 0, or an Errno (NoDev
# without one). A save cut short leaves the previous image loadable.
pub fn kfs_save() -> i32
    if not kfs_has_storage()
        return Errno.NoDev as i32
    let rc: i32 = kfs_errno(block_store_save(@g_kfs_dev, @g_kfs_pns))
    # A failing disk is not retried harder either: the next save is still a
    # debounce interval away.
    g_kfs_last_save_ns = time_ns()
    if rc == KFS_OK
        g_kfs_save_pending = false
    rc

# How long a save on close is deferred after the last one: a burst of
# writes then costs one disk image, not one per file.
const SAVE_DEBOUNCE_NS: u64 = 200000000

# Save the persistent subtree, at most once per SAVE_DEBOUNCE_NS. The
# syscalls call this when a written /var file closes, so a program that
# writes a hundred files in one go saves once and the next write past the
# window saves again. A deferred save is not lost: kfs_save (the Sync
# syscall) and the power-off path both save unconditionally. 0, or an Errno
# (NoDev without storage).
pub fn kfs_save_later() -> i32
    if not kfs_has_storage()
        return Errno.NoDev as i32
    let now: u64 = time_ns()
    if g_kfs_last_save_ns != 0 and now - g_kfs_last_save_ns < SAVE_DEBOUNCE_NS
        g_kfs_save_pending = true
        return KFS_OK
    kfs_save()

# Whether a debounced save is owed to the storage device
pub fn kfs_save_pending() -> bool
    g_kfs_save_pending

# ============================================================================
# The persistent subtree (/var)
# ============================================================================

# Length of the "/var" prefix `path` starts with (0 if it doesn't): 4 for
# "/var" exactly and for "/var/...".
fn kfs_persist_prefix(path: StrView) -> i64
    if path.len < 4
        return 0
    if *(path.ptr) != 47 or *(path.ptr + 1) != 118 or *(path.ptr + 2) != 97 or *(path.ptr + 3) != 114
        return 0
    if path.len == 4 or *(path.ptr + 4) == 47
        return 4
    0

# Whether `path` is part of the persistent subtree (at or below /var)
pub fn kfs_is_persist(path: StrView) -> bool
    kfs_persist_prefix(path) != 0

# The namespace a path lives in: the persistent /var subtree for /var and
# below, else the runtime tree.
pub fn kfs_ns_for(path: StrView) -> *Namespace
    if kfs_is_persist(path) and g_kfs_initialized
        return @g_kfs_pns
    kfs_get()

# `path` within kfs_ns_for's namespace: "/var/x" is "/x" in the subtree.
pub fn kfs_local(path: StrView) -> StrView
    let n: i64 = kfs_persist_prefix(path)
    if n == 0
        return path
    if path.len == n
        return StrView { ptr: c"/", len: 1 }
    StrView { ptr: path.ptr + n, len: path.len - n }

# ============================================================================
# Namespace calls with kernel-shaped results
# ============================================================================

# A file's bytes (null if `path` isn't stored), its size in *out_size. The
# pointer is the blob's: valid until the file is rewritten or deleted.
pub fn kfs_read(ns: *Namespace, path: StrView, out_size: *u64) -> *u8
    let data: Span<u8> = namespace_read(ns, path)
    *out_size = data.len as u64
    data.ptr

# Write (create or replace) a file: 0 or an Errno
pub fn kfs_write(ns: *Namespace, path: StrView, data: *u8, size: u64) -> i32
    let bytes: Span<u8> = span_from_ptr<u8>(data, size as i64)
    kfs_errno(namespace_write(ns, path, @bytes))

# Create a directory: 0 or an Errno (Exist if it is already there)
pub fn kfs_mkdir(ns: *Namespace, path: StrView) -> i32
    kfs_errno(namespace_mkdir(ns, path))

# Copy up to `max_entries` of directory `path`'s entries: its entry count, or
# Errno.NoEnt / Errno.NotDir.
pub fn kfs_list(ns: *Namespace, path: StrView, entries: *DirEntry, max_entries: i32) -> i32
    let count: i32 = namespace_list(ns, path, entries, max_entries)
    if count >= 0
        return count
    if namespace_exists(ns, path)
        return Errno.NotDir as i32
    Errno.NoEnt as i32

# ============================================================================
# User writes: the runtime tree and, under /var, the persistent subtree
# ============================================================================
#
# Userspace sees one tree: the initramfs root with /var on the storage device.
# A write below /var goes to both -- the runtime copy serves readdir of "/",
# the persistent copy is what the next boot loads -- and anywhere else only to
# the runtime tree, which is RAM and gone at reboot.

# Write `path` as the running system sees it: the runtime tree, plus the
# persistent subtree for /var and below. 0 or an Errno.
pub fn kfs_persist_write(path: StrView, data: *u8, size: u64) -> i32
    let rc: i32 = kfs_write(kfs_get(), path, data, size)
    if rc != KFS_OK or not kfs_is_persist(path)
        return rc
    kfs_write(@g_kfs_pns, kfs_local(path), data, size)

# mkdir `path` as the running system sees it: the runtime tree, plus the
# persistent subtree for /var and below (Exist is fine in either). 0 or an
# Errno.
pub fn kfs_persist_mkdir(path: StrView) -> i32
    let rc: i32 = kfs_mkdir(kfs_get(), path)
    if rc != KFS_OK and rc != Errno.Exist as i32
        return rc
    if not kfs_is_persist(path)
        return KFS_OK
    let prc: i32 = kfs_mkdir(@g_kfs_pns, kfs_local(path))
    if prc == Errno.Exist as i32
        return KFS_OK
    prc

# ============================================================================
# Boot record
# ============================================================================

# Count this boot in /var/boots (a decimal number) and save the persistent
# subtree to the storage device, so each boot's count is one more than the
# last boot's when the image survived the reboot. The boot gate checks exactly
# that (tools/test_tier1_boot.sh). The count, or an Errno.
pub fn kfs_record_boot() -> i64
    let ns: *Namespace = kfs_get()
    if ns == 0 as *Namespace
        return Errno.NoDev as i64
    let pns: *Namespace = kfs_persist_get()
    let rc: i32 = kfs_persist_mkdir(StrView { ptr: c"/var", len: 4 })
    if rc != KFS_OK
        return rc as i64
    # The count is the persistent subtree's, not the runtime tree's: the
    # initramfs has not loaded yet, so the runtime tree is empty here and
    # reading it would restart at 1 every boot.
    var size: u64 = 0
    let old: *u8 = kfs_read(pns, StrView { ptr: c"/boots", len: 6 }, @size)
    var boots: u64 = 0
    var i: u64 = 0
    while i < size and old != 0 as *u8
        let c: u8 = *(old + i)
        if c < 48 or c > 57
            break
        boots = boots * 10 + (c - 48) as u64
        i = i + 1
    boots = boots + 1

    # Decimal digits, most significant first (ritzlib.fmt.digits, #1885)
    var digits: [20]u8
    let n: i64 = fmt_u64_into(@digits[0], boots)
    let boot_path: StrView = StrView { ptr: c"/var/boots", len: 10 }
    let wrc: i32 = kfs_persist_write(boot_path, @digits[0], n as u64)
    if wrc != KFS_OK
        return wrc as i64
    let src: i32 = kfs_save()
    if src != KFS_OK
        return src as i64
    boots as i64
