# Harland Kernel Filesystem Module
#
# Re-exports filesystem components. The namespace itself is goliath, bound
# to the kernel by kfs (AGAST #1881).

pub import kfs { KFS_OK, kfs_init, kfs_get, kfs_has_storage, kfs_save, kfs_read, kfs_write, kfs_mkdir, kfs_list, kfs_errno, kfs_record_boot, kfs_blob_count }
pub import vfs { vfs_init, vfs_mount, vfs_unmount, vfs_stat, vfs_mkdir, FsOps, Stat, Dirent, O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND, S_IFREG, S_IFDIR }
pub import fd { FdTable, FileDescriptor, fd_table_init, fd_alloc, fd_free, fd_get, fd_dup, fd_owner, fd_refs, fd_heir, MAX_FDS }
pub import syscall { fs_syscall_init, sys_open, sys_close, sys_fs_read, sys_fs_write, sys_lseek, sys_mkdir, is_fs_fd, fs_process_start, fs_process_end, SEEK_SET, SEEK_CUR, SEEK_END }
pub import initramfs { initramfs_load }
