# Filesystem Syscalls
#
# Implements sys_open, sys_close, sys_read, sys_write, sys_fstat, mkdir,
# unlink and rmdir for files (stat by path is fs/stat.ritz stat_at),
# sys_getdents64 for directory fds (open with O_DIRECTORY; the records are
# fs/dirent.ritz's, AGAST #4947), and binds pipe ends (fs/pipe.ritz,
# AGAST #4955) to fds: pipe(2)'s two, and a spawned child's 0-2.
# Integrates with the kernel namespace (fs/kfs.ritz) and the per-process fd tables (fs/fd.ritz).

import klog { klog }
import serial { StrView }
import fs.vfs { O_WRONLY, O_RDWR, O_CREAT, O_EXCL, O_TRUNC, O_APPEND, O_SYNC, O_DIRECTORY }
import fs.fd { FdTable, FileDescriptor, MAX_FDS, FD_KIND_PIPE, FD_KIND_STDIO, fd_table_init, fd_alloc, fd_free, fd_dup, fd_get, fd_owner, fd_refs, fd_heir }
import fs.pipe { PipeEnd, PipeSide, pipe_create, pipe_reader, pipe_writer, pipe_hold, pipe_release, pipe_read, pipe_write }
import ritzlib.span { Span }
import syscall.errno { Errno }
import fs.kfs { KFS_OK, kfs_get, kfs_ns_for, kfs_local, kfs_is_persist, kfs_is_durable, kfs_persist_write, kfs_persist_create, kfs_persist_mkdir, kfs_unlink, kfs_rmdir, kfs_commit_durable, kfs_save, kfs_save_later }
import fs.open_plan { WriteMode, OpenPlan, open_plan }
import fs.stat { Stat, stat_of_entry, stat_console, stat_pipe }
import fs.dirent { dirent_fill }
import goliath.namespace { Namespace, NsStat, namespace_resolve, namespace_store, namespace_hold, namespace_unhold, namespace_stat }
import ritzlib.result
import ritzlib.option
import ritzlib.span { Span, span_from_ptr }
import goliath.blob_id { BlobId, blob_id_is_zero, blob_id_copy }
import goliath.blob_store { MemoryBlobStore, memory_store_get, memory_store_get_size }
import mm.heap { kalloc, kfree }

# Syscall numbers are `enum Syscall` in syscall/numbers.ritz; main.ritz
# registers this module's handlers in the dispatch table (syscall/dispatch.ritz).

# ============================================================================
# Per-process file state (AGAST #2753)
# ============================================================================
#
# Each process has an FsProc: its own FdTable (fds 3..255) and, per fd, the
# open file's blob, position and pending writes. The process layer
# (syscall/runtime/process.ritz) brackets every process's life:
# fs_process_start(pid) when it starts running (run_init for init, spawn for
# a child) makes a fresh FsProc current; fs_process_end() when it exits
# closes every fd it left open (flushing writes as sys_close does), frees the
# FsProc and makes the parent's current again. With several processes
# runnable (#3629), proc/sched.ritz calls fs_process_select(pid) on every
# switch. So the fs layer never asks who is running, and imports nothing from
# the process layer.
#
# An FsProc is ~36 KB and comes from the kernel heap only while its process
# lives, so the BSS holds just the FS_MAX_PROCS pointers. Read its fields as
# `p.field`: ritz0 lowers `(*p).field` by loading the whole FsProc first.

# One open file.
struct FsFile
    ns: *Namespace         # The namespace holding the blob (persistent under /var)
    blob_id: BlobId         # The blob this fd refers to, held while it is open
    data_ptr: *u8           # The blob's bytes (the hold keeps them alive)
    size: u64               # File size
    position: u64           # Current read/write position
    flags: i32              # Open flags
    wbuf: *u8               # Pending writes, flushed on close (null if none)
    wbuf_size: u64
    wbuf_cap: u64
    path: *u8               # Heap copy of the path, for writable fds (null if none)
    path_len: u64
    meta: NsStat            # The entry as it was at open: what fstat reports
    create: WriteMode       # Set(mode): the open deferred its create to the close
    dir: bool               # An O_DIRECTORY fd: blob_id is the directory's,
                            # position the index of the next entry getdents64 lists

struct FsProc
    pid: u64
    parent: i32             # fs_procs index of the spawning process; -1 for none
    mmap_next: u64          # next kernel-chosen mmap address; 0 = region start (#3530)
    table: FdTable
    files: [256]FsFile      # indexed by fd; meaningful while the fd is an open file
    pipe_ends: [256]PipeEnd # indexed by fd; meaningful while the fd is FD_KIND_PIPE

# Live processes at once: proc/table.ritz's MAX_PROCS.
pub const FS_MAX_PROCS: i32 = 32

var fs_procs: [FS_MAX_PROCS]*FsProc
# Each CPU's current FsProc's index plus one, by CPU index (AGAST #4879,
# docs/SMP_USER.md §2: the current slot is per CPU, like proc/table.ritz's).
# 0 is none, so the zeroed BSS means nothing is current. The kernel's
# cpu_index is arch/x86_64/percpu.ritz's; a host test supplies a stub.
var fs_current_by_cpu: [64]i32

extern fn cpu_index() -> i32

# This CPU's current FsProc index, or -1.
fn fs_current() -> i32
    fs_current_by_cpu[cpu_index()] - 1

fn fs_set_current(slot: i32)
    fs_current_by_cpu[cpu_index()] = slot + 1
var fs_syscall_initialized: bool = false

const WRITE_BUFFER_INITIAL: u64 = 4096

# Initialize filesystem syscalls
pub fn fs_syscall_init()
    if fs_syscall_initialized
        return
    fs_syscall_initialized = true
    klog("fs_syscall: initialized\n" as StrView)

fn fs_current_proc() -> *FsProc
    let c: i32 = fs_current()
    if c < 0
        return 0 as *FsProc
    fs_procs[c]

# p's open file at fd, or null if fd is not an open file of p. A dup'd fd
# has no FsFile of its own: it shares its owner's (fd_owner), so dups see
# one position and one write buffer, as POSIX dup does (AGAST #2786).
fn fs_file(p: *FsProc, fd: i32) -> *FsFile
    if p == 0 as *FsProc or fd < 3 or fd >= MAX_FDS
        return 0 as *FsFile
    let owner_fd: i32 = fd_owner(@(*p).table, fd)
    if owner_fd < 0 or fs_is_pipe(p, fd)
        return 0 as *FsFile
    @(*p).files[owner_fd]

# Whether fd is open in p and refers to a pipe end.
fn fs_is_pipe(p: *FsProc, fd: i32) -> bool
    let desc: *FileDescriptor = fd_get(@(*p).table, fd)
    desc != 0 as *FileDescriptor and (*desc).kind == FD_KIND_PIPE

# The pipe end p's fd refers to, or None if it is no pipe fd of p. Like an
# FsFile, the end lives at the owner fd's index.
fn fs_pipe_of(p: *FsProc, fd: i32) -> Option<PipeEnd>
    if p == 0 as *FsProc or not fs_is_pipe(p, fd)
        return None
    Some(p.pipe_ends[fd_owner(@(*p).table, fd)])

# Make p's open fd refer to `end` (its count is the caller's business).
fn fs_bind_pipe(p: *FsProc, fd: i32, end: PipeEnd)
    let desc: *FileDescriptor = fd_get(@(*p).table, fd)
    (*desc).kind = FD_KIND_PIPE
    (*p).pipe_ends[fd] = end

# Close p's pipe fd: its end loses one fd. fds 0-2 are never freed (fs/fd.ritz):
# a closed redirected stdio fd is the console again, as a child that was
# given none has.
fn fs_close_pipe(p: *FsProc, fd: i32)
    match fs_pipe_of(p, fd)
        Some(end) => pipe_release(end)
        None => return
    if fd < 3
        (*fd_get(@(*p).table, fd)).kind = FD_KIND_STDIO
        return
    if fd_refs(@(*p).table, fd) > 1 and fd_owner(@(*p).table, fd) == fd
        (*p).pipe_ends[fd_heir(@(*p).table, fd)] = p.pipe_ends[fd]
    fd_free(@(*p).table, fd)

# A process starts running: give it an empty fd table and make it current.
# 0, Errno.Again (FS_MAX_PROCS live already) or Errno.NoMem.
pub fn fs_process_start(pid: u64) -> i32
    var slot: i32 = 0
    while slot < FS_MAX_PROCS and fs_procs[slot] != 0 as *FsProc
        slot = slot + 1
    if slot == FS_MAX_PROCS
        return Errno.Again as i32
    let p: *FsProc = kalloc(sizeof(FsProc) as u64) as *FsProc
    if p == 0 as *FsProc
        return Errno.NoMem as i32
    (*p).pid = pid
    (*p).parent = fs_current()
    (*p).mmap_next = 0
    fd_table_init(@(*p).table)
    fs_procs[slot] = p
    fs_set_current(slot)
    0

# The current process exits: close every fd it left open, flushing pending
# writes as sys_close does except that an O_TRUNC fd that wrote nothing
# leaves its file (see "What close commits") and releasing its pipe ends
# (fds 0-2 included), free its FsProc and make its parent's current. Returns how many fds it closed, or Errno.Srch if none is
# current.
pub fn fs_process_end() -> i32
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i32
    var closed: i32 = 0
    var fd: i32 = 0
    while fd < MAX_FDS
        if fs_is_pipe(p, fd)
            fs_close_pipe(p, fd)
            closed = closed + 1
        else if fs_file(p, fd) != 0 as *FsFile
            fs_close_file(p, fd, CloseBy.Exit)
            closed = closed + 1
        fd = fd + 1
    fs_procs[fs_current()] = 0 as *FsProc
    fs_set_current(p.parent)
    kfree(p as *u8)
    closed

# Make process `pid`'s FsProc current: the scheduler switched to it
# (proc/sched.ritz, #3629). 0, or Errno.Srch if it has none (nothing is
# current then).
pub fn fs_process_select(pid: u64) -> i32
    var slot: i32 = 0
    while slot < FS_MAX_PROCS
        let p: *FsProc = fs_procs[slot]
        if p != 0 as *FsProc and p.pid == pid
            fs_set_current(slot)
            return 0
        slot = slot + 1
    fs_set_current(-1)
    Errno.Srch as i32

# The pid fs_process_start gave the current process, or 0 if none.
pub fn fs_process_pid() -> u64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return 0
    p.pid

# The current process's mmap cursor (syscall/runtime/memory.ritz owns its
# meaning; 0 until it first sets one), or 0 if no process is current. It
# lives here because FsProc is the one per-process record the kernel keeps.
pub fn fs_process_mmap_next() -> u64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return 0
    p.mmap_next

# Set the current process's mmap cursor. Errno.Srch if none is current.
pub fn fs_process_set_mmap_next(addr: u64) -> i32
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i32
    (*p).mmap_next = addr
    0

# Processes with an fd table.
pub fn fs_process_count() -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < FS_MAX_PROCS
        if fs_procs[i] != 0 as *FsProc
            n = n + 1
        i = i + 1
    n

# ============================================================================
# sys_open - Open a file
# ============================================================================
#
# Arguments:
#   path_ptr: pointer to path string
#   path_len: length of path
#   flags: open flags (O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, etc.)
#   mode: with O_CREAT, the permission bits (07777 of it) a file this open
#         creates gets; an existing file keeps its own (AGAST #4832)
#
# Returns:
#   >= 0: file descriptor
#   < 0: error code

pub fn sys_open(path_ptr: *u8, path_len: u64, flags: i32, mode: u32) -> i64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i64

    let path: StrView = StrView { ptr: path_ptr, len: path_len as i64 }

    # A path at or below /var lives in the persistent subtree's namespace
    # (fs/kfs.ritz, #4321): there it is "/x", not "/var/x", and it is what
    # the next boot loads. Everything else is the runtime tree.
    let ns: *Namespace = kfs_ns_for(path)
    if ns == 0 as *Namespace
        return Errno.Inval as i64
    let local: StrView = kfs_local(path)
    if (flags & O_DIRECTORY) != 0
        return fs_open_dir(p, ns, local, flags)

    # Resolve the path to a blob ID, and decide what O_CREAT / O_EXCL do
    # about it (fs/persist.ritz open_plan): an O_SYNC create on /var is
    # deferred to the close's durable commit, any other create happens now.
    var blob_id: BlobId = namespace_resolve(ns, local)
    let plan: OpenPlan = match open_plan(not blob_id_is_zero(@blob_id), flags, kfs_is_durable(path))
        Ok(pl) => pl
        Err(e) => return e as i64
    var create: WriteMode = WriteMode.Keep
    match plan
        CreateNow =>
            # Create the file with empty content and the caller's mode
            let create_result: i32 = kfs_persist_create(path, mode)
            if create_result != 0
                return create_result as i64
            # Re-resolve to get the new blob ID
            blob_id = namespace_resolve(ns, local)
            if blob_id_is_zero(@blob_id)
                return Errno.NoEnt as i64
        CreateAtClose => create = WriteMode.Set(mode)
        Existing => pass
    let deferred: bool = plan == OpenPlan.CreateAtClose

    # Allocate a file descriptor
    let fd: i32 = fd_alloc(@(*p).table)
    if fd < 0
        return fd as i64

    # Hold the blob while the fd is open: a rewrite or delete of the path
    # then can't free the bytes data_ptr points at (fs_close_file unholds).
    # A deferred create has no blob yet: it reads as empty.
    var data_ptr: *u8 = 0 as *u8
    var size: u64 = 0
    if not deferred
        if not namespace_hold(ns, @blob_id)
            fd_free(@(*p).table, fd)
            return Errno.NoEnt as i64
        let store: *MemoryBlobStore = namespace_store(ns)
        data_ptr = memory_store_get(store, @blob_id)
        size = memory_store_get_size(store, @blob_id)

    # Set up file state
    let f: *FsFile = @(*p).files[fd]
    (*f).ns = ns
    (*f).blob_id = blob_id_copy(@blob_id)
    (*f).data_ptr = data_ptr
    (*f).size = size
    (*f).position = 0
    (*f).flags = flags
    (*f).wbuf = 0 as *u8
    (*f).wbuf_size = 0
    (*f).wbuf_cap = 0
    (*f).path = 0 as *u8
    (*f).path_len = 0
    (*f).create = create
    (*f).dir = false
    if deferred
        # What the close will create: an empty regular file of this mode
        (*f).meta = NsStat { is_dir: false, size: 0, modified: 0, mode: mode }
    else
        (*f).meta = fs_open_meta(ns, local)

    # O_TRUNC on a writable fd: the fd reads the file as empty from here, and
    # close commits its write buffer even if it is empty (fs_close_commits).
    if fs_truncates(flags)
        (*f).size = 0
        (*f).position = 0

    # Handle O_APPEND - position at end
    if (flags & O_APPEND) != 0
        (*f).position = size

    # Store path for write-back on close
    if (flags & O_WRONLY) != 0 or (flags & O_RDWR) != 0
        let copy: *u8 = kalloc(path_len + 1)
        if copy == 0 as *u8
            if not deferred
                namespace_unhold(ns, @blob_id)
            fd_free(@(*p).table, fd)
            return Errno.NoMem as i64
        var i: u64 = 0
        while i < path_len
            *(copy + i) = *(path_ptr + i)
            i = i + 1
        *(copy + path_len) = 0
        (*f).path = copy
        (*f).path_len = path_len

    fd as i64

# open(O_DIRECTORY): an fd on the directory at `local` in `ns`, for
# getdents64. The fd or an Errno as i64, because it is sys_open's return
# (the open syscall's register, as every branch of sys_open). It holds the directory's blob, so it lists the directory as it
# was at this open (fs/dirent.ritz). Read-only: a write, create or truncate
# flag is Inval; a path that is not a directory is NotDir.
fn fs_open_dir(p: *FsProc, ns: *Namespace, local: StrView, flags: i32) -> i64
    if (flags & (O_WRONLY | O_RDWR | O_CREAT | O_TRUNC | O_APPEND)) != 0
        return Errno.Inval as i64
    let meta: NsStat = match namespace_stat(ns, local)
        Ok(st) => st
        Err(_) => return Errno.NoEnt as i64
    if not meta.is_dir
        return Errno.NotDir as i64
    var blob_id: BlobId = namespace_resolve(ns, local)
    if not namespace_hold(ns, @blob_id)
        return Errno.NoEnt as i64
    let fd: i32 = fd_alloc(@(*p).table)
    if fd < 0
        namespace_unhold(ns, @blob_id)
        return fd as i64
    let f: *FsFile = @(*p).files[fd]
    (*f).ns = ns
    (*f).blob_id = blob_id_copy(@blob_id)
    (*f).data_ptr = 0 as *u8
    (*f).size = 0
    (*f).position = 0
    (*f).flags = flags
    (*f).wbuf = 0 as *u8
    (*f).wbuf_size = 0
    (*f).wbuf_cap = 0
    (*f).path = 0 as *u8
    (*f).path_len = 0
    (*f).meta = meta
    (*f).create = WriteMode.Keep
    (*f).dir = true
    fd as i64

# The entry at `local` in `ns` as an fd opened on it records it. The path
# resolved a moment ago, so a failure here is not expected: then a regular
# file with mode 0644 and modified 0.
fn fs_open_meta(ns: *Namespace, local: StrView) -> NsStat
    match namespace_stat(ns, local)
        Ok(st) => st
        Err(_) => NsStat { is_dir: false, size: 0, modified: 0, mode: 420 }

# ============================================================================
# sys_fstat - The status of an open fd (AGAST #4832)
# ============================================================================
#
# A file fd reports the file as it was when the fd opened it: its type, mode
# and modified time then, and the size the fd reads (0 after O_TRUNC). A
# write fd's bytes reach the file only on close (see "What close commits"),
# so a stat of the path after that close is what shows them. A pipe end is
# S_IFIFO. fds 0-2 that are neither are the console (S_IFCHR). The Stat, or None for a number
# that is neither (the handler's Errno.BadF); the handler writes it to the
# caller's record.

pub fn sys_fstat(fd: i32) -> Option<Stat>
    let p: *FsProc = fs_current_proc()
    let f: *FsFile = fs_file(p, fd)
    if f != 0 as *FsFile
        return Some(stat_of_entry((*f).meta, (*f).size))
    if p != 0 as *FsProc and fs_is_pipe(p, fd)
        return Some(stat_pipe())
    if fd >= 0 and fd <= 2
        return Some(stat_console())
    None

# ============================================================================
# sys_dup - A second fd for an open file
# ============================================================================
#
# The new fd shares fd's FsFile (see fs_file). Not in the syscall table: it
# is a kernel-internal helper with no dispatcher entry, so user space cannot
# reach it and it needs no boundary gate today. If it is ever wired, its
# handler must check CAP_TYPE_NAMESPACE (READ or WRITE), as SYS_CLOSE and
# SYS_LSEEK do, since duplicating an fd mutates the namespace-backed fd
# table (AGAST #4479).

pub fn sys_dup(fd: i32) -> i64
    let p: *FsProc = fs_current_proc()
    if fs_file(p, fd) == 0 as *FsFile
        return Errno.BadF as i64
    fd_dup(@(*p).table, fd) as i64

# ============================================================================
# sys_close - Close a file descriptor
# ============================================================================

pub fn sys_close(fd: i32) -> i64
    let p: *FsProc = fs_current_proc()
    if p != 0 as *FsProc and fs_is_pipe(p, fd)
        fs_close_pipe(p, fd)
        return 0
    if fs_file(p, fd) == 0 as *FsFile
        return Errno.BadF as i64
    fs_close_file(p, fd, CloseBy.Close) as i64

# Who closes an fd: the process's close(2), or its exit (fs_process_end).
# Only the first commits an O_TRUNC fd that wrote nothing.
enum CloseBy
    Close
    Exit

# Free fd. Its open file's state goes only with the file's last fd: then
# flush its pending writes and release it (0, or the flush's Errno). While
# other fds share it, it stays; if fd owned it, it moves to the fd that
# fd_free makes the new owner. Shared by sys_close and fs_process_end; `by`
# says which, for fs_close_commits.
fn fs_close_file(p: *FsProc, fd: i32, by: CloseBy) -> i32
    let owner_fd: i32 = fd_owner(@(*p).table, fd)
    if fd_refs(@(*p).table, fd) > 1
        if owner_fd == fd
            fs_file_move(@(*p).files[fd], @(*p).files[fd_heir(@(*p).table, fd)])
        fd_free(@(*p).table, fd)
        return 0
    let f: *FsFile = @(*p).files[owner_fd]
    # Whether closing this fd committed bytes to the persistent subtree, and
    # so owes the storage device a (debounced) save.
    let wrote: bool = fs_close_commits(f, by)
    let persist: bool = (*f).path != 0 as *u8 and kfs_is_persist(StrView { ptr: (*f).path, len: (*f).path_len as i64 })
    # An O_SYNC fd's commit saved itself (fs_flush_write_buffer)
    let durable: bool = fs_is_sync((*f).flags)
    let flush_result: i32 = fs_flush_write_buffer(f, by)
    if (*f).path != 0 as *u8
        kfree((*f).path)
        (*f).path = 0 as *u8
        (*f).path_len = 0
    let ns: *Namespace = (*f).ns
    if ns != 0 as *Namespace and not blob_id_is_zero(@(*f).blob_id)
        namespace_unhold(ns, @(*f).blob_id)
    (*f).ns = 0 as *Namespace
    (*f).data_ptr = 0 as *u8
    (*f).position = 0
    (*f).create = WriteMode.Keep
    fd_free(@(*p).table, fd)
    if wrote and persist and not durable and flush_result == KFS_OK
        kfs_save_later()
    flush_result

# Move an open file's state from one fd's slot to another's.
fn fs_file_move(src: *FsFile, dst: *FsFile)
    (*dst).ns = (*src).ns
    (*dst).blob_id = blob_id_copy(@(*src).blob_id)
    (*dst).data_ptr = (*src).data_ptr
    (*dst).size = (*src).size
    (*dst).position = (*src).position
    (*dst).flags = (*src).flags
    (*dst).wbuf = (*src).wbuf
    (*dst).wbuf_size = (*src).wbuf_size
    (*dst).wbuf_cap = (*src).wbuf_cap
    (*dst).path = (*src).path
    (*dst).path_len = (*src).path_len
    (*dst).meta = (*src).meta
    (*dst).create = (*src).create
    (*dst).dir = (*src).dir

# ============================================================================
# sys_read - Read from a file
# ============================================================================
#
# Arguments:
#   fd: file descriptor
#   buf: buffer to read into
#   count: number of bytes to read
#
# Returns:
#   >= 0: number of bytes read
#   < 0: error code

pub fn sys_fs_read(fd: i32, buf: *u8, count: u64) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64
    # A directory's entries are read with getdents64
    if (*f).dir
        return Errno.IsDir as i64

    # Check read permission
    let flags: i32 = (*f).flags
    if (flags & O_WRONLY) != 0 and (flags & O_RDWR) == 0
        return Errno.BadF as i64  # Write-only, can't read

    let pos: u64 = (*f).position
    let size: u64 = (*f).size
    let data: *u8 = (*f).data_ptr

    # Calculate how much we can actually read
    var bytes_to_read: u64 = count
    if pos >= size
        return 0  # EOF
    if pos + bytes_to_read > size
        bytes_to_read = size - pos

    # Copy data to buffer
    var i: u64 = 0
    while i < bytes_to_read
        *(buf + i) = *(data + pos + i)
        i = i + 1

    # Update position
    (*f).position = pos + bytes_to_read

    bytes_to_read as i64

# ============================================================================
# sys_write - Write to a file
# ============================================================================
#
# For content-addressable storage, writes create new blobs: the data is
# buffered per fd and written back to the namespace on close (see "What close
# commits" below for when).

# Simple realloc implementation
fn krealloc(old_ptr: *u8, new_size: u64, old_size: u64) -> *u8
    if old_ptr == 0 as *u8
        return kalloc(new_size)
    let new_ptr: *u8 = kalloc(new_size)
    if new_ptr == 0 as *u8
        return 0 as *u8
    # Copy old data
    var copy_size: u64 = old_size
    if copy_size > new_size
        copy_size = new_size
    var i: u64 = 0
    while i < copy_size
        *(new_ptr + i) = *(old_ptr + i)
        i = i + 1
    kfree(old_ptr)
    new_ptr

pub fn sys_fs_write(fd: i32, buf: *u8, count: u64) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64

    # Check write permission
    let flags: i32 = (*f).flags
    if (flags & O_WRONLY) == 0 and (flags & O_RDWR) == 0
        return Errno.BadF as i64  # Read-only

    # Allocate write buffer if needed
    if (*f).wbuf == 0 as *u8
        (*f).wbuf = kalloc(WRITE_BUFFER_INITIAL)
        if (*f).wbuf == 0 as *u8
            return Errno.NoMem as i64
        (*f).wbuf_cap = WRITE_BUFFER_INITIAL
        (*f).wbuf_size = 0

    # Grow buffer if needed
    let new_size: u64 = (*f).wbuf_size + count
    if new_size > (*f).wbuf_cap
        var new_cap: u64 = (*f).wbuf_cap * 2
        if new_cap < new_size
            new_cap = new_size + 1024
        let new_buf: *u8 = krealloc((*f).wbuf, new_cap, (*f).wbuf_cap)
        if new_buf == 0 as *u8
            return Errno.NoMem as i64
        (*f).wbuf = new_buf
        (*f).wbuf_cap = new_cap

    # Copy data to buffer
    var i: u64 = 0
    let offset: u64 = (*f).wbuf_size
    while i < count
        *((*f).wbuf + offset + i) = *(buf + i)
        i = i + 1
    (*f).wbuf_size = new_size

    # Update position
    (*f).position = (*f).position + count

    count as i64

# ============================================================================
# What close commits (AGAST #4830)
# ============================================================================
#
# A write fd's bytes go to a per-fd buffer, whatever the file position, and
# the last close of the fd (sys_close, or fs_process_end at exit) replaces
# the whole file with that buffer. Close commits the buffer when
#
#   - any byte was written to the fd (on either path), or
#   - the fd was opened writable (O_WRONLY or O_RDWR) with O_TRUNC and the
#     process closed it with close(2): then an empty buffer commits an empty
#     file.
#
# - the open deferred an O_SYNC create to the close (fs/persist.ritz
#   open_plan) and the process closed it with close(2): the close creates
#   the file, empty if nothing was written.
#
# Otherwise close leaves the file as it was: an fd opened for writing
# without O_TRUNC that writes nothing (or only zero-byte writes) does not
# truncate it, and neither does an O_TRUNC fd that wrote nothing and is
# closed by its process's exit. So write_file's O_WRONLY | O_CREAT | O_TRUNC
# open, zero-byte write and close empties the file, while a save killed (or
# exiting) between its open and its first write leaves the old file: old or
# new, never a prefix, the empty one included (BUDDHAFINGER_PROPOSAL.md
# §Harland). A deferred create the process exits from without a write
# leaves no file, the "old" state of a path that had none.
#
# On an O_SYNC fd under /var with storage the commit is durable
# (kfs_commit_durable, fs/REPLACEMENT.md): it is on the storage device
# before anyone reads it, and if close returns an Errno the file is old in
# RAM and on the device.

# Whether open flags truncate: O_TRUNC on a writable open.
fn fs_truncates(flags: i32) -> bool
    (flags & O_TRUNC) != 0 and ((flags & O_WRONLY) != 0 or (flags & O_RDWR) != 0)

# Whether open flags ask for durable commits: all of O_SYNC's bits.
fn fs_is_sync(flags: i32) -> bool
    (flags & O_SYNC) == O_SYNC

# Whether the open deferred its create to the close
fn fs_deferred(f: *FsFile) -> bool
    match (*f).create
        Keep => false
        Set(_) => true

# Whether closing f's last fd, by `by`, replaces the file (the rule above).
fn fs_close_commits(f: *FsFile, by: CloseBy) -> bool
    if (*f).wbuf != 0 as *u8 and (*f).wbuf_size > 0
        return true
    match by
        CloseBy.Close => fs_truncates((*f).flags) or fs_deferred(f)
        CloseBy.Exit => false

# Commit f's write buffer to the namespace if fs_close_commits says so, and
# free it: 0, or an Errno that sys_close returns.
fn fs_flush_write_buffer(f: *FsFile, by: CloseBy) -> i32
    let commits: bool = fs_close_commits(f, by)
    let wbuf: *u8 = (*f).wbuf
    let wsize: u64 = (*f).wbuf_size
    (*f).wbuf = 0 as *u8
    (*f).wbuf_size = 0
    (*f).wbuf_cap = 0

    var result: i32 = 0
    if commits and (*f).path_len == 0
        result = Errno.Io as i32  # no path to write back to
    else if commits
        # Write back through the path routing: the runtime tree always, and
        # the persistent subtree too when the path is at or below /var (which
        # is the namespace the blob was held in). An fd that wrote nothing
        # has no buffer; its commit is the empty file.
        let path: StrView = StrView { ptr: (*f).path, len: (*f).path_len as i64 }
        var empty: u8 = 0
        var bytes: *u8 = @empty
        if wsize > 0
            bytes = wbuf
        if fs_is_sync((*f).flags)
            let data: Span<u8> = span_from_ptr<u8>(bytes, wsize as i64)
            result = match kfs_commit_durable(path, data, (*f).create, ((*f).flags & O_EXCL) != 0)
                Ok(_) => 0
                Err(e) => e as i32
        else
            result = kfs_persist_write(path, bytes, wsize)
    if wbuf != 0 as *u8
        kfree(wbuf)
    result

# ============================================================================
# sys_getdents64 - A directory fd's entries (AGAST #4947)
# ============================================================================
#
# Fills `out` with Linux's linux_dirent64 records (fs/dirent.ritz) for the
# entries from the fd's position on, as many as fit, and moves the position
# past them: Ok(the bytes written), Ok(0) at the end of the directory.
# Err(BadF) for no open fd, NotDir for a file fd, Inval if `out` can't hold
# the next record. The handler turns it into the syscall's return.

pub fn sys_getdents64(fd: i32, out: Span<u8>) -> Result<i64, Errno>
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Err(Errno.BadF)
    if not (*f).dir
        return Err(Errno.NotDir)
    match dirent_fill((*f).ns, @(*f).blob_id, (*f).position as i32, out)
        Ok(fill) =>
            (*f).position = fill.next as u64
            Ok(fill.bytes)
        Err(e) => Err(e)

# ============================================================================
# sys_lseek - Seek in a file
# ============================================================================

pub const SEEK_SET: i32 = 0
pub const SEEK_CUR: i32 = 1
pub const SEEK_END: i32 = 2

pub fn sys_lseek(fd: i32, offset: i64, whence: i32) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64

    let size: u64 = (*f).size
    var new_pos: i64

    if whence == SEEK_SET
        new_pos = offset
    else if whence == SEEK_CUR
        new_pos = (*f).position as i64 + offset
    else if whence == SEEK_END
        new_pos = size as i64 + offset
    else
        return Errno.Inval as i64

    if new_pos < 0
        return Errno.Inval as i64

    (*f).position = new_pos as u64
    new_pos

# ============================================================================
# sys_mkdir - Create a directory
# ============================================================================

pub fn sys_mkdir(path: StrView) -> i64
    if kfs_get() == 0 as *Namespace
        return Errno.Inval as i64
    let result: i32 = kfs_persist_mkdir(path)
    if result == KFS_OK and kfs_is_persist(path)
        kfs_save_later()
    result as i64

# ============================================================================
# sys_unlink / sys_rmdir - Remove a file or an empty directory (AGAST #4957)
# ============================================================================
#
# Under /var the remove is a commit like a close's, saved later
# (kfs_save_later); anywhere else (/tmp) it only changes RAM. An fd open on
# the file keeps reading what it opened: it holds the blob.

# A remove's result, with the save it owes under /var scheduled.
fn fs_removed(path: StrView, r: Result<(), Errno>) -> Result<(), Errno>
    if r.is_ok() and kfs_is_persist(path)
        kfs_save_later()
    r

# Remove the file at `path`: IsDir for a directory, NoEnt if it is missing.
pub fn sys_unlink(path: StrView) -> Result<(), Errno>
    if kfs_get() == 0 as *Namespace
        return Err(Errno.Inval)
    fs_removed(path, kfs_unlink(path))

# Remove the empty directory at `path`: NotDir for a file, NotEmpty if it
# holds anything.
pub fn sys_rmdir(path: StrView) -> Result<(), Errno>
    if kfs_get() == 0 as *Namespace
        return Err(Errno.Inval)
    fs_removed(path, kfs_rmdir(path))

# ============================================================================
# fs_sync - Flush the persistent subtree to the storage device
# ============================================================================
#
# Save-on-close is debounced (kfs_save_later, #4321), so a program that needs
# its /var writes on disk before it returns to some other work calls Sync.
# Unconditional: whatever the debounce deferred is written now. 0 or an Errno.
pub fn fs_sync() -> i32
    kfs_save()

# ============================================================================
# Check if fd is a filesystem fd
# ============================================================================

# FDs 0, 1, 2 are stdin/stdout/stderr (serial), never filesystem fds.
pub fn is_fs_fd(fd: i32) -> bool
    fs_file(fs_current_proc(), fd) != 0 as *FsFile

# ============================================================================
# Pipe fds (AGAST #4955)
# ============================================================================
#
# An fd of FD_KIND_PIPE refers to one end of a pipe (fs/pipe.ritz), kept in
# FsProc.pipe_ends at the fd's index. pipe(2) makes the two fds, a spawn
# hands ends to a child's 0-2 (fs_process_give_stdio), and close or exit
# releases them (fs_close_pipe). The calls here never block: an empty read
# or a full write is Err(Again), and syscall/runtime/pipe.ritz parks the
# caller and wakes it. A pipe fd is no file: is_fs_fd is false for it.

# pipe(2)'s two fds: bytes written to `write` are read from `read`.
pub struct PipeFds
    read: i32
    write: i32

# A new pipe as two fds of the current process, the lowest free ones:
# Err(Srch) with none current, Err(NFile) with the pipe pool or the fd table
# full, and nothing left behind.
pub fn fs_pipe_open() -> Result<PipeFds, Errno>
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Err(Errno.Srch)
    var pipe: i32 = 0
    match pipe_create()
        Ok(n) => pipe = n
        Err(e) => return Err(e)
    let rfd: i32 = fd_alloc(@(*p).table)
    if rfd < 0
        pipe_release(pipe_reader(pipe))
        pipe_release(pipe_writer(pipe))
        return Err(Errno.NFile)
    let wfd: i32 = fd_alloc(@(*p).table)
    if wfd < 0
        fd_free(@(*p).table, rfd)
        pipe_release(pipe_reader(pipe))
        pipe_release(pipe_writer(pipe))
        return Err(Errno.NFile)
    fs_bind_pipe(p, rfd, pipe_reader(pipe))
    fs_bind_pipe(p, wfd, pipe_writer(pipe))
    Ok(PipeFds { read: rfd, write: wfd })

# The pipe end the current process's fd refers to, or None if it is no pipe
# fd (a file, the console, or not open).
pub fn fs_pipe_end(fd: i32) -> Option<PipeEnd>
    fs_pipe_of(fs_current_proc(), fd)

# Whether the current process's fd is a pipe end.
pub fn is_pipe_fd(fd: i32) -> bool
    let p: *FsProc = fs_current_proc()
    p != 0 as *FsProc and fs_is_pipe(p, fd)

# Read from the current process's pipe fd without blocking: fs/pipe.ritz's
# pipe_read, or Err(BadF) if fd is not a pipe's read end.
pub fn fs_pipe_read(fd: i32, dst: Span<u8>) -> Result<i64, Errno>
    match fs_pipe_end(fd)
        Some(end) => match end.side
            PipeSide.Read => pipe_read(end.pipe, dst)
            PipeSide.Write => Err(Errno.BadF)
        None => Err(Errno.BadF)

# Write to the current process's pipe fd without blocking: fs/pipe.ritz's
# pipe_write, or Err(BadF) if fd is not a pipe's write end.
pub fn fs_pipe_write(fd: i32, src: Span<u8>) -> Result<i64, Errno>
    match fs_pipe_end(fd)
        Some(end) => match end.side
            PipeSide.Write => pipe_write(end.pipe, src)
            PipeSide.Read => Err(Errno.BadF)
        None => Err(Errno.BadF)

# Where a spawned child's fds 0, 1 and 2 come from: each the parent fd it
# shares. The spawn_io syscall's record (three i32s, ritzlib.command's
# SpawnStdio); { 0, 1, 2 } is the parent's own stdio.
pub struct SpawnStdio
    stdin: i32
    stdout: i32
    stderr: i32

# The map every spawn but spawn_io uses: the child's 0-2 are the parent's.
pub fn spawn_stdio_inherit() -> SpawnStdio
    SpawnStdio { stdin: 0, stdout: 1, stderr: 2 }

# The parent fd child fd `n` (0-2) takes under `map`.
fn spawn_stdio_source(map: SpawnStdio, n: i32) -> i32
    if n == 0
        return map.stdin
    if n == 1
        return map.stdout
    map.stderr

# Whether the current process's fd can be a child's stdio: a pipe end, or a
# console stdio fd. A file is not (its FsFile, position and write buffer
# belong to one process).
fn fs_stdio_source_ok(p: *FsProc, fd: i32) -> bool
    if fs_is_pipe(p, fd)
        return true
    let desc: *FileDescriptor = fd_get(@(*p).table, fd)
    desc != 0 as *FileDescriptor and (*desc).kind == FD_KIND_STDIO

# Give process `child_pid` (just started by fs_process_start, nothing run
# yet) its fds 0-2 from the current process under `map`: a pipe end is shared
# (one more fd on it), a console fd leaves the child's console fd. Err(Srch)
# without a current process or a child table; Err(BadF), and nothing given,
# if any source is not open or is a file.
pub fn fs_process_give_stdio(child_pid: u64, map: SpawnStdio) -> Result<(), Errno>
    let p: *FsProc = fs_current_proc()
    var c: *FsProc = 0 as *FsProc
    match fs_proc_of(child_pid)
        Some(found) => c = found
        None => return Err(Errno.Srch)
    if p == 0 as *FsProc
        return Err(Errno.Srch)
    var n: i32 = 0
    while n < 3
        if not fs_stdio_source_ok(p, spawn_stdio_source(map, n))
            return Err(Errno.BadF)
        n = n + 1
    n = 0
    while n < 3
        match fs_pipe_of(p, spawn_stdio_source(map, n))
            Some(end) =>
                pipe_hold(end)
                fs_bind_pipe(c, n, end)
            None => pass
        n = n + 1
    Ok(())

# Process `pid`'s FsProc, or None if it has none.
fn fs_proc_of(pid: u64) -> Option<*FsProc>
    var slot: i32 = 0
    while slot < FS_MAX_PROCS
        let p: *FsProc = fs_procs[slot]
        if p != 0 as *FsProc and p.pid == pid
            return Some(p)
        slot = slot + 1
    None
