# Filesystem Syscalls
#
# Implements sys_open, sys_close, sys_read, sys_write for files.
# Integrates with the kernel namespace (fs/kfs.ritz) and the per-process fd tables (fs/fd.ritz).

import klog { klog }
import serial { StrView }
import fs.vfs { O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND }
import fs.fd { FdTable, MAX_FDS, fd_table_init, fd_alloc, fd_free, fd_dup, fd_owner, fd_refs, fd_heir }
import syscall.errno { Errno }
import fs.kfs { KFS_OK, kfs_get, kfs_ns_for, kfs_local, kfs_is_persist, kfs_persist_write, kfs_persist_mkdir, kfs_save, kfs_save_later }
import goliath.namespace { Namespace, namespace_resolve, namespace_store, namespace_hold, namespace_unhold }
import goliath.blob_id { BlobId, blob_id_is_zero, blob_id_copy }
import goliath.blob_store { MemoryBlobStore, memory_store_get, memory_store_get_size }
import mm.heap { kalloc, kfree }

# Syscall numbers are `enum Syscall` in syscall/numbers.ritz; main.ritz
# registers this module's handlers in the dispatch table (syscall/dispatch.ritz).

# ============================================================================
# Per-process file state (AGAST #2753)
# ============================================================================
#
# Each process has an FsProc: its own FdTable (fds 3..255) and, per fd, the
# open file's blob, position and pending writes. The process layer
# (syscall/runtime/process.ritz) brackets every process's life:
# fs_process_start(pid) when it starts running (run_init for init, spawn for
# a child) makes a fresh FsProc current; fs_process_end() when it exits
# closes every fd it left open (flushing writes as sys_close does), frees the
# FsProc and makes the parent's current again. With several processes
# runnable (#3629), proc/sched.ritz calls fs_process_select(pid) on every
# switch. So the fs layer never asks who is running, and imports nothing from
# the process layer.
#
# An FsProc is ~36 KB and comes from the kernel heap only while its process
# lives, so the BSS holds just the FS_MAX_PROCS pointers. Read its fields as
# `p.field`: ritz0 lowers `(*p).field` by loading the whole FsProc first.

# One open file.
struct FsFile
    ns: *Namespace         # The namespace holding the blob (persistent under /var)
    blob_id: BlobId         # The blob this fd refers to, held while it is open
    data_ptr: *u8           # The blob's bytes (the hold keeps them alive)
    size: u64               # File size
    position: u64           # Current read/write position
    flags: i32              # Open flags
    wbuf: *u8               # Pending writes, flushed on close (null if none)
    wbuf_size: u64
    wbuf_cap: u64
    path: *u8               # Heap copy of the path, for writable fds (null if none)
    path_len: u64

struct FsProc
    pid: u64
    parent: i32             # fs_procs index of the spawning process; -1 for none
    mmap_next: u64          # next kernel-chosen mmap address; 0 = region start (#3530)
    table: FdTable
    files: [256]FsFile      # indexed by fd; meaningful while the fd is open

# Live processes at once: proc/table.ritz's MAX_PROCS.
pub const FS_MAX_PROCS: i32 = 8

var fs_procs: [8]*FsProc
var fs_current: i32 = -1
var fs_syscall_initialized: bool = false

const WRITE_BUFFER_INITIAL: u64 = 4096

# Initialize filesystem syscalls
pub fn fs_syscall_init()
    if fs_syscall_initialized
        return
    fs_syscall_initialized = true
    klog("fs_syscall: initialized\n" as StrView)

fn fs_current_proc() -> *FsProc
    if fs_current < 0
        return 0 as *FsProc
    fs_procs[fs_current]

# p's open file at fd, or null if fd is not an open file of p. A dup'd fd
# has no FsFile of its own: it shares its owner's (fd_owner), so dups see
# one position and one write buffer, as POSIX dup does (AGAST #2786).
fn fs_file(p: *FsProc, fd: i32) -> *FsFile
    if p == 0 as *FsProc or fd < 3 or fd >= MAX_FDS
        return 0 as *FsFile
    let owner_fd: i32 = fd_owner(@(*p).table, fd)
    if owner_fd < 0
        return 0 as *FsFile
    @(*p).files[owner_fd]

# A process starts running: give it an empty fd table and make it current.
# 0, Errno.Again (FS_MAX_PROCS live already) or Errno.NoMem.
pub fn fs_process_start(pid: u64) -> i32
    var slot: i32 = 0
    while slot < FS_MAX_PROCS and fs_procs[slot] != 0 as *FsProc
        slot = slot + 1
    if slot == FS_MAX_PROCS
        return Errno.Again as i32
    let p: *FsProc = kalloc(sizeof(FsProc) as u64) as *FsProc
    if p == 0 as *FsProc
        return Errno.NoMem as i32
    (*p).pid = pid
    (*p).parent = fs_current
    (*p).mmap_next = 0
    fd_table_init(@(*p).table)
    fs_procs[slot] = p
    fs_current = slot
    0

# The current process exits: close every fd it left open, flushing pending
# writes as sys_close does except that an O_TRUNC fd that wrote nothing
# leaves its file (see "What close commits"), free its FsProc and make its
# parent's current. Returns how many fds it closed, or Errno.Srch if none is
# current.
pub fn fs_process_end() -> i32
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i32
    var closed: i32 = 0
    var fd: i32 = 3
    while fd < MAX_FDS
        if fs_file(p, fd) != 0 as *FsFile
            fs_close_file(p, fd, CloseBy.Exit)
            closed = closed + 1
        fd = fd + 1
    fs_procs[fs_current] = 0 as *FsProc
    fs_current = p.parent
    kfree(p as *u8)
    closed

# Make process `pid`'s FsProc current: the scheduler switched to it
# (proc/sched.ritz, #3629). 0, or Errno.Srch if it has none (nothing is
# current then).
pub fn fs_process_select(pid: u64) -> i32
    var slot: i32 = 0
    while slot < FS_MAX_PROCS
        let p: *FsProc = fs_procs[slot]
        if p != 0 as *FsProc and p.pid == pid
            fs_current = slot
            return 0
        slot = slot + 1
    fs_current = -1
    Errno.Srch as i32

# The pid fs_process_start gave the current process, or 0 if none.
pub fn fs_process_pid() -> u64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return 0
    p.pid

# The current process's mmap cursor (syscall/runtime/memory.ritz owns its
# meaning; 0 until it first sets one), or 0 if no process is current. It
# lives here because FsProc is the one per-process record the kernel keeps.
pub fn fs_process_mmap_next() -> u64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return 0
    p.mmap_next

# Set the current process's mmap cursor. Errno.Srch if none is current.
pub fn fs_process_set_mmap_next(addr: u64) -> i32
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i32
    (*p).mmap_next = addr
    0

# Processes with an fd table.
pub fn fs_process_count() -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < FS_MAX_PROCS
        if fs_procs[i] != 0 as *FsProc
            n = n + 1
        i = i + 1
    n

# ============================================================================
# sys_open - Open a file
# ============================================================================
#
# Arguments:
#   path_ptr: pointer to path string
#   path_len: length of path
#   flags: open flags (O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, etc.)
#
# Returns:
#   >= 0: file descriptor
#   < 0: error code

pub fn sys_open(path_ptr: *u8, path_len: u64, flags: i32) -> i64
    let p: *FsProc = fs_current_proc()
    if p == 0 as *FsProc
        return Errno.Srch as i64

    let path: StrView = StrView { ptr: path_ptr, len: path_len as i64 }

    # A path at or below /var lives in the persistent subtree's namespace
    # (fs/kfs.ritz, #4321): there it is "/x", not "/var/x", and it is what
    # the next boot loads. Everything else is the runtime tree.
    let ns: *Namespace = kfs_ns_for(path)
    if ns == 0 as *Namespace
        return Errno.Inval as i64
    let local: StrView = kfs_local(path)

    # Resolve the path to a blob ID
    var blob_id: BlobId = namespace_resolve(ns, local)

    # Check if file exists
    if blob_id_is_zero(@blob_id)
        # File doesn't exist
        if (flags & O_CREAT) != 0
            # Create the file with empty content
            var empty: u8 = 0
            let create_result: i32 = kfs_persist_write(path, @empty, 0)
            if create_result != 0
                return create_result as i64
            # Re-resolve to get the new blob ID
            blob_id = namespace_resolve(ns, local)
            if blob_id_is_zero(@blob_id)
                return Errno.NoEnt as i64
        else
            return Errno.NoEnt as i64

    # Allocate a file descriptor
    let fd: i32 = fd_alloc(@(*p).table)
    if fd < 0
        return fd as i64

    # Hold the blob while the fd is open: a rewrite or delete of the path
    # then can't free the bytes data_ptr points at (fs_close_file unholds).
    if not namespace_hold(ns, @blob_id)
        fd_free(@(*p).table, fd)
        return Errno.NoEnt as i64
    let store: *MemoryBlobStore = namespace_store(ns)
    let data_ptr: *u8 = memory_store_get(store, @blob_id)
    let size: u64 = memory_store_get_size(store, @blob_id)

    # Set up file state
    let f: *FsFile = @(*p).files[fd]
    (*f).ns = ns
    (*f).blob_id = blob_id_copy(@blob_id)
    (*f).data_ptr = data_ptr
    (*f).size = size
    (*f).position = 0
    (*f).flags = flags
    (*f).wbuf = 0 as *u8
    (*f).wbuf_size = 0
    (*f).wbuf_cap = 0
    (*f).path = 0 as *u8
    (*f).path_len = 0

    # O_TRUNC on a writable fd: the fd reads the file as empty from here, and
    # close commits its write buffer even if it is empty (fs_close_commits).
    if fs_truncates(flags)
        (*f).size = 0
        (*f).position = 0

    # Handle O_APPEND - position at end
    if (flags & O_APPEND) != 0
        (*f).position = size

    # Store path for write-back on close
    if (flags & O_WRONLY) != 0 or (flags & O_RDWR) != 0
        let copy: *u8 = kalloc(path_len + 1)
        if copy == 0 as *u8
            namespace_unhold(ns, @blob_id)
            fd_free(@(*p).table, fd)
            return Errno.NoMem as i64
        var i: u64 = 0
        while i < path_len
            *(copy + i) = *(path_ptr + i)
            i = i + 1
        *(copy + path_len) = 0
        (*f).path = copy
        (*f).path_len = path_len

    fd as i64

# ============================================================================
# sys_dup - A second fd for an open file
# ============================================================================
#
# The new fd shares fd's FsFile (see fs_file). Not in the syscall table: it
# is a kernel-internal helper with no dispatcher entry, so user space cannot
# reach it and it needs no boundary gate today. If it is ever wired, its
# handler must check CAP_TYPE_NAMESPACE (READ or WRITE), as SYS_CLOSE and
# SYS_LSEEK do, since duplicating an fd mutates the namespace-backed fd
# table (AGAST #4479).

pub fn sys_dup(fd: i32) -> i64
    let p: *FsProc = fs_current_proc()
    if fs_file(p, fd) == 0 as *FsFile
        return Errno.BadF as i64
    fd_dup(@(*p).table, fd) as i64

# ============================================================================
# sys_close - Close a file descriptor
# ============================================================================

pub fn sys_close(fd: i32) -> i64
    let p: *FsProc = fs_current_proc()
    if fs_file(p, fd) == 0 as *FsFile
        return Errno.BadF as i64
    fs_close_file(p, fd, CloseBy.Close) as i64

# Who closes an fd: the process's close(2), or its exit (fs_process_end).
# Only the first commits an O_TRUNC fd that wrote nothing.
enum CloseBy
    Close
    Exit

# Free fd. Its open file's state goes only with the file's last fd: then
# flush its pending writes and release it (0, or the flush's Errno). While
# other fds share it, it stays; if fd owned it, it moves to the fd that
# fd_free makes the new owner. Shared by sys_close and fs_process_end; `by`
# says which, for fs_close_commits.
fn fs_close_file(p: *FsProc, fd: i32, by: CloseBy) -> i32
    let owner_fd: i32 = fd_owner(@(*p).table, fd)
    if fd_refs(@(*p).table, fd) > 1
        if owner_fd == fd
            fs_file_move(@(*p).files[fd], @(*p).files[fd_heir(@(*p).table, fd)])
        fd_free(@(*p).table, fd)
        return 0
    let f: *FsFile = @(*p).files[owner_fd]
    # Whether closing this fd committed bytes to the persistent subtree, and
    # so owes the storage device a (debounced) save.
    let wrote: bool = fs_close_commits(f, by)
    let persist: bool = (*f).path != 0 as *u8 and kfs_is_persist(StrView { ptr: (*f).path, len: (*f).path_len as i64 })
    let flush_result: i32 = fs_flush_write_buffer(f, by)
    if (*f).path != 0 as *u8
        kfree((*f).path)
        (*f).path = 0 as *u8
        (*f).path_len = 0
    let ns: *Namespace = (*f).ns
    if ns != 0 as *Namespace
        namespace_unhold(ns, @(*f).blob_id)
    (*f).ns = 0 as *Namespace
    (*f).data_ptr = 0 as *u8
    (*f).position = 0
    fd_free(@(*p).table, fd)
    if wrote and persist and flush_result == KFS_OK
        kfs_save_later()
    flush_result

# Move an open file's state from one fd's slot to another's.
fn fs_file_move(src: *FsFile, dst: *FsFile)
    (*dst).ns = (*src).ns
    (*dst).blob_id = blob_id_copy(@(*src).blob_id)
    (*dst).data_ptr = (*src).data_ptr
    (*dst).size = (*src).size
    (*dst).position = (*src).position
    (*dst).flags = (*src).flags
    (*dst).wbuf = (*src).wbuf
    (*dst).wbuf_size = (*src).wbuf_size
    (*dst).wbuf_cap = (*src).wbuf_cap
    (*dst).path = (*src).path
    (*dst).path_len = (*src).path_len

# ============================================================================
# sys_read - Read from a file
# ============================================================================
#
# Arguments:
#   fd: file descriptor
#   buf: buffer to read into
#   count: number of bytes to read
#
# Returns:
#   >= 0: number of bytes read
#   < 0: error code

pub fn sys_fs_read(fd: i32, buf: *u8, count: u64) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64

    # Check read permission
    let flags: i32 = (*f).flags
    if (flags & O_WRONLY) != 0 and (flags & O_RDWR) == 0
        return Errno.BadF as i64  # Write-only, can't read

    let pos: u64 = (*f).position
    let size: u64 = (*f).size
    let data: *u8 = (*f).data_ptr

    # Calculate how much we can actually read
    var bytes_to_read: u64 = count
    if pos >= size
        return 0  # EOF
    if pos + bytes_to_read > size
        bytes_to_read = size - pos

    # Copy data to buffer
    var i: u64 = 0
    while i < bytes_to_read
        *(buf + i) = *(data + pos + i)
        i = i + 1

    # Update position
    (*f).position = pos + bytes_to_read

    bytes_to_read as i64

# ============================================================================
# sys_write - Write to a file
# ============================================================================
#
# For content-addressable storage, writes create new blobs: the data is
# buffered per fd and written back to the namespace on close (see "What close
# commits" below for when).

# Simple realloc implementation
fn krealloc(old_ptr: *u8, new_size: u64, old_size: u64) -> *u8
    if old_ptr == 0 as *u8
        return kalloc(new_size)
    let new_ptr: *u8 = kalloc(new_size)
    if new_ptr == 0 as *u8
        return 0 as *u8
    # Copy old data
    var copy_size: u64 = old_size
    if copy_size > new_size
        copy_size = new_size
    var i: u64 = 0
    while i < copy_size
        *(new_ptr + i) = *(old_ptr + i)
        i = i + 1
    kfree(old_ptr)
    new_ptr

pub fn sys_fs_write(fd: i32, buf: *u8, count: u64) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64

    # Check write permission
    let flags: i32 = (*f).flags
    if (flags & O_WRONLY) == 0 and (flags & O_RDWR) == 0
        return Errno.BadF as i64  # Read-only

    # Allocate write buffer if needed
    if (*f).wbuf == 0 as *u8
        (*f).wbuf = kalloc(WRITE_BUFFER_INITIAL)
        if (*f).wbuf == 0 as *u8
            return Errno.NoMem as i64
        (*f).wbuf_cap = WRITE_BUFFER_INITIAL
        (*f).wbuf_size = 0

    # Grow buffer if needed
    let new_size: u64 = (*f).wbuf_size + count
    if new_size > (*f).wbuf_cap
        var new_cap: u64 = (*f).wbuf_cap * 2
        if new_cap < new_size
            new_cap = new_size + 1024
        let new_buf: *u8 = krealloc((*f).wbuf, new_cap, (*f).wbuf_cap)
        if new_buf == 0 as *u8
            return Errno.NoMem as i64
        (*f).wbuf = new_buf
        (*f).wbuf_cap = new_cap

    # Copy data to buffer
    var i: u64 = 0
    let offset: u64 = (*f).wbuf_size
    while i < count
        *((*f).wbuf + offset + i) = *(buf + i)
        i = i + 1
    (*f).wbuf_size = new_size

    # Update position
    (*f).position = (*f).position + count

    count as i64

# ============================================================================
# What close commits (AGAST #4830)
# ============================================================================
#
# A write fd's bytes go to a per-fd buffer, whatever the file position, and
# the last close of the fd (sys_close, or fs_process_end at exit) replaces
# the whole file with that buffer. Close commits the buffer when
#
#   - any byte was written to the fd (on either path), or
#   - the fd was opened writable (O_WRONLY or O_RDWR) with O_TRUNC and the
#     process closed it with close(2): then an empty buffer commits an empty
#     file.
#
# Otherwise close leaves the file as it was: an fd opened for writing
# without O_TRUNC that writes nothing (or only zero-byte writes) does not
# truncate it, and neither does an O_TRUNC fd that wrote nothing and is
# closed by its process's exit. So write_file's O_WRONLY | O_CREAT | O_TRUNC
# open, zero-byte write and close empties the file, while a save killed (or
# exiting) between its open and its first write leaves the old file: old or
# new, never a prefix, the empty one included (BUDDHAFINGER_PROPOSAL.md
# §Harland).

# Whether open flags truncate: O_TRUNC on a writable open.
fn fs_truncates(flags: i32) -> bool
    (flags & O_TRUNC) != 0 and ((flags & O_WRONLY) != 0 or (flags & O_RDWR) != 0)

# Whether closing f's last fd, by `by`, replaces the file (the rule above).
fn fs_close_commits(f: *FsFile, by: CloseBy) -> bool
    if (*f).wbuf != 0 as *u8 and (*f).wbuf_size > 0
        return true
    match by
        CloseBy.Close => fs_truncates((*f).flags)
        CloseBy.Exit => false

# Commit f's write buffer to the namespace if fs_close_commits says so, and
# free it: 0, or an Errno that sys_close returns.
fn fs_flush_write_buffer(f: *FsFile, by: CloseBy) -> i32
    let commits: bool = fs_close_commits(f, by)
    let wbuf: *u8 = (*f).wbuf
    let wsize: u64 = (*f).wbuf_size
    (*f).wbuf = 0 as *u8
    (*f).wbuf_size = 0
    (*f).wbuf_cap = 0

    var result: i32 = 0
    if commits and (*f).path_len == 0
        result = Errno.Io as i32  # no path to write back to
    else if commits
        # Write back through the path routing: the runtime tree always, and
        # the persistent subtree too when the path is at or below /var (which
        # is the namespace the blob was held in). An fd that wrote nothing
        # has no buffer; its commit is the empty file.
        let path: StrView = StrView { ptr: (*f).path, len: (*f).path_len as i64 }
        var empty: u8 = 0
        var bytes: *u8 = @empty
        if wsize > 0
            bytes = wbuf
        result = kfs_persist_write(path, bytes, wsize)
    if wbuf != 0 as *u8
        kfree(wbuf)
    result

# ============================================================================
# sys_lseek - Seek in a file
# ============================================================================

pub const SEEK_SET: i32 = 0
pub const SEEK_CUR: i32 = 1
pub const SEEK_END: i32 = 2

pub fn sys_lseek(fd: i32, offset: i64, whence: i32) -> i64
    let f: *FsFile = fs_file(fs_current_proc(), fd)
    if f == 0 as *FsFile
        return Errno.BadF as i64

    let size: u64 = (*f).size
    var new_pos: i64

    if whence == SEEK_SET
        new_pos = offset
    else if whence == SEEK_CUR
        new_pos = (*f).position as i64 + offset
    else if whence == SEEK_END
        new_pos = size as i64 + offset
    else
        return Errno.Inval as i64

    if new_pos < 0
        return Errno.Inval as i64

    (*f).position = new_pos as u64
    new_pos

# ============================================================================
# sys_mkdir - Create a directory
# ============================================================================

pub fn sys_mkdir(path_ptr: *u8, path_len: u64) -> i64
    if kfs_get() == 0 as *Namespace
        return Errno.Inval as i64
    let path: StrView = StrView { ptr: path_ptr, len: path_len as i64 }
    let result: i32 = kfs_persist_mkdir(path)
    if result == KFS_OK and kfs_is_persist(path)
        kfs_save_later()
    result as i64

# ============================================================================
# fs_sync - Flush the persistent subtree to the storage device
# ============================================================================
#
# Save-on-close is debounced (kfs_save_later, #4321), so a program that needs
# its /var writes on disk before it returns to some other work calls Sync.
# Unconditional: whatever the debounce deferred is written now. 0 or an Errno.
pub fn fs_sync() -> i32
    kfs_save()

# ============================================================================
# Check if fd is a filesystem fd
# ============================================================================

# FDs 0, 1, 2 are stdin/stdout/stderr (serial), never filesystem fds.
pub fn is_fs_fd(fd: i32) -> bool
    fs_file(fs_current_proc(), fd) != 0 as *FsFile
