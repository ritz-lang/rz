# Initramfs Loader
#
# Loads the initial filesystem from a TAR archive: the one BOOTX64.EFI read
# from the ESP and handed over in BootInfo (AGAST #4253: EC2 Nitro and laptops
# have no virtio-blk), else the raw TAR on the first VirtIO block device.
# This is required for boot - if the initramfs cannot be loaded, the kernel panics.
#
# The TAR archive contains:
#   /bin/init        - First userspace process (ELF)
#   /etc/hostname    - System hostname
#   /etc/motd        - Message of the day
#   ... other files

import serial { StrView, prints, serial_print_dec }
import io { halt_loop }
import fs.kfs { KFS_OK, kfs_get, kfs_mkdir, kfs_write }
import goliath.namespace { Namespace }
import syscall.errno { Errno }
import ritzlib.strview { strview_from_ptr }
import fs.tar { TarEntry, TAR_ENTRY_SIZE, TAR_BLOCK_SIZE, TAR_TYPE_FILE, TAR_TYPE_FILE_ALT, TAR_TYPE_DIRECTORY, tar_parse_header, tar_data_blocks }
import drivers.virtio.blk { VirtioBlkDevice, virtio_blk_get_device, virtio_blk_read }
import mm.heap { kalloc, kfree }

# ============================================================================
# Configuration
# ============================================================================

# Maximum file size we'll load from TAR (prevent memory exhaustion)
const MAX_FILE_SIZE: u64 = 4194304   # 4 MB

# Read buffer size (must be multiple of 512)
const READ_BUFFER_SECTORS: u32 = 7   # 3584 bytes per read
const READ_BUFFER_SIZE: u64 = 3584   # 7 * 512

# Attempts per virtio read before the load gives up (transient errors)
const READ_ATTEMPTS: i32 = 3

# The TAR the bootloader loaded (a kernel-virtual address) and its size, or
# 0/0. When set, every sector read comes from it instead of virtio-blk.
var g_boot_image: *u8 = 0 as *u8
var g_boot_image_size: u64 = 0

# ============================================================================
# Public API
# ============================================================================

# Use the TAR at kernel-virtual address `image` (`size` bytes) that the
# bootloader read from the ESP, instead of a virtio-blk disk. Call before
# initramfs_load.
pub fn initramfs_set_boot_image(image: u64, size: u64)
    g_boot_image = image as *u8
    g_boot_image_size = size

# Load the initramfs: from the boot image if initramfs_set_boot_image gave
# one, else from the first VirtIO disk.
# Panics if the initramfs cannot be loaded - this is a fatal boot error.
pub fn initramfs_load() -> i32
    let result: i32 = initramfs_load_from_disk()
    if result != 0
        prints("\n*** KERNEL PANIC: Failed to load initramfs ***\n" as StrView)
        prints("    Error code: " as StrView)
        serial_print_dec(result as u64)
        prints("\n" as StrView)
        prints("    Cannot continue without root filesystem.\n" as StrView)
        prints("    Put harland/initramfs.tar on the ESP, load it with GRUB module2, or attach a VirtIO disk holding the TAR.\n\n" as StrView)
        halt_loop()
    result

# ============================================================================
# Load from VirtIO Disk
# ============================================================================

# Load initramfs from the boot image, else the first VirtIO block device.
# Either holds a raw TAR archive (no partition table), read in 512-byte sectors.
fn initramfs_load_from_disk() -> i32
    var dev: *VirtioBlkDevice = 0 as *VirtioBlkDevice
    if g_boot_image == 0 as *u8
        dev = virtio_blk_get_device()
        if dev == 0 as *VirtioBlkDevice
            prints("[initramfs] No boot image and no VirtIO block device\n" as StrView)
            return -1

    let ns: *Namespace = kfs_get()
    if ns == 0 as *Namespace
        prints("[initramfs] No namespace\n" as StrView)
        return -2

    if g_boot_image != 0 as *u8
        prints("[initramfs] Loading from boot memory (" as StrView)
        serial_print_dec(g_boot_image_size)
        prints(" bytes)...\n" as StrView)
    else
        prints("[initramfs] Loading from VirtIO disk...\n" as StrView)

    # Allocate read buffer
    let read_buf: *u8 = kalloc(READ_BUFFER_SIZE) as *u8
    if read_buf == 0 as *u8
        prints("[initramfs] Failed to allocate read buffer\n" as StrView)
        return -3

    var sector: u64 = 0              # Current sector in archive
    var entries_loaded: i32 = 0
    var empty_blocks: i32 = 0        # Count consecutive empty blocks

    # Read loop - process TAR entries
    while empty_blocks < 2
        # Read one TAR header block (512 bytes = 1 sector)
        let result: i32 = read_with_retry(dev, sector, 1, read_buf)
        if result != 0
            prints("[initramfs] Read error at sector " as StrView)
            serial_print_dec(sector)
            prints("\n" as StrView)
            kfree(read_buf)
            return -4

        # Parse TAR header
        var entry: TarEntry
        let parse_result: i32 = tar_parse_header(read_buf, @entry)

        if parse_result == -1
            # Empty block (end marker)
            empty_blocks = empty_blocks + 1
            sector = sector + 1
            continue
        else if parse_result < 0
            # Invalid header
            prints("[initramfs] Invalid TAR header at sector " as StrView)
            serial_print_dec(sector)
            prints("\n" as StrView)
            kfree(read_buf)
            return -5

        # Reset empty block counter
        empty_blocks = 0

        # Calculate data blocks
        entry.data_offset = (sector + 1) * 512  # Data starts after header
        let data_blocks: u64 = tar_data_blocks(entry.size)

        # Process entry based on type
        if entry.entry_type == TAR_TYPE_DIRECTORY
            # Create directory
            let path: StrView = strview_from_ptr(@entry.name[0], entry.name_len as i64)
            process_directory(ns, @path)

        else if entry.entry_type == TAR_TYPE_FILE or entry.entry_type == TAR_TYPE_FILE_ALT
            # Load file
            if entry.size <= MAX_FILE_SIZE
                let load_result: i32 = load_file_from_tar(dev, ns, @entry, sector + 1)
                if load_result == 0
                    entries_loaded = entries_loaded + 1

        # Move to next entry
        sector = sector + 1 + data_blocks

    kfree(read_buf)

    prints("[initramfs] Loaded " as StrView)
    serial_print_dec(entries_loaded as u64)
    if g_boot_image != 0 as *u8
        prints(" files from boot memory\n" as StrView)
    else
        prints(" files from disk\n" as StrView)

    if entries_loaded > 0
        return 0
    else
        return -6  # No files loaded

# ============================================================================
# Internal Helpers
# ============================================================================

# Convert TAR path "./foo/bar" to absolute path "/foo/bar"
# Returns the path length (or 0 if path is root)
fn tar_to_absolute_path(tar_path: *StrView, out_buf: *u8, max_len: i64) -> i64
    var start: i64 = 0
    var len: i64 = (*tar_path).len

    # Skip leading "./" if present (skip both the '.' and '/')
    if len >= 2 and *((*tar_path).ptr) == 46 and *((*tar_path).ptr + 1) == 47
        start = 2  # Skip "./"
        len = len - 2

    # Remove trailing slash if present
    while len > 0 and *((*tar_path).ptr + start + len - 1) == 47
        len = len - 1

    # After stripping, empty or "." means root
    if len == 0 or (len == 1 and *((*tar_path).ptr + start) == 46)
        return 0  # Root path

    # Build the path with leading /
    *out_buf = 47  # '/'

    var i: i64 = 0
    while i < len and i < max_len - 2
        *(out_buf + 1 + i) = *((*tar_path).ptr + start + i)
        i = i + 1
    *(out_buf + 1 + i) = 0

    i + 1

# Load a file's data from TAR archive
fn load_file_from_tar(dev: *VirtioBlkDevice, ns: *Namespace, entry: *TarEntry, data_sector: u64) -> i32
    let size: u64 = (*entry).size

    # Convert TAR path to absolute path
    var abs_path_buf: [256]u8
    let tar_path: StrView = strview_from_ptr(@(*entry).name[0], (*entry).name_len as i64)
    let abs_len: i64 = tar_to_absolute_path(@tar_path, @abs_path_buf[0], 256)

    if abs_len == 0
        return 0  # Skip root entry

    let abs_path: StrView = strview_from_ptr(@abs_path_buf[0], abs_len)

    if size == 0
        # Empty file
        let empty: u8 = 0
        var empty_result: i32 = kfs_write(ns, abs_path, @empty as *u8, 0)
        if empty_result == Errno.NoEnt as i32
            ensure_parent_dirs(ns, @abs_path_buf[0], abs_len)
            empty_result = kfs_write(ns, abs_path, @empty as *u8, 0)
        return empty_result

    # Allocate buffer for file contents - round up to sector boundary
    # because virtio_blk_read copies whole sectors (512 bytes)
    var alloc_size: u64 = ((size + 511) / 512) * 512
    if alloc_size == 0
        alloc_size = 512

    let file_buf: *u8 = kalloc(alloc_size) as *u8
    if file_buf == 0 as *u8
        prints("[initramfs] kalloc failed for size=" as StrView)
        serial_print_dec(alloc_size)
        prints("\n" as StrView)
        return Errno.NoSpc as i32

    # Read file data sector by sector
    var bytes_read: u64 = 0
    var current_sector: u64 = data_sector
    while bytes_read < size
        # Calculate how many sectors to read (max 7 at a time due to DMA buffer)
        let remaining: u64 = size - bytes_read
        var sectors_to_read: u32 = 7
        if remaining < 3584
            sectors_to_read = ((remaining + 511) / 512) as u32
            if sectors_to_read == 0
                sectors_to_read = 1

        # Read sectors
        let result: i32 = read_with_retry(dev, current_sector, sectors_to_read, file_buf + bytes_read as i64)
        if result != 0
            prints("[initramfs] VirtIO read error at sector " as StrView)
            serial_print_dec(current_sector)
            prints(" result=" as StrView)
            serial_print_dec(result as u64)
            prints("\n" as StrView)
            kfree(file_buf)
            return Errno.Io as i32

        bytes_read = bytes_read + (sectors_to_read as u64 * 512)
        current_sector = current_sector + sectors_to_read as u64

    # Create file in namespace. A TAR may list a file before its directory,
    # or never list the directory: create the parents and retry once.
    var write_result: i32 = kfs_write(ns, abs_path, file_buf, size)
    if write_result == Errno.NoEnt as i32
        ensure_parent_dirs(ns, @abs_path_buf[0], abs_len)
        write_result = kfs_write(ns, abs_path, file_buf, size)
    kfree(file_buf)

    if write_result != KFS_OK
        prints("[initramfs] kfs_write failed for " as StrView)
        prints(abs_path)
        prints(" error=" as StrView)
        serial_print_dec(write_result as u64)
        prints("\n" as StrView)

    write_result

# Process a directory entry
# TAR paths are like "./var/log/" - we need to convert to "/var/log"
fn process_directory(ns: *Namespace, path: *StrView) -> i32
    var abs_path_buf: [256]u8
    let abs_len: i64 = tar_to_absolute_path(path, @abs_path_buf[0], 256)

    if abs_len == 0
        return 0  # Root directory, nothing to create

    let abs_path: StrView = strview_from_ptr(@abs_path_buf[0], abs_len)
    kfs_mkdir(ns, abs_path)

# Read `count` sectors, retrying up to READ_ATTEMPTS times so one transient
# virtio error doesn't fail the boot. Returns 0 or the last error.
# With a boot image, copies from it instead (see read_boot_image).
fn read_with_retry(dev: *VirtioBlkDevice, sector: u64, count: u32, buf: *u8) -> i32
    if g_boot_image != 0 as *u8
        return read_boot_image(sector, count, buf)
    var result: i32 = -1
    var attempt: i32 = 0
    while attempt < READ_ATTEMPTS
        result = virtio_blk_read(dev, sector, count, buf)
        if result == 0
            return 0
        attempt = attempt + 1
    result

# Copy `count` 512-byte sectors from sector `sector` of the boot image into
# buf. Bytes past the image's end read as zero: an archive cut short of its
# two all-zero end blocks (or of its 10 KiB record padding) then ends where
# its data does, as a disk past the TAR would read. Always returns 0.
fn read_boot_image(sector: u64, count: u32, buf: *u8) -> i32
    let offset: u64 = sector * 512
    let want: u64 = count as u64 * 512
    var avail: u64 = 0
    if offset < g_boot_image_size
        avail = g_boot_image_size - offset
    if avail > want
        avail = want
    var i: u64 = 0
    while i < avail
        *(buf + i as i64) = *(g_boot_image + (offset + i) as i64)
        i = i + 1
    while i < want
        *(buf + i as i64) = 0
        i = i + 1
    0

# Create every missing ancestor directory of the absolute path `path`
# (len bytes), outermost first. Stops at the first mkdir that fails for a
# reason other than the directory already existing.
fn ensure_parent_dirs(ns: *Namespace, path: *u8, len: i64)
    var i: i64 = 1
    while i < len
        if *(path + i) == 47
            let r: i32 = kfs_mkdir(ns, strview_from_ptr(path, i))
            if r != KFS_OK and r != Errno.Exist as i32
                return
        i = i + 1
