# Harland Microkernel - Main Entry Point
#
# This is the kernel entry point, called by the bootloader after
# setting up the initial page tables and passing boot information.
#
# kernel_main runs the init phases below in order, then the boot-test mode
# self-tests (AGAST #1887), SYSCALL setup, the boot-test process tests
# (#4712) and the post-init diagnostics, and starts /bin/init.
# Hardware access lives in arch/, drivers/ and io.ritz; this file has none.

# ============================================================================
# Module Imports
# ============================================================================
#
# Base modules are compiled separately and linked together.
# Import makes their symbols available (creates external declarations).

import io { halt_loop }
import serial { StrView, serial_start, serial_enable_rx }
import drivers.pci { pci_init, pci_init_segments }
import drivers.acpi.tables { acpi_find_table, ACPI_SIG_MCFG }
import boot_abi.handoff { HARLAND_BOOT_MAGIC, HARLAND_BOOT_VERSION_INITRAMFS, HARLAND_BOOT_VERSION_FLAGS, HARLAND_BOOT_FLAG_NET_SELFTEST, HARLAND_BOOT_FLAG_NET_RESPONDER, HARLAND_BOOT_FLAG_KLOG_DUMP, HARLAND_BOOT_FLAG_BOOT_TEST, HARLAND_BOOT_FLAG_NETD_RESTART, HARLAND_BOOT_FLAG_PANIC_TEST, HARLAND_BOOT_FLAG_STORAGE_FORMAT, HarlandMemEntry, HarlandBootInfo }
import mm.pmm { PAGE_SIZE, Mb2BootInfo, Mb2ModuleTag, mb2_find_module, BOOT_PROTOCOL_UNKNOWN, BOOT_PROTOCOL_MULTIBOOT2, BOOT_PROTOCOL_HARLAND, pmm_mark_region_used, pmm_init_from_multiboot, pmm_init_from_bootinfo, pmm_reserve_kernel, pmm_log_stats }
import mm.vmm { vmm_init, vmm_flush_tlb_all, vmm_reserve_page_tables, vmm_init_physmap, vmm_pml4_phys, phys_to_virt }
import mm.heap { KERNEL_VIRT_BASE, kheap_init, heap_get_used, heap_check }
# mm.dma is WIP: no production importer yet. It stays live through
# test/test_dma.ritz (#4427) and is allowlisted in tools/check_liveness.py.
# import mm.dma { DmaRegion, dma_alloc, dma_free, ... }
