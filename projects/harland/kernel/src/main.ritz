import arch.x86_64.gdt { gdt_init }
import arch.x86_64.idt { idt_init }
import arch.x86_64.tsc { tsc_calibrate }


# ============================================================================
# BSS Section Clearing
# ============================================================================
#
# The ELF loader in the bootloader should zero the BSS segment (memory beyond
# file size), but some systems or configurations may not do this correctly.
# We explicitly zero BSS at kernel entry to ensure all static variables start
# with known values.

# Linker-provided BSS boundaries: data symbols whose address is the
# information (LANGUAGE_SPEC §5.3).
extern var __bss_start: u8
extern var __bss_end: u8
# End of the whole image (.bss included), page-aligned, in the higher half.
extern var __kernel_virt_end: u8

# Physical end of the kernel image: linked at KERNEL_VIRT_BASE + phys. pmm
# reserves up to here (#2755); the image outgrew a fixed 1..2 MiB window.
fn kernel_phys_end() -> u64
    return @__kernel_virt_end as u64 - KERNEL_VIRT_BASE

# Clear BSS section - MUST be called before using any BSS variables
fn clear_bss()
    # Get BSS boundaries from linker symbols
    let bss_start: u64 = @__bss_start as u64
    let bss_end: u64 = @__bss_end as u64

    var p: *u8 = bss_start as *u8
    while (p as u64) < bss_end
        *p = 0
        p = (p as u64 + 1) as *u8

# ============================================================================
# Kernel Logging (klog.ritz) and Post-Init Self-Tests (postinit.ritz)
# ============================================================================
#
# The early-boot ring buffer and klog helpers live in klog.ritz; the
# self-tests and diagnostics kernel_main runs after init live in
# postinit.ritz (AGAST #2752).
# Stack canaries (AGAST #2590): nothing calls these by name; the
# instrumented prologues and epilogues reference them. A bare import keeps
# the module linked without naming symbols main.ritz never uses (#3458).
import stack_protector
# ritzlib's platform hooks (#1881): ritzlib's core, which goliath uses, calls
# them by name, so they too are linked by a bare import.
import platform
import klog { ring_clear, ring_dump, klog_banner, klog, klog_dec, klog_hex, klog_irqsave }
import postinit { boot_self_tests, boot_process_tests, postinit_diagnostics }
import boot_options { mb2_cmdline_flags }

# ============================================================================
# Boot Protocol State (global runtime detection)
# ============================================================================

var boot_protocol: u32 = 0  # BOOT_PROTOCOL_UNKNOWN
var harland_boot_info: *HarlandBootInfo = 0 as *HarlandBootInfo

# HARLAND_BOOT_FLAG_* boot options, from HarlandBootInfo.flags (version 3 and
# later) or the multiboot2 cmdline's words (boot_options.ritz, AGAST #1887).
var boot_flags: u32 = 0

fn boot_option(flag: u32) -> bool
    return (boot_flags & flag) != 0

# Framebuffer from either boot protocol, captured at boot-protocol detection
# (the multiboot2 info isn't reserved in the PMM, so the heap may reuse it).
# boot_fb_addr == 0 means headless.
var boot_fb_addr: u64 = 0
var boot_fb_width: u32 = 0
var boot_fb_height: u32 = 0
var boot_fb_pitch: u32 = 0
var boot_fb_bpp: u8 = 0
var boot_fb_format: u8 = 0

# Copy the multiboot2 framebuffer tag (type 8) into boot_fb_*, #2143.
fn capture_mb2_framebuffer(mb_info_addr: u64)
    let tag_addr: u64 = mb2_find_fb_tag(mb_info_addr)
    if tag_addr == 0
        klog("      Multiboot2: no framebuffer tag\n")
        return
    let tag: *Mb2FramebufferTag = tag_addr as *Mb2FramebufferTag
    if (*tag).size < MB2_FB_TAG_RGB_MIN_SIZE
        klog("      Multiboot2: framebuffer tag too short\n")
        return
    let format: u8 = mb2_fb_format((*tag).fb_type, (*tag).bpp, (*tag).red_pos, (*tag).green_pos, (*tag).blue_pos)
    if format == PIXEL_FORMAT_UNSUPPORTED
        klog("      Multiboot2: unsupported framebuffer type ")
        klog_dec((*tag).fb_type as i64)
        klog(" bpp ")
        klog_dec((*tag).bpp as i64)
        klog("\n")
        return
    boot_fb_addr = (*tag).addr
    boot_fb_width = (*tag).width
    boot_fb_height = (*tag).height
    boot_fb_pitch = (*tag).pitch
    boot_fb_bpp = (*tag).bpp
    boot_fb_format = format

# ============================================================================
# Exception and IRQ Handlers
# ============================================================================
#
# GDT and IDT are now in arch/x86_64/gdt.ritz and arch/x86_64/idt.ritz
# Exception handlers are in arch/x86_64/exceptions.ritz
# Imported above: InterruptFrame, exception_handler, irq_handler, exception_name, print_stack_trace
#
# PIC remap/disable, Local APIC, I/O APIC and AP bootstrap are in
# arch/x86_64/apic.ritz

# External assembly function: enter user mode (run_init)
extern fn jump_to_userspace(entry: u64, stack: u64)

# ============================================================================
# Syscall Interface
# ============================================================================
#
# The syscall handlers, their sys_*_impl bodies and the dispatch-table fill
# live in syscall/runtime/<area>.ritz (AGAST #2751); syscall/runtime/entry.ritz
# sets up SYSCALL and is what syscall_entry.s calls.
import syscall.runtime.entry { syscall_init, syscall_register_smp_test }
import syscall.runtime.memory { alloc_user_stack }
import syscall.runtime.process { process_enter_init }
import proc.table { Proc, proc_current }
import net.ring1 { net_ring1_boot, net_ring1_spawn, net_seat_handoff, net_netd_restart_test, net_latency_netd_window }

# Run /bin/init from the filesystem as PID 1
# This is the actual init process that runs tests and triggers shutdown.
fn run_init() -> i32
    klog("[init] Loading /bin/init from filesystem...\n")

    # Get filesystem namespace
    let ns: *Namespace = kfs_get()
    if ns == 0 as *Namespace
        klog("[init] No namespace!\n")
        return -1

    # Read /bin/init
    let path: StrView = "/bin/init" as StrView
    var file_size: u64 = 0
    let elf_data: *u8 = kfs_read(ns, path, @file_size)

    if elf_data == 0 as *u8
        klog("[init] /bin/init not found in filesystem\n")
        return -1

    klog("[init] Found /bin/init, size=")
    klog_dec(file_size)
    klog(" bytes\n")

    let load_result: ElfLoadResult = elf_load(elf_data, file_size, USER_IMAGE_BASE)

    if load_result.error != ElfStatus.Ok
        klog("[init] ELF load failed, error=")
        klog_dec(elf_status_code(load_result.error))
        klog("\n")
        return -1

    klog("[init] Loaded at entry=0x")
    klog_hex(load_result.entry_point)
    klog("\n")

    # Allocate 64KB user stack (16 pages)
    let user_stack_top: u64 = alloc_user_stack()
    if user_stack_top == 0
        klog("[init] Failed to allocate user stack!\n")
        return -1

    # Flush TLB for new mappings
    vmm_flush_tlb_all()

    klog("[init] Starting init process...\n\n")

    # Set up as init process (PID 1), with its own fd table (#2753). On a
    # ring-1 boot pid 1 already exists, the virtio-net driver beside it,
    # and the scheduler runs (net/ring1.ritz): no table reset, which would
    # free the driver's slot, and no second sched_start (AGAST #4735).
    if proc_current() == 0 as *Proc
        process_enter_init()

    # Jump to userspace - this will not return until init exits
    jump_to_userspace(load_result.entry_point, user_stack_top)

    # Should not reach here - init should call ACPI poweroff
    klog("[init] Init returned unexpectedly\n")
    return 0

# ============================================================================
# Init Phases (AGAST #1887: kernel_main is their sequence)
# ============================================================================

# The kernel heap's first mapping: 256 KiB. kalloc grows it on demand, under
# whichever CR3 is loaded: it is in the kernel half every address space
# shares (#2761).
const KHEAP_INITIAL_PAGES: u64 = 64
const BYTES_PER_KIB: u64 = 1024

# The multiboot2 disk holding the goliath image: the second virtio-blk device
const STORAGE_BLK_INDEX: i32 = 1

# Detect the boot protocol from the first u32 at boot_info_addr: Harland's
# UEFI loader writes HARLAND_BOOT_MAGIC ("HARL") there, a multiboot2 info
# block its (small) total_size. Takes the boot options and framebuffer from
# whichever it is.
fn detect_boot_protocol(boot_info_addr: u64)
    klog("Boot info at: ")
    klog_hex(boot_info_addr)
    klog("\n")
    if boot_info_addr == 0
        boot_protocol = BOOT_PROTOCOL_UNKNOWN
        klog("Boot protocol: Unknown (no boot info)\n")
        return
    if *(boot_info_addr as *u32) != HARLAND_BOOT_MAGIC
        boot_protocol = BOOT_PROTOCOL_MULTIBOOT2
        klog("Boot protocol: Multiboot2 (BIOS/GRUB)\n")
        boot_flags = mb2_cmdline_flags(boot_info_addr)
        capture_mb2_framebuffer(boot_info_addr)
        return
    boot_protocol = BOOT_PROTOCOL_HARLAND
    harland_boot_info = boot_info_addr as *HarlandBootInfo
    klog("Boot protocol: Harland (UEFI)\n")
    # An older loader's BootInfo has no flags field: leave the options off
    if (*harland_boot_info).version >= HARLAND_BOOT_VERSION_FLAGS
        boot_flags = (*harland_boot_info).flags
    boot_fb_addr = (*harland_boot_info).framebuffer_addr
    boot_fb_width = (*harland_boot_info).framebuffer_width
    boot_fb_height = (*harland_boot_info).framebuffer_height
    boot_fb_pitch = (*harland_boot_info).framebuffer_pitch
    boot_fb_bpp = (*harland_boot_info).framebuffer_bpp
    boot_fb_format = (*harland_boot_info).framebuffer_format

fn init_cpu_tables()
    klog("  [..] GDT")
    gdt_init()
    klog("\r  [OK] GDT\n")
    # Remap the PIC out of the exception vectors until the APIC replaces it
    pic_remap()
    klog("  [..] IDT")
    idt_init()
    klog("\r  [OK] IDT\n")
    # Calibrate the TSC before anything waits on it (AP startup, drivers)
    tsc_calibrate()

# The UEFI loader may place the kernel and its boot structures outside the
# legacy 1-2MB window: reserve them before anything allocates (#2749). The
# initramfs BOOTX64.EFI read from the ESP keeps its pages until
# initramfs_load has unpacked it (AGAST #4253).
fn reserve_harland_boot_regions(boot_info_addr: u64)
    let info: *HarlandBootInfo = harland_boot_info
    pmm_mark_region_used((*info).kernel_phys, (*info).kernel_size)
    pmm_mark_region_used((*info).pml4_phys, PAGE_SIZE)
    pmm_mark_region_used(boot_info_addr, PAGE_SIZE)
    let mmap_entries: u64 = (*info).memory_map_entries as u64
    if mmap_entries > 0 and (*info).memory_map != 0 as *HarlandMemEntry
        pmm_mark_region_used((*info).memory_map as u64, mmap_entries * sizeof(HarlandMemEntry) as u64)
    if (*info).version >= HARLAND_BOOT_VERSION_INITRAMFS and (*info).initramfs_size > 0
        pmm_mark_region_used((*info).initramfs_phys, (*info).initramfs_size)

# apic_init_with_mb reads the multiboot2 info block long after the first
# allocation, and the initramfs GRUB loaded as a module (`module2
# /boot/initramfs.tar`, AGAST #4258) must survive until initramfs_load: keep
# both out of the pool.
fn reserve_mb2_boot_regions(boot_info_addr: u64)
    let mb_info: *Mb2BootInfo = boot_info_addr as *Mb2BootInfo
    pmm_mark_region_used(boot_info_addr, (*mb_info).total_size as u64)
    let mb_mod: *Mb2ModuleTag = mb2_find_module(mb_info)
    if mb_mod != 0 as *Mb2ModuleTag
        pmm_mark_region_used((*mb_mod).mod_start as u64, ((*mb_mod).mod_end - (*mb_mod).mod_start) as u64)

# The bitmap is carved out of RAM below 1 GiB, sized from the memory map's
# highest usable address (AGAST #4183); pmm_ok is false when it can't be.
fn init_physical_memory(boot_info_addr: u64)
    klog("  [..] Physical memory")
    var pmm_ok: bool = false
    if boot_protocol == BOOT_PROTOCOL_HARLAND
        pmm_ok = pmm_init_from_bootinfo(harland_boot_info, kernel_phys_end()) == 0
        pmm_reserve_kernel(kernel_phys_end())
        reserve_harland_boot_regions(boot_info_addr)
    else if boot_protocol == BOOT_PROTOCOL_MULTIBOOT2
        pmm_ok = pmm_init_from_multiboot(boot_info_addr as *Mb2BootInfo, kernel_phys_end()) == 0
        pmm_reserve_kernel(kernel_phys_end())
        reserve_mb2_boot_regions(boot_info_addr)
    if boot_protocol == BOOT_PROTOCOL_UNKNOWN
        klog("\r  [!!] Physical memory (no boot info)\n")
        return
    if pmm_ok
        klog("\r  [OK] Physical memory\n")
    else
        klog("\r  [!!] Physical memory (no bitmap)\n")
    pmm_log_stats()

# The VMM, then the kernel heap. The page tables are reserved in the PMM
# before kheap_init allocates through it, and again after, since mapping the
# heap creates new tables (#2749).
fn init_virtual_memory(boot_info_addr: u64)
    klog("  [..] Virtual memory")
    vmm_init()
    klog("\r  [OK] Virtual memory\n")
    klog("      PML4 at: ")
    klog_hex(vmm_pml4_phys())
    klog("\n")
    vmm_reserve_page_tables()
    # Direct map of RAM for page-table access (AGAST #3530). First pmm
    # allocations after the reserve are low pages the boot identity map covers.
    if vmm_init_physmap() != 0
        klog("  [!!] Physmap (page tables above 1 GiB unreachable)\n")
    else if boot_protocol == BOOT_PROTOCOL_HARLAND
        # The identity map now stops at 4 GiB, and firmware may have put
        # BootInfo above it (AGAST #4183): reach it through the physmap.
        harland_boot_info = phys_to_virt(boot_info_addr) as *HarlandBootInfo
    klog("  [..] Kernel heap")
    if kheap_init(KHEAP_INITIAL_PAGES) == 0
        klog("\r  [OK] Kernel heap\n")
        klog("      Size: ")
        klog_dec(heap_get_used() / BYTES_PER_KIB)
        klog(" KB\n")
    else
        klog("\r  [!!] Kernel heap (init failed)\n")
    vmm_reserve_page_tables()

fn init_display()
    if boot_fb_addr == 0
        return
    klog("  [..] Display driver")
    if display_init(boot_fb_addr, boot_fb_width, boot_fb_height, boot_fb_pitch, boot_fb_bpp, boot_fb_format) != 0
        klog("\r  [..] Display driver (headless mode)\n")
        return
    klog("\r  [OK] Display driver\n")
    klog("      Resolution: ")
    klog_dec(boot_fb_width as i64)
    klog("x")
    klog_dec(boot_fb_height as i64)
    klog("\n")
    display_console_start()

# A corrupt heap is not survivable: everything after it allocates. Halt with
# the stage it was found after (heap_check logs the bad block's address).
fn heap_check_or_panic(stage: StrView)
    if heap_check() == 0
        return
    klog("\n*** KERNEL PANIC ***\n")
    klog("kernel heap corrupt after ")
    klog(stage)
    klog("\n")
    halt_loop()

# VFS, PCI (early: the block device needs it), the VirtIO input and block
# devices (the block device holds the initramfs).
fn init_devices()
    klog("  [..] VFS layer")
    vfs_init()
    klog("\r  [OK] VFS layer\n")
    heap_check_or_panic("vfs_init")
    klog("  [..] PCI enumeration (early)")
    pci_init()
    klog("\r  [OK] PCI enumeration (early)\n")
    heap_check_or_panic("pci_init")
    klog("  [..] VirtIO input device")
    if virtio_input_init() == 0
        klog("\r  [OK] VirtIO input device\n")
    else
        klog("\r  [..] VirtIO input device (not found)\n")
    klog("  [..] VirtIO block device")
    if virtio_blk_init() != 0 as *VirtioBlkDevice
        klog("\r  [OK] VirtIO block device\n")
    else
        klog("\r  [..] VirtIO block device (not found)\n")
    heap_check_or_panic("virtio_blk_init")

# The initial filesystem: the TAR BOOTX64.EFI read from the ESP if BootInfo
# carries one (AGAST #4253), or GRUB's multiboot2 module (#4258), else a
# virtio-blk TAR disk. The kernel heap grows to fit it.
fn load_initial_filesystem(boot_info_addr: u64)
    if boot_protocol == BOOT_PROTOCOL_HARLAND and (*harland_boot_info).version >= HARLAND_BOOT_VERSION_INITRAMFS
        if (*harland_boot_info).initramfs_size > 0
            initramfs_set_boot_image(phys_to_virt((*harland_boot_info).initramfs_phys), (*harland_boot_info).initramfs_size)
    if boot_protocol == BOOT_PROTOCOL_MULTIBOOT2
        let boot_mod: *Mb2ModuleTag = mb2_find_module(boot_info_addr as *Mb2BootInfo)
        if boot_mod != 0 as *Mb2ModuleTag
            initramfs_set_boot_image(phys_to_virt((*boot_mod).mod_start as u64), ((*boot_mod).mod_end - (*boot_mod).mod_start) as u64)
    klog("  [..] Initial filesystem")
    initramfs_load()
    klog("\r  [OK] Initial filesystem\n")

# The kernel namespace is goliath (fs/kfs.ritz, AGAST #1881). The second
# block device holds its image: it comes up first so the namespace starts
# from the tree the last boot saved, then this boot is counted in /var/boots
# and saved, and only then does the initial filesystem load on top (so the
# image holds what was written, not the initramfs).
fn init_namespace(boot_info_addr: u64)
    let storage_dev: *VirtioBlkDevice = virtio_blk_init_nth(STORAGE_BLK_INDEX)
    klog("  [..] Kernel namespace")
    if kfs_init(storage_dev, boot_option(HARLAND_BOOT_FLAG_STORAGE_FORMAT)) != 0
        klog("\r  [!!] Kernel namespace (out of memory)\n")
        return
    klog("\r  [OK] Kernel namespace (goliath)\n")
    heap_check_or_panic("kfs_init")
    kfs_boot(storage_dev)
    klog("  [..] Filesystem syscalls")
    fs_syscall_init()
    klog("\r  [OK] Filesystem syscalls\n")
    load_initial_filesystem(boot_info_addr)

# The APIC (which reads the MADT, so num_cpus is known afterwards), the PCI
# segments past 0 through the MCFG's ECAM (AGAST #4582: needs the ACPI
# tables, and runs before any driver that looks for an MSI-X device), then
# the BSP's per-CPU state (AGAST #4192: GS area, own TSS with guard-paged
# kernel/IST stacks, IDT and SYSCALL MSRs), the APs, the boot-time proof
# that every CPU can be in SYSCALL at once, and the mailbox round trip to
# every AP (AGAST #4879).
fn init_smp(boot_info_addr: u64)
    if boot_protocol == BOOT_PROTOCOL_HARLAND
        apic_init_from_bootinfo(harland_boot_info)
    else if boot_protocol == BOOT_PROTOCOL_MULTIBOOT2
        apic_init_with_mb(boot_info_addr as *Mb2BootInfo)
    pci_init_segments(acpi_find_table(ACPI_SIG_MCFG))
    if boot_protocol == BOOT_PROTOCOL_UNKNOWN
        return
    var bsp_cpu: i32 = cpu_index_of_apic_id(lapic_id())
    if bsp_cpu < 0
        bsp_cpu = 0
    if cpu_bringup(bsp_cpu) != 0
        klog("[percpu] BSP bring-up failed\n")
        halt_loop()
    syscall_register_smp_test()
    # Every CPU's mailbox is empty before any AP can post to one (#4879).
    mbox_init()
    if num_cpus > 1
        ap_boot_all()
        smp_syscall_selftest(bsp_cpu)
    # Every started AP answers pings over its mailbox from its idle loop
    # (SMP_USER.md §6); with none, "[mbox] no APs to ping".
    ap_ping_all()
    # Each AP unmaps from a space it has loaded on the BSP's request, and
    # sees a kernel-half unmap (AGAST #4880): "[tlb] owner unmap OK: ...".
    tlb_selftest_all()

# Serial receive interrupts (IRQ 4, routed by ioapic_init; serial_enable_rx
# tracks IER so TX interrupts coexist), IPC, and capabilities. Init (pid 1)
# gets the kernel-reserved capabilities: ACPI power-off, the display, and
# the ambient IPC and filesystem capabilities every process needs. Spawned
# children inherit the latter three, never POWER (AGAST #1888, #4472).
fn init_ipc_and_capabilities()
    serial_enable_rx()
    klog("  [OK] Serial input enabled\n")
    # After the I/O APIC exists: probe the PS/2 keyboard and keep IRQ 1.
    i8042_init()
    klog("  [..] IPC channels")
    channel_init()
    ipc_syscall_init()
    klog("\r  [OK] IPC channels\n")
    klog("  [..] Capability tables")
    cap_table_init()
    if cap_init_bootstrap() == 0
        klog("\r  [OK] Capability tables\n")
    else
        klog("\r  [!!] Capability tables (init bootstrap failed)\n")

# ============================================================================
# Kernel Entry Point
# ============================================================================

pub fn kernel_main(boot_info_addr: u64) -> i32
    # BSS first: every global below lives there
    clear_bss()
    # klog_lock saves and clears IF from here on (AGAST #4879): it starts
    # off for the host tests that link klog. IF is still clear here.
    klog_irqsave(true)
    serial_start()
    ring_clear()
    klog_banner()
    detect_boot_protocol(boot_info_addr)
    # Boot-test mode (AGAST #1887); kernel_tail reads the rest.
    let boot_test: bool = boot_option(HARLAND_BOOT_FLAG_BOOT_TEST)

    klog("\nInitialization:\n")
    init_cpu_tables()
    init_physical_memory(boot_info_addr)
    init_virtual_memory(boot_info_addr)
    init_display()
    exception_panic_test(boot_option(HARLAND_BOOT_FLAG_PANIC_TEST))
    init_devices()
    init_namespace(boot_info_addr)
    init_smp(boot_info_addr)
    usb_boot()
    init_ipc_and_capabilities()

    # The kernel self-tests run only in boot-test mode: the boot gate
    # (tools/test_tier1_boot.sh) asks for it and asserts their verdicts.
    if boot_test
        boot_self_tests()
    else
        klog("[boot-test] self-tests skipped: boot option \\harland\\boot-test not set\n")

    klog("\nKernel initialized successfully.\n")
    klog("\n  [..] Syscall interface")
    syscall_init()
    klog("\r  [OK] Syscall interface\n")

    # The boot-test phase that needs SYSCALL and makes processes (#4712);
    # it logs the boot-test summary and leaves no process behind for
    # run_init. Production boots never run it.
    if boot_test
        boot_process_tests()

    # A boot that translates DMA hands a virtio-net to the ring-1 driver
    # (AGAST #4735, RING1_DRIVER.md section 9): the probe and pid 1, then
    # kernel_tail, on pid 1's kernel stack when pid 1 was made.
    net_ring1_boot(kernel_tail)
    return 0

# The rest of the boot: the ring-1 driver's spawn (steps 2-4, a no-op on
# any other boot), the diagnostics, the frame-seat handoff and init. Never returns. Run through
# net_ring1_boot, so it takes no arguments.
fn kernel_tail()
    net_ring1_spawn()

    # Boot options (AGAST #4335, #1851, #1885): the NIC self-tests and the
    # peer-ping window, and the ring dump before init.
    let run_net_selftests: bool = boot_option(HARLAND_BOOT_FLAG_NET_SELFTEST)
    let run_net_responder: bool = boot_option(HARLAND_BOOT_FLAG_NET_RESPONDER)
    # PCI listing, MSI-X checks and the opt-in network self-tests
    postinit_diagnostics(run_net_selftests, run_net_responder)
    # The frame seat goes to /bin/netd after the self-test window (AGAST
    # #4744): a no-op unless the ring-1 driver owns the NIC.
    net_seat_handoff()
    # The \harland\netd-restart option (AGAST #4745): pid 1 kills netd
    # after each lease until the restart budget is spent. A no-op without
    # a netd.
    net_netd_restart_test(boot_option(HARLAND_BOOT_FLAG_NETD_RESTART))
    # The \harland\net-responder option's latency window on netd (AGAST
    # #4768, tools/net_latency.sh). A no-op without a netd.
    net_latency_netd_window(run_net_responder)
    if boot_option(HARLAND_BOOT_FLAG_KLOG_DUMP)
        ring_dump()

    # /bin/init runs the userspace suite and powers off: run_init returns
    # only if it could not start
    if run_init() != 0
        klog("[kernel] Failed to run init!\n")
    halt_loop()
