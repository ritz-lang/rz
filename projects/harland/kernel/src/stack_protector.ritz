# Stack canaries (AGAST #2590, GitHub #116; guard pages are #1877).
#
# harland's kernel [[bin]] sets `stack-protector = true`, so the compiler
# gives every fn but a [[naked]] one LLVM's `sspstrong`: a fn with a stack
# array or an address-taken local copies a canary below its return address
# in the prologue and calls `__stack_chk_fail` from the epilogue if the copy
# changed.  On `x86_64-none-elf` LLVM reads the canary from the global
# `__stack_chk_guard` (a Linux target would read %fs:0x28), so the kernel
# defines both, under these exact C names.
#
# The guard:
#   - has a nonzero initializer, which puts it in .data: kernel_main's
#     clear_bss() would zero a .bss guard after boot.s had seeded it, under
#     a live instrumented frame;
#   - is XORed with the TSC by boot.s (higher_half_entry) before the first
#     Ritz frame exists, and must not change after that: every live frame's
#     copy would stop matching.  The TSC is weak entropy, but a fixed value
#     would be known to anyone with the binary.

pub var __stack_chk_guard: u64 = 0x595e9fbd94fda700

import serial { serial_print }
import io { halt_loop }

# An instrumented fn's epilogue found its canary overwritten: the frame's
# saved registers and return address cannot be trusted, so panic in place.
# Never returns.  Its own frame has no array, so sspstrong leaves it alone.
pub fn __stack_chk_fail()
    serial_print(c"\n*** KERNEL PANIC: stack smashing detected ***\n")
    serial_print(c"System halted.\n")
    halt_loop()
