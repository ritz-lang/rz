# ============================================================================
# Boot-test mode self-tests (AGAST #1887)
# ============================================================================
#
# Run only when the boot asked for boot-test mode (\harland\boot-test, or
# `boot-test` on the multiboot2 cmdline). Each test logs its own detail, then
# boot_self_tests and boot_process_tests log one "[boot-test] PASS|FAIL
# <name>" line for it; boot_process_tests, the last phase, logs the
# "[boot-test] N passed, M failed" summary, which tools/test_tier1_boot.sh
# asserts. A failure is a KERNEL PANIC: every boot gate fails on one.

# The test patterns and addresses: a page mapped past the 1 GiB of 2 MiB
# boot pages, and the kernel's load address seen through both of its maps.
const VMM_TEST_VADDR: u64 = 0xFFFFFFFFD0000000
const VMM_TEST_PATTERN: u64 = 0xDEADBEEFCAFEBABE
const KERNEL_LOAD_PHYS: u64 = 0x100000
const HEAP_TEST_PATTERN: u64 = 0x1234567890ABCDEF
const IPC_TEST_MSG_TYPE: u32 = 42
const IPC_TEST_SENDER: u32 = 1
const IPC_TEST_RECEIVER: u32 = 2

fn vmm_self_test() -> bool
    klog("\nTesting Virtual Memory...\n")
    let new_page: u64 = pmm_alloc_page()
    if new_page == 0
        klog("  pmm_alloc_page failed\n")
        return false
    let map_result: i32 = vmm_map_page(VMM_TEST_VADDR, new_page, PTE_WRITABLE)
    if map_result != 0
        klog("  vmm_map_page failed: ")
        klog_dec(map_result as i64)
        klog("\n")
        pmm_free_page(new_page)
        return false
    # Write through the physmap, read through the new mapping
    *(phys_to_virt(new_page) as *u64) = VMM_TEST_PATTERN
    let read_val: u64 = *(VMM_TEST_VADDR as *u64)
    let resolved: u64 = vmm_virt_to_phys(VMM_TEST_VADDR)
    klog("  page ")
    klog_hex(new_page)
    klog(" mapped at ")
    klog_hex(VMM_TEST_VADDR)
    klog(" resolves to ")
    klog_hex(resolved)
    klog(", read ")
    klog_hex(read_val)
    klog("\n")
    vmm_unmap_page(VMM_TEST_VADDR)
    pmm_free_page(new_page)
    return read_val == VMM_TEST_PATTERN and resolved == new_page

fn higher_half_self_test() -> bool
    klog("\nTesting Higher-Half Mapping...\n")
    # The kernel's load address reads the same through the identity map and
    # the higher half
    let phys_val: u64 = *(KERNEL_LOAD_PHYS as *u64)
    let hh_val: u64 = *((KERNEL_VIRT_BASE + KERNEL_LOAD_PHYS) as *u64)
    klog("  identity ")
    klog_hex(phys_val)
    klog(", higher half ")
    klog_hex(hh_val)
    klog("\n")
    return phys_val == hh_val

fn heap_self_test() -> bool
    klog("\nTesting Kernel Heap...\n")
    let alloc1: *u8 = kalloc(64)
    let alloc2: *u8 = kalloc(128)
    let alloc3: *u8 = kalloc(256)
    if alloc1 == 0 as *u8 or alloc2 == 0 as *u8 or alloc3 == 0 as *u8
        klog("  kalloc failed\n")
        return false
    *(alloc1 as *u64) = HEAP_TEST_PATTERN
    kfree(alloc2)
    # A smaller allocation fits the freed middle block
    let alloc4: *u8 = kalloc(100)
    let read_back: u64 = *(alloc1 as *u64)
    klog("  free space: ")
    klog_dec(heap_get_free())
    klog(" bytes, read back ")
    klog_hex(read_back)
    klog("\n")
    kfree(alloc1)
    kfree(alloc3)
    if alloc4 != 0 as *u8
        kfree(alloc4)
    return alloc4 != 0 as *u8 and read_back == HEAP_TEST_PATTERN and heap_check() == 0

# One message from endpoint A to endpoint B: type, sender and payload arrive.
fn ipc_self_test(pair: ChannelPair) -> bool
    klog("\nTesting IPC Channels...\n")
    if pair.endpoint_a == 0 as *ChannelEndpoint
        klog("  channel_create failed\n")
        return false
    # Message is 4 KiB: too big for the kernel stack
    let send_msg: *Message = kalloc(sizeof(Message) as u64) as *Message
    let recv_msg: *Message = kalloc(sizeof(Message) as u64) as *Message
    var ok: bool = false
    if send_msg != 0 as *Message and recv_msg != 0 as *Message
        let payload: StrView = "Hello IPC!"
        (*send_msg).header.msg_type = IPC_TEST_MSG_TYPE
        (*send_msg).header.flags = MSG_FLAG_NONE
        (*send_msg).header.seq = 0
        (*send_msg).header.payload_len = payload.len as u32
        var i: i64 = 0
        while i < payload.len
            (*send_msg).payload[i as i32] = *(payload.ptr + i)
            i = i + 1
        let send_result: i32 = channel_send(pair.endpoint_a, send_msg, IPC_TEST_SENDER)
        var sender: u32 = 0
        let recv_result: i32 = channel_recv(pair.endpoint_b, recv_msg, @sender)
        klog("  send ")
        klog_dec(send_result as i64)
        klog(", recv ")
        klog_dec(recv_result as i64)
        klog(", msg_type ")
        klog_dec((*recv_msg).header.msg_type as i64)
        klog(", sender ")
        klog_dec(sender as i64)
        klog("\n")
        ok = send_result == 0 and recv_result == payload.len as i32
        ok = ok and (*recv_msg).header.msg_type == IPC_TEST_MSG_TYPE and sender == IPC_TEST_SENDER
        i = 0
        while ok and i < payload.len
            ok = (*recv_msg).payload[i as i32] == *(payload.ptr + i)
            i = i + 1
    if send_msg != 0 as *Message
        kfree(send_msg as *u8)
    if recv_msg != 0 as *Message
        kfree(recv_msg as *u8)
    return ok

# Closing endpoint A breaks the pipe for B; closing B as well frees the
# channel and the message still queued on it, so a third close finds it free
# and the heap is intact. Skipped "due to page fault" until AGAST #1887: a
# queue entry was allocated 16 bytes short of a QueuedMessage, so queueing
# one wrote over the next heap block.
fn channel_close_self_test(pair: ChannelPair) -> bool
    if pair.endpoint_a == 0 as *ChannelEndpoint
        return false
    let msg: *Message = kalloc(sizeof(Message) as u64) as *Message
    if msg == 0 as *Message
        return false
    (*msg).header.payload_len = 0
    # Left on B's queue, for closing B to free
    let queued: i32 = channel_send(pair.endpoint_a, msg, IPC_TEST_SENDER)
    let close_a: i32 = channel_close(pair.endpoint_a)
    let send_b: i32 = channel_send(pair.endpoint_b, msg, IPC_TEST_RECEIVER)
    let close_b: i32 = channel_close(pair.endpoint_b)
    let close_again: i32 = channel_close(pair.endpoint_b)
    kfree(msg as *u8)
    let heap_ok: bool = heap_check() == 0
    klog("  queued ")
    klog_dec(queued as i64)
    klog(", close a ")
    klog_dec(close_a as i64)
    klog(", send to closed peer ")
    klog_dec(send_b as i64)
    klog(", close b ")
    klog_dec(close_b as i64)
    klog(", close freed ")
    klog_dec(close_again as i64)
    if not heap_ok
        klog(", HEAP CORRUPT")
    klog("\n")
    return heap_ok and queued == 0 and close_a == 0 and send_b == Errno.Pipe as i32 and close_b == 0 and close_again == Errno.BadF as i32

# RAM above 4 GiB (AGAST #4183): pmm hands out pages from the top of RAM and
# the kernel reaches them through the physmap. Takes HIGH_TEST_PAGES pages
# with pmm_alloc_page_high (the topmost free ones), writes a pattern to the
# first and last word of each through phys_to_virt, reads them all back and
# frees them. A physmap that stops short of top-of-RAM faults here; a pmm
# that drops RAM above 4 GiB hands out a low page. Logs
#   [pmm] above-4G self-test: <n> pages from 0x... PASSED
# or "skipped" when the machine has no RAM above 4 GiB. False on failure.
const FOUR_GIB: u64 = 0x100000000
const HIGH_TEST_PAGES: i32 = 16

fn pmm_high_memory_self_test() -> bool
    if pmm_get_total_pages() * PAGE_SIZE <= FOUR_GIB
        klog("[pmm] above-4G self-test: skipped (no RAM above 4 GiB)\n")
        return true
    let free_before: u64 = pmm_get_free_pages()
    var pages: [16]u64
    var ok: bool = true
    var i: i32 = 0
    while i < HIGH_TEST_PAGES
        pages[i] = pmm_alloc_page_high()
        if pages[i] < FOUR_GIB
            klog("[pmm] above-4G self-test: got page ")
            klog_hex(pages[i])
            klog("\n")
            ok = false
        else
            let first: *u64 = phys_to_virt(pages[i]) as *u64
            let last: *u64 = phys_to_virt(pages[i] + PAGE_SIZE - 8) as *u64
            *first = pages[i] ^ 0x5A5A5A5A5A5A5A5A
            *last = ~pages[i]
        i = i + 1
    i = 0
    while i < HIGH_TEST_PAGES
        if pages[i] >= FOUR_GIB
            let first: *u64 = phys_to_virt(pages[i]) as *u64
            let last: *u64 = phys_to_virt(pages[i] + PAGE_SIZE - 8) as *u64
            if *first != (pages[i] ^ 0x5A5A5A5A5A5A5A5A) or *last != ~pages[i]
                klog("[pmm] above-4G self-test: readback mismatch at ")
                klog_hex(pages[i])
                klog("\n")
                ok = false
        if pages[i] != 0
            pmm_free_page(pages[i])
        i = i + 1
    if pmm_get_free_pages() != free_before
        klog("[pmm] above-4G self-test: pages leaked\n")
        ok = false
    if not ok
        return false
    klog("[pmm] above-4G self-test: ")
    klog_dec(HIGH_TEST_PAGES as i64)
    klog(" pages from 0x")
    klog_hex(pages[0])
    klog(" PASSED\n")
    return true

var boot_tests_passed: i32 = 0
var boot_tests_failed: i32 = 0

fn boot_test_result(name: StrView, ok: bool)
    if ok
        boot_tests_passed = boot_tests_passed + 1
        klog("[boot-test] PASS ")
    else
        boot_tests_failed = boot_tests_failed + 1
        klog("[boot-test] FAIL ")
    klog(name)
    klog("\n")

# The boot-test mode self-tests, in order (AGAST #1887). The gate's list of
# names is BOOT_TESTS in tools/test_tier1_boot.sh.
pub fn boot_self_tests()
    klog("\n=== Boot-test mode: kernel self-tests ===\n")
    boot_test_result("vmm", vmm_self_test())
    boot_test_result("higher-half", higher_half_self_test())
    boot_test_result("heap", heap_self_test())
    let pair: ChannelPair = channel_create(IPC_TEST_SENDER, IPC_TEST_RECEIVER)
    boot_test_result("ipc", ipc_self_test(pair))
    boot_test_result("channel-close", channel_close_self_test(pair))
    channel_debug_print()
    boot_test_result("channel-debug-print", true)
    # A leak here is a regression (#1443); a failed mmap must not leak what
    # it mapped (#3552); RAM above 4 GiB is allocatable and reachable
    # (#4183); mmap over a live mapping must not leak (#4114); the
    # kernel-chosen cursor must not land on a live mapping (#4142).
    boot_test_result("munmap", munmap_self_test())
    boot_test_result("mmap-failure", mmap_failure_self_test())
    boot_test_result("pmm-above-4g", pmm_high_memory_self_test())
    boot_test_result("mmap-overlap", mmap_overlap_self_test())
    boot_test_result("mmap-cursor", mmap_cursor_self_test())
    # Neither may reach the ring-1 driver windows (#4715).
    boot_test_result("mmap-driver-window", mmap_driver_window_self_test())
    boot_test_result("elf-loader", test_elf_loader() == 0)
    # SYSRETQ fast path, STAR and GDT order; a non-canonical return RIP
    # leaves through IRETQ and faults safely (#4610)
    boot_test_result("sysret", sysret_selftest())
    # An NMI in ring 0 on the user's GS runs on this CPU's area and returns
    # to the user's GS: the paranoid NMI/#MC entry (#4612)
    boot_test_result("nmi-gs", nmi_gs_selftest(x2apic_mode != 0, lapic_icr_lo_mmio(), lapic_id()))
    # A #GP and a #PF inside the NMI handler push below the NMI's frame and
    # return (#4628): NMI has its own IST stack, #GP/#PF none. The #PF loads
    # from this CPU's kernel stack guard page, which is never mapped.
    boot_test_result("ist-nest", ist_nest_selftest(x2apic_mode != 0, lapic_icr_lo_mmio(), lapic_id(),
                                                   cpu_stack_guard(cpu_index(), CPU_KSTACK)))
    # A second NMI inside the first, after a fault's IRET unblocked NMIs, is
    # latched by the nested entry and run as a repeat once the first's
    # handler is done; the first still returns (#4650).
    boot_test_result("nmi-nest", nmi_nest_selftest(x2apic_mode != 0, lapic_icr_lo_mmio(), lapic_id(),
                                                   cpu_stack_guard(cpu_index(), CPU_KSTACK)))
    # The kernel grants a device's IRQ and MMIO caps; a holder can't CapGrant
    # them onward (Errno.Perm); CapRevoke drops only the caller's copy (#4716)
    let cap_step: i32 = cap_device_selftest()
    if cap_step != 0
        klog("[cap] device self-test failed at step ")
        klog_dec(cap_step as i64)
        klog("\n")
    boot_test_result("cap-device", cap_step == 0)
    # Two processes share a ShmObject's pages through ShmMap (227); one
    # exits and the other keeps them; CapRevoke unmaps the caller only (#4717)
    let shm_step: i32 = shm_map_selftest()
    if shm_step != 0
        klog("[shm] map self-test failed at step ")
        klog_dec(shm_step as i64)
        klog("\n")
    boot_test_result("shm-map", shm_step == 0)
    # Disk 0 still reads after the initramfs load (no disk: no test)
    let blk_dev: *VirtioBlkDevice = virtio_blk_get_device()
    if blk_dev != 0 as *VirtioBlkDevice
        boot_test_result("virtio-blk-read", virtio_blk_test(blk_dev) == 0)

# process_create_init makes pid 1 without starting the scheduler (#4712,
# RING1_DRIVER.md §9 step 1): pid 1 is current and init, has its fd table,
# and sched_running stays 0; a second call keeps the same pid 1. Then
# process_destroy_init tears it down and the stopped scheduler's state is
# what run_init expects: no process, no fd table, not running.
const PROC_TEST_MARKER: i64 = 0x4712

fn proc_create_init_self_test() -> bool
    klog("\nTesting process_create_init...\n")
    if proc_current() != 0 as *Proc or sched_is_running()
        klog("  a process or the scheduler already exists\n")
        return false
    process_create_init()
    let p: *Proc = proc_current()
    let created: bool = p != 0 as *Proc and proc_is_init(p) and fs_process_pid() == 1
    let slot: i32 = proc_current_slot()
    # A marker on pid 1: a second call that reset the table would clear it
    if created
        (*p).exit_code = PROC_TEST_MARKER
    process_create_init()
    let kept: bool = proc_current_slot() == slot and proc_live_count() == 1 and proc_at(slot).exit_code == PROC_TEST_MARKER
    let running: bool = sched_is_running()
    klog("  pid ")
    klog_dec(proc_current_pid() as i64)
    klog(", slot ")
    klog_dec(slot as i64)
    klog(", procs ")
    klog_dec(proc_live_count() as i64)
    if running
        klog(", scheduler running")
    process_destroy_init()
    sched_stop()
    let gone: bool = proc_current() == 0 as *Proc and proc_live_count() == 0 and fs_process_pid() == 0 and not sched_is_running()
    if not gone
        klog(", teardown left a process or the scheduler")
    klog("\n")
    return created and kept and not running and gone

# A kernel-spawned CPL-3 process (#4713, RING1_DRIVER.md section 2-3, Tests
# 1-3): pid 1 (made with process_create_init, scheduler stopped) spawns the
# asm stub kernel/driver_stub.s with process_spawn_image and entry arguments
# it chose. The stub packs what it measured at CPL 3 into its exit status:
# (arg1 & 0x7FFF) << 16 | cpl << 8 | (pid & 0xFF).
extern fn driver_stub_start()
extern fn driver_stub_end()
extern fn kstack_call(body: u64, top: u64)

const DRIVER_STUB_ENTER: u64 = 0
const DRIVER_STUB_FAULT: u64 = 1
const DRIVER_STUB_SPIN: u64 = 2
const DRIVER_STUB_IRQ_WAIT: u64 = 3
const DRIVER_STUB_CONSOLE_POLL: u64 = 4
const DRIVER_STUB_POLL_NVAL: u64 = 5
const DRIVER_STUB_SHM_WAIT: u64 = 6
const DRIVER_STUB_MMIO_MAP: u64 = 21
const DRIVER_STUB_DMA_ALLOC: u64 = 22
const DRIVER_STUB_DMA_FREE: u64 = 23
const DRIVER_STUB_COOKIE: u64 = 0x4713
# SCHED_HZ is 100: a 50 ms spin spans five ticks.
const DRIVER_SPIN_MS: u64 = 50
# A #PF at CPL 3 kills the process with 128 + 14 (exceptions.ritz).
const DRIVER_FAULT_STATUS: i64 = 142

fn driver_stub() -> Span<u8>
    let start: u64 = driver_stub_start as u64
    span_from_ptr<u8>(start as *u8, (driver_stub_end as u64 - start) as i64)

# What the stub reported in its exit status.
struct DriverReport
    pid: u64
    cpl: u64
    arg1: u64

fn driver_report(status: i64) -> DriverReport
    DriverReport { pid: (status & 0xFF) as u64, cpl: ((status >> 8) & 0xFF) as u64, arg1: ((status >> 16) & 0x7FFF) as u64 }

# Log "[driver] pid N cpl C arg1 K" for the stub `pid` that exited with
# `status`; true when it ran at CPL 3 as that pid with `arg1`.
fn driver_check(pid: i64, status: i64, arg1: u64) -> bool
    let r: DriverReport = driver_report(status)
    klog("[driver] pid ")
    klog_dec(r.pid as i64)
    klog(" cpl ")
    klog_dec(r.cpl as i64)
    klog(" arg1 ")
    klog_dec(r.arg1 as i64)
    klog("\n")
    r.pid == (pid as u64 & 0xFF) and r.cpl == 3 and r.arg1 == (arg1 & 0x7FFF)

# driver-enter: the stub sees the kernel's arguments, Getpid returns its pid,
# CS says CPL 3, and Exit (by sysretq's return path) reports them.
fn driver_enter_self_test() -> bool
    klog("\nTesting a kernel-spawned CPL-3 process...\n")
    let pid: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_ENTER, DRIVER_STUB_COOKIE)
    if pid <= 0
        klog("  spawn failed\n")
        return false
    return driver_check(pid, process_wait(pid as i32), DRIVER_STUB_COOKIE)

# driver-fault: a null read at CPL 3 kills only the stub, with status 142;
# the kernel does not panic and pid 1 runs on.
fn driver_fault_self_test() -> bool
    klog("\nTesting a fault in a kernel-spawned process...\n")
    let pid: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_FAULT, 0)
    if pid <= 0
        klog("  spawn failed\n")
        return false
    let status: i64 = process_wait(pid as i32)
    klog("  status ")
    klog_dec(status)
    klog("\n")
    return status == DRIVER_FAULT_STATUS

# driver-preempt: with the tick running and pid 1 runnable (it yields until
# the stub exits), the stub's 50 ms spin at CPL 3 is preempted.
fn driver_preempt_self_test() -> bool
    klog("\nTesting preemption of a kernel-spawned process...\n")
    let cycles: u64 = tsc_hz() / 1000 * DRIVER_SPIN_MS
    if cycles == 0
        klog("  no TSC frequency\n")
        return false
    let before: u64 = sched_preemption_count()
    sched_start(proc_current_slot())
    let pid: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_SPIN, cycles)
    var ok: bool = pid > 0
    if ok
        var code: i64 = 0
        while proc_child_status(pid as u64, @code) == PROC_CHILD_LIVE
            sched_yield()
        ok = driver_check(pid, process_wait(pid as i32), cycles)
    sched_stop()
    let preempted: u64 = sched_preemption_count() - before
    klog("  preemptions ")
    klog_dec(preempted as i64)
    klog("\n")
    return ok and preempted > 0

# driver-reap (#4714, RING1_DRIVER.md Tests 4): pid 1 marks a spinning stub
# with process_mark_exit. The stub never makes a syscall, so only the return
# from the timer IRQ that preempted it can reap it: it leaves through
# sys_exit_impl on its own kernel stack with PROC_REAP_STATUS, not by an
# exit of its own (whose status would be its report). Pid 1 runs on,
# unmarked, and process_mark_exit(1) is refused.
const DRIVER_REAP_SPIN: u64 = 0x7FFFFFFFFFFFFFFF   # never ends on its own
const DRIVER_REAP_WAIT_US: u64 = 1000000

fn driver_reap_self_test() -> bool
    klog("\nTesting process_mark_exit on a kernel-spawned process...\n")
    sched_start(proc_current_slot())
    let pid: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_SPIN, DRIVER_REAP_SPIN)
    if pid <= 0
        sched_stop()
        klog("  spawn failed\n")
        return false
    # It is at CPL 3, spinning, once a tick has preempted it back to pid 1.
    let before: u64 = sched_preemption_count()
    var deadline: u64 = deadline_after_us(DRIVER_REAP_WAIT_US)
    while sched_preemption_count() == before and not deadline_passed(deadline)
        sched_yield()
    let spun: bool = sched_preemption_count() != before
    let refused: bool = match process_mark_exit(1)
        Err(e) => e == MarkError.Init
        Ok(_) => false
    let marked: bool = process_mark_exit(pid as u64).is_ok()
    var code: i64 = 0
    deadline = deadline_after_us(DRIVER_REAP_WAIT_US)
    while proc_child_status(pid as u64, @code) == PROC_CHILD_LIVE and not deadline_passed(deadline)
        sched_yield()
    var status: i64 = -1
    if proc_child_status(pid as u64, @code) != PROC_CHILD_LIVE
        status = process_wait(pid as i32)
    sched_stop()
    let runs_on: bool = proc_current_pid() == 1 and not proc_reap_pending(proc_current())
    klog("  status ")
    klog_dec(status)
    if not spun
        klog(", never reached CPL 3")
    if not refused
        klog(", process_mark_exit(1) not refused")
    if not marked
        klog(", mark failed")
    if not runs_on
        klog(", pid 1 is not running unmarked")
    klog("\n")
    return spun and refused and marked and status == PROC_REAP_STATUS as i64 and runs_on

# drv-irq-wait (#4719, RING1_DRIVER.md §4 and PR 4): DrvIrqWait parks a
# kernel-spawned process on its own IRQ object. Pid 1 registers two IRQ
# objects, A on an MSI-X vector of its own and B with none, grants both to
# the stub (mode 3, driver_stub.s), and lets it run. The stub's first three
# calls are refused (out_cap 0 and 9: Inval; a handle it does not hold:
# Perm), then its fourth parks on A. A kernel post to B wakes the stub (it
# owns B) without completing the wait: it parks again. A self-IPI on A's
# vector, through irq_handler's msix_dispatch, completes it with return 0
# and A's record. The fifth call finds A taken (seen = latched) and returns
# 1 at the DEVICE_WAIT_MS deadline, which only the wait set's deadline (no
# watchdog, no other wake) can end. The stub exits 0 only if each return
# and what it wrote matched; else the number of the failing call. A's
# vector is taken from the MSI-X pool for good (msix.ritz frees none): one
# of sixteen, in boot-test mode only.
const DRV_TEST_IRQ_A: u64 = 0xFFFF4719A
const DRV_TEST_IRQ_B: u64 = 0xFFFF4719B
# A fresh table's first handle: index 0, generation 1 (cap/table.ritz).
# The stub's argument is chosen before the grant, so the grant is checked
# against it.
const DRV_TEST_HANDLE_A: u64 = 1 << 32
# Bounds on each step; the re-park must come well inside DEVICE_WAIT_MS.
const DRV_TEST_PARK_US: u64 = 1000000
const DRV_TEST_REPARK_US: u64 = 50000
const US_PER_MS: u64 = 1000

fn packed_handle(h: CapHandle) -> u64
    let index: u32 = h.index
    let generation: u32 = h.generation
    (index as u64) | ((generation as u64) << 32)

# Process `pid` is parked on its wait set.
fn parked_on_wait_set(pid: u64) -> bool
    var i: i32 = 0
    while i < MAX_PROCS
        let p: *Proc = proc_at(i)
        if p.pid == pid and p.state == PROC_BLOCKED and p.block == BLOCK_WAIT
            return true
        i = i + 1
    false

# Yield to the stub until `pid` is parked on its wait set and DrvIrqWait
# has parked more than `parks` times, or `us` has passed.
fn await_park(pid: u64, parks: u64, us: u64) -> bool
    let deadline: u64 = deadline_after_us(us)
    while not (parked_on_wait_set(pid) and drv_irq_wait_park_count() > parks) and not deadline_passed(deadline)
        sched_yield()
    parked_on_wait_set(pid) and drv_irq_wait_park_count() > parks

# The stub's exit status, marking it to exit first if it is still running
# after DRV_TEST_PARK_US (a wait that never ended).
fn drv_stub_status(pid: u64) -> i64
    var code: i64 = 0
    let deadline: u64 = deadline_after_us(DRV_TEST_PARK_US)
    while proc_child_status(pid, @code) == PROC_CHILD_LIVE and not deadline_passed(deadline)
        sched_yield()
    if proc_child_status(pid, @code) == PROC_CHILD_LIVE
        klog("  the stub's wait never ended\n")
        process_mark_exit(pid)
    process_wait(pid as i32)

fn drv_irq_wait_self_test() -> bool
    klog("\nTesting DrvIrqWait on a kernel-spawned process...\n")
    let vector: u8 = msix_vector_alloc()
    if vector == 0
        klog("  no free MSI-X vector\n")
        return false
    if not irq_object_register(DRV_TEST_IRQ_A, vector) or not irq_object_register(DRV_TEST_IRQ_B, IRQ_NO_VECTOR)
        klog("  IRQ objects not registered\n")
        irq_object_unregister(DRV_TEST_IRQ_A)
        return false
    sched_start(proc_current_slot())
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_IRQ_WAIT, DRV_TEST_HANDLE_A)
    var ok: bool = spawned > 0
    var reparked: bool = false
    var waited: bool = false
    var status: i64 = -1                # the stub's exit status, once it exits
    if ok
        let pid: u64 = spawned as u64
        # It cannot run before pid 1 yields: the grants land first.
        let a: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, DRV_TEST_IRQ_A))
        let b: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, DRV_TEST_IRQ_B))
        if a != DRV_TEST_HANDLE_A or b == a
            klog("  grant gave handle 0x")
            klog_hex(a)
            klog("\n")
            process_mark_exit(pid)
            status = drv_stub_status(pid)
        else if await_park(pid, drv_irq_wait_park_count(), DRV_TEST_PARK_US)
            # B's post wakes its owner; A is cold, so the stub parks again.
            let parks: u64 = drv_irq_wait_park_count()
            disable_interrupts()
            irq_object_latch(DRV_TEST_IRQ_B)
            enable_interrupts()
            reparked = await_park(pid, parks, DRV_TEST_REPARK_US)
            # The fifth call can end no sooner than this.
            let late: u64 = deadline_after_us(DEVICE_WAIT_MS * US_PER_MS)
            let irqs: u64 = msix_vector_count(vector)
            lapic_send_fixed_ipi(lapic_id(), vector)
            status = drv_stub_status(pid)
            waited = deadline_passed(late) and msix_vector_count(vector) == irqs + 1
        else
            klog("  the stub never parked\n")
            process_mark_exit(pid)
            status = drv_stub_status(pid)
    sched_stop()
    irq_object_unregister(DRV_TEST_IRQ_A)
    irq_object_unregister(DRV_TEST_IRQ_B)
    klog("  status ")
    klog_dec(status)
    if not reparked
        klog(", a post to another IRQ object did not re-park the wait")
    if not waited
        klog(", the IRQ return or the deadline came too soon")
    klog("\n")
    return ok and status == 0 and reparked and waited

# shm-wait (#4727, RING1_DRIVER.md "Wait and notify" and PR 6b): the shm
# latches, ShmNotify and ShmWait on a kernel-spawned process. Pid 1 makes a
# frame object both it and the stub hold, a second object only the stub
# holds, and an IRQ object (no vector) for the stub. Before the stub runs,
# pid 1 posts DATA on the frame object, which the stub has not mapped, and
# latches the IRQ: the stub's DrvIrqWait with room for one copies the IRQ
# only, and the next returns 2 with the frame event, neither parking (no
# deadline). The stub's refused notifies (PEER_CLOSE, 0, the lone object,
# a handle it lacks) post nothing; its SPACE lands on pid 1's latch; its
# ShmWait with deadline 0 returns 1; its last ShmWait parks until pid 1
# posts DATA. The stub exits 0 only if each return and what it wrote
# matched (driver_stub.s mode 6). Exactly one park: that last wait.
const SHM_TEST_IRQ: u64 = 0xFFFF4727A
# The stub's handles: a fresh table's first three grants (index |
# generation << 32), as driver_stub.s SHM_H_*.
const SHM_TEST_H_IRQ: u64 = 1 << 32
const SHM_TEST_H_FRAME: u64 = 0x200000001
const SHM_TEST_H_LONE: u64 = 0x300000002
# Pid 1, which holds the frame object's other handle.
const SHM_TEST_PEER: u32 = 1

fn notified(n: Notify) -> bool
    match n
        Notify.Posted => true
        _ => false

fn shm_wait_self_test() -> bool
    klog("\nTesting ShmNotify and ShmWait on a kernel-spawned process...\n")
    let frame: u64 = shm_create(1).unwrap_or(0)
    let lone: u64 = shm_create(1).unwrap_or(0)
    if frame == 0 or lone == 0 or not irq_object_register(SHM_TEST_IRQ, IRQ_NO_VECTOR)
        klog("  objects not made\n")
        if frame != 0
            shm_destroy(frame)
        if lone != 0
            shm_destroy(lone)
        return false
    let rights: u32 = CAP_RIGHT_READ | CAP_RIGHT_WRITE
    let mine: CapHandle = cap_kernel_grant(SHM_TEST_PEER, CAP_TYPE_SHM, rights, frame)
    sched_start(proc_current_slot())
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_SHM_WAIT, SHM_TEST_H_IRQ)
    var posted: bool = false
    var spaced: bool = false
    var one_park: bool = false
    var status: i64 = -1
    if spawned > 0
        let pid: u64 = spawned as u64
        # It cannot run before pid 1 yields: the grants land first.
        let irq: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, SHM_TEST_IRQ))
        let hf: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_SHM, rights, frame))
        let hl: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_SHM, rights, lone))
        if irq != SHM_TEST_H_IRQ or hf != SHM_TEST_H_FRAME or hl != SHM_TEST_H_LONE or not shm_latch_held(frame, SHM_TEST_PEER as u64)
            klog("  grants gave other handles\n")
            process_mark_exit(pid)
            status = drv_stub_status(pid)
        else
            disable_interrupts()
            posted = notified(shm_notify(frame, SHM_TEST_PEER as u64, EVENT_DATA))
            irq_object_latch(SHM_TEST_IRQ)
            enable_interrupts()
            let parks: u64 = drv_irq_wait_park_count()
            if await_park(pid, parks, DRV_TEST_PARK_US)
                # Its SPACE, and nothing from the refused PEER_CLOSE.
                spaced = shm_latch_bits(frame, SHM_TEST_PEER as u64) == EVENT_SPACE
                disable_interrupts()
                shm_notify(frame, SHM_TEST_PEER as u64, EVENT_DATA)
                enable_interrupts()
            else
                klog("  the stub never parked\n")
                process_mark_exit(pid)
            status = drv_stub_status(pid)
            one_park = drv_irq_wait_park_count() == parks + 1
    sched_stop()
    # The stub's exit retired both objects (#4729): it held the IRQ cap, so
    # DRIVER_GONE on pid 1's latch; nobody mapped either, so both are
    # reclaimed already.
    let closed: bool = (shm_latch_bits(frame, SHM_TEST_PEER as u64) & EVENT_DRIVER_GONE) != 0
    let table: *CapTable = cap_table_get(SHM_TEST_PEER)
    let dropped: bool = cap_revoke(table, mine) and not shm_latch_held(frame, SHM_TEST_PEER as u64)
    let freed: bool = not shm_exists(frame) and not shm_exists(lone)
    if not freed
        shm_destroy(frame)
        shm_destroy(lone)
    irq_object_unregister(SHM_TEST_IRQ)
    klog("  status ")
    klog_dec(status)
    if not posted
        klog(", pid 1's DATA found no holder")
    if not spaced
        klog(", pid 1's latch did not hold the stub's SPACE alone")
    if not one_park
        klog(", a wait parked that should have returned")
    if not closed
        klog(", the stub's exit left no DRIVER_GONE on pid 1's latch")
    if not dropped or not freed
        klog(", the objects outlived the test")
    klog("\n")
    return status == 0 and posted and spaced and one_park and closed and dropped and freed

# net-attach (#4728, RING1_DRIVER.md "Grants" and "Wait and notify"):
# NetAttach and the service's inbox. Before a service is registered an
# attach is NoDev. Pid 1 spawns the service stub (driver_stub.s mode 7) and
# registers it; the stub cannot run before pid 1 yields. Eight stand-in
# apps (tables with no process, as cap/shm_selftest.ritz uses) each attach
# once: eight ATTACH records on the inbox, a second attach from one of them
# is Exist and a ninth app's is Again, creating nothing. Those eight
# objects are retired (the apps "exited" before the service mapped them),
# so the service's first wait, with an empty source list, copies out all
# eight and loses each handle before it returns: the stub's ShmMap of each
# is Perm. Then two real apps (mode 8), one after the other in the same
# process slot, attach (a second attach of each, still holding its handle,
# is Exist) and exit, and the exit retires each exchange (#4729); the
# service maps each it reaches before that exit, refuses the others, and
# exits with records << 16 | refused maps << 8 | maps. Once it has exited
# too, every exchange object has been reclaimed.
const DRIVER_STUB_SERVICE: u64 = 7
const DRIVER_STUB_APP: u64 = 8
# The stand-in apps' pids: no process has them.
const ATTACH_FAKE_PID: u32 = 0x47280
const ATTACH_FAKES: u32 = 9
const ATTACH_RETIRED: u32 = 8
const ATTACH_APPS: u64 = 2

fn net_attach_self_test() -> bool
    klog("\nTesting NetAttach and the service inbox...\n")
    var ok: bool = true
    var f: u32 = 0
    while f < ATTACH_FAKES
        if cap_table_alloc(ATTACH_FAKE_PID + f) == 0 as *CapTable
            ok = false
        f = f + 1
    let nodev: bool = net_attach_for(ATTACH_FAKE_PID) == Errno.NoDev as i64
    sched_start(proc_current_slot())
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_SERVICE, ATTACH_RETIRED as u64 + ATTACH_APPS)
    var queued: bool = false
    var exist: bool = false
    var again: bool = false
    var dropped: bool = false
    var apps_ok: bool = false
    var status: i64 = -1
    if spawned > 0 and ok
        let service: u64 = spawned as u64
        net_service_register(service as u32)
        var objects: [8]u64
        queued = true
        var i: u32 = 0
        while i < ATTACH_RETIRED
            let h: i64 = net_attach_for(ATTACH_FAKE_PID + i)
            objects[i as i32] = held_shm_object(ATTACH_FAKE_PID + i, h)
            if h < 0 or objects[i as i32] == 0
                queued = false
            i = i + 1
        queued = queued and waitset_inbox_len(service) == ATTACH_RETIRED
        exist = net_attach_for(ATTACH_FAKE_PID) == Errno.Exist as i64
        let ninth: u32 = ATTACH_FAKE_PID + ATTACH_RETIRED
        again = net_attach_for(ninth) == Errno.Again as i64 and cap_table_get(ninth).active_count == 0 and waitset_inbox_len(service) == ATTACH_RETIRED
        i = 0
        while i < ATTACH_RETIRED
            shm_retire(objects[i as i32], (ATTACH_FAKE_PID + i) as u64, EVENT_PEER_CLOSE)
            i = i + 1
        # The stand-ins are gone; their records stay on the inbox.
        f = 0
        while f < ATTACH_FAKES
            cap_table_free_pid(ATTACH_FAKE_PID + f)
            f = f + 1
        let parks: u64 = drv_irq_wait_park_count()
        if queued and exist and again and await_park(service, parks, DRV_TEST_PARK_US)
            dropped = waitset_inbox_len(service) == 0
            i = 0
            while i < ATTACH_RETIRED
                if cap_holds_object(service as u32, CAP_TYPE_SHM, objects[i as i32])
                    dropped = false
                i = i + 1
            apps_ok = true
            var a: u64 = 0
            while a < ATTACH_APPS
                let app: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_APP, a)
                if app <= 0 or process_wait(app as i32) != 0
                    apps_ok = false
                a = a + 1
        else
            klog("  the attaches or the service's first wait went wrong\n")
            process_mark_exit(service)
        status = drv_stub_status(service)
    else
        f = 0
        while f < ATTACH_FAKES
            cap_table_free_pid(ATTACH_FAKE_PID + f)
            f = f + 1
    sched_stop()
    net_service_register(0)
    let freed: bool = net_exchanges_reclaimed()
    klog("  status ")
    klog_hex(status as u64)
    if not nodev
        klog(", an attach with no service was not NoDev")
    if not queued
        klog(", the eight attaches did not each leave a record")
    if not exist
        klog(", a second attach was not Exist")
    if not again
        klog(", a ninth record was not Again, or it made something")
    if not dropped
        klog(", the retired records' handles outlived the wait")
    if not apps_ok
        klog(", an app stub failed")
    if not freed
        klog(", an exchange outlived the test")
    klog("\n")
    return attach_status_ok(status) and nodev and queued and exist and again and dropped and apps_ok and freed

# The service stub's status: ten records, the eight retired ones refused.
# Each real app's exit retires its exchange (#4729): the service maps it if
# it ran before that exit, else the record or the map drops the handle, so
# the two real apps are two maps or refusals between them.
fn attach_status_ok(status: i64) -> bool
    let maps: i64 = status & 0xFF
    let refused: i64 = (status >> 8) & 0xFF
    let records: i64 = status >> 16
    records == ATTACH_RETIRED as i64 + ATTACH_APPS as i64 and refused >= ATTACH_RETIRED as i64 and refused + maps == records

# The object behind `pid`'s shm handle `packed` (a NetAttach return), or 0.
fn held_shm_object(pid: u32, packed: i64) -> u64
    if packed < 0
        return 0
    let table: *CapTable = cap_table_get(pid)
    let index: u32 = (packed as u64 & 0xFFFFFFFF) as u32
    let generation: u32 = (packed as u64 >> 32) as u32
    let entry: *CapEntry = cap_table_lookup(table, cap_handle_init(index, generation))
    if entry == 0 as *CapEntry or entry.cap_type != CAP_TYPE_SHM
        return 0
    entry.object_id

# net-info (#4730, RING1_DRIVER.md section 7, Test 7): the link snapshot.
# Pid 1 makes a one-page link object and a frame object, registers both
# (pid 1 as the frame's consumer, so it holds a latch), and spawns the
# driver stub (mode 9) with two handles for the link object: the first with
# CAP_RIGHT_PUBLISH, the second without. The stub checks NetInfo is NoDev
# before any publish, NetPublish is Again at link_seq 0 and 1, the handle
# without the right is Perm, the seqlocked generation 2 publishes, and
# NetInfo then copies its MAC and MTU (and is Fault on a kernel pointer),
# and a publish at odd link_seq 3 over zeroed bytes is Again and keeps
# generation 2's snapshot.
# Pid 1 sees the same snapshot, and LINK on its frame latch; its own
# publish-right handle on the frame object is Perm (not the link object). After
# snapshot_invalidate a second stub (mode 9, no handle) sees NoDev again.
const DRIVER_STUB_LINK: u64 = 9
# The stub's two link handles: a fresh table's first two grants.
const LINK_TEST_H_PUBLISH: u64 = 1 << 32
const LINK_TEST_H_PLAIN: u64 = 0x200000001
const LINK_TEST_CONSUMER: u32 = 1
# What the stub writes: driver_stub.s LINK_MAC_WORD (mac[0..6], link_up 1,
# device_type 1) and LINK_MTU.
# mac[0..6] = 52:54:00:47:30:01, low byte first
const LINK_TEST_MAC: u64 = 0x013047005452
const LINK_TEST_MTU: u32 = 1500

fn link_snapshot_matches() -> bool
    let n: NetInfo = match net_info_snapshot()
        Some(i) => i
        None => return false
    var i: i32 = 0
    while i < 6
        if n.mac[i] as u64 != ((LINK_TEST_MAC >> (8 * i as u64)) & 0xFF)
            return false
        i = i + 1
    n.link_up == 1 and n.device_type == NETDEV_TYPE_VIRTIO and n.mtu == LINK_TEST_MTU

fn net_info_self_test() -> bool
    klog("\nTesting NetPublish and NetInfo on a kernel-spawned process...\n")
    let link: u64 = shm_create(1).unwrap_or(0)
    let frame: u64 = shm_create(1).unwrap_or(0)
    if link == 0 or frame == 0
        klog("  objects not made\n")
        if link != 0
            shm_destroy(link)
        if frame != 0
            shm_destroy(frame)
        return false
    let rights: u32 = CAP_RIGHT_READ | CAP_RIGHT_WRITE
    let mine: CapHandle = cap_kernel_grant(LINK_TEST_CONSUMER, CAP_TYPE_SHM, rights, frame)
    net_link_register(link)
    net_frame_register(frame, LINK_TEST_CONSUMER as u64)
    let unpublished: bool = not ring_driver_published()
    sched_start(proc_current_slot())
    var status: i64 = -1
    var after: i64 = -1
    var matched: bool = false
    var linked: bool = false
    var invalidated: bool = false
    var refused: bool = false
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_LINK, LINK_TEST_H_PUBLISH)
    if spawned > 0
        let pid: u64 = spawned as u64
        let hp: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_SHM, rights | CAP_RIGHT_PUBLISH, link))
        let hn: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_SHM, rights, link))
        if hp != LINK_TEST_H_PUBLISH or hn != LINK_TEST_H_PLAIN
            klog("  grants gave other handles\n")
            process_mark_exit(pid)
        status = drv_stub_status(pid)
        # CAP_RIGHT_PUBLISH on any object but the registered link object is
        # Perm too.
        let wrong: u64 = packed_handle(cap_kernel_grant(LINK_TEST_CONSUMER, CAP_TYPE_SHM, rights | CAP_RIGHT_PUBLISH, frame))
        refused = net_publish_for(LINK_TEST_CONSUMER, wrong) == Errno.Perm as i64
        let wi: u32 = (wrong & 0xFFFFFFFF) as u32
        let wg: u32 = (wrong >> 32) as u32
        cap_revoke(cap_table_get(LINK_TEST_CONSUMER), cap_handle_init(wi, wg))
        matched = ring_driver_published() and link_snapshot_matches()
        linked = (shm_latch_bits(frame, LINK_TEST_CONSUMER as u64) & EVENT_LINK) != 0
        snapshot_invalidate()
        invalidated = not ring_driver_published() and net_info_snapshot().is_none()
        let second: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_LINK, 0)
        if second > 0
            after = drv_stub_status(second as u64)
    sched_stop()
    net_link_register(0)
    net_frame_register(0, 0)
    let dropped: bool = cap_revoke(cap_table_get(LINK_TEST_CONSUMER), mine)
    # The stub's exit retired the link object and dropped its one mapping:
    # reclaimed (#4729). Only pid 1 held the frame object.
    let freed: bool = not shm_exists(link) and shm_destroy(frame)
    klog("  status ")
    klog_dec(status)
    klog(", after invalidation ")
    klog_dec(after)
    if not unpublished
        klog(", a snapshot was published before the test")
    if not matched
        klog(", the snapshot is not what the stub wrote")
    if not refused
        klog(", a publish handle on the frame object was not Perm")
    if not linked
        klog(", no LINK on the consumer's frame latch")
    if not invalidated
        klog(", the snapshot outlived snapshot_invalidate")
    if not dropped or not freed
        klog(", the objects outlived the test")
    klog("\n")
    return status == 0 and after == 0 and unpublished and matched and refused and linked and invalidated and dropped and freed

# console-poll (#4829): poll(2) on fd 0 is the console's timed read. The stub
# (modes 4 and 5, driver_stub.s) polls { 0, POLLIN } with the console raw
# (one byte readable) and nothing typed:
#   * timeout 0 returns 0 at once;
#   * timeout CONSOLE_POLL_SHORT_MS returns 0, no sooner than that and well
#     before CONSOLE_POLL_LATE_MS: only the wait set's deadline ends it;
#   * timeout CONSOLE_POLL_LONG_MS, parked on its wait set, gets a byte
#     through the console's receive path (ldisc_input, then tty_console_irq
#     as COM1's interrupt runs it): it returns 1 with POLLIN within
#     CONSOLE_POLL_PROMPT_MS, long before its deadline;
#   * an entry with fd -1 is skipped and a number that names no file is
#     POLLNVAL, which returns at once even with no timeout.
# The byte is read back out and the console's flags restored, so init finds
# the console as boot left it.
const CONSOLE_POLL_SHORT_MS: u64 = 30
const CONSOLE_POLL_LATE_MS: u64 = 500
const CONSOLE_POLL_LONG_MS: u64 = 5000
const CONSOLE_POLL_PROMPT_MS: u64 = 200
const CONSOLE_POLL_BYTE: u8 = 0x6B          # 'k'
# The stub's status for a return of 1 with revents POLLIN.
const CONSOLE_POLL_GOT_BYTE: i64 = 0x101
const MS_PER_S: u64 = 1000

# Milliseconds since TSC `start`.
fn ms_since(start: u64) -> u64
    (rdtsc() - start) * MS_PER_S / tsc_hz()

# Run the stub in `mode` with `arg1` to its exit: its status, or -1 if it
# could not be spawned.
fn console_poll_stub(mode: u64, arg1: u64) -> i64
    let pid: i64 = process_spawn_image(driver_stub(), mode, arg1)
    if pid <= 0
        return -1
    drv_stub_status(pid as u64)

fn console_poll_self_test() -> bool
    klog("\nTesting poll on the console (the timed console read)...\n")
    let flags: u32 = tty_console_get_flags()
    tty_console_set_flags(0)
    sched_start(proc_current_slot())

    var t: u64 = rdtsc()
    let at_once: i64 = console_poll_stub(DRIVER_STUB_CONSOLE_POLL, 0)
    let at_once_ms: u64 = ms_since(t)

    t = rdtsc()
    let timed: i64 = console_poll_stub(DRIVER_STUB_CONSOLE_POLL, CONSOLE_POLL_SHORT_MS)
    let timed_ms: u64 = ms_since(t)

    var woke: i64 = -1
    var woke_ms: u64 = 0
    let pid: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_CONSOLE_POLL, CONSOLE_POLL_LONG_MS)
    if pid > 0
        if await_wait_set(pid as u64, DRV_TEST_PARK_US)
            t = rdtsc()
            disable_interrupts()
            ldisc_input(CONSOLE_POLL_BYTE)
            tty_console_irq(false)
            enable_interrupts()
        else
            klog("  the stub never parked in poll\n")
        woke = drv_stub_status(pid as u64)
        woke_ms = ms_since(t)
    var byte: [1]u8
    disable_interrupts()
    let drained: i64 = ldisc_read(@byte[0], 1)
    enable_interrupts()

    let nval: i64 = console_poll_stub(DRIVER_STUB_POLL_NVAL, 0)
    sched_stop()
    tty_console_set_flags(flags)

    klog("  timeout 0: status ")
    klog_dec(at_once)
    klog(" after ")
    klog_dec(at_once_ms as i64)
    klog(" ms; timeout ")
    klog_dec(CONSOLE_POLL_SHORT_MS as i64)
    klog(" ms: status ")
    klog_dec(timed)
    klog(" after ")
    klog_dec(timed_ms as i64)
    klog(" ms; a byte: status ")
    klog_hex(woke as u64)
    klog(" ")
    klog_dec(woke_ms as i64)
    klog(" ms after it; POLLNVAL: status ")
    klog_dec(nval)
    klog("\n")
    let ok_at_once: bool = at_once == 0 and at_once_ms < CONSOLE_POLL_SHORT_MS
    let ok_timed: bool = timed == 0 and timed_ms >= CONSOLE_POLL_SHORT_MS and timed_ms < CONSOLE_POLL_LATE_MS
    let ok_woke: bool = woke == CONSOLE_POLL_GOT_BYTE and woke_ms < CONSOLE_POLL_PROMPT_MS
    let ok_drained: bool = drained == 1 and byte[0] == CONSOLE_POLL_BYTE
    ok_at_once and ok_timed and ok_woke and ok_drained and nval == 0

# Yield until `pid` is parked on its wait set, or `us` has passed.
fn await_wait_set(pid: u64, us: u64) -> bool
    let deadline: u64 = deadline_after_us(us)
    while not parked_on_wait_set(pid) and not deadline_passed(deadline)
        sched_yield()
    parked_on_wait_set(pid)

# drv-mmio-map (#4720, RING1_DRIVER.md §5 and PR 5): DrvMmioMap maps a
# recorded window uncached into the caller only. No BAR is granted on this
# boot, so the window is a double: one RAM page with MMIO_TEST_BYTE at
# MMIO_TEST_OFFSET, recorded with no MSI-X table, beside a two-page window
# whose second page holds a (pretend) MSI-X table. On a scratch process
# (its own capability table and user PML4) the guarded window is refused
# and maps nothing, the double maps at DRV_MMIO_BASE onto the page with the
# MMIO leaf flags, and freeing the PML4 leaves the page allocated
# (PTE_DEVICE). The stub (mode 21, driver_stub.s) runs first: from ring 3
# it is refused without the handle, maps the double at DRV_MMIO_BASE and
# reads the byte, and a second map takes the next page; it exits with its
# first failed step, else 0.
const MMIO_TEST_OFFSET: u64 = 0x123
const MMIO_TEST_BYTE: u8 = 0xA5
const MMIO_TEST_LEN: u64 = 0x20
const MMIO_GUARDED_LEN: u64 = 0x1800
const MMIO_TABLE_BYTES: u64 = 16
const MMIO_SCRATCH_PID: u32 = 0xFFFFFD00
const PTE_HW_BITS: u64 = PTE_ACCESSED | PTE_DIRTY

# The scratch-process half: 0 if every check held, else its step.
fn mmio_scratch_steps(page: u64, double: u64, guarded: u64) -> i64
    if cap_table_alloc(MMIO_SCRATCH_PID) == 0 as *CapTable
        return 1
    let pml4: u64 = vmm_create_user_pml4()
    var step: i64 = 0
    if pml4 == 0
        step = 2
    else
        let d: u64 = packed_handle(cap_kernel_grant(MMIO_SCRATCH_PID, CAP_TYPE_MMIO, CAP_RIGHT_ALL, double))
        let g: u64 = packed_handle(cap_kernel_grant(MMIO_SCRATCH_PID, CAP_TYPE_MMIO, CAP_RIGHT_ALL, guarded))
        if drv_mmio_map(MMIO_SCRATCH_PID, pml4, g) != Errno.Inval as i64 or vmm_pte_in(pml4, DRV_MMIO_BASE) != 0
            step = 3
        else if drv_mmio_map(MMIO_SCRATCH_PID, pml4, d) != DRV_MMIO_BASE as i64
            step = 4
        else
            let pte: u64 = vmm_pte_in(pml4, DRV_MMIO_BASE)
            if (pte & PTE_ADDR_MASK) != page or (pte & ~PTE_ADDR_MASK & ~PTE_HW_BITS) != (drv_mmio_leaf() | PTE_PRESENT)
                step = 5
        vmm_free_pml4(pml4)
    cap_table_free_pid(MMIO_SCRATCH_PID)
    if step == 0 and pmm_range_has_free(page, PAGE_SIZE)
        step = 6                        # the exit freed a device frame
    step

fn drv_mmio_map_self_test() -> bool
    klog("\nTesting DrvMmioMap on a window double...\n")
    let page: u64 = pmm_alloc_page()
    if page == 0
        klog("  no page for the double\n")
        return false
    *(phys_to_virt(page + MMIO_TEST_OFFSET) as *u8) = MMIO_TEST_BYTE
    let double: u64 = vio_window_add(page + MMIO_TEST_OFFSET, MMIO_TEST_LEN, 0, phys_range_none(), phys_range_none(), phys_range_none(), 0).unwrap_or(0)
    let guarded: u64 = vio_window_add(page, MMIO_GUARDED_LEN, 0, phys_range(page + PAGE_SIZE, MMIO_TABLE_BYTES), phys_range_none(), phys_range_none(), 0).unwrap_or(0)
    var scratch: i64 = -1
    var status: i64 = -1
    if double != 0 and guarded != 0
        # The stub first: the scratch half frees a capability table, and a
        # table slot freed before the spawn would give the stub's grants a
        # later generation than the handles it was given.
        sched_start(proc_current_slot())
        let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_MMIO_MAP, DRV_TEST_HANDLE_A)
        if spawned > 0
            let pid: u64 = spawned as u64
            let d: u64 = packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_MMIO, CAP_RIGHT_ALL, double))
            if d != DRV_TEST_HANDLE_A
                klog("  grant gave handle 0x")
                klog_hex(d)
                klog("\n")
                process_mark_exit(pid)
            status = drv_stub_status(pid)
        sched_stop()
        scratch = mmio_scratch_steps(page, double, guarded)
    vio_window_remove(double)
    vio_window_remove(guarded)
    let kept: bool = not pmm_range_has_free(page, PAGE_SIZE)
    pmm_free_page(page)
    klog("  scratch step ")
    klog_dec(scratch)
    klog(", stub status ")
    klog_dec(status)
    if not kept
        klog(", the stub's exit freed the device page")
    klog("\n")
    scratch == 0 and status == 0 and kept

# drv-dma-alloc (#4721, RING1_DRIVER.md §5 and PR 5): DrvDmaAlloc gives the
# holder of an IRQ handle a zeroed contiguous run, write-back, at
# DRV_DMA_BASE. The stub (mode 22) checks the refusals (Perm, Inval, NoMem
# over 4 MiB, Fault), that the first run is zeroed at the window base with
# { iova 0, size 8192 } copied out, and that the next follows it. Its exit
# must give every page back: the PMM's free count is what it was before the
# spawn (the runs are freed once, by the PML4's teardown). Fresh RAM reads
# zero anyway, so the test first dirties the lowest free run of
# DMA_DIRTY_PAGES and frees it: the PMM allocates lowest-first, so the
# spawn's pages and then the stub's run come out of that block, and only
# zeroing makes them read 0.
const DRV_TEST_IRQ_DMA: u64 = 0xFFFF4721A
const DMA_DIRTY_PAGES: u64 = 256

fn dirty_free_run(pages: u64)
    let first: u64 = pmm_alloc_contig(pages)
    if first == 0
        klog("  no run to dirty: the zeroing check is weaker\n")
        return
    let words: *u64 = phys_to_virt(first) as *u64
    var w: u64 = 0
    while w < pages * PAGE_SIZE / 8
        *(words + w) = 0xFFFFFFFFFFFFFFFF
        w = w + 1
    var p: u64 = 0
    while p < pages
        pmm_free_page(first + p * PAGE_SIZE)
        p = p + 1

fn drv_dma_alloc_self_test() -> bool
    klog("\nTesting DrvDmaAlloc on a kernel-spawned process...\n")
    if not irq_object_register(DRV_TEST_IRQ_DMA, IRQ_NO_VECTOR)
        klog("  IRQ object not registered\n")
        return false
    sched_start(proc_current_slot())
    dirty_free_run(DMA_DIRTY_PAGES)
    let free: u64 = pmm_get_free_pages()
    var status: i64 = -1
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_DMA_ALLOC, DRV_TEST_HANDLE_A)
    if spawned > 0
        let pid: u64 = spawned as u64
        if packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, DRV_TEST_IRQ_DMA)) != DRV_TEST_HANDLE_A
            klog("  grant gave another handle\n")
            process_mark_exit(pid)
        status = drv_stub_status(pid)
    let after: u64 = pmm_get_free_pages()
    sched_stop()
    irq_object_unregister(DRV_TEST_IRQ_DMA)
    klog("  status ")
    klog_dec(status)
    klog(", free pages ")
    klog_dec(free as i64)
    klog(" before, ")
    klog_dec(after as i64)
    klog(" after\n")
    status == 0 and after == free

# drv-dma-free (#4725, RING1_DRIVER.md §5): DrvDmaFree gives a run back,
# and a later DrvDmaAlloc of the same process and device reuses its range.
# The stub (mode 23) checks the refusals (Perm, Inval for a part of a run
# or a run already freed), the reuse, that a fresh run starts past a freed
# range rather than over it, and that a run whose invalidation
# didn't finish is quarantined: its free still returns 0, and its VA is
# not handed out again. The hook drv_dma_force_stuck makes that one free
# report a unit that timed out (this boot has no domain to time out).
# After the exit, exactly that one page is missing from the PMM and on
# dma_quarantine, and nothing of the pid is left in the run table.
const DRV_TEST_IRQ_DMA_FREE: u64 = 0xFFFF4725A
const DMA_FREE_STUCK_VA: u64 = DRV_DMA_BASE + 20480

fn drv_dma_free_self_test() -> bool
    klog("\nTesting DrvDmaFree on a kernel-spawned process...\n")
    if not irq_object_register(DRV_TEST_IRQ_DMA_FREE, IRQ_NO_VECTOR)
        klog("  IRQ object not registered\n")
        return false
    sched_start(proc_current_slot())
    let free: u64 = pmm_get_free_pages()
    let quarantined: u64 = dma_quarantined_pages()
    drv_dma_force_stuck(DMA_FREE_STUCK_VA)
    var status: i64 = -1
    var pid: u64 = 0
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_DMA_FREE, DRV_TEST_HANDLE_A)
    if spawned > 0
        pid = spawned as u64
        if packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, DRV_TEST_IRQ_DMA_FREE)) != DRV_TEST_HANDLE_A
            klog("  grant gave another handle\n")
            process_mark_exit(pid)
        status = drv_stub_status(pid)
    drv_dma_force_stuck(0)
    let after: u64 = pmm_get_free_pages()
    let held: u32 = dma_runs_held(pid as u32)
    sched_stop()
    irq_object_unregister(DRV_TEST_IRQ_DMA_FREE)
    let newly: u64 = dma_quarantined_pages() - quarantined
    klog("  status ")
    klog_dec(status)
    klog(", free pages ")
    klog_dec(free as i64)
    klog(" before, ")
    klog_dec(after as i64)
    klog(" after, ")
    klog_dec(newly as i64)
    klog(" quarantined, ")
    klog_dec(held as i64)
    klog(" runs left\n")
    status == 0 and after == free - 1 and newly == 1 and held == 0

# shm-retire (#4729, RING1_DRIVER.md "Shared object" and "Wait and notify",
# PR 6b): retire, the detach timeout, reclaim and the replacement handoff on
# kernel-spawned processes (driver_stub.s modes 10-14). Each process's
# handle is a fresh table's first grant, RETIRE_H.
#   * Producer-first and consumer-first: an exiter (mode 11) and a survivor
#     (mode 10) map one object; the one that holds the IRQ cap is the
#     driver. The exiter stores a marker and exits: its exit retires the
#     object and posts DRIVER_GONE (the driver exited) or PEER_CLOSE (the
#     driver survives) on the survivor. With the exiter gone the object
#     still exists, mapped once, its page not free; pid 1 then posts DATA,
#     and the survivor reads the marker and detaches, which reclaims it.
#   * A hung peer (mode 12) sees PEER_CLOSE and keeps loading from the
#     mapping. Half the timeout later it is still alive and mapped; the
#     timeout unmaps it, its load faults (status 142), and the object is
#     reclaimed.
#   * Replacement: the service (mode 11) exits under a surviving driver
#     (mode 13). net_frame_replace makes a new object for the replacement
#     service (mode 14), mapped in it before it runs and not in the driver,
#     whose inbox gets {handle, ATTACH}; the retired object stays while the
#     driver maps it. The driver detaches, maps the new handle at a new
#     address and publishes there; the service reads it.
const DRIVER_STUB_SURVIVOR: u64 = 10
const DRIVER_STUB_EXITER: u64 = 11
const DRIVER_STUB_HUNG: u64 = 12
const DRIVER_STUB_REPLACED: u64 = 13
const DRIVER_STUB_FRESH: u64 = 14
const RETIRE_H: u64 = 1 << 32
const RETIRE_TEST_IRQ: u64 = 0xFFFF4729A
# How long the hung peer gets to die after its object retires: the timeout,
# and room for the tick that runs the sweep.
const RETIRE_HUNG_WAIT_US: u64 = 3000000

# A read-write shm handle for `obj` in `pid`, packed.
fn retire_grant(pid: u64, obj: u64) -> u64
    packed_handle(cap_kernel_grant(pid as u32, CAP_TYPE_SHM, CAP_RIGHT_READ | CAP_RIGHT_WRITE, obj))

# The device IRQ cap that makes `pid` the driver.
fn retire_grant_irq(pid: u64)
    cap_kernel_grant(pid as u32, CAP_TYPE_IRQ, CAP_RIGHT_READ, RETIRE_TEST_IRQ)

# Spawn the exiter on `obj` (the driver if `driver`) and wait for its exit;
# its status, or -1.
fn retire_run_exiter(obj: u64, driver: bool) -> i64
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_EXITER, 0)
    if spawned <= 0
        return -1
    let pid: u64 = spawned as u64
    if retire_grant(pid, obj) != RETIRE_H
        process_mark_exit(pid)
    if driver
        retire_grant_irq(pid)
    process_wait(spawned as i32)

# Producer-first (`driver_exits`) or consumer-first.
fn retire_pair(driver_exits: bool) -> bool
    let obj: u64 = shm_create(1).unwrap_or(0)
    if obj == 0
        klog("  no object\n")
        return false
    let frame: u64 = shm_page(obj, 0)
    var bit: u32 = EVENT_PEER_CLOSE
    if driver_exits
        bit = EVENT_DRIVER_GONE
    var kept: bool = false
    var exiter: i64 = -1
    var survivor: i64 = -1
    let parks: u64 = drv_irq_wait_park_count()
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_SURVIVOR, bit as u64)
    if spawned > 0
        let pid: u64 = spawned as u64
        let h: u64 = retire_grant(pid, obj)
        if not driver_exits
            retire_grant_irq(pid)
        if h == RETIRE_H and await_park(pid, parks, DRV_TEST_PARK_US)
            exiter = retire_run_exiter(obj, driver_exits)
            # The exiter is gone and the survivor has not detached: the
            # object and its page stay.
            kept = shm_exists(obj) and shm_map_count(obj) == 1 and not pmm_range_has_free(frame, PAGE_SIZE)
            disable_interrupts()
            shm_latch_post(obj, pid, EVENT_DATA)
            enable_interrupts()
        else
            process_mark_exit(pid)
        survivor = drv_stub_status(pid)
    let reclaimed: bool = not shm_exists(obj)
    if not reclaimed
        shm_retire(obj, 0, 0)
    klog("  ")
    if driver_exits
        klog("driver exits first")
    else
        klog("service exits first")
    klog(": exiter ")
    klog_dec(exiter)
    klog(", survivor ")
    klog_dec(survivor)
    if not kept
        klog(", the object did not outlive the exiter")
    if not reclaimed
        klog(", the survivor's detach did not reclaim it")
    klog("\n")
    exiter == 0 and survivor == 0 and kept and reclaimed

fn retire_hung() -> bool
    let obj: u64 = shm_create(1).unwrap_or(0)
    if obj == 0
        klog("  no object\n")
        return false
    var exiter: i64 = -1
    var status: i64 = -1
    var mapped: bool = false
    var timed_out: bool = false
    let parks: u64 = drv_irq_wait_park_count()
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_HUNG, 0)
    if spawned > 0
        let pid: u64 = spawned as u64
        if retire_grant(pid, obj) == RETIRE_H and await_park(pid, parks, DRV_TEST_PARK_US)
            let timeouts: u64 = shm_detach_timeout_count()
            exiter = retire_run_exiter(obj, false)
            # Half the timeout after the retire, the hung peer still maps it.
            let half: u64 = deadline_after_us(SHM_DETACH_TIMEOUT_MS * US_PER_MS / 2)
            while not deadline_passed(half)
                sched_yield()
            var code: i64 = 0
            mapped = proc_child_status(pid, @code) == PROC_CHILD_LIVE and shm_exists(obj) and shm_map_count(obj) == 1
            let limit: u64 = deadline_after_us(RETIRE_HUNG_WAIT_US)
            while proc_child_status(pid, @code) == PROC_CHILD_LIVE and not deadline_passed(limit)
                sched_yield()
            timed_out = shm_detach_timeout_count() == timeouts + 1
            if proc_child_status(pid, @code) == PROC_CHILD_LIVE
                process_mark_exit(pid)
        else
            process_mark_exit(pid)
        status = process_wait(spawned as i32)
    let reclaimed: bool = not shm_exists(obj)
    if not reclaimed
        shm_retire(obj, 0, 0)
    klog("  hung peer: exiter ")
    klog_dec(exiter)
    klog(", hung ")
    klog_dec(status)
    if not mapped
        klog(", it was unmapped before the timeout")
    if not timed_out
        klog(", the timeout did not unmap it")
    if not reclaimed
        klog(", the object was not reclaimed")
    klog("\n")
    exiter == 0 and status == DRIVER_FAULT_STATUS and mapped and timed_out and reclaimed

fn retire_replace() -> bool
    let old: u64 = shm_create(1).unwrap_or(0)
    if old == 0
        klog("  no object\n")
        return false
    var service: i64 = -1
    var driver: i64 = -1
    var fresh: i64 = -1
    var handed: bool = false
    var new_obj: u64 = 0
    let parks: u64 = drv_irq_wait_park_count()
    let spawned: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_REPLACED, 0)
    if spawned > 0
        let drv: u64 = spawned as u64
        if retire_grant(drv, old) == RETIRE_H and await_park(drv, parks, DRV_TEST_PARK_US)
            service = retire_run_exiter(old, false)
            let second: i64 = process_spawn_image(driver_stub(), DRIVER_STUB_FRESH, 0)
            if second > 0
                let h: i64 = net_frame_replace(second as u32, drv as u32, 1)
                new_obj = held_shm_object(second as u32, h)
                # A new id, mapped in the new service only, a latch and an
                # ATTACH record for the driver; the retired object stays
                # while the driver maps it.
                handed = h == RETIRE_H as i64 and new_obj > old and shm_map_count(new_obj) == 1 and shm_latch_held(new_obj, drv) and waitset_inbox_len(drv) == 1 and shm_exists(old) and shm_map_count(old) == 1
                if h < 0
                    process_mark_exit(second as u64)
                fresh = drv_stub_status(second as u64)
        else
            process_mark_exit(drv)
        driver = drv_stub_status(drv)
    net_frame_register(0, 0)
    let reclaimed: bool = not shm_exists(old) and (new_obj == 0 or not shm_exists(new_obj))
    if shm_exists(old)
        shm_retire(old, 0, 0)
    if new_obj != 0 and shm_exists(new_obj)
        shm_retire(new_obj, 0, 0)
    klog("  replacement: service ")
    klog_dec(service)
    klog(", driver ")
    klog_dec(driver)
    klog(", new service ")
    klog_dec(fresh)
    if not handed
        klog(", the handoff was not a new object with an ATTACH record")
    if not reclaimed
        klog(", an object outlived its holders")
    klog("\n")
    service == 0 and driver == 0 and fresh == 0 and handed and reclaimed

fn shm_retire_self_test() -> bool
    klog("\nTesting shared-object retire, detach timeout and replacement...\n")
    if not irq_object_register(RETIRE_TEST_IRQ, IRQ_NO_VECTOR)
        klog("  IRQ object not registered\n")
        return false
    sched_start(proc_current_slot())
    let producer_first: bool = retire_pair(true)
    let consumer_first: bool = retire_pair(false)
    let hung: bool = retire_hung()
    let replaced: bool = retire_replace()
    sched_stop()
    irq_object_unregister(RETIRE_TEST_IRQ)
    producer_first and consumer_first and hung and replaced

# The driver-* tests, as pid 1 with its scheduler stopped (on pid 1's kernel
# stack: boot_process_tests).
fn driver_process_tests()
    boot_test_result("driver-enter", driver_enter_self_test())
    boot_test_result("driver-fault", driver_fault_self_test())
    boot_test_result("driver-preempt", driver_preempt_self_test())
    boot_test_result("driver-reap", driver_reap_self_test())
    boot_test_result("drv-irq-wait", drv_irq_wait_self_test())
    boot_test_result("console-poll", console_poll_self_test())
    boot_test_result("drv-mmio-map", drv_mmio_map_self_test())
    boot_test_result("drv-dma-alloc", drv_dma_alloc_self_test())
    boot_test_result("drv-dma-free", drv_dma_free_self_test())
    boot_test_result("shm-wait", shm_wait_self_test())
    boot_test_result("net-attach", net_attach_self_test())
    boot_test_result("net-info", net_info_self_test())
    boot_test_result("shm-retire", shm_retire_self_test())

# The boot-test mode tests that need SYSCALL set up (syscall_init) and run
# with no process yet, after boot_self_tests: kernel_main calls them before
# postinit_diagnostics. They leave what run_init expects (no Proc, the
# scheduler not running). Logs the "[boot-test] N passed, M failed" summary
# for both phases, and halts on a failure.
pub fn boot_process_tests()
    klog("\n=== Boot-test mode: process tests ===\n")
    boot_test_result("proc-create-init", proc_create_init_self_test())
    # The driver-* tests run as pid 1, on its own kernel stack: the boot
    # stack is not mapped in a child's page table. Pid 1 is gone again
    # afterwards, as run_init expects.
    process_create_init()
    kstack_call(driver_process_tests as u64, kstack_top(proc_current_slot()))
    process_destroy_init()
    klog("[boot-test] ")
    klog_dec(boot_tests_passed as i64)
    klog(" passed, ")
    klog_dec(boot_tests_failed as i64)
    klog(" failed\n")
    if boot_tests_failed != 0
        klog("\n*** KERNEL PANIC ***\n")
        klog("boot-test mode: a kernel self-test failed\n")
        halt_loop()

# ============================================================================
# Diagnostics (after SYSCALL setup)
# ============================================================================

# The TX burst: more frames than the NIC's 256-entry TX ring holds, sent in
# back-to-back groups so several are in flight at once (AGAST #4073).
const NET_TX_BURST: u32 = 300
const NET_TX_BURST_GROUP: u32 = 4

# Ping the gateway NET_TX_BURST times, NET_TX_BURST_GROUP requests at a time
# with no wait between them, then poll for that group's replies. Logs
#   [net] TX burst: sent=S/300 replies=R
# S counts net_send successes: a driver that never reclaims used TX
# descriptors runs out of them after 256 sends and fails the rest. R counts
# distinct reply seqs: a driver that writes every frame into the same TX
# buffer overwrites a group's earlier requests before the device reads them,
# so their seqs never come back. tools/test_msix_boot.sh checks both.
fn network_tx_burst()
    let gateway: *u8 = ip_get_gateway()
    var mac: [6]u8
    var tries: i32 = 0
    while arp_cache_lookup(gateway, @mac[0]) < 0 and tries < 50
        arp_send_request(gateway)
        var p: i32 = 0
        while p < 100
            net_poll()
            p = p + 1
        tries = tries + 1
    if arp_cache_lookup(gateway, @mac[0]) < 0
        klog("[net] TX burst: gateway never answered ARP\n")
        return

    let base: u32 = icmp_distinct_reply_count()
    var sent: u32 = 0
    var n: u32 = 0
    while n < NET_TX_BURST
        var g: u32 = 0
        var group_sent: u32 = 0
        while g < NET_TX_BURST_GROUP and n < NET_TX_BURST
            if icmp_ping(gateway) == 0
                group_sent = group_sent + 1
            g = g + 1
            n = n + 1
        sent = sent + group_sent
        # Wait (bounded) for this group's replies
        var polls: i32 = 0
        while icmp_distinct_reply_count() - base < sent and polls < 2000
            net_poll()
            delay_us(50)
            polls = polls + 1
    # Late replies
    var tail: i32 = 0
    while tail < 200
        net_poll()
        tail = tail + 1

    klog("[net] TX burst: sent=")
    klog_dec(sent as i64)
    klog("/")
    klog_dec(NET_TX_BURST as i64)
    klog(" replies=")
    klog_dec((icmp_distinct_reply_count() - base) as i64)
    klog("\n")

# AGAST #1851: how long the EC2 acceptance boot keeps polling for an inbound
# ping from the peer instance after DHCP. Bounded, and only armed by the
# \harland\net-responder boot option (the acceptance image), so no other
# boot pays for it. It runs before the TX burst so the peer's first packets
# meet a quiet RX path, and a peer that answers ends the wait immediately.
const NET_PEER_PING_WINDOW_US: u64 = 240000000   # 240 seconds

# The DHCP window: 2 s, as its old 1000 polls 2 ms apart took. The gateway
# ping goes out once configured, but not before 200 ms in (the old 100th poll).
const NET_DHCP_WINDOW_US: u64 = 2000000
const NET_DHCP_PING_AFTER_US: u64 = 200000

# Only called when the boot option asked for it (AGAST #4335): this probes
# every NIC driver, so on hardware whose driver is broken it can panic.
fn network_dhcp_ping(run_net_responder: bool)
    # Initialize network stack (includes VirtIO-net driver)
    klog("\n=== Initializing Network Stack ===\n")
    let net_result: i32 = net_stack_init()
    if net_result == 0
        klog("  Network stack ready!\n")

        # Start DHCP configuration
        klog("  Starting DHCP...\n")
        net_configure_dhcp()

        # Poll for packets for the DHCP window. Interrupts are on for this
        # window only (the kernel otherwise boots with IF=0), so the NIC's
        # MSI-X interrupts are delivered and counted (#1852). Between polls
        # the CPU sleeps on the NIC's RX vector (#3631); a NIC that can't
        # (ENA, no MSI-X) waits 2 ms instead, as every NIC used to. The
        # window is timed, so frames that end a wait early don't shorten it.
        klog("  Polling for network packets...\n")
        enable_interrupts()
        let window_end: u64 = deadline_after_us(NET_DHCP_WINDOW_US)
        let ping_after: u64 = deadline_after_us(NET_DHCP_PING_AFTER_US)
        var ping_sent: u8 = 0
        var arp_pending: u8 = 0
        while not deadline_passed(window_end)
            net_poll()
            if not net_wait_rx()
                delay_us(2000)

            # If we got configured, try a ping
            if net_is_configured() and ping_sent == 0 and deadline_passed(ping_after)
                if arp_pending == 0
                    klog("\n  Got IP! Pinging gateway...\n")
                let gateway: *u8 = ip_get_gateway()
                let ping_result: i32 = icmp_ping(gateway)
                if ping_result < 0
                    # ARP lookup needed, wait for ARP reply
                    arp_pending = 1
                else
                    ping_sent = 1
                    klog("  ICMP echo request sent!\n")
        disable_interrupts()

        if virtio_net_msix_enabled()
            klog("[msix] virtio-net interrupts: ")
            klog_dec(virtio_net_irq_count())
            klog("\n")
            klog("[msix] virtio-net rx waits: ")
            klog_dec(virtio_net_rx_wait_count())
            klog(", halted: ")
            klog_dec(virtio_net_rx_halt_count())
            klog("\n")

        if net_is_configured()
            klog("\n  Network configured!\n")
            ip_print_config()
            # The acceptance peer pings this instance; answer it from the
            # serial log's point of view before the TX burst starts moving
            # the device's queues (#1851).
            if run_net_responder and net_device_type() == NETDEV_TYPE_ENA
                network_wait_for_peer_ping()
            network_tx_burst()
        else
            klog("\n  DHCP timeout (no response in test window)\n")
    else
        klog("  Network stack initialization failed\n")

# AGAST #1851: keep polling for a peer instance's ping. The QEMU NIC gate has
# no peer, so this runs only on ENA and only when the boot image carries the
# \harland\net-responder marker. net_poll answers the peer's ARP request and
# replies to its ICMP echo request; icmp.ritz logs both, and the counters
# below are printed so the serial log carries the totals as evidence.
fn network_wait_for_peer_ping()
    klog("\n  Waiting up to 240s for a peer ping...\n")
    let deadline: u64 = deadline_after_us(NET_PEER_PING_WINDOW_US)
    # Once a request has been answered, keep answering for a short grace
    # period: if the first reply is lost, the peer's next ping still gets an
    # answer instead of finding us gone.
    var answered: u8 = 0
    var grace_deadline: u64 = 0
    while not deadline_passed(deadline)
        net_poll()
        if icmp_echo_request_count() > 0 and icmp_echo_reply_sent_count() > 0
            if answered == 0
                answered = 1
                grace_deadline = deadline_after_us(5000000)   # 5 seconds
            else if deadline_passed(grace_deadline)
                break
        delay_us(1000)

    if icmp_echo_request_count() > 0
        klog("[net] peer ping: requests=")
        klog_dec(icmp_echo_request_count() as i64)
        klog(" replies=")
        klog_dec(icmp_echo_reply_sent_count() as i64)
        klog("\n")
    else
        klog("[net] peer ping: no echo request within 240s\n")

# Switch the NVMe controllers nvme_probe found at boot (polled: the APIC was
# not up yet) to MSI-X, then read each namespace with interrupts on, so every
# command waits for its completion interrupt (AGAST #3630, per-CPU queues
# #4220). Each started AP is then called through an IPI and reads the end of
# its own disk through its own queue and vector. Logs
#   [msix] nvme interrupts: N, commands waited: W, completions without one: M
#   [msix] nvme waits halted: H
#   [msix] nvme idle wait halted: P
# (W counts every command since MSI-X went on that waited for its interrupt;
# H the hlts those waits slept in, 0 when every interrupt beat its wait's
# first check or the wait parked a process; P the hlts of one watchdog round
# of the same wait with no command outstanding, AGAST #4246.)
# tools/test_msix_boot.sh wants N > 0, W > 0, M = 0, 0 < P <= 64 and the
# read's fingerprint.
fn nvme_msix_check()
    if nvme_enable_msix() == 0
        return
    enable_interrupts()
    nvme_msix_read_check()
    # An AP-issued command goes through its own I/O queue and vector
    # (AGAST #4220): each started AP reads the end of its disk, and logs
    # whether it waited for an interrupt delivered to it.
    ap_run_nvme_probe()
    let idle_halts: u64 = nvme_irq_idle_probe()
    disable_interrupts()
    klog("[msix] nvme interrupts: ")
    klog_dec(nvme_irq_count())
    klog(", commands waited: ")
    klog_dec(nvme_irq_wait_count())
    klog(", completions without one: ")
    klog_dec(nvme_irq_missed_count())
    klog("\n")
    klog("[msix] nvme waits halted: ")
    klog_dec(nvme_irq_halt_count())
    klog("\n")
    klog("[msix] nvme idle wait halted: ")
    klog_dec(idle_halts)
    klog("\n")

fn virtio_blk_check()
    # Initialized early, for the initramfs; its read test is a boot-test
    # mode self-test (boot_self_tests)
    let blk_dev: *VirtioBlkDevice = virtio_blk_get_device()
    if blk_dev != 0 as *VirtioBlkDevice
        virtio_blk_msix_check(blk_dev)

# Disk 0's MSI-X wait (AGAST #3631): read VIRTIO_BLK_MSIX_READS sectors
# polled (IF=0), then again with interrupts on, when each request sleeps on
# the disk's vector, and log
#   [msix] virtio-blk interrupts: N, requests waited: W, halted: H, data: same|DIFFERENT
# tools/test_msix_boot.sh wants N > 0, W > 0 and "same": the interrupt-driven
# reads return what the polled ones did. (H may be 0: QEMU often completes a
# request before its wait first checks.)
const VIRTIO_BLK_MSIX_READS: u64 = 8

fn virtio_blk_msix_check(dev: *VirtioBlkDevice)
    if virtio_blk_msix_vector(0) == 0
        return
    var polled: [512]u8
    var waited: [512]u8
    var same: bool = true
    var failed: bool = false
    var s: u64 = 0
    while s < VIRTIO_BLK_MSIX_READS
        if virtio_blk_read(dev, s, 1, @polled[0]) != 0
            failed = true
        enable_interrupts()
        if virtio_blk_read(dev, s, 1, @waited[0]) != 0
            failed = true
        disable_interrupts()
        var i: i32 = 0
        while i < 512
            if polled[i] != waited[i]
                same = false
            i = i + 1
        s = s + 1
    klog("[msix] virtio-blk interrupts: ")
    klog_dec(virtio_blk_irq_count(0))
    klog(", requests waited: ")
    klog_dec(virtio_blk_irq_wait_count())
    klog(", halted: ")
    klog_dec(virtio_blk_irq_halt_count())
    if failed
        klog(", data: FAILED\n")
    else if same
        klog(", data: same\n")
    else
        klog(", data: DIFFERENT\n")

# PCI listing and MSI-X interrupt checks, in boot order. The
# network self-tests are a boot option (AGAST #4335): when the loader did
# not find the boot volume's \harland\net-selftest marker (every boot except
# QEMU's NIC gate), the NIC is left alone until init is up, so a misbehaving
# driver cannot keep init_interactive and rzsh from starting.
pub fn postinit_diagnostics(run_net_selftests: bool, run_net_responder: bool)
    # PCI already initialized early - just print discovered devices
    klog("\n=== PCI Devices ===\n")
    pci_print_all_devices()
    msix_print_all()

    if run_net_selftests
        network_dhcp_ping(run_net_responder)
    else
        klog("[net] Network self-tests skipped: boot option \\harland\\net-selftest not set\n")

    nvme_msix_check()

    virtio_blk_check()
