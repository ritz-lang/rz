# Harland Kernel Post-Init Self-Tests and Diagnostics
#
# Moved out of kernel_main (AGAST #2752). kernel_main runs
# postinit_self_tests once the scheduler is up, prints its success banner
# and sets up SYSCALL, then runs postinit_diagnostics before starting
# /bin/init. Their serial output is unchanged by the move; #1887 gates
# them later. The network diagnostics are opt-in since #4335: a
# misbehaving NIC made a real-hardware boot panic before init ran.

import serial { prints, serial_print_hex, serial_print_dec, serial_write_byte }
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_alloc_page_high, pmm_free_page, pmm_get_free_pages, pmm_get_total_pages }
import mm.vmm { PTE_WRITABLE, vmm_map_page, vmm_unmap_page, vmm_virt_to_phys, phys_to_virt }
import mm.heap { kalloc, kfree, heap_get_free }
import ipc.message { Message, MSG_FLAG_NONE }
import ipc.channel { ChannelEndpoint, ChannelPair, channel_create, channel_send, channel_recv }
import drivers.pci { pci_print_all_devices }
import drivers.msix { msix_print_all }
import drivers.virtio.net { virtio_net_msix_enabled, virtio_net_irq_count }
import drivers.nvme.nvme { nvme_enable_msix, nvme_msix_read_check, nvme_irq_count, nvme_irq_wait_count, nvme_irq_missed_count, nvme_irq_halt_count, nvme_irq_idle_probe }
import io { enable_interrupts, disable_interrupts, halt_loop }
import arch.x86_64.tsc { delay_us, deadline_after_us, deadline_passed }
import arch.x86_64.apcall { ap_run_nvme_probe }
import drivers.virtio.blk { VirtioBlkDevice, virtio_blk_get_device, virtio_blk_test }
import net.stack { net_stack_init, net_poll, net_configure_dhcp, net_is_configured, net_device_type }
import net.ip { ip_get_gateway, ip_print_config }
import net.icmp { icmp_ping, icmp_distinct_reply_count, icmp_echo_request_count, icmp_echo_reply_sent_count }
import net.arp { arp_cache_lookup, arp_send_request }
import drivers.netdev { NETDEV_TYPE_ENA }
import loader.elf { test_elf_loader }
import syscall.runtime.memory { munmap_self_test, mmap_failure_self_test, mmap_overlap_self_test, mmap_cursor_self_test }

# ============================================================================
# Self-tests (need boot info: they allocate and map memory)
# ============================================================================

fn vmm_self_test()
    prints("\nTesting Virtual Memory...\n")

    # Verify identity mapping for kernel
    let test_vaddr: u64 = 0x100000
    let resolved: u64 = vmm_virt_to_phys(test_vaddr)
    prints("  virt_to_phys(0x100000) = ")
    serial_print_hex(resolved)
    prints("\n")

    # Allocate a new page and map it at a high address
    let new_page: u64 = pmm_alloc_page()
    prints("  Allocated page: ")
    serial_print_hex(new_page)
    prints("\n")

    # Map at a test virtual address in higher-half kernel space
    # Using address past the 1GB pre-mapped region (which uses 2MB huge pages)
    let test_map_vaddr: u64 = 0xFFFFFFFFD0000000
    let map_result: i32 = vmm_map_page(test_map_vaddr, new_page, PTE_WRITABLE)
    prints("  Map 0xFFFFFFFFD0000000 -> result: ")
    serial_print_dec(map_result as u64)
    prints("\n")

    if map_result == 0
        # Verify the mapping
        let verify_phys: u64 = vmm_virt_to_phys(test_map_vaddr)
        prints("  virt_to_phys(0xFFFFFFFFD0000000) = ")
        serial_print_hex(verify_phys)
        prints("\n")

        # Write to the mapped page (via identity-mapped physical address)
        let data_ptr: *u64 = new_page as *u64
        *data_ptr = 0xDEADBEEFCAFEBABE

        # Read via the new virtual mapping
        let mapped_ptr: *u64 = test_map_vaddr as *u64
        let read_val: u64 = *mapped_ptr
        prints("  Wrote 0xDEADBEEFCAFEBABE, read: ")
        serial_print_hex(read_val)
        prints("\n")

        if read_val == 0xDEADBEEFCAFEBABE
            prints("  VMM test PASSED!\n")
        else
            prints("  VMM test FAILED!\n")

        # Unmap and free
        vmm_unmap_page(test_map_vaddr)
        pmm_free_page(new_page)
    else
        prints("  Mapping failed!\n")

fn higher_half_self_test()
    # Test higher-half mapping
    prints("\nTesting Higher-Half Mapping...\n")

    # The kernel physical address 0x100000 should also be accessible
    # at virtual address 0xFFFFFFFF80100000 (higher-half)
    let kernel_virt_base: u64 = 0xFFFFFFFF80000000
    let kernel_phys: u64 = 0x100000
    let hh_vaddr: u64 = kernel_virt_base + kernel_phys

    # Read from physical address (identity mapped)
    let phys_ptr: *u64 = kernel_phys as *u64
    let phys_val: u64 = *phys_ptr

    # Read from higher-half virtual address
    let hh_ptr: *u64 = hh_vaddr as *u64
    let hh_val: u64 = *hh_ptr

    prints("  Read from 0x100000: ")
    serial_print_hex(phys_val)
    prints("\n")
    prints("  Read from 0xFFFFFFFF80100000: ")
    serial_print_hex(hh_val)
    prints("\n")

    if phys_val == hh_val
        prints("  Higher-half mapping PASSED!\n")
    else
        prints("  Higher-half mapping FAILED!\n")

fn heap_self_test()
    # Test heap allocations
    prints("\nTesting Kernel Heap...\n")

    let alloc1: *u8 = kalloc(64)
    prints("  kalloc(64) = ")
    serial_print_hex(alloc1 as u64)
    prints("\n")

    let alloc2: *u8 = kalloc(128)
    prints("  kalloc(128) = ")
    serial_print_hex(alloc2 as u64)
    prints("\n")

    let alloc3: *u8 = kalloc(256)
    prints("  kalloc(256) = ")
    serial_print_hex(alloc3 as u64)
    prints("\n")

    prints("  Free space: ")
    serial_print_dec(heap_get_free())
    prints(" bytes\n")

    # Write to allocated memory
    let test_ptr: *u64 = alloc1 as *u64
    *test_ptr = 0x1234567890ABCDEF
    let read_back: u64 = *test_ptr
    prints("  Write/read test: ")
    serial_print_hex(read_back)
    prints("\n")

    # Free middle allocation
    kfree(alloc2)
    prints("  Freed alloc2\n")
    prints("  Free space: ")
    serial_print_dec(heap_get_free())
    prints(" bytes\n")

    # Reallocate should reuse freed block
    let alloc4: *u8 = kalloc(100)
    prints("  kalloc(100) = ")
    serial_print_hex(alloc4 as u64)
    prints("\n")

    if read_back == 0x1234567890ABCDEF
        prints("  Heap test PASSED!\n")
    else
        prints("  Heap test FAILED!\n")

    # Cleanup
    kfree(alloc1)
    kfree(alloc3)
    kfree(alloc4)

fn ipc_self_test()
    # Test IPC channels
    prints("\nTesting IPC Channels...\n")
    prints("  [1] Creating channel...\n")

    # Create a channel pair
    let pair: ChannelPair = channel_create(1, 2)
    prints("  [2] Channel created\n")
    if pair.endpoint_a != 0 as *ChannelEndpoint
        prints("  Channel created, id=")
        serial_print_dec(pair.channel_id as u64)
        prints("\n")

        # Allocate message on heap (4KB struct is too big for stack)
        prints("  [3] Allocating send message on heap...\n")
        let send_msg: *Message = kalloc(4096) as *Message
        if send_msg == 0 as *Message
            prints("  Failed to allocate send_msg!\n")
        else
            # Initialize the message
            (*send_msg).header.msg_type = 42
            (*send_msg).header.flags = MSG_FLAG_NONE
            (*send_msg).header.seq = 0
            (*send_msg).header.payload_len = 10

            let payload_str: *u8 = c"Hello IPC!"
            var i: i32 = 0
            while i < 10
                (*send_msg).payload[i] = *(payload_str + i as i64)
                i = i + 1

            prints("  [4] Sending message...\n")
            let send_result: i32 = channel_send(pair.endpoint_a, send_msg, 1)
            prints("  Send result: ")
            serial_print_dec(send_result as u64)
            prints("\n")

            # Allocate receive buffer
            prints("  [5] Allocating recv message on heap...\n")
            let recv_msg: *Message = kalloc(4096) as *Message
            if recv_msg == 0 as *Message
                prints("  Failed to allocate recv_msg!\n")
            else
                var sender: u32 = 0
                prints("  [6] Receiving message...\n")
                let recv_result: i32 = channel_recv(pair.endpoint_b, recv_msg, @sender)
                prints("  Recv result: ")
                serial_print_dec(recv_result as u64)
                prints(", msg_type=")
                serial_print_dec((*recv_msg).header.msg_type as u64)
                prints(", sender=")
                serial_print_dec(sender as u64)
                prints("\n")

                # Check payload
                prints("  Payload: ")
                var k: i32 = 0
                while k < (*recv_msg).header.payload_len as i32 and k < 20
                    serial_write_byte((*recv_msg).payload[k])
                    k = k + 1
                prints("\n")

                if (*recv_msg).header.msg_type == 42 and sender == 1
                    prints("  IPC test PASSED!\n")
                else
                    prints("  IPC test FAILED!\n")

                kfree(recv_msg as *u8)

            kfree(send_msg as *u8)

        # Close channels - skip for now due to page fault
        # channel_close(pair.endpoint_a)
        # channel_close(pair.endpoint_b)
        prints("  (channel close skipped)\n")
    else
        prints("  Channel creation failed!\n")

    # Note: channel_debug_print causes page fault - skipped for now
    # channel_debug_print()

# RAM above 4 GiB (AGAST #4183): pmm hands out pages from the top of RAM and
# the kernel reaches them through the physmap. Takes HIGH_TEST_PAGES pages
# with pmm_alloc_page_high (the topmost free ones), writes a pattern to the
# first and last word of each through phys_to_virt, reads them all back and
# frees them. A physmap that stops short of top-of-RAM faults here; a pmm
# that drops RAM above 4 GiB hands out a low page. Logs
#   [pmm] above-4G self-test: <n> pages from 0x... PASSED
# or "skipped" when the machine has no RAM above 4 GiB. False on failure.
const FOUR_GIB: u64 = 0x100000000
const HIGH_TEST_PAGES: i32 = 16

fn pmm_high_memory_self_test() -> bool
    if pmm_get_total_pages() * PAGE_SIZE <= FOUR_GIB
        prints("[pmm] above-4G self-test: skipped (no RAM above 4 GiB)\n")
        return true
    let free_before: u64 = pmm_get_free_pages()
    var pages: [16]u64
    var ok: bool = true
    var i: i32 = 0
    while i < HIGH_TEST_PAGES
        pages[i] = pmm_alloc_page_high()
        if pages[i] < FOUR_GIB
            prints("[pmm] above-4G self-test: got page ")
            serial_print_hex(pages[i])
            prints("\n")
            ok = false
        else
            let first: *u64 = phys_to_virt(pages[i]) as *u64
            let last: *u64 = phys_to_virt(pages[i] + PAGE_SIZE - 8) as *u64
            *first = pages[i] ^ 0x5A5A5A5A5A5A5A5A
            *last = ~pages[i]
        i = i + 1
    i = 0
    while i < HIGH_TEST_PAGES
        if pages[i] >= FOUR_GIB
            let first: *u64 = phys_to_virt(pages[i]) as *u64
            let last: *u64 = phys_to_virt(pages[i] + PAGE_SIZE - 8) as *u64
            if *first != (pages[i] ^ 0x5A5A5A5A5A5A5A5A) or *last != ~pages[i]
                prints("[pmm] above-4G self-test: readback mismatch at ")
                serial_print_hex(pages[i])
                prints("\n")
                ok = false
        if pages[i] != 0
            pmm_free_page(pages[i])
        i = i + 1
    if pmm_get_free_pages() != free_before
        prints("[pmm] above-4G self-test: pages leaked\n")
        ok = false
    if not ok
        return false
    prints("[pmm] above-4G self-test: ")
    serial_print_dec(HIGH_TEST_PAGES as u64)
    prints(" pages from 0x")
    serial_print_hex(pages[0])
    prints(" PASSED\n")
    return true

# Memory and IPC self-tests, in boot order.
pub fn postinit_self_tests(has_boot_info: bool)
    if has_boot_info
        vmm_self_test()
        higher_half_self_test()
        heap_self_test()
        ipc_self_test()
        # A leak here is a regression the boot tests must catch (#1443):
        # they fail on KERNEL PANIC, not on a FAILED line.
        if not munmap_self_test()
            prints("\n*** KERNEL PANIC ***\n")
            prints("munmap self-test failed\n")
            halt_loop()
        # A failed mmap must not leak what it mapped before failing (#3552).
        if not mmap_failure_self_test()
            prints("\n*** KERNEL PANIC ***\n")
            prints("mmap failure self-test failed\n")
            halt_loop()
        # RAM above 4 GiB is allocatable and reachable (#4183).
        if not pmm_high_memory_self_test()
            prints("\n*** KERNEL PANIC ***\n")
            prints("pmm above-4G self-test failed\n")
            halt_loop()
        # mmap over a live mapping must not leak the pages it covers (#4114).
        if not mmap_overlap_self_test()
            prints("\n*** KERNEL PANIC ***\n")
            prints("mmap overlap self-test failed\n")
            halt_loop()
        # The kernel-chosen cursor must not land on a live mapping (#4142).
        if not mmap_cursor_self_test()
            prints("\n*** KERNEL PANIC ***\n")
            prints("mmap cursor self-test failed\n")
            halt_loop()

# ============================================================================
# Diagnostics (after SYSCALL setup)
# ============================================================================

# The TX burst: more frames than the NIC's 256-entry TX ring holds, sent in
# back-to-back groups so several are in flight at once (AGAST #4073).
const NET_TX_BURST: u32 = 300
const NET_TX_BURST_GROUP: u32 = 4

# Ping the gateway NET_TX_BURST times, NET_TX_BURST_GROUP requests at a time
# with no wait between them, then poll for that group's replies. Logs
#   [net] TX burst: sent=S/300 replies=R
# S counts net_send successes: a driver that never reclaims used TX
# descriptors runs out of them after 256 sends and fails the rest. R counts
# distinct reply seqs: a driver that writes every frame into the same TX
# buffer overwrites a group's earlier requests before the device reads them,
# so their seqs never come back. tools/test_msix_boot.sh checks both.
fn network_tx_burst()
    let gateway: *u8 = ip_get_gateway()
    var mac: [6]u8
    var tries: i32 = 0
    while arp_cache_lookup(gateway, @mac[0]) < 0 and tries < 50
        arp_send_request(gateway)
        var p: i32 = 0
        while p < 100
            net_poll()
            p = p + 1
        tries = tries + 1
    if arp_cache_lookup(gateway, @mac[0]) < 0
        prints("[net] TX burst: gateway never answered ARP\n")
        return

    let base: u32 = icmp_distinct_reply_count()
    var sent: u32 = 0
    var n: u32 = 0
    while n < NET_TX_BURST
        var g: u32 = 0
        var group_sent: u32 = 0
        while g < NET_TX_BURST_GROUP and n < NET_TX_BURST
            if icmp_ping(gateway) == 0
                group_sent = group_sent + 1
            g = g + 1
            n = n + 1
        sent = sent + group_sent
        # Wait (bounded) for this group's replies
        var polls: i32 = 0
        while icmp_distinct_reply_count() - base < sent and polls < 2000
            net_poll()
            delay_us(50)
            polls = polls + 1
    # Late replies
    var tail: i32 = 0
    while tail < 200
        net_poll()
        tail = tail + 1

    prints("[net] TX burst: sent=")
    serial_print_dec(sent as u64)
    prints("/")
    serial_print_dec(NET_TX_BURST as u64)
    prints(" replies=")
    serial_print_dec((icmp_distinct_reply_count() - base) as u64)
    prints("\n")

# AGAST #1851: how long the EC2 acceptance boot keeps polling for an inbound
# ping from the peer instance after DHCP. Bounded, and only armed by the
# \harland\net-responder boot option (the acceptance image), so no other
# boot pays for it. It runs before the TX burst so the peer's first packets
# meet a quiet RX path, and a peer that answers ends the wait immediately.
const NET_PEER_PING_WINDOW_US: u64 = 240000000   # 240 seconds

# Only called when the boot option asked for it (AGAST #4335): this probes
# every NIC driver, so on hardware whose driver is broken it can panic.
fn network_dhcp_ping(run_net_responder: bool)
    # Initialize network stack (includes VirtIO-net driver)
    prints("\n=== Initializing Network Stack ===\n")
    let net_result: i32 = net_stack_init()
    if net_result == 0
        prints("  Network stack ready!\n")

        # Start DHCP configuration
        prints("  Starting DHCP...\n")
        net_configure_dhcp()

        # Poll for packets until configured or timeout. Interrupts are on
        # for this window only (the kernel otherwise boots with IF=0), so
        # the NIC's MSI-X interrupts are delivered and counted (#1852). The
        # syscall path already runs kernel code with IF=1 the same way.
        prints("  Polling for network packets...\n")
        enable_interrupts()
        var poll_count: i32 = 0
        var ping_sent: u8 = 0
        var arp_pending: u8 = 0
        while poll_count < 1000
            net_poll()
            poll_count = poll_count + 1

            delay_us(2000)

            # If we got configured, try a ping
            if net_is_configured() and ping_sent == 0 and poll_count >= 100
                if arp_pending == 0
                    prints("\n  Got IP! Pinging gateway...\n")
                let gateway: *u8 = ip_get_gateway()
                let ping_result: i32 = icmp_ping(gateway)
                if ping_result < 0
                    # ARP lookup needed, wait for ARP reply
                    arp_pending = 1
                else
                    ping_sent = 1
                    prints("  ICMP echo request sent!\n")
        disable_interrupts()

        if virtio_net_msix_enabled() != 0
            prints("[msix] virtio-net interrupts: ")
            serial_print_dec(virtio_net_irq_count())
            prints("\n")

        if net_is_configured()
            prints("\n  Network configured!\n")
            ip_print_config()
            # The acceptance peer pings this instance; answer it from the
            # serial log's point of view before the TX burst starts moving
            # the device's queues (#1851).
            if run_net_responder and net_device_type() == NETDEV_TYPE_ENA
                network_wait_for_peer_ping()
            network_tx_burst()
        else
            prints("\n  DHCP timeout (no response in test window)\n")
    else
        prints("  Network stack initialization failed\n")

# AGAST #1851: keep polling for a peer instance's ping. The QEMU NIC gate has
# no peer, so this runs only on ENA and only when the boot image carries the
# \harland\net-responder marker. net_poll answers the peer's ARP request and
# replies to its ICMP echo request; icmp.ritz logs both, and the counters
# below are printed so the serial log carries the totals as evidence.
fn network_wait_for_peer_ping()
    prints("\n  Waiting up to 240s for a peer ping...\n")
    let deadline: u64 = deadline_after_us(NET_PEER_PING_WINDOW_US)
    # Once a request has been answered, keep answering for a short grace
    # period: if the first reply is lost, the peer's next ping still gets an
    # answer instead of finding us gone.
    var answered: u8 = 0
    var grace_deadline: u64 = 0
    while not deadline_passed(deadline)
        net_poll()
        if icmp_echo_request_count() > 0 and icmp_echo_reply_sent_count() > 0
            if answered == 0
                answered = 1
                grace_deadline = deadline_after_us(5000000)   # 5 seconds
            else if deadline_passed(grace_deadline)
                break
        delay_us(1000)

    if icmp_echo_request_count() > 0
        prints("[net] peer ping: requests=")
        serial_print_dec(icmp_echo_request_count() as u64)
        prints(" replies=")
        serial_print_dec(icmp_echo_reply_sent_count() as u64)
        prints("\n")
    else
        prints("[net] peer ping: no echo request within 240s\n")

# Switch the NVMe controllers nvme_probe found at boot (polled: the APIC was
# not up yet) to MSI-X, then read each namespace with interrupts on, so every
# command waits for its completion interrupt (AGAST #3630, per-CPU queues
# #4220). Each started AP is then called through an IPI and reads the end of
# its own disk through its own queue and vector. Logs
#   [msix] nvme interrupts: N, commands waited: W, completions without one: M
#   [msix] nvme waits halted: H
#   [msix] nvme idle wait halted: P
# (W counts every command since MSI-X went on that waited for its interrupt;
# H the hlts those waits slept in, 0 when every interrupt beat its wait's
# first check or the wait parked a process; P the hlts of one watchdog round
# of the same wait with no command outstanding, AGAST #4246.)
# tools/test_msix_boot.sh wants N > 0, W > 0, M = 0, 0 < P <= 64 and the
# read's fingerprint.
fn nvme_msix_check()
    if nvme_enable_msix() == 0
        return
    enable_interrupts()
    nvme_msix_read_check()
    # An AP-issued command goes through its own I/O queue and vector
    # (AGAST #4220): each started AP reads the end of its disk, and logs
    # whether it waited for an interrupt delivered to it.
    ap_run_nvme_probe()
    let idle_halts: u64 = nvme_irq_idle_probe()
    disable_interrupts()
    prints("[msix] nvme interrupts: ")
    serial_print_dec(nvme_irq_count())
    prints(", commands waited: ")
    serial_print_dec(nvme_irq_wait_count())
    prints(", completions without one: ")
    serial_print_dec(nvme_irq_missed_count())
    prints("\n")
    prints("[msix] nvme waits halted: ")
    serial_print_dec(nvme_irq_halt_count())
    prints("\n")
    prints("[msix] nvme idle wait halted: ")
    serial_print_dec(idle_halts)
    prints("\n")

fn virtio_blk_check()
    # VirtIO Block device already initialized early (for initramfs loading)
    # Just run a test if it's available
    prints("\n=== VirtIO Block Device ===\n")
    let blk_dev: *VirtioBlkDevice = virtio_blk_get_device()
    if blk_dev != 0 as *VirtioBlkDevice
        prints("  (already initialized for initramfs)\n")
        # Run a basic read test to verify it's still working
        virtio_blk_test(blk_dev)
    else
        prints("  No VirtIO Block device found (add -drive to QEMU)\n")

# PCI listing, block device and ELF loader checks, in boot order. The
# network self-tests are a boot option (AGAST #4335): when the loader did
# not find the boot volume's \harland\net-selftest marker (every boot except
# QEMU's NIC gate), the NIC is left alone until init is up, so a misbehaving
# driver cannot keep init_interactive and rzsh from starting.
pub fn postinit_diagnostics(run_net_selftests: bool, run_net_responder: bool)
    # PCI already initialized early - just print discovered devices
    prints("\n=== PCI Devices ===\n")
    pci_print_all_devices()
    msix_print_all()

    if run_net_selftests
        network_dhcp_ping(run_net_responder)
    else
        prints("[net] Network self-tests skipped: boot option \\harland\\net-selftest not set\n")

    nvme_msix_check()

    virtio_blk_check()

    # Test ELF loader (validates structures and parsing)
    test_elf_loader()
