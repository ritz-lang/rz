# Harland Virtual Memory Manager (Paging)
#
# x86-64 4-level paging implementation.
# Supports 4KB pages, 2MB huge pages, and 1GB huge pages.
#
# Depends on PMM for page table allocation.

import serial { StrView, prints, serial_print_hex, serial_print_dec, println }
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_alloc_page_high, pmm_free_page, pmm_mark_region_used, pmm_get_total_pages }
import io { rdmsr, wrmsr, CpuidResult, cpuid }

# ============================================================================
# Page Table Entry Flags (x86-64)
# ============================================================================

pub const PTE_PRESENT: u64 = 1
pub const PTE_WRITABLE: u64 = 2
pub const PTE_USER: u64 = 4
pub const PTE_WRITE_THROUGH: u64 = 8
pub const PTE_CACHE_DISABLE: u64 = 16
pub const PTE_ACCESSED: u64 = 32
pub const PTE_DIRTY: u64 = 64
pub const PTE_HUGE: u64 = 128
pub const PTE_GLOBAL: u64 = 256
pub const PTE_NO_EXECUTE: u64 = 9223372036854775808
# Bit 9, left to the OS by the CPU: this PTE maps a device frame (MMIO such
# as the user framebuffer) that the PMM never owned. vmm_free_user_pt leaves
# such frames alone (#2755).
pub const PTE_DEVICE: u64 = 512

# Address masks
# Physical address mask (bits 12-51) = 0x000FFFFFFFFFF000
pub const PTE_ADDR_MASK: u64 = 4503599627366400

# ============================================================================
# VMM State
# ============================================================================

# Current PML4 physical address (set from CR3)
pub var vmm_pml4_phys: u64 = 0

# ============================================================================
# Physmap (AGAST #3530)
# ============================================================================
#
# The kernel reaches physical memory (page tables above all) through a
# direct map of RAM at PHYSMAP_BASE, PML4[256], the first kernel-half slot.
# vmm_create_user_pml4 copies PML4[256..511] into every process, so the
# physmap is there whatever CR3 is loaded. Before #3530 page tables were read
# through the identity map, which processes only get for phys < 1 GiB: a
# table pmm handed out above that faulted the kernel (-m 2G).
#
# Until vmm_init_physmap runs, g_physmap_offset is 0 and phys_to_virt is the
# boot identity map, which is how the physmap's own tables are written.
pub const PHYSMAP_BASE: u64 = 0xFFFF800000000000
const PHYSMAP_PML4_INDEX: u64 = 256
const ONE_GB: u64 = 1073741824
const TWO_MB: u64 = 2097152
# pmm tracks at most 4 GiB (pmm.MAX_MEMORY).
const PHYSMAP_MAX_GB: u64 = 4

var g_physmap_offset: u64 = 0

# Set once the physmap is up: page tables then come from the top of RAM
# (pmm_alloc_page_high). Nothing reaches them but the physmap, which keeps
# it load-bearing, and -m 2G boots put user tables above 1 GiB, where a
# walk through the identity map would fault (the #3530 panic).
var g_tables_high: bool = false

# A zeroed page-table page, or 0.
fn vmm_alloc_table() -> u64
    var t: u64 = 0
    if g_tables_high
        t = pmm_alloc_page_high()
    else
        t = pmm_alloc_page()
    if t == 0
        return 0
    var i: u64 = 0
    while i < 512
        vmm_set_entry(t, i, 0)
        i = i + 1
    return t

# Kernel virtual address of physical address paddr.
pub fn phys_to_virt(paddr: u64) -> u64
    return paddr + g_physmap_offset

# PTE_NO_EXECUTE if EFER.NXE is on (vmm_init), else 0: with NXE off the NX
# bit is reserved and a user access to such a page faults.
var g_pte_nx: u64 = 0

pub fn vmm_nx_flag() -> u64
    return g_pte_nx

# ============================================================================
# VMM Initialization and TLB Management
# ============================================================================

# Initialize VMM - read current CR3
pub fn vmm_init() -> i32
    var cr3_val: u64 = 0
    var cr3_ptr: *u64 = @cr3_val
    asm x86_64:
        movq %cr3, %rax
        movq {cr3_ptr}, %rcx
        movq %rax, (%rcx)
    vmm_pml4_phys = cr3_val & PTE_ADDR_MASK
    vmm_enable_nx()
    return 0

# Turn on EFER.NXE if the CPU has NX (CPUID 0x80000001 EDX bit 20). Only the
# BSP runs page tables with NX set: APs halt in ap_entry.
fn vmm_enable_nx() -> i32
    let ext: CpuidResult = cpuid(0x80000000)
    if ext.eax < 0x80000001
        return 0
    let feat: CpuidResult = cpuid(0x80000001)
    if (feat.edx & 0x100000) == 0
        return 0
    let efer: u64 = rdmsr(0xC0000080)
    wrmsr(0xC0000080, efer | 0x800)
    g_pte_nx = PTE_NO_EXECUTE
    return 0

# Build the physmap: PML4[256] -> PDPT -> one PD of 2 MiB pages per GiB of
# RAM pmm tracks. Its tables come from pmm right after vmm_init, so they are
# low pages the boot identity map covers; refuse otherwise. On failure the
# kernel keeps using the identity map. Returns 0 or -1.
pub fn vmm_init_physmap() -> i32
    if (vmm_get_entry(vmm_pml4_phys, PHYSMAP_PML4_INDEX) & PTE_PRESENT) != 0
        prints("[vmm] physmap: PML4[256] already in use\n")
        return -1
    var gbs: u64 = (pmm_get_total_pages() * PAGE_SIZE + ONE_GB - 1) / ONE_GB
    if gbs == 0
        gbs = 1
    if gbs > PHYSMAP_MAX_GB
        gbs = PHYSMAP_MAX_GB
    let pdpt: u64 = vmm_alloc_low_table()
    if pdpt == 0
        return -1
    var g: u64 = 0
    while g < gbs
        let pd: u64 = vmm_alloc_low_table()
        if pd == 0
            return -1
        var e: u64 = 0
        while e < 512
            vmm_set_entry(pd, e, (g * ONE_GB + e * TWO_MB) | PTE_PRESENT | PTE_WRITABLE | PTE_HUGE | g_pte_nx)
            e = e + 1
        vmm_set_entry(pdpt, g, pd | PTE_PRESENT | PTE_WRITABLE)
        g = g + 1
    vmm_set_entry(vmm_pml4_phys, PHYSMAP_PML4_INDEX, pdpt | PTE_PRESENT | PTE_WRITABLE)
    # Before the offset switch: its PDPT is written through the identity map.
    if vmm_init_mmio_window() != 0
        return -1
    g_physmap_offset = PHYSMAP_BASE
    g_tables_high = true
    prints("[vmm] physmap: ")
    serial_print_dec(gbs)
    prints(" GiB at 0xFFFF800000000000\n")
    return 0

# A zeroed page-table page below 1 GiB (written through the identity map),
# or 0.
fn vmm_alloc_low_table() -> u64
    let t: u64 = pmm_alloc_page()
    if t == 0
        return 0
    if t + PAGE_SIZE > ONE_GB
        pmm_free_page(t)
        prints("[vmm] physmap: no table page below 1 GiB\n")
        return 0
    var i: u64 = 0
    while i < 512
        vmm_set_entry(t, i, 0)
        i = i + 1
    return t

# Flush TLB for a single page
pub fn vmm_flush_tlb(vaddr: u64) -> i32
    asm x86_64:
        movq {vaddr}, %rax
        invlpg (%rax)
    return 0

# Flush entire TLB (reload CR3)
pub fn vmm_flush_tlb_all() -> i32
    var cr3_val: u64 = 0
    var cr3_ptr: *u64 = @cr3_val
    asm x86_64:
        movq %cr3, %rax
        movq {cr3_ptr}, %rcx
        movq %rax, (%rcx)
        movq %rax, %cr3
    return 0

# ============================================================================
# Page Table Entry Access
# ============================================================================

# Get entry from a page table level, through the physmap (so any table pmm
# hands out is reachable, whatever CR3 is loaded).
# table_phys: physical address of table
# index: entry index (0-511)
fn vmm_get_entry(table_phys: u64, index: u64) -> u64
    let entry_ptr: *u64 = phys_to_virt(table_phys + index * 8) as *u64
    return *entry_ptr

# Set entry in a page table level
fn vmm_set_entry(table_phys: u64, index: u64, value: u64) -> i32
    let entry_ptr: *u64 = phys_to_virt(table_phys + index * 8) as *u64
    *entry_ptr = value
    return 0

# Read a PML4 entry (public for debugging)
pub fn vmm_read_pml4_entry(pml4_phys: u64, index: u64) -> u64
    return vmm_get_entry(pml4_phys, index)

# ============================================================================
# Address Decomposition
# ============================================================================

# Extract page table indices from virtual address
fn vmm_pml4_index(vaddr: u64) -> u64
    return (vaddr >> 39) & 511

fn vmm_pdpt_index(vaddr: u64) -> u64
    return (vaddr >> 30) & 511

fn vmm_pd_index(vaddr: u64) -> u64
    return (vaddr >> 21) & 511

fn vmm_pt_index(vaddr: u64) -> u64
    return (vaddr >> 12) & 511

# ============================================================================
# Debug Functions
# ============================================================================

# Debug function: dump page table entries for a virtual address
pub fn vmm_debug_page_tables(vaddr: u64) -> i32
    prints("  Page table walk for vaddr=")
    serial_print_hex(vaddr)
    prints(":\n")

    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    prints("    PML4 index: ")
    serial_print_dec(pml4i)
    prints("\n")

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    prints("    PML4[")
    serial_print_dec(pml4i)
    prints("] = ")
    serial_print_hex(pml4_entry)
    if (pml4_entry & PTE_PRESENT) == 0
        prints(" (NOT PRESENT)\n")
        return -1
    prints("\n")

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    prints("    PDPT index: ")
    serial_print_dec(pdpti)
    prints(" at ")
    serial_print_hex(pdpt_phys)
    prints("\n")

    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    prints("    PDPT[")
    serial_print_dec(pdpti)
    prints("] = ")
    serial_print_hex(pdpt_entry)
    if (pdpt_entry & PTE_PRESENT) == 0
        prints(" (NOT PRESENT)\n")
        return -1
    prints("\n")

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    prints("    PD index: ")
    serial_print_dec(pdi)
    prints(" at ")
    serial_print_hex(pd_phys)
    prints("\n")

    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    prints("    PD[")
    serial_print_dec(pdi)
    prints("] = ")
    serial_print_hex(pd_entry)
    if (pd_entry & PTE_PRESENT) == 0
        prints(" (NOT PRESENT)\n")
        return -1
    prints("\n")

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    prints("    PT index: ")
    serial_print_dec(pti)
    prints(" at ")
    serial_print_hex(pt_phys)
    prints("\n")

    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    prints("    PT[")
    serial_print_dec(pti)
    prints("] = ")
    serial_print_hex(pt_entry)
    if (pt_entry & PTE_PRESENT) == 0
        prints(" (NOT PRESENT)\n")
        return -1
    prints("\n")

    return 0

# ============================================================================
# Page Mapping
# ============================================================================

# Map a single 4KB page
# Returns 0 on success, -1 on error (e.g., out of memory for page tables)
pub fn vmm_map_page(vaddr: u64, paddr: u64, flags: u64) -> i32
    # Calculate indices
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    # Walk/create page tables
    var pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    var pdpt_phys: u64 = 0

    # Check if we need to add USER bit to existing entries
    let need_user: u64 = flags & PTE_USER

    if (pml4_entry & PTE_PRESENT) == 0
        # Allocate new PDPT
        pdpt_phys = vmm_alloc_table()
        if pdpt_phys == 0
            return -1
        # Set PML4 entry
        vmm_set_entry(vmm_pml4_phys, pml4i, pdpt_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        pdpt_phys = pml4_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PML4 entry has USER bit
        if need_user != 0 && (pml4_entry & PTE_USER) == 0
            vmm_set_entry(vmm_pml4_phys, pml4i, pml4_entry | PTE_USER)

    var pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    var pd_phys: u64 = 0

    if (pdpt_entry & PTE_PRESENT) == 0
        # Allocate new PD
        pd_phys = vmm_alloc_table()
        if pd_phys == 0
            return -1
        # Set PDPT entry
        vmm_set_entry(pdpt_phys, pdpti, pd_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        if (pdpt_entry & PTE_HUGE) != 0
            return -1
        pd_phys = pdpt_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PDPT entry has USER bit
        if need_user != 0 && (pdpt_entry & PTE_USER) == 0
            vmm_set_entry(pdpt_phys, pdpti, pdpt_entry | PTE_USER)

    var pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    var pt_phys: u64 = 0

    if (pd_entry & PTE_PRESENT) == 0
        # Allocate new PT
        pt_phys = vmm_alloc_table()
        if pt_phys == 0
            return -1
        # Set PD entry
        vmm_set_entry(pd_phys, pdi, pt_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        if (pd_entry & PTE_HUGE) != 0
            return -1
        pt_phys = pd_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PD entry has USER bit
        if need_user != 0 && (pd_entry & PTE_USER) == 0
            vmm_set_entry(pd_phys, pdi, pd_entry | PTE_USER)

    # Set the final page table entry
    vmm_set_entry(pt_phys, pti, paddr | flags | PTE_PRESENT)

    # Flush TLB for this page
    vmm_flush_tlb(vaddr)

    return 0

# Unmap a single 4KB page
# Returns the physical address that was mapped, or 0 if not mapped
pub fn vmm_unmap_page(vaddr: u64) -> u64
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    if (pml4_entry & PTE_PRESENT) == 0
        return 0

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    if (pdpt_entry & PTE_PRESENT) == 0
        return 0

    if (pdpt_entry & PTE_HUGE) != 0
        return 0

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    if (pd_entry & PTE_PRESENT) == 0
        return 0

    if (pd_entry & PTE_HUGE) != 0
        return 0

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    if (pt_entry & PTE_PRESENT) == 0
        return 0

    let paddr: u64 = pt_entry & PTE_ADDR_MASK

    # Clear the entry
    vmm_set_entry(pt_phys, pti, 0)
    vmm_flush_tlb(vaddr)

    return paddr

# ============================================================================
# Address Translation
# ============================================================================

# Get physical address for a virtual address
# Returns 0 if not mapped (NOTE: 0 is a valid physical address!)
pub fn vmm_virt_to_phys(vaddr: u64) -> u64
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    if (pml4_entry & PTE_PRESENT) == 0
        return 0

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    if (pdpt_entry & PTE_PRESENT) == 0
        return 0

    # 1GB page?
    if (pdpt_entry & PTE_HUGE) != 0
        let base: u64 = pdpt_entry & PTE_ADDR_MASK
        let offset: u64 = vaddr & 1073741823
        return base + offset

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    if (pd_entry & PTE_PRESENT) == 0
        return 0

    # 2MB page?
    if (pd_entry & PTE_HUGE) != 0
        let base: u64 = pd_entry & PTE_ADDR_MASK
        let offset: u64 = vaddr & 2097151
        return base + offset

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    if (pt_entry & PTE_PRESENT) == 0
        return 0

    let base: u64 = pt_entry & PTE_ADDR_MASK
    let offset: u64 = vaddr & 4095
    return base + offset

# ============================================================================
# Mapping Helpers
# ============================================================================

# Check if a physical address is already accessible (identity mapped)
# Returns 1 if mapped, 0 if not
pub fn vmm_is_accessible(paddr: u64) -> i32
    # Our boot.s identity maps the first 1GB using 2MB huge pages
    # Addresses above 1GB need explicit mapping
    let one_gb: u64 = 1073741824
    if paddr < one_gb
        return 1

    # Check if we've explicitly mapped this address
    let vaddr: u64 = paddr  # We use identity mapping
    let mapped: u64 = vmm_virt_to_phys(vaddr)
    if mapped == paddr
        return 1

    return 0

# Ensure a physical memory region is accessible
# Maps pages if they're not in the identity-mapped region
# Returns 0 on success, -1 on error
pub fn vmm_ensure_mapped(paddr: u64, size: u64) -> i32
    let one_gb: u64 = 1073741824

    # If entirely within identity-mapped region, nothing to do
    if paddr + size <= one_gb
        return 0

    # Map each 4KB page in the region
    let page_mask: u64 = 0xFFFFFFFFFFFFF000
    var addr: u64 = paddr & page_mask
    let end: u64 = (paddr + size + 4095) & page_mask

    while addr < end
        # Skip if in identity-mapped region
        if addr < one_gb
            addr = addr + 4096
            continue

        # Check if already mapped
        if vmm_is_accessible(addr) == 1
            addr = addr + 4096
            continue

        # Map this page (identity mapping - vaddr = paddr)
        let result: i32 = vmm_map_page(addr, addr, PTE_WRITABLE)
        if result != 0
            prints("vmm_ensure_mapped: failed to map ")
            serial_print_hex(addr)
            prints("\n")
            return -1

        addr = addr + 4096

    return 0

# ============================================================================
# Device MMIO Window (AGAST #3438)
# ============================================================================
#
# Device registers (virtio modern PCI capabilities, ...) live in BARs that
# can sit anywhere in the 52-bit physical space, often above 4 GiB. They are
# mapped uncached into a bump-allocated window at PML4[257], the slot after
# the physmap. Being kernel-half, vmm_create_user_pml4 copies it into every
# process, so a driver polled from a syscall reaches its registers whatever
# CR3 is loaded. A process PML4 copies PML4[257] by value, so the entry only
# reaches processes created after it exists: vmm_init_physmap creates its
# PDPT before any process (vmm_init_mmio_window, AGAST #3577), and every
# later mapping, boot-time or not, lands below that one shared PDPT.
#
# Before #3438 virtio used 0xFFFFFFFF90000000, inside the boot loader's
# 2 MiB-page map of the kernel half: vmm_map_page refused it, the error was
# ignored and the "registers" were RAM at phys 0x10000000.
pub const MMIO_WINDOW_BASE: u64 = 0xFFFF808000000000
const MMIO_WINDOW_SIZE: u64 = 0x8000000000    # 512 GiB, all of PML4[257]

var g_mmio_next: u64 = 0xFFFF808000000000    # MMIO_WINDOW_BASE (ritz0: literal initializers only)

const MMIO_PML4_INDEX: u64 = 257

# Give PML4[257] its PDPT now, so the entry every process copies is the one
# vmm_map_mmio fills in later. Leaves an entry that is already present (its
# mappings stay). Returns 0, or -1 when no table page is free.
pub fn vmm_init_mmio_window() -> i32
    if (vmm_get_entry(vmm_pml4_phys, MMIO_PML4_INDEX) & PTE_PRESENT) != 0
        return 0
    let pdpt: u64 = vmm_alloc_low_table()
    if pdpt == 0
        return -1
    vmm_set_entry(vmm_pml4_phys, MMIO_PML4_INDEX, pdpt | PTE_PRESENT | PTE_WRITABLE)
    return 0

# Map size bytes of device memory at physical address paddr. Returns the
# kernel virtual address of paddr itself (page offset kept), or 0 on failure.
pub fn vmm_map_mmio(paddr: u64, size: u64) -> u64
    if size == 0
        return 0
    let page_mask: u64 = 0xFFFFFFFFFFFFF000
    let first: u64 = paddr & page_mask
    let end: u64 = (paddr + size + PAGE_SIZE - 1) & page_mask
    if end <= first
        return 0
    let len: u64 = end - first
    if len > MMIO_WINDOW_BASE + MMIO_WINDOW_SIZE - g_mmio_next
        prints("[vmm] MMIO window exhausted\n")
        return 0
    let virt: u64 = g_mmio_next
    var off: u64 = 0
    while off < len
        if vmm_map_page(virt + off, first + off, PTE_WRITABLE | PTE_CACHE_DISABLE | PTE_WRITE_THROUGH | g_pte_nx) != 0
            prints("[vmm] MMIO map failed at phys ")
            serial_print_hex(first + off)
            prints("\n")
            return 0
        off = off + PAGE_SIZE
    g_mmio_next = virt + len
    return virt + (paddr - first)

# ============================================================================
# Debug Functions
# ============================================================================

# Dump page table entries for a virtual address (for debugging)
pub fn vmm_dump_pte(vaddr: u64) -> i32
    prints("  PTE dump for 0x")
    serial_print_hex(vaddr)
    prints(":\n")

    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    prints("    PML4[")
    serial_print_dec(pml4i)
    prints("]: ")
    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    serial_print_hex(pml4_entry)
    vmm_print_flags(pml4_entry)
    prints("\n")

    if (pml4_entry & PTE_PRESENT) == 0
        prints("    (not present)\n")
        return -1

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    prints("    PDPT[")
    serial_print_dec(pdpti)
    prints("]: ")
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    serial_print_hex(pdpt_entry)
    vmm_print_flags(pdpt_entry)
    prints("\n")

    if (pdpt_entry & PTE_PRESENT) == 0
        prints("    (not present)\n")
        return -1

    if (pdpt_entry & PTE_HUGE) != 0
        prints("    (1GB huge page)\n")
        return 0

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    prints("    PD[")
    serial_print_dec(pdi)
    prints("]: ")
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    serial_print_hex(pd_entry)
    vmm_print_flags(pd_entry)
    prints("\n")

    if (pd_entry & PTE_PRESENT) == 0
        prints("    (not present)\n")
        return -1

    if (pd_entry & PTE_HUGE) != 0
        prints("    (2MB huge page)\n")
        return 0

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    prints("    PT[")
    serial_print_dec(pti)
    prints("]: ")
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    serial_print_hex(pt_entry)
    vmm_print_flags(pt_entry)
    prints("\n")

    return 0

# Print PTE flags in human-readable form
fn vmm_print_flags(entry: u64) -> i32
    prints(" [")
    if (entry & PTE_PRESENT) != 0
        prints("P")
    else
        prints("-")
    if (entry & PTE_WRITABLE) != 0
        prints("W")
    else
        prints("-")
    if (entry & PTE_USER) != 0
        prints("U")
    else
        prints("-")
    if (entry & PTE_HUGE) != 0
        prints("H")
    else
        prints("-")
    prints("]")
    return 0

# ============================================================================
# Per-Process Page Tables
# ============================================================================
# These functions support multiple address spaces by allowing operations
# on page tables other than the currently active vmm_pml4_phys.

# Create a new PML4 for a process, copying kernel mappings
# Returns physical address of new PML4, or 0 on failure
#
# This creates a proper isolated address space:
#
# 1. PML4[0] - We create a NEW PDPT that ONLY maps PDPT[0] (identity 0-1GB)
#    and PDPT[3] (LAPIC/IOAPIC MMIO), both shared with the kernel. Code that
#    still uses identity addresses for low memory needs them; page tables go
#    through the physmap instead. PDPT[1-511] are otherwise private: user
#    addresses like 0x100000000 (4GB = PDPT[4]) are the process's own.
#
# 2. PML4[256-511] - Higher-half kernel space (shared copy): the physmap
#    (PML4[256]), kernel code, data and heap.
#
# 3. PML4[1-255] - Private user space: the mmap region (from PML4[1],
#    syscall/runtime/memory.ritz) and the user stack (PML4[255]).
#
pub fn vmm_create_user_pml4() -> u64
    # Allocate a new PML4 page
    let new_pml4: u64 = vmm_alloc_table()
    if new_pml4 == 0
        prints("[vmm] Failed to allocate PML4\n")
        return 0
    var i: u64 = 0

    # For PML4[0], we need to create a NEW PDPT that only has the
    # identity mapping for physical memory 0-1GB (at PDPT[0]).
    # The rest of PDPT[1-511] is empty for user allocations.
    let kernel_pml4_0: u64 = vmm_get_entry(vmm_pml4_phys, 0)
    if (kernel_pml4_0 & PTE_PRESENT) != 0
        # Allocate a new PDPT for this process
        let new_pdpt: u64 = vmm_alloc_table()
        if new_pdpt == 0
            pmm_free_page(new_pml4)
            prints("[vmm] Failed to allocate PDPT\n")
            return 0

        # Copy PDPT entries from kernel that the kernel needs:
        # - PDPT[0]: 0-1GB identity mapping (physical memory)
        # - PDPT[3]: 3-4GB range (contains LAPIC at 0xFEE00000 and I/O APIC at 0xFEC00000)
        # These mappings are kernel-only (no USER bit) so userspace can't access them
        # but the kernel can still use them when handling syscalls/interrupts.
        let kernel_pdpt: u64 = kernel_pml4_0 & PTE_ADDR_MASK

        # Copy PDPT[0] - identity mapping for 0-1GB physical
        let pdpt_0: u64 = vmm_get_entry(kernel_pdpt, 0)
        if (pdpt_0 & PTE_PRESENT) != 0
            vmm_set_entry(new_pdpt, 0, pdpt_0 & ~PTE_USER)

        # Copy PDPT[3] - 3-4GB range (LAPIC, I/O APIC, other MMIO)
        let pdpt_3: u64 = vmm_get_entry(kernel_pdpt, 3)
        if (pdpt_3 & PTE_PRESENT) != 0
            vmm_set_entry(new_pdpt, 3, pdpt_3 & ~PTE_USER)

        # Set PML4[0] to point to our new PDPT (without USER bit)
        vmm_set_entry(new_pml4, 0, new_pdpt | PTE_PRESENT | PTE_WRITABLE)

    # Copy kernel mappings (upper half of address space)
    # PML4 indices 256-511 map addresses 0xFFFF800000000000 and above
    # This includes:
    #   - Higher-half kernel code/data (0xFFFFFFFF80000000)
    #   - Kernel heap (0xFFFFFFFFC0000000)
    i = 256
    while i < 512
        let entry: u64 = vmm_get_entry(vmm_pml4_phys, i)
        if (entry & PTE_PRESENT) != 0
            # Copy the entry (without USER bit for kernel mappings)
            vmm_set_entry(new_pml4, i, entry & ~PTE_USER)
        i = i + 1

    return new_pml4

# Switch to a different page table (set CR3)
# pml4_phys: physical address of new PML4
pub fn vmm_switch_pml4(pml4_phys: u64) -> i32
    # Update our cached value
    vmm_pml4_phys = pml4_phys

    # Write to CR3 - this automatically flushes the TLB
    asm x86_64:
        movq {pml4_phys}, %rax
        movq %rax, %cr3

    return 0

# Get current PML4 physical address
pub fn vmm_get_current_pml4() -> u64
    return vmm_pml4_phys

# Reserve all page table pages in the PMM so they won't be reallocated.
# This walks the entire PML4 and marks all PDPT, PD, and PT pages as used.
# Call this after heap_init since the heap creates new page table entries.
pub fn vmm_reserve_page_tables() -> i32
    # Reserve the PML4 itself
    pmm_mark_region_used(vmm_pml4_phys, PAGE_SIZE)

    # Walk all present PML4 entries
    var pml4i: u64 = 0
    while pml4i < 512
        let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
        if (pml4_entry & PTE_PRESENT) != 0
            vmm_reserve_pdpt(pml4_entry & PTE_ADDR_MASK)
        pml4i = pml4i + 1

    return 0

# Reserve a PDPT page and every PD (and PT) below its present, non-huge entries.
fn vmm_reserve_pdpt(pdpt_phys: u64) -> i32
    pmm_mark_region_used(pdpt_phys, PAGE_SIZE)
    var pdpti: u64 = 0
    while pdpti < 512
        let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
        if (pdpt_entry & PTE_PRESENT) != 0 and (pdpt_entry & PTE_HUGE) == 0
            vmm_reserve_pd(pdpt_entry & PTE_ADDR_MASK)
        pdpti = pdpti + 1
    return 0

# Reserve a PD page and every PT below its present, non-huge entries.
fn vmm_reserve_pd(pd_phys: u64) -> i32
    pmm_mark_region_used(pd_phys, PAGE_SIZE)
    var pdi: u64 = 0
    while pdi < 512
        let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
        if (pd_entry & PTE_PRESENT) != 0 and (pd_entry & PTE_HUGE) == 0
            pmm_mark_region_used(pd_entry & PTE_ADDR_MASK, PAGE_SIZE)
        pdi = pdi + 1
    return 0

# Map a page in a specific page table (not necessarily the active one)
# This is used to set up a process's address space before switching to it
pub fn vmm_map_page_in(pml4: u64, vaddr: u64, paddr: u64, flags: u64) -> i32
    # Save current PML4
    let saved_pml4: u64 = vmm_pml4_phys

    # Temporarily switch to target PML4
    vmm_pml4_phys = pml4

    # Map the page using normal function
    let result: i32 = vmm_map_page(vaddr, paddr, flags)

    # Restore original PML4
    vmm_pml4_phys = saved_pml4

    return result

# Free all user-space pages in a page table (for process cleanup)
# Does NOT free the kernel mappings or the PML4 itself
#
# IMPORTANT: vmm_create_user_pml4 copies kernel PDPT entries [0] and [3] into
# the child's PML4[0] PDPT. These point to SHARED kernel page tables that must
# NOT be freed! We only free entries that were allocated for the child process.
pub fn vmm_free_user_pages(pml4: u64) -> i32
    # User space is in the lower half (PML4 indices 0-255)
    # Walk each level and free pages

    var pml4_idx: u64 = 0
    while pml4_idx < 256  # Only lower half (user space)
        let pml4_entry: u64 = vmm_get_entry(pml4, pml4_idx)
        if (pml4_entry & PTE_PRESENT) == 0
            pml4_idx = pml4_idx + 1
            continue

        # Free the PDPT subtree, then the PDPT itself (allocated by vmm_create_user_pml4)
        let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
        vmm_free_user_pdpt(pdpt_phys, pml4_idx == 0)
        pmm_free_page(pdpt_phys)
        pml4_idx = pml4_idx + 1

    return 0

# Free every user PD subtree below a PDPT (not the PDPT page itself).
# is_pml4_zero: this PDPT hangs off PML4[0], whose entries [0] and [3] are
# copies of kernel entries pointing at SHARED page tables (identity mapping
# and APIC/MMIO regions). We must NOT free these!
fn vmm_free_user_pdpt(pdpt_phys: u64, is_pml4_zero: bool) -> i32
    var pdpt_idx: u64 = 0
    while pdpt_idx < 512
        let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpt_idx)
        let shared: bool = is_pml4_zero and (pdpt_idx == 0 or pdpt_idx == 3)
        # Skip shared kernel entries, absent entries, and 1GB pages (usually
        # the kernel identity mapping)
        if not shared and (pdpt_entry & PTE_PRESENT) != 0 and (pdpt_entry & PTE_HUGE) == 0
            let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
            vmm_free_user_pd(pd_phys)
            # Free the PD itself
            pmm_free_page(pd_phys)
        pdpt_idx = pdpt_idx + 1
    return 0

# Free every user PT (and the pages it maps) below a PD (not the PD page itself).
fn vmm_free_user_pd(pd_phys: u64) -> i32
    var pd_idx: u64 = 0
    while pd_idx < 512
        let pd_entry: u64 = vmm_get_entry(pd_phys, pd_idx)
        # 2MB pages: could free but skip for now
        if (pd_entry & PTE_PRESENT) != 0 and (pd_entry & PTE_HUGE) == 0
            let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
            vmm_free_user_pt(pt_phys)
            # Free the PT itself
            pmm_free_page(pt_phys)
        pd_idx = pd_idx + 1
    return 0

# Free every present RAM page mapped by a PT (not the PT page itself).
fn vmm_free_user_pt(pt_phys: u64) -> i32
    var pt_idx: u64 = 0
    while pt_idx < 512
        let pt_entry: u64 = vmm_get_entry(pt_phys, pt_idx)
        # RAM-backed pages only: a PTE_DEVICE frame is MMIO, not the PMM's,
        # and may lie below the top of RAM (#2755).
        if (pt_entry & PTE_PRESENT) != 0 and (pt_entry & PTE_DEVICE) == 0
            pmm_free_page(pt_entry & PTE_ADDR_MASK)
        pt_idx = pt_idx + 1
    return 0

# Free a page table hierarchy completely (for process termination)
pub fn vmm_free_pml4(pml4: u64) -> i32
    # First free all user pages
    vmm_free_user_pages(pml4)

    # Then free the PML4 itself
    pmm_free_page(pml4)

    return 0
