# Harland Virtual Memory Manager (Paging)
#
# x86-64 4-level paging implementation.
# Supports 4KB pages, 2MB huge pages, and 1GB huge pages.
#
# Depends on PMM for page table allocation.

import klog { klog, klog_hex, klog_dec }
import ritzlib.option
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_alloc_page_high, pmm_free_page, pmm_mark_region_used, pmm_get_total_pages, pmm_range_has_free, pmm_set_physmap_offset }
import io { rdmsr, wrmsr, CpuidResult, cpuid }

# ============================================================================
# Page Table Entry Flags (x86-64)
# ============================================================================

pub const PTE_PRESENT: u64 = 1
pub const PTE_WRITABLE: u64 = 2
pub const PTE_USER: u64 = 4
pub const PTE_WRITE_THROUGH: u64 = 8
pub const PTE_CACHE_DISABLE: u64 = 16
pub const PTE_ACCESSED: u64 = 32
pub const PTE_DIRTY: u64 = 64
pub const PTE_HUGE: u64 = 128
# In a 4 KiB leaf, bit 7 is PAT, not PS: PAT=1 PCD=0 PWT=0 picks IA32_PAT
# entry 4, which arch/x86_64/pat.ritz makes write-combining (AGAST #4868).
pub const PTE_PAT_WC: u64 = 128
pub const PTE_GLOBAL: u64 = 256
pub const PTE_NO_EXECUTE: u64 = 9223372036854775808
# Bit 9, left to the OS by the CPU: this PTE maps a device frame (MMIO such
# as the user framebuffer) that the PMM never owned. vmm_free_user_pt leaves
# such frames alone (#2755).
pub const PTE_DEVICE: u64 = 512
# Bit 10, also the OS's: a non-owning leaf onto a shared object's RAM page
# (mm/shm.ritz, AGAST #4717). The ShmObject owns the frame, not the address
# space mapping it, so vmm_free_user_pt leaves it to the object.
pub const PTE_SHM: u64 = 1024

# Address masks
# Physical address mask (bits 12-51) = 0x000FFFFFFFFFF000
pub const PTE_ADDR_MASK: u64 = 4503599627366400

# ============================================================================
# VMM State
# ============================================================================

# Current PML4 physical address (set from CR3)
pub var vmm_pml4_phys: u64 = 0

# ============================================================================
# Physmap (AGAST #3530)
# ============================================================================
#
# The kernel reaches physical memory (page tables above all) through a
# direct map of RAM at PHYSMAP_BASE, PML4[256], the first kernel-half slot.
# vmm_create_user_pml4 copies PML4[256..511] into every process, so the
# physmap is there whatever CR3 is loaded. Before #3530 page tables were read
# through the boot identity map; a table pmm handed out above 1 GiB faulted
# the kernel (-m 2G). Since #1878 a process has no identity map at all.
#
# Until vmm_init_physmap runs, g_physmap_offset is 0 and phys_to_virt is the
# boot identity map, which is how the physmap's own tables are written.
pub const PHYSMAP_BASE: u64 = 0xFFFF800000000000
const PHYSMAP_PML4_INDEX: u64 = 256

# Ring-1 driver windows (RING1_DRIVER.md, DMA domain), one PML4 slot each at
# the top of the user half, below the user stack: the shared ring the kernel
# maps at spawn, the driver's DMA pages and its MMIO pages. They sit inside
# [USER_MMAP_START, USER_MMAP_END), so sys_mmap_impl and sys_munmap_impl
# refuse any range overlapping [DRV_RING_BASE, USER_STACK_BASE).
pub const DRV_RING_BASE: u64 = 0x7D8000000000    # PML4[251]
pub const DRV_DMA_BASE: u64 = 0x7E0000000000     # PML4[252]
pub const DRV_MMIO_BASE: u64 = 0x7E8000000000    # PML4[253]
const ONE_GB: u64 = 1073741824
const TWO_MB: u64 = 2097152
# One PDPT: 512 GiB, which is also pmm's ceiling (pmm.PMM_MAX_PAGES).
const PHYSMAP_MAX_GB: u64 = 512

var g_physmap_offset: u64 = 0

# Set once the physmap is up: page tables then come from the top of RAM
# (pmm_alloc_page_high). Nothing reaches them but the physmap, which keeps
# it load-bearing, and -m 2G boots put user tables above 1 GiB, where a
# walk through the identity map would fault (the #3530 panic).
var g_tables_high: bool = false

# A zeroed page-table page, or 0.
fn vmm_alloc_table() -> u64
    var t: u64 = 0
    if g_tables_high
        t = pmm_alloc_page_high()
    else
        t = pmm_alloc_page()
    if t == 0
        return 0
    var i: u64 = 0
    while i < 512
        vmm_set_entry(t, i, 0)
        i = i + 1
    return t

# Kernel virtual address of physical address paddr.
pub fn phys_to_virt(paddr: u64) -> u64
    return paddr + g_physmap_offset

# PTE_NO_EXECUTE if EFER.NXE is on (vmm_init), else 0: with NXE off the NX
# bit is reserved and a user access to such a page faults.
var g_pte_nx: u64 = 0

pub fn vmm_nx_flag() -> u64
    return g_pte_nx

# ============================================================================
# VMM Initialization and TLB Management
# ============================================================================

# Initialize VMM - read current CR3
pub fn vmm_init()
    var cr3_val: u64 = 0
    var cr3_ptr: *u64 = @cr3_val
    asm x86_64:
        movq %cr3, %rax
        movq {cr3_ptr}, %rcx
        movq %rax, (%rcx)
    vmm_pml4_phys = cr3_val & PTE_ADDR_MASK
    vmm_enable_nx()

# Turn on EFER.NXE if the CPU has NX (CPUID 0x80000001 EDX bit 20). Only the
# BSP runs page tables with NX set: APs halt in ap_entry.
fn vmm_enable_nx()
    let ext: CpuidResult = cpuid(0x80000000)
    if ext.eax < 0x80000001
        return
    let feat: CpuidResult = cpuid(0x80000001)
    if (feat.edx & 0x100000) == 0
        return
    let efer: u64 = rdmsr(0xC0000080)
    wrmsr(0xC0000080, efer | 0x800)
    g_pte_nx = PTE_NO_EXECUTE

# Build the physmap: PML4[256] -> PDPT -> one PD of 2 MiB pages per GiB of
# RAM pmm tracks, up to its top (AGAST #4183: above 4 GiB too). Its tables
# come from pmm right after vmm_init, so they are low pages the boot
# identity map covers; refuse otherwise. On failure the
# kernel keeps using the identity map. Returns 0 or -1.
pub fn vmm_init_physmap() -> i32
    if (vmm_get_entry(vmm_pml4_phys, PHYSMAP_PML4_INDEX) & PTE_PRESENT) != 0
        klog("[vmm] physmap: PML4[256] already in use\n")
        return -1
    var gbs: u64 = (pmm_get_total_pages() * PAGE_SIZE + ONE_GB - 1) / ONE_GB
    if gbs == 0
        gbs = 1
    if gbs > PHYSMAP_MAX_GB
        gbs = PHYSMAP_MAX_GB
    let pdpt: u64 = vmm_alloc_low_table()
    if pdpt == 0
        return -1
    let chunks: i64 = vmm_physmap_fill(pdpt, gbs)
    if chunks < 0
        return -1
    vmm_set_entry(vmm_pml4_phys, PHYSMAP_PML4_INDEX, pdpt | PTE_PRESENT | PTE_WRITABLE)
    # Before the offset switch: its PDPT is written through the identity map.
    if vmm_init_mmio_window() != 0
        return -1
    g_physmap_offset = PHYSMAP_BASE
    # From here the PMM bitmap is reached through the physmap, never the
    # identity map: a process's PML4 has no lower half to fall back on.
    pmm_set_physmap_offset(PHYSMAP_BASE)
    g_tables_high = true
    klog("[vmm] physmap: ")
    klog_dec(chunks as u64 * 2)
    klog(" MiB of RAM in ")
    klog_dec(gbs)
    klog(" GiB at 0xFFFF800000000000\n")
    vmm_drop_identity_above_4g()
    return 0

# Fill the physmap PDPT for GiBs [0, gbs): a write-back 2 MiB page for each
# chunk that holds RAM (vmm_physmap_chunk_is_ram), and a PD only for a GiB
# with one. Before #4209 every chunk up to the top of RAM was mapped WB,
# the PCI hole below 4 GiB (framebuffer, LAPIC, IOAPIC, BARs) included: a
# cacheable alias of device memory vmm_map_mmio maps UC. Returns the number
# of chunks mapped, or -1 if a table can't be had.
pub fn vmm_physmap_fill(pdpt: u64, gbs: u64) -> i64
    var mapped: i64 = 0
    var g: u64 = 0
    while g < gbs
        var pd: u64 = 0
        var e: u64 = 0
        while e < 512
            let chunk: u64 = g * ONE_GB + e * TWO_MB
            if vmm_physmap_chunk_is_ram(chunk)
                if pd == 0
                    pd = vmm_alloc_low_table()
                    if pd == 0
                        return -1
                vmm_set_entry(pd, e, chunk | PTE_PRESENT | PTE_WRITABLE | PTE_HUGE | g_pte_nx)
                mapped = mapped + 1
            e = e + 1
        if pd != 0
            vmm_set_entry(pdpt, g, pd | PTE_PRESENT | PTE_WRITABLE)
        g = g + 1
    return mapped

# Does the 2 MiB chunk at `chunk` hold RAM? Yes if pmm has a free page in
# it. Else trust the boot identity map (still whole at this point) where it
# knows better than pmm: above the first GiB the UEFI loader maps only
# RAM-typed chunks (chunk_has_ram), loader data pmm never frees such as
# BootInfo and the boot page tables included; in the first GiB both boot
# maps cover everything, so only chunks below pmm's top of RAM count.
fn vmm_physmap_chunk_is_ram(chunk: u64) -> bool
    if pmm_range_has_free(chunk, TWO_MB)
        return true
    if not vmm_boot_identity_maps(chunk)
        return false
    return chunk >= ONE_GB or chunk < pmm_get_total_pages() * PAGE_SIZE

# Does the boot identity map (PML4[0]) map the 2 MiB chunk at `chunk`?
fn vmm_boot_identity_maps(chunk: u64) -> bool
    let e0: u64 = vmm_get_entry(vmm_pml4_phys, 0)
    if (e0 & PTE_PRESENT) == 0
        return false
    let pdpte: u64 = vmm_get_entry(e0 & PTE_ADDR_MASK, (chunk / ONE_GB) & 511)
    if (pdpte & PTE_PRESENT) == 0
        return false
    if (pdpte & PTE_HUGE) != 0
        return true
    let pde: u64 = vmm_get_entry(pdpte & PTE_ADDR_MASK, (chunk / TWO_MB) & 511)
    return (pde & PTE_PRESENT) != 0

# The UEFI loader identity-maps all of RAM (AGAST #4183: it runs from, and
# leaves BootInfo at, wherever firmware put them, 0x140000000 with -m 6G).
# Above 4 GiB that map is in the way: virtual 0x100000000 up is user space
# (init loads at 4 GiB in the kernel PML4), and the kernel reaches RAM there
# through the physmap. Once the physmap is up, drop the identity PDPT's
# entries from 4 GiB on; whatever still needs boot data above 4 GiB goes
# through phys_to_virt (kernel_main rebases its BootInfo pointer).
fn vmm_drop_identity_above_4g()
    let e0: u64 = vmm_get_entry(vmm_pml4_phys, 0)
    if (e0 & PTE_PRESENT) == 0
        return
    let pdpt: u64 = e0 & PTE_ADDR_MASK
    var dropped: u64 = 0
    var g: u64 = 4
    while g < 512
        if (vmm_get_entry(pdpt, g) & PTE_PRESENT) != 0
            vmm_set_entry(pdpt, g, 0)
            dropped = dropped + 1
        g = g + 1
    if dropped == 0
        return
    vmm_flush_tlb_all()
    klog("[vmm] identity map: dropped ")
    klog_dec(dropped)
    klog(" GiB above 4 GiB (physmap only)\n")

# A zeroed page-table page below 1 GiB (written through the identity map),
# or 0.
fn vmm_alloc_low_table() -> u64
    let t: u64 = pmm_alloc_page()
    if t == 0
        return 0
    if t + PAGE_SIZE > ONE_GB
        pmm_free_page(t)
        klog("[vmm] physmap: no table page below 1 GiB\n")
        return 0
    var i: u64 = 0
    while i < 512
        vmm_set_entry(t, i, 0)
        i = i + 1
    return t

# Flush TLB for a single page
pub fn vmm_flush_tlb(vaddr: u64)
    asm x86_64:
        movq {vaddr}, %rax
        invlpg (%rax)

# Flush entire TLB (reload CR3)
pub fn vmm_flush_tlb_all()
    var cr3_val: u64 = 0
    var cr3_ptr: *u64 = @cr3_val
    asm x86_64:
        movq %cr3, %rax
        movq {cr3_ptr}, %rcx
        movq %rax, (%rcx)
        movq %rax, %cr3

# ============================================================================
# Page Table Entry Access
# ============================================================================

# Get entry from a page table level, through the physmap (so any table pmm
# hands out is reachable, whatever CR3 is loaded).
# table_phys: physical address of table
# index: entry index (0-511)
fn vmm_get_entry(table_phys: u64, index: u64) -> u64
    let entry_ptr: *u64 = phys_to_virt(table_phys + index * 8) as *u64
    return *entry_ptr

# Set entry in a page table level
fn vmm_set_entry(table_phys: u64, index: u64, value: u64)
    let entry_ptr: *u64 = phys_to_virt(table_phys + index * 8) as *u64
    *entry_ptr = value

# Read a PML4 entry (public for debugging)
pub fn vmm_read_pml4_entry(pml4_phys: u64, index: u64) -> u64
    return vmm_get_entry(pml4_phys, index)

# ============================================================================
# Address Decomposition
# ============================================================================

# Extract page table indices from virtual address
fn vmm_pml4_index(vaddr: u64) -> u64
    return (vaddr >> 39) & 511

fn vmm_pdpt_index(vaddr: u64) -> u64
    return (vaddr >> 30) & 511

fn vmm_pd_index(vaddr: u64) -> u64
    return (vaddr >> 21) & 511

fn vmm_pt_index(vaddr: u64) -> u64
    return (vaddr >> 12) & 511

# ============================================================================
# Debug Functions
# ============================================================================

# Debug function: dump page table entries for a virtual address
pub fn vmm_debug_page_tables(vaddr: u64) -> i32
    klog("  Page table walk for vaddr=")
    klog_hex(vaddr)
    klog(":\n")

    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    klog("    PML4 index: ")
    klog_dec(pml4i)
    klog("\n")

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    klog("    PML4[")
    klog_dec(pml4i)
    klog("] = ")
    klog_hex(pml4_entry)
    if (pml4_entry & PTE_PRESENT) == 0
        klog(" (NOT PRESENT)\n")
        return -1
    klog("\n")

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    klog("    PDPT index: ")
    klog_dec(pdpti)
    klog(" at ")
    klog_hex(pdpt_phys)
    klog("\n")

    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    klog("    PDPT[")
    klog_dec(pdpti)
    klog("] = ")
    klog_hex(pdpt_entry)
    if (pdpt_entry & PTE_PRESENT) == 0
        klog(" (NOT PRESENT)\n")
        return -1
    klog("\n")

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    klog("    PD index: ")
    klog_dec(pdi)
    klog(" at ")
    klog_hex(pd_phys)
    klog("\n")

    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    klog("    PD[")
    klog_dec(pdi)
    klog("] = ")
    klog_hex(pd_entry)
    if (pd_entry & PTE_PRESENT) == 0
        klog(" (NOT PRESENT)\n")
        return -1
    klog("\n")

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    klog("    PT index: ")
    klog_dec(pti)
    klog(" at ")
    klog_hex(pt_phys)
    klog("\n")

    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    klog("    PT[")
    klog_dec(pti)
    klog("] = ")
    klog_hex(pt_entry)
    if (pt_entry & PTE_PRESENT) == 0
        klog(" (NOT PRESENT)\n")
        return -1
    klog("\n")

    return 0

# ============================================================================
# Page Mapping
# ============================================================================

# Map a single 4KB page
# Returns 0 on success, -1 on error (e.g., out of memory for page tables)
pub fn vmm_map_page(vaddr: u64, paddr: u64, flags: u64) -> i32
    # Calculate indices
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    # Walk/create page tables
    var pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    var pdpt_phys: u64 = 0

    # Check if we need to add USER bit to existing entries
    let need_user: u64 = flags & PTE_USER

    if (pml4_entry & PTE_PRESENT) == 0
        # Allocate new PDPT
        pdpt_phys = vmm_alloc_table()
        if pdpt_phys == 0
            return -1
        # Set PML4 entry
        vmm_set_entry(vmm_pml4_phys, pml4i, pdpt_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        pdpt_phys = pml4_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PML4 entry has USER bit
        if need_user != 0 && (pml4_entry & PTE_USER) == 0
            vmm_set_entry(vmm_pml4_phys, pml4i, pml4_entry | PTE_USER)

    var pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    var pd_phys: u64 = 0

    if (pdpt_entry & PTE_PRESENT) == 0
        # Allocate new PD
        pd_phys = vmm_alloc_table()
        if pd_phys == 0
            return -1
        # Set PDPT entry
        vmm_set_entry(pdpt_phys, pdpti, pd_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        if (pdpt_entry & PTE_HUGE) != 0
            return -1
        pd_phys = pdpt_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PDPT entry has USER bit
        if need_user != 0 && (pdpt_entry & PTE_USER) == 0
            vmm_set_entry(pdpt_phys, pdpti, pdpt_entry | PTE_USER)

    var pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    var pt_phys: u64 = 0

    if (pd_entry & PTE_PRESENT) == 0
        # Allocate new PT
        pt_phys = vmm_alloc_table()
        if pt_phys == 0
            return -1
        # Set PD entry
        vmm_set_entry(pd_phys, pdi, pt_phys | PTE_PRESENT | PTE_WRITABLE | PTE_USER)
    else
        if (pd_entry & PTE_HUGE) != 0
            return -1
        pt_phys = pd_entry & PTE_ADDR_MASK
        # If mapping a user page, ensure PD entry has USER bit
        if need_user != 0 && (pd_entry & PTE_USER) == 0
            vmm_set_entry(pd_phys, pdi, pd_entry | PTE_USER)

    # Set the final page table entry
    vmm_set_entry(pt_phys, pti, paddr | flags | PTE_PRESENT)

    # Flush TLB for this page
    vmm_flush_tlb(vaddr)

    return 0

# Unmap a single 4KB page
# Returns the physical address that was mapped, or 0 if not mapped
pub fn vmm_unmap_page(vaddr: u64) -> u64
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    if (pml4_entry & PTE_PRESENT) == 0
        return 0

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    if (pdpt_entry & PTE_PRESENT) == 0
        return 0

    if (pdpt_entry & PTE_HUGE) != 0
        return 0

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    if (pd_entry & PTE_PRESENT) == 0
        return 0

    if (pd_entry & PTE_HUGE) != 0
        return 0

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    if (pt_entry & PTE_PRESENT) == 0
        return 0

    let paddr: u64 = pt_entry & PTE_ADDR_MASK

    # Clear the entry
    vmm_set_entry(pt_phys, pti, 0)
    vmm_flush_tlb(vaddr)

    return paddr

# Replace the 2 MiB leaf at pd_phys[pdi] with a page table of 512 4 KiB pages
# mapping the same frames with the same attributes. Returns 0, or -1 when no
# page could be had for the table (the 2 MiB page then stays as it was).
fn vmm_split_huge_pd_entry(pd_phys: u64, pdi: u64) -> i32
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    let pt_phys: u64 = vmm_alloc_table()
    if pt_phys == 0
        return -1
    # A 2 MiB leaf keeps PAT in bit 12, a 4 KiB one in bit 7 (PTE_HUGE's).
    var leaf_flags: u64 = pd_entry & (0xFFF & ~PTE_HUGE)
    if (pd_entry & 0x1000) != 0
        leaf_flags = leaf_flags | 0x80
    leaf_flags = leaf_flags | (pd_entry & PTE_NO_EXECUTE)
    let base: u64 = pd_entry & PTE_ADDR_MASK & ~(TWO_MB - 1)
    var i: u64 = 0
    while i < 512
        vmm_set_entry(pt_phys, i, (base + i * PAGE_SIZE) | leaf_flags)
        i = i + 1
    vmm_set_entry(pd_phys, pdi, pt_phys | PTE_PRESENT | PTE_WRITABLE | (pd_entry & PTE_USER))
    return 0

# Unmap the kernel-half 4 KiB page at vaddr (page-aligned) in the current
# page tables, splitting the 2 MiB page that holds it first if need be. The
# kernel half's tables are shared by every address space (vmm_create_user_pml4
# copies the PML4 entries), so the page is gone under every CR3. Used for the
# syscall stack's guard page (AGAST #1877). Returns 0, or -1 if vaddr isn't
# mapped through a PD (absent, or inside a 1 GiB page) or no table page was
# free.
pub fn vmm_unmap_kernel_page(vaddr: u64) -> i32
    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, vmm_pml4_index(vaddr))
    if (pml4_entry & PTE_PRESENT) == 0
        return -1
    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, vmm_pdpt_index(vaddr))
    if (pdpt_entry & PTE_PRESENT) == 0 or (pdpt_entry & PTE_HUGE) != 0
        return -1
    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    let pdi: u64 = vmm_pd_index(vaddr)
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    if (pd_entry & PTE_PRESENT) == 0
        return -1
    if (pd_entry & PTE_HUGE) != 0
        if vmm_split_huge_pd_entry(pd_phys, pdi) != 0
            return -1
    let pt_phys: u64 = vmm_get_entry(pd_phys, pdi) & PTE_ADDR_MASK
    vmm_set_entry(pt_phys, vmm_pt_index(vaddr), 0)
    # The split changed the translation of all 2 MiB, not just this page.
    vmm_flush_tlb_all()
    vmm_flush_tlb(vaddr)
    return 0

# ============================================================================
# Address Translation
# ============================================================================

# Get physical address for a virtual address
# Returns 0 if not mapped (NOTE: 0 is a valid physical address!)
pub fn vmm_virt_to_phys(vaddr: u64) -> u64
    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    if (pml4_entry & PTE_PRESENT) == 0
        return 0

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    if (pdpt_entry & PTE_PRESENT) == 0
        return 0

    # 1GB page?
    if (pdpt_entry & PTE_HUGE) != 0
        let base: u64 = pdpt_entry & PTE_ADDR_MASK
        let offset: u64 = vaddr & 1073741823
        return base + offset

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    if (pd_entry & PTE_PRESENT) == 0
        return 0

    # 2MB page?
    if (pd_entry & PTE_HUGE) != 0
        let base: u64 = pd_entry & PTE_ADDR_MASK
        let offset: u64 = vaddr & 2097151
        return base + offset

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    if (pt_entry & PTE_PRESENT) == 0
        return 0

    let base: u64 = pt_entry & PTE_ADDR_MASK
    let offset: u64 = vaddr & 4095
    return base + offset

# ============================================================================
# Mapping Helpers
# ============================================================================

# Check if a physical address is already accessible (identity mapped)
# Returns 1 if mapped, 0 if not
pub fn vmm_is_accessible(paddr: u64) -> i32
    # Our boot.s identity maps the first 1GB using 2MB huge pages
    # Addresses above 1GB need explicit mapping
    let one_gb: u64 = 1073741824
    if paddr < one_gb
        return 1

    # Check if we've explicitly mapped this address
    let vaddr: u64 = paddr  # We use identity mapping
    let mapped: u64 = vmm_virt_to_phys(vaddr)
    if mapped == paddr
        return 1

    return 0

# Ensure a physical memory region is accessible
# Maps pages if they're not in the identity-mapped region
# Returns 0 on success, -1 on error
pub fn vmm_ensure_mapped(paddr: u64, size: u64) -> i32
    let one_gb: u64 = 1073741824

    # If entirely within identity-mapped region, nothing to do
    if paddr + size <= one_gb
        return 0

    # Map each 4KB page in the region
    let page_mask: u64 = 0xFFFFFFFFFFFFF000
    var addr: u64 = paddr & page_mask
    let end: u64 = (paddr + size + 4095) & page_mask

    while addr < end
        # Skip if in identity-mapped region
        if addr < one_gb
            addr = addr + 4096
            continue

        # Check if already mapped
        if vmm_is_accessible(addr) == 1
            addr = addr + 4096
            continue

        # Map this page (identity mapping - vaddr = paddr)
        let result: i32 = vmm_map_page(addr, addr, PTE_WRITABLE)
        if result != 0
            klog("vmm_ensure_mapped: failed to map ")
            klog_hex(addr)
            klog("\n")
            return -1

        addr = addr + 4096

    return 0

# ============================================================================
# Device MMIO Window (AGAST #3438)
# ============================================================================
#
# Device registers (virtio modern PCI capabilities, ...) live in BARs that
# can sit anywhere in the 52-bit physical space, often above 4 GiB. They are
# mapped uncached into a bump-allocated window at PML4[257], the slot after
# the physmap. Being kernel-half, vmm_create_user_pml4 copies it into every
# process, so a driver polled from a syscall reaches its registers whatever
# CR3 is loaded. A process PML4 copies PML4[257] by value, so the entry only
# reaches processes created after it exists: vmm_init_physmap creates its
# PDPT before any process (vmm_init_mmio_window, AGAST #3577), and every
# later mapping, boot-time or not, lands below that one shared PDPT.
#
# Before #3438 virtio used 0xFFFFFFFF90000000, inside the boot loader's
# 2 MiB-page map of the kernel half: vmm_map_page refused it, the error was
# ignored and the "registers" were RAM at phys 0x10000000.
pub const MMIO_WINDOW_BASE: u64 = 0xFFFF808000000000
const MMIO_WINDOW_SIZE: u64 = 0x8000000000    # 512 GiB, all of PML4[257]

var g_mmio_next: u64 = 0xFFFF808000000000    # MMIO_WINDOW_BASE (ritz0: literal initializers only)

const MMIO_PML4_INDEX: u64 = 257

# Give PML4[257] its PDPT now, so the entry every process copies is the one
# vmm_map_mmio fills in later. Leaves an entry that is already present (its
# mappings stay). Returns 0, or -1 when no table page is free.
pub fn vmm_init_mmio_window() -> i32
    if (vmm_get_entry(vmm_pml4_phys, MMIO_PML4_INDEX) & PTE_PRESENT) != 0
        return 0
    let pdpt: u64 = vmm_alloc_low_table()
    if pdpt == 0
        return -1
    vmm_set_entry(vmm_pml4_phys, MMIO_PML4_INDEX, pdpt | PTE_PRESENT | PTE_WRITABLE)
    return 0

# Map size bytes of device memory at physical address paddr with the
# caching bits `cache`. Returns the kernel virtual address of paddr itself
# (page offset kept), or 0 on failure.
fn vmm_map_mmio_cached(paddr: u64, size: u64, cache: u64) -> u64
    if size == 0
        return 0
    let page_mask: u64 = 0xFFFFFFFFFFFFF000
    let first: u64 = paddr & page_mask
    let end: u64 = (paddr + size + PAGE_SIZE - 1) & page_mask
    if end <= first
        return 0
    let len: u64 = end - first
    if len > MMIO_WINDOW_BASE + MMIO_WINDOW_SIZE - g_mmio_next
        klog("[vmm] MMIO window exhausted\n")
        return 0
    let virt: u64 = g_mmio_next
    var off: u64 = 0
    while off < len
        if vmm_map_page(virt + off, first + off, PTE_WRITABLE | cache | g_pte_nx) != 0
            klog("[vmm] MMIO map failed at phys ")
            klog_hex(first + off)
            klog("\n")
            return 0
        off = off + PAGE_SIZE
    g_mmio_next = virt + len
    return virt + (paddr - first)

# Device registers: uncached (PCD|PWT).
pub fn vmm_map_mmio(paddr: u64, size: u64) -> u64
    vmm_map_mmio_cached(paddr, size, PTE_CACHE_DISABLE | PTE_WRITE_THROUGH)

# A framebuffer: write-combining (PAT entry 4, set up by pat_init on every
# CPU). Stores merge into bursts; reads are slow, so nothing reads it back.
pub fn vmm_map_mmio_wc(paddr: u64, size: u64) -> u64
    vmm_map_mmio_cached(paddr, size, PTE_PAT_WC)

# ============================================================================
# Debug Functions
# ============================================================================

# Dump page table entries for a virtual address (for debugging)
pub fn vmm_dump_pte(vaddr: u64) -> i32
    klog("  PTE dump for 0x")
    klog_hex(vaddr)
    klog(":\n")

    let pml4i: u64 = vmm_pml4_index(vaddr)
    let pdpti: u64 = vmm_pdpt_index(vaddr)
    let pdi: u64 = vmm_pd_index(vaddr)
    let pti: u64 = vmm_pt_index(vaddr)

    klog("    PML4[")
    klog_dec(pml4i)
    klog("]: ")
    let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
    klog_hex(pml4_entry)
    vmm_print_flags(pml4_entry)
    klog("\n")

    if (pml4_entry & PTE_PRESENT) == 0
        klog("    (not present)\n")
        return -1

    let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
    klog("    PDPT[")
    klog_dec(pdpti)
    klog("]: ")
    let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
    klog_hex(pdpt_entry)
    vmm_print_flags(pdpt_entry)
    klog("\n")

    if (pdpt_entry & PTE_PRESENT) == 0
        klog("    (not present)\n")
        return -1

    if (pdpt_entry & PTE_HUGE) != 0
        klog("    (1GB huge page)\n")
        return 0

    let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
    klog("    PD[")
    klog_dec(pdi)
    klog("]: ")
    let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
    klog_hex(pd_entry)
    vmm_print_flags(pd_entry)
    klog("\n")

    if (pd_entry & PTE_PRESENT) == 0
        klog("    (not present)\n")
        return -1

    if (pd_entry & PTE_HUGE) != 0
        klog("    (2MB huge page)\n")
        return 0

    let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
    klog("    PT[")
    klog_dec(pti)
    klog("]: ")
    let pt_entry: u64 = vmm_get_entry(pt_phys, pti)
    klog_hex(pt_entry)
    vmm_print_flags(pt_entry)
    klog("\n")

    return 0

# Print PTE flags in human-readable form
fn vmm_print_flags(entry: u64)
    klog(" [")
    if (entry & PTE_PRESENT) != 0
        klog("P")
    else
        klog("-")
    if (entry & PTE_WRITABLE) != 0
        klog("W")
    else
        klog("-")
    if (entry & PTE_USER) != 0
        klog("U")
    else
        klog("-")
    if (entry & PTE_HUGE) != 0
        klog("H")
    else
        klog("-")
    klog("]")

# ============================================================================
# Per-Process Page Tables
# ============================================================================
# These functions support multiple address spaces by allowing operations
# on page tables other than the currently active vmm_pml4_phys.

# Create a new PML4 for a process, copying kernel mappings
# Returns physical address of new PML4, or 0 on failure
#
# This creates an isolated address space that shares NOTHING below
# PML4[256] (AGAST #1878):
#
# 1. PML4[0-255] - the process's own. They start absent; the program image
#    at 4 GiB (PML4[0]), the mmap region (from PML4[1],
#    syscall/runtime/memory.ritz) and the user stack (PML4[255]) allocate
#    their tables on demand. The kernel never needs an identity address
#    here: RAM comes through the physmap and devices through the MMIO
#    window, both in the kernel half below.
#
# 2. PML4[256-511] - kernel half (shared copy): the physmap (PML4[256]),
#    the MMIO window (PML4[257]), kernel code, data and heap.
#
# The invariant that nothing below PML4[256] is shared is checked below: a
# shared entry is the identity map reappearing and would alias kernel memory
# into every process.
pub fn vmm_create_user_pml4() -> u64
    # Allocate a new PML4 page
    let new_pml4: u64 = vmm_alloc_table()
    if new_pml4 == 0
        klog("[vmm] Failed to allocate PML4\n")
        return 0
    var i: u64 = 0

    # Copy kernel mappings (upper half of address space)
    # PML4 indices 256-511 map addresses 0xFFFF800000000000 and above
    # This includes:
    #   - Physmap (PML4[256]) and MMIO window (PML4[257])
    #   - Higher-half kernel code/data (0xFFFFFFFF80000000)
    #   - Kernel heap (0xFFFFFFFFC0000000)
    i = 256
    while i < 512
        let entry: u64 = vmm_get_entry(vmm_pml4_phys, i)
        if (entry & PTE_PRESENT) != 0
            # Copy the entry (without USER bit for kernel mappings)
            vmm_set_entry(new_pml4, i, entry & ~PTE_USER)
        i = i + 1

    # The lower half must be empty: vmm_alloc_table zeroed it and nothing
    # above touches it. Fail loudly if that ever stops being true.
    if vmm_lower_half_present(new_pml4)
        klog("[vmm] user PML4 shares an entry below 256\n")
        vmm_free_pml4(new_pml4)
        return 0

    return new_pml4

# True if any PML4 entry below the kernel half (index 256) is present.
fn vmm_lower_half_present(pml4: u64) -> bool
    var i: u64 = 0
    while i < 256
        if (vmm_get_entry(pml4, i) & PTE_PRESENT) != 0
            return true
        i = i + 1
    return false

# Switch to a different page table (set CR3)
# pml4_phys: physical address of new PML4
pub fn vmm_switch_pml4(pml4_phys: u64)
    # Update our cached value
    vmm_pml4_phys = pml4_phys

    # Write to CR3 - this automatically flushes the TLB
    asm x86_64:
        movq {pml4_phys}, %rax
        movq %rax, %cr3

# Get current PML4 physical address
pub fn vmm_get_current_pml4() -> u64
    return vmm_pml4_phys

# Reserve all page table pages in the PMM so they won't be reallocated.
# This walks the entire PML4 and marks all PDPT, PD, and PT pages as used.
# Call this after kheap_init since the heap creates new page table entries.
pub fn vmm_reserve_page_tables()
    # Reserve the PML4 itself
    pmm_mark_region_used(vmm_pml4_phys, PAGE_SIZE)

    # Walk all present PML4 entries
    var pml4i: u64 = 0
    while pml4i < 512
        let pml4_entry: u64 = vmm_get_entry(vmm_pml4_phys, pml4i)
        if (pml4_entry & PTE_PRESENT) != 0
            vmm_reserve_pdpt(pml4_entry & PTE_ADDR_MASK)
        pml4i = pml4i + 1

# Reserve a PDPT page and every PD (and PT) below its present, non-huge entries.
fn vmm_reserve_pdpt(pdpt_phys: u64)
    pmm_mark_region_used(pdpt_phys, PAGE_SIZE)
    var pdpti: u64 = 0
    while pdpti < 512
        let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpti)
        if (pdpt_entry & PTE_PRESENT) != 0 and (pdpt_entry & PTE_HUGE) == 0
            vmm_reserve_pd(pdpt_entry & PTE_ADDR_MASK)
        pdpti = pdpti + 1

# Reserve a PD page and every PT below its present, non-huge entries.
fn vmm_reserve_pd(pd_phys: u64)
    pmm_mark_region_used(pd_phys, PAGE_SIZE)
    var pdi: u64 = 0
    while pdi < 512
        let pd_entry: u64 = vmm_get_entry(pd_phys, pdi)
        if (pd_entry & PTE_PRESENT) != 0 and (pd_entry & PTE_HUGE) == 0
            pmm_mark_region_used(pd_entry & PTE_ADDR_MASK, PAGE_SIZE)
        pdi = pdi + 1

# Map a page in a specific page table (not necessarily the active one)
# This is used to set up a process's address space before switching to it
pub fn vmm_map_page_in(pml4: u64, vaddr: u64, paddr: u64, flags: u64) -> i32
    # Save current PML4
    let saved_pml4: u64 = vmm_pml4_phys

    # Temporarily switch to target PML4
    vmm_pml4_phys = pml4

    # Map the page using normal function
    let result: i32 = vmm_map_page(vaddr, paddr, flags)

    # Restore original PML4
    vmm_pml4_phys = saved_pml4

    return result

# vmm_unmap_page in a specific page table: the frame that was mapped at
# vaddr, or 0. The tables stay. Its invlpg reaches only the current address
# space; a pml4 that is not loaded has no TLB entries for vaddr on this CPU.
pub fn vmm_unmap_page_in(pml4: u64, vaddr: u64) -> u64
    let saved_pml4: u64 = vmm_pml4_phys
    vmm_pml4_phys = pml4
    let paddr: u64 = vmm_unmap_page(vaddr)
    vmm_pml4_phys = saved_pml4
    return paddr

# The address just past the highest leaf mapped in the 512 GiB PML4 slot at
# `slot_base` in `pml4`, or slot_base when the slot maps nothing: the next
# free address of a window filled from its base, such as a driver's MMIO
# and DMA windows (DrvMmioMap, DrvDmaAlloc, AGAST #4720). It is read from
# the page tables, so it needs no per-process state, dies with the PML4,
# and moves back down when a failed map clears its leaves. A quarantined
# leaf (not present, PTE_DEVICE) counts as used, so its VA is never handed
# out again in that address space (DrvDmaFree, AGAST #4725). A huge leaf
# counts to its end. Walks from the top: one entry per level in the usual
# case of a window filled from its base.
pub fn vmm_slot_end(pml4: u64, slot_base: u64) -> u64
    let pml4_entry: u64 = vmm_get_entry(pml4, vmm_pml4_index(slot_base))
    if (pml4_entry & PTE_PRESENT) == 0
        return slot_base
    let pdpt: u64 = pml4_entry & PTE_ADDR_MASK
    var i: u64 = 512
    while i > 0
        i = i - 1
        let pdpt_entry: u64 = vmm_get_entry(pdpt, i)
        let gib: u64 = slot_base + (i << 30)
        if (pdpt_entry & PTE_PRESENT) != 0 and (pdpt_entry & PTE_HUGE) != 0
            return gib + ONE_GB
        if (pdpt_entry & PTE_PRESENT) != 0
            let pd: u64 = pdpt_entry & PTE_ADDR_MASK
            var j: u64 = 512
            while j > 0
                j = j - 1
                let pd_entry: u64 = vmm_get_entry(pd, j)
                let mib: u64 = gib + (j << 21)
                if (pd_entry & PTE_PRESENT) != 0 and (pd_entry & PTE_HUGE) != 0
                    return mib + TWO_MB
                if (pd_entry & PTE_PRESENT) != 0
                    let pt: u64 = pd_entry & PTE_ADDR_MASK
                    var k: u64 = 512
                    while k > 0
                        k = k - 1
                        # a quarantined leaf (vmm_quarantine_page_in) holds its VA
                        if (vmm_get_entry(pt, k) & (PTE_PRESENT | PTE_DEVICE)) != 0
                            return mib + (k << 12) + PAGE_SIZE
    slot_base

# The 4 KiB leaf PTE mapping vaddr in `pml4`, flags and all, or 0 when
# vaddr has none (absent, or inside a huge page).
pub fn vmm_pte_in(pml4: u64, vaddr: u64) -> u64
    let pt: u64 = match vmm_leaf_table_in(pml4, vaddr)
        Some(t) => t
        None => return 0
    let pt_entry: u64 = vmm_get_entry(pt, vmm_pt_index(vaddr))
    if (pt_entry & PTE_PRESENT) == 0
        return 0
    return pt_entry

# The page table holding vaddr's 4 KiB leaf in `pml4`, None when there is
# none (a level absent, or a huge page on the way).
fn vmm_leaf_table_in(pml4: u64, vaddr: u64) -> Option<u64>
    let pml4_entry: u64 = vmm_get_entry(pml4, vmm_pml4_index(vaddr))
    if (pml4_entry & PTE_PRESENT) == 0
        return None
    let pdpt_entry: u64 = vmm_get_entry(pml4_entry & PTE_ADDR_MASK, vmm_pdpt_index(vaddr))
    if (pdpt_entry & PTE_PRESENT) == 0 or (pdpt_entry & PTE_HUGE) != 0
        return None
    let pd_entry: u64 = vmm_get_entry(pdpt_entry & PTE_ADDR_MASK, vmm_pd_index(vaddr))
    if (pd_entry & PTE_PRESENT) == 0 or (pd_entry & PTE_HUGE) != 0
        return None
    Some(pd_entry & PTE_ADDR_MASK)

# Quarantine the 4 KiB leaf at vaddr in `pml4` (DrvDmaFree and exit, when a
# unit didn't confirm the IOTLB invalidation that took the frame out of a
# device's domain; AGAST #4725, RING1_DRIVER.md §5). The leaf is unmapped
# (invlpg as vmm_unmap_page_in), then rewritten not present with PTE_DEVICE
# and the frame: a stale pointer faults, vmm_free_user_pt (present leaves
# only) never gives the frame to the PMM, and vmm_slot_end counts the page,
# so the VA is not handed out again. The frame, or None if vaddr had no
# present 4 KiB leaf (nothing changed).
pub fn vmm_quarantine_page_in(pml4: u64, vaddr: u64) -> Option<u64>
    let pt: u64 = match vmm_leaf_table_in(pml4, vaddr)
        Some(t) => t
        None => return None
    let paddr: u64 = vmm_unmap_page_in(pml4, vaddr)
    if paddr == 0
        return None
    vmm_set_entry(pt, vmm_pt_index(vaddr), paddr | PTE_DEVICE)
    Some(paddr)

# Free all user-space pages in a page table (for process cleanup)
# Does NOT free the kernel mappings or the PML4 itself
#
# Every PDPT below PML4[0..255] is the process's own: vmm_create_user_pml4
# shares nothing below PML4[256] (AGAST #1878), so each is freed whole.
pub fn vmm_free_user_pages(pml4: u64)
    # User space is in the lower half (PML4 indices 0-255)
    # Walk each level and free pages

    var pml4_idx: u64 = 0
    while pml4_idx < 256  # Only lower half (user space)
        let pml4_entry: u64 = vmm_get_entry(pml4, pml4_idx)
        if (pml4_entry & PTE_PRESENT) == 0
            pml4_idx = pml4_idx + 1
            continue

        # Free the PDPT subtree, then the PDPT itself (allocated by vmm_create_user_pml4)
        let pdpt_phys: u64 = pml4_entry & PTE_ADDR_MASK
        vmm_free_user_pdpt(pdpt_phys)
        pmm_free_page(pdpt_phys)
        pml4_idx = pml4_idx + 1

# Free every user PD subtree below a PDPT (not the PDPT page itself).
# The PDPT belongs to the process alone, so every present non-huge entry is
# freed (AGAST #1878 removed the shared identity/APIC entries this used to
# skip).
fn vmm_free_user_pdpt(pdpt_phys: u64)
    var pdpt_idx: u64 = 0
    while pdpt_idx < 512
        let pdpt_entry: u64 = vmm_get_entry(pdpt_phys, pdpt_idx)
        # Skip absent entries and 1GB pages
        if (pdpt_entry & PTE_PRESENT) != 0 and (pdpt_entry & PTE_HUGE) == 0
            let pd_phys: u64 = pdpt_entry & PTE_ADDR_MASK
            vmm_free_user_pd(pd_phys)
            # Free the PD itself
            pmm_free_page(pd_phys)
        pdpt_idx = pdpt_idx + 1

# Free every user PT (and the pages it maps) below a PD (not the PD page itself).
fn vmm_free_user_pd(pd_phys: u64)
    var pd_idx: u64 = 0
    while pd_idx < 512
        let pd_entry: u64 = vmm_get_entry(pd_phys, pd_idx)
        # 2MB pages: could free but skip for now
        if (pd_entry & PTE_PRESENT) != 0 and (pd_entry & PTE_HUGE) == 0
            let pt_phys: u64 = pd_entry & PTE_ADDR_MASK
            vmm_free_user_pt(pt_phys)
            # Free the PT itself
            pmm_free_page(pt_phys)
        pd_idx = pd_idx + 1

# Free every present RAM page a PT's process owns (not the PT page itself).
fn vmm_free_user_pt(pt_phys: u64)
    var pt_idx: u64 = 0
    while pt_idx < 512
        let pt_entry: u64 = vmm_get_entry(pt_phys, pt_idx)
        # Owned pages only: a PTE_DEVICE frame is MMIO, not the PMM's, and
        # may lie below the top of RAM (#2755); a PTE_SHM frame belongs to
        # its ShmObject, which outlives this mapping (#4717).
        if (pt_entry & PTE_PRESENT) != 0 and (pt_entry & (PTE_DEVICE | PTE_SHM)) == 0
            pmm_free_page(pt_entry & PTE_ADDR_MASK)
        pt_idx = pt_idx + 1

# Free a page table hierarchy completely (for process termination)
pub fn vmm_free_pml4(pml4: u64)
    # First free all user pages
    vmm_free_user_pages(pml4)

    # Then free the PML4 itself
    pmm_free_page(pml4)
