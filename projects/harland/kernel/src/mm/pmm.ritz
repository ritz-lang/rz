# Harland Physical Memory Manager (Bitmap Allocator)
#
# Manages physical memory using a bitmap where each bit represents a 4KB page.
# 1 = free, 0 = used
#
# This is the foundation of memory management - VMM and heap depend on it.
#
# Per-CPU frame caches (AGAST #4879, docs/SMP_USER.md §2 "Per-CPU frame
# caches"). Each CPU keeps a stack of up to 64 free frames. pmm_alloc_page
# pops from this CPU's stack; an empty stack takes 32 frames from the global
# pool in one bitmap pass from pmm_next_free. pmm_free_page pushes; a stack
# past 64 gives its oldest 32 back in one pass. A CPU touches only its own
# stack, with IF saved and cleared, because the tick frees frames too
# (shm_detach_expired). pmm_alloc_contig and pmm_alloc_page_high go to the
# pool; when it has nothing that fits they take back this CPU's stack and
# look once more. A frame in a stack is free: pmm_get_free_pages,
# pmm_range_has_free and the double-free check count it.
#
# pmm_lock (SMP_USER.md §2 "The leaf locks") covers the bitmap, its count
# and its hints. It is held for one batch, one contig or high allocation or
# one region mark, and calls nothing else. Lock order: pmm_lock, then
# klog_lock. A hosted test turns its IF save off with pmm_irqsave(false)
# (cli faults in ring 3); the stacks' IF save follows the same switch.

import klog { klog, klog_dec, klog_hex, klog_hex_prefix }
import ritzlib.option
import sync.spin { SpinLock, SpinGuard, spin_lock, spin_unlock, spin_set_irqsave, spin_irq_off, spin_irq_restore }

# Declared, not imported, as proc/waitset.ritz declares lapic_is_bsp: the
# kernel's is arch/x86_64/percpu.ritz cpu_index (0 before GS is set up), and
# a host test that compiles this module supplies its own.
extern fn cpu_index() -> i32

# ============================================================================
# Page Constants (shared with VMM and heap)
# ============================================================================

pub const PAGE_SIZE: u64 = 4096
pub const PAGE_SHIFT: u64 = 12

# The bitmap is sized at boot from the memory map's highest usable address
# (AGAST #4183; until then a fixed 128 KiB array capped RAM at 4 GiB). Its
# ceiling is what the physmap can reach: PML4[256], 512 GiB, a 16 MiB bitmap.
pub const PMM_MAX_PAGES: u64 = 134217728

# Until the physmap is up the bitmap is reached through the boot identity
# map, so it must end below 1 GiB; afterwards just below the top of RAM would
# do, but keeping it in the first GiB costs nothing.
const PMM_BITMAP_LIMIT: u64 = 0x40000000

# ============================================================================
# Multiboot2 Information Structures (for memory map parsing)
# ============================================================================

# Multiboot2 tag types
pub const MB2_TAG_END: u32 = 0
pub const MB2_TAG_CMDLINE: u32 = 1
pub const MB2_TAG_BOOTLOADER_NAME: u32 = 2
pub const MB2_TAG_MODULE: u32 = 3
pub const MB2_TAG_BASIC_MEMINFO: u32 = 4
pub const MB2_TAG_BOOTDEV: u32 = 5
pub const MB2_TAG_MMAP: u32 = 6
pub const MB2_TAG_VBE: u32 = 7
pub const MB2_TAG_FRAMEBUFFER: u32 = 8
pub const MB2_TAG_ELF_SECTIONS: u32 = 9
pub const MB2_TAG_APM: u32 = 10
pub const MB2_TAG_EFI32: u32 = 11
pub const MB2_TAG_EFI64: u32 = 12
pub const MB2_TAG_SMBIOS: u32 = 13
pub const MB2_TAG_ACPI_OLD: u32 = 14
pub const MB2_TAG_ACPI_NEW: u32 = 15
pub const MB2_TAG_NETWORK: u32 = 16
pub const MB2_TAG_EFI_MMAP: u32 = 17
pub const MB2_TAG_EFI_BS: u32 = 18
pub const MB2_TAG_EFI32_IH: u32 = 19
pub const MB2_TAG_EFI64_IH: u32 = 20
pub const MB2_TAG_LOAD_BASE_ADDR: u32 = 21

# Memory map entry types
pub const MB2_MEMORY_AVAILABLE: u32 = 1
pub const MB2_MEMORY_RESERVED: u32 = 2
pub const MB2_MEMORY_ACPI_RECLAIMABLE: u32 = 3
pub const MB2_MEMORY_NVS: u32 = 4
pub const MB2_MEMORY_BADRAM: u32 = 5

# Multiboot2 fixed boot info header
pub struct Mb2BootInfo
    total_size: u32
    reserved: u32

# Generic tag header (all tags start with this)
pub struct Mb2Tag
    tag_type: u32
    size: u32

# Basic memory info tag
pub struct Mb2BasicMemInfo
    tag_type: u32
    size: u32
    mem_lower: u32
    mem_upper: u32

# Memory map tag header
pub struct Mb2MmapTag
    tag_type: u32
    size: u32
    entry_size: u32
    entry_version: u32
    # Followed by variable number of Mb2MmapEntry

# Memory map entry (e820-style)
pub struct Mb2MmapEntry
    base_addr: u64
    length: u64
    entry_type: u32
    reserved: u32

# Boot module tag (type 3, multiboot2 spec 3.6.6): a file GRUB's `module2`
# loaded into RAM at [mod_start, mod_end). Followed by its command line.
pub struct Mb2ModuleTag
    tag_type: u32
    size: u32
    mod_start: u32
    mod_end: u32

# The first boot module's tag (GRUB's `module2 /boot/initramfs.tar`, AGAST
# #4258), or 0 if GRUB loaded none. GRUB marks the module's pages as
# available RAM in the memory map: the caller must reserve them.
pub fn mb2_find_module(mb_info: *Mb2BootInfo) -> *Mb2ModuleTag
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    var tag_ptr: u64 = (mb_info as u64) + 8
    while tag_ptr + 8 <= info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag
        if (*tag).tag_type == MB2_TAG_END or (*tag).size < 8
            break
        if (*tag).tag_type == MB2_TAG_MODULE and (*tag).size >= 16
            let m: *Mb2ModuleTag = tag_ptr as *Mb2ModuleTag
            if (*m).mod_end > (*m).mod_start
                return m
        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7
    return 0 as *Mb2ModuleTag

# EFI memory map tag (type 17, multiboot2 spec 3.6.15): the map GRUB's
# ExitBootServices call was accepted with, descr_size-byte descriptors from
# offset 16.
pub struct Mb2EfiMmapTag
    tag_type: u32
    size: u32
    descr_size: u32
    descr_vers: u32

# EFI_MEMORY_DESCRIPTOR (UEFI spec 7.2), its 40 defined bytes: firmware may
# pad each to a larger descr_size (OVMF: 48).
pub struct EfiMemDesc
    mem_type: u32
    pad: u32
    phys_start: u64
    virt_start: u64
    num_pages: u64
    attribute: u64

const EFI_MEM_DESC_MIN: u64 = 40
const EFI_LOADER_CODE: u32 = 1
const EFI_LOADER_DATA: u32 = 2
const EFI_BOOT_SERVICES_CODE: u32 = 3
const EFI_BOOT_SERVICES_DATA: u32 = 4
const EFI_CONVENTIONAL_MEMORY: u32 = 7

# RAM that is free once boot services have exited: conventional memory, and
# the loader's and boot services' pages. GRUB's type-6 tag counts the same
# five as AVAILABLE.
fn efi_mem_usable(mem_type: u32) -> bool
    return mem_type == EFI_CONVENTIONAL_MEMORY or mem_type == EFI_LOADER_CODE or mem_type == EFI_LOADER_DATA or mem_type == EFI_BOOT_SERVICES_CODE or mem_type == EFI_BOOT_SERVICES_DATA

# The EFI memory map tag; None if GRUB passed none or its descriptors are
# shorter than EFI_MEMORY_DESCRIPTOR.
fn mb2_efi_mmap(mb_info: *Mb2BootInfo) -> Option<*Mb2EfiMmapTag>
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    var tag_ptr: u64 = (mb_info as u64) + 8
    while tag_ptr + 8 <= info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag
        if (*tag).tag_type == MB2_TAG_END or (*tag).size < 8
            break
        if (*tag).tag_type == MB2_TAG_EFI_MMAP and (*tag).size >= 16
            let efi: *Mb2EfiMmapTag = tag_ptr as *Mb2EfiMmapTag
            if (*efi).descr_size as u64 >= EFI_MEM_DESC_MIN
                return Some(efi)
        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7
    return None

# ============================================================================
# Harland Boot Protocol (UEFI bootloader native format)
# ============================================================================

# The handoff layout (HarlandBootInfo, HarlandMemEntry, HARLAND_BOOT_*) is
# boot_abi/src/handoff.ritz, the one declaration the UEFI loader also compiles
# (AGAST #4578).
import boot_abi.handoff { HarlandBootInfo, HarlandMemEntry, HARLAND_MEM_USABLE }

# Boot protocol type detected at runtime
pub const BOOT_PROTOCOL_UNKNOWN: u32 = 0
pub const BOOT_PROTOCOL_MULTIBOOT2: u32 = 1
pub const BOOT_PROTOCOL_HARLAND: u32 = 2

# ============================================================================
# PMM State
# ============================================================================

# Bitmap: 1 bit per page, 1 = free, 0 = used. Lives at physical
# pmm_bitmap_addr and tracks pmm_bitmap_pages pages.
var pmm_bitmap_addr: u64 = 0

# vmm owns the physmap and imports pmm, so pmm cannot import it back (no
# import cycles). vmm tells us the direct map's offset once PML4[256] is up;
# before that it is 0 and the boot identity map reaches the bitmap. Every
# process shares PML4[256], so this is valid whatever CR3 is loaded (AGAST
# #1878: process PML4s no longer carry the identity map).
var pmm_physmap_offset: u64 = 0

pub fn pmm_set_physmap_offset(offset: u64)
    pmm_physmap_offset = offset
var pmm_bitmap_pages: u64 = 0
var pmm_total_pages: u64 = 0
var pmm_free_pages: u64 = 0
var pmm_initialized: bool = false

# Allocation hints (AGAST #4183), instead of scanning from page 0 / the top
# on every allocation:
#   no page in [1, pmm_next_free) is free  (pmm_alloc_page starts there)
#   no page at or above pmm_high_free is free  (pmm_alloc_page_high, down)
var pmm_next_free: u64 = 1
var pmm_high_free: u64 = 0

# The frame caches: CPU c's stack is pmm_cache[c * 64 ..], pmm_cache_n[c]
# deep, the top at the end. Literal lengths: PMM_MAX_CPUS (cpu_map.ritz
# MAX_CPUS) times PMM_CACHE_MAX.
const PMM_MAX_CPUS: i32 = 64
const PMM_CACHE_MAX: u64 = 64
const PMM_CACHE_BATCH: u64 = 32
var pmm_cache: [4096]u64
var pmm_cache_n: [64]u64

var pmm_lock: SpinLock = SpinLock { next: 0, serving: 0, irqsave: true, _pad: [0, 0, 0, 0, 0, 0, 0] }

# Whether pmm_lock and the frame caches save and clear IF (the kernel: on;
# a hosted test, where cli faults: off).
pub fn pmm_irqsave(on: bool)
    spin_set_irqsave(@pmm_lock, on)

# OOM injection for boot self-tests (AGAST #3552). While armed, each
# allocation spends one unit of budget, and once it is spent every
# allocation fails as if RAM had run out. Never armed outside a self-test.
var pmm_fail_armed: bool = false
var pmm_fail_budget: u64 = 0

# Ranges the boot paths must not put the bitmap on (kernel image, boot
# info, memory map, ...), and the bitmap site the scan picked.
const PMM_AVOID_MAX: u64 = 8
var pmm_avoid_base: [8]u64
var pmm_avoid_end: [8]u64
var pmm_avoid_count: u64 = 0
var pmm_site: u64 = 0

# ============================================================================
# Internal Bitmap Operations
# ============================================================================

fn pmm_byte(page: u64) -> *u8
    return (pmm_bitmap_addr + pmm_physmap_offset + page / 8) as *u8

# Set a bit (mark page as free)
fn pmm_set_bit(page: u64)
    let b: *u8 = pmm_byte(page)
    *b = *b | (1 << (page % 8) as u8)

# Clear a bit (mark page as used)
fn pmm_clear_bit(page: u64)
    let b: *u8 = pmm_byte(page)
    *b = *b & ~(1 << (page % 8) as u8)

# Test if a bit is set (page is free)
fn pmm_test_bit(page: u64) -> bool
    return (*pmm_byte(page) & (1 << (page % 8) as u8)) != 0

fn pmm_page_up(a: u64) -> u64
    return (a + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)

# ============================================================================
# PMM Initialization
# ============================================================================

# Bytes of bitmap (whole pages) for RAM ending at top.
fn pmm_bitmap_bytes_for(top: u64) -> u64
    var pages: u64 = top / PAGE_SIZE
    if pages > PMM_MAX_PAGES
        pages = PMM_MAX_PAGES
    return pmm_page_up((pages + 7) / 8)

# Start tracking max_pages pages with the bitmap at `bitmap`, every page
# used. The boot paths call it with a bitmap they carved out of RAM; tests
# pass their own.
pub fn pmm_init(bitmap: *u8, max_pages: u64)
    var pages: u64 = max_pages
    if pages > PMM_MAX_PAGES
        pages = PMM_MAX_PAGES
    pmm_bitmap_addr = bitmap as u64
    pmm_bitmap_pages = pages
    let bytes: u64 = (pages + 7) / 8
    var i: u64 = 0
    while i < bytes
        let b: *u8 = (pmm_bitmap_addr + pmm_physmap_offset + i) as *u8
        *b = 0
        i = i + 1
    pmm_total_pages = 0
    pmm_free_pages = 0
    pmm_next_free = 1
    pmm_high_free = 0
    var c: i32 = 0
    while c < PMM_MAX_CPUS
        pmm_cache_n[c] = 0
        c = c + 1
    pmm_initialized = true

# Physical address of the bitmap (0 before a boot path set one up).
pub fn pmm_bitmap_phys() -> u64
    return pmm_bitmap_addr

# Bytes the bitmap spans.
pub fn pmm_bitmap_size() -> u64
    return (pmm_bitmap_pages + 7) / 8

# Mark a range of physical memory as available
pub fn pmm_mark_region_free(base: u64, length: u64) -> i32
    if not pmm_initialized
        return -1
    var start_page: u64 = (base + PAGE_SIZE - 1) / PAGE_SIZE
    var end_page: u64 = (base + length) / PAGE_SIZE
    if end_page > pmm_bitmap_pages
        end_page = pmm_bitmap_pages
    # Keep physical page 0 permanently unavailable so address 0
    # remains an unambiguous allocation-failure sentinel (#2749).
    if start_page == 0
        start_page = 1
    if start_page >= end_page
        return 0

    # Boot-time: no frame of the range sits in a cache.
    let g: SpinGuard = spin_lock(@pmm_lock)
    var page: u64 = start_page
    while page < end_page
        if not pmm_test_bit(page)
            pmm_set_bit(page)
            pmm_free_pages = pmm_free_pages + 1
        page = page + 1

    if end_page > pmm_total_pages
        pmm_total_pages = end_page
    if start_page < pmm_next_free
        pmm_next_free = start_page
    if end_page > pmm_high_free
        pmm_high_free = end_page
    spin_unlock(@pmm_lock, g)
    return 0

# Mark a range of physical memory as used (reserved)
pub fn pmm_mark_region_used(base: u64, length: u64) -> i32
    if not pmm_initialized
        return -1
    let start_page: u64 = base / PAGE_SIZE
    var end_page: u64 = (base + length + PAGE_SIZE - 1) / PAGE_SIZE
    if end_page > pmm_bitmap_pages
        end_page = pmm_bitmap_pages

    # A frame of the range in this CPU's cache is used now too. Only the BSP
    # marks regions, at boot, so no other cache holds one.
    let irq: SpinGuard = spin_irq_off(@pmm_lock)
    pmm_cache_drop_range(cpu_index(), start_page * PAGE_SIZE, end_page * PAGE_SIZE)
    spin_irq_restore(irq)

    let g: SpinGuard = spin_lock(@pmm_lock)
    var page: u64 = start_page
    while page < end_page
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            if pmm_free_pages > 0
                pmm_free_pages = pmm_free_pages - 1
        page = page + 1
    spin_unlock(@pmm_lock, g)

    return 0

# ============================================================================
# Page Allocation
# ============================================================================

# Let the next n allocations succeed, then fail every one until
# pmm_fail_allocs_off (OOM injection, AGAST #3552).
pub fn pmm_fail_allocs_after(n: u64)
    pmm_fail_budget = n
    pmm_fail_armed = true

pub fn pmm_fail_allocs_off()
    pmm_fail_armed = false

# True when an armed injection says this allocation must fail; otherwise
# spends one unit of the budget.
fn pmm_injected_failure() -> bool
    if not pmm_fail_armed
        return false
    if pmm_fail_budget == 0
        return true
    pmm_fail_budget = pmm_fail_budget - 1
    return false

# ----------------------------------------------------------------------------
# The global pool: callers hold pmm_lock
# ----------------------------------------------------------------------------

# Put `page` (bit clear, in no cache) back in the pool.
fn pmm_pool_put(page: u64)
    pmm_set_bit(page)
    pmm_free_pages = pmm_free_pages + 1
    if page < pmm_next_free
        pmm_next_free = page
    if page >= pmm_high_free
        pmm_high_free = page + 1

# The highest free page below the high hint, taken; 0 if none.
fn pmm_pool_take_high() -> u64
    if pmm_free_pages == 0
        return 0
    var page: u64 = pmm_high_free
    if page > pmm_total_pages
        page = pmm_total_pages
    while page > 1
        if (page % 8) == 0 and *pmm_byte(page - 8) == 0
            page = page - 8
            continue
        page = page - 1
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            pmm_free_pages = pmm_free_pages - 1
            pmm_high_free = page
            return page
    pmm_high_free = 0
    return 0

# The first page of a run of `n` free pages at or above the hint, taken; 0
# if there is none.
fn pmm_pool_take_run(n: u64) -> u64
    if pmm_free_pages < n
        return 0
    var start: u64 = 0
    var run: u64 = 0
    var page: u64 = pmm_next_free
    while page < pmm_total_pages
        if pmm_test_bit(page)
            if run == 0
                start = page
            run = run + 1
            if run == n
                var p: u64 = start
                while p < start + n
                    pmm_clear_bit(p)
                    p = p + 1
                pmm_free_pages = pmm_free_pages - n
                if start == pmm_next_free
                    pmm_next_free = start + n
                return start
        else
            run = 0
        page = page + 1
    return 0

# ----------------------------------------------------------------------------
# The frame caches: callers run with IF saved and cleared (spin_irq_off)
# ----------------------------------------------------------------------------

fn pmm_slot(cpu: i32, i: u64) -> i32
    return cpu * (PMM_CACHE_MAX as i32) + i as i32

# Fill CPU `cpu`'s empty cache with up to PMM_CACHE_BATCH frames, in one
# locked pass up from the hint (page 0 is never free, #2749; whole used
# bytes are skipped 8 pages at a time). The lowest ends on top, so frames come out
# in address order as they did before the caches.
fn pmm_cache_refill(cpu: i32)
    let g: SpinGuard = spin_lock(@pmm_lock)
    var got: u64 = 0
    var page: u64 = pmm_next_free
    while got < PMM_CACHE_BATCH and got < pmm_free_pages and page < pmm_total_pages
        if (page % 8) == 0 and *pmm_byte(page) == 0
            page = page + 8
            continue
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            pmm_cache[pmm_slot(cpu, PMM_CACHE_BATCH - 1 - got)] = page * PAGE_SIZE
            got = got + 1
        page = page + 1
    pmm_free_pages = pmm_free_pages - got
    if page > pmm_total_pages
        page = pmm_total_pages
    pmm_next_free = page
    spin_unlock(@pmm_lock, g)
    # Slide the batch (filled from the top slot down) to the bottom.
    let skip: u64 = PMM_CACHE_BATCH - got
    var i: u64 = 0
    while i < got
        pmm_cache[pmm_slot(cpu, i)] = pmm_cache[pmm_slot(cpu, skip + i)]
        i = i + 1
    pmm_cache_n[cpu] = got

# Give CPU `cpu`'s `k` oldest (bottom) frames back to the pool in one locked
# pass.
fn pmm_cache_return(cpu: i32, k: u64)
    let n: u64 = pmm_cache_n[cpu]
    let g: SpinGuard = spin_lock(@pmm_lock)
    var i: u64 = 0
    while i < k
        pmm_pool_put(pmm_cache[pmm_slot(cpu, i)] / PAGE_SIZE)
        i = i + 1
    spin_unlock(@pmm_lock, g)
    while i < n
        pmm_cache[pmm_slot(cpu, i - k)] = pmm_cache[pmm_slot(cpu, i)]
        i = i + 1
    pmm_cache_n[cpu] = n - k

# Drop the frames in [lo, hi) from CPU `cpu`'s cache (they are in use now).
fn pmm_cache_drop_range(cpu: i32, lo: u64, hi: u64)
    let n: u64 = pmm_cache_n[cpu]
    var kept: u64 = 0
    var i: u64 = 0
    while i < n
        let f: u64 = pmm_cache[pmm_slot(cpu, i)]
        if f < lo or f >= hi
            pmm_cache[pmm_slot(cpu, kept)] = f
            kept = kept + 1
        i = i + 1
    pmm_cache_n[cpu] = kept

# Some cache holds a frame in [lo, hi). Reads other CPUs' caches unlocked:
# racy, as pmm_get_free_pages is.
fn pmm_cache_holds(lo: u64, hi: u64) -> bool
    var c: i32 = 0
    while c < PMM_MAX_CPUS
        let n: u64 = pmm_cache_n[c]
        var i: u64 = 0
        while i < n
            let f: u64 = pmm_cache[pmm_slot(c, i)]
            if f >= lo and f < hi
                return true
            i = i + 1
        c = c + 1
    return false

# Give this CPU's whole cache back to the pool (a contig or high allocation
# found nothing that fits without it).
fn pmm_cache_flush_this_cpu()
    let irq: SpinGuard = spin_irq_off(@pmm_lock)
    let cpu: i32 = cpu_index()
    pmm_cache_return(cpu, pmm_cache_n[cpu])
    spin_irq_restore(irq)

# ----------------------------------------------------------------------------
# The allocation API
# ----------------------------------------------------------------------------

# Allocate a single physical page from this CPU's cache, refilling it from
# the pool when it is empty. Returns physical address or 0 on failure
pub fn pmm_alloc_page() -> u64
    if not pmm_initialized
        return 0

    if pmm_injected_failure()
        return 0

    let irq: SpinGuard = spin_irq_off(@pmm_lock)
    let cpu: i32 = cpu_index()
    if pmm_cache_n[cpu] == 0
        pmm_cache_refill(cpu)
    var addr: u64 = 0
    let n: u64 = pmm_cache_n[cpu]
    if n > 0
        addr = pmm_cache[pmm_slot(cpu, n - 1)]
        pmm_cache_n[cpu] = n - 1
    spin_irq_restore(irq)
    return addr

# Allocate a single physical page, searching down from the top of RAM.
# For pages the kernel only reaches through the physmap (page tables,
# AGAST #3530), so low, identity-mapped memory stays for whatever needs it.
# Bypasses the caches. Returns physical address or 0 on failure
pub fn pmm_alloc_page_high() -> u64
    if not pmm_initialized
        return 0

    if pmm_injected_failure()
        return 0

    var page: u64 = pmm_locked_take_high()
    if page == 0
        pmm_cache_flush_this_cpu()
        page = pmm_locked_take_high()
    return page * PAGE_SIZE

fn pmm_locked_take_high() -> u64
    let g: SpinGuard = spin_lock(@pmm_lock)
    let page: u64 = pmm_pool_take_high()
    spin_unlock(@pmm_lock, g)
    return page

# Allocate `n` physically contiguous pages, searching up from the hint:
# for tables a device reads by physical address and length, such as the
# AMD-Vi device table (AGAST #4329). Bypasses the caches. Returns the first
# page's physical address, or 0 if no run of `n` free pages exists. Free
# page by page.
pub fn pmm_alloc_contig(n: u64) -> u64
    if not pmm_initialized or n == 0
        return 0
    if pmm_injected_failure()
        return 0
    var start: u64 = pmm_locked_take_run(n)
    if start == 0
        pmm_cache_flush_this_cpu()
        start = pmm_locked_take_run(n)
    return start * PAGE_SIZE

fn pmm_locked_take_run(n: u64) -> u64
    let g: SpinGuard = spin_lock(@pmm_lock)
    let start: u64 = pmm_pool_take_run(n)
    spin_unlock(@pmm_lock, g)
    return start

# Free a physical page onto this CPU's cache; a cache past 64 frames gives
# its oldest 32 back to the pool.
pub fn pmm_free_page(addr: u64) -> i32
    if not pmm_initialized
        return -1
    # Address 0 is the allocation-failure sentinel, never a page to free.
    if addr == 0
        return -1

    let page: u64 = addr / PAGE_SIZE
    # Past the top of the RAM the PMM manages (MMIO such as a framebuffer):
    # never the PMM's to free (#2755). Its bit is clear like an allocated
    # page's, so without this it would enter the free pool.
    if page >= pmm_total_pages
        return -1

    let frame: u64 = page * PAGE_SIZE
    let irq: SpinGuard = spin_irq_off(@pmm_lock)
    # Already free: in the pool, or in a cache.
    if pmm_test_bit(page) or pmm_cache_holds(frame, frame + PAGE_SIZE)
        spin_irq_restore(irq)
        return -1
    let cpu: i32 = cpu_index()
    if pmm_cache_n[cpu] == PMM_CACHE_MAX
        pmm_cache_return(cpu, PMM_CACHE_BATCH)
    let n: u64 = pmm_cache_n[cpu]
    pmm_cache[pmm_slot(cpu, n)] = frame
    pmm_cache_n[cpu] = n + 1
    spin_irq_restore(irq)
    return 0

# ============================================================================
# Statistics
# ============================================================================

# Free frames: the pool's and every cache's. A racy sum, for the boot log
# and the tests.
pub fn pmm_get_free_pages() -> u64
    var n: u64 = pmm_free_pages
    var c: i32 = 0
    while c < PMM_MAX_CPUS
        n = n + pmm_cache_n[c]
        c = c + 1
    return n

# Free frames in the global pool alone (the bitmap), without the caches.
pub fn pmm_pool_free_pages() -> u64
    return pmm_free_pages

# How many frames CPU `cpu`'s cache holds.
pub fn pmm_cache_depth(cpu: i32) -> u64
    return pmm_cache_n[cpu]

pub fn pmm_get_total_pages() -> u64
    return pmm_total_pages

# The end of the physical range the PMM tracks: every page it can hand out
# is below it (the identity DMA domain maps up to here, AGAST #4723).
pub fn pmm_top_phys() -> u64
    return pmm_bitmap_pages * PAGE_SIZE

# True if any page in [base, base + length) is free: RAM the memory map
# reported usable (the physmap maps only such chunks, AGAST #4209).
pub fn pmm_range_has_free(base: u64, length: u64) -> bool
    if not pmm_initialized
        return false
    var page: u64 = base / PAGE_SIZE
    var end: u64 = (base + length + PAGE_SIZE - 1) / PAGE_SIZE
    if pmm_cache_holds(page * PAGE_SIZE, end * PAGE_SIZE)
        return true
    if end > pmm_total_pages
        end = pmm_total_pages
    while page < end
        if (page % 8) == 0 and page + 8 <= end and *pmm_byte(page) == 0
            page = page + 8
            continue
        if pmm_test_bit(page)
            return true
        page = page + 1
    return false

# ============================================================================
# Boot Protocol Initialization
# ============================================================================

# Both boot paths walk their memory map three times: for the highest usable
# address (the bitmap's size), for a bitmap site, and to mark RAM free.
const PMM_PASS_TOP: u32 = 0
const PMM_PASS_SITE: u32 = 1
const PMM_PASS_FREE: u32 = 2

var pmm_scan_top: u64 = 0

fn pmm_avoid_reset(kernel_phys_end: u64)
    pmm_avoid_count = 0
    pmm_site = 0
    pmm_scan_top = 0
    # The low 1 MiB and the kernel image at 1 MiB (pmm_reserve_kernel's
    # window, never less than 2 MiB).
    var end: u64 = kernel_phys_end
    if end < 0x200000
        end = 0x200000
    pmm_avoid(0, end)

# Keep the bitmap off [base, base + length).
fn pmm_avoid(base: u64, length: u64)
    if length == 0 or pmm_avoid_count >= PMM_AVOID_MAX
        return
    pmm_avoid_base[pmm_avoid_count as i32] = base & ~(PAGE_SIZE - 1)
    pmm_avoid_end[pmm_avoid_count as i32] = pmm_page_up(base + length)
    pmm_avoid_count = pmm_avoid_count + 1

# Take [cand, cand + size) of usable [base, base + length) for the bitmap if
# nothing is there yet, it ends below PMM_BITMAP_LIMIT and it misses every
# avoided range.
fn pmm_try_site(base: u64, length: u64, size: u64)
    if pmm_site != 0
        return
    var end: u64 = (base + length) & ~(PAGE_SIZE - 1)
    if end > PMM_BITMAP_LIMIT
        end = PMM_BITMAP_LIMIT
    var cand: u64 = pmm_page_up(base)
    var moved: bool = true
    while moved
        moved = false
        var i: u64 = 0
        while i < pmm_avoid_count
            let a_base: u64 = pmm_avoid_base[i as i32]
            let a_end: u64 = pmm_avoid_end[i as i32]
            if cand < a_end and cand + size > a_base
                cand = a_end
                moved = true
            i = i + 1
        if cand >= end
            return
    if cand + size <= end
        pmm_site = cand

fn pmm_visit_usable(base: u64, length: u64, pass: u32, size: u64)
    if pass == PMM_PASS_TOP
        if base + length > pmm_scan_top
            pmm_scan_top = base + length
    else if pass == PMM_PASS_SITE
        pmm_try_site(base, length, size)
    else
        pmm_mark_region_free(base, length)

# The type-6 tag's AVAILABLE entries.
fn pmm_mb2_mmap_pass(mb_info: *Mb2BootInfo, pass: u32, size: u64)
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    var tag_ptr: u64 = (mb_info as u64) + 8

    while tag_ptr < info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag

        if (*tag).tag_type == MB2_TAG_END
            break

        if (*tag).tag_type == MB2_TAG_MMAP
            let mmap_tag: *Mb2MmapTag = tag_ptr as *Mb2MmapTag
            let entry_size: u32 = (*mmap_tag).entry_size
            var entry_ptr: u64 = tag_ptr + 16
            let entries_end: u64 = tag_ptr + (*mmap_tag).size as u64

            while entry_ptr < entries_end
                let entry: *Mb2MmapEntry = entry_ptr as *Mb2MmapEntry

                if (*entry).entry_type == MB2_MEMORY_AVAILABLE
                    pmm_visit_usable((*entry).base_addr, (*entry).length, pass, size)

                entry_ptr = entry_ptr + entry_size as u64

        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7

# The type-17 tag's usable descriptors (efi_mem_usable).
fn pmm_efi_mmap_pass(efi: *Mb2EfiMmapTag, pass: u32, size: u64)
    let stride: u64 = (*efi).descr_size as u64
    let descs_end: u64 = (efi as u64) + (*efi).size as u64
    var d_ptr: u64 = (efi as u64) + 16
    while d_ptr + EFI_MEM_DESC_MIN <= descs_end
        let d: *EfiMemDesc = d_ptr as *EfiMemDesc
        if efi_mem_usable((*d).mem_type)
            pmm_visit_usable((*d).phys_start, (*d).num_pages * PAGE_SIZE, pass, size)
        d_ptr = d_ptr + stride

# One pass over the multiboot2 RAM: the EFI memory map when GRUB passed a
# readable one, else the type-6 tag (mb2_usable_top says why).
fn pmm_mb2_pass(mb_info: *Mb2BootInfo, pass: u32, size: u64)
    match mb2_efi_mmap(mb_info)
        Some(efi) => pmm_efi_mmap_pass(efi, pass, size)
        None => pmm_mb2_mmap_pass(mb_info, pass, size)

# The end of the highest usable RAM the PMM tracks for this info block, and
# pmm_scan_top set to it. GRUB 2.12 sizes the type-6 tag from one walk of the
# firmware's map and fills it from a second, both before ExitBootServices: a
# map that changed in between leaves the tag short its highest entries, or
# holding stale bytes. A grub-reboot boot on a loaded TCG runner found no
# bitmap site in its type-6 tag and panicked, most likely that way (AGAST
# #4856; not reproduced in 850 local boots). The type-17 tag is the map
# ExitBootServices accepted, so it wins; a type-6 tag that disagrees with it
# is logged.
pub fn mb2_usable_top(mb_info: *Mb2BootInfo) -> u64
    pmm_scan_top = 0
    pmm_mb2_mmap_pass(mb_info, PMM_PASS_TOP, 0)
    let mb2_top: u64 = pmm_scan_top
    match mb2_efi_mmap(mb_info)
        Some(efi) =>
            pmm_scan_top = 0
            pmm_efi_mmap_pass(efi, PMM_PASS_TOP, 0)
        None => return mb2_top
    if mb2_top != 0 and mb2_top != pmm_scan_top
        klog("[pmm] multiboot2 memory map ends at ")
        klog_hex_prefix(mb2_top)
        klog(", the EFI memory map at ")
        klog_hex_prefix(pmm_scan_top)
        klog(": using the EFI map\n")
    return pmm_scan_top

fn pmm_bootinfo_pass(info: *HarlandBootInfo, pass: u32, size: u64)
    let num_entries: u32 = (*info).memory_map_entries
    let mmap: *HarlandMemEntry = (*info).memory_map
    var i: u32 = 0

    while i < num_entries
        let entry: *HarlandMemEntry = (mmap as u64 + (i as u64 * sizeof(HarlandMemEntry) as u64)) as *HarlandMemEntry

        if (*entry).mem_type == HARLAND_MEM_USABLE
            pmm_visit_usable((*entry).base, (*entry).length, pass, size)

        i = i + 1

# Size and place the bitmap for RAM ending at pmm_scan_top (the TOP pass
# ran), or report why not. Returns the bitmap's size in bytes, 0 on failure.
fn pmm_bitmap_size_from_top() -> u64
    if pmm_scan_top == 0
        klog("[pmm] no usable memory in the memory map\n")
        return 0
    return pmm_bitmap_bytes_for(pmm_scan_top)

fn pmm_start_bitmap(size: u64) -> i32
    if pmm_site == 0
        klog("[pmm] no room below 1 GiB for a ")
        klog_dec(size / 1024)
        klog(" KiB bitmap\n")
        return -1
    var pages: u64 = pmm_scan_top / PAGE_SIZE
    pmm_init(pmm_site as *u8, pages)
    return 0

# Log the multiboot2 info block a failed pmm_init_from_multiboot read: each
# tag's type and size, and the entries of its type-6 and type-17 memory maps.
# A map with no bitmap site leaves nothing else to go on (AGAST #4856).
fn pmm_mb2_log_map(mb_info: *Mb2BootInfo)
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    klog("[pmm] multiboot2 info at ")
    klog_hex_prefix(mb_info as u64)
    klog(", ")
    klog_dec((*mb_info).total_size as u64)
    klog(" bytes\n")
    var tag_ptr: u64 = (mb_info as u64) + 8
    while tag_ptr + 8 <= info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag
        klog("[pmm]   tag ")
        klog_dec((*tag).tag_type as u64)
        klog(" size ")
        klog_dec((*tag).size as u64)
        klog("\n")
        if (*tag).tag_type == MB2_TAG_END or (*tag).size < 8
            return
        if (*tag).tag_type == MB2_TAG_MMAP and (*tag).size >= 16
            pmm_log_mb2_entries(tag_ptr as *Mb2MmapTag)
        if (*tag).tag_type == MB2_TAG_EFI_MMAP and (*tag).size >= 16
            pmm_log_efi_descs(tag_ptr as *Mb2EfiMmapTag)
        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7

fn pmm_log_mb2_entries(mmap_tag: *Mb2MmapTag)
    let entry_size: u64 = (*mmap_tag).entry_size as u64
    let entries_end: u64 = (mmap_tag as u64) + (*mmap_tag).size as u64
    var entry_ptr: u64 = (mmap_tag as u64) + 16
    while entry_size >= 24 and entry_ptr + 24 <= entries_end
        let entry: *Mb2MmapEntry = entry_ptr as *Mb2MmapEntry
        klog("[pmm]     ")
        klog_hex_prefix((*entry).base_addr)
        klog(" +")
        klog_hex_prefix((*entry).length)
        klog(" type ")
        klog_dec((*entry).entry_type as u64)
        klog("\n")
        entry_ptr = entry_ptr + entry_size

fn pmm_log_efi_descs(efi: *Mb2EfiMmapTag)
    let stride: u64 = (*efi).descr_size as u64
    let descs_end: u64 = (efi as u64) + (*efi).size as u64
    var d_ptr: u64 = (efi as u64) + 16
    while stride >= EFI_MEM_DESC_MIN and d_ptr + EFI_MEM_DESC_MIN <= descs_end
        let d: *EfiMemDesc = d_ptr as *EfiMemDesc
        klog("[pmm]     EFI ")
        klog_hex_prefix((*d).phys_start)
        klog(" +")
        klog_hex_prefix((*d).num_pages)
        klog(" pages type ")
        klog_dec((*d).mem_type as u64)
        klog("\n")
        d_ptr = d_ptr + stride

# Parse the Multiboot2 memory map and initialize the PMM. kernel_phys_end is
# main's linker-derived image end (pmm_reserve_kernel's): the bitmap stays
# off the image and the info block. Returns 0, or -1 (PMM left unusable,
# the info block logged).
pub fn pmm_init_from_multiboot(mb_info: *Mb2BootInfo, kernel_phys_end: u64) -> i32
    if pmm_init_mb2(mb_info, kernel_phys_end)
        return 0
    pmm_mb2_log_map(mb_info)
    return -1

fn pmm_init_mb2(mb_info: *Mb2BootInfo, kernel_phys_end: u64) -> bool
    pmm_avoid_reset(kernel_phys_end)
    pmm_avoid(mb_info as u64, (*mb_info).total_size as u64)
    # The initramfs module (AGAST #4258) sits in "available" RAM too.
    let mb_mod: *Mb2ModuleTag = mb2_find_module(mb_info)
    if mb_mod != 0 as *Mb2ModuleTag
        pmm_avoid((*mb_mod).mod_start as u64, ((*mb_mod).mod_end - (*mb_mod).mod_start) as u64)
    mb2_usable_top(mb_info)
    let size: u64 = pmm_bitmap_size_from_top()
    if size == 0
        return false
    pmm_mb2_pass(mb_info, PMM_PASS_SITE, size)
    if pmm_start_bitmap(size) != 0
        return false
    pmm_mb2_pass(mb_info, PMM_PASS_FREE, 0)
    pmm_mark_region_used(pmm_site, size)
    return true


# Initialize the PMM from Harland boot info (UEFI boot path). The bitmap
# stays off the image, the boot info, its memory map and the PML4.
pub fn pmm_init_from_bootinfo(info: *HarlandBootInfo, kernel_phys_end: u64) -> i32
    pmm_avoid_reset(kernel_phys_end)
    pmm_avoid(info as u64, PAGE_SIZE)
    pmm_avoid((*info).memory_map as u64, (*info).memory_map_entries as u64 * 24)
    pmm_avoid((*info).kernel_phys, (*info).kernel_size)
    pmm_avoid((*info).pml4_phys, PAGE_SIZE)
    pmm_bootinfo_pass(info, PMM_PASS_TOP, 0)
    let size: u64 = pmm_bitmap_size_from_top()
    if size == 0
        return -1
    pmm_bootinfo_pass(info, PMM_PASS_SITE, size)
    if pmm_start_bitmap(size) != 0
        return -1
    pmm_bootinfo_pass(info, PMM_PASS_FREE, 0)
    pmm_mark_region_used(pmm_site, size)
    return 0

# Reserve kernel memory regions (call after pmm_init_from_multiboot or
# pmm_init_from_bootinfo): the low 1 MiB, and the image from its 1 MiB load
# address up to kernel_phys_end (main's linker-derived end, .bss included).
# A fixed 1 MiB image window let pmm hand out the image's own last page once
# .bss passed phys 0x200000 (#2755). Never less than that legacy window.
pub fn pmm_reserve_kernel(kernel_phys_end: u64)
    pmm_mark_region_used(0, 0x100000)
    var end: u64 = kernel_phys_end
    if end < 0x200000
        end = 0x200000
    pmm_mark_region_used(0x100000, end - 0x100000)

# Log the page counts and the bitmap's size and place, for the boot log.
# tools/test_tier1_boot.sh reads the "Free pages:" line (AGAST #4183).
const BYTES_PER_KIB: u64 = 1024
const BYTES_PER_MIB: u64 = 1048576

pub fn pmm_log_stats()
    klog("      Total pages: ")
    klog_dec(pmm_get_total_pages())
    klog(" (")
    klog_dec(pmm_get_total_pages() * PAGE_SIZE / BYTES_PER_MIB)
    klog(" MB)\n")
    klog("      Bitmap:      ")
    klog_dec(pmm_bitmap_size() / BYTES_PER_KIB)
    klog(" KB at ")
    klog_hex(pmm_bitmap_phys())
    klog("\n")
    klog("      Free pages:  ")
    klog_dec(pmm_get_free_pages())
    klog(" (")
    klog_dec(pmm_get_free_pages() * PAGE_SIZE / BYTES_PER_MIB)
    klog(" MB)\n")
