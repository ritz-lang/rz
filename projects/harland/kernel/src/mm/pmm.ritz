# Harland Physical Memory Manager (Bitmap Allocator)
#
# Manages physical memory using a bitmap where each bit represents a 4KB page.
# 1 = free, 0 = used
#
# This is the foundation of memory management - VMM and heap depend on it.

import serial { prints, serial_print_dec }

# ============================================================================
# Page Constants (shared with VMM and heap)
# ============================================================================

pub const PAGE_SIZE: u64 = 4096
pub const PAGE_SHIFT: u64 = 12

# The bitmap is sized at boot from the memory map's highest usable address
# (AGAST #4183; until then a fixed 128 KiB array capped RAM at 4 GiB). Its
# ceiling is what the physmap can reach: PML4[256], 512 GiB, a 16 MiB bitmap.
pub const PMM_MAX_PAGES: u64 = 134217728

# The bitmap is reached through the identity map, which every address space
# has below 1 GiB (the boot map on Multiboot2, process PML4s): it must end
# there.
const PMM_BITMAP_LIMIT: u64 = 0x40000000

# ============================================================================
# Multiboot2 Information Structures (for memory map parsing)
# ============================================================================

# Multiboot2 tag types
pub const MB2_TAG_END: u32 = 0
pub const MB2_TAG_CMDLINE: u32 = 1
pub const MB2_TAG_BOOTLOADER_NAME: u32 = 2
pub const MB2_TAG_MODULE: u32 = 3
pub const MB2_TAG_BASIC_MEMINFO: u32 = 4
pub const MB2_TAG_BOOTDEV: u32 = 5
pub const MB2_TAG_MMAP: u32 = 6
pub const MB2_TAG_VBE: u32 = 7
pub const MB2_TAG_FRAMEBUFFER: u32 = 8
pub const MB2_TAG_ELF_SECTIONS: u32 = 9
pub const MB2_TAG_APM: u32 = 10
pub const MB2_TAG_EFI32: u32 = 11
pub const MB2_TAG_EFI64: u32 = 12
pub const MB2_TAG_SMBIOS: u32 = 13
pub const MB2_TAG_ACPI_OLD: u32 = 14
pub const MB2_TAG_ACPI_NEW: u32 = 15
pub const MB2_TAG_NETWORK: u32 = 16
pub const MB2_TAG_EFI_MMAP: u32 = 17
pub const MB2_TAG_EFI_BS: u32 = 18
pub const MB2_TAG_EFI32_IH: u32 = 19
pub const MB2_TAG_EFI64_IH: u32 = 20
pub const MB2_TAG_LOAD_BASE_ADDR: u32 = 21

# Memory map entry types
pub const MB2_MEMORY_AVAILABLE: u32 = 1
pub const MB2_MEMORY_RESERVED: u32 = 2
pub const MB2_MEMORY_ACPI_RECLAIMABLE: u32 = 3
pub const MB2_MEMORY_NVS: u32 = 4
pub const MB2_MEMORY_BADRAM: u32 = 5

# Multiboot2 fixed boot info header
pub struct Mb2BootInfo
    total_size: u32
    reserved: u32

# Generic tag header (all tags start with this)
pub struct Mb2Tag
    tag_type: u32
    size: u32

# Basic memory info tag
pub struct Mb2BasicMemInfo
    tag_type: u32
    size: u32
    mem_lower: u32
    mem_upper: u32

# Memory map tag header
pub struct Mb2MmapTag
    tag_type: u32
    size: u32
    entry_size: u32
    entry_version: u32
    # Followed by variable number of Mb2MmapEntry

# Memory map entry (e820-style)
pub struct Mb2MmapEntry
    base_addr: u64
    length: u64
    entry_type: u32
    reserved: u32

# Boot module tag (type 3, multiboot2 spec 3.6.6): a file GRUB's `module2`
# loaded into RAM at [mod_start, mod_end). Followed by its command line.
pub struct Mb2ModuleTag
    tag_type: u32
    size: u32
    mod_start: u32
    mod_end: u32

# The first boot module's tag (GRUB's `module2 /boot/initramfs.tar`, AGAST
# #4258), or 0 if GRUB loaded none. GRUB marks the module's pages as
# available RAM in the memory map: the caller must reserve them.
pub fn mb2_find_module(mb_info: *Mb2BootInfo) -> *Mb2ModuleTag
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    var tag_ptr: u64 = (mb_info as u64) + 8
    while tag_ptr + 8 <= info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag
        if (*tag).tag_type == MB2_TAG_END or (*tag).size < 8
            break
        if (*tag).tag_type == MB2_TAG_MODULE and (*tag).size >= 16
            let m: *Mb2ModuleTag = tag_ptr as *Mb2ModuleTag
            if (*m).mod_end > (*m).mod_start
                return m
        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7
    return 0 as *Mb2ModuleTag

# ============================================================================
# Harland Boot Protocol (UEFI bootloader native format)
# ============================================================================

pub const HARLAND_BOOT_MAGIC: u32 = 0x4841524C   # "HARL"
pub const HARLAND_BOOT_VERSION: u32 = 1

# Memory types for Harland boot protocol
pub const HARLAND_MEM_USABLE: u32 = 1
pub const HARLAND_MEM_RESERVED: u32 = 2
pub const HARLAND_MEM_ACPI_RECLAIMABLE: u32 = 3

# Harland memory map entry
[[packed]]
pub struct HarlandMemEntry
    base: u64
    length: u64
    mem_type: u32
    reserved: u32

# Harland boot info structure (passed by UEFI bootloader)
[[packed]]
pub struct HarlandBootInfo
    magic: u32                       # 0x4841524C ("HARL")
    version: u32                     # Boot protocol version
    memory_map: *HarlandMemEntry     # Simplified memory map
    memory_map_entries: u32          # Number of entries
    _pad1: u32
    framebuffer_addr: u64            # Framebuffer address (0 if none)
    framebuffer_width: u32
    framebuffer_height: u32
    framebuffer_pitch: u32           # Bytes per scanline
    framebuffer_bpp: u8              # Bits per pixel (32)
    framebuffer_format: u8           # 0=RGBX, 1=BGRX, 2=other
    _pad2: [2]u8
    rsdp_addr: u64                   # ACPI RSDP address
    kernel_phys: u64                 # Kernel physical address
    kernel_size: u64                 # Kernel size in bytes
    pml4_phys: u64                   # Page table physical address
    # Version 2 (AGAST #4253): the initramfs TAR BOOTX64.EFI read from the
    # ESP, or 0/0. Read these only when version >= HARLAND_BOOT_VERSION_INITRAMFS.
    initramfs_phys: u64              # Physical address of the TAR, or 0
    initramfs_size: u64              # Its size in bytes, or 0
    # Version 3 (AGAST #4335): boot options, 0 on version-2 loaders.
    # HARLAND_BOOT_FLAG_NET_SELFTEST asks for the kernel's pre-init network
    # self-tests; the UEFI loader sets it from the boot volume's
    # \harland\net-selftest marker. Without it the kernel leaves the NIC
    # alone until init is up, so a misbehaving driver cannot keep the shell
    # from starting.
    flags: u32
    _pad3: u32

# First boot protocol version whose BootInfo carries initramfs_phys/size
pub const HARLAND_BOOT_VERSION_INITRAMFS: u32 = 2

# First boot protocol version whose BootInfo carries flags/_pad3
pub const HARLAND_BOOT_VERSION_FLAGS: u32 = 3

# Boot option bits (BootInfo.flags). Version 3 and later only.
pub const HARLAND_BOOT_FLAG_NET_SELFTEST: u32 = 1

# Framebuffer pixel format constants
pub const FB_FORMAT_RGBX: u8 = 0     # Red-Green-Blue-Reserved (UEFI default)
pub const FB_FORMAT_BGRX: u8 = 1     # Blue-Green-Red-Reserved (common)
pub const FB_FORMAT_OTHER: u8 = 2    # Custom bitmask (check pixel info)

# Boot protocol type detected at runtime
pub const BOOT_PROTOCOL_UNKNOWN: u32 = 0
pub const BOOT_PROTOCOL_MULTIBOOT2: u32 = 1
pub const BOOT_PROTOCOL_HARLAND: u32 = 2

# ============================================================================
# PMM State
# ============================================================================

# Bitmap: 1 bit per page, 1 = free, 0 = used. Lives at pmm_bitmap_addr
# (identity-mapped) and tracks pmm_bitmap_pages pages.
var pmm_bitmap_addr: u64 = 0
var pmm_bitmap_pages: u64 = 0
var pmm_total_pages: u64 = 0
var pmm_free_pages: u64 = 0
var pmm_initialized: u8 = 0

# Allocation hints (AGAST #4183), instead of scanning from page 0 / the top
# on every allocation:
#   no page in [1, pmm_next_free) is free  (pmm_alloc_page starts there)
#   no page at or above pmm_high_free is free  (pmm_alloc_page_high, down)
var pmm_next_free: u64 = 1
var pmm_high_free: u64 = 0

# OOM injection for boot self-tests (AGAST #3552). While armed, each
# allocation spends one unit of budget, and once it is spent every
# allocation fails as if RAM had run out. Never armed outside a self-test.
var pmm_fail_armed: u8 = 0
var pmm_fail_budget: u64 = 0

# Ranges the boot paths must not put the bitmap on (kernel image, boot
# info, memory map, ...), and the bitmap site the scan picked.
const PMM_AVOID_MAX: u64 = 8
var pmm_avoid_base: [8]u64
var pmm_avoid_end: [8]u64
var pmm_avoid_count: u64 = 0
var pmm_site: u64 = 0

# ============================================================================
# Internal Bitmap Operations
# ============================================================================

fn pmm_byte(page: u64) -> *u8
    return (pmm_bitmap_addr + page / 8) as *u8

# Set a bit (mark page as free)
fn pmm_set_bit(page: u64) -> i32
    let b: *u8 = pmm_byte(page)
    *b = *b | (1 << (page % 8) as u8)
    return 0

# Clear a bit (mark page as used)
fn pmm_clear_bit(page: u64) -> i32
    let b: *u8 = pmm_byte(page)
    *b = *b & ~(1 << (page % 8) as u8)
    return 0

# Test if a bit is set (page is free)
fn pmm_test_bit(page: u64) -> bool
    return (*pmm_byte(page) & (1 << (page % 8) as u8)) != 0

fn pmm_page_up(a: u64) -> u64
    return (a + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)

# ============================================================================
# PMM Initialization
# ============================================================================

# Bytes of bitmap (whole pages) for RAM ending at top.
fn pmm_bitmap_bytes_for(top: u64) -> u64
    var pages: u64 = top / PAGE_SIZE
    if pages > PMM_MAX_PAGES
        pages = PMM_MAX_PAGES
    return pmm_page_up((pages + 7) / 8)

# Start tracking max_pages pages with the bitmap at `bitmap`, every page
# used. The boot paths call it with a bitmap they carved out of RAM; tests
# pass their own.
pub fn pmm_init(bitmap: *u8, max_pages: u64) -> i32
    var pages: u64 = max_pages
    if pages > PMM_MAX_PAGES
        pages = PMM_MAX_PAGES
    pmm_bitmap_addr = bitmap as u64
    pmm_bitmap_pages = pages
    let bytes: u64 = (pages + 7) / 8
    var i: u64 = 0
    while i < bytes
        let b: *u8 = (pmm_bitmap_addr + i) as *u8
        *b = 0
        i = i + 1
    pmm_total_pages = 0
    pmm_free_pages = 0
    pmm_next_free = 1
    pmm_high_free = 0
    pmm_initialized = 1
    return 0

# Physical address of the bitmap (0 before a boot path set one up).
pub fn pmm_bitmap_phys() -> u64
    return pmm_bitmap_addr

# Bytes the bitmap spans.
pub fn pmm_bitmap_size() -> u64
    return (pmm_bitmap_pages + 7) / 8

# Mark a range of physical memory as available
pub fn pmm_mark_region_free(base: u64, length: u64) -> i32
    if pmm_initialized == 0
        return -1
    var start_page: u64 = (base + PAGE_SIZE - 1) / PAGE_SIZE
    var end_page: u64 = (base + length) / PAGE_SIZE
    if end_page > pmm_bitmap_pages
        end_page = pmm_bitmap_pages
    # Keep physical page 0 permanently unavailable so address 0
    # remains an unambiguous allocation-failure sentinel (#2749).
    if start_page == 0
        start_page = 1
    if start_page >= end_page
        return 0

    var page: u64 = start_page
    while page < end_page
        if not pmm_test_bit(page)
            pmm_set_bit(page)
            pmm_free_pages = pmm_free_pages + 1
        page = page + 1

    if end_page > pmm_total_pages
        pmm_total_pages = end_page
    if start_page < pmm_next_free
        pmm_next_free = start_page
    if end_page > pmm_high_free
        pmm_high_free = end_page
    return 0

# Mark a range of physical memory as used (reserved)
pub fn pmm_mark_region_used(base: u64, length: u64) -> i32
    if pmm_initialized == 0
        return -1
    let start_page: u64 = base / PAGE_SIZE
    var end_page: u64 = (base + length + PAGE_SIZE - 1) / PAGE_SIZE
    if end_page > pmm_bitmap_pages
        end_page = pmm_bitmap_pages

    var page: u64 = start_page
    while page < end_page
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            if pmm_free_pages > 0
                pmm_free_pages = pmm_free_pages - 1
        page = page + 1

    return 0

# ============================================================================
# Page Allocation
# ============================================================================

# Let the next n allocations succeed, then fail every one until
# pmm_fail_allocs_off (OOM injection, AGAST #3552).
pub fn pmm_fail_allocs_after(n: u64)
    pmm_fail_budget = n
    pmm_fail_armed = 1

pub fn pmm_fail_allocs_off()
    pmm_fail_armed = 0

# True when an armed injection says this allocation must fail; otherwise
# spends one unit of the budget.
fn pmm_injected_failure() -> bool
    if pmm_fail_armed == 0
        return false
    if pmm_fail_budget == 0
        return true
    pmm_fail_budget = pmm_fail_budget - 1
    return false

# Allocate a single physical page
# Returns physical address or 0 on failure
pub fn pmm_alloc_page() -> u64
    if pmm_initialized == 0
        return 0

    if pmm_injected_failure()
        return 0

    if pmm_free_pages == 0
        return 0

    # Search up from the hint; page 0 is never handed out (#2749). Whole
    # used bytes are skipped 8 pages at a time.
    var page: u64 = pmm_next_free
    while page < pmm_total_pages
        if (page % 8) == 0 and *pmm_byte(page) == 0
            page = page + 8
            continue
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            pmm_free_pages = pmm_free_pages - 1
            pmm_next_free = page + 1
            return page * PAGE_SIZE
        page = page + 1

    pmm_next_free = pmm_total_pages
    return 0

# Allocate a single physical page, searching down from the top of RAM.
# For pages the kernel only reaches through the physmap (page tables,
# AGAST #3530), so low, identity-mapped memory stays for whatever needs it.
# Returns physical address or 0 on failure
pub fn pmm_alloc_page_high() -> u64
    if pmm_initialized == 0
        return 0

    if pmm_injected_failure()
        return 0

    if pmm_free_pages == 0
        return 0

    var page: u64 = pmm_high_free
    if page > pmm_total_pages
        page = pmm_total_pages
    while page > 1
        if (page % 8) == 0 and *pmm_byte(page - 8) == 0
            page = page - 8
            continue
        page = page - 1
        if pmm_test_bit(page)
            pmm_clear_bit(page)
            pmm_free_pages = pmm_free_pages - 1
            pmm_high_free = page
            return page * PAGE_SIZE

    pmm_high_free = 0
    return 0

# Allocate `n` physically contiguous pages, searching up from the hint:
# for tables a device reads by physical address and length, such as the
# AMD-Vi device table (AGAST #4329). Returns the first page's physical
# address, or 0 if no run of `n` free pages exists. Free page by page.
pub fn pmm_alloc_contig(n: u64) -> u64
    if pmm_initialized == 0 or n == 0
        return 0
    if pmm_injected_failure()
        return 0
    if pmm_free_pages < n
        return 0
    var start: u64 = 0
    var run: u64 = 0
    var page: u64 = pmm_next_free
    while page < pmm_total_pages
        if pmm_test_bit(page)
            if run == 0
                start = page
            run = run + 1
            if run == n
                var p: u64 = start
                while p < start + n
                    pmm_clear_bit(p)
                    p = p + 1
                pmm_free_pages = pmm_free_pages - n
                if start == pmm_next_free
                    pmm_next_free = start + n
                return start * PAGE_SIZE
        else
            run = 0
        page = page + 1
    return 0

# Free a physical page
pub fn pmm_free_page(addr: u64) -> i32
    if pmm_initialized == 0
        return -1
    # Address 0 is the allocation-failure sentinel, never a page to free.
    if addr == 0
        return -1

    let page: u64 = addr / PAGE_SIZE
    # Past the top of the RAM the PMM manages (MMIO such as a framebuffer):
    # never the PMM's to free (#2755). Its bit is clear like an allocated
    # page's, so without this it would enter the free pool.
    if page >= pmm_total_pages
        return -1

    if pmm_test_bit(page)
        return -1

    pmm_set_bit(page)
    pmm_free_pages = pmm_free_pages + 1
    if page < pmm_next_free
        pmm_next_free = page
    if page >= pmm_high_free
        pmm_high_free = page + 1
    return 0

# ============================================================================
# Statistics
# ============================================================================

# Get free memory statistics
pub fn pmm_get_free_pages() -> u64
    return pmm_free_pages

pub fn pmm_get_total_pages() -> u64
    return pmm_total_pages

# True if any page in [base, base + length) is free: RAM the memory map
# reported usable (the physmap maps only such chunks, AGAST #4209).
pub fn pmm_range_has_free(base: u64, length: u64) -> bool
    if pmm_initialized == 0
        return false
    var page: u64 = base / PAGE_SIZE
    var end: u64 = (base + length + PAGE_SIZE - 1) / PAGE_SIZE
    if end > pmm_total_pages
        end = pmm_total_pages
    while page < end
        if (page % 8) == 0 and page + 8 <= end and *pmm_byte(page) == 0
            page = page + 8
            continue
        if pmm_test_bit(page)
            return true
        page = page + 1
    return false

# ============================================================================
# Boot Protocol Initialization
# ============================================================================

# Both boot paths walk their memory map three times: for the highest usable
# address (the bitmap's size), for a bitmap site, and to mark RAM free.
const PMM_PASS_TOP: u32 = 0
const PMM_PASS_SITE: u32 = 1
const PMM_PASS_FREE: u32 = 2

var pmm_scan_top: u64 = 0

fn pmm_avoid_reset(kernel_phys_end: u64)
    pmm_avoid_count = 0
    pmm_site = 0
    pmm_scan_top = 0
    # The low 1 MiB and the kernel image at 1 MiB (pmm_reserve_kernel's
    # window, never less than 2 MiB).
    var end: u64 = kernel_phys_end
    if end < 0x200000
        end = 0x200000
    pmm_avoid(0, end)

# Keep the bitmap off [base, base + length).
fn pmm_avoid(base: u64, length: u64)
    if length == 0 or pmm_avoid_count >= PMM_AVOID_MAX
        return
    pmm_avoid_base[pmm_avoid_count as i32] = base & ~(PAGE_SIZE - 1)
    pmm_avoid_end[pmm_avoid_count as i32] = pmm_page_up(base + length)
    pmm_avoid_count = pmm_avoid_count + 1

# Take [cand, cand + size) of usable [base, base + length) for the bitmap if
# nothing is there yet, it ends below PMM_BITMAP_LIMIT and it misses every
# avoided range.
fn pmm_try_site(base: u64, length: u64, size: u64)
    if pmm_site != 0
        return
    var end: u64 = (base + length) & ~(PAGE_SIZE - 1)
    if end > PMM_BITMAP_LIMIT
        end = PMM_BITMAP_LIMIT
    var cand: u64 = pmm_page_up(base)
    var moved: bool = true
    while moved
        moved = false
        var i: u64 = 0
        while i < pmm_avoid_count
            let a_base: u64 = pmm_avoid_base[i as i32]
            let a_end: u64 = pmm_avoid_end[i as i32]
            if cand < a_end and cand + size > a_base
                cand = a_end
                moved = true
            i = i + 1
        if cand >= end
            return
    if cand + size <= end
        pmm_site = cand

fn pmm_visit_usable(base: u64, length: u64, pass: u32, size: u64)
    if pass == PMM_PASS_TOP
        if base + length > pmm_scan_top
            pmm_scan_top = base + length
    else if pass == PMM_PASS_SITE
        pmm_try_site(base, length, size)
    else
        pmm_mark_region_free(base, length)

fn pmm_mb2_pass(mb_info: *Mb2BootInfo, pass: u32, size: u64)
    let info_end: u64 = (mb_info as u64) + (*mb_info).total_size as u64
    var tag_ptr: u64 = (mb_info as u64) + 8

    while tag_ptr < info_end
        let tag: *Mb2Tag = tag_ptr as *Mb2Tag

        if (*tag).tag_type == MB2_TAG_END
            break

        if (*tag).tag_type == MB2_TAG_MMAP
            let mmap_tag: *Mb2MmapTag = tag_ptr as *Mb2MmapTag
            let entry_size: u32 = (*mmap_tag).entry_size
            var entry_ptr: u64 = tag_ptr + 16
            let entries_end: u64 = tag_ptr + (*mmap_tag).size as u64

            while entry_ptr < entries_end
                let entry: *Mb2MmapEntry = entry_ptr as *Mb2MmapEntry

                if (*entry).entry_type == MB2_MEMORY_AVAILABLE
                    pmm_visit_usable((*entry).base_addr, (*entry).length, pass, size)

                entry_ptr = entry_ptr + entry_size as u64

        tag_ptr = (tag_ptr + (*tag).size as u64 + 7) & ~7

fn pmm_bootinfo_pass(info: *HarlandBootInfo, pass: u32, size: u64)
    let num_entries: u32 = (*info).memory_map_entries
    let mmap: *HarlandMemEntry = (*info).memory_map
    var i: u32 = 0

    while i < num_entries
        let entry: *HarlandMemEntry = (mmap as u64 + (i as u64 * 24)) as *HarlandMemEntry

        if (*entry).mem_type == HARLAND_MEM_USABLE
            pmm_visit_usable((*entry).base, (*entry).length, pass, size)

        i = i + 1

# Size and place the bitmap for RAM ending at pmm_scan_top (the TOP pass
# ran), or report why not. Returns the bitmap's size in bytes, 0 on failure.
fn pmm_bitmap_size_from_top() -> u64
    if pmm_scan_top == 0
        prints("[pmm] no usable memory in the memory map\n")
        return 0
    return pmm_bitmap_bytes_for(pmm_scan_top)

fn pmm_start_bitmap(size: u64) -> i32
    if pmm_site == 0
        prints("[pmm] no room below 1 GiB for a ")
        serial_print_dec(size / 1024)
        prints(" KiB bitmap\n")
        return -1
    var pages: u64 = pmm_scan_top / PAGE_SIZE
    pmm_init(pmm_site as *u8, pages)
    return 0

# Parse the Multiboot2 memory map and initialize the PMM. kernel_phys_end is
# main's linker-derived image end (pmm_reserve_kernel's): the bitmap stays
# off the image and the info block. Returns 0, or -1 (PMM left unusable).
pub fn pmm_init_from_multiboot(mb_info: *Mb2BootInfo, kernel_phys_end: u64) -> i32
    pmm_avoid_reset(kernel_phys_end)
    pmm_avoid(mb_info as u64, (*mb_info).total_size as u64)
    # The initramfs module (AGAST #4258) sits in "available" RAM too.
    let mb_mod: *Mb2ModuleTag = mb2_find_module(mb_info)
    if mb_mod != 0 as *Mb2ModuleTag
        pmm_avoid((*mb_mod).mod_start as u64, ((*mb_mod).mod_end - (*mb_mod).mod_start) as u64)
    pmm_mb2_pass(mb_info, PMM_PASS_TOP, 0)
    let size: u64 = pmm_bitmap_size_from_top()
    if size == 0
        return -1
    pmm_mb2_pass(mb_info, PMM_PASS_SITE, size)
    if pmm_start_bitmap(size) != 0
        return -1
    pmm_mb2_pass(mb_info, PMM_PASS_FREE, 0)
    pmm_mark_region_used(pmm_site, size)
    return 0

# Initialize the PMM from Harland boot info (UEFI boot path). The bitmap
# stays off the image, the boot info, its memory map and the PML4.
pub fn pmm_init_from_bootinfo(info: *HarlandBootInfo, kernel_phys_end: u64) -> i32
    pmm_avoid_reset(kernel_phys_end)
    pmm_avoid(info as u64, PAGE_SIZE)
    pmm_avoid((*info).memory_map as u64, (*info).memory_map_entries as u64 * 24)
    pmm_avoid((*info).kernel_phys, (*info).kernel_size)
    pmm_avoid((*info).pml4_phys, PAGE_SIZE)
    pmm_bootinfo_pass(info, PMM_PASS_TOP, 0)
    let size: u64 = pmm_bitmap_size_from_top()
    if size == 0
        return -1
    pmm_bootinfo_pass(info, PMM_PASS_SITE, size)
    if pmm_start_bitmap(size) != 0
        return -1
    pmm_bootinfo_pass(info, PMM_PASS_FREE, 0)
    pmm_mark_region_used(pmm_site, size)
    return 0

# Reserve kernel memory regions (call after pmm_init_from_multiboot or
# pmm_init_from_bootinfo): the low 1 MiB, and the image from its 1 MiB load
# address up to kernel_phys_end (main's linker-derived end, .bss included).
# A fixed 1 MiB image window let pmm hand out the image's own last page once
# .bss passed phys 0x200000 (#2755). Never less than that legacy window.
pub fn pmm_reserve_kernel(kernel_phys_end: u64) -> i32
    pmm_mark_region_used(0, 0x100000)
    var end: u64 = kernel_phys_end
    if end < 0x200000
        end = 0x200000
    pmm_mark_region_used(0x100000, end - 0x100000)
    return 0
