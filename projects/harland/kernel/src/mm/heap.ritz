# Harland Kernel Heap Allocator (First-Fit Free List)
#
# Provides kalloc() and kfree() for dynamic memory allocation.
# Uses a first-fit free list with block splitting.
#
# Depends on PMM for physical pages and VMM for mapping them.

import klog { klog, klog_hex, klog_dec }
import serial { StrView }
import mm.pmm { PAGE_SIZE, pmm_alloc_page, pmm_free_page }
import mm.vmm { PTE_WRITABLE, vmm_map_page }

# ============================================================================
# Heap Configuration
# ============================================================================

# The boot.s maps 0-1GB physical to both:
#   - Identity: 0x0 - 0x40000000
#   - Higher-half: 0xFFFFFFFF80000000 - 0xFFFFFFFFC0000000
#
# These use 2MB huge pages, so we can't use 4KB pages within them.
# For the heap, we use addresses PAST the pre-mapped 1GB region:
#   0xFFFFFFFFC0000000 - 0xFFFFFFFFD0000000: Kernel heap (256MB)
#
# This region is not pre-mapped, so vmm_map_page creates new 4KB page tables.

pub const KERNEL_VIRT_BASE: u64 = 0xFFFFFFFF80000000
pub const HEAP_START: u64 = 0xFFFFFFFFC0000000
pub const HEAP_MAX_SIZE: u64 = 0x10000000  # 256MB
const HEAP_BLOCK_MAGIC: u64 = 0x4845415042434B21

# Block header (placed before each allocation)
# next: pointer to next free block (0 if end or allocated)
# size: size of this block including header (minimum 32 bytes)
# magic: validation magic number
# flags: bit 0 = free (1) or allocated (0)
struct HeapBlock
    next: u64
    size: u64
    magic: u64
    flags: u64

# ============================================================================
# Heap State
# ============================================================================

var heap_start: u64 = 0
var heap_end: u64 = 0
var heap_free_list: u64 = 0
var heap_initialized: bool = false

# Minimum block size (header + some data)
# NOTE: Using larger minimum to avoid tight splits that may cause issues
const HEAP_MIN_BLOCK: u64 = 128

# ============================================================================
# Heap Initialization
# ============================================================================

# Initialize the heap with an initial size
pub fn kheap_init(initial_pages: u64) -> i32
    if heap_initialized
        return -1

    heap_start = HEAP_START
    heap_end = heap_start

    # Map initial pages
    var i: u64 = 0
    while i < initial_pages
        let phys: u64 = pmm_alloc_page()
        if phys == 0
            return -1
        let virt: u64 = heap_end
        let result: i32 = vmm_map_page(virt, phys, PTE_WRITABLE)
        if result != 0
            pmm_free_page(phys)
            return -1
        heap_end = heap_end + PAGE_SIZE
        i = i + 1

    # Create initial free block
    let block: *HeapBlock = heap_start as *HeapBlock
    (*block).next = 0
    (*block).size = heap_end - heap_start
    (*block).magic = HEAP_BLOCK_MAGIC
    (*block).flags = 1

    heap_free_list = heap_start
    heap_initialized = true

    return 0

# Expand heap by adding more pages
fn heap_expand(pages: u64) -> i32
    var i: u64 = 0
    while i < pages
        let phys: u64 = pmm_alloc_page()
        if phys == 0
            return -1
        let virt: u64 = heap_end
        let result: i32 = vmm_map_page(virt, phys, PTE_WRITABLE)
        if result != 0
            pmm_free_page(phys)
            return -1
        heap_end = heap_end + PAGE_SIZE
        i = i + 1

    return 0

# ============================================================================
# Allocation
# ============================================================================


# Point the free list (or free block `prev`, when non-zero) at `next`.
fn heap_link_after(prev: u64, next: u64)
    if prev == 0
        heap_free_list = next
    else
        let prev_block: *HeapBlock = prev as *HeapBlock
        (*prev_block).next = next

# Allocate `total_size` bytes from free block `curr` (preceded in the free list
# by `prev`, 0 if it is the head): split off the remainder as a new free block
# when it is big enough, unlink, mark allocated, and return its data pointer.
fn heap_take_block(prev: u64, curr: u64, total_size: u64) -> *u8
    let block: *HeapBlock = curr as *HeapBlock
    let remaining: u64 = (*block).size - total_size

    if remaining >= HEAP_MIN_BLOCK
        # Split the block
        let new_block_addr: u64 = curr + total_size

        # Write directly using pointer arithmetic
        let new_next_ptr: *u64 = new_block_addr as *u64
        let new_size_ptr: *u64 = (new_block_addr + 8) as *u64
        let new_magic_ptr: *u64 = (new_block_addr + 16) as *u64
        let new_flags_ptr: *u64 = (new_block_addr + 24) as *u64

        *new_next_ptr = (*block).next
        *new_size_ptr = remaining
        *new_magic_ptr = HEAP_BLOCK_MAGIC
        *new_flags_ptr = 1

        (*block).size = total_size
        (*block).next = new_block_addr

        # Update free list
        heap_link_after(prev, new_block_addr)
    else
        # Use entire block
        heap_link_after(prev, (*block).next)

    # Mark as allocated
    (*block).flags = 0
    (*block).next = 0

    # Return pointer to data (after header)
    return (curr + 32) as *u8

# Allocate memory from the heap
pub fn kalloc(size: u64) -> *u8
    if not heap_initialized
        return 0 as *u8

    # Calculate actual size needed (header + data, aligned to 8 bytes)
    let aligned_size: u64 = (size + 7) & 18446744073709551608
    var total_size: u64 = aligned_size + 32

    if total_size < HEAP_MIN_BLOCK
        total_size = HEAP_MIN_BLOCK

    # Search free list (first fit)
    var prev: u64 = 0
    var curr: u64 = heap_free_list

    while curr != 0
        let block: *HeapBlock = curr as *HeapBlock

        # Validate block
        if (*block).magic != HEAP_BLOCK_MAGIC
            klog("[heap] CORRUPTION: bad magic at " as StrView)
            klog_hex(curr)
            klog(" magic=" as StrView)
            klog_hex((*block).magic)
            klog("\n" as StrView)
            return 0 as *u8

        if ((*block).flags & 1) != 0 and (*block).size >= total_size
            # Found a suitable block
            return heap_take_block(prev, curr, total_size)

        prev = curr
        curr = (*block).next

    # No suitable block found - expand heap
    let pages_needed: u64 = (total_size + PAGE_SIZE - 1) / PAGE_SIZE

    # Expand by at least 4 pages to reduce expansion frequency
    var pages_to_expand: u64 = pages_needed
    if pages_to_expand < 4
        pages_to_expand = 4

    # Remember start of new region before expanding
    let new_region_start: u64 = heap_end

    let result: i32 = heap_expand(pages_to_expand)
    if result != 0
        return 0 as *u8

    # Create new free block covering the entire new region
    let new_start: u64 = new_region_start
    let new_block: *HeapBlock = new_start as *HeapBlock
    (*new_block).next = 0
    (*new_block).size = pages_to_expand * PAGE_SIZE
    (*new_block).magic = HEAP_BLOCK_MAGIC
    (*new_block).flags = 1

    # Add to free list
    if heap_free_list == 0
        heap_free_list = new_start
    else
        # Find end of free list
        var curr2: u64 = heap_free_list
        while curr2 != 0
            let b: *HeapBlock = curr2 as *HeapBlock
            if (*b).next == 0
                (*b).next = new_start
                break
            curr2 = (*b).next

    # Try allocation again (recursive)
    return kalloc(size)

# ============================================================================
# Deallocation
# ============================================================================

# Free allocated memory
pub fn kfree(ptr: *u8) -> i32
    if ptr == (0 as *u8)
        return -1

    if not heap_initialized
        return -1

    # Get block header
    let block_addr: u64 = (ptr as u64) - 32
    let block: *HeapBlock = block_addr as *HeapBlock

    # Validate
    if (*block).magic != HEAP_BLOCK_MAGIC
        return -1

    if ((*block).flags & 1) != 0
        return -1

    # Mark as free
    (*block).flags = 1

    # Add to free list (at head for simplicity)
    (*block).next = heap_free_list
    heap_free_list = block_addr

    return 0

# ============================================================================
# Statistics
# ============================================================================

# Get heap statistics
pub fn heap_get_used() -> u64
    if not heap_initialized
        return 0
    return heap_end - heap_start

pub fn heap_get_free() -> u64
    if not heap_initialized
        return 0

    var total_free: u64 = 0
    var curr: u64 = heap_free_list
    var block_count: i32 = 0

    while curr != 0 and block_count < 100
        let block: *HeapBlock = curr as *HeapBlock
        if (*block).magic == HEAP_BLOCK_MAGIC
            if ((*block).flags & 1) != 0
                total_free = total_free + (*block).size - 32
        else
            break
        curr = (*block).next
        block_count = block_count + 1

    return total_free

# Debug: dump heap state
pub fn heap_dump()
    if not heap_initialized
        klog("Heap not initialized\n" as StrView)
        return

    klog("Heap dump:\n" as StrView)
    klog("  Start: " as StrView)
    klog_hex(heap_start)
    klog(" End: " as StrView)
    klog_hex(heap_end)
    klog(" FreeList: " as StrView)
    klog_hex(heap_free_list)
    klog("\n" as StrView)

    var block_count: i32 = 0
    var curr: u64 = heap_free_list
    while curr != 0 and block_count < 10
        let block: *HeapBlock = curr as *HeapBlock
        klog("  Block at " as StrView)
        klog_hex(curr)
        klog(": size=" as StrView)
        klog_dec((*block).size)
        klog(" magic=" as StrView)
        klog_hex((*block).magic as u64)
        klog(" flags=" as StrView)
        klog_hex((*block).flags as u64)
        klog(" next=" as StrView)
        klog_hex((*block).next)
        klog("\n" as StrView)
        curr = (*block).next
        block_count = block_count + 1

# Check the free list's integrity: returns 0 if OK, -1 (after logging the
# bad block) if corrupted. Every free block carries the magic, is marked
# free, lies inside [heap_start, heap_end) and is at least HEAP_MIN_BLOCK
# bytes, so an overrun that clobbers a neighbour's next/size (and not its
# magic) is caught too (AGAST #1887).
pub fn heap_check() -> i32
    if not heap_initialized
        return -1

    var curr: u64 = heap_free_list
    var block_count: i32 = 0
    while curr != 0 and block_count < 10000
        if curr < heap_start or curr >= heap_end
            klog("[heap_check] CORRUPTION: free-list link out of the heap: " as StrView)
            klog_hex(curr)
            klog("\n" as StrView)
            return -1
        let block: *HeapBlock = curr as *HeapBlock
        let size: u64 = (*block).size
        if (*block).magic != HEAP_BLOCK_MAGIC or ((*block).flags & 1) == 0 or size < HEAP_MIN_BLOCK or size > heap_end - curr
            klog("[heap_check] CORRUPTION at " as StrView)
            klog_hex(curr)
            klog(" size=" as StrView)
            klog_hex(size)
            klog("\n" as StrView)
            return -1
        curr = (*block).next
        block_count = block_count + 1
    0
