# Harland AP calls over the mailbox (AGAST #4220, rebuilt on sync/mbox.ritz
# by #4879; docs/SMP_USER.md §2 "The AP call on the mailbox")
#
# The BSP asks one AP to run a kernel function: it posts CALL{id, kind} to
# the AP's mailbox (which kicks it) and waits for CALL_DONE{id, status} in
# its own. The AP handles the CALL at its next safe point, its idle loop
# (cpu_smp.ritz smp_ap_idle), with interrupts on so the callee can wait for
# its own device interrupt.
#
# The callee (today nvme_ap_probe) uses BSP-owned state: the heap, the NVMe
# queue state and the serial log. The BSP lends those rows for the call: its
# wait touches nothing but its own mailbox and `pause`. Only the BSP waits
# on another CPU and an AP never does, so there is no cycle of waiters (§2
# "No deadlock"). Calls are serialized: one in flight, to one AP.
#
# The boot's mailbox self-test lives here too (ap_ping_all): the BSP pings
# every started AP over the mailbox and checks the pongs.

import ritzlib.option
import ritzlib.result
import klog { klog, klog_dec }
import io { cpu_pause, interrupts_enabled, enable_interrupts, disable_interrupts }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import arch.x86_64.cpu_map { MAX_CPUS, num_cpus, cpu_apic_ids, cpu_map_started }
import arch.x86_64.percpu { cpu_index }
import sync.mbox { MboxMsg, MBOX_CALL, MBOX_CALL_DONE, MBOX_PING, MBOX_PONG, mbox_msg, mbox_post, mbox_take, mbox_drop_stray }
import drivers.nvme.nvme { nvme_ap_probe }

const AP_CALL_NVME: u32 = 1

# How long the BSP waits for an AP to finish one call, and for one AP's pings.
const AP_CALL_TIMEOUT_US: u64 = 10000000   # 10 s

# Pings sent to each AP: more than the ring's 16 slots, so both rings wrap.
const PING_COUNT: u64 = 64
# Pings in flight to one AP at once: under the ring size, so a mailbox is
# never full (sync/mbox.ritz), and over one, so order is tested.
const PING_WINDOW: u64 = 8

# The id of the last CALL the BSP sent: a CALL_DONE carrying another is a
# late reply to a call that timed out.
var ap_call_id: u64 = 0

pub enum ApCallError
    NoAnswer       # no CALL_DONE within AP_CALL_TIMEOUT_US
    Failed         # the callee returned non-zero

# Run AP call `kind` on this CPU (sync/mbox.ritz's CALL handler, through its
# `extern` hook), with interrupts on so the callee can wait for its device
# interrupt. Returns the callee's status, 0 when it worked.
pub fn ap_call_run(kind: u32) -> i32
    let was_on: bool = interrupts_enabled()
    enable_interrupts()
    var status: i32 = -1
    if kind == AP_CALL_NVME
        status = nvme_ap_probe()
    if not was_on
        disable_interrupts()
    status

# Wait on this CPU's own mailbox for a `kind` reply from CPU `from` whose
# arg[0] is `tag`, until `deadline`. Any other message is a stray (a late
# reply to an earlier request) and is dropped. Touches nothing but the
# mailbox and `pause`.
fn ap_wait_reply(from: i32, kind: u32, tag: u64, deadline: u64) -> Option<MboxMsg>
    let me: i32 = cpu_index()
    while not deadline_passed(deadline)
        match mbox_take(me)
            Some(m) =>
                if m.kind == kind and m.from as i32 == from and m.arg[0] == tag
                    return Some(m)
                mbox_drop_stray(m)
            None => cpu_pause()
    None

# Send call `kind` to CPU `cpu` and wait for its CALL_DONE.
fn ap_call_one(cpu: i32, kind: u32) -> Result<(), ApCallError>
    ap_call_id = ap_call_id + 1
    var call: MboxMsg = mbox_msg(MBOX_CALL)
    call.arg[0] = ap_call_id
    call.arg[1] = kind as u64
    mbox_post(cpu, call)
    match ap_wait_reply(cpu, MBOX_CALL_DONE, ap_call_id, deadline_after_us(AP_CALL_TIMEOUT_US))
        Some(done) =>
            if done.arg[1] != 0
                return Err(ApCallError.Failed)
            Ok(())
        None =>
            klog("[apcall] AP ")
            klog_dec(cpu_apic_ids[cpu] as i64)
            klog(" did not answer\n")
            Err(ApCallError.NoAnswer)

# The started CPUs other than this one, by cpu_map index.
fn is_other_ap(i: i32) -> bool
    i != cpu_index() and cpu_map_started(i) != 0

# Ask every started AP (not this CPU) to read its NVMe disk through its own
# MSI-X vector. Returns how many APs answered with a good read.
pub fn ap_run_nvme_probe() -> i32
    var n: i32 = 0
    var i: i32 = 0
    while i < num_cpus as i32 and i < MAX_CPUS
        if is_other_ap(i)
            match ap_call_one(i, AP_CALL_NVME)
                Ok(_) => n = n + 1
                Err(_) => pass
        i = i + 1
    n

# Ping CPU `cpu` PING_COUNT times, PING_WINDOW in flight, and check the
# pongs come back from it, each echoing its ping's number, in order. Returns
# how many came back in order before the first miss.
fn ap_ping_one(cpu: i32) -> u64
    let deadline: u64 = deadline_after_us(AP_CALL_TIMEOUT_US)
    var sent: u64 = 0
    var answered: u64 = 0
    while answered < PING_COUNT
        while sent < PING_COUNT and sent - answered < PING_WINDOW
            var ping: MboxMsg = mbox_msg(MBOX_PING)
            ping.arg[0] = sent
            mbox_post(cpu, ping)
            sent = sent + 1
        # The next pong must echo `answered`: one that echoes anything else
        # is out of order (or lost one) and is dropped, and the wait runs out.
        match ap_wait_reply(cpu, MBOX_PONG, answered, deadline)
            Some(_) => answered = answered + 1
            None => return answered
    answered

# The boot's mailbox self-test (SMP_USER.md §6): every started AP drains its
# mailbox from its idle loop and answers through the kick. Logs, per AP,
#   [mbox] round trip OK: cpu K answered N pings
# or "[mbox] round trip FAIL: cpu K answered M of N pings", and with no AP
# "[mbox] no APs to ping". tools/test_tier1_boot.sh wants an OK line from
# every AP. Returns how many APs passed.
pub fn ap_ping_all() -> i32
    var n: i32 = 0
    var aps: i32 = 0
    var i: i32 = 0
    while i < num_cpus as i32 and i < MAX_CPUS
        if is_other_ap(i)
            aps = aps + 1
            let got: u64 = ap_ping_one(i)
            if got == PING_COUNT
                klog("[mbox] round trip OK: cpu ")
                n = n + 1
            else
                klog("[mbox] round trip FAIL: cpu ")
            klog_dec(i as i64)
            klog(" answered ")
            if got != PING_COUNT
                klog_dec(got as i64)
                klog(" of ")
            klog_dec(PING_COUNT as i64)
            klog(" pings\n")
        i = i + 1
    if aps == 0
        klog("[mbox] no APs to ping\n")
    n
