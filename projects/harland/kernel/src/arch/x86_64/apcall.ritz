# Harland AP call IPIs (AGAST #4220)
#
# APs run no scheduler (proc/sched.ritz), so they idle with interrupts on.
# The BSP can ask one AP to run a kernel function by sending it a fixed IPI on
# vector AP_CALL_VECTOR; the AP's irq_handler calls ap_call_dispatch, which
# runs the requested call with interrupts enabled (so the callee can wait for
# its own device interrupt) and flags completion. The BSP waits for the flag,
# bounded, and reads ap_call_status.
#
# Calls are serialized: one kind in flight at a time, one AP at a time. That
# is enough for the boot-time NVMe check, and it keeps the driver's shared
# state (the HEAP allocator, the serial log) single-owner while the call runs.
#
# Today the one call is "read the end of your NVMe disk", which proves an
# AP-issued command completes through an interrupt aimed at that AP rather
# than by polling (drivers/nvme/nvme.ritz nvme_ap_probe).

import klog { klog, klog_dec }
import io { cpu_pause, memory_barrier, enable_interrupts, disable_interrupts }
import arch.x86_64.apic { lapic_id, lapic_send_fixed_ipi }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import arch.x86_64.cpu_map { MAX_CPUS, num_cpus, cpu_apic_ids, cpu_map_started }
import drivers.nvme.nvme { nvme_ap_probe }

# IDT vector the AP-call IPI carries (kernel/isr_stubs.s IRQ_STUB 48, 240).
pub const AP_CALL_VECTOR: u8 = 240

const AP_CALL_NONE: u32 = 0
const AP_CALL_NVME: u32 = 1

# How long the BSP waits for an AP to finish one call.
const AP_CALL_TIMEOUT_US: u64 = 10000000   # 10 s

var ap_call_kind: u32 = AP_CALL_NONE
var ap_call_done: u32 = 0
var ap_call_status: i32 = 0

# Called on the AP from irq_handler for AP_CALL_VECTOR. Runs the requested
# call with interrupts on and flags completion. The caller still sends EOI.
pub fn ap_call_dispatch() -> i32
    let kind: u32 = ap_call_kind
    if kind == AP_CALL_NONE
        return 0
    enable_interrupts()
    var status: i32 = -1
    if kind == AP_CALL_NVME
        status = nvme_ap_probe()
    disable_interrupts()
    ap_call_status = status
    atomic_store(@ap_call_done as *u32, 1)
    return 0

# Send one call to `apic_id` and wait for it. Returns the callee's status,
# or -1 on timeout.
fn ap_call_one(apic_id: u32, kind: u32) -> i32
    atomic_store(@ap_call_done as *u32, 0)
    ap_call_kind = kind
    memory_barrier()
    lapic_send_fixed_ipi(apic_id, AP_CALL_VECTOR)
    let deadline: u64 = deadline_after_us(AP_CALL_TIMEOUT_US)
    while atomic_load(@ap_call_done as *u32) == 0 and not deadline_passed(deadline)
        cpu_pause()
    ap_call_kind = AP_CALL_NONE
    if atomic_load(@ap_call_done as *u32) == 0
        klog("[apcall] AP ")
        klog_dec(apic_id as i64)
        klog(" did not answer\n")
        return -1
    return ap_call_status

# Ask every started AP (not this CPU) to read its NVMe disk through its own
# MSI-X vector. Returns how many APs answered.
pub fn ap_run_nvme_probe() -> i32
    let me: u32 = lapic_id()
    var n: i32 = 0
    var i: i32 = 0
    while i < num_cpus as i32 and i < MAX_CPUS
        let apic_id: u32 = cpu_apic_ids[i]
        if apic_id != me and cpu_map_started(i) != 0
            if ap_call_one(apic_id, AP_CALL_NVME) == 0
                n = n + 1
        i = i + 1
    return n
