# Harland GDT (Global Descriptor Table) Implementation
#
# x86-64 GDT with:
# - Null descriptor (required)
# - Kernel code segment (64-bit)
# - Kernel data segment
# - User data segment
# - User code segment (64-bit)
# - TSS descriptor (16 bytes, for task state segment)
#
# In 64-bit mode, most of the GDT fields are ignored, but we still
# need valid entries for segmentation to work.

import arch.x86_64.cpu_map { MAX_CPUS }

# ============================================================================
# GDT Segment Selectors
# ============================================================================

# Selector format: Index (13 bits) | TI (1 bit) | RPL (2 bits)
# TI=0 means GDT, RPL is the requested privilege level

const GDT_NULL: u16 = 0x00          # Null segment
const GDT_KERNEL_CODE: u16 = 0x08   # Index 1, ring 0
const GDT_KERNEL_DATA: u16 = 0x10   # Index 2, ring 0
const GDT_USER_DATA: u16 = 0x1B     # Index 3, ring 3 (0x18 | 3)
const GDT_USER_CODE: u16 = 0x23     # Index 4, ring 3 (0x20 | 3)
const GDT_TSS: u16 = 0x28           # Index 5, TSS

# STAR[63:48] (AGAST #4610). SYSRETQ loads SS = base + 8 and CS = base + 16,
# both with RPL 3, so user data must sit right before 64-bit user code.
# syscall/runtime/entry.ritz and syscall_entry.s write it; keep them in step.
pub const GDT_SYSRET_BASE: u16 = 0x13   # GDT_KERNEL_DATA | 3

# ============================================================================
# GDT Access Byte Flags
# ============================================================================

const GDT_ACCESS_PRESENT: u8 = 0x80     # Segment is present
const GDT_ACCESS_RING0: u8 = 0x00       # Ring 0 (kernel)
const GDT_ACCESS_RING3: u8 = 0x60       # Ring 3 (user)
const GDT_ACCESS_CODE: u8 = 0x1A        # Executable, readable
const GDT_ACCESS_DATA: u8 = 0x12        # Writable
const GDT_ACCESS_TSS: u8 = 0x89         # 64-bit TSS (available)
const GDT_ACCESS_IGNORE_ACCESSED: u8 = 0xFE  # mask off the CPU-set Accessed bit

# ============================================================================
# GDT Flags (high nibble of flags_limit byte)
# ============================================================================

const GDT_FLAG_LONG: u8 = 0x20          # 64-bit code segment
const GDT_FLAG_GRANULARITY: u8 = 0x80   # 4KB page granularity

# ============================================================================
# GDT Entry Structure (8 bytes)
# ============================================================================

struct GdtEntry
    limit_low: u16      # Bits 0-15 of limit
    base_low: u16       # Bits 0-15 of base
    base_mid: u8        # Bits 16-23 of base
    access: u8          # Access flags
    flags_limit: u8     # High nibble = flags, low nibble = bits 16-19 of limit
    base_high: u8       # Bits 24-31 of base

# ============================================================================
# TSS Entry Structure (16 bytes - spans two GDT slots)
# ============================================================================

struct TssEntry
    limit_low: u16
    base_low: u16
    base_mid: u8
    access: u8
    flags_limit: u8
    base_high: u8
    base_upper: u32     # Bits 32-63 of base (x86-64 extension)
    reserved: u32

# ============================================================================
# GDT Descriptor (for LGDT instruction)
# ============================================================================

# Must be packed to match x86-64 hardware layout (10 bytes total)
[[packed]]
struct GdtDescriptor
    size: u16           # Size of GDT minus 1
    offset: u64         # Linear address of GDT

# ============================================================================
# Task State Segment (TSS)
# ============================================================================

# TSS must be packed to match x86-64 hardware layout
# RSP0 must be at offset 4, not aligned to 8!
[[packed]]
struct Tss
    reserved0: u32
    rsp0: u64           # Ring 0 stack pointer
    rsp1: u64           # Ring 1 stack pointer (unused)
    rsp2: u64           # Ring 2 stack pointer (unused)
    reserved1: u64
    ist1: u64           # Interrupt Stack Table entry 1
    ist2: u64           # IST entry 2
    ist3: u64           # IST entry 3
    ist4: u64           # IST entry 4
    ist5: u64           # IST entry 5
    ist6: u64           # IST entry 6
    ist7: u64           # IST entry 7
    reserved2: u64
    reserved3: u16
    iopb_offset: u16    # I/O permission bitmap offset

# ============================================================================
# Global GDT and per-CPU TSS storage (AGAST #4192)
# ============================================================================
# One GDT is shared by every CPU, but the TSS is per CPU: it holds the ring-0
# RSP (TSS.rsp0) and the IST stacks an interrupt from ring 3 lands on, and two
# CPUs must never share those. The first five descriptors are fixed; each CPU
# owns a 16-byte TSS descriptor after them, at index GDT_TSS_FIRST +
# cpu_index*2, and loads TR with that selector. 133 entries = 5 + 2*64
# (arch/x86_64/cpu_map.ritz MAX_CPUS; a literal because array lengths are).
const GDT_TSS_FIRST: i32 = 5
const GDT_ENTRIES: i32 = 133

# GDT with 133 entries: null, kernel code, kernel data, user data, user code,
# then 64 pairs of TSS descriptors.
var gdt: [133]GdtEntry

# The TSS of each CPU, indexed by CPU index (cpu_map), not APIC ID.
var tsses: [64]Tss

# GDT descriptor for LGDT
var gdt_descriptor: GdtDescriptor

# CPU 0's fallback stacks, used from gdt_init (before the PMM exists) until
# arch/x86_64/percpu.ritz cpu_bringup gives every CPU PMM-backed, guard-paged
# stacks.
var kernel_stack: [4096]u8

# IST1: Interrupt stack for critical exceptions (NMI, double fault, stack fault, machine check)
var interrupt_stack: [4096]u8

# IST2: Interrupt stack for hardware IRQs (timer, etc.)
var irq_stack: [4096]u8

# IST3: the scheduler's timer tick (isr_stubs.s irq_stub_timer, #3629)
var timer_stack: [4096]u8

# ============================================================================
# GDT Helper Functions
# ============================================================================

fn make_gdt_entry(base: u32, limit: u32, access: u8, flags: u8) -> GdtEntry
    var entry: GdtEntry
    entry.limit_low = (limit & 0xFFFF) as u16
    entry.base_low = (base & 0xFFFF) as u16
    entry.base_mid = ((base >> 16) & 0xFF) as u8
    entry.access = access
    let limit_hi: u8 = ((limit >> 16) & 0x0F) as u8
    let flags_hi: u8 = flags & 0xF0
    entry.flags_limit = limit_hi | flags_hi
    entry.base_high = ((base >> 24) & 0xFF) as u8
    return entry

fn set_tss_entry(gdt_index: i32, tss_addr: u64)
    # TSS descriptor spans two GDT entries in 64-bit mode
    let base: u64 = tss_addr
    let limit: u32 = 103  # Size of TSS minus 1 (104 bytes)

    # First 8 bytes (standard GDT entry format)
    gdt[gdt_index].limit_low = (limit & 0xFFFF) as u16
    gdt[gdt_index].base_low = (base & 0xFFFF) as u16
    gdt[gdt_index].base_mid = ((base >> 16) & 0xFF) as u8
    gdt[gdt_index].access = GDT_ACCESS_TSS
    gdt[gdt_index].flags_limit = ((limit >> 16) & 0x0F) as u8
    gdt[gdt_index].base_high = ((base >> 24) & 0xFF) as u8

    # Second 8 bytes (upper 32 bits of base + reserved)
    # We need to access the next entry as raw bytes
    let next_entry: *u8 = @gdt[gdt_index + 1] as *u8

    # Write upper 32 bits of base address
    let base_upper: u32 = ((base >> 32) & 0xFFFFFFFF) as u32
    *(next_entry as *u32) = base_upper

    # Write reserved (must be 0)
    *((next_entry + 4) as *u32) = 0

# ============================================================================
# GDT Initialization
# ============================================================================

# The TSS selector of CPU `cpu_idx`: its 16-byte descriptor after the five
# fixed entries.
fn tss_selector(cpu_idx: i32) -> u16
    return ((GDT_TSS_FIRST + cpu_idx * 2) * 8) as u16

# Fill CPU `cpu_idx`'s TSS: ring-0 RSP and the three IST stacks.
fn tss_fill(cpu_idx: i32, rsp0: u64, ist1: u64, ist2: u64, ist3: u64) -> i32
    # Zero out the TSS
    let tss_ptr: *u8 = @tsses[cpu_idx] as *u8
    var i: i32 = 0
    while i < 104
        *(tss_ptr + i as i64) = 0
        i = i + 1

    tsses[cpu_idx].rsp0 = rsp0
    tsses[cpu_idx].ist1 = ist1
    tsses[cpu_idx].ist2 = ist2
    tsses[cpu_idx].ist3 = ist3
    # I/O permission bitmap offset (beyond TSS = no IOPB)
    tsses[cpu_idx].iopb_offset = 104
    return 0

pub fn gdt_init() -> i32
    # Entry 0: Null descriptor (required)
    gdt[0] = make_gdt_entry(0, 0, 0, 0)

    # Entry 1: Kernel code segment (64-bit)
    let kcode_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING0 | GDT_ACCESS_CODE
    let kcode_flags: u8 = GDT_FLAG_LONG | GDT_FLAG_GRANULARITY
    gdt[1] = make_gdt_entry(0, 0xFFFFF, kcode_access, kcode_flags)

    # Entry 2: Kernel data segment
    let kdata_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING0 | GDT_ACCESS_DATA
    let kdata_flags: u8 = GDT_FLAG_GRANULARITY
    gdt[2] = make_gdt_entry(0, 0xFFFFF, kdata_access, kdata_flags)

    # Entry 3: User data segment, then entry 4: user code (64-bit). This
    # order is SYSRETQ's (GDT_SYSRET_BASE + 8, + 16).
    let udata_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_DATA
    let udata_flags: u8 = GDT_FLAG_GRANULARITY
    gdt[3] = make_gdt_entry(0, 0xFFFFF, udata_access, udata_flags)

    let ucode_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_CODE
    let ucode_flags: u8 = GDT_FLAG_LONG | GDT_FLAG_GRANULARITY
    gdt[4] = make_gdt_entry(0, 0xFFFFF, ucode_access, ucode_flags)

    # CPU 0's TSS with the early fallback stacks. cpu_bringup replaces them
    # with PMM-backed, guard-paged stacks once the VMM is up.
    tss_fill(0, (@kernel_stack[0] as u64) + 4096,
             (@interrupt_stack[0] as u64) + 4096,
             (@irq_stack[0] as u64) + 4096,
             (@timer_stack[0] as u64) + 4096)
    set_tss_entry(GDT_TSS_FIRST, @tsses[0] as u64)

    # Set up GDT descriptor
    gdt_descriptor.size = (GDT_ENTRIES * 8 - 1) as u16
    gdt_descriptor.offset = @gdt[0] as u64

    # Load the GDT
    gdt_load()

    # Load the TSS
    tss_load(tss_selector(0))

    return 0

# Give CPU `cpu_idx` its own TSS (rsp0 + IST1/2/3 stacks) and load TR with its
# selector. Called by arch/x86_64/percpu.ritz cpu_bringup on every CPU; on the
# BSP it replaces the early fallback stacks, on an AP it is the first TSS.
pub fn gdt_init_cpu(cpu_idx: i32, rsp0: u64, ist1: u64, ist2: u64, ist3: u64) -> i32
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return -1
    # The AP must be on the kernel GDT before loading its own TSS descriptor
    # (the trampoline's GDT has no TSS); reloading on the BSP is harmless.
    gdt_load()
    tss_fill(cpu_idx, rsp0, ist1, ist2, ist3)
    set_tss_entry(GDT_TSS_FIRST + cpu_idx * 2, @tsses[cpu_idx] as u64)
    tss_load(tss_selector(cpu_idx))
    return 0

# Set CPU `cpu_idx`'s ring-0 RSP (TSS.rsp0): where an interrupt from ring 3
# starts. proc/sched.ritz points it at the running process's kernel stack.
pub fn gdt_set_kernel_stack_cpu(cpu_idx: i32, stack_top: u64) -> i32
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return -1
    tsses[cpu_idx].rsp0 = stack_top
    return 0

# ============================================================================
# Assembly Routines
# ============================================================================

# External function to load GDT and reload segment registers (defined in isr_stubs.s)
extern fn gdt_flush(gdt_ptr: u64) -> i32

fn gdt_load() -> i32
    let gdt_ptr: *GdtDescriptor = @gdt_descriptor
    gdt_flush(gdt_ptr as u64)
    return 0

fn tss_load(tss_seg: u16) -> i32
    # Load TSS selector into TR register
    asm x86_64:
        movw {tss_seg}, %ax
        ltr %ax
    return 0

# ============================================================================
# Public API
# ============================================================================

pub fn gdt_get_kernel_code_selector() -> u16
    return GDT_KERNEL_CODE

pub fn gdt_get_kernel_data_selector() -> u16
    return GDT_KERNEL_DATA

pub fn gdt_get_user_code_selector() -> u16
    return GDT_USER_CODE

pub fn gdt_get_user_data_selector() -> u16
    return GDT_USER_DATA

pub fn gdt_get_sysret_base() -> u16
    return GDT_SYSRET_BASE

# The live GDT is in SYSRETQ's order (the "sysret" boot self-test, #4610):
# base + 8 is a ring-3 data segment and base + 16 a ring-3 long-mode code
# segment, matching the user selectors.
pub fn gdt_user_segments_ok() -> bool
    let data_idx: i32 = ((GDT_SYSRET_BASE + 8) >> 3) as i32
    let code_idx: i32 = ((GDT_SYSRET_BASE + 16) >> 3) as i32
    if (((GDT_SYSRET_BASE + 8) | 3) != GDT_USER_DATA) or (((GDT_SYSRET_BASE + 16) | 3) != GDT_USER_CODE)
        return false
    # The CPU sets the Accessed bit (bit 0) when it loads a selector.
    let data_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_DATA
    let code_access: u8 = GDT_ACCESS_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_CODE
    if (gdt[data_idx].access & GDT_ACCESS_IGNORE_ACCESSED) != data_access or (gdt[data_idx].flags_limit & GDT_FLAG_LONG) != 0
        return false
    if (gdt[code_idx].access & GDT_ACCESS_IGNORE_ACCESSED) != code_access or (gdt[code_idx].flags_limit & GDT_FLAG_LONG) == 0
        return false
    return true
