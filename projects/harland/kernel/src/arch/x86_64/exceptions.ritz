# Harland Kernel - Exception and IRQ Handlers
#
# Handles CPU exceptions (divide error, page fault, etc.) and hardware IRQs.
# These handlers are called from isr_stubs.s assembly code.

import klog { klog, klog_dec, klog_hex, klog_mark, klog_console_tail, klog_serial_drain, klog_emergency }
import drivers.display.fbcon { fbcon_panic_begin, fbcon_write, fbcon_rows_left }
import io { halt_loop }
import serial { StrView }
import tty.console { tty_console_irq, tty_console_irq_kill }
import drivers.i8042.kbd { i8042_irq, i8042_irq_eoi }
import mm.vmm { vmm_debug_page_tables }
import drivers.msix { msix_dispatch }
import drivers.usb.xhci { xhci_owns_vector }
import drivers.usb.usb { xhci_irq }
import syscall.runtime.process { process_kill_current, current_pid }
import syscall.stack { syscall_stack_guard_hit }
import proc.sched { sched_tick }
import proc.waitq { waitq_wake_irq }
import sync.mbox { mbox_kick_irq }
import arch.x86_64.sysret_catch { sysret_selftest_catch }
import arch.x86_64.nmi_probe { ist_nest_catch, nmi_probe_catch }

# External functions from main.ritz
extern fn ring_dump()
extern fn lapic_eoi()

# syscall_entry.s: the IRETQ a syscall returns through when its return RIP
# is non-canonical (AGAST #4610).
extern fn syscall_exit_iret()

# A fault on syscall_exit_iret is the user's, though CS is still the
# kernel's: the IRETQ to a non-canonical RIP #GPs before it leaves ring 0.
# The user's RIP is in the IRETQ frame the fault interrupted (at its RSP).
fn fault_on_syscall_iret(frame: *InterruptFrame) -> bool
    return ((*frame).cs & 3) == 0 and (*frame).rip == syscall_exit_iret as u64

# ============================================================================
# Interrupt Frame Structure
# ============================================================================
#
# Pushed by CPU and ISR stubs when an interrupt occurs.
# Layout matches isr_stubs.s push order.

pub struct InterruptFrame
    r15: u64
    r14: u64
    r13: u64
    r12: u64
    r11: u64
    r10: u64
    r9: u64
    r8: u64
    rbp: u64
    rdi: u64
    rsi: u64
    rdx: u64
    rcx: u64
    rbx: u64
    rax: u64
    vector: u64
    error_code: u64
    rip: u64
    cs: u64
    rflags: u64
    rsp: u64
    ss: u64

# ============================================================================
# Stack Trace Support
# ============================================================================

# Stack frame structure for x86_64 SysV ABI
# Each frame contains:
#   [rbp+0]  = previous rbp (saved frame pointer)
#   [rbp+8]  = return address (rip)
struct StackFrame
    prev_rbp: *StackFrame
    return_addr: u64

# Maximum stack frames to print (prevent infinite loops on corrupted stacks)
const MAX_STACK_FRAMES: u64 = 16

# Check if an address looks like a valid kernel code address
fn is_valid_code_address(addr: u64) -> bool
    # Kernel code is in higher-half, 0xFFFFFFFF80100000 - 0xFFFFFFFF80200000 typically
    if addr >= 0xFFFFFFFF80100000 and addr < 0xFFFFFFFF80400000
        return true
    # Identity-mapped kernel during early boot (around 1MB)
    if addr >= 0x100000 and addr < 0x400000
        return true
    return false

# Check if a stack frame pointer looks valid
fn is_valid_frame_ptr(rbp: u64) -> bool
    # Must be non-null
    if rbp == 0
        return false
    # Must be 8-byte aligned
    if (rbp & 7) != 0
        return false
    # Check for reasonable kernel stack range
    # Kernel stacks are either in identity-mapped region or higher-half
    if rbp >= 0xFFFFFFFF80000000
        return true
    if rbp >= 0x100000 and rbp < 0x10000000
        return true
    return false

# Print a stack trace starting from the given RBP and RIP
pub fn print_stack_trace(rbp: u64, rip: u64)
    klog("\nStack Trace:\n")

    # First frame: the faulting instruction
    klog("  #0  ")
    klog_hex(rip)
    klog("  <faulting instruction>\n")

    var frame_ptr: u64 = rbp
    var frame_num: u64 = 1

    while frame_num < MAX_STACK_FRAMES
        # Validate frame pointer
        if not is_valid_frame_ptr(frame_ptr)
            if frame_num == 1
                klog("  (no valid stack frames - frame pointer invalid)\n")
            else
                klog("  (end of stack)\n")
            break

        # Read the stack frame
        let frame: *StackFrame = frame_ptr as *StackFrame
        let return_addr: u64 = (*frame).return_addr
        let prev_rbp: u64 = (*frame).prev_rbp as u64

        # Validate return address
        if not is_valid_code_address(return_addr)
            klog("  (invalid return address - end of trace)\n")
            break

        # Print this frame
        klog("  #")
        klog_dec(frame_num)
        klog("  ")
        klog_hex(return_addr)
        klog("\n")

        # Check for progress (stack grows down, so prev_rbp should be >= frame_ptr)
        if prev_rbp != 0 and prev_rbp <= frame_ptr
            klog("  (stack corruption detected - frame pointer going wrong direction)\n")
            break

        frame_ptr = prev_rbp
        frame_num = frame_num + 1

    if frame_num >= MAX_STACK_FRAMES
        klog("  ... (max frames reached)\n")

# ============================================================================
# Exception Names
# ============================================================================

pub fn exception_name(vector: u8) -> StrView
    if vector == 0
        return "Divide Error"
    if vector == 1
        return "Debug"
    if vector == 2
        return "NMI"
    if vector == 3
        return "Breakpoint"
    if vector == 4
        return "Overflow"
    if vector == 5
        return "Bound Range"
    if vector == 6
        return "Invalid Opcode"
    if vector == 7
        return "Device Not Available"
    if vector == 8
        return "Double Fault"
    if vector == 10
        return "Invalid TSS"
    if vector == 11
        return "Segment Not Present"
    if vector == 12
        return "Stack Fault"
    if vector == 13
        return "General Protection"
    if vector == 14
        return "Page Fault"
    if vector == 16
        return "x87 FP Exception"
    if vector == 17
        return "Alignment Check"
    if vector == 18
        return "Machine Check"
    if vector == 19
        return "SIMD FP Exception"
    if vector == 20
        return "Virtualization"
    if vector == 21
        return "Control Protection"
    return "Unknown"

# The faulting address of the last page fault.
fn read_cr2() -> u64
    var cr2: u64 = 0
    var cr2_ptr: *u64 = @cr2
    asm x86_64:
        movq %cr2, %rax
        movq {cr2_ptr}, %rcx
        movq %rax, (%rcx)
    return cr2

# The "[fault]" line for a user-mode exception. It must not print
# "EXCEPTION" or "PANIC": the boot tests read those as a kernel failure.
# The "sysret" boot self-test's expected fault resumes the test first
# (arch/x86_64/sysret_catch.ritz); no-op when it isn't running.
fn log_user_fault(frame: *InterruptFrame, user_rip: u64, bad_iret: bool)
    sysret_selftest_catch((*frame).vector, (*frame).rip, (*frame).cs)
    klog("[fault] PID ")
    klog_dec(current_pid() as i64)
    klog(": ")
    klog(exception_name((*frame).vector as u8))
    klog(" (vector ")
    klog_dec((*frame).vector)
    klog(") at RIP ")
    klog_hex(user_rip)
    if bad_iret
        klog(" (non-canonical syscall return)")
    if (*frame).vector == 14
        klog(" CR2 ")
        klog_hex(read_cr2())
    klog(", killing the process\n")

# ============================================================================
# Exception Handler
# ============================================================================
#
# Called from isr_stubs.s when a CPU exception occurs (vectors 0-31).
# A fault taken at any non-zero CPL (a ring-3 program or a ring-1 driver)
# kills only the running process (#2755, #4711): it exits with status
# 128 + vector and its parent resumes (init's exit powers off).
# A kernel-mode exception prints diagnostic information and halts. On a
# framebuffer the report is also the panic screen (AGAST #4868): white on
# red under a KERNEL PANIC banner, then the registers and stack trace (klog
# draws them), then as much of the recent kernel log as fits. No step
# allocates or needs interrupts.

pub fn exception_handler(frame: *InterruptFrame)
    # The "nmi-gs" self-test's NMI (arch/x86_64/nmi_probe.ritz, AGAST
    # #4612): recorded and returned from, before anything reads per-CPU state.
    if (*frame).vector == 2 and nmi_probe_catch((*frame).cs, frame as u64)
        return

    # The "ist-nest" self-test's #GP and #PF inside that NMI (AGAST #4628):
    # resumed past the faulting instruction.
    let nest_resume: u64 = ist_nest_catch((*frame).vector, (*frame).rip, (*frame).cs, frame as u64)
    if nest_resume != 0
        (*frame).rip = nest_resume
        return

    # A #GP on the syscall exit's IRETQ to a non-canonical RIP is the
    # user's fault, though CS is still the kernel's (AGAST #4610).
    if fault_on_syscall_iret(frame)
        log_user_fault(frame, *((*frame).rsp as *u64), true)
        process_kill_current(128 + ((*frame).vector as i32))
        return

    # CPL of the interrupted code: any non-zero CPL is a process (ring 3, or
    # ring 1 for a driver: RING1_DRIVER.md section 3).
    if ((*frame).cs & 3) != 0
        log_user_fault(frame, (*frame).rip, false)
        process_kill_current(128 + ((*frame).vector as i32))
        # Never reached: the parent resumed, or the machine powered off.
        return

    # A kernel write into a stack's unmapped guard page (#1877). #PF runs on
    # the stack it interrupted (idt.ritz, AGAST #4628), so an overflow can't
    # push its frame and becomes a #DF on its own IST stack; CR2 still holds
    # the guard page address, as Linux's #DF handler reads it.
    # The report must reach the log even if a CPU died holding klog_lock.
    klog_emergency()
    fbcon_panic_begin()
    let report_mark: u64 = klog_mark()
    let vec: u64 = (*frame).vector
    if (vec == 14 or vec == 8) and syscall_stack_guard_hit(read_cr2())
        klog("\n*** KERNEL PANIC: syscall stack overflow (guard page hit at 0x")
        klog_hex(read_cr2())
        klog(") ***\n")

    klog("\n!!! EXCEPTION !!!\n")
    klog("Vector: ")
    klog_hex((*frame).vector)
    klog(" (")
    klog(exception_name((*frame).vector as u8))
    klog(")\n")

    klog("Error Code: ")
    klog_hex((*frame).error_code)
    klog("\n")

    klog("RIP: ")
    klog_hex((*frame).rip)
    klog("\n")

    klog("CS: ")
    klog_hex((*frame).cs)
    klog("  SS: ")
    klog_hex((*frame).ss)
    klog("\n")

    klog("RFLAGS: ")
    klog_hex((*frame).rflags)
    klog("\n")

    klog("RSP: ")
    klog_hex((*frame).rsp)
    klog("\n")

    # For page faults, print CR2 and decode error code
    if (*frame).vector == 14
        let cr2: u64 = read_cr2()
        klog("CR2: ")
        klog_hex(cr2)
        klog(" (fault address)\n")

        # Decode error code
        klog("Error Code Bits:\n")
        if ((*frame).error_code & 1) != 0
            klog("  [P] Page present\n")
        else
            klog("  [P] Page not present\n")
        if ((*frame).error_code & 2) != 0
            klog("  [W] Write operation\n")
        else
            klog("  [W] Read operation\n")
        if ((*frame).error_code & 4) != 0
            klog("  [U] User mode\n")
        else
            klog("  [U] Kernel mode\n")
        if ((*frame).error_code & 8) != 0
            klog("  [R] Reserved bit violation\n")
        if ((*frame).error_code & 16) != 0
            klog("  [I] Instruction fetch\n")

        # Walk page tables to show the issue
        klog("\nPage Table Walk:\n")
        vmm_debug_page_tables(cr2)

    klog("\nRegisters:\n")
    klog("  RAX=")
    klog_hex((*frame).rax)
    klog(" RBX=")
    klog_hex((*frame).rbx)
    klog("\n")
    klog("  RCX=")
    klog_hex((*frame).rcx)
    klog(" RDX=")
    klog_hex((*frame).rdx)
    klog("\n")
    klog("  RSI=")
    klog_hex((*frame).rsi)
    klog(" RDI=")
    klog_hex((*frame).rdi)
    klog("\n")
    klog("  RBP=")
    klog_hex((*frame).rbp)
    klog("\n")

    # Print stack trace
    print_stack_trace((*frame).rbp, (*frame).rip)

    # Dump ring buffer (shows recent kernel activity before crash)
    ring_dump()
    panic_screen_log_tail(report_mark)

    klog("\n*** KERNEL PANIC ***\n")
    klog("System halted.\n")
    halt_loop()

# The panic screen's last part: the newest kernel log lines from before the
# report (`mark`) that fit above the closing two lines (ring_dump wrote the
# whole ring to COM1 only).
const PANIC_TAIL_RESERVED_ROWS: u32 = 5

fn panic_screen_log_tail(mark: u64)
    let rows: u32 = fbcon_rows_left()
    if rows <= PANIC_TAIL_RESERVED_ROWS
        return
    fbcon_write("\n--- recent kernel log ---\n")
    klog_console_tail(rows - PANIC_TAIL_RESERVED_ROWS, mark)

# The \harland\panic-test boot option (tools/test_fbcon_boot.sh, AGAST
# #4868): a kernel #UD once the console is up, so the boot test can read
# the panic screen. With `armed` it never returns; without, a no-op.
pub fn exception_panic_test(armed: bool)
    if not armed
        return
    klog("[panic-test] raising #UD in the kernel\n")
    asm x86_64:
        ud2

# ============================================================================
# IRQ Handler
# ============================================================================
#
# Called from isr_stubs.s when a hardware interrupt occurs (vectors 32+).

pub fn irq_handler(frame: *InterruptFrame)
    let irq_num: u64 = (*frame).vector - 32

    # Handle specific IRQs
    if irq_num == 0
        # The periodic LAPIC tick (or the NVMe watchdog's one-shot). EOI
        # first: if this tick preempts the process it interrupted (any
        # non-zero CPL), the switch returns here only when that process runs
        # again (#3629, #4711).
        lapic_eoi()
        sched_tick(((*frame).cs & 3) != 0)
        return

    if irq_num == 1
        # PS/2 keyboard. Decoded bytes take the console line discipline, and
        # Ctrl-C kills the current user process the way IRQ 4 does. EOI
        # before the kill: that path does not return. A level pin then
        # clears Remote IRR.
        let kill: bool = i8042_irq(((*frame).cs & 3) != 0)
        lapic_eoi()
        i8042_irq_eoi()
        if kill
            tty_console_irq_kill()
        return

    if irq_num == 4
        # COM1 serial port interrupt: received bytes go through the console's
        # line discipline (#4254), then any pending output is sent.
        let kill: bool = tty_console_irq(((*frame).cs & 3) != 0)
        klog_serial_drain()
        if kill
            # Ctrl-C while a process ran (non-zero CPL): it exits (130) and its
            # parent resumes; this handler never returns, so EOI first.
            lapic_eoi()
            tty_console_irq_kill()

    if irq_num == 208
        # Vector 240: the mailbox kick (sync/mbox.ritz KICK_VECTOR). It
        # sends EOI and marks the kick pending; the mailbox is drained at
        # this CPU's next safe point (the idle loop), never in the IRQ, so
        # an AP call runs with no ISR in service.
        mbox_kick_irq()
        return

    # MSI-X vectors (64-79 and the CPU-local 80-95): count the interrupt
    # (drivers/msix.ritz). A driver waiting for it is parked; wake it to
    # re-check its completion condition (#4220). The xHCI controller's
    # vector (aimed at the BSP, so this is the BSP) also drains its event
    # ring (docs/USB.md, "Concurrency under SMP_USER.md").
    if msix_dispatch((*frame).vector)
        if xhci_owns_vector((*frame).vector)
            xhci_irq()
        waitq_wake_irq()

    # Send EOI to LAPIC (for APIC-delivered interrupts)
    lapic_eoi()
