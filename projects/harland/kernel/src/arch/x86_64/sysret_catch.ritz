# The "sysret" boot self-test's fault catcher (AGAST #4610)
#
# arch/x86_64/cpu_smp.ritz sysret_selftest makes a syscall return to a
# non-canonical RIP. syscall_entry.s sends that through its IRETQ exit, and
# the IRETQ (or, on a CPU that loads the RIP first, the fetch in ring 3)
# faults. exceptions.ritz hands every user fault here first: while the test
# is armed this records the fault and resumes the test in the kernel through
# smp_test_resume_bsp; otherwise it returns false and the faulting process
# is killed as usual.
#
# A leaf module so exceptions.ritz can call it without importing cpu_smp.

import io { memory_barrier, rdmsr, interrupts_enabled, enable_interrupts }
import klog { klog, klog_dec, klog_hex }

extern fn smp_test_resume_bsp() -> u64
extern fn sysret_ring0_iret_probe(user_rip: u64, user_rsp: u64) -> u64
extern fn syscall_exit_iret()

const GS_BASE_MSR: u32 = 0xC0000101
const KERNEL_CS: u64 = 0x08
const GP_VECTOR: u64 = 13

var sysret_armed: u32 = 0
var sysret_caught: u32 = 0
var sysret_fault_vector: u64 = 0
var sysret_fault_rip: u64 = 0
var sysret_fault_cs: u64 = 0

pub fn sysret_catch_arm()
    sysret_caught = 0
    sysret_fault_vector = 0
    sysret_fault_rip = 0
    sysret_fault_cs = 0
    memory_barrier()
    sysret_armed = 1

pub fn sysret_catch_disarm()
    sysret_armed = 0

pub fn sysret_catch_caught() -> bool
    return sysret_caught != 0

pub fn sysret_catch_vector() -> u64
    return sysret_fault_vector

pub fn sysret_catch_rip() -> u64
    return sysret_fault_rip

pub fn sysret_catch_cs() -> u64
    return sysret_fault_cs

# A user fault (or a fault on syscall_exit_iret) while the self-test is
# armed: record it and resume the test. Returns false, doing nothing, when
# not armed.
pub fn sysret_selftest_catch(vector: u64, rip: u64, cs: u64) -> bool
    if sysret_armed == 0
        return false
    sysret_armed = 0
    sysret_fault_vector = vector
    sysret_fault_rip = rip
    sysret_fault_cs = cs
    sysret_caught = 1
    memory_barrier()
    smp_test_resume_bsp()
    return true

fn ring0_fail(why: StrView) -> bool
    klog("[sysret] FAILED: ")
    klog(why)
    klog("\n")
    return false

# #4610's ring-0 fixup on any CPU (AGAST #4612). A #GP on syscall_exit_iret
# comes with the kernel's CS after the exit's swapgs: the #GP stub must put
# this CPU's area back in GS and exceptions.ritz must take it as the user's
# fault. The real case (a non-canonical return RIP) only faults there under
# KVM or on hardware, so syscall_entry.s sysret_ring0_iret_probe makes the
# same IRETQ fault in ring 0 with a null SS, which every CPU checks before
# leaving ring 0, TCG included.
pub fn sysret_ring0_selftest() -> bool
    let area: u64 = rdmsr(GS_BASE_MSR)
    let had_if: bool = interrupts_enabled()
    sysret_catch_arm()
    sysret_ring0_iret_probe(0, 0)
    # Resumed by the catcher, IF=0 from the fault's gate.
    sysret_catch_disarm()
    let gs_after: u64 = rdmsr(GS_BASE_MSR)
    if had_if
        enable_interrupts()
    if sysret_caught == 0
        return ring0_fail("the ring-0 IRETQ fault was not caught")
    if sysret_fault_vector != GP_VECTOR or sysret_fault_rip != syscall_exit_iret as u64 or sysret_fault_cs != KERNEL_CS
        klog("[sysret] ring-0 probe caught vector ")
        klog_dec(sysret_fault_vector as i64)
        klog(" at RIP ")
        klog_hex(sysret_fault_rip)
        klog(" CS ")
        klog_hex(sysret_fault_cs)
        klog("\n")
        return ring0_fail("the ring-0 IRETQ fault was not vector 13 at syscall_exit_iret in ring 0")
    if gs_after != area
        return ring0_fail("GS is not back on this CPU's area after the ring-0 IRETQ fault")
    klog("[sysret] ring-0 IRETQ fault on syscall_exit_iret (null SS) caught: vector ")
    klog_dec(sysret_fault_vector as i64)
    klog(" at RIP ")
    klog_hex(sysret_fault_rip)
    klog(" CS ")
    klog_hex(sysret_fault_cs)
    klog(", GS back on this CPU's area\n")
    return true
