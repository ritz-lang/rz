# The "sysret" boot self-test's fault catcher (AGAST #4610)
#
# arch/x86_64/cpu_smp.ritz sysret_selftest makes a syscall return to a
# non-canonical RIP. syscall_entry.s sends that through its IRETQ exit, and
# the IRETQ (or, on a CPU that loads the RIP first, the fetch in ring 3)
# faults. exceptions.ritz hands every user fault here first: while the test
# is armed this records the fault and resumes the test in the kernel through
# smp_test_resume_bsp; otherwise it returns false and the faulting process
# is killed as usual.
#
# A leaf module so exceptions.ritz can call it without importing cpu_smp.

import io { memory_barrier }

extern fn smp_test_resume_bsp() -> u64

var sysret_armed: u32 = 0
var sysret_caught: u32 = 0
var sysret_fault_vector: u64 = 0
var sysret_fault_rip: u64 = 0
var sysret_fault_cs: u64 = 0

pub fn sysret_catch_arm()
    sysret_caught = 0
    sysret_fault_vector = 0
    sysret_fault_rip = 0
    sysret_fault_cs = 0
    memory_barrier()
    sysret_armed = 1

pub fn sysret_catch_disarm()
    sysret_armed = 0

pub fn sysret_catch_caught() -> bool
    return sysret_caught != 0

pub fn sysret_catch_vector() -> u64
    return sysret_fault_vector

pub fn sysret_catch_rip() -> u64
    return sysret_fault_rip

pub fn sysret_catch_cs() -> u64
    return sysret_fault_cs

# A user fault (or a fault on syscall_exit_iret) while the self-test is
# armed: record it and resume the test. Returns false, doing nothing, when
# not armed.
pub fn sysret_selftest_catch(vector: u64, rip: u64, cs: u64) -> bool
    if sysret_armed == 0
        return false
    sysret_armed = 0
    sysret_fault_vector = vector
    sysret_fault_rip = rip
    sysret_fault_cs = cs
    sysret_caught = 1
    memory_barrier()
    smp_test_resume_bsp()
    return true
