# IRQ stubs (32-47)
extern fn irq_stub_timer() -> i32
extern fn irq_stub_1() -> i32
extern fn irq_stub_2() -> i32
extern fn irq_stub_3() -> i32
extern fn irq_stub_4() -> i32
extern fn irq_stub_5() -> i32
extern fn irq_stub_6() -> i32
extern fn irq_stub_7() -> i32
extern fn irq_stub_8() -> i32
extern fn irq_stub_9() -> i32
extern fn irq_stub_10() -> i32
extern fn irq_stub_11() -> i32
extern fn irq_stub_12() -> i32
extern fn irq_stub_13() -> i32
extern fn irq_stub_14() -> i32
extern fn irq_stub_15() -> i32

# MSI-X stubs (vectors 64-79, drivers/msix.ritz)
extern fn irq_stub_32() -> i32
extern fn irq_stub_33() -> i32
extern fn irq_stub_34() -> i32
extern fn irq_stub_35() -> i32
extern fn irq_stub_36() -> i32
extern fn irq_stub_37() -> i32
extern fn irq_stub_38() -> i32
extern fn irq_stub_39() -> i32
extern fn irq_stub_40() -> i32
extern fn irq_stub_41() -> i32
extern fn irq_stub_42() -> i32
extern fn irq_stub_43() -> i32
extern fn irq_stub_44() -> i32
extern fn irq_stub_45() -> i32
extern fn irq_stub_46() -> i32
extern fn irq_stub_47() -> i32

# AP call and CPU-local device vectors (AGAST #4220)
extern fn irq_stub_48() -> i32
extern fn irq_stub_49() -> i32
extern fn irq_stub_50() -> i32
extern fn irq_stub_51() -> i32
extern fn irq_stub_52() -> i32
extern fn irq_stub_53() -> i32
extern fn irq_stub_54() -> i32
extern fn irq_stub_55() -> i32
extern fn irq_stub_56() -> i32
extern fn irq_stub_57() -> i32
extern fn irq_stub_58() -> i32
extern fn irq_stub_59() -> i32
extern fn irq_stub_60() -> i32
extern fn irq_stub_61() -> i32
extern fn irq_stub_62() -> i32
extern fn irq_stub_63() -> i32
extern fn irq_stub_64() -> i32
extern fn irq_stub_65() -> i32

# ============================================================================
# IDT Initialization
# ============================================================================

pub fn idt_init()
    # Zero out all entries first
    var i: i32 = 0
    while i < 256
        idt[i].offset_low = 0
        idt[i].selector = 0
        idt[i].ist = 0
        idt[i].type_attr = 0
        idt[i].offset_mid = 0
        idt[i].offset_high = 0
        idt[i].reserved = 0
        i = i + 1

    # Kernel code selector
    let cs: u16 = 0x08

    # Set up exception handlers (0-31)
    # Note: Vectors 8, 10-14, 17, 21, 29, 30 push an error code
    idt_set_gate(0, isr_stub_0 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(1, isr_stub_1 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(2, isr_stub_2 as u64, cs, 1, IDT_GATE_INTERRUPT)  # NMI uses IST1
    idt_set_gate(3, isr_stub_3 as u64, cs, 0, IDT_GATE_TRAP)       # Breakpoint is trap
    idt_set_gate(4, isr_stub_4 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(5, isr_stub_5 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(6, isr_stub_6 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(7, isr_stub_7 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(8, isr_stub_8 as u64, cs, 1, IDT_GATE_INTERRUPT)  # Double fault uses IST1
    idt_set_gate(9, isr_stub_9 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(10, isr_stub_10 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(11, isr_stub_11 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(12, isr_stub_12 as u64, cs, 1, IDT_GATE_INTERRUPT)  # Stack fault uses IST1
    idt_set_gate(13, isr_stub_13 as u64, cs, 1, IDT_GATE_INTERRUPT)  # GP fault uses IST1 for safety
    idt_set_gate(14, isr_stub_14 as u64, cs, 1, IDT_GATE_INTERRUPT)  # Page fault uses IST1 for safety
    idt_set_gate(15, isr_stub_15 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(16, isr_stub_16 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(17, isr_stub_17 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(18, isr_stub_18 as u64, cs, 1, IDT_GATE_INTERRUPT)  # Machine check uses IST1
    idt_set_gate(19, isr_stub_19 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(20, isr_stub_20 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(21, isr_stub_21 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(22, isr_stub_22 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(23, isr_stub_23 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(24, isr_stub_24 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(25, isr_stub_25 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(26, isr_stub_26 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(27, isr_stub_27 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(28, isr_stub_28 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(29, isr_stub_29 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(30, isr_stub_30 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(31, isr_stub_31 as u64, cs, 0, IDT_GATE_INTERRUPT)

    # Set up IRQ handlers (32-47)
    # The scheduler tick on IST3, other IRQs on IST2: neither lands on the
    # stack it interrupts (#3629). irq_stub_timer moves a ring-3 tick's frame
    # to the process's own kernel stack, where a preemption switch needs it.
    idt_set_gate(32, irq_stub_timer as u64, cs, 3, IDT_GATE_INTERRUPT)   # Timer uses IST3
    idt_set_gate(33, irq_stub_1 as u64, cs, 2, IDT_GATE_INTERRUPT)   # Keyboard uses IST2
    idt_set_gate(34, irq_stub_2 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(35, irq_stub_3 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(36, irq_stub_4 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(37, irq_stub_5 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(38, irq_stub_6 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(39, irq_stub_7 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(40, irq_stub_8 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(41, irq_stub_9 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(42, irq_stub_10 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(43, irq_stub_11 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(44, irq_stub_12 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(45, irq_stub_13 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(46, irq_stub_14 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(47, irq_stub_15 as u64, cs, 2, IDT_GATE_INTERRUPT)

    # MSI-X vectors (64-79): device interrupts like the IRQs above, so IST2
    idt_set_gate(64, irq_stub_32 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(65, irq_stub_33 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(66, irq_stub_34 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(67, irq_stub_35 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(68, irq_stub_36 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(69, irq_stub_37 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(70, irq_stub_38 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(71, irq_stub_39 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(72, irq_stub_40 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(73, irq_stub_41 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(74, irq_stub_42 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(75, irq_stub_43 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(76, irq_stub_44 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(77, irq_stub_45 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(78, irq_stub_46 as u64, cs, 2, IDT_GATE_INTERRUPT)
    idt_set_gate(79, irq_stub_47 as u64, cs, 2, IDT_GATE_INTERRUPT)

    # CPU-local device interrupts (#4220). No IST: an AP has no TSS, and the
    # interrupt is meant for the CPU that is waiting in a driver, where the
    # interrupted stack is the right one.
    idt_set_gate(80, irq_stub_49 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(81, irq_stub_50 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(82, irq_stub_51 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(83, irq_stub_52 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(84, irq_stub_53 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(85, irq_stub_54 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(86, irq_stub_55 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(87, irq_stub_56 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(88, irq_stub_57 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(89, irq_stub_58 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(90, irq_stub_59 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(91, irq_stub_60 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(92, irq_stub_61 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(93, irq_stub_62 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(94, irq_stub_63 as u64, cs, 0, IDT_GATE_INTERRUPT)
    idt_set_gate(95, irq_stub_64 as u64, cs, 0, IDT_GATE_INTERRUPT)

    # AP call IPI (#4220): runs on the AP's own stack.
    idt_set_gate(240, irq_stub_48 as u64, cs, 0, IDT_GATE_INTERRUPT)

    # LAPIC watchdog (#4220): one-shot timer wakeup, safe on any CPU.
    idt_set_gate(96, irq_stub_65 as u64, cs, 0, IDT_GATE_INTERRUPT)

    # Set up IDT descriptor
    idt_descriptor.size = (256 * 16 - 1) as u16
    idt_descriptor.offset = @idt[0] as u64

    # Load the IDT
    idt_load()

fn idt_load()
    let idt_ptr: *IdtDescriptor = @idt_descriptor
    var idt_ptr_val: u64 = idt_ptr as u64

    asm x86_64:
        movq {idt_ptr_val}, %rax
        lidt (%rax)

# Load the kernel IDT on this CPU. idt_init loads it on the BSP; an AP starts
# with no valid IDTR, so it must call this before it enables interrupts: the
# table is shared, but IDTR is per-CPU (AGAST #4192, #4220).
pub fn idt_load_current()
    idt_load()

# Note: exception_name() is defined in arch/x86_64/exceptions.ritz
