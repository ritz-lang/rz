# Harland IDT (Interrupt Descriptor Table) Implementation
#
# x86-64 IDT with 256 entries for:
# - CPU exceptions (0-31)
# - Hardware interrupts (32-47, remapped PIC or APIC)
# - Software interrupts (48-255)
#
# Each IDT entry is 16 bytes in 64-bit mode.

# ============================================================================
# Exception Vector Numbers
# ============================================================================

const EXCEPTION_DIVIDE_ERROR: u8 = 0
const EXCEPTION_DEBUG: u8 = 1
const EXCEPTION_NMI: u8 = 2
const EXCEPTION_BREAKPOINT: u8 = 3
const EXCEPTION_OVERFLOW: u8 = 4
const EXCEPTION_BOUND_RANGE: u8 = 5
const EXCEPTION_INVALID_OPCODE: u8 = 6
const EXCEPTION_DEVICE_NOT_AVAILABLE: u8 = 7
const EXCEPTION_DOUBLE_FAULT: u8 = 8
const EXCEPTION_COPROCESSOR_SEGMENT: u8 = 9
const EXCEPTION_INVALID_TSS: u8 = 10
const EXCEPTION_SEGMENT_NOT_PRESENT: u8 = 11
const EXCEPTION_STACK_SEGMENT_FAULT: u8 = 12
const EXCEPTION_GENERAL_PROTECTION: u8 = 13
const EXCEPTION_PAGE_FAULT: u8 = 14
const EXCEPTION_X87_FP: u8 = 16
const EXCEPTION_ALIGNMENT_CHECK: u8 = 17
const EXCEPTION_MACHINE_CHECK: u8 = 18
const EXCEPTION_SIMD_FP: u8 = 19
const EXCEPTION_VIRTUALIZATION: u8 = 20
const EXCEPTION_CONTROL_PROTECTION: u8 = 21
const EXCEPTION_HYPERVISOR_INJECTION: u8 = 28
const EXCEPTION_VMM_COMMUNICATION: u8 = 29
const EXCEPTION_SECURITY: u8 = 30

# IRQ base (after remapping PIC)
const IRQ_BASE: u8 = 32

# ============================================================================
# IDT Gate Types
# ============================================================================

const IDT_GATE_INTERRUPT: u8 = 0x8E    # Present, DPL=0, Interrupt Gate
const IDT_GATE_TRAP: u8 = 0x8F         # Present, DPL=0, Trap Gate
const IDT_GATE_USER: u8 = 0xEE         # Present, DPL=3, Interrupt Gate (syscall)

# ============================================================================
# IDT Entry Structure (16 bytes in 64-bit mode)
# ============================================================================

struct IdtEntry
    offset_low: u16     # Bits 0-15 of handler address
    selector: u16       # Code segment selector
    ist: u8             # Interrupt Stack Table index (0 = no IST)
    type_attr: u8       # Gate type and attributes
    offset_mid: u16     # Bits 16-31 of handler address
    offset_high: u32    # Bits 32-63 of handler address
    reserved: u32       # Must be zero

# ============================================================================
# IDT Descriptor (for LIDT instruction)
# ============================================================================

# Must be packed to match x86-64 hardware layout (10 bytes total)
[[packed]]
struct IdtDescriptor
    size: u16           # Size of IDT minus 1
    offset: u64         # Linear address of IDT

# ============================================================================
# Interrupt Frame (pushed by CPU and ISR stub)
# ============================================================================

struct InterruptFrame
    # Pushed by ISR stub
    r15: u64
    r14: u64
    r13: u64
    r12: u64
    r11: u64
    r10: u64
    r9: u64
    r8: u64
    rbp: u64
    rdi: u64
    rsi: u64
    rdx: u64
    rcx: u64
    rbx: u64
    rax: u64

    # Pushed by ISR stub (vector number and error code)
    vector: u64
    error_code: u64

    # Pushed by CPU
    rip: u64
    cs: u64
    rflags: u64
    rsp: u64
    ss: u64

# ============================================================================
# Global IDT Storage
# ============================================================================

# IDT with 256 entries
var idt: [256]IdtEntry

# IDT descriptor for LIDT
var idt_descriptor: IdtDescriptor

# ============================================================================
# IDT Helper Functions
# ============================================================================

fn idt_set_gate(vector: u8, handler: u64, selector: u16, ist: u8, type_attr: u8)
    let idx: i32 = vector as i32
    idt[idx].offset_low = (handler & 0xFFFF) as u16
    idt[idx].selector = selector
    idt[idx].ist = ist
    idt[idx].type_attr = type_attr
    idt[idx].offset_mid = ((handler >> 16) & 0xFFFF) as u16
    idt[idx].offset_high = ((handler >> 32) & 0xFFFFFFFF) as u32
    idt[idx].reserved = 0

# ============================================================================
# External ISR Stubs (defined in isr_stubs.s)
# ============================================================================

