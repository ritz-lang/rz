# Harland Microkernel - APIC (Advanced Programmable Interrupt Controller)
#
# Legacy PIC remap/disable, Local APIC, I/O APIC, and the AP (application
# processor) bootstrap: trampoline copy, INIT/SIPI, per-AP stacks and the
# started flags. Moved out of main.ritz unchanged (AGAST #2750, part of #1844).
#
# arch/x86_64/exceptions.ritz binds lapic_eoi by name with `extern fn`, and
# other modules import lapic_id, lapic_write and get_ap_stack_top; keep them
# `pub`. (The deleted sched/mod.ritz extern-declared lapic_write(reg: u32);
# the one definition is lapic_write(offset: u64, value: u32), #3629.)
#
# The LAPIC runs in x2APIC mode whenever the CPU has it (CPUID.1:ECX[21]):
# registers are MSRs 0x800 + offset/16, the ICR is one 64-bit MSR (0x830)
# with a 32-bit destination, so CPUs with APIC IDs past 255 (MADT type 9)
# can be started. Without x2APIC the MMIO xAPIC is used and such CPUs are
# skipped (#4184).

import ritzlib.result
import klog { klog, klog_dec, klog_hex }
import io { outb, inb, cpu_pause, rdmsr, wrmsr, cpuid, CpuidResult, enable_interrupts }
import arch.x86_64.tsc { delay_us, deadline_after_us, deadline_passed }
import arch.x86_64.tsc_calc { LAPIC_CAL_WINDOW_US, lapic_timer_hz, lapic_timer_initial }
import mm.pmm { Mb2BootInfo }
import boot_abi.handoff { HarlandBootInfo }
import mm.vmm { vmm_pml4_phys, vmm_map_mmio }
import drivers.acpi.tables { acpi_init_with_mb, acpi_init_from_bootinfo, local_apic_addr, io_apic_addr }
import arch.x86_64.cpu_map { MAX_CPUS, num_cpus, cpu_apic_ids, cpu_map_mark_started, cpu_map_started, cpu_map_needs_x2apic, cpu_map_boot_begin, cpu_map_boot_claim, cpu_map_boot_abandon }
import arch.x86_64.idt { idt_load_current }
import arch.x86_64.percpu { cpu_bringup, cpu_boot_stack_top, cpu_stack_alloc }
import arch.x86_64.cpu_smp { smp_ap_run, smp_ap_idle }
import arch.x86_64.irq_dest {
    irq_dest_pick, irq_ext_dest_from_cpuid, ioapic_rte_hi, ioapic_rte_dest, msi_addr_lo, IRQ_DEST_NONE,
    IOAPIC_RTE_LEVEL, ioapic_rte_mode, ioapic_has_eoi_reg, ioapic_needs_directed_eoi, ioapic_eoi_value
}
import drivers.iommu.ir { ir_init, ir_enabled, ir_x2apic, ir_set, ir_get_dest, ir_ioapic_sid, ir_ioapic_rte_hi, ir_ioapic_rte_lo, ir_ioapic_rte_handle, IR_NO_HANDLE }
import drivers.iommu.dmar { ir_handle_ioapic }

# ============================================================================
# PIC (Programmable Interrupt Controller) - Remap to vectors 32-47
# ============================================================================

pub fn pic_remap()
    # Save masks
    let mask1: u8 = inb(0x21)
    let mask2: u8 = inb(0xA1)

    # Start initialization sequence
    outb(0x20, 0x11)  # ICW1: init + ICW4 needed
    outb(0xA0, 0x11)

    # ICW2: Vector offsets
    outb(0x21, 0x20)  # PIC1 starts at vector 32
    outb(0xA1, 0x28)  # PIC2 starts at vector 40

    # ICW3: Cascade configuration
    outb(0x21, 0x04)  # PIC1: slave on IRQ2
    outb(0xA1, 0x02)  # PIC2: cascade identity

    # ICW4: 8086 mode
    outb(0x21, 0x01)
    outb(0xA1, 0x01)

    # Restore masks (mask all for now)
    outb(0x21, 0xFF)
    outb(0xA1, 0xFF)

# ============================================================================
# Local APIC
# ============================================================================

# LAPIC register offsets (memory-mapped)
const LAPIC_ID: u64 = 0x020          # APIC ID
const LAPIC_VERSION: u64 = 0x030     # Version
const LAPIC_TPR: u64 = 0x080         # Task Priority Register
const LAPIC_EOI: u64 = 0x0B0         # End of Interrupt
const LAPIC_LDR: u64 = 0x0D0         # Logical Destination
const LAPIC_DFR: u64 = 0x0E0         # Destination Format
const LAPIC_SVR: u64 = 0x0F0         # Spurious Interrupt Vector
const LAPIC_ESR: u64 = 0x280         # Error Status
const LAPIC_ICR_LO: u64 = 0x300      # Interrupt Command (low 32 bits)
const LAPIC_ICR_HI: u64 = 0x310      # Interrupt Command (high 32 bits)
const LAPIC_TIMER: u64 = 0x320       # Timer LVT
const LAPIC_THERMAL: u64 = 0x330     # Thermal LVT
const LAPIC_PERFCNT: u64 = 0x340     # Performance Counter LVT
const LAPIC_LINT0: u64 = 0x350       # LINT0 LVT
const LAPIC_LINT1: u64 = 0x360       # LINT1 LVT
const LAPIC_ERROR: u64 = 0x370       # Error LVT
const LAPIC_TIMER_INITIAL: u64 = 0x380  # Timer Initial Count
const LAPIC_TIMER_CURRENT: u64 = 0x390  # Timer Current Count
const LAPIC_TIMER_DIVIDE: u64 = 0x3E0   # Timer Divide Configuration

# LAPIC SVR flags
const LAPIC_SVR_ENABLE: u32 = 0x100  # Bit 8: Enable APIC
const LAPIC_SPURIOUS_VEC: u32 = 0xFF # Spurious vector (255)

# ============================================================================
# x2APIC mode
# ============================================================================

const CPUID1_ECX_X2APIC: u32 = 1 << 21   # CPUID.1:ECX[21]: x2APIC supported
const IA32_APIC_BASE: u32 = 0x1B         # IA32_APIC_BASE MSR
const APIC_BASE_ENABLE: u64 = 1 << 11    # EN: APIC globally enabled
const APIC_BASE_EXTD: u64 = 1 << 10      # EXTD: x2APIC mode
const X2APIC_MSR_BASE: u32 = 0x800       # MSR of xAPIC offset 0 (offset / 16 above)
const X2APIC_ICR: u32 = 0x830            # 64-bit ICR: destination in bits 63:32

# 1 once the BSP chose x2APIC mode (apic_select_mode); every AP follows it.
pub var x2apic_mode: u8 = 0

fn cpu_has_x2apic() -> bool
    let r: CpuidResult = cpuid(1)
    return (r.ecx & CPUID1_ECX_X2APIC) != 0

# Switch this CPU's LAPIC to x2APIC mode if the BSP chose it. Each CPU has
# its own IA32_APIC_BASE, and INIT leaves an AP's in xAPIC mode, so every
# AP calls this before it touches its LAPIC.
pub fn x2apic_enable_local()
    if x2apic_mode == 0
        return
    let base: u64 = rdmsr(IA32_APIC_BASE)
    if (base & APIC_BASE_EXTD) == 0
        wrmsr(IA32_APIC_BASE, base | APIC_BASE_ENABLE | APIC_BASE_EXTD)

# Choose the LAPIC mode on the BSP, after the MADT is parsed and before the
# LAPIC is first touched.
fn apic_select_mode()
    if cpu_has_x2apic()
        x2apic_mode = 1
        x2apic_enable_local()
        klog("      LAPIC mode: x2APIC\n")
    else
        klog("      LAPIC mode: xAPIC\n")
        if cpu_map_needs_x2apic() != 0
            klog("      WARNING: CPUs with APIC IDs > 255 need x2APIC; they stay off\n")
    # The BSP's ID, before ioapic_init routes the legacy IRQs to it: it is
    # not always 0 (#4233). ap_boot_all reads it again; it can't change.
    bsp_apic_id = lapic_id()
    bsp_apic_known = true
    irq_ext_dest_detect()
    # Interrupt remapping (VT-d #4316, AMD-Vi #4329: drivers/iommu/ir.ritz)
    # before the I/O APIC is programmed:
    # with it, every MSI and redirection entry goes through the table, and
    # in x2APIC mode reaches any APIC ID.
    ir_init(x2apic_mode != 0)
    irq_dest_print_mode()

# CPUID.1:ECX bit 31: running under a hypervisor (its leaves start at
# 0x40000000).
const CPUID1_ECX_HYPERVISOR: u32 = 0x80000000

# 1 if device interrupts can carry the extended destination ID (15-bit APIC
# IDs): KVM advertises it in CPUID 0x40000001 (arch/x86_64/irq_dest.ritz).
var irq_ext_dest: bool = false

fn irq_ext_dest_detect()
    irq_ext_dest = false
    let r1: CpuidResult = cpuid(1)
    if (r1.ecx & CPUID1_ECX_HYPERVISOR) != 0
        let sig: CpuidResult = cpuid(0x40000000)
        let feat: CpuidResult = cpuid(0x40000001)
        if irq_ext_dest_from_cpuid(sig.eax, sig.ebx, sig.ecx, sig.edx, feat.eax)
            irq_ext_dest = true

# How far device interrupts reach, for the boot log (the boot tests read it).
fn irq_dest_print_mode()
    if ir_x2apic()
        klog("      Device interrupt destinations: interrupt remapping (32-bit APIC IDs)\n")
    else if ir_enabled()
        klog("      Device interrupt destinations: 8-bit through interrupt remapping (xAPIC mode)\n")
    else if irq_ext_dest
        klog("      Device interrupt destinations: extended destination ID (APIC IDs up to 32767)\n")
    else
        klog("      Device interrupt destinations: 8-bit (APIC IDs up to 254; no interrupt remapping or extended destination ID)\n")

# The CPU a device interrupt (MSI or I/O APIC) meant for APIC ID `want`
# goes to: `want` if an interrupt message can reach it, else the BSP, else
# the first CPU that can be reached. IRQ_DEST_NONE if none can. drivers/msix
# calls this for the CPU it runs on.
pub fn irq_route_dest(want: u32) -> u32
    return irq_dest_pick(want, bsp_apic_id, @cpu_apic_ids[0], num_cpus as i32, irq_ext_dest and not ir_enabled(), ir_x2apic())

# Why irq_route_dest(id) isn't id.
pub fn irq_route_print_reason(apic_id: u32)
    if ir_x2apic()
        klog("the x2APIC broadcast ID")
    else if ir_enabled()
        klog("beyond the 8-bit destination of interrupt remapping in xAPIC mode")
    else if apic_id == 255
        klog("APIC ID 255 is the broadcast ID")
    else if irq_ext_dest
        klog("beyond the extended destination ID's 15 bits")
    else
        klog("beyond the 8-bit MSI/I/O APIC destination; no interrupt remapping or extended destination ID")

# Log every CPU whose device interrupts go elsewhere, and where.
fn irq_route_report()
    var i: i32 = 0
    while i < num_cpus as i32 && i < MAX_CPUS
        let id: u32 = cpu_apic_ids[i]
        let dest: u32 = irq_route_dest(id)
        if dest != id
            klog("    [irq] APIC ID ")
            klog_dec(id as i64)
            if dest == IRQ_DEST_NONE
                klog(": device interrupts have no reachable CPU (")
            else
                klog(": device interrupts -> APIC ID ")
                klog_dec(dest as i64)
                klog(" (MSI addr ")
                klog_hex(msi_addr_lo(dest) as u64)
                klog("): ")
            irq_route_print_reason(id)
            if dest == IRQ_DEST_NONE
                klog(")")
            klog("\n")
        i = i + 1

# Kernel virtual base of the LAPIC and I/O APIC register windows. Both are
# mapped once in apic_map_registers, through the kernel-half MMIO window
# (PML4[257]) that every process inherits; before AGAST #1878 they were
# identity-mapped below 1 GiB and read through the raw physical address.
# Under x2APIC the LAPIC is MSRs and these are unused (but harmless).
var lapic_mmio: u64 = 0
var ioapic_mmio: u64 = 0
# Destination ioapic_init programmed for the keyboard and COM1. A later
# route (the MADT override's pin) uses the same CPU.
var ioapic_bsp_dest: u32 = IRQ_DEST_NONE
# Its redirection entries, from IOAPIC_VER at ioapic_init.
var ioapic_pins: u32 = 0

# Map the LAPIC and I/O APIC registers through the MMIO window. Returns 0, or
# -1 on failure.
fn apic_map_registers() -> i32
    klog("    Mapping APIC regions...")
    if local_apic_addr != 0
        lapic_mmio = vmm_map_mmio(local_apic_addr, PAGE_SIZE)
        if lapic_mmio == 0
            klog(" LAPIC map failed!\n")
            return -1
    if io_apic_addr != 0
        ioapic_mmio = vmm_map_mmio(io_apic_addr, PAGE_SIZE)
        if ioapic_mmio == 0
            klog(" IOAPIC map failed!\n")
            return -1
    klog(" done\n")
    return 0

# Read LAPIC register
fn lapic_read(offset: u64) -> u32
    if x2apic_mode != 0
        return rdmsr(X2APIC_MSR_BASE + (offset >> 4) as u32) as u32
    let addr: *u32 = (lapic_mmio + offset) as *u32
    return *addr

# Write LAPIC register (pub for scheduler timer)
pub fn lapic_write(offset: u64, value: u32)
    if x2apic_mode != 0
        wrmsr(X2APIC_MSR_BASE + (offset >> 4) as u32, value as u64)
        return
    let addr: *u32 = (lapic_mmio + offset) as *u32
    *addr = value

# The mapped xAPIC ICR low word, for arch/x86_64/nmi_probe.ritz's self-NMI
# (AGAST #4612): 0 in x2APIC mode (the ICR is then MSR 0x830) or when the
# LAPIC is not mapped.
pub fn lapic_icr_lo_mmio() -> u64
    if x2apic_mode != 0 or lapic_mmio == 0
        return 0
    return lapic_mmio + LAPIC_ICR_LO

# Get current CPU's APIC ID (32 bits in x2APIC mode, 8 in xAPIC mode)
pub fn lapic_id() -> u32
    if x2apic_mode != 0
        return lapic_read(LAPIC_ID)
    return lapic_read(LAPIC_ID) >> 24

# Send EOI (End of Interrupt) to LAPIC
pub fn lapic_eoi()
    lapic_write(LAPIC_EOI, 0)

# One-shot LAPIC timer, used as a watchdog for a sleep that waits on a device
# interrupt (drivers/nvme, AGAST #4212): if the interrupt never comes, the
# timer still wakes the CPU.
#
# Vector 32 belongs to the scheduler tick (#3629). Before the tick starts (and
# always on an AP) the watchdog is a one-shot on vector 96, whose IDT gate has
# no IST, so an AP without a TSS can use it. Once lapic_timer_start has armed
# the periodic tick, the watchdog instead rides that tick: it counts tick
# periods down and never reprograms the timer, so it shares vector 32 without
# suspending preemption. (AGAST #4220.)
const LAPIC_WATCHDOG_VECTOR: u32 = 96
const LAPIC_TIMER_VECTOR: u32 = 32
const LAPIC_TIMER_MASKED: u32 = 0x10000
const LAPIC_TIMER_DIV16: u32 = 0x3

var lapic_watchdog_active: bool = false
var lapic_watchdog_oneshot: bool = false
var lapic_watchdog_ticks_left: u32 = 0

# Is this the bootstrap processor? Before ap_boot_all records the BSP's APIC
# ID every CPU is treated as the BSP (there are no APs yet).
pub fn lapic_is_bsp() -> bool
    if not bsp_apic_known
        return true
    return lapic_id() == bsp_apic_id

# Arm the watchdog for `ticks` (bus clock / 16) or, when the periodic tick is
# running on this CPU, for the same interval in scheduler ticks.
pub fn lapic_watchdog_arm(ticks: u32)
    lapic_watchdog_active = true
    if lapic_tick_initial != 0 and lapic_is_bsp()
        # Ride the periodic tick: convert bus-clock ticks to tick periods.
        var periods: u64 = 1
        if lapic_timer_rate_hz != 0 and lapic_tick_hz != 0
            periods = ((ticks as u64) * lapic_tick_hz + lapic_timer_rate_hz - 1) / lapic_timer_rate_hz
            if periods == 0
                periods = 1
        lapic_watchdog_oneshot = false
        if periods > 0xFFFFFFFF
            lapic_watchdog_ticks_left = 0xFFFFFFFF
        else
            lapic_watchdog_ticks_left = periods as u32
        return
    lapic_watchdog_oneshot = true
    lapic_watchdog_ticks_left = 0
    lapic_write(LAPIC_TIMER_DIVIDE, LAPIC_TIMER_DIV16)
    lapic_write(LAPIC_TIMER, LAPIC_WATCHDOG_VECTOR)
    lapic_write(LAPIC_TIMER_INITIAL, ticks)

# True once the armed interval has passed: the tick countdown reached 0
# (riding the tick), or the one-shot counted down to zero (it fired).
pub fn lapic_watchdog_expired() -> bool
    if not lapic_watchdog_active
        return false
    if lapic_watchdog_oneshot
        return lapic_read(LAPIC_TIMER_CURRENT) == 0
    return lapic_watchdog_ticks_left == 0

# One scheduler tick passed on this CPU: count it against the watchdog.
pub fn lapic_tick_advance()
    if lapic_watchdog_active and not lapic_watchdog_oneshot and lapic_watchdog_ticks_left > 0
        lapic_watchdog_ticks_left = lapic_watchdog_ticks_left - 1

# Stop the watchdog: a one-shot is masked, and the periodic tick is restored
# if this BSP had one (riding the tick never touched the timer).
pub fn lapic_watchdog_stop()
    if lapic_watchdog_oneshot
        lapic_write(LAPIC_TIMER_INITIAL, 0)
        lapic_write(LAPIC_TIMER, LAPIC_TIMER_MASKED)
        if lapic_is_bsp()
            lapic_timer_resume()
    lapic_watchdog_active = false
    lapic_watchdog_oneshot = false
    lapic_watchdog_ticks_left = 0

# ============================================================================
# Periodic scheduler tick (AGAST #3629)
# ============================================================================
#
# The LAPIC timer's rate is the bus clock's, which nothing enumerates: count
# it down (masked, divide by 16) over LAPIC_CAL_WINDOW_US timed by the TSC
# (tsc.ritz, #4181), then run it periodic on vector 32 at the tick rate
# asked for. irq_handler hands each tick to the scheduler (proc/sched.ritz).
# The NVMe watchdog borrows the same timer one-shot; lapic_watchdog_stop
# gives the tick back.

const LAPIC_TIMER_PERIODIC: u32 = 0x20000    # LVT timer mode bits 18:17 = 01
const LAPIC_COUNT_MAX: u32 = 0xFFFFFFFF

# The periodic tick's initial count; 0 while there is no tick.
var lapic_tick_initial: u32 = 0
var lapic_tick_hz: u64 = 0
var lapic_timer_rate_hz: u64 = 0

fn lapic_present() -> bool
    return x2apic_mode != 0 or local_apic_addr != 0

# The LAPIC timer's rate in Hz (divide by 16), measured over the TSC window.
fn lapic_timer_calibrate() -> u64
    lapic_write(LAPIC_TIMER_DIVIDE, LAPIC_TIMER_DIV16)
    lapic_write(LAPIC_TIMER, LAPIC_TIMER_MASKED)
    lapic_write(LAPIC_TIMER_INITIAL, LAPIC_COUNT_MAX)
    delay_us(LAPIC_CAL_WINDOW_US)
    let left: u32 = lapic_read(LAPIC_TIMER_CURRENT)
    lapic_write(LAPIC_TIMER_INITIAL, 0)
    return lapic_timer_hz((LAPIC_COUNT_MAX - left) as u64, LAPIC_CAL_WINDOW_US)

# Calibrate the timer and start a periodic tick_hz tick on vector 32 on this
# CPU. 0, or -1 (no LAPIC, or a timer that doesn't count: no tick).
pub fn lapic_timer_start(tick_hz: u64) -> i32
    if not lapic_present()
        klog("[timer] no LAPIC: no scheduler tick\n")
        return -1
    let hz: u64 = lapic_timer_calibrate()
    let initial: u32 = lapic_timer_initial(hz, tick_hz)
    if initial == 0
        klog("[timer] LAPIC timer did not count: no scheduler tick\n")
        return -1
    lapic_timer_rate_hz = hz
    lapic_tick_initial = initial
    lapic_tick_hz = tick_hz
    klog("[timer] LAPIC timer ")
    klog_dec(hz)
    klog(" Hz (bus/16, TSC-calibrated), periodic ")
    klog_dec(tick_hz)
    klog(" Hz tick, initial count ")
    klog_dec(initial as i64)
    klog("\n")
    lapic_timer_resume()
    return 0

# (Re)arm the periodic tick, if lapic_timer_start set one up.
pub fn lapic_timer_resume()
    if lapic_tick_initial == 0
        return
    lapic_write(LAPIC_TIMER_DIVIDE, LAPIC_TIMER_DIV16)
    lapic_write(LAPIC_TIMER, LAPIC_TIMER_VECTOR | LAPIC_TIMER_PERIODIC)
    lapic_write(LAPIC_TIMER_INITIAL, lapic_tick_initial)

# Stop this CPU's periodic tick (sched_stop): mask the timer and forget the
# tick, so lapic_timer_resume and a watchdog arm no longer ride it. A
# one-shot watchdog armed meanwhile owns the timer: left alone. Not while a
# watchdog rides the tick: its countdown would never reach 0.
pub fn lapic_timer_stop()
    if lapic_tick_initial == 0
        return
    lapic_tick_initial = 0
    lapic_tick_hz = 0
    if lapic_watchdog_active and lapic_watchdog_oneshot
        return
    lapic_write(LAPIC_TIMER_INITIAL, 0)
    lapic_write(LAPIC_TIMER, LAPIC_TIMER_MASKED)

# The calibrated LAPIC timer rate (divide by 16) in Hz; 0 before
# lapic_timer_start.
pub fn lapic_timer_rate() -> u64
    return lapic_timer_rate_hz

# Initialize Local APIC
fn lapic_init()
    # Enable LAPIC via SVR (Spurious Vector Register)
    # Set spurious vector to 0xFF and enable bit
    lapic_write(LAPIC_SVR, LAPIC_SVR_ENABLE | LAPIC_SPURIOUS_VEC)

    # Clear task priority to accept all interrupts
    lapic_write(LAPIC_TPR, 0)

    # Clear error status (write twice to clear)
    lapic_write(LAPIC_ESR, 0)
    lapic_write(LAPIC_ESR, 0)

    # Acknowledge any pending interrupts
    lapic_write(LAPIC_EOI, 0)

    # Set up timer - we'll configure this properly later
    # For now, mask it
    lapic_write(LAPIC_TIMER, 0x10000)  # Masked

    # Mask thermal, performance counter
    lapic_write(LAPIC_THERMAL, 0x10000)
    lapic_write(LAPIC_PERFCNT, 0x10000)

    # LINT0/LINT1 - keep default (ExtINT/NMI)
    lapic_write(LAPIC_LINT0, 0x08700)   # ExtINT, unmasked
    lapic_write(LAPIC_LINT1, 0x00400)   # NMI

    # Mask error LVT
    lapic_write(LAPIC_ERROR, 0x10000)

    # Clear error status again
    lapic_write(LAPIC_ESR, 0)

    klog("      LAPIC ID: ")
    klog_dec(lapic_id() as i64)
    klog(", Version: ")
    klog_hex(lapic_read(LAPIC_VERSION) as u64)
    klog("\n")

# ============================================================================
# I/O APIC
# ============================================================================

# I/O APIC registers
const IOAPIC_REGSEL: u64 = 0x00   # Register select
const IOAPIC_WINDOW: u64 = 0x10   # Register data window

# I/O APIC register indices
const IOAPIC_ID: u8 = 0x00
const IOAPIC_VER: u8 = 0x01
const IOAPIC_ARB: u8 = 0x02
const IOAPIC_REDTBL: u8 = 0x10    # Redirection table (0x10 + 2*n for entry n)

# EOI register (MMIO offset, version 20h and up): writing a vector clears
# Remote IRR on the level-triggered entries whose vector field it is.
const IOAPIC_EOI: u64 = 0x40

# Read I/O APIC register
fn ioapic_read(reg: u8) -> u32
    let regsel: *u32 = ioapic_mmio as *u32
    let window: *u32 = (ioapic_mmio + IOAPIC_WINDOW) as *u32
    *regsel = reg as u32
    return *window

# Write I/O APIC register
fn ioapic_write(reg: u8, value: u32)
    let regsel: *u32 = ioapic_mmio as *u32
    let window: *u32 = (ioapic_mmio + IOAPIC_WINDOW) as *u32
    *regsel = reg as u32
    *window = value

# The I/O APIC's own ID (IOAPIC_ID bits 27:24): DMAR names its source ID by it.
var ioapic_hw_id: u8 = 0
# Its version register: 20h and up have the EOI register.
var ioapic_version: u32 = 0

# Pins ioapic_eoi knows; past these an entry can't be addressed with u8
# register indices anyway.
const IOAPIC_MAX_PINS: u8 = 64
# What ioapic_eoi writes to the EOI register for each pin, or
# IOAPIC_NO_EOI when the LAPIC's EOI broadcast already matches the entry
# (edge, or the vector field is the vector). Set when the pin is set up, so
# the interrupt path reads no I/O APIC register.
const IOAPIC_NO_EOI: u16 = 0x100
var ioapic_pin_eoi: [64]u16

# Set up I/O APIC redirection entry `irq`: `vector` on APIC ID `dest_apic`,
# `mode` its trigger and polarity bits (irq_dest.ritz ioapic_rte_mode).
# Returns 0, or -1 with the entry left masked.
fn ioapic_set_irq_mode(irq: u8, vector: u8, dest_apic: u32, masked: bool, mode: u32) -> i32
    let reg_lo: u8 = IOAPIC_REDTBL + irq * 2
    let reg_hi: u8 = IOAPIC_REDTBL + irq * 2 + 1
    let level: bool = (mode & IOAPIC_RTE_LEVEL) != 0
    if irq < IOAPIC_MAX_PINS
        ioapic_pin_eoi[irq as i32] = IOAPIC_NO_EOI

    # With interrupt remapping (#4316) the entry names IRT entry `irq`, and
    # that entry the vector and the (32-bit) destination. Masked first, so
    # the pin never fires through a half-written entry.
    if ir_enabled()
        let handle: u32 = ir_handle_ioapic(irq as u32)
        let lo: u32 = ir_ioapic_rte_lo(vector, handle, masked) | mode
        ioapic_write(reg_lo, ir_ioapic_rte_lo(vector, handle, true) | mode)
        # Under AMD-Vi the vector field is the handle, so a level pin's
        # Remote IRR clears only through the EOI register (#4339).
        let directed: bool = ioapic_needs_directed_eoi(lo, vector)
        if directed and (irq >= IOAPIC_MAX_PINS or not ioapic_has_eoi_reg(ioapic_version))
            klog("      I/O APIC: IRQ ")
            klog_dec(irq as i64)
            klog(": level-triggered needs a directed EOI, which I/O APIC version ")
            klog_hex((ioapic_version & 0xFF) as u64)
            klog(" lacks; left masked\n")
            return -1
        if ir_set(handle, vector, dest_apic, level, ir_ioapic_sid(ioapic_hw_id)) != 0
            klog("      I/O APIC: IRQ ")
            klog_dec(irq as i64)
            klog(": IRTE not set; left masked\n")
            return -1
        if directed
            ioapic_pin_eoi[irq as i32] = ioapic_eoi_value(lo) as u16
        ioapic_write(reg_hi, ir_ioapic_rte_hi(handle))
        ioapic_write(reg_lo, lo)
        return 0

    # High 32 bits: destination APIC ID bits 7:0 in 31:24, and with the
    # extended destination ID bits 14:8 in 23:17 (irq_dest.ritz)
    ioapic_write(reg_hi, ioapic_rte_hi(dest_apic))

    # Low 32 bits:
    # Bits 0-7: Vector
    # Bit 8-10: Delivery mode (000 = Fixed)
    # Bit 11: Destination mode (0 = Physical)
    # Bit 12: Delivery status (read-only)
    # Bit 13: Pin polarity (0 = High active), from `mode`
    # Bit 14: Remote IRR (read-only)
    # Bit 15: Trigger mode (0 = Edge), from `mode`
    # Bit 16: Mask (1 = masked)
    var value: u32 = (vector as u32) | mode
    if masked
        value = value | 0x10000
    ioapic_write(reg_lo, value)

    return 0

# Set up an edge-triggered, active-high I/O APIC redirection entry.
fn ioapic_set_irq(irq: u8, vector: u8, dest_apic: u32, masked: bool) -> i32
    return ioapic_set_irq_mode(irq, vector, dest_apic, masked, ioapic_rte_mode(false, false))

pub enum IoapicRouteError
    # ioapic_init did not bring the I/O APIC up, or no CPU takes its
    # interrupts.
    NotUp
    # The pin is past the I/O APIC's last redirection entry.
    NoSuchPin
    # ioapic_set_irq_mode left the entry masked (no IRTE, or a level pin
    # that needs a directed EOI the I/O APIC lacks).
    Rejected

# Redirection entries the I/O APIC has (IOAPIC_VER bits 23:16, plus one);
# 0 before ioapic_init.
pub fn ioapic_pin_count() -> u32
    ioapic_pins

# Point `pin` at `vector` on the CPU ioapic_init chose, with the trigger
# and polarity of a MADT override.
pub fn ioapic_route_pin(pin: u8, vector: u8, level: bool, active_low: bool, masked: bool) -> Result<(), IoapicRouteError>
    if ioapic_mmio == 0 or ioapic_bsp_dest == IRQ_DEST_NONE
        return Err(IoapicRouteError.NotUp)
    if (pin as u32) >= ioapic_pins
        return Err(IoapicRouteError.NoSuchPin)
    let mode: u32 = ioapic_rte_mode(level, active_low)
    if ioapic_set_irq_mode(pin, vector, ioapic_bsp_dest, masked, mode) != 0
        return Err(IoapicRouteError.Rejected)
    Ok(())

# Set up a level-triggered I/O APIC redirection entry (PCI INTx pins are
# active low). Its handler ends with lapic_eoi() and then ioapic_eoi(irq).
# Returns 0, or -1 with the entry left masked: no IRTE, or (AMD-Vi) an
# I/O APIC without the EOI register.
pub fn ioapic_set_level_irq(irq: u8, vector: u8, dest_apic: u32, active_low: bool, masked: bool) -> i32
    return ioapic_set_irq_mode(irq, vector, dest_apic, masked, ioapic_rte_mode(true, active_low))

# After lapic_eoi() for level-triggered pin `irq`: when the LAPIC's EOI
# broadcast can't match the entry (AMD-Vi: its vector field is the IRTE
# handle), write that field to the EOI register, so Remote IRR clears and
# the pin can fire again. Returns 1 if it wrote, else 0.
pub fn ioapic_eoi(irq: u8) -> i32
    if irq >= IOAPIC_MAX_PINS
        return 0
    let v: u16 = ioapic_pin_eoi[irq as i32]
    if v == IOAPIC_NO_EOI
        return 0
    volatile_store((ioapic_mmio + IOAPIC_EOI) as *u32, v as u32)
    return 1

# Set pin `pin` up level-triggered and active low, masked (nothing drives
# it), read the entry back and log how its EOI goes, for
# tools/test_irq_dest_boot.sh (#4339):
#   I/O APIC: level pin P: entry vector E for vector V, directed|broadcast EOI
# then send that EOI once and put the pin back as ioapic_init left it.
fn ioapic_level_selftest(pin: u8, dest: u32)
    let vector: u8 = 32 + pin
    if ioapic_set_level_irq(pin, vector, dest, true, true) == 0
        let lo: u32 = ioapic_read(IOAPIC_REDTBL + pin * 2)
        klog("      I/O APIC: level pin ")
        klog_dec(pin as i64)
        if (lo & IOAPIC_RTE_LEVEL) == 0
            klog(": trigger mode didn't stick\n")
        else
            klog(": entry vector ")
            klog_dec((lo & 0xFF) as i64)
            klog(" for vector ")
            klog_dec(vector as i64)
            if ioapic_eoi(pin) != 0
                klog(", directed EOI\n")
            else
                klog(", broadcast EOI\n")
    ioapic_set_irq(pin, vector, 0, true)

# Initialize I/O APIC
fn ioapic_init() -> i32
    if io_apic_addr == 0
        klog("      No I/O APIC!\n")
        return -1

    ioapic_hw_id = ((ioapic_read(IOAPIC_ID) >> 24) & 0xF) as u8
    let version: u32 = ioapic_read(IOAPIC_VER)
    ioapic_version = version
    let max_irqs: u32 = ((version >> 16) & 0xFF) + 1
    ioapic_pins = max_irqs

    klog("      I/O APIC version: ")
    klog_hex((version & 0xFF) as u64)
    klog(", max IRQs: ")
    klog_dec(max_irqs as i64)
    klog("\n")

    # Mask all IRQs initially
    var i: u8 = 0
    while i < max_irqs as u8
        ioapic_set_irq(i, 32 + i, 0, true)  # Vector 32+, masked
        i = i + 1

    # The keyboard and COM1 go to the BSP: its APIC ID, which needn't be 0
    # (#4233). If no interrupt message can reach it (ID 255 or more, no
    # extended destination ID), to the first CPU one can.
    let dest: u32 = irq_route_dest(bsp_apic_id)
    if dest == IRQ_DEST_NONE
        klog("      No CPU can take I/O APIC interrupts (BSP APIC ID ")
        klog_dec(bsp_apic_id as i64)
        klog(": ")
        irq_route_print_reason(bsp_apic_id)
        klog("); IRQs stay masked\n")
        return -1
    if dest != bsp_apic_id
        klog("      BSP APIC ID ")
        klog_dec(bsp_apic_id as i64)
        klog(" can't take I/O APIC interrupts (")
        irq_route_print_reason(bsp_apic_id)
        klog(")\n")
    ioapic_bsp_dest = dest

    # Unmask keyboard (IRQ 1) - route to vector 33
    ioapic_set_irq(1, 33, dest, false)

    # Unmask COM1 (IRQ 4) - route to vector 36
    ioapic_set_irq(4, 36, dest, false)

    # Read the routing back: tools/test_irq_dest_boot.sh checks it names
    # the BSP's APIC ID.
    klog("      I/O APIC: IRQ 1 -> APIC ID ")
    klog_dec(ioapic_irq_dest(1) as i64)
    klog(", IRQ 4 -> APIC ID ")
    klog_dec(ioapic_irq_dest(4) as i64)
    if ir_enabled()
        klog(" (remapped: IRTE ")
        klog_dec(ir_ioapic_rte_handle(ioapic_read(IOAPIC_REDTBL + 3), ioapic_read(IOAPIC_REDTBL + 2)) as i64)
        klog(", ")
        klog_dec(ir_ioapic_rte_handle(ioapic_read(IOAPIC_REDTBL + 9), ioapic_read(IOAPIC_REDTBL + 8)) as i64)
        klog(")")
    klog("\n")

    # A level-triggered pin on the last PCI pin (#4339): how its EOI goes.
    if max_irqs > 16
        ioapic_level_selftest((max_irqs - 1) as u8, dest)

    return 0

# The APIC ID pin `irq` is sent to, read back from the hardware: the
# redirection entry, or in the remappable format the IRTE it names.
fn ioapic_irq_dest(irq: u8) -> u32
    let hi: u32 = ioapic_read(IOAPIC_REDTBL + irq * 2 + 1)
    let handle: u32 = ir_ioapic_rte_handle(hi, ioapic_read(IOAPIC_REDTBL + irq * 2))
    if handle != IR_NO_HANDLE
        return ir_get_dest(handle, ir_ioapic_sid(ioapic_hw_id))
    return ioapic_rte_dest(hi)

# Disable legacy 8259 PIC
fn pic_disable()
    # Mask all interrupts on both PICs
    outb(0xA1, 0xFF)
    outb(0x21, 0xFF)

# ============================================================================
# AP (Application Processor) Bootstrap
# ============================================================================

# AP bootstrap state. Each AP's "started" flag is cpu_map's, by CPU index
# (an APIC ID can be 16 or more: #1883).
# Each AP's stack is part of its eight-page per-CPU block (guard-paged kernel
# stack plus IST1/2/3, arch/x86_64/percpu.ritz), allocated when first asked
# for: a static [MAX_CPUS][...] would be a large BSS (#4184, #4192).
var ap_stack_tops: [64]u64      # Trampoline stack top by CPU index (0 = none)
var ap_count: u32 = 0           # Number of APs that have started
var bsp_apic_id: u32 = 0        # BSP's APIC ID
var bsp_apic_known: bool = false      # bsp_apic_id is recorded (0 is a valid ID)

# The stack top the AP trampoline starts an AP on: its per-CPU kernel stack's
# identity-mapped top (syscalls then use the kernel-half alias). 0 for an
# index out of range or if the PMM is out of pages.
pub fn get_ap_stack_top(cpu_idx: i32) -> u64
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return 0
    if ap_stack_tops[cpu_idx] == 0
        # Allocates the whole per-CPU block (four guard-paged stacks).
        if cpu_stack_alloc(cpu_idx) != 0
            ap_stack_tops[cpu_idx] = cpu_boot_stack_top(cpu_idx)
    return ap_stack_tops[cpu_idx]

# Trampoline code location (must be in low memory, <1MB)
const AP_TRAMPOLINE_ADDR: u64 = 0x8000
# The trampoline's parameter slots, at AP_TRAMPOLINE_ADDR + ap_trampoline.s's
# AP_PML4_OFFSET / AP_STACK_OFFSET / AP_ENTRY_OFFSET: the PML4 (u32), the
# stack top (u64) and the 64-bit entry point (u64). An AP takes its stack
# with an xchg that empties the slot, so no two CPUs ever run on one stack
# (#4140).
const AP_PML4_SLOT: u64 = 0x8FF0    # AP_TRAMPOLINE_ADDR + 0xFF0
const AP_STACK_SLOT: u64 = 0x8FF8   # AP_TRAMPOLINE_ADDR + 0xFF8
const AP_ENTRY_SLOT: u64 = 0x9000   # AP_TRAMPOLINE_ADDR + 0x1000

# External symbols from ap_trampoline.s
extern var ap_trampoline_start: u8
extern var ap_trampoline_end: u8

# INIT level de-assert (Intel SDM Vol. 3 §11.6.1): trigger mode level (bit
# 15, 0x8000), level de-assert (bit 14 clear), delivery mode INIT (0x500).
const ICR_INIT_DEASSERT: u32 = 0x8500

# IPI delivery modes
const IPI_DELIVERY_FIXED: u8 = 0
const IPI_DELIVERY_INIT: u8 = 5
const IPI_DELIVERY_SIPI: u8 = 6

# Write the ICR: destination APIC ID and the low 32 bits.
fn lapic_send_icr(dest_apic: u32, icr_lo: u32)
    if x2apic_mode != 0
        # One 64-bit MSR write sends it; there is no delivery-status bit.
        wrmsr(X2APIC_ICR, ((dest_apic as u64) << 32) | (icr_lo as u64))
        return

    # Wait for previous IPI to complete
    while (lapic_read(LAPIC_ICR_LO) & 0x1000) != 0
        cpu_pause()

    # Destination in ICR high bits 31:24 (8 bits: xAPIC)
    lapic_write(LAPIC_ICR_HI, (dest_apic & 0xFF) << 24)
    lapic_write(LAPIC_ICR_LO, icr_lo)

# Send IPI (Inter-Processor Interrupt)
fn lapic_send_ipi(dest_apic: u32, vector: u8, delivery_mode: u8)
    # ICR low:
    # Bits 0-7: Vector
    # Bits 8-10: Delivery mode (000=Fixed, 101=INIT, 110=Startup)
    # Bit 11: Destination mode (0=Physical)
    # Bit 12: Delivery status (read-only)
    # Bit 14: Level (1 for INIT)
    # Bit 15: Trigger mode (0=Edge, 1=Level)
    let icr_lo: u32 = (vector as u32) | ((delivery_mode as u32) << 8)
    lapic_send_icr(dest_apic, icr_lo)

# Send a fixed-delivery IPI carrying `vector` to one CPU. sync/mbox.ritz
# sends its kick with it (KICK_VECTOR, #4220, #4879).
pub fn lapic_send_fixed_ipi(dest_apic: u32, vector: u8)
    lapic_send_ipi(dest_apic, vector, IPI_DELIVERY_FIXED)

# Park this CPU for good: interrupts off, halt forever. An AP whose boot the
# BSP abandoned (or never opened) ends here, touching nothing shared (#4140).
fn ap_park()
    asm x86_64:
        cli
    while true
        asm x86_64:
            hlt

# AP entry point (called by ap_trampoline.s after transition to long mode)
pub fn ap_entry()
    # Follow the BSP into x2APIC mode before touching our LAPIC
    x2apic_enable_local()

    # EFER is per CPU and INIT clears it. vmm_init enabled no-execute pages
    # on the BSP, and the physmap's huge pages (and every 4 KiB mapping) set
    # the NX bit: with EFER.NXE clear, an NX entry is a reserved-bit
    # violation and an AP faults on its first physmap access (AGAST #4220).
    wrmsr(0xC0000080, rdmsr(0xC0000080) | 0x800)

    # Get our APIC ID
    let my_apic_id: u32 = lapic_id()

    # Claim the boot the BSP opened for this CPU, before touching anything
    # shared. It fails if the BSP already gave up on us (printed TIMEOUT and
    # moved on), never opened one (an APIC ID the MADT did not list), or we
    # already claimed it: then park, rather than run on per-CPU state the
    # BSP has written off (#4140). The claim's index is this CPU's index:
    # per-CPU state (GS area, TSS, IDT, SYSCALL MSRs and its own guard-paged
    # stacks) is indexed by it, never by the APIC ID.
    let my_index: i32 = cpu_map_boot_claim(my_apic_id)
    if my_index < 0
        ap_park()

    # Initialize our local APIC, as lapic_init does on the BSP. The timer is
    # masked: the scheduler tick runs on the BSP only (#4192).
    lapic_write(LAPIC_SVR, LAPIC_SVR_ENABLE | LAPIC_SPURIOUS_VEC)
    lapic_write(LAPIC_TPR, 0)
    lapic_write(LAPIC_ESR, 0)
    lapic_write(LAPIC_ESR, 0)
    lapic_write(LAPIC_EOI, 0)
    lapic_write(LAPIC_TIMER, LAPIC_TIMER_MASKED)

    # The IDTR is per CPU and was reset by INIT: without this, the first IPI
    # or device interrupt an AP takes is a triple fault. The IDT's gates for
    # an AP (the AP-call IPI, CPU-local MSI-X and the watchdog) use no IST,
    # so no TSS is needed (#4220).
    idt_load_current()

    # Print message (need mutex for serial, but for now just try)
    klog("    AP ")
    klog_dec(my_apic_id as i64)
    klog(" started!\n")

    # Bring the CPU up before marking it started: ap_boot_all returns once
    # the flag is set, and the BSP's SMP syscall self-test then expects this
    # CPU to be able to enter ring 3 on its own TSS and stacks.
    if cpu_bringup(my_index) != 0
        while true
            asm x86_64:
                hlt

    # Mark our CPU index as started (an unlisted APIC ID flags nothing)
    cpu_map_mark_started(my_apic_id)
    atomic_fetch_add(@ap_count as *u32, 1)   # every AP does this at once

    # Interrupts on before the self-test: a mailbox kick marks this CPU's
    # mailbox pending, and an NVMe completion interrupt meant for this CPU is
    # counted here (#4220, #4879).
    enable_interrupts()

    # The SMP syscall-stack self-test (AGAST #4192) enters ring 3 here when
    # the BSP starts it, and idles from its handler; otherwise this AP idles
    # here, on its bootstrap stack.
    smp_ap_run(my_index)

    # Wait for work: the mailbox (an AP call, a ping) and this CPU's NVMe
    # completions (#4220, #4879). Never returns.
    smp_ap_idle()

# Copy trampoline code to low memory and set up parameters
fn ap_setup_trampoline(stack_top: u64)
    # Calculate trampoline size
    let tramp_start: u64 = @ap_trampoline_start as u64
    let tramp_end: u64 = @ap_trampoline_end as u64
    let tramp_size: u64 = tramp_end - tramp_start

    # Copy trampoline to 0x8000
    var src: *u8 = tramp_start as *u8
    var dst: *u8 = AP_TRAMPOLINE_ADDR as *u8
    var i: u64 = 0
    while i < tramp_size
        *(dst + i as i64) = *(src + i as i64)
        i = i + 1

    # The trampoline's parameters (layout: ap_trampoline.s). The stack top
    # is the END of the AP's stack (stacks grow down).
    *(AP_PML4_SLOT as *u32) = vmm_pml4_phys as u32
    *(AP_STACK_SLOT as *u64) = stack_top
    *(AP_ENTRY_SLOT as *u64) = ap_entry as u64

# Boot a single AP
# cpu_idx is the AP's CPU index (cpu_map), whose started flag it sets.
fn ap_boot_one(apic_id: u32, cpu_idx: i32, stack_top: u64) -> i32
    klog("    Booting AP ")
    klog_dec(apic_id as i64)
    klog("...")

    # Set up trampoline for this AP, and open its boot for it to claim
    ap_setup_trampoline(stack_top)
    cpu_map_boot_begin(cpu_idx)

    # Send INIT IPI
    lapic_send_ipi(apic_id, 0, IPI_DELIVERY_INIT)
    delay_us(10000)  # 10ms delay

    # Send INIT de-assert (level=0, trigger=level). x2APIC mode has no
    # INIT level de-assert (and CPUs since the Pentium 4 ignore it).
    if x2apic_mode == 0
        lapic_send_icr(apic_id, ICR_INIT_DEASSERT)
    delay_us(200)

    # Send SIPI (Startup IPI) - vector is page number (0x08 for 0x8000)
    let sipi_vector: u8 = (AP_TRAMPOLINE_ADDR / 4096) as u8
    lapic_send_ipi(apic_id, sipi_vector, IPI_DELIVERY_SIPI)
    delay_us(200)

    # Send second SIPI (recommended by Intel)
    lapic_send_ipi(apic_id, sipi_vector, IPI_DELIVERY_SIPI)
    delay_us(200)

    # Wait up to 1 s for the AP to start
    let deadline: u64 = deadline_after_us(1000000)
    while cpu_map_started(cpu_idx) == 0 && not deadline_passed(deadline)
        cpu_pause()

    # Out of time: give up on the AP, unless it already claimed its boot.
    if cpu_map_started(cpu_idx) == 0
        if cpu_map_boot_abandon(cpu_idx)
            # It never claimed it: a late claim now fails and it parks. Take
            # the stack back too, so an AP still in real mode finds the slot
            # empty and halts in the trampoline.
            atomic_xchg(AP_STACK_SLOT as *u64, 0)
        else
            # It claimed the boot and is running (cpu_bringup): it owns its
            # stack and per-CPU state, so let it finish flagging started.
            let late: u64 = deadline_after_us(1000000)
            while cpu_map_started(cpu_idx) == 0 && not deadline_passed(late)
                cpu_pause()

    if cpu_map_started(cpu_idx) != 0
        klog(" OK\n")
        return 0
    else
        klog(" TIMEOUT\n")
        return -1

# Boot all APs
pub fn ap_boot_all()
    # Record BSP's APIC ID
    bsp_apic_id = lapic_id()
    bsp_apic_known = true

    klog("  [..] Boot APs\n")
    klog("    BSP APIC ID: ")
    klog_dec(bsp_apic_id as i64)
    klog("\n")

    # Started flags start clear: cpu_map_add clears each CPU's.
    # Boot each AP (skip BSP)
    var i: i32 = 0
    while i < num_cpus as i32 && i < MAX_CPUS
        let apic_id: u32 = cpu_apic_ids[i]
        if apic_id == bsp_apic_id
            i = i + 1
            continue
        # xAPIC's ICR destination is 8 bits: only x2APIC reaches IDs > 255.
        if x2apic_mode == 0 and apic_id > 255
            klog("    AP ")
            klog_dec(apic_id as i64)
            klog(" skipped (needs x2APIC)\n")
            i = i + 1
            continue
        # A PMM page per AP stack (get_ap_stack_top allocates it).
        let stack_top: u64 = get_ap_stack_top(i)
        if stack_top == 0
            klog("    No memory for AP stacks; stopping\n")
            break
        ap_boot_one(apic_id, i, stack_top)
        i = i + 1

    klog("  [OK] Boot APs (")
    klog_dec(ap_count as i64)
    klog(" APs started)\n")
    irq_route_report()

# Everything after ACPI parsing, shared by both boot paths: map the LAPIC and
# I/O APIC, pick xAPIC/x2APIC, bring up the BSP's LAPIC and the I/O APIC, and
# retire the legacy PIC. Returns 0, or -1 if the registers can't be mapped.
fn apic_bring_up() -> i32
    # Map Local APIC and I/O APIC through the kernel MMIO window
    if apic_map_registers() != 0
        return -1

    # xAPIC or x2APIC, before the LAPIC is first touched
    apic_select_mode()

    # Initialize Local APIC on BSP
    klog("    Initializing Local APIC...")
    lapic_init()
    klog(" done\n")

    # Initialize I/O APIC
    klog("    Initializing I/O APIC...")
    ioapic_init()
    klog(" done\n")

    # Disable legacy PIC
    klog("    Disabling legacy PIC...")
    pic_disable()
    klog(" done\n")

    klog("\r  [OK] ACPI/APIC\n")

    return 0

# Initialize APIC system (requires Multiboot info for ACPI tables)
pub fn apic_init_with_mb(mb_info: *Mb2BootInfo) -> i32
    klog("  [..] ACPI/APIC\n")

    # Parse ACPI tables to find APIC info
    let acpi_result: i32 = acpi_init_with_mb(mb_info)
    if acpi_result != 0
        klog("\r  [!!] ACPI/APIC (ACPI not found)\n")
        return -1

    return apic_bring_up()

# Initialize APIC from Harland boot info (UEFI boot path)
pub fn apic_init_from_bootinfo(info: *HarlandBootInfo) -> i32
    klog("  [..] ACPI/APIC\n")

    # Parse ACPI tables using RSDP from bootloader
    let acpi_result: i32 = acpi_init_from_bootinfo(info)
    if acpi_result != 0
        klog("\r  [!!] ACPI/APIC (ACPI not found)\n")
        return -1

    return apic_bring_up()
