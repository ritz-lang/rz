# Boot-time SMP syscall-stack self-test (AGAST #4192)
#
# Acceptance for the per-CPU syscall stacks: prove two CPUs take SYSCALL at
# once, each on its own per-CPU kernel stack, with its own saved user frame.
# The test runs after ap_boot_all, before /bin/init:
#
#   1. Map one ring-3 stub page and one user stack page per participating CPU
#      in the kernel's own PML4 (all CPUs share it here).
#   2. Every CPU enters the stub through jump_to_userspace with its own stack.
#      The stub SYSCALLs phase 1 and then phase 2.
#   3. In the phase-1 handler each CPU records its CPU index, its kernel
#      stack top (syscall_entry's PC_KSTACK_TOP) and its per-CPU area, then
#      waits until every participant is inside the handler. Two CPUs are
#      therefore in a syscall at the same instant.
#   4. Phase 2: the BSP resumes the kernel caller through
#      smp_test_resume_bsp (syscall_entry.s); an AP stays in the kernel on
#      its IST1 stack, in its idle loop (smp_ap_idle), so its mailbox (#4220's
#      AP call, #4879) and CPU-local device interrupts still reach it.
#   5. The BSP checks that the recorded stacks and areas are distinct and
#      prints the verdict the boot tests grep:
#        [smp] syscall stacks OK: N CPUs in ring-3 SYSCALL at once
#
# Before this change the BSP's user-frame globals and one shared TSS stack
# made step 3 impossible: the two CPUs overwrote each other's frame.

import klog { klog, klog_dec, klog_hex }
import io { memory_barrier, cpu_pause, rdmsr, interrupts_enabled, enable_interrupts }
import arch.x86_64.gdt { gdt_get_sysret_base, gdt_set_kernel_stack_cpu, gdt_user_segments_ok }
import arch.x86_64.sysret_catch { sysret_catch_arm, sysret_catch_disarm, sysret_catch_caught, sysret_catch_vector, sysret_catch_rip, sysret_catch_cs, sysret_ring0_selftest }
import mm.pmm { PAGE_SIZE, pmm_alloc_page }
import mm.vmm { PTE_USER, PTE_WRITABLE, phys_to_virt, vmm_map_page }
import arch.x86_64.cpu_map { MAX_CPUS, cpu_map_started }
import arch.x86_64.tsc { deadline_after_us, deadline_passed }
import arch.x86_64.percpu { CPU_IST1, cpu_area_for, cpu_index, cpu_kstack_top, cpu_stack_top }
import syscall.numbers { Syscall }
import syscall.errno { Errno }

# syscall_entry.s.
extern fn smp_test_enter_user(entry: u64, stack: u64) -> u64
extern fn smp_test_resume_bsp() -> u64
extern fn jump_to_userspace(entry: u64, stack: u64)
extern fn kstack_set_current(top: u64)
extern fn syscall_iret_exit_count() -> u64
# proc/sched.ritz: this AP's idle context, for good.
extern fn sched_ap_enter()

# The stub and its stacks, below the kernel half and clear of the user ELF
# (4 GiB) and user stack (top of the lower half). PML4 index 128.
const SMP_CODE_VA: u64 = 0x400000000000
const SMP_STACK_VA: u64 = 0x400000100000

# How long a CPU waits for the others to reach the syscall handler, and about
# how long an AP waits for the BSP to start the test. Generous: a loaded TCG
# host may run the vCPUs one at a time.
const SMP_BARRIER_US: u64 = 5000000
const SMP_START_US: u64 = 10000000

# The phase-1/phase-2 argument the stub passes in RDI.
const SMP_PHASE_PING: u64 = 1
const SMP_PHASE_DONE: u64 = 2
# The "sysret" self-test's phases (AGAST #4610): a round trip that must come
# back through SYSRETQ, then one whose return RIP the handler makes
# non-canonical, then DONE (reached only if that one came back).
const SYSRET_PHASE_PING: u64 = 3
const SYSRET_PHASE_BAD_RIP: u64 = 4

# The "sysret" self-test's stub and stack, next to the SMP test's.
const SYSRET_CODE_VA: u64 = 0x400000200000
const SYSRET_STACK_VA: u64 = 0x400000300000
# The first address past the lower canonical half (4-level paging).
const NONCANONICAL_RIP: u64 = 0x0000800000000000
const MSR_STAR: u32 = 0xC0000081
const STAR_SYSRET_BASE_SHIFT: u64 = 48
# syscall_entry.s's frame, from the kernel stack's top down: user RSP,
# RFLAGS, then the return RIP.
const FRAME_RIP_BELOW_TOP: u64 = 24

var smp_expected: u32 = 0            # CPUs that must reach the handler
var smp_in_syscall: u32 = 0          # how many are inside right now
var smp_participant: [64]u8          # by CPU index
var smp_seen_top: [64]u64            # recorded PC_KSTACK_TOP per CPU
var smp_seen_area: [64]u64           # recorded per-CPU area per CPU
var smp_go: u32 = 0                  # APs enter the stub when set
var smp_bsp_inside: u32 = 0          # 1 only while the BSP runs the test
var smp_barrier_deadline: u64 = 0
var smp_bsp_cpu: i32 = -1

var sysret_inside: u32 = 0           # 1 only while sysret_selftest runs
var sysret_cpu: i32 = -1
var sysret_pinged: u32 = 0
var sysret_iret_at_ping: u64 = 0     # syscall_iret_exits in each handler
var sysret_iret_at_bad: u64 = 0

# Write `mov $Syscall.Smp, %eax; mov $phase, %edi; syscall` at code + p.
# Returns the offset past it.
fn stub_syscall(code: *u8, p: i32, phase: u64) -> i32
    let nr: u8 = Syscall.Smp as u8
    var q: i32 = p
    # mov $nr, %eax
    *(code + q) = 0xB8
    *(code + q + 1) = nr
    *(code + q + 2) = 0
    *(code + q + 3) = 0
    *(code + q + 4) = 0
    q = q + 5
    # mov $phase, %edi
    *(code + q) = 0xBF
    *(code + q + 1) = phase as u8
    *(code + q + 2) = 0
    *(code + q + 3) = 0
    *(code + q + 4) = 0
    q = q + 5
    # syscall
    *(code + q) = 0x0F
    *(code + q + 1) = 0x05
    return q + 2

# Write the ring-3 stub: SYSCALL each phase in turn, then spin (never
# reached: the last phase does not return to ring 3). RAX = syscall number,
# RDI = phase. `phase3` 0 means two phases.
fn smp_write_stub(code: *u8, phase1: u64, phase2: u64, phase3: u64)
    var p: i32 = stub_syscall(code, 0, phase1)
    p = stub_syscall(code, p, phase2)
    if phase3 != 0
        p = stub_syscall(code, p, phase3)
    # jmp .
    *(code + p) = 0xEB
    *(code + p + 1) = 0xFE

# A zeroed, user-mapped page at `va`. Returns its physical address, or 0.
fn smp_map_user_page(va: u64) -> u64
    let phys: u64 = pmm_alloc_page()
    if phys == 0
        return 0
    let p: *u64 = phys_to_virt(phys) as *u64
    var i: i32 = 0
    while i < 512
        *(p + i as i64) = 0
        i = i + 1
    if vmm_map_page(va, phys, PTE_USER | PTE_WRITABLE) != 0
        return 0
    return phys

fn smp_stack_va(cpu_idx: i32) -> u64
    return SMP_STACK_VA + (cpu_idx as u64) * PAGE_SIZE

# The kernel's SMP stack self-test. Call after ap_boot_all, before init.
# Returns 0 when at least two CPUs were in SYSCALL at once on distinct
# stacks, 1 otherwise (and prints why).
pub fn smp_syscall_selftest(bsp_cpu: i32) -> i32
    smp_bsp_cpu = bsp_cpu
    if bsp_cpu < 0 or bsp_cpu >= MAX_CPUS
        bsp_cpu = 0
        smp_bsp_cpu = 0

    # Participants: the BSP and every AP that flagged itself started.
    smp_participant[bsp_cpu] = 1
    var expected: u32 = 1
    var cpu: i32 = 0
    while cpu < MAX_CPUS
        if cpu != bsp_cpu and cpu_map_started(cpu) != 0
            smp_participant[cpu] = 1
            expected = expected + 1
        cpu = cpu + 1
    smp_expected = expected
    if expected < 2
        klog("[smp] single CPU: per-CPU syscall stack test skipped\n")
        return 0

    # One stub page, and one stack page per participant.
    let code_phys: u64 = smp_map_user_page(SMP_CODE_VA)
    if code_phys == 0
        klog("[smp] cannot map the syscall test stub\n")
        return 1
    smp_write_stub(phys_to_virt(code_phys) as *u8, SMP_PHASE_PING, SMP_PHASE_DONE, 0)
    cpu = 0
    while cpu < MAX_CPUS
        if smp_participant[cpu] != 0
            if smp_map_user_page(smp_stack_va(cpu)) == 0
                klog("[smp] cannot map CPU ")
                klog_dec(cpu as i64)
                klog("'s test stack\n")
                return 1
        cpu = cpu + 1

    # Let every AP enter the stub, then enter it here.
    smp_barrier_deadline = deadline_after_us(SMP_BARRIER_US)
    memory_barrier()
    smp_bsp_inside = 1
    atomic_store(@smp_go as *u32, 1)
    memory_barrier()
    let bsp_stack: u64 = smp_stack_va(bsp_cpu) + PAGE_SIZE - 16
    smp_test_enter_user(SMP_CODE_VA, bsp_stack)
    # Past this point SYS_SMP is not a user ABI: the handler answers ENOSYS
    # (and halts an AP still finishing phase 2).
    smp_bsp_inside = 0

    # Back in the kernel: every participant recorded its own stack and area.
    let seen: u32 = atomic_load(@smp_in_syscall as *u32)
    if seen != expected
        klog("[smp] syscall stacks FAILED: ")
        klog_dec(seen as i64)
        klog(" of ")
        klog_dec(expected as i64)
        klog(" CPUs reached the syscall handler together\n")
        return 1

    var i: i32 = 0
    while i < MAX_CPUS
        if smp_participant[i] != 0
            if smp_seen_top[i] == 0 or smp_seen_area[i] == 0
                klog("[smp] syscall stacks FAILED: CPU ")
                klog_dec(i as i64)
                klog(" recorded no frame\n")
                return 1
            var j: i32 = 0
            while j < i
                if smp_participant[j] != 0
                    if smp_seen_top[i] == smp_seen_top[j]
                        klog("[smp] syscall stacks FAILED: CPUs ")
                        klog_dec(j as i64)
                        klog(" and ")
                        klog_dec(i as i64)
                        klog(" share a kernel stack\n")
                        return 1
                    if smp_seen_area[i] == smp_seen_area[j]
                        klog("[smp] syscall stacks FAILED: CPUs ")
                        klog_dec(j as i64)
                        klog(" and ")
                        klog_dec(i as i64)
                        klog(" share a per-CPU area\n")
                        return 1
                j = j + 1
        i = i + 1

    klog("[smp] syscall stacks OK: ")
    klog_dec(expected as i64)
    klog(" CPUs in ring-3 SYSCALL at once, distinct per-CPU stacks and frames\n")
    return 0

# An AP's idle loop: it never returns. After the self-test it runs inside
# the Smp syscall handler on the IST1 stack smp_ap_run selected (an AP that
# missed the test runs it from ap_entry on its bootstrap stack). It must not
# halt for good: the mailbox (an AP call, a ping) and CPU-local device
# interrupts are what an AP does after boot, and both need a CPU that wakes
# for interrupts.
#
# Each round is the idle handshake (sync/idle.ritz, SMP_USER.md §4): with
# IF=0 announce idle, re-check the mailbox, then either drain it (the safe
# point: no ISR in service and no kernel code half done) or sleep in
# sti;hlt. A kick that lands between the re-check and the hlt is held
# pending while IF=0 and wakes the hlt, so no message waits for the next
# interrupt. The drain runs AP calls with IF=1 (apcall.ritz ap_call_run).
#
# Since AGAST #4881 that loop is the scheduler's (proc/sched.ritz
# sched_idle_main), on this AP's own idle context: the same handshake, with
# the processes homed on this AP in its re-check. Declared, not imported:
# proc/sched.ritz reaches this module through apic.ritz.
pub fn smp_ap_idle()
    sched_ap_enter()

# An AP's side: wait for the BSP to start the test, then enter the stub on
# this CPU's own user stack. Returns with an error if the test never starts.
pub fn smp_ap_run(cpu_idx: i32) -> i32
    let deadline: u64 = deadline_after_us(SMP_START_US)
    # An AP that started after the BSP counted the participants has no stub
    # stack mapped: do not enter ring 3.
    while atomic_load(@smp_go as *u32) == 0
        if deadline_passed(deadline)
            return -1
        cpu_pause()
    memory_barrier()
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS or smp_participant[cpu_idx] == 0
        return -1
    # The test's syscalls run on this CPU's IST1 stack, clear of the bootstrap
    # stack the trampoline started us on: after phase 2 the AP idles there
    # (smp_ap_idle), ready for its mailbox.
    # TSS.rsp0 too: a ring-3 #PF or #GP lands there (no IST, AGAST #4628),
    # and this CPU's kernel stack is its bootstrap stack's page.
    kstack_set_current(cpu_stack_top(cpu_idx, CPU_IST1))
    gdt_set_kernel_stack_cpu(cpu_idx, cpu_stack_top(cpu_idx, CPU_IST1))
    let stack: u64 = smp_stack_va(cpu_idx) + PAGE_SIZE - 16
    jump_to_userspace(SMP_CODE_VA, stack)
    return 0

# The syscall handler (registered as Syscall.Smp). Phase 1 records and
# barriers; phase 2 leaves ring 3 for good on this CPU.
pub fn sys_smp_test_handler(phase: u64, a2: u64, a3: u64, a4: u64) -> i64
    let cpu: i32 = cpu_index()
    if cpu < 0 or cpu >= MAX_CPUS
        return 0
    if sysret_inside != 0 and cpu == sysret_cpu
        return sysret_test_phase(phase)
    if smp_bsp_inside == 0
        # Outside the boot self-test SYS_SMP is not a user ABI. An AP can
        # only be our stub finishing phase 2 (the BSP resumed first): let it
        # idle, ready for its mailbox and device interrupts. A user
        # program on the BSP gets ENOSYS instead of the test's resume
        # mechanism.
        if cpu != smp_bsp_cpu
            smp_ap_idle()
        return Errno.NoSys as i64
    if phase == SMP_PHASE_PING
        smp_seen_top[cpu] = cpu_kstack_top()
        smp_seen_area[cpu] = cpu_area_for(cpu)
        memory_barrier()
        atomic_fetch_add(@smp_in_syscall as *u32, 1)
        while atomic_load(@smp_in_syscall as *u32) < smp_expected
            if deadline_passed(smp_barrier_deadline)
                return 0
            cpu_pause()
        return 0
    # Phase 2: the BSP continues in the kernel test; an AP is done running
    # user code and idles in the kernel with interrupts on.
    if cpu == smp_bsp_cpu
        smp_test_resume_bsp()
        return 0
    smp_ap_idle()
    return 0

# ============================================================================
# The "sysret" boot self-test (AGAST #4610)
# ============================================================================
# syscall_entry.s returns to ring 3 with SYSRETQ, which needs STAR[63:48] =
# gdt.ritz GDT_SYSRET_BASE and the GDT in user data, user code order, and
# with IRETQ when the return RIP is non-canonical (SYSRETQ to one #GPs in
# ring 0 on Intel CPUs, with the user's RSP). This runs a ring-3 stub on
# this CPU through both exits:
#
#   1. PING: the handler notes syscall_iret_exits; the stub only reaches
#      phase 2 if the return to ring 3 worked.
#   2. BAD_RIP: the handler checks syscall_iret_exits did not move (PING
#      came back through SYSRETQ), overwrites the frame's return RIP with
#      NONCANONICAL_RIP and arms arch/x86_64/sysret_catch.ritz. The exit
#      must take the IRETQ path, which faults; exceptions.ritz hands the
#      fault to the catcher, and it resumes us here.
#   3. DONE: only reached if phase 2 came back to ring 3 somehow. Resumes
#      us here with nothing caught: a failure.
fn sysret_test_phase(phase: u64) -> i64
    if phase == SYSRET_PHASE_PING
        sysret_iret_at_ping = syscall_iret_exit_count()
        sysret_pinged = 1
        return 0
    if phase == SYSRET_PHASE_BAD_RIP
        sysret_iret_at_bad = syscall_iret_exit_count()
        let rip_slot: *u64 = (cpu_kstack_top() - FRAME_RIP_BELOW_TOP) as *u64
        *rip_slot = NONCANONICAL_RIP
        sysret_catch_arm()
        return 0
    # DONE, or anything else: leave ring 3 for the test's caller.
    sysret_catch_disarm()
    smp_test_resume_bsp()
    return 0

fn sysret_fail(why: StrView) -> bool
    klog("[sysret] FAILED: ")
    klog(why)
    klog("\n")
    return false

pub fn sysret_selftest() -> bool
    let base: u64 = rdmsr(MSR_STAR) >> STAR_SYSRET_BASE_SHIFT
    if base != gdt_get_sysret_base() as u64
        klog("[sysret] STAR[63:48] = ")
        klog_hex(base)
        klog("\n")
        return sysret_fail("STAR[63:48] is not GDT_SYSRET_BASE")
    if not gdt_user_segments_ok()
        return sysret_fail("GDT is not user data then 64-bit user code")

    let code_phys: u64 = smp_map_user_page(SYSRET_CODE_VA)
    if code_phys == 0 or smp_map_user_page(SYSRET_STACK_VA) == 0
        return sysret_fail("cannot map the test stub")
    smp_write_stub(phys_to_virt(code_phys) as *u8, SYSRET_PHASE_PING, SYSRET_PHASE_BAD_RIP, SMP_PHASE_DONE)

    let had_if: bool = interrupts_enabled()
    sysret_pinged = 0
    sysret_cpu = cpu_index()
    memory_barrier()
    sysret_inside = 1
    smp_test_enter_user(SYSRET_CODE_VA, SYSRET_STACK_VA + PAGE_SIZE - 16)
    # Resumed by the catcher (or by DONE), with IF=0 from the fault's gate.
    sysret_inside = 0
    sysret_catch_disarm()
    if had_if
        enable_interrupts()
    let iret_after: u64 = syscall_iret_exit_count()

    if sysret_pinged == 0
        return sysret_fail("the stub never made its first syscall")
    if sysret_iret_at_bad != sysret_iret_at_ping
        return sysret_fail("a canonical return went through IRETQ, not SYSRETQ")
    if not sysret_catch_caught()
        return sysret_fail("a non-canonical return RIP came back to ring 3")
    if iret_after != sysret_iret_at_bad + 1
        return sysret_fail("a non-canonical return RIP did not take the IRETQ exit")
    klog("[sysret] SYSRETQ fast path OK; non-canonical return RIP took IRETQ, caught vector ")
    klog_dec(sysret_catch_vector() as i64)
    klog(" at RIP ")
    klog_hex(sysret_catch_rip())
    klog(" CS ")
    klog_hex(sysret_catch_cs())
    klog("\n")
    # And the ring-0 fault on syscall_exit_iret, on any CPU (AGAST #4612).
    return sysret_ring0_selftest()
