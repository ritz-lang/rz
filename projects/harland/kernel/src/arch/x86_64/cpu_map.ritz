# Harland CPU map: CPU index <-> Local APIC ID (AGAST #1883)
#
# A CPU index is a CPU's position in the MADT's Local APIC list (firmware
# order, 0 .. num_cpus-1). Every per-CPU array (cpu_sched, cpu_started)
# is indexed by CPU index, never by APIC ID (ap_stacks by AP ordinal): APIC IDs are sparse
# (QEMU -smp sockets=2,cores=3 gives 0,1,2,4) and reach 16 and above on
# larger EC2 instances and on AMD, so an APIC-ID index runs off a [16] array.
#
# MAX_CPUS is the one spelling of the CPU limit; CPUs past it are not used.
# APIC IDs are 32 bits: x2APIC CPUs (MADT type 9) have IDs past 255 (#4184).
# No imports, no hardware access: the host tests compile this module as is
# (projects/ritz/ritz0/test_harland_cpu_map.py).

pub const MAX_CPUS: i32 = 64

# CPUs recorded from the MADT, and each one's Local APIC ID.
# The array sizes are MAX_CPUS (array lengths must be literals); so is
# every other per-CPU array (sched's cpu_sched, apic's ap_stack_tops), and
# test_harland_cpu_map.py checks they agree.
pub var num_cpus: u32 = 0
pub var cpu_apic_ids: [64]u32

# Per-CPU "AP has started" flags, set by the AP itself (ap_entry).
var cpu_started: [64]u8

# Per-CPU AP boot handshake (AGAST #4140). The BSP opens a CPU's boot before
# INIT (BOOT_OPEN); the AP claims it first thing in ap_entry (OPEN ->
# CLAIMED); a BSP that times out abandons it (OPEN -> ABANDONED). Both moves
# are one compare-and-swap on the same byte, so exactly one side wins: an AP
# that starts after the BSP gave up finds its boot abandoned and parks.
const BOOT_CLOSED: u8 = 0
const BOOT_OPEN: u8 = 1
const BOOT_CLAIMED: u8 = 2
const BOOT_ABANDONED: u8 = 3
var cpu_boot_state: [64]u8

# MADT entry types that describe a CPU (ACPI 6.5, 5.2.12.2 and 5.2.12.12).
const MADT_TYPE_LOCAL_APIC: u8 = 0      # 8 bytes: type, len, uid, apic_id(u8), flags(u32)
const MADT_TYPE_LOCAL_X2APIC: u8 = 9    # 16 bytes: type, len, rsvd(2), x2apic_id(u32), flags(u32), uid(u32)
# Flags: bit 0 Enabled, bit 1 Online Capable (either means the CPU can run).
const MADT_CPU_USABLE: u32 = 3

# Forget every CPU (before the MADT is parsed).
pub fn cpu_map_reset() -> i32
    num_cpus = 0
    var i: i32 = 0
    while i < MAX_CPUS
        cpu_apic_ids[i] = 0
        cpu_started[i] = 0
        cpu_boot_state[i] = BOOT_CLOSED
        i = i + 1
    return 0

# Record a CPU; returns its CPU index, or -1 once MAX_CPUS are recorded.
pub fn cpu_map_add(apic_id: u32) -> i32
    if num_cpus as i32 >= MAX_CPUS
        return -1
    let idx: i32 = num_cpus as i32
    cpu_apic_ids[idx] = apic_id
    cpu_started[idx] = 0
    cpu_boot_state[idx] = BOOT_CLOSED
    num_cpus = num_cpus + 1
    return idx

# A little-endian u32 at p (MADT entries are packed: no alignment).
fn read_u32_le(p: *u8) -> u32
    return (*p as u32) | ((*(p + 1) as u32) << 8) | ((*(p + 2) as u32) << 16) | ((*(p + 3) as u32) << 24)

# Record the CPU a MADT entry describes: type 0 (Local APIC) or type 9
# (Local x2APIC), if it is enabled or online-capable. Returns the CPU's
# index, or -1 for any other entry, an unusable or short one, or once
# MAX_CPUS are recorded. A CPU firmware lists twice (as type 0 and as
# type 9) keeps its first index.
pub fn cpu_map_add_madt_entry(entry: *u8) -> i32
    let kind: u8 = *entry
    let len: u8 = *(entry + 1)
    var apic_id: u32 = 0
    var flags: u32 = 0
    if kind == MADT_TYPE_LOCAL_APIC
        if len < 8
            return -1
        apic_id = *(entry + 3) as u32
        flags = read_u32_le(entry + 4)
    else if kind == MADT_TYPE_LOCAL_X2APIC
        if len < 16
            return -1
        apic_id = read_u32_le(entry + 4)
        flags = read_u32_le(entry + 8)
    else
        return -1
    if (flags & MADT_CPU_USABLE) == 0
        return -1
    let known: i32 = cpu_index_of_apic_id(apic_id)
    if known >= 0
        return known
    # CPUs past MAX_CPUS are refused (-1) and left unused.
    return cpu_map_add(apic_id)

# 1 if a recorded APIC ID doesn't fit xAPIC's 8-bit destination (only
# x2APIC mode can send it an IPI), else 0.
pub fn cpu_map_needs_x2apic() -> i32
    var i: i32 = 0
    while i < num_cpus as i32 && i < MAX_CPUS
        if cpu_apic_ids[i] > 255
            return 1
        i = i + 1
    return 0

# The CPU index of the CPU with this APIC ID, or -1 if it isn't recorded.
pub fn cpu_index_of_apic_id(apic_id: u32) -> i32
    var i: i32 = 0
    while i < num_cpus as i32 && i < MAX_CPUS
        if cpu_apic_ids[i] == apic_id
            return i
        i = i + 1
    return -1

# Called by an AP once it runs: flags its CPU index as started.
# Returns that index, or -1 for an APIC ID that isn't recorded (nothing set).
pub fn cpu_map_mark_started(apic_id: u32) -> i32
    let idx: i32 = cpu_index_of_apic_id(apic_id)
    if idx >= 0
        atomic_store(@cpu_started[idx] as *u8, 1)
    return idx

# 1 if the CPU at this index has flagged itself started, else 0.
pub fn cpu_map_started(cpu_idx: i32) -> i32
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return 0
    return atomic_load(@cpu_started[cpu_idx] as *u8) as i32

# BSP, before it sends INIT: open this CPU's boot for its AP to claim.
# Returns 0, or -1 for an index outside the table.
pub fn cpu_map_boot_begin(cpu_idx: i32) -> i32
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return -1
    atomic_store(@cpu_boot_state[cpu_idx] as *u8, BOOT_OPEN)
    return 0

# AP, first thing in ap_entry: claim the boot the BSP opened for this APIC ID.
# Returns the CPU index if this AP may run; -1 if its boot was never opened,
# was already claimed, or the BSP abandoned it (the caller parks).
pub fn cpu_map_boot_claim(apic_id: u32) -> i32
    let idx: i32 = cpu_index_of_apic_id(apic_id)
    if idx < 0
        return -1
    let was: u8 = atomic_cmpxchg(@cpu_boot_state[idx] as *u8, BOOT_OPEN, BOOT_CLAIMED)
    if was != BOOT_OPEN
        return -1
    return idx

# BSP, when its wait for the AP runs out: abandon the boot. True if the AP
# had not claimed it (a late claim now fails, so the AP parks); false if
# the AP already claimed it and is running (wait for it to flag started).
pub fn cpu_map_boot_abandon(cpu_idx: i32) -> bool
    if cpu_idx < 0 or cpu_idx >= MAX_CPUS
        return false
    let was: u8 = atomic_cmpxchg(@cpu_boot_state[cpu_idx] as *u8, BOOT_OPEN, BOOT_ABANDONED)
    return was == BOOT_OPEN
