# The linker-script subset rld reads (../razm/DESIGN.md "Linker scripts"):
#
#   OUTPUT_FORMAT(elf64-x86-64)   OUTPUT_ARCH(i386:x86-64)   ENTRY(sym)
#   NAME = expr;   PROVIDE(NAME = expr);   one SECTIONS { ... }
#
# In SECTIONS: `. = expr;`, `NAME = expr;`, `PROVIDE(NAME = expr);`,
# `/DISCARD/ : { ... }` and output section statements
#
#   NAME [expr] [(NOLOAD)] : [AT(expr)] { items }
#
# whose items are `NAME = expr;`, `*(pat ...)`, `KEEP(*(pat ...))` and
# `*(COMMON)`. A pattern is a section name, or one ending in `*`. An
# expression is integers (decimal or 0x, with a K or M suffix), symbols, `.`,
# `+`, `-`, `ALIGN(expr)`, `ADDR(section)` and parentheses. Anything else is
# an error naming its line: rld does not guess at what a script meant.
#
# The parsed script is views into the text it was parsed from, which the
# caller keeps alive. Expressions, items, input descriptions and patterns
# live in flat tables, referred to by index.
import ritzlib.gvec { Vec, vec_new }
import ritzlib.option { Option }
import ritzlib.result { Result }
import ritzlib.strview { StrView }

pub const DISCARD: StrView = "/DISCARD/"
const DEFAULT_ENTRY: StrView = "_start"

pub enum Expr
    Number(i64)
    Symbol(StrView)
    Dot
    Add(i64, i64)           # Exprs
    Sub(i64, i64)
    Align(i64)              # ALIGN(expr): `.` rounded up to it
    Addr(StrView)           # ADDR(section)

pub struct Pattern
    name: StrView           # without the trailing `*`
    prefix: bool            # it ended in `*`: any name starting with `name`

# One `*(pat pat ...)`: it claims each input section, in input order, that
# any of its patterns matches.
pub struct InputDesc
    first: i64              # its first Pattern
    count: i64

pub enum Item
    Assign(StrView, i64, bool)      # name, Expr, PROVIDE
    Inputs(i64)                     # an InputDesc

pub struct OutputStmt
    name: StrView
    addr: Option<i64>       # the address Expr
    lma: Option<i64>        # the AT() Expr
    noload: bool
    first_item: i64
    item_count: i64

pub enum Command
    SetDot(i64)                     # Expr
    Assign(StrView, i64, bool)      # name, Expr, PROVIDE
    Output(i64)                     # an OutputStmt

pub struct Script
    entry: StrView
    commands: Vec<Command>  # top level and SECTIONS, in script order
    outputs: Vec<OutputStmt>
    items: Vec<Item>
    descs: Vec<InputDesc>
    patterns: Vec<Pattern>
    exprs: Vec<Expr>

# What is wrong, where: `at` is a byte offset into the text, `token` the
# word it is about ("" when none).
pub struct ScriptError
    at: i64
    what: StrView
    token: StrView

impl OutputStmt
    pub fn is_discard(self: @OutputStmt) -> bool
        self.name.eq(DISCARD)

impl Pattern
    pub fn matches(self: @Pattern, name: StrView) -> bool
        if self.prefix then name.starts_with(self.name) else name.eq(self.name)

impl Script
    # Whether the Expr mentions a symbol (`.` and numbers are not symbols).
    pub fn uses_symbol(self: @Script, e: i64) -> bool
        match self.exprs[e]
            Symbol(_) => true
            Addr(_) => true
            Add(a, b) => self.uses_symbol(a) or self.uses_symbol(b)
            Sub(a, b) => self.uses_symbol(a) or self.uses_symbol(b)
            Align(a) => self.uses_symbol(a)
            _ => false

    # Whether any expression in the script is ADDR(`section`).
    pub fn addr_taken(self: @Script, section: StrView) -> bool
        for e in 0..self.exprs.len
            match self.exprs[e]
                Addr(name) =>
                    if name.eq(section)
                        return true
                _ => pass
        false

# The 1-based line of byte `at` in `text`.
pub fn line_of(text: StrView, at: i64) -> i64
    var line: i64 = 1
    var i: i64 = 0
    while i < at and i < text.len
        if text.get(i) == '\n'
            line += 1
        i += 1
    line

pub fn parse_script(text: StrView) -> Result<Script, ScriptError>
    var p: Parser = Parser {
        text: text,
        at: 0,
        script: Script {
            entry: DEFAULT_ENTRY,
            commands: vec_new<Command>(),
            outputs: vec_new<OutputStmt>(),
            items: vec_new<Item>(),
            descs: vec_new<InputDesc>(),
            patterns: vec_new<Pattern>(),
            exprs: vec_new<Expr>()
        },
        sections_seen: false
    }
    p.top()?
    Ok(p.script)

struct Parser
    text: StrView
    at: i64
    script: Script
    sections_seen: bool

fn is_name_byte(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.' or c == '$' or c == '*' or c == '/'

fn is_digit(c: u8) -> bool
    c >= '0' and c <= '9'

fn digit_value(c: u8) -> Option<i64>
    if c >= '0' and c <= '9'
        return Some((c - '0') as i64)
    if c >= 'a' and c <= 'f'
        return Some((c - 'a') as i64 + 10)
    if c >= 'A' and c <= 'F'
        return Some((c - 'A') as i64 + 10)
    None

# A word that names a command rld does not take: one of GNU ld's, all
# capitals. Output sections are not named like that in the tree.
fn is_keyword(w: StrView) -> bool
    if w.len == 0
        return false
    for i in 0..w.len
        let c: u8 = w.get(i)
        if not ((c >= 'A' and c <= 'Z') or c == '_')
            return false
    true

# An integer: decimal or 0x hex, with an optional K (KiB) or M (MiB)
# suffix, as the 64-bit pattern an address is (0xFFFFFFFF80000000 is
# negative as an i64). More digits than fit is an error.
fn parse_number(w: StrView) -> Option<i64>
    var digits: StrView = w
    var scale: i64 = 1
    if digits.ends_with("K")
        scale = 1024
        digits = digits.take(digits.len - 1)
    else if digits.ends_with("M")
        scale = 1024 * 1024
        digits = digits.take(digits.len - 1)
    var base: i64 = 10
    if digits.starts_with("0x") or digits.starts_with("0X")
        base = 16
        digits = digits.skip(2)
    # 16 hex digits fill the 64 bits; 18 decimal ones always fit.
    let most: i64 = if base == 16 then 16 else 18
    if digits.len == 0 or digits.len > most
        return None
    var v: i64 = 0
    for i in 0..digits.len
        let d: i64 = match digit_value(digits.get(i))
            Some(d) => d
            None => return None
        if d >= base
            return None
        v = (v *% base) +% d
    Some(v *% scale)

impl Parser
    fn fail(self: @Parser, what: StrView) -> ScriptError
        ScriptError { at: self.at, what: what, token: "" }

    fn fail_at(self: @Parser, at: i64, what: StrView, token: StrView) -> ScriptError
        ScriptError { at: at, what: what, token: token }

    # Skip white space and /* comments */.
    fn skip(self: @&Parser) -> Result<(), ScriptError>
        while self.at < self.text.len
            let c: u8 = self.text.get(self.at)
            if c == 0
                return Err(self.fail("a NUL byte"))
            if c == ' ' or c == '\t' or c == '\n' or c == '\r'
                self.at += 1
            else if c == '/' and self.text.skip(self.at).starts_with("/*")
                let start: i64 = self.at
                let body: StrView = self.text.skip(self.at + 2)
                let end: i64 = body.find("*/")
                if end >= body.len
                    return Err(self.fail_at(start, "unterminated comment", ""))
                self.at += 2 + end + 2
            else
                break
        Ok(())

    # The next byte after white space and comments, or 0 at the end (a
    # script with a NUL byte in it is refused, so 0 is only the end).
    fn peek(self: @&Parser) -> Result<u8, ScriptError>
        self.skip()?
        if self.at < self.text.len then Ok(self.text.get(self.at)) else Ok(0)

    fn at_end(self: @&Parser) -> Result<bool, ScriptError>
        self.skip()?
        Ok(self.at >= self.text.len)

    # Consume `c`, else fail with `what` ("expected ;").
    fn expect(self: @&Parser, c: u8, what: StrView) -> Result<(), ScriptError>
        if self.peek()? != c
            return Err(self.fail(what))
        self.at += 1
        Ok(())

    # Consume `c` when it is next.
    fn accept(self: @&Parser, c: u8) -> Result<bool, ScriptError>
        if self.peek()? != c
            return Ok(false)
        self.at += 1
        Ok(true)

    # A name: a run of name bytes, else an error.
    fn word(self: @&Parser) -> Result<StrView, ScriptError>
        self.skip()?
        let start: i64 = self.at
        while self.at < self.text.len and is_name_byte(self.text.get(self.at))
            if self.text.skip(self.at).starts_with("/*")
                break
            self.at += 1
        if self.at == start
            return Err(self.fail("expected a name"))
        Ok(self.text.slice(start, self.at))

    # The word starting here, without consuming it ("" when none).
    fn peek_word(self: @&Parser) -> Result<StrView, ScriptError>
        let save: i64 = self.at
        let w: StrView = match self.word()
            Ok(w) => w
            Err(_) => ""
        self.at = save
        Ok(w)

    fn push_expr(self: @&Parser, e: Expr) -> i64
        self.script.exprs.push(e)
        self.script.exprs.len - 1

    # expr := term (('+' | '-') term)*
    fn expr(self: @&Parser) -> Result<i64, ScriptError>
        var left: i64 = self.term()?
        loop
            let c: u8 = self.peek()?
            if c == '+'
                self.at += 1
                let right: i64 = self.term()?
                left = self.push_expr(Expr.Add(left, right))
            else if c == '-'
                self.at += 1
                let right: i64 = self.term()?
                left = self.push_expr(Expr.Sub(left, right))
            else
                break
        Ok(left)

    # term := '(' expr ')' | number | '.' | ALIGN(expr) | ADDR(name) | symbol
    fn term(self: @&Parser) -> Result<i64, ScriptError>
        if self.accept('(')?
            let e: i64 = self.expr()?
            self.expect(')', "expected )")?
            return Ok(e)
        let start: i64 = self.at
        let w: StrView = self.word()?
        if is_digit(w.get(0))
            return match parse_number(w)
                Some(n) => Ok(self.push_expr(Expr.Number(n)))
                None => Err(self.fail_at(start, "bad number", w))
        if w.eq(".")
            return Ok(self.push_expr(Expr.Dot))
        if w.eq("ALIGN")
            self.expect('(', "expected (")?
            let a: i64 = self.expr()?
            self.expect(')', "expected )")?
            return Ok(self.push_expr(Expr.Align(a)))
        if w.eq("ADDR")
            self.expect('(', "expected (")?
            let name: StrView = self.word()?
            self.expect(')', "expected )")?
            return Ok(self.push_expr(Expr.Addr(name)))
        if is_keyword(w) and self.peek()? == '('
            return Err(self.fail_at(start, "unsupported function", w))
        if w.contains("*") or w.contains("/")
            return Err(self.fail_at(start, "bad symbol name", w))
        Ok(self.push_expr(Expr.Symbol(w)))

    # The argument of OUTPUT_FORMAT or OUTPUT_ARCH: the text up to `)`,
    # quotes dropped, which must be `want`.
    fn raw_argument(self: @&Parser, want: StrView) -> Result<(), ScriptError>
        self.expect('(', "expected (")?
        let start: i64 = self.at
        let rest: StrView = self.text.skip(start)
        let close: i64 = rest.find_byte(')')
        if close >= rest.len
            return Err(self.fail("expected )"))
        var arg: StrView = self.text.slice(start, start + close).trim()
        if arg.len >= 2 and arg.starts_with("\"") and arg.ends_with("\"")
            arg = arg.slice(1, arg.len - 1)
        if not arg.eq(want)
            return Err(self.fail_at(start, "unsupported output", arg))
        self.at = start + close + 1
        Ok(())

    # `= expr ;` after a symbol's name.
    fn assignment(self: @&Parser) -> Result<i64, ScriptError>
        self.expect('=', "expected =")?
        let e: i64 = self.expr()?
        self.expect(';', "expected ;")?
        Ok(e)

    # `(NAME = expr)` after PROVIDE, and the `;` after it.
    fn provide(self: @&Parser) -> Result<Command, ScriptError>
        self.expect('(', "expected (")?
        let name: StrView = self.word()?
        self.expect('=', "expected =")?
        let e: i64 = self.expr()?
        self.expect(')', "expected )")?
        self.expect(';', "expected ;")?
        Ok(Command.Assign(name, e, true))

    fn top(self: @&Parser) -> Result<(), ScriptError>
        while not self.at_end()?
            if self.accept(';')?
                continue
            let start: i64 = self.at
            let w: StrView = self.word()?
            if w.eq("ENTRY")
                self.expect('(', "expected (")?
                self.script.entry = self.word()?
                self.expect(')', "expected )")?
            else if w.eq("OUTPUT_FORMAT")
                self.raw_argument("elf64-x86-64")?
            else if w.eq("OUTPUT_ARCH")
                self.raw_argument("i386:x86-64")?
            else if w.eq("PROVIDE")
                let c: Command = self.provide()?
                self.script.commands.push(c)
            else if w.eq("SECTIONS")
                if self.sections_seen
                    return Err(self.fail_at(start, "a second SECTIONS", ""))
                self.sections_seen = true
                self.expect('{', "expected {")?
                self.sections()?
            else if not w.contains("*") and self.peek()? == '='
                let e: i64 = self.assignment()?
                self.script.commands.push(Command.Assign(w, e, false))
            else
                return Err(self.fail_at(start, "unsupported command", w))
        Ok(())

    # The commands of SECTIONS, through its closing `}`.
    fn sections(self: @&Parser) -> Result<(), ScriptError>
        loop
            let c: u8 = self.peek()?
            if c == '}'
                self.at += 1
                return Ok(())
            if c == 0
                return Err(self.fail("expected }"))
            if c == ';'
                self.at += 1
                continue
            let start: i64 = self.at
            let w: StrView = self.word()?
            if w.eq(".")
                let e: i64 = self.assignment()?
                self.script.commands.push(Command.SetDot(e))
            else if w.eq("PROVIDE")
                let cmd: Command = self.provide()?
                self.script.commands.push(cmd)
            else if self.peek()? == '='
                let e: i64 = self.assignment()?
                self.script.commands.push(Command.Assign(w, e, false))
            else if is_keyword(w)
                return Err(self.fail_at(start, "unsupported command", w))
            else
                self.output(w)?

    # An output section statement, after its name.
    fn output(self: @&Parser, name: StrView) -> Result<(), ScriptError>
        var addr: Option<i64> = None
        var noload: bool = false
        let c: u8 = self.peek()?
        if c != ':' and not (c == '(' and self.noload_next()?)
            addr = Some(self.expr()?)
        if self.peek()? == '(' and self.noload_next()?
            self.expect('(', "expected (")?
            self.word()?
            self.expect(')', "expected )")?
            noload = true
        self.expect(':', "expected :")?
        var lma: Option<i64> = None
        let at_word: StrView = self.peek_word()?
        if at_word.eq("AT")
            self.word()?
            self.expect('(', "expected (")?
            lma = Some(self.expr()?)
            self.expect(')', "expected )")?
        self.expect('{', "expected {")?
        let first: i64 = self.script.items.len
        self.items()?
        let after: u8 = self.peek()?
        if after == '>' or after == ':' or after == '='
            return Err(self.fail("unsupported output section attribute"))
        self.script.outputs.push(OutputStmt {
            name: name,
            addr: addr,
            lma: lma,
            noload: noload,
            first_item: first,
            item_count: self.script.items.len - first
        })
        self.script.commands.push(Command.Output(self.script.outputs.len - 1))
        Ok(())

    # Whether `( NOLOAD )` starts here.
    fn noload_next(self: @&Parser) -> Result<bool, ScriptError>
        let save: i64 = self.at
        var yes: bool = false
        if self.accept('(')?
            let w: StrView = self.peek_word()?
            yes = w.eq("NOLOAD")
        self.at = save
        Ok(yes)

    # The items of an output section, through its closing `}`.
    fn items(self: @&Parser) -> Result<(), ScriptError>
        loop
            let c: u8 = self.peek()?
            if c == '}'
                self.at += 1
                return Ok(())
            if c == 0
                return Err(self.fail("expected }"))
            if c == ';'
                self.at += 1
                continue
            let start: i64 = self.at
            let w: StrView = self.word()?
            if w.eq("KEEP")
                self.expect('(', "expected (")?
                let star: i64 = self.at
                let file: StrView = self.word()?
                if not file.eq("*")
                    return Err(self.fail_at(star, "an input pattern's file part must be *", ""))
                self.input_desc()?
                self.expect(')', "expected )")?
            else if w.eq("*")
                self.input_desc()?
            else if w.eq("PROVIDE")
                match self.provide()?
                    Assign(name, e, provide) => self.script.items.push(Item.Assign(name, e, provide))
                    _ => pass
            else if self.peek()? == '=' and not w.contains("*")
                let e: i64 = self.assignment()?
                self.script.items.push(Item.Assign(w, e, false))
            else if self.peek()? == '('
                return Err(self.fail_at(start, "an input pattern's file part must be *", ""))
            else
                return Err(self.fail_at(start, "unsupported output section item", w))

    # `(pat pat ...)` after the `*` file part.
    fn input_desc(self: @&Parser) -> Result<(), ScriptError>
        self.expect('(', "expected (")?
        let first: i64 = self.script.patterns.len
        while self.peek()? != ')'
            let start: i64 = self.at
            if self.peek()? == 0
                return Err(self.fail("expected )"))
            let w: StrView = self.word()?
            if self.peek()? == '('
                return Err(self.fail_at(start, "unsupported pattern", w))
            let star: i64 = w.find_byte('*')
            if star < w.len - 1
                return Err(self.fail_at(start, "unsupported pattern", w))
            let prefix: bool = star == w.len - 1
            self.script.patterns.push(Pattern { name: if prefix then w.take(w.len - 1) else w, prefix: prefix })
        self.at += 1
        self.script.descs.push(InputDesc { first: first, count: self.script.patterns.len - first })
        self.script.items.push(Item.Inputs(self.script.descs.len - 1))
        Ok(())
