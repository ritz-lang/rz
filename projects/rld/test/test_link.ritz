# The reader, the resolver and the no-script link, on objects razm's writer
# makes: what one producer writes, the linker reads back.
import ritzlib.fs { unlink, write_file }
import ritzlib.gvec { Vec, vec_new }
import ritzlib.result { Result }
import ritzlib.sort { sort }
import ritzlib.span { Span, span_empty }
import ritzlib.string { String }
import ritzlib.strview { StrView }
import ritzlib.testlib
import razm.fixup { Fixup, FixupKind }
import razm.object
import razm.elf
import rld.dynamic
import rld.input
import rld.link
import rld.relax { Relax }
import rld.script
import rld.scripted { script_layout }

# _start: exit with the quad at `answer`, loaded through the GOT.
#   movq answer@GOTPCREL(%rip), %rax; movq (%rax), %rdi
#   movl $60, %eax; syscall
const START: [15]u8 = [0x48, 0x8b, 0x05, 0, 0, 0, 0, 0x48, 0x8b, 0x38, 0xb8, 0x3c, 0, 0, 0]
const SYSCALL: [2]u8 = [0x0f, 0x05]
const ANSWER: [8]u8 = [42, 0, 0, 0, 0, 0, 0, 0]
const RET: [1]u8 = [0xc3]
const QUAD: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]

fn text_flags() -> SectionFlags
    SectionFlags { alloc: true, write: false, exec: true }

fn data_flags() -> SectionFlags
    SectionFlags { alloc: true, write: true, exec: false }

[[test_helper]]
fn ok_section(r: Result<SectionId, ObjectError>) -> SectionId
    match r
        Ok(s) => s
        Err(_) =>
            assert false, "add_section"
            SectionId { index: -1 }

[[test_helper]]
fn emit(obj: @&Object, sec: SectionId, bytes: Span<u8>)
    assert obj.emit(sec, bytes).is_ok(), "emit"

[[test_helper]]
fn define(obj: @&Object, name: StrView, sec: SectionId, binding: Binding)
    assert obj.define(name, sec, 0).is_ok(), "define"
    obj.set_binding(name, binding)

# Write `obj` to this test's scratch file `name`.
[[test_helper]]
fn save(obj: @Object, name: StrView) -> String
    let path: String = sandbox_path("rld_link", name)
    assert obj.write(path.as_view()).is_ok(), "write"
    path

# The program above: `_start` in .text, `answer` in .data.
[[test_helper]]
fn program() -> Object
    var obj: Object = object_new()
    let text: SectionId = ok_section(obj.add_section(".text", SectionKind.Progbits, text_flags()))
    emit(@&obj, text, @START)
    emit(@&obj, text, @SYSCALL)
    define(@&obj, "_start", text, Binding.Global)
    let f = Fixup { offset: 3, width: 4, kind: FixupKind.GotPcRelx, target: "answer", addend: -4 }
    assert obj.add_fixup(text, 0, f).is_ok(), "add_fixup"
    let data: SectionId = ok_section(obj.add_section(".data", SectionKind.Progbits, data_flags()))
    emit(@&obj, data, @ANSWER)
    define(@&obj, "answer", data, Binding.Global)
    obj

# An object defining `name` with `binding`, in the COMDAT group `group`
# when that is not "".
[[test_helper]]
fn definer(name: StrView, binding: Binding, group: StrView) -> Object
    var obj: Object = object_new()
    let sec: SectionId = if group.len > 0 then ok_section(obj.add_group_section(".text.g", SectionKind.Progbits, text_flags(), group)) else ok_section(obj.add_section(".text", SectionKind.Progbits, text_flags()))
    emit(@&obj, sec, @RET)
    define(@&obj, name, sec, binding)
    obj

[[test_helper]]
fn read(l: @&Linker, path: @String)
    assert l.add_file(path.as_view()).is_ok(), "add_file"

[[test]]
fn test_reads_sections_symbols_and_relocations() -> i32
    var path_obj: Object = program()
    let path: String = save(@path_obj, "read.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    var names: i64 = 0
    for i in 0..l.sections.len
        if l.sections[i].name.eq(".text") or l.sections[i].name.eq(".data")
            assert l.is_kept(i), "allocated sections are kept"
            names += 1
    assert names == 2
    assert l.relocs.len == 1
    assert l.relocs[0].rtype == R_X86_64_REX_GOTPCRELX
    assert l.relocs[0].offset == 3 and l.relocs[0].addend == -4
    assert l.symbols[l.relocs[0].symbol].name.eq("answer")
    assert l.resolve().is_ok()
    let answer: i64 = l.lookup("answer")
    assert answer != UNRESOLVED and l.symbols[answer].bind == STB_GLOBAL
    assert l.definition(l.relocs[0].symbol) == answer
    assert l.sections[l.symbol_section(answer)].name.eq(".data")
    unlink(path.as_view())
    0

[[test]]
fn test_second_comdat_group_is_discarded() -> i32
    var a_obj: Object = definer("g", Binding.Weak, "g")
    let a: String = save(@a_obj, "comdat_a.o")
    var b_obj: Object = definer("g", Binding.Weak, "g")
    let b: String = save(@b_obj, "comdat_b.o")
    var l: Linker = linker_new()
    read(@&l, @a)
    read(@&l, @b)
    assert l.resolve().is_ok()
    var kept: i64 = 0
    var discarded: i64 = 0
    for i in 0..l.sections.len
        if l.sections[i].name.eq(".text.g")
            if l.sections[i].discarded
                discarded += 1
            else
                kept += 1
    assert kept == 1 and discarded == 1
    assert l.symbols[l.lookup("g")].file == 0, "the first group is kept"
    unlink(a.as_view())
    unlink(b.as_view())
    0

[[test]]
fn test_strong_definition_beats_weak() -> i32
    var a_obj: Object = definer("f", Binding.Weak, "")
    let a: String = save(@a_obj, "weak.o")
    var b_obj: Object = definer("f", Binding.Global, "")
    let b: String = save(@b_obj, "strong.o")
    var l: Linker = linker_new()
    read(@&l, @a)
    read(@&l, @b)
    assert l.resolve().is_ok()
    assert l.symbols[l.lookup("f")].file == 1
    unlink(a.as_view())
    unlink(b.as_view())
    0

[[test]]
fn test_first_weak_definition_stands() -> i32
    var a_obj: Object = definer("f", Binding.Weak, "")
    let a: String = save(@a_obj, "weak1.o")
    var b_obj: Object = definer("f", Binding.Weak, "")
    let b: String = save(@b_obj, "weak2.o")
    var l: Linker = linker_new()
    read(@&l, @a)
    read(@&l, @b)
    assert l.resolve().is_ok()
    assert l.symbols[l.lookup("f")].file == 0
    unlink(a.as_view())
    unlink(b.as_view())
    0

[[test]]
fn test_two_strong_definitions_are_an_error() -> i32
    var a_obj: Object = definer("f", Binding.Global, "")
    let a: String = save(@a_obj, "strong1.o")
    var b_obj: Object = definer("f", Binding.Global, "")
    let b: String = save(@b_obj, "strong2.o")
    var l: Linker = linker_new()
    read(@&l, @a)
    read(@&l, @b)
    match l.resolve()
        Ok(_) =>
            assert false, "duplicate accepted"
        Err(e) =>
            match e
                Duplicate(name) =>
                    assert name.eq("f")
                _ =>
                    assert false, "not Duplicate"
    unlink(a.as_view())
    unlink(b.as_view())
    0

[[test]]
fn test_undefined_reference_is_an_error() -> i32
    var obj: Object = object_new()
    let text: SectionId = ok_section(obj.add_section(".text", SectionKind.Progbits, text_flags()))
    emit(@&obj, text, @START)
    define(@&obj, "_start", text, Binding.Global)
    let f = Fixup { offset: 3, width: 4, kind: FixupKind.GotPcRelx, target: "missing", addend: -4 }
    assert obj.add_fixup(text, 0, f).is_ok(), "add_fixup"
    let path: String = save(@obj, "undefined.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    assert l.resolve().is_ok()
    match layout(@&l, Output.Executable)
        Ok(_) =>
            assert false, "undefined accepted"
        Err(e) =>
            match e
                Undefined(name) =>
                    assert name.eq("missing")
                _ =>
                    assert false, "not Undefined"
    unlink(path.as_view())
    0

[[test]]
fn test_got_load_relaxes_with_no_got_entry() -> i32
    var path_obj: Object = program()
    let path: String = save(@path_obj, "relax.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    assert l.resolve().is_ok()
    match layout(@&l, Output.Executable)
        Ok(img) =>
            assert img.relax[0] == Relax.PcRelative
            assert img.got_syms.len == 0 and img.got_out == -1
            assert img.entry == BASE + 0x1000, "_start opens the executable segment"
        Err(_) =>
            assert false, "layout"
    unlink(path.as_view())
    0

[[test]]
fn test_linked_program_runs() -> i32
    var obj_path_obj: Object = program()
    let obj_path: String = save(@obj_path_obj, "run.o")
    let exe: String = sandbox_path("rld_link", "run.out")
    let inputs: [1]StrView = [obj_path.as_view()]
    var l: Linker = linker_new()
    assert link(@&l, @inputs, exe.as_view(), Output.Executable).is_ok(), "link"
    match exec_capture(exe.as_view(), span_empty<StrView>(), span_empty<StrView>(), span_empty<u8>())
        Ok(c) =>
            assert c.status.exit_code == 42, "the GOT load reaches `answer`"
        Err(_) =>
            assert false, "spawn"
    unlink(obj_path.as_view())
    unlink(exe.as_view())
    0

[[test]]
fn test_non_elf_input_is_malformed() -> i32
    let path: String = sandbox_path("rld_link", "text.o")
    assert write_file(path.as_view(), "not an object\n").is_ok()
    var l: Linker = linker_new()
    match l.add_file(path.as_view())
        Ok(_) =>
            assert false, "text accepted"
        Err(e) =>
            match e
                Malformed(_, what) =>
                    assert what.eq("not an ELF file")
                _ =>
                    assert false, "not Malformed"
    unlink(path.as_view())
    0

[[test]]
fn test_supported_relocation_types() -> i32
    assert reloc_supported(R_X86_64_PC32) and reloc_supported(R_X86_64_REX_GOTPCRELX)
    assert reloc_supported(R_X86_64_64) and reloc_supported(R_X86_64_32S)
    assert not reloc_supported(19), "R_X86_64_TLSGD"
    assert not reloc_supported(37), "R_X86_64_IRELATIVE"
    0


# program() through a script: .text at 0x400000, .data on the next page
# loading at 0x9000, a symbol inside .data, and one PROVIDE no input wants.
const AT_SCRIPT: StrView = "ENTRY(_start)\nSECTIONS {\n  . = 0x400000;\n  .text : { *(.text) }\n  .data ALIGN(4K) : AT(0x9000) { __data = .; *(.data) }\n}\nPROVIDE(unwanted = 1);\n"
# The same, with .data discarded: `answer` goes with it.
const DISCARD_SCRIPT: StrView = "SECTIONS { . = 0x400000; .text : { *(.text) } /DISCARD/ : { *(.data) } }"

[[test]]
fn test_script_layout_places_at_the_script_addresses() -> i32
    var obj: Object = program()
    let path: String = save(@obj, "script.o")
    match parse_script(AT_SCRIPT)
        Ok(s) =>
            var l: Linker = linker_new()
            read(@&l, @path)
            assert l.resolve().is_ok()
            match script_layout(@&l, @s, "at.ld", Output.Executable)
                Ok(img) =>
                    assert img.entry == 0x400000, "_start opens .text"
                    assert img.segs.len == 2, "text, then data under its own AT"
                    let data: Segment = img.segs[1]
                    assert data.addr == 0x401000 and data.paddr == 0x9000
                    assert data.offset % PAGE == data.addr % PAGE
                    assert img.relax[0] == Relax.PcRelative, "the GOT load still relaxes"
                    let sym: i64 = l.lookup("__data")
                    assert sym != UNRESOLVED and l.symbols[sym].value == 0x401000
                    assert l.lookup("unwanted") == UNRESOLVED, "PROVIDE only what is wanted"
                Err(_) =>
                    assert false, "script_layout"
        Err(_) =>
            assert false, "parse"
    unlink(path.as_view())
    0

[[test]]
fn test_reference_into_discarded_section_is_an_error() -> i32
    var obj: Object = program()
    let path: String = save(@obj, "discard.o")
    match parse_script(DISCARD_SCRIPT)
        Ok(s) =>
            var l: Linker = linker_new()
            read(@&l, @path)
            assert l.resolve().is_ok()
            match script_layout(@&l, @s, "discard.ld", Output.Executable)
                Ok(_) =>
                    assert false, "a reference into /DISCARD/ accepted"
                Err(e) =>
                    match e
                        Discarded(name) =>
                            assert name.eq("answer")
                        _ =>
                            assert false, "not Discarded"
        Err(_) =>
            assert false, "parse"
    unlink(path.as_view())
    0

# The program, with a pointer to `answer` after it in a section with
# `flags`: `.data`'s for an initialized pointer, `.rodata`'s for one no PIE
# can load.
[[test_helper]]
fn pointer_program(name: StrView, flags: SectionFlags) -> Object
    var obj: Object = program()
    let sec: SectionId = ok_section(obj.add_section(name, SectionKind.Progbits, flags))
    emit(@&obj, sec, @QUAD)
    let f = Fixup { offset: 0, width: 8, kind: FixupKind.Absolute, target: "answer", addend: 0 }
    assert obj.add_fixup(sec, 0, f).is_ok(), "add_fixup"
    obj

[[test_helper]]
fn has_made(img: @Image, m: Made) -> bool
    for i in 0..img.made.len
        if img.made[i] == m
            return true
    false

[[test]]
fn test_pie_sections_by_output() -> i32
    assert pie_sections(Output.Executable, 3).len == 0
    let hosted: Vec<Made> = pie_sections(Output.Hosted, 0)
    assert hosted.len == 5
    assert hosted[0] == Made.Interp and hosted[1] == Made.Dynsym and hosted[2] == Made.GnuHash
    assert hosted[3] == Made.Dynstr and hosted[4] == Made.Dynamic, "no .hash, no empty .rela.dyn"
    let pie: Vec<Made> = pie_sections(Output.Pie, 2)
    assert pie.len == 6
    assert pie[2] == Made.Hash and pie[4] == Made.RelaDyn
    assert made_size(Made.RelaDyn, Output.Pie, 2) == 48
    assert made_size(Made.Dynamic, Output.Pie, 2) == 13 * DYN_SIZE, "ld.lld's 12 tags and DT_NULL"
    assert made_size(Made.Dynamic, Output.Hosted, 0) == 8 * DYN_SIZE
    assert made_size(Made.Interp, Output.Hosted, 0) == 28
    0

[[test]]
fn test_pie_loads_data_pointer_as_relative() -> i32
    var obj: Object = pointer_program(".data.rel", data_flags())
    let path: String = save(@obj, "pie.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    assert l.resolve().is_ok()
    match layout(@&l, Output.Pie)
        Ok(img) =>
            assert img.data_relatives == 1
            assert img.relax[0] == Relax.PcRelative, "a PIE relaxes mov to lea"
            assert img.got_out == -1
            assert has_made(@img, Made.RelaDyn) and has_made(@img, Made.Dynamic) and has_made(@img, Made.Hash)
            assert not has_made(@img, Made.Interp)
            assert img.entry == 0x1000, "a PIE links at 0"
        Err(_) =>
            assert false, "layout"
    unlink(path.as_view())
    0

[[test]]
fn test_executable_makes_no_dynamic_sections() -> i32
    var obj: Object = pointer_program(".data.rel", data_flags())
    let path: String = save(@obj, "exec.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    assert l.resolve().is_ok()
    match layout(@&l, Output.Executable)
        Ok(img) =>
            assert img.data_relatives == 0 and img.made.len == 0
        Err(_) =>
            assert false, "layout"
    unlink(path.as_view())
    0

[[test]]
fn test_read_only_pointer_is_not_pic() -> i32
    var obj: Object = pointer_program(".rodata", SectionFlags { alloc: true, write: false, exec: false })
    let path: String = save(@obj, "textrel.o")
    var l: Linker = linker_new()
    read(@&l, @path)
    assert l.resolve().is_ok()
    match layout(@&l, Output.Pie)
        Ok(_) =>
            assert false, "text relocation accepted"
        Err(e) =>
            match e
                NotPic(name, rtype) =>
                    assert name.eq("answer") and rtype == R_X86_64_64
                _ =>
                    assert false, "not NotPic"
    unlink(path.as_view())
    0

[[test]]
fn test_hosted_pie_runs() -> i32
    var obj: Object = pointer_program(".data.rel", data_flags())
    let obj_path: String = save(@obj, "hosted.o")
    let exe: String = sandbox_path("rld_link", "hosted.out")
    let inputs: [1]StrView = [obj_path.as_view()]
    var l: Linker = linker_new()
    assert link(@&l, @inputs, exe.as_view(), Output.Hosted).is_ok(), "link"
    match exec_capture(exe.as_view(), span_empty<StrView>(), span_empty<StrView>(), span_empty<u8>())
        Ok(c) =>
            assert c.status.exit_code == 42, "ld.so loads it and _start reaches `answer`"
        Err(_) =>
            assert false, "spawn"
    unlink(obj_path.as_view())
    unlink(exe.as_view())
    0

[[test]]
fn test_made_bytes_fill_their_sections() -> i32
    assert gnu_hash_bytes().len == made_size(Made.GnuHash, Output.Pie, 0)
    assert hash_bytes().len == made_size(Made.Hash, Output.Pie, 0)
    assert interp_bytes().len == made_size(Made.Interp, Output.Hosted, 0)
    let at: DynAddrs = DynAddrs { rela: 0x10, dynsym: 0x20, dynstr: 0x30, gnu_hash: 0x40, hash: 0x50 }
    for k in 0..3
        let relatives: i64 = k
        assert dynamic_bytes(Output.Pie, relatives, at).len == made_size(Made.Dynamic, Output.Pie, relatives)
        assert dynamic_bytes(Output.Hosted, relatives, at).len == made_size(Made.Dynamic, Output.Hosted, relatives)
    let entries: [2]Relative = [relative(0x100, 0x200), relative(0x108, 0x208)]
    let rela: Vec<u8> = rela_bytes(@entries)
    assert rela.len == made_size(Made.RelaDyn, Output.Pie, 2)
    assert rela[8] == R_X86_64_RELATIVE as u8 and rela[16] == 0, "type 8, addend 0x200"
    assert rela[17] == 2
    0

[[test]]
fn test_made_in_is_what_each_output_makes() -> i32
    # The PIEs' tables, and .rela.dyn only with a relocation.
    assert made_in(Made.Dynsym, Output.Pie, 0) and made_in(Made.Dynamic, Output.Hosted, 0)
    assert made_in(Made.Hash, Output.Pie, 0) and not made_in(Made.Hash, Output.Hosted, 0)
    assert made_in(Made.Interp, Output.Hosted, 0) and not made_in(Made.Interp, Output.Pie, 0)
    assert not made_in(Made.RelaDyn, Output.Pie, 0) and made_in(Made.RelaDyn, Output.Pie, 1)
    assert not made_in(Made.Dynsym, Output.Executable, 1)
    assert not made_in(Made.Got, Output.Pie, 1), "the GOT plan decides on the GOT"
    let made: Vec<Made> = pie_sections(Output.Pie, 1)
    assert made.len == 6 and made[0] == Made.Dynsym and made[5] == Made.Dynamic
    0

[[test]]
fn test_gotplt_header_holds_dynamic() -> i32
    let words: Vec<u8> = gotplt_bytes(0x1234)
    assert words.len == made_size(Made.GotPlt, Output.Pie, 0)
    assert words[0] == 0x34 and words[1] == 0x12 and words[8] == 0 and words[16] == 0
    0

[[test]]
fn test_extra_phdrs_count_phdr_only_when_loaded() -> i32
    assert extra_phdrs(Output.Executable, true) == 1, "PT_GNU_STACK"
    assert extra_phdrs(Output.Pie, true) == 3, "and PT_PHDR, PT_DYNAMIC"
    assert extra_phdrs(Output.Pie, false) == 2, "a script loads no headers"
    assert extra_phdrs(Output.Hosted, true) == 4, "and PT_INTERP"
    0

[[test]]
fn test_relatives_sort_by_offset() -> i32
    var r: Vec<Relative> = vec_new<Relative>()
    r.push(relative(0x130, 1))
    r.push(relative(0x118, 2))
    r.push(relative(0x120, 3))
    sort<Relative>(@&r)
    assert r[0].at == 0x118 and r[1].at == 0x120 and r[2].at == 0x130
    assert r[0].value == 2, "each keeps its value"
    0

[[test]]
fn test_got_loads_are_the_three_gotpcrel_types() -> i32
    let load: InReloc = InReloc { section: 0, offset: 0, rtype: R_X86_64_REX_GOTPCRELX, symbol: 0, addend: -4 }
    assert is_got_load(load)
    var pc: InReloc = load
    pc.rtype = R_X86_64_PC32
    assert not is_got_load(pc)
    0
