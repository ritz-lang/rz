# test/test_harland_save.ritz - the Harland single-write save (AGAST #4833).
#
# platform/harland_save.ritz's save, step by step, on Linux: Kernel stands
# in for Harland's file system through the OneWriteIo seam. It keeps the
# file the running system sees (`live`), logs each call, and fails the step
# a test names. Its close is all or nothing, as Harland's O_SYNC close is
# (harland/kernel/src/fs/REPLACEMENT.md, #4835): a failed one leaves the old
# file, or no file, everywhere. `Ed` checks the dirty flag and the message
# through the real editor.

import ritzlib.errno
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.string
import ritzlib.strview
import ritzlib.termsession { Key }

import core.buffer { Buffer, buffer_from_bytes, pos }
import core.editor { Editor, editor_open, handle_key }
import core.files { FileStore, LoadError, PathList, SaveError }
import platform.harland_save { FileStamp, HarlandFiles, Loaded, OPEN_REPLACE, OneWriteError, OneWriteIo, SavePause, harland_files, harland_load_with, harland_save_with }

# ============================================================================
# Kernel: Harland's file calls, scripted
# ============================================================================

# Steps Kernel can fail (its `fail` field).
const FAIL_NONE: i32 = 0
const FAIL_STAT: i32 = 1
const FAIL_CREATE: i32 = 2
const FAIL_WRITE: i32 = 3
const FAIL_SHORT: i32 = 4       # the write takes one byte less
const FAIL_CLOSE: i32 = 5       # the commit fails: nothing changes

# open(2)'s O_WRONLY | O_CREAT | O_TRUNC | O_SYNC, Linux's numbers spelled
# out: 1 | 64 | 512 | 04010000.
const WANT_FLAGS: i32 = 1053249

struct Kernel
    exists: bool
    live: Vec<u8>           # what the running system reads
    stamp: FileStamp
    pending: Vec<u8>        # the open fd's write buffer
    pending_mode: i32       # the mode the open fd's file gets
    flags: i32              # the last create's open flags
    fail: i32
    log: String             # S stat, C create, W write, X close, A abandon

fn kernel_with(text: StrView, mode: i32) -> Kernel
    var k = Kernel { exists: true, live: vec_new<u8>(), stamp: FileStamp { size: text.len, mtime: 0, mtime_ns: 100, mode: mode }, pending: vec_new<u8>(), pending_mode: mode, flags: 0, fail: FAIL_NONE, log: string_new() }
    k.live.push_view(text)
    k

fn kernel_empty() -> Kernel
    var k = kernel_with("", 0)
    k.exists = false
    k

impl Kernel
    fn holds(self: @Kernel, want: StrView) -> bool
        if self.live.len() != want.len
            return false
        for i in 0..want.len
            if self.live[i] != want.get(i)
                return false
        true

    # Another program rewrote the file.
    fn touch(self: @&Kernel)
        self.stamp.mtime_ns += 7

impl OneWriteIo for Kernel
    fn read(self: @&Kernel, path: StrView) -> Result<Loaded, Errno>
        if not self.exists
            return Err(Errno.NoEnt)
        var bytes: Vec<u8> = vec_new<u8>()
        bytes.push_span(span_from_vec<u8>(@self.live))
        Ok(Loaded { bytes: bytes, stamp: self.stamp })

    fn stat(self: @&Kernel, path: StrView) -> Result<Option<FileStamp>, Errno>
        let w = self.log.push('S')
        if self.fail == FAIL_STAT
            return Err(Errno.Acces)
        if not self.exists
            return Ok(None)
        Ok(Some(self.stamp))

    # A missing file's create waits for the close (O_SYNC | O_CREAT): the
    # mode is applied when it commits.
    fn create(self: @&Kernel, path: StrView, flags: i32, mode: i32) -> Result<(), Errno>
        let w = self.log.push('C')
        self.flags = flags
        if self.fail == FAIL_CREATE
            return Err(Errno.NoSpc)
        self.pending_mode = if self.exists then self.stamp.mode else mode
        self.pending.clear()
        Ok(())

    fn write(self: @&Kernel, data: [u8]) -> Result<i64, Errno>
        let w = self.log.push('W')
        if self.fail == FAIL_WRITE
            return Err(Errno.NoMem)
        var n = data.len
        if self.fail == FAIL_SHORT
            n -= 1
        self.pending.push_span(data[0..n])
        Ok(n)

    # The transaction: all of the new file, or (FAIL_CLOSE) none of it.
    fn close(self: @&Kernel) -> Result<(), Errno>
        let w = self.log.push('X')
        if self.fail == FAIL_CLOSE
            return Err(Errno.Io)
        self.live.clear()
        self.live.push_span(span_from_vec<u8>(@self.pending))
        self.exists = true
        self.stamp.size = self.live.len()
        self.stamp.mode = self.pending_mode
        self.stamp.mtime_ns += 1
        Ok(())

    fn abandon(self: @&Kernel)
        let w = self.log.push('A')

# ============================================================================
# Ed: the editor on a Kernel
# ============================================================================

# The editor's FileStore over a Kernel at one path.
struct Store
    files: HarlandFiles
    k: Kernel

impl FileStore for Store
    fn load(self: @&Store, path: StrView) -> Result<Vec<u8>, LoadError>
        harland_load_with(@&self.files, path, @&self.k)

    fn save(self: @&Store, path: StrView, buf: @Buffer) -> Result<(), SaveError>
        match harland_save_with(@&self.files, path, buf, @&self.k)
            Ok(_) => Ok(())
            Err(e) => Err(e.save_error())

    fn list(self: @&Store, limit: i64) -> PathList
        self.files.list(limit)

struct Ed
    ed: Editor
    s: Store

# The editor on `path`, loaded from `k`.
fn open_on(path: StrView, k: Kernel) -> Ed
    var s = Store { files: harland_files(SavePause.Never), k: k }
    var ed: Editor = match s.load(path)
        Ok(bytes) => editor_open(path, span_from_vec<u8>(@bytes))
        Err(_) => editor_open(path, span_from_strview(""))
    s.k.log.clear()
    Ed { ed: ed, s: s }

impl Ed
    # Type `text` as keys; `\x1b` is Escape and `\r` Enter.
    fn keys(self: @&Ed, text: StrView)
        for i in 0..text.len
            let c = text.get(i)
            var k = Key.Char(c as u32)
            if c == 27
                k = Key.Escape
            else if c == 13
                k = Key.Enter
            handle_key<Store>(@&self.ed, @&self.s, k)

    fn dirty(self: @Ed) -> bool
        self.ed.buf().is_dirty()

    fn says(self: @Ed, part: StrView) -> bool
        self.ed.message.as_view().contains(part)

# The save on its own, of `text` to `path`.
fn save_text(files: @&HarlandFiles, k: @&Kernel, path: StrView, text: StrView) -> Result<(), OneWriteError>
    let buf = buffer_from_bytes(span_from_strview(text))
    harland_save_with(files, path, @buf, k)

fn step_of(r: Result<(), OneWriteError>) -> StrView
    match r
        Ok(_) => "ok"
        Err(e) => e.step_name()

# ============================================================================
# The steps
# ============================================================================

[[test]]
fn test_var_save_is_one_write_then_the_close() -> i32
    # No sync after the close: the O_SYNC close is the durable commit.
    var o = open_on("/var/notes.txt", kernel_with("one\ntwo\r\n", 384))
    o.keys("iX\x1b:w\r")
    assert o.s.k.log.as_view().eq("SCWXS")
    assert o.s.k.holds("Xone\ntwo\r\n")
    assert not o.dirty()
    assert o.says("written")
    0

[[test]]
fn test_the_save_opens_o_sync() -> i32
    assert OPEN_REPLACE == WANT_FLAGS
    var files = harland_files(SavePause.Never)
    var k = kernel_empty()
    assert step_of(save_text(@&files, @&k, "/var/f", "f\n")).eq("ok")
    assert k.flags == WANT_FLAGS
    0

[[test]]
fn test_ram_only_save_takes_the_same_steps() -> i32
    var o = open_on("/home/notes.txt", kernel_with("a\n", 420))
    o.keys("ib\x1b:w\r")
    assert o.s.k.log.as_view().eq("SCWXS")
    assert o.s.k.holds("ba\n")
    assert not o.dirty()
    0

[[test]]
fn test_empty_save_closes_without_a_write() -> i32
    var o = open_on("/var/e.txt", kernel_with("x", 420))
    o.keys("x:w\r")
    assert o.s.k.log.as_view().eq("SCXS")
    assert o.s.k.holds("")
    assert not o.dirty()
    0

[[test]]
fn test_a_new_file_is_created_0644_and_an_old_one_keeps_its_mode() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_empty()
    assert step_of(save_text(@&files, @&k, "/var/new", "n\n")).eq("ok")
    assert k.stamp.mode == 420
    var k2 = kernel_with("old", 384)
    var o = open_on("/var/old", k2)
    o.keys("x:w\r")
    assert o.s.k.stamp.mode == 384
    0

# ============================================================================
# Failures: the dirty flag, the message and the file
# ============================================================================

[[test]]
fn test_failed_var_close_keeps_the_old_file_and_the_buffer_dirty() -> i32
    # fault-persist or fault-sync: the O_SYNC close fails, the file is the
    # old one everywhere. A plain failure, not "may already have changed".
    var o = open_on("/var/p.txt", kernel_with("old\n", 420))
    o.s.k.fail = FAIL_CLOSE
    o.keys("inew \x1b:w\r")
    assert o.dirty()
    assert o.says("not written: Input/output error")
    assert not o.says("may already have changed")
    assert o.s.k.holds("old\n")
    assert o.s.k.log.as_view().eq("SCWX")
    # The record is untouched: once storage works the save is not refused
    # as a change.
    o.s.k.fail = FAIL_NONE
    o.keys(":w\r")
    assert not o.dirty()
    assert o.s.k.holds("new old\n")
    0

[[test]]
fn test_failed_close_of_a_new_file_leaves_no_file() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_empty()
    let loaded = harland_load_with(@&files, "/var/n", @&k)
    k.fail = FAIL_CLOSE
    assert step_of(save_text(@&files, @&k, "/var/n", "n\n")).eq("close")
    assert not k.exists
    k.fail = FAIL_NONE
    assert step_of(save_text(@&files, @&k, "/var/n", "n\n")).eq("ok")
    assert k.holds("n\n")
    assert k.stamp.mode == 420
    0

[[test]]
fn test_a_failed_close_is_a_plain_failure() -> i32
    let e: OneWriteError = OneWriteError.Close(Errno.Io)
    var failed = false
    match e.save_error()
        Failed(n) => failed = n.name().eq("EIO")
        Changed => pass
        Unpersisted(_) => pass
    assert failed
    0

[[test]]
fn test_failed_ram_only_close_is_a_plain_failure() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_empty()
    k.fail = FAIL_CLOSE
    assert step_of(save_text(@&files, @&k, "/home/c", "c")).eq("close")
    0

[[test]]
fn test_failed_write_abandons_the_fd_without_closing_it() -> i32
    var o = open_on("/var/w.txt", kernel_with("old\n", 420))
    o.s.k.fail = FAIL_WRITE
    o.keys("inew \x1b:w\r")
    assert o.dirty()
    assert o.says("not written")
    # No close: an explicit close of the O_TRUNC fd would commit.
    assert o.s.k.log.as_view().eq("SCWA")
    assert o.s.k.holds("old\n")
    0

[[test]]
fn test_short_write_is_a_failed_write() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_empty()
    k.fail = FAIL_SHORT
    assert step_of(save_text(@&files, @&k, "/var/s", "abc")).eq("write")
    assert k.log.as_view().eq("SCWA")
    0

[[test]]
fn test_failed_open_writes_nothing() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_with("keep", 420)
    let loaded = harland_load_with(@&files, "/var/o", @&k)
    k.log.clear()
    k.fail = FAIL_CREATE
    let r = save_text(@&files, @&k, "/var/o", "x")
    assert step_of(r).eq("open")
    assert k.log.as_view().eq("SC")
    assert k.holds("keep")
    0

[[test]]
fn test_failed_stat_writes_nothing() -> i32
    var files = harland_files(SavePause.Never)
    var k = kernel_with("keep", 420)
    k.fail = FAIL_STAT
    assert step_of(save_text(@&files, @&k, "/var/o", "x")).eq("stat")
    assert k.log.as_view().eq("S")
    0

# ============================================================================
# The change check (stat, #4832)
# ============================================================================

[[test]]
fn test_a_file_changed_since_load_is_not_written() -> i32
    var o = open_on("/var/c.txt", kernel_with("mine\n", 420))
    o.s.k.touch()
    o.keys("ix\x1b:w\r")
    assert o.dirty()
    assert o.says("changed on disk")
    assert o.s.k.log.as_view().eq("S")
    assert o.s.k.holds("mine\n")
    0

[[test]]
fn test_a_second_save_checks_against_the_first() -> i32
    var o = open_on("/var/twice.txt", kernel_with("a\n", 420))
    o.keys("ix\x1b:w\r")
    assert not o.dirty()
    o.keys("iy\x1b:w\r")
    assert not o.dirty()
    assert o.s.k.holds("yxa\n")
    0

[[test]]
fn test_a_new_file_that_appeared_meanwhile_is_not_overwritten() -> i32
    var o = open_on("/var/appeared", kernel_empty())
    o.s.k.exists = true
    o.keys("ix\x1b:w\r")
    assert o.dirty()
    assert o.says("changed on disk")
    0
