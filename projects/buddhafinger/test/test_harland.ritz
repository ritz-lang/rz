# test/test_harland.ritz - the Harland command line (AGAST #4833).
#
# platform/harland's harland_args: the viewport (Harland reports no window
# size, so --rows and --cols set it), the acceptance test's --pause-save,
# and the file. The console session itself is tools/test_harland_console.sh,
# under QEMU.

import ritzlib.result
import ritzlib.span { Span, span_from_ptr }
import ritzlib.strview { StrView }

import platform.harland { HarlandArgs, harland_args }
import platform.harland_save { SavePause }

# harland_args on `n` arguments after the program name.
fn parse(argv: @[4]StrView, n: i64) -> Result<HarlandArgs, StrView>
    harland_args(span_from_ptr<StrView>(@argv[0], n + 1))

[[test]]
fn test_defaults_are_24_by_80_and_no_pause() -> i32
    var argv: [4]StrView = ["buddhafinger", "/var/a.txt", "", ""]
    let a = parse(@argv, 1).unwrap()
    assert a.path.eq("/var/a.txt")
    assert a.size.rows == 24 and a.size.cols == 80
    assert a.pause == SavePause.Never
    0

[[test]]
fn test_rows_and_cols_set_the_viewport() -> i32
    var argv: [4]StrView = ["buddhafinger", "--rows", "30", "--cols"]
    let partial = parse(@argv, 3)
    assert partial.is_err()
    var full: [4]StrView = ["buddhafinger", "--cols", "120", "f"]
    let a = parse(@full, 3).unwrap()
    assert a.size.cols == 120 and a.size.rows == 24
    assert a.path.eq("f")
    var rows: [4]StrView = ["buddhafinger", "--rows", "30", ""]
    assert parse(@rows, 2).unwrap().size.rows == 30
    0

[[test]]
fn test_a_viewport_out_of_range_is_refused() -> i32
    var small: [4]StrView = ["buddhafinger", "--rows", "2", ""]
    assert parse(@small, 2).is_err()
    var narrow: [4]StrView = ["buddhafinger", "--cols", "9", ""]
    assert parse(@narrow, 2).is_err()
    var word: [4]StrView = ["buddhafinger", "--cols", "wide", ""]
    assert parse(@word, 2).is_err()
    0

[[test]]
fn test_pause_save_points() -> i32
    var before: [4]StrView = ["buddhafinger", "--pause-save", "before-write", "f"]
    assert parse(@before, 3).unwrap().pause == SavePause.BeforeWrite
    var after: [4]StrView = ["buddhafinger", "--pause-save", "after-write", "f"]
    assert parse(@after, 3).unwrap().pause == SavePause.AfterWrite
    var bad: [4]StrView = ["buddhafinger", "--pause-save", "never", "f"]
    assert parse(@bad, 3).is_err()
    0

[[test]]
fn test_a_second_file_or_an_unknown_option_is_refused() -> i32
    var two: [4]StrView = ["buddhafinger", "a", "b", ""]
    assert parse(@two, 2).is_err()
    var opt: [4]StrView = ["buddhafinger", "-x", "", ""]
    assert parse(@opt, 1).is_err()
    0
