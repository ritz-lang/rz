# test/test_core.ritz - the editor core's ritzunit suite.
#
# Run by `make -C projects/buddhafinger test` under ritz1_selfhosted only.

import ritzlib.option { Option }
import ritzlib.string
import ritzlib.strview

import core.buffer { buffer_new }
import core.commands { Command, parse_command }
import core.modes { Mode, mode_label }

[[test]]
fn test_mode_labels() -> i32
    assert mode_label(Mode.Normal).eq("NORMAL")
    assert mode_label(Mode.Insert).eq("INSERT")
    assert mode_label(Mode.CommandLine).eq("COMMAND")
    0

# The command's shape, with its argument: "q", "q!", "w", "w <path>",
# "wq", "e <path>", "<n>", or "none".
fn shape(got: Option<Command>) -> String
    var s = string_new()
    match got
        Some(c) => match c
            Command.Quit => s.push_str("q")
            Command.ForceQuit => s.push_str("q!")
            Command.Write => s.push_str("w")
            Command.WriteTo(p) =>
                s.push_str("w ")
                s.push_str(p)
            Command.WriteQuit => s.push_str("wq")
            Command.Edit(p) =>
                s.push_str("e ")
                s.push_str(p)
            Command.Goto(n) => s.push_i64(n)
        None => s.push_str("none")
    s

fn parses(text: StrView, want: StrView) -> bool
    shape(parse_command(text)).as_view().eq(want)

[[test]]
fn test_parse_the_first_release_commands() -> i32
    assert parses("q", "q")
    assert parses("q!", "q!")
    assert parses("w", "w")
    assert parses("w  a b.txt ", "w a b.txt")
    assert parses("wq", "wq")
    assert parses("e x.ritz", "e x.ritz")
    assert parses("e", "e ")
    assert parses("42", "42")
    assert parses(" 7 ", "7")
    0

[[test]]
fn test_parse_refuses_the_rest() -> i32
    assert parses("", "none")
    assert parses("x", "none")
    assert parses("wa", "none")             # not `:w a`
    assert parses("ex", "none")
    assert parses("wq x", "none")
    assert parses("q!!", "none")
    assert parses("3x", "none")
    assert parses("99999999999999999999999", "none")
    0

[[test]]
fn test_new_buffer_is_clean() -> i32
    let b = buffer_new()
    assert not b.is_dirty()
    0
