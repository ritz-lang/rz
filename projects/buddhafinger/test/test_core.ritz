# test/test_core.ritz - the editor core's ritzunit suite.
#
# Run by `make -C projects/buddhafinger test` under ritz1_selfhosted only.

import ritzlib.option { Option }

import core.buffer { buffer_new }
import core.commands { Command, parse_command }
import core.modes { Mode, mode_label }

[[test]]
fn test_mode_labels() -> i32
    assert mode_label(Mode.Normal).eq("NORMAL")
    assert mode_label(Mode.Insert).eq("INSERT")
    0

fn is_command(got: Option<Command>, want: Command) -> bool
    match got
        Some(c) => c == want
        None => false

[[test]]
fn test_parse_quit_and_write() -> i32
    assert is_command(parse_command("q!"), Command.ForceQuit)
    assert is_command(parse_command("wq"), Command.WriteQuit)
    assert parse_command("x").is_none()
    0

[[test]]
fn test_new_buffer_is_clean() -> i32
    let b = buffer_new()
    assert not b.is_dirty()
    0
