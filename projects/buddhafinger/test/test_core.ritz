# test/test_core.ritz - the editor core's ritzunit suite.
#
# Run by `make -C projects/buddhafinger test` under ritz1_selfhosted only.

import ritzlib.option { Option }
import ritzlib.string
import ritzlib.strview

import core.buffer { buffer_new }
import core.commands { Command, parse_command }
import core.modes { Mode, mode_label }

[[test]]
fn test_mode_labels() -> i32
    assert mode_label(Mode.Normal).eq("NORMAL")
    assert mode_label(Mode.Insert).eq("INSERT")
    assert mode_label(Mode.CommandLine).eq("COMMAND")
    assert mode_label(Mode.Visual).eq("VISUAL")
    assert mode_label(Mode.VisualLine).eq("VISUAL LINE")
    0

# The command's shape, with its argument: "q", "q!", "w", "w <path>",
# "wq", "e <path>", "<n>", or "none".
fn shape(got: Option<Command>) -> String
    var s = string_new()
    match got
        Some(c) => match c
            Command.Quit => s.push_str("q")
            Command.ForceQuit => s.push_str("q!")
            Command.Write => s.push_str("w")
            Command.WriteTo(p) =>
                s.push_str("w ")
                s.push_str(p)
            Command.WriteQuit => s.push_str("wq")
            Command.Edit(p) =>
                s.push_str("e ")
                s.push_str(p)
            Command.Goto(n) => s.push_i64(n)
            Command.List => s.push_str("ls")
            Command.Buffer(b) =>
                s.push_str("b ")
                s.push_str(b)
            Command.BufferNext => s.push_str("bn")
            Command.BufferPrev => s.push_str("bp")
            Command.BufferDelete(b, force) =>
                s.push_str(if force then "bd! " else "bd ")
                s.push_str(b)
            Command.Split(f) =>
                s.push_str("sp ")
                s.push_str(f)
            Command.VSplit(f) =>
                s.push_str("vs ")
                s.push_str(f)
            Command.Close => s.push_str("close")
            Command.Only => s.push_str("only")
        None => s.push_str("none")
    s

fn parses(text: StrView, want: StrView) -> bool
    shape(parse_command(text)).as_view().eq(want)

[[test]]
fn test_parse_the_first_release_commands() -> i32
    assert parses("q", "q")
    assert parses("q!", "q!")
    assert parses("w", "w")
    assert parses("w  a b.txt ", "w a b.txt")
    assert parses("wq", "wq")
    assert parses("e x.ritz", "e x.ritz")
    assert parses("e", "e ")
    assert parses("42", "42")
    assert parses(" 7 ", "7")
    0

[[test]]
fn test_parse_refuses_the_rest() -> i32
    assert parses("", "none")
    assert parses("x", "none")
    assert parses("wa", "none")             # not `:w a`
    assert parses("ex", "none")
    assert parses("wq x", "none")
    assert parses("q!!", "none")
    assert parses("3x", "none")
    assert parses("99999999999999999999999", "none")
    0

# Buffers and windows (AGAST #4912), under Vim's names and abbreviations.
[[test]]
fn test_parse_buffer_and_window_commands() -> i32
    assert parses("ls", "ls") and parses("buffers", "ls") and parses("files", "ls")
    assert parses("b 2", "b 2") and parses("b2", "b 2") and parses("buffer g.txt", "b g.txt")
    assert parses("b", "b ") and parses("bu", "b ")
    assert parses("bn", "bn") and parses("bnext", "bn") and parses("bne", "bn")
    assert parses("bp", "bp") and parses("bprevious", "bp") and parses("bN", "bp") and parses("bNext", "bp")
    assert parses("bd", "bd ") and parses("bd!", "bd! ") and parses("bd 3", "bd 3") and parses("bdelete! 3", "bd! 3")
    assert parses("sp", "sp ") and parses("split g.txt", "sp g.txt")
    assert parses("vs", "vs ") and parses("vsplit g.txt", "vs g.txt")
    assert parses("clo", "close") and parses("close", "close")
    assert parses("on", "only") and parses("only", "only")
    0

[[test]]
fn test_parse_refuses_buffer_and_window_misspellings() -> i32
    assert parses("bufferz", "none")
    assert parses("bn 2", "none")           # takes no argument
    assert parses("ls x", "none")
    assert parses("sp!", "none")            # only :bd and :q take a `!`
    assert parses("spg.txt", "none")        # a name needs a blank before it
    assert parses("sp2", "none") and parses("ls2", "none")    # only :b and :bd take a number glued on
    assert parses("cl", "none")             # :clo at the least
    assert parses("o", "none")
    assert parses("close x", "none")
    0

[[test]]
fn test_new_buffer_is_clean() -> i32
    let b = buffer_new()
    assert not b.is_dirty()
    0
