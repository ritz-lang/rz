# test/test_walk.ritz - platform/walk: the workspace's files for the file picker (AGAST #4913).
#
# Breadth first, so a bound keeps the shallow files; `.git` and `build`
# not entered; at most `limit` files, the list marked truncated past it.

import ritzlib.fs
import ritzlib.string
import ritzlib.strview { StrView }
import ritzlib.testlib { sandbox_path }

import core.files { PathList }
import platform.walk { walk_files }

# A fresh empty directory, pid-suffixed under $TMPDIR (else /tmp).
fn fixture_dir(name: StrView) -> String
    let d = sandbox_path("bf_walk", name)
    let gone = remove_dir_all(d.as_view())
    let made = mkdir(d.as_view(), 493)
    d

fn put(dir: StrView, name: StrView)
    let path = path_join(dir, name)
    let w = write_file(path.as_view(), "x\n")

fn lists(l: @PathList, want: StrView) -> bool
    for k in 0..l.len()
        if l.get(k).eq(want)
            return true
    false

[[test]]
fn test_walk_lists_files_breadth_first_and_skips_git_and_build() -> i32
    let root = fixture_dir("tree")
    let sub = path_join(root.as_view(), "a")
    let deep = path_join(sub.as_view(), "b")
    let git = path_join(root.as_view(), ".git")
    let build = path_join(sub.as_view(), "build")
    let m1 = mkdir(sub.as_view(), 493)
    let m2 = mkdir(deep.as_view(), 493)
    let m3 = mkdir(git.as_view(), 493)
    let m4 = mkdir(build.as_view(), 493)
    put(root.as_view(), "top.txt")
    put(sub.as_view(), "mid.txt")
    put(deep.as_view(), "low.txt")
    put(git.as_view(), "HEAD")
    put(build.as_view(), "out.o")
    let l = walk_files(root.as_view(), 100)
    assert l.len() == 3
    assert not l.truncated
    let top = path_join(root.as_view(), "top.txt")
    let mid = path_join(sub.as_view(), "mid.txt")
    let low = path_join(deep.as_view(), "low.txt")
    assert l.get(0).eq(top.as_view()), "the shallowest first"
    assert l.get(1).eq(mid.as_view())
    assert l.get(2).eq(low.as_view())
    assert not lists(@l, path_join(git.as_view(), "HEAD").as_view())
    let gone = remove_dir_all(root.as_view())
    0

[[test]]
fn test_walk_stops_at_its_limit() -> i32
    let root = fixture_dir("limit")
    let sub = path_join(root.as_view(), "deep")
    let m = mkdir(sub.as_view(), 493)
    put(root.as_view(), "1")
    put(root.as_view(), "2")
    put(root.as_view(), "3")
    put(sub.as_view(), "4")
    let l = walk_files(root.as_view(), 3)
    assert l.len() == 3 and l.truncated
    assert not lists(@l, path_join(sub.as_view(), "4").as_view()), "the bound cuts the deepest off"
    let all = walk_files(root.as_view(), 4)
    assert all.len() == 4 and not all.truncated
    let gone = remove_dir_all(root.as_view())
    0

[[test]]
fn test_walk_of_a_missing_root_is_empty() -> i32
    let root = sandbox_path("bf_walk", "missing")
    let gone = remove_dir_all(root.as_view())
    let l = walk_files(root.as_view(), 10)
    assert l.len() == 0 and not l.truncated
    0
