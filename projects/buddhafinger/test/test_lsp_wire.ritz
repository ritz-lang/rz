# test/test_lsp_wire.ritz - the language server's wire (AGAST #4828).
#
# UTF-16 columns against byte columns, frames read back from every split of
# their bytes, and the outbox: a partly written frame keeps its bytes and
# offset, only snapshots not yet started coalesce, and the cap holds.

import ritzlib.gvec
import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string

import lsp.wire { Framed, FrameReader, Outbox, byte_col, frame_reader, outbox_new, push_frame, utf16_col, MAX_HEADER_BYTES, ORDERED_RESERVE }

fn bytes(s: StrView) -> [u8]
    span_from_strview(s)

fn view_of(v: @Vec<u8>) -> StrView
    let s: [u8] = span_from_vec<u8>(v)
    s.as_strview()

# ============================================================================
# Columns
# ============================================================================

[[test]]
fn test_utf16_col_counts_ascii_bmp_and_astral_code_points() -> i32
    # "a" 1 byte, "é" 2, "€" 3, "😀" 4 (two UTF-16 units), "b".
    let line = bytes("aé€😀b")
    assert utf16_col(line, 0) == 0
    assert utf16_col(line, 1) == 1
    assert utf16_col(line, 3) == 2
    assert utf16_col(line, 6) == 3
    assert utf16_col(line, 10) == 5
    assert utf16_col(line, 11) == 6
    assert utf16_col(line, 99) == 6         # past the end: the whole line
    0

[[test]]
fn test_byte_col_inverts_utf16_col() -> i32
    let line = bytes("aé€😀b")
    assert byte_col(line, 0) == 0
    assert byte_col(line, 2) == 3
    assert byte_col(line, 3) == 6
    assert byte_col(line, 4) == 6           # inside the surrogate pair: its start
    assert byte_col(line, 5) == 10
    assert byte_col(line, 6) == 11
    assert byte_col(line, 40) == 11
    0

[[test]]
fn test_malformed_bytes_are_one_unit_each() -> i32
    var raw: Vec<u8> = vec_new<u8>()
    raw.push(0xff)
    raw.push(0xfe)
    raw.push('x')
    let line: [u8] = raw[0..raw.len()]
    assert utf16_col(line, 2) == 2
    assert byte_col(line, 2) == 2
    0

# ============================================================================
# Frames
# ============================================================================

fn framed(body: StrView) -> Vec<u8>
    var out: Vec<u8> = vec_new<u8>()
    push_frame(@&out, bytes(body))
    out

# A message's text, or "<partial>" / "<bad>".
fn text_of(f: Framed) -> StrView
    match f
        Framed.Message(m) => m
        Framed.Partial => "<partial>"
        Framed.Bad => "<bad>"

[[test]]
fn test_push_frame_writes_the_content_length_header() -> i32
    let f = framed("{\"id\":1}")
    assert view_of(@f).eq("Content-Length: 8\r\n\r\n{\"id\":1}")
    0

[[test]]
fn test_reader_returns_each_message_of_a_stream() -> i32
    var stream: Vec<u8> = framed("{\"a\":1}")
    stream.push_span(bytes("Content-Type: application/vscode-jsonrpc; charset=utf-8\r\ncontent-length: 2\r\n\r\n[]"))
    var r = frame_reader()
    r.feed(stream[0..stream.len()])
    assert text_of(r.next()).eq("{\"a\":1}")
    assert text_of(r.next()).eq("[]")
    assert text_of(r.next()).eq("<partial>")
    0

# Every way of cutting a two-frame stream in two gives the same messages:
# the reader keeps a partial header or body until the rest comes.
[[test]]
fn test_reader_reassembles_partial_frames_at_every_split() -> i32
    var stream: Vec<u8> = framed("{\"x\":\"é\"}")
    let second = framed("{\"y\":2}")
    stream.push_span(second[0..second.len()])
    let all: [u8] = stream[0..stream.len()]
    for cut in 0..all.len + 1
        var r = frame_reader()
        var got: i64 = 0
        r.feed(all.slice(0, cut))
        loop
            let t = text_of(r.next())
            if t.eq("<partial>")
                break
            assert t.eq(if got == 0 then "{\"x\":\"é\"}" else "{\"y\":2}")
            got += 1
        r.feed(all.slice(cut, all.len))
        loop
            let t = text_of(r.next())
            if t.eq("<partial>")
                break
            assert t.eq(if got == 0 then "{\"x\":\"é\"}" else "{\"y\":2}")
            got += 1
        assert got == 2
        assert r.buffered() == 0
    0

[[test]]
fn test_reader_one_byte_at_a_time() -> i32
    let f = framed("{\"jsonrpc\":\"2.0\",\"method\":\"m\"}")
    let all: [u8] = f[0..f.len()]
    var r = frame_reader()
    for i in 0..all.len
        assert text_of(r.next()).eq("<partial>")
        r.feed(all.slice(i, i + 1))
    assert text_of(r.next()).eq("{\"jsonrpc\":\"2.0\",\"method\":\"m\"}")
    0

fn first_of(s: StrView) -> Framed
    var r = frame_reader()
    r.feed(bytes(s))
    r.next()

fn is_bad(f: Framed) -> bool
    text_of(f).eq("<bad>")

[[test]]
fn test_reader_refuses_what_is_not_a_frame() -> i32
    assert is_bad(first_of("Content-Length: -1\r\n\r\n"))
    assert is_bad(first_of("Content-Length: 1x\r\n\r\nab"))
    assert is_bad(first_of("Content-Type: x\r\n\r\n{}"))          # no length
    assert is_bad(first_of("Content-Length: 99999999999\r\n\r\n"))  # past MAX_BODY_BYTES
    # A header that never ends, once it is longer than any real one.
    var junk = string_new()
    for i in 0..MAX_HEADER_BYTES + 1
        junk.push('x')
    assert is_bad(first_of(junk.as_view()))
    0

# ============================================================================
# The outbox
# ============================================================================

# Write at most `n` bytes of the outbox to `sink`, as a pipe taking `n` would.
fn drain(ob: @&Outbox, sink: @&Vec<u8>, n: i64) -> i64
    let p = ob.pending()
    let k = if n < p.len then n else p.len
    sink.push_span(p.slice(0, k))
    ob.wrote(k)
    k

fn drain_all(ob: @&Outbox, sink: @&Vec<u8>)
    while not ob.is_empty()
        drain(ob, sink, 7)

[[test]]
fn test_frames_go_out_in_order_through_short_writes() -> i32
    var ob = outbox_new(ORDERED_RESERVE + 4096)
    assert ob.push(bytes("{\"id\":1}")).is_ok()
    assert ob.push(bytes("{\"id\":2}")).is_ok()
    var sink: Vec<u8> = vec_new<u8>()
    drain_all(@&ob, @&sink)
    var want = framed("{\"id\":1}")
    let two = framed("{\"id\":2}")
    want.push_span(two[0..two.len()])
    assert view_of(@sink).eq(view_of(@want))
    assert ob.queued() == 0
    0

[[test]]
fn test_unstarted_snapshot_is_replaced_by_the_newer_one() -> i32
    var ob = outbox_new(ORDERED_RESERVE + 4096)
    assert ob.push_snapshot(bytes("v1")).is_ok()
    assert ob.push(bytes("hover")).is_ok()
    assert ob.push_snapshot(bytes("v2")).is_ok()
    assert ob.push_snapshot(bytes("v3")).is_ok()
    assert ob.replaced == 2
    var sink: Vec<u8> = vec_new<u8>()
    drain_all(@&ob, @&sink)
    var want = framed("v3")
    let h = framed("hover")
    want.push_span(h[0..h.len()])
    assert view_of(@sink).eq(view_of(@want))
    0

# The pipe took part of snapshot v1: v1 finishes intact, byte for byte,
# and v2 queues behind it instead of replacing it.
[[test]]
fn test_started_snapshot_is_kept_whole() -> i32
    var ob = outbox_new(ORDERED_RESERVE + 4096)
    assert ob.push_snapshot(bytes("version-one-text")).is_ok()
    var sink: Vec<u8> = vec_new<u8>()
    drain(@&ob, @&sink, 5)
    assert ob.mid_frame()
    assert ob.push_snapshot(bytes("v2")).is_ok()
    assert ob.push_snapshot(bytes("v3")).is_ok()
    assert ob.replaced == 1                 # v2 by v3; v1 never
    drain_all(@&ob, @&sink)
    var want = framed("version-one-text")
    let v3 = framed("v3")
    want.push_span(v3[0..v3.len()])
    assert view_of(@sink).eq(view_of(@want))
    0

[[test]]
fn test_queue_stays_under_its_cap() -> i32
    # Past the reserve: one 82-byte frame of 60 x and a 23-byte {} fit, two of x do not.
    var ob = outbox_new(ORDERED_RESERVE + 110)
    var big = string_new()
    for i in 0..60
        big.push('x')
    assert ob.push_snapshot(bytes(big.as_view())).is_ok()
    # A second snapshot replaces the first, so it fits where adding wouldn't.
    assert ob.push_snapshot(bytes(big.as_view())).is_ok()
    assert ob.push(bytes(big.as_view())).is_err()
    assert ob.queued() <= 110
    assert ob.push(bytes("{}")).is_ok()
    assert ob.queued() <= 110
    0

# Snapshots and requests filling the queue leave room for a didClose.
[[test]]
fn test_ordered_frames_have_a_reserve() -> i32
    var ob = outbox_new(ORDERED_RESERVE + 100)
    var big = string_new()
    for i in 0..70
        big.push('x')
    assert ob.push_snapshot(bytes(big.as_view())).is_ok()
    assert ob.push(bytes("{\"id\":2}")).is_err()
    assert ob.push_ordered(bytes("{\"method\":\"textDocument/didClose\"}")).is_ok()
    assert ob.queued() <= ORDERED_RESERVE + 100
    0

# A didOpen after a waiting didChange keeps its place: the next snapshot
# may not jump ahead of it, so it can't replace the one before it either.
[[test]]
fn test_ordered_frame_fixes_the_snapshot_before_it() -> i32
    var ob = outbox_new(ORDERED_RESERVE + 4096)
    assert ob.push_snapshot(bytes("change-a")).is_ok()
    assert ob.push_ordered(bytes("close-a")).is_ok()
    assert ob.push_snapshot(bytes("change-b")).is_ok()
    assert ob.replaced == 0
    var sink: Vec<u8> = vec_new<u8>()
    drain_all(@&ob, @&sink)
    var want = framed("change-a")
    let c = framed("close-a")
    want.push_span(c[0..c.len()])
    let b = framed("change-b")
    want.push_span(b[0..b.len()])
    assert view_of(@sink).eq(view_of(@want))
    0
