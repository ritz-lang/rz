# test/test_editor.ritz - modes and the first-release command list (AGAST #4818),
# then counts and operators (#4909) and Visual mode (#4910).
#
# Each command in docs/BUDDHAFINGER_PROPOSAL.md's "First usable release"
# table, driven by key sequences, asserting the buffer, the cursor and the
# mode, with the refusal messages and the edge cases: the empty buffer, the
# last line, a search that wraps. Files go through an in-memory FileStore.

import ritzlib.errno { Errno }
import ritzlib.gvec
import ritzlib.option
import ritzlib.result { Result }
import ritzlib.span
import ritzlib.strview
import ritzlib.string
import ritzlib.termsession { Key }

import core.buffer { Buffer, pos }
import core.editor { Editor, LangAsk, editor_new, editor_open, handle_key, jump_to, MSG_NO_JUMP, MSG_NOT_SAVED, MSG_TOO_LONG, MAX_JUMPS }
import core.files { FileStore, LoadError, SaveError }
import core.modes { Mode, mode_label }
import core.screen { LineSource, Size, render, screen_new, view_new }
import core.utf8 { utf8_encode }

# ============================================================================
# An in-memory FileStore: one file on "disk", and the last save.
# ============================================================================

# Another file load finds.
struct DiskFile
    path: String
    text: Vec<u8>

struct Disk
    disk_path: String       # the first file load finds
    disk: Vec<u8>
    more: Vec<DiskFile>     # the others (add)
    saved_path: String      # the last save's path and bytes
    saved: Vec<u8>
    saves: i64
    fail_load: bool         # load fails with EACCES
    fail_save: bool         # save fails with ENOSPC
    changed: bool           # save refuses: changed on disk

fn disk_new() -> Disk
    Disk { disk_path: string_new(), disk: vec_new<u8>(), more: vec_new<DiskFile>(), saved_path: string_new(), saved: vec_new<u8>(), saves: 0, fail_load: false, fail_save: false, changed: false }

fn disk_with(path: StrView, text: StrView) -> Disk
    var d = disk_new()
    d.disk_path.push_str(path)
    d.disk.push_view(text)
    d

impl Disk
    # One more file on the disk.
    fn add(self: @&Disk, path: StrView, text: StrView)
        var bytes: Vec<u8> = vec_new<u8>()
        bytes.push_view(text)
        self.more.push(DiskFile { path: string_from(path), text: bytes })

impl FileStore for Disk
    fn load(self: @&Disk, path: StrView) -> Result<Vec<u8>, LoadError>
        if self.fail_load
            return Err(LoadError.Failed(Errno.Acces))
        var out: Vec<u8> = vec_new<u8>()
        if path.eq(self.disk_path.as_view())
            out.push_span(span_from_vec<u8>(@self.disk))
            return Ok(out)
        for i in 0..self.more.len()
            if path.eq(self.more[i].path.as_view())
                out.push_span(span_from_vec<u8>(@self.more[i].text))
                return Ok(out)
        Err(LoadError.NotFound)

    fn save(self: @&Disk, path: StrView, buf: @Buffer) -> Result<(), SaveError>
        if self.changed
            return Err(SaveError.Changed)
        if self.fail_save
            return Err(SaveError.Failed(Errno.NoSpc))
        self.saved_path.clear()
        self.saved_path.push_str(path)
        self.saved.clear()
        let bytes = buf.serialize()
        self.saved.push_span(span_from_vec<u8>(@bytes))
        self.saves += 1
        Ok(())

# ============================================================================
# Helpers
# ============================================================================

fn open(text: StrView) -> Editor
    editor_open("f.txt", span_from_strview(text))

# Feed `keys`: each byte a key, except `<esc>` `<cr>` `<bs>` `<tab>`
# `<up>` `<down>` `<left>` `<right>` and `<C-x>` (Ctrl plus a letter).
fn feed(ed: @&Editor, d: @&Disk, keys: StrView)
    var i: i64 = 0
    while i < keys.len
        let c = keys.get(i)
        if c == '<'
            let close = keys.slice(i, keys.len).find_byte('>')
            if close > 0
                let name = keys.slice(i + 1, i + close)
                handle_key<Disk>(ed, d, key_named(name))
                i += close + 1
                continue
        handle_key<Disk>(ed, d, Key.Char(c as u32))
        i += 1

fn key_named(name: StrView) -> Key
    if name.eq("esc")
        return Key.Escape
    if name.eq("cr")
        return Key.Enter
    if name.eq("bs")
        return Key.Backspace
    if name.eq("tab")
        return Key.Tab
    if name.eq("up")
        return Key.Up
    if name.eq("down")
        return Key.Down
    if name.eq("left")
        return Key.Left
    if name.eq("right")
        return Key.Right
    if name.len == 3 and name.starts_with("C-")
        return Key.Ctrl(name.get(2))
    Key.Unknown

# A fresh editor on `text` with `keys` fed through an empty disk.
fn run(text: StrView, keys: StrView) -> Editor
    var ed = open(text)
    var d = disk_new()
    feed(@&ed, @&d, keys)
    ed

# A fresh, unnamed editor (the not-found/new-buffer path: editor_new, not
# editor_open) with `keys` fed through an empty disk.
fn run_new(keys: StrView) -> Editor
    var ed = editor_new()
    var d = disk_new()
    feed(@&ed, @&d, keys)
    ed

fn holds(ed: @Editor, want: StrView) -> bool
    let out = ed.buf().serialize()
    let got = span_from_vec<u8>(@out)
    if got.len != want.len
        return false
    for i in 0..got.len
        if got[i] != want.get(i)
            return false
    true

fn at(ed: @Editor, line: i64, col: i64) -> bool
    ed.cursor.line == line and ed.cursor.col == col

# The unnamed register holds `want`, whole lines when `lines`.
fn reg_is(ed: @Editor, want: StrView, lines: bool) -> bool
    span_from_vec<u8>(@ed.reg).as_strview().eq(want) and ed.reg_lines == lines

fn says(ed: @Editor, want: StrView) -> bool
    ed.message.as_view().eq(want)

fn saved(d: @Disk, want: StrView) -> bool
    let got = span_from_vec<u8>(@d.saved)
    if got.len != want.len
        return false
    for i in 0..got.len
        if got[i] != want.get(i)
            return false
    true

# ============================================================================
# Modes
# ============================================================================

[[test]]
fn test_modes_and_labels() -> i32
    assert mode_label(Mode.Normal).eq("NORMAL")
    assert mode_label(Mode.Insert).eq("INSERT")
    assert mode_label(Mode.CommandLine).eq("COMMAND")
    var ed = open("abc")
    var d = disk_new()
    assert ed.mode == Mode.Normal
    feed(@&ed, @&d, "i")
    assert ed.mode == Mode.Insert
    feed(@&ed, @&d, "<esc>:")
    assert ed.mode == Mode.CommandLine
    assert ed.command_line().eq(":")
    feed(@&ed, @&d, "<esc>/")
    assert ed.mode == Mode.CommandLine
    assert ed.command_line().eq("/")
    feed(@&ed, @&d, "<esc>")
    assert ed.mode == Mode.Normal
    0

[[test]]
fn test_command_line_backspace_on_empty_cancels() -> i32
    let ed = run("abc", ":q<bs>")
    assert ed.mode == Mode.CommandLine and ed.command_line().eq(":")
    let ed2 = run("abc", ":q<bs><bs>")
    assert ed2.mode == Mode.Normal
    assert not ed2.quit
    0

[[test]]
fn test_unknown_normal_key_does_nothing() -> i32
    let ed = run("abc", "lZ")
    assert holds(@ed, "abc") and at(@ed, 0, 1) and ed.mode == Mode.Normal
    0

# ============================================================================
# Motion
# ============================================================================

[[test]]
fn test_h_l_and_arrows_stay_on_the_line() -> i32
    assert at(@run("abc\ndef", "l"), 0, 1)
    assert at(@run("abc\ndef", "lll"), 0, 2)          # never past the last char
    assert at(@run("abc\ndef", "llh"), 0, 1)
    assert at(@run("abc\ndef", "h"), 0, 0)
    assert at(@run("abc\ndef", "<right><right><left>"), 0, 1)
    assert at(@run("abc\ndef", "jlh<left><left>"), 1, 0)  # never to the line above
    # By code point: é is two bytes.
    assert at(@run("éa", "l"), 0, 2)
    assert at(@run("éa", "lh"), 0, 0)
    0

[[test]]
fn test_j_k_and_arrows_keep_the_column() -> i32
    let ed = run("abcd\nx\nabcd", "lllj")
    assert at(@ed, 1, 0)
    assert at(@run("abcd\nx\nabcd", "lllj<down>"), 2, 3)   # the wanted column comes back
    assert at(@run("abcd\nx\nabcd", "G<up><up>"), 0, 0)
    assert at(@run("abcd\nx\nabcd", "k"), 0, 0)            # nothing above the first line
    0

[[test]]
fn test_j_stops_at_the_last_line_not_the_empty_one_after_the_final_newline() -> i32
    let ed = run("a\nb\n", "jjj")
    assert at(@ed, 1, 0)
    assert ed.line_count() == 2
    assert run("", "jk").line_count() == 1
    0

[[test]]
fn test_w_moves_to_word_starts() -> i32
    assert at(@run("foo bar", "w"), 0, 4)
    assert at(@run("foo.bar", "w"), 0, 3)                  # punctuation is its own word
    assert at(@run("foo.bar", "ww"), 0, 4)
    assert at(@run("foo\n  bar", "w"), 1, 2)               # across the line break
    assert at(@run("foo\n\nbar", "w"), 1, 0)               # an empty line is a word
    assert at(@run("foo bar", "ww"), 0, 6)                 # the last word: its last char
    0

[[test]]
fn test_b_moves_to_word_starts_backward() -> i32
    assert at(@run("foo bar", "$b"), 0, 4)
    assert at(@run("foo bar", "$bb"), 0, 0)
    assert at(@run("foo.bar", "$b"), 0, 4)
    assert at(@run("foo.bar", "$bb"), 0, 3)
    assert at(@run("foo\n  bar", "jwb"), 0, 0)
    assert at(@run("foo\n\nbar", "Gb"), 1, 0)
    assert at(@run("foo", "b"), 0, 0)
    0

[[test]]
fn test_e_moves_to_word_ends() -> i32
    assert at(@run("foo bar", "e"), 0, 2)
    assert at(@run("foo bar", "ee"), 0, 6)
    assert at(@run("foo.bar", "e"), 0, 2)
    assert at(@run("foo.bar", "ee"), 0, 3)
    assert at(@run("foo\n\n  bar", "ee"), 2, 4)            # e skips empty lines
    assert at(@run("ab", "ee"), 0, 1)
    0

[[test]]
fn test_0_and_dollar() -> i32
    assert at(@run("abc", "$"), 0, 2)
    assert at(@run("abc", "$0"), 0, 0)
    assert at(@run("aé", "$"), 0, 1)                      # the last char's first byte
    assert at(@run("", "$"), 0, 0)
    0

[[test]]
fn test_gg_and_G_go_to_the_first_non_blank() -> i32
    assert at(@run("a\nb\n  c\n", "G"), 2, 2)
    assert at(@run("  a\nb\nc", "Ggg"), 0, 2)
    # A lone g waits for the second; any other key drops it.
    assert at(@run("a\nb\nc", "Ggjgg"), 0, 0)
    assert at(@run("a\nb\nc", "Ggk"), 1, 0)
    0

[[test]]
fn test_ctrl_f_and_ctrl_b_page() -> i32
    var text = string_new()
    for i in 0..100
        text.push_i64(i)
        text.push('\n')
    var ed = open(text.as_view())
    var d = disk_new()
    ed.resize(Size { rows: 24, cols: 80 })    # 22 text rows: 20 lines turn over per page
    feed(@&ed, @&d, "<C-f>")
    assert ed.cursor.line == 20 and ed.top == 20
    feed(@&ed, @&d, "<C-f><C-b>")
    assert ed.top == 20 and ed.cursor.line == 41
    feed(@&ed, @&d, "<C-b><C-b>")
    assert ed.top == 0
    feed(@&ed, @&d, "<C-f><C-f><C-f><C-f><C-f><C-f>")
    assert ed.cursor.line == 99                        # stops at the last line
    0

[[test]]
fn test_motions_on_the_empty_buffer() -> i32
    let ed = run("", "hjkl<up><down><left><right>wbe0$ggG<C-f><C-b>nN")
    assert at(@ed, 0, 0) and holds(@ed, "") and ed.mode == Mode.Normal
    0

# ============================================================================
# Insert
# ============================================================================

[[test]]
fn test_i_inserts_before_and_escape_steps_back() -> i32
    let ed = run("ac", "lib<esc>")
    assert holds(@ed, "abc") and at(@ed, 0, 1) and ed.mode == Mode.Normal
    0

[[test]]
fn test_a_appends_after() -> i32
    assert holds(@run("ac", "ab<esc>"), "abc")
    assert holds(@run("ab", "$ac<esc>"), "abc")
    assert holds(@run("", "ax<esc>"), "x")
    0

[[test]]
fn test_o_and_O_open_lines() -> i32
    let ed = run("a\nc\n", "ob<esc>")
    assert holds(@ed, "a\nb\nc\n") and at(@ed, 1, 0)
    assert holds(@run("b\n", "Oa<esc>"), "a\nb\n")
    assert holds(@run("a", "ob<esc>"), "a\nb")             # last line, no final newline
    assert holds(@run("a\r\nc", "ob<esc>"), "a\r\nb\r\nc")  # the line's own terminator
    assert holds(@run("", "Ox<esc>"), "x\n")
    0

[[test]]
fn test_insert_backspace_enter_tab_and_text() -> i32
    assert holds(@run("abc", "$a<bs><bs>x<esc>"), "ax")
    assert holds(@run("ab", "li<cr><esc>"), "a\nb")
    assert holds(@run("a\nb", "ji<bs><esc>"), "ab")           # joins at the line start
    assert at(@run("a\nb", "ji<bs><esc>"), 0, 0)
    assert holds(@run("ab", "i<bs><esc>"), "ab")              # nothing before the start
    assert holds(@run("a", "i<tab><esc>"), "\ta")
    var ed = open("")
    var d = disk_new()
    feed(@&ed, @&d, "i")
    handle_key<Disk>(@&ed, @&d, Key.Char(0xE9))               # é
    handle_key<Disk>(@&ed, @&d, Key.Char(0x65E5))             # 日
    assert holds(@ed, "é日") and ed.cursor.col == 5
    0

[[test]]
fn test_enter_on_a_brand_new_files_only_line_shows_the_new_row() -> i32
    # AGAST #4906: the not-found path (editor_new's Buffer) starts with one
    # empty, unterminated line, the same shape a loaded file's last line
    # has after a final newline. Splitting that one-and-only line must
    # still count the new line as shown while the cursor sits on it,
    # or the screen clamps the cursor back onto row 0.
    var ed = editor_new()
    var d = disk_new()
    feed(@&ed, @&d, "iabc<cr>")
    assert holds(@ed, "abc\n") and at(@ed, 1, 0)
    assert ed.line_count() == 2             # the new row must already be shown
    feed(@&ed, @&d, "x")
    assert holds(@ed, "abc\nx") and at(@ed, 1, 1)
    assert ed.line_count() == 2
    0

[[test]]
fn test_o_on_a_brand_new_empty_file_shows_the_new_row() -> i32
    # Same shape, reached through `o` instead of Insert-mode Enter.
    var ed = editor_new()
    var d = disk_new()
    feed(@&ed, @&d, "o")
    assert at(@ed, 1, 0) and ed.line_count() == 2
    feed(@&ed, @&d, "b<esc>")
    assert holds(@ed, "\nb") and ed.line_count() == 2
    0

[[test]]
fn test_dd_and_p_on_a_brand_new_empty_file_match_the_loaded_case() -> i32
    # dd and p on the lone line of a not-found buffer behave exactly as
    # they do on a loaded file's lone empty line: both no-ops.
    let new_ed = run_new("dd")
    assert holds(@new_ed, "") and at(@new_ed, 0, 0) and new_ed.line_count() == 1
    let new_p = run_new("p")
    assert holds(@new_p, "") and at(@new_p, 0, 0) and new_p.line_count() == 1
    assert holds(@run("", "dd"), "") and at(@run("", "dd"), 0, 0)
    assert holds(@run("", "p"), "") and at(@run("", "p"), 0, 0)
    0

[[test]]
fn test_escape_at_line_start_stays() -> i32
    let ed = run("abc", "i<esc>")
    assert at(@ed, 0, 0)
    0

[[test]]
fn test_utf8_encode() -> i32
    let a = utf8_encode('A' as u32)
    assert a.len() == 1 and a[0] == 'A'
    let e = utf8_encode(0xE9)
    assert e.len() == 2 and e[0] == 0xC3 and e[1] == 0xA9
    let ri = utf8_encode(0x65E5)
    assert ri.len() == 3 and ri[0] == 0xE6 and ri[1] == 0x97 and ri[2] == 0xA5
    let g = utf8_encode(0x1F600)
    assert g.len() == 4 and g[0] == 0xF0 and g[3] == 0x80
    # Not a scalar value: U+FFFD.
    let bad = utf8_encode(0xD800)
    assert bad.len() == 3 and bad[0] == 0xEF and bad[1] == 0xBF and bad[2] == 0xBD
    0

# ============================================================================
# Edit: x dd yy p P and the unnamed register
# ============================================================================

[[test]]
fn test_x_deletes_the_char_under_the_cursor() -> i32
    let ed = run("abc", "lx")
    assert holds(@ed, "ac") and at(@ed, 0, 1)
    let last = run("abc", "$x")
    assert holds(@last, "ab") and at(@last, 0, 1)            # the cursor steps back
    assert holds(@run("éb", "x"), "b")                         # a whole code point
    assert holds(@run("\nb", "x"), "\nb")                      # an empty line: nothing
    assert holds(@run("", "x"), "")
    0

[[test]]
fn test_dd_deletes_lines() -> i32
    let ed = run("a\nb\nc\n", "jdd")
    assert holds(@ed, "a\nc\n") and at(@ed, 1, 0)
    let last = run("a\nb\nc\n", "Gdd")
    assert holds(@last, "a\nb\n") and at(@last, 1, 0)
    assert holds(@run("a\nb", "Gdd"), "a")                      # no final newline
    assert holds(@run("a\n", "dd"), "")
    assert holds(@run("", "dd"), "")
    # d then a key that is no motion is dropped, and so is the d.
    assert holds(@run("ab", "dz"), "ab")
    assert holds(@run("ab", "dzx"), "b")
    0

[[test]]
fn test_yy_p_and_P_put_lines() -> i32
    let ed = run("a\nb\n", "yyjp")
    assert holds(@ed, "a\nb\na\n") and at(@ed, 2, 0)
    assert holds(@run("a\nb\n", "jyykP"), "b\na\nb\n")
    assert holds(@run("a", "yyp"), "a\na")                     # after a last line with no newline
    assert holds(@run("a\nb", "Gddp"), "a\nb")
    assert holds(@run("  a\nb", "yyjp"), "  a\nb\n  a")
    assert at(@run("  a\nb", "yyjp"), 2, 2)
    0

[[test]]
fn test_x_then_p_and_P_put_chars() -> i32
    let ed = run("abc", "xp")
    assert holds(@ed, "bac") and at(@ed, 0, 1)
    assert holds(@run("abc", "x$P"), "bac")
    assert holds(@run("abc", "p"), "abc")                      # empty register: nothing
    assert holds(@run("ab\n\n", "xjp"), "b\na\n")              # into an empty line
    0

[[test]]
fn test_yank_keeps_the_buffer_clean() -> i32
    let ed = run("a\nb", "yy")
    assert not ed.buf().is_dirty()
    assert ed.reg_lines
    0

# ============================================================================
# Counts and operators (AGAST #4909)
# ============================================================================

[[test]]
fn test_a_count_repeats_a_motion() -> i32
    assert at(@run("abcdef", "3l"), 0, 3)
    assert at(@run("abc", "5l"), 0, 2)                      # as far as it goes
    assert at(@run("abcdef", "$3h"), 0, 2)
    assert at(@run("abcdefghijklm", "10l"), 0, 10)
    assert at(@run("a\nb\nc\nd", "2j"), 2, 0)
    assert at(@run("a\nb\nc\nd", "9j"), 3, 0)
    assert at(@run("a\nb\nc\nd", "G2k"), 1, 0)
    assert at(@run("a b c d", "2w"), 0, 4)
    assert at(@run("ab cd ef", "2e"), 0, 4)
    assert at(@run("ab cd ef", "$2b"), 0, 3)
    assert at(@run("ab\ncd", "2$"), 1, 1)
    assert at(@run("ab", "2$"), 0, 0)                       # no line below: no move
    0

[[test]]
fn test_a_count_names_the_line_for_G_and_gg() -> i32
    assert at(@run("a\nb\nc", "2G"), 1, 0)
    assert at(@run("a\nb\nc", "9G"), 2, 0)
    assert at(@run("a\n  b\nc", "G2gg"), 1, 2)
    0

[[test]]
fn test_d_with_charwise_exclusive_motions() -> i32
    let ed = run("foo bar", "dw")
    assert holds(@ed, "bar") and at(@ed, 0, 0) and reg_is(@ed, "foo ", false)
    assert holds(@run("a b c", "d2w"), "c")
    assert holds(@run("a b c d e f g h", "2d3w"), "g h")
    let back = run("foo bar", "$db")
    assert holds(@back, "foo r") and at(@back, 0, 4)
    assert holds(@run("foo bar", "wd0"), "bar")
    let h = run("abc", "$dh")
    assert holds(@h, "ac") and at(@h, 0, 1)
    assert holds(@run("abc", "dh"), "abc")                   # nothing left of it
    assert holds(@run("abc", "chx<esc>"), "xabc")             # c still inserts
    assert holds(@run("abcdef", "3x"), "def")
    let x = run("ab", "l5x")
    assert holds(@x, "a") and at(@x, 0, 0)
    assert holds(@run("ab", "dl"), "b")
    0

[[test]]
fn test_dw_on_a_lines_last_word_keeps_the_line_break() -> i32
    let ed = run("foo bar\nbaz", "wdw")
    assert holds(@ed, "foo \nbaz") and at(@ed, 0, 3)
    assert holds(@run("foo   \nbar", "dw"), "\nbar")
    assert holds(@run("ab", "ldw"), "a")                    # the last line too
    0

[[test]]
fn test_d_with_charwise_inclusive_motions() -> i32
    assert holds(@run("foo bar", "de"), " bar")
    assert holds(@run("foo bar baz", "d2e"), " baz")
    let dollar = run("foo bar", "wd$")
    assert holds(@dollar, "foo ") and at(@dollar, 0, 3)
    assert holds(@run("foo bar", "wD"), "foo ")
    assert holds(@run("ab\ncd\nef", "l2D"), "a\nef")
    assert holds(@run("éa b", "de"), " b")                   # é is two bytes
    0

[[test]]
fn test_d_with_linewise_motions() -> i32
    let ed = run("a\nb\nc\n", "dj")
    assert holds(@ed, "c\n") and at(@ed, 0, 0) and reg_is(@ed, "a\nb\n", true)
    assert holds(@run("a\nb\nc\n", "jdk"), "c\n")
    assert holds(@run("a\nb", "dk"), "a\nb")               # nothing above
    assert holds(@run("a\nb", "jdj"), "a\nb")              # nothing below
    assert holds(@run("a\nb\nc\n", "jdG"), "a\n")
    assert holds(@run("a\nb\nc\n", "jdgg"), "c\n")
    assert holds(@run("a\nb\nc\nd\n", "d2j"), "d\n")
    assert holds(@run("a\nb\nc\nd", "2dG"), "c\nd")      # dG to line 2
    0

[[test]]
fn test_a_count_before_dd() -> i32
    let ed = run("a\nb\nc\nd\n", "3dd")
    assert holds(@ed, "d\n") and reg_is(@ed, "a\nb\nc\n", true)
    assert holds(@run("a\nb\nc\n", "j5dd"), "a\n")      # as many as there are
    assert holds(@run("a\nb\n", "j2dd"), "a\nb\n")      # none below the last line
    assert holds(@run("a\nb", "2dd"), "")
    0

[[test]]
fn test_d_across_lines_from_the_indent_to_a_blank_end_takes_whole_lines() -> i32
    # A charwise d spanning lines, blank before its start and after its
    # end, deletes the lines whole.
    let ed = run("a\nb\nc", "d2w")
    assert holds(@ed, "c") and reg_is(@ed, "a\nb\n", true)
    # An exclusive motion ending at a line start ends at the line above's
    # end instead: from the indent, whole lines (dw on an empty line) ...
    assert holds(@run("a\n\nb", "jdw"), "a\nb")
    assert holds(@run("a\n\nb", "d2w"), "b")
    # ... and otherwise up to that end.
    let mid = run("x a\n\nb", "wd2w")
    assert holds(@mid, "x \nb") and reg_is(@mid, "a\n", false)
    0

[[test]]
fn test_y_yanks_without_changing_the_text() -> i32
    let ed = run("foo bar", "yw")
    assert holds(@ed, "foo bar") and at(@ed, 0, 0) and reg_is(@ed, "foo ", false)
    assert not ed.buf().is_dirty()
    assert holds(@run("foo bar", "ywP"), "foo foo bar")
    assert at(@run("foo bar", "$yb"), 0, 4)                 # to the range's start
    assert holds(@run("a\nb\nc", "yjGp"), "a\nb\nc\na\nb")
    assert holds(@run("a\nb", "Yjp"), "a\nb\na")          # Y is yy
    assert at(@run("ab\ncd\nef", "jlyk"), 0, 1)            # up a line, the column kept
    assert at(@run("ab\ncd\nef", "lyj"), 0, 1)             # the cursor stays
    0

[[test]]
fn test_cw_changes_to_the_words_end() -> i32
    assert holds(@run("foo bar", "cwx<esc>"), "x bar")
    assert holds(@run("foo bar", "llcwx<esc>"), "fox bar")  # on the word's last char
    assert holds(@run("a b c", "c2wx<esc>"), "x c")
    assert holds(@run("a  b", "lcwx<esc>"), "axb")           # on blanks: to the next word
    let ed = run("foo bar", "cw")
    assert ed.mode == Mode.Insert and at(@ed, 0, 0) and reg_is(@ed, "foo", false)
    0

[[test]]
fn test_c_with_other_motions() -> i32
    assert holds(@run("foo bar", "wCx<esc>"), "foo x")
    assert holds(@run("foo bar", "c$x<esc>"), "x")
    assert holds(@run("ab", "clx<esc>"), "xb")
    assert holds(@run("\nb", "clx<esc>"), "x\nb")           # an empty range still inserts
    0

[[test]]
fn test_cc_and_linewise_c_leave_one_line_to_type_on() -> i32
    let ed = run("  a\nb", "ccx<esc>")
    assert holds(@ed, "x\nb") and reg_is(@ed, "  a\n", true)
    assert holds(@run("a\nb\nc", "cjx<esc>"), "x\nc")
    assert holds(@run("a\nb\nc\n", "j2ccx<esc>"), "a\nx\n")
    let none = run("a\nb\n", "j2cc")                         # no line below the last
    assert none.mode == Mode.Normal and holds(@none, "a\nb\n")
    let open = run("a\nb", "cc")
    assert open.mode == Mode.Insert and at(@open, 0, 0) and holds(@open, "\nb")
    0

[[test]]
fn test_c_and_its_insert_are_one_undo_step() -> i32
    let ed = run("foo bar", "cwxy<esc>u")
    assert holds(@ed, "foo bar") and not ed.buf().is_dirty()
    assert holds(@run("a\nb", "ccxy<esc>u"), "a\nb")
    assert holds(@run("foo bar", "cwxy<esc>u<C-r>"), "xy bar")
    0

[[test]]
fn test_escape_or_an_unknown_key_cancels_a_count_or_operator() -> i32
    assert holds(@run("abc", "d<esc>x"), "bc")
    assert holds(@run("abc", "2<esc>x"), "bc")                 # the count is gone too
    assert holds(@run("abc", "dclx"), "ac")                  # dc cancels; l then x
    assert holds(@run("abc", "2dzx"), "bc")
    0

[[test]]
fn test_a_count_repeats_p_u_and_n() -> i32
    let ed = run("ab", "x3p")
    assert holds(@ed, "baaa") and at(@ed, 0, 3)
    let lines = run("a\nb", "yy2p")
    assert holds(@lines, "a\na\na\nb") and at(@lines, 1, 0)
    assert holds(@run("a\nb", "yy2pu"), "a\nb")           # one undo step
    assert holds(@run("abc", "xxx2u"), "bc")
    assert at(@run("ab ab ab ab", "/ab<cr>2n"), 0, 9)
    assert at(@run("ab ab ab ab", "$2N"), 0, 10)              # no pattern: stays
    0

[[test]]
fn test_a_put_too_long_is_refused() -> i32
    let ed = run("ab", "x99999999p")
    assert holds(@ed, "b") and says(@ed, MSG_TOO_LONG)
    0

