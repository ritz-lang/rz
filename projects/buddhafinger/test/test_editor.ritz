[[test]]
fn test_w_saves_and_marks_clean() -> i32
    var ed = open("ab")
    var d = disk_new()
    feed(@&ed, @&d, "x:w<cr>")
    assert d.saves == 1 and saved(@d, "b") and d.saved_path.as_view().eq("f.txt")
    assert not ed.buf().is_dirty() and ed.mode == Mode.Normal
    assert says(@ed, "\"f.txt\" 1L, 1B written")
    0

[[test]]
fn test_w_without_a_name_is_refused() -> i32
    var ed = editor_new()
    var d = disk_new()
    feed(@&ed, @&d, "ix<esc>:w<cr>")
    assert d.saves == 0 and ed.buf().is_dirty()
    assert says(@ed, "E32: No file name")
    0

[[test]]
fn test_w_path_names_an_unnamed_buffer() -> i32
    var ed = editor_new()
    var d = disk_new()
    feed(@&ed, @&d, "ix<esc>:w new.txt<cr>")
    assert d.saves == 1 and d.saved_path.as_view().eq("new.txt")
    assert ed.path().eq("new.txt") and not ed.buf().is_dirty()
    0

[[test]]
fn test_w_other_path_writes_a_copy() -> i32
    var ed = open("ab")
    var d = disk_new()
    feed(@&ed, @&d, "x:w copy.txt<cr>")
    assert d.saves == 1 and d.saved_path.as_view().eq("copy.txt") and saved(@d, "b")
    assert ed.path().eq("f.txt") and ed.buf().is_dirty()
    0

[[test]]
fn test_failed_save_keeps_the_buffer_dirty() -> i32
    var ed = open("ab")
    var d = disk_new()
    d.fail_save = true
    feed(@&ed, @&d, "x:w<cr>")
    assert ed.buf().is_dirty()
    assert says(@ed, "\"f.txt\" not written: No space left on device")
    d.fail_save = false
    d.changed = true
    feed(@&ed, @&d, ":wq<cr>")
    assert ed.buf().is_dirty() and not ed.quit
    assert says(@ed, "\"f.txt\" changed on disk since it was read: not written")
    0

[[test]]
fn test_q_is_refused_with_pending_edits() -> i32
    let ed = run("ab", "x:q<cr>")
    assert not ed.quit
    assert says(@ed, "E37: No write since last change (add ! to override)")
    assert run("ab", ":q<cr>").quit
    assert run("ab", "xu:q<cr>").quit                         # undone: nothing pending
    0

[[test]]
fn test_q_bang_quits_anyway() -> i32
    let ed = run("ab", "x:q!<cr>")
    assert ed.quit
    0

[[test]]
fn test_wq_writes_then_quits() -> i32
    var ed = open("ab")
    var d = disk_new()
    feed(@&ed, @&d, "x:wq<cr>")
    assert ed.quit and d.saves == 1 and saved(@d, "b")
    0

[[test]]
fn test_e_opens_another_buffer() -> i32
    var ed = open("ab")
    var d = disk_with("g.txt", "one\ntwo\n")
    feed(@&ed, @&d, "j:e g.txt<cr>")
    assert holds(@ed, "one\ntwo\n") and at(@ed, 0, 0)
    assert ed.path().eq("g.txt") and not ed.buf().is_dirty()
    assert says(@ed, "\"g.txt\" 2L, 8B")
    assert ed.buffer_count() == 2 and ed.buffer_number() == 2
    # Each buffer has its own undo history: nothing to undo in g.txt.
    feed(@&ed, @&d, "u")
    assert holds(@ed, "one\ntwo\n")
    0

[[test]]
fn test_e_keeps_a_buffer_with_pending_edits() -> i32
    var ed = open("ab")
    var d = disk_with("g.txt", "one")
    feed(@&ed, @&d, "x:e g.txt<cr>")
    assert holds(@ed, "one") and ed.path().eq("g.txt")
    assert says(@ed, "\"g.txt\" 1L, 3B")
    feed(@&ed, @&d, ":e f.txt<cr>")                 # its buffer, not the disk's
    assert holds(@ed, "b") and ed.buf().is_dirty() and ed.buffer_count() == 2
    feed(@&ed, @&d, "u")                            # with its history
    assert holds(@ed, "ab")
    0

[[test]]
fn test_e_of_a_missing_file_opens_it_empty() -> i32
    var ed = open("ab")
    var d = disk_new()
    feed(@&ed, @&d, ":e new.txt<cr>")
    assert holds(@ed, "") and ed.path().eq("new.txt")
    assert says(@ed, "\"new.txt\" [New]")
    0

[[test]]
fn test_e_that_fails_keeps_the_buffer() -> i32
    var ed = open("ab")
    var d = disk_with("g.txt", "one")
    d.fail_load = true
    feed(@&ed, @&d, ":e g.txt<cr>")
    assert holds(@ed, "ab") and ed.path().eq("f.txt")
    assert says(@ed, "\"g.txt\": Permission denied")
    assert says(@run("ab", ":e<cr>"), "E32: No file name")
    0

[[test]]
fn test_colon_line_goes_to_the_line() -> i32
    assert at(@run("a\nb\n  c\n", ":3<cr>"), 2, 2)
    assert at(@run("a\nb\nc\n", "G:1<cr>"), 0, 0)
    assert at(@run("a\nb\nc\n", ":99<cr>"), 2, 0)              # past the end: the last line
    assert at(@run("a\nb\nc\n", "G:0<cr>"), 0, 0)
    0

[[test]]
fn test_unknown_command_says_so() -> i32
    let ed = run("ab", ":wat<cr>")
    assert says(@ed, "E492: Not an editor command: wat")
    assert ed.mode == Mode.Normal and holds(@ed, "ab")
    0

[[test]]
fn test_a_message_clears_on_the_next_key() -> i32
    let ed = run("ab", ":wat<cr>l")
    assert says(@ed, "")
    0

# ============================================================================
# The screen's view: Editor as the LineSource, status() for the status line
# ============================================================================

[[test]]
fn test_the_screen_shows_the_editor() -> i32
    var ed = open("ab\n")
    var d = disk_new()
    feed(@&ed, @&d, "x")
    let st = ed.status()
    assert st.name.eq("f.txt") and st.dirty and st.mode == Mode.Normal
    var scr = screen_new(Size { rows: 4, cols: 20 })
    var view = view_new()
    render(@&scr, @ed, @&view, ed.status(), ed.message.as_view())
    assert scr.row_text(0).as_view().trim_end().eq("  1 b")
    assert scr.row_text(1).as_view().trim_end().eq("~")       # no line after the final newline
    assert scr.row_text(2).as_view().starts_with(" NORMAL  f.txt [+]")
    0

# text_revision moves on every change to the buffer's text, and stays put
# for motions, a save and an undo with nothing to undo: the event loop
# re-lexes and re-measures lines only when it or the buffer number moves.
[[test]]
fn test_text_revision_follows_text_changes() -> i32
    var d = disk_with("g.txt", "other\n")
    var ed = open("abc\n")
    let r0 = ed.text_revision()
    feed(@&ed, @&d, "ulh0$")
    assert ed.text_revision() == r0
    feed(@&ed, @&d, "x")
    let r1 = ed.text_revision()
    assert r1 > r0
    feed(@&ed, @&d, "u")
    let r2 = ed.text_revision()
    assert r2 > r1
    feed(@&ed, @&d, "<C-r>")
    let r3 = ed.text_revision()
    assert r3 > r2
    feed(@&ed, @&d, ":w<cr>")
    assert ed.text_revision() == r3
    let n = ed.buffer_number()
    feed(@&ed, @&d, ":e g.txt<cr>")
    assert ed.command_line().is_empty()
    assert ed.buffer_number() != n
    feed(@&ed, @&d, ":e f.txt<cr>")                 # back: the same buffer, unchanged
    assert ed.buffer_number() == n and ed.text_revision() == r3
    0

# ============================================================================
# Language keys and jumps (AGAST #4828)
# ============================================================================

[[test]]
fn test_k_and_gd_raise_requests_for_the_loop() -> i32
    var d = disk_new()
    var ed = open("fn f()\nf()\n")
    assert ed.take_ask() == LangAsk.Nothing
    feed(@&ed, @&d, "K")
    assert ed.take_ask() == LangAsk.Hover
    assert ed.take_ask() == LangAsk.Nothing         # taken once
    feed(@&ed, @&d, "jgd")
    assert ed.take_ask() == LangAsk.Definition
    assert ed.cursor.line == 1                      # gd moves nothing itself
    feed(@&ed, @&d, "gg")
    assert ed.take_ask() == LangAsk.Nothing
    assert ed.cursor.line == 0
    0

[[test]]
fn test_jump_in_this_file_and_back() -> i32
    var d = disk_new()
    var ed = open("one\ntwo\nthree\n")
    feed(@&ed, @&d, "jl")
    assert jump_to<Disk>(@&ed, @&d, "f.txt", pos(2, 3))
    assert ed.cursor.line == 2 and ed.cursor.col == 3
    assert ed.jump_depth() == 1
    feed(@&ed, @&d, "<C-o>")
    assert ed.cursor.line == 1 and ed.cursor.col == 1
    assert ed.jump_depth() == 0
    feed(@&ed, @&d, "<C-t>")
    assert ed.message.as_view().eq(MSG_NO_JUMP)
    0

[[test]]
fn test_jump_to_another_file_and_back_switches_buffers() -> i32
    var d = disk_with("g.ritz", "fn g()\n\nfn h()\n")
    var ed = open("abc\nx\n")
    feed(@&ed, @&d, "jx")                           # an edit in f.txt, not saved
    assert jump_to<Disk>(@&ed, @&d, "g.ritz", pos(2, 3))
    assert ed.path().eq("g.ritz")
    assert ed.cursor.line == 2 and ed.cursor.col == 3
    assert ed.buffer_count() == 2
    # Back to f.txt's buffer as it is, its edit kept: nothing is read again
    # (f.txt isn't on the in-memory disk at all).
    feed(@&ed, @&d, "<C-t>")
    assert ed.path().eq("f.txt")
    assert holds(@ed, "abc\n\n") and ed.buf().is_dirty()
    assert ed.cursor.line == 1 and ed.cursor.col == 0
    # And to g.ritz's buffer again: one buffer per file.
    assert jump_to<Disk>(@&ed, @&d, "g.ritz", pos(0, 0))
    assert ed.buffer_count() == 2
    0

[[test]]
fn test_jump_away_keeps_pending_edits() -> i32
    var d = disk_with("g.ritz", "fn g()\n")
    var ed = open("abc\n")
    feed(@&ed, @&d, "x")
    assert jump_to<Disk>(@&ed, @&d, "g.ritz", pos(0, 0))
    assert ed.path().eq("g.ritz") and says(@ed, "\"g.ritz\" 1L, 7B")
    assert ed.jump_depth() == 1
    0

[[test]]
fn test_jump_back_reopens_a_deleted_buffer_or_keeps_the_jump() -> i32
    var d = disk_with("g.ritz", "fn g()\n")
    var ed = open("abc\n")
    assert jump_to<Disk>(@&ed, @&d, "g.ritz", pos(0, 3))
    feed(@&ed, @&d, ":bd 1<cr>")                    # f.txt's buffer gone
    assert ed.buffer_count() == 1
    d.fail_load = true
    feed(@&ed, @&d, "<C-o>")                        # f.txt can't be read again
    assert says(@ed, "\"f.txt\": Permission denied")
    assert ed.path().eq("g.ritz") and ed.jump_depth() == 1
    d.fail_load = false
    feed(@&ed, @&d, "<C-o>")                        # not on disk: [New], empty
    assert ed.path().eq("f.txt") and holds(@ed, "")
    assert ed.jump_depth() == 0
    0

[[test]]
fn test_jump_stack_keeps_the_newest() -> i32
    var d = disk_new()
    var ed = open("a\nb\nc\n")
    for i in 0..MAX_JUMPS + 5
        assert jump_to<Disk>(@&ed, @&d, "f.txt", pos(i % 3, 0))
    assert ed.jump_depth() == MAX_JUMPS
    # The newest jump left from line (MAX_JUMPS + 3) % 3.
    feed(@&ed, @&d, "<C-o>")
    assert ed.cursor.line == (MAX_JUMPS + 3) % 3
    assert ed.path().eq("f.txt")
    0

# ============================================================================
# Visual and Visual Line (AGAST #4910)
# ============================================================================

# The selection's other end, the one the cursor didn't move.
fn anchor_at(ed: @Editor, line: i64, col: i64) -> bool
    ed.anchor.line == line and ed.anchor.col == col

[[test]]
fn test_v_and_V_enter_switch_and_leave() -> i32
    let v = run("abc", "lv")
    assert v.mode == Mode.Visual and anchor_at(@v, 0, 1) and at(@v, 0, 1)
    assert v.status().mode == Mode.Visual
    assert run("abc", "V").mode == Mode.VisualLine
    assert run("abc", "vV").mode == Mode.VisualLine
    assert run("abc", "Vv").mode == Mode.Visual
    assert run("abc", "vv").mode == Mode.Normal
    assert run("abc", "VV").mode == Mode.Normal
    let esc = run("abc", "lv<esc>")
    assert esc.mode == Mode.Normal and at(@esc, 0, 1) and holds(@esc, "abc")
    0

[[test]]
fn test_every_motion_moves_the_cursor_end() -> i32
    let w = run("foo bar baz", "vw")
    assert at(@w, 0, 4) and anchor_at(@w, 0, 0)
    assert at(@run("foo bar baz", "v2w"), 0, 8)
    assert at(@run("foo bar baz", "ve"), 0, 2)
    assert at(@run("foo bar baz", "$vb"), 0, 8)
    assert at(@run("abc\ndef", "lvj"), 1, 1)
    assert at(@run("a\nb\nc\nd", "v2j"), 2, 0)
    assert at(@run("a\nb\nc", "vG"), 2, 0)
    assert at(@run("a\nb\nc", "Gvgg"), 0, 0)
    assert at(@run("abc", "vll"), 0, 2)
    assert at(@run("abc", "vlll"), 0, 2)                    # l stops on the last code point
    # $ selects through the line break: the cursor sits on it.
    assert at(@run("abc\nd", "v$"), 0, 3)
    # Back in Normal mode the cursor returns onto a code point.
    assert at(@run("abc\nd", "v$<esc>"), 0, 2)
    0

[[test]]
fn test_charwise_operators_are_inclusive_of_both_ends() -> i32
    let y = run("foo bar", "vey")
    assert holds(@y, "foo bar") and at(@y, 0, 0) and reg_is(@y, "foo", false) and y.mode == Mode.Normal
    let one = run("foo bar", "wvd")
    assert holds(@one, "foo ar") and at(@one, 0, 4) and reg_is(@one, "b", false)
    let d = run("foo bar", "lvlld")
    assert holds(@d, "fbar") and at(@d, 0, 1) and reg_is(@d, "oo ", false)
    assert holds(@run("foo bar", "lvllx"), "fbar")
    # Selected backwards: the same text.
    let back = run("abcdef", "$vhhd")
    assert holds(@back, "abc") and at(@back, 0, 2)
    # o swaps the ends: the cursor goes to the other one and moves from there.
    let o = run("abcdef", "lvllo")
    assert at(@o, 0, 1) and anchor_at(@o, 0, 3)
    assert holds(@run("abcdef", "lvllohd"), "ef")
    0

[[test]]
fn test_charwise_across_lines() -> i32
    let d = run("abc\ndef", "lvjd")
    assert holds(@d, "af") and at(@d, 0, 1) and reg_is(@d, "bc\nde", false)
    # $ takes the line break too.
    let eol = run("ab\ncd", "v$d")
    assert holds(@eol, "cd") and reg_is(@eol, "ab\n", false)
    # An empty line inside the selection is taken with its break.
    assert holds(@run("a\n\nb\nc", "vjjd"), "\nc")
    # The last line's break is the file's final newline: never selected.
    assert holds(@run("ab\n", "v$d"), "\n")
    0

[[test]]
fn test_charwise_change_and_its_insert_are_one_undo_step() -> i32
    let c = run("foo bar", "vecX<esc>")
    assert holds(@c, "X bar") and c.mode == Mode.Normal
    assert holds(@run("foo bar", "vesX<esc>"), "X bar")
    assert holds(@run("foo bar", "vecX<esc>u"), "foo bar")
    assert holds(@run("abc\ndef", "lvjdu"), "abc\ndef")
    0

[[test]]
fn test_linewise_operators_take_whole_lines() -> i32
    let d = run("a\nb\nc\n", "Vd")
    assert holds(@d, "b\nc\n") and reg_is(@d, "a\n", true) and d.mode == Mode.Normal
    let up = run("a\nb\nc\n", "jVkd")
    assert holds(@up, "c\n") and at(@up, 0, 0) and reg_is(@up, "a\nb\n", true)
    assert holds(@run("a\nb\nc\nd\n", "V2jd"), "d\n")
    let deep = run("x\n  ab\ncd\n", "jllVjd")
    assert holds(@deep, "x\n")
    # y: the cursor goes to the first line's start (Vim's '< for V is column 0).
    let y = run("  ab\ncd\n", "llVjy")
    assert holds(@y, "  ab\ncd\n") and at(@y, 0, 0) and reg_is(@y, "  ab\ncd\n", true)
    let c = run("a\nb\nc\n", "VjcX<esc>")
    assert holds(@c, "X\nc\n")
    assert holds(@run("a\nb\nc\n", "VjcX<esc>u"), "a\nb\nc\n")
    assert holds(@run("a\nb\nc\n", "Vjdu"), "a\nb\nc\n")
    0

[[test]]
fn test_p_over_a_selection_replaces_it() -> i32
    # Charwise over charwise: the replaced text goes to the register.
    let p = run("foo bar", "yewvep")
    assert holds(@p, "foo foo") and at(@p, 0, 6) and reg_is(@p, "bar", false)
    # P keeps the register.
    let keep = run("foo bar", "yewveP")
    assert holds(@keep, "foo foo") and reg_is(@keep, "foo", false)
    # Lines over lines.
    let ll = run("a\nb\nc\n", "yyjVp")
    assert holds(@ll, "a\na\nc\n") and at(@ll, 1, 0) and reg_is(@ll, "b\n", true)
    # Chars over lines: the text becomes the line.
    assert holds(@run("ab\ncd\n", "yljVp"), "ab\na\n")
    # Lines over chars: they go on lines of their own.
    let lc = run("abc\nX\n", "jyyklvp")
    assert holds(@lc, "a\nX\nc\nX\n") and at(@lc, 1, 0) and reg_is(@lc, "b", false)
    # A count repeats the register.
    assert holds(@run("ab", "ylv3p"), "aaab")
    # One undo step.
    assert holds(@run("foo bar", "yewvepu"), "foo bar")
    assert holds(@run("a\nb\nc\n", "yyjVpu"), "a\nb\nc\n")
    # Nothing in the register: the selection just ends.
    let none = run("abc", "vlp")
    assert holds(@none, "abc") and none.mode == Mode.Normal
    0

[[test]]
fn test_gv_reselects_the_last_selection() -> i32
    let g = run("abc def", "vey<esc>wgv")
    assert g.mode == Mode.Visual and anchor_at(@g, 0, 0) and at(@g, 0, 2)
    assert holds(@run("abc def", "vey<esc>wgvd"), " def")
    let lines = run("a\nb\nc\n", "Vj<esc>Ggv")
    assert lines.mode == Mode.VisualLine
    assert holds(@run("a\nb\nc\n", "Vj<esc>Ggvd"), "c\n")
    # Lines deleted since: the ends move onto the text that is left.
    let gone = run("a\nb\nc", "GVk<esc>ddddgv")
    assert gone.mode == Mode.VisualLine and at(@gone, 0, 0)
    # In Visual mode gv swaps with the last selection.
    let swap = run("abc def", "vl<esc>wvegv")
    assert anchor_at(@swap, 0, 0) and at(@swap, 0, 1)
    let back = run("abc def", "vl<esc>wvegvgv")
    assert back.mode == Mode.Visual and anchor_at(@back, 0, 4) and at(@back, 0, 6)
    # Nothing selected yet: no change.
    assert run("abc", "gv").mode == Mode.Normal
    0

# ============================================================================
# Buffers and windows (AGAST #4912)
# ============================================================================

# Window k (in Ctrl-W w order) has its cursor at (line, col).
fn win_at(ed: @Editor, k: i64, line: i64, col: i64) -> bool
    let c = ed.window_cursor(ed.window_at(k))
    c.line == line and c.col == col

fn win_path(ed: @Editor, k: i64) -> StrView
    ed.window_path(ed.window_at(k))

# f.txt (the editor's) and g.txt, h.txt on the disk.
fn disk_gh() -> Disk
    var d = disk_with("g.txt", "g\n")
    d.add("h.txt", "h\n")
    d

[[test]]
fn test_ls_lists_the_buffers() -> i32
    var d = disk_with("g.txt", "one\ntwo\n")
    var ed = open("ab\ncd\n")
    feed(@&ed, @&d, "jx:e g.txt<cr>j:ls<cr>")
    # Vim's columns: number, %/# (current, alternate), a/h (shown, hidden),
    # + (changed), the name, and the cursor line from column 40.
    assert says(@ed, "  1 #h + \"f.txt\"                        line 2\n  2 %a   \"g.txt\"                        line 2")
    # A window split off keeps the alternate; both show f.txt.
    feed(@&ed, @&d, ":e f.txt<cr>u:sp<cr>:ls<cr>")
    assert says(@ed, "  1 %a   \"f.txt\"                        line 2\n  2 #h   \"g.txt\"                        line 2")
    0

[[test]]
fn test_b_bn_and_bp_switch_buffers() -> i32
    var d = disk_gh()
    var ed = open("f\n")
    feed(@&ed, @&d, ":e g.txt<cr>:e h.txt<cr>")
    assert ed.buffer_number() == 3 and ed.buffer_count() == 3
    feed(@&ed, @&d, ":b 1<cr>")
    assert ed.path().eq("f.txt") and holds(@ed, "f\n")
    feed(@&ed, @&d, ":bn<cr>")
    assert ed.buffer_number() == 2
    feed(@&ed, @&d, ":bn<cr>:bn<cr>")
    assert ed.buffer_number() == 1                  # round past the last
    feed(@&ed, @&d, ":bp<cr>")
    assert ed.buffer_number() == 3                  # and back past the first
    feed(@&ed, @&d, ":bprevious<cr>:bnext<cr>:buffer 2<cr>")
    assert ed.buffer_number() == 2
    feed(@&ed, @&d, ":b 9<cr>")
    assert says(@ed, "E86: Buffer 9 does not exist") and ed.buffer_number() == 2
    feed(@&ed, @&d, ":b h<cr>")                     # a name: the one buffer it is part of
    assert ed.path().eq("h.txt")
    feed(@&ed, @&d, ":b txt<cr>")
    assert says(@ed, "E93: More than one match for txt")
    feed(@&ed, @&d, ":b zz<cr>")
    assert says(@ed, "E94: No matching buffer for zz")
    feed(@&ed, @&d, ":b<cr>")                       # bare: this one
    assert ed.path().eq("h.txt") and says(@ed, "")
    0

[[test]]
fn test_a_buffer_comes_back_with_its_cursor() -> i32
    var d = disk_with("g.txt", "one\ntwo\n")
    var ed = open("a\nbcd\ne\n")
    feed(@&ed, @&d, "jl:e g.txt<cr>j:b1<cr>")
    assert at(@ed, 1, 1)
    feed(@&ed, @&d, ":bn<cr>")
    assert at(@ed, 1, 0)
    0

[[test]]
fn test_bd_deletes_a_buffer() -> i32
    var d = disk_with("g.txt", "one\n")
    var ed = open("ab")
    feed(@&ed, @&d, ":e g.txt<cr>:bd<cr>")
    assert ed.buffer_count() == 1 and ed.path().eq("f.txt")
    # Numbers aren't used again: g.txt comes back as buffer 3.
    feed(@&ed, @&d, ":e g.txt<cr>x:bd<cr>")
    assert ed.buffer_number() == 3 and ed.buffer_count() == 2
    assert says(@ed, "E89: No write since last change for buffer 3 (add ! to override)")
    feed(@&ed, @&d, ":bd!<cr>")
    assert ed.buffer_count() == 1 and ed.path().eq("f.txt")
    feed(@&ed, @&d, ":bd 7<cr>")
    assert says(@ed, "E516: No buffers were deleted: bd 7")
    # The last buffer: an empty one with no name in its place.
    feed(@&ed, @&d, ":bdelete<cr>")
    assert ed.buffer_count() == 1 and ed.path().is_empty() and holds(@ed, "")
    assert ed.buffer_number() == 4
    0

# :bd shows the alternate buffer, even when another is nearer in the list.
[[test]]
fn test_bd_shows_the_alternate_buffer() -> i32
    var d = disk_gh()
    var ed = open("f\n")
    feed(@&ed, @&d, ":e g.txt<cr>:e h.txt<cr>:b1<cr>:b3<cr>")     # in h.txt, f.txt alternate
    feed(@&ed, @&d, ":bd<cr>")
    assert ed.path().eq("f.txt") and ed.buffer_count() == 2
    0

[[test]]
fn test_bd_of_a_buffer_in_other_windows_closes_them() -> i32
    var d = disk_with("g.txt", "one\n")
    var ed = open("ab")
    feed(@&ed, @&d, ":e g.txt<cr>:sp<cr>:sp<cr>")
    assert ed.window_count() == 3
    feed(@&ed, @&d, ":bd<cr>")
    assert ed.window_count() == 1 and ed.path().eq("f.txt")
    # Another window's buffer, by number: its window goes, this one stays.
    feed(@&ed, @&d, ":sp g.txt<cr><C-w>j:bd 3<cr>")
    assert ed.window_count() == 1 and ed.path().eq("f.txt") and ed.buffer_count() == 1
    0

[[test]]
fn test_q_is_refused_while_a_hidden_buffer_is_changed() -> i32
    var d = disk_with("g.txt", "one\n")
    var ed = open("ab")
    feed(@&ed, @&d, "x:e g.txt<cr>:q<cr>")
    assert not ed.quit
    assert says(@ed, "E162: No write since last change for buffer \"f.txt\"")
    assert ed.path().eq("f.txt")                    # and it is shown
    feed(@&ed, @&d, ":q!<cr>")
    assert ed.quit
    # :wq writes this buffer, then refuses the same way.
    var ed2 = open("ab")
    feed(@&ed2, @&d, "x:e g.txt<cr>:wq<cr>")
    assert d.saves == 1 and not ed2.quit
    assert says(@ed2, "E162: No write since last change for buffer \"f.txt\"")
    # A changed buffer with no name.
    var ed3 = editor_new()
    feed(@&ed3, @&d, "ix<esc>:e g.txt<cr>:q<cr>")
    assert says(@ed3, "E162: No write since last change for buffer \"[No Name]\"")
    0

[[test]]
fn test_sp_shows_the_buffer_twice_and_moves_the_other_cursor() -> i32
    var d = disk_new()
    var ed = open("a\nb\nc\nd\n")
    feed(@&ed, @&d, "jj:sp<cr>")
    assert ed.window_count() == 2 and ed.current_window() == 0     # the new one, above
    assert win_at(@ed, 0, 2, 0) and win_at(@ed, 1, 2, 0)
    # A line opened above: the other window's cursor stays on its text.
    feed(@&ed, @&d, "ggOnew<esc>")
    assert holds(@ed, "new\na\nb\nc\nd\n")
    assert win_at(@ed, 0, 0, 2) and win_at(@ed, 1, 3, 0)
    # Its line deleted: it goes to where the line was.
    feed(@&ed, @&d, "3jdd")
    assert win_at(@ed, 1, 3, 0) and holds(@ed, "new\na\nb\nd\n")
    0

[[test]]
fn test_an_edit_before_the_other_cursor_on_its_line_moves_it() -> i32
    var d = disk_new()
    var ed = open("abc def\n")
    feed(@&ed, @&d, "w:sp<cr>0x")
    assert win_at(@ed, 1, 0, 3)
    feed(@&ed, @&d, "ix<esc>")
    assert win_at(@ed, 1, 0, 4)
    0

[[test]]
fn test_deleting_everything_in_one_window_clamps_the_other() -> i32
    var d = disk_new()
    var ed = open("a\nb\nc\n")
    feed(@&ed, @&d, "G:sp<cr>ggdG")
    assert holds(@ed, "") and win_at(@ed, 1, 0, 0)
    0

[[test]]
fn test_an_edit_leaves_windows_on_other_buffers_alone() -> i32
    var d = disk_with("g.txt", "x\ny\nz\n")
    var ed = open("a\nb\n")
    feed(@&ed, @&d, "j:sp<cr>:e g.txt<cr>ggdd")
    assert win_path(@ed, 0).eq("g.txt") and win_path(@ed, 1).eq("f.txt")
    assert win_at(@ed, 1, 1, 0)
    0

[[test]]
fn test_undo_from_either_window() -> i32
    var d = disk_new()
    var ed = open("abc\n")
    feed(@&ed, @&d, ":sp<cr>x<C-w>j")
    assert ed.current_window() == 1 and holds(@ed, "bc\n")
    feed(@&ed, @&d, "u")
    assert holds(@ed, "abc\n")
    feed(@&ed, @&d, "<C-w>k<C-r>")
    assert ed.current_window() == 0 and holds(@ed, "bc\n")
    0

[[test]]
fn test_ctrl_w_moves_between_windows() -> i32
    var d = disk_new()
    var ed = open("a\n")
    feed(@&ed, @&d, ":vs<cr>")                      # new | old
    assert ed.window_count() == 2 and ed.current_window() == 0
    feed(@&ed, @&d, "<C-w>l")
    assert ed.current_window() == 1
    feed(@&ed, @&d, "<C-w>h")
    assert ed.current_window() == 0
    feed(@&ed, @&d, "<C-w>w")
    assert ed.current_window() == 1
    feed(@&ed, @&d, "<C-w><C-w>")
    assert ed.current_window() == 0                 # round past the last
    feed(@&ed, @&d, "<C-w>W")
    assert ed.current_window() == 1
    feed(@&ed, @&d, "1<C-w>w")                      # a count names the window
    assert ed.current_window() == 0
    # Split the left one: Row[Stack[new, left], right].
    feed(@&ed, @&d, "<C-w>s")
    assert ed.window_count() == 3 and ed.current_window() == 0
    feed(@&ed, @&d, "<C-w>j")
    assert ed.current_window() == 1
    feed(@&ed, @&d, "<C-w>l")
    assert ed.current_window() == 2
    feed(@&ed, @&d, "<C-w>k")                       # nothing above: stays
    assert ed.current_window() == 2
    feed(@&ed, @&d, "<C-w>h")                       # the cursor's row picks the top one
    assert ed.current_window() == 0
    feed(@&ed, @&d, "<C-w>v")
    assert ed.window_count() == 4
    feed(@&ed, @&d, "<C-w>z")                       # not a window command: nothing
    assert ed.window_count() == 4 and ed.current_window() == 0
    0

[[test]]
fn test_ctrl_w_c_o_and_q_close_windows() -> i32
    var d = disk_new()
    var ed = open("ab")
    feed(@&ed, @&d, ":sp<cr>:sp<cr><C-w>j")
    assert ed.window_count() == 3 and ed.current_window() == 1
    feed(@&ed, @&d, "<C-w>c")
    assert ed.window_count() == 2 and ed.current_window() == 1  # the one below took the room
    feed(@&ed, @&d, "<C-w>o")
    assert ed.window_count() == 1
    feed(@&ed, @&d, "<C-w>c")
    assert says(@ed, "E444: Cannot close last window") and ed.window_count() == 1
    feed(@&ed, @&d, ":sp<cr>:close<cr>:sp<cr>:only<cr>")
    assert ed.window_count() == 1
    # :q closes a window while there are others; the last quits.
    feed(@&ed, @&d, ":sp<cr>x:q<cr>")
    assert ed.window_count() == 1 and not ed.quit
    feed(@&ed, @&d, "<C-w>q")
    assert not ed.quit and says(@ed, MSG_NOT_SAVED)
    feed(@&ed, @&d, "u<C-w>q")
    assert ed.quit
    0

[[test]]
fn test_a_split_needs_room() -> i32
    var d = disk_new()
    var ed = open("a\n")
    ed.resize(Size { rows: 5, cols: 80 })           # 4 rows for windows
    feed(@&ed, @&d, ":sp<cr>")
    assert ed.window_count() == 2
    feed(@&ed, @&d, ":sp<cr>")
    assert ed.window_count() == 2 and says(@ed, "E36: Not enough room")
    0

[[test]]
fn test_sp_and_vs_with_a_file_open_it_in_the_new_window() -> i32
    var d = disk_with("g.txt", "one\n")
    var ed = open("ab")
    feed(@&ed, @&d, ":sp g.txt<cr>")
    assert ed.window_count() == 2 and win_path(@ed, 0).eq("g.txt") and win_path(@ed, 1).eq("f.txt")
    feed(@&ed, @&d, ":vs f.txt<cr>")
    assert ed.window_count() == 3 and ed.path().eq("f.txt") and ed.buffer_count() == 2
    0

[[test]]
fn test_each_window_keeps_its_own_jumps() -> i32
    var d = disk_new()
    var ed = open("a\nb\nc\n")
    assert jump_to<Disk>(@&ed, @&d, "f.txt", pos(2, 0))
    feed(@&ed, @&d, ":sp<cr>")                      # the new window has a copy
    assert ed.jump_depth() == 1
    feed(@&ed, @&d, "<C-o>")
    assert ed.jump_depth() == 0 and at(@ed, 0, 0)
    feed(@&ed, @&d, "<C-w>j")
    assert ed.jump_depth() == 1 and at(@ed, 2, 0)
    0

[[test]]
fn test_page_follows_the_window_height() -> i32
    var text = string_new()
    for i in 0..100
        text.push_i64(i)
        text.push('\n')
    var ed = open(text.as_view())
    var d = disk_new()
    ed.resize(Size { rows: 24, cols: 80 })
    feed(@&ed, @&d, ":sp<cr><C-f>")                 # 12 rows: 11 text rows, 9 lines a page
    assert ed.top == 9 and ed.cursor.line == 9
    0

# What the painter and the event loop read: each window's state, and the
# buffer list by index.
[[test]]
fn test_window_and_buffer_queries() -> i32
    var d = disk_with("g.ritz", "one\ntwo\n")
    var ed = open("a\nb\nc\n")
    feed(@&ed, @&d, "jj:sp g.ritz<cr>j")        # above: g.ritz at 2:1; below: f.txt at 3:1
    let t = ed.tiling()
    assert t.wins.len() == 2
    let top = ed.window_at(0)
    let bottom = ed.window_at(1)
    assert ed.is_current(top) and not ed.is_current(bottom)
    assert ed.window_id(top) == t.wins.get(0).win
    assert ed.window_number(top) == 2 and ed.window_number(bottom) == 1
    assert ed.window_path(top).eq("g.ritz") and ed.window_path(bottom).eq("f.txt")
    assert ed.window_buffer(bottom).line_count() == 4
    assert ed.window_lines(top) == 2 and ed.window_lines(bottom) == 3
    assert win_at(@ed, 0, 1, 0) and win_at(@ed, 1, 2, 0)
    let st = ed.window_status(bottom)
    assert st.name.eq("f.txt") and not st.dirty and st.mode == Mode.Normal
    ed.set_window_top(bottom, 1)
    assert ed.window_top(bottom) == 1 and ed.window_top(top) == 0
    ed.set_window_top(top, 1)
    assert ed.top == 1
    assert ed.buffer_count() == 2
    assert ed.buffer_number_at(0) == 1 and ed.buffer_path_at(0).eq("f.txt")
    assert ed.buffer_number_at(1) == 2 and ed.buffer_at(1).line_count() == 3
    assert ed.find_buffer(2).unwrap_or(-1) == 1 and ed.find_buffer(9).is_none()
    assert ed.find_path("g.ritz").unwrap_or(-1) == 1 and ed.find_path("x").is_none()
    assert ed.find_window(t.wins.get(1).win).unwrap_or(-1) == bottom and ed.find_window(99).is_none()
    0
