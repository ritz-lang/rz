# test/test_layout.ritz - core/layout's window tree: Vim's frames, sized equally (AGAST #4912).
#
# Split, close, the order Ctrl-W w walks, the rectangles each window gets
# for an area (Vim's 'equalalways': the room shared equally, the first
# windows taking any rows or columns left over) and the neighbour Ctrl-W
# h/j/k/l goes to.

import ritzlib.gvec
import ritzlib.option

import core.layout { Dir, Layout, Rect, Split, Tiling, layout_new, rect }

# The 80 x 23 area a 24-row terminal leaves above the command line.
fn area() -> Rect
    rect(0, 0, 23, 80)

fn same(a: Rect, row: i64, col: i64, rows: i64, cols: i64) -> bool
    a.row == row and a.col == col and a.rows == rows and a.cols == cols

# Window `win`'s rectangle in `t`, or a 0 x 0 one when it has none.
fn of(t: @Tiling, win: i64) -> Rect
    for i in 0..t.wins.len()
        if t.wins.get(i).win == win
            return t.wins.get(i).rect
    rect(0, 0, 0, 0)

fn order_is(l: @Layout, a: i64, b: i64, c: i64) -> bool
    let o = l.order()
    o.len() == 3 and o.get(0) == a and o.get(1) == b and o.get(2) == c

[[test]]
fn test_one_window_has_the_whole_area() -> i32
    let l = layout_new(7)
    let t = l.tile(area())
    assert t.wins.len() == 1 and t.seps.len() == 0
    assert same(of(@t, 7), 0, 0, 23, 80)
    assert l.count() == 1
    0

[[test]]
fn test_sp_puts_the_new_window_above_with_the_odd_row() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    let t = l.tile(area())
    assert same(of(@t, 2), 0, 0, 12, 80)
    assert same(of(@t, 1), 12, 0, 11, 80)
    assert t.seps.len() == 0
    0

[[test]]
fn test_vs_puts_the_new_window_left_with_a_separator() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)
    let t = l.tile(area())
    assert same(of(@t, 2), 0, 0, 23, 40)
    assert same(of(@t, 1), 0, 41, 23, 39)
    assert t.seps.len() == 1
    assert same(t.seps.get(0), 0, 40, 23, 1)
    0

[[test]]
fn test_splitting_the_same_way_shares_the_room_equally() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    assert l.split(2, 3, Split.Stack)
    let t = l.tile(area())
    assert same(of(@t, 3), 0, 0, 8, 80)
    assert same(of(@t, 2), 8, 0, 8, 80)
    assert same(of(@t, 1), 16, 0, 7, 80)
    assert order_is(@l, 3, 2, 1)
    0

[[test]]
fn test_a_split_across_nests_a_frame() -> i32
    # :vs, then :sp in the new left window: the left column is two windows.
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)
    assert l.split(2, 3, Split.Stack)
    let t = l.tile(area())
    assert same(of(@t, 3), 0, 0, 12, 40)
    assert same(of(@t, 2), 12, 0, 11, 40)
    assert same(of(@t, 1), 0, 41, 23, 39)
    assert order_is(@l, 3, 2, 1)
    0

[[test]]
fn test_split_of_a_missing_window_changes_nothing() -> i32
    var l = layout_new(1)
    assert not l.split(9, 2, Split.Stack)
    assert l.count() == 1
    0

[[test]]
fn test_the_window_after_takes_the_room_else_the_one_before() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    assert l.split(2, 3, Split.Stack)       # 3, 2, 1 top to bottom
    assert l.remove(2).unwrap_or(-1) == 1
    assert l.remove(1).unwrap_or(-1) == 3   # the last: the one above
    let t = l.tile(area())
    assert same(of(@t, 3), 0, 0, 23, 80)
    0

[[test]]
fn test_the_last_window_is_not_removed() -> i32
    var l = layout_new(1)
    assert l.remove(1).is_none()
    assert l.count() == 1
    assert l.remove(5).is_none()
    0

[[test]]
fn test_closing_collapses_a_frame_of_one() -> i32
    # Row[Stack[3, 2], 1]: closing 3 leaves Row[2, 1], 2 taking the column.
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)
    assert l.split(2, 3, Split.Stack)
    assert l.remove(3).unwrap_or(-1) == 2
    let t = l.tile(area())
    assert same(of(@t, 2), 0, 0, 23, 40)
    assert same(of(@t, 1), 0, 41, 23, 39)
    # A split across again nests afresh: the old frame is really gone.
    assert l.split(1, 4, Split.Stack)
    let t2 = l.tile(area())
    assert same(of(@t2, 4), 0, 41, 12, 39)
    assert same(of(@t2, 2), 0, 0, 23, 40)
    0

[[test]]
fn test_a_collapsed_frame_joins_its_parent() -> i32
    # Stack[2, Row[3, Stack[4, 1]]]: closing 3 leaves the row one stack,
    # which joins the outer one: three windows sharing the rows, not 2
    # over a stack of two.
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    assert l.split(1, 3, Split.Row)
    assert l.split(1, 4, Split.Stack)
    assert l.remove(3).unwrap_or(-1) == 4
    let t = l.tile(area())
    assert same(of(@t, 2), 0, 0, 8, 80)
    assert same(of(@t, 4), 8, 0, 8, 80)
    assert same(of(@t, 1), 16, 0, 7, 80)
    assert order_is(@l, 2, 4, 1)
    0

[[test]]
fn test_a_leaf_left_alone_takes_its_frames_place() -> i32
    # Stack[4, Row[3, 1]]: closing 3 leaves 1 straight under the stack, so
    # a split of 1 the stack's way makes three equal rows.
    var l = layout_new(1)
    assert l.split(1, 4, Split.Stack)
    assert l.split(1, 3, Split.Row)
    assert l.remove(3).unwrap_or(-1) == 1
    assert l.split(1, 5, Split.Stack)
    let t = l.tile(area())
    assert same(of(@t, 4), 0, 0, 8, 80)
    assert same(of(@t, 5), 8, 0, 8, 80)
    assert same(of(@t, 1), 16, 0, 7, 80)
    0

[[test]]
fn test_closing_the_first_of_a_nested_frame_goes_to_its_last_window() -> i32
    # Row[Stack[3, 2], 1]: closing 1 hands the room to the left column,
    # whose window next to it is its last.
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)
    assert l.split(2, 3, Split.Stack)
    assert l.remove(1).unwrap_or(-1) == 2
    0

[[test]]
fn test_a_new_size_shares_the_room_again() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)
    let t = l.tile(rect(0, 0, 10, 21))
    assert same(of(@t, 2), 0, 0, 10, 10)
    assert same(of(@t, 1), 0, 11, 10, 10)
    0

[[test]]
fn test_neighbours_left_and_right() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Row)          # 2 | 1
    let t = l.tile(area())
    assert t.neighbour(2, Dir.Right, 5, 3).unwrap_or(-1) == 1
    assert t.neighbour(1, Dir.Left, 5, 50).unwrap_or(-1) == 2
    assert t.neighbour(2, Dir.Left, 5, 3).is_none()
    assert t.neighbour(2, Dir.Up, 5, 3).is_none()
    assert t.neighbour(2, Dir.Down, 5, 3).is_none()
    0

[[test]]
fn test_neighbours_up_and_down_follow_the_cursor_column() -> i32
    # Stack[Row[3, 2], 1]: from 1 up, the column picks 3 or 2.
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    assert l.split(2, 3, Split.Row)
    let t = l.tile(area())
    assert t.neighbour(1, Dir.Up, 15, 10).unwrap_or(-1) == 3
    assert t.neighbour(1, Dir.Up, 15, 60).unwrap_or(-1) == 2
    # The separator's column belongs to the window on its left.
    assert t.neighbour(1, Dir.Up, 15, 40).unwrap_or(-1) == 3
    assert t.neighbour(3, Dir.Down, 4, 10).unwrap_or(-1) == 1
    assert t.neighbour(2, Dir.Down, 4, 60).unwrap_or(-1) == 1
    assert t.neighbour(1, Dir.Down, 15, 10).is_none()
    0

[[test]]
fn test_windows_too_small_are_found() -> i32
    var l = layout_new(1)
    assert l.split(1, 2, Split.Stack)
    assert l.split(2, 3, Split.Stack)
    let t = l.tile(rect(0, 0, 5, 80))       # 2, 2, 1 rows: the last has no text row
    assert not t.fits()
    assert l.tile(rect(0, 0, 6, 80)).fits()
    0
