# platform/linux.ritz - the Linux terminal adapter.
#
# Terminal and OS I/O live here, never in src/core/. The terminal session
# (raw mode, key decoding, Escape timeout) comes from the ritzlib module lifted
# from rzsh (docs/BUDDHAFINGER_PROPOSAL.md, "Shared terminal session"); until
# then this adapter only writes text to the terminal.

import ritzlib.io { prints }
import ritzlib.strview { StrView }

pub fn term_write(s: StrView)
    prints(s)
