# syntax/lexer.ritz - the editor's Ritz lexer, for lexical colors.
#
# In Ritz a newline ends a `"..."` string and a `#` comment, and there are no
# multi-line strings or block comments (docs/BUDDHAFINGER_PROPOSAL.md,
# "Lexical colors"). So no state crosses a line: lex_line takes one line and
# nothing else, and an edit re-lexes only the lines it touched (see
# syntax/highlight.ritz). INDENT/DEDENT don't matter for coloring.
#
# This is not ritz1/src/lexer.ritz, which stays in the compiler; it follows
# that lexer's literal rules (numbers, suffixes, escapes, `'c'`, `c"..."`) so
# what it colors is what the compiler reads, and it never fails: anything it
# doesn't recognize is plain text. The word lists started from the Vim syntax
# file projects/ritz-lsp/install.sh writes; COMPILER_WORDS is ritz1's
# keyword table, and test_lexer.ritz fails when the two drift apart.
#
#   var toks: Vec<Token> = vec_new<Token>()
#   lex_line(span_from_strview("let n = 5u8  # five"), @&toks)
#   # Keyword [0, 3), Number [8, 11), Comment [13, 19)

import ritzlib.gvec
import ritzlib.option
import ritzlib.strview { StrView }

# What a token is, for coloring. Bytes in no token are plain text.
pub enum Kind
    Keyword     # a reserved word that is neither a type nor a literal
    Type        # a primitive type, or a ritzlib type the code names often
    Literal     # true, false, null, nil, and the Option/Result constructors
    Number
    String      # a "..." or c"..." literal, quotes and prefix included
    Escape      # a `\` escape inside a string or char literal
    Char        # a '.' literal
    Comment     # `#` to the end of the line
    Attribute   # a `[[...]]` line

# Bytes [start, start + len) of the line are a `kind` token.
pub struct Token
    start: i64
    len: i64
    kind: Kind

# ============================================================================
# Words
# ============================================================================

# ritz1's keyword table: the words lexer_keyword (ritz1/src/lexer_scan_gen.ritz,
# generated from grammars/ritz1.grammar) reserves. Keep it equal to that
# table; test_editor_keywords_match_the_compilers checks.
const COMPILER_WORDS: [49]StrView = [
    "as", "fn", "i8", "if", "in", "or", "u8",
    "and", "asm", "for", "i16", "i32", "i64", "let", "mut", "nil", "not",
    "pub", "u16", "u32", "u64", "var",
    "bool", "else", "enum", "heap", "impl", "loop", "null", "self", "then",
    "true", "type",
    "async", "await", "break", "const", "defer", "false", "match", "trait",
    "while",
    "assert", "extern", "import", "return", "struct", "unsafe",
    "continue"
]

# Colored as types: the compiler's type keywords and names that are types by
# convention (f32/f64 and Self are identifiers to the lexer).
const TYPE_WORDS: [18]StrView = [
    "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "bool",
    "f32", "f64", "Self", "Vec", "Option", "Result", "String", "StrView", "Span"
]

# Colored as literals: the compiler's literal keywords and the Option/Result
# constructors.
const LITERAL_WORDS: [8]StrView = [
    "true", "false", "null", "nil", "Some", "None", "Ok", "Err"
]

# ritz1's reserved words, for the drift test.
pub fn compiler_keywords() -> Vec<StrView>
    var v: Vec<StrView> = vec_with_cap<StrView>(49)
    for i in 0..49
        v.push(COMPILER_WORDS[i])
    v

# How the identifier `w` is colored, or None for a plain name.
pub fn word_kind(w: StrView) -> Option<Kind>
    for i in 0..18
        if TYPE_WORDS[i].eq(w)
            return Some(Kind.Type)
    for i in 0..8
        if LITERAL_WORDS[i].eq(w)
            return Some(Kind.Literal)
    for i in 0..49
        if COMPILER_WORDS[i].eq(w)
            return Some(Kind.Keyword)
    None

# ============================================================================
# Byte classes
# ============================================================================

fn is_digit(c: u8) -> bool
    c >= '0' and c <= '9'

fn is_hex(c: u8) -> bool
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

fn is_bin(c: u8) -> bool
    c == '0' or c == '1'

fn is_ident_start(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

fn is_ident(c: u8) -> bool
    is_ident_start(c) or is_digit(c)

# The byte at s[i], or 0 past the end (0 is in no class above).
fn at(s: [u8], i: i64) -> u8
    if i >= 0 and i < s.len then s[i] else 0

# ============================================================================
# The line lexer
# ============================================================================

# Append `line`'s tokens to `out`, in order: each non-empty, none
# overlapping, all inside the line.
pub fn lex_line(line: [u8], out: @&Vec<Token>)
    # An attribute is a line of its own: `[[` after the indent.
    var i: i64 = 0
    while i < line.len and (line[i] == ' ' or line[i] == '\t')
        i += 1
    if at(line, i) == '[' and at(line, i + 1) == '['
        let end = attribute_end(line, i + 2)
        out.push(Token { start: i, len: end - i, kind: Kind.Attribute })
        i = end
    while i < line.len
        let c = line[i]
        if c == '#'
            out.push(Token { start: i, len: line.len - i, kind: Kind.Comment })
            return
        if c == '"'
            i = quoted(line, i, 1, '"', Kind.String, out)
        else if c == 'c' and at(line, i + 1) == '"'
            i = quoted(line, i, 2, '"', Kind.String, out)
        else if is_ident_start(c)
            var j: i64 = i + 1
            while is_ident(at(line, j))
                j += 1
            match word_kind(StrView { ptr: line.as_ptr() + i, len: j - i })
                Some(k) => out.push(Token { start: i, len: j - i, kind: k })
                None => pass
            i = j
        else if is_digit(c)
            let n = number_len(line, i)
            out.push(Token { start: i, len: n, kind: Kind.Number })
            i += n
        else if c == '\''
            # char_len and quoted agree on where a char literal ends.
            if char_len(line, i) > 0
                i = quoted(line, i, 1, '\'', Kind.Char, out)
            else
                i += 1
        else
            i += 1

# The end of the `[[...]]` whose body starts at `i`: after its `]]`, or the
# line's end (an unclosed one is still being typed).
fn attribute_end(line: [u8], from: i64) -> i64
    var i: i64 = from
    while i + 1 < line.len
        if line[i] == ']' and line[i + 1] == ']'
            return i + 2
        i += 1
    line.len

# ----------------------------------------------------------------------------
# Strings and chars
# ----------------------------------------------------------------------------

# Push the `kind` literal at line[start..], `prefix` bytes up to and
# including its opening quote, as `kind` runs around its Escape tokens.
# It ends after the closing `quote`, or at the line's end (a newline ends a
# string). Returns the index after it.
fn quoted(line: [u8], start: i64, prefix: i64, quote: u8, kind: Kind, out: @&Vec<Token>) -> i64
    var run: i64 = start            # where the current `kind` run began
    var i: i64 = start + prefix
    while i < line.len
        let c = line[i]
        if c == quote
            out.push(Token { start: run, len: i + 1 - run, kind: kind })
            return i + 1
        if c == '\\'
            if i > run
                out.push(Token { start: run, len: i - run, kind: kind })
            let n = escape_len(line, i)
            out.push(Token { start: i, len: n, kind: Kind.Escape })
            i += n
            run = i
        else
            i += 1
    if i > run
        out.push(Token { start: run, len: i - run, kind: kind })
    i

# Bytes of the escape whose `\` is at line[i]: `\xNN` is four when both are
# hex digits (ritz1's lexer_escape_width; a bad one is the compiler's error
# to report), any other `\c` two, and a `\` ending the line one.
fn escape_len(line: [u8], i: i64) -> i64
    if i + 1 >= line.len
        return 1
    if line[i + 1] == 'x' and is_hex(at(line, i + 2)) and is_hex(at(line, i + 3))
        return 4
    2

# The length of the char literal at line[i] (a `'`), or 0 when none starts
# there. ritz1's CHAR: /'([^'\\]|\\.|\\x[^'\n]*)'/.
fn char_len(line: [u8], i: i64) -> i64
    let c1 = at(line, i + 1)
    if i + 1 >= line.len or c1 == '\''
        return 0
    var end: i64 = i + 2
    if c1 == '\\'
        if i + 2 >= line.len
            return 0
        end = i + 3
        if line[i + 2] == 'x'
            while end < line.len and line[end] != '\''
                end += 1
    if at(line, end) != '\'' or end >= line.len
        return 0
    end + 1 - i

# ----------------------------------------------------------------------------
# Numbers
# ----------------------------------------------------------------------------

# A run of digits of class `hex`/`bin`/decimal with `_` separators, from i.
fn run_digits(line: [u8], i: i64, radix: u8) -> i64
    var j: i64 = i
    while j < line.len
        let c = line[j]
        let ok = if radix == 16 then is_hex(c) else if radix == 2 then is_bin(c) else is_digit(c)
        if not ok and c != '_'
            return j - i
        j += 1
    j - i

# The length of the number at line[i] (a digit), as ritz1's
# lexer_scan_number and lexer_number_suffix take it: digits, a fraction
# (`.` then a digit), an exponent, or `0x`/`0b` digits; then a typed suffix.
fn number_len(line: [u8], i: i64) -> i64
    let digits = run_digits(line, i, 10)
    # After a lone `.` (not `..`) a number is a tuple field: `p.0.1`.
    if at(line, i - 1) == '.' and at(line, i - 2) != '.'
        return digits
    var n: i64 = digits
    var float = false
    if at(line, i + n) == '.' and is_digit(at(line, i + n + 1))
        n += 1 + run_digits(line, i + n + 1, 10)
        float = true
    let e = at(line, i + n)
    if e == 'e' or e == 'E'
        var k: i64 = i + n + 1
        if at(line, k) == '+' or at(line, k) == '-'
            k += 1
        if is_digit(at(line, k))
            n = k + run_digits(line, k, 10) - i
            float = true
    if float
        # `f32` / `f64` (AGAST #1615).
        if at(line, i + n) == 'f' and ((at(line, i + n + 1) == '3' and at(line, i + n + 2) == '2') or (at(line, i + n + 1) == '6' and at(line, i + n + 2) == '4'))
            n += 3
        return n
    if line[i] == '0'
        let r = at(line, i + 1)
        if r == 'x' or r == 'b'
            let radix: u8 = if r == 'x' then 16 else 2
            let m = run_digits(line, i + 2, radix)
            if m > 0 and m + 2 > n
                n = m + 2
    n + int_suffix(line, i + n)

# The length of a typed integer suffix at line[i] (AGAST #107), or 0:
# `[ui](8|16|32|64|size)` not followed by an identifier byte.
fn int_suffix(line: [u8], i: i64) -> i64
    let s = at(line, i)
    if s != 'u' and s != 'i'
        return 0
    let a = at(line, i + 1)
    let b = at(line, i + 2)
    var n: i64 = 0
    if a == 's' and b == 'i' and at(line, i + 3) == 'z' and at(line, i + 4) == 'e'
        n = 5
    else if (a == '1' and b == '6') or (a == '3' and b == '2') or (a == '6' and b == '4')
        n = 3
    else if a == '8'
        n = 2
    if n > 0 and is_ident(at(line, i + n))
        return 0
    n
