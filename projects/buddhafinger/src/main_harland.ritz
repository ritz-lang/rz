# main_harland - the `buddhafinger` binary for Harland (AGAST #4833).
#
#   buddhafinger [--rows N] [--cols N] [FILE]
#
# Edits FILE on the console on stdin, as main.ritz does on Linux, through
# platform/harland.ritz's run_harland_editor: raw console, the --rows x
# --cols viewport (Harland reports no window size), the single-write save.
# Its own entry module because an import can't be gated by target: this one
# reaches no Linux-only code (signals, signalfd, rename).

import ritzlib.io { prints, eprints }
import ritzlib.span { Span }
import ritzlib.strview { StrView }

import platform.harland { HARLAND_EXIT_FAILED, HARLAND_EXIT_OK, HARLAND_USAGE, harland_args, run_harland_editor }

# The console: stdin, read and written.
const TTY: i32 = 0

pub fn main(args: Span<StrView>) -> i32
    if args.len == 2
        let arg: StrView = args[1]
        if arg.eq("-h") or arg.eq("--help")
            prints(HARLAND_USAGE)
            return HARLAND_EXIT_OK
    match harland_args(args)
        Ok(a) => run_harland_editor(TTY, @a)
        Err(what) =>
            eprints("buddhafinger: ")
            eprints(what)
            eprints("\n")
            eprints(HARLAND_USAGE)
            HARLAND_EXIT_FAILED
