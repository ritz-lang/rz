# bench/workloads.ritz - the generated files the benchmark edits.
#
# docs/BUDDHAFINGER_PROPOSAL.md, "Buffer representation and performance":
# a million short lines and one multi-megabyte line. Both are Ritz-shaped
# text, so with highlighting on the lexer sees keywords, names, numbers and
# punctuation, not one long comment or string; and both end in NEEDLE, once,
# so a search from the top scans the whole file. Ordinary sources are real
# files from the repository (bench/README.md).

import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.gvec
import ritzlib.strview { StrView }

# The search target: only in the last line (many_lines) or at the very end
# (long_line).
pub const NEEDLE: StrView = "needle_4821"

# One short line's text before its number; about 40 bytes with it.
const SHORT_LINE: StrView = "    let value = compute(arg, "

# The long line's repeating unit (no `#` or quote: the rest of the line must
# not become one comment or string token).
const LONG_UNIT: StrView = "let value = compute(arg, 42) + other; "

# `n` LF-terminated lines; the last holds NEEDLE.
pub fn many_lines(n: i64) -> Vec<u8>
    var out: Vec<u8> = vec_with_cap<u8>(n * 44)
    for i in 0..n
        if i == n - 1
            out.push_view("    let ")
            out.push_view(NEEDLE)
            out.push_view(" = 0\n")
        else
            out.push_view(SHORT_LINE)
            push_number(@&out, i)
            out.push_view(")\n")
    out

# One line of exactly `bytes` bytes (at least NEEDLE's length), no
# terminator, ending in NEEDLE.
pub fn long_line(bytes: i64) -> Vec<u8>
    var out: Vec<u8> = vec_with_cap<u8>(bytes)
    let body = bytes - NEEDLE.len
    while out.len() < body
        let room = body - out.len()
        if room >= LONG_UNIT.len
            out.push_view(LONG_UNIT)
        else
            out.push_view(LONG_UNIT.slice(0, room))
    out.push_view(NEEDLE)
    out

fn push_number(out: @&Vec<u8>, n: i64)
    var buf: [20]u8
    out.push_view(fmt_i64_into(@buf, n))
