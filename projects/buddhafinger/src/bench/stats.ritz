# bench/stats.ritz - latency samples and their percentiles.
#
# Percentiles are nearest-rank: the p-th percentile of n samples is the
# ceil(p * n / 100)-th smallest, always a value that was measured.

import ritzlib.gvec

pub struct Samples
    values: Vec<i64>
    sorted: bool

pub fn samples_new() -> Samples
    Samples { values: vec_new<i64>(), sorted: true }

impl Samples
    pub fn add(self: @&Samples, v: i64)
        self.values.push(v)
        self.sorted = false

    pub fn count(self: @Samples) -> i64
        self.values.len()

    # The p-th percentile (0 < p <= 100); 0 with no samples.
    pub fn percentile(self: @&Samples, p: i64) -> i64
        let n = self.values.len()
        if n == 0
            return 0
        self.sort()
        var rank = (p * n + 99) / 100
        if rank < 1
            rank = 1
        if rank > n
            rank = n
        self.values[rank - 1]

    pub fn max(self: @&Samples) -> i64
        self.percentile(100)

    # Insertion sort: a run holds hundreds to a few thousand samples.
    fn sort(self: @&Samples)
        if self.sorted
            return
        let n = self.values.len()
        for i in 1..n
            let v = self.values[i]
            var j = i - 1
            while j >= 0 and self.values[j] > v
                self.values[j + 1] = self.values[j]
                j -= 1
            self.values[j + 1] = v
        self.sorted = true
