# buddhafinger - a modal terminal code editor (docs/BUDDHAFINGER_PROPOSAL.md).
#
# Skeleton entry point: it reports the version and the starting mode. The
# event loop arrives with the terminal-session and event-loop tasks.

import core.modes { Mode, mode_label }
import platform.linux { term_write }

fn main() -> i32
    term_write("buddhafinger 0.1.0 (")
    term_write(mode_label(Mode.Normal))
    term_write(")\n")
    0
