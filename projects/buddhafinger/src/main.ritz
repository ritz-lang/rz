# buddhafinger - a modal terminal code editor (docs/BUDDHAFINGER_PROPOSAL.md).
#
#   buddhafinger [FILE]
#
# Edits FILE (a new buffer under that name if there is no such file, an
# unnamed one without FILE) on the terminal on stdin. platform/linux.ritz's
# run_editor is the program: the terminal session, the event loop and the
# signals.

import ritzlib.io { prints, eprints }
import ritzlib.span { Span }
import ritzlib.strview { StrView }

import platform.linux { EXIT_FAILED, EXIT_OK, run_editor }

const USAGE: StrView = "usage: buddhafinger [FILE]\n"

# The terminal: stdin, read and written (a terminal's fd 0 is opened read-write).
const TTY: i32 = 0

pub fn main(args: Span<StrView>) -> i32
    if args.len > 2
        eprints(USAGE)
        return EXIT_FAILED
    if args.len == 2
        let arg: StrView = args[1]
        if arg.eq("-h") or arg.eq("--help")
            prints(USAGE)
            return EXIT_OK
        return run_editor(TTY, arg)
    run_editor(TTY, "")
