# core/buffer.ritz - the text buffer.
#
# Lines are bytes (`Vec<u8>`, terminators in line metadata), not `String`
# (docs/BUDDHAFINGER_PROPOSAL.md, "Buffer representation and performance").
# This skeleton tracks only whether there are pending edits; the buffer-core
# task adds line storage behind the buffer API.
# Core module: no terminal or OS I/O (see src/platform/).

pub struct Buffer
    dirty: bool

pub fn buffer_new() -> Buffer
    Buffer { dirty: false }

impl Buffer
    # True while the buffer holds edits that are not saved: `:q` refuses.
    pub fn is_dirty(self: @Buffer) -> bool
        self.dirty
