# core/modes.ritz - the editor's modes.
#
# The first usable release has Normal, Insert and the command line (`:` and
# `/`) (docs/BUDDHAFINGER_PROPOSAL.md, "First usable release"); Visual and
# the rest come under everyday editing.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.strview { StrView }

pub enum Mode
    Normal
    Insert
    CommandLine         # typing a `:` command or a `/` search

# The label the status line shows for a mode.
pub fn mode_label(m: Mode) -> StrView
    match m
        Normal => "NORMAL"
        Insert => "INSERT"
        CommandLine => "COMMAND"
