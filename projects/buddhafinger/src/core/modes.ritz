# core/modes.ritz - the editor's modes.
#
# The first usable release has Normal and Insert (docs/BUDDHAFINGER_PROPOSAL.md,
# "First usable release"); Visual and the rest come under everyday editing.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.strview { StrView }

pub enum Mode
    Normal
    Insert

# The label the status line shows for a mode.
pub fn mode_label(m: Mode) -> StrView
    match m
        Normal => "NORMAL"
        Insert => "INSERT"
