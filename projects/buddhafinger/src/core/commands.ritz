# core/commands.ritz - command-line (`:`) commands.
#
# The first-release list is fixed in docs/BUDDHAFINGER_PROPOSAL.md ("First
# usable release"); this skeleton knows the quit and write forms, and the
# modes-and-commands task adds the rest (`:w <path>`, `:e <path>`, `:<line>`).
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.option { Option }
import ritzlib.strview { StrView }

pub enum Command
    Quit
    ForceQuit
    Write
    WriteQuit

# The command a command line names, without its leading `:`, or None.
pub fn parse_command(line: StrView) -> Option<Command>
    if line.eq("q")
        return Some(Command.Quit)
    if line.eq("q!")
        return Some(Command.ForceQuit)
    if line.eq("w")
        return Some(Command.Write)
    if line.eq("wq")
        return Some(Command.WriteQuit)
    None
