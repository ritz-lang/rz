# core/commands.ritz - command-line (`:`) commands.
#
# The first-release list is fixed in docs/BUDDHAFINGER_PROPOSAL.md ("First
# usable release"): `:w`, `:w <path>`, `:q`, `:q!`, `:wq`, `:e <path>` and
# `:<line>`. core/editor.ritz runs them.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.option { Option }
import ritzlib.strview { StrView }

pub enum Command
    Quit
    ForceQuit
    Write
    WriteTo(StrView)    # `:w <path>`
    WriteQuit
    Edit(StrView)       # `:e <path>`; the path is empty for a bare `:e`
    Goto(i64)           # `:<line>`, 1-based as typed

# The argument after a one-letter command `name`: Some("") for the bare
# name, Some(rest) for the name, blanks and the rest, else None.
fn argument(line: StrView, name: StrView) -> Option<StrView>
    if line.eq(name)
        return Some("")
    if not line.starts_with(name) or line.len() == name.len()
        return None
    let c = line.get(name.len())
    if c != ' ' and c != '\t'
        return None
    Some(line.slice(name.len(), line.len()).trim())

# The command a command line names, without its leading `:`, or None.
pub fn parse_command(text: StrView) -> Option<Command>
    let line = text.trim()
    if line.is_empty()
        return None
    var digits = true
    for i in 0..line.len()
        let c = line.get(i)
        if c < '0' or c > '9'
            digits = false
    if digits
        return match line.parse_i64()
            Some(n) => Some(Command.Goto(n))
            None => None
    if line.eq("q")
        return Some(Command.Quit)
    if line.eq("q!")
        return Some(Command.ForceQuit)
    if line.eq("wq")
        return Some(Command.WriteQuit)
    match argument(line, "w")
        Some(p) => return Some(if p.is_empty() then Command.Write else Command.WriteTo(p))
        None => pass
    match argument(line, "e")
        Some(p) => return Some(Command.Edit(p))
        None => pass
    None
