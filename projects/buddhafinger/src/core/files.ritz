# core/files.ritz - the seam the editor reads and writes files through.
#
# The core does no I/O (docs/BUDDHAFINGER_PROPOSAL.md, "Ritz and platform
# boundaries"): `:e` and `:w` call a FileStore the platform supplies. The
# Linux one (temp file, fsync, rename, the size/mtime check) is AGAST #4820;
# the Harland one follows the proposal's "Saving files". The tests drive the
# editor with an in-memory FileStore.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.errno { Errno }
import ritzlib.gvec
import ritzlib.result { Result }
import ritzlib.strview { StrView }

import core.buffer { Buffer }

pub enum LoadError
    NotFound            # no such file: `:e` opens an empty buffer under its name
    Failed(Errno)

pub enum SaveError
    Changed             # the file changed on disk since it was read: not written
    Failed(Errno)

pub trait FileStore
    # The file's bytes, exactly as stored.
    fn load(self: @&Self, path: StrView) -> Result<Vec<u8>, LoadError>

    # Write `buf`'s bytes (Buffer.serialize, or its lines and terminators in
    # order) to `path`. Ok only when all of them are stored: the editor then
    # marks the buffer clean, and on Err it stays dirty.
    fn save(self: @&Self, path: StrView, buf: @Buffer) -> Result<(), SaveError>
