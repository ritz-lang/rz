# core/editor.ritz - the editor: modes and the first-release commands.
#
# The editor state is one buffer, the cursor, the viewport's top line and
# page height, one unnamed register, the last search pattern, the Normal-mode
# keys typed so far (core/normal.ritz), the command line being typed, and in
# Visual mode the selection's other end (the anchor) and the last selection.
# handle_key() applies one typed Key to it; the commands are
# docs/BUDDHAFINGER_PROPOSAL.md's "First usable release" table, then
# counts and operators from "Everyday code editing" (Vim behaviour
# throughout):
#
#   Motion        h j k l, arrows, w b e, 0 $, gg G, gj gk, Ctrl-F Ctrl-B
#   Insert        i a o O, Escape, Backspace, Enter, Tab
#   Operators     d c y with any motion, dd cc yy; x D C Y; p P;
#                 one unnamed register
#   Counts        before a motion, a command or an operator, and after an
#                 operator (2d3w: six words); {count}G and {count}gg name a line
#   Visual        v V (switch shape, or leave), Escape; every motion with
#                 counts moves the cursor end, o O swap the ends; d x c s y
#                 and p P on the selection; gv reselects the last one
#   Undo          u Ctrl-R; an Insert session (with the c that opened it)
#                 is one undo step
#   Search        / (a literal pattern), n N
#   Command line  :w  :w <path>  :q  :q!  :wq  :e <path>  :<line>
#   Language      K (hover), gd (go to definition), Ctrl-O / Ctrl-T (jump back)
#
# K and gd only raise a request (take_ask): the event loop asks the language
# server and, for gd, calls jump_to with the answer. Each jump_to pushes
# where the cursor was, and Ctrl-O or Ctrl-T goes back there, reopening the
# file it was in.
#
# Files go through the FileStore seam (core/files.ritz), so the core does no
# I/O. The event loop renders through core.screen, using Editor as the
# LineSource and status() for the status line, and keeps `top` in step with
# the View render() scrolls.
#
# Lines: a file ending in a newline keeps an empty last line in the Buffer
# (core/buffer.ritz). Vim doesn't show it as a line, and neither does the
# editor: motions stop at the line before it (shown() / last()).
# Columns are byte indexes into a line. In Normal mode the cursor sits on a
# code point, never past the last; in Insert mode it may sit at the end, and
# in Visual mode too after $, where the selection takes the line break.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.gvec
import ritzlib.option
import ritzlib.result { Result }
import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string
import ritzlib.termsession { Key }

import core.buffer { Buffer, Pos, Term, buffer_new, buffer_from_bytes, pos, pos_before, term_text }
import core.commands { Command, parse_command }
import core.files { FileStore, LoadError, SaveError }
import core.modes { Mode }
import core.normal { Action, Keymap, Motion, NormalCommand, NormalKeys, Operator, Shape, Step, normal_keys_new }
import core.screen { LineSource, Selection, Status }
import core.utf8 { utf8_encode, utf8_next, utf8_prev }

pub const MSG_NOT_SAVED: StrView = "E37: No write since last change (add ! to override)"
pub const MSG_NO_NAME: StrView = "E32: No file name"
pub const MSG_NO_PATTERN: StrView = "No previous search pattern"
pub const MSG_NO_JUMP: StrView = "E73: Tag stack empty"
pub const MSG_TOO_LONG: StrView = "E1240: Resulting text too long"

# The most bytes one put (a count times the register) inserts.
pub const MAX_PUT: i64 = 64 * 1024 * 1024

# The most jumps kept for Ctrl-O / Ctrl-T; the oldest go first.
pub const MAX_JUMPS: i64 = 100

# What the user asked the language server for (K, gd); the loop takes it.
pub enum LangAsk
    Nothing
    Hover
    Definition

# A selection as Visual mode left it, for gv: its ends and shape.
struct Selected
    anchor: Pos
    cursor: Pos
    shape: Shape

# A selection's ends in order: both included, `to` on a line's end
# standing for its break.
struct Extent
    from: Pos
    to: Pos

# Where a jump left from: a file (jump_paths[path_at .. path_at + path_len])
# and the cursor in it.
struct Jump
    path_at: i64
    path_len: i64
    at: Pos

pub struct Editor
    buf: Buffer
    path: String            # the file name; empty for a new buffer
    mode: Mode
    cursor: Pos
    want: i64               # the code-point column j and k aim for
    top: i64                # the first line on screen
    page: i64               # text rows on screen (Ctrl-F and Ctrl-B)
    reg: Vec<u8>            # the unnamed register
    reg_lines: bool         # it holds whole lines, each with its terminator
    pattern: Vec<u8>        # the last search pattern
    cmdline: String         # the command line: its prompt (`:` or `/`), then the text
    keys: NormalKeys        # the Normal-mode keys of a command not yet complete
    anchor: Pos             # Visual mode: the selection's end the cursor isn't on
    last_selection: Option<Selected>    # the last Visual selection, for gv
    message: String         # the message line
    quit: bool
    revisions: i64          # text revisions of the buffers before this one (text_revision)
    ask: LangAsk            # K or gd, until the loop takes it
    jumps: Vec<Jump>        # where each jump_to left from, oldest first
    jump_paths: Vec<u8>     # their file names, back to back

pub fn editor_new() -> Editor
    editor_with(string_new(), buffer_new())

# An editor on the file `path` holds, `data`.
pub fn editor_open(path: StrView, data: [u8]) -> Editor
    editor_with(string_from(path), buffer_from_bytes(data))

fn editor_with(path: String, buf: Buffer) -> Editor
    Editor { buf: buf, path: path, mode: Mode.Normal, cursor: pos(0, 0), want: 0, top: 0, page: 24, reg: vec_new<u8>(), reg_lines: false, pattern: vec_new<u8>(), cmdline: string_new(), keys: normal_keys_new(), anchor: pos(0, 0), last_selection: None, message: string_new(), quit: false, revisions: 0, ask: LangAsk.Nothing, jumps: vec_new<Jump>(), jump_paths: vec_new<u8>() }

# ============================================================================
# Characters and columns
# ============================================================================

enum CharClass
    Blank       # a space, a tab, or the end of a line
    Word        # letters, digits, `_` and anything non-ASCII
    Punct       # other ASCII

fn class_of(s: [u8], col: i64) -> CharClass
    if col >= s.len
        return CharClass.Blank
    let c = s[col]
    if c == ' ' or c == '\t'
        return CharClass.Blank
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c >= 0x80
        return CharClass.Word
    CharClass.Punct

# How an operator reaches a motion's target (Vim's exclusive, inclusive
# and linewise motions).
enum Reach
    Exclusive       # up to the target, not including it (w b h l 0)
    Inclusive       # the target's code point too (e $)
    Linewise        # whole lines, the cursor's to the target's (j k gg G dd)

# Where a motion takes the cursor, and how an operator reaches it.
struct Target
    at: Pos
    reach: Reach

# One step of w: keep going from a position, or end there.
enum Stride
    On(Pos)
    Done(Pos)

# The start of the code point holding byte `col`, kept on the last one: the
# Normal-mode column for `col`. 0 on an empty line.
fn normal_col(s: [u8], col: i64) -> i64
    if s.len == 0
        return 0
    var c: i64 = 0
    var n = utf8_next(s, 0)
    while n <= col and n < s.len
        c = n
        n = utf8_next(s, c)
    c

# The number of code points before byte `col`.
fn units_before(s: [u8], col: i64) -> i64
    var c: i64 = 0
    var n: i64 = 0
    while c < col and c < s.len
        c = utf8_next(s, c)
        n += 1
    n

# The byte column of code point `k`, or the line's end.
fn col_of_unit(s: [u8], k: i64) -> i64
    var c: i64 = 0
    for i in 0..k
        if c >= s.len
            return c
        c = utf8_next(s, c)
    c

fn first_non_blank(s: [u8]) -> i64
    var c: i64 = 0
    while c < s.len and (s[c] == ' ' or s[c] == '\t')
        c += 1
    normal_col(s, c)

# True when `needle` occurs in `hay` at `at`.
fn matches_at(hay: [u8], needle: [u8], at: i64) -> bool
    if at < 0 or at + needle.len > hay.len
        return false
    for k in 0..needle.len
        if hay[at + k] != needle[k]
            return false
    true

# Where `needle` first starts in `hay` at or after `from`.
fn find_from(hay: [u8], needle: [u8], from: i64) -> Option<i64>
    var i = if from < 0 then 0 else from
    while i + needle.len <= hay.len
        if matches_at(hay, needle, i)
            return Some(i)
        i += 1
    None

# Where `needle` last starts in `hay` before `before`.
fn find_before(hay: [u8], needle: [u8], before: i64) -> Option<i64>
    var i = hay.len - needle.len
    if i > before - 1
        i = before - 1
    while i >= 0
        if matches_at(hay, needle, i)
            return Some(i)
        i -= 1
    None

# The length of the line terminator ending `text`: 2 for CRLF, 1 for LF or
# CR, 0 for none.
fn trailing_term_len(text: [u8]) -> i64
    let n = text.len
    if n >= 2 and text[n - 2] == '\r' and text[n - 1] == '\n'
        return 2
    if n >= 1 and (text[n - 1] == '\n' or text[n - 1] == '\r')
        return 1
    0

# The Key as an ASCII byte, or 0 for any other key.
fn ascii_of(key: Key) -> u8
    match key
        Key.Char(c) => if c < 0x80 then c as u8 else 0
        _ => 0

# ============================================================================
# The screen's view of the editor
# ============================================================================

impl LineSource for Editor
    fn line_count(self: @Editor) -> i64
        self.shown()

    fn line(self: @Editor, l: i64) -> [u8]
        self.buf.line(l)

impl Editor
    # The lines the editor shows: all of the buffer's but the empty one
    # after a final newline.
    #
    # A loaded file's trailing newline and a line an Insert-mode Enter (or
    # o) just split off leave the Buffer in the same shape: the last line
    # is empty and has no terminator (core/buffer.ritz's invariant: only
    # the last line lacks one). The not-found path's buffer_new() starts
    # this way too, so typing a new file's first line and pressing Enter
    # hits it at once. Buffer can't tell the two apart; Editor can, while
    # the session that just split the line is still open: Insert mode,
    # cursor on that exact line. Hiding the line then would clamp the
    # screen's cursor back a row (#4906). Once Escape ends the session (or
    # a key types a byte onto the line, which flips has_final_newline()
    # off on its own) the ambiguity is gone and this no longer applies, so
    # a later edit that happens to leave the cursor on the same line
    # number (dd, say) is never affected by it.
    pub fn shown(self: @Editor) -> i64
        let n = self.buf.line_count()
        let splitting = self.mode == Mode.Insert and self.cursor.line == n - 1
        if self.buf.has_final_newline() and not splitting then n - 1 else n

    pub fn last(self: @Editor) -> i64
        self.shown() - 1

    pub fn status(self: @Editor) -> Status
        Status { name: self.path.as_view(), dirty: self.buf.is_dirty(), mode: self.mode, lang: "" }

    # A count that goes up with every change to the text, a new buffer from
    # `:e` included, and never otherwise (Buffer.revision across buffers).
    pub fn text_revision(self: @Editor) -> i64
        self.revisions + self.buf.revision()

    # A new buffer: text_revision keeps counting up from the old one's. pub
    # for handle_key<F>'s `:e`, as say() below is.
    pub fn replace_buffer(self: @&Editor, buf: Buffer)
        self.revisions += self.buf.revision() + 1
        self.buf = buf

    # The command line as typed, prompt first; empty outside CommandLine mode.
    pub fn command_line(self: @Editor) -> StrView
        self.cmdline.as_view()

    # say, place, place_line, insert_key, close_command_line, file_info and
    # say_about are pub only because the generic handle_key<F> family calls
    # them: an instantiation is compiled into the caller's module, and
    # ritz1_selfhosted gives a private method internal linkage.
    pub fn say(self: @&Editor, text: StrView)
        self.message.clear()
        self.message.push_str(text)

    # ------------------------------------------------------------------
    # Cursor placement
    # ------------------------------------------------------------------

    # Line l moved onto the shown lines.
    fn clamp_line(self: @Editor, l: i64) -> i64
        if l > self.last()
            return self.last()
        if l < 0 then 0 else l

    # The cursor at `p`, on a shown line and a Normal-mode column; `want`
    # follows it.
    pub fn place(self: @&Editor, p: Pos)
        let l = self.clamp_line(p.line)
        let s = self.buf.line(l)
        let col = if p.col > s.len then s.len else p.col
        self.cursor = pos(l, normal_col(s, col))
        self.want = units_before(s, self.cursor.col)

    # Line l (clamped), at its first non-blank.
    pub fn place_line(self: @&Editor, l: i64)
        let line = self.clamp_line(l)
        self.place(pos(line, first_non_blank(self.buf.line(line))))

    # One code point on within the shown text, crossing line ends: the end
    # of a line is a position of its own. None at the end of the last line.
    fn step(self: @Editor, p: Pos) -> Option<Pos>
        let s = self.buf.line(p.line)
        if p.col < s.len
            return Some(pos(p.line, utf8_next(s, p.col)))
        if p.line < self.last()
            return Some(pos(p.line + 1, 0))
        None

    # One code point back, onto the end of the line above from a line start.
    fn back(self: @Editor, p: Pos) -> Option<Pos>
        if p.col > 0
            return Some(pos(p.line, utf8_prev(self.buf.line(p.line), p.col)))
        if p.line > 0
            return Some(pos(p.line - 1, self.buf.line_len(p.line - 1)))
        None

    fn class_at(self: @Editor, p: Pos) -> CharClass
        class_of(self.buf.line(p.line), p.col)

    # ------------------------------------------------------------------
    # Motions: where each takes the cursor, without moving it
    # ------------------------------------------------------------------

    # True when the step from p to n left p's line or landed on its end.
    fn breaks(self: @Editor, p: Pos, n: Pos) -> bool
        n.line != p.line or n.col >= self.buf.line_len(n.line)

    # One step of w from p. With `stop_at_eol`, a step that leaves the line
    # or lands on its end ends the motion there.
    fn w_step(self: @Editor, p: Pos, stop_at_eol: bool) -> Stride
        match self.step(p)
            Some(n) => if stop_at_eol and self.breaks(p, n) then Stride.Done(n) else Stride.On(n)
            None => Stride.Done(p)

    # w, `count` times (Vim's fwd_word). With `eol` (an operator waits for
    # the motion) the last word stops at its line's end rather than crossing
    # to the next line's first word: `dw` on a line's last word keeps the
    # line break. An empty line is a word; past the last word, the end of
    # the text.
    fn word_forward_from(self: @Editor, from: Pos, count: i64, eol: bool) -> Pos
        var p = from
        for k in 0..count
            let stop_at_eol = eol and k == count - 1
            let cls = self.class_at(p)
            # Off the code point under the cursor: on the last line, the
            # line's end is as far as w goes.
            match self.w_step(p, stop_at_eol or p.line >= self.last())
                Stride.On(n) => p = n
                Stride.Done(n) => return n
            # To the end of its word, then over blanks to the next word.
            if cls != CharClass.Blank
                while self.class_at(p) == cls
                    match self.w_step(p, stop_at_eol)
                        Stride.On(n) => p = n
                        Stride.Done(n) => return n
            while self.class_at(p) == CharClass.Blank
                if p.col == 0 and self.buf.line_len(p.line) == 0
                    break
                match self.w_step(p, stop_at_eol)
                    Stride.On(n) => p = n
                    Stride.Done(n) => return n
        p

    # b, once: the start of this word, or of the one before. An empty line
    # is a word.
    fn word_backward_from(self: @Editor, from: Pos) -> Pos
        var p: Pos = match self.back(from)
            Some(n) => n
            None => return from
        while self.class_at(p) == CharClass.Blank
            if p.line != from.line and self.buf.line_len(p.line) == 0
                break
            match self.back(p)
                Some(n) => p = n
                None => break
        let cls = self.class_at(p)
        if cls != CharClass.Blank
            while p.col > 0
                let q = pos(p.line, utf8_prev(self.buf.line(p.line), p.col))
                if self.class_at(q) != cls
                    break
                p = q
        p

    # Past the run of `cls` code points at p. A word or punctuation run
    # ends on its own line, at the latest at the line's end.
    fn skip_class(self: @Editor, from: Pos, cls: CharClass) -> Pos
        var p = from
        while self.class_at(p) == cls
            match self.step(p)
                Some(n) => p = n
                None => return p
        p

    # e, `count` times (Vim's end_word): the end of this word, or of the
    # next; empty lines don't stop it. With `change` (cw on a word, which
    # changes to the word's end): a cursor on a word's last code point is at
    # its end already, and an empty line ends it. Past the last word, the
    # end of the text.
    fn word_end_from(self: @Editor, from: Pos, count: i64, change: bool) -> Pos
        var p = from
        for k in 0..count
            let cls = self.class_at(p)
            match self.step(p)
                Some(n) => p = n
                None => return p
            if cls != CharClass.Blank and self.class_at(p) == cls
                p = self.skip_class(p, cls)
            else if cls == CharClass.Blank or not (change and k == 0)
                var empty_line = false
                while self.class_at(p) == CharClass.Blank and not empty_line
                    if change and p.col == 0 and self.buf.line_len(p.line) == 0
                        empty_line = true
                    else
                        match self.step(p)
                            Some(n) => p = n
                            None => return p
                if empty_line
                    continue
                p = self.skip_class(p, self.class_at(p))
            p = self.back(p).unwrap_or(p)
        p

    # Line l (clamped) at the column `want` names: where j and k go.
    fn vertical(self: @Editor, l: i64) -> Pos
        let line = self.clamp_line(l)
        let s = self.buf.line(line)
        pos(line, normal_col(s, col_of_unit(s, self.want)))

    # Where motion `m` takes the cursor, with `count` as typed (0: none),
    # and how an operator reaches it. `op`: an operator waits for the
    # motion, which lets l reach a line's end and stops w there. None where
    # a line motion can't go at all (k on the first line): no move, and an
    # operator does nothing. h and l that can't move stay put, so an
    # operator gets an empty range (ch at a line's start still inserts).
    fn target(self: @Editor, m: Motion, count: i64, op: bool) -> Option<Target>
        let n = if count > 0 then count else 1
        let c = self.cursor
        let s = self.buf.line(c.line)
        match m
            Motion.Left =>
                var col = c.col
                var k: i64 = 0
                while k < n and col > 0
                    col = utf8_prev(s, col)
                    k += 1
                Some(Target { at: pos(c.line, col), reach: Reach.Exclusive })
            Motion.Right =>
                # Normal mode stops on the last code point; an operator
                # reaches past it, to the line's end.
                var col = c.col
                var k: i64 = 0
                while k < n and col < s.len
                    let next = utf8_next(s, col)
                    if not op and next >= s.len
                        break
                    col = next
                    k += 1
                Some(Target { at: pos(c.line, col), reach: Reach.Exclusive })
            Motion.Up =>
                if c.line == 0 then None else Some(Target { at: self.vertical(c.line - n), reach: Reach.Linewise })
            Motion.Down =>
                if c.line >= self.last() then None else Some(Target { at: self.vertical(c.line + n), reach: Reach.Linewise })
            Motion.WordForward => Some(Target { at: self.word_forward_from(c, n, op), reach: Reach.Exclusive })
            Motion.WordBackward =>
                var p = c
                var k: i64 = 0
                while k < n
                    let q = self.word_backward_from(p)
                    if not pos_before(q, p)
                        break
                    p = q
                    k += 1
                Some(Target { at: p, reach: Reach.Exclusive })
            Motion.WordEnd => Some(Target { at: self.word_end_from(c, n, false), reach: Reach.Inclusive })
            Motion.LineStart => Some(Target { at: pos(c.line, 0), reach: Reach.Exclusive })
            Motion.LineEnd =>
                let l = c.line + n - 1
                if l > self.last() then None else Some(Target { at: pos(l, self.buf.line_len(l)), reach: Reach.Inclusive })
            Motion.FirstLine => Some(self.line_target(if count > 0 then count - 1 else 0))
            Motion.LastLine => Some(self.line_target(if count > 0 then count - 1 else self.last()))
            Motion.Lines =>
                if n > 1 and c.line >= self.last() then None else Some(self.line_target(c.line + n - 1))

    # Line l (clamped), at its first non-blank, reached linewise.
    fn line_target(self: @Editor, l: i64) -> Target
        let line = self.clamp_line(l)
        Target { at: pos(line, first_non_blank(self.buf.line(line))), reach: Reach.Linewise }

    # A motion without an operator: the cursor goes to its target. j and k
    # keep the column they aim for. In Visual mode $ goes onto the line's
    # end, so the selection takes its break.
    fn move_by(self: @&Editor, m: Motion, count: i64)
        match self.target(m, count, false)
            Some(t) =>
                if m == Motion.Up or m == Motion.Down
                    self.cursor = t.at
                else if m == Motion.LineEnd and self.selecting()
                    self.cursor = t.at
                    self.want = units_before(self.buf.line(t.at.line), t.at.col)
                else
                    self.place(t.at)
            None => pass

    # The lines a page turns over: Vim keeps two of the old page in view.
    fn page_step(self: @Editor) -> i64
        if self.page > 3 then self.page - 2 else 1

    # Ctrl-F: the page down; the cursor on its top line.
    fn page_down(self: @&Editor)
        var t = self.top + self.page_step()
        if t > self.last()
            t = self.last()
        self.top = t
        self.place_line(t)

    # Ctrl-B: the page up; the cursor on its bottom line.
    fn page_up(self: @&Editor)
        var t = self.top - self.page_step()
        if t < 0
            t = 0
        self.top = t
        self.place_line(t + self.page - 1)

    # ------------------------------------------------------------------
    # Insert mode
    # ------------------------------------------------------------------

    # Into Insert mode at `at`; the session's edits are one undo step.
    fn start_insert(self: @&Editor, at: Pos)
        self.buf.begin_group()
        self.enter_insert(at)

    # Into Insert mode at `at`, in the undo step already open (c's).
    fn enter_insert(self: @&Editor, at: Pos)
        self.cursor = at
        self.mode = Mode.Insert

    pub fn insert_key(self: @&Editor, key: Key)
        match key
            Key.Escape =>
                self.buf.end_group()
                self.mode = Mode.Normal
                var col = self.cursor.col
                if col > 0
                    col = utf8_prev(self.buf.line(self.cursor.line), col)
                self.place(pos(self.cursor.line, col))
            Key.Backspace =>
                if self.cursor.col > 0
                    let from = pos(self.cursor.line, utf8_prev(self.buf.line(self.cursor.line), self.cursor.col))
                    self.cursor = self.buf.delete(from, self.cursor)
                else if self.cursor.line > 0
                    self.cursor = self.buf.join_lines(self.cursor.line - 1)
            Key.Enter => self.cursor = self.buf.split_line(self.cursor)
            Key.Tab => self.cursor = self.buf.insert(self.cursor, span_from_strview("\t"))
            Key.Char(c) =>
                let bytes = utf8_encode(c)
                self.cursor = self.buf.insert(self.cursor, span_from_vec<u8>(@bytes))
            _ => pass

    # ------------------------------------------------------------------
    # Edits and the register
    # ------------------------------------------------------------------

    fn set_register(self: @&Editor, text: [u8], lines: bool)
        self.reg.clear()
        self.reg.push_span(text)
        self.reg_lines = lines

    # Lines a..=b as the register holds them: their bytes and terminators,
    # the last line's own or, for the last line of the text, which has
    # none, the one above's or LF.
    fn yank_lines(self: @&Editor, a: i64, b: i64)
        var text = self.buf.text(pos(a, 0), pos(b, self.buf.line_len(b)))
        var t = self.buf.line_term(b)
        if t == Term.NoEol
            t = if b > 0 then self.buf.line_term(b - 1) else Term.Lf
        text.push_view(term_text(t))
        self.set_register(span_from_vec<u8>(@text), true)

    # Delete lines a..=b, terminators and all, into the register; the
    # cursor on the line that takes their place.
    fn delete_lines(self: @&Editor, a: i64, b: i64)
        self.yank_lines(a, b)
        if b + 1 < self.buf.line_count()
            self.buf.delete(pos(a, 0), pos(b + 1, 0))
        else if a > 0
            # Through the last line: take the terminator before them.
            self.buf.delete(pos(a - 1, self.buf.line_len(a - 1)), pos(b, self.buf.line_len(b)))
        else
            self.buf.delete(pos(0, 0), pos(b, self.buf.line_len(b)))
        self.place_line(a)

    # True when only blanks come before p on its line (Vim's inindent).
    fn in_indent(self: @Editor, p: Pos) -> bool
        let s = self.buf.line(p.line)
        for i in 0..p.col
            if s[i] != ' ' and s[i] != '\t'
                return false
        true

    # True when only blanks come from p to its line's end.
    fn blank_after(self: @Editor, p: Pos) -> bool
        let s = self.buf.line(p.line)
        for i in p.col..s.len
            if s[i] != ' ' and s[i] != '\t'
                return false
        true

    # Where operator `op` reaches with motion `m`: the motion's target,
    # except that cw on a word changes to the word's end (Vim's cw is ce).
    fn operator_target(self: @Editor, op: Operator, m: Motion, count: i64) -> Option<Target>
        let c = self.cursor
        if op == Operator.Change and m == Motion.WordForward and self.class_at(c) != CharClass.Blank
            let n = if count > 0 then count else 1
            return Some(Target { at: self.word_end_from(c, n, true), reach: Reach.Inclusive })
        self.target(m, count, true)

    # d, c or y over motion `m`. The text goes to the register, its lines
    # whole for a linewise motion. Vim's two adjustments to a charwise
    # range apply: an exclusive one that ends at a later line's start ends
    # at the line before's end instead (and is linewise when it starts in
    # the indent), and a d that spans lines with only blanks before its
    # start and after its end deletes the lines whole.
    fn operate(self: @&Editor, op: Operator, m: Motion, count: i64)
        let t: Target = match self.operator_target(op, m, count)
            Some(found) => found
            None => return
        var a = self.cursor
        var b = t.at
        if pos_before(b, a)
            a = t.at
            b = self.cursor
        if t.reach == Reach.Linewise
            self.on_lines(op, a.line, b.line)
            return
        if t.reach == Reach.Inclusive and b.col < self.buf.line_len(b.line)
            b = pos(b.line, utf8_next(self.buf.line(b.line), b.col))
        if t.reach == Reach.Exclusive and b.col == 0 and b.line > a.line
            if self.in_indent(a)
                self.on_lines(op, a.line, b.line - 1)
                return
            b = pos(b.line - 1, self.buf.line_len(b.line - 1))
        if op == Operator.Delete and b.line > a.line and self.in_indent(a) and self.blank_after(b)
            self.on_lines(op, a.line, b.line)
            return
        self.on_chars(op, a, b)

    # An operator over the text from a to b (a first, b excluded).
    fn on_chars(self: @&Editor, op: Operator, a: Pos, b: Pos)
        match op
            Operator.Yank =>
                self.take(a, b, false)
                self.place(a)
            Operator.Delete =>
                self.take(a, b, true)
                self.place(a)
            Operator.Change =>
                self.buf.begin_group()
                self.take(a, b, true)
                self.enter_insert(a)

    # The text from a to b into the register, and out of the buffer when
    # `cut`. An empty range leaves the register as it was.
    fn take(self: @&Editor, a: Pos, b: Pos, cut: bool)
        if not pos_before(a, b)
            return
        let text = self.buf.text(a, b)
        self.set_register(span_from_vec<u8>(@text), false)
        if cut
            self.buf.delete(a, b)

    # An operator over lines a..=b. c leaves one empty line to type on.
    fn on_lines(self: @&Editor, op: Operator, a: i64, b: i64)
        match op
            Operator.Delete => self.delete_lines(a, b)
            Operator.Yank =>
                self.yank_lines(a, b)
                if a != self.cursor.line
                    self.cursor = self.vertical(a)
            Operator.Change =>
                self.buf.begin_group()
                self.yank_lines(a, b)
                self.buf.delete(pos(a, 0), pos(b, self.buf.line_len(b)))
                self.enter_insert(pos(a, 0))

    # p (after) and P (before): put the register `times` over by the
    # cursor, its lines by the cursor's line. One undo step.
    fn put(self: @&Editor, after: bool, times: i64)
        let repeated: Vec<u8> = match self.repeated_register(times)
            Some(r) => r
            None => return
        let l = self.cursor.line
        let text = span_from_vec<u8>(@repeated)
        if self.reg_lines
            if not after
                self.buf.insert(pos(l, 0), text)
                self.place_line(l)
            else if l + 1 < self.buf.line_count()
                self.buf.insert(pos(l + 1, 0), text)
                self.place_line(l + 1)
            else
                # After the last line, which has no terminator: the
                # register's terminator goes in front instead.
                let body = text.len - trailing_term_len(text)
                var moved: Vec<u8> = vec_new<u8>()
                moved.push_span(text[body..text.len])
                moved.push_span(text[0..body])
                self.buf.insert(pos(l, self.buf.line_len(l)), span_from_vec<u8>(@moved))
                self.place_line(l + 1)
            return
        var at = self.cursor
        if after
            at = pos(l, utf8_next(self.buf.line(l), self.cursor.col))
        let end = self.buf.insert(at, text)
        self.place(self.buf.prev_char(end))

    # p (after) or P: by the cursor, or over the selection in Visual mode,
    # where P keeps the register.
    fn put_key(self: @&Editor, after: bool, times: i64)
        if self.selecting()
            self.put_over(not after, times)
        else
            self.put(after, times)

    # The register `times` over, for a put. None when it is empty, or when
    # that is more than MAX_PUT bytes, which says so.
    fn repeated_register(self: @&Editor, times: i64) -> Option<Vec<u8>>
        if self.reg.len() == 0
            return None
        if times > MAX_PUT / self.reg.len()
            self.say(MSG_TOO_LONG)
            return None
        var out: Vec<u8> = vec_with_cap<u8>(self.reg.len() * times)
        for k in 0..times
            out.push_span(span_from_vec<u8>(@self.reg))
        Some(out)

    # u, once; false when there was nothing to undo.
    fn undo(self: @&Editor) -> bool
        match self.buf.undo()
            Some(p) =>
                self.place(p)
                true
            None =>
                self.say("Already at oldest change")
                false

    # Ctrl-R, once; false when there was nothing to redo.
    fn redo(self: @&Editor) -> bool
        match self.buf.redo()
            Some(p) =>
                self.place(p)
                true
            None =>
                self.say("Already at newest change")
                false

    # ------------------------------------------------------------------
    # Visual mode
    # ------------------------------------------------------------------

    # True in Visual or Visual Line mode.
    fn selecting(self: @Editor) -> bool
        self.mode == Mode.Visual or self.mode == Mode.VisualLine

    fn shape(self: @Editor) -> Shape
        if self.mode == Mode.VisualLine then Shape.Lines else Shape.Chars

    # The selection's ends in order; linewise, its lines whole.
    fn extent(self: @Editor) -> Extent
        var from = self.anchor
        var to = self.cursor
        if pos_before(to, from)
            from = self.cursor
            to = self.anchor
        if self.mode == Mode.VisualLine
            return Extent { from: pos(from.line, 0), to: pos(to.line, self.buf.line_len(to.line)) }
        Extent { from: from, to: to }

    # What the screen draws as selected; None outside Visual mode.
    pub fn selection(self: @Editor) -> Option<Selection>
        if not self.selecting()
            return None
        let e = self.extent()
        Some(Selection { from_line: e.from.line, from_byte: e.from.col, to_line: e.to.line, to_byte: e.to.col, lines: self.mode == Mode.VisualLine })

    # v or V: start a selection of `shape` at the cursor; in one, switch
    # to `shape`, or leave when it is that already.
    fn select(self: @&Editor, shape: Shape)
        if not self.selecting()
            self.anchor = self.cursor
        else if self.shape() == shape
            self.leave_visual()
            return
        self.mode = if shape == Shape.Lines then Mode.VisualLine else Mode.Visual

    # Back to Normal mode, keeping the selection for gv; the cursor back
    # onto a code point.
    fn leave_visual(self: @&Editor)
        self.last_selection = Some(Selected { anchor: self.anchor, cursor: self.cursor, shape: self.shape() })
        self.mode = Mode.Normal
        self.place(self.cursor)

    # gv: the last selection again, its ends moved onto the text as it is
    # now. In Visual mode the current one becomes the last.
    fn reselect(self: @&Editor)
        let last: Selected = match self.last_selection
            Some(s) => s
            None => return
        if self.selecting()
            self.last_selection = Some(Selected { anchor: self.anchor, cursor: self.cursor, shape: self.shape() })
        self.place(last.anchor)
        self.anchor = self.cursor
        self.place(last.cursor)
        self.mode = if last.shape == Shape.Lines then Mode.VisualLine else Mode.Visual

    # o: the cursor to the selection's other end.
    fn swap_ends(self: @&Editor)
        let a = self.anchor
        self.anchor = self.cursor
        self.cursor = a
        self.want = units_before(self.buf.line(a.line), a.col)

    # Just past a charwise selection's last end: after its code point, or
    # past its break onto the next line's start. The last shown line's
    # break is the file's final newline, which no selection takes.
    fn past(self: @Editor, to: Pos) -> Pos
        if to.col < self.buf.line_len(to.line)
            return pos(to.line, utf8_next(self.buf.line(to.line), to.col))
        if to.line < self.last()
            return pos(to.line + 1, 0)
        to

    # d, c or y on the selection, then Normal mode (Insert for c). The
    # cursor goes to the selection's start, as Vim's does: for a linewise
    # y the start of its first line.
    fn operate_selection(self: @&Editor, op: Operator)
        let e = self.extent()
        let lines = self.mode == Mode.VisualLine
        self.leave_visual()
        if not lines
            self.on_chars(op, e.from, self.past(e.to))
            return
        self.on_lines(op, e.from.line, e.to.line)
        if op == Operator.Yank
            self.place(e.from)

    # p and P on a selection: the register, `times` over, in its place, in
    # one undo step. p puts the replaced text in the register; P keeps it.
    # Lines over a charwise selection go on lines of their own; a charwise
    # register over lines becomes their text.
    fn put_over(self: @&Editor, keep: bool, times: i64)
        let e = self.extent()
        let lines = self.mode == Mode.VisualLine
        self.leave_visual()
        let repeated: Vec<u8> = match self.repeated_register(times)
            Some(r) => r
            None => return
        let text = span_from_vec<u8>(@repeated)
        let reg_lines = self.reg_lines
        if lines
            if not keep
                self.yank_lines(e.from.line, e.to.line)
            # The selection's last terminator stays: the put lines' last goes.
            let body = if reg_lines then text[0..text.len - trailing_term_len(text)] else text
            self.buf.replace(e.from, e.to, body)
            self.place_line(e.from.line)
            return
        let b = self.past(e.to)
        if not keep
            self.take(e.from, b, false)
        if reg_lines
            # A line break in front: the text is lines after the start's.
            var broken: Vec<u8> = vec_with_cap<u8>(text.len + 2)
            broken.push_span(text[text.len - trailing_term_len(text)..text.len])
            broken.push_span(text)
            self.buf.replace(e.from, b, span_from_vec<u8>(@broken))
            self.place_line(e.from.line + 1)
            return
        let end = self.buf.replace(e.from, b, text)
        self.place(self.buf.prev_char(end))

    # ------------------------------------------------------------------
    # Search
    # ------------------------------------------------------------------

    # n (forward) and N: the next match of the last pattern, wrapping
    # around the buffer once, the cursor's own match last. False when there
    # is none.
    fn search(self: @&Editor, forward: bool) -> bool
        if self.pattern.len() == 0
            self.say(MSG_NO_PATTERN)
            return false
        let pat = span_from_vec<u8>(@self.pattern)
        let n = self.shown()
        let cur = self.cursor
        for k in 0..=n
            let l = if forward then (cur.line + k) % n else (cur.line - k + n) % n
            let s = self.buf.line(l)
            var hit: Option<i64> = None
            if forward
                hit = find_from(s, pat, if k == 0 then cur.col + 1 else 0)
                if k == n and hit.unwrap_or(0) > cur.col
                    hit = None
            else
                hit = find_before(s, pat, if k == 0 then cur.col else s.len + 1)
                if k == n and hit.unwrap_or(s.len) < cur.col
                    hit = None
            match hit
                Some(col) =>
                    self.place(pos(l, col))
                    if forward and cur.line + k >= n
                        self.say("search hit BOTTOM, continuing at TOP")
                    else if not forward and cur.line - k < 0
                        self.say("search hit TOP, continuing at BOTTOM")
                    return true
                None => pass
        var msg = string_from("Pattern not found: ")
        msg.push_span(pat)
        self.say(msg.as_view())
        false

    # ------------------------------------------------------------------
    # The command line
    # ------------------------------------------------------------------

    fn open_command_line(self: @&Editor, prompt: u8)
        self.cmdline.clear()
        self.cmdline.push(prompt)
        self.mode = Mode.CommandLine

    pub fn close_command_line(self: @&Editor)
        self.cmdline.clear()
        self.mode = Mode.Normal

    # The editor's size message for `path`: `"path" 2L, 8B`.
    pub fn file_info(self: @Editor, path: StrView) -> String
        var msg = string_from("\"")
        msg.push_str(path)
        msg.push_str("\" ")
        msg.push_i64(if self.buf.byte_len() == 0 then 0 else self.shown())
        msg.push_str("L, ")
        msg.push_i64(self.buf.byte_len())
        msg.push('B')
        msg

    pub fn say_about(self: @&Editor, path: StrView, what: StrView)
        var msg = string_from("\"")
        msg.push_str(path)
        msg.push('"')
        msg.push_str(what)
        self.say(msg.as_view())

# ============================================================================
# Keys
# ============================================================================

# Apply one typed key. `files` loads and saves for `:e` and `:w`.
pub fn handle_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key)
    ed.message.clear()
    match ed.mode
        Mode.Normal => normal_key<F>(ed, files, key, Keymap.Normal)
        Mode.Visual | Mode.VisualLine => normal_key<F>(ed, files, key, Keymap.Visual)
        Mode.Insert => ed.insert_key(key)
        Mode.CommandLine => command_line_key<F>(ed, files, key)

# A key of a Normal- or Visual-mode command; run it once complete.
fn normal_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key, map: Keymap)
    match ed.keys.feed(key, map)
        Step.Run(cmd) => run_normal<F>(ed, files, cmd)
        Step.Wait | Step.Cancel => pass

# n or N `times` over, stopping at the first miss.
fn repeat_search(ed: @&Editor, forward: bool, times: i64)
    var k: i64 = 0
    while k < times and ed.search(forward)
        k += 1

# Run one Normal- or Visual-mode command (core/normal.ritz decoded it). A
# count repeats u, Ctrl-R, n, N, Ctrl-F, Ctrl-B and Ctrl-O until one fails;
# i, a, o, O, :, /, K, gd and the Visual commands but p and P take none.
fn run_normal<F: FileStore>(ed: @&Editor, files: @&F, cmd: NormalCommand)
    let times = cmd.times()
    let l = ed.cursor.line
    match cmd.action
        Action.Move(m) => ed.move_by(m, cmd.count)
        Action.Operate(op, m) => ed.operate(op, m, cmd.count)
        Action.Insert => ed.start_insert(ed.cursor)
        Action.Append => ed.start_insert(pos(l, utf8_next(ed.buf.line(l), ed.cursor.col)))
        Action.OpenBelow =>
            ed.start_insert(ed.cursor)
            ed.cursor = ed.buf.split_line(pos(l, ed.buf.line_len(l)))
        Action.OpenAbove =>
            ed.start_insert(pos(l, 0))
            ed.buf.split_line(pos(l, 0))
        Action.PutAfter => ed.put_key(true, times)
        Action.PutBefore => ed.put_key(false, times)
        Action.Undo =>
            var k: i64 = 0
            while k < times and ed.undo()
                k += 1
        Action.Redo =>
            var k: i64 = 0
            while k < times and ed.redo()
                k += 1
        Action.SearchNext => repeat_search(ed, true, times)
        Action.SearchPrev => repeat_search(ed, false, times)
        Action.PageDown =>
            for k in 0..(if times > ed.shown() then ed.shown() else times)
                ed.page_down()
        Action.PageUp =>
            for k in 0..(if times > ed.shown() then ed.shown() else times)
                ed.page_up()
        Action.CommandLine => ed.open_command_line(':')
        Action.Search => ed.open_command_line('/')
        Action.Hover => ed.ask = LangAsk.Hover
        Action.Definition => ed.ask = LangAsk.Definition
        Action.JumpBack =>
            var k: i64 = 0
            while k < times and jump_back<F>(ed, files)
                k += 1
        Action.Select(shape) => ed.select(shape)
        Action.Reselect => ed.reselect()
        Action.SwapEnds => ed.swap_ends()
        Action.OperateSelection(op) => ed.operate_selection(op)
        Action.Leave => ed.leave_visual()

fn command_line_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key)
    match key
        Key.Escape => ed.close_command_line()
        Key.Backspace =>
            # Backspace over the prompt leaves the command line.
            if ed.cmdline.len() <= 1
                ed.close_command_line()
            else
                let s = span_from_strview(ed.cmdline.as_view())
                let keep = utf8_prev(s, s.len)
                while ed.cmdline.len() > keep
                    ed.cmdline.pop()
        Key.Enter =>
            let line = string_from(ed.cmdline.as_view())
            ed.close_command_line()
            let text = line.as_view().slice(1, line.len())
            if line.get(0) == '/'
                run_search(ed, text)
            else
                run_command<F>(ed, files, text)
        Key.Tab => ed.cmdline.push('\t')
        Key.Char(c) =>
            let bytes = utf8_encode(c)
            ed.cmdline.push_span(span_from_vec<u8>(@bytes))
        _ => pass

# `/text`: search for `text` from the cursor; an empty one repeats the last.
fn run_search(ed: @&Editor, text: StrView)
    if not text.is_empty()
        ed.pattern.clear()
        ed.pattern.push_view(text)
    let found = ed.search(true)

fn run_command<F: FileStore>(ed: @&Editor, files: @&F, text: StrView)
    match parse_command(text)
        Some(cmd) => match cmd
            Command.Goto(n) => ed.place_line(n - 1)
            Command.Write => write_named<F>(ed, files)
            Command.WriteTo(p) =>
                # A copy, unless the buffer has no name yet or it is this one.
                let own = ed.path.is_empty() or ed.path.as_view().eq(p)
                if ed.path.is_empty()
                    ed.path.push_str(p)
                write<F>(ed, files, p, own)
            Command.WriteQuit =>
                if write_named<F>(ed, files)
                    ed.quit = true
            Command.Quit =>
                if ed.buf.is_dirty()
                    ed.say(MSG_NOT_SAVED)
                else
                    ed.quit = true
            Command.ForceQuit => ed.quit = true
            Command.Edit(p) =>
                let opened = edit<F>(ed, files, p)
        None =>
            var msg = string_from("E492: Not an editor command: ")
            msg.push_str(text)
            ed.say(msg.as_view())

# Save to the buffer's own name; true when saved.
fn write_named<F: FileStore>(ed: @&Editor, files: @&F) -> bool
    if ed.path.is_empty()
        ed.say(MSG_NO_NAME)
        return false
    let path = string_from(ed.path.as_view())
    write<F>(ed, files, path.as_view(), true)

# Save the buffer to `path`, marking it clean when `own` (the buffer's own
# file). On failure it stays dirty. True when saved.
fn write<F: FileStore>(ed: @&Editor, files: @&F, path: StrView, own: bool) -> bool
    match files.save(path, @ed.buf)
        Ok(_) =>
            if own
                ed.buf.mark_saved()
            var msg = ed.file_info(path)
            msg.push_str(" written")
            ed.say(msg.as_view())
            true
        Err(e) =>
            match e
                SaveError.Changed => ed.say_about(path, " changed on disk since it was read: not written")
                SaveError.Failed(errno) =>
                    var what = string_from(" not written: ")
                    what.push_str(errno.message())
                    ed.say_about(path, what.as_view())
                SaveError.Unpersisted(errno) =>
                    var what = string_from(" not saved to storage: ")
                    what.push_str(errno.message())
                    what.push_str("; the live file may already have changed")
                    ed.say_about(path, what.as_view())
            false

# `:e path`: replace the buffer with the file, refused with pending edits.
# A missing file opens empty under its name.
# True when the file is now the buffer.
fn edit<F: FileStore>(ed: @&Editor, files: @&F, path: StrView) -> bool
    if path.is_empty()
        ed.say(MSG_NO_NAME)
        return false
    if ed.buf.is_dirty()
        ed.say(MSG_NOT_SAVED)
        return false
    match files.load(path)
        Ok(bytes) =>
            ed.replace_buffer(buffer_from_bytes(span_from_vec<u8>(@bytes)))
            let info = ed.file_info(path)
            ed.say(info.as_view())
        Err(e) =>
            match e
                LoadError.NotFound =>
                    ed.replace_buffer(buffer_new())
                    ed.say_about(path, " [New]")
                LoadError.Failed(errno) =>
                    var what = string_from(": ")
                    what.push_str(errno.message())
                    ed.say_about(path, what.as_view())
                    return false
    ed.path.clear()
    ed.path.push_str(path)
    ed.top = 0
    ed.place(pos(0, 0))
    true

# ============================================================================
# Jumps (go to definition and back)
# ============================================================================

impl Editor
    # K or gd since the last call, cleared.
    pub fn take_ask(self: @&Editor) -> LangAsk
        let a = self.ask
        self.ask = LangAsk.Nothing
        a

    # How many jumps Ctrl-O / Ctrl-T can go back.
    pub fn jump_depth(self: @Editor) -> i64
        self.jumps.len()

    # Remember the cursor and file, to come back to. pub only for the
    # generic jump_to<F> (see say()).
    pub fn push_jump(self: @&Editor)
        if self.jumps.len() >= MAX_JUMPS
            # Drop the oldest: its name leaves the front of the pool.
            let old = self.jumps.get(0)
            var kept: Vec<Jump> = vec_with_cap<Jump>(MAX_JUMPS)
            for i in 1..self.jumps.len()
                var j = self.jumps.get(i)
                j.path_at -= old.path_len
                kept.push(j)
            self.jumps = kept
            let all: [u8] = self.jump_paths[0..self.jump_paths.len()]
            let rest = all.len - old.path_len
            all[0..rest].copy_from(all[old.path_len..all.len])
            while self.jump_paths.len() > rest
                self.jump_paths.pop()
        let at = self.jump_paths.len()
        self.jump_paths.push_view(self.path.as_view())
        self.jumps.push(Jump { path_at: at, path_len: self.path.len(), at: self.cursor })

    # The newest jump, taken off: its file name and cursor. pub only for
    # the generic jump_back<F>.
    pub fn pop_jump(self: @&Editor) -> Option<JumpBack>
        if self.jumps.is_empty()
            return None
        let j = self.jumps.pop()
        let all: [u8] = self.jump_paths[j.path_at..j.path_at + j.path_len]
        let back = JumpBack { path: string_from(all.as_strview()), at: j.at }
        while self.jump_paths.len() > j.path_at
            self.jump_paths.pop()
        Some(back)

    # Put back a jump pop_jump gave, as it was. pub for jump_back<F>.
    pub fn restore_jump(self: @&Editor, j: @JumpBack)
        let at = self.jump_paths.len()
        self.jump_paths.push_view(j.path.as_view())
        self.jumps.push(Jump { path_at: at, path_len: j.path.len(), at: j.at })

# A jump taken off the stack (Editor.pop_jump).
pub struct JumpBack
    path: String
    at: Pos

# Go to `at` in the file `path` (this buffer's when it names it),
# remembering where the cursor was for Ctrl-O / Ctrl-T. Another file is
# opened as `:e` would, so pending edits refuse it (E37). True when there.
pub fn jump_to<F: FileStore>(ed: @&Editor, files: @&F, path: StrView, at: Pos) -> bool
    ed.push_jump()
    if not ed.path.as_view().eq(path)
        if not edit<F>(ed, files, path)
            let dropped = ed.pop_jump()
            return false
    ed.place(at)
    true

# Ctrl-O / Ctrl-T: back to where the last jump_to left from. A file that
# can't be reopened (pending edits) keeps the jump for another try. True
# when back.
fn jump_back<F: FileStore>(ed: @&Editor, files: @&F) -> bool
    let j: JumpBack = match ed.pop_jump()
        Some(b) => b
        None =>
            ed.say(MSG_NO_JUMP)
            return false
    if not ed.path.as_view().eq(j.path.as_view())
        if not edit<F>(ed, files, j.path.as_view())
            ed.restore_jump(@j)
            return false
    ed.place(j.at)
    true
