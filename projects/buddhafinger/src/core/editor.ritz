# core/editor.ritz - the editor: modes, the commands, buffers and windows.
#
# The editor state is the buffer list and the windows onto it, one unnamed
# register, the last search pattern, the Normal-mode keys typed so far
# (core/normal.ritz), the command line being typed, and in Visual mode the
# selection's other end (the anchor). handle_key() applies one typed Key to
# it; the commands are docs/BUDDHAFINGER_PROPOSAL.md's "First usable
# release" table, then counts, operators, Visual mode, buffers and windows
# from "Everyday code editing" (Vim behaviour throughout):
#
#   Motion        h j k l, arrows, w b e, 0 $, gg G, gj gk, Ctrl-F Ctrl-B
#   Insert        i a o O, Escape, Backspace, Enter, Tab
#   Operators     d c y with any motion, dd cc yy; x D C Y; p P;
#                 one unnamed register
#   Counts        before a motion, a command or an operator, and after an
#                 operator (2d3w: six words); {count}G and {count}gg name a line
#   Visual        v V (switch shape, or leave), Escape; every motion with
#                 counts moves the cursor end, o O swap the ends; d x c s y
#                 and p P on the selection; gv reselects the last one
#   Undo          u Ctrl-R; an Insert session (with the c that opened it)
#                 is one undo step
#   Search        / ? (Vim's regular expressions: ritzlib.regex), n N
#                 (the last search's way, and the other), * # (the word
#                 under the cursor); each a motion for an operator (d/pat)
#   Command line  :w  :w <path>  :q  :q!  :wq  :e <path>  :<line>
#   Buffers       :ls  :b [N | name]  :bn  :bp  :bd[!] [N]
#   Windows       :sp [path]  :vs [path]  :close  :only;  Ctrl-W h j k l
#                 w W (a count names the window), s v, c o q
#   Language      K (hover), gd (go to definition), Ctrl-O / Ctrl-T (jump back)
#   Pickers       :Files  :Buffers; then type to narrow, Up Down Ctrl-P
#                 Ctrl-N, Backspace, Enter (open), Escape (close)
#   Quickfix      :vimgrep /pat/[gj] [glob ...]  :grep pat [glob ...]
#                 :cn [N]  :cp [N]  :cN [N]  :cc [N]  :cfirst [N]  :crewind [N]
#                 :clast [N]  :copen  :cclose
#
# Buffers (AGAST #4912). Each file has one Buffer, kept in the list with its
# name, its own undo history and a number (Vim's: 1 up, never used again).
# `:e` adds a buffer or shows the one the file has, and the one left stays,
# pending edits and all: no E37 for a buffer hidden that way. `:q` in the
# last window is refused while any buffer has pending edits (E37 for this
# one, else E162 for the first other, which it shows). `:bd` takes a buffer
# off the list, closing the other windows showing it.
#
# Windows. Each window shows a buffer through its own cursor, `want`, top
# line and jump stack; core/layout.ritz lays them out (Vim's frames, sized
# equally). The current window's cursor, want and top are the Editor's own
# fields, which every motion and edit uses; park() stores them into its
# Window when another window becomes current, and enter() loads them back.
# Two windows onto one buffer share its text and undo history: an edit in
# one moves the other's cursor and top line through the buffer's change
# notes (Buffer.changes), so they stay on the same text. The search pattern
# is the editor's, shared by every window as Vim's last pattern is.
#
# K and gd only raise a request (take_ask): the event loop asks the language
# server and, for gd, calls jump_to with the answer. Each jump_to pushes
# where the cursor was onto the window's jump stack, and Ctrl-O or Ctrl-T
# goes back there, showing the file's buffer again (loading it only when it
# was deleted).
#
# Pickers (AGAST #4913). `:Files` opens core/picker.ritz's Picker over the
# FileStore's list of the workspace (at most MAX_PICKER_FILES), `:Buffers`
# over the buffer list, its dirty buffers marked; Mode.Picker sends every
# key to it until Enter opens the selected file (as `:e` would) or shows
# the selected buffer (as `:b` would), or Escape closes it.
#
# Workspace search (AGAST #4972). `:vimgrep` and `:grep` search the
# FileStore's list of the workspace (at most MAX_PICKER_FILES files, only
# those a glob names when globs are given: ritzlib.glob, `**/*.ritz`) for a
# pattern, Vim's regular expressions as `/` takes them: a file with a
# buffer as the buffer holds it, pending edits and all, any other as
# loaded, skipped when a NUL in its first BINARY_PROBE bytes says it is
# binary. The matches replace core/quickfix.ritz's list, the pattern
# becomes the last search's, and unless the `j` flag says not to, the
# cursor goes to the first. `:cn` `:cp` `:cc` `:cfirst` `:clast` go
# through the list, showing each entry's file as `:e` would (the buffer
# left stays, pending edits and all) and `(k of n): text` on the message
# line; after_key moves the entries of each buffer edited through its
# change notes, so they stay on the text that matched. `:copen` shows the
# list in the picker, the current entry selected, and Enter goes to the one
# picked. `:cclose` closes it, which is nothing to do: the picker closes
# on Enter or Escape, before a command line can be typed.
#
# Files go through the FileStore seam (core/files.ritz), so the core does no
# I/O. The event loop paints through core.paint, which draws each window of
# tiling() from the window queries below and keeps their tops in step with
# what it scrolls.
#
# Lines: a file ending in a newline keeps an empty last line in the Buffer
# (core/buffer.ritz). Vim doesn't show it as a line, and neither does the
# editor: motions stop at the line before it (shown() / last()).
# Columns are byte indexes into a line. In Normal mode the cursor sits on a
# code point, never past the last; in Insert mode it may sit at the end, and
# in Visual mode too after $, where the selection takes the line break.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.glob { Glob, glob_compile }
import ritzlib.gvec
import ritzlib.option
import ritzlib.regex { RegexMatch, Regex, RegexSyntax, regex_compile }
import ritzlib.result { Result }
import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string
import ritzlib.termsession { Key }

import core.buffer { Buffer, Change, Pos, Term, buffer_new, buffer_from_bytes, pos, pos_before, term_text }
import core.commands { Command, parse_command }
import core.files { FileStore, LoadError, PathList, SaveError }
import core.picker { Picker, PickerKind, picker_new }
import core.quickfix { GrepArgs, MSG_QF_BAD_ARGS, MSG_QF_EMPTY, MSG_QF_NO_MORE, QfError, Quickfix, glob_word, parse_grep, parse_vimgrep, quickfix_new, word_count }
import core.history { release_all }
import core.layout { Dir, Layout, Rect, Split, Tiling, layout_new, rect }
import core.modes { Mode }
import core.normal { Action, Keymap, Motion, NormalCommand, NormalKeys, Operator, Shape, Step, WindowCommand, normal_keys_new }
import core.screen { LineSource, Selection, Size, Status, gutter_width }
import core.utf8 { utf8_encode, utf8_next, utf8_prev }

pub const MSG_NOT_SAVED: StrView = "E37: No write since last change (add ! to override)"
pub const MSG_NO_NAME: StrView = "E32: No file name"
pub const MSG_NO_PATTERN: StrView = "No previous search pattern"
pub const MSG_NO_STRING: StrView = "E348: No string under cursor"
pub const MSG_NO_JUMP: StrView = "E73: Tag stack empty"
pub const MSG_TOO_LONG: StrView = "E1240: Resulting text too long"
pub const MSG_NO_ROOM: StrView = "E36: Not enough room"
pub const MSG_LAST_WINDOW: StrView = "E444: Cannot close last window"

# The most bytes one put (a count times the register) inserts.
pub const MAX_PUT: i64 = 64 * 1024 * 1024

# The most files the file picker lists: a bigger tree is cut off there.
pub const MAX_PICKER_FILES: i64 = 20000

# How many of a file's first bytes :vimgrep looks in for a NUL, the sign of
# a binary file it doesn't search (git's heuristic, and its count).
pub const BINARY_PROBE: i64 = 8000

# The most jumps kept for Ctrl-O / Ctrl-T; the oldest go first.
pub const MAX_JUMPS: i64 = 100

# The terminal size an editor assumes until resize() says otherwise.
pub const DEFAULT_SIZE: Size = Size { rows: 24, cols: 80 }

# What the user asked the language server for (K, gd); the loop takes it.
pub enum LangAsk
    Nothing
    Hover
    Definition

# A selection as Visual mode left it, for gv: its ends and shape.
struct Selected
    anchor: Pos
    cursor: Pos
    shape: Shape

# A selection's ends in order: both included, `to` on a line's end
# standing for its break.
struct Extent
    from: Pos
    to: Pos

# Where a jump left from: a file (Jumps.paths[path_at .. path_at +
# path_len]) and the cursor in it.
struct Jump
    path_at: i64
    path_len: i64
    at: Pos

# A window's jump stack: where each jump_to left from, oldest first, at
# most MAX_JUMPS.
struct Jumps
    list: Vec<Jump>
    paths: Vec<u8>          # their file names, back to back

fn jumps_new() -> Jumps
    Jumps { list: vec_new<Jump>(), paths: vec_new<u8>() }

# A buffer in the list.
struct Listed
    number: i64             # Vim's buffer number: 1 up, never used again
    buf: Buffer
    path: String            # the file name; empty for a new buffer
    cursor: Pos             # where the cursor was when a window last left it
    last_selection: Option<Selected>    # the last Visual selection in it, for gv

fn listed(number: i64, buf: Buffer, path: String) -> Listed
    Listed { number: number, buf: buf, path: path, cursor: pos(0, 0), last_selection: None }

# A window onto a buffer. While it is current, its cursor, want and top are
# the Editor's fields and these copies are stale (see park/enter).
struct Window
    id: i64                 # its name in the layout
    number: i64             # the buffer it shows
    alt: Option<i64>        # the buffer it showed before (`#` in :ls)
    cursor: Pos
    want: i64
    top: i64
    jumps: Jumps

# An other window's cursor and top line as byte offsets into the buffer
# both show, taken before a key's edits (watch) and moved through them
# after (follow).
struct Watched
    id: i64
    number: i64
    cursor: i64
    top: i64

pub struct Editor
    bufs: Vec<Listed>       # the buffer list, by number
    at: i64                 # the current window's buffer: its index in bufs
    wins: Vec<Window>       # the windows, in no order (layout.order() has it)
    cur: i64                # the current window: its index in wins
    layout: Layout
    size: Size              # the terminal's: the windows share all but its last row
    next_number: i64        # the next buffer's number
    next_id: i64            # the next window's id
    mode: Mode
    cursor: Pos             # the current window's cursor
    want: i64               # its code-point column j and k aim for
    top: i64                # its first line on screen
    reg: Vec<u8>            # the unnamed register
    reg_lines: bool         # it holds whole lines, each with its terminator
    pattern: Vec<u8>        # the last search pattern
    forward: bool           # the last search went forward (/ *), not back (? #)
    cmdline: String         # the command line: its prompt (`:`, `/` or `?`), then the text
    search_op: Option<Operator> # the operator waiting for the `/` or `?` being typed
    search_count: i64       # and the count typed before it (0: none)
    keys: NormalKeys        # the Normal-mode keys of a command not yet complete
    anchor: Pos             # Visual mode: the selection's end the cursor isn't on
    message: String         # the message line; lines broken by `\n` (:ls) wait for a key
    quit: bool
    ask: LangAsk            # K or gd, until the loop takes it
    watched: Vec<Watched>   # before_key's notes, for after_key
    picker: Picker          # Picker mode's; empty otherwise
    qf: Quickfix            # the last workspace search's matches

impl Drop for Editor
    fn drop(self: @&Editor)
        release_all<Listed>(@&self.bufs)
        release_all<Window>(@&self.wins)

pub fn editor_new() -> Editor
    editor_with(string_new(), buffer_new())

# An editor on the file `path` holds, `data`.
pub fn editor_open(path: StrView, data: [u8]) -> Editor
    editor_with(string_from(path), buffer_from_bytes(data))

fn editor_with(path: String, buf: Buffer) -> Editor
    var bufs: Vec<Listed> = vec_new<Listed>()
    bufs.push(listed(1, buf, path))
    var wins: Vec<Window> = vec_new<Window>()
    wins.push(Window { id: 0, number: 1, alt: None, cursor: pos(0, 0), want: 0, top: 0, jumps: jumps_new() })
    Editor { bufs: bufs, at: 0, wins: wins, cur: 0, layout: layout_new(0), size: DEFAULT_SIZE, next_number: 2, next_id: 1, mode: Mode.Normal, cursor: pos(0, 0), want: 0, top: 0, reg: vec_new<u8>(), reg_lines: false, pattern: vec_new<u8>(), forward: true, cmdline: string_new(), search_op: None, search_count: 0, keys: normal_keys_new(), anchor: pos(0, 0), message: string_new(), quit: false, ask: LangAsk.Nothing, watched: vec_new<Watched>(), picker: picker_new(), qf: quickfix_new() }

# ============================================================================
# Characters and columns
# ============================================================================

enum CharClass
    Blank       # a space, a tab, or the end of a line
    Word        # letters, digits, `_` and anything non-ASCII
    Punct       # other ASCII

fn class_of(s: [u8], col: i64) -> CharClass
    if col >= s.len
        return CharClass.Blank
    let c = s[col]
    if c == ' ' or c == '\t'
        return CharClass.Blank
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c >= 0x80
        return CharClass.Word
    CharClass.Punct

# How an operator reaches a motion's target (Vim's exclusive, inclusive
# and linewise motions).
enum Reach
    Exclusive       # up to the target, not including it (w b h l 0)
    Inclusive       # the target's code point too (e $)
    Linewise        # whole lines, the cursor's to the target's (j k gg G dd)

# Where a motion takes the cursor, and how an operator reaches it.
struct Target
    at: Pos
    reach: Reach

# Where a search landed, and whether it wrapped around the text to get there.
struct Hit
    at: Pos
    wrapped: bool

# One step of w: keep going from a position, or end there.
enum Stride
    On(Pos)
    Done(Pos)

# The start of the code point holding byte `col`, kept on the last one: the
# Normal-mode column for `col`. 0 on an empty line.
fn normal_col(s: [u8], col: i64) -> i64
    if s.len == 0
        return 0
    var c: i64 = 0
    var n = utf8_next(s, 0)
    while n <= col and n < s.len
        c = n
        n = utf8_next(s, c)
    c

# The number of code points before byte `col`.
fn units_before(s: [u8], col: i64) -> i64
    var c: i64 = 0
    var n: i64 = 0
    while c < col and c < s.len
        c = utf8_next(s, c)
        n += 1
    n

# The byte column of code point `k`, or the line's end.
fn col_of_unit(s: [u8], k: i64) -> i64
    var c: i64 = 0
    for i in 0..k
        if c >= s.len
            return c
        c = utf8_next(s, c)
    c

fn first_non_blank(s: [u8]) -> i64
    var c: i64 = 0
    while c < s.len and (s[c] == ' ' or s[c] == '\t')
        c += 1
    normal_col(s, c)

# The length of the line terminator ending `text`: 2 for CRLF, 1 for LF or
# CR, 0 for none.
fn trailing_term_len(text: [u8]) -> i64
    let n = text.len
    if n >= 2 and text[n - 2] == '\r' and text[n - 1] == '\n'
        return 2
    if n >= 1 and (text[n - 1] == '\n' or text[n - 1] == '\r')
        return 1
    0

# The Key as an ASCII byte, or 0 for any other key.
fn ascii_of(key: Key) -> u8
    match key
        Key.Char(c) => if c < 0x80 then c as u8 else 0
        _ => 0

# ============================================================================
# The screen's view of the editor
# ============================================================================

impl LineSource for Editor
    fn line_count(self: @Editor) -> i64
        self.shown()

    fn line(self: @Editor, l: i64) -> [u8]
        self.buf().line(l)

impl Editor
    # The lines the editor shows: all of the buffer's but the empty one
    # after a final newline.
    #
    # A loaded file's trailing newline and a line an Insert-mode Enter (or
    # o) just split off leave the Buffer in the same shape: the last line
    # is empty and has no terminator (core/buffer.ritz's invariant: only
    # the last line lacks one). The not-found path's buffer_new() starts
    # this way too, so typing a new file's first line and pressing Enter
    # hits it at once. Buffer can't tell the two apart; Editor can, while
    # the session that just split the line is still open: Insert mode,
    # cursor on that exact line. Hiding the line then would clamp the
    # screen's cursor back a row (#4906). Once Escape ends the session (or
    # a key types a byte onto the line, which flips has_final_newline()
    # off on its own) the ambiguity is gone and this no longer applies, so
    # a later edit that happens to leave the cursor on the same line
    # number (dd, say) is never affected by it.
    pub fn shown(self: @Editor) -> i64
        let n = self.buf().line_count()
        let splitting = self.mode == Mode.Insert and self.cursor.line == n - 1
        if self.buf().has_final_newline() and not splitting then n - 1 else n

    pub fn last(self: @Editor) -> i64
        self.shown() - 1

    pub fn status(self: @Editor) -> Status
        Status { name: self.path(), dirty: self.buf().is_dirty(), mode: self.mode, lang: "" }

    # The current window's buffer.
    pub fn buf(self: @Editor) -> @Buffer
        @self.bufs[self.at].buf

    pub fn buf_mut(self: @&Editor) -> @&Buffer
        @&self.bufs[self.at].buf

    # Its file name; empty for a new buffer.
    pub fn path(self: @Editor) -> StrView
        self.bufs[self.at].path.as_view()

    # Its number (Vim's: :b N, :ls).
    pub fn buffer_number(self: @Editor) -> i64
        self.bufs[self.at].number

    # A count that goes up with every change to the current buffer's text
    # and never otherwise (Buffer.revision): with buffer_number, what a
    # renderer's caches are for.
    pub fn text_revision(self: @Editor) -> i64
        self.buf().revision()

    # The command line as typed, prompt first; empty outside CommandLine mode.
    pub fn command_line(self: @Editor) -> StrView
        self.cmdline.as_view()

    # say, place, place_line, insert_key, close_command_line, file_info and
    # say_about are pub only because the generic handle_key<F> family calls
    # them: an instantiation is compiled into the caller's module, and
    # ritz1_selfhosted gives a private method internal linkage.
    pub fn say(self: @&Editor, text: StrView)
        self.message.clear()
        self.message.push_str(text)

    # ------------------------------------------------------------------
    # Cursor placement
    # ------------------------------------------------------------------

    # Line l moved onto the shown lines.
    fn clamp_line(self: @Editor, l: i64) -> i64
        if l > self.last()
            return self.last()
        if l < 0 then 0 else l

    # The cursor at `p`, on a shown line and a Normal-mode column; `want`
    # follows it.
    pub fn place(self: @&Editor, p: Pos)
        let l = self.clamp_line(p.line)
        let s = self.buf().line(l)
        let col = if p.col > s.len then s.len else p.col
        self.cursor = pos(l, normal_col(s, col))
        self.want = units_before(s, self.cursor.col)

    # Line l (clamped), at its first non-blank.
    pub fn place_line(self: @&Editor, l: i64)
        let line = self.clamp_line(l)
        self.place(pos(line, first_non_blank(self.buf().line(line))))

    # One code point on within the shown text, crossing line ends: the end
    # of a line is a position of its own. None at the end of the last line.
    fn step(self: @Editor, p: Pos) -> Option<Pos>
        let s = self.buf().line(p.line)
        if p.col < s.len
            return Some(pos(p.line, utf8_next(s, p.col)))
        if p.line < self.last()
            return Some(pos(p.line + 1, 0))
        None

    # One code point back, onto the end of the line above from a line start.
    fn back(self: @Editor, p: Pos) -> Option<Pos>
        if p.col > 0
            return Some(pos(p.line, utf8_prev(self.buf().line(p.line), p.col)))
        if p.line > 0
            return Some(pos(p.line - 1, self.buf().line_len(p.line - 1)))
        None

    fn class_at(self: @Editor, p: Pos) -> CharClass
        class_of(self.buf().line(p.line), p.col)

    # ------------------------------------------------------------------
    # Motions: where each takes the cursor, without moving it
    # ------------------------------------------------------------------

    # True when the step from p to n left p's line or landed on its end.
    fn breaks(self: @Editor, p: Pos, n: Pos) -> bool
        n.line != p.line or n.col >= self.buf().line_len(n.line)

    # One step of w from p. With `stop_at_eol`, a step that leaves the line
    # or lands on its end ends the motion there.
    fn w_step(self: @Editor, p: Pos, stop_at_eol: bool) -> Stride
        match self.step(p)
            Some(n) => if stop_at_eol and self.breaks(p, n) then Stride.Done(n) else Stride.On(n)
            None => Stride.Done(p)

    # w, `count` times (Vim's fwd_word). With `eol` (an operator waits for
    # the motion) the last word stops at its line's end rather than crossing
    # to the next line's first word: `dw` on a line's last word keeps the
    # line break. An empty line is a word; past the last word, the end of
    # the text.
    fn word_forward_from(self: @Editor, from: Pos, count: i64, eol: bool) -> Pos
        var p = from
        for k in 0..count
            let stop_at_eol = eol and k == count - 1
            let cls = self.class_at(p)
            # Off the code point under the cursor: on the last line, the
            # line's end is as far as w goes.
            match self.w_step(p, stop_at_eol or p.line >= self.last())
                Stride.On(n) => p = n
                Stride.Done(n) => return n
            # To the end of its word, then over blanks to the next word.
            if cls != CharClass.Blank
                while self.class_at(p) == cls
                    match self.w_step(p, stop_at_eol)
                        Stride.On(n) => p = n
                        Stride.Done(n) => return n
            while self.class_at(p) == CharClass.Blank
                if p.col == 0 and self.buf().line_len(p.line) == 0
                    break
                match self.w_step(p, stop_at_eol)
                    Stride.On(n) => p = n
                    Stride.Done(n) => return n
        p

    # b, once: the start of this word, or of the one before. An empty line
    # is a word.
    fn word_backward_from(self: @Editor, from: Pos) -> Pos
        var p: Pos = match self.back(from)
            Some(n) => n
            None => return from
        while self.class_at(p) == CharClass.Blank
            if p.line != from.line and self.buf().line_len(p.line) == 0
                break
            match self.back(p)
                Some(n) => p = n
                None => break
        let cls = self.class_at(p)
        if cls != CharClass.Blank
            while p.col > 0
                let q = pos(p.line, utf8_prev(self.buf().line(p.line), p.col))
                if self.class_at(q) != cls
                    break
                p = q
        p

    # Past the run of `cls` code points at p. A word or punctuation run
    # ends on its own line, at the latest at the line's end.
    fn skip_class(self: @Editor, from: Pos, cls: CharClass) -> Pos
        var p = from
        while self.class_at(p) == cls
            match self.step(p)
                Some(n) => p = n
                None => return p
        p

    # e, `count` times (Vim's end_word): the end of this word, or of the
    # next; empty lines don't stop it. With `change` (cw on a word, which
    # changes to the word's end): a cursor on a word's last code point is at
    # its end already, and an empty line ends it. Past the last word, the
    # end of the text.
    fn word_end_from(self: @Editor, from: Pos, count: i64, change: bool) -> Pos
        var p = from
        for k in 0..count
            let cls = self.class_at(p)
            match self.step(p)
                Some(n) => p = n
                None => return p
            if cls != CharClass.Blank and self.class_at(p) == cls
                p = self.skip_class(p, cls)
            else if cls == CharClass.Blank or not (change and k == 0)
                var empty_line = false
                while self.class_at(p) == CharClass.Blank and not empty_line
                    if change and p.col == 0 and self.buf().line_len(p.line) == 0
                        empty_line = true
                    else
                        match self.step(p)
                            Some(n) => p = n
                            None => return p
                if empty_line
                    continue
                p = self.skip_class(p, self.class_at(p))
            p = self.back(p).unwrap_or(p)
        p

    # Line l (clamped) at the column `want` names: where j and k go.
    fn vertical(self: @Editor, l: i64) -> Pos
        let line = self.clamp_line(l)
        let s = self.buf().line(line)
        pos(line, normal_col(s, col_of_unit(s, self.want)))

    # Where motion `m` takes the cursor, with `count` as typed (0: none),
    # and how an operator reaches it. `op`: an operator waits for the
    # motion, which lets l reach a line's end and stops w there. None where
    # a line motion can't go at all (k on the first line): no move, and an
    # operator does nothing. h and l that can't move stay put, so an
    # operator gets an empty range (ch at a line's start still inserts).
    # A search motion says why when it finds nothing, and * and # set the
    # last pattern.
    fn target(self: @&Editor, m: Motion, count: i64, op: bool) -> Option<Target>
        let n = if count > 0 then count else 1
        let c = self.cursor
        let s = self.buf().line(c.line)
        match m
            Motion.Left =>
                var col = c.col
                var k: i64 = 0
                while k < n and col > 0
                    col = utf8_prev(s, col)
                    k += 1
                Some(Target { at: pos(c.line, col), reach: Reach.Exclusive })
            Motion.Right =>
                # Normal mode stops on the last code point; an operator
                # reaches past it, to the line's end.
                var col = c.col
                var k: i64 = 0
                while k < n and col < s.len
                    let next = utf8_next(s, col)
                    if not op and next >= s.len
                        break
                    col = next
                    k += 1
                Some(Target { at: pos(c.line, col), reach: Reach.Exclusive })
            Motion.Up =>
                if c.line == 0 then None else Some(Target { at: self.vertical(c.line - n), reach: Reach.Linewise })
            Motion.Down =>
                if c.line >= self.last() then None else Some(Target { at: self.vertical(c.line + n), reach: Reach.Linewise })
            Motion.WordForward => Some(Target { at: self.word_forward_from(c, n, op), reach: Reach.Exclusive })
            Motion.WordBackward =>
                var p = c
                var k: i64 = 0
                while k < n
                    let q = self.word_backward_from(p)
                    if not pos_before(q, p)
                        break
                    p = q
                    k += 1
                Some(Target { at: p, reach: Reach.Exclusive })
            Motion.WordEnd => Some(Target { at: self.word_end_from(c, n, false), reach: Reach.Inclusive })
            Motion.LineStart => Some(Target { at: pos(c.line, 0), reach: Reach.Exclusive })
            Motion.LineEnd =>
                let l = c.line + n - 1
                if l > self.last() then None else Some(Target { at: pos(l, self.buf().line_len(l)), reach: Reach.Inclusive })
            Motion.FirstLine => Some(self.line_target(if count > 0 then count - 1 else 0))
            Motion.LastLine => Some(self.line_target(if count > 0 then count - 1 else self.last()))
            Motion.Lines =>
                if n > 1 and c.line >= self.last() then None else Some(self.line_target(c.line + n - 1))
            Motion.SearchNext => self.search_target(c, self.forward, n)
            Motion.SearchPrev => self.search_target(c, not self.forward, n)
            Motion.StarWord => self.word_search(true, n)
            Motion.HashWord => self.word_search(false, n)

    # Line l (clamped), at its first non-blank, reached linewise.
    fn line_target(self: @Editor, l: i64) -> Target
        let line = self.clamp_line(l)
        Target { at: pos(line, first_non_blank(self.buf().line(line))), reach: Reach.Linewise }

    # A motion without an operator: the cursor goes to its target. j and k
    # keep the column they aim for. In Visual mode $ goes onto the line's
    # end, so the selection takes its break.
    fn move_by(self: @&Editor, m: Motion, count: i64)
        match self.target(m, count, false)
            Some(t) =>
                if m == Motion.Up or m == Motion.Down
                    self.cursor = t.at
                else if m == Motion.LineEnd and self.selecting()
                    self.cursor = t.at
                    self.want = units_before(self.buf().line(t.at.line), t.at.col)
                else
                    self.place(t.at)
            None => pass

    # The lines a page turns over: Vim keeps two of the old page in view.
    fn page_step(self: @Editor) -> i64
        let page = self.page()
        if page > 3 then page - 2 else 1

    # Ctrl-F: the page down; the cursor on its top line.
    fn page_down(self: @&Editor)
        var t = self.top + self.page_step()
        if t > self.last()
            t = self.last()
        self.top = t
        self.place_line(t)

    # Ctrl-B: the page up; the cursor on its bottom line.
    fn page_up(self: @&Editor)
        var t = self.top - self.page_step()
        if t < 0
            t = 0
        self.top = t
        self.place_line(t + self.page() - 1)

    # ------------------------------------------------------------------
    # Insert mode
    # ------------------------------------------------------------------

    # Into Insert mode at `at`; the session's edits are one undo step.
    fn start_insert(self: @&Editor, at: Pos)
        self.buf_mut().begin_group()
        self.enter_insert(at)

    # Into Insert mode at `at`, in the undo step already open (c's).
    fn enter_insert(self: @&Editor, at: Pos)
        self.cursor = at
        self.mode = Mode.Insert

    pub fn insert_key(self: @&Editor, key: Key)
        match key
            Key.Escape =>
                self.buf_mut().end_group()
                self.mode = Mode.Normal
                var col = self.cursor.col
                if col > 0
                    col = utf8_prev(self.buf().line(self.cursor.line), col)
                self.place(pos(self.cursor.line, col))
            Key.Backspace =>
                if self.cursor.col > 0
                    let from = pos(self.cursor.line, utf8_prev(self.buf().line(self.cursor.line), self.cursor.col))
                    self.cursor = self.buf_mut().delete(from, self.cursor)
                else if self.cursor.line > 0
                    self.cursor = self.buf_mut().join_lines(self.cursor.line - 1)
            Key.Enter => self.cursor = self.buf_mut().split_line(self.cursor)
            Key.Tab => self.cursor = self.buf_mut().insert(self.cursor, span_from_strview("\t"))
            Key.Char(c) =>
                let bytes = utf8_encode(c)
                self.cursor = self.buf_mut().insert(self.cursor, span_from_vec<u8>(@bytes))
            _ => pass

    # ------------------------------------------------------------------
    # Edits and the register
    # ------------------------------------------------------------------

    fn set_register(self: @&Editor, text: [u8], lines: bool)
        self.reg.clear()
        self.reg.push_span(text)
        self.reg_lines = lines

    # Lines a..=b as the register holds them: their bytes and terminators,
    # the last line's own or, for the last line of the text, which has
    # none, the one above's or LF.
    fn yank_lines(self: @&Editor, a: i64, b: i64)
        var text = self.buf().text(pos(a, 0), pos(b, self.buf().line_len(b)))
        var t = self.buf().line_term(b)
        if t == Term.NoEol
            t = if b > 0 then self.buf().line_term(b - 1) else Term.Lf
        text.push_view(term_text(t))
        self.set_register(span_from_vec<u8>(@text), true)

    # Delete lines a..=b, terminators and all, into the register; the
    # cursor on the line that takes their place.
    fn delete_lines(self: @&Editor, a: i64, b: i64)
        self.yank_lines(a, b)
        if b + 1 < self.buf().line_count()
            self.buf_mut().delete(pos(a, 0), pos(b + 1, 0))
        else if a > 0
            # Through the last line: take the terminator before them.
            self.buf_mut().delete(pos(a - 1, self.buf().line_len(a - 1)), pos(b, self.buf().line_len(b)))
        else
            self.buf_mut().delete(pos(0, 0), pos(b, self.buf().line_len(b)))
        self.place_line(a)

    # True when only blanks come before p on its line (Vim's inindent).
    fn in_indent(self: @Editor, p: Pos) -> bool
        let s = self.buf().line(p.line)
        for i in 0..p.col
            if s[i] != ' ' and s[i] != '\t'
                return false
        true

    # True when only blanks come from p to its line's end.
    fn blank_after(self: @Editor, p: Pos) -> bool
        let s = self.buf().line(p.line)
        for i in p.col..s.len
            if s[i] != ' ' and s[i] != '\t'
                return false
        true

    # Where operator `op` reaches with motion `m`: the motion's target,
    # except that cw on a word changes to the word's end (Vim's cw is ce).
    fn operator_target(self: @&Editor, op: Operator, m: Motion, count: i64) -> Option<Target>
        let c = self.cursor
        if op == Operator.Change and m == Motion.WordForward and self.class_at(c) != CharClass.Blank
            let n = if count > 0 then count else 1
            return Some(Target { at: self.word_end_from(c, n, true), reach: Reach.Inclusive })
        self.target(m, count, true)

    # d, c or y over motion `m`. The text goes to the register, its lines
    # whole for a linewise motion. Vim's two adjustments to a charwise
    # range apply: an exclusive one that ends at a later line's start ends
    # at the line before's end instead (and is linewise when it starts in
    # the indent), and a d that spans lines with only blanks before its
    # start and after its end deletes the lines whole.
    fn operate(self: @&Editor, op: Operator, m: Motion, count: i64)
        let t: Target = match self.operator_target(op, m, count)
            Some(found) => found
            None => return
        var a = self.cursor
        var b = t.at
        if pos_before(b, a)
            a = t.at
            b = self.cursor
        if t.reach == Reach.Linewise
            self.on_lines(op, a.line, b.line)
            return
        if t.reach == Reach.Inclusive and b.col < self.buf().line_len(b.line)
            b = pos(b.line, utf8_next(self.buf().line(b.line), b.col))
        if t.reach == Reach.Exclusive and b.col == 0 and b.line > a.line
            if self.in_indent(a)
                self.on_lines(op, a.line, b.line - 1)
                return
            b = pos(b.line - 1, self.buf().line_len(b.line - 1))
        if op == Operator.Delete and b.line > a.line and self.in_indent(a) and self.blank_after(b)
            self.on_lines(op, a.line, b.line)
            return
        self.on_chars(op, a, b)

    # An operator over the text from a to b (a first, b excluded).
    fn on_chars(self: @&Editor, op: Operator, a: Pos, b: Pos)
        match op
            Operator.Yank =>
                self.take(a, b, false)
                self.place(a)
            Operator.Delete =>
                self.take(a, b, true)
                self.place(a)
            Operator.Change =>
                self.buf_mut().begin_group()
                self.take(a, b, true)
                self.enter_insert(a)

    # The text from a to b into the register, and out of the buffer when
    # `cut`. An empty range leaves the register as it was.
    fn take(self: @&Editor, a: Pos, b: Pos, cut: bool)
        if not pos_before(a, b)
            return
        let text = self.buf().text(a, b)
        self.set_register(span_from_vec<u8>(@text), false)
        if cut
            self.buf_mut().delete(a, b)

    # An operator over lines a..=b. c leaves one empty line to type on.
    fn on_lines(self: @&Editor, op: Operator, a: i64, b: i64)
        match op
            Operator.Delete => self.delete_lines(a, b)
            Operator.Yank =>
                self.yank_lines(a, b)
                if a != self.cursor.line
                    self.cursor = self.vertical(a)
            Operator.Change =>
                self.buf_mut().begin_group()
                self.yank_lines(a, b)
                self.buf_mut().delete(pos(a, 0), pos(b, self.buf().line_len(b)))
                self.enter_insert(pos(a, 0))

    # p (after) and P (before): put the register `times` over by the
    # cursor, its lines by the cursor's line. One undo step.
    fn put(self: @&Editor, after: bool, times: i64)
        let repeated: Vec<u8> = match self.repeated_register(times)
            Some(r) => r
            None => return
        let l = self.cursor.line
        let text = span_from_vec<u8>(@repeated)
        if self.reg_lines
            if not after
                self.buf_mut().insert(pos(l, 0), text)
                self.place_line(l)
            else if l + 1 < self.buf().line_count()
                self.buf_mut().insert(pos(l + 1, 0), text)
                self.place_line(l + 1)
            else
                # After the last line, which has no terminator: the
                # register's terminator goes in front instead.
                let body = text.len - trailing_term_len(text)
                var moved: Vec<u8> = vec_new<u8>()
                moved.push_span(text[body..text.len])
                moved.push_span(text[0..body])
                self.buf_mut().insert(pos(l, self.buf().line_len(l)), span_from_vec<u8>(@moved))
                self.place_line(l + 1)
            return
        var at = self.cursor
        if after
            at = pos(l, utf8_next(self.buf().line(l), self.cursor.col))
        let end = self.buf_mut().insert(at, text)
        self.place(self.buf().prev_char(end))

    # p (after) or P: by the cursor, or over the selection in Visual mode,
    # where P keeps the register.
    fn put_key(self: @&Editor, after: bool, times: i64)
        if self.selecting()
            self.put_over(not after, times)
        else
            self.put(after, times)

    # The register `times` over, for a put. None when it is empty, or when
    # that is more than MAX_PUT bytes, which says so.
    fn repeated_register(self: @&Editor, times: i64) -> Option<Vec<u8>>
        if self.reg.len() == 0
            return None
        if times > MAX_PUT / self.reg.len()
            self.say(MSG_TOO_LONG)
            return None
        var out: Vec<u8> = vec_with_cap<u8>(self.reg.len() * times)
        for k in 0..times
            out.push_span(span_from_vec<u8>(@self.reg))
        Some(out)

    # u, once; false when there was nothing to undo.
    fn undo(self: @&Editor) -> bool
        match self.buf_mut().undo()
            Some(p) =>
                self.place(p)
                true
            None =>
                self.say("Already at oldest change")
                false

    # Ctrl-R, once; false when there was nothing to redo.
    fn redo(self: @&Editor) -> bool
        match self.buf_mut().redo()
            Some(p) =>
                self.place(p)
                true
            None =>
                self.say("Already at newest change")
                false

    # ------------------------------------------------------------------
    # Visual mode
    # ------------------------------------------------------------------

    # True in Visual or Visual Line mode.
    fn selecting(self: @Editor) -> bool
        self.mode == Mode.Visual or self.mode == Mode.VisualLine

    fn shape(self: @Editor) -> Shape
        if self.mode == Mode.VisualLine then Shape.Lines else Shape.Chars

    # The selection's ends in order; linewise, its lines whole.
    fn extent(self: @Editor) -> Extent
        var from = self.anchor
        var to = self.cursor
        if pos_before(to, from)
            from = self.cursor
            to = self.anchor
        if self.mode == Mode.VisualLine
            return Extent { from: pos(from.line, 0), to: pos(to.line, self.buf().line_len(to.line)) }
        Extent { from: from, to: to }

    # What the screen draws as selected; None outside Visual mode.
    pub fn selection(self: @Editor) -> Option<Selection>
        if not self.selecting()
            return None
        let e = self.extent()
        Some(Selection { from_line: e.from.line, from_byte: e.from.col, to_line: e.to.line, to_byte: e.to.col, lines: self.mode == Mode.VisualLine })

    # v or V: start a selection of `shape` at the cursor; in one, switch
    # to `shape`, or leave when it is that already.
    fn select(self: @&Editor, shape: Shape)
        if not self.selecting()
            self.anchor = self.cursor
        else if self.shape() == shape
            self.leave_visual()
            return
        self.mode = if shape == Shape.Lines then Mode.VisualLine else Mode.Visual

    # Back to Normal mode, keeping the selection for gv; the cursor back
    # onto a code point.
    fn leave_visual(self: @&Editor)
        self.bufs[self.at].last_selection = Some(Selected { anchor: self.anchor, cursor: self.cursor, shape: self.shape() })
        self.mode = Mode.Normal
        self.place(self.cursor)

    # gv: the last selection again, its ends moved onto the text as it is
    # now. In Visual mode the current one becomes the last.
    fn reselect(self: @&Editor)
        let last: Selected = match self.bufs[self.at].last_selection
            Some(s) => s
            None => return
        if self.selecting()
            self.bufs[self.at].last_selection = Some(Selected { anchor: self.anchor, cursor: self.cursor, shape: self.shape() })
        self.place(last.anchor)
        self.anchor = self.cursor
        self.place(last.cursor)
        self.mode = if last.shape == Shape.Lines then Mode.VisualLine else Mode.Visual

    # o: the cursor to the selection's other end.
    fn swap_ends(self: @&Editor)
        let a = self.anchor
        self.anchor = self.cursor
        self.cursor = a
        self.want = units_before(self.buf().line(a.line), a.col)

    # Just past a charwise selection's last end: after its code point, or
    # past its break onto the next line's start. The last shown line's
    # break is the file's final newline, which no selection takes.
    fn past(self: @Editor, to: Pos) -> Pos
        if to.col < self.buf().line_len(to.line)
            return pos(to.line, utf8_next(self.buf().line(to.line), to.col))
        if to.line < self.last()
            return pos(to.line + 1, 0)
        to

    # d, c or y on the selection, then Normal mode (Insert for c). The
    # cursor goes to the selection's start, as Vim's does: for a linewise
    # y the start of its first line.
    fn operate_selection(self: @&Editor, op: Operator)
        let e = self.extent()
        let lines = self.mode == Mode.VisualLine
        self.leave_visual()
        if not lines
            self.on_chars(op, e.from, self.past(e.to))
            return
        self.on_lines(op, e.from.line, e.to.line)
        if op == Operator.Yank
            self.place(e.from)

    # p and P on a selection: the register, `times` over, in its place, in
    # one undo step. p puts the replaced text in the register; P keeps it.
    # Lines over a charwise selection go on lines of their own; a charwise
    # register over lines becomes their text.
    fn put_over(self: @&Editor, keep: bool, times: i64)
        let e = self.extent()
        let lines = self.mode == Mode.VisualLine
        self.leave_visual()
        let repeated: Vec<u8> = match self.repeated_register(times)
            Some(r) => r
            None => return
        let text = span_from_vec<u8>(@repeated)
        let reg_lines = self.reg_lines
        if lines
            if not keep
                self.yank_lines(e.from.line, e.to.line)
            # The selection's last terminator stays: the put lines' last goes.
            let body = if reg_lines then text[0..text.len - trailing_term_len(text)] else text
            self.buf_mut().replace(e.from, e.to, body)
            self.place_line(e.from.line)
            return
        let b = self.past(e.to)
        if not keep
            self.take(e.from, b, false)
        if reg_lines
            # A line break in front: the text is lines after the start's.
            var broken: Vec<u8> = vec_with_cap<u8>(text.len + 2)
            broken.push_span(text[text.len - trailing_term_len(text)..text.len])
            broken.push_span(text)
            self.buf_mut().replace(e.from, b, span_from_vec<u8>(@broken))
            self.place_line(e.from.line + 1)
            return
        let end = self.buf_mut().replace(e.from, b, text)
        self.place(self.buf().prev_char(end))

    # ------------------------------------------------------------------
    # Search
    # ------------------------------------------------------------------

    # The match of `re` nearest p the way `forward` goes, wrapping around
    # the text once: a match at p itself only when it is the only one.
    fn next_match(self: @Editor, re: @Regex, p: Pos, forward: bool) -> Option<Hit>
        let n = self.shown()
        for k in 0..=n
            let l = if forward then (p.line + k) % n else (p.line - k + n) % n
            let s = self.buf().line(l)
            var hit: Option<RegexMatch> = None
            if forward
                hit = re.find_from(s, if k == 0 then p.col + 1 else 0)
            else
                hit = re.find_before(s, if k == 0 then p.col else s.len + 1)
            match hit
                Some(m) =>
                    # Back on p's line after the wrap, only p's own side
                    # of it is left to search.
                    let beyond = if forward then m.start > p.col else m.start < p.col
                    if k < n or not beyond
                        let wrapped = if forward then p.line + k >= n else p.line - k < 0
                        return Some(Hit { at: pos(l, m.start), wrapped: wrapped })
                None => pass
        None

    # The `count`th match of the last pattern from `from`, the way
    # `forward` goes. None, saying why, when there is none; a search that
    # wrapped around the text says so.
    fn search_target(self: @&Editor, from: Pos, forward: bool, count: i64) -> Option<Target>
        if self.pattern.len() == 0
            self.say(MSG_NO_PATTERN)
            return None
        let re: Regex = match regex_compile(self.pattern.as_view(), RegexSyntax.Vim)
            Ok(r) => r
            Err(e) =>
                self.say(e.message())
                return None
        var p = from
        var wrapped = false
        for k in 0..count
            match self.next_match(@re, p, forward)
                Some(h) =>
                    p = h.at
                    wrapped = wrapped or h.wrapped
                None =>
                    var msg = string_from("Pattern not found: ")
                    msg.push_str(self.pattern.as_view())
                    self.say(msg.as_view())
                    return None
        if wrapped
            self.say(if forward then "search hit BOTTOM, continuing at TOP" else "search hit TOP, continuing at BOTTOM")
        Some(Target { at: p, reach: Reach.Exclusive })

    # * (forward) and #: the word under the cursor, or else the first after
    # it on the line, searched for whole (\<word\>) from the word's start.
    # It becomes the last pattern, and its way the last search's.
    fn word_search(self: @&Editor, forward: bool, count: i64) -> Option<Target>
        let l = self.cursor.line
        let s: [u8] = self.buf().line(l)
        var a = self.cursor.col
        while a < s.len and class_of(s, a) != CharClass.Word
            a += 1
        if a >= s.len
            self.say(MSG_NO_STRING)
            return None
        while a > 0 and class_of(s, a - 1) == CharClass.Word
            a -= 1
        var b = a
        while b < s.len and class_of(s, b) == CharClass.Word
            b += 1
        let word = s[a..b]
        var pat: Vec<u8> = vec_new<u8>()
        pat.push_view("\\<")
        pat.push_span(word)
        pat.push_view("\\>")
        self.pattern = pat
        self.forward = forward
        self.search_target(pos(l, a), forward, count)

    # ------------------------------------------------------------------
    # The command line
    # ------------------------------------------------------------------

    fn open_command_line(self: @&Editor, prompt: u8)
        self.cmdline.clear()
        self.cmdline.push(prompt)
        self.mode = Mode.CommandLine

    pub fn close_command_line(self: @&Editor)
        self.cmdline.clear()
        self.mode = Mode.Normal

    # / or ?: the command line, prompted with the way to search; the
    # operator and the count wait there for the pattern (each / or ? sets
    # them, so an Escape leaves nothing behind).
    fn open_search(self: @&Editor, op: Option<Operator>, forward: bool, count: i64)
        self.open_command_line(if forward then '/' else '?')
        self.search_op = op
        self.search_count = count

    # The editor's size message for `path`: `"path" 2L, 8B`.
    pub fn file_info(self: @Editor, path: StrView) -> String
        var msg = string_from("\"")
        msg.push_str(path)
        msg.push_str("\" ")
        msg.push_i64(if self.buf().byte_len() == 0 then 0 else self.shown())
        msg.push_str("L, ")
        msg.push_i64(self.buf().byte_len())
        msg.push('B')
        msg

    pub fn say_about(self: @&Editor, path: StrView, what: StrView)
        var msg = string_from("\"")
        msg.push_str(path)
        msg.push('"')
        msg.push_str(what)
        self.say(msg.as_view())

    # ------------------------------------------------------------------
    # The pickers. close_picker is pub for the reason say() gives.
    # ------------------------------------------------------------------

    # The picker as Picker mode shows it (empty in the other modes).
    pub fn picker(self: @Editor) -> @Picker
        @self.picker

    # The first hit core.paint shows in `rows` rows (Picker.scroll).
    pub fn picker_top(self: @&Editor, rows: i64) -> i64
        self.picker.scroll(rows)

    # `:Files`: the picker over the workspace's files.
    pub fn open_file_picker(self: @&Editor, list: PathList)
        self.picker.open_files(list)
        self.mode = Mode.Picker

    # `:Buffers`: the picker over the buffer list, by number.
    pub fn open_buffer_picker(self: @&Editor)
        self.picker.open_buffers()
        for k in 0..self.bufs.len()
            self.picker.add_buffer(display_name(self.bufs[k].path.as_view()), self.bufs[k].number, self.bufs[k].buf.is_dirty())
        self.picker.ready()
        self.mode = Mode.Picker

    pub fn close_picker(self: @&Editor)
        self.picker.close()
        self.mode = Mode.Normal

    # `:copen`: the picker over the quickfix list, in its order, the
    # current entry selected.
    pub fn open_quickfix_picker(self: @&Editor)
        self.picker.open_quickfix(self.qf.truncated)
        for k in 0..self.qf.len()
            let row = self.qf.row(k)
            self.picker.add_entry(row.as_view(), k)
        self.picker.ready()
        self.picker.select_candidate(self.qf.current)
        self.mode = Mode.Picker

    # The quickfix list (core/quickfix.ritz), for its tests and :copen's.
    pub fn quickfix(self: @Editor) -> @Quickfix
        @self.qf

# ============================================================================
# Buffers and windows
# ============================================================================

# The lines a window that isn't current shows of `b`: all but the empty one
# after a final newline (the current window's are shown(), which knows
# about the line an Insert-mode Enter just split off).
fn shown_in(b: @Buffer) -> i64
    let n = b.line_count()
    if b.has_final_newline() then n - 1 else n

# p moved onto the lines a window shows of `b`, at a Normal-mode column.
fn settle(b: @Buffer, p: Pos) -> Pos
    var last = shown_in(b) - 1
    if last < 0
        last = 0
    let l = if p.line > last then last else if p.line < 0 then 0 else p.line
    let s = b.line(l)
    pos(l, normal_col(s, if p.col > s.len then s.len else p.col))

# Byte offset `o` moved through `b`'s changes since forget_changes().
fn shifted(b: @Buffer, o: i64) -> i64
    let changes = b.changes()
    var at = o
    for i in 0..changes.len
        at = changes[i].shift(at)
    at

# A buffer's name as :ls and E162 show it.
fn display_name(path: StrView) -> StrView
    if path.is_empty() then "[No Name]" else path

# True when `o` is `n`.
fn holds(o: Option<i64>, n: i64) -> bool
    match o
        Some(v) => v == n
        None => false

# True when `text` is digits only, and some.
fn all_digits(text: StrView) -> bool
    if text.is_empty()
        return false
    for i in 0..text.len()
        let c = text.get(i)
        if c < '0' or c > '9'
            return false
    true

impl Editor
    # ------------------------------------------------------------------
    # The buffer list. Methods the generic command functions call are pub
    # for the reason say() gives.
    # ------------------------------------------------------------------

    pub fn buffer_count(self: @Editor) -> i64
        self.bufs.len()

    # Buffer k of the list (by number): its number, text and file name.
    pub fn buffer_number_at(self: @Editor, k: i64) -> i64
        self.bufs[k].number

    pub fn buffer_at(self: @Editor, k: i64) -> @Buffer
        @self.bufs[k].buf

    pub fn buffer_path_at(self: @Editor, k: i64) -> StrView
        self.bufs[k].path.as_view()

    # Where buffer `number` is in the list, if it is.
    pub fn find_buffer(self: @Editor, number: i64) -> Option<i64>
        for k in 0..self.bufs.len()
            if self.bufs[k].number == number
                return Some(k)
        None

    # Where buffer `number` is in the list, a buffer a window shows: always
    # listed (delete_buffer moves its windows off it first).
    fn slot_of(self: @Editor, number: i64) -> i64
        self.find_buffer(number).unwrap_or(self.at)

    # Where the buffer of file `path` is in the list, if it has one.
    pub fn find_path(self: @Editor, path: StrView) -> Option<i64>
        for k in 0..self.bufs.len()
            if self.bufs[k].path.as_view().eq(path)
                return Some(k)
        None

    # A new buffer for `path` at the end of the list; its number.
    pub fn add_buffer(self: @&Editor, path: StrView, buf: Buffer) -> i64
        let n = self.next_number
        self.next_number += 1
        self.bufs.push(listed(n, buf, string_from(path)))
        n

    # The current window shows buffer `number`, the cursor where a window
    # last left it; the buffer it showed becomes its alternate.
    pub fn show(self: @&Editor, number: i64)
        let k: i64 = match self.find_buffer(number)
            Some(found) => found
            None => return
        if k == self.at
            return
        self.bufs[self.at].cursor = self.cursor
        self.wins[self.cur].alt = Some(self.bufs[self.at].number)
        self.wins[self.cur].number = number
        self.at = k
        self.top = 0
        let back = self.bufs[k].cursor
        self.place(back)

    # The buffer number `arg` names for :b and :bd: the number typed
    # (listed or not), or the one buffer whose name it is or is part of.
    # None, said, when a name matches several (E93) or none (E94).
    pub fn number_named(self: @&Editor, arg: StrView) -> Option<i64>
        if all_digits(arg)
            return arg.parse_i64()
        var found: i64 = -1
        var matches: i64 = 0
        for k in 0..self.bufs.len()
            let name = self.bufs[k].path.as_view()
            if name.eq(arg)
                return Some(self.bufs[k].number)
            if name.contains(arg)
                found = k
                matches += 1
        if matches == 1
            return Some(self.bufs[found].number)
        var msg = string_from(if matches > 1 then "E93: More than one match for " else "E94: No matching buffer for ")
        msg.push_str(arg)
        self.say(msg.as_view())
        None

    # :b [N | name]: show that buffer (E86 for a number with none).
    pub fn go_to_buffer(self: @&Editor, arg: StrView)
        if arg.is_empty()
            return
        let n: i64 = match self.number_named(arg)
            Some(named) => named
            None => return
        if self.find_buffer(n).is_none()
            var msg = string_from("E86: Buffer ")
            msg.push_i64(n)
            msg.push_str(" does not exist")
            self.say(msg.as_view())
            return
        self.show(n)

    # :bn (forward) and :bp: the next or previous buffer in the list,
    # round past the ends.
    pub fn go_round_buffers(self: @&Editor, forward: bool)
        let n = self.bufs.len()
        let k = if forward then (self.at + 1) % n else (self.at + n - 1) % n
        self.show(self.bufs[k].number)

    # True when a window shows buffer `number`.
    fn shown_anywhere(self: @Editor, number: i64) -> bool
        for w in 0..self.wins.len()
            if self.wins[w].number == number
                return true
        false

    # :ls: a line per buffer in Vim's columns (number; `%` current or `#`
    # alternate; `a` shown or `h` hidden; `+` changed; the name in quotes;
    # its cursor line from column 40), as a message that waits for a key.
    pub fn list_buffers(self: @&Editor)
        var msg = string_new()
        for k in 0..self.bufs.len()
            if k > 0
                msg.push('\n')
            let number = self.bufs[k].number
            var line = string_new()
            if number < 100
                line.push(' ')
            if number < 10
                line.push(' ')
            line.push_i64(number)
            line.push(' ')
            line.push(if k == self.at then '%' else if holds(self.wins[self.cur].alt, number) then '#' else ' ')
            line.push(if self.shown_anywhere(number) then 'a' else 'h')
            line.push(' ')
            line.push(if self.bufs[k].buf.is_dirty() then '+' else ' ')
            line.push_str(" \"")
            line.push_str(display_name(self.bufs[k].path.as_view()))
            line.push('"')
            var width = units_before(span_from_strview(line.as_view()), line.len())
            line.push(' ')
            width += 1
            while width < 40
                line.push(' ')
                width += 1
            line.push_str("line ")
            var cursor = self.bufs[k].cursor
            if k == self.at
                cursor = self.cursor
            line.push_i64(cursor.line + 1)
            msg.push_str(line.as_view())
        self.say(msg.as_view())

    # The first buffer but the current one with pending edits, if any.
    fn changed_other(self: @Editor) -> Option<i64>
        for k in 0..self.bufs.len()
            if k != self.at and self.bufs[k].buf.is_dirty()
                return Some(k)
        None

    # The buffer the current window shows when buffer `number` goes: its
    # alternate, else the next in the list, else the one before, else a
    # new empty buffer.
    fn heir_of(self: @&Editor, number: i64) -> i64
        match self.wins[self.cur].alt
            Some(alt) =>
                if alt != number and self.find_buffer(alt).is_some()
                    return alt
            None => pass
        let k = self.slot_of(number)
        if k + 1 < self.bufs.len()
            return self.bufs[k + 1].number
        if k > 0
            return self.bufs[k - 1].number
        self.add_buffer("", buffer_new())

    # :bd[!] [N | name]: that buffer (this one when `arg` is empty) off the
    # list, refused with pending edits unless `force` (E89). Its other
    # windows close; the current window, if it shows it, shows heir_of's.
    pub fn delete_buffer(self: @&Editor, arg: StrView, force: bool)
        var number = self.buffer_number()
        if not arg.is_empty()
            number = match self.number_named(arg)
                Some(named) => named
                None => return
            if self.find_buffer(number).is_none()
                var msg = string_from(if force then "E516: No buffers were deleted: bd! " else "E516: No buffers were deleted: bd ")
                msg.push_str(arg)
                self.say(msg.as_view())
                return
        if self.bufs[self.slot_of(number)].buf.is_dirty() and not force
            var msg = string_from("E89: No write since last change for buffer ")
            msg.push_i64(number)
            msg.push_str(" (add ! to override)")
            self.say(msg.as_view())
            return
        let order = self.layout.order()
        for i in 0..order.len()
            let w = self.window_slot(order.get(i))
            if w != self.cur and self.wins[w].number == number
                let closed = self.close_window(w)
        if self.wins[self.cur].number == number
            let heir = self.heir_of(number)
            self.show(heir)
        for w in 0..self.wins.len()
            if holds(self.wins[w].alt, number)
                self.wins[w].alt = None
        # Off the list, the rest kept in order.
        let gone = self.slot_of(number)
        var after: Vec<Listed> = vec_new<Listed>()
        while self.bufs.len() > gone + 1
            after.push(self.bufs.pop())
        let dropped = self.bufs.pop()
        while after.len() > 0
            self.bufs.push(after.pop())
        self.at = self.slot_of(self.wins[self.cur].number)

    # ------------------------------------------------------------------
    # Windows
    # ------------------------------------------------------------------

    # A new terminal size: the windows share it out again.
    pub fn resize(self: @&Editor, size: Size)
        self.size = size

    # The area the windows share: all of the terminal but the command line.
    fn area(self: @Editor) -> Rect
        let rows = self.size.rows as i64 - 1
        rect(0, 0, if rows > 0 then rows else 0, self.size.cols as i64)

    # Each window's rectangle (its status line its last row), in order,
    # and the separators.
    pub fn tiling(self: @Editor) -> Tiling
        self.layout.tile(self.area())

    # The current window's text rows: what Ctrl-F and Ctrl-B turn over.
    pub fn page(self: @Editor) -> i64
        let t = self.tiling()
        match t.rect_of(self.wins[self.cur].id)
            Some(r) => if r.rows > 2 then r.rows - 1 else 1
            None => 1

    pub fn window_count(self: @Editor) -> i64
        self.wins.len()

    # The index of window `id`, if there is one.
    pub fn find_window(self: @Editor, id: i64) -> Option<i64>
        for w in 0..self.wins.len()
            if self.wins[w].id == id
                return Some(w)
        None

    # The index of window `id`, an id the layout gave: always a window.
    fn window_slot(self: @Editor, id: i64) -> i64
        self.find_window(id).unwrap_or(self.cur)

    # The index of the k-th window in order (top left first).
    pub fn window_at(self: @Editor, k: i64) -> i64
        let order = self.layout.order()
        self.window_slot(order.get(k))

    # Where the current window is in order.
    pub fn current_window(self: @Editor) -> i64
        let order = self.layout.order()
        let id = self.wins[self.cur].id
        for k in 0..order.len()
            if order.get(k) == id
                return k
        0

    # Window w (an index): its layout id, whether it is the current one,
    # its buffer, cursor, top line, and status line.
    pub fn window_id(self: @Editor, w: i64) -> i64
        self.wins[w].id

    pub fn is_current(self: @Editor, w: i64) -> bool
        w == self.cur

    pub fn window_number(self: @Editor, w: i64) -> i64
        self.wins[w].number

    pub fn window_buffer(self: @Editor, w: i64) -> @Buffer
        @self.bufs[self.slot_of(self.wins[w].number)].buf

    pub fn window_path(self: @Editor, w: i64) -> StrView
        self.bufs[self.slot_of(self.wins[w].number)].path.as_view()

    pub fn window_cursor(self: @Editor, w: i64) -> Pos
        if w == self.cur
            return self.cursor
        self.wins[w].cursor

    pub fn window_top(self: @Editor, w: i64) -> i64
        if w == self.cur then self.top else self.wins[w].top

    # The renderer scrolled window w to `top`.
    pub fn set_window_top(self: @&Editor, w: i64, top: i64)
        if w == self.cur
            self.top = top
        else
            self.wins[w].top = top

    # The lines window w shows.
    pub fn window_lines(self: @Editor, w: i64) -> i64
        if w == self.cur then self.shown() else shown_in(self.window_buffer(w))

    pub fn window_status(self: @Editor, w: i64) -> Status
        if w == self.cur
            return self.status()
        Status { name: self.window_path(w), dirty: self.window_buffer(w).is_dirty(), mode: Mode.Normal, lang: "" }

    # Store the current window's cursor, want and top into its Window, and
    # note its buffer's cursor, before another window becomes current.
    fn park(self: @&Editor)
        self.wins[self.cur].cursor = self.cursor
        self.wins[self.cur].want = self.want
        self.wins[self.cur].top = self.top
        self.bufs[self.at].cursor = self.cursor

    # Window w current: its buffer, cursor, want and top loaded. The one
    # current before must be parked (or closed) first.
    fn enter(self: @&Editor, w: i64)
        self.cur = w
        self.at = self.slot_of(self.wins[w].number)
        self.cursor = self.wins[w].cursor
        self.want = self.wins[w].want
        self.top = self.wins[w].top

    # To window `id`, when it is another.
    fn go_to_window(self: @&Editor, id: i64)
        let w = self.window_slot(id)
        if w == self.cur
            return
        self.park()
        self.enter(w)

    # :sp, :vs, Ctrl-W s, Ctrl-W v: a new window above (Stack) or to the
    # left (Row), current, onto the current buffer with the same cursor and
    # a copy of the jump stack. False, said (E36), when a window would be
    # left without a text row.
    pub fn split(self: @&Editor, how: Split) -> bool
        let id = self.next_id
        if not self.layout.split(self.wins[self.cur].id, id, how)
            return false
        if not self.tiling().fits()
            let undone = self.layout.remove(id)
            self.say(MSG_NO_ROOM)
            return false
        self.next_id += 1
        self.park()
        let jumps = Jumps { list: self.wins[self.cur].jumps.list.clone(), paths: self.wins[self.cur].jumps.paths.clone() }
        self.wins.push(Window { id: id, number: self.wins[self.cur].number, alt: self.wins[self.cur].alt, cursor: self.cursor, want: self.want, top: self.top, jumps: jumps })
        self.enter(self.wins.len() - 1)
        true

    # Window w gone from `wins` (the layout let it go already): the last
    # window takes its index.
    fn forget_window(self: @&Editor, w: i64)
        let last = self.wins.len() - 1
        if w == last
            let gone = self.wins.pop()
            return
        let moved = self.wins.pop()
        let gone = self.wins.replace(w, moved)
        if self.cur == last
            self.cur = w

    # Close window w (an index). Closing the current one makes the window
    # that takes its room current. False, said (E444), for the last window.
    pub fn close_window(self: @&Editor, w: i64) -> bool
        let heir: i64 = match self.layout.remove(self.wins[w].id)
            Some(h) => h
            None =>
                self.say(MSG_LAST_WINDOW)
                return false
        if w != self.cur
            self.forget_window(w)
            return true
        self.park()
        self.forget_window(w)
        self.enter(self.window_slot(heir))
        true

    # :close, Ctrl-W c.
    pub fn close_current(self: @&Editor)
        let closed = self.close_window(self.cur)

    # :only, Ctrl-W o: every other window closed.
    pub fn only(self: @&Editor)
        let order = self.layout.order()
        let here = self.wins[self.cur].id
        for k in 0..order.len()
            if order.get(k) != here
                let closed = self.close_window(self.window_slot(order.get(k)))

    # Ctrl-W h j k l: `count` windows (at least one) `dir`, as far as there
    # are, as Vim's go: through the cell past the window's edge in the
    # cursor's screen row or column (its code-point column past the gutter;
    # horizontal scrolling and wide cells aside).
    fn go_direction(self: @&Editor, dir: Dir, count: i64)
        let n = if count > 0 then count else 1
        for i in 0..n
            let t = self.tiling()
            let id = self.wins[self.cur].id
            let r: Rect = match t.rect_of(id)
                Some(found) => found
                None => return
            var down = self.cursor.line - self.top
            if down > r.rows - 2
                down = r.rows - 2
            if down < 0
                down = 0
            let s = self.buf().line(self.cursor.line)
            var col = r.col + gutter_width(self.shown(), r.cols) + units_before(s, self.cursor.col)
            if col > r.col + r.cols - 1
                col = r.col + r.cols - 1
            match t.neighbour(id, dir, r.row + down, col)
                Some(next) => self.go_to_window(next)
                None => return

    # Ctrl-W w (forward) and W: the next or previous window in order, round
    # past the ends; with a count, window `count` (the last when there are
    # fewer).
    fn go_round(self: @&Editor, forward: bool, count: i64)
        let order = self.layout.order()
        let n = order.len()
        var k: i64 = 0
        if count > 0
            k = if count > n then n - 1 else count - 1
        else
            let here = self.current_window()
            k = if forward then (here + 1) % n else (here + n - 1) % n
        self.go_to_window(order.get(k))

    # :q, :q!, :wq and Ctrl-W q: close the window, or in the last one quit,
    # which unless `force` is refused while any buffer has pending edits:
    # E37 for this one, else E162 for the first other, which it shows.
    pub fn quit_window(self: @&Editor, force: bool)
        if self.wins.len() > 1
            self.close_current()
            return
        if not force
            if self.buf().is_dirty()
                self.say(MSG_NOT_SAVED)
                return
            match self.changed_other()
                Some(k) =>
                    var msg = string_from("E162: No write since last change for buffer \"")
                    msg.push_str(display_name(self.bufs[k].path.as_view()))
                    msg.push('"')
                    self.show(self.bufs[k].number)
                    self.say(msg.as_view())
                    return
                None => pass
        self.quit = true

    # A window command (Ctrl-W and a key).
    pub fn window_command(self: @&Editor, wc: WindowCommand, count: i64)
        match wc
            WindowCommand.Left => self.go_direction(Dir.Left, count)
            WindowCommand.Down => self.go_direction(Dir.Down, count)
            WindowCommand.Up => self.go_direction(Dir.Up, count)
            WindowCommand.Right => self.go_direction(Dir.Right, count)
            WindowCommand.Next => self.go_round(true, count)
            WindowCommand.Previous => self.go_round(false, count)
            WindowCommand.Split =>
                let made = self.split(Split.Stack)
            WindowCommand.VSplit =>
                let made = self.split(Split.Row)
            WindowCommand.Close => self.close_current()
            WindowCommand.Only => self.only()
            WindowCommand.Quit => self.quit_window(false)

    # ------------------------------------------------------------------
    # Other windows onto the current buffer follow its edits
    # ------------------------------------------------------------------

    # Before a key: the other windows onto the current buffer, their
    # cursors and tops as byte offsets, and the buffer's change notes from
    # before cleared.
    pub fn before_key(self: @&Editor)
        self.buf_mut().forget_changes()
        self.watched.clear()
        let number = self.wins[self.cur].number
        for w in 0..self.wins.len()
            if w != self.cur and self.wins[w].number == number
                let c = self.wins[w].cursor
                let t = self.wins[w].top
                let co = self.bufs[self.at].buf.offset_of(c)
                let to = self.bufs[self.at].buf.offset_of(pos(t, 0))
                self.watched.push(Watched { id: self.wins[w].id, number: number, cursor: co, top: to })

    # After it: each watched window moved through the buffer's changes,
    # then every buffer's notes cleared.
    pub fn after_key(self: @&Editor)
        for i in 0..self.watched.len()
            let wt = self.watched.get(i)
            let k: i64 = match self.find_buffer(wt.number)
                Some(found) => found
                None => continue
            let w: i64 = match self.find_window(wt.id)
                Some(found) => found
                None => continue
            if w != self.cur and self.wins[w].number == wt.number and self.bufs[k].buf.changes().len > 0
                let c = shifted(@self.bufs[k].buf, wt.cursor)
                let t = shifted(@self.bufs[k].buf, wt.top)
                let at = self.bufs[k].buf.pos_at(c)
                let top = self.bufs[k].buf.pos_at(t)
                let p = settle(@self.bufs[k].buf, at)
                self.wins[w].cursor = p
                self.wins[w].want = units_before(self.bufs[k].buf.line(p.line), p.col)
                self.wins[w].top = top.line
        for k in 0..self.bufs.len()
            if self.bufs[k].buf.changes().len > 0
                self.follow_quickfix(k)
            self.bufs[k].buf.forget_changes()

    # The quickfix entries in buffer k's file moved through its changes.
    fn follow_quickfix(self: @&Editor, k: i64)
        let f: i64 = match self.qf.file_index(self.bufs[k].path.as_view())
            Some(found) => found
            None => return
        for e in 0..self.qf.len()
            let entry = self.qf.entry(e)
            if entry.file == f
                self.qf.set_at(e, shifted(@self.bufs[k].buf, entry.at))

# ============================================================================
# Keys
# ============================================================================

# Apply one typed key. `files` loads and saves for `:e` and `:w`.
pub fn handle_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key)
    ed.message.clear()
    ed.before_key()
    match ed.mode
        Mode.Normal => normal_key<F>(ed, files, key, Keymap.Normal)
        Mode.Visual | Mode.VisualLine => normal_key<F>(ed, files, key, Keymap.Visual)
        Mode.Insert => ed.insert_key(key)
        Mode.CommandLine => command_line_key<F>(ed, files, key)
        Mode.Picker => picker_key<F>(ed, files, key)
    ed.after_key()

# A key of a Normal- or Visual-mode command; run it once complete.
fn normal_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key, map: Keymap)
    match ed.keys.feed(key, map)
        Step.Run(cmd) => run_normal<F>(ed, files, cmd)
        Step.Wait | Step.Cancel => pass

# Run one Normal- or Visual-mode command (core/normal.ritz decoded it). A
# count repeats u, Ctrl-R, Ctrl-F, Ctrl-B and Ctrl-O until one fails; / and
# ? keep theirs for the search (3/x: the third x); i, a, o, O, :, K, gd and
# the Visual commands but p and P take none.
# A window command takes its count as Vim's does (Ctrl-W w: that window;
# Ctrl-W j: that many down); its others ignore it.
fn run_normal<F: FileStore>(ed: @&Editor, files: @&F, cmd: NormalCommand)
    let times = cmd.times()
    let l = ed.cursor.line
    match cmd.action
        Action.Move(m) => ed.move_by(m, cmd.count)
        Action.Operate(op, m) => ed.operate(op, m, cmd.count)
        Action.Insert => ed.start_insert(ed.cursor)
        Action.Append => ed.start_insert(pos(l, utf8_next(ed.buf().line(l), ed.cursor.col)))
        Action.OpenBelow =>
            ed.start_insert(ed.cursor)
            ed.cursor = ed.buf_mut().split_line(pos(l, ed.buf().line_len(l)))
        Action.OpenAbove =>
            ed.start_insert(pos(l, 0))
            ed.buf_mut().split_line(pos(l, 0))
        Action.PutAfter => ed.put_key(true, times)
        Action.PutBefore => ed.put_key(false, times)
        Action.Undo =>
            var k: i64 = 0
            while k < times and ed.undo()
                k += 1
        Action.Redo =>
            var k: i64 = 0
            while k < times and ed.redo()
                k += 1
        Action.PageDown =>
            for k in 0..(if times > ed.shown() then ed.shown() else times)
                ed.page_down()
        Action.PageUp =>
            for k in 0..(if times > ed.shown() then ed.shown() else times)
                ed.page_up()
        Action.CommandLine => ed.open_command_line(':')
        Action.Search(forward) => ed.open_search(None, forward, cmd.count)
        Action.OperateSearch(op, forward) => ed.open_search(Some(op), forward, cmd.count)
        Action.Hover => ed.ask = LangAsk.Hover
        Action.Definition => ed.ask = LangAsk.Definition
        Action.JumpBack =>
            var k: i64 = 0
            while k < times and jump_back<F>(ed, files)
                k += 1
        Action.Select(shape) => ed.select(shape)
        Action.Reselect => ed.reselect()
        Action.SwapEnds => ed.swap_ends()
        Action.OperateSelection(op) => ed.operate_selection(op)
        Action.Leave => ed.leave_visual()
        Action.Window(wc) => ed.window_command(wc, cmd.count)

fn command_line_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key)
    match key
        Key.Escape => ed.close_command_line()
        Key.Backspace =>
            # Backspace over the prompt leaves the command line.
            if ed.cmdline.len() <= 1
                ed.close_command_line()
            else
                let s = span_from_strview(ed.cmdline.as_view())
                let keep = utf8_prev(s, s.len)
                while ed.cmdline.len() > keep
                    ed.cmdline.pop()
        Key.Enter =>
            let line = string_from(ed.cmdline.as_view())
            ed.close_command_line()
            let text = line.as_view().slice(1, line.len())
            let prompt = line.get(0)
            if prompt == '/' or prompt == '?'
                run_search(ed, text, prompt == '/')
            else
                run_command<F>(ed, files, text)
        Key.Tab => ed.cmdline.push('\t')
        Key.Char(c) =>
            let bytes = utf8_encode(c)
            ed.cmdline.push_span(span_from_vec<u8>(@bytes))
        _ => pass

# `/text` (forward) or `?text`: search for the pattern `text` from the
# cursor, as many matches on as the count typed before the / or ?, moving
# there or applying the operator typed before it up to there; an empty one
# searches for the last pattern. A pattern that doesn't compile says Vim's
# error and leaves the last one as it was.
fn run_search(ed: @&Editor, text: StrView, forward: bool)
    if not text.is_empty()
        match regex_compile(text, RegexSyntax.Vim)
            Ok(re) =>
                ed.pattern.clear()
                ed.pattern.push_view(text)
            Err(e) =>
                ed.say(e.message())
                return
    ed.forward = forward
    match ed.search_op
        Some(op) => ed.operate(op, Motion.SearchNext, ed.search_count)
        None => ed.move_by(Motion.SearchNext, ed.search_count)

fn run_command<F: FileStore>(ed: @&Editor, files: @&F, text: StrView)
    match parse_command(text)
        Some(cmd) => match cmd
            Command.Goto(n) => ed.place_line(n - 1)
            Command.Write => write_named<F>(ed, files)
            Command.WriteTo(p) =>
                # A copy, unless the buffer has no name yet or it is this one.
                let own = ed.path().is_empty() or ed.path().eq(p)
                if ed.path().is_empty()
                    ed.name_buffer(p)
                write<F>(ed, files, p, own)
            Command.WriteQuit =>
                if write_named<F>(ed, files)
                    ed.quit_window(false)
            Command.Quit => ed.quit_window(false)
            Command.ForceQuit => ed.quit_window(true)
            Command.Edit(p) =>
                let opened = edit<F>(ed, files, p)
            Command.List => ed.list_buffers()
            Command.Buffer(arg) => ed.go_to_buffer(arg)
            Command.BufferNext => ed.go_round_buffers(true)
            Command.BufferPrev => ed.go_round_buffers(false)
            Command.BufferDelete(arg, force) => ed.delete_buffer(arg, force)
            Command.Split(p) => split_edit<F>(ed, files, Split.Stack, p)
            Command.VSplit(p) => split_edit<F>(ed, files, Split.Row, p)
            Command.Close => ed.close_current()
            Command.Only => ed.only()
            Command.PickFiles => ed.open_file_picker(files.list(MAX_PICKER_FILES))
            Command.PickBuffers => ed.open_buffer_picker()
            Command.Vimgrep(arg) => grep<F>(ed, files, parse_vimgrep(arg))
            Command.Grep(arg) => grep<F>(ed, files, parse_grep(arg))
            Command.QuickfixNext(n) => quickfix_move<F>(ed, files, ed.qf.step(n, true))
            Command.QuickfixPrev(n) => quickfix_move<F>(ed, files, ed.qf.step(n, false))
            Command.QuickfixGo(n) => quickfix_move<F>(ed, files, ed.qf.go(n))
            Command.QuickfixOpen => ed.open_quickfix_picker()
            Command.QuickfixClose => pass
        None =>
            var msg = string_from("E492: Not an editor command: ")
            msg.push_str(text)
            ed.say(msg.as_view())

# A key in Picker mode: the query, the selection, or Enter / Escape.
fn picker_key<F: FileStore>(ed: @&Editor, files: @&F, key: Key)
    match key
        Key.Escape => ed.close_picker()
        Key.Enter => open_picked<F>(ed, files)
        Key.Backspace =>
            let erased = ed.picker.erase()
        Key.Up => ed.picker.move_by(-1)
        Key.Down => ed.picker.move_by(1)
        Key.Ctrl(c) =>
            if c == 'p'
                ed.picker.move_by(-1)
            else if c == 'n'
                ed.picker.move_by(1)
        Key.Char(c) =>
            let bytes = utf8_encode(c)
            ed.picker.type_text(bytes.as_view())
        _ => pass

# Enter in the picker: it closes, then the selected file opens (as `:e`
# would: its buffer if it has one) or the selected buffer shows. Nothing
# more when no candidate matches.
fn open_picked<F: FileStore>(ed: @&Editor, files: @&F)
    let c: i64 = match ed.picker.chosen()
        Some(found) => found
        None =>
            ed.close_picker()
            return
    match ed.picker.kind
        PickerKind.Files =>
            let path = string_from(ed.picker.name_of(c))
            ed.close_picker()
            let opened = edit<F>(ed, files, path.as_view())
        PickerKind.Buffers =>
            let number = ed.picker.number_of(c)
            ed.close_picker()
            ed.show(number)
        PickerKind.Quickfix =>
            let k = ed.picker.number_of(c)
            ed.close_picker()
            ed.qf.current = k
            go_entry<F>(ed, files, k)

# ============================================================================
# Workspace search and the quickfix list (AGAST #4972)
# ============================================================================

# True when the first BINARY_PROBE bytes of `bytes` hold a NUL.
fn is_binary(bytes: [u8]) -> bool
    let n = if bytes.len > BINARY_PROBE then BINARY_PROBE else bytes.len
    for i in 0..n
        if bytes[i] == 0
            return true
    false

# True when one of `globs` matches `path`, or there are none.
fn wanted(globs: @Vec<Glob>, path: StrView) -> bool
    if globs.len() == 0
        return true
    for k in 0..globs.len()
        if globs[k].matches(path)
            return true
    false

# :vimgrep and :grep with their argument parsed (None: E683): the quickfix
# list replaced by the pattern's matches in the workspace's files that the
# globs name (the module comment has the rest). An empty pattern is the
# last search's. Nothing found is E480, the list left empty.
fn grep<F: FileStore>(ed: @&Editor, files: @&F, parsed: Option<GrepArgs>)
    let args: GrepArgs = match parsed
        Some(a) => a
        None =>
            ed.say(MSG_QF_BAD_ARGS)
            return
    var pattern: Vec<u8> = vec_new<u8>()
    pattern.push_view(if args.pattern.is_empty() then ed.pattern.as_view() else args.pattern)
    if pattern.len() == 0
        ed.say(MSG_NO_PATTERN)
        return
    let re: Regex = match regex_compile(pattern.as_view(), RegexSyntax.Vim)
        Ok(r) => r
        Err(e) =>
            ed.say(e.message())
            return
    var globs: Vec<Glob> = vec_new<Glob>()
    for k in 0..word_count(args.globs)
        globs.push(glob_compile(glob_word(args.globs, k)))
    let list = files.list(MAX_PICKER_FILES)
    ed.qf.clear()
    for i in 0..list.len()
        let path = list.get(i)
        if not wanted(@globs, path)
            continue
        var room = true
        match ed.find_path(path)
            Some(k) => room = ed.qf.scan(path, @ed.bufs[k].buf, @re, args.every)
            None =>
                match files.load(path)
                    Ok(bytes) =>
                        let data = span_from_vec<u8>(@bytes)
                        if not is_binary(data)
                            let b = buffer_from_bytes(data)
                            room = ed.qf.scan(path, @b, @re, args.every)
                    Err(_) => pass
        if not room
            break
    release_all<Glob>(@&globs)
    ed.pattern = pattern
    if ed.qf.is_empty()
        var msg = string_from("E480: No match: ")
        msg.push_str(ed.pattern.as_view())
        ed.say(msg.as_view())
        return
    if args.jump
        go_entry<F>(ed, files, 0)

# A quickfix move's result: to the entry, or its error said.
fn quickfix_move<F: FileStore>(ed: @&Editor, files: @&F, moved: Result<i64, QfError>)
    match moved
        Ok(k) => go_entry<F>(ed, files, k)
        Err(e) =>
            let msg: StrView = match e
                QfError.Empty => MSG_QF_EMPTY
                QfError.NoMore => MSG_QF_NO_MORE
            ed.say(msg)

# To quickfix entry k: its file shown as :e would, the cursor on the match
# (where its offset has moved to), `(k of n): text` said.
fn go_entry<F: FileStore>(ed: @&Editor, files: @&F, k: i64)
    let path = string_from(ed.qf.path_of(k))
    if not ed.path().eq(path.as_view())
        if not edit<F>(ed, files, path.as_view())
            return
    let at = ed.qf.entry(k).at
    let p = ed.buf_mut().pos_at(at)
    ed.place(p)
    let msg = ed.qf.label(k)
    ed.say(msg.as_view())

# :sp and :vs: a new window; with a path, the file in it as :e would.
fn split_edit<F: FileStore>(ed: @&Editor, files: @&F, how: Split, path: StrView)
    if ed.split(how) and not path.is_empty()
        let opened = edit<F>(ed, files, path)

# Save to the buffer's own name; true when saved.
fn write_named<F: FileStore>(ed: @&Editor, files: @&F) -> bool
    if ed.path().is_empty()
        ed.say(MSG_NO_NAME)
        return false
    let path = string_from(ed.path())
    write<F>(ed, files, path.as_view(), true)

# Save the buffer to `path`, marking it clean when `own` (the buffer's own
# file). On failure it stays dirty. True when saved.
fn write<F: FileStore>(ed: @&Editor, files: @&F, path: StrView, own: bool) -> bool
    match files.save(path, ed.buf())
        Ok(_) =>
            if own
                ed.buf_mut().mark_saved()
            var msg = ed.file_info(path)
            msg.push_str(" written")
            ed.say(msg.as_view())
            true
        Err(e) =>
            match e
                SaveError.Changed => ed.say_about(path, " changed on disk since it was read: not written")
                SaveError.Failed(errno) =>
                    var what = string_from(" not written: ")
                    what.push_str(errno.message())
                    ed.say_about(path, what.as_view())
                SaveError.Unpersisted(errno) =>
                    var what = string_from(" not saved to storage: ")
                    what.push_str(errno.message())
                    what.push_str("; the live file may already have changed")
                    ed.say_about(path, what.as_view())
            false

# `:e path`: show the file's buffer, read into a new one when it has none
# (the buffer shown before stays in the list, pending edits and all). A
# missing file opens empty under its name. True when the file is shown.
fn edit<F: FileStore>(ed: @&Editor, files: @&F, path: StrView) -> bool
    if path.is_empty()
        ed.say(MSG_NO_NAME)
        return false
    match ed.find_path(path)
        Some(k) =>
            ed.show(ed.buffer_number_at(k))
            let info = ed.file_info(path)
            ed.say(info.as_view())
            return true
        None => pass
    match files.load(path)
        Ok(bytes) =>
            let n = ed.add_buffer(path, buffer_from_bytes(span_from_vec<u8>(@bytes)))
            ed.show(n)
            let info = ed.file_info(path)
            ed.say(info.as_view())
        Err(e) =>
            match e
                LoadError.NotFound =>
                    let n = ed.add_buffer(path, buffer_new())
                    ed.show(n)
                    ed.say_about(path, " [New]")
                LoadError.Failed(errno) =>
                    var what = string_from(": ")
                    what.push_str(errno.message())
                    ed.say_about(path, what.as_view())
                    return false
    true

# ============================================================================
# Jumps (go to definition and back)
# ============================================================================

impl Jumps
    fn depth(self: @Jumps) -> i64
        self.list.len()

    # Remember the cursor `at` in file `path`; past MAX_JUMPS the oldest
    # goes.
    fn push(self: @&Jumps, path: StrView, at: Pos)
        if self.list.len() >= MAX_JUMPS
            # Drop the oldest: its name leaves the front of the pool.
            let old = self.list.get(0)
            var kept: Vec<Jump> = vec_with_cap<Jump>(MAX_JUMPS)
            for i in 1..self.list.len()
                var j = self.list.get(i)
                j.path_at -= old.path_len
                kept.push(j)
            self.list = kept
            let all: [u8] = self.paths[0..self.paths.len()]
            let rest = all.len - old.path_len
            all[0..rest].copy_from(all[old.path_len..all.len])
            while self.paths.len() > rest
                self.paths.pop()
        let start = self.paths.len()
        self.paths.push_view(path)
        self.list.push(Jump { path_at: start, path_len: path.len(), at: at })

    # The newest jump, taken off: its file name and cursor.
    fn pop(self: @&Jumps) -> Option<JumpBack>
        if self.list.is_empty()
            return None
        let j = self.list.pop()
        let all: [u8] = self.paths[j.path_at..j.path_at + j.path_len]
        let back = JumpBack { path: string_from(all.as_strview()), at: j.at }
        while self.paths.len() > j.path_at
            self.paths.pop()
        Some(back)

impl Editor
    # K or gd since the last call, cleared.
    pub fn take_ask(self: @&Editor) -> LangAsk
        let a = self.ask
        self.ask = LangAsk.Nothing
        a

    # How many jumps Ctrl-O / Ctrl-T can go back in the current window.
    pub fn jump_depth(self: @Editor) -> i64
        self.wins[self.cur].jumps.depth()

    # Remember the cursor and file, to come back to. pub only for the
    # generic jump_to<F> (see say()).
    pub fn push_jump(self: @&Editor)
        let path = string_from(self.path())
        self.wins[self.cur].jumps.push(path.as_view(), self.cursor)

    # The newest jump, taken off: its file name and cursor. pub only for
    # the generic jump_back<F>.
    pub fn pop_jump(self: @&Editor) -> Option<JumpBack>
        self.wins[self.cur].jumps.pop()

    # Put back a jump pop_jump gave, as it was. pub for jump_back<F>.
    pub fn restore_jump(self: @&Editor, j: @JumpBack)
        self.wins[self.cur].jumps.push(j.path.as_view(), j.at)

    # Name the current buffer `path` (`:w path` on a buffer with none).
    # pub for the generic run_command<F>.
    pub fn name_buffer(self: @&Editor, path: StrView)
        self.bufs[self.at].path.clear()
        self.bufs[self.at].path.push_str(path)

# A jump taken off the stack (Editor.pop_jump).
pub struct JumpBack
    path: String
    at: Pos

# Go to `at` in the file `path` (the current buffer when it names it),
# remembering where the cursor was for Ctrl-O / Ctrl-T. Another file's
# buffer is shown as `:e` would, read only when it has none. True when
# there.
pub fn jump_to<F: FileStore>(ed: @&Editor, files: @&F, path: StrView, at: Pos) -> bool
    ed.push_jump()
    if not ed.path().eq(path)
        if not edit<F>(ed, files, path)
            let dropped = ed.pop_jump()
            return false
    ed.place(at)
    true

# Ctrl-O / Ctrl-T: back to where the last jump_to left from, in that file's
# buffer (read again only when it was deleted). A file that can't be read
# keeps the jump for another try. True when back.
fn jump_back<F: FileStore>(ed: @&Editor, files: @&F) -> bool
    let j: JumpBack = match ed.pop_jump()
        Some(b) => b
        None =>
            ed.say(MSG_NO_JUMP)
            return false
    if not ed.path().eq(j.path.as_view())
        if not edit<F>(ed, files, j.path.as_view())
            ed.restore_jump(@j)
            return false
    ed.place(j.at)
    true
