# core/utf8.ritz - stepping through line bytes by UTF-8 code point.
#
# The cursor moves by code point (docs/BUDDHAFINGER_PROPOSAL.md, "Buffer
# representation and performance"); grapheme clusters wait on ritzlib. A
# byte that doesn't start a well-formed sequence is one unit on its own, so
# malformed UTF-8 stays editable byte by byte and is never lost.
# Core module: no terminal or OS I/O (see src/platform/).

import ritzlib.span

# The length of the well-formed UTF-8 sequence starting at s[i] (1 to 4), or
# 1 when the bytes there don't form one (RFC 3629: no overlongs, no
# surrogates, nothing above U+10FFFF). 0 at or past the end.
pub fn utf8_unit_len(s: [u8], i: i64) -> i64
    if i >= s.len
        return 0
    let b = s[i]
    if b < 0x80
        return 1
    # The sequence length and the range its second byte must fall in.
    var n: i64 = 0
    var lo: u8 = 0x80
    var hi: u8 = 0xBF
    if b >= 0xC2 and b <= 0xDF
        n = 2
    else if b >= 0xE0 and b <= 0xEF
        n = 3
        if b == 0xE0
            lo = 0xA0
        else if b == 0xED
            hi = 0x9F
    else if b >= 0xF0 and b <= 0xF4
        n = 4
        if b == 0xF0
            lo = 0x90
        else if b == 0xF4
            hi = 0x8F
    else
        return 1
    if i + n > s.len
        return 1
    if s[i + 1] < lo or s[i + 1] > hi
        return 1
    for k in 2..n
        if s[i + k] < 0x80 or s[i + k] > 0xBF
            return 1
    n

# The index after the unit at s[i]; s.len at or past the end.
pub fn utf8_next(s: [u8], i: i64) -> i64
    if i >= s.len
        return s.len
    i + utf8_unit_len(s, i)

# The index of the unit ending at s[i]: the start of the sequence that ends
# there, else i - 1. 0 at or before the start.
pub fn utf8_prev(s: [u8], i: i64) -> i64
    if i <= 0
        return 0
    # A sequence is at most 4 bytes: try each start that could end at i.
    var back: i64 = 2
    while back <= 4 and i - back >= 0
        if utf8_unit_len(s, i - back) == back
            return i - back
        back += 1
    i - 1
