# core/screen.ritz - screen layout.
#
# The editor renders to a grid of styled cells and a platform adapter emits
# the cells that changed (docs/BUDDHAFINGER_PROPOSAL.md, "Ritz and platform
# boundaries"). Below the text area sit a status line and a command and
# message line.
# Core module: no terminal or OS I/O (see src/platform/).

pub struct Size
    rows: i32
    cols: i32

# Rows below the text area: the status line and the command/message line.
pub const CHROME_ROWS: i32 = 2

# Rows left for buffer text in a viewport of `size`.
pub fn text_rows(size: Size) -> i32
    if size.rows > CHROME_ROWS then size.rows - CHROME_ROWS else 0
