# spire/test/support/test_utils.ritz
#
# Test utilities for Spire framework testing
#
# Provides helpers for:
# - Building test requests
# - Asserting response properties
# - Common test fixtures
#
# Assertion helpers are [[test_helper]] fns: they `assert`, so a failure
# stops the test and reports the calling test's line.
#
# Usage:
#
#   import test.support.test_utils { request_get, assert_status_ok, assert_content_type_json }
#
#   [[test]]
#   fn test_my_handler() -> i32
#       let path: StrView = "/api/tasks"
#       var req: Request = request_get(@path)
#       var resp: Response = my_handler(@req)
#       assert_status_ok(@resp)
#       assert_content_type_json(@resp)
#       0

import ritzlib.strview { StrView, strview_eq, strview_contains }
import ritzlib.string { String, string_new }
import ritzlib.gvec { vec_push }
import ritzlib.span { Span, span_from_strview, span_as_strview }

import spire.http.mod { METHOD_GET, METHOD_POST, METHOD_PUT, METHOD_PATCH, METHOD_DELETE }
import spire.http.mod { STATUS_OK, STATUS_CREATED, STATUS_NO_CONTENT, STATUS_BAD_REQUEST }
import spire.http.mod { STATUS_UNAUTHORIZED, STATUS_FORBIDDEN, STATUS_NOT_FOUND, STATUS_INTERNAL_SERVER_ERROR }
import spire.http.request { Request, request_with, request_set_header, request_set_body }
import spire.http.response { Response, response_status, response_body, response_body_len }
import spire.http.response { response_header_count, response_header_name, response_header_value }
import spire.http.headers { header_name_eq }
import spire.utils { string_as_strview }

# ============================================================================
# Request Builders
# ============================================================================

# Create a request with `method` to given path
pub fn request_for(method: i32, path: *StrView) -> Request
    let sp: Span<u8> = span_from_strview(path)
    return request_with(method, @sp)

# Create a GET request to given path
pub fn request_get(path: *StrView) -> Request
    return request_for(METHOD_GET, path)

# Create a POST request to given path
pub fn request_post(path: *StrView) -> Request
    return request_for(METHOD_POST, path)

# Create a PUT request to given path
pub fn request_put(path: *StrView) -> Request
    return request_for(METHOD_PUT, path)

# Create a PATCH request to given path
pub fn request_patch(path: *StrView) -> Request
    return request_for(METHOD_PATCH, path)

# Create a DELETE request to given path
pub fn request_delete(path: *StrView) -> Request
    return request_for(METHOD_DELETE, path)

# Set a header from two StrViews
pub fn request_header_sv(req: *Request, name: *StrView, value: *StrView)
    let n: Span<u8> = span_from_strview(name)
    let v: Span<u8> = span_from_strview(value)
    request_set_header(req, @n, @v)

# Set Content-Type: application/json and copy `body` into the request
fn set_json_body(req: *Request, body: *StrView)
    let ct_name: StrView = "Content-Type"
    let ct_value: StrView = "application/json"
    request_header_sv(req, @ct_name, @ct_value)
    let b: Span<u8> = span_from_strview(body)
    request_set_body(req, @b)

# Create a POST request with JSON body
pub fn request_post_json(path: *StrView, body: *StrView) -> Request
    var req: Request = request_for(METHOD_POST, path)
    set_json_body(@req, body)
    return req

# Create a PUT request with JSON body
pub fn request_put_json(path: *StrView, body: *StrView) -> Request
    var req: Request = request_for(METHOD_PUT, path)
    set_json_body(@req, body)
    return req

# Add Accept: application/json header
pub fn request_accept_json(req: *Request)
    let name: StrView = "Accept"
    let value: StrView = "application/json"
    request_header_sv(req, @name, @value)

# Add Accept: text/html header
pub fn request_accept_html(req: *Request)
    let name: StrView = "Accept"
    let value: StrView = "text/html"
    request_header_sv(req, @name, @value)

# Add Authorization header
pub fn request_auth(req: *Request, token: *StrView)
    let name: StrView = "Authorization"
    request_header_sv(req, @name, token)

# Add Bearer token authorization
pub fn request_bearer(req: *Request, token: *StrView)
    let name: StrView = "Authorization"
    # Build "Bearer <token>"
    var value: String = string_new()
    let prefix: StrView = "Bearer "
    var i: i64 = 0
    while i < prefix.len
        vec_push<u8>(@&value.data, *(prefix.ptr + i))
        i += 1
    i = 0
    while i < token.len
        vec_push<u8>(@&value.data, *(token.ptr + i))
        i += 1
    let value_sv: StrView = string_as_strview(@value)
    request_header_sv(req, @name, @value_sv)

# ============================================================================
# Response Header Lookup
# ============================================================================

# Find a response header by (case-insensitive) name.
# Returns 1 and writes the value to `out` if found, 0 otherwise.
pub fn response_find_header(resp: *Response, name: *StrView, out: *StrView) -> i32
    let wanted: Span<u8> = span_from_strview(name)
    var i: i64 = 0
    while i < response_header_count(resp)
        let n: Span<u8> = response_header_name(resp, i)
        if header_name_eq(@wanted, @n) == 1
            let v: Span<u8> = response_header_value(resp, i)
            out.ptr = v.ptr
            out.len = v.len
            return 1
        i += 1
    return 0

# ============================================================================
# Response Assertions
# ============================================================================
#
# [[test_helper]] fns (LANGUAGE_SPEC §17.1): each one `assert`s, so a failure
# exits the test with a diagnostic located at the calling test's line and a
# further line naming the helper.  Integer checks show both values through
# `assert a == b`; string checks eprint both values just before asserting,
# since `assert` only prints integer, bool and pointer operands.

# Assert response has specific status code
[[test_helper]]
pub fn assert_status(resp: *Response, expected: i32)
    assert response_status(resp) == expected

# Assert response is 200 OK
[[test_helper]]
pub fn assert_status_ok(resp: *Response)
    assert_status(resp, STATUS_OK)

# Assert response is 201 Created
[[test_helper]]
pub fn assert_status_created(resp: *Response)
    assert_status(resp, STATUS_CREATED)

# Assert response is 204 No Content
[[test_helper]]
pub fn assert_status_no_content(resp: *Response)
    assert_status(resp, STATUS_NO_CONTENT)

# Assert response is 400 Bad Request
[[test_helper]]
pub fn assert_status_bad_request(resp: *Response)
    assert_status(resp, STATUS_BAD_REQUEST)

# Assert response is 401 Unauthorized
[[test_helper]]
pub fn assert_status_unauthorized(resp: *Response)
    assert_status(resp, STATUS_UNAUTHORIZED)

# Assert response is 403 Forbidden
[[test_helper]]
pub fn assert_status_forbidden(resp: *Response)
    assert_status(resp, STATUS_FORBIDDEN)

# Assert response is 404 Not Found
[[test_helper]]
pub fn assert_status_not_found(resp: *Response)
    assert_status(resp, STATUS_NOT_FOUND)

# Assert response is 500 Internal Server Error
[[test_helper]]
pub fn assert_status_internal_error(resp: *Response)
    assert_status(resp, STATUS_INTERNAL_SERVER_ERROR)

# Assert the Content-Type header is present and contains `expected`
[[test_helper]]
fn assert_content_type_contains(resp: *Response, expected: *StrView)
    let ct_name: StrView = "Content-Type"
    var ct: StrView
    assert response_find_header(resp, @ct_name, @ct) == 1, "response has a Content-Type header"
    let ok: bool = strview_contains(@ct, expected)
    if not ok
        let want: StrView = *expected
        eprint("  Content-Type: {ct}\n  expected to contain: {want}\n")
    assert ok, "Content-Type contains the expected type"

# Assert response has Content-Type: application/json
[[test_helper]]
pub fn assert_content_type_json(resp: *Response)
    let expected: StrView = "application/json"
    assert_content_type_contains(resp, @expected)

# Assert response has Content-Type: text/html
[[test_helper]]
pub fn assert_content_type_html(resp: *Response)
    let expected: StrView = "text/html"
    assert_content_type_contains(resp, @expected)

# Assert response body is non-empty
[[test_helper]]
pub fn assert_body_not_empty(resp: *Response)
    assert response_body_len(resp) > 0

# Assert response has a header named `name` (case-insensitive)
[[test_helper]]
pub fn assert_has_header(resp: *Response, name: *StrView)
    var value: StrView
    let found: i32 = response_find_header(resp, name, @value)
    if found == 0
        let n: StrView = *name
        eprint("  header: {n}\n")
    assert found == 1, "response has the header"

# Assert response header `name` is present and equals `expected`
[[test_helper]]
pub fn assert_header_value(resp: *Response, name: *StrView, expected: *StrView)
    assert_has_header(resp, name)
    var actual: StrView
    response_find_header(resp, name, @actual)
    let ok: bool = strview_eq(@actual, expected)
    if not ok
        let n: StrView = *name
        let want: StrView = *expected
        eprint("  header:   {n}\n  actual:   {actual}\n  expected: {want}\n")
    assert ok, "header has the expected value"

# ============================================================================
# Body Assertions
# ============================================================================

# Get response body as StrView
pub fn response_body_str(resp: *Response) -> StrView
    let body: Span<u8> = response_body(resp)
    return span_as_strview(@body)

# Assert body contains substring
[[test_helper]]
pub fn assert_body_contains(resp: *Response, needle: *StrView)
    let body: StrView = response_body_str(resp)
    let ok: bool = strview_contains(@body, needle)
    if not ok
        let n: StrView = *needle
        eprint("  body:   {body}\n  needle: {n}\n")
    assert ok, "body contains the needle"

# Assert body equals exact string
[[test_helper]]
pub fn assert_body_equals(resp: *Response, expected: *StrView)
    let body: StrView = response_body_str(resp)
    let ok: bool = strview_eq(@body, expected)
    if not ok
        let want: StrView = *expected
        eprint("  actual:   {body}\n  expected: {want}\n")
    assert ok, "body equals the expected string"

# ============================================================================
# JSON Assertions (simple checks until we have proper JSON parser)
# ============================================================================

# Assert JSON body contains key (simple substring check)
[[test_helper]]
pub fn assert_json_has_key(resp: *Response, key: *StrView)
    assert_body_contains(resp, key)

# Assert JSON body contains key-value (simple pattern check)
# For now, just checks both key and value are present
[[test_helper]]
pub fn assert_json_value(resp: *Response, key: *StrView, value: *StrView)
    assert_body_contains(resp, key)
    assert_body_contains(resp, value)
