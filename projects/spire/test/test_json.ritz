# spire/test/test_json.ritz
#
# Tests for spire's JsonBuilder (lib/json).

import ritzlib.strview { StrView }
import ritzlib.string { String }

import spire.json.mod { JsonBuilder, json_builder_new, json_builder_finish }
import spire.json.mod { json_object_start, json_object_end, json_array_end }
import spire.json.mod { json_field_str, json_field_i64, json_field_object, json_field_array }
import spire.json.mod { json_elem_i64, json_error_to_string, JsonError }

[[test]]
fn test_json_flat_object() -> i32
    var b: JsonBuilder = json_builder_new()
    json_object_start(@&b)
    json_field_str(@&b, "a", "x")
    json_field_i64(@&b, "b", -12)
    json_object_end(@&b)
    assert (json_builder_finish(@&b)).eq("{\"a\":\"x\",\"b\":-12}")
    0

# A nested object or array field after another field: the comma goes before
# the field name only, never again between the ':' and the '{' / '['.
[[test]]
fn test_json_nested_field_after_field() -> i32
    var b: JsonBuilder = json_builder_new()
    json_object_start(@&b)
    json_field_i64(@&b, "a", 1)
    json_field_object(@&b, "o")
    json_field_i64(@&b, "x", 2)
    json_object_end(@&b)
    json_field_array(@&b, "l")
    json_elem_i64(@&b, 3)
    json_elem_i64(@&b, 4)
    json_array_end(@&b)
    json_object_end(@&b)
    assert (json_builder_finish(@&b)).eq("{\"a\":1,\"o\":{\"x\":2},\"l\":[3,4]}")
    0

[[test]]
fn test_json_error_to_string() -> i32
    var err: JsonError
    err.pos = 42
    let s: String = json_error_to_string(err)
    assert (s.as_view()).eq("JSON parse error at position 42")
    0
