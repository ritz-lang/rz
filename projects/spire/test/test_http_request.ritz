# spire/test/test_http_request.ritz
#
# Tests for HTTP Request type

import ritzlib.span { Span, span_from_cstr, span_eq }

import spire.http.mod { METHOD_GET, METHOD_POST }
import spire.http.mod { Request, request_new, request_with }
import spire.http.mod { request_method, request_path, request_param }
import spire.http.mod { request_query_param, request_header, request_body_len }
import spire.http.mod { request_wants_json, request_wants_html }
import spire.http.mod { request_is_json, request_is_form }
import spire.http.request { request_set_header, request_set_param }

# ============================================================================
# request_new tests
# ============================================================================

[[test]]
fn test_request_new_default_method_is_get() -> i32
    let req: Request = request_new()
    assert request_method(@req) == METHOD_GET
    0

[[test]]
fn test_request_new_default_path_is_root() -> i32
    let req: Request = request_new()
    let path: Span<u8> = request_path(@req)
    let expected: Span<u8> = span_from_cstr(c"/")
    assert span_eq(@path, @expected)
    0

[[test]]
fn test_request_new_body_is_empty() -> i32
    let req: Request = request_new()
    assert request_body_len(@req) == 0
    0

# ============================================================================
# request_with tests
# ============================================================================

[[test]]
fn test_request_with_get() -> i32
    let path: Span<u8> = span_from_cstr(c"/api/tasks")
    let req: Request = request_with(METHOD_GET, @path)
    assert request_method(@req) == METHOD_GET
    let actual_path: Span<u8> = request_path(@req)
    assert span_eq(@actual_path, @path)
    0

[[test]]
fn test_request_with_post() -> i32
    let path: Span<u8> = span_from_cstr(c"/api/tasks")
    let req: Request = request_with(METHOD_POST, @path)
    assert request_method(@req) == METHOD_POST
    let actual_path: Span<u8> = request_path(@req)
    assert span_eq(@actual_path, @path)
    0

[[test]]
fn test_request_with_complex_path() -> i32
    let path: Span<u8> = span_from_cstr(c"/api/users/123/tasks/456")
    let req: Request = request_with(METHOD_GET, @path)
    let actual_path: Span<u8> = request_path(@req)
    assert span_eq(@actual_path, @path)
    0

# ============================================================================
# request_param tests (route parameters like :id)
# ============================================================================

[[test]]
fn test_request_param_set_and_get() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"id")
    let value: Span<u8> = span_from_cstr(c"123")
    request_set_param(@req, @name, @value)
    var v: Span<u8>
    assert request_param(@req, @name, @v) == 1
    assert span_eq(@v, @value)
    0

[[test]]
fn test_request_param_not_found() -> i32
    let req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"missing")
    var v: Span<u8>
    assert request_param(@req, @name, @v) == 0
    0

[[test]]
fn test_request_param_multiple() -> i32
    var req: Request = request_new()
    let id_name: Span<u8> = span_from_cstr(c"id")
    let id_value: Span<u8> = span_from_cstr(c"123")
    let slug_name: Span<u8> = span_from_cstr(c"slug")
    let slug_value: Span<u8> = span_from_cstr(c"hello-world")
    request_set_param(@req, @id_name, @id_value)
    request_set_param(@req, @slug_name, @slug_value)

    var v1: Span<u8>
    assert request_param(@req, @id_name, @v1) == 1
    assert span_eq(@v1, @id_value)

    var v2: Span<u8>
    assert request_param(@req, @slug_name, @v2) == 1
    assert span_eq(@v2, @slug_value)
    0

# ============================================================================
# request_query_param tests
# ============================================================================

[[test]]
fn test_request_query_param_not_found() -> i32
    let req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"missing")
    var v: Span<u8>
    assert request_query_param(@req, @name, @v) == 0
    0

# ============================================================================
# request_header tests
# ============================================================================

[[test]]
fn test_request_header_set_and_get() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"X-Custom-Header")
    let value: Span<u8> = span_from_cstr(c"custom-value")
    request_set_header(@req, @name, @value)
    var v: Span<u8>
    assert request_header(@req, @name, @v) == 1
    assert span_eq(@v, @value)
    0

[[test]]
fn test_request_header_not_found() -> i32
    let req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"X-Missing")
    var v: Span<u8>
    assert request_header(@req, @name, @v) == 0
    0

# ============================================================================
# content negotiation tests
# ============================================================================

[[test]]
fn test_request_wants_json_with_accept_json() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Accept")
    let value: Span<u8> = span_from_cstr(c"application/json")
    request_set_header(@req, @name, @value)
    assert request_wants_json(@req) == 1
    0

[[test]]
fn test_request_wants_json_with_wildcard() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Accept")
    let value: Span<u8> = span_from_cstr(c"*/*")
    request_set_header(@req, @name, @value)
    assert request_wants_json(@req) == 1
    0

[[test]]
fn test_request_wants_json_without_accept() -> i32
    let req: Request = request_new()
    assert request_wants_json(@req) == 0
    0

[[test]]
fn test_request_wants_html_with_accept_html() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Accept")
    let value: Span<u8> = span_from_cstr(c"text/html")
    request_set_header(@req, @name, @value)
    assert request_wants_html(@req) == 1
    0

[[test]]
fn test_request_wants_html_default() -> i32
    # Without Accept header, should default to HTML
    let req: Request = request_new()
    assert request_wants_html(@req) == 1
    0

# ============================================================================
# content type checks
# ============================================================================

[[test]]
fn test_request_is_json_with_json_content_type() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"application/json")
    request_set_header(@req, @name, @value)
    assert request_is_json(@req) == 1
    0

[[test]]
fn test_request_is_json_with_json_charset() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"application/json; charset=utf-8")
    request_set_header(@req, @name, @value)
    assert request_is_json(@req) == 1
    0

[[test]]
fn test_request_is_json_without_content_type() -> i32
    let req: Request = request_new()
    assert request_is_json(@req) == 0
    0

[[test]]
fn test_request_is_form_with_form_content_type() -> i32
    var req: Request = request_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"application/x-www-form-urlencoded")
    request_set_header(@req, @name, @value)
    assert request_is_form(@req) == 1
    0

[[test]]
fn test_request_is_form_without_content_type() -> i32
    let req: Request = request_new()
    assert request_is_form(@req) == 0
    0
