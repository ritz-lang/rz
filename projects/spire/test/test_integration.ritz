# spire/test/test_integration.ritz
#
# Integration tests for Spire framework
#
# These tests exercise the full request/response cycle including:
# - Router setup
# - Request handling
# - Response generation
# - Content negotiation

import ritzlib.strview { StrView }
import ritzlib.span { Span, span_from_strview }

import spire.http.mod { METHOD_POST, METHOD_PUT, METHOD_DELETE }
import spire.http.mod { STATUS_OK, STATUS_CREATED, STATUS_NO_CONTENT, STATUS_NOT_FOUND }
import spire.http.request { Request }
import spire.http.response { Response, response_not_found, response_with_status, response_set_status }
import spire.http.response { response_json_str, response_html, response_status, response_body_len }
import spire.router.mod { Router, router_new, router_get, router_post, router_put, router_delete }
import spire.router.mod { router_handle }
import test.support.test_utils { request_for, request_get, request_post_json, request_header_sv }
import test.support.test_utils { request_accept_json, request_accept_html }
import test.support.test_utils { assert_status_ok, assert_status_created, assert_status_not_found }
import test.support.test_utils { assert_status_no_content }
import test.support.test_utils { assert_content_type_json, assert_content_type_html }
import test.support.test_utils { assert_body_contains }

# ============================================================================
# Test Handlers
# ============================================================================

fn handler_home(req: *Request) -> Response
    let html: StrView = "<h1>Welcome to Spire</h1>"
    let body: Span<u8> = span_from_strview(@html)
    return response_html(@body)

fn handler_api_status(req: *Request) -> Response
    let json: StrView = "{\"status\": \"ok\"}"
    let body: Span<u8> = span_from_strview(@json)
    return response_json_str(@body)

fn handler_tasks_list(req: *Request) -> Response
    let json: StrView = "{\"tasks\": []}"
    let body: Span<u8> = span_from_strview(@json)
    return response_json_str(@body)

fn handler_tasks_create(req: *Request) -> Response
    let json: StrView = "{\"id\": \"123\", \"title\": \"New Task\"}"
    let body: Span<u8> = span_from_strview(@json)
    var resp: Response = response_json_str(@body)
    response_set_status(@resp, STATUS_CREATED)
    return resp

fn handler_task_show(req: *Request) -> Response
    # In a real app, we'd use the :id param
    let json: StrView = "{\"id\": \"123\", \"title\": \"Task\"}"
    let body: Span<u8> = span_from_strview(@json)
    return response_json_str(@body)

fn handler_task_update(req: *Request) -> Response
    let json: StrView = "{\"id\": \"123\", \"title\": \"Updated Task\"}"
    let body: Span<u8> = span_from_strview(@json)
    return response_json_str(@body)

fn handler_task_delete(req: *Request) -> Response
    return response_with_status(STATUS_NO_CONTENT)

fn handler_users_show(req: *Request) -> Response
    let json: StrView = "{\"id\": \"user123\", \"name\": \"Test User\"}"
    let body: Span<u8> = span_from_strview(@json)
    return response_json_str(@body)

# ============================================================================
# Helper: Create test router
# ============================================================================

fn create_test_router() -> Router
    var r: Router = router_new()

    # Home page
    let home_path: StrView = "/"
    router_get(@r, @home_path, handler_home)

    # API status
    let status_path: StrView = "/api/status"
    router_get(@r, @status_path, handler_api_status)

    # Tasks CRUD
    let tasks_path: StrView = "/api/tasks"
    router_get(@r, @tasks_path, handler_tasks_list)
    router_post(@r, @tasks_path, handler_tasks_create)

    let task_path: StrView = "/api/tasks/:id"
    router_get(@r, @task_path, handler_task_show)
    router_put(@r, @task_path, handler_task_update)
    router_delete(@r, @task_path, handler_task_delete)

    # Users
    let user_path: StrView = "/api/users/:id"
    router_get(@r, @user_path, handler_users_show)

    return r

# ============================================================================
# Basic routing tests
# ============================================================================

[[test]]
fn test_integration_home_page() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert response_status(@resp) == STATUS_OK
    assert response_body_len(@resp) > 0
    0

[[test]]
fn test_integration_api_status() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/status"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert response_status(@resp) == STATUS_OK
    # Should return JSON
    assert assert_content_type_json(@resp) == 0
    let needle: StrView = "\"status\": \"ok\""
    assert assert_body_contains(@resp, @needle) == 0
    0

# ============================================================================
# CRUD operation tests
# ============================================================================

[[test]]
fn test_integration_list_tasks() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_ok(@resp) == 0
    0

[[test]]
fn test_integration_create_task() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks"
    let body: StrView = "{\"title\": \"New Task\"}"
    var req: Request = request_post_json(@path, @body)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_created(@resp) == 0
    0

[[test]]
fn test_integration_show_task() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks/123"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_ok(@resp) == 0
    0

[[test]]
fn test_integration_update_task() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks/123"
    var req: Request = request_for(METHOD_PUT, @path)
    let ct_name: StrView = "Content-Type"
    let ct_value: StrView = "application/json"
    request_header_sv(@req, @ct_name, @ct_value)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_ok(@resp) == 0
    0

[[test]]
fn test_integration_delete_task() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks/123"
    var req: Request = request_for(METHOD_DELETE, @path)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_no_content(@resp) == 0
    0

# ============================================================================
# Path parameter routing tests
# ============================================================================

[[test]]
fn test_integration_task_param_extraction() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks/abc-123"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    # The :id route should have matched
    assert assert_status_ok(@resp) == 0
    0

[[test]]
fn test_integration_user_param_extraction() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/users/user-456"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_ok(@resp) == 0
    0

# ============================================================================
# 404 handling tests
# ============================================================================

[[test]]
fn test_integration_not_found() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/nonexistent"
    var req: Request = request_get(@path)
    var resp: Response = router_handle(@router, @req)

    assert assert_status_not_found(@resp) == 0
    0

[[test]]
fn test_integration_wrong_method() -> i32
    var router: Router = create_test_router()
    # Try POST on a GET-only route
    let path: StrView = "/api/status"
    var req: Request = request_for(METHOD_POST, @path)
    var resp: Response = router_handle(@router, @req)

    assert response_status(@resp) == STATUS_NOT_FOUND
    0

# ============================================================================
# Content negotiation tests
# ============================================================================

[[test]]
fn test_integration_home_returns_html() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/"
    var req: Request = request_get(@path)
    request_accept_html(@req)
    var resp: Response = router_handle(@router, @req)

    assert assert_content_type_html(@resp) == 0
    0

[[test]]
fn test_integration_api_returns_json() -> i32
    var router: Router = create_test_router()
    let path: StrView = "/api/tasks"
    var req: Request = request_get(@path)
    request_accept_json(@req)
    var resp: Response = router_handle(@router, @req)

    assert assert_content_type_json(@resp) == 0
    0

# ============================================================================
# Multiple requests to same router
# ============================================================================

[[test]]
fn test_integration_multiple_requests() -> i32
    var router: Router = create_test_router()

    # First request
    let path1: StrView = "/api/tasks"
    var req1: Request = request_get(@path1)
    var resp1: Response = router_handle(@router, @req1)
    assert response_status(@resp1) == STATUS_OK

    # Second request
    let path2: StrView = "/api/users/123"
    var req2: Request = request_get(@path2)
    var resp2: Response = router_handle(@router, @req2)
    assert response_status(@resp2) == STATUS_OK

    # Third request
    let path3: StrView = "/"
    var req3: Request = request_get(@path3)
    var resp3: Response = router_handle(@router, @req3)
    assert response_status(@resp3) == STATUS_OK

    0

# ============================================================================
# Edge cases
# ============================================================================

[[test]]
fn test_integration_root_only() -> i32
    var router: Router = router_new()
    let path: StrView = "/"
    router_get(@router, @path, handler_home)

    let req_path: StrView = "/"
    var req: Request = request_get(@req_path)
    var resp: Response = router_handle(@router, @req)

    assert response_status(@resp) == STATUS_OK
    0

[[test]]
fn test_integration_nested_paths() -> i32
    var router: Router = router_new()

    let path1: StrView = "/a"
    let path2: StrView = "/a/b"
    let path3: StrView = "/a/b/c"

    router_get(@router, @path1, handler_api_status)
    router_get(@router, @path2, handler_api_status)
    router_get(@router, @path3, handler_api_status)

    # Test each level
    let req_path: StrView = "/a/b"
    var req: Request = request_get(@req_path)
    var resp: Response = router_handle(@router, @req)

    assert response_status(@resp) == STATUS_OK
    0
