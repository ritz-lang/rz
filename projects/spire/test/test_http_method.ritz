# spire/test/test_http_method.ritz
#
# Tests for HTTP method constants and parsing, via spire's public http surface
# (re-exported from the `http` package's types module).

import ritzlib.span

import spire.http.mod { METHOD_GET, METHOD_POST, METHOD_PUT, METHOD_DELETE, METHOD_PATCH, METHOD_HEAD, METHOD_OPTIONS }
import spire.http.mod { method_from_span, method_to_span }

# Parse `name`, require a known method, and require it to round-trip back to `name`.
fn roundtrip(name: *u8, expected: i32) -> i32
    var input: Span<u8> = span_from_cstr(name)
    let m: i32 = method_from_span(@input)
    if m != expected
        return 1
    var output: Span<u8> = method_to_span(m)
    if not span_eq(@output, @input)
        return 2
    0

# ============================================================================
# method_from_span tests
# ============================================================================

[[test]]
fn test_method_from_str_get() -> i32
    assert roundtrip(c"GET", METHOD_GET) == 0
    0

[[test]]
fn test_method_from_str_post() -> i32
    assert roundtrip(c"POST", METHOD_POST) == 0
    0

[[test]]
fn test_method_from_str_put() -> i32
    assert roundtrip(c"PUT", METHOD_PUT) == 0
    0

[[test]]
fn test_method_from_str_delete() -> i32
    assert roundtrip(c"DELETE", METHOD_DELETE) == 0
    0

[[test]]
fn test_method_from_str_patch() -> i32
    assert roundtrip(c"PATCH", METHOD_PATCH) == 0
    0

[[test]]
fn test_method_from_str_invalid() -> i32
    var input: Span<u8> = span_from_cstr(c"INVALID")
    assert method_from_span(@input) == 0  # METHOD_UNKNOWN
    0

[[test]]
fn test_method_from_str_lowercase_fails() -> i32
    # HTTP methods are case-sensitive per RFC 7230
    var input: Span<u8> = span_from_cstr(c"get")
    assert method_from_span(@input) == 0  # METHOD_UNKNOWN
    0

# ============================================================================
# method_to_span tests
# ============================================================================

[[test]]
fn test_method_to_str_get() -> i32
    let s: Span<u8> = method_to_span(METHOD_GET)
    assert s.len == 3
    0

[[test]]
fn test_method_to_str_post() -> i32
    let s: Span<u8> = method_to_span(METHOD_POST)
    assert s.len == 4
    0

[[test]]
fn test_method_to_str_delete() -> i32
    let s: Span<u8> = method_to_span(METHOD_DELETE)
    assert s.len == 6
    0
