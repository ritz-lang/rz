# spire/test/test_http_headers.ritz
#
# Tests for HTTP headers collection
#
# The headers API takes `*Span<u8>` names/values and reports lookups through
# an out-parameter (`headers_get(h, name, @out) -> i32`, 1 = found).

import ritzlib.span { Span, span_from_cstr, span_eq_cstr }

import spire.http.headers { Headers, Header, headers_new, headers_add, headers_set }
import spire.http.headers { headers_get, headers_contains, headers_remove, headers_len }
import spire.http.headers { header_content_type, header_content_length, header_accept }
import spire.http.headers { header_authorization, header_cookie, header_set_cookie }
import spire.http.headers { header_location, header_host, header_user_agent }
import spire.http.headers { content_type_html, content_type_json, content_type_text }

# ============================================================================
# headers_new tests
# ============================================================================

[[test]]
fn test_headers_new_is_empty() -> i32
    var h: Headers = headers_new()
    assert headers_len(@h) == 0
    0

# ============================================================================
# headers_add tests
# ============================================================================

[[test]]
fn test_headers_add_single() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"application/json")
    headers_add(@h, @name, @value)
    assert headers_len(@h) == 1
    var got: Span<u8>
    assert headers_get(@h, @name, @got) == 1
    assert span_eq_cstr(@got, c"application/json")
    0

[[test]]
fn test_headers_add_multiple() -> i32
    var h: Headers = headers_new()
    let ct_name: Span<u8> = span_from_cstr(c"Content-Type")
    let ct_value: Span<u8> = span_from_cstr(c"application/json")
    let cl_name: Span<u8> = span_from_cstr(c"Content-Length")
    let cl_value: Span<u8> = span_from_cstr(c"42")
    headers_add(@h, @ct_name, @ct_value)
    headers_add(@h, @cl_name, @cl_value)
    assert headers_len(@h) == 2
    var got: Span<u8>
    assert headers_get(@h, @cl_name, @got) == 1
    assert span_eq_cstr(@got, c"42")
    0

[[test]]
fn test_headers_add_duplicate_name_allowed() -> i32
    # HTTP allows multiple headers with same name (e.g., Set-Cookie)
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"Set-Cookie")
    let val1: Span<u8> = span_from_cstr(c"session=abc123")
    let val2: Span<u8> = span_from_cstr(c"tracking=xyz789")
    headers_add(@h, @name, @val1)
    headers_add(@h, @name, @val2)
    assert headers_len(@h) == 2
    # Lookup returns the first one added
    var got: Span<u8>
    assert headers_get(@h, @name, @got) == 1
    assert span_eq_cstr(@got, c"session=abc123")
    0

# ============================================================================
# headers_set tests
# ============================================================================

[[test]]
fn test_headers_set_new_header() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"text/html")
    headers_set(@h, @name, @value)
    assert headers_len(@h) == 1
    0

[[test]]
fn test_headers_set_replaces_existing() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let val1: Span<u8> = span_from_cstr(c"text/html")
    let val2: Span<u8> = span_from_cstr(c"application/json")
    headers_set(@h, @name, @val1)
    headers_set(@h, @name, @val2)
    # Should still be 1 header, not 2
    assert headers_len(@h) == 1
    # And the value should be the new one
    var got: Span<u8>
    assert headers_get(@h, @name, @got) == 1
    assert span_eq_cstr(@got, c"application/json")
    0

# ============================================================================
# headers_get / headers_contains tests
# ============================================================================

[[test]]
fn test_headers_get_existing() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"X-Custom")
    let value: Span<u8> = span_from_cstr(c"custom-value")
    headers_add(@h, @name, @value)
    var got: Span<u8>
    assert headers_get(@h, @name, @got) == 1
    assert span_eq_cstr(@got, c"custom-value")
    0

[[test]]
fn test_headers_get_not_found() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"X-Missing")
    var got: Span<u8>
    assert headers_get(@h, @name, @got) == 0
    assert headers_contains(@h, @name) == 0
    0

[[test]]
fn test_headers_get_case_insensitive() -> i32
    # HTTP header names are case-insensitive (RFC 9110 §5.1)
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"Content-Type")
    let value: Span<u8> = span_from_cstr(c"text/plain")
    headers_add(@h, @name, @value)
    let lower_name: Span<u8> = span_from_cstr(c"content-type")
    var got: Span<u8>
    assert headers_get(@h, @lower_name, @got) == 1
    assert span_eq_cstr(@got, c"text/plain")
    assert headers_contains(@h, @lower_name) == 1
    0

# ============================================================================
# headers_remove tests
# ============================================================================

[[test]]
fn test_headers_remove_existing() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"X-Remove-Me")
    let value: Span<u8> = span_from_cstr(c"gone")
    headers_add(@h, @name, @value)
    assert headers_len(@h) == 1
    headers_remove(@h, @name)
    assert headers_len(@h) == 0
    0

[[test]]
fn test_headers_remove_keeps_others() -> i32
    var h: Headers = headers_new()
    let a: Span<u8> = span_from_cstr(c"X-A")
    let b: Span<u8> = span_from_cstr(c"X-B")
    let v: Span<u8> = span_from_cstr(c"v")
    headers_add(@h, @a, @v)
    headers_add(@h, @b, @v)
    headers_add(@h, @a, @v)
    headers_remove(@h, @a)
    assert headers_len(@h) == 1
    assert headers_contains(@h, @b) == 1
    assert headers_contains(@h, @a) == 0
    0

[[test]]
fn test_headers_remove_not_found() -> i32
    var h: Headers = headers_new()
    let name: Span<u8> = span_from_cstr(c"X-Missing")
    # Should not crash when removing non-existent header
    headers_remove(@h, @name)
    assert headers_len(@h) == 0
    0

# ============================================================================
# Header name constants tests
# ============================================================================

[[test]]
fn test_header_content_type_value() -> i32
    let ct: Span<u8> = header_content_type()
    assert span_eq_cstr(@ct, c"Content-Type")
    0

[[test]]
fn test_header_content_length_value() -> i32
    let cl: Span<u8> = header_content_length()
    assert span_eq_cstr(@cl, c"Content-Length")
    0

[[test]]
fn test_header_accept_value() -> i32
    let a: Span<u8> = header_accept()
    assert span_eq_cstr(@a, c"Accept")
    0

[[test]]
fn test_header_name_constants() -> i32
    let auth: Span<u8> = header_authorization()
    assert span_eq_cstr(@auth, c"Authorization")
    let cookie: Span<u8> = header_cookie()
    assert span_eq_cstr(@cookie, c"Cookie")
    let set_cookie: Span<u8> = header_set_cookie()
    assert span_eq_cstr(@set_cookie, c"Set-Cookie")
    let loc: Span<u8> = header_location()
    assert span_eq_cstr(@loc, c"Location")
    let host: Span<u8> = header_host()
    assert span_eq_cstr(@host, c"Host")
    let ua: Span<u8> = header_user_agent()
    assert span_eq_cstr(@ua, c"User-Agent")
    0

# ============================================================================
# Content type constants tests
# ============================================================================

[[test]]
fn test_content_type_json_value() -> i32
    let ct: Span<u8> = content_type_json()
    assert span_eq_cstr(@ct, c"application/json")
    0

[[test]]
fn test_content_type_html_value() -> i32
    let ct: Span<u8> = content_type_html()
    assert span_eq_cstr(@ct, c"text/html; charset=utf-8")
    0

[[test]]
fn test_content_type_text_value() -> i32
    let ct: Span<u8> = content_type_text()
    assert span_eq_cstr(@ct, c"text/plain; charset=utf-8")
    0
