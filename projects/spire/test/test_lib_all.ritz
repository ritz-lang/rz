# spire/test/test_lib_all.ritz
#
# Every spire lib module in one program (#2024, #2424). Modules nothing
# imported went uncompiled for months (lib/form, lib/presenter and
# lib/middleware), and since #2148 two modules defining the same private
# helper conflict only when compiled together. Importing them all here keeps
# each module compiling and the set free of duplicate definitions.

import spire.mod
import spire.utils
import spire.app.mod
import spire.cli.mod
import spire.form.mod
import spire.http.mod
import spire.http.headers
import spire.http.request
import spire.http.response
import spire.json.mod
import spire.middleware.mod
import spire.model.mod
import spire.model.timestamp
import spire.model.uuid
import spire.presenter.mod
import spire.repo.mod
import spire.repo.mausoleum
import spire.repo.tome
import spire.router.mod
import spire.service.mod

import ritzlib.strview { StrView, strview_eq }
import ritzlib.string { String, string_as_view }

# One call through form, service, json and presenter together
[[test]]
fn test_lib_all_modules_link() -> i32
    let form: FormData = form_parse("email=nope")
    var errors: ValidationErrors = validation_errors_new()
    validate_email(@&errors, "email", form_get(@form, "email"))
    assert validation_error_count(@errors) == 1
    let resp: Response = present_error(service_validation_error(errors))
    assert response_status(@resp) == 422
    0
