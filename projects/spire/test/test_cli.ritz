# spire/test/test_cli.ritz
#
# spire CLI argument parsing over Span<StrView> (AGAST #4565). Each test
# builds the argument list the way `fn main(args: Span<StrView>)` receives
# it (args[0] is the program name) and checks the parsed Command.

import ritzlib.strview { StrView }
import ritzlib.string { String }
import ritzlib.span { Span, span_empty }

import spire.cli.mod { Command, TestOptions, ServeOptions, GenerateOptions, GenerateKind, parse_args }
import spire.utils { string_as_strview }

[[test]]
fn test_cli_no_args_is_help() -> i32
    match parse_args(span_empty<StrView>())
        Help => pass
        _ =>
            assert false, "empty args should be Help"
    var a: [1]StrView
    a[0] = "spire"
    match parse_args(Span<StrView> { ptr: @a[0], len: 1 })
        Help => pass
        _ =>
            assert false, "program name alone should be Help"
    0

[[test]]
fn test_cli_test_filter_verbose() -> i32
    var a: [5]StrView
    a[0] = "spire"
    a[1] = "test"
    a[2] = "-f"
    a[3] = "foo"
    a[4] = "-v"
    match parse_args(Span<StrView> { ptr: @a[0], len: 5 })
        Test(opts) =>
            assert opts.verbose == 1, "verbose"
            assert opts.quiet == 0, "quiet"
            assert opts.timeout_ms == 5000, "default timeout"
            match opts.filter
                Some(pattern) =>
                    assert (string_as_strview(@pattern)).eq("foo"), "filter"
                None =>
                    assert false, "filter missing"
        _ =>
            assert false, "expected Test"
    0

[[test]]
fn test_cli_test_timeout() -> i32
    var a: [4]StrView
    a[0] = "spire"
    a[1] = "test"
    a[2] = "--timeout"
    a[3] = "250"
    match parse_args(Span<StrView> { ptr: @a[0], len: 4 })
        Test(opts) =>
            assert opts.timeout_ms == 250, "timeout"
            assert opts.verbose == 0, "verbose"
        _ =>
            assert false, "expected Test"
    0

[[test]]
fn test_cli_serve_port() -> i32
    var a: [4]StrView
    a[0] = "spire"
    a[1] = "serve"
    a[2] = "-p"
    a[3] = "8080"
    match parse_args(Span<StrView> { ptr: @a[0], len: 4 })
        Serve(opts) =>
            assert opts.port == 8080, "port"
            assert (string_as_strview(@opts.host)).eq("127.0.0.1"), "default host"
            assert opts.reload == 1, "default reload"
        _ =>
            assert false, "expected Serve"
    0

[[test]]
fn test_cli_serve_bad_port_keeps_default() -> i32
    var a: [4]StrView
    a[0] = "spire"
    a[1] = "serve"
    a[2] = "--port"
    a[3] = "80x"
    match parse_args(Span<StrView> { ptr: @a[0], len: 4 })
        Serve(opts) =>
            assert opts.port == 8000, "invalid port keeps default"
        _ =>
            assert false, "expected Serve"
    0

[[test]]
fn test_cli_gen_model() -> i32
    var a: [4]StrView
    a[0] = "spire"
    a[1] = "gen"
    a[2] = "model"
    a[3] = "User"
    match parse_args(Span<StrView> { ptr: @a[0], len: 4 })
        Generate(opts) =>
            match opts.kind
                Model => pass
                _ =>
                    assert false, "expected Model"
            assert (string_as_strview(@opts.name)).eq("User"), "name"
        _ =>
            assert false, "expected Generate"
    0

[[test]]
fn test_cli_simple_commands() -> i32
    var a: [2]StrView
    a[0] = "spire"
    a[1] = "routes"
    match parse_args(Span<StrView> { ptr: @a[0], len: 2 })
        Routes => pass
        _ =>
            assert false, "expected Routes"
    a[1] = "--version"
    match parse_args(Span<StrView> { ptr: @a[0], len: 2 })
        Version => pass
        _ =>
            assert false, "expected Version"
    a[1] = "bogus"
    match parse_args(Span<StrView> { ptr: @a[0], len: 2 })
        Unknown(name) =>
            assert (string_as_strview(@name)).eq("bogus"), "unknown name"
        _ =>
            assert false, "expected Unknown"
    0
