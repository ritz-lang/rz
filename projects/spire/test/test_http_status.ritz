# spire/test/test_http_status.ritz
#
# Tests for HTTP status codes and class helpers, via spire's public http
# surface (re-exported from the `http` package's types module).

import ritzlib.span

import spire.http.mod { STATUS_OK, STATUS_CREATED, STATUS_NO_CONTENT }
import spire.http.mod { STATUS_MOVED_PERMANENTLY, STATUS_FOUND, STATUS_SEE_OTHER }
import spire.http.mod { STATUS_BAD_REQUEST, STATUS_UNAUTHORIZED, STATUS_FORBIDDEN }
import spire.http.mod { STATUS_NOT_FOUND, STATUS_CONFLICT, STATUS_UNPROCESSABLE_ENTITY }
import spire.http.mod { STATUS_INTERNAL_SERVER_ERROR }
import spire.http.mod { status_reason, status_is_success, status_is_redirect, status_is_client_error, status_is_server_error }

fn is_error(code: i32) -> i32
    if status_is_client_error(code) == 1 || status_is_server_error(code) == 1
        return 1
    0

fn reason_is(code: i32, expected: *u8) -> bool
    var r: Span<u8> = status_reason(code)
    span_eq_cstr(@r, expected)

# ============================================================================
# Status constant tests
# ============================================================================

[[test]]
fn test_status_ok_code() -> i32
    assert STATUS_OK == 200
    0

[[test]]
fn test_status_created_code() -> i32
    assert STATUS_CREATED == 201
    0

[[test]]
fn test_status_no_content_code() -> i32
    assert STATUS_NO_CONTENT == 204
    0

[[test]]
fn test_status_moved_permanently_code() -> i32
    assert STATUS_MOVED_PERMANENTLY == 301
    0

[[test]]
fn test_status_found_code() -> i32
    assert STATUS_FOUND == 302
    0

[[test]]
fn test_status_see_other_code() -> i32
    assert STATUS_SEE_OTHER == 303
    0

[[test]]
fn test_status_bad_request_code() -> i32
    assert STATUS_BAD_REQUEST == 400
    0

[[test]]
fn test_status_unauthorized_code() -> i32
    assert STATUS_UNAUTHORIZED == 401
    0

[[test]]
fn test_status_forbidden_code() -> i32
    assert STATUS_FORBIDDEN == 403
    0

[[test]]
fn test_status_not_found_code() -> i32
    assert STATUS_NOT_FOUND == 404
    0

[[test]]
fn test_status_conflict_code() -> i32
    assert STATUS_CONFLICT == 409
    0

[[test]]
fn test_status_unprocessable_entity_code() -> i32
    assert STATUS_UNPROCESSABLE_ENTITY == 422
    0

[[test]]
fn test_status_internal_server_error_code() -> i32
    assert STATUS_INTERNAL_SERVER_ERROR == 500
    0

# ============================================================================
# status_reason tests (code -> known status)
# ============================================================================

[[test]]
fn test_status_from_code_200() -> i32
    assert reason_is(200, c"OK")
    0

[[test]]
fn test_status_from_code_404() -> i32
    assert reason_is(404, c"Not Found")
    0

[[test]]
fn test_status_from_code_500() -> i32
    assert reason_is(500, c"Internal Server Error")
    0

# ============================================================================
# status_is_success tests
# ============================================================================

[[test]]
fn test_200_is_success() -> i32
    assert status_is_success(STATUS_OK) == 1
    0

[[test]]
fn test_201_is_success() -> i32
    assert status_is_success(STATUS_CREATED) == 1
    0

[[test]]
fn test_204_is_success() -> i32
    assert status_is_success(STATUS_NO_CONTENT) == 1
    0

[[test]]
fn test_301_is_not_success() -> i32
    assert status_is_success(STATUS_MOVED_PERMANENTLY) == 0
    0

[[test]]
fn test_400_is_not_success() -> i32
    assert status_is_success(STATUS_BAD_REQUEST) == 0
    0

[[test]]
fn test_500_is_not_success() -> i32
    assert status_is_success(STATUS_INTERNAL_SERVER_ERROR) == 0
    0

# ============================================================================
# status_is_redirect tests
# ============================================================================

[[test]]
fn test_301_is_redirect() -> i32
    assert status_is_redirect(STATUS_MOVED_PERMANENTLY) == 1
    0

[[test]]
fn test_302_is_redirect() -> i32
    assert status_is_redirect(STATUS_FOUND) == 1
    0

[[test]]
fn test_303_is_redirect() -> i32
    assert status_is_redirect(STATUS_SEE_OTHER) == 1
    0

[[test]]
fn test_200_is_not_redirect() -> i32
    assert status_is_redirect(STATUS_OK) == 0
    0

[[test]]
fn test_404_is_not_redirect() -> i32
    assert status_is_redirect(STATUS_NOT_FOUND) == 0
    0

# ============================================================================
# status error (client_error || server_error) tests
# ============================================================================

[[test]]
fn test_400_is_error() -> i32
    assert is_error(STATUS_BAD_REQUEST) == 1
    0

[[test]]
fn test_401_is_error() -> i32
    assert is_error(STATUS_UNAUTHORIZED) == 1
    0

[[test]]
fn test_403_is_error() -> i32
    assert is_error(STATUS_FORBIDDEN) == 1
    0

[[test]]
fn test_404_is_error() -> i32
    assert is_error(STATUS_NOT_FOUND) == 1
    0

[[test]]
fn test_500_is_error() -> i32
    assert is_error(STATUS_INTERNAL_SERVER_ERROR) == 1
    0

[[test]]
fn test_200_is_not_error() -> i32
    assert is_error(STATUS_OK) == 0
    0

[[test]]
fn test_201_is_not_error() -> i32
    assert is_error(STATUS_CREATED) == 0
    0

[[test]]
fn test_302_is_not_error() -> i32
    assert is_error(STATUS_FOUND) == 0
    0
