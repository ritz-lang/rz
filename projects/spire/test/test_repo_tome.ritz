# spire/test/test_repo_tome.ritz
#
# Tests for the tome repo adapter (embedded mode).  TCP mode is wired
# but its per-op path returns CACHE_ERR_NOT_IMPLEMENTED until binary-
# safe RESP framing helpers land in tome.client; the embedded mode is
# the one we exercise here.

import ritzlib.strview { StrView, strview_empty }
import ritzlib.option { Option }
import ritzlib.result { Result }

import spire.repo.tome { Cache, cache_new }
import spire.repo.tome { cache_init_embedded, cache_init_tcp, cache_connect, cache_close }
import spire.repo.tome { cache_set, cache_setex, cache_get, cache_del }
import spire.repo.tome { cache_exists, cache_expire, cache_ttl, cache_persist }
import spire.repo.tome { cache_is_connected, cache_mode, cache_len, cache_memory_usage }
import spire.repo.tome { CACHE_MODE_EMBEDDED, CACHE_MODE_TCP }
import spire.repo.tome { CACHE_OK, CACHE_ERR_NOT_INITIALIZED, CACHE_ERR_NOT_IMPLEMENTED }

# ============================================================================
# Initialization
# ============================================================================

[[test]]
fn test_embedded_init_sets_mode() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)
    if cache_mode(@c) != CACHE_MODE_EMBEDDED
        cache_close(@c)
        return -1
    if cache_is_connected(@c) != 1
        cache_close(@c)
        return -2
    cache_close(@c)
    0

[[test]]
fn test_tcp_init_sets_mode() -> i32
    var c = cache_new()
    let host: StrView = "127.0.0.1"
    cache_init_tcp(@c, host, 6379)
    if cache_mode(@c) != CACHE_MODE_TCP
        return -1
    # cache_connect is allowed to fail with NOT_IMPLEMENTED here — the
    # TCP send path isn't wired yet.  We just want to confirm the
    # struct held the mode + initialization fields.
    cache_close(@c)
    0

[[test]]
fn test_ops_before_connect_return_not_initialized() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    # Deliberately do NOT call cache_connect.
    let key: StrView = "foo"
    let val: StrView = "bar"
    let rc: i32 = cache_set(@c, key, val)
    if rc != CACHE_ERR_NOT_INITIALIZED
        return -1
    0

# ============================================================================
# Basic CRUD on the embedded backend
# ============================================================================

# cache_get's value on a hit; an empty view on a miss or an error.
fn hit_or_empty(c: *Cache, key: StrView) -> StrView
    match cache_get(c, key)
        Ok(found) =>
            match found
                Some(v) => v
                None => strview_empty()
        Err(_) => strview_empty()

[[test]]
fn test_embedded_set_then_get_round_trips() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "hello"
    let val: StrView = "world"
    let set_rc: i32 = cache_set(@c, key, val)
    if set_rc != CACHE_OK
        cache_close(@c)
        return -1

    # The hit is a view into the store: check it before cache_close clears it.
    let hit: StrView = hit_or_empty(@c, key)
    var rc: i32 = 0
    if hit.is_empty()
        rc = -2
    else if not hit.eq("world")
        rc = -3
    cache_close(@c)
    rc

[[test]]
fn test_embedded_get_miss_returns_none() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "never-set"
    let got: Result<Option<StrView>, i32> = cache_get(@c, key)
    cache_close(@c)
    match got
        Ok(found) =>
            if found.is_some()
                return -2
            0
        Err(_) => -1

[[test]]
fn test_embedded_del_removes_key() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "k1"
    let val: StrView = "v1"
    cache_set(@c, key, val)

    if cache_exists(@c, key) != 1
        cache_close(@c)
        return -1
    let del_rc: i32 = cache_del(@c, key)
    if del_rc != 1
        cache_close(@c)
        return -2
    if cache_exists(@c, key) != 0
        cache_close(@c)
        return -3

    cache_close(@c)
    0

[[test]]
fn test_embedded_overwrite_replaces_value() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "k"
    let v1: StrView = "first"
    let v2: StrView = "updated"
    cache_set(@c, key, v1)
    cache_set(@c, key, v2)

    let ok: bool = hit_or_empty(@c, key).eq("updated")
    cache_close(@c)

    if not ok
        return -1
    0

# ============================================================================
# Binary-safe values (key thing — Redis-clone reason for being)
# ============================================================================

# NOTE: a `test_embedded_value_is_binary_safe` test (with a value
# containing embedded NULs) is intentionally NOT included here yet.
# Tome's `string_from_bytes` / `string_as_ptr` / `string_len` chain is
# binary-safe at the type level, so functionally the property holds —
# but a sharper test exercising it through the spire wrapper exposed an
# inconsistent build (ritz0 emitting partial .ll files on certain
# `*u8` arithmetic patterns).  Tracked as a follow-up wedge; the other
# tests below already cover the API surface.

# ============================================================================
# TTL
# ============================================================================

[[test]]
fn test_embedded_setex_yields_positive_ttl() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "ephemeral"
    let val: StrView = "v"
    cache_setex(@c, key, val, 60)

    let ttl: i64 = cache_ttl(@c, key)
    cache_close(@c)
    if ttl <= 0
        return -1
    if ttl > 60
        return -2
    0

[[test]]
fn test_embedded_persist_strips_ttl() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "persistme"
    let val: StrView = "x"
    cache_setex(@c, key, val, 60)
    if cache_persist(@c, key) != 1
        cache_close(@c)
        return -1

    let ttl: i64 = cache_ttl(@c, key)
    cache_close(@c)
    # tome convention: -1 = no TTL set
    if ttl != -1
        return -2
    0

[[test]]
fn test_embedded_expire_on_existing_key() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "perm"
    let val: StrView = "v"
    cache_set(@c, key, val)

    let rc: i32 = cache_expire(@c, key, 30)
    if rc != 1
        cache_close(@c)
        return -1

    let ttl: i64 = cache_ttl(@c, key)
    cache_close(@c)
    if ttl <= 0
        return -2
    if ttl > 30
        return -3
    0

[[test]]
fn test_embedded_expire_on_missing_key_returns_zero() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let key: StrView = "ghost"
    let rc: i32 = cache_expire(@c, key, 30)
    cache_close(@c)
    if rc != 0
        return -1
    0

# ============================================================================
# Stats helpers (embedded only)
# ============================================================================

[[test]]
fn test_embedded_len_tracks_inserts() -> i32
    var c = cache_new()
    cache_init_embedded(@c, 0)
    cache_connect(@c)

    let k1: StrView = "a"
    let k2: StrView = "b"
    let v: StrView = "x"
    cache_set(@c, k1, v)
    cache_set(@c, k2, v)
    let n: i64 = cache_len(@c)
    cache_close(@c)
    if n != 2
        return -1
    0

# ============================================================================
# TCP mode structurally returns NOT_IMPLEMENTED on per-op (until the
# binary-safe RESP framing helpers land).
# ============================================================================

[[test]]
fn test_tcp_set_returns_not_implemented_until_wired() -> i32
    var c = cache_new()
    let host: StrView = "127.0.0.1"
    cache_init_tcp(@c, host, 6379)
    # cache_connect on TCP intentionally returns NOT_IMPLEMENTED
    # without dialing — but it leaves the struct in a state where
    # operations should still surface NOT_INITIALIZED (because connected
    # didn't transition to 1).  This test pins down that contract so a
    # future TCP wire-up doesn't silently regress.
    let key: StrView = "x"
    let val: StrView = "y"
    let rc: i32 = cache_set(@c, key, val)
    cache_close(@c)
    if rc != CACHE_ERR_NOT_INITIALIZED
        return -1
    0

# ============================================================================
# A never-initialized Cache drops cleanly (AGAST #4023)
# ============================================================================

# cache_init_tcp never writes `store`.  A Cache built from `var c: Cache` and
# returned carried stack bytes there, and the caller's binding dropped them as a
# tome Store, freeing a garbage `entries`.  dirty_stack fills the stack with
# 0xAA first, so an unwritten field always reads non-null.
[[noinline]]
fn dirty_stack() -> i32
    var d: [8192]u8 = [0; 8192]
    var i: i32 = 0
    while i < 8192
        volatile_store(@d[i], 170)
        i = i + 1
    volatile_load(@d[77]) as i32

[[noinline]]
fn tcp_cache() -> Cache
    var c = cache_new()
    cache_init_tcp(@c, "127.0.0.1", 6379)
    c

[[noinline]]
fn tcp_cache_mode() -> i32
    var c = tcp_cache()
    cache_mode(@c)

[[test]]
fn test_tcp_cache_on_a_dirty_stack_drops_cleanly() -> i32
    dirty_stack()
    if tcp_cache_mode() != CACHE_MODE_TCP
        return -1
    0

[[noinline]]
fn new_cache_connected() -> i32
    var c = cache_new()
    cache_is_connected(@c)

[[test]]
fn test_new_cache_is_not_initialized_or_connected() -> i32
    dirty_stack()
    if new_cache_connected() != 0
        return -1
    var c = cache_new()
    if cache_connect(@c) != CACHE_ERR_NOT_INITIALIZED
        return -2
    0
