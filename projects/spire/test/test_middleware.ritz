# spire/test/test_middleware.ritz
#
# Tests for middleware helpers (lib/middleware): CORS, request logging,
# auth, security and rate-limit headers, request IDs. Until #2424 nothing
# imported lib/middleware, so its parse error went unseen.

import ritzlib.option
import ritzlib.strview { StrView, strview_eq }
import ritzlib.string { String, string_as_view }
import ritzlib.span { Span, span_from_cstr, span_eq_cstr }

import http.types { METHOD_GET, METHOD_OPTIONS, STATUS_NO_CONTENT, STATUS_UNAUTHORIZED }
import spire.http.request { Request, request_new, request_with, request_set_header }
import spire.http.response { Response, response_ok, response_status, response_body }
import spire.http.response { response_header_count, response_header_name, response_header_value }
import spire.middleware.mod { CorsConfig, cors_config_default, cors_config_restrictive }
import spire.middleware.mod { cors_apply, cors_preflight, is_preflight }
import spire.middleware.mod { RequestLog, request_log_new, request_log_complete }
import spire.middleware.mod { request_log_format, request_log_json }
import spire.middleware.mod { AuthResult, auth_check, auth_is_authenticated, auth_user_id }
import spire.middleware.mod { auth_unauthorized_response }
import spire.middleware.mod { security_headers_apply, security_headers_strict }
import spire.middleware.mod { rate_limit_headers, get_request_id, set_response_request_id }

fn header_is(resp: *Response, name: *u8, expected: *u8) -> bool
    var i: i64 = 0
    while i < response_header_count(resp)
        var n: Span<u8> = response_header_name(resp, i)
        if span_eq_cstr(@n, name)
            var v: Span<u8> = response_header_value(resp, i)
            return span_eq_cstr(@v, expected)
        i += 1
    return false

fn get_request(path: *u8) -> Request
    let p: Span<u8> = span_from_cstr(path)
    return request_with(METHOD_GET, @p)

fn add_header(req: *Request, name: *u8, value: *u8)
    let n: Span<u8> = span_from_cstr(name)
    let v: Span<u8> = span_from_cstr(value)
    request_set_header(req, @n, @v)

# ============================================================================
# CORS
# ============================================================================

[[test]]
fn test_cors_apply_default() -> i32
    let cfg: CorsConfig = cors_config_default()
    var resp: Response = response_ok()
    cors_apply(@resp, @cfg)
    assert header_is(@resp, "Access-Control-Allow-Origin", "*")
    assert response_header_count(@resp) == 3
    0

[[test]]
fn test_cors_apply_restrictive() -> i32
    let cfg: CorsConfig = cors_config_restrictive("https://a.example")
    var resp: Response = response_ok()
    cors_apply(@resp, @cfg)
    assert header_is(@resp, "Access-Control-Allow-Origin", "https://a.example")
    assert header_is(@resp, "Access-Control-Allow-Credentials", "true")
    0

[[test]]
fn test_cors_preflight() -> i32
    let cfg: CorsConfig = cors_config_default()
    let resp: Response = cors_preflight(@cfg)
    assert response_status(@resp) == STATUS_NO_CONTENT
    assert header_is(@resp, "Access-Control-Max-Age", "86400")
    0

[[test]]
fn test_is_preflight() -> i32
    let p: Span<u8> = "/x"
    let opt: Request = request_with(METHOD_OPTIONS, @p)
    let get: Request = request_with(METHOD_GET, @p)
    assert is_preflight(@opt) == 1
    assert is_preflight(@get) == 0
    0

# ============================================================================
# Request logging
# ============================================================================

[[test]]
fn test_request_log_format() -> i32
    var req: Request = get_request("/tasks")
    add_header(@req, "User-Agent", "curl")
    var log: RequestLog = request_log_new(@req)
    assert strview_eq(string_as_view(@log.user_agent), "curl")
    assert strview_eq(string_as_view(@log.client_ip), "unknown")
    let resp: Response = response_ok()
    request_log_complete(@&log, @resp, 1234)
    let text: String = request_log_format(@log)
    assert strview_eq(string_as_view(@text), "GET /tasks 200 1234us")
    0

[[test]]
fn test_request_log_json_escapes() -> i32
    let req: Request = get_request("/a\"b")
    var log: RequestLog = request_log_new(@req)
    let resp: Response = response_ok()
    request_log_complete(@&log, @resp, 5)
    let json: String = request_log_json(@log)
    assert strview_eq(string_as_view(@json), "{\"method\":\"GET\",\"path\":\"/a\\\"b\",\"status\":200,\"duration_us\":5}")
    0

# ============================================================================
# Auth
# ============================================================================

[[test]]
fn test_auth_bearer() -> i32
    var req: Request = get_request("/")
    add_header(@req, "Authorization", "Bearer user-42")
    let result: AuthResult = auth_check(@req)
    assert auth_is_authenticated(@result) == 1
    let ok: bool = match auth_user_id(@result)
        Some(id) => strview_eq(id, "user-42")
        None => false
    assert ok
    0

[[test]]
fn test_auth_missing_and_invalid() -> i32
    let none: Request = get_request("/")
    let missing: AuthResult = auth_check(@none)
    assert auth_is_authenticated(@missing) == 0
    var basic: Request = get_request("/")
    add_header(@basic, "Authorization", "Basic abcdefgh")
    let invalid: AuthResult = auth_check(@basic)
    assert auth_is_authenticated(@invalid) == 0
    0

[[test]]
fn test_auth_unauthorized_response() -> i32
    let resp: Response = auth_unauthorized_response()
    assert response_status(@resp) == STATUS_UNAUTHORIZED
    assert header_is(@resp, "Content-Type", "application/json")
    var b: Span<u8> = response_body(@resp)
    assert span_eq_cstr(@b, "{\"error\":\"Unauthorized\"}")
    0

# ============================================================================
# Headers
# ============================================================================

[[test]]
fn test_security_headers() -> i32
    var resp: Response = response_ok()
    security_headers_strict(@resp)
    assert header_is(@resp, "X-Frame-Options", "DENY")
    assert header_is(@resp, "Strict-Transport-Security", "max-age=31536000; includeSubDomains")
    assert response_header_count(@resp) == 6
    0

[[test]]
fn test_rate_limit_headers() -> i32
    var resp: Response = response_ok()
    rate_limit_headers(@resp, 100, -1, 1700000000)
    assert header_is(@resp, "X-RateLimit-Limit", "100")
    assert header_is(@resp, "X-RateLimit-Remaining", "-1")
    assert header_is(@resp, "X-RateLimit-Reset", "1700000000")
    0

[[test]]
fn test_request_id() -> i32
    var req: Request = get_request("/")
    assert strview_eq(get_request_id(@req), "req-000000")
    add_header(@req, "X-Request-ID", "abc")
    let id: StrView = get_request_id(@req)
    assert strview_eq(id, "abc")
    var resp: Response = response_ok()
    set_response_request_id(@resp, id)
    assert header_is(@resp, "X-Request-ID", "abc")
    0
