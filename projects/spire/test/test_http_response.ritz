# spire/test/test_http_response.ritz
#
# Tests for HTTP Response type

import ritzlib.span { Span, span_from_cstr, span_eq }

import spire.http.mod { STATUS_OK, STATUS_CREATED, STATUS_NOT_FOUND }
import spire.http.mod { Response, response_ok, response_created }
import spire.http.mod { response_bad_request, response_unauthorized, response_forbidden }
import spire.http.mod { response_not_found, response_internal_error }
import spire.http.mod { response_html, response_json_str, response_text }
import spire.http.mod { response_redirect, response_redirect_permanent }
import spire.http.response { response_status, response_body_len }
import spire.http.response { response_header_count, response_header_name, response_header_value }

# Look up a response header by exact name.
# Returns 1 and writes out_value if found, 0 otherwise.
fn find_header(resp: *Response, name: *Span<u8>, out_value: *Span<u8>) -> i32
    var i: i64 = 0
    while i < response_header_count(resp)
        let n: Span<u8> = response_header_name(resp, i)
        if span_eq(@n, name)
            let v: Span<u8> = response_header_value(resp, i)
            out_value.ptr = v.ptr
            out_value.len = v.len
            return 1
        i += 1
    return 0

# ============================================================================
# Constructor tests
# ============================================================================

[[test]]
fn test_response_ok_status_code() -> i32
    var resp: Response = response_ok()
    assert response_status(@resp) == 200
    assert response_status(@resp) == STATUS_OK
    0

[[test]]
fn test_response_created_status_code() -> i32
    var resp: Response = response_created()
    assert response_status(@resp) == 201
    assert response_status(@resp) == STATUS_CREATED
    0

[[test]]
fn test_response_bad_request_status_code() -> i32
    var resp: Response = response_bad_request()
    assert response_status(@resp) == 400
    0

[[test]]
fn test_response_unauthorized_status_code() -> i32
    var resp: Response = response_unauthorized()
    assert response_status(@resp) == 401
    0

[[test]]
fn test_response_forbidden_status_code() -> i32
    var resp: Response = response_forbidden()
    assert response_status(@resp) == 403
    0

[[test]]
fn test_response_not_found_status_code() -> i32
    var resp: Response = response_not_found()
    assert response_status(@resp) == 404
    assert response_status(@resp) == STATUS_NOT_FOUND
    0

[[test]]
fn test_response_internal_error_status_code() -> i32
    var resp: Response = response_internal_error()
    assert response_status(@resp) == 500
    0

# ============================================================================
# Body tests
# ============================================================================

[[test]]
fn test_response_new_body_is_empty() -> i32
    var resp: Response = response_ok()
    assert response_body_len(@resp) == 0
    0

[[test]]
fn test_response_html_sets_content_type() -> i32
    let html: Span<u8> = span_from_cstr(c"<h1>Hello</h1>")
    var resp: Response = response_html(@html)
    let ct_name: Span<u8> = span_from_cstr(c"Content-Type")
    var ct: Span<u8>
    assert find_header(@resp, @ct_name, @ct) == 1
    let expected: Span<u8> = span_from_cstr(c"text/html; charset=utf-8")
    assert span_eq(@ct, @expected)
    0

[[test]]
fn test_response_html_sets_body() -> i32
    let html: Span<u8> = span_from_cstr(c"<h1>Hello</h1>")
    var resp: Response = response_html(@html)
    assert response_body_len(@resp) == html.len
    0

[[test]]
fn test_response_json_str_sets_content_type() -> i32
    let json: Span<u8> = span_from_cstr(c"{\"key\": \"value\"}")
    var resp: Response = response_json_str(@json)
    let ct_name: Span<u8> = span_from_cstr(c"Content-Type")
    var ct: Span<u8>
    assert find_header(@resp, @ct_name, @ct) == 1
    let expected: Span<u8> = span_from_cstr(c"application/json")
    assert span_eq(@ct, @expected)
    0

[[test]]
fn test_response_json_str_sets_body() -> i32
    let json: Span<u8> = span_from_cstr(c"{\"key\": \"value\"}")
    var resp: Response = response_json_str(@json)
    assert response_body_len(@resp) == json.len
    0

[[test]]
fn test_response_text_sets_content_type() -> i32
    let text: Span<u8> = span_from_cstr(c"Hello, World!")
    var resp: Response = response_text(@text)
    let ct_name: Span<u8> = span_from_cstr(c"Content-Type")
    var ct: Span<u8>
    assert find_header(@resp, @ct_name, @ct) == 1
    let expected: Span<u8> = span_from_cstr(c"text/plain; charset=utf-8")
    assert span_eq(@ct, @expected)
    0

# ============================================================================
# Redirect tests
# ============================================================================

[[test]]
fn test_response_redirect_status_code() -> i32
    let location: Span<u8> = span_from_cstr(c"/new-location")
    var resp: Response = response_redirect(@location)
    assert response_status(@resp) == 302
    0

[[test]]
fn test_response_redirect_sets_location() -> i32
    let location: Span<u8> = span_from_cstr(c"/new-location")
    var resp: Response = response_redirect(@location)
    let loc_name: Span<u8> = span_from_cstr(c"Location")
    var loc: Span<u8>
    assert find_header(@resp, @loc_name, @loc) == 1
    assert span_eq(@loc, @location)
    0

[[test]]
fn test_response_redirect_permanent_status_code() -> i32
    let location: Span<u8> = span_from_cstr(c"/permanent-location")
    var resp: Response = response_redirect_permanent(@location)
    assert response_status(@resp) == 301
    0

[[test]]
fn test_response_redirect_permanent_sets_location() -> i32
    let location: Span<u8> = span_from_cstr(c"/permanent-location")
    var resp: Response = response_redirect_permanent(@location)
    let loc_name: Span<u8> = span_from_cstr(c"Location")
    var loc: Span<u8>
    assert find_header(@resp, @loc_name, @loc) == 1
    assert span_eq(@loc, @location)
    0
