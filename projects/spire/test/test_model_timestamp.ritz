# spire/test/test_model_timestamp.ritz
#
# Tests for Timestamp type

import ritzlib.strview { StrView, strview_eq }
import ritzlib.string { String }

import spire.model.timestamp { Timestamp, timestamp_now, timestamp_zero }
import spire.model.timestamp { timestamp_from_unix, timestamp_from_millis, timestamp_unix, timestamp_millis }
import spire.model.timestamp { timestamp_to_iso8601 }
import spire.model.timestamp { timestamp_eq, timestamp_lt, timestamp_gt, timestamp_lte, timestamp_gte }
import spire.model.timestamp { timestamp_add_seconds, timestamp_add_days, timestamp_diff_seconds }
import spire.utils { string_as_strview }

# timestamp_to_iso8601(ts) as a String compared against `expected`.
fn iso_is(seconds: i64, expected: StrView) -> bool
    let t: Timestamp = timestamp_from_unix(seconds)
    var s: String = timestamp_to_iso8601(@t)
    let got: StrView = string_as_strview(@s)
    return strview_eq(got, expected)

# ============================================================================
# timestamp_zero tests
# ============================================================================

[[test]]
fn test_timestamp_zero_value() -> i32
    let t: Timestamp = timestamp_zero()
    assert t.seconds == 0
    assert t.nanos == 0
    0

[[test]]
fn test_timestamp_zero_to_unix() -> i32
    let t: Timestamp = timestamp_zero()
    assert timestamp_unix(@t) == 0
    0

# ============================================================================
# timestamp_now tests
# ============================================================================

[[test]]
fn test_timestamp_now_is_not_zero() -> i32
    let t: Timestamp = timestamp_now()
    # Current time should be after Unix epoch
    assert t.seconds > 0
    0

[[test]]
fn test_timestamp_now_is_reasonable() -> i32
    let t: Timestamp = timestamp_now()
    # After year 2020: 1577836800 (Jan 1, 2020)
    # Before year 2100: 4102444800 (Jan 1, 2100)
    assert t.seconds > 1577836800
    assert t.seconds < 4102444800
    0

[[test]]
fn test_timestamp_now_nanos_in_range() -> i32
    let t: Timestamp = timestamp_now()
    # Nanoseconds should be 0-999999999
    assert t.nanos >= 0
    assert t.nanos < 1000000000
    0

# ============================================================================
# timestamp_from_unix tests
# ============================================================================

[[test]]
fn test_timestamp_from_unix_zero() -> i32
    let t: Timestamp = timestamp_from_unix(0)
    assert t.seconds == 0
    assert t.nanos == 0
    0

[[test]]
fn test_timestamp_from_unix_positive() -> i32
    let t: Timestamp = timestamp_from_unix(1234567890)
    assert t.seconds == 1234567890
    0

[[test]]
fn test_timestamp_from_unix_roundtrip() -> i32
    let original: i64 = 1609459200  # Jan 1, 2021
    let t: Timestamp = timestamp_from_unix(original)
    let result: i64 = timestamp_unix(@t)
    assert result == original
    0

# ============================================================================
# timestamp_unix tests
# ============================================================================

[[test]]
fn test_timestamp_to_unix_zero() -> i32
    let t: Timestamp = timestamp_zero()
    assert timestamp_unix(@t) == 0
    0

[[test]]
fn test_timestamp_to_unix_with_nanos() -> i32
    var t: Timestamp = timestamp_zero()
    t.seconds = 1000
    t.nanos = 500000000  # 0.5 seconds
    # to_unix should return just seconds
    assert timestamp_unix(@t) == 1000
    0

# ============================================================================
# timestamp_from_millis / timestamp_millis tests
# ============================================================================

[[test]]
fn test_timestamp_from_millis_splits_nanos() -> i32
    let t: Timestamp = timestamp_from_millis(1500)
    assert t.seconds == 1
    assert t.nanos == 500000000
    assert timestamp_millis(@t) == 1500
    0

# ============================================================================
# timestamp_to_iso8601 tests
# ============================================================================

[[test]]
fn test_timestamp_to_iso8601_zero() -> i32
    assert iso_is(0, "1970-01-01T00:00:00Z")
    0

[[test]]
fn test_timestamp_to_iso8601_format() -> i32
    let t: Timestamp = timestamp_from_unix(1609459200)  # Jan 1, 2021
    var s: String = timestamp_to_iso8601(@t)
    let v: StrView = string_as_strview(@s)
    # YYYY-MM-DDTHH:MM:SSZ
    assert v.len == 20
    assert *(v.ptr + 4) == '-'
    assert *(v.ptr + 7) == '-'
    assert *(v.ptr + 10) == 'T'
    assert *(v.ptr + 13) == ':'
    assert *(v.ptr + 16) == ':'
    assert *(v.ptr + 19) == 'Z'
    0

[[test]]
fn test_timestamp_to_iso8601_new_year() -> i32
    assert iso_is(1609459200, "2021-01-01T00:00:00Z")
    0

[[test]]
fn test_timestamp_to_iso8601_with_time() -> i32
    assert iso_is(1623760245, "2021-06-15T12:30:45Z")
    0

[[test]]
fn test_timestamp_to_iso8601_leap_day() -> i32
    # 2020-02-29 exercises the leap-year month table
    assert iso_is(1582934400, "2020-02-29T00:00:00Z")
    assert iso_is(1583020799, "2020-02-29T23:59:59Z")
    0

# ============================================================================
# Comparison tests
# ============================================================================

[[test]]
fn test_timestamp_eq_same() -> i32
    let t1: Timestamp = timestamp_from_unix(1000)
    let t2: Timestamp = timestamp_from_unix(1000)
    assert timestamp_eq(@t1, @t2) == 1
    0

[[test]]
fn test_timestamp_eq_different_seconds() -> i32
    let t1: Timestamp = timestamp_from_unix(1000)
    let t2: Timestamp = timestamp_from_unix(2000)
    assert timestamp_eq(@t1, @t2) == 0
    0

[[test]]
fn test_timestamp_eq_different_nanos() -> i32
    var t1: Timestamp = timestamp_from_unix(1000)
    var t2: Timestamp = timestamp_from_unix(1000)
    t1.nanos = 100
    t2.nanos = 200
    assert timestamp_eq(@t1, @t2) == 0
    0

[[test]]
fn test_timestamp_lt_less() -> i32
    let t1: Timestamp = timestamp_from_unix(1000)
    let t2: Timestamp = timestamp_from_unix(2000)
    assert timestamp_lt(@t1, @t2) == 1
    0

[[test]]
fn test_timestamp_lt_greater() -> i32
    let t1: Timestamp = timestamp_from_unix(2000)
    let t2: Timestamp = timestamp_from_unix(1000)
    assert timestamp_lt(@t1, @t2) == 0
    0

[[test]]
fn test_timestamp_lt_equal() -> i32
    let t1: Timestamp = timestamp_from_unix(1000)
    let t2: Timestamp = timestamp_from_unix(1000)
    assert timestamp_lt(@t1, @t2) == 0
    0

[[test]]
fn test_timestamp_gt_greater() -> i32
    let t1: Timestamp = timestamp_from_unix(2000)
    let t2: Timestamp = timestamp_from_unix(1000)
    assert timestamp_gt(@t1, @t2) == 1
    0

[[test]]
fn test_timestamp_gt_less() -> i32
    let t1: Timestamp = timestamp_from_unix(1000)
    let t2: Timestamp = timestamp_from_unix(2000)
    assert timestamp_gt(@t1, @t2) == 0
    0

[[test]]
fn test_timestamp_lte_gte() -> i32
    let a: Timestamp = timestamp_from_unix(1000)
    let b: Timestamp = timestamp_from_unix(1000)
    let c: Timestamp = timestamp_from_unix(2000)
    assert timestamp_lte(@a, @b) == 1
    assert timestamp_gte(@a, @b) == 1
    assert timestamp_lte(@a, @c) == 1
    assert timestamp_gte(@a, @c) == 0
    0

# ============================================================================
# Arithmetic tests
# ============================================================================

[[test]]
fn test_timestamp_add_seconds() -> i32
    let t: Timestamp = timestamp_from_unix(1000)
    let r: Timestamp = timestamp_add_seconds(@t, 500)
    assert r.seconds == 1500
    # The input is not modified
    assert t.seconds == 1000
    0

[[test]]
fn test_timestamp_add_seconds_negative() -> i32
    let t: Timestamp = timestamp_from_unix(1000)
    let r: Timestamp = timestamp_add_seconds(@t, -500)
    assert r.seconds == 500
    0

[[test]]
fn test_timestamp_add_days() -> i32
    let t: Timestamp = timestamp_from_unix(1000)
    let r: Timestamp = timestamp_add_days(@t, 2)
    assert r.seconds == 1000 + 2 * 86400
    0

[[test]]
fn test_timestamp_diff_seconds() -> i32
    let a: Timestamp = timestamp_from_unix(1500)
    let b: Timestamp = timestamp_from_unix(1000)
    assert timestamp_diff_seconds(@a, @b) == 500
    assert timestamp_diff_seconds(@b, @a) == -500
    0
