fn show_help() -> i32
    # One line per print: a string literal cannot span lines.
    print_str("Spire - MVRSPT Web Framework for Ritz\n")
    print_str("\n")
    print_str("Usage: spire <command> [options]\n")
    print_str("\n")
    print_str("Commands:\n")
    print_str("  test              Run tests\n")
    print_str("    -v, --verbose   Show test names as they run\n")
    print_str("    -q, --quiet     Minimal output (failures + summary)\n")
    print_str("    -f, --filter    Run only tests matching pattern\n")
    print_str("    --no-fork       Disable fork isolation (for debugging)\n")
    print_str("    -t, --timeout   Set per-test timeout in ms (default: 5000)\n")
    print_str("\n")
    print_str("  serve             Start development server\n")
    print_str("    -p, --port      Port to listen on (default: 8000)\n")
    print_str("    -h, --host      Host to bind to (default: 127.0.0.1)\n")
    print_str("    --no-reload     Disable auto-reload\n")
    print_str("\n")
    print_str("  routes            List all registered routes\n")
    print_str("\n")
    print_str("  gen <type> <name> Generate boilerplate code\n")
    print_str("    Types: model, repo, service, presenter, migration\n")
    print_str("\n")
    print_str("  migrate           Run pending database migrations\n")
    print_str("\n")
    print_str("  shell             Start interactive shell\n")
    print_str("\n")
    print_str("  help, --help      Show this help message\n")
    print_str("  version, -V       Show version\n")
    print_str("\n")
    print_str("Examples:\n")
    print_str("  spire test                    # Run all tests\n")
    print_str("  spire test -f user            # Run tests matching 'user'\n")
    print_str("  spire serve -p 3000           # Start server on port 3000\n")
    print_str("  spire gen model Task          # Generate Task model\n")
    print_str("  spire gen repo Task           # Generate TaskRepository\n")
    0

fn show_version() -> i32
    let version: StrView = "Spire 0.1.0\n"
    print_str(version)
    0

# ============================================================================
# Main Entry Point
# ============================================================================

# Call this from your app's main()
pub fn spire_cli_run(argc: i32, argv: **u8) -> i32
    let cmd: Command = parse_args(argc, argv)
    return execute_command(cmd)

# Simplified version for apps that manage their own argv
pub fn spire_cli(args: Vec<StrView>) -> i32
    # Convert Vec<StrView> to argc/argv style
    # For now, just handle common cases

    if vec_len<StrView>(@args) == 0
        return execute_command(Help)

    let first: StrView = vec_get<StrView>(@args, 0)

    let test_cmd: StrView = "test"
    let serve_cmd: StrView = "serve"
    let help_cmd: StrView = "help"

    if first.eq(test_cmd)
        var opts: TestOptions = test_options_default()
        # Parse remaining args...
        return execute_command(Test(opts))

    if first.eq(serve_cmd)
        var opts: ServeOptions = serve_options_default()
        return execute_command(Serve(opts))

    if first.eq(help_cmd)
        return execute_command(Help)

    return execute_command(Unknown(string_from_strview(first)))

# ============================================================================
# Helper Functions
# ============================================================================

fn cstr_to_strview(s: *u8) -> StrView
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    return strview_from_ptr(s, len)

fn parse_i64(s: StrView) -> i64
    var result: i64 = 0
    var i: i64 = 0

    while i < s.len
        let ch: u8 = *(s.ptr + i)
        if ch >= 48 and ch <= 57
            result = result * 10 + (ch - 48) as i64
        i += 1

    return result

fn print_str(s: StrView)
    sys_write(1, s.ptr, s.len)

fn print_u16(n: u16)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n as i64)
    sys_write(1, @buf[0], len)
