# spire/repo/mausoleum.ritz
#
# Mausoleum database adapter for Spire repositories
#
# This module provides the connection between Spire's repository abstraction
# and the Mausoleum document database. It handles:
# - Connection management
# - Document serialization/deserialization
# - CRUD operations mapped to Mausoleum protocol
# - Scanning/querying
#
# Usage:
#
#   # Initialize database connection
#   var db: Db = db_empty()
#   db_init(@db, "127.0.0.1", 7777, "my_collection")
#
#   # Insert a document
#   var doc_id: i64 = db_insert(@db, data, len)
#
#   # Get a document
#   var data: *u8 = null
#   var len: i32 = 0
#   db_get(@db, doc_id, @data, @len)
#
#   # Scan all documents
#   db_scan(@db, callback, user_data)
#
#   # Close connection
#   db_close(@db)

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.io
import ritzlib.strview { StrView, strview_from_ptr }
import ritzlib.span
import ritzlib.box

import mausoleum.client { Client, client_new, client_free }
import mausoleum.client { client_connect, client_connect_encrypted, client_disconnect, client_is_connected }
import mausoleum.client { client_insert, client_get, client_delete, client_scan }
import mausoleum.client { client_index_create, client_find, client_last_error }
import mausoleum.protocol { MSG_SCAN_RESULT, PROTO_ERR_NO_INDEX, PROTO_ERR_INVALID_MSG_TYPE }
import mausoleum.m7m_types { ERR_OK }
import mausoleum.document { Document, DocumentId, Field }
import mausoleum.document { doc_init, doc_id_invalid, field_string }
import mausoleum.document { doc_set_field, doc_get_field, FIELD_STRING }
import mausoleum.collection { doc_serialize, doc_deserialize }

# Import from same package - use relative import
# Note: RepoError types are defined in mod.ritz but not used yet in this basic adapter

# ============================================================================
# Database Connection
# ============================================================================

pub struct Db
    client: Box<Client>   # empty while not connected
    connected: i32
    host: [64]u8
    host_len: i32
    port: i32
    collection: [64]u8
    collection_len: i32
    encrypted: i32        # 0 = plaintext (legacy / dev-only), 1 = encrypted
                          # (X25519 + ChaCha20-Poly1305).  Defaults to 1 in
                          # db_init so callers get encryption transparently;
                          # use db_set_encryption(@db, 0) to override for a
                          # mausoleum running with --no-encryption.

# A Db with no connection settings yet: what `var db: Db` starts as, before
# db_init.
pub fn db_empty() -> Db
    var db: Db
    db.client = box_empty<Client>()
    db.connected = 0
    db.host_len = 0
    db.port = 0
    db.collection_len = 0
    db.encrypted = 1
    return db

# Initialize a database connection
pub fn db_init(db: *Db, host: *u8, host_len: i32, port: i32, collection: *u8, collection_len: i32) -> i32
    db.client.drop()
    db.connected = 0
    db.port = port
    # Default to encrypted — matches mausoleum's default serve mode.
    # `wiki_store_init` (and equivalent callers) can flip this with
    # db_set_encryption before db_connect if they need plaintext.
    db.encrypted = 1

    # Copy host
    if host_len > 63
        db.host_len = 63
    else
        db.host_len = host_len
    for i in 0..db.host_len
        db.host[i] = *(host + i)
    db.host[db.host_len] = 0

    # Copy collection name
    if collection_len > 63
        db.collection_len = 63
    else
        db.collection_len = collection_len
    for i in 0..db.collection_len
        db.collection[i] = *(collection + i)
    db.collection[db.collection_len] = 0

    return 0

# Toggle encrypted vs plaintext transport.  Must be called before
# db_connect — flipping this on a connected client is a no-op (the
# handshake is already done one way or the other).
pub fn db_set_encryption(db: *Db, enabled: i32)
    db.encrypted = enabled

# Connect to the database.  Routes through client_connect_encrypted
# (X25519 + ChaCha20-Poly1305) when db.encrypted != 0; otherwise the
# legacy plaintext path.  Default for newly-init'd Db is encrypted.
pub fn db_connect(db: *Db) -> i32
    if db.connected != 0
        return 0  # Already connected

    db.client = client_new()
    if not db.client.valid()
        return -1

    var result: i32 = 0
    if db.encrypted != 0
        result = client_connect_encrypted(db.client.as_ptr(), strview_from_ptr(@db.host[0], db.host_len as i64), db.port, strview_from_ptr(@db.collection[0], db.collection_len as i64))
    else
        result = client_connect(db.client.as_ptr(), strview_from_ptr(@db.host[0], db.host_len as i64), db.port, strview_from_ptr(@db.collection[0], db.collection_len as i64))

    if result < 0
        client_free(db.client.as_ptr())
        db.client.drop()
        return result

    db.connected = 1
    return 0

# Close the database connection
pub fn db_close(db: *Db)
    if db.client.valid()
        if db.connected != 0
            client_disconnect(db.client.as_ptr())
        client_free(db.client.as_ptr())
        db.client.drop()
    db.connected = 0

# Check if connected
pub fn db_is_connected(db: *Db) -> i32
    return db.connected

# ============================================================================
# CRUD Operations
# ============================================================================

# Insert raw document data, returns document ID or < 0 on error
pub fn db_insert(db: *Db, data: *u8, data_len: i32) -> i64
    if db.connected == 0
        return -1
    # spire's API is still a raw pair (its own port, AGAST #4692)
    return client_insert(db.client.as_ptr(), Span<u8> { ptr: data, len: data_len as i64 })

# Get raw document data by ID
# Returns 1 if found, 0 if not found, < 0 on error
pub fn db_get(db: *Db, doc_id: i64, data_out: **u8, len_out: *i32) -> i32
    if db.connected == 0
        return -1
    var doc: [u8] = span_empty<u8>()
    let rc: i32 = client_get(db.client.as_ptr(), doc_id, @doc)
    *data_out = doc.as_ptr()
    *len_out = doc.len as i32
    return rc

# Delete a document by ID
# Returns 1 if deleted, 0 if not found, < 0 on error
pub fn db_delete(db: *Db, doc_id: i64) -> i32
    if db.connected == 0
        return -1
    return client_delete(db.client.as_ptr(), doc_id)

# Scan all documents with a callback
# callback: fn(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
#   Return 0 to continue, non-zero to stop
# Returns number of documents scanned, or < 0 on error
pub fn db_scan(db: *Db, callback: *u8, user_data: *u8) -> i32
    if db.connected == 0
        return -1
    var fwd: ScanForward = ScanForward { callback: callback, user_data: user_data }
    return client_scan(db.client.as_ptr(), scan_forward as *u8, @fwd as *u8)

# db_scan's callback and its user_data, behind client_scan's: client_scan
# hands each document over as a [u8], db_scan's callers take (ptr, len).
struct ScanForward
    callback: *u8
    user_data: *u8

fn scan_forward(doc_id: i64, doc: [u8], user: *u8) -> i32
    let fwd: *ScanForward = user as *ScanForward
    let cb: fn(i64, *u8, i32, *u8) -> i32 = fwd.callback as fn(i64, *u8, i32, *u8) -> i32
    return cb(doc_id, doc.as_ptr(), doc.len as i32, fwd.user_data)

# ============================================================================
# Secondary indexes
# ============================================================================

# Returned by db_index_create / db_find_ids when the server does not offer
# secondary indexes: an older mausoleum without the protocol, or an index
# the server has dropped.  Callers should fall back to db_scan and retry the
# index later; do not treat this as a data error.
pub const DB_REFUSED: i32 = -1001

# Ask the server to index `field`, building it from the documents already
# stored.  Idempotent — safe to call on every reconnect.
# Returns 0, DB_REFUSED, or < 0 on a transport/protocol failure.
pub fn db_index_create(db: *Db, field: *u8, field_len: i32) -> i32
    if db.connected == 0
        return -1
    let rc: i32 = client_index_create(db.client.as_ptr(), Span<u8> { ptr: field, len: field_len as i64 })
    if rc == -4
        # The server answered with an error.  An old server does not know
        # MSG_INDEX_CREATE and says so; that is permanent, not transient.
        if client_last_error(db.client.as_ptr()) == PROTO_ERR_INVALID_MSG_TYPE
            return DB_REFUSED
    return rc

# Document ids whose `field` holds string `value`, ascending, up to `max`.
# Returns the count, DB_REFUSED when there is no such index (so the caller
# scans), or < 0 on a transport/protocol failure.
pub fn db_find_ids(db: *Db, field: *u8, field_len: i32, value: *u8, value_len: i32, out: *i64, max: i32) -> i32
    if db.connected == 0
        return -1
    if value_len < 0
        return -4
    let rc: i32 = client_find(db.client.as_ptr(), Span<u8> { ptr: field, len: field_len as i64 }, Span<u8> { ptr: value, len: value_len as i64 }, out, max)
    if rc == -4
        let err: i32 = client_last_error(db.client.as_ptr())
        if err == PROTO_ERR_NO_INDEX or err == PROTO_ERR_INVALID_MSG_TYPE
            return DB_REFUSED
    return rc

# ============================================================================
# Document Helpers
# ============================================================================

# Create a document with string fields and serialize it
# fields: array of (key, value) pairs where each is (key_ptr, key_len, val_ptr, val_len)
# Returns serialized size, or < 0 on error
pub fn db_serialize_doc(buf: *u8, buf_len: i64, fields: *DbField, field_count: i32) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)

    for i in 0..field_count
        let f: *DbField = fields + i
        var field: Field = field_string(StrView { ptr: f.value, len: f.value_len as i64 })
        # Create StrView for key
        let key_sv: StrView = strview_from_ptr(f.key, f.key_len as i64)
        doc_set_field(@doc, key_sv, @field)

    return doc_serialize(@doc, Span<u8> { ptr: buf, len: buf_len })

# Field descriptor for serialization
pub struct DbField
    key: *u8
    key_len: i32
    value: *u8
    value_len: i32

# Create a DbField
pub fn db_field(key: *u8, key_len: i32, value: *u8, value_len: i32) -> DbField
    var f: DbField
    f.key = key
    f.key_len = key_len
    f.value = value
    f.value_len = value_len
    return f

# Extract a string field from serialized document data
# Returns field length, or < 0 if not found
pub fn db_extract_field(data: *u8, data_len: i32, field_name: *u8, field_name_len: i32, out_value: *u8, max_len: i32) -> i32
    var doc: Document
    let result: i32 = doc_deserialize(Span<u8> { ptr: data, len: data_len as i64 }, @doc)
    if result != ERR_OK
        return -1

    # Create StrView for field name
    let name_sv: StrView = strview_from_ptr(field_name, field_name_len as i64)

    var field: Field
    if doc_get_field(@doc, name_sv, @field) != ERR_OK
        return -2

    if field.ftype != FIELD_STRING
        return -3

    var len: i32 = field.bytes.len as i32
    if len > max_len
        len = max_len

    memcpy(out_value, field.bytes.as_ptr(), len as i64)
    return len
