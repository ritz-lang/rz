# spire/repo/mausoleum.ritz
#
# Mausoleum database adapter for Spire repositories
#
# This module provides the connection between Spire's repository abstraction
# and the Mausoleum document database. It handles:
# - Connection management
# - Document serialization/deserialization
# - CRUD operations mapped to Mausoleum protocol
# - Scanning/querying
#
# Usage:
#
#   # Initialize database connection
#   var db: Db = db_empty()
#   db_init(@db, "127.0.0.1", 7777, "my_collection")
#
#   # Insert a document (`doc` is a [u8] of serialized Document bytes)
#   var doc_id: i64 = db_insert(@db, doc)
#
#   # Get a document (a view of the client's receive buffer)
#   var doc: [u8] = span_empty<u8>()
#   db_get(@db, doc_id, @doc)
#
#   # Scan all documents: callback(doc_id, doc: [u8], user_data)
#   db_scan(@db, callback, user_data)
#
#   # Close connection
#   db_close(@db)

import ritzlib.strview { StrView }
import ritzlib.span
import ritzlib.box

import mausoleum.client { Client, client_new, client_free }
import mausoleum.client { client_connect, client_connect_encrypted, client_disconnect, client_is_connected }
import mausoleum.client { client_insert, client_get, client_delete, client_scan }
import mausoleum.client { client_index_create, client_find, client_last_error }
import mausoleum.protocol { MSG_SCAN_RESULT, PROTO_ERR_NO_INDEX, PROTO_ERR_INVALID_MSG_TYPE }
import mausoleum.m7m_types { ERR_OK }
import mausoleum.document { Document, DocumentId, Field }
import mausoleum.document { doc_init, doc_id_invalid, field_string }
import mausoleum.document { doc_set_field, doc_get_field, FIELD_STRING }
import mausoleum.collection { doc_serialize, doc_deserialize }

# Import from same package - use relative import
# Note: RepoError types are defined in mod.ritz but not used yet in this basic adapter

# ============================================================================
# Database Connection
# ============================================================================

pub struct Db
    client: Box<Client>   # empty while not connected
    connected: i32
    host: [64]u8
    host_len: i32
    port: i32
    collection: [64]u8
    collection_len: i32
    encrypted: i32        # 0 = plaintext (legacy / dev-only), 1 = encrypted
                          # (X25519 + ChaCha20-Poly1305).  Defaults to 1 in
                          # db_init so callers get encryption transparently;
                          # use db_set_encryption(@db, 0) to override for a
                          # mausoleum running with --no-encryption.

# A Db with no connection settings yet: what `var db: Db` starts as, before
# db_init.
pub fn db_empty() -> Db
    var db: Db
    db.client = box_empty<Client>()
    db.connected = 0
    db.host_len = 0
    db.port = 0
    db.collection_len = 0
    db.encrypted = 1
    return db

# Initialize a database connection.  `host` and `collection` are copied
# (at most 63 bytes each).
pub fn db_init(db: *Db, host: StrView, port: i32, collection: StrView) -> i32
    db.client.drop()
    db.connected = 0
    db.port = port
    # Default to encrypted — matches mausoleum's default serve mode.
    # `wiki_store_init` (and equivalent callers) can flip this with
    # db_set_encryption before db_connect if they need plaintext.
    db.encrypted = 1
    db.host_len = name_copy(@db.host, host)
    db.collection_len = name_copy(@db.collection, collection)
    return 0

# `name` into a [64]u8 field, cut to 63 bytes so a NUL always follows it;
# returns the length kept.
fn name_copy(field: [u8], name: StrView) -> i32
    let kept: StrView = name.take(field.len - 1)
    field.zero()
    field.copy_from(span_from_strview(kept))
    return kept.len as i32

# The host db_init was given (as kept: at most 63 bytes).
pub fn db_host(db: *Db) -> StrView
    let field: [u8] = @db.host
    return field.to(db.host_len as i64).as_strview()

# The collection db_init was given (as kept: at most 63 bytes).
pub fn db_collection(db: *Db) -> StrView
    let field: [u8] = @db.collection
    return field.to(db.collection_len as i64).as_strview()

# Toggle encrypted vs plaintext transport.  Must be called before
# db_connect — flipping this on a connected client is a no-op (the
# handshake is already done one way or the other).
pub fn db_set_encryption(db: *Db, enabled: i32)
    db.encrypted = enabled

# Connect to the database.  Routes through client_connect_encrypted
# (X25519 + ChaCha20-Poly1305) when db.encrypted != 0; otherwise the
# legacy plaintext path.  Default for newly-init'd Db is encrypted.
pub fn db_connect(db: *Db) -> i32
    if db.connected != 0
        return 0  # Already connected

    db.client = client_new()
    if not db.client.valid()
        return -1

    var result: i32 = 0
    if db.encrypted != 0
        result = client_connect_encrypted(db.client.as_ptr(), db_host(db), db.port, db_collection(db))
    else
        result = client_connect(db.client.as_ptr(), db_host(db), db.port, db_collection(db))

    if result < 0
        client_free(db.client.as_ptr())
        db.client.drop()
        return result

    db.connected = 1
    return 0

# Close the database connection
pub fn db_close(db: *Db)
    if db.client.valid()
        if db.connected != 0
            client_disconnect(db.client.as_ptr())
        client_free(db.client.as_ptr())
        db.client.drop()
    db.connected = 0

# Check if connected
pub fn db_is_connected(db: *Db) -> i32
    return db.connected

# ============================================================================
# CRUD Operations
# ============================================================================

# Insert serialized document bytes, returns document ID or < 0 on error
pub fn db_insert(db: *Db, doc: [u8]) -> i64
    if db.connected == 0
        return -1
    return client_insert(db.client.as_ptr(), doc)

# Get a document's bytes by ID into `doc_out`: a view of the client's
# receive buffer, valid until the next request on `db` (client_get's).
# Returns 1 if found, 0 if not found, < 0 on error. The out-parameter is
# client_get's, passed straight through (it was a *u8 and a *i32 before).
pub fn db_get(db: *Db, doc_id: i64, doc_out: *Span<u8>) -> i32
    if db.connected == 0
        return -1
    return client_get(db.client.as_ptr(), doc_id, doc_out)

# Delete a document by ID
# Returns 1 if deleted, 0 if not found, < 0 on error
pub fn db_delete(db: *Db, doc_id: i64) -> i32
    if db.connected == 0
        return -1
    return client_delete(db.client.as_ptr(), doc_id)

# Scan all documents with a callback (client_scan's)
# callback: fn(doc_id: i64, doc: [u8], user_data: *u8) -> i32
#   Return 0 to continue, non-zero to stop
# Returns number of documents scanned, or < 0 on error
pub fn db_scan(db: *Db, callback: *u8, user_data: *u8) -> i32
    if db.connected == 0
        return -1
    return client_scan(db.client.as_ptr(), callback, user_data)

# ============================================================================
# Secondary indexes
# ============================================================================

# Returned by db_index_create / db_find_ids when the server does not offer
# secondary indexes: an older mausoleum without the protocol, or an index
# the server has dropped.  Callers should fall back to db_scan and retry the
# index later; do not treat this as a data error.
pub const DB_REFUSED: i32 = -1001

# Ask the server to index `field`, building it from the documents already
# stored.  Idempotent — safe to call on every reconnect.
# Returns 0, DB_REFUSED, or < 0 on a transport/protocol failure.
pub fn db_index_create(db: *Db, field: StrView) -> i32
    if db.connected == 0
        return -1
    let rc: i32 = client_index_create(db.client.as_ptr(), span_from_strview(field))
    if rc == -4
        # The server answered with an error.  An old server does not know
        # MSG_INDEX_CREATE and says so; that is permanent, not transient.
        if client_last_error(db.client.as_ptr()) == PROTO_ERR_INVALID_MSG_TYPE
            return DB_REFUSED
    return rc

# Document ids whose `field` holds string `value`, ascending, up to `max`.
# Returns the count, DB_REFUSED when there is no such index (so the caller
# scans), or < 0 on a transport/protocol failure.
pub fn db_find_ids(db: *Db, field: StrView, value: StrView, out: *i64, max: i32) -> i32
    if db.connected == 0
        return -1
    let rc: i32 = client_find(db.client.as_ptr(), span_from_strview(field), span_from_strview(value), out, max)
    if rc == -4
        let err: i32 = client_last_error(db.client.as_ptr())
        if err == PROTO_ERR_NO_INDEX or err == PROTO_ERR_INVALID_MSG_TYPE
            return DB_REFUSED
    return rc

# ============================================================================
# Document Helpers
# ============================================================================

# Create a document with string fields and serialize it into `buf`.
# Returns serialized size, or < 0 on error
pub fn db_serialize_doc(buf: [u8], fields: [DbField]) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)

    for i in 0..fields.len
        let f: *DbField = fields.get_ptr(i)
        var field: Field = field_string(f.value)
        doc_set_field(@doc, f.key, @field)

    return doc_serialize(@doc, buf)

# Field descriptor for serialization: views of the caller's key and value
pub struct DbField
    key: StrView
    value: StrView

# Create a DbField
pub fn db_field(key: StrView, value: StrView) -> DbField
    return DbField { key: key, value: value }

# Extract string field `name` from serialized document `data` into `out`,
# cut to out.len bytes.
# Returns field length, or < 0 if not found
pub fn db_extract_field(data: [u8], name: StrView, out: [u8]) -> i32
    var doc: Document
    let result: i32 = doc_deserialize(data, @doc)
    if result != ERR_OK
        return -1

    var field: Field
    if doc_get_field(@doc, name, @field) != ERR_OK
        return -2

    if field.ftype != FIELD_STRING
        return -3

    return out.copy_from(field.bytes) as i32
