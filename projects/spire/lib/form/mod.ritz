# spire/form/mod.ritz
#
# Form Parsing and Validation
#
# Handles URL-encoded form data.
# Provides validation utilities for form fields.
#
# Example:
#
#   # Parse URL-encoded form
#   let form: FormData = form_parse(body)
#
#   # Get fields
#   let name: Option<StrView> = form_get(@form, "name")
#   let email: Option<StrView> = form_get(@form, "email")
#
#   # Validate
#   var errors: ValidationErrors = validation_errors_new()
#   validate_required(@&errors, "name", name)
#   validate_email(@&errors, "email", email)
#   if validation_has_errors(errors) != 0
#       return present_bad_request(validation_error_json(@errors))

import ritzlib.option
import ritzlib.strview { StrView, strview_from_ptr, strview_eq, strview_parse_i64 }
import ritzlib.string { String, string_new, string_push, string_len }
import ritzlib.gvec { Vec, vec_new, vec_push, vec_len, vec_get_ptr }

import spire.utils { string_as_strview }
import spire.json.mod { JsonBuilder, json_builder_new, json_object_start, json_object_end }
import spire.json.mod { json_field_str, json_field_array, json_array_end }
import spire.json.mod { json_builder_finish }
# One ValidationErrors type for the whole framework (#2024): form validators
# fill the same container that ServiceError::ValidationError carries.
import spire.service.mod { ValidationErrors, FieldValidationError, validation_add }

# ============================================================================
# FormData - Parsed form fields
# ============================================================================

pub struct FormData
    fields: Vec<FormField>

pub struct FormField
    name: String
    value: String

# Create empty form data
pub fn form_data_new() -> FormData
    var fd: FormData
    fd.fields = vec_new<FormField>()
    return fd

# Parse URL-encoded form body
pub fn form_parse(body: StrView) -> FormData
    var fd: FormData = form_data_new()

    if body.len == 0
        return fd

    var i: i64 = 0
    var start: i64 = 0
    var key: String = string_new()
    var in_key: i32 = 1

    while i <= body.len
        let at_end: bool = i >= body.len
        var ch: u8 = 0
        if not at_end
            ch = *(body.ptr + i)

        if at_end or ch == 38  # '&'
            # End of field
            if in_key == 0 and string_len(@key) > 0
                let value_sv: StrView = strview_from_ptr(body.ptr + start, i - start)
                var field: FormField
                field.name = key
                field.value = url_decode(value_sv)
                vec_push<FormField>(@&fd.fields, field)
                key = string_new()
            in_key = 1
            start = i + 1
        else if ch == 61 and in_key != 0  # '='
            let key_sv: StrView = strview_from_ptr(body.ptr + start, i - start)
            key = url_decode(key_sv)
            in_key = 0
            start = i + 1

        i += 1

    return fd

# Get field value by name (first match)
pub fn form_get(form: *FormData, name: StrView) -> Option<StrView>
    var i: i64 = 0
    while i < vec_len<FormField>(@form.fields)
        let field: *FormField = vec_get_ptr<FormField>(@&form.fields, i)
        if strview_eq(string_as_strview(@field.name), name)
            return Some(string_as_strview(@field.value))
        i += 1
    return None

# Get all values for a field (for multi-select, checkboxes)
pub fn form_get_all(form: *FormData, name: StrView) -> Vec<StrView>
    var result: Vec<StrView> = vec_new<StrView>()
    var i: i64 = 0
    while i < vec_len<FormField>(@form.fields)
        let field: *FormField = vec_get_ptr<FormField>(@&form.fields, i)
        if strview_eq(string_as_strview(@field.name), name)
            vec_push<StrView>(@&result, string_as_strview(@field.value))
        i += 1
    return result

# Check if field exists
pub fn form_has(form: *FormData, name: StrView) -> i32
    match form_get(form, name)
        Some(_) => 1
        None => 0

# ============================================================================
# URL Decoding
# ============================================================================

fn url_decode(s: StrView) -> String
    var result: String = string_new()
    var i: i64 = 0

    while i < s.len
        let ch: u8 = *(s.ptr + i)

        if ch == 37 and i + 2 < s.len  # '%'
            let hi: u8 = *(s.ptr + i + 1)
            let lo: u8 = *(s.ptr + i + 2)
            let decoded: u8 = (hex_digit(hi) * 16 + hex_digit(lo)) as u8
            string_push(@&result, decoded)
            i += 3
        else if ch == 43  # '+'
            string_push(@&result, 32)  # space
            i += 1
        else
            string_push(@&result, ch)
            i += 1

    return result

fn hex_digit(c: u8) -> i32
    if c >= 48 and c <= 57  # '0'-'9'
        return (c - 48) as i32
    if c >= 65 and c <= 70  # 'A'-'F'
        return (c - 55) as i32
    if c >= 97 and c <= 102  # 'a'-'f'
        return (c - 87) as i32
    return 0

# ============================================================================
# URL Encoding
# ============================================================================

pub fn url_encode(s: StrView) -> String
    var result: String = string_new()
    var i: i64 = 0

    while i < s.len
        let ch: u8 = *(s.ptr + i)

        if is_url_safe(ch) != 0
            string_push(@&result, ch)
        else if ch == 32  # space
            string_push(@&result, 43)  # '+'
        else
            string_push(@&result, 37)  # '%'
            string_push(@&result, hex_char((ch / 16) as i32))
            string_push(@&result, hex_char((ch % 16) as i32))

        i += 1

    return result

fn is_url_safe(c: u8) -> i32
    # A-Z, a-z, 0-9, -, _, ., ~
    if c >= 65 and c <= 90
        return 1
    if c >= 97 and c <= 122
        return 1
    if c >= 48 and c <= 57
        return 1
    if c == 45 or c == 95 or c == 46 or c == 126
        return 1
    return 0

fn hex_char(n: i32) -> u8
    if n < 10
        return (48 + n) as u8
    return (55 + n) as u8  # A-F

# ============================================================================
# ValidationErrors queries (the type itself lives in spire.service)
# ============================================================================

# Total number of messages, across all fields
pub fn validation_error_count(self: *ValidationErrors) -> i64
    var total: i64 = 0
    var i: i64 = 0
    while i < vec_len<FieldValidationError>(@self.errors)
        let fve: *FieldValidationError = vec_get_ptr<FieldValidationError>(@&self.errors, i)
        total += vec_len<String>(@fve.messages)
        i += 1
    return total

# Get first error for a field
pub fn validation_get_error(self: *ValidationErrors, field: StrView) -> Option<StrView>
    var i: i64 = 0
    while i < vec_len<FieldValidationError>(@self.errors)
        let fve: *FieldValidationError = vec_get_ptr<FieldValidationError>(@&self.errors, i)
        if strview_eq(string_as_strview(@fve.field), field) and vec_len<String>(@fve.messages) > 0
            return Some(string_as_strview(vec_get_ptr<String>(@&fve.messages, 0)))
        i += 1
    return None

# Convert errors to JSON: {"errors":[{"field":..,"message":..},..]}, one
# object per message.
pub fn validation_error_json(self: *ValidationErrors) -> StrView
    var builder: JsonBuilder = json_builder_new()
    json_object_start(@&builder)
    json_field_array(@&builder, "errors")

    var i: i64 = 0
    while i < vec_len<FieldValidationError>(@self.errors)
        let fve: *FieldValidationError = vec_get_ptr<FieldValidationError>(@&self.errors, i)
        var j: i64 = 0
        while j < vec_len<String>(@fve.messages)
            json_object_start(@&builder)
            json_field_str(@&builder, "field", string_as_strview(@fve.field))
            json_field_str(@&builder, "message", string_as_strview(vec_get_ptr<String>(@&fve.messages, j)))
            json_object_end(@&builder)
            j += 1
        i += 1

    json_array_end(@&builder)
    json_object_end(@&builder)

    return json_builder_finish(@&builder)

# ============================================================================
# Validation functions
# ============================================================================

# Required field validation
pub fn validate_required(errors:& ValidationErrors, field: StrView, value: Option<StrView>)
    let present: bool = match value
        Some(v) => v.len > 0
        None => false
    if not present
        validation_add(errors, field, "is required")

# Min length validation (absent fields pass: use validate_required too)
pub fn validate_min_length(errors:& ValidationErrors, field: StrView, value: Option<StrView>, min: i64)
    match value
        Some(v) =>
            if v.len < min
                validation_add(errors, field, "is too short")
        None => ()

# Max length validation
pub fn validate_max_length(errors:& ValidationErrors, field: StrView, value: Option<StrView>, max: i64)
    match value
        Some(v) =>
            if v.len > max
                validation_add(errors, field, "is too long")
        None => ()

# Email format validation (basic)
pub fn validate_email(errors:& ValidationErrors, field: StrView, value: Option<StrView>)
    match value
        Some(v) =>
            if is_valid_email(v) == 0
                validation_add(errors, field, "is not a valid email")
        None => ()

fn is_valid_email(email: StrView) -> i32
    # Basic validation: must have @, something before and after
    var at_pos: i64 = -1
    var i: i64 = 0
    while i < email.len
        if *(email.ptr + i) == 64  # '@'
            if at_pos >= 0
                return 0  # Multiple @
            at_pos = i
        i += 1

    if at_pos <= 0
        return 0  # No @ or nothing before it
    if at_pos >= email.len - 1
        return 0  # Nothing after @

    # Check for dot after @
    i = at_pos + 1
    var has_dot: i32 = 0
    while i < email.len
        if *(email.ptr + i) == 46  # '.'
            has_dot = 1
        i += 1

    return has_dot

# Numeric validation (string is a decimal i64)
pub fn validate_numeric(errors:& ValidationErrors, field: StrView, value: Option<StrView>)
    match value
        Some(v) =>
            if is_none_i64(strview_parse_i64(v))
                validation_add(errors, field, "must be a number")
        None => ()

fn is_none_i64(o: Option<i64>) -> bool
    match o
        Some(_) => false
        None => true

# Range validation for numeric strings (non-numbers are left to validate_numeric)
pub fn validate_range(errors:& ValidationErrors, field: StrView, value: Option<StrView>, min: i64, max: i64)
    match value
        Some(v) =>
            match strview_parse_i64(v)
                Some(n) =>
                    if n < min or n > max
                        validation_add(errors, field, "is out of range")
                None => ()
        None => ()

# Matches validation (e.g., password confirmation)
pub fn validate_matches(errors:& ValidationErrors, field: StrView, value: Option<StrView>, other: Option<StrView>, other_name: StrView)
    match value
        Some(v) =>
            let same: bool = match other
                Some(o) => strview_eq(v, o)
                None => false
            if not same
                validation_add(errors, field, "does not match")
        None => ()

# ============================================================================
# Parse helpers
# ============================================================================

# Parse form field as i64
pub fn form_get_i64(form: *FormData, name: StrView) -> Option<i64>
    match form_get(form, name)
        Some(v) => strview_parse_i64(v)
        None => None

# Parse form field as bool (presence check or "true"/"1"/"on")
pub fn form_get_bool(form: *FormData, name: StrView) -> i32
    match form_get(form, name)
        Some(v) =>
            if v.len == 0
                return 1  # Present but empty = checked
            if strview_eq(v, "true") or strview_eq(v, "1") or strview_eq(v, "on")
                return 1
            return 0
        None => 0
