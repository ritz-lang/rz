# spire/middleware/mod.ritz
#
# Middleware - Request/Response processing helpers
#
# Cross-cutting concerns applied around handlers:
# - CORS headers
# - Request logging
# - Authentication
# - Security headers
# - Rate limit headers
# - Request IDs
#
# Example:
#
#   fn api_handler(req: *Request) -> Response
#       if is_preflight(req) != 0
#           return cors_preflight(@cors)
#       var resp: Response = handle(req)
#       cors_apply(@resp, @cors)
#       security_headers_apply(@resp)
#       return resp
#
# Note: Until closures are available (Ritz #121), middleware is a set of
# helpers a handler calls, not wrappers that compose handlers.

import ritzlib.option
import ritzlib.strview { StrView, strview_from_ptr, strview_starts_with }
import ritzlib.string { String, string_new, string_push, string_push_str, string_push_i64 }
import ritzlib.string { string_from_strview, string_from_bytes }
import ritzlib.span { Span, span_from_strview }
import ritzlib.fmt.digits { fmt_i64_into }

import http.types { METHOD_OPTIONS, method_to_span }
import spire.http.request { Request, request_method, request_path, request_header }
import spire.http.response { Response, response_unauthorized, response_with_status }
import spire.http.response { response_set_header, response_set_body }
import http.types { STATUS_NO_CONTENT }
import spire.utils { string_as_strview }

# ============================================================================
# Helpers
# ============================================================================

# Set header `name` to `value` on `response`
fn set_header(response: *Response, name: StrView, value: StrView)
    response_set_header(response, span_from_strview(name), span_from_strview(value))

# Set header `name` to the decimal form of `n`
fn set_header_i64(response: *Response, name: StrView, n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    set_header(response, name, strview_from_ptr(@buf[0], len))

# The request's `name` header, if present (a view into the request)
fn header_value(request: *Request, name: StrView) -> Option<StrView>
    let n: Span<u8> = span_from_strview(name)
    var v: Span<u8>
    if request_header(request, @n, @v) != 1
        return None
    return Some(strview_from_ptr(v.ptr, v.len))

# ============================================================================
# CORS Configuration
# ============================================================================

pub struct CorsConfig
    # Allowed origins ("*" for any)
    allow_origin: String
    # Allowed methods
    allow_methods: String
    # Allowed headers
    allow_headers: String
    # Expose headers to JavaScript
    expose_headers: String
    # Allow credentials (cookies)
    allow_credentials: i32
    # Max age for preflight cache (seconds)
    max_age: i64

# Create default CORS config (permissive)
pub fn cors_config_default() -> CorsConfig
    var cfg: CorsConfig
    cfg.allow_origin = string_from_strview("*")
    cfg.allow_methods = string_from_strview("GET, POST, PUT, PATCH, DELETE, OPTIONS")
    cfg.allow_headers = string_from_strview("Content-Type, Authorization, X-Request-ID")
    cfg.expose_headers = string_new()
    cfg.allow_credentials = 0
    cfg.max_age = 86400  # 24 hours
    return cfg

# Create restrictive CORS config for production
pub fn cors_config_restrictive(origin: StrView) -> CorsConfig
    var cfg: CorsConfig
    cfg.allow_origin = string_from_strview(origin)
    cfg.allow_methods = string_from_strview("GET, POST, PUT, DELETE")
    cfg.allow_headers = string_from_strview("Content-Type, Authorization")
    cfg.expose_headers = string_new()
    cfg.allow_credentials = 1
    cfg.max_age = 3600  # 1 hour
    return cfg

# Apply CORS headers to response
pub fn cors_apply(response: *Response, config: *CorsConfig)
    set_header(response, "Access-Control-Allow-Origin", string_as_strview(@config.allow_origin))
    set_header(response, "Access-Control-Allow-Methods", string_as_strview(@config.allow_methods))
    set_header(response, "Access-Control-Allow-Headers", string_as_strview(@config.allow_headers))
    if config.allow_credentials != 0
        set_header(response, "Access-Control-Allow-Credentials", "true")

# Handle CORS preflight request
pub fn cors_preflight(config: *CorsConfig) -> Response
    var resp: Response = response_with_status(STATUS_NO_CONTENT)
    cors_apply(@resp, config)
    set_header_i64(@resp, "Access-Control-Max-Age", config.max_age)
    return resp

# Check if request is CORS preflight
pub fn is_preflight(request: *Request) -> i32
    return (request_method(request) == METHOD_OPTIONS) as i32

# ============================================================================
# Request logging
# ============================================================================

pub struct RequestLog
    method: String
    path: String
    status: i32
    duration_us: i64
    client_ip: String
    user_agent: String

# Header value as an owned String, or `fallback`
fn header_or(request: *Request, name: StrView, fallback: StrView) -> String
    match header_value(request, name)
        Some(v) => string_from_strview(v)
        None => string_from_strview(fallback)

# Create request log entry
pub fn request_log_new(request: *Request) -> RequestLog
    var log: RequestLog
    let m: Span<u8> = method_to_span(request_method(request))
    log.method = string_from_bytes(Span<u8> { ptr: (m.ptr), len: (m.len) as i64 })
    let p: Span<u8> = request_path(request)
    log.path = string_from_bytes(Span<u8> { ptr: (p.ptr), len: (p.len) as i64 })
    log.status = 0  # Filled in after response
    log.duration_us = 0
    log.client_ip = header_or(request, "X-Forwarded-For", "unknown")
    log.user_agent = header_or(request, "User-Agent", "unknown")
    return log

# Complete log entry with response info
pub fn request_log_complete(log:& RequestLog, response: *Response, duration_us: i64)
    log.status = response.status
    log.duration_us = duration_us

# Format log entry as text: "GET /path 200 1234us"
pub fn request_log_format(log: *RequestLog) -> String
    var s: String = string_new()
    string_push_str(@&s, string_as_strview(@log.method))
    string_push(@&s, 32)  # space
    string_push_str(@&s, string_as_strview(@log.path))
    string_push(@&s, 32)
    string_push_i64(@&s, log.status as i64)
    string_push(@&s, 32)
    string_push_i64(@&s, log.duration_us)
    string_push_str(@&s, "us")
    return s

# Format log entry as JSON
pub fn request_log_json(log: *RequestLog) -> String
    var s: String = string_new()
    string_push_str(@&s, "{\"method\":\"")
    string_push_str(@&s, string_as_strview(@log.method))
    string_push_str(@&s, "\",\"path\":\"")
    push_escaped(@&s, string_as_strview(@log.path))
    string_push_str(@&s, "\",\"status\":")
    string_push_i64(@&s, log.status as i64)
    string_push_str(@&s, ",\"duration_us\":")
    string_push_i64(@&s, log.duration_us)
    string_push_str(@&s, "}")
    return s

# Append `sv` with '"' and '\' backslash-escaped
fn push_escaped(s:& String, sv: StrView)
    var i: i64 = 0
    while i < sv.len
        let ch: u8 = *(sv.ptr + i)
        if ch == 34 or ch == 92  # '"' or '\'
            string_push(@&s, 92)
        string_push(@&s, ch)
        i += 1

# ============================================================================
# Authentication helpers
# ============================================================================

pub enum AuthResult
    Authenticated(String)    # User ID
    InvalidToken
    MissingToken
    Expired

# Check if request has authentication
pub fn auth_check(request: *Request) -> AuthResult
    match header_value(request, "Authorization")
        Some(value) =>
            # Bearer token
            if value.len > 7 and strview_starts_with(value, "Bearer ")
                # Note: Actual validation would go here; for now the token
                # is the user ID.
                return Authenticated(string_from_strview(strview_from_ptr(value.ptr + 7, value.len - 7)))
            return InvalidToken
        None => MissingToken

# Check if authenticated
pub fn auth_is_authenticated(result: *AuthResult) -> i32
    match *result
        Authenticated(_) => 1
        _ => 0

# Get user ID from auth result
pub fn auth_user_id(result: *AuthResult) -> Option<StrView>
    match *result
        Authenticated(id) => Some(string_as_strview(@id))
        _ => None

# Response for unauthorized requests
pub fn auth_unauthorized_response() -> Response
    var resp: Response = response_unauthorized()
    set_header(@resp, "Content-Type", "application/json")
    let body: Span<u8> = span_from_strview("{\"error\":\"Unauthorized\"}")
    response_set_body(@resp, @body)
    return resp

# ============================================================================
# Security headers
# ============================================================================

# Apply security headers to response
pub fn security_headers_apply(response: *Response)
    set_header(response, "X-Content-Type-Options", "nosniff")
    set_header(response, "X-Frame-Options", "DENY")
    set_header(response, "X-XSS-Protection", "1; mode=block")
    set_header(response, "Referrer-Policy", "strict-origin-when-cross-origin")

# Apply strict security headers (for API responses)
pub fn security_headers_strict(response: *Response)
    security_headers_apply(response)
    set_header(response, "Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
    set_header(response, "Strict-Transport-Security", "max-age=31536000; includeSubDomains")

# ============================================================================
# Rate limiting state
# ============================================================================

pub struct RateLimitConfig
    # Requests per window
    limit: i64
    # Window size in seconds
    window_seconds: i64

pub fn rate_limit_config(limit: i64, window_seconds: i64) -> RateLimitConfig
    var cfg: RateLimitConfig
    cfg.limit = limit
    cfg.window_seconds = window_seconds
    return cfg

# Common rate limit presets
pub fn rate_limit_relaxed() -> RateLimitConfig
    return rate_limit_config(1000, 60)  # 1000/min

pub fn rate_limit_standard() -> RateLimitConfig
    return rate_limit_config(100, 60)  # 100/min

pub fn rate_limit_strict() -> RateLimitConfig
    return rate_limit_config(10, 60)  # 10/min

# Rate limit response headers
pub fn rate_limit_headers(response: *Response, limit: i64, remaining: i64, reset_at: i64)
    set_header_i64(response, "X-RateLimit-Limit", limit)
    set_header_i64(response, "X-RateLimit-Remaining", remaining)
    set_header_i64(response, "X-RateLimit-Reset", reset_at)

# ============================================================================
# Request ID
# ============================================================================

# Get or generate request ID
pub fn get_request_id(request: *Request) -> StrView
    match header_value(request, "X-Request-ID")
        Some(id) => id
        # Placeholder: in production use a UUID
        None => "req-000000"

# Add request ID to response
pub fn set_response_request_id(response: *Response, request_id: StrView)
    set_header(response, "X-Request-ID", request_id)
