# spire/presenter/mod.ritz
#
# Presenter Layer - Response Formatting
#
# Presenters transform domain objects into response formats.
# They handle:
# - JSON envelopes for API responses
# - Content negotiation
# - Error formatting
#
# Example:
#
#   fn present_task(task: *Task) -> Response
#       var builder: JsonBuilder = json_builder_new()
#       json_object_start(@&builder)
#       json_field_uuid(@&builder, "id", task.id)
#       json_field_str(@&builder, "title", string_as_strview(@task.title))
#       json_object_end(@&builder)
#       return present_success(json_builder_finish(@&builder))

import ritzlib.option
import ritzlib.strview { StrView }
import ritzlib.string { String }
import ritzlib.span { Span, span_from_strview }
import ritzlib.gvec { Vec }

import http.types { STATUS_OK, STATUS_CREATED, STATUS_BAD_REQUEST, STATUS_FORBIDDEN }
import http.types { STATUS_NOT_FOUND, STATUS_INTERNAL_SERVER_ERROR }
import spire.http.request { Request, request_wants_json }
import spire.http.response { Response, response_no_content, response_json_str, response_html }
import spire.http.response { response_set_status, response_set_header }
import spire.json.mod { JsonBuilder, json_builder_new, json_builder_finish }
import spire.json.mod { json_object_start, json_object_end, json_array_end }
import spire.json.mod { json_field_str, json_field_i64, json_field_bool, json_field_raw }
import spire.json.mod { json_field_array, json_field_object }
import spire.service.mod { ServiceError, ValidationErrors, FieldValidationError, PageInfo }
import spire.service.mod { service_error_status_code }
import spire.utils { string_as_strview }

# ============================================================================
# Response builders
# ============================================================================

# A JSON response with `status` and `body`
fn json_response(status: i32, body: StrView) -> Response
    let sp: Span<u8> = span_from_strview(body)
    var resp: Response = response_json_str(@sp)
    response_set_status(@resp, status)
    return resp

# The builder-owning functions below come in two halves.  The `*_into` half
# owns the JsonBuilder (which has drop glue) and writes the Response through
# `out`; the public wrapper keeps the `-> Response` signature and has no
# droppable local.  Returning a call's Response while a droppable local is
# still alive makes ritz0 merge the ~85KB Response through an SSA `load`,
# which clang's backend cannot lower.  `*out = ...` is a memcpy instead.

# {"success":true,"data":<json>} with `status`
fn present_data_into(status: i32, json: StrView, out: *Response)
    var builder: JsonBuilder = json_builder_new()
    json_object_start(@&builder)
    json_field_bool(@&builder, "success", 1)
    json_field_raw(@&builder, "data", json)
    json_object_end(@&builder)
    *out = json_response(status, json_builder_finish(@&builder))

fn present_data(status: i32, json: StrView) -> Response
    var resp: Response
    present_data_into(status, json, @resp)
    return resp

# Present success with data (JSON body built separately)
pub fn present_success(json: StrView) -> Response
    return present_data(STATUS_OK, json)

# Present success with pagination
fn present_paginated_into(json: StrView, page_info: *PageInfo, out: *Response)
    var builder: JsonBuilder = json_builder_new()
    json_object_start(@&builder)
    json_field_bool(@&builder, "success", 1)
    json_field_raw(@&builder, "data", json)

    json_field_object(@&builder, "meta")
    json_field_object(@&builder, "pagination")
    json_field_i64(@&builder, "page", page_info.page)
    json_field_i64(@&builder, "per_page", page_info.per_page)
    json_field_i64(@&builder, "total_items", page_info.total_items)
    json_field_i64(@&builder, "total_pages", page_info.total_pages)
    json_object_end(@&builder)  # pagination
    json_object_end(@&builder)  # meta
    json_object_end(@&builder)  # root

    *out = json_response(STATUS_OK, json_builder_finish(@&builder))

pub fn present_paginated(json: StrView, page_info: *PageInfo) -> Response
    var resp: Response
    present_paginated_into(json, page_info, @resp)
    return resp

# Present created resource
pub fn present_created(json: StrView) -> Response
    return present_data(STATUS_CREATED, json)

# Present created with location header
pub fn present_created_at(json: StrView, location: StrView) -> Response
    var resp: Response = present_created(json)
    response_set_header(@resp, span_from_strview("Location"), span_from_strview(location))
    return resp

# Present no content (204)
pub fn present_no_content() -> Response
    return response_no_content()

# ============================================================================
# Error presentation
# ============================================================================

# {"success":false,"error":{"code":<code>,"message":<message>}} with `status`
fn present_error_body_into(status: i32, code: StrView, message: StrView, out: *Response)
    var builder: JsonBuilder = json_builder_new()
    json_object_start(@&builder)
    json_field_bool(@&builder, "success", 0)
    json_field_object(@&builder, "error")
    json_field_str(@&builder, "code", code)
    json_field_str(@&builder, "message", message)
    json_object_end(@&builder)  # error
    json_object_end(@&builder)  # root
    *out = json_response(status, json_builder_finish(@&builder))

fn present_error_body(status: i32, code: StrView, message: StrView) -> Response
    var resp: Response
    present_error_body_into(status, code, message, @resp)
    return resp

# Present service error.
# Takes the error by pointer: a by-value parameter with drop glue forces each
# `return` arm to merge the ~85KB Response through a drop block, which clang
# -O2 does not finish compiling.  The caller keeps ownership and drops it.
pub fn present_error(err: *ServiceError) -> Response
    let status: i32 = service_error_status_code(err) as i32
    match *err
        ValidationError(errors) =>
            return present_validation_error(status, @errors)
        NotFoundError(msg) =>
            return present_error_body(status, "NOT_FOUND", string_as_strview(@msg))
        ForbiddenError(msg) =>
            return present_error_body(status, "FORBIDDEN", string_as_strview(@msg))
        ConflictError(msg) =>
            return present_error_body(status, "CONFLICT", string_as_strview(@msg))
        ExternalError(msg) =>
            return present_error_body(status, "EXTERNAL_ERROR", string_as_strview(@msg))
        InternalError(_) =>
            # Don't expose internal error details
            return present_error_body(status, "INTERNAL_ERROR", "An internal error occurred")

fn present_validation_error_into(status: i32, errors: *ValidationErrors, out: *Response)
    var builder: JsonBuilder = json_builder_new()
    json_object_start(@&builder)
    json_field_bool(@&builder, "success", 0)
    json_field_object(@&builder, "error")
    json_field_str(@&builder, "code", "VALIDATION_ERROR")
    json_field_str(@&builder, "message", "Validation failed")
    json_field_array(@&builder, "details")

    var i: i64 = 0
    while i < errors.errors.len()
        let fve: *FieldValidationError = errors.errors.get_ptr(i)
        var j: i64 = 0
        while j < fve.messages.len()
            json_object_start(@&builder)
            json_field_str(@&builder, "field", string_as_strview(@fve.field))
            json_field_str(@&builder, "message", string_as_strview(fve.messages.get_ptr(j)))
            json_object_end(@&builder)
            j += 1
        i += 1

    json_array_end(@&builder)   # details
    json_object_end(@&builder)  # error
    json_object_end(@&builder)  # root
    *out = json_response(status, json_builder_finish(@&builder))

fn present_validation_error(status: i32, errors: *ValidationErrors) -> Response
    var resp: Response
    present_validation_error_into(status, errors, @resp)
    return resp

# ============================================================================
# Simple error responses
# ============================================================================

pub fn present_bad_request(message: StrView) -> Response
    return present_error_body(STATUS_BAD_REQUEST, "BAD_REQUEST", message)

pub fn present_not_found(resource: StrView) -> Response
    return present_error_body(STATUS_NOT_FOUND, "NOT_FOUND", resource)

pub fn present_forbidden() -> Response
    return present_error_body(STATUS_FORBIDDEN, "FORBIDDEN", "Access denied")

pub fn present_internal_error() -> Response
    return present_error_body(STATUS_INTERNAL_SERVER_ERROR, "INTERNAL_ERROR", "An internal error occurred")

# ============================================================================
# Content negotiation
# ============================================================================

# Present based on Accept header
pub fn present_negotiated(request: *Request, json: StrView, html: StrView) -> Response
    if request_wants_json(request) != 0
        let sp: Span<u8> = span_from_strview(json)
        return response_json_str(@sp)
    let sp: Span<u8> = span_from_strview(html)
    return response_html(@sp)
