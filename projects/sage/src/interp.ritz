# Sage interpreter: a tree-walking evaluator over the parser's AST (AGAST #2787)
#
# This is the minimum that makes `sage FILE.js` run a script. The README's
# register-based bytecode VM and generational GC are the long-term design;
# this walks the AST directly and frees nothing (no GC yet).
#
# Representation
#   Value      a tagged struct: tag + f64 + two i64 payload words
#   strings    (start, len) slices of one byte arena, Interp.arena
#   scopes     Scope records linked to their parent; each holds a linked
#              list of Binding records (names are slices of the source or
#              of the arena, see `in_src`)
#   objects    JsObject records holding an insertion-ordered linked list of
#              Prop records
#   arrays     JsArray records holding an insertion-ordered linked list of
#              Elem slots, plus a JsObject for non-index properties
#   functions  FuncRec records: the function's AST node + its closure scope
#   control    Interp.ctl says how the last statement completed (normal,
#              return, break, continue, throw); Interp.ret carries the
#              returned or thrown value
#
# Supported: numbers, strings, booleans, null, undefined, objects, arrays;
# arithmetic, comparison, equality, logical, bitwise, unary, typeof,
# update and (compound) assignment operators; let/const/var; function
# declarations (hoisted) and expressions, arrow functions, closures,
# recursion; if, while, do-while, for, for-of over an array, break, continue,
# return; throw/try/catch/finally with Error objects for runtime errors;
# console.log, console.error, array literals, indexing, .length, push/pop and
# [ 1, 'a' ] rendering.
# Built-ins (#4077): Math (abs/floor/ceil/round/trunc/sign/min/max/pow/sqrt/
# cbrt/log/log2/log10/exp and PI/E/SQRT2/LN2/... constants); String(x),
# Number(x), Boolean(x); Number.isInteger/isNaN/isFinite/isSafeInteger and
# MAX_SAFE_INTEGER, MIN_SAFE_INTEGER, EPSILON, MAX_VALUE, MIN_VALUE,
# POSITIVE_INFINITY, NEGATIVE_INFINITY, NaN; Object.keys/values/entries/
# assign/is/freeze/isFrozen; and the String methods charAt, charCodeAt,
# indexOf, includes, startsWith, endsWith, slice, substring, toUpperCase,
# toLowerCase, trim, repeat and concat.
# Not yet (each throws "SyntaxError: sage does not support ..."): classes,
# `new`, `this`, for-in, for-of over a non-array, labels, switch, delete,
# `in`, instanceof; Math's trig/random/hypot; String.fromCharCode/split/
# replace; Number.prototype methods; Object.create/defineProperty.
# `var` is not hoisted (reading one before its declaration is a
# ReferenceError), and a `for (let ...)` loop shares one binding across
# iterations (#4077).
# Approximations: Math.log/log2/log10/exp are correctly rounded for the
# tested inputs but can differ from node by one ulp elsewhere. Object.keys
# and friends use insertion order, not node's integer-key-first order, and
# do not list an array's named properties. String methods are byte-based, so
# non-ASCII case mapping and UTF-16 charAt/charCodeAt differ from node.

import ritzlib.io
import ritzlib.strview
import ritzlib.gvec
import ritzlib.span
import src.token
import src.lexer
import src.ast
import src.parser
import src.float

# =============================================================================
# Values
# =============================================================================

const V_UNDEFINED: i32 = 0
const V_NULL: i32 = 1
const V_BOOL: i32 = 2      # a = 0 or 1
const V_NUMBER: i32 = 3    # num
const V_STRING: i32 = 4    # a = arena start, b = length
const V_FUNCTION: i32 = 5  # a = FuncRec index
const V_NATIVE: i32 = 6    # a = NATIVE_* id
const V_OBJECT: i32 = 7    # a = JsObject index
const V_ARRAY: i32 = 8     # a = JsArray index

const NATIVE_CONSOLE_LOG: i64 = 1
const NATIVE_CONSOLE_ERROR: i64 = 2
const NATIVE_ARRAY_PUSH: i64 = 3
const NATIVE_ARRAY_POP: i64 = 4

# Callable globals. String/Number/Object/Boolean are functions in JS, so they
# are V_NATIVE (typeof is "function") and expose their statics through
# get_property; Math is a plain object.
const NATIVE_STRING_CALL: i64 = 10
const NATIVE_NUMBER_CALL: i64 = 11
const NATIVE_BOOLEAN_CALL: i64 = 12
const NATIVE_OBJECT_CALL: i64 = 13

# Math statics (no receiver)
const NATIVE_MATH_ABS: i64 = 20
const NATIVE_MATH_FLOOR: i64 = 21
const NATIVE_MATH_CEIL: i64 = 22
const NATIVE_MATH_ROUND: i64 = 23
const NATIVE_MATH_TRUNC: i64 = 24
const NATIVE_MATH_SIGN: i64 = 25
const NATIVE_MATH_MIN: i64 = 26
const NATIVE_MATH_MAX: i64 = 27
const NATIVE_MATH_POW: i64 = 28
const NATIVE_MATH_SQRT: i64 = 29
const NATIVE_MATH_CBRT: i64 = 30
const NATIVE_MATH_LOG: i64 = 31
const NATIVE_MATH_LOG2: i64 = 32
const NATIVE_MATH_LOG10: i64 = 33
const NATIVE_MATH_EXP: i64 = 34

# Number statics
const NATIVE_NUMBER_IS_INTEGER: i64 = 40
const NATIVE_NUMBER_IS_NAN: i64 = 41
const NATIVE_NUMBER_IS_FINITE: i64 = 42
const NATIVE_NUMBER_IS_SAFE_INTEGER: i64 = 43

# Object statics
const NATIVE_OBJECT_KEYS: i64 = 50
const NATIVE_OBJECT_VALUES: i64 = 51
const NATIVE_OBJECT_ENTRIES: i64 = 52
const NATIVE_OBJECT_ASSIGN: i64 = 53
const NATIVE_OBJECT_IS: i64 = 54
const NATIVE_OBJECT_FREEZE: i64 = 55
const NATIVE_OBJECT_IS_FROZEN: i64 = 56

# String.prototype methods. The receiver string (arena start, length) lives
# in the method value's num/b fields; `a` is the id like every native.
const NATIVE_STR_CHAR_AT: i64 = 60
const NATIVE_STR_CHAR_CODE_AT: i64 = 61
const NATIVE_STR_INDEX_OF: i64 = 62
const NATIVE_STR_INCLUDES: i64 = 63
const NATIVE_STR_STARTS_WITH: i64 = 64
const NATIVE_STR_ENDS_WITH: i64 = 65
const NATIVE_STR_SLICE: i64 = 66
const NATIVE_STR_SUBSTRING: i64 = 67
const NATIVE_STR_TO_UPPER: i64 = 68
const NATIVE_STR_TO_LOWER: i64 = 69
const NATIVE_STR_TRIM: i64 = 70
const NATIVE_STR_REPEAT: i64 = 71
const NATIVE_STR_CONCAT: i64 = 72

# Longest string repeat() will build (memory is never freed without a GC)
const MAX_REPEAT_LEN: i64 = 1000000

struct Value
    tag: i32
    num: f64
    a: i64
    b: i64

# A property key: (in_src, start, len). Evaluates a computed key.
struct Key
    in_src: i32
    start: i64
    len: i64

# How the last statement completed
const CTL_NORMAL: i32 = 0
const CTL_RETURN: i32 = 1
const CTL_BREAK: i32 = 2
const CTL_CONTINUE: i32 = 3
const CTL_THROW: i32 = 4

# Nested JavaScript calls allowed before "RangeError: Maximum call stack
# size exceeded". Each JS call costs several native frames; this keeps a
# runaway recursion well inside the default 8 MB stack.
const MAX_DEPTH: i64 = 2000

# Extending an array (by index or by .length) materializes undefined slots,
# so a huge sparse array would hang or exhaust memory until there is a GC
# (#4077). Cap the materialized length; node accepts larger sparse arrays.
const MAX_ARRAY_LEN: i64 = 1000000

# =============================================================================
# Interpreter State
# =============================================================================

struct Binding
    in_src: i32     # 1: name is source[name..], 0: arena[name..]
    name: i64
    name_len: i64
    value: Value
    is_const: i32
    prev: i64       # older binding in the same scope, -1 at the end

struct Scope
    parent: i64     # -1 for the global scope
    last: i64       # newest binding, -1 if none
    is_function: i32  # function or global scope: where `var` declares

struct Prop
    in_src: i32
    key: i64
    key_len: i64
    value: Value
    next: i64       # next property in insertion order, -1 at the end

struct JsObject
    first: i64
    last: i64
    is_error: i32   # prints and converts as "name: message"
    frozen: i32     # Object.freeze was called (no actual write check yet)

# One array element slot; slots are a linked list in index order, like Props
struct Elem
    value: Value
    next: i64       # next slot, -1 at the end

struct JsArray
    first: i64      # element 0, -1 if empty
    last: i64
    len: i64
    obj: i64        # JsObject holding non-index properties (a.foo, a[-1])

struct FuncRec
    node: i64       # AstTag.FunctionDecl / AstTag.FunctionExpr node
    scope: i64      # closure scope

struct Interp
    parser: Parser
    src: StrView
    arena: Vec<u8>
    scopes: Vec<Scope>
    bindings: Vec<Binding>
    objects: Vec<JsObject>
    props: Vec<Prop>
    arrays: Vec<JsArray>
    elems: Vec<Elem>
    funcs: Vec<FuncRec>
    lit_start: Vec<i64>   # per AST node: arena start of a decoded string literal, -1 if not yet
    lit_len: Vec<i64>
    line: Vec<u8>         # console.log builds a line here
    out: Vec<u8>          # what console.log printed (flushed to stdout when echo)
    err: Vec<u8>          # why the run failed
    echo: i32
    failed: i32
    scope: i64            # current scope
    global: i64
    ctl: i32
    ret: Value            # returned or thrown value
    depth: i64

# =============================================================================
# Value Constructors
# =============================================================================

fn v_undef() -> Value
    Value { tag: V_UNDEFINED, num: 0.0, a: 0, b: 0 }

fn v_null() -> Value
    Value { tag: V_NULL, num: 0.0, a: 0, b: 0 }

fn v_bool(b: i32) -> Value
    var r = Value { tag: V_BOOL, num: 0.0, a: 0, b: 0 }
    if b != 0
        r.a = 1
    r

fn v_num(n: f64) -> Value
    Value { tag: V_NUMBER, num: n, a: 0, b: 0 }

fn v_str(start: i64, len: i64) -> Value
    Value { tag: V_STRING, num: 0.0, a: start, b: len }

fn v_tagged(tag: i32, a: i64) -> Value
    Value { tag: tag, num: 0.0, a: a, b: 0 }

fn f64_nan() -> f64
    let z: f64 = 0.0
    z / z

fn f64_inf() -> f64
    let z: f64 = 0.0
    1.0 / z

# =============================================================================
# Byte Buffers and Number Formatting
# =============================================================================

fn buf_push_sv(buf: @&Vec<u8>, s: StrView)
    let n = s.len()
    var i: i64 = 0
    while i < n
        buf.push(s.get(i))
        i = i + 1

# The rounding error of p = a * b: a * b == p + mul_err(a, b, p) exactly
# (Dekker: split each factor into 26-bit halves whose products are exact)
fn mul_err(a: f64, b: f64, p: f64) -> f64
    let ca: f64 = 134217729.0 * a   # 2^27 + 1
    let ahi: f64 = ca - (ca - a)
    let alo: f64 = a - ahi
    let cb: f64 = 134217729.0 * b
    let bhi: f64 = cb - (cb - b)
    let blo: f64 = b - bhi
    ((ahi * bhi - p) + ahi * blo + alo * bhi) + alo * blo

# Append JavaScript's Number::toString of x: the shortest digit string
# that reads back as x, laid out as ECMA-262 says (plain up to 21 integer
# digits, 0.000001 and up without an exponent, else d.ddde+N). Exact at
# every decimal scale; the digits come from src/float.ritz (AGAST #4076).
fn buf_push_number(buf: @&Vec<u8>, x: f64)
    float_push_number(buf, x)

# =============================================================================
# Math helpers for ** with a fractional exponent
# =============================================================================

# Split double-double ln2 so k*ln2 keeps its low bits (fdlibm's constants)
const LN2_HI: f64 = 0.6931471803691238
const LN2_LO: f64 = 1.9082149292705877e-10

fn f64_ln(x: f64) -> f64
    # x = m * 2^k with m in [1, 2); ln(m) = 2 atanh((m - 1) / (m + 1))
    var m: f64 = x
    var k: i64 = 0
    while m >= 2.0
        m = m / 2.0
        k = k + 1
    while m < 1.0
        m = m * 2.0
        k = k - 1
    let t: f64 = (m - 1.0) / (m + 1.0)
    let t2: f64 = t * t
    var term: f64 = t
    var sum: f64 = 0.0
    var i: i64 = 1
    while i < 60
        sum = sum + term / (i as f64)
        term = term * t2
        i = i + 2
    2.0 * sum + ((k as f64) * LN2_HI + (k as f64) * LN2_LO)

# Math.log's domain handling around f64_ln (which loops for m == 0)
fn f64_log(x: f64) -> f64
    if x != x or x < 0.0
        return f64_nan()
    if x == 0.0
        return 0.0 - f64_inf()
    if x > 1.7976931348623157e308
        return x
    f64_ln(x)

# log2 by binary exponent decomposition, so exact powers of two are exact
fn f64_log2(x: f64) -> f64
    if x != x or x < 0.0
        return f64_nan()
    if x == 0.0
        return 0.0 - f64_inf()
    if x > 1.7976931348623157e308
        return x
    var m: f64 = x
    var k: i64 = 0
    while m >= 2.0
        m = m / 2.0
        k = k + 1
    while m < 1.0
        m = m * 2.0
        k = k - 1
    if m == 1.0
        return k as f64
    (k as f64) + f64_ln(m) / 0.6931471805599453

# log10 by decimal exponent decomposition, so exact powers of ten are exact
fn f64_log10(x: f64) -> f64
    if x != x or x < 0.0
        return f64_nan()
    if x == 0.0
        return 0.0 - f64_inf()
    if x > 1.7976931348623157e308
        return x
    var m: f64 = x
    var e: i64 = 0
    while m >= 10.0
        m = m / 10.0
        e = e + 1
    while m < 1.0
        m = m * 10.0
        e = e - 1
    if m == 1.0
        return e as f64
    (e as f64) + f64_ln(m) / 2.302585092994046

fn f64_exp(y: f64) -> f64
    if y > 709.8
        return f64_inf()
    if y < -745.2
        return 0.0
    # y = k ln2 + r, |r| <= ln2 / 2, then exp(r) by fdlibm's rational
    # approximation (more accurate than a plain Taylor sum)
    let ln2: f64 = 0.6931471805599453
    var k: i64 = 0
    if y >= 0.0
        k = (y / ln2 + 0.5) as i64
    else
        k = (y / ln2 - 0.5) as i64
    let hi: f64 = y - (k as f64) * LN2_HI
    let lo: f64 = (k as f64) * LN2_LO
    let r: f64 = hi - lo
    let t: f64 = r * r
    let c: f64 = r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))))
    var e: f64 = 0.0
    if k == 0
        e = 1.0 - ((r * c) / (c - 2.0) - r)
    else
        e = 1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
    while k > 0
        e = e * 2.0
        k = k - 1
    while k < 0
        e = e / 2.0
        k = k + 1
    e

# r * r - x without rounding error in r * r
fn sqr_residual(r: f64, x: f64) -> f64
    let p: f64 = r * r
    (p - x) + mul_err(r, r, p)

fn f64_abs(x: f64) -> f64
    if x < 0.0
        return 0.0 - x
    if x == 0.0
        return 0.0           # Math.abs(-0) is +0
    x

# Correctly rounded square root: Newton's iteration, then the neighbour
# (one ulp either side) whose square is nearest x
fn f64_sqrt(x: f64) -> f64
    if x != x or x < 0.0
        return f64_nan()
    if x == 0.0 or x > 1.7976931348623157e308
        return x
    # Start from a power-of-two estimate
    var r: f64 = 1.0
    while r * r < x
        r = r * 2.0
    while r * r > x * 4.0
        r = r / 2.0
    var i: i64 = 0
    while i < 80
        let next: f64 = 0.5 * (r + x / r)
        if next == r
            break
        r = next
        i = i + 1
    let step: f64 = r * 1.1102230246251565e-16   # >= half an ulp of r
    let down: f64 = r - step
    let up: f64 = r + step
    var best: f64 = r
    if f64_abs(sqr_residual(down, x)) < f64_abs(sqr_residual(best, x))
        best = down
    if f64_abs(sqr_residual(up, x)) < f64_abs(sqr_residual(best, x))
        best = up
    best

fn f64_pow(base: f64, ex: f64) -> f64
    if ex != ex
        return f64_nan()
    if ex == 0.0
        return 1.0
    if base != base
        return f64_nan()
    # Integer exponent: square-and-multiply (exact where the result is)
    if ex > -1.0e9 and ex < 1.0e9 and ((ex as i64) as f64) == ex
        var n: i64 = ex as i64
        var neg: i32 = 0
        if n < 0
            neg = 1
            n = 0 - n
        var r: f64 = 1.0
        var b: f64 = base
        while n > 0
            if n % 2 == 1
                r = r * b
            b = b * b
            n = n / 2
        if neg == 1
            return 1.0 / r
        return r
    if base < 0.0
        return f64_nan()
    if ex == 0.5
        return f64_sqrt(base)
    if base == 0.0
        if ex > 0.0
            return 0.0
        return f64_inf()
    f64_exp(ex * f64_ln(base))

# ToInt32 as i64 (wraps modulo 2^32)
fn to_int32_f(x: f64) -> i64
    if x != x or x > 1.7976931348623157e308 or x < -1.7976931348623157e308
        return 0
    var m: f64 = x % 4294967296.0
    var t: i64 = m as i64
    if t < 0
        t = t + 4294967296
    if t >= 2147483648
        t = t - 4294967296
    t

fn to_uint32_f(x: f64) -> i64
    var t = to_int32_f(x)
    if t < 0
        t = t + 4294967296
    t

# 1 if x is neither NaN nor an infinity
fn f64_is_finite(x: f64) -> i32
    if x != x
        return 0
    if x > 1.7976931348623157e308 or x < -1.7976931348623157e308
        return 0
    1

# 1 if x is negative zero (-0 compares equal to 0, so check the sign bit)
fn is_neg_zero(x: f64) -> i32
    if x != 0.0
        return 0
    if 1.0 / x < 0.0
        return 1
    0

# Math.floor / ceil / trunc: values outside i64 range are already integral
fn f64_floor(x: f64) -> f64
    if x != x
        return x
    if x == 0.0
        return x            # preserve -0
    if x > 1.0e18 or x < -1.0e18
        return x            # includes +/-Infinity
    let t = x as i64
    var tf = t as f64
    if tf > x
        tf = tf - 1.0
    tf

fn f64_ceil(x: f64) -> f64
    if x != x
        return x
    if x == 0.0
        return x
    if x > 1.0e18 or x < -1.0e18
        return x
    let t = x as i64
    var tf = t as f64
    if tf < x
        tf = tf + 1.0
    tf

fn f64_trunc(x: f64) -> f64
    if x != x
        return x
    if x == 0.0
        return x
    if x > 1.0e18 or x < -1.0e18
        return x
    let t = x as i64
    let tf = t as f64
    if tf == 0.0 and x < 0.0
        return -1.0 * 0.0  # trunc(-0.9) is -0
    tf

# Math.round: nearest integer, ties toward +Infinity; -0 for (-0.5, 0]
fn f64_round(x: f64) -> f64
    if x != x
        return x
    if x == 0.0
        return x
    if x > 1.0e18 or x < -1.0e18
        return x
    let f = f64_floor(x + 0.5)
    if f == 0.0 and x < 0.0
        return -1.0 * 0.0
    f

fn f64_sign(x: f64) -> f64
    if x != x
        return x
    if x > 0.0
        return 1.0
    if x < 0.0
        return 0.0 - 1.0
    x                    # 0 or -0

# Math.cbrt: Newton's iteration on the absolute value, sign restored
fn f64_cbrt(x: f64) -> f64
    if x != x or x == 0.0
        return x
    if x > 1.7976931348623157e308 or x < -1.7976931348623157e308
        return x
    var neg: i32 = 0
    var a: f64 = x
    if a < 0.0
        neg = 1
        a = 0.0 - a
    var r: f64 = a
    var i: i64 = 0
    while i < 200
        let next: f64 = (2.0 * r + a / (r * r)) / 3.0
        if next == r
            break
        r = next
        i = i + 1
    if neg == 1
        return 0.0 - r
    r

# =============================================================================
# Construction
# =============================================================================

fn interp_new(source: StrView, echo: i32) -> Interp
    Interp {
        parser: parse(source),
        src: source,
        arena: vec_new<u8>(),
        scopes: vec_new<Scope>(),
        bindings: vec_new<Binding>(),
        objects: vec_new<JsObject>(),
        props: vec_new<Prop>(),
        arrays: vec_new<JsArray>(),
        elems: vec_new<Elem>(),
        funcs: vec_new<FuncRec>(),
        lit_start: vec_new<i64>(),
        lit_len: vec_new<i64>(),
        line: vec_new<u8>(),
        out: vec_new<u8>(),
        err: vec_new<u8>(),
        echo: echo,
        failed: 0,
        scope: -1,
        global: -1,
        ctl: CTL_NORMAL,
        ret: v_undef(),
        depth: 0
    }

fn node_at(it: @&Interp, idx: i64) -> *AstNode
    it.parser.ast.nodes.get_ptr(idx)

fn child_at(it: @&Interp, start: i64, i: i64) -> i64
    ast_get_child(@it.parser.ast, start, i)

# Source text of a node (for error messages)
fn node_text(it: @&Interp, idx: i64) -> StrView
    let node = node_at(it, idx)
    it.src.slice(node.start, node.end_pos)

fn ident_text(it: @&Interp, idx: i64) -> StrView
    let node = node_at(it, idx)
    it.src.slice(node.str_start, node.str_start + node.str_len)

# =============================================================================
# Strings
# =============================================================================

fn str_from_sv(it: @&Interp, s: StrView) -> Value
    let start = it.arena.len()
    buf_push_sv(@&it.arena, s)
    v_str(start, s.len())

# arena[start..start + len] as text
fn arena_view(it: @&Interp, start: i64, len: i64) -> StrView
    let s: [u8] = it.arena[start..start + len]
    s.as_strview()

fn str_view(it: @&Interp, v: Value) -> StrView
    arena_view(it, v.a, v.b)

fn str_eq(it: @&Interp, x: Value, y: Value) -> i32
    if x.b != y.b
        return 0
    var i: i64 = 0
    while i < x.b
        if it.arena.get(x.a + i) != it.arena.get(y.a + i)
            return 0
        i = i + 1
    1

# -1, 0, 1 by bytes
fn str_cmp(it: @&Interp, x: Value, y: Value) -> i32
    var i: i64 = 0
    while i < x.b and i < y.b
        let cx = it.arena.get(x.a + i)
        let cy = it.arena.get(y.a + i)
        if cx < cy
            return -1
        if cx > cy
            return 1
        i = i + 1
    if x.b < y.b
        return -1
    if x.b > y.b
        return 1
    0

fn hex_val(c: u8) -> i64
    if c >= 48 and c <= 57
        return (c - 48) as i64
    if c >= 97 and c <= 102
        return (c - 87) as i64
    if c >= 65 and c <= 70
        return (c - 55) as i64
    -1

fn push_utf8(buf: @&Vec<u8>, cp: i64)
    if cp < 128
        buf.push(cp as u8)
    else if cp < 2048
        buf.push((192 + cp / 64) as u8)
        buf.push((128 + cp % 64) as u8)
    else
        buf.push((224 + cp / 4096) as u8)
        buf.push((128 + (cp / 64) % 64) as u8)
        buf.push((128 + cp % 64) as u8)

# Decode a string literal's escapes into the arena, once per node
fn string_literal(it: @&Interp, idx: i64) -> Value
    let cached = it.lit_start.get(idx)
    if cached >= 0
        return v_str(cached, it.lit_len.get(idx))
    let node = node_at(it, idx)
    let s = node.str_start
    let n = node.str_len
    let start = it.arena.len()
    var i: i64 = 0
    while i < n
        let c: u8 = it.src.get(s + i)
        if c != 92 or i + 1 >= n
            it.arena.push(c)
            i = i + 1
            continue
        let e: u8 = it.src.get(s + i + 1)
        i = i + 2
        if e == 110
            it.arena.push(10)      # \n
        else if e == 116
            it.arena.push(9)       # \t
        else if e == 114
            it.arena.push(13)      # \r
        else if e == 98
            it.arena.push(8)       # \b
        else if e == 102
            it.arena.push(12)      # \f
        else if e == 118
            it.arena.push(11)      # \v
        else if e == 48
            it.arena.push(0)       # \0
        else if e == 10
            i = i  # line continuation: nothing
        else if e == 120 and i + 1 < n
            # \xHH
            let h1 = hex_val(it.src.get(s + i))
            let h2 = hex_val(it.src.get(s + i + 1))
            if h1 >= 0 and h2 >= 0
                push_utf8(@&it.arena, h1 * 16 + h2)
                i = i + 2
            else
                it.arena.push(e)
        else if e == 117 and i + 3 < n
            # \uHHHH
            var cp: i64 = 0
            var j: i64 = 0
            var ok: i32 = 1
            while j < 4
                let h = hex_val(it.src.get(s + i + j))
                if h < 0
                    ok = 0
                cp = cp * 16 + h
                j = j + 1
            if ok == 1
                push_utf8(@&it.arena, cp)
                i = i + 4
            else
                it.arena.push(e)
        else
            it.arena.push(e)       # \\ \' \" and the rest
    let len = it.arena.len() - start
    it.lit_start.set(idx, start)
    it.lit_len.set(idx, len)
    v_str(start, len)

# =============================================================================
# Names (bindings and property keys)
# =============================================================================

fn name_byte(it: @&Interp, in_src: i32, i: i64) -> u8
    if in_src == 1
        return it.src.get(i)
    it.arena.get(i)

fn names_eq(it: @&Interp, s1: i32, a1: i64, l1: i64, s2: i32, a2: i64, l2: i64) -> i32
    if l1 != l2
        return 0
    var i: i64 = 0
    while i < l1
        if name_byte(it, s1, a1 + i) != name_byte(it, s2, a2 + i)
            return 0
        i = i + 1
    1

fn name_view(it: @&Interp, in_src: i32, start: i64, len: i64) -> StrView
    if in_src == 1
        return it.src.slice(start, start + len)
    arena_view(it, start, len)

# =============================================================================
# Scopes
# =============================================================================

fn scope_new(it: @&Interp, parent: i64, is_function: i32) -> i64
    let idx = it.scopes.len()
    it.scopes.push(Scope { parent: parent, last: -1, is_function: is_function })
    idx

# Binding of a name in exactly this scope, -1 if none
fn scope_find_own(it: @&Interp, scope: i64, in_src: i32, name: i64, len: i64) -> i64
    let sc = it.scopes.get(scope)
    var b: i64 = sc.last
    while b >= 0
        let bp = it.bindings.get_ptr(b)
        if names_eq(it, bp.in_src, bp.name, bp.name_len, in_src, name, len) == 1
            return b
        b = bp.prev
    -1

# Binding visible from `scope`, -1 if none
fn lookup(it: @&Interp, scope: i64, in_src: i32, name: i64, len: i64) -> i64
    var s: i64 = scope
    while s >= 0
        let b = scope_find_own(it, s, in_src, name, len)
        if b >= 0
            return b
        s = it.scopes.get(s).parent
    -1

# Declare (or redeclare) a name in `scope`
fn declare(it: @&Interp, scope: i64, in_src: i32, name: i64, len: i64, value: Value, is_const: i32) -> i64
    let own = scope_find_own(it, scope, in_src, name, len)
    if own >= 0
        let bp = it.bindings.get_ptr(own)
        bp.value = value
        bp.is_const = is_const
        return own
    let idx = it.bindings.len()
    let sp = it.scopes.get_ptr(scope)
    let prev = sp.last
    it.bindings.push(Binding {
        in_src: in_src,
        name: name,
        name_len: len,
        value: value,
        is_const: is_const,
        prev: prev
    })
    let sp2 = it.scopes.get_ptr(scope)
    sp2.last = idx
    idx

fn declare_builtin(it: @&Interp, name: StrView, value: Value)
    let s = str_from_sv(it, name)
    declare(it, it.global, 0, s.a, s.b, value, 0)

fn function_scope(it: @&Interp) -> i64
    var s: i64 = it.scope
    while s >= 0
        if it.scopes.get(s).is_function == 1
            return s
        s = it.scopes.get(s).parent
    it.global

# =============================================================================
# Objects
# =============================================================================

fn obj_new(it: @&Interp) -> Value
    let idx = it.objects.len()
    it.objects.push(JsObject { first: -1, last: -1, is_error: 0, frozen: 0 })
    v_tagged(V_OBJECT, idx)

fn prop_find(it: @&Interp, obj: i64, in_src: i32, key: i64, len: i64) -> i64
    var p: i64 = it.objects.get(obj).first
    while p >= 0
        let pp = it.props.get_ptr(p)
        if names_eq(it, pp.in_src, pp.key, pp.key_len, in_src, key, len) == 1
            return p
        p = pp.next
    -1

fn prop_get(it: @&Interp, obj: i64, in_src: i32, key: i64, len: i64) -> Value
    let p = prop_find(it, obj, in_src, key, len)
    if p < 0
        return v_undef()
    it.props.get(p).value

fn prop_set(it: @&Interp, obj: i64, in_src: i32, key: i64, len: i64, value: Value)
    let p = prop_find(it, obj, in_src, key, len)
    if p >= 0
        let pp = it.props.get_ptr(p)
        pp.value = value
        return
    let idx = it.props.len()
    it.props.push(Prop { in_src: in_src, key: key, key_len: len, value: value, next: -1 })
    let op = it.objects.get_ptr(obj)
    if op.last < 0
        op.first = idx
    else
        let lp = it.props.get_ptr(op.last)
        lp.next = idx
    let op2 = it.objects.get_ptr(obj)
    op2.last = idx

fn prop_set_sv(it: @&Interp, obj: i64, key: StrView, value: Value)
    let k = str_from_sv(it, key)
    prop_set(it, obj, 0, k.a, k.b, value)

fn prop_get_sv(it: @&Interp, obj: i64, key: StrView) -> Value
    let k = str_from_sv(it, key)
    prop_get(it, obj, 0, k.a, k.b)

# =============================================================================
# Arrays
# =============================================================================
#
# A JsArray holds an insertion-ordered linked list of Elem slots (index order),
# so an array's elements live in the interpreter's `elems` vector and grow
# without moving the array record. Non-index properties share the JsObject
# machinery with plain objects. Element elisions (`[1, , 3]`) evaluate to
# undefined, so they print as `undefined` rather than node's `<1 empty item>`;
# push/pop are bound methods on each array (a.push captured and called later
# still mutates a, unlike node).

fn arr_new(it: @&Interp) -> Value
    let idx = it.arrays.len()
    let o = obj_new(it)
    it.arrays.push(JsArray { first: -1, last: -1, len: 0, obj: o.a })
    v_tagged(V_ARRAY, idx)

fn arr_len(it: @&Interp, arr: i64) -> i64
    it.arrays.get(arr).len

# Slot holding element `i`, -1 outside 0 .. len-1
fn arr_slot(it: @&Interp, arr: i64, i: i64) -> i64
    if i < 0 or i >= arr_len(it, arr)
        return -1
    var p: i64 = it.arrays.get(arr).first
    var k: i64 = 0
    while p >= 0 and k < i
        p = it.elems.get(p).next
        k = k + 1
    p

fn arr_get(it: @&Interp, arr: i64, i: i64) -> Value
    let p = arr_slot(it, arr, i)
    if p < 0
        return v_undef()
    it.elems.get(p).value

# Append one element (no bounds check; callers extend deliberately)
fn arr_append(it: @&Interp, arr: i64, value: Value)
    let idx = it.elems.len()
    it.elems.push(Elem { value: value, next: -1 })
    let ap = it.arrays.get_ptr(arr)
    if ap.last < 0
        ap.first = idx
    else
        let lp = it.elems.get_ptr(ap.last)
        lp.next = idx
    let ap2 = it.arrays.get_ptr(arr)
    ap2.last = idx
    ap2.len = ap2.len + 1

fn arr_set_index(it: @&Interp, arr: i64, i: i64, value: Value)
    if i >= MAX_ARRAY_LEN
        throw_error(it, "RangeError", "Array index too large", "")
        return
    while arr_len(it, arr) <= i
        arr_append(it, arr, v_undef())
    let p = arr_slot(it, arr, i)
    if p >= 0
        it.elems.get_ptr(p).value = value

# Set the length: truncate (dropping the tail) or extend with undefined
fn arr_set_len(it: @&Interp, arr: i64, n: i64)
    let len = arr_len(it, arr)
    if n < len
        if n == 0
            let ap = it.arrays.get_ptr(arr)
            ap.first = -1
            ap.last = -1
            ap.len = 0
        else
            let p = arr_slot(it, arr, n - 1)
            it.elems.get_ptr(p).next = -1
            let ap = it.arrays.get_ptr(arr)
            ap.last = p
            ap.len = n
    else
        while arr_len(it, arr) < n
            arr_append(it, arr, v_undef())

fn arr_push_values(it: @&Interp, arr: i64, args: @Vec<Value>) -> Value
    let n = args.len()
    var i: i64 = 0
    while i < n
        arr_append(it, arr, args.get(i))
        i = i + 1
    v_num(arr_len(it, arr) as f64)

fn arr_pop_value(it: @&Interp, arr: i64) -> Value
    let len = arr_len(it, arr)
    if len == 0
        return v_undef()
    let v = arr_get(it, arr, len - 1)
    arr_set_len(it, arr, len - 1)
    v

# Canonical array index for a property key: 0 .. 2^32 - 2, else -1
fn key_index(it: @&Interp, key: Key) -> i64
    if key.len <= 0 or key.len > 10
        return -1
    if key.len > 1 and name_byte(it, key.in_src, key.start) == 48
        return -1
    var i: i64 = 0
    var v: i64 = 0
    while i < key.len
        let c = name_byte(it, key.in_src, key.start + i)
        if c < 48 or c > 57
            return -1
        v = v * 10 + (c - 48) as i64
        i = i + 1
    if v > 4294967294
        return -1
    v

fn key_is(it: @&Interp, key: Key, name: StrView) -> i32
    if name_view(it, key.in_src, key.start, key.len).eq(name)
        return 1
    0

# String.prototype: .length and the methods this interpreter implements,
# bound to the receiver string
fn string_get(it: @&Interp, s: Value, key: Key) -> Value
    if key_is(it, key, "length") == 1
        return v_num(s.b as f64)
    if key_is(it, key, "charAt") == 1
        return v_str_method(s, NATIVE_STR_CHAR_AT)
    if key_is(it, key, "charCodeAt") == 1
        return v_str_method(s, NATIVE_STR_CHAR_CODE_AT)
    if key_is(it, key, "indexOf") == 1
        return v_str_method(s, NATIVE_STR_INDEX_OF)
    if key_is(it, key, "includes") == 1
        return v_str_method(s, NATIVE_STR_INCLUDES)
    if key_is(it, key, "startsWith") == 1
        return v_str_method(s, NATIVE_STR_STARTS_WITH)
    if key_is(it, key, "endsWith") == 1
        return v_str_method(s, NATIVE_STR_ENDS_WITH)
    if key_is(it, key, "slice") == 1
        return v_str_method(s, NATIVE_STR_SLICE)
    if key_is(it, key, "substring") == 1
        return v_str_method(s, NATIVE_STR_SUBSTRING)
    if key_is(it, key, "toUpperCase") == 1
        return v_str_method(s, NATIVE_STR_TO_UPPER)
    if key_is(it, key, "toLowerCase") == 1
        return v_str_method(s, NATIVE_STR_TO_LOWER)
    if key_is(it, key, "trim") == 1
        return v_str_method(s, NATIVE_STR_TRIM)
    if key_is(it, key, "repeat") == 1
        return v_str_method(s, NATIVE_STR_REPEAT)
    if key_is(it, key, "concat") == 1
        return v_str_method(s, NATIVE_STR_CONCAT)
    v_undef()

# Statics on the callable String / Number / Object globals (typeof function)
fn native_static(it: @&Interp, id: i64, key: Key) -> Value
    if id == NATIVE_NUMBER_CALL
        if key_is(it, key, "isInteger") == 1
            return v_tagged(V_NATIVE, NATIVE_NUMBER_IS_INTEGER)
        if key_is(it, key, "isNaN") == 1
            return v_tagged(V_NATIVE, NATIVE_NUMBER_IS_NAN)
        if key_is(it, key, "isFinite") == 1
            return v_tagged(V_NATIVE, NATIVE_NUMBER_IS_FINITE)
        if key_is(it, key, "isSafeInteger") == 1
            return v_tagged(V_NATIVE, NATIVE_NUMBER_IS_SAFE_INTEGER)
        if key_is(it, key, "MAX_SAFE_INTEGER") == 1
            return v_num(9007199254740991.0)
        if key_is(it, key, "MIN_SAFE_INTEGER") == 1
            return v_num(-9007199254740991.0)
        if key_is(it, key, "EPSILON") == 1
            return v_num(2.220446049250313e-16)
        if key_is(it, key, "MAX_VALUE") == 1
            return v_num(1.7976931348623157e308)
        if key_is(it, key, "MIN_VALUE") == 1
            return v_num(5e-324)
        if key_is(it, key, "POSITIVE_INFINITY") == 1
            return v_num(f64_inf())
        if key_is(it, key, "NEGATIVE_INFINITY") == 1
            return v_num(0.0 - f64_inf())
        if key_is(it, key, "NaN") == 1
            return v_num(f64_nan())
        return v_undef()
    if id == NATIVE_OBJECT_CALL
        if key_is(it, key, "keys") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_KEYS)
        if key_is(it, key, "values") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_VALUES)
        if key_is(it, key, "entries") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_ENTRIES)
        if key_is(it, key, "assign") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_ASSIGN)
        if key_is(it, key, "is") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_IS)
        if key_is(it, key, "freeze") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_FREEZE)
        if key_is(it, key, "isFrozen") == 1
            return v_tagged(V_NATIVE, NATIVE_OBJECT_IS_FROZEN)
        return v_undef()
    v_undef()

# A native function bound to its receiver array
fn v_method(recv: i64, id: i64) -> Value
    Value { tag: V_NATIVE, num: 0.0, a: id, b: recv }

fn array_get(it: @&Interp, arr: i64, key: Key) -> Value
    let ix = key_index(it, key)
    if ix >= 0
        return arr_get(it, arr, ix)
    if key_is(it, key, "length") == 1
        return v_num(arr_len(it, arr) as f64)
    let o = it.arrays.get(arr).obj
    let p = prop_find(it, o, key.in_src, key.start, key.len)
    if p >= 0
        return it.props.get(p).value
    if key_is(it, key, "push") == 1
        return v_method(arr, NATIVE_ARRAY_PUSH)
    if key_is(it, key, "pop") == 1
        return v_method(arr, NATIVE_ARRAY_POP)
    v_undef()

fn array_write(it: @&Interp, arr: i64, key: Key, value: Value)
    let ix = key_index(it, key)
    if ix >= 0
        arr_set_index(it, arr, ix, value)
        return
    if key_is(it, key, "length") == 1
        let n = to_number(it, value)
        if n != n or n < 0.0 or n > 4294967295.0 or ((n as i64) as f64) != n
            throw_error(it, "RangeError", "Invalid array length", "")
            return
        if n > (MAX_ARRAY_LEN as f64)
            throw_error(it, "RangeError", "Array length too large", "")
            return
        arr_set_len(it, arr, n as i64)
        return
    let o = it.arrays.get(arr).obj
    prop_set(it, o, key.in_src, key.start, key.len, value)

# =============================================================================
# Throwing
# =============================================================================

# Throw a new Error object: name `kind`, message a + b
fn throw_error(it: @&Interp, kind: StrView, a: StrView, b: StrView)
    let start = it.arena.len()
    buf_push_sv(@&it.arena, a)
    buf_push_sv(@&it.arena, b)
    let msg = v_str(start, it.arena.len() - start)
    let name = str_from_sv(it, kind)
    let err = obj_new(it)
    let op = it.objects.get_ptr(err.a)
    op.is_error = 1
    prop_set_sv(it, err.a, "name", name)
    prop_set_sv(it, err.a, "message", msg)
    it.ret = err
    it.ctl = CTL_THROW

fn throw_unsupported(it: @&Interp, what: StrView)
    throw_error(it, "SyntaxError", "sage does not support this yet: ", what)

fn threw(it: @&Interp) -> i32
    if it.ctl == CTL_THROW
        return 1
    0

# =============================================================================
# Conversions
# =============================================================================

fn to_boolean(it: @&Interp, v: Value) -> i32
    if v.tag == V_UNDEFINED or v.tag == V_NULL
        return 0
    if v.tag == V_BOOL
        return v.a as i32
    if v.tag == V_NUMBER
        if v.num != v.num or v.num == 0.0
            return 0
        return 1
    if v.tag == V_STRING
        if v.b == 0
            return 0
        return 1
    1

fn is_space(c: u8) -> i32
    if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12
        return 1
    0

fn is_digit_byte(c: u8) -> i32
    if c >= 48 and c <= 57
        return 1
    0

# ToNumber of a string: trimmed decimal literal, "" -> 0, else NaN
fn string_to_number(it: @&Interp, v: Value) -> f64
    var s: i64 = 0
    var e: i64 = v.b
    while s < e and is_space(it.arena.get(v.a + s)) == 1
        s = s + 1
    while e > s and is_space(it.arena.get(v.a + e - 1)) == 1
        e = e - 1
    if s == e
        return 0.0
    var neg: i32 = 0
    let c0 = it.arena.get(v.a + s)
    if c0 == 45 or c0 == 43
        if c0 == 45
            neg = 1
        s = s + 1
    let body = arena_view(it, v.a + s, e - s)
    var r: f64 = 0.0
    if body.eq("Infinity")
        r = f64_inf()
    else
        # digits [. digits] [e [+-] digits], at least one mantissa digit
        var i: i64 = s
        var mant_digits: i64 = 0
        while i < e and is_digit_byte(it.arena.get(v.a + i)) == 1
            i = i + 1
            mant_digits = mant_digits + 1
        if i < e and it.arena.get(v.a + i) == 46
            i = i + 1
            while i < e and is_digit_byte(it.arena.get(v.a + i)) == 1
                i = i + 1
                mant_digits = mant_digits + 1
        if mant_digits == 0
            return f64_nan()
        if i < e and (it.arena.get(v.a + i) == 101 or it.arena.get(v.a + i) == 69)
            i = i + 1
            if i < e and (it.arena.get(v.a + i) == 43 or it.arena.get(v.a + i) == 45)
                i = i + 1
            var exp_digits: i64 = 0
            while i < e and is_digit_byte(it.arena.get(v.a + i)) == 1
                i = i + 1
                exp_digits = exp_digits + 1
            if exp_digits == 0
                return f64_nan()
        if i != e
            return f64_nan()
        r = strview_to_f64(body)
    if neg == 1
        return 0.0 - r
    r

fn to_number(it: @&Interp, v: Value) -> f64
    if v.tag == V_NUMBER
        return v.num
    if v.tag == V_NULL
        return 0.0
    if v.tag == V_BOOL
        return v.a as f64
    if v.tag == V_STRING
        return string_to_number(it, v)
    f64_nan()

fn func_name(it: @&Interp, v: Value) -> StrView
    if v.tag == V_NATIVE
        if v.a == NATIVE_CONSOLE_ERROR
            return "error"
        if v.a == NATIVE_ARRAY_PUSH
            return "push"
        if v.a == NATIVE_ARRAY_POP
            return "pop"
        return "log"
    let rec = it.funcs.get(v.a)
    let fnode = node_at(it, rec.node)
    if fnode.child1 == NO_CHILD
        return ""
    ident_text(it, fnode.child1)

# Append ToString(v) to buf
fn push_to_string(it: @&Interp, buf: @&Vec<u8>, v: Value)
    if v.tag == V_UNDEFINED
        buf_push_sv(buf, "undefined")
    else if v.tag == V_NULL
        buf_push_sv(buf, "null")
    else if v.tag == V_BOOL
        if v.a == 1
            buf_push_sv(buf, "true")
        else
            buf_push_sv(buf, "false")
    else if v.tag == V_NUMBER
        buf_push_number(buf, v.num)
    else if v.tag == V_STRING
        var i: i64 = 0
        while i < v.b
            buf.push(it.arena.get(v.a + i))
            i = i + 1
    else if v.tag == V_ARRAY
        # Array.prototype.toString: elements joined by ",", null and
        # undefined contributing nothing
        let len = arr_len(it, v.a)
        var i: i64 = 0
        var p: i64 = it.arrays.get(v.a).first
        while i < len and p >= 0
            if i > 0
                buf_push_sv(buf, ",")
            let e = it.elems.get(p)
            if e.value.tag != V_UNDEFINED and e.value.tag != V_NULL
                push_to_string(it, buf, e.value)
            p = e.next
            i = i + 1
    else if v.tag == V_OBJECT
        if it.objects.get(v.a).is_error == 1
            # Error.prototype.toString: "name: message"
            push_to_string(it, buf, prop_get_sv(it, v.a, "name"))
            let msg = prop_get_sv(it, v.a, "message")
            if msg.tag != V_STRING or msg.b > 0
                buf_push_sv(buf, ": ")
                push_to_string(it, buf, msg)
        else
            buf_push_sv(buf, "[object Object]")
    else
        buf_push_sv(buf, "function ")
        buf_push_sv(buf, func_name(it, v))
        buf_push_sv(buf, "() { [code] }")

fn to_string(it: @&Interp, v: Value) -> Value
    if v.tag == V_STRING
        return v
    var tmp = vec_new<u8>()
    push_to_string(it, @&tmp, v)
    let start = it.arena.len()
    var i: i64 = 0
    let n = tmp.len()
    while i < n
        it.arena.push(tmp.get(i))
        i = i + 1
    v_str(start, n)

# =============================================================================
# Built-in call helpers
# =============================================================================

# Argument i, or undefined when the call passed fewer
fn nth_arg(args: @Vec<Value>, i: i64) -> Value
    if i < args.len()
        return args.get(i)
    v_undef()

# ToIntegerOrInfinity: NaN -> 0, truncate toward zero, keep +/-Infinity
fn to_int_or_inf(it: @&Interp, v: Value) -> f64
    let n = to_number(it, v)
    if n != n
        return 0.0
    if n > 9.0e18 or n < -9.0e18
        return n
    (n as i64) as f64

# A string method bound to its receiver: num = arena start, b = length
fn v_str_method(s: Value, id: i64) -> Value
    Value { tag: V_NATIVE, num: s.a as f64, a: id, b: s.b }

# Copy `len` bytes already in the arena to a fresh arena string. Reading each
# byte through vec_get is realloc-safe while the arena grows.
fn arena_copy(it: @&Interp, src: i64, len: i64) -> Value
    let start = it.arena.len()
    var i: i64 = 0
    while i < len
        it.arena.push(it.arena.get(src + i))
        i = i + 1
    v_str(start, len)

# Index of `needle` in `hay` at or after `from`, -1 if absent
fn str_find(it: @&Interp, hay: Value, needle: Value, from: f64) -> i64
    var f: f64 = from
    if f < 0.0
        f = 0.0
    if f > hay.b as f64
        f = hay.b as f64
    let start = f as i64
    if needle.b == 0
        return start
    if needle.b > hay.b
        return -1
    var i: i64 = start
    while i + needle.b <= hay.b
        var j: i64 = 0
        var ok: i32 = 1
        while j < needle.b
            if it.arena.get(hay.a + i + j) != it.arena.get(needle.a + j)
                ok = 0
                break
            j = j + 1
        if ok == 1
            return i
        i = i + 1
    -1

# Slice with the relative-index rules of String.prototype.slice
fn str_slice_rel(it: @&Interp, s: Value, from: f64, to: f64) -> Value
    let len = s.b as f64
    var a: f64 = from
    var b: f64 = to
    if a < 0.0
        a = len + a
        if a < 0.0
            a = 0.0
    else if a > len
        a = len
    if b < 0.0
        b = len + b
        if b < 0.0
            b = 0.0
    else if b > len
        b = len
    if b < a
        b = a
    arena_copy(it, s.a + (a as i64), (b as i64) - (a as i64))

# Copy `s` with ASCII letters upper- or lower-cased (non-ASCII is unchanged)
fn str_change_case(it: @&Interp, s: Value, upper: i32) -> Value
    let r = arena_copy(it, s.a, s.b)
    var i: i64 = 0
    while i < r.b
        let c = it.arena.get(r.a + i)
        if upper == 1 and c >= 97 and c <= 122
            it.arena.set(r.a + i, c - 32)
        else if upper == 0 and c >= 65 and c <= 90
            it.arena.set(r.a + i, c + 32)
        i = i + 1
    r

# Build Object.keys' output: own enumerable keys of an object/array/string
fn own_keys(it: @&Interp, target: Value) -> Value
    let arr = arr_new(it)
    if target.tag == V_OBJECT
        var p: i64 = it.objects.get(target.a).first
        while p >= 0
            let pr = it.props.get(p)
            var k: Value = v_undef()
            if pr.in_src == 1
                k = str_from_sv(it, it.src.slice(pr.key, pr.key + pr.key_len))
            else
                k = v_str(pr.key, pr.key_len)
            arr_append(it, arr.a, k)
            p = pr.next
    else if target.tag == V_ARRAY
        var i: i64 = 0
        while i < arr_len(it, target.a)
            arr_append(it, arr.a, to_string(it, v_num(i as f64)))
            i = i + 1
    else if target.tag == V_STRING
        var i: i64 = 0
        while i < target.b
            arr_append(it, arr.a, to_string(it, v_num(i as f64)))
            i = i + 1
    arr

fn own_values(it: @&Interp, target: Value) -> Value
    let arr = arr_new(it)
    if target.tag == V_OBJECT
        var p: i64 = it.objects.get(target.a).first
        while p >= 0
            let pr = it.props.get(p)
            arr_append(it, arr.a, pr.value)
            p = pr.next
    else if target.tag == V_ARRAY
        var i: i64 = 0
        while i < arr_len(it, target.a)
            arr_append(it, arr.a, arr_get(it, target.a, i))
            i = i + 1
    else if target.tag == V_STRING
        var i: i64 = 0
        while i < target.b
            arr_append(it, arr.a, arena_copy(it, target.a + i, 1))
            i = i + 1
    arr

fn own_entries(it: @&Interp, target: Value) -> Value
    let keys = own_keys(it, target)
    let vals = own_values(it, target)
    let out = arr_new(it)
    var i: i64 = 0
    while i < arr_len(it, keys.a)
        let pair = arr_new(it)
        arr_append(it, pair.a, arr_get(it, keys.a, i))
        arr_append(it, pair.a, arr_get(it, vals.a, i))
        arr_append(it, out.a, pair)
        i = i + 1
    out

# Shallow-copy own enumerable properties of `src` onto `dst`
fn assign_into(it: @&Interp, dst: Value, src: Value)
    if src.tag == V_OBJECT and dst.tag == V_OBJECT
        var p: i64 = it.objects.get(src.a).first
        while p >= 0
            let pr = it.props.get(p)
            prop_set(it, dst.a, pr.in_src, pr.key, pr.key_len, pr.value)
            p = pr.next
    else if src.tag == V_ARRAY and dst.tag == V_ARRAY
        var i: i64 = 0
        while i < arr_len(it, src.a)
            arr_set_index(it, dst.a, i, arr_get(it, src.a, i))
            i = i + 1

# console.log's rendering: strings raw at the top level, quoted inside
# objects; functions as [Function: name]; objects as { k: v } to depth 2
fn push_inspect(it: @&Interp, buf: @&Vec<u8>, v: Value, depth: i64)
    if v.tag == V_STRING and depth > 0
        buf.push(39)
        push_to_string(it, buf, v)
        buf.push(39)
    else if v.tag == V_FUNCTION or v.tag == V_NATIVE
        let name = func_name(it, v)
        if name.len() == 0
            buf_push_sv(buf, "[Function (anonymous)]")
        else
            buf_push_sv(buf, "[Function: ")
            buf_push_sv(buf, name)
            buf_push_sv(buf, "]")
    else if v.tag == V_ARRAY
        let len = arr_len(it, v.a)
        if len == 0
            buf_push_sv(buf, "[]")
        else if depth > 2
            buf_push_sv(buf, "[Array]")
        else
            buf_push_sv(buf, "[ ")
            var i: i64 = 0
            var p: i64 = it.arrays.get(v.a).first
            while i < len and p >= 0
                let e = it.elems.get(p)
                push_inspect(it, buf, e.value, depth + 1)
                if i + 1 < len
                    buf_push_sv(buf, ", ")
                p = e.next
                i = i + 1
            buf_push_sv(buf, " ]")
    else if v.tag == V_OBJECT
        let obj = it.objects.get(v.a)
        if obj.is_error == 1
            push_to_string(it, buf, v)
        else if obj.first < 0
            buf_push_sv(buf, "{}")
        else if depth > 2
            buf_push_sv(buf, "[Object]")
        else
            buf_push_sv(buf, "{ ")
            var p: i64 = obj.first
            while p >= 0
                let pr = it.props.get(p)
                buf_push_sv(buf, name_view(it, pr.in_src, pr.key, pr.key_len))
                buf_push_sv(buf, ": ")
                push_inspect(it, buf, pr.value, depth + 1)
                if pr.next >= 0
                    buf_push_sv(buf, ", ")
                p = pr.next
            buf_push_sv(buf, " }")
    else if v.tag == V_NUMBER and v.num == 0.0 and 1.0 / v.num < 0.0
        buf_push_sv(buf, "-0")   # console.log(-0) shows the sign; String(-0) does not
    else
        push_to_string(it, buf, v)

fn type_of(v: Value) -> StrView
    if v.tag == V_UNDEFINED
        return "undefined"
    if v.tag == V_BOOL
        return "boolean"
    if v.tag == V_NUMBER
        return "number"
    if v.tag == V_STRING
        return "string"
    if v.tag == V_FUNCTION or v.tag == V_NATIVE
        return "function"
    "object"

# =============================================================================
# Operators
# =============================================================================

fn strict_equals(it: @&Interp, x: Value, y: Value) -> i32
    if x.tag != y.tag
        return 0
    if x.tag == V_UNDEFINED or x.tag == V_NULL
        return 1
    if x.tag == V_NUMBER
        if x.num == y.num
            return 1
        return 0
    if x.tag == V_STRING
        return str_eq(it, x, y)
    if x.a == y.a
        return 1
    0

fn is_objectish(v: Value) -> i32
    if v.tag == V_OBJECT or v.tag == V_FUNCTION or v.tag == V_ARRAY
        return 1
    0

fn loose_equals(it: @&Interp, x: Value, y: Value) -> i32
    if x.tag == y.tag
        return strict_equals(it, x, y)
    let xn = x.tag == V_UNDEFINED or x.tag == V_NULL
    let yn = y.tag == V_UNDEFINED or y.tag == V_NULL
    if xn or yn
        if xn and yn
            return 1
        return 0
    if x.tag == V_BOOL
        return loose_equals(it, v_num(x.a as f64), y)
    if y.tag == V_BOOL
        return loose_equals(it, x, v_num(y.a as f64))
    if (x.tag == V_NUMBER and y.tag == V_STRING) or (x.tag == V_STRING and y.tag == V_NUMBER)
        if to_number(it, x) == to_number(it, y)
            return 1
        return 0
    if is_objectish(x) == 1 or is_objectish(y) == 1
        # Compare an object by its string form with a primitive
        if x.tag == V_STRING or x.tag == V_NUMBER
            return loose_equals(it, x, to_string(it, y))
        if y.tag == V_STRING or y.tag == V_NUMBER
            return loose_equals(it, to_string(it, x), y)
    0

fn is_primitive_number_like(v: Value) -> i32
    if is_objectish(v) == 1 or v.tag == V_STRING or v.tag == V_NATIVE
        return 0
    1

# Relational comparison: 1 if x < y (or <= when or_equal), 0 otherwise
# (including when either side is NaN)
fn less_than(it: @&Interp, x: Value, y: Value, or_equal: i32) -> i32
    if x.tag == V_STRING and y.tag == V_STRING
        let c = str_cmp(it, x, y)
        if c < 0 or (or_equal == 1 and c == 0)
            return 1
        return 0
    let a = to_number(it, x)
    let b = to_number(it, y)
    if a < b or (or_equal == 1 and a == b)
        return 1
    0

fn shift_right_signed(a: i64, s: i64) -> i64
    if a < 0
        return 0 - (((0 - a) - 1) >> s) - 1
    a >> s

fn binary_op(it: @&Interp, op: i32, x: Value, y: Value) -> Value
    if op == OP_ADD
        if is_primitive_number_like(x) == 1 and is_primitive_number_like(y) == 1
            return v_num(to_number(it, x) + to_number(it, y))
        let sx = to_string(it, x)
        let sy = to_string(it, y)
        let start = it.arena.len()
        var i: i64 = 0
        while i < sx.b
            it.arena.push(it.arena.get(sx.a + i))
            i = i + 1
        i = 0
        while i < sy.b
            it.arena.push(it.arena.get(sy.a + i))
            i = i + 1
        return v_str(start, sx.b + sy.b)
    if op == OP_SUB
        return v_num(to_number(it, x) - to_number(it, y))
    if op == OP_MUL
        return v_num(to_number(it, x) * to_number(it, y))
    if op == OP_DIV
        return v_num(to_number(it, x) / to_number(it, y))
    if op == OP_MOD
        let a = to_number(it, x)
        let b = to_number(it, y)
        if b == 0.0 or a != a or b != b
            return v_num(f64_nan())
        return v_num(a % b)
    if op == OP_POW
        return v_num(f64_pow(to_number(it, x), to_number(it, y)))
    if op == OP_EQ
        return v_bool(loose_equals(it, x, y))
    if op == OP_NE
        return v_bool(1 - loose_equals(it, x, y))
    if op == OP_STRICT_EQ
        return v_bool(strict_equals(it, x, y))
    if op == OP_STRICT_NE
        return v_bool(1 - strict_equals(it, x, y))
    if op == OP_LT
        return v_bool(less_than(it, x, y, 0))
    if op == OP_GT
        return v_bool(less_than(it, y, x, 0))
    if op == OP_LE
        # a <= b is !(b < a), except that NaN makes both false
        if x.tag != V_STRING or y.tag != V_STRING
            let a = to_number(it, x)
            let b = to_number(it, y)
            if a != a or b != b
                return v_bool(0)
        return v_bool(1 - less_than(it, y, x, 0))
    if op == OP_GE
        if x.tag != V_STRING or y.tag != V_STRING
            let a = to_number(it, x)
            let b = to_number(it, y)
            if a != a or b != b
                return v_bool(0)
        return v_bool(1 - less_than(it, x, y, 0))
    let a = to_int32_f(to_number(it, x))
    let b = to_int32_f(to_number(it, y))
    if op == OP_BIT_AND
        return v_num((a & b) as f64)
    if op == OP_BIT_OR
        return v_num((a | b) as f64)
    if op == OP_BIT_XOR
        return v_num((a ^ b) as f64)
    let s = to_uint32_f(to_number(it, y)) % 32
    if op == OP_SHL
        return v_num(to_int32_f(((a << s) & 4294967295) as f64) as f64)
    if op == OP_SHR
        return v_num(shift_right_signed(a, s) as f64)
    if op == OP_USHR
        return v_num((to_uint32_f(to_number(it, x)) >> s) as f64)
    throw_unsupported(it, "the `in` and `instanceof` operators")
    v_undef()

# Compound assignment operator -> binary operator (0 for = and logical ones)
fn assign_to_binary(op: i32) -> i32
    if op == ASSIGN_ADD
        return OP_ADD
    if op == ASSIGN_SUB
        return OP_SUB
    if op == ASSIGN_MUL
        return OP_MUL
    if op == ASSIGN_DIV
        return OP_DIV
    if op == ASSIGN_MOD
        return OP_MOD
    if op == ASSIGN_POW
        return OP_POW
    if op == ASSIGN_BIT_AND
        return OP_BIT_AND
    if op == ASSIGN_BIT_OR
        return OP_BIT_OR
    if op == ASSIGN_BIT_XOR
        return OP_BIT_XOR
    if op == ASSIGN_SHL
        return OP_SHL
    if op == ASSIGN_SHR
        return OP_SHR
    if op == ASSIGN_USHR
        return OP_USHR
    0

# =============================================================================
# References: reading and writing identifiers and properties
# =============================================================================

fn read_identifier(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let b = lookup(it, it.scope, 1, node.str_start, node.str_len)
    if b < 0
        throw_error(it, "ReferenceError", ident_text(it, idx), " is not defined")
        return v_undef()
    it.bindings.get(b).value

fn write_identifier(it: @&Interp, idx: i64, value: Value)
    let node = node_at(it, idx)
    let b = lookup(it, it.scope, 1, node.str_start, node.str_len)
    if b < 0
        # Sloppy-mode scripts create a global on assignment
        declare(it, it.global, 1, node.str_start, node.str_len, value, 0)
        return
    let bp = it.bindings.get_ptr(b)
    if bp.is_const == 1
        throw_error(it, "TypeError", "Assignment to constant variable.", "")
        return
    bp.value = value

# A property key: (in_src, start, len). Evaluates a computed key.
struct Key
    in_src: i32
    start: i64
    len: i64

fn member_key(it: @&Interp, node: *AstNode) -> Key
    if node.bool_value == 1
        let k = to_string(it, eval(it, node.child2))
        return Key { in_src: 0, start: k.a, len: k.b }
    let pn = node_at(it, node.child2)
    Key { in_src: 1, start: pn.str_start, len: pn.str_len }

fn get_property(it: @&Interp, obj: Value, key: Key) -> Value
    if obj.tag == V_UNDEFINED or obj.tag == V_NULL
        var what: StrView = "undefined"
        if obj.tag == V_NULL
            what = "null"
        let start = it.arena.len()
        buf_push_sv(@&it.arena, what)
        buf_push_sv(@&it.arena, " (reading '")
        buf_push_sv(@&it.arena, name_view(it, key.in_src, key.start, key.len))
        buf_push_sv(@&it.arena, "')")
        let detail = arena_view(it, start, it.arena.len() - start)
        throw_error(it, "TypeError", "Cannot read properties of ", detail)
        return v_undef()
    if obj.tag == V_OBJECT
        return prop_get(it, obj.a, key.in_src, key.start, key.len)
    if obj.tag == V_ARRAY
        return array_get(it, obj.a, key)
    if obj.tag == V_STRING
        return string_get(it, obj, key)
    if obj.tag == V_NATIVE
        return native_static(it, obj.a, key)
    v_undef()

fn read_member(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let obj = eval(it, node.child1)
    if threw(it) == 1
        return v_undef()
    # obj?.prop
    if node.bool_value == 2 and (obj.tag == V_UNDEFINED or obj.tag == V_NULL)
        return v_undef()
    let key = member_key(it, node)
    if threw(it) == 1
        return v_undef()
    get_property(it, obj, key)

fn write_member(it: @&Interp, obj: Value, key: Key, value: Value)
    if obj.tag == V_UNDEFINED or obj.tag == V_NULL
        throw_error(it, "TypeError", "Cannot set properties of ", type_of(obj))
        return
    if obj.tag == V_OBJECT
        prop_set(it, obj.a, key.in_src, key.start, key.len, value)
    else if obj.tag == V_ARRAY
        array_write(it, obj.a, key, value)
    # Writes to a primitive's property are ignored (sloppy mode)

# =============================================================================
# Expressions
# =============================================================================

fn make_function(it: @&Interp, node_idx: i64, scope: i64) -> Value
    let idx = it.funcs.len()
    it.funcs.push(FuncRec { node: node_idx, scope: scope })
    v_tagged(V_FUNCTION, idx)

fn eval_function_expr(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    if node.child1 == NO_CHILD
        return make_function(it, idx, it.scope)
    # A named function expression sees its own name
    let s = scope_new(it, it.scope, 0)
    let f = make_function(it, idx, s)
    let name = node_at(it, node.child1)
    declare(it, s, 1, name.str_start, name.str_len, f, 1)
    f

# An arrow function closes over the current scope. Its body and parameters
# live on the node itself (see call_function); unlike a named function
# expression it does not introduce a name binding.
fn eval_arrow_expr(it: @&Interp, idx: i64) -> Value
    make_function(it, idx, it.scope)

fn eval_logical(it: @&Interp, node: *AstNode) -> Value
    let op = node.int_value
    let left = eval(it, node.child1)
    if threw(it) == 1
        return v_undef()
    if op == OP_AND
        if to_boolean(it, left) == 0
            return left
    else if op == OP_OR
        if to_boolean(it, left) == 1
            return left
    else
        if left.tag != V_UNDEFINED and left.tag != V_NULL
            return left
    eval(it, node.child2)

fn eval_binary(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let op = node.int_value
    if op == OP_AND or op == OP_OR or op == OP_NULLISH
        return eval_logical(it, node)
    let left = eval(it, node.child1)
    if threw(it) == 1
        return v_undef()
    let right = eval(it, node.child2)
    if threw(it) == 1
        return v_undef()
    binary_op(it, op, left, right)

fn eval_unary(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let op = node.int_value
    if op == UNARY_TYPEOF
        # typeof of an undeclared name is "undefined", not an error
        let operand = node_at(it, node.child1)
        if operand.tag == AstTag.Identifier
            if lookup(it, it.scope, 1, operand.str_start, operand.str_len) < 0
                return str_from_sv(it, "undefined")
        let v = eval(it, node.child1)
        if threw(it) == 1
            return v_undef()
        return str_from_sv(it, type_of(v))
    if op == UNARY_DELETE
        throw_unsupported(it, "delete")
        return v_undef()
    let v = eval(it, node.child1)
    if threw(it) == 1
        return v_undef()
    if op == UNARY_NEG
        return v_num(-1.0 * to_number(it, v))   # not 0 - x: -(0) is -0
    if op == UNARY_POS
        return v_num(to_number(it, v))
    if op == UNARY_NOT
        return v_bool(1 - to_boolean(it, v))
    if op == UNARY_BIT_NOT
        return v_num((0 - to_int32_f(to_number(it, v)) - 1) as f64)
    v_undef()  # void

fn eval_assignment(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let op = node.int_value
    let tnode = node_at(it, node.child1)
    let is_member = tnode.tag == AstTag.MemberExpr
    if is_member == false and tnode.tag != AstTag.Identifier
        throw_error(it, "SyntaxError", "Invalid left-hand side in assignment", "")
        return v_undef()

    # Resolve the target once: obj[key] evaluates obj and key before the value
    var obj: Value = v_undef()
    var key = Key { in_src: 0, start: 0, len: 0 }
    if is_member
        obj = eval(it, tnode.child1)
        if threw(it) == 1
            return v_undef()
        key = member_key(it, tnode)
        if threw(it) == 1
            return v_undef()

    var value: Value = v_undef()
    if op == ASSIGN_EQ
        value = eval(it, node.child2)
    else
        var current: Value = v_undef()
        if is_member
            current = get_property(it, obj, key)
        else
            current = read_identifier(it, node.child1)
        if threw(it) == 1
            return v_undef()
        if op == ASSIGN_AND or op == ASSIGN_OR or op == ASSIGN_NULLISH
            # Logical assignment only assigns when it would not short-circuit
            let truthy = to_boolean(it, current)
            if op == ASSIGN_AND and truthy == 0
                return current
            if op == ASSIGN_OR and truthy == 1
                return current
            if op == ASSIGN_NULLISH and current.tag != V_UNDEFINED and current.tag != V_NULL
                return current
            value = eval(it, node.child2)
        else
            let rhs = eval(it, node.child2)
            if threw(it) == 1
                return v_undef()
            value = binary_op(it, assign_to_binary(op), current, rhs)
    if threw(it) == 1
        return v_undef()

    if is_member
        write_member(it, obj, key, value)
    else
        write_identifier(it, node.child1, value)
    value

fn eval_update(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let tnode = node_at(it, node.child1)
    var delta: f64 = 1.0
    if node.int_value == 2
        delta = -1.0
    var old: f64 = 0.0
    if tnode.tag == AstTag.Identifier
        let cur = read_identifier(it, node.child1)
        if threw(it) == 1
            return v_undef()
        old = to_number(it, cur)
        write_identifier(it, node.child1, v_num(old + delta))
    else if tnode.tag == AstTag.MemberExpr
        let obj = eval(it, tnode.child1)
        if threw(it) == 1
            return v_undef()
        let key = member_key(it, tnode)
        if threw(it) == 1
            return v_undef()
        let cur = get_property(it, obj, key)
        if threw(it) == 1
            return v_undef()
        old = to_number(it, cur)
        write_member(it, obj, key, v_num(old + delta))
    else
        throw_error(it, "SyntaxError", "Invalid left-hand side expression in update operation", "")
        return v_undef()
    if threw(it) == 1
        return v_undef()
    if node.bool_value == 1
        return v_num(old + delta)
    v_num(old)

fn eval_array(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let arr = arr_new(it)
    let start = node.children_start
    let count = node.children_count
    var i: i64 = 0
    while i < count
        let elem = child_at(it, start, i)
        var value: Value = v_undef()   # an elision is a hole, treated as undefined
        if elem != NO_CHILD
            value = eval(it, elem)
            if threw(it) == 1
                return v_undef()
        arr_append(it, arr.a, value)
        i = i + 1
    arr

fn eval_object(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let obj = obj_new(it)
    let start = node.children_start
    let count = node.children_count
    var i: i64 = 0
    while i < count
        let key_idx = child_at(it, start, i * 2)
        let val_idx = child_at(it, start, i * 2 + 1)
        let value = eval(it, val_idx)
        if threw(it) == 1
            return v_undef()
        let kn = node_at(it, key_idx)
        if kn.tag == AstTag.StringLiteral
            let k = string_literal(it, key_idx)
            prop_set(it, obj.a, 0, k.a, k.b, value)
        else
            prop_set(it, obj.a, 1, kn.str_start, kn.str_len, value)
        i = i + 1
    obj

fn console_print(it: @&Interp, native: i64, args: @Vec<Value>)
    it.line.clear()
    let n = args.len()
    var i: i64 = 0
    while i < n
        if i > 0
            it.line.push(32)
        push_inspect(it, @&it.line, args.get(i), 0)
        i = i + 1
    it.line.push(10)
    let line: [u8] = it.line[0..it.line.len()]
    let text = line.as_strview()
    if native == NATIVE_CONSOLE_ERROR
        eprints(text)
        return
    if it.echo == 1
        prints(text)
        return
    buf_push_sv(@&it.out, text)

fn object_is(it: @&Interp, x: Value, y: Value) -> i32
    if x.tag != y.tag
        return 0
    if x.tag == V_NUMBER
        if x.num != x.num and y.num != y.num
            return 1
        if x.num == 0.0 and y.num == 0.0
            if is_neg_zero(x.num) == is_neg_zero(y.num)
                return 1
            return 0
        if x.num == y.num
            return 1
        return 0
    strict_equals(it, x, y)

# Dispatch of every native callable: console, array methods, the String /
# Number / Object / Boolean globals and their statics, Math, and the
# String.prototype methods (whose receiver is in f.num/f.b, see v_str_method).
fn call_native(it: @&Interp, f: Value, args: @Vec<Value>) -> Value
    let id = f.a
    if id == NATIVE_CONSOLE_LOG or id == NATIVE_CONSOLE_ERROR
        console_print(it, id, args)
        return v_undef()
    if id == NATIVE_ARRAY_PUSH
        return arr_push_values(it, f.b, args)
    if id == NATIVE_ARRAY_POP
        return arr_pop_value(it, f.b)

    # --- callable globals -------------------------------------------------
    if id == NATIVE_STRING_CALL
        if args.len() == 0
            return str_from_sv(it, "")
        return to_string(it, nth_arg(args, 0))
    if id == NATIVE_NUMBER_CALL
        if args.len() == 0
            return v_num(0.0)
        return v_num(to_number(it, nth_arg(args, 0)))
    if id == NATIVE_BOOLEAN_CALL
        return v_bool(to_boolean(it, nth_arg(args, 0)))
    if id == NATIVE_OBJECT_CALL
        let v = nth_arg(args, 0)
        if v.tag == V_UNDEFINED or v.tag == V_NULL
            return obj_new(it)
        return v

    # --- Math -------------------------------------------------------------
    if id == NATIVE_MATH_ABS
        return v_num(f64_abs(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_FLOOR
        return v_num(f64_floor(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_CEIL
        return v_num(f64_ceil(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_ROUND
        return v_num(f64_round(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_TRUNC
        return v_num(f64_trunc(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_SIGN
        return v_num(f64_sign(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_MIN or id == NATIVE_MATH_MAX
        var r: f64 = 0.0 - f64_inf()
        if id == NATIVE_MATH_MIN
            r = f64_inf()
        let n = args.len()
        var i: i64 = 0
        while i < n
            let x = to_number(it, args.get(i))
            if x != x
                return v_num(x)
            if id == NATIVE_MATH_MIN
                if x < r or (x == 0.0 and r == 0.0 and is_neg_zero(x) == 1)
                    r = x
            else
                if x > r or (x == 0.0 and r == 0.0 and is_neg_zero(x) == 0)
                    r = x
            i = i + 1
        return v_num(r)
    if id == NATIVE_MATH_POW
        return v_num(f64_pow(to_number(it, nth_arg(args, 0)), to_number(it, nth_arg(args, 1))))
    if id == NATIVE_MATH_SQRT
        return v_num(f64_sqrt(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_CBRT
        return v_num(f64_cbrt(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_LOG
        return v_num(f64_log(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_LOG2
        return v_num(f64_log2(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_LOG10
        return v_num(f64_log10(to_number(it, nth_arg(args, 0))))
    if id == NATIVE_MATH_EXP
        return v_num(f64_exp(to_number(it, nth_arg(args, 0))))

    # --- Number statics ---------------------------------------------------
    if id == NATIVE_NUMBER_IS_INTEGER
        let v = nth_arg(args, 0)
        if v.tag == V_NUMBER and f64_is_finite(v.num) == 1 and v.num == f64_trunc(v.num)
            return v_bool(1)
        return v_bool(0)
    if id == NATIVE_NUMBER_IS_NAN
        let v = nth_arg(args, 0)
        if v.tag == V_NUMBER and v.num != v.num
            return v_bool(1)
        return v_bool(0)
    if id == NATIVE_NUMBER_IS_FINITE
        let v = nth_arg(args, 0)
        if v.tag == V_NUMBER and f64_is_finite(v.num) == 1
            return v_bool(1)
        return v_bool(0)
    if id == NATIVE_NUMBER_IS_SAFE_INTEGER
        let v = nth_arg(args, 0)
        if v.tag == V_NUMBER and f64_is_finite(v.num) == 1 and v.num == f64_trunc(v.num)
            if f64_abs(v.num) <= 9007199254740991.0
                return v_bool(1)
        return v_bool(0)

    # --- Object statics ---------------------------------------------------
    if id == NATIVE_OBJECT_KEYS or id == NATIVE_OBJECT_VALUES or id == NATIVE_OBJECT_ENTRIES
        let v = nth_arg(args, 0)
        if v.tag == V_UNDEFINED or v.tag == V_NULL
            throw_error(it, "TypeError", "Cannot convert undefined or null to object", "")
            return v_undef()
        if id == NATIVE_OBJECT_KEYS
            return own_keys(it, v)
        if id == NATIVE_OBJECT_VALUES
            return own_values(it, v)
        return own_entries(it, v)
    if id == NATIVE_OBJECT_ASSIGN
        let target = nth_arg(args, 0)
        let n = args.len()
        var i: i64 = 1
        while i < n
            assign_into(it, target, args.get(i))
            i = i + 1
        return target
    if id == NATIVE_OBJECT_IS
        return v_bool(object_is(it, nth_arg(args, 0), nth_arg(args, 1)))
    if id == NATIVE_OBJECT_FREEZE
        let v = nth_arg(args, 0)
        if v.tag == V_OBJECT
            let op = it.objects.get_ptr(v.a)
            op.frozen = 1
        return v
    if id == NATIVE_OBJECT_IS_FROZEN
        let v = nth_arg(args, 0)
        if v.tag == V_OBJECT
            return v_bool(it.objects.get(v.a).frozen)
        if v.tag == V_ARRAY
            return v_bool(0)
        return v_bool(1)

    # --- String.prototype (receiver is s = arena[start..start+len]) --------
    if id >= NATIVE_STR_CHAR_AT
        let s = v_str(f.num as i64, f.b)
        if id == NATIVE_STR_CHAR_AT
            let i = to_int_or_inf(it, nth_arg(args, 0))
            if i < 0.0 or i >= s.b as f64
                return str_from_sv(it, "")
            return arena_copy(it, s.a + (i as i64), 1)
        if id == NATIVE_STR_CHAR_CODE_AT
            let i = to_int_or_inf(it, nth_arg(args, 0))
            if i < 0.0 or i >= s.b as f64
                return v_num(f64_nan())
            return v_num(it.arena.get(s.a + (i as i64)) as f64)
        if id == NATIVE_STR_INDEX_OF
            let needle = to_string(it, nth_arg(args, 0))
            let from = to_int_or_inf(it, nth_arg(args, 1))
            return v_num(str_find(it, s, needle, from) as f64)
        if id == NATIVE_STR_INCLUDES
            let needle = to_string(it, nth_arg(args, 0))
            let from = to_int_or_inf(it, nth_arg(args, 1))
            let at = str_find(it, s, needle, from)
            if at == -1
                return v_bool(0)
            return v_bool(1)
        if id == NATIVE_STR_STARTS_WITH
            let needle = to_string(it, nth_arg(args, 0))
            var pos: f64 = to_int_or_inf(it, nth_arg(args, 1))
            if pos < 0.0
                pos = 0.0
            if pos > s.b as f64
                pos = s.b as f64
            let p = pos as i64
            if needle.b > s.b - p
                return v_bool(0)
            return v_bool(str_equal_at(it, s, p, needle))
        if id == NATIVE_STR_ENDS_WITH
            let needle = to_string(it, nth_arg(args, 0))
            var end: f64 = s.b as f64
            if args.len() > 1
                end = to_int_or_inf(it, nth_arg(args, 1))
            if end < 0.0
                end = 0.0
            if end > s.b as f64
                end = s.b as f64
            let e = end as i64
            if needle.b > e
                return v_bool(0)
            return v_bool(str_equal_at(it, s, e - needle.b, needle))
        if id == NATIVE_STR_SLICE
            let from = to_int_or_inf(it, nth_arg(args, 0))
            var to: f64 = s.b as f64
            if args.len() > 1
                to = to_int_or_inf(it, nth_arg(args, 1))
            return str_slice_rel(it, s, from, to)
        if id == NATIVE_STR_SUBSTRING
            var a: f64 = to_int_or_inf(it, nth_arg(args, 0))
            var b: f64 = s.b as f64
            if args.len() > 1
                b = to_int_or_inf(it, nth_arg(args, 1))
            if a < 0.0
                a = 0.0
            if b < 0.0
                b = 0.0
            if a > s.b as f64
                a = s.b as f64
            if b > s.b as f64
                b = s.b as f64
            if a > b
                let t = a
                a = b
                b = t
            return arena_copy(it, s.a + (a as i64), (b as i64) - (a as i64))
        if id == NATIVE_STR_TO_UPPER
            return str_change_case(it, s, 1)
        if id == NATIVE_STR_TO_LOWER
            return str_change_case(it, s, 0)
        if id == NATIVE_STR_TRIM
            var a: i64 = 0
            var b: i64 = s.b
            while a < b and is_space(it.arena.get(s.a + a)) == 1
                a = a + 1
            while b > a and is_space(it.arena.get(s.a + b - 1)) == 1
                b = b - 1
            return arena_copy(it, s.a + a, b - a)
        if id == NATIVE_STR_REPEAT
            let nf = to_int_or_inf(it, nth_arg(args, 0))
            if nf < 0.0 or nf > MAX_REPEAT_LEN as f64
                throw_error(it, "RangeError", "Invalid count value", "")
                return v_undef()
            let n = nf as i64
            if s.b == 0 or n == 0
                return str_from_sv(it, "")
            if n * s.b > MAX_REPEAT_LEN
                throw_error(it, "RangeError", "Invalid string length", "")
                return v_undef()
            let start = it.arena.len()
            var k: i64 = 0
            while k < n
                var j: i64 = 0
                while j < s.b
                    it.arena.push(it.arena.get(s.a + j))
                    j = j + 1
                k = k + 1
            return v_str(start, n * s.b)
        if id == NATIVE_STR_CONCAT
            # Build in a temp buffer: to_string/formatting must not allocate
            # in the arena inside the slice the result will name.
            var tmp = vec_new<u8>()
            push_to_string(it, @&tmp, s)
            var i: i64 = 0
            while i < args.len()
                push_to_string(it, @&tmp, args.get(i))
                i = i + 1
            let start = it.arena.len()
            var j: i64 = 0
            let n = tmp.len()
            while j < n
                it.arena.push(tmp.get(j))
                j = j + 1
            return v_str(start, n)
    v_undef()

# 1 if `needle` occurs in `hay` starting exactly at `at`
fn str_equal_at(it: @&Interp, hay: Value, at: i64, needle: Value) -> i32
    var i: i64 = 0
    while i < needle.b
        if it.arena.get(hay.a + at + i) != it.arena.get(needle.a + i)
            return 0
        i = i + 1
    1

fn call_function(it: @&Interp, f: Value, args: @Vec<Value>, callee: i64) -> Value
    if f.tag == V_NATIVE
        return call_native(it, f, args)
    if f.tag != V_FUNCTION
        throw_error(it, "TypeError", node_text(it, callee), " is not a function")
        return v_undef()
    if it.depth >= MAX_DEPTH
        throw_error(it, "RangeError", "Maximum call stack size exceeded", "")
        return v_undef()

    let rec = it.funcs.get(f.a)
    let fnode = node_at(it, rec.node)
    let scope = scope_new(it, rec.scope, 1)
    let nparams = fnode.children_count
    let pstart = fnode.children_start
    let nargs = args.len()
    var i: i64 = 0
    while i < nparams
        let pn = node_at(it, child_at(it, pstart, i))
        var value: Value = v_undef()
        if i < nargs
            value = args.get(i)
        declare(it, scope, 1, pn.str_start, pn.str_len, value, 0)
        i = i + 1

    let saved = it.scope
    it.scope = scope
    it.depth = it.depth + 1

    # An arrow with an expression body returns that value; `ast_arrow` stores
    # the body in child1 and the expression/block flag in bool_value.
    if fnode.tag == AstTag.ArrowFunction and fnode.bool_value == 1
        let value = eval(it, fnode.child1)
        it.depth = it.depth - 1
        it.scope = saved
        if it.ctl == CTL_THROW
            return v_undef()
        return value

    # Block-bodied arrows keep their body in child1; declarations use child2.
    var body_idx = fnode.child2
    if fnode.tag == AstTag.ArrowFunction
        body_idx = fnode.child1
    let body = node_at(it, body_idx)
    exec_list(it, body.children_start, body.children_count)
    it.depth = it.depth - 1
    it.scope = saved

    if it.ctl == CTL_THROW
        return v_undef()
    var result: Value = v_undef()
    if it.ctl == CTL_RETURN
        result = it.ret
    it.ctl = CTL_NORMAL
    result

fn eval_call(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let callee = node.child1
    let f = eval(it, callee)
    if threw(it) == 1
        return v_undef()
    var args = vec_new<Value>()
    let start = node.children_start
    let count = node.children_count
    var i: i64 = 0
    while i < count
        let v = eval(it, child_at(it, start, i))
        if threw(it) == 1
            return v_undef()
        args.push(v)
        i = i + 1
    let result = call_function(it, f, @args, callee)
    result

fn eval(it: @&Interp, idx: i64) -> Value
    let node = node_at(it, idx)
    let tag = node.tag
    if tag == AstTag.NumberLiteral
        return v_num(node.num_value)
    if tag == AstTag.StringLiteral
        return string_literal(it, idx)
    if tag == AstTag.BooleanLiteral
        return v_bool(node.bool_value)
    if tag == AstTag.NullLiteral
        return v_null()
    if tag == AstTag.UndefinedLiteral
        return v_undef()
    if tag == AstTag.Identifier
        return read_identifier(it, idx)
    if tag == AstTag.BinaryExpr
        return eval_binary(it, idx)
    if tag == AstTag.UnaryExpr
        return eval_unary(it, idx)
    if tag == AstTag.UpdateExpr
        return eval_update(it, idx)
    if tag == AstTag.AssignmentExpr
        return eval_assignment(it, idx)
    if tag == AstTag.ConditionalExpr
        let cond = eval(it, node.child1)
        if threw(it) == 1
            return v_undef()
        if to_boolean(it, cond) == 1
            return eval(it, node.child2)
        return eval(it, node.child3)
    if tag == AstTag.CallExpr
        return eval_call(it, idx)
    if tag == AstTag.MemberExpr
        return read_member(it, idx)
    if tag == AstTag.ObjectLiteral
        return eval_object(it, idx)
    if tag == AstTag.ArrayLiteral
        return eval_array(it, idx)
    if tag == AstTag.FunctionExpr
        return eval_function_expr(it, idx)
    if tag == AstTag.ArrowFunction
        return eval_arrow_expr(it, idx)
    throw_unsupported(it, ast_node_type_name(tag))
    v_undef()

# =============================================================================
# Statements
# =============================================================================

# Function declarations in a statement list are created before it runs
fn hoist(it: @&Interp, start: i64, count: i64)
    var i: i64 = 0
    while i < count
        let sidx = child_at(it, start, i)
        let snode = node_at(it, sidx)
        if snode.tag == AstTag.FunctionDecl
            let name = node_at(it, snode.child1)
            let f = make_function(it, sidx, it.scope)
            declare(it, it.scope, 1, name.str_start, name.str_len, f, 0)
        i = i + 1

fn exec_list(it: @&Interp, start: i64, count: i64)
    hoist(it, start, count)
    var i: i64 = 0
    while i < count
        exec(it, child_at(it, start, i))
        if it.ctl != CTL_NORMAL
            return
        i = i + 1

# Run a statement in a fresh block scope
fn exec_scoped(it: @&Interp, idx: i64)
    let saved = it.scope
    it.scope = scope_new(it, saved, 0)
    exec(it, idx)
    it.scope = saved

fn exec_var_decl(it: @&Interp, node: *AstNode)
    let kind = node.int_value
    let start = node.children_start
    let count = node.children_count
    var i: i64 = 0
    while i < count
        let name = node_at(it, child_at(it, start, i * 2))
        let init = child_at(it, start, i * 2 + 1)
        if kind == VAR_VAR
            let target = function_scope(it)
            let existing = scope_find_own(it, target, 1, name.str_start, name.str_len)
            if init == NO_CHILD
                if existing < 0
                    declare(it, target, 1, name.str_start, name.str_len, v_undef(), 0)
            else
                let value = eval(it, init)
                if threw(it) == 1
                    return
                # `var` inside a block assigns the function-scope binding
                # unless a let/const in between shadows it
                let visible = lookup(it, it.scope, 1, name.str_start, name.str_len)
                if visible >= 0 and visible != existing
                    let bp = it.bindings.get_ptr(visible)
                    bp.value = value
                else
                    declare(it, target, 1, name.str_start, name.str_len, value, 0)
        else
            var value: Value = v_undef()
            if init != NO_CHILD
                value = eval(it, init)
                if threw(it) == 1
                    return
            var is_const: i32 = 0
            if kind == VAR_CONST
                is_const = 1
            declare(it, it.scope, 1, name.str_start, name.str_len, value, is_const)
        i = i + 1

# After a loop body: 1 to stop the loop (break, return, throw)
fn loop_should_stop(it: @&Interp) -> i32
    if it.ctl == CTL_BREAK
        it.ctl = CTL_NORMAL
        return 1
    if it.ctl == CTL_CONTINUE
        it.ctl = CTL_NORMAL
        return 0
    if it.ctl != CTL_NORMAL
        return 1
    0

fn exec_for(it: @&Interp, node: *AstNode)
    let saved = it.scope
    it.scope = scope_new(it, saved, 0)
    let init = node.child1
    let cond = node.child2
    let update = node.child3
    let body = node.child4
    if init != NO_CHILD
        let inode = node_at(it, init)
        if inode.tag == AstTag.VarDecl
            exec(it, init)
        else
            # `let`: see #4070 (arm ending in a Value call)
            let _ignored = eval(it, init)
    while it.ctl == CTL_NORMAL
        if cond != NO_CHILD
            let c = eval(it, cond)
            if threw(it) == 1 or to_boolean(it, c) == 0
                break
        exec_scoped(it, body)
        if loop_should_stop(it) == 1
            break
        if update != NO_CHILD
            let _ignored = eval(it, update)
    it.scope = saved

# for (let x of arr) and for (x of arr): iterate an array's elements
fn exec_for_of(it: @&Interp, node: *AstNode)
    let iterable = eval(it, node.child2)
    if threw(it) == 1
        return
    if iterable.tag != V_ARRAY
        throw_error(it, "TypeError", node_text(it, node.child2), " is not iterable")
        return
    let left = node.child1
    let lnode = node_at(it, left)
    let num = arr_len(it, iterable.a)
    let body = node.child3
    var i: i64 = 0
    while i < num
        let value = arr_get(it, iterable.a, i)
        if lnode.tag == AstTag.VarDecl
            # A fresh binding per iteration, like `let` in for-of
            let saved = it.scope
            it.scope = scope_new(it, saved, 0)
            let name = node_at(it, child_at(it, lnode.children_start, 0))
            var is_const: i32 = 0
            if lnode.int_value == VAR_CONST
                is_const = 1
            declare(it, it.scope, 1, name.str_start, name.str_len, value, is_const)
            exec(it, body)
            it.scope = saved
        else if lnode.tag == AstTag.Identifier
            write_identifier(it, left, value)
            if threw(it) == 1
                return
            exec_scoped(it, body)
        else if lnode.tag == AstTag.MemberExpr
            let obj = eval(it, lnode.child1)
            if threw(it) == 1
                return
            let key = member_key(it, lnode)
            if threw(it) == 1
                return
            write_member(it, obj, key, value)
            if threw(it) == 1
                return
            exec_scoped(it, body)
        else
            throw_unsupported(it, "this for-of target")
            return
        if loop_should_stop(it) == 1
            break
        i = i + 1

fn exec_try(it: @&Interp, node: *AstNode)
    let catch_param = node.child2
    let catch_block = node.child3
    let finally_block = node.child4
    exec(it, node.child1)
    if it.ctl == CTL_THROW and catch_block != NO_CHILD
        it.ctl = CTL_NORMAL
        let saved = it.scope
        it.scope = scope_new(it, saved, 0)
        if catch_param != NO_CHILD
            let pn = node_at(it, catch_param)
            declare(it, it.scope, 1, pn.str_start, pn.str_len, it.ret, 0)
        exec(it, catch_block)
        it.scope = saved
    if finally_block != NO_CHILD
        # finally runs either way; its own abrupt completion wins
        let saved_ctl = it.ctl
        let saved_ret = it.ret
        it.ctl = CTL_NORMAL
        exec(it, finally_block)
        if it.ctl == CTL_NORMAL
            it.ctl = saved_ctl
            it.ret = saved_ret

fn exec(it: @&Interp, idx: i64)
    let node = node_at(it, idx)
    let tag = node.tag
    if tag == AstTag.ExprStmt
        # `let`: an if/else arm ending in a Value call miscompiles (#4070)
        let _ignored = eval(it, node.child1)
    else if tag == AstTag.VarDecl
        exec_var_decl(it, node)
    else if tag == AstTag.BlockStmt
        let saved = it.scope
        it.scope = scope_new(it, saved, 0)
        exec_list(it, node.children_start, node.children_count)
        it.scope = saved
    else if tag == AstTag.IfStmt
        let c = eval(it, node.child1)
        if threw(it) == 1
            return
        if to_boolean(it, c) == 1
            exec_scoped(it, node.child2)
        else if node.child3 != NO_CHILD
            exec_scoped(it, node.child3)
    else if tag == AstTag.WhileStmt
        while it.ctl == CTL_NORMAL
            let c = eval(it, node.child1)
            if threw(it) == 1 or to_boolean(it, c) == 0
                break
            exec_scoped(it, node.child2)
            if loop_should_stop(it) == 1
                break
    else if tag == AstTag.DoWhileStmt
        while it.ctl == CTL_NORMAL
            exec_scoped(it, node.child1)
            if loop_should_stop(it) == 1
                break
            let c = eval(it, node.child2)
            if threw(it) == 1 or to_boolean(it, c) == 0
                break
    else if tag == AstTag.ForStmt
        exec_for(it, node)
    else if tag == AstTag.ForOfStmt
        exec_for_of(it, node)
    else if tag == AstTag.ReturnStmt
        var value: Value = v_undef()
        if node.child1 != NO_CHILD
            value = eval(it, node.child1)
            if threw(it) == 1
                return
        it.ret = value
        it.ctl = CTL_RETURN
    else if tag == AstTag.BreakStmt or tag == AstTag.ContinueStmt
        if node.str_len > 0
            throw_unsupported(it, "labelled break/continue")
            return
        if tag == AstTag.BreakStmt
            it.ctl = CTL_BREAK
        else
            it.ctl = CTL_CONTINUE
    else if tag == AstTag.ThrowStmt
        let value = eval(it, node.child1)
        if threw(it) == 1
            return
        it.ret = value
        it.ctl = CTL_THROW
    else if tag == AstTag.TryStmt
        exec_try(it, node)
    else if tag == AstTag.FunctionDecl or tag == AstTag.EmptyStmt or tag == AstTag.DebuggerStmt
        # Function declarations were hoisted by exec_list
        return
    else
        throw_unsupported(it, ast_node_type_name(tag))

# =============================================================================
# Public API
# =============================================================================

fn run_program(it: @&Interp)
    if parser_had_error(@it.parser) == 1
        it.failed = 1
        buf_push_sv(@&it.err, "SyntaxError: the script did not parse (see the parse errors above)")
        return

    # One literal-cache slot per AST node
    let nodes = it.parser.ast.nodes.len()
    var i: i64 = 0
    while i < nodes
        it.lit_start.push(-1)
        it.lit_len.push(0)
        i = i + 1

    it.global = scope_new(it, -1, 1)
    it.scope = it.global
    let console = obj_new(it)
    prop_set_sv(it, console.a, "log", v_tagged(V_NATIVE, NATIVE_CONSOLE_LOG))
    prop_set_sv(it, console.a, "error", v_tagged(V_NATIVE, NATIVE_CONSOLE_ERROR))
    declare_builtin(it, "console", console)
    declare_builtin(it, "NaN", v_num(f64_nan()))
    declare_builtin(it, "Infinity", v_num(f64_inf()))

    # Math is an ordinary object whose properties are native functions
    let math = obj_new(it)
    prop_set_sv(it, math.a, "PI", v_num(3.141592653589793))
    prop_set_sv(it, math.a, "E", v_num(2.718281828459045))
    prop_set_sv(it, math.a, "SQRT2", v_num(1.4142135623730951))
    prop_set_sv(it, math.a, "SQRT1_2", v_num(0.7071067811865476))
    prop_set_sv(it, math.a, "LN2", v_num(0.6931471805599453))
    prop_set_sv(it, math.a, "LN10", v_num(2.302585092994046))
    prop_set_sv(it, math.a, "LOG2E", v_num(1.4426950408889634))
    prop_set_sv(it, math.a, "LOG10E", v_num(0.4342944819032518))
    prop_set_sv(it, math.a, "abs", v_tagged(V_NATIVE, NATIVE_MATH_ABS))
    prop_set_sv(it, math.a, "floor", v_tagged(V_NATIVE, NATIVE_MATH_FLOOR))
    prop_set_sv(it, math.a, "ceil", v_tagged(V_NATIVE, NATIVE_MATH_CEIL))
    prop_set_sv(it, math.a, "round", v_tagged(V_NATIVE, NATIVE_MATH_ROUND))
    prop_set_sv(it, math.a, "trunc", v_tagged(V_NATIVE, NATIVE_MATH_TRUNC))
    prop_set_sv(it, math.a, "sign", v_tagged(V_NATIVE, NATIVE_MATH_SIGN))
    prop_set_sv(it, math.a, "min", v_tagged(V_NATIVE, NATIVE_MATH_MIN))
    prop_set_sv(it, math.a, "max", v_tagged(V_NATIVE, NATIVE_MATH_MAX))
    prop_set_sv(it, math.a, "pow", v_tagged(V_NATIVE, NATIVE_MATH_POW))
    prop_set_sv(it, math.a, "sqrt", v_tagged(V_NATIVE, NATIVE_MATH_SQRT))
    prop_set_sv(it, math.a, "cbrt", v_tagged(V_NATIVE, NATIVE_MATH_CBRT))
    prop_set_sv(it, math.a, "log", v_tagged(V_NATIVE, NATIVE_MATH_LOG))
    prop_set_sv(it, math.a, "log2", v_tagged(V_NATIVE, NATIVE_MATH_LOG2))
    prop_set_sv(it, math.a, "log10", v_tagged(V_NATIVE, NATIVE_MATH_LOG10))
    prop_set_sv(it, math.a, "exp", v_tagged(V_NATIVE, NATIVE_MATH_EXP))
    declare_builtin(it, "Math", math)

    # String / Number / Object / Boolean are functions (typeof "function")
    declare_builtin(it, "String", v_tagged(V_NATIVE, NATIVE_STRING_CALL))
    declare_builtin(it, "Number", v_tagged(V_NATIVE, NATIVE_NUMBER_CALL))
    declare_builtin(it, "Boolean", v_tagged(V_NATIVE, NATIVE_BOOLEAN_CALL))
    declare_builtin(it, "Object", v_tagged(V_NATIVE, NATIVE_OBJECT_CALL))

    let root = node_at(it, parser_root(@it.parser))
    exec_list(it, root.children_start, root.children_count)

    if it.ctl == CTL_THROW
        it.failed = 1
        buf_push_sv(@&it.err, "Uncaught ")
        push_to_string(it, @&it.err, it.ret)

# Run a script, keeping console.log's output in the interpreter
# (interp_output). For tests.
pub fn js_run(source: StrView) -> Interp
    var it = interp_new(source, 0)
    run_program(@&it)
    it

# Run a script, writing console.log's output to stdout as it happens
pub fn js_run_echo(source: StrView) -> Interp
    var it = interp_new(source, 1)
    run_program(@&it)
    it

# 1 if the script threw an uncaught exception or did not parse
pub fn interp_failed(it: @Interp) -> i32
    it.failed

# Why the run failed, e.g. "Uncaught ReferenceError: x is not defined"
pub fn interp_error(it: @Interp) -> StrView
    let s: [u8] = it.err[0..it.err.len()]
    s.as_strview()

# What console.log printed (js_run only; js_run_echo writes it to stdout)
pub fn interp_output(it: @Interp) -> StrView
    let s: [u8] = it.out[0..it.out.len()]
    s.as_strview()
