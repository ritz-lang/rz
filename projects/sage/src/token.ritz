# Token types for JavaScript lexer

import ritzlib.strview

# Token type: what kind of lexeme a Token is
pub enum TokenType
    # Literals
    Eof
    Number
    String
    Identifier

    # Keywords
    Let
    Const
    Var
    Function
    Return
    If
    Else
    While
    For
    True
    False
    Null
    Undefined
    New
    This
    Class
    Extends
    Super
    Import
    Export
    Default
    Break
    Continue
    Switch
    Case
    Throw
    Try
    Catch
    Finally
    Typeof
    Instanceof
    In
    Of
    Async
    Await
    Yield
    Static
    Get
    Set
    Do
    Debugger
    With
    Delete
    Void

    # Operators - Arithmetic
    Plus
    Minus
    Star
    Slash
    Percent
    StarStar

    # Operators - Comparison
    Eq
    EqEq
    EqEqEq
    Bang
    BangEq
    BangEqEq
    Lt
    LtEq
    Gt
    GtEq

    # Operators - Logical
    AmpAmp
    PipePipe
    QuestionQuestion

    # Operators - Bitwise
    Amp
    Pipe
    Caret
    Tilde
    LtLt
    GtGt
    GtGtGt

    # Operators - Assignment
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpEq
    PipeEq
    CaretEq
    LtLtEq
    GtGtEq
    GtGtGtEq
    StarStarEq
    AmpAmpEq
    PipePipeEq
    QuestionQuestionEq

    # Operators - Increment/Decrement
    PlusPlus
    MinusMinus

    # Punctuation
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Semicolon
    Comma
    Dot
    Colon
    Question
    Arrow
    Ellipsis
    OptionalChain

    # Special
    TemplateHead
    TemplateMiddle
    TemplateTail
    Regex
    Error

# Token structure - holds type and source location
struct Token
    typ: TokenType
    start: i64      # Start offset in source
    length: i64     # Length of token text
    line: i64       # Line number (1-indexed)
    column: i64     # Column number (1-indexed)

# Create a new token
pub fn token_new(typ: TokenType, start: i64, length: i64, line: i64, column: i64) -> Token
    Token {
        typ: typ,
        start: start,
        length: length,
        line: line,
        column: column
    }

# Create an EOF token
pub fn token_eof(offset: i64, line: i64, column: i64) -> Token
    token_new(TokenType.Eof, offset, 0, line, column)

# Create an error token
pub fn token_error(offset: i64, line: i64, column: i64) -> Token
    token_new(TokenType.Error, offset, 0, line, column)

# Check if token is a specific type
fn token_is(tok: Token, typ: TokenType) -> i32
    if tok.typ == typ
        return 1
    0

# Get token type name for debugging: the TOKEN_* name it had as an i32
# code. One match per category, each passing the others on, keeps every
# match small (AGAST #3938).
pub fn token_type_name(typ: TokenType) -> StrView
    match typ
        Eof => "EOF"
        Number => "NUMBER"
        String => "STRING"
        Identifier => "IDENTIFIER"
        LParen => "LPAREN"
        RParen => "RPAREN"
        LBrace => "LBRACE"
        RBrace => "RBRACE"
        LBracket => "LBRACKET"
        RBracket => "RBRACKET"
        Semicolon => "SEMICOLON"
        Comma => "COMMA"
        Dot => "DOT"
        Colon => "COLON"
        Question => "QUESTION"
        Arrow => "ARROW"
        Ellipsis => "ELLIPSIS"
        OptionalChain => "OPTIONAL_CHAIN"
        TemplateHead => "TEMPLATE_HEAD"
        TemplateMiddle => "TEMPLATE_MIDDLE"
        TemplateTail => "TEMPLATE_TAIL"
        Regex => "REGEX"
        Error => "ERROR"
        _ => token_operator_name(typ)

fn token_operator_name(typ: TokenType) -> StrView
    match typ
        Plus => "PLUS"
        Minus => "MINUS"
        Star => "STAR"
        Slash => "SLASH"
        Percent => "PERCENT"
        StarStar => "STAR_STAR"
        Eq => "EQ"
        EqEq => "EQ_EQ"
        EqEqEq => "EQ_EQ_EQ"
        Bang => "BANG"
        BangEq => "BANG_EQ"
        BangEqEq => "BANG_EQ_EQ"
        Lt => "LT"
        LtEq => "LT_EQ"
        Gt => "GT"
        GtEq => "GT_EQ"
        AmpAmp => "AMP_AMP"
        PipePipe => "PIPE_PIPE"
        QuestionQuestion => "QUESTION_QUESTION"
        Amp => "AMP"
        Pipe => "PIPE"
        Caret => "CARET"
        Tilde => "TILDE"
        LtLt => "LT_LT"
        GtGt => "GT_GT"
        GtGtGt => "GT_GT_GT"
        PlusEq => "PLUS_EQ"
        MinusEq => "MINUS_EQ"
        StarEq => "STAR_EQ"
        SlashEq => "SLASH_EQ"
        PercentEq => "PERCENT_EQ"
        AmpEq => "AMP_EQ"
        PipeEq => "PIPE_EQ"
        CaretEq => "CARET_EQ"
        LtLtEq => "LT_LT_EQ"
        GtGtEq => "GT_GT_EQ"
        GtGtGtEq => "GT_GT_GT_EQ"
        StarStarEq => "STAR_STAR_EQ"
        AmpAmpEq => "AMP_AMP_EQ"
        PipePipeEq => "PIPE_PIPE_EQ"
        QuestionQuestionEq => "QUESTION_QUESTION_EQ"
        PlusPlus => "PLUS_PLUS"
        MinusMinus => "MINUS_MINUS"
        _ => token_keyword_name(typ)

fn token_keyword_name(typ: TokenType) -> StrView
    match typ
        Let => "LET"
        Const => "CONST"
        Var => "VAR"
        Function => "FUNCTION"
        Return => "RETURN"
        If => "IF"
        Else => "ELSE"
        While => "WHILE"
        For => "FOR"
        True => "TRUE"
        False => "FALSE"
        Null => "NULL"
        Undefined => "UNDEFINED"
        New => "NEW"
        This => "THIS"
        Class => "CLASS"
        Extends => "EXTENDS"
        Super => "SUPER"
        Import => "IMPORT"
        Export => "EXPORT"
        Default => "DEFAULT"
        Break => "BREAK"
        Continue => "CONTINUE"
        Switch => "SWITCH"
        Case => "CASE"
        Throw => "THROW"
        Try => "TRY"
        Catch => "CATCH"
        Finally => "FINALLY"
        Typeof => "TYPEOF"
        Instanceof => "INSTANCEOF"
        In => "IN"
        Of => "OF"
        Async => "ASYNC"
        Await => "AWAIT"
        Yield => "YIELD"
        Static => "STATIC"
        Get => "GET"
        Set => "SET"
        Do => "DO"
        Debugger => "DEBUGGER"
        With => "WITH"
        Delete => "DELETE"
        Void => "VOID"
        _ => "UNKNOWN"
