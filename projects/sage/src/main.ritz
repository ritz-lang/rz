# Sage - JavaScript Engine (CLI entry point)
#
# What works today: the lexer (lexer.ritz) and parser (parser.ritz), as a
# library with tests. There is no interpreter yet (AGAST #2787), so running
# a file fails with "not implemented" instead of printing a banner and
# exiting 0 having read nothing (#2460).

import ritzlib.sys
import ritzlib.io
import ritzlib.str

const VERSION: *u8 = c"Sage JavaScript Engine v0.1.0 (lexer and parser only; no interpreter)\n"

fn print_usage()
    prints_cstr(c"Usage: sage [--help | --version] FILE.js\n")
    prints_cstr(c"\n")
    prints_cstr(c"Sage can tokenize and parse JavaScript (as a library). Executing a\n")
    prints_cstr(c"file is not implemented yet: `sage FILE.js` exits 1.\n")

fn main(argc: i32, argv: **u8) -> i32
    if argc < 2
        eprints_cstr(c"Usage: sage [--help | --version] FILE.js\n")
        return 2

    let arg: *u8 = argv[1]
    if streq(arg, c"--help") != 0 or streq(arg, c"-h") != 0
        print_usage()
        return 0
    if streq(arg, c"--version") != 0 or streq(arg, c"-V") != 0
        prints_cstr(VERSION)
        return 0
    if *arg == 45  # '-'
        eprints_cstr(c"sage: unknown option '")
        eprints_cstr(arg)
        eprints_cstr(c"'\n")
        return 2

    # Report an unreadable file as such before saying what is missing.
    let fd: i32 = sys_open(arg, 0)  # O_RDONLY
    if fd < 0
        eprints_cstr(c"sage: cannot open '")
        eprints_cstr(arg)
        eprints_cstr(c"'\n")
        return 1
    sys_close(fd)

    eprints_cstr(c"sage: not implemented: executing JavaScript (sage has a lexer and parser, no interpreter; AGAST #2787)\n")
    1
