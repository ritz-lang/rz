# Sage - JavaScript Engine (CLI entry point)
#
# `sage FILE.js` parses the file and runs it with the tree-walking
# interpreter (interp.ritz, AGAST #2787). Exit 0 only if the script ran to
# the end; exit 1, with the error on stderr, if it did not parse or threw
# an uncaught exception (#2460: never report success for work not done).

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.gvec
import src.interp

const VERSION: *u8 = c"Sage JavaScript Engine v0.1.0 (tree-walking interpreter)\n"

fn print_usage()
    prints_cstr(c"Usage: sage [--help | --version] FILE.js\n")
    prints_cstr(c"\n")
    prints_cstr(c"Runs FILE.js with Sage's tree-walking interpreter: numbers, strings,\n")
    prints_cstr(c"objects, functions and closures, control flow, exceptions and\n")
    prints_cstr(c"console.log. Exits 1 if the script does not parse or throws.\n")

fn main(argc: i32, argv: **u8) -> i32
    if argc < 2
        eprints_cstr(c"Usage: sage [--help | --version] FILE.js\n")
        return 2

    let arg: *u8 = argv[1]
    if streq(arg, c"--help") != 0 or streq(arg, c"-h") != 0
        print_usage()
        return 0
    if streq(arg, c"--version") != 0 or streq(arg, c"-V") != 0
        prints_cstr(VERSION)
        return 0
    if *arg == 45  # '-'
        eprints_cstr(c"sage: unknown option '")
        eprints_cstr(arg)
        eprints_cstr(c"'\n")
        return 2

    let fd: i32 = sys_open(arg, 0)  # O_RDONLY
    if fd < 0
        eprints_cstr(c"sage: cannot open '")
        eprints_cstr(arg)
        eprints_cstr(c"'\n")
        return 1
    var buf: Vec<u8> = vec_new<u8>()
    let n = vec_read_all_fd(fd, @&buf)
    sys_close(fd)
    if n < 0
        eprints_cstr(c"sage: cannot read '")
        eprints_cstr(arg)
        eprints_cstr(c"'\n")
        return 1

    let source = strview_from_ptr(vec_as_ptr<u8>(@buf), vec_len<u8>(@buf))
    let it = js_run_echo(source)
    if interp_failed(@it) != 0
        eprints_cstr(arg)
        eprints_cstr(c": ")
        eprints(interp_error(@it))
        eprints_cstr(c"\n")
        return 1
    0
