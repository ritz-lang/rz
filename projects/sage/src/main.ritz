# Sage - JavaScript Engine (CLI entry point)
#
# `sage FILE.js` parses the file and runs it with the tree-walking
# interpreter (interp.ritz, AGAST #2787). Exit 0 only if the script ran to
# the end; exit 1, with the error on stderr, if it did not parse or threw
# an uncaught exception (#2460: never report success for work not done).

import ritzlib.sys
import ritzlib.fmt
import ritzlib.strview
import ritzlib.gvec
import ritzlib.fd { Fd, fd_open, O_RDONLY }
import src.interp

fn print_usage()
    print("Usage: sage [--help | --version] FILE.js\n")
    print("\n")
    print("Runs FILE.js with Sage's tree-walking interpreter: numbers, strings,\n")
    print("objects, functions and closures, control flow, exceptions and\n")
    print("console.log. Exits 1 if the script does not parse or throws.\n")

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        eprint("Usage: sage [--help | --version] FILE.js\n")
        return 2

    let arg: StrView = args[1]
    if arg.eq("--help") or arg.eq("-h")
        print_usage()
        return 0
    if arg.eq("--version") or arg.eq("-V")
        print("Sage JavaScript Engine v0.1.0 (tree-walking interpreter)\n")
        return 0
    if arg.get(0) == 45  # '-'
        eprint("sage: unknown option '{arg}'\n")
        return 2

    var f: Fd = match fd_open(arg, O_RDONLY, 0)
        Ok(opened) => opened
        Err(_) =>
            eprint("sage: cannot open '{arg}'\n")
            return 1
    var buf: Vec<u8> = vec_new<u8>()
    let read_ok: bool = match vec_read_all_fd(f.raw(), @&buf)
        Ok(_) => true
        Err(_) => false
    f.close()
    if not read_ok
        eprint("sage: cannot read '{arg}'\n")
        return 1

    let source = strview_from_ptr(buf.as_ptr(), buf.len())
    let it = js_run_echo(source)
    if interp_failed(@it) != 0
        eprint("{arg}: {interp_error(@it)}\n")
        return 1
    0
