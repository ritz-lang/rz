# JavaScript Lexer
# Transforms source text into a stream of tokens

import ritzlib.strview
import ritzlib.gvec
import src.token
import src.float

# Lexer state
struct Lexer
    source: StrView     # Source text (zero-copy reference)
    pos: i64            # Current position in source
    line: i64           # Current line number (1-indexed)
    column: i64         # Current column number (1-indexed)
    line_start: i64     # Position where current line started

# Create a new lexer for the given source
fn lexer_new(source: StrView) -> Lexer
    Lexer {
        source: source,
        pos: 0,
        line: 1,
        column: 1,
        line_start: 0
    }

# Check if we've reached the end of input
fn lexer_is_eof(lex: @Lexer) -> i32
    if lex.pos >= (lex.source).len()
        return 1
    0

# Peek at the current character without consuming it
fn lexer_peek(lex: @Lexer) -> u8
    if lexer_is_eof(lex) == 1
        return 0
    (lex.source).get(lex.pos)

# Peek at the next character (one ahead)
fn lexer_peek_next(lex: @Lexer) -> u8
    let next_pos = lex.pos + 1
    if next_pos >= (lex.source).len()
        return 0
    (lex.source).get(next_pos)

# Peek at character n positions ahead
fn lexer_peek_n(lex: @Lexer, n: i64) -> u8
    let target_pos = lex.pos + n
    if target_pos >= (lex.source).len()
        return 0
    (lex.source).get(target_pos)

# Advance the lexer by one character
fn lexer_advance(lex: @&Lexer) -> u8
    let c = lexer_peek(lex)
    lex.pos = lex.pos + 1
    lex.column = lex.column + 1
    c

# Advance if current char matches expected
fn lexer_match(lex: @&Lexer, expected: u8) -> i32
    if lexer_is_eof(lex) == 1
        return 0
    if lexer_peek(lex) != expected
        return 0
    lexer_advance(lex)
    1

# Skip whitespace and comments
fn lexer_skip_whitespace(lex: @&Lexer)
    while lexer_is_eof(lex) == 0
        let c = lexer_peek(lex)

        # Space, tab, carriage return
        if c == 32 or c == 9 or c == 13
            lexer_advance(lex)
        # Newline
        else if c == 10
            lexer_advance(lex)
            lex.line = lex.line + 1
            lex.column = 1
            lex.line_start = lex.pos
        # Comments
        else if c == 47  # '/'
            let next = lexer_peek_next(lex)
            # Single-line comment
            if next == 47
                lexer_advance(lex)
                lexer_advance(lex)
                while lexer_is_eof(lex) == 0 and lexer_peek(lex) != 10
                    lexer_advance(lex)
            # Multi-line comment
            else if next == 42  # '*'
                lexer_advance(lex)
                lexer_advance(lex)
                while lexer_is_eof(lex) == 0
                    if lexer_peek(lex) == 42 and lexer_peek_next(lex) == 47
                        lexer_advance(lex)
                        lexer_advance(lex)
                        break
                    if lexer_peek(lex) == 10
                        lex.line = lex.line + 1
                        lex.column = 0
                        lex.line_start = lex.pos + 1
                    lexer_advance(lex)
            else
                return
        else
            return

# Check if character is a digit
fn is_digit(c: u8) -> i32
    if c >= 48 and c <= 57
        return 1
    0

# Check if character is a letter or underscore
fn is_alpha(c: u8) -> i32
    if c >= 65 and c <= 90   # A-Z
        return 1
    if c >= 97 and c <= 122  # a-z
        return 1
    if c == 95  # _
        return 1
    if c == 36  # $
        return 1
    0

# Check if character is alphanumeric or underscore
fn is_alnum(c: u8) -> i32
    if is_alpha(c) == 1
        return 1
    is_digit(c)

# Scan a number literal
fn lexer_scan_number(lex: @&Lexer, start: i64, start_line: i64, start_col: i64) -> Token
    # Integer part
    while is_digit(lexer_peek(lex)) == 1
        lexer_advance(lex)

    # Decimal point: ECMAScript NumericLiteral is
    # DecimalIntegerLiteral . DecimalDigits_opt ExponentPart_opt, so the dot
    # is always part of the literal once seen, even with no digits after it
    # (`5.`, `5.e-10`) (AGAST #4350).
    if lexer_peek(lex) == 46
        lexer_advance(lex)  # consume '.'
        while is_digit(lexer_peek(lex)) == 1
            lexer_advance(lex)

    # Exponent part
    let c = lexer_peek(lex)
    if c == 101 or c == 69  # 'e' or 'E'
        lexer_advance(lex)
        let sign = lexer_peek(lex)
        if sign == 43 or sign == 45  # '+' or '-'
            lexer_advance(lex)
        while is_digit(lexer_peek(lex)) == 1
            lexer_advance(lex)

    token_new(TokenType.Number, start, lex.pos - start, start_line, start_col)

# Scan a string literal
fn lexer_scan_string(lex: @&Lexer, quote: u8, start: i64, start_line: i64, start_col: i64) -> Token
    while lexer_is_eof(lex) == 0
        let c = lexer_peek(lex)

        # End of string
        if c == quote
            lexer_advance(lex)
            return token_new(TokenType.String, start, lex.pos - start, start_line, start_col)

        # Escape sequence
        if c == 92  # '\'
            lexer_advance(lex)
            if lexer_is_eof(lex) == 0
                lexer_advance(lex)
        # Newline (unterminated string)
        else if c == 10
            return token_error(start, start_line, start_col)
        else
            lexer_advance(lex)

    # Unterminated string
    token_error(start, start_line, start_col)

# The TokenType of an identifier's text: its keyword, or Identifier
fn check_keyword(text: StrView) -> TokenType
    match text
        "if" => TokenType.If
        "in" => TokenType.In
        "of" => TokenType.Of
        "do" => TokenType.Do
        "let" => TokenType.Let
        "var" => TokenType.Var
        "for" => TokenType.For
        "new" => TokenType.New
        "try" => TokenType.Try
        "get" => TokenType.Get
        "set" => TokenType.Set
        "else" => TokenType.Else
        "true" => TokenType.True
        "null" => TokenType.Null
        "this" => TokenType.This
        "void" => TokenType.Void
        "with" => TokenType.With
        "case" => TokenType.Case
        "const" => TokenType.Const
        "while" => TokenType.While
        "false" => TokenType.False
        "break" => TokenType.Break
        "catch" => TokenType.Catch
        "class" => TokenType.Class
        "super" => TokenType.Super
        "throw" => TokenType.Throw
        "yield" => TokenType.Yield
        "async" => TokenType.Async
        "await" => TokenType.Await
        "return" => TokenType.Return
        "typeof" => TokenType.Typeof
        "delete" => TokenType.Delete
        "switch" => TokenType.Switch
        "export" => TokenType.Export
        "import" => TokenType.Import
        "static" => TokenType.Static
        "default" => TokenType.Default
        "extends" => TokenType.Extends
        "finally" => TokenType.Finally
        "function" => TokenType.Function
        "continue" => TokenType.Continue
        "debugger" => TokenType.Debugger
        "undefined" => TokenType.Undefined
        "instanceof" => TokenType.Instanceof
        _ => TokenType.Identifier

# Scan an identifier or keyword
fn lexer_scan_identifier(lex: @&Lexer, start: i64, start_line: i64, start_col: i64) -> Token
    while is_alnum(lexer_peek(lex)) == 1
        lexer_advance(lex)

    let typ = check_keyword((lex.source).slice(start, lex.pos))
    token_new(typ, start, lex.pos - start, start_line, start_col)

# Operators are built from a few shapes. Each helper below has consumed the
# operator's first character(s) and consumes the rest of the longest match.

# X or X=
fn lexer_op_eq(lex: @&Lexer, plain: TokenType, eq: TokenType) -> TokenType
    if lexer_match(lex, '=') == 1
        return eq
    plain

# c, c=, cc, cc= (the shape of * & | <)
fn lexer_op_doubled(lex: @&Lexer, c: u8, plain: TokenType, eq: TokenType, dbl: TokenType, dbl_eq: TokenType) -> TokenType
    if lexer_match(lex, c) == 1
        return lexer_op_eq(lex, dbl, dbl_eq)
    lexer_op_eq(lex, plain, eq)

# c, c=, cc (the shape of + -)
fn lexer_op_incdec(lex: @&Lexer, c: u8, plain: TokenType, eq: TokenType, dbl: TokenType) -> TokenType
    if lexer_match(lex, c) == 1
        return dbl
    lexer_op_eq(lex, plain, eq)

# = == === =>
fn lexer_op_equals(lex: @&Lexer) -> TokenType
    if lexer_match(lex, '=') == 1
        return lexer_op_eq(lex, TokenType.EqEq, TokenType.EqEqEq)
    if lexer_match(lex, '>') == 1
        return TokenType.Arrow
    TokenType.Eq

# ! != !==
fn lexer_op_bang(lex: @&Lexer) -> TokenType
    if lexer_match(lex, '=') == 1
        return lexer_op_eq(lex, TokenType.BangEq, TokenType.BangEqEq)
    TokenType.Bang

# > >= >> >>= >>> >>>=
fn lexer_op_greater(lex: @&Lexer) -> TokenType
    if lexer_match(lex, '>') == 0
        return lexer_op_eq(lex, TokenType.Gt, TokenType.GtEq)
    if lexer_match(lex, '>') == 1
        return lexer_op_eq(lex, TokenType.GtGtGt, TokenType.GtGtGtEq)
    lexer_op_eq(lex, TokenType.GtGt, TokenType.GtGtEq)

# ? ?? ??= ?.
fn lexer_op_question(lex: @&Lexer) -> TokenType
    if lexer_match(lex, '?') == 1
        return lexer_op_eq(lex, TokenType.QuestionQuestion, TokenType.QuestionQuestionEq)
    if lexer_match(lex, '.') == 1
        return TokenType.OptionalChain
    TokenType.Question

# . ...
fn lexer_op_dot(lex: @&Lexer) -> TokenType
    if lexer_peek(lex) == '.' and lexer_peek_next(lex) == '.'
        lexer_advance(lex)
        lexer_advance(lex)
        return TokenType.Ellipsis
    TokenType.Dot

# The punctuator or operator that starts with c (already consumed), taking
# the longest match; Error if c starts none
fn lexer_scan_punct(lex: @&Lexer, c: u8) -> TokenType
    match c
        '(' => TokenType.LParen
        ')' => TokenType.RParen
        '{' => TokenType.LBrace
        '}' => TokenType.RBrace
        '[' => TokenType.LBracket
        ']' => TokenType.RBracket
        ';' => TokenType.Semicolon
        ',' => TokenType.Comma
        ':' => TokenType.Colon
        '~' => TokenType.Tilde
        '.' => lexer_op_dot(lex)
        '+' => lexer_op_incdec(lex, c, TokenType.Plus, TokenType.PlusEq, TokenType.PlusPlus)
        '-' => lexer_op_incdec(lex, c, TokenType.Minus, TokenType.MinusEq, TokenType.MinusMinus)
        '*' => lexer_op_doubled(lex, c, TokenType.Star, TokenType.StarEq, TokenType.StarStar, TokenType.StarStarEq)
        '&' => lexer_op_doubled(lex, c, TokenType.Amp, TokenType.AmpEq, TokenType.AmpAmp, TokenType.AmpAmpEq)
        '|' => lexer_op_doubled(lex, c, TokenType.Pipe, TokenType.PipeEq, TokenType.PipePipe, TokenType.PipePipeEq)
        '<' => lexer_op_doubled(lex, c, TokenType.Lt, TokenType.LtEq, TokenType.LtLt, TokenType.LtLtEq)
        '/' => lexer_op_eq(lex, TokenType.Slash, TokenType.SlashEq)
        '%' => lexer_op_eq(lex, TokenType.Percent, TokenType.PercentEq)
        '^' => lexer_op_eq(lex, TokenType.Caret, TokenType.CaretEq)
        '!' => lexer_op_bang(lex)
        '=' => lexer_op_equals(lex)
        '>' => lexer_op_greater(lex)
        '?' => lexer_op_question(lex)
        _ => TokenType.Error

# Scan the next token
fn lexer_next(lex: @&Lexer) -> Token
    lexer_skip_whitespace(lex)

    if lexer_is_eof(lex) == 1
        return token_eof(lex.pos, lex.line, lex.column)

    let start = lex.pos
    let start_line = lex.line
    let start_col = lex.column
    let c = lexer_advance(lex)

    if is_digit(c) == 1
        return lexer_scan_number(lex, start, start_line, start_col)
    if is_alpha(c) == 1
        return lexer_scan_identifier(lex, start, start_line, start_col)
    if c == '"' or c == '\''
        return lexer_scan_string(lex, c, start, start_line, start_col)

    let typ = lexer_scan_punct(lex, c)
    if typ == TokenType.Error
        return token_error(start, start_line, start_col)
    token_new(typ, start, lex.pos - start, start_line, start_col)

# Tokenize entire source into a vector of tokens
pub fn lexer_tokenize(source: StrView) -> Vec<Token>
    var lex = lexer_new(source)
    var tokens: Vec<Token> = vec_new<Token>()

    while 1 == 1
        let tok = lexer_next(@&lex)
        let tok_typ = tok.typ
        vec_push<Token>(@&tokens, tok)
        if tok_typ == TokenType.Eof or tok_typ == TokenType.Error
            break

    tokens

# Get the text of a token from the source
pub fn token_text(source: StrView, tok: @Token) -> StrView
    source.slice(tok.start, tok.start + tok.length)

