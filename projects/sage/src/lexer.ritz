# 10^k as an f64: the nearest double for 0 <= k <= 308, Infinity above,
# and 1 / 10^-k for k < 0.
pub fn f64_pow10(k: i64) -> f64
    if k < 0
        return 1.0 / f64_pow10(0 - k)
    if k > 308
        let z: f64 = 0.0
        return 1.0 / z
    var bits: u64 = POW10_BITS[k]
    let fp: *f64 = @bits as *f64
    *fp

# Parse a decimal number literal (digits, optional fraction, optional
# exponent) as the nearest f64. Exact at every scale, including exponents
# beyond 10^22 and more than 15 significant digits (AGAST #4076); see
# src/float.ritz. Stops at the first other byte; the caller strips any sign.
pub fn strview_to_f64(s: StrView) -> f64
    float_decimal_to_f64(s)
