# Interpreter Tests (AGAST #2787)
#
# One case per evaluator rule: each runs a JavaScript program through
# js_run() and compares what console.log printed (and whether the run
# failed) with what node prints for the same program.

import ritzlib.io
import ritzlib.strview
import ritzlib.gvec
import src.token
import src.lexer
import src.ast
import src.parser
import src.interp

# =============================================================================
# Helpers
# =============================================================================

# Run `src`; it must succeed and print exactly `want`.
fn expect_out(src: StrView, want: StrView) -> i32
    let it = js_run(src)
    if interp_failed(@it) != 0
        prints("FAIL: program failed: ")
        prints(interp_error(@it))
        prints("\n  source: ")
        prints(src)
        prints("\n")
        return 1
    let got = interp_output(@it)
    if strview_eq(got, want) == false
        prints("FAIL: output mismatch\n  source: ")
        prints(src)
        prints("\n  want: [")
        prints(want)
        prints("]\n  got:  [")
        prints(got)
        prints("]\n")
        return 1
    0

# Run `src`; it must fail with an error message containing `want`, after
# printing exactly `want_out`.
fn expect_fail(src: StrView, want: StrView, want_out: StrView) -> i32
    let it = js_run(src)
    if interp_failed(@it) == 0
        prints("FAIL: program should have failed\n  source: ")
        prints(src)
        prints("\n")
        return 1
    let err = interp_error(@it)
    if strview_contains(err, want) == false
        prints("FAIL: error lacks [")
        prints(want)
        prints("]: [")
        prints(err)
        prints("]\n")
        return 1
    let got = interp_output(@it)
    if strview_eq(got, want_out) == false
        prints("FAIL: output before the error\n  want: [")
        prints(want_out)
        prints("]\n  got:  [")
        prints(got)
        prints("]\n")
        return 1
    0

# =============================================================================
# The ticket's program, numbers and arithmetic
# =============================================================================

[[test]]
fn test_console_log_6_times_7() -> i32
    expect_out("console.log(6 * 7);\n", "42\n")

[[test]]
fn test_arithmetic_precedence() -> i32
    expect_out("console.log(1 + 2 * 3 - 4 / 2, (1 + 2) * 3, 2 ** 3 ** 2, 10 % 3)", "5 9 512 1\n")

[[test]]
fn test_number_to_string() -> i32
    expect_out("console.log(0.1 + 0.2, 1 / 3, -0.5, 1e21, 1e-7, 2 ** 53, 123.456, 100)", "0.30000000000000004 0.3333333333333333 -0.5 1e+21 1e-7 9007199254740992 123.456 100\n")

[[test]]
fn test_number_to_string_17_digits_and_extremes() -> i32
    expect_out("console.log(2 ** 0.5, 1e16 / 3, 0.07 * 100, 1e100, 5e-324, 123456789012345680000, -0, '' + -0)", "1.4142135623730951 3333333333333333.5 7.000000000000001 1e+100 5e-324 123456789012345680000 -0 0\n")

# Shortest round-tripping digits must stay exact when the decimal scale is
# beyond 10^22, at both ends of the exponent range (AGAST #4076).
[[test]]
fn test_number_to_string_exact_beyond_10_22() -> i32
    expect_out("console.log(1.7976931348623157e308, 1.7976931348623155e308)", "1.7976931348623157e+308 1.7976931348623155e+308\n")
    expect_out("console.log(2.2250738585072014e-308, 2.2250738585072011e-308)", "2.2250738585072014e-308 2.225073858507201e-308\n")
    expect_out("console.log(9.999999999999999e307, 1e308, 1e-308, 1.2345678901234567e-200)", "9.999999999999998e+307 1e+308 1e-308 1.2345678901234567e-200\n")

[[test]]
fn test_nan_and_infinity() -> i32
    expect_out("console.log(0 / 0, 1 / 0, -1 / 0, 'x' * 2)", "NaN Infinity -Infinity NaN\n")

[[test]]
fn test_unary_and_ternary() -> i32
    expect_out("console.log(!0, -(3), +'4', 5 > 3 ? 'y' : 'n', ~5, void 1)", "true -3 4 y -6 undefined\n")

[[test]]
fn test_bitwise() -> i32
    expect_out("console.log(5 & 3, 5 | 3, 5 ^ 3, 1 << 4, -16 >> 2, -1 >>> 28, 4294967297 | 0)", "1 7 6 16 -4 15 1\n")

# =============================================================================
# Strings
# =============================================================================

[[test]]
fn test_string_concat() -> i32
    expect_out("console.log('a' + \"b\", 'n=' + 42, 1 + '2', 'x' + true + null)", "ab n=42 12 xtruenull\n")

[[test]]
fn test_string_escapes() -> i32
    expect_out("console.log('x\\ty\\n\\'q\\'\\\\')", "x\ty\n'q'\\\n")

[[test]]
fn test_string_compare_and_length() -> i32
    expect_out("console.log('abc'.length, 'a' < 'b', 'b' < 'a', 'ab' === 'a' + 'b')", "3 true false true\n")

# =============================================================================
# Values and coercions
# =============================================================================

[[test]]
fn test_print_value_kinds() -> i32
    expect_out("function f() {}\nconsole.log(true, null, undefined, f, function () {})\nconsole.log()", "true null undefined [Function: f] [Function (anonymous)]\n\n")

[[test]]
fn test_equality() -> i32
    expect_out("console.log(1 == '1', 1 === '1', null == undefined, null === undefined, 0 / 0 === 0 / 0, 1 != 2)", "true false true false false true\n")

[[test]]
fn test_typeof() -> i32
    expect_out("function f() {}\nconsole.log(typeof 1, typeof 'a', typeof undefined, typeof f, typeof null, typeof true, typeof nope)", "number string undefined function object boolean undefined\n")

[[test]]
fn test_logical_operators() -> i32
    expect_out("let n = 0;\nfunction bump() { n += 1; return n; }\nconsole.log(0 || 'x', 1 && 2, null ?? 3, 0 ?? 3, false && bump(), true || bump(), n)", "x 2 3 0 false true 0\n")

# =============================================================================
# Variables
# =============================================================================

[[test]]
fn test_let_const_and_assignment_ops() -> i32
    expect_out("let x = 5;\nconst y = 2;\nx += 3;\nx *= y;\nx -= 1;\nlet z;\nconsole.log(x, z)", "15 undefined\n")

[[test]]
fn test_update_expressions() -> i32
    expect_out("let i = 0;\nconsole.log(i++, i, ++i, i--, --i)", "0 1 2 2 0\n")

[[test]]
fn test_block_scope_shadowing() -> i32
    expect_out("let x = 1;\n{ let x = 2; console.log(x); }\nconsole.log(x)", "2\n1\n")

[[test]]
fn test_const_reassign_fails() -> i32
    expect_fail("const c = 1;\nconsole.log(c);\nc = 2;\nconsole.log('unreached')", "TypeError: Assignment to constant variable", "1\n")

[[test]]
fn test_undefined_variable_fails() -> i32
    expect_fail("console.log('before');\nconsole.log(nope)", "ReferenceError: nope is not defined", "before\n")

# =============================================================================
# Functions
# =============================================================================

[[test]]
fn test_function_call() -> i32
    expect_out("function add(a, b) { return a + b; }\nconsole.log(add(2, 3), add(1))", "5 NaN\n")

[[test]]
fn test_function_hoisting() -> i32
    expect_out("console.log(sq(4));\nfunction sq(n) { return n * n; }", "16\n")

[[test]]
fn test_recursion() -> i32
    expect_out("function fib(n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); }\nconsole.log(fib(15))", "610\n")

[[test]]
fn test_closure() -> i32
    expect_out("function counter() { let n = 0; return function () { n += 1; return n; }; }\nconst a = counter();\nconst b = counter();\na(); a();\nconsole.log(a(), b())", "3 1\n")

[[test]]
fn test_function_without_return() -> i32
    expect_out("function f(a, b) { a = b; }\nconsole.log(f(1, 2))", "undefined\n")

[[test]]
fn test_call_non_function_fails() -> i32
    expect_fail("let x = 3;\nx()", "TypeError: x is not a function", "")

[[test]]
fn test_runaway_recursion_fails() -> i32
    expect_fail("function r(n) { return r(n + 1); }\nr(0)", "RangeError: Maximum call stack size exceeded", "")

# =============================================================================
# Control flow
# =============================================================================

[[test]]
fn test_if_else() -> i32
    expect_out("function s(n) { if (n < 0) { return 'neg'; } else if (n === 0) { return 'zero'; } else return 'pos'; }\nconsole.log(s(-1), s(0), s(1))", "neg zero pos\n")

[[test]]
fn test_while_break_continue() -> i32
    expect_out("let i = 0;\nlet s = 0;\nwhile (true) { i++; if (i > 10) break; if (i % 2) continue; s += i; }\nconsole.log(s)", "30\n")

[[test]]
fn test_for_loop() -> i32
    expect_out("let s = '';\nfor (let i = 0; i < 3; i++) { s = s + i; }\nfor (;;) { break; }\nconsole.log(s)", "012\n")

[[test]]
fn test_do_while() -> i32
    expect_out("let i = 10;\ndo { i++; } while (i < 5);\nconsole.log(i)", "11\n")

[[test]]
fn test_var_is_function_scoped() -> i32
    expect_out("function f() { if (true) { var v = 7; } return v; }\nconsole.log(f())", "7\n")

# =============================================================================
# Objects
# =============================================================================

[[test]]
fn test_object_properties() -> i32
    expect_out("let o = {a: 1, 'b': 'x'};\no.c = o.a + 2;\no['a'] = 5;\nconsole.log(o.a, o.c, o['b'], o.z)", "5 3 x undefined\n")

[[test]]
fn test_console_log_object() -> i32
    expect_out("console.log({a: 1, b: 'x', c: {d: true}}, {}, 'o: ' + {})", "{ a: 1, b: 'x', c: { d: true } } {} o: [object Object]\n")

[[test]]
fn test_property_of_undefined_fails() -> i32
    expect_fail("let o;\no.x", "TypeError: Cannot read properties of undefined", "")

# =============================================================================
# Arrays (AGAST #4074)
# =============================================================================

[[test]]
fn test_array_literal_console_log() -> i32
    expect_out("console.log([1, 'a'], [], [[1, 2], [3]], [null, undefined, true])", "[ 1, 'a' ] [] [ [ 1, 2 ], [ 3 ] ] [ null, undefined, true ]\n")

[[test]]
fn test_array_indexing() -> i32
    expect_out("let a = [10, 20, 30];\nconsole.log(a[0], a[2], a[3]);\na[0] = 1;\na[5] = 6;\nconsole.log(a, a.length)", "10 30 undefined\n[ 1, 20, 30, undefined, undefined, 6 ] 6\n")

[[test]]
fn test_array_element_compound_assignment() -> i32
    expect_out("let a = [1, 2];\na[0] += 4;\na[1]++;\nconsole.log(a);\nlet old = a[0]++;\nconsole.log(old, a[0])", "[ 5, 3 ]\n5 6\n")

[[test]]
fn test_array_length_get_and_set() -> i32
    expect_out("let a = [1, 2, 3];\na.length = 1;\nconsole.log(a, a.length);\na.length = 3;\nconsole.log(a)", "[ 1 ] 1\n[ 1, undefined, undefined ]\n")

[[test]]
fn test_array_length_invalid() -> i32
    expect_fail("let a = [];\na.length = -1;", "RangeError: Invalid array length", "")

[[test]]
fn test_array_push_pop() -> i32
    expect_out("let a = [];\nlet n = a.push(1, 2);\nconsole.log(n, a, a.length);\nconsole.log(a.push());\nlet p = a.pop();\nconsole.log(p, a);\np = a.pop();\nlet q = a.pop();\nconsole.log(p, q, a.length, a)", "2 [ 1, 2 ] 2\n2\n2 [ 1 ]\n1 undefined 0 []\n")

[[test]]
fn test_array_console_log_nested_values() -> i32
    expect_out("function f() {}\nconsole.log([{a: 1}, [2], f])", "[ { a: 1 }, [ 2 ], [Function: f] ]\n")

[[test]]
fn test_array_to_string() -> i32
    expect_out("console.log('a' + [1, 2] + 'b', [1, [2, 3]] + '', [null, undefined] + '|', [] + 'x')", "a1,2b 1,2,3 ,| x\n")

[[test]]
fn test_array_identity_and_truthiness() -> i32
    expect_out("let a = [];\nconsole.log(a === a, [] === [], typeof a, a ? 't' : 'f', ![])", "true false object t false\n")

[[test]]
fn test_array_named_property() -> i32
    expect_out("let a = [1];\na.foo = 'x';\nconsole.log(a.foo, a['foo'], a[-1])", "x x undefined\n")

[[test]]
fn test_for_of_array() -> i32
    expect_out("let out = '';\nfor (let x of [1, 2, 3, 4]) { if (x === 2) continue; if (x === 4) break; out += x; }\nconsole.log(out)", "13\n")

[[test]]
fn test_for_of_assigns_existing_binding() -> i32
    expect_out("let y = 0;\nfor (y of [7]) {}\nconsole.log(y)", "7\n")

[[test]]
fn test_for_of_non_iterable_fails() -> i32
    expect_fail("for (let x of 5) { console.log(x); }", "TypeError: 5 is not iterable", "")

# =============================================================================
# Exceptions
# =============================================================================

[[test]]
fn test_try_catch() -> i32
    expect_out("try { console.log('in'); throw 'boom'; console.log('no'); } catch (e) { console.log('caught ' + e); } finally { console.log('fin'); }", "in\ncaught boom\nfin\n")

[[test]]
fn test_finally_keeps_pending_completion() -> i32
    expect_out("function f() { try { return 'r'; } finally { console.log('f1'); } }\nfunction g() { try { try { throw 'x'; } finally { console.log('f2'); } } catch (e) { return 'caught ' + e; } }\nconsole.log(f(), g())", "f1\nf2\nr caught x\n")

[[test]]
fn test_catch_runtime_error() -> i32
    expect_out("try { nope; } catch (e) { console.log(e.name, e.message + '|' + e); }", "ReferenceError nope is not defined|ReferenceError: nope is not defined\n")

[[test]]
fn test_throw_through_function() -> i32
    expect_out("function f() { throw 42; }\ntry { f(); } catch (e) { console.log(e + 1); }", "43\n")

[[test]]
fn test_uncaught_throw_fails() -> i32
    expect_fail("console.log(1);\nthrow 'boom';\nconsole.log(2)", "Uncaught boom", "1\n")

[[test]]
fn test_syntax_error_fails() -> i32
    expect_fail("console.log(1);\nlet = ;", "SyntaxError", "")

# Trailing-dot numeric literals run and print like node (AGAST #4350).
[[test]]
fn test_trailing_dot_number_literals() -> i32
    expect_out("console.log(5.)\n", "5\n")
    expect_out("console.log(5.e-10)\n", "5e-10\n")
    expect_out("console.log(5. + 1, 2.)\n", "6 2\n")

# =============================================================================
# Arrow functions (AGAST #4075)
# =============================================================================

[[test]]
fn test_arrow_single_param() -> i32
    expect_out("const inc = x => x + 1;\nconsole.log(inc(4))", "5\n")

[[test]]
fn test_arrow_param_list() -> i32
    expect_out("const add = (a, b) => a + b;\nconsole.log(add(2, 3), add(10, 20))", "5 30\n")

[[test]]
fn test_arrow_block_body() -> i32
    expect_out("const sq = x => { return x * x; };\nconsole.log(sq(5))", "25\n")

[[test]]
fn test_arrow_no_params() -> i32
    expect_out("const answer = () => 42;\nconsole.log(answer())", "42\n")

# The expression body returns its value, even when called inline.
[[test]]
fn test_arrow_expression_body_returns_value() -> i32
    expect_out("console.log((x => x * 2)(21))", "42\n")

# Arrows nest and close over the enclosing scope.
[[test]]
fn test_arrow_nested_closure() -> i32
    expect_out("const mk = n => x => x + n;\nconst add10 = mk(10);\nconsole.log(add10(5), mk(1)(2))", "15 3\n")

[[test]]
fn test_arrow_block_body_without_return() -> i32
    expect_out("const f = () => { let x = 1; };\nconsole.log(f())", "undefined\n")

[[test]]
fn test_arrow_missing_argument_is_undefined() -> i32
    expect_out("const f = (a, b) => b;\nconsole.log(f(1))", "undefined\n")

# An arrow is an ordinary expression value: it can be passed around.
[[test]]
fn test_arrow_as_argument() -> i32
    expect_out("function apply(f, x) { return f(x); }\nconsole.log(apply(y => y + 1, 41))", "42\n")

# =============================================================================
# Standard built-ins (AGAST #4077): Math, String, Number, Object
#
# Every `want` below is what node prints for the same program. Each test
# accumulates every expect_out result: a function returns only its last
# expression's value, so an unaccumulated early mismatch would be masked.
# =============================================================================

[[test]]
fn test_math_constants() -> i32
    expect_out("console.log(Math.PI, Math.E, Math.SQRT2, Math.SQRT1_2, Math.LN2, Math.LN10, Math.LOG2E, Math.LOG10E);\n", "3.141592653589793 2.718281828459045 1.4142135623730951 0.7071067811865476 0.6931471805599453 2.302585092994046 1.4426950408889634 0.4342944819032518\n")

[[test]]
fn test_math_abs_and_rounding() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(Math.abs(-3), Math.abs(3), Math.abs(-0), Math.abs(NaN));\n", "3 3 0 NaN\n")
    r = r + expect_out("console.log(Math.floor(1.7), Math.floor(-1.2), Math.floor(-0), Math.floor(2), Math.floor(NaN));\n", "1 -2 -0 2 NaN\n")
    r = r + expect_out("console.log(Math.ceil(1.2), Math.ceil(-1.7), Math.ceil(-0), Math.ceil(NaN));\n", "2 -1 -0 NaN\n")
    r = r + expect_out("console.log(Math.round(2.5), Math.round(-2.5), Math.round(-0.5), Math.round(0.5), Math.round(1.4), Math.round(-0.4));\n", "3 -2 -0 1 1 -0\n")
    r = r + expect_out("console.log(Math.trunc(1.9), Math.trunc(-1.9), Math.trunc(-0.9), Math.trunc(NaN));\n", "1 -1 -0 NaN\n")
    r = r + expect_out("console.log(Math.sign(-5), Math.sign(5), Math.sign(0), Math.sign(-0), Math.sign(NaN));\n", "-1 1 0 -0 NaN\n")
    r

[[test]]
fn test_math_min_max() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(Math.min(3, 1, 2), Math.max(3, 1, 2), Math.min(), Math.max());\n", "1 3 Infinity -Infinity\n")
    r = r + expect_out("console.log(Math.min(NaN, 1), Math.max(1, NaN), Math.min(0, -0), Math.max(-0, 0));\n", "NaN NaN -0 0\n")
    r

[[test]]
fn test_math_pow_sqrt_cbrt() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(Math.pow(2, 10), Math.pow(2, 0.5), Math.pow(-2, 3), Math.pow(NaN, 0));\n", "1024 1.4142135623730951 -8 1\n")
    r = r + expect_out("console.log(Math.sqrt(16), Math.sqrt(2), Math.sqrt(-1), Math.sqrt(0));\n", "4 1.4142135623730951 NaN 0\n")
    r = r + expect_out("console.log(Math.cbrt(27), Math.cbrt(8), Math.cbrt(-8), Math.cbrt(0));\n", "3 2 -2 0\n")
    r

# These inputs are exact 1-ulp matches for node; exp(1) itself differs by one
# ulp, so the goldens pin values where the two agree bit for bit.
[[test]]
fn test_math_log_and_exp() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(Math.log(1), Math.log(2), Math.log(0.5), Math.log(Math.E), Math.log2(8), Math.log2(1024), Math.log10(100), Math.log10(0.01));\n", "0 0.6931471805599453 -0.6931471805599453 1 3 10 2 -2\n")
    r = r + expect_out("console.log(Math.exp(0), Math.exp(-1), Math.exp(0.5), Math.exp(2), Math.exp(Infinity), Math.exp(-Infinity));\n", "1 0.36787944117144233 1.6487212707001282 7.38905609893065 Infinity 0\n")
    r

[[test]]
fn test_string_number_boolean_conversions() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(String(123), String(-0), String(1e21), String(undefined), String(null), String(true), String('x'), String([1,2]), String({}));\n", "123 0 1e+21 undefined null true x 1,2 [object Object]\n")
    r = r + expect_out("console.log(String());\n", "\n")
    r = r + expect_out("console.log(Number('4'), Number(''), Number('  12  '), Number('-3.5'), Number(true), Number(false), Number(null), Number(), Number(undefined), Number('x'), Number('Infinity'));\n", "4 0 12 -3.5 1 0 0 0 NaN NaN Infinity\n")
    r = r + expect_out("console.log(Boolean(0), Boolean(''), Boolean('a'), Boolean(null), Boolean(undefined), Boolean(NaN), Boolean([]), Boolean({}));\n", "false false true false false false true true\n")
    r

[[test]]
fn test_number_statics_and_constants() -> i32
    var r: i32 = 0
    r = r + expect_out("console.log(Number.isInteger(5), Number.isInteger(5.5), Number.isInteger('5'), Number.isInteger(Infinity), Number.isInteger(NaN));\n", "true false false false false\n")
    r = r + expect_out("console.log(Number.isNaN(NaN), Number.isNaN('NaN'), Number.isNaN(1));\n", "true false false\n")
    r = r + expect_out("console.log(Number.isFinite(1), Number.isFinite(Infinity), Number.isFinite(NaN), Number.isFinite('1'));\n", "true false false false\n")
    r = r + expect_out("console.log(Number.isSafeInteger(9007199254740991), Number.isSafeInteger(9007199254740992), Number.isSafeInteger(1.5));\n", "true false false\n")
    r = r + expect_out("console.log(Number.MAX_SAFE_INTEGER, Number.MIN_SAFE_INTEGER, Number.EPSILON, Number.MAX_VALUE, Number.MIN_VALUE);\n", "9007199254740991 -9007199254740991 2.220446049250313e-16 1.7976931348623157e+308 5e-324\n")
    r = r + expect_out("console.log(Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY, Number.NaN);\n", "Infinity -Infinity NaN\n")
    r

[[test]]
fn test_builtin_function_types() -> i32
    expect_out("console.log(typeof Number, typeof String, typeof Object, typeof Math, typeof Boolean);\n", "function function function object function\n")

[[test]]
fn test_object_keys_values_entries() -> i32
    var r: i32 = 0
    r = r + expect_out("let o = {a: 1, b: 'x'};\nconsole.log(Object.keys(o), Object.values(o), Object.entries(o));\n", "[ 'a', 'b' ] [ 1, 'x' ] [ [ 'a', 1 ], [ 'b', 'x' ] ]\n")
    r = r + expect_out("console.log(Object.keys([10, 20]), Object.values([10, 20]));\n", "[ '0', '1' ] [ 10, 20 ]\n")
    r = r + expect_out("console.log(Object.keys(1), Object.keys('ab'));\n", "[] [ '0', '1' ]\n")
    r

[[test]]
fn test_object_assign_is_freeze() -> i32
    var r: i32 = 0
    r = r + expect_out("let o = {a: 1, b: 'x'};\nlet t = {};\nconsole.log(Object.assign(t, o, {c: 3}), t);\n", "{ a: 1, b: 'x', c: 3 } { a: 1, b: 'x', c: 3 }\n")
    r = r + expect_out("console.log(Object.is(NaN, NaN), Object.is(0, -0), Object.is(1, 1), Object.is('a', 'a'));\n", "true false true true\n")
    r = r + expect_out("let fr = {x: 1};\nconsole.log(Object.freeze(fr) === fr, fr.x, Object.isFrozen(fr));\n", "true 1 true\n")
    r

[[test]]
fn test_string_char_and_search() -> i32
    var r: i32 = 0
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.charAt(0), s.charAt(4), s.charAt(-1), s.charAt(99));\n", "H o  \n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.charCodeAt(0), s.charCodeAt(7), s.charCodeAt(99));\n", "72 87 NaN\n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.indexOf('o'), s.indexOf('o', 5), s.indexOf('zz'), s.indexOf(''), s.indexOf('', 3), s.indexOf('o', -2));\n", "4 8 -1 0 3 4\n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.includes('World'), s.includes('world'), s.includes('World', 8), s.includes(''));\n", "true false false true\n")
    r

[[test]]
fn test_string_starts_ends_and_slicing() -> i32
    var r: i32 = 0
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.startsWith('Hello'), s.startsWith('World'), s.startsWith('World', 7));\n", "true false true\n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.endsWith('World'), s.endsWith('Hello'), s.endsWith('Hello', 5));\n", "true false true\n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.slice(7), s.slice(0, 5), s.slice(-5), s.slice(-5, -1), s.slice(5, 2));\n", "World Hello World Worl \n")
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.substring(7), s.substring(0, 5), s.substring(5, 2), s.substring(-3, 2));\n", "World Hello llo He\n")
    r

[[test]]
fn test_string_case_trim_repeat_concat() -> i32
    var r: i32 = 0
    r = r + expect_out("let s = 'Hello, World';\nconsole.log(s.toUpperCase(), s.toLowerCase());\n", "HELLO, WORLD hello, world\n")
    r = r + expect_out("console.log('  pad  '.trim(), '  pad  '.trim().length, 'x'.trim());\n", "pad 3 x\n")
    r = r + expect_out("console.log('ab'.repeat(3), 'x'.repeat(0), ''.repeat(5));\n", "ababab  \n")
    r = r + expect_out("console.log('a'.concat('b', 'c', 1));\n", "abc1\n")
    r = r + expect_out("console.log('abc'.charAt(), 'abc'.charCodeAt());\n", "a 97\n")
    r

# Object.keys of null/undefined is the one TypeError node raises here.
[[test]]
fn test_object_keys_null_fails() -> i32
    expect_fail("Object.keys(null)", "TypeError: Cannot convert undefined or null to object", "")

# repeat rejects a negative or infinite count with RangeError.
[[test]]
fn test_string_repeat_invalid_count_fails() -> i32
    expect_fail("'x'.repeat(-1)", "RangeError: Invalid count value", "")

