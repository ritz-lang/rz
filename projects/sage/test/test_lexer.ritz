[[test]]
fn test_comments() -> i32
    let tokens = lexer_tokenize("42 // comment\n43")
    # 42 43 EOF = 3 tokens
    if vec_len<Token>(@tokens) != 3
        prints("FAIL: Expected 3 tokens with comment\n")
        return 1
    let tok0 = vec_get<Token>(@tokens, 0)
    let tok1 = vec_get<Token>(@tokens, 1)
    if tok0.typ != TokenType.Number
        return 1
    if tok1.typ != TokenType.Number
        return 1
    0

[[test]]
fn test_keywords() -> i32
    # Test several keywords
    let tokens = lexer_tokenize("if else while for return")
    if vec_len<Token>(@tokens) != 6
        return 1
    let tok_if = vec_get<Token>(@tokens, 0)
    let tok_else = vec_get<Token>(@tokens, 1)
    let tok_while = vec_get<Token>(@tokens, 2)
    let tok_for = vec_get<Token>(@tokens, 3)
    let tok_return = vec_get<Token>(@tokens, 4)
    if tok_if.typ != TokenType.If
        return 1
    if tok_else.typ != TokenType.Else
        return 1
    if tok_while.typ != TokenType.While
        return 1
    if tok_for.typ != TokenType.For
        return 1
    if tok_return.typ != TokenType.Return
        return 1
    0

# ============================================================================
# Token tables (AGAST #3938): every keyword and every operator lexes to its
# own TokenType, alone and as a whole token
# ============================================================================

# 0 if SRC lexes to exactly one WANT token then EOF and token_type_name
# names WANT, else 1 (and says which)
fn expect_one(src: StrView, want: TokenType) -> i32
    let tokens = lexer_tokenize(src)
    let tok = vec_get<Token>(@tokens, 0)
    let named = strview_eq(token_type_name(want), "UNKNOWN") == false
    if vec_len<Token>(@tokens) == 2 and tok.typ == want and tok.length == strview_len(src) and named
        return 0
    prints("FAIL: [")
    prints(src)
    prints("] want ")
    prints(token_type_name(want))
    prints(", got ")
    prints(token_type_name(tok.typ))
    prints("\n")
    1

[[test]]
fn test_every_keyword() -> i32
    var fails: i32 = 0
    fails = fails + expect_one("let", TokenType.Let)
    fails = fails + expect_one("const", TokenType.Const)
    fails = fails + expect_one("var", TokenType.Var)
    fails = fails + expect_one("function", TokenType.Function)
    fails = fails + expect_one("return", TokenType.Return)
    fails = fails + expect_one("if", TokenType.If)
    fails = fails + expect_one("else", TokenType.Else)
    fails = fails + expect_one("while", TokenType.While)
    fails = fails + expect_one("for", TokenType.For)
    fails = fails + expect_one("true", TokenType.True)
    fails = fails + expect_one("false", TokenType.False)
    fails = fails + expect_one("null", TokenType.Null)
    fails = fails + expect_one("undefined", TokenType.Undefined)
    fails = fails + expect_one("new", TokenType.New)
    fails = fails + expect_one("this", TokenType.This)
    fails = fails + expect_one("class", TokenType.Class)
    fails = fails + expect_one("extends", TokenType.Extends)
    fails = fails + expect_one("super", TokenType.Super)
    fails = fails + expect_one("import", TokenType.Import)
    fails = fails + expect_one("export", TokenType.Export)
    fails = fails + expect_one("default", TokenType.Default)
    fails = fails + expect_one("break", TokenType.Break)
    fails = fails + expect_one("continue", TokenType.Continue)
    fails = fails + expect_one("switch", TokenType.Switch)
    fails = fails + expect_one("case", TokenType.Case)
    fails = fails + expect_one("throw", TokenType.Throw)
    fails = fails + expect_one("try", TokenType.Try)
    fails = fails + expect_one("catch", TokenType.Catch)
    fails = fails + expect_one("finally", TokenType.Finally)
    fails = fails + expect_one("typeof", TokenType.Typeof)
    fails = fails + expect_one("instanceof", TokenType.Instanceof)
    fails = fails + expect_one("in", TokenType.In)
    fails = fails + expect_one("of", TokenType.Of)
    fails = fails + expect_one("async", TokenType.Async)
    fails = fails + expect_one("await", TokenType.Await)
    fails = fails + expect_one("yield", TokenType.Yield)
    fails = fails + expect_one("static", TokenType.Static)
    fails = fails + expect_one("get", TokenType.Get)
    fails = fails + expect_one("set", TokenType.Set)
    fails = fails + expect_one("do", TokenType.Do)
    fails = fails + expect_one("debugger", TokenType.Debugger)
    fails = fails + expect_one("with", TokenType.With)
    fails = fails + expect_one("delete", TokenType.Delete)
    fails = fails + expect_one("void", TokenType.Void)
    fails

# Near misses of a keyword are identifiers
[[test]]
fn test_keyword_near_misses() -> i32
    var fails: i32 = 0
    fails = fails + expect_one("i", TokenType.Identifier)
    fails = fails + expect_one("iff", TokenType.Identifier)
    fails = fails + expect_one("lets", TokenType.Identifier)
    fails = fails + expect_one("Let", TokenType.Identifier)
    fails = fails + expect_one("IF", TokenType.Identifier)
    fails = fails + expect_one("functions", TokenType.Identifier)
    fails = fails + expect_one("instanceof_", TokenType.Identifier)
    fails = fails + expect_one("of1", TokenType.Identifier)
    fails = fails + expect_one("$if", TokenType.Identifier)
    fails = fails + expect_one("_do", TokenType.Identifier)
    fails = fails + expect_one("undefine", TokenType.Identifier)
    fails

[[test]]
fn test_every_operator() -> i32
    var fails: i32 = 0
    fails = fails + expect_one("+", TokenType.Plus)
    fails = fails + expect_one("-", TokenType.Minus)
    fails = fails + expect_one("*", TokenType.Star)
    fails = fails + expect_one("/", TokenType.Slash)
    fails = fails + expect_one("%", TokenType.Percent)
    fails = fails + expect_one("**", TokenType.StarStar)
    fails = fails + expect_one("=", TokenType.Eq)
    fails = fails + expect_one("==", TokenType.EqEq)
    fails = fails + expect_one("===", TokenType.EqEqEq)
    fails = fails + expect_one("!", TokenType.Bang)
    fails = fails + expect_one("!=", TokenType.BangEq)
    fails = fails + expect_one("!==", TokenType.BangEqEq)
    fails = fails + expect_one("<", TokenType.Lt)
    fails = fails + expect_one("<=", TokenType.LtEq)
    fails = fails + expect_one(">", TokenType.Gt)
    fails = fails + expect_one(">=", TokenType.GtEq)
    fails = fails + expect_one("&&", TokenType.AmpAmp)
    fails = fails + expect_one("||", TokenType.PipePipe)
    fails = fails + expect_one("??", TokenType.QuestionQuestion)
    fails = fails + expect_one("&", TokenType.Amp)
    fails = fails + expect_one("|", TokenType.Pipe)
    fails = fails + expect_one("^", TokenType.Caret)
    fails = fails + expect_one("~", TokenType.Tilde)
    fails = fails + expect_one("<<", TokenType.LtLt)
    fails = fails + expect_one(">>", TokenType.GtGt)
    fails = fails + expect_one(">>>", TokenType.GtGtGt)
    fails = fails + expect_one("+=", TokenType.PlusEq)
    fails = fails + expect_one("-=", TokenType.MinusEq)
    fails = fails + expect_one("*=", TokenType.StarEq)
    fails = fails + expect_one("/=", TokenType.SlashEq)
    fails = fails + expect_one("%=", TokenType.PercentEq)
    fails = fails + expect_one("&=", TokenType.AmpEq)
    fails = fails + expect_one("|=", TokenType.PipeEq)
    fails = fails + expect_one("^=", TokenType.CaretEq)
    fails = fails + expect_one("<<=", TokenType.LtLtEq)
    fails = fails + expect_one(">>=", TokenType.GtGtEq)
    fails = fails + expect_one(">>>=", TokenType.GtGtGtEq)
    fails = fails + expect_one("**=", TokenType.StarStarEq)
    fails = fails + expect_one("&&=", TokenType.AmpAmpEq)
    fails = fails + expect_one("||=", TokenType.PipePipeEq)
    fails = fails + expect_one("??=", TokenType.QuestionQuestionEq)
    fails = fails + expect_one("++", TokenType.PlusPlus)
    fails = fails + expect_one("--", TokenType.MinusMinus)
    fails = fails + expect_one("(", TokenType.LParen)
    fails = fails + expect_one(")", TokenType.RParen)
    fails = fails + expect_one("{", TokenType.LBrace)
    fails = fails + expect_one("}", TokenType.RBrace)
    fails = fails + expect_one("[", TokenType.LBracket)
    fails = fails + expect_one("]", TokenType.RBracket)
    fails = fails + expect_one(";", TokenType.Semicolon)
    fails = fails + expect_one(",", TokenType.Comma)
    fails = fails + expect_one(".", TokenType.Dot)
    fails = fails + expect_one(":", TokenType.Colon)
    fails = fails + expect_one("?", TokenType.Question)
    fails = fails + expect_one("=>", TokenType.Arrow)
    fails = fails + expect_one("...", TokenType.Ellipsis)
    fails = fails + expect_one("?.", TokenType.OptionalChain)
    fails

# Longest match, then the rest: ">>>==" is ">>>=" then "="
[[test]]
fn test_operator_longest_match() -> i32
    let tokens = lexer_tokenize(">>>== ?.. ....")
    let want0 = vec_get<Token>(@tokens, 0)
    let want1 = vec_get<Token>(@tokens, 1)
    let want2 = vec_get<Token>(@tokens, 2)
    let want3 = vec_get<Token>(@tokens, 3)
    let want4 = vec_get<Token>(@tokens, 4)
    let want5 = vec_get<Token>(@tokens, 5)
    if vec_len<Token>(@tokens) != 7
        return 1
    if want0.typ != TokenType.GtGtGtEq or want1.typ != TokenType.Eq
        return 1
    if want2.typ != TokenType.OptionalChain or want3.typ != TokenType.Dot
        return 1
    if want4.typ != TokenType.Ellipsis or want5.typ != TokenType.Dot
        return 1
    0

[[test]]
fn test_unknown_character_is_error() -> i32
    let tokens = lexer_tokenize("1 #")
    let tok = vec_get<Token>(@tokens, 1)
    # Stops there, with an empty token at the character, as an unterminated
    # string's error does
    if vec_len<Token>(@tokens) != 2 or tok.typ != TokenType.Error
        return 1
    if tok.start != 2 or tok.length != 0 or tok.column != 3
        return 1
    0

# token_type_name names every TokenType (it named 25 of 113 as i32 codes)
[[test]]
fn test_token_type_name() -> i32
    if strview_eq(token_type_name(TokenType.Eof), "EOF") == false
        return 1
    if strview_eq(token_type_name(TokenType.LParen), "LPAREN") == false
        return 1
    if strview_eq(token_type_name(TokenType.GtGtGtEq), "GT_GT_GT_EQ") == false
        return 1
    if strview_eq(token_type_name(TokenType.Instanceof), "INSTANCEOF") == false
        return 1
    if strview_eq(token_type_name(TokenType.Error), "ERROR") == false
        return 1
    0


# ============================================================================
# Number Literal Values (AGAST #2787)
# ============================================================================

# The value must be the double nearest the literal: console.log(0.1 + 0.2)
# prints 0.30000000000000004 only if 0.1 and 0.2 are exact.
[[test]]
fn test_strview_to_f64_is_correctly_rounded() -> i32
    if strview_to_f64("0.1") != 0.1
        prints("FAIL: 0.1\n")
        return 1
    if strview_to_f64("3.14159") != 3.14159
        prints("FAIL: 3.14159\n")
        return 1
    if strview_to_f64("123.456") != 123.456
        prints("FAIL: 123.456\n")
        return 1
    if strview_to_f64("1e3") != 1000.0
        prints("FAIL: 1e3\n")
        return 1
    if strview_to_f64("2.5e-3") != 0.0025
        prints("FAIL: 2.5e-3\n")
        return 1
    if strview_to_f64("1E+21") != 1.0e21
        prints("FAIL: 1E+21\n")
        return 1
    if strview_to_f64("9007199254740993") != 9007199254740992.0
        prints("FAIL: 2^53 + 1\n")
        return 1
    0

# ============================================================================
# Entry point
# ============================================================================

fn main(argc: i32, argv: **u8) -> i32
    prints("Running Sage Lexer Tests...\n")
    0
