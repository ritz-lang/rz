    if expect_node_type(@p, cond.child1, AstTag.Identifier) != 0
        return 1
    if expect_node_type(@p, cond.child2, AstTag.Identifier) != 0
        return 1
    if expect_node_type(@p, cond.child3, AstTag.Identifier) != 0
        return 1
    0

