# =============================================================================
# Complex Expression Tests
# =============================================================================

[[test]]
fn test_complex_expression() -> i32
    # a.b().c[d] - chained access
    var p = parse("a.b().c[d]")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)

    # Should be computed member access at the top
    if expect_node_type(@p, stmt.child1, AstTag.MemberExpr) != 0
        return 1
    0

[[test]]
fn test_operator_chaining() -> i32
    # a && b || c
    var p = parse("a && b || c")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)

    # || has lower precedence, so it's at the root
    let bin = ast_get_node(@p.ast, stmt.child1)
    if bin.int_value != OP_OR
        prints("FAIL: Expected OP_OR at root\n")
        return 1

    # Left should be &&
    let left = ast_get_node(@p.ast, bin.child1)
    if left.int_value != OP_AND
        prints("FAIL: Expected OP_AND on left\n")
        return 1
    0

# A number may end in a dot: `5.` is a NumberLiteral, not `5` followed by a
# Dot (AGAST #4350).
[[test]]
fn test_number_literal_trailing_dot() -> i32
    var p = parse("5.")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)
    if expect_node_type(@p, stmt.child1, AstTag.NumberLiteral) != 0
        return 1
    let num = ast_get_node(@p.ast, stmt.child1)
    if num.num_value != 5.0
        prints("FAIL: Expected 5.0\n")
        return 1
    0

# `5.e-10`: a dot with no fraction digits still takes the exponent
# (AGAST #4350).
[[test]]
fn test_number_literal_trailing_dot_with_exponent() -> i32
    var p = parse("5.e-10")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)
    if expect_node_type(@p, stmt.child1, AstTag.NumberLiteral) != 0
        return 1
    let num = ast_get_node(@p.ast, stmt.child1)
    if num.num_value < 4.9e-10 or num.num_value > 5.1e-10
        prints("FAIL: Expected ~5e-10\n")
        return 1
    0

# =============================================================================
# Arrow Function Tests (AGAST #4075)
# =============================================================================

# `x => expr` is an ArrowFunction with one param and an expression body.
[[test]]
fn test_arrow_single_param_expression_body() -> i32
    var p = parse("let f = x => x + 1")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let decl_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let decl = ast_get_node(@p.ast, decl_idx)
    let arrow = ast_get_node(@p.ast, ast_get_child(@p.ast, decl.children_start, 1))
    if arrow.tag != AstTag.ArrowFunction
        prints("FAIL: Expected ArrowFunction\n")
        return 1
    if arrow.children_count != 1
        prints("FAIL: Expected 1 parameter\n")
        return 1
    if arrow.bool_value != 1
        prints("FAIL: Expected an expression body\n")
        return 1
    if expect_node_type(@p, arrow.child1, AstTag.BinaryExpr) != 0
        return 1
    0

# `(a, b) => expr` parses the parenthesised group as a parameter list.
[[test]]
fn test_arrow_param_list_expression_body() -> i32
    var p = parse("let f = (a, b) => a + b")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let decl_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let decl = ast_get_node(@p.ast, decl_idx)
    let arrow = ast_get_node(@p.ast, ast_get_child(@p.ast, decl.children_start, 1))
    if arrow.tag != AstTag.ArrowFunction
        prints("FAIL: Expected ArrowFunction\n")
        return 1
    if arrow.children_count != 2
        prints("FAIL: Expected 2 parameters\n")
        return 1
    if arrow.bool_value != 1
        prints("FAIL: Expected an expression body\n")
        return 1
    0

# `x => { ... }` uses a block body.
[[test]]
fn test_arrow_block_body() -> i32
    var p = parse("let f = x => { return x; }")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let decl_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let decl = ast_get_node(@p.ast, decl_idx)
    let arrow = ast_get_node(@p.ast, ast_get_child(@p.ast, decl.children_start, 1))
    if arrow.tag != AstTag.ArrowFunction
        prints("FAIL: Expected ArrowFunction\n")
        return 1
    if arrow.bool_value != 0
        prints("FAIL: Expected a block body\n")
        return 1
    if expect_node_type(@p, arrow.child1, AstTag.BlockStmt) != 0
        return 1
    0

# `() => expr` has no parameters.
[[test]]
fn test_arrow_no_params() -> i32
    var p = parse("() => 42")
