    if arrow.children_count != 0
        prints("FAIL: Expected no parameters\n")
        return 1
    if arrow.bool_value != 1
        prints("FAIL: Expected an expression body\n")
        return 1
    0

# `(x) => x` is still an arrow, with one parameter.
[[test]]
fn test_arrow_single_parenthesised_param() -> i32
    var p = parse("let f = (x) => x * x")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let decl_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let decl = ast_get_node(@p.ast, decl_idx)
    let arrow = ast_get_node(@p.ast, ast_get_child(@p.ast, decl.children_start, 1))
    if arrow.tag != AstTag.ArrowFunction
        prints("FAIL: Expected ArrowFunction\n")
        return 1
    if arrow.children_count != 1
        prints("FAIL: Expected 1 parameter\n")
        return 1
    0

# A plain parenthesised expression is not mistaken for an arrow parameter list.
[[test]]
fn test_parenthesised_expression_is_not_arrow() -> i32
    var p = parse("let f = (a + b) * 2")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let decl_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let decl = ast_get_node(@p.ast, decl_idx)
    if expect_node_type(@p, ast_get_child(@p.ast, decl.children_start, 1), AstTag.BinaryExpr) != 0
        return 1
    0

# A parenthesised arrow is callable: `(x => x)(1)`.
[[test]]
fn test_parenthesised_arrow_call() -> i32
    var p = parse("(x => x * 2)(21)")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)
    let call = ast_get_node(@p.ast, stmt.child1)
    if call.tag != AstTag.CallExpr
        prints("FAIL: Expected CallExpr\n")
        return 1
    if expect_node_type(@p, call.child1, AstTag.ArrowFunction) != 0
        return 1
    0

