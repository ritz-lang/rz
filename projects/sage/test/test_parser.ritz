[[test]]
fn test_call_args_are_full_expressions() -> i32
    # Arguments, array elements and computed members were atoms only, so
    # `console.log(6 * 7)` did not parse (AGAST #2787).
    var p = parse("f(6 * 7, g(x), function (a) { return a; })[i + 1]")
    if expect_no_error(@p) != 0
        return 1

    let root = parser_root(@p)
    let root_node = ast_get_node(@p.ast, root)
    let stmt_idx = ast_get_child(@p.ast, root_node.children_start, 0)
    let stmt = ast_get_node(@p.ast, stmt_idx)
    if expect_node_type(@p, stmt.child1, AstTag.MemberExpr) != 0
        return 1
    let member = ast_get_node(@p.ast, stmt.child1)
    if expect_node_type(@p, member.child2, AstTag.BinaryExpr) != 0
        return 1

    let call = ast_get_node(@p.ast, member.child1)
    if call.children_count != 3
        prints("FAIL: Expected 3 arguments\n")
        return 1
    if expect_node_type(@p, ast_get_child(@p.ast, call.children_start, 0), AstTag.BinaryExpr) != 0
        return 1
    if expect_node_type(@p, ast_get_child(@p.ast, call.children_start, 1), AstTag.CallExpr) != 0
        return 1
    if expect_node_type(@p, ast_get_child(@p.ast, call.children_start, 2), AstTag.FunctionExpr) != 0
        return 1
    0

[[test]]
fn test_array_and_object_values_are_expressions() -> i32
    var p = parse("x = [1 + 2, -3]; y = {a: b * 2}")
    if expect_no_error(@p) != 0
        return 1
    0

