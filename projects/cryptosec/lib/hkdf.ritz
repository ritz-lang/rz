# lib/hkdf.ritz - HKDF (HMAC-based Key Derivation Function)
#
# Implementation of HKDF as defined in RFC 5869.
# Uses HMAC-SHA-256 as the underlying PRF.
#
# HKDF consists of two stages:
#   1. Extract: PRK = HMAC-Hash(salt, IKM)
#   2. Expand:  OKM = T(1) || T(2) || ... || T(N)
#              where T(i) = HMAC-Hash(PRK, T(i-1) || info || i)

import ritzlib.sys
import ritzlib.strview

import crypto_error
import hmac
import mem
import sha256

# ============================================================================
# Constants
# ============================================================================

const HKDF_SHA256_HASH_LEN: u64 = 32

# ============================================================================
# HKDF-Extract
# ============================================================================

# Extract a pseudorandom key (PRK) from input keying material
# salt: optional salt value (can be null, defaults to hash_len zeros)
# salt_len: length of salt in bytes
# ikm: input keying material
# ikm_len: length of IKM in bytes
# prk: output buffer for PRK (must be 32 bytes for SHA-256)
pub fn hkdf_extract(salt: *u8, salt_len: u64, ikm: *u8, ikm_len: u64, prk: *u8)
    if salt == null || salt_len == 0
        # Use a string of hash_len zeros as salt
        var zero_salt: [32]u8
        mem_zero(@zero_salt[0], 32)
        hmac_sha256(@zero_salt[0], 32, ikm, ikm_len, prk)
    else
        hmac_sha256(salt, salt_len, ikm, ikm_len, prk)

# ============================================================================
# HKDF-Expand
# ============================================================================

# Most output one HKDF-SHA256 expand can give: 255 * HashLen (RFC 5869 §2.3).
# The block counter is one octet, so T(256) does not exist.
pub const HKDF_SHA256_MAX_OKM_LEN: u64 = 8160

# out = T(i) = HMAC-SHA256(PRK, T(i-1) || info || i), RFC 5869 §2.3.
# HMAC is streamed through SHA-256 so info of any length is hashed in place:
# no concatenation buffer to outgrow (AGAST #2579, GitHub #140).
# t_prev_len is 0 for T(1) (T(0) is empty) and 32 after.
fn hkdf_sha256_block(prk: *u8, t_prev: *u8, t_prev_len: u64, info: *u8, info_len: u64, counter: u8, out: *u8)
    # PRK is HashLen (32) bytes, under the 64-byte block, so K' = PRK || 0*.
    var pad: [64]u8
    mem_zero(@pad[0], 64)
    mem_copy(@pad[0], prk, 32)
    var i: i32 = 0
    while i < 64
        pad[i] = pad[i] ^ 0x36
        i += 1

    var ctx: Sha256
    sha256_init(@ctx)
    sha256_update(@ctx, @pad[0], 64)
    sha256_update(@ctx, t_prev, t_prev_len)
    sha256_update(@ctx, info, info_len)
    var c: [1]u8
    c[0] = counter
    sha256_update(@ctx, @c[0], 1)
    var inner: [32]u8
    sha256_final(@ctx, @inner[0])

    # K' ^ opad = (K' ^ ipad) ^ (0x36 ^ 0x5c)
    i = 0
    while i < 64
        pad[i] = pad[i] ^ 0x6a
        i += 1
    sha256_init(@ctx)
    sha256_update(@ctx, @pad[0], 64)
    sha256_update(@ctx, @inner[0], 32)
    sha256_final(@ctx, out)

    mem_zero(@pad[0], sizeof(pad))
    mem_zero(@inner[0], sizeof(inner))
    mem_zero(@ctx as *u8, sizeof(Sha256))

# Expand a pseudorandom key into output keying material (RFC 5869 §2.3)
# prk: pseudorandom key (from extract, 32 bytes)
# info: optional context/application-specific info (null only if info_len is 0)
# info_len: length of info in bytes (no limit)
# okm: output keying material buffer
# okm_len: desired length of OKM in bytes, at most HKDF_SHA256_MAX_OKM_LEN
#
# Ok(okm_len) on success. Err(InvalidLength) if okm_len is over the maximum
# or info is null with a non-zero info_len; nothing is written then.
pub fn hkdf_expand(prk: *u8, info: *u8, info_len: u64, okm: *u8, okm_len: u64) -> Result<i64, CryptoError>
    if okm_len > HKDF_SHA256_MAX_OKM_LEN
        return Err(CryptoError.InvalidLength)
    if info == null && info_len > 0
        return Err(CryptoError.InvalidLength)

    let hash_len: u64 = 32
    # N = ceil(okm_len / hash_len) <= 255
    let n: u64 = (okm_len + hash_len - 1) / hash_len

    var t: [32]u8
    var offset: u64 = 0
    var i: u64 = 1
    while i <= n
        # T(i-1) is t; T(0) is empty. Reading and writing t in one call is
        # safe: t_prev is fully hashed before out is written.
        var t_prev_len: u64 = 32
        if i == 1
            t_prev_len = 0
        hkdf_sha256_block(prk, @t[0], t_prev_len, info, info_len, i as u8, @t[0])

        # Copy to output (may be partial for last block)
        var to_copy: u64 = hash_len
        if offset + to_copy > okm_len
            to_copy = okm_len - offset
        mem_copy(@okm[offset], @t[0], to_copy as i64)
        offset = offset + to_copy

        i += 1

    mem_zero(@t[0], sizeof(t))
    return Ok(okm_len as i64)

# ============================================================================
# Combined HKDF
# ============================================================================

# Combined extract-then-expand operation
# salt: optional salt (can be null)
# salt_len: length of salt
# ikm: input keying material
# ikm_len: length of IKM
# info: optional context info (can be null)
# info_len: length of info
# okm: output buffer
# okm_len: desired output length, at most HKDF_SHA256_MAX_OKM_LEN
#
# Ok(okm_len), or hkdf_expand's Err with nothing written.
pub fn hkdf_sha256(salt: *u8, salt_len: u64, ikm: *u8, ikm_len: u64, info: *u8, info_len: u64, okm: *u8, okm_len: u64) -> Result<i64, CryptoError>
    # Extract
    var prk: [32]u8
    hkdf_extract(salt, salt_len, ikm, ikm_len, @prk[0])

    # Expand (refuses before writing okm)
    let r: Result<i64, CryptoError> = hkdf_expand(@prk[0], info, info_len, okm, okm_len)

    # Zero PRK
    mem_zero(@prk[0], sizeof(prk))
    return r

# ============================================================================
# Idiomatic StrView API
# ============================================================================

# HKDF-Extract with StrView inputs (idiomatic Ritz API)
pub fn hkdf_extract_str(salt: @StrView, ikm: @StrView, prk: *u8)
    hkdf_extract(salt.ptr, salt.len as u64, ikm.ptr, ikm.len as u64, prk)

# HKDF-Expand with StrView inputs (idiomatic Ritz API)
pub fn hkdf_expand_str(prk: @StrView, info: @StrView, okm: *u8, okm_len: u64) -> Result<i64, CryptoError>
    return hkdf_expand(prk.ptr, info.ptr, info.len as u64, okm, okm_len)

# Combined HKDF with StrView inputs (idiomatic Ritz API)
pub fn hkdf_sha256_str(salt: @StrView, ikm: @StrView, info: @StrView, okm: *u8, okm_len: u64) -> Result<i64, CryptoError>
    return hkdf_sha256(salt.ptr, salt.len as u64, ikm.ptr, ikm.len as u64, info.ptr, info.len as u64, okm, okm_len)
