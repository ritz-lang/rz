# lib/rsa.ritz - RSA Signature Verification
#
# Implements RSA signature verification with PKCS#1 v1.5 padding (X.509
# certificate chains) and RSASSA-PSS with SHA-256 (TLS 1.3
# CertificateVerify, rsa_pss_rsae_sha256).
#
# References:
# - RFC 8017 (PKCS#1 v2.2)
# - RFC 3447 (PKCS#1 v2.1)

import mem
import bigint
import sha256
import sha512
import asn1
import ritzlib.memory { memzero }
import ritzlib.strview
import ritzlib.ct { ct_eq }

# ============================================================================
# Constants
# ============================================================================

const RSA_MAX_MODULUS_BYTES: i32 = 512   # 4096 bits max
const RSA_MIN_MODULUS_BYTES: i32 = 128   # 1024 bits min (though 2048+ recommended)

# PKCS#1 v1.5 DigestInfo prefixes (DER-encoded AlgorithmIdentifier + hash)
# SHA-256: 30 31 30 0d 06 09 60 86 48 01 65 03 04 02 01 05 00 04 20
const PKCS1_SHA256_PREFIX_LEN: i32 = 19
# SHA-384: 30 41 30 0d 06 09 60 86 48 01 65 03 04 02 02 05 00 04 30
const PKCS1_SHA384_PREFIX_LEN: i32 = 19
# SHA-512: 30 51 30 0d 06 09 60 86 48 01 65 03 04 02 03 05 00 04 40
const PKCS1_SHA512_PREFIX_LEN: i32 = 19

# ============================================================================
# RSA Public Key Structure
# ============================================================================

pub struct RsaPublicKey
    n: [512]u8          # Modulus (big-endian, up to 4096 bits)
    n_len: i32          # Modulus length in bytes
    e: u32              # Public exponent (usually 65537)

pub fn rsa_pubkey_init(key: *RsaPublicKey)
    memzero(@key.n[0], 512)
    key.n_len = 0
    key.e = 0

# ============================================================================
# RSA Public Key Parsing (from DER)
# ============================================================================

# Parse RSA public key from DER-encoded SubjectPublicKeyInfo or RSAPublicKey
# SubjectPublicKeyInfo ::= SEQUENCE {
#   algorithm AlgorithmIdentifier,
#   subjectPublicKey BIT STRING (containing RSAPublicKey)
# }
# RSAPublicKey ::= SEQUENCE {
#   modulus INTEGER,
#   publicExponent INTEGER
# }
pub fn rsa_parse_public_key(der: *u8, der_len: i32, key: *RsaPublicKey) -> i32
    rsa_pubkey_init(key)

    var parser: DerParser
    der_parser_init(@parser, der, der_len as u64)

    var outer: DerElement
    if der_parse_element(@parser, @outer) != 0
        return -1

    if der_is_sequence(@outer) != 1
        return -1

    # Parse inside the sequence
    var inner_parser: DerParser
    der_parser_init(@inner_parser, outer.content, outer.content_len)

    var first: DerElement
    if der_parse_element(@inner_parser, @first) != 0
        return -1

    # Check if this is SubjectPublicKeyInfo (first elem is SEQUENCE for algorithm)
    # or raw RSAPublicKey (first elem is INTEGER for modulus)
    if der_is_sequence(@first) == 1
        # SubjectPublicKeyInfo format - skip AlgorithmIdentifier, get BIT STRING
        var bit_string: DerElement
        if der_parse_element(@inner_parser, @bit_string) != 0
            return -2

        if der_is_bit_string(@bit_string) != 1
            return -3

        # BIT STRING content: first byte is unused bits count
        if bit_string.content_len < 2
            return -4

        let unused_bits: u8 = bit_string.content[0]
        if unused_bits != 0
            return -5  # RSA keys should have 0 unused bits

        # Parse the RSAPublicKey inside the BIT STRING
        var rsa_parser: DerParser
        der_parser_init(@rsa_parser, @bit_string.content[1], bit_string.content_len - 1)

        var rsa_seq: DerElement
        if der_parse_element(@rsa_parser, @rsa_seq) != 0
            return -6

        if der_is_sequence(@rsa_seq) != 1
            return -7

        return rsa_parse_pubkey_sequence(rsa_seq.content, rsa_seq.content_len as i32, key)

    else if der_is_integer(@first) == 1
        # Raw RSAPublicKey format - first is already the modulus
        # Parse modulus from first element
        if first.content_len == 0
            return -10

        # Copy modulus - strip ALL leading zeros (the 0x00 sign byte
        # included) before the length check: a 4096-bit modulus is 513
        # INTEGER content bytes (AGAST #2134).
        var start: u64 = 0
        while start < first.content_len - 1 && first.content[start] == 0
            start += 1

        let mod_len: u64 = first.content_len - start
        if mod_len > RSA_MAX_MODULUS_BYTES as u64
            return -11

        mem_copy(@key.n[0], @first.content[start], mod_len)
        key.n_len = mod_len as i32

        # Parse exponent
        var exp_elem: DerElement
        if der_parse_element(@inner_parser, @exp_elem) != 0
            return -12

        if der_is_integer(@exp_elem) != 1
            return -13

        var exp_val: u64 = 0
        if der_integer_to_u64(@exp_elem, @exp_val) != 0
            return -14

        if exp_val > 0xffffffff
            return -15  # Exponent too large

        key.e = exp_val as u32
        return 0

    return -20  # Unknown format

# Parse RSAPublicKey SEQUENCE content
fn rsa_parse_pubkey_sequence(data: *u8, len: i32, key: *RsaPublicKey) -> i32
    var parser: DerParser
    der_parser_init(@parser, data, len as u64)

    # Parse modulus
    var mod_elem: DerElement
    if der_parse_element(@parser, @mod_elem) != 0
        return -30

    if der_is_integer(@mod_elem) != 1
        return -31

    if mod_elem.content_len == 0
        return -32

    # Copy modulus - strip ALL leading zeros (the 0x00 sign byte included)
    # before the length check: a 4096-bit modulus is 513 INTEGER content
    # bytes (AGAST #2134).
    var start: u64 = 0
    while start < mod_elem.content_len - 1 && mod_elem.content[start] == 0
        start += 1

    let mod_len: u64 = mod_elem.content_len - start
    if mod_len > RSA_MAX_MODULUS_BYTES as u64
        return -33

    mem_copy(@key.n[0], @mod_elem.content[start], mod_len)
    key.n_len = mod_len as i32

    # Parse exponent
    var exp_elem: DerElement
    if der_parse_element(@parser, @exp_elem) != 0
        return -34

    if der_is_integer(@exp_elem) != 1
        return -35

    var exp_val: u64 = 0
    if der_integer_to_u64(@exp_elem, @exp_val) != 0
        return -36

    if exp_val > 0xffffffff
        return -37

    key.e = exp_val as u32
    return 0

# ============================================================================
# PKCS#1 v1.5 Signature Verification
# ============================================================================

# EMSA-PKCS1-v1_5 encoding (RFC 8017 §9.2 step 5) into out[0..k):
#   0x00 || 0x01 || PS (0xff, k - 3 - tLen bytes) || 0x00 || DigestInfo
# where DigestInfo = prefix[0..prefix_len) || hash[0..hash_len) (tLen bytes).
# Returns 0, or -1 if k is too short for the 8-byte minimum PS.
pub fn rsa_pkcs1_v15_encode(hash: *u8, hash_len: i32, prefix: *u8, prefix_len: i32, out: *u8, k: i32) -> i32
    let t_len: i32 = prefix_len + hash_len
    let ps_len: i32 = k - 3 - t_len
    if ps_len < 8
        return -1
    out[0] = 0x00
    out[1] = 0x01
    var i: i32 = 0
    while i < ps_len
        out[2 + i] = 0xff
        i += 1
    out[2 + ps_len] = 0x00
    mem_copy(@out[3 + ps_len], prefix, prefix_len as u64)
    mem_copy(@out[3 + ps_len + prefix_len], hash, hash_len as u64)
    return 0

# Verify RSA signature with PKCS#1 v1.5 padding (RSASSA-PKCS1-v1_5-VERIFY,
# RFC 8017 §8.2.2): m = s^e mod n, EM = I2OSP(m, k), then EM must equal
# EMSA-PKCS1-v1_5-ENCODE(hash). k fixes the PS length, so there is exactly
# one valid EM; it is built and compared over all k bytes with ct_eq, so the
# time taken does not depend on where the padding or hash goes wrong
# (REVIEW.md M-8, AGAST #2183).
fn rsa_verify_pkcs1(key: *RsaPublicKey, hash: *u8, hash_len: i32, hash_oid_prefix: *u8, prefix_len: i32, sig: *u8, sig_len: i32) -> i32
    # Signature length must match modulus length
    if sig_len != key.n_len
        return 0

    if key.n_len < RSA_MIN_MODULUS_BYTES || key.n_len > RSA_MAX_MODULUS_BYTES
        return 0

    # Expected EM: depends only on public inputs (hash, algorithm, k).
    var expected: [512]u8
    if rsa_pkcs1_v15_encode(hash, hash_len, hash_oid_prefix, prefix_len, @expected[0], key.n_len) != 0
        return 0

    # Convert signature to BigInt
    var s: BigInt
    if bigint_from_bytes(@s, sig, sig_len) != 0
        return 0

    # Convert modulus to BigInt
    var n: BigInt
    if bigint_from_bytes(@n, @key.n[0], key.n_len) != 0
        return 0

    # Check s < n
    if bigint_ge(@s, @n) == 1
        return 0

    # Compute m = s^e mod n
    var m: BigInt
    if bigint_mod_exp_u32(@m, @s, key.e, @n) != 0
        return 0

    # Convert result to bytes (same length as modulus)
    var em: [512]u8
    bigint_to_bytes_fixed(@m, @em[0], key.n_len)

    # Compare all k bytes; no early exit.
    let k: i64 = key.n_len as i64
    if !ct_eq(strview_from_ptr(@em[0], k), strview_from_ptr(@expected[0], k))
        return 0
    return 1  # Signature valid

# ============================================================================
# PKCS#1 v1.5 with SHA-256 / SHA-384 / SHA-512
# ============================================================================

# DigestInfo for SHA-2 hash `bits` (256, 384 or 512):
# SEQUENCE {
#   SEQUENCE {
#     OID 2.16.840.1.101.3.4.2.{1,2,3} (sha256, sha384, sha512)
#     NULL
#   }
#   OCTET STRING (hash_len bytes)
# }
# DER: 30 <0x11 + hash_len> 30 0d 06 09 60 86 48 01 65 03 04 02 <oid> 05 00 04 <hash_len>
# Writes the 19-byte prefix to out and returns its length.
fn sha2_digest_info_prefix(bits: i32, out: *u8) -> i32
    var hash_len: u8 = 32
    var oid: u8 = 0x01
    if bits == 384
        hash_len = 48
        oid = 0x02
    else if bits == 512
        hash_len = 64
        oid = 0x03
    out[0] = 0x30
    out[1] = 0x11 + hash_len
    out[2] = 0x30
    out[3] = 0x0d
    out[4] = 0x06
    out[5] = 0x09
    out[6] = 0x60
    out[7] = 0x86
    out[8] = 0x48
    out[9] = 0x01
    out[10] = 0x65
    out[11] = 0x03
    out[12] = 0x04
    out[13] = 0x02
    out[14] = oid
    out[15] = 0x05
    out[16] = 0x00
    out[17] = 0x04
    out[18] = hash_len
    return 19

pub fn get_sha256_digest_info_prefix(out: *u8) -> i32
    return sha2_digest_info_prefix(256, out)

pub fn get_sha384_digest_info_prefix(out: *u8) -> i32
    return sha2_digest_info_prefix(384, out)

pub fn get_sha512_digest_info_prefix(out: *u8) -> i32
    return sha2_digest_info_prefix(512, out)

# Verify a PKCS#1 v1.5 signature over a pre-computed SHA-2 `bits` hash.
# Returns 1 if valid, 0 if invalid.
pub fn rsa_verify_pkcs1_sha2_hash(key: *RsaPublicKey, bits: i32, hash: *u8, sig: *u8, sig_len: i32) -> i32
    var prefix: [19]u8
    let prefix_len: i32 = sha2_digest_info_prefix(bits, @prefix[0])
    return rsa_verify_pkcs1(key, hash, bits / 8, @prefix[0], prefix_len, sig, sig_len)

# Verify a PKCS#1 v1.5 SHA-2 `bits` signature over a message.
# Returns 1 if valid, 0 if invalid.
pub fn rsa_verify_pkcs1_sha2(key: *RsaPublicKey, bits: i32, msg: *u8, msg_len: i64, sig: *u8, sig_len: i32) -> i32
    var hash: [64]u8
    if bits == 256
        sha256(msg, msg_len, @hash[0])
    else if bits == 384
        sha384(msg, msg_len, @hash[0])
    else
        sha512(msg, msg_len, @hash[0])
    return rsa_verify_pkcs1_sha2_hash(key, bits, @hash[0], sig, sig_len)

# Verify RSA-SHA256 signature (PKCS#1 v1.5)
pub fn rsa_verify_pkcs1_sha256(key: *RsaPublicKey, msg: *u8, msg_len: i64, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2(key, 256, msg, msg_len, sig, sig_len)

# Verify RSA-SHA256 signature with pre-computed hash
pub fn rsa_verify_pkcs1_sha256_hash(key: *RsaPublicKey, hash: *u8, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2_hash(key, 256, hash, sig, sig_len)

pub fn rsa_verify_pkcs1_sha384(key: *RsaPublicKey, msg: *u8, msg_len: i64, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2(key, 384, msg, msg_len, sig, sig_len)

pub fn rsa_verify_pkcs1_sha384_hash(key: *RsaPublicKey, hash: *u8, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2_hash(key, 384, hash, sig, sig_len)

pub fn rsa_verify_pkcs1_sha512(key: *RsaPublicKey, msg: *u8, msg_len: i64, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2(key, 512, msg, msg_len, sig, sig_len)

pub fn rsa_verify_pkcs1_sha512_hash(key: *RsaPublicKey, hash: *u8, sig: *u8, sig_len: i32) -> i32
    return rsa_verify_pkcs1_sha2_hash(key, 512, hash, sig, sig_len)

# ============================================================================
# RSASSA-PSS Signature Verification (RFC 8017 §8.1.2, §9.1.2)
# ============================================================================
#
# Only the parameter set TLS 1.3 uses for rsa_pss_rsae_sha256 (RFC 8446
# §4.2.3) is supported: Hash = SHA-256, MGF = MGF1-SHA-256, sLen = hLen = 32.
# A signature made with any other hash, MGF or salt length is rejected.

const PSS_SHA256_HLEN: i32 = 32
const PSS_SHA256_SLEN: i32 = 32

# Bit length of the modulus (key.n has no leading zero bytes).
fn rsa_modulus_bits(key: *RsaPublicKey) -> i32
    if key.n_len <= 0
        return 0
    var top: u8 = key.n[0]
    var bits: i32 = 0
    while top != 0
        bits += 1
        top = top >> 1
    return (key.n_len - 1) * 8 + bits

# db[0..db_len) ^= MGF1-SHA256(seed[0..32), db_len)  (RFC 8017 §B.2.1)
fn mgf1_sha256_xor(seed: *u8, db: *u8, db_len: i32)
    var block: [36]u8
    mem_copy(@block[0], seed, 32)
    var mask: [32]u8
    var counter: u32 = 0
    var done: i32 = 0
    while done < db_len
        block[32] = (counter >> 24) as u8
        block[33] = (counter >> 16) as u8
        block[34] = (counter >> 8) as u8
        block[35] = counter as u8
        sha256(@block[0], 36, @mask[0])
        var i: i32 = 0
        while i < 32 && done < db_len
            db[done] = db[done] ^ mask[i]
            i += 1
            done += 1
        counter += 1

# EMSA-PSS-VERIFY with SHA-256 / MGF1-SHA-256 / sLen = 32 over the message
# hash `mhash` (32 bytes). Returns 1 if valid, 0 otherwise.
pub fn rsa_verify_pss_sha256_hash(key: *RsaPublicKey, mhash: *u8, sig: *u8, sig_len: i32) -> i32
    # RSASSA-PSS-VERIFY step 1: the signature is exactly k bytes
    if sig_len != key.n_len
        return 0
    if key.n_len < RSA_MIN_MODULUS_BYTES || key.n_len > RSA_MAX_MODULUS_BYTES
        return 0

    # Step 2 (RSAVP1): s < n, m = s^e mod n
    var s: BigInt
    if bigint_from_bytes(@s, sig, sig_len) != 0
        return 0
    var n: BigInt
    if bigint_from_bytes(@n, @key.n[0], key.n_len) != 0
        return 0
    if bigint_ge(@s, @n) == 1
        return 0
    var m: BigInt
    if bigint_mod_exp_u32(@m, @s, key.e, @n) != 0
        return 0
    var em_full: [512]u8
    bigint_to_bytes_fixed(@m, @em_full[0], key.n_len)

    # emBits = modBits - 1, emLen = ceil(emBits / 8). When emBits is a
    # multiple of 8, emLen = k - 1 and I2OSP(m, emLen) requires the leading
    # byte of the k-byte representation to be zero.
    let em_bits: i32 = rsa_modulus_bits(key) - 1
    let em_len: i32 = (em_bits + 7) / 8
    let em_off: i32 = key.n_len - em_len
    if em_off != 0 && em_full[0] != 0
        return 0
    let em: *u8 = @em_full[em_off]

    # EMSA-PSS-VERIFY (RFC 8017 §9.1.2)
    let hlen: i32 = PSS_SHA256_HLEN
    let slen: i32 = PSS_SHA256_SLEN
    # Step 3
    if em_len < hlen + slen + 2
        return 0
    # Step 4: trailer field
    if em[em_len - 1] != 0xbc
        return 0
    # Step 5: maskedDB || H
    let db_len: i32 = em_len - hlen - 1
    let h: *u8 = @em[db_len]
    # Step 6: the leftmost 8*emLen - emBits bits (0..7) of maskedDB must be
    # zero. Masks are computed in i32 so no shift reaches the operand width.
    let zero_bits: i32 = 8 * em_len - em_bits
    let top_mask: u8 = ((0xff00 >> zero_bits) & 0xff) as u8
    let keep_mask: u8 = (0xff >> zero_bits) as u8
    if (em[0] & top_mask) != 0
        return 0
    # Steps 7-9: DB = maskedDB ^ MGF(H), clear the leftmost bits
    var db: [512]u8
    mem_copy(@db[0], em, db_len as u64)
    mgf1_sha256_xor(h, @db[0], db_len)
    db[0] = db[0] & keep_mask
    # Step 10: DB = PS (zeros) || 0x01 || salt. Accumulate rather than exit
    # early; the verdict is the same, the timing no longer depends on where
    # the padding goes wrong.
    let ps_len: i32 = db_len - slen - 1
    var bad: u8 = 0
    var i: i32 = 0
    while i < ps_len
        bad = bad | db[i]
        i += 1
    bad = bad | (db[ps_len] ^ 0x01)
    # Steps 11-13: H' = SHA-256(0x00 * 8 || mHash || salt)
    var mprime: [72]u8
    memzero(@mprime[0], 8)
    mem_copy(@mprime[8], mhash, 32)
    mem_copy(@mprime[40], @db[db_len - slen], slen as u64)
    var hprime: [32]u8
    sha256(@mprime[0], 72, @hprime[0])
    # Step 14: H == H'
    i = 0
    while i < hlen
        bad = bad | (h[i] ^ hprime[i])
        i += 1
    if bad != 0
        return 0
    return 1

# Verify an RSASSA-PSS (SHA-256, MGF1-SHA-256, salt 32) signature over msg.
# Returns 1 if valid, 0 if invalid.
pub fn rsa_verify_pss_sha256(key: *RsaPublicKey, msg: *u8, msg_len: i64, sig: *u8, sig_len: i32) -> i32
    var mhash: [32]u8
    sha256(msg, msg_len as u64, @mhash[0])
    return rsa_verify_pss_sha256_hash(key, @mhash[0], sig, sig_len)
