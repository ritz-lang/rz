# Errors returned by cryptosec primitives
#
# Fallible cryptosec functions return `Result<T, CryptoError>`. Each variant
# names a reason a primitive refused to run; a primitive that refuses checks
# BEFORE producing output, so an Err means nothing was written.
#
# Shared across primitives on purpose (AGAST #2577; #2578 and #2584 extend it).
# Add a variant when a primitive needs a new refusal reason, not per primitive.

pub enum CryptoError
    # A stream cipher's block counter would pass its maximum (ChaCha20:
    # 0xFFFFFFFF, RFC 8439 §2.4). Wrapping would repeat the keystream.
    CounterExhausted
    # The message (or its associated data) is longer than the construction
    # allows under one key and nonce (ChaCha20-Poly1305: (2^32 - 1) * 64 bytes,
    # RFC 8439 §2.8; AES-GCM: 2^36 - 32 bytes of text, 2^61 - 1 of AAD,
    # NIST SP 800-38D §5.2.1.1).
    MessageTooLong
    # An AEAD tag did not verify. The plaintext buffer is left untouched.
    AuthenticationFailed


# Stable, human-readable name for logs and error messages.
pub fn crypto_error_name(err: CryptoError) -> *u8
    match err
        CryptoError.CounterExhausted => c"counter exhausted"
        CryptoError.MessageTooLong => c"message too long"
        CryptoError.AuthenticationFailed => c"authentication failed"
