# ChaCha20 Stream Cipher Implementation
# RFC 8439 compliant
#
# ChaCha20 is a stream cipher designed by Daniel J. Bernstein.
# It operates on 512-bit blocks and uses a 256-bit key and 96-bit nonce.

import mem
import crypto_error

# =============================================================================
# ChaCha20 Constants
# =============================================================================

# "expand 32-byte k" in ASCII (little-endian u32 words)
const SIGMA0: u32 = 0x61707865  # "expa"
const SIGMA1: u32 = 0x3320646e  # "nd 3"
const SIGMA2: u32 = 0x79622d32  # "2-by"
const SIGMA3: u32 = 0x6b206574  # "te k"

# =============================================================================
# Helper Functions
# =============================================================================

# Little-endian load
fn load32_le(src: *u8) -> u32
    (src[0] as u32) | ((src[1] as u32) << 8) | ((src[2] as u32) << 16) | ((src[3] as u32) << 24)

# Little-endian store
fn store32_le(dst: *u8, val: u32) -> void
    dst[0] = (val & 0xff) as u8
    dst[1] = ((val >> 8) & 0xff) as u8
    dst[2] = ((val >> 16) & 0xff) as u8
    dst[3] = ((val >> 24) & 0xff) as u8

# =============================================================================
# ChaCha20 Core
# =============================================================================

# Quarter round function - uses built-in .rotl() intrinsic for efficiency
fn quarter_round(state: *u32, a: i64, b: i64, c: i64, d: i64) -> void
    state[a] = state[a] + state[b]
    state[d] = (state[d] ^ state[a]).rotl(16)

    state[c] = state[c] + state[d]
    state[b] = (state[b] ^ state[c]).rotl(12)

    state[a] = state[a] + state[b]
    state[d] = (state[d] ^ state[a]).rotl(8)

    state[c] = state[c] + state[d]
    state[b] = (state[b] ^ state[c]).rotl(7)

# ChaCha20 block function - generates 64 bytes of keystream.
# Its frame holds the key and keystream, and spill slots that no mem_zero
# reaches, so it is [[noinline]]: callers run mem_burn_stack after it returns
# (chacha20_block below, or once after a loop of blocks). AGAST #2770.
[[noinline]]
fn chacha20_block_core(key: *u8, counter: u32, nonce: *u8, out: *u8) -> void
    var state: [16]u32
    var working: [16]u32

    # Initialize state
    # Constants
    state[0] = SIGMA0
    state[1] = SIGMA1
    state[2] = SIGMA2
    state[3] = SIGMA3

    # Key (8 words)
    state[4] = load32_le(@key[0])
    state[5] = load32_le(@key[4])
    state[6] = load32_le(@key[8])
    state[7] = load32_le(@key[12])
    state[8] = load32_le(@key[16])
    state[9] = load32_le(@key[20])
    state[10] = load32_le(@key[24])
    state[11] = load32_le(@key[28])

    # Counter (1 word)
    state[12] = counter

    # Nonce (3 words)
    state[13] = load32_le(@nonce[0])
    state[14] = load32_le(@nonce[4])
    state[15] = load32_le(@nonce[8])

    # Copy to working state
    var i: i64 = 0
    while i < 16
        working[i] = state[i]
        i += 1

    # 20 rounds (10 double rounds)
    i = 0
    while i < 10
        # Column rounds
        quarter_round(@working[0], 0, 4, 8, 12)
        quarter_round(@working[0], 1, 5, 9, 13)
        quarter_round(@working[0], 2, 6, 10, 14)
        quarter_round(@working[0], 3, 7, 11, 15)

        # Diagonal rounds
        quarter_round(@working[0], 0, 5, 10, 15)
        quarter_round(@working[0], 1, 6, 11, 12)
        quarter_round(@working[0], 2, 7, 8, 13)
        quarter_round(@working[0], 3, 4, 9, 14)

        i += 1

    # Add working state to original state
    i = 0
    while i < 16
        working[i] = working[i] + state[i]
        i += 1

    # Serialize to output
    i = 0
    while i < 16
        store32_le(@out[i * 4], working[i])
        i += 1

    # state[4..11] is the key and working is now the keystream: neither may
    # outlive the call (AGAST #2770). mem_zero's barrier keeps these stores.
    mem_zero(@state[0] as *u8, 64)
    mem_zero(@working[0] as *u8, 64)

pub fn chacha20_block(key: *u8, counter: u32, nonce: *u8, out: *u8) -> void
    chacha20_block_core(key, counter, nonce, out)
    mem_burn_stack()

# =============================================================================
# ChaCha20 Context and API
# =============================================================================

# ChaCha20's block counter is 32 bits (RFC 8439 §2.4) and must never wrap:
# 0xFFFFFFFF is the last block a key/nonce pair can produce.
const CHACHA20_COUNTER_LIMIT: u64 = 0x100000000  # number of usable blocks

struct ChaCha20
    key: [32]u8
    nonce: [12]u8
    # Next block to generate. u64 so that "all 2^32 blocks used" is
    # representable (== CHACHA20_COUNTER_LIMIT) instead of wrapping to 0.
    counter: u64

pub fn chacha20_init(ctx: *ChaCha20, key: *u8, nonce: *u8) -> void
    mem_copy(@ctx.key[0], key, 32)
    mem_copy(@ctx.nonce[0], nonce, 12)
    ctx.counter = 0

pub fn chacha20_set_counter(ctx: *ChaCha20, counter: u32) -> void
    ctx.counter = counter as u64

# Can `len` bytes be produced starting at block `counter` without the block
# counter passing 0xFFFFFFFF? Shared with the AVX2 implementation.
pub fn chacha20_counter_room(counter: u64, len: i64) -> bool
    if len <= 0
        return true
    if counter >= CHACHA20_COUNTER_LIMIT
        return false
    # Ceiling division without overflowing `len + 63`.
    var blocks: u64 = (len / 64) as u64
    if len % 64 != 0
        blocks += 1
    blocks <= CHACHA20_COUNTER_LIMIT - counter

# XOR `len` bytes of keystream from block `counter` onwards into output.
# The caller has already checked chacha20_counter_room, so `counter` plus the
# blocks used stays within 32 bits.
fn chacha20_keystream_xor(key: *u8, nonce: *u8, counter: u64, input: *u8, len: i64, output: *u8) -> void
    var block: [64]u8
    var ctr: u64 = counter
    var i: i64 = 0

    while i < len
        chacha20_block_core(key, ctr as u32, nonce, @block[0])
        ctr += 1

        var j: i64 = 0
        while j < 64 && (i + j) < len
            output[i + j] = input[i + j] ^ block[j]
            j += 1

        i = i + 64
    mem_zero(@block[0], 64)
    # One burn for the loop: every block_core frame sat at the same depth.
    mem_burn_stack()

# Encrypt pt_len bytes, advancing the context's counter.
# Err(CounterExhausted) if that would take the counter past 0xFFFFFFFF; then
# nothing is written and the counter is unchanged.
pub fn chacha20_encrypt(ctx: *ChaCha20, pt: *u8, pt_len: i64, ct: *u8) -> Result<i64, CryptoError>
    if not chacha20_counter_room(ctx.counter, pt_len)
        return Err(CryptoError.CounterExhausted)
    if pt_len <= 0
        return Ok(0)
    chacha20_keystream_xor(@ctx.key[0], @ctx.nonce[0], ctx.counter, pt, pt_len, ct)
    ctx.counter = ctx.counter + ((pt_len + 63) / 64) as u64
    Ok(pt_len)

# Decrypt is same as encrypt for stream ciphers
pub fn chacha20_decrypt(ctx: *ChaCha20, ct: *u8, ct_len: i64, pt: *u8) -> Result<i64, CryptoError>
    chacha20_encrypt(ctx, ct, ct_len, pt)

# =============================================================================
# Single-shot API (for AEAD use)
# =============================================================================

# XOR `len` bytes with the keystream starting at block `counter`.
# Err(CounterExhausted) if the blocks needed would take the counter past
# 0xFFFFFFFF; then nothing is written. The block at 0xFFFFFFFF is allowed.
pub fn chacha20_xor(key: *u8, nonce: *u8, counter: u32, input: *u8, len: i64, output: *u8) -> Result<i64, CryptoError>
    if not chacha20_counter_room(counter as u64, len)
        return Err(CryptoError.CounterExhausted)
    if len <= 0
        return Ok(0)
    chacha20_keystream_xor(key, nonce, counter as u64, input, len, output)
    Ok(len)
