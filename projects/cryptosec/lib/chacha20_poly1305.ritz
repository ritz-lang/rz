# ChaCha20-Poly1305 AEAD Implementation
# RFC 8439 compliant
#
# ChaCha20-Poly1305 is an Authenticated Encryption with Associated Data (AEAD)
# construction combining ChaCha20 stream cipher with Poly1305 MAC.

import chacha20
import poly1305
import mem
import crypto_error

# =============================================================================
# Helper Functions
# =============================================================================

# Pad to 16-byte boundary for Poly1305
fn pad16_len(len: i64) -> i64
    let rem: i64 = len % 16
    if rem == 0
        0
    else
        16 - rem

# Store 64-bit little-endian
fn store64_le(dst: *u8, val: u64) -> void
    dst[0] = (val & 0xff) as u8
    dst[1] = ((val >> 8) & 0xff) as u8
    dst[2] = ((val >> 16) & 0xff) as u8
    dst[3] = ((val >> 24) & 0xff) as u8
    dst[4] = ((val >> 32) & 0xff) as u8
    dst[5] = ((val >> 40) & 0xff) as u8
    dst[6] = ((val >> 48) & 0xff) as u8
    dst[7] = ((val >> 56) & 0xff) as u8

# =============================================================================
# ChaCha20-Poly1305 AEAD
# =============================================================================

# AEAD construction as per RFC 8439 Section 2.8:
# 1. Generate Poly1305 key from ChaCha20 block with counter=0
# 2. Encrypt plaintext with ChaCha20 starting at counter=1
# 3. Construct Poly1305 input: AAD || pad(AAD) || ciphertext || pad(ciphertext) || len(AAD) || len(ciphertext)
# 4. Compute Poly1305 tag

# Longest message one key/nonce can carry: the payload starts at block counter
# 1, and the counter must not pass 0xFFFFFFFF (RFC 8439 §2.8), so
# 2^32 - 1 blocks of 64 bytes.
pub const CHACHA20_POLY1305_MAX_LEN: i64 = 0xFFFFFFFF * 64

# Poly1305 tag over AAD and ciphertext (step 3-4 above).
fn aead_compute_tag(poly_key: *u8, aad: *u8, aad_len: i64, ct: *u8, ct_len: i64, tag: *u8) -> void
    var poly_ctx: Poly1305
    poly1305_init(@poly_ctx, poly_key)

    var zeros: [16]u8
    mem_zero(@zeros[0], 16)

    # AAD, padded to a 16-byte boundary
    if aad_len > 0
        poly1305_update(@poly_ctx, aad, aad_len)
    var pad_aad: i64 = pad16_len(aad_len)
    if pad_aad > 0
        poly1305_update(@poly_ctx, @zeros[0], pad_aad)

    # Ciphertext, padded to a 16-byte boundary
    if ct_len > 0
        poly1305_update(@poly_ctx, ct, ct_len)
    var pad_ct: i64 = pad16_len(ct_len)
    if pad_ct > 0
        poly1305_update(@poly_ctx, @zeros[0], pad_ct)

    # Lengths as 64-bit little-endian
    var lens: [16]u8
    store64_le(@lens[0], aad_len as u64)
    store64_le(@lens[8], ct_len as u64)
    poly1305_update(@poly_ctx, @lens[0], 16)

    poly1305_final(@poly_ctx, tag)

# Encrypt pt into ct and write the 16-byte tag. Ok = ciphertext length.
# Err(MessageTooLong) if pt_len > CHACHA20_POLY1305_MAX_LEN; then nothing is
# read or written.
pub fn chacha20_poly1305_encrypt(key: *u8, nonce: *u8, aad: *u8, aad_len: i64, pt: *u8, pt_len: i64, ct: *u8, tag: *u8) -> Result<i64, CryptoError>
    if pt_len > CHACHA20_POLY1305_MAX_LEN
        return Err(CryptoError.MessageTooLong)

    # Encrypt plaintext starting at counter=1. This is the one fallible step;
    # it runs before the Poly1305 key exists, so no early return can leave
    # the key unwiped (AGAST #2581).
    let n: i64 = chacha20_xor(key, nonce, 1, pt, pt_len, ct)?

    # Poly1305 one-time key: first 32 bytes of ChaCha20 block 0
    var poly_key: [64]u8
    chacha20_block(key, 0, nonce, @poly_key[0])

    aead_compute_tag(@poly_key[0], aad, aad_len, ct, n, tag)
    mem_zero(@poly_key[0], 64)
    Ok(n)

# Verify the tag, then decrypt ct into pt. Ok = plaintext length.
# Err(MessageTooLong) if ct_len > CHACHA20_POLY1305_MAX_LEN (nothing is read
# or written); Err(AuthenticationFailed) if the tag does not verify (pt is
# left untouched).
pub fn chacha20_poly1305_decrypt(key: *u8, nonce: *u8, aad: *u8, aad_len: i64, ct: *u8, ct_len: i64, tag: *u8, pt: *u8) -> Result<i64, CryptoError>
    if ct_len > CHACHA20_POLY1305_MAX_LEN
        return Err(CryptoError.MessageTooLong)

    var poly_key: [64]u8
    chacha20_block(key, 0, nonce, @poly_key[0])

    # Verify tag first
    var computed_tag: [16]u8
    var len: i64 = ct_len
    if len < 0
        len = 0
    aead_compute_tag(@poly_key[0], aad, aad_len, ct, len, @computed_tag[0])
    mem_zero(@poly_key[0], 64)

    # Constant-time tag comparison. computed_tag is the valid tag for the
    # caller's (aad, ct): wipe it before either return, or a stack disclosure
    # turns a rejected forgery into an accepted one (AGAST #2771).
    let tag_ok: i32 = mem_eq(@computed_tag[0], tag, 16)
    mem_zero(@computed_tag[0], 16)
    if tag_ok == 0
        return Err(CryptoError.AuthenticationFailed)

    # Decrypt ciphertext
    let n: i64 = chacha20_xor(key, nonce, 1, ct, len, pt)?
    Ok(n)
