# lib/random.ritz - Cryptographically Secure Pseudo-Random Number Generator
#
# Provides secure random number generation using Linux's getrandom syscall.
# This is the recommended way to get cryptographic random bytes since Linux 3.17.
#
# Operations:
# - getrandom(buf, len, flags) - Raw syscall wrapper
# - random_bytes(buf, len) - Fill buffer with random bytes (blocking)
# - random_u64() / random_u32() - Random value; abort on RNG failure
# - random_u64_checked / random_u32_checked - Random value; -1 on RNG failure

import ritzlib.sys

# ============================================================================
# getrandom syscall (Linux 3.17+)
# ============================================================================

# Syscall number for getrandom on x86-64
const SYS_GETRANDOM: i64 = 318

# getrandom flags
const GRND_NONBLOCK: i32 = 1    # Don't block waiting for entropy
const GRND_RANDOM: i32 = 2       # Use /dev/random instead of /dev/urandom

# Raw getrandom syscall wrapper
# Returns number of bytes written, or negative error code
pub fn getrandom(buf: *u8, len: u64, flags: i32) -> i64
    return syscall3(SYS_GETRANDOM, buf as i64, len as i64, flags as i64)

# ============================================================================
# High-level random functions
# ============================================================================

# Test hooks (AGAST #1863): make random_bytes fail as getrandom would on a
# broken system, so callers' failure paths can be tested. They can only make
# the RNG fail, never weaken its output.
var g_random_force_failure: i32
# 0 = off; k > 0 = k - 1 more calls succeed, the next one fails (one-shot).
var g_random_fail_countdown: i32

# on != 0: every random_bytes call fails. on == 0: both hooks off.
pub fn random_test_force_failure(on: i32)
    g_random_force_failure = on
    g_random_fail_countdown = 0

# Let the next n random_bytes calls succeed and fail only the one after, so
# a caller's check on each individual call can be exercised.
pub fn random_test_fail_after(n: i32)
    g_random_fail_countdown = n + 1

# Fill buffer with cryptographically secure random bytes
# This function blocks until the CSPRNG is seeded (only on first boot)
# Returns 0 on success, -1 on error. Callers MUST check the result: a buffer
# the RNG failed to fill is not random (AGAST #1863).
pub fn random_bytes(buf: *u8, len: u64) -> i32
    if g_random_force_failure != 0
        return -1
    if g_random_fail_countdown > 0
        g_random_fail_countdown -= 1
        if g_random_fail_countdown == 0
            return -1
    if len == 0
        return 0

    var remaining: u64 = len
    var ptr: *u8 = buf

    # getrandom can return fewer bytes than requested (up to 256 bytes per call)
    # so we loop until we get all requested bytes
    while remaining > 0
        let result: i64 = getrandom(ptr, remaining, 0)
        if result == -4
            continue  # EINTR: interrupted by a signal before any bytes; retry
        if result <= 0
            return -1  # Error (0 would loop forever)
        let got: u64 = result as u64
        remaining = remaining - got
        ptr = (ptr as u64 + got) as *u8

    return 0

# The RNG failed and the caller has no way to report it: stop rather than
# hand back a predictable value. (Use the *_checked variants to handle it.)
fn random_fail_closed()
    let msg: *u8 = c"cryptosec: getrandom failed; aborting\n"
    sys_write(2, msg, 38)
    sys_exit(134)

# Get a random u64 into *out. Returns 0 on success, -1 on RNG failure
# (*out is then 0).
pub fn random_u64_checked(out: *u64) -> i32
    *out = 0
    var buf: [8]u8
    if random_bytes(@buf[0], 8) != 0
        return -1

    # Assemble from bytes (little-endian)
    let b0: u64 = buf[0] as u64
    let b1: u64 = buf[1] as u64
    let b2: u64 = buf[2] as u64
    let b3: u64 = buf[3] as u64
    let b4: u64 = buf[4] as u64
    let b5: u64 = buf[5] as u64
    let b6: u64 = buf[6] as u64
    let b7: u64 = buf[7] as u64

    let lo: u64 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    let hi: u64 = (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
    *out = lo | hi
    return 0

# Get a random u32 into *out. Returns 0 on success, -1 on RNG failure
# (*out is then 0).
pub fn random_u32_checked(out: *u32) -> i32
    *out = 0
    var buf: [4]u8
    if random_bytes(@buf[0], 4) != 0
        return -1

    # Assemble from bytes (little-endian)
    let b0: u32 = buf[0] as u32
    let b1: u32 = buf[1] as u32
    let b2: u32 = buf[2] as u32
    let b3: u32 = buf[3] as u32

    *out = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    return 0

# Get a single random u64. Aborts the process if the RNG fails: it used to
# return 0, a value callers could not tell from a random one (AGAST #1863).
pub fn random_u64() -> u64
    var v: u64 = 0
    if random_u64_checked(@v) != 0
        random_fail_closed()
    return v

# Get a single random u32. Aborts the process if the RNG fails.
pub fn random_u32() -> u32
    var v: u32 = 0
    if random_u32_checked(@v) != 0
        random_fail_closed()
    return v

# Get a random value in range [0, max) - not constant-time!
# For cryptographic use, use rejection sampling with ct_select
pub fn random_range_u64(max: u64) -> u64
    if max == 0
        return 0
    if max == 1
        return 0

    # Simple modulo (has slight bias for non-power-of-2 max)
    # For production crypto, should use rejection sampling
    return random_u64() % max
