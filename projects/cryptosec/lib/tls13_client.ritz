# lib/tls13_client.ritz - TLS 1.3 Client Implementation
#
# This module provides a complete TLS 1.3 client implementation for use with
# Valet and other networking applications.
#
# Features:
# - Full TLS 1.3 handshake (1-RTT). The middlebox-compat change_cipher_spec
#   is dropped; a HelloRetryRequest is answered with a second ClientHello.
# - X25519 key exchange; secp256r1 when a HelloRetryRequest asks for it
# - AES-128-GCM and ChaCha20-Poly1305 cipher suites
# - AES-128-GCM only (the record layer implements nothing else)
# - Server authentication, fail closed. One trust anchor must be configured:
#     * pin (tls_config_pin_cert): the leaf must byte-equal a pinned DER cert;
#     * or a CA store (tls_config_set_ca_store): the chain must lead from the
#       leaf, through CA certificates the server sent, to a CA in the store,
#       with every signature (RSA-PKCS1, ECDSA P-256/P-384 SHA-256/384,
#       Ed25519)
#       verified and every certificate valid at the current time.
#     A client with neither refuses every server. A pin takes precedence.
#     * hostname: the leaf must match the configured hostname (SAN dNSName,
#       or the CN when the certificate has no SAN)
#     * CertificateVerify: the signature over the transcript must verify
#       under the leaf's key (ecdsa_secp256r1_sha256,
#       ecdsa_secp384r1_sha384 or ed25519)
#   There is no "skip verification" mode.
#
# Non-blocking API for io_uring integration:
# - tls_client_handshake_step() processes data incrementally
# - Returns status indicating need for more input, output ready, or completion

import ritzlib.sys

import mem
import random
import sha256
import hmac
import hkdf
import aes_gcm
import chacha20_poly1305
import x25519
import p256
import x509
import x509_verify
import ca_store
import rsa
import tls13_kdf
import tls13_record
import tls13_handshake

# ============================================================================
# Constants
# ============================================================================

# Connection states
pub const TLS_STATE_INIT: i32 = 0
pub const TLS_STATE_CLIENT_HELLO_SENT: i32 = 1
pub const TLS_STATE_SERVER_HELLO_RECEIVED: i32 = 2
pub const TLS_STATE_ENCRYPTED_EXTENSIONS_RECEIVED: i32 = 3
pub const TLS_STATE_CERTIFICATE_RECEIVED: i32 = 4
pub const TLS_STATE_CERTIFICATE_VERIFY_RECEIVED: i32 = 5
pub const TLS_STATE_FINISHED_RECEIVED: i32 = 6
pub const TLS_STATE_CONNECTED: i32 = 7
pub const TLS_STATE_CLOSING: i32 = 8
pub const TLS_STATE_CLOSED: i32 = 9
pub const TLS_STATE_ERROR: i32 = -1

# Handshake step results (TLS_RESULT_*) and error codes (TLS_ERR_*) live in
# tls13_record, shared with valet's server so the two can be linked together.

# Maximum sizes
const MAX_RECORD_SIZE: i64 = 16384          # TLSPlaintext.fragment, 2^14
const MAX_CIPHERTEXT_SIZE: i64 = 16640      # TLSCiphertext.fragment, 2^14 + 256
const RECV_BUF_SIZE: i64 = 16645            # one whole record, header included
const MAX_HANDSHAKE_SIZE: i64 = 65536       # reassembled handshake bytes

const CLIENT_SYS_CLOCK_GETTIME: i64 = 228
const CLIENT_CLOCK_REALTIME: i64 = 0

# ============================================================================
# TLS Client Configuration
# ============================================================================

pub struct TlsConfig
    # Hostname for SNI and certificate verification
    hostname: [256]u8
    hostname_len: i32

    # Trust anchor: DER of the one leaf certificate this client accepts.
    pinned_cert: [4096]u8
    pinned_cert_len: i64

    # Trust anchor: CA certificates (borrowed; must outlive the client).
    ca_store: *CaStore

    # Unix time to validate certificates at; 0 means the system clock.
    verify_time: i64

    # Preferred cipher suites (in order of preference)
    cipher_suites: [4]u16
    num_cipher_suites: i32

pub fn tls_config_init(cfg: *TlsConfig)
    mem_zero(cfg as *u8, sizeof(TlsConfig))

    # Only offer what tls13_record can actually encrypt.
    cfg.cipher_suites[0] = TLS_AES_128_GCM_SHA256
    cfg.num_cipher_suites = 1

pub fn tls_config_set_hostname(cfg: *TlsConfig, hostname: *u8, len: i32)
    if len > 255
        len = 255
    var i: i32 = 0
    while i < len
        cfg.hostname[i] = hostname[i]
        i += 1
    cfg.hostname_len = len

# Pin the server's leaf certificate (DER). The handshake fails unless the
# server presents exactly this certificate. Returns 0, or -1 if it is empty
# or larger than the pin buffer.
pub fn tls_config_pin_cert(cfg: *TlsConfig, der: *u8, len: i64) -> i32
    if len <= 0 || len > 4096
        return -1
    mem_copy(@cfg.pinned_cert[0], der, len as u64)
    cfg.pinned_cert_len = len
    return 0

# Trust the CAs in `store` (used only when no certificate is pinned). The
# store is borrowed, not copied. Returns 0, or -1 if it is null or empty.
pub fn tls_config_set_ca_store(cfg: *TlsConfig, store: *CaStore) -> i32
    if store == null
        return -1
    if ca_store_count(store) <= 0
        return -1
    cfg.ca_store = store
    return 0

# Validate certificate dates at `unix_time` instead of the system clock
# (0 restores the clock). For tests and for clients with a trusted time.
pub fn tls_config_set_verify_time(cfg: *TlsConfig, unix_time: i64)
    cfg.verify_time = unix_time

# ============================================================================
# TLS Client State
# ============================================================================

pub struct TlsClient
    # Connection state
    state: i32
    last_error: i32

    # Configuration
    config: TlsConfig

    # Handshake state
    transcript: Transcript
    key_schedule: TLS13KeySchedule
    client_hello: ClientHello
    server_hello: ServerHello

    # Shared secret from X25519 or secp256r1
    shared_secret: [32]u8

    # Selected cipher suite
    cipher_suite: u16

    # Record layer state
    read_state: TlsRecordState
    write_state: TlsRecordState

    # Received bytes not yet consumed: at most one whole record.
    recv_buf: [16645]u8
    recv_len: i64
    recv_expected: i64  # unused

    # Decrypted handshake bytes not yet consumed: a message may span records
    # and a record may hold several messages.
    hs_buf: [65536]u8
    hs_len: i64

    # Output buffer for handshake messages to send
    send_buf: [4096]u8
    send_len: i64

    # Certificate chain from server
    server_certs: CertificateMessage

    # Server's public key (extracted from certificate)
    server_pubkey: X509PublicKey

    # Flags
    handshake_complete: i32
    encrypted_handshake: i32  # 1 after ServerHello, messages are encrypted
    ccs_received: i32         # 1 once the middlebox-compat CCS was dropped
    hrr_received: i32         # 1 once a HelloRetryRequest was answered
    hrr_cipher_suite: u16     # the suite it selected

# ============================================================================
# Client Lifecycle
# ============================================================================

# Initialize a new TLS client
# Returns 0 on success, -1 if the RNG failed (the client must not be used).
pub fn tls_client_init(client: *TlsClient, config: *TlsConfig) -> i32
    # Zero everything
    mem_zero(client as *u8, sizeof(TlsClient))

    # Copy config
    mem_copy(@client.config as *u8, config as *u8, sizeof(TlsConfig))

    # Initialize transcript
    transcript_init(@client.transcript)

    # Initialize key schedule
    tls13_key_schedule_init(@client.key_schedule)

    # Initialize ClientHello; RNG failure fails the handshake (AGAST #1863)
    if client_hello_init(@client.client_hello) != 0
        return -1

    # Set hostname from config
    if config.hostname_len > 0
        client_hello_set_hostname(@client.client_hello, @config.hostname[0], config.hostname_len)

    # Set cipher suites from config
    var i: i32 = 0
    while i < config.num_cipher_suites && i < 4
        client.client_hello.cipher_suites[i] = config.cipher_suites[i]
        i += 1
    client.client_hello.num_cipher_suites = config.num_cipher_suites

    client.state = TLS_STATE_INIT
    return 0

# Free client resources
pub fn tls_client_free(client: *TlsClient)
    # Zero sensitive data
    mem_zero(@client.shared_secret[0], sizeof(client.shared_secret))
    mem_zero(@client.key_schedule as *u8, sizeof(TLS13KeySchedule))
    mem_zero(@client.client_hello.x25519_private[0], sizeof(client.client_hello.x25519_private))
    mem_zero(@client.client_hello.p256_private[0], sizeof(client.client_hello.p256_private))

# ============================================================================
# Start Handshake - Generate ClientHello
# ============================================================================

# Start the handshake by generating ClientHello
# Returns bytes written to out, or negative on error
pub fn tls_client_start(client: *TlsClient, out: *u8, out_cap: i64) -> i64
    if client.state != TLS_STATE_INIT
        client.last_error = TLS_ERR_INVALID_STATE
        return -1

    let len: i64 = client_write_hello(client, out, out_cap)
    if len < 0
        return -1

    client.state = TLS_STATE_CLIENT_HELLO_SENT
    return len

# Serialize client_hello into a record in `out` and add it to the transcript.
# Returns the record's length, or -1 with last_error set.
fn client_write_hello(client: *TlsClient, out: *u8, out_cap: i64) -> i64
    # Serialize ClientHello
    let ch_len: i64 = client_hello_serialize(@client.client_hello, @client.send_buf[0], 4096)
    if ch_len < 0
        client.last_error = TLS_ERR_PARSE_ERROR
        return -1

    # Wrap in TLS record header
    # ContentType (1) + Version (2) + Length (2) + data
    if out_cap < ch_len + 5
        client.last_error = TLS_ERR_BUFFER_TOO_SMALL
        return -1

    # Update transcript with ClientHello
    transcript_update(@client.transcript, @client.send_buf[0], ch_len)

    out[0] = 22  # Handshake content type
    out[1] = 0x03
    # Legacy version: TLS 1.0 is allowed for the initial ClientHello only
    # (RFC 8446 5.1); one sent after a HelloRetryRequest must say TLS 1.2.
    out[2] = 0x01
    if client.hrr_received != 0
        out[2] = 0x03
    out[3] = ((ch_len >> 8) & 0xff) as u8
    out[4] = (ch_len & 0xff) as u8
    mem_copy(out + 5, @client.send_buf[0], ch_len as u64)

    return ch_len + 5

# ============================================================================
# Process Incoming Data
# ============================================================================

# Process incoming data from server
# Returns: TLS_RESULT_NEED_INPUT, TLS_RESULT_HAVE_OUTPUT, TLS_RESULT_COMPLETE, or TLS_RESULT_ERROR
#
# If result is HAVE_OUTPUT, caller should send data from out buffer
# If result is COMPLETE, handshake finished successfully
# If result is NEED_INPUT, caller should receive more data and call again
pub fn tls_client_process(client: *TlsClient, data: *u8, data_len: i64, out: *u8, out_cap: i64, out_len: *i64) -> i32
    *out_len = 0

    if client.state == TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    if client.state == TLS_STATE_CONNECTED
        return TLS_RESULT_COMPLETE

    # Feed the input through recv_buf, which holds one record at a time.
    var off: i64 = 0
    loop
        if off < data_len
            var take: i64 = data_len - off
            let room: i64 = RECV_BUF_SIZE - client.recv_len
            if take > room
                take = room
            if take > 0
                mem_copy(@client.recv_buf[client.recv_len], data + off, take as u64)
                client.recv_len = client.recv_len + take
                off = off + take
        let r: i32 = client_step(client, out, out_cap, out_len)
        # Only a change_cipher_spec can follow a HelloRetryRequest until the
        # server has our second ClientHello: more input than recv_buf took is
        # not that, and returning output here would lose it.
        if r == TLS_RESULT_HAVE_OUTPUT && client.state == TLS_STATE_CLIENT_HELLO_SENT && off < data_len
            *out_len = 0
            return client_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)
        if r != TLS_RESULT_NEED_INPUT
            return r
        if off >= data_len
            return TLS_RESULT_NEED_INPUT
        if client.recv_len >= RECV_BUF_SIZE
            # Cannot happen: a full buffer always holds a whole record.
            client.last_error = TLS_ERR_BUFFER_TOO_SMALL
            client.state = TLS_STATE_ERROR
            return TLS_RESULT_ERROR
    return TLS_RESULT_NEED_INPUT

# 1 if recv_buf starts with a whole record, 0 if more input is needed, -1 if
# the record header announces more than TLS 1.3 allows (client is failed).
fn client_record_ready(client: *TlsClient) -> i32
    if client.recv_len < 5
        return 0
    let record_len: i64 = ((client.recv_buf[3] as i64) << 8) | (client.recv_buf[4] as i64)
    if record_len > MAX_CIPHERTEXT_SIZE
        client.last_error = TLS_ERR_RECORD_OVERFLOW
        client.state = TLS_STATE_ERROR
        return -1
    if client.recv_len < 5 + record_len
        return 0
    return 1

# Process every whole record in recv_buf, one at a time.
fn client_step(client: *TlsClient, out: *u8, out_cap: i64, out_len: *i64) -> i32
    loop
        if client.state == TLS_STATE_FINISHED_RECEIVED
            return finish_handshake(client, out, out_cap, out_len)
        let ready: i32 = client_record_ready(client)
        if ready < 0
            return TLS_RESULT_ERROR
        if ready == 0
            return TLS_RESULT_NEED_INPUT
        var r: i32 = TLS_RESULT_ERROR
        if client.recv_buf[0] == TLS_CONTENT_CHANGE_CIPHER_SPEC
            r = process_change_cipher_spec(client)
        else if client.state == TLS_STATE_CLIENT_HELLO_SENT
            r = process_server_hello(client, out, out_cap, out_len)
        else if client.state >= TLS_STATE_SERVER_HELLO_RECEIVED && client.state <= TLS_STATE_CERTIFICATE_VERIFY_RECEIVED
            r = process_encrypted_handshake(client, out, out_cap, out_len)
        else
            client.last_error = TLS_ERR_INVALID_STATE
            client.state = TLS_STATE_ERROR
            return TLS_RESULT_ERROR
        if r != TLS_RESULT_NEED_INPUT
            return r
    return TLS_RESULT_NEED_INPUT

# ============================================================================
# Middlebox-compatibility change_cipher_spec (RFC 8446 5, D.4)
# ============================================================================

# Drop the one unencrypted change_cipher_spec record (body 0x01) a server may
# send after its first hello, ServerHello or HelloRetryRequest (D.4), and
# before its Finished. Anything else is unexpected_message: a CCS before that
# first hello, a second one, any other length or body, or one that splits a
# handshake message across records (handshake messages must not be
# interleaved with other record types, 5.1).
# recv_buf holds the whole record (client_record_ready).
fn process_change_cipher_spec(client: *TlsClient) -> i32
    let record_len: i64 = ((client.recv_buf[3] as i64) << 8) | (client.recv_buf[4] as i64)
    var ok: i32 = 1
    if client.state < TLS_STATE_SERVER_HELLO_RECEIVED || client.state > TLS_STATE_CERTIFICATE_VERIFY_RECEIVED
        if client.state != TLS_STATE_CLIENT_HELLO_SENT || client.hrr_received == 0
            ok = 0
    if client.ccs_received != 0 || client.hs_len != 0
        ok = 0
    if record_len != 1 || client.recv_buf[5] != 0x01
        ok = 0
    if ok == 0
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR
    client.ccs_received = 1
    client_shift_recv_buf(client, 6)
    return TLS_RESULT_NEED_INPUT

# ============================================================================
# Process ServerHello
# ============================================================================

fn process_server_hello(client: *TlsClient, out: *u8, out_cap: i64, out_len: *i64) -> i32
    # Need at least TLS record header (5 bytes)
    if client.recv_len < 5
        return TLS_RESULT_NEED_INPUT

    # Parse TLS record header
    let content_type: u8 = client.recv_buf[0]
    let record_len: i64 = ((client.recv_buf[3] as i64) << 8) | (client.recv_buf[4] as i64)

    # Check we have complete record
    if client.recv_len < 5 + record_len
        return TLS_RESULT_NEED_INPUT

    # Expect Handshake content type
    if content_type != 22
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Parse handshake header
    var hdr: HandshakeHeader
    if handshake_header_parse(@client.recv_buf[5], record_len, @hdr) != 0
        client.last_error = TLS_ERR_PARSE_ERROR
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    if hdr.msg_type != HS_SERVER_HELLO
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # A HelloRetryRequest wants another key share or a cookie, not keys.
    if server_hello_is_retry_request(@client.recv_buf[9], hdr.length) == 1
        return process_hello_retry_request(client, hdr.length, record_len, out, out_cap, out_len)

    # Parse ServerHello
    let sh_result: i32 = server_hello_parse(@client.recv_buf[9], hdr.length, @client.server_hello)
    if sh_result != 0
        client.last_error = TLS_ERR_PARSE_ERROR
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Verify TLS 1.3
    if client.server_hello.negotiated_version != TLS_VERSION_13
        client.last_error = TLS_ERR_VERSION_MISMATCH
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Verify we got key share
    if client.server_hello.has_key_share != 1
        client.last_error = TLS_ERR_NO_KEY_SHARE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Only a share for the group we offered can be answered. This also holds
    # the second ServerHello to the group its HelloRetryRequest selected.
    if client.server_hello.key_share_group != client.client_hello.key_share_group
        return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)

    # The second ServerHello must match its HelloRetryRequest (RFC 8446 4.1.4).
    if client.hrr_received != 0
        if client.server_hello.cipher_suite != client.hrr_cipher_suite
            return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)
        if client_session_id_echoed(client, @client.server_hello.session_id[0], client.server_hello.session_id_len) != 1
            return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)

    # The record layer only does AES-128-GCM; keys below are derived for it.
    if client.server_hello.cipher_suite != TLS_AES_128_GCM_SHA256
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Store cipher suite
    client.cipher_suite = client.server_hello.cipher_suite

    # Compute shared secret
    if client.client_hello.key_share_group == GROUP_SECP256R1
        if p256_ecdh(@client.shared_secret[0], @client.client_hello.p256_private[0], @client.server_hello.p256_public[0]) != 0
            return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)
    else
        x25519(@client.shared_secret[0], @client.client_hello.x25519_private[0], @client.server_hello.x25519_public[0])

    # Update transcript with full ServerHello (including handshake header)
    let sh_total: i64 = 4 + hdr.length
    transcript_update(@client.transcript, @client.recv_buf[5], sh_total)

    # Derive handshake keys
    var th_out: [32]u8
    transcript_hash(@client.transcript, @th_out[0])

    # Fixed lengths, so these cannot refuse today; fail closed if they do.
    match tls13_key_schedule_derive_handshake(@client.key_schedule, @client.shared_secret[0], 32, @th_out[0])
        Ok(_) => 0
        Err(_) => return client_fail(client, TLS_ERR_INVALID_STATE)
    match tls13_key_schedule_derive_handshake_keys(@client.key_schedule, 16, 12)  # AES-128-GCM
        Ok(_) => 0
        Err(_) => return client_fail(client, TLS_ERR_INVALID_STATE)

    # Set up record layer for encrypted handshake
    tls_record_state_init(@client.read_state)
    tls_record_state_set_keys(@client.read_state, @client.key_schedule.client_write_key[0], @client.key_schedule.client_write_iv[0], @client.key_schedule.server_write_key[0], @client.key_schedule.server_write_iv[0], 16)

    tls_record_state_init(@client.write_state)
    tls_record_state_set_keys(@client.write_state, @client.key_schedule.client_write_key[0], @client.key_schedule.client_write_iv[0], @client.key_schedule.server_write_key[0], @client.key_schedule.server_write_iv[0], 16)

    # Consume processed record
    let consumed: i64 = 5 + record_len
    client_shift_recv_buf(client, consumed)

    client.encrypted_handshake = 1
    client.state = TLS_STATE_SERVER_HELLO_RECEIVED

    # client_step goes on to any further records.
    return TLS_RESULT_NEED_INPUT

# ============================================================================
# Process HelloRetryRequest
# ============================================================================

# Fail the handshake with `err`.
fn client_fail(client: *TlsClient, err: i32) -> i32
    client.last_error = err
    client.state = TLS_STATE_ERROR
    return TLS_RESULT_ERROR

# 1 if `sid` is the session id our ClientHello sent, else 0.
fn client_session_id_echoed(client: *TlsClient, sid: *u8, sid_len: u8) -> i32
    if sid_len != client.client_hello.session_id_len
        return 0
    return mem_eq(sid, @client.client_hello.session_id[0], sid_len as i64)

# Answer the HelloRetryRequest at the head of recv_buf, its body `len` bytes
# in a record of `record_len`, with a second ClientHello (RFC 8446 4.1.4).
# The transcript becomes message_hash(CH1), HRR, CH2 (4.4.1).
fn process_hello_retry_request(client: *TlsClient, len: i64, record_len: i64, out: *u8, out_cap: i64, out_len: *i64) -> i32
    # One per connection, and nothing but the HRR in its record: what follows
    # one is meant for a hello we have not sent yet.
    if client.hrr_received != 0 || 4 + len != record_len
        return client_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)

    var hrr: HelloRetryRequest
    if hello_retry_request_parse(@client.recv_buf[9], len, @hrr) != 0
        return client_fail(client, TLS_ERR_PARSE_ERROR)
    if client_session_id_echoed(client, @hrr.session_id[0], hrr.session_id_len) != 1
        return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)

    # The one suite we offer, as for a ServerHello. The transcript hash is
    # SHA-256 only, so this is also what makes message_hash below correct.
    if hrr.cipher_suite != TLS_AES_128_GCM_SHA256
        return client_fail(client, TLS_ERR_ILLEGAL_PARAMETER)

    if client_hello_apply_retry(@client.client_hello, @hrr) != 0
        return client_fail(client, TLS_ERR_HELLO_RETRY_REQUEST)

    transcript_restart_for_retry(@client.transcript)
    transcript_update(@client.transcript, @client.recv_buf[5], 4 + len)

    client.hrr_received = 1
    client.hrr_cipher_suite = hrr.cipher_suite

    let hello_len: i64 = client_write_hello(client, out, out_cap)
    if hello_len < 0
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR
    *out_len = hello_len

    client_shift_recv_buf(client, 5 + record_len)
    return TLS_RESULT_HAVE_OUTPUT

# ============================================================================
# Process Encrypted Handshake Messages
# ============================================================================

fn process_encrypted_handshake(client: *TlsClient, out: *u8, out_cap: i64, out_len: *i64) -> i32
    # Need at least TLS record header
    if client.recv_len < 5
        return TLS_RESULT_NEED_INPUT

    # Parse TLS record header
    let content_type: u8 = client.recv_buf[0]
    let record_len: i64 = ((client.recv_buf[3] as i64) << 8) | (client.recv_buf[4] as i64)

    # Check we have complete record
    if client.recv_len < 5 + record_len
        return TLS_RESULT_NEED_INPUT

    # Should be Application Data (encrypted handshake)
    if content_type != 23
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Decrypt record. Its 5-byte header is the AEAD's additional data.
    var plaintext: [16640]u8
    var inner_type: u8 = 0
    let decrypt_result: i32 = tls_record_state_server_decrypt(@client.read_state, @client.recv_buf[0], (5 + record_len) as i32, @plaintext[0], 16640, @inner_type)
    if decrypt_result < 0
        client.last_error = TLS_ERR_DECRYPT_FAILED
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR
    let plaintext_len: i64 = decrypt_result as i64
    client_shift_recv_buf(client, 5 + record_len)

    if plaintext_len > MAX_RECORD_SIZE
        client.last_error = TLS_ERR_RECORD_OVERFLOW
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # Expect (non-empty) handshake content
    if inner_type != 22 || plaintext_len == 0
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    if client.hs_len + plaintext_len > MAX_HANDSHAKE_SIZE
        client.last_error = TLS_ERR_RECORD_OVERFLOW
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR
    mem_copy(@client.hs_buf[client.hs_len], @plaintext[0], plaintext_len as u64)
    client.hs_len = client.hs_len + plaintext_len

    # Process every complete handshake message reassembled so far.
    var pos: i64 = 0
    while client.hs_len - pos >= 4
        let msg_type: u8 = client.hs_buf[pos]
        let body_len: i64 = ((client.hs_buf[pos + 1] as i64) << 16) | ((client.hs_buf[pos + 2] as i64) << 8) | (client.hs_buf[pos + 3] as i64)
        if 4 + body_len > MAX_HANDSHAKE_SIZE
            client.last_error = TLS_ERR_RECORD_OVERFLOW
            client.state = TLS_STATE_ERROR
            return TLS_RESULT_ERROR
        if pos + 4 + body_len > client.hs_len
            break  # the rest arrives in later records

        if process_handshake_message(client, msg_type, @client.hs_buf[pos + 4], body_len) != 0
            client.state = TLS_STATE_ERROR
            return TLS_RESULT_ERROR

        # Update transcript with handshake message
        transcript_update(@client.transcript, @client.hs_buf[pos], 4 + body_len)
        pos = pos + 4 + body_len

        if client.state == TLS_STATE_FINISHED_RECEIVED
            break

    client_shift_hs_buf(client, pos)

    # The keys change after the server's Finished: nothing may follow it in
    # the same record (RFC 8446 5.1).
    if client.state == TLS_STATE_FINISHED_RECEIVED && client.hs_len != 0
        client.last_error = TLS_ERR_UNEXPECTED_MESSAGE
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR

    # client_step sends our Finished, or goes on to the next record.
    return TLS_RESULT_NEED_INPUT

# Fail with `err`; the caller moves the client to TLS_STATE_ERROR.
fn hs_fail(client: *TlsClient, err: i32) -> i32
    client.last_error = err
    return -1

# Current Unix time for certificate validity: the configured verify_time,
# else the system clock. <= 0 if unavailable (the caller then refuses).
fn client_verify_time(cfg: *TlsConfig) -> i64
    if cfg.verify_time != 0
        return cfg.verify_time
    var ts: [2]i64
    ts[0] = 0
    ts[1] = 0
    if syscall2(CLIENT_SYS_CLOCK_GETTIME, CLIENT_CLOCK_REALTIME, @ts[0] as i64) != 0
        return 0
    return ts[0]

# Authenticate the server's certificate (leaf = server_certs entry 0, parsed)
# against the configured trust anchor, and the leaf against the hostname.
# Returns 0 if trusted, -1 otherwise.
fn verify_server_certificate(client: *TlsClient, leaf: *X509Certificate) -> i32
    let cfg: *TlsConfig = @client.config
    if cfg.hostname_len <= 0
        return -1

    # Pinned leaf: exact bytes, then hostname.
    if cfg.pinned_cert_len > 0
        if client.server_certs.cert_lens[0] != cfg.pinned_cert_len
            return -1
        if mem_eq(client.server_certs.cert_data[0], @cfg.pinned_cert[0], cfg.pinned_cert_len as u64) != 1
            return -1
        if x509_verify_hostname(leaf, @cfg.hostname[0], cfg.hostname_len) != 1
            return -1
        return 0

    # CA store: the chain the server sent, leaf first, up to an anchor.
    if cfg.ca_store == null
        return -1  # no trust anchor at all
    let now: i64 = client_verify_time(cfg)
    if now <= 0
        return -1

    var certs: [10]X509Certificate
    var chain: [10]*X509Certificate
    chain[0] = leaf
    var n: i32 = 1
    while n < client.server_certs.num_certs && n < 10
        # A certificate we cannot parse ends the usable chain; the walk then
        # needs an anchor for what came before it.
        if x509_parse_certificate(client.server_certs.cert_data[n], client.server_certs.cert_lens[n] as u64, @certs[n]) != 0
            break
        chain[n] = @certs[n]
        n += 1

    let store: *CaStore = cfg.ca_store
    if x509_verify_server_cert(@chain[0], n, @cfg.hostname[0], cfg.hostname_len, now, ca_store_as_array(store), ca_store_count(store)) != 1
        return -1
    return 0

# Messages must arrive EncryptedExtensions -> Certificate -> CertificateVerify
# -> Finished; anything else (including skipping Certificate) is an error.
fn process_handshake_message(client: *TlsClient, msg_type: u8, data: *u8, len: i64) -> i32
    if msg_type == HS_ENCRYPTED_EXTENSIONS
        if client.state != TLS_STATE_SERVER_HELLO_RECEIVED
            return hs_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)
        var ee: EncryptedExtensions
        if encrypted_extensions_parse(data, len, @ee) != 0
            return hs_fail(client, TLS_ERR_PARSE_ERROR)
        client.state = TLS_STATE_ENCRYPTED_EXTENSIONS_RECEIVED
        return 0

    if msg_type == HS_CERTIFICATE
        if client.state != TLS_STATE_ENCRYPTED_EXTENSIONS_RECEIVED
            return hs_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)
        if certificate_parse(data, len, @client.server_certs) != 0
            return hs_fail(client, TLS_ERR_PARSE_ERROR)

        var cert: X509Certificate
        if x509_parse_certificate(client.server_certs.cert_data[0], client.server_certs.cert_lens[0] as u64, @cert) != 0
            return hs_fail(client, TLS_ERR_CERTIFICATE_INVALID)
        if verify_server_certificate(client, @cert) != 0
            return hs_fail(client, TLS_ERR_CERTIFICATE_INVALID)

        mem_copy(@client.server_pubkey as *u8, @cert.public_key as *u8, sizeof(X509PublicKey))
        client.state = TLS_STATE_CERTIFICATE_RECEIVED
        return 0

    if msg_type == HS_CERTIFICATE_VERIFY
        if client.state != TLS_STATE_CERTIFICATE_RECEIVED
            return hs_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)
        var cv: CertificateVerify
        if certificate_verify_parse(data, len, @cv) != 0
            return hs_fail(client, TLS_ERR_PARSE_ERROR)

        # The transcript does not include this CertificateVerify yet: the
        # caller appends each message after it is processed.
        var th: [32]u8
        transcript_hash(@client.transcript, @th[0])
        if certificate_verify_verify(@cv, @th[0], @client.server_pubkey) != 0
            return hs_fail(client, TLS_ERR_VERIFY_FAILED)

        client.state = TLS_STATE_CERTIFICATE_VERIFY_RECEIVED
        return 0

    if msg_type == HS_FINISHED
        if client.state != TLS_STATE_CERTIFICATE_VERIFY_RECEIVED
            return hs_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)
        if len != 32
            return hs_fail(client, TLS_ERR_PARSE_ERROR)
        # Transcript up to (not including) Finished.
        var expected_transcript: [32]u8
        transcript_hash(@client.transcript, @expected_transcript[0])
        if finished_verify(@client.key_schedule.server_handshake_traffic_secret[0], @expected_transcript[0], data) != 1
            return hs_fail(client, TLS_ERR_FINISHED_MISMATCH)
        client.state = TLS_STATE_FINISHED_RECEIVED
        return 0

    # CertificateRequest (client auth) and anything else are unsupported.
    return hs_fail(client, TLS_ERR_UNEXPECTED_MESSAGE)

# ============================================================================
# Finish Handshake - Send Client Finished
# ============================================================================

fn finish_handshake(client: *TlsClient, out: *u8, out_cap: i64, out_len: *i64) -> i32
    # Compute client Finished
    var th_out: [32]u8
    transcript_hash(@client.transcript, @th_out[0])

    var verify_data: [32]u8
    finished_compute(@client.key_schedule.client_handshake_traffic_secret[0], @th_out[0], @verify_data[0])

    # Serialize Finished message
    var finished_msg: [64]u8
    let finished_len: i64 = finished_serialize(@verify_data[0], @finished_msg[0])

    # Encrypt with handshake keys. tls13_record_encrypt emits the complete
    # record, header included.
    let record_len: i32 = tls_record_state_client_encrypt(@client.write_state, @finished_msg[0], finished_len as i32, 22, out, client_record_cap(out_cap))
    if record_len < 0
        client.last_error = TLS_ERR_BUFFER_TOO_SMALL
        client.state = TLS_STATE_ERROR
        return TLS_RESULT_ERROR
    *out_len = record_len as i64

    # Update transcript with client Finished
    transcript_update(@client.transcript, @finished_msg[0], finished_len)

    # Derive application keys. RFC 8446 7.1: these hash the transcript through
    # the server Finished, which is th_out, not the client Finished above.
    match tls13_key_schedule_derive_application(@client.key_schedule, @th_out[0])
        Ok(_) => 0
        Err(_) => return client_fail(client, TLS_ERR_INVALID_STATE)
    match tls13_key_schedule_derive_application_keys(@client.key_schedule, 16, 12)
        Ok(_) => 0
        Err(_) => return client_fail(client, TLS_ERR_INVALID_STATE)

    # Update record layer with application keys
    tls_record_state_set_keys(@client.read_state, @client.key_schedule.client_write_key[0], @client.key_schedule.client_write_iv[0], @client.key_schedule.server_write_key[0], @client.key_schedule.server_write_iv[0], 16)
    client.read_state.client_seq = 0
    client.read_state.server_seq = 0

    tls_record_state_set_keys(@client.write_state, @client.key_schedule.client_write_key[0], @client.key_schedule.client_write_iv[0], @client.key_schedule.server_write_key[0], @client.key_schedule.server_write_iv[0], 16)
    client.write_state.client_seq = 0
    client.write_state.server_seq = 0

    client.handshake_complete = 1
    client.state = TLS_STATE_CONNECTED

    return TLS_RESULT_HAVE_OUTPUT

# ============================================================================
# Application Data
# ============================================================================

# Encrypt and send application data
# Returns bytes written to out, or negative on error
pub fn tls_client_write(client: *TlsClient, data: *u8, data_len: i64, out: *u8, out_cap: i64) -> i64
    if client.state != TLS_STATE_CONNECTED
        return -1

    if data_len < 0 || data_len > MAX_RECORD_SIZE
        return -1

    # Encrypt straight into `out`: the result is the complete record.
    let result: i32 = tls_record_state_client_encrypt(@client.write_state, data, data_len as i32, 23, out, client_record_cap(out_cap))
    if result < 0
        return -1
    return result as i64

# Decrypt received application data
# Returns bytes written to out, or negative on error
pub fn tls_client_read(client: *TlsClient, data: *u8, data_len: i64, out: *u8, out_cap: i64) -> i64
    if client.state != TLS_STATE_CONNECTED
        return -1

    # Need at least record header
    if data_len < 5
        return 0  # Need more data

    let content_type: u8 = data[0]
    let record_len: i64 = ((data[3] as i64) << 8) | (data[4] as i64)

    if data_len < 5 + record_len
        return 0  # Need more data

    # Should be Application Data
    if content_type != 23
        return -1

    # Decrypt
    var plaintext: [16500]u8
    var plaintext_len: i64 = 0
    var inner_type: u8 = 0

    # The whole record: its 5-byte header is the AEAD's additional data.
    let result: i32 = tls_record_state_server_decrypt(@client.read_state, data, (5 + record_len) as i32, @plaintext[0], 16500, @inner_type)
    plaintext_len = result as i64

    if result < 0
        return -1

    # Should be Application Data inside
    if inner_type != 23
        # Could be Alert or other - for now treat as error
        return -1

    if plaintext_len > out_cap
        return -1

    mem_copy(out, @plaintext[0], plaintext_len as u64)
    return plaintext_len

# ============================================================================
# Close Connection
# ============================================================================

pub fn tls_client_close(client: *TlsClient, out: *u8, out_cap: i64) -> i64
    if client.state != TLS_STATE_CONNECTED
        return 0

    # Send close_notify alert
    var alert: [2]u8
    alert[0] = 1  # Warning level
    alert[1] = 0  # close_notify

    let result: i32 = tls_record_state_client_encrypt(@client.write_state, @alert[0], 2, 21, out, client_record_cap(out_cap))
    if result < 0
        return 0

    client.state = TLS_STATE_CLOSING
    return result as i64

# ============================================================================
# Helpers
# ============================================================================

# Record-layer capacities are i32; never let an i64 cap wrap negative.
fn client_record_cap(cap: i64) -> i32
    if cap > 0x7fffffff
        return 0x7fffffff
    if cap < 0
        return 0
    return cap as i32

fn client_shift_hs_buf(client: *TlsClient, amount: i64)
    if amount <= 0
        return
    if amount >= client.hs_len
        client.hs_len = 0
        return
    var i: i64 = 0
    while i < client.hs_len - amount
        client.hs_buf[i] = client.hs_buf[i + amount]
        i += 1
    client.hs_len = client.hs_len - amount

fn client_shift_recv_buf(client: *TlsClient, amount: i64)
    if amount >= client.recv_len
        client.recv_len = 0
        return

    var i: i64 = 0
    while i < client.recv_len - amount
        client.recv_buf[i] = client.recv_buf[i + amount]
        i += 1
    client.recv_len = client.recv_len - amount

# Get current state
pub fn tls_client_state(client: *TlsClient) -> i32
    return client.state

# Get last error
pub fn tls_client_error(client: *TlsClient) -> i32
    return client.last_error

# Check if handshake is complete
pub fn tls_client_is_connected(client: *TlsClient) -> i32
    return client.handshake_complete
