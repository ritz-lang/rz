# Round constants for key expansion
const RCON: [11]u8 = [
    0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36,
]

# S-Box lookup function
fn sbox(i: u8) -> u8
    return SBOX[i as i64]

# Inverse S-Box lookup function
fn inv_sbox(i: u8) -> u8
    return INV_SBOX[i as i64]

# Round constant lookup
fn rcon(i: i32) -> u8
    return RCON[i as i64]

# ============================================================================
# AES Context Structures
# ============================================================================

# AES-128 context (11 round keys = 176 bytes)
struct Aes128
    round_keys: [176]u8

# AES-256 context (15 round keys = 240 bytes)
struct Aes256
    round_keys: [240]u8

# ============================================================================
# GF(2^8) Multiplication helpers
# ============================================================================

# Multiply by 2 in GF(2^8)
fn xtime(x: u8) -> u8
    let x32: u32 = x as u32
    let hi: u32 = (x32 >> 7) & 1
    let shifted: u32 = (x32 << 1) & 0xff
    # If high bit was 1, XOR with 0x1b
    let reduction: u32 = hi * 0x1b
    return (shifted ^ reduction) as u8

# Multiply two values in GF(2^8)
fn gf_mul(a: u8, b: u8) -> u8
    var result: u8 = 0
    var aa: u8 = a
    var bb: u8 = b
    var i: i32 = 0

    while i < 8
        if (bb & 1) != 0
            result = result ^ aa
        aa = xtime(aa)
        bb = bb >> 1
        i += 1

    return result

# ============================================================================
# Key Expansion
# ============================================================================

# AES-128 key expansion (10 rounds + initial)
pub fn aes128_init(ctx: *Aes128, key: *u8) -> void
    let rk: *u8 = @ctx.round_keys[0]

    # Copy original key as first round key
    mem_copy(rk, key, 16)

    var i: i32 = 1
    while i <= 10
        let prev: *u8 = rk + ((i - 1) * 16)
        let curr: *u8 = rk + (i * 16)

        # RotWord + SubWord + Rcon for first word
        let temp0: u8 = sbox(prev[13]) ^ rcon(i)
        let temp1: u8 = sbox(prev[14])
        let temp2: u8 = sbox(prev[15])
        let temp3: u8 = sbox(prev[12])

        curr[0] = prev[0] ^ temp0
        curr[1] = prev[1] ^ temp1
        curr[2] = prev[2] ^ temp2
        curr[3] = prev[3] ^ temp3

        # Remaining 3 words
        var j: i32 = 4
        while j < 16
            curr[j] = prev[j] ^ curr[j - 4]
            j += 1

        i += 1

# AES-256 key expansion (14 rounds + initial)
pub fn aes256_init(ctx: *Aes256, key: *u8) -> void
    let rk: *u8 = @ctx.round_keys[0]

    # Copy original key as first two round keys
    mem_copy(rk, key, 32)

    var i: i32 = 1
    while i <= 7
        let prev: *u8 = rk + ((i - 1) * 32)
        let curr: *u8 = rk + (i * 32)

        # First 4 words: RotWord + SubWord + Rcon
        let temp0: u8 = sbox(prev[29]) ^ rcon(i)
        let temp1: u8 = sbox(prev[30])
        let temp2: u8 = sbox(prev[31])
        let temp3: u8 = sbox(prev[28])

        curr[0] = prev[0] ^ temp0
        curr[1] = prev[1] ^ temp1
        curr[2] = prev[2] ^ temp2
        curr[3] = prev[3] ^ temp3

        # Remaining 3 words
        var j: i32 = 4
        while j < 16
            curr[j] = prev[j] ^ curr[j - 4]
            j += 1

        # Second 4 words: SubWord only (no rotation)
        if i < 7
            let sub0: u8 = sbox(curr[12])
            let sub1: u8 = sbox(curr[13])
            let sub2: u8 = sbox(curr[14])
            let sub3: u8 = sbox(curr[15])

            curr[16] = prev[16] ^ sub0
            curr[17] = prev[17] ^ sub1
            curr[18] = prev[18] ^ sub2
            curr[19] = prev[19] ^ sub3

            # Remaining 3 words of the second half
            j = 20
            while j < 32
                curr[j] = prev[j] ^ curr[j - 4]
                j += 1

        i += 1

# ============================================================================
# AES Round Functions
# ============================================================================

# MixColumns: multiply each column by the MDS matrix
fn mix_column(s0: u8, s1: u8, s2: u8, s3: u8, out: *u8) -> void
    # MixColumn matrix multiplication in GF(2^8):
    # [2 3 1 1]   [s0]
    # [1 2 3 1] * [s1]
    # [1 1 2 3]   [s2]
    # [3 1 1 2]   [s3]
    out[0] = xtime(s0) ^ xtime(s1) ^ s1 ^ s2 ^ s3
    out[1] = s0 ^ xtime(s1) ^ xtime(s2) ^ s2 ^ s3
    out[2] = s0 ^ s1 ^ xtime(s2) ^ xtime(s3) ^ s3
    out[3] = xtime(s0) ^ s0 ^ s1 ^ s2 ^ xtime(s3)

# InvMixColumns: multiply each column by inverse MDS matrix
fn inv_mix_column(s0: u8, s1: u8, s2: u8, s3: u8, out: *u8) -> void
    # InvMixColumn matrix:
    # [0e 0b 0d 09]   [s0]
    # [09 0e 0b 0d] * [s1]
    # [0d 09 0e 0b]   [s2]
    # [0b 0d 09 0e]   [s3]
    out[0] = gf_mul(0x0e, s0) ^ gf_mul(0x0b, s1) ^ gf_mul(0x0d, s2) ^ gf_mul(0x09, s3)
    out[1] = gf_mul(0x09, s0) ^ gf_mul(0x0e, s1) ^ gf_mul(0x0b, s2) ^ gf_mul(0x0d, s3)
    out[2] = gf_mul(0x0d, s0) ^ gf_mul(0x09, s1) ^ gf_mul(0x0e, s2) ^ gf_mul(0x0b, s3)
    out[3] = gf_mul(0x0b, s0) ^ gf_mul(0x0d, s1) ^ gf_mul(0x09, s2) ^ gf_mul(0x0e, s3)

# ============================================================================
# AES Encryption / Decryption (Single Block)
# ============================================================================
# One body for every key size: rk holds nr + 1 16-byte round keys (AES-128:
# nr = 10, AES-256: nr = 14).

# SubBytes + ShiftRows: out[i] = sbox(state[SHIFT_ROWS[i]])
const SHIFT_ROWS: [16]u8 = [0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11]

# InvShiftRows + InvSubBytes: out[i] = inv_sbox(state[INV_SHIFT_ROWS[i]])
const INV_SHIFT_ROWS: [16]u8 = [0, 13, 10, 7, 4, 1, 14, 11, 8, 5, 2, 15, 12, 9, 6, 3]

# pub: the single-block entry for callers that take (round keys, nr) so one
# body serves both key sizes (aes_gcm.ritz's GCM bodies, AGAST #4086).
pub fn aes_encrypt_rounds(rk: *u8, nr: i32, input: *u8, output: *u8) -> void
    var state: [16]u8
    var temp: [16]u8

    # Initial AddRoundKey
    var i: i32 = 0
    while i < 16
        state[i] = input[i] ^ rk[i]
        i += 1

    # nr - 1 main rounds
    var round: i32 = 1
    while round < nr
        let rki: *u8 = rk + (round * 16)

        # SubBytes + ShiftRows into temp
        i = 0
        while i < 16
            temp[i] = sbox(state[SHIFT_ROWS[i] as i64])
            i += 1

        # MixColumns + AddRoundKey, one column at a time
        var mcol: [4]u8
        var c: i32 = 0
        while c < 16
            mix_column(temp[c], temp[c + 1], temp[c + 2], temp[c + 3], @mcol[0])
            state[c] = mcol[0] ^ rki[c]
            state[c + 1] = mcol[1] ^ rki[c + 1]
            state[c + 2] = mcol[2] ^ rki[c + 2]
            state[c + 3] = mcol[3] ^ rki[c + 3]
            c += 4

        round += 1

    # Final round (no MixColumns)
    let final_rk: *u8 = rk + (nr * 16)
    i = 0
    while i < 16
        output[i] = sbox(state[SHIFT_ROWS[i] as i64]) ^ final_rk[i]
        i += 1

fn aes_decrypt_rounds(rk: *u8, nr: i32, input: *u8, output: *u8) -> void
    var state: [16]u8
    var temp: [16]u8

    # Initial AddRoundKey with last round key
    var i: i32 = 0
    while i < 16
        state[i] = input[i] ^ rk[nr * 16 + i]
        i += 1

    # nr - 1 main rounds (in reverse)
    var round: i32 = nr - 1
    while round >= 1
        let rki: *u8 = rk + (round * 16)

        # InvShiftRows + InvSubBytes, then AddRoundKey, into temp
        i = 0
        while i < 16
            temp[i] = inv_sbox(state[INV_SHIFT_ROWS[i] as i64]) ^ rki[i]
            i += 1

        # InvMixColumns, one column at a time
        var imcol: [4]u8
        var c: i32 = 0
        while c < 16
            inv_mix_column(temp[c], temp[c + 1], temp[c + 2], temp[c + 3], @imcol[0])
            state[c] = imcol[0]
            state[c + 1] = imcol[1]
            state[c + 2] = imcol[2]
            state[c + 3] = imcol[3]
            c += 4

        round -= 1

    # Final round (no InvMixColumns)
    i = 0
    while i < 16
        output[i] = inv_sbox(state[INV_SHIFT_ROWS[i] as i64]) ^ rk[i]
        i += 1

pub fn aes128_encrypt_block(ctx: *Aes128, input: *u8, output: *u8) -> void
    aes_encrypt_rounds(@ctx.round_keys[0], 10, input, output)

pub fn aes256_encrypt_block(ctx: *Aes256, input: *u8, output: *u8) -> void
    aes_encrypt_rounds(@ctx.round_keys[0], 14, input, output)

pub fn aes128_decrypt_block(ctx: *Aes128, input: *u8, output: *u8) -> void
    aes_decrypt_rounds(@ctx.round_keys[0], 10, input, output)

pub fn aes256_decrypt_block(ctx: *Aes256, input: *u8, output: *u8) -> void
    aes_decrypt_rounds(@ctx.round_keys[0], 14, input, output)

# ============================================================================
# AES-NI Hardware Accelerated Implementation
# ============================================================================
# Uses the same round_keys buffer as the software implementation; a round key
# is two i64s, so round r's key starts at rk_ptr + 2 * r.

fn aes_encrypt_rounds_ni(rk_ptr: *i64, nr: i32, input: *u8, output: *u8) -> void
    # Load input block, initial round key addition
    var state: v2i64 = simd_loadu(input as *i64)
    state = simd_xor(state, simd_loadu(rk_ptr))

    # nr - 1 main rounds with aesenc
    var round: i32 = 1
    while round < nr
        state = aesenc(state, simd_loadu(rk_ptr + round * 2))
        round += 1

    # Final round with aesenclast
    state = aesenclast(state, simd_loadu(rk_ptr + nr * 2))
    simd_storeu(output as *i64, state)

# For decryption, intermediate round keys need InvMixColumns applied (aesimc)
fn aes_decrypt_rounds_ni(rk_ptr: *i64, nr: i32, input: *u8, output: *u8) -> void
    # Load input block, initial round key addition (with last round key)
    var state: v2i64 = simd_loadu(input as *i64)
    state = simd_xor(state, simd_loadu(rk_ptr + nr * 2))

    # nr - 1 main rounds with aesdec (using aesimc-transformed keys)
    var round: i32 = nr - 1
    while round >= 1
        state = aesdec(state, aesimc(simd_loadu(rk_ptr + round * 2)))
        round -= 1

    # Final round with aesdeclast (no InvMixColumns, so no aesimc)
    state = aesdeclast(state, simd_loadu(rk_ptr))
    simd_storeu(output as *i64, state)

pub fn aes128_encrypt_block_ni(ctx: *Aes128, input: *u8, output: *u8) -> void
    aes_encrypt_rounds_ni(@ctx.round_keys[0] as *i64, 10, input, output)

pub fn aes128_decrypt_block_ni(ctx: *Aes128, input: *u8, output: *u8) -> void
    aes_decrypt_rounds_ni(@ctx.round_keys[0] as *i64, 10, input, output)

pub fn aes256_encrypt_block_ni(ctx: *Aes256, input: *u8, output: *u8) -> void
    aes_encrypt_rounds_ni(@ctx.round_keys[0] as *i64, 14, input, output)

pub fn aes256_decrypt_block_ni(ctx: *Aes256, input: *u8, output: *u8) -> void
    aes_decrypt_rounds_ni(@ctx.round_keys[0] as *i64, 14, input, output)
