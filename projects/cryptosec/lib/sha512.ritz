# lib/sha512.ritz - SHA-512 and SHA-384 implementation
#
# Implementation of SHA-512 and SHA-384 (FIPS 180-4) for cryptographic hashing.
# SHA-512 uses 64-bit state words and 80 rounds.
# SHA-384 is SHA-512 with different IV and truncated output.
#
# API:
# - Sha512 struct: hash context (state + buffer); Sha384 is an alias
# - sha512_init(ctx): Initialize context for SHA-512
# - sha384_init(ctx): Initialize context for SHA-384
# - sha512_update(ctx, data, len): Process data
# - sha512_final(ctx, out): Finalize and output 64-byte hash
# - sha384_final(ctx, out): Finalize and output 48-byte hash
# - sha512(data, len, out): One-shot convenience function (64-byte output)
# - sha384(data, len, out): One-shot convenience function (48-byte output)

import ritzlib.sys
import ritzlib.strview

# ============================================================================
# Constants
# ============================================================================

# SHA-512 block size in bytes (1024 bits)
const SHA512_BLOCK_SIZE: u64 = 128

# SHA-512 digest size in bytes
const SHA512_DIGEST_SIZE: u64 = 64

# SHA-384 digest size in bytes
const SHA384_DIGEST_SIZE: u64 = 48

# SHA-512 Initial hash values (first 64 bits of fractional parts of square roots of first 8 primes)
const H512_0_INIT: u64 = 0x6a09e667f3bcc908
const H512_1_INIT: u64 = 0xbb67ae8584caa73b
const H512_2_INIT: u64 = 0x3c6ef372fe94f82b
const H512_3_INIT: u64 = 0xa54ff53a5f1d36f1
const H512_4_INIT: u64 = 0x510e527fade682d1
const H512_5_INIT: u64 = 0x9b05688c2b3e6c1f
const H512_6_INIT: u64 = 0x1f83d9abfb41bd6b
const H512_7_INIT: u64 = 0x5be0cd19137e2179

# SHA-384 Initial hash values (first 64 bits of fractional parts of square roots of 9th-16th primes)
const H384_0_INIT: u64 = 0xcbbb9d5dc1059ed8
const H384_1_INIT: u64 = 0x629a292a367cd507
const H384_2_INIT: u64 = 0x9159015a3070dd17
const H384_3_INIT: u64 = 0x152fecd8f70e5939
const H384_4_INIT: u64 = 0x67332667ffc00b31
const H384_5_INIT: u64 = 0x8eb44a8768581511
const H384_6_INIT: u64 = 0xdb0c2e0d64f98fa7
const H384_7_INIT: u64 = 0x47b5481dbefa4fa4

# ============================================================================
# SHA-512 / SHA-384 Context
# ============================================================================

struct Sha512
    # Hash state (8 x 64-bit words)
    h0: u64
    h1: u64
    h2: u64
    h3: u64
    h4: u64
    h5: u64
    h6: u64
    h7: u64
    # Message buffer (128 bytes = 1024 bits = 1 block)
    buffer: [128]u8
    # Number of bytes in buffer
    buflen: u64
    # Total message length in bytes (low 64 bits - sufficient for most uses)
    total_len: u64

# SHA-384 is SHA-512 with a different IV and a 48-byte output: one context.
pub type Sha384 = Sha512

# ============================================================================
# Bit operations (64-bit)
# ============================================================================

# Right rotate
fn rotr64(x: u64, n: u64) -> u64
    return (x >> n) | (x << (64 - n))

# SHA-512 sigma functions
fn sigma0_512(x: u64) -> u64
    return rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39)

fn sigma1_512(x: u64) -> u64
    return rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41)

fn gamma0_512(x: u64) -> u64
    return rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7)

fn gamma1_512(x: u64) -> u64
    return rotr64(x, 19) ^ rotr64(x, 61) ^ (x >> 6)

# Choice: (x AND y) XOR (NOT x AND z)
fn ch64(x: u64, y: u64, z: u64) -> u64
    return (x & y) ^ ((~x) & z)

# Majority: (x AND y) XOR (x AND z) XOR (y AND z)
fn maj64(x: u64, y: u64, z: u64) -> u64
    return (x & y) ^ (x & z) ^ (y & z)

# ============================================================================
# Round constants (K) - 80 constants for SHA-512
# ============================================================================

# First 64 bits of the fractional parts of the cube roots of the first 80 primes
const K512: [80]u64 = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

# ============================================================================
# Block processing
# ============================================================================

# Load a big-endian 64-bit word.
# NOTE: Must use intermediate variables due to Ritz compiler bug with
# direct cast from pointer dereference to wider integer types
fn load_be64(p: *u8) -> u64
    var w: u64 = 0
    var i: i32 = 0
    while i < 8
        let t: u8 = p[i]
        let b: u64 = t as u64
        w = (w << 8) | b
        i += 1
    return w

# Store a 64-bit word big-endian.
fn store_be64(out: *u8, w: u64)
    var i: i32 = 0
    while i < 8
        out[i] = (w >> ((7 - i) * 8) as u64) as u8
        i += 1

# Process a single 128-byte block (SHA-512 and SHA-384)
fn sha512_transform(ctx: *Sha512, block: *u8)
    # Message schedule (80 words)
    var w: [80]u64

    # Load first 16 words from block (big-endian)
    var i: i32 = 0
    while i < 16
        w[i] = load_be64(block + i * 8)
        i += 1

    # Extend to 80 words
    while i < 80
        w[i] = gamma1_512(w[i - 2]) + w[i - 7] + gamma0_512(w[i - 15]) + w[i - 16]
        i += 1

    # Working variables
    var a: u64 = ctx.h0
    var b: u64 = ctx.h1
    var c: u64 = ctx.h2
    var d: u64 = ctx.h3
    var e: u64 = ctx.h4
    var f: u64 = ctx.h5
    var g: u64 = ctx.h6
    var h: u64 = ctx.h7

    # 80 rounds
    i = 0
    while i < 80
        let t1: u64 = h + sigma1_512(e) + ch64(e, f, g) + K512[i] + w[i]
        let t2: u64 = sigma0_512(a) + maj64(a, b, c)
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i += 1

    # Add to hash state
    ctx.h0 = ctx.h0 + a
    ctx.h1 = ctx.h1 + b
    ctx.h2 = ctx.h2 + c
    ctx.h3 = ctx.h3 + d
    ctx.h4 = ctx.h4 + e
    ctx.h5 = ctx.h5 + f
    ctx.h6 = ctx.h6 + g
    ctx.h7 = ctx.h7 + h

# Set the IV, empty the buffer and zero the length.
fn sha512_reset(ctx: *Sha512, h0: u64, h1: u64, h2: u64, h3: u64, h4: u64, h5: u64, h6: u64, h7: u64)
    ctx.h0 = h0
    ctx.h1 = h1
    ctx.h2 = h2
    ctx.h3 = h3
    ctx.h4 = h4
    ctx.h5 = h5
    ctx.h6 = h6
    ctx.h7 = h7
    ctx.buflen = 0
    ctx.total_len = 0

    # Zero the buffer
    var i: i32 = 0
    while i < 128
        ctx.buffer[i] = 0
        i += 1

# Pad and process the final block(s), then write the first `words` state
# words big-endian to out (8 for SHA-512, 6 for SHA-384).
fn sha512_finish(ctx: *Sha512, out: *u8, words: i32)
    # Padding: append 1 bit, then zeros, then 128-bit length
    let total_bits: u64 = ctx.total_len * 8

    # Append 0x80 (1 bit followed by zeros)
    ctx.buffer[ctx.buflen] = 0x80
    ctx.buflen = ctx.buflen + 1

    # If not enough room for length (need 16 bytes), pad and process
    if ctx.buflen > 112
        while ctx.buflen < 128
            ctx.buffer[ctx.buflen] = 0
            ctx.buflen = ctx.buflen + 1
        sha512_transform(ctx, @ctx.buffer[0])
        ctx.buflen = 0

    # Pad with zeros up to length field
    while ctx.buflen < 112
        ctx.buffer[ctx.buflen] = 0
        ctx.buflen = ctx.buflen + 1

    # Append length in bits (big-endian, 128 bits - upper 64 bits are 0 for us)
    store_be64(@ctx.buffer[112], 0)
    store_be64(@ctx.buffer[120], total_bits)

    # Process final block
    sha512_transform(ctx, @ctx.buffer[0])

    # Output hash (big-endian); SHA-384 drops h6 and h7
    store_be64(out, ctx.h0)
    store_be64(out + 8, ctx.h1)
    store_be64(out + 16, ctx.h2)
    store_be64(out + 24, ctx.h3)
    store_be64(out + 32, ctx.h4)
    store_be64(out + 40, ctx.h5)
    if words == 8
        store_be64(out + 48, ctx.h6)
        store_be64(out + 56, ctx.h7)

# ============================================================================
# Public API - SHA-512
# ============================================================================

# Create new SHA-512 context (uninitialized)
pub fn sha512_new() -> Sha512
    var ctx: Sha512
    ctx.h0 = 0
    ctx.h1 = 0
    ctx.h2 = 0
    ctx.h3 = 0
    ctx.h4 = 0
    ctx.h5 = 0
    ctx.h6 = 0
    ctx.h7 = 0
    ctx.buflen = 0
    ctx.total_len = 0
    return ctx

# Initialize SHA-512 context
pub fn sha512_init(ctx: *Sha512)
    sha512_reset(ctx, H512_0_INIT, H512_1_INIT, H512_2_INIT, H512_3_INIT, H512_4_INIT, H512_5_INIT, H512_6_INIT, H512_7_INIT)

# Update SHA-512 (or SHA-384) context with data
pub fn sha512_update(ctx: *Sha512, data: *u8, len: u64)
    if len == 0
        return

    ctx.total_len = ctx.total_len + len

    var offset: u64 = 0

    # If we have buffered data, try to complete a block
    if ctx.buflen > 0
        let space: u64 = 128 - ctx.buflen
        var to_copy: u64 = len
        if len > space
            to_copy = space

        # Copy to buffer
        var i: u64 = 0
        while i < to_copy
            ctx.buffer[ctx.buflen + i] = data[i]
            i += 1
        ctx.buflen = ctx.buflen + to_copy
        offset = to_copy

        # If buffer is full, process it
        if ctx.buflen == 128
            sha512_transform(ctx, @ctx.buffer[0])
            ctx.buflen = 0

    # Process full blocks directly from input
    while offset + 128 <= len
        sha512_transform(ctx, (data as u64 + offset) as *u8)
        offset = offset + 128

    # Buffer remaining bytes
    while offset < len
        ctx.buffer[ctx.buflen] = data[offset]
        ctx.buflen = ctx.buflen + 1
        offset += 1

# Finalize SHA-512 and output 64-byte hash
pub fn sha512_final(ctx: *Sha512, out: *u8)
    sha512_finish(ctx, out, 8)

# One-shot SHA-512 hash function
pub fn sha512(data: *u8, len: u64, out: *u8)
    var ctx: Sha512
    sha512_init(@ctx)
    sha512_update(@ctx, data, len)
    sha512_final(@ctx, out)

# ============================================================================
# Public API - SHA-384
# ============================================================================

# Create new SHA-384 context (uninitialized)
pub fn sha384_new() -> Sha384
    return sha512_new()

# Initialize SHA-384 context
pub fn sha384_init(ctx: *Sha384)
    sha512_reset(ctx, H384_0_INIT, H384_1_INIT, H384_2_INIT, H384_3_INIT, H384_4_INIT, H384_5_INIT, H384_6_INIT, H384_7_INIT)

# Update SHA-384 context with data
pub fn sha384_update(ctx: *Sha384, data: *u8, len: u64)
    sha512_update(ctx, data, len)

# Finalize SHA-384 and output 48-byte hash (truncated SHA-512)
pub fn sha384_final(ctx: *Sha384, out: *u8)
    sha512_finish(ctx, out, 6)

# One-shot SHA-384 hash function
pub fn sha384(data: *u8, len: u64, out: *u8)
    var ctx: Sha384
    sha384_init(@ctx)
    sha384_update(@ctx, data, len)
    sha384_final(@ctx, out)

# ============================================================================
# Idiomatic StrView API
# ============================================================================

# One-shot SHA-512 with StrView input (idiomatic Ritz API)
pub fn sha512_str(data: StrView, out: *u8)
    sha512(data.ptr, data.len as u64, out)

# One-shot SHA-384 with StrView input (idiomatic Ritz API)
pub fn sha384_str(data: StrView, out: *u8)
    sha384(data.ptr, data.len as u64, out)

# Update SHA-512 context with StrView data (idiomatic wrapper)
pub fn sha512_update_str(ctx: *Sha512, data: StrView)
    sha512_update(ctx, data.ptr, data.len as u64)

# Update SHA-384 context with StrView data (idiomatic wrapper)
pub fn sha384_update_str(ctx: *Sha384, data: StrView)
    sha384_update(ctx, data.ptr, data.len as u64)
