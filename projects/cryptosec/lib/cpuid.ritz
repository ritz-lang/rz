# lib/cpuid.ritz - CPU feature detection via CPUID instruction
#
# Provides detection of CPU features needed for hardware-accelerated
# cryptographic operations:
#   - SHA-NI (SHA extensions for SHA-256)
#   - AES-NI (AES encryption/decryption)
#   - AVX2 (256-bit SIMD)
#   - AVX-512F (512-bit SIMD foundation)
#   - PCLMULQDQ (carryless multiply for GHASH)
#
# References:
#   - Intel 64 and IA-32 Architectures Software Developer's Manual
#   - AMD64 Architecture Programmer's Manual

# ============================================================================
# CPUID Leaf/Subleaf Constants
# ============================================================================

# Leaf 0: Vendor string
const CPUID_VENDOR: i32 = 0

# Leaf 1: Feature information
const CPUID_FEATURES: i32 = 1

# Leaf 7: Extended features (subleaf 0)
const CPUID_EXT_FEATURES: i32 = 7

# ============================================================================
# Feature Bit Positions
# ============================================================================

# Leaf 1, ECX bits
const CPUID_ECX_PCLMULQDQ: i32 = 1   # Bit 1: PCLMULQDQ
const CPUID_ECX_AES: i32 = 25        # Bit 25: AES-NI
const CPUID_ECX_XSAVE: i32 = 26      # Bit 26: XSAVE
const CPUID_ECX_OSXSAVE: i32 = 27    # Bit 27: OSXSAVE
const CPUID_ECX_AVX: i32 = 28        # Bit 28: AVX

# Leaf 7, EBX bits (subleaf 0)
const CPUID_EBX_AVX2: i32 = 5        # Bit 5: AVX2
const CPUID_EBX_SHA: i32 = 29        # Bit 29: SHA extensions

# Leaf 7, EBX bits for AVX-512
const CPUID_EBX_AVX512F: i32 = 16    # Bit 16: AVX-512 Foundation

# XCR0 (read with XGETBV, ecx = 0): the state components the OS saves and
# restores, i.e. the ones it has enabled. OSXSAVE only says XGETBV exists.
const XCR0_SSE: i32 = 0x2            # Bit 1: XMM state
const XCR0_YMM: i32 = 0x4            # Bit 2: upper halves of YMM
const XCR0_OPMASK: i32 = 0x20        # Bit 5: AVX-512 k0-k7
const XCR0_ZMM_HI256: i32 = 0x40     # Bit 6: upper halves of ZMM0-15
const XCR0_HI16_ZMM: i32 = 0x80      # Bit 7: ZMM16-31
const XCR0_AVX_MASK: i32 = XCR0_SSE | XCR0_YMM
const XCR0_AVX512_MASK: i32 = XCR0_AVX_MASK | XCR0_OPMASK | XCR0_ZMM_HI256 | XCR0_HI16_ZMM

# ============================================================================
# Cached Feature Flags
# ============================================================================

# Every detected feature is one bit of a single u32, published with one atomic
# store and read with one atomic load (GitHub #149 M-19, AGAST #4126). Seven
# plain globals plus a separate "initialized" flag let a second thread see the
# flag before the features, and so take the software path on one call and the
# hardware path on the next. One word cannot be seen half-written: a reader
# either finds READY with every flag of the same detection, or 0 and detects
# for itself. Racing detections all store the same value, so no lock is needed.
pub const CPUID_F_AES_NI: u32 = 0x1
pub const CPUID_F_SHA_NI: u32 = 0x2
pub const CPUID_F_AVX: u32 = 0x4          # already masked by OSXSAVE and XCR0
pub const CPUID_F_AVX2: u32 = 0x8         # already masked by AVX and XCR0
pub const CPUID_F_AVX512F: u32 = 0x10     # already masked by AVX2 and XCR0
pub const CPUID_F_PCLMULQDQ: u32 = 0x20
pub const CPUID_F_OSXSAVE: u32 = 0x40
pub const CPUID_F_READY: u32 = 0x80000000 # set in every detected word, so 0 means "not yet"

# 0 until the first detection; then cpuid_pack(...) with CPUID_F_READY set.
# Touch it only through atomic_load / atomic_store.
var g_cpuid_word: u32 = 0

# ============================================================================
# Low-level CPUID Access
# ============================================================================

# The CPUID instruction: leaf in eax, subleaf in ecx; it leaves its results in
# eax, ebx, ecx and edx, written through the four pointers.  Plain `asm`
# (LANGUAGE_SPEC §18.6, AGAST #3397): no compiler knows this name any more.
[[inline]]
pub fn cpuid_raw(leaf: i32, subleaf: i32, out_eax: *i32, out_ebx: *i32, out_ecx: *i32, out_edx: *i32)
    var a: i32 = leaf
    var b: i32 = 0
    var c: i32 = subleaf
    var d: i32 = 0
    asm x86_64 (inout a: rax, out b: rbx, inout c: rcx, out d: rdx):
        cpuid
    *out_eax = a
    *out_ebx = b
    *out_ecx = c
    *out_edx = d

# do_cpuid: the same, kept as the older public name.
pub fn do_cpuid(leaf: i32, subleaf: i32, eax: *i32, ebx: *i32, ecx: *i32, edx: *i32)
    cpuid_raw(leaf, subleaf, eax, ebx, ecx, edx)

# XGETBV: reads extended control register `xcr` (ecx) into edx:eax. Only
# legal when CPUID.1:ECX.OSXSAVE is set (#UD otherwise). Returns the low 32
# bits, which hold every XCR0 bit this file looks at (AGAST #4127).
[[inline]]
pub fn xgetbv_lo(xcr: i32) -> i32
    var a: i32 = 0
    var c: i32 = xcr
    var d: i32 = 0
    asm x86_64 (out a: rax, inout c: rcx, out d: rdx):
        xgetbv
    return a

# ============================================================================
# Feature Detection (Internal)
# ============================================================================

# Pack detected features (each 0 or nonzero) into one word with CPUID_F_READY.
pub fn cpuid_pack(aes_ni: i32, sha_ni: i32, avx: i32, avx2: i32, avx512f: i32, pclmulqdq: i32, osxsave: i32) -> u32
    var w: u32 = CPUID_F_READY
    if aes_ni != 0
        w = w | CPUID_F_AES_NI
    if sha_ni != 0
        w = w | CPUID_F_SHA_NI
    if avx != 0
        w = w | CPUID_F_AVX
    if avx2 != 0
        w = w | CPUID_F_AVX2
    if avx512f != 0
        w = w | CPUID_F_AVX512F
    if pclmulqdq != 0
        w = w | CPUID_F_PCLMULQDQ
    if osxsave != 0
        w = w | CPUID_F_OSXSAVE
    return w

# 1 if `flag` is set in `word`, else 0.
pub fn cpuid_flag(word: u32, flag: u32) -> i32
    if (word & flag) != 0
        return 1
    return 0

# Run CPUID (and XGETBV) and return the packed feature word. Writes no
# global; cpuid_features_word publishes the result.
pub fn cpuid_detect() -> u32
    var has_aes_ni: i32 = 0
    var has_sha_ni: i32 = 0
    var has_avx: i32 = 0
    var has_avx2: i32 = 0
    var has_avx512f: i32 = 0
    var has_pclmulqdq: i32 = 0
    var has_osxsave: i32 = 0
    var xcr0: i32 = 0

    var eax: i32 = 0
    var ebx: i32 = 0
    var ecx: i32 = 0
    var edx: i32 = 0

    # First check maximum supported CPUID leaf
    cpuid_raw(CPUID_VENDOR, 0, @eax, @ebx, @ecx, @edx)
    let max_leaf: i32 = eax

    # Leaf 1: Basic features (AES-NI, AVX, PCLMULQDQ, OSXSAVE)
    if max_leaf >= 1
        cpuid_raw(CPUID_FEATURES, 0, @eax, @ebx, @ecx, @edx)

        # AES-NI: ECX bit 25
        if ((ecx >> CPUID_ECX_AES) & 1) == 1
            has_aes_ni = 1

        # PCLMULQDQ: ECX bit 1
        if ((ecx >> CPUID_ECX_PCLMULQDQ) & 1) == 1
            has_pclmulqdq = 1

        # AVX: ECX bit 28
        if ((ecx >> CPUID_ECX_AVX) & 1) == 1
            has_avx = 1

        # OSXSAVE: ECX bit 27 (needed to verify OS supports AVX state)
        if ((ecx >> CPUID_ECX_OSXSAVE) & 1) == 1
            has_osxsave = 1
            xcr0 = xgetbv_lo(0)

    # Leaf 7: Extended features (AVX2, SHA-NI, AVX-512F)
    if max_leaf >= 7
        cpuid_raw(CPUID_EXT_FEATURES, 0, @eax, @ebx, @ecx, @edx)

        # AVX2: EBX bit 5
        if ((ebx >> CPUID_EBX_AVX2) & 1) == 1
            has_avx2 = 1

        # SHA-NI: EBX bit 29
        if ((ebx >> CPUID_EBX_SHA) & 1) == 1
            has_sha_ni = 1

        # AVX-512F: EBX bit 16
        if ((ebx >> CPUID_EBX_AVX512F) & 1) == 1
            has_avx512f = 1

    # Keep only what the OS has enabled in XCR0 (AGAST #4127), so every
    # getter and cpu_detect_features agree. AVX-512 first: it reads the raw
    # AVX/AVX2 bits.
    has_avx512f = cpu_avx512_usable(has_avx, has_avx2, has_osxsave, xcr0, has_avx512f)
    has_avx2 = cpu_avx2_usable(has_avx, has_osxsave, xcr0, has_avx2)
    has_avx = cpu_avx_usable(has_avx, has_osxsave, xcr0)

    return cpuid_pack(has_aes_ni, has_sha_ni, has_avx, has_avx2, has_avx512f, has_pclmulqdq, has_osxsave)

# The published feature word, detecting and publishing it on first use. Safe
# to call from any number of threads at once (AGAST #4126). Read every flag a
# decision needs out of one returned word, not from repeated calls.
pub fn cpuid_features_word() -> u32
    let w: u32 = atomic_load(@g_cpuid_word as *u32)
    if (w & CPUID_F_READY) != 0
        return w
    let detected: u32 = cpuid_detect()
    atomic_store(@g_cpuid_word as *u32, detected)
    return detected

# ============================================================================
# Usability Predicates (pure, so they can be tested without the CPU at hand)
# ============================================================================

# AVX is usable when the CPU has it, XGETBV exists (OSXSAVE) and the OS has
# enabled SSE and YMM state in XCR0 (AGAST #4127).
pub fn cpu_avx_usable(has_avx: i32, has_osxsave: i32, xcr0: i32) -> i32
    if has_avx == 0 || has_osxsave == 0
        return 0
    if (xcr0 & XCR0_AVX_MASK) != XCR0_AVX_MASK
        return 0
    return 1

# AVX2 uses the same YMM state as AVX.
pub fn cpu_avx2_usable(has_avx: i32, has_osxsave: i32, xcr0: i32, has_avx2: i32) -> i32
    if cpu_avx_usable(has_avx, has_osxsave, xcr0) == 0
        return 0
    return has_avx2

# AVX-512F also needs AVX2 (GitHub #149 L-7, AGAST #2586) and the opmask,
# ZMM_Hi256 and Hi16_ZMM state enabled in XCR0 (AGAST #4127).
pub fn cpu_avx512_usable(has_avx: i32, has_avx2: i32, has_osxsave: i32, xcr0: i32, has_avx512f: i32) -> i32
    if cpu_avx2_usable(has_avx, has_osxsave, xcr0, has_avx2) == 0
        return 0
    if (xcr0 & XCR0_AVX512_MASK) != XCR0_AVX512_MASK
        return 0
    return has_avx512f

# ============================================================================
# Public Feature Detection API
# ============================================================================

# Check if CPU supports AES-NI (AES encryption instructions)
pub fn cpu_has_aes_ni() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_AES_NI)

# Check if CPU supports SHA-NI (SHA-256 hardware acceleration)
pub fn cpu_has_sha_ni() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_SHA_NI)

# Check if CPU supports AVX (256-bit SIMD, needed for AVX2) and the OS has
# enabled YMM state
pub fn cpu_has_avx() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_AVX)

# Check if CPU supports AVX2 (256-bit integer SIMD)
# cpuid_detect has already masked it by AVX, OSXSAVE and XCR0.
pub fn cpu_has_avx2() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_AVX2)

# Check if CPU supports AVX-512F (512-bit SIMD foundation); cpuid_detect has
# already masked it by AVX2, OSXSAVE and XCR0.
pub fn cpu_has_avx512() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_AVX512F)

# Check if CPU supports PCLMULQDQ (carryless multiply for GHASH)
pub fn cpu_has_pclmulqdq() -> i32
    return cpuid_flag(cpuid_features_word(), CPUID_F_PCLMULQDQ)

# ============================================================================
# Feature Structure
# ============================================================================

# All detected CPU features in one structure
pub struct CpuFeatures
    has_aes_ni: i32
    has_sha_ni: i32
    has_avx: i32
    has_avx2: i32
    has_avx512f: i32
    has_pclmulqdq: i32
    has_osxsave: i32

# Detect all CPU features at once
pub fn cpu_detect_features(features: *CpuFeatures)
    let w: u32 = cpuid_features_word()       # one load: one consistent snapshot
    features.has_aes_ni = cpuid_flag(w, CPUID_F_AES_NI)
    features.has_sha_ni = cpuid_flag(w, CPUID_F_SHA_NI)
    features.has_avx = cpuid_flag(w, CPUID_F_AVX)
    features.has_avx2 = cpuid_flag(w, CPUID_F_AVX2)
    features.has_avx512f = cpuid_flag(w, CPUID_F_AVX512F)
    features.has_pclmulqdq = cpuid_flag(w, CPUID_F_PCLMULQDQ)
    features.has_osxsave = cpuid_flag(w, CPUID_F_OSXSAVE)
