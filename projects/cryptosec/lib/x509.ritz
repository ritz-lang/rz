# X.509 Certificate Parser
#
# Parses X.509 v3 certificates as defined in RFC 5280.
# Built on top of the ASN.1/DER parser.
#
# Certificate structure (simplified):
#
# Certificate ::= SEQUENCE {
#     tbsCertificate       TBSCertificate,
#     signatureAlgorithm   AlgorithmIdentifier,
#     signatureValue       BIT STRING
# }
#
# TBSCertificate ::= SEQUENCE {
#     version         [0]  EXPLICIT Version DEFAULT v1,
#     serialNumber         CertificateSerialNumber,
#     signature            AlgorithmIdentifier,
#     issuer               Name,
#     validity             Validity,
#     subject              Name,
#     subjectPublicKeyInfo SubjectPublicKeyInfo,
#     ...extensions...
# }
#
# References:
# - RFC 5280 (Internet X.509 PKI Certificate and CRL Profile)

import ritzlib.sys
import ritzlib.io
import asn1
import mem

# ============================================================================
# X.509 Certificate Structures
# ============================================================================

# Maximum lengths for certificate fields
const X509_MAX_NAME_LEN: i32 = 256
const X509_MAX_SERIAL_LEN: i32 = 20
# Holds an RSA-4096 SubjectPublicKey (a 526-byte RSAPublicKey); larger keys
# are refused, never truncated. Keep in step with X509PublicKey.key_data.
const X509_MAX_PUBKEY_LEN: i32 = 600
const X509_MAX_SIG_LEN: i32 = 512

# Public key types
const PUBKEY_TYPE_UNKNOWN: u8   = 0
const PUBKEY_TYPE_RSA: u8       = 1
const PUBKEY_TYPE_EC: u8        = 2
const PUBKEY_TYPE_ED25519: u8   = 3

# EC curve types
const EC_CURVE_UNKNOWN: u8  = 0
const EC_CURVE_P256: u8     = 1
const EC_CURVE_P384: u8     = 2

# Signature algorithm types
const SIG_ALG_UNKNOWN: u8       = 0
const SIG_ALG_SHA256_RSA: u8    = 1
const SIG_ALG_SHA384_RSA: u8    = 2
const SIG_ALG_SHA512_RSA: u8    = 3
const SIG_ALG_ECDSA_SHA256: u8  = 4
const SIG_ALG_ECDSA_SHA384: u8  = 5
const SIG_ALG_ED25519: u8       = 6

# keyUsage bits (RFC 5280 4.2.1.3): KeyUsage bit n is stored as 1 << n.
const KU_DIGITAL_SIGNATURE: u16 = 0x0001
const KU_NON_REPUDIATION: u16   = 0x0002
const KU_KEY_ENCIPHERMENT: u16  = 0x0004
const KU_DATA_ENCIPHERMENT: u16 = 0x0008
const KU_KEY_AGREEMENT: u16     = 0x0010
const KU_KEY_CERT_SIGN: u16     = 0x0020
const KU_CRL_SIGN: u16          = 0x0040
const KU_ENCIPHER_ONLY: u16     = 0x0080
const KU_DECIPHER_ONLY: u16     = 0x0100

# extendedKeyUsage purposes we act on (RFC 5280 4.2.1.12)
const EKU_SERVER_AUTH: u8 = 0x01   # id-kp-serverAuth
const EKU_ANY: u8         = 0x02   # anyExtendedKeyUsage

# Extensions the parser understands (one bit each, to refuse duplicates).
# A critical extension outside this set sets unknown_critical.
const EXT_SAN: u8       = 0x01
const EXT_BASIC: u8     = 0x02
const EXT_KU: u8        = 0x04
const EXT_EKU: u8       = 0x08
const EXT_NAME_CONS: u8 = 0x10

# Validity period (times as Unix timestamps)
struct X509Validity
    not_before: i64
    not_after: i64

# Distinguished Name (simplified - just stores common fields)
struct X509Name
    # ub-common-name is 64 (RFC 5280 A.1). A longer CN is not stored at all
    # (length 0, so it never matches a hostname): truncated, it could name
    # another host.
    common_name: [64]u8
    common_name_len: u8
    organization: [64]u8
    organization_len: u8
    country: [3]u8
    country_len: u8
    # Raw DER encoding for comparison
    der_data: *u8
    der_len: u64

# Subject Public Key Info
struct X509PublicKey
    algorithm: u8           # PUBKEY_TYPE_*
    curve: u8               # EC_CURVE_* (for EC keys)
    key_data: [600]u8       # Raw public key bytes (X509_MAX_PUBKEY_LEN)
    key_len: u64

# Parsed X.509 Certificate
struct X509Certificate
    version: u8             # 1, 2, or 3
    serial: [20]u8          # Serial number (up to 20 bytes)
    serial_len: u8
    sig_algorithm: u8       # SIG_ALG_*
    issuer: X509Name
    validity: X509Validity
    subject: X509Name
    public_key: X509PublicKey

    # Extensions. An absent keyUsage / extendedKeyUsage restricts nothing.
    is_ca: u8               # basicConstraints cA
    has_path_len: u8
    path_len: i32           # basicConstraints pathLenConstraint
    has_key_usage: u8
    key_usage: u16          # KU_* bits
    has_ext_key_usage: u8
    ext_key_usage: u8       # EKU_* bits
    # nameConstraints: the NameConstraints SEQUENCE (DER, tag and length
    # included), pointing into the certificate's DER like tbs_data.
    has_name_constraints: u8
    nc_data: *u8
    nc_len: u64
    # 1 if a critical extension not listed in EXT_* is present: the
    # certificate must not be used in path validation (RFC 5280 4.2).
    unknown_critical: u8

    # subjectAltName: the GeneralNames SEQUENCE (DER, tag and length
    # included), pointing into the certificate's DER like tbs_data.
    # has_san is 1 when the extension is present, even if it holds no
    # dNSName: a SAN-bearing certificate's CN is never a hostname.
    has_san: u8
    san_data: *u8
    san_len: u64

    # Signature
    signature: [512]u8
    signature_len: u64

    # Raw TBS (to-be-signed) data for verification
    tbs_data: *u8
    tbs_len: u64

# ============================================================================
# Algorithm Identifier Parsing
# ============================================================================

# Parse AlgorithmIdentifier and return algorithm type
# Returns: algorithm type constant, or 0 on error/unknown
pub fn x509_parse_sig_algorithm(parser: *DerParser) -> u8
    var seq: DerElement
    if der_parse_element(parser, @seq) != 0
        return SIG_ALG_UNKNOWN

    if der_is_sequence(@seq) != 1
        return SIG_ALG_UNKNOWN

    var seq_parser: DerParser
    if der_enter_sequence(@seq, @seq_parser) != 0
        return SIG_ALG_UNKNOWN

    # Parse OID
    var oid_elem: DerElement
    if der_parse_element(@seq_parser, @oid_elem) != 0
        return SIG_ALG_UNKNOWN

    var oid: Oid
    if der_decode_oid(@oid_elem, @oid) != 0
        return SIG_ALG_UNKNOWN

    # Match against known algorithms
    if oid_is_sha256_rsa(@oid) == 1
        return SIG_ALG_SHA256_RSA
    if oid_is_sha384_rsa(@oid) == 1
        return SIG_ALG_SHA384_RSA
    if oid_is_sha512_rsa(@oid) == 1
        return SIG_ALG_SHA512_RSA
    if oid_is_ecdsa_sha256(@oid) == 1
        return SIG_ALG_ECDSA_SHA256
    if oid_is_ecdsa_sha384(@oid) == 1
        return SIG_ALG_ECDSA_SHA384
    if oid_is_ed25519(@oid) == 1
        return SIG_ALG_ED25519

    return SIG_ALG_UNKNOWN

# ============================================================================
# Name (Distinguished Name) Parsing
# ============================================================================

# Parse a single RDN attribute value (OID + value)
fn x509_parse_rdn_attribute(parser: *DerParser, name: *X509Name) -> i32
    var seq: DerElement
    if der_parse_element(parser, @seq) != 0
        return -1

    if der_is_sequence(@seq) != 1
        return -1

    var attr_parser: DerParser
    if der_enter_sequence(@seq, @attr_parser) != 0
        return -1

    # Parse attribute type OID
    var oid_elem: DerElement
    if der_parse_element(@attr_parser, @oid_elem) != 0
        return -1

    var oid: Oid
    if der_decode_oid(@oid_elem, @oid) != 0
        return -1

    # Parse attribute value (string)
    var value_elem: DerElement
    if der_parse_element(@attr_parser, @value_elem) != 0
        return -1

    # Copy value to appropriate field based on OID
    if oid_is_common_name(@oid) == 1
        if value_elem.content_len > 64
            name.common_name_len = 0
        else
            mem_copy(@name.common_name[0], value_elem.content, value_elem.content_len)
            name.common_name_len = value_elem.content_len as u8

    if oid_is_org_name(@oid) == 1
        var copy_len: u64 = value_elem.content_len
        if copy_len > 63
            copy_len = 63
        mem_copy(@name.organization[0], value_elem.content, copy_len)
        name.organization_len = copy_len as u8

    if oid_is_country_name(@oid) == 1
        var copy_len: u64 = value_elem.content_len
        if copy_len > 2
            copy_len = 2
        mem_copy(@name.country[0], value_elem.content, copy_len)
        name.country_len = copy_len as u8

    return 0

# Parse Name (sequence of RDNs)
pub fn x509_parse_name(parser: *DerParser, name: *X509Name) -> i32
    # Initialize
    name.common_name_len = 0
    name.organization_len = 0
    name.country_len = 0

    var seq: DerElement
    if der_parse_element(parser, @seq) != 0
        return -1

    if der_is_sequence(@seq) != 1
        return -1

    # Save raw DER for later comparison
    name.der_data = seq.content - seq.header_len
    name.der_len = seq.header_len + seq.content_len

    var name_parser: DerParser
    if der_enter_sequence(@seq, @name_parser) != 0
        return -1

    # Parse each RDN (SET of AttributeTypeAndValue)
    while der_parser_eof(@name_parser) != 1
        var rdn_set: DerElement
        if der_parse_element(@name_parser, @rdn_set) != 0
            return -1

        if der_is_set(@rdn_set) != 1
            return -1

        var rdn_parser: DerParser
        if der_enter_set(@rdn_set, @rdn_parser) != 0
            return -1

        # Parse attributes in this RDN
        while der_parser_eof(@rdn_parser) != 1
            if x509_parse_rdn_attribute(@rdn_parser, name) != 0
                return -1

    return 0

# Compare two X509Names by their raw DER encoding
pub fn x509_name_equals(a: *X509Name, b: *X509Name) -> i32
    if a.der_len != b.der_len
        return 0

    if mem_eq(a.der_data, b.der_data, a.der_len) == 1
        return 1

    return 0

# ============================================================================
# Time Parsing
# ============================================================================

# Parse 2-digit decimal
fn parse_2digit(s: *u8) -> i32
    let d1: i32 = (s[0] - 0x30) as i32
    let d2: i32 = (s[1] - 0x30) as i32
    return d1 * 10 + d2

# Parse 4-digit decimal
fn parse_4digit(s: *u8) -> i32
    let d1: i32 = (s[0] - 0x30) as i32
    let d2: i32 = (s[1] - 0x30) as i32
    let d3: i32 = (s[2] - 0x30) as i32
    let d4: i32 = (s[3] - 0x30) as i32
    return d1 * 1000 + d2 * 100 + d3 * 10 + d4

# Days in months (non-leap year)
fn days_in_month(month: i32, year: i32) -> i32
    if month == 2
        # Leap year check
        if (year % 4) == 0
            if (year % 100) == 0
                if (year % 400) == 0
                    return 29
                return 28
            return 29
        return 28

    if month == 4
        return 30
    if month == 6
        return 30
    if month == 9
        return 30
    if month == 11
        return 30

    return 31

# Convert calendar time to Unix timestamp (seconds since 1970-01-01 00:00:00 UTC)
# Simplified - assumes UTC
pub fn calendar_to_unix(year: i32, month: i32, day: i32, hour: i32, min: i32, sec: i32) -> i64
    # Days from 1970 to year
    var days: i64 = 0
    var y: i32 = 1970
    while y < year
        if (y % 4) == 0
            if (y % 100) == 0
                if (y % 400) == 0
                    days = days + 366
                else
                    days = days + 365
            else
                days = days + 366
        else
            days = days + 365
        y += 1

    # Days in months
    var m: i32 = 1
    while m < month
        days = days + (days_in_month(m, year) as i64)
        m += 1

    # Days
    days = days + ((day - 1) as i64)

    # Convert to seconds
    var result: i64 = days * 86400
    result = result + ((hour as i64) * 3600)
    result = result + ((min as i64) * 60)
    result = result + (sec as i64)

    return result

# Parse UTCTime: YYMMDDhhmmssZ
pub fn x509_parse_utc_time(elem: *DerElement, out: *i64) -> i32
    if der_is_utc_time(elem) != 1
        return -1

    if elem.content_len < 13
        return -1

    let yy: i32 = parse_2digit(@elem.content[0])
    let mm: i32 = parse_2digit(@elem.content[2])
    let dd: i32 = parse_2digit(@elem.content[4])
    let hh: i32 = parse_2digit(@elem.content[6])
    let mi: i32 = parse_2digit(@elem.content[8])
    let ss: i32 = parse_2digit(@elem.content[10])

    # Y2K handling: 00-49 -> 2000-2049, 50-99 -> 1950-1999
    var year: i32 = 0
    if yy < 50
        year = 2000 + yy
    else
        year = 1900 + yy

    *out = calendar_to_unix(year, mm, dd, hh, mi, ss)
    return 0

# Parse GeneralizedTime: YYYYMMDDhhmmssZ
pub fn x509_parse_generalized_time(elem: *DerElement, out: *i64) -> i32
    if der_is_generalized_time(elem) != 1
        return -1

    if elem.content_len < 15
        return -1

    let year: i32 = parse_4digit(@elem.content[0])
    let mm: i32 = parse_2digit(@elem.content[4])
    let dd: i32 = parse_2digit(@elem.content[6])
    let hh: i32 = parse_2digit(@elem.content[8])
    let mi: i32 = parse_2digit(@elem.content[10])
    let ss: i32 = parse_2digit(@elem.content[12])

    *out = calendar_to_unix(year, mm, dd, hh, mi, ss)
    return 0

# Parse either UTCTime or GeneralizedTime
fn x509_parse_time(elem: *DerElement, out: *i64) -> i32
    if der_is_utc_time(elem) == 1
        return x509_parse_utc_time(elem, out)
    if der_is_generalized_time(elem) == 1
        return x509_parse_generalized_time(elem, out)
    return -1

# Parse Validity sequence
pub fn x509_parse_validity(parser: *DerParser, validity: *X509Validity) -> i32
    var seq: DerElement
    if der_parse_element(parser, @seq) != 0
        return -1

    if der_is_sequence(@seq) != 1
        return -1

    var val_parser: DerParser
    if der_enter_sequence(@seq, @val_parser) != 0
        return -1

    # Parse notBefore
    var not_before: DerElement
    if der_parse_element(@val_parser, @not_before) != 0
        return -1

    if x509_parse_time(@not_before, @validity.not_before) != 0
        return -1

    # Parse notAfter
    var not_after: DerElement
    if der_parse_element(@val_parser, @not_after) != 0
        return -1

    if x509_parse_time(@not_after, @validity.not_after) != 0
        return -1

    return 0

# ============================================================================
# Subject Public Key Info Parsing
# ============================================================================

pub fn x509_parse_public_key(parser: *DerParser, pubkey: *X509PublicKey) -> i32
    var seq: DerElement
    if der_parse_element(parser, @seq) != 0
        return -1

    if der_is_sequence(@seq) != 1
        return -1

    var spki_parser: DerParser
    if der_enter_sequence(@seq, @spki_parser) != 0
        return -1

    # Parse AlgorithmIdentifier
    var alg_seq: DerElement
    if der_parse_element(@spki_parser, @alg_seq) != 0
        return -1

    if der_is_sequence(@alg_seq) != 1
        return -1

    var alg_parser: DerParser
    if der_enter_sequence(@alg_seq, @alg_parser) != 0
        return -1

    var oid_elem: DerElement
    if der_parse_element(@alg_parser, @oid_elem) != 0
        return -1

    var oid: Oid
    if der_decode_oid(@oid_elem, @oid) != 0
        return -1

    # Determine key type
    if oid_is_rsa(@oid) == 1
        pubkey.algorithm = PUBKEY_TYPE_RSA
        pubkey.curve = EC_CURVE_UNKNOWN
    else
        if oid_is_ec_public_key(@oid) == 1
            pubkey.algorithm = PUBKEY_TYPE_EC

            # Parse curve OID from parameters
            var curve_elem: DerElement
            if der_parse_element(@alg_parser, @curve_elem) != 0
                return -1

            var curve_oid: Oid
            if der_decode_oid(@curve_elem, @curve_oid) != 0
                return -1

            if oid_is_p256(@curve_oid) == 1
                pubkey.curve = EC_CURVE_P256
            else
                if oid_is_p384(@curve_oid) == 1
                    pubkey.curve = EC_CURVE_P384
                else
                    pubkey.curve = EC_CURVE_UNKNOWN
        else
            if oid_is_ed25519(@oid) == 1
                pubkey.algorithm = PUBKEY_TYPE_ED25519
                pubkey.curve = EC_CURVE_UNKNOWN
            else
                pubkey.algorithm = PUBKEY_TYPE_UNKNOWN
                pubkey.curve = EC_CURVE_UNKNOWN

    # Parse subjectPublicKey BIT STRING
    var pk_bits: DerElement
    if der_parse_element(@spki_parser, @pk_bits) != 0
        return -1

    var pk_data: *u8 = null
    var pk_len: u64 = 0
    var unused: u8 = 0

    if der_bit_string_content(@pk_bits, @pk_data, @pk_len, @unused) != 0
        return -1

    if pk_len > X509_MAX_PUBKEY_LEN as u64
        return -1

    mem_copy(@pubkey.key_data[0], pk_data, pk_len)
    pubkey.key_len = pk_len

    return 0

# ============================================================================
# Extensions Parsing
# ============================================================================

# Every parser below fails closed: -1 on any DER it does not expect. The
# caller then rejects the whole certificate, so a malformed extension can
# never hide the subjectAltName (and with it the CN fallback) or a constraint.

# Parse `data` as exactly one DER element (nothing after it).
fn x509_ext_single(data: *u8, len: u64, out: *DerElement) -> i32
    var p: DerParser
    der_parser_init(@p, data, len)
    if der_parse_element(@p, out) != 0
        return -1
    if der_parser_eof(@p) != 1
        return -1
    return 0

# subjectAltName: GeneralNames ::= SEQUENCE OF GeneralName. The entries are
# read when matching (x509_verify); malformed entries match nothing there.
fn x509_parse_ext_san(data: *u8, len: u64, cert: *X509Certificate) -> i32
    var seq: DerElement
    if x509_ext_single(data, len, @seq) != 0
        return -1
    if der_is_sequence(@seq) != 1
        return -1
    cert.has_san = 1
    cert.san_data = seq.content - seq.header_len
    cert.san_len = seq.header_len + seq.content_len
    return 0

# basicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE,
#                                 pathLenConstraint INTEGER (0..MAX) OPTIONAL }
fn x509_parse_ext_basic(data: *u8, len: u64, cert: *X509Certificate) -> i32
    var seq: DerElement
    if x509_ext_single(data, len, @seq) != 0
        return -1
    var bc: DerParser
    if der_enter_sequence(@seq, @bc) != 0
        return -1
    if der_parser_eof(@bc) == 1
        return 0
    var e: DerElement
    if der_parse_element(@bc, @e) != 0
        return -1
    if e.tag_class == TAG_CLASS_UNIVERSAL && e.tag_number == (TAG_BOOLEAN as u32)
        if e.content_len != 1
            return -1
        if e.content[0] != 0
            cert.is_ca = 1
        if der_parser_eof(@bc) == 1
            return 0
        if der_parse_element(@bc, @e) != 0
            return -1
    var n: i64 = 0
    if der_integer_to_i64(@e, @n) != 0
        return -1
    if n < 0
        return -1
    if n > 1000
        n = 1000  # far beyond any chain we accept (X509_MAX_CHAIN_DEPTH)
    cert.has_path_len = 1
    cert.path_len = n as i32
    if der_parser_eof(@bc) != 1
        return -1
    return 0

# keyUsage ::= BIT STRING; bit n (MSB of the first byte is bit 0) -> 1 << n.
fn x509_parse_ext_key_usage(data: *u8, len: u64, cert: *X509Certificate) -> i32
    var bits: DerElement
    if x509_ext_single(data, len, @bits) != 0
        return -1
    var p: *u8 = null
    var n: u64 = 0
    var unused: u8 = 0
    if der_bit_string_content(@bits, @p, @n, @unused) != 0
        return -1
    var ku: u16 = 0
    var i: u64 = 0
    while i < 9
        let byte: u64 = i / 8
        if byte < n
            let mask: u8 = (0x80 >> (i % 8)) as u8
            if (p[byte] & mask) != 0
                ku = ku | ((1 << i) as u16)
        i += 1
    cert.has_key_usage = 1
    cert.key_usage = ku
    return 0

# extKeyUsage ::= SEQUENCE OF KeyPurposeId (OBJECT IDENTIFIER)
fn x509_parse_ext_eku(data: *u8, len: u64, cert: *X509Certificate) -> i32
    var seq: DerElement
    if x509_ext_single(data, len, @seq) != 0
        return -1
    var p: DerParser
    if der_enter_sequence(@seq, @p) != 0
        return -1
    var eku: u8 = 0
    while der_parser_eof(@p) != 1
        var e: DerElement
        if der_parse_element(@p, @e) != 0
            return -1
        var oid: Oid
        if der_decode_oid(@e, @oid) != 0
            return -1
        if oid_is_kp_server_auth(@oid) == 1
            eku = eku | EKU_SERVER_AUTH
        if oid_is_any_ext_key_usage(@oid) == 1
            eku = eku | EKU_ANY
    cert.has_ext_key_usage = 1
    cert.ext_key_usage = eku
    return 0

# nameConstraints ::= SEQUENCE { permitted [0], excluded [1] }. Kept as DER;
# x509_verify checks its subtrees against the certificates below this CA.
fn x509_parse_ext_name_constraints(data: *u8, len: u64, cert: *X509Certificate) -> i32
    var seq: DerElement
    if x509_ext_single(data, len, @seq) != 0
        return -1
    if der_is_sequence(@seq) != 1
        return -1
    cert.has_name_constraints = 1
    cert.nc_data = seq.content - seq.header_len
    cert.nc_len = seq.header_len + seq.content_len
    return 0

# EXT_* bit for an extension OID we understand, 0 for any other.
fn x509_ext_kind(oid: *Oid) -> u8
    if oid_is_subject_alt_name(oid) == 1
        return EXT_SAN
    if oid_is_basic_constraints(oid) == 1
        return EXT_BASIC
    if oid_is_key_usage(oid) == 1
        return EXT_KU
    if oid_is_ext_key_usage(oid) == 1
        return EXT_EKU
    if oid_is_name_constraints(oid) == 1
        return EXT_NAME_CONS
    return 0

# Extension ::= SEQUENCE { extnID OID, critical BOOLEAN DEFAULT FALSE,
#                          extnValue OCTET STRING }
# `seen` collects EXT_* bits: an extension may appear only once (4.2).
fn x509_parse_extension(parser: *DerParser, cert: *X509Certificate, seen: *u8) -> i32
    var ext: DerElement
    if der_parse_element(parser, @ext) != 0
        return -1
    var inner: DerParser
    if der_enter_sequence(@ext, @inner) != 0
        return -1

    var oid_elem: DerElement
    if der_parse_element(@inner, @oid_elem) != 0
        return -1
    var oid: Oid
    if der_decode_oid(@oid_elem, @oid) != 0
        return -1

    var critical: u8 = 0
    var value: DerElement
    if der_parse_element(@inner, @value) != 0
        return -1
    if value.tag_class == TAG_CLASS_UNIVERSAL && value.tag_number == (TAG_BOOLEAN as u32)
        if value.content_len != 1
            return -1
        if value.content[0] != 0
            critical = 1
        if der_parse_element(@inner, @value) != 0
            return -1
    if der_is_octet_string(@value) != 1 || value.constructed != 0
        return -1
    if der_parser_eof(@inner) != 1
        return -1

    let kind: u8 = x509_ext_kind(@oid)
    if kind == 0
        if critical == 1
            cert.unknown_critical = 1
        return 0
    if (*seen & kind) != 0
        return -1
    *seen = *seen | kind

    if kind == EXT_SAN
        return x509_parse_ext_san(value.content, value.content_len, cert)
    if kind == EXT_BASIC
        return x509_parse_ext_basic(value.content, value.content_len, cert)
    if kind == EXT_KU
        return x509_parse_ext_key_usage(value.content, value.content_len, cert)
    if kind == EXT_EKU
        return x509_parse_ext_eku(value.content, value.content_len, cert)
    return x509_parse_ext_name_constraints(value.content, value.content_len, cert)

# extensions [3] EXPLICIT Extensions; Extensions ::= SEQUENCE OF Extension
fn x509_parse_extensions(wrapper: *DerElement, cert: *X509Certificate) -> i32
    var wrapper_parser: DerParser
    if der_enter_constructed(wrapper, @wrapper_parser) != 0
        return -1
    var ext_seq: DerElement
    if der_parse_element(@wrapper_parser, @ext_seq) != 0
        return -1
    if der_parser_eof(@wrapper_parser) != 1
        return -1
    var ext_parser: DerParser
    if der_enter_sequence(@ext_seq, @ext_parser) != 0
        return -1
    var seen: u8 = 0
    while der_parser_eof(@ext_parser) != 1
        if x509_parse_extension(@ext_parser, cert, @seen) != 0
            return -1
    return 0

# What follows subjectPublicKeyInfo in the TBS: issuerUniqueID [1] and
# subjectUniqueID [2] (v2+, skipped), then extensions [3] (v3, once).
# Anything else is an error.
fn x509_parse_tbs_tail(parser: *DerParser, cert: *X509Certificate) -> i32
    var have_ext: i32 = 0
    while der_parser_eof(parser) != 1
        var e: DerElement
        if der_parse_element(parser, @e) != 0
            return -1
        if have_ext == 1
            return -1
        if cert.version >= 2 && (der_is_context_tag(@e, 1) == 1 || der_is_context_tag(@e, 2) == 1)
            continue
        if cert.version != 3 || der_is_context_tag(@e, 3) != 1
            return -1
        if x509_parse_extensions(@e, cert) != 0
            return -1
        have_ext = 1
    return 0

# ============================================================================
# Main Certificate Parsing
# ============================================================================

# Parse a DER-encoded X.509 certificate
# Returns: 0 on success, negative error code on failure
pub fn x509_parse_certificate(der_data: *u8, der_len: u64, cert: *X509Certificate) -> i32
    # Initialize certificate
    mem_zero(cert as *u8, sizeof(X509Certificate))

    var parser: DerParser
    der_parser_init(@parser, der_data, der_len)

    # Certificate ::= SEQUENCE
    var cert_seq: DerElement
    if der_parse_element(@parser, @cert_seq) != 0
        return -1

    if der_is_sequence(@cert_seq) != 1
        return -2

    var cert_parser: DerParser
    if der_enter_sequence(@cert_seq, @cert_parser) != 0
        return -3

    # TBSCertificate
    var tbs: DerElement
    if der_parse_element(@cert_parser, @tbs) != 0
        return -4

    if der_is_sequence(@tbs) != 1
        return -5

    # Save TBS for signature verification
    cert.tbs_data = tbs.content - tbs.header_len
    cert.tbs_len = tbs.header_len + tbs.content_len

    var tbs_parser: DerParser
    if der_enter_sequence(@tbs, @tbs_parser) != 0
        return -6

    # Version [0] EXPLICIT (optional, default v1)
    var first_elem: DerElement
    if der_parse_element(@tbs_parser, @first_elem) != 0
        return -7

    if der_is_context_tag(@first_elem, 0) == 1
        # Explicit version tag
        var ver_parser: DerParser
        if der_enter_constructed(@first_elem, @ver_parser) != 0
            return -8

        var ver_int: DerElement
        if der_parse_element(@ver_parser, @ver_int) != 0
            return -9

        var version: i64 = 0
        if der_integer_to_i64(@ver_int, @version) != 0
            return -10

        cert.version = (version + 1) as u8  # 0 = v1, 1 = v2, 2 = v3

        # Parse serial number (next element)
        if der_parse_element(@tbs_parser, @first_elem) != 0
            return -11
    else
        # No explicit version, default to v1
        cert.version = 1

    # Serial number (reusing first_elem)
    if der_is_integer(@first_elem) != 1
        return -12

    var serial_len: u64 = first_elem.content_len
    if serial_len > 20
        serial_len = 20
    mem_copy(@cert.serial[0], first_elem.content, serial_len)
    cert.serial_len = serial_len as u8

    # Signature algorithm (in TBS)
    cert.sig_algorithm = x509_parse_sig_algorithm(@tbs_parser)

    # Issuer
    if x509_parse_name(@tbs_parser, @cert.issuer) != 0
        return -13

    # Validity
    if x509_parse_validity(@tbs_parser, @cert.validity) != 0
        return -14

    # Subject
    if x509_parse_name(@tbs_parser, @cert.subject) != 0
        return -15

    # Subject Public Key Info
    if x509_parse_public_key(@tbs_parser, @cert.public_key) != 0
        return -16

    # Unique IDs and extensions. Fail closed: an extension we cannot parse
    # could be the subjectAltName or a constraint.
    if x509_parse_tbs_tail(@tbs_parser, cert) != 0
        return -20

    # Signature Algorithm (outer)
    var outer_alg: u8 = x509_parse_sig_algorithm(@cert_parser)
    # Should match inner algorithm
    if outer_alg != cert.sig_algorithm
        if outer_alg != SIG_ALG_UNKNOWN
            if cert.sig_algorithm != SIG_ALG_UNKNOWN
                return -17

    # Signature Value
    var sig_bits: DerElement
    if der_parse_element(@cert_parser, @sig_bits) != 0
        return -18

    var sig_data: *u8 = null
    var sig_len: u64 = 0
    var unused: u8 = 0

    if der_bit_string_content(@sig_bits, @sig_data, @sig_len, @unused) != 0
        return -19

    if sig_len > 512
        sig_len = 512
    mem_copy(@cert.signature[0], sig_data, sig_len)
    cert.signature_len = sig_len

    return 0

# ============================================================================
# Certificate Validation Helpers
# ============================================================================

# Check if certificate is currently valid (time-wise)
pub fn x509_is_valid_time(cert: *X509Certificate, current_time: i64) -> i32
    if current_time < cert.validity.not_before
        return 0
    if current_time > cert.validity.not_after
        return 0
    return 1

# Check if issuer matches subject (for chain validation)
pub fn x509_is_issued_by(cert: *X509Certificate, issuer: *X509Certificate) -> i32
    return x509_name_equals(@cert.issuer, @issuer.subject)

# Check if certificate is self-signed
pub fn x509_is_self_signed(cert: *X509Certificate) -> i32
    return x509_name_equals(@cert.issuer, @cert.subject)
