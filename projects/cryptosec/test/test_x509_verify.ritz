# Load only the DER (to patch it before parsing). Returns its length, or -1.
fn fx_der(f: *Fx, pem: *u8) -> i64
    var der_len: i64 = 0
    if pem_parse_certificate(pem, fx_cstr_len(pem), @f.der[0], 2048, @der_len) != 1
        return -1
    return der_len

# Offset of the first occurrence of `pat` in f.der[0..len), or -1.
fn fx_find(f: *Fx, len: i64, pat: *u8, plen: i64) -> i64
    var i: i64 = 0
    while i + plen <= len
        var k: i64 = 0
        while k < plen && f.der[i + k] == pat[k]
            k += 1
        if k == plen
            return i
        i += 1
    return -1

# The #2109 leaf's extensions start with basicConstraints (CA:FALSE, critical)
# followed by the subjectAltName:
#   30 0c 06 03 55 1d 13 01 01 ff 04 02 30 00   basicConstraints
#   30 22 06 03 55 1d 11 04 1b 30 19 ...        subjectAltName
fn fx_find_bc(f: *Fx, len: i64) -> i64
    var pat: [7]u8
    pat[0] = 0x30
    pat[1] = 0x0c
    pat[2] = 0x06
    pat[3] = 0x03
    pat[4] = 0x55
    pat[5] = 0x1d
    pat[6] = 0x13
    return fx_find(f, len, @pat[0], 7)

fn fx_find_san(f: *Fx, len: i64) -> i64
    var pat: [7]u8
    pat[0] = 0x30
    pat[1] = 0x22
    pat[2] = 0x06
    pat[3] = 0x03
    pat[4] = 0x55
    pat[5] = 0x1d
    pat[6] = 0x11
    return fx_find(f, len, @pat[0], 7)

# --- Parsing records the extensions ----------------------------------------

[[test]]
fn test_x509_parse_records_usage_constraints() -> i32
    var leaf: Fx
    var root: Fx
    var ipl0: Fx
    var inc: Fx
    var anyk: Fx
    if fx_load(@leaf, p14_leaf()) != 0 || fx_load(@root, p14_root()) != 0 || fx_load(@ipl0, p14_ipl0()) != 0
        return 1
    if fx_load(@inc, p14_inc()) != 0 || fx_load(@anyk, p14_leaf_eku_any()) != 0
        return 2
    if leaf.cert.has_key_usage != 1 || leaf.cert.key_usage != KU_DIGITAL_SIGNATURE
        return 3
    if leaf.cert.has_ext_key_usage != 1 || leaf.cert.ext_key_usage != EKU_SERVER_AUTH
        return 4
    if anyk.cert.ext_key_usage != EKU_ANY
        return 5
    if root.cert.key_usage != (KU_KEY_CERT_SIGN | KU_CRL_SIGN)
        return 6
    if root.cert.has_path_len != 0 || ipl0.cert.has_path_len != 1 || ipl0.cert.path_len != 0
        return 7
    if inc.cert.has_name_constraints != 1 || inc.cert.nc_len == 0 || root.cert.has_name_constraints != 0
        return 8
    if leaf.cert.unknown_critical != 0
        return 9
    return 0

[[test]]
fn test_x509_parse_flags_unknown_critical() -> i32
    var crit: Fx
    var noncrit: Fx
    if fx_load(@crit, p14_leaf_crit()) != 0 || fx_load(@noncrit, p14_leaf_noncrit()) != 0
        return 1
    if crit.cert.unknown_critical != 1
        return 2
    if noncrit.cert.unknown_critical != 0
        return 3
    return 0

# --- Fail-closed parsing ---------------------------------------------------

[[test]]
fn test_x509_parse_rejects_malformed_extension() -> i32
    # A broken extension ahead of the SAN used to stop extension parsing
    # silently: has_san stayed 0 and the hostname fell back to the CN.
    var f: Fx
    let n: i64 = fx_der(@f, pem_leaf())
    if n <= 0
        return 1
    if x509_parse_certificate(@f.der[0], n as u64, @f.cert) != 0
        return 2  # control: the unpatched certificate parses
    let at: i64 = fx_find_bc(@f, n)
    if at < 0
        return 3
    f.der[at + 1] = 0x7f  # extension length now runs past its parent
    if x509_parse_certificate(@f.der[0], n as u64, @f.cert) == 0
        return 4
    return 0

[[test]]
fn test_x509_parse_rejects_malformed_extension_value() -> i32
    # subjectAltName whose GeneralNames is a SET, not a SEQUENCE.
    var f: Fx
    let n: i64 = fx_der(@f, pem_leaf())
    let at: i64 = fx_find_san(@f, n)
    if n <= 0 || at < 0
        return 1
    f.der[at + 9] = 0x31
    if x509_parse_certificate(@f.der[0], n as u64, @f.cert) == 0
        return 2
    return 0

[[test]]
fn test_x509_parse_rejects_duplicate_extension() -> i32
    # Rewrite the basicConstraints OID to subjectAltName: its value (an empty
    # SEQUENCE) is a well-formed GeneralNames, so only the duplicate is wrong.
    var f: Fx
    let n: i64 = fx_der(@f, pem_leaf())
    let at: i64 = fx_find_bc(@f, n)
    if n <= 0 || at < 0
        return 1
    f.der[at + 6] = 0x11
    if x509_parse_certificate(@f.der[0], n as u64, @f.cert) == 0
        return 2
    return 0

[[test]]
fn test_x509_pubkey_rsa4096_not_truncated() -> i32
    var f: Fx
    if fx_load(@f, p14_rsa4096()) != 0
        return 1
    if f.cert.public_key.algorithm != PUBKEY_TYPE_RSA || f.cert.public_key.key_len != 526
        return 2
    # The whole RSAPublicKey is there, down to its last field, the exponent:
    # ... 02 03 01 00 01.
    let k: *u8 = @f.cert.public_key.key_data[0]
    if k[521] != 0x02 || k[522] != 0x03 || k[523] != 0x01 || k[524] != 0x00 || k[525] != 0x01
        return 3
    # ... and it is usable: the RSA-4096 self-signature verifies (AGAST #2134).
    if f.cert.signature_len != 512
        return 4
    if x509_verify_signature(@f.cert, @f.cert.public_key) != 1
        return 5
    return 0

[[test]]
fn test_x509_rsa4096_tampered_rejected() -> i32
    # Control first, then a flipped TBS byte, then a flipped signature byte.
    var f: Fx
    if fx_load(@f, p14_rsa4096()) != 0
        return 1
    if x509_verify_signature(@f.cert, @f.cert.public_key) != 1
        return 2
    fx_tamper_tbs(@f)
    if x509_verify_signature(@f.cert, @f.cert.public_key) != 0
        return 3
    if fx_load(@f, p14_rsa4096()) != 0
        return 4
    f.cert.signature[300] = f.cert.signature[300] ^ 0x40
    if x509_verify_signature(@f.cert, @f.cert.public_key) != 0
        return 5
    return 0

[[test]]
fn test_x509_pubkey_oversized_rejected() -> i32
    # SubjectPublicKeyInfo (rsaEncryption) whose key BIT STRING holds 700
    # bytes, more than X509PublicKey can hold: refused, not truncated.
    var buf: [800]u8
    mem_zero(@buf[0], 800)
    buf[0] = 0x30
    buf[1] = 0x82
    buf[2] = 0x02
    buf[3] = 0xd0  # 15 + 4 + 701 = 720
    buf[4] = 0x30
    buf[5] = 0x0d
    buf[6] = 0x06
    buf[7] = 0x09
    buf[8] = 0x2a
    buf[9] = 0x86
    buf[10] = 0x48
    buf[11] = 0x86
    buf[12] = 0xf7
    buf[13] = 0x0d
    buf[14] = 0x01
    buf[15] = 0x01
    buf[16] = 0x01
    buf[17] = 0x05
    buf[18] = 0x00
    buf[19] = 0x03
    buf[20] = 0x82
    buf[21] = 0x02
    buf[22] = 0xbd  # 701 = unused-bits byte + 700
    buf[23] = 0x00
    var p: DerParser
    der_parser_init(@p, @buf[0], 724)
    var pk: X509PublicKey
    if x509_parse_public_key(@p, @pk) == 0
        return 1
    return 0

[[test]]
fn test_x509_cn_64_bytes_not_truncated() -> i32
    # 64 bytes is the RFC 5280 upper bound for a CN. Truncating it to 63 made
    # the cert match a hostname it does not name.
    var f: Fx
    if fx_load(@f, p14_leaf_cn64()) != 0
        return 1
    if host_ok(@f, c"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.valet.test") != 1
        return 2
    if host_ok(@f, c"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.valet.tes") != 0
        return 3
    return 0

[[test]]
fn test_x509_cn_overlong_never_matches() -> i32
    # Name ::= SEQUENCE { SET { SEQUENCE { 2.5.4.3, UTF8String(70) } } }
    # with CN = 59 x 'a' + ".valet.test". Longer than any buffer: the CN is
    # unusable as a hostname, whole or in part.
    var buf: [96]u8
    buf[0] = 0x30
    buf[1] = 81
    buf[2] = 0x31
    buf[3] = 79
    buf[4] = 0x30
    buf[5] = 77
    buf[6] = 0x06
    buf[7] = 0x03
    buf[8] = 0x55
    buf[9] = 0x04
    buf[10] = 0x03
    buf[11] = 0x0c
    buf[12] = 70
    var i: i32 = 0
    while i < 59
        buf[13 + i] = 0x61
        i += 1
    let tail = ".valet.test"
    mem_copy(@buf[72], tail.ptr, 11)
    var p: DerParser
    der_parser_init(@p, @buf[0], 83)
    var cert: X509Certificate
    mem_zero(@cert as *u8, sizeof(X509Certificate))
    if x509_parse_name(@p, @cert.subject) != 0
        return 1
    if x509_verify_hostname(@cert, @buf[13], 70) != 0
        return 2
    if x509_verify_hostname(@cert, @buf[13], 63) != 0
        return 3
    if x509_verify_hostname(@cert, @buf[13], 64) != 0
        return 4
    return 0

# --- Chain: keyUsage keyCertSign on issuers ---------------------------------

[[test]]
fn test_chain_2114_control() -> i32
    # A chain with keyUsage and EKU everywhere that is correct.
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inter, p14_inter()) != 0 || fx_load(@leaf, p14_leaf()) != 0
        return 1
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 2
    return 0

[[test]]
fn test_chain_issuer_needs_key_cert_sign() -> i32
    var root: Fx
    var ica: Fx
    var leaf: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@ica, p14_inocs()) != 0 || fx_load(@leaf, p14_leaf_via_inocs()) != 0
        return 1
    if ica.cert.is_ca != 1 || x509_verify_signature(@leaf.cert, @ica.cert.public_key) != 1
        return 2  # control: only keyUsage is wrong
    if chain_ok(@leaf, @ica, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    return 0

[[test]]
fn test_chain_anchor_needs_key_cert_sign() -> i32
    var anchor: Fx
    var leaf: Fx
    if fx_load(@anchor, p14_rnocs()) != 0 || fx_load(@leaf, p14_leaf_via_rnocs()) != 0
        return 1
    if x509_verify_signature(@leaf.cert, @anchor.cert.public_key) != 1
        return 2
    if chain_ok(@leaf, null, null, @anchor, null, c"valet.test", FX_NOW) != 0
        return 3
    return 0

# --- TLS server leaf: digitalSignature, serverAuth --------------------------

[[test]]
fn test_leaf_needs_digital_signature() -> i32
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inter, p14_inter()) != 0 || fx_load(@leaf, p14_leaf_ku_ke()) != 0
        return 1
    var chain: [2]*X509Certificate
    chain[0] = @leaf.cert
    chain[1] = @inter.cert
    var anchors: [1]*X509Certificate
    anchors[0] = @root.cert
    if x509_verify_chain_at_time(@chain[0], 2, @anchors[0], 1, FX_NOW) != 1
        return 2  # control: the chain itself is fine
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    return 0

[[test]]
fn test_leaf_needs_server_auth() -> i32
    var root: Fx
    var inter: Fx
    var client: Fx
    var anyk: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inter, p14_inter()) != 0
        return 1
    if fx_load(@client, p14_leaf_eku_client()) != 0 || fx_load(@anyk, p14_leaf_eku_any()) != 0
        return 2
    if chain_ok(@client, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    if chain_ok(@anyk, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 4
    return 0

# --- pathLenConstraint ------------------------------------------------------

[[test]]
fn test_chain_path_len_constraint() -> i32
    var root: Fx
    var ipl0: Fx
    var isub: Fx
    var direct: Fx
    var deep: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@ipl0, p14_ipl0()) != 0 || fx_load(@isub, p14_isub()) != 0
        return 1
    if fx_load(@direct, p14_leaf_via_ipl0()) != 0 || fx_load(@deep, p14_leaf_via_isub()) != 0
        return 2
    # pathlen:0 may issue a leaf ...
    if chain_ok(@direct, @ipl0, null, @root, null, c"valet.test", FX_NOW) != 1
        return 3
    # ... but no CA below it.
    if chain_ok(@deep, @isub, @ipl0, @root, null, c"valet.test", FX_NOW) != 0
        return 4
    # The anchor's own pathLenConstraint counts too.
    if chain_ok(@deep, @isub, null, @ipl0, null, c"valet.test", FX_NOW) != 0
        return 5
    # Control: anchored at isub there is no constrained CA on the path.
    if chain_ok(@deep, null, null, @isub, null, c"valet.test", FX_NOW) != 1
        return 6
    return 0

# --- nameConstraints (dNSName) ----------------------------------------------

[[test]]
fn test_dns_in_subtree() -> i32
    # RFC 5280 4.2.1.10: "host.example.com" covers itself and its subdomains;
    # ".example.com" covers subdomains only; the empty base covers everything.
    if x509_dns_in_subtree(c"valet.test", 10, c"valet.test", 10) != 1
        return 1
    if x509_dns_in_subtree(c"API.Valet.Test", 14, c"valet.test", 10) != 1
        return 2
    if x509_dns_in_subtree(c"evilvalet.test", 14, c"valet.test", 10) != 0
        return 3
    if x509_dns_in_subtree(c"valet.test", 10, c".valet.test", 11) != 0
        return 4
    if x509_dns_in_subtree(c"a.valet.test", 12, c".valet.test", 11) != 1
        return 5
    if x509_dns_in_subtree(c"anything", 8, c"", 0) != 1
        return 6
    if x509_dns_in_subtree(c"test", 4, c"valet.test", 10) != 0
        return 7
    return 0

[[test]]
fn test_chain_name_constraints_permitted() -> i32
    var root: Fx
    var inc: Fx
    var ok: Fx
    var out: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inc, p14_inc()) != 0
        return 1
    if fx_load(@ok, p14_leaf_nc_ok()) != 0 || fx_load(@out, p14_leaf_nc_out()) != 0
        return 2
    if chain_ok(@ok, @inc, null, @root, null, c"api.valet.test", FX_NOW) != 1
        return 3
    # One SAN outside the permitted subtree spoils the certificate, even for
    # a hostname that is inside it.
    if chain_ok(@out, @inc, null, @root, null, c"valet.test", FX_NOW) != 0
        return 4
    # The anchor's constraints apply too.
    if chain_ok(@out, null, null, @inc, null, c"valet.test", FX_NOW) != 0
        return 5
    return 0

[[test]]
fn test_chain_name_constraints_excluded() -> i32
    var root: Fx
    var inc: Fx
    var excl: Fx
    var wild: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inc, p14_inc()) != 0
        return 1
    if fx_load(@excl, p14_leaf_nc_excl()) != 0 || fx_load(@wild, p14_leaf_nc_wild()) != 0
        return 2
    if chain_ok(@excl, @inc, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    # *.valet.test would cover the excluded bad.valet.test.
    if chain_ok(@wild, @inc, null, @root, null, c"valet.test", FX_NOW) != 0
        return 4
    return 0

[[test]]
fn test_chain_name_constraints_apply_to_cn_without_san() -> i32
    # Without a SAN the leaf CN is its hostname, so it is constrained too.
    var root: Fx
    var inc: Fx
    var bad: Fx
    var good: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inc, p14_inc()) != 0
        return 1
    if fx_load(@bad, p14_leaf_nc_cn()) != 0 || fx_load(@good, p14_leaf_nc_cn_ok()) != 0
        return 2
    if chain_ok(@bad, @inc, null, @root, null, c"evil.test", FX_NOW) != 0
        return 3
    if chain_ok(@good, @inc, null, @root, null, c"www.valet.test", FX_NOW) != 1
        return 4
    return 0

[[test]]
fn test_chain_name_constraints_unsupported_type() -> i32
    # iPAddress constraints are not implemented: refuse rather than ignore.
    var root: Fx
    var ica: Fx
    var leaf: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@ica, p14_incip()) != 0 || fx_load(@leaf, p14_leaf_via_incip()) != 0
        return 1
    if chain_ok(@leaf, @ica, null, @root, null, c"valet.test", FX_NOW) != 0
        return 2
    return 0

# --- Unknown critical extensions (RFC 5280 4.2) ------------------------------

[[test]]
fn test_chain_rejects_unknown_critical_leaf() -> i32
    var root: Fx
    var inter: Fx
    var crit: Fx
    var noncrit: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@inter, p14_inter()) != 0
        return 1
    if fx_load(@crit, p14_leaf_crit()) != 0 || fx_load(@noncrit, p14_leaf_noncrit()) != 0
        return 2
    if chain_ok(@crit, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    if chain_ok(@noncrit, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 4
    return 0

[[test]]
fn test_chain_rejects_unknown_critical_intermediate() -> i32
    var root: Fx
    var ica: Fx
    var leaf: Fx
    if fx_load(@root, p14_root()) != 0 || fx_load(@ica, p14_icrit()) != 0 || fx_load(@leaf, p14_leaf_via_icrit()) != 0
        return 1
    if x509_verify_signature(@leaf.cert, @ica.cert.public_key) != 1
        return 2
    if chain_ok(@leaf, @ica, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    return 0
