const FX_NOT_BEFORE: i64 = 1767225600   # 2026-01-01T00:00:00Z
const FX_NOT_AFTER: i64 = 4922899200    # 2126-01-01T00:00:00Z
const FX_NOW: i64 = 1790000000          # 2026-09-21, inside every validity

fn fx_cstr_len(s: *u8) -> i64
    var n: i64 = 0
    while s[n] != 0
        n = n + 1
    return n

# A parsed certificate together with the DER it points into.
struct Fx
    der: [2048]u8
    cert: X509Certificate

fn fx_load(f: *Fx, pem: *u8) -> i32
    var der_len: i64 = 0
    if pem_parse_certificate(pem, fx_cstr_len(pem), @f.der[0], 2048, @der_len) != 1
        return -1
    if x509_parse_certificate(@f.der[0], der_len as u64, @f.cert) != 0
        return -2
    return 0

# Flip one byte inside the to-be-signed bytes (the parsed fields keep their
# values; only the signed bytes change).
fn fx_tamper_tbs(f: *Fx)
    let p: *u8 = f.cert.tbs_data
    p[f.cert.tbs_len - 20] = p[f.cert.tbs_len - 20] ^ 0x01

fn host_ok(f: *Fx, host: *u8) -> i32
    return x509_verify_hostname(@f.cert, host, fx_cstr_len(host) as i32)

# ============================================================================
# Certificate signatures: ECDSA-SHA256/384 and Ed25519 (REVIEW L-4)
# ============================================================================

[[test]]
fn test_x509_sig_ecdsa_sha256() -> i32
    var root: Fx
    var imp: Fx
    var inter: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@imp, pem_impostor_root()) != 0 || fx_load(@inter, pem_inter()) != 0
        return 1
    if inter.cert.sig_algorithm != SIG_ALG_ECDSA_SHA256
        return 2
    if x509_verify_signature(@inter.cert, @root.cert.public_key) != 1
        return 3
    # Same issuer name, different key: must not verify.
    if x509_verify_signature(@inter.cert, @imp.cert.public_key) != 0
        return 4
    fx_tamper_tbs(@inter)
    if x509_verify_signature(@inter.cert, @root.cert.public_key) != 0
        return 5
    return 0

[[test]]
fn test_x509_sig_ecdsa_sha384() -> i32
    var inter: Fx
    var leaf: Fx
    if fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf_sha384()) != 0
        return 1
    if leaf.cert.sig_algorithm != SIG_ALG_ECDSA_SHA384
        return 2
    if x509_verify_signature(@leaf.cert, @inter.cert.public_key) != 1
        return 3
    fx_tamper_tbs(@leaf)
    if x509_verify_signature(@leaf.cert, @inter.cert.public_key) != 0
        return 4
    return 0

[[test]]
fn test_x509_sig_ed25519() -> i32
    var root: Fx
    var leaf: Fx
    var inter: Fx
    if fx_load(@root, pem_root_ed25519()) != 0 || fx_load(@leaf, pem_leaf_ed25519()) != 0 || fx_load(@inter, pem_inter()) != 0
        return 1
    if leaf.cert.sig_algorithm != SIG_ALG_ED25519 || root.cert.public_key.algorithm != PUBKEY_TYPE_ED25519
        return 2
    if x509_verify_signature(@leaf.cert, @root.cert.public_key) != 1
        return 3
    # An EC key cannot check an Ed25519 signature.
    if x509_verify_signature(@leaf.cert, @inter.cert.public_key) != 0
        return 4
    # A truncated signature is refused, not read past.
    leaf.cert.signature_len = 63
    if x509_verify_signature(@leaf.cert, @root.cert.public_key) != 0
        return 5
    leaf.cert.signature_len = 64
    fx_tamper_tbs(@leaf)
    if x509_verify_signature(@leaf.cert, @root.cert.public_key) != 0
        return 6
    return 0

[[test]]
fn test_x509_sig_ecdsa_rejects_ed25519_key() -> i32
    # An ECDSA-signed certificate checked against an Ed25519 key.
    var inter: Fx
    var ed: Fx
    if fx_load(@inter, pem_inter()) != 0 || fx_load(@ed, pem_root_ed25519()) != 0
        return 1
    if x509_verify_signature(@inter.cert, @ed.cert.public_key) != 0
        return 2
    return 0

# ============================================================================
# Hostname: SubjectAltName dNSName (REVIEW M-9)
# ============================================================================

# ============================================================================
# ECDSA under P-384 issuer keys (AGAST #2115)
# ============================================================================

[[test]]
fn test_x509_sig_ecdsa_p384_real_isrg_x2() -> i32
    var x2: Fx
    var e5: Fx
    var e6: Fx
    if fx_load(@x2, pem_isrg_root_x2()) != 0 || fx_load(@e5, pem_le_e5()) != 0 || fx_load(@e6, pem_le_e6()) != 0
        return 1
    if x2.cert.public_key.curve != EC_CURVE_P384 || e5.cert.sig_algorithm != SIG_ALG_ECDSA_SHA384
        return 2
    # ISRG Root X2 is self-signed
    if x509_verify_signature(@x2.cert, @x2.cert.public_key) != 1
        return 3
    if x509_verify_signature(@e5.cert, @x2.cert.public_key) != 1
        return 4
    if x509_verify_signature(@e6.cert, @x2.cert.public_key) != 1
        return 5
    # A sibling's key (E6 is also P-384) does not verify E5
    if x509_verify_signature(@e5.cert, @e6.cert.public_key) != 0
        return 6
    fx_tamper_tbs(@e5)
    if x509_verify_signature(@e5.cert, @x2.cert.public_key) != 0
        return 7
    return 0

[[test]]
fn test_x509_sig_ecdsa_p384_generated() -> i32
    var root: Fx
    var imp: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_p384_root()) != 0 || fx_load(@imp, pem_p384_impostor_root()) != 0
        return 1
    if fx_load(@inter, pem_p384_inter()) != 0 || fx_load(@leaf, pem_p384_leaf_sha256()) != 0
        return 2
    if x509_verify_signature(@inter.cert, @root.cert.public_key) != 1
        return 3
    if x509_verify_signature(@inter.cert, @imp.cert.public_key) != 0
        return 4
    # ecdsa-with-SHA256 under a P-384 key: the 256-bit digest is used whole
    if leaf.cert.sig_algorithm != SIG_ALG_ECDSA_SHA256
        return 5
    if x509_verify_signature(@leaf.cert, @inter.cert.public_key) != 1
        return 6
    fx_tamper_tbs(@leaf)
    if x509_verify_signature(@leaf.cert, @inter.cert.public_key) != 0
        return 7
    return 0

[[test]]
fn test_x509_sig_ecdsa_curve_mismatch() -> i32
    # A P-256 signature checked under a P-384 key and vice versa
    var root256: Fx
    var inter256: Fx
    var x2: Fx
    var e5: Fx
    if fx_load(@root256, pem_root()) != 0 || fx_load(@inter256, pem_inter()) != 0
        return 1
    if fx_load(@x2, pem_isrg_root_x2()) != 0 || fx_load(@e5, pem_le_e5()) != 0
        return 2
    if x509_verify_signature(@inter256.cert, @x2.cert.public_key) != 0
        return 3
    if x509_verify_signature(@e5.cert, @root256.cert.public_key) != 0
        return 4
    # A P-384-labelled key whose bytes are not a P-384 point is refused
    var bad: X509PublicKey
    mem_copy(@bad as *u8, @x2.cert.public_key as *u8, sizeof(X509PublicKey) as i64)
    bad.key_data[96] = bad.key_data[96] ^ 0x01
    if x509_verify_signature(@e5.cert, @bad) != 0
        return 5
    bad.key_data[96] = bad.key_data[96] ^ 0x01
    bad.key_len = 65
    if x509_verify_signature(@e5.cert, @bad) != 0
        return 6
    return 0

[[test]]
fn test_x509_parse_records_san() -> i32
    var leaf: Fx
    var cn_only: Fx
    if fx_load(@leaf, pem_leaf()) != 0 || fx_load(@cn_only, pem_leaf_cn_only()) != 0
        return 1
    if leaf.cert.has_san != 1 || leaf.cert.san_len == 0
        return 2
    if cn_only.cert.has_san != 0
        return 3
    return 0

[[test]]
fn test_x509_hostname_matches_san_dns() -> i32
    # CN is "Ritz Leaf": only the SAN can make these match.
    var leaf: Fx
    if fx_load(@leaf, pem_leaf()) != 0
        return 1
    if host_ok(@leaf, c"valet.test") != 1
        return 2
    if host_ok(@leaf, c"VALET.Test") != 1
        return 3
    if host_ok(@leaf, c"api.wild.test") != 1
        return 4
    if host_ok(@leaf, c"wild.test") != 0
        return 5
    if host_ok(@leaf, c"a.b.wild.test") != 0
        return 6
    if host_ok(@leaf, c"evil.test") != 0
        return 7
    if host_ok(@leaf, c"valet.test.evil") != 0
        return 8
    return 0

[[test]]
fn test_x509_hostname_san_overrides_cn() -> i32
    # With a SAN present the CN is not a hostname (RFC 6125 6.4.4).
    var leaf: Fx
    if fx_load(@leaf, pem_leaf_san_other()) != 0
        return 1
    if host_ok(@leaf, c"other.test") != 1
        return 2
    if host_ok(@leaf, c"valet.test") != 0
        return 3
    return 0

[[test]]
fn test_x509_hostname_cn_without_san() -> i32
    var leaf: Fx
    if fx_load(@leaf, pem_leaf_cn_only()) != 0
        return 1
    if host_ok(@leaf, c"valet.test") != 1
        return 2
    if host_ok(@leaf, c"other.test") != 0
        return 3
    return 0

# ============================================================================
# Chain validation against trust anchors (+ validity)
# ============================================================================

# x509_verify_server_cert for up to three certs and up to two anchors.
fn chain_ok(c0: *Fx, c1: *Fx, c2: *Fx, a0: *Fx, a1: *Fx, host: *u8, now: i64) -> i32
    var chain: [3]*X509Certificate
    var n: i32 = 0
    if c0 != null
        chain[n] = @c0.cert
        n += 1
    if c1 != null
        chain[n] = @c1.cert
        n += 1
    if c2 != null
        chain[n] = @c2.cert
        n += 1
    var anchors: [2]*X509Certificate
    var m: i32 = 0
    if a0 != null
        anchors[m] = @a0.cert
        m += 1
    if a1 != null
        anchors[m] = @a1.cert
        m += 1
    if m == 0
        return x509_verify_server_cert(@chain[0], n, host, fx_cstr_len(host) as i32, now, null, 0)
    return x509_verify_server_cert(@chain[0], n, host, fx_cstr_len(host) as i32, now, @anchors[0], m)

[[test]]
fn test_chain_leaf_inter_root() -> i32
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 2
    # The server may also send the root itself.
    if chain_ok(@leaf, @inter, @root, @root, null, c"valet.test", FX_NOW) != 1
        return 3
    # Hostname is still checked on a good chain.
    if chain_ok(@leaf, @inter, null, @root, null, c"evil.test", FX_NOW) != 0
        return 4
    return 0

[[test]]
fn test_chain_sha384_and_ed25519() -> i32
    var root: Fx
    var inter: Fx
    var leaf384: Fx
    var root_ed: Fx
    var leaf_ed: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf384, pem_leaf_sha384()) != 0
        return 1
    if fx_load(@root_ed, pem_root_ed25519()) != 0 || fx_load(@leaf_ed, pem_leaf_ed25519()) != 0
        return 2
    if chain_ok(@leaf384, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 3
    if chain_ok(@leaf_ed, null, null, @root_ed, null, c"valet.test", FX_NOW) != 1
        return 4
    # Anchors are matched per chain: the EC root does not vouch for leaf_ed.
    if chain_ok(@leaf_ed, null, null, @root, null, c"valet.test", FX_NOW) != 0
        return 5
    if chain_ok(@leaf_ed, null, null, @root, @root_ed, c"valet.test", FX_NOW) != 1
        return 6
    return 0

[[test]]
fn test_chain_p384_leaf_inter_root() -> i32
    var root: Fx
    var imp: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_p384_root()) != 0 || fx_load(@imp, pem_p384_impostor_root()) != 0
        return 1
    if fx_load(@inter, pem_p384_inter()) != 0 || fx_load(@leaf, pem_p384_leaf_sha256()) != 0
        return 2
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 3
    if chain_ok(@leaf, @inter, null, @imp, null, c"valet.test", FX_NOW) != 0
        return 4
    if chain_ok(@leaf, @inter, null, @root, null, c"evil.test", FX_NOW) != 0
        return 5
    return 0

[[test]]
fn test_chain_real_le_e5_to_isrg_x2() -> i32
    # Let's Encrypt E5 chains to the ISRG Root X2 anchor (no leaf: the
    # chain check alone, inside E5's validity).
    var x2: Fx
    var e5: Fx
    var root256: Fx
    if fx_load(@x2, pem_isrg_root_x2()) != 0 || fx_load(@e5, pem_le_e5()) != 0 || fx_load(@root256, pem_root()) != 0
        return 1
    var chain: [1]*X509Certificate
    chain[0] = @e5.cert
    var anchors: [1]*X509Certificate
    anchors[0] = @x2.cert
    if x509_verify_chain_at_time(@chain[0], 1, @anchors[0], 1, FX_NOW) != 1
        return 2
    # After E5 expires (2027-03-12)
    if x509_verify_chain_at_time(@chain[0], 1, @anchors[0], 1, 1900000000) != 0
        return 3
    anchors[0] = @root256.cert
    if x509_verify_chain_at_time(@chain[0], 1, @anchors[0], 1, FX_NOW) != 0
        return 4
    return 0

[[test]]
fn test_chain_refuses_impostor_root_with_same_name() -> i32
    # The old check trusted any root whose subject NAME was in the store.
    var root: Fx
    var imp: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@imp, pem_impostor_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    if chain_ok(@leaf, @inter, null, @imp, null, c"valet.test", FX_NOW) != 0
        return 2
    # ... even when the server also sends the real root alongside it.
    if chain_ok(@leaf, @inter, @root, @imp, null, c"valet.test", FX_NOW) != 0
        return 3
    return 0

[[test]]
fn test_chain_refuses_without_anchors() -> i32
    # No trust store means nothing is trusted: no trust-on-first-use, not even
    # for a self-signed CA that verifies under its own key.
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    if chain_ok(@leaf, @inter, @root, null, null, c"valet.test", FX_NOW) != 0
        return 2
    var chain: [1]*X509Certificate
    chain[0] = @root.cert
    if x509_verify_chain(@chain[0], 1, null, 0) != 0
        return 3
    return 0

[[test]]
fn test_chain_refuses_missing_intermediate() -> i32
    var root: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    if chain_ok(@leaf, null, null, @root, null, c"valet.test", FX_NOW) != 0
        return 2
    return 0

[[test]]
fn test_chain_refuses_non_ca_issuer() -> i32
    # pem_not_ca is correctly signed by the root but is not a CA.
    var root: Fx
    var not_ca: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@not_ca, pem_not_ca()) != 0 || fx_load(@leaf, pem_leaf_via_not_ca()) != 0
        return 1
    if not_ca.cert.is_ca != 0
        return 2
    if x509_verify_signature(@leaf.cert, @not_ca.cert.public_key) != 1
        return 3  # control: only the CA flag is wrong
    if chain_ok(@leaf, @not_ca, null, @root, null, c"valet.test", FX_NOW) != 0
        return 4
    # Nor may a non-CA certificate act as a trust anchor.
    if chain_ok(@leaf, null, null, @not_ca, null, c"valet.test", FX_NOW) != 0
        return 5
    return 0

[[test]]
fn test_chain_checks_validity_dates() -> i32
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    if leaf.cert.validity.not_before != FX_NOT_BEFORE || leaf.cert.validity.not_after != FX_NOT_AFTER
        return 2
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOT_BEFORE) != 1
        return 3
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOT_AFTER) != 1
        return 4
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOT_BEFORE - 1) != 0
        return 5
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOT_AFTER + 1) != 0
        return 6
    return 0

[[test]]
fn test_chain_checks_each_certs_validity() -> i32
    # Expire one certificate at a time (the parsed dates, not the signed
    # bytes, so every signature still verifies).
    var root: Fx
    var inter: Fx
    var leaf: Fx
    if fx_load(@root, pem_root()) != 0 || fx_load(@inter, pem_inter()) != 0 || fx_load(@leaf, pem_leaf()) != 0
        return 1
    leaf.cert.validity.not_after = FX_NOW - 1
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 2
    leaf.cert.validity.not_after = FX_NOT_AFTER
    inter.cert.validity.not_after = FX_NOW - 1
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 3
    inter.cert.validity.not_after = FX_NOT_AFTER
    root.cert.validity.not_before = FX_NOW + 1
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 0
        return 4
    root.cert.validity.not_before = FX_NOT_BEFORE
    if chain_ok(@leaf, @inter, null, @root, null, c"valet.test", FX_NOW) != 1
        return 5
    return 0

# ============================================================================
# AGAST #2114: keyUsage, extendedKeyUsage, pathLenConstraint, nameConstraints,
# unknown critical extensions, and fail-closed parsing
# ============================================================================
# Generated with openssl 3.5 for these tests only; the keys protect nothing.
# Validity as above (2026-01-01 .. 2126-01-01). Every non-root is issued by
# p14_root unless noted. CA = basicConstraints CA:TRUE + keyUsage
# keyCertSign,cRLSign; "leaf" = CA:FALSE + SAN DNS:valet.test.
#   p14_root            self-signed CA "CN=Ritz 2114 Root"
#   p14_inter           CA
#   p14_leaf            by inter, keyUsage digitalSignature, EKU serverAuth
#   p14_leaf_ku_ke      by inter, keyUsage keyEncipherment only
#   p14_leaf_eku_client by inter, EKU clientAuth only
#   p14_leaf_eku_any    by inter, EKU anyExtendedKeyUsage + clientAuth
#   p14_leaf_crit       by inter, critical private extension 1.3.6.1.4.1.55555.1
#   p14_leaf_noncrit    by inter, the same extension, non-critical
#   p14_leaf_cn64       by inter, no SAN, CN = 53 x 'a' + ".valet.test" (64 bytes)
#   p14_inocs           CA:TRUE but keyUsage digitalSignature (no keyCertSign)
#   p14_leaf_via_inocs  by inocs
#   p14_rnocs           self-signed CA:TRUE, keyUsage digitalSignature only
#   p14_leaf_via_rnocs  by rnocs
#   p14_ipl0            CA pathlen:0 (keyCertSign)
#   p14_isub            CA issued by ipl0
#   p14_leaf_via_ipl0   by ipl0
#   p14_leaf_via_isub   by isub
#   p14_inc             CA, nameConstraints permitted DNS:valet.test,
#                       excluded DNS:bad.valet.test
#   p14_leaf_nc_ok      by inc, SAN valet.test, api.valet.test
#   p14_leaf_nc_out     by inc, SAN valet.test, evil.test
#   p14_leaf_nc_excl    by inc, SAN valet.test, bad.valet.test
#   p14_leaf_nc_wild    by inc, SAN valet.test, *.valet.test
#   p14_leaf_nc_cn      by inc, no SAN, CN=evil.test
#   p14_leaf_nc_cn_ok   by inc, no SAN, CN=www.valet.test
#   p14_incip           CA, nameConstraints permitted IP:10.0.0.0/8
#   p14_leaf_via_incip  by incip
#   p14_icrit           CA with the critical private extension
#   p14_leaf_via_icrit  by icrit
#   p14_rsa4096         self-signed RSA-4096 CA (526-byte SPKI key)

