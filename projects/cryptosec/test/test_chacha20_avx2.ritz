    expected[15] = 0x81

    if bytes_equal(@ct[0], @expected[0], 16) == 0
        return 1
    return 0

# Test roundtrip encryption/decryption
[[test]]
fn test_chacha20_avx2_roundtrip() -> i32
    var key: [32]u8
    var nonce: [12]u8
    var pt: [64]u8
    var ct: [64]u8
    var decrypted: [64]u8

    var i: i64 = 0
    while i < 32
        key[i] = (i * 7) as u8
        i += 1

    i = 0
    while i < 12
        nonce[i] = (i * 13) as u8
        i += 1

    i = 0
    while i < 64
        pt[i] = (i * 3) as u8
        i += 1

    var ctx: ChaCha20Avx2
    chacha20_avx2_init(@ctx, @key[0], @nonce[0])
    if ok_bytes(chacha20_avx2_encrypt(@ctx, @pt[0], 64, @ct[0])) != 64
        return 92

    chacha20_avx2_init(@ctx, @key[0], @nonce[0])
    if ok_bytes(chacha20_avx2_decrypt(@ctx, @ct[0], 64, @decrypted[0])) != 64
        return 93

    if bytes_equal(@pt[0], @decrypted[0], 64) == 0
        return 1
    return 0

# Test partial block encryption
[[test]]
fn test_chacha20_avx2_partial_block() -> i32
    var key: [32]u8
    var nonce: [12]u8
    var pt: [37]u8  # Not a multiple of 64
    var ct: [37]u8
    var decrypted: [37]u8

    mem_zero(@key[0], 32)
    mem_zero(@nonce[0], 12)

    var i: i64 = 0
    while i < 37
        pt[i] = i as u8
        i += 1

    if ok_bytes(chacha20_avx2_xor(@key[0], @nonce[0], 0, @pt[0], 37, @ct[0])) != 37
        return 94
    if ok_bytes(chacha20_avx2_xor(@key[0], @nonce[0], 0, @ct[0], 37, @decrypted[0])) != 37
        return 95

    if bytes_equal(@pt[0], @decrypted[0], 37) == 0
        return 1
    return 0

# Verify full ciphertext matches between AVX2 and scalar
[[test]]
fn test_chacha20_avx2_full_ct_matches_scalar() -> i32
    var key: [32]u8
    var nonce: [12]u8
    var pt: [200]u8  # Test multi-block
    var ct_avx2: [200]u8
    var ct_scalar: [200]u8

    var i: i64 = 0
    while i < 32
        key[i] = (i * 11 + 7) as u8
        i += 1

    i = 0
    while i < 12
        nonce[i] = (i * 5 + 3) as u8
        i += 1

    i = 0
    while i < 200
        pt[i] = (i * 13 + 1) as u8
        i += 1

    # Encrypt with AVX2
    if ok_bytes(chacha20_avx2_xor(@key[0], @nonce[0], 0, @pt[0], 200, @ct_avx2[0])) != 200
        return 96

    # Encrypt with scalar
    if ok_bytes(chacha20_xor(@key[0], @nonce[0], 0, @pt[0], 200, @ct_scalar[0])) != 200
        return 97

    # Must match exactly
    if bytes_equal(@ct_avx2[0], @ct_scalar[0], 200) == 0
        return 1
    return 0

# =============================================================================
# Block counter exhaustion (AGAST #2577, GitHub #132, RFC 8439 §2.4)
#
# Same contract as the scalar implementation: block 0xFFFFFFFF is the last one;
# a call needing more refuses with Err(CounterExhausted) and writes nothing.
# =============================================================================

const SENTINEL: u8 = 0xAA

# Bytes processed by an Ok result, or -1 for Err.
fn ok_bytes(r: Result<i64, CryptoError>) -> i64
    match r
        Ok(n) => n
        Err(_) => -1

fn is_counter_exhausted(r: Result<i64, CryptoError>) -> bool
    match r
        Ok(_) => false
        Err(e) =>
            match e
                CryptoError.CounterExhausted => true
                _ => false

fn fill_sentinel(buf: *u8, len: i64) -> void
    var i: i64 = 0
    while i < len
        buf[i] = SENTINEL
        i += 1

# 1 if every byte of buf[0..len] is still SENTINEL.
fn untouched(buf: *u8, len: i64) -> i32
    var i: i64 = 0
    while i < len
        if buf[i] != SENTINEL
            return 0
        i += 1
    return 1

fn fill_key_nonce(key: *u8, nonce: *u8) -> void
    var i: i64 = 0
    while i < 32
        key[i] = (i * 9 + 1) as u8
        i += 1
    i = 0
    while i < 12
        nonce[i] = (i * 17 + 5) as u8
        i += 1

[[test]]
fn test_chacha20_avx2_xor_counter_boundary() -> i32
    var key: [32]u8
    var nonce: [12]u8
    fill_key_nonce(@key[0], @nonce[0])
    var pt: [128]u8
    mem_zero(@pt[0], 128)
    var out: [128]u8
    var expected: [64]u8
    chacha20_block(@key[0], 0xFFFFFFFF, @nonce[0], @expected[0])

    # The last block is allowed and matches the scalar keystream.
    if ok_bytes(chacha20_avx2_xor(@key[0], @nonce[0], 0xFFFFFFFF, @pt[0], 64, @out[0])) != 64
        return 1
    if bytes_equal(@out[0], @expected[0], 64) == 0
        return 2
    # One byte more would wrap to counter 0.
    fill_sentinel(@out[0], 128)
    if not is_counter_exhausted(chacha20_avx2_xor(@key[0], @nonce[0], 0xFFFFFFFF, @pt[0], 65, @out[0]))
        return 3
    if untouched(@out[0], 128) == 0
        return 4
    # 2^32 + 1 blocks from 0: refused before touching the (small) buffers.
    let len: i64 = 0x100000000 * 64 + 1
    if not is_counter_exhausted(chacha20_avx2_xor(@key[0], @nonce[0], 0, @pt[0], len, @out[0]))
        return 5
    if untouched(@out[0], 128) == 0
        return 6
    return 0

[[test]]
fn test_chacha20_avx2_ctx_no_wrap_after_last_block() -> i32
    var key: [32]u8
    var nonce: [12]u8
    fill_key_nonce(@key[0], @nonce[0])
    var pt: [128]u8
    mem_zero(@pt[0], 128)
    var out: [128]u8
    fill_sentinel(@out[0], 128)
    var expected: [64]u8
    chacha20_block(@key[0], 0xFFFFFFFF, @nonce[0], @expected[0])

    var ctx: ChaCha20Avx2
    chacha20_avx2_init(@ctx, @key[0], @nonce[0])
    chacha20_avx2_set_counter(@ctx, 0xFFFFFFFF)
    # Refusal leaves the counter where it was.
    if not is_counter_exhausted(chacha20_avx2_encrypt(@ctx, @pt[0], 65, @out[0]))
        return 1
    if untouched(@out[0], 128) == 0
        return 2
    if ok_bytes(chacha20_avx2_encrypt(@ctx, @pt[0], 64, @out[0])) != 64
        return 3
    if bytes_equal(@out[0], @expected[0], 64) == 0
        return 4
    # Now exhausted: must refuse, not wrap to counter 0.
    fill_sentinel(@out[0], 128)
    if not is_counter_exhausted(chacha20_avx2_encrypt(@ctx, @pt[0], 1, @out[0]))
        return 5
    if not is_counter_exhausted(chacha20_avx2_decrypt(@ctx, @pt[0], 1, @out[0]))
        return 6
    if untouched(@out[0], 128) == 0
        return 7
    if ok_bytes(chacha20_avx2_encrypt(@ctx, @pt[0], 0, @out[0])) != 0
        return 8
    return 0

# =============================================================================
# Secret wiping (AGAST #2770, GitHub #139)
# =============================================================================
# chacha20_block_avx2 holds the key in row1_init/row2_init and the keystream in
# state_out; neither may outlive the call. stack_holds_2770 reads the stack
# just below the caller's frame, where the callee's frames lived.

const RESIDUE_SPAN_2770: i64 = 32768

[[noinline]]
fn stack_holds_2770(pat: *u8, plen: i64) -> bool
    var buf: [32768]u8
    # Make buf escape so the reads below are real loads of what is there.
    let p: *u8 = @buf[0]
    asm x86_64:
        nopl ({p})
    var i: i64 = 0
    while i + plen <= RESIDUE_SPAN_2770
        var j: i64 = 0
        while j < plen and buf[i + j] == pat[j]
            j += 1
        if j == plen
            return true
        i += 1
    return false

# Zero the span stack_holds_2770 reads, so only later calls' residue is seen.
[[noinline]]
fn scrub_2770()
    var buf: [32768]u8
    mem_zero(@buf[0], RESIDUE_SPAN_2770)

# Is any aligned 4-byte word of the `len` secret bytes at sec left on the
# stack? Word-sized: the key is held as u32 lanes, not necessarily contiguous.
fn secret_left_2770(sec: *u8, len: i64) -> bool
    var i: i64 = 0
    while i + 4 <= len
        if stack_holds_2770(@sec[i], 4)
            return true
        i += 4
    return false

fn le32_2770(p: *u8) -> u32
    (p[0] as u32) | ((p[1] as u32) << 8) | ((p[2] as u32) << 16) | ((p[3] as u32) << 24)

fn put32_2770(p: *u8, v: u32)
    p[0] = (v & 0xff) as u8
    p[1] = ((v >> 8) & 0xff) as u8
    p[2] = ((v >> 16) & 0xff) as u8
    p[3] = ((v >> 24) & 0xff) as u8

# The working state after the 20 rounds, before the input is added back:
# keystream word i minus input word i. With the keystream it gives the key
# (key word = keystream word - this word), so it must not be left either.
fn final_rounds_2770(key: *u8, counter: u32, nonce: *u8, ks: *u8, dst: *u8)
    var init: [16]u32
    init[0] = 0x61707865
    init[1] = 0x3320646e
    init[2] = 0x79622d32
    init[3] = 0x6b206574
    for i in 0..8
        init[4 + i] = le32_2770(@key[i * 4])
    init[12] = counter
    for i in 0..3
        init[13 + i] = le32_2770(@nonce[i * 4])
    for i in 0..16
        put32_2770(@dst[i * 4], le32_2770(@ks[i * 4]) - init[i])

[[test]]
fn test_chacha20_avx2_block_wipes_key_and_keystream() -> i32
    var key: [32]u8
    var nonce: [12]u8
    fill_key_nonce(@key[0], @nonce[0])
    # Expected words, computed before the scrub: final_rounds_2770 leaves
    # them in its own frame, which the probe would then find.
    var out: [64]u8
    chacha20_block_avx2(@key[0], 1, @nonce[0], @out[0])
    var rounds: [64]u8
    final_rounds_2770(@key[0], 1, @nonce[0], @out[0], @rounds[0])
    scrub_2770()
    if secret_left_2770(@key[0], 32) or secret_left_2770(@rounds[0], 64)
        return 1  # residue before the call: the probe cannot tell
    chacha20_block_avx2(@key[0], 1, @nonce[0], @out[0])
    if secret_left_2770(@key[0], 32)
        return 2  # key left in row1_init/row2_init
    if secret_left_2770(@out[0], 64)
        return 3  # keystream left in state_out
    if secret_left_2770(@rounds[0], 64)
        return 4  # final working rows left in the rotation temporaries
    return 0

[[test]]
fn test_chacha20_avx2_xor_wipes_key_and_keystream() -> i32
    var key: [32]u8
    var nonce: [12]u8
    fill_key_nonce(@key[0], @nonce[0])
    # Three blocks, the last partial; with zero input the output is keystream.
    var pt: [130]u8
    mem_zero(@pt[0], 130)
    var last: [64]u8
    chacha20_block(@key[0], 9, @nonce[0], @last[0])
    var out: [130]u8
    scrub_2770()
    if ok_bytes(chacha20_avx2_xor(@key[0], @nonce[0], 7, @pt[0], 130, @out[0])) != 130
        return 1
    if secret_left_2770(@key[0], 32)
        return 2
    if secret_left_2770(@out[0], 128)
        return 3
    if secret_left_2770(@last[0], 64)
        return 4  # the partial block's unused keystream
    return 0

[[test]]
fn test_chacha20_avx2_ctx_encrypt_wipes_key_and_keystream() -> i32
    var key: [32]u8
    var nonce: [12]u8
    fill_key_nonce(@key[0], @nonce[0])
    var pt: [64]u8
    mem_zero(@pt[0], 64)
    var out: [64]u8
    var ctx: ChaCha20Avx2
    chacha20_avx2_init(@ctx, @key[0], @nonce[0])
    scrub_2770()
    if ok_bytes(chacha20_avx2_encrypt(@ctx, @pt[0], 64, @out[0])) != 64
        return 1
    if secret_left_2770(@key[0], 32)
        return 2
    if secret_left_2770(@out[0], 64)
        return 3
    return 0
