    expected_sig[25] = 0x73
    expected_sig[26] = 0xe0
    expected_sig[27] = 0x65
    expected_sig[28] = 0x22
    expected_sig[29] = 0x49
    expected_sig[30] = 0x01
    expected_sig[31] = 0x55
    expected_sig[32] = 0x5f
    expected_sig[33] = 0xb8
    expected_sig[34] = 0x82
    expected_sig[35] = 0x15
    expected_sig[36] = 0x90
    expected_sig[37] = 0xa3
    expected_sig[38] = 0x3b
    expected_sig[39] = 0xac
    expected_sig[40] = 0xc6
    expected_sig[41] = 0x1e
    expected_sig[42] = 0x39
    expected_sig[43] = 0x70
    expected_sig[44] = 0x1c
    expected_sig[45] = 0xf9
    expected_sig[46] = 0xb4
    expected_sig[47] = 0x6b
    expected_sig[48] = 0xd2
    expected_sig[49] = 0x5b
    expected_sig[50] = 0xf5
    expected_sig[51] = 0xf0
    expected_sig[52] = 0x59
    expected_sig[53] = 0x5b
    expected_sig[54] = 0xbe
    expected_sig[55] = 0x24
    expected_sig[56] = 0x65
    expected_sig[57] = 0x51
    expected_sig[58] = 0x41
    expected_sig[59] = 0x43
    expected_sig[60] = 0x8e
    expected_sig[61] = 0x7a
    expected_sig[62] = 0x10
    expected_sig[63] = 0x0b

    # Check R (first 32 bytes)
    if mem_eq(@sig[0], @expected_sig[0], 32) != 1
        # Debug: return 100 + first differing byte in R
        var i: i32 = 0
        while i < 32
            if sig[i] != expected_sig[i]
                return 100 + i
            i += 1
        return 1

    # Check s (second 32 bytes)
    if mem_eq(@sig[32], @expected_sig[32], 32) != 1
        # Debug: return 200 + first differing byte in s
        var i: i32 = 32
        while i < 64
            if sig[i] != expected_sig[i]
                return 200 + (i - 32)
            i += 1
        return 2

    return 0

