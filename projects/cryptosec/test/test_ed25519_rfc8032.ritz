# test/test_ed25519_rfc8032.ritz - Ed25519 RFC 8032 sign/verify vectors and tamper checks

import cryptosec.ed25519
import cryptosec.mem
import cryptosec.sha512
import cryptosec.x25519

# Debug: test SHA512(prefix) for RFC 8032 vector 1
# We need to verify what SHA512(hash[32:64]) produces
[[test]]
fn test_rfc8032_vector1_r_hash() -> i32
    var seed: [32]u8
    seed[0] = 0x9d
    seed[1] = 0x61
    seed[2] = 0xb1
    seed[3] = 0x9d
    seed[4] = 0xef
    seed[5] = 0xfd
    seed[6] = 0x5a
    seed[7] = 0x60
    seed[8] = 0xba
    seed[9] = 0x84
    seed[10] = 0x4a
    seed[11] = 0xf4
    seed[12] = 0x92
    seed[13] = 0xec
    seed[14] = 0x2c
    seed[15] = 0xc4
    seed[16] = 0x44
    seed[17] = 0x49
    seed[18] = 0xc5
    seed[19] = 0x69
    seed[20] = 0x7b
    seed[21] = 0x32
    seed[22] = 0x69
    seed[23] = 0x19
    seed[24] = 0x70
    seed[25] = 0x3b
    seed[26] = 0xac
    seed[27] = 0x03
    seed[28] = 0x1c
    seed[29] = 0xae
    seed[30] = 0x7f
    seed[31] = 0x60

    # hash = SHA512(seed)
    var hash: [64]u8
    sha512(@seed[0], 32, @hash[0])

    # r_hash = SHA512(prefix)  where prefix = hash[32:64]
    var r_hash: [64]u8
    sha512(@hash[32], 32, @r_hash[0])

    # For debugging, just check r_hash[0] is not zero
    if r_hash[0] == 0
        if r_hash[1] == 0
            return 1  # Unexpected all-zero start

    # Now reduce
    sc_reduce(@r_hash[0])

    # After reduction, compute R = r * B
    var R: Ge25519
    ge_scalarmult_base(@R, @r_hash[0])

    var R_bytes: [32]u8
    ge_tobytes(@R_bytes[0], @R)

    # Expected R
    var expected_R: [32]u8
    expected_R[0] = 0xe5
    expected_R[1] = 0x56
    expected_R[2] = 0x43
    expected_R[3] = 0x00
    expected_R[4] = 0xc3
    expected_R[5] = 0x60
    expected_R[6] = 0xac
    expected_R[7] = 0x72
    expected_R[8] = 0x90
    expected_R[9] = 0x86
    expected_R[10] = 0xe2
    expected_R[11] = 0xcc
    expected_R[12] = 0x80
    expected_R[13] = 0x6e
    expected_R[14] = 0x82
    expected_R[15] = 0x8a
    expected_R[16] = 0x84
    expected_R[17] = 0x87
    expected_R[18] = 0x7f
    expected_R[19] = 0x1e
    expected_R[20] = 0xb8
    expected_R[21] = 0xe5
    expected_R[22] = 0xd9
    expected_R[23] = 0x74
    expected_R[24] = 0xd8
    expected_R[25] = 0x73
    expected_R[26] = 0xe0
    expected_R[27] = 0x65
    expected_R[28] = 0x22
    expected_R[29] = 0x49
    expected_R[30] = 0x01
    expected_R[31] = 0x55

    if mem_eq(@R_bytes[0], @expected_R[0], 32) != 1
        var i: i32 = 0
        while i < 32
            if R_bytes[i] != expected_R[i]
                return 100 + i
            i += 1
        return 2

    return 0

# Test R computation for RFC 8032 vector 1
# Expected R: e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155
[[test]]
fn test_rfc8032_vector1_R_only() -> i32
    var seed: [32]u8
    seed[0] = 0x9d
    seed[1] = 0x61
    seed[2] = 0xb1
    seed[3] = 0x9d
    seed[4] = 0xef
    seed[5] = 0xfd
    seed[6] = 0x5a
    seed[7] = 0x60
    seed[8] = 0xba
    seed[9] = 0x84
    seed[10] = 0x4a
    seed[11] = 0xf4
    seed[12] = 0x92
    seed[13] = 0xec
    seed[14] = 0x2c
    seed[15] = 0xc4
    seed[16] = 0x44
    seed[17] = 0x49
    seed[18] = 0xc5
    seed[19] = 0x69
    seed[20] = 0x7b
    seed[21] = 0x32
    seed[22] = 0x69
    seed[23] = 0x19
    seed[24] = 0x70
    seed[25] = 0x3b
    seed[26] = 0xac
    seed[27] = 0x03
    seed[28] = 0x1c
    seed[29] = 0xae
    seed[30] = 0x7f
    seed[31] = 0x60

    # Step 1: hash = SHA512(seed)
    var hash: [64]u8
    sha512(@seed[0], 32, @hash[0])

    # Step 2: r = SHA512(prefix) mod l (empty message)
    # prefix = hash[32:64]
    var r_hash: [64]u8
    var ctx: Sha512
    sha512_init(@ctx)
    sha512_update(@ctx, @hash[32], 32)
    # Empty message, so no more updates
    sha512_final(@ctx, @r_hash[0])

    sc_reduce(@r_hash[0])

    # Step 3: R = r * B
    var R: Ge25519
    ge_scalarmult_base(@R, @r_hash[0])

    var R_bytes: [32]u8
    ge_tobytes(@R_bytes[0], @R)

    # Expected R from signature
    var expected_R: [32]u8
    expected_R[0] = 0xe5
    expected_R[1] = 0x56
    expected_R[2] = 0x43
    expected_R[3] = 0x00
    expected_R[4] = 0xc3
    expected_R[5] = 0x60
    expected_R[6] = 0xac
    expected_R[7] = 0x72
    expected_R[8] = 0x90
    expected_R[9] = 0x86
    expected_R[10] = 0xe2
    expected_R[11] = 0xcc
    expected_R[12] = 0x80
    expected_R[13] = 0x6e
    expected_R[14] = 0x82
    expected_R[15] = 0x8a
    expected_R[16] = 0x84
    expected_R[17] = 0x87
    expected_R[18] = 0x7f
    expected_R[19] = 0x1e
    expected_R[20] = 0xb8
    expected_R[21] = 0xe5
    expected_R[22] = 0xd9
    expected_R[23] = 0x74
    expected_R[24] = 0xd8
    expected_R[25] = 0x73
    expected_R[26] = 0xe0
    expected_R[27] = 0x65
    expected_R[28] = 0x22
    expected_R[29] = 0x49
    expected_R[30] = 0x01
    expected_R[31] = 0x55

    if mem_eq(@R_bytes[0], @expected_R[0], 32) != 1
        # Debug: return first differing byte + 100
        var i: i32 = 0
        while i < 32
            if R_bytes[i] != expected_R[i]
                return 100 + i
            i += 1
        return 1

    return 0

