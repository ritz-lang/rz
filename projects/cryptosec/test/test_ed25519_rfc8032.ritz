# Debug verify by doing it manually step by step
[[test]]
fn test_verify_manual_debug() -> i32
    var seed: [32]u8
    seed[0] = 0x9d
    seed[1] = 0x61
    seed[2] = 0xb1
    seed[3] = 0x9d
    seed[4] = 0xef
    seed[5] = 0xfd
    seed[6] = 0x5a
    seed[7] = 0x60
    seed[8] = 0xba
    seed[9] = 0x84
    seed[10] = 0x4a
    seed[11] = 0xf4
    seed[12] = 0x92
    seed[13] = 0xec
    seed[14] = 0x2c
    seed[15] = 0xc4
    seed[16] = 0x44
    seed[17] = 0x49
    seed[18] = 0xc5
    seed[19] = 0x69
    seed[20] = 0x7b
    seed[21] = 0x32
    seed[22] = 0x69
    seed[23] = 0x19
    seed[24] = 0x70
    seed[25] = 0x3b
    seed[26] = 0xac
    seed[27] = 0x03
    seed[28] = 0x1c
    seed[29] = 0xae
    seed[30] = 0x7f
    seed[31] = 0x60

    var privkey: [32]u8
    var pubkey: [32]u8
    ed25519_keygen(@pubkey[0], @privkey[0], @seed[0])

    # Empty message
    var msg: [1]u8
    msg[0] = 0

    # Sign
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 0, @privkey[0])

    # Step 1: Decode public key A
    var A: Ge25519
    if ge_frombytes(@A, @pubkey[0]) != 0
        return 10

    # Step 2: Decode R from signature
    var R: Ge25519
    if ge_frombytes(@R, @sig[0]) != 0
        return 20

    # Step 3: k = SHA512(R || A || msg) mod l
    var k_hash: [64]u8
    var ctx: Sha512
    sha512_init(@ctx)
    sha512_update(@ctx, @sig[0], 32)  # R
    sha512_update(@ctx, @pubkey[0], 32)  # A
    sha512_update(@ctx, @msg[0], 0)
    sha512_final(@ctx, @k_hash[0])
    sc_reduce(@k_hash[0])

    # Step 4: [s]B
    var sB: Ge25519
    ge_scalarmult_base(@sB, @sig[32])

    # Step 5: [k]A
    var kA: Ge25519
    ge_scalarmult(@kA, @k_hash[0], @A)

    # Step 6: -kA
    var neg_kA: Ge25519
    ge_neg(@neg_kA, @kA)

    # Step 7: check = sB - kA
    var check: Ge25519
    ge_add(@check, @sB, @neg_kA)

    # Step 8: encode check
    var check_bytes: [32]u8
    ge_tobytes(@check_bytes[0], @check)

    # Step 9: Compare with R
    if mem_eq(@check_bytes[0], @sig[0], 32) != 1
        # Find first differing byte
        var i: i32 = 0
        while i < 32
            if check_bytes[i] != sig[i]
                return 100 + i
            i += 1
        return 30

    return 0

# Test sign then verify with RFC 8032 vector 1
[[test]]
fn test_sign_then_verify_rfc8032_v1() -> i32
    var seed: [32]u8
    seed[0] = 0x9d
    seed[1] = 0x61
    seed[2] = 0xb1
    seed[3] = 0x9d
    seed[4] = 0xef
    seed[5] = 0xfd
    seed[6] = 0x5a
    seed[7] = 0x60
    seed[8] = 0xba
    seed[9] = 0x84
    seed[10] = 0x4a
    seed[11] = 0xf4
    seed[12] = 0x92
    seed[13] = 0xec
    seed[14] = 0x2c
    seed[15] = 0xc4
    seed[16] = 0x44
    seed[17] = 0x49
    seed[18] = 0xc5
    seed[19] = 0x69
    seed[20] = 0x7b
    seed[21] = 0x32
    seed[22] = 0x69
    seed[23] = 0x19
    seed[24] = 0x70
    seed[25] = 0x3b
    seed[26] = 0xac
    seed[27] = 0x03
    seed[28] = 0x1c
    seed[29] = 0xae
    seed[30] = 0x7f
    seed[31] = 0x60

    var privkey: [32]u8
    var pubkey: [32]u8
    ed25519_keygen(@pubkey[0], @privkey[0], @seed[0])

    # Empty message
    var msg: [1]u8
    msg[0] = 0

    # Sign
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 0, @privkey[0])

    # Verify the signature we just made
    let result: i32 = ed25519_verify(@sig[0], @msg[0], 0, @pubkey[0])
    if result != 1
        return 1

    return 0

# Test sign/verify round-trip with custom message
[[test]]
fn test_ed25519_sign_verify_roundtrip() -> i32
    # Generate keypair from test seed
    var seed: [32]u8
    seed[0] = 0x01
    seed[1] = 0x02
    seed[2] = 0x03
    seed[3] = 0x04
    seed[4] = 0x05
    seed[5] = 0x06
    seed[6] = 0x07
    seed[7] = 0x08
    var i: i32 = 8
    while i < 32
        seed[i] = (i as u8)
        i += 1

    var privkey: [32]u8
    var pubkey: [32]u8
    ed25519_keygen(@pubkey[0], @privkey[0], @seed[0])

    # Test message: "hello"
    var msg: [5]u8
    msg[0] = 0x68  # 'h'
    msg[1] = 0x65  # 'e'
    msg[2] = 0x6c  # 'l'
    msg[3] = 0x6c  # 'l'
    msg[4] = 0x6f  # 'o'

    # Sign the message
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 5, @privkey[0])

    # Verify the signature
    let result: i32 = ed25519_verify(@sig[0], @msg[0], 5, @pubkey[0])
    if result != 1
        return 1

    return 0

# Test that modified message fails verification
[[test]]
fn test_ed25519_verify_tampered_msg() -> i32
    # Generate keypair
    var seed: [32]u8 = [0; 32]
    seed[0] = 0xaa
    seed[1] = 0xbb

    var privkey: [32]u8
    var pubkey: [32]u8
    ed25519_keygen(@pubkey[0], @privkey[0], @seed[0])

    # Sign message "test"
    var msg: [4]u8
    msg[0] = 0x74  # 't'
    msg[1] = 0x65  # 'e'
    msg[2] = 0x73  # 's'
    msg[3] = 0x74  # 't'

    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 4, @privkey[0])

    # Tamper with message
    msg[0] = 0x54  # 'T' instead of 't'

    # Verify should fail (return 0)
    let result: i32 = ed25519_verify(@sig[0], @msg[0], 4, @pubkey[0])
    if result != 0
        return 1  # Should have failed!

    return 0

# Test that modified signature fails verification
[[test]]
fn test_ed25519_verify_tampered_sig() -> i32
    # Generate keypair
    var seed: [32]u8 = [0; 32]
    seed[0] = 0xcc
    seed[1] = 0xdd

    var privkey: [32]u8
    var pubkey: [32]u8
    ed25519_keygen(@pubkey[0], @privkey[0], @seed[0])

    # Sign message "data"
    var msg: [4]u8
    msg[0] = 0x64  # 'd'
    msg[1] = 0x61  # 'a'
    msg[2] = 0x74  # 't'
    msg[3] = 0x61  # 'a'

    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 4, @privkey[0])

    # Tamper with signature (modify s component)
    sig[32] = sig[32] ^ 0x01

    # Verify should fail
    let result: i32 = ed25519_verify(@sig[0], @msg[0], 4, @pubkey[0])
    if result != 0
        return 1  # Should have failed!

    return 0
