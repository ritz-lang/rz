# test/test_cpuid.ritz - Tests for CPU feature detection
#
# Tests CPUID-based detection of:
# - SHA-NI (SHA extensions)
# - AES-NI (AES extensions)
# - AVX2 (Advanced Vector Extensions 2)
# - AVX-512F (AVX-512 Foundation)
# - PCLMULQDQ (carryless multiply)

import cryptosec.cpuid

# ============================================================================
# Basic Detection Tests
# ============================================================================

# These tests verify that the detection functions return valid booleans
# (0 or 1) and don't crash. Actual feature presence depends on hardware.

[[test]]
fn test_cpu_has_sha_ni_returns_bool() -> i32
    let result: i32 = cpu_has_sha_ni()
    if result != 0 && result != 1
        return 1  # Must return 0 or 1
    return 0

[[test]]
fn test_cpu_has_aes_ni_returns_bool() -> i32
    let result: i32 = cpu_has_aes_ni()
    if result != 0 && result != 1
        return 1
    return 0

[[test]]
fn test_cpu_has_avx_returns_bool() -> i32
    let result: i32 = cpu_has_avx()
    if result != 0 && result != 1
        return 1
    return 0

[[test]]
fn test_cpu_has_avx2_returns_bool() -> i32
    let result: i32 = cpu_has_avx2()
    if result != 0 && result != 1
        return 1
    return 0

[[test]]
fn test_cpu_has_avx512_returns_bool() -> i32
    let result: i32 = cpu_has_avx512()
    if result != 0 && result != 1
        return 1
    return 0

[[test]]
fn test_cpu_has_pclmulqdq_returns_bool() -> i32
    let result: i32 = cpu_has_pclmulqdq()
    if result != 0 && result != 1
        return 1
    return 0

# ============================================================================
# Consistency Tests
# ============================================================================

[[test]]
fn test_cpu_features_consistent() -> i32
    # Multiple calls should return the same result (features don't change at runtime)
    let sha1: i32 = cpu_has_sha_ni()
    let sha2: i32 = cpu_has_sha_ni()
    if sha1 != sha2
        return 1

    let aes1: i32 = cpu_has_aes_ni()
    let aes2: i32 = cpu_has_aes_ni()
    if aes1 != aes2
        return 2

    let avx1: i32 = cpu_has_avx2()
    let avx2: i32 = cpu_has_avx2()
    if avx1 != avx2
        return 3

    return 0

# ============================================================================
# Implication Tests
# ============================================================================

[[test]]
fn test_avx512_implies_avx2() -> i32
    # If AVX-512 is present, AVX2 must also be present
    let avx512: i32 = cpu_has_avx512()
    let avx2: i32 = cpu_has_avx2()
    if avx512 == 1 && avx2 == 0
        return 1  # Impossible: AVX-512 requires AVX2
    return 0

[[test]]
fn test_avx2_implies_avx() -> i32
    # If AVX2 is present, AVX must also be present
    let avx2: i32 = cpu_has_avx2()
    let avx: i32 = cpu_has_avx()
    if avx2 == 1 && avx == 0
        return 1  # Impossible: AVX2 requires AVX
    return 0

# ============================================================================
# Cache Tests
# ============================================================================

[[test]]
fn test_cpu_features_cached() -> i32
    # Features should be cached after first detection
    # This verifies no crash on many rapid calls
    var i: i32 = 0
    while i < 100
        cpu_has_sha_ni()
        cpu_has_aes_ni()
        cpu_has_avx2()
        cpu_has_avx512()
        cpu_has_pclmulqdq()
        i += 1
    return 0

# ============================================================================
# Raw CPUID Tests
# ============================================================================

[[test]]
fn test_cpuid_raw_leaf_0() -> i32
    # Leaf 0 returns vendor string and max leaf in EAX
    var eax: i32 = 0
    var ebx: i32 = 0
    var ecx: i32 = 0
    var edx: i32 = 0

    cpuid_raw(0, 0, @eax, @ebx, @ecx, @edx)

    # EAX should contain max supported leaf (at least 1 for any x86-64 CPU)
    if eax < 1
        return 1

    # EBX, EDX, ECX contain vendor string
    # Intel: "GenuineIntel" -> ebx='Genu', edx='ineI', ecx='ntel'
    # AMD: "AuthenticAMD" -> ebx='Auth', edx='enti', ecx='cAMD'
    # Should be non-zero for any real CPU
    if ebx == 0 && edx == 0 && ecx == 0
        return 2

    return 0

[[test]]
fn test_cpuid_raw_leaf_1() -> i32
    # Leaf 1 returns feature flags
    var eax: i32 = 0
    var ebx: i32 = 0
    var ecx: i32 = 0
    var edx: i32 = 0

    cpuid_raw(1, 0, @eax, @ebx, @ecx, @edx)

    # EAX contains processor info (stepping, model, family)
    # Should be non-zero for any real CPU
    if eax == 0
        return 1

    # EDX contains basic features that all x86-64 CPUs have
    # Bit 0: FPU (always present on x86-64)
    # Bit 4: TSC (time stamp counter, always present)
    # Bit 23: MMX (always present on x86-64)
    # Bit 25: SSE (always present on x86-64)
    # Bit 26: SSE2 (always present on x86-64)
    let has_sse2: i32 = (edx >> 26) & 1
    if has_sse2 != 1
        return 2  # All x86-64 CPUs have SSE2

    return 0

# ============================================================================
# Feature Structure Tests
# ============================================================================

[[test]]
fn test_cpu_detect_features_struct() -> i32
    var features: CpuFeatures

    cpu_detect_features(@features)

    # Verify all fields are valid booleans
    if features.has_aes_ni != 0 && features.has_aes_ni != 1
        return 1
    if features.has_sha_ni != 0 && features.has_sha_ni != 1
        return 2
    if features.has_avx != 0 && features.has_avx != 1
        return 3
    if features.has_avx2 != 0 && features.has_avx2 != 1
        return 4
    if features.has_avx512f != 0 && features.has_avx512f != 1
        return 5
    if features.has_pclmulqdq != 0 && features.has_pclmulqdq != 1
        return 6

    return 0

[[test]]
fn test_cpu_detect_features_matches_individual() -> i32
    var features: CpuFeatures
    cpu_detect_features(@features)

    # Struct should match individual function calls
    if features.has_aes_ni != cpu_has_aes_ni()
        return 1
    if features.has_sha_ni != cpu_has_sha_ni()
        return 2
    if features.has_avx != cpu_has_avx()
        return 3
    if features.has_avx2 != cpu_has_avx2()
        return 4
    if features.has_avx512f != cpu_has_avx512()
        return 5
    if features.has_pclmulqdq != cpu_has_pclmulqdq()
        return 6

    return 0

# AVX-512 is usable only on top of AVX2 (GitHub #149 L-7, AGAST #2586).
# Arguments: has_avx, has_avx2, has_osxsave, xcr0, has_avx512f.
[[test]]
fn test_cpu_avx512_usable_needs_avx2_2586() -> i32
    if cpu_avx512_usable(1, 1, 1, 0xE7, 1) != 1
        return 1
    if cpu_avx512_usable(1, 0, 1, 0xE7, 1) != 0
        return 2
    if cpu_avx512_usable(0, 1, 1, 0xE7, 1) != 0
        return 3
    if cpu_avx512_usable(1, 1, 0, 0xE7, 1) != 0
        return 4
    if cpu_avx512_usable(1, 1, 1, 0xE7, 0) != 0
        return 5
    return 0

# OSXSAVE only says XGETBV exists; the OS-enabled state is in XCR0
# (AGAST #4127). AVX needs XCR0 bits 1 (SSE) and 2 (YMM).
# Arguments: has_avx, has_osxsave, xcr0.
[[test]]
fn test_cpu_avx_usable_needs_xcr0_ymm_4127() -> i32
    if cpu_avx_usable(1, 1, 0x7) != 1
        return 1
    if cpu_avx_usable(1, 1, 0x6) != 1
        return 2
    if cpu_avx_usable(1, 1, 0x3) != 0      # YMM (bit 2) off: e.g. noxsave
        return 3
    if cpu_avx_usable(1, 1, 0x5) != 0      # SSE (bit 1) off
        return 4
    if cpu_avx_usable(1, 1, 0x1) != 0      # x87 only
        return 5
    if cpu_avx_usable(1, 0, 0x7) != 0      # no OSXSAVE: XCR0 is not readable
        return 6
    if cpu_avx_usable(0, 1, 0x7) != 0
        return 7
    return 0

# AVX2 rides on the same YMM state as AVX (AGAST #4127).
# Arguments: has_avx, has_osxsave, xcr0, has_avx2.
[[test]]
fn test_cpu_avx2_usable_needs_xcr0_ymm_4127() -> i32
    if cpu_avx2_usable(1, 1, 0x7, 1) != 1
        return 1
    if cpu_avx2_usable(1, 1, 0x3, 1) != 0  # YMM off
        return 2
    if cpu_avx2_usable(1, 1, 0x5, 1) != 0  # SSE off
        return 3
    if cpu_avx2_usable(1, 0, 0x7, 1) != 0
        return 4
    if cpu_avx2_usable(0, 1, 0x7, 1) != 0
        return 5
    if cpu_avx2_usable(1, 1, 0x7, 0) != 0
        return 6
    return 0

# AVX-512 also needs XCR0 bits 5 (opmask), 6 (ZMM_Hi256) and 7 (Hi16_ZMM)
# on top of the AVX bits 1-2 (AGAST #4127).
[[test]]
fn test_cpu_avx512_usable_needs_xcr0_zmm_4127() -> i32
    if cpu_avx512_usable(1, 1, 1, 0xE6, 1) != 1
        return 1
    if cpu_avx512_usable(1, 1, 1, 0x7, 1) != 0   # ZMM state all off
        return 2
    if cpu_avx512_usable(1, 1, 1, 0xC7, 1) != 0  # opmask (bit 5) off
        return 3
    if cpu_avx512_usable(1, 1, 1, 0xA7, 1) != 0  # ZMM_Hi256 (bit 6) off
        return 4
    if cpu_avx512_usable(1, 1, 1, 0x67, 1) != 0  # Hi16_ZMM (bit 7) off
        return 5
    if cpu_avx512_usable(1, 1, 1, 0xE3, 1) != 0  # YMM (bit 2) off
        return 6
    if cpu_avx512_usable(1, 1, 1, 0xE5, 1) != 0  # SSE (bit 1) off
        return 7
    return 0

# ============================================================================
# One-word publication (GitHub #149 M-19, AGAST #4126)
# ============================================================================
# Every flag lives in one u32 with a READY bit, published by one atomic store,
# so a thread that sees READY also sees every flag of that same store.
# cpuid_pack arguments: aes_ni, sha_ni, avx, avx2, avx512f, pclmulqdq, osxsave.

# A CPU with no features is still "detected": the word must not be 0.
[[test]]
fn test_cpuid_pack_sets_ready_4126() -> i32
    let w: u32 = cpuid_pack(0, 0, 0, 0, 0, 0, 0)
    if w != CPUID_F_READY
        return 1
    if (cpuid_pack(1, 1, 1, 1, 1, 1, 1) & CPUID_F_READY) == 0
        return 2
    return 0

# Each flag sets its own bit and nothing else.
[[test]]
fn test_cpuid_pack_one_bit_per_flag_4126() -> i32
    if cpuid_pack(1, 0, 0, 0, 0, 0, 0) != (CPUID_F_READY | CPUID_F_AES_NI)
        return 1
    if cpuid_pack(0, 1, 0, 0, 0, 0, 0) != (CPUID_F_READY | CPUID_F_SHA_NI)
        return 2
    if cpuid_pack(0, 0, 1, 0, 0, 0, 0) != (CPUID_F_READY | CPUID_F_AVX)
        return 3
    if cpuid_pack(0, 0, 0, 1, 0, 0, 0) != (CPUID_F_READY | CPUID_F_AVX2)
        return 4
    if cpuid_pack(0, 0, 0, 0, 1, 0, 0) != (CPUID_F_READY | CPUID_F_AVX512F)
        return 5
    if cpuid_pack(0, 0, 0, 0, 0, 1, 0) != (CPUID_F_READY | CPUID_F_PCLMULQDQ)
        return 6
    if cpuid_pack(0, 0, 0, 0, 0, 0, 1) != (CPUID_F_READY | CPUID_F_OSXSAVE)
        return 7
    # All seven distinct and clear of READY: OR of all is 7 bits + READY.
    let all: u32 = CPUID_F_AES_NI | CPUID_F_SHA_NI | CPUID_F_AVX | CPUID_F_AVX2 | CPUID_F_AVX512F | CPUID_F_PCLMULQDQ | CPUID_F_OSXSAVE
    if (all & CPUID_F_READY) != 0
        return 8
    if CPUID_F_AES_NI + CPUID_F_SHA_NI + CPUID_F_AVX + CPUID_F_AVX2 + CPUID_F_AVX512F + CPUID_F_PCLMULQDQ + CPUID_F_OSXSAVE != all
        return 9
    return 0

[[test]]
fn test_cpuid_flag_reads_one_bit_4126() -> i32
    let w: u32 = CPUID_F_READY | CPUID_F_AVX2
    if cpuid_flag(w, CPUID_F_AVX2) != 1
        return 1
    if cpuid_flag(w, CPUID_F_AVX) != 0
        return 2
    return 0

# The published word is READY, stable, equal to a fresh detection, and every
# getter and cpu_detect_features read their answer out of it.
[[test]]
fn test_cpuid_features_word_published_4126() -> i32
    let w: u32 = cpuid_features_word()
    if (w & CPUID_F_READY) == 0
        return 1
    if cpuid_features_word() != w
        return 2
    if cpuid_detect() != w
        return 3
    if cpu_has_aes_ni() != cpuid_flag(w, CPUID_F_AES_NI)
        return 4
    if cpu_has_sha_ni() != cpuid_flag(w, CPUID_F_SHA_NI)
        return 5
    if cpu_has_avx() != cpuid_flag(w, CPUID_F_AVX)
        return 6
    if cpu_has_avx2() != cpuid_flag(w, CPUID_F_AVX2)
        return 7
    if cpu_has_avx512() != cpuid_flag(w, CPUID_F_AVX512F)
        return 8
    if cpu_has_pclmulqdq() != cpuid_flag(w, CPUID_F_PCLMULQDQ)
        return 9
    var f: CpuFeatures
    cpu_detect_features(@f)
    if f.has_osxsave != cpuid_flag(w, CPUID_F_OSXSAVE)
        return 10
    # OSXSAVE is reported unmasked, so it must match CPUID.1:ECX bit 27.
    var eax: i32 = 0
    var ebx: i32 = 0
    var ecx: i32 = 0
    var edx: i32 = 0
    cpuid_raw(1, 0, @eax, @ebx, @ecx, @edx)
    if cpuid_flag(w, CPUID_F_OSXSAVE) != ((ecx >> 27) & 1)
        return 11
    return 0
