[[test]]
fn test_alert_fatal_is_an_error() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var alert: [2]u8
    alert[0] = 2
    alert[1] = 40  # handshake_failure
    if server_send(@client, @srv, 21, @alert[0], 2) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PEER_ALERT
        return 11
    if tls_client_peer_alert(@client) != 40
        return 12
    if tls_client_state(@client) != TLS_STATE_ERROR
        return 13
    return 0

# Only close_notify ends the stream cleanly; user_canceled is an error too.
[[test]]
fn test_alert_warning_other_than_close_notify_is_an_error() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var alert: [2]u8
    alert[0] = 1
    alert[1] = 90  # user_canceled
    if server_send(@client, @srv, 21, @alert[0], 2) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PEER_ALERT
        return 11
    if tls_client_peer_alert(@client) != 90
        return 12
    return 0

[[test]]
fn test_alert_refuses_malformed_alert() -> i32
