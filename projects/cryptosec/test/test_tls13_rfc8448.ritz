# The keys change after a KeyUpdate: nothing may follow it in its record.
[[test]]
fn test_key_update_must_end_its_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var msg: [26]u8
    from_hex(@msg[0], "1800000100", 5)
    make_ticket(@msg[5])
    if server_send(@client, @srv, 22, @msg[0], 26) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_UNEXPECTED_MESSAGE
        return 11
    return 0

# ============================================================================
# Our fatal alert (RFC 8446 6.2), fetched with tls_client_pending_alert
# ============================================================================
#
# The side that detects an error sends a fatal alert before it closes. Before
# the ServerHello the alert is a plaintext record; once handshake keys exist
# it is encrypted, under the client's handshake keys during the handshake and
# its application keys after it. The keys checked below are the trace's own
# (RFC 8448 section 3), not the client's.

fn client_hs_key() -> StrView
    return "dbfaa693d1762c5b666af5d950258d01"

fn client_hs_iv() -> StrView
    return "5bd3c71b836e0b76bb73265f"

const ALERT_BAD_RECORD_MAC: u8 = 20
const ALERT_RECORD_OVERFLOW: u8 = 22
const ALERT_UNEXPECTED_MESSAGE: u8 = 10
const ALERT_BAD_CERTIFICATE: u8 = 42
const ALERT_ILLEGAL_PARAMETER: u8 = 47
const ALERT_DECODE_ERROR: u8 = 50
const ALERT_DECRYPT_ERROR: u8 = 51
const ALERT_PROTOCOL_VERSION: u8 = 70
const ALERT_INTERNAL_ERROR: u8 = 80
const ALERT_MISSING_EXTENSION: u8 = 109

# The pending alert is one plaintext record, fatal `desc`, sent once.
fn expect_plain_alert(client: *TlsClient, desc: u8) -> i32
    var rec: [64]u8
    if tls_client_pending_alert(client, @rec[0], 64) != 7
        return 100
    if eq_hex(@rec[0], "1503030002", 5) != 1
        return 101
    if rec[5] != 2
        return 102
    if rec[6] != desc
        return 103
    if tls_client_pending_alert(client, @rec[0], 64) != 0
        return 104
    return 0

# The pending alert is one record that decrypts under the client's key `key`
# and iv `iv` (first record under them) to fatal `desc`, sent once.
fn expect_sealed_alert(client: *TlsClient, key_hex: StrView, iv_hex: StrView, desc: u8) -> i32
    var rec: [64]u8
    let n: i64 = tls_client_pending_alert(client, @rec[0], 64)
    if n != 24
        return 110
    var key: [16]u8
    var iv: [12]u8
    from_hex(@key[0], key_hex, 16)
    from_hex(@iv[0], iv_hex, 12)
    var pt: [64]u8
    var inner: u8 = 0
    if tls13_record_decrypt(@key[0], 16, @iv[0], 0, @rec[0], n as i32, @pt[0], 64, @inner) != 2
        return 111
    if inner != 21
        return 112
    if pt[0] != 2
        return 113
    if pt[1] != desc
        return 114
    if tls_client_pending_alert(client, @rec[0], 64) != 0
        return 115
    return 0

# The client failed with `err`; its alert is plaintext fatal `desc`.
fn expect_plain_failure(client: *TlsClient, r: i32, err: i32, desc: u8) -> i32
    if r != TLS_RESULT_ERROR
        return 90
    if tls_client_error(client) != err
        return 91
    return expect_plain_alert(client, desc)

# The client failed with `err` during the handshake; its alert is fatal
# `desc` under the trace's client handshake keys.
fn expect_hs_failure(client: *TlsClient, r: i32, err: i32, desc: u8) -> i32
    if r != TLS_RESULT_ERROR
        return 90
    if tls_client_error(client) != err
        return 91
    return expect_sealed_alert(client, client_hs_key(), client_hs_iv(), desc)

# The client failed with `err` after the handshake; its alert is fatal
# `desc` under the trace's client application keys.
fn expect_ap_failure(client: *TlsClient, r: i64, err: i32, desc: u8) -> i32
    if r != -1
        return 90
    if tls_client_error(client) != err
        return 91
    return expect_sealed_alert(client, client_ap_key(), client_ap_iv(), desc)

# Feed raw bytes to a client that has just sent its hello.
fn hello_sent_then(client: *TlsClient, cfg: *TlsConfig, hex: StrView, len: i64) -> i32
    if trace_hello_sent(client, cfg) != 0
        return -100
    var rec: [64]u8
    from_hex(@rec[0], hex, len)
    var out: [256]u8
    var out_len: i64 = 0
    return tls_client_process(client, @rec[0], len, @out[0], 256, @out_len)

# Through the trace's ServerHello. Returns 0, or the step that went wrong.
fn past_server_hello(client: *TlsClient, cfg: *TlsConfig) -> i32
    let r: i32 = trace_hello_sent(client, cfg)
    if r != 0
        return r
    var sh: [SERVER_HELLO_RECORD_LEN]u8
    from_hex(@sh[0], server_hello_record(), SERVER_HELLO_RECORD_LEN)
    var out: [256]u8
    var out_len: i64 = 0
    if tls_client_process(client, @sh[0], SERVER_HELLO_RECORD_LEN, @out[0], 256, @out_len) != TLS_RESULT_NEED_INPUT
        return 3
    return 0

# After the trace's ServerHello, `flight` (inner type `inner`) as the server's
# first encrypted record, under the server's handshake keys.
fn sealed_flight(client: *TlsClient, cfg: *TlsConfig, flight: *u8, len: i64, inner: u8) -> i32
    if past_server_hello(client, cfg) != 0
        return -100
    var rec: [1024]u8
    let n: i32 = tls13_record_encrypt(@client.read_state.server_key[0], 16, @client.read_state.server_iv[0], 0, flight, len as i32, inner, @rec[0], 1024)
    if n < 0
        return -101
    var out: [256]u8
    var out_len: i64 = 0
    return tls_client_process(client, @rec[0], n as i64, @out[0], 256, @out_len)

# --- before handshake keys: plaintext ---------------------------------------

[[test]]
fn test_alert_plain_record_overflow() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = hello_sent_then(@client, @cfg, "160303ffff", 5)
    return expect_plain_failure(@client, r, TLS_ERR_RECORD_OVERFLOW, ALERT_RECORD_OVERFLOW)

[[test]]
fn test_alert_plain_unexpected_message() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = hello_sent_then(@client, @cfg, "170303000100", 6)
    return expect_plain_failure(@client, r, TLS_ERR_UNEXPECTED_MESSAGE, ALERT_UNEXPECTED_MESSAGE)

[[test]]
fn test_alert_plain_decode_error() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = hello_sent_then(@client, @cfg, "16030300020200", 7)
    return expect_plain_failure(@client, r, TLS_ERR_PARSE_ERROR, ALERT_DECODE_ERROR)

# The trace's ServerHello answers a share for a group we did not offer.
[[test]]
fn test_alert_plain_illegal_parameter() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    if trace_hello_sent(@client, @cfg) != 0
        return 1
    client.client_hello.key_share_group = GROUP_SECP256R1
    var sh: [SERVER_HELLO_RECORD_LEN]u8
    from_hex(@sh[0], server_hello_record(), SERVER_HELLO_RECORD_LEN)
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = tls_client_process(@client, @sh[0], SERVER_HELLO_RECORD_LEN, @out[0], 256, @out_len)
    return expect_plain_failure(@client, r, TLS_ERR_ILLEGAL_PARAMETER, ALERT_ILLEGAL_PARAMETER)

# Feed a whole ServerHello record, given as hex, to a client that has just
# sent the trace's hello.
fn server_hello_then(client: *TlsClient, cfg: *TlsConfig, hex: StrView, len: i64) -> i32
    if trace_hello_sent(client, cfg) != 0
        return -100
    var rec: [256]u8
    from_hex(@rec[0], hex, len)
    var out: [256]u8
    var out_len: i64 = 0
    return tls_client_process(client, @rec[0], len, @out[0], 256, @out_len)

# The trace's ServerHello without supported_versions: the server picked
# TLS 1.2, which this client does not speak (RFC 8446 4.1.3, D.1).
[[test]]
fn test_alert_plain_protocol_version() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = server_hello_then(@client, @cfg, "1603030054020000500303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002800330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f", 89)
    return expect_plain_failure(@client, r, TLS_ERR_VERSION_MISMATCH, ALERT_PROTOCOL_VERSION)

# supported_versions naming TLS 1.2, which we did not offer, is
# illegal_parameter (RFC 8446 4.2.1).
[[test]]
fn test_alert_plain_selected_tls12_is_illegal_parameter() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = server_hello_then(@client, @cfg, "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020303", SERVER_HELLO_RECORD_LEN)
    return expect_plain_failure(@client, r, TLS_ERR_ILLEGAL_PARAMETER, ALERT_ILLEGAL_PARAMETER)

# The trace's ServerHello without its key_share (RFC 8446 4.2.8, 9.2).
[[test]]
fn test_alert_plain_missing_extension() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    let r: i32 = server_hello_then(@client, @cfg, "16030300320200002e0303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e26928001301000006002b00020304", 55)
    return expect_plain_failure(@client, r, TLS_ERR_NO_KEY_SHARE, ALERT_MISSING_EXTENSION)

# Section 5's HelloRetryRequest asks for secp256r1, the share we already sent
# (RFC 8446 4.2.8): it cannot be honoured.
[[test]]
fn test_alert_plain_hello_retry_illegal_parameter() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    if trace_hello_sent(@client, @cfg) != 0
        return 1
    client.client_hello.key_share_group = GROUP_SECP256R1
    var hrr: [RETRY_HRR_RECORD_LEN]u8
    from_hex(@hrr[0], retry_hrr_record(), RETRY_HRR_RECORD_LEN)
    var out: [2048]u8
    var out_len: i64 = 0
    let r: i32 = tls_client_process(@client, @hrr[0], RETRY_HRR_RECORD_LEN, @out[0], 2048, @out_len)
    return expect_plain_failure(@client, r, TLS_ERR_HELLO_RETRY_REQUEST, ALERT_ILLEGAL_PARAMETER)

# --- during the handshake: under handshake keys ------------------------------

# A state the handshake cannot be in (forced here) is an internal error.
[[test]]
fn test_alert_hs_internal_error_invalid_state() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    if past_server_hello(@client, @cfg) != 0
        return 1
    client.state = TLS_STATE_CLOSING
    var rec: [SERVER_FLIGHT_RECORD_LEN]u8
    from_hex(@rec[0], server_flight_record(), SERVER_FLIGHT_RECORD_LEN)
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = tls_client_process(@client, @rec[0], SERVER_FLIGHT_RECORD_LEN, @out[0], 256, @out_len)
    return expect_hs_failure(@client, r, TLS_ERR_INVALID_STATE, ALERT_INTERNAL_ERROR)

[[test]]
fn test_alert_hs_bad_record_mac() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    if past_server_hello(@client, @cfg) != 0
        return 1
    var rec: [SERVER_FLIGHT_RECORD_LEN]u8
    from_hex(@rec[0], server_flight_record(), SERVER_FLIGHT_RECORD_LEN)
    rec[100] = rec[100] ^ 1
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = tls_client_process(@client, @rec[0], SERVER_FLIGHT_RECORD_LEN, @out[0], 256, @out_len)
    return expect_hs_failure(@client, r, TLS_ERR_DECRYPT_FAILED, ALERT_BAD_RECORD_MAC)

# The trace's flight, sealed as application data instead of handshake.
[[test]]
fn test_alert_hs_unexpected_message() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)
    let r: i32 = sealed_flight(@client, @cfg, @flight[0], SERVER_FLIGHT_LEN, 23)
    return expect_hs_failure(@client, r, TLS_ERR_UNEXPECTED_MESSAGE, ALERT_UNEXPECTED_MESSAGE)

# A Finished one byte short.
[[test]]
fn test_alert_hs_decode_error() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)
    flight[SERVER_FLIGHT_LEN - 33] = 0x1f
    let r: i32 = sealed_flight(@client, @cfg, @flight[0], SERVER_FLIGHT_LEN - 1, 22)
    return expect_hs_failure(@client, r, TLS_ERR_PARSE_ERROR, ALERT_DECODE_ERROR)

# A handshake message longer than the client reassembles.
[[test]]
fn test_alert_hs_record_overflow() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var msg: [4]u8
    from_hex(@msg[0], "08010000", 4)
    let r: i32 = sealed_flight(@client, @cfg, @msg[0], 4, 22)
    return expect_hs_failure(@client, r, TLS_ERR_RECORD_OVERFLOW, ALERT_RECORD_OVERFLOW)

# The leaf no longer matches the pinned certificate.
[[test]]
fn test_alert_hs_bad_certificate() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)
    flight[LEAF_OFFSET + LEAF_LEN - 1] = flight[LEAF_OFFSET + LEAF_LEN - 1] ^ 1
    let r: i32 = sealed_flight(@client, @cfg, @flight[0], SERVER_FLIGHT_LEN, 22)
    return expect_hs_failure(@client, r, TLS_ERR_CERTIFICATE_INVALID, ALERT_BAD_CERTIFICATE)

# A flipped bit in the CertificateVerify signature, just before Finished.
[[test]]
fn test_alert_hs_verify_failed() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)
    flight[SERVER_FLIGHT_LEN - 40] = flight[SERVER_FLIGHT_LEN - 40] ^ 1
    let r: i32 = sealed_flight(@client, @cfg, @flight[0], SERVER_FLIGHT_LEN, 22)
    return expect_hs_failure(@client, r, TLS_ERR_VERIFY_FAILED, ALERT_DECRYPT_ERROR)

# A flipped bit in the server's Finished.
[[test]]
fn test_alert_hs_finished_mismatch() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)
    flight[SERVER_FLIGHT_LEN - 1] = flight[SERVER_FLIGHT_LEN - 1] ^ 1
    let r: i32 = sealed_flight(@client, @cfg, @flight[0], SERVER_FLIGHT_LEN, 22)
    return expect_hs_failure(@client, r, TLS_ERR_FINISHED_MISMATCH, ALERT_DECRYPT_ERROR)

# --- after the handshake: under application keys -----------------------------

[[test]]
fn test_alert_ap_bad_record_mac() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var rec: [64]u8
    let n: i32 = tls_record_state_server_encrypt(@srv, "hello", 5, 23, @rec[0], 64)
    if n < 0
        return 2
    rec[6] = rec[6] ^ 1
    var out: [256]u8
    let r: i64 = tls_client_read(@client, @rec[0], n as i64, @out[0], 256)
    return expect_ap_failure(@client, r, TLS_ERR_DECRYPT_FAILED, ALERT_BAD_RECORD_MAC)

[[test]]
fn test_alert_ap_unexpected_message() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var msg: [5]u8
    from_hex(@msg[0], "6300000100", 5)
    let r: i64 = server_send(@client, @srv, 22, @msg[0], 5)
    return expect_ap_failure(@client, r, TLS_ERR_UNEXPECTED_MESSAGE, ALERT_UNEXPECTED_MESSAGE)

[[test]]
fn test_alert_ap_decode_error() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var ticket: [TICKET_LEN]u8
    make_ticket(@ticket[0])
    ticket[15] = 4  # ticket length 4: runs over the extensions length
    let r: i64 = server_send(@client, @srv, 22, @ticket[0], TICKET_LEN)
    return expect_ap_failure(@client, r, TLS_ERR_PARSE_ERROR, ALERT_DECODE_ERROR)

[[test]]
fn test_alert_ap_illegal_parameter() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var msg: [5]u8
    from_hex(@msg[0], "1800000102", 5)  # KeyUpdate request 2
    let r: i64 = server_send(@client, @srv, 22, @msg[0], 5)
    return expect_ap_failure(@client, r, TLS_ERR_ILLEGAL_PARAMETER, ALERT_ILLEGAL_PARAMETER)

[[test]]
fn test_alert_ap_record_overflow() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var msg: [4]u8
    from_hex(@msg[0], "04010000", 4)  # a ticket over 64 KiB
    let r: i64 = server_send(@client, @srv, 22, @msg[0], 4)
    return expect_ap_failure(@client, r, TLS_ERR_RECORD_OVERFLOW, ALERT_RECORD_OVERFLOW)

# Data larger than the reader's buffer kills the connection: internal_error.
[[test]]
fn test_alert_ap_internal_error_buffer_too_small() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var rec: [64]u8
    let n: i32 = tls_record_state_server_encrypt(@srv, "hello", 5, 23, @rec[0], 64)
    if n < 0
        return 2
    var out: [4]u8
    let r: i64 = tls_client_read(@client, @rec[0], n as i64, @out[0], 4)
    return expect_ap_failure(@client, r, TLS_ERR_BUFFER_TOO_SMALL, ALERT_INTERNAL_ERROR)

# --- no alert ----------------------------------------------------------------

# A healthy connection has nothing to send.
[[test]]
fn test_alert_none_while_connected() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var rec: [64]u8
    if tls_client_pending_alert(@client, @rec[0], 64) != 0
        return 2
    return 0

# A refused call on a live connection (start twice) leaves nothing to send.
[[test]]
fn test_alert_none_for_invalid_state_while_alive() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var rec: [1024]u8
    if tls_client_start(@client, @rec[0], 1024) != -1
        return 2
    if tls_client_error(@client) != TLS_ERR_INVALID_STATE
        return 3
    if tls_client_pending_alert(@client, @rec[0], 64) != 0
        return 4
    return 0

# A fatal alert from the server is not answered with one of ours.
[[test]]
fn test_alert_none_after_peer_alert() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var alert: [2]u8
    alert[0] = 2
    alert[1] = 40
    if server_send(@client, @srv, 21, @alert[0], 2) != -1
        return 2
    var rec: [64]u8
    if tls_client_pending_alert(@client, @rec[0], 64) != 0
        return 3
    return 0

# A client refused at init never spoke to anyone.
[[test]]
fn test_alert_none_after_refused_hostname() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    tls_config_init(@cfg)
    if tls_config_set_hostname(@cfg, "x", -1) != -1
        return 1
    if tls_client_init(@client, @cfg) != -1
        return 2
    var rec: [64]u8
    if tls_client_pending_alert(@client, @rec[0], 64) != 0
        return 3
    return 0

# Too small a buffer writes nothing and keeps the alert for a retry.
[[test]]
fn test_alert_small_buffer_keeps_it_pending() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    if connected(@client, @cfg, @srv) != 0
        return 1
    var msg: [5]u8
    from_hex(@msg[0], "6300000100", 5)
    if server_send(@client, @srv, 22, @msg[0], 5) != -1
        return 2
    var rec: [64]u8
    if tls_client_pending_alert(@client, @rec[0], 23) != -1
        return 3
    return expect_sealed_alert(@client, client_ap_key(), client_ap_iv(), ALERT_UNEXPECTED_MESSAGE)

# The same, before handshake keys.
[[test]]
fn test_alert_small_buffer_keeps_plain_alert_pending() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    if hello_sent_then(@client, @cfg, "170303000100", 6) != TLS_RESULT_ERROR
        return 1
    var rec: [64]u8
    if tls_client_pending_alert(@client, @rec[0], 6) != -1
        return 2
    return expect_plain_alert(@client, ALERT_UNEXPECTED_MESSAGE)
