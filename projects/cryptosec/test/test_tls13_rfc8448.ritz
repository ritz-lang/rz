    if r != 0
        return r
    var alert: [3]u8
    alert[0] = 1
    alert[1] = 0
    alert[2] = 0
    if server_send(@client, @srv, 21, @alert[0], 3) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PARSE_ERROR
        return 11
    return 0

# Our close_notify first, then the server's: reads still work in between.
[[test]]
fn test_alert_close_notify_after_our_close() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var out: [64]u8
    if tls_client_close(@client, @out[0], 64) <= 0
        return 10
    if tls_client_state(@client) != TLS_STATE_CLOSING
        return 11
    if data_from_server(@client, @srv, "late data") != 0
        return 12
    var alert: [2]u8
    alert[0] = 1
    alert[1] = 0
    if server_send(@client, @srv, 21, @alert[0], 2) != TLS_READ_CLOSED
        return 13
    if tls_client_state(@client) != TLS_STATE_CLOSED
        return 14
    return 0

# KeyUpdate(update_not_requested): reads move to the next server secret at
# sequence 0; writes keep their keys.
[[test]]
fn test_key_update_rekeys_reads() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ku: [5]u8
    from_hex(@ku[0], "1800000100", 5)
    if server_send(@client, @srv, 22, @ku[0], 5) != 0
        return 10
    if client.read_state.server_seq != 0
        return 11

    var secret: [32]u8
    from_hex(@secret[0], server_ap_secret(), 32)
    var next: [32]u8
    if next_secret(@secret[0], @next[0]) != 0
        return 12
    match tls13_derive_traffic_keys(@next[0], @srv.server_key[0], 16, @srv.server_iv[0], 12)
        Ok(_) => 0
        Err(_) => return 13
    srv.server_seq = 0
    if data_from_server(@client, @srv, "after update") != 0
        return 14

    # No update was requested: the client's next record is under its old keys.
    var out: [64]u8
    let n: i64 = tls_client_write(@client, "hi", 2, @out[0], 64)
    if n != 5 + 2 + 1 + 16
        return 15
    var got: [64]u8
    var inner_type: u8 = 0
    if tls_record_state_client_decrypt(@srv, @out[0], n as i32, @got[0], 64, @inner_type) != 2
        return 16
    return 0

# Records under the old server keys fail once the keys have moved on.
[[test]]
fn test_key_update_refuses_old_keys() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ku: [5]u8
    from_hex(@ku[0], "1800000100", 5)
    if server_send(@client, @srv, 22, @ku[0], 5) != 0
        return 10
    if data_from_server(@client, @srv, "stale") == 0
        return 11
    if tls_client_error(@client) != TLS_ERR_DECRYPT_FAILED
        return 12
    return 0

# KeyUpdate(update_requested): the client's next write sends its own
# KeyUpdate(update_not_requested) under the old keys, then the data under the
# next client secret's keys (RFC 8446 4.6.3).
[[test]]
fn test_key_update_requested_updates_writes() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ku: [5]u8
    from_hex(@ku[0], "1800000101", 5)
    if server_send(@client, @srv, 22, @ku[0], 5) != 0
        return 10

    var out: [128]u8
    let n: i64 = tls_client_write(@client, "hi", 2, @out[0], 128)
    let ku_rec: i64 = 5 + 5 + 1 + 16
    let data_rec: i64 = 5 + 2 + 1 + 16
    if n != ku_rec + data_rec
        return 11
    var got: [64]u8
    var inner_type: u8 = 0
    if tls_record_state_client_decrypt(@srv, @out[0], ku_rec as i32, @got[0], 64, @inner_type) != 5
        return 12
    if inner_type != 22 || eq_hex(@got[0], "1800000100", 5) != 1
        return 13

    var secret: [32]u8
    from_hex(@secret[0], client_ap_secret(), 32)
    var next: [32]u8
    if next_secret(@secret[0], @next[0]) != 0
        return 14
    match tls13_derive_traffic_keys(@next[0], @srv.client_key[0], 16, @srv.client_iv[0], 12)
        Ok(_) => 0
        Err(_) => return 15
    srv.client_seq = 0
    if tls_record_state_client_decrypt(@srv, @out[ku_rec], data_rec as i32, @got[0], 64, @inner_type) != 2
        return 16
    if inner_type != 23 || got[0] != 104 || got[1] != 105
        return 17

    # Sent once: the next write is a single record under the new keys.
    if tls_client_write(@client, "hi", 2, @out[0], 128) != data_rec
        return 18
    if tls_record_state_client_decrypt(@srv, @out[0], data_rec as i32, @got[0], 64, @inner_type) != 2
        return 19
    return 0

# A write too small for both records changes nothing: the update stays queued.
[[test]]
fn test_key_update_requested_write_too_small() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ku: [5]u8
    from_hex(@ku[0], "1800000101", 5)
    if server_send(@client, @srv, 22, @ku[0], 5) != 0
        return 10
    var out: [128]u8
    if tls_client_write(@client, "hi", 2, @out[0], 40) != -1
        return 11
    if client.write_state.client_seq != 0
        return 12
    if tls_client_write(@client, "hi", 2, @out[0], 128) != 51
        return 13
    return 0

[[test]]
fn test_key_update_refuses_bad_request_value() -> i32
