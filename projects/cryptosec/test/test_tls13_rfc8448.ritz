# ============================================================================
# RFC 8448 section 5 vectors
# ============================================================================

const RETRY_CLIENT_HELLO1_LEN: i64 = 180
fn retry_client_hello1() -> StrView
    return ""

const RETRY_HRR_RECORD_LEN: i64 = 181
fn retry_hrr_record() -> StrView
    return ""

const RETRY_P256_PRIVATE_LEN: i64 = 32
fn retry_p256_private() -> StrView
    return "ab5473467e19346ceb0a0414e41da21d4d2445bc3025afe97c4e8dc8d513da39"

const RETRY_CLIENT_HELLO2_LEN: i64 = 512
fn retry_client_hello2() -> StrView
    return ""

const RETRY_SERVER_HELLO_RECORD_LEN: i64 = 128
fn retry_server_hello_record() -> StrView
    return "160303007b020000770303bb341d847fd789c47c387172dc0c9bf147fccacb5043d86ca4c598d3ff571b9800130100004f003300450017004104583e054b7a66672ae020ad9d2686fcc85b5ad41a134a0f03ee72b893052bd85b4c8de6776f5b04ac07d83540eab3e3d9c547bc6528c4317d294686093a6cad7d002b00020304"

const RETRY_SERVER_FLIGHT_RECORD_LEN: i64 = 667
fn retry_server_flight_record() -> StrView
    return ""

const RETRY_CLIENT_AP_SECRET_LEN: i64 = 32
fn retry_client_ap_secret() -> StrView
    return "75ecf4b972525aa0dcd057c9944d4cd5d82671d8843141d7dc2a4ff15a21dc51"

const RETRY_SERVER_AP_SECRET_LEN: i64 = 32
fn retry_server_ap_secret() -> StrView
    return "5c74f87df04225db0f8209c9de6429e49435fdefa7cad61864874d12f31cfc8d"

const RETRY_SERVER_AP_KEY_LEN: i64 = 16
fn retry_server_ap_key() -> StrView
    return "f27a5d97bd25550c4823b0f3e5d29388"

const RETRY_SERVER_AP_IV_LEN: i64 = 12
fn retry_server_ap_iv() -> StrView
    return "0dd631f7b71cbbc797c35fe7"

const RETRY_CLIENT_AP_KEY_LEN: i64 = 16
fn retry_client_ap_key() -> StrView
    return "a7eb2a0525eb4331d58fcbf9f7ca2e9c"

const RETRY_CLIENT_AP_IV_LEN: i64 = 12
fn retry_client_ap_iv() -> StrView
    return "86e8be227c1bd2b3e39cb444"

const RETRY_CLIENT_FINISHED_RECORD_LEN: i64 = 58
fn retry_client_finished_record() -> StrView
    return "1703030035d74f1923c662fd34137c6f502f3dd2b93d951d1b3bc97e42afe23c31abea92fe91b474999e85e3b791ce252fe8c3e9f939a4120cb2"

const RETRY_HASH_THROUGH_CLIENT_FINISHED_LEN: i64 = 32
fn retry_hash_through_client_finished() -> StrView
    return "0e8b349158b855fdcd0c11dbbc4e83e43caa6e483c6c65df53151888e50165f4"

# The server's leaf certificate sits in the flight after EncryptedExtensions
# (40 bytes) and the Certificate headers (4 + 1 + 3 + 3).
const LEAF_OFFSET: i64 = 51
const LEAF_LEN: i64 = 432

fn hex_val(c: u8) -> u8
    if c >= 97
        return c - 97 + 10
    return c - 48

fn from_hex(out: *u8, hex: StrView, len: i64)
    var i: i64 = 0
    while i < len
        out[i] = (hex_val(hex.get(i * 2)) << 4) | hex_val(hex.get(i * 2 + 1))
        i += 1

fn eq_hex(got: *u8, hex: StrView, len: i64) -> i32
    var i: i64 = 0
    while i < len
        if got[i] != ((hex_val(hex.get(i * 2)) << 4) | hex_val(hex.get(i * 2 + 1)))
            return 0
        i += 1
    return 1

# Run the trace up to and including the client's Finished, which lands in
# `out`. Returns 0, or the number of the step that went wrong.
fn run_trace(client: *TlsClient, cfg: *TlsConfig, out: *u8, out_len: *i64) -> i32
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)

    tls_config_init(cfg)
    tls_config_set_hostname(cfg, "rsa", 3)
    if tls_config_pin_cert(cfg, @flight[LEAF_OFFSET], LEAF_LEN) != 0
        return 1
    if tls_client_init(client, cfg) != 0
        return 2

    var hello: [CLIENT_HELLO_LEN]u8
    from_hex(@hello[0], client_hello(), CLIENT_HELLO_LEN)
    transcript_update(@client.transcript, @hello[0], CLIENT_HELLO_LEN)
    from_hex(@client.client_hello.x25519_private[0], client_x25519_private(), CLIENT_X25519_PRIVATE_LEN)
    client.client_hello.session_id_len = 0  # the trace's hello has none
    client.state = TLS_STATE_CLIENT_HELLO_SENT

    var sh: [SERVER_HELLO_RECORD_LEN]u8
    from_hex(@sh[0], server_hello_record(), SERVER_HELLO_RECORD_LEN)
    if tls_client_process(client, @sh[0], SERVER_HELLO_RECORD_LEN, out, 256, out_len) != TLS_RESULT_NEED_INPUT
        return 3

    var rec: [SERVER_FLIGHT_RECORD_LEN]u8
    from_hex(@rec[0], server_flight_record(), SERVER_FLIGHT_RECORD_LEN)
    if tls_client_process(client, @rec[0], SERVER_FLIGHT_RECORD_LEN, out, 256, out_len) != TLS_RESULT_HAVE_OUTPUT
        return 4
    return 0

# Run the HelloRetryRequest trace up to and including the client's Finished.
# Section 5 uses section 3's certificate. The trace's HRR goes through the real
# client, which answers it with a second ClientHello of its own; the transcript
# then takes the trace's in its place, as the first hello did. Returns 0, or
# the number of the step that went wrong.
fn run_retry_trace(client: *TlsClient, cfg: *TlsConfig, out: *u8, out_len: *i64) -> i32
    var flight: [SERVER_FLIGHT_LEN]u8
    from_hex(@flight[0], server_flight(), SERVER_FLIGHT_LEN)

    tls_config_init(cfg)
    tls_config_set_hostname(cfg, "rsa", 3)
    if tls_config_pin_cert(cfg, @flight[LEAF_OFFSET], LEAF_LEN) != 0
        return 1
    if tls_client_init(client, cfg) != 0
        return 2

    var hello1: [RETRY_CLIENT_HELLO1_LEN]u8
    from_hex(@hello1[0], retry_client_hello1(), RETRY_CLIENT_HELLO1_LEN)
    transcript_update(@client.transcript, @hello1[0], RETRY_CLIENT_HELLO1_LEN)
    client.client_hello.session_id_len = 0  # the trace's hello has none
    client.state = TLS_STATE_CLIENT_HELLO_SENT

    var hrr: [RETRY_HRR_RECORD_LEN]u8
    from_hex(@hrr[0], retry_hrr_record(), RETRY_HRR_RECORD_LEN)
    if tls_client_process(client, @hrr[0], RETRY_HRR_RECORD_LEN, out, 2048, out_len) != TLS_RESULT_HAVE_OUTPUT
        return 3

    var hello2: [RETRY_CLIENT_HELLO2_LEN]u8
    from_hex(@hello2[0], retry_client_hello2(), RETRY_CLIENT_HELLO2_LEN)
    transcript_init(@client.transcript)
    transcript_update(@client.transcript, @hello1[0], RETRY_CLIENT_HELLO1_LEN)
    transcript_restart_for_retry(@client.transcript)
    transcript_update(@client.transcript, @hrr[5], RETRY_HRR_RECORD_LEN - 5)
    transcript_update(@client.transcript, @hello2[0], RETRY_CLIENT_HELLO2_LEN)
    from_hex(@client.client_hello.p256_private[0], retry_p256_private(), RETRY_P256_PRIVATE_LEN)

    var sh: [RETRY_SERVER_HELLO_RECORD_LEN]u8
    from_hex(@sh[0], retry_server_hello_record(), RETRY_SERVER_HELLO_RECORD_LEN)
    if tls_client_process(client, @sh[0], RETRY_SERVER_HELLO_RECORD_LEN, out, 2048, out_len) != TLS_RESULT_NEED_INPUT
        return 4

    var rec: [RETRY_SERVER_FLIGHT_RECORD_LEN]u8
    from_hex(@rec[0], retry_server_flight_record(), RETRY_SERVER_FLIGHT_RECORD_LEN)
    if tls_client_process(client, @rec[0], RETRY_SERVER_FLIGHT_RECORD_LEN, out, 2048, out_len) != TLS_RESULT_HAVE_OUTPUT
        return 5
    return 0

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_rfc8448_client_finished_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if out_len != CLIENT_FINISHED_RECORD_LEN
        return 10
    if eq_hex(@out[0], client_finished_record(), CLIENT_FINISHED_RECORD_LEN) != 1
        return 11
    return 0

# RFC 8446 7.1: both secrets hash ClientHello...server Finished.
[[test]]
fn test_rfc8448_client_application_traffic_secrets() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if eq_hex(@client.key_schedule.client_application_traffic_secret[0], client_ap_secret(), 32) != 1
        return 10
    if eq_hex(@client.key_schedule.server_application_traffic_secret[0], server_ap_secret(), 32) != 1
        return 11
    return 0

[[test]]
fn test_rfc8448_client_application_keys() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if eq_hex(@client.write_state.client_key[0], client_ap_key(), CLIENT_AP_KEY_LEN) != 1
        return 10
    if eq_hex(@client.write_state.client_iv[0], client_ap_iv(), CLIENT_AP_IV_LEN) != 1
        return 11
    if eq_hex(@client.read_state.server_key[0], server_ap_key(), SERVER_AP_KEY_LEN) != 1
        return 12
    if eq_hex(@client.read_state.server_iv[0], server_ap_iv(), SERVER_AP_IV_LEN) != 1
        return 13
    return 0

# The bug's real symptom: a peer's first application record.
[[test]]
fn test_rfc8448_client_writes_application_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    var payload: [CLIENT_APP_PAYLOAD_LEN]u8
    from_hex(@payload[0], client_app_payload(), CLIENT_APP_PAYLOAD_LEN)
    if tls_client_write(@client, @payload[0], CLIENT_APP_PAYLOAD_LEN, @out[0], 256) != CLIENT_APP_RECORD_LEN
        return 10
    if eq_hex(@out[0], client_app_record(), CLIENT_APP_RECORD_LEN) != 1
        return 11
    return 0

[[test]]
fn test_rfc8448_client_reads_application_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    # The trace's server sends a NewSessionTicket first, as record 0.
    client.read_state.server_seq = 1
    var rec: [SERVER_APP_RECORD_LEN]u8
    from_hex(@rec[0], server_app_record(), SERVER_APP_RECORD_LEN)
    if tls_client_read(@client, @rec[0], SERVER_APP_RECORD_LEN, @out[0], 256) != CLIENT_APP_PAYLOAD_LEN
        return 10
    if eq_hex(@out[0], client_app_payload(), CLIENT_APP_PAYLOAD_LEN) != 1
        return 11
    return 0

# resumption_master_secret does hash the client Finished: it must still reach
# the transcript, after the application secrets are taken.
[[test]]
fn test_rfc8448_client_transcript_ends_with_client_finished() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    var th: [32]u8
    transcript_hash(@client.transcript, @th[0])
    if eq_hex(@th[0], hash_through_client_finished(), 32) != 1
        return 10
    return 0

# The same answers after a HelloRetryRequest, whose transcript opens with
# message_hash(ClientHello1) (RFC 8446 4.4.1).
[[test]]
fn test_rfc8448_retry_client_finished_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [2048]u8
    var out_len: i64 = 0
    let r: i32 = run_retry_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if out_len != RETRY_CLIENT_FINISHED_RECORD_LEN
        return 10
    if eq_hex(@out[0], retry_client_finished_record(), RETRY_CLIENT_FINISHED_RECORD_LEN) != 1
        return 11
    return 0

[[test]]
fn test_rfc8448_retry_application_traffic_secrets() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [2048]u8
    var out_len: i64 = 0
    let r: i32 = run_retry_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if eq_hex(@client.key_schedule.client_application_traffic_secret[0], retry_client_ap_secret(), 32) != 1
        return 10
    if eq_hex(@client.key_schedule.server_application_traffic_secret[0], retry_server_ap_secret(), 32) != 1
        return 11
    return 0

[[test]]
fn test_rfc8448_retry_application_keys() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [2048]u8
    var out_len: i64 = 0
    let r: i32 = run_retry_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    if eq_hex(@client.write_state.client_key[0], retry_client_ap_key(), RETRY_CLIENT_AP_KEY_LEN) != 1
        return 10
    if eq_hex(@client.write_state.client_iv[0], retry_client_ap_iv(), RETRY_CLIENT_AP_IV_LEN) != 1
        return 11
    if eq_hex(@client.read_state.server_key[0], retry_server_ap_key(), RETRY_SERVER_AP_KEY_LEN) != 1
        return 12
    if eq_hex(@client.read_state.server_iv[0], retry_server_ap_iv(), RETRY_SERVER_AP_IV_LEN) != 1
        return 13
    return 0

[[test]]
fn test_rfc8448_retry_transcript_ends_with_client_finished() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var out: [2048]u8
    var out_len: i64 = 0
    let r: i32 = run_retry_trace(@client, @cfg, @out[0], @out_len)
    if r != 0
        return r
    var th: [32]u8
    transcript_hash(@client.transcript, @th[0])
    if eq_hex(@th[0], retry_hash_through_client_finished(), 32) != 1
        return 10
    return 0
