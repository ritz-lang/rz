# ============================================================================
# Post-handshake messages (RFC 8446 4.6), alerts (RFC 8446 6)
# ============================================================================
#
# After the section 3 trace the test plays the server: it encrypts records
# under the client's own application keys, so it can send what the trace
# does not (a KeyUpdate, a split ticket, a fatal alert).

# A record state that writes as the server and reads what the client writes.
fn server_writer(client: *TlsClient, srv: *TlsRecordState)
    tls_record_state_init(srv)
    tls_record_state_set_keys(srv, @client.write_state.client_key[0], @client.write_state.client_iv[0], @client.read_state.server_key[0], @client.read_state.server_iv[0], 16)
    srv.server_seq = client.read_state.server_seq
    srv.client_seq = client.write_state.client_seq

# Server -> client: one record of `content_type` holding msg[0..len].
# Returns tls_client_read's result.
fn server_send(client: *TlsClient, srv: *TlsRecordState, content_type: u8, msg: *u8, len: i64) -> i64
    var rec: [1024]u8
    let n: i32 = tls_record_state_server_encrypt(srv, msg, len as i32, content_type, @rec[0], 1024)
    if n < 0
        return -100
    var out: [256]u8
    return tls_client_read(client, @rec[0], n as i64, @out[0], 256)

# A well-formed NewSessionTicket: lifetime, age_add, a 1-byte nonce, a 3-byte
# ticket, no extensions. Writes TICKET_LEN bytes to `out`.
const TICKET_LEN: i64 = 21
fn make_ticket(out: *u8)
    from_hex(out, "04000011000070800102030401aa0003bbccdd0000", TICKET_LEN)

# Connected through the section 3 trace, with the server's writer alongside.
fn connected(client: *TlsClient, cfg: *TlsConfig, srv: *TlsRecordState) -> i32
    var out: [256]u8
    var out_len: i64 = 0
    let r: i32 = run_trace(client, cfg, @out[0], @out_len)
    if r != 0
        return r
    server_writer(client, srv)
    return 0

# RFC 8446 7.2: application_traffic_secret_N+1 =
#     HKDF-Expand-Label(application_traffic_secret_N, "traffic upd", "", 32)
fn next_secret(secret: *u8, out: *u8) -> i32
    match hkdf_expand_label(secret, "traffic upd", 11, null, 0, out, 32)
        Ok(_) => return 0
        Err(_) => return -1

# Server -> client application data; 0 if the client reads it back intact.
fn data_from_server(client: *TlsClient, srv: *TlsRecordState, msg: StrView) -> i32
    let n: i64 = strview_len(msg)
    var rec: [1024]u8
    let rec_len: i32 = tls_record_state_server_encrypt(srv, strview_as_ptr(msg), n as i32, 23, @rec[0], 1024)
    if rec_len < 0
        return -100
    var out: [256]u8
    if tls_client_read(client, @rec[0], rec_len as i64, @out[0], 256) != n
        return -1
    if mem_eq(@out[0], strview_as_ptr(msg), n as u64) != 1
        return -2
    return 0

# OpenSSL sends two tickets, each in its own record, before any data.
[[test]]
fn test_post_handshake_tickets_then_application_data() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ticket: [TICKET_LEN]u8
    make_ticket(@ticket[0])
    if server_send(@client, @srv, 22, @ticket[0], TICKET_LEN) != 0
        return 10
    if server_send(@client, @srv, 22, @ticket[0], TICKET_LEN) != 0
        return 11
    if data_from_server(@client, @srv, "HTTP/1.1 200 OK\r\n") != 0
        return 12
    return 0

[[test]]
fn test_post_handshake_two_tickets_in_one_record() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var two: [42]u8
    make_ticket(@two[0])
    make_ticket(@two[TICKET_LEN])
    if server_send(@client, @srv, 22, @two[0], 2 * TICKET_LEN) != 0
        return 10
    if data_from_server(@client, @srv, "hello") != 0
        return 11
    return 0

# A handshake message may span records (RFC 8446 5.1).
[[test]]
fn test_post_handshake_ticket_split_across_records() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ticket: [TICKET_LEN]u8
    make_ticket(@ticket[0])
    if server_send(@client, @srv, 22, @ticket[0], 7) != 0
        return 10
    if client.hs_len != 7
        return 11
    if server_send(@client, @srv, 22, @ticket[7], TICKET_LEN - 7) != 0
        return 12
    if client.hs_len != 0
        return 13
    if data_from_server(@client, @srv, "hello") != 0
        return 14
    return 0

# ...but must not be interleaved with other content (RFC 8446 5.1).
[[test]]
fn test_post_handshake_refuses_data_inside_split_message() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ticket: [TICKET_LEN]u8
    make_ticket(@ticket[0])
    if server_send(@client, @srv, 22, @ticket[0], 7) != 0
        return 10
    if data_from_server(@client, @srv, "hello") == 0
        return 11
    if tls_client_error(@client) != TLS_ERR_UNEXPECTED_MESSAGE
        return 12
    return 0

[[test]]
fn test_post_handshake_refuses_malformed_ticket() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ticket: [TICKET_LEN]u8
    make_ticket(@ticket[0])
    ticket[15] = 4  # ticket length 4: runs over the extensions length
    if server_send(@client, @srv, 22, @ticket[0], TICKET_LEN) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PARSE_ERROR
        return 11
    return 0

[[test]]
fn test_post_handshake_refuses_empty_ticket() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    # ticket<1..2^16-1>: a zero-length ticket is malformed.
    var ticket: [18]u8
    from_hex(@ticket[0], "0400000e000070800102030401aa00000000", 18)
    if server_send(@client, @srv, 22, @ticket[0], 18) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PARSE_ERROR
        return 11
    return 0

# The fields must fill the body exactly: a trailing byte is malformed.
[[test]]
fn test_post_handshake_refuses_ticket_with_trailing_byte() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var ticket: [22]u8
    from_hex(@ticket[0], "04000012000070800102030401aa0003bbccdd000000", 22)
    if server_send(@client, @srv, 22, @ticket[0], 22) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_PARSE_ERROR
        return 11
    return 0

# Anything but NewSessionTicket and KeyUpdate is unexpected after the
# handshake (no post_handshake_auth was offered), and the failure sticks.
[[test]]
fn test_post_handshake_refuses_unknown_handshake_type() -> i32
    var cfg: TlsConfig
    var client: TlsClient
    var srv: TlsRecordState
    let r: i32 = connected(@client, @cfg, @srv)
    if r != 0
        return r
    var msg: [5]u8
    from_hex(@msg[0], "6300000100", 5)
    if server_send(@client, @srv, 22, @msg[0], 5) != -1
        return 10
    if tls_client_error(@client) != TLS_ERR_UNEXPECTED_MESSAGE
        return 11
    if tls_client_state(@client) != TLS_STATE_ERROR
        return 12
    if data_from_server(@client, @srv, "hello") == 0
        return 13
    return 0

