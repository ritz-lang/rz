# test/test_tls13_rfc8448.ritz - TLS client known answers, RFC 8448 sections 3, 5
#
# The simple 1-RTT and HelloRetryRequest traces, driven through the real
# client. An in-process loopback cannot catch a mistake both ends share
# (#2186): these bytes come from someone else's implementation. The client's
# ClientHello is not the trace's, so the test injects that message and the
# trace's private key, then feeds the server's records to tls_client_process
# unchanged.

import ritzlib.strview

import cryptosec.mem
import cryptosec.tls13_client
import cryptosec.tls13_handshake
import cryptosec.tls13_kdf
import cryptosec.tls13_record

