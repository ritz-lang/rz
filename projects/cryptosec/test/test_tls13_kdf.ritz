# test/test_tls13_kdf.ritz - Tests for TLS 1.3 Key Derivation Functions
#
# Test vectors from RFC 8448 "Example Handshake Traces for TLS 1.3"
# https://datatracker.ietf.org/doc/html/rfc8448
#
# Key schedule from RFC 8446 Section 7.1:
#
#              0
#              |
#              v
#    PSK ->  HKDF-Extract = Early Secret
#              |
#              +-----> Derive-Secret(., "ext binder" | "res binder", "")
#              |                     = binder_key
#              +-----> Derive-Secret(., "c e traffic", ClientHello)
#              |                     = client_early_traffic_secret
#              +-----> Derive-Secret(., "e exp master", ClientHello)
#              |                     = early_exporter_master_secret
#              v
#        Derive-Secret(., "derived", "")
#              |
#              v
#   (EC)DHE -> HKDF-Extract = Handshake Secret
#              |
#              +-----> Derive-Secret(., "c hs traffic", ClientHello...ServerHello)
#              |                     = client_handshake_traffic_secret
#              +-----> Derive-Secret(., "s hs traffic", ClientHello...ServerHello)
#              |                     = server_handshake_traffic_secret
#              v
#        Derive-Secret(., "derived", "")
#              |
#              v
#        0 -> HKDF-Extract = Master Secret
#              |
#              +-----> Derive-Secret(., "c ap traffic", ...)
#              |                     = client_application_traffic_secret_0
#              +-----> Derive-Secret(., "s ap traffic", ...)
#              |                     = server_application_traffic_secret_0
#              +-----> Derive-Secret(., "exp master", ...)
#              |                     = exporter_master_secret
#              +-----> Derive-Secret(., "res master", ...)
#                                    = resumption_master_secret

import ritzlib.sys
import ritzlib.io
import ritzlib.strview

import cryptosec.tls13_kdf
import cryptosec.hkdf
import cryptosec.crypto_error
import cryptosec.mem
import cryptosec.sha256

# ============================================================================
# Helper: hex conversion
# ============================================================================

fn hex_char_to_val(c: u8) -> u8
    if c >= 48
        if c <= 57
            return c - 48
    if c >= 97
        if c <= 102
            return c - 97 + 10
    if c >= 65
        if c <= 70
            return c - 65 + 10
    return 0

fn bytes_eq_hex(bytes: *u8, hex: StrView, len: i32) -> i32
    var i: i32 = 0
    while i < len
        let hi: u8 = hex_char_to_val(hex.get(i * 2))
        let lo: u8 = hex_char_to_val(hex.get(i * 2 + 1))
        let expected: u8 = (hi << 4) | lo
        if bytes[i] != expected
            return 0
        i += 1
    return 1

fn fill_from_hex(out: *u8, hex: StrView, len: i32)
    var i: i32 = 0
    while i < len
        let hi: u8 = hex_char_to_val(hex.get(i * 2))
        let lo: u8 = hex_char_to_val(hex.get(i * 2 + 1))
        out[i] = (hi << 4) | lo
        i += 1

fn print_hex_bytes(data: *u8, len: i32)
    var i: i32 = 0
    let hex_chars = "0123456789abcdef"
    var buf: [2]u8
    while i < len
        let b: u8 = data[i]
        buf[0] = hex_chars.get((b >> 4) as i64)
        buf[1] = hex_chars.get((b & 0x0f) as i64)
        sys_write(1, @buf[0], 2)
        i += 1
    println("")

# ============================================================================
# HKDF-Expand-Label tests (RFC 8446 Section 7.1)
# ============================================================================

# HKDF-Expand-Label(Secret, Label, Context, Length) =
#      HKDF-Expand(Secret, HkdfLabel, Length)
#
# struct {
#     uint16 length = Length;
#     opaque label<7..255> = "tls13 " + Label;
#     opaque context<0..255> = Context;
# } HkdfLabel;

[[test]]
fn test_hkdf_expand_label_basic() -> i32
    # Test with a known secret and empty context
    var secret: [32]u8
    var i: i32 = 0
    while i < 32
        secret[i] = (i + 1) as u8
        i += 1

    var output: [32]u8
    hkdf_expand_label(@secret[0], "derived", 7, null, 0, @output[0], 32)

    # Output should not be all zeros
    if mem_is_zero(@output[0], 32) == 1
        return 1
    0

[[test]]
fn test_hkdf_expand_label_with_context() -> i32
    # Test with transcript hash as context
    var secret: [32]u8
    var context: [32]u8
    var i: i32 = 0
    while i < 32
        secret[i] = 0xaa
        context[i] = 0xbb
        i += 1

    var output: [32]u8
    hkdf_expand_label(@secret[0], "c hs traffic", 12, @context[0], 32, @output[0], 32)

    if mem_is_zero(@output[0], 32) == 1
        return 1
    0

[[test]]
fn test_hkdf_expand_label_deterministic() -> i32
    # Same inputs should produce same output
    var secret: [32]u8
    var i: i32 = 0
    while i < 32
        secret[i] = (i * 3) as u8
        i += 1

    var out1: [32]u8
    var out2: [32]u8

    hkdf_expand_label(@secret[0], "key", 3, null, 0, @out1[0], 32)
    hkdf_expand_label(@secret[0], "key", 3, null, 0, @out2[0], 32)

    if mem_eq(@out1[0], @out2[0], 32) != 1
        return 1
    0

[[test]]
fn test_hkdf_expand_label_different_labels() -> i32
    # Different labels should produce different output
    var secret: [32]u8
    var i: i32 = 0
    while i < 32
        secret[i] = 0x42
        i += 1

    var out1: [32]u8
    var out2: [32]u8

    hkdf_expand_label(@secret[0], "key", 3, null, 0, @out1[0], 32)
    hkdf_expand_label(@secret[0], "iv", 2, null, 0, @out2[0], 32)

    if mem_eq(@out1[0], @out2[0], 32) == 1
        return 1  # Should be different
    0

# ============================================================================
# Derive-Secret tests
# ============================================================================

[[test]]
fn test_derive_secret_basic() -> i32
    # Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret, Label, Hash(Messages), Hash.length)
    var secret: [32]u8
    var i: i32 = 0
    while i < 32
        secret[i] = (i + 0x10) as u8
        i += 1

    var output: [32]u8
    # Empty messages -> hash of empty string
    derive_secret(@secret[0], "derived", 7, null, 0, @output[0])

    if mem_is_zero(@output[0], 32) == 1
        return 1
    0

[[test]]
fn test_derive_secret_with_messages() -> i32
    # With actual message data
    var secret: [32]u8
    var messages: [64]u8
    var i: i32 = 0
    while i < 32
        secret[i] = 0xcc
        i += 1
    i = 0
    while i < 64
        messages[i] = (i % 256) as u8
        i += 1

    var output: [32]u8
    derive_secret(@secret[0], "c hs traffic", 12, @messages[0], 64, @output[0])

    if mem_is_zero(@output[0], 32) == 1
        return 1
    0

# ============================================================================
# RFC 8448 Test Vectors - Simple 1-RTT Handshake
# ============================================================================

# These test vectors are from RFC 8448 Section 3 "Simple 1-RTT Handshake"
# Using TLS_AES_128_GCM_SHA256 (0x1301)

[[test]]
fn test_rfc8448_early_secret() -> i32
    # Without PSK, early_secret = HKDF-Extract(0, 0)
    # expected early_secret: 33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a
    var early_secret: [32]u8
    tls13_early_secret(null, 0, @early_secret[0])

    let expected = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
    if bytes_eq_hex(@early_secret[0], expected, 32) != 1
        # print_hex("got early_secret", @early_secret[0], 32)
        return 1
    0

[[test]]
fn test_rfc8448_derived_secret_from_early() -> i32
    # derived = Derive-Secret(early_secret, "derived", "")
    # From early_secret, derive intermediate secret for handshake
    var early_secret: [32]u8
    let early_hex = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
    fill_from_hex(@early_secret[0], early_hex, 32)

    var derived: [32]u8
    derive_secret(@early_secret[0], "derived", 7, null, 0, @derived[0])

    # RFC 8448: derived secret = 6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba
    let expected = "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
    if bytes_eq_hex(@derived[0], expected, 32) != 1
        # print_hex("got derived", @derived[0], 32)
        return 1
    0

[[test]]
fn test_rfc8448_handshake_secret() -> i32
    # handshake_secret = HKDF-Extract(derived, shared_secret)
    # RFC 8448 shared_secret (from X25519):
    # 8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d

    var derived: [32]u8
    let derived_hex = "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
    fill_from_hex(@derived[0], derived_hex, 32)

    var shared_secret: [32]u8
    let shared_hex = "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"
    fill_from_hex(@shared_secret[0], shared_hex, 32)

    var handshake_secret: [32]u8
    tls13_handshake_secret(@derived[0], @shared_secret[0], 32, @handshake_secret[0])

    # RFC 8448: handshake_secret = 1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac
    let expected = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    if bytes_eq_hex(@handshake_secret[0], expected, 32) != 1
        # print_hex("got handshake_secret", @handshake_secret[0], 32)
        return 1
    0

[[test]]
fn test_rfc8448_client_handshake_traffic_secret() -> i32
    # c_hs_traffic = Derive-Secret(handshake_secret, "c hs traffic", ClientHello...ServerHello)
    # transcript_hash from RFC 8448:
    # 860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8

    var hs_secret: [32]u8
    let hs_hex = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    fill_from_hex(@hs_secret[0], hs_hex, 32)

    var transcript_hash: [32]u8
    let transcript_hex = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"
    fill_from_hex(@transcript_hash[0], transcript_hex, 32)

    var c_hs_traffic: [32]u8
    # Use transcript hash directly as context (it's already hashed)
    hkdf_expand_label(@hs_secret[0], "c hs traffic", 12, @transcript_hash[0], 32, @c_hs_traffic[0], 32)

    # RFC 8448: b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21
    let expected = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
    if bytes_eq_hex(@c_hs_traffic[0], expected, 32) != 1
        # print_hex("got c_hs_traffic", @c_hs_traffic[0], 32)
        return 1
    0

[[test]]
fn test_rfc8448_server_handshake_traffic_secret() -> i32
    # s_hs_traffic = Derive-Secret(handshake_secret, "s hs traffic", ClientHello...ServerHello)

    var hs_secret: [32]u8
    let hs_hex = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    fill_from_hex(@hs_secret[0], hs_hex, 32)

    var transcript_hash: [32]u8
    let transcript_hex = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"
    fill_from_hex(@transcript_hash[0], transcript_hex, 32)

    var s_hs_traffic: [32]u8
    hkdf_expand_label(@hs_secret[0], "s hs traffic", 12, @transcript_hash[0], 32, @s_hs_traffic[0], 32)

    # RFC 8448: b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38
    let expected = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
    if bytes_eq_hex(@s_hs_traffic[0], expected, 32) != 1
        # print_hex("got s_hs_traffic", @s_hs_traffic[0], 32)
        return 1
    0

[[test]]
fn test_rfc8448_traffic_key_derivation() -> i32
    # From client_handshake_traffic_secret, derive key and IV
    # key = HKDF-Expand-Label(Secret, "key", "", key_length)
    # iv = HKDF-Expand-Label(Secret, "iv", "", iv_length)

    var c_hs_traffic: [32]u8
    let c_hs_hex = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
    fill_from_hex(@c_hs_traffic[0], c_hs_hex, 32)

    var key: [16]u8  # AES-128 key length
    var iv: [12]u8   # GCM IV length

    hkdf_expand_label(@c_hs_traffic[0], "key", 3, null, 0, @key[0], 16)
    hkdf_expand_label(@c_hs_traffic[0], "iv", 2, null, 0, @iv[0], 12)

    # RFC 8448:
    # client_handshake_key: dbfaa693d1762c5b666af5d950258d01
    # client_handshake_iv: 5bd3c71b836e0b76bb73265f

    let expected_key = "dbfaa693d1762c5b666af5d950258d01"
    let expected_iv = "5bd3c71b836e0b76bb73265f"

    if bytes_eq_hex(@key[0], expected_key, 16) != 1
        # print_hex("got key", @key[0], 16)
        return 1

    if bytes_eq_hex(@iv[0], expected_iv, 12) != 1
        # print_hex("got iv", @iv[0], 12)
        return 2
    0

[[test]]
fn test_rfc8448_server_traffic_key_derivation() -> i32
    # From server_handshake_traffic_secret, derive key and IV

    var s_hs_traffic: [32]u8
    let s_hs_hex = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
    fill_from_hex(@s_hs_traffic[0], s_hs_hex, 32)

    var key: [16]u8
    var iv: [12]u8

    hkdf_expand_label(@s_hs_traffic[0], "key", 3, null, 0, @key[0], 16)
    hkdf_expand_label(@s_hs_traffic[0], "iv", 2, null, 0, @iv[0], 12)

    # RFC 8448:
    # server_handshake_key: 3fce516009c21727d0f2e4e86ee403bc
    # server_handshake_iv: 5d313eb2671276ee13000b30

    let expected_key = "3fce516009c21727d0f2e4e86ee403bc"
    let expected_iv = "5d313eb2671276ee13000b30"

    if bytes_eq_hex(@key[0], expected_key, 16) != 1
        # print_hex("got key", @key[0], 16)
        return 1

    if bytes_eq_hex(@iv[0], expected_iv, 12) != 1
        # print_hex("got iv", @iv[0], 12)
        return 2
    0

[[test]]
fn test_rfc8448_master_secret() -> i32
    # master_secret = HKDF-Extract(derived_from_hs, 0)
    # derived_from_hs = Derive-Secret(handshake_secret, "derived", "")

    var hs_secret: [32]u8
    let hs_hex = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    fill_from_hex(@hs_secret[0], hs_hex, 32)

    var derived: [32]u8
    derive_secret(@hs_secret[0], "derived", 7, null, 0, @derived[0])

    var master_secret: [32]u8
    tls13_master_secret(@derived[0], @master_secret[0])

    # RFC 8448: master_secret = 18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919
    let expected = "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"
    if bytes_eq_hex(@master_secret[0], expected, 32) != 1
        # print_hex("got master_secret", @master_secret[0], 32)
        return 1
    0

# ============================================================================
# Full key schedule test
# ============================================================================

[[test]]
fn test_tls13_key_schedule_full() -> i32
    # Test the full TLS13KeySchedule struct workflow

    var ks: TLS13KeySchedule
    tls13_key_schedule_init(@ks)

    # Verify early secret
    let expected_early = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
    if bytes_eq_hex(@ks.early_secret[0], expected_early, 32) != 1
        # print_hex("early_secret mismatch", @ks.early_secret[0], 32)
        return 1

    # Advance to handshake with shared secret
    var shared_secret: [32]u8
    let shared_hex = "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"
    fill_from_hex(@shared_secret[0], shared_hex, 32)

    var transcript_hash: [32]u8
    let transcript_hex = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"
    fill_from_hex(@transcript_hash[0], transcript_hex, 32)

    tls13_key_schedule_derive_handshake(@ks, @shared_secret[0], 32, @transcript_hash[0])

    # Verify handshake secret
    let expected_hs = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    if bytes_eq_hex(@ks.handshake_secret[0], expected_hs, 32) != 1
        # print_hex("handshake_secret mismatch", @ks.handshake_secret[0], 32)
        return 2

    # Verify client handshake traffic secret
    let expected_c_hs = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
    if bytes_eq_hex(@ks.client_handshake_traffic_secret[0], expected_c_hs, 32) != 1
        # print_hex("c_hs_traffic mismatch", @ks.client_handshake_traffic_secret[0], 32)
        return 3

    # Verify server handshake traffic secret
    let expected_s_hs = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
    if bytes_eq_hex(@ks.server_handshake_traffic_secret[0], expected_s_hs, 32) != 1
        # print_hex("s_hs_traffic mismatch", @ks.server_handshake_traffic_secret[0], 32)
        return 4

    0

# ============================================================================
# tls13_key_schedule_init clears the whole struct (AGAST #1917)
# ============================================================================
# It zeroed a hard-coded 296 bytes of a 348-byte TLS13KeySchedule, leaving
# server_write_key's tail and server_write_iv as they were.

[[test]]
fn test_key_schedule_init_clears_whole_struct() -> i32
    var ks: TLS13KeySchedule
    for i in 0..sizeof(TLS13KeySchedule)
        *((@ks as *u8) + i) = 0xAA as u8
    tls13_key_schedule_init(@ks)
    if mem_is_zero(@ks.server_write_key[0], 32) != 1
        return 1
    if mem_is_zero(@ks.server_write_iv[0], 12) != 1
        return 2
    0

# ============================================================================
# HKDF-Expand-Label length limits (AGAST #2579, GitHub #140)
#
# RFC 8446 §7.1: label<7..255> = "tls13 " + Label, so Label is 1..249 bytes;
# context<0..255>; Length is a uint16. hkdf_expand_label used to build the
# HkdfLabel in a 256-byte stack buffer with no checks, so a long label or
# context wrote past it. Out of range now means Err(InvalidLength) and no
# output written.
# ============================================================================

fn kdf_ok_len(r: Result<i64, CryptoError>) -> i64
    match r
        Ok(n) => n
        Err(_) => -1

fn kdf_is_invalid_length(r: Result<i64, CryptoError>) -> bool
    match r
        Ok(_) => false
        Err(e) =>
            match e
                CryptoError.InvalidLength => true
                _ => false

fn kdf_fill(buf: *u8, seed: i64, len: i64)
    var i: i64 = 0
    while i < len
        buf[i] = ((i * 13 + seed) & 0xff) as u8
        i += 1

# HKDF-Expand(secret, HkdfLabel, out_len) with the HkdfLabel built by hand.
fn expand_label_by_hand(secret: *u8, label: *u8, label_len: i64, context: *u8, context_len: i64, out: *u8, out_len: i64)
    var info: [600]u8
    info[0] = ((out_len >> 8) & 0xff) as u8
    info[1] = (out_len & 0xff) as u8
    info[2] = (6 + label_len) as u8
    let prefix = "tls13 "
    mem_copy(@info[3], prefix.ptr, 6)
    mem_copy(@info[9], label, label_len)
    info[9 + label_len] = context_len as u8
    mem_copy(@info[10 + label_len], context, context_len)
    hkdf_expand(secret, @info[0], (10 + label_len + context_len) as u64, out, out_len as u64)

# 0 when hkdf_expand_label returns Ok(32) for these lengths and matches the
# hand-built HkdfLabel, with nothing written outside `out`.
fn check_label_lengths(label_len: i32, context_len: i32) -> i32
    var secret: [32]u8
    kdf_fill(@secret[0], 1, 32)
    var label: [300]u8
    kdf_fill(@label[0], 5, 300)
    var context: [300]u8
    kdf_fill(@context[0], 9, 300)

    var out: [64]u8
    var i: i32 = 0
    while i < 64
        out[i] = 0xa5
        i += 1
    if kdf_ok_len(hkdf_expand_label(@secret[0], @label[0], label_len, @context[0], context_len, @out[16], 32)) != 32
        return 1

    var expected: [32]u8
    expand_label_by_hand(@secret[0], @label[0], label_len as i64, @context[0], context_len as i64, @expected[0], 32)
    if mem_eq(@out[16], @expected[0], 32) != 1
        return 2
    i = 0
    while i < 16
        if out[i] != 0xa5 || out[48 + i] != 0xa5
            return 3
        i += 1
    0

# 0 when hkdf_expand_label refuses these lengths with InvalidLength and
# writes nothing.
fn check_label_refused(label_len: i32, context_len: i32, out_len: i32) -> i32
    var secret: [32]u8
    kdf_fill(@secret[0], 1, 32)
    var label: [300]u8
    kdf_fill(@label[0], 5, 300)
    var context: [300]u8
    kdf_fill(@context[0], 9, 300)

    var out: [64]u8
    var i: i32 = 0
    while i < 64
        out[i] = 0xa5
        i += 1
    if not kdf_is_invalid_length(hkdf_expand_label(@secret[0], @label[0], label_len, @context[0], context_len, @out[0], out_len))
        return 1
    i = 0
    while i < 64
        if out[i] != 0xa5
            return 2
        i += 1
    0

[[test]]
fn test_hkdf_expand_label_label_at_max() -> i32
    # "tls13 " + 249 = 255, the most the label<7..255> length byte allows.
    check_label_lengths(249, 0)

[[test]]
fn test_hkdf_expand_label_label_just_over_max_refused() -> i32
    check_label_refused(250, 0, 32)

[[test]]
fn test_hkdf_expand_label_empty_label_refused() -> i32
    # label<7..255>: "tls13 " alone (6 bytes) is below the floor.
    check_label_refused(0, 0, 32)

[[test]]
fn test_hkdf_expand_label_negative_label_refused() -> i32
    check_label_refused(-1, 0, 32)

[[test]]
fn test_hkdf_expand_label_context_at_max() -> i32
    check_label_lengths(3, 255)

[[test]]
fn test_hkdf_expand_label_context_just_over_max_refused() -> i32
    check_label_refused(3, 256, 32)

[[test]]
fn test_hkdf_expand_label_negative_context_refused() -> i32
    check_label_refused(3, -1, 32)

[[test]]
fn test_hkdf_expand_label_label_and_context_at_max() -> i32
    # 2 + 1 + 255 + 1 + 255 = 514 bytes of HkdfLabel: twice the old buffer.
    check_label_lengths(249, 255)

[[test]]
fn test_hkdf_expand_label_negative_length_refused() -> i32
    check_label_refused(3, 0, -1)

[[test]]
fn test_hkdf_expand_label_length_over_hkdf_max_refused() -> i32
    # 8161 > 255 * 32: HKDF-Expand refuses, and so must the label wrapper.
    check_label_refused(3, 0, 8161)

[[test]]
fn test_hkdf_expand_label_length_over_uint16_refused() -> i32
    check_label_refused(3, 0, 65536)

[[test]]
fn test_hkdf_expand_label_null_context_with_length_refused() -> i32
    # Writing context_len into the struct with no bytes behind it would
    # derive from a label the caller never meant.
    var secret: [32]u8
    kdf_fill(@secret[0], 1, 32)
    var out: [32]u8
    if not kdf_is_invalid_length(hkdf_expand_label(@secret[0], "key", 3, null, 4, @out[0], 32))
        return 1
    0

[[test]]
fn test_derive_secret_and_traffic_keys_return_ok() -> i32
    var secret: [32]u8
    kdf_fill(@secret[0], 1, 32)
    var out: [32]u8
    if kdf_ok_len(derive_secret(@secret[0], "derived", 7, null, 0, @out[0])) != 32
        return 1
    var key: [16]u8
    var iv: [12]u8
    if kdf_ok_len(tls13_derive_traffic_keys(@secret[0], @key[0], 16, @iv[0], 12)) != 28
        return 2
    if not kdf_is_invalid_length(tls13_derive_traffic_keys(@secret[0], @key[0], -1, @iv[0], 12))
        return 3
    0

[[test]]
fn test_key_schedule_key_lengths_bounded_by_struct() -> i32
    # client/server_write_key are [32]u8 and write_iv [12]u8: anything
    # bigger would write past them into the next field.
    var ks: TLS13KeySchedule
    tls13_key_schedule_init(@ks)
    if kdf_ok_len(tls13_key_schedule_derive_handshake_keys(@ks, 32, 12)) != 0
        return 1
    if not kdf_is_invalid_length(tls13_key_schedule_derive_handshake_keys(@ks, 33, 12))
        return 2
    if not kdf_is_invalid_length(tls13_key_schedule_derive_handshake_keys(@ks, 16, 13))
        return 3
    if not kdf_is_invalid_length(tls13_key_schedule_derive_application_keys(@ks, 33, 12))
        return 4
    if not kdf_is_invalid_length(tls13_key_schedule_derive_application_keys(@ks, 16, 13))
        return 5
    if kdf_ok_len(tls13_key_schedule_derive_application_keys(@ks, 16, 12)) != 0
        return 6
    0

[[test]]
fn test_traffic_keys_bad_iv_len_writes_no_key() -> i32
    # A bad iv_len must be refused before the key is derived, not after.
    var secret: [32]u8
    kdf_fill(@secret[0], 1, 32)
    var key: [16]u8
    var i: i32 = 0
    while i < 16
        key[i] = 0xa5
        i += 1
    var iv: [12]u8
    if not kdf_is_invalid_length(tls13_derive_traffic_keys(@secret[0], @key[0], 16, @iv[0], -1))
        return 1
    i = 0
    while i < 16
        if key[i] != 0xa5
            return 2
        i += 1
    0
