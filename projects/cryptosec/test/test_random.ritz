# test/test_random.ritz - Tests for CSPRNG
#
# Tests for lib/random.ritz:
# - getrandom syscall works
# - random_bytes fills buffer
# - random_u64/u32 return values
# - Statistical sanity checks

import ritzlib.sys
import ritzlib.io

import cryptosec.random
import cryptosec.mem

# ============================================================================
# Basic functionality tests
# ============================================================================

[[test]]
fn test_getrandom_syscall() -> i32
    var buf: [32]u8
    # Zero the buffer first
    var i: i32 = 0
    while i < 32
        buf[i] = 0
        i += 1

    let result: i64 = getrandom(@buf[0], 32, 0)

    # Should return 32 (bytes written)
    if result != 32
        return 1

    # Buffer should not be all zeros (statistically impossible)
    let is_zero: i32 = mem_is_zero(@buf[0], 32)
    if is_zero == 1
        return 2

    0

[[test]]
fn test_random_bytes_fills_buffer() -> i32
    var buf: [64]u8
    # Zero the buffer
    var i: i32 = 0
    while i < 64
        buf[i] = 0
        i += 1

    let result: i32 = random_bytes(@buf[0], 64)

    # Should succeed
    if result != 0
        return 1

    # Should not be all zeros
    if mem_is_zero(@buf[0], 64) == 1
        return 2

    0

[[test]]
fn test_random_bytes_zero_length() -> i32
    var buf: [8]u8
    buf[0] = 42  # Sentinel value

    let result: i32 = random_bytes(@buf[0], 0)

    # Should succeed with 0 length
    if result != 0
        return 1

    # Buffer should be unchanged
    if buf[0] != 42
        return 2

    0

[[test]]
fn test_random_u64_nonzero() -> i32
    # Get multiple random values - at least one should be non-zero
    let a: u64 = random_u64()
    let b: u64 = random_u64()
    let c: u64 = random_u64()

    # All three being zero is essentially impossible
    if a == 0
        if b == 0
            if c == 0
                return 1

    0

[[test]]
fn test_random_u32_nonzero() -> i32
    let a: u32 = random_u32()
    let b: u32 = random_u32()
    let c: u32 = random_u32()

    if a == 0
        if b == 0
            if c == 0
                return 1

    0

# ============================================================================
# Uniqueness tests
# ============================================================================

[[test]]
fn test_random_u64_unique() -> i32
    # Two random u64 values should be different (collision probability ~2^-64)
    let a: u64 = random_u64()
    let b: u64 = random_u64()

    if a == b
        return 1

    0

[[test]]
fn test_random_bytes_different_calls() -> i32
    var buf1: [32]u8
    var buf2: [32]u8

    if random_bytes(@buf1[0], 32) != 0
        return 2
    if random_bytes(@buf2[0], 32) != 0
        return 3

    # Buffers should be different
    if mem_eq(@buf1[0], @buf2[0], 32) == 1
        return 1

    0

# ============================================================================
# Distribution sanity checks
# ============================================================================

[[test]]
fn test_random_bytes_distribution() -> i32
    # Statistical test: count bytes in upper vs lower half
    # Should be roughly 50/50 with high probability
    var buf: [256]u8
    if random_bytes(@buf[0], 256) != 0
        return 3

    var upper_count: i32 = 0
    var i: i32 = 0
    while i < 256
        if buf[i] >= 128
            upper_count += 1
        i += 1

    # Expect ~128 in upper half, allow significant deviation
    # Using range [64, 192] which should fail < 0.001% of the time
    if upper_count < 64
        return 1
    if upper_count > 192
        return 2

    0

[[test]]
fn test_random_u64_high_bits_set() -> i32
    # Over multiple samples, at least one should have high bits set
    var any_high: i32 = 0
    var i: i32 = 0

    while i < 10
        let r: u64 = random_u64()
        # Check if bit 63 or 62 is set
        if r >= 0x4000000000000000
            any_high = 1
        i += 1

    # Probability of none having high bits in 10 samples is ~(0.75)^10 < 6%
    # We'll accept occasional test failures for simplicity
    if any_high == 0
        return 1

    0

[[test]]
fn test_random_u64_low_bits_set() -> i32
    # Over multiple samples, at least one should have low bits set
    var any_low: i32 = 0
    var i: i32 = 0

    while i < 10
        let r: u64 = random_u64()
        # Check if any of lower 4 bits is set
        if (r & 0xF) != 0
            any_low = 1
        i += 1

    # Probability of all having 0 in lower 4 bits is (1/16)^10 ~= 0
    if any_low == 0
        return 1

    0

# ============================================================================
# Large buffer test
# ============================================================================

[[test]]
fn test_random_bytes_large_buffer() -> i32
    # Test that we can fill a larger buffer (tests the loop in random_bytes)
    # getrandom typically returns up to 256 bytes per call
    var buf: [512]u8

    # Zero the buffer
    var i: i32 = 0
    while i < 512
        buf[i] = 0
        i += 1

    let result: i32 = random_bytes(@buf[0], 512)

    if result != 0
        return 1

    # Check that the buffer is not all zeros
    if mem_is_zero(@buf[0], 512) == 1
        return 2

    # Check that different parts of the buffer are different
    # (not just repeating the same pattern)
    if mem_eq(@buf[0], @buf[256], 256) == 1
        return 3

    0

# ============================================================================
# Edge cases
# ============================================================================

[[test]]
fn test_random_range_zero() -> i32
    let r: u64 = random_range_u64(0)
    if r != 0
        return 1
    0

[[test]]
fn test_random_range_one() -> i32
    let r: u64 = random_range_u64(1)
    if r != 0
        return 1
    0

[[test]]
fn test_random_range_bounded() -> i32
    # Check that random_range_u64 stays within bounds
    var i: i32 = 0
    while i < 100
        let r: u64 = random_range_u64(100)
        if r >= 100
            return 1
        i += 1
    0

# ============================================================================
# Rejection sampling for random_range_u64 (AGAST #2583, GitHub #144 M-11)
# ============================================================================
# random_range_u64 rejects raw values below random_range_threshold(max)
# = 2^64 mod max, so the accepted range [threshold, 2^64) holds a whole number
# of copies of [0, max) and `v % max` is uniform.

[[test]]
fn test_random_range_threshold_values() -> i32
    # Powers of two divide 2^64: nothing is rejected.
    if random_range_threshold(1) != 0
        return 1
    if random_range_threshold(2) != 0
        return 2
    # 2^64 = 1 (mod 3)
    if random_range_threshold(3) != 1
        return 3
    # 2^64 = 18446744073709551616 = 6 (mod 10)
    if random_range_threshold(10) != 6
        return 4
    # 2^64 - (2^63 + 1) = 2^63 - 1: just under half the space is rejected.
    if random_range_threshold(0x8000000000000001) != 0x7FFFFFFFFFFFFFFF
        return 5
    # 2^64 = 1 (mod 2^64 - 1)
    if random_range_threshold(0xFFFFFFFFFFFFFFFF) != 1
        return 6
    0

[[test]]
fn test_random_range_try_rejects_below_threshold() -> i32
    var out: u64 = 99
    # max = 3: v = 0 lies below the threshold (1) and is rejected.
    if random_range_try(3, 0, @out) != 0
        return 1
    # v = 1 is the first accepted value.
    if random_range_try(3, 1, @out) != 1
        return 2
    if out != 1
        return 3
    # max = 10: 0..5 rejected, 6 accepted.
    if random_range_try(10, 5, @out) != 0
        return 4
    if random_range_try(10, 6, @out) != 1
        return 5
    if out != 6
        return 6
    # max = 2^63 + 1: 2^63 - 2 rejected, 2^63 - 1 accepted.
    if random_range_try(0x8000000000000001, 0x7FFFFFFFFFFFFFFE, @out) != 0
        return 7
    if random_range_try(0x8000000000000001, 0x7FFFFFFFFFFFFFFF, @out) != 1
        return 8
    if out != 0x7FFFFFFFFFFFFFFF
        return 9
    # max = u64::MAX: only v = 0 is rejected.
    if random_range_try(0xFFFFFFFFFFFFFFFF, 0, @out) != 0
        return 10
    if random_range_try(0xFFFFFFFFFFFFFFFF, 1, @out) != 1
        return 11
    if out != 1
        return 12
    0

[[test]]
fn test_random_range_try_reduces_mod_max() -> i32
    var out: u64 = 99
    # Accepted values are reduced modulo max.
    if random_range_try(10, 0xFFFFFFFFFFFFFFFF, @out) != 1
        return 1
    # 2^64 - 1 = 5 (mod 10)
    if out != 5
        return 2
    if random_range_try(1, 12345, @out) != 1
        return 3
    if out != 0
        return 4
    if random_range_try(0x8000000000000001, 0xFFFFFFFFFFFFFFFF, @out) != 1
        return 5
    # 2^64 - 1 - (2^63 + 1) = 2^63 - 2
    if out != 0x7FFFFFFFFFFFFFFE
        return 6
    # max = u64::MAX: the top raw value wraps to 0.
    if random_range_try(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, @out) != 1
        return 7
    if out != 0
        return 8
    0

[[test]]
fn test_random_range_unbiased_large_max() -> i32
    # max = 3 * 2^62. Plain `v % max` returns values below 2^62 half the
    # time (they are hit from v and v + max); uniform sampling hits them a
    # third of the time. Over 1000 draws the counts are ~500 vs ~333 with a
    # standard deviation of ~15, so the 416 cut-off is > 5 sigma from both.
    let max: u64 = 0xC000000000000000
    var low: i32 = 0
    var i: i32 = 0
    while i < 1000
        let r: u64 = random_range_u64(max)
        if r >= max
            return 1
        if r < 0x4000000000000000
            low += 1
        i += 1
    if low > 416
        return 2
    0


# ============================================================================
# RNG failure propagation (AGAST #1863)
# ============================================================================
# random_test_force_failure makes random_bytes fail as getrandom would on a
# broken system, so callers' error paths can be exercised.

[[test]]
fn test_random_bytes_reports_failure() -> i32
    var buf: [16]u8
    random_test_force_failure(1)
    let result: i32 = random_bytes(@buf[0], 16)
    random_test_force_failure(0)
    if result != -1
        return 1
    # And recovers once the fault is cleared
    if random_bytes(@buf[0], 16) != 0
        return 2
    0

[[test]]
fn test_random_u64_checked_reports_failure() -> i32
    var out: u64 = 7
    random_test_force_failure(1)
    let result: i32 = random_u64_checked(@out)
    random_test_force_failure(0)
    if result != -1
        return 1
    # On failure the output is not left holding a usable-looking value
    if out != 0
        return 2
    if random_u64_checked(@out) != 0
        return 3
    0

[[test]]
fn test_random_u32_checked_reports_failure() -> i32
    var out: u32 = 7
    random_test_force_failure(1)
    let result: i32 = random_u32_checked(@out)
    random_test_force_failure(0)
    if result != -1
        return 1
    if out != 0
        return 2
    if random_u32_checked(@out) != 0
        return 3
    0

[[test]]
fn test_random_fail_after_counts_calls() -> i32
    var buf: [4]u8
    random_test_fail_after(2)
    let a: i32 = random_bytes(@buf[0], 4)
    let b: i32 = random_bytes(@buf[0], 4)
    let c: i32 = random_bytes(@buf[0], 4)
    let d: i32 = random_bytes(@buf[0], 4)
    random_test_force_failure(0)
    # Calls 1-2 succeed, call 3 fails, call 4 is back to normal.
    if a != 0 || b != 0
        return 1
    if c != -1
        return 2
    if d != 0
        return 3
    0
