# test/test_ed25519_canonical.ritz - Ed25519 canonical-encoding and small-order checks (H-10, #2585, #2780)

import cryptosec.ed25519
import cryptosec.sha512

# REVIEW.md H-10 / RFC 8032 §5.1.7: s must be < l. Adding l to a valid s gives
# the same point [s]B, so without the check (R, s + l) verified too.
[[test]]
fn test_ed25519_rejects_non_canonical_s() -> i32
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (i * 3 + 1) as u8
        i += 1
    var pk: [32]u8
    var sk: [64]u8
    ed25519_keygen(@pk[0], @sk[0], @seed[0])
    var msg: [5]u8
    msg[0] = 104
    msg[1] = 101
    msg[2] = 108
    msg[3] = 108
    msg[4] = 111
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 5, @sk[0])
    if ed25519_verify(@sig[0], @msg[0], 5, @pk[0]) != 1
        return 1  # control: the canonical signature verifies

    # s += l (little-endian, 32 bytes; s < l < 2^253 so no overflow)
    var carry: i64 = 0
    i = 0
    while i < 32
        let t: i64 = (sig[32 + i] as i64) + L(i) + carry
        sig[32 + i] = (t & 0xff) as u8
        carry = t >> 8
        i += 1
    if ed25519_verify(@sig[0], @msg[0], 5, @pk[0]) != 0
        return 2
    return 0

# AGAST #2584: like the RSA/ECDSA verifiers, ed25519_verify returns exactly
# 1 = valid and 0 = invalid. An undecodable public key or R must also give
# 0, never a negative "truthy" value a `!= 0` caller would accept.
[[test]]
fn test_ed25519_verify_undecodable_points_return_zero() -> i32
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (i * 5 + 7) as u8
        i += 1
    var pk: [32]u8
    var sk: [64]u8
    ed25519_keygen(@pk[0], @sk[0], @seed[0])
    var msg: [3]u8
    msg[0] = 97
    msg[1] = 98
    msg[2] = 99
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 3, @sk[0])
    if ed25519_verify(@sig[0], @msg[0], 3, @pk[0]) != 1
        return 1  # control

    # Find a y with no matching x (about half of all y fail to decode).
    var bad: [32]u8
    var probe: Ge25519
    var y: i32 = 2
    var found: i32 = 0
    while y < 64 && found == 0
        i = 0
        while i < 32
            bad[i] = 0
            i += 1
        bad[0] = y as u8
        if ge_frombytes(@probe, @bad[0]) != 0
            found = 1
        else
            y += 1
    if found == 0
        return 2

    # Undecodable public key.
    if ed25519_verify(@sig[0], @msg[0], 3, @bad[0]) != 0
        return 3
    # Undecodable R.
    i = 0
    while i < 32
        sig[i] = bad[i]
        i += 1
    if ed25519_verify(@sig[0], @msg[0], 3, @pk[0]) != 0
        return 4
    return 0

[[test]]
fn test_sc_is_canonical_bounds() -> i32
    var s: [32]u8
    var i: i32 = 0
    while i < 32
        s[i] = L(i) as u8
        i += 1
    if sc_is_canonical(@s[0]) != 0
        return 1  # s == l
    s[0] = s[0] - 1
    if sc_is_canonical(@s[0]) != 1
        return 2  # s == l - 1
    return 0

# ============================================================================
# AGAST #2585: small-order / non-canonical public keys (GitHub #131)
# ============================================================================

# Write one of the small-order (or non-canonical) public key encodings
# into out[0..32]. Indices 0-7 are the 8 small-order points in canonical form
# (identity, the order-2 point, the two order-4 points, the four order-8
# points); 8-11 are non-canonical encodings of small-order points.
fn so_fill(out: *u8, fill: u8, last: u8)
    var i: i32 = 0
    while i < 31
        out[i] = fill
        i += 1
    out[31] = last

fn so_order8(out: *u8, which: i32)
    # y of the order-8 points, little-endian (libsodium's blacklist)
    var a: [32]u8 = [
        0xc7, 0x17, 0x6a, 0x70, 0x3d, 0x4d, 0xd8, 0x4f,
        0xba, 0x3c, 0x0b, 0x76, 0x0d, 0x10, 0x67, 0x0f,
        0x2a, 0x20, 0x53, 0xfa, 0x2c, 0x39, 0xcc, 0xc6,
        0x4e, 0xc7, 0xfd, 0x77, 0x92, 0xac, 0x03, 0x7a,
    ]
    var b: [32]u8 = [
        0x26, 0xe8, 0x95, 0x8f, 0xc2, 0xb2, 0x27, 0xb0,
        0x45, 0xc3, 0xf4, 0x89, 0xf2, 0xef, 0x98, 0xf0,
        0xd5, 0xdf, 0xac, 0x05, 0xd3, 0xc6, 0x33, 0x39,
        0xb1, 0x38, 0x02, 0x88, 0x6d, 0x53, 0xfc, 0x05,
    ]
    var i: i32 = 0
    while i < 32
        if which < 2
            out[i] = a[i]
        else
            out[i] = b[i]
        i += 1
    if (which & 1) == 1
        out[31] = out[31] | 0x80

fn small_order_encoding(out: *u8, idx: i32)
    if idx == 0
        so_fill(out, 0, 0)       # identity (0, 1)
        out[0] = 1
    else if idx == 1
        so_fill(out, 0xff, 0x7f)  # (0, -1), order 2: y = p - 1
        out[0] = 0xec
    else if idx == 2
        so_fill(out, 0, 0)       # (+-sqrt(-1), 0), order 4
    else if idx == 3
        so_fill(out, 0, 0x80)
    else if idx < 8
        so_order8(out, idx - 4)
    else if idx == 8
        so_fill(out, 0, 0x80)    # identity with x = "-0"
        out[0] = 1
    else if idx == 9
        so_fill(out, 0xff, 0x7f)  # y = p + 1 == 1 (identity)
        out[0] = 0xee
    else if idx == 10
        so_fill(out, 0xff, 0x7f)  # y = p == 0 (order 4)
        out[0] = 0xed
    else
        so_fill(out, 0xff, 0xff)  # (0, -1) with x = "-0"
        out[0] = 0xec

# With a small-order A, (R = identity, s = 0) satisfies [s]B == R + [k]A
# whenever 8 | k, so a message with k = 0 mod 8 is forged with no secret.
# Before #2585 every one of these verified.
[[test]]
fn test_ed25519_rejects_small_order_pubkey_forgery() -> i32
    var sig: [64]u8
    so_fill(@sig[0], 0, 0)
    so_fill(@sig[32], 0, 0)
    sig[0] = 1  # R = identity, s = 0

    var pk: [32]u8
    var msg: [1]u8
    var k_hash: [64]u8
    var ctx: Sha512
    var idx: i32 = 0
    while idx < 12
        small_order_encoding(@pk[0], idx)
        # find a message whose challenge k is a multiple of 8
        var m: i32 = 0
        var found: i32 = 0
        while m < 256 && found == 0
            msg[0] = m as u8
            sha512_init(@ctx)
            sha512_update(@ctx, @sig[0], 32)
            sha512_update(@ctx, @pk[0], 32)
            sha512_update(@ctx, @msg[0], 1)
            sha512_final(@ctx, @k_hash[0])
            sc_reduce(@k_hash[0])
            if (k_hash[0] & 7) == 0
                found = 1
            else
                m += 1
        if found == 0
            return 100 + idx
        if ed25519_verify(@sig[0], @msg[0], 1, @pk[0]) != 0
            return 1 + idx
        idx += 1
    return 0

[[test]]
fn test_ed25519_pubkey_small_order_detected() -> i32
    var pk: [32]u8
    var idx: i32 = 0
    while idx < 12
        small_order_encoding(@pk[0], idx)
        if ed25519_pubkey_ok(@pk[0]) != 0
            return 1 + idx
        idx += 1

    # Control: a real key and the base point are fine.
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (i * 7 + 3) as u8
        i += 1
    var sk: [64]u8
    ed25519_keygen(@pk[0], @sk[0], @seed[0])
    if ed25519_pubkey_ok(@pk[0]) != 1
        return 50
    var B: Ge25519
    ge_basepoint(@B)
    ge_tobytes(@pk[0], @B)
    if ed25519_pubkey_ok(@pk[0]) != 1
        return 51
    return 0

# y >= p is a non-canonical encoding of y - p. Find a y in [2, 19) whose
# point decodes and is not small order, then check its y + p twin is
# refused while the canonical form is accepted.
[[test]]
fn test_ed25519_pubkey_non_canonical_rejected() -> i32
    var canon: [32]u8
    var probe: Ge25519
    var y: i32 = 2
    var found: i32 = 0
    while y < 19 && found == 0
        so_fill(@canon[0], 0, 0)
        canon[0] = y as u8
        if ge_frombytes(@probe, @canon[0]) == 0
            found = 1
        else
            y += 1
    if found == 0
        return 1
    if ed25519_pubkey_ok(@canon[0]) != 1
        return 2  # control: canonical, not small order

    # y + p = y + 2^255 - 19, little-endian: low byte 0xed + y, then 0xff..0x7f
    var nc: [32]u8
    so_fill(@nc[0], 0xff, 0x7f)
    nc[0] = (0xed + y) as u8
    if ed25519_pubkey_ok(@nc[0]) != 0
        return 3
    # the same, with the x sign bit set
    canon[31] = 0x80
    nc[31] = 0xff
    if ed25519_pubkey_ok(@canon[0]) != 1
        return 4
    if ed25519_pubkey_ok(@nc[0]) != 0
        return 5
    return 0

# ============================================================================
# AGAST #2780: small-order / non-canonical R (libsodium rejects both)
# ============================================================================

# A small-order R can verify. Take a mixed-order key A = [a]B + T, where T is
# the small-order point that R encodes, and s = k*a mod l. Then
#   [s]B - [k]A = -[k]T,
# which is T (= R) whenever k = -1 mod 8 (the order of T divides 8). Before
# #2780 every one of these 8 signatures verified; libsodium refuses them all.
# Index 0 (R = identity) needs no torsion: with k*a, [s]B - [k]A is the
# identity for any k.
[[test]]
fn test_ed25519_rejects_small_order_r() -> i32
    var a: [32]u8
    var i: i32 = 0
    while i < 32
        a[i] = (i * 11 + 5) as u8
        i += 1
    a[31] = 0x0f  # a < l
    var aB: Ge25519
    ge_scalarmult_base(@aB, @a[0])

    var zero: [32]u8
    so_fill(@zero[0], 0, 0)
    var sig: [64]u8
    var pk: [32]u8
    var T: Ge25519
    var A: Ge25519
    var msg: [1]u8
    var k_hash: [64]u8
    var ctx: Sha512
    var idx: i32 = 0
    while idx < 8
        small_order_encoding(@sig[0], idx)  # R = T
        if ge_frombytes(@T, @sig[0]) != 0
            return 200 + idx
        ge_add(@A, @aB, @T)
        ge_tobytes(@pk[0], @A)
        if ed25519_pubkey_ok(@pk[0]) != 1
            return 300 + idx  # mixed-order A is a legitimate key
        # find a message whose challenge k is -1 mod 8
        var m: i32 = 0
        var found: i32 = 0
        while m < 256 && found == 0
            msg[0] = m as u8
            sha512_init(@ctx)
            sha512_update(@ctx, @sig[0], 32)
            sha512_update(@ctx, @pk[0], 32)
            sha512_update(@ctx, @msg[0], 1)
            sha512_final(@ctx, @k_hash[0])
            sc_reduce(@k_hash[0])
            if (k_hash[0] & 7) == 7
                found = 1
            else
                m += 1
        if found == 0
            return 100 + idx
        sc_muladd(@sig[32], @k_hash[0], @a[0], @zero[0])  # s = k*a
        if ed25519_verify(@sig[0], @msg[0], 1, @pk[0]) != 0
            return 1 + idx
        idx += 1
    return 0

# Control for the construction above: the same key and message with an
# honest signature still verify, and so does a real key's real signature.
[[test]]
fn test_ed25519_r_check_keeps_honest_signatures() -> i32
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (i * 13 + 9) as u8
        i += 1
    var pk: [32]u8
    var sk: [64]u8
    ed25519_keygen(@pk[0], @sk[0], @seed[0])
    var msg: [3]u8
    msg[0] = 120
    msg[1] = 121
    msg[2] = 122
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 3, @sk[0])
    if ed25519_verify(@sig[0], @msg[0], 3, @pk[0]) != 1
        return 1
    if ed25519_point_ok(@sig[0]) != 1
        return 2  # an honest R is canonical and of large order
    return 0

# R encodings libsodium refuses: the 8 small-order points, their
# non-canonical aliases (y >= p, x = "-0"), and the y + p twin of a
# large-order point. Each is refused by ed25519_point_ok, and a signature
# carrying it is refused by ed25519_verify.
[[test]]
fn test_ed25519_rejects_non_canonical_r() -> i32
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (i * 17 + 2) as u8
        i += 1
    var pk: [32]u8
    var sk: [64]u8
    ed25519_keygen(@pk[0], @sk[0], @seed[0])
    var msg: [2]u8
    msg[0] = 111
    msg[1] = 107
    var sig: [64]u8
    ed25519_sign(@sig[0], @msg[0], 2, @sk[0])
    if ed25519_verify(@sig[0], @msg[0], 2, @pk[0]) != 1
        return 1  # control

    var idx: i32 = 0
    while idx < 12
        small_order_encoding(@sig[0], idx)
        if ed25519_point_ok(@sig[0]) != 0
            return 10 + idx
        if ed25519_verify(@sig[0], @msg[0], 2, @pk[0]) != 0
            return 30 + idx
        idx += 1

    # y + p twin of a large-order point with small y
    var canon: [32]u8
    var probe: Ge25519
    var y: i32 = 2
    var found: i32 = 0
    while y < 19 && found == 0
        so_fill(@canon[0], 0, 0)
        canon[0] = y as u8
        if ge_frombytes(@probe, @canon[0]) == 0
            found = 1
        else
            y += 1
    if found == 0
        return 2
    if ed25519_point_ok(@canon[0]) != 1
        return 3  # control: canonical, large order
    so_fill(@sig[0], 0xff, 0x7f)
    sig[0] = (0xed + y) as u8
    if ed25519_point_ok(@sig[0]) != 0
        return 4
    if ed25519_verify(@sig[0], @msg[0], 2, @pk[0]) != 0
        return 5
    return 0
