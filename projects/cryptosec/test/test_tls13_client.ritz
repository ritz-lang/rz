# ============================================================================
# Memory Cleanup Tests
# ============================================================================

[[test]]
fn test_client_free() -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)

    var client: TlsClient
    tls_client_init(@client, @cfg)

    # Start handshake to populate some sensitive data
    var out: [1024]u8
    tls_client_start(@client, @out[0], 1024)

    # Free should zero sensitive data
    tls_client_free(@client)

    # Check that shared secret is zeroed
    var all_zero: i32 = 1
    var i: i32 = 0
    while i < 32
        if client.shared_secret[i] != 0
            all_zero = 0
        i += 1

    if all_zero != 1
        return 1

    return 0

# ============================================================================
# Initialisation covers exactly the struct (AGAST #1917)
# ============================================================================
# tls_client_init zeroed a hard-coded 8192 bytes of a 10480-byte TlsClient,
# so handshake_complete, last_error, ... kept whatever the stack held. At -O0
# that was zero by luck; at -O2 test_client_init saw handshake_complete != 0.
# tls_config_init zeroed 280 bytes of a 276-byte TlsConfig: 4 bytes past it.

fn fill_1917(p: *u8, n: i64, v: u8)
    for i in 0..n
        *(p + i) = v

[[test]]
fn test_client_init_clears_whole_struct() -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    var client: TlsClient
    fill_1917(@client as *u8, sizeof(TlsClient), 0xAA as u8)
    tls_client_init(@client, @cfg)
    if client.handshake_complete != 0
        return 1
    if client.last_error != 0
        return 2
    0

struct ConfigGuard1917
    cfg: TlsConfig
    canary: u32

[[test]]
fn test_config_init_stays_in_bounds() -> i32
    var g: ConfigGuard1917
    g.canary = 0xDEADBEEF as u32
    tls_config_init(@g.cfg)
    if g.canary != 0xDEADBEEF as u32
        return 1
    0

# ============================================================================
# Trust anchor and cipher-suite enforcement (#1862)
# ============================================================================

[[test]]
fn test_config_pin_cert_bounds() -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    var der: [8]u8
    var i: i32 = 0
    while i < 8
        der[i] = (i + 1) as u8
        i += 1
    if tls_config_pin_cert(@cfg, @der[0], 0) != -1
        return 1
    if tls_config_pin_cert(@cfg, @der[0], 4097) != -1
        return 2
    if cfg.pinned_cert_len != 0
        return 3
    if tls_config_pin_cert(@cfg, @der[0], 8) != 0
        return 4
    if cfg.pinned_cert_len != 8 || cfg.pinned_cert[7] != 8
        return 5
    return 0

# A plaintext ServerHello record selecting `suite`, with an X25519 key share.
fn build_server_hello_1862(out: *u8, suite: u16) -> i64
    var p: i64 = 9  # record header (5) + handshake header (4)
    out[p] = 0x03
    out[p + 1] = 0x03
    p = p + 2
    var i: i64 = 0
    while i < 32
        out[p + i] = 0x11
        i += 1
    p = p + 32
    out[p] = 0  # session id
    p = p + 1
    out[p] = ((suite >> 8) & 0xff) as u8
    out[p + 1] = (suite & 0xff) as u8
    p = p + 2
    out[p] = 0  # compression
    p = p + 1
    out[p] = 0
    out[p + 1] = 46  # extensions length: 6 + 40
    p = p + 2
    # supported_versions: TLS 1.3
    out[p] = 0x00
    out[p + 1] = 0x2b
    out[p + 2] = 0x00
    out[p + 3] = 0x02
    out[p + 4] = 0x03
    out[p + 5] = 0x04
    p = p + 6
    # key_share: x25519, 32 bytes
    out[p] = 0x00
    out[p + 1] = 0x33
    out[p + 2] = 0x00
    out[p + 3] = 0x24
    out[p + 4] = 0x00
    out[p + 5] = 0x1d
    out[p + 6] = 0x00
    out[p + 7] = 0x20
    p = p + 8
    i = 0
    while i < 32
        out[p + i] = (i + 9) as u8
        i += 1
    p = p + 32
    let hs_len: i64 = p - 9
    out[0] = 22
    out[1] = 0x03
    out[2] = 0x03
    out[3] = (((hs_len + 4) >> 8) & 0xff) as u8
    out[4] = ((hs_len + 4) & 0xff) as u8
    out[5] = HS_SERVER_HELLO
    out[6] = 0
    out[7] = ((hs_len >> 8) & 0xff) as u8
    out[8] = (hs_len & 0xff) as u8
    return p

fn run_server_hello_1862(suite: u16) -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    tls_config_set_hostname(@cfg, "test.local", 10)
    var client: TlsClient
    tls_client_init(@client, @cfg)
    var out: [1024]u8
    if tls_client_start(@client, @out[0], 1024) <= 0
        return -100
    var sh: [256]u8
    let sh_len: i64 = build_server_hello_1862(@sh[0], suite)
    var out_len: i64 = 0
    let r: i32 = tls_client_process(@client, @sh[0], sh_len, @out[0], 1024, @out_len)
    tls_client_free(@client)
    return r

[[test]]
fn test_client_accepts_aes128_server_hello() -> i32
    # Control for the test below: the same ServerHello with AES-128-GCM parses
    # and the client waits for the encrypted flight.
    if run_server_hello_1862(TLS_AES_128_GCM_SHA256) != TLS_RESULT_NEED_INPUT
        return 1
    return 0

[[test]]
fn test_client_rejects_unimplemented_cipher_suite() -> i32
    # ChaCha20-Poly1305 is not implemented by the record layer; the client used
    # to accept it and then run AES-128-GCM keys anyway.
    if run_server_hello_1862(TLS_CHACHA20_POLY1305_SHA256) != TLS_RESULT_ERROR
        return 1
    return 0

# ============================================================================
# CA trust store, verification time, record sizing (AGAST #2109)
# ============================================================================

# P-256 self-signed CA (CN=Ritz Test CA), as in test_ca_store.
fn ca_pem_2109() -> *u8
    return c"-----BEGIN CERTIFICATE-----\nMIIBvTCCAWOgAwIBAgIUfP1+DMBV/A+m0p3rGzRcxVRqy94wCgYIKoZIzj0EAwIw\nMzEVMBMGA1UEAwwMUml0eiBUZXN0IENBMQ0wCwYDVQQKDARSaXR6MQswCQYDVQQG\nEwJVUzAgFw0yNjEwMzExNDA4MzBaGA8yMTI2MTAwNzE0MDgzMFowMzEVMBMGA1UE\nAwwMUml0eiBUZXN0IENBMQ0wCwYDVQQKDARSaXR6MQswCQYDVQQGEwJVUzBZMBMG\nByqGSM49AgEGCCqGSM49AwEHA0IABIeaJBwDHlO0+pap2TvIQ1t0m92+baQCLyPz\njDLvjGOiIjjo6laU3/2dotedfLT96f4Fu5eyRWqr2mOGH0HHVLWjUzBRMB0GA1Ud\nDgQWBBSbC2AYUWFTrHkv5xRJ9/u/3GtlKzAfBgNVHSMEGDAWgBSbC2AYUWFTrHkv\n5xRJ9/u/3GtlKzAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA0gAMEUCIB74\njfMjZcbtSDY6FQ5XOQSVpI12hTLVERL/ZCkd0s6cAiEA6kPDTJYWKuVTmuIkPlvA\n/LjxLkNMIaDItTm6AN3c15o=\n-----END CERTIFICATE-----\n"

fn cstr_len_2109(s: *u8) -> i64
    var n: i64 = 0
    while s[n] != 0
        n = n + 1
    return n

[[test]]
fn test_config_ca_store() -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    if cfg.ca_store != null || cfg.verify_time != 0
        return 1
    if tls_config_set_ca_store(@cfg, null) != -1
        return 2
    var store: CaStore
    ca_store_init(@store)
    # An empty store trusts nothing; refuse it rather than accept and fail later.
    if tls_config_set_ca_store(@cfg, @store) != -1
        ca_store_destroy(@store)
        return 3
    let pem: *u8 = ca_pem_2109()
    if ca_store_add_cert_pem(@store, pem, cstr_len_2109(pem)) != 1
        ca_store_destroy(@store)
        return 4
    if tls_config_set_ca_store(@cfg, @store) != 0 || cfg.ca_store != @store
        ca_store_destroy(@store)
        return 5
    tls_config_set_verify_time(@cfg, 1790000000)
    if cfg.verify_time != 1790000000
        ca_store_destroy(@store)
        return 6
    ca_store_destroy(@store)
    return 0

# ServerHello, then the header of an encrypted record of `rec_len` bytes and
# `body` bytes of its (garbage) body. Returns the client's result.
fn run_after_server_hello_2109(client: *TlsClient, rec_len: i64, body: i64) -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    tls_config_set_hostname(@cfg, "test.local", 10)
    tls_client_init(client, @cfg)
    var out: [1024]u8
    if tls_client_start(client, @out[0], 1024) <= 0
        return -100
    var buf: [17000]u8
    mem_zero(@buf[0], 17000)
    let sh_len: i64 = build_server_hello_1862(@buf[0], TLS_AES_128_GCM_SHA256)
    buf[sh_len] = 23
    buf[sh_len + 1] = 0x03
    buf[sh_len + 2] = 0x03
    buf[sh_len + 3] = ((rec_len >> 8) & 0xff) as u8
    buf[sh_len + 4] = (rec_len & 0xff) as u8
    var out_len: i64 = 0
    return tls_client_process(client, @buf[0], sh_len + 5 + body, @out[0], 1024, @out_len)

[[test]]
fn test_client_takes_max_size_record() -> i32
    # A 2^14 + 256 byte ciphertext is a legal record. The 4096-byte receive
    # buffer refused it as BUFFER_TOO_SMALL; now it is buffered and fails
    # only because this garbage does not decrypt.
    var client: TlsClient
    let r: i32 = run_after_server_hello_2109(@client, 16640, 16640)
    if r != TLS_RESULT_ERROR
        return 1
    if tls_client_error(@client) != TLS_ERR_DECRYPT_FAILED
        return 2
    return 0

[[test]]
fn test_client_waits_for_rest_of_large_record() -> i32
    var client: TlsClient
    if run_after_server_hello_2109(@client, 16640, 9000) != TLS_RESULT_NEED_INPUT
        return 1
    return 0

[[test]]
fn test_client_rejects_oversize_record() -> i32
    # One byte over the TLS 1.3 limit is record_overflow, as soon as the
    # header is seen.
    var client: TlsClient
    if run_after_server_hello_2109(@client, 16641, 0) != TLS_RESULT_ERROR
        return 1
    if tls_client_error(@client) != TLS_ERR_RECORD_OVERFLOW
        return 2
    return 0


# AGAST #1863: RNG failure while building the ClientHello fails client init
# (and so the handshake) instead of sending a predictable key share.
[[test]]
fn test_tls_client_init_fails_on_rng_failure() -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    var client: TlsClient
    random_test_force_failure(1)
    let result: i32 = tls_client_init(@client, @cfg)
    random_test_force_failure(0)
    if result != -1
        return 1
    if mem_is_zero(@client.client_hello.x25519_private[0], 32) != 1
        return 2
    if tls_client_init(@client, @cfg) != 0
        return 3
    tls_client_free(@client)
    return 0

# ============================================================================
# Middlebox-compat change_cipher_spec and HelloRetryRequest (AGAST #2116)
# ============================================================================
# RFC 8446 D.4: servers (OpenSSL, nginx, most CDNs) send one unencrypted
# change_cipher_spec record, body 0x01, after their ServerHello. The client
# must drop it. Any other CCS (wrong body/length, a second one, one before
# the ServerHello) is unexpected_message. A HelloRetryRequest is a
# ServerHello with a fixed random (RFC 8446 4.1.3); #2182 below retries it.

# A change_cipher_spec record of `len` bytes, every byte `body`.
fn ccs_2116(out: *u8, len: i64, body: u8) -> i64
    out[0] = 20
    out[1] = 0x03
    out[2] = 0x03
    out[3] = 0
    out[4] = len as u8
    var i: i64 = 0
    while i < len
        out[5 + i] = body
        i += 1
    return 5 + len

# Start `client`, then feed it `pre`, a ServerHello and `post` in one call.
fn run_2116(client: *TlsClient, pre: *u8, pre_len: i64, post: *u8, post_len: i64) -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    tls_config_set_hostname(@cfg, "test.local", 10)
    tls_client_init(client, @cfg)
    var out: [1024]u8
    if tls_client_start(client, @out[0], 1024) <= 0
        return -100
    var buf: [512]u8
    mem_copy(@buf[0], pre, pre_len as u64)
    let sh_len: i64 = build_server_hello_1862(@buf[pre_len], TLS_AES_128_GCM_SHA256)
    mem_copy(@buf[pre_len + sh_len], post, post_len as u64)
    var out_len: i64 = 0
    return tls_client_process(client, @buf[0], pre_len + sh_len + post_len, @out[0], 1024, @out_len)

[[test]]
fn test_client_ignores_ccs_after_server_hello() -> i32
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 1, 0x01)
    var client: TlsClient
    if run_2116(@client, @ccs[0], 0, @ccs[0], n) != TLS_RESULT_NEED_INPUT
        return 100 + tls_client_error(@client)
    if client.state != TLS_STATE_SERVER_HELLO_RECEIVED
        return 2
    if client.recv_len != 0
        return 3  # the CCS record was consumed
    return 0

[[test]]
fn test_client_continues_after_ccs() -> i32
    # The record after the CCS is still processed: here a garbage encrypted
    # record, which fails to decrypt.
    var post: [64]u8
    let n: i64 = ccs_2116(@post[0], 1, 0x01)
    post[n] = 23
    post[n + 1] = 0x03
    post[n + 2] = 0x03
    post[n + 3] = 0
    post[n + 4] = 20
    var i: i64 = 0
    while i < 20
        post[n + 5 + i] = 0x5a
        i += 1
    var client: TlsClient
    if run_2116(@client, @post[0], 0, @post[0], n + 25) != TLS_RESULT_ERROR
        return 1
    if tls_client_error(@client) != TLS_ERR_DECRYPT_FAILED
        return 100 + tls_client_error(@client)
    return 0

[[test]]
fn test_client_ccs_split_across_calls() -> i32
    var client: TlsClient
    var none: [1]u8
    if run_2116(@client, @none[0], 0, @none[0], 0) != TLS_RESULT_NEED_INPUT
        return 1
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 1, 0x01)
    var out: [64]u8
    var out_len: i64 = 0
    var i: i64 = 0
    while i < n
        if tls_client_process(@client, @ccs[i], 1, @out[0], 64, @out_len) != TLS_RESULT_NEED_INPUT
            return 10 + i as i32
        i += 1
    if client.recv_len != 0 || client.state != TLS_STATE_SERVER_HELLO_RECEIVED
        return 2
    return 0

fn expect_ccs_rejected_2116(r: i32, client: *TlsClient) -> i32
    if r != TLS_RESULT_ERROR
        return 1
    if tls_client_error(client) != TLS_ERR_UNEXPECTED_MESSAGE
        return 2
    if client.state != TLS_STATE_ERROR
        return 3
    return 0

[[test]]
fn test_client_rejects_ccs_with_wrong_body() -> i32
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 1, 0x02)
    var client: TlsClient
    return expect_ccs_rejected_2116(run_2116(@client, @ccs[0], 0, @ccs[0], n), @client)

[[test]]
fn test_client_rejects_ccs_with_wrong_length() -> i32
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 2, 0x01)
    var client: TlsClient
    return expect_ccs_rejected_2116(run_2116(@client, @ccs[0], 0, @ccs[0], n), @client)

[[test]]
fn test_client_rejects_empty_ccs() -> i32
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 0, 0x01)
    var client: TlsClient
    return expect_ccs_rejected_2116(run_2116(@client, @ccs[0], 0, @ccs[0], n), @client)

[[test]]
fn test_client_rejects_second_ccs() -> i32
    var ccs: [16]u8
    let n: i64 = ccs_2116(@ccs[0], 1, 0x01)
    ccs_2116(@ccs[n], 1, 0x01)
    var client: TlsClient
    return expect_ccs_rejected_2116(run_2116(@client, @ccs[0], 0, @ccs[0], 2 * n), @client)

[[test]]
fn test_client_rejects_ccs_before_server_hello() -> i32
    var ccs: [8]u8
    let n: i64 = ccs_2116(@ccs[0], 1, 0x01)
    var client: TlsClient
    return expect_ccs_rejected_2116(run_2116(@client, @ccs[0], n, @ccs[0], 0), @client)

# A HelloRetryRequest as a server sends it: the special random and a
# key_share that names only the group it wants (secp256r1 here).
fn build_hrr_2116(out: *u8, last_random_byte: u8) -> i64
    var p: i64 = 9
    out[p] = 0x03
    out[p + 1] = 0x03
    p = p + 2
    var magic: [32]u8
    hello_retry_request_random(@magic[0])
    mem_copy(out + p, @magic[0], 32)
    out[p + 31] = last_random_byte
    p = p + 32
    out[p] = 0  # session id
    out[p + 1] = 0x13
    out[p + 2] = 0x01  # TLS_AES_128_GCM_SHA256
    out[p + 3] = 0  # compression
    out[p + 4] = 0
    out[p + 5] = 12  # extensions: 6 + 6
    p = p + 6
    # supported_versions: TLS 1.3
    out[p] = 0x00
    out[p + 1] = 0x2b
    out[p + 2] = 0x00
    out[p + 3] = 0x02
    out[p + 4] = 0x03
    out[p + 5] = 0x04
    # key_share: selected_group secp256r1
    out[p + 6] = 0x00
    out[p + 7] = 0x33
    out[p + 8] = 0x00
    out[p + 9] = 0x02
    out[p + 10] = 0x00
    out[p + 11] = 0x17
    p = p + 12
    let hs_len: i64 = p - 9
    out[0] = 22
    out[1] = 0x03
    out[2] = 0x03
    out[3] = 0
    out[4] = (hs_len + 4) as u8
    out[5] = HS_SERVER_HELLO
    out[6] = 0
    out[7] = 0
    out[8] = hs_len as u8
    return p

fn run_hrr_2116(client: *TlsClient, last_random_byte: u8) -> i32
    var cfg: TlsConfig
    tls_config_init(@cfg)
    tls_config_set_hostname(@cfg, "test.local", 10)
    tls_client_init(client, @cfg)
    var out: [1024]u8
    if tls_client_start(client, @out[0], 1024) <= 0
        return -100
    var buf: [128]u8
    let n: i64 = build_hrr_2116(@buf[0], last_random_byte)
    var out_len: i64 = 0
    return tls_client_process(client, @buf[0], n, @out[0], 1024, @out_len)

[[test]]
fn test_client_near_hrr_random_is_not_hrr() -> i32
    # Control: one random bit off is an ordinary (here malformed: no key
    # share) ServerHello, a parse error rather than HELLO_RETRY_REQUEST.
    var client: TlsClient
    if run_hrr_2116(@client, 0x9d) != TLS_RESULT_ERROR
        return 1
    if tls_client_error(@client) != TLS_ERR_PARSE_ERROR
        return 100 + tls_client_error(@client)
    return 0

# ============================================================================
# HelloRetryRequest retry (AGAST #2182)
# ============================================================================
# The client answers a HelloRetryRequest with a second ClientHello, cookie
# echoed and key share replaced as asked. test_tls_e2e in valet runs whole
# handshakes through it; these pin each rule of RFC 8446 4.1.3, 4.1.4, 4.2.8
# and 4.4.1 on hand-built messages.

fn be16_2182(p: *u8, v: i64)
    p[0] = ((v >> 8) & 0xff) as u8
    p[1] = (v & 0xff) as u8

# Frame the handshake body at out[9..9+body] as one ServerHello record.
fn frame_2182(out: *u8, body: i64) -> i64
    out[0] = 22
    out[1] = 0x03
    out[2] = 0x03
    be16_2182(out + 3, body + 4)
    out[5] = HS_SERVER_HELLO
    out[6] = 0
    be16_2182(out + 7, body)
    return 9 + body

# Write version, `random`, session id echo, suite and compression at out[9..].
# Returns the offset of the extensions length field.
fn hello_head_2182(out: *u8, random: *u8, client: *TlsClient, suite: u16) -> i64
    out[9] = 0x03
    out[10] = 0x03
    mem_copy(out + 11, random, 32)
    out[43] = 32
    mem_copy(out + 44, @client.client_hello.session_id[0], 32)
    be16_2182(out + 76, suite as i64)
    out[78] = 0
    return 79

fn ext_version_2182(out: *u8, p: i64) -> i64
    be16_2182(out + p, 43)
    be16_2182(out + p + 2, 2)
    out[p + 4] = 0x03
    out[p + 5] = 0x04
    return p + 6

# An HRR record for `client`: `group` (0: no key_share) and a `cookie_len`
# cookie (0: none).
fn hrr_2182(out: *u8, client: *TlsClient, suite: u16, group: u16, cookie_len: i64) -> i64
    var magic: [32]u8
    hello_retry_request_random(@magic[0])
    let at: i64 = hello_head_2182(out, @magic[0], client, suite)
    var p: i64 = ext_version_2182(out, at + 2)
    if group != 0
        be16_2182(out + p, 51)
        be16_2182(out + p + 2, 2)
        be16_2182(out + p + 4, group as i64)
        p = p + 6
    if cookie_len > 0
        be16_2182(out + p, 44)
        be16_2182(out + p + 2, cookie_len + 2)
        be16_2182(out + p + 4, cookie_len)
        var i: i64 = 0
        while i < cookie_len
            out[p + 6 + i] = (0x40 + i) as u8
            i += 1
        p = p + 6 + cookie_len
    be16_2182(out + at, p - at - 2)
    return frame_2182(out, p - 9)

# A ServerHello record for `client` with one key share of `key_len` bytes.
fn sh_2182(out: *u8, client: *TlsClient, suite: u16, group: u16, key: *u8, key_len: i64) -> i64
    var rnd: [32]u8
    mem_zero(@rnd[0], 32)
    rnd[0] = 0x22
    let at: i64 = hello_head_2182(out, @rnd[0], client, suite)
    var p: i64 = ext_version_2182(out, at + 2)
    be16_2182(out + p, 51)
    be16_2182(out + p + 2, 4 + key_len)
    be16_2182(out + p + 4, group as i64)
    be16_2182(out + p + 6, key_len)
    mem_copy(out + p + 8, key, key_len)
    p = p + 8 + key_len
    be16_2182(out + at, p - at - 2)
    return frame_2182(out, p - 9)

# Init and start `client`; CH1's record goes to ch1. Returns its length.
fn start_2182(client: *TlsClient, ch1: *u8) -> i64
    var cfg: TlsConfig
    tls_config_init(@cfg)
    tls_config_set_hostname(@cfg, "test.local", 10)
    if tls_client_init(client, @cfg) != 0
        return -1
    return tls_client_start(client, ch1, 1024)

# Fails `client` on one record; 0 if it is `want`, else the wrong outcome.
fn expect_err_2182(client: *TlsClient, rec: *u8, n: i64, want: i32) -> i32
    var out: [1024]u8
    var out_len: i64 = 0
    if tls_client_process(client, rec, n, @out[0], 1024, @out_len) != TLS_RESULT_ERROR
        return 1
    if tls_client_error(client) != want
        return 100 - tls_client_error(client)
    if client.state != TLS_STATE_ERROR || out_len != 0
        return 2
    return 0

# Offset of extension `ext`'s data in the ClientHello record `rec`; -1 absent.
fn ch_ext_2182(rec: *u8, len: i64, ext: u16) -> i64
    var p: i64 = 5 + 4 + 2 + 32
    p = p + 1 + rec[p] as i64
    p = p + 2 + (((rec[p] as i64) << 8) | (rec[p + 1] as i64))
    p = p + 1 + rec[p] as i64
    p = p + 2
    while p + 4 <= len
        let t: u16 = ((rec[p] as u16) << 8) | (rec[p + 1] as u16)
        let n: i64 = ((rec[p + 2] as i64) << 8) | (rec[p + 3] as i64)
        if t == ext
            return p + 4
        p = p + 4 + n
    return -1

# `client` past an HRR asking for `group` and a `cookie_len` cookie. 0 on
# success; CH2's record goes to ch2 and its length to *ch2_len.
fn past_hrr_2182(client: *TlsClient, group: u16, cookie_len: i64, ch2: *u8, ch2_len: *i64) -> i32
    var ch1: [1024]u8
    if start_2182(client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], client, TLS_AES_128_GCM_SHA256, group, cookie_len)
    if tls_client_process(client, @rec[0], n, ch2, 1024, ch2_len) != TLS_RESULT_HAVE_OUTPUT
        return 200 - tls_client_error(client)
    return 0

fn x25519_share_2182(key: *u8)
    var i: i64 = 0
    while i < 32
        key[i] = (i + 9) as u8
        i += 1

# A valid secp256r1 share: the point for scalar 2.
fn p256_share_2182(key: *u8)
    var d: [32]u8
    mem_zero(@d[0], 32)
    d[31] = 2
    p256_ecdh_public(key, @d[0])

[[test]]
fn test_retry_cookie_only_sends_second_hello() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    if ch2[0] != 22 || ch2[5] != HS_CLIENT_HELLO
        return 1
    let rec_len: i64 = ((ch2[3] as i64) << 8) | (ch2[4] as i64)
    if rec_len + 5 != ch2_len
        return 2
    let c: i64 = ch_ext_2182(@ch2[0], ch2_len, 44)
    if c < 0 || ch2[c + 1] != 5 || ch2[c + 2] != 0x40 || ch2[c + 6] != 0x44
        return 3
    let k: i64 = ch_ext_2182(@ch2[0], ch2_len, 51)
    if k < 0 || ch2[k + 3] != 0x1d
        return 4  # the X25519 share stays
    if mem_eq(@ch2[k + 6], @client.client_hello.x25519_public[0], 32) != 1
        return 5
    if client.state != TLS_STATE_CLIENT_HELLO_SENT || client.recv_len != 0
        return 6
    if client.encrypted_handshake != 0
        return 7
    return 0

[[test]]
fn test_retry_second_hello_record_version_is_0303() -> i32
    # RFC 8446 5.1: 0x0301 is allowed only for the initial ClientHello.
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    if ch2[1] != 0x03 || ch2[2] != 0x03
        return 1
    return 0

[[test]]
fn test_retry_group_change_sends_p256_share() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, GROUP_SECP256R1, 0, @ch2[0], @ch2_len)
    if r != 0
        return r
    let k: i64 = ch_ext_2182(@ch2[0], ch2_len, 51)
    if k < 0 || ch2[k + 3] != 0x17 || ch2[k + 5] != 65
        return 1
    if ch_ext_2182(@ch2[0], ch2_len, 44) != -1
        return 2
    return 0

[[test]]
fn test_retry_transcript_is_message_hash_hrr_ch2() -> i32
    # RFC 8446 4.4.1, computed with SHA-256 directly from the wire bytes.
    var client: TlsClient
    var ch1: [1024]u8
    let ch1_len: i64 = start_2182(@client, @ch1[0])
    if ch1_len <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, 5)
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    if tls_client_process(@client, @rec[0], n, @ch2[0], 1024, @ch2_len) != TLS_RESULT_HAVE_OUTPUT
        return 2

    var all: [2048]u8
    all[0] = 0xfe
    all[1] = 0
    all[2] = 0
    all[3] = 32
    sha256(@ch1[5], ch1_len - 5, @all[4])
    mem_copy(@all[36], @rec[5], n - 5)
    mem_copy(@all[36 + n - 5], @ch2[5], ch2_len - 5)
    var want: [32]u8
    sha256(@all[0], 36 + n - 5 + ch2_len - 5, @want[0])
    var got: [32]u8
    transcript_hash(@client.transcript, @got[0])
    if mem_eq(@got[0], @want[0], 32) != 1
        return 3
    return 0

[[test]]
fn test_retry_refuses_second_hrr() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, 0)
    return expect_err_2182(@client, @rec[0], n, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_refuses_session_id_mismatch() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, 0, 5)
    rec[44] = rec[44] ^ 1
    return expect_err_2182(@client, @rec[0], n, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_refuses_suite_not_offered() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_256_GCM_SHA384, 0, 5)
    return expect_err_2182(@client, @rec[0], n, TLS_ERR_ILLEGAL_PARAMETER)

fn refused_hrr_2182(group: u16, cookie_len: i64) -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, group, cookie_len)
    return expect_err_2182(@client, @rec[0], n, TLS_ERR_HELLO_RETRY_REQUEST)

[[test]]
fn test_retry_refuses_hrr_changing_nothing() -> i32
    return refused_hrr_2182(0, 0)

[[test]]
fn test_retry_refuses_group_already_offered() -> i32
    return refused_hrr_2182(GROUP_X25519, 0)

[[test]]
fn test_retry_refuses_unsupported_group() -> i32
    return refused_hrr_2182(0x001e, 0)

[[test]]
fn test_retry_refuses_malformed_hrr() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, 0, 5)
    rec[79 + 2] = 0x7f  # first extension becomes one we never offered
    return expect_err_2182(@client, @rec[0], n, TLS_ERR_PARSE_ERROR)

[[test]]
fn test_retry_refuses_data_after_hrr_in_its_record() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, 0, 5)
    be16_2182(@rec[3], n - 5 + 4)
    rec[n] = HS_ENCRYPTED_EXTENSIONS
    rec[n + 1] = 0
    rec[n + 2] = 0
    rec[n + 3] = 0
    return expect_err_2182(@client, @rec[0], n + 4, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_refuses_input_it_would_lose() -> i32
    # More than recv_buf holds behind an HRR: nothing legitimate can follow
    # one, and HAVE_OUTPUT would drop what did not fit.
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var big: [20000]u8
    mem_zero(@big[0], 20000)
    hrr_2182(@big[0], @client, TLS_AES_128_GCM_SHA256, 0, 5)
    return expect_err_2182(@client, @big[0], 20000, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_second_hello_needs_room_in_out() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, 0, 5)
    var small: [16]u8
    var out_len: i64 = 0
    if tls_client_process(@client, @rec[0], n, @small[0], 16, @out_len) != TLS_RESULT_ERROR
        return 1
    if tls_client_error(@client) != TLS_ERR_BUFFER_TOO_SMALL
        return 100 - tls_client_error(@client)
    if client.state != TLS_STATE_ERROR
        return 2
    return 0

[[test]]
fn test_retry_accepts_ccs_after_hrr() -> i32
    # HRR and CCS in one read, as OpenSSL sends them.
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [256]u8
    let n: i64 = hrr_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, 0)
    let c: i64 = ccs_2116(@rec[n], 1, 0x01)
    var out: [1024]u8
    var out_len: i64 = 0
    if tls_client_process(@client, @rec[0], n + c, @out[0], 1024, @out_len) != TLS_RESULT_HAVE_OUTPUT
        return 200 - tls_client_error(@client)

    # The CCS waits behind the output; ServerHello2 goes through after it.
    var key: [65]u8
    p256_share_2182(@key[0])
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, @key[0], 65)
    if tls_client_process(@client, @rec[0], m, @out[0], 1024, @out_len) != TLS_RESULT_NEED_INPUT
        return 300 - tls_client_error(@client)
    if client.state != TLS_STATE_SERVER_HELLO_RECEIVED || client.ccs_received != 1
        return 2
    return 0

[[test]]
fn test_retry_refuses_second_ccs_after_hrr() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var rec: [16]u8
    let c: i64 = ccs_2116(@rec[0], 1, 0x01)
    ccs_2116(@rec[c], 1, 0x01)
    return expect_err_2182(@client, @rec[0], 2 * c, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_refuses_ccs_after_hrr_and_after_server_hello() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [32]u8
    x25519_share_2182(@key[0])
    var rec: [256]u8
    let c: i64 = ccs_2116(@rec[0], 1, 0x01)
    let m: i64 = sh_2182(@rec[c], @client, TLS_AES_128_GCM_SHA256, GROUP_X25519, @key[0], 32)
    ccs_2116(@rec[c + m], 1, 0x01)
    return expect_err_2182(@client, @rec[0], c + m + c, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_ccs_before_any_hello_still_refused() -> i32
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var rec: [8]u8
    let c: i64 = ccs_2116(@rec[0], 1, 0x01)
    return expect_err_2182(@client, @rec[0], c, TLS_ERR_UNEXPECTED_MESSAGE)

[[test]]
fn test_retry_cookie_only_then_x25519_server_hello() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [32]u8
    x25519_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_X25519, @key[0], 32)
    var out: [1024]u8
    var out_len: i64 = 0
    if tls_client_process(@client, @rec[0], m, @out[0], 1024, @out_len) != TLS_RESULT_NEED_INPUT
        return 200 - tls_client_error(@client)
    if client.state != TLS_STATE_SERVER_HELLO_RECEIVED
        return 1
    return 0

[[test]]
fn test_retry_group_change_derives_p256_secret() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, GROUP_SECP256R1, 0, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [65]u8
    p256_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, @key[0], 65)
    var out: [1024]u8
    var out_len: i64 = 0
    if tls_client_process(@client, @rec[0], m, @out[0], 1024, @out_len) != TLS_RESULT_NEED_INPUT
        return 200 - tls_client_error(@client)
    if client.state != TLS_STATE_SERVER_HELLO_RECEIVED
        return 1

    # The server's side of the exchange, from the share on the wire.
    let k: i64 = ch_ext_2182(@ch2[0], ch2_len, 51)
    var d: [32]u8
    mem_zero(@d[0], 32)
    d[31] = 2
    var want: [32]u8
    if p256_ecdh(@want[0], @d[0], @ch2[k + 6]) != 0
        return 2
    if mem_eq(@client.shared_secret[0], @want[0], 32) != 1
        return 3
    return 0

[[test]]
fn test_retry_refuses_x25519_server_hello_after_p256_hrr() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, GROUP_SECP256R1, 0, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [32]u8
    x25519_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_X25519, @key[0], 32)
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_refuses_p256_server_hello_after_cookie_hrr() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [65]u8
    p256_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, @key[0], 65)
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_client_refuses_p256_server_hello_without_hrr() -> i32
    # We sent no secp256r1 share: there is no key to answer this one with.
    var client: TlsClient
    var ch1: [1024]u8
    if start_2182(@client, @ch1[0]) <= 0
        return 1
    var key: [65]u8
    p256_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, @key[0], 65)
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_refuses_server_hello_with_other_suite() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [32]u8
    x25519_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_CHACHA20_POLY1305_SHA256, GROUP_X25519, @key[0], 32)
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_refuses_server_hello_with_other_session_id() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, 0, 5, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [32]u8
    x25519_share_2182(@key[0])
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_X25519, @key[0], 32)
    rec[44] = rec[44] ^ 1
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_refuses_invalid_p256_share() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, GROUP_SECP256R1, 0, @ch2[0], @ch2_len)
    if r != 0
        return r
    var key: [65]u8
    p256_share_2182(@key[0])
    key[64] = key[64] ^ 1
    var rec: [256]u8
    let m: i64 = sh_2182(@rec[0], @client, TLS_AES_128_GCM_SHA256, GROUP_SECP256R1, @key[0], 65)
    return expect_err_2182(@client, @rec[0], m, TLS_ERR_ILLEGAL_PARAMETER)

[[test]]
fn test_retry_client_free_wipes_p256_key() -> i32
    var client: TlsClient
    var ch2: [1024]u8
    var ch2_len: i64 = 0
    let r: i32 = past_hrr_2182(@client, GROUP_SECP256R1, 0, @ch2[0], @ch2_len)
    if r != 0
        return r
    if mem_is_zero(@client.client_hello.p256_private[0], 32) != 0
        return 1
    tls_client_free(@client)
    if mem_is_zero(@client.client_hello.p256_private[0], 32) != 1
        return 2
    return 0
