# test/test_rsa.ritz - Tests for RSA signature verification

import cryptosec.rsa
import cryptosec.bigint
import cryptosec.mem

# ============================================================================
# RSA Public Key Parsing Tests
# ============================================================================

[[test]]
fn test_rsa_pubkey_init()
    var key: RsaPublicKey
    rsa_pubkey_init(@key)
    assert key.n_len == 0
    assert key.e == 0

[[test]]
fn test_rsa_parse_raw_pubkey()
    # Minimal RSA public key in raw RSAPublicKey format:
    # SEQUENCE {
    #   INTEGER (modulus = 0x00d5) - 2 bytes with leading 0
    #   INTEGER (exponent = 3)
    # }
    # DER: 30 08 02 03 00 00 d5 02 01 03
    var der: [10]u8
    der[0] = 0x30
    der[1] = 0x08
    der[2] = 0x02
    der[3] = 0x03
    der[4] = 0x00
    der[5] = 0x00
    der[6] = 0xd5
    der[7] = 0x02
    der[8] = 0x01
    der[9] = 0x03

    var key: RsaPublicKey
    let result: i32 = rsa_parse_public_key(@der[0], 10, @key)
    assert result == 0
    assert key.e == 3
    # Modulus should be 0xd5 = 213 (leading zeros stripped)
    assert key.n_len == 1
    assert key.n[0] == 0xd5

[[test]]
fn test_rsa_parse_pubkey_65537()
    # RSA key with e = 65537 (0x010001), common public exponent
    # SEQUENCE {
    #   INTEGER (modulus = 0x0101) - just a small test modulus
    #   INTEGER (exponent = 65537 = 0x010001)
    # }
    # DER: 30 09 02 02 01 01 02 03 01 00 01
    var der: [11]u8
    der[0] = 0x30
    der[1] = 0x09
    der[2] = 0x02
    der[3] = 0x02
    der[4] = 0x01
    der[5] = 0x01
    der[6] = 0x02
    der[7] = 0x03
    der[8] = 0x01
    der[9] = 0x00
    der[10] = 0x01

    var key: RsaPublicKey
    let result: i32 = rsa_parse_public_key(@der[0], 11, @key)
    assert result == 0
    assert key.e == 65537
    assert key.n_len == 2
    assert key.n[0] == 0x01
    assert key.n[1] == 0x01

# ============================================================================
# PKCS#1 v1.5 Padding Verification Tests
# ============================================================================

[[test]]
fn test_rsa_verify_sha256_basic()
    # Test that modular exponentiation works for RSA
    var base: BigInt
    var n: BigInt
    var result: BigInt

    # Use known test values
    # n = 0xbb (187 = 11 * 17), e = 3
    bigint_from_u64(@base, 100)
    bigint_from_u64(@n, 187)
    bigint_mod_exp_u32(@result, @base, 3, @n)
    # 100^3 mod 187 = 1000000 mod 187 = 111
    assert result.limbs[0] == 111

# ============================================================================
# DigestInfo Prefix Tests
# ============================================================================

[[test]]
fn test_sha256_digest_info_prefix()
    var prefix: [19]u8
    let len: i32 = get_sha256_digest_info_prefix(@prefix[0])
    assert len == 19
    # Verify DER encoding
    assert prefix[0] == 0x30
    assert prefix[1] == 0x31
    assert prefix[2] == 0x30
    assert prefix[3] == 0x0d
    assert prefix[4] == 0x06
    assert prefix[5] == 0x09
    assert prefix[6] == 0x60
    assert prefix[7] == 0x86
    assert prefix[8] == 0x48
    assert prefix[9] == 0x01
    assert prefix[10] == 0x65
    assert prefix[11] == 0x03
    assert prefix[12] == 0x04
    assert prefix[13] == 0x02
    assert prefix[14] == 0x01
    assert prefix[15] == 0x05
    assert prefix[16] == 0x00
    assert prefix[17] == 0x04
    assert prefix[18] == 0x20

[[test]]
fn test_sha384_digest_info_prefix()
    var prefix: [19]u8
    let len: i32 = get_sha384_digest_info_prefix(@prefix[0])
    assert len == 19
    # DER: 30 41 30 0d 06 09 60 86 48 01 65 03 04 02 02 05 00 04 30
    assert prefix[0] == 0x30
    assert prefix[1] == 0x41
    assert prefix[14] == 0x02
    assert prefix[18] == 0x30

[[test]]
fn test_sha512_digest_info_prefix()
    var prefix: [19]u8
    let len: i32 = get_sha512_digest_info_prefix(@prefix[0])
    assert len == 19
    # DER: 30 51 30 0d 06 09 60 86 48 01 65 03 04 02 03 05 00 04 40
    assert prefix[0] == 0x30
    assert prefix[1] == 0x51
    assert prefix[14] == 0x03
    assert prefix[18] == 0x40

# ============================================================================
# RSA-2048 Test Vector
# ============================================================================

[[test]]
fn test_rsa_256bit_modexp()
    # Test with 256-bit values
    var a: BigInt
    var n: BigInt
    var result: BigInt

    var a_bytes: [32]u8
    var n_bytes: [32]u8

    # a = 0x123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0
    a_bytes[0] = 0x12
    a_bytes[1] = 0x34
    a_bytes[2] = 0x56
    a_bytes[3] = 0x78
    a_bytes[4] = 0x9a
    a_bytes[5] = 0xbc
    a_bytes[6] = 0xde
    a_bytes[7] = 0xf0
    a_bytes[8] = 0x12
    a_bytes[9] = 0x34
    a_bytes[10] = 0x56
    a_bytes[11] = 0x78
    a_bytes[12] = 0x9a
    a_bytes[13] = 0xbc
    a_bytes[14] = 0xde
    a_bytes[15] = 0xf0
    a_bytes[16] = 0x12
    a_bytes[17] = 0x34
    a_bytes[18] = 0x56
    a_bytes[19] = 0x78
    a_bytes[20] = 0x9a
    a_bytes[21] = 0xbc
    a_bytes[22] = 0xde
    a_bytes[23] = 0xf0
    a_bytes[24] = 0x12
    a_bytes[25] = 0x34
    a_bytes[26] = 0x56
    a_bytes[27] = 0x78
    a_bytes[28] = 0x9a
    a_bytes[29] = 0xbc
    a_bytes[30] = 0xde
    a_bytes[31] = 0xf0

    # n = 0xfedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543211
    n_bytes[0] = 0xfe
    n_bytes[1] = 0xdc
    n_bytes[2] = 0xba
    n_bytes[3] = 0x98
    n_bytes[4] = 0x76
    n_bytes[5] = 0x54
    n_bytes[6] = 0x32
    n_bytes[7] = 0x10
    n_bytes[8] = 0xfe
    n_bytes[9] = 0xdc
    n_bytes[10] = 0xba
    n_bytes[11] = 0x98
    n_bytes[12] = 0x76
    n_bytes[13] = 0x54
    n_bytes[14] = 0x32
    n_bytes[15] = 0x10
    n_bytes[16] = 0xfe
    n_bytes[17] = 0xdc
    n_bytes[18] = 0xba
    n_bytes[19] = 0x98
    n_bytes[20] = 0x76
    n_bytes[21] = 0x54
    n_bytes[22] = 0x32
    n_bytes[23] = 0x10
    n_bytes[24] = 0xfe
    n_bytes[25] = 0xdc
    n_bytes[26] = 0xba
    n_bytes[27] = 0x98
    n_bytes[28] = 0x76
    n_bytes[29] = 0x54
    n_bytes[30] = 0x32
    n_bytes[31] = 0x11

    bigint_from_bytes(@a, @a_bytes[0], 32)
    bigint_from_bytes(@n, @n_bytes[0], 32)

    # Compute a^65537 mod n
    bigint_mod_exp_u32(@result, @a, 65537, @n)

    # Result should be some value < n
    assert bigint_lt(@result, @n) == 1
    assert bigint_is_zero(@result) == 0

# ============================================================================
# Invalid Signature Tests
# ============================================================================

[[test]]
fn test_rsa_invalid_signature_length()
    var key: RsaPublicKey
    rsa_pubkey_init(@key)

    # Set up a minimal key with 128-byte modulus
    key.n_len = 128
    key.e = 65537
    var i: i32 = 0
    while i < 128
        key.n[i] = 0xff
        i += 1

    # Signature with wrong length should fail
    var msg: [4]u8
    msg[0] = 0x74
    msg[1] = 0x65
    msg[2] = 0x73
    msg[3] = 0x74

    var sig: [64]u8
    i = 0
    while i < 64
        sig[i] = 0
        i += 1

    let result: i32 = rsa_verify_pkcs1_sha256(@key, @msg[0], 4, @sig[0], 64)
    assert result == 0

[[test]]
fn test_rsa_signature_too_large()
    var key: RsaPublicKey
    rsa_pubkey_init(@key)

    # Small modulus
    key.n[0] = 0x10
    key.n_len = 1
    key.e = 3

    # Signature larger than modulus
    var msg: [4]u8
    msg[0] = 0x74
    msg[1] = 0x65
    msg[2] = 0x73
    msg[3] = 0x74

    var sig: [1]u8
    sig[0] = 0xff

    # This should fail because modulus is too small (< 128 bytes)
    let result: i32 = rsa_verify_pkcs1_sha256(@key, @msg[0], 4, @sig[0], 1)
    assert result == 0

# ============================================================================
# RSA Signature Round-Trip Test (using tiny test key)
# ============================================================================

[[test]]
fn test_rsa_signature_roundtrip_tiny()
    # Use a tiny 512-bit modulus (64 bytes) for testing the full flow
    # In reality, 512-bit RSA is broken - this is just for testing the code path
    # We need a modulus >= 128 bytes for the PKCS#1 padding check, so use 128 bytes

    # For a 1024-bit (128-byte) key with e=3:
    # We manually construct what a valid signature would look like
    #
    # PKCS#1 v1.5 format: 00 01 FF...FF 00 DigestInfo
    # DigestInfo for SHA-256 = 19 bytes prefix + 32 bytes hash = 51 bytes
    # Total: 2 + PS + 1 + 51 = 128 bytes, so PS = 74 bytes minimum
    #
    # For this test, we verify the structure checking works by creating
    # an invalid signature and confirming it's rejected.

    var key: RsaPublicKey
    rsa_pubkey_init(@key)
    key.n_len = 128
    key.e = 3

    # Set modulus to all 0xFF (large prime-ish)
    var i: i32 = 0
    while i < 128
        key.n[i] = 0xff
        i += 1

    # Create a "signature" that is all zeros - should fail padding check
    var msg: [5]u8
    msg[0] = 0x68  # "hello"
    msg[1] = 0x65
    msg[2] = 0x6c
    msg[3] = 0x6c
    msg[4] = 0x6f

    var bad_sig: [128]u8
    i = 0
    while i < 128
        bad_sig[i] = 0
        i += 1

    # This should fail because the decrypted signature won't have valid PKCS#1 padding
    let result: i32 = rsa_verify_pkcs1_sha256(@key, @msg[0], 5, @bad_sig[0], 128)
    assert result == 0

    # Create another invalid signature - random-looking data
    i = 0
    while i < 128
        bad_sig[i] = (i * 17 + 5) as u8
        i += 1

    let result2: i32 = rsa_verify_pkcs1_sha256(@key, @msg[0], 5, @bad_sig[0], 128)
    assert result2 == 0

# ============================================================================
# Real RSA-2048/3072/4096 keys (AGAST #2134)
# ============================================================================
#
# RSA-3072/4096 used to be unusable: rsa_parse_public_key compared the modulus
# INTEGER's length (513 bytes for 4096 bits, with its 0x00 sign byte) against
# the 512-byte limit before stripping the sign byte, and bigint_mul dropped
# product limbs past 64, so s^e mod n was wrong for n > 2048 bits.

# openssl 3.5: RSA-2048 SubjectPublicKeyInfo (DER) and an RSA-SHA256 signature over
# "ritz-task-2134 RSA-2048 test message".
fn rsa2048_spki_hex() -> *u8
    return c""

fn rsa2048_sig_hex() -> *u8
    return c""

fn rsa2048_msg() -> *u8
    return c"ritz-task-2134 RSA-2048 test message"

# openssl 3.5: RSA-3072 SubjectPublicKeyInfo (DER) and an RSA-SHA256 signature over
# "ritz-task-2134 RSA-3072 test message".
fn rsa3072_spki_hex() -> *u8
    return c""

fn rsa3072_sig_hex() -> *u8
    return c""

fn rsa3072_msg() -> *u8
    return c"ritz-task-2134 RSA-3072 test message"

# openssl 3.5: RSA-4096 SubjectPublicKeyInfo (DER) and an RSA-SHA256 signature over
# "ritz-task-2134 RSA-4096 test message".
fn rsa4096_spki_hex() -> *u8
    return c""

fn rsa4096_sig_hex() -> *u8
    return c""

fn rsa4096_msg() -> *u8
    return c"ritz-task-2134 RSA-4096 test message"

fn hex_nibble(c: u8) -> i32
    if c >= 0x30 && c <= 0x39
        return (c - 0x30) as i32
    if c >= 0x61 && c <= 0x66
        return (c - 0x61 + 10) as i32
    return -1

# Decode lowercase hex into out[0..cap). Returns the byte count, or -1.
fn hex_decode(hex: *u8, out: *u8, cap: i32) -> i32
    var n: i32 = 0
    var i: i64 = 0
    while hex[i] != 0
        let hi: i32 = hex_nibble(hex[i])
        let lo: i32 = hex_nibble(hex[i + 1])
        if hi < 0 || lo < 0 || n >= cap
            return -1
        out[n] = ((hi << 4) | lo) as u8
        n += 1
        i += 2
    return n

fn cstr_len(s: *u8) -> i64
    var n: i64 = 0
    while s[n] != 0
        n += 1
    return n

# Parse `spki_hex`, check its modulus is `bits` long, and verify `sig_hex`
# over `msg`. If `tamper` >= 0, that signature byte is flipped first.
# Returns the verifier's verdict (1/0), or a negative setup error.
fn rsa_fixture_verify(spki_hex: *u8, sig_hex: *u8, msg: *u8, bits: i32, tamper: i32) -> i32
    var spki: [600]u8
    var sig: [512]u8
    let spki_len: i32 = hex_decode(spki_hex, @spki[0], 600)
    let sig_len: i32 = hex_decode(sig_hex, @sig[0], 512)
    if spki_len <= 0 || sig_len != bits / 8
        return -1
    var key: RsaPublicKey
    if rsa_parse_public_key(@spki[0], spki_len, @key) != 0
        return -2
    if key.n_len != bits / 8 || key.e != 65537
        return -3
    if tamper >= 0
        sig[tamper] = sig[tamper] ^ 0x01
    return rsa_verify_pkcs1_sha256(@key, msg, cstr_len(msg), @sig[0], sig_len)

[[test]]
fn test_rsa2048_verify_sha256() -> i32
    if rsa_fixture_verify(rsa2048_spki_hex(), rsa2048_sig_hex(), rsa2048_msg(), 2048, -1) != 1
        return 1
    return 0

[[test]]
fn test_rsa3072_verify_sha256() -> i32
    let r: i32 = rsa_fixture_verify(rsa3072_spki_hex(), rsa3072_sig_hex(), rsa3072_msg(), 3072, -1)
    if r < 0
        return (10 - r) as i32  # 11: fixture, 12: parse, 13: key shape
    if r != 1
        return 1
    return 0

[[test]]
fn test_rsa3072_verify_tampered_sig_rejected() -> i32
    # Flip a low bit at the end and one near the top of the signature.
    if rsa_fixture_verify(rsa3072_spki_hex(), rsa3072_sig_hex(), rsa3072_msg(), 3072, 383) != 0
        return 1
    if rsa_fixture_verify(rsa3072_spki_hex(), rsa3072_sig_hex(), rsa3072_msg(), 3072, 7) != 0
        return 2
    return 0

[[test]]
fn test_rsa4096_verify_sha256() -> i32
    let r: i32 = rsa_fixture_verify(rsa4096_spki_hex(), rsa4096_sig_hex(), rsa4096_msg(), 4096, -1)
    if r < 0
        return (10 - r) as i32  # 11: fixture, 12: parse, 13: key shape
    if r != 1
        return 1
    return 0

[[test]]
fn test_rsa4096_verify_tampered_sig_rejected() -> i32
    if rsa_fixture_verify(rsa4096_spki_hex(), rsa4096_sig_hex(), rsa4096_msg(), 4096, 511) != 0
        return 1
    if rsa_fixture_verify(rsa4096_spki_hex(), rsa4096_sig_hex(), rsa4096_msg(), 4096, 7) != 0
        return 2
    return 0

[[test]]
fn test_rsa4096_verify_wrong_message_rejected() -> i32
    if rsa_fixture_verify(rsa4096_spki_hex(), rsa4096_sig_hex(), rsa3072_msg(), 4096, -1) != 0
        return 1
    return 0

# Raw RSAPublicKey (SEQUENCE { INTEGER n, INTEGER 3 }) whose modulus INTEGER
# has `content` bytes: a 0x00 sign byte when `sign_byte` is 1, then 0xff..
fn build_raw_pubkey(buf: *u8, content: i32, sign_byte: i32) -> i32
    # 30 82 LL LL | 02 82 CC CC <content> | 02 01 03
    let seq_len: i32 = (4 + content + 3) as i32
    buf[0] = 0x30
    buf[1] = 0x82
    buf[2] = ((seq_len >> 8) & 0xff) as u8
    buf[3] = (seq_len & 0xff) as u8
    buf[4] = 0x02
    buf[5] = 0x82
    buf[6] = ((content >> 8) & 0xff) as u8
    buf[7] = (content & 0xff) as u8
    var i: i32 = 0
    while i < content
        buf[8 + i] = 0xff
        i += 1
    if sign_byte == 1
        buf[8] = 0x00
    buf[8 + content] = 0x02
    buf[9 + content] = 0x01
    buf[10 + content] = 0x03
    return (11 + content) as i32

[[test]]
fn test_rsa_parse_raw_pubkey_4096_sign_byte() -> i32
    # 513 content bytes = 0x00 + 512-byte (4096-bit) modulus: accepted.
    var buf: [600]u8
    let n: i32 = build_raw_pubkey(@buf[0], 513, 1)
    var key: RsaPublicKey
    if rsa_parse_public_key(@buf[0], n, @key) != 0
        return 1
    if key.n_len != 512 || key.n[0] != 0xff || key.n[511] != 0xff || key.e != 3
        return 2
    return 0

[[test]]
fn test_rsa_parse_raw_pubkey_over_4096_rejected() -> i32
    # 513 significant bytes (4104 bits) does not fit: refused, not truncated.
    var buf: [600]u8
    let n: i32 = build_raw_pubkey(@buf[0], 513, 0)
    var key: RsaPublicKey
    if rsa_parse_public_key(@buf[0], n, @key) == 0
        return 1
    return 0

# SPKI wrapper around a raw RSAPublicKey built by build_raw_pubkey.
fn build_spki_pubkey(buf: *u8, content: i32, sign_byte: i32) -> i32
    # 30 82 LL LL | 30 0d <rsaEncryption, NULL> | 03 82 BB BB 00 <raw>
    let raw_len: i32 = build_raw_pubkey(@buf[24], content, sign_byte)
    let bit_len: i32 = (raw_len + 1) as i32
    let seq_len: i32 = (15 + 4 + bit_len) as i32
    buf[0] = 0x30
    buf[1] = 0x82
    buf[2] = ((seq_len >> 8) & 0xff) as u8
    buf[3] = (seq_len & 0xff) as u8
    buf[4] = 0x30
    buf[5] = 0x0d
    buf[6] = 0x06
    buf[7] = 0x09
    buf[8] = 0x2a
    buf[9] = 0x86
    buf[10] = 0x48
    buf[11] = 0x86
    buf[12] = 0xf7
    buf[13] = 0x0d
    buf[14] = 0x01
    buf[15] = 0x01
    buf[16] = 0x01
    buf[17] = 0x05
    buf[18] = 0x00
    buf[19] = 0x03
    buf[20] = 0x82
    buf[21] = ((bit_len >> 8) & 0xff) as u8
    buf[22] = (bit_len & 0xff) as u8
    buf[23] = 0x00
    return (24 + raw_len) as i32

[[test]]
fn test_rsa_parse_spki_pubkey_4096_sign_byte() -> i32
    var buf: [640]u8
    let n: i32 = build_spki_pubkey(@buf[0], 513, 1)
    var key: RsaPublicKey
    if rsa_parse_public_key(@buf[0], n, @key) != 0
        return 1
    if key.n_len != 512 || key.n[0] != 0xff || key.n[511] != 0xff || key.e != 3
        return 2
    return 0

[[test]]
fn test_rsa_parse_spki_pubkey_over_4096_rejected() -> i32
    var buf: [640]u8
    let n: i32 = build_spki_pubkey(@buf[0], 513, 0)
    var key: RsaPublicKey
    if rsa_parse_public_key(@buf[0], n, @key) == 0
        return 1
    return 0
