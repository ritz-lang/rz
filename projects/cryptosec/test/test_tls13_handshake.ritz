# test/test_tls13_handshake.ritz - Tests for TLS 1.3 Handshake Messages

import ritzlib.sys

import cryptosec.mem
import cryptosec.sha256
import cryptosec.tls13_handshake
import cryptosec.random
import cryptosec.tls13_kdf
import cryptosec.x509
import cryptosec.p256
import cryptosec.ed25519
import cryptosec.rsa

# ============================================================================
# Transcript Hash Tests
# ============================================================================

[[test]]
fn test_transcript_init() -> i32
    var t: Transcript
    transcript_init(@t)

    if t.bytes_hashed != 0
        return 1
    if t.hash_alg != 0  # SHA-256
        return 2

    return 0

[[test]]
fn test_transcript_update_and_hash() -> i32
    var t: Transcript
    transcript_init(@t)

    # Hash "abc"
    transcript_update(@t, "abc", 3)

    var hash: [32]u8
    transcript_hash(@t, @hash[0])

    # SHA-256("abc") = ba7816bf...
    if hash[0] != 0xba
        return 1
    if hash[1] != 0x78
        return 2
    if hash[2] != 0x16
        return 3
    if hash[3] != 0xbf
        return 4

    return 0

[[test]]
fn test_transcript_incremental() -> i32
    var t: Transcript
    transcript_init(@t)

    # Hash in parts
    transcript_update(@t, "a", 1)
    transcript_update(@t, "bc", 2)

    var hash: [32]u8
    transcript_hash(@t, @hash[0])

    # Should be same as SHA-256("abc")
    if hash[0] != 0xba
        return 1
    if hash[1] != 0x78
        return 2

    return 0

[[test]]
fn test_transcript_multiple_hashes() -> i32
    var t: Transcript
    transcript_init(@t)

    transcript_update(@t, "hello", 5)

    var hash1: [32]u8
    transcript_hash(@t, @hash1[0])

    # Update more
    transcript_update(@t, "world", 5)

    var hash2: [32]u8
    transcript_hash(@t, @hash2[0])

    # Hashes should be different
    if mem_eq(@hash1[0], @hash2[0], 32) == 1
        return 1

    return 0

# ============================================================================
# ClientHello Tests
# ============================================================================

[[test]]
fn test_client_hello_init() -> i32
    var ch: ClientHello
    client_hello_init(@ch)

    # Should have random data (check it's not all zeros)
    var all_zero: i32 = 1
    var i: i32 = 0
    while i < 32
        if ch.random[i] != 0
            all_zero = 0
        i += 1

    if all_zero == 1
        return 1  # Random should not be all zeros

    # Should have X25519 key pair
    all_zero = 1
    i = 0
    while i < 32
        if ch.x25519_public[i] != 0
            all_zero = 0
        i += 1

    if all_zero == 1
        return 2  # Public key should not be all zeros

    # Should have cipher suites
    if ch.num_cipher_suites < 1
        return 3

    return 0

[[test]]
fn test_client_hello_init_fails_on_rng_failure() -> i32
    # AGAST #1863: a ClientHello must never go out with an unset random,
    # session id or private key. Fail each of the three RNG calls in turn:
    # each is reported and no key material is left behind.
    var ch: ClientHello
    for n in 0..3
        for i in 0..32
            ch.x25519_private[i] = 0xAA
        random_test_fail_after(n)
        let result: i32 = client_hello_init(@ch)
        random_test_force_failure(0)
        if result != -1
            return 1 + n * 10
        if mem_is_zero(@ch.x25519_private[0], 32) != 1
            return 2 + n * 10
    if client_hello_init(@ch) != 0
        return 3
    return 0

[[test]]
fn test_client_hello_set_hostname() -> i32
    var ch: ClientHello
    client_hello_init(@ch)

    client_hello_set_hostname(@ch, "example.com", 11)

    if ch.hostname_len != 11
        return 1

    if ch.hostname[0] != 101  # 'e'
        return 2
    if ch.hostname[10] != 109  # 'm'
        return 3

    return 0

[[test]]
fn test_client_hello_serialize() -> i32
    var ch: ClientHello
    client_hello_init(@ch)
    client_hello_set_hostname(@ch, "test.local", 10)

    var buf: [512]u8
    let len: i64 = client_hello_serialize(@ch, @buf[0], 512)

    if len < 100
        return 1  # Too short

    # Check handshake header
    if buf[0] != HS_CLIENT_HELLO
        return 2

    # Check legacy version
    if buf[4] != 0x03 || buf[5] != 0x03
        return 3

    return 0

[[test]]
fn test_client_hello_extensions() -> i32
    var ch: ClientHello
    client_hello_init(@ch)

    var buf: [512]u8
    let len: i64 = client_hello_serialize(@ch, @buf[0], 512)

    # Look for supported_versions extension (type 43 = 0x002B)
    var found_versions: i32 = 0
    var found_key_share: i32 = 0

    var i: i64 = 0
    while i < len - 3
        let ext_type: u16 = ((buf[i] as u16) << 8) | (buf[i + 1] as u16)
        if ext_type == EXT_SUPPORTED_VERSIONS
            found_versions = 1
        if ext_type == EXT_KEY_SHARE
            found_key_share = 1
        i += 1

    if found_versions == 0
        return 1
    if found_key_share == 0
        return 2

    return 0

# ============================================================================
# ServerHello Tests
# ============================================================================

[[test]]
fn test_server_hello_parse_basic() -> i32
    # Minimal ServerHello:
    # version (2) + random (32) + session_id_len (1) + session_id (0) +
    # cipher_suite (2) + compression (1) + extensions_len (2) + extensions
    var data: [128]u8

    var pos: i32 = 0

    # Legacy version TLS 1.2
    data[pos] = 0x03
    data[pos + 1] = 0x03
    pos = pos + 2

    # Random (32 bytes)
    var i: i32 = 0
    while i < 32
        data[pos] = (i + 1) as u8
        pos += 1
        i += 1

    # Session ID length (0)
    data[pos] = 0
    pos += 1

    # Cipher suite: TLS_AES_128_GCM_SHA256
    data[pos] = 0x13
    data[pos + 1] = 0x01
    pos = pos + 2

    # Compression method (null)
    data[pos] = 0
    pos += 1

    # Extensions
    let ext_start: i32 = pos + 2

    # supported_versions extension
    data[ext_start] = 0x00
    data[ext_start + 1] = 0x2b  # Type 43
    data[ext_start + 2] = 0x00
    data[ext_start + 3] = 0x02  # Length 2
    data[ext_start + 4] = 0x03
    data[ext_start + 5] = 0x04  # TLS 1.3

    # key_share extension
    data[ext_start + 6] = 0x00
    data[ext_start + 7] = 0x33  # Type 51
    data[ext_start + 8] = 0x00
    data[ext_start + 9] = 0x24  # Length 36
    data[ext_start + 10] = 0x00
    data[ext_start + 11] = 0x1d  # X25519
    data[ext_start + 12] = 0x00
    data[ext_start + 13] = 0x20  # Key length 32

    # X25519 public key (32 bytes)
    i = 0
    while i < 32
        data[ext_start + 14 + i] = (0x50 + i) as u8
        i += 1

    let ext_len: i32 = 6 + 4 + 36  # supported_versions + key_share
    data[pos] = (ext_len >> 8) as u8
    data[pos + 1] = (ext_len & 0xff) as u8

    let total_len: i32 = pos + 2 + ext_len

    var sh: ServerHello
    let result: i32 = server_hello_parse(@data[0], total_len as i64, @sh)

    if result != 0
        return 1 + (-result)

    if sh.cipher_suite != TLS_AES_128_GCM_SHA256
        return 10

    if sh.negotiated_version != TLS_VERSION_13
        return 11

    if sh.has_key_share != 1
        return 12

    # Check X25519 key was parsed
    if sh.x25519_public[0] != 0x50
        return 13

    return 0

[[test]]
fn test_server_hello_missing_version() -> i32
    # ServerHello without supported_versions extension
    var data: [64]u8

    var pos: i32 = 0

    # Version
    data[pos] = 0x03
    data[pos + 1] = 0x03
    pos = pos + 2

    # Random
    var i: i32 = 0
    while i < 32
        data[pos] = 0
        pos += 1
        i += 1

    # Session ID length
    data[pos] = 0
    pos += 1

    # Cipher suite
    data[pos] = 0x13
    data[pos + 1] = 0x01
    pos = pos + 2

    # Compression
    data[pos] = 0
    pos += 1

    # Extensions length (empty)
    data[pos] = 0
    data[pos + 1] = 0
    pos = pos + 2

    var sh: ServerHello
    let result: i32 = server_hello_parse(@data[0], pos as i64, @sh)

    # Should fail because no TLS 1.3 version
    if result >= 0
        return 1

    return 0

# ============================================================================
# EncryptedExtensions Tests
# ============================================================================

[[test]]
fn test_encrypted_extensions_empty() -> i32
    # Minimal EncryptedExtensions: just 2-byte length (0)
    var data: [2]u8
    data[0] = 0
    data[1] = 0

    var ee: EncryptedExtensions
    let result: i32 = encrypted_extensions_parse(@data[0], 2, @ee)

    if result != 0
        return 1

    if ee.has_server_name != 0
        return 2

    return 0

[[test]]
fn test_encrypted_extensions_with_sni() -> i32
    # EncryptedExtensions with server_name acknowledgment
    var data: [8]u8

    # Extensions length
    data[0] = 0
    data[1] = 4  # 4 bytes of extensions

    # server_name extension (type 0, empty value)
    data[2] = 0
    data[3] = 0  # Type 0
    data[4] = 0
    data[5] = 0  # Length 0

    var ee: EncryptedExtensions
    let result: i32 = encrypted_extensions_parse(@data[0], 6, @ee)

    if result != 0
        return 1

    if ee.has_server_name != 1
        return 2

    return 0

# ============================================================================
# Certificate Message Tests
# ============================================================================

[[test]]
fn test_certificate_parse_single() -> i32
    # Certificate message with one certificate
    var data: [100]u8

    var pos: i32 = 0

    # certificate_request_context (length 0)
    data[pos] = 0
    pos += 1

    # Certificate list length (3 bytes)
    # One cert entry: 3 (cert len) + 20 (cert data) + 2 (ext len) + 0 = 25
    data[pos] = 0
    data[pos + 1] = 0
    data[pos + 2] = 25
    pos = pos + 3

    # Certificate entry 1
    # cert_data length (3 bytes)
    data[pos] = 0
    data[pos + 1] = 0
    data[pos + 2] = 20
    pos = pos + 3

    # cert_data (20 bytes of dummy data)
    var i: i32 = 0
    while i < 20
        data[pos] = (0x30 + i) as u8
        pos += 1
        i += 1

    # Extensions length (2 bytes, 0)
    data[pos] = 0
    data[pos + 1] = 0
    pos = pos + 2

    var cm: CertificateMessage
    let result: i32 = certificate_parse(@data[0], pos as i64, @cm)

    if result != 0
        return 1

    if cm.num_certs != 1
        return 2

    if cm.cert_lens[0] != 20
        return 3

    # Check cert data pointer
    let first_byte: u8 = cm.cert_data[0][0]
    if first_byte != 0x30
        return 4

    return 0

[[test]]
fn test_certificate_parse_chain() -> i32
    # Certificate message with two certificates
    var data: [200]u8

    var pos: i32 = 0

    # certificate_request_context (length 0)
    data[pos] = 0
    pos += 1

    # Certificate list length (3 bytes)
    # Two cert entries: (3+10+2) + (3+15+2) = 35
    data[pos] = 0
    data[pos + 1] = 0
    data[pos + 2] = 35
    pos = pos + 3

    # Certificate entry 1 (10 bytes)
    data[pos] = 0
    data[pos + 1] = 0
    data[pos + 2] = 10
    pos = pos + 3

    var i: i32 = 0
    while i < 10
        data[pos] = 0xAA
        pos += 1
        i += 1

    data[pos] = 0
    data[pos + 1] = 0
    pos = pos + 2

    # Certificate entry 2 (15 bytes)
    data[pos] = 0
    data[pos + 1] = 0
    data[pos + 2] = 15
    pos = pos + 3

    i = 0
    while i < 15
        data[pos] = 0xBB
        pos += 1
        i += 1

    data[pos] = 0
    data[pos + 1] = 0
    pos = pos + 2

    var cm: CertificateMessage
    let result: i32 = certificate_parse(@data[0], pos as i64, @cm)

    if result != 0
        return 1

    if cm.num_certs != 2
        return 2

    if cm.cert_lens[0] != 10
        return 3

    if cm.cert_lens[1] != 15
        return 4

    return 0

# ============================================================================
# CertificateVerify Tests
# ============================================================================

[[test]]
fn test_certificate_verify_parse() -> i32
    var data: [100]u8

    # Signature algorithm RSA-PKCS1-SHA256 (0x0401)
    data[0] = 0x04
    data[1] = 0x01

    # Signature length (32 bytes for test)
    data[2] = 0
    data[3] = 32

    # Signature data
    var i: i32 = 0
    while i < 32
        data[4 + i] = (i + 1) as u8
        i += 1

    var cv: CertificateVerify
    let result: i32 = certificate_verify_parse(@data[0], 36, @cv)

    if result != 0
        return 1

    if cv.algorithm != SIG_RSA_PKCS1_SHA256
        return 2

    if cv.signature_len != 32
        return 3

    if cv.signature[0] != 1
        return 4

    return 0

# ============================================================================
# Finished Message Tests
# ============================================================================

[[test]]
fn test_finished_compute() -> i32
    # Use a known base_key and transcript_hash
    var base_key: [32]u8
    var transcript_hash: [32]u8
    var verify_data: [32]u8

    # Fill with test values
    var i: i32 = 0
    while i < 32
        base_key[i] = (i + 1) as u8
        transcript_hash[i] = (i + 0x10) as u8
        i += 1

    finished_compute(@base_key[0], @transcript_hash[0], @verify_data[0])

    # verify_data should not be all zeros
    var all_zero: i32 = 1
    i = 0
    while i < 32
        if verify_data[i] != 0
            all_zero = 0
        i += 1

    if all_zero == 1
        return 1

    return 0

[[test]]
fn test_finished_verify_success() -> i32
    var base_key: [32]u8
    var transcript_hash: [32]u8
    var verify_data: [32]u8

    var i: i32 = 0
    while i < 32
        base_key[i] = (i + 5) as u8
        transcript_hash[i] = (i + 0x20) as u8
        i += 1

    # Compute expected verify_data
    finished_compute(@base_key[0], @transcript_hash[0], @verify_data[0])

    # Verify should succeed
    let result: i32 = finished_verify(@base_key[0], @transcript_hash[0], @verify_data[0])

    if result != 1
        return 1

    return 0

[[test]]
fn test_finished_verify_failure() -> i32
    var base_key: [32]u8
    var transcript_hash: [32]u8
    var verify_data: [32]u8

    var i: i32 = 0
    while i < 32
        base_key[i] = (i + 5) as u8
        transcript_hash[i] = (i + 0x20) as u8
        verify_data[i] = 0xFF  # Wrong value
        i += 1

    # Verify should fail
    let result: i32 = finished_verify(@base_key[0], @transcript_hash[0], @verify_data[0])

    if result != 0
        return 1

    return 0

[[test]]
fn test_finished_serialize() -> i32
    var verify_data: [32]u8
    var i: i32 = 0
    while i < 32
        verify_data[i] = (i + 1) as u8
        i += 1

    var out: [64]u8
    let len: i64 = finished_serialize(@verify_data[0], @out[0])

    if len != 36
        return 1

    # Check header
    if out[0] != HS_FINISHED
        return 2

    # Check length
    if out[3] != 32
        return 3

    # Check data
    if out[4] != 1
        return 4

    return 0

# ============================================================================
# Handshake Header Tests
# ============================================================================

[[test]]
fn test_handshake_header_parse() -> i32
    var data: [260]u8
    data[0] = HS_CLIENT_HELLO
    data[1] = 0x00
    data[2] = 0x01
    data[3] = 0x00  # Length = 256

    var hdr: HandshakeHeader
    let result: i32 = handshake_header_parse(@data[0], 260, @hdr)

    if result != 0
        return 1

    if hdr.msg_type != HS_CLIENT_HELLO
        return 2

    if hdr.length != 256
        return 3

    return 0

[[test]]
fn test_handshake_header_parse_rejects_length_past_buffer() -> i32
    # #1861: the 24-bit length is wire-supplied. A header claiming more body
    # than the caller's buffer holds must be rejected, not handed back.
    var data: [8]u8
    data[0] = HS_CLIENT_HELLO
    data[1] = 0x00
    data[2] = 0x00
    data[3] = 0x05  # Length = 5, but only 4 body bytes follow
    var hdr: HandshakeHeader
    if handshake_header_parse(@data[0], 8, @hdr) == 0
        return 1
    return 0

[[test]]
fn test_handshake_header_parse_rejects_max_length() -> i32
    var data: [4]u8
    data[0] = HS_CLIENT_HELLO
    data[1] = 0xff
    data[2] = 0xff
    data[3] = 0xff  # Length = 2^24 - 1
    var hdr: HandshakeHeader
    if handshake_header_parse(@data[0], 4, @hdr) == 0
        return 1
    return 0

[[test]]
fn test_handshake_header_parse_accepts_exact_fit() -> i32
    # Body exactly fills the buffer: accepted.
    var data: [8]u8
    data[0] = HS_FINISHED
    data[1] = 0x00
    data[2] = 0x00
    data[3] = 0x04
    var hdr: HandshakeHeader
    if handshake_header_parse(@data[0], 8, @hdr) != 0
        return 1
    if hdr.length != 4
        return 2
    return 0

# ============================================================================
# Integration: ClientHello to Transcript
# ============================================================================

[[test]]
fn test_client_hello_transcript() -> i32
    var ch: ClientHello
    client_hello_init(@ch)

    var buf: [512]u8
    let len: i64 = client_hello_serialize(@ch, @buf[0], 512)

    # Add to transcript
    var t: Transcript
    transcript_init(@t)
    transcript_update(@t, @buf[0], len)

    # Get hash
    var hash: [32]u8
    transcript_hash(@t, @hash[0])

    # Should have non-zero hash
    var all_zero: i32 = 1
    var i: i32 = 0
    while i < 32
        if hash[i] != 0
            all_zero = 0
        i += 1

    if all_zero == 1
        return 1

    return 0

# ============================================================================
# CertificateVerify signature verification (#1862 / REVIEW.md H-2)
# ============================================================================

# Fill a 32-byte transcript hash with a fixed pattern.
fn cv_test_transcript(th: *u8)
    var i: i32 = 0
    while i < 32
        th[i] = (i * 7 + 3) as u8
        i += 1

# P-256 key from a fixed scalar; pubkey gets the X.509 uncompressed point.
fn cv_test_p256_key(priv: *Scalar256, pubkey: *X509PublicKey)
    var d: [32]u8
    var i: i32 = 0
    while i < 32
        d[i] = (i + 1) as u8
        i += 1
    scalar256_from_bytes(priv, @d[0])
    var q: P256Point
    ecdsa_p256_pubkey_from_privkey(@q, priv)
    var qx: FeP256
    var qy: FeP256
    p256_point_to_affine(@q, @qx, @qy)
    mem_zero(pubkey as *u8, sizeof(X509PublicKey))
    pubkey.algorithm = PUBKEY_TYPE_EC
    pubkey.curve = EC_CURVE_P256
    pubkey.key_data[0] = 0x04
    fep256_to_bytes(@qx, @pubkey.key_data[1])
    fep256_to_bytes(@qy, @pubkey.key_data[33])
    pubkey.key_len = 65

# Sign the CV content for `th` with ECDSA P-256 into a DER CertificateVerify.
fn cv_test_ecdsa_sign(priv: *Scalar256, th: *u8, cv: *CertificateVerify) -> i32
    var content: [130]u8
    certificate_verify_content(th, @content[0])
    var hash: [32]u8
    sha256(@content[0], 130, @hash[0])
    var sig: EcdsaSignature
    if ecdsa_p256_sign(@sig, @hash[0], priv) == 0
        return -1
    mem_zero(cv as *u8, sizeof(CertificateVerify))
    cv.algorithm = SIG_ECDSA_SECP256R1_SHA256
    cv.signature_len = ecdsa_signature_to_der(@sig, @cv.signature[0])
    return 0

[[test]]
fn test_cv_verify_ecdsa_valid_signature() -> i32
    var priv: Scalar256
    var pk: X509PublicKey
    cv_test_p256_key(@priv, @pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    if cv_test_ecdsa_sign(@priv, @th[0], @cv) != 0
        return 1
    if certificate_verify_verify(@cv, @th[0], @pk) != 0
        return 2
    return 0

[[test]]
fn test_cv_verify_ecdsa_rejects_other_transcript() -> i32
    var priv: Scalar256
    var pk: X509PublicKey
    cv_test_p256_key(@priv, @pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    if cv_test_ecdsa_sign(@priv, @th[0], @cv) != 0
        return 1
    th[5] = th[5] ^ 0x01
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    return 0

[[test]]
fn test_cv_verify_ecdsa_rejects_corrupt_signature() -> i32
    var priv: Scalar256
    var pk: X509PublicKey
    cv_test_p256_key(@priv, @pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    if cv_test_ecdsa_sign(@priv, @th[0], @cv) != 0
        return 1
    # Last byte of s
    let last: i64 = cv.signature_len - 1
    cv.signature[last] = cv.signature[last] ^ 0x40
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    return 0

[[test]]
fn test_cv_verify_ecdsa_rejects_other_key() -> i32
    var priv: Scalar256
    var pk: X509PublicKey
    cv_test_p256_key(@priv, @pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    if cv_test_ecdsa_sign(@priv, @th[0], @cv) != 0
        return 1
    # Re-sign with a different scalar: same pubkey must reject it.
    var other: [32]u8
    var i: i32 = 0
    while i < 32
        other[i] = (90 - i) as u8
        i += 1
    var priv2: Scalar256
    scalar256_from_bytes(@priv2, @other[0])
    if cv_test_ecdsa_sign(@priv2, @th[0], @cv) != 0
        return 2
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 3
    return 0

fn cv_test_ed25519(pk: *X509PublicKey, th: *u8, cv: *CertificateVerify)
    var seed: [32]u8
    var i: i32 = 0
    while i < 32
        seed[i] = (200 - i) as u8
        i += 1
    var priv: [64]u8
    mem_zero(pk as *u8, sizeof(X509PublicKey))
    ed25519_keygen(@pk.key_data[0], @priv[0], @seed[0])
    pk.algorithm = PUBKEY_TYPE_ED25519
    pk.key_len = 32
    var content: [130]u8
    certificate_verify_content(th, @content[0])
    mem_zero(cv as *u8, sizeof(CertificateVerify))
    cv.algorithm = SIG_ED25519
    ed25519_sign(@cv.signature[0], @content[0], 130, @priv[0])
    cv.signature_len = 64

[[test]]
fn test_cv_verify_ed25519_valid_signature() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_test_ed25519(@pk, @th[0], @cv)
    if certificate_verify_verify(@cv, @th[0], @pk) != 0
        return 1
    return 0

[[test]]
fn test_cv_verify_ed25519_rejects_corrupt_signature() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_test_ed25519(@pk, @th[0], @cv)
    cv.signature[10] = cv.signature[10] ^ 0x01
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    return 0

[[test]]
fn test_ecdsa_sig_from_der_rejects_trailing_bytes() -> i32
    # SEQUENCE { INTEGER 1, INTEGER 2 }; then the same with a stray byte
    # inside the SEQUENCE length.
    var der: [9]u8
    der[0] = 0x30
    der[1] = 0x06
    der[2] = 0x02
    der[3] = 0x01
    der[4] = 0x01
    der[5] = 0x02
    der[6] = 0x01
    der[7] = 0x02
    der[8] = 0x00
    var sig: EcdsaSignature
    if ecdsa_sig_from_der(@der[0], 8, @sig) != 0
        return 1  # well-formed 8-byte encoding must parse
    der[1] = 0x07
    if ecdsa_sig_from_der(@der[0], 9, @sig) == 0
        return 2
    return 0

[[test]]
fn test_cv_verify_rejects_key_type_mismatch() -> i32
    # A genuinely valid Ed25519 signature, but the certificate says the key is
    # P-256: the algorithm must match the certificate's key type.
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_test_ed25519(@pk, @th[0], @cv)
    pk.algorithm = PUBKEY_TYPE_EC
    pk.curve = EC_CURVE_P256
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    return 0

# ============================================================================
# CertificateVerify under P-384 keys (AGAST #2115)
# ============================================================================
# One P-384 key (Python cryptography, test-only) signed the CV content for
# cv_test_transcript() under SHA-384 (cv384_sig) and SHA-256 (cv384_sig256).

fn cv384_hex_nibble(c: u8) -> u8
    if c >= 0x61
        return c - 0x61 + 10
    return c - 0x30

fn cv384_hex(s: *u8, out: *u8) -> i64
    var n: i64 = 0
    while s[n * 2] != 0
        out[n] = (cv384_hex_nibble(s[n * 2]) << 4) | cv384_hex_nibble(s[n * 2 + 1])
        n = n + 1
    return n

fn cv384_key(pk: *X509PublicKey)
    mem_zero(pk as *u8, sizeof(X509PublicKey))
    pk.algorithm = PUBKEY_TYPE_EC
    pk.curve = EC_CURVE_P384
    pk.key_len = cv384_hex(c"04d65fea0224a5c28d4078163539a82db97fd300e9dab776399a40b9292acc2ffd3c10d7c7d4e8671f54fdd5c046fc20dfa16e683750c3e5a84b975ccbcb95501fdd1f31e1dcfbad5064caadb795a2aa2d96283a987109abc805d5fd8da1b7313c", @pk.key_data[0]) as u64

fn cv384_sig(cv: *CertificateVerify, algorithm: u16, sha256_sig: i32)
    mem_zero(cv as *u8, sizeof(CertificateVerify))
    cv.algorithm = algorithm
    if sha256_sig == 1
        cv.signature_len = cv384_hex(c"3065023100bd75ffef39dc5d078344f7b3597b9e5449053a93a0697ebdf0691595d715fd0ee2f25b0c0ef55a455737f31839ac66fc023077715bc2868f88aa83c044612f94f08974a0c133a70a5a4e088b63ba1ba0d78dd2e0cf8bb4e52db4e0a9de78fc9f5180", @cv.signature[0])
    else
        cv.signature_len = cv384_hex(c"3065023100f7bb3094cc18c4ada2b806cd993937f5eb3bde9a0e25e253abaa682456d1078f1834da49425c4ddaf6796008202906e402303bc318e5ce911e53b55b1ff48070cbd197d9aa57f518c6b728460ae7cc2e0deddae6160f6cdb7368d2228c01bbefbf05", @cv.signature[0])

[[test]]
fn test_cv_verify_ecdsa_p384_sha384_valid_signature() -> i32
    var pk: X509PublicKey
    cv384_key(@pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv384_sig(@cv, SIG_ECDSA_SECP384R1_SHA384, 0)
    if certificate_verify_verify(@cv, @th[0], @pk) != 0
        return 1
    th[5] = th[5] ^ 0x01
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    th[5] = th[5] ^ 0x01
    cv.signature[cv.signature_len - 1] = cv.signature[cv.signature_len - 1] ^ 0x40
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 3
    return 0

[[test]]
fn test_cv_verify_ecdsa_p384_binds_hash_and_curve() -> i32
    var pk: X509PublicKey
    cv384_key(@pk)
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    # A SHA-256 signature labelled ecdsa_secp384r1_sha384
    cv384_sig(@cv, SIG_ECDSA_SECP384R1_SHA384, 1)
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    # ecdsa_secp256r1_sha256 names the curve too: not under a P-384 key
    cv384_sig(@cv, SIG_ECDSA_SECP384R1_SHA384, 0)
    cv.algorithm = SIG_ECDSA_SECP256R1_SHA256
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 3
    # ecdsa_secp384r1_sha384 under a P-256 key
    var priv: Scalar256
    var pk256: X509PublicKey
    cv_test_p256_key(@priv, @pk256)
    cv384_sig(@cv, SIG_ECDSA_SECP384R1_SHA384, 0)
    if certificate_verify_verify(@cv, @th[0], @pk256) == 0
        return 4
    return 0

[[test]]
fn test_client_hello_advertises_ecdsa_p384() -> i32
    var ch: ClientHello
    if client_hello_init(@ch) != 0
        return 1
    var buf: [512]u8
    let len: i64 = client_hello_serialize(@ch, @buf[0], 512)
    if len <= 0
        return 2
    # signature_algorithms (0x000d): ext_len(2) list_len(2) schemes...
    var i: i64 = 0
    while i + 6 < len
        if buf[i] == 0x00 && buf[i + 1] == 0x0d
            let list_len: i64 = ((buf[i + 4] as i64) << 8) | (buf[i + 5] as i64)
            let ext_len: i64 = ((buf[i + 2] as i64) << 8) | (buf[i + 3] as i64)
            if ext_len == list_len + 2 && i + 6 + list_len <= len
                var j: i64 = 0
                while j < list_len
                    if buf[i + 6 + j] == 0x05 && buf[i + 7 + j] == 0x03
                        return 0
                    j = j + 2
        i = i + 1
    return 3

# ============================================================================
# HelloRetryRequest detection (AGAST #2116)
# ============================================================================

[[test]]
fn test_hrr_random_is_rfc8446_value() -> i32
    var r: [32]u8
    hello_retry_request_random(@r[0])
    # SHA-256("HelloRetryRequest"), RFC 8446 4.1.3
    if r[0] != 0xCF || r[1] != 0x21 || r[2] != 0xAD || r[3] != 0x74
        return 1
    if r[15] != 0x91 || r[16] != 0xC2 || r[30] != 0x33 || r[31] != 0x9C
        return 2
    var h: [32]u8
    sha256(c"HelloRetryRequest", 17, @h[0])
    if mem_eq(@h[0], @r[0], 32) != 1
        return 3
    return 0

[[test]]
fn test_server_hello_is_retry_request() -> i32
    var body: [40]u8
    mem_zero(@body[0], 40)
    body[0] = 0x03
    body[1] = 0x03
    hello_retry_request_random(@body[2])
    if server_hello_is_retry_request(@body[0], 40) != 1
        return 1
    # Too short to hold the random.
    if server_hello_is_retry_request(@body[0], 33) != 0
        return 2
    body[33] = body[33] ^ 0x01
    if server_hello_is_retry_request(@body[0], 40) != 0
        return 3
    body[33] = body[33] ^ 0x01
    body[2] = body[2] ^ 0x80
    if server_hello_is_retry_request(@body[0], 40) != 0
        return 4
    return 0

# ============================================================================
# CertificateVerify under RSA keys: rsa_pss_rsae_sha256 (AGAST #2110)
# ============================================================================
# Python cryptography 49 (test-only keys). Every signature is over the CV
# content for cv_test_transcript(). Keys are RSAPublicKey DER, as X.509
# stores them.
#   pss       RSASSA-PSS, SHA-256, MGF1-SHA-256, salt 32 (what TLS 1.3 sends)
#   pkcs1     RSASSA-PKCS1-v1_5 SHA-256
#   salt0     PSS with a zero-length salt (TLS 1.3 requires salt = hash length)
#   sha384    PSS-SHA-384 / MGF1-SHA-384 / salt 48
# Hand-built EMs (salt 32), raw-signed with the private key; H always matches
# the salt, so each one is rejected only by the check it names:
#   handmade  well-formed (sanity: it verifies)
#   topbit    leftmost (8*emLen - emBits) bit of maskedDB set
#   trailer   last byte 0xbd, not 0xbc
#   ps        a nonzero byte in PS
#   sep       0x02 where the 0x01 separator belongs
# plus_n is a valid signature s with n added (s + n < 2^2048): congruent, so
# only the s < n check rejects it. The 2049-bit key has emLen = k - 1 = 256,
# so the RSAVP1 output's leading byte must be 0; leadbyte raw-signs
# 0x01 || valid EM.

fn rsa2048_key_hex() -> *u8
    return c""

fn rsa2048_pss_hex() -> *u8
    return c""

fn rsa2048_pkcs1_hex() -> *u8
    return c""

fn rsa2048_pss_salt0_hex() -> *u8
    return c""

fn rsa2048_pss_sha384_hex() -> *u8
    return c""

fn rsa2048_pss_handmade_hex() -> *u8
    return c""

fn rsa2048_pss_topbit_hex() -> *u8
    return c""

fn rsa2048_pss_trailer_hex() -> *u8
    return c""

fn rsa2048_pss_ps_hex() -> *u8
    return c""

fn rsa2048_pss_sep_hex() -> *u8
    return c""

fn rsa2048_pss_plus_n_hex() -> *u8
    return c""

fn rsa2049_key_hex() -> *u8
    return c""

fn rsa2049_pss_hex() -> *u8
    return c""

fn rsa2049_pss_leadbyte_hex() -> *u8
    return c""

fn cv_rsa_key(pk: *X509PublicKey, key_hex: *u8)
    mem_zero(pk as *u8, sizeof(X509PublicKey))
    pk.algorithm = PUBKEY_TYPE_RSA
    pk.curve = EC_CURVE_UNKNOWN
    pk.key_len = cv384_hex(key_hex, @pk.key_data[0]) as u64

fn cv_rsa_sig(cv: *CertificateVerify, algorithm: u16, sig_hex: *u8)
    mem_zero(cv as *u8, sizeof(CertificateVerify))
    cv.algorithm = algorithm
    cv.signature_len = cv384_hex(sig_hex, @cv.signature[0])

# rsa_verify_pss_sha256 over the CV content for cv_test_transcript().
fn rsa_pss_check(key_hex: *u8, sig_hex: *u8) -> i32
    var der: [600]u8
    let der_len: i64 = cv384_hex(key_hex, @der[0])
    var key: RsaPublicKey
    if rsa_parse_public_key(@der[0], der_len as i32, @key) != 0
        return -1
    var sig: [512]u8
    let sig_len: i64 = cv384_hex(sig_hex, @sig[0])
    var th: [32]u8
    cv_test_transcript(@th[0])
    var content: [130]u8
    certificate_verify_content(@th[0], @content[0])
    return rsa_verify_pss_sha256(@key, @content[0], 130, @sig[0], sig_len as i32)

[[test]]
fn test_rsa_pss_sha256_verifies() -> i32
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_hex()) != 1
        return 1
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_handmade_hex()) != 1
        return 2
    return 0

[[test]]
fn test_rsa_pss_sha256_2049_bit_modulus() -> i32
    # modBits - 1 = 2048 is a multiple of 8: EM is one byte shorter than k.
    if rsa_pss_check(rsa2049_key_hex(), rsa2049_pss_hex()) != 1
        return 1
    return 0

[[test]]
fn test_rsa_pss_sha256_rejects_other_encodings() -> i32
    # Each of these is a genuine signature by the same key, just not
    # PSS-SHA256 with a 32-byte salt over this message.
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pkcs1_hex()) != 0
        return 1
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_salt0_hex()) != 0
        return 2
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_sha384_hex()) != 0
        return 3
    # Signed by the 2048-bit key, checked under the 2049-bit one.
    if rsa_pss_check(rsa2049_key_hex(), rsa2048_pss_hex()) != 0
        return 4
    return 0

[[test]]
fn test_rsa_pss_sha256_rejects_set_top_bit() -> i32
    # RFC 8017 §9.1.2 step 6: the bits of maskedDB above emBits must be 0.
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_topbit_hex()) != 0
        return 1
    return 0

[[test]]
fn test_rsa_pss_sha256_rejects_bad_padding() -> i32
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_trailer_hex()) != 0
        return 1
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_ps_hex()) != 0
        return 2
    if rsa_pss_check(rsa2048_key_hex(), rsa2048_pss_sep_hex()) != 0
        return 3
    return 0

[[test]]
fn test_rsa_pss_sha256_rejects_nonzero_leading_byte() -> i32
    # I2OSP(m, emLen) fails when m >= 256^emLen (RFC 8017 §8.1.2 step 2c).
    if rsa_pss_check(rsa2049_key_hex(), rsa2049_pss_leadbyte_hex()) != 0
        return 1
    return 0

[[test]]
fn test_rsa_pss_sha256_rejects_bad_length_and_range() -> i32
    var der: [600]u8
    let der_len: i64 = cv384_hex(rsa2048_key_hex(), @der[0])
    var key: RsaPublicKey
    if rsa_parse_public_key(@der[0], der_len as i32, @key) != 0
        return 1
    var sig: [512]u8
    let sig_len: i64 = cv384_hex(rsa2048_pss_hex(), @sig[0])
    var th: [32]u8
    cv_test_transcript(@th[0])
    var content: [130]u8
    certificate_verify_content(@th[0], @content[0])
    if rsa_verify_pss_sha256(@key, @content[0], 130, @sig[0], sig_len as i32) != 1
        return 2
    # Truncated signature
    if rsa_verify_pss_sha256(@key, @content[0], 130, @sig[0], (sig_len - 1) as i32) != 0
        return 3
    # k + 1 bytes: a 0x00 prefix leaves the integer unchanged, but the
    # signature must be exactly k bytes long.
    var padded: [513]u8
    padded[0] = 0
    mem_copy(@padded[1], @sig[0], sig_len as u64)
    if rsa_verify_pss_sha256(@key, @content[0], 130, @padded[0], (sig_len + 1) as i32) != 0
        return 4
    # s + n, congruent to a valid s mod n, but out of range
    let plus_len: i64 = cv384_hex(rsa2048_pss_plus_n_hex(), @sig[0])
    if rsa_verify_pss_sha256(@key, @content[0], 130, @sig[0], plus_len as i32) != 0
        return 5
    return 0

[[test]]
fn test_cv_verify_rsa_pss_valid_signature() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2048_pss_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) != 0
        return 1
    cv_rsa_key(@pk, rsa2049_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2049_pss_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) != 0
        return 2
    return 0

[[test]]
fn test_cv_verify_rsa_pss_rejects_other_transcript() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2048_pss_hex())
    th[5] = th[5] ^ 0x01
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    return 0

[[test]]
fn test_cv_verify_rsa_pss_rejects_corrupt_signature() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2048_pss_hex())
    cv.signature[255] = cv.signature[255] ^ 0x01
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2048_pss_hex())
    cv.signature[7] = cv.signature[7] ^ 0x80
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    return 0

[[test]]
fn test_cv_verify_rejects_rsa_pkcs1() -> i32
    # rsa_pkcs1_* is forbidden in TLS 1.3 CertificateVerify (RFC 8446
    # §4.2.3): a genuine PKCS#1 v1.5 signature must not verify, whichever
    # scheme it is labelled with.
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PKCS1_SHA256, rsa2048_pkcs1_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    cv.algorithm = SIG_RSA_PSS_RSAE_SHA256
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    # Nor does a valid PSS signature labelled rsa_pkcs1_sha256.
    cv_rsa_sig(@cv, SIG_RSA_PKCS1_SHA256, rsa2048_pss_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 3
    return 0

[[test]]
fn test_cv_verify_rsa_pss_binds_scheme_and_key_type() -> i32
    var pk: X509PublicKey
    var th: [32]u8
    cv_test_transcript(@th[0])
    var cv: CertificateVerify
    # rsa_pss_rsae_sha384 / _sha512 are not implemented: refused, even for
    # a genuine PSS-SHA-384 signature.
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA384, rsa2048_pss_sha384_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 1
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA512, rsa2048_pss_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 2
    # rsa_pss_rsae_sha256 needs an rsaEncryption key in the certificate.
    cv_rsa_sig(@cv, SIG_RSA_PSS_RSAE_SHA256, rsa2048_pss_hex())
    pk.algorithm = PUBKEY_TYPE_EC
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 3
    # And an RSA key is not an ECDSA / Ed25519 key.
    cv_rsa_key(@pk, rsa2048_key_hex())
    cv_rsa_sig(@cv, SIG_ECDSA_SECP256R1_SHA256, rsa2048_pss_hex())
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 4
    cv.algorithm = SIG_ED25519
    if certificate_verify_verify(@cv, @th[0], @pk) == 0
        return 5
    return 0

# ============================================================================
# HelloRetryRequest (AGAST #2182)
# ============================================================================

fn be16_2182(p: *u8, v: i64)
    p[0] = ((v >> 8) & 0xff) as u8
    p[1] = (v & 0xff) as u8

# Start an HRR body with a `sid_len`-byte session id echo. Returns the offset
# of the extensions length field; hrr_add_2182 and hrr_end_2182 finish it.
fn hrr_begin_2182(out: *u8, sid_len: i64) -> i64
    out[0] = 0x03
    out[1] = 0x03
    hello_retry_request_random(out + 2)
    out[34] = sid_len as u8
    var i: i64 = 0
    while i < sid_len
        out[35 + i] = 0x77
        i += 1
    var p: i64 = 35 + sid_len
    be16_2182(out + p, TLS_AES_128_GCM_SHA256 as i64)
    out[p + 2] = 0
    return p + 3

fn hrr_add_2182(out: *u8, pos: i64, ext: u16, data: *u8, len: i64) -> i64
    be16_2182(out + pos, ext as i64)
    be16_2182(out + pos + 2, len)
    mem_copy(out + pos + 4, data, len)
    return pos + 4 + len

fn hrr_add_version_2182(out: *u8, pos: i64) -> i64
    var v: [2]u8
    v[0] = 0x03
    v[1] = 0x04
    return hrr_add_2182(out, pos, EXT_SUPPORTED_VERSIONS, @v[0], 2)

fn hrr_add_group_2182(out: *u8, pos: i64, group: u16) -> i64
    var g: [2]u8
    be16_2182(@g[0], group as i64)
    return hrr_add_2182(out, pos, EXT_KEY_SHARE, @g[0], 2)

fn hrr_add_cookie_2182(out: *u8, pos: i64, len: i64) -> i64
    var c: [64]u8
    be16_2182(@c[0], len)
    var i: i64 = 0
    while i < len
        c[2 + i] = (0x40 + i) as u8
        i += 1
    return hrr_add_2182(out, pos, EXT_COOKIE, @c[0], 2 + len)

fn hrr_end_2182(out: *u8, ext_at: i64, end: i64) -> i64
    be16_2182(out + ext_at, end - ext_at - 2)
    return end

# Parse an HRR holding supported_versions plus, if set, a group and a cookie.
fn hrr_good_2182(buf: *u8, hrr: *HelloRetryRequest, group: u16, cookie_len: i64) -> i32
    let at: i64 = hrr_begin_2182(buf, 0)
    var p: i64 = hrr_add_version_2182(buf, at + 2)
    if group != 0
        p = hrr_add_group_2182(buf, p, group)
    if cookie_len > 0
        p = hrr_add_cookie_2182(buf, p, cookie_len)
    return hello_retry_request_parse(buf, hrr_end_2182(buf, at, p), hrr)

[[test]]
fn test_hrr_parse_group_and_cookie() -> i32
    var buf: [256]u8
    let at: i64 = hrr_begin_2182(@buf[0], 32)
    var p: i64 = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_group_2182(@buf[0], p, GROUP_SECP256R1)
    p = hrr_add_cookie_2182(@buf[0], p, 5)
    var hrr: HelloRetryRequest
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != 0
        return 1
    if hrr.cipher_suite != TLS_AES_128_GCM_SHA256
        return 2
    if hrr.session_id_len != 32 || hrr.session_id[31] != 0x77
        return 3
    if hrr.has_selected_group != 1 || hrr.selected_group != GROUP_SECP256R1
        return 4
    if hrr.cookie_len != 5 || hrr.cookie[0] != 0x40 || hrr.cookie[4] != 0x44
        return 5
    return 0

[[test]]
fn test_hrr_parse_cookie_only_has_no_group() -> i32
    var buf: [256]u8
    var hrr: HelloRetryRequest
    if hrr_good_2182(@buf[0], @hrr, 0, 3) != 0
        return 1
    if hrr.has_selected_group != 0 || hrr.cookie_len != 3
        return 2
    return 0

