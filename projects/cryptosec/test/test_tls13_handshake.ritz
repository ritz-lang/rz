    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -14
        return 1
    return 0

[[test]]
fn test_hrr_parse_rejects_duplicates() -> i32
    var buf: [256]u8
    var hrr: HelloRetryRequest
    let at: i64 = hrr_begin_2182(@buf[0], 0)
    var p: i64 = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_version_2182(@buf[0], p)
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -9
        return 1
    p = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_group_2182(@buf[0], p, GROUP_SECP256R1)
    p = hrr_add_group_2182(@buf[0], p, GROUP_SECP256R1)
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -11
        return 2
    p = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_cookie_2182(@buf[0], p, 2)
    p = hrr_add_cookie_2182(@buf[0], p, 2)
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -12
        return 3
    return 0

