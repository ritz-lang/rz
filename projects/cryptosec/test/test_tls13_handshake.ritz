    let n: i64 = hrr_end_2182(@buf[0], at, hrr_add_version_2182(@buf[0], at + 2))
    buf[1] = 0x04
    if hello_retry_request_parse(@buf[0], n, @hrr) != -2
        return 1
    return 0

