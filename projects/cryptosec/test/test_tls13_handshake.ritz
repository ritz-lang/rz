    var v: [2]u8
    v[0] = 0x03
    v[1] = 0x03
    let p: i64 = hrr_add_2182(@buf[0], at + 2, EXT_SUPPORTED_VERSIONS, @v[0], 2)
    var hrr: HelloRetryRequest
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -10
        return 1
    return 0

[[test]]
fn test_hrr_parse_rejects_bad_legacy_version() -> i32
