        return 2
    p = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_cookie_2182(@buf[0], p, 2)
    p = hrr_add_cookie_2182(@buf[0], p, 2)
    if hello_retry_request_parse(@buf[0], hrr_end_2182(@buf[0], at, p), @hrr) != -12
        return 3
    return 0

