[[test]]
fn test_hrr_parse_rejects_truncation_at_every_length() -> i32
    var buf: [256]u8
    var hrr: HelloRetryRequest
    let at: i64 = hrr_begin_2182(@buf[0], 4)
    var p: i64 = hrr_add_version_2182(@buf[0], at + 2)
    p = hrr_add_group_2182(@buf[0], p, GROUP_SECP256R1)
    let n: i64 = hrr_end_2182(@buf[0], at, hrr_add_cookie_2182(@buf[0], p, 5))
    var i: i64 = 0
    while i < n
        if hello_retry_request_parse(@buf[0], i, @hrr) >= 0
            return 1 + i as i32
        i += 1
    if hello_retry_request_parse(@buf[0], n, @hrr) != 0
        return 500
    return 0

