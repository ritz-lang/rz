    let n: i64 = hrr_end_2182(@buf[0], at, hrr_add_version_2182(@buf[0], at + 2))
    if hello_retry_request_parse(@buf[0], n + 1, @hrr) != -6
        return 1
    return 0

[[test]]
fn test_hrr_parse_rejects_extension_we_did_not_offer() -> i32
