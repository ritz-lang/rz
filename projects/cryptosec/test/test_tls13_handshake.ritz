    var i: i64 = 0
    while i < n
        if hello_retry_request_parse(@buf[0], i, @hrr) >= 0
            return 1 + i as i32
        i += 1
    if hello_retry_request_parse(@buf[0], n, @hrr) != 0
        return 500
    return 0

