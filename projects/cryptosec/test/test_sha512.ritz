# =============================================================================
# Additional Tests
# =============================================================================

[[test]]
fn test_sha512_deterministic() -> i32
    # Same input should always produce same output
    var hash1: [64]u8
    var hash2: [64]u8
    let msg = "hello"
    sha512_str(msg, @hash1[0])
    sha512_str(msg, @hash2[0])
    if mem_eq(@hash1[0], @hash2[0], 64) != 1
        return 1
    0

[[test]]
fn test_sha384_deterministic() -> i32
    var hash1: [48]u8
    var hash2: [48]u8
    let msg = "hello"
    sha384_str(msg, @hash1[0])
    sha384_str(msg, @hash2[0])
    if mem_eq(@hash1[0], @hash2[0], 48) != 1
        return 1
    0

[[test]]
fn test_sha512_different_inputs() -> i32
    var hash1: [64]u8
    var hash2: [64]u8
    let msg1 = "abc"
    let msg2 = "abd"
    sha512_str(msg1, @hash1[0])
    sha512_str(msg2, @hash2[0])
    # Different inputs should produce different outputs
    if mem_eq(@hash1[0], @hash2[0], 64) == 1
        return 1
    0

[[test]]
fn test_sha512_large_message() -> i32
    # Test with message > 1 block (128 bytes)
    var msg: [200]u8
    var i: i32 = 0
    while i < 200
        msg[i] = 0x61  # 'a'
        i += 1
    var hash: [64]u8
    sha512(@msg[0], 200, @hash[0])
    # Just verify it doesn't crash and produces non-zero output
    var zeros: [64]u8
    i = 0
    while i < 64
        zeros[i] = 0
        i += 1
    if mem_eq(@hash[0], @zeros[0], 64) == 1
        return 1
    0

[[test]]
fn test_sha384_large_message() -> i32
    var msg: [200]u8
    var i: i32 = 0
    while i < 200
        msg[i] = 0x61
        i += 1
    var hash: [48]u8
    sha384(@msg[0], 200, @hash[0])
    var zeros: [48]u8
    i = 0
    while i < 48
        zeros[i] = 0
        i += 1
    if mem_eq(@hash[0], @zeros[0], 48) == 1
        return 1
    0

[[test]]
fn test_sha512_block_boundary() -> i32
    # Test message exactly at block boundary (128 bytes)
    var msg: [128]u8
    var i: i32 = 0
    while i < 128
        msg[i] = 0x62  # 'b'
        i += 1
    var hash: [64]u8
    sha512(@msg[0], 128, @hash[0])
    var zeros: [64]u8
    i = 0
    while i < 64
        zeros[i] = 0
        i += 1
    if mem_eq(@hash[0], @zeros[0], 64) == 1
        return 1
    0

# =============================================================================
# Padding and streaming across the 112/128-byte boundaries (AGAST #2588)
# =============================================================================
# SHA-384 and SHA-512 share one compression and padding path; these pin both
# outputs at every length where padding takes one or two final blocks, one-shot
# and streamed (1 byte, then up to a block, then the rest). Digests: Python
# hashlib over byte i = (i * 7 + 1) & 0xff.

fn fill_pat(buf: *u8, n: i32)
    var i: i32 = 0
    while i < n
        buf[i] = ((i * 7 + 1) & 0xff) as u8
        i += 1

fn sha2_512_family_case(n: i32, e384: StrView, e512: StrView) -> i32
    var msg: [256]u8
    fill_pat(@msg[0], n)
    var h384: [48]u8
    var h512: [64]u8
    sha384(@msg[0], n as u64, @h384[0])
    if hash384_eq_hex(@h384[0], e384) != 1
        return 1
    sha512(@msg[0], n as u64, @h512[0])
    if hash512_eq_hex(@h512[0], e512) != 1
        return 2
    var mid: i32 = n - 1
    if mid > 128
        mid = 128
    var c384: Sha384 = sha384_new()
    sha384_init(@c384)
    sha384_update(@c384, @msg[0], 1)
    sha384_update(@c384, @msg[1], mid as u64)
    sha384_update(@c384, @msg[1 + mid], (n - 1 - mid) as u64)
    sha384_final(@c384, @h384[0])
    if hash384_eq_hex(@h384[0], e384) != 1
        return 3
    var c512: Sha512 = sha512_new()
    sha512_init(@c512)
    sha512_update(@c512, @msg[0], 1)
    sha512_update(@c512, @msg[1], mid as u64)
    sha512_update(@c512, @msg[1 + mid], (n - 1 - mid) as u64)
    sha512_final(@c512, @h512[0])
    if hash512_eq_hex(@h512[0], e512) != 1
        return 4
    return 0

[[test]]
fn test_sha384_sha512_padding_boundaries() -> i32
    var r0: i32 = sha2_512_family_case(111, "89c1d81d1cbc65ca869e61315165f6c3c2468b518cd03f641fac6cf9d1e857889807399d23113dc8ba27f5eac8b68ac2", "3dfde1184fd99f233f98be4250f4edb9b535157909b668334370742204d97e047f1fd6a74bb5ba447f337286f421d9af957811f7ef62a458771457da126cb65e")
    if r0 != 0
        return 10 + r0
    var r1: i32 = sha2_512_family_case(112, "7b412ee8bc1953a28becb4f3417b3f0ceb41b4fc74d40f3054156e7cb3220b9adf7589cb9a92bc17537873b7ce1161c8", "acc96c509e6d01787330a4c6a241e2cda9dcc2529dbe4288dbbcc3812133233c4698831127cf6ed0b333632b22715a5ce53a0a1002a684367b71c98aa6d1d900")
    if r1 != 0
        return 20 + r1
    var r2: i32 = sha2_512_family_case(127, "714fa595ed33148c59e469ef0423462749b953698aaab1491ed101eb24b9e9a6b3a4e6d55b0ef14ee1dff02cc15ea103", "a315910cb7812a8e66d87c0c49a42d93dbe97bf0240ee995792292c529256d93f40199a59b3f6266343f302651fea1589e2040a2f3756126d3fe4f421a72079d")
    if r2 != 0
        return 30 + r2
    var r3: i32 = sha2_512_family_case(128, "147ae27db2fd5e4381c21983e753d8f761190fac65a833746ff2558abc9c3244279b8c880537ca2990aacee7bf20358e", "31f33a52b36dc2e70c83b604fa999a5cabf33bf70e4556fbed7bff10870c1b7b241dd3f15d1ade24599f068fc58ab51e0028b0f0c98895c23358e8dee032ce06")
    if r3 != 0
        return 40 + r3
    var r4: i32 = sha2_512_family_case(129, "ba91c6a4a8860362942120527ff39a9a15dc821434d0d51cb25a96ed90890fd940b6ff9ea17b469551dca7d081fa2b7e", "748fec3280c9165199f8c260e87eea61cbbe1b23ef1567c220df65b37e3fcced15fa7f63c9a381fde38ddd4eb2b09b67f77d03c5e0a639b487e8c48343590c97")
    if r4 != 0
        return 50 + r4
    var r5: i32 = sha2_512_family_case(239, "02010ff24bd03d6faf78b5917358b8e06bf474ee5aa3dab2abc57359e803c73f8035484fbc5087e0f8a76eb4a0903e08", "d5e023834c68aeb6e8eef9619ed5fb6fd8b3df796b49d18dce5f6fae76f3f6cae8ddf055611c4031bf5fe6aa68708360f5de1fe69a77055eb55612c5509d5e19")
    if r5 != 0
        return 60 + r5
    var r6: i32 = sha2_512_family_case(240, "6b10ff2d44cd25361a96cc752c0578e91aaaf2416060c154ec593e60029b15957bada77fc99ee9e2ea006dc300b745d1", "67b19552bd96d84b251b262b7eef6fe73b2fdeabc4a4a0e4de2c8c621ee395729b3877c85c2b0fa79e379ca718f1a00d7508d8a5c04967fe240d4608edf05c10")
    if r6 != 0
        return 70 + r6
    0

# ============================================================================
# sha512_new / sha384_new return ready contexts (GitHub #149 L-9, AGAST #2586)
# ============================================================================

# A context from sha512_new hashes correctly with no sha512_init call: the
# name promises a ready context, and an all-zero state silently gave a wrong
# digest.
[[test]]
fn test_sha512_new_is_ready_2586() -> i32
    var hash: [64]u8
    var ctx: Sha512 = sha512_new()
    sha512_update_str(@ctx, "abc")
    sha512_final(@ctx, @hash[0])
    let expected = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    if hash512_eq_hex(@hash[0], expected) != 1
        return 1
    return 0

# The same for sha384_new, which must start from the SHA-384 IV, not
# SHA-512's.
[[test]]
fn test_sha384_new_is_ready_2586() -> i32
    var hash: [48]u8
    let msg = "abc"
    var ctx: Sha384 = sha384_new()
    sha384_update(@ctx, msg.ptr, msg.len as u64)
    sha384_final(@ctx, @hash[0])
    let expected = "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    if hash384_eq_hex(@hash[0], expected) != 1
        return 1
    return 0
