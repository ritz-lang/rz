# test/test_hkdf.ritz - Tests for HKDF (RFC 5869)
#
# HKDF = HMAC-based Key Derivation Function
# Test vectors from RFC 5869

import ritzlib.sys
import ritzlib.io
import ritzlib.strview

import cryptosec.hkdf
import cryptosec.hmac
import cryptosec.crypto_error
import cryptosec.mem

# ============================================================================
# Helper: Compare output to expected hex
# ============================================================================

fn hex_char_to_val(c: u8) -> u8
    if c >= 48
        if c <= 57
            return c - 48
    if c >= 97
        if c <= 102
            return c - 97 + 10
    if c >= 65
        if c <= 70
            return c - 65 + 10
    return 0

fn bytes_eq_hex(bytes: *u8, hex: StrView, len: i32) -> i32
    var i: i32 = 0
    while i < len
        let hi: u8 = hex_char_to_val(hex.get(i * 2))
        let lo: u8 = hex_char_to_val(hex.get(i * 2 + 1))
        let expected: u8 = (hi << 4) | lo
        if bytes[i] != expected
            return 0
        i += 1
    return 1

fn fill_from_hex(out: *u8, hex: StrView, len: i32)
    var i: i32 = 0
    while i < len
        let hi: u8 = hex_char_to_val(hex.get(i * 2))
        let lo: u8 = hex_char_to_val(hex.get(i * 2 + 1))
        out[i] = (hi << 4) | lo
        i += 1

# ============================================================================
# RFC 5869 Test Vectors - Test Case 1
# ============================================================================

[[test]]
fn test_hkdf_sha256_rfc5869_test1() -> i32
    # Test Case 1 - Basic test
    # IKM  = 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b (22 octets)
    # salt = 0x000102030405060708090a0b0c (13 octets)
    # info = 0xf0f1f2f3f4f5f6f7f8f9 (10 octets)
    # L    = 42
    # PRK  = 0x077709362c2e32df0ddc3f0dc47bba63...
    # OKM  = 0x3cb25f25faacd57a90434f64d0362f2a...

    var ikm: [22]u8
    var i: i32 = 0
    while i < 22
        ikm[i] = 0x0b
        i += 1

    var salt: [13]u8
    i = 0
    while i < 13
        salt[i] = i as u8
        i += 1

    var info: [10]u8
    i = 0
    while i < 10
        info[i] = (0xf0 + i) as u8
        i += 1

    var okm: [42]u8
    hkdf_sha256(@salt[0], 13, @ikm[0], 22, @info[0], 10, @okm[0], 42)

    let expected = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
    if bytes_eq_hex(@okm[0], expected, 42) != 1
        return 1
    0

[[test]]
fn test_hkdf_sha256_rfc5869_test2() -> i32
    # Test Case 2 - Longer inputs/outputs
    # IKM  = 0x000102...4f (80 octets)
    # salt = 0x606162...af (80 octets)
    # info = 0xb0b1b2...ff (80 octets)
    # L    = 82

    var ikm: [80]u8
    var i: i32 = 0
    while i < 80
        ikm[i] = i as u8
        i += 1

    var salt: [80]u8
    i = 0
    while i < 80
        salt[i] = (0x60 + i) as u8
        i += 1

    var info: [80]u8
    i = 0
    while i < 80
        info[i] = (0xb0 + i) as u8
        i += 1

    var okm: [82]u8
    hkdf_sha256(@salt[0], 80, @ikm[0], 80, @info[0], 80, @okm[0], 82)

    let expected = "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87"
    if bytes_eq_hex(@okm[0], expected, 82) != 1
        return 1
    0

[[test]]
fn test_hkdf_sha256_rfc5869_test3() -> i32
    # Test Case 3 - Zero-length salt/info
    # IKM  = 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b (22 octets)
    # salt = (0 octets)
    # info = (0 octets)
    # L    = 42

    var ikm: [22]u8
    var i: i32 = 0
    while i < 22
        ikm[i] = 0x0b
        i += 1

    var okm: [42]u8
    hkdf_sha256(null, 0, @ikm[0], 22, null, 0, @okm[0], 42)

    let expected = "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8"
    if bytes_eq_hex(@okm[0], expected, 42) != 1
        return 1
    0

# ============================================================================
# HKDF-Extract tests
# ============================================================================

[[test]]
fn test_hkdf_extract_basic() -> i32
    # Test extract step alone
    var ikm: [22]u8
    var i: i32 = 0
    while i < 22
        ikm[i] = 0x0b
        i += 1

    var salt: [13]u8
    i = 0
    while i < 13
        salt[i] = i as u8
        i += 1

    var prk: [32]u8
    hkdf_extract(@salt[0], 13, @ikm[0], 22, @prk[0])

    let expected = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    if bytes_eq_hex(@prk[0], expected, 32) != 1
        return 1
    0

[[test]]
fn test_hkdf_extract_no_salt() -> i32
    # Extract with zero-length salt
    var ikm: [22]u8
    var i: i32 = 0
    while i < 22
        ikm[i] = 0x0b
        i += 1

    var prk: [32]u8
    hkdf_extract(null, 0, @ikm[0], 22, @prk[0])

    # PRK should not be all zeros
    if mem_is_zero(@prk[0], 32) == 1
        return 1
    0

# ============================================================================
# HKDF-Expand tests
# ============================================================================

[[test]]
fn test_hkdf_expand_basic() -> i32
    # Test expand step with known PRK
    # PRK from test case 1
    var prk: [32]u8
    let prk_hex = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    fill_from_hex(@prk[0], prk_hex, 32)

    var info: [10]u8
    var i: i32 = 0
    while i < 10
        info[i] = (0xf0 + i) as u8
        i += 1

    var okm: [42]u8
    hkdf_expand(@prk[0], @info[0], 10, @okm[0], 42)

    let expected = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
    if bytes_eq_hex(@okm[0], expected, 42) != 1
        return 1
    0

[[test]]
fn test_hkdf_expand_no_info() -> i32
    # Expand with zero-length info
    var prk: [32]u8
    let prk_hex = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    fill_from_hex(@prk[0], prk_hex, 32)

    var okm: [32]u8
    hkdf_expand(@prk[0], null, 0, @okm[0], 32)

    # Output should not be all zeros
    if mem_is_zero(@okm[0], 32) == 1
        return 1
    0

# ============================================================================
# Edge cases
# ============================================================================

[[test]]
fn test_hkdf_deterministic() -> i32
    # Same inputs should produce same output
    var ikm: [16]u8
    var i: i32 = 0
    while i < 16
        ikm[i] = (i + 1) as u8
        i += 1

    let salt = "salt"
    let info = "info"

    var okm1: [32]u8
    var okm2: [32]u8

    hkdf_sha256(salt.ptr, 4, @ikm[0], 16, info.ptr, 4, @okm1[0], 32)
    hkdf_sha256(salt.ptr, 4, @ikm[0], 16, info.ptr, 4, @okm2[0], 32)

    if mem_eq(@okm1[0], @okm2[0], 32) != 1
        return 1
    0

[[test]]
fn test_hkdf_different_info_different_output() -> i32
    # Different info should produce different output
    var ikm: [16]u8
    var i: i32 = 0
    while i < 16
        ikm[i] = (i + 1) as u8
        i += 1

    let salt = "salt"
    let info1 = "info1"
    let info2 = "info2"

    var okm1: [32]u8
    var okm2: [32]u8

    hkdf_sha256(salt.ptr, 4, @ikm[0], 16, info1.ptr, 5, @okm1[0], 32)
    hkdf_sha256(salt.ptr, 4, @ikm[0], 16, info2.ptr, 5, @okm2[0], 32)

    if mem_eq(@okm1[0], @okm2[0], 32) == 1
        return 1  # Should be different!
    0

[[test]]
fn test_hkdf_short_output() -> i32
    # Request only 16 bytes
    var ikm: [16]u8
    var i: i32 = 0
    while i < 16
        ikm[i] = 0xaa
        i += 1

    var okm: [16]u8
    hkdf_sha256(null, 0, @ikm[0], 16, null, 0, @okm[0], 16)

    if mem_is_zero(@okm[0], 16) == 1
        return 1
    0

# ============================================================================
# Tests using the idiomatic _str API
# ============================================================================

[[test]]
fn test_hkdf_sha256_str_api() -> i32
    # Test the idiomatic StrView-based API
    var ikm: [16]u8
    var i: i32 = 0
    while i < 16
        ikm[i] = (i + 1) as u8
        i += 1

    let salt = "salt"
    let info = "info"
    let ikm_view = strview_from_ptr(@ikm[0], 16)

    var okm: [32]u8
    hkdf_sha256_str(salt, ikm_view, info, @okm[0], 32)

    # Output should not be all zeros
    if mem_is_zero(@okm[0], 32) == 1
        return 1
    0

[[test]]
fn test_hkdf_extract_str_api() -> i32
    # Test extract with StrView API
    var ikm: [22]u8
    var i: i32 = 0
    while i < 22
        ikm[i] = 0x0b
        i += 1

    var salt_bytes: [13]u8
    i = 0
    while i < 13
        salt_bytes[i] = i as u8
        i += 1

    let salt_view = strview_from_ptr(@salt_bytes[0], 13)
    let ikm_view = strview_from_ptr(@ikm[0], 22)

    var prk: [32]u8
    hkdf_extract_str(salt_view, ikm_view, @prk[0])

    let expected = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    if bytes_eq_hex(@prk[0], expected, 32) != 1
        return 1
    0

[[test]]
fn test_hkdf_expand_str_api() -> i32
    # Test expand with StrView API
    var prk: [32]u8
    let prk_hex = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    fill_from_hex(@prk[0], prk_hex, 32)

    let prk_view = strview_from_ptr(@prk[0], 32)

    var info_bytes: [10]u8
    var i: i32 = 0
    while i < 10
        info_bytes[i] = (0xf0 + i) as u8
        i += 1
    let info_view = strview_from_ptr(@info_bytes[0], 10)

    var okm: [42]u8
    hkdf_expand_str(prk_view, info_view, @okm[0], 42)

    let expected = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
    if bytes_eq_hex(@okm[0], expected, 42) != 1
        return 1
    0

# ============================================================================
# Length limits (AGAST #2579, GitHub #140)
#
# hkdf_expand used to build T(i-1) || info || i in a 256-byte stack buffer,
# so info longer than 223 bytes wrote past it. RFC 5869 puts no limit on
# info; the one limit it has is L <= 255 * HashLen (8160 for SHA-256).
# ============================================================================

# Bytes written by an Ok result, or -1 for Err.
fn ok_len(r: Result<i64, CryptoError>) -> i64
    match r
        Ok(n) => n
        Err(_) => -1

fn is_invalid_length(r: Result<i64, CryptoError>) -> bool
    match r
        Ok(_) => false
        Err(e) =>
            match e
                CryptoError.InvalidLength => true
                _ => false

const BIG_INFO: i64 = 4096

# RFC 5869 §2.3 by hand for two blocks, straight from hmac_sha256:
#   T(1) = HMAC(PRK, info || 0x01), T(2) = HMAC(PRK, T(1) || info || 0x02)
fn expand_two_blocks_by_hand(prk: *u8, info: *u8, info_len: i64, out: *u8)
    var msg: [4200]u8
    mem_copy(@msg[0], info, info_len)
    msg[info_len] = 1
    hmac_sha256(prk, 32, @msg[0], (info_len + 1) as u64, out)
    mem_copy(@msg[0], out, 32)
    mem_copy(@msg[32], info, info_len)
    msg[32 + info_len] = 2
    hmac_sha256(prk, 32, @msg[0], (32 + info_len + 1) as u64, out + 32)

fn fill_byte(buf: *u8, b: u8, len: i64)
    var i: i64 = 0
    while i < len
        buf[i] = b
        i += 1

fn fill_pattern(buf: *u8, len: i64)
    var i: i64 = 0
    while i < len
        buf[i] = ((i * 7 + 3) & 0xff) as u8
        i += 1

# info_len -> 0 when hkdf_expand returns Ok(64) and matches the hand-built
# RFC 5869 output, else a non-zero code.
fn check_expand_info_len(info_len: i64) -> i32
    var prk: [32]u8
    fill_pattern(@prk[0], 32)
    var info: [4096]u8
    fill_pattern(@info[0], info_len)

    # Guard bytes either side of okm catch any stray write.
    var okm: [96]u8
    fill_byte(@okm[0], 0xa5, 96)
    if ok_len(hkdf_expand(@prk[0], @info[0], info_len as u64, @okm[16], 64)) != 64
        return 1

    var expected: [64]u8
    expand_two_blocks_by_hand(@prk[0], @info[0], info_len, @expected[0])
    if mem_eq(@okm[16], @expected[0], 64) != 1
        return 2
    var i: i32 = 0
    while i < 16
        if okm[i] != 0xa5 || okm[80 + i] != 0xa5
            return 3
        i += 1
    0

[[test]]
fn test_hkdf_expand_info_at_old_buffer_limit() -> i32
    # 32 (T) + 223 + 1 (counter) = 256: the largest the old buffer held.
    check_expand_info_len(223)

[[test]]
fn test_hkdf_expand_info_just_over_old_buffer() -> i32
    # 32 + 224 + 1 = 257: one byte past the old 256-byte buffer.
    check_expand_info_len(224)

[[test]]
fn test_hkdf_expand_long_info() -> i32
    # RFC 5869 does not bound info; a long one must still derive correctly.
    check_expand_info_len(BIG_INFO)

[[test]]
fn test_hkdf_expand_max_output() -> i32
    # L = 255 * 32 = 8160 is the most HKDF-SHA256 can produce.
    var prk: [32]u8
    fill_pattern(@prk[0], 32)
    var okm: [8160]u8
    if ok_len(hkdf_expand(@prk[0], null, 0, @okm[0], 8160)) != 8160
        return 1
    # The last block is T(255) = HMAC(PRK, T(254) || 0xff): counter 255,
    # not a wrapped 0x00.
    var t254: [33]u8
    mem_copy(@t254[0], @okm[8160 - 64], 32)
    t254[32] = 255
    var t255: [32]u8
    hmac_sha256(@prk[0], 32, @t254[0], 33, @t255[0])
    if mem_eq(@okm[8160 - 32], @t255[0], 32) != 1
        return 2
    0

[[test]]
fn test_hkdf_expand_output_just_over_max_refused() -> i32
    # 8161 would need T(256): the one-byte counter would wrap. Refuse, and
    # write nothing.
    var prk: [32]u8
    fill_pattern(@prk[0], 32)
    var okm: [8161]u8
    fill_byte(@okm[0], 0xa5, 8161)
    if not is_invalid_length(hkdf_expand(@prk[0], null, 0, @okm[0], 8161))
        return 1
    var i: i64 = 0
    while i < 8161
        if okm[i] != 0xa5
            return 2
        i += 1
    0

[[test]]
fn test_hkdf_expand_null_info_with_length_refused() -> i32
    # A non-zero info_len with no info is a caller bug: refuse, don't guess.
    var prk: [32]u8
    fill_pattern(@prk[0], 32)
    var okm: [32]u8
    fill_byte(@okm[0], 0xa5, 32)
    if not is_invalid_length(hkdf_expand(@prk[0], null, 5, @okm[0], 32))
        return 1
    if okm[0] != 0xa5
        return 2
    0

[[test]]
fn test_hkdf_sha256_propagates_refusal() -> i32
    var ikm: [16]u8
    fill_pattern(@ikm[0], 16)
    var okm: [8161]u8
    if not is_invalid_length(hkdf_sha256(null, 0, @ikm[0], 16, null, 0, @okm[0], 8161))
        return 1
    if ok_len(hkdf_sha256(null, 0, @ikm[0], 16, null, 0, @okm[0], 42)) != 42
        return 2
    0
