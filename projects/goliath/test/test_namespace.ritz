# Tests for Namespace

import ritzlib.strview { StrView, strview_empty }
import ritzlib.span { Span, span_from_strview }
import goliath.blob_id { BlobId, blob_id_eq, blob_id_is_zero }
import goliath.blob_store { MemoryBlobStore, memory_store_free, memory_store_count, memory_store_refs }
import goliath.hosted { memory_store_new }
import goliath.namespace { Namespace, namespace_new, namespace_root, namespace_exists, namespace_read, namespace_write, namespace_mkdir, namespace_list, namespace_file_size, namespace_fork, namespace_adopt, namespace_drop }
import goliath.dir_entry { NsEntry, dir_entry_is_file, dir_entry_is_dir }
import goliath.error { ErrorCode }

# Test: New namespace has non-zero root
[[test]]
fn test_namespace_new_has_root() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let root: BlobId = namespace_root(@ns)
    if blob_id_is_zero(@root)
        memory_store_free(@store)
        return 1

    memory_store_free(@store)
    0

# Test: Root path exists
[[test]]
fn test_namespace_root_exists() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let path: StrView = "/"
    if not namespace_exists(@ns, path)
        memory_store_free(@store)
        return 1

    memory_store_free(@store)
    0

# Test: Non-existent path doesn't exist
[[test]]
fn test_namespace_nonexistent() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let path: StrView = "/doesnotexist"
    if namespace_exists(@ns, path)
        memory_store_free(@store)
        return 1

    memory_store_free(@store)
    0

# Test: Create and read a file
[[test]]
fn test_namespace_write_read() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    # Write a file
    let path: StrView = "/hello.txt"
    var content: [13]u8
    content[0] = 72   # H
    content[1] = 101  # e
    content[2] = 108  # l
    content[3] = 108  # l
    content[4] = 111  # o
    content[5] = 44   # ,
    content[6] = 32   # (space)
    content[7] = 119  # w
    content[8] = 111  # o
    content[9] = 114  # r
    content[10] = 108 # l
    content[11] = 100 # d
    content[12] = 33  # !

    let data: Span<u8> = @content
    let result: ErrorCode = namespace_write(@ns, path, @data)
    if result != ErrorCode.Ok
        memory_store_free(@store)
        return 1

    # File should exist
    if not namespace_exists(@ns, path)
        memory_store_free(@store)
        return 2

    # Read it back
    let read_span: Span<u8> = namespace_read(@ns, path)
    if read_span.ptr == 0 as *u8
        memory_store_free(@store)
        return 3

    # Verify content
    var i: i64 = 0
    while i < 13
        if *(read_span.ptr + i) != content[i]
            memory_store_free(@store)
            return 4
        i = i + 1

    memory_store_free(@store)
    0

# Test: Create directory
[[test]]
fn test_namespace_mkdir() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let path: StrView = "/mydir"
    let result: ErrorCode = namespace_mkdir(@ns, path)
    if result != ErrorCode.Ok
        memory_store_free(@store)
        return 1

    # Directory should exist
    if not namespace_exists(@ns, path)
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: mkdir fails if already exists
[[test]]
fn test_namespace_mkdir_exists() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let path: StrView = "/dup"

    # Create first time
    let r1: ErrorCode = namespace_mkdir(@ns, path)
    if r1 != ErrorCode.Ok
        memory_store_free(@store)
        return 1

    # Create second time should fail
    let r2: ErrorCode = namespace_mkdir(@ns, path)
    if r2 != ErrorCode.AlreadyExists
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: List root directory
[[test]]
fn test_namespace_list_root() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    # Empty root
    var entries: [10]NsEntry
    let root_path: StrView = "/"
    let count: i32 = namespace_list(@ns, root_path, @entries[0], 10)
    if count != 0
        memory_store_free(@store)
        return 1

    # Create some entries
    let dir_path: StrView = "/dir1"
    namespace_mkdir(@ns, dir_path)

    let file_path: StrView = "/file1"
    let file_data: Span<u8> = span_from_strview("data")
    namespace_write(@ns, file_path, @file_data)

    # List again
    let count2: i32 = namespace_list(@ns, root_path, @entries[0], 10)
    if count2 != 2
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: File size is tracked
[[test]]
fn test_namespace_file_size() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let path: StrView = "/sized.txt"
    var content: [7]u8
    content[0] = 99  # c
    content[1] = 111 # o
    content[2] = 110 # n
    content[3] = 116 # t
    content[4] = 101 # e
    content[5] = 110 # n
    content[6] = 116 # t

    let data: Span<u8> = @content
    namespace_write(@ns, path, @data)

    let size: u64 = namespace_file_size(@ns, path)
    if size != 7
        memory_store_free(@store)
        return 1

    memory_store_free(@store)
    0

# Test: Invalid paths are rejected
[[test]]
fn test_namespace_invalid_path() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    # Relative path
    let rel_path: StrView = "relative"
    let rel_data: Span<u8> = span_from_strview("x")
    let r1: ErrorCode = namespace_write(@ns, rel_path, @rel_data)
    if r1 != ErrorCode.InvalidPath
        memory_store_free(@store)
        return 1

    # Empty path
    let empty: StrView = strview_empty()
    let r2: ErrorCode = namespace_mkdir(@ns, empty)
    if r2 != ErrorCode.InvalidPath
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: Write to root is rejected
[[test]]
fn test_namespace_write_root_rejected() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)

    let root: StrView = "/"
    let data: Span<u8> = span_from_strview("x")
    let result: ErrorCode = namespace_write(@ns, root, @data)
    if result != ErrorCode.NotAFile
        memory_store_free(@store)
        return 1

    memory_store_free(@store)
    0

# ============================================================================
# Forks: a candidate tree beside the live one (AGAST #4835)
# ============================================================================

fn put_text(ns: *Namespace, path: StrView, text: StrView) -> ErrorCode
    let data: Span<u8> = span_from_strview(text)
    namespace_write(ns, path, @data)

fn reads(ns: *Namespace, path: StrView, want: StrView) -> bool
    let got: Span<u8> = namespace_read(ns, path)
    got.ptr != null and got.as_strview().eq(want)

# A fork changed and dropped leaves the live tree, its root's references and
# the store's blobs as they were.
[[test]]
fn test_namespace_fork_drop_leaves_live_tree() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/d") == ErrorCode.Ok
    assert put_text(@ns, "/d/f", "old") == ErrorCode.Ok
    let root: BlobId = namespace_root(@ns)
    let blobs: i32 = memory_store_count(@store)
    let refs: i32 = memory_store_refs(@store, @root)

    var cand: Namespace = namespace_fork(@ns)
    assert memory_store_refs(@store, @root) == refs + 1
    assert put_text(@cand, "/d/f", "new") == ErrorCode.Ok
    assert put_text(@cand, "/g", "added") == ErrorCode.Ok
    assert reads(@cand, "/d/f", "new")
    # The live tree doesn't see the fork's changes
    assert reads(@ns, "/d/f", "old")
    assert not namespace_exists(@ns, "/g")

    namespace_drop(@cand)
    assert blob_id_is_zero(@cand.root)
    assert reads(@ns, "/d/f", "old")
    assert memory_store_refs(@store, @root) == refs
    assert memory_store_count(@store) == blobs
    memory_store_free(@store)
    0

# A fork changed and adopted is the tree a direct change gives: same root
# blob, and the old tree's blobs are freed.
[[test]]
fn test_namespace_fork_adopt_matches_direct_change() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/d") == ErrorCode.Ok
    assert put_text(@ns, "/d/f", "old") == ErrorCode.Ok

    var direct_store: MemoryBlobStore = memory_store_new()
    var direct: Namespace = namespace_new(@direct_store)
    assert namespace_mkdir(@direct, "/d") == ErrorCode.Ok
    assert put_text(@direct, "/d/f", "old") == ErrorCode.Ok
    assert put_text(@direct, "/d/f", "new") == ErrorCode.Ok

    var cand: Namespace = namespace_fork(@ns)
    assert put_text(@cand, "/d/f", "new") == ErrorCode.Ok
    namespace_adopt(@ns, @cand)
    assert blob_id_is_zero(@cand.root)
    assert reads(@ns, "/d/f", "new")
    let a: BlobId = namespace_root(@ns)
    let b: BlobId = namespace_root(@direct)
    assert blob_id_eq(@a, @b)
    assert memory_store_count(@store) == memory_store_count(@direct_store)
    assert memory_store_refs(@store, @a) == 1
    memory_store_free(@direct_store)
    memory_store_free(@store)
    0

# A change to the live tree while a fork exists leaves the fork as it was.
[[test]]
fn test_namespace_live_change_leaves_fork_intact() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert put_text(@ns, "/f", "one") == ErrorCode.Ok
    var cand: Namespace = namespace_fork(@ns)
    assert put_text(@ns, "/f", "two") == ErrorCode.Ok
    assert put_text(@ns, "/h", "live") == ErrorCode.Ok
    assert reads(@cand, "/f", "one")
    assert not namespace_exists(@cand, "/h")
    assert reads(@ns, "/f", "two")
    namespace_drop(@cand)
    assert reads(@ns, "/f", "two")
    assert reads(@ns, "/h", "live")
    memory_store_free(@store)
    0
