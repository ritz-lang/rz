# Tests for MemoryBlobStore

import goliath.blob_id { BlobId, blob_id_eq, blob_id_is_zero, blob_id_zero, blob_id_compute }
import goliath.blob_store { MemoryBlobStore, memory_store_put, memory_store_get, memory_store_get_size, memory_store_exists, memory_store_delete, memory_store_count, memory_store_total_size, memory_store_free, memory_store_refs, memory_store_find_probes }
import goliath.hosted { memory_store_new }

# Test: New store is empty
[[test]]
fn test_store_new_empty() -> i32
    var store: MemoryBlobStore = memory_store_new()

    if memory_store_count(@store) != 0
        memory_store_free(@store)
        return 1

    if memory_store_total_size(@store) != 0
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: Put stores data and returns ID
[[test]]
fn test_store_put_returns_id() -> i32
    var store: MemoryBlobStore = memory_store_new()

    var data: [5]u8
    data[0] = 72   # 'H'
    data[1] = 101  # 'e'
    data[2] = 108  # 'l'
    data[3] = 108  # 'l'
    data[4] = 111  # 'o'

    let id: BlobId = memory_store_put(@store, @data[0], 5)

    # Should not be zero (unless allocation failed)
    # Note: Currently returns zero because SHA-256 not implemented
    # This will pass once SHA-256 is added

    memory_store_free(@store)
    0

# Test: Get retrieves stored data
[[test]]
fn test_store_get_retrieves() -> i32
    var store: MemoryBlobStore = memory_store_new()

    var data: [5]u8
    data[0] = 72
    data[1] = 101
    data[2] = 108
    data[3] = 108
    data[4] = 111

    var id: BlobId = memory_store_put(@store, @data[0], 5)

    # Get should return the data
    let retrieved: *u8 = memory_store_get(@store, @id)

    if retrieved == 0 as *u8
        # If ID was zero (no SHA-256), this is expected
        if blob_id_is_zero(@id)
            memory_store_free(@store)
            return 0  # Skip test until SHA-256 implemented

        memory_store_free(@store)
        return 1

    # Verify data matches
    var i: i32 = 0
    while i < 5
        if *(retrieved + i) != data[i]
            memory_store_free(@store)
            return 2
        i = i + 1

    memory_store_free(@store)
    0

# Test: Exists returns correct status
[[test]]
fn test_store_exists() -> i32
    var store: MemoryBlobStore = memory_store_new()

    var data: [3]u8
    data[0] = 65  # 'A'
    data[1] = 66  # 'B'
    data[2] = 67  # 'C'

    var id: BlobId = memory_store_put(@store, @data[0], 3)

    # Skip if SHA-256 not implemented
    if blob_id_is_zero(@id)
        memory_store_free(@store)
        return 0

    if not memory_store_exists(@store, @id)
        memory_store_free(@store)
        return 1

    # Non-existent blob
    let fake: BlobId = blob_id_zero()
    if memory_store_exists(@store, @fake)
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: Delete removes blob
[[test]]
fn test_store_delete() -> i32
    var store: MemoryBlobStore = memory_store_new()

    var data: [4]u8
    data[0] = 84   # 'T'
    data[1] = 101  # 'e'
    data[2] = 115  # 's'
    data[3] = 116  # 't'

    var id: BlobId = memory_store_put(@store, @data[0], 4)

    # Skip if SHA-256 not implemented
    if blob_id_is_zero(@id)
        memory_store_free(@store)
        return 0

    # Should exist before delete
    if not memory_store_exists(@store, @id)
        memory_store_free(@store)
        return 1

    # Delete
    if not memory_store_delete(@store, @id)
        memory_store_free(@store)
        return 2

    # Should not exist after delete
    if memory_store_exists(@store, @id)
        memory_store_free(@store)
        return 3

    memory_store_free(@store)
    0

# Test: Count tracks number of blobs
[[test]]
fn test_store_count() -> i32
    var store: MemoryBlobStore = memory_store_new()

    if memory_store_count(@store) != 0
        memory_store_free(@store)
        return 1

    # Add empty data (which has a known hash)
    var id: BlobId = memory_store_put(@store, 0 as *u8, 0)

    # Empty data should work (returns empty hash)
    if memory_store_count(@store) != 1
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: Deduplication - same content same ID
[[test]]
fn test_store_dedup() -> i32
    var store: MemoryBlobStore = memory_store_new()

    var data: [3]u8
    data[0] = 88  # 'X'
    data[1] = 89  # 'Y'
    data[2] = 90  # 'Z'

    var id1: BlobId = memory_store_put(@store, @data[0], 3)
    var id2: BlobId = memory_store_put(@store, @data[0], 3)

    # Skip if SHA-256 not implemented
    if blob_id_is_zero(@id1)
        memory_store_free(@store)
        return 0

    # Same content = same ID
    if not blob_id_eq(@id1, @id2)
        memory_store_free(@store)
        return 1

    # Count should be 1 (not 2)
    if memory_store_count(@store) != 1
        memory_store_free(@store)
        return 2

    memory_store_free(@store)
    0

# Test: the store grows past its initial 64 slots instead of refusing puts
# (goliath's CLI keeps every blob of a store file in one MemoryBlobStore).
[[test]]
fn test_store_grows_past_initial_capacity() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var data: [4]u8
    var n: i32 = 0
    while n < 200
        data[0] = (n & 255) as u8
        data[1] = 7
        data[2] = 9
        data[3] = 11
        var id: BlobId = memory_store_put(@store, @data[0], 4)
        if blob_id_is_zero(@id)
            memory_store_free(@store)
            return 1
        n = n + 1
    if memory_store_count(@store) != 200
        memory_store_free(@store)
        return 2

    # Every blob, early and late, is still there with its bytes
    n = 0
    while n < 200
        data[0] = (n & 255) as u8
        var want: BlobId = blob_id_compute(@data[0], 4)
        let got: *u8 = memory_store_get(@store, @want)
        if got == 0 as *u8
            memory_store_free(@store)
            return 3
        if *got != (n & 255) as u8 or *(got + 3) != 11
            memory_store_free(@store)
            return 4
        n = n + 1
    memory_store_free(@store)
    0

# The ticket's RED case (AGAST #4228): store_find used to scan every slot,
# so a lookup's cost grew with the table's capacity. 200 blobs force the
# capacity to 256; a blob stored last sat near the end of a linear scan
# (~199 slots). The hash index finds it in a few probes.
[[test]]
fn test_store_lookup_is_indexed() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var data: [4]u8
    var last: BlobId = blob_id_zero()
    var n: i32 = 0
    while n < 200
        data[0] = (n & 255) as u8
        data[1] = 33
        data[2] = 44
        data[3] = 55
        last = memory_store_put(@store, @data[0], 4)
        if blob_id_is_zero(@last)
            memory_store_free(@store)
            return 1
        n = n + 1
    if memory_store_find_probes(@store, @last) > 16
        memory_store_free(@store)
        return 2
    # A miss stops at the first empty cell too, without scanning the table
    let fake: BlobId = blob_id_zero()
    if memory_store_find_probes(@store, @fake) > 16
        memory_store_free(@store)
        return 3
    memory_store_free(@store)
    0

# Every blob stays findable after deletions leave tombstones, and a freed
# slot reused by new content does not shadow the old id (or vice versa).
[[test]]
fn test_store_lookup_after_churn() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var data: [4]u8
    var ids: [300]BlobId
    var n: i32 = 0
    while n < 300
        data[0] = (n & 255) as u8
        data[1] = (n >> 8) as u8
        data[2] = 77
        data[3] = 88
        ids[n] = memory_store_put(@store, @data[0], 4)
        if blob_id_is_zero(@ids[n])
            memory_store_free(@store)
            return 1
        n = n + 1
    # Delete every third blob, leaving tombstones all over the index
    n = 0
    while n < 300
        if n % 3 == 0 and not memory_store_delete(@store, @ids[n])
            memory_store_free(@store)
            return 2
        n = n + 1
    # Survivors are found, the deleted ones are gone
    n = 0
    while n < 300
        let found: bool = memory_store_exists(@store, @ids[n])
        if n % 3 == 0
            if found
                memory_store_free(@store)
                return 3
        else if not found
            memory_store_free(@store)
            return 4
        n = n + 1
    # Re-store deleted content: the same id comes back, with one reference
    n = 0
    while n < 300
        if n % 3 == 0
            data[0] = (n & 255) as u8
            data[1] = (n >> 8) as u8
            data[2] = 77
            data[3] = 88
            let again: BlobId = memory_store_put(@store, @data[0], 4)
            if not blob_id_eq(@again, @ids[n])
                memory_store_free(@store)
                return 5
            if memory_store_refs(@store, @ids[n]) != 1
                memory_store_free(@store)
                return 6
        n = n + 1
    memory_store_free(@store)
    0
