# Namespace below the root, and blob reclamation (AGAST #1881).
#
# Before #1881, namespace_write("/a/b") stored a new /a blob but repointed
# only the root, and only when the parent *was* the root: the write returned
# ErrorCode.Ok and was lost. Nothing was ever freed either: namespace_delete was a
# TODO and every overwrite leaked the superseded file and directory blobs.

import ritzlib.strview { StrView }
import ritzlib.span { Span, span_from_ptr }
import goliath.blob_id { BlobId }
import goliath.blob_store { MemoryBlobStore, memory_store_free, memory_store_count, memory_store_get }
import goliath.hosted { memory_store_new }
import goliath.namespace { Namespace, namespace_new, namespace_read, namespace_write, namespace_mkdir, namespace_delete, namespace_exists, namespace_resolve, namespace_hold, namespace_unhold }
import goliath.error { ErrorCode }

# 1 if `path` reads back exactly the `len` bytes at `want`.
fn reads_back(ns: *Namespace, path: StrView, want: *u8, len: i64) -> bool
    let got: Span<u8> = namespace_read(ns, path)
    if got.ptr == null or got.len != len
        return false
    var i: i64 = 0
    while i < len
        if *(got.ptr + i) != *(want + i)
            return false
        i = i + 1
    true

fn write_cstr(ns: *Namespace, path: StrView, text: *u8, len: i64) -> ErrorCode
    let data: Span<u8> = span_from_ptr<u8>(text, len)
    namespace_write(ns, path, @data)

# The ticket's RED case: a write below the root is readable afterwards.
[[test]]
fn test_nested_write_reads_back() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/a") == ErrorCode.Ok
    assert write_cstr(@ns, "/a/b", c"nested", 6) == ErrorCode.Ok
    assert reads_back(@ns, "/a/b", c"nested", 6)
    # Two levels down, and a sibling written earlier survives the rewrite
    assert namespace_mkdir(@ns, "/a/c") == ErrorCode.Ok
    assert write_cstr(@ns, "/a/c/d", c"deep", 4) == ErrorCode.Ok
    assert write_cstr(@ns, "/a/b", c"again", 5) == ErrorCode.Ok
    assert reads_back(@ns, "/a/c/d", c"deep", 4)
    assert reads_back(@ns, "/a/b", c"again", 5)
    # A write under a missing directory, or over a directory, is refused
    assert write_cstr(@ns, "/nope/x", c"x", 1) == ErrorCode.NotFound
    assert write_cstr(@ns, "/a/c", c"x", 1) == ErrorCode.NotAFile
    memory_store_free(@store)
    0

# Deleting a file frees its blob and the directory blobs it superseded: the
# store is back to what an empty namespace holds.
[[test]]
fn test_delete_frees_blobs() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    let empty: i32 = memory_store_count(@store)
    assert namespace_mkdir(@ns, "/d") == ErrorCode.Ok
    assert write_cstr(@ns, "/d/f", c"to be deleted", 13) == ErrorCode.Ok
    assert memory_store_count(@store) > empty

    assert namespace_delete(@ns, "/d") == ErrorCode.DirectoryNotEmpty
    assert namespace_delete(@ns, "/d/f") == ErrorCode.Ok
    assert not namespace_exists(@ns, "/d/f")
    assert namespace_delete(@ns, "/d/f") == ErrorCode.NotFound
    assert namespace_delete(@ns, "/d") == ErrorCode.Ok
    assert not namespace_exists(@ns, "/d")
    assert memory_store_count(@store) == empty
    memory_store_free(@store)
    0

# Content is shared (deduplicated): deleting one of two identical files
# leaves the other readable.
[[test]]
fn test_delete_keeps_shared_content() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert write_cstr(@ns, "/one", c"same", 4) == ErrorCode.Ok
    assert write_cstr(@ns, "/two", c"same", 4) == ErrorCode.Ok
    assert namespace_delete(@ns, "/one") == ErrorCode.Ok
    assert reads_back(@ns, "/two", c"same", 4)
    memory_store_free(@store)
    0

# Rewriting a nested file many times doesn't grow the store: each superseded
# file and directory blob is freed (it used to fill after ~30 root writes).
[[test]]
fn test_overwrite_reclaims_superseded_blobs() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/log") == ErrorCode.Ok
    var buf: [8]u8
    var k: i32 = 0
    while k < 300
        buf[0] = (k & 255) as u8
        buf[1] = (k >> 8) as u8
        assert write_cstr(@ns, "/log/cur", @buf[0], 2) == ErrorCode.Ok
        k = k + 1
    # root, /log and /log/cur
    assert memory_store_count(@store) == 3
    assert reads_back(@ns, "/log/cur", @buf[0], 2)
    memory_store_free(@store)
    0

# A held blob outlives the tree that named it (the kernel holds each open
# file's blob, so a rewrite or delete can't free it under a reader), and is
# freed, a directory with the children only it still names, on unhold.
[[test]]
fn test_hold_outlives_overwrite_and_delete() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    let empty: i32 = memory_store_count(@store)
    assert write_cstr(@ns, "/f", c"old", 3) == ErrorCode.Ok
    var file: BlobId = namespace_resolve(@ns, "/f")
    assert namespace_hold(@ns, @file)
    assert write_cstr(@ns, "/f", c"new", 3) == ErrorCode.Ok
    let old: *u8 = memory_store_get(@store, @file)
    assert old != null
    assert *old == 111 and *(old + 2) == 100
    namespace_unhold(@ns, @file)
    assert memory_store_get(@store, @file) == null

    assert namespace_mkdir(@ns, "/d") == ErrorCode.Ok
    assert write_cstr(@ns, "/d/x", c"child", 5) == ErrorCode.Ok
    var dir: BlobId = namespace_resolve(@ns, "/d")
    assert namespace_hold(@ns, @dir)
    assert namespace_delete(@ns, "/d/x") == ErrorCode.Ok
    assert namespace_delete(@ns, "/d") == ErrorCode.Ok
    assert namespace_delete(@ns, "/f") == ErrorCode.Ok
    # the held directory still names "child"
    assert memory_store_count(@store) == empty + 2
    namespace_unhold(@ns, @dir)
    assert memory_store_count(@store) == empty
    var none: BlobId = namespace_resolve(@ns, "/missing")
    assert not namespace_hold(@ns, @none)
    memory_store_free(@store)
    0
