# Tests for BlobId
#
# Tests content addressing fundamentals.

import ritzlib.strview { StrView }
import ritzlib.span { Span, Bytes }
import goliath.blob_id { BlobId, BLOB_ID_SIZE, BLOB_ID_HEX_LEN, blob_id_zero, blob_id_empty, blob_id_from_hash, blob_id_eq, blob_id_is_zero, blob_id_compute, blob_id_bytes, blob_id_copy, blob_id_to_hex, blob_id_from_hex }

# Test: Zero BlobId is all zeros
[[test]]
fn test_blob_id_zero_is_zeros() -> i32
    var zero: BlobId = blob_id_zero()

    var i: i32 = 0
    while i < 32
        if zero.hash[i] != 0
            return 1
        i = i + 1

    0

# Test: Zero BlobId is detected by is_zero
[[test]]
fn test_blob_id_is_zero() -> i32
    let zero: BlobId = blob_id_zero()
    if not blob_id_is_zero(@zero)
        return 1

    let empty: BlobId = blob_id_empty()
    if blob_id_is_zero(@empty)
        return 2  # Empty is NOT zero (it has a real hash)

    0

# Test: Empty content has known hash
[[test]]
fn test_blob_id_empty_known_hash() -> i32
    var empty: BlobId = blob_id_empty()

    # SHA-256 of empty string starts with e3b0c442...
    if empty.hash[0] != 0xe3
        return 1
    if empty.hash[1] != 0xb0
        return 2
    if empty.hash[2] != 0xc4
        return 3
    if empty.hash[3] != 0x42
        return 4

    0

# Test: Two zero BlobIds are equal
[[test]]
fn test_blob_id_eq_zero() -> i32
    var a: BlobId = blob_id_zero()
    var b: BlobId = blob_id_zero()

    if not blob_id_eq(@a, @b)
        return 1

    0

# Test: Two empty BlobIds are equal
[[test]]
fn test_blob_id_eq_empty() -> i32
    var a: BlobId = blob_id_empty()
    var b: BlobId = blob_id_empty()

    if not blob_id_eq(@a, @b)
        return 1

    0

# Test: Zero and empty are not equal
[[test]]
fn test_blob_id_zero_not_empty() -> i32
    var zero: BlobId = blob_id_zero()
    var empty: BlobId = blob_id_empty()

    if blob_id_eq(@zero, @empty)
        return 1

    0

# Test: Copy produces equal BlobId
[[test]]
fn test_blob_id_copy() -> i32
    let original: BlobId = blob_id_empty()
    let copy: BlobId = blob_id_copy(@original)

    if not blob_id_eq(@original, @copy)
        return 1

    0

# Test: from_hash correctly copies bytes
[[test]]
fn test_blob_id_from_hash() -> i32
    var hash: [32]u8
    var i: i32 = 0
    while i < 32
        hash[i] = i as u8
        i = i + 1

    var id: BlobId = blob_id_from_hash(@hash[0])

    i = 0
    while i < 32
        if id.hash[i] != i as u8
            return 1
        i = i + 1

    0

# Test: Compute returns empty hash for empty input
[[test]]
fn test_blob_id_compute_empty() -> i32
    var id: BlobId = blob_id_compute(0 as *u8, 0)
    var expected: BlobId = blob_id_empty()

    if not blob_id_eq(@id, @expected)
        return 1

    0

# Test: to_hex spells the 32 bytes as 64 lowercase hex digits plus a NUL
# (the empty blob's id is sha256("") = e3b0c442...b855).
[[test]]
fn test_blob_id_to_hex_empty() -> i32
    var id: BlobId = blob_id_empty()
    var hex: [65]u8
    blob_id_to_hex(@id, @hex[0])
    let want: StrView = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    var i: i32 = 0
    while i < 64
        if hex[i] != *(want.ptr + i)
            return 1
        i = i + 1
    if hex[64] != 0
        return 2
    0

# Test: from_hex(to_hex(id)) == id, and upper-case digits parse too
[[test]]
fn test_blob_id_hex_roundtrip() -> i32
    var data: [3]u8
    data[0] = 1
    data[1] = 0xab
    data[2] = 0xff
    var id: BlobId = blob_id_compute(@data[0], 3)
    var hex: [65]u8
    blob_id_to_hex(@id, @hex[0])

    let buf: [u8] = @hex
    let digits: [u8] = buf[0..BLOB_ID_HEX_LEN]
    var back: BlobId = blob_id_zero()
    if not blob_id_from_hex(digits.as_strview(), @back)
        return 1
    if not blob_id_eq(@id, @back)
        return 2

    let upper: StrView = "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
    var up: BlobId = blob_id_zero()
    if not blob_id_from_hex(upper, @up)
        return 3
    var empty: BlobId = blob_id_empty()
    if not blob_id_eq(@up, @empty)
        return 4
    0

# Test: from_hex rejects wrong lengths and non-hex digits
[[test]]
fn test_blob_id_from_hex_rejects() -> i32
    var out: BlobId = blob_id_zero()
    # 63 digits
    if blob_id_from_hex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85", @out)
        return 1
    # 65 digits
    if blob_id_from_hex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b8555", @out)
        return 2
    # a 'g' in the last place
    if blob_id_from_hex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85g", @out)
        return 3
    # empty
    if blob_id_from_hex("", @out)
        return 4
    0
