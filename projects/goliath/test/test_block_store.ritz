# A goliath image on a block device, and goliath on an injected allocator
# (AGAST #1881). The device here is a RAM disk behind the same BlockDevice
# interface the kernel's virtio-blk driver fills in.

import ritzlib.memory { Allocator }
import ritzlib.strview { StrView }
import ritzlib.span { Span, Bytes, span_from_strview }
import ritzlib.gvec { Vec, vec_zeroed }
import ritzlib.string { String, string_from_bytes }
import goliath.alloc { allocator_alloc, allocator_free }
import goliath.blob_id { BlobId }
import goliath.blob_store { MemoryBlobStore, memory_store_new_in, memory_store_free, memory_store_count, memory_store_get_span }
import goliath.hosted { memory_store_new, hosted_allocator }
import ritzlib.result
import goliath.namespace { Namespace, NsStat, namespace_new, namespace_read, namespace_write, namespace_write_mode, namespace_mkdir, namespace_delete, namespace_exists, namespace_resolve, namespace_stat }
import goliath.block_store { BlockDevice, block_store_save, block_store_load, BLOCK_SECTOR_SIZE }
import goliath.error { ErrorCode }

# ---------------------------------------------------------------------------
# RAM disk
# ---------------------------------------------------------------------------

struct RamDisk
    data: Vec<u8>
    sectors: u64
    fail_io: bool
    # Power loss: sectors written so far, and how many may be written before
    # every write fails (-1: no limit). A write that runs into the limit
    # stores the sectors before it and fails; with `torn` the sector it fails
    # on is half written, as a write cut mid-sector would leave it.
    written: i64
    write_budget: i64
    torn: bool

fn ram_read(dev: *u8, lba: u64, count: u32, buf: *u8) -> i32
    let d: *RamDisk = dev as *RamDisk
    if (*d).fail_io or lba + count as u64 > (*d).sectors
        return -5
    let base: i64 = (lba * 512) as i64
    let disk: [u8] = d.data[base..base + count as i64 * 512]
    var i: i64 = 0
    while i < disk.len
        *(buf + i) = disk[i]
        i = i + 1
    0

fn ram_write(dev: *u8, lba: u64, count: u32, buf: *u8) -> i32
    let d: *RamDisk = dev as *RamDisk
    if (*d).fail_io or lba + count as u64 > (*d).sectors
        return -5
    let base: i64 = (lba * 512) as i64
    let disk: [u8] = d.data[base..base + count as i64 * 512]
    var s: i64 = 0
    while s < count as i64
        var bytes: i64 = 512
        if (*d).write_budget >= 0 and (*d).written >= (*d).write_budget
            if not (*d).torn
                return -5
            bytes = 256
        var i: i64 = s * 512
        while i < s * 512 + bytes
            disk[i] = *(buf + i)
            i = i + 1
        if bytes < 512
            return -5
        (*d).written = (*d).written + 1
        s = s + 1
    0

# A zeroed (blank) disk of `sectors` sectors
fn ram_new(sectors: u64) -> RamDisk
    RamDisk { data: vec_zeroed<u8>((sectors * 512) as i64), sectors: sectors, fail_io: false, written: 0, write_budget: -1, torn: false }

fn ram_device(d: *RamDisk) -> BlockDevice
    BlockDevice { dev: d as *u8, sectors: (*d).sectors, read: ram_read, write: ram_write }

fn ram_free(d: *RamDisk)
    (*d).data.deinit()

fn write_text(ns: *Namespace, path: StrView, text: StrView) -> ErrorCode
    let data: Span<u8> = span_from_strview(text)
    namespace_write(ns, path, @data)

# Whether `path` reads back exactly `want`.
fn reads_back(ns: *Namespace, path: StrView, want: StrView) -> bool
    let got: Span<u8> = namespace_read(ns, path)
    got.ptr != null and got.as_strview().eq(want)

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Save, "reboot" (a fresh store), load: the tree is all there, nested paths
# included, and a deleted file stays deleted.
[[test]]
fn test_block_store_survives_reboot() -> i32
    var disk: RamDisk = ram_new(256)
    var dev: BlockDevice = ram_device(@disk)

    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/etc") == ErrorCode.Ok
    assert write_text(@ns, "/etc/motd", "hello harland") == ErrorCode.Ok
    assert write_text(@ns, "/etc/gone", "bye") == ErrorCode.Ok
    assert namespace_delete(@ns, "/etc/gone") == ErrorCode.Ok
    assert write_text(@ns, "/top", "t") == ErrorCode.Ok
    let blobs: i32 = memory_store_count(@store)
    assert block_store_save(@dev, @ns) == ErrorCode.Ok
    memory_store_free(@store)

    var store2: MemoryBlobStore = memory_store_new()
    var ns2: Namespace
    assert block_store_load(@dev, @store2, @ns2) == ErrorCode.Ok
    assert reads_back(@ns2, "/etc/motd", "hello harland")
    assert reads_back(@ns2, "/top", "t")
    assert not namespace_exists(@ns2, "/etc/gone")
    assert memory_store_count(@store2) == blobs
    # The loaded tree is live: change it and round-trip again
    assert write_text(@ns2, "/etc/motd", "v2") == ErrorCode.Ok
    assert block_store_save(@dev, @ns2) == ErrorCode.Ok
    memory_store_free(@store2)

    var store3: MemoryBlobStore = memory_store_new()
    var ns3: Namespace
    assert block_store_load(@dev, @store3, @ns3) == ErrorCode.Ok
    assert reads_back(@ns3, "/etc/motd", "v2")
    memory_store_free(@store3)
    ram_free(@disk)
    0

# A file's modified time and mode are in the image (DiskDirEntry), so they
# survive a reboot: Harland's /var stat depends on it (AGAST #4832).
[[test]]
fn test_block_store_keeps_modified_and_mode() -> i32
    var disk: RamDisk = ram_new(256)
    var dev: BlockDevice = ram_device(@disk)
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    let data: Span<u8> = span_from_strview("kept")
    assert namespace_write_mode(@ns, "/f", @data, 384, 123456789) == ErrorCode.Ok
    assert block_store_save(@dev, @ns) == ErrorCode.Ok
    memory_store_free(@store)

    var store2: MemoryBlobStore = memory_store_new()
    var ns2: Namespace
    assert block_store_load(@dev, @store2, @ns2) == ErrorCode.Ok
    var st: NsStat = NsStat { is_dir: true, size: 0, modified: 0, mode: 0 }
    match namespace_stat(@ns2, "/f")
        Ok(s) => st = s
        Err(_) => return 1
    assert not st.is_dir
    assert st.size == 4
    assert st.modified == 123456789
    assert st.mode == 384
    memory_store_free(@store2)
    ram_free(@disk)
    0

# A blank device has no filesystem; a damaged one is refused, not half read;
# an image too big for the device is not written at all.
[[test]]
fn test_block_store_refuses_blank_damaged_and_full() -> i32
    var disk: RamDisk = ram_new(64)
    var dev: BlockDevice = ram_device(@disk)
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace
    assert block_store_load(@dev, @store, @ns) == ErrorCode.NotFound

    ns = namespace_new(@store)
    assert write_text(@ns, "/f", "payload") == ErrorCode.Ok
    assert block_store_save(@dev, @ns) == ErrorCode.Ok

    # One flipped byte in the image (the first save puts it at sector 2)
    disk.data.set(1124, disk.data.get(1124) ^ 1)
    var s2: MemoryBlobStore = memory_store_new()
    var ns2: Namespace
    assert block_store_load(@dev, @s2, @ns2) == ErrorCode.CorruptBlob
    memory_store_free(@s2)

    # I/O errors surface as such
    disk.fail_io = true
    assert block_store_save(@dev, @ns) == ErrorCode.IoError
    var s3: MemoryBlobStore = memory_store_new()
    assert block_store_load(@dev, @s3, @ns2) == ErrorCode.IoError
    memory_store_free(@s3)
    disk.fail_io = false

    # 8 KiB of content can't fit a 4-sector device; the device is untouched
    var tiny: RamDisk = ram_new(4)
    var tdev: BlockDevice = ram_device(@tiny)
    let big: Vec<u8> = vec_zeroed<u8>(8192)
    let big_span: Span<u8> = big[0..8192]
    assert namespace_write(@ns, "/big", @big_span) == ErrorCode.Ok
    assert block_store_save(@tdev, @ns) == ErrorCode.OutOfSpace
    assert tiny.data.get(0) == 0

    memory_store_free(@store)
    ram_free(@tiny)
    ram_free(@disk)
    0

# ---------------------------------------------------------------------------
# Crash safety (AGAST #4226)
# ---------------------------------------------------------------------------

# Generation `gen` of the test tree: /v holds "gen-<g>", and /pad holds
# `pad` bytes so generations differ in size (and so in where they land).
fn crash_tree(ns: *Namespace, g: u8, pad: i64) -> ErrorCode
    var v: [5]u8
    v[0] = 103
    v[1] = 101
    v[2] = 110
    v[3] = 45
    v[4] = 48 + g
    let vs: Span<u8> = @v
    var rc: ErrorCode = namespace_write(ns, "/v", @vs)
    if rc != ErrorCode.Ok
        return rc
    var p: Vec<u8> = vec_zeroed<u8>(pad + 1)
    var i: i64 = 0
    while i < pad + 1
        p.set(i, (i * 7 + g as i64) as u8)
        i = i + 1
    let padding: Span<u8> = p[0..pad]
    namespace_write(ns, "/pad", @padding)

# Which generation the disk loads: 0..9, or -1 if it doesn't load whole
fn loaded_gen(dev: *BlockDevice) -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace
    var g: i32 = -1
    if block_store_load(dev, @store, @ns) == ErrorCode.Ok
        let got: Span<u8> = namespace_read(@ns, "/v")
        if got.ptr != null and got.len == 5
            g = *(got.ptr + 4) as i32 - 48
    memory_store_free(@store)
    g

# Sector writes of one uncut save of `ns` to a fresh disk prepared by
# `crash_disk` (the save's length doesn't depend on what's on the disk
# beyond where it lands, which crash_disk fixes)
fn crash_disk(disk: *RamDisk, pad0: i64, pad1: i64) -> bool
    var dev: BlockDevice = ram_device(disk)
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    var ok: bool = crash_tree(@ns, 0, pad0) == ErrorCode.Ok and block_store_save(@dev, @ns) == ErrorCode.Ok
    ok = ok and crash_tree(@ns, 1, pad1) == ErrorCode.Ok and block_store_save(@dev, @ns) == ErrorCode.Ok
    memory_store_free(@store)
    ok and loaded_gen(@dev) == 1

# On a disk holding generations 0 then 1, cut a save of generation 2 after
# every number of sectors from none to all of them: the disk then loads
# generation 1 or 2 and never fails, it loads 2 only once the save has
# written everything, and it takes a further save (generation 3).
fn crash_every_sector(pad0: i64, pad1: i64, pad2: i64, torn: bool) -> bool
    # How many sectors an uncut save of generation 2 writes
    var probe: RamDisk = ram_new(256)
    if not crash_disk(@probe, pad0, pad1)
        return false
    var pdev: BlockDevice = ram_device(@probe)
    var s2: MemoryBlobStore = memory_store_new()
    var ns2: Namespace = namespace_new(@s2)
    if crash_tree(@ns2, 2, pad2) != ErrorCode.Ok
        return false
    probe.written = 0
    if block_store_save(@pdev, @ns2) != ErrorCode.Ok or loaded_gen(@pdev) != 2
        return false
    let total: i64 = probe.written
    ram_free(@probe)
    if total < 2
        return false

    var n: i64 = 0
    while n <= total
        var disk: RamDisk = ram_new(256)
        if not crash_disk(@disk, pad0, pad1)
            return false
        var dev: BlockDevice = ram_device(@disk)
        disk.written = 0
        disk.write_budget = n
        disk.torn = torn
        let rc: ErrorCode = block_store_save(@dev, @ns2)
        disk.write_budget = -1
        let g: i32 = loaded_gen(@dev)
        if n < total
            if rc != ErrorCode.IoError or g != 1
                return false
        else
            if rc != ErrorCode.Ok or g != 2
                return false
        # The store keeps working after the crash
        var s3: MemoryBlobStore = memory_store_new()
        var ns3: Namespace = namespace_new(@s3)
        if crash_tree(@ns3, 3, pad0 + 700) != ErrorCode.Ok or block_store_save(@dev, @ns3) != ErrorCode.Ok
            return false
        memory_store_free(@s3)
        if loaded_gen(@dev) != 3
            return false
        ram_free(@disk)
        n = n + 1
    memory_store_free(@s2)
    true

# A save cut short leaves the previous tree, never a corrupt image, whether
# the new image fits before the one in use or must go after it.
[[test]]
fn test_block_store_save_cut_at_every_sector() -> i32
    # Generation 2 smaller than 0: it reuses 0's space ahead of 1
    assert crash_every_sector(3000, 1500, 100, false)
    # Generation 2 bigger than 0: it goes after 1
    assert crash_every_sector(100, 1500, 3000, false)
    0

# The same, with the sector the power fails on half written
[[test]]
fn test_block_store_save_torn_at_every_sector() -> i32
    assert crash_every_sector(3000, 1500, 100, true)
    assert crash_every_sector(100, 1500, 3000, true)
    0

# Saves alternate between two slots, so the image only needs the space of
# itself plus the one in use; and a full device leaves the last save whole.
[[test]]
fn test_block_store_out_of_space_keeps_previous() -> i32
    var disk: RamDisk = ram_new(24)
    var dev: BlockDevice = ram_device(@disk)
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    var k: u8 = 0
    while k < 6
        assert crash_tree(@ns, k, 3000) == ErrorCode.Ok
        assert block_store_save(@dev, @ns) == ErrorCode.Ok
        assert loaded_gen(@dev) == k as i32
        k = k + 1
    # Too big to fit beside generation 5: refused, 5 still loads
    assert crash_tree(@ns, 6, 9000) == ErrorCode.Ok
    assert block_store_save(@dev, @ns) == ErrorCode.OutOfSpace
    assert loaded_gen(@dev) == 5
    memory_store_free(@store)
    ram_free(@disk)
    0

# ---------------------------------------------------------------------------
# Allocator injection
# ---------------------------------------------------------------------------

var g_outstanding: i64 = 0
var g_budget: i64 = 0
# Where the counted blocks really come from
var g_counted: Allocator

fn counting_alloc(ctx: *u8, len: i64) -> *u8
    if g_outstanding + len > g_budget
        return null
    g_outstanding = g_outstanding + len
    allocator_alloc(@g_counted, len)

fn counting_free(ctx: *u8, p: *u8, len: i64) -> i32
    g_outstanding = g_outstanding - len
    allocator_free(@g_counted, p, len)
    0

fn counting() -> Allocator
    g_counted = hosted_allocator()
    Allocator { ctx: null, alloc: counting_alloc, free: counting_free }

# Every byte goliath takes comes from its allocator and goes back to it:
# after a workload with overwrites and deletes, freeing the store returns
# the allocator to zero.
[[test]]
fn test_all_memory_goes_through_the_allocator() -> i32
    g_outstanding = 0
    g_budget = 1 << 30
    var store: MemoryBlobStore = memory_store_new_in(counting())
    assert g_outstanding > 0
    var ns: Namespace = namespace_new(@store)
    assert namespace_mkdir(@ns, "/a") == ErrorCode.Ok
    assert namespace_mkdir(@ns, "/a/b") == ErrorCode.Ok
    var k: i32 = 0
    var buf: [4]u8
    let all: Span<u8> = @buf
    let one: Span<u8> = all[0..1]
    while k < 100
        one[0] = k as u8
        assert namespace_write(@ns, "/a/b/f", @one) == ErrorCode.Ok
        assert namespace_write(@ns, "/a/g", @one) == ErrorCode.Ok
        k = k + 1
    assert namespace_delete(@ns, "/a/g") == ErrorCode.Ok
    memory_store_free(@store)
    assert g_outstanding == 0
    0

# Out of memory is an error, not a crash or a lost write
[[test]]
fn test_out_of_memory_is_reported() -> i32
    g_outstanding = 0
    g_budget = 1 << 30
    var store: MemoryBlobStore = memory_store_new_in(counting())
    var ns: Namespace = namespace_new(@store)
    assert write_text(@ns, "/kept", "kept") == ErrorCode.Ok
    g_budget = g_outstanding
    assert write_text(@ns, "/new", "new") == ErrorCode.OutOfSpace
    assert not namespace_exists(@ns, "/new")
    assert reads_back(@ns, "/kept", "kept")
    g_budget = 1 << 30
    memory_store_free(@store)
    assert g_outstanding == 0
    0

# A file whose bytes are exactly a directory blob is the same blob. Deleting
# the directory must not free what the file still names, and deleting both
# frees everything.
[[test]]
fn test_file_equal_to_a_directory_blob() -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace = namespace_new(@store)
    let empty: i32 = memory_store_count(@store)
    assert namespace_mkdir(@ns, "/d") == ErrorCode.Ok
    assert write_text(@ns, "/d/f", "inner") == ErrorCode.Ok
    var dir_id: BlobId = namespace_resolve(@ns, "/d")
    let copy: String = string_from_bytes(memory_store_get_span(@store, @dir_id))
    assert copy.len() > 0
    assert write_text(@ns, "/copy", copy.as_view()) == ErrorCode.Ok
    assert namespace_delete(@ns, "/d/f") == ErrorCode.Ok
    assert namespace_delete(@ns, "/d") == ErrorCode.Ok
    assert reads_back(@ns, "/copy", copy.as_view())
    assert namespace_delete(@ns, "/copy") == ErrorCode.Ok
    assert memory_store_count(@store) == empty

    # Bytes that parse as a directory but were never stored as one hold no
    # references: dropping such a file mustn't release what they name.
    assert write_text(@ns, "/x", "x content") == ErrorCode.Ok
    var root_id: BlobId = namespace_resolve(@ns, "/")
    let old_root: String = string_from_bytes(memory_store_get_span(@store, @root_id))
    # Replace the root (freeing that blob), then store its bytes as a file
    assert write_text(@ns, "/y", "y") == ErrorCode.Ok
    assert write_text(@ns, "/fake", old_root.as_view()) == ErrorCode.Ok
    assert namespace_delete(@ns, "/fake") == ErrorCode.Ok
    assert reads_back(@ns, "/x", "x content")
    memory_store_free(@store)
    0
