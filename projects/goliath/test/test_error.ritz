# Tests for goliath's typed errors (AGAST #4228).
#
# ErrorCode used to be `type ErrorCode = i32` with ERR_* constants: a function
# returning one could be compared against any integer, and nothing stopped a
# caller from inventing a code. It is a fieldless enum now (an i32
# representation keeps the old numeric values, for logs and kfs_errno).

import goliath.error { Error, ErrorCode, error_new, error_code, error_is_not_found, error_is_exists }

# The ticket's RED case: ErrorCode is an enum with variants, so callers write
# ErrorCode.NotFound rather than an i32 constant.
[[test]]
fn test_error_code_is_typed() -> i32
    let e: ErrorCode = ErrorCode.NotFound
    if e != ErrorCode.NotFound
        return 1
    if e == ErrorCode.Ok
        return 2
    0

# The discriminant values are the old ERR_* numbers (0..12): a persisted log
# or kfs_errno that printed a code still reads the same.
[[test]]
fn test_error_code_values_unchanged() -> i32
    if ErrorCode.Ok as i32 != 0
        return 1
    if ErrorCode.NotFound as i32 != 1
        return 2
    if ErrorCode.AlreadyExists as i32 != 2
        return 3
    if ErrorCode.InvalidPath as i32 != 3
        return 4
    if ErrorCode.InvalidBlobId as i32 != 4
        return 5
    if ErrorCode.CorruptBlob as i32 != 5
        return 6
    if ErrorCode.IoError as i32 != 6
        return 7
    if ErrorCode.OutOfSpace as i32 != 7
        return 8
    if ErrorCode.NotADirectory as i32 != 8
        return 9
    if ErrorCode.NotAFile as i32 != 9
        return 10
    if ErrorCode.DirectoryNotEmpty as i32 != 10
        return 11
    if ErrorCode.PermissionDenied as i32 != 11
        return 12
    if ErrorCode.PathTooLong as i32 != 12
        return 13
    0

# Error carries an ErrorCode through error_new/error_code unchanged.
[[test]]
fn test_error_wraps_code() -> i32
    let e: Error = error_new(ErrorCode.CorruptBlob)
    if error_code(e) != ErrorCode.CorruptBlob
        return 1
    if error_is_not_found(e)
        return 2
    let missing: Error = error_new(ErrorCode.NotFound)
    if not error_is_not_found(missing)
        return 3
    let exists: Error = error_new(ErrorCode.AlreadyExists)
    if not error_is_exists(exists)
        return 4
    if error_is_exists(missing)
        return 5
    0
