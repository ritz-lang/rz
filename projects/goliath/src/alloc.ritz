# Allocator - where goliath gets its memory (AGAST #1881)
#
# Goliath's core (blob store, namespace, image codec, block store) never maps
# memory itself: it calls the Allocator its MemoryBlobStore was built with.
# That is what lets one goliath run as a Linux process and inside the
# harland kernel:
#
#   * hosted (Linux tests, the CLI): goliath.hosted's hosted_allocator(),
#     over ritzlib.memory's heap (mmap, or whatever PageSource is installed)
#   * the kernel: an Allocator over its own heap (kalloc / kfree)
#
# The type is ritzlib.memory's Allocator (AGAST #4120), which began as this
# module's: { ctx, alloc(ctx, len), free(ctx, p, len) }. ritzlib.memory is
# core, so the freestanding build can import it. Goliath frees by size, so it
# calls the Allocator directly here rather than through malloc_in's tagged
# blocks.
#
#   alloc(ctx, len)      len bytes of read-write memory, or null when out of memory
#   free(ctx, p, len)    give back what one alloc(ctx, len) returned

import ritzlib.memory { Allocator }

pub fn allocator_alloc(a: *Allocator, len: i64) -> *u8
    if len <= 0
        return null
    let f: fn(*u8, i64) -> *u8 = (*a).alloc
    f((*a).ctx, len)

pub fn allocator_free(a: *Allocator, p: *u8, len: i64)
    if p == null or len <= 0
        return
    let f: fn(*u8, *u8, i64) -> i32 = (*a).free
    f((*a).ctx, p, len)
