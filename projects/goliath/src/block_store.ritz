# BlockStore - a goliath image on a block device (AGAST #1881)
#
# The kernel's persistent filesystem: the same image goliath.file_store keeps
# in a host file (goliath.image), behind two one-sector slot headers, on any
# device that reads and writes 512-byte sectors. The device is a BlockDevice
# (an opaque handle and two functions), so the kernel passes its virtio-blk
# driver and a test passes a RAM disk.
#
# Layout (integers little-endian):
#
#     sector 0, 1  two slot headers, each naming one image
#                    0   magic       "GOLIATHB"   8 bytes
#                    8   version     u32 = 2
#                    12  sector      u32 = 512
#                    16  generation  u64 >= 1     newer saves count higher
#                    24  image_lba   u64          first sector of the image
#                    32  image_len   u64          bytes of image
#                    40  zero up to 504
#                    504 checksum    u64          FNV-1a 64 of bytes 0..504
#     sector 2..   images, each zero padded to a whole sector
#
# Crash safety (AGAST #4226): load takes the valid header with the highest
# generation. Save never touches that header or its image: it writes the new
# image where it doesn't overlap the one in use (ahead of it if it fits,
# otherwise after it), then the other header, with the next generation. So
# until that last one-sector write lands the disk still loads the previous
# tree; a header cut mid-sector fails its checksum and is skipped. The image
# needs room for itself beside the one in use.
#
# Free space needs no map: the store is in memory and the image holds only
# live blobs, so a deleted file's blobs are gone from the next save.

import ritzlib.memory { Allocator }
import goliath.alloc { allocator_alloc, allocator_free }
import goliath.blob_store { MemoryBlobStore, memory_store_allocator }
import goliath.namespace { Namespace, namespace_store }
import goliath.image { ImageSink, image_size, image_write, image_load, image_put_le, image_get_le }
import goliath.error { ErrorCode, ERR_OK, ERR_NOT_FOUND, ERR_CORRUPT_BLOB, ERR_IO_ERROR, ERR_OUT_OF_SPACE }

pub const BLOCK_SECTOR_SIZE: i64 = 512
pub const BLOCK_STORE_VERSION: u32 = 2

# Sectors before the first image: the two slot headers
const BLOCK_HEADERS: u64 = 2
const BLOCK_CHECKSUM_AT: i64 = 504

# Sectors per device call when loading (one page)
const BLOCK_IO_SECTORS: u32 = 8

# A device of `sectors` 512-byte sectors. read / write(dev, lba, count, buf)
# move `count` sectors at `lba` to / from `buf` and return 0 on success.
pub struct BlockDevice
    dev: *u8
    sectors: u64
    read: fn(*u8, u64, u32, *u8) -> i32
    write: fn(*u8, u64, u32, *u8) -> i32

fn dev_read(d: *BlockDevice, lba: u64, count: u32, buf: *u8) -> bool
    let f: fn(*u8, u64, u32, *u8) -> i32 = (*d).read
    f((*d).dev, lba, count, buf) == 0

fn dev_write(d: *BlockDevice, lba: u64, count: u32, buf: *u8) -> bool
    let f: fn(*u8, u64, u32, *u8) -> i32 = (*d).write
    f((*d).dev, lba, count, buf) == 0

fn block_magic_byte(i: i64) -> u8
    *(c"GOLIATHB" + i)

# Sectors holding `len` bytes
fn sectors_for(len: u64) -> u64
    (len + BLOCK_SECTOR_SIZE as u64 - 1) / BLOCK_SECTOR_SIZE as u64

# ============================================================================
# Slot headers
# ============================================================================

const HEADER_NONE: i32 = 0      # no goliath magic: blank or foreign
const HEADER_VALID: i32 = 1
const HEADER_BAD: i32 = 2       # goliath magic, but torn or out of bounds

struct SlotHeader
    state: i32
    generation: u64
    lba: u64
    len: u64

# FNV-1a 64 of the header bytes before the checksum
fn header_checksum(sb: *u8) -> u64
    var h: u64 = 14695981039346656037
    var i: i64 = 0
    while i < BLOCK_CHECKSUM_AT
        h = (h ^ *(sb + i) as u64) * 1099511628211
        i = i + 1
    h

# Read header `idx` (0 or 1) into `h`; false on an I/O error
fn header_read(dev: *BlockDevice, idx: u64, h: *SlotHeader) -> bool
    (*h).state = HEADER_NONE
    (*h).generation = 0
    (*h).lba = 0
    (*h).len = 0
    if idx >= (*dev).sectors
        return true
    var sb: [512]u8
    if not dev_read(dev, idx, 1, @sb[0])
        return false
    var i: i64 = 0
    while i < 8
        if sb[i] != block_magic_byte(i)
            return true
        i = i + 1
    (*h).state = HEADER_BAD
    if image_get_le(@sb[BLOCK_CHECKSUM_AT], 8) != header_checksum(@sb[0])
        return true
    if image_get_le(@sb[8], 4) as u32 != BLOCK_STORE_VERSION
        return true
    if image_get_le(@sb[12], 4) != BLOCK_SECTOR_SIZE as u64
        return true
    let gen: u64 = image_get_le(@sb[16], 8)
    let lba: u64 = image_get_le(@sb[24], 8)
    let len: u64 = image_get_le(@sb[32], 8)
    if gen == 0 or len == 0 or lba < BLOCK_HEADERS or lba + sectors_for(len) > (*dev).sectors
        return true
    (*h).state = HEADER_VALID
    (*h).generation = gen
    (*h).lba = lba
    (*h).len = len
    true

fn header_write(dev: *BlockDevice, idx: u64, gen: u64, lba: u64, len: u64) -> bool
    var sb: [512]u8
    var i: i64 = 0
    while i < BLOCK_SECTOR_SIZE
        sb[i] = 0
        i = i + 1
    i = 0
    while i < 8
        sb[i] = block_magic_byte(i)
        i = i + 1
    image_put_le(@sb[8], BLOCK_STORE_VERSION as u64, 4)
    image_put_le(@sb[12], BLOCK_SECTOR_SIZE as u64, 4)
    image_put_le(@sb[16], gen, 8)
    image_put_le(@sb[24], lba, 8)
    image_put_le(@sb[32], len, 8)
    image_put_le(@sb[BLOCK_CHECKSUM_AT], header_checksum(@sb[0]), 8)
    dev_write(dev, idx, 1, @sb[0])

# The header in use: the valid one with the higher generation. -1 if neither
# is valid; ERR_IO_ERROR as -2.
fn header_current(dev: *BlockDevice, h0: *SlotHeader, h1: *SlotHeader) -> i32
    if not header_read(dev, 0, h0) or not header_read(dev, 1, h1)
        return -2
    if (*h1).state == HEADER_VALID and ((*h0).state != HEADER_VALID or (*h1).generation > (*h0).generation)
        return 1
    if (*h0).state == HEADER_VALID
        return 0
    -1

# ============================================================================
# Save
# ============================================================================

# An ImageSink filling one sector at a time
struct SectorWriter
    dev: *BlockDevice
    lba: u64
    fill: i64
    sector: [512]u8

fn writer_flush(w: *SectorWriter) -> bool
    if (*w).fill == 0
        return true
    while (*w).fill < BLOCK_SECTOR_SIZE
        (*w).sector[(*w).fill] = 0
        (*w).fill = (*w).fill + 1
    if not dev_write((*w).dev, (*w).lba, 1, @(*w).sector[0])
        return false
    (*w).lba = (*w).lba + 1
    (*w).fill = 0
    true

fn writer_write(ctx: *u8, data: *u8, len: i64) -> bool
    let w: *SectorWriter = ctx as *SectorWriter
    var i: i64 = 0
    while i < len
        (*w).sector[(*w).fill] = *(data + i)
        (*w).fill = (*w).fill + 1
        i = i + 1
        if (*w).fill == BLOCK_SECTOR_SIZE and not writer_flush(w)
            return false
    true

# Write `ns` (its whole store) to `dev`. ERR_OK, ERR_OUT_OF_SPACE (the image
# doesn't fit beside the one in use; the device is untouched) or
# ERR_IO_ERROR. Cut short at any point, the device still loads the tree of
# the last save that returned ERR_OK.
pub fn block_store_save(dev: *BlockDevice, ns: *Namespace) -> ErrorCode
    let len: u64 = image_size(ns)
    let sectors: u64 = sectors_for(len)
    if BLOCK_HEADERS + sectors > (*dev).sectors
        return ERR_OUT_OF_SPACE
    var h0: SlotHeader
    var h1: SlotHeader
    let cur: i32 = header_current(dev, @h0, @h1)
    if cur == -2
        return ERR_IO_ERROR

    # Where the new image goes, which header names it, and its generation
    var lba: u64 = BLOCK_HEADERS
    var idx: u64 = 0
    var gen: u64 = 1
    if cur >= 0
        var live: *SlotHeader = @h0
        idx = 1
        if cur == 1
            live = @h1
            idx = 0
        gen = (*live).generation + 1
        if BLOCK_HEADERS + sectors > (*live).lba
            lba = (*live).lba + sectors_for((*live).len)
            if lba + sectors > (*dev).sectors
                return ERR_OUT_OF_SPACE

    var w: SectorWriter
    w.dev = dev
    w.lba = lba
    w.fill = 0
    var sink: ImageSink = ImageSink { ctx: @w as *u8, write: writer_write }
    if not image_write(ns, @sink) or not writer_flush(@w)
        return ERR_IO_ERROR
    # The flip: one sector, last
    if not header_write(dev, idx, gen, lba, len)
        return ERR_IO_ERROR
    ERR_OK

# ============================================================================
# Load
# ============================================================================

# Load the newest whole image on `dev` into the empty `store` and set
# `ns_out` to its namespace.
#
#   ERR_OK
#   ERR_NOT_FOUND     no goliath header: a blank (or foreign) device;
#                     the caller starts an empty namespace (namespace_new)
#   ERR_CORRUPT_BLOB  goliath headers, but none valid, or the image they
#                     name isn't whole
#   ERR_IO_ERROR / ERR_OUT_OF_SPACE
pub fn block_store_load(dev: *BlockDevice, store: *MemoryBlobStore, ns_out: *Namespace) -> ErrorCode
    var h0: SlotHeader
    var h1: SlotHeader
    let cur: i32 = header_current(dev, @h0, @h1)
    if cur == -2
        return ERR_IO_ERROR
    if cur == -1
        if h0.state == HEADER_BAD or h1.state == HEADER_BAD
            return ERR_CORRUPT_BLOB
        return ERR_NOT_FOUND
    var live: *SlotHeader = @h0
    if cur == 1
        live = @h1
    let len: u64 = (*live).len
    let sectors: u64 = sectors_for(len)
    let first: u64 = (*live).lba

    let alloc: *Allocator = memory_store_allocator(store)
    let buf_len: i64 = (sectors * BLOCK_SECTOR_SIZE as u64) as i64
    let buf: *u8 = allocator_alloc(alloc, buf_len)
    if buf == null
        return ERR_OUT_OF_SPACE
    var done: u64 = 0
    while done < sectors
        var n: u32 = BLOCK_IO_SECTORS
        if sectors - done < n as u64
            n = (sectors - done) as u32
        if not dev_read(dev, first + done, n, buf + (done * BLOCK_SECTOR_SIZE as u64) as i64)
            allocator_free(alloc, buf, buf_len)
            return ERR_IO_ERROR
        done = done + n as u64

    let rc: ErrorCode = image_load(buf, len as i64, store, ns_out)
    allocator_free(alloc, buf, buf_len)
    rc
