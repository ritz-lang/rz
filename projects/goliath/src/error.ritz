# Goliath Error Types
#
# All error types for the Goliath filesystem (AGAST #4228).
#
# ErrorCode is a fieldless enum: a function that fails returns a variant, and
# a caller compares against one, so an integer can no longer stand in for a
# code. The explicit i32 representation keeps the numeric values the old
# ERR_* constants had, for logs and the kernel's kfs_errno mapping.

# Why an operation failed. Ok is 0, so `code as i32 == 0` still means success.
pub enum ErrorCode: i32
    Ok = 0
    NotFound = 1
    AlreadyExists = 2
    InvalidPath = 3
    InvalidBlobId = 4
    CorruptBlob = 5
    IoError = 6
    OutOfSpace = 7
    NotADirectory = 8
    NotAFile = 9
    DirectoryNotEmpty = 10
    PermissionDenied = 11
    PathTooLong = 12

# Filesystem error with context
pub struct Error
    code: ErrorCode
    # TODO: Add message when String is available

pub fn error_new(code: ErrorCode) -> Error
    Error { code: code }

pub fn error_code(err: Error) -> ErrorCode
    err.code

pub fn error_is_not_found(err: Error) -> bool
    err.code == ErrorCode.NotFound

pub fn error_is_exists(err: Error) -> bool
    err.code == ErrorCode.AlreadyExists
