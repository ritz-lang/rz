# Hosted glue: goliath as a Linux process (AGAST #1881)
#
# The one module of goliath's library (with file_store, which persists to a
# host file) that may use the hosted ritzlib. Everything else takes an
# Allocator, so the kernel can build it without these.

import ritzlib.memory { Allocator, PageSource, page_source_get }
import goliath.blob_store { MemoryBlobStore, memory_store_new_in }

# The page source hosted_allocator's blocks map from and unmap to. The
# Allocator points at it, so it lives here rather than on a caller's stack.
var g_hosted_pages: PageSource

# ritzlib.memory's installed PageSource (mmap by default), as whole-page
# blocks given back by size, which is how goliath frees
pub fn hosted_allocator() -> Allocator
    g_hosted_pages = page_source_get()
    g_hosted_pages.allocator()

# A MemoryBlobStore on the hosted heap
pub fn memory_store_new() -> MemoryBlobStore
    memory_store_new_in(hosted_allocator())
