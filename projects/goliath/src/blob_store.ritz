# MemoryBlobStore - content-addressed, reference-counted blob storage
#
# Blobs live in memory from the store's Allocator (goliath.alloc), so the
# same store runs hosted and in the kernel. Persistence is separate: the
# store is written out whole as an image (goliath.image) to a host file
# (goliath.file_store) or a block device (goliath.block_store).
#
# Reference counts (AGAST #1881). Each blob counts its holders:
#
#   * memory_store_put gives the caller one reference, whether it stored the
#     bytes or found them already stored (deduplication);
#   * memory_store_retain adds one, memory_store_release drops one and frees
#     the blob when none are left.
#
# The store does not know what a directory is. goliath.namespace keeps the
# invariant on top: a blob's count is the number of directory entries (in
# live directory blobs) naming it, plus one for the namespace's root.
#
# The store grows as needed: it starts with STORE_INITIAL_CAPACITY slots and
# doubles when full.

import ritzlib.span { Span, span_from_ptr, span_empty }
import ritzlib.memory { Allocator }
import goliath.alloc { allocator_alloc, allocator_free }
import goliath.blob_id { BlobId, blob_id_eq, blob_id_zero, blob_id_compute, blob_id_copy }

# Maximum blob size (1GB)
pub const BLOB_MAX_SIZE: u64 = 1073741824

const STORE_INITIAL_CAPACITY: i32 = 64

# A stored blob. `refs` is 0 only for a slot that is not in use.
struct BlobEntry
    id: BlobId
    data: *u8
    size: u64
    refs: i32
    # The blob is a directory whose entries' blobs it holds references on
    # (see memory_store_hold_children)
    holds_children: bool

pub struct MemoryBlobStore
    alloc: Allocator
    entries: *BlobEntry
    capacity: i32
    count: i32
    total_size: u64
    # Open-addressing index from BlobId to a live slot in `entries`
    # (AGAST #4228). Each cell is a slot, or INDEX_EMPTY / INDEX_TOMBSTONE.
    # Its capacity is twice `capacity`, so lookups probe a fraction of the
    # table rather than every slot.
    index: *i32
    index_capacity: i32

# Index cell values. Slots are >= 0.
const INDEX_EMPTY: i32 = -1
const INDEX_TOMBSTONE: i32 = -2

fn entries_bytes(capacity: i32) -> i64
    sizeof(BlobEntry) * capacity as i64

fn index_bytes(capacity: i32) -> i64
    sizeof(i32) * capacity as i64

# `capacity` empty index cells from `a`, or null when out of memory
fn index_alloc(a: *Allocator, capacity: i32) -> *i32
    let index: *i32 = allocator_alloc(a, index_bytes(capacity)) as *i32
    if index == null
        return null
    var i: i32 = 0
    while i < capacity
        *(index + i) = INDEX_EMPTY
        i = i + 1
    index

# FNV-1a over the 32-byte id
fn blob_hash(id: *BlobId) -> u64
    var h: u64 = 14695981039346656037
    var i: i32 = 0
    while i < 32
        h = h ^ ((*id).hash[i] as u64)
        h = h * 1099511628211
        i = i + 1
    h

# The live slot holding `id`, or -1. Linear probing; an empty cell ends the
# probe (tombstones from deletes are skipped). `probes_out` (if not null)
# takes the number of cells inspected.
fn index_lookup(store: *MemoryBlobStore, id: *BlobId, probes_out: *i32) -> i32
    var probes: i32 = 0
    if (*store).index != null and (*store).index_capacity > 0
        let mask: i32 = (*store).index_capacity - 1
        var i: i32 = (blob_hash(id) as i32) & mask
        while probes < (*store).index_capacity
            let cell: i32 = *((*store).index + i)
            probes = probes + 1
            if cell == INDEX_EMPTY
                break
            if cell >= 0
                let entry: *BlobEntry = (*store).entries + cell
                if (*entry).refs > 0 and blob_id_eq(@(*entry).id, id)
                    if probes_out != null
                        *probes_out = probes
                    return cell
            i = (i + 1) & mask
    if probes_out != null
        *probes_out = probes
    -1

# Point `id`'s cell at `slot`, reusing the first tombstone on the probe path.
fn index_insert(store: *MemoryBlobStore, id: *BlobId, slot: i32)
    if (*store).index == null or (*store).index_capacity == 0
        return
    let mask: i32 = (*store).index_capacity - 1
    var i: i32 = (blob_hash(id) as i32) & mask
    var tombstone: i32 = -1
    var probes: i32 = 0
    while probes < (*store).index_capacity
        let cell: i32 = *((*store).index + i)
        if cell == INDEX_EMPTY
            if tombstone >= 0
                *((*store).index + tombstone) = slot
            else
                *((*store).index + i) = slot
            return
        if cell == INDEX_TOMBSTONE
            if tombstone < 0
                tombstone = i
        else
            let entry: *BlobEntry = (*store).entries + cell
            if (*entry).refs > 0 and blob_id_eq(@(*entry).id, id)
                *((*store).index + i) = slot
                return
        i = (i + 1) & mask
        probes = probes + 1
    # A full table can only happen if the load factor breaks; keep the
    # tombstone rather than lose the entry.
    if tombstone >= 0
        *((*store).index + tombstone) = slot

# Forget `id` (its slot is going away). The cell becomes a tombstone so
# other probe chains keep working.
fn index_remove(store: *MemoryBlobStore, id: *BlobId)
    if (*store).index == null or (*store).index_capacity == 0
        return
    let mask: i32 = (*store).index_capacity - 1
    var i: i32 = (blob_hash(id) as i32) & mask
    var probes: i32 = 0
    while probes < (*store).index_capacity
        let cell: i32 = *((*store).index + i)
        if cell == INDEX_EMPTY
            return
        if cell >= 0
            let entry: *BlobEntry = (*store).entries + cell
            if blob_id_eq(@(*entry).id, id)
                *((*store).index + i) = INDEX_TOMBSTONE
                return
        i = (i + 1) & mask
        probes = probes + 1

# Rebuild the index from the entries (after the table moves).
fn index_rebuild(store: *MemoryBlobStore)
    if (*store).index == null
        return
    var i: i32 = 0
    while i < (*store).index_capacity
        *((*store).index + i) = INDEX_EMPTY
        i = i + 1
    i = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        # refs is -1 transiently during mark-and-sweep: still present
        if (*entry).refs != 0
            index_insert(store, @(*entry).id, i)
        i = i + 1

# `capacity` unused entries from `a`, or null when out of memory
fn entries_alloc(a: *Allocator, capacity: i32) -> *BlobEntry
    let entries: *BlobEntry = allocator_alloc(a, entries_bytes(capacity)) as *BlobEntry
    if entries == null
        return null
    var i: i32 = 0
    while i < capacity
        let entry: *BlobEntry = entries + i
        (*entry).refs = 0
        (*entry).data = null
        (*entry).size = 0
        (*entry).holds_children = false
        i = i + 1
    entries

# Double the entry array (and its index). The first new (free) slot, or null
# when out of memory (the store is unchanged).
fn store_grow(store: *MemoryBlobStore) -> *BlobEntry
    let old_cap: i32 = (*store).capacity
    var new_cap: i32 = old_cap * 2
    if new_cap == 0
        new_cap = STORE_INITIAL_CAPACITY
    let new_index_cap: i32 = new_cap * 2
    let entries: *BlobEntry = entries_alloc(@(*store).alloc, new_cap)
    if entries == null
        return null
    let index: *i32 = index_alloc(@(*store).alloc, new_index_cap)
    if index == null
        allocator_free(@(*store).alloc, entries as *u8, entries_bytes(new_cap))
        return null
    var i: i32 = 0
    while i < old_cap
        *(entries + i) = *((*store).entries + i)
        i = i + 1
    allocator_free(@(*store).alloc, (*store).entries as *u8, entries_bytes(old_cap))
    if (*store).index != null
        allocator_free(@(*store).alloc, (*store).index as *u8, index_bytes((*store).index_capacity))
    (*store).entries = entries
    (*store).capacity = new_cap
    (*store).index = index
    (*store).index_capacity = new_index_cap
    index_rebuild(store)
    entries + old_cap

# An empty store whose memory all comes from `alloc`. (goliath.hosted's
# memory_store_new uses the hosted heap.) Out of memory here leaves a store
# with no slots, which grows on first put.
pub fn memory_store_new_in(alloc: Allocator) -> MemoryBlobStore
    var store: MemoryBlobStore = MemoryBlobStore {
        alloc: alloc,
        entries: null,
        capacity: 0,
        count: 0,
        total_size: 0,
        index: null,
        index_capacity: 0
    }
    let entries: *BlobEntry = entries_alloc(@store.alloc, STORE_INITIAL_CAPACITY)
    if entries != null
        let index: *i32 = index_alloc(@store.alloc, STORE_INITIAL_CAPACITY * 2)
        if index == null
            allocator_free(@store.alloc, entries as *u8, entries_bytes(STORE_INITIAL_CAPACITY))
        else
            store.entries = entries
            store.capacity = STORE_INITIAL_CAPACITY
            store.index = index
            store.index_capacity = STORE_INITIAL_CAPACITY * 2
    store

# The allocator this store (and its users: namespace, image) draws on
pub fn memory_store_allocator(store: *MemoryBlobStore) -> *Allocator
    @(*store).alloc

# The entry holding `id`, or null
fn store_find(store: *MemoryBlobStore, id: *BlobId) -> *BlobEntry
    let slot: i32 = index_lookup(store, id, null)
    if slot < 0
        return null
    (*store).entries + slot

# Diagnostics (tests): how many index cells one lookup inspects. A linear
# scan would grow with `memory_store_capacity`; the index's stay small.
pub fn memory_store_find_probes(store: *MemoryBlobStore, id: *BlobId) -> i32
    var probes: i32 = 0
    index_lookup(store, id, @probes)
    probes

fn entry_free(store: *MemoryBlobStore, entry: *BlobEntry)
    index_remove(store, @(*entry).id)
    allocator_free(@(*store).alloc, (*entry).data, (*entry).size as i64)
    (*store).total_size = (*store).total_size - (*entry).size
    (*store).count = (*store).count - 1
    (*entry).data = null
    (*entry).size = 0
    (*entry).refs = 0
    (*entry).holds_children = false

pub fn memory_store_exists(store: *MemoryBlobStore, id: *BlobId) -> bool
    store_find(store, id) != null

# A blob's bytes, or null if it isn't stored (an empty blob's data is null
# too: check memory_store_exists)
pub fn memory_store_get(store: *MemoryBlobStore, id: *BlobId) -> *u8
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return null
    (*entry).data

pub fn memory_store_get_span(store: *MemoryBlobStore, id: *BlobId) -> Span<u8>
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return span_empty<u8>()
    span_from_ptr<u8>((*entry).data, (*entry).size as i64)

pub fn memory_store_get_size(store: *MemoryBlobStore, id: *BlobId) -> u64
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return 0
    (*entry).size

# Store `size` bytes at `data` and return their BlobId, with one reference
# for the caller. Bytes already stored are not copied again: that blob gains
# the reference. The zero BlobId when out of memory or over BLOB_MAX_SIZE.
pub fn memory_store_put(store: *MemoryBlobStore, data: *u8, size: u64) -> BlobId
    if size > BLOB_MAX_SIZE
        return blob_id_zero()
    var id: BlobId = blob_id_compute(data, size)

    let found: *BlobEntry = store_find(store, @id)
    if found != null
        (*found).refs = (*found).refs + 1
        return id

    var slot: *BlobEntry = null
    var slot_index: i32 = -1
    var i: i32 = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        if (*entry).refs == 0
            slot = entry
            slot_index = i
            break
        i = i + 1
    if slot == null
        let old_cap: i32 = (*store).capacity
        slot = store_grow(store)
        if slot == null
            return blob_id_zero()
        slot_index = old_cap

    var copy: *u8 = null
    if size > 0
        copy = allocator_alloc(@(*store).alloc, size as i64)
        if copy == null
            return blob_id_zero()
        var j: u64 = 0
        while j < size
            *(copy + j) = *(data + j)
            j = j + 1

    (*slot).id = blob_id_copy(@id)
    (*slot).data = copy
    (*slot).size = size
    (*slot).refs = 1
    (*slot).holds_children = false
    (*store).count = (*store).count + 1
    (*store).total_size = (*store).total_size + size
    index_insert(store, @(*slot).id, slot_index)
    id

# References to `id` (0 if it isn't stored)
pub fn memory_store_refs(store: *MemoryBlobStore, id: *BlobId) -> i32
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return 0
    (*entry).refs

# One more reference to a stored blob. Its new count, or 0 if not stored.
pub fn memory_store_retain(store: *MemoryBlobStore, id: *BlobId) -> i32
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return 0
    (*entry).refs = (*entry).refs + 1
    (*entry).refs

# Drop one reference; the blob is freed when none are left. Its remaining
# count (0 once freed), or -1 if it wasn't stored.
pub fn memory_store_release(store: *MemoryBlobStore, id: *BlobId) -> i32
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return -1
    if (*entry).refs == 1
        entry_free(store, entry)
        return 0
    (*entry).refs = (*entry).refs - 1
    (*entry).refs

# Directory blobs hold a reference on each blob their entries name, taken
# once, when the blob is first stored as a directory. (Kept per blob, not
# per put: a file whose bytes happen to equal a directory blob is the same
# blob.) True if `id` didn't hold them yet and now does: the caller then
# retains each child. False if it already did, or isn't stored.
pub fn memory_store_hold_children(store: *MemoryBlobStore, id: *BlobId) -> bool
    let entry: *BlobEntry = store_find(store, id)
    if entry == null or (*entry).holds_children
        return false
    (*entry).holds_children = true
    true

# Whether `id` holds its entries' references (so its last release must drop
# them)
pub fn memory_store_holds_children(store: *MemoryBlobStore, id: *BlobId) -> bool
    let entry: *BlobEntry = store_find(store, id)
    entry != null and (*entry).holds_children

# Remove a blob whatever its count. True if it was stored.
pub fn memory_store_delete(store: *MemoryBlobStore, id: *BlobId) -> bool
    let entry: *BlobEntry = store_find(store, id)
    if entry == null
        return false
    entry_free(store, entry)
    true

pub fn memory_store_count(store: *MemoryBlobStore) -> i32
    (*store).count

pub fn memory_store_total_size(store: *MemoryBlobStore) -> u64
    (*store).total_size

# Free every blob and the store's own table
pub fn memory_store_free(store: *MemoryBlobStore) -> i32
    var i: i32 = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        if (*entry).refs > 0
            allocator_free(@(*store).alloc, (*entry).data, (*entry).size as i64)
        i = i + 1
    allocator_free(@(*store).alloc, (*store).entries as *u8, entries_bytes((*store).capacity))
    if (*store).index != null
        allocator_free(@(*store).alloc, (*store).index as *u8, index_bytes((*store).index_capacity))
    (*store).entries = null
    (*store).index = null
    (*store).capacity = 0
    (*store).index_capacity = 0
    (*store).count = 0
    (*store).total_size = 0
    0

# ============================================================================
# Mark and sweep (goliath.namespace recounts a loaded store with these)
# ============================================================================
#
# A loaded store's blobs each hold the one reference put gave them. To get
# the real counts, mark: memory_store_mark_begin zeroes every count (the
# blobs stay), then the namespace retains what its tree reaches through
# memory_store_mark. memory_store_sweep frees whatever is still unreferenced.

# Every stored blob to "unreferenced but present" (refs -1)
pub fn memory_store_mark_begin(store: *MemoryBlobStore)
    var i: i32 = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        if (*entry).refs > 0
            (*entry).refs = -1
            (*entry).holds_children = false
        i = i + 1

# During a mark: add one reference to a present blob. Its new count (1 the
# first time it is reached), or 0 if it isn't stored.
pub fn memory_store_mark(store: *MemoryBlobStore, id: *BlobId) -> i32
    var i: i32 = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        if (*entry).refs != 0 and blob_id_eq(@(*entry).id, id)
            if (*entry).refs < 0
                (*entry).refs = 0
            (*entry).refs = (*entry).refs + 1
            return (*entry).refs
        i = i + 1
    0

# Free every blob no mark reached. How many were freed.
pub fn memory_store_sweep(store: *MemoryBlobStore) -> i32
    var freed: i32 = 0
    var i: i32 = 0
    while i < (*store).capacity
        let entry: *BlobEntry = (*store).entries + i
        if (*entry).refs < 0
            entry_free(store, entry)
            freed = freed + 1
        i = i + 1
    freed

# ============================================================================
# Slot iteration (for writing a store out: see goliath.image)
# ============================================================================
#
# Slots 0..memory_store_capacity() - 1; unused ones have no blob.

pub fn memory_store_capacity(store: *MemoryBlobStore) -> i32
    (*store).capacity

pub fn memory_store_slot_used(store: *MemoryBlobStore, slot: i32) -> bool
    (*((*store).entries + slot)).refs > 0

pub fn memory_store_slot_id(store: *MemoryBlobStore, slot: i32) -> BlobId
    blob_id_copy(@(*((*store).entries + slot)).id)

pub fn memory_store_slot_data(store: *MemoryBlobStore, slot: i32) -> *u8
    (*((*store).entries + slot)).data

pub fn memory_store_slot_size(store: *MemoryBlobStore, slot: i32) -> u64
    (*((*store).entries + slot)).size
