# Directory Entry
#
# Structures for directory entries and metadata.
# Uses StrView for name parameters.

import ritzlib.strview { StrView, strview_from_ptr }
import goliath.blob_id { BlobId, blob_id_zero, blob_id_eq, blob_id_copy }
import goliath.path { NAME_MAX }

# Entry type constants
pub const ENTRY_FILE: u8 = 0
pub const ENTRY_DIRECTORY: u8 = 1
pub const ENTRY_SYMLINK: u8 = 2

# Type alias
pub type EntryKind = u8

# File/directory metadata
pub struct Metadata
    size: u64           # File size in bytes (0 for directories)
    created: u64        # Creation time (unix timestamp)
    modified: u64       # Modification time
    mode: u32           # Permission bits

# Directory entry
pub struct NsEntry
    name: [256]u8       # Name (null-terminated, max 255 chars)
    name_len: u8        # Length of name
    kind: EntryKind     # File, directory, or symlink
    blob_id: BlobId     # Content hash (for files) or dir blob (for dirs)
    metadata: Metadata  # Size, timestamps, permissions

# Create a new file entry
pub fn dir_entry_file(name: StrView, blob_id: *BlobId, size: u64) -> NsEntry
    var entry: NsEntry

    # Copy name (truncate if too long)
    var copy_len: i64 = name.len
    if copy_len > NAME_MAX
        copy_len = NAME_MAX

    var i: i64 = 0
    while i < copy_len
        entry.name[i] = *(name.ptr + i)
        i = i + 1
    entry.name[i] = 0  # null terminate
    entry.name_len = copy_len as u8

    entry.kind = ENTRY_FILE
    entry.blob_id = blob_id_copy(blob_id)

    entry.metadata.size = size
    entry.metadata.created = 0  # TODO: get current time
    entry.metadata.modified = 0
    entry.metadata.mode = 420   # 0644

    entry

# Create a new directory entry
pub fn dir_entry_dir(name: StrView, blob_id: *BlobId) -> NsEntry
    var entry: NsEntry

    # Copy name (truncate if too long)
    var copy_len: i64 = name.len
    if copy_len > NAME_MAX
        copy_len = NAME_MAX

    var i: i64 = 0
    while i < copy_len
        entry.name[i] = *(name.ptr + i)
        i = i + 1
    entry.name[i] = 0
    entry.name_len = copy_len as u8

    entry.kind = ENTRY_DIRECTORY
    entry.blob_id = blob_id_copy(blob_id)

    entry.metadata.size = 0
    entry.metadata.created = 0
    entry.metadata.modified = 0
    entry.metadata.mode = 493   # 0755

    entry

# Check if entry is a file
pub fn dir_entry_is_file(entry: *NsEntry) -> bool
    (*entry).kind == ENTRY_FILE

# Check if entry is a directory
pub fn dir_entry_is_dir(entry: *NsEntry) -> bool
    (*entry).kind == ENTRY_DIRECTORY

# Get entry name as StrView
pub fn dir_entry_name(entry: *NsEntry) -> StrView
    strview_from_ptr(@(*entry).name[0], (*entry).name_len as i64)

# Get entry name length
pub fn dir_entry_name_len(entry: *NsEntry) -> u8
    (*entry).name_len

# Compare entry name with a StrView
pub fn dir_entry_name_eq(entry: *NsEntry, name: StrView) -> bool
    if (*entry).name_len as i64 != name.len
        return false

    var i: i64 = 0
    while i < name.len
        if (*entry).name[i] != *(name.ptr + i)
            return false
        i = i + 1

    true

# Serialized directory (list of entries stored as a blob)
# Format (integers little-endian):
#   u32: entry count
#   DiskDirEntry[]: entries
#
# DiskDirEntry is the on-disk entry. It is all bytes (alignment 1, no
# padding), so sizeof(DiskDirEntry) is its exact serialized size (320) and
# the same on every target, and its field order is its byte layout. The
# in-memory NsEntry has padding, so it is never written out directly.
pub struct DiskDirEntry
    name: [256]u8       # NUL-padded: bytes past name_len are zero
    name_len: u8
    kind: u8
    blob_id: [32]u8
    size: [8]u8
    created: [8]u8
    modified: [8]u8
    mode: [4]u8
    _reserved: [2]u8

# Bytes before the first entry of a directory blob (its u32 count)
pub const DIR_HEADER_SIZE: i64 = 4

# Serialized size of one entry
pub fn dir_entry_disk_size() -> i64
    sizeof(DiskDirEntry)

# Calculate serialized size of a directory
pub fn dir_serialized_size(entry_count: u32) -> u64
    (DIR_HEADER_SIZE + entry_count as i64 * sizeof(DiskDirEntry)) as u64

# Entry `index` of the directory blob at `data`
pub fn dir_entry_at(data: *u8, index: i32) -> *u8
    data + DIR_HEADER_SIZE + index as i64 * sizeof(DiskDirEntry)

fn put_le(out: *u8, value: u64, width: i64)
    var i: i64 = 0
    while i < width
        *(out + i) = ((value >> (i * 8) as u64) & 255) as u8
        i = i + 1

fn get_le(data: *u8, width: i64) -> u64
    var v: u64 = 0
    var i: i64 = width - 1
    while i >= 0
        v = (v << 8) | *(data + i) as u64
        i = i - 1
    v

# Serialize a directory entry to the sizeof(DiskDirEntry) bytes at `out`.
# Deterministic: equal entries give equal bytes (so equal directories give
# equal blobs, which content addressing depends on).
pub fn dir_entry_serialize(entry: *NsEntry, out: *u8)
    let d: *DiskDirEntry = out as *DiskDirEntry
    let len: i32 = (*entry).name_len as i32
    var i: i32 = 0
    while i < 256
        if i < len
            (*d).name[i] = (*entry).name[i]
        else
            (*d).name[i] = 0
        i = i + 1
    (*d).name_len = (*entry).name_len
    (*d).kind = (*entry).kind
    i = 0
    while i < 32
        (*d).blob_id[i] = (*entry).blob_id.hash[i]
        i = i + 1
    put_le(@(*d).size[0], (*entry).metadata.size, 8)
    put_le(@(*d).created[0], (*entry).metadata.created, 8)
    put_le(@(*d).modified[0], (*entry).metadata.modified, 8)
    put_le(@(*d).mode[0], (*entry).metadata.mode as u64, 4)
    (*d)._reserved[0] = 0
    (*d)._reserved[1] = 0

# Deserialize a directory entry from the bytes at `data`
pub fn dir_entry_deserialize(data: *u8) -> NsEntry
    let d: *DiskDirEntry = data as *DiskDirEntry
    var entry: NsEntry
    var i: i32 = 0
    while i < 256
        entry.name[i] = (*d).name[i]
        i = i + 1
    entry.name_len = (*d).name_len
    entry.kind = (*d).kind
    i = 0
    while i < 32
        entry.blob_id.hash[i] = (*d).blob_id[i]
        i = i + 1
    entry.metadata.size = get_le(@(*d).size[0], 8)
    entry.metadata.created = get_le(@(*d).created[0], 8)
    entry.metadata.modified = get_le(@(*d).modified[0], 8)
    entry.metadata.mode = get_le(@(*d).mode[0], 4) as u32
    entry
