# FileStore - a blob store and namespace persisted in one host file
#
# The goliath CLI (AGAST #2788) keeps its store in a regular file holding one
# goliath image (goliath.image: the format, and what a load refuses). The
# file is loaded whole into a MemoryBlobStore (which the Namespace is built
# on) and written back whole after a change. Hosted only: the kernel keeps
# the same image on a block device (goliath.block_store).
#
# Saving writes `<path>.tmp.<pid>` and renames it over `<path>`, so a reader
# never sees a half-written store, and two savers never share a temp file.
#
# A read-modify-write (open, change, save) must hold file_store_lock for its
# whole span, or two writers racing both load the old store and the second
# rename drops the first one's update (#3882). The lock is flock(2) on a
# `<path>.lock` sidecar: the store itself can't carry it, since each save
# renames a new inode over it. Plain readers need no lock.

import ritzlib.fd { Fd, fd_open, fd_adopt, fd_borrow, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_CLOEXEC, LOCK_EX }
import ritzlib.process { process_id }
import ritzlib.fs { read_file, unlink, rename }
import ritzlib.span { Span }
import ritzlib.string { String, string_new }
import ritzlib.strview { StrView }
import goliath.blob_store { MemoryBlobStore }
import goliath.namespace { Namespace, namespace_new }
import goliath.image { ImageSink, image_write, image_load, IMAGE_HEADER_SIZE, IMAGE_VERSION }
import goliath.error { ErrorCode }

pub const FILE_STORE_VERSION: u32 = IMAGE_VERSION
const FS_PATH_MAX: i64 = 4096
const FS_ENOENT: i32 = 2

# ============================================================================
# Helpers
# ============================================================================

# `path` + `suffix`, or an empty String if `path` is empty, holds a NUL, or
# the pair is too long for a host path.
fn fs_path_join(path: StrView, suffix: StrView) -> String
    var out: String = string_new()
    if path.len == 0 or path.len + suffix.len >= FS_PATH_MAX or path.find_byte(0) < path.len
        return out
    out.push_str(path)
    out.push_str(suffix)
    out

# `path` + ".tmp." + the decimal pid: a temp name no other live process will
# pick. Empty if it doesn't fit.
fn fs_tmp_path(path: StrView) -> String
    let pid: i64 = process_id() as i64
    if pid <= 0
        return string_new()
    var suffix: String = string_new()
    suffix.push_str(".tmp.")
    suffix.push_i64(pid)
    fs_path_join(path, suffix.as_view())

# ============================================================================
# Load
# ============================================================================

# Load the store file at `path` into the empty `store`, and set `ns_out` to
# its namespace. A missing file is an empty store (with an empty root
# directory); nothing is created on disk until file_store_save.
#
# ErrorCode.Ok, ErrorCode.CorruptBlob (not a whole, intact store file),
# ErrorCode.IoError (can't read it) or ErrorCode.PathTooLong.
pub fn file_store_open(path: StrView, store: *MemoryBlobStore, ns_out: *Namespace) -> ErrorCode
    let full: String = fs_path_join(path, "")
    if full.len() == 0
        return ErrorCode.PathTooLong

    let image: String = match read_file(full.as_view())
        Ok(bytes) => bytes
        Err(e) =>
            if e.code() == FS_ENOENT
                *ns_out = namespace_new(store)
                return ErrorCode.Ok
            return ErrorCode.IoError
    if image.len() < IMAGE_HEADER_SIZE
        return ErrorCode.CorruptBlob
    let bytes: StrView = image.as_view()
    image_load(bytes.ptr, bytes.len, store, ns_out)

# ============================================================================
# Save
# ============================================================================

# ImageSink callback: `ctx` points at the raw fd of the open temp file.
fn fs_sink_write(ctx: *u8, data: *u8, len: i64) -> bool
    let f: Fd = fd_borrow(*(ctx as *i32))
    match f.write_all(Span<u8> { ptr: data, len: len })
        Ok(_) => true
        Err(_) => false

fn fs_save_to_fd(f: @Fd, ns: *Namespace) -> bool
    var fd_cell: i32 = f.raw()
    var sink: ImageSink = ImageSink { ctx: @fd_cell as *u8, write: fs_sink_write }
    image_write(ns, @sink)

# Write every blob of `ns`'s store, and its root, to the file at `path`
# (atomically replacing it). ErrorCode.Ok, ErrorCode.IoError,
# ErrorCode.PathTooLong.
pub fn file_store_save(path: StrView, ns: *Namespace) -> ErrorCode
    let full_path: String = fs_path_join(path, "")
    let tmp_path: String = fs_tmp_path(path)
    let full: StrView = full_path.as_view()
    let tmp: StrView = tmp_path.as_view()
    if full.len == 0 or tmp.len == 0
        return ErrorCode.PathTooLong

    # mode 0644
    var f: Fd = fd_adopt(-1)
    match fd_open(tmp, O_WRONLY + O_CREAT + O_TRUNC, 420)
        Ok(opened) => f = opened
        Err(_) => return ErrorCode.IoError
    let ok: bool = fs_save_to_fd(@f, ns)
    var closed: bool = true
    match f.close()
        Ok(_) => pass
        Err(_) => closed = false
    if not closed or not ok
        discard_tmp(tmp)
        return ErrorCode.IoError
    match rename(tmp, full)
        Ok(_) => ErrorCode.Ok
        Err(_) =>
            discard_tmp(tmp)
            ErrorCode.IoError

# Remove a half-written temp file. Best effort: the save has already failed,
# and that failure is what the caller hears about.
fn discard_tmp(tmp: StrView)
    match unlink(tmp)
        Ok(_) => pass
        Err(_) => pass

# ============================================================================
# Lock
# ============================================================================

# Take the exclusive writer lock for the store at `path`, waiting for any
# other holder. Returns the lock file for file_store_unlock, or a closed Fd
# (not valid()): the store path didn't fit in the buffer, or the lock
# couldn't be taken. Creates `<path>.lock` (empty, mode 0644) if missing and
# leaves it in place: removing it would let a waiter lock an unlinked inode
# while a newcomer locks a new one.
pub fn file_store_lock(path: StrView) -> Fd
    let lock_path: String = fs_path_join(path, ".lock")
    if lock_path.len() == 0
        return fd_adopt(-1)
    var f: Fd = fd_adopt(-1)
    match fd_open(lock_path.as_view(), O_RDWR + O_CREAT + O_CLOEXEC, 420)
        Ok(opened) => f = opened
        Err(_) => return fd_adopt(-1)
    match f.lock(LOCK_EX)
        Ok(_) => pass
        Err(_) =>
            f.close()
            return fd_adopt(-1)
    f

# Release a lock from file_store_lock (closing its fd drops the flock).
pub fn file_store_unlock(lock: @&Fd)
    lock.close()
