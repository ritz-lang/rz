# Goliath - Content-Addressable Filesystem
#
# Library re-exports for external use.

# Core types
pub import goliath.blob_id { BlobId, blob_id_compute, blob_id_eq, blob_id_is_zero, blob_id_zero, blob_id_empty }

# Error handling
pub import goliath.error { Error, ErrorCode }

# Storage backend
pub import goliath.blob_store { BlobStore, BlobStoreOps, MemoryBlobStore, memory_store_new, memory_store_put, memory_store_get, memory_store_exists, memory_store_delete, memory_store_init_ops, memory_store_as_store, store_exists, store_get, store_put, store_delete, store_count, store_total_size, store_free }

# VirtIO persistent storage (for Harland integration)
pub import virtio_store { VirtIOBlobStore, virtio_store_new, virtio_store_init_ops, virtio_store_as_store, Superblock, IndexEntry, GOLIATH_MAGIC, GOLIATH_VERSION }

# Directory entries
pub import goliath.dir_entry { DirEntry, EntryKind, Metadata, dir_entry_file, dir_entry_dir, dir_entry_is_file, dir_entry_is_dir }

# Namespace (path resolution)
pub import goliath.namespace { Namespace, namespace_new, namespace_read, namespace_write, namespace_mkdir, namespace_exists, namespace_list }

# Path utilities
pub import goliath.path { path_is_absolute, path_is_root, path_validate }

# CLI entry point.
#
# What works today is the library above (33 tests: `./rz test goliath`).
# There is no CLI yet (AGAST #2788): the planned commands fail with
# "not implemented" instead of printing a banner and exiting 0 (#2460).
import ritzlib.io { prints_cstr, eprints_cstr }
import ritzlib.str { streq }

fn print_usage()
    prints_cstr(c"Usage: goliath [--help] COMMAND [ARGS]\n")
    prints_cstr(c"\n")
    prints_cstr(c"Goliath is a content-addressable blob store library for Harland.\n")
    prints_cstr(c"Its commands are planned, not implemented (each exits 1):\n")
    prints_cstr(c"    put FILE     store FILE, print its blob id\n")
    prints_cstr(c"    get ID       write blob ID to stdout\n")
    prints_cstr(c"    ls PATH      list a namespace directory\n")

pub fn main(argc: i32, argv: **u8) -> i32
    if argc < 2
        eprints_cstr(c"Usage: goliath [--help] COMMAND [ARGS]\n")
        return 2

    let cmd: *u8 = argv[1]
    if streq(cmd, c"--help") != 0 or streq(cmd, c"-h") != 0
        print_usage()
        return 0
    if streq(cmd, c"put") != 0 or streq(cmd, c"get") != 0 or streq(cmd, c"ls") != 0
        eprints_cstr(c"goliath: ")
        eprints_cstr(cmd)
        eprints_cstr(c": not implemented (goliath is a library today; CLI is AGAST #2788)\n")
        return 1

    eprints_cstr(c"goliath: unknown command '")
    eprints_cstr(cmd)
    eprints_cstr(c"' (try --help)\n")
    2
