# Goliath - Content-Addressable Filesystem
#
# Library re-exports for external use.

# Core types
pub import goliath.blob_id { BlobId, blob_id_compute, blob_id_eq, blob_id_is_zero, blob_id_zero, blob_id_empty, blob_id_to_hex, blob_id_from_hex }

# Error handling
pub import goliath.error { Error, ErrorCode }

# Storage backend
pub import ritzlib.memory { Allocator }
pub import goliath.blob_store { MemoryBlobStore, memory_store_new_in, memory_store_put, memory_store_get, memory_store_exists, memory_store_retain, memory_store_release, memory_store_delete }
pub import goliath.hosted { hosted_allocator, memory_store_new }

# Host-file persistence (what the CLI uses)
pub import goliath.file_store { file_store_open, file_store_save, file_store_lock, file_store_unlock }

# The on-disk image, and a block device holding one (what the kernel uses)
pub import goliath.image { ImageSink, image_size, image_write, image_load }
pub import goliath.block_store { BlockDevice, block_store_save, block_store_load }

# Directory entries
pub import goliath.dir_entry { NsEntry, EntryKind, Metadata, dir_entry_file, dir_entry_dir, dir_entry_is_file, dir_entry_is_dir }

# Namespace (path resolution)
pub import goliath.namespace { Namespace, namespace_new, namespace_open, namespace_read, namespace_write, namespace_mkdir, namespace_delete, namespace_exists, namespace_list }

# Path utilities
pub import goliath.path { path_is_absolute, path_is_root, path_validate }

# CLI entry point (AGAST #2788).
#
#     goliath put FILE    store FILE's bytes, link them at /<basename of FILE>,
#                         print the blob id (the SHA-256 of the bytes)
#     goliath get ID      write blob ID's bytes to stdout
#     goliath ls PATH     list a directory ("ID  SIZE  NAME" per entry, a
#                         directory's NAME ending in /), or one file
#
# The store is one host file: $GOLIATH_STORE, or ./goliath.store. `put`
# rewrites it; `get` and `ls` only read it, and a missing store is empty.
# Exit status: 0 done, 1 failed, 2 usage error.
#
import ritzlib.fmt
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new }
import ritzlib.os.env { env_get_or }
import ritzlib.span { Span, Bytes, span_from_strview }
import ritzlib.fd { Fd, fd_stdout }
import ritzlib.fs { read_file }
import goliath.blob_id { BlobId, BLOB_ID_HEX_LEN, blob_id_compute, blob_id_eq, blob_id_is_zero, blob_id_to_hex, blob_id_from_hex }
import goliath.hosted { memory_store_new }
import goliath.blob_store { MemoryBlobStore, memory_store_exists, memory_store_get_span, memory_store_free }
import goliath.namespace { Namespace, namespace_resolve, namespace_write, namespace_list }
import goliath.dir_entry { NsEntry, dir_entry_is_dir, dir_entry_name, dir_entry_name_eq }
import goliath.path { path_is_absolute, path_is_root, path_validate, path_parent, path_leaf }
import goliath.error { ErrorCode }
import goliath.file_store { file_store_open, file_store_save, file_store_lock, file_store_unlock }

const CLI_MAX_ENTRIES: i32 = 256   # namespace.ritz's MAX_DIR_ENTRIES
const CLI_PATH_MAX: i64 = 4096

fn print_usage()
    print("Usage: goliath [--help] COMMAND [ARGS]\n")
    print("\n")
    print("Goliath is a content-addressable blob store. Commands:\n")
    print("    put FILE     store FILE as /<its name>, print its blob id\n")
    print("    get ID       write blob ID to stdout\n")
    print("    ls PATH      list a directory (ID  SIZE  NAME), or one file\n")
    print("\n")
    print("The store is the file $GOLIATH_STORE (default ./goliath.store).\n")

fn usage_error(msg: StrView) -> i32
    eprint("goliath: {msg}\nUsage: goliath [--help] COMMAND [ARGS] (try --help)\n")
    2

# "goliath: <cmd>: <what>: <msg>\n" on stderr; returns 1.
fn fail(cmd: StrView, what: StrView, msg: StrView) -> i32
    if what.len > 0
        eprint("goliath: {cmd}: {what}: {msg}\n")
    else
        eprint("goliath: {cmd}: {msg}\n")
    1

# $GOLIATH_STORE if set and non-empty, else ./goliath.store
fn store_path() -> StrView
    let v: StrView = env_get_or("GOLIATH_STORE", "")
    if v.len > 0
        return v
    "goliath.store"

# Open the store, or say why not (returns 1 then, else 0).
fn open_store(cmd: StrView, path: StrView, store: *MemoryBlobStore, ns: *Namespace) -> i32
    let rc: ErrorCode = file_store_open(path, store, ns)
    if rc == ErrorCode.Ok
        return 0
    if rc == ErrorCode.CorruptBlob
        return fail(cmd, path, "corrupt store file (not a goliath store, or damaged)")
    if rc == ErrorCode.PathTooLong
        return fail(cmd, path, "bad store path")
    fail(cmd, path, "cannot read store file")

fn print_hex_id(id: *BlobId)
    var hex: [65]u8
    blob_id_to_hex(id, @hex[0])
    let buf: [u8] = @hex
    let digits: [u8] = buf[0..BLOB_ID_HEX_LEN]
    let h: StrView = digits.as_strview()
    print("{h}")

# ============================================================================
# put FILE
# ============================================================================

fn cmd_put(file: StrView, store_file: StrView) -> i32
    if file.len >= CLI_PATH_MAX
        return fail("put", file, "path too long")
    let data: String = match read_file(file)
        Ok(bytes) => bytes
        Err(_) => return fail("put", file, "cannot read file")

    # Link it at /<basename>
    let name: StrView = path_leaf(file)
    if name.len == 0 or name.len > 255
        return fail("put", file, "no usable file name to store it under")
    var nspath: String = string_new()
    nspath.push_str("/")
    nspath.push_str(name)
    let path: StrView = nspath.as_view()
    if not path_validate(path)
        return fail("put", name, "not a valid goliath file name")

    # Hold the writer lock from load to save, so a concurrent put can't load
    # the same old store and rename its copy over ours (#3882)
    var lock: Fd = file_store_lock(store_file)
    if not lock.valid()
        return fail("put", store_file, "cannot lock store file")
    let rc: i32 = put_locked(file, path, data.as_view(), store_file)
    file_store_unlock(@&lock)
    rc

# cmd_put's read-modify-write, under the store lock.
fn put_locked(file: StrView, path: StrView, data: StrView, store_file: StrView) -> i32
    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace
    if open_store("put", store_file, @store, @ns) != 0
        memory_store_free(@store)
        return 1

    var id: BlobId = blob_id_compute(data.ptr, data.len as u64)
    # Already stored under that name: nothing to write
    var linked: BlobId = namespace_resolve(@ns, path)
    if not blob_id_eq(@linked, @id)
        let span: Span<u8> = span_from_strview(data)
        let wrc: ErrorCode = namespace_write(@ns, path, @span)
        if wrc != ErrorCode.Ok
            memory_store_free(@store)
            if wrc == ErrorCode.OutOfSpace
                return fail("put", path, "root directory is full")
            return fail("put", path, "cannot link it into the namespace")
        if file_store_save(store_file, @ns) != ErrorCode.Ok
            memory_store_free(@store)
            return fail("put", store_file, "cannot write store file")
    memory_store_free(@store)
    print_hex_id(@id)
    print("\n")
    0

# ============================================================================
# get ID
# ============================================================================

fn cmd_get(hex: StrView, store_file: StrView) -> i32
    var id: BlobId
    if not blob_id_from_hex(hex, @id)
        return fail("get", hex, "not a blob id (want 64 hex digits)")

    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace
    if open_store("get", store_file, @store, @ns) != 0
        memory_store_free(@store)
        return 1
    if not memory_store_exists(@store, @id)
        memory_store_free(@store)
        return fail("get", hex, "not found")

    match fd_stdout().write_all(memory_store_get_span(@store, @id))
        Ok(_) => pass
        Err(_) =>
            memory_store_free(@store)
            return fail("get", hex, "write to stdout failed")
    memory_store_free(@store)
    0

# ============================================================================
# ls PATH
# ============================================================================

fn print_entry(entry: *NsEntry)
    print_hex_id(@(*entry).blob_id)
    let size: i64 = (*entry).metadata.size as i64
    let name: StrView = dir_entry_name(entry)
    if dir_entry_is_dir(entry)
        print("  {size}  {name}/\n")
    else
        print("  {size}  {name}\n")

# Print every entry of the directory at `dir`. -1 if it isn't one.
fn list_dir(ns: *Namespace, dir: StrView, entries: *NsEntry) -> i32
    let n: i32 = namespace_list(ns, dir, entries, CLI_MAX_ENTRIES)
    if n < 0
        return -1
    var i: i32 = 0
    while i < n and i < CLI_MAX_ENTRIES
        print_entry(entries + i)
        i = i + 1
    0

fn cmd_ls(path: StrView, store_file: StrView) -> i32
    if not path_is_absolute(path)
        return fail("ls", path, "not an absolute path (goliath paths start with /)")
    if not path_validate(path)
        return fail("ls", path, "not a valid goliath path")

    var store: MemoryBlobStore = memory_store_new()
    var ns: Namespace
    if open_store("ls", store_file, @store, @ns) != 0
        memory_store_free(@store)
        return 1

    var entries: [256]NsEntry
    var rc: i32 = 0
    if path_is_root(path)
        if list_dir(@ns, path, @entries[0]) != 0
            rc = fail("ls", path, "cannot read directory")
    else
        # Find PATH's own entry in its parent: a directory is listed, a
        # file is printed as itself
        let parent: StrView = path_parent(path)
        let name: StrView = path_leaf(path)
        let n: i32 = namespace_list(@ns, parent, @entries[0], CLI_MAX_ENTRIES)
        var found: i32 = -1
        var i: i32 = 0
        while i < n and i < CLI_MAX_ENTRIES
            if dir_entry_name_eq(@entries[i], name)
                found = i
                break
            i = i + 1
        if found < 0
            rc = fail("ls", path, "not found")
        else if dir_entry_is_dir(@entries[found])
            if list_dir(@ns, path, @entries[0]) != 0
                rc = fail("ls", path, "cannot read directory")
        else
            print_entry(@entries[found])
    memory_store_free(@store)
    rc

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        return usage_error("no command")

    let cmd: StrView = args[1]
    if cmd.eq("--help") or cmd.eq("-h")
        print_usage()
        return 0

    let store_file: StrView = store_path()
    if cmd.eq("put")
        if args.len != 3
            return usage_error("put takes one FILE")
        return cmd_put(args[2], store_file)
    if cmd.eq("get")
        if args.len != 3
            return usage_error("get takes one blob ID")
        return cmd_get(args[2], store_file)
    if cmd.eq("ls")
        if args.len != 3
            return usage_error("ls takes one PATH")
        return cmd_ls(args[2], store_file)

    eprint("goliath: unknown command '{cmd}' (try --help)\n")
    2
