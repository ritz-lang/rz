# lib/css/parser.ritz - CSS Parser
#
# Parses CSS tokens into stylesheet, rules, selectors, and declarations.

import ritzlib.strview
import lib.css.token
import lib.css.tokenizer { CssTokenizer, css_tokenizer_new, css_tokenizer_next }
import lib.css.selector
import lib.css.value
import lib.css.rule

# =============================================================================
# Parser State
# =============================================================================

pub struct CssParser
    tokenizer: CssTokenizer
    current: CssToken
    rule_order: u32

# =============================================================================
# Initialization
# =============================================================================

pub fn css_parser_new(input: StrView) -> CssParser
    var p: CssParser
    p.tokenizer = css_tokenizer_new(input)
    p.current = css_tokenizer_next(p.tokenizer)
    p.rule_order = 0
    p

# =============================================================================
# Token Helpers
# =============================================================================

fn advance(p:& CssParser)
    p.current = css_tokenizer_next(p.tokenizer)

fn skip_whitespace(p:& CssParser)
    while p.current.kind == CSS_TOKEN_WHITESPACE
        advance(p)

fn expect(p:& CssParser, kind: i32) -> i32
    if p.current.kind == kind
        advance(p)
        return 1
    0

# =============================================================================
# Main Parsing Entry Point
# =============================================================================

pub fn css_parse_stylesheet(p:& CssParser) -> Stylesheet
    var sheet = stylesheet_new()

    loop
        skip_whitespace(p)

        if p.current.kind == CSS_TOKEN_EOF
            break

        if p.current.kind == CSS_TOKEN_CDO or p.current.kind == CSS_TOKEN_CDC
            # Skip HTML comment markers
            advance(p)
            continue

        if p.current.kind == CSS_TOKEN_AT_KEYWORD
            # Parse at-rule
            let at_rule = parse_at_rule(p)
            # For now, skip at-rules
            continue

        # Try to parse a style rule
        var style_rule = parse_style_rule(p)
        if style_rule.selectors.selector_count > 0
            let css_rule = css_rule_style(style_rule.selectors, style_rule.declarations, p.rule_order)
            if stylesheet_add_rule(sheet, @css_rule) == 1
                p.rule_order = p.rule_order + 1
            else
                selector_list_free(style_rule.selectors)
        else
            selector_list_free(style_rule.selectors)

    sheet

# =============================================================================
# Style Rule Parsing
# =============================================================================

fn parse_style_rule(p:& CssParser) -> StyleRule
    let selectors = parse_selector_list(p)

    skip_whitespace(p)

    var declarations = declaration_block_new()

    if p.current.kind == CSS_TOKEN_OPEN_CURLY
        advance(p)
        declarations = parse_declaration_block(p)

        skip_whitespace(p)
        if p.current.kind == CSS_TOKEN_CLOSE_CURLY
            advance(p)

    style_rule_new(selectors, declarations, 0)

# =============================================================================
# Selector Parsing
# =============================================================================

fn parse_selector_list(p:& CssParser) -> SelectorList
    var list = selector_list_new()

    loop
        skip_whitespace(p)

        let complex = parse_complex_selector(p)
        if complex.compound_count > 0
            selector_list_add(list, complex)

        skip_whitespace(p)

        if p.current.kind == CSS_TOKEN_COMMA
            advance(p)
            continue

        # End of selector list (hit { or other)
        break

    list

fn parse_complex_selector(p:& CssParser) -> ComplexSelector
    var complex = complex_selector_new()

    loop
        skip_whitespace(p)

        let compound = parse_compound_selector(p)
        if compound.simple_count == 0
            break

        # Determine combinator. Whitespace must be inspected *before* it is
        # consumed: it is either a descendant combinator or spacing around an
        # explicit one (>, +, ~). parse_compound_selector deliberately leaves
        # inter-compound whitespace in place for this step.
        var combinator = COMBINATOR_NONE

        if p.current.kind == CSS_TOKEN_WHITESPACE
            skip_whitespace(p)
            if is_selector_start(p) == 1
                combinator = COMBINATOR_DESCENDANT

        if combinator == COMBINATOR_NONE
            if p.current.kind == CSS_TOKEN_DELIM
                if p.current.delim == '>'
                    combinator = COMBINATOR_CHILD
                    advance(p)
                else if p.current.delim == '+'
                    combinator = COMBINATOR_NEXT_SIBLING
                    advance(p)
                else if p.current.delim == '~'
                    combinator = COMBINATOR_SUBSEQUENT_SIBLING
                    advance(p)
                else
                    # Some other delim, end of selector
                    complex_selector_add(complex, compound, COMBINATOR_NONE)
                    break

        complex_selector_add(complex, compound, combinator)

        # If no combinator and no whitespace, we're done
        if combinator == COMBINATOR_NONE
            break

    complex

fn parse_compound_selector(p:& CssParser) -> CompoundSelector
    var compound = compound_selector_new()

    loop
        # Do not skip whitespace here: it separates compounds and must reach
        # parse_complex_selector so it can become a descendant combinator.
        if p.current.kind == CSS_TOKEN_IDENT
            # Type selector
            let simple = simple_selector_type(css_token_value_str(p.current))
            compound_selector_add(compound, simple)
            advance(p)

        else if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '*'
            # Universal selector
            let simple = simple_selector_universal()
            compound_selector_add(compound, simple)
            advance(p)

        else if p.current.kind == CSS_TOKEN_HASH
            # ID selector
            let simple = simple_selector_id(css_token_value_str(p.current))
            compound_selector_add(compound, simple)
            advance(p)

        else if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '.'
            # Class selector
            advance(p)
            if p.current.kind == CSS_TOKEN_IDENT
                let simple = simple_selector_class(css_token_value_str(p.current))
                compound_selector_add(compound, simple)
                advance(p)

        else if p.current.kind == CSS_TOKEN_OPEN_SQUARE
            # Attribute selector
            let simple = parse_attribute_selector(p)
            compound_selector_add(compound, simple)

        else if p.current.kind == CSS_TOKEN_COLON
            # Pseudo-class or pseudo-element
            advance(p)
            if p.current.kind == CSS_TOKEN_COLON
                # ::pseudo-element
                advance(p)
                if p.current.kind == CSS_TOKEN_IDENT
                    var simple = simple_selector_universal()
                    simple.kind = SELECTOR_PSEUDO_ELEMENT
                    copy_token_value(simple, p.current)
                    compound_selector_add(compound, simple)
                    advance(p)
            else if p.current.kind == CSS_TOKEN_IDENT
                # :pseudo-class
                var simple = simple_selector_universal()
                simple.kind = SELECTOR_PSEUDO_CLASS
                copy_token_value(simple, p.current)
                compound_selector_add(compound, simple)
                advance(p)
            else if p.current.kind == CSS_TOKEN_FUNCTION
                # :pseudo-class(...)
                var simple = simple_selector_universal()
                simple.kind = SELECTOR_PSEUDO_CLASS
                copy_token_value(simple, p.current)
                advance(p)
                # Skip function contents for now
                skip_until_close_paren(p)
                compound_selector_add(compound, simple)

        else
            break

    compound

fn parse_attribute_selector(p:& CssParser) -> SimpleSelector
    var simple = simple_selector_universal()
    simple.kind = SELECTOR_ATTRIBUTE

    advance(p)  # [
    skip_whitespace(p)

    if p.current.kind == CSS_TOKEN_IDENT
        copy_token_value(simple, p.current)
        advance(p)

    skip_whitespace(p)

    # Check for matcher
    simple.attr_matcher = ATTR_EXISTS

    if p.current.kind == CSS_TOKEN_DELIM
        if p.current.delim == '='
            simple.attr_matcher = ATTR_EQUALS
            advance(p)
        else if p.current.delim == '~'
            advance(p)
            if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '='
                simple.attr_matcher = ATTR_INCLUDES
                advance(p)
        else if p.current.delim == '|'
            advance(p)
            if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '='
                simple.attr_matcher = ATTR_DASH_MATCH
                advance(p)
        else if p.current.delim == '^'
            advance(p)
            if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '='
                simple.attr_matcher = ATTR_PREFIX
                advance(p)
        else if p.current.delim == '$'
            advance(p)
            if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '='
                simple.attr_matcher = ATTR_SUFFIX
                advance(p)
        else if p.current.delim == '*'
            advance(p)
            if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '='
                simple.attr_matcher = ATTR_SUBSTRING
                advance(p)

    skip_whitespace(p)

    # Get value if present
    if simple.attr_matcher != ATTR_EXISTS
        if p.current.kind == CSS_TOKEN_IDENT or p.current.kind == CSS_TOKEN_STRING
            copy_token_to_attr_value(simple, p.current)
            advance(p)

    skip_whitespace(p)

    # Check for case-insensitive flag
    if p.current.kind == CSS_TOKEN_IDENT
        let s = css_token_value_str(p.current)
        if s.eq("i") or s.eq("I")
            simple.attr_case_insensitive = 1
            advance(p)

    skip_whitespace(p)

    if p.current.kind == CSS_TOKEN_CLOSE_SQUARE
        advance(p)

    simple

# =============================================================================
# Declaration Block Parsing
# =============================================================================

fn parse_declaration_block(p:& CssParser) -> DeclarationBlock
    var block = declaration_block_new()

    loop
        skip_whitespace(p)

        if p.current.kind == CSS_TOKEN_CLOSE_CURLY or p.current.kind == CSS_TOKEN_EOF
            break

        let decl = parse_declaration(p)
        if decl.property_len > 0
            declaration_block_add(block, decl)

        skip_whitespace(p)

        # Expect semicolon or end of block
        if p.current.kind == CSS_TOKEN_SEMICOLON
            advance(p)

    block

fn parse_declaration(p:& CssParser) -> Declaration
    var decl: Declaration
    decl.property_len = 0
    decl.important = 0

    skip_whitespace(p)

    # Property name
    if p.current.kind != CSS_TOKEN_IDENT
        # Skip to next semicolon or close curly
        skip_invalid_declaration(p)
        return decl

    let prop = css_token_value_str(p.current)
    copy_property_to_decl(decl, prop)
    advance(p)

    skip_whitespace(p)

    # Colon
    if p.current.kind != CSS_TOKEN_COLON
        # The property name was copied, but there is no value: leave
        # property_len at 0 so parse_declaration_block drops this unit
        # instead of storing a declaration with an uninitialised value.
        decl.property_len = 0
        skip_invalid_declaration(p)
        return decl
    advance(p)

    skip_whitespace(p)

    # Value
    decl.value = parse_value(p)

    # Check for !important
    if decl.value.important == 1
        decl.important = 1

    decl

# Consume the components of a multi-component value after the first one.
# CssValue has no component-list storage (AGAST #4400), so the extra
# components are discarded rather than re-parsed as declarations. Stop before
# an IDENT followed by ':' so a missing semicolon does not swallow the next
# declaration (test_recover_missing_semicolon), and always stop at a value
# terminator or '!important'.
fn skip_extra_value_components(p:& CssParser)
    loop
        skip_whitespace(p)

        if p.current.kind == CSS_TOKEN_EOF
            break
        if p.current.kind == CSS_TOKEN_SEMICOLON
            break
        if p.current.kind == CSS_TOKEN_CLOSE_CURLY
            break
        if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '!'
            break

        # Peek one token past an IDENT: IDENT ':' starts the next declaration.
        if p.current.kind == CSS_TOKEN_IDENT
            let save_t = p.tokenizer
            let save_c = p.current
            advance(p)
            skip_whitespace(p)
            var next_is_colon = 0
            if p.current.kind == CSS_TOKEN_COLON
                next_is_colon = 1
            p.tokenizer = save_t
            p.current = save_c
            if next_is_colon == 1
                break

        advance(p)

fn parse_value(p:& CssParser) -> CssValue
    skip_whitespace(p)

    var val: CssValue
    val.kind = CSS_VALUE_KEYWORD
    val.string_len = 0
    val.number = 0.0
    val.unit = UNIT_PX
    val.color_r = 0
    val.color_g = 0
    val.color_b = 0
    val.color_a = 255
    val.important = 0

    if p.current.kind == CSS_TOKEN_IDENT
        val = css_value_keyword(css_token_value_str(p.current))
        advance(p)

    else if p.current.kind == CSS_TOKEN_NUMBER
        val = css_value_number(p.current.number)
        advance(p)

    else if p.current.kind == CSS_TOKEN_DIMENSION
        let unit = parse_length_unit(css_token_value_str(p.current))
        val = css_value_length(p.current.number, unit)
        advance(p)

    else if p.current.kind == CSS_TOKEN_PERCENTAGE
        val = css_value_length(p.current.number, UNIT_PERCENT)
        advance(p)

    else if p.current.kind == CSS_TOKEN_HASH
        # Color
        val = parse_hex_color(p)

    else if p.current.kind == CSS_TOKEN_FUNCTION
        val = parse_function_value(p)

    else if p.current.kind == CSS_TOKEN_STRING
        val = css_value_string(css_token_value_str(p.current))
        advance(p)

    else if p.current.kind == CSS_TOKEN_URL
        val = css_value_url(css_token_value_str(p.current))
        advance(p)

    # Keep only the first component, but consume the rest of the value.
    skip_extra_value_components(p)

    # Check for !important
    skip_whitespace(p)
    if p.current.kind == CSS_TOKEN_DELIM and p.current.delim == '!'
        advance(p)
        skip_whitespace(p)
        if p.current.kind == CSS_TOKEN_IDENT
            let s = css_token_value_str(p.current)
            if s.eq("important")
                val.important = 1
                advance(p)

    val

fn parse_hex_color(p:& CssParser) -> CssValue
    let hex = css_token_value_str(p.current)
    advance(p)

    # Parse #RGB, #RGBA, #RRGGBB, #RRGGBBAA
    var r: u8 = 0
    var g: u8 = 0
    var b: u8 = 0
    var a: u8 = 255

    if hex.len == 3
        r = hex_digit(hex.ptr[0]) * 17
        g = hex_digit(hex.ptr[1]) * 17
        b = hex_digit(hex.ptr[2]) * 17
    else if hex.len == 4
        r = hex_digit(hex.ptr[0]) * 17
        g = hex_digit(hex.ptr[1]) * 17
        b = hex_digit(hex.ptr[2]) * 17
        a = hex_digit(hex.ptr[3]) * 17
    else if hex.len == 6
        r = hex_digit(hex.ptr[0]) * 16 + hex_digit(hex.ptr[1])
        g = hex_digit(hex.ptr[2]) * 16 + hex_digit(hex.ptr[3])
        b = hex_digit(hex.ptr[4]) * 16 + hex_digit(hex.ptr[5])
    else if hex.len == 8
        r = hex_digit(hex.ptr[0]) * 16 + hex_digit(hex.ptr[1])
        g = hex_digit(hex.ptr[2]) * 16 + hex_digit(hex.ptr[3])
        b = hex_digit(hex.ptr[4]) * 16 + hex_digit(hex.ptr[5])
        a = hex_digit(hex.ptr[6]) * 16 + hex_digit(hex.ptr[7])

    css_value_color_rgba(r, g, b, a)

pub fn hex_digit(c: u8) -> u8
    if c >= '0' and c <= '9'
        return c - 48
    if c >= 'A' and c <= 'F'
        return c - 55
    if c >= 'a' and c <= 'f'
        return c - 87
    0

fn parse_function_value(p:& CssParser) -> CssValue
    let name = css_token_value_str(p.current)
    advance(p)

    # Handle rgb() and rgba()
    if name.eq("rgb") or name.eq("rgba")
        return parse_rgb_function(p)

    # Skip other functions for now
    skip_until_close_paren(p)

    css_value_keyword("unset")

fn parse_rgb_function(p:& CssParser) -> CssValue
    skip_whitespace(p)

    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var a: f64 = 1.0

    # R
    if p.current.kind == CSS_TOKEN_NUMBER
        r = p.current.number
        advance(p)
    else if p.current.kind == CSS_TOKEN_PERCENTAGE
        r = p.current.number * 2.55
        advance(p)

    skip_whitespace(p)
    if p.current.kind == CSS_TOKEN_COMMA
        advance(p)
    skip_whitespace(p)

    # G
    if p.current.kind == CSS_TOKEN_NUMBER
        g = p.current.number
        advance(p)
    else if p.current.kind == CSS_TOKEN_PERCENTAGE
        g = p.current.number * 2.55
        advance(p)

    skip_whitespace(p)
    if p.current.kind == CSS_TOKEN_COMMA
        advance(p)
    skip_whitespace(p)

    # B
    if p.current.kind == CSS_TOKEN_NUMBER
        b = p.current.number
        advance(p)
    else if p.current.kind == CSS_TOKEN_PERCENTAGE
        b = p.current.number * 2.55
        advance(p)

    skip_whitespace(p)
    if p.current.kind == CSS_TOKEN_COMMA
        advance(p)
    skip_whitespace(p)

    # A (optional)
    if p.current.kind == CSS_TOKEN_NUMBER
        a = p.current.number
        advance(p)
    else if p.current.kind == CSS_TOKEN_PERCENTAGE
        a = p.current.number / 100.0
        advance(p)

    skip_whitespace(p)
    if p.current.kind == CSS_TOKEN_CLOSE_PAREN
        advance(p)

    css_value_color_rgba(r as u8, g as u8, b as u8, (a * 255.0) as u8)

# =============================================================================
# At-Rule Parsing (stub)
# =============================================================================

fn parse_at_rule(p:& CssParser) -> i32
    # Skip the at-keyword
    advance(p)

    # Skip until { or ;
    loop
        if p.current.kind == CSS_TOKEN_EOF
            break
        if p.current.kind == CSS_TOKEN_SEMICOLON
            advance(p)
            break
        if p.current.kind == CSS_TOKEN_OPEN_CURLY
            advance(p)
            skip_until_close_curly(p)
            break
        advance(p)

    0

# =============================================================================
# Helpers
# =============================================================================

fn is_selector_start(p: CssParser) -> i32
    if p.current.kind == CSS_TOKEN_IDENT
        return 1
    if p.current.kind == CSS_TOKEN_HASH
        return 1
    if p.current.kind == CSS_TOKEN_COLON
        return 1
    if p.current.kind == CSS_TOKEN_OPEN_SQUARE
        return 1
    if p.current.kind == CSS_TOKEN_DELIM
        if p.current.delim == '*' or p.current.delim == '.'
            return 1
    0

fn skip_until_close_paren(p:& CssParser)
    var depth = 1
    loop
        if p.current.kind == CSS_TOKEN_EOF
            break
        if p.current.kind == CSS_TOKEN_OPEN_PAREN
            depth = depth + 1
        if p.current.kind == CSS_TOKEN_CLOSE_PAREN
            depth = depth - 1
            if depth == 0
                advance(p)
                break
        advance(p)

fn skip_until_close_curly(p:& CssParser)
    var depth = 1
    loop
        if p.current.kind == CSS_TOKEN_EOF
            break
        if p.current.kind == CSS_TOKEN_OPEN_CURLY
            depth = depth + 1
        if p.current.kind == CSS_TOKEN_CLOSE_CURLY
            depth = depth - 1
            if depth == 0
                advance(p)
                break
        advance(p)

fn skip_invalid_declaration(p:& CssParser)
    loop
        if p.current.kind == CSS_TOKEN_EOF
            break
        if p.current.kind == CSS_TOKEN_SEMICOLON
            break
        if p.current.kind == CSS_TOKEN_CLOSE_CURLY
            break
        advance(p)

fn copy_token_value(simple:& SimpleSelector, tok: CssToken)
    var i: u32 = 0
    while i < tok.value_len and i < MAX_SELECTOR_VALUE_LEN
        simple.value[i] = tok.value[i]
        i = i + 1
    simple.value_len = i

fn copy_token_to_attr_value(simple:& SimpleSelector, tok: CssToken)
    var i: u32 = 0
    while i < tok.value_len and i < MAX_SELECTOR_VALUE_LEN
        simple.attr_value[i] = tok.value[i]
        i = i + 1
    simple.attr_value_len = i

fn copy_property_to_decl(decl:& Declaration, prop: StrView)
    var i: u64 = 0
    while i < prop.len and i < MAX_PROPERTY_NAME_LEN as u64
        decl.property[i] = prop.ptr[i]
        i = i + 1
    decl.property_len = i as u32
