# lib/html/tree_builder.ritz - HTML5 Tree Builder
#
# Implements HTML5 tree construction algorithm with insertion modes.
# Receives tokens from tokenizer, emits DOM events to Tempest.
#
# Reference: https://html.spec.whatwg.org/multipage/parsing.html#tree-construction

import ritzlib.strview
import lib.html.token { Token, TOKEN_START_TAG, TOKEN_END_TAG, TOKEN_CHARACTER, TOKEN_COMMENT, TOKEN_DOCTYPE, TOKEN_EOF }
import lib.dom.tag { Tag, tag_from_name, tag_is_void, tag_is_formatting, tag_is_special }
import lib.dom.attribute { Attribute }
import lib.event { EventSink, emit_document_start, emit_document_end, emit_element_start, emit_element_end, emit_text, emit_comment, emit_doctype }

# =============================================================================
# Insertion Modes
# =============================================================================

pub const MODE_INITIAL: i32 = 0
pub const MODE_BEFORE_HTML: i32 = 1
pub const MODE_BEFORE_HEAD: i32 = 2
pub const MODE_IN_HEAD: i32 = 3
pub const MODE_IN_HEAD_NOSCRIPT: i32 = 4
pub const MODE_AFTER_HEAD: i32 = 5
pub const MODE_IN_BODY: i32 = 6
pub const MODE_TEXT: i32 = 7
pub const MODE_IN_TABLE: i32 = 8
pub const MODE_IN_TABLE_TEXT: i32 = 9
pub const MODE_IN_CAPTION: i32 = 10
pub const MODE_IN_COLUMN_GROUP: i32 = 11
pub const MODE_IN_TABLE_BODY: i32 = 12
pub const MODE_IN_ROW: i32 = 13
pub const MODE_IN_CELL: i32 = 14
pub const MODE_IN_SELECT: i32 = 15
pub const MODE_IN_SELECT_IN_TABLE: i32 = 16
pub const MODE_IN_TEMPLATE: i32 = 17
pub const MODE_AFTER_BODY: i32 = 18
pub const MODE_IN_FRAMESET: i32 = 19
pub const MODE_AFTER_FRAMESET: i32 = 20
pub const MODE_AFTER_AFTER_BODY: i32 = 21
pub const MODE_AFTER_AFTER_FRAMESET: i32 = 22

# =============================================================================
# Stack Entry
# =============================================================================

const MAX_STACK_DEPTH: u32 = 512

pub struct StackEntry
    tag: Tag
    # TODO: namespace for SVG/MathML

# =============================================================================
# Active Formatting Elements
# =============================================================================

const MAX_FORMATTING_ELEMENTS: u32 = 128

pub const FORMATTING_MARKER: i32 = 0
pub const FORMATTING_ELEMENT: i32 = 1

pub struct FormattingEntry
    kind: i32               # FORMATTING_MARKER or FORMATTING_ELEMENT
    tag: Tag
    attrs: *Attribute
    attr_count: u32

# =============================================================================
# Tree Builder State
# =============================================================================

pub struct TreeBuilder<S: EventSink>
    # Event sink for DOM events, owned by value (a concrete type: R55)
    sink: S

    # Current insertion mode
    mode: i32
    original_mode: i32      # For returning from TEXT mode

    # Stack of open elements
    stack: [MAX_STACK_DEPTH]StackEntry
    stack_len: u32

    # Active formatting elements
    formatting: [MAX_FORMATTING_ELEMENTS]FormattingEntry
    formatting_len: u32

    # Special pointers
    head_element_idx: i32   # -1 if not set
    form_element_idx: i32   # -1 if not set

    # Flags
    frameset_ok: i32
    scripting: i32          # Is scripting enabled?
    fragment_context: i32   # Are we parsing a fragment?

    # Pending text accumulator
    pending_text: [4096]u8
    pending_text_len: u32

# =============================================================================
# Initialization
# =============================================================================

pub fn tree_builder_new<S: EventSink>(sink: S) -> TreeBuilder<S>
    var tb: TreeBuilder<S>

    tb.sink = sink
    tb.mode = MODE_INITIAL
    tb.original_mode = MODE_INITIAL
    tb.stack_len = 0
    tb.formatting_len = 0
    tb.head_element_idx = -1
    tb.form_element_idx = -1
    tb.frameset_ok = 1
    tb.scripting = 0
    tb.fragment_context = 0
    tb.pending_text_len = 0

    tb

# =============================================================================
# Stack Operations
# =============================================================================

fn push_element<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag)
    if tb.stack_len < MAX_STACK_DEPTH
        tb.stack[tb.stack_len].tag = tag
        tb.stack_len = tb.stack_len + 1

fn pop_element<S: EventSink>(tb:& TreeBuilder<S>) -> Tag
    if tb.stack_len > 0
        tb.stack_len = tb.stack_len - 1
        return tb.stack[tb.stack_len].tag
    Tag.Unknown("")

fn current_node<S: EventSink>(tb: @TreeBuilder<S>) -> Tag
    if tb.stack_len > 0
        return tb.stack[tb.stack_len - 1].tag
    Tag.Unknown("")

fn stack_has_element_in_scope<S: EventSink>(tb: @TreeBuilder<S>, target: Tag) -> i32
    # Walk stack from top, check if target is in scope
    # Scope is bounded by certain elements (table, html, etc.)
    # TODO: Implement proper scope checking
    var i = tb.stack_len
    while i > 0
        i = i - 1
        # Simplified: just check if tag matches
        # Real impl needs scope boundary checking
        # if tb.stack[i].tag is target
        #     return 1
        pass  # placeholder

    0

# =============================================================================
# Formatting Elements
# =============================================================================

fn push_formatting_element<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, attrs: *Attribute, attr_count: u32)
    if tb.formatting_len < MAX_FORMATTING_ELEMENTS
        tb.formatting[tb.formatting_len].kind = FORMATTING_ELEMENT
        tb.formatting[tb.formatting_len].tag = tag
        tb.formatting[tb.formatting_len].attrs = attrs
        tb.formatting[tb.formatting_len].attr_count = attr_count
        tb.formatting_len = tb.formatting_len + 1

fn push_formatting_marker<S: EventSink>(tb:& TreeBuilder<S>)
    if tb.formatting_len < MAX_FORMATTING_ELEMENTS
        tb.formatting[tb.formatting_len].kind = FORMATTING_MARKER
        tb.formatting_len = tb.formatting_len + 1

fn clear_formatting_to_marker<S: EventSink>(tb:& TreeBuilder<S>)
    while tb.formatting_len > 0
        tb.formatting_len = tb.formatting_len - 1
        if tb.formatting[tb.formatting_len].kind == FORMATTING_MARKER
            break

fn reconstruct_active_formatting<S: EventSink>(tb:& TreeBuilder<S>)
    # TODO: Implement adoption agency adjacent algorithm
    # For now, stub
    pass

# =============================================================================
# Pending Text
# =============================================================================

fn flush_pending_text<S: EventSink>(tb:& TreeBuilder<S>)
    if tb.pending_text_len > 0
        let text = StrView {
            ptr: @tb.pending_text[0],
            len: tb.pending_text_len as u64
        }
        emit_text(tb.sink, text)
        tb.pending_text_len = 0

fn append_pending_text<S: EventSink>(tb:& TreeBuilder<S>, c: u8)
    if tb.pending_text_len < 4096
        tb.pending_text[tb.pending_text_len] = c
        tb.pending_text_len = tb.pending_text_len + 1

# =============================================================================
# Token Processing - Main Entry Point
# =============================================================================

pub fn tree_builder_process_token<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    match tb.mode
        MODE_INITIAL => process_initial(tb, token)
        MODE_BEFORE_HTML => process_before_html(tb, token)
        MODE_BEFORE_HEAD => process_before_head(tb, token)
        MODE_IN_HEAD => process_in_head(tb, token)
        MODE_AFTER_HEAD => process_after_head(tb, token)
        MODE_IN_BODY => process_in_body(tb, token)
        MODE_TEXT => process_text(tb, token)
        MODE_IN_TABLE => process_in_table(tb, token)
        MODE_IN_TABLE_BODY => process_in_table_body(tb, token)
        MODE_IN_ROW => process_in_row(tb, token)
        MODE_IN_CELL => process_in_cell(tb, token)
        MODE_IN_SELECT => process_in_select(tb, token)
        MODE_AFTER_BODY => process_after_body(tb, token)
        MODE_AFTER_AFTER_BODY => process_after_after_body(tb, token)
        _ => process_in_body(tb, token)  # Default fallback

# =============================================================================
# Insertion Mode Handlers
# =============================================================================

fn process_initial<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_DOCTYPE
        emit_doctype(tb.sink, token.doctype.name, token.doctype.public_id, token.doctype.system_id)
        tb.mode = MODE_BEFORE_HTML
    else if token.kind == TOKEN_CHARACTER
        # Ignore whitespace
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            return
        # Otherwise, reprocess in before_html
        tb.mode = MODE_BEFORE_HTML
        process_before_html(tb, token)
    else
        # Missing DOCTYPE, but continue anyway
        tb.mode = MODE_BEFORE_HTML
        process_before_html(tb, token)

fn process_before_html<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return
    else if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            return  # Ignore whitespace
        # Fall through to insert html element
        insert_html_element(tb)
        tb.mode = MODE_BEFORE_HEAD
        process_before_head(tb, token)
    else if token.kind == TOKEN_START_TAG
        if (token.start_tag.name).eq("html")
            emit_element_start(tb.sink, Tag.Html, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Html)
            tb.mode = MODE_BEFORE_HEAD
        else
            insert_html_element(tb)
            tb.mode = MODE_BEFORE_HEAD
            process_before_head(tb, token)
    else if token.kind == TOKEN_END_TAG
        let name = token.end_tag.name
        if name.eq("head") or name.eq("body") or name.eq("html") or name.eq("br")
            insert_html_element(tb)
            tb.mode = MODE_BEFORE_HEAD
            process_before_head(tb, token)
        # else: parse error, ignore
    else if token.kind == TOKEN_EOF
        insert_html_element(tb)
        tb.mode = MODE_BEFORE_HEAD
        process_before_head(tb, token)

fn insert_html_element<S: EventSink>(tb:& TreeBuilder<S>)
    emit_element_start(tb.sink, Tag.Html, null, 0, 0)
    push_element(tb, Tag.Html)

fn process_before_head<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            return
        # Fall through
        insert_head_element(tb)
        tb.mode = MODE_IN_HEAD
        process_in_head(tb, token)
    else if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return
    else if token.kind == TOKEN_START_TAG
        if (token.start_tag.name).eq("html")
            process_in_body(tb, token)
        else if (token.start_tag.name).eq("head")
            emit_element_start(tb.sink, Tag.Head, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Head)
            tb.head_element_idx = tb.stack_len as i32 - 1
            tb.mode = MODE_IN_HEAD
        else
            insert_head_element(tb)
            tb.mode = MODE_IN_HEAD
            process_in_head(tb, token)
    else if token.kind == TOKEN_END_TAG
        let name = token.end_tag.name
        if name.eq("head") or name.eq("body") or name.eq("html") or name.eq("br")
            insert_head_element(tb)
            tb.mode = MODE_IN_HEAD
            process_in_head(tb, token)
    else
        insert_head_element(tb)
        tb.mode = MODE_IN_HEAD
        process_in_head(tb, token)

fn insert_head_element<S: EventSink>(tb:& TreeBuilder<S>)
    emit_element_start(tb.sink, Tag.Head, null, 0, 0)
    push_element(tb, Tag.Head)
    tb.head_element_idx = tb.stack_len as i32 - 1

fn process_in_head<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            append_pending_text(tb, c as u8)
            return
        # Non-whitespace falls through
        pop_head_and_continue(tb, token)
    else if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return
    else if token.kind == TOKEN_START_TAG
        let name = token.start_tag.name
        let tag = tag_from_name(name)

        if name.eq("html")
            process_in_body(tb, token)
        else if name.eq("base") or name.eq("basefont") or name.eq("bgsound") or name.eq("link")
            # Self-closing head elements
            emit_element_start(tb.sink, tag, token.start_tag.attrs, token.start_tag.attr_count, 1)
        else if name.eq("meta")
            emit_element_start(tb.sink, Tag.Meta, token.start_tag.attrs, token.start_tag.attr_count, 1)
        else if name.eq("title")
            # Parse RCDATA
            emit_element_start(tb.sink, Tag.Title, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Title)
            # TODO: Switch tokenizer to RCDATA mode
            tb.original_mode = MODE_IN_HEAD
            tb.mode = MODE_TEXT
        else if name.eq("style")
            emit_element_start(tb.sink, Tag.Style, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Style)
            tb.original_mode = MODE_IN_HEAD
            tb.mode = MODE_TEXT
        else if name.eq("script")
            emit_element_start(tb.sink, Tag.Script, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Script)
            tb.original_mode = MODE_IN_HEAD
            tb.mode = MODE_TEXT
        else if name.eq("noscript")
            if tb.scripting == 1
                # TODO: Handle scripting enabled case
                pass
            else
                emit_element_start(tb.sink, Tag.Noscript, token.start_tag.attrs, token.start_tag.attr_count, 0)
                push_element(tb, Tag.Noscript)
                tb.mode = MODE_IN_HEAD_NOSCRIPT
        else if name.eq("head")
            # Parse error, ignore
            return
        else
            pop_head_and_continue(tb, token)

    else if token.kind == TOKEN_END_TAG
        let name = token.end_tag.name
        if name.eq("head")
            flush_pending_text(tb)
            emit_element_end(tb.sink, Tag.Head)
            pop_element(tb)
            tb.mode = MODE_AFTER_HEAD
        else if name.eq("body") or name.eq("html") or name.eq("br")
            pop_head_and_continue(tb, token)
        else
            # Parse error, ignore
            return
    else
        pop_head_and_continue(tb, token)

fn pop_head_and_continue<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    flush_pending_text(tb)
    emit_element_end(tb.sink, Tag.Head)
    pop_element(tb)
    tb.mode = MODE_AFTER_HEAD
    process_after_head(tb, token)

fn process_after_head<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            append_pending_text(tb, c as u8)
            return
        insert_body_and_continue(tb, token)
    else if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return
    else if token.kind == TOKEN_START_TAG
        let name = token.start_tag.name
        if name.eq("html")
            process_in_body(tb, token)
        else if name.eq("body")
            flush_pending_text(tb)
            emit_element_start(tb.sink, Tag.Body, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Body)
            tb.frameset_ok = 0
            tb.mode = MODE_IN_BODY
        else if name.eq("frameset")
            flush_pending_text(tb)
            emit_element_start(tb.sink, Tag.Frameset, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Frameset)
            tb.mode = MODE_IN_FRAMESET
        else if name.eq("base") or name.eq("basefont") or name.eq("bgsound") or name.eq("link") or name.eq("meta") or name.eq("noframes") or name.eq("script") or name.eq("style") or name.eq("template") or name.eq("title")
            # Parse error: element in wrong place
            # Push back to head and process
            tb.mode = MODE_IN_HEAD
            process_in_head(tb, token)
        else if name.eq("head")
            # Parse error, ignore
            return
        else
            insert_body_and_continue(tb, token)
    else if token.kind == TOKEN_END_TAG
        let name = token.end_tag.name
        if name.eq("template")
            process_in_head(tb, token)
        else if name.eq("body") or name.eq("html") or name.eq("br")
            insert_body_and_continue(tb, token)
        else
            # Parse error, ignore
            return
    else
        insert_body_and_continue(tb, token)

fn insert_body_and_continue<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    flush_pending_text(tb)
    emit_element_start(tb.sink, Tag.Body, null, 0, 0)
    push_element(tb, Tag.Body)
    tb.frameset_ok = 1
    tb.mode = MODE_IN_BODY
    process_in_body(tb, token)

fn process_in_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == 0
            # Parse error, ignore null
            return
        reconstruct_active_formatting(tb)
        append_pending_text(tb, c as u8)
        if c != ' ' and c != '\t' and c != '\n' and c != '\r' and c != 12  # 12 = form feed (no '\f' escape)
            tb.frameset_ok = 0

    else if token.kind == TOKEN_COMMENT
        flush_pending_text(tb)
        emit_comment(tb.sink, token.comment.data)

    else if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return

    else if token.kind == TOKEN_START_TAG
        flush_pending_text(tb)
        process_start_tag_in_body(tb, token)

    else if token.kind == TOKEN_END_TAG
        flush_pending_text(tb)
        process_end_tag_in_body(tb, token)

    else if token.kind == TOKEN_EOF
        flush_pending_text(tb)
        # Check for unclosed elements
        # For now, just emit document end
        close_all_elements(tb)

# What a start tag does in "in body", by name: the spec groups by name, and
# "keygen" (a group member) has no Tag variant.
enum BodyStart
    Ignore          # html, body, frameset: attributes not merged yet
    HeadContent     # processed as in "in head"
    Block           # closes an open <p>, then opens
    Pre             # Block, and frameset_ok = 0
    Form
    ListItem        # li, dd, dt
    Formatting      # a, b, ..., nobr: joins the active formatting list
    Table
    Void            # area, br, ..., input: self-closing, not pushed
    Hr
    Textarea
    Iframe
    Select
    Option          # optgroup, option
    Generic

fn body_start_kind(name: StrView) -> BodyStart
    match name
        "html" | "body" | "frameset" => BodyStart.Ignore
        "base" | "basefont" | "bgsound" | "link" | "meta" => BodyStart.HeadContent
        "noframes" | "script" | "style" | "template" | "title" => BodyStart.HeadContent
        "address" | "article" | "aside" | "blockquote" | "center" | "details" => BodyStart.Block
        "dialog" | "dir" | "div" | "dl" | "fieldset" | "figcaption" | "figure" => BodyStart.Block
        "footer" | "header" | "hgroup" | "main" | "menu" | "nav" | "ol" | "p" => BodyStart.Block
        "search" | "section" | "summary" | "ul" => BodyStart.Block
        "h1" | "h2" | "h3" | "h4" | "h5" | "h6" => BodyStart.Block
        "pre" | "listing" => BodyStart.Pre
        "form" => BodyStart.Form
        "li" | "dd" | "dt" => BodyStart.ListItem
        "a" | "b" | "big" | "code" | "em" | "font" | "i" | "nobr" => BodyStart.Formatting
        "s" | "small" | "strike" | "strong" | "tt" | "u" => BodyStart.Formatting
        "table" => BodyStart.Table
        "area" | "br" | "embed" | "img" | "keygen" | "wbr" | "input" => BodyStart.Void
        "hr" => BodyStart.Hr
        "textarea" => BodyStart.Textarea
        "iframe" => BodyStart.Iframe
        "select" => BodyStart.Select
        "optgroup" | "option" => BodyStart.Option
        _ => BodyStart.Generic

fn process_start_tag_in_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    let tag = tag_from_name(token.start_tag.name)
    match body_start_kind(token.start_tag.name)
        BodyStart.Ignore => return
        BodyStart.HeadContent => process_in_head(tb, token)
        BodyStart.Block => start_block(tb, tag, token)
        BodyStart.Pre => start_pre(tb, tag, token)
        BodyStart.Form => start_form(tb, token)
        BodyStart.ListItem => start_list_item(tb, tag, token)
        BodyStart.Formatting => start_formatting(tb, tag, token)
        BodyStart.Table => start_table(tb, token)
        BodyStart.Void => start_void(tb, tag, token)
        BodyStart.Hr => start_hr(tb, token)
        BodyStart.Textarea => start_textarea(tb, token)
        BodyStart.Iframe => start_iframe(tb, token)
        BodyStart.Select => start_select(tb, token)
        BodyStart.Option => open_element(tb, tag, token)
        BodyStart.Generic => start_generic(tb, tag, token)

# Emit the start tag as `tag` and push it on the stack of open elements.
fn open_element<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    emit_element_start(tb.sink, tag, token.start_tag.attrs, token.start_tag.attr_count, 0)
    push_element(tb, tag)

# Emit the start tag as a self-closing `tag`; nothing is pushed.
fn emit_void<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    emit_element_start(tb.sink, tag, token.start_tag.attrs, token.start_tag.attr_count, 1)
    tb.frameset_ok = 0

fn close_p_in_button_scope<S: EventSink>(tb:& TreeBuilder<S>)
    if has_p_in_button_scope(@tb) == 1
        close_p_element(tb)

# address, article, ..., h1-h6: close an open <p>, then open.
fn start_block<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    close_p_in_button_scope(tb)
    open_element(tb, tag, token)

fn start_pre<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    start_block(tb, tag, token)
    tb.frameset_ok = 0
    # TODO: Skip next newline

fn start_form<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if tb.form_element_idx >= 0 and stack_has_template(@tb) == 0
        # Parse error, ignore
        return
    start_block(tb, Tag.Form, token)
    if stack_has_template(@tb) == 0
        tb.form_element_idx = tb.stack_len as i32 - 1

fn start_list_item<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    tb.frameset_ok = 0
    # TODO: Close a previous <li> / <dd> / <dt> if any
    start_block(tb, tag, token)

fn start_formatting<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    # TODO: <a>: check for an existing <a> in the formatting list; <nobr>:
    # check for nobr in scope and run the adoption agency
    reconstruct_active_formatting(tb)
    open_element(tb, tag, token)
    push_formatting_element(tb, tag, token.start_tag.attrs, token.start_tag.attr_count)

fn start_table<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Close <p> in button scope only if not quirks mode
    start_block(tb, Tag.Table, token)
    tb.frameset_ok = 0
    tb.mode = MODE_IN_TABLE

fn start_void<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    # TODO: <input type=hidden> leaves frameset_ok alone
    reconstruct_active_formatting(tb)
    emit_void(tb, tag, token)

fn start_hr<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    close_p_in_button_scope(tb)
    emit_void(tb, Tag.Hr, token)

fn start_textarea<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    open_element(tb, Tag.Textarea, token)
    # TODO: Skip next newline, switch to RCDATA
    tb.frameset_ok = 0
    tb.original_mode = tb.mode
    tb.mode = MODE_TEXT

fn start_iframe<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    tb.frameset_ok = 0
    open_element(tb, Tag.Iframe, token)
    tb.original_mode = tb.mode
    tb.mode = MODE_TEXT

fn start_select<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    reconstruct_active_formatting(tb)
    open_element(tb, Tag.Select, token)
    tb.frameset_ok = 0
    if tb.mode == MODE_IN_TABLE or tb.mode == MODE_IN_CAPTION or tb.mode == MODE_IN_TABLE_BODY or tb.mode == MODE_IN_ROW or tb.mode == MODE_IN_CELL
        tb.mode = MODE_IN_SELECT_IN_TABLE
    else
        tb.mode = MODE_IN_SELECT

fn start_generic<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag, token: Token)
    reconstruct_active_formatting(tb)
    open_element(tb, tag, token)

fn process_end_tag_in_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    let name = token.end_tag.name
    let tag = tag_from_name(name)

    if name.eq("template")
        process_in_head(tb, token)

    else if name.eq("body")
        if stack_has_element_in_scope(@tb, Tag.Body) == 0
            # Parse error, ignore
            return
        tb.mode = MODE_AFTER_BODY

    else if name.eq("html")
        if stack_has_element_in_scope(@tb, Tag.Body) == 0
            return
        tb.mode = MODE_AFTER_BODY
        process_after_body(tb, token)

    else if name.eq("address") or name.eq("article") or name.eq("aside") or name.eq("blockquote") or name.eq("button") or name.eq("center") or name.eq("details") or name.eq("dialog") or name.eq("dir") or name.eq("div") or name.eq("dl") or name.eq("fieldset") or name.eq("figcaption") or name.eq("figure") or name.eq("footer") or name.eq("header") or name.eq("hgroup") or name.eq("listing") or name.eq("main") or name.eq("menu") or name.eq("nav") or name.eq("ol") or name.eq("pre") or name.eq("search") or name.eq("section") or name.eq("summary") or name.eq("ul")
        # Close element
        if stack_has_element_in_scope(@tb, tag) == 0
            # Parse error, ignore
            return
        # Pop until we find matching tag
        close_element(tb, tag)

    else if name.eq("form")
        # Complex form handling
        if stack_has_template(@tb) == 0
            # No template case
            tb.form_element_idx = -1
        close_element(tb, Tag.Form)

    else if name.eq("p")
        if has_p_in_button_scope(@tb) == 0
            # Parse error, insert empty p
            emit_element_start(tb.sink, Tag.P, null, 0, 0)
            push_element(tb, Tag.P)
        close_p_element(tb)

    else if name.eq("li")
        if stack_has_element_in_list_scope(@tb, Tag.Li) == 0
            return
        close_element(tb, Tag.Li)

    else if name.eq("dd") or name.eq("dt")
        if stack_has_element_in_scope(@tb, tag) == 0
            return
        close_element(tb, tag)

    else if name.eq("h1") or name.eq("h2") or name.eq("h3") or name.eq("h4") or name.eq("h5") or name.eq("h6")
        # Check if any h1-h6 in scope
        close_element(tb, tag)

    else if name.eq("a") or name.eq("b") or name.eq("big") or name.eq("code") or name.eq("em") or name.eq("font") or name.eq("i") or name.eq("nobr") or name.eq("s") or name.eq("small") or name.eq("strike") or name.eq("strong") or name.eq("tt") or name.eq("u")
        # Adoption agency algorithm
        run_adoption_agency(tb, tag)

    else if name.eq("br")
        # Parse error: </br> treated as <br>
        reconstruct_active_formatting(tb)
        emit_element_start(tb.sink, Tag.Br, null, 0, 1)
        tb.frameset_ok = 0

    else
        # Any other end tag - walk up stack
        close_element_any(tb, tag)

fn process_text<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        append_pending_text(tb, token.character.char as u8)
    else if token.kind == TOKEN_EOF
        # Parse error
        flush_pending_text(tb)
        pop_element(tb)
        tb.mode = tb.original_mode
        tree_builder_process_token(tb, token)
    else if token.kind == TOKEN_END_TAG
        flush_pending_text(tb)
        let tag = current_node(@tb)
        emit_element_end(tb.sink, tag)
        pop_element(tb)
        tb.mode = tb.original_mode

fn process_in_table<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Implement table parsing
    # For now, foster parent into body
    process_in_body(tb, token)

fn process_in_table_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Implement
    process_in_body(tb, token)

fn process_in_row<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Implement
    process_in_body(tb, token)

fn process_in_cell<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Implement
    process_in_body(tb, token)

fn process_in_select<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    # TODO: Implement
    if token.kind == TOKEN_CHARACTER
        append_pending_text(tb, token.character.char as u8)
    else if token.kind == TOKEN_START_TAG
        let name = token.start_tag.name
        if name.eq("option")
            # Close previous option
            emit_element_start(tb.sink, Tag.Option, token.start_tag.attrs, token.start_tag.attr_count, 0)
            push_element(tb, Tag.Option)
    else if token.kind == TOKEN_END_TAG
        let name = token.end_tag.name
        if name.eq("select")
            flush_pending_text(tb)
            close_element(tb, Tag.Select)
            tb.mode = MODE_IN_BODY

fn process_after_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            process_in_body(tb, token)
            return
        tb.mode = MODE_IN_BODY
        process_in_body(tb, token)
    else if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_DOCTYPE
        # Parse error, ignore
        return
    else if token.kind == TOKEN_START_TAG
        if (token.start_tag.name).eq("html")
            process_in_body(tb, token)
        else
            tb.mode = MODE_IN_BODY
            process_in_body(tb, token)
    else if token.kind == TOKEN_END_TAG
        if (token.end_tag.name).eq("html")
            tb.mode = MODE_AFTER_AFTER_BODY
        else
            tb.mode = MODE_IN_BODY
            process_in_body(tb, token)
    else if token.kind == TOKEN_EOF
        close_all_elements(tb)

fn process_after_after_body<S: EventSink>(tb:& TreeBuilder<S>, token: Token)
    if token.kind == TOKEN_COMMENT
        emit_comment(tb.sink, token.comment.data)
    else if token.kind == TOKEN_DOCTYPE
        process_in_body(tb, token)
    else if token.kind == TOKEN_CHARACTER
        let c = token.character.char
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12  # 12 = form feed (no '\f' escape)
            process_in_body(tb, token)
            return
        tb.mode = MODE_IN_BODY
        process_in_body(tb, token)
    else if token.kind == TOKEN_START_TAG
        if (token.start_tag.name).eq("html")
            process_in_body(tb, token)
        else
            tb.mode = MODE_IN_BODY
            process_in_body(tb, token)
    else if token.kind == TOKEN_EOF
        close_all_elements(tb)

# =============================================================================
# Helper Functions
# =============================================================================

fn has_p_in_button_scope<S: EventSink>(tb: @TreeBuilder<S>) -> i32
    # Walk stack looking for <p>, bounded by button scope elements
    var i = tb.stack_len
    while i > 0
        i = i - 1
        let kind = button_scope_kind(tb.stack[i].tag)
        if kind == 1
            return 1
        if kind == 2
            return 0
    0

# For has_p_in_button_scope (variant-only): 1 = <p>, 2 = scope boundary
fn button_scope_kind(tag: Tag) -> i32
    match tag
        Tag.P => 1
        Tag.Button => 2
        Tag.Address => 2
        Tag.Div => 2
        _ => 0

fn stack_has_template<S: EventSink>(tb: @TreeBuilder<S>) -> i32
    var i = tb.stack_len
    while i > 0
        i = i - 1
        if tag_is_template(tb.stack[i].tag)
            return 1
    0

# Variant-only test (no payload to compare).
fn tag_is_template(tag: Tag) -> bool
    match tag
        Tag.Template => true
        _ => false

fn tag_is_p(tag: Tag) -> bool
    match tag
        Tag.P => true
        _ => false

fn stack_has_element_in_list_scope<S: EventSink>(tb: @TreeBuilder<S>, target: Tag) -> i32
    # Similar to scope but with list-specific boundaries
    stack_has_element_in_scope(tb, target)

fn close_p_element<S: EventSink>(tb:& TreeBuilder<S>)
    # Pop elements until we pop <p>
    emit_element_end(tb.sink, Tag.P)
    while tb.stack_len > 0
        let tag = pop_element(tb)
        if tag_is_p(tag)
            break
        else
            emit_element_end(tb.sink, tag)

fn close_element<S: EventSink>(tb:& TreeBuilder<S>, target: Tag)
    # Pop until we find target
    while tb.stack_len > 0
        let tag = current_node(@tb)
        emit_element_end(tb.sink, tag)
        pop_element(tb)
        # TODO: proper tag comparison
        break  # Simplified

fn close_element_any<S: EventSink>(tb:& TreeBuilder<S>, target: Tag)
    # Walk up stack, pop if found
    close_element(tb, target)

fn run_adoption_agency<S: EventSink>(tb:& TreeBuilder<S>, tag: Tag)
    # TODO: Implement full adoption agency algorithm
    # For now, just close the element
    close_element(tb, tag)

fn close_all_elements<S: EventSink>(tb:& TreeBuilder<S>)
    while tb.stack_len > 0
        let tag = pop_element(tb)
        emit_element_end(tb.sink, tag)
    emit_document_end(tb.sink)

# =============================================================================
# High-Level API
# =============================================================================

pub fn tree_builder_finish<S: EventSink>(tb:& TreeBuilder<S>)
    flush_pending_text(tb)
    close_all_elements(tb)
