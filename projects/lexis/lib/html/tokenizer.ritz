# lib/html/tokenizer.ritz - HTML5 Tokenizer
#
# A streaming state machine tokenizer implementing the HTML5 parsing spec.
# Converts a character stream into HTML tokens.
#
# Reference: https://html.spec.whatwg.org/multipage/parsing.html#tokenization

import lib.html.token
import lib.dom.attribute { Attribute, attribute_new }

# =============================================================================
# Tokenizer States
# =============================================================================

# One variant per state of the HTML5 tokenization spec (13.2.5). Each
# implemented state has its own `state_*` fn; `step` dispatches on it.
pub enum State
    Data
    Rcdata
    Rawtext
    ScriptData
    Plaintext
    TagOpen
    EndTagOpen
    TagName
    RcdataLessThanSign
    RcdataEndTagOpen
    RcdataEndTagName
    RawtextLessThanSign
    RawtextEndTagOpen
    RawtextEndTagName
    ScriptDataLessThanSign
    ScriptDataEndTagOpen
    ScriptDataEndTagName
    ScriptDataEscapeStart
    ScriptDataEscapeStartDash
    ScriptDataEscaped
    ScriptDataEscapedDash
    ScriptDataEscapedDashDash
    ScriptDataEscapedLessThanSign
    ScriptDataEscapedEndTagOpen
    ScriptDataEscapedEndTagName
    ScriptDataDoubleEscapeStart
    ScriptDataDoubleEscaped
    ScriptDataDoubleEscapedDash
    ScriptDataDoubleEscapedDashDash
    ScriptDataDoubleEscapedLessThanSign
    ScriptDataDoubleEscapeEnd
    BeforeAttributeName
    AttributeName
    AfterAttributeName
    BeforeAttributeValue
    AttributeValueDoubleQuoted
    AttributeValueSingleQuoted
    AttributeValueUnquoted
    AfterAttributeValueQuoted
    SelfClosingStartTag
    BogusComment
    MarkupDeclarationOpen
    CommentStart
    CommentStartDash
    Comment
    CommentLessThanSign
    CommentLessThanSignBang
    CommentLessThanSignBangDash
    CommentLessThanSignBangDashDash
    CommentEndDash
    CommentEnd
    CommentEndBang
    Doctype
    BeforeDoctypeName
    DoctypeName
    AfterDoctypeName
    AfterDoctypePublicKeyword
    BeforeDoctypePublicId
    DoctypePublicIdDoubleQuoted
    DoctypePublicIdSingleQuoted
    AfterDoctypePublicId
    BetweenDoctypePublicAndSystem
    AfterDoctypeSystemKeyword
    BeforeDoctypeSystemId
    DoctypeSystemIdDoubleQuoted
    DoctypeSystemIdSingleQuoted
    AfterDoctypeSystemId
    BogusDoctype
    CdataSection
    CdataSectionBracket
    CdataSectionEnd
    CharacterReference
    NamedCharacterReference
    AmbiguousAmpersand
    NumericCharacterReference
    HexadecimalCharacterReferenceStart
    DecimalCharacterReferenceStart
    HexadecimalCharacterReference
    DecimalCharacterReference
    NumericCharacterReferenceEnd

# =============================================================================
# Character Classification
# =============================================================================

pub fn is_ascii_alpha(c: u8) -> i32
    if c >= 'A' and c <= 'Z'
        return 1
    if c >= 'a' and c <= 'z'
        return 1
    return 0

pub fn is_ascii_upper(c: u8) -> i32
    if c >= 'A' and c <= 'Z'
        return 1
    return 0

pub fn is_ascii_digit(c: u8) -> i32
    if c >= '0' and c <= '9'
        return 1
    return 0

pub fn is_ascii_hex(c: u8) -> i32
    if c >= '0' and c <= '9'
        return 1
    if c >= 'A' and c <= 'F'
        return 1
    if c >= 'a' and c <= 'f'
        return 1
    return 0

fn is_ascii_alphanumeric(c: u8) -> i32
    if is_ascii_alpha(c) == 1
        return 1
    if is_ascii_digit(c) == 1
        return 1
    return 0

fn html_is_whitespace(c: u8) -> i32
    if c == '\t'
        return 1
    if c == '\n'
        return 1
    if c == 12   # form feed
        return 1
    if c == ' '
        return 1
    return 0

pub fn to_lower(c: u8) -> u8
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c

# =============================================================================
# Tokenizer Buffer
# =============================================================================

# Maximum sizes for buffers
const MAX_TAG_NAME_LEN: u32 = 256
const MAX_ATTR_NAME_LEN: u32 = 256
const MAX_ATTR_VALUE_LEN: u32 = 4096
const MAX_ATTRS: u32 = 64
const MAX_COMMENT_LEN: u32 = 65536

# =============================================================================
# Tokenizer State
# =============================================================================

pub struct Tokenizer
    # Input
    input: StrView
    pos: u64
    line: u32
    col: u32

    # State machine
    state: State
    return_state: State      # State to return to after character reference

    # Current token being built
    # Tag name buffer
    tag_name: [MAX_TAG_NAME_LEN]u8
    tag_name_len: u32
    is_end_tag: i32

    # Attribute buffers
    attr_name: [MAX_ATTR_NAME_LEN]u8
    attr_name_len: u32
    attr_value: [MAX_ATTR_VALUE_LEN]u8
    attr_value_len: u32

    # Attribute storage
    attrs: [MAX_ATTRS]Attribute
    attr_count: u32

    # Self-closing flag
    self_closing: i32

    # Comment buffer
    comment_data: [MAX_COMMENT_LEN]u8
    comment_len: u32

    # DOCTYPE data
    doctype_name: [MAX_TAG_NAME_LEN]u8
    doctype_name_len: u32
    doctype_public_id: [MAX_ATTR_VALUE_LEN]u8
    doctype_public_id_len: u32
    doctype_system_id: [MAX_ATTR_VALUE_LEN]u8
    doctype_system_id_len: u32
    doctype_force_quirks: i32

    # Temporary buffer for checking end tag names in raw text modes
    temp_buffer: [MAX_TAG_NAME_LEN]u8
    temp_buffer_len: u32

    # Character reference decoding
    char_ref_code: u32

    # Last emitted start tag name (for end tag matching in raw text)
    last_start_tag: [MAX_TAG_NAME_LEN]u8
    last_start_tag_len: u32

# =============================================================================
# Tokenizer Initialization
# =============================================================================

pub fn tokenizer_new(input: StrView) -> Tokenizer
    # Create with zero-initialized arrays
    # Note: In Ritz, we'd need proper array initialization
    var t: Tokenizer

    t.input = input
    t.pos = 0
    t.line = 1
    t.col = 1

    t.state = State.Data
    t.return_state = State.Data

    t.tag_name_len = 0
    t.is_end_tag = 0
    t.attr_name_len = 0
    t.attr_value_len = 0
    t.attr_count = 0
    t.self_closing = 0

    t.comment_len = 0

    t.doctype_name_len = 0
    t.doctype_public_id_len = 0
    t.doctype_system_id_len = 0
    t.doctype_force_quirks = 0

    t.temp_buffer_len = 0
    t.char_ref_code = 0
    t.last_start_tag_len = 0

    t

# =============================================================================
# Input Handling
# =============================================================================

fn peek_char(t: Tokenizer) -> i32
    if t.pos >= t.input.len
        return -1  # EOF
    return t.input.ptr[t.pos] as i32

fn consume_char(t:& Tokenizer) -> i32
    if t.pos >= t.input.len
        return -1
    let c = t.input.ptr[t.pos] as i32
    t.pos = t.pos + 1

    # Track line/column
    if c == '\n'
        t.line = t.line + 1
        t.col = 1
    else
        t.col = t.col + 1

    c

fn unconsume_char(t:& Tokenizer)
    if t.pos > 0
        t.pos = t.pos - 1
        # Note: line/col tracking gets tricky with unconsume
        # For now, accept minor inaccuracy on unconsume
        if t.col > 1
            t.col = t.col - 1

# =============================================================================
# Token Building Helpers
# =============================================================================

fn clear_tag(t:& Tokenizer)
    t.tag_name_len = 0
    t.is_end_tag = 0
    t.attr_count = 0
    t.self_closing = 0

fn append_to_tag_name(t:& Tokenizer, c: u8)
    if t.tag_name_len < MAX_TAG_NAME_LEN
        t.tag_name[t.tag_name_len] = to_lower(c)
        t.tag_name_len = t.tag_name_len + 1

fn clear_attr(t:& Tokenizer)
    t.attr_name_len = 0
    t.attr_value_len = 0

fn append_to_attr_name(t:& Tokenizer, c: u8)
    if t.attr_name_len < MAX_ATTR_NAME_LEN
        t.attr_name[t.attr_name_len] = to_lower(c)
        t.attr_name_len = t.attr_name_len + 1

fn append_to_attr_value(t:& Tokenizer, c: u8)
    if t.attr_value_len < MAX_ATTR_VALUE_LEN
        t.attr_value[t.attr_value_len] = c
        t.attr_value_len = t.attr_value_len + 1

fn finish_attr(t:& Tokenizer)
    if t.attr_name_len > 0 and t.attr_count < MAX_ATTRS
        # Check for duplicate attribute
        # HTML5 says: "When the user agent leaves the attribute name state
        # (and before emitting the tag token, if appropriate), if there is
        # already an attribute on the token with the exact same name, then
        # this is a duplicate-attribute parse error and the new attribute
        # must be removed from the token."

        # For now, just add it (TODO: check duplicates)
        let name = StrView {
            ptr: @t.attr_name[0],
            len: t.attr_name_len as u64
        }
        let value = StrView {
            ptr: @t.attr_value[0],
            len: t.attr_value_len as u64
        }
        t.attrs[t.attr_count] = attribute_new(name, value)
        t.attr_count = t.attr_count + 1

fn append_to_comment(t:& Tokenizer, c: u8)
    if t.comment_len < MAX_COMMENT_LEN
        t.comment_data[t.comment_len] = c
        t.comment_len = t.comment_len + 1

fn clear_comment(t:& Tokenizer)
    t.comment_len = 0

fn append_to_temp_buffer(t:& Tokenizer, c: u8)
    if t.temp_buffer_len < MAX_TAG_NAME_LEN
        t.temp_buffer[t.temp_buffer_len] = c
        t.temp_buffer_len = t.temp_buffer_len + 1

fn clear_temp_buffer(t:& Tokenizer)
    t.temp_buffer_len = 0

# =============================================================================
# Token Emission
# =============================================================================

fn emit_character(t:& Tokenizer, c: u32) -> Token
    var tok = token_eof()
    tok.kind = TOKEN_CHARACTER
    tok.character = character_token_new(c)
    tok

fn emit_start_tag(t:& Tokenizer) -> Token
    var tok = token_eof()
    tok.kind = TOKEN_START_TAG
    tok.start_tag.name = StrView {
        ptr: @t.tag_name[0],
        len: t.tag_name_len as u64
    }
    tok.start_tag.attrs = @t.attrs[0]
    tok.start_tag.attr_count = t.attr_count
    tok.start_tag.self_closing = t.self_closing

    # Remember last start tag for end tag matching
    var i: u32 = 0
    while i < t.tag_name_len and i < MAX_TAG_NAME_LEN
        t.last_start_tag[i] = t.tag_name[i]
        i = i + 1
    t.last_start_tag_len = t.tag_name_len

    tok

fn emit_end_tag(t:& Tokenizer) -> Token
    var tok = token_eof()
    tok.kind = TOKEN_END_TAG
    tok.end_tag.name = StrView {
        ptr: @t.tag_name[0],
        len: t.tag_name_len as u64
    }
    tok

fn html_tok_emit_comment(t:& Tokenizer) -> Token
    var tok = token_eof()
    tok.kind = TOKEN_COMMENT
    tok.comment.data = StrView {
        ptr: @t.comment_data[0],
        len: t.comment_len as u64
    }
    tok

fn html_tok_emit_doctype(t:& Tokenizer) -> Token
    var tok = token_eof()
    tok.kind = TOKEN_DOCTYPE
    tok.doctype.name = StrView {
        ptr: @t.doctype_name[0],
        len: t.doctype_name_len as u64
    }
    tok.doctype.public_id = StrView {
        ptr: @t.doctype_public_id[0],
        len: t.doctype_public_id_len as u64
    }
    tok.doctype.system_id = StrView {
        ptr: @t.doctype_system_id[0],
        len: t.doctype_system_id_len as u64
    }
    tok.doctype.force_quirks = t.doctype_force_quirks
    tok

fn emit_eof(t:& Tokenizer) -> Token
    token_eof()

# =============================================================================
# State Transition Helpers
# =============================================================================
#
# Every `state_*` fn handles one input char `c` (-1 at EOF) in one state and
# returns Some(token) to emit or None to keep stepping. A fn that does not
# consume `c` leaves it for the next state to reconsume, as the spec says.

# Switch to `next` and consume the current char.
fn advance(t:& Tokenizer, next: State) -> Option<Token>
    t.state = next
    consume_char(t)
    None

# Switch to `next` without consuming: it reconsumes the current char.
fn reconsume_in(t:& Tokenizer, next: State) -> Option<Token>
    t.state = next
    None

# Consume the current char and stay in this state.
fn skip(t:& Tokenizer) -> Option<Token>
    consume_char(t)
    None

# The tag being built, as a start or end tag.
fn emit_tag(t:& Tokenizer) -> Token
    if t.is_end_tag == 1
        return emit_end_tag(t)
    emit_start_tag(t)

# `>` ends the current tag, comment or DOCTYPE: back to Data and emit it.
fn close_tag(t:& Tokenizer) -> Option<Token>
    t.state = State.Data
    consume_char(t)
    Some(emit_tag(t))

fn close_comment(t:& Tokenizer) -> Option<Token>
    t.state = State.Data
    consume_char(t)
    Some(html_tok_emit_comment(t))

fn close_doctype(t:& Tokenizer) -> Option<Token>
    t.state = State.Data
    consume_char(t)
    Some(html_tok_emit_doctype(t))

# EOF inside a DOCTYPE: emit it with force-quirks set.
fn eof_in_doctype(t:& Tokenizer) -> Option<Token>
    t.doctype_force_quirks = 1
    Some(html_tok_emit_doctype(t))

# Not a character reference after all: emit the `&` and go back.
fn abandon_char_ref(t:& Tokenizer) -> Option<Token>
    t.state = t.return_state
    Some(emit_character(t, 38))  # &

# Start a character reference from `from`, which it returns to.
fn begin_char_ref(t:& Tokenizer, from: State) -> Option<Token>
    t.return_state = from
    advance(t, State.CharacterReference)

# Append input char `c`; NUL (a parse error) becomes 0xFD, part of U+FFFD.
fn append_attr_value_char(t:& Tokenizer, c: i32)
    if c == 0
        append_to_attr_value(t, 0xFD)
    else
        append_to_attr_value(t, c as u8)

fn append_comment_char(t:& Tokenizer, c: i32)
    if c == 0
        append_to_comment(t, 0xFD)
    else
        append_to_comment(t, c as u8)

fn append_doctype_name_char(t:& Tokenizer, c: i32)
    if t.doctype_name_len < MAX_TAG_NAME_LEN
        if c == 0
            t.doctype_name[t.doctype_name_len] = 0xFD
        else
            t.doctype_name[t.doctype_name_len] = to_lower(c as u8)
        t.doctype_name_len = t.doctype_name_len + 1

fn in_attribute_value(s: State) -> bool
    match s
        State.AttributeValueDoubleQuoted => true
        State.AttributeValueSingleQuoted => true
        State.AttributeValueUnquoted => true
        _ => false

# =============================================================================
# Data and Tag States
# =============================================================================

fn state_data(t:& Tokenizer, c: i32) -> Option<Token>
    if c == -1
        return Some(emit_eof(t))
    if c == '&'
        return begin_char_ref(t, State.Data)
    if c == '<'
        return advance(t, State.TagOpen)
    consume_char(t)
    if c == 0
        # Parse error: unexpected-null-character
        return Some(emit_character(t, 65533))  # U+FFFD
    Some(emit_character(t, c as u32))

fn state_tag_open(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '!'
        return advance(t, State.MarkupDeclarationOpen)
    if c == '/'
        return advance(t, State.EndTagOpen)
    if is_ascii_alpha(c as u8) == 1
        clear_tag(t)
        return reconsume_in(t, State.TagName)
    if c == '?'
        # Parse error: unexpected-question-mark-instead-of-tag-name
        clear_comment(t)
        return reconsume_in(t, State.BogusComment)
    if c == -1
        # Parse error: eof-before-tag-name
        return Some(emit_character(t, 60))  # <
    # Parse error: invalid-first-character-of-tag-name
    t.state = State.Data
    Some(emit_character(t, 60))  # <

fn state_end_tag_open(t:& Tokenizer, c: i32) -> Option<Token>
    if is_ascii_alpha(c as u8) == 1
        clear_tag(t)
        t.is_end_tag = 1
        return reconsume_in(t, State.TagName)
    if c == '>'
        # Parse error: missing-end-tag-name
        return advance(t, State.Data)
    if c == -1
        # Parse error: eof-before-tag-name. Should emit "<" and "/" then EOF.
        return Some(emit_character(t, 60))  # TODO: need to queue multiple tokens
    # Parse error: invalid-first-character-of-tag-name
    clear_comment(t)
    reconsume_in(t, State.BogusComment)

fn state_tag_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return advance(t, State.BeforeAttributeName)
    if c == '/'
        return advance(t, State.SelfClosingStartTag)
    if c == '>'
        return close_tag(t)
    if c == -1
        # Parse error: eof-in-tag
        return Some(emit_eof(t))
    if c == 0
        append_to_tag_name(t, 0xFD)  # Parse error; part of U+FFFD in UTF-8
    else
        append_to_tag_name(t, c as u8)  # lowercases ASCII upper
    skip(t)

fn state_self_closing_start_tag(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '>'
        t.self_closing = 1
        return close_tag(t)
    if c == -1
        return Some(emit_eof(t))
    # Parse error: unexpected-solidus-in-tag
    reconsume_in(t, State.BeforeAttributeName)

# =============================================================================
# Attribute States
# =============================================================================

fn state_before_attribute_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return skip(t)
    if c == '/' or c == '>' or c == -1
        return reconsume_in(t, State.AfterAttributeName)
    clear_attr(t)
    if c == '='
        # Parse error: unexpected-equals-sign-before-attribute-name
        append_to_attr_name(t, c as u8)
        return advance(t, State.AttributeName)
    reconsume_in(t, State.AttributeName)

fn state_attribute_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1 or c == '/' or c == '>' or c == -1
        return reconsume_in(t, State.AfterAttributeName)
    if c == '='
        return advance(t, State.BeforeAttributeValue)
    # NUL is a parse error (-> 0xFD); " ' < are parse errors but kept.
    if c == 0
        append_to_attr_name(t, 0xFD)
    else
        append_to_attr_name(t, c as u8)  # lowercases ASCII upper
    skip(t)

fn state_after_attribute_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return skip(t)
    if c == '/'
        return advance(t, State.SelfClosingStartTag)
    if c == '='
        return advance(t, State.BeforeAttributeValue)
    if c == '>'
        finish_attr(t)
        return close_tag(t)
    if c == -1
        # Parse error: eof-in-tag
        return Some(emit_eof(t))
    finish_attr(t)
    clear_attr(t)
    reconsume_in(t, State.AttributeName)

fn state_before_attribute_value(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return skip(t)
    if c == '"'
        return advance(t, State.AttributeValueDoubleQuoted)
    if c == '\''
        return advance(t, State.AttributeValueSingleQuoted)
    if c == '>'
        # Parse error: missing-attribute-value
        finish_attr(t)
        return close_tag(t)
    reconsume_in(t, State.AttributeValueUnquoted)

# Attribute value (double-quoted) and (single-quoted): `quote` ends the
# value, `self_state` is where a character reference returns to.
fn attribute_value_quoted(t:& Tokenizer, c: i32, quote: u8, self_state: State) -> Option<Token>
    if c == quote as i32
        finish_attr(t)
        return advance(t, State.AfterAttributeValueQuoted)
    if c == '&'
        return begin_char_ref(t, self_state)
    if c == -1
        # Parse error: eof-in-tag
        return Some(emit_eof(t))
    append_attr_value_char(t, c)
    skip(t)

fn state_attribute_value_unquoted(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        finish_attr(t)
        return advance(t, State.BeforeAttributeName)
    if c == '&'
        return begin_char_ref(t, State.AttributeValueUnquoted)
    if c == '>'
        finish_attr(t)
        return close_tag(t)
    if c == -1
        return Some(emit_eof(t))
    # " ' < = ` are parse errors here but are kept in the value.
    append_attr_value_char(t, c)
    skip(t)

fn state_after_attribute_value_quoted(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return advance(t, State.BeforeAttributeName)
    if c == '/'
        return advance(t, State.SelfClosingStartTag)
    if c == '>'
        return close_tag(t)
    if c == -1
        return Some(emit_eof(t))
    # Parse error: missing-whitespace-between-attributes
    reconsume_in(t, State.BeforeAttributeName)

# =============================================================================
# Markup Declaration and Comment States
# =============================================================================

# After `<!`: "--" opens a comment, "DOCTYPE" a doctype, else a bogus comment.
fn state_markup_declaration_open(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '-'
        consume_char(t)
        clear_comment(t)
        if peek_char(t) == '-'
            return advance(t, State.CommentStart)
        # Parse error: incorrectly-opened-comment
        unconsume_char(t)
        return reconsume_in(t, State.BogusComment)
    if c == 'D' or c == 'd'
        # Simplified: a leading D is taken as DOCTYPE and its 7 chars skipped
        # without checking the rest.
        var i = 0
        while i < 7
            consume_char(t)
            i = i + 1
        t.doctype_name_len = 0
        t.doctype_public_id_len = 0
        t.doctype_system_id_len = 0
        t.doctype_force_quirks = 0
        return reconsume_in(t, State.Doctype)
    # Parse error: incorrectly-opened-comment
    clear_comment(t)
    reconsume_in(t, State.BogusComment)

fn state_comment_start(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '-'
        return advance(t, State.CommentStartDash)
    if c == '>'
        # Parse error: abrupt-closing-of-empty-comment
        return close_comment(t)
    reconsume_in(t, State.Comment)

fn state_comment_start_dash(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '-'
        return advance(t, State.CommentEnd)
    if c == '>'
        return close_comment(t)  # Parse error
    if c == -1
        return Some(html_tok_emit_comment(t))
    append_to_comment(t, 45)  # -
    reconsume_in(t, State.Comment)

fn state_comment(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '<'
        append_to_comment(t, c as u8)
        return advance(t, State.CommentLessThanSign)
    if c == '-'
        return advance(t, State.CommentEndDash)
    if c == -1
        return Some(html_tok_emit_comment(t))
    append_comment_char(t, c)
    skip(t)

fn state_comment_end_dash(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '-'
        return advance(t, State.CommentEnd)
    if c == -1
        return Some(html_tok_emit_comment(t))
    append_to_comment(t, 45)  # -
    reconsume_in(t, State.Comment)

fn state_comment_end(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '>'
        return close_comment(t)
    if c == '!'
        return advance(t, State.CommentEndBang)
    if c == '-'
        append_to_comment(t, 45)
        return skip(t)
    if c == -1
        return Some(html_tok_emit_comment(t))
    append_to_comment(t, 45)
    append_to_comment(t, 45)
    reconsume_in(t, State.Comment)

fn state_bogus_comment(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '>'
        return close_comment(t)
    if c == -1
        return Some(html_tok_emit_comment(t))
    append_comment_char(t, c)
    skip(t)

# =============================================================================
# DOCTYPE States
# =============================================================================

fn state_doctype(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return advance(t, State.BeforeDoctypeName)
    if c == -1
        return eof_in_doctype(t)
    # `>` and anything else (a parse error) reconsume in the next state.
    reconsume_in(t, State.BeforeDoctypeName)

fn state_before_doctype_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return skip(t)
    if c == '>'
        # Parse error: missing-doctype-name
        t.doctype_force_quirks = 1
        return close_doctype(t)
    if c == -1
        return eof_in_doctype(t)
    t.doctype_name_len = 0
    append_doctype_name_char(t, c)
    advance(t, State.DoctypeName)

fn state_doctype_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return advance(t, State.AfterDoctypeName)
    if c == '>'
        return close_doctype(t)
    if c == -1
        return eof_in_doctype(t)
    append_doctype_name_char(t, c)
    skip(t)

fn state_after_doctype_name(t:& Tokenizer, c: i32) -> Option<Token>
    if html_is_whitespace(c as u8) == 1
        return skip(t)
    if c == '>'
        return close_doctype(t)
    if c == -1
        return eof_in_doctype(t)
    # PUBLIC / SYSTEM keywords are not supported yet: treat as bogus.
    advance(t, State.BogusDoctype)

fn state_bogus_doctype(t:& Tokenizer, c: i32) -> Option<Token>
    if c == '>'
        return close_doctype(t)
    if c == -1
        return Some(html_tok_emit_doctype(t))
    skip(t)

# =============================================================================
# Character Reference States
# =============================================================================
#
# Simplified: named references are not looked up, so `&name;` stays literal.

fn state_character_reference(t:& Tokenizer, c: i32) -> Option<Token>
    clear_temp_buffer(t)
    append_to_temp_buffer(t, 38)  # &
    if c == '#'
        append_to_temp_buffer(t, c as u8)
        return advance(t, State.NumericCharacterReference)
    if is_ascii_alphanumeric(c as u8) == 1
        return reconsume_in(t, State.NamedCharacterReference)
    abandon_char_ref(t)

fn state_numeric_character_reference(t:& Tokenizer, c: i32) -> Option<Token>
    t.char_ref_code = 0
    if c == 'x' or c == 'X'
        append_to_temp_buffer(t, c as u8)
        return advance(t, State.HexadecimalCharacterReferenceStart)
    reconsume_in(t, State.DecimalCharacterReferenceStart)

fn state_hexadecimal_character_reference_start(t:& Tokenizer, c: i32) -> Option<Token>
    if is_ascii_hex(c as u8) == 1
        return reconsume_in(t, State.HexadecimalCharacterReference)
    abandon_char_ref(t)  # Parse error

fn state_decimal_character_reference_start(t:& Tokenizer, c: i32) -> Option<Token>
    if is_ascii_digit(c as u8) == 1
        return reconsume_in(t, State.DecimalCharacterReference)
    abandon_char_ref(t)

# Accumulate one digit of a numeric character reference, saturating just
# past the Unicode range: anything above 0x10FFFF becomes U+FFFD at the end
# state, so further digits cannot change the outcome (#4571).
fn char_ref_push_digit(t:& Tokenizer, base: u32, digit: u32)
    if t.char_ref_code > 0x10FFFF
        return
    t.char_ref_code = t.char_ref_code * base + digit

fn state_hexadecimal_character_reference(t:& Tokenizer, c: i32) -> Option<Token>
    if is_ascii_digit(c as u8) == 1
        char_ref_push_digit(t, 16, c as u32 - 48)
        return skip(t)
    if c >= 'A' and c <= 'F'
        char_ref_push_digit(t, 16, c as u32 - 55)
        return skip(t)
    if c >= 'a' and c <= 'f'
        char_ref_push_digit(t, 16, c as u32 - 87)
        return skip(t)
    if c == ';'
        return advance(t, State.NumericCharacterReferenceEnd)
    # Parse error: missing-semicolon-after-character-reference
    reconsume_in(t, State.NumericCharacterReferenceEnd)

fn state_decimal_character_reference(t:& Tokenizer, c: i32) -> Option<Token>
    if is_ascii_digit(c as u8) == 1
        char_ref_push_digit(t, 10, c as u32 - 48)
        return skip(t)
    if c == ';'
        return advance(t, State.NumericCharacterReferenceEnd)
    reconsume_in(t, State.NumericCharacterReferenceEnd)

# Validate the code point, then append it to the attribute value being
# built or emit it as a character, depending on where the reference began.
fn state_numeric_character_reference_end(t:& Tokenizer) -> Option<Token>
    var code = t.char_ref_code
    if code == 0
        code = 0xFFFD
    else if code > 0x10FFFF
        code = 0xFFFD
    else if code >= 0xD800 and code <= 0xDFFF
        code = 0xFFFD

    t.state = t.return_state
    if not in_attribute_value(t.return_state)
        return Some(emit_character(t, code))
    if code < 0x80
        append_to_attr_value(t, code as u8)
    else
        append_to_attr_value(t, 0xFD)  # Simplified: no UTF-8 encoding yet
    None

# =============================================================================
# Main Tokenizer Loop
# =============================================================================

# One step of the state machine on input char `c`.
fn step(t:& Tokenizer, c: i32) -> Option<Token>
    match t.state
        State.Data => state_data(t, c)
        State.TagOpen => state_tag_open(t, c)
        State.EndTagOpen => state_end_tag_open(t, c)
        State.TagName => state_tag_name(t, c)
        State.SelfClosingStartTag => state_self_closing_start_tag(t, c)
        State.BeforeAttributeName => state_before_attribute_name(t, c)
        State.AttributeName => state_attribute_name(t, c)
        State.AfterAttributeName => state_after_attribute_name(t, c)
        State.BeforeAttributeValue => state_before_attribute_value(t, c)
        State.AttributeValueDoubleQuoted => attribute_value_quoted(t, c, '"', State.AttributeValueDoubleQuoted)
        State.AttributeValueSingleQuoted => attribute_value_quoted(t, c, '\'', State.AttributeValueSingleQuoted)
        State.AttributeValueUnquoted => state_attribute_value_unquoted(t, c)
        State.AfterAttributeValueQuoted => state_after_attribute_value_quoted(t, c)
        State.MarkupDeclarationOpen => state_markup_declaration_open(t, c)
        State.CommentStart => state_comment_start(t, c)
        State.CommentStartDash => state_comment_start_dash(t, c)
        State.Comment => state_comment(t, c)
        State.CommentEndDash => state_comment_end_dash(t, c)
        State.CommentEnd => state_comment_end(t, c)
        State.BogusComment => state_bogus_comment(t, c)
        State.Doctype => state_doctype(t, c)
        State.BeforeDoctypeName => state_before_doctype_name(t, c)
        State.DoctypeName => state_doctype_name(t, c)
        State.AfterDoctypeName => state_after_doctype_name(t, c)
        State.BogusDoctype => state_bogus_doctype(t, c)
        State.CharacterReference => state_character_reference(t, c)
        State.NamedCharacterReference => abandon_char_ref(t)  # no entity table yet
        State.NumericCharacterReference => state_numeric_character_reference(t, c)
        State.HexadecimalCharacterReferenceStart => state_hexadecimal_character_reference_start(t, c)
        State.DecimalCharacterReferenceStart => state_decimal_character_reference_start(t, c)
        State.HexadecimalCharacterReference => state_hexadecimal_character_reference(t, c)
        State.DecimalCharacterReference => state_decimal_character_reference(t, c)
        State.NumericCharacterReferenceEnd => state_numeric_character_reference_end(t)
        # Not implemented yet (RCDATA, RAWTEXT, script data, CDATA, ...): advance.
        _ => skip(t)

# Get the next token from the input stream
pub fn tokenizer_next(t:& Tokenizer) -> Token
    loop
        match step(t, peek_char(t))
            Some(tok) => return tok
            None => continue

# =============================================================================
# Set Tokenizer State (for tree builder to switch modes)
# =============================================================================

pub fn tokenizer_set_state(t:& Tokenizer, state: State)
    t.state = state
