# lib/dom/tag.ritz - HTML element tags
#
# This module defines the enum of all HTML element tags.
# Using an enum allows for efficient matching and avoids string comparisons.

import ritzlib.strview

# Standard HTML5 elements
pub enum Tag
    # Document root
    Html

    # Document metadata
    Head
    Title
    Base
    Link
    Meta
    Style

    # Sections
    Body
    Article
    Section
    Nav
    Aside
    H1
    H2
    H3
    H4
    H5
    H6
    Hgroup
    Header
    Footer
    Address

    # Grouping content
    P
    Hr
    Pre
    Blockquote
    Ol
    Ul
    Menu
    Li
    Dl
    Dt
    Dd
    Figure
    Figcaption
    Main
    Search
    Div

    # Text-level semantics
    A
    Em
    Strong
    Small
    S
    Cite
    Q
    Dfn
    Abbr
    Ruby
    Rt
    Rp
    Data
    Time
    Code
    Var
    Samp
    Kbd
    Sub
    Sup
    I
    B
    U
    Mark
    Bdi
    Bdo
    Span
    Br
    Wbr

    # Edits
    Ins
    Del

    # Embedded content
    Picture
    Source
    Img
    Iframe
    Embed
    Object
    Param
    Video
    Audio
    Track
    Map
    Area

    # Tabular data
    Table
    Caption
    Colgroup
    Col
    Tbody
    Thead
    Tfoot
    Tr
    Td
    Th

    # Forms
    Form
    Label
    Input
    Button
    Select
    Datalist
    Optgroup
    Option
    Textarea
    Output
    Progress
    Meter
    Fieldset
    Legend

    # Interactive elements
    Details
    Summary
    Dialog

    # Scripting
    Script
    Noscript
    Template
    Slot
    Canvas

    # Deprecated formatting elements (still supported)
    Big
    Font
    Nobr
    Strike
    Tt
    Applet
    Basefont
    Bgsound
    Center
    Dir
    Listing
    Marquee
    Plaintext
    Xmp

    # Deprecated frame elements (still in the HTML5 "special" category)
    Frame
    Frameset
    Noembed
    Noframes

    # Unknown/custom element
    Unknown(StrView)

# Check if tag is a void element (self-closing, no end tag)
pub fn tag_is_void(tag: Tag) -> bool
    match tag
        Tag.Area => true
        Tag.Base => true
        Tag.Br => true
        Tag.Col => true
        Tag.Embed => true
        Tag.Hr => true
        Tag.Img => true
        Tag.Input => true
        Tag.Link => true
        Tag.Meta => true
        Tag.Param => true
        Tag.Source => true
        Tag.Track => true
        Tag.Wbr => true
        _ => false

# Check if tag is a raw text element (<script>, <style>)
# These contain raw text, not parsed as HTML
pub fn tag_is_raw_text(tag: Tag) -> bool
    match tag
        Tag.Script => true
        Tag.Style => true
        _ => false

# Check if tag is an escapable raw text element (<textarea>, <title>)
# These contain text with entity decoding but no child elements
pub fn tag_is_escapable_raw_text(tag: Tag) -> bool
    match tag
        Tag.Textarea => true
        Tag.Title => true
        _ => false

# Check if tag is a formatting element (adoption agency applies)
pub fn tag_is_formatting(tag: Tag) -> bool
    match tag
        Tag.A => true
        Tag.B => true
        Tag.Big => true  # deprecated
        Tag.Code => true
        Tag.Em => true
        Tag.Font => true # deprecated
        Tag.I => true
        Tag.Nobr => true # deprecated
        Tag.S => true
        Tag.Small => true
        Tag.Strike => true # deprecated
        Tag.Strong => true
        Tag.Tt => true   # deprecated
        Tag.U => true
        _ => false

# Check if tag implies closing of certain other tags
# (e.g., <p> closes previous <p>, <li> closes previous <li>)
pub fn tag_closes_previous(tag: Tag, previous: Tag) -> bool
    # Variant-only: none of these groups includes Unknown, so its payload
    # never matters.  Same group (and not 0) means `tag` closes `previous`.
    let group = tag_close_group(tag)
    group != 0 and group == tag_close_group(previous)

# Group id for tag_closes_previous: 0 = closes nothing
fn tag_close_group(tag: Tag) -> i32
    match tag
        Tag.P => 1
        Tag.Li => 2
        Tag.Dt => 3
        Tag.Dd => 3
        Tag.Tr => 4
        Tag.Td => 5
        Tag.Th => 5
        _ => 0

# Check if tag is a "special" element (per HTML5 spec)
# These affect parsing behavior in specific ways
pub fn tag_is_special(tag: Tag) -> bool
    match tag
        Tag.Address => true
        Tag.Applet => true  # deprecated
        Tag.Area => true
        Tag.Article => true
        Tag.Aside => true
        Tag.Base => true
        Tag.Basefont => true # deprecated
        Tag.Bgsound => true  # deprecated
        Tag.Blockquote => true
        Tag.Body => true
        Tag.Br => true
        Tag.Button => true
        Tag.Caption => true
        Tag.Center => true   # deprecated
        Tag.Col => true
        Tag.Colgroup => true
        Tag.Dd => true
        Tag.Details => true
        Tag.Dialog => true
        Tag.Dir => true      # deprecated
        Tag.Div => true
        Tag.Dl => true
        Tag.Dt => true
        Tag.Embed => true
        Tag.Fieldset => true
        Tag.Figcaption => true
        Tag.Figure => true
        Tag.Footer => true
        Tag.Form => true
        Tag.Frame => true    # deprecated
        Tag.Frameset => true # deprecated
        Tag.H1 => true
        Tag.H2 => true
        Tag.H3 => true
        Tag.H4 => true
        Tag.H5 => true
        Tag.H6 => true
        Tag.Head => true
        Tag.Header => true
        Tag.Hgroup => true
        Tag.Hr => true
        Tag.Html => true
        Tag.Iframe => true
        Tag.Img => true
        Tag.Input => true
        Tag.Li => true
        Tag.Link => true
        Tag.Listing => true  # deprecated
        Tag.Main => true
        Tag.Marquee => true  # deprecated
        Tag.Menu => true
        Tag.Meta => true
        Tag.Nav => true
        Tag.Noembed => true  # deprecated
        Tag.Noframes => true # deprecated
        Tag.Noscript => true
        Tag.Object => true
        Tag.Ol => true
        Tag.P => true
        Tag.Param => true
        Tag.Plaintext => true # deprecated
        Tag.Pre => true
        Tag.Script => true
        Tag.Search => true
        Tag.Section => true
        Tag.Select => true
        Tag.Source => true
        Tag.Style => true
        Tag.Summary => true
        Tag.Table => true
        Tag.Tbody => true
        Tag.Td => true
        Tag.Template => true
        Tag.Textarea => true
        Tag.Tfoot => true
        Tag.Th => true
        Tag.Thead => true
        Tag.Title => true
        Tag.Tr => true
        Tag.Track => true
        Tag.Ul => true
        Tag.Wbr => true
        Tag.Xmp => true      # deprecated
        _ => false

# Parse a tag name string into a Tag enum: a `match` on string literals
# (LANGUAGE_SPEC §8.2, AGAST #1876), which test/test_tag.ritz holds to tag_name.
pub fn tag_from_name(name: StrView) -> Tag
    match name
        "html" => Tag.Html
        "head" => Tag.Head
        "title" => Tag.Title
        "base" => Tag.Base
        "link" => Tag.Link
        "meta" => Tag.Meta
        "style" => Tag.Style
        "body" => Tag.Body
        "article" => Tag.Article
        "section" => Tag.Section
        "nav" => Tag.Nav
        "aside" => Tag.Aside
        "h1" => Tag.H1
        "h2" => Tag.H2
        "h3" => Tag.H3
        "h4" => Tag.H4
        "h5" => Tag.H5
        "h6" => Tag.H6
        "header" => Tag.Header
        "footer" => Tag.Footer
        "address" => Tag.Address
        "p" => Tag.P
        "hr" => Tag.Hr
        "pre" => Tag.Pre
        "blockquote" => Tag.Blockquote
        "ol" => Tag.Ol
        "ul" => Tag.Ul
        "li" => Tag.Li
        "dl" => Tag.Dl
        "dt" => Tag.Dt
        "dd" => Tag.Dd
        "figure" => Tag.Figure
        "figcaption" => Tag.Figcaption
        "main" => Tag.Main
        "div" => Tag.Div
        "a" => Tag.A
        "em" => Tag.Em
        "strong" => Tag.Strong
        "small" => Tag.Small
        "s" => Tag.S
        "cite" => Tag.Cite
        "q" => Tag.Q
        "code" => Tag.Code
        "var" => Tag.Var
        "samp" => Tag.Samp
        "kbd" => Tag.Kbd
        "sub" => Tag.Sub
        "sup" => Tag.Sup
        "i" => Tag.I
        "b" => Tag.B
        "u" => Tag.U
        "mark" => Tag.Mark
        "span" => Tag.Span
        "br" => Tag.Br
        "wbr" => Tag.Wbr
        "img" => Tag.Img
        "iframe" => Tag.Iframe
        "embed" => Tag.Embed
        "object" => Tag.Object
        "video" => Tag.Video
        "audio" => Tag.Audio
        "source" => Tag.Source
        "track" => Tag.Track
        "canvas" => Tag.Canvas
        "table" => Tag.Table
        "caption" => Tag.Caption
        "colgroup" => Tag.Colgroup
        "col" => Tag.Col
        "tbody" => Tag.Tbody
        "thead" => Tag.Thead
        "tfoot" => Tag.Tfoot
        "tr" => Tag.Tr
        "td" => Tag.Td
        "th" => Tag.Th
        "form" => Tag.Form
        "label" => Tag.Label
        "input" => Tag.Input
        "button" => Tag.Button
        "select" => Tag.Select
        "datalist" => Tag.Datalist
        "optgroup" => Tag.Optgroup
        "option" => Tag.Option
        "textarea" => Tag.Textarea
        "output" => Tag.Output
        "progress" => Tag.Progress
        "meter" => Tag.Meter
        "fieldset" => Tag.Fieldset
        "legend" => Tag.Legend
        "details" => Tag.Details
        "summary" => Tag.Summary
        "dialog" => Tag.Dialog
        "script" => Tag.Script
        "noscript" => Tag.Noscript
        "template" => Tag.Template
        "slot" => Tag.Slot
        "dir" => Tag.Dir
        "listing" => Tag.Listing
        "marquee" => Tag.Marquee
        "plaintext" => Tag.Plaintext
        "xmp" => Tag.Xmp
        "frame" => Tag.Frame
        "frameset" => Tag.Frameset
        "noembed" => Tag.Noembed
        "noframes" => Tag.Noframes
        _ => Tag.Unknown(name)

# Get the string name for a tag
