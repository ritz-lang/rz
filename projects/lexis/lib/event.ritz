# lib/event.ritz - DOM Events emitted by Lexis parser
#
# These events are emitted during streaming HTML/CSS parsing.
# Tempest receives these events and builds/updates its DOM tree.

import lib.dom.tag { Tag }
import lib.dom.attribute { Attribute }

# =============================================================================
# DOM Event Types
# =============================================================================

# Event type constants
pub const DOM_EVENT_DOCUMENT_START: i32 = 0
pub const DOM_EVENT_DOCUMENT_END: i32 = 1
pub const DOM_EVENT_ELEMENT_START: i32 = 2
pub const DOM_EVENT_ELEMENT_END: i32 = 3
pub const DOM_EVENT_TEXT: i32 = 4
pub const DOM_EVENT_COMMENT: i32 = 5
pub const DOM_EVENT_DOCTYPE: i32 = 6
pub const DOM_EVENT_STYLESHEET_PARSED: i32 = 7
pub const DOM_EVENT_PARSE_ERROR: i32 = 8
pub const DOM_EVENT_PARSE_WARNING: i32 = 9

# =============================================================================
# Error/Warning Kinds
# =============================================================================

pub const PARSE_ERROR_UNEXPECTED_TOKEN: i32 = 0
pub const PARSE_ERROR_UNEXPECTED_EOF: i32 = 1
pub const PARSE_ERROR_INVALID_TAG: i32 = 2
pub const PARSE_ERROR_UNCLOSED_TAG: i32 = 3
pub const PARSE_ERROR_INVALID_ATTRIBUTE: i32 = 4
pub const PARSE_ERROR_DUPLICATE_ATTRIBUTE: i32 = 5
pub const PARSE_ERROR_INVALID_ENTITY: i32 = 6
pub const PARSE_ERROR_NESTING_ERROR: i32 = 7

pub const PARSE_WARNING_UNKNOWN_PROPERTY: i32 = 0
pub const PARSE_WARNING_INVALID_VALUE: i32 = 1
pub const PARSE_WARNING_DEPRECATED: i32 = 2
pub const PARSE_WARNING_QUIRKS_MODE: i32 = 3

# =============================================================================
# Event Data Structures
# =============================================================================

# Element start event data
pub struct ElementStartEvent
    tag: Tag
    attrs: [64]Attribute    # Fixed-size attribute array
    attr_count: u32         # Number of attributes
    self_closing: i32       # 1 if self-closing (e.g., <br/>)

# Element end event data
pub struct ElementEndEvent
    tag: Tag

# Text content event data
pub struct TextEvent
    content: StrView

# Comment event data
pub struct CommentEvent
    content: StrView

# DOCTYPE event data
pub struct DoctypeEvent
    name: StrView
    public_id: StrView
    system_id: StrView

# Parse error event data
pub struct ParseErrorEvent
    kind: i32               # PARSE_ERROR_*
    message: StrView
    line: u32
    col: u32

# Parse warning event data
pub struct ParseWarningEvent
    kind: i32               # PARSE_WARNING_*
    message: StrView
    line: u32
    col: u32

# =============================================================================
# Event Sink (a trait; the parser is generic over it)
# =============================================================================

# The parser calls these methods to emit events. A sink is any type that
# implements EventSink; the emit_* helpers, TreeBuilder<S> and HtmlParser<S>
# are generic over it (LARB R55), so each call resolves at compile time from
# the sink's concrete type. There is no run-time choice of sink (R80: no
# dyn, no fn-pointer tables). The event data is lent read-only (`@T`),
# because an ElementStartEvent carries 64 attributes and isn't worth copying
# per call.
#
# Tempest implements it on its bridge (lib/lexis_bridge.ritz):
#
#   impl EventSink for LexisParser
#       fn on_text(self:&, event: @TextEvent)
#           # ... queue ParseEvent.Text { content: event.content } on self ...
#       ...
#
#   var hp = html_parser_new(source, lexis_parser_new())
#   html_parser_run(hp)

pub trait EventSink
    fn on_document_start(self:&)
    fn on_document_end(self:&)
    fn on_element_start(self:&, event: @ElementStartEvent)
    fn on_element_end(self:&, event: @ElementEndEvent)
    fn on_text(self:&, event: @TextEvent)
    fn on_comment(self:&, event: @CommentEvent)
    fn on_doctype(self:&, event: @DoctypeEvent)
    fn on_error(self:&, event: @ParseErrorEvent)
    fn on_warning(self:&, event: @ParseWarningEvent)

# =============================================================================
# No-Op Sink
# =============================================================================

# A sink whose every method does nothing - for tests, or a parse whose
# events nobody reads.
pub struct NoOpSink

impl EventSink for NoOpSink
    fn on_document_start(self:&)
        pass

    fn on_document_end(self:&)
        pass

    fn on_element_start(self:&, event: @ElementStartEvent)
        pass

    fn on_element_end(self:&, event: @ElementEndEvent)
        pass

    fn on_text(self:&, event: @TextEvent)
        pass

    fn on_comment(self:&, event: @CommentEvent)
        pass

    fn on_doctype(self:&, event: @DoctypeEvent)
        pass

    fn on_error(self:&, event: @ParseErrorEvent)
        pass

    fn on_warning(self:&, event: @ParseWarningEvent)
        pass

# =============================================================================
# Event Emitter Helpers
# =============================================================================

# Build the event and call the sink's matching method.
# These are used internally by the parser.

pub fn emit_document_start<S: EventSink>(sink:& S)
    sink.on_document_start()

pub fn emit_document_end<S: EventSink>(sink:& S)
    sink.on_document_end()

# `attrs` points at `attr_count` attributes (the tokenizer's StartTagToken.attrs),
# or is null with attr_count 0 for an implied element. They are copied into the
# event's fixed array, capped at its 64 slots.
pub fn emit_element_start<S: EventSink>(sink:& S, tag: Tag, attrs: *Attribute, attr_count: u32, self_closing: i32)
    var event: ElementStartEvent
    event.tag = tag
    event.attr_count = 0
    event.self_closing = self_closing
    if attrs != null
        while event.attr_count < attr_count and event.attr_count < 64
            event.attrs[event.attr_count] = attrs[event.attr_count]
            event.attr_count = event.attr_count + 1
    sink.on_element_start(@event)

pub fn emit_element_end<S: EventSink>(sink:& S, tag: Tag)
    let event = ElementEndEvent { tag: tag }
    sink.on_element_end(@event)

pub fn emit_text<S: EventSink>(sink:& S, content: StrView)
    let event = TextEvent { content: content }
    sink.on_text(@event)

pub fn emit_comment<S: EventSink>(sink:& S, content: StrView)
    let event = CommentEvent { content: content }
    sink.on_comment(@event)

pub fn emit_doctype<S: EventSink>(sink:& S, name: StrView, public_id: StrView, system_id: StrView)
    let event = DoctypeEvent {
        name: name,
        public_id: public_id,
        system_id: system_id
    }
    sink.on_doctype(@event)

pub fn emit_error<S: EventSink>(sink:& S, kind: i32, message: StrView, line: u32, col: u32)
    let event = ParseErrorEvent {
        kind: kind,
        message: message,
        line: line,
        col: col
    }
    sink.on_error(@event)

pub fn emit_warning<S: EventSink>(sink:& S, kind: i32, message: StrView, line: u32, col: u32)
    let event = ParseWarningEvent {
        kind: kind,
        message: message,
        line: line,
        col: col
    }
    sink.on_warning(@event)
