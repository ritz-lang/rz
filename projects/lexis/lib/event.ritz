# lib/event.ritz - DOM Events emitted by Lexis parser
#
# These events are emitted during streaming HTML/CSS parsing.
# Tempest receives these events and builds/updates its DOM tree.

import lib.dom.tag { Tag }
import lib.dom.attribute { Attribute }

# =============================================================================
# DOM Event Types
# =============================================================================

# Event type constants
pub const DOM_EVENT_DOCUMENT_START: i32 = 0
pub const DOM_EVENT_DOCUMENT_END: i32 = 1
pub const DOM_EVENT_ELEMENT_START: i32 = 2
pub const DOM_EVENT_ELEMENT_END: i32 = 3
pub const DOM_EVENT_TEXT: i32 = 4
pub const DOM_EVENT_COMMENT: i32 = 5
pub const DOM_EVENT_DOCTYPE: i32 = 6
pub const DOM_EVENT_STYLESHEET_PARSED: i32 = 7
pub const DOM_EVENT_PARSE_ERROR: i32 = 8
pub const DOM_EVENT_PARSE_WARNING: i32 = 9

# =============================================================================
# Error/Warning Kinds
# =============================================================================

pub const PARSE_ERROR_UNEXPECTED_TOKEN: i32 = 0
pub const PARSE_ERROR_UNEXPECTED_EOF: i32 = 1
pub const PARSE_ERROR_INVALID_TAG: i32 = 2
pub const PARSE_ERROR_UNCLOSED_TAG: i32 = 3
pub const PARSE_ERROR_INVALID_ATTRIBUTE: i32 = 4
pub const PARSE_ERROR_DUPLICATE_ATTRIBUTE: i32 = 5
pub const PARSE_ERROR_INVALID_ENTITY: i32 = 6
pub const PARSE_ERROR_NESTING_ERROR: i32 = 7

pub const PARSE_WARNING_UNKNOWN_PROPERTY: i32 = 0
pub const PARSE_WARNING_INVALID_VALUE: i32 = 1
pub const PARSE_WARNING_DEPRECATED: i32 = 2
pub const PARSE_WARNING_QUIRKS_MODE: i32 = 3

# =============================================================================
# Event Data Structures
# =============================================================================

# Element start event data
pub struct ElementStartEvent
    tag: Tag
    attrs: [64]Attribute    # Fixed-size attribute array
    attr_count: u32         # Number of attributes
    self_closing: i32       # 1 if self-closing (e.g., <br/>)

# Element end event data
pub struct ElementEndEvent
    tag: Tag

# Text content event data
pub struct TextEvent
    content: StrView

# Comment event data
pub struct CommentEvent
    content: StrView

# DOCTYPE event data
pub struct DoctypeEvent
    name: StrView
    public_id: StrView
    system_id: StrView

# Parse error event data
pub struct ParseErrorEvent
    kind: i32               # PARSE_ERROR_*
    message: StrView
    line: u32
    col: u32

# Parse warning event data
pub struct ParseWarningEvent
    kind: i32               # PARSE_WARNING_*
    message: StrView
    line: u32
    col: u32

# =============================================================================
# Event Handler (a struct of fn pointers)
# =============================================================================

# The parser calls these fns to emit events. Ritz has no dynamic dispatch, no
# trait bound on a generic parameter and no `dyn Trait` (LANGUAGE_SPEC §5.5,
# §5.6, LARB R41), so a sink is a struct of fn-pointer fields plus `ctx`, the
# state a closure would have captured. Every callback gets `ctx` back as its
# first argument; the event data is lent read-only (`@T`), because an
# ElementStartEvent carries 64 attributes and isn't worth copying per call.
#
# Tempest implements it (lib/lexis_bridge.ritz polls ParseEvents, so its
# callbacks push onto the queue that ctx points at):
#
#   fn bridge_on_text(ctx: *u8, event: @TextEvent)
#       let p = ctx as *LexisParser
#       # ... queue ParseEvent.Text { content: event.content } on p ...
#
#   var h = no_op_handler_new()       # start from no-ops,
#   h.ctx = @&parser as *u8          # point ctx at the receiver,
#   h.on_text = bridge_on_text       # and override what you care about
#   var hp = html_parser_new(source, h)
#   html_parser_run(hp)

pub struct EventHandler
    ctx: *u8
    on_document_start: fn(*u8)
    on_document_end: fn(*u8)
    on_element_start: fn(*u8, @ElementStartEvent)
    on_element_end: fn(*u8, @ElementEndEvent)
    on_text: fn(*u8, @TextEvent)
    on_comment: fn(*u8, @CommentEvent)
    on_doctype: fn(*u8, @DoctypeEvent)
    on_error: fn(*u8, @ParseErrorEvent)
    on_warning: fn(*u8, @ParseWarningEvent)

# =============================================================================
# Default No-Op Handler
# =============================================================================

# A handler whose every callback does nothing - useful for testing, or as the
# starting point when you only care about certain events (override the fields
# you want). Its ctx is null.

fn no_op_document(ctx: *u8)
    pass

fn no_op_element_start(ctx: *u8, event: @ElementStartEvent)
    pass

fn no_op_element_end(ctx: *u8, event: @ElementEndEvent)
    pass

fn no_op_text(ctx: *u8, event: @TextEvent)
    pass

fn no_op_comment(ctx: *u8, event: @CommentEvent)
    pass

fn no_op_doctype(ctx: *u8, event: @DoctypeEvent)
    pass

fn no_op_error(ctx: *u8, event: @ParseErrorEvent)
    pass

fn no_op_warning(ctx: *u8, event: @ParseWarningEvent)
    pass

pub fn no_op_handler_new() -> EventHandler
    EventHandler {
        ctx: null,
        on_document_start: no_op_document,
        on_document_end: no_op_document,
        on_element_start: no_op_element_start,
        on_element_end: no_op_element_end,
        on_text: no_op_text,
        on_comment: no_op_comment,
        on_doctype: no_op_doctype,
        on_error: no_op_error,
        on_warning: no_op_warning
    }

# =============================================================================
# Event Emitter Helpers
# =============================================================================

# Build the event and call the matching callback with the handler's ctx.
# These are used internally by the parser.

pub fn emit_document_start(handler:& EventHandler)
    handler.on_document_start(handler.ctx)

pub fn emit_document_end(handler:& EventHandler)
    handler.on_document_end(handler.ctx)

# `attrs` points at `attr_count` attributes (the tokenizer's StartTagToken.attrs),
# or is null with attr_count 0 for an implied element. They are copied into the
# event's fixed array, capped at its 64 slots.
pub fn emit_element_start(handler:& EventHandler, tag: Tag, attrs: *Attribute, attr_count: u32, self_closing: i32)
    var event: ElementStartEvent
    event.tag = tag
    event.attr_count = 0
    event.self_closing = self_closing
    if attrs != null
        while event.attr_count < attr_count and event.attr_count < 64
            event.attrs[event.attr_count] = attrs[event.attr_count]
            event.attr_count = event.attr_count + 1
    handler.on_element_start(handler.ctx, @event)

pub fn emit_element_end(handler:& EventHandler, tag: Tag)
    let event = ElementEndEvent { tag: tag }
    handler.on_element_end(handler.ctx, @event)

pub fn emit_text(handler:& EventHandler, content: StrView)
    let event = TextEvent { content: content }
    handler.on_text(handler.ctx, @event)

pub fn emit_comment(handler:& EventHandler, content: StrView)
    let event = CommentEvent { content: content }
    handler.on_comment(handler.ctx, @event)

pub fn emit_doctype(handler:& EventHandler, name: StrView, public_id: StrView, system_id: StrView)
    let event = DoctypeEvent {
        name: name,
        public_id: public_id,
        system_id: system_id
    }
    handler.on_doctype(handler.ctx, @event)

pub fn emit_error(handler:& EventHandler, kind: i32, message: StrView, line: u32, col: u32)
    let event = ParseErrorEvent {
        kind: kind,
        message: message,
        line: line,
        col: col
    }
    handler.on_error(handler.ctx, @event)

pub fn emit_warning(handler:& EventHandler, kind: i32, message: StrView, line: u32, col: u32)
    let event = ParseWarningEvent {
        kind: kind,
        message: message,
        line: line,
        col: col
    }
    handler.on_warning(handler.ctx, @event)
