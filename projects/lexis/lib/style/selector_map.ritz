# lib/style/selector_map.ritz - Indexed Selector Storage
#
# Indexes CSS rules by their key (rightmost) selector for fast lookup.
# Instead of checking every rule against every element, we only check
# rules that could possibly match based on the element's ID, classes, or tag.
#
# Example: For element <div class="foo bar" id="main">, we check:
#   - id_rules["main"]
#   - class_rules["foo"]
#   - class_rules["bar"]
#   - tag_rules["div"]
#   - universal_rules

import ritzlib.gvec
import lib.css.selector { ComplexSelector, CompoundSelector, SimpleSelector, Specificity,
                          SELECTOR_ID, SELECTOR_CLASS, SELECTOR_TYPE, SELECTOR_UNIVERSAL,
                          complex_selector_specificity }
import lib.css.rule { Stylesheet, StyleRule, Declaration, DeclarationBlock, stylesheet_selector }

# =============================================================================
# Rule Entry
# =============================================================================

# A single rule entry in the index
pub struct RuleEntry
    selector: ComplexSelector
    declarations: DeclarationBlock
    specificity: Specificity
    source_order: u32
    next: i32               # next entry in the same bucket, -1 at the end

pub fn rule_entry_new(selector: ComplexSelector, declarations: DeclarationBlock, order: u32) -> RuleEntry
    RuleEntry {
        selector: selector,
        declarations: declarations,
        specificity: complex_selector_specificity(selector),
        source_order: order,
        next: -1
    }

# =============================================================================
# Buckets
# =============================================================================

# A bucket is a singly linked chain of entry indices through RuleEntry.next,
# head to tail in insertion order. It used to be a fixed [256]RuleEntry per
# hash slot, 769 of them per map: a SelectorMap was ~56 GB and StyleEngine
# ~167 GB, by value, on the stack (#3700). Now every entry lives once in the
# map's heap array and a bucket is two ints.
pub struct RuleBucket
    head: i32
    tail: i32
    count: u32

pub fn rule_bucket_new() -> RuleBucket
    RuleBucket { head: -1, tail: -1, count: 0 }

# =============================================================================
# Hash Map for Rule Storage
# =============================================================================

const HASH_MAP_SIZE: u32 = 256

fn hash_string(s: StrView) -> u32
    var hash: u32 = 5381
    var i: u64 = 0
    while i < s.len
        # djb2 wraps u32 by design (LARB R63).
        hash = ((hash << 5) +% hash) +% s.ptr[i] as u32
        i = i + 1
    hash % HASH_MAP_SIZE

# =============================================================================
# Selector Map
# =============================================================================

# Buckets are keyed by hash slot only: two keys sharing a slot share a
# bucket, which is fine because candidates are only a superset to run full
# selector matching on.
#
# The map owns `entries`. Growing it moves the entries,
# so RuleEntry pointers from selector_map_get_candidates are valid only until
# the next selector_map_add_rule.
pub struct SelectorMap
    entries: Vec<RuleEntry>

    id_rules: [HASH_MAP_SIZE]RuleBucket
    class_rules: [HASH_MAP_SIZE]RuleBucket
    tag_rules: [HASH_MAP_SIZE]RuleBucket

    # Universal selector rules (match everything)
    universal_rules: RuleBucket

pub fn selector_map_new() -> SelectorMap
    var map: SelectorMap
    map.entries = vec_new<RuleEntry>()

    var i: u32 = 0
    while i < HASH_MAP_SIZE
        map.id_rules[i] = rule_bucket_new()
        map.class_rules[i] = rule_bucket_new()
        map.tag_rules[i] = rule_bucket_new()
        i = i + 1

    map.universal_rules = rule_bucket_new()

    map

# Which bucket array bucket_push appends to.
const BUCKET_ID: i32 = 0
const BUCKET_CLASS: i32 = 1
const BUCKET_TAG: i32 = 2
const BUCKET_UNIVERSAL: i32 = 3

# Store `entry` in the map's array and append it to bucket `slot` of `which`
# (slot is ignored for BUCKET_UNIVERSAL). A failed allocation drops the rule,
# as a full fixed bucket used to.
fn bucket_push(map:& SelectorMap, which: i32, slot: u32, entry: @RuleEntry)
    if not map.entries.push(*entry)
        return
    let idx = (map.entries.len() - 1) as i32
    map.entries[idx].next = -1

    if which == BUCKET_ID
        link_tail(@&map.entries, map.id_rules[slot], idx)
    else if which == BUCKET_CLASS
        link_tail(@&map.entries, map.class_rules[slot], idx)
    else if which == BUCKET_TAG
        link_tail(@&map.entries, map.tag_rules[slot], idx)
    else
        link_tail(@&map.entries, map.universal_rules, idx)

fn link_tail(entries: @&Vec<RuleEntry>, bucket:& RuleBucket, idx: i32)
    if bucket.tail >= 0
        entries[bucket.tail].next = idx
    else
        bucket.head = idx
    bucket.tail = idx
    bucket.count = bucket.count + 1

# =============================================================================
# Indexing Rules
# =============================================================================

# `rule` is one of `sheet`'s rules.
pub fn selector_map_add_rule(map:& SelectorMap, sheet: @Stylesheet, rule: @StyleRule)
    # For each selector in the rule
    var sel_idx: i64 = 0
    while sel_idx < rule.selectors.count
        let entry = rule_entry_new(stylesheet_selector(sheet, rule.selectors, sel_idx), rule.declarations, rule.source_order)

        # Get the key selector (rightmost compound selector)
        if entry.selector.compound_count > 0
            index_by_key_selector(map, @entry, @entry.selector.compounds[entry.selector.compound_count - 1])

        sel_idx = sel_idx + 1

# The selector's value as a view into `s` itself. simple_selector_value takes
# its SimpleSelector by value, so its view points into the callee's copy.
fn simple_key(s: @SimpleSelector) -> StrView
    StrView { ptr: @s.value[0], len: s.value_len as u64 }

fn index_by_key_selector(map:& SelectorMap, entry: @RuleEntry, compound: @CompoundSelector)
    # Index by the most restrictive simple selector: ID > class > tag, else
    # universal. (It used to add a rule under both its class and its tag, so
    # `p.x` matched twice and ran through the cascade twice.)
    var class_at: i32 = -1
    var tag_at: i32 = -1

    var i: u32 = 0
    while i < compound.simple_count
        let kind = compound.simple[i].kind
        if kind == SELECTOR_ID
            let hash = hash_string(simple_key(@compound.simple[i]))
            bucket_push(map, BUCKET_ID, hash, entry)
            return
        if kind == SELECTOR_CLASS and class_at < 0
            class_at = i as i32
        else if kind == SELECTOR_TYPE and tag_at < 0
            tag_at = i as i32
        i = i + 1

    if class_at >= 0
        let hash = hash_string(simple_key(@compound.simple[class_at]))
        bucket_push(map, BUCKET_CLASS, hash, entry)
    else if tag_at >= 0
        let hash = hash_string(simple_key(@compound.simple[tag_at]))
        bucket_push(map, BUCKET_TAG, hash, entry)
    else
        bucket_push(map, BUCKET_UNIVERSAL, 0, entry)

# =============================================================================
# Looking Up Rules
# =============================================================================

# Get rules that might match an element with given ID, classes, and tag
# Caller should then do full selector matching on these candidates

const MAX_CANDIDATE_RULES: u32 = 512

# Pointers into the map's entries (see SelectorMap for how long they live).
# 4 KB, where 512 RuleEntry copies were 145 MB.
pub struct RuleCandidates
    rules: [MAX_CANDIDATE_RULES]*RuleEntry
    count: u32

pub fn rule_candidates_new() -> RuleCandidates
    var c: RuleCandidates
    c.count = 0
    c

pub fn selector_map_get_candidates(map: @SelectorMap, id: StrView, classes: StrView, tag: StrView) -> RuleCandidates
    var candidates = rule_candidates_new()

    # Add ID rules
    if id.len > 0
        let hash = hash_string(id)
        add_bucket_to_candidates(candidates, map, map.id_rules[hash])

    # Add class rules (need to split classes by space)
    if classes.len > 0
        # For each class in the space-separated list
        var start: u64 = 0
        var i: u64 = 0
        while i <= classes.len
            if i == classes.len or classes.ptr[i] == ' '
                if i > start
                    let class_name = StrView {
                        ptr: @classes.ptr[start],
                        len: i - start
                    }
                    let hash = hash_string(class_name)
                    add_bucket_to_candidates(candidates, map, map.class_rules[hash])
                start = i + 1
            i = i + 1

    # Add tag rules
    if tag.len > 0
        let hash = hash_string(tag)
        add_bucket_to_candidates(candidates, map, map.tag_rules[hash])

    # Add universal rules
    add_bucket_to_candidates(candidates, map, map.universal_rules)

    candidates

fn add_bucket_to_candidates(candidates:& RuleCandidates, map: @SelectorMap, bucket: RuleBucket)
    var idx = bucket.head
    while idx >= 0 and candidates.count < MAX_CANDIDATE_RULES
        candidates.rules[candidates.count] = map.entries.as_ptr() + idx
        candidates.count = candidates.count + 1
        idx = (@map.entries[idx]).next

# =============================================================================
# Statistics (for debugging)
# =============================================================================

pub struct SelectorMapStats
    id_rule_count: u32
    class_rule_count: u32
    tag_rule_count: u32
    universal_rule_count: u32

pub fn selector_map_stats(map: @SelectorMap) -> SelectorMapStats
    var stats: SelectorMapStats
    stats.id_rule_count = 0
    stats.class_rule_count = 0
    stats.tag_rule_count = 0
    stats.universal_rule_count = map.universal_rules.count

    var i: u32 = 0
    while i < HASH_MAP_SIZE
        stats.id_rule_count = stats.id_rule_count + map.id_rules[i].count
        stats.class_rule_count = stats.class_rule_count + map.class_rules[i].count
        stats.tag_rule_count = stats.tag_rule_count + map.tag_rules[i].count
        i = i + 1

    stats
