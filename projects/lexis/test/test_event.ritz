# test/test_event.ritz - events reach a handler that isn't the no-op one (#2216)
#
# EventHandler is a struct of fn pointers plus a ctx (Ritz has no dynamic
# dispatch). These tests build a recording handler, the way tempest's
# lexis_bridge would, and check each emit_* helper calls its own callback with
# the handler's ctx and the event's data.

import lib.event { EventHandler, no_op_handler_new, emit_document_start, emit_document_end, emit_element_start, emit_element_end, emit_text, emit_comment, emit_doctype, emit_error, emit_warning, ElementStartEvent, ElementEndEvent, TextEvent, CommentEvent, DoctypeEvent, ParseErrorEvent, ParseWarningEvent, PARSE_ERROR_UNCLOSED_TAG, PARSE_WARNING_DEPRECATED }
import lib.dom.tag { Tag }
import lib.dom.attribute { Attribute }

# What the recording callbacks saw. One counter per callback, so a helper
# that calls the wrong callback shows up as the wrong counter moving.
struct Recorder
    document_starts: i32
    document_ends: i32
    element_starts: i32
    element_ends: i32
    texts: i32
    comments: i32
    doctypes: i32
    errors: i32
    warnings: i32
    last_len: i64           # len of the last StrView payload seen
    last_attr_count: u32
    last_self_closing: i32
    last_kind: i32
    last_line: u32
    last_col: u32

fn recorder_new() -> Recorder
    Recorder {
        document_starts: 0, document_ends: 0, element_starts: 0, element_ends: 0,
        texts: 0, comments: 0, doctypes: 0, errors: 0, warnings: 0,
        last_len: 0, last_attr_count: 0, last_self_closing: 0,
        last_kind: -1, last_line: 0, last_col: 0
    }

fn rec_document_start(ctx: *u8)
    let r = ctx as *Recorder
    r.document_starts = r.document_starts + 1

fn rec_document_end(ctx: *u8)
    let r = ctx as *Recorder
    r.document_ends = r.document_ends + 1

fn rec_element_start(ctx: *u8, event: @ElementStartEvent)
    let r = ctx as *Recorder
    r.element_starts = r.element_starts + 1
    r.last_attr_count = event.attr_count
    r.last_self_closing = event.self_closing

fn rec_element_end(ctx: *u8, event: @ElementEndEvent)
    let r = ctx as *Recorder
    r.element_ends = r.element_ends + 1

fn rec_text(ctx: *u8, event: @TextEvent)
    let r = ctx as *Recorder
    r.texts = r.texts + 1
    r.last_len = event.content.len as i64

fn rec_comment(ctx: *u8, event: @CommentEvent)
    let r = ctx as *Recorder
    r.comments = r.comments + 1
    r.last_len = event.content.len as i64

fn rec_doctype(ctx: *u8, event: @DoctypeEvent)
    let r = ctx as *Recorder
    r.doctypes = r.doctypes + 1
    r.last_len = event.name.len as i64

fn rec_error(ctx: *u8, event: @ParseErrorEvent)
    let r = ctx as *Recorder
    r.errors = r.errors + 1
    r.last_kind = event.kind
    r.last_line = event.line
    r.last_col = event.col

fn rec_warning(ctx: *u8, event: @ParseWarningEvent)
    let r = ctx as *Recorder
    r.warnings = r.warnings + 1
    r.last_kind = event.kind
    r.last_line = event.line
    r.last_col = event.col

fn recording_handler(r: *Recorder) -> EventHandler
    EventHandler {
        ctx: r as *u8,
        on_document_start: rec_document_start,
        on_document_end: rec_document_end,
        on_element_start: rec_element_start,
        on_element_end: rec_element_end,
        on_text: rec_text,
        on_comment: rec_comment,
        on_doctype: rec_doctype,
        on_error: rec_error,
        on_warning: rec_warning
    }

# Sum of every counter: a helper that fires exactly one callback moves it by 1.
fn total(r: @Recorder) -> i32
    r.document_starts + r.document_ends + r.element_starts + r.element_ends + r.texts + r.comments + r.doctypes + r.errors + r.warnings

[[test]]
fn test_document_start_and_end_reach_handler() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_document_start(h)
    assert r.document_starts == 1
    assert total(@r) == 1
    emit_document_end(h)
    assert r.document_ends == 1
    assert total(@r) == 2
    0

[[test]]
fn test_text_reaches_handler_with_content() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_text(h, "hello")
    assert r.texts == 1
    assert r.last_len == 5
    assert total(@r) == 1
    0

[[test]]
fn test_comment_reaches_handler_with_content() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_comment(h, "note")
    assert r.comments == 1
    assert r.last_len == 4
    assert total(@r) == 1
    0

[[test]]
fn test_doctype_reaches_handler_with_name() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_doctype(h, "html", "", "")
    assert r.doctypes == 1
    assert r.last_len == 4
    assert total(@r) == 1
    0

[[test]]
fn test_element_start_copies_attrs_and_flag() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    var attrs: [2]Attribute
    emit_element_start(h, Tag.Br, @&attrs[0] as *Attribute, 2, 1)
    assert r.element_starts == 1
    assert r.last_attr_count == 2
    assert r.last_self_closing == 1
    assert total(@r) == 1
    0

[[test]]
fn test_element_start_with_null_attrs_has_none() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_element_start(h, Tag.Html, null, 0, 0)
    assert r.element_starts == 1
    assert r.last_attr_count == 0
    assert r.last_self_closing == 0
    0

[[test]]
fn test_element_end_reaches_handler() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_element_end(h, Tag.Html)
    assert r.element_ends == 1
    assert total(@r) == 1
    0

[[test]]
fn test_error_reaches_handler_with_position() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_error(h, PARSE_ERROR_UNCLOSED_TAG, "unclosed", 3, 7)
    assert r.errors == 1
    assert r.last_kind == PARSE_ERROR_UNCLOSED_TAG
    assert r.last_line == 3
    assert r.last_col == 7
    assert total(@r) == 1
    0

[[test]]
fn test_warning_reaches_handler_with_position() -> i32
    var r = recorder_new()
    var h = recording_handler(@&r as *Recorder)
    emit_warning(h, PARSE_WARNING_DEPRECATED, "old", 9, 2)
    assert r.warnings == 1
    assert r.last_kind == PARSE_WARNING_DEPRECATED
    assert r.last_line == 9
    assert r.last_col == 2
    assert total(@r) == 1
    0

# The no-op handler accepts every event and has no ctx to write through.
[[test]]
fn test_no_op_handler_accepts_every_event() -> i32
    var h = no_op_handler_new()
    assert h.ctx == null
    emit_document_start(h)
    emit_text(h, "x")
    emit_element_start(h, Tag.Html, null, 0, 0)
    emit_element_end(h, Tag.Html)
    emit_comment(h, "c")
    emit_doctype(h, "html", "", "")
    emit_error(h, PARSE_ERROR_UNCLOSED_TAG, "e", 1, 1)
    emit_warning(h, PARSE_WARNING_DEPRECATED, "w", 1, 1)
    emit_document_end(h)
    0
