# test/test_event.ritz - events reach a sink that isn't the no-op one (#2216, #4012)
#
# A sink is any type that implements `trait EventSink`; the emit_* helpers and
# the parser are generic over it, so each call resolves at compile time (no
# fn pointers, no ctx cast: LARB R80, R55). These tests implement EventSink on
# a recording struct, the way tempest's lexis_bridge does, and check each
# emit_* helper calls its own method with the event's data.

import lib.event { EventSink, NoOpSink, emit_document_start, emit_document_end, emit_element_start, emit_element_end, emit_text, emit_comment, emit_doctype, emit_error, emit_warning, ElementStartEvent, ElementEndEvent, TextEvent, CommentEvent, DoctypeEvent, ParseErrorEvent, ParseWarningEvent, PARSE_ERROR_UNCLOSED_TAG, PARSE_WARNING_DEPRECATED }
import lib.dom.tag { Tag }
import lib.dom.attribute { Attribute }
import lib.lexis { HtmlParser, html_parser_new, html_parser_run }

# What the sink saw. One counter per method, so a helper that calls the
# wrong method shows up as the wrong counter moving.
struct Recorder
    document_starts: i32
    document_ends: i32
    element_starts: i32
    element_ends: i32
    texts: i32
    comments: i32
    doctypes: i32
    errors: i32
    warnings: i32
    last_len: i64           # len of the last StrView payload seen
    last_attr_count: u32
    last_self_closing: i32
    last_kind: i32
    last_line: u32
    last_col: u32

fn recorder_new() -> Recorder
    Recorder {
        document_starts: 0, document_ends: 0, element_starts: 0, element_ends: 0,
        texts: 0, comments: 0, doctypes: 0, errors: 0, warnings: 0,
        last_len: 0, last_attr_count: 0, last_self_closing: 0,
        last_kind: -1, last_line: 0, last_col: 0
    }

impl EventSink for Recorder
    fn on_document_start(self:&)
        self.document_starts = self.document_starts + 1

    fn on_document_end(self:&)
        self.document_ends = self.document_ends + 1

    fn on_element_start(self:&, event: @ElementStartEvent)
        self.element_starts = self.element_starts + 1
        self.last_attr_count = event.attr_count
        self.last_self_closing = event.self_closing

    fn on_element_end(self:&, event: @ElementEndEvent)
        self.element_ends = self.element_ends + 1

    fn on_text(self:&, event: @TextEvent)
        self.texts = self.texts + 1
        self.last_len = event.content.len as i64

    fn on_comment(self:&, event: @CommentEvent)
        self.comments = self.comments + 1
        self.last_len = event.content.len as i64

    fn on_doctype(self:&, event: @DoctypeEvent)
        self.doctypes = self.doctypes + 1
        self.last_len = event.name.len as i64

    fn on_error(self:&, event: @ParseErrorEvent)
        self.errors = self.errors + 1
        self.last_kind = event.kind
        self.last_line = event.line
        self.last_col = event.col

    fn on_warning(self:&, event: @ParseWarningEvent)
        self.warnings = self.warnings + 1
        self.last_kind = event.kind
        self.last_line = event.line
        self.last_col = event.col

# Sum of every counter: a helper that fires exactly one method moves it by 1.
fn total(r: @Recorder) -> i32
    r.document_starts + r.document_ends + r.element_starts + r.element_ends + r.texts + r.comments + r.doctypes + r.errors + r.warnings

[[test]]
fn test_document_start_and_end_reach_sink() -> i32
    var r = recorder_new()
    emit_document_start(r)
    assert r.document_starts == 1
    assert total(@r) == 1
    emit_document_end(r)
    assert r.document_ends == 1
    assert total(@r) == 2
    0

[[test]]
fn test_text_reaches_sink_with_content() -> i32
    var r = recorder_new()
    emit_text(r, "hello")
    assert r.texts == 1
    assert r.last_len == 5
    assert total(@r) == 1
    0

[[test]]
fn test_comment_reaches_sink_with_content() -> i32
    var r = recorder_new()
    emit_comment(r, "note")
    assert r.comments == 1
    assert r.last_len == 4
    assert total(@r) == 1
    0

[[test]]
fn test_doctype_reaches_sink_with_name() -> i32
    var r = recorder_new()
    emit_doctype(r, "html", "", "")
    assert r.doctypes == 1
    assert r.last_len == 4
    assert total(@r) == 1
    0

[[test]]
fn test_element_start_copies_attrs_and_flag() -> i32
    var r = recorder_new()
    var attrs: [2]Attribute
    emit_element_start(r, Tag.Br, @&attrs[0] as *Attribute, 2, 1)
    assert r.element_starts == 1
    assert r.last_attr_count == 2
    assert r.last_self_closing == 1
    assert total(@r) == 1
    0

[[test]]
fn test_element_start_with_null_attrs_has_none() -> i32
    var r = recorder_new()
    emit_element_start(r, Tag.Html, null, 0, 0)
    assert r.element_starts == 1
    assert r.last_attr_count == 0
    assert r.last_self_closing == 0
    0

[[test]]
fn test_element_end_reaches_sink() -> i32
    var r = recorder_new()
    emit_element_end(r, Tag.Html)
    assert r.element_ends == 1
    assert total(@r) == 1
    0

[[test]]
fn test_error_reaches_sink_with_position() -> i32
    var r = recorder_new()
    emit_error(r, PARSE_ERROR_UNCLOSED_TAG, "unclosed", 3, 7)
    assert r.errors == 1
    assert r.last_kind == PARSE_ERROR_UNCLOSED_TAG
    assert r.last_line == 3
    assert r.last_col == 7
    assert total(@r) == 1
    0

[[test]]
fn test_warning_reaches_sink_with_position() -> i32
    var r = recorder_new()
    emit_warning(r, PARSE_WARNING_DEPRECATED, "old", 9, 2)
    assert r.warnings == 1
    assert r.last_kind == PARSE_WARNING_DEPRECATED
    assert r.last_line == 9
    assert r.last_col == 2
    assert total(@r) == 1
    0

# The parser owns its sink by value (HtmlParser<S>.tree_builder.sink): a
# document parsed through html_parser_run reaches the Recorder's methods.
[[test]]
fn test_parser_drives_recording_sink() -> i32
    var hp = html_parser_new("<p>hi</p>", recorder_new())
    html_parser_run(hp)
    let r = @hp.tree_builder.sink
    assert r.element_starts >= 1
    assert r.texts >= 1
    0

# The no-op sink accepts every event.
[[test]]
fn test_no_op_sink_accepts_every_event() -> i32
    var s = NoOpSink {}
    emit_document_start(s)
    emit_text(s, "x")
    emit_element_start(s, Tag.Html, null, 0, 0)
    emit_element_end(s, Tag.Html)
    emit_comment(s, "c")
    emit_doctype(s, "html", "", "")
    emit_error(s, PARSE_ERROR_UNCLOSED_TAG, "e", 1, 1)
    emit_warning(s, PARSE_WARNING_DEPRECATED, "w", 1, 1)
    emit_document_end(s)
    0

# A parser over the no-op sink runs a whole document.
[[test]]
fn test_parser_runs_with_no_op_sink() -> i32
    var hp = html_parser_new("<html><body>x</body></html>", NoOpSink {})
    html_parser_run(hp)
    0
