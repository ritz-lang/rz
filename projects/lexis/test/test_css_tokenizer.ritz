# test/test_css_tokenizer.ritz - CSS Tokenizer Tests
#
# Restored from 04e6a822 and rewritten against the current lib API (AGAST
# #3698). The old file declared a local no-op `fn assert`; `assert` is a
# keyword now, so the file never compiled and every check was dead. These
# asserts are real: a wrong token kind or value fails the test.

import lib.css.tokenizer { CssTokenizer, css_tokenizer_new, css_tokenizer_next }
import lib.css.token

# Pull the next token and check its kind. Lives here rather than in each test
# so the failure message carries the expected kind. Needs [[test_helper]]
# because it asserts on the caller's behalf.
[[test_helper]]
fn expect_token(t:& CssTokenizer, kind: i32) -> CssToken
    let tok = css_tokenizer_next(t)
    assert tok.kind == kind, "unexpected token kind"
    tok

# 1 when the token's value buffer is exactly `want`.
fn token_value_is(tok: CssToken, want: StrView) -> i32
    css_token_value_eq(tok, want)

# =============================================================================
# Basic Token Tests
# =============================================================================

[[test]]
fn test_css_whitespace() -> i32
    var t = css_tokenizer_new("   \t\n  ")
    let tok = expect_token(t, CSS_TOKEN_WHITESPACE)
    assert tok.value_len == 0, "whitespace carries no value"
    let eof = css_tokenizer_next(t)
    assert eof.kind == CSS_TOKEN_EOF, "expected EOF after whitespace"
    0

[[test]]
fn test_css_ident() -> i32
    var t = css_tokenizer_new("margin-left")
    let tok = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(tok, "margin-left") == 1, "ident value should be margin-left"
    let eof = css_tokenizer_next(t)
    assert eof.kind == CSS_TOKEN_EOF, "expected EOF"
    0

[[test]]
fn test_css_function() -> i32
    var t = css_tokenizer_new("rgb(")
    let tok = expect_token(t, CSS_TOKEN_FUNCTION)
    assert token_value_is(tok, "rgb") == 1, "function name should be rgb"
    0

[[test]]
fn test_css_hash_id() -> i32
    var t = css_tokenizer_new("#container")
    let tok = expect_token(t, CSS_TOKEN_HASH)
    assert tok.hash_type == HASH_ID, "a name-start after # is an ID hash"
    assert token_value_is(tok, "container") == 1, "hash value should be container"
    0

[[test]]
fn test_css_hash_color() -> i32
    var t = css_tokenizer_new("#ff0000")
    let tok = expect_token(t, CSS_TOKEN_HASH)
    assert token_value_is(tok, "ff0000") == 1, "hash value should be ff0000"
    0

[[test]]
fn test_css_hash_digit_is_unrestricted() -> i32
    # A hash whose first char is a digit is not an ID hash (CSS Syntax §4.3.1).
    var t = css_tokenizer_new("#123abc")
    let tok = expect_token(t, CSS_TOKEN_HASH)
    assert tok.hash_type == HASH_UNRESTRICTED, "digit-leading hash is unrestricted"
    assert token_value_is(tok, "123abc") == 1, "hash value should be 123abc"
    0

[[test]]
fn test_css_string_double() -> i32
    var t = css_tokenizer_new("\"hello world\"")
    let tok = expect_token(t, CSS_TOKEN_STRING)
    assert token_value_is(tok, "hello world") == 1, "double-quoted string value"
    0

[[test]]
fn test_css_string_single() -> i32
    var t = css_tokenizer_new("'hello world'")
    let tok = expect_token(t, CSS_TOKEN_STRING)
    assert token_value_is(tok, "hello world") == 1, "single-quoted string value"
    0

[[test]]
fn test_css_number() -> i32
    var t = css_tokenizer_new("42")
    let tok = expect_token(t, CSS_TOKEN_NUMBER)
    assert tok.number_type == NUMBER_INTEGER, "42 is an integer"
    assert tok.number > 41.9 and tok.number < 42.1, "number should be 42"
    0

[[test]]
fn test_css_number_float() -> i32
    var t = css_tokenizer_new("3.14")
    let tok = expect_token(t, CSS_TOKEN_NUMBER)
    assert tok.number_type == NUMBER_FLOAT, "3.14 is a float"
    assert tok.number > 3.13 and tok.number < 3.15, "number should be 3.14"
    0

[[test]]
fn test_css_percentage() -> i32
    var t = css_tokenizer_new("50%")
    let tok = expect_token(t, CSS_TOKEN_PERCENTAGE)
    assert tok.number > 49.9 and tok.number < 50.1, "percentage number should be 50"
    0

[[test]]
fn test_css_dimension_px() -> i32
    var t = css_tokenizer_new("100px")
    let tok = expect_token(t, CSS_TOKEN_DIMENSION)
    assert tok.number > 99.9 and tok.number < 100.1, "dimension number should be 100"
    assert token_value_is(tok, "px") == 1, "dimension unit should be px"
    0

[[test]]
fn test_css_dimension_em() -> i32
    var t = css_tokenizer_new("1.5em")
    let tok = expect_token(t, CSS_TOKEN_DIMENSION)
    assert tok.number > 1.49 and tok.number < 1.51, "dimension number should be 1.5"
    assert token_value_is(tok, "em") == 1, "dimension unit should be em"
    0

# =============================================================================
# Punctuation Tests
# =============================================================================

[[test]]
fn test_css_punctuation() -> i32
    var t = css_tokenizer_new("{}")
    expect_token(t, CSS_TOKEN_OPEN_CURLY)
    expect_token(t, CSS_TOKEN_CLOSE_CURLY)
    expect_token(t, CSS_TOKEN_EOF)
    0

[[test]]
fn test_css_colon_semicolon() -> i32
    var t = css_tokenizer_new(":;")
    expect_token(t, CSS_TOKEN_COLON)
    expect_token(t, CSS_TOKEN_SEMICOLON)
    0

[[test]]
fn test_css_comma() -> i32
    var t = css_tokenizer_new(",")
    expect_token(t, CSS_TOKEN_COMMA)
    0

[[test]]
fn test_css_brackets() -> i32
    var t = css_tokenizer_new("[]")
    expect_token(t, CSS_TOKEN_OPEN_SQUARE)
    expect_token(t, CSS_TOKEN_CLOSE_SQUARE)
    0

[[test]]
fn test_css_parens() -> i32
    var t = css_tokenizer_new("()")
    expect_token(t, CSS_TOKEN_OPEN_PAREN)
    expect_token(t, CSS_TOKEN_CLOSE_PAREN)
    0

[[test]]
fn test_css_delim() -> i32
    var t = css_tokenizer_new(">")
    let tok = expect_token(t, CSS_TOKEN_DELIM)
    assert tok.delim == '>' as u8, "delim should be '>'"
    0

# =============================================================================
# At-Rule Tests
# =============================================================================

[[test]]
fn test_css_at_keyword() -> i32
    var t = css_tokenizer_new("@media")
    let tok = expect_token(t, CSS_TOKEN_AT_KEYWORD)
    assert token_value_is(tok, "media") == 1, "at-keyword value should be media"
    0

[[test]]
fn test_css_at_import() -> i32
    var t = css_tokenizer_new("@import")
    let tok = expect_token(t, CSS_TOKEN_AT_KEYWORD)
    assert token_value_is(tok, "import") == 1, "at-keyword value should be import"
    0

# =============================================================================
# Comment Tests
# =============================================================================

[[test]]
fn test_css_comment_removed() -> i32
    var t = css_tokenizer_new("/* comment */margin")
    let tok = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(tok, "margin") == 1, "comment should be consumed"
    0

[[test]]
fn test_css_comment_between_tokens() -> i32
    var t = css_tokenizer_new("margin/* comment */:/* another */0")
    let ident = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(ident, "margin") == 1, "ident before comment"
    expect_token(t, CSS_TOKEN_COLON)
    let num = expect_token(t, CSS_TOKEN_NUMBER)
    assert num.number_type == NUMBER_INTEGER, "0 is an integer"
    0

# =============================================================================
# URL Tests
# =============================================================================

[[test]]
fn test_css_url_unquoted() -> i32
    var t = css_tokenizer_new("url(image.png)")
    let tok = expect_token(t, CSS_TOKEN_URL)
    assert token_value_is(tok, "image.png") == 1, "url value should be image.png"
    0

[[test]]
fn test_css_url_quoted() -> i32
    var t = css_tokenizer_new("url(\"image.png\")")
    # A quoted url() is a FUNCTION token followed by a STRING, per the spec.
    let fn_tok = expect_token(t, CSS_TOKEN_FUNCTION)
    assert token_value_is(fn_tok, "url") == 1, "function name should be url"
    let str = expect_token(t, CSS_TOKEN_STRING)
    assert token_value_is(str, "image.png") == 1, "quoted url string"
    0

[[test]]
fn test_css_bad_url() -> i32
    # Whitespace inside an unquoted url() terminates it; with a non-')' next
    # char the token is a bad-url (CSS Syntax §4.3.6).
    var t = css_tokenizer_new("url(a b)")
    expect_token(t, CSS_TOKEN_BAD_URL)
    0

# =============================================================================
# Full Declaration Tests
# =============================================================================

[[test]]
fn test_css_declaration() -> i32
    var t = css_tokenizer_new("margin: 10px;")

    let ident = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(ident, "margin") == 1, "property name token"
    expect_token(t, CSS_TOKEN_COLON)
    expect_token(t, CSS_TOKEN_WHITESPACE)
    let dim = expect_token(t, CSS_TOKEN_DIMENSION)
    assert token_value_is(dim, "px") == 1, "unit token"
    expect_token(t, CSS_TOKEN_SEMICOLON)
    0

[[test]]
fn test_css_selector() -> i32
    var t = css_tokenizer_new(".container > p")

    let delim = expect_token(t, CSS_TOKEN_DELIM)
    assert delim.delim == '.' as u8, "class marker"
    let ident = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(ident, "container") == 1, "class name"
    expect_token(t, CSS_TOKEN_WHITESPACE)
    let gt = expect_token(t, CSS_TOKEN_DELIM)
    assert gt.delim == '>' as u8, "child combinator"
    expect_token(t, CSS_TOKEN_WHITESPACE)
    let p = expect_token(t, CSS_TOKEN_IDENT)
    assert token_value_is(p, "p") == 1, "type selector"
    0

# =============================================================================
# HTML Comment Markers
# =============================================================================

[[test]]
fn test_css_cdo() -> i32
    var t = css_tokenizer_new("<!--")
    expect_token(t, CSS_TOKEN_CDO)
    expect_token(t, CSS_TOKEN_EOF)
    0
