# tests/test_html_tokenizer.ritz - HTML tokenizer tests

import ritzlib.strview
import lib.html.tokenizer { Tokenizer, State, tokenizer_new, tokenizer_next, tokenizer_set_state }
import lib.html.token

# =============================================================================
# Test Helpers
# =============================================================================

fn expect_start_tag(t:& Tokenizer, expected_name: StrView) -> i32
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if not (tok.start_tag.name).eq(expected_name)
        return 1
    return 0

fn expect_end_tag(t:& Tokenizer, expected_name: StrView) -> i32
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_END_TAG
        return 1
    if not (tok.end_tag.name).eq(expected_name)
        return 1
    return 0

fn expect_eof(t:& Tokenizer) -> i32
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_EOF
        return 1
    return 0

fn skip_whitespace_chars(t:& Tokenizer)
    loop
        let tok = tokenizer_next(t)
        if tok.kind != TOKEN_CHARACTER
            # TODO: Need to "unconsume" this token
            # For now, tests are designed to not need this
            break
        let c = tok.character.char
        if c != 32 and c != 10 and c != 9 and c != 13
            break

# =============================================================================
# Basic Tests
# =============================================================================

[[test]]
fn test_empty_input() -> i32
    var t = tokenizer_new("")
    expect_eof(t)

[[test]]
fn test_simple_tag() -> i32
    var t = tokenizer_new("<div></div>")

    if expect_start_tag(t, "div") != 0
        return 1

    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_nested_tags() -> i32
    var t = tokenizer_new("<div><span></span></div>")

    if expect_start_tag(t, "div") != 0
        return 1
    if expect_start_tag(t, "span") != 0
        return 1
    if expect_end_tag(t, "span") != 0
        return 1
    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_self_closing_tag() -> i32
    var t = tokenizer_new("<br/>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if not (tok.start_tag.name).eq("br")
        return 1
    if tok.start_tag.self_closing != 1
        return 1

    expect_eof(t)

[[test]]
fn test_tag_with_attribute() -> i32
    var t = tokenizer_new("<div class=\"test\"></div>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if not (tok.start_tag.name).eq("div")
        return 1
    if tok.start_tag.attr_count != 1
        return 1
    # Would check attribute name/value here

    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_multiple_attributes() -> i32
    var t = tokenizer_new("<a href=\"/page\" class=\"link\" id=\"nav\"></a>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if not (tok.start_tag.name).eq("a")
        return 1
    if tok.start_tag.attr_count != 3
        return 1

    if expect_end_tag(t, "a") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_text_content() -> i32
    var t = tokenizer_new("<p>Hello</p>")

    if expect_start_tag(t, "p") != 0
        return 1

    # Should get character tokens for "Hello"
    var char_count = 0
    loop
        let tok = tokenizer_next(t)
        if tok.kind == TOKEN_CHARACTER
            char_count = char_count + 1
        else if tok.kind == TOKEN_END_TAG
            break
        else
            return 1  # Unexpected token

    if char_count != 5  # "Hello" = 5 chars
        return 1

    expect_eof(t)

[[test]]
fn test_comment() -> i32
    var t = tokenizer_new("<!-- comment -->")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_COMMENT
        return 1
    if not (tok.comment.data).eq(" comment ")
        return 1

    expect_eof(t)

[[test]]
fn test_doctype() -> i32
    var t = tokenizer_new("<!DOCTYPE html>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_DOCTYPE
        return 1
    if not (tok.doctype.name).eq("html")
        return 1

    expect_eof(t)

[[test]]
fn test_uppercase_tags() -> i32
    # Tag names should be lowercased
    var t = tokenizer_new("<DIV></DIV>")

    if expect_start_tag(t, "div") != 0
        return 1
    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_unquoted_attribute() -> i32
    var t = tokenizer_new("<div class=test></div>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if tok.start_tag.attr_count != 1
        return 1

    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_single_quoted_attribute() -> i32
    var t = tokenizer_new("<div class='test'></div>")

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if tok.start_tag.attr_count != 1
        return 1

    if expect_end_tag(t, "div") != 0
        return 1

    expect_eof(t)

[[test]]
fn test_numeric_entity() -> i32
    var t = tokenizer_new("&#65;")  # Should be 'A'

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 65  # 'A'
        return 1

    expect_eof(t)

[[test]]
fn test_hex_entity() -> i32
    var t = tokenizer_new("&#x41;")  # Should be 'A'

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 65  # 'A'
        return 1

    expect_eof(t)

# #4571: an out-of-range reference with many digits saturates and becomes
# U+FFFD (HTML spec), instead of overflowing the u32 accumulator.
[[test]]
fn test_numeric_entity_huge_decimal_is_replacement() -> i32
    var t = tokenizer_new("&#99999999999;")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 0xFFFD
        return 1
    expect_eof(t)

[[test]]
fn test_hex_entity_huge_is_replacement() -> i32
    var t = tokenizer_new("&#xFFFFFFFFFFFF;")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 0xFFFD
        return 1
    expect_eof(t)

[[test]]
fn test_void_elements() -> i32
    # Void elements like <br>, <hr>, <img> shouldn't need closing tags
    var t = tokenizer_new("<br><hr><img src=\"test.png\">")

    if expect_start_tag(t, "br") != 0
        return 1
    if expect_start_tag(t, "hr") != 0
        return 1

    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if not (tok.start_tag.name).eq("img")
        return 1
    if tok.start_tag.attr_count != 1
        return 1

    expect_eof(t)

# =============================================================================
# State dispatch (AGAST #3937: State is an enum, one fn per state)
# =============================================================================

[[test]]
fn test_new_tokenizer_starts_in_data_state() -> i32
    var t = tokenizer_new("x")
    match t.state
        State.Data => 0
        _ => 1

[[test]]
fn test_set_state_takes_a_state() -> i32
    # The tree builder switches modes with a State, not an i32.
    var t = tokenizer_new("<b>")
    tokenizer_set_state(t, State.TagOpen)
    match t.state
        State.TagOpen => 0
        _ => 1

# Behaviour pinned across the split: one case per state family.

[[test]]
fn test_bogus_comment_from_question_mark() -> i32
    var t = tokenizer_new("<?php x?>")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_COMMENT
        return 1
    if not (tok.comment.data).eq("?php x?")
        return 1
    expect_eof(t)

[[test]]
fn test_empty_end_tag_is_dropped() -> i32
    var t = tokenizer_new("</>")
    expect_eof(t)

[[test]]
fn test_comment_with_inner_dashes() -> i32
    var t = tokenizer_new("<!--a-b--c--->")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_COMMENT
        return 1
    if not (tok.comment.data).eq("a-b--c-")
        return 1
    expect_eof(t)

[[test]]
fn test_doctype_without_name_forces_quirks() -> i32
    var t = tokenizer_new("<!DOCTYPE>")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_DOCTYPE
        return 1
    if tok.doctype.force_quirks != 1
        return 1
    expect_eof(t)

[[test]]
fn test_bare_ampersand_is_a_character() -> i32
    var t = tokenizer_new("& ")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 38
        return 1
    return 0

[[test]]
fn test_every_quote_style_ends_an_attribute() -> i32
    var t = tokenizer_new("<a x=\"1\" y='2' z=3 w>")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG
        return 1
    if tok.start_tag.attr_count != 4
        return 1
    # Each Attribute owns its bytes (#4561): a later attribute must not
    # overwrite an earlier one's name or value.
    if not (tok.start_tag.attrs[0].name).eq("x")
        return 2
    if not (tok.start_tag.attrs[0].value).eq("1")
        return 3
    if not (tok.start_tag.attrs[1].name).eq("y")
        return 4
    if not (tok.start_tag.attrs[1].value).eq("2")
        return 5
    if not (tok.start_tag.attrs[2].name).eq("z")
        return 6
    if not (tok.start_tag.attrs[2].value).eq("3")
        return 7
    if not (tok.start_tag.attrs[3].name).eq("w")
        return 8
    if tok.start_tag.attrs[3].value.len != 0
        return 9
    expect_eof(t)

# The arena is per tag: the next tag's attributes reuse it, but the
# lengths of names and values that differ in size must still read back.
[[test]]
fn test_attributes_of_a_second_tag_read_back() -> i32
    var t = tokenizer_new("<a href=\"long-value\" id=k><b class=c title=\"tt\">")
    let a = tokenizer_next(t)
    if a.kind != TOKEN_START_TAG or a.start_tag.attr_count != 2
        return 1
    if not (a.start_tag.attrs[0].value).eq("long-value")
        return 2
    if not (a.start_tag.attrs[1].name).eq("id")
        return 3
    let b = tokenizer_next(t)
    if b.kind != TOKEN_START_TAG or b.start_tag.attr_count != 2
        return 4
    if not (b.start_tag.attrs[0].name).eq("class")
        return 5
    if not (b.start_tag.attrs[0].value).eq("c")
        return 6
    if not (b.start_tag.attrs[1].name).eq("title")
        return 7
    if not (b.start_tag.attrs[1].value).eq("tt")
        return 8
    expect_eof(t)

# Fill `buf` from `at` with `<a v=XXXX...>` (value of `vlen` X's); return
# the new end.
fn put_tag_with_value(buf: *u8, at: u64, vlen: u64) -> u64
    var n = at
    buf[n] = '<'
    buf[n + 1] = 'a'
    buf[n + 2] = ' '
    buf[n + 3] = 'v'
    buf[n + 4] = '='
    n = n + 5
    var i: u64 = 0
    while i < vlen
        buf[n] = 'X'
        n = n + 1
        i = i + 1
    buf[n] = '>'
    n + 1

# The attribute arena is reset per tag: 40 tags x 1000-byte values is more
# than one arena's worth, yet every tag's value reads back whole.
[[test]]
fn test_attribute_arena_is_reused_per_tag() -> i32
    var buf: [41000]u8
    var n: u64 = 0
    var k: u32 = 0
    while k < 40
        n = put_tag_with_value(@buf[0], n, 1000)
        k = k + 1
    var t = tokenizer_new(StrView { ptr: @buf[0], len: n })
    k = 0
    while k < 40
        let tok = tokenizer_next(t)
        if tok.kind != TOKEN_START_TAG or tok.start_tag.attr_count != 1
            return 1
        if tok.start_tag.attrs[0].value.len != 1000
            return 2
        k = k + 1
    expect_eof(t)

# One tag whose attributes overflow the 32768-byte arena: the attribute
# that crosses the end keeps its name and a truncated value, earlier ones
# stay whole.
[[test]]
fn test_attribute_arena_overflow_truncates_the_last_value() -> i32
    var buf: [40000]u8
    var n: u64 = 0
    buf[0] = '<'
    buf[1] = 'a'
    n = 2
    var k: u32 = 0
    while k < 9
        buf[n] = ' '
        buf[n + 1] = 'a' + k as u8
        buf[n + 2] = '='
        n = n + 3
        var i: u64 = 0
        while i < 4000
            buf[n] = 'X'
            n = n + 1
            i = i + 1
        k = k + 1
    buf[n] = '>'
    n = n + 1
    var t = tokenizer_new(StrView { ptr: @buf[0], len: n })
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_START_TAG or tok.start_tag.attr_count != 9
        return 1
    if tok.start_tag.attrs[7].value.len != 4000
        return 2
    if not (tok.start_tag.attrs[8].name).eq("i")
        return 3
    # 8 x (1 + 4000) = 32008 used; 1 byte for "i" leaves 759.
    if tok.start_tag.attrs[8].value.len != 759
        return 4
    if not (tok.start_tag.attrs[0].name).eq("a")
        return 5
    expect_eof(t)

[[test]]
fn test_null_in_data_is_replacement_char() -> i32
    var t = tokenizer_new("\0")
    let tok = tokenizer_next(t)
    if tok.kind != TOKEN_CHARACTER
        return 1
    if tok.character.char != 65533
        return 1
    expect_eof(t)
