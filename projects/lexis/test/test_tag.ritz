# The classifiers now fire for parsed names, not just hand-built variants.
[[test]]
fn test_classifiers_see_parsed_names() -> i32
    assert tag_is_formatting(tag_from_name("font"))
    assert tag_is_formatting(tag_from_name("nobr"))
    assert tag_is_formatting(tag_from_name("big"))
    assert tag_is_formatting(tag_from_name("strike"))
    assert tag_is_formatting(tag_from_name("tt"))
    assert tag_is_void(tag_from_name("area"))
    assert tag_is_void(tag_from_name("param"))
    assert tag_is_special(tag_from_name("center"))
    assert tag_is_special(tag_from_name("applet"))
    assert tag_is_special(tag_from_name("hgroup"))
    assert tag_is_special(tag_from_name("menu"))
    assert tag_is_special(tag_from_name("search"))
    0
