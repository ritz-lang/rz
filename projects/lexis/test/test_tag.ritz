[[test]]
fn test_other_names_are_unknown() -> i32
    assert round_trips("htm") == 0
    assert round_trips("htmlx") == 0
    assert round_trips("HTML") == 0
    assert round_trips("") == 0
    let unknown: i32 = match tag_from_name("blink")
        Tag.Unknown(n) => n.eq("blink") as i32
        _ => 0
    assert unknown == 1
    0

# 1 when the variant's printed name parses back to that same variant
# (tag_name is injective, so a name that round trips names `t` itself).
fn variant_round_trips(t: Tag) -> i32
    round_trips(tag_name(t))

# tag_from_name(tag_name(t)) == t for every variant but Unknown (AGAST #4620:
# 27 names tag_name printed, font/nobr/center/area/..., parsed as Unknown).
[[test]]
fn test_every_variant_round_trips() -> i32
