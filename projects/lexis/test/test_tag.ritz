# test/test_tag.ritz - tag_from_name and tag_name are inverses (AGAST #1876)
#
# tag_from_name became a `match` on string literals; every name it knew before
# must still give a known tag whose tag_name is that name, and any other name
# must stay Tag.Unknown carrying it.

import ritzlib.strview
import lib.dom.tag { Tag, tag_from_name, tag_name }

# 1 when `name` parses to a known tag that prints back as `name`.
fn round_trips(name: StrView) -> i32
    let tag = tag_from_name(name)
    match tag
        Tag.Unknown(_) => 0
        _ => strview_eq(tag_name(tag), name) as i32

[[test]]
fn test_every_known_name_round_trips() -> i32
    assert round_trips("html") == 1
    assert round_trips("head") == 1
    assert round_trips("title") == 1
    assert round_trips("base") == 1
    assert round_trips("link") == 1
    assert round_trips("meta") == 1
    assert round_trips("style") == 1
    assert round_trips("body") == 1
    assert round_trips("article") == 1
    assert round_trips("section") == 1
