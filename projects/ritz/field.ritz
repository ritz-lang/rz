trait Drop
    fn drop(self: @&Self)

trait Speak
    fn say(self: @Self) -> i32

var MADE: i32 = 0
var DROPS: i32 = 0
var LAST: i32 = 0

struct T
    id: i32

impl Drop for T
    fn drop(self: @&T)
        DROPS = DROPS + 1
        LAST = self.id

impl T
    fn peek(self: @T) -> i32
        return self.id

    fn bump(self: @&T) -> i32
        self.id = self.id + 5
        return self.id

    fn burn(self: T) -> i32
        return self.id

    fn again(self: @T) -> T
        MADE = MADE + 1
        return T { id: self.id }

struct P
    x: i32

impl Speak for P
    fn say(self: @P) -> i32
        return self.x

impl P
    fn get(self: @P) -> i32
        return self.x

    fn val(self: P) -> i32
        return self.x

    fn bump(self: @&P) -> i32
        self.x = self.x + 1
        return self.x

    fn borrow_mut(self:& P) -> i32
        return self.x

    fn next(self: @P) -> P
        return P { x: self.x + 1 }

    fn other(self: @P, q: @P) -> i32
        return q.x

struct W
    p: P

struct G<X>
    v: X

impl<X> G<X>
    fn get(self: @G<X>) -> X
        return self.v

# Its own `abs`, so the float intrinsics have to let it through.
struct A
    v: i32

impl A
    fn abs(self: @A) -> i32
        return self.v

fn make(id: i32) -> T
    MADE = MADE + 1
    return T { id: id }

fn mp() -> P
    MADE = MADE + 1
    return P { x: 1 }

fn mw() -> W
    MADE = MADE + 1
    return W { p: P { x: 1 } }

fn mg() -> G<i32>
    MADE = MADE + 1
    return G<i32> { v: 1 }

fn ma() -> A
    MADE = MADE + 1
    return A { v: 1 }

fn mi() -> u32
    MADE = MADE + 1
    return 8

fn mf() -> f64
    MADE = MADE + 1
    return 1.5

fn idx() -> i64
    MADE = MADE + 1
    return 0

# A by-value array result, alone and as a field (AGAST #3234).
struct V
    a: [2]P

fn mka() -> [2]P
    MADE = MADE + 1
    return [P { x: 1 }, P { x: 2 }]

fn mv() -> V
    MADE = MADE + 1
    return V { a: [P { x: 1 }, P { x: 2 }] }

# The same of a Drop type: a temporary, dropped per element (AGAST #3258).
fn mkt() -> [2]T
    MADE = MADE + 1
    return [T { id: 1 }, T { id: 2 }]

# The index 1, counted: MADE goes up by 10 per evaluation.
fn one() -> i64
    MADE = MADE + 10
    return 1

# Hand back what they were given, as a side effect in a place's root.
fn mq(p: *P) -> *P
    MADE = MADE + 1
    return p

fn pw(w: *W) -> *W
    MADE = MADE + 1
    return w

fn take(n: i32) -> i32
    return n

fn look(p: @P) -> i32
    return p.x


fn lk(a: @[2]T) -> i32
    return a[0].id

fn mkb() -> [8]T
    MADE = MADE + 1
    return [T { id: 1 }, T { id: 2 }, T { id: 3 }, T { id: 4 }, T { id: 5 }, T { id: 6 }, T { id: 7 }, T { id: 8 }]

fn lkb(a: @[8]T) -> i32
    return a[0].id

fn g() -> i32
    take(mkt()[0].id)
    return 0

pub fn main() -> i32
    g()
    return MADE * 10 + DROPS
