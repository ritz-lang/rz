# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/

# Build artifacts
build/
target/
*.o
*.s
*.ll

# ritz0 source-hash + compiled-IR caches, written as side-effect of compilation.
# We explicitly allow the tracked ones under src/ritz0/test (level* golden files)
# with the negations further down.
*.ritz.sig
*.bc
.build/
.regression/
t_build/
build_test/
tmp*/

# Runtime: ignore built objects, but track source .ll files
runtime/*.o
!runtime/*.x86_64.ll

# Build cache
.ritz-cache*/

# Compiled binaries (keep named examples in examples/)
/cmp
/cmp2
/test_*
ritz1/ritz1
ritz1/ritz1.prev
ritz1/*.ritz
ritz1/test_bin
ritz1/test.err
ritz1/archive/
!/ritz1/src/*.ritz
!/ritz1/test/*.ritz

# Test binaries
examples/*/test_bin
examples/test_bin
examples/test.ritz
examples/test_crash.ritz
examples/test_import/
tests/import_test/

# Test directories
!test/
test/dual_compiler/.build/

# Temp ritzlib test dirs
ritzlib/tests/tmp*/

# Example binaries (built from source, including Phase II convenience
# symlinks pkg_dir/<name> → build/debug/<name>). These patterns use ** so they
# match both legacy flat layouts (examples/01_hello/hello) and the current
# tiered layout (examples/tier1_basics/01_hello/hello).
# Tier 1
examples/**/hello
examples/**/exitcode
examples/**/echo
examples/**/true
examples/**/false
examples/**/cat
examples/**/head
examples/**/wc
examples/**/seq
examples/**/yes
examples/**/sleep
examples/**/global_ptr_index
# Tier 2-3
examples/**/ls
examples/**/mkdir
examples/**/rm
examples/**/cp
examples/**/mv
examples/**/touch
examples/**/stat
examples/**/chmod
examples/**/du
examples/**/find
examples/**/grep
examples/**/tac
examples/**/sort
examples/**/uniq
examples/**/cut
examples/**/tr
examples/**/expand
examples/**/nl
examples/**/base64
examples/**/xxd
# Tier 4
examples/**/env
examples/**/which
examples/**/printenv
examples/**/tee
examples/**/kill
examples/**/xargs
examples/**/time
examples/**/nohup
examples/**/watch
examples/**/timeout

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Transcripts
logs/*.txt
examples/52_uring/uring
examples/53_async/async_test
examples/54_async_fs/async_fs_test
examples/55_async_state_machine/async_state_machine_test

