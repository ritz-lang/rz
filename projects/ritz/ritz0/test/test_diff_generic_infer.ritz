# AGAST #1982: a generic fn's type args are inferred from its arguments.
#
# LANGUAGE_SPEC section 4.4: `f(args)` to a generic `f<T>` binds each T by
# matching each param's type against its argument's (`T`, `@T`, `*T`,
# `Vec<T>`, `@Vec<T>` ...). An integer literal argument to a bare `T` param
# binds T to i64, as `let x = 3` would, unless another argument binds T.
# Explicit `f<T>(...)` still works. The refusals (a return-only T, two
# arguments binding T differently) are test_generic_call_infer.py.
#
# Values above 2^32 and u8/u64 elements: a T bound at the wrong width
# changes the answer.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.gvec
import ritzlib.sys

fn twice<T>(x: T) -> T
    x

fn deref<T>(p: @T) -> T
    *p

fn pick<T>(a: T, b: T) -> T
    b

# A generic body's inferred call is `twice<T>`, specialised with it.
fn outer<T>(x: T) -> T
    twice(x)

fn len_of<T>(v: @Vec<T>) -> i64
    vec_len(v)

[[test]]
fn test_infer_from_value() -> i32
    let a: u64 = 0x500000003 as u64
    assert twice(a) == 0x500000003 as u64
    let b: u8 = 250 as u8
    assert twice(b) == 250 as u8
    0

[[test]]
fn test_infer_from_shared_ref() -> i32
    let x: u64 = 0x700000009 as u64
    assert deref(@x) == 0x700000009 as u64
    0

[[test]]
fn test_infer_from_vec_ref() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(0x600000005 as u64)
    let p = vec_as_ptr(@v)
    assert p[1] == 0x600000005 as u64
    let q = vec_get_ptr(@&v, 0)
    assert *q == 1 as u64
    vec_push(@&v, 9)
    assert vec_len(@v) == 3
    assert vec_get(@v, 2) == 9 as u64
    vec_drop(@&v)
    0

[[test]]
fn test_infer_from_literal() -> i32
    assert twice(3) == 3
    assert twice(0x500000003) == 0x500000003
    0

[[test]]
fn test_two_params_agree() -> i32
    let a: u8 = 1 as u8
    let b: u8 = 200 as u8
    assert pick(a, b) == 200 as u8
    let c: i32 = 5
    assert pick(c, 3) == 3
    0

[[test]]
fn test_infer_in_generic_body() -> i32
    let a: u64 = 0x500000004 as u64
    assert outer(a) == 0x500000004 as u64
    var v = vec_new<u8>()
    v.push(7 as u8)
    assert len_of(@v) == 1
    0

[[test]]
fn test_explicit_still_accepted() -> i32
    assert twice<i32>(3) == 3
    let a: u8 = 9 as u8
    assert pick<u8>(a, a) == 9 as u8
    0

# AGAST #3064: an un-annotated `let t = D { .. }` is a D, as `let t: D` is: a
# struct literal's type is plain (`D`, or `Wide<u64>` spelled with its args).
# A generic struct's literal without args (`Wide { .. }`) gives no type: that
# call stays the can't-infer error (test_generic_param_name_capture.py).
struct Tagged
    id: i32
    big: u64

struct Wide<T>
    v: T

[[test]]
fn test_infer_from_struct_literal_let() -> i32
    let t = Tagged { id: 3, big: 0x500000006 as u64 }
    let u: Tagged = deref(@t)
    assert u.id == 3
    assert u.big == 0x500000006 as u64
    let w = Wide<u64> { v: 0x500000007 as u64 }
    let x: Wide<u64> = deref(@w)
    assert x.v == 0x500000007 as u64
    assert twice(Tagged { id: 4, big: 1 as u64 }).id == 4
    0
