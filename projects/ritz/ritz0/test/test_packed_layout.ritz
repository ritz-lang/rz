# AGAST #1847: `[[packed]]` layout agrees across ritz0, ritz1 and
# ritz1_selfhosted (LANGUAGE_SPEC §17).  ritz1 used to drop the attribute,
# so P was laid out like Normal — 24 bytes, `b` at offset 8 — with no error.

[[packed]]
struct P
    a: u8
    b: u64
    c: u16
    d: u8

struct Normal
    a: u8
    b: u64
    c: u16
    d: u8

# A packed struct is 1-aligned: it sits at offset 1 here, not 8.
struct Outer
    x: u8
    p: P
    y: u8

[[packed]]
struct Tagged<T>
    tag: u8
    val: T

fn off(base: *u8, field: *u8) -> i64
    field as i64 - base as i64

[[test]]
fn test_packed_sizeof() -> i32
    assert sizeof(P) == 12
    assert sizeof(Normal) == 24
    assert sizeof(Outer) == 14
    0

[[test]]
fn test_packed_offsets() -> i32
    var p: P
    let base: *u8 = @p as *u8
    assert off(base, @p.a as *u8) == 0
    assert off(base, @p.b as *u8) == 1
    assert off(base, @p.c as *u8) == 9
    assert off(base, @p.d as *u8) == 11
    0

[[test]]
fn test_packed_nested_offsets() -> i32
    var o: Outer
    let base: *u8 = @o as *u8
    assert off(base, @o.p as *u8) == 1
    assert off(base, @o.y as *u8) == 13
    0

[[test]]
fn test_packed_fields_round_trip() -> i32
    var o: Outer
    o.x = 1
    o.p.a = 0x11
    o.p.b = 0x2222222222222222
    o.p.c = 0x3333
    o.p.d = 0x44
    o.y = 2
    assert o.x == 1
    assert o.p.a == 0x11
    assert o.p.b == 0x2222222222222222
    assert o.p.c == 0x3333
    assert o.p.d == 0x44
    assert o.y == 2
    0

[[test]]
fn test_packed_generic_stride() -> i32
    var arr: [2]Tagged<u64>
    assert off(@arr[0] as *u8, @arr[1] as *u8) == 9
    arr[1].tag = 1
    arr[1].val = 41
    assert arr[1].tag as u64 + arr[1].val == 42
    0
