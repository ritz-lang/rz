# AGAST #1299 / #1300: a `>>`-closed nested generic in a multi-argument
# generic STRUCT literal: `Pair<i64, Vec<i64>> { ... }`.
#
# Split out of test_issue_nested_generic_close.ritz by #1300, which let ritz1
# parse it. AGAST #1574 made ritz1 mangle generic structs on EVERY type
# argument and substitute every parameter, so it now compiles and runs under
# all three compilers (tools/run_regression_matrix.py, which discovers every
# file in this directory since AGAST #1371).
#
# Run with: python3 ritz0/ritz0.py --test ritz0/test/test_issue_nested_generic_close_pair.ritz

import ritzlib.sys
import ritzlib.gvec

struct Pair<A, B>
    first: A
    second: B

[[test]]
fn test_nested_generic_in_multi_arg_struct_lit() -> i32
    var inner: Vec<i64> = vec_new<i64>()
    inner.push(5)
    let p: Pair<i64, Vec<i64>> = Pair<i64, Vec<i64>> { first: 3, second: inner }
    assert p.first == 3
    assert p.second.len() == 1
    0

fn main() -> i32
    0
