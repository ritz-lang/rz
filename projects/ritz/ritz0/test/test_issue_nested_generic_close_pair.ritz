# AGAST #1299 / #1300: a `>>`-closed nested generic in a multi-argument
# generic STRUCT literal: `Pair<i64, Vec<i64>> { ... }`.
#
# Split out of test_issue_nested_generic_close.ritz by #1300. ritz1 parses
# this (#1300) but cannot compile it yet: it monomorphises generic structs on
# the first type argument only, so `Pair<A, B>` emits `%B$i64` (AGAST #1574).
# Register it in tools/run_regression_matrix.py::TESTS when #1574 lands.
#
# Run with: python3 ritz0/ritz0.py --test ritz0/test/test_issue_nested_generic_close_pair.ritz

import ritzlib.sys
import ritzlib.gvec

struct Pair<A, B>
    first: A
    second: B

[[test]]
fn test_nested_generic_in_multi_arg_struct_lit() -> i32
    var inner: Vec<i64> = vec_new<i64>()
    inner.push(5)
    let p: Pair<i64, Vec<i64>> = Pair<i64, Vec<i64>> { first: 3, second: inner }
    assert p.first == 3
    assert p.second.len() == 1
    0

fn main() -> i32
    0
