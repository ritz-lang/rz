# AGAST #1954: ritz1 reads `x.f[i]` of a `[N]f32` / `[N]f64` struct field as
# a float value.
#
# THE DEFECT
#
# emit_expr_index's struct-field arm failed closed for a `[N]f32` field
# ("indexing a [N]f32 struct field is not supported by ritz1") and loaded a
# `[N]f64` field element as an i64 bit pattern, so `d.vals[0] == 1.0` emitted
# `fcmp oeq double %i64reg` and `d.vals = [d.vals[1], d.vals[0]]` emitted
# `store double %i64reg` (clang rejects both).
#
# THE FIX (ritz1/src/emitter_expr_access.ritz emit_expr_index,
# emitter_core.ritz get_expr_type)
#
# The element is GEP'd and loaded as `float` / `double`
# (field_array_elem_llvm) and returned as-is, as #1966 does for `loc[i]` and
# #1973 for `p[i]`; get_expr_type reports F32 / F64 for it, so a binop or
# compare over it uses the float width.
#
# Oracle: ritz0 runs every case to the same result.

struct SffDoubles
    lead: i32
    vals: [2]f64
    tail: i64

struct SffFloats
    lead: i32
    fv: [3]f32
    tail: i32

struct SffOuter
    head: i64
    inner: SffDoubles
    fl: SffFloats

fn sff_get64(d: *SffDoubles, i: i64) -> f64
    d.vals[i]

fn sff_get32(f: *SffFloats, i: i64) -> f32
    f.fv[i]

fn sff_twice(x: f64) -> f64
    x * 2.0

# --- [N]f64 fields ---------------------------------------------------------

fn sff_f64_main() -> i32
    var d: SffDoubles = SffDoubles { lead: 7, vals: [1.0, -2.5], tail: 9 }
    if d.vals[0] != 1.0
        return 1
    if not (d.vals[0] == 1.0)
        return 2
    if d.vals[1] != -2.5
        return 3
    # A field element in arithmetic, both sides and with a literal.
    let s: f64 = d.vals[0] + d.vals[1]
    if s != -1.5
        return 4
    if d.vals[1] * 2.0 != -5.0
        return 5
    if 3.0 - d.vals[0] != 2.0
        return 6
    # Variable index, and passing / returning the element.
    var i: i64 = 1
    if d.vals[i] != -2.5
        return 7
    if sff_twice(d.vals[i]) != -5.0
        return 8
    if sff_get64(@d, 0) != 1.0
        return 9
    # The swap from the ticket.
    d.vals = [d.vals[1], d.vals[0]]
    if d.vals[0] != -2.5
        return 10
    if d.vals[1] != 1.0
        return 11
    if d.lead != 7 or d.tail != 9
        return 12
    # Element into a local and back into a field slot.
    let x: f64 = d.vals[1]
    d.vals[0] = x + d.vals[0]
    if d.vals[0] != -1.5
        return 13
    if d.vals[0] < d.vals[1]
        return 42
    return 14

[[test]]
fn test_struct_float_field_index_f64() -> i32
    assert sff_f64_main() == 42
    0

# --- [N]f32 fields ---------------------------------------------------------

fn sff_f32_main() -> i32
    var f: SffFloats = SffFloats { lead: 1, fv: [1.5, -0.25, -3.5], tail: 2 }
    if f.fv[0] != 1.5
        return 1
    if f.fv[1] != -0.25
        return 2
    let w: f32 = -3.5
    if f.fv[2] != w
        return 3
    if not (f.fv[2] == w)
        return 4
    var i: i64 = 0
    var sum: f32 = 0.0
    while i < 3
        sum = sum + f.fv[i]
        i = i + 1
    if sum != -2.25
        return 5
    if f.fv[0] * 2.0 != 3.0
        return 6
    if f.fv[0] + f.fv[1] != 1.25
        return 7
    if sff_get32(@f, 1) != -0.25
        return 8
    let y: f32 = f.fv[2]
    if y != w
        return 9
    f.fv = [f.fv[2], f.fv[1], f.fv[0]]
    if f.fv[0] != -3.5 or f.fv[2] != 1.5 or f.fv[1] != -0.25
        return 10
    if f.lead != 1 or f.tail != 2
        return 11
    # Element stores: an f64 literal (fptrunc'd) and an f32 expression.
    f.fv[1] = 0.75
    f.fv[2] = f.fv[1] + w
    if f.fv[1] != 0.75 or f.fv[2] != -2.75
        return 13
    f.fv[1] = -0.25
    if f.fv[0] < f.fv[1]
        return 42
    return 12

[[test]]
fn test_struct_float_field_index_f32() -> i32
    assert sff_f32_main() == 42
    0

# --- through a struct pointer and nested -----------------------------------

fn sff_ptr_main(p: *SffDoubles, q: *SffFloats) -> i32
    if p.vals[1] != -2.5
        return 1
    if p.vals[0] + p.vals[1] != -1.5
        return 2
    let w: f32 = -3.5
    if q.fv[2] != w
        return 3
    if q.fv[0] * 2.0 != 3.0
        return 4
    p.vals = [p.vals[1], p.vals[0]]
    if p.vals[0] != -2.5 or p.vals[1] != 1.0
        return 5
    return 42

fn sff_nested_main() -> i32
    var o: SffOuter = SffOuter { head: 5, inner: SffDoubles { lead: 7, vals: [1.0, -2.5], tail: 9 }, fl: SffFloats { lead: 1, fv: [1.5, -0.25, -3.5], tail: 2 } }
    var i: i64 = 1
    if o.inner.vals[i] != -2.5
        return 1
    if o.inner.vals[0] - o.inner.vals[1] != 3.5
        return 2
    let w: f32 = -0.25
    if o.fl.fv[i] != w
        return 3
    if o.fl.fv[0] + o.fl.fv[2] != -2.0
        return 4
    let r: i32 = sff_ptr_main(@o.inner, @o.fl)
    if r != 42
        return 10 + r
    if o.head != 5
        return 5
    return 42

[[test]]
fn test_struct_float_field_index_nested_ptr() -> i32
    assert sff_nested_main() == 42
    0
