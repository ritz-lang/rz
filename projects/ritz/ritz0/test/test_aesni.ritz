# Test AES-NI hardware crypto intrinsics
#
# AES-NI (Advanced Encryption Standard New Instructions) provides hardware
# acceleration for AES encryption/decryption operations.
#
# Required for cryptosec TLS 1.3 library (ritz#119).
#
# NOTE: This test requires CPU support for AES-NI (Intel since Westmere 2010).

# ============================================================================
# AES-NI: Advanced Encryption Standard New Instructions
# ============================================================================

[[test]]
fn test_aesenc_basic() -> i32
    # Test one round of AES encryption
    # aesenc(state: v4i32, key: v4i32) -> v4i32
    var state: [4]i32
    var key: [4]i32

    # Initialize with known test vector
    state[0] = 0x00010203 as i32
    state[1] = 0x04050607 as i32
    state[2] = 0x08090a0b as i32
    state[3] = 0x0c0d0e0f as i32

    key[0] = 0x10111213 as i32
    key[1] = 0x14151617 as i32
    key[2] = 0x18191a1b as i32
    key[3] = 0x1c1d1e1f as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])

    # Perform one AES round
    let result: v4i32 = aesenc(s, k)

    # Store result
    var out: [4]i32
    simd_storeu(@out[0], result)

    # Verify we got a transformed result (not input)
    if out[0] == state[0] and out[1] == state[1]
        return 1  # Should have changed

    0

[[test]]
fn test_aesenclast_basic() -> i32
    # Test final round of AES encryption
    # aesenclast(state: v4i32, key: v4i32) -> v4i32
    var state: [4]i32
    var key: [4]i32

    state[0] = 0x00010203 as i32
    state[1] = 0x04050607 as i32
    state[2] = 0x08090a0b as i32
    state[3] = 0x0c0d0e0f as i32

    key[0] = 0x10111213 as i32
    key[1] = 0x14151617 as i32
    key[2] = 0x18191a1b as i32
    key[3] = 0x1c1d1e1f as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])

    # Perform final AES round
    let result: v4i32 = aesenclast(s, k)

    var out: [4]i32
    simd_storeu(@out[0], result)

    # Verify transformation
    if out[0] == state[0] and out[1] == state[1]
        return 1

    0

[[test]]
fn test_aesdec_basic() -> i32
    # Test one round of AES decryption
    # aesdec(state: v4i32, key: v4i32) -> v4i32
    var state: [4]i32
    var key: [4]i32

    state[0] = 0x00010203 as i32
    state[1] = 0x04050607 as i32
    state[2] = 0x08090a0b as i32
    state[3] = 0x0c0d0e0f as i32

    key[0] = 0x10111213 as i32
    key[1] = 0x14151617 as i32
    key[2] = 0x18191a1b as i32
    key[3] = 0x1c1d1e1f as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])

    # Perform one AES decryption round
    let result: v4i32 = aesdec(s, k)

    var out: [4]i32
    simd_storeu(@out[0], result)

    if out[0] == state[0] and out[1] == state[1]
        return 1

    0

[[test]]
fn test_aesdeclast_basic() -> i32
    # Test final round of AES decryption
    # aesdeclast(state: v4i32, key: v4i32) -> v4i32
    var state: [4]i32
    var key: [4]i32

    state[0] = 0x00010203 as i32
    state[1] = 0x04050607 as i32
    state[2] = 0x08090a0b as i32
    state[3] = 0x0c0d0e0f as i32

    key[0] = 0x10111213 as i32
    key[1] = 0x14151617 as i32
    key[2] = 0x18191a1b as i32
    key[3] = 0x1c1d1e1f as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])

    let result: v4i32 = aesdeclast(s, k)

    var out: [4]i32
    simd_storeu(@out[0], result)

    if out[0] == state[0] and out[1] == state[1]
        return 1

    0

[[test]]
fn test_aesimc_basic() -> i32
    # Test AES Inverse MixColumns (for decryption key schedule)
    # aesimc(key: v4i32) -> v4i32
    var key: [4]i32

    key[0] = 0x10111213 as i32
    key[1] = 0x14151617 as i32
    key[2] = 0x18191a1b as i32
    key[3] = 0x1c1d1e1f as i32

    let k: v4i32 = simd_loadu(@key[0])

    # Apply Inverse MixColumns
    let result: v4i32 = aesimc(k)

    var out: [4]i32
    simd_storeu(@out[0], result)

    # Should transform the key
    if out[0] == key[0] and out[1] == key[1] and out[2] == key[2] and out[3] == key[3]
        return 1

    0

[[test]]
fn test_aes_encrypt_decrypt_roundtrip() -> i32
    # Verify that encrypt followed by decrypt returns original
    # This is a sanity check - not cryptographically meaningful without proper key schedule
    var state: [4]i32
    var key: [4]i32

    state[0] = 0xdeadbeef as i32
    state[1] = 0xcafebabe as i32
    state[2] = 0x12345678 as i32
    state[3] = 0x9abcdef0 as i32

    key[0] = 0x00000000 as i32
    key[1] = 0x00000000 as i32
    key[2] = 0x00000000 as i32
    key[3] = 0x00000000 as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])

    # Single round encrypt then decrypt (with zero key, this is reversible)
    let encrypted: v4i32 = aesenc(s, k)
    # Note: Full AES requires aesimc on key for decrypt, but single round with zero key works
    let decrypted: v4i32 = aesdec(encrypted, k)

    # Result won't match original without proper inverse - just verify it doesn't crash
    var out: [4]i32
    simd_storeu(@out[0], decrypted)

    0

# AGAST #1609: the AES-NI intrinsics take either 128-bit shape.  ritz0 and
# ritz1 bitcast a v4i32 operand to the <2 x i64> the LLVM intrinsic takes and
# the result back to the state operand's type, so a v2i64 call and a v4i32
# call on the same bits must produce the same bits.
[[test]]
fn test_aesenc_v2i64_matches_v4i32() -> i32
    var state: [4]i32
    var key: [4]i32
    state[0] = 0x00112233 as i32
    state[1] = 0x44556677 as i32
    state[2] = 0x8899aabb as i32
    state[3] = 0xccddeeff as i32
    key[0] = 0x0f0e0d0c as i32
    key[1] = 0x0b0a0908 as i32
    key[2] = 0x07060504 as i32
    key[3] = 0x03020100 as i32

    let s4: v4i32 = simd_loadu(@state[0])
    let k4: v4i32 = simd_loadu(@key[0])
    let r4: v4i32 = aesenc(s4, k4)
    var out4: [4]i32
    simd_storeu(@out4[0], r4)

    let s2: v2i64 = simd_loadu(@state[0] as *i64)
    let k2: v2i64 = simd_loadu(@key[0] as *i64)
    let r2: v2i64 = aesenc(s2, k2)
    var out2: [4]i32
    simd_storeu(@out2[0] as *i64, r2)

    if out4[0] == state[0] and out4[1] == state[1]
        return 1
    if out2[0] != out4[0] or out2[1] != out4[1] or out2[2] != out4[2] or out2[3] != out4[3]
        return 2
    0

[[test]]
fn test_aesimc_v2i64_matches_v4i32() -> i32
    var key: [4]i32
    key[0] = 0x2b7e1516 as i32
    key[1] = 0x28aed2a6 as i32
    key[2] = 0xabf71588 as i32
    key[3] = 0x09cf4f3c as i32

    let k4: v4i32 = simd_loadu(@key[0])
    let r4: v4i32 = aesimc(k4)
    var out4: [4]i32
    simd_storeu(@out4[0], r4)

    let k2: v2i64 = simd_loadu(@key[0] as *i64)
    let r2: v2i64 = aesimc(k2)
    var out2: [4]i32
    simd_storeu(@out2[0] as *i64, r2)

    if out2[0] != out4[0] or out2[1] != out4[1] or out2[2] != out4[2] or out2[3] != out4[3]
        return 1
    0

# A v4i32 AES call nested as another's operand: the inner result is cast back
# to v4i32, so the outer call's operand is v4i32 like a local's would be.
[[test]]
fn test_aes_nested_v4i32() -> i32
    var state: [4]i32
    var key: [4]i32
    state[0] = 0x3243f6a8 as i32
    state[1] = 0x885a308d as i32
    state[2] = 0x313198a2 as i32
    state[3] = 0xe0370734 as i32
    key[0] = 0x2b7e1516 as i32
    key[1] = 0x28aed2a6 as i32
    key[2] = 0xabf71588 as i32
    key[3] = 0x09cf4f3c as i32

    let s: v4i32 = simd_loadu(@state[0])
    let k: v4i32 = simd_loadu(@key[0])
    let step: v4i32 = aesenc(s, k)
    let stepwise: v4i32 = aesenclast(step, k)
    let nested: v4i32 = aesenclast(aesenc(s, k), k)

    var a: [4]i32
    var b: [4]i32
    simd_storeu(@a[0], stepwise)
    simd_storeu(@b[0], nested)
    if a[0] != b[0] or a[1] != b[1] or a[2] != b[2] or a[3] != b[3]
        return 1
    0

# An AES call used directly as a simd_storeu operand has no binding context;
# its type comes from its state operand (v2i64 here), not a v4i32 default.
[[test]]
fn test_aes_v2i64_call_as_store_operand() -> i32
    var state: [4]i32
    var key: [4]i32
    state[0] = 0x3243f6a8 as i32
    state[1] = 0x885a308d as i32
    state[2] = 0x313198a2 as i32
    state[3] = 0xe0370734 as i32
    key[0] = 0x2b7e1516 as i32
    key[1] = 0x28aed2a6 as i32
    key[2] = 0xabf71588 as i32
    key[3] = 0x09cf4f3c as i32

    let s2: v2i64 = simd_loadu(@state[0] as *i64)
    let k2: v2i64 = simd_loadu(@key[0] as *i64)
    let bound: v2i64 = aesdec(s2, k2)
    var a: [4]i32
    var b: [4]i32
    simd_storeu(@a[0] as *i64, bound)
    simd_storeu(@b[0] as *i64, aesdec(s2, k2))
    if a[0] != b[0] or a[1] != b[1] or a[2] != b[2] or a[3] != b[3]
        return 1
    0

fn main() -> i32
    0
