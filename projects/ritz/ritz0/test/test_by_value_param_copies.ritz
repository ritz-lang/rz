# AGAST #2415: a by-value parameter of a type that isn't move-only is a copy,
# not a const borrow (DESIGN_DECISIONS §1, #1854, LARB rulings R1 and R10).
#
# A write tells the two apart: a write to the parameter inside the callee must
# not reach the caller, and a write to the caller's value during the call must
# not reach the parameter. The regression matrix runs these on ritz0, ritz1
# and ritz1_selfhosted. The `:&` control shows a lent param does see the write,
# so the probe isn't blind. Structs, big structs and enums, spelled as a bare
# `self`, `self: T` and a plain param, are in ritz0/test_by_value_self.py (#2393).

struct Pc
    x: i64
    y: i64

var g_pc: Pc

fn pc_write_scalar(n: i64) -> i64
    n = 9
    return n

fn pc_write_field(s: Pc) -> i64
    s.x = 9
    return s.x

fn pc_write_through_alias(s: Pc, q: @&Pc) -> i64
    q.x = 9
    return s.x

fn pc_write_global(s: Pc) -> i64
    g_pc.x = 9
    return s.x

fn pc_write_element(a: [4]i64) -> i64
    a[1] = 9
    return a[1]

fn pc_lend(s:& Pc)
    s.x = 9

impl Pc
    fn pc_bump(self) -> i64
        self.x = 9
        return self.x

[[test]]
fn test_scalar_param_write_stays() -> i32
    var n: i64 = 1
    assert pc_write_scalar(n) == 9
    assert n == 1
    0

[[test]]
fn test_struct_param_write_stays() -> i32
    var c = Pc { x: 1, y: 2 }
    assert pc_write_field(c) == 9
    assert c.x == 1
    0

[[test]]
fn test_caller_write_does_not_reach_param() -> i32
    var c = Pc { x: 1, y: 2 }
    assert pc_write_through_alias(c, @&c) == 1
    assert c.x == 9
    0

[[test]]
fn test_global_write_does_not_reach_param() -> i32
    g_pc = Pc { x: 1, y: 2 }
    assert pc_write_global(g_pc) == 1
    assert g_pc.x == 9
    0

[[test]]
fn test_array_param_write_stays() -> i32
    var a: [4]i64
    a[1] = 1
    assert pc_write_element(a) == 9
    assert a[1] == 1
    0

[[test]]
fn test_by_value_self_write_stays() -> i32
    var c = Pc { x: 1, y: 2 }
    assert c.pc_bump() == 9
    assert c.x == 1
    0

[[test]]
fn test_lent_param_control_sees_the_write() -> i32
    var c = Pc { x: 1, y: 2 }
    pc_lend(c)
    assert c.x == 9
    0
