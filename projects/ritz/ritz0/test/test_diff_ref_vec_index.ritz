# AGAST #1968 (part 2 of 2): `d[i]` on a reference-typed `@Vec<T>` param.
#
# THE DEFECT (ritz0)
#
# `d[i]` on `d: @Vec<T>` (or `@&Vec<T>`) indexed the reference itself,
# yielding a Vec$T, instead of auto-dereferencing to the Vec's element:
# "Type of #2 arg mismatch: i8 != Vec$u8". `d.get(i)` worked. Part 1 is
# test_diff_ref_vec_explicit_generic.ritz.
#
# Each case covers u8, i32 and/or u64 elements, so a wrong element width
# (stride or load) changes the answer. The u64 values exceed 2^32.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.gvec
import ritzlib.sys

# --- d[i] -------------------------------------------------------------------

fn index_copy_u8(d: @Vec<u8>) -> i64
    var out = vec_new<u8>()
    for i in 0..d.len()
        out.push(d[i])
    var sum: i64 = 0
    for j in 0..out.len()
        # Through a u8 binding: `out[j] as i64` on a Vec<u8> sign-extends
        # in ritz0, a separate bug (#1979).
        let b: u8 = out[j]
        sum = sum + b as i64
    return sum

fn index_let_u8(d: @Vec<u8>) -> i64
    let b: u8 = d[1]
    return b as i64

fn index_sum_i32(d: @Vec<i32>) -> i64
    var sum: i64 = 0
    for i in 0..d.len()
        sum = sum + d[i] as i64
    return sum

fn index_u64(d: @Vec<u64>) -> u64
    return d[2]

fn index_mut_u64(d: @&Vec<u64>) -> u64
    return d[1]

[[test]]
fn test_ref_vec_index_copy_u8() -> i32
    var v = vec_new<u8>()
    v.push(65 as u8)
    v.push(200 as u8)
    v.push(10 as u8)
    assert index_copy_u8(@v) == 275
    0

[[test]]
fn test_ref_vec_index_let_u8() -> i32
    var v = vec_new<u8>()
    v.push(1 as u8)
    v.push(255 as u8)
    assert index_let_u8(@v) == 255
    0

[[test]]
fn test_ref_vec_index_sum_i32() -> i32
    var v = vec_new<i32>()
    v.push(100000)
    v.push(-3)
    v.push(70000)
    assert index_sum_i32(@v) == 169997
    0

[[test]]
fn test_ref_vec_index_u64() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(2 as u64)
    v.push(0x900000001 as u64)
    assert index_u64(@v) == 0x900000001 as u64
    0

[[test]]
fn test_ref_vec_index_mut_u64() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(0x300000004 as u64)
    assert index_mut_u64(@&v) == 0x300000004 as u64
    0

# --- p[i] on a raw *Vec<T> stays pointer arithmetic -------------------------
#
# Only a reference auto-derefs. `p: *Vec<u64>` indexes Vec-sized steps from
# p: `p[1]` is the second Vec of the array, not element 1 of the first.

fn raw_ptr_second_len(p: *Vec<u64>) -> i64
    return p[1].len

[[test]]
fn test_raw_ptr_vec_index_is_pointer_arith() -> i32
    var vs: [2]Vec<u64>
    vs[0] = vec_new<u64>()
    vs[1] = vec_new<u64>()
    vs[0].push(1 as u64)
    vs[1].push(2 as u64)
    vs[1].push(3 as u64)
    vs[1].push(4 as u64)
    assert raw_ptr_second_len(@vs[0]) == 3
    0
