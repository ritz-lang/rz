# AGAST #1819: assign_stmt parses every lvalue but a bare name and `*e` as
# one postfix_expr, and stmt_assign_lvalue picks the statement kind from its
# shape and tokens.  These are the shapes at the edges of that choice: ones
# the old token-level alternatives took (`v.f[i]`, `(*p).f[i]`) and ones
# they left to the general expression assignment (`self.f`, `t.0`,
# `((*p)).f`, `a.b.c[i]`, `n[i][j]`), plain and compound.  ritz0 is the oracle.

struct Inner
    xs: [3]i64

struct Outer
    n: i64
    inner: Inner
    arr: [2]i64

struct Counter
    n: i64

impl Counter
    fn bump(self: *Counter, k: i64)
        self.n += k
        self.n = self.n * 2

[[test]]
fn test_local_field_and_index() -> i32
    var o: Outer = Outer { n: 1, inner: Inner { xs: [0, 0, 0] }, arr: [5, 6] }
    o.n = 10
    o.n += 5
    o.arr[1] = 20
    o.arr[1] -= 3
    o.inner.xs[2] = 7
    o.inner.xs[2] *= 6
    assert o.n == 15
    assert o.arr[1] == 17
    assert o.inner.xs[2] == 42
    0

[[test]]
fn test_paren_deref_member() -> i32
    var o: Outer = Outer { n: 1, inner: Inner { xs: [0, 0, 0] }, arr: [5, 6] }
    let p: *Outer = @o
    (*p).n = 3
    (*p).n += 4
    (*p).arr[0] = 9
    (*p).arr[0] /= 3
    ((*p)).n -= 2
    ((*p)).arr[1] = 1
    assert o.n == 5
    assert o.arr[0] == 3
    assert o.arr[1] == 1
    0

[[test]]
fn test_self_field() -> i32
    var c: Counter = Counter { n: 1 }
    c.bump(2)
    assert c.n == 6
    0

[[test]]
fn test_tuple_field_and_nested_index() -> i32
    var t: (i64, i64) = (1, 2)
    t.0 = 30
    t.1 += 10
    var grid: [2][2]i64 = [ [0, 0], [0, 0] ]
    grid[1][0] = 8
    grid[1][0] += 1
    assert t.0 == 30
    assert t.1 == 12
    assert grid[1][0] == 9
    0
