# AGAST #2373: a store to a field of a cast to a pointer, `(p as *S).f = v`.
#
# THE DEFECT (ritz1)
#
# `(p as *S).x = 3` built on ritz0 but ritz1 refused it, unlocated, with
# "unhandled EXPR_MEMBER in assignment": the member path had no arm for a
# cast base.  `(*(p as *S)).x` (#2526) and the read `(p as *S).x` already
# worked.
#
# Every struct has its probed field second, so a GEP at the wrong offset
# writes `a`, not `x`.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

struct S
    a: i32
    x: i32

struct H
    pad: i64
    r: @S

# A cast escapes `@T`'s read-only rule: it writes the pointee (#2338).
fn put(p: @S, v: i32)
    (p as *S).x = v

fn bump(p: @S)
    (p as *S).x += 5

[[test]]
fn test_cast_ref_param_member_store() -> i32
    var s: S = S { a: 1, x: 4 }
    put(@s, 9)
    assert s.x == 9
    bump(@s)
    assert s.x == 14
    assert s.a == 1
    0

[[test]]
fn test_cast_int_member_store() -> i32
    var s: S = S { a: 1, x: 4 }
    let addr: i64 = @&s as i64
    (addr as *S).x = 7
    assert s.x == 7
    assert (addr as *S).x == 7
    assert s.a == 1
    0

[[test]]
fn test_cast_field_member_store() -> i32
    var s: S = S { a: 1, x: 4 }
    let h: H = H { pad: 3, r: @s }
    (h.r as *S).x = 11
    assert s.x == 11
    assert s.a == 1
    assert h.pad == 3
    0
