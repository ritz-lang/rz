# AGAST #1979: `d[i]` on a `d: @Vec<u8>` / `@Vec<u16>` param stays unsigned.
#
# THE DEFECT (ritz0)
#
# #1968 made `d[i]` on a reference auto-deref to vec_get$T, but
# _infer_ritz_type(Index) still answered the reference's inner type (the
# Vec itself) rather than its element, so `d[i] as i64` used sext: 200 ->
# -56. The local-Vec case is test_diff_vec_index_unsigned.ritz.
#
# Kept separate from the local case because ritz1 cannot index a `@Vec<T>`
# param yet (AGAST #1981).
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.gvec
import ritzlib.sys

fn first_as_i64(d: @Vec<u8>) -> i64
    return d[0] as i64

fn sum_u16(d: @Vec<u16>) -> i64
    var sum: i64 = 0
    for i in 0..d.len()
        sum = sum + d[i] as i64
    return sum

fn first_gt_second(d: @Vec<u8>) -> bool
    return d[0] > d[1]

fn mut_first_as_i64(d: @&Vec<u8>) -> i64
    return d[0] as i64

[[test]]
fn test_ref_vec_u8_index_cast_i64() -> i32
    var v = vec_new<u8>()
    v.push(200 as u8)
    assert first_as_i64(@v) == 200
    0

[[test]]
fn test_ref_vec_u16_index_cast_sum() -> i32
    var v = vec_new<u16>()
    v.push(60000 as u16)
    v.push(40000 as u16)
    assert sum_u16(@v) == 100000
    0

[[test]]
fn test_ref_vec_u8_index_compare() -> i32
    var v = vec_new<u8>()
    v.push(200 as u8)
    v.push(100 as u8)
    assert first_gt_second(@v)
    0

[[test]]
fn test_mut_ref_vec_u8_index_cast_i64() -> i32
    var v = vec_new<u8>()
    v.push(255 as u8)
    assert mut_first_as_i64(@&v) == 255
    0
