# AGAST #192: .ritz.sig file format roundtrip.
#
# Smoke-tests the on-disk shape used by both ritz0/emitter/fn_cache.py
# and ritz1/src/fn_cache.ritz: write a literal `{source_hash, functions,
# imports}` blob to a temp file, read it back, and verify byte-equality.
# This is the basic invariant both implementations rely on — the JSON
# escaping / I/O path must round-trip cleanly so a file written by either
# tool is parseable by either tool.
#
# A regression here would manifest as ritz1 failing to read a sig that
# ritz0 just wrote (or vice versa) — the file-level fast path silently
# falls back to a cold rebuild, defeating the AGAST #192 speedup.

import ritzlib.sys
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.span
import ritzlib.fmt.digits { fmt_i64_into }


# "/tmp/test_fn_cache_roundtrip_<pid>.ritz.sig".
# The regression matrix runs this file under ritz0, ritz1 and
# ritz1_selfhosted concurrently, so a fixed path let one run's O_TRUNC or
# unlink land inside another's write/read-back (AGAST #1735).
fn sig_tmp_path() -> String
    var s: String = string_from("/tmp/test_fn_cache_roundtrip_")
    s.push_i64(sys_getpid() as i64)
    s.push_str(".ritz.sig")
    s


[[test]]
fn test_fn_cache_sig_roundtrip() -> i32
    # Sample sig contents matching the format documented in fn_cache.py.
    # Hex hashes are arbitrary but exactly 16 chars (width matches both
    # SHA-256-trunc in ritz0 and FNV1a-64 in ritz1).
    let fixture: StrView = "{\n  \"source_hash\": \"deadbeefcafef00d\",\n  \"functions\": {\n    \"add\": {\n      \"hash\": \"0123456789abcdef\",\n      \"sig_hash\": \"fedcba9876543210\",\n      \"ir\": \"define i32 @add(i32 %a, i32 %b) { ret i32 0 }\"\n    }\n  },\n  \"imports\": [\"ritzlib.sys\"]\n}\n"
    let path_s: String = sig_tmp_path()
    let path: StrView = path_s.as_view()
    let n: i64 = fixture.len

    # Write fixture (created or truncated, mode 0644).
    match write_file(path, fixture)
        Ok(written) =>
            if written != n
                return 2
        Err(_) => return 1

    # Read back.
    var back: String = string_new()
    match read_file(path)
        Ok(contents) => back = contents
        Err(_) => return 3

    if back.len() != n
        return 4

    # Bytewise compare.
    if not back.as_view().eq(fixture)
        return 5

    unlink(path)
    0
