# AGAST #2022: ritz1 derefs a `*f32` / `*f64` pointer at the pointee's
# real width.
#
# THE DEFECT
#
# get_expr_type typed `*p` on a `*f32` as F32 (the pointee), but the
# OP_DEREF emission in emitter_expr_arith.ritz only knew integer widths and
# fell to `load i64`, so `*p != x` emitted `fcmp one float <i64>`, which
# clang rejects.
#
# `*p = v` likewise fell to `store i64 %float`.
#
# THE FIX (ritz1/src/emitter_expr_arith.ritz OP_DEREF, emitter_stmt.ritz
# deref store)
#
# A float pointee loads / stores `float` / `double` with no widen (an f64
# value into an f32 slot is fptrunc'd), as #1973 does for `p[i]`.
#
# Covered: `*p`, `*(p + i)`, a global `*g`, a param, `*p = v`, for f32
# and f64.
#
# Oracle: ritz0 runs every case to the same result.

var pfd_g32: *f32 = null
var pfd_g64: *f64 = null

fn pfd_first32(p: *f32) -> f32
    *p

fn pfd_at32(p: *f32, i: i64) -> f32
    *(p + i)

fn pfd_first64(p: *f64) -> f64
    *p

fn pfd_at64(p: *f64, i: i64) -> f64
    *(p + i)

# The repro from the ticket.
fn pfd_repro_main() -> i32
    var a: [2]f32 = [3.5, 1.0]
    let p: *f32 = @a as *f32
    let x: f32 = 3.5
    if *p != x
        return 1
    return 42

[[test]]
fn test_ptr_float_deref_repro() -> i32
    assert pfd_repro_main() == 42
    0

fn pfd_f32_main() -> i32
    var a: [3]f32 = [3.5, -1.25, 6.0]
    let p: *f32 = @a as *f32
    let x0: f32 = 3.5
    let x1: f32 = -1.25
    let x2: f32 = 6.0
    if *p != x0
        return 1
    if *(p + 1) != x1
        return 2
    if *(p + 2) != x2
        return 3
    # The deref is an f32, so the literal side narrows.
    if *(p + 1) * 2.0 != -2.5
        return 4
    let y: f32 = *(p + 2) + *p
    let want: f32 = 9.5
    if y != want
        return 5
    if pfd_first32(p) != x0
        return 6
    if pfd_at32(p, 2) != x2
        return 7
    pfd_g32 = p
    if *pfd_g32 != x0
        return 8
    # `*(g + 1)` omitted: a global *T strides by i8 (AGAST #2034).
    # The neighbour is untouched: a wider load would fold it in.
    *p = 0.5
    let half: f32 = 0.5
    if *p != half
        return 10
    if *(p + 1) != x1
        return 11
    return 42

[[test]]
fn test_ptr_float_deref_f32() -> i32
    assert pfd_f32_main() == 42
    0

fn pfd_f64_main() -> i32
    var a: [3]f64 = [3.5, -1.25, 6.0]
    let p: *f64 = @a as *f64
    if *p != 3.5
        return 1
    if *(p + 1) != -1.25
        return 2
    if *(p + 2) != 6.0
        return 3
    if *(p + 1) * 2.0 != -2.5
        return 4
    let y: f64 = *(p + 2) + *p
    if y != 9.5
        return 5
    if pfd_first64(p) != 3.5
        return 6
    if pfd_at64(p, 2) != 6.0
        return 7
    pfd_g64 = p
    if *pfd_g64 != 3.5
        return 8
    # `*(g + 1)` omitted: a global *T strides by i8 (AGAST #2034).
    *p = 0.5
    if *p != 0.5
        return 10
    if *(p + 1) != -1.25
        return 11
    return 42

[[test]]
fn test_ptr_float_deref_f64() -> i32
    assert pfd_f64_main() == 42
    0
