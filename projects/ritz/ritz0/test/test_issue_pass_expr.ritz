# Regression: `pass` as an `if` arm should compile as unit/no-op.
#
# It has no value, so it cannot be the value of a fn that declares a return
# type (AGAST #1429). The `if` is a statement here and the fn ends in `r`.

fn use_pass_expr(flag: bool) -> i32
    var r: i32 = 0
    if flag
        pass
    else
        r = 7
    r

[[test]]
fn test_pass_expr_if_arm() -> i32
    if use_pass_expr(true) == 0 and use_pass_expr(false) == 7
        0
    else
        1
