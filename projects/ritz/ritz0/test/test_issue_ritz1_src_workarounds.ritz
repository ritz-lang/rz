# Regression tests for AGAST #1815: ritz1's own source carried workarounds
# for five suspected codegen bugs.  Each test below is the minimal shape the
# workaround avoided, written the natural way.  The matrix runs every fn on
# ritz0, ritz1 and ritz1_selfhosted; if all three agree the workaround was
# stale and has been deleted from ritz1/src.
#
#   1. pointer stride with a binary LHS     nfa.ritz nfa_finalize, lexer_nfa.ritz Tier 1 readers
#   2. *i32 store width                     main.ritz tokenize (Tier 1 index buffers)
#   3. compound deref compare / RMW         ast_helpers.ritz enum tracker (self-hosted only)
#   4. `(*a.b).c`                           lexer_nfa.ritz lexer_next
#   5. phi after if/else with a loop arm    fn_cache.ritz sig_serialize (#1269)
#
# Everything is checked at RUNTIME: each bug compiled cleanly and only gave a
# wrong answer (or, for 5, invalid IR that clang rejects).

import ritzlib.memory

# --- 1. pointer stride: `(p + a) + b` -----------------------------------------
#
# The claim was that ritz1 only scaled `+` by the pointee size when the LHS
# was an ident or member, so the second `+` of `p + a + b` added raw bytes.

struct Idx
    n: i64
    ptr: *i64

[[test]]
fn test_ptr_stride_binary_lhs() -> i32
    var arr: [8]i64 = [10, 20, 30, 40, 50, 60, 70, 80]
    let p: *i64 = @arr[0]
    let a: i64 = 2
    let b: i64 = 3
    # reads: (p + a) + b, with and without explicit parens
    assert *(p + a + b) == 60
    assert *((p + 1) + 1) == 30
    let q: *i64 = p + a + b
    assert *q == 60
    # through a member LHS, as lexer_nfa.ritz's readers do
    let ix = Idx { n: 8, ptr: p }
    assert *(ix.ptr + a + b) == 60
    # stores: nfa_finalize's `*(indices_arr + base_off + cur_count) = t2`
    *(p + a + b) = 600
    assert arr[5] == 600
    assert arr[4] == 50
    assert arr[6] == 70
    *(ix.ptr + 1 + 2) = 400
    assert arr[3] == 400
    assert arr[2] == 30
    0

# --- 2. *i32 store width -------------------------------------------------------
#
# The Tier 1 NFA index buffers were i64 "to avoid the *i32 store-width
# codegen bug": a store through *i32 that wrote 8 bytes would clobber the
# next element.  This mirrors nfa_finalize's counting sort over i32 buffers
# held in struct fields and indexed by i64.

struct Tier1
    offset: *i32
    count: *i32
    indices: *i32

[[test]]
fn test_i32_store_width() -> i32
    var off_buf: [6]i32 = [0, 0, 0, 0, 0, 0]
    var cnt_buf: [6]i32 = [0, 0, 0, 0, 0, 0]
    var idx_buf: [8]i32 = [-1, -1, -1, -1, -1, -1, -1, -1]
    let t = Tier1 { offset: @off_buf[0], count: @cnt_buf[0], indices: @idx_buf[0] }
    # from_state of each of 7 transitions (states 0..3; states 4,5 sentinels)
    var from: [7]i64 = [2, 0, 2, 1, 3, 0, 2]
    cnt_buf[4] = 77
    cnt_buf[5] = 99

    let count_arr: *i32 = t.count
    let offset_arr: *i32 = t.offset
    let indices_arr: *i32 = t.indices
    var i: i64 = 0
    while i < 7
        let f: i64 = from[i]
        *(count_arr + f) = *(count_arr + f) + 1
        i = i + 1
    assert cnt_buf[0] == 2
    assert cnt_buf[1] == 1
    assert cnt_buf[2] == 3
    assert cnt_buf[3] == 1
    # an 8-byte store into slot 3 would have zeroed slot 4
    assert cnt_buf[4] == 77
    assert cnt_buf[5] == 99

    var acc: i32 = 0
    var s: i64 = 0
    while s < 4
        *(offset_arr + s) = acc
        acc = acc + *(count_arr + s)
        s = s + 1
    assert off_buf[0] == 0
    assert off_buf[1] == 2
    assert off_buf[2] == 3
    assert off_buf[3] == 6
    assert off_buf[4] == 0

    s = 0
    while s < 4
        *(count_arr + s) = 0
        s = s + 1
    assert cnt_buf[4] == 77

    var k: i64 = 0
    while k < 7
        let f2: i64 = from[k]
        let base: i64 = *(offset_arr + f2) as i64
        let cur: i32 = *(count_arr + f2)
        *(indices_arr + base + (cur as i64)) = k as i32
        *(count_arr + f2) = cur + 1
        k = k + 1
    # state 0: transitions 1, 5; state 1: 3; state 2: 0, 2, 6; state 3: 4
    assert idx_buf[0] == 1
    assert idx_buf[1] == 5
    assert idx_buf[2] == 3
    assert idx_buf[3] == 0
    assert idx_buf[4] == 2
    assert idx_buf[5] == 6
    assert idx_buf[6] == 4
    assert idx_buf[7] == -1
    0

# --- 3. compound deref compare / RMW through globals ----------------------------
#
# ast_helpers.ritz's enum tracker read and updated its global tables through
# intermediate `let`s because, under ritz1_selfhosted, `*(p + i) = *(p + i) + 1`
# was said to be off by one and `*(*(g + i) + k) != *(name + k)` to compare
# equal strings unequal.  These are those forms, through globals, verbatim.

var g_names: **u8 = null
var g_name_lens: *i32 = null
var g_starts: *i32 = null
var g_counts: *i32 = null
var g_count: i32 = 0

fn g_find(name: *u8, len: i32) -> i32
    var ei: i32 = 0
    while ei < g_count
        if *(g_name_lens + ei) == len
            var match_e: i32 = 1
            for k in 0..len
                if *(*(g_names + ei) + k) != *(name + k)
                    match_e = 0
            if match_e == 1
                return ei
        ei = ei + 1
    return 0 - 1

fn g_setup()
    g_names = malloc(3 * 8) as **u8
    g_name_lens = malloc(3 * 4) as *i32
    g_starts = malloc(3 * 4) as *i32
    g_counts = malloc(3 * 4) as *i32
    *(g_names + 0) = c"Alpha"
    *(g_names + 1) = c"Beta"
    *(g_names + 2) = c"Gamma"
    *(g_name_lens + 0) = 5
    *(g_name_lens + 1) = 4
    *(g_name_lens + 2) = 5
    for j in 0..3
        *(g_starts + j) = j * 10
        *(g_counts + j) = 0
    g_count = 3

# RMW in the exact shape enum_variant_record_impl used to avoid.
[[test]]
fn test_compound_deref_rmw_global() -> i32
    g_setup()
    for r in 0..4
        *(g_counts + g_count - 1) = *(g_counts + g_count - 1) + 1
    *(g_counts + 1) = *(g_counts + 1) + 1
    assert *(g_counts + 0) == 0
    assert *(g_counts + 1) == 1
    assert *(g_counts + 2) == 4
    0

# Byte compare through a nested global deref (is_enum_type's original form).
[[test]]
fn test_compound_deref_compare_global() -> i32
    g_setup()
    assert g_find(c"Alpha", 5) == 0
    assert g_find(c"Beta", 4) == 1
    assert g_find(c"Gamma", 5) == 2
    assert g_find(c"Gamme", 5) == 0 - 1
    0

# Direct deref of global tables as a range bound and in the loop body
# (enum_variant_index's original form).
[[test]]
fn test_compound_deref_range_global() -> i32
    g_setup()
    *(g_counts + 2) = 4
    let ei: i32 = 2
    var sum: i32 = 0
    for vi in 0..*(g_counts + ei)
        sum = sum + *(g_starts + ei) + vi
    assert sum == 20 + 21 + 22 + 23
    0

# The same nested deref over a `**i32`, where a missing stride or an i64
# load cannot hide behind u8's stride of 1: param, local and global, read
# and write.
var g_rows: **i32 = null

fn row_get(rows: **i32, r: i64, c: i64) -> i32
    *(*(rows + r) + c)

fn row_set(rows: **i32, r: i64, c: i64, v: i32)
    *(*(rows + r) + c) = v

[[test]]
fn test_nested_deref_ptr_ptr_i32() -> i32
    var r0: [4]i32 = [1, 2, 3, 4]
    var r1: [4]i32 = [5, 6, 7, 8]
    var rows_buf: [2]*i32 = [@r0[0], @r1[0]]
    let rows: **i32 = @rows_buf[0]
    assert row_get(rows, 0, 2) == 3
    assert row_get(rows, 1, 3) == 8
    assert *(*(rows + 1) + 1) == 6
    row_set(rows, 1, 2, 70)
    assert r1[2] == 70
    assert r1[1] == 6
    assert r1[3] == 8
    *(*(rows + 0) + 1) = 20
    assert r0[1] == 20
    assert r0[2] == 3
    g_rows = rows
    assert *(*(g_rows + 1) + 3) == 8
    *(*(g_rows + 1) + 0) = 50
    assert r1[0] == 50
    assert r1[1] == 6
    # `**pp`, read and write: an i64 store here would clobber r0[1]
    assert **rows == 1
    **rows = -7
    assert r0[0] == -7
    assert r0[1] == 20
    0

# --- 4. `(*a.b).c` ---------------------------------------------------------------
#
# lexer_next bound `lex.nfa` to a local because `(*lex.nfa).start_state` was
# said to emit "; ERROR: unhandled EXPR_MEMBER".

struct Inner4
    pad: i32
    start_state: i64

struct Outer4
    tag: i64
    nfa: *Inner4

fn start_of(lex: *Outer4) -> i32
    (*lex.nfa).start_state as i32

[[test]]
fn test_deref_member_member() -> i32
    var inner = Inner4 { pad: 7, start_state: 42 }
    var outer = Outer4 { tag: 1, nfa: @inner }
    assert start_of(@outer) == 42
    assert (*outer.nfa).start_state == 42
    assert (*outer.nfa).pad == 7
    let po: *Outer4 = @outer
    assert (*po.nfa).start_state == 42
    0

# --- 5. phi after an if/else whose else arm loops (#1269) ------------------------
#
# sig_serialize hoisted its loops into helpers because ritz1 recorded a stale
# phi predecessor for an if/else whose else arm runs a `while` before its
# trailing call ("PHI node entries do not match predecessors").  This is the
# pre-workaround shape: a statement if/else, the else arm a loop with a nested
# if and a local array, a trailing call, then more code after the if.

fn push5(acc: *i64, v: i64)
    *acc = *acc * 3 + v

fn serialize5(n: i32, acc: *i64)
    push5(acc, 1)
    if n == 0
        push5(acc, 2)
    else
        push5(acc, 3)
        var i: i32 = 0
        while i < n
            var hex: [4]i64 = [1, 2, 3, 4]
            var k: i64 = 0
            while k < 4
                push5(acc, hex[k])
                k = k + 1
            if i + 1 < n
                push5(acc, 5)
            push5(acc, 6)
            i = i + 1
        push5(acc, 7)
    push5(acc, 8)

fn expect5(n: i32) -> i64
    var e: i64 = 1
    if n == 0
        e = e * 3 + 2
    else
        e = e * 3 + 3
        for i in 0..n
            e = e * 3 + 1
            e = e * 3 + 2
            e = e * 3 + 3
            e = e * 3 + 4
            if i + 1 < n
                e = e * 3 + 5
            e = e * 3 + 6
        e = e * 3 + 7
    e * 3 + 8

[[test]]
fn test_phi_if_else_loop_arm() -> i32
    for n in 0..4
        var acc: i64 = 0
        serialize5(n, @acc)
        assert acc == expect5(n)
    0
