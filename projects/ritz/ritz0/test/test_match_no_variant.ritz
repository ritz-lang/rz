# Regression tests for AGAST #4586: a `match` on a repr enum (`enum E: i32`)
# whose stored value names no variant.  An exhaustive match with no `_` or
# binding arm traps on it (LANGUAGE_SPEC §10.1); a trap exits the process, so
# that half is pinned by ritz0/tests/test_match_no_variant_trap.py.  These
# rows pin the other half on all three compilers: a `_` or binding arm takes
# such a value, and a valid value takes its own arm through an exhaustive
# match, statement or value, with no trap.

enum W: i32
    Neg = -1
    Big = 1024

struct Box
    w: W

var g_hit: i32 = 0

fn note(n: i32)
    g_hit = n

fn under(w: W) -> i32
    match w
        Neg => 1
        _ => 7

fn bound(w: W) -> i32
    match w
        Neg => 1
        other => 100

fn exact(w: W) -> i32
    match w
        Neg => 3
        Big => 4

fn exact_stmt(b: *Box)
    match (*b).w
        Neg => note(5)
        Big => note(6)

[[test]]
fn test_catch_all_takes_no_variant_value() -> i32
    var raw: i64 = 0
    let b: *Box = @raw as *Box
    assert under((*b).w) == 7
    assert bound((*b).w) == 100
    0

[[test]]
fn test_exhaustive_match_takes_valid_value() -> i32
    var raw: i64 = 0
    let b: *Box = @raw as *Box
    (*b).w = W.Big
    assert exact((*b).w) == 4
    exact_stmt(b)
    assert g_hit == 6
    (*b).w = W.Neg
    assert exact((*b).w) == 3
    exact_stmt(b)
    assert g_hit == 5
    0
