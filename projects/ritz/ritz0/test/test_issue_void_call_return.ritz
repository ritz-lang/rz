# Regression (AGAST #4840): `return g(x)` in a fn with no return type, where
# `g` has none either, is the call and then a bare `ret void`.  ritz1 wrote
# `ret void %.0`, returning the void call's nonexistent value: invalid IR.

fn set_one(x: *i32)
    *x = 1

fn set_via(x: *i32)
    return set_one(x)

struct Cell
    v: i32

impl Cell
    fn put(self: @&Cell, n: i32)
        self.v = n

    fn put_via(self: @&Cell, n: i32)
        return self.put(n)

[[test]]
fn test_return_void_call() -> i32
    var v: i32 = 0
    set_via(@v)
    if v == 1 then 0 else 1

[[test]]
fn test_return_void_method_call() -> i32
    var c = Cell { v: 0 }
    c.put_via(7)
    if c.v == 7 then 0 else 1
