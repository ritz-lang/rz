# AGAST #1641: `eprint("...{x}...")` writes to stderr, and a StrView
# placeholder prints its bytes, under every compiler.
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted, so the
# self-hosted compiler's lowering is checked too. The wider cases are in
# ritz0/test_eprint_interpolation.py.
#
# Each test points one fd (1 or 2) at a pipe, prints, restores the fd, and
# compares the bytes that came out of the pipe with what ritz0 prints.

import ritzlib.sys
import ritzlib.strview
import ritzlib.result
import ritzlib.span
import ritzlib.fd
import ritzlib.string

var g_rd: i32 = 0
var g_saved: i32 = 0
var g_fd: i32 = 0

fn capture_begin(fd: i32) -> i32
    g_fd = fd
    capture_into(fd)

# Point descriptor `fd` at a new pipe, saving the old one in g_saved and the
# pipe's read end in g_rd (raw numbers: globals hold no Fd). 0, or 1 on error.
fn capture_into(fd: i32) -> i32
    match pipe()
        Ok(pp) =>
            var p: Pipe = pp
            match fd_borrow(fd).dup()
                Ok(saved) => g_saved = saved.raw()
                Err(_) => return 1
            p.write.dup_to(fd)
            p.write.close()
            g_rd = p.read.raw()
            0
        Err(_) => 1

# Restore the captured fd, read what was written, compare it with `want`.
# Returns 0 on an exact byte match.
fn capture_end_expect(want: StrView) -> i32
    var saved: Fd = fd_adopt(g_saved)
    saved.dup_to(g_fd)
    saved.close()
    var rd: Fd = fd_adopt(g_rd)
    var buf: [256]u8
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < 256
        match rd.read(Span<u8> { ptr: @buf[got], len: 256 - got })
            Ok(k) => n = k
            Err(_) => n = 0
        got = got + n
    rd.close()
    var i: i64 = 0
    while i < want.len
        if i >= got
            return 2
        if buf[i] != *(want.ptr + i)
            return 3
        i = i + 1
    if i != got
        return 4
    0

fn twice(n: i64) -> i64
    return n * 2

[[test]]
fn test_eprint_goes_to_stderr() -> i32
    assert capture_begin(2) == 0
    let x: i64 = 5
    let t: bool = true
    eprint("x={x} t={t} call={twice(x)} {{lit}}\n")
    assert capture_end_expect("x=5 t=true call=10 {lit}\n") == 0
    0

[[test]]
fn test_eprint_leaves_stdout_alone() -> i32
    assert capture_begin(1) == 0
    eprint("")
    print("only stdout\n")
    assert capture_end_expect("only stdout\n") == 0
    0

[[test]]
fn test_print_strview() -> i32
    assert capture_begin(1) == 0
    let v: StrView = "view"
    let part: StrView = StrView { ptr: c"hello", len: 2 }
    print("[{v}] [{part}]\n")
    assert capture_end_expect("[view] [he]\n") == 0
    0

[[test]]
fn test_eprint_strview() -> i32
    assert capture_begin(2) == 0
    let name: StrView = "--out"
    eprint("option '{name}' needs a value\n")
    assert capture_end_expect("option '--out' needs a value\n") == 0
    0

# A String prints through its view (`String.as_view`).
[[test]]
fn test_string_through_its_view() -> i32
    var s: String = string_from("owned")
    s.push_str("!")
    assert capture_begin(2) == 0
    eprint("e=[{s.as_view()}] n={s.len()}\n")
    assert capture_end_expect("e=[owned!] n=6\n") == 0
    assert capture_begin(1) == 0
    print("s=[{s.as_view()}]\n")
    assert capture_end_expect("s=[owned!]\n") == 0
    0
