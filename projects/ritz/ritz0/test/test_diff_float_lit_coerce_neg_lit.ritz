# AGAST #1965: ritz1 coerces each float binop operand to the binop's type.
#
# THE DEFECT
#
# emit_expr_binary (ritz1/src/emitter_expr_arith.ritz) chose `fty = float`
# when one side was f32 and the other a float literal, but never narrowed
# the literal: EXPR_FLOAT_LIT always emits a `double`.  `y != 3.0` with
# `y: f32` emitted `fcmp one float %y, %double`, which clang rejects; the
# same for fadd / fsub / fmul / fdiv.  A negated literal (`y * -2.0`,
# lowered as `fneg double` since #1959) was not recognised as a literal at
# all, so it fell to `double` with an unwidened f32 operand.  An f32 local
# against an f64 local did no fpext either.
#
# THE FIX
#
# After choosing fty, each operand goes through emit_float_coerce: a double
# literal / `-literal` is fptrunc'd to float, an f32 operand fpext'd to
# double when the other side is an f64 value.
#
# Oracle: ritz0 runs every case to the same result.
#
# This file: an f32 operand against a negated float literal (`-lit`).
#
# AGAST #1969: ritz0 narrowed only a bare FloatLit, so `t != -0.1` with
# `t: f32 = -0.1` widened t and compared in double, where
# fpext(float(-0.1)) != -0.1.  Both compilers now treat a negated literal
# (recursively, `-(-0.1)`) as a literal.  The inexact cases below pin that:
# with either compiler's `-lit` narrowing removed, they go red.

fn flc_id32(v: f32) -> f32
    v

# --- f32 against a negated float literal ----------------------------------

fn flc_neg_lit_main() -> i32
    let y: f32 = -2.5
    if y != -2.5
        return 1
    if -2.5 != y
        return 2
    if y * -2.0 != 5.0
        return 3
    if flc_id32(-2.5) != -2.5
        return 4
    if y < -3.0
        return 5
    return 42

[[test]]
fn test_flc_neg_lit() -> i32
    assert flc_neg_lit_main() == 42
    0

# --- inexact values: only correct when `-lit` narrows (AGAST #1969) -------

fn flc_neg_lit_inexact_main() -> i32
    let t: f32 = -0.1
    if t != -0.1
        return 1
    if -0.1 != t
        return 2
    if not (t == -0.1)
        return 3
    let n: f32 = 0.1
    if n != -(-0.1)
        return 4
    if -(-0.1) != n
        return 5
    # Arithmetic shares the path: f32 + -lit is computed at f32 width.
    let z: f32 = 0.0
    if z + -0.1 != t
        return 6
    if -0.1 + z != t
        return 7
    if t - -0.1 != z
        return 8
    let one: f32 = 1.0
    if one * -0.1 != t
        return 9
    if -0.1 / one != t
        return 10
    return 42

[[test]]
fn test_flc_neg_lit_inexact() -> i32
    assert flc_neg_lit_inexact_main() == 42
    0
