# Calls through a non-identifier callee (AGAST #1747)
#
# #1747: ritz1's parser turned `(args)` into a call only after an identifier
# or a member, so `fs[1](3)` silently became `fs[1]`: the fn pointer itself,
# ptrtoint'd and stored as the result (invalid IR for a struct result, a
# wrong value for a scalar).  The call is now built, and an element of a
# `[N]fn(..) -> T` local is called through that signature, sret included.

struct Big
    data: [64]i64
    count: i32

fn big_make(n: i32) -> Big
    var b: Big = Big { data: [0; 64], count: n }
    b.data[63] = (n * 2) as i64
    return b

fn big_make_plus(n: i32) -> Big
    return big_make(n + 100)

fn total(p: *Big) -> i64
    return p.count as i64 + p.data[63]

fn take(b: Big) -> i64
    return total(@b)

fn inc(x: i32) -> i32
    return x + 1

fn dbl(x: i32) -> i32
    return x * 2

fn is_big(x: i64) -> bool
    return x > 1000

[[test]]
fn test_indexed_fnptr_scalar_result() -> i32
    let ops: [2]fn(i32) -> i32 = [inc, dbl]
    assert ops[0](5) == 6
    assert ops[1](5) == 10
    var i: i64 = 1
    assert ops[i](21) == 42
    0

[[test]]
fn test_indexed_fnptr_bool_result() -> i32
    let ps: [1]fn(i64) -> bool = [is_big]
    assert ps[0](5000)
    assert not ps[0](5)
    0

[[test]]
fn test_indexed_fnptr_sret_result() -> i32
    let fs: [2]fn(i32) -> Big = [big_make, big_make_plus]
    var z: Big = fs[1](3)
    assert total(@z) == 103 + 206
    z = fs[0](4)
    assert total(@z) == 4 + 8
    # the sret result straight into a by-value arg
    assert take(fs[0](7)) == 7 + 14
    0

[[test]]
fn test_indexed_fnptr_inferred_let() -> i32
    # No annotation: the local's type comes from the callee's signature.
    let fs: [2]fn(i32) -> Big = [big_make, big_make_plus]
    let z = fs[0](6)
    assert z.count == 6
    assert total(@z) == 6 + 12
    let ops: [2]fn(i32) -> i32 = [inc, dbl]
    let n = ops[1](-4)
    assert n == -8
    0
