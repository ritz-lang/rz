# AGAST #1968 (part 1 of 2): generic free fns on a reference-typed `@Vec<T>` param.
#
# The ticket reported `vec_as_ptr(d)` on `d: @Vec<u8>` as "Unknown function"
# and asked for T to be inferred. Neither ritz0 nor ritz1 has ever inferred a
# generic fn's type args from its arguments (it fails on a local `@v` too),
# and LANGUAGE_SPEC section 4.4 requires them spelled out. So the spelled-out
# form is what these tests pin, on `@Vec<T>` and `@&Vec<T>` params, across all
# three compilers. ritz0 now rejects the inferred form with a diagnostic that
# names the fix (test_generic_call_needs_type_args.py). Part 2 is
# test_diff_ref_vec_index.ritz (`d[i]`).
#
# u8, i32 and u64 elements: a wrong element width (stride or load) changes
# the answer. The u64 values exceed 2^32.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.gvec
import ritzlib.sys

# --- vec_as_ptr<T>(d) -------------------------------------------------------

fn as_ptr_u8(d: @Vec<u8>) -> i64
    let p = vec_as_ptr<u8>(d)
    return p[1] as i64

fn as_ptr_i32(d: @Vec<i32>) -> i64
    let p = vec_as_ptr<i32>(d)
    return p[1] as i64

fn as_ptr_u64(d: @Vec<u64>) -> u64
    let p = vec_as_ptr<u64>(d)
    return p[1]

fn as_ptr_mut_i32(d: @&Vec<i32>) -> i64
    let p = vec_as_ptr<i32>(d)
    return p[2] as i64

[[test]]
fn test_ref_vec_as_ptr_u8() -> i32
    var v = vec_new<u8>()
    v.push(65 as u8)
    v.push(200 as u8)
    assert as_ptr_u8(@v) == 200
    0

[[test]]
fn test_ref_vec_as_ptr_i32() -> i32
    var v = vec_new<i32>()
    v.push(7)
    v.push(-100000)
    assert as_ptr_i32(@v) == -100000
    0

[[test]]
fn test_ref_vec_as_ptr_u64() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(0x500000003 as u64)
    assert as_ptr_u64(@v) == 0x500000003 as u64
    0

[[test]]
fn test_ref_vec_as_ptr_mut_i32() -> i32
    var v = vec_new<i32>()
    v.push(1)
    v.push(2)
    v.push(70000)
    assert as_ptr_mut_i32(@&v) == 70000
    0

# --- vec_get_ptr<T>(d, i) ---------------------------------------------------

fn get_ptr_u8(d: @Vec<u8>) -> i64
    let p = vec_get_ptr<u8>(d, 1)
    return *p as i64

fn get_ptr_u64(d: @Vec<u64>) -> u64
    let p = vec_get_ptr<u64>(d, 2)
    return *p

[[test]]
fn test_ref_vec_get_ptr_u8() -> i32
    var v = vec_new<u8>()
    v.push(3 as u8)
    v.push(250 as u8)
    assert get_ptr_u8(@v) == 250
    0

[[test]]
fn test_ref_vec_get_ptr_u64() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(2 as u64)
    v.push(0x700000009 as u64)
    assert get_ptr_u64(@v) == 0x700000009 as u64
    0

# --- local Vec (AGAST #1980): not ref-specific ------------------------------
#
# The unannotated `let p` must take the call's substituted return type (*i32,
# *u64), not the generic fn's declared `*T`: a byte stride or a `load %T`
# changes the answer.

[[test]]
fn test_local_vec_as_ptr_i32() -> i32
    var v = vec_new<i32>()
    v.push(1)
    v.push(42)
    v.push(-70000)
    let p = vec_as_ptr<i32>(@v)
    assert p[1] == 42
    assert p[2] == -70000
    0

[[test]]
fn test_local_vec_get_ptr_u64() -> i32
    var v = vec_new<u64>()
    v.push(1 as u64)
    v.push(0x600000005 as u64)
    let p = vec_get_ptr<u64>(@v, 1)
    assert *p == 0x600000005 as u64
    0
