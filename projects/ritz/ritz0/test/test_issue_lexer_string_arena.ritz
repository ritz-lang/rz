# The final literal in the file — the one the old arena zeroed out.
fn last_literal() -> *u8
    return c"0159-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

[[test]]
fn test_all_literals_survive_lexing() -> i32
    # 160 literals x 80 bytes.  Under the fixed 8192-byte arena this summed
    # to roughly 8192 instead, because the tail literals lexed as empty.
    assert total_literal_bytes() == 12800
    0

[[test]]
fn test_last_literal_intact() -> i32
    let s: *u8 = last_literal()
    assert strlen(s) == 80
    # Spot-check the payload, not just the length.
    assert *(s + 0) == 48         # first digit of the index prefix
    assert *(s + 4) == 45           # '-'
    assert *(s + 79) == 120      # trailing 'x'
    0
