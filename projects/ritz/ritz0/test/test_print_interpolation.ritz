# AGAST #1521: `print("x={x}")` interpolates under every compiler.
#
# ritz1 used to print the placeholder verbatim (`x={x}`) and exit 0. The
# matrix runs this file under ritz0, ritz1 and ritz1_selfhosted, so the
# self-hosted compiler's lowering is checked too, not just the one ritz0
# built. ritz0/test_ritz1_print_interpolation.py holds the wider cases.
#
# Each test points fd 1 at a pipe, prints, puts fd 1 back, and compares the
# bytes that came out of the pipe with what ritz0 prints.

import ritzlib.sys
import ritzlib.strview
import ritzlib.result
import ritzlib.span
import ritzlib.fd

# The capture's state: the pipe's read end, and the saved stdout.
var g_rd: i32 = 0
var g_saved: i32 = 0

fn capture_begin() -> i32
    match pipe()
        Ok(pp) =>
            var p: Pipe = pp
            match fd_stdout().dup()
                Ok(saved) => g_saved = saved.raw()
                Err(_) => return 1
            p.write.dup_to(1)
            p.write.close()
            g_rd = p.read.raw()
            0
        Err(_) => 1

# Restore stdout, read what was printed, and compare it with `want`.
# Returns 0 on an exact byte match.
fn capture_end_expect(want: StrView) -> i32
    var saved: Fd = fd_adopt(g_saved)
    saved.dup_to(1)
    saved.close()
    var rd: Fd = fd_adopt(g_rd)
    var buf: [256]u8
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < 256
        match rd.read(Span<u8> { ptr: @buf[got], len: 256 - got })
            Ok(k) => n = k
            Err(_) => n = 0
        got = got + n
    rd.close()
    var i: i64 = 0
    while i < want.len
        if i >= got
            return 2
        if buf[i] != *(want.ptr + i)
            return 3
        i = i + 1
    if i != got
        return 4
    0

fn twice(n: i64) -> i64
    return n * 2

[[test]]
fn test_interp_repro() -> i32
    assert capture_begin() == 0
    let x: i64 = 5
    print("x={x}\n")
    assert capture_end_expect("x=5\n") == 0
    0

[[test]]
fn test_interp_types() -> i32
    assert capture_begin() == 0
    let a: i64 = -120
    let b: i32 = 0
    let t: bool = true
    let s: *u8 = c"str"
    print("{a},{b},{t},{a > 0},{s}\n")
    assert capture_end_expect("-120,0,true,false,str\n") == 0
    0

[[test]]
fn test_interp_expressions() -> i32
    assert capture_begin() == 0
    let x: i64 = 21
    print("{twice(x)} { x + 1 }\n")
    assert capture_end_expect("42 22\n") == 0
    0

[[test]]
fn test_interp_braces() -> i32
    assert capture_begin() == 0
    let x: i64 = 1
    print("{{x}} \{x\} a } b { c\n")
    assert capture_end_expect("{x} {x} a } b { c\n") == 0
    0
