# Test level 27: Generic Vec<T>
#
# Tests the Vec<T> type for dynamic arrays.
# Features tested:
# - vec_new<T> creates empty vec
# - vec_push<T> appends elements
# - vec_get<T> retrieves elements
# - vec_pop<T> removes last element
# - vec_drop<T> frees memory
# - Vec<T> with various types (i32, i64, structs)

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec

# ============================================================================
# Basic Vec Tests
# ============================================================================

[[test]]
fn test_vec_i32_basic() -> i32
    var v: Vec<i32> = vec_new<i32>()
    assert v.len() == 0, "new vec should be empty"
    assert v.is_empty(), "new vec should be empty"

    # Push some elements
    v.push(10)
    v.push(20)
    v.push(30)

    assert v.len() == 3, "len should be 3"
    assert not v.is_empty(), "vec should not be empty"

    # Get elements
    assert v.get(0) == 10, "v[0] should be 10"
    assert v.get(1) == 20, "v[1] should be 20"
    assert v.get(2) == 30, "v[2] should be 30"

    return 0

[[test]]
fn test_vec_i64_basic() -> i32
    var v: Vec<i64> = vec_new<i64>()

    v.push(1000000)
    v.push(2000000)

    assert v.len() == 2, "len should be 2"
    assert v.get(0) == 1000000, "v[0] should be 1000000"
    assert v.get(1) == 2000000, "v[1] should be 2000000"

    return 0

[[test]]
fn test_vec_pop() -> i32
    var v: Vec<i32> = vec_new<i32>()

    v.push(1)
    v.push(2)
    v.push(3)

    assert v.len() == 3, "len should be 3"

    let a: i32 = v.pop()
    assert a == 3, "popped should be 3"
    assert v.len() == 2, "len should be 2"

    let b: i32 = v.pop()
    assert b == 2, "popped should be 2"
    assert v.len() == 1, "len should be 1"

    let c: i32 = v.pop()
    assert c == 1, "popped should be 1"
    assert v.len() == 0, "len should be 0"

    return 0

[[test]]
fn test_vec_set() -> i32
    var v: Vec<i32> = vec_new<i32>()

    v.push(100)
    v.push(200)

    assert v.get(0) == 100, "v[0] should be 100"

    v.set(0, 999)
    assert v.get(0) == 999, "v[0] should be 999"

    return 0

[[test]]
fn test_vec_first_last() -> i32
    var v: Vec<i32> = vec_new<i32>()

    v.push(1)
    v.push(2)
    v.push(3)

    assert v.first() == 1, "first should be 1"
    assert v.last() == 3, "last should be 3"

    return 0

# ============================================================================
# Vec with Struct Types
# ============================================================================

struct Point
    x: i32
    y: i32

[[test]]
fn test_vec_struct() -> i32
    var v: Vec<Point> = vec_new<Point>()

    var p1: Point = Point { x: 10, y: 20 }
    var p2: Point = Point { x: 30, y: 40 }

    v.push(p1)
    v.push(p2)

    assert v.len() == 2, "len should be 2"

    let got1: Point = v.get(0)
    assert got1.x == 10, "p1.x should be 10"
    assert got1.y == 20, "p1.y should be 20"

    let got2: Point = v.get(1)
    assert got2.x == 30, "p2.x should be 30"
    assert got2.y == 40, "p2.y should be 40"

    return 0

[[test]]
fn test_vec_struct_ptr() -> i32
    var v: Vec<Point> = vec_new<Point>()

    var p: Point = Point { x: 1, y: 2 }
    v.push(p)

    # Modify via pointer
    let ptr: *Point = v.get_ptr(0)
    ptr.x = 100
    ptr.y = 200

    let got: Point = v.get(0)
    assert got.x == 100, "x should be 100"
    assert got.y == 200, "y should be 200"

    return 0

# ============================================================================
# Capacity and Growth Tests
# ============================================================================

[[test]]
fn test_vec_with_cap() -> i32
    var v: Vec<i32> = vec_with_cap<i32>(100)

    assert v.len() == 0, "len should be 0"
    assert v.cap() >= 100, "cap should be >= 100"

    v.push(42)
    assert v.len() == 1, "len should be 1"
    assert v.cap() >= 100, "cap should still be >= 100"

    return 0

[[test]]
fn test_vec_growth() -> i32
    var v: Vec<i32> = vec_new<i32>()

    # Push more than initial capacity to trigger growth
    var i: i32 = 0
    while i < 100
        v.push(i)
        i = i + 1

    assert v.len() == 100, "len should be 100"
    assert v.cap() >= 100, "cap should be >= 100"

    # Verify all elements
    i = 0
    while i < 100
        assert v.get(i as i64) == i, "element mismatch"
        i = i + 1

    return 0

[[test]]
fn test_vec_clear() -> i32
    var v: Vec<i32> = vec_new<i32>()

    v.push(1)
    v.push(2)
    v.push(3)

    let old_cap: i64 = v.cap()

    v.clear()
    assert v.len() == 0, "len should be 0 after clear"
    assert v.cap() == old_cap, "cap should be unchanged"

    # Can push again
    v.push(42)
    assert v.get(0) == 42, "new element should be 42"

    return 0

# ============================================================================
# u8 Vec Test
# ============================================================================

[[test]]
fn test_vec_u8() -> i32
    var v: Vec<u8> = vec_new<u8>()

    v.push(65)  # 'A'
    v.push(66)  # 'B'
    v.push(67)  # 'C'

    assert v.len() == 3, "len should be 3"
    assert v.get(0) == 65, "v[0] should be 65"
    assert v.get(1) == 66, "v[1] should be 66"
    assert v.get(2) == 67, "v[2] should be 67"

    return 0
