# test_tagged_prim_lib.ritz - ritz0-built half of test_diff_tagged_prim_args.
#
# The regression matrix compiles a test file's sibling imports with ritz0 and
# links them into every cell, so in the ritz1 cell these fns are ritz0 code
# called by ritz1 code: each Option/Result crosses the compiler boundary.

import ritzlib.result
import ritzlib.option

fn tp_some_u32(v: u32) -> Option<u32>
    return Some(v)

fn tp_some_u16(v: u16) -> Option<u16>
    return Some(v)

fn tp_some_i16(v: i16) -> Option<i16>
    return Some(v)

fn tp_some_bool(v: bool) -> Option<bool>
    return Some(v)

fn tp_some_f64(v: f64) -> Option<f64>
    return Some(v)

fn tp_some_f32(v: f32) -> Option<f32>
    return Some(v)

fn tp_ok_f64(v: f64) -> Result<f64, i32>
    return Ok(v)

fn tp_ok_f32(v: f32) -> Result<f32, i32>
    return Ok(v)

fn tp_ok_bool(v: bool) -> Result<bool, i32>
    return Ok(v)

fn tp_err_bool(e: i32) -> Result<bool, i32>
    return Err(e)

# Takes an Option<u32> built by the caller: 0 for None, else the payload + 1.
fn tp_unwrap_u32(o: Option<u32>) -> i64
    return match o
        Some(v) => v as i64 + 1
        None => 0

# Takes a Result<u32, i32> built by the caller: payload, or -(err).
fn tp_unwrap_res_u32(r: Result<u32, i32>) -> i64
    return match r
        Ok(v) => v as i64
        Err(e) => 0 - (e as i64)

# AGAST #1945: float payloads built by the caller. 1 if the payload equals
# `want`, 0 if it differs, -1 for None/Err.
fn tp_is_some_f64(o: Option<f64>, want: f64) -> i64
    return match o
        Some(v) => tp_f64_eq(v, want)
        None => -1

fn tp_is_some_f32(o: Option<f32>, want: f32) -> i64
    return match o
        Some(v) => tp_f32_eq(v, want)
        None => -1

fn tp_is_ok_f64(r: Result<f64, i32>, want: f64) -> i64
    return match r
        Ok(v) => tp_f64_eq(v, want)
        Err(e) => -1

fn tp_is_ok_f32(r: Result<f32, i32>, want: f32) -> i64
    return match r
        Ok(v) => tp_f32_eq(v, want)
        Err(e) => -1

fn tp_f64_eq(v: f64, want: f64) -> i64
    if v == want
        return 1
    return 0

fn tp_f32_eq(v: f32, want: f32) -> i64
    if v == want
        return 1
    return 0
