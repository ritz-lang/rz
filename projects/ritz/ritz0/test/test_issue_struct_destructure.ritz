# Regression: a struct returned by value can be bound and its fields read.
# (Positional `let (x, y) = s` of a named struct is refused under LARB R67;
# this test used that form until AGAST #3498.)

struct Pair
    a: i32
    b: i32

fn make_pair() -> Pair
    Pair { a: 2, b: 8 }

[[test]]
fn test_struct_destructure() -> i32
    let p = make_pair()
    if p.a + p.b == 10
        0
    else
        1
