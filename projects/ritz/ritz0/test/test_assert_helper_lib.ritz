# AGAST #1869: [[test_helper]] fns in another module, imported by
# test_assert_operands.ritz.  The matrix compiles this file with ritz0 for
# every cell, so the ritz1 cells also prove the two compilers agree on the
# call-site globals (__ritz_assert_site_*) a helper reads.
#
# LINE NUMBERS ARE PART OF test_assert_operands.ritz's EXPECTED OUTPUT: the
# assert in lib_expect_eq is reported as test_assert_helper_lib.ritz:14.

[[test_helper]]
pub fn lib_expect_eq(got: i64, want: i64)
    # A helper calling a helper: the reported call site is still the
    # [[test]] fn's, because only [[test]] fns record one.
    let unused: i64 = 0
    assert got == want

[[test_helper]]
pub fn lib_expect_pair(a: i64, b: i64)
    lib_expect_eq(a, b)
