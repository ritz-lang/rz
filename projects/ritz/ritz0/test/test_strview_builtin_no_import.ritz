# AGAST #3326: StrView is a built-in type, so its fields and its struct
# literal work in a file that imports nothing.
#
# Every "..." literal is a StrView with or without an import, but ritz0 only
# registered its struct when something mentioned the type in a signature or
# `ritzlib.strview` was imported.  With neither, `v.len` on a local raised a
# Python ValueError ("Cannot determine struct type for value") and
# `StrView { ptr: p, len: n }` was "Unknown struct: StrView".  ritz1 compiled
# both.  This file must stay import-free (and must not name StrView in any
# fn signature) or it stops testing the bug.  The import case, where
# ritzlib.strview's own `struct StrView` must be the only one, is in
# ritz0/test_strview_builtin_no_import.py.
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted.

[[test]]
fn test_local_strview_fields() -> i32
    let v: StrView = "abc"
    let n: i64 = v.len
    assert n == 3
    assert *v.ptr == 97
    0

[[test]]
fn test_strview_struct_literal() -> i32
    let w: StrView = StrView { ptr: c"wxyz" + 1, len: 2 }
    assert w.len == 2
    assert *w.ptr == 120
    assert *(w.ptr + 1) == 121
    0
