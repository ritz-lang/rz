# Regression: a reference param reads through the `@b` it is given. It used to
# auto-borrow a bare value, which AGAST #2337 refuses.

struct Box
    n: i32

fn read_n(b: @Box) -> i32
    b.n

[[test]]
fn test_fn_ptr_param_autoborrow() -> i32
    let b = Box { n: 9 }
    if read_n(@b) == 9
        0
    else
        1
