# AGAST #1922: ritz1 monomorphises a generic fn at every primitive.
#
# monomorph's parse_type_from_suffix matched only "$u8", "$i8", "$i32",
# "$i64" and "$u64"; any other primitive suffix fell through to TYPE_STRUCT,
# so `tp_ident<bool>` substituted T as a struct named "bool" and the clone
# was called with an i64 where it declared an i1 (clang rejects the IR).  It
# now maps every primitive via primitive_type_from_name.  The mangling half
# of the fix is test_diff_tagged_prim_args.
#
# Oracle: ritz0 runs every case to the same result.

fn tp_ident<T>(x: T) -> T
    return x

fn ident_main() -> i32
    let a: u32 = tp_ident<u32>(4000000000)
    if a as i64 != 4000000000
        return 1
    let b: u16 = tp_ident<u16>(65000)
    if b as i64 != 65000
        return 2
    let c: i16 = tp_ident<i16>(-300)
    if c as i64 != -300
        return 3
    let d: bool = tp_ident<bool>(true)
    if not d
        return 4
    let e: f64 = tp_ident<f64>(2.5)
    if e != 2.5
        return 5
    return 42

[[test]]
fn test_generic_ident_prims() -> i32
    assert ident_main() == 42
    0
