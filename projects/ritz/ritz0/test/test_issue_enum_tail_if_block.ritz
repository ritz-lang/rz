# Regression (AGAST #4841): a block-form `if` / `else` that is a fn's tail
# value, with qualified unit-variant arms of a payload-less enum.  ritz1
# typed its phi i64 over `%Kind` arms (`phi i64 [ %.7, ... ]`): invalid IR.

enum Kind
    A
    B

fn pick(c: bool) -> Kind
    if c
        Kind.A
    else
        Kind.B

[[test]]
fn test_enum_tail_if_block_false() -> i32
    match pick(false)
        Kind.A => return 1
        Kind.B => return 0

[[test]]
fn test_enum_tail_if_block_true() -> i32
    match pick(true)
        Kind.A => return 0
        Kind.B => return 1
