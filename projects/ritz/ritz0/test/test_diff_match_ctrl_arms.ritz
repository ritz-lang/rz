# AGAST #1654 (also #1689): control-flow and assignment `match` arms.
#
# ritz1 could not parse `return X`, `break` or `continue` as an arm body
# ("cannot parse item starting at 'fn ...'"): the grammar's match_arm took
# only an expression, a block or an assignment.  Assignment arms (#1617) are
# covered here as a regression guard.  Kept apart from
# test_diff_match_void_arms.ritz so a parse failure here cannot hide the
# void-arm cases (the matrix compiles a file as a unit).
#
# Oracle: ritz0 runs every case to the same result.

import ritzlib.option
import ritzlib.result

fn mk_some(x: i32) -> Option<i32>
    return Some(x)

fn mk_none() -> Option<i32>
    return None

fn mk_ok(x: i64) -> Result<i64, i32>
    return Ok(x)

fn mk_err(e: i32) -> Result<i64, i32>
    return Err(e)

# ---------------------------------------------------------------------------
# Control-flow arms

# `break` arm: sum Some(i) for i < 5, stop on None.
fn upto5(i: i32) -> Option<i32>
    if i < 5
        return Some(i)
    None

fn break_arm_main() -> i32
    var total: i32 = 0
    var i: i32 = 0
    while 1
        match upto5(i)
            Some(e) => total = total + e
            None => break
        i = i + 1
    # 0+1+2+3+4 = 10
    total + 32

# `continue` arm: skip odd i, add the even ones (0+2+4+6+8 = 20).
fn even_only(i: i32) -> Option<i32>
    if i % 2 == 0
        return Some(i)
    None

fn continue_arm_main() -> i32
    var total: i32 = 0
    var i: i32 = 0
    while i < 10
        i = i + 1
        match even_only(i - 1)
            Some(e) => total = total + e
            None => continue
    total + 22

# `return X` in some arms, non-tail position.
fn ret_some(o: Option<i32>) -> i32
    match o
        Some(e) => return e + 1
        None => pass
    return 100

# `return X` in every arm, tail position.
fn ret_all(r: Result<i64, i32>) -> i64
    match r
        Ok(v) => return v + 1
        Err(e) => return 0 - e as i64

# `return` with an assignment in another arm.
fn ret_mixed(o: Option<i32>) -> i32
    var k: i32 = 39
    match o
        Some(e) => return e
        None => k = k + 3
    return k

fn return_arm_main() -> i32
    if ret_some(mk_some(4)) != 5
        return 1
    if ret_some(mk_none()) != 100
        return 2
    if ret_all(mk_ok(9)) != 10
        return 3
    if ret_all(mk_err(7)) != -7
        return 4
    if ret_mixed(mk_some(8)) != 8
        return 5
    if ret_mixed(mk_none()) != 42
        return 6
    42

# Assignment arms (`Some(e) => r = f(e)`), #1617 regression guard.
fn dbl(x: i32) -> i32
    x * 2

fn assign_arm_main() -> i32
    var r: i32 = 0
    match mk_some(21)
        Some(e) => r = dbl(e)
        None => r = 1
    var s: i32 = 5
    match mk_none()
        Some(e) => s = e
        None => s = s + 1
    if s != 6
        return 1
    r

[[test]]
fn test_match_break_arm() -> i32
    assert break_arm_main() == 42
    0

[[test]]
fn test_match_continue_arm() -> i32
    assert continue_arm_main() == 42
    0

[[test]]
fn test_match_return_arms() -> i32
    assert return_arm_main() == 42
    0

[[test]]
fn test_match_assign_arms() -> i32
    assert assign_arm_main() == 42
    0
