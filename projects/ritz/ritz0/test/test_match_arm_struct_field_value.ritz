# A match arm yielding a struct-typed field of its payload (`Some(p) =>
# p.name`, a StrView) gives the match that struct's type (AGAST #4926).
#
# ritz1 typed the merge phi from the arms, but read no field types, so with
# the other arm leaving (`None => return ..`) the phi was i64 over the arm's
# %StrView and clang rejected the module.  ritz1's emitter_call_lower
# place_field_def had this shape.

import ritzlib.option

struct Named
    name: StrView
    k: i32

struct Pair
    inner: Named
    tag: i32

fn find(n: i32) -> Option<Named>
    if n > 0
        return Some(Named { name: "abc", k: n })
    None

fn find_pair(n: i32) -> Option<Pair>
    if n > 0
        return Some(Pair { inner: Named { name: "xy", k: n }, tag: 7 })
    None

# The field is the let's value; the other arm returns.
fn name_len(n: i32) -> i64
    let nm: StrView = match find(n)
        Some(p) => p.name
        None => return -1
    nm.len

# A user-struct field the same way.
fn inner_k(n: i32) -> i32
    let inner: Named = match find_pair(n)
        Some(p) => p.inner
        None => return -1
    inner.k

[[test]]
fn test_a_strview_field_arm_types_the_match() -> i32
    assert name_len(1) == 3
    assert name_len(0) == -1
    0

[[test]]
fn test_a_struct_field_arm_types_the_match() -> i32
    assert inner_k(5) == 5
    assert inner_k(0) == -1
    0
