# AGAST #1983: ritzlib.memory's large (mmap) path.
#
# malloc(size > 2048) maps (size + 16) rounded up to whole pages and stores
# 0 - mmap_size in the 16-byte header before the returned pointer. realloc
# only hands back the same pointer when old and new sizes fall in the same
# small bin; growing a large block always moves it.
#
# The matrix runs every [[test]] here under ritz0, ritz1 and
# ritz1_selfhosted.

import ritzlib.sys
import ritzlib.memory

[[test]]
fn test_large_header_is_neg_mmap_size() -> i32
    # 8192 + 16 = 8208 bytes -> 3 pages
    let p: *u8 = malloc(8192)
    assert p != null
    let h: i64 = *((p as i64 - 16) as *i64)
    assert h == -12288
    free(p)
    0

[[test]]
fn test_large_realloc_grow_moves() -> i32
    let p: *u8 = malloc(8192)
    assert p != null
    *p = 11
    *(p + 8191) = 22
    let q: *u8 = realloc(p, 16384)
    assert q != null
    assert (p as i64) != (q as i64)
    # 16384 + 16 -> 5 pages
    let h: i64 = *((q as i64 - 16) as *i64)
    assert h == -20480
    assert *q == 11
    assert *(q + 8191) == 22
    *(q + 16383) = 33
    assert *(q + 16383) == 33
    free(q)
    0
