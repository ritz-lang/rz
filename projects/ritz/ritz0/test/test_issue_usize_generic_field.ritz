# AGAST #2198: a generic struct's `v: T` at T = usize.  The monomorph
# substitutes T by name ("usize", from the `Box$usize` suffix), so it needs
# the same name-to-type mapping type_named applies to a written `usize`
# (primitive_type_from_name); without it the field was a TYPE_STRUCT named
# "usize" and ritz1 wrote `store %usize`.  Its own file: the matrix fails a
# whole module on one bad line, and test_issue_usize_struct_field.ritz covers
# the written-type paths.

struct Box<T>
    v: T

# A generic struct's `v: T` at T = usize: the monomorph's field.
[[test]]
fn test_usize_generic_field() -> i32
    var b: Box<usize> = Box<usize> { v: 0 as usize }
    b.v = 5000000000 as usize
    assert b.v as i64 == 5000000000
    # Parses since AGAST #3268: Box<usize> is one 8-byte field.
    assert sizeof(Box<usize>) == 8
    0
