# Regression (AGAST #1937): ritz0's monomorph returned any expression /
# statement kind without its own case unchanged, so sizeof(T) nested inside a
# parenthesised expression, a match arm, a slice bound, an unsafe block, ...
# kept the template's T and read 8.  Each test instantiates at i32 (size 4)
# so the stale 8 shows up.  ritz0/test_monomorph_expr_kinds.py pins every
# AST kind, including those with no surface syntax reachable here.

fn grouped<T>(x: T) -> i64
    let a = (sizeof(T))
    return a * ((sizeof(T)) + 1)

[[test]]
fn test_generic_grouped_sizeof() -> i32
    assert grouped<i32>(0) == 20
    0

fn match_arm<T>(x: T, k: i64) -> i64
    let b = match k
        0 => sizeof(T)
        _ => 0
    return b

[[test]]
fn test_generic_match_arm_sizeof() -> i32
    assert match_arm<i32>(0, 0) == 4
    assert match_arm<i32>(0, 1) == 0
    0

# (No match-guard case: ritz0's emitter ignores guards and ritz1 cannot
# parse them; see the AGAST ticket filed from #1937.  The unit test covers
# the guard at the AST level.)

fn match_scrutinee<T>(x: T) -> i64
    match sizeof(T)
        4 => 1
        _ => 0

[[test]]
fn test_generic_match_scrutinee_sizeof() -> i32
    assert match_scrutinee<i32>(0) == 1
    0

# The ticket's own repro.
fn ticket<T>(x: T, k: i64) -> i64
    let a = (sizeof(T))
    let b = match k
        0 => sizeof(T)
        _ => 0
    return a * 10 + b

[[test]]
fn test_generic_ticket_repro() -> i32
    assert ticket<i32>(0, 0) == 44
    0

fn generic_id<T>(x: T) -> T
    x

# The non-generic side: a generic call inside parentheses must still be
# rewritten to its instantiation (the template itself is removed).
[[test]]
fn test_grouped_generic_call() -> i32
    assert (generic_id<i64>(7)) + 1 == 8
    0
