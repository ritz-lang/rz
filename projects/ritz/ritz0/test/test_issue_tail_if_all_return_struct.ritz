# Regression (AGAST #4871): a struct-returning fn whose tail `if` / `else if`
# / `else` has every arm `return`, with a `match` under the `else`.  ritz1
# gave the all-`return` match a `phi i64 [ 0, .. ]` value, the enclosing ifs
# carried it up, and the implicit tail was `ret %StrView` of that i64:
# invalid IR.  An arm that diverges has no value; when every arm does, the
# fn's last block is `unreachable`.

import ritzlib.strview

struct Wide
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64

fn pick(k: i32) -> StrView
    if k == 1
        return "one"
    else if k == 2
        return "two"
    else
        match k
            3 =>
                return "three"
            _ =>
                return strview_empty()

# The same under an `else` with no `else if`, of a five-field struct.
fn wide(k: i32) -> Wide
    if k == 0
        return Wide { a: 0, b: 0, c: 0, d: 0, e: 0 }
    else
        match k
            1 =>
                return Wide { a: 1, b: 2, c: 3, d: 4, e: 5 }
            _ =>
                return Wide { a: 9, b: 9, c: 9, d: 9, e: k as i64 }

[[test]]
fn test_tail_if_all_return_strview() -> i32
    if pick(1).len != 3
        return 1
    if pick(2).len != 3
        return 2
    if pick(3).len != 5
        return 3
    if pick(7).len != 0
        return 4
    0

[[test]]
fn test_tail_if_all_return_sret() -> i32
    if wide(0).e != 0
        return 1
    if wide(1).e != 5
        return 2
    if wide(6).e != 6
        return 3
    0
