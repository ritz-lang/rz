# Regression: AGAST #1332 — subscript STORES through typed pointers.
# STMT_INDEX_ASSIGN's pointer arm hardcoded `getelementptr i64` +
# `store i64` for every non-** pointer, so `p[i] = v` on a *i32/*u8 wrote
# with an 8-byte stride AND an 8-byte width (7/8–8/8 corruption).  Worse,
# the whole arm was guarded by `find_local() >= 0` with no else, so the
# same store through a GLOBAL pointer emitted no IR at all — silently
# dropped, reading back as malloc garbage.  Store-side companion of
# #1325/#1328 (which fixed only the loads); corpus twin is
# examples/tier1_basics/92_subscript_store.
#
# Reads use the deref form `*(b + i)` (fixed by #1325/#1328) so a failure
# here indicts the store side specifically.

import ritzlib.memory

var g_i32: *i32 = null
var g_ptrs: **u8 = null

[[test]]
fn test_global_i32_subscript_store() -> i32
    g_i32 = malloc(32) as *i32
    for i in 0..8
        g_i32[i] = i * 10
    for i in 0..8
        assert *(g_i32 + i) == i * 10
    0

[[test]]
fn test_global_ptr_subscript_store() -> i32
    g_ptrs = malloc(64) as **u8
    let base: *u8 = malloc(8) as *u8
    for i in 0..8
        g_ptrs[i] = base + i
    for i in 0..8
        assert *(g_ptrs + i) == base + i
    0

[[test]]
fn test_local_i32_subscript_store() -> i32
    let p: *i32 = malloc(32) as *i32
    for i in 0..8
        p[i] = i * 10
    for i in 0..8
        assert *(p + i) == i * 10
    0

[[test]]
fn test_local_u8_subscript_store() -> i32
    # Stores run in DESCENDING index order: an over-WIDE store (i64 through
    # a *u8 at the right 1-byte stride) clobbers later elements, and an
    # ascending loop would repair each clobber before reading it back.
    # Descending order proves the store WIDTH, not just the stride.
    let p: *u8 = malloc(8) as *u8
    for i in 0..8
        let j: i32 = 7 - i
        p[j] = 65 + j
    for i in 0..8
        assert *(p + i) == 65 + i
    0

[[test]]
fn test_local_i64_subscript_store() -> i32
    let p: *i64 = malloc(64) as *i64
    for i in 0..8
        p[i] = (i * 100) as i64
    for i in 0..8
        assert *(p + i) == (i * 100) as i64
    0
