# Test level 22: Dynamic arrays (Vec<T>)
#
# Tests ritzlib/gvec.ritz functionality - the generic Vec type.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec

# ============================================================================
# Test: Vec<u8> basic operations (replaces ByteVec)
# ============================================================================

[[test]]
fn test_vec_u8_new() -> i32
    var v: Vec<u8> = vec_new<u8>()
    assert v.data == null, "new vec should have null data"
    assert v.len == 0, "new vec should have len 0"
    assert v.cap == 0, "new vec should have cap 0"
    return 0

[[test]]
fn test_vec_u8_push() -> i32
    var v: Vec<u8> = vec_new<u8>()

    v.push(65)  # 'A'
    v.push(66)  # 'B'
    v.push(67)  # 'C'

    assert v.len == 3, "len should be 3"
    assert v.get(0) == 65, "first element should be 'A'"
    assert v.get(1) == 66, "second element should be 'B'"
    assert v.get(2) == 67, "third element should be 'C'"

    # Auto-drop via Drop trait
    return 0

[[test]]
fn test_vec_u8_push_str() -> i32
    var v: Vec<u8> = vec_new<u8>()

    v.push_str(c"hello")
    assert v.len == 5, "len should be 5"

    let s: *u8 = match v.as_str()
        Some(p) => p
        None => c""
    assert streq(s, c"hello"), "should equal 'hello'"

    return 0

[[test]]
fn test_vec_u8_pop() -> i32
    var v: Vec<u8> = vec_new<u8>()

    v.push(1)
    v.push(2)
    v.push(3)

    assert v.pop() == 3, "pop should return 3"
    assert v.pop() == 2, "pop should return 2"
    assert v.len == 1, "len should be 1"

    return 0

[[test]]
fn test_vec_u8_clear() -> i32
    var v: Vec<u8> = vec_new<u8>()

    v.push_str(c"test")
    assert v.len == 4, "len should be 4"

    v.clear()
    assert v.len == 0, "len should be 0 after clear"
    assert v.cap > 0, "cap should still be > 0"

    return 0

[[test]]
fn test_vec_u8_growth() -> i32
    var v: Vec<u8> = vec_new<u8>()

    # Push many elements to trigger growth
    var i: i32 = 0
    while i < 100
        v.push((i % 256) as u8)
        i = i + 1

    assert v.len == 100, "len should be 100"
    assert v.cap >= 100, "cap should be >= 100"
    assert v.get(50) == 50, "element 50 should be 50"

    return 0

# ============================================================================
# Test: Vec<*u8> operations (replaces PtrVec)
# ============================================================================

[[test]]
fn test_vec_ptr_basic() -> i32
    var v: Vec<*u8> = vec_new<*u8>()

    let s1: *u8 = c"first"
    v.push(s1)

    if v.len != 1
        return 1

    let p1: *u8 = v.get(0)
    if p1 != s1
        return 2

    return 0

[[test]]
fn test_vec_ptr_pop() -> i32
    var v: Vec<*u8> = vec_new<*u8>()

    v.push(c"a")
    v.push(c"b")
    v.push(c"c")

    let popped: *u8 = v.pop()
    assert streq(popped, c"c"), "popped should be 'c'"
    assert v.len == 2, "len should be 2"

    return 0

# ============================================================================
# Test: Vec<i64> operations (replaces I64Vec)
# ============================================================================

[[test]]
fn test_vec_i64_basic() -> i32
    var v: Vec<i64> = vec_new<i64>()

    v.push(100)
    v.push(200)
    v.push(300)

    assert v.len == 3, "len should be 3"
    assert v.get(0) == 100, "first should be 100"
    assert v.get(1) == 200, "second should be 200"
    assert v.get(2) == 300, "third should be 300"

    return 0

[[test]]
fn test_vec_i64_set() -> i32
    var v: Vec<i64> = vec_new<i64>()

    v.push(1)
    v.push(2)
    v.push(3)

    v.set(1, 42)
    assert v.get(1) == 42, "after set, should be 42"

    return 0

[[test]]
fn test_vec_i64_sum() -> i32
    var v: Vec<i64> = vec_new<i64>()

    # Push 1..10
    var i: i64 = 1
    while i <= 10
        v.push(i)
        i = i + 1

    # Sum them
    var sum: i64 = 0
    i = 0
    while i < v.len
        sum = sum + v.get(i)
        i = i + 1

    assert sum == 55, "sum of 1..10 should be 55"

    return 0

# ============================================================================
# Test: Pre-allocated capacity
# ============================================================================

[[test]]
fn test_vec_u8_with_cap() -> i32
    var v: Vec<u8> = vec_with_cap<u8>(100)

    assert v.cap >= 100, "cap should be >= 100"
    assert v.len == 0, "len should be 0"

    # Push without triggering reallocation
    var i: i32 = 0
    while i < 50
        v.push((i % 256) as u8)
        i = i + 1

    assert v.len == 50, "len should be 50"

    return 0

# ============================================================================
# Test: Vec<u8> push_bytes
# ============================================================================

[[test]]
fn test_vec_u8_push_bytes() -> i32
    var v: Vec<u8> = vec_new<u8>()

    let data: *u8 = c"hello" as *u8
    v.push_span(Span<u8> { ptr: (data), len: (5) as i64 })

    assert v.len == 5, "len should be 5"
    assert v.get(0) == 104, "first should be 'h'"
    assert v.get(4) == 111, "last should be 'o'"

    return 0

# ============================================================================
# Test: Method syntax
# ============================================================================

[[test]]
fn test_vec_method_syntax() -> i32
    var v: Vec<i64> = vec_new<i64>()

    v.push(10)
    v.push(20)
    v.push(30)

    assert v.len() == 3, "len should be 3"
    assert v.get(0) == 10, "first should be 10"
    assert v.get(1) == 20, "second should be 20"
    assert v.last() == 30, "last should be 30"

    let popped: i64 = v.pop()
    assert popped == 30, "popped should be 30"
    assert v.len() == 2, "len should be 2"

    return 0
