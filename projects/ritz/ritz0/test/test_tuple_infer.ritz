# AGAST #3005: a tuple expression whose slot names no tuple type gets one
# inferred from its elements, on ritz0, ritz1 and ritz1_selfhosted alike.
# The match-arm form is test_tuple_infer_match (ritz0 can't build it, #3022).

struct Box<T>
    v: T

struct P
    x: i32
    y: i32

fn pair_sum(p: (i32, i32)) -> i32
    let (a, b) = p
    a * 10 + b

fn stmts(c: bool) -> i32
    let (x, y) = if c
        let q = 3
        (q, 1)
    else
        (5, 5)
    x * 10 + y

# The else arm's tuple is (i32, i64) on its own; it takes the then arm's.
fn mixed(c: bool, a: i32) -> i32
    let (x, y) = if c
        (1, 2)
    else
        let k = 4
        (a, k)
    x * 10 + y

[[test]]
fn test_let_untyped_tuple() -> i32
    let a: i32 = 3
    let b: i64 = 40
    let t = (a, b)
    let (x, y) = t
    assert x == 3
    assert y == 40
    assert t.1 == 40
    0

[[test]]
fn test_tuple_call_arg() -> i32
    assert pair_sum((1, 2)) + pair_sum((3, 4)) == 46
    0

[[test]]
fn test_tuple_generic_field() -> i32
    let b = Box<(u32, u32)> { v: (1, 2) }
    let (p, q) = b.v
    assert p * 10 + q == 12
    0

[[test]]
fn test_tuple_if_arm_stmts() -> i32
    assert stmts(true) == 31
    assert stmts(false) == 55
    0

[[test]]
fn test_tuple_arms_of_other_types() -> i32
    assert mixed(true, 9) == 12
    assert mixed(false, 3) == 34
    0

[[test]]
fn test_tuple_struct_and_i64() -> i32
    let n: i64 = 7
    let t = (P { x: 1, y: 2 }, n)
    let (p, m) = t
    assert p.x + p.y == 3
    assert m == 7
    0

[[test]]
fn test_tuple_nested() -> i32
    let a: i32 = 1
    let b: i32 = 2
    let t = ((a, b), 30)
    let (p, c) = t
    let (x, y) = p
    assert x * 100 + y * 10 + c == 150
    0
