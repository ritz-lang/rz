# Regression: CPUID through inline asm (AGAST #185, #3397).
#
# `cpuid_raw` used to be a name both compilers lowered themselves (ritz0 at the
# call site, ritz1 as a weak_odr body), and ritz1 once left it an unresolved
# `@cpuid_raw`, breaking links for cryptosec -> valet.  It is plain `asm` now
# (cryptosec.cpuid has the library copy); this one, written the same way, must
# give a runnable binary on every compiler that executes CPUID and reads back
# a sane vendor leaf.
#
# Leaf 0 is universally safe on every x86_64 CPU — it returns the
# maximum supported leaf (≥ 1 in practice, ≥ 4 on anything modern) in
# EAX and the vendor string in EBX:EDX:ECX.

fn cpuid_raw(leaf: i32, subleaf: i32, out_eax: *i32, out_ebx: *i32, out_ecx: *i32, out_edx: *i32)
    var a: i32 = leaf
    var b: i32 = 0
    var c: i32 = subleaf
    var d: i32 = 0
    asm x86_64 (inout a: rax, out b: rbx, inout c: rcx, out d: rdx):
        cpuid
    *out_eax = a
    *out_ebx = b
    *out_ecx = c
    *out_edx = d

[[test]]
fn test_cpuid_raw_leaf0() -> i32
    var eax: i32 = 0
    var ebx: i32 = 0
    var ecx: i32 = 0
    var edx: i32 = 0

    cpuid_raw(0, 0, @eax, @ebx, @ecx, @edx)

    # EAX must report a max-leaf >= 1 (true on every x86_64 since 1995).
    if eax < 1
        return 1

    # Vendor string occupies EBX:EDX:ECX — at least one register must be
    # nonzero on real silicon.  All-zero would mean cpuid never ran.
    if ebx == 0 and ecx == 0 and edx == 0
        return 2

    0
