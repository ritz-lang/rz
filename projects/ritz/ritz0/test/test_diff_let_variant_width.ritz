# AGAST #1964: `let x: E<T> = Variant(..)` builds the DECLARED specialization.
#
# THE DEFECT (ritz0/emitter_llvmlite.py, LetStmt)
#
# Variant names are global: `Some` maps to whichever Option specialization
# registered last.  `var`, assignment, `return`, call arguments and struct
# fields already built a variant for their target's enum, but `let` did not,
# so in a module that also uses Option<f32>,
#
#     let o: Option<f64> = Some(2.5)
#
# was built as Option$f32 (the payload fptrunc'd to float) and the first
# `match o` died with "cannot store Option$f32 to Option$f64*".  Integer
# widths (Option<i8> / Option<i64>) and Result<f32, i32> / Result<f64, i32>
# failed the same way, as did unit variants (`None`) and variants in the tail
# of an if / match initialiser.
#
# THE FIX
#
# LetStmt resolves its annotation to the enum specialization and emits the
# initialiser through _emit_expr_with_expected_enum, as the other sites do.
#
# Oracle: ritz0 runs every case to the same result.

import ritzlib.option
import ritzlib.result

fn is32(v: f32, want: f32) -> i64
    if v == want
        return 1
    return 0

fn is64(v: f64, want: f64) -> i64
    if v == want
        return 1
    return 0

# The other width appears only as a return type here (#1964 fired on that
# too).
fn mk_opt_f32() -> Option<f32>
    return Some(0.5)

fn opt_float_main() -> i32
    let o: Option<f64> = Some(2.5)
    let a: i64 = match o
        Some(v) => is64(v, 2.5)
        None => 0
    if a != 1
        return 1
    let p: Option<f32> = Some(0.25)
    let b: i64 = match p
        Some(v) => is32(v, 0.25)
        None => 0
    if b != 1
        return 2
    let n: Option<f64> = None
    let c: i64 = match n
        Some(v) => 0
        None => 1
    if c != 1
        return 3
    let d: i64 = match mk_opt_f32()
        Some(v) => is32(v, 0.5)
        None => 0
    if d != 1
        return 4
    return 42

fn res_float_main() -> i32
    let r: Result<f64, i32> = Ok(1234.5)
    let a: i64 = match r
        Ok(v) => is64(v, 1234.5)
        Err(e) => 0
    if a != 1
        return 1
    let s: Result<f32, i32> = Ok(-8.5)
    let b: i64 = match s
        Ok(v) => is32(v, -8.5)
        Err(e) => 0
    if b != 1
        return 2
    let e64: Result<f64, i32> = Err(7)
    let c: i64 = match e64
        Ok(v) => 0
        Err(e) => e as i64
    if c != 7
        return 3
    let e32: Result<f32, i32> = Err(9)
    let d: i64 = match e32
        Ok(v) => 0
        Err(e) => e as i64
    if d != 9
        return 4
    return 42

fn opt_int_main() -> i32
    let w: Option<i64> = Some(5000000000)
    let a: i64 = match w
        Some(v) => v
        None => 0
    if a != 5000000000
        return 1
    let n: Option<i8> = Some(-3)
    let b: i64 = match n
        Some(v) => v as i64
        None => 0
    if b != -3
        return 2
    return 42

fn pick64(flag: bool) -> i64
    let o: Option<f64> = if flag
        Some(6.5)
    else
        None
    match o
        Some(v) => is64(v, 6.5)
        None => 2

fn tail_main() -> i32
    if pick64(true) != 1
        return 1
    if pick64(false) != 2
        return 2
    return 42

[[test]]
fn test_let_option_float_width() -> i32
    assert opt_float_main() == 42
    0

[[test]]
fn test_let_result_float_width() -> i32
    assert res_float_main() == 42
    0

[[test]]
fn test_let_option_int_width() -> i32
    assert opt_int_main() == 42
    0

[[test]]
fn test_let_variant_in_if_tail() -> i32
    assert tail_main() == 42
    0
