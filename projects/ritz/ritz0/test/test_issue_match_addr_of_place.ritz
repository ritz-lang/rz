# AGAST #2140: `match @place` on an enum place (Option<Struct>, a user
# payload enum), as angelo's font.ritz does with `match @self.cmap`.
#
# ritz0: #2124 made `@x` infer as a pointer (sizeof(@x) measures a
# pointer). After that the enum name of a `match @x` scrutinee resolved to
# nothing, and every such match died with
#   "Match on type %"Option$CmapTable"* not yet supported".
# ritz1: `@x` was never unwrapped, so the match ran as a SCALAR match on the
# ADDRESS: `Some(v)` compared the pointer to tag 0 and bound the address.

struct Cmap
    base: u32
    span: u32

fn cmap_lookup(c: *Cmap, cp: u32) -> i32
    if cp < c.base
        return -1
    if cp >= c.base + c.span
        return -1
    return (cp - c.base) as i32

struct Dims
    w: i32
    h: i32

enum Shape
    Circle(i32)
    Rect(Dims)
    Empty

struct Font
    cmap: Option<Cmap>
    shape: Shape

# The angelo shape: a method-style fn matching `@self.field`.
fn font_lookup(self: *Font, cp: u32) -> i32
    match @self.cmap
        Some(cmap) => cmap_lookup(@cmap, cp)
        None => -2

fn font_area(self: *Font) -> i32
    match @self.shape
        Circle(r) => 3 * r * r
        Rect(d) => d.w * d.h
        Empty => 0

fn local_option_some() -> i32
    let held: Option<Cmap> = Some(Cmap { base: 10, span: 5 })
    match @held
        Some(c) => (c.base + c.span) as i32
        None => -1

fn local_option_none() -> i32
    let held: Option<Cmap> = None
    match @held
        Some(c) => c.base as i32
        None => -1

fn local_option_int() -> i32
    let held: Option<i32> = Some(41)
    match @held
        Some(v) => v + 1
        None => -1

fn local_rect() -> i32
    let held: Shape = Rect(Dims { w: 3, h: 4 })
    match @held
        Circle(r) => r
        Rect(d) => d.w * d.h
        Empty => 0

fn local_circle() -> i32
    let held: Shape = Circle(9)
    match @held
        Circle(r) => r
        Rect(d) => d.w * d.h
        Empty => 0

fn local_empty() -> i32
    let held: Shape = Empty
    match @held
        Circle(r) => r
        Rect(d) => d.w * d.h
        Empty => 77

[[test]]
fn test_match_addr_of_local_option() -> i32
    assert local_option_some() == 15
    assert local_option_none() == -1
    assert local_option_int() == 42
    0

[[test]]
fn test_match_addr_of_field_option() -> i32
    var f: Font = Font { cmap: Some(Cmap { base: 65, span: 26 }), shape: Empty }
    assert font_lookup(@f, 66) == 1
    assert font_lookup(@f, 10) == -1
    f.cmap = None
    assert font_lookup(@f, 66) == -2
    let g: Font = Font { cmap: None, shape: Empty }
    assert font_lookup(@g, 66) == -2
    0

[[test]]
fn test_match_addr_of_local_user_enum() -> i32
    assert local_rect() == 12
    assert local_circle() == 9
    assert local_empty() == 77
    0

[[test]]
fn test_match_addr_of_field_user_enum() -> i32
    var c: Font = Font { cmap: None, shape: Circle(2) }
    assert font_area(@c) == 12
    c.shape = Rect(Dims { w: 5, h: 6 })
    assert font_area(@c) == 30
    let e: Font = Font { cmap: None, shape: Empty }
    assert font_area(@e) == 0
    0
