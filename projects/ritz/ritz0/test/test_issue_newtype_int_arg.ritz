# A newtype argument is written as a struct literal: nothing converts to a
# struct (LARB R47, LANGUAGE_SPEC §9.2, #3389), so `tag.eq(TAG_HEAD)` is
# refused (test_int_arg_for_struct_param.py) and this is the migrated form.

struct Tag
    value: u32

impl Tag
    fn eq(self, other: Tag) -> bool
        self.value == other.value

const TAG_HEAD: u32 = 0x68656164

[[test]]
fn test_newtype_int_method_arg() -> i32
    let tag = Tag { value: TAG_HEAD }
    if tag.eq(Tag { value: TAG_HEAD })
        0
    else
        1
