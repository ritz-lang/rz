# Or-patterns in `match` (AGAST #4450, LANGUAGE_SPEC §8.2): an arm's pattern
# may be `P1 | P2 | ...`, and the arm is taken when any alternative matches.
# Alternatives bind nothing: each is a literal, an integer const or a variant
# without a payload list.
#
# ritz0 is the oracle.  Each case returns 42 when correct and a distinct
# small code naming the failed check otherwise; every arm is taken at least
# once, and every alternative of an or-pattern is tried.

enum Kind: i32
    Void = 0
    A = 1
    B = 2
    Big = 1024
    Neg = -1

enum Color
    Red
    Green
    Blue
    Black

enum Shape
    Circle(i64)
    Empty
    Dot

const TEN: i64 = 10

# --- a block arm, and an inline arm, over a C-style enum ---------------------

fn block_arm(k: Kind) -> i32
    match k
        Kind.A | Kind.B =>
            let base: i32 = 10
            base + (k as i32)
        Big => 100
        Void | Neg => 0

fn inline_arm(c: Color) -> i32
    match c
        Red | Blue => 1
        Green => 2
        Black => 3

fn block_inline_main() -> i32
    if block_arm(Kind.A) != 11
        return 1
    if block_arm(Kind.B) != 12
        return 2
    if block_arm(Kind.Big) != 100
        return 3
    if block_arm(Kind.Void) != 0 or block_arm(Kind.Neg) != 0
        return 4
    if inline_arm(Color.Red) != 1 or inline_arm(Color.Blue) != 1
        return 5
    if inline_arm(Color.Green) != 2 or inline_arm(Color.Black) != 3
        return 6
    return 42

[[test]]
fn test_or_pattern_block_and_inline_arms() -> i32
    assert block_inline_main() == 42
    0

# --- three alternatives; an or-pattern beside `_` ----------------------------

fn three(c: Color) -> i32
    match c
        Color.Red | Color.Green | Color.Black => 7
        Blue => 8

fn with_wildcard(k: Kind) -> i32
    match k
        Big | Neg => 5
        _ => 6

fn three_wildcard_main() -> i32
    if three(Color.Red) != 7 or three(Color.Green) != 7 or three(Color.Black) != 7
        return 1
    if three(Color.Blue) != 8
        return 2
    if with_wildcard(Kind.Big) != 5 or with_wildcard(Kind.Neg) != 5
        return 3
    if with_wildcard(Kind.A) != 6 or with_wildcard(Kind.Void) != 6
        return 4
    return 42

[[test]]
fn test_or_pattern_three_alternatives_and_wildcard() -> i32
    assert three_wildcard_main() == 42
    0

# --- a statement match whose arms `return` -----------------------------------

fn returns(k: Kind) -> i32
    var r: i32 = 0
    match k
        Kind.Neg | Kind.Big => return 1
        Kind.A | Kind.B => r = 2
        Void => pass
    r + 3

fn all_return(c: Color) -> i32
    match c
        Red | Green | Blue => return 4
        Black => return 5

fn returns_main() -> i32
    if returns(Kind.Neg) != 1 or returns(Kind.Big) != 1
        return 1
    if returns(Kind.A) != 5 or returns(Kind.B) != 5
        return 2
    if returns(Kind.Void) != 3
        return 3
    if all_return(Color.Blue) != 4 or all_return(Color.Red) != 4 or all_return(Color.Black) != 5
        return 4
    return 42

[[test]]
fn test_or_pattern_statement_arms_return() -> i32
    assert returns_main() == 42
    0

# --- integer literals and an integer const -----------------------------------

fn digits(n: i64) -> i64
    match n
        0 | 1 | 2 => 100
        3 | TEN => 200
        other => other

fn bytes(c: u8) -> i32
    match c
        ' ' | '\t' | '\n' => 1
        '(' | ')' => 2
        _ => 0

fn ints_main() -> i32
    if digits(0) != 100 or digits(1) != 100 or digits(2) != 100
        return 1
    if digits(3) != 200 or digits(10) != 200
        return 2
    if digits(4) != 4
        return 3
    if bytes(' ') != 1 or bytes('\t') != 1 or bytes('\n') != 1
        return 4
    if bytes('(') != 2 or bytes(')') != 2 or bytes('x') != 0
        return 5
    return 42

[[test]]
fn test_or_pattern_integer_literals() -> i32
    assert ints_main() == 42
    0

# --- a value match into a `let`, and payload-less variants of a tagged enum ---

fn shape_code(s: Shape) -> i64
    let v: i64 = match s
        Circle(r) => r
        Empty | Dot => 0 - 1
    v

fn tagged_main() -> i32
    if shape_code(Shape.Circle(9)) != 9
        return 1
    if shape_code(Shape.Empty) != -1 or shape_code(Shape.Dot) != -1
        return 2
    return 42

[[test]]
fn test_or_pattern_value_and_unit_variants() -> i32
    assert tagged_main() == 42
    0
