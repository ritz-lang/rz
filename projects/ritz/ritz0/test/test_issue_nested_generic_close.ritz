# AGAST #1299: nested generic type arguments must close with `>>`
#
# The lexer merges `>>` into a single right-shift token, so `Vec<Vec<i64>>`
# used to fail to parse ("Expected '>' after type arguments") while the
# identical type written `Vec<Vec<i64> >` compiled fine. The parser now splits
# such a token when it appears in a type-argument closing position.
#
# The right-shift operator MUST keep working in expression context -- both
# behaviours are asserted in this one file on purpose, so neither can be
# "fixed" by breaking the other.
#
# Run with: python3 ritz0/ritz0.py --test ritz0/test/test_issue_nested_generic_close.ritz

import ritzlib.sys
import ritzlib.gvec

# Nested generic in a multi-argument type-argument list -- the tempest case
# (`HashMap<String, Vec<Connection>>`).
struct Pair<A, B>
    first: A
    second: B

[[test]]
fn test_nested_generic_type_closes_with_rshift() -> i32
    var outer: Vec<Vec<i64>> = vec_new<Vec<i64>>()
    var inner: Vec<i64> = vec_new<i64>()
    inner.push(7)
    outer.push(inner)
    assert outer.len() == 1
    0

[[test]]
fn test_nested_generic_with_space_matches() -> i32
    # Same type, written with a space; must behave identically.
    var outer: Vec<Vec<i64> > = vec_new<Vec<i64> >()
    assert outer.len() == 0
    0

[[test]]
fn test_nested_generic_in_multi_arg_list() -> i32
    var inner: Vec<i64> = vec_new<i64>()
    inner.push(5)
    let p: Pair<i64, Vec<i64>> = Pair<i64, Vec<i64>> { first: 3, second: inner }
    assert p.first == 3
    assert p.second.len() == 1
    0

[[test]]
fn test_rshift_operator_still_works() -> i32
    # `>>` must still lex and evaluate as a right shift in expression context.
    let x: i64 = 256
    assert x >> 4 == 16
    let y: i64 = 1
    assert y << 3 >> 1 == 4
    0

[[test]]
fn test_rshift_and_nested_generics_together() -> i32
    var outer: Vec<Vec<i64>> = vec_new<Vec<i64>>()
    var inner: Vec<i64> = vec_new<i64>()
    inner.push(64)
    outer.push(inner)
    let v: i64 = 64
    assert v >> 2 == 16
    assert outer.len() >> 0 == 1
    0

fn main() -> i32
    0
