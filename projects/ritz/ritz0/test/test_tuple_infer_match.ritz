# AGAST #3005: `let (x, y) = match ..` whose arms bind names their tuples
# read.  ritz1 names each arm's tuple as it emits the arm, with the arm's
# binding in scope; a later arm takes the type the first one fixed.  ritz0
# retypes a later tuple arm to the first arm's tuple type (AGAST #3022:
# `(v, 1)` is `{i32, i64}`, `(5, 6)` `{i64, i64}`, and the match had no
# value).
import ritzlib.option

enum E
    A(i32)
    B

fn binds(o: Option<i32>) -> i32
    let (x, y) = match o
        Some(v) => (v, 1)
        None => (5, 6)
    (x * 10 + y) as i32

fn user(e: E) -> i32
    let (x, y) = match e
        B => (7, 8)
        A(v) => (v, v + 1)
    (x * 10 + y) as i32

# The match bound first, destructured after; a wildcard arm (#3022).
fn later(o: Option<i32>) -> i32
    let t = match o
        Some(v) => (v, 1)
        _ => (5, 6)
    let (x, y) = t
    (x * 10 + y) as i32

# A match over an int whose arms' tuples differ the same way (#3022).
fn by_int(n: i32, v: i32) -> i32
    let (x, y) = match n
        0 => (v, 1)
        _ => (5, 6)
    (x * 10 + y) as i32

[[test]]
fn test_tuple_match_arm_binds() -> i32
    assert binds(Some(2)) == 21
    assert binds(None) == 56
    0

[[test]]
fn test_tuple_match_later_arm_binds() -> i32
    assert user(A(3)) == 34
    assert user(B) == 78
    0

[[test]]
fn test_tuple_match_bound_then_destructured() -> i32
    assert later(Some(4)) == 41
    assert later(None) == 56
    0

[[test]]
fn test_tuple_int_match_arm_types_differ() -> i32
    assert by_int(0, 9) == 91
    assert by_int(3, 9) == 56
    0
