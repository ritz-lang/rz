# AGAST #3005: `let (x, y) = match ..` whose arms bind names their tuples
# read.  ritz1 names each arm's tuple as it emits the arm, with the arm's
# binding in scope; a later arm takes the type the first one fixed.  ritz0
# can't build it (AGAST #3022, listed in run_regression_matrix.py).
import ritzlib.option

enum E
    A(i32)
    B

fn binds(o: Option<i32>) -> i32
    let (x, y) = match o
        Some(v) => (v, 1)
        None => (5, 6)
    x * 10 + y

fn user(e: E) -> i32
    let (x, y) = match e
        B => (7, 8)
        A(v) => (v, v + 1)
    x * 10 + y

[[test]]
fn test_tuple_match_arm_binds() -> i32
    assert binds(Some(2)) == 21
    assert binds(None) == 56
    0

[[test]]
fn test_tuple_match_later_arm_binds() -> i32
    assert user(A(3)) == 34
    assert user(B) == 78
    0
