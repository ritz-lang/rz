# AGAST #3618: `Color.red()` names the type `Color` even when another enum
# has a variant `Color` (prism's `BlendMode.Color`). A variant is reached
# qualified as a receiver (`Mode.Color`), so a bare receiver is the type.
# ritz0 resolved it against `Mode`: "no method `red` on `Mode`".

pub struct Color
    r: u8

impl Color
    pub fn red() -> Color
        Color { r: 255 }

    pub fn grey(v: u8) -> Color
        Color { r: v }

pub enum Mode
    Normal
    Color
    Shade

# An enum named like another enum's variant (`Mode.Shade`).
pub enum Shade
    Dark
    Light

impl Shade
    pub fn dark() -> Shade
        Shade.Dark

fn is_color(m: Mode) -> i32
    match m
        Mode.Color => 1
        _ => 0

[[test]]
fn test_type_beats_other_enums_variant() -> i32
    let c = Color.red()
    assert c.r == 255
    0

[[test]]
fn test_type_beats_variant_with_args_and_chain() -> i32
    assert Color.grey(7).r == 7
    assert Color.red().r == 255
    0

[[test]]
fn test_enum_type_beats_other_enums_variant() -> i32
    let s = Shade.dark()
    match s
        Shade.Dark => 0
        Shade.Light => 1

[[test]]
fn test_qualified_variant_still_resolves() -> i32
    assert is_color(Mode.Color) == 1
    assert is_color(Mode.Normal) == 0
    0
