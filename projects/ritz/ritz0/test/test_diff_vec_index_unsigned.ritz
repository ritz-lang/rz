# AGAST #1979: `v[i]` on a local Vec<u8>/Vec<u16> must stay unsigned.
#
# THE DEFECT (ritz0)
#
# `v[i]` lowers to vec_get$T, which returns an LLVM i8/i16 (no signedness).
# _infer_ritz_type(Index) returned None for a Vec base, so `v[i] as i64`
# could not see the element was unsigned and used sext: 200 -> -56. The
# same gap broke unsigned comparisons and widening arithmetic on `v[i]`.
# Binding first (`let b: u8 = v[i]`) worked. The `@Vec<T>` param case is
# test_diff_ref_vec_index_unsigned.ritz.
#
# Every value is above the element type's signed max, so a sign-extension
# changes the answer.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.gvec
import ritzlib.sys

[[test]]
fn test_vec_u8_index_cast_i64() -> i32
    var v = vec_new<u8>()
    v.push(200 as u8)
    let x = v[0] as i64
    assert x == 200
    0

[[test]]
fn test_vec_u16_index_cast_i64() -> i32
    var v = vec_new<u16>()
    v.push(1 as u16)
    v.push(60000 as u16)
    let x = v[1] as i64
    assert x == 60000
    0

[[test]]
fn test_vec_u8_index_cast_sum() -> i32
    var v = vec_new<u8>()
    v.push(65 as u8)
    v.push(200 as u8)
    v.push(255 as u8)
    var sum: i64 = 0
    for i in 0..v.len()
        sum = sum + v[i] as i64
    assert sum == 520
    0

[[test]]
fn test_vec_u8_index_compare() -> i32
    var v = vec_new<u8>()
    v.push(200 as u8)
    v.push(100 as u8)
    # Unsigned compare: 200 > 100. A signed compare sees -56 > 100 (false).
    assert v[0] > v[1]
    assert v[0] >= 128 as u8
    0

[[test]]
fn test_vec_u16_index_compare() -> i32
    var v = vec_new<u16>()
    v.push(40000 as u16)
    v.push(30000 as u16)
    assert v[0] > v[1]
    0

[[test]]
fn test_vec_u8_index_div() -> i32
    var v = vec_new<u8>()
    v.push(200 as u8)
    v.push(2 as u8)
    # udiv: 200 / 2 = 100. sdiv: -56 / 2 = -28 = 228. Both operands are
    # `v[i]`, so neither side can supply the signedness.
    let h: u8 = v[0] / v[1]
    assert h as i64 == 100
    0

[[test]]
fn test_vec_u8_index_shr() -> i32
    var v = vec_new<u8>()
    v.push(0x80 as u8)
    # lshr: 0x80 >> 7 = 1. ashr gives 0xFF.
    let s: u8 = v[0] >> 7 as u8
    assert s as i64 == 1
    0
