# Regression (AGAST #1933): `(**pp).f` where pp is a LOCAL `**S`
# (`let pp: **Cell = @pc`) failed in ritz1 with "unhandled EXPR_MEMBER",
# read or write, while the same expression on a `**Cell` param compiled.
# The parser dropped the struct name of a `**S` let (stmt_var_decl only kept
# it for `*S` / `S` / `@S`), and emit_var_decl registered the local through
# add_local_ptr, which has no name slot, so emit_deref_operand_ptr could not
# find the pointee struct.  ritz0 is the oracle.

struct Cell
    v: i64
    arr: [2]i64

[[test]]
fn test_local_pp_let_read() -> i32
    var c: Cell = Cell { v: 41, arr: [0, 0] }
    let pc: *Cell = @c
    let pp: **Cell = @pc
    assert (**pp).v == 41
    0

[[test]]
fn test_local_pp_var_read() -> i32
    var c: Cell = Cell { v: 42, arr: [0, 0] }
    var pc: *Cell = @c
    var pp: **Cell = @pc
    assert (**pp).v == 42
    0

fn read_via_local_pp(c: *Cell) -> i64
    let pc: *Cell = c
    let pp: **Cell = @pc
    return (**pp).v

[[test]]
fn test_local_pp_return_read() -> i32
    var c: Cell = Cell { v: 43, arr: [0, 0] }
    assert read_via_local_pp(@c) == 43
    0

# The local is copied from a `**Cell` param rather than built with `@`.
fn read_via_copied_pp(q: **Cell) -> i64
    let pp: **Cell = q
    return (**pp).arr[1]

[[test]]
fn test_local_pp_from_param() -> i32
    var c: Cell = Cell { v: 0, arr: [5, 44] }
    var pc: *Cell = @c
    assert read_via_copied_pp(@pc) == 44
    0

[[test]]
fn test_local_pp_field_write() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    let pp: **Cell = @pc
    (**pp).v = 45
    assert c.v == 45
    assert (**pp).v == 45
    0

[[test]]
fn test_local_pp_index_write() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    let pp: **Cell = @pc
    (**pp).arr[1] = 46
    (**pp).arr[0] = 7
    assert c.arr[1] == 46
    assert c.arr[0] == 7
    assert (**pp).arr[1] == 46
    assert c.v == 0
    0

# Retargeting the middle pointer through pp: the next `(**pp)` must reload.
[[test]]
fn test_local_pp_retarget() -> i32
    var a: Cell = Cell { v: 1, arr: [0, 0] }
    var b: Cell = Cell { v: 2, arr: [0, 0] }
    var pc: *Cell = @a
    let pp: **Cell = @pc
    assert (**pp).v == 1
    *pp = @b
    assert (**pp).v == 2
    (**pp).v = 47
    assert b.v == 47
    assert a.v == 1
    0

# Keeping the struct name on the local must not change its pointer stride:
# `pp + 1` steps one `*Cell` (8 bytes), not one Cell.
[[test]]
fn test_local_pp_stride() -> i32
    var a: Cell = Cell { v: 10, arr: [0, 0] }
    var b: Cell = Cell { v: 48, arr: [0, 0] }
    var ptrs: [2]*Cell = [@a, @b]
    let pp: **Cell = @ptrs[0]
    let second: *Cell = *(pp + 1)
    assert second.v == 48
    assert (**pp).v == 10
    0

# The `**Cell` param form, which already worked: kept as the control.
fn set_through_param_pp(pp: **Cell, v: i64)
    (**pp).arr[1] = v

[[test]]
fn test_param_pp_index_write() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    set_through_param_pp(@pc, 49)
    assert c.arr[1] == 49
    0

# AGAST #1938: the UNTYPED `let pp = q` (q: `**Cell` param) must inherit q's
# struct name too.  The untyped-let inference in ritz1's emit_var_decl left pp
# at i64 with no name: read and write failed "unhandled EXPR_MEMBER".
fn rw_via_untyped_pp(q: **Cell) -> i64
    let pp = q
    (**pp).arr[0] = 50
    return (**pp).v + (**pp).arr[0]

[[test]]
fn test_local_pp_untyped_from_param() -> i32
    var c: Cell = Cell { v: 1, arr: [0, 0] }
    var pc: *Cell = @c
    assert rw_via_untyped_pp(@pc) == 51
    assert c.arr[0] == 50
    0

# The untyped pp keeps q's stride too: `pp + 1` steps one `*Cell` (8 bytes).
fn second_via_untyped_pp(q: **Cell) -> i64
    let pp = q
    let second: *Cell = *(pp + 1)
    return second.v

[[test]]
fn test_local_pp_untyped_stride() -> i32
    var a: Cell = Cell { v: 10, arr: [0, 0] }
    var b: Cell = Cell { v: 52, arr: [0, 0] }
    var ptrs: [2]*Cell = [@a, @b]
    assert second_via_untyped_pp(@ptrs[0]) == 52
    0

# AGAST #1941: `*pp + 1` with `pp: **Cell` must step sizeof(Cell) (24 bytes),
# not one byte.  deref_ptr_ptr_elem_type answers TYPE_VOID for a struct inner
# pointee, so ptr_arith_elem_size classified `*pp` as "not a pointer" and
# emitted a raw byte add: `next.v` read across the Cell boundary.
fn next_via_param_pp(pp: **Cell) -> i64
    let next: *Cell = *pp + 1
    return next.v

fn next_via_local_pp(pc: *Cell) -> i64
    var q: *Cell = pc
    let pp: **Cell = @q
    let next: *Cell = *pp + 1
    return next.v

fn next_via_untyped_pp(q: **Cell) -> i64
    let pp = q
    let next: *Cell = *pp + 1
    return next.v

# `*(pp + i) + k`: the outer ptr-of-ptr stride and the inner struct stride.
fn elem_via_param_pp(pp: **Cell, i: i64, k: i64) -> i64
    let e: *Cell = *(pp + i) + k
    return e.v

[[test]]
fn test_deref_param_pp_plus_struct_stride() -> i32
    var cells: [2]Cell
    cells[0].v = 60
    cells[1].v = 61
    var pc: *Cell = @cells[0]
    assert next_via_param_pp(@pc) == 61
    0

[[test]]
fn test_deref_local_pp_plus_struct_stride() -> i32
    var cells: [2]Cell
    cells[0].v = 60
    cells[1].v = 61
    assert next_via_local_pp(@cells[0]) == 61
    0

[[test]]
fn test_deref_untyped_pp_plus_struct_stride() -> i32
    var cells: [2]Cell
    cells[0].v = 60
    cells[1].v = 61
    var pc: *Cell = @cells[0]
    assert next_via_untyped_pp(@pc) == 61
    0

[[test]]
fn test_deref_pp_index_plus_struct_stride() -> i32
    var cells: [2]Cell
    cells[0].v = 60
    cells[1].v = 61
    var ptrs: [2]*Cell = [@cells[0], @cells[0]]
    assert elem_via_param_pp(@ptrs[0], 1, 1) == 61
    0

# AGAST #1940: `(*pp).f` -- ONE deref of a `**Cell`, then a member on the
# resulting `*Cell` (auto-deref, as ritz0 does).  ritz1's emit_member_ptr only
# took a `*S` ident under the deref, so a `**S` param or local failed
# "unhandled EXPR_MEMBER", read or write.
fn read_single_deref_param_pp(pp: **Cell) -> i64
    return (*pp).v

fn write_single_deref_param_pp(pp: **Cell, v: i64)
    (*pp).v = v
    (*pp).arr[1] = v + 1

[[test]]
fn test_single_deref_param_pp_read() -> i32
    var c: Cell = Cell { v: 70, arr: [0, 0] }
    var pc: *Cell = @c
    assert read_single_deref_param_pp(@pc) == 70
    0

[[test]]
fn test_single_deref_param_pp_write() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    write_single_deref_param_pp(@pc, 71)
    assert c.v == 71
    assert c.arr[1] == 72
    assert c.arr[0] == 0
    0

[[test]]
fn test_single_deref_local_pp_read() -> i32
    var c: Cell = Cell { v: 73, arr: [0, 74] }
    var pc: *Cell = @c
    let pp: **Cell = @pc
    assert (*pp).v == 73
    assert (*pp).arr[1] == 74
    0

[[test]]
fn test_single_deref_local_pp_write() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    var pp: **Cell = @pc
    (*pp).v = 75
    (*pp).arr[0] = 76
    assert c.v == 75
    assert c.arr[0] == 76
    assert (*pp).v == 75
    0

# Untyped local copied from a `**Cell` param (the #1938 shape).
fn rw_single_deref_untyped_pp(q: **Cell) -> i64
    let pp = q
    (*pp).v = 77
    return (*pp).v

[[test]]
fn test_single_deref_untyped_pp() -> i32
    var c: Cell = Cell { v: 0, arr: [0, 0] }
    var pc: *Cell = @c
    assert rw_single_deref_untyped_pp(@pc) == 77
    assert c.v == 77
    0

# Retarget through `*pp`, then `(*pp).f` must reload the middle pointer.
[[test]]
fn test_single_deref_local_pp_retarget() -> i32
    var a: Cell = Cell { v: 1, arr: [0, 0] }
    var b: Cell = Cell { v: 2, arr: [0, 0] }
    var pc: *Cell = @a
    let pp: **Cell = @pc
    assert (*pp).v == 1
    *pp = @b
    assert (*pp).v == 2
    (*pp).v = 78
    assert b.v == 78
    assert a.v == 1
    0

# The auto-deref is on the resolved operand, so a `**Cell` FIELD works too.
struct PPHolder
    pp: **Cell

[[test]]
fn test_single_deref_field_pp() -> i32
    var c: Cell = Cell { v: 79, arr: [0, 0] }
    var pc: *Cell = @c
    var h: PPHolder = PPHolder { pp: @pc }
    assert (*h.pp).v == 79
    (*h.pp).arr[1] = 80
    assert c.arr[1] == 80
    0
