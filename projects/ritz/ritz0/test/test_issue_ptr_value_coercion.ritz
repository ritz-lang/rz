# A value passes to a by-value parameter as itself; there's no implicit deref
# (§13.2, AGAST #2336). A pointer has to say `*p`.

struct PointI
    x: i32
    y: i32

fn sum_point(p: PointI) -> i32
    p.x + p.y

[[test]]
fn test_ptr_to_value_arg_coercion() -> i32
    let p = PointI { x: 2, y: 3 }
    let s = sum_point(p)
    assert s == 5
    let q: *PointI = @p
    assert sum_point(*q) == 5
    0
