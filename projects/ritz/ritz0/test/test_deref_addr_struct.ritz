# `*@x` of a struct is that struct (AGAST #1746)
#
# ritz1 loaded `*@x` as `i64`: the deref's pointee struct was resolved only
# for pointer-typed locals and fields, never for the address-of `@x`.  Storing
# the result into a struct slot (a copy, or the byval spill of a by-value
# argument to a direct or an indirect call) was then invalid IR.

struct Big
    data: [64]i64
    count: i32

fn big_make(n: i32) -> Big
    var b: Big = Big { data: [0; 64], count: n }
    b.data[63] = (n * 2) as i64
    return b

fn total(p: *Big) -> i64
    return p.count as i64 + p.data[63]

fn take(b: Big) -> i64
    return total(@b)

fn twice(b: Big) -> Big
    var c: Big = b
    c.count = c.count * 2
    return c

[[test]]
fn test_deref_addr_struct_copy() -> i32
    var x: Big = big_make(5)
    var y: Big = *@x
    y.count = 9
    assert x.count == 5
    assert total(@y) == 9 + 10
    0

[[test]]
fn test_deref_addr_byval_direct_call() -> i32
    var x: Big = big_make(5)
    assert take(*@x) == 15
    0

[[test]]
fn test_deref_addr_byval_indirect_call() -> i32
    var x: Big = big_make(5)
    let h: fn(Big) -> Big = twice
    var y: Big = h(*@x)
    assert y.count == 10
    assert x.count == 5
    0
