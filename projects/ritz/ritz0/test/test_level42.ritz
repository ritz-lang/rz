# Test level 42: Conditional compilation with [[target_os = "..."]]
#
# LANGUAGE_SPEC §17.2: an item carrying [[target_os = "<os>"]] is compiled
# only when <os> is the target. The default target is linux, so the harland
# variants below must be filtered out — if one leaked through, the duplicate
# definition (or its different value/shape) fails the build or the asserts.
#
# LARB R77 (AGAST #1626): `[[cfg(...)]]` and `not(...)` (LARB-0013 §3) were
# not adopted; this file used to target them and was rewritten.

import ritzlib.sys

# ============================================================================
# target_os on functions
# ============================================================================

[[target_os = "linux"]]
pub fn get_platform_id() -> i32
    return 1

# Filtered out on linux: same name, different value.
[[target_os = "harland"]]
pub fn get_platform_id() -> i32
    return 2

[[test]]
fn test_target_os_fn() -> i32
    let id: i32 = get_platform_id()
    assert id == 1, "linux variant of get_platform_id should be selected"
    0

# ============================================================================
# target_os on structs
# ============================================================================

[[target_os = "linux"]]
pub struct PlatformInfo
    fd_type: i32
    flags: i32

# Filtered out on linux: same name, different layout (AGAST #4054). Were it
# selected, the linux-layout literal below would not compile.
[[target_os = "harland"]]
pub struct PlatformInfo
    handle: i64

[[test]]
fn test_target_os_struct() -> i32
    var info: PlatformInfo = PlatformInfo { fd_type: 7, flags: 3 }
    assert info.fd_type == 7, "fd_type should be 7"
    assert info.flags == 3, "flags should be 3"
    0
