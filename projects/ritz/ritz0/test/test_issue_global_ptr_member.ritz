# Regression (#1892): member access whose base is a module-level
# pointer-to-struct global.  ritz0 accepted `g_rec.f` (read) and
# `g_rec.f = v` (write); ritz1 failed with "unhandled EXPR_MEMBER" /
# "unhandled EXPR_MEMBER in assignment".  The fix loads the global pointer,
# then GEPs into the pointee.  Shape from ritz1/src/fn_cache.ritz's
# g_dep_record.

struct GRec
    tag: u8
    count: i64
    ptr: *u8
    small: i32

struct GInner
    v: i64
    w: i32

struct GOuter
    pad: u8
    inner: GInner

var g_rec: *GRec
var g_outer: *GOuter

fn grec_fill(r: *GRec)
    r.tag = 7
    r.count = 41
    r.ptr = null
    r.small = -3

[[test]]
fn test_global_ptr_member_read() -> i32
    var r: GRec
    grec_fill(@r)
    g_rec = @r
    assert g_rec.count == 41
    assert g_rec.tag == 7
    assert g_rec.small == -3
    assert g_rec.ptr == null
    let n: i64 = g_rec.count + 1
    assert n == 42
    0

[[test]]
fn test_global_ptr_member_write() -> i32
    var r: GRec
    grec_fill(@r)
    g_rec = @r
    g_rec.count = 100
    g_rec.tag = 200
    g_rec.small = 9
    g_rec.ptr = c"x"
    assert r.count == 100
    assert r.tag == 200
    assert r.small == 9
    assert r.ptr != null
    0

[[test]]
fn test_global_ptr_member_compound() -> i32
    var r: GRec
    grec_fill(@r)
    g_rec = @r
    g_rec.count = g_rec.count + 1
    g_rec.count += 2
    assert r.count == 44
    0

[[test]]
fn test_global_ptr_member_retarget() -> i32
    var a: GRec
    var b: GRec
    grec_fill(@a)
    grec_fill(@b)
    g_rec = @a
    g_rec.count = 1
    g_rec = @b
    g_rec.count = 2
    assert a.count == 1
    assert b.count == 2
    assert g_rec.count == 2
    0

[[test]]
fn test_global_ptr_member_nested() -> i32
    var o: GOuter
    o.pad = 1
    o.inner.v = 5
    o.inner.w = 6
    g_outer = @o
    assert g_outer.inner.v == 5
    g_outer.inner.v = 50
    g_outer.inner.w = 60
    assert o.inner.v == 50
    assert o.inner.w == 60
    0

[[test]]
fn test_global_ptr_member_move_out() -> i32
    # The sig_take_deps shape: copy fields out, then clear them.
    var r: GRec
    grec_fill(@r)
    g_rec = @r
    var dst: GRec
    dst.count = g_rec.count
    dst.small = g_rec.small
    g_rec.count = 0
    g_rec.small = 0
    assert dst.count == 41
    assert dst.small == -3
    assert r.count == 0
    assert r.small == 0
    0
