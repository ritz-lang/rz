# Regressions (AGAST #1285) for the gaps found alongside "slice types are
# unusable as generic type arguments". Each of these was reachable from
# ordinary code and silently miscompiled or hard-failed before the fix.

import ritzlib.result
import ritzlib.span
import ritzlib.gvec

struct Holder
    a: Option<i32>
    b: Option<u8>

enum Shape
    Dot
    Line(i32)

# --- Numeric literal type suffixes (`0u32`) --------------------------------

[[test]]
fn test_numeric_suffix_literal() -> i32
    let a = 0u32
    let b = 7i64
    let c = 2.5f32
    if a == 0 and b == 7 and c > 2.0
        0
    else
        1

[[test]]
fn test_numeric_suffix_in_if_arm() -> i32
    # The suffix used to split into `0` + an identifier `u32`, which then
    # became the trailing expression of the branch.
    let x: f32 = 3.7
    let n = if x < 0.0
        0u32
    else
        x as u32
    if n == 3
        0
    else
        1

[[test]]
fn test_hex_literal_suffix() -> i32
    let b = 0x64u8
    if b == 100
        0
    else
        1

# --- Enum variant construction uses the *target's* type --------------------

[[test]]
fn test_struct_literal_picks_field_enum() -> i32
    # `Some`/`None` are global names; the field's declared type must decide
    # which Option specialization is built.
    let h = Holder { a: Some(5), b: None }
    let x = match h.a
        Some(v) => v
        None => 0
    if x == 5
        0
    else
        1

[[test]]
fn test_assignment_picks_target_enum() -> i32
    var h = Holder { a: None, b: None }
    h.a = Some(9)
    h.b = Some(3 as u8)
    let x = match h.a
        Some(v) => v
        None => 0
    let y = match h.b
        Some(v) => v as i32
        None => 0
    if x == 9 and y == 3
        0
    else
        1

# --- `?` on an Option ------------------------------------------------------

fn first(v: Option<i32>) -> Option<i32>
    let x = v?
    Some(x + 1)

[[test]]
fn test_try_on_option_some() -> i32
    let r = match first(Some(41))
        Some(v) => v
        None => 0
    if r == 42
        0
    else
        1

[[test]]
fn test_try_on_option_none() -> i32
    let r = match first(None)
        Some(v) => v
        None => 7
    if r == 7
        0
    else
        1

# --- Qualified enum variant constructors -----------------------------------

fn make_line(n: i32) -> Shape
    Shape.Line(n)

[[test]]
fn test_qualified_variant_with_args() -> i32
    let r = match make_line(4)
        Line(n) => n
        Dot => 0
    if r == 4
        0
    else
        1

# --- Array literals honour their declared type -----------------------------

[[test]]
fn test_array_literal_uses_declared_element_type() -> i32
    # Untyped integer literals default to i64; the annotation must win, or the
    # binding ends up as [2 x i64] and every later use mismatches.
    let buf: [2]u8 = [1, 2]
    if (buf[0] as i32) + (buf[1] as i32) == 3
        0
    else
        1

[[test]]
fn test_array_literal_shorter_than_declared() -> i32
    let buf: [4]u8 = [1, 2]
    if buf[0] == 1 and buf[1] == 2 and buf[2] == 0 and buf[3] == 0
        0
    else
        1

[[test]]
fn test_empty_array_literal() -> i32
    # `[]` carries no element type of its own; it is only meaningful against a
    # declared array type. Compiling this at all is the regression.
    let empty: [0]u8 = []
    let s = span_empty<u8>()
    s.len as i32

# --- Vec range-index yields a view when a view is asked for ----------------
#
# `v[a..b]` still produces an owned `Vec<T>` copy by default (`vec_slice<T>`).
# When the context requires a span - a `Span<T>` annotation, or a `[T]`
# payload - copying would be wrong twice over: the shapes differ, and the
# caller asked for a view of `v`, not a clone.

struct Buf
    data: Vec<u8>

[[test]]
fn test_vec_range_index_as_span_view() -> i32
    var v = vec_new<u8>()
    v.push(1 as u8)
    v.push(2 as u8)
    v.push(3 as u8)
    let view: Span<u8> = v[1..3]
    if view.len != 2
        return 1
    if view[0] != 2 or view[1] != 3
        return 2
    0

[[test]]
fn test_vec_field_range_index_as_span_view() -> i32
    # A slice receiver does not have to be a plain identifier.
    var v = vec_new<u8>()
    v.push(7 as u8)
    v.push(8 as u8)
    let b = Buf { data: v }
    let view: Span<u8> = b.data[0..2]
    if view.len == 2 and view[1] == 8
        0
    else
        1

fn head_of(b:& Buf) -> Option<[u8]>
    # The `[u8]` payload is what makes this a view, not a copy.
    Some(b.data[0..1])

[[test]]
fn test_vec_range_index_into_slice_payload() -> i32
    var v = vec_new<u8>()
    v.push(5 as u8)
    v.push(6 as u8)
    var b = Buf { data: v }
    let r = match head_of(@&b)
        Some(s) => s[0] as i32
        None => 0
    if r == 5
        0
    else
        1

# --- Built-in Span operations without importing ritzlib.span ---------------

fn span_head(s: Span<u8>) -> Span<u8>
    s.slice(0, 1)

[[test]]
fn test_span_builtin_methods() -> i32
    let buf: [3]u8 = [4, 5, 6]
    let s = span_head(@buf)
    if s.len() != 1
        return 1
    if s.is_empty()
        return 2
    if s[0] != 4
        return 3
    0

# --- Instantiations found through fields and match arms --------------------

struct Bag
    items: Vec<i32>

impl Bag
    fn add(self:& Bag, v: i32)
        self.items.push(v)

    fn at(self:& Bag, i: i64) -> i32
        self.items[i]

[[test]]
fn test_method_instantiation_through_field() -> i32
    var b = Bag { items: vec_new<i32>() }
    b.add(11)
    b.add(22)
    if b.at(1) == 22
        0
    else
        1

[[test]]
fn test_generic_call_inside_match_arm() -> i32
    # Generic calls in match arms were collected but never rewritten to their
    # mangled names, so the emitter looked for the unspecialized function.
    let empty = match first(None)
        Some(_) => span_empty<u8>()
        None => span_empty<u8>()
    if empty.len == 0
        0
    else
        1

# --- match used as a statement ---------------------------------------------

[[test]]
fn test_match_as_statement() -> i32
    var total = 0
    match make_line(5)
        Line(n) =>
            total = n
        Dot =>
            total = 0
    if total == 5
        0
    else
        1
