# AGAST #1452 — trailing comma in call argument lists.
#
# ritz0 accepts `fn f(a: i64, b: i64,)` and `f(1, 2,)`; ritz1's `params` and
# `args` productions had no trailing-comma alternative, so any file using the
# multi-line, one-item-per-line style (ritzlib/testlib.ritz exec_capture,
# imported by 47 examples) failed to parse under ritz1.  Params and args are
# split into separate files so each grammar alternative has its own test.

fn add2(a: i64, b: i64) -> i64
    return a + b

fn one(a: i64) -> i64
    return a + 1

fn add3(a: i64, b: i64, c: i64) -> i64
    return a + b + c

[[test]]
fn test_trailing_comma_args() -> i32
    assert add2(2, 3,) == 5
    assert one(41,) == 42
    0

[[test]]
fn test_trailing_comma_args_multiline() -> i32
    let r: i64 = add3(
        10,
        20,
        30,
    )
    assert r == 60
    0
