# AGAST #3824: a field of a struct const, `K.ptr` / `K.len` with
# `const K: StrView = "..."`.
#
# THE DEFECT
#
# ritz1 lowers a string-initialised struct const to a `%StrView` global
# (#189) and loads it whole for a bare `K`, but emit_member_ptr's identifier
# arm knew only locals and `var` globals.  `K.len` fell to the unlocated
# "unhandled EXPR_MEMBER", so mausoleum (recovery, registry and storage read
# `DEFAULT_COLLECTION_NAME.ptr` / `.len` from m7m_types) and nexus, through
# it, did not build on ritz1.  ritz0 compiled them.
#
# THE FIX (ritz1/src/emitter_expr.ritz)
#
# emit_struct_const_member_ptr GEPs the field out of the const's global,
# as the `var g: S` arm does.
#
# Oracle: ritz0 runs every case to the same result.  LIB_NAME is imported
# from test_const_struct_member_lib, the cross-module form mausoleum uses.

import ritzlib.strview
import test_const_struct_member_lib

const NAME: StrView = "hello"

fn takes(p: *u8, n: i32) -> i32
    if *(p + n as i64 - 1) != 111   # 'o'
        return 0
    return n

[[test]]
fn test_const_strview_fields_annotated() -> i32
    let p: *u8 = NAME.ptr
    let n: i64 = NAME.len
    if n != 5
        return 1
    if *p != 104   # 'h'
        return 2
    0

[[test]]
fn test_const_strview_fields_as_args() -> i32
    # The mausoleum shape: `.ptr` and `.len as i32` straight into a call.
    if takes(NAME.ptr, NAME.len as i32) != 5
        return 1
    0

[[test]]
fn test_const_strview_fields_in_expr() -> i32
    if NAME.len + 1 != 6
        return 1
    # `*(K.ptr + i)` must load the u8 that `K.ptr` points at: untyped, ritz1
    # loaded an i64 here and compared 8 bytes against 111.
    if *(NAME.ptr + 4) != 111   # 'o'
        return 2
    let q = NAME.ptr + 1
    if *q != 101   # 'e'
        return 3
    let m = NAME.len
    if m * 2 != 10
        return 4
    0

[[test]]
fn test_imported_const_strview_fields() -> i32
    if LIB_NAME.len != 7
        return 1
    if *(LIB_NAME.ptr + 6) != 116   # 't'
        return 2
    let n: i32 = LIB_NAME.len as i32
    if n != 7
        return 3
    0
