# AGAST #4576: an indexed struct element as a print placeholder, with
# ritzlib.fmt in scope, so the value prints through its Display / Debug impl
# (the ticket's `print("a0={args[0]}")` on a Span<StrView>, and a user struct).
#
# ritz1 typed the placeholder `args[0]` as an integer and emitted
# `trunc i64 %.N to i8` on the `%StrView`; an `[N]S` or `*S` element was
# refused as "a whole struct is not a value here".  The intrinsic (no impl)
# path is test_issue_print_index_elem_type.ritz.
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted; ritz0 is
# the oracle for the bytes.

import ritzlib.sys
import ritzlib.strview
import ritzlib.result
import ritzlib.span
import ritzlib.fd
import ritzlib.fmt
import ritzlib.string

struct Point
    x: i64
    y: i64

impl Display for Point
    fn show(self: @Point, w: @&Writer) -> i64
        let before: i64 = w.len
        format_into(w, "({self.x}, {self.y})")
        w.len - before

var g_rd: i32 = 0
var g_saved: i32 = 0
var g_fd: i32 = 0

fn capture_begin(fd: i32) -> i32
    g_fd = fd
    capture_into(fd)

# Point descriptor `fd` at a new pipe, saving the old one in g_saved and the
# pipe's read end in g_rd (raw numbers: globals hold no Fd). 0, or 1 on error.
fn capture_into(fd: i32) -> i32
    match pipe()
        Ok(pp) =>
            var p: Pipe = pp
            match fd_borrow(fd).dup()
                Ok(saved) => g_saved = saved.raw()
                Err(_) => return 1
            p.write.dup_to(fd)
            p.write.close()
            g_rd = p.read.raw()
            0
        Err(_) => 1

# Restore the captured fd, read what was written, compare it with `want`.
# Returns 0 on an exact byte match.
fn capture_end_expect(want: StrView) -> i32
    var saved: Fd = fd_adopt(g_saved)
    saved.dup_to(g_fd)
    saved.close()
    var rd: Fd = fd_adopt(g_rd)
    var buf: [256]u8
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < 256
        match rd.read(Span<u8> { ptr: @buf[got], len: 256 - got })
            Ok(k) => n = k
            Err(_) => n = 0
        got = got + n
    rd.close()
    var i: i64 = 0
    while i < want.len
        if i >= got
            return 2
        if buf[i] != *(want.ptr + i)
            return 3
        i = i + 1
    if i != got
        return 4
    0

[[test_helper]]
fn show_args(args: Span<StrView>) -> i32
    assert capture_begin(1) == 0
    print("a0={args[0]} a1={args[1]}\n")
    capture_end_expect("a0=prog a1=-v\n")

[[test]]
fn test_span_strview_index_display() -> i32
    var arr: [2]StrView = ["prog", "-v"]
    assert show_args(@arr) == 0
    0

[[test_helper]]
fn show_points(pts: Span<Point>) -> i32
    assert capture_begin(1) == 0
    print("{pts[1]}\n")
    capture_end_expect("(3, 4)\n")

[[test]]
fn test_span_struct_index_display() -> i32
    var pts: [2]Point = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    assert show_points(@pts) == 0
    0

[[test]]
fn test_array_struct_index_display() -> i32
    var pts: [2]Point = [Point { x: 1, y: 2 }, Point { x: -5, y: 6 }]
    assert capture_begin(1) == 0
    print("{pts[0]}|{pts[1]}\n")
    assert capture_end_expect("(1, 2)|(-5, 6)\n") == 0
    0

[[test]]
fn test_ptr_struct_index_display() -> i32
    var pts: [2]Point = [Point { x: 1, y: 2 }, Point { x: 7, y: 8 }]
    let p: *Point = @pts[0]
    assert capture_begin(1) == 0
    print("{p[1]}\n")
    assert capture_end_expect("(7, 8)\n") == 0
    0

# `:?` on a struct with no Debug impl auto-derives its fields.
[[test]]
fn test_array_struct_index_debug() -> i32
    var pts: [1]Point = [Point { x: 9, y: 0 }]
    assert capture_begin(1) == 0
    print("{pts[0]:?}\n")
    assert capture_end_expect("Point { x: 9, y: 0 }\n") == 0
    0

# AGAST #4585: an element of a `[N]*Point` is a pointer, and a pointer other
# than StrView prints the NUL-terminated bytes it points at (LANGUAGE_SPEC
# "other pointers"), not its pointee's Display. ritz0 scanned for the NUL in
# units of the pointee, emitting `icmp eq %Point ..., 0`. x = 0x4948 lays
# out as the bytes "HI" then NULs.
[[test]]
fn test_array_ptr_struct_index_prints_bytes() -> i32
    var a: Point = Point { x: 18760, y: 7 }
    var ps: [1]*Point = [@a]
    assert capture_begin(1) == 0
    print("<{ps[0]}>\n")
    assert capture_end_expect("<HI>\n") == 0
    0

# The same rule on a plain `*Point` local, the path #4585 named a workaround.
[[test]]
fn test_ptr_struct_local_prints_bytes() -> i32
    var a: Point = Point { x: 18760, y: 7 }
    let q: *Point = @a
    assert capture_begin(1) == 0
    print("<{q}>\n")
    assert capture_end_expect("<HI>\n") == 0
    0
