# AGAST #3353: a "..." literal in a Span<u8> slot, with no import.
#
# A literal takes its type from its slot (LARB R3); in a `Span<u8>` slot it
# is a `Span<u8>` over its bytes (len excludes the NUL), at every slot. Before
# #3353 ritz0's answer hung on whether a StrView struct happened to be
# registered: with none, `let` bound an unusable `{ i8*, i64 }` (`s.len`
# crashed), `=`, an argument and a field were refused, `return` was accepted.
# test_strlit_span_slot_strview.ritz runs the same cases with StrView
# registered and must agree. Whether the rule stands is LARB's call (#3402).
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted.

struct Holder
    s: Span<u8>

fn span_len(s: Span<u8>) -> i64
    s.len

fn give_return() -> Span<u8>
    return "abcd"

fn give_tail(short: bool) -> Span<u8>
    if short
        "ab"
    else
        "abcdef"

[[test]]
fn test_strlit_span_let() -> i32
    let s: Span<u8> = "hello"
    assert s.len == 5
    assert s[0] == 'h'
    assert s[4] == 'o'
    0

[[test]]
fn test_strlit_span_var_and_assign() -> i32
    var s: Span<u8> = "hi"
    assert s.len == 2
    s = "xyz"
    assert s.len == 3
    assert s[2] == 'z'
    0

[[test]]
fn test_strlit_span_arg() -> i32
    assert span_len("four") == 4
    0

[[test]]
fn test_strlit_span_return_and_tail() -> i32
    assert give_return().len == 4
    assert give_tail(true).len == 2
    assert give_tail(false)[5] == 'f'
    0

[[test]]
fn test_strlit_span_field() -> i32
    let h = Holder { s: "abc" }
    assert h.s.len == 3
    assert h.s[1] == 'b'
    0

[[test]]
fn test_strlit_span_empty() -> i32
    let s: Span<u8> = ""
    assert s.len == 0
    0

[[test]]
fn test_strlit_span_element() -> i32
    let a: [2]Span<u8> = ["a", "bcd"]
    assert a[0].len == 1
    let b: Span<u8> = a[1]
    assert b[2] == 'd'
    0
