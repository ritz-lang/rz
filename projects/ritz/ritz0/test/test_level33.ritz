# test_level33.ritz - HashMap tests
#
# Tests the HashMapI64 implementation with i64 keys and values.

import ritzlib.hashmap
import ritzlib.hash

# ============================================================================
# Basic HashMapI64 tests
# ============================================================================

[[test]]
fn test_hashmap_new() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    assert hashmap_i64_len(@m) == 0, "new map should be empty"
    assert hashmap_i64_is_empty(@m), "new map should be empty"
    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_insert_get() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    hashmap_i64_insert(@&m, 42, 100)
    assert hashmap_i64_len(@m) == 1, "len should be 1"

    let val: i64 = hashmap_i64_get(@m, 42)
    assert val == 100, "value should be 100"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_contains() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    assert not hashmap_i64_contains(@m, 42), "should not contain 42"

    hashmap_i64_insert(@&m, 42, 100)
    assert hashmap_i64_contains(@m, 42), "should contain 42"
    assert not hashmap_i64_contains(@m, 43), "should not contain 43"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_update() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    hashmap_i64_insert(@&m, 42, 100)
    assert hashmap_i64_get(@m, 42) == 100, "initial value"

    hashmap_i64_insert(@&m, 42, 200)
    assert hashmap_i64_get(@m, 42) == 200, "updated value"
    assert hashmap_i64_len(@m) == 1, "len should still be 1"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_multiple_keys() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    hashmap_i64_insert(@&m, 1, 10)
    hashmap_i64_insert(@&m, 2, 20)
    hashmap_i64_insert(@&m, 3, 30)

    assert hashmap_i64_len(@m) == 3, "len should be 3"
    assert hashmap_i64_get(@m, 1) == 10, "key 1"
    assert hashmap_i64_get(@m, 2) == 20, "key 2"
    assert hashmap_i64_get(@m, 3) == 30, "key 3"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_remove() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    hashmap_i64_insert(@&m, 42, 100)
    assert hashmap_i64_contains(@m, 42), "should contain 42"

    let removed: i32 = hashmap_i64_remove(@&m, 42)
    assert removed == 1, "should return 1 on successful remove"
    assert not hashmap_i64_contains(@m, 42), "should not contain 42 after remove"
    assert hashmap_i64_len(@m) == 0, "len should be 0"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_remove_not_found() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    let removed: i32 = hashmap_i64_remove(@&m, 42)
    assert removed == 0, "should return 0 when key not found"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_many_keys() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    # Insert 50 keys
    var i: i64 = 0
    while i < 50
        hashmap_i64_insert(@&m, i, i * 10)
        i = i + 1

    assert hashmap_i64_len(@m) == 50, "len should be 50"

    # Verify all keys
    i = 0
    while i < 50
        let val: i64 = hashmap_i64_get(@m, i)
        if val != i * 10
            return 1  # Fail
        i = i + 1

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_grow() -> i32
    # Start with small capacity
    var m: HashMapI64 = hashmap_i64_with_cap(4)
    assert hashmap_i64_cap(@m) == 16, "min cap is 16"

    # Insert enough to trigger growth
    var i: i64 = 0
    while i < 20
        hashmap_i64_insert(@&m, i, i * 2)
        i = i + 1

    assert hashmap_i64_len(@m) == 20, "len should be 20"

    # Verify all values still correct after growth
    i = 0
    while i < 20
        if hashmap_i64_get(@m, i) != i * 2
            return 1
        i = i + 1

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_collision() -> i32
    # Test keys that might collide (multiples of capacity)
    var m: HashMapI64 = hashmap_i64_with_cap(16)

    # These keys will hash to similar positions
    hashmap_i64_insert(@&m, 0, 100)
    hashmap_i64_insert(@&m, 16, 200)
    hashmap_i64_insert(@&m, 32, 300)

    assert hashmap_i64_get(@m, 0) == 100, "key 0"
    assert hashmap_i64_get(@m, 16) == 200, "key 16"
    assert hashmap_i64_get(@m, 32) == 300, "key 32"

    hashmap_i64_drop(@&m)
    0

# ============================================================================
# Syntax sugar tests: m[key] for get, m[key] = value for insert
# ============================================================================

[[test]]
fn test_hashmap_index_get() -> i32
    # Test m[key] syntax for getting values
    var m: HashMapI64 = hashmap_i64_new()

    hashmap_i64_insert(@&m, 10, 100)
    hashmap_i64_insert(@&m, 20, 200)

    # Use index syntax: m[key] reads through `impl Index`
    let val1: i64 = m[10]
    let val2: i64 = m[20]

    assert val1 == 100, "m[10] should be 100"
    assert val2 == 200, "m[20] should be 200"

    # `m[k]` on a missing key ends the program (LANGUAGE_SPEC §7.8): test with
    # get or contains instead.
    assert hashmap_i64_get(@m, 999) == 0, "get(999) should be 0 (not found)"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_index_set() -> i32
    # Test m[key] = value syntax for insertion
    var m: HashMapI64 = hashmap_i64_new()

    # Use index assignment syntax: m[key] = val inserts through `impl IndexSet`
    m[10] = 100
    m[20] = 200
    m[30] = 300

    assert hashmap_i64_len(@m) == 3, "len should be 3"
    assert m[10] == 100, "m[10] should be 100"
    assert m[20] == 200, "m[20] should be 200"
    assert m[30] == 300, "m[30] should be 300"

    # Update via index assignment
    m[20] = 999
    assert m[20] == 999, "m[20] should be updated to 999"
    assert hashmap_i64_len(@m) == 3, "len should still be 3"

    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_index_mixed() -> i32
    # Test mixing index syntax with regular function calls
    var m: HashMapI64 = hashmap_i64_new()

    # Insert via syntax sugar
    m[1] = 10
    m[2] = 20

    # Read via function
    assert hashmap_i64_get(@m, 1) == 10, "get via function"

    # Insert via function
    hashmap_i64_insert(@&m, 3, 30)

    # Read via syntax sugar
    assert m[3] == 30, "get via index"

    hashmap_i64_drop(@&m)
    0

# ============================================================================
# AGAST #3451: one probe, four wrappers. A tombstone must be stepped over by
# every lookup (get, value_ptr, contains, remove) and reused by insert.
# ============================================================================

# Eleven keys that all hash to slot 3 of a 16-slot table fill one probe chain
# (slots 3..13), so every removal tombstones a slot that the keys after it are
# probed past.  A wrapper that stops at a tombstone, or treats one as a hit,
# loses or finds the wrong key.  Eleven, not twelve: re-inserting must not
# cross the 75% load factor, or grow() would rehash the tombstone away.
fn hashmap_i64_chain_keys(keys: *i64)
    var n: i64 = 0
    var k: i64 = 0
    while n < 11
        if ((hash_i64(k) as i64) & 15) == 3
            keys[n] = k
            n = n + 1
        k = k + 1

fn hashmap_i64_tomb_check(keys: *i64, gone_at: i64) -> i32
    var m: HashMapI64 = hashmap_i64_with_cap(16)
    for i in 0..11
        hashmap_i64_insert(@&m, keys[i], i * 10 + 1)
    if hashmap_i64_cap(@m) != 16
        return 1
    let gone: i64 = keys[gone_at]
    if hashmap_i64_remove(@&m, gone) != 1
        return 2
    # The removed key is gone from every lookup.
    if hashmap_i64_contains(@m, gone)
        return 3
    if hashmap_i64_get(@m, gone) != 0
        return 4
    if hashmap_i64_value_ptr(@m, gone) != null
        return 5
    if hashmap_i64_remove(@&m, gone) != 0
        return 6
    # Every other key is still reached across the tombstone.
    for i in 0..11
        if i != gone_at
            let k: i64 = keys[i]
            if not hashmap_i64_contains(@m, k)
                return 7
            if hashmap_i64_get(@m, k) != i * 10 + 1
                return 8
            let p: *i64 = hashmap_i64_value_ptr(@m, k)
            if p == null
                return 9
            if *p != i * 10 + 1
                return 10
    # Re-inserting the key reuses its tombstone instead of a fresh slot.
    hashmap_i64_insert(@&m, gone, 777)
    if hashmap_i64_cap(@m) != 16
        return 11
    if m.tombstones != 0
        return 12
    if hashmap_i64_len(@m) != 11
        return 13
    if hashmap_i64_get(@m, gone) != 777
        return 14
    hashmap_i64_drop(@&m)
    0

[[test]]
fn test_hashmap_remove_then_lookup_every_key() -> i32
    var keys: [11]i64
    hashmap_i64_chain_keys(@keys[0])
    for gone_at in 0..11
        let r: i32 = hashmap_i64_tomb_check(@keys[0], gone_at)
        if r != 0
            return r
    0

[[test]]
fn test_hashmap_bool_predicates() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    assert m.is_empty()
    assert not m.contains(5)
    m.insert(5, 50)
    assert not m.is_empty()
    assert not hashmap_i64_is_empty(@m)
    assert m.contains(5)
    hashmap_i64_drop(@&m)
    0
