# test_level33.ritz - HashMap tests
#
# Tests the HashMapI64 implementation with i64 keys and values.

import ritzlib.hashmap
import ritzlib.hash
import ritzlib.option

# ============================================================================
# Basic HashMapI64 tests
# ============================================================================

[[test]]
fn test_hashmap_new() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    assert m.len() == 0, "new map should be empty"
    assert m.is_empty(), "new map should be empty"
    m.free()
    0

[[test]]
fn test_hashmap_insert_get() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    m.insert(42, 100)
    assert m.len() == 1, "len should be 1"

    let val: Option<i64> = m.get(42)
    assert val.is_some(), "42 is present"
    assert val.unwrap_or(-1) == 100, "value should be 100"

    m.free()
    0

[[test]]
fn test_hashmap_contains() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    assert not m.contains(42), "should not contain 42"

    m.insert(42, 100)
    assert m.contains(42), "should contain 42"
    assert not m.contains(43), "should not contain 43"

    m.free()
    0

[[test]]
fn test_hashmap_update() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    m.insert(42, 100)
    assert m.get(42).unwrap_or(-1) == 100, "initial value"

    m.insert(42, 200)
    assert m.get(42).unwrap_or(-1) == 200, "updated value"
    assert m.len() == 1, "len should still be 1"

    m.free()
    0

[[test]]
fn test_hashmap_multiple_keys() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)

    assert m.len() == 3, "len should be 3"
    assert m.get(1).unwrap_or(-1) == 10, "key 1"
    assert m.get(2).unwrap_or(-1) == 20, "key 2"
    assert m.get(3).unwrap_or(-1) == 30, "key 3"

    m.free()
    0

[[test]]
fn test_hashmap_remove() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    m.insert(42, 100)
    assert m.contains(42), "should contain 42"

    let removed: bool = m.remove(42)
    assert removed, "should return true on successful remove"
    assert not m.contains(42), "should not contain 42 after remove"
    assert m.len() == 0, "len should be 0"

    m.free()
    0

[[test]]
fn test_hashmap_remove_not_found() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    let removed: bool = m.remove(42)
    assert not removed, "should return false when key not found"

    m.free()
    0

[[test]]
fn test_hashmap_many_keys() -> i32
    var m: HashMapI64 = hashmap_i64_new()

    # Insert 50 keys
    var i: i64 = 0
    while i < 50
        m.insert(i, i * 10)
        i = i + 1

    assert m.len() == 50, "len should be 50"

    # Verify all keys
    i = 0
    while i < 50
        let val: i64 = m.get(i).unwrap_or(-1)
        if val != i * 10
            return 1  # Fail
        i = i + 1

    m.free()
    0

[[test]]
fn test_hashmap_grow() -> i32
    # Start with small capacity
    var m: HashMapI64 = hashmap_i64_with_cap(4)
    assert m.cap() == 16, "min cap is 16"

    # Insert enough to trigger growth
    var i: i64 = 0
    while i < 20
        m.insert(i, i * 2)
        i = i + 1

    assert m.len() == 20, "len should be 20"

    # Verify all values still correct after growth
    i = 0
    while i < 20
        if m.get(i).unwrap_or(-1) != i * 2
            return 1
        i = i + 1

    m.free()
    0

[[test]]
fn test_hashmap_collision() -> i32
    # Test keys that might collide (multiples of capacity)
    var m: HashMapI64 = hashmap_i64_with_cap(16)

    # These keys will hash to similar positions
    m.insert(0, 100)
    m.insert(16, 200)
    m.insert(32, 300)

    assert m.get(0).unwrap_or(-1) == 100, "key 0"
    assert m.get(16).unwrap_or(-1) == 200, "key 16"
    assert m.get(32).unwrap_or(-1) == 300, "key 32"

    m.free()
    0

# A stored 0 and a missing key are told apart: get is an Option (AGAST #4648).
[[test]]
fn test_hashmap_get_zero_value_vs_missing() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    m.insert(7, 0)
    let got: i64 = match m.get(7)
        Some(v) => v
        None => -1
    assert got == 0, "stored 0 reads back as Some(0)"
    assert m.get(8).is_none(), "8 is missing"
    m.free()
    0

# ============================================================================
# Syntax sugar tests: m[key] for get, m[key] = value for insert
# ============================================================================

[[test]]
fn test_hashmap_index_get() -> i32
    # Test m[key] syntax for getting values
    var m: HashMapI64 = hashmap_i64_new()

    m.insert(10, 100)
    m.insert(20, 200)

    # Use index syntax: m[key] reads through `impl Index`
    let val1: i64 = m[10]
    let val2: i64 = m[20]

    assert val1 == 100, "m[10] should be 100"
    assert val2 == 200, "m[20] should be 200"

    # `m[k]` on a missing key ends the program (LANGUAGE_SPEC §7.8): test with
    # get or contains instead.
    assert m.get(999).is_none(), "get(999) should be None (not found)"

    m.free()
    0

[[test]]
fn test_hashmap_index_set() -> i32
    # Test m[key] = value syntax for insertion
    var m: HashMapI64 = hashmap_i64_new()

    # Use index assignment syntax: m[key] = val inserts through `impl IndexSet`
    m[10] = 100
    m[20] = 200
    m[30] = 300

    assert m.len() == 3, "len should be 3"
    assert m[10] == 100, "m[10] should be 100"
    assert m[20] == 200, "m[20] should be 200"
    assert m[30] == 300, "m[30] should be 300"

    # Update via index assignment
    m[20] = 999
    assert m[20] == 999, "m[20] should be updated to 999"
    assert m.len() == 3, "len should still be 3"

    m.free()
    0

[[test]]
fn test_hashmap_index_mixed() -> i32
    # Test mixing index syntax with regular function calls
    var m: HashMapI64 = hashmap_i64_new()

    # Insert via syntax sugar
    m[1] = 10
    m[2] = 20

    # Read via function
    assert m.get(1).unwrap_or(-1) == 10, "get via function"

    # Insert via function
    m.insert(3, 30)

    # Read via syntax sugar
    assert m[3] == 30, "get via index"

    m.free()
    0

# ============================================================================
# AGAST #3451: one probe, four wrappers. A tombstone must be stepped over by
# every lookup (get, get_mut, contains, remove) and reused by insert.
# ============================================================================

# Eleven keys that all hash to slot 3 of a 16-slot table fill one probe chain
# (slots 3..13), so every removal tombstones a slot that the keys after it are
# probed past.  A wrapper that stops at a tombstone, or treats one as a hit,
# loses or finds the wrong key.  Eleven, not twelve: re-inserting must not
# cross the 75% load factor, or grow() would rehash the tombstone away.
fn hashmap_i64_chain_keys(keys: *i64)
    var n: i64 = 0
    var k: i64 = 0
    while n < 11
        if ((hash_i64(k) as i64) & 15) == 3
            keys[n] = k
            n = n + 1
        k = k + 1

fn hashmap_i64_tomb_check(keys: *i64, gone_at: i64) -> i32
    var m: HashMapI64 = hashmap_i64_with_cap(16)
    for i in 0..11
        m.insert(keys[i], i * 10 + 1)
    if m.cap() != 16
        return 1
    let gone: i64 = keys[gone_at]
    if not m.remove(gone)
        return 2
    # The removed key is gone from every lookup.
    if m.contains(gone)
        return 3
    if m.get(gone).is_some()
        return 4
    match m.get_mut(gone)
        Some(_) => return 5
        None => pass
    if m.remove(gone)
        return 6
    # Every other key is still reached across the tombstone.
    for i in 0..11
        if i != gone_at
            let k: i64 = keys[i]
            if not m.contains(k)
                return 7
            if m.get(k).unwrap_or(-1) != i * 10 + 1
                return 8
            match m.get_mut(k)
                Some(q) =>
                    let p: *i64 = q
                    if *p != i * 10 + 1
                        return 10
                None => return 9
    # Re-inserting the key reuses its tombstone instead of a fresh slot.
    m.insert(gone, 777)
    if m.cap() != 16
        return 11
    if m.tombstones != 0
        return 12
    if m.len() != 11
        return 13
    if m.get(gone).unwrap_or(-1) != 777
        return 14
    m.free()
    0

[[test]]
fn test_hashmap_remove_then_lookup_every_key() -> i32
    var keys: [11]i64
    hashmap_i64_chain_keys(@keys[0])
    for gone_at in 0..11
        let r: i32 = hashmap_i64_tomb_check(@keys[0], gone_at)
        if r != 0
            return r
    0

[[test]]
fn test_hashmap_bool_predicates() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    assert m.is_empty()
    assert not m.contains(5)
    m.insert(5, 50)
    assert not m.is_empty()
    assert not m.is_empty()
    assert m.contains(5)
    m.free()
    0
