# Regression: a reference param takes a local holding an rvalue. A value never
# fits one on its own (AGAST #2337), and `@f()` has no place to borrow.

struct S
    n: i32

impl S
    fn clone_self(self) -> S
        self

fn use_ref(s: @S) -> i32
    s.n

[[test]]
fn test_ref_param_rvalue_methodcall() -> i32
    let a = S { n: 9 }
    let b = a.clone_self()
    if use_ref(@b) == 9
        0
    else
        1
