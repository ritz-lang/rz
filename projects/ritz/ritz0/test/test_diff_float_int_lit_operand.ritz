# AGAST #4285: an integer literal operand of a float binop is a float.
#
# THE DEFECT
#
# `x != 2` with `x: f64` emitted `fcmp une double %x, 2` in ritz0: the
# literal kept its i64 and clang rejects the IR ("integer constant must have
# integer type").  `x + 1` crashed ritz0 outright (llvmlite: "Operands must
# be the same type").  §7.5 lets an integer literal into a float slot; a
# float operator's other operand is one.
#
# THE FIX
#
# An integer-literal-only operand (`2`, `-3`, `2 * 3`) opposite a float
# operand is emitted as a constant of that float's type.
#
# Oracle: every compiler in the matrix runs every case to the same result.

fn fil_f64_cmp() -> i32
    var x: f64 = 2.0
    if x != 2
        return 1
    if 2 != x
        return 2
    if !(x == 2)
        return 3
    if !(2 == x)
        return 4
    if x < 1
        return 5
    if 3 < x
        return 6
    if x > 3
        return 7
    if 1 > x
        return 8
    if !(x >= 2) or !(2 <= x)
        return 9
    if x == -2
        return 10
    if x != 1 * 2
        return 11
    return 42

fn fil_f64_arith() -> i32
    let x: f64 = 2.0
    let a: f64 = x + 1
    if a != 3.0
        return 1
    let b: f64 = 1 + x
    if b != 3.0
        return 2
    if x - 3 != -1.0
        return 3
    if 3 - x != 1.0
        return 4
    if x * 3 != 6.0
        return 5
    if 3 * x != 6.0
        return 6
    if x / 4 != 0.5
        return 7
    if 4 / x != 2.0
        return 8
    if x + -1 != 1.0
        return 9
    return 42

fn fil_f32() -> i32
    let y: f32 = 1.5
    if y > 2
        return 1
    if 1 > y
        return 2
    let z: f32 = y * 2
    if z != 3
        return 3
    if 3 != z
        return 4
    let r: f32 = 1 + y
    if r != 2.5
        return 5
    return 42

[[test]]
fn test_fil_f64_cmp() -> i32
    assert fil_f64_cmp() == 42
    0

[[test]]
fn test_fil_f64_arith() -> i32
    assert fil_f64_arith() == 42
    0

[[test]]
fn test_fil_f32() -> i32
    assert fil_f32() == 42
    0
