# AGAST #3346: the Span<T> struct literal with `import ritzlib.span`.
#
# The companion of test_span_builtin_no_import.ritz: the same cases, but here
# ritzlib.span's generic `struct Span<T>` is in scope and the monomorphizer
# names the literal's struct.  The fix for the no-import case must leave this
# path alone (one `Span$u8`, built from the declared struct).
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.span

fn span_sum(s: Span<u8>) -> i64
    var total: i64 = 0
    for i in 0..s.len
        total = total + (s[i] as i64)
    total

[[test]]
fn test_span_literal_let_imported() -> i32
    var a: [3]u8 = [1, 2, 3]
    let s: Span<u8> = Span<u8> { ptr: @a[0], len: 3 }
    let n: i64 = s.len
    assert n == 3
    assert s[2] == 3
    0

[[test]]
fn test_span_literal_param_imported() -> i32
    var a: [3]u8 = [1, 2, 3]
    assert span_sum(Span<u8> { ptr: @a[1], len: 2 }) == 5
    0
