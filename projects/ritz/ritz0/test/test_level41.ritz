# Test level 41: defer statement (LANGUAGE_SPEC §13.7, LARB R14)
#
# `defer` schedules a statement to run when the innermost enclosing block
# exits. Multiple defers run in LIFO order. The statement is evaluated at
# exit, not at the `defer` line. test_defer_exits.ritz covers the other exits.

import ritzlib.sys

# ============================================================================
# Global counter for tracking defer execution order
# ============================================================================

var counter: i64 = 0
var trace_0: i64 = 0
var trace_1: i64 = 0
var trace_2: i64 = 0
var trace_3: i64 = 0
var trace_idx: i64 = 0

pub fn trace_push(val: i64) -> i32
    if trace_idx == 0
        trace_0 = val
    else if trace_idx == 1
        trace_1 = val
    else if trace_idx == 2
        trace_2 = val
    else
        trace_3 = val
    trace_idx = trace_idx + 1
    0

pub fn reset_trace() -> i32
    counter = 0
    trace_idx = 0
    trace_0 = 0
    trace_1 = 0
    trace_2 = 0
    trace_3 = 0
    0

# ============================================================================
# Test: Basic defer executes at scope exit
# ============================================================================

pub fn do_basic() -> i32
    counter = 0
    defer counter = 99
    counter = 1
    0
    # the defer fires here, after the tail value: counter becomes 99

[[test]]
fn test_defer_basic() -> i32
    reset_trace()
    do_basic()
    assert counter == 99, "the defer should run when do_basic's body exits"
    0

# ============================================================================
# Test: LIFO order — last defer runs first
# ============================================================================

pub fn do_lifo() -> i32
    defer trace_push(1)
    defer trace_push(2)
    defer trace_push(3)
    0

[[test]]
fn test_defer_lifo_check() -> i32
    reset_trace()
    do_lifo()
    # After do_lifo returns, defers have executed
    assert trace_0 == 3, "first defer to run should be last registered"
    assert trace_1 == 2, "second defer to run"
    assert trace_2 == 1, "third defer to run should be first registered"
    0

# ============================================================================
# Test: Defer runs on early return
# ============================================================================

pub fn do_early_return(x: i32) -> i32
    defer counter = 42
    if x > 0
        return 1    # Early return — defer still runs
    return 0

[[test]]
fn test_defer_early_return() -> i32
    reset_trace()
    do_early_return(1)
    assert counter == 42, "defer should run even on early return"
    0

# ============================================================================
# Test: The deferred statement is evaluated at exit (LANGUAGE_SPEC §13.7)
# ============================================================================

pub fn do_evaluate_at_exit() -> i32
    var x: i64 = 10
    defer counter = x   # nothing is evaluated here; it captures nothing
    x = 20               # so the statement sees x as it is at exit
    0

[[test]]
fn test_defer_evaluates_at_exit() -> i32
    reset_trace()
    do_evaluate_at_exit()
    assert counter == 20, "the deferred statement should read x at exit"
    0

# ============================================================================
# Test: Multiple defers with function calls
# ============================================================================

pub fn cleanup_a() -> i32
    trace_push(10)
    0

pub fn cleanup_b() -> i32
    trace_push(20)
    0

pub fn do_multi_defer() -> i32
    defer cleanup_a()
    defer cleanup_b()
    0

[[test]]
fn test_defer_function_calls() -> i32
    reset_trace()
    do_multi_defer()
    # LIFO: cleanup_b runs first, then cleanup_a
    assert trace_0 == 20, "cleanup_b should run first (LIFO)"
    assert trace_1 == 10, "cleanup_a should run second"
    0

# ============================================================================
# Test: Defer with simple assignment
# ============================================================================

[[test]]
fn test_defer_simple() -> i32
    # Only shows that registering a defer doesn't run its statement: the
    # assert runs before the block exits, so it can't see the defer fire.
    counter = 0
    defer counter = 100
    assert counter == 0, "counter should be 0 before scope exit"
    0

# Entry point
fn main() -> i32
    0
