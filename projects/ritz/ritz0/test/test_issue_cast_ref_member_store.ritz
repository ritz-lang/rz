# AGAST #3443: a store to a field of a cast to a reference,
# `(p as @&Holder).t = v` with `p: *Holder`.
#
# THE DEFECT (ritz1)
#
# ritz0 built it; ritz1 refused it, unlocated, with "unhandled EXPR_MEMBER in
# assignment" (and the read `(p as @&Holder).t` with "unhandled EXPR_MEMBER").
# #2373 gave the member path a cast-base arm, but the parser recorded a
# cast's struct pointee only for `as *S`, so `as @&S` / `as @S` named no
# struct and emit_deref_operand_ptr gave up.  `let r: @&Holder = p; r.t = v`
# already worked.
#
# Every struct has its probed field second, so a GEP at the wrong offset
# writes `pad`, not `t`.
#
# The indexed form `(p as @&Holder).arr[i] = v` also fails on ritz0 ("Cannot
# get address of: Cast"), so it is filed separately, not tested here.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

struct Holder
    pad: i64
    t: i32

fn put(p: *Holder, v: i32)
    (p as @&Holder).t = v

fn bump(p: *Holder)
    (p as @&Holder).t += 5

fn get_shared(p: *Holder) -> i32
    (p as @Holder).t

[[test]]
fn test_cast_mut_ref_member_store() -> i32
    var h: Holder = Holder { pad: 3, t: 4 }
    put(@&h, 9)
    assert h.t == 9
    bump(@&h)
    assert h.t == 14
    assert h.pad == 3
    0

[[test]]
fn test_cast_ref_member_read() -> i32
    var h: Holder = Holder { pad: 3, t: 4 }
    assert (@&h as @&Holder).t == 4
    assert get_shared(@&h) == 4
    0
