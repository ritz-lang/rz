# A match arm's binding reads the arm's value, not a same-named `var` of an
# earlier block that has already closed (AGAST #4926).
#
# ritz0 keeps a block's `var` after the block ends and read it before an
# arm's binding, so in `note` below the arm's `t` read the dead `var t`
# (an uninitialised slot on the path that skips the block) instead of the
# payload.  ritz1 generic_infer.ritz's gi_note_decl had this shape.  Each test
# is one of ritz0's three arm-binding sites: a variant payload, a bare name
# binding an enum scrutinee, and an integer match's name.

import ritzlib.option

struct G
    kind: i32
    pointee: i32

enum Mode
    Fast
    Slow

var g_kind: i32 = 0

fn take(t: G)
    g_kind = t.kind

fn ty(x: i32) -> Option<G>
    if x == 0
        return None
    Some(G { kind: x, pointee: 2 })

fn note(arr: bool, x: i32)
    if arr
        var t: G = G { kind: 99, pointee: 0 }
        take(t)
        return
    match ty(x)
        Some(t) => take(t)
        None => pass

[[test]]
fn test_payload_binding_after_a_closed_block_var() -> i32
    note(false, 7)
    assert g_kind == 7
    note(true, 7)
    assert g_kind == 99
    0

fn mode_rank(slow: bool, m: Mode) -> i32
    if slow
        var other: i32 = 40
        return other
    match m
        Mode.Fast => 1
        other => other as i32 + 10

[[test]]
fn test_scrutinee_binding_after_a_closed_block_var() -> i32
    assert mode_rank(false, Mode.Slow) == 11
    assert mode_rank(true, Mode.Slow) == 40
    0

fn bucket(big: bool, k: i32) -> i32
    if big
        var n: i32 = 1000
        return n
    match k
        0 => 0
        n => n * 2

[[test]]
fn test_integer_binding_after_a_closed_block_var() -> i32
    assert bucket(false, 21) == 42
    assert bucket(true, 21) == 1000
    0
