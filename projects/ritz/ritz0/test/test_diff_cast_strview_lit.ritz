# AGAST #2131: a string literal cast to StrView (`"..." as StrView`).
#
# A bare "..." lowers to a %Span$u8 aggregate.  A struct-target cast emits
# its operand's register unchanged, but ritz1 could not name the cast's
# struct type, so the Span$u8 -> StrView rebuild at call / store / return
# sites was skipped: `prints("..." as StrView)` emitted
# `call @prints(%StrView <%Span$u8 value>)` and clang rejected the module
# (harland kernel/src/drivers/virtio/blk.ritz).  A bare `prints("...")` was
# always fine.
#
# Oracle: ritz0 runs every case to the same result.

struct Named
    name: StrView
    n: i32

fn view_len(s: StrView) -> i64
    return s.len

fn first_byte(s: StrView) -> u8
    return *s.ptr

fn as_view() -> StrView
    return "fourteen bytes" as StrView

fn as_view_tail() -> StrView
    "seven b" as StrView

# The ticket's repro: a cast literal passed straight to a StrView param.
[[test]]
fn test_cast_lit_call_arg() -> i32
    assert view_len("[virtio-blk] Device " as StrView) == 20
    assert first_byte(" MB)\n" as StrView) == 32
    0

# Typed let initialised from the cast.
[[test]]
fn test_cast_lit_let() -> i32
    let s: StrView = "hello" as StrView
    assert s.len == 5
    assert *s.ptr == 104
    0

# Assignment to an existing StrView var.
[[test]]
fn test_cast_lit_assign() -> i32
    var s: StrView = "a"
    s = "abcd" as StrView
    assert view_len(s) == 4
    0

# Explicit and tail returns from a `-> StrView` fn.
[[test]]
fn test_cast_lit_return() -> i32
    assert view_len(as_view()) == 14
    assert view_len(as_view_tail()) == 7
    0

# A StrView struct field initialised from the cast.
[[test]]
fn test_cast_lit_struct_field() -> i32
    let r: Named = Named { name: "abc" as StrView, n: 1 }
    assert view_len(r.name) == 3
    0

# Casting a value that is already a StrView stays a no-op.
[[test]]
fn test_cast_strview_var() -> i32
    let s: StrView = "xyz"
    assert view_len(s as StrView) == 3
    0
