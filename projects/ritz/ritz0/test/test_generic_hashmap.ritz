# ritzlib's generic HashMap<K: Hash + Eq, V> (AGAST #1858 slice 2, #4306),
# on ritz0, ritz1 and ritz1_selfhosted.  Keys: StrView and i64 (impls in
# hash.ritz) and user structs with their own Hash/Eq.  A key type without
# Hash is refused at the type argument: ritz0/test_generic_hashmap.py.
#
# Each test returns 0, or the number of the failed check.

import ritzlib.hash
import ritzlib.hashmap
import ritzlib.gvec     # Vec<T>, the i64-key test's value type
import ritzlib.option
import ritzlib.strview
import ritzlib.sys

struct Pt
    x: i64
    y: i64

impl Hash for Pt
    pub fn hash(self: @Pt) -> u64
        fnv1a_i64(fnv1a_i64(fnv1a_init(), self.x), self.y)

impl Eq for Pt
    pub fn equals(self: @Pt, other: @Pt) -> bool
        self.x == other.x and self.y == other.y

# Every Bad hashes alike, so each key probes past all the others.
struct Bad
    k: i64

impl Hash for Bad
    pub fn hash(self: @Bad) -> u64
        7

impl Eq for Bad
    pub fn equals(self: @Bad, other: @Bad) -> bool
        self.k == other.k

# The value for k, or d when get says None.
fn get_or<K: Hash + Eq>(m: @HashMap<K, i64>, k: K, d: i64) -> i64
    match m.get(k)
        Some(v) => v
        None => d

fn absent<K: Hash + Eq>(m: @HashMap<K, i64>, k: K) -> bool
    match m.get(k)
        Some(_) => false
        None => true

[[test]]
fn test_hashmap_strview_key() -> i32
    var m: HashMap<StrView, i64> = hashmap_new<StrView, i64>()
    m.insert("one", 1)
    m.insert("two", 2)
    if m.len() != 2
        return 1
    if get_or(@m, "one", -1) != 1 or get_or(@m, "two", -1) != 2
        return 2
    if not absent(@m, "three")
        return 3
    m.insert("one", 11)
    if m.len() != 2 or get_or(@m, "one", -1) != 11
        return 4
    # Equal bytes from another buffer find the same key.
    let s: StrView = "xxtwoxx"
    if get_or(@m, strview_slice(s, 2, 5), -1) != 2
        return 5
    if not m.remove("two") or m.remove("two") or m.contains("two")
        return 6
    if m.len() != 1 or not m.contains("one")
        return 7
    m.free()
    0

[[test]]
fn test_hashmap_struct_key_grow() -> i32
    var m: HashMap<Pt, i64> = hashmap_new<Pt, i64>()
    for i in 0..500
        m.insert(Pt { x: i, y: -i }, i * 3)
    if m.len() != 500
        return 1
    for i in 0..500
        if get_or(@m, Pt { x: i, y: -i }, -1) != i * 3
            return 2
    if m.contains(Pt { x: 1, y: 1 })
        return 3
    m.free()
    0

[[test]]
fn test_hashmap_collision_tomb() -> i32
    var m: HashMap<Bad, i64> = hashmap_new<Bad, i64>()
    for i in 0..10
        m.insert(Bad { k: i }, i + 100)
    if not m.remove(Bad { k: 3 })
        return 1
    if m.contains(Bad { k: 3 })
        return 2
    for i in 4..10
        if get_or(@m, Bad { k: i }, -1) != i + 100
            return 3
    m.insert(Bad { k: 42 }, 7)
    if m.len() != 10 or get_or(@m, Bad { k: 42 }, -1) != 7
        return 4
    for i in 0..10
        m.remove(Bad { k: i })
    if m.len() != 1 or get_or(@m, Bad { k: 42 }, -1) != 7
        return 5
    m.free()
    0

# `impl Hash for i64` / `impl Eq for i64` live in hash.ritz, the trait's file
# (LARB R36 revisit, #4294).  The value is a Vec<u8>, so the slot copies own
# their buffers; the test leaks them rather than track each one, and
# hashmap_drop frees only the slot table.
[[test]]
fn test_hashmap_i64_key_vec_value() -> i32
    var m: HashMap<i64, Vec<u8>> = hashmap_new<i64, Vec<u8>>()
    var a: Vec<u8> = vec_new<u8>()
    vec_push<u8>(@&a, 42 as u8)
    vec_push<u8>(@&a, 43 as u8)
    m.insert(7, a)
    var b: Vec<u8> = vec_new<u8>()
    vec_push<u8>(@&b, 99 as u8)
    m.insert(-5, b)
    if m.len() != 2
        return 1
    if not m.contains(7) or m.contains(8) or not m.contains(-5)
        return 2
    # A move-only V can't come back by value (`hashmap_get` would have to
    # copy it out of the map, which still owns it, AGAST #2159): read it
    # through the map's pointer.
    let vp: *Vec<u8> = m.get_ptr(7)
    if vp == null
        return 4
    if vec_len<u8>(@*vp) != 2 or vec_get<u8>(@*vp, 0) != 42 or vec_get<u8>(@*vp, 1) != 43
        return 3
    let vn: *Vec<u8> = m.get_ptr(-5)
    if vn == null
        return 6
    if vec_len<u8>(@*vn) != 1 or vec_get<u8>(@*vn, 0) != 99
        return 5
    m.insert(7, vec_new<u8>())
    if m.len() != 2
        return 7
    let vz: *Vec<u8> = m.get_ptr(7)
    if vz == null
        return 9
    if vec_len<u8>(@*vz) != 0
        return 8
    m.free()
    0

# Walking the table: hashmap_len / hashmap_cap / hashmap_slot_state /
# hashmap_slot_value (AGAST #4357 gives tome's Store the walk it needs).
# Growth keeps every key reachable, a removed key leaves Tomb (so a probe
# chain through it still finds the keys behind it), and clear empties the
# table without moving it.
[[test]]
fn test_hashmap_slots_walk_and_clear() -> i32
    var m: HashMap<StrView, i64> = hashmap_new<StrView, i64>()
    var keys: [20]u8
    if m.cap() != 16 or m.len() != 0
        return 1
    for i in 0..20
        keys[i] = (65 + i) as u8
        m.insert(strview_from_ptr(@keys[i], 1), i)
    if m.len() != 20 or m.cap() != 32
        return 2

    var seen: i64 = 0
    var sum: i64 = 0
    for i in 0..m.cap()
        if m.slot_state(i) == Slot.Full
            seen += 1
            sum += m.slot_value(i)
    if seen != 20 or sum != 190
        return 3

    if not m.remove(strview_from_ptr(@keys[5], 1))
        return 4
    seen = 0
    var tombs: i64 = 0
    for i in 0..m.cap()
        let st: Slot = m.slot_state(i)
        if st == Slot.Full
            seen += 1
        if st == Slot.Tomb
            tombs += 1
    if seen != 19 or tombs != 1
        return 5
    # The keys behind the removed one are still found through its Tomb.
    if get_or(@m, strview_from_ptr(@keys[19], 1), -1) != 19
        return 6

    m.clear()
    if m.len() != 0 or m.cap() != 32
        return 7
    for i in 0..m.cap()
        if m.slot_state(i) != Slot.Empty
            return 8
    m.insert(strview_from_ptr(@keys[0], 1), 99)
    if m.len() != 1 or get_or(@m, strview_from_ptr(@keys[0], 1), -1) != 99
        return 9
    m.free()
    0
