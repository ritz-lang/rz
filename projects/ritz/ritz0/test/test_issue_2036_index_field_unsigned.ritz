# Regression tests for AGAST #2036 and #2042: reading an unsigned struct
# field (u8/u16/u32) off a base that is not a plain identifier, i.e. an
# indexed array element `a[i].f` or a call result `mk().f`.
#
# ritz0's _infer_unsigned_expr only resolved `ident.field`, so for any other
# base it reported "signed" and widened the extracted field with sext:
# 202u8 read back as -54, 60000u16 as -5536 and 4000000000u32 as negative.
# Every value here sets the field's top bit, so a sign-extending read fails.
# ritz1 and ritz1_selfhosted were already correct; the matrix runs all three.

struct U
    b: u8
    h: u16
    w: u32

struct Outer
    tag: u8
    inner: U

fn mku() -> U
    U { b: 200, h: 60000, w: 4000000000 }

fn mko() -> Outer
    Outer { tag: 250, inner: mku() }

[[test]]
fn test_index_field_u8() -> i32
    var a: [3]U
    a[2].b = 202
    assert a[2].b == 202
    assert a[2].b > 127
    assert a[2].b as i32 == 202
    assert a[2].b as i64 == 202
    let i: i64 = 2
    assert a[i].b == 202
    0

[[test]]
fn test_index_field_u16() -> i32
    var a: [3]U
    a[1].h = 60000
    assert a[1].h == 60000
    assert a[1].h > 32767
    assert a[1].h as i32 == 60000
    assert a[1].h as i64 == 60000
    0

[[test]]
fn test_index_field_u32() -> i32
    var a: [3]U
    a[0].w = 4000000000
    assert a[0].w == 4000000000
    assert a[0].w > 2147483647
    assert a[0].w as i64 == 4000000000
    0

[[test]]
fn test_index_nested_field_unsigned() -> i32
    var a: [2]Outer
    a[1].tag = 250
    a[1].inner.b = 201
    a[1].inner.h = 50000
    assert a[1].tag == 250
    assert a[1].inner.b == 201
    assert a[1].inner.h as i64 == 50000
    0

[[test]]
fn test_call_result_field_unsigned() -> i32
    assert mku().b == 200
    assert mku().b as i64 == 200
    assert mku().h == 60000
    assert mku().w as i64 == 4000000000
    assert mko().tag == 250
    assert mko().inner.b == 200
    0
