# AGAST #1611 — `trait` declarations (LANGUAGE_SPEC §12).
#
# ritz1 had a TRAIT token but no production for it, so every file declaring a
# trait failed to parse.  Traits are structural (§12.2): methods resolve
# statically from the receiver's concrete type, so a declaration adds nothing
# to codegen — but it must parse in every form the corpus uses, and it must
# not disturb the items around it.

struct Counter
    n: i64

struct Pair
    a: i64
    b: i64

# Typed `*Self` receivers, several methods, a comment and a blank line inside.
trait Measure
    # how big is it
    fn size(self: *Self) -> i64

    fn twice(self: *Self) -> i64

# `pub`, bare `self`, `self:&`, extra params, no return type, `-> Self`.
pub trait Handler
    fn peek(self) -> i64
    fn bump(self:&, by: i64)
    fn reset(self:&)
    fn copy(self: *Self) -> Self

impl Measure for Counter
    fn size(self: *Counter) -> i64
        return self.n

    fn twice(self: *Counter) -> i64
        return self.n * 2

impl Measure for Pair
    fn size(self: *Pair) -> i64
        return self.a + self.b

    fn twice(self: *Pair) -> i64
        return (self.a + self.b) * 2

# A trait declared after the impls that use it, followed directly by a fn:
# the item after a trait must still parse and be emitted.
trait Late
    fn late(self: *Self) -> i64
fn after_trait() -> i64
    return 7

[[test]]
fn test_trait_impl_dispatch() -> i32
    let c: Counter = Counter { n: 5 }
    let p: Pair = Pair { a: 3, b: 4 }
    assert c.size() == 5
    assert c.twice() == 10
    assert p.size() == 7
    assert p.twice() == 14
    0

[[test]]
fn test_item_after_trait() -> i32
    assert after_trait() == 7
    0
