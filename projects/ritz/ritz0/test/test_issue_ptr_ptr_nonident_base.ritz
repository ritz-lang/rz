# Regression (AGAST #1924, #1944): `*(*(x + i) + k)`, `**x` and `*x + k`
# where x is a `**T` that is NOT a plain local/param/global name, or is
# three pointer levels deep.  #1815 / #1941 taught ritz1 the identifier
# cases only; these shapes still loaded i64 (clobbering neighbours on store)
# or stepped one byte instead of one element.  ritz0 is the oracle.
#
# Widths are chosen so a wrong answer is visible: i32 / u8 neighbours sit
# next to the slot under test, and a 24-byte struct makes a 1-byte or
# 8-byte stride land in the wrong element.

struct Cell
    v: i64
    arr: [2]i64

# --- 1. a `**T` struct FIELD ------------------------------------------------

struct Rows
    tag: i64
    rows: **i32

struct Names
    names: **u8
    count: i64

fn rows_get(h: *Rows, i: i64, k: i64) -> i32
    return *(*(h.rows + i) + k)

fn rows_set(h: *Rows, i: i64, k: i64, v: i32)
    *(*(h.rows + i) + k) = v

[[test]]
fn test_field_pp_i32_read_write() -> i32
    var r0: [4]i32 = [1, 2, 3, 4]
    var r1: [4]i32 = [5, 6, 7, 8]
    var buf: [2]*i32 = [@r0[0], @r1[0]]
    var h: Rows = Rows { tag: 0, rows: @buf[0] }
    assert rows_get(@h, 0, 2) == 3
    assert rows_get(@h, 1, 3) == 8
    assert *(*(h.rows + 1) + 1) == 6
    rows_set(@h, 1, 2, 70)
    assert r1[2] == 70
    assert r1[1] == 6
    assert r1[3] == 8
    *(*(h.rows + 0) + 1) = 20
    assert r0[1] == 20
    assert r0[2] == 3
    0

[[test]]
fn test_field_pp_i32_double_deref() -> i32
    var r0: [2]i32 = [1, 2]
    var buf: [1]*i32 = [@r0[0]]
    var h: Rows = Rows { tag: 0, rows: @buf[0] }
    assert **h.rows == 1
    **h.rows = -7
    assert r0[0] == -7
    assert r0[1] == 2
    0

# `*h.rows + k` strides sizeof(i32).
[[test]]
fn test_field_pp_i32_deref_plus() -> i32
    var r0: [4]i32 = [1, 2, 3, 4]
    var buf: [1]*i32 = [@r0[0]]
    var h: Rows = Rows { tag: 0, rows: @buf[0] }
    let p: *i32 = *h.rows + 3
    assert *p == 4
    0

fn name_byte(t: *Names, i: i64, k: i64) -> u8
    return *(*(t.names + i) + k)

[[test]]
fn test_field_pp_u8_name_table() -> i32
    var buf: [2]*u8 = [c"abc", c"xyz"]
    var t: Names = Names { names: @buf[0], count: 2 }
    assert name_byte(@t, 0, 1) == 98
    assert name_byte(@t, 1, 2) == 122
    assert *(*(t.names + 1) + 0) == 120
    0

# A `**Cell` field: `*(t.cells + i) + k` strides sizeof(Cell).
struct CellTab
    cells: **Cell

fn cell_tab_v(t: *CellTab, i: i64, k: i64) -> i64
    let e: *Cell = *(t.cells + i) + k
    return e.v

[[test]]
fn test_field_pp_struct_stride() -> i32
    var cells: [2]Cell
    cells[0].v = 60
    cells[1].v = 61
    var ptrs: [2]*Cell = [@cells[0], @cells[0]]
    var t: CellTab = CellTab { cells: @ptrs[0] }
    assert cell_tab_v(@t, 1, 1) == 61
    assert cell_tab_v(@t, 0, 0) == 60
    let n: *Cell = *t.cells + 1
    assert n.v == 61
    0

# --- 2. `**Struct`: struct-valued `*(*(pp + i) + k)` -------------------------

fn cell_v_pp(pp: **Cell, i: i64, k: i64) -> i64
    return (*(*(pp + i) + k)).v

[[test]]
fn test_pp_struct_nested_deref_member() -> i32
    var cells: [2]Cell
    cells[0].v = 70
    cells[1].v = 71
    var ptrs: [2]*Cell = [@cells[0], @cells[0]]
    assert cell_v_pp(@ptrs[0], 1, 1) == 71
    assert cell_v_pp(@ptrs[0], 0, 0) == 70
    0

# --- 3. `***T` ----------------------------------------------------------------

fn ppp_get(ppp: ***i32, i: i64, j: i64, k: i64) -> i32
    return *(*(*(ppp + i) + j) + k)

[[test]]
fn test_ppp_i32_triple_index() -> i32
    var r0: [3]i32 = [1, 2, 3]
    var r1: [3]i32 = [4, 5, 6]
    var mid: [2]*i32 = [@r0[0], @r1[0]]
    var top: [1]**i32 = [@mid[0]]
    let ppp: ***i32 = @top[0]
    # `*(ppp + 0) + 1` strides one *i32 (8 bytes)
    assert ppp_get(ppp, 0, 1, 2) == 6
    assert ppp_get(ppp, 0, 0, 1) == 2
    assert *(*(*ppp + 1) + 0) == 4
    assert ***ppp == 1
    0

# AGAST #1944: `*ppp + 1` with `ppp: ***S` strides one `*S` (8 bytes).
fn ppp_second(ppp: ***Cell) -> i64
    let pp: **Cell = *ppp + 1
    return (**pp).v

[[test]]
fn test_ppp_struct_deref_plus() -> i32
    var a: Cell = Cell { v: 80, arr: [0, 0] }
    var b: Cell = Cell { v: 81, arr: [0, 0] }
    var mid: [2]*Cell = [@a, @b]
    var pmid: **Cell = @mid[0]
    assert ppp_second(@pmid) == 81
    0

# --- 4. monomorphised `**T` params ---------------------------------------------

fn pp_get_t<T>(pp: **T, i: i64, k: i64) -> T
    return *(*(pp + i) + k)

[[test]]
fn test_generic_pp_i32() -> i32
    var r0: [4]i32 = [1, 2, 3, 4]
    var r1: [4]i32 = [5, 6, 7, 8]
    var buf: [2]*i32 = [@r0[0], @r1[0]]
    assert pp_get_t<i32>(@buf[0], 1, 2) == 7
    assert pp_get_t<i32>(@buf[0], 0, 3) == 4
    0

# A `let pp: **T` LOCAL inside the generic: its inner pointee is T too.
fn pp_local_get_t<T>(q: **T, i: i64, k: i64) -> T
    let pp: **T = q
    return *(*(pp + i) + k)

[[test]]
fn test_generic_local_pp_i32() -> i32
    var r0: [4]i32 = [1, 2, 3, 4]
    var r1: [4]i32 = [5, 6, 7, 8]
    var buf: [2]*i32 = [@r0[0], @r1[0]]
    assert pp_local_get_t<i32>(@buf[0], 1, 3) == 8
    assert pp_local_get_t<i32>(@buf[0], 0, 1) == 2
    0

[[test]]
fn test_generic_pp_u8() -> i32
    var buf: [2]*u8 = [c"abc", c"xyz"]
    assert pp_get_t<u8>(@buf[0], 1, 1) == 121
    0

# --- 5. AGAST #1944: a global `**S` --------------------------------------------

var g_pp_cell: **Cell = null

[[test]]
fn test_global_pp_struct_deref_plus() -> i32
    var cells: [2]Cell
    cells[0].v = 90
    cells[1].v = 91
    var pc: *Cell = @cells[0]
    g_pp_cell = @pc
    let n: *Cell = *g_pp_cell + 1
    assert n.v == 91
    0
