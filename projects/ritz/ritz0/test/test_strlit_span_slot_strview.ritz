# AGAST #3353: a "..." literal in a Span<u8> slot, with StrView registered.
#
# The companion of test_strlit_span_slot_no_import.ritz: the same cases, with
# `import ritzlib.strview` in scope. ritz0 used to type the literal as
# `%StrView` once the struct was registered and then refused it at every
# Span<u8> slot ("`s` is declared `Span$u8` but its initialiser is a
# `StrView`"); what is registered must not change the answer. Whether the
# rule stands is LARB's call (#3402).
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted.

import ritzlib.strview

struct Holder
    s: Span<u8>

fn span_len(s: Span<u8>) -> i64
    s.len

fn give_return() -> Span<u8>
    return "abcd"

fn give_tail(short: bool) -> Span<u8>
    if short
        "ab"
    else
        "abcdef"

[[test]]
fn test_strlit_span_let() -> i32
    let s: Span<u8> = "hello"
    assert s.len == 5
    assert s[0] == 'h'
    assert s[4] == 'o'
    0

[[test]]
fn test_strlit_span_var_and_assign() -> i32
    var s: Span<u8> = "hi"
    assert s.len == 2
    s = "xyz"
    assert s.len == 3
    assert s[2] == 'z'
    0

[[test]]
fn test_strlit_span_arg() -> i32
    assert span_len("four") == 4
    0

[[test]]
fn test_strlit_span_return_and_tail() -> i32
    assert give_return().len == 4
    assert give_tail(true).len == 2
    assert give_tail(false)[5] == 'f'
    0

[[test]]
fn test_strlit_span_field() -> i32
    let h = Holder { s: "abc" }
    assert h.s.len == 3
    assert h.s[1] == 'b'
    0

[[test]]
fn test_strlit_span_empty() -> i32
    let s: Span<u8> = ""
    assert s.len == 0
    0

[[test]]
fn test_strlit_span_element() -> i32
    let a: [2]Span<u8> = ["a", "bcd"]
    assert a[0].len == 1
    let b: Span<u8> = a[1]
    assert b[2] == 'd'
    0
