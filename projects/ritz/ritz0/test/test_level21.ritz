# Test level 21: Buffer utilities for parsing
#
# Tests ritzlib/buf.ritz functionality

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.buf

# ============================================================================
# Test: Buffer initialization
# ============================================================================

[[test]]
fn test_buf_init() -> i32
    var buf: Buffer
    let data: *u8 = c"hello world"
    buf.init(Span<u8> { ptr: data, len: 11 })

    assert buf.pos == 0, "initial pos should be 0"
    assert buf.len == 11, "len should be 11"
    assert not buf.eof(), "should not be at EOF"
    return 0

[[test]]
fn test_buf_from_str() -> i32
    var buf: Buffer
    buf.from_str("test")

    assert buf.len == 4, "len should be 4"
    assert buf.remaining() == 4, "remaining should be 4"
    return 0

# ============================================================================
# Test: Peek operations
# ============================================================================

[[test]]
fn test_buf_peek() -> i32
    var buf: Buffer
    buf.from_str("abc")

    assert buf.peek() == 97, "peek should return 'a'"
    assert buf.peek_at(0) == 97, "peek_at(0) should return 'a'"
    assert buf.peek_at(1) == 98, "peek_at(1) should return 'b'"
    assert buf.peek_at(2) == 99, "peek_at(2) should return 'c'"
    assert buf.peek_at(3) == 0, "peek_at(3) should return 0 (past end)"
    return 0

# ============================================================================
# Test: Advance operations
# ============================================================================

[[test]]
fn test_buf_advance() -> i32
    var buf: Buffer
    buf.from_str("xyz")

    assert buf.advance() == 120, "first advance should return 'x'"
    assert buf.advance() == 121, "second advance should return 'y'"
    assert buf.advance() == 122, "third advance should return 'z'"
    assert buf.advance() == 0, "fourth advance should return 0 (EOF)"
    assert buf.eof(), "should be at EOF"
    return 0

[[test]]
fn test_buf_skip() -> i32
    var buf: Buffer
    buf.from_str("hello world")

    buf.skip(6)
    assert buf.peek() == 119, "after skip 6, peek should be 'w'"
    return 0

# ============================================================================
# Test: Pattern matching
# ============================================================================

[[test]]
fn test_buf_match_char() -> i32
    var buf: Buffer
    buf.from_str("abc")

    assert buf.match_char(97), "match 'a' should succeed"
    assert buf.peek() == 98, "after match, should be at 'b'"
    assert not buf.match_char(99), "match 'c' should fail (at 'b')"
    assert buf.peek() == 98, "position should not change on failed match"
    return 0

[[test]]
fn test_buf_match_str() -> i32
    var buf: Buffer
    buf.from_str("hello world")

    assert buf.match_str("hello"), "match 'hello' should succeed"
    assert buf.peek() == 32, "after match, should be at space"
    buf.advance()
    assert buf.match_str("world"), "match 'world' should succeed"
    return 0

# ============================================================================
# Test: Skip utilities
# ============================================================================

[[test]]
fn test_buf_skip_whitespace() -> i32
    var buf: Buffer
    buf.from_str("   hello")

    let skipped: i64 = buf.skip_whitespace()
    assert skipped == 3, "should skip 3 spaces"
    assert buf.peek() == 104, "should be at 'h'"
    return 0

[[test]]
fn test_buf_skip_until() -> i32
    var buf: Buffer
    buf.from_str("abc:def")

    let skipped: i64 = buf.skip_until(58)  # ':'
    assert skipped == 3, "should skip 3 chars before ':'"
    assert buf.peek() == 58, "should be at ':'"
    return 0

# ============================================================================
# Test: Read utilities
# ============================================================================

[[test]]
fn test_buf_read_until() -> i32
    var buf: Buffer
    buf.from_str("key=value")

    var out: [32]u8
    let len: i64 = buf.read_until(61, Span<u8> { ptr: @out[0], len: 32 })  # '='
    assert len == 3, "should read 3 chars"
    assert streq(@out[0], c"key"), "should read 'key'"
    return 0

[[test]]
fn test_buf_read_while_digit() -> i32
    var buf: Buffer
    buf.from_str("12345abc")

    var out: [32]u8
    let len: i64 = buf.read_while_digit(Span<u8> { ptr: @out[0], len: 32 })
    assert len == 5, "should read 5 digits"
    assert streq(@out[0], c"12345"), "should read '12345'"
    assert buf.peek() == 97, "should be at 'a'"
    return 0

[[test]]
fn test_buf_read_while_alnum() -> i32
    var buf: Buffer
    buf.from_str("abc_123 end")

    var out: [32]u8
    let len: i64 = buf.read_while_alnum(Span<u8> { ptr: @out[0], len: 32 })
    assert len == 7, "should read 7 chars"
    assert streq(@out[0], c"abc_123"), "should read 'abc_123'"
    return 0

# ============================================================================
# Test: Save/restore (backtracking)
# ============================================================================

[[test]]
fn test_buf_save_restore() -> i32
    var buf: Buffer
    buf.from_str("abcdef")

    buf.advance()
    buf.advance()
    let saved: i64 = buf.save()
    assert buf.peek() == 99, "should be at 'c'"

    buf.advance()
    buf.advance()
    assert buf.peek() == 101, "should be at 'e'"

    buf.restore(saved)
    assert buf.peek() == 99, "after restore, should be at 'c'"
    return 0

# ============================================================================
# Test: Location tracking
# ============================================================================

[[test]]
fn test_buf_get_loc() -> i32
    var buf: Buffer
    buf.from_str("line1\nline2\nline3")

    # Move to start of line 2
    buf.skip_until(10)  # Skip to newline
    buf.advance()         # Skip the newline

    var loc: BufLoc
    buf.get_loc(@&loc)
    assert loc.line == 2, "should be on line 2"
    assert loc.col == 1, "should be at column 1"
    return 0
