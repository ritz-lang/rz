# AGAST #3586: a store to an element of an array field of a cast to a
# reference or pointer, `(p as @&Holder).arr[i] = v` and
# `(p as *Holder).arr[i] = v` with `p: *Holder`.
#
# THE DEFECT (ritz0)
#
# ritz0 refused both with "Cannot get address of: <class 'ritz_ast.Cast'>":
# _emit_lvalue_addr had no Cast arm, so the field's base (the cast) had no
# place.  A cast to a pointer or reference IS the struct's address.  ritz1
# accepted it once #3443 resolved the cast base via emit_member_ptr.
#
# Every struct has its array second, so a GEP at the wrong offset writes
# `pad`, not `arr`.
#
# Oracle: same exit code under ritz0, ritz1 and ritz1_selfhosted.

struct Holder
    pad: i64
    arr: [4]i32

fn put_ref(p: *Holder, i: i64, v: i32)
    (p as @&Holder).arr[i] = v

fn put_ptr(p: *Holder, i: i64, v: i32)
    (p as *Holder).arr[i] = v

fn bump_ref(p: *Holder, i: i64)
    (p as @&Holder).arr[i] += 5

[[test]]
fn test_cast_mut_ref_member_index_store() -> i32
    var h: Holder = Holder { pad: 3, arr: [1, 2, 3, 4] }
    put_ref(@&h, 2, 9)
    assert h.arr[2] == 9
    bump_ref(@&h, 2)
    assert h.arr[2] == 14
    assert h.arr[1] == 2
    assert h.arr[3] == 4
    assert h.pad == 3
    0

[[test]]
fn test_cast_ptr_member_index_store() -> i32
    var h: Holder = Holder { pad: 3, arr: [1, 2, 3, 4] }
    put_ptr(@&h, 1, 7)
    assert h.arr[1] == 7
    assert h.arr[0] == 1
    assert h.arr[2] == 3
    assert h.pad == 3
    0
