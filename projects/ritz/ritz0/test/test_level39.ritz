# Test: fn values in place of closures (LARB R56, LANGUAGE_SPEC §5.5, §5.6)
# Issue: ritz-lang/ritz#121
#
# Closures and anonymous `fn(...) e` are gone; ritz0/test_closures_refused.py
# pins their refusal.  Each case here used to be one, and is now a named fn
# passed by name.

fn double(x: i32) -> i32
    x * 2

fn add(a: i32, b: i32) -> i32
    a + b

fn inc(x: i32) -> i32
    x + 1

fn dec(x: i32) -> i32
    x - 1

fn is_positive(x: i32) -> bool
    x > 0

# A named fn bound to a fn-typed local
[[test]]
fn test_fn_value_local() -> i32
    let f: fn(i32) -> i32 = double
    if f(5) != 10
        return 1
    if f(0) != 0
        return 2
    return 0

# Two params
[[test]]
fn test_fn_value_two_params() -> i32
    let g: fn(i32, i32) -> i32 = add
    if g(3, 4) != 7
        return 1
    return 0

# A named fn passed as an argument
fn apply(f: fn(i32) -> i32, x: i32) -> i32
    return f(x)

[[test]]
fn test_fn_value_as_arg() -> i32
    if apply(double, 21) != 42
        return 1
    return 0

# Several fn values
[[test]]
fn test_multiple_fn_values() -> i32
    let i: fn(i32) -> i32 = inc
    let d: fn(i32) -> i32 = dec
    if i(5) != 6
        return 1
    if d(5) != 4
        return 2
    return 0

# A bool-returning fn value
[[test]]
fn test_fn_value_bool() -> i32
    let p: fn(i32) -> bool = is_positive
    if p(5) == false
        return 1
    if p(-5) == true
        return 2
    if p(0) == true
        return 3
    return 0

fn main() -> i32
    return 0
