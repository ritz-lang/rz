# Regression: a `usize` struct field is 64 bits wide, like a `usize` anywhere
# else (test_issue_usize_width.ritz). ritz0 laid it out as one byte, which cut
# a Reader's position down to its low 8 bits.
#
# AGAST #2198: ritz1 parsed `usize` / `isize` as a TYPE_STRUCT named "usize",
# so every path that branches on the type code took its struct arm and wrote
# `store %usize` / `load %usize` / `[4 x %usize]`, which clang rejects.  Each
# test below reaches one of those paths; every value needs more than 32 bits.

struct Cursor
    pos: usize

struct Signed
    off: isize
    tag: i32

[[test]]
fn test_usize_struct_field() -> i32
    var c: Cursor = Cursor { pos: 0 }
    c.pos = 70000 as usize
    assert c.pos as i64 == 70000
    assert sizeof(Cursor) == 8
    0

# A struct literal's field store, and an isize field ahead of a narrower one.
[[test]]
fn test_isize_struct_field() -> i32
    let big: i64 = 0 - 5000000000
    let s: Signed = Signed { off: big as isize, tag: 7 }
    assert s.off as i64 == 0 - 5000000000
    assert s.tag == 7
    assert sizeof(Signed) == 16
    0

# A field read and written through a pointer to the struct.
[[test]]
fn test_usize_field_through_pointer() -> i32
    var c: Cursor = Cursor { pos: 1 }
    let p: *Cursor = @c
    p.pos = 5000000000 as usize
    assert c.pos as i64 == 5000000000
    0

# A `*usize` pointee load and store.
[[test]]
fn test_usize_pointee() -> i32
    var n: usize = 0 as usize
    let p: *usize = @n
    *p = 5000000000 as usize
    assert *p as i64 == 5000000000
    0

# An array of usize: an element store and load.
[[test]]
fn test_usize_array_element() -> i32
    var a: [4]usize
    a[2] = 5000000000 as usize
    let got: usize = a[2]
    assert got as i64 == 5000000000
    0
