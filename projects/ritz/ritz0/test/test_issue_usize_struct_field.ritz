# Regression: a `usize` struct field is 64 bits wide, like a `usize` anywhere
# else (test_issue_usize_width.ritz). ritz0 laid it out as one byte, which cut
# a Reader's position down to its low 8 bits.

struct Cursor
    pos: usize

[[test]]
fn test_usize_struct_field() -> i32
    var c: Cursor = Cursor { pos: 0 }
    c.pos = 70000 as usize
    assert c.pos as i64 == 70000
    assert sizeof(Cursor) == 8
    0
