# Tests for unsafe blocks
# Unsafe blocks allow raw pointer operations

import ritzlib.sys

# ============================================================================
# Basic unsafe block tests
# ============================================================================

[[test]]
fn test_unsafe_block_basic() -> i32
    # Unsafe block allows raw pointer operations
    var x: i32 = 42
    unsafe
        let ptr: *i32 = @x
        let val: i32 = *ptr
        assert val == 42
    0

[[test]]
fn test_unsafe_block_write() -> i32
    # Unsafe block can write through pointers
    var x: i32 = 0
    unsafe
        let ptr: *i32 = @x
        *ptr = 99
    assert x == 99
    0

[[test]]
fn test_unsafe_nested() -> i32
    # Nested unsafe blocks (outer unsafe is sufficient)
    var x: i32 = 10
    unsafe
        let ptr: *i32 = @x
        unsafe
            *ptr = 20
        assert *ptr == 20
    assert x == 20
    0

[[test]]
fn test_unsafe_with_control_flow() -> i32
    # Unsafe blocks with control flow
    var sum: i32 = 0
    var arr: [3]i32 = [1, 2, 3]

    unsafe
        let ptr: *i32 = @arr[0]
        var i: i32 = 0
        while i < 3
            # Pointer arithmetic in unsafe
            sum += *(ptr + i)
            i += 1

    assert sum == 6
    0

# ============================================================================
# Unsafe with functions
# ============================================================================

fn unsafe_helper(ptr: *i32)
    # This function body is implicitly safe
    # We can receive pointers as params, just can't deref without unsafe
    unsafe
        *ptr = 123

[[test]]
fn test_unsafe_in_function() -> i32
    var x: i32 = 0
    unsafe_helper(@x)
    assert x == 123
    0

fn bump(ptr: *i32)
    *ptr = *ptr + 1

[[test]]
fn test_unsafe_trailing_call_runs() -> i32
    # The body's last line is a bare call: ritz0 used to drop it (AGAST #2248)
    var x: i32 = 0
    unsafe
        bump(@x)
    assert x == 1
    0

fn same<T>(v: T) -> T
    v

# Called only from inside an `unsafe` block, so nothing else instantiates it.
fn pick<T>(v: T) -> T
    v

fn store_same<T>(ptr: *T, v: T)
    unsafe
        *ptr = same<T>(v)

[[test]]
fn test_unsafe_generic_calls_are_instantiated() -> i32
    # A generic called only inside `unsafe` (T inferred, then instantiated),
    # and a generic whose body is one
    var x: i64 = 0
    unsafe
        x = pick(x + 5)    # T inferred
    store_same<i64>(@x, x + 2)
    assert x == 7
    0

struct Cell<T>
    val: T

# Cell<T> is named only inside the specialised body's `unsafe` block.
fn cell_round<T>(x: T) -> T
    var r: T = x
    unsafe
        var c: Cell<T>
        c.val = x
        r = c.val
    r

[[test]]
fn test_unsafe_bindings_are_declared() -> i32
    # Types and tuples first seen inside an `unsafe` block are still laid out
    var x: i64 = 0
    unsafe
        let o: Option<u16> = Some(4 as u16)
        let (a, b) = (1, 2)
        match o
            Some(n) => x = n as i64 + a + b
            None => x = 0
    assert x == 7
    assert cell_round<u16>(9 as u16) == 9 as u16
    0
