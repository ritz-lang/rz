# Regression: `usize` and `isize` are 64 bits wide.
#
# ritz0's primitive type table had no entry for them, so they fell through to
# the opaque `i8` placeholder: `n as usize` kept only the low byte, and a loop
# bounded by it ran 8192 & 0xFF = 0 times.

fn count_to(n: i64) -> i64
    var total: i64 = 0
    for i in 0..n as usize
        total = total + 1
    total

fn widen(n: i64) -> i64
    let m = n as usize
    m as i64

fn widen_signed(n: i64) -> i64
    let m = n as isize
    m as i64

[[test]]
fn test_usize_cast_keeps_all_bits() -> i32
    assert widen(300) == 300
    assert widen(8192) == 8192
    assert widen(5000000000) == 5000000000
    0

[[test]]
fn test_isize_cast_keeps_sign_and_bits() -> i32
    assert widen_signed(300) == 300
    assert widen_signed(-300) == -300
    assert widen_signed(5000000000) == 5000000000
    0

[[test]]
fn test_usize_annotated_local_needs_no_cast() -> i32
    let n: i64 = 300
    let m: usize = n
    assert m as i64 == 300
    0

[[test]]
fn test_usize_range_bound() -> i32
    assert count_to(300) == 300
    assert count_to(8192) == 8192
    0
