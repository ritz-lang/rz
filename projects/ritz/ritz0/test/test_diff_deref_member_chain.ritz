# Regression tests for AGAST #1673: `*(a.b.c.ptr + i)` through a 2+-level
# member chain under ritz1.
#
# ritz1 resolved the pointee type of `*(ptr + i)` for a one-level chain
# (`s.value.ptr`) but not for deeper ones (`o.inner.name.ptr`): it emitted
# `load i64` (an 8-byte read of a u8), so the compare failed at runtime.
#
# Each program returns 42 when correct and a distinct small code naming the
# check that failed otherwise. ritz0 is the oracle; everything is checked at
# RUNTIME, because the bad load compiles cleanly and only gives a wrong answer.
#
# Migrated from ritz0/test_ritz1_deref_member_chain.py by AGAST #1805: each case was a pure
# ritz0-vs-ritz1 differential (same exit code under both), so it is a
# test fn here and the regression matrix runs it under ritz0, ritz1
# and ritz1_selfhosted.  Each case's `main` is renamed `<case>_main`;
# top-level names shared between cases carry a `_<n>` suffix.

import ritzlib.strview

# --- i32_pointee -----------------------------------------------------------

struct Buf
    n: i64
    p: *i32

struct Mid
    t: i32
    buf: Buf

struct Top
    z: i64
    mid: Mid

fn i32_pointee_main() -> i32
    var arr: [4]i32 = [10, 20, 30, 40]
    let m = Mid { t: 1, buf: Buf { n: 4, p: @arr[0] } }
    if *(m.buf.p + 1) != 20
        return 2
    let t = Top { z: 7, mid: m }
    if *(t.mid.buf.p + 2) != 30
        return 3
    if *(t.mid.buf.p + 3) + 2 != 42
        return 4
    return 42

[[test]]
fn test_i32_pointee() -> i32
    assert i32_pointee_main() == 42
    0


# --- three_level_u8 --------------------------------------------------------

struct C
    tag: i32
    name: StrView

struct B
    x: i64
    c: C

struct A
    y: i32
    b: B

fn three_level_u8_main() -> i32
    let a = A { y: 1, b: B { x: 2, c: C { tag: 3, name: "abc" } } }
    if *(a.b.c.name.ptr + 0) != 97
        return 2
    if *(a.b.c.name.ptr + 1) != 98
        return 3
    return 42

[[test]]
fn test_three_level_u8() -> i32
    assert three_level_u8_main() == 42
    0


# --- two_level_u8 ----------------------------------------------------------

struct Inner
    tag: i32
    name: StrView

struct Outer
    k: i64
    inner: Inner

fn two_level_u8_main() -> i32
    let i0 = Inner { tag: 5, name: "xyz" }
    let o = Outer { k: 9, inner: i0 }
    if *(o.inner.name.ptr + 1) != 121
        return 2
    if *(o.inner.name.ptr + 2) != 122
        return 3
    return 42

[[test]]
fn test_two_level_u8() -> i32
    assert two_level_u8_main() == 42
    0
