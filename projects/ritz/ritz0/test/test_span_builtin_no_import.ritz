# AGAST #3346: Span<T> is a built-in type, so its struct literal works in a
# file that imports nothing.
#
# ritz0 built `Span$u8` on demand for a `Span<u8>` parameter or variable, but
# a `Span<u8> { ptr, len }` literal looked its struct up by the bare name
# `Span`, which only `import ritzlib.span` (through the monomorphizer)
# provides.  With no import, it raised a Python ValueError ("Unknown struct:
# Span").  ritz1 compiled it.  This file must stay import-free or it stops
# testing the bug; test_span_builtin_imported.ritz is the same cases with the
# import.
#
# The matrix runs this file under ritz0, ritz1 and ritz1_selfhosted.

fn span_sum(s: Span<u8>) -> i64
    var total: i64 = 0
    for i in 0..s.len
        total = total + (s[i] as i64)
    total

[[test]]
fn test_span_literal_let() -> i32
    var a: [3]u8 = [1, 2, 3]
    let s: Span<u8> = Span<u8> { ptr: @a[0], len: 3 }
    let n: i64 = s.len
    assert n == 3
    assert s[2] == 3
    0

[[test]]
fn test_span_literal_param() -> i32
    var a: [3]u8 = [1, 2, 3]
    assert span_sum(Span<u8> { ptr: @a[1], len: 2 }) == 5
    0
