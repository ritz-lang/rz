# AGAST #2131: an untyped let initialised from a struct cast
# (`let s = "..." as StrView`).
#
# A struct-target cast emits its operand's register unchanged, so the local
# takes the operand's struct type, exactly as `let s = "..."` does.  ritz1
# left the local at the default i64 and emitted `store i64 <%Span$u8 value>`.
# The typed / call / return / field forms are in test_diff_cast_strview_lit.
#
# Oracle: ritz0 runs every case to the same result.

fn view_len(s: StrView) -> i64
    return s.len

[[test]]
fn test_cast_lit_let_inferred() -> i32
    let s = "hello" as StrView
    assert view_len(s) == 5
    assert s.len == 5
    assert *s.ptr == 104
    0

# A cast of a typed StrView local: the new local is a StrView too.
[[test]]
fn test_cast_strview_local_let_inferred() -> i32
    let a: StrView = "abc"
    let b = a as StrView
    assert view_len(b) == 3
    0
