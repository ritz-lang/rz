# Regression: enum match phi should handle pass/undefined arms.
#
# `pass` has no value, so it cannot be the value of a fn that declares a
# return type (AGAST #1429). The match is a statement here.
import ritzlib.result

fn maybe(flag: bool) -> Result<i32, i32>
    if flag
        Ok(1)
    else
        Err(0)

fn use_match(flag: bool) -> i32
    let r = maybe(flag)
    var out: i32 = 0
    match r
        Ok(v) => out = v
        Err(_) => pass
    out

[[test]]
fn test_match_pass_arm() -> i32
    if use_match(true) == 1 and use_match(false) == 0
        0
    else
        1
