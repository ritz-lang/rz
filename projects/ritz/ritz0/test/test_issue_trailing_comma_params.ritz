# AGAST #1452 — trailing comma in fn parameter lists.
#
# ritz0 accepts `fn f(a: i64, b: i64,)` and `f(1, 2,)`; ritz1's `params` and
# `args` productions had no trailing-comma alternative, so any file using the
# multi-line, one-item-per-line style (ritzlib/testlib.ritz exec_capture,
# imported by 47 examples) failed to parse under ritz1.  Params and args are
# split into separate files so each grammar alternative has its own test.

# Single-line params with a trailing comma.
fn add2(a: i64, b: i64,) -> i64
    return a + b

# A single param with a trailing comma.
fn one(a: i64,) -> i64
    return a + 1

# The testlib.ritz shape: one param per line, trailing comma before `)`.
fn add3(
    a: i64,
    b: i64,
    c: i64,
) -> i64
    return a + b + c

# Extern decls share `params`.
extern fn strlen(s: *u8,) -> i64

[[test]]
fn test_trailing_comma_params() -> i32
    assert add2(2, 3) == 5
    assert one(41) == 42
    assert add3(1, 2, 3) == 6
    0

[[test]]
fn test_trailing_comma_extern_params() -> i32
    assert strlen(c"abc") == 3
    0
