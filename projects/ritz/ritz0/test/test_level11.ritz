# Test Level 11: File I/O operations
#
# Features tested:
# - open/close syscalls
# - read/write syscalls
# - File creation and deletion
# - Buffer manipulation
#
# Note: These tests use /tmp for temporary files. Every path is built by
# l11_tmp_path, never written as a literal: the regression matrix runs this
# file under ritz0, ritz1 and ritz1_selfhosted concurrently (and other rooms
# gate on the same host), so a shared fixed path let one run's O_TRUNC land
# between another's write and read-back (AGAST #1735).

# Syscall wrappers - prefixed to avoid conflict with sys.ritz
fn l11_read(fd: i32, buf: *i8, count: i64) -> i64
  syscall3(0, fd, buf, count)

fn l11_write(fd: i32, buf: *i8, count: i64) -> i64
  syscall3(1, fd, buf, count)

fn l11_open(path: *i8, flags: i32, mode: i32) -> i32
  let result: i64 = syscall3(2, path, flags, mode)
  result as i32

fn l11_close(fd: i32) -> i32
  let result: i64 = syscall1(3, fd)
  result as i32

fn l11_unlink(path: *i8) -> i32
  let result: i64 = syscall1(87, path)
  result as i32

# Constants
const O_RDONLY: i32 = 0
const O_WRONLY: i32 = 1
const O_RDWR: i32 = 2
const O_CREAT: i32 = 64
const O_TRUNC: i32 = 512

# String length - prefixed to avoid conflict with str.ritz
fn l11_strlen(s: *i8) -> i64
  var len: i64 = 0
  while *(s + len) != 0
    len = len + 1
  len

# Compare strings (first n bytes)
fn strncmp(a: *i8, b: *i8, n: i64) -> i32
  var i: i64 = 0
  while i < n
    let ca: i32 = *(a + i) as i32
    let cb: i32 = *(b + i) as i32
    if ca != cb
      return ca - cb
    if ca == 0
      return 0
    i = i + 1
  0

# Build "/tmp/ritz_l11_<tag>_<pid>" into buf (>= 40 bytes) and return buf.
# The pid makes the path unique to this process, so concurrent runs of the
# same test cannot see each other's files.
fn l11_tmp_path(buf: *i8, tag: i8) -> *i8
  let prefix: *i8 = c"/tmp/ritz_l11_"
  var len: i64 = 0
  while *(prefix + len) != 0
    *(buf + len) = *(prefix + len)
    len = len + 1
  *(buf + len) = tag
  *(buf + len + 1) = 95  # '_'
  len = len + 2
  var pid: i64 = syscall0(39)  # getpid
  var digits: [20]i8 = [0; 20]
  var nd: i64 = 0
  while pid > 0
    digits[nd] = (48 + pid % 10) as i8
    pid = pid / 10
    nd = nd + 1
  while nd > 0
    nd = nd - 1
    *(buf + len) = digits[nd]
    len = len + 1
  *(buf + len) = 0
  buf

# ===== TESTS =====

[[test]]
fn test_tmp_path_is_per_process() -> i32
  var buf: [40]i8 = [0; 40]
  let path: *i8 = l11_tmp_path(@buf[0], 98)  # 'b'
  assert strncmp(path, c"/tmp/ritz_l11_b_", 16) == 0
  # Decode the pid suffix and check it is ours.
  var pid: i64 = 0
  var i: i64 = 16
  while *(path + i) != 0
    pid = pid * 10 + (*(path + i) as i64 - 48)
    i = i + 1
  assert i > 16
  assert pid == syscall0(39)
  0

[[test]]
fn test_open_close() -> i32
  # Open /dev/null - should succeed
  let fd: i32 = l11_open(c"/dev/null", O_RDONLY, 0)
  assert fd >= 0
  let ret: i32 = l11_close(fd)
  assert ret == 0
  0

[[test]]
fn test_write_to_devnull() -> i32
  let fd: i32 = l11_open(c"/dev/null", O_WRONLY, 0)
  assert fd >= 0
  let msg: *i8 = c"test data"
  let n: i64 = l11_write(fd, msg, 9)
  assert n == 9
  l11_close(fd)
  0

[[test]]
fn test_read_from_devzero() -> i32
  let fd: i32 = l11_open(c"/dev/zero", O_RDONLY, 0)
  assert fd >= 0
  var buf: [16]i8 = [0; 16]
  # Put some non-zero data first
  buf[0] = 42
  buf[1] = 99
  # Read zeros
  let n: i64 = l11_read(fd, @buf[0], 16)
  assert n == 16
  # Should all be zero now
  assert buf[0] == 0
  assert buf[1] == 0
  assert buf[15] == 0
  l11_close(fd)
  0

[[test]]
fn test_create_write_read_file() -> i32
  # Create temp file
  var path_buf: [40]i8 = [0; 40]
  let path: *i8 = l11_tmp_path(@path_buf[0], 97)  # 'a'

  # Write to file
  let fd_w: i32 = l11_open(path, O_WRONLY + O_CREAT + O_TRUNC, 420)  # 0644
  assert fd_w >= 0
  let msg: *i8 = c"Hello, Ritz!"
  let written: i64 = l11_write(fd_w, msg, 12)
  assert written == 12
  l11_close(fd_w)

  # Read it back
  let fd_r: i32 = l11_open(path, O_RDONLY, 0)
  assert fd_r >= 0
  var buf: [32]i8 = [0; 32]
  let read_len: i64 = l11_read(fd_r, @buf[0], 32)
  assert read_len == 12
  l11_close(fd_r)

  # Verify content
  assert strncmp(@buf[0], msg, 12) == 0

  # Cleanup
  l11_unlink(path)
  0

[[test]]
fn test_file_not_found() -> i32
  # Opening non-existent file should fail
  var path_buf: [40]i8 = [0; 40]
  let fd: i32 = l11_open(l11_tmp_path(@path_buf[0], 110), O_RDONLY, 0)  # 'n'
  assert fd < 0  # -ENOENT
  0

[[test]]
fn test_write_multiple_chunks() -> i32
  var path_buf: [40]i8 = [0; 40]
  let path: *i8 = l11_tmp_path(@path_buf[0], 98)  # 'b'

  # Write in chunks
  let fd: i32 = l11_open(path, O_WRONLY + O_CREAT + O_TRUNC, 420)
  assert fd >= 0

  l11_write(fd, c"AAA", 3)
  l11_write(fd, c"BBB", 3)
  l11_write(fd, c"CCC", 3)
  l11_close(fd)

  # Read back
  let fd_r: i32 = l11_open(path, O_RDONLY, 0)
  var buf: [16]i8 = [0; 16]
  let n: i64 = l11_read(fd_r, @buf[0], 16)
  l11_close(fd_r)

  assert n == 9
  assert strncmp(@buf[0], c"AAABBBCCC", 9) == 0

  l11_unlink(path)
  0

[[test]]
fn test_large_buffer() -> i32
  var path_buf: [40]i8 = [0; 40]
  let path: *i8 = l11_tmp_path(@path_buf[0], 99)  # 'c'

  # Create file with 256 'X' characters
  var buf: [256]i8 = [88; 256]  # 88 = 'X'

  let fd_w: i32 = l11_open(path, O_WRONLY + O_CREAT + O_TRUNC, 420)
  assert fd_w >= 0
  let written: i64 = l11_write(fd_w, @buf[0], 256)
  assert written == 256
  l11_close(fd_w)

  # Read it back
  var buf2: [256]i8 = [0; 256]
  let fd_r: i32 = l11_open(path, O_RDONLY, 0)
  let read_len: i64 = l11_read(fd_r, @buf2[0], 256)
  l11_close(fd_r)

  assert read_len == 256

  # Verify all bytes
  var i: i64 = 0
  while i < 256
    assert buf2[i] == 88
    i = i + 1

  l11_unlink(path)
  0
