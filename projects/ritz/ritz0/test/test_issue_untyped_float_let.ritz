# AGAST #2047: ritz1 sizes an untyped `let` with a float-valued initializer
# as a float / double slot.
#
# THE DEFECT
#
# emit_var_decl's untyped-init inference (ritz1/src/emitter_stmt.ritz) only
# narrowed the parser-default TYPE_I64 slot for calls, methods, `match` and
# `if`.  `let s = x + 0.5` with `x: f32` kept an i64 slot, and clang rejected
# `store i64 %.8, ptr %.4` (`%.8` a float).  The same held for casts to a
# float type, float struct fields, unary negation of a float, and a float
# method result used in arithmetic (`x.floor() + 0.5`).
#
# THE FIX
#
# When get_expr_type(init) is TYPE_F32 / TYPE_F64 and no earlier arm typed
# the slot, the slot takes that type.
#
# Oracle: ritz0 runs every case to the same result.

struct UflP
    a: f32
    b: f64

# The ticket's repro: exit 5 under ritz0.
fn ufl_repro() -> i32
    let x: f32 = 2.25
    let s = x + 0.5
    return (s * 2.0) as i32

fn ufl_binary_f64(x: f64) -> i32
    let s = x * 4.0 - 1.0
    return s as i32

fn ufl_cast_f32(n: i32) -> i32
    let f = n as f32
    let g = f / 2.0
    return (g * 10.0) as i32

fn ufl_cast_f64(n: i64) -> i32
    let f = n as f64
    return (f * 1.5) as i32

fn ufl_field_f32(p: UflP) -> i32
    let a = p.a
    return (a * 4.0) as i32

fn ufl_field_f64() -> i32
    var p: UflP
    p.a = 1.0
    p.b = 3.25
    let b = p.b
    return (b * 4.0) as i32

fn ufl_neg_f32(x: f32) -> i32
    let n = -x
    return (n * 2.0) as i32

fn ufl_neg_f64(x: f64) -> i32
    let n = -x
    return (n * 2.0) as i32

fn ufl_floor_plus(x: f32) -> i32
    let r = x.floor() + 0.5
    return (r * 2.0) as i32

fn ufl_floor_plus_f64(x: f64) -> i32
    let r = x.floor() + 0.5
    return (r * 2.0) as i32

[[test]]
fn test_untyped_float_let_repro() -> i32
    if ufl_repro() != 5
        return 1
    0

[[test]]
fn test_untyped_float_let_binary_f64() -> i32
    if ufl_binary_f64(2.5) != 9
        return 1
    0

[[test]]
fn test_untyped_float_let_cast() -> i32
    if ufl_cast_f32(7) != 35
        return 1
    if ufl_cast_f64(6) != 9
        return 2
    0

[[test]]
fn test_untyped_float_let_field() -> i32
    var p: UflP
    p.a = 2.75
    p.b = 0.0
    if ufl_field_f32(p) != 11
        return 1
    if ufl_field_f64() != 13
        return 2
    0

[[test]]
fn test_untyped_float_let_neg() -> i32
    if ufl_neg_f32(1.5) != -3
        return 1
    if ufl_neg_f64(2.25) != -4
        return 2
    0

[[test]]
fn test_untyped_float_let_floor_plus() -> i32
    if ufl_floor_plus(3.75) != 7
        return 1
    if ufl_floor_plus_f64(-1.25) != -3
        return 2
    0
