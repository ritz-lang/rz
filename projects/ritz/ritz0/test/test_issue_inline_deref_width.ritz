# AGAST #2119: ritz1 derefs an inline cast (`*(@x as *T)`) or an
# address-of (`*@x`) at the pointee's real width.
#
# THE DEFECT
#
# get_expr_type's OP_DEREF arm only knew a typed binding's pointee
# (`let p: *i8 = ..; *p` loads i8).  An inline `<e> as *T` or `@x` operand
# fell to the i64 default, so `*(@s as *i8)` emitted `load i64` from a
# 1-byte slot (reading its neighbours) and `*(@s as *i8) = v` stored 8
# bytes, overwriting them.
#
# THE FIX (ritz1/src/emitter_core.ritz inline_deref_pointee)
#
# Both shapes resolve as #1879's mem_builtin_pointee does: the cast records
# T, and `@x` points at x's own type.  get_expr_type (the load width) and
# get_deref_store_type (the `*p = v` width) both consult it.
#
# Every narrow slot sits between non-zero neighbours, so a wide load folds
# them in and a wide store clobbers them.  Unsigned values stay below the
# sign bit: ritz0 sign-extends a u16 / u32 read through these shapes (a
# separate oracle defect), which would fail its own cells.
#
# Oracle: ritz0 runs every case to the same result.

var idw_g16: [4]u16
var idw_g32: u32 = 0

# The repro from the ticket.
fn idw_repro_main() -> i32
    var s: i8 = -3
    if *(@s as *i8) == -3
        return 42
    1

[[test]]
fn test_inline_deref_width_repro() -> i32
    assert idw_repro_main() == 42
    0

fn idw_i8_main() -> i32
    var a: [4]i8 = [-3, 5, 7, 9]
    # Loads: cast-deref and addr-deref.
    if *(@a[0] as *i8) != -3
        return 1
    if *@a[1] != 5
        return 2
    # Stores: only the target byte changes.
    *(@a[1] as *i8) = -1
    *@a[2] = 4
    if a[0] != -3 or a[1] != -1 or a[2] != 4 or a[3] != 9
        return 3
    if *(@a[1] as *i8) != -1
        return 4
    return 42

[[test]]
fn test_inline_deref_width_i8() -> i32
    assert idw_i8_main() == 42
    0

fn idw_u16_main() -> i32
    var b: [4]u16 = [30000, 1, 2, 3]
    if *(@b[0] as *u16) != 30000
        return 1
    if *@b[0] != 30000
        return 2
    *(@b[1] as *u16) = 700
    *@b[2] = 30001
    if b[0] != 30000 or b[1] != 700 or b[2] != 30001 or b[3] != 3
        return 3
    # MMIO-style: an integer address cast to a narrow pointer.
    let base: i64 = @b[0] as i64
    if *((base + 2) as *u16) != 700
        return 4
    *((base + 6) as *u16) = 9
    if b[2] != 30001 or b[3] != 9
        return 5
    return 42

[[test]]
fn test_inline_deref_width_u16() -> i32
    assert idw_u16_main() == 42
    0

fn idw_i32_main() -> i32
    var c: [3]i32 = [-7, 11, 13]
    if *(@c[0] as *i32) != -7
        return 1
    if *@c[1] != 11
        return 2
    *(@c[0] as *i32) = -9
    *@c[1] = -2
    if c[0] != -9 or c[1] != -2 or c[2] != 13
        return 3
    return 42

[[test]]
fn test_inline_deref_width_i32() -> i32
    assert idw_i32_main() == 42
    0

fn idw_global_main() -> i32
    idw_g16[0] = 1
    idw_g16[1] = 2
    idw_g16[2] = 3
    idw_g16[3] = 4
    if *@idw_g16[1] != 2
        return 1
    *(@idw_g16[1] as *u16) = 50
    *@idw_g16[2] = 60
    if idw_g16[0] != 1 or idw_g16[1] != 50 or idw_g16[2] != 60 or idw_g16[3] != 4
        return 2
    idw_g32 = 2000000000
    if *@idw_g32 != 2000000000
        return 3
    if *(@idw_g32 as *u32) != 2000000000
        return 4
    *@idw_g32 = 17
    if idw_g32 != 17
        return 5
    return 42

[[test]]
fn test_inline_deref_width_global() -> i32
    assert idw_global_main() == 42
    0
