# Calls through `fn(...) -> T` values (AGAST #1671)
#
# ritz1 used to emit every call through a fn-typed value as
# `call i64 %f(i64 ...)` while the callee is defined with its real types
# (`define i1 @is_d(i8 ...)`).  The caller then read all 64 bits of rax for
# a bool / u8 / i32 result, so whatever the callee left in the upper bits
# leaked into the value.  The callees below are chosen so that leak is
# deterministic: `x as u8` / `x as i32` lower to a 32-bit move that leaves
# the low bits of x above the narrow result, and an i32 result is never
# sign-extended by the callee.

struct Box
    v: i64

fn low_byte(x: i64) -> u8
    return x as u8

fn triple_word(x: i64) -> i32
    # 32-bit arithmetic: the callee writes eax, which zeroes rax's upper half.
    return (x as i32) * 3

fn is_digit(c: u8) -> bool
    return c >= '0' and c <= '9'

fn big_is_odd(x: i64) -> bool
    return (x & 1) == 1

fn box_get(b: *Box) -> i64
    return b.v

fn forty_two() -> i32
    return 42

fn mix(a: i32, b: u8, c: i16) -> i64
    return (a as i64) * 1000 + (b as i64) * 10 + (c as i64)

var g_hits: i64 = 0

fn bump(n: i64)
    g_hits = g_hits + n

fn call_u8(f: fn(i64) -> u8, x: i64) -> i64
    return f(x) as i64

fn call_i32(f: fn(i64) -> i32, x: i64) -> i64
    return f(x) as i64

fn count_while(s: *u8, n: i64, pred: fn(u8) -> bool) -> i64
    var i: i64 = 0
    while i < n and pred(*(s + i))
        i += 1
    return i

fn forward_pred(pred: fn(u8) -> bool, c: u8) -> bool
    # A fn-typed value passed on through a second fn-typed param.
    return call_pred(pred, c)

fn call_pred(p: fn(u8) -> bool, c: u8) -> bool
    return p(c)

# u8 result: 0x1234 as u8 is 0x34.  The untyped call read 0x1234.
[[test]]
fn test_fn_ptr_u8_return() -> i32
    assert call_u8(low_byte, 4660) == 52
    # 0x17F as u8 is 0x7F.  (Kept below 0x80: ritz0 sign-extends a u8
    # returned through a fn pointer -- a separate ritz0 bug.)
    assert call_u8(low_byte, 383) == 127
    0

# i32 result must be sign-extended: -3 read as i64 is -3, not 2^32-3.
[[test]]
fn test_fn_ptr_i32_return_sign_extends() -> i32
    assert call_i32(triple_word, -1) == -3
    assert call_i32(triple_word, -5) == -15
    assert call_i32(triple_word, 7) == 21
    0

# bool predicates (the buf_take_while case from the ticket).
[[test]]
fn test_fn_ptr_bool_predicate() -> i32
    let s: *u8 = c"123abc9"
    assert count_while(s, 7, is_digit) == 3
    assert count_while(c"abc", 3, is_digit) == 0
    assert forward_pred(is_digit, '5')
    assert not forward_pred(is_digit, 'x')
    0

# A typed local holding a fn value uses the same signature.
[[test]]
fn test_fn_ptr_typed_local() -> i32
    let f: fn(i64) -> u8 = low_byte
    assert (f(4660) as i64) == 52
    let odd: fn(i64) -> bool = big_is_odd
    assert odd(3)
    assert not odd(4)
    var hits: i64 = 0
    for i in 0..10
        if odd(i)
            hits += 1
    assert hits == 5
    0

# Narrow params are truncated to their real width; mixed widths line up.
[[test]]
fn test_fn_ptr_narrow_params() -> i32
    let m: fn(i32, u8, i16) -> i64 = mix
    assert m(7, 3 as u8, 2 as i16) == 7032
    0

# Pointer params, zero-param fns, and void returns.
[[test]]
fn test_fn_ptr_ptr_void_and_nullary() -> i32
    var b: Box = Box { v: 99 }
    let get: fn(*Box) -> i64 = box_get
    assert get(@b) == 99
    let k: fn() -> i32 = forty_two
    assert (k() as i64) == 42
    g_hits = 0
    let add: fn(i64) = bump
    add(5)
    add(6)
    assert g_hits == 11
    0
