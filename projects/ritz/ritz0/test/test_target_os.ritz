# Test file for [[target_os = "..."]] conditional compilation

[[target_os = "linux"]]
fn linux_syscall() -> i64
    # Linux-specific implementation
    return 42

[[target_os = "harland"]]
fn linux_syscall() -> i64
    # Harland-specific implementation
    return 99

# This function is always included.
# Exit 0 when the linux variant was selected; the regression matrix runs this
# main as a test (AGAST #1371), and exit status is its only verdict. It used to
# return the selected value (42) directly, which read as a failure.
fn main() -> i32
    let result: i64 = linux_syscall()
    if result != 42
        return 1
    return 0
