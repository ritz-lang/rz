# AGAST #1930: ritzlib has one byte-view type.
#
# - string.ritz used to declare its own `struct StrView`; it now imports
#   ritzlib.strview, so string_as_view's result feeds strview_* directly.
# - string_eq_string / string_eq_strview return bool, like string_eq.
# - Span<u8>'s eq/contains/starts_with/ends_with/find/find_byte/take/skip
#   delegate to strview; these tests pin their semantics so the delegation
#   cannot drift.
#
# The matrix runs every [[test]] here under ritz0, ritz1 and
# ritz1_selfhosted.

import ritzlib.strview
import ritzlib.string
import ritzlib.span

# ============================================================================
# bool returns
# ============================================================================

[[test]]
fn test_string_eq_string_is_bool() -> i32
    var a: String = string_from("abc")
    var b: String = string_from("abc")
    var c: String = string_from("abd")
    let same: bool = string_eq_string(@a, @b)
    let diff: bool = string_eq_string(@a, @c)
    assert same
    assert not diff
    0

[[test]]
fn test_string_eq_strview_is_bool() -> i32
    var s: String = string_from("hello")
    let same: bool = string_eq_strview(@s, "hello")
    let diff: bool = string_eq_strview(@s, "hellp")
    let short: bool = string_eq_strview(@s, "hell")
    assert same
    assert not diff
    assert not short
    0

# ============================================================================
# One StrView: a String's view is a ritzlib.strview StrView
# ============================================================================

[[test]]
fn test_string_view_feeds_strview_api() -> i32
    var s: String = string_from("key=value")
    let v: StrView = string_as_view(@s)
    assert strview_len(@v) == 9
    assert strview_find_byte(@v, '=') == 3
    let tail: StrView = strview_skip(@v, 4)
    assert string_eq(@s, "key=value")
    var t: String = string_from(tail)
    assert string_eq(@t, "value")
    0

# ============================================================================
# Span<u8> agrees with strview
# ============================================================================

[[test]]
fn test_span_eq_matches_strview() -> i32
    var a: Span<u8> = span_from_cstr(c"abc")
    var b: Span<u8> = span_from_cstr(c"abc")
    var c: Span<u8> = span_from_cstr(c"abd")
    var d: Span<u8> = span_from_cstr(c"ab")
    var e: Span<u8> = span_empty<u8>()
    var f: Span<u8> = span_empty<u8>()
    assert span_eq(@a, @b) == 1
    assert span_eq(@a, @c) == 0
    assert span_eq(@a, @d) == 0
    assert span_eq(@e, @f) == 1
    0

[[test]]
fn test_span_contains_and_find() -> i32
    var h: Span<u8> = span_from_cstr(c"hello world")
    var n: Span<u8> = span_from_cstr(c"o w")
    var m: Span<u8> = span_from_cstr(c"xyz")
    var e: Span<u8> = span_empty<u8>()
    var big: Span<u8> = span_from_cstr(c"hello world!!")
    assert span_contains(@h, @n) == 1
    assert span_contains(@h, @m) == 0
    assert span_contains(@h, @e) == 1
    assert span_contains(@h, @big) == 0
    assert span_find(@h, @n) == 4
    assert span_find(@h, @m) == -1
    assert span_find(@h, @e) == 0
    assert span_find(@h, @big) == -1
    0

[[test]]
fn test_span_starts_ends_with() -> i32
    var s: Span<u8> = span_from_cstr(c"prefix-body-suffix")
    var p: Span<u8> = span_from_cstr(c"prefix")
    var x: Span<u8> = span_from_cstr(c"suffix")
    assert span_starts_with(@s, @p) == 1
    assert span_starts_with(@s, @x) == 0
    assert span_ends_with(@s, @x) == 1
    assert span_ends_with(@s, @p) == 0
    assert span_starts_with(@p, @s) == 0
    assert span_ends_with(@x, @s) == 0
    0

[[test]]
fn test_span_find_byte_take_skip() -> i32
    var s: Span<u8> = span_from_cstr(c"a:b:c")
    assert span_find_byte(@s, ':') == 1
    assert span_find_byte(@s, 'z') == -1
    let t: Span<u8> = span_take(@s, 3)
    assert t.len == 3
    assert t.ptr == s.ptr
    let all: Span<u8> = span_take(@s, 99)
    assert all.len == 5
    let k: Span<u8> = span_skip(@s, 2)
    assert k.len == 3
    assert *k.ptr == 'b'
    let none: Span<u8> = span_skip(@s, 99)
    assert none.len == 0
    assert none.ptr == s.ptr + 5
    0

[[test]]
fn test_span_eq_cstr() -> i32
    var s: Span<u8> = span_from_cstr(c"abc")
    assert span_eq_cstr(@s, c"abc") == 1
    assert span_eq_cstr(@s, c"ab") == 0
    assert span_eq_cstr(@s, c"abcd") == 0
    0
