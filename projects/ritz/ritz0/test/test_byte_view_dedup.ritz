# AGAST #1930: ritzlib has one byte-view type.
#
# - string.ritz used to declare its own `struct StrView`; it now imports
#   ritzlib.strview, so string_as_view's result feeds strview_* directly.
# - string_eq_string / string_eq_strview return bool, like string_eq.
# - Span<u8>'s eq/contains/starts_with/ends_with/find/find_byte/take/skip
#   delegate to strview; these tests pin their semantics so the delegation
#   cannot drift.
#
# The matrix runs every [[test]] here under ritz0, ritz1 and
# ritz1_selfhosted.

import ritzlib.strview
import ritzlib.string
import ritzlib.span

# ============================================================================
# bool returns
# ============================================================================

[[test]]
fn test_string_eq_string_is_bool() -> i32
    var a: String = string_from("abc")
    var b: String = string_from("abc")
    var c: String = string_from("abd")
    let same: bool = a.eq_string(@b)
    let diff: bool = a.eq_string(@c)
    assert same
    assert not diff
    0

[[test]]
fn test_string_eq_strview_is_bool() -> i32
    var s: String = string_from("hello")
    let same: bool = s.eq_strview("hello")
    let diff: bool = s.eq_strview("hellp")
    let short: bool = s.eq_strview("hell")
    assert same
    assert not diff
    assert not short
    0

# ============================================================================
# One StrView: a String's view is a ritzlib.strview StrView
# ============================================================================

[[test]]
fn test_string_view_feeds_strview_api() -> i32
    var s: String = string_from("key=value")
    let v: StrView = s.as_view()
    assert v.len() == 9
    assert v.find_byte('=') == 3
    let tail: StrView = v.skip(4)
    assert s.eq("key=value")
    var t: String = string_from(tail)
    assert t.eq("value")
    0

# ============================================================================
# Span<u8> agrees with strview
# ============================================================================

[[test]]
fn test_span_eq_matches_strview() -> i32
    var a: Span<u8> = "abc"
    var b: Span<u8> = "abc"
    var c: Span<u8> = "abd"
    var d: Span<u8> = "ab"
    var e: Span<u8> = span_empty<u8>()
    var f: Span<u8> = span_empty<u8>()
    assert a.eq(@b)
    assert not a.eq(@c)
    assert not a.eq(@d)
    assert e.eq(@f)
    0

[[test]]
fn test_span_contains_and_find() -> i32
    var h: Span<u8> = "hello world"
    var n: Span<u8> = "o w"
    var m: Span<u8> = "xyz"
    var e: Span<u8> = span_empty<u8>()
    var big: Span<u8> = "hello world!!"
    assert h.contains(@n)
    assert not h.contains(@m)
    assert h.contains(@e)
    assert not h.contains(@big)
    assert h.find(@n) == 4
    assert h.find(@m) == h.len
    assert h.find(@e) == 0
    assert h.find(@big) == h.len
    0

[[test]]
fn test_span_starts_ends_with() -> i32
    var s: Span<u8> = "prefix-body-suffix"
    var p: Span<u8> = "prefix"
    var x: Span<u8> = "suffix"
    assert s.starts_with(@p)
    assert not s.starts_with(@x)
    assert s.ends_with(@x)
    assert not s.ends_with(@p)
    assert not p.starts_with(@s)
    assert not x.ends_with(@s)
    0

[[test]]
fn test_span_find_byte_to_from() -> i32
    var s: Span<u8> = "a:b:c"
    assert s.find_byte(':') == 1
    assert s.find_byte('z') == s.len
    let t: Span<u8> = s.to(3)
    assert t.len == 3
    assert t.ptr == s.ptr
    let all: Span<u8> = s.to(99)
    assert all.len == 5
    let k: Span<u8> = s.from(2)
    assert k.len == 3
    assert *k.ptr == 'b'
    # Past the end is the empty span (#4684: span_skip's end pointer is gone
    # with span_skip; Span.from is the generic slice).
    let none: Span<u8> = s.from(99)
    assert none.len == 0
    assert none.is_empty()
    0

[[test]]
fn test_span_as_strview_eq() -> i32
    var s: Span<u8> = "abc"
    assert s.as_strview().eq("abc")
    assert not s.as_strview().eq("ab")
    assert not s.as_strview().eq("abcd")
    0
