# Test level 28: Owned String type
#
# Tests the String type for owned text.
# Features tested:
# - string_new, string_from creates strings
# - string_push_str appends text
# - string_as_ptr gets C string for printing
# - string_eq, string_eq_cstr for comparison
# - string_drop frees memory

import ritzlib.sys
import ritzlib.io
import ritzlib.string

# ============================================================================
# Basic String Tests
# ============================================================================

[[test]]
fn test_string_new() -> i32
    var s: String = string_new()
    assert s.len() == 0, "new string should be empty"
    assert s.is_empty(), "new string should be empty"
    return 0

[[test]]
fn test_string_from() -> i32
    var s: String = string_from("hello")
    assert s.len() == 5, "len should be 5"
    assert not s.is_empty(), "should not be empty"

    # Check content
    assert s.get(0) == 104, "h = 104"
    assert s.get(1) == 101, "e = 101"
    assert s.get(2) == 108, "l = 108"
    assert s.get(3) == 108, "l = 108"
    assert s.get(4) == 111, "o = 111"

    return 0

[[test]]
fn test_string_push_str() -> i32
    var s: String = string_from("hello")
    s.push_str(" world")

    assert s.len() == 11, "len should be 11"
    assert s.eq("hello world"), "should equal 'hello world'"

    return 0

[[test]]
fn test_string_push() -> i32
    var s: String = string_new()
    s.push(65)  # A
    s.push(66)  # B
    s.push(67)  # C

    assert s.len() == 3, "len should be 3"
    assert s.get(0) == 65, "should be A"
    assert s.get(1) == 66, "should be B"
    assert s.get(2) == 67, "should be C"

    return 0

[[test]]
fn test_string_as_ptr() -> i32
    var s: String = string_from("test")
    let ptr: *u8 = s.as_ptr()

    # Check null-terminated
    assert *(ptr + 0) == 116, "t"
    assert *(ptr + 1) == 101, "e"
    assert *(ptr + 2) == 115, "s"
    assert *(ptr + 3) == 116, "t"
    assert *(ptr + 4) == 0, "null terminated"

    return 0

# ============================================================================
# Comparison Tests
# ============================================================================

[[test]]
fn test_string_eq() -> i32
    var a: String = string_from("hello")
    var b: String = string_from("hello")
    var c: String = string_from("world")

    assert a.eq_string(@b), "a should equal b"
    assert not a.eq_string(@c), "a should not equal c"

    return 0

[[test]]
fn test_string_eq_cstr() -> i32
    var s: String = string_from("hello")

    assert s.eq("hello"), "should equal 'hello'"
    assert not s.eq("hello!"), "should not equal 'hello!'"
    assert not s.eq("hell"), "should not equal 'hell'"
    assert not s.eq("world"), "should not equal 'world'"

    return 0

# ============================================================================
# Utility Tests
# ============================================================================

[[test]]
fn test_string_clone() -> i32
    var s: String = string_from("original")
    var clone: String = s.clone()

    assert s.eq_string(@clone), "clone should equal original"

    # Modify original
    s.push_str("!")
    assert not s.eq_string(@clone), "after modify, should differ"

    return 0

[[test]]
fn test_string_starts_with() -> i32
    var s: String = string_from("hello world")

    assert s.starts_with("hello"), "should start with 'hello'"
    assert s.starts_with("hell"), "should start with 'hell'"
    assert s.starts_with("h"), "should start with 'h'"
    assert s.starts_with(""), "should start with empty"
    assert not s.starts_with("world"), "should not start with 'world'"
    assert not s.starts_with("hello world!"), "too long"

    return 0

[[test]]
fn test_string_ends_with() -> i32
    var s: String = string_from("hello world")

    assert s.ends_with("world"), "should end with 'world'"
    assert s.ends_with("ld"), "should end with 'ld'"
    assert s.ends_with("d"), "should end with 'd'"
    assert s.ends_with(""), "should end with empty"
    assert not s.ends_with("hello"), "should not end with 'hello'"
    assert not s.ends_with("hello world!"), "too long"

    return 0

[[test]]
fn test_string_contains() -> i32
    var s: String = string_from("hello world")

    assert s.contains("hello"), "should contain 'hello'"
    assert s.contains("world"), "should contain 'world'"
    assert s.contains("lo wo"), "should contain 'lo wo'"
    assert s.contains(" "), "should contain space"
    assert s.contains(""), "should contain empty"
    assert not s.contains("xyz"), "should not contain 'xyz'"
    assert not s.contains("hello world!"), "too long"

    return 0

[[test]]
fn test_string_clear() -> i32
    var s: String = string_from("hello")
    let old_cap: i64 = s.cap()

    s.clear()
    assert s.len() == 0, "len should be 0"
    assert s.cap() == old_cap, "cap should be unchanged"

    # Can push again
    s.push_str("world")
    assert s.eq("world"), "should be 'world'"

    return 0

[[test]]
fn test_string_pop() -> i32
    var s: String = string_from("abc")

    let c: u8 = s.pop()
    assert c == 99, "popped should be 'c'"
    assert s.len() == 2, "len should be 2"

    return 0

[[test]]
fn test_string_push_string() -> i32
    var a: String = string_from("hello")
    var b: String = string_from(" world")

    a.push_string(@b)
    assert a.eq("hello world"), "should be 'hello world'"

    return 0
