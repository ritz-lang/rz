# AGAST #1959: ritz1 negates a float Some / Ok payload with `fneg` (f64).
#
# The payload half of test_diff_float_neg.ritz (see there for the defect and
# the fix).  #1945 made float payloads work in ritz1; these pass negative
# f64 literals into Some / Ok, built in place and returned from a fn.
#
# One float width per file: when a module instantiates both Option<f32> and
# Option<f64>, ritz0 types `let o: Option<f64> = Some(2.5)` as Option$f32
# and rejects the store (#1964).  Each payload is checked inside its arm
# and the match yields i64: in ritz0 an `f32` arm next to a `0.0` arm has
# mismatched types and dies on a raw traceback (#1357).
#
# Oracle: ritz0 runs every case to the same result.

import ritzlib.option
import ritzlib.result

fn fn_is64(v: f64, want: f64) -> i64
    if v == want
        return 1
    return 0

fn mk_some_neg64() -> Option<f64>
    return Some(-1.25)

fn mk_ok_neg64() -> Result<f64, i32>
    return Ok(-1234.5)

fn payload64_main() -> i32
    let o: Option<f64> = Some(-2.5)
    let a: i64 = match o
        Some(v) => fn_is64(v, -2.5)
        None => 0
    if a != 1
        return 1
    let b: i64 = match mk_some_neg64()
        Some(v) => fn_is64(v, -1.25)
        None => 0
    if b != 1
        return 2
    let c: i64 = match mk_ok_neg64()
        Ok(v) => fn_is64(v, -1234.5)
        Err(e) => 0
    if c != 1
        return 3
    return 42

[[test]]
fn test_neg_payload_f64() -> i32
    assert payload64_main() == 42
    0
