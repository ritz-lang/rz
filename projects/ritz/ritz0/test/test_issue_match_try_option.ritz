# Regression (AGAST #4835): `match f()?` where the `?` unwraps a
# `Result<Option<T>, E>`. ritz1 typed the scrutinee as a scalar and compared
# the `%Option$T` aggregate as an i64: invalid IR, clang refused it.
import ritzlib.option
import ritzlib.result

struct Pair
    a: i64
    b: i64

fn lookup(n: i64) -> Result<Option<Pair>, i64>
    if n < 0
        return Err(9)
    if n == 0
        return Ok(None)
    Ok(Some(Pair { a: n, b: n * 2 }))

fn found(n: i64) -> Result<Pair, i64>
    match lookup(n)?
        Some(p) => Ok(p)
        None => Err(1)

[[test]]
fn test_match_on_try_of_an_option_payload() -> i32
    match found(3)
        Ok(p) =>
            if p.a != 3 or p.b != 6
                return 1
        Err(_) => return 2
    match found(0)
        Ok(_) => return 3
        Err(e) =>
            if e != 1
                return 4
    match found(-1)
        Ok(_) => return 5
        Err(e) =>
            if e != 9
                return 6
    0
