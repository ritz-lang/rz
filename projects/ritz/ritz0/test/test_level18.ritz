# Test level 18: Environment access via main's `env` span
#
# Tests that `pub fn main(args: Span<StrView>, env: Span<StrView>)` receives
# the environment. Until AGAST #204 this was C's 3-argument `main(argc,
# argv, envp)` walking envp by hand; that shape is now refused, and the
# adapter (ritz0/main_abi.py) builds `env` from the same envp. Ordinary
# environment access is ritzlib.os.env.

import ritzlib.sys
import ritzlib.io
import ritzlib.strview

# 1 if some entry of env starts with `prefix` (e.g. "PATH=").
fn env_has_prefix(env: Span<StrView>, prefix: StrView) -> i32
    var i: i64 = 0
    while i < env.len
        if env[i].starts_with(prefix)
            return 1
        i += 1
    0

# ============================================================================
# Test: main receives env
# ============================================================================

pub fn main(args: Span<StrView>, env: Span<StrView>) -> i32
    # There should be at least a few environment variables
    let count: i64 = env.len
    if count < 1
        eprints("FAIL: no environment variables found\n")
        return 1

    print("Environment variable count: {count}\n")

    if env_has_prefix(env, "PATH=") == 1
        prints("Found PATH\n")
    else
        eprints("WARN: PATH not found in environment\n")
        # Not a failure - some minimal environments might not have PATH

    prints("OK: env works\n")
    return 0
