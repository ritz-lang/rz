# Test level 18: Environment access via 3-argument main
#
# Tests that main can receive envp as a third argument.
#
# This is a test of the 3-arg main *calling convention*, so it walks envp by
# hand. It used to do so through ritzlib/env.ritz's env_count/getenv, which
# were deleted by AGAST #1750; ordinary environment access is ritzlib.os.env.

import ritzlib.sys
import ritzlib.io
import ritzlib.str

# Number of entries before envp's NULL terminator.
fn envp_count(envp: **u8) -> i32
    var count: i32 = 0
    while *(envp + count) != null
        count += 1
    count

# 1 if some entry of envp starts with `prefix` (e.g. c"PATH=").
fn envp_has_prefix(envp: **u8, prefix: *u8) -> i32
    let n: i64 = strlen(prefix)
    var i: i32 = 0
    while *(envp + i) != null
        let entry: *u8 = *(envp + i)
        var matches: i32 = 1
        for j in 0..n
            if *(entry + j) != *(prefix + j)
                matches = 0
                break
        if matches == 1
            return 1
        i += 1
    0

# ============================================================================
# Test: 3-argument main receives envp
# ============================================================================

fn main(argc: i32, argv: **u8, envp: **u8) -> i32
    # Test that envp is not null
    if envp == null
        eprints("FAIL: envp is null\n")
        return 1

    # There should be at least a few environment variables
    let count: i32 = envp_count(envp)
    if count < 1
        eprints("FAIL: no environment variables found\n")
        return 1

    prints("Environment variable count: ")
    print_int(count as i64)
    print_char(10)

    if envp_has_prefix(envp, c"PATH=") == 1
        prints("Found PATH\n")
    else
        eprints("WARN: PATH not found in environment\n")
        # Not a failure - some minimal environments might not have PATH

    prints("OK: envp works\n")
    return 0
