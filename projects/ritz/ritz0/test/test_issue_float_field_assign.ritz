# AGAST #2048: ritz1 stores into an f32 / f64 struct field at the field's
# own width.
#
# THE DEFECT
#
# `p.x = 4.5` on a `var p: P` local, with `x: f32` or `x: f64`, fell to the
# `store i64` default of the field-assign paths (STMT_LOCAL_FIELD_ASSIGN and
# emit_assign's EXPR_MEMBER arm, ritz1/src/emitter_stmt.ritz):
# `%.3 = fadd double 0.0, 4.5` / `store i64 %.3, ptr %.2`, which clang
# rejects.  The f32 store also needs an fptrunc of the f64 literal.
#
# THE FIX
#
# Both paths store `float` / `double`, narrowing an f64 value into an f32
# field with emit_field_elem_narrow, as struct-literal init does.
#
# Values are checked as values and as IEEE-754 bits through a `*u32` /
# `*u64` view of the struct, which pins the width: an 8-byte store into
# `a: f32` would clobber the adjacent `b: f32`.
#
# Oracle: ritz0 runs every case to the same result.

struct FfaP
    x: f32
    y: f64

struct FfaPair
    a: f32
    b: f32
    d: f64

struct FfaOuter
    tag: i32
    p: FfaPair

fn ffa_bits32(p: *u32, i: i64) -> u32
    p[i]

fn ffa_bits64(p: *u64, i: i64) -> u64
    p[i]

fn ffa_set_ptr(pp: *FfaPair, a: f32, d: f64) -> void
    pp.a = a
    pp.d = d

fn ffa_set_ptr_lit(pp: *FfaPair) -> void
    pp.b = 0.75
    pp.d = 2.5

# The ticket's repro: exit 4 under ritz0.
fn ffa_repro() -> i32
    var p: FfaP
    p.x = 4.5
    p.y = 1.5
    return p.x as i32

[[test]]
fn test_float_field_assign_repro() -> i32
    if ffa_repro() != 4
        return 1
    0

# --- literals into a local's f32 / f64 fields -------------------------------

[[test]]
fn test_float_field_assign_literal() -> i32
    var q: FfaPair = FfaPair { a: 0.0, b: 0.0, d: 0.0 }
    q.b = 9.0
    q.a = 2.25
    q.d = -0.5
    if ffa_bits32(@q as *u32, 0) != 0x40100000      # 2.25
        return 1
    if ffa_bits32(@q as *u32, 1) != 0x41100000      # 9.0, not clobbered
        return 2
    if ffa_bits64(@q as *u64, 1) != 0xBFE0000000000000      # -0.5
        return 3
    let want: f32 = 2.25
    if q.a != want
        return 4
    0

# --- f32 / f64 locals into fields --------------------------------------------

[[test]]
fn test_float_field_assign_f32_local() -> i32
    var q: FfaPair = FfaPair { a: 0.0, b: 0.0, d: 0.0 }
    let v: f32 = 6.5
    let w: f32 = 3.0
    q.b = w
    q.a = v
    if ffa_bits32(@q as *u32, 0) != 0x40D00000      # 6.5
        return 1
    if ffa_bits32(@q as *u32, 1) != 0x40400000      # 3.0
        return 2
    if q.a + q.b != 9.5
        return 3
    0

[[test]]
fn test_float_field_assign_f64_local() -> i32
    var q: FfaPair = FfaPair { a: 1.0, b: 2.0, d: 0.0 }
    let v: f64 = 0.125
    q.d = v
    if ffa_bits64(@q as *u64, 1) != 0x3FC0000000000000      # 0.125
        return 1
    if ffa_bits32(@q as *u32, 0) != 0x3F800000      # untouched 1.0
        return 2
    if ffa_bits32(@q as *u32, 1) != 0x40000000      # untouched 2.0
        return 3
    if q.d * 8.0 != 1.0
        return 4
    0

# --- through a pointer: pp.x = v ----------------------------------------------

[[test]]
fn test_float_field_assign_through_ptr() -> i32
    var q: FfaPair = FfaPair { a: 0.0, b: 5.0, d: 0.0 }
    ffa_set_ptr(@q, 1.5, 4.25)
    if ffa_bits32(@q as *u32, 0) != 0x3FC00000      # 1.5
        return 1
    if ffa_bits32(@q as *u32, 1) != 0x40A00000      # untouched 5.0
        return 2
    if ffa_bits64(@q as *u64, 1) != 0x4011000000000000      # 4.25
        return 3
    ffa_set_ptr_lit(@q)
    if ffa_bits32(@q as *u32, 1) != 0x3F400000      # 0.75
        return 4
    if ffa_bits32(@q as *u32, 0) != 0x3FC00000      # untouched 1.5
        return 5
    if q.d != 2.5
        return 6
    0

[[test]]
fn test_float_field_assign_ptr_local() -> i32
    var q: FfaPair = FfaPair { a: 0.0, b: 5.0, d: 0.0 }
    let pp: *FfaPair = @q
    let v: f32 = -2.0
    pp.a = v
    pp.d = 8.0
    if ffa_bits32(@q as *u32, 0) != 0xC0000000      # -2.0
        return 1
    if ffa_bits32(@q as *u32, 1) != 0x40A00000      # untouched 5.0
        return 2
    if ffa_bits64(@q as *u64, 1) != 0x4020000000000000      # 8.0
        return 3
    0

# --- nested: o.p.x = v ---------------------------------------------------------

[[test]]
fn test_float_field_assign_nested() -> i32
    var o: FfaOuter = FfaOuter { tag: 7, p: FfaPair { a: 0.0, b: 5.0, d: 0.0 } }
    let v: f32 = 1.25
    let w: f64 = 3.5
    o.p.a = v
    o.p.d = w
    o.p.b = 0.5
    if o.tag != 7
        return 1
    let base: *u32 = @o.p as *u32
    if ffa_bits32(base, 0) != 0x3FA00000      # 1.25
        return 2
    if ffa_bits32(base, 1) != 0x3F000000      # 0.5
        return 3
    if ffa_bits64(base as *u64, 1) != 0x400C000000000000      # 3.5
        return 4
    if o.p.a + o.p.b != 1.75
        return 5
    0
