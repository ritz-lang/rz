# AGAST #1856: every ritzlib integer formatter must print i64's minimum.
#
# print_int, eprint_int, itoa and iovec_append_int negated with `0 - n` /
# `-val`, which wraps for i64::MIN: n stayed negative, the `while n > 0`
# digit loop never ran, and the output was just "-". print_hex of any
# negative printed "0x". They now all go through ritzlib.fmt's one digit
# routine (fmt_i64_into / fmt_u64_into / fmt_u64_hex_into).
# Case 1 now prints through print("{x}") interpolation, which uses the same
# routine (#4560).  #4565 deleted print_int and print_hex; case 3 prints the
# same bits through print_hex64 until interpolation prints `{x:x}` (#4635).
#
# The matrix runs every [[test]] here under ritz0, ritz1 and
# ritz1_selfhosted.

import ritzlib.sys
import ritzlib.fd
import ritzlib.process
import ritzlib.span
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.iovec
import ritzlib.result
import ritzlib.fmt.digits

# ============================================================================
# Capture: run one case in a child with stdout/stderr piped back.
# ============================================================================

var g_out: [256]u8
var g_out_len: i64 = 0
var g_err: [256]u8
var g_err_len: i64 = 0

fn read_all(src: @Fd, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        match src.read(Span<u8> { ptr: buf + got, len: cap - got })
            Ok(k) => n = k
            Err(_) => n = 0
        got = got + n
    got

# A new pipe; two closed Fds if pipe(2) fails (reads then see nothing).
fn new_pipe() -> Pipe
    match pipe()
        Ok(p) => p
        Err(_) => Pipe { read: fd_adopt(-1), write: fd_adopt(-1) }

# fork(2): 0 in the child, the pid in the parent, -errno on failure.
fn fork_pid() -> i32
    match fork()
        Ok(fr) =>
            match fr
                Child => 0
                Parent(pid) => pid
        Err(e) => -e.code()

# The child's exit code; 0 if a signal ended it (as status >> 8 gave).
fn exit_code_of(r: Result<ProcessResult, Errno>) -> i32
    match r
        Ok(pr) =>
            if pr.signaled != 0
                return 0
            pr.exit_code
        Err(_) => 0

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

fn i64_min() -> i64
    -9223372036854775807 - 1

fn i64_max() -> i64
    9223372036854775807

fn case_body(which: i32) -> i32
    if which == 1
        let lo: i64 = i64_min()
        let hi: i64 = i64_max()
        let neg: i64 = -7
        let zero: i64 = 0
        print("{lo} {hi} {neg} {zero}")
    else if which == 2
        eprint_int(i64_min())
        eprint_char(' ')
        eprint_int(-42)
    else if which == 3
        print_hex64(-1 as u64)
        print_char(' ')
        print_hex64(i64_min() as u64)
        print_char(' ')
        print_hex64(255)
        print_char(' ')
        print_hex64(0)
    0

fn run_case(which: i32) -> i32
    var out: Pipe = new_pipe()
    var err: Pipe = new_pipe()
    let pid: i32 = fork_pid()
    if pid == 0
        out.write.dup_to(1)
        err.write.dup_to(2)
        out.close()
        err.close()
        sys_exit(case_body(which))
    out.write.close()
    err.write.close()
    g_out_len = read_all(@out.read, @g_out[0], 256)
    g_err_len = read_all(@err.read, @g_err[0], 256)
    out.read.close()
    err.read.close()
    exit_code_of(wait_pid(pid))

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_print_i64_extremes() -> i32
    assert run_case(1) == 0
    assert bytes_differ(@g_out[0], g_out_len, "-9223372036854775808 9223372036854775807 -7 0") == 0
    assert g_err_len == 0
    0

[[test]]
fn test_eprint_int_min() -> i32
    assert run_case(2) == 0
    assert g_out_len == 0
    assert bytes_differ(@g_err[0], g_err_len, "-9223372036854775808 -42") == 0
    0

# A negative i64 cast to u64 prints its two's-complement bits.
[[test]]
fn test_print_hex64_negative_bits() -> i32
    assert run_case(3) == 0
    assert bytes_differ(@g_out[0], g_out_len, "0xffffffffffffffff 0x8000000000000000 0xff 0x0") == 0
    0

# itoa went with AGAST #4685; String.push_i64 is its replacement.
[[test]]
fn test_push_i64_extremes() -> i32
    var s: String = string_new()
    s.push_i64(i64_max())
    s.push(' ')
    s.push_i64(0)
    s.push(' ')
    s.push_i64(-5)
    assert s.as_view().eq("9223372036854775807 0 -5")
    0

[[test]]
fn test_string_push_i64_min() -> i32
    var s: String = string_from_i64(i64_min())
    assert bytes_differ(s.as_ptr(), s.len(), "-9223372036854775808") == 0
    var h: String = string_from_hex(0xffffffffffffffff as u64)
    assert bytes_differ(h.as_ptr(), h.len(), "0xffffffffffffffff") == 0
    0

[[test]]
fn test_iovec_append_int_min() -> i32
    var b: IoVecBuilder
    b.init()
    let n0: i32 = match b.append_int(i64_min())
        Ok(v) => v
        Err(_) => -1
    assert n0 == 20
    assert bytes_differ(b.iovecs[0].base, b.iovecs[0].len as i64, "-9223372036854775808") == 0
    let n1: i32 = match b.append_int(0)
        Ok(v) => v
        Err(_) => -1
    assert n1 == 1
    assert bytes_differ(b.iovecs[1].base, 1, "0") == 0
    let n2: i32 = match b.append_uint(18446744073709551615 as u64)
        Ok(v) => v
        Err(_) => -1
    assert n2 == 20
    assert bytes_differ(b.iovecs[2].base, 20, "18446744073709551615") == 0
    0

[[test]]
fn test_fmt_into() -> i32
    # AGAST #4685: a [u8] in, a StrView of the digits out.
    var buf: [32]u8
    assert fmt_i64_into(@buf, i64_min()).eq("-9223372036854775808")
    assert fmt_i64_into(@buf, 0).eq("0")
    assert fmt_i64_into(@buf, -10).eq("-10")
    assert fmt_u64_into(@buf, 18446744073709551615 as u64).eq("18446744073709551615")
    assert fmt_u64_hex_into(@buf, 0xdeadbeef as u64).eq("deadbeef")
    assert fmt_u64_hex_into(@buf, 0).eq("0")
    0
