# AGAST #1856: every ritzlib integer formatter must print i64's minimum.
#
# print_int, eprint_int, itoa and iovec_append_int negated with `0 - n` /
# `-val`, which wraps for i64::MIN: n stayed negative, the `while n > 0`
# digit loop never ran, and the output was just "-". print_hex of any
# negative printed "0x". They now all go through ritzlib.fmt's one digit
# routine (fmt_i64_into / fmt_u64_into / fmt_u64_hex_into).
#
# The matrix runs every [[test]] here under ritz0, ritz1 and
# ritz1_selfhosted.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.iovec
import ritzlib.fmt

# ============================================================================
# Capture: run one case in a child with stdout/stderr piped back.
# ============================================================================

var g_out: [256]u8
var g_out_len: i64 = 0
var g_err: [256]u8
var g_err_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = sys_read(fd, buf + got, cap - got)
        if n > 0
            got = got + n
    got

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

fn i64_min() -> i64
    -9223372036854775807 - 1

fn i64_max() -> i64
    9223372036854775807

fn case_body(which: i32) -> i32
    if which == 1
        print_int(i64_min())
        print_char(' ')
        print_int(i64_max())
        print_char(' ')
        print_int(-7)
        print_char(' ')
        print_int(0)
    else if which == 2
        eprint_int(i64_min())
        eprint_char(' ')
        eprint_int(-42)
    else if which == 3
        print_hex(-1)
        print_char(' ')
        print_hex(i64_min())
        print_char(' ')
        print_hex(255)
        print_char(' ')
        print_hex(0)
    0

fn run_case(which: i32) -> i32
    var o: [2]i32
    var e: [2]i32
    sys_pipe(@o[0])
    sys_pipe(@e[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_dup2(e[1], 2)
        sys_close(o[0])
        sys_close(o[1])
        sys_close(e[0])
        sys_close(e[1])
        sys_exit(case_body(which))
    sys_close(o[1])
    sys_close(e[1])
    g_out_len = read_all(o[0], @g_out[0], 256)
    g_err_len = read_all(e[0], @g_err[0], 256)
    sys_close(o[0])
    sys_close(e[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_print_int_extremes() -> i32
    assert run_case(1) == 0
    assert bytes_differ(@g_out[0], g_out_len, "-9223372036854775808 9223372036854775807 -7 0") == 0
    assert g_err_len == 0
    0

[[test]]
fn test_eprint_int_min() -> i32
    assert run_case(2) == 0
    assert g_out_len == 0
    assert bytes_differ(@g_err[0], g_err_len, "-9223372036854775808 -42") == 0
    0

# print_hex shows the two's-complement bits of a negative, like print_hex64.
[[test]]
fn test_print_hex_negative() -> i32
    assert run_case(3) == 0
    assert bytes_differ(@g_out[0], g_out_len, "0xffffffffffffffff 0x8000000000000000 0xff 0x0") == 0
    0

[[test]]
fn test_itoa_extremes() -> i32
    var buf: [32]u8
    itoa(i64_min(), @buf[0])
    assert bytes_differ(@buf[0], strlen(@buf[0]), "-9223372036854775808") == 0
    assert buf[20] == 0
    itoa(i64_max(), @buf[0])
    assert bytes_differ(@buf[0], strlen(@buf[0]), "9223372036854775807") == 0
    itoa(0, @buf[0])
    assert bytes_differ(@buf[0], strlen(@buf[0]), "0") == 0
    itoa(-5, @buf[0])
    assert bytes_differ(@buf[0], strlen(@buf[0]), "-5") == 0
    0

[[test]]
fn test_string_push_i64_min() -> i32
    var s: String = string_from_i64(i64_min())
    assert bytes_differ(string_as_ptr(@s), string_len(@s), "-9223372036854775808") == 0
    var h: String = string_from_hex(0xffffffffffffffff as u64)
    assert bytes_differ(string_as_ptr(@h), string_len(@h), "0xffffffffffffffff") == 0
    0

[[test]]
fn test_iovec_append_int_min() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    assert iovec_append_int(@b, i64_min()) == 20
    assert bytes_differ(b.iovecs[0].base, b.iovecs[0].len as i64, "-9223372036854775808") == 0
    assert iovec_append_int(@b, 0) == 1
    assert bytes_differ(b.iovecs[1].base, 1, "0") == 0
    assert iovec_append_uint(@b, 18446744073709551615 as u64) == 20
    assert bytes_differ(b.iovecs[2].base, 20, "18446744073709551615") == 0
    0

[[test]]
fn test_fmt_into() -> i32
    var buf: [32]u8
    assert fmt_i64_into(@buf[0], i64_min()) == 20
    assert bytes_differ(@buf[0], 20, "-9223372036854775808") == 0
    assert fmt_i64_into(@buf[0], 0) == 1
    assert buf[0] == '0'
    assert fmt_i64_into(@buf[0], -10) == 3
    assert bytes_differ(@buf[0], 3, "-10") == 0
    assert fmt_u64_into(@buf[0], 18446744073709551615 as u64) == 20
    assert bytes_differ(@buf[0], 20, "18446744073709551615") == 0
    assert fmt_u64_hex_into(@buf[0], 0xdeadbeef as u64) == 8
    assert bytes_differ(@buf[0], 8, "deadbeef") == 0
    assert fmt_u64_hex_into(@buf[0], 0) == 1
    assert buf[0] == '0'
    0
