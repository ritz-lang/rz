# AGAST #4773: a generic enum's `<T: Weigh>` is one type parameter with a
# bound.  ritz1 used to read an enum's parameters back off the source after
# its name, splitting at spaces and commas, so `<T: Weigh>` came back as two
# parameters, `T:` and `Weigh`, and `Slot<Crate>` was one argument short.
# The parser's own list is kept on the enum now.

trait Weigh
    fn weigh(self: *Self) -> i32

struct Crate
    kg: i32

impl Weigh for Crate
    fn weigh(self: *Crate) -> i32
        return self.kg

enum Slot<T: Weigh>
    Full(T)
    Empty

[[test]]
fn test_bounded_enum_full() -> i32
    var c: Crate
    c.kg = 7
    var s: Slot<Crate> = Full(c)
    let kg = match s
        Full(x) => x.kg
        Empty => 0
    if kg != 7
        return 1
    0

[[test]]
fn test_bounded_enum_empty() -> i32
    var s: Slot<Crate> = Empty
    let kg = match s
        Full(x) => x.kg
        Empty => 0 - 1
    if kg != 0 - 1
        return 1
    0
