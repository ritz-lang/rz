# Tier 1: Single-connection blocking echo server
# Tests: basic socket operations, sequential I/O
# Expected: Works but can only handle 1 connection at a time
#
# This is the simplest possible server - purely sequential.
# It demonstrates the baseline before adding concurrency.

import ritzlib.io
import ritzlib.memory
import ritzlib.async_net
import ritzlib.sys
import ritzlib.str
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.fmt
import ritzlib.gvec


fn handle_echo(client: @&Socket) -> i64
    var buf: Vec<u8> = vec_with_cap<u8>(4096)
    var total_bytes: i64 = 0

    # Echo loop - read until client closes
    loop
        buf.len = 0  # recv appends; reuse the buffer each round
        let n: i64 = match client.recv(@&buf, 4096)
            Ok(got) => got
            Err(_) => -1
        if n <= 0
            break

        # Echo back
        match client.send(Span<u8> { ptr: buf.data, len: n })
            Ok(_) => pass
            Err(_) => break

        total_bytes += n

    return total_bytes


fn run_server(port: i32, max_connections: i32)
    var srv: Socket
    match socket_tcp()
        Ok(s) => srv = s
        Err(_) =>
            print("Failed to create socket\n")
            return

    srv.set_reuseaddr()

    match srv.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            print("Failed to bind\n")
            srv.close()
            return

    match srv.listen(128)
        Ok(_) => pass
        Err(_) =>
            print("Failed to listen\n")
            srv.close()
            return

    print("Tier 1 Echo Server listening on port {port}\n")

    var connections_handled: i32 = 0

    while connections_handled < max_connections
        var client: Socket
        match srv.accept()
            Ok(c) => client = c
            Err(_) =>
                print("Accept failed\n")
                continue

        let bytes: i64 = handle_echo(@&client)
        client.close()

        connections_handled += 1
        print("Connection {connections_handled} handled, {bytes} bytes echoed\n")

    srv.close()
    print("Server finished after {connections_handled} connections\n")


# Port to listen on.  regression.sh passes a free per-run port in
# RITZ_EXAMPLE_PORT so concurrent runs on one host cannot collide (AGAST
# #1535); run by hand, the example keeps its historical default.
fn port_in_range(p: i64, default_port: i32) -> i32
    if p <= 0 or p > 65535
        return default_port
    return p as i32

fn port_or(o: Option<i64>, default_port: i32) -> i32
    match o
        Some(p) => port_in_range(p, default_port)
        None => default_port

# Unset, empty or non-numeric all fall back to the default.
fn listen_port(default_port: i32) -> i32
    let s: StrView = env_get_or("RITZ_EXAMPLE_PORT", "")
    return port_or(s.parse_i64(), default_port)


pub fn main() -> i32
    # Run server for 10 connections then exit (for testing)
    run_server(listen_port(9001), 10)
    return 0
