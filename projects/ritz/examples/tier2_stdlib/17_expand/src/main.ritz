# expand - convert tabs to spaces
#
# Usage: expand [OPTION]... [FILE]...
#   Convert tabs in each FILE to spaces, writing to standard output.
#
# Options:
#   -t N     set tab stops every N characters (default 8)
#   -i       only convert leading tabs (initial)
#
# Examples:
#   expand file.txt          # expand tabs to 8-space stops
#   expand -t 4 file.txt     # expand tabs to 4-space stops
#   expand -i file.txt       # only expand leading tabs

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct ExpandOptions
    tab_width: i32    # -t: tab stop width (default 8)
    initial_only: i32 # -i: only expand leading tabs

# ============================================================================
# Processing
# ============================================================================

fn process_fd(fd: i32, opts: *ExpandOptions) -> i32
    var buf: [4096]u8
    var outbuf: [8192]u8  # Larger to handle tab expansion
    var out_len: i64 = 0
    var column: i32 = 0       # Current column (for tab calculation)
    var at_line_start: i32 = 1 # Are we at the start of a line?

    loop
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n < 0
            return 1
        if n == 0
            break

        var i: i64 = 0
        while i < n
            let c: u8 = buf[i]

            if c == '\t'  # TAB
                # Check if we should expand this tab
                var expand: i32 = 1
                if opts.initial_only != 0 and at_line_start == 0
                    expand = 0

                if expand != 0
                    # Calculate spaces needed to reach next tab stop
                    let spaces: i32 = opts.tab_width - (column % opts.tab_width)
                    var j: i32 = 0
                    while j < spaces
                        outbuf[out_len] = 32  # space
                        out_len += 1
                        column += 1
                        j += 1

                        # Flush if buffer getting full
                        if out_len >= 8000
                            sys_write(STDOUT, @outbuf[0], out_len)
                            out_len = 0
                else
                    # Keep literal tab
                    outbuf[out_len] = c
                    out_len += 1
                    # Tab moves to next tab stop
                    column += opts.tab_width - (column % opts.tab_width)
                    at_line_start = 0

            else if c == '\n'  # newline
                outbuf[out_len] = c
                out_len += 1
                column = 0
                at_line_start = 1

            else
                outbuf[out_len] = c
                out_len += 1
                column += 1
                if c != ' '  # Not a space
                    at_line_start = 0

            # Flush if buffer getting full
            if out_len >= 8000
                sys_write(STDOUT, @outbuf[0], out_len)
                out_len = 0

            i += 1

    # Flush remaining
    if out_len > 0
        sys_write(STDOUT, @outbuf[0], out_len)

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("expand", "Convert tabs to spaces")
    argspec_option(@&spec, 't', "", "N", "Set tab stops every N characters", Some("8"))
    argspec_switch(@&spec, 'i', "", "Only convert leading tabs")
    argspec_positionals(@&spec, "FILE", "Input file(s)", 0, ARGS_UNLIMITED)
    spec

# A usage error (from argspec_parse, or -t that isn't a number): report it
# and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Expand one FILE (a view of an argv string: NUL-terminated, as sys_open
# needs).  Returns 1 on failure.
fn expand_path(path: StrView, opts: *ExpandOptions) -> i32
    let fd: i32 = sys_open(strview_as_cstr_unchecked(path), O_RDONLY)
    if fd < 0
        sys_write(STDERR, c"expand: cannot open file\n" as *u8, 25)
        return 1
    var status: i32 = 0
    if process_fd(fd, opts) != 0
        status = 1
    sys_close(fd)
    status

# Expand with tab stops every `width` columns; a width under 1 means the
# default of 8, as before.
fn expand(p: @ParsedArgs, width: i64) -> i32
    var opts: ExpandOptions
    opts.tab_width = 8
    if width > 0
        opts.tab_width = width as i32
    opts.initial_only = 0
    if parsed_switch(p, "i")
        opts.initial_only = 1

    var exit_code: i32 = 0
    let files = parsed_positionals(p)

    if files.len == 0
        # Read from stdin
        if process_fd(STDIN, @opts) != 0
            exit_code = 1
    else
        var i: i64 = 0
        while i < files.len
            if expand_path(span_get<StrView>(@files, i), @opts) != 0
                exit_code = 1
            i += 1

    exit_code

# -t defaults to 8, so parsed_int only fails on a value that isn't a whole
# number ("-t abc"), which is a usage error rather than a silent 8.
fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    let status: i32 = match parsed_int(@parsed, "t")
        Ok(n) => expand(@parsed, n)
        Err(e) => usage_error(spec, e)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let args = args_tail(@all)
    let status: i32 = match argspec_parse(@spec, args)
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    vec_drop<StrView>(@&all)
    status
