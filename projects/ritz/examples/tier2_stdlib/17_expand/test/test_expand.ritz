# Tests for 17_expand — convert tabs to spaces (default 8-column tab stops).
import ritzlib.testlib

fn expand_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./expand", span_empty<StrView>(), span_empty<StrView>(), stdin)

[[test]]
fn test_expand_single_tab() -> i32
    match expand_run("a\tb\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 10, "expected 10 bytes (a + 7 spaces + b + \\n)"
            assert buf_eq(c.output(), "a       b\n"), "single tab expansion failed"
        Err(_) =>
            assert false, "spawn ./expand"
    0

[[test]]
fn test_expand_multiple_tabs() -> i32
    match expand_run("a\tb\tc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 18, "expected 18 bytes"
            assert buf_eq(c.output(), "a       b       c\n"), "multiple tab expansion failed"
        Err(_) =>
            assert false, "spawn ./expand"
    0

[[test]]
fn test_expand_no_tabs_identity() -> i32
    match expand_run("hello world\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "hello world\n"), "no-tabs identity failed"
        Err(_) =>
            assert false, "spawn ./expand"
    0

[[test]]
fn test_expand_empty_input() -> i32
    match expand_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty in → empty out"
        Err(_) =>
            assert false, "spawn ./expand"
    0
