# Tests for 14_uniq — collapse adjacent duplicate lines.
import ritzlib.testlib

fn uniq_run(args: Span<StrView>, stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./uniq", args, span_empty<StrView>(), stdin)

[[test]]
fn test_uniq_default_dedupe_adjacent() -> i32
    match uniq_run(span_empty<StrView>(), "a\na\nb\nb\nb\nc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 6, "expected 6 bytes"
            assert buf_eq(c.output(), "a\nb\nc\n"), "default dedupe failed"
        Err(_) =>
            assert false, "spawn ./uniq"
    0

[[test]]
fn test_uniq_dash_d_only_dupes() -> i32
    let args: [1]StrView = ["-d"]
    match uniq_run(@args, "a\na\nb\nb\nb\nc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 4, "expected 4 bytes"
            assert buf_eq(c.output(), "a\nb\n"), "-d should emit only repeated lines"
        Err(_) =>
            assert false, "spawn ./uniq"
    0

[[test]]
fn test_uniq_dash_u_only_uniques() -> i32
    let args: [1]StrView = ["-u"]
    match uniq_run(@args, "a\na\nb\nb\nb\nc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 2, "expected 2 bytes (c\\n)"
            assert buf_eq(c.output(), "c\n"), "-u should emit only unique lines"
        Err(_) =>
            assert false, "spawn ./uniq"
    0

[[test]]
fn test_uniq_empty_input() -> i32
    match uniq_run(span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty in → empty out"
        Err(_) =>
            assert false, "spawn ./uniq"
    0

[[test]]
fn test_uniq_all_identical_collapses() -> i32
    match uniq_run(span_empty<StrView>(), "x\nx\nx\nx\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 2, "expected 2 bytes (x\\n)"
            assert buf_eq(c.output(), "x\n"), "4 identical → 1 line"
        Err(_) =>
            assert false, "spawn ./uniq"
    0
