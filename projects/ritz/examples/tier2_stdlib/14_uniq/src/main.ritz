# uniq - report or omit repeated lines
#
# Usage: uniq [OPTION]... [INPUT [OUTPUT]]
#   Filter adjacent matching lines from INPUT (or stdin), writing to OUTPUT (or stdout).
#   Note: Input should be sorted for uniq to work correctly.
#
# Options:
#   -c    prefix lines by the number of occurrences
#   -d    only print duplicate lines (appear more than once)
#   -u    only print unique lines (appear exactly once)
#   -i    ignore case when comparing (ASCII only)
#
# This example exercises:
#   - Argument parsing with ritzlib.argspec
#   - Vec<u8> and Vec<LineBounds> from ritzlib
#   - Line comparison with options
#   - Count tracking and formatting

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.fd { Fd, fd_open, fd_stdin, fd_stdout, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC }
import ritzlib.argspec
import ritzlib.fmt

# ============================================================================
# Options struct
# ============================================================================

struct UniqOptions
    count: i32       # -c: prefix with count
    duplicates: i32  # -d: only print duplicates
    unique: i32      # -u: only print unique
    ignore_case: i32 # -i: case insensitive

# ============================================================================
# String comparison
# ============================================================================

fn to_lower(c: i32) -> i32
    # Convert ASCII uppercase to lowercase
    if c >= 'A' and c <= 'Z'  # 'A' to 'Z'
        return c + 32
    return c

fn lines_equal(buf: @Vec<u8>, a: *LineBounds, b: *LineBounds, ignore_case: i32) -> i32
    # Compare two lines, return 1 if equal, 0 if different
    # Exclude trailing newline from comparison
    var a_len: i64 = a.length
    var b_len: i64 = b.length

    # Strip trailing newlines for comparison
    if a_len > 0 and *(buf.data + a.start + a_len - 1) == '\n'
        a_len -= 1
    if b_len > 0 and *(buf.data + b.start + b_len - 1) == '\n'
        b_len -= 1

    if a_len != b_len
        return 0

    var i: i64 = 0
    while i < a_len
        var a_byte: i32 = (*(buf.data + a.start + i)) as i32
        var b_byte: i32 = (*(buf.data + b.start + i)) as i32

        if ignore_case != 0
            a_byte = to_lower(a_byte)
            b_byte = to_lower(b_byte)

        if a_byte != b_byte
            return 0
        i += 1

    return 1

# ============================================================================
# Integer to string conversion
# ============================================================================

fn print_int_fd(out: @Fd, n: i64)
    var buf: [20]u8
    var w: Writer = span_writer(Span<u8> { ptr: @buf[0], len: 20 })
    fmt_show_i64(n, @&w)
    out.write_str(w.view())

# ============================================================================
# Core uniq logic
# ============================================================================

fn print_line_with_count(out: @Fd, buf: @Vec<u8>, bounds: *LineBounds, count: i64, show_count: i32)
    if show_count != 0
        # Print right-aligned count (7 chars) followed by space
        # For simplicity, just print count and space
        print_int_fd(out, count)
        out.write_str(" ")

    out.write_all(Span<u8> { ptr: buf.data + bounds.start, len: bounds.length })

    # Add newline if line doesn't have one
    if bounds.length == 0 or *(buf.data + bounds.start + bounds.length - 1) != '\n'
        out.write_str("\n")

fn should_print(count: i64, opts: *UniqOptions) -> i32
    # Determine if we should print based on count and options
    # -d: only duplicates (count > 1)
    # -u: only unique (count == 1)
    # default: print all

    if opts.duplicates != 0 and opts.unique != 0
        # Both -d and -u: print nothing (they're mutually exclusive in effect)
        return 0

    if opts.duplicates != 0
        if count > 1
            return 1
        return 0

    if opts.unique != 0
        if count == 1
            return 1
        return 0

    # Default: print everything
    return 1

fn process_uniq(buf: @Vec<u8>, lines: @Vec<LineBounds>, opts: *UniqOptions, out: @Fd)
    if lines.len == 0
        return

    var current_start: i64 = 0
    var count: i64 = 1

    var i: i64 = 1
    while i < lines.len
        let prev: *LineBounds = lines.data + i - 1
        let curr: *LineBounds = lines.data + i

        if lines_equal(buf, prev, curr, opts.ignore_case) != 0
            # Same as previous, increment count
            count += 1
        else
            # Different line, output the previous group if appropriate
            let first_of_group: *LineBounds = lines.data + current_start
            if should_print(count, opts) != 0
                print_line_with_count(out, buf, first_of_group, count, opts.count)

            # Start new group
            current_start = i
            count = 1

        i += 1

    # Output the last group
    let last_group: *LineBounds = lines.data + current_start
    if should_print(count, opts) != 0
        print_line_with_count(out, buf, last_group, count, opts.count)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("uniq", "Report or omit repeated lines")
    spec.switch('c', "count", "Prefix lines by the number of occurrences")
    spec.switch('d', "repeated", "Only print duplicate lines")
    spec.switch('u', "unique", "Only print unique lines")
    spec.switch('i', "ignore-case", "Ignore case when comparing (ASCII only)")
    # [INPUT [OUTPUT]] - both optional, at most 2
    spec.positionals("[INPUT [OUTPUT]]", "Input and output files (default: stdin/stdout)", 0, 2)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# UniqOptions keeps its i32 flags; this turns a switch into one.
fn switch_flag(p: @ParsedArgs, name: StrView) -> i32
    if p.switch(name)
        return 1
    0

fn uniq(p: @ParsedArgs) -> i32
    # Populate UniqOptions from parsed switches
    var opts: UniqOptions
    opts.count = switch_flag(p, "c")
    opts.duplicates = switch_flag(p, "d")
    opts.unique = switch_flag(p, "u")
    opts.ignore_case = switch_flag(p, "i")

    # argspec_parse has already capped the positionals at 2.
    let positionals = p.positionals()

    # Open input file (or use stdin, which is never closed)
    var input: Fd = fd_stdin()
    if positionals.len >= 1
        match fd_open(positionals.get(0), O_RDONLY, 0)
            Ok(f) => input = f
            Err(_) =>
                eprints("uniq: cannot open input file\n")
                return 1

    # Open output file (or use stdout, which is never closed)
    var output: Fd = fd_stdout()
    if positionals.len >= 2
        # Mode 0644 = 420
        match fd_open(positionals.get(1), O_WRONLY + O_CREAT + O_TRUNC, 420)
            Ok(f) => output = f
            Err(_) =>
                eprints("uniq: cannot open output file\n")
                input.close()
                return 1

    var buf: Vec<u8> = vec_with_cap<u8>(4096)
    var lines: Vec<LineBounds> = vec_with_cap<LineBounds>(64)

    match vec_read_all_fd(input.raw(), @&buf)
        Ok(_) => pass
        Err(_) =>
            if positionals.len >= 1
                input.close()
            return 1

    buf.find_lines(@&lines)
    process_uniq(@buf, @lines, @opts, @output)

    if positionals.len >= 1
        input.close()
    if positionals.len >= 2
        output.close()

    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = uniq(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let rest: Span<StrView> = args.from(1)
    let status: i32 = match spec.parse(rest)
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
