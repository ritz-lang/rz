# Tests for 15_cut — extract a field by delimiter.
import ritzlib.testlib

fn cut_run(delim: StrView, field: StrView, stdin: Span<u8>) -> Result<Captured, Errno>
    let args: [4]StrView = ["-d", delim, "-f", field]
    exec_capture("./cut", @args, span_empty<StrView>(), stdin)

[[test]]
fn test_cut_field_2() -> i32
    match cut_run(",", "2", "a,b,c\nd,e,f\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 4, "expected 4 bytes (b\\ne\\n)"
            assert buf_eq(c.output(), "b\ne\n"), "field 2 extraction failed"
        Err(_) =>
            assert false, "spawn ./cut"
    0

[[test]]
fn test_cut_field_1() -> i32
    match cut_run(",", "1", "a,b,c\nd,e,f\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 4, "expected 4 bytes (a\\nd\\n)"
            assert buf_eq(c.output(), "a\nd\n"), "field 1 extraction failed"
        Err(_) =>
            assert false, "spawn ./cut"
    0

[[test]]
fn test_cut_field_3() -> i32
    match cut_run(",", "3", "a,b,c\nd,e,f\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 4, "expected 4 bytes (c\\nf\\n)"
            assert buf_eq(c.output(), "c\nf\n"), "field 3 extraction failed"
        Err(_) =>
            assert false, "spawn ./cut"
    0

[[test]]
fn test_cut_empty_input() -> i32
    match cut_run(",", "1", "")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty input → empty output"
        Err(_) =>
            assert false, "spawn ./cut"
    0
