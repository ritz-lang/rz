# 11_grep: Fixed-string search utility
#
# Usage: grep PATTERN [FILE...]
#
# Searches for PATTERN in each FILE (or stdin if no files given).
# Prints lines that contain PATTERN.
#
# Features demonstrated:
# - Span<u8> for efficient byte slice views
# - Vec<u8> for buffered I/O
# - Method syntax (UFCS)
# - Line-by-line file reading
# - Substring search

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec
import ritzlib.fmt
import ritzlib.fd { Fd, fd_open, fd_adopt, fd_stdin, fd_stdout, O_RDONLY }

# ===== I/O with Vec<u8> =====

# The bytes of a Vec<u8> line as a StrView
fn line_view(line: *Vec<u8>) -> StrView
    StrView { ptr: line.as_ptr(), len: line.len() }

# Write a line from a Vec<u8> to stdout
fn write_line(line: *Vec<u8>)
    let out: Fd = fd_stdout()
    if line.len() > 0
        out.write_all(Span<u8> { ptr: line.as_ptr(), len: line.len() })
    out.write_str("\n")

# ===== Grep implementation =====

# Read an open file, printing lines that match pattern
# Returns number of matching lines
fn grep_fd(f: @Fd, pattern: StrView) -> i64
    var matches: i64 = 0

    # Read buffer for file I/O
    var read_buf: Vec<u8> = vec_with_cap<u8>(65536)

    # Line accumulator
    var line: Vec<u8> = vec_new<u8>()

    # Read in chunks
    var done: i32 = 0
    while done == 0
        # Ensure we have space to read
        read_buf.ensure_cap(4096)

        # Read directly into the Vec's buffer
        let n: i64 = match f.read(Span<u8> { ptr: read_buf.as_ptr() + read_buf.len(), len: 4096 })
            Ok(k) => k
            Err(_) => -1
        if n <= 0
            done = 1
        else
            # Process bytes read
            let start_pos: i64 = read_buf.len()
            for i in 0..n
                let c: u8 = *(read_buf.as_ptr() + start_pos + i)
                if c == '\n'  # '\n'
                    # Check if line matches pattern
                    if line_view(@line).contains(pattern)
                        write_line(@line)
                        matches += 1
                    # Reset line
                    line.clear()
                else
                    let _: bool = line.push(c)

    # Handle final partial line (no trailing newline)
    if line.len() > 0
        if line_view(@line).contains(pattern)
            write_line(@line)
            matches += 1

    # Vec<u8> cleanup is automatic via Drop trait
    matches

# Process a file by path
fn grep_file(path: StrView, pattern: StrView) -> i64
    var file: Fd = fd_adopt(-1)
    match fd_open(path, O_RDONLY, 0)
        Ok(f) => file = f
        Err(_) =>
            # Error opening file - print error message
            eprints("grep: ")
            eprints(path)
            eprints(": No such file\n")
            return -1

    let matches: i64 = grep_fd(@file, pattern)
    file.close()
    matches

# ===== Main =====

fn build_spec() -> ArgSpec
    var spec = argspec_new("grep", "Search for PATTERN in files")
    # PATTERN is required, then any number of FILEs: min 1, no upper bound.
    spec.positionals("PATTERN [FILE...]", "Pattern and files to search", 1, ARGS_UNLIMITED)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# Search FILE (a positional).  Returns 1 when the file couldn't be read.
fn grep_path(path: StrView, pattern: StrView, total: @&i64) -> i32
    let matches: i64 = grep_file(path, pattern)
    if matches < 0
        return 1
    *total = *total + matches
    0

fn grep(p: @ParsedArgs) -> i32
    # argspec_parse has checked that PATTERN is there (min 1).
    let positionals = p.positionals()
    let pattern: StrView = positionals.get(0)

    var total_matches: i64 = 0
    var had_error: i32 = 0

    if positionals.len == 1
        # No files - read from stdin
        let input: Fd = fd_stdin()
        let matches: i64 = grep_fd(@input, pattern)
        if matches < 0
            had_error = 1
        else
            total_matches += matches
    else
        # Each FILE in turn; positional 0 is PATTERN.
        var i: i64 = 1
        while i < positionals.len
            if grep_path(positionals.get(i), pattern, @&total_matches) != 0
                had_error = 1
            i += 1

    # Return 0 if any matches, 1 if no matches, 2 on error
    if had_error == 1
        return 2
    if total_matches == 0
        return 1
    0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = grep(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let rest: Span<StrView> = args.from(1)
    let status: i32 = match spec.parse(rest)
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
