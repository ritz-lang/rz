# 11_grep: Fixed-string search utility
#
# Usage: grep PATTERN [FILE...]
#
# Searches for PATTERN in each FILE (or stdin if no files given).
# Prints lines that contain PATTERN.
#
# Features demonstrated:
# - Span<u8> for efficient byte slice views
# - Vec<u8> for buffered I/O
# - Method syntax (UFCS)
# - Line-by-line file reading
# - Substring search

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec

# ===== I/O with Vec<u8> =====

# Write a line from a Vec<u8> to stdout
fn write_line(line: *Vec<u8>)
    if vec_len<u8>(line) > 0
        sys_write(STDOUT, vec_as_ptr<u8>(line), vec_len<u8>(line))
    sys_write(STDOUT, c"\n" as *u8, 1)

# ===== Grep implementation =====

# Process a file descriptor, printing lines that match pattern
# Returns number of matching lines
fn grep_fd(fd: i32, pattern: *Span<u8>) -> i64
    var matches: i64 = 0

    # Read buffer for file I/O
    var read_buf: Vec<u8> = vec_with_cap<u8>(65536)

    # Line accumulator
    var line: Vec<u8> = vec_new<u8>()

    # Read in chunks
    var done: i32 = 0
    while done == 0
        # Ensure we have space to read
        vec_ensure_cap<u8>(@&read_buf, 4096)

        # Read directly into the Vec's buffer
        let n: i64 = sys_read(fd, vec_as_ptr<u8>(@read_buf) + vec_len<u8>(@read_buf), 4096)
        if n <= 0
            done = 1
        else
            # Process bytes read
            let start_pos: i64 = vec_len<u8>(@read_buf)
            for i in 0..n
                let c: u8 = *(vec_as_ptr<u8>(@read_buf) + start_pos + i)
                if c == '\n'  # '\n'
                    # Check if line matches pattern
                    var line_span: Span<u8> = span_from_vec<u8>(@line)
                    if span_contains(@line_span, pattern)
                        write_line(@line)
                        matches += 1
                    # Reset line
                    vec_clear<u8>(@&line)
                else
                    let _: bool = vec_push<u8>(@&line, c)

    # Handle final partial line (no trailing newline)
    if vec_len<u8>(@line) > 0
        var line_span: Span<u8> = span_from_vec<u8>(@line)
        if span_contains(@line_span, pattern)
            write_line(@line)
            matches += 1

    # Vec<u8> cleanup is automatic via Drop trait
    matches

# Process a file by path
fn grep_file(path: *u8, pattern: *Span<u8>) -> i64
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        # Error opening file - print error message
        sys_write(STDERR, c"grep: " as *u8, 6)
        sys_write(STDERR, path, strlen(path))
        sys_write(STDERR, c": No such file\n" as *u8, 15)
        return -1

    let matches: i64 = grep_fd(fd, pattern)
    sys_close(fd)
    matches

# ===== Main =====

fn build_spec() -> ArgSpec
    var spec = argspec_new("grep", "Search for PATTERN in files")
    # PATTERN is required, then any number of FILEs: min 1, no upper bound.
    argspec_positionals(@&spec, "PATTERN [FILE...]", "Pattern and files to search", 1, ARGS_UNLIMITED)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Search FILE (a positional, so a view of an argv string: NUL-terminated, as
# sys_open needs).  Returns 1 when the file couldn't be read.
fn grep_path(path: StrView, pattern: *Span<u8>, total: @&i64) -> i32
    let matches: i64 = grep_file(strview_as_cstr_unchecked(path), pattern)
    if matches < 0
        return 1
    *total = *total + matches
    0

fn grep(p: @ParsedArgs) -> i32
    # argspec_parse has checked that PATTERN is there (min 1).
    let positionals = parsed_positionals(p)
    var pattern: Span<u8> = span_from_strview(span_get<StrView>(@positionals, 0))

    var total_matches: i64 = 0
    var had_error: i32 = 0

    if positionals.len == 1
        # No files - read from stdin
        let matches: i64 = grep_fd(STDIN, @pattern)
        if matches < 0
            had_error = 1
        else
            total_matches += matches
    else
        # Each FILE in turn; positional 0 is PATTERN.
        var i: i64 = 1
        while i < positionals.len
            if grep_path(span_get<StrView>(@positionals, i), @pattern, @&total_matches) != 0
                had_error = 1
            i += 1

    # Return 0 if any matches, 1 if no matches, 2 on error
    if had_error == 1
        return 2
    if total_matches == 0
        return 1
    0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = grep(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let args = args_tail(@all)
    let status: i32 = match argspec_parse(@spec, args)
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    vec_drop<StrView>(@&all)
    status
