# Tests for 11_grep — fixed-string substring search.
#
# Unit tests cover the substring-matching primitives that grep relies on
# (Span<u8>, span_contains).  Integration tests fork+exec ./grep via
# ritzlib.testlib.exec_capture and assert on captured stdout + exit code.

import ritzlib.span
import ritzlib.testlib

# ============================================================================
# Unit tests — Span<u8> and substring match primitives
# ============================================================================

[[test]]
fn test_span_from_cstr_len() -> i32
    let s: Span<u8> = "hello"
    assert s.len == 5
    0

[[test]]
fn test_span_contains_basic() -> i32
    var hay: Span<u8> = "apple"
    var needle: Span<u8> = "app"
    assert span_contains(@hay, @needle)
    0

[[test]]
fn test_span_contains_no_match() -> i32
    var hay: Span<u8> = "apple"
    var needle: Span<u8> = "xyz"
    assert not span_contains(@hay, @needle)
    0

[[test]]
fn test_span_contains_empty_needle() -> i32
    # Empty pattern should always match (matches grep semantics)
    var hay: Span<u8> = "abc"
    var needle: Span<u8> = ""
    assert span_contains(@hay, @needle)
    0

[[test]]
fn test_span_contains_at_end() -> i32
    var hay: Span<u8> = "banana"
    var needle: Span<u8> = "ana"
    assert span_contains(@hay, @needle)
    0

# ============================================================================
# Integration tests — fork+exec ./grep with stdin
# ============================================================================

[[test]]
fn test_grep_basic_match() -> i32
    let args: [1]StrView = ["ap"]
    match exec_capture("./grep", @args, span_empty<StrView>(), "apple\nbanana\napricot\ncherry\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0 (match found)"
            assert buf_eq(c.output(), "apple\napricot\n"), "output mismatch"
        Err(_) =>
            assert false, "spawn ./grep"
    0

[[test]]
fn test_grep_no_match() -> i32
    let args: [1]StrView = ["xyz"]
    match exec_capture("./grep", @args, span_empty<StrView>(), "one\ntwo\n")
        Ok(c) =>
            assert c.status.exit_code == 1, "exit code should be 1 (no match)"
            assert c.out.len == 0, "output should be empty"
        Err(_) =>
            assert false, "spawn ./grep"
    0

[[test]]
fn test_grep_empty_pattern_matches_all() -> i32
    let args: [1]StrView = [""]
    match exec_capture("./grep", @args, span_empty<StrView>(), "a\nb\nc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "empty pattern should match everything"
            assert buf_eq(c.output(), "a\nb\nc\n"), "output mismatch"
        Err(_) =>
            assert false, "spawn ./grep"
    0
