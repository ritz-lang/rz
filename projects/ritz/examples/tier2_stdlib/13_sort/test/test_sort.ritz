# Tests for 13_sort — sort lines.  No args.
import ritzlib.testlib

fn sort_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./sort", span_empty<StrView>(), span_empty<StrView>(), stdin)

[[test]]
fn test_sort_basic_alpha() -> i32
    match sort_run("c\na\nb\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 6, "expected 6 bytes"
            assert buf_eq(c.output(), "a\nb\nc\n"), "basic alpha sort failed"
        Err(_) =>
            assert false, "spawn ./sort"
    0

[[test]]
fn test_sort_idempotent() -> i32
    match sort_run("a\nb\nc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "a\nb\nc\n"), "already-sorted should be idempotent"
        Err(_) =>
            assert false, "spawn ./sort"
    0

[[test]]
fn test_sort_reverse_input() -> i32
    match sort_run("z\ny\nx\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "x\ny\nz\n"), "reverse input should sort"
        Err(_) =>
            assert false, "spawn ./sort"
    0

[[test]]
fn test_sort_empty_input() -> i32
    match sort_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty input → empty output"
        Err(_) =>
            assert false, "spawn ./sort"
    0

[[test]]
fn test_sort_duplicates_preserved() -> i32
    # Without -u, duplicates remain.
    match sort_run("b\na\na\nb\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 8, "expected 8 bytes (4 lines)"
            assert buf_eq(c.output(), "a\na\nb\nb\n"), "duplicates should be preserved"
        Err(_) =>
            assert false, "spawn ./sort"
    0
