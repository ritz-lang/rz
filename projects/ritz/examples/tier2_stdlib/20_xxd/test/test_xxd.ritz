# Tests for 20_xxd — hex dump.
import ritzlib.testlib

fn xxd_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./xxd", span_empty<StrView>(), span_empty<StrView>(), stdin)

[[test]]
fn test_xxd_hi_dump() -> i32
    # 'hi\n' is 3 bytes (0x68 0x69 0x0a).  Assert hex digits + ASCII + offset.
    match xxd_run("hi\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len > 0, "expected output"
            assert buf_contains(c.output(), "6869"), "missing 6869 hex"
            assert buf_contains(c.output(), "0a"), "missing 0a hex"
            assert buf_contains(c.output(), "hi"), "missing 'hi' ASCII"
            assert buf_contains(c.output(), "00000000"), "missing offset prefix"
        Err(_) =>
            assert false, "spawn ./xxd"
    0

[[test]]
fn test_xxd_empty_input() -> i32
    match xxd_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty in → empty out"
        Err(_) =>
            assert false, "spawn ./xxd"
    0

[[test]]
fn test_xxd_single_char() -> i32
    match xxd_run("A")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len > 0, "expected output"
            assert buf_contains(c.output(), "41"), "missing 41 hex"
        Err(_) =>
            assert false, "spawn ./xxd"
    0
