# Tests for 20_xxd — hex dump.
import ritzlib.testlib

fn xxd_run(stdin_content: *u8, stdin_len: i64, out_buf: *u8, out_len: *i64) -> i32
    var argv: [2]*u8
    argv[0] = c"./xxd"
    argv[1] = null
    return exec_capture(c"./xxd", @argv[0], null, Span<u8> { ptr: (stdin_content), len: (stdin_len) }, Span<u8> { ptr: (out_buf), len: (1024) }, out_len)

[[test]]
fn test_xxd_hi_dump() -> i32
    # 'hi\n' is 3 bytes (0x68 0x69 0x0a).  Assert hex digits + ASCII + offset.
    var out: [1024]u8
    var n: i64 = 0
    let exit_code: i32 = xxd_run(c"hi\n", 3, @out[0], @n)
    assert exit_code == 0, "exit code should be 0"
    assert n > 0, "expected output"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"6869"), len: (4) }), "missing 6869 hex"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"0a"), len: (2) }), "missing 0a hex"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"hi"), len: (2) }), "missing 'hi' ASCII"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"00000000"), len: (8) }), "missing offset prefix"
    0

[[test]]
fn test_xxd_empty_input() -> i32
    var out: [1024]u8
    var n: i64 = 0
    let exit_code: i32 = xxd_run(c"", 0, @out[0], @n)
    assert exit_code == 0, "exit code should be 0"
    assert n == 0, "empty in → empty out"
    0

[[test]]
fn test_xxd_single_char() -> i32
    var out: [1024]u8
    var n: i64 = 0
    let exit_code: i32 = xxd_run(c"A", 1, @out[0], @n)
    assert exit_code == 0, "exit code should be 0"
    assert n > 0, "expected output"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"41"), len: (2) }), "missing 41 hex"
    0
