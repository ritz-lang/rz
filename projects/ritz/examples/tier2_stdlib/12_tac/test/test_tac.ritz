# Tests for 12_tac — reverse line order.  tac takes no args.
import ritzlib.testlib

fn tac_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./tac", span_empty<StrView>(), span_empty<StrView>(), stdin)

[[test]]
fn test_tac_basic_reverse() -> i32
    match tac_run("1\n2\n3\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 6, "expected 6 bytes back"
            assert buf_eq(c.output(), "3\n2\n1\n"), "reversed output mismatch"
        Err(_) =>
            assert false, "spawn ./tac"
    0

[[test]]
fn test_tac_single_line() -> i32
    match tac_run("only\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 5, "single line should be roundtripped"
            assert buf_eq(c.output(), "only\n"), "single-line content mismatch"
        Err(_) =>
            assert false, "spawn ./tac"
    0

[[test]]
fn test_tac_empty_input() -> i32
    match tac_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty input → empty output"
        Err(_) =>
            assert false, "spawn ./tac"
    0

[[test]]
fn test_tac_five_lines() -> i32
    match tac_run("a\nb\nc\nd\ne\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 10, "expected 10 bytes back"
            assert buf_eq(c.output(), "e\nd\nc\nb\na\n"), "5-line reverse mismatch"
        Err(_) =>
            assert false, "spawn ./tac"
    0
