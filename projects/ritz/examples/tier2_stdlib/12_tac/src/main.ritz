# tac - concatenate and print files in reverse (line by line)
#
# Usage: tac [FILE...]
#   If no files given, reads stdin
#   Prints lines in reverse order (last line first)
#
# This example exercises:
#   - Vec<u8> for storing file content
#   - Vec<LineBounds> for storing line positions
#   - Line iteration and slicing

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.result
import ritzlib.strview { StrView }
import ritzlib.span { Span }
import ritzlib.fd { Fd, fd_open, fd_adopt, fd_stdin, fd_stdout, O_RDONLY }

# ============================================================================
# Core tac logic
# ============================================================================

fn print_lines_reversed(buf: @Vec<u8>, lines: @Vec<LineBounds>)
    var i: i64 = lines.len - 1
    while i >= 0
        let bounds: *LineBounds = lines.data + i
        fd_stdout().write_all(Span<u8> { ptr: buf.data + bounds.start, len: bounds.length })
        i -= 1

fn tac_fd(f: @Fd) -> i32
    # Process a file descriptor, return 0 on success, 1 on error
    var buf: Vec<u8> = vec_with_cap<u8>(4096)
    var lines: Vec<LineBounds> = vec_with_cap<LineBounds>(64)

    match vec_read_all_fd(f.raw(), @&buf)
        Ok(_) => pass
        Err(_) => return 1

    buf.find_lines(@&lines)
    print_lines_reversed(@buf, @lines)

    return 0

fn tac_file(path: StrView) -> i32
    var file: Fd = fd_adopt(-1)
    match fd_open(path, O_RDONLY, 0)
        Ok(f) => file = f
        Err(_) =>
            eprints("tac: cannot open file\n")
            return 1

    let result: i32 = tac_fd(@file)
    file.close()
    return result

# ============================================================================
# Main entry point
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        # No files - read from stdin
        let input: Fd = fd_stdin()
        return tac_fd(@input)

    var exit_code: i32 = 0
    var i: i64 = 1

    while i < args.len
        let result: i32 = tac_file(args[i])
        if result != 0
            exit_code = result
        i += 1

    return exit_code
