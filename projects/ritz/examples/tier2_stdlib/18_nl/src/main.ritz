# nl - number lines of files
#
# Usage: nl [OPTION]... [FILE]...
#   Write each FILE to standard output with line numbers added.
#
# Options:
#   -b STYLE  numbering style: a=all, t=non-empty (default), n=none
#   -w WIDTH  use WIDTH columns for line numbers (default 6)
#   -s SEP    use SEP as separator after number (default TAB)
#   -n FORMAT number format: ln=left, rn=right (default), rz=right with zeros
#
# Examples:
#   nl file.txt             # number non-empty lines
#   nl -ba file.txt         # number all lines
#   nl -w3 -s': ' file.txt  # 3-digit numbers with ": " separator

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct NlOptions
    body_style: i32    # 0=none, 1=non-empty (default), 2=all
    width: i32         # line number width (default 6)
    separator: *u8     # separator after number
    sep_len: i64       # length of separator
    format: i32        # 0=right justified, 1=left justified, 2=right with zeros

# ============================================================================
# Integer formatting
# ============================================================================

fn format_number(n: i64, buf: *u8, width: i32, format: i32) -> i64
    # Format number into buf, return bytes written
    var digits: [20]u8
    var digit_count: i32 = 0

    # Extract digits (reverse order)
    var num: i64 = n
    if num == 0
        digits[0] = 48  # '0'
        digit_count = 1
    else
        while num > 0
            digits[digit_count] = ((num % 10) + '0') as u8
            num /= 10
            digit_count += 1

    var pos: i64 = 0

    if format == 1
        # Left justified: digits first, then spaces
        var i: i32 = digit_count - 1
        while i >= 0
            *(buf + pos) = digits[i]
            pos += 1
            i -= 1

        while pos < width as i64
            *(buf + pos) = 32  # space
            pos += 1
    else if format == 2
        # Right justified with zeros
        var padding: i32 = width - digit_count
        while padding > 0
            *(buf + pos) = 48  # '0'
            pos += 1
            padding -= 1

        var i: i32 = digit_count - 1
        while i >= 0
            *(buf + pos) = digits[i]
            pos += 1
            i -= 1
    else
        # Right justified with spaces (default)
        var padding: i32 = width - digit_count
        while padding > 0
            *(buf + pos) = 32  # space
            pos += 1
            padding -= 1

        var i: i32 = digit_count - 1
        while i >= 0
            *(buf + pos) = digits[i]
            pos += 1
            i -= 1

    return pos

# ============================================================================
# Processing
# ============================================================================

fn is_empty_line(line: *u8, len: i64) -> i32
    # Check if line is empty (only whitespace/newline)
    if len == 0
        return 1
    if len == 1 and *line == '\n'
        return 1
    return 0

fn process_fd(fd: i32, opts: *NlOptions, line_num: *i64) -> i32
    var buf: [4096]u8
    var linebuf: [8192]u8
    var line_len: i64 = 0

    loop
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n < 0
            return 1
        if n == 0
            break

        var i: i64 = 0
        while i < n
            let c: u8 = buf[i]
            linebuf[line_len] = c
            line_len += 1

            if c == '\n'  # newline - process line
                # Determine if we should number this line
                var should_number: i32 = 0
                if opts.body_style == 2  # all
                    should_number = 1
                else if opts.body_style == 1  # non-empty
                    if is_empty_line(@linebuf[0], line_len) == 0
                        should_number = 1

                if should_number != 0
                    # Format and write line number
                    var numbuf: [32]u8
                    let num_len: i64 = format_number(*line_num, @numbuf[0], opts.width, opts.format)
                    sys_write(STDOUT, @numbuf[0], num_len)
                    sys_write(STDOUT, opts.separator, opts.sep_len)
                    *line_num = *line_num + 1
                else
                    # Write blank prefix for unnumbered lines
                    var j: i32 = 0
                    while j < opts.width
                        sys_write(STDOUT, c" " as *u8, 1)
                        j += 1
                    sys_write(STDOUT, opts.separator, opts.sep_len)

                # Write line content
                sys_write(STDOUT, @linebuf[0], line_len)
                line_len = 0

            i += 1

    # Handle last line without newline
    if line_len > 0
        var should_number: i32 = 0
        if opts.body_style == 2
            should_number = 1
        else if opts.body_style == 1
            if is_empty_line(@linebuf[0], line_len) == 0
                should_number = 1

        if should_number != 0
            var numbuf: [32]u8
            let num_len: i64 = format_number(*line_num, @numbuf[0], opts.width, opts.format)
            sys_write(STDOUT, @numbuf[0], num_len)
            sys_write(STDOUT, opts.separator, opts.sep_len)
            *line_num = *line_num + 1
        else
            var j: i32 = 0
            while j < opts.width
                sys_write(STDOUT, c" " as *u8, 1)
                j += 1
            sys_write(STDOUT, opts.separator, opts.sep_len)

        sys_write(STDOUT, @linebuf[0], line_len)
        sys_write(STDOUT, c"\n" as *u8, 1)

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("nl", "Number lines of files")
    argspec_option(@&spec, 'b', "body-numbering", "STYLE", "Numbering style: a=all, t=non-empty, n=none", Some("t"))
    argspec_option(@&spec, 'w', "number-width", "WIDTH", "Use WIDTH columns for line numbers", Some("6"))
    argspec_option(@&spec, 's', "number-separator", "SEP", "Use SEP as separator after number", Some("\t"))
    argspec_option(@&spec, 'n', "number-format", "FORMAT", "Number format: ln=left, rn=right, rz=right with zeros", Some("rn"))
    argspec_positionals(@&spec, "FILE", "Input file(s)", 0, ARGS_UNLIMITED)
    spec

# A usage error (from argspec_parse, or -w that isn't a number): report it
# and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Byte i of s, or 0 past its end -- what the C-string checks this replaces
# saw at the terminator, so "-n l" is still rejected and "-b all" accepted.
fn byte_at(s: StrView, i: i64) -> u8
    if i < s.len
        return strview_get(s, i)
    0

# -b STYLE -> 0=none, 1=non-empty, 2=all; -1 when it is none of those.
fn body_style_of(s: StrView) -> i32
    let c = byte_at(s, 0)
    if c == 'a'
        return 2
    if c == 't'
        return 1
    if c == 'n'
        return 0
    -1

# -n FORMAT -> 0=right, 1=left, 2=right with zeros; -1 when it is none of those.
fn format_of(s: StrView) -> i32
    let c0 = byte_at(s, 0)
    let c1 = byte_at(s, 1)
    if c0 == 'l' and c1 == 'n'
        return 1
    if c0 == 'r' and c1 == 'n'
        return 0
    if c0 == 'r' and c1 == 'z'
        return 2
    -1

# -b, -s and -n all have defaults, so their None arms are those defaults.
fn style_value(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => "t"

fn separator_value(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => "\t"

fn format_value(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => "rn"

# Number one FILE (a view of an argv string: NUL-terminated, as sys_open
# needs).  Returns 1 on failure.
fn nl_path(path: StrView, opts: *NlOptions, line_num: *i64) -> i32
    let fd: i32 = sys_open(strview_as_cstr_unchecked(path), O_RDONLY)
    if fd < 0
        sys_write(STDERR, c"nl: cannot open file\n" as *u8, 21)
        return 1
    var status: i32 = 0
    if process_fd(fd, opts, line_num) != 0
        status = 1
    sys_close(fd)
    status

fn nl(p: @ParsedArgs, width: i64) -> i32
    var opts: NlOptions

    # Interpret -b (body numbering style)
    opts.body_style = body_style_of(style_value(parsed_value(p, "b")))
    if opts.body_style < 0
        sys_write(STDERR, c"nl: invalid body style\n" as *u8, 23)
        return 1

    # -w (width), already parsed by the caller
    opts.width = width as i32

    # Interpret -s (separator).  The value is a view of an argv string or of
    # the default literal, so its pointer is NUL-terminated as well.
    let sep = separator_value(parsed_value(p, "s"))
    opts.separator = strview_as_cstr_unchecked(sep)
    opts.sep_len = sep.len

    # Interpret -n (number format)
    opts.format = format_of(format_value(parsed_value(p, "n")))
    if opts.format < 0
        sys_write(STDERR, c"nl: invalid number format\n" as *u8, 26)
        return 1

    var line_num: i64 = 1
    var exit_code: i32 = 0
    let files = parsed_positionals(p)

    if files.len == 0
        if process_fd(STDIN, @opts, @line_num) != 0
            exit_code = 1
    else
        var i: i64 = 0
        while i < files.len
            if nl_path(span_get<StrView>(@files, i), @opts, @line_num) != 0
                exit_code = 1
            i += 1

    exit_code

# -w defaults to 6, so parsed_int only fails on a value that isn't a whole
# number ("-w abc"), which is a usage error rather than a silent 0.
fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    let status: i32 = match parsed_int(@parsed, "w")
        Ok(n) => nl(@parsed, n)
        Err(e) => usage_error(spec, e)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let args = args_tail(@all)
    let status: i32 = match argspec_parse(@spec, args)
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    vec_drop<StrView>(@&all)
    status
