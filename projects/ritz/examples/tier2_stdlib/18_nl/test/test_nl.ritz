# Tests for 18_nl — number lines (default format: 5-space-padded number, tab, content).
import ritzlib.testlib

fn nl_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./nl", span_empty<StrView>(), span_empty<StrView>(), stdin)

[[test]]
fn test_nl_basic_three_lines() -> i32
    match nl_run("first\nsecond\nthird\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 40, "expected 40 bytes"
            assert buf_eq(c.output(), "     1\tfirst\n     2\tsecond\n     3\tthird\n"), "basic numbering failed"
        Err(_) =>
            assert false, "spawn ./nl"
    0

[[test]]
fn test_nl_single_line() -> i32
    match nl_run("only\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 12, "expected 12 bytes"
            assert buf_eq(c.output(), "     1\tonly\n"), "single-line numbering failed"
        Err(_) =>
            assert false, "spawn ./nl"
    0

[[test]]
fn test_nl_empty_input() -> i32
    match nl_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty in → empty out"
        Err(_) =>
            assert false, "spawn ./nl"
    0
