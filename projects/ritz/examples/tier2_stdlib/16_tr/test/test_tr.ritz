# Tests for 16_tr — translate or delete characters.
import ritzlib.testlib

fn tr_run(set1: StrView, set2: StrView, stdin: Span<u8>) -> Result<Captured, Errno>
    let args: [2]StrView = [set1, set2]
    exec_capture("./tr", @args, span_empty<StrView>(), stdin)

[[test]]
fn test_tr_lowercase_to_uppercase() -> i32
    match tr_run("a-z", "A-Z", "Hello World\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 12, "length should be preserved"
            assert buf_eq(c.output(), "HELLO WORLD\n"), "lowercase→uppercase failed"
        Err(_) =>
            assert false, "spawn ./tr"
    0

[[test]]
fn test_tr_uppercase_to_lowercase() -> i32
    match tr_run("A-Z", "a-z", "Hello World\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "hello world\n"), "uppercase→lowercase failed"
        Err(_) =>
            assert false, "spawn ./tr"
    0

[[test]]
fn test_tr_single_char() -> i32
    match tr_run("b", "Z", "abc\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "aZc\n"), "single-char translation failed"
        Err(_) =>
            assert false, "spawn ./tr"
    0

[[test]]
fn test_tr_empty_input() -> i32
    match tr_run("a", "b", "")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty input → empty output"
        Err(_) =>
            assert false, "spawn ./tr"
    0

[[test]]
fn test_tr_identity() -> i32
    # set1 == set2 should leave content unchanged
    match tr_run("a-z", "a-z", "hello\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert buf_eq(c.output(), "hello\n"), "identity translation failed"
        Err(_) =>
            assert false, "spawn ./tr"
    0
