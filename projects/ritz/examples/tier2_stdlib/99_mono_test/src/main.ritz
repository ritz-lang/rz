# Test monomorphization of imported generic functions

import ritzlib.sys   # sys_write (gvec no longer imports sys: AGAST #4119)
import ritzlib.gvec

fn main() -> i32
    # Test: Call vec_new<u8> from imported module
    var v: Vec<u8> = vec_new<u8>()

    # Verify it works
    if v.len() == 0
        prints_cstr(c"OK: vec_len works\n")

    0

fn prints_cstr(s: *u8)
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    sys_write(1, s, len)
