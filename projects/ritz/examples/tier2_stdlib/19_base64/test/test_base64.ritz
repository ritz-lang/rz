# Tests for 19_base64 — base64 encode stdin.
import ritzlib.testlib

fn base64_run(stdin: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./base64", span_empty<StrView>(), span_empty<StrView>(), stdin)

# true when `out` begins with `prefix` (the encoder may add a trailing newline).
fn out_starts_with(out: Span<u8>, prefix: Span<u8>) -> bool
    if out.len < prefix.len
        return false
    buf_eq(Span<u8> { ptr: out.ptr, len: prefix.len }, prefix)

[[test]]
fn test_base64_encode_hello() -> i32
    # Classic vector — "hello\n" → "aGVsbG8K".
    match base64_run("hello\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len >= 8, "expected at least 8 bytes (aGVsbG8K)"
            assert out_starts_with(c.output(), "aGVsbG8K"), "base64 hello mismatch"
        Err(_) =>
            assert false, "spawn ./base64"
    0

[[test]]
fn test_base64_encode_empty() -> i32
    match base64_run("")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len == 0, "empty in → empty out"
        Err(_) =>
            assert false, "spawn ./base64"
    0

[[test]]
fn test_base64_encode_one_byte() -> i32
    # 'A' (1 byte) → "QQ==" (double-pad)
    match base64_run("A")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len >= 4, "expected at least 4 bytes (QQ==)"
            assert out_starts_with(c.output(), "QQ=="), "single-byte encoding failed"
        Err(_) =>
            assert false, "spawn ./base64"
    0

[[test]]
fn test_base64_encode_two_bytes() -> i32
    # 'AB' → "QUI=" (single-pad)
    match base64_run("AB")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len >= 4, "expected at least 4 bytes (QUI=)"
            assert out_starts_with(c.output(), "QUI="), "two-byte encoding failed"
        Err(_) =>
            assert false, "spawn ./base64"
    0

[[test]]
fn test_base64_encode_three_bytes() -> i32
    # 'ABC' → "QUJD" (no padding)
    match base64_run("ABC")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit code should be 0"
            assert c.out.len >= 4, "expected at least 4 bytes"
            assert out_starts_with(c.output(), "QUJD"), "three-byte encoding failed"
        Err(_) =>
            assert false, "spawn ./base64"
    0
