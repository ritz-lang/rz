# Tier 3: Concurrent HTTP server using io_uring with keep-alive support
# Tests: HTTP parsing + io_uring submit/complete cycle + multiple connections + keep-alive
#
# Architecture:
# - One io_uring ring handles all I/O (accept, recv, send)
# - Connection state tracked in fixed-size arrays
# - User data encodes slot and operation type
# - HTTP/1.1 keep-alive: reuse connections for multiple requests

import ritzlib.io
import ritzlib.async_net
import ritzlib.uring
import ritzlib.result
import ritzlib.errno { Errno }
import ritzlib.sys
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.fmt
import ritzlib.fd { Fd, fd_adopt }


# ============================================================================
# Constants
# ============================================================================

const OP_ACCEPT: i64 = 1
const OP_RECV: i64 = 2
const OP_SEND: i64 = 3

const MAX_CONNS: i32 = 256
const BUF_SIZE: i32 = 4096

# Parse results
const PARSE_OK: i32 = 0
const PARSE_INCOMPLETE: i32 = -1
const PARSE_ERROR: i32 = -2


# ============================================================================
# User data encoding (slot << 8 | op)
# ============================================================================

fn encode_user_data(slot: i32, op: i64) -> i64
    return ((slot as i64) << 8) | op


fn decode_slot(user_data: i64) -> i32
    return ((user_data >> 8) & 0xFFFF) as i32


fn decode_op(user_data: i64) -> i64
    return user_data & 0xFF


# ============================================================================
# Response templates
# ============================================================================

fn response_ok() -> StrView
    "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK"


fn response_ok_keepalive() -> StrView
    "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nOK"


fn response_not_found() -> StrView
    "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found"


# Per-connection receive and send buffers: BUF_SIZE bytes for each of the
# MAX_CONNS slots, zeroed at load.
var RECV_MEM: [1048576]u8  # MAX_CONNS * BUF_SIZE
var SEND_MEM: [1048576]u8  # MAX_CONNS * BUF_SIZE


# ============================================================================
# Simple HTTP request parser
# ============================================================================

struct ParsedRequest
    path_start: i32
    path_len: i32
    http_11: i32       # 1 if HTTP/1.1
    keep_alive: i32    # 1 if should keep alive


fn parse_request(buf: *u8, len: i32, req: *ParsedRequest) -> i32
    # Validate input
    if buf == null
        return PARSE_ERROR
    if len < 14
        return PARSE_INCOMPLETE
    if len > BUF_SIZE
        return PARSE_ERROR  # Corrupted length

    # Find end of request line (first \r\n)
    var line_end: i32 = -1
    for i in 0..(len - 1)
        if *(buf + i) == 13 and *(buf + i + 1) == 10
            line_end = i
            break

    if line_end < 0
        return PARSE_INCOMPLETE

    # Find path start (after first space)
    var path_start: i32 = 0
    for i in 0..line_end
        if *(buf + i) == 32  # space
            path_start = i + 1
            break

    # Find path end (space before HTTP version)
    var path_end: i32 = path_start
    for i in path_start..line_end
        if *(buf + i) == 32  # space
            path_end = i
            break

    req.path_start = path_start
    req.path_len = path_end - path_start

    # Default values
    req.http_11 = 0
    req.keep_alive = 0

    # Check HTTP version (HTTP/1.1 = keep-alive by default)
    let version_pos = path_end + 1
    if version_pos + 8 <= line_end + 1
        # Check for "HTTP/1.1" - byte 7 is '1' for 1.1, '0' for 1.0
        if *(buf + version_pos + 7) == 49  # '1'
            req.http_11 = 1
            req.keep_alive = 1  # HTTP/1.1 defaults to keep-alive

    # Find end of headers (\r\n\r\n)
    for i in (line_end + 2)..(len - 3)
        if *(buf + i) == 13 and *(buf + i + 1) == 10 and *(buf + i + 2) == 13 and *(buf + i + 3) == 10
            return PARSE_OK

    return PARSE_INCOMPLETE


fn match_path(buf: *u8, path_start: i32, path_len: i32, target: StrView) -> i32
    if path_len as i64 != target.len
        return 0
    for i in 0..path_len
        if *(buf + path_start + i) != target.get(i as i64)
            return 0
    return 1


# ============================================================================
# Main server loop
# ============================================================================

# The ring could not be set up: say why, and close the listener.
fn no_ring(e: Errno, srv: @&Socket)
    print("Failed to init io_uring: {e.name()}\n")
    srv.close()

fn run_server(port: i32)
    var srv: Socket
    match socket_tcp()
        Ok(s) => srv = s
        Err(_) =>
            print("Failed to create socket\n")
            return

    srv.set_reuseaddr()
    srv.set_reuseport()

    match srv.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            print("Failed to bind\n")
            srv.close()
            return

    match srv.listen(1024)
        Ok(_) => pass
        Err(_) =>
            print("Failed to listen\n")
            srv.close()
            return

    # The ring's accept SQEs take the descriptor.
    let server_fd: i32 = srv.raw()

    print("Tier 3 HTTP Server (io_uring + keep-alive) on port {port}\n")

    var ring: IoUring = match IoUring.new(256)
        Ok(r) => r
        Err(e) => return no_ring(e, @&srv)

    # Connection state arrays (MAX_CONNS slots; closed Fd = free slot)
    var conn_fds: [256]Fd
    var conn_keep_alive: [256]i32
    var recv_bufs: [256]*u8
    var send_bufs: [256]*u8

    for i in 0..MAX_CONNS
        conn_fds[i] = fd_adopt(-1)
        conn_keep_alive[i] = 0
        recv_bufs[i] = @RECV_MEM[(i * BUF_SIZE) as i64]
        send_bufs[i] = @SEND_MEM[(i * BUF_SIZE) as i64]

    # Pre-allocate request/response buffers to avoid stack exhaustion in event loop
    var req: ParsedRequest
    var resp: StrView = response_not_found()
    var keep_alive: i32

    # Submit initial accept
    var accept_sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => accept_sqe = p
        None =>
            print("FAIL: could not get accept SQE\n")
            return
    accept_sqe.prep_accept(server_fd, 0, encode_user_data(0, OP_ACCEPT))
    ring.sqe_submit()
    ring.submit()

    # Event loop
    loop
        match ring.submit_and_wait(1)
            Ok(_) => pass
            Err(_) => break

        loop
            let cqe: @IoUringCqe = match ring.peek_cqe()
                Some(p) => p
                None => break

            let user_data: i64 = cqe.get_data64()
            let result: i32 = cqe.res
            let slot: i32 = decode_slot(user_data)
            let op: i64 = decode_op(user_data)

            ring.cqe_seen(@*cqe)

            if op == OP_ACCEPT
                if result >= 0
                    # Find free slot
                    var found_slot: i32 = -1
                    for i in 0..MAX_CONNS
                        if not conn_fds[i].valid()
                            found_slot = i
                            break

                    if found_slot >= 0
                        conn_fds[found_slot] = fd_adopt(result)
                        conn_keep_alive[found_slot] = 0

                        # Submit recv for this connection
                        var recv_sqe: *IoUringSqe = null
                        match ring.get_sqe()
                            Some(p) => recv_sqe = p
                            None =>
                                # SQ full - close connection
                                conn_fds[found_slot].close()
                        if recv_sqe != null
                            recv_sqe.prep_recv(result, Span<u8> { ptr: recv_bufs[found_slot], len: BUF_SIZE as i64 }, 0, encode_user_data(found_slot, OP_RECV))
                            ring.sqe_submit()
                    else
                        # No free slots
                        var rejected: Fd = fd_adopt(result)
                        rejected.close()

                # Always re-submit accept
                match ring.get_sqe()
                    Some(p) =>
                        let new_accept: *IoUringSqe = p
                        new_accept.prep_accept(server_fd, 0, encode_user_data(0, OP_ACCEPT))
                        ring.sqe_submit()
                    None => pass

            else if op == OP_RECV
                # Validate slot is still active
                if slot < 0 or slot >= MAX_CONNS or not conn_fds[slot].valid()
                    continue  # Stale completion - connection already closed

                if result <= 0
                    # Connection closed or error
                    conn_fds[slot].close()
                    conn_keep_alive[slot] = 0
                else
                    # Parse request (req, resp, keep_alive pre-allocated outside loop)
                    let parse_result = parse_request(recv_bufs[slot], result, @req)

                    # Reset response variables for this iteration
                    keep_alive = 0

                    if parse_result == PARSE_OK
                        # Check route and set response
                        if match_path(recv_bufs[slot], req.path_start, req.path_len, "/health") != 0
                            keep_alive = req.keep_alive
                        else if match_path(recv_bufs[slot], req.path_start, req.path_len, "/") != 0
                            keep_alive = req.keep_alive
                        else
                            keep_alive = 0  # 404 always closes

                        if keep_alive != 0
                            resp = response_ok_keepalive()
                        else
                            resp = response_ok()
                    else
                        resp = response_not_found()

                    # Remember if we should keep alive
                    conn_keep_alive[slot] = keep_alive

                    # Copy response to send buffer
                    var send_buf: Span<u8> = Span<u8> { ptr: send_bufs[slot], len: BUF_SIZE as i64 }
                    let resp_len: i64 = send_buf.copy_from(span_from_strview(resp))

                    # Submit send
                    var send_sqe: *IoUringSqe = null
                    match ring.get_sqe()
                        Some(p) => send_sqe = p
                        None =>
                            # SQ full - close connection
                            conn_fds[slot].close()
                    if send_sqe != null
                        send_sqe.prep_send(conn_fds[slot].raw(), Span<u8> { ptr: send_bufs[slot], len: resp_len }, 0, encode_user_data(slot, OP_SEND))
                        ring.sqe_submit()

            else if op == OP_SEND
                # Validate slot is still active
                if slot < 0 or slot >= MAX_CONNS or not conn_fds[slot].valid()
                    continue  # Stale completion - connection already closed

                if result < 0
                    # Send error - close connection
                    conn_fds[slot].close()
                    conn_keep_alive[slot] = 0
                else
                    if conn_keep_alive[slot] != 0
                        # Keep-alive: submit another recv
                        var recv_sqe2: *IoUringSqe = null
                        match ring.get_sqe()
                            Some(p) => recv_sqe2 = p
                            None =>
                                # SQ full - close connection
                                conn_fds[slot].close()
                        if recv_sqe2 != null
                            recv_sqe2.prep_recv(conn_fds[slot].raw(), Span<u8> { ptr: recv_bufs[slot], len: BUF_SIZE as i64 }, 0, encode_user_data(slot, OP_RECV))
                            ring.sqe_submit()
                    else
                        # Close connection
                        conn_fds[slot].close()


# Port to listen on.  regression.sh passes a free per-run port in
# RITZ_EXAMPLE_PORT so concurrent runs on one host cannot collide (AGAST
# #1535); run by hand, the example keeps its historical default.
fn port_in_range(p: i64, default_port: i32) -> i32
    if p <= 0 or p > 65535
        return default_port
    return p as i32

fn port_or(o: Option<i64>, default_port: i32) -> i32
    match o
        Some(p) => port_in_range(p, default_port)
        None => default_port

# Unset, empty or non-numeric all fall back to the default.
fn listen_port(default_port: i32) -> i32
    let s: StrView = env_get_or("RITZ_EXAMPLE_PORT", "")
    return port_or(s.parse_i64(), default_port)


pub fn main() -> i32
    run_server(listen_port(8080))
    return 0
