# Tests for 01_hello - basic language features and print builtin
#
# The 01_hello example demonstrates:
# - fn definition with return type
# - print() builtin
# - Trailing expression as return value
#
# Unit tests: verify language primitives work
# Integration test: verify ./hello outputs "Hello, Ritz!"

import ritzlib.span
import ritzlib.testlib

# Test basic arithmetic
[[test]]
fn test_arithmetic() -> i32
    assert 2 + 3 == 5
    assert 10 - 4 == 6
    assert 3 * 4 == 12
    assert 10 / 2 == 5
    assert 10 % 3 == 1
    0

# Test comparison operators
[[test]]
fn test_hello_comparison() -> i32
    assert 5 > 3
    assert 3 < 5
    assert 5 >= 5
    assert 5 <= 5
    assert 5 == 5
    assert 5 != 4
    0

# Test function return via trailing expression
[[test]]
fn test_function_return() -> i32
    let result: i32 = return_42()
    assert result == 42
    0

fn return_42() -> i32
    42

# Test C-string literals
[[test]]
fn test_string_literal() -> i32
    let s: *i8 = c"hello"
    assert *s == 104       # 'h'
    assert *(s + 1) == 'e' # 'e'
    assert *(s + 4) == 111 # 'o'
    assert *(s + 5) == 0   # null terminator
    0

# Test escape sequences in C-strings
[[test]]
fn test_escape_sequences() -> i32
    let s: *i8 = c"a\nb\tc"
    assert *s == 'a'        # 'a'
    assert *(s + 1) == '\n'  # '\n'
    assert *(s + 2) == 'b'  # 'b'
    assert *(s + 3) == '\t'   # '\t'
    assert *(s + 4) == 'c'  # 'c'
    0

# Test logical operators
[[test]]
fn test_logical_operators() -> i32
    assert (1 == 1) and (2 == 2)
    assert (1 == 1) or (1 == 2)
    assert !(1 == 2)
    0

# ============================================================================
# Integration test: verify ./hello outputs "Hello, Ritz!"
# Runs ./hello through ritzlib.testlib's exec_capture (docs/TESTING.md).
# ============================================================================

# Whether what the child wrote starts with `prefix`
fn hello_output_starts_with(c: @Captured, prefix: Span<u8>) -> bool
    var out: Span<u8> = c.output()
    var want: Span<u8> = prefix
    span_starts_with(@out, @want)

[[test]]
fn test_hello_output() -> i32
    match exec_capture("./hello", span_empty<StrView>(), span_empty<StrView>(), "")
        Ok(c) =>
            assert hello_output_starts_with(@c, "Hello, Ritz!"), "expected Hello, Ritz!"
        Err(_) =>
            assert false, "spawn ./hello"
    0
