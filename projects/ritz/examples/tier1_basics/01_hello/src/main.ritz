# 🎭 01_hello: The simplest Ritz program
#
# Demonstrates: fn, print, the `pub fn main()` entry point
#
# `main` has no return type, so it returns 0 (LANGUAGE_SPEC §5.7).
# Note: print() is currently a compiler built-in.
# In the future, it will come from ritzlib.fmt.

pub fn main()
  print(c"Hello, Ritz!\n")
