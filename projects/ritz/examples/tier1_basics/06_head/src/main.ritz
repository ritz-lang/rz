# 06_head: Print first N lines of input
#
# Demonstrates: arg parsing, line counting, buffered reading
#
# Usage: head [-n NUM] [FILE...]
# Default: 10 lines from stdin

import ritzlib.fd { Fd, fd_open, fd_adopt, fd_stdin, fd_stdout, O_RDONLY }
import ritzlib.strview { StrView }
import ritzlib.span { Span }

const BUFSIZE: i64 = 4096

# Write buf[0..len] to stdout
fn put_bytes(buf: *u8, len: i64)
  fd_stdout().write_all(Span<u8> { ptr: buf, len: len })

# Print first n lines from an open file
fn head_fd(f: @Fd, n: i32, buf: *u8) -> i32
  var lines: i32 = 0
  let start: i64 = 0  # NOTE: This appears to be dead code - start is never assigned

  while lines < n
    let bytes_read: i64 = match f.read(Span<u8> { ptr: buf, len: BUFSIZE })
      Ok(k) => k
      Err(_) => -1

    if bytes_read < 0
      return 1

    if bytes_read == 0
      # EOF - flush any remaining content
      if start > 0
        put_bytes(buf, start)
      return 0

    # Scan for newlines
    var i: i64 = 0
    while i < bytes_read
      if *(buf + i) == '\n'  # newline
        lines += 1
        if lines >= n
          # Print up to and including this newline
          put_bytes(buf, i + 1)
          return 0
      i += 1

    # Print entire buffer if no complete line limit hit
    put_bytes(buf, bytes_read)

  0

# The leading decimal number of s, read leniently as head always has (C
# atoi's rules): spaces and tabs skipped, an optional sign, then digits up to
# the first non-digit; 0 when there are none ("abc" is 0, "5x" is 5).
fn leading_i64(s: StrView) -> i64
  var i: i64 = 0
  while i < s.len and (s.get(i) == ' ' or s.get(i) == '\t')
    i += 1
  var neg: bool = false
  if i < s.len and (s.get(i) == '-' or s.get(i) == '+')
    neg = s.get(i) == '-'
    i += 1
  # Wraps on overflow like atoi: `*%`/`+%` because plain operators trap.
  var n: i64 = 0
  while i < s.len and s.get(i) >= '0' and s.get(i) <= '9'
    n = n *% 10 +% (s.get(i) - '0') as i64
    i += 1
  if neg
    return 0 -% n
  n

pub fn main(args: Span<StrView>) -> i32
  let buf: *u8 = __builtin_alloca(BUFSIZE)
  var num_lines: i32 = 10  # default
  var file_start: i64 = 1  # first file argument index

  # Parse -n flag if present
  if args.len > 1
    let arg1: StrView = args[1]
    if arg1.starts_with("-n")
      if args.len < 3
        return 1  # -n requires argument
      num_lines = leading_i64(args[2]) as i32
      if num_lines < 0
        return 1  # invalid number
      file_start = 3

  # No files specified - read stdin
  if args.len <= file_start
    let input: Fd = fd_stdin()
    return head_fd(@input, num_lines, buf)

  # Process each file
  var i: i64 = file_start
  while i < args.len
    var file: Fd = fd_adopt(-1)
    match fd_open(args[i], O_RDONLY, 0)
      Ok(f) => file = f
      Err(_) => return 1

    let result: i32 = head_fd(@file, num_lines, buf)
    file.close()

    if result != 0
      return result

    i += 1

  0
