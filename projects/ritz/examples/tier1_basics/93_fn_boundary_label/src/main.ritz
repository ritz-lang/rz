# The entry block of every function must start with NO tracked label.
#
# AGAST #1335.  ritz1 resets `label_counter` at each function boundary but
# did not reset `current_label`, so the entry block of a function inherited
# the PREVIOUS function's last emitted label.  Values produced in the entry
# block were tagged with that stale label, and `last_expr_here` falsely
# accepted them whenever the stale label collided with a real label in the
# current function — e.g. the merge block of an if-without-else.  The
# implicit return then returned the entry-block value (555) where ritz0
# returns 0.
#
# The divergence was ORDER-DEPENDENT: `z2`'s own source never changes; only
# the label count of the function emitted immediately before it decides
# whether ritz1 miscompiles it.  Both shapes are exercised below.

import ritzlib.sys
import ritzlib.io

# Emitted just before `z2`; its last opened block collides with z2's
# if-merge label.
fn prev_collide(c: i64) -> i64
    var r: i64 = 1
    if c > 0
        r = 2
    r

# Entry-block value (555) followed by an if-without-else.  The if yields no
# value, so the implicit return must be 0 — for either value of `c`.
fn z2(c: i64) -> i64
    555
    if c > 0
        let q: i64 = 1

# Allocates a different number of labels, so it does NOT collide with z3's
# merge label.  Control case: ritz1 agreed with ritz0 here even before the fix.
fn prev_nocollide(c: i64) -> i64
    var r: i64 = 1
    if c > 0
        r = 2
    if c > 1
        r = 3
    r

# Byte-identical body to z2.
fn z3(c: i64) -> i64
    555
    if c > 0
        let q: i64 = 1

fn main() -> i32
    print_int(prev_collide(1))
    print_int(z2(0))
    print_int(z2(1))
    print_int(prev_nocollide(1))
    print_int(z3(0))
    print_int(z3(1))
    return 0
