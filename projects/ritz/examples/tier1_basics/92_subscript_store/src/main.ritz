# 🎭 Ritz Example 92: Subscript stores through typed pointers
# Demonstrates: `base[i] = value` where base is a *i32 / *i64 / *u8 / **u8,
# both as a GLOBAL var and as a LOCAL let.
#
# Regression test for AGAST #1332.  90_global_ptr_index (#1325/#1328) fixed
# the LOAD side of both access forms but deliberately stored via the deref
# form only, because subscript STORES were still miscompiled:
# STMT_INDEX_ASSIGN's pointer arm hardcoded `getelementptr i64` +
# `store i64` for every non-** pointer (8-byte stride and width through a
# *i32/*u8), and the whole arm was guarded by `find_local() >= 0`, so a
# GLOBAL base emitted no store at all.
#
# Every check writes via subscript and reads back via deref `*(b + i)`
# (fixed by #1325/#1328, so a mismatch here indicts the store side), prints
# its mismatch count, and main returns the total so failure is also an
# exit-code failure.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory

var g_i32: *i32 = null
var g_i64: *i64 = null
var g_u8: *u8 = null
var g_ptrs: **u8 = null

const N: i32 = 8

fn check_global_i32() -> i32
    g_i32 = malloc(N * 4) as *i32
    for i in 0..N
        g_i32[i] = i * 10
    var bad: i32 = 0
    for i in 0..N
        if *(g_i32 + i) != i * 10
            bad = bad + 1
    print(c"global i32 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_global_i64() -> i32
    g_i64 = malloc(N * 8) as *i64
    for i in 0..N
        g_i64[i] = (i * 100) as i64
    var bad: i32 = 0
    for i in 0..N
        if *(g_i64 + i) != (i * 100) as i64
            bad = bad + 1
    print(c"global i64 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_global_u8() -> i32
    # u8 stores run in DESCENDING index order (j = N-1-i): with an ascending
    # loop an over-WIDE store (e.g. `store i64` through a *u8 at the correct
    # 1-byte stride) clobbers elements i+1.. with zero bytes, but each later
    # store repairs its own slot, so the readback would pass anyway.
    # Descending order leaves every clobber in place, so store width — not
    # just stride — is actually proven here (AGAST #1330 acceptance #3).
    g_u8 = malloc(N as i64) as *u8
    for i in 0..N
        let j: i32 = N - 1 - i
        g_u8[j] = 65 + j
    var bad: i32 = 0
    for i in 0..N
        if *(g_u8 + i) != 65 + i
            bad = bad + 1
    print(c"global u8 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_global_ptr() -> i32
    g_ptrs = malloc(N * 8) as **u8
    let base: *u8 = malloc(N as i64) as *u8
    for i in 0..N
        g_ptrs[i] = base + i
    var bad: i32 = 0
    for i in 0..N
        if *(g_ptrs + i) != base + i
            bad = bad + 1
    print(c"global ptr mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_local_i32() -> i32
    let p: *i32 = malloc(N * 4) as *i32
    for i in 0..N
        p[i] = i * 10
    var bad: i32 = 0
    for i in 0..N
        if *(p + i) != i * 10
            bad = bad + 1
    print(c"local i32 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_local_u8() -> i32
    # Descending store order for the same width-proof reason as
    # check_global_u8 above.
    let p: *u8 = malloc(N as i64) as *u8
    for i in 0..N
        let j: i32 = N - 1 - i
        p[j] = 65 + j
    var bad: i32 = 0
    for i in 0..N
        if *(p + i) != 65 + i
            bad = bad + 1
    print(c"local u8 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_local_i64() -> i32
    let p: *i64 = malloc(N * 8) as *i64
    for i in 0..N
        p[i] = (i * 100) as i64
    var bad: i32 = 0
    for i in 0..N
        if *(p + i) != (i * 100) as i64
            bad = bad + 1
    print(c"local i64 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn main() -> i32
    var total: i32 = 0
    total = total + check_global_i32()
    total = total + check_global_i64()
    total = total + check_global_u8()
    total = total + check_global_ptr()
    total = total + check_local_i32()
    total = total + check_local_u8()
    total = total + check_local_i64()
    if total == 0
        print(c"all subscript stores OK\n")
    total
