# Indexed load/store through GLOBAL pointer variables.
#
# AGAST #1325.  The identical code through a `let` local always worked; only
# the global path was broken, which is why this went unnoticed for so long —
# it needed a global `*i32` array indexed at a non-zero offset, and
# monomorph.ritz's instantiation tracker was the one place that did that in
# anger.
#
# Each check prints its result so a mismatch is legible in the diff Stage 3/4
# take, and main returns non-zero so the failure is also an exit-code failure.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory

var g_i32: *i32 = null
var g_i64: *i64 = null
var g_u8: *u8 = null
var g_ptrs: **u8 = null

const N: i32 = 8

fn check_i32() -> i32
    g_i32 = malloc(N * 4) as *i32
    for i in 0..N
        *(g_i32 + i) = i * 10
    var bad: i32 = 0
    for i in 0..N
        if *(g_i32 + i) != i * 10
            bad = bad + 1
    print(c"i32 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_i64() -> i32
    g_i64 = malloc(N * 8) as *i64
    for i in 0..N
        *(g_i64 + i) = (i * 100) as i64
    var bad: i32 = 0
    for i in 0..N
        if *(g_i64 + i) != (i * 100) as i64
            bad = bad + 1
    print(c"i64 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_u8() -> i32
    g_u8 = malloc(N) as *u8
    for i in 0..N
        *(g_u8 + i) = (i + 65) as u8
    var bad: i32 = 0
    for i in 0..N
        if *(g_u8 + i) != (i + 65) as u8
            bad = bad + 1
    print(c"u8 mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn check_ptrs() -> i32
    g_ptrs = malloc(N * 8) as **u8
    let a: *u8 = c"alpha"
    let b: *u8 = c"beta"
    for i in 0..N
        if i % 2 == 0
            *(g_ptrs + i) = a
        else
            *(g_ptrs + i) = b
    var bad: i32 = 0
    for i in 0..N
        if i % 2 == 0
            if *(g_ptrs + i) != a
                bad = bad + 1
        else
            if *(g_ptrs + i) != b
                bad = bad + 1
    print(c"ptr mismatches=")
    print_int(bad as i64)
    print(c"\n")
    bad

fn main() -> i32
    var bad: i32 = 0
    bad = bad + check_i32()
    bad = bad + check_i64()
    bad = bad + check_u8()
    bad = bad + check_ptrs()
    if bad == 0
        print(c"OK\n")
        return 0
    print(c"FAIL\n")
    1
