# 10_sleep: Sleep for a specified duration
#
# Demonstrates: ritzlib.time (Duration, sleep), parsing a decimal duration
#
# Usage: sleep SECONDS

import ritzlib.time
import ritzlib.strview { StrView }
import ritzlib.span { Span }

# Parse a decimal number (supports fractional)
# Returns (seconds, nanoseconds)
fn parse_duration(s: StrView, out_sec: *i64, out_nsec: *i64) -> i32
  var sec: i64 = 0
  var nsec: i64 = 0
  var i: i64 = 0
  var frac_digits: i32 = 0
  var in_frac: i32 = 0

  while i < s.len
    let c: u8 = s.get(i)

    if c == '.'  # '.'
      if in_frac == 1
        return 1  # Multiple decimal points
      in_frac = 1
      i += 1
    else
      if c < 48
        return 1
      if c > '9'
        return 1

      if in_frac == 0
        sec = sec * 10 + (c - '0') as i64
      else
        # Handle up to 9 fractional digits (nanoseconds)
        if frac_digits < 9
          nsec = nsec * 10 + (c - '0') as i64
          frac_digits += 1
      i += 1

  # Pad nanoseconds to 9 digits
  for _ in frac_digits..9
    nsec *= 10

  out_sec[0] = sec
  out_nsec[0] = nsec
  0

# Sleep for sec seconds plus nsec nanoseconds. time.sleep resumes after a
# signal, so it cannot fail.
fn do_sleep(sec: i64, nsec: i64) -> i32
  sleep(duration_ns(sec * 1000000000 + nsec))
  0

pub fn main(args: Span<StrView>) -> i32
  if args.len != 2
    return 1

  var sec: i64 = 0
  var nsec: i64 = 0

  let result: i32 = parse_duration(args[1], @sec, @nsec)
  if result != 0
    return 1

  do_sleep(sec, nsec)
