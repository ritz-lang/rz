# Tests for 09_yes - buffered output
#
# The 09_yes example demonstrates:
# - Buffer filling for efficient I/O
# - String repetition
# - Infinite loop patterns
# - Character manipulation

import ritzlib.span
import ritzlib.process
import ritzlib.testlib

# Test buffer fill with repeated pattern
[[test]]
fn test_fill_buffer_pattern() -> i32
    var arr: [16]u8
    let buf: *u8 = @arr[0]

    fill_buffer(Span<u8> { ptr: buf, len: 16 }, "ab")

    # Should be "abababababababab"
    assert *buf == 'a'         # 'a'
    assert *(buf + 1) == 'b'   # 'b'
    assert *(buf + 2) == 'a'   # 'a'
    assert *(buf + 3) == 'b'   # 'b'
    assert *(buf + 14) == 'a'  # 'a'
    assert *(buf + 15) == 'b'  # 'b'
    0

fn fill_buffer(buf: Span<u8>, pattern: StrView)
    for i in 0..buf.len
        *(buf.ptr + i) = pattern.get(i % pattern.len)

# Test single character fill
[[test]]
fn test_fill_single_char() -> i32
    var arr: [8]u8
    var buf: Span<u8> = Span<u8> { ptr: @arr[0], len: 8 }
    buf.fill(121)  # 'y'

    for i in 0..8
        assert arr[i] == 121
    0

# Test string copy into buffer
[[test]]
fn test_copy_to_buffer() -> i32
    var arr: [32]u8
    var buf: Span<u8> = Span<u8> { ptr: @arr[0], len: 32 }
    let msg: StrView = "hello\n"
    let len: i64 = buf.copy_from(span_from_strview(msg))
    assert len == 6
    assert arr[0] == 104        # 'h'
    assert arr[5] == '\n'   # '\n'
    0

# Test buffer capacity calculation
[[test]]
fn test_repetitions_in_buffer() -> i32
    let buf_size: i64 = 100
    let msg_len: i64 = 7  # "hello\n" + terminator overhead

    let reps: i64 = buf_size / msg_len
    assert reps == 14
    0

# Test newline appending
[[test]]
fn test_append_newline() -> i32
    var arr: [16]u8
    var buf: Span<u8> = Span<u8> { ptr: @arr[0], len: 16 }
    let len: i64 = buf.copy_from("test")
    arr[len] = 10  # newline

    assert arr[0] == 't'        # 't'
    assert arr[1] == 'e'  # 'e'
    assert arr[2] == 115  # 's'
    assert arr[3] == 't'  # 't'
    assert arr[4] == '\n'   # '\n'
    0

# Test repeated copy efficiency
[[test]]
fn test_repeated_copy() -> i32
    var arr: [64]u8
    var buf: Span<u8> = Span<u8> { ptr: @arr[0], len: 64 }
    let pattern: StrView = "y\n"

    # Copy pattern multiple times
    var filled: i64 = 0
    while filled + pattern.len <= 64
        var rest: Span<u8> = buf.from(filled)
        filled += rest.copy_from(span_from_strview(pattern))

    assert filled == '@'
    assert arr[0] == 121         # 'y'
    assert arr[1] == '\n'    # '\n'
    assert arr[62] == 121  # 'y'
    assert arr[63] == '\n'   # '\n'
    0

# Test default "y" message
[[test]]
fn test_default_message() -> i32
    var arr: [2]u8
    arr[0] = 121        # 'y'
    arr[1] = 10   # '\n'

    assert arr[0] == 121
    assert arr[1] == '\n'
    0

# Test character codes
[[test]]
fn test_char_codes() -> i32
    assert 121 == 121  # 'y'
    assert 10 == '\n'    # '\n'
    assert 32 == ' '    # ' '
    0

# ============================================================================
# Integration test: verify ./yes outputs repeated lines
# ============================================================================

# Read up to buf.len bytes of the child's output: one read can return part
# of it when the child writes in pieces (docs/TESTING.md).
fn yes_read_some(p: @&Process, buf: Span<u8>) -> i64
    var n: i64 = 0
    while n < buf.len
        let r: i64 = p.read_stdout(Span<u8> { ptr: buf.ptr + n, len: buf.len - n }).unwrap_or(0)
        if r <= 0
            break
        n += r
    n

[[test]]
fn test_yes_output() -> i32
    var p: Process
    match spawn("./yes", span_empty<StrView>())
        Ok(q) => p = q
        Err(_) => return 1

    # Read a small amount (yes outputs infinitely)
    var out: [31]u8
    let n: i64 = yes_read_some(@&p, Span<u8> { ptr: @out[0], len: 31 })

    # Kill the child since it runs forever
    p.kill()
    p.wait()
    p.cleanup()

    # yes should output "y\ny\ny\n..."
    let got: Span<u8> = Span<u8> { ptr: @out[0], len: n }
    let want: Span<u8> = "y\ny\ny\n"
    assert n >= want.len and buf_eq(got.to(want.len), want), "expected y y y"
    0
