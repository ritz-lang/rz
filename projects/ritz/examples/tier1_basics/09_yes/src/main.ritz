# 09_yes: Repeatedly output a string
#
# Demonstrates: infinite loops, buffered output
#
# Usage: yes [STRING]
# Outputs STRING (default "y") forever

import ritzlib.fd { fd_stdout }
import ritzlib.strview { StrView }
import ritzlib.span { Span, span_from_strview }

const BUFSIZE: i64 = 8192

pub fn main(args: Span<StrView>) -> i32
  let buf: *u8 = __builtin_alloca(BUFSIZE)
  var out: Span<u8> = Span<u8> { ptr: buf, len: BUFSIZE }
  var len: i64 = 0

  # Default message
  if args.len == 1
    *(buf + 0) = 121  # 'y'
    *(buf + 1) = 10   # '\n'
    len = 2
  else
    # Copy the provided argument to the buffer
    let msg: StrView = args[1]
    len = out.copy_from(span_from_strview(msg))
    *(buf + len) = 10  # Add newline
    len += 1

  # Fill buffer with repeated copies for efficiency
  var filled: i64 = len
  while filled + len <= BUFSIZE
    var i: i64 = 0
    while i < len
      *(buf + filled) = *(buf + i)
      filled += 1
      i += 1

  # Infinite loop - write buffer repeatedly
  while 1 == 1
    match fd_stdout().write(Span<u8> { ptr: buf, len: filled })
      Ok(_) => pass
      Err(_) => return 1

  0
