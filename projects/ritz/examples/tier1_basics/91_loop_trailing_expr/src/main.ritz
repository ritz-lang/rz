# Functions ending in a loop whose body's LAST statement is a bare
# expression, with a non-void return type and no explicit `return`.
#
# AGAST #1329.  Under ritz1 the loop body's trailing expression leaked into
# `last_expr_reg`, and the implicit-return path used it raw as the return
# operand — a register defined inside the loop body, read from the loop-exit
# block, which the body does not dominate on the zero-iteration path.
# ritz0 compiles this correctly (the loop yields no value), so this is a
# ritz0/ritz1 parity check.
#
# A loop yields no value, so a fn declaring a return type must say what it
# returns after one (AGAST #1429 replaced the implicit zero of #1329 with an
# error). Each `-> i64` fn below ends in an explicit `0`; the `p_*` procedures
# keep the shape with no tail at all, where the implicit return still runs.
#
# All three loop forms are covered, plus a loop nested inside an `if` arm.
# Each is exercised with n = 0 (zero-iteration path — the one whose CFG edge
# exposes the dominance violation) and n = 3.
#
# The `g_*` fns are the positive control (AGAST #1336).  #1329 works by making
# the guard reject more, so the way it can regress is by rejecting too much: a
# real tail value dropped and `0` returned in its place.  The `f_*` fns cannot
# see that, since 0 is their right answer.  Each `g_*` fn runs a loop with the
# same trailing body expression and then ends in a value that is not 0.

import ritzlib.sys
import ritzlib.io

fn side(x: i64) -> i64
    x + 1

# while — trailing expr in the body.
fn f_while(n: i64) -> i64
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    0

# loop — trailing expr in the body, exits via break.
fn f_loop(n: i64) -> i64
    var i: i64 = 0
    loop
        if i >= n
            break
        i = i + 1
        side(i)
    0

# for (range) — trailing expr in the body.
fn f_for(n: i64) -> i64
    var acc: i64 = 0
    for i in 0..n
        acc = acc + 1
        side(i)
    0

# Nested: the loop sits inside an `if` arm, so the leak has to survive the
# if-merge on its way to the tail.
fn f_nested(n: i64) -> i64
    var i: i64 = 0
    if n > 0
        while i < n
            i = i + 1
            side(i)
    0

# Procedures: the same loops with nothing after them.
fn p_while(n: i64)
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)

fn p_nested(n: i64)
    var i: i64 = 0
    if n > 0
        while i < n
            i = i + 1
            side(i)

# Positive control: the tail after the loop is a value, and not 0.  Literal
# first, since that is f_while with one digit changed.
fn g_literal(n: i64) -> i64
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    7

fn g_while(n: i64) -> i64
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    100 + i

fn g_loop(n: i64) -> i64
    var i: i64 = 0
    loop
        if i >= n
            break
        i = i + 1
        side(i)
    200 + i

fn g_for(n: i64) -> i64
    var acc: i64 = 0
    for i in 0..n
        acc = acc + 2
        side(i)
    300 + acc

# The tail is an if/else: its value arrives through a merge block.
fn g_if_tail(n: i64) -> i64
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    if i > 0
        61
    else
        62

# The tail is a match.
fn g_match_tail(n: i64) -> i64
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    match i
        0 => 71
        3 => 72
        _ => 73

# break and continue give the loop-exit block extra predecessors.
fn g_break_continue(n: i64) -> i64
    var i: i64 = 0
    var acc: i64 = 0
    while i < 100
        i = i + 1
        if i == 2
            continue
        if i > n
            break
        acc = acc + i
        side(i)
    500 + acc

# The loop and the value after it both sit inside an `if` arm.
fn g_in_arm(n: i64) -> i64
    var i: i64 = 0
    if n > 0
        while i < n
            i = i + 1
            side(i)
        80 + i
    else
        90

# A tail that is an expression returns inline from emit_fn; an if or match tail
# goes through emit_implicit_return_tail.  Each narrows i32 and bool on its own
# path, so both are covered here.
fn g_i32(n: i64) -> i32
    var i: i32 = 0
    while (i as i64) < n
        i = i + 1
        side(i as i64)
    40 + i

fn g_i32_if(n: i64) -> i32
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    if i > 0
        41
    else
        42

fn g_bool(n: i64) -> bool
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    i > 0

fn g_bool_if(n: i64) -> bool
    var i: i64 = 0
    while i < n
        i = i + 1
        side(i)
    if i > 0
        true
    else
        false

# ritz1 emits methods separately from fns, with both tail paths again.
struct Walker
    limit: i64

impl Walker
    fn g_expr_tail(self) -> i64
        var i: i64 = 0
        while i < self.limit
            i = i + 1
            side(i)
        110 + i

    fn g_if_tail(self) -> i64
        var i: i64 = 0
        while i < self.limit
            i = i + 1
            side(i)
        if i > 0
            121
        else
            122

# One value per field, so a failure names the case that broke.
fn show(v: i64)
    print(c" ")
    print_int(v)

fn main() -> i32
    print_int(f_while(0))
    print_int(f_while(3))
    print_int(f_loop(0))
    print_int(f_loop(3))
    print_int(f_for(0))
    print_int(f_for(3))
    print_int(f_nested(0))
    print_int(f_nested(3))
    p_while(0)
    p_while(3)
    p_nested(0)
    p_nested(3)
    show(side(4))
    show(g_literal(0))
    show(g_literal(3))
    show(g_while(0))
    show(g_while(3))
    show(g_loop(0))
    show(g_loop(3))
    show(g_for(0))
    show(g_for(3))
    show(g_if_tail(0))
    show(g_if_tail(3))
    show(g_match_tail(0))
    show(g_match_tail(3))
    show(g_break_continue(0))
    show(g_break_continue(3))
    show(g_in_arm(0))
    show(g_in_arm(3))
    show(g_i32(0) as i64)
    show(g_i32(3) as i64)
    show(g_i32_if(0) as i64)
    show(g_i32_if(3) as i64)
    show(if g_bool(0) then 10 else 20)
    show(if g_bool(3) then 10 else 20)
    show(if g_bool_if(0) then 10 else 20)
    show(if g_bool_if(3) then 10 else 20)
    let w0 = Walker { limit: 0 }
    let w3 = Walker { limit: 3 }
    show(w0.g_expr_tail())
    show(w3.g_expr_tail())
    show(w0.g_if_tail())
    show(w3.g_if_tail())
    return 0
