# Impl methods get the same implicit-return tail as free functions.
#
# AGAST #1573. emit_impl_method only emitted a `ret` when the method's last
# statement was a bare expression. A non-void method ending in an `if` or a
# loop left its final block with no terminator (`L2:` then `}`), which clang
# rejects. Each method below has a free-fn twin that must print the same.
#
# AGAST #1429 made a non-void fn that reaches its end without a value an
# error, so `zm`, `zf` and `count` now end in an explicit `0`. `guard` and
# `spin` are procedures, and keep the if and loop tails with no value after.

import ritzlib.sys
import ritzlib.io

struct Box
    v: i64

impl Box
    # The ticket's repro, with the value the if cannot supply written out.
    fn zm(self, c: i64) -> i64
        555
        if c > 0
            let q: i64 = 1
        0

    # A loop, then its value.
    fn count(self, n: i64) -> i32
        var i: i64 = 0
        while i < n
            i = i + 1
        0

    # A procedure ending in an `if`: the method still needs a terminator.
    fn guard(self, c: i64)
        555
        if c > 0
            let q: i64 = 1

    # A procedure ending in a loop.
    fn spin(self, n: i64)
        var i: i64 = 0
        while i < n
            i = i + 1

    # Ends in an if/else that yields a value.
    fn pick(self, c: i64) -> i64
        if c > 0
            self.v
        else
            3

fn zf(c: i64) -> i64
    555
    if c > 0
        let q: i64 = 1
    0

fn pickf(v: i64, c: i64) -> i64
    if c > 0
        v
    else
        3

fn main() -> i32
    let b: Box = Box { v: 7 }
    print_int(b.zm(0))
    print_int(b.zm(1))
    print_int(zf(1))
    print_int(b.count(4) as i64)
    print_int(b.pick(1))
    print_int(pickf(7, 1))
    print_int(b.pick(0))
    print_int(pickf(7, 0))
    b.guard(1)
    b.spin(2)
    return 0
