# 08_seq: Print a sequence of numbers
#
# Demonstrates: ranges, parsing a StrView as a number (strview_parse_i64),
# formatting a number into a String (string_push_i64)
#
# Usage: seq LAST
#        seq FIRST LAST
#        seq FIRST INCREMENT LAST
#
# An argument that is not a whole decimal number is an error (exit 1), not 0:
# str.atoi read "abc" as 0 and "12x" as 12.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.string

# argv[i] as an i64, or None.
fn arg_i64(argv: **u8, i: i32) -> Option<i64>
    let arg = strview_from_cstr(*(argv + i))
    strview_parse_i64(@arg)

fn invalid_number(argv: **u8, i: i32) -> i32
    eprints("seq: invalid number: '")
    eprints(strview_from_cstr(*(argv + i)))
    eprints("'\n")
    1

# Print one line: the number, formatted into a String reused across lines.
fn print_line(line: @&String, n: i64)
    string_clear(line)
    string_push_i64(line, n)
    string_push(line, '\n')
    print_string(line)

fn print_seq(first: i64, incr: i64, last: i64) -> i32
    var line: String = string_new()
    var n: i64 = first
    if incr > 0
        while n <= last
            print_line(@&line, n)
            n += incr
    else
        while n >= last
            print_line(@&line, n)
            n += incr
    string_drop(@&line)
    0

# The last argument is LAST; FIRST and INCREMENT are already parsed.
fn with_last(argv: **u8, i: i32, first: i64, incr: i64) -> i32
    match arg_i64(argv, i)
        Some(last) => print_seq(first, incr, last)
        None => invalid_number(argv, i)

# seq FIRST INCREMENT LAST
fn with_incr(argv: **u8, first: i64) -> i32
    match arg_i64(argv, 2)
        Some(incr) => with_last(argv, 3, first, incr)
        None => invalid_number(argv, 2)

fn with_first(argc: i32, argv: **u8, first: i64) -> i32
    if argc == 4
        return with_incr(argv, first)
    with_last(argv, 2, first, 1)

fn main(argc: i32, argv: **u8) -> i32
    if argc == 2
        return with_last(argv, 1, 1, 1)
    if argc != 3 and argc != 4
        return 1
    match arg_i64(argv, 1)
        Some(first) => with_first(argc, argv, first)
        None => invalid_number(argv, 1)
