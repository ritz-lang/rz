# 08_seq: Print a sequence of numbers
#
# Demonstrates: ranges, parsing a StrView as a number (strview_parse_i64),
# formatting a number into a String (string_push_i64)
#
# Usage: seq LAST
#        seq FIRST LAST
#        seq FIRST INCREMENT LAST
#
# An argument that is not a whole decimal number is an error (exit 1), not 0:
# str.atoi read "abc" as 0 and "12x" as 12.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.string
import ritzlib.span { Span }
import ritzlib.fmt

# args[i] as an i64, or None.
fn arg_i64(args: Span<StrView>, i: i64) -> Option<i64>
    let arg: StrView = args[i]
    arg.parse_i64()

fn invalid_number(args: Span<StrView>, i: i64) -> i32
    let arg: StrView = args[i]
    eprint("seq: invalid number: '{arg}'\n")
    1

# Print one line: the number, formatted into a String reused across lines.
fn print_line(line: @&String, n: i64)
    line.clear()
    line.push_i64(n)
    line.push('\n')
    let v: StrView = line.as_view()
    print("{v}")

fn print_seq(first: i64, incr: i64, last: i64) -> i32
    var line: String = string_new()
    var n: i64 = first
    if incr > 0
        while n <= last
            print_line(@&line, n)
            n += incr
    else
        while n >= last
            print_line(@&line, n)
            n += incr
    0

# The last argument is LAST; FIRST and INCREMENT are already parsed.
fn with_last(args: Span<StrView>, i: i64, first: i64, incr: i64) -> i32
    match arg_i64(args, i)
        Some(last) => print_seq(first, incr, last)
        None => invalid_number(args, i)

# seq FIRST INCREMENT LAST
fn with_incr(args: Span<StrView>, first: i64) -> i32
    match arg_i64(args, 2)
        Some(incr) => with_last(args, 3, first, incr)
        None => invalid_number(args, 2)

fn with_first(args: Span<StrView>, first: i64) -> i32
    if args.len == 4
        return with_incr(args, first)
    with_last(args, 2, first, 1)

pub fn main(args: Span<StrView>) -> i32
    if args.len == 2
        return with_last(args, 1, 1, 1)
    if args.len != 3 and args.len != 4
        return 1
    match arg_i64(args, 1)
        Some(first) => with_first(args, first)
        None => invalid_number(args, 1)
