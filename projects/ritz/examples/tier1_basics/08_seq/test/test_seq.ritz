# Tests for 08_seq - number sequences
#
# The 08_seq example demonstrates:
# - Range iteration
# - Number formatting (string_from_i64)
# - Argument parsing for ranges
# - Negative and positive increments

import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.string
import ritzlib.span
import ritzlib.testlib

# Test number formatting basic: string_from_i64 replaces itoa
[[test]]
fn test_fmt_basic() -> i32
    assert string_from_i64(0).eq("0")
    assert string_from_i64(42).eq("42")
    assert string_from_i64(123).eq("123")
    0

# Test number formatting negative
[[test]]
fn test_fmt_negative() -> i32
    assert string_from_i64(-1).eq("-1")
    assert string_from_i64(-42).eq("-42")
    assert string_from_i64(-999).eq("-999")
    0

# Test number formatting large numbers
[[test]]
fn test_fmt_large() -> i32
    assert string_from_i64(1000000).eq("1000000")
    assert string_from_i64(2147483647).eq("2147483647")  # max i32
    0

# Test sequence generation (ascending)
[[test]]
fn test_seq_ascending() -> i32
    var sum: i64 = 0
    var n: i64 = 1
    while n <= 5
        sum += n
        n += 1
    assert sum == 15  # 1+2+3+4+5
    0

# Test sequence generation (descending)
[[test]]
fn test_seq_descending() -> i32
    var sum: i64 = 0
    var n: i64 = 5
    while n >= 1
        sum += n
        n -= 1
    assert sum == 15
    0

# Test sequence with custom increment
[[test]]
fn test_seq_increment() -> i32
    # Count 2, 4, 6, 8, 10
    var count: i32 = 0
    var n: i64 = 2
    while n <= 10
        count += 1
        n += 2
    assert count == 5
    0

# Test sequence with negative increment
[[test]]
fn test_seq_negative_increment() -> i32
    # Count 10, 8, 6, 4, 2
    var count: i32 = 0
    var n: i64 = 10
    while n >= 2
        count += 1
        n -= 2
    assert count == 5
    0

# Test empty sequence (start > end with positive increment)
[[test]]
fn test_seq_empty() -> i32
    var count: i32 = 0
    var n: i64 = 10
    while n <= 5
        count += 1
        n += 1
    assert count == 0
    0

# Test single element sequence
[[test]]
fn test_seq_single() -> i32
    var count: i32 = 0
    var n: i64 = 5
    while n <= 5
        count += 1
        n += 1
    assert count == 1
    0

# The number s holds, or 0 when it isn't one
fn parsed_or_zero(s: StrView) -> i64
    match s.parse_i64()
        Some(n) => n
        None => 0

# Test parse_i64 roundtrip with string_from_i64
[[test]]
fn test_roundtrip() -> i32
    let a: String = string_from_i64(12345)
    assert parsed_or_zero(a.as_view()) == 12345

    let b: String = string_from_i64(-9999)
    assert parsed_or_zero(b.as_view()) == -9999
    0

# ============================================================================
# Integration test: verify ./seq outputs correct sequence
# ============================================================================

# Whether what the child wrote starts with `prefix`
fn seq_output_starts_with(c: @Captured, prefix: Span<u8>) -> bool
    var out: Span<u8> = c.output()
    buf_eq(out.to(prefix.len), prefix)

[[test]]
fn test_seq_output() -> i32
    let args: [1]StrView = ["5"]
    match exec_capture("./seq", @args, span_empty<StrView>(), "")
        Ok(c) =>
            # seq 5 should output "1\n2\n3\n4\n5\n"
            assert seq_output_starts_with(@c, "1\n2\n3\n4\n5"), "expected 1 through 5"
        Err(_) =>
            assert false, "spawn ./seq"
    0
