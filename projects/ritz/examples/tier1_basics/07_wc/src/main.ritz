# 07_wc: Word, line, and byte count
#
# Demonstrates: counting, state machines, buffered reading
#
# Usage: wc [FILE...]
# Outputs: lines words bytes filename

import ritzlib.io
import ritzlib.fd { Fd, fd_open, fd_adopt, fd_stdin, O_RDONLY }
import ritzlib.str
import ritzlib.strview { StrView }
import ritzlib.span { Span }
import ritzlib.fmt

const BUFSIZE: i64 = 4096

# Print: "lines words bytes"
fn print_counts(lines: i64, words: i64, bytes: i64)
  print("{lines} {words} {bytes}")

# Count lines, words, bytes from an open file
fn wc_fd(f: @Fd, buf: *u8, out_lines: *i64, out_words: *i64, out_bytes: *i64) -> i32
  var lines: i64 = 0
  var words: i64 = 0
  var bytes: i64 = 0
  var in_word: i32 = 0

  while 1 == 1
    let n: i64 = match f.read(Span<u8> { ptr: buf, len: BUFSIZE })
      Ok(k) => k
      Err(_) => -1

    if n < 0
      return 1

    if n == 0
      # EOF
      out_lines[0] = lines
      out_words[0] = words
      out_bytes[0] = bytes
      return 0

    bytes += n

    var i: i64 = 0
    while i < n
      let c: u8 = *(buf + i)

      if c == '\n'
        lines += 1

      if isspace(c) == 1
        in_word = 0
      else
        if in_word == 0
          words += 1
          in_word = 1

      i += 1

  0

pub fn main(args: Span<StrView>) -> i32
  let buf: *u8 = __builtin_alloca(BUFSIZE)
  var total_lines: i64 = 0
  var total_words: i64 = 0
  var total_bytes: i64 = 0
  var lines: i64 = 0
  var words: i64 = 0
  var bytes: i64 = 0

  # No files - read stdin
  if args.len == 1
    let input: Fd = fd_stdin()
    let result: i32 = wc_fd(@input, buf, @lines, @words, @bytes)
    if result != 0
      return result
    print_counts(lines, words, bytes)
    print("\n")
    return 0

  # Process files
  var i: i64 = 1
  while i < args.len
    let path: StrView = args[i]
    var file: Fd = fd_adopt(-1)
    match fd_open(path, O_RDONLY, 0)
      Ok(f) => file = f
      Err(_) => return 1

    let result: i32 = wc_fd(@file, buf, @lines, @words, @bytes)
    file.close()

    if result != 0
      return result

    print_counts(lines, words, bytes)
    print(" {path}\n")

    total_lines += lines
    total_words += words
    total_bytes += bytes

    i += 1

  # Print total if multiple files
  if args.len > 2
    print_counts(total_lines, total_words, total_bytes)
    print(" total\n")

  0
