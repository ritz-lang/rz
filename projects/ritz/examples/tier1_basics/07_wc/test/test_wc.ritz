# Tests for 07_wc - word, line, and byte counting
#
# The 07_wc example demonstrates:
# - Counting algorithms (words, lines, bytes)
# - State machine for word detection
# - Character classification (isspace)
# - Output pointer parameters

import ritzlib.sys
import ritzlib.str
import ritzlib.io
import ritzlib.span
import ritzlib.fs
import ritzlib.testlib

# This test's scratch file, "/tmp/ritz_test_wc_<pid>_in" (testlib's
# sandbox_path). The pid keeps concurrent runs (rooms gating on one host) off
# each other's file: a shared fixed path let one run's O_TRUNC race another's
# read (AGAST #1735, #1738).
fn wc_tmp_path() -> String
    sandbox_path("test_wc", "in")

[[test]]
fn test_wc_tmp_path_is_per_process() -> i32
    let path: String = wc_tmp_path()
    let pid: String = string_from_i64(sys_getpid() as i64)
    assert path.as_view().contains(pid.as_view())
    0

# Test isspace function
[[test]]
fn test_isspace() -> i32
    assert isspace(32) == 1   # space
    assert isspace(9) == 1    # tab
    assert isspace(10) == 1   # newline
    assert isspace(13) == 1   # carriage return
    assert isspace(97) == 0   # 'a'
    assert isspace(48) == 0   # '0'
    0

# Test isdigit function
[[test]]
fn test_isdigit() -> i32
    assert isdigit(48) == 1   # '0'
    assert isdigit(57) == 1   # '9'
    assert isdigit(47) == 0   # '/'
    assert isdigit(58) == 0   # ':'
    assert isdigit(97) == 0   # 'a'
    0

# Test isalpha function
[[test]]
fn test_isalpha() -> i32
    assert isalpha(65) == 1   # 'A'
    assert isalpha(90) == 1   # 'Z'
    assert isalpha(97) == 1   # 'a'
    assert isalpha(122) == 1  # 'z'
    assert isalpha(64) == 0   # '@'
    assert isalpha(48) == 0   # '0'
    0

# Test word counting
[[test]]
fn test_count_words() -> i32
    let s1: *u8 = c"hello world"
    assert count_words(s1) == 2

    let s2: *u8 = c"one"
    assert count_words(s2) == 1

    let s3: *u8 = c""
    assert count_words(s3) == 0

    let s4: *u8 = c"   "
    assert count_words(s4) == 0
    0

fn count_words(s: *u8) -> i32
    var count: i32 = 0
    var in_word: i32 = 0
    var i: i64 = 0
    while *(s + i) != 0
        let c: u8 = *(s + i)
        if isspace(c) == 1
            in_word = 0
        else
            if in_word == 0
                count += 1
                in_word = 1
        i += 1
    return count

# Test line counting
[[test]]
fn test_count_lines() -> i32
    let s1: *u8 = c"line1\nline2\nline3"
    assert count_lines(s1) == 2

    let s2: *u8 = c"line1\n"
    assert count_lines(s2) == 1

    let s3: *u8 = c"no newline"
    assert count_lines(s3) == 0

    let s4: *u8 = c"\n\n\n"
    assert count_lines(s4) == 3
    0

fn count_lines(s: *u8) -> i32
    var count: i32 = 0
    var i: i64 = 0
    while *(s + i) != 0
        if *(s + i) == '\n'
            count += 1
        i += 1
    return count

# Test byte counting (strlen)
[[test]]
fn test_count_bytes() -> i32
    assert strlen(c"") == 0
    assert strlen(c"hello") == 5
    assert strlen(c"a b c") == 5
    0

# Test combined counting
[[test]]
fn test_wc_combined() -> i32
    let text = c"hello world\nfoo bar baz\n"
    var lines: i64 = 0
    var words: i64 = 0
    var bytes: i64 = 0

    wc_string(text, @lines, @words, @bytes)

    assert lines == 2
    assert words == 5
    assert bytes == 24
    0

fn wc_string(s: *u8, out_lines: *i64, out_words: *i64, out_bytes: *i64)
    var lines: i64 = 0
    var words: i64 = 0
    var bytes: i64 = 0
    var in_word: i32 = 0
    var i: i64 = 0

    while *(s + i) != 0
        let c: u8 = *(s + i)
        bytes += 1

        if c == '\n'
            lines += 1

        if isspace(c) == 1
            in_word = 0
        else
            if in_word == 0
                words += 1
                in_word = 1
        i += 1

    *out_lines = lines
    *out_words = words
    *out_bytes = bytes

# Test multiple consecutive spaces
[[test]]
fn test_multiple_spaces() -> i32
    let s = c"one   two    three"
    assert count_words(s) == 3
    0

# Test tabs and mixed whitespace
[[test]]
fn test_mixed_whitespace() -> i32
    let s = c"one\ttwo\n\nthree"
    assert count_words(s) == 3
    assert count_lines(s) == 2
    0

# ============================================================================
# Integration test: verify ./wc outputs correct counts
# ============================================================================

# Whether what the child wrote starts with `prefix`
fn wc_output_starts_with(c: @Captured, prefix: Span<u8>) -> bool
    var out: Span<u8> = c.output()
    var want: Span<u8> = prefix
    span_starts_with(@out, @want)

[[test]]
fn test_wc_file() -> i32
    # "hello world\nfoo bar baz\n": 2 lines, 5 words, 24 bytes
    let path: String = wc_tmp_path()
    match write_file(path.as_view(), "hello world\nfoo bar baz\n")
        Ok(_) => pass
        Err(_) => return 1
    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./wc", @args, span_empty<StrView>(), "")
    unlink(path.as_view())
    match r
        Ok(c) =>
            assert wc_output_starts_with(@c, "2 5 24"), "expected 2 5 24"
        Err(_) =>
            assert false, "spawn ./wc"
    0
