# 03_echo: Print command-line arguments
#
# Demonstrates:
# - Command-line arguments as `args: Span<StrView>` (LANGUAGE_SPEC §5.7)
# - While loops
# - Indexing a Span
# - Comparison operators
# - Variable mutation
#
# Usage: ./echo hello world
# Output: hello world

import ritzlib.sys

pub fn main(args: Span<StrView>)
  # Skip args[0] (program name), print remaining args
  var i: i64 = 1
  while i < args.len
    # Print space separator (not before first arg)
    if i > 1
      sys_write(STDOUT, c" ", 1)

    # Each arg is a StrView: its length is already known
    sys_write(STDOUT, args[i].ptr, args[i].len)

    i += 1

  # Print trailing newline
  sys_write(STDOUT, c"\n", 1)
