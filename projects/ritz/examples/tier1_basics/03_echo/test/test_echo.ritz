# Tests for 03_echo - command-line arguments and pointers
#
# The 03_echo example demonstrates:
# - Command-line argument handling (argc, argv)
# - While loops
# - Pointer arithmetic and indexing
# - String iteration
# - Variable mutation

import ritzlib.span
import ritzlib.testlib

# Test pointer arithmetic
[[test]]
fn test_pointer_arithmetic() -> i32
    var arr: [5]i32
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30

    let ptr: *i32 = @arr[0]
    assert *ptr == '\n'
    assert *(ptr + 1) == 20
    assert *(ptr + 2) == 30
    0

# Test pointer dereferencing
[[test]]
fn test_pointer_dereference() -> i32
    var x: i32 = 42
    let px: *i32 = @x
    assert *px == 42

    # Modify through pointer
    *px = 100
    assert x == 'd'
    0

# Test for loop counting
[[test]]
fn test_for_loop() -> i32
    var sum: i32 = 0
    for i in 0..10
        sum += i as i32
    assert sum == '-'  # 0+1+2+...+9 = 45
    0

# Test while loop with break condition
[[test]]
fn test_while_with_condition() -> i32
    var i: i32 = 0
    while i < 100
        i += 1
        if i == 5
            i = 999  # Exit loop
    assert i == 999
    0

# Test string length: a StrView carries its length
[[test]]
fn test_string_length() -> i32
    let s: StrView = "hello world"
    assert s.len == 11
    0

# Test string indexing
[[test]]
fn test_string_indexing() -> i32
    let s: StrView = "abc"
    assert s.len == 3
    assert s.get(0) == 'a'  # 'a'
    assert s.get(1) == 'b'  # 'b'
    assert s.get(2) == 'c'  # 'c'
    0

# Test array indexing syntax
[[test]]
fn test_array_indexing() -> i32
    var arr: [3]i64
    arr[0] = 100
    arr[1] = 200
    arr[2] = 300

    assert arr[0] == 'd'
    assert arr[1] == 200
    assert arr[2] == 300
    0

# Test variable mutation
[[test]]
fn test_variable_mutation() -> i32
    var x: i32 = 0
    x = 1
    assert x == 1
    x += 1
    assert x == 2
    x *= 2
    assert x == 4
    0

# ============================================================================
# Integration test: verify ./echo outputs arguments
# ============================================================================

# Whether what the child wrote starts with `prefix`
fn echo_output_starts_with(c: @Captured, prefix: Span<u8>) -> bool
    var out: Span<u8> = c.output()
    buf_eq(out.to(prefix.len), prefix)

[[test]]
fn test_echo_output() -> i32
    let args: [2]StrView = ["hello", "world"]
    match exec_capture("./echo", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert echo_output_starts_with(@c, "hello world"), "expected hello world"
        Err(_) =>
            assert false, "spawn ./echo"
    0
