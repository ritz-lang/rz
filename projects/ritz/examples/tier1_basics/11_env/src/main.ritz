# 11_env: Print the environment
#
# Demonstrates:
# - `main(args: Span<StrView>, env: Span<StrView>)` (LANGUAGE_SPEC §5.7):
#   each element of `env` is one `KEY=VALUE`
# - Looking one variable up by name with ritzlib.os.env, which needs no
#   `env` parameter: most programs only do this
#
# Usage: env -i GREETING=hi FOO=1 ./env
# Output:
#   GREETING=hi
#   FOO=1
#   greeting: hi

import ritzlib.sys
import ritzlib.os.env

fn put(s: StrView)
  sys_write(STDOUT, s.ptr, s.len)

pub fn main(args: Span<StrView>, env: Span<StrView>) -> i32
  var i: i64 = 0
  while i < env.len
    put(env[i])
    put("\n")
    i += 1
  put("greeting: ")
  put(env_get_or("GREETING", "(unset)"))
  put("\n")
  0
