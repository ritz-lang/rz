# 05_cat: Concatenate and print files
#
# Demonstrates:
# - Const declarations
# - File I/O through ritzlib.fd's Fd (open, read, write, close)
# - File descriptor handling
# - Error checking with Result
# - Buffer-based I/O with stack allocation
# - Multiple function definitions
#
# Usage:
#   ./cat              # Read from stdin
#   ./cat file.txt     # Print file contents
#   ./cat a.txt b.txt  # Concatenate multiple files

import ritzlib.fd { Fd, fd_open, fd_adopt, fd_stdin, fd_stdout, O_RDONLY }
import ritzlib.strview { StrView }
import ritzlib.span { Span }

const BUF_SIZE: i64 = 4096

# Cat one open file to stdout
# Returns 0 on success, 1 on error
fn cat_fd(f: @Fd, buf: *u8) -> i32
  var n: i64 = 1

  while n > 0
    n = match f.read(Span<u8> { ptr: buf, len: BUF_SIZE })
      Ok(k) => k
      Err(_) => -1
    if n < 0
      return 1
    if n > 0
      match fd_stdout().write_all(Span<u8> { ptr: buf, len: n })
        Ok(_) => pass
        Err(_) => return 1

  0

pub fn main(args: Span<StrView>) -> i32
  # Allocate buffer on stack
  let buf: *u8 = __builtin_alloca(BUF_SIZE)

  # No args: read from stdin
  if args.len == 1
    let input: Fd = fd_stdin()
    return cat_fd(@input, buf)

  # Process each file argument
  var i: i64 = 1
  while i < args.len
    var file: Fd = fd_adopt(-1)
    match fd_open(args[i], O_RDONLY, 0)
      Ok(f) => file = f
      Err(_) => return 1

    let result = cat_fd(@file, buf)
    file.close()

    if result != 0
      return result

    i += 1

  0
