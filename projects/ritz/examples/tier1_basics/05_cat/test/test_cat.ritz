# Tests for 05_cat - file I/O through Fd
#
# The 05_cat example demonstrates:
# - Const declarations
# - File I/O through ritzlib.fd's Fd (open, read, write, close)
# - File descriptor handling
# - Error checking with Result
# - Buffer-based I/O with stack allocation
# - Multiple function definitions

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.span
import ritzlib.fd
import ritzlib.fs
import ritzlib.testlib

# This test's scratch file, "/tmp/ritz_test_cat_<pid>_in" (testlib's
# sandbox_path). The pid keeps concurrent runs (rooms gating on one host) off
# each other's file: a shared fixed path let one run's O_TRUNC race another's
# read (AGAST #1735, #1738).
fn cat_tmp_path() -> String
    sandbox_path("test_cat", "in")

[[test]]
fn test_cat_tmp_path_is_per_process() -> i32
    let path: String = cat_tmp_path()
    let pid: String = string_from_i64(sys_getpid() as i64)
    assert path.as_view().contains(pid.as_view())
    0

# Test let/var declaration
[[test]]
fn test_let_value() -> i32
    let value: i32 = 42
    assert value == 42
    0

# Test variable expression
[[test]]
fn test_var_expression() -> i32
    var size: i64 = 1024
    let double_size: i64 = size * 2
    assert double_size == 2048
    0

# Test buffer allocation with malloc
[[test]]
fn test_buffer_alloc() -> i32
    let buf: *u8 = malloc(256)
    assert buf != null

    # Can write to buffer
    *buf = 65  # 'A'
    *(buf + 1) = 66  # 'B'
    *(buf + 2) = 0

    assert *buf == 'A'
    assert *(buf + 1) == 66

    free(buf)
    0

# Test memset
[[test]]
fn test_memset() -> i32
    var buf: [16]u8
    memset(@buf[0], 42, 16)

    for i in 0..16
        assert buf[i] == 42
    0

# Test memcpy
[[test]]
fn test_memcpy() -> i32
    let src = c"hello"
    var dst: [16]u8

    memcpy(@dst[0], src, 6)  # Include null terminator

    assert dst[0] == 104  # 'h'
    assert dst[1] == 'e'  # 'e'
    assert dst[2] == 108  # 'l'
    assert dst[3] == 108  # 'l'
    assert dst[4] == 111  # 'o'
    assert dst[5] == 0
    0

# Test string comparison
[[test]]
fn test_streq() -> i32
    assert streq(c"hello", c"hello")
    assert not streq(c"hello", c"world")
    assert not streq(c"abc", c"abcd")
    assert streq(c"", c"")
    0

# Test strlen
[[test]]
fn test_strlen() -> i32
    assert strlen(c"") == 0
    assert strlen(c"a") == 1
    assert strlen(c"hello") == 5
    assert strlen(c"hello world") == 11
    0

# Test Fd write to /dev/null
[[test]]
fn test_write_devnull() -> i32
    var file: Fd = fd_adopt(-1)
    match fd_open("/dev/null", O_WRONLY, 0)
        Ok(f) => file = f
        Err(_) => return 1

    let written: Result<i64, Errno> = file.write("test message")
    file.close()

    assert written.unwrap_or(-1) == 12
    0

# Test Fd read from /dev/zero
[[test]]
fn test_read_devzero() -> i32
    var file: Fd = fd_adopt(-1)
    match fd_open("/dev/zero", O_RDONLY, 0)
        Ok(f) => file = f
        Err(_) => return 1

    var buf: [16]u8
    let n: Result<i64, Errno> = file.read(Span<u8> { ptr: @buf[0], len: 16 })
    file.close()

    assert n.unwrap_or(-1) == 16
    # /dev/zero returns all zeros
    for i in 0..16
        assert buf[i] == 0
    0

# Test file open/close cycle
[[test]]
fn test_open_close() -> i32
    var file: Fd = fd_adopt(-1)
    match fd_open("/dev/null", O_RDONLY, 0)
        Ok(f) => file = f
        Err(_) => return 1
    assert file.valid()

    let result: Result<(), Errno> = file.close()
    assert result.is_ok()
    0

# Test invalid file returns error
[[test]]
fn test_open_invalid() -> i32
    let r: Result<Fd, Errno> = fd_open("/nonexistent/path/file", O_RDONLY, 0)
    assert r.is_err()
    0

# ============================================================================
# Integration test: verify ./cat reads and outputs file content
# ============================================================================

# Whether what the child wrote starts with `prefix`
fn cat_output_starts_with(c: @Captured, prefix: Span<u8>) -> bool
    var out: Span<u8> = c.output()
    var want: Span<u8> = prefix
    span_starts_with(@out, @want)

[[test]]
fn test_cat_file() -> i32
    let path: String = cat_tmp_path()
    match write_file(path.as_view(), "test content for cat")
        Ok(_) => pass
        Err(_) => return 1
    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./cat", @args, span_empty<StrView>(), "")
    unlink(path.as_view())
    match r
        Ok(c) =>
            assert cat_output_starts_with(@c, "test content"), "expected test content"
        Err(_) =>
            assert false, "spawn ./cat"
    0
