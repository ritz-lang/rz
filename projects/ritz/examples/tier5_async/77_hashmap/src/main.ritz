# Example 77: HashMap and hash
#
# ritz1 links ritzlib.hashmap and ritzlib.hash into itself, so
# this example makes the ritz0-vs-ritz1 differential stages exercise them
# (AGAST #1458).  Three parts:
#
# 1. Golden hash values.  fnv1a_str / hash_i32 / hash_i64 / hash_u64 and the
#    fnv1a_* combinators on fixed inputs, printed as 16 hex digits.  test.sh
#    holds the reference values (computed independently from the FNV-1a
#    spec), so a hash that drifts under either compiler shows up.
# 2. The HashMapI64 API on integer keys: new / with_cap / insert / get /
#    contains / remove / len / is_empty / cap / clear / grow, in both the
#    free-function and the method form.
# 3. A word-frequency counter over stdin.  Words are runs of ASCII letters
#    and digits, lower-cased.  Each word is keyed by its FNV-1a hash; one
#    map counts, a second maps hash -> first occurrence.  "the" is removed
#    as a stop word, then the surviving entries are collected by iterating
#    the table and printed sorted by word, so the output does not depend on
#    iteration order.  Empty stdin (the regression suite runs every example
#    with </dev/null) counts a built-in sentence instead.

import ritzlib.sys
import ritzlib.io
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.fmt
import ritzlib.span
import ritzlib.strview
import ritzlib.string
import ritzlib.fd { fd_stdin }

# Write one raw byte to stdout (the fd writer is unbuffered, so it stays
# ordered with print).
fn put_byte(c: u8)
    var w = stdout_writer()
    w.write_byte(c)

const BUF_SIZE: i64 = 65536
const MAX_WORDS: i64 = 1024

# ============================================================================
# Output helpers
# ============================================================================

# Print exactly 16 lower-case hex digits, so the golden values are fixed-width
# and a u64 with the top bit set prints the same as any other.
fn print_hex16(v: u64)
    var shift: i64 = 60
    while shift >= 0
        let d: u64 = (v >> (shift as u64)) & 15
        if d < 10
            put_byte((d + 48) as u8)
        else
            put_byte((d + 87) as u8)
        shift -= 4

fn show_hash(label: StrView, h: u64)
    print("{label}")
    print_hex16(h)
    print("\n")

fn show(label: StrView, v: i64)
    print("{label}{v}\n")

fn hash_str(s: StrView) -> u64
    return fnv1a_str(span_from_strview(s))

# ============================================================================
# Part 1: golden hashes
# ============================================================================

fn golden_hashes()
    println("== hash ==")
    show_hash("fnv1a_init: ", fnv1a_init())
    show_hash("fnv1a_str(\"\"): ", hash_str(""))
    show_hash("fnv1a_str(\"a\"): ", hash_str("a"))
    show_hash("fnv1a_str(\"foobar\"): ", hash_str("foobar"))
    show_hash("fnv1a_str(\"hashmap\"): ", hash_str("hashmap"))
    show_hash("fnv1a_byte(init, 255): ", fnv1a_byte(fnv1a_init(), 255))
    show_hash("hash_i32(0): ", hash_i32(0))
    show_hash("hash_i32(-1): ", hash_i32(-1))
    show_hash("hash_i32(305419896): ", hash_i32(305419896))
    show_hash("hash_i64(0): ", hash_i64(0))
    show_hash("hash_i64(42): ", hash_i64(42))
    show_hash("hash_i64(-42): ", hash_i64(-42))
    show_hash("hash_u64(1): ", hash_u64(1))
    show_hash("hash_u64(hash_i64(42)): ", hash_u64(hash_i64(42)))
    # Combinators chain: i32 then i64 then u64 into one running hash.
    var h: u64 = fnv1a_init()
    h = fnv1a_i32(h, 7)
    h = fnv1a_i64(h, -7)
    h = fnv1a_u64(h, 7)
    show_hash("fnv1a_i32/i64/u64 chain: ", h)

# ============================================================================
# Part 2: the HashMapI64 API on integer keys
# ============================================================================

fn map_api()
    println("== map ==")
    var sized: HashMapI64 = hashmap_i64_with_cap(100)
    show("with_cap(100).cap: ", sized.cap())

    var m: HashMapI64 = hashmap_i64_new()
    show("new.len: ", m.len())
    show("new.is_empty: ", m.is_empty() as i64)
    show("new.cap: ", m.cap())

    # 20 keys: past the 75% load factor of a 16-slot table, so this grows.
    var i: i64 = 0
    while i < 20
        m.insert(i * i, i)
        i += 1
    show("after 20 inserts len: ", m.len())
    show("after 20 inserts cap: ", m.cap())
    show("get(49): ", m.get(49))
    show("get(361): ", m.get(361))
    show("contains(50): ", m.contains(50) as i64)
    show("get(50) (missing): ", m.get(50))

    # Update in place: same key, len unchanged.
    m.insert(49, 700)
    show("update get(49): ", m.get(49))
    show("update len: ", m.len())

    # Remove leaves a tombstone; a probe past it must still find later keys.
    show("remove(49): ", m.remove(49) as i64)
    show("remove(49) again: ", m.remove(49) as i64)
    show("contains(49): ", m.contains(49) as i64)
    show("len after remove: ", m.len())
    var sum: i64 = 0
    i = 0
    while i < 20
        sum += m.get(i * i)
        i += 1
    show("sum of values: ", sum)
    m.insert(49, 7)
    show("reinsert len: ", m.len())

    # Negative and large keys hash like any other.
    m.insert(-5, 55)
    m.insert(1 << 62, 62)
    show("get(-5): ", m.get(-5))
    show("get(1 << 62): ", m.get(1 << 62))

    # The method form: `impl HashMapI64` lives in ritzlib.hashmap, so under
    # ritz1 each call needs an extern declare of `HashMapI64_<method>`
    # (AGAST #1518).
    m.insert(1000, 1)
    m.insert(1000, 2)
    show("m.get(1000): ", m.get(1000))
    show("m.contains(1000): ", m.contains(1000) as i64)
    show("m.remove(1000): ", m.remove(1000) as i64)
    show("m.len(): ", m.len())
    show("m.is_empty(): ", m.is_empty() as i64)
    show("m.cap(): ", m.cap())

    # clear keeps the allocation.
    m.clear()
    show("clear len: ", m.len())
    show("clear is_empty: ", m.is_empty() as i64)
    show("clear cap: ", m.cap())
    show("clear get(0): ", m.get(0))

    # Explicit drop on one map; `sized` is released by Drop at scope exit.
    m.free()
    show("drop cap: ", m.cap())

# ============================================================================
# Part 3: word frequencies
# ============================================================================

fn is_word_byte(c: u8) -> bool
    if c >= 'a' && c <= 'z'
        return true
    if c >= 'A' && c <= 'Z'
        return true
    if c >= '0' && c <= '9'
        return true
    return false

fn lower(c: u8) -> u8
    if c >= 'A' && c <= 'Z'
        return c + 32
    return c

# Lexicographic byte compare of two words in `buf`: <0, 0, >0.
fn word_cmp(buf: StrView, a_start: i64, a_len: i64, b_start: i64, b_len: i64) -> i64
    var i: i64 = 0
    while i < a_len && i < b_len
        let ca: i64 = buf.get(a_start + i) as i64
        let cb: i64 = buf.get(b_start + i) as i64
        if ca != cb
            return ca - cb
        i += 1
    return a_len - b_len

# The word at `start`, `len` bytes long, in `buf`.
fn word_at(buf: StrView, start: i64, len: i64) -> StrView
    return buf.slice(start, start + len)

fn word_counts()
    println("== words ==")

    # Slurp stdin (the first BUF_SIZE bytes of it); fall back to a built-in
    # sentence when it is empty.
    var input: String = string_new()
    match fd_stdin().read_to_end(@&input)
        Ok(_) => pass
        Err(_) => pass
    var raw: StrView = input.as_view()
    if raw.len == 0
        raw = "The quick brown fox jumps over the lazy dog. The dog barks; the fox runs, and the quick cat naps in a warm sunny spot near the old red barn."
        println("source: builtin")
    else
        println("source: stdin")
    let n: i64 = raw.take(BUF_SIZE).len

    # Words are case-folded; lower() only changes word bytes (A-Z), so fold
    # the whole text up front.
    var folded: String = string_with_cap(n)
    var k: i64 = 0
    while k < n
        folded.push(lower(raw.get(k)))
        k += 1
    let buf: StrView = folded.as_view()

    # counts: word hash -> occurrences.  first: word hash -> slot in the word
    # table (start/len of the word's first occurrence in buf).
    var counts: HashMapI64 = hashmap_i64_new()
    var first: HashMapI64 = hashmap_i64_new()
    var wstart: [1024]i64
    var wlen: [1024]i64
    var nwords: i64 = 0
    var total: i64 = 0

    var pos: i64 = 0
    while pos < n
        if !is_word_byte(buf.get(pos))
            pos += 1
            continue
        let start: i64 = pos
        while pos < n && is_word_byte(buf.get(pos))
            pos += 1
        let len: i64 = pos - start
        let key: i64 = hash_str(word_at(buf, start, len)) as i64
        total += 1
        if counts.contains(key)
            # A 64-bit FNV collision between two different words would merge
            # their counts silently; refuse instead.
            let slot: i64 = first.get(key)
            if word_cmp(buf, wstart[slot], wlen[slot], start, len) != 0
                println("error: hash collision")
                return
            let count: i64 = counts.get(key) + 1
            counts.insert(key, count)
        else
            if nwords == MAX_WORDS
                println("error: too many distinct words")
                return
            wstart[nwords] = start
            wlen[nwords] = len
            first.insert(key, nwords)
            counts.insert(key, 1)
            nwords += 1

    show("words: ", total)
    show("distinct: ", counts.len())
    show("cap: ", counts.cap())

    # Drop the stop word "the" from the counts (not from `first`).
    let the_key: i64 = hash_str("the") as i64
    show("the: ", counts.get(the_key))
    show("remove the: ", counts.remove(the_key) as i64)
    show("remove the again: ", counts.remove(the_key) as i64)
    show("distinct without the: ", counts.len())

    # Iterate the table: every occupied slot is one surviving word.
    var order: [1024]i64
    var norder: i64 = 0
    var s: i64 = 0
    while s < counts.cap
        let e: *HashMapEntryI64 = counts.entries + s
        if e.state == Slot.Full
            order[norder] = first.get(e.key)
            norder += 1
        s += 1
    show("iterated: ", norder)

    # Insertion sort by word.
    var i: i64 = 1
    while i < norder
        let cur: i64 = order[i]
        var j: i64 = i - 1
        while j >= 0 && word_cmp(buf, wstart[order[j]], wlen[order[j]], wstart[cur], wlen[cur]) > 0
            order[j + 1] = order[j]
            j -= 1
        order[j + 1] = cur
        i += 1

    i = 0
    while i < norder
        let w: i64 = order[i]
        let word: StrView = word_at(buf, wstart[w], wlen[w])
        let key: i64 = hash_str(word) as i64
        prints(word)
        print(" {counts.get(key)}\n")
        i += 1

pub fn main() -> i32
    golden_hashes()
    map_api()
    word_counts()
    return 0
