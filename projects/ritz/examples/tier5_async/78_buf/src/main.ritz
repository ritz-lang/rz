# Example 78: buf — Buffer cursor and GrowBuf, over stdin read with vec_read_all_fd
#
# ritzlib.buf had no example, so neither differential ritz0-vs-ritz1 stage
# exercised it (AGAST #1457).  It was written against the old
# `(out: *u8, max_len)` API and pinned that behaviour in test.sh; #1478 ported
# it to the idiomatic API (StrView in, zero-copy StrView slices out, bool
# predicates, a typed `fn(u8) -> bool` predicate, quoted strings decoded into
# a String) with test.sh's golden output left byte-for-byte unchanged.  The
# lines whose labels say "max N" still call the deprecated out-buffer forms,
# which stay for one release: they pin the truncation the new forms remove.
#
# Two parts:
#
# 1. `== api ==` — every public Buffer and GrowBuf function on fixed input,
#    edge cases included (EOF, out-of-range peeks, clamped advance/skip,
#    max_len truncation, unterminated and non-quoted strings, capacity
#    doubling).
# 2. `== tokens ==` — a small config tokenizer.  stdin is slurped with
#    io's vec_read_all_fd into a Vec<u8> (ritzlib's one read-all-fd loop,
#    #1942), then walked with a Buffer:
#
#        # comment            // comment          [section]
#        key = 42             key = "quoted\tstr" key = 'single'
#        key = bare words     key = 42abc  (digits, then backtrack -> bare)
#
#    Each token is printed with its line:col from buf_get_loc.  Anything else
#    is reported as an error and the rest of the line skipped.  Empty stdin
#    (the regression suite runs every example with </dev/null) tokenizes a
#    built-in config instead.

import ritzlib.sys
import ritzlib.io
import ritzlib.buf
import ritzlib.gvec
import ritzlib.result
import ritzlib.string
import ritzlib.strview

const DQUOTE: u8 = 34
const SQUOTE: u8 = 39

# ============================================================================
# Output helpers
# ============================================================================

fn show(label: *u8, v: i64)
    prints_cstr(label)
    print_int(v)
    print_char('\n')

# Print `n` bytes of `s` between brackets, with control characters made
# visible so the golden output stays one line per token.
fn show_bytes(s: *u8, n: i64)
    print_char('[')
    var i: i64 = 0
    while i < n
        let c: u8 = *(s + i)
        if c == '\n'
            prints_cstr(c"\\n")
        else if c == '\t'
            prints_cstr(c"\\t")
        else if c == 0
            prints_cstr(c"\\0")
        else
            print_char(c)
        i += 1
    print_char(']')

fn show_view(v: StrView)
    show_bytes(v.ptr, v.len)

# `label` [text] (n)
fn show_str(label: *u8, s: *u8, n: i64)
    prints_cstr(label)
    show_bytes(s, n)
    prints_cstr(c" (")
    print_int(n)
    prints_cstr(c")\n")

fn show_sv(label: *u8, v: StrView)
    show_str(label, v.ptr, v.len)

# The decoded bytes of a String, as a view (valid until `s` changes).
fn string_view(s: @&String) -> StrView
    return strview_from_ptr(s.as_ptr(), s.len())

# take_quoted's bool, in the -1 / length form the golden output uses.
fn quoted_result(ok: bool, s: @String) -> i64
    if ok
        return s.len()
    return -1

fn show_loc(b: @Buffer)
    var loc: BufLoc
    b.get_loc(@&loc)
    print_int(loc.line as i64)
    print_char(':')
    print_int(loc.col as i64)

# ============================================================================
# Part 1: the API on fixed input
# ============================================================================

fn api_buffer()
    var b: Buffer = buf_new("hello, world")
    var out: [16]u8
    var q: String = string_new()

    show(c"from_str len: ", b.len())
    show(c"pos: ", b.pos())
    show(c"remaining: ", b.remaining())
    show(c"eof: ", b.eof() as i64)
    show(c"peek: ", b.peek() as i64)
    show(c"peek_at(4): ", b.peek_at(4) as i64)
    show(c"peek_at(-1): ", b.peek_at(-1) as i64)
    show(c"peek_at(12): ", b.peek_at(12) as i64)
    show_sv(c"peek_n(5): ", b.peek_view(5))
    show(c"pos after peeks: ", b.pos())
    show(c"starts_with(hell): ", b.starts_with("hell") as i64)
    show(c"starts_with(help): ", b.starts_with("help") as i64)
    show(c"pos after starts_with: ", b.pos())
    show(c"match_str(help): ", b.match_str("help") as i64)
    show(c"match_str(hello): ", b.match_str("hello") as i64)
    show(c"pos: ", b.pos())
    show(c"match_char(';'): ", b.match_char(';') as i64)
    show(c"match_char(','): ", b.match_char(',') as i64)
    show(c"skip_whitespace: ", b.skip_whitespace())
    show(c"advance: ", b.advance() as i64)
    show(c"skip_while(digit): ", b.skip_while(buf_is_digit))
    let saved: i64 = b.save()
    show(c"save: ", saved)
    show(c"skip_until('d'): ", b.skip_until('d'))
    show(c"pos: ", b.pos())
    b.restore(saved)
    show(c"restore pos: ", b.pos())
    show(c"advance_n(100): ", b.advance_n(100))
    show(c"eof: ", b.eof() as i64)
    show(c"advance at eof: ", b.advance() as i64)
    show(c"peek at eof: ", b.peek() as i64)
    show(c"match_str(\"\") at eof: ", b.match_str("") as i64)
    b.restore(0)
    b.skip(7)
    show(c"skip(7) pos: ", b.pos())
    b.skip(50)
    show(c"skip(50) pos: ", b.pos())
    # A view into the middle of a string: the byte before it is 'x', so
    # peek_at(-1) returning 0 shows the lower bound is checked.
    let mid: StrView = "xyz"
    b = buf_new(mid.slice(1, 3))
    show(c"interior peek_at(-1): ", b.peek_at(-1) as i64)
    show(c"interior peek_at(0): ", b.peek_at(0) as i64)
    show(c"interior peek_at(2): ", b.peek_at(2) as i64)

    # A sub-view: only the first 9 bytes are visible.
    let whole: StrView = "abc123_x9 rest"
    b = buf_new(whole.take(9))
    show(c"init len: ", b.len())
    show_sv(c"read_while_digit (at 'a'): ", b.take_digits())
    show_sv(c"read_while_alnum: ", b.take_ident())
    show(c"eof (len-bounded): ", b.eof() as i64)
    b = buf_new("2026-10-05")
    show_sv(c"read_while_digit: ", b.take_digits())
    # DEPRECATED form: max_len counts the NUL, 3 leaves room for 2 bytes.
    b.match_char('-')
    var n: i64 = b.read_while_digit(Span<u8> { ptr: @out[0], len: 3 })
    show_str(c"read_while_digit max 3: ", @out[0], n)
    show(c"pos: ", b.pos())

    b.from_str("name:value")
    show_sv(c"read_until(':'): ", b.take_until(':'))
    show(c"stops before delim, peek: ", b.peek() as i64)
    b.restore(0)
    # DEPRECATED form: truncates to max_len - 1 bytes.
    n = b.read_until(':', Span<u8> { ptr: @out[0], len: 4 })
    show_str(c"read_until max 4: ", @out[0], n)
    show(c"pos: ", b.pos())
    b.restore(5)
    show_sv(c"read_until (no delim): ", b.take_until('#'))

    b.from_str("\"a\\tb\\\"c\\\\d\\n\\qe\" tail")
    var ok: bool = b.take_quoted(DQUOTE, @&q)
    show_str(c"read_quoted escapes: ", q.as_ptr(), quoted_result(ok, @q))
    show(c"pos after closing quote: ", b.pos())
    q.clear()
    ok = b.take_quoted(DQUOTE, @&q)
    show(c"read_quoted (not at quote): ", quoted_result(ok, @q))
    show(c"pos unchanged: ", b.pos())
    b.from_str("'unterminated")
    ok = b.take_quoted(SQUOTE, @&q)
    show(c"read_quoted unterminated: ", quoted_result(ok, @q))
    show_sv(c"  partial: ", string_view(@&q))
    # DEPRECATED form: running out of max_len is reported as -1 too.
    b.from_str("\"abcdef\"")
    n = match b.read_quoted(DQUOTE, Span<u8> { ptr: @out[0], len: 4 })
        Ok(v) => v
        Err(_) => -1
    show(c"read_quoted max 4: ", n)
    show_str(c"  partial: ", @out[0], 3)
    show(c"  pos: ", b.pos())

    b.from_str("ab\ncd\n\nx")
    b.restore(4)
    prints_cstr(c"loc at 4: ")
    show_loc(@b)
    print_char('\n')
    b.restore(7)
    prints_cstr(c"loc at 7: ")
    show_loc(@b)
    print_char('\n')
    b.restore(0)
    prints_cstr(c"loc at 0: ")
    show_loc(@b)
    print_char('\n')

fn show_growbuf(label: *u8, g: @GrowBuf)
    prints_cstr(label)
    prints_cstr(c" len=")
    print_int(g.len())
    prints_cstr(c" cap=")
    print_int(g.cap())
    prints_cstr(c" empty=")
    print_int(g.is_empty() as i64)
    print_char('\n')

fn api_growbuf()
    var g: GrowBuf = growbuf_new()
    show_growbuf(c"new:", @g)
    show(c"new data null: ", (g.data() == null) as i64)
    g.append_byte('x')
    show_growbuf(c"append_byte:", @g)
    g.append_view("yz0123456789")
    show_growbuf(c"append 12:", @g)
    show_sv(c"contents: ", g.view())
    show(c"get(0): ", g.get(0) as i64)
    show(c"get(12): ", g.get(12) as i64)
    show(c"get(13) (out of range): ", g.get(13) as i64)
    show(c"get(-1) (out of range): ", g.get(-1) as i64)
    show(c"ensure_cap(64): ", g.ensure_cap(64) as i64)
    show_growbuf(c"  ->", @g)
    show(c"ensure_cap(65): ", g.ensure_cap(65) as i64)
    show_growbuf(c"  ->", @g)
    show(c"ensure_cap(300): ", g.ensure_cap(300) as i64)
    show_growbuf(c"  ->", @g)
    show(c"grow(100) (smaller): ", g.grow(100) as i64)
    show_growbuf(c"  ->", @g)
    show(c"grow(1000): ", g.grow(1000) as i64)
    show_growbuf(c"  ->", @g)
    show_sv(c"contents kept: ", g.view())
    var i: i64 = 0
    while i < 1000
        g.append_byte(('a' + (i % 26) as u8))
        i += 1
    show_growbuf(c"+1000 bytes:", @g)
    show(c"get(13 + 999): ", g.get(1012) as i64)
    g.clear()
    show_growbuf(c"clear:", @g)
    # The bytes are still allocated, but len bounds get().
    show(c"get(0) after clear: ", g.get(0) as i64)
    g.free()
    show_growbuf(c"free:", @g)
    show(c"free data null: ", (g.data() == null) as i64)

    var w: GrowBuf = growbuf_with_cap(10)
    show_growbuf(c"with_cap(10):", @w)
    var z: GrowBuf = growbuf_with_cap(0)
    show_growbuf(c"with_cap(0):", @z)
    var neg: GrowBuf = growbuf_with_cap(-5)
    show_growbuf(c"with_cap(-5):", @neg)

# ============================================================================
# Part 2: a config tokenizer over stdin
# ============================================================================

fn is_value_end(c: u8) -> bool
    return c == 0 or c == '\n' or c == '\r' or c == ' ' or c == '\t' or c == '#'

fn is_blank(c: u8) -> bool
    return c == ' ' or c == '\t'

fn token_head(b: @Buffer, kind: *u8)
    show_loc(b)
    print_char(' ')
    prints_cstr(kind)
    print_char(' ')

# token_head for an item that started at `pos`; the cursor is left where it
# was.  (Saving a position rather than copying the Buffer: ritz1 cannot yet
# dereference an @&Buffer param by value.)
fn token_head_at(b: @&Buffer, pos: i64, kind: *u8)
    let here: i64 = b.save()
    b.restore(pos)
    token_head(b, kind)
    b.restore(here)

# Report an error at the cursor and skip the rest of the line.
fn token_error(b: @&Buffer, msg: *u8)
    token_head(b, c"error")
    prints_cstr(msg)
    prints_cstr(c" (got ")
    print_int(b.peek() as i64)
    prints_cstr(c")\n")
    b.skip_until('\n')

# Value after `=`: quoted, number, or bare text to end of line.
fn read_value(b: @&Buffer, tok: @&String)
    let c: u8 = b.peek()
    if c == DQUOTE or c == SQUOTE
        token_head(b, c"string")
        tok.clear()
        if not b.take_quoted(c, tok)
            prints_cstr(c"unterminated\n")
            b.skip_until('\n')
            return
        show_view(string_view(tok))
        print_char('\n')
        return
    # Try a number; backtrack if it runs straight into more text (42abc).
    let mark: i64 = b.save()
    let digits: StrView = b.take_digits()
    if digits.len > 0 and is_value_end(b.peek())
        token_head_at(b, mark, c"number")
        show_view(digits)
        print_char('\n')
        return
    b.restore(mark)
    token_head(b, c"bare")
    let line: StrView = b.take_until('\n')
    # Trim trailing whitespace and a '\r' (CRLF input).
    var n: i64 = line.len
    while n > 0 and (is_blank(*(line.ptr + n - 1)) or *(line.ptr + n - 1) == '\r')
        n -= 1
    show_view(line.take(n))
    print_char('\n')

fn tokenize(b: @&Buffer) -> i64
    var tok: String = string_new()
    var count: i64 = 0
    loop
        b.skip_whitespace()
        if b.eof()
            break
        count += 1
        # The item's first byte, for its line:col.
        let at: i64 = b.save()
        if b.peek() == '#' or b.starts_with("//")
            token_head(b, c"comment")
            if not b.match_char('#')
                b.advance_n(2)
            b.skip_whitespace()
            show_view(b.take_until('\n'))
            print_char('\n')
        else if b.match_char('[')
            token_head_at(b, at, c"section")
            let name: StrView = b.take_until(']')
            if not b.match_char(']')
                prints_cstr(c"unclosed\n")
                continue
            show_view(name)
            print_char('\n')
        else
            let key: StrView = b.take_while(buf_is_ident)
            if key.len == 0
                token_error(b, c"expected key")
                continue
            token_head_at(b, at, c"key")
            show_view(key)
            print_char('\n')
            b.skip_while(is_blank)
            if not b.match_char('=')
                token_error(b, c"expected '='")
                continue
            b.skip_while(is_blank)
            read_value(b, @&tok)
    return count

fn builtin_config() -> StrView
    return "# built-in config\n[server]\nhost = \"example.org\"\nport = 8080\n\n// motd\nmotd = 'hi\\tthere'\nname = web 01  \nid = 42abc\noops\n= 3\n"

fn main() -> i32
    println("== api ==")
    api_buffer()
    api_growbuf()

    println("== tokens ==")
    var input: Vec<u8> = vec_new<u8>()
    let got: i64 = match vec_read_all_fd(0, @&input)
        Ok(n) => n
        Err(_) => -1
    if got < 0
        println("vec_read_all_fd failed")
        return 1
    var src: StrView = strview_from_ptr(input.data, input.len)
    if input.len == 0
        println("source: builtin")
        src = builtin_config()
    else
        println("source: stdin")
    show(c"bytes: ", src.len)

    var b: Buffer = buf_new(src)
    let count: i64 = tokenize(@&b)
    show(c"items: ", count)
    prints_cstr(c"end: ")
    show_loc(@b)
    print_char('\n')
    return 0
