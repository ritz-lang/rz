# examples/75_async_reference - Idiomatic Async Ritz Reference
#
# This is the GOLD STANDARD for async code in Ritz.
# Valet and other async applications should follow these patterns.
#
# Goals:
#   1. Clean, readable async/await syntax
#   2. No manual state machine boilerplate
#   3. Composable async functions
#   4. Proper error handling
#
# This example demonstrates:
#   - async fn declarations
#   - await expressions
#   - Chained async calls
#   - Async with I/O operations

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.fmt

# ============================================================================
# Test 1: Simple async function (no await)
# ============================================================================

async fn add_values(a: i32, b: i32) -> i32
    a + b

fn test_simple_async() -> i32
    print("test_simple_async... ")

    # The generated `add_values$Future`/`add_values$poll` are unspellable
    # (AGAST #3606): hold the future untyped and drive it through its header.
    var future = add_values(10, 32)

    # The poll is true once Ready, the value in the future (LARB R78)
    if !future_poll(@&future)
        print("FAIL: got Pending\n")
        return 1
    let result: i32 = future.__result

    if result != 42
        print("FAIL: expected 42, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 2: Async function with single await
# ============================================================================

# A poll function that always returns Ready: `None` would be Pending,
# `Some(v)` is Ready(v) (AGAST #4558)
fn immediate_value(x: i32) -> Option<i32>
    Some(x * 2)

async fn double_and_add(x: i32) -> i32
    let doubled: i32 = await immediate_value(x)
    doubled + 5

fn test_async_with_await() -> i32
    print("test_async_with_await... ")

    var future = double_and_add(10)
    # The poll is true once Ready, the value in the future (LARB R78)
    if !future_poll(@&future)
        print("FAIL: got Pending\n")
        return 1
    let result: i32 = future.__result

    # Expected: 10 * 2 + 5 = 25
    if result != 25
        print("FAIL: expected 25, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 3: Async calling async (clean chaining)
# ============================================================================

async fn compute_base(x: i32) -> i32
    x * 3

async fn compute_derived(x: i32) -> i32
    let base: i32 = await compute_base(x)
    base + 10

async fn compute_final(x: i32) -> i32
    let derived: i32 = await compute_derived(x)
    derived * 2

fn test_async_chain() -> i32
    print("test_async_chain... ")

    var future = compute_final(5)
    # The poll is true once Ready, the value in the future (LARB R78)
    if !future_poll(@&future)
        print("FAIL: got Pending\n")
        return 1
    let result: i32 = future.__result

    # Expected: ((5 * 3) + 10) * 2 = (15 + 10) * 2 = 50
    if result != 50
        print("FAIL: expected 50, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 4: Multiple sequential awaits in one function
# ============================================================================

# Poll sources, each Ready at once
fn step_a(x: i32) -> Option<i32>
    Some(x + 1)

fn step_b(x: i32) -> Option<i32>
    Some(x * 2)

fn step_c(x: i32) -> Option<i32>
    Some(x - 3)

async fn pipeline(x: i32) -> i32
    let a: i32 = await step_a(x)
    let b: i32 = await step_b(a)
    let c: i32 = await step_c(b)
    c

fn test_sequential_awaits() -> i32
    print("test_sequential_awaits... ")

    var future = pipeline(10)

    # Need to poll multiple times if any await returns Pending
    # For immediate poll functions, one poll is enough
    # The poll is true once Ready, the value in the future (LARB R78)
    if !future_poll(@&future)
        print("FAIL: got Pending\n")
        return 1
    let result: i32 = future.__result

    # Expected: ((10 + 1) * 2) - 3 = (11 * 2) - 3 = 22 - 3 = 19
    if result != 19
        print("FAIL: expected 19, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 5: Await in non-async function (generates poll loop)
# ============================================================================

async fn async_multiply(x: i32) -> i32
    x * 7

fn test_await_in_sync() -> i32
    print("test_await_in_sync... ")

    # Using await outside async fn should create a poll loop
    let result: i32 = await async_multiply(6)

    # Expected: 6 * 7 = 42
    if result != 42
        print("FAIL: expected 42, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 6: Using block_on with Runtime (I/O-ready pattern)
# ============================================================================

async fn compute_with_executor(x: i32) -> i32
    x * 11

fn test_block_on() -> i32
    print("test_block_on... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        print("FAIL: executor init\n")
        return 1

    var future = compute_with_executor(4)
    # Drive the future through its header, then read the result (LARB R79)
    rt.block_on(@&future)
    let result: i32 = await future

    rt.destroy()

    # Expected: 4 * 11 = 44
    if result != 44
        print("FAIL: expected 44, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 7: Async I/O with runtime_poll_read pattern
# ============================================================================
#
# This demonstrates the IDIOMATIC pattern for async I/O in Ritz:
# 1. Create a state struct that holds runtime + I/O params
# 2. Create a poll function that uses the state
# 3. Wrap it in an async fn
# 4. Use await to suspend until I/O completes
#
# This pattern makes async I/O as clean as sync!

# State struct for async read
struct IoReadState
    rt: *Runtime
    fd: i32
    buf: *u8
    len: i32
    result: i32

# Poll function for async read - returns `Option<i32>`, None while Pending
# (AGAST #4558).  rt.poll_read submits the read and returns None; once
# block_on has seen the completion, the next call returns Some(result) (0 at
# EOF included).
fn poll_io_read(state: *IoReadState) -> Option<i32>
    let rt: *Runtime = state.rt
    let result: Option<i32> = rt.poll_read(state.fd, Span<u8> { ptr: (state.buf), len: (state.len) as i64 }, 0)
    if result.is_some()
        state.result = result.unwrap()
    return result

# Clean async read - wraps poll function in async
# This is the pattern we want Valet and other apps to use!
async fn do_async_read(state: *IoReadState) -> i32
    let result: i32 = await poll_io_read(state)
    result

fn test_async_io() -> i32
    print("test_async_io... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        print("FAIL: executor init\n")
        return 1

    # Create pipe for testing
    var fds: [2]i32
    let pipe_ret: i32 = sys_pipe(@fds[0])
    if pipe_ret < 0
        print("FAIL: pipe\n")
        rt.destroy()
        return 1

    let read_fd: i32 = fds[0]
    let write_fd: i32 = fds[1]

    # Write test data synchronously (non-blocking for pipe)
    var test_data: [8]u8
    test_data[0] = 72   # 'H'
    test_data[1] = 105  # 'i'
    test_data[2] = 33   # '!'
    let written: i64 = sys_write(write_fd, @test_data[0], 3)

    # Create buffer for read
    var buf: [64]u8
    for i in 0..64
        buf[i] = 0

    # Set up read state
    var state: IoReadState
    state.rt = @rt
    state.fd = read_fd
    state.buf = @buf[0]
    state.len = 64
    state.result = 0

    # Run async read - this demonstrates the clean pattern!
    var future = do_async_read(@state)
    # Drive the future through its header, then read the result (LARB R79)
    rt.block_on(@&future)
    let result: i32 = await future

    # Cleanup
    sys_close(read_fd)
    sys_close(write_fd)
    rt.destroy()

    # Verify result
    if result != 3
        print("FAIL: expected 3 bytes, got {result as i64}\n")
        return 1

    # Verify data was received correctly
    if buf[0] != 72
        print("FAIL: wrong data\n")
        return 1

    print("OK\n")
    return 0


# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    print("=== Async Reference Tests ===\n")
    print("Demonstrating idiomatic async Ritz patterns\n\n")

    var failures: i32 = 0

    failures += test_simple_async()
    failures += test_async_with_await()
    failures += test_async_chain()
    failures += test_sequential_awaits()
    failures += test_await_in_sync()
    failures += test_block_on()
    failures += test_async_io()

    print("\n")
    if failures > 0
        print("{failures as i64} test(s) FAILED\n")
        return 1

    print("All async reference tests PASSED!\n")
    print("\nThis is the GOLD STANDARD for async Ritz code.\n")
    print("Valet and other async apps should follow these patterns.\n")
    return 0
