# 54_async_fs: Async file I/O tests
#
# Tests async file operations using the async_fs module.
# Currently runs synchronously (MVP) but demonstrates the async API.

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.async.blocking_fs
import ritzlib.str
import ritzlib.strview
import ritzlib.os.env

# Build "$TMPDIR/<stem>_<pid>.txt" into buf (>= 512 bytes, so stem <= 64
# bytes) and return it NUL-terminated, the path sys_open3/sys_unlink take;
# TMPDIR unset, empty or overlong means /tmp.  Concurrent runs of this binary
# -- two gates on one host, or two stages of one gate -- must never share a
# file: with a fixed /tmp name one run's unlink landed between another's
# write and read, and regression Stage 1 flaked (AGAST #4207).
fn scratch_path(buf: *u8, stem: StrView) -> *u8
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    memcpy(buf, dir.ptr, dir.len)
    var n: i64 = dir.len
    *(buf + n) = 47  # '/'
    n += 1
    memcpy(buf + n, stem.ptr, stem.len)
    n += stem.len
    *(buf + n) = 95  # '_'
    n += 1
    *(buf + n) = 0
    itoa(sys_getpid() as i64, buf + n)
    strcat(buf, ".txt")
    buf

# Test 1: Async write and read back
fn test_async_write_read() -> bool
    print("test_async_write_read... ")

    var path_buf: [512]u8

    let path: *u8 = scratch_path(@path_buf[0], "ritz_async_test")

    # Write data
    var write_buf: [32]u8
    write_buf[0] = 72   # H
    write_buf[1] = 101  # e
    write_buf[2] = 108  # l
    write_buf[3] = 108  # l
    write_buf[4] = 111  # o
    write_buf[5] = 33   # !
    write_buf[6] = 10   # \n

    let written: i64 = match await async_write_file(strview_from_cstr(path), Span<u8> { ptr: (@write_buf[0]), len: (7) as i64 })
        Ok(n) => n
        Err(e) => -(e.code() as i64)
    if written != 7
        print("FAIL: write returned {written}\n")
        return false

    # Read it back
    var read_buf: [32]u8
    var i: i64 = 0
    while i < 32
        read_buf[i] = 0
        i += 1

    let read_count: i64 = match await async_read_file(strview_from_cstr(path), Span<u8> { ptr: (@read_buf[0]), len: (32) as i64 })
        Ok(n) => n
        Err(e) => -(e.code() as i64)
    if read_count != 7
        print("FAIL: read returned {read_count}\n")
        sys_unlink(path)
        return false

    # Verify content
    if read_buf[0] != 72 or read_buf[1] != 101 or read_buf[2] != 108
        print("FAIL: content mismatch\n")
        sys_unlink(path)
        return false

    # Cleanup
    sys_unlink(path)
    print("OK\n")
    return true

# Test 2: Async open/read/close
async fn read_small_file(path: *u8, buf: *u8) -> i64
    let fd: i32 = match await async_open(strview_from_cstr(path), O_RDONLY)
        Ok(f) => f
        Err(e) => return -(e.code() as i64)
    let n: i64 = await async_read(fd, Span<u8> { ptr: (buf), len: (100) as i64 })
    await async_close(fd)
    n

fn test_async_open_read_close() -> bool
    print("test_async_open_read_close... ")

    # First create a test file
    var path_buf: [512]u8
    let path: *u8 = scratch_path(@path_buf[0], "ritz_async_test2")
    let fd: i32 = sys_open3(path, O_CREAT | O_WRONLY | O_TRUNC, 420)
    if fd < 0
        print("FAIL: couldn't create test file\n")
        return false

    var data: [8]u8
    data[0] = 84   # T
    data[1] = 101  # e
    data[2] = 115  # s
    data[3] = 116  # t
    sys_write(fd, @data[0], 4)
    sys_close(fd)

    # Now read it with async functions
    var buf: [100]u8
    var i: i64 = 0
    while i < 100
        buf[i] = 0
        i += 1

    let n: i64 = await read_small_file(path, @buf[0])
    if n != 4
        print("FAIL: expected 4 bytes, got {n}\n")
        sys_unlink(path)
        return false

    if buf[0] != 84 or buf[1] != 101 or buf[2] != 115 or buf[3] != 116
        print("FAIL: content mismatch\n")
        sys_unlink(path)
        return false

    sys_unlink(path)
    print("OK\n")
    return true

# Test 3: Error handling - file not found
# The errno of a failed open, 0 if it opened.
async fn try_open_missing(path: *u8) -> i32
    match await async_open(strview_from_cstr(path), O_RDONLY)
        Ok(fd) =>
            await async_close(fd)
            0
        Err(e) => e.code()

fn test_async_error_handling() -> bool
    print("test_async_error_handling... ")

    # Never created: a per-run name, so no other run can make it exist.
    var path_buf: [512]u8
    let err: i32 = await try_open_missing(scratch_path(@path_buf[0], "ritz_async_missing"))
    if err == 0
        print("FAIL: expected an error, the open succeeded\n")
        return false

    # Err(NoEnt), errno 2
    if err != 2
        print("FAIL: expected ENOENT (2), got {err}\n")
        return false

    print("OK\n")
    return true

pub fn main() -> i32
    print("=== async file I/O tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_async_write_read()
        passed += 1
    else
        failed += 1

    if test_async_open_read_close()
        passed += 1
    else
        failed += 1

    if test_async_error_handling()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed} passed, {failed} failed\n")

    if failed > 0
        return 1
    return 0
