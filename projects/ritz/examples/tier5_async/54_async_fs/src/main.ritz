# 54_async_fs: Async file I/O tests
#
# Tests async file operations using the async_fs module.
# Currently runs synchronously (MVP) but demonstrates the async API.

import ritzlib.process { process_id }
import ritzlib.io
import ritzlib.fmt
import ritzlib.async.blocking_fs
import ritzlib.string
import ritzlib.strview
import ritzlib.os.env
import ritzlib.fd { Fd, fd_open, O_CREAT, O_WRONLY, O_TRUNC }
import ritzlib.fs { unlink }

# "$TMPDIR/<stem>_<pid>.txt"; TMPDIR unset, empty or overlong means /tmp.
# Concurrent runs of this binary -- two gates on one host, or two stages of
# one gate -- must never share a file: with a fixed /tmp name one run's
# unlink landed between another's write and read, and regression Stage 1
# flaked (AGAST #4207).  getpid stays raw: ritzlib has no wrapper for it.
fn scratch_path(stem: StrView) -> String
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    var path: String = String.from(dir)
    path.push(47)  # '/'
    path.push_str(stem)
    path.push(95)  # '_'
    path.push_i64(process_id() as i64)
    path.push_str(".txt")
    path

# Test 1: Async write and read back
fn test_async_write_read() -> bool
    print("test_async_write_read... ")

    let path_s: String = scratch_path("ritz_async_test")
    let path: StrView = path_s.as_view()

    # Write data
    var write_buf: [32]u8
    write_buf[0] = 72   # H
    write_buf[1] = 101  # e
    write_buf[2] = 108  # l
    write_buf[3] = 108  # l
    write_buf[4] = 111  # o
    write_buf[5] = 33   # !
    write_buf[6] = 10   # \n

    let written: i64 = match await async_write_file(path, Span<u8> { ptr: (@write_buf[0]), len: (7) as i64 })
        Ok(n) => n
        Err(e) => -(e.code() as i64)
    if written != 7
        print("FAIL: write returned {written}\n")
        return false

    # Read it back
    var read_buf: [32]u8
    var i: i64 = 0
    while i < 32
        read_buf[i] = 0
        i += 1

    let read_count: i64 = match await async_read_file(path, Span<u8> { ptr: (@read_buf[0]), len: (32) as i64 })
        Ok(n) => n
        Err(e) => -(e.code() as i64)
    if read_count != 7
        print("FAIL: read returned {read_count}\n")
        unlink(path)
        return false

    # Verify content
    if read_buf[0] != 72 or read_buf[1] != 101 or read_buf[2] != 108
        print("FAIL: content mismatch\n")
        unlink(path)
        return false

    # Cleanup
    unlink(path)
    print("OK\n")
    return true

# Test 2: Async open/read/close
async fn read_small_file(path: StrView, buf: *u8) -> i64
    let fd: i32 = match await async_open(path, O_RDONLY)
        Ok(f) => f
        Err(e) => return -(e.code() as i64)
    let n: i64 = await async_read(fd, Span<u8> { ptr: (buf), len: (100) as i64 })
    await async_close(fd)
    n

fn test_async_open_read_close() -> bool
    print("test_async_open_read_close... ")

    # First create a test file
    let path_s: String = scratch_path("ritz_async_test2")
    let path: StrView = path_s.as_view()
    var f: Fd = match fd_open(path, O_CREAT | O_WRONLY | O_TRUNC, 420)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: couldn't create test file\n")
            return false

    var data: [8]u8
    data[0] = 84   # T
    data[1] = 101  # e
    data[2] = 115  # s
    data[3] = 116  # t
    f.write(Span<u8> { ptr: @data[0], len: 4 })
    f.close()

    # Now read it with async functions
    var buf: [100]u8
    var i: i64 = 0
    while i < 100
        buf[i] = 0
        i += 1

    let n: i64 = await read_small_file(path, @buf[0])
    if n != 4
        print("FAIL: expected 4 bytes, got {n}\n")
        unlink(path)
        return false

    if buf[0] != 84 or buf[1] != 101 or buf[2] != 115 or buf[3] != 116
        print("FAIL: content mismatch\n")
        unlink(path)
        return false

    unlink(path)
    print("OK\n")
    return true

# Test 3: Error handling - file not found
# The errno of a failed open, 0 if it opened.
async fn try_open_missing(path: StrView) -> i32
    match await async_open(path, O_RDONLY)
        Ok(fd) =>
            await async_close(fd)
            0
        Err(e) => e.code()

fn test_async_error_handling() -> bool
    print("test_async_error_handling... ")

    # Never created: a per-run name, so no other run can make it exist.
    let path_s: String = scratch_path("ritz_async_missing")
    let err: i32 = await try_open_missing(path_s.as_view())
    if err == 0
        print("FAIL: expected an error, the open succeeded\n")
        return false

    # Err(NoEnt), errno 2
    if err != 2
        print("FAIL: expected ENOENT (2), got {err}\n")
        return false

    print("OK\n")
    return true

pub fn main() -> i32
    print("=== async file I/O tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_async_write_read()
        passed += 1
    else
        failed += 1

    if test_async_open_read_close()
        passed += 1
    else
        failed += 1

    if test_async_error_handling()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed} passed, {failed} failed\n")

    if failed > 0
        return 1
    return 0
