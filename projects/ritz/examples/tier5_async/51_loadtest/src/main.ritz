# 51_loadtest: HTTP load testing tool
#
# A simple but effective HTTP load tester similar to siege, ab, or k6.
# Designed to stress-test web servers and measure response times.
#
# Usage: loadtest [OPTIONS] URL
#
# Options:
#   -n NUM    Total number of requests (default: 100)
#   -c NUM    Concurrent connections (default: 10)
#
# Example:
#   ./loadtest -n 1000 -c 50 http://localhost:8080/
#
# Output:
#   - Requests per second (RPS)
#   - Average response time
#   - Min/Max response time
#   - Success/Error counts
#   - Transfer rate
#
# Architecture:
# - Sequential requests with timing
# - Simple blocking I/O per request
# - Measures connection, send, receive times

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.str
import ritzlib.string
import ritzlib.gvec
import ritzlib.span
import ritzlib.net

# ============================================================================
# Statistics
# ============================================================================

struct Stats
    total_requests: i64
    successful: i64
    failed: i64
    total_bytes: i64
    min_time: i64         # Minimum response time (ms)
    max_time: i64         # Maximum response time (ms)
    total_time: i64       # Sum of all response times
    start_time: i64       # Benchmark start time (ms)
    end_time: i64         # Benchmark end time (ms)

fn stats_new() -> Stats
    var s: Stats
    s.total_requests = 0
    s.successful = 0
    s.failed = 0
    s.total_bytes = 0
    s.min_time = 999999999
    s.max_time = 0
    s.total_time = 0
    s.start_time = 0
    s.end_time = 0
    return s

fn stats_record_success(s: *Stats, response_time: i64, bytes: i64)
    s.total_requests = s.total_requests + 1
    s.successful = s.successful + 1
    s.total_bytes = s.total_bytes + bytes
    s.total_time = s.total_time + response_time
    if response_time < s.min_time
        s.min_time = response_time
    if response_time > s.max_time
        s.max_time = response_time

fn stats_record_failure(s: *Stats)
    s.total_requests = s.total_requests + 1
    s.failed = s.failed + 1

fn stats_print(s: *Stats)
    var elapsed: i64 = s.end_time - s.start_time
    if elapsed == 0
        elapsed = 1

    print("\n========== Load Test Results ==========\n")

    print("Total requests:     {s.total_requests}\n")

    print("Successful:         {s.successful}\n")

    print("Failed:             {s.failed}\n")

    print("Total time:         {elapsed} ms\n")

    if s.successful > 0
        var avg_time: i64 = s.total_time / s.successful
        print("Average response:   {avg_time} ms\n")

        print("Min response:       {s.min_time} ms\n")

        print("Max response:       {s.max_time} ms\n")

    # Requests per second
    var rps: i64 = (s.successful * 1000) / elapsed
    print("Requests/sec:       {rps}\n")

    # Transfer rate (KB/s)
    var kbps: i64 = (s.total_bytes * 1000) / elapsed / 1024
    print("Transfer rate:      {kbps} KB/s\n")

    let total_kb: i64 = s.total_bytes / 1024
    print("Total transferred:  {total_kb} KB\n")

    print("========================================\n")

# ============================================================================
# URL parsing
# ============================================================================

struct Url
    host: String
    port: i32
    path: String

fn parse_url(url_str: StrView) -> Url
    # Url holds Strings, which have Drop (AGAST #2159), so it starts whole.
    var url: Url = Url { host: string_new(), port: 80, path: string_from("/") }

    # Skip http://
    var pos: i64 = 0
    var len: i64 = url_str.len

    if len >= 7
        # Check for http://
        if url_str.get(0) == 104 and url_str.get(4) == ':'  # 'h' and ':'
            pos = 7

    # Extract host (until : or / or end)
    while pos < len
        var c: u8 = url_str.get(pos)
        if c == ':'  # ':'
            pos += 1
            # Parse port
            var port_val: i32 = 0
            while pos < len
                var d: u8 = url_str.get(pos)
                if d >= '0' and d <= '9'
                    port_val = port_val * 10 + (d - '0') as i32
                    pos += 1
                else
                    break
            url.port = port_val
            break
        if c == '/'  # '/'
            break
        (url.host).push(c)
        pos += 1

    # Extract path (rest of string starting with /)
    if pos < len and url_str.get(pos) == '/'
        (url.path).clear()
        while pos < len
            (url.path).push(url_str.get(pos))
            pos += 1

    return url

# ============================================================================
# Time utilities
# ============================================================================

fn get_time_ms() -> i64
    # Get current time in milliseconds
    var tv: [2]i64  # tv_sec, tv_usec
    syscall2(SYS_GETTIMEOFDAY, @tv[0] as i64, 0)
    return tv[0] * 1000 + tv[1] / 1000

# ============================================================================
# Single request execution
# ============================================================================

fn do_request(url: *Url) -> i64
    # Returns bytes received on success, -1 on failure
    var sock: Socket
    match socket_tcp()
        Ok(s) => sock = s
        Err(_) => return -1

    # Connect
    match sock.connect((url.host).as_view(), url.port)
        Ok(_) => pass
        Err(_) =>
            sock.close()
            return -1

    # Build request
    var request: String = string_new()
    request.push_str("GET ")
    request.push_string(@url.path)
    request.push_str(" HTTP/1.0\r\nHost: ")
    request.push_string(@url.host)
    request.push_str("\r\nConnection: close\r\n\r\n")

    # Send request
    match sock.send_str(request.as_view())
        Ok(_) => pass
        Err(_) =>
            sock.close()
            return -1

    # Receive response, reusing one 4 KiB buffer: only the count matters
    var total_bytes: i64 = 0
    var buf: Vec<u8> = vec_with_cap<u8>(4096)
    var done: i32 = 0
    while done == 0
        buf.len = 0
        var n: i64 = 0
        match sock.recv_into(@&buf, 4096)
            Ok(k) => n = k
            Err(_) => n = 0
        if n == 0
            done = 1
        else
            total_bytes += n

    sock.close()
    return total_bytes

# ============================================================================
# Main benchmark loop
# ============================================================================

fn run_benchmark(url: *Url, num_requests: i64, concurrency: i64) -> Stats
    var stats: Stats = stats_new()
    stats.start_time = get_time_ms()

    print("Running benchmark: {num_requests} requests\n")
    print("Target: ")
    var i: i64 = 0
    while i < (url.host).len()
        print_char((url.host).get(i))
        i += 1
    print(":{url.port}")
    i = 0
    while i < (url.path).len()
        print_char((url.path).get(i))
        i += 1
    print("\n\n")

    # Run requests sequentially
    var completed: i64 = 0
    while completed < num_requests
        var request_start: i64 = get_time_ms()
        var bytes: i64 = do_request(url)
        var request_time: i64 = get_time_ms() - request_start

        if bytes >= 0
            stats_record_success(@stats, request_time, bytes)
        else
            stats_record_failure(@stats)

        completed += 1

        # Progress indicator every 100 requests
        if completed % 100 == 0
            print(".")

    print("\n")
    stats.end_time = get_time_ms()
    return stats

# ============================================================================
# Argument parsing
# ============================================================================

fn print_usage()
    print("Usage: loadtest [OPTIONS] URL\n")
    print("\n")
    print("Options:\n")
    print("  -n NUM    Total number of requests (default: 100)\n")
    print("\n")
    print("Example:\n")
    print("  loadtest -n 1000 http://localhost:8080/\n")

pub fn main(args: Span<StrView>) -> i32
    var num_requests: i64 = 100
    var concurrency: i64 = 10
    var url_str: StrView = ""
    var have_url: bool = false

    # Parse arguments
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]
        if arg.starts_with("-")
            if arg.starts_with("-n")
                i += 1
                if i < args.len
                    num_requests = match args[i].parse_i64()
                        Some(n) => n
                        None => 0
            else if arg.starts_with("-h")
                print_usage()
                return 0
        else
            url_str = arg
            have_url = true
        i += 1

    if not have_url
        print_usage()
        return 1

    print("Ritz Load Tester v0.1\n")

    # Parse URL
    var url: Url = parse_url(url_str)

    if (url.host).len() == 0
        print("Error: Invalid URL\n")
        return 1

    # Run benchmark
    var stats: Stats = run_benchmark(@url, num_requests, concurrency)

    # Print results
    stats_print(@stats)

    return 0
