# Example 79: ritzlib_json — parse, walk, re-emit and reject JSON with ritzlib.json
#
# ritz1 links ritzlib_json.o, yet no example imported ritzlib.json, so no
# differential ritz0-vs-ritz1 stage ever ran it (AGAST #1459; 42_json carries
# a private parser).  This one uses only the library's public API, in the
# Option/Result shape of AGAST #1482.
#
# Three sections:
#
# 1. `== doc ==` — stdin (read with io's vec_read_all_fd) parsed with
#    json_parse(StrView), matched on its Result<*JsonValue, JsonError>.  Empty
#    stdin (the regression suite runs every example with </dev/null) parses a
#    built-in document instead.  The tree is walked depth-first with the
#    accessor API only: objects via json_object_len + their keys +
#    json_get_field, arrays via json_array_len + json_get_index, scalars via
#    json_get_string / json_get_number / json_get_bool (each an Option) and
#    json_is_null.  Each node prints as `<path> <kind> <value>`, then a
#    per-kind tally, then the document re-emitted with json_to_string (a
#    String), which is re-parsed with json_parse and re-emitted to show the
#    round trip is a fixed point.
# 2. `== lookup ==` — typed lookups on the built-in document's keys, plus a
#    missing field, an out-of-range index and a wrong-kind value, each of
#    which is None (the same lines run whatever stdin held).  None prints as
#    the sentinel the pre-#1482 accessors returned — 0, `(null)`, is_null=1 —
#    so the golden output did not move.
# 3. `== errors ==` — fixed malformed inputs through json_parse and the
#    deprecated json_parse2(ptr, len) wrapper (the `legacy:` line), and the
#    json_error_message table.
#
# Behaviour pinned as it is today, quirks included (test.sh says the same):
#   - json_parse reports every failure as JSON_ERR_UNEXPECTED_CHAR, except a
#     invalid escape (one RFC 8259 lacks, like \q; bad \uXXXX hex; unpaired
#     surrogate), which is JSON_ERR_INVALID_ESCAPE at the backslash (AGAST
#     #3914, #3918), and a raw control character (U+0000-U+001F) inside a
#     string, which is JSON_ERR_CONTROL_CHAR at that byte (#3941).  The other
#     codes
#     exist only in json_error_message.
#   - numbers are integers: "-1.25" parses as -1 (fraction truncated, #4571);
#   - trailing input after the first value is ignored: "[1] x" parses as [1].
#
# `match` arms are single expressions, so each arm that does work is a helper
# returning i32 (see 77_args).
#
# Invalid stdin prints the error line and exits 1.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.string
import ritzlib.json
import ritzlib.fmt

# Write one raw byte to stdout (the fd writer is unbuffered, so it stays
# ordered with print).
fn put_byte(c: u8)
    var w = stdout_writer()
    w.write_byte(c)

const PATH_MAX: i64 = 480

# Per-kind tally, indexed by JSON_* kind (0..5).
var g_tally: [6]i64

# ============================================================================
# Output helpers
# ============================================================================

fn show(label: StrView, v: i64) -> i32
    print("{label}{v}\n")
    0

fn kind_name(kind: i32) -> StrView
    if kind == JSON_NULL
        return "null"
    if kind == JSON_BOOL
        return "bool"
    if kind == JSON_NUMBER
        return "number"
    if kind == JSON_STRING
        return "string"
    if kind == JSON_ARRAY
        return "array"
    if kind == JSON_OBJECT
        return "object"
    return "?"

# Print `s` with control bytes as `<decimal>` (so the golden output stays
# free of raw tabs).
fn show_raw(s: StrView) -> i32
    for i in 0..s.len
        let c: u8 = *(s.ptr + i)
        if c < 32
            print("<{c as i64}>")
        else
            put_byte(c)
    0

fn show_view(label: StrView, s: StrView) -> i32
    print("{label}")
    show_raw(s)
    print("\n")
    0

# --- Printers for the accessors' Options.  None prints what the pre-#1482
# --- accessor returned in its place: 0 for numbers and bools, `(null)` for
# --- strings.

fn bool_i64(b: bool) -> i64
    if b
        return 1
    0

fn show_num(label: StrView, o: Option<i64>) -> i32
    match o
        Some(n) => show(label, n)
        None => show(label, 0)

fn show_bool(label: StrView, o: Option<bool>) -> i32
    match o
        Some(b) => show(label, bool_i64(b))
        None => show(label, 0)

fn show_str(label: StrView, o: Option<StrView>) -> i32
    match o
        Some(s) => show_view(label, s)
        None => show_view(label, "(null)")

# --- Option<*JsonValue> combinators, so a lookup chain stays one expression.

fn field_of(o: Option<*JsonValue>, key: StrView) -> Option<*JsonValue>
    match o
        Some(v) => v.get_field(key)
        None => None

fn index_of(o: Option<*JsonValue>, i: i64) -> Option<*JsonValue>
    match o
        Some(v) => v.get_index(i)
        None => None

fn number_of(o: Option<*JsonValue>) -> Option<i64>
    match o
        Some(v) => v.get_number()
        None => None

fn bool_of(o: Option<*JsonValue>) -> Option<bool>
    match o
        Some(v) => v.get_bool()
        None => None

fn string_of(o: Option<*JsonValue>) -> Option<StrView>
    match o
        Some(v) => v.get_string()
        None => None

# A missing value counts as null, as json_is_null(null) does.
fn is_null_of(o: Option<*JsonValue>) -> i64
    match o
        Some(v) => v.is_null() as i64
        None => 1

fn is_none(o: Option<*JsonValue>) -> i64
    match o
        Some(_) => 0
        None => 1

fn array_len_of(o: Option<*JsonValue>) -> i64
    match o
        Some(v) => v.array_len()
        None => 0

fn object_len_of(o: Option<*JsonValue>) -> i64
    match o
        Some(v) => v.object_len()
        None => 0

# Print `v` as JSON (json_to_string), dropping the String.
fn print_json(v: *JsonValue) -> i32
    var s: String = v.to_string()
    print("{s.as_view()}")
    0

# Append `s` to the path buffer at `len`, clamped to PATH_MAX; returns new len.
fn path_push(path: *u8, len: i64, s: *u8) -> i64
    var n: i64 = len
    var i: i64 = 0
    while *(s + i) != 0 and n < PATH_MAX
        *(path + n) = *(s + i)
        n += 1
        i += 1
    *(path + n) = 0
    return n

# ============================================================================
# 1. Walk
# ============================================================================

# Raw value between bars, then its JSON-escaped form.
fn walk_string(v: *JsonValue, s: StrView) -> i32
    print("|")
    show_raw(s)
    print("| ")
    print_json(v)
    print("\n")
    0

# Print one node and recurse.  Uses only the public accessors to read values;
# `kind` is the only struct field touched, to choose which accessor applies
# (and `keys`, which has no accessor, to enumerate an object).  The None arms
# below cannot fire for a node of the matching kind.
fn walk(v: *JsonValue, path: *u8, plen: i64) -> i32
    let kind: i32 = v.kind
    g_tally[kind as i64] = g_tally[kind as i64] + 1

    if plen == 0
        print("$")
    else
        print("{path}")
    print(" {kind_name(kind)} ")

    if kind == JSON_OBJECT
        let n: i64 = v.object_len()
        print("\{{n}\}\n")
        for i in 0..n
            let key: *u8 = *(v.keys + i)
            var nlen: i64 = path_push(path, plen, ".")
            nlen = path_push(path, nlen, key)
            match v.get_field(strview_from_cstr(key))
                Some(child) => walk(child, path, nlen)
                None => pass
            *(path + plen) = 0
    else if kind == JSON_ARRAY
        let n: i64 = v.array_len()
        print("[{n}]\n")
        for i in 0..n
            var num: [24]u8
            itoa(i, @num[0])
            var nlen: i64 = path_push(path, plen, "[")
            nlen = path_push(path, nlen, @num[0])
            nlen = path_push(path, nlen, "]")
            match v.get_index(i)
                Some(child) => walk(child, path, nlen)
                None => pass
            *(path + plen) = 0
    else if kind == JSON_STRING
        match v.get_string()
            Some(s) => walk_string(v, s)
            None => pass
    else if kind == JSON_NUMBER
        show_num("", v.get_number())
    else if kind == JSON_BOOL
        show_bool("", v.get_bool())
    else
        show("is_null=", v.is_null() as i64)
    0

fn builtin_doc() -> StrView
    return "{\"name\": \"ritz\", \"version\": 3, \"stable\": false, \"tags\": [\"compiler\", \"self-hosted\"], \"owner\": null, \"meta\": {\"tier\": 5, \"ratio\": -1.25, \"quote\": \"say \\\"hi\\\"\\tnow\", \"empty\": [], \"none\": {}}}"

# Compare the second emission with the first; frees the re-parsed tree.
fn roundtrip_check(out: @String, again: *JsonValue) -> i32
    var out2: String = again.to_string()
    if out.eq_string(@out2)
        println("roundtrip: identical")
    else
        show_view("roundtrip: DIFFERS: ", out2.as_view())
    again.free()
    0

fn reparse_failed(err: JsonError) -> i32
    show("roundtrip: reparse failed at ", err.pos)
    1

# Walk, tally and re-emit `root`; check the emitted text round-trips.
fn report(root: *JsonValue) -> i32
    for k in 0..6
        g_tally[k] = 0
    var path: [512]u8
    path[0] = 0
    walk(root, @path[0], 0)

    for k in 0..6
        if g_tally[k] != 0
            print("count {kind_name(k as i32)}: {g_tally[k]}\n")

    # Bounds: index len must be None, not read one slot past the end.
    if root.kind == JSON_ARRAY
        let n: i64 = root.array_len()
        show("index len == null: ", is_none(root.get_index(n)))
        show("index len+100 == null: ", is_none(root.get_index(n + 100)))

    var out: String = root.to_string()
    print("emit: {out.as_view()}\n")

    # Re-parse the emitted text and emit it again.
    let rc: i32 = match json_parse(out.as_view())
        Ok(again) => roundtrip_check(@out, again)
        Err(err) => reparse_failed(err)
    return rc

fn print_parse_error(err: JsonError) -> i32
    print("error: code={err.code as i64} pos={err.pos} msg={json_error_message(err.code)}\n")
    return 1

# ============================================================================
# 2. Lookups
# ============================================================================

fn lookups_in(root: *JsonValue) -> i32
    let doc: Option<*JsonValue> = Some(root)
    let name: Option<*JsonValue> = root.get_field("name")
    let version: Option<*JsonValue> = root.get_field("version")
    let tags: Option<*JsonValue> = root.get_field("tags")
    let meta: Option<*JsonValue> = root.get_field("meta")

    show_str("name: ", string_of(name))
    show_num("version: ", number_of(version))
    show_bool("stable: ", bool_of(field_of(doc, "stable")))
    show("tags len: ", array_len_of(tags))
    show_str("tags[1]: ", string_of(index_of(tags, 1)))
    show_str("tags[2] (out of range): ", string_of(index_of(tags, 2)))
    show("tags[2] is_null: ", is_null_of(index_of(tags, 2)))
    # The Option itself, not just what the printers make of it: reading one
    # slot past the end could still yield a plausible value from zeroed heap.
    show("tags[2] == null: ", is_none(index_of(tags, 2)))
    show_str("tags[-1]: ", string_of(index_of(tags, 0 - 1)))
    show("owner is_null: ", is_null_of(field_of(doc, "owner")))
    show("name is_null: ", is_null_of(name))
    show("meta object_len: ", object_len_of(meta))
    show_num("meta.tier: ", number_of(field_of(meta, "tier")))
    show_num("meta.ratio (-1.25): ", number_of(field_of(meta, "ratio")))
    show_str("meta.quote: ", string_of(field_of(meta, "quote")))
    show("meta.empty array_len: ", array_len_of(field_of(meta, "empty")))
    show("meta.none object_len: ", object_len_of(field_of(meta, "none")))

    # None: missing keys and wrong kinds never crash.
    let missing: Option<*JsonValue> = root.get_field("missing")
    show("missing == null: ", is_none(missing))
    show("missing is_null: ", is_null_of(missing))
    show_num("missing number: ", number_of(missing))
    show_bool("missing bool: ", bool_of(missing))
    show_str("missing string: ", string_of(missing))
    show_str("name.x (field of string): ", string_of(field_of(name, "x")))
    show_num("name as number: ", number_of(name))
    show_str("version as string: ", string_of(version))
    show_bool("version as bool: ", bool_of(version))
    show("meta array_len: ", array_len_of(meta))
    show("tags object_len: ", object_len_of(tags))
    show("root[0]: ", is_null_of(root.get_index(0)))

    root.free()
    0

fn builtin_failed(err: JsonError) -> i32
    println("builtin doc failed to parse")
    1

fn lookups()
    match json_parse(builtin_doc())
        Ok(root) => lookups_in(root)
        Err(err) => builtin_failed(err)

# ============================================================================
# 3. Errors
# ============================================================================

fn ok_case(v: *JsonValue) -> i32
    print("ok ")
    print_json(v)
    print("\n")
    v.free()
    return 0

# The `legacy:` line, from the deprecated json_parse2(ptr, len) wrapper.  It
# keeps the wording of the JsonResult struct it replaced (ok / pos / error).
fn legacy_ok(v: *JsonValue) -> i32
    println("  legacy: ok=1")
    v.free()
    0

fn legacy_err(err: JsonError) -> i32
    print("  legacy: ok=0 pos={err.pos}")
    println(" error=JSON parse error")
    1

# Parse `src` with json_parse and with json_parse2; print the Result's error
# or the emitted value.
fn try_parse(label: StrView, src: StrView)
    print("{label}: ")
    let failed: i32 = match json_parse(src)
        Ok(v) => ok_case(v)
        Err(err) => print_parse_error(err)

    match json_parse2(Span<u8> { ptr: (src.ptr), len: (src.len) as i64 })
        Ok(v) => legacy_ok(v)
        Err(err) => legacy_err(err)
    show("  failed: ", failed as i64)

fn errors()
    try_parse("missing colon", "{\"a\" 1}")
    try_parse("unclosed array", "[1, 2")
    try_parse("unterminated string", "\"open")
    try_parse("bad literal", "{\"a\": tru}")
    try_parse("empty input", "")
    try_parse("trailing input (accepted)", "[1] x")
    try_parse("bad \\u escape", "[\"\\u00g9\"]")
    try_parse("raw tab in string", "[\"a\tb\"]")
    # Codes 0-9: every code, then the first past the last (JSON_ERR_CONTROL_CHAR).
    for code in 0..10
        print("message {code as i64}: {json_error_message(code as i32)}\n")

# ============================================================================
# main
# ============================================================================

fn report_and_free(root: *JsonValue) -> i32
    let rc: i32 = report(root)
    root.free()
    return rc

pub fn main() -> i32
    println("== doc ==")
    var input: Vec<u8> = vec_new<u8>()
    match vec_read_all_fd(0, @&input)
        Ok(_) => pass
        Err(_) =>
            println("vec_read_all_fd failed")
            return 1

    var src: StrView = builtin_doc()
    if input.len == 0
        println("source: builtin")
    else
        println("source: stdin")
        src = strview_from_ptr(input.data, input.len)
    show("bytes: ", src.len)

    let rc: i32 = match json_parse(src)
        Ok(root) => report_and_free(root)
        Err(err) => print_parse_error(err)
    if rc != 0
        return rc

    println("== lookup ==")
    lookups()
    println("== errors ==")
    errors()
    return 0
