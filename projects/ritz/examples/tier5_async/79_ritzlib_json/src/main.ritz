# Example 79: ritzlib_json — parse, walk, re-emit and reject JSON with ritzlib.json
#
# ritz1 links ritzlib_json.o, yet no example imported ritzlib.json, so no
# differential ritz0-vs-ritz1 stage ever ran it (AGAST #1459; 42_json carries
# a private parser).  This one uses only the library's public API, in the
# Option/Result shape of AGAST #1482.
#
# Three sections:
#
# 1. `== doc ==` -- stdin (read with fd_stdin().read_to_end) parsed with
#    json_parse(StrView), matched on its Result<Json, JsonError>.  Empty
#    stdin (the regression suite runs every example with </dev/null) parses a
#    built-in document instead.  The tree is walked depth-first by matching on
#    the Json enum: `match *v` on Object(_) / Array(_) / Str(_) / Number(_) /
#    Bool(_) / Null, with v.members() and v.items() for the children.  Each
#    node prints as `<path> <kind> <value>`, then a per-kind tally, then the
#    document re-emitted with to_string (a String), which is re-parsed with
#    json_parse and re-emitted to show the round trip is a fixed point.
# 2. `== lookup ==` -- typed lookups on the built-in document's keys, plus a
#    missing field, an out-of-range index and a wrong-kind value, each of
#    which is None (the same lines run whatever stdin held).  None prints as
#    0, `(null)`, or is_null=1, as the first Option-returning accessors did.
# 3. `== errors ==` -- fixed malformed inputs through json_parse, each printing
#    the JsonErrorKind's name, the byte offset and err.message().
#
# Behaviour pinned as it is today, quirks included (test.sh says the same):
#   - the error kinds are precise: UnterminatedString (the input ends inside a
#     string), ExpectedColon, ExpectedBracket (an array without its `]`),
#     ExpectedBrace, InvalidEscape (one RFC 8259 lacks, like \q; bad \uXXXX
#     hex; unpaired surrogate; at the backslash), ControlChar (a raw U+0000-
#     U+001F byte inside a string, at that byte), and UnexpectedChar for a
#     value that does not start with one;
#   - numbers are integers: "-1.25" parses as -1 (fraction truncated, #4571);
#   - trailing input after the first value is ignored: "[1] x" parses as [1].
#
# `match` arms are single expressions, so each arm that does work is a helper
# returning i32 (see 77_args).
#
# Invalid stdin prints the error line and exits 1.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.string
import ritzlib.json
import ritzlib.fmt
import ritzlib.fd { fd_stdin }

# Write one raw byte to stdout (the fd writer is unbuffered, so it stays
# ordered with print).
fn put_byte(c: u8)
    var w = stdout_writer()
    w.write_byte(c)

const PATH_MAX: i64 = 480

# Per-kind tally, indexed by kind_of (0..5).
var g_tally: [6]i64

# ============================================================================
# Output helpers
# ============================================================================

fn show(label: StrView, v: i64) -> i32
    print("{label}{v}\n")
    0

# The tally slot of a value: 0 null, 1 bool, 2 number, 3 string, 4 array,
# 5 object.
fn kind_of(v: @Json) -> i64
    match *v
        Null => 0
        Bool(_) => 1
        Number(_) => 2
        Str(_) => 3
        Array(_) => 4
        Object(_) => 5

fn kind_name(kind: i64) -> StrView
    if kind == 0
        return "null"
    if kind == 1
        return "bool"
    if kind == 2
        return "number"
    if kind == 3
        return "string"
    if kind == 4
        return "array"
    if kind == 5
        return "object"
    return "?"

fn error_kind_name(kind: JsonErrorKind) -> StrView
    match kind
        UnexpectedChar => "UnexpectedChar"
        UnterminatedString => "UnterminatedString"
        ExpectedColon => "ExpectedColon"
        ExpectedBracket => "ExpectedBracket"
        ExpectedBrace => "ExpectedBrace"
        OutOfMemory => "OutOfMemory"
        InvalidEscape => "InvalidEscape"
        ControlChar => "ControlChar"

# Print `s` with control bytes as `<decimal>` (so the golden output stays
# free of raw tabs).
fn show_raw(s: StrView) -> i32
    for i in 0..s.len
        let c: u8 = *(s.ptr + i)
        if c < 32
            print("<{c as i64}>")
        else
            put_byte(c)
    0

fn show_view(label: StrView, s: StrView) -> i32
    print("{label}")
    show_raw(s)
    print("\n")
    0

# --- Printers for the accessors' Options.  None prints what the pre-#1482
# --- accessor returned in its place: 0 for numbers and bools, `(null)` for
# --- strings.

fn bool_i64(b: bool) -> i64
    if b
        return 1
    0

fn show_num(label: StrView, o: Option<i64>) -> i32
    match o
        Some(n) => show(label, n)
        None => show(label, 0)

fn show_bool(label: StrView, o: Option<bool>) -> i32
    match o
        Some(b) => show(label, bool_i64(b))
        None => show(label, 0)

fn show_str(label: StrView, o: Option<StrView>) -> i32
    match o
        Some(s) => show_view(label, s)
        None => show_view(label, "(null)")

# --- Option<@Json> combinators, so a lookup chain stays one expression.

fn field_of(o: Option<@Json>, key: StrView) -> Option<@Json>
    match o
        Some(v) =>
            let j: @Json = v
            j.get_field(key)
        None => None

fn index_of(o: Option<@Json>, i: i64) -> Option<@Json>
    match o
        Some(v) =>
            let j: @Json = v
            j.get_index(i)
        None => None

fn number_of(o: Option<@Json>) -> Option<i64>
    match o
        Some(v) =>
            let j: @Json = v
            j.get_number()
        None => None

fn bool_of(o: Option<@Json>) -> Option<bool>
    match o
        Some(v) =>
            let j: @Json = v
            j.get_bool()
        None => None

fn string_of(o: Option<@Json>) -> Option<StrView>
    match o
        Some(v) =>
            let j: @Json = v
            j.get_string()
        None => None

# A missing value counts as null.
fn is_null_of(o: Option<@Json>) -> i64
    match o
        Some(v) =>
            let j: @Json = v
            j.is_null() as i64
        None => 1

fn is_none(o: Option<@Json>) -> i64
    match o
        Some(_) => 0
        None => 1

fn array_len_of(o: Option<@Json>) -> i64
    match o
        Some(v) =>
            let j: @Json = v
            j.array_len()
        None => 0

fn object_len_of(o: Option<@Json>) -> i64
    match o
        Some(v) =>
            let j: @Json = v
            j.object_len()
        None => 0

# Print `v` as JSON (to_string), dropping the String.
fn print_json(v: @Json) -> i32
    var s: String = v.to_string()
    print("{s.as_view()}")
    0

# Append `s` to the path, clamped to PATH_MAX bytes.
fn path_push(path: @&String, s: StrView)
    var i: i64 = 0
    while i < s.len and path.len() < PATH_MAX
        path.push(s.get(i))
        i += 1

# Cut the path back to its first `len` bytes.
fn path_truncate(path: @&String, len: i64)
    while path.len() > len
        path.pop()

# ============================================================================
# 1. Walk
# ============================================================================

# Raw value between bars, then its JSON-escaped form.
fn walk_string(v: @Json, s: StrView) -> i32
    print("|")
    show_raw(s)
    print("| ")
    print_json(v)
    print("\n")
    0

fn walk_object(v: @Json, path: @&String) -> i32
    let plen: i64 = path.len()
    let ms: Span<JsonMember> = v.members()
    print("\{{ms.len}\}\n")
    for i in 0..ms.len
        let m: *JsonMember = ms.get_ptr(i)
        path_push(path, ".")
        path_push(path, m.key.as_view())
        walk(@m.value, path)
        path_truncate(path, plen)
    0

fn walk_array(v: @Json, path: @&String) -> i32
    let plen: i64 = path.len()
    let xs: Span<Json> = v.items()
    print("[{xs.len}]\n")
    for i in 0..xs.len
        var num: String = string_from_i64(i)
        path_push(path, "[")
        path_push(path, num.as_view())
        path_push(path, "]")
        walk(@*xs.get_ptr(i), path)
        path_truncate(path, plen)
    0

# Print one node and recurse, matching on the enum.
fn walk(v: @Json, path: @&String) -> i32
    let kind: i64 = kind_of(v)
    g_tally[kind] = g_tally[kind] + 1

    if path.len() == 0
        print("$")
    else
        print("{path.as_view()}")
    print(" {kind_name(kind)} ")

    match *v
        Object(_) =>
            walk_object(v, path)
        Array(_) =>
            walk_array(v, path)
        Str(s) =>
            walk_string(v, s.as_view())
        Number(n) =>
            show("", n)
        Bool(b) =>
            show("", bool_i64(b))
        Null =>
            show("is_null=", v.is_null() as i64)
    0

fn builtin_doc() -> StrView
    return "{\"name\": \"ritz\", \"version\": 3, \"stable\": false, \"tags\": [\"compiler\", \"self-hosted\"], \"owner\": null, \"meta\": {\"tier\": 5, \"ratio\": -1.25, \"quote\": \"say \\\"hi\\\"\\tnow\", \"empty\": [], \"none\": {}}}"

# Compare the second emission with the first; frees the re-parsed tree.
fn roundtrip_check(out: @String, again: @Json) -> i32
    var out2: String = again.to_string()
    if out.eq_string(@out2)
        println("roundtrip: identical")
    else
        show_view("roundtrip: DIFFERS: ", out2.as_view())
    0

fn reparse_failed(err: JsonError) -> i32
    show("roundtrip: reparse failed at ", err.pos)
    1

# Walk, tally and re-emit `root`; check the emitted text round-trips.
fn report(root: @Json) -> i32
    for k in 0..6
        g_tally[k] = 0
    var path: String = string_new()
    walk(root, @&path)

    for k in 0..6
        if g_tally[k] != 0
            print("count {kind_name(k)}: {g_tally[k]}\n")

    # Bounds: index len must be None, not read one slot past the end.
    if kind_of(root) == 4
        let n: i64 = root.array_len()
        show("index len == null: ", is_none(root.get_index(n)))
        show("index len+100 == null: ", is_none(root.get_index(n + 100)))

    var out: String = root.to_string()
    print("emit: {out.as_view()}\n")

    # Re-parse the emitted text and emit it again.
    let rc: i32 = match json_parse(out.as_view())
        Ok(again) => roundtrip_check(@out, @again)
        Err(err) => reparse_failed(err)
    return rc

fn print_parse_error(err: JsonError) -> i32
    print("error: kind={error_kind_name(err.kind)} pos={err.pos} msg={err}\n")
    return 1

# ============================================================================
# 2. Lookups
# ============================================================================

fn lookups_in(root: @Json) -> i32
    let doc: Option<@Json> = Some(root)
    let name: Option<@Json> = root.get_field("name")
    let version: Option<@Json> = root.get_field("version")
    let tags: Option<@Json> = root.get_field("tags")
    let meta: Option<@Json> = root.get_field("meta")

    show_str("name: ", string_of(name))
    show_num("version: ", number_of(version))
    show_bool("stable: ", bool_of(field_of(doc, "stable")))
    show("tags len: ", array_len_of(tags))
    show_str("tags[1]: ", string_of(index_of(tags, 1)))
    show_str("tags[2] (out of range): ", string_of(index_of(tags, 2)))
    show("tags[2] is_null: ", is_null_of(index_of(tags, 2)))
    # The Option itself, not just what the printers make of it: reading one
    # slot past the end could still yield a plausible value from zeroed heap.
    show("tags[2] == null: ", is_none(index_of(tags, 2)))
    show_str("tags[-1]: ", string_of(index_of(tags, 0 - 1)))
    show("owner is_null: ", is_null_of(field_of(doc, "owner")))
    show("name is_null: ", is_null_of(name))
    show("meta object_len: ", object_len_of(meta))
    show_num("meta.tier: ", number_of(field_of(meta, "tier")))
    show_num("meta.ratio (-1.25): ", number_of(field_of(meta, "ratio")))
    show_str("meta.quote: ", string_of(field_of(meta, "quote")))
    show("meta.empty array_len: ", array_len_of(field_of(meta, "empty")))
    show("meta.none object_len: ", object_len_of(field_of(meta, "none")))

    # None: missing keys and wrong kinds never crash.
    let missing: Option<@Json> = root.get_field("missing")
    show("missing == null: ", is_none(missing))
    show("missing is_null: ", is_null_of(missing))
    show_num("missing number: ", number_of(missing))
    show_bool("missing bool: ", bool_of(missing))
    show_str("missing string: ", string_of(missing))
    show_str("name.x (field of string): ", string_of(field_of(name, "x")))
    show_num("name as number: ", number_of(name))
    show_str("version as string: ", string_of(version))
    show_bool("version as bool: ", bool_of(version))
    show("meta array_len: ", array_len_of(meta))
    show("tags object_len: ", object_len_of(tags))
    show("root[0]: ", is_null_of(root.get_index(0)))

    0

fn builtin_failed(err: JsonError) -> i32
    println("builtin doc failed to parse")
    1

fn lookups()
    match json_parse(builtin_doc())
        Ok(root) => lookups_in(@root)
        Err(err) => builtin_failed(err)

# ============================================================================
# 3. Errors
# ============================================================================

fn ok_case(v: @Json) -> i32
    print("ok ")
    print_json(v)
    print("\n")
    return 0

# Parse `src` with json_parse; print the Result's error or the emitted value.
fn try_parse(label: StrView, src: StrView)
    print("{label}: ")
    let failed: i32 = match json_parse(src)
        Ok(v) => ok_case(@v)
        Err(err) => print_parse_error(err)
    show("  failed: ", failed as i64)

fn errors()
    try_parse("missing colon", "{\"a\" 1}")
    try_parse("unclosed array", "[1, 2")
    try_parse("unterminated string", "\"open")
    try_parse("bad literal", "{\"a\": tru}")
    try_parse("empty input", "")
    try_parse("trailing input (accepted)", "[1] x")
    try_parse("bad \\u escape", "[\"\\u00g9\"]")
    try_parse("raw tab in string", "[\"a\tb\"]")
    try_parse("unclosed object", "{\"a\": 1")
    try_parse("unterminated escape", "\"ab\\")

# ============================================================================
# main
# ============================================================================

fn report_root(root: @Json) -> i32
    return report(root)

pub fn main() -> i32
    println("== doc ==")
    var input: String = string_new()
    match fd_stdin().read_to_end(@&input)
        Ok(_) => pass
        Err(_) =>
            println("vec_read_all_fd failed")
            return 1

    var src: StrView = builtin_doc()
    if input.len() == 0
        println("source: builtin")
    else
        println("source: stdin")
        src = input.as_view()
    show("bytes: ", src.len)

    let rc: i32 = match json_parse(src)
        Ok(root) => report_root(@root)
        Err(err) => print_parse_error(err)
    if rc != 0
        return rc

    println("== lookup ==")
    lookups()
    println("== errors ==")
    errors()
    return 0
