# examples/61_true_async - Tests for REAL async/await
#
# This tests actual async behavior:
# - poll() returns Poll<T> (Ready or Pending)
# - block_on() polls in a loop until Ready
# - await actually suspends on Pending
#
# Tests 1-3 implement the poll contract by hand; tests 4-5 use the
# compiler's own `async fn` lowering and drive it with `future_poll`.

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.fmt

# ============================================================================
# Poll encoding
# ============================================================================

# A hand-written poll source returns `Option<i32>`: `None` = Pending,
# `Some(v)` = Ready(v), the same contract `await` expects (AGAST #4558).

# ============================================================================
# Test 1: Simple async that returns immediately (Ready)
# ============================================================================

# A "future" that is immediately ready
struct ImmediateFuture
    value: i32

fn immediate_poll(self: *ImmediateFuture) -> Option<i32>
    # Always ready with the stored value
    return Some(self.value)

fn test_immediate_ready() -> i32
    print("test_immediate_ready... ")

    var future: ImmediateFuture
    future.value = 42

    # Poll should return Ready(42)
    let poll: Option<i32> = immediate_poll(@future)

    if poll.is_none()
        print("FAIL: expected Ready, got Pending\n")
        return 1

    let result: i32 = poll.unwrap()
    if result != 42
        print("FAIL: expected 42, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 2: Future that returns Pending then Ready
# ============================================================================

# A future that returns Pending N times before Ready
struct CountdownFuture
    remaining: i32
    value: i32

fn countdown_poll(self: *CountdownFuture) -> Option<i32>
    if self.remaining > 0
        self.remaining = self.remaining - 1
        return None
    return Some(self.value)

fn test_countdown_future() -> i32
    print("test_countdown_future... ")

    var future: CountdownFuture
    future.remaining = 3
    future.value = 100

    # First 3 polls should return Pending
    let poll1: Option<i32> = countdown_poll(@future)
    if poll1.is_some()
        print("FAIL: poll 1 should be Pending\n")
        return 1

    let poll2: Option<i32> = countdown_poll(@future)
    if poll2.is_some()
        print("FAIL: poll 2 should be Pending\n")
        return 1

    let poll3: Option<i32> = countdown_poll(@future)
    if poll3.is_some()
        print("FAIL: poll 3 should be Pending\n")
        return 1

    # 4th poll should be Ready(100)
    let poll4: Option<i32> = countdown_poll(@future)
    if poll4.is_none()
        print("FAIL: poll 4 should be Ready\n")
        return 1

    let value: i32 = poll4.unwrap()
    if value != 100
        print("FAIL: expected 100, got {value as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 3: block_on polls until Ready
# ============================================================================

# Simple block_on that polls a countdown future until ready
fn block_on_countdown(future: *CountdownFuture) -> i32
    var poll_count: i32 = 0
    loop
        let result: Option<i32> = countdown_poll(future)
        poll_count += 1
        if poll_count > 100
            # Safety limit
            return -1
        if result.is_some()
            return result.unwrap()
        # In real async, we would wait for I/O here
        # For this test, we just continue polling

fn test_block_on_countdown() -> i32
    print("test_block_on_countdown... ")

    var future: CountdownFuture
    future.remaining = 5
    future.value = 42

    # block_on should poll 6 times (5 Pending + 1 Ready)
    let result: i32 = block_on_countdown(@future)

    if result != 42
        print("FAIL: expected 42, got {result as i64}\n")
        return 1

    # Verify remaining was decremented to 0
    if future.remaining != 0
        print("FAIL: remaining should be 0, got {future.remaining as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 4: Compiler-generated async function
# ============================================================================

# The compiler turns
#
# async fn add_one(x: i32) -> i32
#     x + 1
#
# into `add_one$Future` and `add_one$poll`.  `$` is not an identifier
# character, so neither name can be written in source (AGAST #3606): an
# executor holds the future untyped and drives it through `future_poll`.

async fn add_one(x: i32) -> i32
    x + 1

fn test_generated_async() -> i32
    print("test_generated_async... ")

    # Create the future
    var future = add_one(10)

    # The poll is true once Ready, the value in the future (LARB R78)
    if !future_poll(@&future)
        print("FAIL: expected Ready\n")
        return 1
    let result: i32 = future.__result

    if result != 11
        print("FAIL: expected 11, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 5: Async with one await point
# ============================================================================

# One await point, no I/O: the awaited helper is ready at once, so the
# future's first poll is Ready.
#
# async fn double_countdown(n: i32) -> i32
#     let x = await countdown_value(n)
#     x * 2

async fn countdown_value(n: i32) -> i32
    n

async fn double_countdown(n: i32) -> i32
    let x: i32 = await countdown_value(n)
    x * 2

fn test_async_with_await() -> i32
    print("test_async_with_await... ")

    var future = double_countdown(5)

    # Nothing suspends, so one poll is Ready with the value (LARB R78)
    if !future_poll(@&future)
        print("FAIL: poll 1 should be Ready\n")
        return 1

    # 5 * 2 = 10
    if future.__result != 10
        print("FAIL: expected 10, got {future.__result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    print("=== True Async Tests ===\n\n")

    var failures: i32 = 0

    failures += test_immediate_ready()
    failures += test_countdown_future()
    failures += test_block_on_countdown()
    failures += test_generated_async()
    failures += test_async_with_await()

    print("\n")
    if failures > 0
        print("{failures as i64} test(s) FAILED\n")
        return 1

    print("All true async tests PASSED!\n")
    return 0
