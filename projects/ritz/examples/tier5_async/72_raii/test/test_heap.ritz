# Tests for allocator trait (future)
#
# trait Allocator
#     fn alloc(self: @&Self, size: i64) -> *u8
#     fn free(self: @&Self, ptr: *u8)
#
# struct Arena implements Allocator
# struct GlobalAlloc implements Allocator (default)

[[test]]
fn test_arena_basic() -> i32
    # Arena already exists in memory.ritz
    var arena = arena_new(4096)
    assert arena.valid(), "arena should be valid"

    let p1 = arena.alloc(100)
    assert p1 != null, "first alloc"

    let p2 = arena.alloc(200)
    assert p2 != null, "second alloc"

    # Different pointers
    assert p1 != p2, "different allocations"

    arena.destroy()
    0

[[test]]
fn test_arena_reset() -> i32
    var arena = arena_new(4096)

    let p1 = arena.alloc(100)
    let used1 = arena.used()

    arena.reset()
    assert arena.used() == 0, "reset clears usage"

    let p2 = arena.alloc(100)
    # After reset, p2 might equal p1 (reusing memory)

    arena.destroy()
    0

# An owned buffer frees itself: no malloc/free pair to get wrong.
[[test]]
fn test_owned_buffer() -> i32
    var buf: Vec<u8> = vec_with_cap<u8>(256)
    assert buf.cap() == 256, "capacity reserved"

    # Write some data
    buf.push(42)
    assert buf.get(0) == 42, "byte written"
    0                                   # buf is freed here, by its Drop

[[test]]
fn test_zeroed_array() -> i32
    # A fixed array, zeroed where it's declared (no calloc)
    let a: [10]i64 = [0; 10]

    # Should be zeroed
    for i in 0..10
        assert a[i] == 0, "should be zero"
    0
