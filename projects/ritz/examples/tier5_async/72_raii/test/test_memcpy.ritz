# Copying bytes into an owned buffer: the Vec takes the bytes of a view
# (no malloc + memcpy), and frees them when it goes.

import ritzlib.gvec

fn buffer_with_data(src: StrView) -> Vec<u8>
    var data: Vec<u8> = vec_with_cap<u8>(src.len())
    data.push_view(src)
    return data

[[test]]
fn test_buffer() -> i32
    let buf = buffer_with_data("hello")
    assert buf.len() == 5, "copied 5 bytes"
    assert buf.get(0) == 'h', "first byte"
    assert buf.get(4) == 'o', "last byte"
    0
