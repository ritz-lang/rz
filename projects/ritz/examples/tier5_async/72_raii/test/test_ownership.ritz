# Tests for ownership and move semantics
#
# Ritz uses move semantics for non-Copy types:
# - Assignment transfers ownership
# - Original binding becomes invalid after move
# - Only one owner at a time
# - Owner is responsible for cleanup

import ritzlib.gvec
import ritzlib.box
import ritzlib.io

# Non-Copy type: it owns a Vec, so it moves, and its drop glue frees the
# bytes when its owner goes out of scope.
struct UniqueBuf
    data: Vec<u8>
    size: i64

fn unique_buf_new(size: i64) -> UniqueBuf
    return UniqueBuf { data: vec_with_cap<u8>(size), size: size }

fn unique_buf_empty() -> UniqueBuf
    return UniqueBuf { data: vec_new<u8>(), size: 0 }

fn unique_buf_allocated(self: @UniqueBuf) -> bool
    return self.data.cap() > 0

# Release early, before scope end. Safe on an empty or released buffer.
fn unique_buf_release(self: @&UniqueBuf)
    self.data.deinit()
    self.size = 0

# Copy type (all primitives)
struct Pair
    x: i64
    y: i64

fn pair_new(x: i64, y: i64) -> Pair
    return Pair { x: x, y: y }

[[test]]
fn test_copy_semantics() -> i32
    # Primitives are Copy - assignment copies the value
    let a: i64 = 42
    let b = a  # Copy
    assert a == 42, "original unchanged"
    assert b == 42, "copy has same value"
    0

[[test]]
fn test_struct_copy() -> i32
    # Structs with only Copy fields are Copy
    let p1 = pair_new(1, 2)
    let p2 = p1  # Copy (all fields are i64, which is Copy)
    assert p1.x == 1, "original unchanged"
    assert p2.x == 1, "copy has same value"
    0

[[test]]
fn test_box_ownership() -> i32
    # Box<T> is a move type - assignment transfers ownership
    var b1: Box<i64> = box_new<i64>(42)
    assert b1.valid(), "b1 is valid"

    # After move, b1 should be invalid
    # var b2 = b1  # Would move ownership
    # assert not b1.valid(), "b1 invalid after move"
    # assert b2.valid(), "b2 is valid"

    # For now, just test basic usage
    assert b1.get() == 42, "value should be 42"
    b1.drop()
    0

[[test]]
fn test_unique_buf_create() -> i32
    var p = unique_buf_new(1024)
    assert unique_buf_allocated(@p), "should be allocated"
    assert p.size == 1024, "size should be 1024"
    unique_buf_release(@&p)
    assert not unique_buf_allocated(@p), "should be empty after release"
    0

# Test function that takes ownership
fn consume_unique(p: UniqueBuf) -> i64
    # p is moved into this function and dropped at its end
    return p.size

[[test]]
fn test_move_to_function() -> i32
    var p = unique_buf_new(512)
    assert consume_unique(p) == 512, "moved in"
    # p is now moved, should not be used
    # (move checker should catch use-after-move)
    0

# Test function that borrows
fn borrow_unique(p: @UniqueBuf) -> i64
    return p.size

[[test]]
fn test_borrow_preserves_ownership() -> i32
    var p = unique_buf_new(256)
    let size = borrow_unique(@p)
    assert size == 256, "borrowed size"
    # p is still valid - borrow doesn't transfer ownership
    assert unique_buf_allocated(@p), "still valid after borrow"
    0

# Test mutable borrow
fn modify_size(p: @&UniqueBuf, new_size: i64)
    p.size = new_size

[[test]]
fn test_mutable_borrow() -> i32
    var p = unique_buf_new(100)
    assert p.size == 100, "initial size"

    modify_size(@&p, 200)
    assert p.size == 200, "modified size"
    # Still own p: it's freed at scope end
    0

[[test]]
fn test_empty_unique_buf() -> i32
    var p = unique_buf_empty()
    assert not unique_buf_allocated(@p), "should be empty"
    unique_buf_release(@&p)  # Should be safe to release an empty one
    0

# Ownership transfer via return
fn create_resource() -> UniqueBuf
    var p = unique_buf_new(64)
    return p  # Ownership transferred to caller

[[test]]
fn test_return_ownership() -> i32
    var p = create_resource()
    assert unique_buf_allocated(@p), "received ownership"
    assert p.size == 64, "correct size"
    0
