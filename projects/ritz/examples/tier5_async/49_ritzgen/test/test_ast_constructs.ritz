# Simple constructs ritzgen's AST stage targets: literal, binary expr, call,
# variable declaration and if, each as an implicit-return function.
#
# Was tests/ast_test.ritz: fixtures with no assertions, run by nothing
# (build.py discovers test/ only, AGAST #1386). Each now asserts its value.

import ritzlib.sys

fn ast_int() -> i32
  42

fn ast_add() -> i32
  1 + 2

fn ast_call() -> i32
  print(c"hello\n")
  0

fn ast_var() -> i32
  var x: i32 = 10
  x

fn ast_if() -> i32
  if 1 == 1
    return 1
  return 0

[[test]]
fn test_int_literal() -> i32
  assert ast_int() == 42, "literal"
  0

[[test]]
fn test_binary_expr() -> i32
  assert ast_add() == 3, "1 + 2"
  0

[[test]]
fn test_call_then_value() -> i32
  assert ast_call() == 0, "call then 0"
  0

[[test]]
fn test_var_decl() -> i32
  assert ast_var() == 10, "var x"
  0

[[test]]
fn test_if_return() -> i32
  assert ast_if() == 1, "if branch"
  0
