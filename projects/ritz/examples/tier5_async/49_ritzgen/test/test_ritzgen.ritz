# Tests for 49_ritzgen — generator that consumes a .grammar file and
# emits a parser/lexer.  Tests use the bundled grammars/ritz.grammar.

import ritzlib.testlib

[[test]]
fn test_ritzgen_loads_grammar() -> i32
    let args: [1]StrView = ["grammars/ritz.grammar"]
    match exec_capture("./ritzgen", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "ritzgen <grammar> should exit 0"
            assert buf_contains(c.output(), "token definitions"), "should report token count"
            assert buf_contains(c.output(), "grammar rules"), "should report rule count"
        Err(_) =>
            assert false, "spawn ./ritzgen"
    0
