# ritzgen - Ritz Parser Generator
#
# A combined lexer/parser generator with a flex/bison-style grammar DSL.
# Generates recursive descent parsers for the Ritz language.

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.str
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec

import tokens
import ast
import lexer
import grammar
import codegen
import parser

# =============================================================================
# File testing
# =============================================================================

fn test_file(path: *u8, defs: *TokenDefs, verbose: i32) -> i32
    # Read file
    var buf: Vec<u8> = vec_new<u8>()
    let fd: i32 = sys_open(path, 0)
    if fd < 0
        eprint("Cannot open: {path}\n")
        return -1

    var chunk: [4096]u8
    while 1 == 1
        let n: i64 = sys_read(fd, @chunk[0], 4096)
        if n <= 0
            break
        buf.push_span(Span<u8> { ptr: (@chunk[0]), len: (n) as i64 })
    sys_close(fd)

    # Lex file
    var lex: Lexer
    lexer_init(@lex, buf.data, buf.len, defs)

    var tok: Token
    var error_count: i32 = 0
    var token_count: i32 = 0

    while 1 == 1
        lexer_next(@lex, @tok)
        token_count += 1

        if verbose != 0
            var name: [64]u8
            get_token_name(defs, tok.kind, @name[0], 64)

            # Print token info
            let name_p: *u8 = @name[0]
            print("{tok.line}:{tok.col} {name_p}")

            if tok.len > 0 and tok.kind != TOK_NEWLINE
                print(" '")
                sys_write(1, tok.start, tok.len as i64)
                print("'")
            print("\n")

        if tok.kind == TOK_ERROR
            error_count += 1
            if verbose == 0
                eprint("{path}:{tok.line}:{tok.col}: error: unexpected character '")
                sys_write(2, tok.start, 1)
                eprint("'\n")

        if tok.kind == TOK_EOF
            break

    # buf is auto-dropped via Drop trait

    if error_count == 0
        if verbose == 0
            print("{path}: OK ({token_count} tokens)\n")
        return 0
    else
        eprint("{path}: {error_count} errors\n")
        return error_count

# =============================================================================
# Main
# =============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("ritzgen", "Ritz Parser Generator")
    spec.switch('t', "test", "Test mode: lex files and report errors")
    spec.switch('v', "verbose", "Verbose output (show all tokens)")
    spec.switch('g', "generate", "Generate parser code")
    spec.switch('l', "lexer", "Generate lexer setup code")
    spec.switch('k', "tokens", "Generate token constants")
    spec.switch('a', "ast", "Parse input and print AST")
    spec.option('o', "output", "FILE", "Output file for generated code", None)
    # One run of positionals: the grammar first, then the input files.
    spec.positionals("GRAMMAR [INPUT...]", "Grammar file and optional input files", 1, 100)
    spec

# A usage error (from argspec_parse, or a bad number): report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# A switch as the 0/1 flag the rest of the program uses.
fn flag_i32(b: bool) -> i32
    if b
        return 1
    0

# Positional i as a C string: a view of an argv string, so NUL-terminated.
# Callers stay below positional_count; past it is null.
fn positional_cstr(p: @ParsedArgs, i: i32) -> *u8
    match p.positional(i as i64)
        Some(s) => s.as_cstr_unchecked()
        None => null

fn ritzgen(p: @ParsedArgs) -> i32
    let test_mode: i32 = flag_i32(p.switch("t"))
    let verbose: i32 = flag_i32(p.switch("v"))
    let generate: i32 = flag_i32(p.switch("g"))
    let gen_lexer: i32 = flag_i32(p.switch("l"))
    let gen_tokens: i32 = flag_i32(p.switch("k"))
    let ast_mode: i32 = flag_i32(p.switch("a"))
    let positional_count: i32 = p.positionals().len as i32

    # Read grammar file
    let grammar_path: *u8 = positional_cstr(p, 0)

    var grammar_buf: Vec<u8> = vec_new<u8>()
    let gfd: i32 = sys_open(grammar_path, 0)
    if gfd < 0
        eprint("Cannot open grammar file: {grammar_path}\n")
        return 1

    var chunk: [4096]u8
    while 1 == 1
        let n: i64 = sys_read(gfd, @chunk[0], 4096)
        if n <= 0
            break
        grammar_buf.push_span(Span<u8> { ptr: (@chunk[0]), len: (n) as i64 })
    sys_close(gfd)

    # Parse grammar
    var gp: GrammarParser
    gp_init(@gp, grammar_buf.data, grammar_buf.len)

    var defs: TokenDefs
    let parse_result: i32 = parse_grammar(@gp, @defs)
    if parse_result < 0
        eprint("Failed to parse grammar file\n")
        # grammar_buf auto-dropped
        return 1

    eprint("Loaded {defs.count} token definitions\n")

    # Parse grammar rules if %grammar section present
    var gram: Grammar
    gram.rule_count = 0
    if parse_result == 1
        parse_grammar_rules(@gp, @gram)
        eprint("Parsed {gram.rule_count} grammar rules\n")
        if verbose != 0
            print_grammar(@gram)

    # Generate token constants if requested
    if gen_tokens != 0
        var code: Vec<u8> = vec_new<u8>()
        generate_tokens(@defs, @code)
        sys_write(1, code.data, code.len)
        # code and grammar_buf auto-dropped
        return 0

    # Generate lexer setup if requested
    if gen_lexer != 0
        var code: Vec<u8> = vec_new<u8>()
        generate_lexer_setup(@defs, @code)
        sys_write(1, code.data, code.len)
        # code and grammar_buf auto-dropped
        return 0

    # Generate parser code if requested
    if generate != 0 and gram.rule_count > 0
        var code: Vec<u8> = vec_new<u8>()
        generate_parser(@defs, @gram, @code)
        sys_write(1, code.data, code.len)
        # code and grammar_buf auto-dropped
        return 0

    # Special mode: 4 positional args = grammar + 3 output files
    # Usage: ritzgen GRAMMAR TOKENS_OUT LEXER_OUT PARSER_OUT
    if positional_count == 4 and gram.rule_count > 0
        let tokens_path: *u8 = positional_cstr(p, 1)
        let lexer_path: *u8 = positional_cstr(p, 2)
        let parser_path: *u8 = positional_cstr(p, 3)

        # Generate and write tokens
        var tokens_code: Vec<u8> = vec_new<u8>()
        generate_tokens(@defs, @tokens_code)
        # O_WRONLY | O_CREAT | O_TRUNC = 1 | 64 | 512 = 577
        let tfd: i32 = sys_open3(tokens_path, 577, 420)  # 420 = 0644
        if tfd >= 0
            sys_write(tfd, tokens_code.data, tokens_code.len)
            sys_close(tfd)
            print("{tokens_path}: OK ({tokens_code.len} bytes)\n")
        else
            eprint("Cannot write: {tokens_path}\n")
            return 1

        # Generate and write lexer setup
        var lexer_code: Vec<u8> = vec_new<u8>()
        generate_lexer_setup(@defs, @lexer_code)
        let lfd: i32 = sys_open3(lexer_path, 577, 420)
        if lfd >= 0
            sys_write(lfd, lexer_code.data, lexer_code.len)
            sys_close(lfd)
            print("{lexer_path}: OK ({lexer_code.len} bytes)\n")
        else
            eprint("Cannot write: {lexer_path}\n")
            return 1

        # Generate and write parser
        var parser_code: Vec<u8> = vec_new<u8>()
        generate_parser(@defs, @gram, @parser_code)
        let pfd: i32 = sys_open3(parser_path, 577, 420)
        if pfd >= 0
            sys_write(pfd, parser_code.data, parser_code.len)
            sys_close(pfd)
            print("{parser_path}: OK ({parser_code.len} bytes)\n")
        else
            eprint("Cannot write: {parser_path}\n")
            return 1

        return 0

    # AST mode: parse input files and print AST
    if ast_mode != 0 and positional_count > 1
        var i: i32 = 1
        var errors: i32 = 0
        while i < positional_count
            let input_path: *u8 = positional_cstr(p, i)
            let result: i32 = parse_file_ast(input_path, @defs, verbose)
            if result != 0
                errors += 1
            i += 1
        # grammar_buf auto-dropped
        if errors > 0
            return 1
        return 0

    # Process input files
    if positional_count > 1
        var i: i32 = 1
        var errors: i32 = 0
        while i < positional_count
            let input_path: *u8 = positional_cstr(p, i)
            let result: i32 = test_file(input_path, @defs, verbose)
            if result != 0
                errors += 1
            i += 1
        # grammar_buf auto-dropped
        if errors > 0
            return 1
        return 0

    # No input files - just show loaded tokens
    print("\nToken definitions:\n")
    var i: i32 = 0
    while i < defs.count
        let def: *TokenDef = @defs.defs[i]
        print("  {def.token_id}: {def.name} = ")
        if def.is_literal != 0
            print("\"{def.pattern}\"")
        else
            print("/{def.pattern}/")
        if def.is_skip != 0
            print(" (skip)")
        print("\n")
        i += 1

    # grammar_buf auto-dropped
    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = ritzgen(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
