# Example 80: process — spawn children over pipes with ritzlib.process
#
# ritzlib.process had no example, so neither differential ritz0-vs-ritz1
# stage exercised it (AGAST #1461).  Five parts, each printing only values
# that are the same on every run (never a PID):
#
# 1. `== read all ==`  — spawn /bin/cat, write two lines, close stdin,
#    slurp stdout with process_read_stdout_all, wait.  A second wait on the
#    same process is Err(Child), shown by name (ECHILD).
# 2. `== read by line ==` — the same through process_read_line, with the
#    second line left unterminated so the EOF behaviour shows: a final
#    line without '\n', then an empty Vec.
# 3. `== exit code ==` — `sh -c 'exit 3'`, sh found with find_command,
#    and its exit code.
# 4. `== kill ==` — process_kill on a cat still waiting for input: wait
#    reports SIGKILL (9) and exit code 128 + 9.
# 5. `== missing ==` — find_command on a name that is nowhere.
#
# The API is the StrView / Span one (AGAST #1481): spawn(cmd, args) takes
# "..." literals and a Span<StrView> of arguments and returns
# Result<Process, Errno>; process_write_all and process_wait return Results
# too (AGAST #4298); find_command returns Option<String>.  The suite runs
# examples with a fixed PATH, and find_command falls back to the standard
# directories without one, so the output does not depend on the caller's PATH.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.process
import ritzlib.fmt

# Write one raw byte to stdout (the fd writer is unbuffered, so it stays
# ordered with print).
fn put_byte(c: u8)
    var w = stdout_writer()
    w.write_byte(c)

# ============================================================================
# Output helpers
# ============================================================================

fn show(label: *u8, v: i64)
    print("{label}{v}\n")

# `label` [bytes] (n), with '\n' shown as \n so each value stays on one line.
fn show_vec(label: *u8, v: @Vec<u8>)
    print("{label}[")
    var i: i64 = 0
    while i < v.len
        let c: u8 = *(v.data + i)
        if c == '\n'
            print("\\n")
        else
            put_byte(c)
        i += 1
    print("] ({v.len})\n")

# A Result<i64, Errno>'s count, or its errno's name.
fn show_count(label: *u8, r: Result<i64, Errno>)
    match r
        Ok(n) => show(label, n)
        Err(e) =>
            print("{label}")
            println(e.name())

# process_wait's ProcessResult; exit -1 (and the errno's name) if it failed.
fn wait_or_report(p: @&Process) -> ProcessResult
    var r: ProcessResult = ProcessResult { exit_code: -1, signaled: 0, signal: 0 }
    match p.wait()
        Ok(w) => r = w
        Err(e) =>
            print("wait failed: ")
            println(e.name())
    r

fn show_result(r: @ProcessResult)
    show(c"exit: ", r.exit_code as i64)
    show(c"success: ", r.success() as i64)
    show(c"signaled: ", r.signaled as i64)

# spawn(), or an invalid Process (process_valid 0) if it failed.
fn spawn_or_invalid(cmd: StrView, args: Span<StrView>) -> Process
    var p: Process = Process { pid: -1, stdin_fd: -1, stdout_fd: -1, stderr_fd: -1, waited: 0 }
    match spawn(cmd, args)
        Ok(q) => p = q
        Err(_) => p.pid = -1
    p

fn spawn_cat() -> Process
    spawn_or_invalid("/bin/cat", span_empty<StrView>())

fn is_some(o: *Option<String>) -> bool
    match *o
        Some(_) => true
        None => false

# ============================================================================
# 1. Read all
# ============================================================================

fn read_all()
    println("== read all ==")
    var p: Process = spawn_cat()
    show(c"spawned: ", p.valid() as i64)
    show_count(c"wrote: ", p.write_all("alpha\n"))
    show_count(c"wrote: ", p.write_all("bravo\n"))
    p.close_stdin()

    var out: Vec<u8> = p.read_stdout_all()
    show_vec(c"stdout: ", @out)

    var r: ProcessResult = wait_or_report(@&p)
    show_result(@r)
    match p.wait()
        Ok(_) => println("wait again: Ok")
        Err(e) =>
            print("wait again: ")
            println(e.name())
    p.cleanup()

# ============================================================================
# 2. Read by line
# ============================================================================

fn read_by_line()
    println("== read by line ==")
    var p: Process = spawn_cat()
    p.write_all("alpha\n")
    p.write_all("bravo")
    p.close_stdin()

    var l1: Vec<u8> = p.read_line()
    show_vec(c"line 1: ", @l1)
    var l2: Vec<u8> = p.read_line()
    show_vec(c"line 2: ", @l2)
    var l3: Vec<u8> = p.read_line()
    show_vec(c"eof: ", @l3)

    var r: ProcessResult = wait_or_report(@&p)
    show(c"exit: ", r.exit_code as i64)
    p.cleanup()

# ============================================================================
# 3. Exit code
# ============================================================================

fn exit_code()
    println("== exit code ==")
    var sh: Option<String> = find_command("sh")
    if not is_some(@sh)
        println("sh found: 0")
        return
    println("sh found: 1")

    var args: [2]StrView
    args[0] = "-c"
    args[1] = "exit 3"
    var p: Process = spawn_or_invalid("sh", span_from_ptr<StrView>(@args[0], 2))
    var r: ProcessResult = wait_or_report(@&p)
    show_result(@r)
    p.cleanup()

# ============================================================================
# 4. Kill
# ============================================================================

fn kill_child()
    println("== kill ==")
    # cat blocks reading its open stdin, so it is still running when killed.
    var p: Process = spawn_cat()
    p.kill()
    var r: ProcessResult = wait_or_report(@&p)
    show_result(@r)
    show(c"signal: ", r.signal as i64)
    p.cleanup()

# ============================================================================
# 5. Missing command
# ============================================================================

fn missing()
    println("== missing ==")
    var found: Option<String> = find_command("ritz-no-such-command")
    if not is_some(@found)
        println("not found: 1")
    else
        println("not found: 0")

pub fn main() -> i32
    read_all()
    read_by_line()
    exit_code()
    kill_child()
    missing()
    return 0
