# Tests for 44_csv — CSV parser/projector.
import ritzlib.testlib

[[test]]
fn test_csv_simple() -> i32
    match exec_capture("./csv", span_empty<StrView>(), span_empty<StrView>(), "a,b,c\n1,2,3\n4,5,6\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on simple CSV"
            assert buf_contains(c.output(), "1"), "output should contain values"
        Err(_) =>
            assert false, "spawn ./csv"
    0

[[test]]
fn test_csv_field_selection() -> i32
    let args: [2]StrView = ["-f", "1,3"]
    match exec_capture("./csv", @args, span_empty<StrView>(), "a,b,c,d\n1,2,3,4\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on field selection"
            assert buf_contains(c.output(), "1"), "should contain field 1"
        Err(_) =>
            assert false, "spawn ./csv"
    0
