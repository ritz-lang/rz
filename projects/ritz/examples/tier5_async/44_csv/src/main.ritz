# csv - CSV parser and formatter
#
# Usage: csv [OPTIONS] [FILE]
#   Parse and format CSV data.
#
# Options:
#   -d CHAR       Field delimiter (default: comma)
#   -H, --header  First row is header (print field names)
#   -f FIELDS     Select specific fields (1-indexed, comma-separated)
#   -t, --tsv     Use tab as delimiter (same as -d '\t')
#   -h, --help    Show help
#
# Examples:
#   csv data.csv                    # Pretty print all fields
#   csv -f 1,3 data.csv             # Print columns 1 and 3
#   csv -H data.csv                 # Treat first row as header
#   csv -t data.tsv                 # Parse tab-separated values

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.fmt
import ritzlib.str
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec

# ============================================================================
# Constants
# ============================================================================

const MAX_FIELDS: i32 = 64
const MAX_FIELD_LEN: i64 = 4096

# ============================================================================
# CSV Parser
# ============================================================================

struct CsvParser
    data: *u8
    len: i64
    pos: i64
    delimiter: u8
    # Current row fields
    fields: *Vec<*u8>
    field_buf: *Vec<u8>

fn csv_init(p: *CsvParser, data: *u8, len: i64, delim: u8, fields: *Vec<*u8>, buf: *Vec<u8>) -> i32
    p.data = data
    p.len = len
    p.pos = 0
    p.delimiter = delim
    p.fields = fields
    p.field_buf = buf
    return 0

fn csv_eof(p: *CsvParser) -> i32
    return (p.pos >= p.len) as i32

fn peek(p: *CsvParser) -> u8
    if p.pos >= p.len
        return 0
    return *(p.data + p.pos)

fn advance(p: *CsvParser) -> u8
    if p.pos >= p.len
        return 0
    let c: u8 = *(p.data + p.pos)
    p.pos = p.pos + 1
    return c

fn parse_quoted_field(p: *CsvParser) -> i32
    # Skip opening quote
    advance(p)

    let start: i64 = p.field_buf.len

    while p.pos < p.len
        let c: u8 = peek(p)

        if c == '"'  # '"'
            advance(p)
            # Check for escaped quote ("")
            if peek(p) == '"'
                p.field_buf.push(advance(p))
            else
                # End of quoted field
                break
        else
            p.field_buf.push(advance(p))

    # Null terminate and store pointer
    p.field_buf.push(0)
    p.fields.push(p.field_buf.data + start)

    return 0

fn parse_unquoted_field(p: *CsvParser) -> i32
    let start: i64 = p.field_buf.len

    while p.pos < p.len
        let c: u8 = peek(p)

        if c == p.delimiter or c == '\n' or c == '\r'
            break

        p.field_buf.push(advance(p))

    # Null terminate and store pointer
    p.field_buf.push(0)
    p.fields.push(p.field_buf.data + start)

    return 0

fn parse_field(p: *CsvParser) -> i32
    if peek(p) == '"'  # '"'
        return parse_quoted_field(p)
    else
        return parse_unquoted_field(p)

fn parse_row(p: *CsvParser) -> i32
    # Clear previous fields
    p.fields.clear()

    # Handle empty line
    if peek(p) == '\n'
        advance(p)
        return 0

    # Parse first field
    parse_field(p)

    # Parse remaining fields
    while p.pos < p.len
        let c: u8 = peek(p)

        if c == p.delimiter
            advance(p)
            parse_field(p)
        else if c == '\n'  # newline
            advance(p)
            break
        else if c == '\r'  # CR
            advance(p)
            if peek(p) == '\n'
                advance(p)
            break
        else
            break

    return 0

# ============================================================================
# Field selection parsing
# ============================================================================

struct FieldSelector
    indices: [64]i32      # 1-indexed field numbers to select
    count: i32

fn parse_field_selector(selector: *FieldSelector, spec: *u8) -> i32
    selector.count = 0

    if spec == null
        return 0

    var pos: i64 = 0
    var num: i32 = 0

    while *(spec + pos) != 0
        let c: u8 = *(spec + pos)

        if c >= '0' and c <= '9'  # digit
            num = num * 10 + (c - '0') as i32
        else if c == ','  # comma
            if num > 0 and selector.count < 64
                selector.indices[selector.count] = num
                selector.count = selector.count + 1
            num = 0

        pos += 1

    # Don't forget last number
    if num > 0 and selector.count < 64
        selector.indices[selector.count] = num
        selector.count = selector.count + 1

    return 0

# ============================================================================
# File reading
# ============================================================================

fn read_file(path: *u8, buf: *Vec<u8>) -> i32
    let fd: i32 = sys_open(path, 0)  # O_RDONLY
    if fd < 0
        return -1

    var tmp: [4096]u8
    while 1 == 1
        let n: i64 = sys_read(fd, @tmp[0], 4096)
        if n < 0
            sys_close(fd)
            return -1
        if n == 0
            break
        buf.push_span(Span<u8> { ptr: (@tmp[0]), len: (n) as i64 })

    sys_close(fd)
    return 0

fn read_stdin(buf: *Vec<u8>) -> i32
    var tmp: [4096]u8
    while 1 == 1
        let n: i64 = sys_read(0, @tmp[0], 4096)
        if n < 0
            return -1
        if n == 0
            break
        buf.push_span(Span<u8> { ptr: (@tmp[0]), len: (n) as i64 })
    return 0

# ============================================================================
# Output
# ============================================================================

fn print_field(s: *u8) -> i32
    print("{s}")
    return 0

fn print_row(fields: *Vec<*u8>, selector: *FieldSelector, headers: *Vec<*u8>, show_headers: i32) -> i32
    var first: i32 = 1

    if selector.count > 0
        # Print only selected fields
        for i in 0..selector.count
            let idx: i32 = selector.indices[i] - 1  # Convert to 0-indexed
            if idx >= 0 and idx < fields.len as i32
                if first == 0
                    print("\t")
                first = 0

                if show_headers != 0 and headers.len > idx as i64
                    let header: *u8 = headers.get(idx as i64)
                    print("{header}=")

                print_field(fields.get(idx as i64))
    else
        # Print all fields
        for i in 0..fields.len
            if first == 0
                print("\t")
            first = 0

            if show_headers != 0 and headers.len > i
                let header: *u8 = headers.get(i)
                print("{header}=")

            print_field(fields.get(i))

    print("\n")
    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("csv", "CSV parser and formatter")
    spec.option('d', "delimiter", "CHAR", "Field delimiter (default: comma)", Some(","))
    spec.option('f', "fields", "LIST", "Select specific fields (1-indexed, comma-separated)", Some(""))
    spec.switch('H', "header", "First row is header")
    spec.switch('t', "tsv", "Use tab as delimiter")
    spec.positionals("FILE", "CSV file to process (stdin if omitted)", 0, 1)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# A switch as the 0/1 flag the rest of the program uses.
fn flag_i32(b: bool) -> i32
    if b
        return 1
    0

# An option's value as the C string the parser works on: a view of an argv
# string or of a literal default, so NUL-terminated; null when not given.
fn value_cstr(o: Option<StrView>) -> *u8
    match o
        Some(s) => s.as_cstr_unchecked()
        None => null

# Read FILE (a view of an argv string, so NUL-terminated, as read_file
# needs), or stdin when there is none.  Returns 1 after reporting a failure.
fn read_input(file: Option<StrView>, input: *Vec<u8>) -> i32
    match file
        Some(f) => read_path(f, input)
        None => read_stdin_or_report(input)

fn read_path(file: StrView, input: *Vec<u8>) -> i32
    let path: *u8 = file.as_cstr_unchecked()
    if read_file(path, input) != 0
        eprint("csv: cannot read file: {path}\n")
        return 1
    0

fn read_stdin_or_report(input: *Vec<u8>) -> i32
    if read_stdin(input) != 0
        eprint("csv: cannot read stdin\n")
        return 1
    0

fn csv(p: @ParsedArgs) -> i32
    # Determine delimiter
    var delimiter: u8 = 44  # comma
    if p.switch("t")
        delimiter = 9  # tab

    let delim_str: *u8 = value_cstr(p.value("d"))
    if delim_str != null and *delim_str != 0
        delimiter = *delim_str

    let has_header: i32 = flag_i32(p.switch("H"))

    # Parse field selector
    var selector: FieldSelector
    let field_spec: *u8 = value_cstr(p.value("f"))
    parse_field_selector(@selector, field_spec)

    # Read input
    var input: Vec<u8> = vec_new<u8>()

    if read_input(p.positional(0), @input) != 0
        return 1

    # Initialize parser
    # Pre-allocate buffers to avoid reallocation (which would invalidate pointers)
    var fields: Vec<*u8> = vec_with_cap<*u8>(64)
    var field_buf: Vec<u8> = vec_with_cap<u8>(8192)
    var headers: Vec<*u8> = vec_with_cap<*u8>(64)
    var header_buf: Vec<u8> = vec_with_cap<u8>(4096)

    var parser: CsvParser
    csv_init(@parser, input.data, input.len, delimiter, @fields, @field_buf)

    # Process rows
    var row_num: i32 = 0
    while csv_eof(@parser) == 0
        # Reset field buffer for this row (but keep headers)
        field_buf.clear()

        parse_row(@parser)

        if fields.len == 0
            continue

        if row_num == 0 and has_header != 0
            # Save header row
            for i in 0..fields.len
                let field: *u8 = fields.get(i)
                let slen: i64 = strlen(field)
                let start: i64 = header_buf.len
                header_buf.push_span(Span<u8> { ptr: (field), len: (slen) as i64 })
                header_buf.push(0)
                headers.push(header_buf.data + start)
        else
            # Print data row
            print_row(@fields, @selector, @headers, has_header)

        row_num += 1

    # Cleanup handled automatically by Drop

    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = csv(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
