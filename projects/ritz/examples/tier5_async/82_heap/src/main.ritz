# Example 82: heap — ritzlib.heap's Heap<T>, one heap-allocated value
#
# ritzlib.heap had no importing example, so neither differential ritz0-vs-ritz1
# stage exercised it (AGAST #1463).  Note that Heap<T> is a *box* (one value
# behind a malloc'd pointer, freed by Drop), not a priority queue: "push" here
# means boxing a value into the next slot and "pop" means reading it back and
# dropping the box, in insertion order.
#
# Covers every public function -- heap_new, heap_get, heap_set, heap_as_ptr,
# heap_valid, heap_drop -- plus the method forms (.get/.set) and a Heap of a
# struct.  heap_drop nulls the pointer, so the automatic Drop at scope exit
# (and a second heap_drop) is a no-op on an already-dropped box.

import ritzlib.io
import ritzlib.heap

const N: i64 = 5

struct Point
    x: i64
    y: i64

fn main() -> i32
    var values: [5]i64
    values[0] = 3
    values[1] = 1
    values[2] = 4
    values[3] = 1
    values[4] = 5

    # Push: box each value into its own heap allocation.  An array whose
    # elements have Drop must be initialised up front, so fill every slot
    # with a placeholder box, then free it and box the real value.
    var boxes: [5]Heap<i64> = [heap_new<i64>(0), heap_new<i64>(0), heap_new<i64>(0), heap_new<i64>(0), heap_new<i64>(0)]
    var pushed: i64 = 0
    while pushed < N
        heap_drop<i64>(@&boxes[pushed])
        boxes[pushed] = heap_new<i64>(values[pushed])
        let v: i64 = heap_get<i64>(@boxes[pushed])
        let ok: i32 = heap_valid<i64>(@boxes[pushed])
        print("push {v}: valid={ok}\n")
        pushed += 1
    print("pushed: {pushed}\n")

    var sum: i64 = 0
    var i: i64 = 0
    while i < N
        sum += heap_get<i64>(@boxes[i])
        i += 1
    print("sum via heap_get: {sum}\n")

    # Pop: read each box back in order, then free it.
    var popped: i64 = 0
    while popped < N
        let v: i64 = heap_get<i64>(@boxes[popped])
        heap_drop<i64>(@&boxes[popped])
        let ok: i32 = heap_valid<i64>(@boxes[popped])
        print("pop {popped}: {v} (valid after drop: {ok})\n")
        popped += 1
    print("popped: {popped}\n")

    # In-place updates: heap_set, and a write through heap_as_ptr.
    var h: Heap<i64> = heap_new<i64>(0)
    heap_set<i64>(@&h, 7)
    print("set 7 -> get: {heap_get<i64>(@h)}\n")
    let p: *i64 = heap_as_ptr<i64>(@h)
    *p = 9
    print("as_ptr write 9 -> get: {heap_get<i64>(@h)}\n")
    print("method get: {h.get()}\n")
    h.set(11)
    print("method set 11 -> get: {h.get()}\n")
    heap_drop<i64>(@&h)
    heap_drop<i64>(@&h)
    print("double drop safe: {heap_valid<i64>(@h)}\n")

    # A struct in the box.
    var hp: Heap<Point> = heap_new<Point>(Point { x: 3, y: 4 })
    let pt: Point = heap_get<Point>(@hp)
    print("point: {pt.x},{pt.y}\n")
    heap_drop<Point>(@&hp)
    return 0
