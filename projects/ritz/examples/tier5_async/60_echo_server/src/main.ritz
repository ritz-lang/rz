# examples/60_echo_server/main.ritz - TCP echo server with io_uring
#
# A simple TCP echo server using io_uring for efficient I/O.
# This demonstrates the io_uring-based networking capabilities of Ritz.
#
# Note: This uses runtime_* functions which are io_uring-backed but
# synchronous wrappers (not async/await syntax). True async/await
# with proper state machines will be implemented in Phase 12 (Valet).
#
# Usage: ./echo_server [port]
# Default port: 8080

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.async_net
import ritzlib.fmt

# The port a bound socket was given.  The self-tests below bind port 0 so the
# kernel picks a free one: a fixed port failed (or hung) whenever anything else
# on the host held it, e.g. two gates sharing a machine (AGAST #3136).
fn bound_port(sock: @Socket) -> i32
    match sock.local_port()
        Ok(p) => return p
        Err(_) => return -1

# ============================================================================
# Echo server implementation
# ============================================================================

# Handle a single client connection - read data and echo it back
fn handle_client(rt: *Runtime, client_fd: i32) -> i32
    var buf: [4096]u8
    var total_bytes: i64 = 0

    # Read/write loop
    loop
        # Read from client via io_uring
        let n: i64 = match runtime_recv(rt, client_fd, Span<u8> { ptr: (@buf[0]), len: (4096) as i64 })
            Ok(v) => v
            Err(_) => 0

        if n <= 0
            # Connection closed or error
            break

        # Echo back via io_uring
        match runtime_send(rt, client_fd, Span<u8> { ptr: (@buf[0]), len: (n as i32) as i64 })
            Ok(_) => pass
            Err(_) => break

        total_bytes += n

    sys_close(client_fd)
    return total_bytes as i32

# Run the echo server
fn run_server(port: i32) -> i32
    print("Starting echo server on port {port as i64}...\n")

    # Initialize async runtime
    var rt: Runtime
    let ret_init: i32 = rt.init()
    if ret_init < 0
        print("Failed to initialize runtime\n")
        return 1

    # Create server socket
    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            print("Failed to create socket\n")
            rt.destroy()
            return 1

    # Set socket options
    server.set_reuseaddr()

    # Bind to all interfaces
    match server.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            print("Failed to bind to port {port as i64}\n")
            server.close()
            rt.destroy()
            return 1

    # Start listening
    match server.listen(128)
        Ok(_) => pass
        Err(_) =>
            print("Failed to listen\n")
            server.close()
            rt.destroy()
            return 1

    print("Server listening on 0.0.0.0:{port as i64}\n")
    print("Press Ctrl+C to stop\n\n")

    # Accept loop - handle one client at a time for now.  The server runs
    # until it's killed: nothing leaves this loop, so nothing follows it.
    var client_count: i32 = 0
    loop
        # Accept via io_uring
        let client: Socket = match runtime_accept(@&rt, @server)
            Ok(c) => c
            Err(_) =>
                print("Accept failed\n")
                continue

        client_count += 1
        print("Client {client_count as i64} connected\n")

        # Handle client (blocking for now - could fork for concurrency)
        let bytes_echoed: i32 = handle_client(@rt, client.raw())

        print("Client {client_count as i64} disconnected, echoed {bytes_echoed as i64} bytes\n")

# ============================================================================
# Test mode - run server briefly and have client connect
# ============================================================================

fn test_echo_server() -> i32
    print("test_echo_server... ")

    # Initialize runtime
    var rt: Runtime
    let ret_init: i32 = rt.init()
    if ret_init < 0
        print("FAIL: runtime init\n")
        return 1

    # Create server
    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            print("FAIL: socket\n")
            rt.destroy()
            return 1
    server.set_reuseaddr()

    server.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@server)
    server.listen(1)

    # Fork - child is client, parent is server
    let pid: i32 = sys_fork()

    if pid == 0
        # Child: client
        # Small delay
        var ts: [16]u8
        let ts_ptr: *i64 = @ts[0] as *i64
        *ts_ptr = 0
        *(ts_ptr + 1) = 10000000
        sys_nanosleep(@ts[0] as *i64, null)

        var client: Socket
        match socket_tcp()
            Ok(s) => client = s
            Err(_) => sys_exit(1)
        match client.connect("127.0.0.1", port)
            Ok(_) => pass
            Err(_) => sys_exit(1)

        # Send test data
        var send_buf: [32]u8
        send_buf[0] = 72   # H
        send_buf[1] = 101  # e
        send_buf[2] = 108  # l
        send_buf[3] = 108  # l
        send_buf[4] = 111  # o
        sys_write(client.raw(), @send_buf[0], 5)

        # Read echo
        var recv_buf: [32]u8
        let n: i64 = sys_read(client.raw(), @recv_buf[0], 32)

        client.close()

        # Verify echo
        if n != 5
            sys_exit(2)
        if recv_buf[0] != 72
            sys_exit(3)
        if recv_buf[4] != 111
            sys_exit(4)

        sys_exit(0)
    else
        # Parent: server
        # Accept one client
        var client: Socket = match runtime_accept(@&rt, @server)
            Ok(c) => c
            Err(_) =>
                print("FAIL: accept\n")
                server.close()
                rt.destroy()
                return 1

        # Echo one message
        var buf: [64]u8
        let n: i64 = match runtime_recv(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (64) as i64 })
            Ok(v) => v
            Err(_) => 0
        if n > 0
            runtime_send(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (n as i32) as i64 })

        client.close()

        # Wait for child
        var status: i32 = 0
        sys_wait4(pid, @status, 0, null)

        # Check child exit status
        let exit_code: i32 = (status >> 8) & 255
        if exit_code != 0
            print("FAIL: client exit code {exit_code as i64}\n")
            server.close()
            rt.destroy()
            return 1

    server.close()
    rt.destroy()
    print("OK\n")
    return 0

fn test_multiple_messages() -> i32
    print("test_multiple_messages... ")

    var rt: Runtime
    rt.init()

    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            print("FAIL: socket\n")
            rt.destroy()
            return 1
    server.set_reuseaddr()

    server.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@server)
    server.listen(1)

    let pid: i32 = sys_fork()

    if pid == 0
        # Child: client - send multiple messages
        var ts: [16]u8
        let ts_ptr: *i64 = @ts[0] as *i64
        *ts_ptr = 0
        *(ts_ptr + 1) = 10000000
        sys_nanosleep(@ts[0] as *i64, null)

        var client: Socket
        match socket_tcp()
            Ok(s) => client = s
            Err(_) => sys_exit(1)
        client.connect("127.0.0.1", port)

        var i: i32 = 0
        while i < 5
            # Send message
            var send_buf: [8]u8
            send_buf[0] = (65 + i) as u8  # A, B, C, D, E
            send_buf[1] = 10              # newline
            sys_write(client.raw(), @send_buf[0], 2)

            # Read echo
            var recv_buf: [8]u8
            sys_read(client.raw(), @recv_buf[0], 2)

            # Verify
            if recv_buf[0] != send_buf[0]
                sys_exit(i + 1)

            i += 1

        client.close()
        sys_exit(0)
    else
        # Parent: server - echo multiple messages
        var client: Socket = match runtime_accept(@&rt, @server)
            Ok(c) => c
            Err(_) => socket_from_raw(-1)

        var i: i32 = 0
        while i < 5
            var buf: [8]u8
            let n: i64 = match runtime_recv(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (8) as i64 })
                Ok(v) => v
                Err(_) => 0
            if n > 0
                runtime_send(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (n as i32) as i64 })
            i += 1

        client.close()

        var status: i32 = 0
        sys_wait4(pid, @status, 0, null)

        let exit_code: i32 = (status >> 8) & 255
        if exit_code != 0
            print("FAIL: client exit {exit_code as i64}\n")
            server.close()
            rt.destroy()
            return 1

    server.close()
    rt.destroy()
    print("OK\n")
    return 0

fn test_large_data() -> i32
    print("test_large_data... ")

    var rt: Runtime
    rt.init()

    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            print("FAIL: socket\n")
            rt.destroy()
            return 1
    server.set_reuseaddr()

    server.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@server)
    server.listen(1)

    let pid: i32 = sys_fork()

    if pid == 0
        # Child: client - send 1KB of data
        var ts: [16]u8
        let ts_ptr: *i64 = @ts[0] as *i64
        *ts_ptr = 0
        *(ts_ptr + 1) = 10000000
        sys_nanosleep(@ts[0] as *i64, null)

        var client: Socket
        match socket_tcp()
            Ok(s) => client = s
            Err(_) => sys_exit(1)
        client.connect("127.0.0.1", port)

        # Send 1KB of pattern data
        var send_buf: [1024]u8
        var i: i32 = 0
        while i < 1024
            send_buf[i] = (i % 256) as u8
            i += 1

        sys_write(client.raw(), @send_buf[0], 1024)

        # Read echo
        var recv_buf: [1024]u8
        var total: i64 = 0
        while total < 1024
            let n: i64 = sys_read(client.raw(), @recv_buf[0] + total, 1024 - total)
            if n <= 0
                break
            total += n

        client.close()

        # Verify
        if total != 1024
            sys_exit(1)

        i = 0
        while i < 1024
            if recv_buf[i] != send_buf[i]
                sys_exit(2)
            i += 1

        sys_exit(0)
    else
        # Parent: server
        var client: Socket = match runtime_accept(@&rt, @server)
            Ok(c) => c
            Err(_) => socket_from_raw(-1)

        # Echo all data
        var buf: [4096]u8
        var total: i64 = 0
        while total < 1024
            let n: i64 = match runtime_recv(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (4096) as i64 })
                Ok(v) => v
                Err(_) => 0
            if n <= 0
                break
            runtime_send(@&rt, client.raw(), Span<u8> { ptr: (@buf[0]), len: (n as i32) as i64 })
            total += n

        client.close()

        var status: i32 = 0
        sys_wait4(pid, @status, 0, null)

        let exit_code: i32 = (status >> 8) & 255
        if exit_code != 0
            print("FAIL: exit {exit_code as i64}\n")
            server.close()
            rt.destroy()
            return 1

    server.close()
    rt.destroy()
    print("OK\n")
    return 0

# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    # Run tests
    var failures: i32 = 0

    failures += test_echo_server()
    failures += test_multiple_messages()
    failures += test_large_data()

    if failures > 0
        print("\n")
        print("{failures as i64} test(s) failed\n")
        return 1

    print("\nAll echo server tests passed!\n")
    return 0
