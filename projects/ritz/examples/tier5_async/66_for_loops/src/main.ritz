# For loop examples
#
# Demonstrates the for..in range syntax

import ritzlib.io
import ritzlib.fmt

pub fn main() -> i32
    # Exclusive range: 0..5 means 0,1,2,3,4
    print(c"Counting 0 to 4:\n")
    for i in 0..5
        print("{i as i64}\n")

    # Inclusive range: 1..=5 means 1,2,3,4,5
    print(c"\nCounting 1 to 5 (inclusive):\n")
    for i in 1..=5
        print("{i as i64}\n")

    # Sum using for loop
    var sum: i32 = 0
    for i in 1..=10
        sum += i as i32

    print(c"\nSum of 1 to 10: ")
    print("{sum as i64}\n")

    0
