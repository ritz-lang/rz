# examples/64_async_io - TRUE async I/O with async/await keywords
#
# This example ACTUALLY uses:
# - `async fn` keyword for async functions
# - `await` keyword to suspend at I/O points
# - Compiler-generated state machines (Future struct + poll fn)
# - Runtime's block_on(rt, @&p) to drive futures to completion, then `await p`
#
# This is NOT hand-written state machines - the compiler does the work, and
# there are no hand-written poll wrappers (LARB R79, AGAST #4009).

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime

# ============================================================================
# Async I/O primitives that return Poll values
# ============================================================================

# The low-level poll sources return the Poll encoding:
#   -1 (POLL_PENDING) = I/O not ready, need to wait
#   >= 0 = Ready with result value

# ============================================================================
# Test 1: Simple async fn that doesn't do I/O
# ============================================================================

async fn compute_value(x: i32) -> i32
    x * 2 + 1

fn test_simple_async() -> i32
    prints("test_simple_async... ")

    var rt: Runtime
    if rt.init() < 0
        prints("FAIL: executor init\n")
        return 1

    # Create the future using the compiler-generated constructor, drive it to
    # completion, then read the result (LARB R79)
    var p = compute_value(10)
    rt.block_on(@&p)
    let result: i32 = await p
    rt.destroy()

    # Expected: 10 * 2 + 1 = 21
    if result != 21
        prints("FAIL: expected 21, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Test 2: Async fn that awaits a poll function (returns i32 directly)
# ============================================================================

# This is a "poll function" - it returns the Poll encoding directly
# -1 = Pending, >= 0 = Ready(value)
fn double_source(x: i32) -> i32
    # Always immediately ready with x * 2
    x * 2

async fn double_then_add(x: i32) -> i32
    # await on a plain poll source (not an async fn) - this works!
    let doubled: i32 = await double_source(x)
    doubled + 5

fn test_chained_async() -> i32
    prints("test_chained_async... ")

    var rt: Runtime
    if rt.init() < 0
        prints("FAIL: executor init\n")
        return 1

    var p = double_then_add(7)
    rt.block_on(@&p)
    let result: i32 = await p
    rt.destroy()

    # Expected: 7 * 2 + 5 = 19
    if result != 19
        prints("FAIL: expected 19, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Test 3: Use block_on with compiler-generated async function
# ============================================================================

fn test_block_on_async() -> i32
    prints("test_block_on_async... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        prints("FAIL: executor init\n")
        return 1

    # Create future
    var p = compute_value(15)

    # Drive the future through its header, then read the result (LARB R79)
    rt.block_on(@&p)
    let result: i32 = await p

    rt.destroy()

    # Expected: 15 * 2 + 1 = 31
    if result != 31
        prints("FAIL: expected 31, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Test 4: Async pipe read using await
# ============================================================================

# This struct holds the async read state
struct AsyncReadState
    rt: *Runtime
    fd: i32
    buf: *u8
    len: i32

# Poll source for an async read - returns the Poll encoding
fn async_read_source(state: *AsyncReadState) -> i32
    # The first call submits the read and returns Pending; once block_on has
    # seen the completion, the next call returns its result (0 at EOF too)
    return state.rt.poll_read(state.fd, Span<u8> { ptr: (state.buf), len: (state.len) as i64 }, 0)

# Async function that reads from a file descriptor
async fn async_read_fd(state: *AsyncReadState) -> i32
    let result: i32 = await async_read_source(state)
    result

fn test_async_pipe_read() -> i32
    prints("test_async_pipe_read... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        prints("FAIL: executor init\n")
        return 1

    # Create pipe
    var fds: [2]i32
    let pipe_ret: i32 = sys_pipe(@fds[0])
    if pipe_ret < 0
        prints("FAIL: pipe\n")
        rt.destroy()
        return 1

    let read_fd: i32 = fds[0]
    let write_fd: i32 = fds[1]

    # Write data to pipe
    var write_buf: [8]u8
    write_buf[0] = 65  # 'A'
    write_buf[1] = 66  # 'B'
    write_buf[2] = 67  # 'C'
    write_buf[3] = 0
    let written: i64 = sys_write(write_fd, @write_buf[0], 3)

    # Set up read state
    var read_buf: [16]u8
    for i in 0..16
        read_buf[i] = 0

    var read_state: AsyncReadState
    read_state.rt = @rt
    read_state.fd = read_fd
    read_state.buf = @read_buf[0]
    read_state.len = 16

    # Create async future using async fn
    var p = async_read_fd(@read_state)

    # Drive the future through its header, then read the result (LARB R79)
    rt.block_on(@&p)
    let result: i32 = await p

    # Cleanup
    sys_close(read_fd)
    sys_close(write_fd)
    rt.destroy()

    if result < 0
        prints("FAIL: read error ")
        print_int(result as i64)
        prints("\n")
        return 1

    if result != 3
        prints("FAIL: expected 3 bytes, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    # Verify data
    if read_buf[0] != 65
        prints("FAIL: wrong data\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Main
# ============================================================================

fn main() -> i32
    prints("=== True Async I/O Tests ===\n")
    prints("Using async fn / await keywords with compiler-generated state machines\n\n")

    var failures: i32 = 0

    failures += test_simple_async()
    failures += test_chained_async()
    failures += test_block_on_async()
    failures += test_async_pipe_read()

    prints("\n")
    if failures > 0
        print_int(failures as i64)
        prints(" test(s) FAILED\n")
        return 1

    prints("All true async I/O tests PASSED!\n")
    return 0
