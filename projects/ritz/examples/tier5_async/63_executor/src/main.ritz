# examples/63_executor - Test the async executor with io_uring
#
# Exercises the R79 executor API: an async fn call produces a future, the
# runtime's block_on(rt, @&p) drives it to completion, and await reads the
# result.  There are no hand-written future types or poll wrappers: futures are
# compiler-generated, and the only poll sources are plain fns that return
# `Option<i32>` (`None` = Pending, `Some(v)` = Ready(v); AGAST #4558).

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.fmt

# ============================================================================
# Test 1: Direct function pointer call
# ============================================================================

struct SimpleValue
    value: i32

# A plain fn, called directly and through a fn pointer.
# The text it prints is the example's user-visible output, kept verbatim so the
# migrated binary's output matches the pre-R79 one; it is not a generated name.
fn simple_value(self_ptr: *u8) -> i32
    print("simple_poll called\n")
    let self: *SimpleValue = self_ptr as *SimpleValue
    return self.value

fn test_fn_ptr() -> i32
    print("test_fn_ptr... ")

    var value: SimpleValue
    value.value = 42

    # Direct call
    print("direct call: ")
    let r1: i32 = simple_value(@value as *u8)
    print("{r1 as i64}\n")

    # Via function pointer
    print("via pointer: ")
    let value_fn: fn(*u8) -> i32 = simple_value
    let r2: i32 = value_fn(@value as *u8)
    print("{r2 as i64}\n")

    if r1 != 42
        print("FAIL\n")
        return 1

    if r2 != 42
        print("FAIL\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 2: Simple block_on without io_uring I/O
# ============================================================================

# A poll source that is immediately Ready.
fn simple_ready(x: i32) -> Option<i32>
    print("simple_poll called\n")
    return Some(x)

async fn simple_block_on(x: i32) -> i32
    print("simple_block_on entered\n")
    let result: i32 = await simple_ready(x)
    print("simple_block_on returning\n")
    result

fn test_simple_block_on() -> i32
    print("test_simple_block_on... ")

    var rt: Runtime
    if rt.init() < 0
        print("FAIL: init failed\n")
        return 1

    var p = simple_block_on(99)
    rt.block_on(@&p)
    let result: i32 = await p
    rt.destroy()

    if result != 99
        print("FAIL: expected 99, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 3: Runtime init/destroy
# ============================================================================

fn test_executor_init() -> i32
    print("test_executor_init... ")

    var rt: Runtime
    print("calling init... ")
    let ret: i32 = rt.init()
    print("{ret as i64}\n")

    if ret < 0
        print("FAIL: init failed\n")
        return 1

    print("calling destroy... ")
    rt.destroy()
    print("done\n")

    print("OK\n")
    return 0

# ============================================================================
# Test 4: block_on with Runtime
# ============================================================================

async fn my_block_on(x: i32) -> i32
    print("my_block_on: entering\n")
    print("my_block_on: calling poll_fn\n")
    let result: i32 = await simple_ready(x)
    print("my_block_on: poll returned\n")
    result

async fn block_on_value(x: i32) -> i32
    let result: i32 = await simple_ready(x)
    result

fn test_executor_block_on() -> i32
    print("test_executor_block_on... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        print("FAIL: init failed\n")
        return 1

    # First test a local async fn
    print("calling my_block_on... ")
    var p1 = my_block_on(77)
    rt.block_on(@&p1)
    let result1: i32 = await p1
    print("local got {result1 as i64}\n")

    # Now drive a second future through block_on
    print("calling block_on_op... ")
    var p2 = block_on_value(88)
    rt.block_on(@&p2)
    let result: i32 = await p2
    print("got {result as i64}\n")

    rt.destroy()

    if result != 88
        print("FAIL: expected 88, got {result as i64}\n")
        return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 5: Pipe I/O with Runtime
# ============================================================================

struct PipeReadState
    rt: *Runtime
    fd: i32
    buf: [16]u8

# Poll source for a pipe read: runtime_poll_read submits on the first call and
# returns Some(result) once block_on has seen the completion.
fn pipe_read_source(state: *PipeReadState) -> Option<i32>
    let rt_ptr: *Runtime = state.rt
    let fd: i32 = state.fd
    let buf_ptr: *u8 = @state.buf[0]
    return rt_ptr.poll_read(fd, Span<u8> { ptr: (buf_ptr), len: (16) as i64 }, 0)

async fn async_pipe_read(state: *PipeReadState) -> i32
    let result: i32 = await pipe_read_source(state)
    result

fn test_pipe_io() -> i32
    print("test_pipe_io... ")

    var rt: Runtime
    let init_ret: i32 = rt.init()
    if init_ret < 0
        print("FAIL: executor init failed\n")
        return 1

    # Create a pipe
    var fds: [2]i32
    let pipe_ret: i32 = sys_pipe(@fds[0])
    if pipe_ret < 0
        print("FAIL: pipe creation failed\n")
        rt.destroy()
        return 1

    let read_fd: i32 = fds[0]
    let write_fd: i32 = fds[1]

    # Write some data to the pipe first
    var write_buf: [8]u8
    write_buf[0] = 72   # 'H'
    write_buf[1] = 101  # 'e'
    write_buf[2] = 108  # 'l'
    write_buf[3] = 108  # 'l'
    write_buf[4] = 111  # 'o'
    write_buf[5] = 0
    let written: i64 = sys_write(write_fd, @write_buf[0], 5)

    # Create the read state
    var state: PipeReadState
    state.rt = @rt
    state.fd = read_fd

    # Zero the buffer
    var i: i32 = 0
    while i < 16
        state.buf[i] = 0
        i += 1

    # Run the future
    var p = async_pipe_read(@state)
    rt.block_on(@&p)
    let result: i32 = await p

    # Clean up
    sys_close(read_fd)
    sys_close(write_fd)
    rt.destroy()

    if result < 0
        print("FAIL: read returned error {result as i64}\n")
        return 1

    if result != 5
        print("FAIL: expected 5 bytes, got {result as i64}\n")
        return 1

    # Verify data
    if state.buf[0] != 72
        print("FAIL: wrong data read\n")
        return 1

    print("OK\n")
    return 0

pub fn main() -> i32
    print("=== Executor Tests ===\n\n")

    var failures: i32 = 0

    failures += test_fn_ptr()
    failures += test_simple_block_on()
    failures += test_executor_init()
    failures += test_executor_block_on()
    failures += test_pipe_io()

    print("\n")
    if failures > 0
        print("{failures as i64} test(s) FAILED\n")
        return 1

    print("All executor tests PASSED!\n")
    return 0
