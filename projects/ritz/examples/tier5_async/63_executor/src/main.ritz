# examples/63_executor - Test the async executor with io_uring
#
# Minimal test to debug function pointer calls in executor

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime

# legacy (pre-R79): poll-fn driver; migration is #4009
# The hand-written futures in this example (SimpleFuture, PipeReadFuture) are
# not compiler-generated, so they do not fit @&Future.  They keep the old
# i32 poll loop until #4009 rewrites them.
fn block_on_op(rt: *Runtime, future_ptr: *u8, poll_fn: fn(*u8) -> i32) -> i32
    var completed: i32 = 0
    var result: i32 = 0

    while completed == 0
        rt.took_pending_code = 0
        result = poll_fn(future_ptr)

        if result != POLL_PENDING
            completed = 1
        else
            if rt.took_pending_code != 0 and rt.waker_active == 0
                completed = 1   # Ready(-EPERM)
            else if rt.waker_active != 0
                let wait_result: i32 = runtime_wait_for_io(rt)
                if wait_result < 0
                    result = wait_result
                    completed = 1
            else
                result = -22  # EINVAL
                completed = 1

    return result

# ============================================================================
# Test 1: Direct function pointer call
# ============================================================================

struct SimpleFuture
    value: i32

fn simple_poll(self_ptr: *u8) -> i32
    prints("simple_poll called\n")
    let self: *SimpleFuture = self_ptr as *SimpleFuture
    return self.value

fn test_fn_ptr() -> i32
    prints("test_fn_ptr... ")

    var future: SimpleFuture
    future.value = 42

    # Direct call
    prints("direct call: ")
    let r1: i32 = simple_poll(@future as *u8)
    print_int(r1 as i64)
    prints("\n")

    # Via function pointer
    prints("via pointer: ")
    let poll_fn: fn(*u8) -> i32 = simple_poll
    let r2: i32 = poll_fn(@future as *u8)
    print_int(r2 as i64)
    prints("\n")

    if r1 != 42
        prints("FAIL\n")
        return 1

    if r2 != 42
        prints("FAIL\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Test 2: Simple block_on without io_uring
# ============================================================================

fn simple_block_on(future_ptr: *u8, poll_fn: fn(*u8) -> i32) -> i32
    prints("simple_block_on entered\n")
    let result: i32 = poll_fn(future_ptr)
    prints("simple_block_on returning\n")
    return result

fn test_simple_block_on() -> i32
    prints("test_simple_block_on... ")

    var future: SimpleFuture
    future.value = 99

    let poll_fn: fn(*u8) -> i32 = simple_poll
    let result: i32 = simple_block_on(@future as *u8, poll_fn)

    if result != 99
        prints("FAIL: expected 99, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Main
# ============================================================================

# ============================================================================
# Test 3: Runtime init/destroy
# ============================================================================

fn test_executor_init() -> i32
    prints("test_executor_init... ")

    var rt: Runtime
    prints("calling init... ")
    let ret: i32 = runtime_init(@rt)
    print_int(ret as i64)
    prints("\n")

    if ret < 0
        prints("FAIL: init failed\n")
        return 1

    prints("calling destroy... ")
    runtime_destroy(@rt)
    prints("done\n")

    prints("OK\n")
    return 0

# ============================================================================
# Test 4: block_on with Runtime
# ============================================================================

fn my_block_on(rt: *Runtime, future_ptr: *u8, poll_fn: fn(*u8) -> i32) -> i32
    prints("my_block_on: entering\n")
    prints("my_block_on: calling poll_fn\n")
    let result: i32 = poll_fn(future_ptr)
    prints("my_block_on: poll returned\n")
    return result

fn test_executor_block_on() -> i32
    prints("test_executor_block_on... ")

    var rt: Runtime
    let init_ret: i32 = runtime_init(@rt)
    if init_ret < 0
        prints("FAIL: init failed\n")
        return 1

    var future: SimpleFuture
    future.value = 77

    # First test local block_on
    prints("calling my_block_on... ")
    let poll_fn1: fn(*u8) -> i32 = simple_poll
    let result1: i32 = my_block_on(@rt, @future as *u8, poll_fn1)
    prints("local got ")
    print_int(result1 as i64)
    prints("\n")

    # Now test the legacy poll-fn driver (the imported block_on takes @&Future,
    # and SimpleFuture is hand-written, so it cannot fit; #4009 rewrites this).
    future.value = 88  # Different value
    prints("calling block_on_op... ")
    let poll_fn2: fn(*u8) -> i32 = simple_poll
    let result: i32 = block_on_op(@rt, @future as *u8, poll_fn2)
    prints("got ")
    print_int(result as i64)
    prints("\n")

    runtime_destroy(@rt)

    if result != 88
        prints("FAIL: expected 88, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    prints("OK\n")
    return 0

# ============================================================================
# Test 5: Pipe I/O with Runtime
# ============================================================================

struct PipeReadFuture
    state: i32
    rt: *Runtime
    read_fd: i32
    buf: [16]u8
    bytes_read: i32

fn piperead_poll(self_ptr: *u8) -> i32
    let self: *PipeReadFuture = self_ptr as *PipeReadFuture

    if self.state == 0
        # State 0: Submit read request
        let rt_ptr: *Runtime = self.rt
        let fd: i32 = self.read_fd
        let buf_ptr: *u8 = @self.buf[0]
        let result: i32 = runtime_poll_read(rt_ptr, fd, Span<u8> { ptr: (buf_ptr), len: (16) as i64 }, 0)

        if result == POLL_PENDING
            self.state = 1
            return POLL_PENDING

        # Immediate result
        self.bytes_read = result
        self.state = 2
        return result

    if self.state == 1
        # State 1: block_on polls again once the read has completed, and
        # runtime_poll_read hands over its result, whatever the value (0 at EOF)
        let rt_ptr: *Runtime = self.rt
        let fd: i32 = self.read_fd
        let buf_ptr: *u8 = @self.buf[0]
        let result: i32 = runtime_poll_read(rt_ptr, fd, Span<u8> { ptr: (buf_ptr), len: (16) as i64 }, 0)
        if result == POLL_PENDING and rt_ptr.waker_active != 0
            return POLL_PENDING
        self.bytes_read = result
        self.state = 2
        return result

    # State 2: Already completed
    return self.bytes_read

fn test_pipe_io() -> i32
    prints("test_pipe_io... ")

    var rt: Runtime
    let init_ret: i32 = runtime_init(@rt)
    if init_ret < 0
        prints("FAIL: executor init failed\n")
        return 1

    # Create a pipe
    var fds: [2]i32
    let pipe_ret: i32 = sys_pipe(@fds[0])
    if pipe_ret < 0
        prints("FAIL: pipe creation failed\n")
        runtime_destroy(@rt)
        return 1

    let read_fd: i32 = fds[0]
    let write_fd: i32 = fds[1]

    # Write some data to the pipe first
    var write_buf: [8]u8
    write_buf[0] = 72   # 'H'
    write_buf[1] = 101  # 'e'
    write_buf[2] = 108  # 'l'
    write_buf[3] = 108  # 'l'
    write_buf[4] = 111  # 'o'
    write_buf[5] = 0
    let written: i64 = sys_write(write_fd, @write_buf[0], 5)

    # Create the future
    var future: PipeReadFuture
    future.state = 0
    future.rt = @rt
    future.read_fd = read_fd
    future.bytes_read = 0

    # Zero the buffer
    var i: i32 = 0
    while i < 16
        future.buf[i] = 0
        i += 1

    # Run the future
    let poll_fn: fn(*u8) -> i32 = piperead_poll
    let result: i32 = block_on_op(@rt, @future as *u8, poll_fn)

    # Clean up
    sys_close(read_fd)
    sys_close(write_fd)
    runtime_destroy(@rt)

    if result < 0
        prints("FAIL: read returned error ")
        print_int(result as i64)
        prints("\n")
        return 1

    if result != 5
        prints("FAIL: expected 5 bytes, got ")
        print_int(result as i64)
        prints("\n")
        return 1

    # Verify data
    if future.buf[0] != 72
        prints("FAIL: wrong data read\n")
        return 1

    prints("OK\n")
    return 0

fn main() -> i32
    prints("=== Executor Tests ===\n\n")

    var failures: i32 = 0

    failures += test_fn_ptr()
    failures += test_simple_block_on()
    failures += test_executor_init()
    failures += test_executor_block_on()
    failures += test_pipe_io()

    prints("\n")
    if failures > 0
        print_int(failures as i64)
        prints(" test(s) FAILED\n")
        return 1

    prints("All executor tests PASSED!\n")
    return 0
