# examples/59_async_net/main.ritz - TCP networking tests with io_uring
#
# Tests TCP socket operations using io_uring for efficient I/O.
#
# Note: This tests the io_uring-based runtime functions (runtime_accept,
# runtime_send, runtime_recv) which use io_uring under the hood. While
# efficient, these are synchronous wrappers - not async/await syntax.
# True async/await networking would require the full async runtime with
# proper Future types and an executor. That's planned for Phase 12 (Valet).

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.async_net
import ritzlib.fmt
import ritzlib.span
import ritzlib.fd { Fd, fd_borrow }
import ritzlib.process { fork, wait_pid }
import ritzlib.time { sleep_ms }

# ============================================================================
# Test helpers
# ============================================================================

fn assert_true(cond: i32, msg: *u8) -> i32
    if cond == 0
        print("FAIL: {msg}\n")
        return 1
    return 0

fn assert_ge(a: i32, b: i32, msg: *u8) -> i32
    if a < b
        print("FAIL: {msg} (got {a as i64}, expected >= {b as i64})\n")
        return 1
    return 0

# The port a bound socket was given.  The self-tests below bind port 0 so the
# kernel picks a free one: a fixed port failed (or hung) whenever anything else
# on the host held it, e.g. two gates sharing a machine (AGAST #3136).
fn bound_port(sock: @Socket) -> i32
    match sock.local_port()
        Ok(p) => return p
        Err(_) => return -1

# A connected client socket's read(2), as the byte count or -errno.  The
# borrowed Fd reads into a caller's buffer; the Socket keeps ownership.
fn sock_read(sock: @Socket, buf: Span<u8>) -> i64
    let io: Fd = fd_borrow(sock.raw())
    match io.read(buf)
        Ok(n) => n
        Err(e) => -(e.code() as i64)

# fork(): 0 in the child, the child's pid in the parent, -1 if it failed.
fn fork_pid() -> i32
    match fork()
        Ok(fr) =>
            match fr
                Child => 0
                Parent(pid) => pid
        Err(_) => -1

# ============================================================================
# Test 1: Create and close a TCP socket
# ============================================================================

fn test_socket_create() -> i32
    print("test_socket_create... ")

    # Create a TCP socket
    var sock: Socket = match socket_tcp()
        Ok(s) => s
        Err(e) =>
            let code: i32 = e.code()
            print("FAIL: socket creation failed with {code as i64}\n")
            return 1

    # Close it
    sock.close()

    print("OK\n")
    return 0

# ============================================================================
# Test 2: Bind socket to address
# ============================================================================

fn test_socket_bind() -> i32
    print("test_socket_bind... ")

    var sock: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            print("FAIL: socket creation failed\n")
            return 1

    # Bind to 0.0.0.0:0 (kernel assigns port)
    match sock.bind("0.0.0.0", 0)
        Ok(_) => pass
        Err(e) =>
            let code: i32 = e.code()
            print("FAIL: bind failed with {code as i64}\n")
            sock.close()
            return 1

    sock.close()
    print("OK\n")
    return 0

# ============================================================================
# Test 3: Listen on socket
# ============================================================================

fn test_socket_listen() -> i32
    print("test_socket_listen... ")

    var sock: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) => return 1

    # Enable address reuse
    match sock.set_reuseaddr()
        Ok(_) => pass
        Err(_) =>
            print("FAIL: setsockopt failed\n")
            sock.close()
            return 1

    match sock.bind("0.0.0.0", 0)
        Ok(_) => pass
        Err(_) =>
            sock.close()
            return 1

    match sock.listen(128)
        Ok(_) => pass
        Err(e) =>
            let code: i32 = e.code()
            print("FAIL: listen failed with {code as i64}\n")
            sock.close()
            return 1

    sock.close()
    print("OK\n")
    return 0

# ============================================================================
# Test 4: Connect to localhost (fork a server)
# ============================================================================

fn test_connect_localhost() -> i32
    print("test_connect_localhost... ")

    # Create server socket
    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) => return 1

    server.set_reuseaddr()

    # Bind to localhost on a port the kernel picks
    match server.bind("127.0.0.1", 0)
        Ok(_) => pass
        Err(_) =>
            print("FAIL: server bind failed\n")
            server.close()
            return 1
    let port: i32 = bound_port(@server)

    match server.listen(1)
        Ok(_) => pass
        Err(_) =>
            print("FAIL: listen failed\n")
            server.close()
            return 1

    # Fork - child will connect, parent will accept
    let pid: i32 = fork_pid()

    if pid == 0
        # Child: connect to server
        var client: Socket
        match socket_tcp()
            Ok(s) => client = s
            Err(_) => sys_exit(1)
        match client.connect("127.0.0.1", port)
            Ok(_) => pass
            Err(_) => sys_exit(1)

        # Send a byte
        var msg: [4]u8
        msg[0] = 72  # 'H'
        msg[1] = 105 # 'i'
        msg[2] = 0
        client.send(Span<u8> { ptr: @msg[0], len: 2 })

        client.close()
        sys_exit(0)
    else
        # Parent: accept connection
        var client: Socket = match server.accept()
            Ok(c) => c
            Err(e) =>
                let code: i32 = e.code()
                print("FAIL: accept failed with {code as i64}\n")
                server.close()
                return 1

        # Read the message
        var buf: [16]u8
        let n: i64 = sock_read(@client, Span<u8> { ptr: @buf[0], len: 16 })

        # Wait for child
        wait_pid(pid)

        client.close()
        server.close()

        if n != 2
            print("FAIL: expected 2 bytes, got {n}\n")
            return 1

        if buf[0] != 72
            print("FAIL: wrong data received\n")
            return 1

    print("OK\n")
    return 0

# ============================================================================
# Test 5: Async accept via io_uring
# ============================================================================

# Runtime.new failed: say why; one test failed.
fn no_runtime(e: Errno) -> i32
    print("FAIL: runtime init failed ({e.name()})\n")
    1

fn test_async_accept() -> i32
    print("test_async_accept... ")

    # Initialize runtime
    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime(e)

    # Create server socket
    var server: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) =>
            rt.destroy()
            return 1

    server.set_reuseaddr()

    server.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@server)
    server.listen(1)

    # Fork - child connects
    let pid: i32 = fork_pid()

    if pid == 0
        # Child: connect
        # Small delay to let parent setup accept
        sleep_ms(10)

        var client: Socket
        match socket_tcp()
            Ok(s) => client = s
            Err(_) => sys_exit(1)
        client.connect("127.0.0.1", port)
        client.close()
        sys_exit(0)
    else
        # Parent: async accept via io_uring
        let accepted: Result<Socket, Errno> = runtime_accept(@&rt, @server)

        # Wait for child
        wait_pid(pid)

        var client: Socket = match accepted
            Ok(c) => c
            Err(_) =>
                print("FAIL: async accept failed\n")
                server.close()
                rt.destroy()
                return 1

        client.close()

    server.close()
    rt.destroy()
    print("OK\n")
    return 0

# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    var failures: i32 = 0

    failures += test_socket_create()
    failures += test_socket_bind()
    failures += test_socket_listen()
    failures += test_connect_localhost()
    failures += test_async_accept()

    if failures > 0
        print("\n")
        print("{failures as i64} test(s) failed\n")
        return 1

    print("\nAll async_net tests passed!\n")
    return 0
