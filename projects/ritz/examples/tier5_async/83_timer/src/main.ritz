# Example 83: timer — ritzlib.timer, printing only deterministic facts
#
# ritzlib.timer had no importing example, so neither differential
# ritz0-vs-ritz1 stage exercised it (AGAST #1463).  Times differ on every run,
# so this prints only properties that hold on any run: return codes, ranges,
# ordering.  It never prints a time.
#
# It drives the public API: clock_gettime and the CLOCK_* / NANOS_PER_*
# consts, now_nanos/micros/millis, timer_new/start/stop/elapsed_*, and the
# stopwatch fns (AGAST #3732 made them `pub`).  clock_gettime and
# Timer.start/stop return a Result (AGAST #4930), so the golden prints ok-ness,
# not a status code.  timer_print and
# stopwatch_print print times, so they are not called.
#
# The golden stdout is pinned by test.sh.  Checks with no line of their own
# (the elapsed_* conversions, the stopwatch's start/stop/count rules) report
# on stderr and make main return 1, which test.sh refuses.

import ritzlib.sys
import ritzlib.io
import ritzlib.errno
import ritzlib.timer

fn b(v: bool) -> i64
    if v
        return 1
    return 0

# Report a failed silent check on stderr; returns 1 so callers can sum them.
fn check(ok: bool, what: StrView) -> i32
    if ok
        return 0
    eprint("FAIL: {what}\n")
    return 1

fn main() -> i32
    var fails: i32 = 0

    let mono_now: Result<Timespec, Errno> = clock_gettime(CLOCK_MONOTONIC)
    print("clock_gettime(MONOTONIC) ok: {b(mono_now.is_ok())}\n")
    var ts: Timespec = Timespec { tv_sec: -1, tv_nsec: -1 }
    match mono_now
        Ok(got) => ts = got
        Err(_) =>
            fails += 1
    print("tv_nsec in [0, 1e9): {b(ts.tv_nsec >= 0 and ts.tv_nsec < NANOS_PER_SEC)}\n")

    # timer_new zeroes both ends.
    var t: Timer = timer_new()
    let zeroed: bool = t.start.tv_sec == 0 and t.start.tv_nsec == 0 and t.end.tv_sec == 0 and t.end.tv_nsec == 0
    print("timer_new zeroes start/end: {b(zeroed)}\n")

    # Start, do some work, stop.
    let rs: bool = (t.start()).is_ok()
    var acc: i64 = 0
    var i: i64 = 0
    while i < 10000
        acc += i
        i += 1
    let re: bool = (t.stop()).is_ok()
    print("start/stop ok: {b(rs)} {b(re)}\n")
    let s: i64 = t.start.tv_sec * NANOS_PER_SEC + t.start.tv_nsec
    let e: i64 = t.end.tv_sec * NANOS_PER_SEC + t.end.tv_nsec
    print("end >= start: {b(e >= s)}\n")
    let ns: i64 = t.elapsed_nanos()
    print("elapsed >= 0: {b(ns >= 0 and acc > 0)}\n")
    fails += check(ns == e - s, "timer_elapsed_nanos == end - start")
    fails += check(t.elapsed_micros() == ns / NANOS_PER_MICRO, "timer_elapsed_micros")
    fails += check(t.elapsed_millis() == ns / NANOS_PER_MILLI, "timer_elapsed_millis")
    fails += check(t.elapsed_secs_x1000() >= 0, "timer_elapsed_secs_x1000 >= 0")

    # A real run is too short to tell the units apart, so check the
    # conversions on a fixed span: 2s + 345678912ns.
    var f: Timer = timer_new()
    f.start.tv_sec = 10
    f.start.tv_nsec = 100000000
    f.end.tv_sec = 12
    f.end.tv_nsec = 445678912
    fails += check(f.elapsed_nanos() == 2345678912, "fixed timer_elapsed_nanos")
    fails += check(f.elapsed_micros() == 2345678, "fixed timer_elapsed_micros")
    fails += check(f.elapsed_millis() == 2345, "fixed timer_elapsed_millis")

    # CLOCK_MONOTONIC never goes backwards.
    var prev: i64 = 0
    var mono: bool = true
    i = 0
    while i < 1000
        let now: i64 = now_nanos()
        if now < prev
            mono = false
        prev = now
        i += 1
    print("monotonic over 1000 reads: {b(mono)}\n")
    # The coarser units read later, so they are >= the last nanos reading.
    fails += check(now_micros() >= prev / NANOS_PER_MICRO, "now_micros monotonic")
    fails += check(now_millis() >= prev / NANOS_PER_MILLI, "now_millis monotonic")

    # Wall clock: 1577836800 is 2020-01-01T00:00:00Z.
    var wall: i64 = 0
    match clock_gettime(CLOCK_REALTIME)
        Ok(got) => wall = got.tv_sec
        Err(_) =>
            fails += 1
    print("CLOCK_REALTIME after 2020: {b(wall > 1577836800)}\n")

    # An invalid clock id is rejected by the kernel (EINVAL).
    var einval: bool = false
    match clock_gettime(12345)
        Ok(_) => einval = false
        Err(err) => einval = err.code() == 22
    print("bad clock id is EINVAL: {b(einval)}\n")

    var sw: Stopwatch = stopwatch_new()
    let swz: bool = sw.total_ns == 0 and sw.count == 0 and sw.running == 0 and sw.start_ns == 0
    print("stopwatch_new zeroes: {b(swz)}\n")

    # Stopwatch rules: stop before start and a second start are refused;
    # each start/stop pair adds one to the count.
    fails += check(not sw.stop(), "stopwatch_stop while stopped is false")
    fails += check(sw.start(), "stopwatch_start true")
    fails += check(not sw.start(), "stopwatch_start while running is false")
    fails += check(sw.stop(), "stopwatch_stop true")
    sw.start()
    sw.stop()
    fails += check(sw.count() == 2, "stopwatch_count == 2")
    fails += check(sw.total_nanos() >= 0, "stopwatch_total_nanos >= 0")
    fails += check(sw.avg_nanos() == sw.total_nanos() / 2, "stopwatch_avg_nanos")
    sw.reset()
    fails += check(sw.count() == 0 and sw.avg_nanos() == 0, "stopwatch_reset")

    if fails != 0
        return 1
    return 0
