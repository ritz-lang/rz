# 52_uring: io_uring async I/O tests
#
# Tests the io_uring bindings in ritzlib/uring.ritz:
# - Ring initialization and teardown
# - Basic NOP submission
# - Async file read
# - Async file write

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.uring
import ritzlib.str
import ritzlib.os.env

# Build "$TMPDIR/<stem>_<pid>.txt" into buf (>= 512 bytes) and return buf;
# TMPDIR unset, empty or overlong means /tmp.  Concurrent runs of this binary
# -- two gates on one host, or two stages of one gate -- must never share a
# file: with a fixed /tmp name one run's unlink landed between another's
# write and read, and regression Stage 1 flaked (AGAST #4207).
fn scratch_path(buf: *u8, stem: *u8) -> *u8
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    memcpy(buf, dir.ptr, dir.len)
    *(buf + dir.len) = 0
    strcat(buf, c"/")
    strcat(buf, stem)
    strcat(buf, c"_")
    itoa(sys_getpid() as i64, buf + strlen(buf))
    strcat(buf, c".txt")
    buf

# Test 1: Initialize and destroy an io_uring instance
fn test_uring_init() -> bool
    print("test_uring_init... ")

    var ring: IoUring
    let ret: i32 = ring.init(32)

    if ret < 0
        print("FAIL: uring_init returned {ret}\n")
        return false

    # Verify we got a valid ring fd
    if ring.ring_fd < 0
        print("FAIL: invalid ring_fd\n")
        ring.destroy()
        return false

    # Verify queue sizes are reasonable
    if ring.sq_entries < 32
        print("FAIL: sq_entries too small\n")
        ring.destroy()
        return false

    if ring.cq_entries < 32
        print("FAIL: cq_entries too small\n")
        ring.destroy()
        return false

    # Clean up
    ring.destroy()

    print("OK\n")
    return true

# Test 2: Submit a NOP operation
fn test_uring_nop() -> bool
    print("test_uring_nop... ")

    var ring: IoUring
    let ret: i32 = ring.init(32)
    if ret < 0
        print("FAIL: uring_init\n")
        return false

    # Get an SQE
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: uring_get_sqe returned null\n")
            ring.destroy()
            return false

    # Prepare a NOP
    sqe.opcode = IORING_OP_NOP
    sqe.flags = 0
    sqe.ioprio = 0
    sqe.fd = 0
    sqe.off = 0
    sqe.addr = 0
    sqe.len = 0
    sqe.rw_flags = 0
    sqe.user_data = 42  # Marker to verify completion
    sqe.buf_index = 0
    sqe.personality = 0
    sqe.splice_fd_in = 0
    sqe.pad1 = 0
    sqe.pad2 = 0

    # Advance the tail
    ring.sqe_submit()

    # Submit and wait for completion
    let submit_ret: i32 = ring.submit_and_wait(1)
    if submit_ret < 0
        print("FAIL: uring_submit_and_wait returned {submit_ret}\n")
        ring.destroy()
        return false

    # Get the completion
    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE available\n")
            ring.destroy()
            return false

    # Verify user_data came back correctly
    if cqe.user_data != 42
        print("FAIL: user_data mismatch\n")
        ring.destroy()
        return false

    # NOP should return 0
    if cqe.res != 0
        print("FAIL: NOP result was {cqe.res}\n")
        ring.destroy()
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()

    print("OK\n")
    return true

# Test 3: Async write to a file
fn test_uring_write() -> bool
    print("test_uring_write... ")

    # Create a temp file for testing
    var path_buf: [512]u8
    let path: *u8 = scratch_path(@path_buf[0], c"ritz_uring_test")
    let fd: i32 = sys_open3(path, O_CREAT | O_RDWR | O_TRUNC, 420)
    if fd < 0
        print("FAIL: couldn't create temp file\n")
        return false

    var ring: IoUring
    let ret: i32 = ring.init(32)
    if ret < 0
        print("FAIL: uring_init\n")
        sys_close(fd)
        return false

    # Prepare write data
    var data: [16]u8
    data[0] = 72   # H
    data[1] = 101  # e
    data[2] = 108  # l
    data[3] = 108  # l
    data[4] = 111  # o
    data[5] = 10   # \n

    # Get SQE and prep write
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: couldn't get SQE\n")
            ring.destroy()
            sys_close(fd)
            return false

    sqe.prep_write(fd, @data[0], 6, 0, 100)
    ring.sqe_submit()

    # Submit and wait
    let submit_ret: i32 = ring.submit_and_wait(1)
    if submit_ret < 0
        print("FAIL: submit_and_wait\n")
        ring.destroy()
        sys_close(fd)
        return false

    # Check completion
    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE\n")
            ring.destroy()
            sys_close(fd)
            return false

    if cqe.res != 6
        print("FAIL: wrote {cqe.res} bytes instead of 6\n")
        ring.destroy()
        sys_close(fd)
        sys_unlink(path)
        return false

    if cqe.user_data != 100
        print("FAIL: user_data mismatch\n")
        ring.destroy()
        sys_close(fd)
        sys_unlink(path)
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()
    sys_close(fd)
    sys_unlink(path)

    print("OK\n")
    return true

# Test 4: Async read from a file
fn test_uring_read() -> bool
    print("test_uring_read... ")

    # Create a temp file with known content
    var path_buf: [512]u8
    let path: *u8 = scratch_path(@path_buf[0], c"ritz_uring_read_test")
    let fd: i32 = sys_open3(path, O_CREAT | O_RDWR | O_TRUNC, 420)
    if fd < 0
        print("FAIL: couldn't create temp file\n")
        return false

    # Write some data synchronously first
    var data: [8]u8
    data[0] = 84   # T
    data[1] = 101  # e
    data[2] = 115  # s
    data[3] = 116  # t
    data[4] = 10   # \n
    sys_write(fd, @data[0], 5)

    # Seek back to beginning
    sys_lseek(fd, 0, 0)

    # Now read with io_uring
    var ring: IoUring
    let ret: i32 = ring.init(32)
    if ret < 0
        print("FAIL: uring_init\n")
        sys_close(fd)
        sys_unlink(path)
        return false

    var buf: [16]u8
    var i: i64 = 0
    while i < 16
        buf[i] = 0
        i += 1

    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: couldn't get SQE\n")
            ring.destroy()
            sys_close(fd)
            sys_unlink(path)
            return false

    sqe.prep_read(fd, @buf[0], 16, 0, 200)
    ring.sqe_submit()

    let submit_ret: i32 = ring.submit_and_wait(1)
    if submit_ret < 0
        print("FAIL: submit_and_wait\n")
        ring.destroy()
        sys_close(fd)
        sys_unlink(path)
        return false

    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE\n")
            ring.destroy()
            sys_close(fd)
            sys_unlink(path)
            return false

    if cqe.res != 5
        print("FAIL: read {cqe.res} bytes instead of 5\n")
        ring.destroy()
        sys_close(fd)
        sys_unlink(path)
        return false

    # Verify content
    if buf[0] != 84 or buf[1] != 101 or buf[2] != 115 or buf[3] != 116
        print("FAIL: content mismatch\n")
        ring.destroy()
        sys_close(fd)
        sys_unlink(path)
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()
    sys_close(fd)
    sys_unlink(path)

    print("OK\n")
    return true

pub fn main() -> i32
    print("=== io_uring tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_uring_init()
        passed += 1
    else
        failed += 1

    if test_uring_nop()
        passed += 1
    else
        failed += 1

    if test_uring_write()
        passed += 1
    else
        failed += 1

    if test_uring_read()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed} passed, {failed} failed\n")

    if failed > 0
        return 1
    return 0
