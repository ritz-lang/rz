# 52_uring: io_uring async I/O tests
#
# Tests the io_uring bindings in ritzlib/uring.ritz:
# - Ring initialization and teardown
# - Basic NOP submission
# - Async file read
# - Async file write

import ritzlib.process { process_id }
import ritzlib.io
import ritzlib.fmt
import ritzlib.uring
import ritzlib.span
import ritzlib.result
import ritzlib.errno { Errno }
import ritzlib.str
import ritzlib.os.env
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new }
import ritzlib.fd { Fd, fd_open, O_CREAT, O_RDWR, O_TRUNC, SEEK_SET }
import ritzlib.fs { unlink }

# "$TMPDIR/<stem>_<pid>.txt"; TMPDIR unset, empty or overlong means /tmp.
# Concurrent runs of this binary -- two gates on one host, or two stages of
# one gate -- must never share a file: with a fixed /tmp name one run's
# unlink landed between another's write and read, and regression Stage 1
# flaked (AGAST #4207).
fn scratch_path(stem: StrView) -> String
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    var path: String = string_new()
    path.push_str(dir)
    path.push_str("/")
    path.push_str(stem)
    path.push_str("_")
    path.push_i64(process_id() as i64)
    path.push_str(".txt")
    path

# Close the test file and delete it.
fn drop_scratch(f: @&Fd, path: @String)
    f.close()
    unlink(path.as_view())

# IoUring.new failed: say why; the test fails.
fn no_ring(e: Errno) -> bool
    print("FAIL: IoUring.new: {e.name()}\n")
    false

# IoUring.new failed with the test file `f` open: close it, and fail.
fn no_ring_closing(f: @&Fd, e: Errno) -> bool
    f.close()
    no_ring(e)

# IoUring.new failed with the test file at `path` made: delete it, and fail.
fn no_ring_dropping(f: @&Fd, path: @String, e: Errno) -> bool
    drop_scratch(f, path)
    no_ring(e)

# Test 1: Initialize and destroy an io_uring instance
fn test_uring_init() -> bool
    print("test_uring_init... ")

    var ring: IoUring = match IoUring.new(32)
        Ok(r) => r
        Err(e) => return no_ring(e)

    # Verify we got a valid ring fd
    if ring.ring_fd < 0
        print("FAIL: invalid ring_fd\n")
        ring.destroy()
        return false

    # Verify queue sizes are reasonable
    if ring.sq_entries < 32
        print("FAIL: sq_entries too small\n")
        ring.destroy()
        return false

    if ring.cq_entries < 32
        print("FAIL: cq_entries too small\n")
        ring.destroy()
        return false

    # Clean up
    ring.destroy()

    print("OK\n")
    return true

# Test 2: Submit a NOP operation
fn test_uring_nop() -> bool
    print("test_uring_nop... ")

    var ring: IoUring = match IoUring.new(32)
        Ok(r) => r
        Err(e) => return no_ring(e)

    # Get an SQE
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: uring_get_sqe returned null\n")
            ring.destroy()
            return false

    # Prepare a NOP
    sqe.opcode = IORING_OP_NOP
    sqe.flags = 0
    sqe.ioprio = 0
    sqe.fd = 0
    sqe.off = 0
    sqe.addr = 0
    sqe.len = 0
    sqe.rw_flags = 0
    sqe.user_data = 42  # Marker to verify completion
    sqe.buf_index = 0
    sqe.personality = 0
    sqe.splice_fd_in = 0
    sqe.pad1 = 0
    sqe.pad2 = 0

    # Advance the tail
    ring.sqe_submit()

    # Submit and wait for completion
    var submit_err: i32 = 0
    match ring.submit_and_wait(1)
        Ok(_) => pass
        Err(e) => submit_err = e.code()
    if submit_err != 0
        print("FAIL: uring_submit_and_wait failed, errno {submit_err}\n")
        ring.destroy()
        return false

    # Get the completion
    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE available\n")
            ring.destroy()
            return false

    # Verify user_data came back correctly
    if cqe.user_data != 42
        print("FAIL: user_data mismatch\n")
        ring.destroy()
        return false

    # NOP should return 0
    if cqe.res != 0
        print("FAIL: NOP result was {cqe.res}\n")
        ring.destroy()
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()

    print("OK\n")
    return true

# Test 3: Async write to a file
fn test_uring_write() -> bool
    print("test_uring_write... ")

    # Create a temp file for testing
    let path: String = scratch_path("ritz_uring_test")
    var f: Fd = match fd_open(path.as_view(), O_CREAT | O_RDWR | O_TRUNC, 420)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: couldn't create temp file\n")
            return false

    var ring: IoUring = match IoUring.new(32)
        Ok(r) => r
        Err(e) => return no_ring_closing(@&f, e)

    # Prepare write data
    var data: [16]u8
    data[0] = 72   # H
    data[1] = 101  # e
    data[2] = 108  # l
    data[3] = 108  # l
    data[4] = 111  # o
    data[5] = 10   # \n

    # Get SQE and prep write
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: couldn't get SQE\n")
            ring.destroy()
            f.close()
            return false

    sqe.prep_write(f.raw(), Span<u8> { ptr: @data[0], len: 6 }, 0, 100)
    ring.sqe_submit()

    # Submit and wait
    var submit_ok: bool = true
    match ring.submit_and_wait(1)
        Ok(_) => pass
        Err(_) => submit_ok = false
    if not submit_ok
        print("FAIL: submit_and_wait\n")
        ring.destroy()
        f.close()
        return false

    # Check completion
    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE\n")
            ring.destroy()
            f.close()
            return false

    if cqe.res != 6
        print("FAIL: wrote {cqe.res} bytes instead of 6\n")
        ring.destroy()
        drop_scratch(@&f, @path)
        return false

    if cqe.user_data != 100
        print("FAIL: user_data mismatch\n")
        ring.destroy()
        drop_scratch(@&f, @path)
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()
    drop_scratch(@&f, @path)

    print("OK\n")
    return true

# Test 4: Async read from a file
fn test_uring_read() -> bool
    print("test_uring_read... ")

    # Create a temp file with known content
    let path: String = scratch_path("ritz_uring_read_test")
    var f: Fd = match fd_open(path.as_view(), O_CREAT | O_RDWR | O_TRUNC, 420)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: couldn't create temp file\n")
            return false

    # Write some data synchronously first
    var data: [8]u8
    data[0] = 84   # T
    data[1] = 101  # e
    data[2] = 115  # s
    data[3] = 116  # t
    data[4] = 10   # \n
    f.write(Span<u8> { ptr: @data[0], len: 5 })

    # Seek back to beginning
    f.seek(0, SEEK_SET)

    # Now read with io_uring
    var ring: IoUring = match IoUring.new(32)
        Ok(r) => r
        Err(e) => return no_ring_dropping(@&f, @path, e)

    var buf: [16]u8
    var i: i64 = 0
    while i < 16
        buf[i] = 0
        i += 1

    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            print("FAIL: couldn't get SQE\n")
            ring.destroy()
            drop_scratch(@&f, @path)
            return false

    sqe.prep_read(f.raw(), Span<u8> { ptr: @buf[0], len: 16 }, 0, 200)
    ring.sqe_submit()

    var submit_ok: bool = true
    match ring.submit_and_wait(1)
        Ok(_) => pass
        Err(_) => submit_ok = false
    if not submit_ok
        print("FAIL: submit_and_wait\n")
        ring.destroy()
        drop_scratch(@&f, @path)
        return false

    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            print("FAIL: no CQE\n")
            ring.destroy()
            drop_scratch(@&f, @path)
            return false

    if cqe.res != 5
        print("FAIL: read {cqe.res} bytes instead of 5\n")
        ring.destroy()
        drop_scratch(@&f, @path)
        return false

    # Verify content
    if buf[0] != 84 or buf[1] != 101 or buf[2] != 115 or buf[3] != 116
        print("FAIL: content mismatch\n")
        ring.destroy()
        drop_scratch(@&f, @path)
        return false

    ring.cqe_seen(@*cqe)
    ring.destroy()
    drop_scratch(@&f, @path)

    print("OK\n")
    return true

pub fn main() -> i32
    print("=== io_uring tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_uring_init()
        passed += 1
    else
        failed += 1

    if test_uring_nop()
        passed += 1
    else
        failed += 1

    if test_uring_write()
        passed += 1
    else
        failed += 1

    if test_uring_read()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed} passed, {failed} failed\n")

    if failed > 0
        return 1
    return 0
