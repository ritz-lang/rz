# async_echo_server.ritz - Simple echo server using ritzlib.async.tasks
#
# This example demonstrates:
#   - Creating a listening socket
#   - Using io_uring with the TaskPool
#   - Handling multiple concurrent connections asynchronously
#   - Echo protocol: recv data from client, send it back
#
# The server listens on RITZ_EXAMPLE_PORT (default 9000) and echoes back all
# received data.  Each connection is handled by a separate task in the pool.
#
# To test (from projects/ritz):
#   mkdir -p /tmp/aes/src && cp examples/tier5_async/async_echo_server.ritz /tmp/aes/src/main.ritz
#   printf '[package]\nname = "aes"\nversion = "0.1.0"\n' > /tmp/aes/ritz.toml
#   RITZ_PATH=$PWD python3 build.py build /tmp/aes
#   RITZ_EXAMPLE_PORT=9000 /tmp/aes/build/debug/aes &
#   echo hello | nc -q1 localhost 9000

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.tasks
import ritzlib.async_net
import ritzlib.strview
import ritzlib.option
import ritzlib.result
import ritzlib.errno { Errno }
import ritzlib.os.env
import ritzlib.fmt


# ============================================================================
# Echo handler state machine
# ============================================================================

# Handler state codes
const ECHO_STATE_RECV: i32 = 0          # Waiting to receive data
const ECHO_STATE_SEND: i32 = 1          # Waiting to send echo
const ECHO_STATE_CLOSE: i32 = 2         # Done, close connection


# Echo handler for a single connection
# This is a state machine:
#   1. RECV state: receive data from client
#   2. SEND state: echo that data back
#   3. CLOSE state: close and complete task
#
# Returns:
#   TaskStep.Pending: I/O submitted, poll again on its completion
#   TaskStep.Done: connection finished (the pool closes it)
fn echo_handler(task: @&Task) -> TaskStep
    if task.handler_state == ECHO_STATE_RECV
        # First call: need to submit a recv
        if task.io_result == TASK_IO_FRESH
            # No I/O done yet, submit initial recv
            let ok = task.recv()
            if not ok
                return TaskStep.Done  # Error, close connection
            return TaskStep.Pending

        # I/O completed, we have data in read_buf
        let bytes_read = task.io_result
        if bytes_read <= 0
            # Client disconnected
            return TaskStep.Done

        # Move to send state to echo the data
        task.read_len = bytes_read
        task.write_len = bytes_read
        task.handler_state = ECHO_STATE_SEND
        # Copy read buffer to write buffer
        for i in 0..bytes_read
            task.write_buf[i] = task.read_buf[i]
        # Fall through to send; no send has completed yet
        task.io_result = TASK_IO_FRESH

    if task.handler_state == ECHO_STATE_SEND
        if task.io_result == TASK_IO_FRESH
            # No I/O done yet, submit send
            let ok = task.send(task.write_len)
            if not ok
                return TaskStep.Done  # Error
            return TaskStep.Pending

        # Send completed, check result
        let bytes_sent = task.io_result
        if bytes_sent <= 0
            # Error sending
            return TaskStep.Done  # Error, close

        # Check if we sent all data
        if bytes_sent < task.write_len
            # Partial send, would need to handle more - for now, just close
            return TaskStep.Done  # Error

        # Successfully echoed the data, prepare for next request
        task.request_count += 1
        task.handler_state = ECHO_STATE_RECV
        task.io_result = TASK_IO_FRESH  # No recv has completed yet
        # Submit the next recv now: returning pending with nothing in flight
        # would leave the task waiting on a completion that never comes.
        if not task.recv()
            return TaskStep.Done  # Error, close connection
        return TaskStep.Pending  # waiting for next recv

    # ECHO_STATE_CLOSE (or anything unknown): done with this connection
    TaskStep.Done


# ============================================================================
# Server setup and main loop
# ============================================================================

# Port to listen on.  regression.sh-style runs pass a free per-run port in
# RITZ_EXAMPLE_PORT so concurrent runs on one host cannot collide (AGAST
# #1535, #1542); run by hand, the example keeps its historical default.
fn port_in_range(p: i64, default_port: i32) -> i32
    if p <= 0 or p > 65535
        return default_port
    return p as i32

fn port_or(o: Option<i64>, default_port: i32) -> i32
    match o
        Some(p) => port_in_range(p, default_port)
        None => default_port

# Unset, empty or non-numeric all fall back to the default.
fn listen_port(default_port: i32) -> i32
    let s: StrView = env_get_or("RITZ_EXAMPLE_PORT", "")
    return port_or(s.parse_i64(), default_port)


pub fn main() -> i32
    let port: i32 = listen_port(9000)

    # Create listening socket
    var listener: Socket
    match socket_tcp()
        Ok(s) => listener = s
        Err(_) =>
            print("Error: Failed to create socket\n")
            return 1

    # Allow address reuse
    listener.set_reuseaddr()

    match listener.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            print("Failed to bind to port {port as i64}\n")
            listener.close()
            return 1

    # Start listening
    match listener.listen(128)
        Ok(_) => pass
        Err(_) =>
            print("Error: Listen failed\n")
            listener.close()
            return 1

    print("Echo server listening on port {port as i64}\n")

    # Initialize server with task pool (heap: TaskServer is ~4.5MB).  The
    # server's ring accepts on the listener; main keeps and closes it.
    let srv: @&TaskServer = match TaskServer.new(@listener)
        Ok(s) => s
        Err(e) => return failed("Failed to initialize server", e, @&listener)

    print("Server initialized, starting event loop\n")

    # Run the server event loop with our echo handler
    let ran: Result<(), Errno> = srv.run(echo_handler)

    srv.free()
    listener.close()

    match ran
        Ok(_) =>
            print("Server shutdown cleanly\n")
            0
        Err(e) =>
            print("Server error: {e.name()}\n")
            1


# Setup step `what` failed with `e`: say so, close the listener; exit 1.
fn failed(what: StrView, e: Errno, listener: @&Socket) -> i32
    print("Error: {what}: {e.name()}\n")
    listener.close()
    1
