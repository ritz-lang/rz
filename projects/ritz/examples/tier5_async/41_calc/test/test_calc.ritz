# Tests for 41_calc — expression evaluator.
#
# Each test runs ./calc with one argv expression and asserts the
# exact stdout (calc prints `<result>\n`).  Mirrors the scenarios in
# test.sh but written so an assertion failure points at the specific
# scenario instead of just exiting 1.

import ritzlib.testlib

# Run ./calc <expr> and capture stdout.
fn calc_run(expr: StrView) -> Result<Captured, Errno>
    let args: [1]StrView = [expr]
    exec_capture("./calc", @args, span_empty<StrView>(), "")

# Run ./calc -- <expr> (escapes leading minus).
fn calc_run_dashdash(expr: StrView) -> Result<Captured, Errno>
    let args: [2]StrView = ["--", expr]
    exec_capture("./calc", @args, span_empty<StrView>(), "")

[[test]]
fn test_calc_addition() -> i32
    match calc_run("2 + 3")
        Ok(c) =>
            assert c.status.exit_code == 0, "calc 2+3 should exit 0"
            assert c.out.len == 2, "expected 2 bytes (5\\n)"
            assert buf_eq(c.output(), "5\n"), "2+3 != 5"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_subtraction() -> i32
    match calc_run("10 - 4")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "6\n"), "10-4 != 6"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_multiplication() -> i32
    match calc_run("3 * 7")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "21\n"), "3*7 != 21"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_division() -> i32
    match calc_run("20 / 4")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "5\n"), "20/4 != 5"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_modulo() -> i32
    match calc_run("17 % 5")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "2\n"), "17%5 != 2"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_precedence() -> i32
    match calc_run("2 + 3 * 4")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "14\n"), "expected 14 (precedence)"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_parens() -> i32
    match calc_run("(2 + 3) * 4")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "20\n"), "expected 20 (parens override)"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_nested_parens() -> i32
    match calc_run("((1 + 2) * (3 + 4))")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "21\n"), "expected 21"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_unary_minus() -> i32
    # `--` stops option parsing so calc sees `-5` as the expression.
    match calc_run_dashdash("-5")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "-5\n"), "expected -5"
        Err(_) =>
            assert false, "spawn ./calc"
    0

[[test]]
fn test_calc_large_numbers() -> i32
    match calc_run("1000 + 2000")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_eq(c.output(), "3000\n"), "expected 3000"
        Err(_) =>
            assert false, "spawn ./calc"
    0
