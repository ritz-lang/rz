# Tests for 57_fn_ptr — wraps the binary's self-test main().
#
# Each of these tier 5 examples runs internal test_* functions from main()
# and exits 0 if all pass.  This [[test]] just fork+execs the binary and
# asserts the exit code; the actual assertions live inside the binary.

import ritzlib.testlib

[[test]]
fn test_fn_ptr_self() -> i32
    match exec_capture("./fn_ptr_test", span_empty<StrView>(), span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "fn_ptr_test self-tests should exit 0"
        Err(_) =>
            assert false, "spawn ./fn_ptr_test"
    0
