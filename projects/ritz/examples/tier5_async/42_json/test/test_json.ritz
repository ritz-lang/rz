# Tests for 42_json — JSON parser/reformatter.
#
# Mirrors the test.sh scenarios via exec_capture with stdin.

import ritzlib.testlib

fn json_run(args: Span<StrView>, stdin_data: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./json", args, span_empty<StrView>(), stdin_data)

[[test]]
fn test_json_simple_object() -> i32
    match json_run(span_empty<StrView>(), "{\"name\":\"test\"}")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on valid object"
            assert buf_contains(c.output(), "\"name\""), "should contain \"name\" key"
        Err(_) =>
            assert false, "spawn ./json"
    0

[[test]]
fn test_json_array() -> i32
    match json_run(span_empty<StrView>(), "[1, 2, 3]")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on valid array"
            assert buf_contains(c.output(), "["), "should contain ["
        Err(_) =>
            assert false, "spawn ./json"
    0

[[test]]
fn test_json_invalid_rejected() -> i32
    match json_run(span_empty<StrView>(), "{invalid}")
        Ok(c) =>
            assert c.status.exit_code != 0, "invalid JSON should fail (non-zero exit)"
        Err(_) =>
            assert false, "spawn ./json"
    0

[[test]]
fn test_json_compact_flag() -> i32
    let args: [1]StrView = ["-c"]
    match json_run(@args, "{\"a\": 1}")
        Ok(c) =>
            assert c.status.exit_code == 0, "compact mode exit 0"
            # Compact form should be "{\"a\":1}" — no whitespace
            assert buf_contains(c.output(), "{\"a\":1}"), "compact should remove whitespace"
        Err(_) =>
            assert false, "spawn ./json"
    0
