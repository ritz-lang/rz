# Tests for 43_toml — TOML parser.
import ritzlib.testlib

[[test]]
fn test_toml_simple_kv() -> i32
    match exec_capture("./toml", span_empty<StrView>(), span_empty<StrView>(), "name = \"test\"\nversion = \"1.0\"")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on valid TOML"
            assert buf_contains(c.output(), "name"), "output should contain key 'name'"
        Err(_) =>
            assert false, "spawn ./toml"
    0

[[test]]
fn test_toml_get_key() -> i32
    let args: [2]StrView = ["-g", "name"]
    match exec_capture("./toml", @args, span_empty<StrView>(), "name = \"myapp\"\nversion = \"2.0\"")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on -g name"
            assert buf_contains(c.output(), "myapp"), "output should contain value 'myapp'"
        Err(_) =>
            assert false, "spawn ./toml"
    0
