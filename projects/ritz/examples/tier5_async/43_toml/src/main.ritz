# toml - TOML config file parser
#
# Usage: toml [OPTIONS] [FILE]
#   Parse and query TOML configuration files.
#
# Options:
#   -g KEY        Get value for specific key (dotted path, e.g., "package.name")
#   -k, --keys    List all top-level keys
#   -v, --validate Validate only (no output)
#   -h, --help    Show help
#
# Examples:
#   toml config.toml                   # Pretty print
#   toml -g package.name config.toml   # Get specific value
#   toml -k config.toml                # List keys
#
# Supported TOML subset:
#   - Key-value pairs (key = "value")
#   - Sections ([section])
#   - Strings (basic and literal)
#   - Integers and floats
#   - Booleans (true/false)
#   - Comments (#)

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec
import ritzlib.fd { Fd, fd_open, fd_stdin, O_RDONLY }

# ============================================================================
# TOML Value Types
# ============================================================================

const TOML_STRING: i32 = 0
const TOML_INTEGER: i32 = 1
const TOML_FLOAT: i32 = 2
const TOML_BOOL: i32 = 3
const TOML_ARRAY: i32 = 4
const TOML_TABLE: i32 = 5

const MAX_KEY_LEN: i64 = 256
const MAX_VALUE_LEN: i64 = 4096

# ============================================================================
# Key-Value Entry
# ============================================================================

struct TomlEntry
    key: [256]u8       # Full dotted key path
    value: [4096]u8    # String representation of value
    value_type: i32
    key_len: i64
    value_len: i64

# Helper functions to get pointers to entry fields
# (workaround for @entry.key[0] not being supported)
fn entry_key_ptr(entry: *TomlEntry) -> *u8
    return entry as *u8

fn entry_value_ptr(entry: *TomlEntry) -> *u8
    return (entry as *u8) + 256

fn entry_key(entry: *TomlEntry) -> StrView
    StrView { ptr: entry_key_ptr(entry), len: entry.key_len }

fn entry_value(entry: *TomlEntry) -> StrView
    StrView { ptr: entry_value_ptr(entry), len: entry.value_len }

# Copy `src` to `dst`, at most `cap` bytes of it; the bytes copied.
fn copy_into(dst: *u8, cap: i64, src: StrView) -> i64
    var out = Span<u8> { ptr: dst, len: cap }
    out.copy_from(Span<u8> { ptr: src.ptr, len: src.len })

# ============================================================================
# TOML Parser
# ============================================================================

struct TomlParser
    data: *u8
    len: i64
    pos: i64
    line: i32
    # Current section prefix
    section: [256]u8
    section_len: i64
    # Parsed entries
    entries: *TomlEntry
    entry_count: i32
    max_entries: i32
    # Error tracking
    error: i32
    error_msg: StrView

# Get pointer to parser's section field (at offset 32: 8+8+8+4+4padding)
fn parser_section_ptr(p: *TomlParser) -> *u8
    return (p as *u8) + 32

fn parser_init(p: *TomlParser, data: *u8, len: i64, entries: *TomlEntry, max: i32) -> i32
    p.data = data
    p.len = len
    p.pos = 0
    p.line = 1
    let sec_ptr: *u8 = parser_section_ptr(p)
    *sec_ptr = 0
    p.section_len = 0
    p.entries = entries
    p.entry_count = 0
    p.max_entries = max
    p.error = 0
    p.error_msg = ""
    return 0

fn peek(p: *TomlParser) -> u8
    if p.pos >= p.len
        return 0
    return *(p.data + p.pos)

fn peek_at(p: *TomlParser, offset: i64) -> u8
    let pos: i64 = p.pos + offset
    if pos >= p.len
        return 0
    return *(p.data + pos)

fn advance(p: *TomlParser) -> u8
    if p.pos >= p.len
        return 0
    let c: u8 = *(p.data + p.pos)
    p.pos = p.pos + 1
    if c == '\n'
        p.line = p.line + 1
    return c

fn set_error(p: *TomlParser, msg: StrView) -> i32
    p.error = 1
    p.error_msg = msg
    return -1

fn skip_whitespace(p: *TomlParser) -> i32
    while p.pos < p.len
        let c: u8 = peek(p)
        if c == ' ' or c == '\t'  # space or tab
            advance(p)
        else
            break
    return 0

fn skip_to_eol(p: *TomlParser) -> i32
    while p.pos < p.len
        let c: u8 = peek(p)
        if c == '\n' or c == '\r'
            break
        advance(p)
    return 0

fn skip_comment(p: *TomlParser) -> i32
    if peek(p) == '#'  # '#'
        skip_to_eol(p)
    return 0

fn skip_ws_and_comments(p: *TomlParser) -> i32
    while p.pos < p.len
        let c: u8 = peek(p)
        if c == ' ' or c == '\t'
            advance(p)
        else if c == '#'  # '#'
            skip_to_eol(p)
        else if c == '\n' or c == '\r'
            advance(p)
        else
            break
    return 0

fn is_bare_key_char(c: u8) -> i32
    # A-Z, a-z, 0-9, _, -
    if c >= 'A' and c <= 'Z'
        return 1
    if c >= 'a' and c <= 'z'
        return 1
    if c >= '0' and c <= '9'
        return 1
    if c == '_' or c == '-'  # _ or -
        return 1
    return 0

# ============================================================================
# Key parsing
# ============================================================================

fn parse_bare_key(p: *TomlParser, out: *u8, max_len: i64) -> i64
    var len: i64 = 0
    while p.pos < p.len and len < max_len - 1
        let c: u8 = peek(p)
        if is_bare_key_char(c) == 0
            break
        *(out + len) = advance(p)
        len += 1
    *(out + len) = 0
    return len

fn parse_quoted_key(p: *TomlParser, out: *u8, max_len: i64) -> i64
    let quote: u8 = advance(p)  # skip opening quote
    var len: i64 = 0

    while p.pos < p.len and len < max_len - 1
        let c: u8 = peek(p)
        if c == quote
            advance(p)
            break
        if c == '\\'  # backslash
            advance(p)
            if p.pos < p.len
                *(out + len) = advance(p)
                len += 1
        else
            *(out + len) = advance(p)
            len += 1

    *(out + len) = 0
    return len

fn parse_key(p: *TomlParser, out: *u8, max_len: i64) -> i64
    let c: u8 = peek(p)
    if c == '"' or c == '\''  # " or '
        return parse_quoted_key(p, out, max_len)
    else
        return parse_bare_key(p, out, max_len)

# ============================================================================
# Value parsing
# ============================================================================

fn parse_basic_string(p: *TomlParser, out: *u8, max_len: i64) -> i64
    advance(p)  # skip opening "
    var len: i64 = 0

    while p.pos < p.len and len < max_len - 1
        let c: u8 = peek(p)
        if c == '"'  # "
            advance(p)
            break
        if c == '\\'  # backslash
            advance(p)
            if p.pos < p.len
                let esc: u8 = advance(p)
                if esc == 'n'  # n
                    *(out + len) = 10
                else if esc == 't'  # t
                    *(out + len) = 9
                else if esc == 'r'  # r
                    *(out + len) = 13
                else if esc == '\\'  # \
                    *(out + len) = 92
                else if esc == '"'  # "
                    *(out + len) = 34
                else
                    *(out + len) = esc
                len += 1
        else
            *(out + len) = advance(p)
            len += 1

    *(out + len) = 0
    return len

fn parse_literal_string(p: *TomlParser, out: *u8, max_len: i64) -> i64
    advance(p)  # skip opening '
    var len: i64 = 0

    while p.pos < p.len and len < max_len - 1
        let c: u8 = peek(p)
        if c == '\''  # '
            advance(p)
            break
        *(out + len) = advance(p)
        len += 1

    *(out + len) = 0
    return len

fn parse_number(p: *TomlParser, out: *u8, max_len: i64, val_type: *i32) -> i64
    var len: i64 = 0
    var has_dot: i32 = 0

    # Optional sign
    let c: u8 = peek(p)
    if c == '+' or c == '-'  # + or -
        *(out + len) = advance(p)
        len += 1

    while p.pos < p.len and len < max_len - 1
        let d: u8 = peek(p)
        if d >= '0' and d <= '9'
            *(out + len) = advance(p)
            len += 1
        else if d == '.' and has_dot == 0
            *(out + len) = advance(p)
            len += 1
            has_dot = 1
        else if d == '_'  # underscore separator
            advance(p)  # skip, don't include
        else if d == 'e' or d == 69  # e or E
            *(out + len) = advance(p)
            len += 1
            has_dot = 1  # exponent means float
        else
            break

    *(out + len) = 0
    if has_dot != 0
        *val_type = TOML_FLOAT
    else
        *val_type = TOML_INTEGER
    return len

fn parse_value(p: *TomlParser, out: *u8, max_len: i64, val_type: *i32) -> i64
    skip_whitespace(p)
    let c: u8 = peek(p)

    # String
    if c == '"'  # "
        *val_type = TOML_STRING
        return parse_basic_string(p, out, max_len)

    if c == '\''  # '
        *val_type = TOML_STRING
        return parse_literal_string(p, out, max_len)

    # Boolean
    if c == 't'  # 't'
        if peek_at(p, 1) == 'r' and peek_at(p, 2) == 117 and peek_at(p, 3) == 'e'  # "rue"
            p.pos = p.pos + 4
            *val_type = TOML_BOOL
            return copy_into(out, max_len, "true")

    if c == 'f'  # 'f'
        if peek_at(p, 1) == 'a' and peek_at(p, 2) == 108 and peek_at(p, 3) == 115 and peek_at(p, 4) == 'e'  # "alse"
            p.pos = p.pos + 5
            *val_type = TOML_BOOL
            return copy_into(out, max_len, "false")

    # Number
    if c == '+' or c == '-' or (c >= '0' and c <= '9')  # + - 0-9
        return parse_number(p, out, max_len, val_type)

    # Array (simplified - just store as string representation)
    if c == '['  # [
        *val_type = TOML_ARRAY
        var len: i64 = 0
        var depth: i32 = 0
        while p.pos < p.len and len < max_len - 1
            let ch: u8 = peek(p)
            if ch == '['
                depth += 1
            else if ch == ']'
                depth -= 1
            *(out + len) = advance(p)
            len += 1
            if depth == 0
                break
        *(out + len) = 0
        return len

    # Unknown
    *val_type = TOML_STRING
    return 0

# ============================================================================
# Entry management
# ============================================================================

fn add_entry(p: *TomlParser, key: StrView, value: StrView, val_type: i32) -> i32
    if p.entry_count >= p.max_entries
        return set_error(p, "too many entries")

    let entry: *TomlEntry = p.entries + p.entry_count
    let entry_key: *u8 = entry_key_ptr(entry)
    let entry_val: *u8 = entry_value_ptr(entry)
    let sec_ptr: *u8 = parser_section_ptr(p)

    # Build full key path
    var klen: i64 = 0
    if p.section_len > 0
        klen = copy_into(entry_key, MAX_KEY_LEN, StrView { ptr: sec_ptr, len: p.section_len })
        klen += copy_into(entry_key + klen, MAX_KEY_LEN - klen, ".")
    klen += copy_into(entry_key + klen, MAX_KEY_LEN - klen, key)
    entry.key_len = klen

    entry.value_len = copy_into(entry_val, MAX_VALUE_LEN, value)
    entry.value_type = val_type

    p.entry_count = p.entry_count + 1
    return 0

# ============================================================================
# Section and key-value parsing
# ============================================================================

fn parse_section(p: *TomlParser) -> i32
    advance(p)  # skip [
    let sec_ptr: *u8 = parser_section_ptr(p)

    # Check for [[array]]
    if peek(p) == '['
        advance(p)
        # Parse array table name
        let len: i64 = parse_key(p, sec_ptr, 256)
        p.section_len = len
        skip_whitespace(p)
        if peek(p) == ']'
            advance(p)
        if peek(p) == ']'
            advance(p)
        return 0

    # Regular section
    p.section_len = parse_key(p, sec_ptr, 256)
    skip_whitespace(p)
    if peek(p) == ']'
        advance(p)
    return 0

fn parse_keyval(p: *TomlParser) -> i32
    var key_buf: [256]u8
    let key_len: i64 = parse_key(p, @key_buf[0], 256)
    if key_len == 0
        return set_error(p, "expected key")

    skip_whitespace(p)
    if peek(p) != 61  # '='
        return set_error(p, "expected '='")
    advance(p)

    var value_buf: [4096]u8
    var val_type: i32 = TOML_STRING
    let val_len: i64 = parse_value(p, @value_buf[0], 4096, @val_type)

    add_entry(p, StrView { ptr: @key_buf[0], len: key_len }, StrView { ptr: @value_buf[0], len: val_len }, val_type)
    return 0

fn parse_line(p: *TomlParser) -> i32
    skip_whitespace(p)
    let c: u8 = peek(p)

    if c == 0 or c == '\n' or c == '\r'
        # Empty line
        if c != 0
            advance(p)
        return 0

    if c == '#'  # Comment
        skip_to_eol(p)
        return 0

    if c == '['  # Section
        parse_section(p)
        skip_comment(p)
        if peek(p) == '\n' or peek(p) == '\r'
            advance(p)
        return 0

    # Key-value pair
    parse_keyval(p)
    skip_whitespace(p)
    skip_comment(p)
    if peek(p) == '\n' or peek(p) == '\r'
        advance(p)
    return 0

fn parse_document(p: *TomlParser) -> i32
    skip_ws_and_comments(p)
    while p.pos < p.len and p.error == 0
        parse_line(p)
    return p.error

# ============================================================================
# Query and output
# ============================================================================

fn find_entry(entries: *TomlEntry, count: i32, key: StrView) -> *TomlEntry
    for i in 0..count
        let e: *TomlEntry = entries + i
        if entry_key(e).eq(key)
            return e
    return null

fn print_entries(entries: *TomlEntry, count: i32) -> i32
    for i in 0..count
        let e: *TomlEntry = entries + i
        let e_key: StrView = entry_key(e)
        let e_val: StrView = entry_value(e)
        if e.value_type == TOML_STRING
            print("{e_key} = \"{e_val}\"\n")
        else
            print("{e_key} = {e_val}\n")
    return 0

fn print_keys(entries: *TomlEntry, count: i32) -> i32
    for i in 0..count
        let e: *TomlEntry = entries + i
        let e_key: StrView = entry_key(e)
        print("{e_key}\n")
    return 0

# ============================================================================
# File reading
# ============================================================================

# Append everything `f` yields until EOF to `buf`: 0, or -1 on a read error.
fn read_all_into(f: @Fd, buf: *Vec<u8>) -> i32
    var tmp: [4096]u8
    loop
        match f.read(Span<u8> { ptr: @tmp[0], len: 4096 })
            Ok(n) =>
                if n == 0
                    return 0
                buf.push_span(Span<u8> { ptr: (@tmp[0]), len: n })
            Err(_) => return -1

fn read_path_into(path: StrView, buf: *Vec<u8>) -> i32
    match fd_open(path, O_RDONLY, 0)
        Ok(opened) =>
            var f: Fd = opened
            let rc: i32 = read_all_into(@f, buf)
            f.close()
            rc
        Err(_) => -1

fn read_stdin(buf: *Vec<u8>) -> i32
    read_all_into(@fd_stdin(), buf)

# ============================================================================
# Main
# ============================================================================

const MAX_ENTRIES: i32 = 256

fn build_spec() -> ArgSpec
    var spec = argspec_new("toml", "TOML config file parser")
    spec.option('g', "get", "KEY", "Get value for specific key", None)
    spec.switch('k', "keys", "List all keys")
    spec.switch('v', "validate", "Validate only (no output)")
    spec.positionals("FILE", "TOML file to process (stdin if omitted)", 0, 1)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# A switch as the 0/1 flag the rest of the program uses.
fn flag_i32(b: bool) -> i32
    if b
        return 1
    0

# An option's value, or the empty view when not given.
fn value_or_empty(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => ""

# Read FILE, or stdin when there is none.  Returns 1 after reporting a failure.
fn read_input(file: Option<StrView>, input: *Vec<u8>) -> i32
    match file
        Some(f) => read_path(f, input)
        None => read_stdin_or_report(input)

fn read_path(file: StrView, input: *Vec<u8>) -> i32
    if read_path_into(file, input) != 0
        eprint("toml: cannot read file: {file}\n")
        return 1
    0

fn read_stdin_or_report(input: *Vec<u8>) -> i32
    if read_stdin(input) != 0
        eprint("toml: cannot read stdin\n")
        return 1
    0

fn toml(p: @ParsedArgs) -> i32
    # No -g, or "-g ''" (an empty key), lists entries.
    let get_key: StrView = value_or_empty(p.value("g"))
    let list_keys: i32 = flag_i32(p.switch("k"))
    let validate_only: i32 = flag_i32(p.switch("v"))

    # Read input
    var input: Vec<u8> = vec_new<u8>()

    if read_input(p.positional(0), @input) != 0
        return 1

    # Entry storage: the parser fills the capacity through `entries`.
    var entry_store: Vec<TomlEntry> = vec_with_cap<TomlEntry>(MAX_ENTRIES as i64)
    let entries: *TomlEntry = entry_store.data

    # Parse
    var parser: TomlParser
    parser_init(@parser, input.data, input.len, entries, MAX_ENTRIES)

    if parse_document(@parser) != 0
        # The line number has always gone to stdout and the rest to
        # stderr; kept as is so the output stays byte-identical.
        eprint("toml: parse error at line ")
        print("{parser.line}")
        eprint(": {parser.error_msg}\n")
        return 1

    # Output
    if validate_only == 0
        if get_key.len > 0
            let entry: *TomlEntry = find_entry(entries, parser.entry_count, get_key)
            if entry == null
                eprint("toml: key not found: {get_key}\n")
                return 1
            let entry_val: StrView = entry_value(entry)
            print("{entry_val}\n")
        else if list_keys != 0
            print_keys(entries, parser.entry_count)
        else
            print_entries(entries, parser.entry_count)

    # Drop is automatic via RAII
    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = toml(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
