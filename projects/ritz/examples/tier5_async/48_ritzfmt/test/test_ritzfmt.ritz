# Tests for 48_ritzfmt — Ritz source formatter.
import ritzlib.testlib

[[test]]
fn test_ritzfmt_strips_trailing_whitespace() -> i32
    # Input has trailing spaces on each line.
    match exec_capture("./ritzfmt", span_empty<StrView>(), span_empty<StrView>(), "fn foo()   \n    return 0  \n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            # Output should have "fn foo()\n" exactly (no trailing whitespace).
            assert buf_contains(c.output(), "fn foo()\n"), "trailing whitespace stripped"
        Err(_) =>
            assert false, "spawn ./ritzfmt"
    0

[[test]]
fn test_ritzfmt_normalizes_blank_lines() -> i32
    # 4 blank lines collapsed to ≤ 1.
    match exec_capture("./ritzfmt", span_empty<StrView>(), span_empty<StrView>(), "fn foo()\n\n\n\n    x\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            # Count newlines — should be at most 4 (header + blank + body + trailing).
            let out: Span<u8> = c.output()
            var nl: i64 = 0
            var i: i64 = 0
            while i < out.len
                if *(out.ptr + i) == 10
                    nl += 1
                i += 1
            assert nl <= 4, "blank lines should collapse to ≤ 4 newlines"
        Err(_) =>
            assert false, "spawn ./ritzfmt"
    0
