# Tests for 45_regex — regex matcher (grep-like).
import ritzlib.testlib

[[test]]
fn test_regex_literal_match() -> i32
    var argv: [3]*u8
    argv[0] = c"./regex"
    argv[1] = c"hello"
    argv[2] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./regex", @argv[0], null, Span<u8> { ptr: (c"hello\nworld\n"), len: (12) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0 on literal match"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"hello"), len: (5) }), "output should contain 'hello'"
    0

[[test]]
fn test_regex_dot_matches_any() -> i32
    var argv: [3]*u8
    argv[0] = c"./regex"
    argv[1] = c"ca."
    argv[2] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./regex", @argv[0], null, Span<u8> { ptr: (c"cat\ncar\ncan\n"), len: (12) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0 on dot match"
    # All three lines should match
    var nl: i64 = 0
    var i: i64 = 0
    while i < n
        if *(@out[0] + i) == 10
            nl += 1
        i += 1
    assert nl == 3, "should match all 3 lines"
    0
