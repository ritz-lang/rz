# Tests for 45_regex — regex matcher (grep-like).
import ritzlib.testlib

[[test]]
fn test_regex_literal_match() -> i32
    let args: [1]StrView = ["hello"]
    match exec_capture("./regex", @args, span_empty<StrView>(), "hello\nworld\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on literal match"
            assert buf_contains(c.output(), "hello"), "output should contain 'hello'"
        Err(_) =>
            assert false, "spawn ./regex"
    0

[[test]]
fn test_regex_dot_matches_any() -> i32
    let args: [1]StrView = ["ca."]
    match exec_capture("./regex", @args, span_empty<StrView>(), "cat\ncar\ncan\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0 on dot match"
            # All three lines should match
            let out: Span<u8> = c.output()
            var nl: i64 = 0
            var i: i64 = 0
            while i < out.len
                if *(out.ptr + i) == 10
                    nl += 1
                i += 1
            assert nl == 3, "should match all 3 lines"
        Err(_) =>
            assert false, "spawn ./regex"
    0
