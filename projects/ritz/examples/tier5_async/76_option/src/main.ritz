# Example 76: Option<T>
#
# Every Option idiom #1347 needs before ritzlib starts returning Option:
# - Some(v) / None for a scalar (i64) and a struct payload
# - match with expression arms (block arms: see #1454)
# - an Option passed into a function and one returned from a function
# - option_is_some / option_is_none / option_unwrap_or (pointer helpers)
# - the built-in .unwrap_or(default) method form
#
# Known gaps this example deliberately exercises (AGAST):
# - ritz1 cannot build it yet: a match arm binding a struct payload
#   (`Some(p) => p.x`) is typed i64 (#1515), and a struct literal inside
#   `Some(...)` is not lowered (#1362).  It is on the ritz1 known-failures
#   list until both are fixed.
# - ritz0's move checker treats Option<T> as move-only even when T is Copy
#   (#1548), so `match o` or passing `o` by value consumes it.
#   Each by-value use below gets its own value; the pointer helpers run on
#   values that are never moved.

import ritzlib.sys
import ritzlib.io
import ritzlib.option

struct Point
    x: i64
    y: i64

# Returns an Option<i64>: `target` if it is a multiple of 3 below `n`.
fn find_multiple_of_three(target: i64, n: i64) -> Option<i64>
    var i: i64 = 0
    while i < n
        if i == target
            return Some(i)
        i += 3
    return None

# Returns an Option with a struct payload.
fn make_point(ok: bool) -> Option<Point>
    if ok
        return Some(Point { x: 3, y: 4 })
    return None

# Takes an Option<i64> by value across the call boundary.
fn describe(opt: Option<i64>) -> i64
    match opt
        Some(v) => v * 10
        None => -1

# Takes an Option<Point> by value; expression arms that use the payload.
fn point_sum(opt: Option<Point>) -> i64
    match opt
        Some(p) => p.x + p.y
        None => 0

fn show(label: *u8, v: i64)
    prints_cstr(label)
    print_int(v)
    print_char('\n')

fn main() -> i32
    # --- construct Some / None for i64; ritzlib helpers through a pointer ---
    var some_i: Option<i64> = Some(42)
    var none_i: Option<i64> = None
    show(c"is_some(some): ", option_is_some<i64>(@some_i) as i64)
    show(c"is_none(some): ", option_is_none<i64>(@some_i) as i64)
    show(c"is_some(none): ", option_is_some<i64>(@none_i) as i64)
    show(c"is_none(none): ", option_is_none<i64>(@none_i) as i64)
    show(c"unwrap_or(some, 0): ", option_unwrap_or<i64>(@some_i, 0))
    show(c"unwrap_or(none, 99): ", option_unwrap_or<i64>(@none_i, 99))

    # --- expression-arm match on a local ---
    var m1: Option<i64> = Some(5)
    let a: i64 = match m1
        Some(v) => v
        None => 0
    show(c"match some: ", a)
    var m2: Option<i64> = None
    let b: i64 = match m2
        Some(v) => v
        None => 7
    show(c"match none: ", b)

    # --- Option across the call boundary: passed in and returned ---
    var arg_some: Option<i64> = Some(4)
    var arg_none: Option<i64> = None
    show(c"describe(some): ", describe(arg_some))
    show(c"describe(none): ", describe(arg_none))
    var found: Option<i64> = find_multiple_of_three(6, 10)
    var missing: Option<i64> = find_multiple_of_three(5, 10)
    show(c"find(6) is_some: ", option_is_some<i64>(@found) as i64)
    show(c"find(5) is_none: ", option_is_none<i64>(@missing) as i64)
    show(c"find(6): ", option_unwrap_or<i64>(@found, -1))
    show(c"find(5): ", option_unwrap_or<i64>(@missing, -1))
    show(c"describe(find(9)): ", describe(find_multiple_of_three(9, 10)))
    show(c"describe(find(8)): ", describe(find_multiple_of_three(8, 10)))

    # --- .unwrap_or() method form ---
    show(c"find(3).unwrap_or(-1): ", find_multiple_of_three(3, 10).unwrap_or(-1))
    show(c"find(4).unwrap_or(-1): ", find_multiple_of_three(4, 10).unwrap_or(-1))
    var u1: Option<i64> = Some(11)
    var u2: Option<i64> = None
    show(c"some.unwrap_or(0): ", u1.unwrap_or(0))
    show(c"none.unwrap_or(5): ", u2.unwrap_or(5))

    # --- struct payload ---
    var some_p: Option<Point> = make_point(true)
    var none_p: Option<Point> = make_point(false)
    show(c"is_some(point): ", option_is_some<Point>(@some_p) as i64)
    show(c"is_none(point): ", option_is_none<Point>(@none_p) as i64)
    show(c"point_sum(some): ", point_sum(make_point(true)))
    show(c"point_sum(none): ", point_sum(make_point(false)))
    let px: i64 = match some_p
        Some(p) => p.x
        None => -1
    show(c"match point.x: ", px)
    let py: i64 = match none_p
        Some(p) => p.y
        None => -1
    show(c"match none point.y: ", py)

    return 0
