# Example 68: Result Error Handling with Try Operator
#
# This example demonstrates modern Ritz error handling patterns:
# - Result<T, E> enum for fallible operations
# - Try operator (?) for error propagation
# - Pattern matching on Results
#
# The try operator automatically propagates errors, making code
# cleaner and more readable than manual error checking.

import ritzlib.process { process_id }
import ritzlib.io
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.fmt

# Count the lines in `content`, including a final unterminated one.
fn count_newlines(content: @String) -> i64
    var count: i64 = 0
    let len: i64 = content.len()

    for i in 0..len
        if content.char_at(i) == '\n'
            count += 1

    # Don't forget to count last line if no trailing newline
    if len > 0 and content.char_at(len - 1) != '\n'
        count += 1
    count

# Process a file: read it, count lines, and return the count.
# Uses the try operator (?) to propagate errors automatically.
fn count_lines(path: StrView) -> Result<i64, Errno>
    # read_file returns Result<String, Errno>; ? hands the Err (an Errno) straight back
    var content: String = read_file(path)?
    let count: i64 = count_newlines(@content)
    return Ok(count)

# Process multiple files, returning total line count.
# Demonstrates chaining multiple fallible operations.
fn count_total_lines(paths: *StrView, count: i64) -> Result<i64, Errno>
    var total: i64 = 0

    for i in 0..count
        # Each call can fail - ? propagates the first error
        let lines: i64 = count_lines(*(paths + i))?
        total += lines

    return Ok(total)

# Demonstrate error handling patterns
pub fn main() -> i32
    # Create a test file
    # Per-pid paths: concurrent runs on one host must not share a file (#1738).
    var path_s: String = string_from_strview("/tmp/ritz_result_demo_")
    path_s.push_i64(process_id() as i64)
    var missing_s: String = path_s.clone()
    missing_s.push_str("_missing")
    let test_path: StrView = path_s.as_view()
    let test_content: StrView = "Hello, world!\nThis is line 2.\nLine 3.\n"

    # Write using Result-returning function
    var write_result: Result<i64, Errno> = write_file(test_path, test_content)
    if write_result.is_err()
        print("Write failed\n")
        return 1

    let bytes_written: i64 = write_result.unwrap_or(0)
    print("Wrote ")
    print("{bytes_written}")
    print(" bytes\n")

    # Count lines using try operator
    var count_result: Result<i64, Errno> = count_lines(test_path)
    if count_result.is_ok()
        let lines: i64 = count_result.unwrap_or(0)
        print("File has ")
        print("{lines}")
        print(" lines\n")
    else
        print("Count failed\n")

    # Try to read a non-existent file (demonstrates error case)
    var missing_result: Result<i64, Errno> = count_lines(missing_s.as_view())
    if missing_result.is_err()
        print("Expected error for missing file\n")
    else
        print("Unexpected: file exists?\n")

    # Clean up
    unlink(test_path)

    return 0
