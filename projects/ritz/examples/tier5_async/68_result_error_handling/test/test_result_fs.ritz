# Tests for Result-based filesystem functions (StrView paths, errno Errs)
import ritzlib.sys
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.result

fn unit_failed(r: *Result<i32, i32>) -> i32
    result_is_err<i32, i32>(r)

# 1 if `r` is Ok and holds exactly `want`.
fn read_matches(r: *Result<String, i32>, want: StrView) -> i32
    match *r
        Ok(s) => string_eq(@s, want) as i32
        Err(_) => 0

[[test]]
fn test_write_and_read_file() -> i32
    let path: StrView = "/tmp/ritz_test_rw.txt"

    var w_res: Result<i64, i32> = write_file(path, "Hello, Result!")
    if result_is_err<i64, i32>(@w_res) == 1
        return 1

    var r_res: Result<String, i32> = read_file(path)
    unlink(path)
    if read_matches(@r_res, "Hello, Result!") == 0
        return 2
    return 0

[[test]]
fn test_read_nonexistent_file() -> i32
    var r_res: Result<String, i32> = read_file("/tmp/does_not_exist_xyz123.txt")
    if result_is_err<String, i32>(@r_res) == 1
        return 0
    return 1

[[test]]
fn test_mkdir_and_rmdir() -> i32
    let path: StrView = "/tmp/ritz_test_dir"

    var mk: Result<i32, i32> = mkdir(path, 493)  # 0755 octal = 493 decimal
    if unit_failed(@mk) == 1
        return 1

    if not is_dir(path)
        return 2

    var rm: Result<i32, i32> = rmdir(path)
    if unit_failed(@rm) == 1
        return 3

    if path_exists(path)
        return 4
    return 0

[[test]]
fn test_copy_file() -> i32
    let src: StrView = "/tmp/ritz_test_src.txt"
    let dst: StrView = "/tmp/ritz_test_dst.txt"

    write_file(src, "Content to copy")

    var cp_res: Result<i64, i32> = copy_file(src, dst, 420)  # 0644 octal = 420 decimal
    if result_is_err<i64, i32>(@cp_res) == 1
        unlink(src)
        return 1

    var r_res: Result<String, i32> = read_file(dst)
    unlink(src)
    unlink(dst)
    if read_matches(@r_res, "Content to copy") == 0
        return 2
    return 0

fn main() -> i32
    return 0
