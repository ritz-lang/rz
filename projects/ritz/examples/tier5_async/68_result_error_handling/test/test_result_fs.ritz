# Tests for Result-based filesystem functions (StrView paths, Errno Errs)
import ritzlib.sys
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.result

fn unit_failed(r: *Result<i32, Errno>) -> i32
    (r.is_err()) as i32

# 1 if `r` is Ok and holds exactly `want`.
fn read_matches(r: *Result<String, Errno>, want: StrView) -> i32
    match *r
        Ok(s) => string_eq(@s, want) as i32
        Err(_) => 0

# "/tmp/ritz_test_rfs_<tag>_<pid>". The pid keeps concurrent runs (rooms
# gating on one host) off each other's files: a shared fixed path let one
# run's O_TRUNC race another's read-back (AGAST #1735, #1738). Caller drops.
fn rfs_tmp_path(tag: StrView) -> String
    var s: String = string_from_strview("/tmp/ritz_test_rfs_")
    string_push_str(@&s, tag)
    string_push(@&s, '_')
    string_push_i64(@&s, sys_getpid() as i64)
    s

[[test]]
fn test_tmp_path_is_per_process() -> i32
    var p: String = rfs_tmp_path("x")
    var want: String = string_from_strview("/tmp/ritz_test_rfs_x_")
    string_push_i64(@&want, sys_getpid() as i64)
    let ok: bool = string_eq_string(@p, @want)
    assert ok
    0

[[test]]
fn test_write_and_read_file() -> i32
    var path_s: String = rfs_tmp_path("rw")
    let path: StrView = string_as_view(@path_s)

    var w_res: Result<i64, Errno> = write_file(path, "Hello, Result!")
    if w_res.is_err()
        return 1

    var r_res: Result<String, Errno> = read_file(path)
    unlink(path)
    if read_matches(@r_res, "Hello, Result!") == 0
        return 2
    return 0

[[test]]
fn test_read_nonexistent_file() -> i32
    var path_s: String = rfs_tmp_path("missing")
    var r_res: Result<String, Errno> = read_file(string_as_view(@path_s))
    if r_res.is_err()
        return 0
    return 1

[[test]]
fn test_mkdir_and_rmdir() -> i32
    var path_s: String = rfs_tmp_path("dir")
    let path: StrView = string_as_view(@path_s)

    var mk: Result<i32, Errno> = mkdir(path, 493)  # 0755 octal = 493 decimal
    if unit_failed(@mk) == 1
        return 1

    if not is_dir(path)
        return 2

    var rm: Result<i32, Errno> = rmdir(path)
    if unit_failed(@rm) == 1
        return 3

    let still_there: bool = path_exists(path)
    if still_there
        return 4
    return 0

[[test]]
fn test_copy_file() -> i32
    var src_s: String = rfs_tmp_path("src")
    var dst_s: String = rfs_tmp_path("dst")
    let src: StrView = string_as_view(@src_s)
    let dst: StrView = string_as_view(@dst_s)

    write_file(src, "Content to copy")

    var cp_res: Result<i64, Errno> = copy_file(src, dst, 420)  # 0644 octal = 420 decimal
    if cp_res.is_err()
        unlink(src)
        return 1

    var r_res: Result<String, Errno> = read_file(dst)
    unlink(src)
    unlink(dst)
    if read_matches(@r_res, "Content to copy") == 0
        return 2
    return 0

fn main() -> i32
    return 0
