# 56_async_runtime: Test io_uring-backed async runtime
#
# This tests the async runtime module which provides io_uring integration
# for performing actual async I/O operations.
#
# Tests:
# 1. Runtime initialization and cleanup
# 2. File read via runtime
# 3. File write via runtime
# 4. Round-trip write/read test
# 5. Global runtime convenience functions

import ritzlib.sys
import ritzlib.io
import ritzlib.async.runtime
import ritzlib.result
import ritzlib.str
import ritzlib.os.env
import ritzlib.fmt

# Build "$TMPDIR/<stem>_<pid>.txt" into buf (>= 512 bytes) and return buf;
# TMPDIR unset, empty or overlong means /tmp.  Concurrent runs of this binary
# -- two gates on one host, or two stages of one gate -- must never share a
# file: with a fixed /tmp name one run's unlink landed between another's
# write and read, and regression Stage 1 flaked (AGAST #4207).
fn scratch_path(buf: *u8, stem: *u8) -> *u8
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    memcpy(buf, dir.ptr, dir.len)
    *(buf + dir.len) = 0
    strcat(buf, c"/")
    strcat(buf, stem)
    strcat(buf, c"_")
    itoa(sys_getpid() as i64, buf + strlen(buf))
    strcat(buf, c".txt")
    buf

# ============================================================================
# Test 1: Runtime initialization
# ============================================================================

fn test_runtime_init() -> bool
    print("test_runtime_init... ")

    var rt: Runtime
    let ret: i32 = rt.init()
    if ret < 0
        print("FAIL: runtime_init returned {ret as i64}\n")
        return false

    rt.destroy()
    print("OK\n")
    return true

# ============================================================================
# Test 2: Read file via runtime
# ============================================================================

fn test_runtime_read() -> bool
    print("test_runtime_read... ")

    # Create test file
    var test_file_buf: [512]u8
    let test_file: *u8 = scratch_path(@test_file_buf[0], c"ritz_runtime_read_test")
    let test_data = c"Hello from runtime!"
    let test_len: i32 = 19

    # Write using direct syscall first
    # 0x241 = O_WRONLY | O_CREAT | O_TRUNC, 420 = 0644 octal
    let fd: i32 = sys_open3(test_file, 0x241, 420)
    if fd < 0
        print("FAIL: could not create test file\n")
        return false
    let written: i64 = sys_write(fd, test_data, test_len as i64)
    sys_close(fd)
    if written != test_len as i64
        print("FAIL: write failed\n")
        return false

    # Now read via runtime
    var rt: Runtime
    if rt.init() < 0
        print("FAIL: runtime_init failed\n")
        return false

    let rfd: i32 = sys_open(test_file, 0)  # O_RDONLY
    if rfd < 0
        print("FAIL: could not open test file for reading\n")
        rt.destroy()
        return false

    var buf: [64]u8
    let bytes_read: i64 = match rt.read(rfd, Span<u8> { ptr: (@buf[0]), len: (64) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    sys_close(rfd)
    rt.destroy()

    if bytes_read != test_len as i64
        print("FAIL: expected {test_len as i64} bytes, got {bytes_read}\n")
        return false

    # Verify content
    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data[i]
            print("FAIL: byte mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 3: Write file via runtime
# ============================================================================

fn test_runtime_write() -> bool
    print("test_runtime_write... ")

    var test_file_buf: [512]u8

    let test_file: *u8 = scratch_path(@test_file_buf[0], c"ritz_runtime_write_test")
    let test_data = c"Runtime write test!"
    let test_len: i32 = 19

    # Create/open file (420 = 0644 octal)
    let fd: i32 = sys_open3(test_file, 0x241, 420)
    if fd < 0
        print("FAIL: could not create test file\n")
        return false

    var rt: Runtime
    if rt.init() < 0
        print("FAIL: runtime_init failed\n")
        sys_close(fd)
        return false

    # Write via runtime
    let bytes_written: i64 = match rt.write(fd, Span<u8> { ptr: (test_data), len: (test_len) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    sys_close(fd)
    rt.destroy()

    if bytes_written != test_len as i64
        print("FAIL: expected to write {test_len as i64} bytes, wrote {bytes_written}\n")
        return false

    # Verify by reading back via syscall
    let rfd: i32 = sys_open(test_file, 0)  # O_RDONLY
    if rfd < 0
        print("FAIL: could not open for verification\n")
        return false

    var buf: [64]u8
    let bytes_read: i64 = sys_read(rfd, @buf[0], 64)
    sys_close(rfd)

    if bytes_read != test_len as i64
        print("FAIL: verification read got wrong size\n")
        return false

    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data[i]
            print("FAIL: byte mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 4: Round-trip write/read test
# ============================================================================

fn test_runtime_roundtrip() -> bool
    print("test_runtime_roundtrip... ")

    var test_file_buf: [512]u8

    let test_file: *u8 = scratch_path(@test_file_buf[0], c"ritz_runtime_roundtrip")
    let test_data = c"Round trip test data 12345!"
    let test_len: i32 = 27

    var rt: Runtime
    if rt.init() < 0
        print("FAIL: runtime_init failed\n")
        return false

    # Write (420 = 0644 octal)
    let wfd: i32 = sys_open3(test_file, 0x241, 420)
    if wfd < 0
        print("FAIL: could not create test file\n")
        rt.destroy()
        return false

    let bytes_written: i64 = match rt.write(wfd, Span<u8> { ptr: (test_data), len: (test_len) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    sys_close(wfd)

    if bytes_written != test_len as i64
        print("FAIL: write failed\n")
        rt.destroy()
        return false

    # Read back using same runtime
    let rfd: i32 = sys_open(test_file, 0)  # O_RDONLY
    if rfd < 0
        print("FAIL: could not open for read\n")
        rt.destroy()
        return false

    var buf: [64]u8
    let bytes_read: i64 = match rt.read(rfd, Span<u8> { ptr: (@buf[0]), len: (64) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    sys_close(rfd)
    rt.destroy()

    if bytes_read != test_len as i64
        print("FAIL: read size mismatch\n")
        return false

    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data[i]
            print("FAIL: content mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 5: Close via runtime
# ============================================================================

fn test_runtime_close() -> bool
    print("test_runtime_close... ")

    var test_file_buf: [512]u8

    let test_file: *u8 = scratch_path(@test_file_buf[0], c"ritz_runtime_close_test")

    # Create a file (420 = 0644 octal)
    let fd: i32 = sys_open3(test_file, 0x241, 420)
    if fd < 0
        print("FAIL: could not create test file\n")
        return false

    var rt: Runtime
    if rt.init() < 0
        print("FAIL: runtime_init failed\n")
        sys_close(fd)
        return false

    # Close via runtime
    let ret: i32 = match rt.close(fd)
        Ok(_) => 0
        Err(_) => -1
    rt.destroy()

    if ret < 0
        print("FAIL: runtime_close returned {ret as i64}\n")
        return false

    # Verify fd is closed (second close should fail)
    # Note: We don't check ret2 since behavior varies by system
    let ret2: i32 = sys_close(fd)

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 6: Global runtime
# ============================================================================

fn test_global_runtime() -> bool
    print("test_global_runtime... ")

    let rt: *Runtime = get_runtime()
    if rt == (null)
        print("FAIL: get_runtime returned null\n")
        return false

    # Should be able to get it again
    let rt2: *Runtime = get_runtime()
    if rt != rt2
        print("FAIL: get_runtime returned different pointer\n")
        cleanup_runtime()
        return false

    cleanup_runtime()
    print("OK\n")
    return true

# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    print("=== async runtime (io_uring) tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_runtime_init()
        passed += 1
    else
        failed += 1

    if test_runtime_read()
        passed += 1
    else
        failed += 1

    if test_runtime_write()
        passed += 1
    else
        failed += 1

    if test_runtime_roundtrip()
        passed += 1
    else
        failed += 1

    if test_runtime_close()
        passed += 1
    else
        failed += 1

    if test_global_runtime()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed as i64} passed, {failed as i64} failed\n")

    if failed > 0
        return 1
    return 0
