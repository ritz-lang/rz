# 56_async_runtime: Test io_uring-backed async runtime
#
# This tests the async runtime module which provides io_uring integration
# for performing actual async I/O operations.
#
# Tests:
# 1. Runtime initialization and cleanup
# 2. File read via runtime
# 3. File write via runtime
# 4. Round-trip write/read test
# 5. Global runtime convenience functions

import ritzlib.process { process_id }
import ritzlib.io
import ritzlib.async.runtime
import ritzlib.result
import ritzlib.errno { Errno }
import ritzlib.str
import ritzlib.os.env
import ritzlib.fmt
import ritzlib.span
import ritzlib.strview { StrView }
import ritzlib.string { String, string_new }
import ritzlib.fd { Fd, fd_open, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC }

# "$TMPDIR/<stem>_<pid>.txt"; TMPDIR unset, empty or overlong means /tmp.
# Concurrent runs of this binary -- two gates on one host, or two stages of
# one gate -- must never share a file: with a fixed /tmp name one run's
# unlink landed between another's write and read, and regression Stage 1
# flaked (AGAST #4207).
fn scratch_path(stem: StrView) -> String
    var dir: StrView = env_get_or("TMPDIR", "/tmp")
    if dir.len == 0 or dir.len > 400
        dir = "/tmp"
    var path: String = string_new()
    path.push_str(dir)
    path.push_str("/")
    path.push_str(stem)
    path.push_str("_")
    path.push_i64(process_id() as i64)
    path.push_str(".txt")
    path

# Create (or truncate) the test file for writing, mode 0644.
fn create_test_file(path: @String) -> Result<Fd, Errno>
    fd_open(path.as_view(), O_WRONLY | O_CREAT | O_TRUNC, 420)

fn open_test_file(path: @String) -> Result<Fd, Errno>
    fd_open(path.as_view(), O_RDONLY, 0)

# Runtime.new failed: say why; the test fails.
fn no_runtime(e: Errno) -> bool
    print("FAIL: Runtime.new: {e.name()}\n")
    false

# Runtime.new failed with the test file `f` open: close it, and fail.
fn no_runtime_closing(f: @&Fd, e: Errno) -> bool
    f.close()
    no_runtime(e)

# ============================================================================
# Test 1: Runtime initialization
# ============================================================================

fn test_runtime_init() -> bool
    print("test_runtime_init... ")

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime(e)

    rt.destroy()
    print("OK\n")
    return true

# ============================================================================
# Test 2: Read file via runtime
# ============================================================================

fn test_runtime_read() -> bool
    print("test_runtime_read... ")

    # Create test file
    let test_file: String = scratch_path("ritz_runtime_read_test")
    let test_data: StrView = "Hello from runtime!"
    let test_len: i32 = 19

    # Write directly first
    var f: Fd = match create_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not create test file\n")
            return false
    let written: i64 = match f.write(Span<u8> { ptr: test_data.ptr, len: test_len as i64 })
        Ok(n) => n
        Err(_) => -1
    f.close()
    if written != test_len as i64
        print("FAIL: write failed\n")
        return false

    # Now read via runtime
    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime(e)

    var rf: Fd = match open_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not open test file for reading\n")
            rt.destroy()
            return false

    var buf: [64]u8
    let bytes_read: i64 = match rt.read(rf.raw(), Span<u8> { ptr: (@buf[0]), len: (64) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    rf.close()
    rt.destroy()

    if bytes_read != test_len as i64
        print("FAIL: expected {test_len as i64} bytes, got {bytes_read}\n")
        return false

    # Verify content
    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data.get(i as i64)
            print("FAIL: byte mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 3: Write file via runtime
# ============================================================================

fn test_runtime_write() -> bool
    print("test_runtime_write... ")

    let test_file: String = scratch_path("ritz_runtime_write_test")
    let test_data: StrView = "Runtime write test!"
    let test_len: i32 = 19

    # Create/open file
    var f: Fd = match create_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not create test file\n")
            return false

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime_closing(@&f, e)

    # Write via runtime
    let bytes_written: i64 = match rt.write(f.raw(), Span<u8> { ptr: (test_data.ptr), len: (test_len) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    f.close()
    rt.destroy()

    if bytes_written != test_len as i64
        print("FAIL: expected to write {test_len as i64} bytes, wrote {bytes_written}\n")
        return false

    # Verify by reading back directly
    var rf: Fd = match open_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not open for verification\n")
            return false

    var buf: [64]u8
    let bytes_read: i64 = match rf.read(Span<u8> { ptr: @buf[0], len: 64 })
        Ok(n) => n
        Err(_) => -1
    rf.close()

    if bytes_read != test_len as i64
        print("FAIL: verification read got wrong size\n")
        return false

    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data.get(i as i64)
            print("FAIL: byte mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 4: Round-trip write/read test
# ============================================================================

fn test_runtime_roundtrip() -> bool
    print("test_runtime_roundtrip... ")

    let test_file: String = scratch_path("ritz_runtime_roundtrip")
    let test_data: StrView = "Round trip test data 12345!"
    let test_len: i32 = 27

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime(e)

    # Write
    var wf: Fd = match create_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not create test file\n")
            rt.destroy()
            return false

    let bytes_written: i64 = match rt.write(wf.raw(), Span<u8> { ptr: (test_data.ptr), len: (test_len) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    wf.close()

    if bytes_written != test_len as i64
        print("FAIL: write failed\n")
        rt.destroy()
        return false

    # Read back using same runtime
    var rf: Fd = match open_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not open for read\n")
            rt.destroy()
            return false

    var buf: [64]u8
    let bytes_read: i64 = match rt.read(rf.raw(), Span<u8> { ptr: (@buf[0]), len: (64) as i64 }, 0)
        Ok(n) => n
        Err(_) => -1
    rf.close()
    rt.destroy()

    if bytes_read != test_len as i64
        print("FAIL: read size mismatch\n")
        return false

    var i: i32 = 0
    while i < test_len
        if buf[i] != test_data.get(i as i64)
            print("FAIL: content mismatch at {i as i64}\n")
            return false
        i += 1

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 5: Close via runtime
# ============================================================================

fn test_runtime_close() -> bool
    print("test_runtime_close... ")

    let test_file: String = scratch_path("ritz_runtime_close_test")

    # Create a file
    var f: Fd = match create_test_file(@test_file)
        Ok(opened) => opened
        Err(_) =>
            print("FAIL: could not create test file\n")
            return false

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(e) => return no_runtime_closing(@&f, e)

    # Close via runtime
    let ret: i32 = match rt.close(f.raw())
        Ok(_) => 0
        Err(_) => -1
    rt.destroy()

    if ret < 0
        print("FAIL: runtime_close returned {ret as i64}\n")
        return false

    # Verify fd is closed (second close should fail): the runtime closed the
    # number, so this close(2) of it again gets EBADF.
    # Note: We don't check the result since behavior varies by system
    f.close()

    # Note: File cleanup skipped (unlink not implemented)
    print("OK\n")
    return true

# ============================================================================
# Test 6: Global runtime
# ============================================================================

fn test_global_runtime() -> bool
    print("test_global_runtime... ")

    let rt: @&Runtime = match get_runtime()
        Ok(r) => r
        Err(e) => return no_runtime(e)
    rt.next_user_data = 4242

    # Should be the same runtime again: the mark made through the first
    # reference is seen through the second.
    let rt2: @&Runtime = match get_runtime()
        Ok(r) => r
        Err(e) => return no_global_runtime(e)
    let same: bool = rt2.next_user_data == 4242
    cleanup_runtime()
    if not same
        print("FAIL: get_runtime returned a different runtime\n")
        return false

    print("OK\n")
    return true

# get_runtime failed after it had once succeeded: clean up, and fail.
fn no_global_runtime(e: Errno) -> bool
    cleanup_runtime()
    no_runtime(e)

# ============================================================================
# Main
# ============================================================================

pub fn main() -> i32
    print("=== async runtime (io_uring) tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_runtime_init()
        passed += 1
    else
        failed += 1

    if test_runtime_read()
        passed += 1
    else
        failed += 1

    if test_runtime_write()
        passed += 1
    else
        failed += 1

    if test_runtime_roundtrip()
        passed += 1
    else
        failed += 1

    if test_runtime_close()
        passed += 1
    else
        failed += 1

    if test_global_runtime()
        passed += 1
    else
        failed += 1

    print("\nResults: {passed as i64} passed, {failed as i64} failed\n")

    if failed > 0
        return 1
    return 0
