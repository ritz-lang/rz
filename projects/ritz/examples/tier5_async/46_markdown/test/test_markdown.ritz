# Tests for 46_markdown — Markdown to HTML converter.
import ritzlib.testlib

fn md_run(stdin_data: Span<u8>) -> Result<Captured, Errno>
    exec_capture("./md", span_empty<StrView>(), span_empty<StrView>(), stdin_data)

[[test]]
fn test_md_h1() -> i32
    match md_run("# Hello\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_contains(c.output(), "<h1>Hello</h1>"), "h1 conversion"
        Err(_) =>
            assert false, "spawn ./md"
    0

[[test]]
fn test_md_h2() -> i32
    match md_run("## Level 2\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_contains(c.output(), "<h2>Level 2</h2>"), "h2 conversion"
        Err(_) =>
            assert false, "spawn ./md"
    0

[[test]]
fn test_md_bold() -> i32
    match md_run("**bold**\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_contains(c.output(), "<strong>bold</strong>"), "bold → <strong>"
        Err(_) =>
            assert false, "spawn ./md"
    0

[[test]]
fn test_md_italic() -> i32
    match md_run("*italic*\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_contains(c.output(), "<em>italic</em>"), "italic → <em>"
        Err(_) =>
            assert false, "spawn ./md"
    0
