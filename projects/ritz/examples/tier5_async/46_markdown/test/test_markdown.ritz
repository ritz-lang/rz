# Tests for 46_markdown — Markdown to HTML converter.
import ritzlib.testlib

[[test]]
fn test_md_h1() -> i32
    var argv: [2]*u8
    argv[0] = c"./md"
    argv[1] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./md", @argv[0], null, Span<u8> { ptr: (c"# Hello\n"), len: (8) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"<h1>Hello</h1>"), len: (14) }), "h1 conversion"
    0

[[test]]
fn test_md_h2() -> i32
    var argv: [2]*u8
    argv[0] = c"./md"
    argv[1] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./md", @argv[0], null, Span<u8> { ptr: (c"## Level 2\n"), len: (11) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"<h2>Level 2</h2>"), len: (16) }), "h2 conversion"
    0

[[test]]
fn test_md_bold() -> i32
    var argv: [2]*u8
    argv[0] = c"./md"
    argv[1] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./md", @argv[0], null, Span<u8> { ptr: (c"**bold**\n"), len: (9) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"<strong>bold</strong>"), len: (21) }), "bold → <strong>"
    0

[[test]]
fn test_md_italic() -> i32
    var argv: [2]*u8
    argv[0] = c"./md"
    argv[1] = null
    var out: [4096]u8
    var n: i64 = 0
    let rc: i32 = exec_capture(c"./md", @argv[0], null, Span<u8> { ptr: (c"*italic*\n"), len: (9) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @n)
    assert rc == 0, "exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"<em>italic</em>"), len: (15) }), "italic → <em>"
    0
