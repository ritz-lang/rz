# md - Markdown to HTML converter
#
# Usage: md [FILE]
#   Convert Markdown to HTML.
#
# Supported syntax:
#   # Heading 1        -> <h1>
#   ## Heading 2       -> <h2>
#   *italic*           -> <em>
#   **bold**           -> <strong>
#   `code`             -> <code>
#   [text](url)        -> <a href="url">text</a>
#   - list item        -> <ul><li>
#   1. numbered        -> <ol><li>
#   > quote            -> <blockquote>
#   ```code block```   -> <pre><code>
#   ---                -> <hr>
#   blank line         -> paragraph break
#
# Examples:
#   md README.md > output.html
#   echo "# Hello" | md

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.fmt
import ritzlib.str
import ritzlib.gvec
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.argspec
import ritzlib.fd { Fd, fd_open, fd_stdin, O_RDONLY }

# ============================================================================
# State tracking
# ============================================================================

struct MdState
    in_paragraph: i32
    in_list: i32       # 0=none, 1=ul, 2=ol
    in_code_block: i32
    in_blockquote: i32

fn state_init(s: *MdState) -> i32
    s.in_paragraph = 0
    s.in_list = 0
    s.in_code_block = 0
    s.in_blockquote = 0
    return 0

fn close_paragraph(s: *MdState) -> i32
    if s.in_paragraph != 0
        print("</p>\n")
        s.in_paragraph = 0
    return 0

fn close_list(s: *MdState) -> i32
    if s.in_list == 1
        print("</ul>\n")
    else if s.in_list == 2
        print("</ol>\n")
    s.in_list = 0
    return 0

fn close_blockquote(s: *MdState) -> i32
    if s.in_blockquote != 0
        print("</blockquote>\n")
        s.in_blockquote = 0
    return 0

fn close_all(s: *MdState) -> i32
    close_paragraph(s)
    close_list(s)
    close_blockquote(s)
    return 0

# ============================================================================
# Inline formatting
# ============================================================================

# One raw byte to stdout ({c} in print would format a u8 as a number).
fn put_byte(c: u8)
    var w = stdout_writer()
    w.write_byte(c)

fn escape_html_char(c: u8) -> i32
    if c == '<'  # '<'
        print("&lt;")
        return 1
    if c == '>'  # '>'
        print("&gt;")
        return 1
    if c == 38  # '&'
        print("&amp;")
        return 1
    if c == '"'  # '"'
        print("&quot;")
        return 1
    return 0

fn print_escaped(text: *u8, len: i64) -> i32
    var i: i64 = 0
    while i < len
        let c: u8 = *(text + i)
        if escape_html_char(c) == 0
            put_byte(c)
        i += 1
    return 0

fn process_inline(text: *u8, len: i64) -> i32
    var i: i64 = 0
    while i < len
        let c: u8 = *(text + i)

        # Check for **bold**
        if c == '*' and i + 1 < len and *(text + i + 1) == '*'
            # Find closing **
            var j: i64 = i + 2
            while j + 1 < len
                if *(text + j) == '*' and *(text + j + 1) == '*'
                    print("<strong>")
                    process_inline(text + i + 2, j - i - 2)
                    print("</strong>")
                    i = j + 2
                    break
                j += 1
            if j + 1 >= len
                put_byte(c)
                i += 1
            continue

        # Check for *italic*
        if c == '*'
            # Find closing *
            var j: i64 = i + 1
            while j < len
                if *(text + j) == '*' and (j + 1 >= len or *(text + j + 1) != 42)
                    print("<em>")
                    process_inline(text + i + 1, j - i - 1)
                    print("</em>")
                    i = j + 1
                    break
                j += 1
            if j >= len
                put_byte(c)
                i += 1
            continue

        # Check for `code`
        if c == 96  # backtick
            var j: i64 = i + 1
            while j < len
                if *(text + j) == 96
                    print("<code>")
                    print_escaped(text + i + 1, j - i - 1)
                    print("</code>")
                    i = j + 1
                    break
                j += 1
            if j >= len
                put_byte(c)
                i += 1
            continue

        # Check for [text](url)
        if c == '['  # '['
            var text_end: i64 = i + 1
            while text_end < len and *(text + text_end) != 93  # ']'
                text_end += 1

            if text_end < len and text_end + 1 < len and *(text + text_end + 1) == 40  # '('
                var url_end: i64 = text_end + 2
                while url_end < len and *(text + url_end) != 41  # ')'
                    url_end += 1

                if url_end < len
                    print("<a href=\"")
                    print_escaped(text + text_end + 2, url_end - text_end - 2)
                    print("\">")
                    process_inline(text + i + 1, text_end - i - 1)
                    print("</a>")
                    i = url_end + 1
                    continue

            put_byte(c)
            i += 1
            continue

        # Regular character
        if escape_html_char(c) == 0
            put_byte(c)
        i += 1

    return 0

# ============================================================================
# Line processing
# ============================================================================

fn count_leading(line: *u8, len: i64, c: u8) -> i32
    var count: i32 = 0
    var i: i64 = 0
    while i < len and *(line + i) == c
        count += 1
        i += 1
    return count

fn is_blank_line(line: *u8, len: i64) -> i32
    var i: i64 = 0
    while i < len
        let c: u8 = *(line + i)
        if c != ' ' and c != '\t' and c != '\n' and c != '\r'
            return 0
        i += 1
    return 1

fn is_hr_line(line: *u8, len: i64) -> i32
    var count: i32 = 0
    var i: i64 = 0
    while i < len
        let c: u8 = *(line + i)
        if c == '-' or c == '*' or c == '_'  # - * _
            count += 1
        else if c != ' ' and c != '\t' and c != '\n' and c != '\r'
            return 0
        i += 1
    return (count >= 3) as i32

fn process_line(s: *MdState, line: *u8, len: i64) -> i32
    # Remove trailing newline
    var line_len: i64 = len
    while line_len > 0 and (*(line + line_len - 1) == '\n' or *(line + line_len - 1) == '\r')
        line_len -= 1

    # Handle code blocks
    if line_len >= 3 and *line == 96 and *(line + 1) == 96 and *(line + 2) == 96
        if s.in_code_block != 0
            print("</code></pre>\n")
            s.in_code_block = 0
        else
            close_all(s)
            print("<pre><code>")
            s.in_code_block = 1
        return 0

    if s.in_code_block != 0
        print_escaped(line, line_len)
        print("\n")
        return 0

    # Blank line
    if is_blank_line(line, line_len) != 0
        close_paragraph(s)
        return 0

    # Horizontal rule
    if is_hr_line(line, line_len) != 0
        close_all(s)
        print("<hr>\n")
        return 0

    # Headings
    let hash_count: i32 = count_leading(line, line_len, 35)  # '#'
    if hash_count >= 1 and hash_count <= 6 and *(line + hash_count) == ' '
        close_all(s)
        print("<h{hash_count}>")
        process_inline(line + hash_count + 1, line_len - hash_count - 1)
        print("</h{hash_count}>\n")
        return 0

    # Blockquote
    if *line == '>'  # '>'
        if s.in_blockquote == 0
            close_all(s)
            print("<blockquote>\n")
            s.in_blockquote = 1
        var start: i64 = 1
        if start < line_len and *(line + start) == ' '
            start += 1
        process_inline(line + start, line_len - start)
        print("\n")
        return 0
    else if s.in_blockquote != 0
        close_blockquote(s)

    # Unordered list
    if (*line == '-' or *line == '*') and line_len > 1 and *(line + 1) == ' '
        close_paragraph(s)
        if s.in_list != 1
            close_list(s)
            print("<ul>\n")
            s.in_list = 1
        print("<li>")
        process_inline(line + 2, line_len - 2)
        print("</li>\n")
        return 0

    # Ordered list (simple: starts with digit and .)
    if line_len > 2 and *line >= '0' and *line <= '9'  # '0'-'9'
        var i: i64 = 0
        while i < line_len and *(line + i) >= '0' and *(line + i) <= '9'
            i += 1
        if i < line_len and *(line + i) == '.' and i + 1 < line_len and *(line + i + 1) == ' '
            close_paragraph(s)
            if s.in_list != 2
                close_list(s)
                print("<ol>\n")
                s.in_list = 2
            print("<li>")
            process_inline(line + i + 2, line_len - i - 2)
            print("</li>\n")
            return 0

    # End list if this isn't a list item
    if s.in_list != 0
        close_list(s)

    # Paragraph
    if s.in_paragraph == 0
        print("<p>")
        s.in_paragraph = 1
    else
        print(" ")  # Continue paragraph with space

    process_inline(line, line_len)
    return 0

# ============================================================================
# File processing
# ============================================================================

fn process_stream(f: @Fd) -> i32
    var state: MdState
    state_init(@state)

    var buf: [4096]u8
    var line_start: i64 = 0
    var buf_len: i64 = 0

    while 1 == 1
        let n: i64 = match f.read(Span<u8> { ptr: @buf[0] + buf_len, len: 4096 - buf_len })
            Ok(got) => got
            Err(_) => return -1
        if n == 0
            # Process remaining data
            if buf_len > line_start
                process_line(@state, @buf[0] + line_start, buf_len - line_start)
            break

        buf_len += n

        # Process complete lines
        var i: i64 = line_start
        while i < buf_len
            if buf[i] == '\n'
                process_line(@state, @buf[0] + line_start, i - line_start + 1)
                line_start = i + 1
            i += 1

        # Move remaining data
        if line_start > 0
            var j: i64 = 0
            while line_start + j < buf_len
                buf[j] = buf[line_start + j]
                j += 1
            buf_len -= line_start
            line_start = 0

    # Close any open tags
    if state.in_code_block != 0
        print("</code></pre>\n")
    close_all(@state)

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("md", "Markdown to HTML converter")
    spec.positionals("FILE", "Markdown file (stdin if omitted)", 0, 1)
    spec

# A usage error: argspec_parse says what was wrong; report it and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn md_path(file: StrView) -> i32
    match fd_open(file, O_RDONLY, 0)
        Ok(opened) =>
            var f: Fd = opened
            let result: i32 = process_stream(@f)
            f.close()
            if result < 0
                return 1
            0
        Err(_) =>
            eprint("md: cannot open file: {file}\n")
            1

fn md_stdin() -> i32
    if process_stream(@fd_stdin()) < 0
        return 1
    0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status: i32 = match parsed.positional(0)
        Some(f) => md_path(f)
        None => md_stdin()
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
