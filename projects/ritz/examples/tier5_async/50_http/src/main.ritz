# 50_http: Simple HTTP/1.0 server
#
# A minimal HTTP server demonstrating:
# - Socket networking with ritzlib/net.ritz
# - Request parsing with Span<u8>
# - Response generation with String
# - Connection handling
#
# Usage: http [port]
#   Port: the argument if given, else RITZ_EXAMPLE_PORT, else 8080
#
# Example:
#   ./http 8080 &
#   curl http://localhost:8080/
#   curl http://localhost:8080/hello
#
# Architecture:
# - Single-threaded, blocking I/O (simple starting point)
# - HTTP/1.0 (connection closes after each request)
# - Future: HTTP/1.1 (keep-alive), epoll for async I/O

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.string
import ritzlib.gvec
import ritzlib.span
import ritzlib.net
import ritzlib.strview
import ritzlib.option
import ritzlib.os.env

# ============================================================================
# HTTP Request parsing
# ============================================================================

struct HttpRequest
    method: Span<u8>      # GET, POST, etc.
    path: Span<u8>        # /path/to/resource
    version: Span<u8>     # HTTP/1.0 or HTTP/1.1
    raw: Vec<u8>          # Raw request data (owns memory)

# Parse HTTP request from raw bytes
# Returns 1 on success, 0 on failure
fn parse_request(req: *HttpRequest, data: *Vec<u8>) -> i32
    # Move raw data ownership
    req.raw = vec_new<u8>()
    var i: i64 = 0
    while i < data.len()
        req.raw.push(data.get(i))
        i += 1

    var full: Span<u8> = span_from_vec<u8>(@req.raw)

    # Find first space (end of method)
    var method_end: i64 = 0
    while method_end < full.len and span_get<u8>(@full, method_end) != ' '  # ' '
        method_end += 1

    if method_end >= full.len
        return 0

    req.method = span_slice<u8>(@full, 0, method_end)

    # Find second space (end of path)
    var path_start: i64 = method_end + 1
    var path_end: i64 = path_start
    while path_end < full.len and span_get<u8>(@full, path_end) != ' '
        path_end += 1

    if path_end >= full.len
        return 0

    req.path = span_slice<u8>(@full, path_start, path_end)

    # Find end of version (CR or LF)
    var version_start: i64 = path_end + 1
    var version_end: i64 = version_start
    while version_end < full.len
        let c: u8 = span_get<u8>(@full, version_end)
        if c == '\r' or c == '\n'  # CR or LF
            version_end -= 1
            version_end += 1
            break
        version_end += 1

    req.version = span_slice<u8>(@full, version_start, version_end)

    return 1

# ============================================================================
# HTTP Response generation
# ============================================================================

# Send an HTTP response: the status line and headers, then the body.
# Ok(bytes sent), or the errno of the first send that failed.
fn send_response(client: @&Socket, status: i32, content_type: StrView, body: StrView) -> Result<i64, i32>
    var response: String = string_new()

    # Status line
    response.push_str("HTTP/1.0 ")
    if status == 200
        response.push_str("200 OK")
    else if status == 404
        response.push_str("404 Not Found")
    else if status == 400
        response.push_str("400 Bad Request")
    else
        response.push_str("500 Internal Server Error")
    response.push_str("\r\n")

    # Headers
    response.push_str("Content-Type: ")
    response.push_str(content_type)
    response.push_str("\r\n")

    response.push_str("Content-Length: ")
    response.push_i64(body.len)
    response.push_str("\r\n")

    response.push_str("Connection: close\r\n")
    response.push_str("\r\n")

    let header: Result<i64, i32> = client.send_str(response.as_view())
    string_drop(@&response)
    let header_sent: i64 = header?
    let body_sent: i64 = client.send_str(body)?
    Ok(header_sent + body_sent)

# ============================================================================
# Request handlers
# ============================================================================

fn handle_root(client: @&Socket) -> Result<i64, i32>
    let body = "<!DOCTYPE html>\n<html>\n<head><title>Ritz HTTP Server</title></head>\n<body>\n<h1>Welcome to Ritz HTTP Server</h1>\n<p>A high-performance web server written in Ritz.</p>\n<ul>\n<li><a href=\"/hello\">Hello World</a></li>\n<li><a href=\"/info\">Server Info</a></li>\n</ul>\n</body>\n</html>\n"
    send_response(client, 200, "text/html", body)

fn handle_hello(client: @&Socket) -> Result<i64, i32>
    send_response(client, 200, "text/plain", "Hello, World!\n")

fn handle_info(client: @&Socket) -> Result<i64, i32>
    send_response(client, 200, "text/plain", "Ritz HTTP Server v0.1\nHTTP/1.0 compatible\nSingle-threaded, blocking I/O\n")

fn handle_not_found(client: @&Socket) -> Result<i64, i32>
    send_response(client, 404, "text/plain", "404 Not Found\n")

fn handle_bad_request(client: @&Socket) -> Result<i64, i32>
    send_response(client, 400, "text/plain", "400 Bad Request\n")

# ============================================================================
# Connection handling
# ============================================================================

# Whether `buf` ends with the blank line that closes the request headers.
fn headers_done(buf: @Vec<u8>) -> bool
    if buf.len < 4
        return false
    let end: *u8 = buf.data + buf.len - 4
    *end == '\r' and *(end + 1) == '\n' and *(end + 2) == '\r' and *(end + 3) == '\n'

fn handle_connection(client: @&Socket)
    # Read the request, up to 4 KiB, until the end of the headers or EOF.
    var buf: Vec<u8> = vec_with_cap<u8>(4096)
    while buf.len < 4096 and not headers_done(@buf)
        match client.recv(@&buf, 1024)
            Ok(n) =>
                if n == 0
                    break
            Err(_) => break

    # Parse request
    var req: HttpRequest
    if parse_request(@req, @buf) == 0
        handle_bad_request(client)
        return

    # Route request
    var path_hello: Span<u8> = span_from_cstr("/hello")
    var path_info: Span<u8> = span_from_cstr("/info")
    var path_root: Span<u8> = span_from_cstr("/")

    if span_eq(@req.path, @path_root)
        handle_root(client)
    else if span_eq(@req.path, @path_hello)
        handle_hello(client)
    else if span_eq(@req.path, @path_info)
        handle_info(client)
    else
        handle_not_found(client)

# ============================================================================
# Main server loop
# ============================================================================

# Port to listen on when none is given on the command line.  regression.sh
# passes a free per-run port in RITZ_EXAMPLE_PORT so it cannot collide with
# whatever else holds 8080 on the host (AGAST #1535, #3136); run by hand, the
# example keeps its historical default.
fn port_in_range(p: i64, default_port: i32) -> i32
    if p <= 0 or p > 65535
        return default_port
    return p as i32

fn port_or(o: Option<i64>, default_port: i32) -> i32
    match o
        Some(p) => port_in_range(p, default_port)
        None => default_port

# Unset, empty or non-numeric all fall back to the default.
fn listen_port(default_port: i32) -> i32
    let s: StrView = env_get_or("RITZ_EXAMPLE_PORT", "")
    return port_or(strview_parse_i64(s), default_port)

fn main(argc: i32, argv: **u8) -> i32
    # The command line wins; otherwise RITZ_EXAMPLE_PORT, otherwise 8080.
    var port: i32 = listen_port(8080)
    if argc > 1
        port = atoi(*(argv + 1))
        if port <= 0 or port > 65535
            prints("Invalid port number\n")
            return 1

    # Create server socket
    var server: Socket = socket_tcp()
    if not server.valid()
        prints("Failed to create socket\n")
        return 1

    # Set socket options
    if server.set_reuseaddr() < 0
        prints("Failed to set SO_REUSEADDR\n")

    # Bind to address
    match server.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            prints("Failed to bind to port ")
            print_int(port)
            prints("\n")
            return 1

    # Listen for connections
    if server.listen(128) < 0
        prints("Failed to listen\n")
        return 1

    prints("Ritz HTTP server listening on port ")
    print_int(port)
    prints("\n")
    prints("Press Ctrl+C to stop\n")

    # Accept loop
    var running: i32 = 1
    while running == 1
        var client: Socket = server.accept()
        if client.valid()
            handle_connection(@&client)
            client.close()

    server.close()
    0
