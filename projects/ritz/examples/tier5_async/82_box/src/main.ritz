# Example 82: box — ritzlib.box's Box<T>, one heap-allocated value
#
# Written for ritzlib.heap (AGAST #1463), whose Heap<T> was Box<T> under a
# heap_ prefix; ported to ritzlib.box when heap.ritz was folded away (#3916).
# 72_raii only touches box_new/.get/.set, so this is box's full-API example
# for the differential ritz0-vs-ritz1 stages.  "push" here means boxing a
# value into the next slot and "pop" means reading it back and dropping the
# box, in insertion order.
#
# Covers every public function -- box_new, box_get, box_set, box_as_ptr,
# box_valid, box_drop -- plus the method forms (.get/.set) and a Box of a
# struct.  box_drop nulls the pointer, so the automatic Drop at scope exit
# (and a second box_drop) is a no-op on an already-dropped box.

import ritzlib.io
import ritzlib.box

const N: i64 = 5

struct Point
    x: i64
    y: i64

fn main() -> i32
    var values: [5]i64
    values[0] = 3
    values[1] = 1
    values[2] = 4
    values[3] = 1
    values[4] = 5

    # Push: box each value into its own heap allocation.  An array whose
    # elements have Drop must be initialised up front, so fill every slot
    # with a placeholder box, then free it and box the real value.
    var boxes: [5]Box<i64> = [box_new<i64>(0), box_new<i64>(0), box_new<i64>(0), box_new<i64>(0), box_new<i64>(0)]
    var pushed: i64 = 0
    while pushed < N
        box_drop<i64>(@&boxes[pushed])
        boxes[pushed] = box_new<i64>(values[pushed])
        let v: i64 = box_get<i64>(@boxes[pushed])
        let ok: i32 = box_valid<i64>(@boxes[pushed])
        print("push {v}: valid={ok}\n")
        pushed += 1
    print("pushed: {pushed}\n")

    var sum: i64 = 0
    var i: i64 = 0
    while i < N
        sum += box_get<i64>(@boxes[i])
        i += 1
    print("sum via box_get: {sum}\n")

    # Pop: read each box back in order, then free it.
    var popped: i64 = 0
    while popped < N
        let v: i64 = box_get<i64>(@boxes[popped])
        box_drop<i64>(@&boxes[popped])
        let ok: i32 = box_valid<i64>(@boxes[popped])
        print("pop {popped}: {v} (valid after drop: {ok})\n")
        popped += 1
    print("popped: {popped}\n")

    # In-place updates: box_set, and a write through box_as_ptr.
    var h: Box<i64> = box_new<i64>(0)
    box_set<i64>(@&h, 7)
    print("set 7 -> get: {box_get<i64>(@h)}\n")
    let p: *i64 = box_as_ptr<i64>(@h)
    *p = 9
    print("as_ptr write 9 -> get: {box_get<i64>(@h)}\n")
    print("method get: {h.get()}\n")
    h.set(11)
    print("method set 11 -> get: {h.get()}\n")
    box_drop<i64>(@&h)
    box_drop<i64>(@&h)
    print("double drop safe: {box_valid<i64>(@h)}\n")

    # A struct in the box.
    var hp: Box<Point> = box_new<Point>(Point { x: 3, y: 4 })
    let pt: Point = box_get<Point>(@hp)
    print("point: {pt.x},{pt.y}\n")
    box_drop<Point>(@&hp)
    return 0
