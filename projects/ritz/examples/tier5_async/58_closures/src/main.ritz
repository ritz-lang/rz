# 58_closures: what to write now that Ritz has no closures (LARB R56)
#
# `|x| e` and an anonymous `fn(...) e` are parse errors (LANGUAGE_SPEC §5.6).
# Each case below is one that used to be a closure:
# 1. A closure with no captures      -> a named fn, passed by name (§5.5)
# 2. A closure capturing one value   -> a struct holding the value and a fn
#                                       field, called as `h.f(h.n, x)` (R41)
# 3. A closure capturing two values  -> the same, with two fields
# 4. A closure passed to a HOF       -> a named fn passed to it
# 5. A closure of two params         -> a named fn of two params
# 6. compose(f, g)                   -> a struct of two fn fields

import ritzlib.sys
import ritzlib.io

fn check(name: StrView, got: i32, want: i32) -> bool
    if got == want
        return true
    prints("FAIL: ")
    prints(name)
    prints(" = ")
    print_int(got as i64)
    prints(", expected ")
    print_int(want as i64)
    prints("\n")
    false

# ============================================================================
# Test 1: a named fn instead of a capture-free closure
# ============================================================================

fn double(x: i32) -> i32
    x * 2

fn inc(x: i32) -> i32
    x + 1

fn test_named_fn() -> bool
    prints("test_named_fn... ")
    let f: fn(i32) -> i32 = double
    if not check("f(5)", f(5), 10)
        return false
    prints("OK\n")
    true

# ============================================================================
# Test 2: one captured value in a struct beside a fn field
# ============================================================================

fn add(n: i32, x: i32) -> i32
    x + n

struct Adder
    n: i32
    f: fn(i32, i32) -> i32

fn make_adder(n: i32) -> Adder
    Adder { n: n, f: add }

fn test_single_state() -> bool
    prints("test_single_state... ")
    let add5 = make_adder(5)
    let add10 = make_adder(10)
    if not check("add5(3)", add5.f(add5.n, 3), 8)
        return false
    if not check("add10(3)", add10.f(add10.n, 3), 13)
        return false
    # Each struct carries its own state.
    if not check("add5(7)", add5.f(add5.n, 7), 12)
        return false
    prints("OK\n")
    true

# ============================================================================
# Test 3: two values of state
# ============================================================================

fn linear(a: i32, b: i32, x: i32) -> i32
    a * x + b

struct Linear
    a: i32
    b: i32
    f: fn(i32, i32, i32) -> i32

fn make_linear(a: i32, b: i32) -> Linear
    Linear { a: a, b: b, f: linear }

impl Linear
    fn at(self, x: i32) -> i32
        self.f(self.a, self.b, x)

fn test_multi_state() -> bool
    prints("test_multi_state... ")
    let f = make_linear(2, 3)  # 2x + 3
    if not check("f(0)", f.at(0), 3)
        return false
    if not check("f(5)", f.at(5), 13)
        return false
    let g = make_linear(3, 1)  # 3x + 1
    if not check("g(4)", g.at(4), 13)
        return false
    prints("OK\n")
    true

# ============================================================================
# Test 4: a named fn passed to a higher-order fn
# ============================================================================

fn apply_twice(f: fn(i32) -> i32, x: i32) -> i32
    f(f(x))

fn test_higher_order() -> bool
    prints("test_higher_order... ")
    if not check("apply_twice(inc, 5)", apply_twice(inc, 5), 7)
        return false
    if not check("apply_twice(double, 10)", apply_twice(double, 10), 40)
        return false
    prints("OK\n")
    true

# ============================================================================
# Test 5: two params
# ============================================================================

fn sum(a: i32, b: i32) -> i32
    a + b

fn product(a: i32, b: i32) -> i32
    a * b

fn combine(op: fn(i32, i32) -> i32, a: i32, b: i32) -> i32
    op(a, b)

fn test_two_params() -> bool
    prints("test_two_params... ")
    if not check("combine(sum, 3, 4)", combine(sum, 3, 4), 7)
        return false
    if not check("combine(product, 3, 4)", combine(product, 3, 4), 12)
        return false
    prints("OK\n")
    true

# ============================================================================
# Test 6: compose(f, g) as a struct of two fn fields
# ============================================================================

struct Compose
    f: fn(i32) -> i32
    g: fn(i32) -> i32

impl Compose
    fn call(self, x: i32) -> i32
        self.f(self.g(x))

fn test_compose() -> bool
    prints("test_compose... ")
    # double(inc(5)) = 12
    let double_after_inc = Compose { f: double, g: inc }
    if not check("(double . inc)(5)", double_after_inc.call(5), 12)
        return false
    # inc(double(5)) = 11
    let inc_after_double = Compose { f: inc, g: double }
    if not check("(inc . double)(5)", inc_after_double.call(5), 11)
        return false
    prints("OK\n")
    true

# ============================================================================
# Main
# ============================================================================

fn main() -> i32
    prints("=== fn-pointer tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    if test_named_fn()
        passed += 1
    else
        failed += 1

    if test_single_state()
        passed += 1
    else
        failed += 1

    if test_multi_state()
        passed += 1
    else
        failed += 1

    if test_higher_order()
        passed += 1
    else
        failed += 1

    if test_two_params()
        passed += 1
    else
        failed += 1

    if test_compose()
        passed += 1
    else
        failed += 1

    prints("\nResults: ")
    print_int(passed as i64)
    prints(" passed, ")
    print_int(failed as i64)
    prints(" failed\n")

    if failed > 0
        return 1
    0
