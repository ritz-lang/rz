# tee - read from stdin, write to stdout and files
#
# Usage: tee [OPTIONS] [FILE]...
#   Copy standard input to each FILE, and also to standard output.
#
# Options:
#   -a, --append    Append to the given FILEs, do not overwrite
#   -h, --help      Display this help and exit
#
# Exit status:
#   0 - success
#   1 - error opening or writing to a file
#
# Examples:
#   echo "hello" | tee file.txt           # write to file and stdout
#   echo "hello" | tee a.txt b.txt        # write to multiple files
#   echo "more" | tee -a file.txt         # append to file

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec
import ritzlib.fd { Fd, fd_open, fd_stdin, fd_stdout }

# Diagnostic helper — see 24_cp.  StrView prefix/suffix for fixed
# message text; the path comes from argv.
fn tee_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

# ============================================================================
# Constants
# ============================================================================

const BUF_SIZE: i64 = 4096
const MAX_FILES: i32 = 64

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("tee", "Copy standard input to each FILE, and also to standard output.")
    spec.switch('a', "append", "Append to the given FILEs, do not overwrite")
    spec.switch('h', "help", "Display this help and exit")
    spec.positionals("FILE", "Output file(s)", 0, ARGS_UNLIMITED)
    spec

# "tee: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn tee(p: @ParsedArgs) -> i32
    let append_mode: i32 = p.switch("append") as i32

    # Open output files
    var files: [64]Fd  # MAX_FILES
    var num_fds: i32 = 0
    var exit_code: i32 = 0

    let pos = p.positionals()
    for i in 0..pos.len
        let path: StrView = pos.get(i)

        # Determine flags for open
        var flags: i32 = O_WRONLY | O_CREAT
        if append_mode != 0
            flags = flags | O_APPEND
        else
            flags = flags | O_TRUNC

        # Open with mode 0644 (rw-r--r--)
        let mode: i32 = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH
        match fd_open(path, flags, mode)
            Ok(opened) =>
                if num_fds < MAX_FILES
                    files[num_fds] = opened
                    num_fds += 1
            Err(_) =>
                tee_err2("tee: ", path, ": cannot open file")
                exit_code = 1

    # Read from stdin, write to stdout and all files
    var buf: [4096]u8  # Stack-allocated buffer (idiomatic Ritz)

    var done: i32 = 0
    while done == 0
        let n: i64 = match fd_stdin().read(Span<u8> { ptr: @buf[0], len: BUF_SIZE })
            Ok(got) => got
            Err(_) => -1

        if n < 0
            eprint("tee: read error\n")
            exit_code = 1
            done = 1
        else if n == 0
            # EOF
            done = 1
        else
            # Write to stdout
            let chunk: Span<u8> = Span<u8> { ptr: @buf[0], len: n }
            if fd_stdout().write_all(chunk).is_err()
                eprint("tee: write error\n")
                exit_code = 1
                done = 1

            # Write to all output files
            if done == 0
                for j in 0..num_fds
                    if files[j].write_all(chunk).is_err()
                        eprint("tee: write error\n")
                        exit_code = 1

    # Close all output files
    for k in 0..num_fds
        files[k].close()

    return exit_code

fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    var status: i32 = 0
    if parsed.switch("help")
        spec.print_help()
    else
        status = tee(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
