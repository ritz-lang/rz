# tee - read from stdin, write to stdout and files
#
# Usage: tee [OPTIONS] [FILE]...
#   Copy standard input to each FILE, and also to standard output.
#
# Options:
#   -a, --append    Append to the given FILEs, do not overwrite
#   -h, --help      Display this help and exit
#
# Exit status:
#   0 - success
#   1 - error opening or writing to a file
#
# Examples:
#   echo "hello" | tee file.txt           # write to file and stdout
#   echo "hello" | tee a.txt b.txt        # write to multiple files
#   echo "more" | tee -a file.txt         # append to file

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.  StrView prefix/suffix for fixed
# message text; *u8 path comes from argv.
fn tee_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)
    return 1

# ============================================================================
# Constants
# ============================================================================

const BUF_SIZE: i64 = 4096
const MAX_FILES: i32 = 64

# ============================================================================
# Helper functions
# ============================================================================

# Write all bytes to a file descriptor
# Returns 0 on success, -1 on error
fn write_all(fd: i32, buf: *u8, count: i64) -> i32
    var written: i64 = 0
    while written < count
        let n: i64 = sys_write(fd, buf + written, count - written)
        if n < 0
            return -1
        written += n
    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("tee", "Copy standard input to each FILE, and also to standard output.")
    argspec_switch(@&spec, 'a', "append", "Append to the given FILEs, do not overwrite")
    argspec_switch(@&spec, 'h', "help", "Display this help and exit")
    argspec_positionals(@&spec, "FILE", "Output file(s)", 0, ARGS_UNLIMITED)
    spec

# "tee: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn tee(p: @ParsedArgs) -> i32
    let append_mode: i32 = parsed_switch(p, "append") as i32

    # Open output files
    var fds: [64]i32  # MAX_FILES
    var num_fds: i32 = 0
    var exit_code: i32 = 0

    let pos = parsed_positionals(p)
    for i in 0..pos.len
        let path: *u8 = positional_cstr(@pos, i)

        # Determine flags for open
        var flags: i32 = O_WRONLY | O_CREAT
        if append_mode != 0
            flags = flags | O_APPEND
        else
            flags = flags | O_TRUNC

        # Open with mode 0644 (rw-r--r--)
        let mode: i32 = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH
        let fd: i32 = sys_open3(path, flags, mode)

        if fd < 0
            tee_err2("tee: ", path, ": cannot open file")
            exit_code = 1
        else
            if num_fds < MAX_FILES
                fds[num_fds] = fd
                num_fds += 1

    # Read from stdin, write to stdout and all files
    var buf: [4096]u8  # Stack-allocated buffer (idiomatic Ritz)

    var done: i32 = 0
    while done == 0
        let n: i64 = sys_read(STDIN, @buf[0], BUF_SIZE)

        if n < 0
            eprintln("tee: read error")
            exit_code = 1
            done = 1
        else if n == 0
            # EOF
            done = 1
        else
            # Write to stdout
            if write_all(STDOUT, @buf[0], n) < 0
                eprintln("tee: write error")
                exit_code = 1
                done = 1

            # Write to all output files
            if done == 0
                for j in 0..num_fds
                    if write_all(fds[j], @buf[0], n) < 0
                        eprintln("tee: write error")
                        exit_code = 1

    # Close all output files
    for k in 0..num_fds
        sys_close(fds[k])

    return exit_code

fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    var status: i32 = 0
    if parsed_switch(@parsed, "help")
        argspec_print_help(spec)
    else
        status = tee(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
