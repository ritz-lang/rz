# Tests for 38_tee — read from stdin, write to stdout and files.
#
# Helpers (exec_capture, sandbox_path, buf_eq) live in ritzlib.testlib,
# read_file in ritzlib.fs; see docs/TESTING.md.

import ritzlib.sys
import ritzlib.testlib
import ritzlib.fs

[[test]]
fn test_tee_single_file() -> i32
    var path: String = sandbox_path("tee", "single")
    sys_unlink(path.as_ptr())

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./tee", @args, span_empty<StrView>(), "hello")
    let back: Result<String, Errno> = read_file(path.as_view())
    sys_unlink(path.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "tee single should exit 0"
            assert c.out.len == 5, "stdout should be 5 bytes"
            assert buf_eq(c.output(), "hello"), "stdout mismatch"
        Err(_) =>
            assert false, "spawn ./tee"
    match back
        Ok(s) =>
            assert s.len() == 5, "file should be 5 bytes"
            assert s.eq("hello"), "file content mismatch"
        Err(_) =>
            assert false, "file should be readable"
    0

[[test]]
fn test_tee_multiple_files() -> i32
    var p1: String = sandbox_path("tee", "a")
    var p2: String = sandbox_path("tee", "b")
    sys_unlink(p1.as_ptr())
    sys_unlink(p2.as_ptr())

    let args: [2]StrView = [p1.as_view(), p2.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./tee", @args, span_empty<StrView>(), "world")
    let b1: Result<String, Errno> = read_file(p1.as_view())
    let b2: Result<String, Errno> = read_file(p2.as_view())
    sys_unlink(p1.as_ptr())
    sys_unlink(p2.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "tee multi should exit 0"
            assert c.out.len == 5, "stdout 5 bytes"
        Err(_) =>
            assert false, "spawn ./tee"
    match b1
        Ok(s) =>
            assert s.len() == 5, "file 1 should have 5 bytes"
            assert s.eq("world"), "file 1 content mismatch"
        Err(_) =>
            assert false, "file 1 should be readable"
    match b2
        Ok(s) =>
            assert s.len() == 5, "file 2 should have 5 bytes"
            assert s.eq("world"), "file 2 content mismatch"
        Err(_) =>
            assert false, "file 2 should be readable"
    0

[[test]]
fn test_tee_overwrite_default() -> i32
    var path: String = sandbox_path("tee", "ow")
    sys_unlink(path.as_ptr())

    let args: [1]StrView = [path.as_view()]
    let first: Result<Captured, Errno> = exec_capture("./tee", @args, span_empty<StrView>(), "first")
    let r: Result<Captured, Errno> = exec_capture("./tee", @args, span_empty<StrView>(), "second")
    let back: Result<String, Errno> = read_file(path.as_view())
    sys_unlink(path.as_ptr())

    match first
        Ok(_) => pass
        Err(_) =>
            assert false, "spawn ./tee (first)"
    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "second tee should exit 0"
        Err(_) =>
            assert false, "spawn ./tee"
    match back
        Ok(s) =>
            assert s.len() == 6, "file should be 6 bytes after overwrite"
            assert s.eq("second"), "file should contain 'second'"
        Err(_) =>
            assert false, "file should be readable"
    0

[[test]]
fn test_tee_append_flag() -> i32
    var path: String = sandbox_path("tee", "ap")
    sys_unlink(path.as_ptr())

    let args1: [1]StrView = [path.as_view()]
    let first: Result<Captured, Errno> = exec_capture("./tee", @args1, span_empty<StrView>(), "line1\n")

    let args2: [2]StrView = ["-a", path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./tee", @args2, span_empty<StrView>(), "line2\n")
    let back: Result<String, Errno> = read_file(path.as_view())
    sys_unlink(path.as_ptr())

    match first
        Ok(_) => pass
        Err(_) =>
            assert false, "spawn ./tee (first)"
    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "tee -a should exit 0"
        Err(_) =>
            assert false, "spawn ./tee"
    match back
        Ok(s) =>
            assert s.len() == 12, "file should have 12 bytes after append"
            assert s.eq("line1\nline2\n"), "appended content mismatch"
        Err(_) =>
            assert false, "file should be readable"
    0

[[test]]
fn test_tee_no_files_passthrough() -> i32
    match exec_capture("./tee", span_empty<StrView>(), span_empty<StrView>(), "passthrough")
        Ok(c) =>
            assert c.status.exit_code == 0, "tee should exit 0"
            assert c.out.len == 11, "stdout should be 11 bytes"
            assert buf_eq(c.output(), "passthrough"), "passthrough mismatch"
        Err(_) =>
            assert false, "spawn ./tee"
    0
