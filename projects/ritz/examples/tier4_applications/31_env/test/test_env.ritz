# Tests for 31_env — print environment variables.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_env_prints_provided_vars() -> i32
    let env: [3]StrView = ["FOO=bar", "BAZ=qux", "NAME=ritz"]
    match exec_capture("./env", span_empty<StrView>(), @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "env should exit 0"
            assert buf_contains(c.output(), "FOO=bar"), "missing FOO=bar"
            assert buf_contains(c.output(), "BAZ=qux"), "missing BAZ=qux"
            assert buf_contains(c.output(), "NAME=ritz"), "missing NAME=ritz"
        Err(_) =>
            assert false, "spawn ./env"
    0

[[test]]
fn test_env_empty_envp() -> i32
    match exec_capture("./env", span_empty<StrView>(), span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "env empty should exit 0"
            assert c.out.len == 0, "expected empty output with empty envp"
        Err(_) =>
            assert false, "spawn ./env"
    0

[[test]]
fn test_env_output_format() -> i32
    let env: [2]StrView = ["A=1", "B=2"]
    match exec_capture("./env", span_empty<StrView>(), @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "env should exit 0"
            let o: Span<u8> = c.output()
            var equals: i64 = 0
            var newlines: i64 = 0
            var i: i64 = 0
            while i < o.len
                let ch: u8 = *(o.ptr + i)
                if ch == ('=' as u8)
                    equals += 1
                if ch == 10
                    newlines += 1
                i += 1
            assert equals == 2, "expected 2 '=' signs"
            assert newlines == 2, "expected 2 newlines"
        Err(_) =>
            assert false, "spawn ./env"
    0
