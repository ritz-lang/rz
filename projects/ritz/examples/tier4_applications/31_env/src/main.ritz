# env - print environment variables
#
# Usage: env [OPTION]... [NAME=VALUE]... [COMMAND [ARG]...]
#   Print the environment, or run COMMAND with modified environment.
#
# Options:
#   -i, --ignore-environment  start with an empty environment
#   -0, --null               output lines with NUL instead of newline
#   -u, --unset=NAME         remove variable NAME from the environment
#
# For now, implement basic env printing:
#   env          - print all environment variables
#   env NAME     - print value of NAME
#
# Examples:
#   env               # print all environment variables
#   env PATH          # print PATH value
#   env -0            # null-separated output

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.span
import ritzlib.fmt
import ritzlib.os.env
import ritzlib.gvec
import ritzlib.result
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct EnvOptions
    null_sep: i32      # -0: use NUL separator instead of newline
    show_name: i32     # Show specific variable by name

# ============================================================================
# Main functions
# ============================================================================

fn print_env_var(entry: StrView, null_sep: i32) -> i32
    # Print one "NAME=VALUE" entry (or a bare value), then the separator
    if null_sep != 0
        print("{entry}\0")
    else
        print("{entry}\n")
    0

# Print a looked-up value.  0 when the variable is set; 1 (exit silently, like
# GNU env) when it is not.
fn print_value(o: Option<StrView>, null_sep: i32) -> i32
    match o
        Some(v) => print_env_var(v, null_sep)
        None => 1

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("env", "Print the environment")
    spec.switch('0', "null", "Output lines with NUL instead of newline")
    spec.positionals("NAME", "Variable name to show", 0, 1)
    spec

# "env: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn env_main(p: @ParsedArgs) -> i32
    var opts: EnvOptions
    opts.null_sep = p.switch("null") as i32

    # A NAME was given: print just its value
    let pos = p.positionals()
    if pos.len > 0
        return print_value(env_get(pos.get(0)), opts.null_sep)

    # Print all environment variables
    let entries: Span<StrView> = env_iter()
    var i: i64 = 0
    while i < entries.len
        print_env_var(*(entries.ptr + i), opts.null_sep)
        i += 1

    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = env_main(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
