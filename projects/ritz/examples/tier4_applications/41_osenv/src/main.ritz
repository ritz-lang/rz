# osenv — the idiomatic ritzlib.os.env API, end to end (AGAST #1462).
#
#   env -i FOO=bar osenv
#
# Prints one fact per line so test.sh can pin the output and the regression
# suite can diff ritz0's binary against ritz1's:
#
#   FOO: <value of FOO, or "(unset)">         env_get on a (usually) set var
#   OSENV_UNSET: (unset)                      env_get on an unset var
#   entries: <N>                              env_iter().len
#   must FOO: <value>                         env_must on FOO
#
# If FOO is unset, env_must reports it on stderr and exits 1, so the last
# line is never printed.  The regression harness runs examples without FOO,
# which makes that failure path part of the cross-compiler differential too.
#
# Style follows ritz1's current limits (see examples/tier2_stdlib/77_args):
# each `match` is a value-producing expression with single-call arms.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.span
import ritzlib.os.env

fn or_unset(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => "(unset)"

fn line(label: StrView, value: StrView) -> i32
    prints(label)
    prints(": ")
    prints(value)
    prints("\n")
    0

pub fn main() -> i32
    line("FOO", or_unset(env_get("FOO")))
    line("OSENV_UNSET", or_unset(env_get("OSENV_UNSET")))

    let entries: Span<StrView> = env_iter()
    prints("entries: ")
    print_int(entries.len)
    prints("\n")

    line("must FOO", env_must("FOO"))
    0
