# timeout - run a command with a time limit
#
# Usage: timeout [OPTION]... DURATION COMMAND [ARG]...
#   Run COMMAND with a time limit of DURATION seconds.
#   If the command does not complete within the time limit,
#   it is terminated with SIGTERM (or SIGKILL if -k is specified).
#
# Options:
#   -k, --kill-after=DURATION  Send SIGKILL after this duration if still running
#   -s, --signal=SIGNAL        Specify the signal to send (default: TERM)
#
# Exit status:
#   124 - command timed out
#   125 - timeout itself failed
#   126 - command found but not executable
#   127 - command not found
#   Otherwise, the exit status of COMMAND
#
# Examples:
#   timeout 5 sleep 10        # Kills sleep after 5 seconds
#   timeout 0.5 ls            # Run ls with 0.5 second timeout
#   timeout -k 2 5 ./myprogram  # SIGTERM after 5s, SIGKILL after 2s more

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.option
import ritzlib.span
import ritzlib.fmt
import ritzlib.os.env
import ritzlib.process
import ritzlib.time { sleep_ms }

# Diagnostic helper — see 24_cp.  Used for the many timeout error
# messages that embed an argv-derived path/value.
fn timeout_err2(prefix: StrView, path: *u8, suffix: StrView)
    eprint("{prefix}{path}{suffix}\n")

# ============================================================================
# Exit codes
# ============================================================================

const EXIT_TIMEDOUT: i32 = 124
const EXIT_CANCELED: i32 = 125
const EXIT_CANNOT_INVOKE: i32 = 126
const EXIT_ENOENT: i32 = 127

# ============================================================================
# Duration parsing
# ============================================================================

# Parse a duration string (e.g., "5", "0.5", "10.25")
# Returns 0 on success, non-zero on error
fn parse_duration(s: *u8, out_sec: *i64, out_nsec: *i64) -> i32
    var sec: i64 = 0
    var nsec: i64 = 0
    var i: i32 = 0
    var frac_digits: i32 = 0
    var in_frac: i32 = 0

    while *(s + i) != 0
        let c: u8 = *(s + i)

        if c == '.'  # '.'
            if in_frac == 1
                return 1  # Multiple decimal points
            in_frac = 1
            i += 1
        else
            if c < '0' or c > '9'
                return 1  # Not a digit

            if in_frac == 0
                sec = sec * 10 + (c - '0') as i64
            else
                # Handle up to 9 fractional digits (nanoseconds)
                if frac_digits < 9
                    nsec = nsec * 10 + (c - '0') as i64
                    frac_digits += 1
            i += 1

    # Pad nanoseconds to 9 digits
    while frac_digits < 9
        nsec *= 10
        frac_digits += 1

    *out_sec = sec
    *out_nsec = nsec
    return 0

# ============================================================================
# Command execution helpers
# ============================================================================

# PATH lookup is ritzlib.process's find_command (AGAST #1481): $PATH, or the
# standard directories when it is unset or empty, as execvp(3) does; a name
# with a '/' is used as is.

# In the forked child: exec `cmd_path` with argv = cmd_args (argv[0]
# replaced by the full path). Builds argv on the stack and execs with the
# raw execve: nothing may allocate between fork and exec. Never returns.
fn exec_child(cmd_path: *u8, cmd_args: Span<StrView>) -> i32
    # Build null-terminated argv array.  Each argv StrView ends at
    # argv's NUL, so .ptr is a valid C string.
    var child_argv: [256]*u8
    let max_args: i64 = if cmd_args.len < 255 then cmd_args.len else 255
    for i in 0..max_args
        let a: StrView = cmd_args[i]
        child_argv[i] = a.ptr
    child_argv[max_args] = null

    # Replace first arg with full path for execve
    child_argv[0] = cmd_path

    let ret: i32 = sys_execve(cmd_path, @child_argv[0], env_raw_envp())

    # If we get here, exec failed
    if ret == (0 - ENOENT) or ret == (0 - EACCES)
        sys_exit(EXIT_CANNOT_INVOKE)
    sys_exit(EXIT_CANCELED)
    EXIT_CANCELED

# timeout's exit status for a child that has exited as `r`.
fn finished_status(r: @ProcessResult, sent_signal: i32) -> i32
    if r.signaled != 0
        # Child was killed by signal
        if sent_signal != 0
            return EXIT_TIMEDOUT
        # Return 128 + signal number
        return 128 + r.signal
    if r.exit_code >= 0
        return r.exit_code
    return EXIT_CANCELED

# Check (without blocking) whether child `pid` has exited: its exit status
# for timeout, or -1 while it is still running.
fn poll_child(pid: i32, sent_signal: i32) -> i32
    match try_wait_pid(pid)
        Ok(done) =>
            match done
                Some(r) => finished_status(@r, sent_signal)
                None => -1
        # Wait failed (child doesn't exist)
        Err(_) => EXIT_CANCELED

# ============================================================================
# Main timeout logic
# ============================================================================

fn run_timeout(timeout_sec: i64, timeout_nsec: i64, kill_sec: i64, kill_nsec: i64, use_kill: i32, signal: i32, cmd_args: Span<StrView>) -> i32
    # Find the command
    let cmd0: StrView = cmd_args[0]
    let cmd_name: *u8 = cmd0.ptr
    var found: String = string_new()
    match find_command(cmd0)
        Some(path) => found = path
        None =>
            timeout_err2("timeout: '", cmd_name, "': No such file or directory")
            return EXIT_ENOENT
    let cmd_path: *u8 = found.as_ptr()

    # Fork; the child execs the command
    let pid: i32 = match fork()
        Ok(fr) =>
            match fr
                Child => exec_child(cmd_path, cmd_args)
                Parent(child) => child
        Err(_) =>
            eprint("timeout: fork failed\n")
            return EXIT_CANCELED

    # Parent process: wait with timeout
    var elapsed_sec: i64 = 0
    var elapsed_nsec: i64 = 0
    var sent_signal: i32 = 0
    var sent_kill: i32 = 0

    loop
        # Check if child has exited (non-blocking)
        let finished: i32 = poll_child(pid, sent_signal)
        if finished >= 0
            return finished

        # Check if we've exceeded the timeout
        if sent_signal == 0
            if elapsed_sec > timeout_sec or (elapsed_sec == timeout_sec and elapsed_nsec >= timeout_nsec)
                # Send the termination signal
                kill(pid, signal)
                sent_signal = 1

        # Check if we should send SIGKILL
        if use_kill != 0 and sent_signal != 0 and sent_kill == 0
            # Calculate time since initial signal
            let kill_elapsed_sec: i64 = elapsed_sec - timeout_sec
            let kill_elapsed_nsec: i64 = elapsed_nsec - timeout_nsec
            var adj_sec: i64 = kill_elapsed_sec
            var adj_nsec: i64 = kill_elapsed_nsec
            if adj_nsec < 0
                adj_sec -= 1
                adj_nsec += 1000000000

            if adj_sec > kill_sec or (adj_sec == kill_sec and adj_nsec >= kill_nsec)
                kill(pid, SIGKILL)
                sent_kill = 1

        # Sleep for the poll interval: 10ms
        sleep_ms(10)

        # Update elapsed time
        elapsed_nsec += 10000000
        if elapsed_nsec >= 1000000000
            elapsed_sec += 1
            elapsed_nsec -= 1000000000

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    if args.len < 3
        eprint("Usage: timeout [OPTION]... DURATION COMMAND [ARG]...\n")
        eprint("Run COMMAND with a time limit.\n")
        return EXIT_CANCELED

    # Parse options manually to handle positional args properly
    var timeout_str: *u8 = null
    var kill_str: *u8 = null
    var signal: i32 = SIGTERM
    var cmd_start: i64 = 0

    var i: i64 = 1
    while i < args.len
        let argv_i: StrView = args[i]
        let arg: *u8 = argv_i.ptr

        # Check for -k or --kill-after
        if argv_i.eq("-k")
            i += 1
            if i >= args.len
                eprint("timeout: option '-k' requires an argument\n")
                return EXIT_CANCELED
            let kill_v: StrView = args[i]
            kill_str = kill_v.ptr
            i += 1
            continue

        if strneq(arg, c"--kill-after=", 13)
            kill_str = arg + 13
            i += 1
            continue

        # Check for -s or --signal
        if argv_i.eq("-s")
            i += 1
            if i >= args.len
                eprint("timeout: option '-s' requires an argument\n")
                return EXIT_CANCELED
            let sig_v: StrView = args[i]
            let sig_str: *u8 = sig_v.ptr
            # Parse signal (support TERM, KILL, or number)
            if sig_v.eq("TERM") or sig_v.eq("SIGTERM")
                signal = SIGTERM
            else if sig_v.eq("KILL") or sig_v.eq("SIGKILL")
                signal = SIGKILL
            else if sig_v.eq("INT") or sig_v.eq("SIGINT")
                signal = SIGINT
            else if sig_v.eq("HUP") or sig_v.eq("SIGHUP")
                signal = SIGHUP
            else
                signal = atoi(sig_str) as i32
                if signal <= 0
                    timeout_err2("timeout: invalid signal '", sig_str, "'")
                    return EXIT_CANCELED
            i += 1
            continue

        if strneq(arg, c"--signal=", 9)
            let sig_str: *u8 = arg + 9
            if streq(sig_str, c"TERM") or streq(sig_str, c"SIGTERM")
                signal = SIGTERM
            else if streq(sig_str, c"KILL") or streq(sig_str, c"SIGKILL")
                signal = SIGKILL
            else if streq(sig_str, c"INT") or streq(sig_str, c"SIGINT")
                signal = SIGINT
            else if streq(sig_str, c"HUP") or streq(sig_str, c"SIGHUP")
                signal = SIGHUP
            else
                signal = atoi(sig_str) as i32
                if signal <= 0
                    timeout_err2("timeout: invalid signal '", sig_str, "'")
                    return EXIT_CANCELED
            i += 1
            continue

        # Check for -- (end of options)
        if argv_i.eq("--")
            i += 1
            break

        # Check for other options starting with -
        if *arg == '-' and *(arg + 1) != 0
            timeout_err2("timeout: unrecognized option '", arg, "'")
            return EXIT_CANCELED

        # Not an option, this is the duration
        break

    # Now i points to DURATION
    if i >= args.len
        eprint("timeout: missing operand\n")
        return EXIT_CANCELED

    let timeout_v: StrView = args[i]
    timeout_str = timeout_v.ptr
    i += 1

    if i >= args.len
        eprint("timeout: missing command\n")
        return EXIT_CANCELED

    cmd_start = i

    # Parse timeout duration
    var timeout_sec: i64 = 0
    var timeout_nsec: i64 = 0
    if parse_duration(timeout_str, @timeout_sec, @timeout_nsec) != 0
        timeout_err2("timeout: invalid time interval '", timeout_str, "'")
        return EXIT_CANCELED

    # Parse kill duration if specified
    var kill_sec: i64 = 0
    var kill_nsec: i64 = 0
    var use_kill: i32 = 0
    if kill_str != null
        if parse_duration(kill_str, @kill_sec, @kill_nsec) != 0
            timeout_err2("timeout: invalid time interval '", kill_str, "'")
            return EXIT_CANCELED
        use_kill = 1

    # Run the command with timeout
    return run_timeout(timeout_sec, timeout_nsec, kill_sec, kill_nsec, use_kill, signal, args.from(cmd_start))
