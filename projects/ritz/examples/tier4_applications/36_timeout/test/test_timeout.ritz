# Tests for 36_timeout — run command with time limit.
#
# Standard exit codes:
#   124  child exceeded the timeout
#   127  child binary not found
#   N    pass-through of child's exit code on normal completion
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_timeout_command_completes() -> i32
    let args: [3]StrView = ["5", "/bin/echo", "hello"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./timeout", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "timeout 5 echo should exit 0"
            assert buf_contains(c.output(), "hello"), "missing 'hello'"
        Err(_) =>
            assert false, "spawn ./timeout"
    0

[[test]]
fn test_timeout_child_times_out() -> i32
    let args: [3]StrView = ["0.1", "/bin/sleep", "10"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./timeout", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 124, "timed-out child should exit 124"
        Err(_) =>
            assert false, "spawn ./timeout"
    0

[[test]]
fn test_timeout_command_not_found() -> i32
    let args: [2]StrView = ["1", "nonexistent_command_xyzzy"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./timeout", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 127, "missing command should exit 127"
        Err(_) =>
            assert false, "spawn ./timeout"
    0

[[test]]
fn test_timeout_preserves_child_exit() -> i32
    let args: [2]StrView = ["5", "/bin/false"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./timeout", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 1, "child's exit code 1 should pass through"
        Err(_) =>
            assert false, "spawn ./timeout"
    0

[[test]]
fn test_timeout_zero_duration() -> i32
    let args: [3]StrView = ["0", "/bin/sleep", "1"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./timeout", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 124, "timeout 0 should exit 124"
        Err(_) =>
            assert false, "spawn ./timeout"
    0
