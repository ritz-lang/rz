# xargs - build and execute command lines from stdin
#
# Usage: xargs [OPTION]... [COMMAND [INITIAL-ARGS]]
#   Read arguments from standard input and execute COMMAND with them.
#
# Options:
#   -0          Input items are NUL-separated (instead of whitespace)
#   -n NUM      Use at most NUM arguments per command line
#
# If no COMMAND is given, echo is used.
#
# Examples:
#   echo "a b c" | xargs echo           # echo a b c
#   printf "a\0b\0c" | xargs -0 echo    # echo a b c
#   echo "a b c" | xargs -n1 echo       # echo a; echo b; echo c

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.gvec
import ritzlib.result
import ritzlib.argspec
import ritzlib.fmt
import ritzlib.fd { fd_stdin }
import ritzlib.fs { access }
import ritzlib.errno
import ritzlib.process { Exec, ProcessResult, exec_prepare, fork, wait_pid }

# ============================================================================
# Constants
# ============================================================================

const MAX_ARGS: i32 = 1024
const MAX_ARG_LEN: i64 = 4096
const BUF_SIZE: i64 = 65536

# ============================================================================
# Options
# ============================================================================

struct XargsOptions
    null_sep: u8       # -0: NUL-separated input
    max_args: i32      # -n: max args per command (0 = unlimited)

# ============================================================================
# Command execution
# ============================================================================

# Copy `src` into `dst` as a NUL-terminated C string (an execve path).
fn copy_cstr(dst: *u8, src: StrView)
    for i in 0..src.len
        *(dst + i) = src.get(i)
    *(dst + src.len) = 0

fn search_path(name: StrView, result: *u8) -> i64
    # Search PATH for the given command name
    # Copies the full path to result (NUL-terminated) if found
    # Returns the full path's length if found, 0 if not found

    # If name contains a /, use it directly
    if name.find_byte('/') != name.len
        if access(name, X_OK).is_ok()
            copy_cstr(result, name)
            return name.len
        return 0

    # Get PATH from environment.  Unset and empty both search nothing.
    let path: StrView = env_get_or("PATH", "")

    var pos: i64 = 0

    while pos < path.len
        # Extract next PATH component (up to ':' or end)
        var len: i64 = 0
        while pos + len < path.len and *(path.ptr + pos + len) != 58  # ':'
            *(result + len) = *(path.ptr + pos + len)
            len += 1

        # Build full path: dir/name
        var j: i64 = len

        # Add '/' separator
        *(result + j) = 47  # '/'
        j += 1

        # Add command name
        copy_cstr(result + j, name)
        j += name.len

        # Check if executable
        if access(StrView { ptr: result, len: j }, X_OK).is_ok()
            return j

        # Move to next PATH component
        pos += len
        if pos < path.len and *(path.ptr + pos) == ':'  # ':'
            pos += 1

    return 0

# WEXITSTATUS of a reaped child: its exit code, or 0 for a signal death
# (whose wait status has no exit byte).
fn wait_exit_status(r: @ProcessResult) -> i32
    if r.signaled != 0
        return 0
    return r.exit_code

fn run_command(cmd_path: StrView, args: Span<StrView>) -> i32
    # Fork and exec the command
    # Returns the exit status of the child process

    # Prepared before fork, so the child allocates nothing.
    var ex: Exec = match exec_prepare(cmd_path, args)
        Ok(e) => e
        Err(_) =>
            eprint("xargs: out of memory\n")
            return 1

    let pid: i32 = match fork()
        Ok(fr) =>
            match fr
                Child =>
                    ex.run()
                    # If we get here, execve failed
                    eprint("xargs: execve failed\n")
                    sys_exit(127)
                    127
                Parent(child) => child
        Err(_) =>
            ex.free()
            eprint("xargs: fork failed\n")
            return 1
    ex.free()

    # Parent process - wait for child
    match wait_pid(pid)
        Ok(r) => wait_exit_status(@r)
        Err(_) =>
            eprint("xargs: wait failed\n")
            1

# ============================================================================
# Input parsing
# ============================================================================

fn skip_whitespace(buf: *u8, buf_len: i64, pos: *i64)
    # Skip whitespace characters
    var p: i64 = *pos
    while p < buf_len
        let c: u8 = *(buf + p)
        if c != ' ' and c != '\t' and c != '\n' and c != '\r'
            break
        p += 1
    *pos = p

fn read_arg_whitespace(buf: *u8, buf_len: i64, pos: *i64) -> Option<StrView>
    # Read the next whitespace-separated argument
    # Returns the argument (a view into buf), or None if done

    var p: i64 = *pos

    # Skip leading whitespace
    while p < buf_len
        let c: u8 = *(buf + p)
        if c != ' ' and c != '\t' and c != '\n' and c != '\r'
            break
        p += 1

    if p >= buf_len
        *pos = p
        return None

    let arg_start: i64 = p

    # Find end of argument
    while p < buf_len
        let c: u8 = *(buf + p)
        if c == ' ' or c == '\t' or c == '\n' or c == '\r'
            break
        p += 1

    *pos = p + 1

    Some(StrView { ptr: buf + arg_start, len: p - arg_start })

fn read_arg_null(buf: *u8, buf_len: i64, pos: *i64) -> Option<StrView>
    # Read the next NUL-separated argument
    # Returns the argument (a view into buf), or None if done

    var p: i64 = *pos

    if p >= buf_len
        return None

    let arg_start: i64 = p

    # Find NUL terminator
    while p < buf_len and *(buf + p) != 0
        p += 1

    let len: i64 = p - arg_start

    # Skip the NUL
    if p < buf_len
        p += 1

    *pos = p

    # An empty argument ends the input
    if len == 0
        return None

    Some(StrView { ptr: buf + arg_start, len: len })

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("xargs", "Build and execute command lines from stdin")
    spec.switch('0', "null", "Input items are NUL-separated")
    spec.option('n', "max-args", "NUM", "Use at most NUM arguments per command line", Some("0"))
    spec.positionals("COMMAND", "Command to execute (default: echo)", 0, ARGS_UNLIMITED)
    spec

# A usage error (from argspec_parse, or -n that isn't a number): report it
# and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn xargs(p: @ParsedArgs, max_args: i64) -> i32
    var opts: XargsOptions
    opts.null_sep = p.switch("null") as u8
    opts.max_args = max_args as i32

    # Get command and initial args
    var cmd: StrView = "echo"
    var cmd_args_start: i64 = 0

    let cmd_pos = p.positionals()
    if cmd_pos.len > 0
        cmd = cmd_pos.get(0)
        cmd_args_start = 1

    # Find the command in PATH
    var cmd_path: [4096]u8
    let cmd_path_len: i64 = search_path(cmd, @cmd_path[0])
    if cmd_path_len == 0
        eprint("xargs: {cmd}: command not found\n")
        return 127
    let cmd_view: StrView = StrView { ptr: @cmd_path[0], len: cmd_path_len }

    # Read all input into a buffer
    var input_buf: [65536]u8
    var total_read: i64 = 0

    while total_read < BUF_SIZE - 1
        let n: i64 = match fd_stdin().read(Span<u8> { ptr: @input_buf[0] + total_read, len: BUF_SIZE - 1 - total_read })
            Ok(got) => got
            Err(_) => 0
        if n <= 0
            break
        total_read += n

    input_buf[total_read] = 0

    # Arguments to pass to each command
    # args[0] is the command, followed by initial args from command line,
    # then args from stdin
    var args = vec_new<StrView>()
    var stdin_arg_count: i32 = 0

    # Set up command as first argument
    args.push(cmd_view)

    # Add initial arguments from command line
    var i: i64 = cmd_args_start
    while i < cmd_pos.len
        args.push(cmd_pos.get(i))
        i += 1

    let initial_arg_count: i64 = args.len()

    # Parse stdin arguments
    var pos: i64 = 0
    var exit_code: i32 = 0

    while pos < total_read
        var next: Option<StrView> = None
        if opts.null_sep != 0
            next = read_arg_null(@input_buf[0], total_read, @pos)
        else
            next = read_arg_whitespace(@input_buf[0], total_read, @pos)

        let arg: StrView = match next
            Some(a) => a
            None => break

        # Skip empty arguments
        if arg.len == 0
            continue

        # Add argument to list
        args.push(arg)
        stdin_arg_count += 1

        # Check if we've reached max args
        if opts.max_args > 0 and stdin_arg_count >= opts.max_args
            # Run the command
            let result: i32 = run_command(cmd_view, span_from_vec(@args))
            if result != 0
                exit_code = result

            # Reset for next batch
            while args.len() > initial_arg_count
                args.pop()
            stdin_arg_count = 0

    # Run final batch if there are remaining arguments
    if args.len() > initial_arg_count
        # Run the command
        let result: i32 = run_command(cmd_view, span_from_vec(@args))
        if result != 0
            exit_code = result

    args.deinit()
    return exit_code

fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    # -n has a default, so the only Err here is NotANumber.
    let status: i32 = match parsed.int("max-args")
        Ok(n) => xargs(@parsed, n)
        Err(e) => usage_error(spec, e)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
