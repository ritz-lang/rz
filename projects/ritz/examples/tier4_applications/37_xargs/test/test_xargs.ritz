# Tests for 37_xargs — build and execute command lines from stdin.
import ritzlib.testlib

[[test]]
fn test_xargs_default_echo() -> i32
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./xargs", span_empty<StrView>(), @env, "a b c\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            # Default command is echo, so output should contain 'a b c'
            assert buf_contains(c.output(), "a b c"), "should echo args"
        Err(_) =>
            assert false, "spawn ./xargs"
    0

[[test]]
fn test_xargs_explicit_echo() -> i32
    let args: [1]StrView = ["echo"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./xargs", @args, @env, "hello world\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            assert buf_contains(c.output(), "hello world"), "echo passes through"
        Err(_) =>
            assert false, "spawn ./xargs"
    0

[[test]]
fn test_xargs_n1_one_per_command() -> i32
    let args: [2]StrView = ["-n1", "echo"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./xargs", @args, @env, "a b c\n")
        Ok(c) =>
            assert c.status.exit_code == 0, "exit 0"
            # -n1 → one arg per echo invocation, so 3 lines.
            let o: Span<u8> = c.output()
            var nl: i64 = 0
            var i: i64 = 0
            while i < o.len
                if *(o.ptr + i) == 10
                    nl += 1
                i += 1
            assert nl == 3, "expected 3 lines (one per arg)"
        Err(_) =>
            assert false, "spawn ./xargs"
    0
