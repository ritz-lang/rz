# Tests for 32_which — find executables in PATH.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_which_finds_in_usr_bin() -> i32
    let args: [1]StrView = ["true"]
    let env: [1]StrView = ["PATH=/usr/bin:/bin"]
    match exec_capture("./which", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "which true should exit 0"
            let found_usr: bool = buf_contains(c.output(), "/usr/bin/true")
            let found_bin: bool = buf_contains(c.output(), "/bin/true")
            assert found_usr || found_bin, "expected path to true"
        Err(_) =>
            assert false, "spawn ./which"
    0

[[test]]
fn test_which_not_found() -> i32
    let args: [1]StrView = ["nonexistent_xyz_definitely_not_there"]
    let env: [1]StrView = ["PATH=/usr/bin:/bin"]
    match exec_capture("./which", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 1, "which nonexistent should exit 1"
        Err(_) =>
            assert false, "spawn ./which"
    0

[[test]]
fn test_which_empty_path_fails() -> i32
    let args: [1]StrView = ["true"]
    let env: [1]StrView = ["PATH=/no_such_directory_xyzzy"]
    match exec_capture("./which", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 1, "empty PATH should exit 1 (no match)"
        Err(_) =>
            assert false, "spawn ./which"
    0
