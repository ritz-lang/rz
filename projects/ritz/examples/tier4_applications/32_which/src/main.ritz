# which - locate a command
#
# Usage: which [OPTION]... NAME...
#   Locate a command - shows the full path of (shell) commands.
#
# Options:
#   -a    print all matching executables in PATH, not just the first
#
# Examples:
#   which ls          # find ls
#   which -a python   # find all python executables

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.gvec
import ritzlib.result
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct WhichOptions
    show_all: u8     # -a: show all matches

# ============================================================================
# Path searching
# ============================================================================

fn is_executable(path: *u8) -> i32
    # Check if path exists and is executable
    # sys_access with X_OK (1) checks execute permission
    if sys_access(path, X_OK) == 0
        return 1
    return 0

fn search_path(name: *u8, opts: *WhichOptions) -> i32
    # Search PATH for the given command name
    # Returns 0 if found at least once, 1 if not found

    # If name contains a /, don't search PATH
    var i: i64 = 0
    while *(name + i) != 0
        if *(name + i) == '/'  # '/'
            if is_executable(name) != 0
                prints_cstr(name)
                print_char(10)
                return 0
            return 1
        i += 1

    # Get PATH from environment.  Unset and empty both search nothing.
    let path: StrView = env_get_or("PATH", "")

    var found: i32 = 0
    var pos: i64 = 0
    var path_buf: [4096]u8
    var full_path: [4096]u8

    while pos < path.len
        # Extract next PATH component (up to ':' or end)
        var len: i64 = 0
        while pos + len < path.len and *(path.ptr + pos + len) != 58  # ':'
            path_buf[len] = *(path.ptr + pos + len)
            len += 1

        path_buf[len] = 0  # Null terminate

        # Build full path: dir/name
        var j: i64 = 0
        while j < len
            full_path[j] = path_buf[j]
            j += 1

        # Add '/' separator
        full_path[j] = 47  # '/'
        j += 1

        # Add command name
        var k: i64 = 0
        while *(name + k) != 0
            full_path[j] = *(name + k)
            j += 1
            k += 1

        full_path[j] = 0  # Null terminate

        # Check if executable
        if is_executable(@full_path[0]) != 0
            prints_cstr(@full_path[0])
            print_char(10)
            found = 1
            if opts.show_all == 0
                return 0

        # Move to next PATH component
        pos += len
        if pos < path.len and *(path.ptr + pos) == ':'  # ':'
            pos += 1

    if found != 0
        return 0
    return 1

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("which", "Locate a command")
    spec.switch('a', "all", "Print all matching executables in PATH")
    spec.positionals("NAME", "Command name(s) to locate", 1, ARGS_UNLIMITED)
    spec

# "which: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn which_all(p: @ParsedArgs) -> i32
    var opts: WhichOptions
    opts.show_all = p.switch("all") as u8

    # Search for each command
    var exit_code: i32 = 0
    let pos = p.positionals()
    for i in 0..pos.len
        if search_path(positional_cstr(@pos, i), @opts) != 0
            exit_code = 1

    return exit_code

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = which_all(@parsed)
    parsed.deinit()
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match spec.parse(args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
