# watch - execute a program periodically, showing output fullscreen
#
# Usage: watch [OPTIONS] COMMAND [ARGS...]
#   Execute a program periodically, clearing the screen between runs.
#
# Options:
#   -n SECONDS    seconds to wait between updates (default: 2)
#
# Examples:
#   watch date              # show date every 2 seconds
#   watch -n 1 ls -l        # show directory listing every second
#   watch -n 5 df -h        # show disk usage every 5 seconds

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.result
import ritzlib.argspec
import ritzlib.errno
import ritzlib.process { Exec, exec_prepare, fork, wait_pid }
import ritzlib.time { sleep, duration_secs }

# ============================================================================
# Screen clearing
# ============================================================================

fn clear_screen()
    # ANSI escape sequence: ESC[2J clears screen, ESC[H moves cursor home
    # ESC = 27, [ = 91
    var buf: [10]u8
    buf[0] = 27   # ESC
    buf[1] = 91   # [
    buf[2] = 50   # 2
    buf[3] = 74   # J
    buf[4] = 27   # ESC
    buf[5] = 91   # [
    buf[6] = 72   # H
    buf[7] = 0
    prints(StrView { ptr: @buf[0], len: 7 })

# ============================================================================
# Command execution
# ============================================================================

fn run_command(cmd: StrView) -> i32
    # Execute via /bin/sh -c "command", with our environment.  Prepared
    # before fork, so the child allocates nothing.
    var sh_argv = vec_new<StrView>()
    sh_argv.push("/bin/sh")
    sh_argv.push("-c")
    sh_argv.push(cmd)
    let prepared: Result<Exec, Errno> = exec_prepare("/bin/sh", span_from_vec(@sh_argv))
    sh_argv.deinit()
    var ex: Exec = match prepared
        Ok(e) => e
        Err(_) =>
            eprint("watch: out of memory\n")
            return 1

    # Fork a child process (pid 0 in the child)
    let pid: i32 = match fork()
        Ok(fr) =>
            match fr
                Child => 0
                Parent(child) => child
        Err(_) =>
            ex.free()
            eprint("watch: fork failed\n")
            return 1

    if pid == 0
        ex.run()
        # If execve returns, it failed
        eprint("watch: cannot execute /bin/sh\n")
        sys_exit(127)
    ex.free()

    # Parent process - wait for child
    # Exit status if the child exited normally (0 if a signal killed it)
    match wait_pid(pid)
        Ok(r) =>
            if r.signaled != 0
                return 0
            r.exit_code
        Err(_) =>
            eprint("watch: wait failed\n")
            1

# ============================================================================
# Build command string from positional args
# ============================================================================

fn build_cmd_string(args: @Span<StrView>, buf: *u8, bufsize: i64) -> i64
    # Join all positional arguments with spaces into a single command string
    var pos: i64 = 0

    for i in 0..args.len
        let arg: StrView = args.get(i)

        # Add space before args after the first
        if i > 0 and pos < bufsize - 1
            *(buf + pos) = 32  # space
            pos += 1

        # Copy argument
        var j: i64 = 0
        while j < arg.len and pos < bufsize - 1
            *(buf + pos) = arg.get(j)
            pos += 1
            j += 1

    # Null terminate
    *(buf + pos) = 0

    return pos

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("watch", "Execute a program periodically")
    spec.option('n', "interval", "SECS", "Seconds between updates", Some("2"))
    spec.positionals("COMMAND", "Command to run", 1, ARGS_UNLIMITED)
    spec

# A usage error (from argspec_parse, or -n that isn't a number): report it
# and exit 1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn watch(p: @ParsedArgs, interval: i64) -> i32
    if interval < 1
        eprint("watch: interval must be at least 1 second\n")
        return 1

    # Build command string
    var cmd_string: [4096]u8
    let cmd = p.positionals()
    let cmd_len: i64 = build_cmd_string(@cmd, @cmd_string[0], 4096)

    if cmd_len == 0
        eprint("watch: no command specified\n")
        return 1

    # Main loop - run command, sleep, repeat
    while 1 == 1
        # Clear screen and move cursor to top
        clear_screen()

        # Print header: "Every Ns: command"
        let cmd_cstr: *u8 = @cmd_string[0]
        print("Every {interval}s: {cmd_cstr}\n\n")

        # Run the command
        run_command(StrView { ptr: @cmd_string[0], len: cmd_len })

        # Sleep for the interval
        sleep(duration_secs(interval))

    return 0

fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    # -n has a default, so the only Err here is NotANumber.
    let status: i32 = match parsed.int("interval")
        Ok(n) => watch(@parsed, n)
        Err(e) => usage_error(spec, e)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
