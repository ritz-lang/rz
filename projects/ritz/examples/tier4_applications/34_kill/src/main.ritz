# kill - send signals to processes
#
# Usage: kill [-SIGNAL] PID...
#        kill -l
#
# Send signals to processes by PID.
#
# Options:
#   -l           List all signal names
#   -SIGNAL      Signal to send (name or number)
#                e.g., -9, -KILL, -HUP, -TERM
#
# Examples:
#   kill 1234           # send SIGTERM to process 1234
#   kill -9 1234        # send SIGKILL to process 1234
#   kill -KILL 1234     # same as above
#   kill -HUP 1234 5678 # send SIGHUP to multiple processes
#   kill -l             # list all signals

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.span
import ritzlib.fmt
import ritzlib.process { kill }

# Diagnostic helper — see 24_cp.
fn kill_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

# ============================================================================
# Signal name table
# ============================================================================

# Signal number to name mapping
# Index is signal number, value is name

fn get_signal_name(sig: i32) -> StrView
    if sig == 1
        return "HUP"
    if sig == 2
        return "INT"
    if sig == 3
        return "QUIT"
    if sig == 4
        return "ILL"
    if sig == 5
        return "TRAP"
    if sig == 6
        return "ABRT"
    if sig == 7
        return "BUS"
    if sig == 8
        return "FPE"
    if sig == 9
        return "KILL"
    if sig == 10
        return "USR1"
    if sig == 11
        return "SEGV"
    if sig == 12
        return "USR2"
    if sig == 13
        return "PIPE"
    if sig == 14
        return "ALRM"
    if sig == 15
        return "TERM"
    if sig == 16
        return "STKFLT"
    if sig == 17
        return "CHLD"
    if sig == 18
        return "CONT"
    if sig == 19
        return "STOP"
    if sig == 20
        return "TSTP"
    if sig == 21
        return "TTIN"
    if sig == 22
        return "TTOU"
    if sig == 23
        return "URG"
    if sig == 24
        return "XCPU"
    if sig == 25
        return "XFSZ"
    if sig == 26
        return "VTALRM"
    if sig == 27
        return "PROF"
    if sig == 28
        return "WINCH"
    if sig == 29
        return "IO"
    if sig == 30
        return "PWR"
    if sig == 31
        return "SYS"
    return strview_empty()

fn parse_signal_name(name: StrView) -> i32
    # Parse signal name (optional SIG prefix) to number
    # Returns -1 if not found
    var n: StrView = name
    if n.starts_with("SIG")
        n = n.skip(3)
    var sig: i32 = 1
    while sig <= 31
        if get_signal_name(sig).eq(n)
            return sig
        sig += 1
    return -1

# ============================================================================
# Helper functions
# ============================================================================

fn is_digit(c: u8) -> i32
    if c >= '0' and c <= '9'
        return 1
    return 0

fn is_all_digits(s: StrView) -> i32
    # Check if string is all digits (possibly with leading -)
    var i: i64 = 0
    if s.len > 0 and s.get(0) == '-'
        i = 1
    if i >= s.len
        return 0
    while i < s.len
        if is_digit(s.get(i)) == 0
            return 0
        i += 1
    return 1

fn print_usage()
    # Single multi-line StrView — one write syscall, easier to read,
    # easier to keep in sync.
    print("Usage: kill [-SIGNAL] PID...\n       kill -l\n\nSend signals to processes.\n\nOptions:\n  -l           List all signal names\n  -SIGNAL      Signal to send (name or number)\n               e.g., -9, -KILL, -HUP, -TERM\n")

fn list_signals()
    # List all signals in a format similar to GNU kill -l
    var sig: i32 = 1
    var col: i32 = 0
    while sig <= 31
        let name: StrView = get_signal_name(sig)
        if not name.is_empty()
            # Print signal number and name
            if sig < 10
                print(" ")
            print("{sig}) SIG{name}")

            col += 1
            if col >= 4
                print("\n")
                col = 0
            else
                # Pad to column width (approx 16 chars)
                let name_len: i64 = name.len
                var pad: i64 = 12 - name_len
                while pad > 0
                    print(" ")
                    pad -= 1
        sig += 1

    if col > 0
        print("\n")  # final newline

fn parse_signal(arg: StrView) -> i32
    # Parse signal specification (after the leading -)
    # Returns signal number or -1 on error

    # Check if it's a number
    if is_all_digits(arg) != 0
        # Signal 0 is special (check process existence)
        let sig: i64 = match arg.parse_i64()
            Some(v) => v
            None => -1
        if sig >= 0 and sig <= 31
            return sig as i32
        return -1

    # Try to parse as signal name
    return parse_signal_name(arg)

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        print_usage()
        return 1

    var signal: i32 = SIGTERM  # default signal
    var first_pid_idx: i64 = 1
    var exit_code: i32 = 0

    # Check for -l (list signals)
    let arg1v: StrView = args[1]
    if arg1v.eq("-l") or arg1v.eq("--list")
        list_signals()
        return 0

    # Check for --help
    if arg1v.eq("--help")
        print_usage()
        return 0

    # Check for signal specification
    if arg1v.starts_with("-")
        let sig_spec: StrView = arg1v.skip(1)

        # Not just "-" alone
        if not sig_spec.is_empty()
            # Check if it looks like a signal (not a negative PID for now)
            # Signal specs: -9, -KILL, -SIGKILL, -HUP, etc.
            signal = parse_signal(sig_spec)
            if signal < 0
                return kill_err2("kill: invalid signal specification '", sig_spec, "'")
            first_pid_idx = 2

    # Need at least one PID
    if first_pid_idx >= args.len
        eprint("kill: missing PID\n")
        print_usage()
        return 1

    # Send signal to each PID
    var i: i64 = first_pid_idx
    while i < args.len
        let pid_str: StrView = args[i]

        # Parse PID (can be negative for process groups)
        var pid: i64 = 0
        var pid_ok: bool = false
        if is_all_digits(pid_str) != 0
            match pid_str.parse_i64()
                Some(v) =>
                    pid = v
                    pid_ok = true
                None =>
                    pid_ok = false
        if not pid_ok
            kill_err2("kill: invalid PID '", pid_str, "'")
            exit_code = 1
            i += 1
            continue

        # Send the signal
        let err: i32 = match kill(pid as i32, signal)
            Ok(_) => 0
            Err(e) => e.code()

        if err != 0
            # Prefix has a runtime int (pid) interleaved, so we don't use
            # the err2 helper here.
            eprint("kill: ({pid}) - ")

            if err == ESRCH
                eprint("No such process\n")
            else if err == EPERM
                eprint("Operation not permitted\n")
            else if err == EINVAL
                eprint("Invalid signal\n")
            else
                eprint("Error {err}\n")

            exit_code = 1

        i += 1

    return exit_code
