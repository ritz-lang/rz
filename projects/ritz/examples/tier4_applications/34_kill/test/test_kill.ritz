# Tests for 34_kill — send signals to processes.
#
# Argv-parsing tests only — sending real signals would require fork+wait
# choreography that's not buying us much beyond what test.sh covers.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_kill_list_signals() -> i32
    let args: [1]StrView = ["-l"]
    match exec_capture("./kill", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "kill -l should exit 0"
            assert buf_contains(c.output(), "SIGHUP"), "missing SIGHUP"
            assert buf_contains(c.output(), "SIGTERM"), "missing SIGTERM"
            assert buf_contains(c.output(), "SIGKILL"), "missing SIGKILL"
        Err(_) =>
            assert false, "spawn ./kill"
    0

[[test]]
fn test_kill_invalid_signal() -> i32
    let args: [2]StrView = ["-INVALID", "1"]
    match exec_capture("./kill", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 1, "kill -INVALID should exit 1"
        Err(_) =>
            assert false, "spawn ./kill"
    0

[[test]]
fn test_kill_invalid_pid() -> i32
    let args: [2]StrView = ["-TERM", "abc"]
    match exec_capture("./kill", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 1, "kill -TERM abc should exit 1"
        Err(_) =>
            assert false, "spawn ./kill"
    0

[[test]]
fn test_kill_missing_pid() -> i32
    let args: [1]StrView = ["-9"]
    match exec_capture("./kill", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 1, "kill -9 (no pid) should exit 1"
        Err(_) =>
            assert false, "spawn ./kill"
    0
