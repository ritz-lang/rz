# nohup - run a command immune to hangups
#
# Usage: nohup COMMAND [ARG]...
#   Run COMMAND, ignoring hangup signals (SIGHUP).
#
# Behavior:
#   - Ignores SIGHUP signal for the command
#   - If stdout is a terminal, redirects it to nohup.out
#   - If stderr is a terminal, redirects it to stdout
#   - Exit status is 125 if nohup itself fails, 126 if COMMAND is found
#     but cannot be invoked, 127 if COMMAND cannot be found
#
# Examples:
#   nohup ./long-running-job &      # run in background, output to nohup.out
#   nohup ./script.sh arg1 arg2     # run with arguments

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.process

# ============================================================================
# Constants
# ============================================================================

# ioctl request code for TCGETS (to check if fd is a tty)
const TCGETS: i64 = 21505    # 0x5401

# Exit codes
const EXIT_NOHUP_FAILURE: i32 = 125   # nohup itself failed
const EXIT_CANNOT_INVOKE: i32 = 126   # command found but couldn't invoke
const EXIT_NOT_FOUND: i32 = 127       # command not found

# ============================================================================
# Helper functions
# ============================================================================

fn isatty(fd: i32) -> i32
    # Check if fd refers to a terminal using ioctl TCGETS
    # TCGETS returns 0 on success (is a tty), -1 on error (not a tty)
    var termios_buf: [60]u8   # struct termios is about 60 bytes
    let result: i64 = syscall3(SYS_IOCTL, fd as i64, TCGETS, @termios_buf[0] as i64)
    if result == 0
        return 1  # is a tty
    return 0  # not a tty

fn print_error(msg: StrView)
    # Print error message to stderr.  StrView is length-tagged so we
    # don't need a runtime strlen() call.
    eprints(msg)

fn print_error_ln(msg: StrView)
    eprintln(msg)

# err2-style helper for diagnostics with an embedded path.
fn nohup_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)
    string_drop(@&s)
    return 1

fn open_nohup_out() -> i32
    # Try to open nohup.out in current directory
    # Create with mode 0600 (owner read/write only)
    let flags: i32 = O_WRONLY | O_CREAT | O_APPEND
    let mode: i32 = S_IRUSR | S_IWUSR   # 0600
    let fd: i32 = sys_open3(c"nohup.out", flags, mode)

    if fd >= 0
        eprintln("nohup: appending output to 'nohup.out'")
        return fd

    # If current directory failed, try $HOME/nohup.out
    # For simplicity, we just fail if current dir doesn't work
    return -1

# Run `cmd` found through ritzlib.process's find_command (AGAST #1481):
# $PATH, or the standard directories when it is unset or empty, as
# execvp(3) does.  Returns 0 if it is not found; if it is found but will not
# exec, reports that and returns EXIT_CANNOT_INVOKE.  Never returns on success.
fn exec_from_path(cmd: StrView, argv: **u8) -> i32
    match find_command(cmd)
        Some(path) =>
            var full: String = path
            sys_execve(string_as_ptr(@&full), argv, env_raw_envp())
            nohup_err2("nohup: failed to run '", string_as_ptr(@&full), "'")
            EXIT_CANNOT_INVOKE
        None => 0

# ============================================================================
# Main
# ============================================================================

fn main(argc: i32, argv: **u8) -> i32
    # Check for at least one argument (the command)
    if argc < 2
        print_error_ln("nohup: missing operand")
        print_error_ln("Usage: nohup COMMAND [ARG]...")
        return EXIT_NOHUP_FAILURE

    # Ignore SIGHUP
    if signal_ignore(SIGHUP) < 0
        print_error_ln("nohup: failed to ignore SIGHUP")
        return EXIT_NOHUP_FAILURE

    # If stdout is a terminal, redirect to nohup.out
    if isatty(STDOUT) != 0
        let out_fd: i32 = open_nohup_out()
        if out_fd < 0
            print_error_ln("nohup: failed to open 'nohup.out'")
            return EXIT_NOHUP_FAILURE
        # Redirect stdout to nohup.out
        sys_dup2(out_fd, STDOUT)
        sys_close(out_fd)

    # If stderr is a terminal, redirect to stdout
    if isatty(STDERR) != 0
        sys_dup2(STDOUT, STDERR)

    # Get the command to execute (argv[1])
    let cmd: *u8 = *(argv + 1)

    # Build argv for execve: argv[1], argv[2], ..., NULL
    # We can just use argv+1 since it already has the right format
    let new_argv: **u8 = argv + 1

    # Execute the command
    # A name with a '/' is a path; anything else is searched for.
    let cmd_sv: StrView = strview_from_cstr(cmd)
    if strview_find_byte(cmd_sv, '/') == cmd_sv.len
        let rc: i32 = exec_from_path(cmd_sv, new_argv)
        if rc != 0
            return rc

    # If we have a path with slash or PATH search failed, try direct exec
    sys_execve(cmd, new_argv, env_raw_envp())

    # If we get here, execve failed.
    if sys_access(cmd, F_OK) != 0
        nohup_err2("nohup: '", cmd, "': No such file or directory")
        return EXIT_NOT_FOUND

    if sys_access(cmd, X_OK) != 0
        nohup_err2("nohup: '", cmd, "': Permission denied")
        return EXIT_CANNOT_INVOKE

    nohup_err2("nohup: failed to run '", cmd, "'")
    return EXIT_CANNOT_INVOKE
