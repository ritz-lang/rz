# Tests for 35_nohup — run command immune to hangups.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_nohup_basic_execution() -> i32
    let args: [2]StrView = ["/bin/echo", "hello"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./nohup", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "nohup echo should exit 0"
            assert buf_contains(c.output(), "hello"), "missing 'hello' in output"
        Err(_) =>
            assert false, "spawn ./nohup"
    0

[[test]]
fn test_nohup_exit_zero_passthrough() -> i32
    let args: [1]StrView = ["/bin/true"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./nohup", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "nohup /bin/true should exit 0"
        Err(_) =>
            assert false, "spawn ./nohup"
    0

[[test]]
fn test_nohup_exit_nonzero_passthrough() -> i32
    let args: [1]StrView = ["/bin/false"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./nohup", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 1, "nohup /bin/false should exit 1"
        Err(_) =>
            assert false, "spawn ./nohup"
    0

[[test]]
fn test_nohup_missing_command() -> i32
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./nohup", span_empty<StrView>(), @env, "")
        Ok(c) =>
            assert c.status.exit_code == 125, "nohup (no args) should exit 125"
        Err(_) =>
            assert false, "spawn ./nohup"
    0

[[test]]
fn test_nohup_command_not_found() -> i32
    let args: [1]StrView = ["/nonexistent_xyzzy"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./nohup", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 127, "nohup <missing> should exit 127"
        Err(_) =>
            assert false, "spawn ./nohup"
    0
