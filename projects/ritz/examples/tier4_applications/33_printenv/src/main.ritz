# printenv - print environment variable values
#
# Usage: printenv [NAME]...
#   Print the values of the specified environment variables.
#   If no arguments are given, print all environment variables.
#
# Exit status:
#   0 - all variables found
#   1 - one or more variables not found
#
# Examples:
#   printenv               # print all environment variables
#   printenv PATH          # print value of PATH
#   printenv HOME USER     # print values of HOME and USER

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.span
import ritzlib.os.env

# ============================================================================
# Helpers
# ============================================================================

fn print_line(v: StrView) -> i32
    prints(v)
    prints("\n")
    0

# Print a looked-up value.  0 when the variable is set, 1 when it is not.
fn print_value(o: Option<StrView>) -> i32
    match o
        Some(v) => print_line(v)
        None => 1

# ============================================================================
# Main
# ============================================================================

fn main(argc: i32, argv: **u8) -> i32
    # If no arguments, print all environment variables
    if argc == 1
        let entries: Span<StrView> = env_iter()
        var i: i64 = 0
        while i < entries.len
            print_line(*(entries.ptr + i))
            i += 1
        return 0

    # Otherwise, print just the value (no "NAME=" prefix) of each named var
    var exit_code: i32 = 0
    for i in 1..argc
        let name: StrView = strview_from_cstr(*(argv + i))
        if print_value(env_get(name)) != 0
            exit_code = 1

    return exit_code
