# Tests for 33_printenv — print env variable values.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_printenv_single_var() -> i32
    let args: [1]StrView = ["HOME"]
    let env: [2]StrView = ["HOME=/test_home", "USER=tester"]
    match exec_capture("./printenv", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "printenv HOME should exit 0"
            assert c.out.len == 11, "expected 11 bytes (/test_home\\n)"
            assert buf_eq(c.output(), "/test_home\n"), "output mismatch"
        Err(_) =>
            assert false, "spawn ./printenv"
    0

[[test]]
fn test_printenv_multiple_vars() -> i32
    let args: [2]StrView = ["HOME", "USER"]
    let env: [2]StrView = ["HOME=/h", "USER=u"]
    match exec_capture("./printenv", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "printenv HOME USER should exit 0"
            assert buf_eq(c.output(), "/h\nu\n"), "output mismatch"
        Err(_) =>
            assert false, "spawn ./printenv"
    0

[[test]]
fn test_printenv_missing_var() -> i32
    let args: [1]StrView = ["NONEXISTENT_XYZ"]
    let env: [1]StrView = ["PATH=/usr/bin"]
    match exec_capture("./printenv", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 1, "missing var should exit 1"
        Err(_) =>
            assert false, "spawn ./printenv"
    0

[[test]]
fn test_printenv_no_args_prints_all() -> i32
    let env: [2]StrView = ["X=1", "Y=2"]
    match exec_capture("./printenv", span_empty<StrView>(), @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "printenv (no args) should exit 0"
            assert buf_contains(c.output(), "X=1"), "missing X=1"
            assert buf_contains(c.output(), "Y=2"), "missing Y=2"
        Err(_) =>
            assert false, "spawn ./printenv"
    0
