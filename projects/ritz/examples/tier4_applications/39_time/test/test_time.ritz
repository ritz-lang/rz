# Tests for 39_time — measure elapsed time of a command.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_time_emits_real() -> i32
    let args: [1]StrView = ["/bin/true"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./time", @args, @env, "")
        Ok(c) =>
            assert c.status.exit_code == 0, "time /bin/true should exit 0"
            assert buf_contains(c.output(), "real"), "missing 'real' label"
        Err(_) =>
            assert false, "spawn ./time"
    0

[[test]]
fn test_time_propagates_failure() -> i32
    # `./time /bin/false` — child exits 1.  Some implementations exit 0
    # (just wrap), others exit 1 (pass through).  Accept either; only
    # require the report to contain 'real'.
    let args: [1]StrView = ["/bin/false"]
    let env: [1]StrView = ["PATH=/bin:/usr/bin"]
    match exec_capture("./time", @args, @env, "")
        Ok(c) =>
            assert buf_contains(c.output(), "real"), "missing 'real' label"
            assert c.status.exit_code == 0 || c.status.exit_code == 1, "exit should be 0 or 1"
        Err(_) =>
            assert false, "spawn ./time"
    0
