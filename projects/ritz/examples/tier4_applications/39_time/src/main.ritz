# time - time a command execution
#
# Usage: time COMMAND [ARGS]...
#   Runs COMMAND with ARGS and reports the real (wall clock) time elapsed.
#
# Output format:
#   real    0m0.000s
#
# Examples:
#   time sleep 1     # time sleep command
#   time ls -la      # time ls command

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.option
import ritzlib.span
import ritzlib.fmt
import ritzlib.os.env
import ritzlib.fs { access }
import ritzlib.process { fork, wait_pid }
import ritzlib.time { now }
import ritzlib.result
import ritzlib.fmt

# Diagnostic helper — see 24_cp.
fn time_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

# ============================================================================
# Time formatting
# ============================================================================

fn print_time_component(n: i64)
    # Print a time component with leading zeros if needed (for 3 digits)
    if n < 10
        print("00{n}")
    else if n < 100
        print("0{n}")
    else
        print("{n}")

fn format_time(total_usec: i64)
    # Format time as Nm.NNNs
    # total_usec is microseconds

    let total_sec: i64 = total_usec / 1000000
    let usec_remainder: i64 = total_usec % 1000000
    let msec: i64 = usec_remainder / 1000

    let minutes: i64 = total_sec / 60
    let seconds: i64 = total_sec % 60

    # Print: NmN.NNNs
    print("{minutes}m{seconds}.")
    print_time_component(msec)
    print("s")

# ============================================================================
# Command execution
# ============================================================================

fn find_in_path(name: *u8, result: *u8) -> i32
    # Find command in PATH, store full path in result
    # Returns 0 on success, 1 on failure

    # If name contains a '/', use it directly
    var i: i64 = 0
    while *(name + i) != 0
        if *(name + i) == '/'  # '/'
            # Copy name to result
            var j: i64 = 0
            while *(name + j) != 0
                *(result + j) = *(name + j)
                j += 1
            *(result + j) = 0

            # Check if executable
            if access(StrView { ptr: result, len: j }, X_OK).is_ok()
                return 0
            return 1
        i += 1

    # Get PATH from environment.  Unset and empty both search nothing.
    let path: StrView = env_get_or("PATH", "")

    var pos: i64 = 0
    var path_buf: [4096]u8

    while pos < path.len
        # Extract next PATH component
        var len: i64 = 0
        while pos + len < path.len and *(path.ptr + pos + len) != 58  # ':'
            path_buf[len] = *(path.ptr + pos + len)
            len += 1

        path_buf[len] = 0

        # Build full path: dir/name
        var j: i64 = 0
        while j < len
            *(result + j) = path_buf[j]
            j += 1

        # Add '/' separator
        *(result + j) = 47  # '/'
        j += 1

        # Add command name
        var k: i64 = 0
        while *(name + k) != 0
            *(result + j) = *(name + k)
            j += 1
            k += 1

        *(result + j) = 0

        # Check if executable
        if access(StrView { ptr: result, len: j }, X_OK).is_ok()
            return 0

        # Move to next PATH component
        pos += len
        if pos < path.len and *(path.ptr + pos) == ':'  # ':'
            pos += 1

    return 1

# In the forked child: exec `cmd_path` (a NUL-terminated full path) with the
# stack-built `argv`. The raw execve: nothing may allocate between fork and
# exec. Never returns.
fn exec_child(cmd_path: *u8, argv: **u8) -> i32
    sys_execve(cmd_path, argv, env_raw_envp())

    # If execve returns, it failed.
    time_err2("time: ", cmd_path, ": exec failed")
    sys_exit(126)
    126

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    # Need at least one argument (the command to run)
    if args.len < 2
        eprint("Usage: time COMMAND [ARGS]...\n")
        return 1

    # Get command name
    let cmd_v: StrView = args[1]
    let cmd_name: *u8 = cmd_v.ptr

    # Find command in PATH
    var cmd_path: [4096]u8
    if find_in_path(cmd_name, @cmd_path[0]) != 0
        time_err2("time: ", cmd_name, ": command not found")
        return 127

    # Build argv for child process (skip our "time" args[0])
    # We need to create a new argv array starting from args[1].  Each argv
    # StrView ends at argv's NUL, so .ptr is a valid C string.
    var child_argv: [256]*u8
    let max_args: i64 = if args.len - 1 < 255 then args.len - 1 else 255
    for i in 0..max_args
        let a: StrView = args[1 + i]
        child_argv[i] = a.ptr
    child_argv[max_args] = null

    # Get start time
    let start_time: Timeval = now()

    # Fork
    let pid: i32 = match fork()
        Ok(fr) =>
            match fr
                Child => exec_child(@cmd_path[0], @child_argv[0])
                Parent(child) => child
        Err(_) =>
            eprint("time: fork failed\n")
            return 1

    # Parent process: wait for child. Its exit code if it exited, 128 +
    # the signal if one killed it; 0 if the wait failed.
    let exit_status: i32 = match wait_pid(pid)
        Ok(r) => r.exit_code
        Err(_) => 0

    # Get end time
    let end_time: Timeval = now()

    # Calculate elapsed time in microseconds
    var elapsed_usec: i64 = (end_time.tv_sec - start_time.tv_sec) * 1000000
    elapsed_usec += (end_time.tv_usec - start_time.tv_usec)

    # Print timing (to stderr, like real 'time' does)
    # Need to print to stderr - format_time prints to stdout
    let total_sec: i64 = elapsed_usec / 1000000
    let usec_remainder: i64 = elapsed_usec % 1000000
    let msec: i64 = usec_remainder / 1000

    let minutes: i64 = total_sec / 60
    let seconds: i64 = total_sec % 60

    # Print milliseconds with leading zeros
    if msec < 10
        eprint("\nreal\t{minutes}m{seconds}.00{msec}s\n")
    else if msec < 100
        eprint("\nreal\t{minutes}m{seconds}.0{msec}s\n")
    else
        eprint("\nreal\t{minutes}m{seconds}.{msec}s\n")

    return exit_status
