# Tier 2: Multi-connection concurrent echo server using io_uring
# Tests: io_uring submit/complete cycle, multiple pending operations
# Expected: Can handle multiple connections concurrently
#
# Simplified architecture with fixed-size connection state:
# - One io_uring ring handles all I/O
# - Connection state tracked in fixed-size arrays
# - User data encodes slot and operation type

import ritzlib.io
import ritzlib.async_net
import ritzlib.uring
import ritzlib.result
import ritzlib.sys
import ritzlib.strview
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.fmt
import ritzlib.fd { Fd, fd_adopt }


# Operation types
const OP_ACCEPT: i64 = 1
const OP_RECV: i64 = 2
const OP_SEND: i64 = 3

# Limits
const MAX_CONNS: i32 = 16
const BUF_SIZE: i32 = 4096


fn encode_user_data(slot: i32, op: i64) -> i64
    return ((slot as i64) << 8) | op


fn decode_slot(user_data: i64) -> i32
    return ((user_data >> 8) & 0xFF) as i32


fn decode_op(user_data: i64) -> i64
    return user_data & 0xFF


fn run_server(port: i32, max_handled: i32)
    # Create server socket
    var srv: Socket
    match socket_tcp()
        Ok(s) => srv = s
        Err(_) =>
            print("Failed to create socket\n")
            return

    srv.set_reuseaddr()

    match srv.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(_) =>
            print("Failed to bind\n")
            srv.close()
            return

    match srv.listen(128)
        Ok(_) => pass
        Err(_) =>
            print("Failed to listen\n")
            srv.close()
            return

    # The ring's accept SQEs take the descriptor.
    let server_fd: i32 = srv.raw()

    print("Tier 2 Echo Server (io_uring) listening on port {port}\n")

    # Initialize io_uring
    var ring: IoUring
    if ring.init(64) < 0
        print("Failed to init io_uring\n")
        srv.close()
        return

    # Connection tracking: one Fd and one BUF_SIZE buffer per slot
    var conn_fds: [16]Fd
    var buf_mem: [65536]u8  # MAX_CONNS * BUF_SIZE
    var conn_bufs: [16]*u8

    # Initialize to closed (free)
    for i in 0..MAX_CONNS
        conn_fds[i] = fd_adopt(-1)  # closed = free slot
        conn_bufs[i] = @buf_mem[(i * BUF_SIZE) as i64]

    var accept_pending: i32 = 0
    var active_conns: i32 = 0
    var total_handled: i32 = 0

    # Submit initial accept (user_data is last param)
    var accept_sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => accept_sqe = p
        None =>
            print("FAIL: could not get accept SQE\n")
            return
    let accept_ud: i64 = encode_user_data(0, OP_ACCEPT)
    accept_sqe.prep_accept(server_fd, 0, accept_ud)
    ring.sqe_submit()
    ring.submit()
    accept_pending = 1

    # Event loop
    while total_handled < max_handled or active_conns > 0
        match ring.submit_and_wait(1)
            Ok(_) => pass
            Err(_) =>
                print("io_uring wait error\n")
                break

        # Process completions
        loop
            let cqe: *IoUringCqe = match ring.peek_cqe()
                Some(p) => p
                None => break

            let user_data: i64 = cqe.get_data64()
            let result: i32 = cqe.res
            let slot: i32 = decode_slot(user_data)
            let op: i64 = decode_op(user_data)

            ring.cqe_seen(@*cqe)

            if op == OP_ACCEPT
                accept_pending = 0
                if result >= 0
                    # Find free slot
                    var found_slot: i32 = 0
                    for i in 0..MAX_CONNS
                        if not conn_fds[i].valid()
                            found_slot = i
                            break

                    if found_slot >= 0 and found_slot < MAX_CONNS
                        conn_fds[found_slot] = fd_adopt(result)
                        active_conns += 1

                        # Submit recv (user_data is last param)
                        match ring.get_sqe()
                            Some(p) =>
                                let recv_sqe: *IoUringSqe = p
                                let recv_ud: i64 = encode_user_data(found_slot, OP_RECV)
                                recv_sqe.prep_recv(result, Span<u8> { ptr: conn_bufs[found_slot], len: BUF_SIZE as i64 }, 0, recv_ud)
                                ring.sqe_submit()
                            None => pass
                    else
                        var rejected: Fd = fd_adopt(result)
                        rejected.close()

                # Re-submit accept if we want more connections
                if total_handled < max_handled
                    match ring.get_sqe()
                        Some(p) =>
                            let new_accept: *IoUringSqe = p
                            let new_accept_ud: i64 = encode_user_data(0, OP_ACCEPT)
                            new_accept.prep_accept(server_fd, 0, new_accept_ud)
                            ring.sqe_submit()
                            accept_pending = 1
                        None => pass

            else if op == OP_RECV
                if result <= 0
                    # Client closed or error
                    conn_fds[slot].close()
                    active_conns -= 1
                    total_handled += 1
                else
                    # Echo back (user_data is last param)
                    match ring.get_sqe()
                        Some(p) =>
                            let send_sqe: *IoUringSqe = p
                            let send_ud: i64 = encode_user_data(slot, OP_SEND)
                            send_sqe.prep_send(conn_fds[slot].raw(), Span<u8> { ptr: conn_bufs[slot], len: result as i64 }, 0, send_ud)
                            ring.sqe_submit()
                        None => pass

            else if op == OP_SEND
                if result < 0
                    # Send error
                    conn_fds[slot].close()
                    active_conns -= 1
                    total_handled += 1
                else
                    # Submit another recv
                    match ring.get_sqe()
                        Some(p) =>
                            let next_recv: *IoUringSqe = p
                            let next_recv_ud: i64 = encode_user_data(slot, OP_RECV)
                            next_recv.prep_recv(conn_fds[slot].raw(), Span<u8> { ptr: conn_bufs[slot], len: BUF_SIZE as i64 }, 0, next_recv_ud)
                            ring.sqe_submit()
                        None => pass

    # Cleanup
    for i in 0..MAX_CONNS
        conn_fds[i].close()  # Ok and a no-op for a free slot

    ring.cleanup()
    srv.close()

    print("Server finished after {total_handled} connections\n")


# Port to listen on.  regression.sh passes a free per-run port in
# RITZ_EXAMPLE_PORT so concurrent runs on one host cannot collide (AGAST
# #1535); run by hand, the example keeps its historical default.
fn port_in_range(p: i64, default_port: i32) -> i32
    if p <= 0 or p > 65535
        return default_port
    return p as i32

fn port_or(o: Option<i64>, default_port: i32) -> i32
    match o
        Some(p) => port_in_range(p, default_port)
        None => default_port

# Unset, empty or non-numeric all fall back to the default.
fn listen_port(default_port: i32) -> i32
    let s: StrView = env_get_or("RITZ_EXAMPLE_PORT", "")
    return port_or(s.parse_i64(), default_port)


pub fn main() -> i32
    run_server(listen_port(9002), 10)
    return 0
