# Tests for 25_mv — rename/move files.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib
import ritzlib.result

[[test]]
fn test_mv_renames_within_dir() -> i32
    var a: String = sandbox_path("mv", "a")
    var b: String = sandbox_path("mv", "b")
    unlink(a.as_view())
    unlink(b.as_view())
    assert write_file(a.as_view(), "payload\n").is_ok(), "setup: a"

    let args: [2]StrView = [a.as_view(), b.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mv", @args, span_empty<StrView>(), "")

    let exists_a: bool = path_exists(a.as_view())
    let back: Result<String, Errno> = read_file(b.as_view())
    unlink(a.as_view())
    unlink(b.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "mv a b should exit 0"
        Err(_) =>
            assert false, "spawn ./mv"
    assert not exists_a, "a should be gone"
    match back
        Ok(s) =>
            assert s.len() == 8, "b should have 8 bytes"
            assert s.eq("payload\n"), "payload mismatch"
        Err(_) =>
            assert false, "read b"
    0

[[test]]
fn test_mv_between_subdirs() -> i32
    var d1: String = sandbox_path("mv", "d1")
    var d2: String = sandbox_path("mv", "d2")
    rmdir(d1.as_view())
    rmdir(d2.as_view())
    if mkdir(d1.as_view(), 493).is_err()
        assert 0 == 1, "setup: d1"
    if mkdir(d2.as_view(), 493).is_err()
        rmdir(d1.as_view())
        assert 0 == 1, "setup: d2"

    var src: String = sandbox_path("mv", "d1/f")
    var dst: String = sandbox_path("mv", "d2/f")

    if not write_file(src.as_view(), "x").is_ok()
        rmdir(d1.as_view())
        rmdir(d2.as_view())
        assert 0 == 1, "setup: src file"

    let args: [2]StrView = [src.as_view(), dst.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mv", @args, span_empty<StrView>(), "")

    let exists_src: bool = path_exists(src.as_view())
    let exists_dst: bool = path_exists(dst.as_view())
    unlink(src.as_view())
    unlink(dst.as_view())
    rmdir(d1.as_view())
    rmdir(d2.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "mv across dirs should exit 0"
        Err(_) =>
            assert false, "spawn ./mv"
    assert not exists_src, "src should be gone"
    assert exists_dst, "dst should exist"
    0

[[test]]
fn test_mv_missing_source_errors() -> i32
    var src: String = sandbox_path("mv", "never")
    var dst: String = sandbox_path("mv", "target")
    unlink(src.as_view())
    unlink(dst.as_view())

    let args: [2]StrView = [src.as_view(), dst.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mv", @args, span_empty<StrView>(), "")
    unlink(dst.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 1, "mv of missing source should exit 1"
        Err(_) =>
            assert false, "spawn ./mv"
    0
