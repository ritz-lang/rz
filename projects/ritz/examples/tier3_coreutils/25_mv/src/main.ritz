# mv - move (rename) files
#
# Usage: mv [OPTIONS] SOURCE DEST
#        mv [OPTIONS] SOURCE... DIRECTORY
#
# Options:
#   -v        verbose: print files as they're moved
#   -n        do not overwrite existing files
#   -f        force: overwrite without prompting
#
# Examples:
#   mv old.txt new.txt       # rename file
#   mv file.txt dir/         # move to directory
#   mv a b c dir/            # move multiple files

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.fd { Fd, fd_open }
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct MvOptions
    verbose: i32     # -v
    no_clobber: i32  # -n
    force: i32       # -f

# ============================================================================
# Diagnostic helpers — see 24_cp for the rationale.  StrView (`"..."`)
# for fixed prefixes/suffixes and for runtime path data.
# ============================================================================

fn mv_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

fn mv_err3(prefix: StrView, src: StrView, mid: StrView, dst: StrView, suffix: StrView) -> i32
    eprint("{prefix}{src}{mid}{dst}{suffix}\n")
    return 1

fn mv_print3(prefix: StrView, src: StrView, mid: StrView, dst: StrView, suffix: StrView)
    print("{prefix}{src}{mid}{dst}{suffix}\n")

# ============================================================================
# Helpers
# ============================================================================

fn get_file_mode(path: StrView) -> i32
    # Get permission bits only (lower 12 bits)
    match lstat(path)
        Ok(st) => st.st_mode % 4096
        Err(_) => 420  # Default 0644

# ============================================================================
# Copy file (for cross-device moves)
# ============================================================================

# Copy every byte of `src_fd` to `dst_fd`: 0, or -1 on a read/write error.
fn copy_fd_data(src_fd: @Fd, dst_fd: @Fd) -> i32
    var buf: [8192]u8
    loop
        let nread: i64 = match src_fd.read(Span<u8> { ptr: @buf[0], len: 8192 })
            Ok(n) => n
            Err(_) => return -1
        if nread == 0
            return 0
        # Write all bytes read
        if dst_fd.write_all(Span<u8> { ptr: @buf[0], len: nread }).is_err()
            return -1

fn copy_file_for_move(src: StrView, dst: StrView) -> i32
    # Get source file mode to preserve permissions
    let mode: i32 = get_file_mode(src)

    # Open source for reading
    var src_fd: Fd = match fd_open(src, O_RDONLY, 0)
        Ok(f) => f
        Err(_) => return -1

    # Open dest for writing, create/truncate
    var dst_fd: Fd = match fd_open(dst, O_WRONLY + O_CREAT + O_TRUNC, mode)
        Ok(f) => f
        Err(_) =>
            src_fd.close()
            return -1

    let result: i32 = copy_fd_data(@src_fd, @dst_fd)

    src_fd.close()
    dst_fd.close()

    # If copy failed, try to clean up destination
    if result != 0
        unlink(dst)

    return result

# ============================================================================
# Move function
# ============================================================================

fn move_path(src: StrView, dst: StrView, opts: *MvOptions) -> i32
    # Check if source exists
    if not path_exists(src)
        return mv_err2("mv: cannot stat '", src, "': No such file or directory")

    # Check if destination exists and -n is set
    if opts.no_clobber != 0 and path_exists(dst)
        return 0  # Silently skip

    # Try rename (works if same filesystem)
    let err_code: i32 = match rename(src, dst)
        Ok(_) => 0
        Err(e) => e.code()

    if err_code == 0
        if opts.verbose != 0
            mv_print3("renamed '", src, "' -> '", dst, "'")
        return 0

    # Check for cross-device error (EXDEV)
    if err_code == EXDEV
        # Cross-device move: copy then unlink.
        # We don't support cross-device directory moves.
        if is_dir(src)
            return mv_err2("mv: cannot move '", src, "' to different device (directory move not supported)")

        # Copy file to destination
        if copy_file_for_move(src, dst) != 0
            return mv_err3("mv: cannot copy '", src, "' to '", dst, "'")

        # Remove source — non-fatal warning if it fails (copy already succeeded)
        if unlink(src).is_err()
            mv_err2("mv: cannot remove '", src, "'")
            return 0

        if opts.verbose != 0
            mv_print3("'", src, "' -> '", dst, "' (cross-device)")

        return 0

    # Other error
    return mv_err3("mv: cannot move '", src, "' to '", dst, "'")

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("mv", "Move or rename files")
    spec.switch('v', "verbose", "Print files as they're moved")
    spec.switch('n', "no-clobber", "Do not overwrite existing files")
    spec.switch('f', "force", "Force overwrite without prompting")
    spec.positionals("SOURCE... DEST", "Source file(s) and destination", 2, ARGS_UNLIMITED)
    spec

# "mv: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn mv_all(p: @ParsedArgs) -> i32
    var opts: MvOptions
    opts.verbose = p.switch("verbose") as i32
    opts.no_clobber = p.switch("no-clobber") as i32
    opts.force = p.switch("force") as i32

    # Last positional is DEST, all others are SOURCEs.
    let pos = p.positionals()
    let num_args: i64 = pos.len
    let last_arg: StrView = pos.get(num_args - 1)
    let dst_is_dir: i32 = is_dir(last_arg) as i32

    # Multi-source case requires directory destination.
    if num_args > 2 and dst_is_dir == 0
        return mv_err2("mv: target '", last_arg, "' is not a directory")

    var result: i32 = 0

    if num_args == 2
        let src: StrView = pos.get(0)
        let dst: StrView = pos.get(1)

        if dst_is_dir != 0
            var dst_path: String = path_join(dst, path_basename(src))
            result = move_path(src, dst_path.as_view(), @opts)
        else
            result = move_path(src, dst, @opts)
    else
        for i in 0..(num_args - 1)
            let src: StrView = pos.get(i)
            var dst_path: String = path_join(last_arg, path_basename(src))

            let r: i32 = move_path(src, dst_path.as_view(), @opts)
            if r != 0
                result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = mv_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
