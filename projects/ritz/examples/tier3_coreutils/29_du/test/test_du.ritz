# Tests for 29_du — disk usage.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_du_empty_dir() -> i32
    var path: String = sandbox_path("du", "empty")
    sys_rmdir(path.as_ptr())
    if sys_mkdir(path.as_ptr(), 493) < 0
        assert 0 == 1, "setup: empty dir"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./du", @args, span_empty<StrView>(), "")
    sys_rmdir(path.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "du <empty dir> should exit 0"
            assert c.out.len > 0, "du should produce output"
            assert buf_contains(c.output(), span_from_strview(path.as_view())), "output should mention path"
        Err(_) =>
            assert false, "spawn ./du"
    0

[[test]]
fn test_du_nonempty_tree() -> i32
    var root: String = sandbox_path("du", "nest")
    sys_rmdir(root.as_ptr())
    if sys_mkdir(root.as_ptr(), 493) < 0
        assert 0 == 1, "setup: root"

    # root/a/
    var a_dir: String = sandbox_path("du", "nest/a")
    sys_mkdir(a_dir.as_ptr(), 493)

    # root/a/file
    var a_file: String = sandbox_path("du", "nest/a/f")
    write_file(a_file.as_view(), "data\n")

    let args: [1]StrView = [root.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./du", @args, span_empty<StrView>(), "")

    sys_unlink(a_file.as_ptr())
    sys_rmdir(a_dir.as_ptr())
    sys_rmdir(root.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "du <tree> should exit 0"
            assert buf_contains(c.output(), span_from_strview(root.as_view())), "output should mention root"
        Err(_) =>
            assert false, "spawn ./du"
    0
