# du - estimate file space usage
#
# Usage: du [OPTIONS] [FILE...]
#   Summarize disk usage of FILE(s), recursively for directories.
#
# Options:
#   -s        display only a total for each argument
#   -h        human-readable sizes (K, M, G)
#   -a        show all files, not just directories
#   -c        produce a grand total
#
# Examples:
#   du                  # current directory
#   du -sh dir/         # summary, human-readable
#   du -a file.txt      # single file

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn du_warn2(prefix: StrView, path: StrView, suffix: StrView)
    eprint("{prefix}{path}{suffix}\n")

# ============================================================================
# Options
# ============================================================================

struct DuOptions
    summary: i32     # -s
    human: i32       # -h
    all: i32         # -a
    total: i32       # -c

# ============================================================================
# Du functions
# ============================================================================

fn print_size(blocks: i64, path: StrView, opts: *DuOptions)
    # Blocks are in 512-byte units, convert to KB
    let kb: i64 = blocks / 2
    if opts.human != 0
        print_size_human(kb * 1024)
    else
        print("{kb}")
    print("\t{path}\n")

fn du_path(path: StrView, opts: *DuOptions) -> i64
    var blocks: i64 = 0
    match lstat(path)
        Ok(st) => blocks = st.st_blocks
        Err(_) =>
            du_warn2("du: cannot access '", path, "'")
            return 0

    if not is_dir(path)
        # Regular file
        if opts.all != 0 and opts.summary == 0
            print_size(blocks, path, opts)
        return blocks

    # Directory: recurse
    var dir: DirIter = match dir_open(path)
        Ok(it) => it
        Err(_) =>
            du_warn2("du: cannot read directory '", path, "'")
            return blocks

    var total: i64 = blocks

    while dir.next()
        let e: DirEntry = dir.entry()
        if not e.name.eq(".") and not e.name.eq("..")
            var child: String = path_join(path, e.name)
            total += du_path(child.as_view(), opts)

    dir.close()

    if opts.summary == 0
        print_size(total, path, opts)

    return total

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("du", "Estimate file space usage")
    spec.switch('s', "summary", "Display only a total for each argument")
    spec.switch('h', "human-readable", "Print sizes in human readable format")
    spec.switch('a', "all", "Show all files, not just directories")
    spec.switch('c', "total", "Produce a grand total")
    spec.positionals("FILE", "Files or directories to analyze", 0, ARGS_UNLIMITED)
    spec

# "du: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn du_all(p: @ParsedArgs) -> i32
    var opts: DuOptions
    opts.summary = p.switch("summary") as i32
    opts.human = p.switch("human-readable") as i32
    opts.all = p.switch("all") as i32
    opts.total = p.switch("total") as i32

    var grand_total: i64 = 0
    let pos = p.positionals()
    let num_args: i64 = pos.len

    if num_args == 0
        # Default to current directory
        let t: i64 = du_path(".", @opts)
        if opts.summary != 0
            print_size(t, ".", @opts)
        grand_total = t
    else
        for i in 0..num_args
            let path: StrView = pos.get(i)
            let t: i64 = du_path(path, @opts)
            if opts.summary != 0
                print_size(t, path, @opts)
            grand_total += t

    if opts.total != 0 and num_args > 1
        print_size(grand_total, "total", @opts)

    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = du_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
