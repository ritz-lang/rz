# du - estimate file space usage
#
# Usage: du [OPTIONS] [FILE...]
#   Summarize disk usage of FILE(s), recursively for directories.
#
# Options:
#   -s        display only a total for each argument
#   -h        human-readable sizes (K, M, G)
#   -a        show all files, not just directories
#   -c        produce a grand total
#
# Examples:
#   du                  # current directory
#   du -sh dir/         # summary, human-readable
#   du -a file.txt      # single file

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn du_warn2(prefix: StrView, path: *u8, suffix: StrView)
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)

# ============================================================================
# Options
# ============================================================================

struct DuOptions
    summary: i32     # -s
    human: i32       # -h
    all: i32         # -a
    total: i32       # -c

# ============================================================================
# Du functions
# ============================================================================

fn print_size(blocks: i64, path: *u8, opts: *DuOptions)
    # Blocks are in 512-byte units, convert to KB
    let kb: i64 = blocks / 2
    if opts.human != 0
        print_size_human(kb * 1024)
    else
        print_int(kb)
    print_char(9)  # tab
    prints_cstr(path)
    print_char(10)

fn du_path(path: *u8, opts: *DuOptions) -> i64
    var blocks: i64 = 0
    match lstat(strview_from_cstr(path))
        Ok(st) => blocks = st.st_blocks
        Err(_) =>
            du_warn2("du: cannot access '", path, "'")
            return 0

    if not is_dir(strview_from_cstr(path))
        # Regular file
        if opts.all != 0 and opts.summary == 0
            print_size(blocks, path, opts)
        return blocks

    # Directory: recurse
    var dir: DirIter = match dir_open(strview_from_cstr(path))
        Ok(it) => it
        Err(_) =>
            du_warn2("du: cannot read directory '", path, "'")
            return blocks

    var total: i64 = blocks

    while dir.next()
        let e: DirEntry = dir.entry()
        let name: *u8 = e.name.ptr

        if not streq(name, c".") and not streq(name, c"..")
            var child: String = path_join(strview_from_cstr(path), e.name)
            total += du_path(string_as_ptr(@&child), opts)

    dir.close()

    if opts.summary == 0
        print_size(total, path, opts)

    return total

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("du", "Estimate file space usage")
    argspec_switch(@&spec, 's', "summary", "Display only a total for each argument")
    argspec_switch(@&spec, 'h', "human-readable", "Print sizes in human readable format")
    argspec_switch(@&spec, 'a', "all", "Show all files, not just directories")
    argspec_switch(@&spec, 'c', "total", "Produce a grand total")
    argspec_positionals(@&spec, "FILE", "Files or directories to analyze", 0, ARGS_UNLIMITED)
    spec

# "du: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn du_all(p: @ParsedArgs) -> i32
    var opts: DuOptions
    opts.summary = parsed_switch(p, "summary") as i32
    opts.human = parsed_switch(p, "human-readable") as i32
    opts.all = parsed_switch(p, "all") as i32
    opts.total = parsed_switch(p, "total") as i32

    var grand_total: i64 = 0
    let pos = parsed_positionals(p)
    let num_args: i64 = pos.len

    if num_args == 0
        # Default to current directory
        let t: i64 = du_path(c".", @opts)
        if opts.summary != 0
            print_size(t, c".", @opts)
        grand_total = t
    else
        for i in 0..num_args
            let path: *u8 = positional_cstr(@pos, i)
            let t: i64 = du_path(path, @opts)
            if opts.summary != 0
                print_size(t, path, @opts)
            grand_total += t

    if opts.total != 0 and num_args > 1
        print_size(grand_total, c"total", @opts)

    return 0

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = du_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
