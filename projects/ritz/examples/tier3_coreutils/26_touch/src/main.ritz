# touch - change file timestamps or create empty files
#
# Usage: touch [OPTIONS] FILE...
#   Update access and modification times of FILE(s).
#   Create empty FILE(s) if they do not exist.
#
# Options:
#   -a        change only access time
#   -m        change only modification time
#   -c        do not create any files
#
# Examples:
#   touch file.txt          # create or update timestamp
#   touch -c file.txt       # update only if exists
#   touch -a file.txt       # update access time only

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn touch_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    s.push_cstr(path)
    s.push_str(suffix)
    eprintln_string(@s)
    return 1

# ============================================================================
# Options
# ============================================================================

struct TouchOptions
    access_only: i32   # -a
    modify_only: i32   # -m
    no_create: i32     # -c

# ============================================================================
# Touch function
# ============================================================================

fn touch_file(path: *u8, opts: *TouchOptions) -> i32
    # Create file if needed
    if not path_exists(strview_from_cstr(path))
        if opts.no_create != 0
            return 0  # -c: silently skip

        # Create empty file: O_CREAT | O_WRONLY = 65
        let fd: i32 = sys_open3(path, 65, 420)  # mode 0644
        if fd < 0
            return touch_err2("touch: cannot create '", path, "'")
        sys_close(fd)
        return 0  # File created with current timestamp

    # Update timestamps using utimensat
    # times is array of 2 timespec structs (16 bytes each)
    # timespec { tv_sec: i64, tv_nsec: i64 }
    var times: [4]i64

    if opts.access_only != 0
        # Update atime only
        times[0] = 0
        times[1] = UTIME_NOW  # for atime
        times[2] = 0
        times[3] = UTIME_OMIT  # for mtime
    else if opts.modify_only != 0
        # Update mtime only
        times[0] = 0
        times[1] = UTIME_OMIT  # for atime
        times[2] = 0
        times[3] = UTIME_NOW  # for mtime
    else
        # Update both
        times[0] = 0
        times[1] = UTIME_NOW  # for atime
        times[2] = 0
        times[3] = UTIME_NOW  # for mtime

    let result: i32 = sys_utimensat(at_fdcwd(), path, @times[0], 0)
    if result != 0
        return touch_err2("touch: cannot touch '", path, "'")

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("touch", "Change file timestamps or create empty files")
    argspec_switch(@&spec, 'a', "access", "Change only access time")
    argspec_switch(@&spec, 'm', "modify", "Change only modification time")
    argspec_switch(@&spec, 'c', "no-create", "Do not create any files")
    argspec_positionals(@&spec, "FILE", "File(s) to touch", 1, ARGS_UNLIMITED)
    spec

# "touch: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn touch_all(p: @ParsedArgs) -> i32
    var opts: TouchOptions
    opts.access_only = parsed_switch(p, "access") as i32
    opts.modify_only = parsed_switch(p, "modify") as i32
    opts.no_create = parsed_switch(p, "no-create") as i32

    # Process each file
    var result: i32 = 0
    let pos = parsed_positionals(p)
    for i in 0..pos.len
        let path: *u8 = positional_cstr(@pos, i)
        let r: i32 = touch_file(path, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = touch_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
