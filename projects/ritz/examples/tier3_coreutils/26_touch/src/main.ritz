# touch - change file timestamps or create empty files
#
# Usage: touch [OPTIONS] FILE...
#   Update access and modification times of FILE(s).
#   Create empty FILE(s) if they do not exist.
#
# Options:
#   -a        change only access time
#   -m        change only modification time
#   -c        do not create any files
#
# Examples:
#   touch file.txt          # create or update timestamp
#   touch -c file.txt       # update only if exists
#   touch -a file.txt       # update access time only

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.fd { Fd, fd_open }
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn touch_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

# ============================================================================
# Options
# ============================================================================

struct TouchOptions
    access_only: i32   # -a
    modify_only: i32   # -m
    no_create: i32     # -c

# ============================================================================
# Touch function
# ============================================================================

fn touch_file(path: StrView, opts: *TouchOptions) -> i32
    # Create file if needed
    if not path_exists(path)
        if opts.no_create != 0
            return 0  # -c: silently skip

        # Create empty file: O_CREAT | O_WRONLY
        var f: Fd = match fd_open(path, O_CREAT + O_WRONLY, 420)  # mode 0644
            Ok(opened) => opened
            Err(_) => return touch_err2("touch: cannot create '", path, "'")
        f.close()
        return 0  # File created with current timestamp

    # Update timestamps (utimensat): Now sets one to the current time, Omit
    # leaves it unchanged.
    var atime: FileTime = FileTime.Now
    var mtime: FileTime = FileTime.Now
    if opts.access_only != 0
        # Update atime only
        mtime = FileTime.Omit
    else if opts.modify_only != 0
        # Update mtime only
        atime = FileTime.Omit

    if set_times(path, atime, mtime).is_err()
        return touch_err2("touch: cannot touch '", path, "'")

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("touch", "Change file timestamps or create empty files")
    spec.switch('a', "access", "Change only access time")
    spec.switch('m', "modify", "Change only modification time")
    spec.switch('c', "no-create", "Do not create any files")
    spec.positionals("FILE", "File(s) to touch", 1, ARGS_UNLIMITED)
    spec

# "touch: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn touch_all(p: @ParsedArgs) -> i32
    var opts: TouchOptions
    opts.access_only = p.switch("access") as i32
    opts.modify_only = p.switch("modify") as i32
    opts.no_create = p.switch("no-create") as i32

    # Process each file
    var result: i32 = 0
    let pos = p.positionals()
    for i in 0..pos.len
        let path: StrView = pos.get(i)
        let r: i32 = touch_file(path, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = touch_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
