# Tests for 26_touch — create/update file timestamps.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib
import ritzlib.result
import ritzlib.time

# Wall-clock seconds since epoch.
fn now_seconds() -> i64
    let tv: Timeval = now()
    return tv.tv_sec

# Modification time of `path` in seconds, or -1 if it cannot be statted.
fn mtime_of(path: StrView) -> i64
    match stat(path)
        Ok(st) => st.st_mtime
        Err(_) => -1

# Size of `path` in bytes, or -1 if it cannot be statted.
fn size_of(path: StrView) -> i64
    match stat(path)
        Ok(st) => st.st_size
        Err(_) => -1

[[test]]
fn test_touch_creates_new_file() -> i32
    var path: String = sandbox_path("touch", "new")
    unlink(path.as_view())

    let t_before: i64 = now_seconds()

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./touch", @args, span_empty<StrView>(), "")

    let exists: bool = path_exists(path.as_view())
    let size: i64 = size_of(path.as_view())
    let mtime: i64 = mtime_of(path.as_view())
    let t_after: i64 = now_seconds()
    unlink(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "touch new file should exit 0"
        Err(_) =>
            assert false, "spawn ./touch"
    assert exists, "file should exist"
    assert size == 0, "new file should be empty"
    # touch's defining job is setting mtime — verify the new file's
    # mtime falls in the [before, after] window of wall-clock time
    # bracketing the touch call.  Allow ±2s slack for FS rounding.
    assert mtime >= t_before - 2, "mtime should be >= 'before' window"
    assert mtime <= t_after + 2, "mtime should be <= 'after' window"
    0

[[test]]
fn test_touch_preserves_content_updates_mtime() -> i32
    var path: String = sandbox_path("touch", "existing")
    unlink(path.as_view())
    assert write_file(path.as_view(), "keep me\n").is_ok(), "setup: write existing"

    let t_before: i64 = now_seconds()

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./touch", @args, span_empty<StrView>(), "")

    let back: Result<String, Errno> = read_file(path.as_view())
    let mtime: i64 = mtime_of(path.as_view())
    let t_after: i64 = now_seconds()
    unlink(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "touch existing should exit 0"
        Err(_) =>
            assert false, "spawn ./touch"
    match back
        Ok(s) =>
            assert s.len() == 8, "content length unchanged"
            assert s.eq("keep me\n"), "content preserved"
        Err(_) =>
            assert false, "read existing"
    # The defining behavior of `touch <existing>` is to bring its mtime
    # forward to "now"; verify the new mtime falls within [before-2, after+2].
    assert mtime >= t_before - 2, "mtime should be updated to the 'before' window"
    assert mtime <= t_after + 2, "mtime should be no later than the 'after' window"
    0

[[test]]
fn test_touch_multiple_files() -> i32
    var p1: String = sandbox_path("touch", "m_a")
    var p2: String = sandbox_path("touch", "m_b")
    var p3: String = sandbox_path("touch", "m_c")
    unlink(p1.as_view())
    unlink(p2.as_view())
    unlink(p3.as_view())

    let args: [3]StrView = [p1.as_view(), p2.as_view(), p3.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./touch", @args, span_empty<StrView>(), "")

    let exists1: bool = path_exists(p1.as_view())
    let exists2: bool = path_exists(p2.as_view())
    let exists3: bool = path_exists(p3.as_view())
    unlink(p1.as_view())
    unlink(p2.as_view())
    unlink(p3.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "touch multi should exit 0"
        Err(_) =>
            assert false, "spawn ./touch"
    assert exists1, "a should exist"
    assert exists2, "b should exist"
    assert exists3, "c should exist"
    0
