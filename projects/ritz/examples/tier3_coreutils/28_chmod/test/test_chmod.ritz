# Tests for 28_chmod — change file mode.
#
# Verifies the actual perm bits via sys_stat2 + 0o777 mask, not just the
# binary's exit code.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib

# Read the file's permission bits (0o777 mask) via stat.
fn read_perms(path: *u8) -> i32
    var st: Stat
    if sys_stat2(path, @&st) != 0
        return -1
    return st.st_mode & 0x1FF  # 0o777

[[test]]
fn test_chmod_755() -> i32
    var path: String = sandbox_path("chmod", "f755")
    sys_unlink(path.as_ptr())
    assert write_file(path.as_view(), "").is_ok(), "setup: file"

    let args: [2]StrView = ["755", path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./chmod", @args, span_empty<StrView>(), "")
    let perms: i32 = read_perms(path.as_ptr())
    sys_unlink(path.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "chmod 755 should exit 0"
        Err(_) =>
            assert false, "spawn ./chmod"
    assert perms == 0x1ED, "perms should be 0o755"  # 0o755 = 493 = 0x1ED
    0

[[test]]
fn test_chmod_600() -> i32
    var path: String = sandbox_path("chmod", "f600")
    sys_unlink(path.as_ptr())
    assert write_file(path.as_view(), "").is_ok(), "setup: file"

    let args: [2]StrView = ["600", path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./chmod", @args, span_empty<StrView>(), "")
    let perms: i32 = read_perms(path.as_ptr())
    sys_unlink(path.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "chmod 600 should exit 0"
        Err(_) =>
            assert false, "spawn ./chmod"
    assert perms == 0x180, "perms should be 0o600"  # 0o600 = 384 = 0x180
    0

[[test]]
fn test_chmod_644() -> i32
    var path: String = sandbox_path("chmod", "f644")
    sys_unlink(path.as_ptr())
    assert write_file(path.as_view(), "").is_ok(), "setup: file"

    let args: [2]StrView = ["644", path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./chmod", @args, span_empty<StrView>(), "")
    let perms: i32 = read_perms(path.as_ptr())
    sys_unlink(path.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "chmod 644 should exit 0"
        Err(_) =>
            assert false, "spawn ./chmod"
    assert perms == 0x1A4, "perms should be 0o644"  # 0o644 = 420 = 0x1A4
    0
