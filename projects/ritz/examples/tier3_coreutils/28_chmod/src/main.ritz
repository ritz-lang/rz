# chmod - change file mode bits
#
# Usage: chmod [OPTIONS] MODE FILE...
#   Change the mode of FILE(s) to MODE.
#   MODE is an octal number (e.g., 755) or symbolic (e.g., +x).
#
# Options:
#   -v        verbose: output diagnostics for each file
#   -R        change files and directories recursively
#
# Examples:
#   chmod 755 script.sh      # rwxr-xr-x
#   chmod 644 file.txt       # rw-r--r--
#   chmod +x script.sh       # add execute permission
#   chmod -R 755 dir/        # recursive

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn chmod_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)
    return 1

# ============================================================================
# Options
# ============================================================================

struct ChmodOptions
    verbose: i32     # -v
    recursive: i32   # -R
    mode: i32        # target mode
    mode_add: i32    # +x style: bits to add
    mode_remove: i32 # -x style: bits to remove

# ============================================================================
# Helpers
# ============================================================================

fn print_octal(n: i32)
    var buf: [4]u8
    var val: i32 = n
    var i: i32 = 3
    while i >= 0
        buf[i] = ((val % 8) + '0') as u8
        val /= 8
        i -= 1
    sys_write(STDOUT, @buf[0], 4)

# Parse octal mode like "755"
fn parse_octal_mode(s: *u8) -> i32
    var mode: i32 = 0
    var i: i64 = 0
    while *(s + i) != 0
        let c: u8 = *(s + i)
        if c < '0' or c > '7'
            return -1
        mode = mode * 8 + (c - '0') as i32
        i += 1
    return mode

# Parse symbolic mode like "+x", "-w", "=rw"
fn parse_symbolic_mode(s: *u8, opts: *ChmodOptions) -> i32
    let c: u8 = *s
    if c != '+' and c != '-' and c != '='
        return -1

    var bits: i32 = 0
    var i: i64 = 1
    while *(s + i) != 0
        let ch: u8 = *(s + i)
        if ch == 'r'  # 'r'
            bits += 292  # 0444
        else if ch == 'w'  # 'w'
            bits += 146  # 0222
        else if ch == 'x'  # 'x'
            bits += 73   # 0111
        else
            return -1
        i += 1

    if c == '+'  # '+'
        opts.mode_add = bits
    else if c == '-'  # '-'
        opts.mode_remove = bits
    else  # '='
        opts.mode = bits

    return 0

# ============================================================================
# Chmod functions
# ============================================================================

fn chmod_file(path: *u8, opts: *ChmodOptions) -> i32
    var new_mode: i32 = opts.mode

    # Handle symbolic modes
    if opts.mode_add != 0 or opts.mode_remove != 0
        var current: i32 = 0
        match lstat(strview_from_cstr(path))
            Ok(st) => current = st.st_mode % 4096
            Err(_) => return chmod_err2("chmod: cannot access '", path, "'")
        new_mode = current
        new_mode += opts.mode_add
        # Remove bits by ANDing with complement
        # Since we don't have bitwise ops, use arithmetic
        # new_mode = new_mode & ~opts.mode_remove
        # Simplified: just subtract if bit is set
        if opts.mode_remove != 0
            # This is a simplification - proper impl needs bitwise ops
            new_mode = current + opts.mode_add
            # Remove permissions by checking each bit
            if opts.mode_remove / 256 >= 1  # user bits
                new_mode -= (new_mode / 64 % 8) * 64
            if (opts.mode_remove / 8) % 8 >= 1  # group bits
                new_mode -= (new_mode / 8 % 8) * 8
            if opts.mode_remove % 8 >= 1  # other bits
                new_mode -= new_mode % 8

    let result: i32 = sys_chmod(path, new_mode)
    if result != 0
        return chmod_err2("chmod: cannot change permissions of '", path, "'")

    if opts.verbose != 0
        # Mixed text/integer output — bare strings via prints (StrView)
        # rather than the err2 helper since that one's append-only.
        prints("mode of '")
        prints_cstr(path)
        prints("' changed to ")
        print_octal(new_mode)
        prints("\n")

    return 0

fn chmod_recursive(path: *u8, opts: *ChmodOptions) -> i32
    var result: i32 = chmod_file(path, opts)

    if not is_dir(strview_from_cstr(path))
        return result

    var dir: DirIter = match dir_open(strview_from_cstr(path))
        Ok(it) => it
        Err(_) => return 1

    while dir.next()
        let e: DirEntry = dir.entry()
        let name: *u8 = e.name.ptr

        if not streq(name, c".") and not streq(name, c"..")
            var child: String = path_join(strview_from_cstr(path), e.name)

            let r: i32 = chmod_recursive(string_as_ptr(@&child), opts)
            if r != 0
                result = 1

    dir.close()
    return result

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("chmod", "Change file mode bits")
    argspec_switch(@&spec, 'v', "verbose", "Output diagnostics for each file")
    argspec_switch(@&spec, 'R', "recursive", "Change files and directories recursively")
    # One positional run of at least 2: MODE, then one or more FILEs.
    argspec_positionals(@&spec, "MODE FILE...", "Mode and files to change", 2, ARGS_UNLIMITED)
    spec

# "chmod: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn chmod_all(p: @ParsedArgs) -> i32
    var opts: ChmodOptions
    opts.verbose = parsed_switch(p, "verbose") as i32
    opts.recursive = parsed_switch(p, "recursive") as i32
    opts.mode = 0
    opts.mode_add = 0
    opts.mode_remove = 0

    # First positional is MODE (argspec_parse guarantees at least 2)
    let pos = parsed_positionals(p)
    let mode_arg: *u8 = positional_cstr(@pos, 0)

    # Parse MODE - try octal first, then symbolic
    let first_char: u8 = *mode_arg
    if first_char >= '0' and first_char <= '7'
        opts.mode = parse_octal_mode(mode_arg)
        if opts.mode < 0
            eprintln("chmod: invalid mode")
            return 1
    else if first_char == '+' or first_char == '-' or first_char == '='  # '+', '-', '='
        if parse_symbolic_mode(mode_arg, @opts) != 0
            eprintln("chmod: invalid mode")
            return 1
    else
        eprintln("chmod: invalid mode")
        return 1

    # Process FILE arguments (positionals 1 to N)
    var result: i32 = 0
    var i: i64 = 1
    while i < pos.len
        let path: *u8 = positional_cstr(@pos, i)
        if opts.recursive != 0
            let r: i32 = chmod_recursive(path, @opts)
            if r != 0
                result = 1
        else
            let r: i32 = chmod_file(path, @opts)
            if r != 0
                result = 1
        i += 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = chmod_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
