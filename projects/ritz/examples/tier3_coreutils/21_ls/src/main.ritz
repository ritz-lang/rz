# ls - list directory contents
#
# Usage: ls [OPTIONS] [PATH...]
#   List files in PATH (default: current directory)
#
# Options:
#   -l        long listing (permissions, size, date)
#   -a        show hidden files (starting with .)
#   -1        one file per line
#   -h        human-readable sizes (K, M, G)
#   -d        list directories themselves, not contents
#   -F        append indicator (/ for dirs, * for executables)
#
# Examples:
#   ls                # list current directory
#   ls -la            # long listing with hidden files
#   ls -lh /tmp       # human-readable sizes

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.result
import ritzlib.fs
import ritzlib.string
import ritzlib.option
import ritzlib.span
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct LsOptions
    long_list: u8      # -l
    show_all: u8       # -a
    one_per_line: u8   # -1
    human: u8          # -h
    dir_only: u8       # -d
    classify: u8       # -F

# ============================================================================
# ls-specific helpers (not in ritzlib)
# ============================================================================

# Print right-padded number (for column alignment)
fn print_int_width(n: i64, width: i32)
    var buf: [20]u8
    let len: i64 = format_int(n, @buf[0])

    # Pad with spaces
    var spaces: i32 = width - len as i32
    while spaces > 0
        print_char(32)  # space
        spaces -= 1

    sys_write(STDOUT, @buf[0], len)

# Format a number into a buffer, returns length
# Decimal of val into buf (>= 20 bytes); ritzlib.fmt (AGAST #4118).
fn format_int(val: i64, buf: *u8) -> i64
    return fmt_i64_into(buf, val)

# Format human-readable size (K, M, G) with width padding
fn print_size_human_width(size: i64)
    if size < 1024
        print_int_width(size, 4)
        return

    var units: [4]u8
    units[0] = 75   # 'K'
    units[1] = 77   # 'M'
    units[2] = 71   # 'G'
    units[3] = 84   # 'T'

    var s: i64 = size
    var unit: i32 = 0

    # First division takes us to KB
    s /= 1024

    # Keep dividing if still >= 1024
    while s >= 1024 and unit < 3
        s /= 1024
        unit += 1

    print_int_width(s, 3)
    print_char(units[unit])

fn is_executable(mode: i32) -> i32
    # S_IXUSR = 0x40, S_IXGRP = 0x8, S_IXOTH = 0x1
    let exec_bits: i32 = mode % 512  # Lower 9 bits
    # Check if any execute bit is set
    if (exec_bits / 64) % 2 == 1
        return 1  # User execute
    if (exec_bits / 8) % 2 == 1
        return 1  # Group execute
    if exec_bits % 2 == 1
        return 1  # Other execute
    return 0

# Print permission string like "drwxr-xr-x"
fn print_mode(mode: i32)
    var buf: [10]u8

    # File type
    let type_bits: i32 = mode / 4096
    if type_bits == 4
        buf[0] = 100  # 'd'
    else if type_bits == '\n'
        buf[0] = 108  # 'l'
    else if type_bits == 2
        buf[0] = 99   # 'c'
    else if type_bits == 6
        buf[0] = 98   # 'b'
    else
        buf[0] = 45   # '-'

    # User permissions
    let user_bits: i32 = (mode / 64) % 8
    if user_bits / 4 >= 1
        buf[1] = 114  # 'r'
    else
        buf[1] = 45   # '-'
    if (user_bits / 2) % 2 == 1
        buf[2] = 119  # 'w'
    else
        buf[2] = 45   # '-'
    if user_bits % 2 == 1
        buf[3] = 120  # 'x'
    else
        buf[3] = 45   # '-'

    # Group permissions
    let group_bits: i32 = (mode / 8) % 8
    if group_bits / 4 >= 1
        buf[4] = 114  # 'r'
    else
        buf[4] = 45   # '-'
    if (group_bits / 2) % 2 == 1
        buf[5] = 119  # 'w'
    else
        buf[5] = 45   # '-'
    if group_bits % 2 == 1
        buf[6] = 120  # 'x'
    else
        buf[6] = 45   # '-'

    # Other permissions
    let other_bits: i32 = mode % 8
    if other_bits / 4 >= 1
        buf[7] = 114  # 'r'
    else
        buf[7] = 45   # '-'
    if (other_bits / 2) % 2 == 1
        buf[8] = 119  # 'w'
    else
        buf[8] = 45   # '-'
    if other_bits % 2 == 1
        buf[9] = 120  # 'x'
    else
        buf[9] = 45   # '-'

    sys_write(STDOUT, @buf[0], 10)

# ============================================================================
# Entry sorting (simple insertion sort on names)
# ============================================================================

# One stored listing row. Named LsEntry so it does not collide with
# ritzlib.fs's DirEntry, which is what list_directory reads entries as.
struct LsEntry
    name_offset: i64   # Offset into name buffer
    name_len: i64      # Length of name
    d_type: i32        # File type from dirent

struct DirEntries
    entries: *LsEntry
    count: i64
    capacity: i64
    names: *u8          # Name buffer
    names_len: i64
    names_cap: i64

fn sort_entries(entries: *DirEntries)
    # Simple insertion sort
    for i in 1..entries.count
        let entry: LsEntry = *(entries.entries + i)
        let entry_name: *u8 = entries.names + entry.name_offset

        var j: i64 = i - 1
        while j >= 0
            let other: *LsEntry = entries.entries + j
            let other_name: *u8 = entries.names + other.name_offset
            if strcmp(entry_name, other_name) >= 0
                break
            # Shift entry right
            *(entries.entries + j + 1) = *other
            j -= 1

        *(entries.entries + j + 1) = entry

# ============================================================================
# List a single entry
# ============================================================================

# `ls -l` row for an entry we could lstat: mode, links, size, name, suffix.
fn print_long_entry(name: *u8, st: @Stat, opts: *LsOptions)
    print_mode(st.st_mode)
    print_char(32)  # space

    # Link count
    print_int_width(st.st_nlink, 3)
    print_char(32)

    # Size
    if opts.human != 0
        print_size_human_width(st.st_size)
    else
        print_int_width(st.st_size, 8)
    print_char(32)

    # Name
    prints_cstr(name)

    # Classify suffix
    if opts.classify != 0
        if mode_is_dir(st.st_mode)
            print_char(47)  # '/'
        else if is_executable(st.st_mode) != 0
            print_char(42)  # '*'
        else if mode_is_link(st.st_mode)
            print_char(64)  # '@'

# `ls -l` row for an entry whose lstat failed: just the name.
fn print_unstatable_entry(name: *u8)
    prints_cstr(c"?????????? ??? ???????? ")
    prints_cstr(name)

fn list_entry(dir: *u8, name: *u8, d_type: i32, opts: *LsOptions)
    # Skip hidden files unless -a
    if opts.show_all == 0 and *name == '.'  # '.'
        return

    if opts.long_list != 0
        # Build full path for stat
        var path: String = path_join(strview_from_cstr(dir), strview_from_cstr(name))

        # Get file info
        var info: Result<Stat, Errno> = lstat(string_as_view(@path))
        match info
            Ok(st) => print_long_entry(name, @st, opts)
            Err(_) => print_unstatable_entry(name)

        print_char(10)  # newline
    else
        # Simple listing
        prints_cstr(name)

        # Classify suffix if requested
        if opts.classify != 0
            if d_type == 4  # DT_DIR
                print_char(47)  # '/'
            else if d_type == '\n'  # DT_LNK
                print_char(64)  # '@'
            # For executables we'd need stat, skip for simple mode

        if opts.one_per_line != 0
            print_char(10)
        else
            print_char(32)  # space (simple column mode)

# ============================================================================
# List a directory
# ============================================================================

# Copy one directory entry's name into the listing, if there is room.
fn store_entry(entries: *DirEntries, e: @DirEntry)
    let name_len: i64 = e.name.len
    if entries.count >= entries.capacity or entries.names_len + name_len + 1 >= entries.names_cap
        return
    let row: *LsEntry = entries.entries + entries.count
    row.name_offset = entries.names_len
    row.name_len = name_len
    row.d_type = e.kind as i32

    # Copy the name and NUL-terminate it (e.name is a view, not a C string)
    let dst: *u8 = entries.names + entries.names_len
    for i in 0..name_len
        *(dst + i) = *(e.name.ptr + i)
    *(dst + name_len) = 0
    entries.names_len = entries.names_len + name_len + 1
    entries.count = entries.count + 1

fn list_directory(path: *u8, opts: *LsOptions, show_dirname: i32) -> i32
    var dir: DirIter = match dir_open(strview_from_cstr(path))
        Ok(d) => d
        Err(_) =>
            prints_cstr(c"ls: cannot access '")
            prints_cstr(path)
            prints_cstr(c"'\n")
            return 1

    # Show directory name if multiple dirs
    if show_dirname != 0
        prints_cstr(path)
        prints_cstr(c":\n")

    var entries: DirEntries

    # Allocate entry storage (we'll use stack for simplicity, up to 256 entries)
    var entry_storage: [256]LsEntry
    var name_storage: [8192]u8

    entries.entries = @entry_storage[0]
    entries.count = 0
    entries.capacity = 256
    entries.names = @name_storage[0]
    entries.names_len = 0
    entries.names_cap = 8192

    # Read all entries
    while dir_next(@dir)
        let e: DirEntry = dir_entry(@dir)
        store_entry(@entries, @e)

    dir_close(@dir)

    # Sort entries
    sort_entries(@entries)

    # Print entries
    for i in 0..entries.count
        let e: *LsEntry = entries.entries + i
        let name: *u8 = entries.names + e.name_offset
        list_entry(path, name, e.d_type, opts)

    # Add final newline for multi-column mode
    if opts.long_list == 0 and opts.one_per_line == 0 and entries.count > 0
        print_char(10)

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("ls", "List directory contents")
    argspec_switch(@&spec, 'l', "long", "Long listing format")
    argspec_switch(@&spec, 'a', "all", "Show hidden files (starting with .)")
    argspec_switch(@&spec, '1', "one-per-line", "One file per line")
    argspec_switch(@&spec, 'h', "human-readable", "Human-readable sizes (K, M, G)")
    argspec_switch(@&spec, 'd', "directory", "List directories themselves, not contents")
    argspec_switch(@&spec, 'F', "classify", "Append indicator (/ for dirs, * for executables)")
    argspec_positionals(@&spec, "PATH", "Paths to list", 0, ARGS_UNLIMITED)
    spec

# "ls: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = span_get<StrView>(pos, i)
    v.ptr

fn ls(p: @ParsedArgs) -> i32
    var opts: LsOptions
    opts.long_list = parsed_switch(p, "long") as u8
    opts.show_all = parsed_switch(p, "all") as u8
    opts.one_per_line = parsed_switch(p, "one-per-line") as u8
    opts.human = parsed_switch(p, "human-readable") as u8
    opts.dir_only = parsed_switch(p, "directory") as u8
    opts.classify = parsed_switch(p, "classify") as u8

    var result: i32 = 0
    let pos = parsed_positionals(p)
    let num_paths: i64 = pos.len

    if num_paths == 0
        # List current directory
        result = list_directory(c".", @opts, 0)
    else if num_paths == 1
        # Single path
        let path: *u8 = positional_cstr(@pos, 0)

        # Check if it's a file or directory
        if opts.dir_only != 0
            # Just list the name
            println_cstr(path)
        else
            # Try as directory first
            let fd: i32 = sys_open(path, O_DIRECTORY)
            if fd >= 0
                sys_close(fd)
                result = list_directory(path, @opts, 0)
            else
                # Must be a file, just print it
                println_cstr(path)
    else
        # Multiple paths - show each with header
        for i in 0..num_paths
            let path: *u8 = positional_cstr(@pos, i)

            if i > 0
                print_char(10)  # Blank line between

            let r: i32 = list_directory(path, @opts, 1)
            if r != 0
                result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = ls(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
