# Tests for 21_ls — list directory contents.
#
# Helpers (exec_capture, buf_contains, sandbox_path) live in
# ritzlib.testlib; see docs/TESTING.md for the canonical template.

import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_ls_lists_current_dir() -> i32
    let args: [1]StrView = ["."]
    match exec_capture("./ls", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "ls . should exit 0"
            assert c.out.len > 0, "ls . should produce output"
            # cwd contains a 'src' directory (build.py runs from the example dir)
            assert buf_contains(c.output(), "src"), "expected 'src' in output"
        Err(_) =>
            assert false, "spawn ./ls"
    0

[[test]]
fn test_ls_long_listing() -> i32
    let args: [2]StrView = ["-l", "."]
    match exec_capture("./ls", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "ls -l . should exit 0"
            assert buf_contains(c.output(), "drwx"), "expected 'drwx' in -l output"
        Err(_) =>
            assert false, "spawn ./ls"
    0

[[test]]
fn test_ls_one_per_line() -> i32
    let args: [2]StrView = ["-1", "."]
    match exec_capture("./ls", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "ls -1 . should exit 0"
            let out: Span<u8> = c.output()
            var i: i64 = 0
            var nl: i64 = 0
            while i < out.len
                if *(out.ptr + i) == 10
                    nl += 1
                i += 1
            assert nl >= 2, "expected >= 2 lines in -1 output"
        Err(_) =>
            assert false, "spawn ./ls"
    0

[[test]]
fn test_ls_multiple_paths() -> i32
    let args: [2]StrView = [".", ".."]
    match exec_capture("./ls", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 0, "ls . .. should exit 0"
            assert buf_contains(c.output(), "src"), "expected 'src' in output"
        Err(_) =>
            assert false, "spawn ./ls"
    0

[[test]]
fn test_ls_classify_marks_dirs() -> i32
    var path: String = sandbox_path("ls", "F")
    var subdir: String = sandbox_path("ls", "F/sub")

    # Best-effort cleanup of any prior leak.  If the dir has children we
    # won't be able to rmdir it; the mkdir below will fail loudly via the
    # setup assert.  (A future testlib helper for "wipe and recreate"
    # would handle this more gracefully.)
    rmdir(path.as_view())
    if mkdir(path.as_view(), 493).is_err()  # 0o755
        assert 0 == 1, "could not create sandbox"
    mkdir(subdir.as_view(), 493)

    let args: [2]StrView = ["-F", path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./ls", @args, span_empty<StrView>(), "")

    rmdir(subdir.as_view())
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "ls -F <sandbox> should exit 0"
            assert buf_contains(c.output(), "sub/"), "expected 'sub/' in -F output"
        Err(_) =>
            assert false, "spawn ./ls"
    0
