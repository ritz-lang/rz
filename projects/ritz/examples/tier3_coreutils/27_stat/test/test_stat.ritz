# Tests for 27_stat — file info.
import ritzlib.sys
import ritzlib.testlib

[[test]]
fn test_stat_regular_file() -> i32
    var path: [128]u8
    let plen: i64 = make_sandbox_path(@path[0], c"stat", c"f")
    sys_unlink(@path[0])
    if not write_file(@path[0], Span<u8> { ptr: (c"xyz\n"), len: (4) })
        assert 0 == 1, "setup: file"

    var argv: [3]*u8
    argv[0] = c"./stat"
    argv[1] = @path[0]
    argv[2] = null

    var out: [4096]u8
    var n: i64 = 0
    let exit_code: i32 = exec_capture(c"./stat", @argv[0], null, Span<u8> { ptr: (null), len: (0) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @&n)
    sys_unlink(@path[0])

    assert exit_code == 0, "stat <file> should exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"File:"), len: (5) }), "missing 'File:' label"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (@path[0]), len: (plen) }), "missing path"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"Size: 4"), len: (7) }), "missing 'Size: 4'"
    0

[[test]]
fn test_stat_directory() -> i32
    var path: [128]u8
    make_sandbox_path(@path[0], c"stat", c"d")
    sys_rmdir(@path[0])
    if sys_mkdir(@path[0], 493) < 0
        assert 0 == 1, "setup: dir"

    var argv: [3]*u8
    argv[0] = c"./stat"
    argv[1] = @path[0]
    argv[2] = null

    var out: [4096]u8
    var n: i64 = 0
    let exit_code: i32 = exec_capture(c"./stat", @argv[0], null, Span<u8> { ptr: (null), len: (0) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @&n)
    sys_rmdir(@path[0])

    assert exit_code == 0, "stat <dir> should exit 0"
    assert buf_contains(Span<u8> { ptr: (@out[0]), len: (n) }, Span<u8> { ptr: (c"directory"), len: (9) }), "missing 'directory' label"
    0

[[test]]
fn test_stat_missing_errors() -> i32
    var path: [128]u8
    make_sandbox_path(@path[0], c"stat", c"nope")
    sys_unlink(@path[0])

    var argv: [3]*u8
    argv[0] = c"./stat"
    argv[1] = @path[0]
    argv[2] = null

    var out: [4096]u8
    var n: i64 = 0
    let exit_code: i32 = exec_capture(c"./stat", @argv[0], null, Span<u8> { ptr: (null), len: (0) }, Span<u8> { ptr: (@out[0]), len: (4096) }, @&n)

    assert exit_code == 1, "stat of missing file should exit 1"
    0
