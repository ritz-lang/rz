# Tests for 27_stat — file info.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_stat_regular_file() -> i32
    var path: String = sandbox_path("stat", "f")
    unlink(path.as_view())
    assert write_file(path.as_view(), "xyz\n").is_ok(), "setup: file"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./stat", @args, span_empty<StrView>(), "")
    unlink(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "stat <file> should exit 0"
            assert buf_contains(c.output(), "File:"), "missing 'File:' label"
            assert buf_contains(c.output(), span_from_strview(path.as_view())), "missing path"
            assert buf_contains(c.output(), "Size: 4"), "missing 'Size: 4'"
        Err(_) =>
            assert false, "spawn ./stat"
    0

[[test]]
fn test_stat_directory() -> i32
    var path: String = sandbox_path("stat", "d")
    rmdir(path.as_view())
    if mkdir(path.as_view(), 493).is_err()
        assert 0 == 1, "setup: dir"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./stat", @args, span_empty<StrView>(), "")
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "stat <dir> should exit 0"
            assert buf_contains(c.output(), "directory"), "missing 'directory' label"
        Err(_) =>
            assert false, "spawn ./stat"
    0

[[test]]
fn test_stat_missing_errors() -> i32
    var path: String = sandbox_path("stat", "nope")
    unlink(path.as_view())

    let args: [1]StrView = [path.as_view()]
    match exec_capture("./stat", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 1, "stat of missing file should exit 1"
        Err(_) =>
            assert false, "spawn ./stat"
    0
