# stat - display file or file system status
#
# Usage: stat [OPTIONS] FILE...
#   Display detailed information about FILE(s).
#
# Options:
#   -L        follow symlinks (use stat instead of lstat)
#
# Output includes:
#   - File name
#   - Size in bytes
#   - Blocks allocated
#   - File type and mode
#   - Inode number
#   - Links count
#   - UID/GID
#
# Examples:
#   stat file.txt
#   stat -L link

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.result
import ritzlib.fs

# Error helper — see 24_cp.  Most of stat's output is heterogeneous
# format-strings interleaved with integers, printed inline with print();
# only the error path uses the helper.
# "<prefix><path><suffix><reason>": the reason is the failed call's
# errno_message ("No such file or directory", "Permission denied", ...).
fn stat_err2(prefix: StrView, path: StrView, suffix: StrView, reason: StrView) -> i32
    eprint("{prefix}{path}{suffix}{reason}\n")
    return 1
import ritzlib.option
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct StatOptions
    follow_links: i32  # -L

# ============================================================================
# Display helpers
# ============================================================================

fn print_octal(n: i32)
    # Print 4-digit octal
    var buf: [4]u8
    var val: i32 = n
    var i: i32 = 3
    while i >= 0
        buf[i] = ((val % 8) + '0') as u8
        val /= 8
        i -= 1
    prints(StrView { ptr: @buf[0], len: 4 })

fn get_file_type(mode: i32) -> StrView
    let type_bits: i32 = mode / 4096
    if type_bits == 1
        return "FIFO"
    if type_bits == 2
        return "character device"
    if type_bits == 4
        return "directory"
    if type_bits == 6
        return "block device"
    if type_bits == 8
        return "regular file"
    if type_bits == '\n'
        return "symbolic link"
    if type_bits == 12
        return "socket"
    return "unknown"

fn print_mode_string(mode: i32)
    var buf: [10]u8

    let type_bits: i32 = mode / 4096
    if type_bits == 4
        buf[0] = 100  # 'd'
    else if type_bits == '\n'
        buf[0] = 108  # 'l'
    else if type_bits == 2
        buf[0] = 99   # 'c'
    else if type_bits == 6
        buf[0] = 98   # 'b'
    else if type_bits == 1
        buf[0] = 112  # 'p'
    else if type_bits == 12
        buf[0] = 115  # 's'
    else
        buf[0] = 45   # '-'

    let user_bits: i32 = (mode / 64) % 8
    if user_bits / 4 >= 1
        buf[1] = 114  # 'r'
    else
        buf[1] = 45
    if (user_bits / 2) % 2 == 1
        buf[2] = 119  # 'w'
    else
        buf[2] = 45
    if user_bits % 2 == 1
        buf[3] = 120  # 'x'
    else
        buf[3] = 45

    let group_bits: i32 = (mode / 8) % 8
    if group_bits / 4 >= 1
        buf[4] = 114
    else
        buf[4] = 45
    if (group_bits / 2) % 2 == 1
        buf[5] = 119
    else
        buf[5] = 45
    if group_bits % 2 == 1
        buf[6] = 120
    else
        buf[6] = 45

    let other_bits: i32 = mode % 8
    if other_bits / 4 >= 1
        buf[7] = 114
    else
        buf[7] = 45
    if (other_bits / 2) % 2 == 1
        buf[8] = 119
    else
        buf[8] = 45
    if other_bits % 2 == 1
        buf[9] = 120
    else
        buf[9] = 45

    prints(StrView { ptr: @buf[0], len: 10 })

# ============================================================================
# Stat display
# ============================================================================

# Print the status block for `path`, already stat'd into `st`.
fn print_stat(path: StrView, st: @Stat) -> i32
    let mode: i32 = st.st_mode
    print("  File: {path}\n")
    print("  Size: {st.st_size}\t\tBlocks: {st.st_blocks}\t\tIO Block: {st.st_blksize}\t{get_file_type(mode)}\n")
    print("Device: {st.st_dev}\t\tInode: {st.st_ino}\t\tLinks: {st.st_nlink}\n")

    print("Access: (")
    print_octal(mode % 4096)
    print("/")
    print_mode_string(mode)
    print(")\tUid: {st.st_uid}\tGid: {st.st_gid}\n")
    0

fn display_stat(path: StrView, opts: *StatOptions) -> i32
    let p: StrView = path
    var result: Result<Stat, Errno>
    if opts.follow_links != 0
        result = stat(p)
    else
        result = lstat(p)

    match result
        Ok(st) => print_stat(path, @st)
        Err(e) => stat_err2("stat: cannot stat '", path, "': ", e.message())

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("stat", "Display file status")
    spec.switch('L', "dereference", "Follow symlinks")
    spec.positionals("FILE", "File(s) to display status for", 1, ARGS_UNLIMITED)
    spec

# "stat: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn stat_all(p: @ParsedArgs) -> i32
    var opts: StatOptions
    opts.follow_links = p.switch("dereference") as i32

    # Process each file
    var result: i32 = 0
    let pos = p.positionals()
    for i in 0..pos.len
        let path: StrView = pos.get(i)
        let r: i32 = display_stat(path, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = stat_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
