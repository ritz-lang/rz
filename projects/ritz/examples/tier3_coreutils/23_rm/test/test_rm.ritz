# Tests for 23_rm — remove files.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_rm_removes_existing_file() -> i32
    var path: String = sandbox_path("rm", "a")
    unlink(path.as_view())
    assert write_file(path.as_view(), "").is_ok(), "setup: could not create file"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./rm", @args, span_empty<StrView>(), "")

    let exists: bool = path_exists(path.as_view())
    if exists
        unlink(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "rm <existing> should exit 0"
        Err(_) =>
            assert false, "spawn ./rm"
    assert not exists, "file should not exist after rm"
    0

[[test]]
fn test_rm_removes_multiple() -> i32
    var path1: String = sandbox_path("rm", "x")
    var path2: String = sandbox_path("rm", "y")
    var path3: String = sandbox_path("rm", "z")
    unlink(path1.as_view())
    unlink(path2.as_view())
    unlink(path3.as_view())
    assert write_file(path1.as_view(), "").is_ok(), "setup: x"
    assert write_file(path2.as_view(), "").is_ok(), "setup: y"
    assert write_file(path3.as_view(), "").is_ok(), "setup: z"

    let args: [3]StrView = [path1.as_view(), path2.as_view(), path3.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./rm", @args, span_empty<StrView>(), "")

    let exists1: bool = path_exists(path1.as_view())
    let exists2: bool = path_exists(path2.as_view())
    let exists3: bool = path_exists(path3.as_view())
    unlink(path1.as_view())
    unlink(path2.as_view())
    unlink(path3.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "rm of 3 files should exit 0"
        Err(_) =>
            assert false, "spawn ./rm"
    assert not exists1, "x should be gone"
    assert not exists2, "y should be gone"
    assert not exists3, "z should be gone"
    0

[[test]]
fn test_rm_nonexistent_errors() -> i32
    var path: String = sandbox_path("rm", "never")
    unlink(path.as_view())

    let args: [1]StrView = [path.as_view()]
    match exec_capture("./rm", @args, span_empty<StrView>(), "")
        Ok(c) =>
            assert c.status.exit_code == 1, "rm of nonexistent file should exit 1 (no -f)"
        Err(_) =>
            assert false, "spawn ./rm"
    0
