# rm - remove files or directories
#
# Usage: rm [OPTIONS] FILE...
#   Remove FILE(s).
#
# Options:
#   -r, -R    remove directories and their contents recursively
#   -f        ignore nonexistent files, never prompt
#   -d        remove empty directories
#   -v        verbose: print each file as it's removed

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct RmOptions
    recursive: i32   # -r/-R
    force: i32       # -f
    dir: i32         # -d (remove empty directories)
    verbose: i32     # -v

# ============================================================================
# Diagnostic helpers — see 24_cp for the rationale.
#
# Bare-string ("...") arguments are StrViews (length-tagged, no NUL,
# zero-copy); paths from argv are StrViews too.
# Each helper returns 1 (rm's error exit code) so call sites can `return
# rm_err2(...)` directly.
# ============================================================================

fn rm_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

fn rm_print2(prefix: StrView, path: StrView, suffix: StrView)
    print("{prefix}{path}{suffix}\n")

# ============================================================================
# Removal functions
# ============================================================================

fn remove_file(path: StrView, opts: *RmOptions) -> i32
    if unlink(path).is_err()
        if opts.force == 0
            rm_err2("rm: cannot remove '", path, "'")
        return 1

    if opts.verbose != 0
        rm_print2("removed '", path, "'")

    return 0

fn remove_dir_recursive(path: StrView, opts: *RmOptions) -> i32
    var dir: DirIter = match dir_open(path)
        Ok(it) => it
        Err(_) =>
            if opts.force == 0
                rm_err2("rm: cannot open directory '", path, "'")
            return 1

    var result: i32 = 0

    while dir.next()
        let e: DirEntry = dir.entry()

        # Skip . and ..
        if not e.name.eq(".") and not e.name.eq("..")
            var child: String = path_join(path, e.name)
            let child_path: StrView = child.as_view()

            if is_dir(child.as_view())
                let r: i32 = remove_dir_recursive(child_path, opts)
                if r != 0
                    result = 1
            else
                let r: i32 = remove_file(child_path, opts)
                if r != 0
                    result = 1

    dir.close()

    # Now remove the empty directory
    if rmdir(path).is_err()
        if opts.force == 0
            rm_err2("rm: cannot remove directory '", path, "'")
        return 1

    if opts.verbose != 0
        rm_print2("removed directory '", path, "'")

    return result

fn remove_path(path: StrView, opts: *RmOptions) -> i32
    # Check if path exists
    if not path_exists(path)
        if opts.force == 0
            return rm_err2("rm: cannot remove '", path, "': No such file or directory")
        return 0  # -f ignores nonexistent

    # Check if it's a directory
    if is_dir(path)
        if opts.recursive != 0
            return remove_dir_recursive(path, opts)
        else if opts.dir != 0
            # Try to remove empty directory
            if rmdir(path).is_err()
                return rm_err2("rm: cannot remove '", path, "': Is a directory")
            if opts.verbose != 0
                rm_print2("removed directory '", path, "'")
            return 0
        else
            return rm_err2("rm: cannot remove '", path, "': Is a directory")

    return remove_file(path, opts)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("rm", "Remove files or directories")
    spec.switch('r', "recursive", "Remove directories and their contents recursively")
    spec.switch('R', "", "Remove directories and their contents recursively")
    spec.switch('f', "force", "Ignore nonexistent files, never prompt")
    spec.switch('d', "dir", "Remove empty directories")
    spec.switch('v', "verbose", "Print each file as it's removed")
    spec.positionals("FILE", "Files or directories to remove", 1, ARGS_UNLIMITED)
    spec

# "rm: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn rm_all(p: @ParsedArgs) -> i32
    var opts: RmOptions
    opts.recursive = (p.switch("recursive") or p.switch("R")) as i32
    opts.force = p.switch("force") as i32
    opts.dir = p.switch("dir") as i32
    opts.verbose = p.switch("verbose") as i32

    var result: i32 = 0
    let pos = p.positionals()
    for i in 0..pos.len
        let path: StrView = pos.get(i)
        let r: i32 = remove_path(path, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = rm_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
