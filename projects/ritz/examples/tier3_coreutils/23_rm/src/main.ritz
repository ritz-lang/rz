# rm - remove files or directories
#
# Usage: rm [OPTIONS] FILE...
#   Remove FILE(s).
#
# Options:
#   -r, -R    remove directories and their contents recursively
#   -f        ignore nonexistent files, never prompt
#   -d        remove empty directories
#   -v        verbose: print each file as it's removed

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct RmOptions
    recursive: i32   # -r/-R
    force: i32       # -f
    dir: i32         # -d (remove empty directories)
    verbose: i32     # -v

# ============================================================================
# Diagnostic helpers — see 24_cp for the rationale.
#
# Bare-string ("...") arguments are StrViews (length-tagged, no NUL,
# zero-copy).  *u8 is reserved for runtime path data from argv/syscalls.
# Each helper returns 1 (rm's error exit code) so call sites can `return
# rm_err2(...)` directly.
# ============================================================================

fn rm_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)
    return 1

fn rm_print2(prefix: StrView, path: *u8, suffix: StrView)
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    println_string(@s)

# ============================================================================
# Removal functions
# ============================================================================

fn remove_file(path: *u8, opts: *RmOptions) -> i32
    let result: i32 = sys_unlink(path)
    if result != 0
        if opts.force == 0
            rm_err2("rm: cannot remove '", path, "'")
        return result

    if opts.verbose != 0
        rm_print2("removed '", path, "'")

    return 0

fn remove_dir_recursive(path: *u8, opts: *RmOptions) -> i32
    let fd: i32 = sys_open(path, O_DIRECTORY)
    if fd < 0
        if opts.force == 0
            rm_err2("rm: cannot open directory '", path, "'")
        return 1

    var result: i32 = 0
    var buf: [8192]u8

    loop
        let nread: i64 = sys_getdents64(fd, @buf[0], 8192)
        if nread <= 0
            break

        var pos: i64 = 0
        while pos < nread
            let entry: *u8 = @buf[0] + pos
            let reclen: i32 = dirent_get_reclen(entry)
            let name: *u8 = dirent_get_name(entry)

            # Skip . and ..
            if not streq(name, c".") and not streq(name, c"..")
                var child: String = path_join(strview_from_cstr(path), strview_from_cstr(name))
                let child_path: *u8 = string_as_ptr(@&child)

                if is_dir(string_as_view(@child))
                    let r: i32 = remove_dir_recursive(child_path, opts)
                    if r != 0
                        result = 1
                else
                    let r: i32 = remove_file(child_path, opts)
                    if r != 0
                        result = 1

            pos += reclen as i64

    sys_close(fd)

    # Now remove the empty directory
    let r: i32 = sys_rmdir(path)
    if r != 0
        if opts.force == 0
            rm_err2("rm: cannot remove directory '", path, "'")
        return 1

    if opts.verbose != 0
        rm_print2("removed directory '", path, "'")

    return result

fn remove_path(path: *u8, opts: *RmOptions) -> i32
    # Check if path exists
    if not path_exists(strview_from_cstr(path))
        if opts.force == 0
            return rm_err2("rm: cannot remove '", path, "': No such file or directory")
        return 0  # -f ignores nonexistent

    # Check if it's a directory
    if is_dir(strview_from_cstr(path))
        if opts.recursive != 0
            return remove_dir_recursive(path, opts)
        else if opts.dir != 0
            # Try to remove empty directory
            let r: i32 = sys_rmdir(path)
            if r != 0
                return rm_err2("rm: cannot remove '", path, "': Is a directory")
            if opts.verbose != 0
                rm_print2("removed directory '", path, "'")
            return 0
        else
            return rm_err2("rm: cannot remove '", path, "': Is a directory")

    return remove_file(path, opts)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("rm", "Remove files or directories")
    argspec_switch(@&spec, 'r', "recursive", "Remove directories and their contents recursively")
    argspec_switch(@&spec, 'R', "", "Remove directories and their contents recursively")
    argspec_switch(@&spec, 'f', "force", "Ignore nonexistent files, never prompt")
    argspec_switch(@&spec, 'd', "dir", "Remove empty directories")
    argspec_switch(@&spec, 'v', "verbose", "Print each file as it's removed")
    argspec_positionals(@&spec, "FILE", "Files or directories to remove", 1, ARGS_UNLIMITED)
    spec

# "rm: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn rm_all(p: @ParsedArgs) -> i32
    var opts: RmOptions
    opts.recursive = (parsed_switch(p, "recursive") or parsed_switch(p, "R")) as i32
    opts.force = parsed_switch(p, "force") as i32
    opts.dir = parsed_switch(p, "dir") as i32
    opts.verbose = parsed_switch(p, "verbose") as i32

    var result: i32 = 0
    let pos = parsed_positionals(p)
    for i in 0..pos.len
        let path: *u8 = positional_cstr(@pos, i)
        let r: i32 = remove_path(path, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = rm_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
