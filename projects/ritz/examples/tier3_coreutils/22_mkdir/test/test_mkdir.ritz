# Tests for 22_mkdir — create directories.
#
# Helpers (buf_eq, sandbox_path, exec_capture) live in ritzlib.testlib;
# see docs/TESTING.md for the canonical template.

import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_mkdir_creates_directory() -> i32
    var path: String = sandbox_path("mkdir", "one")
    rmdir(path.as_view())  # best-effort prior cleanup

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mkdir", @args, span_empty<StrView>(), "")

    let exists: bool = path_exists(path.as_view())
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "mkdir <new> should exit 0"
        Err(_) =>
            assert false, "spawn ./mkdir"
    assert exists, "directory should exist after mkdir"
    0

[[test]]
fn test_mkdir_existing_dir_errors() -> i32
    var path: String = sandbox_path("mkdir", "exists")
    rmdir(path.as_view())

    if mkdir(path.as_view(), 493).is_err()
        assert 0 == 1, "setup: could not create existing dir"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mkdir", @args, span_empty<StrView>(), "")
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 1, "mkdir of existing dir should exit 1 without -p"
        Err(_) =>
            assert false, "spawn ./mkdir"
    0

[[test]]
fn test_mkdir_creates_sibling() -> i32
    var path: String = sandbox_path("mkdir", "two")
    rmdir(path.as_view())

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./mkdir", @args, span_empty<StrView>(), "")

    let exists: bool = path_exists(path.as_view())
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "mkdir sibling should exit 0"
        Err(_) =>
            assert false, "spawn ./mkdir"
    assert exists, "sibling directory should exist"
    0
