# mkdir - create directories
#
# Usage: mkdir [OPTIONS] DIRECTORY...
#   Create DIRECTORY(ies) if they do not already exist.
#
# Options:
#   -p        create parent directories as needed, no error if existing
#   -m MODE   set file mode (octal, e.g., 755)
#   -v        verbose: print message for each created directory
#
# Examples:
#   mkdir foo             # create 'foo'
#   mkdir -p a/b/c        # create parents as needed
#   mkdir -m 700 private  # create with mode 700

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec
import ritzlib.fmt

# ============================================================================
# Options
# ============================================================================

struct MkdirOptions
    parents: i32    # -p: create parent directories
    mode: i32       # -m: directory mode (default 0755 = 493)
    verbose: i32    # -v: print message for each directory

# ============================================================================
# Diagnostic helpers — see 24_cp.
# ============================================================================

fn mk_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

fn mk_print2(prefix: StrView, path: StrView, suffix: StrView)
    print("{prefix}{path}{suffix}\n")

# ============================================================================
# Helpers
# ============================================================================

# Parse octal mode string like "755" -> 493
fn parse_mode(s: StrView) -> i32
    var mode: i32 = 0
    var i: i64 = 0
    while i < s.len
        let c: u8 = s.get(i)
        if c < '0' or c > 55  # Not '0'-'7'
            return -1
        mode = mode * 8 + (c - '0') as i32
        i += 1
    return mode

# Create the parent `prefix` of a -p path unless it exists (an EEXIST race
# is not an error).
fn make_parent(prefix: StrView, opts: *MkdirOptions) -> i32
    if path_exists(prefix)
        return 0
    match mkdir(prefix, opts.mode)
        Ok(_) => pass
        Err(e) =>
            if e.code() != EEXIST
                return mk_err2("mkdir: cannot create directory '", prefix, "'")
    if opts.verbose != 0
        mk_print2("mkdir: created directory '", prefix, "'")
    return 0

# Create directory `path`, printing it under -v.
fn make_one(path: StrView, opts: *MkdirOptions) -> i32
    if mkdir(path, opts.mode).is_err()
        return mk_err2("mkdir: cannot create directory '", path, "'")
    if opts.verbose != 0
        mk_print2("mkdir: created directory '", path, "'")
    return 0

# Create directory with parents if -p is set
fn make_dir(path: StrView, opts: *MkdirOptions) -> i32
    if opts.parents != 0
        # Walk through path creating each parent (the prefix before a '/')
        for i in 1..path.len
            if path.get(i) == '/'
                if make_parent(StrView { ptr: path.ptr, len: i }, opts) != 0
                    return 1

        # Create final directory
        if not path_exists(path)
            return make_one(path, opts)
        return 0
    # Simple case: just create the directory
    return make_one(path, opts)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("mkdir", "Create directories")
    spec.switch('p', "parents", "create parent directories as needed, no error if existing")
    spec.switch('v', "verbose", "print message for each created directory")
    spec.option('m', "mode", "MODE", "set file mode (octal, e.g., 755)", Some("755"))
    spec.positionals("DIRECTORY", "directories to create", 1, ARGS_UNLIMITED)
    spec

# "mkdir: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn or_empty(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => strview_empty()

fn mkdir_all(p: @ParsedArgs) -> i32
    var opts: MkdirOptions
    opts.parents = p.switch("parents") as i32
    opts.verbose = p.switch("verbose") as i32

    # Parse mode from string to integer (it always has a value: default 755)
    opts.mode = parse_mode(or_empty(p.value("mode")))
    if opts.mode < 0
        eprint("mkdir: invalid mode\n")
        return 1

    # Process each directory
    var result: i32 = 0
    let pos = p.positionals()
    for i in 0..pos.len
        let dir: StrView = pos.get(i)
        let r: i32 = make_dir(dir, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = mkdir_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
