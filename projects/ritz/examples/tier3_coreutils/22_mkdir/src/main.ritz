# mkdir - create directories
#
# Usage: mkdir [OPTIONS] DIRECTORY...
#   Create DIRECTORY(ies) if they do not already exist.
#
# Options:
#   -p        create parent directories as needed, no error if existing
#   -m MODE   set file mode (octal, e.g., 755)
#   -v        verbose: print message for each created directory
#
# Examples:
#   mkdir foo             # create 'foo'
#   mkdir -p a/b/c        # create parents as needed
#   mkdir -m 700 private  # create with mode 700

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct MkdirOptions
    parents: i32    # -p: create parent directories
    mode: i32       # -m: directory mode (default 0755 = 493)
    verbose: i32    # -v: print message for each directory

# ============================================================================
# Diagnostic helpers — see 24_cp.
# ============================================================================

fn mk_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    s.push_cstr(path)
    s.push_str(suffix)
    eprintln_string(@s)
    return 1

fn mk_print2(prefix: StrView, path: *u8, suffix: StrView)
    var s: String = string_from_strview(prefix)
    s.push_cstr(path)
    s.push_str(suffix)
    println_string(@s)

# ============================================================================
# Helpers
# ============================================================================

# Parse octal mode string like "755" -> 493
fn parse_mode(s: StrView) -> i32
    var mode: i32 = 0
    var i: i64 = 0
    while i < s.len
        let c: u8 = s.get(i)
        if c < '0' or c > 55  # Not '0'-'7'
            return -1
        mode = mode * 8 + (c - '0') as i32
        i += 1
    return mode

# Create directory with parents if -p is set
fn make_dir(path: *u8, opts: *MkdirOptions) -> i32
    if opts.parents != 0
        # Need to create parent directories
        var buf: [4096]u8
        strcpy(@buf[0], path)
        let pathlen: i64 = strlen(path)
        let bufptr: *u8 = @buf[0]

        # Walk through path creating directories
        var i: i64 = 0
        while i < pathlen
            if *(bufptr + i) == '/'  # '/'
                if i > 0  # Not leading slash
                    # Temporarily null-terminate here
                    *(bufptr + i) = 0

                    # Create parent if it doesn't exist
                    if not path_exists(strview_from_cstr(bufptr))
                        let result: i32 = sys_mkdir(bufptr, opts.mode)
                        if result != 0 and result != 0 - EEXIST
                            return mk_err2("mkdir: cannot create directory '", bufptr, "'")

                        if opts.verbose != 0
                            mk_print2("mkdir: created directory '", bufptr, "'")

                    # Restore slash
                    *(bufptr + i) = 47
            i += 1

        # Create final directory
        if not path_exists(strview_from_cstr(path))
            let result: i32 = sys_mkdir(path, opts.mode)
            if result != 0
                return mk_err2("mkdir: cannot create directory '", path, "'")

            if opts.verbose != 0
                mk_print2("mkdir: created directory '", path, "'")
    else
        # Simple case: just create the directory
        let result: i32 = sys_mkdir(path, opts.mode)
        if result != 0
            return mk_err2("mkdir: cannot create directory '", path, "'")

        if opts.verbose != 0
            mk_print2("mkdir: created directory '", path, "'")

    return 0

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("mkdir", "Create directories")
    argspec_switch(@&spec, 'p', "parents", "create parent directories as needed, no error if existing")
    argspec_switch(@&spec, 'v', "verbose", "print message for each created directory")
    argspec_option(@&spec, 'm', "mode", "MODE", "set file mode (octal, e.g., 755)", Some("755"))
    argspec_positionals(@&spec, "DIRECTORY", "directories to create", 1, ARGS_UNLIMITED)
    spec

# "mkdir: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = pos.get(i)
    v.ptr

fn or_empty(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => strview_empty()

fn mkdir_all(p: @ParsedArgs) -> i32
    var opts: MkdirOptions
    opts.parents = parsed_switch(p, "parents") as i32
    opts.verbose = parsed_switch(p, "verbose") as i32

    # Parse mode from string to integer (it always has a value: default 755)
    opts.mode = parse_mode(or_empty(parsed_value(p, "mode")))
    if opts.mode < 0
        eprintln("mkdir: invalid mode")
        return 1

    # Process each directory
    var result: i32 = 0
    let pos = parsed_positionals(p)
    for i in 0..pos.len
        let dir: *u8 = positional_cstr(@pos, i)
        let r: i32 = make_dir(dir, @opts)
        if r != 0
            result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = mkdir_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
