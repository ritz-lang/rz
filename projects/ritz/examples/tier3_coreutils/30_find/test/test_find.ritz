# Tests for 30_find — directory traversal.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib

[[test]]
fn test_find_lists_tree() -> i32
    # Build $T/a (file), $T/b (dir), $T/b/c (file), $T/b/d (file)
    var root: String = sandbox_path("find", "tree")
    rmdir(root.as_view())
    if mkdir(root.as_view(), 493).is_err()
        assert 0 == 1, "setup: root"

    var path_a: String = sandbox_path("find", "tree/a")
    var path_b: String = sandbox_path("find", "tree/b")
    var path_c: String = sandbox_path("find", "tree/b/c")
    var path_d: String = sandbox_path("find", "tree/b/d")

    mkdir(path_b.as_view(), 493)
    write_file(path_a.as_view(), "")
    write_file(path_c.as_view(), "")
    write_file(path_d.as_view(), "")

    let args: [1]StrView = [root.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./find", @args, span_empty<StrView>(), "")

    unlink(path_a.as_view())
    unlink(path_c.as_view())
    unlink(path_d.as_view())
    rmdir(path_b.as_view())
    rmdir(root.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "find <tree> should exit 0"
            assert buf_contains(c.output(), span_from_strview(root.as_view())), "missing root in output"
            assert buf_contains(c.output(), span_from_strview(path_a.as_view())), "missing a"
            assert buf_contains(c.output(), span_from_strview(path_b.as_view())), "missing b"
            assert buf_contains(c.output(), span_from_strview(path_c.as_view())), "missing b/c"
            assert buf_contains(c.output(), span_from_strview(path_d.as_view())), "missing b/d"
        Err(_) =>
            assert false, "spawn ./find"
    0

[[test]]
fn test_find_empty_dir() -> i32
    var path: String = sandbox_path("find", "empty")
    rmdir(path.as_view())
    if mkdir(path.as_view(), 493).is_err()
        assert 0 == 1, "setup: empty"

    let args: [1]StrView = [path.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./find", @args, span_empty<StrView>(), "")
    rmdir(path.as_view())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "find <empty> should exit 0"
            assert buf_contains(c.output(), span_from_strview(path.as_view())), "empty-dir find should emit the dir"
        Err(_) =>
            assert false, "spawn ./find"
    0
