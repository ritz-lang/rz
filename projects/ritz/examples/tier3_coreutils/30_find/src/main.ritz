# find - search for files in a directory hierarchy
#
# Usage: find [PATH...] [OPTIONS]
#   Search for files matching criteria.
#
# Options:
#   -name PATTERN   match filename (simple glob: * matches anything)
#   -type TYPE      match file type: f (file), d (directory), l (link)
#   -maxdepth N     descend at most N levels
#
# Examples:
#   find .                     # list all files
#   find . -name "*.txt"       # find .txt files
#   find . -type d             # find directories
#   find /tmp -maxdepth 1      # shallow search

# ============================================================================
# Standard library imports
# ============================================================================

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# Diagnostic helper — see 24_cp.
fn find_warn2(prefix: StrView, path: *u8, suffix: StrView)
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)

# ============================================================================
# Options
# ============================================================================

struct FindOptions
    name_pattern: *u8   # -name
    type_filter: u8     # -type: 'f', 'd', 'l', or 0 for any
    maxdepth: i32       # -maxdepth, -1 for unlimited

# ============================================================================
# Helpers
# ============================================================================

fn parse_int(s: *u8) -> i32
    var val: i32 = 0
    var i: i64 = 0
    while *(s + i) != 0
        let c: u8 = *(s + i)
        if c < '0' or c > '9'
            return val
        val = val * 10 + (c - '0') as i32
        i += 1
    return val

# Simple glob match: * matches any sequence
fn glob_match(pattern: *u8, text: *u8) -> i32
    var pi: i64 = 0
    var ti: i64 = 0
    var star_pi: i64 = -1
    var star_ti: i64 = 0

    while *(text + ti) != 0
        let pc: u8 = *(pattern + pi)
        let tc: u8 = *(text + ti)

        if pc == '*'  # '*'
            star_pi = pi
            star_ti = ti
            pi += 1
        else if pc == tc or pc == '?'  # '?' matches any single char
            pi += 1
            ti += 1
        else if star_pi >= 0
            # Backtrack: try matching more with the star
            pi = star_pi + 1
            star_ti += 1
            ti = star_ti
        else
            return 0

    # Check remaining pattern (only stars allowed)
    while *(pattern + pi) == '*'
        pi += 1

    return (*(pattern + pi) == 0) as i32

fn get_file_type_char(mode: i32) -> u8
    let type_bits: i32 = mode / 4096
    if type_bits == 4
        return 100  # 'd'
    if type_bits == 8
        return 102  # 'f'
    if type_bits == 10
        return 108  # 'l'
    return 0

# ============================================================================
# Find function
# ============================================================================

fn matches_filter(path: *u8, d_type: u8, opts: *FindOptions) -> i32
    # Check type filter
    if opts.type_filter != 0
        var type_char: u8 = 0
        if d_type == DT_DIR
            type_char = 100  # 'd'
        else if d_type == DT_REG
            type_char = 102  # 'f'
        else if d_type == DT_LNK
            type_char = 108  # 'l'
        else if d_type == DT_UNKNOWN  # need to stat
            var statbuf: [144]u8
            if sys_lstat(path, @statbuf[0]) == 0
                type_char = get_file_type_char(stat_get_mode(@statbuf[0]))

        if type_char != opts.type_filter
            return 0

    # Check name pattern
    if opts.name_pattern != null
        # The basename of a C string ends at that string's NUL, so its .ptr
        # is itself a C string.
        let base: StrView = path_basename(strview_from_cstr(path))
        let name: *u8 = base.ptr
        if glob_match(opts.name_pattern, name) == 0
            return 0

    return 1

fn find_path(path: *u8, depth: i32, opts: *FindOptions)
    # Check maxdepth
    if opts.maxdepth >= 0 and depth > opts.maxdepth
        return

    var statbuf: [144]u8
    if sys_lstat(path, @statbuf[0]) != 0
        find_warn2("find: '", path, "': No such file or directory")
        return

    let mode: i32 = stat_get_mode(@statbuf[0])
    let type_bits: i32 = mode / 4096
    var d_type: u8 = 0
    if type_bits == 4
        d_type = DT_DIR
    else if type_bits == 8
        d_type = DT_REG
    else if type_bits == 10
        d_type = DT_LNK

    # Print if matches
    if matches_filter(path, d_type, opts) != 0
        prints_cstr(path)
        print_char(10)

    # Recurse into directories
    if type_bits != 4  # Not a directory
        return

    if opts.maxdepth >= 0 and depth >= opts.maxdepth
        return

    let fd: i32 = sys_open(path, O_DIRECTORY)
    if fd < 0
        return

    var buf: [8192]u8

    loop
        let nread: i64 = sys_getdents64(fd, @buf[0], 8192)
        if nread <= 0
            break

        var pos: i64 = 0
        while pos < nread
            let entry: *u8 = @buf[0] + pos
            let reclen: i32 = dirent_get_reclen(entry)
            let entry_type: u8 = dirent_get_type(entry)
            let name: *u8 = dirent_get_name(entry)

            if not streq(name, c".") and not streq(name, c"..")
                var child: String = path_join(strview_from_cstr(path), strview_from_cstr(name))
                find_path(string_as_ptr(@&child), depth + 1, opts)

            pos += reclen as i64

    sys_close(fd)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("find", "Search for files in a directory hierarchy")
    argspec_option(@&spec, 0, "name", "PATTERN", "Match filename (glob: * matches anything)", None)
    argspec_option(@&spec, 0, "type", "TYPE", "Match file type: f (file), d (directory), l (link)", None)
    argspec_option(@&spec, 0, "maxdepth", "N", "Descend at most N levels", None)
    argspec_positionals(@&spec, "PATH", "Directory to search", 0, ARGS_UNLIMITED)
    spec

# "find: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = span_get<StrView>(pos, i)
    v.ptr

fn or_empty(o: Option<StrView>) -> StrView
    match o
        Some(s) => s
        None => strview_empty()

fn first_byte(s: StrView) -> u8
    if s.len == 0
        return 0
    strview_get(s, 0)

fn set_maxdepth(opts: *FindOptions, n: i64) -> i32
    opts.maxdepth = n as i32
    0

fn find_all(spec: @ArgSpec, p: @ParsedArgs) -> i32
    var opts: FindOptions
    opts.maxdepth = -1  # unlimited by default

    # --name: a value from argv runs to argv's NUL, so .ptr is a C string.
    opts.name_pattern = null
    if parsed_is_set(p, "name")
        let pattern: StrView = or_empty(parsed_value(p, "name"))
        opts.name_pattern = pattern.ptr

    # Type filter: first char of --type, or 0
    opts.type_filter = 0
    if parsed_is_set(p, "type")
        opts.type_filter = first_byte(or_empty(parsed_value(p, "type")))

    # --maxdepth must be a whole number (it used to read garbage as 0)
    if parsed_is_set(p, "maxdepth")
        let depth_status: i32 = match parsed_int(p, "maxdepth")
            Ok(n) => set_maxdepth(@opts, n)
            Err(e) => usage_error(spec, e)
        if depth_status != 0
            return depth_status

    # Process paths
    let pos = parsed_positionals(p)
    if pos.len == 0
        find_path(c".", 0, @opts)
    else
        for i in 0..pos.len
            find_path(positional_cstr(@pos, i), 0, @opts)

    return 0

fn run(spec: @ArgSpec, p: ParsedArgs) -> i32
    var parsed = p
    let status = find_all(spec, @parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(@spec, p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    status
