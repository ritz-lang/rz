# Tests for 24_cp — copy files.
import ritzlib.sys
import ritzlib.fs
import ritzlib.testlib
import ritzlib.result

[[test]]
fn test_cp_empty_file() -> i32
    var src: String = sandbox_path("cp", "empty1")
    var dst: String = sandbox_path("cp", "empty2")
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())
    assert write_file(src.as_view(), "").is_ok(), "setup: empty src"

    let args: [2]StrView = [src.as_view(), dst.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./cp", @args, span_empty<StrView>(), "")

    var st: Stat
    let stat_rc: i32 = sys_stat2(dst.as_ptr(), @&st)
    let dst_size: i64 = st.st_size
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "cp empty should exit 0"
        Err(_) =>
            assert false, "spawn ./cp"
    assert stat_rc == 0, "dst should exist after cp"
    assert dst_size == 0, "dst should be empty"
    0

[[test]]
fn test_cp_copies_content() -> i32
    var src: String = sandbox_path("cp", "src1")
    var dst: String = sandbox_path("cp", "dst1")
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())
    assert write_file(src.as_view(), "hello world\n").is_ok(), "setup: src"

    let args: [2]StrView = [src.as_view(), dst.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./cp", @args, span_empty<StrView>(), "")

    let back: Result<String, Errno> = read_file(dst.as_view())
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "cp content should exit 0"
        Err(_) =>
            assert false, "spawn ./cp"
    match back
        Ok(s) =>
            assert s.len() == 12, "dst should have 12 bytes"
            assert s.eq("hello world\n"), "content mismatch"
        Err(_) =>
            assert false, "read dst"
    0

[[test]]
fn test_cp_overwrites_dest() -> i32
    var src: String = sandbox_path("cp", "src2")
    var dst: String = sandbox_path("cp", "dst2")
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())
    assert write_file(dst.as_view(), "old content\n").is_ok(), "setup: old dst"
    assert write_file(src.as_view(), "new content\n").is_ok(), "setup: new src"

    let args: [2]StrView = [src.as_view(), dst.as_view()]
    let r: Result<Captured, Errno> = exec_capture("./cp", @args, span_empty<StrView>(), "")

    let back: Result<String, Errno> = read_file(dst.as_view())
    sys_unlink(src.as_ptr())
    sys_unlink(dst.as_ptr())

    match r
        Ok(c) =>
            assert c.status.exit_code == 0, "cp overwrite should exit 0"
        Err(_) =>
            assert false, "spawn ./cp"
    match back
        Ok(s) =>
            assert s.len() == 12, "dst should have 12 bytes"
            assert s.eq("new content\n"), "new content not present"
        Err(_) =>
            assert false, "read dst"
    0
