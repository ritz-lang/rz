# cp - copy files and directories
#
# Usage: cp [OPTIONS] SOURCE DEST
#        cp [OPTIONS] SOURCE... DIRECTORY
#
# Options:
#   -r, -R    copy directories recursively
#   -v        verbose: print files as they're copied
#   -p        preserve mode, ownership, timestamps
#   -n        do not overwrite existing files

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct CpOptions
    recursive: i32   # -r/-R
    verbose: i32     # -v
    preserve: i32    # -p
    no_clobber: i32  # -n

# ============================================================================
# Error / verbose helpers
#
# Collapse the prefix-write / path-write / suffix-write triplet into one
# call so error sites read like a single statement of intent.  Building
# the message in a String reduces three write syscalls per error site
# to one.  Returns 1 (cp's error exit code) so call sites can `return
# cp_err2(...)` directly.
#
# Bare string literals (`"..."`) are StrViews — length-tagged, no NUL,
# zero-copy.  This is the idiomatic ritz form; we use it everywhere the
# argument is a build-time-fixed message (vs `*u8` for runtime path data
# that comes from argv/syscalls).
# ============================================================================

fn cp_err2(prefix: StrView, path: *u8, suffix: StrView) -> i32
    var s: String = string_from_strview(prefix)
    string_push_cstr(@&s, path)
    string_push_str(@&s, suffix)
    eprintln_string(@s)
    string_drop(@&s)
    return 1

fn cp_verbose_link(src: *u8, dst: *u8)
    # `'src' -> 'dst'` to stdout — only when -v is set.
    let q: StrView = "'"
    var s: String = string_from_strview(q)
    string_push_cstr(@&s, src)
    string_push_str(@&s, "' -> '")
    string_push_cstr(@&s, dst)
    string_push_str(@&s, "'")
    println_string(@s)
    string_drop(@&s)

# ============================================================================
# Copy functions
# ============================================================================

fn copy_file_data(src_fd: i32, dst_fd: i32) -> i32
    var buf: [8192]u8

    loop
        let nread: i64 = sys_read(src_fd, @buf[0], 8192)
        if nread < 0
            return 1
        if nread == 0
            break

        var written: i64 = 0
        while written < nread
            let n: i64 = sys_write(dst_fd, @buf[0] + written, nread - written)
            if n < 0
                return 1
            written += n

    return 0

fn cp_copy_file(src: *u8, dst: *u8, opts: *CpOptions) -> i32
    # Check if destination exists and -n is set
    if opts.no_clobber != 0 and path_exists(strview_from_cstr(dst))
        return 0  # Silently skip

    # Get source mode for preserve
    var src_mode: i32 = 420  # 0644 default
    if opts.preserve != 0
        var statbuf: [144]u8
        if sys_lstat(src, @statbuf[0]) == 0
            src_mode = stat_get_mode(@statbuf[0]) % 4096  # Lower 12 bits

    # Open source
    let src_fd: i32 = sys_open(src, O_RDONLY)
    if src_fd < 0
        return cp_err2("cp: cannot open '", src, "'")

    # Open destination: O_WRONLY | O_CREAT | O_TRUNC = 577
    let dst_fd: i32 = sys_open3(dst, 577, 420)  # mode 0644
    if dst_fd < 0
        sys_close(src_fd)
        return cp_err2("cp: cannot create '", dst, "'")

    # Copy data
    let result: i32 = copy_file_data(src_fd, dst_fd)

    # Preserve mode
    if opts.preserve != 0 and result == 0
        sys_fchmod(dst_fd, src_mode)

    sys_close(src_fd)
    sys_close(dst_fd)

    if result != 0
        return cp_err2("cp: error copying '", src, "'")

    if opts.verbose != 0
        cp_verbose_link(src, dst)

    return 0

fn copy_dir(src: *u8, dst: *u8, opts: *CpOptions) -> i32
    # Create destination directory
    var src_mode: i32 = 493  # 0755 default
    if opts.preserve != 0
        var statbuf: [144]u8
        if sys_lstat(src, @statbuf[0]) == 0
            src_mode = stat_get_mode(@statbuf[0]) % 4096

    if not path_exists(strview_from_cstr(dst))
        let r: i32 = sys_mkdir(dst, src_mode)
        if r != 0
            return cp_err2("cp: cannot create directory '", dst, "'")

        if opts.verbose != 0
            cp_verbose_link(src, dst)

    # Open source directory
    let fd: i32 = sys_open(src, O_DIRECTORY)
    if fd < 0
        return cp_err2("cp: cannot open directory '", src, "'")

    var result: i32 = 0
    var buf: [8192]u8

    loop
        let nread: i64 = sys_getdents64(fd, @buf[0], 8192)
        if nread <= 0
            break

        var pos: i64 = 0
        while pos < nread
            let entry: *u8 = @buf[0] + pos
            let reclen: i32 = dirent_get_reclen(entry)
            let name: *u8 = dirent_get_name(entry)

            # Skip . and ..
            if streq(name, c".") == 0 and streq(name, c"..") == 0
                var src_child: String = path_join(strview_from_cstr(src), strview_from_cstr(name))
                var dst_child: String = path_join(strview_from_cstr(dst), strview_from_cstr(name))
                let src_path: *u8 = string_as_ptr(@&src_child)
                let dst_path: *u8 = string_as_ptr(@&dst_child)

                if is_dir(string_as_view(@src_child))
                    let r: i32 = copy_dir(src_path, dst_path, opts)
                    if r != 0
                        result = 1
                else
                    let r: i32 = cp_copy_file(src_path, dst_path, opts)
                    if r != 0
                        result = 1
                string_drop(@&src_child)
                string_drop(@&dst_child)

            pos += reclen as i64

    sys_close(fd)
    return result

fn copy_path(src: *u8, dst: *u8, opts: *CpOptions) -> i32
    # Check if source exists
    if not path_exists(strview_from_cstr(src))
        return cp_err2("cp: cannot stat '", src, "': No such file or directory")

    # Check if source is a directory
    if is_dir(strview_from_cstr(src))
        if opts.recursive == 0
            return cp_err2("cp: -r not specified; omitting directory '", src, "'")
        return copy_dir(src, dst, opts)

    return cp_copy_file(src, dst, opts)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("cp", "Copy files and directories")
    argspec_switch(@&spec, 'r', "recursive", "Copy directories recursively")
    argspec_switch(@&spec, 'R', "", "Copy directories recursively (same as -r)")
    argspec_switch(@&spec, 'v', "verbose", "Print files as they're copied")
    argspec_switch(@&spec, 'p', "preserve", "Preserve mode, ownership, timestamps")
    argspec_switch(@&spec, 'n', "no-clobber", "Do not overwrite existing files")
    argspec_positionals(@&spec, "SOURCE... DEST", "Source files/directories and destination", 2, ARGS_UNLIMITED)
    spec

# "cp: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    arg_error_print(spec, @e)
    1

# Positional i as a C string.  A positional is always a whole argv entry, so
# its view ends at argv's NUL and .ptr is a valid C string.
fn positional_cstr(pos: @Span<StrView>, i: i64) -> *u8
    let v: StrView = span_get<StrView>(pos, i)
    v.ptr

fn cp_all(p: @ParsedArgs) -> i32
    var opts: CpOptions
    opts.recursive = (parsed_switch(p, "recursive") or parsed_switch(p, "R")) as i32
    opts.verbose = parsed_switch(p, "verbose") as i32
    opts.preserve = parsed_switch(p, "preserve") as i32
    opts.no_clobber = parsed_switch(p, "no-clobber") as i32

    # Last positional is DEST, all others are SOURCEs.
    let pos = parsed_positionals(p)
    let num_args: i64 = pos.len
    let last_arg: *u8 = positional_cstr(@pos, num_args - 1)
    let dst_is_dir: i32 = is_dir(strview_from_cstr(last_arg)) as i32

    # Multi-source case requires directory destination.
    if num_args > 2 and dst_is_dir == 0
        return cp_err2("cp: target '", last_arg, "' is not a directory")

    var result: i32 = 0

    if num_args == 2
        let src: *u8 = positional_cstr(@pos, 0)
        let dst: *u8 = positional_cstr(@pos, 1)

        if dst_is_dir != 0
            var dst_path: String = path_join(strview_from_cstr(dst), path_basename(strview_from_cstr(src)))
            result = copy_path(src, string_as_ptr(@&dst_path), @opts)
            string_drop(@&dst_path)
        else
            result = copy_path(src, dst, @opts)
    else
        for i in 0..(num_args - 1)
            let src: *u8 = positional_cstr(@pos, i)
            var dst_path: String = path_join(strview_from_cstr(last_arg), path_basename(strview_from_cstr(src)))

            let r: i32 = copy_path(src, string_as_ptr(@&dst_path), @opts)
            string_drop(@&dst_path)
            if r != 0
                result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = cp_all(@parsed)
    parsed_drop(@&parsed)
    status

fn main(argc: i32, argv: **u8) -> i32
    var all = args_from_argv(argc, argv)
    var spec = build_spec()
    let status: i32 = match argspec_parse(@spec, args_tail(@all))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    argspec_drop(@&spec)
    vec_drop<StrView>(@&all)
    status
