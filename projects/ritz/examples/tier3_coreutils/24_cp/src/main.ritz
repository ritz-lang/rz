# cp - copy files and directories
#
# Usage: cp [OPTIONS] SOURCE DEST
#        cp [OPTIONS] SOURCE... DIRECTORY
#
# Options:
#   -r, -R    copy directories recursively
#   -v        verbose: print files as they're copied
#   -p        preserve mode, ownership, timestamps
#   -n        do not overwrite existing files

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.fs
import ritzlib.fd { Fd, fd_open }
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Options
# ============================================================================

struct CpOptions
    recursive: i32   # -r/-R
    verbose: i32     # -v
    preserve: i32    # -p
    no_clobber: i32  # -n

# ============================================================================
# Error / verbose helpers
#
# Collapse the prefix-write / path-write / suffix-write triplet into one
# call so error sites read like a single statement of intent.  Returns 1 (cp's error exit code) so call sites can `return
# cp_err2(...)` directly.
#
# Bare string literals (`"..."`) are StrViews — length-tagged, no NUL,
# zero-copy.  This is the idiomatic ritz form; we use it everywhere the
# argument is a build-time-fixed message; paths from argv are StrViews too.
# ============================================================================

fn cp_err2(prefix: StrView, path: StrView, suffix: StrView) -> i32
    eprint("{prefix}{path}{suffix}\n")
    return 1

fn cp_verbose_link(src: StrView, dst: StrView)
    # `'src' -> 'dst'` to stdout — only when -v is set.
    print("'{src}' -> '{dst}'\n")

# ============================================================================
# Copy functions
# ============================================================================

fn copy_file_data(src_fd: @Fd, dst_fd: @Fd) -> i32
    var buf: [8192]u8

    loop
        let nread: i64 = match src_fd.read(Span<u8> { ptr: @buf[0], len: 8192 })
            Ok(n) => n
            Err(_) => return 1
        if nread == 0
            break

        if dst_fd.write_all(Span<u8> { ptr: @buf[0], len: nread }).is_err()
            return 1

    return 0

fn cp_copy_file(src: StrView, dst: StrView, opts: *CpOptions) -> i32
    # Check if destination exists and -n is set
    if opts.no_clobber != 0 and path_exists(dst)
        return 0  # Silently skip

    # Get source mode for preserve
    var src_mode: i32 = 420  # 0644 default
    if opts.preserve != 0
        match lstat(src)
            Ok(st) => src_mode = st.st_mode % 4096  # Lower 12 bits
            Err(_) => src_mode = 420

    # Open source
    var src_fd: Fd = match fd_open(src, O_RDONLY, 0)
        Ok(f) => f
        Err(_) => return cp_err2("cp: cannot open '", src, "'")

    # Open destination: O_WRONLY | O_CREAT | O_TRUNC
    var dst_fd: Fd = match fd_open(dst, O_WRONLY + O_CREAT + O_TRUNC, 420)  # mode 0644
        Ok(f) => f
        Err(_) =>
            src_fd.close()
            return cp_err2("cp: cannot create '", dst, "'")

    # Copy data
    let result: i32 = copy_file_data(@src_fd, @dst_fd)

    # Preserve mode
    if opts.preserve != 0 and result == 0
        dst_fd.chmod(src_mode)

    src_fd.close()
    dst_fd.close()

    if result != 0
        return cp_err2("cp: error copying '", src, "'")

    if opts.verbose != 0
        cp_verbose_link(src, dst)

    return 0

fn copy_dir(src: StrView, dst: StrView, opts: *CpOptions) -> i32
    # Create destination directory
    var src_mode: i32 = 493  # 0755 default
    if opts.preserve != 0
        match lstat(src)
            Ok(st) => src_mode = st.st_mode % 4096
            Err(_) => src_mode = 493

    if not path_exists(dst)
        if mkdir(dst, src_mode).is_err()
            return cp_err2("cp: cannot create directory '", dst, "'")

        if opts.verbose != 0
            cp_verbose_link(src, dst)

    # Open source directory
    var dir: DirIter = match dir_open(src)
        Ok(it) => it
        Err(_) => return cp_err2("cp: cannot open directory '", src, "'")

    var result: i32 = 0

    while dir.next()
        let e: DirEntry = dir.entry()

        # Skip . and ..
        if not e.name.eq(".") and not e.name.eq("..")
            var src_child: String = path_join(src, e.name)
            var dst_child: String = path_join(dst, e.name)
            let src_path: StrView = src_child.as_view()
            let dst_path: StrView = dst_child.as_view()

            if is_dir(src_child.as_view())
                let r: i32 = copy_dir(src_path, dst_path, opts)
                if r != 0
                    result = 1
            else
                let r: i32 = cp_copy_file(src_path, dst_path, opts)
                if r != 0
                    result = 1

    dir.close()
    return result

fn copy_path(src: StrView, dst: StrView, opts: *CpOptions) -> i32
    # Check if source exists
    if not path_exists(src)
        return cp_err2("cp: cannot stat '", src, "': No such file or directory")

    # Check if source is a directory
    if is_dir(src)
        if opts.recursive == 0
            return cp_err2("cp: -r not specified; omitting directory '", src, "'")
        return copy_dir(src, dst, opts)

    return cp_copy_file(src, dst, opts)

# ============================================================================
# Main
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("cp", "Copy files and directories")
    spec.switch('r', "recursive", "Copy directories recursively")
    spec.switch('R', "", "Copy directories recursively (same as -r)")
    spec.switch('v', "verbose", "Print files as they're copied")
    spec.switch('p', "preserve", "Preserve mode, ownership, timestamps")
    spec.switch('n', "no-clobber", "Do not overwrite existing files")
    spec.positionals("SOURCE... DEST", "Source files/directories and destination", 2, ARGS_UNLIMITED)
    spec

# "cp: <message>" on stderr; exit status 1, as before the argspec port.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn cp_all(p: @ParsedArgs) -> i32
    var opts: CpOptions
    opts.recursive = (p.switch("recursive") or p.switch("R")) as i32
    opts.verbose = p.switch("verbose") as i32
    opts.preserve = p.switch("preserve") as i32
    opts.no_clobber = p.switch("no-clobber") as i32

    # Last positional is DEST, all others are SOURCEs.
    let pos = p.positionals()
    let num_args: i64 = pos.len
    let last_arg: StrView = pos.get(num_args - 1)
    let dst_is_dir: i32 = is_dir(last_arg) as i32

    # Multi-source case requires directory destination.
    if num_args > 2 and dst_is_dir == 0
        return cp_err2("cp: target '", last_arg, "' is not a directory")

    var result: i32 = 0

    if num_args == 2
        let src: StrView = pos.get(0)
        let dst: StrView = pos.get(1)

        if dst_is_dir != 0
            var dst_path: String = path_join(dst, path_basename(src))
            result = copy_path(src, dst_path.as_view(), @opts)
        else
            result = copy_path(src, dst, @opts)
    else
        for i in 0..(num_args - 1)
            let src: StrView = pos.get(i)
            var dst_path: String = path_join(last_arg, path_basename(src))

            let r: i32 = copy_path(src, dst_path.as_view(), @opts)
            if r != 0
                result = 1

    return result

fn run(p: ParsedArgs) -> i32
    var parsed = p
    let status = cp_all(@parsed)
    parsed.deinit()
    status

pub fn main(args: Span<StrView>) -> i32
    var spec = build_spec()
    let status: i32 = match spec.parse(args.from(1))
        Ok(p) => run(p)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status
