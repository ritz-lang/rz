# ritz1.grammar - Grammar for the ritz1 self-hosted compiler
#
# This grammar generates AST-building parsers that create the AST
# structures defined in ritz1/src/ast.ritz.
#
# Semantic actions use $N to reference matched symbols:
#   $1.line, $1.col - Token source location
#   $1.start, $1.len - Token text
#   $1 for non-terminals returns the parsed AST node

%tokens

# Keywords
FN          = "fn"
# AGAST #1456: parsed; async_lower.ritz lowers them (#3814).
ASYNC       = "async"
AWAIT       = "await"
# AGAST #3934: `heap e`, as ritz0's (tokens.py, parser.parse_prefix).
HEAP        = "heap"
PUB         = "pub"
EXTERN      = "extern"
LET         = "let"
VAR         = "var"
RETURN      = "return"
IF          = "if"
ELSE        = "else"
WHILE       = "while"
BREAK       = "break"
CONTINUE    = "continue"
CONST       = "const"
STRUCT      = "struct"
IMPORT      = "import"
AS          = "as"
NIL         = "nil"
IMPL        = "impl"
FOR         = "for"
TRAIT       = "trait"
MUT         = "mut"
NULL        = "null"
ENUM        = "enum"
MATCH       = "match"
DEFER       = "defer"
LOOP        = "loop"
UNSAFE      = "unsafe"
TRUE        = "true"
FALSE       = "false"
SELF        = "self"
IN          = "in"
AND         = "and"
OR          = "or"
NOT         = "not"
ASSERT      = "assert"
TYPE        = "type"
# Inline if-expression `if c then a else b` (LANGUAGE_SPEC §7.5, AGAST #1753).
# Token ID 47 (HAND_WRITTEN_TOKEN_IDS in tools/ritzgen_py/ritz_generator.py).
THEN        = "then"
# Inline assembly (LANGUAGE_SPEC §18.6, AGAST #3394).  Token ID 48.
ASM         = "asm"

# Type keywords
I8          = "i8"
I16         = "i16"
I32         = "i32"
I64         = "i64"
U8          = "u8"
U16         = "u16"
U32         = "u32"
U64         = "u64"
BOOL        = "bool"

# Multi-character operators
ARROW       = "->"
FAT_ARROW   = "=>"
EQ          = "=="
NE          = "!="
LE          = "<="
GE          = ">="
SHL         = "<<"
SHR         = ">>"
ANDAND      = "&&"
OROR        = "||"
PLUS_EQ     = "+="
MINUS_EQ    = "-="
STAR_EQ     = "*="
SLASH_EQ    = "/="
# Wrapping arithmetic and its op= forms (LARB R63, AGAST #3486).  One token
# each, longest match: `+%` is not `+` then `%` (which is no prefix operator).
PLUSPCT     = "+%"
MINUSPCT    = "-%"
STARPCT     = "*%"
PLUSPCT_EQ  = "+%="
MINUSPCT_EQ = "-%="
STARPCT_EQ  = "*%="
# Inclusive range `a..=b` (AGAST #1530). Listed before DOTDOT; longest match wins.
DOTDOTEQ    = "..="
DOTDOT      = ".."
LBRACKET2   = "[["
# `name:& T`'s borrow sigil, one token as ritz0 lexes it (AGAST #1565).  With
# a space, `name: &T` is COLON then AMP: the removed legacy `&T` type, which
# no rule accepts (parser_report_dropped_item words ritz0's diagnostic).
COLON_AMP   = ":&"
# `name:= T`'s move sigil, one token as ritz0 lexes it (AGAST #3911).  With a
# space, `name: = T` is COLON then ASSIGN, where no rule takes an `=`
# (parser_report_dropped_item words ritz0's "Expected type name").
COLON_EQ    = ":="
# Note: ]] is parsed as two RBRACKET tokens, not RBRACKET2, matching ritz0 behavior

# Single-character operators
PLUS        = "+"
MINUS       = "-"
STAR        = "*"
SLASH       = "/"
PERCENT     = "%"
AMP         = "&"
PIPE        = "|"
CARET       = "^"
TILDE       = "~"
BANG        = "!"
AT          = "@"
LT          = "<"
GT          = ">"
ASSIGN      = "="
DOT         = "."
QUESTION    = "?"

# Delimiters
LPAREN      = "("
RPAREN      = ")"
LBRACKET    = "["
RBRACKET    = "]"
LBRACE      = "{"
RBRACE      = "}"
COMMA       = ","
COLON       = ":"
SEMICOLON   = ";"

# Identifiers and literals
# NUMBER is just the digit core — typed-int suffixes (`42i32`, `100u16`,
# `0usize`, `0xFFi64`) are absorbed by the lexer's TOK_NUMBER post-match
# hook (see lexer.ritz, AGAST #107) so the suffix lives inside the
# token's `len` without complicating the regex.  parse_int (ast_helpers)
# stops at the first non-digit char, so the suffix is naturally ignored.
# No `$`: a monomorph's internal `W$i32_bump` can't be written (spec §2.5,
# LARB R37); lexer.ritz refuses a `$` outside an asm body (AGAST #3373).
IDENT      = /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER      = /0x[0-9a-fA-F]+|0b[01]+|[0-9]+/
# Float literal: at least one digit + dot + at least one digit, an exponent
# `[eE][+-]?[0-9]+`, or both (`2.0e10`, `1e-5`, AGAST #3929), optional
# `f32`/`f64` suffix.  No leading dot (`.5`) or trailing dot (`5.`) — both
# are syntactically ambiguous with method-call dispatch and range
# expressions.  The regex captures the bare number only; the
# suffix is absorbed by the lexer's TOK_FLOAT post-match hook (lexer.ritz,
# AGAST #1615) and expr_float (ast_helpers) casts the literal to it.
FLOAT       = /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+/
STRING      = /"([^"\\]|\\.)*"/
CHAR        = /'([^'\\]|\\.|\\x[^'\n]*)'/
CSTRING     = /c"([^"\\]|\\.)*"/
# One line of an asm block's body, as text (AGAST #3394).  No pattern: the
# lexer makes it in asm body mode (lexer.ritz lexer_asm_text).
ASM_LINE    = ""

%skip
WHITESPACE  = /[ \t\r]+/

%tokens
COMMENT     = /#[^\n]*/
NEWLINE     = /\n/

# =============================================================================
# Recovery directives
# =============================================================================
# When all alternatives of a rule fail, scan forward until an anchor token
# is found, then return "progress" so the enclosing star/plus loop
# continues instead of silently dropping every subsequent item.
# Without this, a single malformed item used to drop the rest of the file.

%recovery
item = FN ASYNC PUB IMPL STRUCT CONST IMPORT EXTERN ENUM TRAIT ;

# =============================================================================
# Grammar rules with AST construction
# =============================================================================

%grammar

# Module is the top-level AST node
# Note: module_init creates p.module FIRST, then item* can add to it
#
# module_end is NOT decoration.  `item*` stops at the first item it cannot
# parse and, on its own, that failure is indistinguishable from "no more
# items" — the parser would return a module missing every item from the
# failure point on, and the driver would happily emit IR for it (AGAST
# #1301: functions silently vanished, surfacing as undefined symbols at
# link time, or as a wrong binary with no error at all).  module_end
# asserts the token stream was actually consumed to EOF and raises a hard,
# located parse error otherwise.
module -> *Module
    : module_init item* module_end { p.module }
    ;

module_init -> *Module
    : { module_new(p) }
    ;

# Assert item* consumed everything; hard-fail with file:line:col otherwise.
module_end -> i32
    : { module_require_eof(p) }
    ;

# Attributes: [[name = "value"]] or [[name]] (LANGUAGE_SPEC §17).
# A closed set (AGAST #1847): attr_flag / attr_kv honour each one or report
# a located error; nothing is skipped.  `[[target_os = "..."]]` filters the
# item, `[[test]]` marks a test fn (§17.1, #1908), `[[packed]]` packs a
# struct, `[[inline]]`-family attributes reach the fn's LLVM attributes.
attrs -> i32
    : attr attrs { 0 }
    | { 0 }
    ;

# One bracket pair holds a comma list, `[[packed, target_os = "linux"]]`,
# meaning the same as one pair per entry; a trailing comma is allowed, as in
# ritz0's parse_attrs (AGAST #1919).  Each entry's action runs as soon as the
# entry matches, so an error is located at the entry's own name.
attr -> i32
    : LBRACKET2 attr_entry attr_list_tail RBRACKET RBRACKET NEWLINE { 0 }
    ;

attr_list_tail -> i32
    : COMMA attr_entry attr_list_tail { 0 }
    | COMMA { 0 }
    | { 0 }
    ;

# The `name = "value"` form first: a bare IDENT would match its prefix.
attr_entry -> i32
    : IDENT ASSIGN STRING
      { attr_kv(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, StrView { ptr: ($3.string_val), len: ($3.string_len) as i64 }) }
    | IDENT
      { attr_flag(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    ;

item
    : attrs fn_def { item_dispatch_fn(p, $2) }
    | attrs extern_fn_def { item_dispatch_fn(p, $2) }
    | attrs struct_def { item_dispatch_struct(p, $2) }
    | attrs const_def { item_dispatch_const(p, $2) }
    | attrs global_var_def { item_dispatch_global(p, $2) }
    | attrs enum_def { item_dispatch_enum(p) }
    | attrs type_alias_def { item_dispatch_alias(p) }
    | import_stmt { module_add_import(p.module, $1) }
    | impl_block { module_add_impl(p.module, $1) }
    # An item's value is its progress signal: 0 would end `item*` here.
    | trait_def { 1 }
    ;

# Trait declaration (consume-and-skip, AGAST #1611; its name is recorded,
# #4211, so an impl of an undeclared trait is refused).  Traits are structural
# (LANGUAGE_SPEC §12.2): an `impl Trait for Type` block's methods are emitted
# as ordinary `Type_method` fns and calls resolve statically from the
# receiver's concrete type, so the declaration contributes nothing to
# codegen.  It must still parse, or `item*` stops at it and module_end
# rejects the file.  Signatures reuse `params` / `return_type` so every
# receiver form an impl method accepts (`self`, `self:&`, `self: *Self`)
# is accepted here too.  The return-type state a signature records is
# harmless: every fn_def rewrites it from its own return_type.
trait_def -> i32
    : TRAIT IDENT NEWLINE INDENT trait_method_sigs DEDENT { trait_declared_record(p.ctx, StrView { ptr: ($2.start), len: ($2.len) as i64 }) }
    | PUB TRAIT IDENT NEWLINE INDENT trait_method_sigs DEDENT { trait_declared_record(p.ctx, StrView { ptr: ($3.start), len: ($3.len) as i64 }) }
    ;

trait_method_sigs -> i32
    : trait_method_sig trait_method_sigs { 0 }
    | trait_method_sig { 0 }
    ;

trait_method_sig -> i32
    : FN IDENT LPAREN params? RPAREN return_type? NEWLINE { 0 }
    # Already a signature: `= extern` is a located error, not a parse stop.
    | FN IDENT LPAREN params? RPAREN return_type? ASSIGN EXTERN NEWLINE
      { trait_decl_refused(p.ctx, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $1.line, $1.col) }
    ;

# Type alias: `type Name = T` / `pub type Name = T` (AGAST #1475).
# Transparent, as in ritz0: the alias IS its target.  type_alias_record
# snapshots the parse state type_spec left behind (kind, struct name,
# pointee, array/ref info) under the alias name, and type_named substitutes
# that snapshot wherever the name is later used as a type, so the emitter
# never sees an alias.  Aliases declared after their use, or in a module
# parsed after its importer, are handled by the driver re-parsing once the
# table is populated (see main.ritz).  Honours [[target_os]] skipping.
type_alias_def -> *TypeRef
    : TYPE IDENT ASSIGN alias_type_spec NEWLINE
      { type_alias_record(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4) }
    | PUB TYPE IDENT ASSIGN alias_type_spec NEWLINE
      { type_alias_record(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5) }
    ;

# AGAST #1879: latch a fn type's signature where the type ends (the record
# action runs after NEWLINE, where fresh_fn_sig no longer hands it out).
alias_type_spec -> *TypeRef
    : type_spec { alias_type_latch(p, $1) }
    ;

# Enum declaration.  ritz1's AST has no enum node: the enum is recorded in the
# parser's enum tracker (ast_helpers.ritz) instead — names, variants and, since
# AGAST #1797, each variant's payload fields, from which the emitter derives
# ritz0's `{ i8, [pad x i8], [N x i8] }` layout (emitter_core user_enum_layout).
# Enum: header captures the enum name into a per-enum tracker BEFORE variants
# are parsed, so each enum_variant rule can record (name, index) into that
# enum's variant table.  The qualified-enum-variant test (Shade.Light /
# Shade.Dark) needs this lookup at codegen time to translate the ExprKind.Member
# into the variant's tag value.
# `pub` is latched at the end (enum_def_end): `E.from`, generated for an
# enum with a representation type (LANGUAGE_SPEC §10.4), is `pub` iff it is.
enum_def -> i32
    : ENUM enum_def_header NEWLINE INDENT enum_variants DEDENT
      { enum_def_end(p, 0) }
    | PUB ENUM enum_def_header NEWLINE INDENT enum_variants DEDENT
      { enum_def_end(p, 1) }
    ;

# Longest alternative FIRST: alternatives are tried in order and the caller
# does not backtrack into this rule, so a leading bare `IDENT` alternative
# would match `Option` in `enum Option<T>`, leave `<` unconsumed and sink
# the whole enum_def.  That is how ritzlib's `enum Option<T>` / `enum
# Result<T, E>` came to be dropped (silently, until AGAST #1301).
#
# `enum E: u64` names a representation type (LANGUAGE_SPEC §10.4, AGAST
# #1880); enum_def_start_repr rejects a non-integer one, located at `E`.
enum_def_header -> i32
    : IDENT generic_params { enum_def_start_generic(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $2) }
    | IDENT COLON type_spec { enum_def_start_repr(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | IDENT { enum_def_start(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    ;

enum_variants -> i32
    : enum_variant enum_variants { 0 }
    | enum_variant { 0 }
    ;

# Struct-style variant (AGAST #1543): an indented block of `name: type`
# fields, reusing the struct field rule.  Listed before the bare `IDENT
# NEWLINE` form, which is its prefix: tried second, the bare form would match
# `Navigate NEWLINE`, leave the INDENT behind and sink the whole enum_def.
# Every form records the variant in declaration order, so it keeps its tag
# index, along with its payload fields (AGAST #1797): they size the enum.
#
# `Read = 0` / `Fault = -14`: an explicit discriminant (LANGUAGE_SPEC §10.4).
# Every form records its variant's discriminant and checks it, located at
# the variant's name (enum_variant_check).
enum_variant -> i32
    : IDENT NEWLINE INDENT struct_fields DEDENT { enum_variant_record_struct(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $4, $1.line, $1.col) }
    | IDENT NEWLINE { enum_variant_record(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    # `Rect(i64, i64)`: two or more payload types (AGAST #1295).  Each is a
    # variant_type, whose action captures that type's detail as it is parsed.
    | IDENT LPAREN variant_type COMMA variant_types RPAREN NEWLINE { enum_variant_record_tuple_n(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, field_link($3, $5), $1.line, $1.col) }
    | IDENT LPAREN type_spec RPAREN NEWLINE { enum_variant_record_tuple(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | IDENT ASSIGN NUMBER NEWLINE { enum_variant_record_discr(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, StrView { ptr: ($3.start), len: ($3.len) as i64 }, 0, $1.line, $1.col) }
    | IDENT ASSIGN MINUS NUMBER NEWLINE { enum_variant_record_discr(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, StrView { ptr: ($4.start), len: ($4.len) as i64 }, 1, $1.line, $1.col) }
    ;

# AGAST #1295: the payload types after the first of a multi-field tuple
# variant, `i64, u8` of `V(i32, i64, u8)`.
variant_types -> *StructField
    : variant_type COMMA variant_types { field_link($1, $3) }
    | variant_type { $1 }
    ;

variant_type -> *StructField
    : type_spec { variant_type_field(p, $1) }
    ;

# Function definition (with optional generic params)
# Supports both "fn name" and "pub fn name"; fn_pub marks the latter, so
# another file may call it (AGAST #3419, LARB R45a).
fn_def -> *FnDef
    : FN name generic_params? LPAREN params? RPAREN return_type? block
      { generic_fn_def_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $3, $5, $7, $8, $1.line, $1.col) }
    | PUB FN name generic_params? LPAREN params? RPAREN return_type? block
      { fn_pub(generic_fn_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $4, $6, $8, $9, $1.line, $1.col)) }
    # AGAST #1456: `[pub] async fn` sets FnDef.is_async; async_lower.ritz
    # lowers it to ritz0's state machine (AGAST #3814).
    | ASYNC FN name generic_params? LPAREN params? RPAREN return_type? block
      { fn_async(p, generic_fn_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $4, $6, $8, $9, $1.line, $1.col), $1.col) }
    | PUB ASYNC FN name generic_params? LPAREN params? RPAREN return_type? block
      { fn_async(p, fn_pub(generic_fn_def_new(p, StrView { ptr: ($4.start), len: ($4.len) as i64 }, $5, $7, $9, $10, $1.line, $1.col)), $1.col) }
    # Declaration only (LANGUAGE_SPEC §5.3, AGAST #1900): the body lives in
    # another object.  Last, so a definition never parses its header twice.
    # decl_fn_def_new refuses generics; impl_block_new methods of generic
    # impls; item_dispatch_fn `[[test]]`.
    | FN name generic_params? LPAREN params? RPAREN return_type? ASSIGN EXTERN NEWLINE
      { decl_fn_def_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $3, $5, $7, $1.line, $1.col) }
    | PUB FN name generic_params? LPAREN params? RPAREN return_type? ASSIGN EXTERN NEWLINE
      { fn_pub(decl_fn_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $4, $6, $8, $1.line, $1.col)) }
    ;

# Extern function declaration (no body)
extern_fn_def -> *FnDef
    : EXTERN FN IDENT LPAREN params? RPAREN return_type? NEWLINE
      { extern_fn_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $7, $1.line, $1.col) }
    ;

# A trailing comma is allowed (`fn f(a: i64, b: i64,)`), matching ritz0 —
# the one-param-per-line style in ritzlib/testlib.ritz needs it (AGAST #1452).
params -> *Param
    : param COMMA params { param_link($1, $3) }
    | param COMMA { $1 }
    | param { $1 }
    ;

param -> *Param
    # `self` receivers.  `self` lexes as SELF, not IDENT, so these are
    # separate alternatives.  A typed `self: T` builds exactly the Param that
    # `IDENT COLON type_spec` builds for any other name: a FREE fn's `self`
    # has no impl block, so it needs the annotated type to lower `self.field`
    # (AGAST #1375).  Without these alternatives, `fn scale(self:
    # @Point, ...)` failed to parse and the whole impl method was dropped
    # (silent recovery), so call sites saw only an extern
    # `declare i64 @T_method(...)` and never a real definition.
    : SELF COLON type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    # `self:& T` and bare `self:&` are mutable-borrow receivers (COLON_AMP,
    # never the spaced `self: &T`: AGAST #1565).  `self:& T` gets the same
    # TypeKind.MutRef as `name:& T` below.  Bare `self:&` and bare `self` have no
    # type, so they record the impl-receiver placeholder, and impl_block_new
    # gives a bare `self` the impl's type: it's `self: T` (AGAST #2393).  Without
    # these alternatives the whole impl block failed to parse (AGAST #1522:
    # 68 angelo methods, plus prism and lexis).  param_self_borrow keeps
    # `self:& T` apart from `self: @&T`, whose `@self` is a `**T` (AGAST #2286).
    | SELF COLON_AMP type_spec { param_self_borrow(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_mut_ref(p, $3), $1.line, $1.col) }
    | SELF COLON_AMP { param_self_lent(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    # `self:= T` moves the receiver in: the same Param as `self: T`, as
    # `name:= T` below is `name: T` (AGAST #3249).  Without it the whole impl
    # failed to parse ("unexpected '='").  COLON_EQ, never the spaced
    # `self: = T` (AGAST #3911).
    | SELF COLON_EQ type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | SELF { param_self(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    # `name:& T` — mutable-borrow parameter (COLON_AMP; the spaced `name: &T`
    # is the legacy `&T` type, AGAST #1565).  The type is the same TypeKind.MutRef that `@&T`
    # produces, so it lowers identically.  Listed before the plain
    # `IDENT COLON type_spec` alternative, though the two are disjoint.  Missing this alternative is why ritzlib's strview_split_once was
    # silently dropped from every ritz1 build (AGAST #1301).  param_borrow
    # marks it: ritz0 auto-dereferences a scalar `x:& i64` (`x = x + n`),
    # which `@&i64` does not (AGAST #1644).
    # AGAST #4122: `p:& *[N][M]T`, the borrowed pointer recording its shape.
    | IDENT COLON_AMP STAR type_spec { param_borrow(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_mut_ref(p, type_ptr_nd(p, $4)), $1.line, $1.col) }
    | IDENT COLON_AMP type_spec { param_borrow(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_mut_ref(p, $3), $1.line, $1.col) }
    # `name:= T` — move parameter (COLON_EQ; the spaced `name: = T` is
    # refused, AGAST #3911).  ritz0 treats its Borrow.MOVE exactly
    # as a by-value `name: T` (only the symbol table records it), and per
    # LANGUAGE_SPEC §13.2 a by-value parameter of a move-only type already
    # takes ownership, so this builds the same Param as `name: T`.  Without
    # it angelo's `fn add_contour(self:& GlyphOutline, contour:= Contour)`
    # and `fn load_font_data(data:= Vec<u8>)` failed to parse (AGAST #1527).
    | IDENT COLON_EQ type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    # AGAST #2098: `name: *[N][M]T`.  Only the sites that record its shape take
    # an N-D pointee (type_ptr_nd): here, var_type / var_nd_type, ptr_nd_type and
    # cast_type (#3635, #4122); every other `*` refuses one.
    # AGAST #3930: `*mut T` (LANGUAGE_SPEC §5) is `*T`, as in ritz0, here and
    # at every other `STAR type_spec`.
    | IDENT COLON STAR MUT type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_ptr_nd(p, $5), $1.line, $1.col) }
    # AGAST #3635: and `name: **[N][M]T`, whose `*name` is the `*[N][M]T`.
    # Before `STAR type_spec`, whose type_spec would take the inner `*`.
    | IDENT COLON STAR STAR type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_ptr_nd(p, type_ptr_nd(p, $5)), $1.line, $1.col) }
    | IDENT COLON STAR type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_ptr_nd(p, $4), $1.line, $1.col) }
    # AGAST #4122: and `name: @*[N][M]T` / `name: @&*[N][M]T`, whose `*name` is one.
    | IDENT COLON AT AMP STAR type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_mut_ref(p, type_ptr_nd(p, $6)), $1.line, $1.col) }
    | IDENT COLON AT STAR type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_ref(p, type_ptr_nd(p, $5)), $1.line, $1.col) }
    | IDENT COLON type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    ;

return_type -> *TypeRef
    : ARROW ptr_nd_type { capture_fn_return_type(p, $2) }   # AGAST #3635
    | ARROW type_spec { capture_fn_return_type(p, $2) }
    ;

# AGAST #3635: `*T` / `*mut T` where an N-D T `[N][M]..T` is lowered
# (type_ptr_nd): a field, a global and a return type record its shape
# (ptr_array_of_last).  Tried before type_spec at each of those sites.
ptr_nd_type -> *TypeRef
    : STAR MUT type_spec { type_ptr_nd(p, $3) }
    # AGAST #4122: and `**[N][M]T`, whose `*x` is the `*[N][M]T`.  Before
    # `STAR type_spec`, whose type_spec would take the inner `*`.
    | STAR STAR type_spec { type_ptr_nd(p, type_ptr_nd(p, $3)) }
    | STAR type_spec { type_ptr_nd(p, $2) }
    ;

# Struct definition (with optional generic params)
struct_def -> *StructDef
    : STRUCT IDENT generic_params? NEWLINE INDENT struct_fields DEDENT
      { generic_struct_def_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $3, $6, $1.line, $1.col) }
    | PUB STRUCT IDENT generic_params? NEWLINE INDENT struct_fields DEDENT
      { generic_struct_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $4, $7, $1.line, $1.col) }
    # Field-less struct (AGAST #2955): `pub struct CommandBuilder` with no
    # block, a namespace for an impl's static methods.  ritz0 accepts it and
    # lays it out as `{}`.  Listed after the bodied forms, whose prefix it
    # is: tried first, it would match `struct S NEWLINE`, leave the INDENT
    # behind and sink the next item.  For the same reason it refuses when an
    # INDENT follows (AGAST #3271): a body whose field failed to parse would
    # otherwise leave the struct "field-less" and the body a stray item.
    | STRUCT IDENT generic_params? NEWLINE
      { fieldless_struct_def_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $3, $1.line, $1.col) }
    | PUB STRUCT IDENT generic_params? NEWLINE
      { fieldless_struct_def_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $4, $1.line, $1.col) }
    ;

struct_fields -> *StructField
    : struct_field struct_fields { field_link($1, $2) }
    | { 0 as *StructField }
    ;

struct_field -> *StructField
    # `name:& T`: mutable-borrow field (COLON_AMP, which ritz0 wraps in a
    # mutable RefType; the spaced `name: &T` is refused, AGAST #1565).  This
    # mirrors `param`'s borrow alternative and lowers to the same TypeKind.MutRef
    # as `@&T`.  Disjoint from the plain form, so order does not matter.  Struct-style enum variants reuse
    # struct_fields (#1543) and pick this up too.  Missing it broke tempest
    # lib/tab_renderer.ritz (AGAST #1598).
    : name COLON_AMP type_spec NEWLINE
      { field_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, type_mut_ref(p, $3), $1.line, $1.col) }
    | name COLON ptr_nd_type NEWLINE   # AGAST #3635: `p: *[N][M]T`
      { field_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | name COLON type_spec NEWLINE
      { field_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    ;

# Const definition
const_def -> *ConstEntry
    : CONST IDENT COLON type_spec ASSIGN expr NEWLINE
      { const_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col) }
    | PUB CONST IDENT COLON type_spec ASSIGN expr NEWLINE
      { const_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $7, $1.line, $1.col) }
    ;

# Import statement
#
# Supports four shapes:
#   import path
#   import path as IDENT
#   import path { item, item, ... }
#   import path { item, item, ... } as IDENT
#
# The lexer suppresses NEWLINE/INDENT/DEDENT inside `{ ... }` (bracket_depth
# guard), so multiline forms collapse to a flat IDENT/COMMA stream and
# re-use the same rule.
#
# The selective list doesn't filter: the whole module is imported either
# way, as in ritz0.  It is checked (LARB R54, AGAST #3467): each name must be
# one the module defines, else an error at the name (import_vis.ritz's
# vis_selective_check).  So import_items keeps each name and where it is.
#
# `pub import` (re-export, LANGUAGE_SPEC §15.4, AGAST #1523): the importer of
# this module also sees the imported module's pub items.  ritz1, like ritz0,
# already makes every import's names visible transitively, so the PUB arm
# only needs to parse; without it `pub import` sank the whole module
# ("cannot parse item starting at 'pub'", e.g. 25 angelo modules).
import_stmt -> *ImportDecl
    : IMPORT module_path import_filter? import_alias? NEWLINE { import_new(p, $2, $3) }
    | PUB IMPORT module_path import_filter? import_alias? NEWLINE { import_new_pub(p, $3, $4) }
    ;

import_filter -> *ImportItem
    : LBRACE import_items RBRACE { $2 }
    | LBRACE RBRACE { 0 as *ImportItem }
    ;

import_items -> *ImportItem
    : IDENT COMMA import_items { import_item_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, $3) }
    | IDENT COMMA { import_item_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, 0 as *ImportItem) }
    | IDENT { import_item_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, 0 as *ImportItem) }
    ;

import_alias -> i32
    : AS IDENT { 0 }
    ;

# Global variable definition (module-level var)
#
# `pub var` (AGAST #1508): ritz1 checks no global's visibility (a fn's is
# checked at a call, #3419).  Every global is already exported: each module
# that sees it emits it `weak_odr` (external linkage) and the linker merges
# those into one storage, so importer and declarer share it, as `pub fn` /
# `fn` share linkage until #3386.  The PUB arms only
# accept the syntax; without them `pub var` sank the whole module ("cannot
# parse item starting at 'pub'", e.g. rzsh/common.ritz).
global_var_def -> *GlobalVarDef
    # `extern var NAME: T` (LANGUAGE_SPEC §5.3, AGAST #1879): defined in
    # another object.  An initializer is a located error, not a parse stop.
    : EXTERN VAR IDENT COLON extern_var_type NEWLINE
      { extern_var_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $1.line, $1.col) }
    | EXTERN VAR IDENT COLON extern_var_type ASSIGN expr NEWLINE
      { extern_var_init_refused(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $1.line, $1.col) }
    | PUB EXTERN VAR IDENT COLON extern_var_type NEWLINE
      { extern_var_new(p, StrView { ptr: ($4.start), len: ($4.len) as i64 }, $6, $1.line, $1.col) }
    | VAR IDENT COLON global_var_type ASSIGN expr NEWLINE
      { global_var_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col) }
    | VAR IDENT COLON global_var_type NEWLINE
      { global_var_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, 0 as *Expr, $1.line, $1.col) }
    | PUB VAR IDENT COLON global_var_type ASSIGN expr NEWLINE
      { global_var_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $7, $1.line, $1.col) }
    | PUB VAR IDENT COLON global_var_type NEWLINE
      { global_var_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, 0 as *Expr, $1.line, $1.col) }
    # `var g = true` (LARB R38, spec §4.3, #3375): a global's type is written,
    # never read off its initializer.  Parsed only to refuse it, located at
    # the `=`, in ritz0's words; it used to stop as "unexpected '='".
    | VAR IDENT ASSIGN expr NEWLINE
      { global_var_untyped_refused(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $3.line, $3.col, $1.line, $1.col) }
    | PUB VAR IDENT ASSIGN expr NEWLINE
      { global_var_untyped_refused(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $4.line, $4.col, $1.line, $1.col) }
    ;

# AGAST #3635: a global's type, `*[N][M]T` included (ptr_nd_type).
global_type -> *TypeRef
    : ptr_nd_type { $1 }
    | type_spec { $1 }
    ;

# AGAST #4324: a global's type, latching the fn signature it ends on
# (capture_global_fn_sig) before the initializer is parsed.  global_var_new
# runs after the initializer, too late for fresh_fn_sig.  Both wrappers run
# immediately after their type rule, while p.pos is still the token it ended
# on.  extern_var_type keeps the extern forms' narrower type_spec.
extern_var_type -> *TypeRef
    : type_spec { capture_global_fn_sig(p, $1) }
    ;

global_var_type -> *TypeRef
    : global_type { capture_global_fn_sig(p, $1) }
    ;

module_path -> *ImportPath
    : IDENT DOT module_path { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | IDENT { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, 0 as *ImportPath) }
    # `ritzlib.async.tasks`: a keyword is a path segment, as in ritz0 (#1456).
    | ASYNC DOT module_path { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | ASYNC { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, 0 as *ImportPath) }
    | AWAIT DOT module_path { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | AWAIT { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, 0 as *ImportPath) }
    # `import ritzlib.heap`, `import mm.heap` (AGAST #3934).
    | HEAP DOT module_path { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | HEAP { path_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, 0 as *ImportPath) }
    ;

# Type specification.  #4035: the parser builds a recursive `*TypeRef`; the
# pointer / array / reference chain is its `pointee` / `elem`, not a flat kind
# plus parser side channels.
type_spec -> *TypeRef
    : I8 { type_prim(p, TypeKind.I8) }
    | I16 { type_prim(p, TypeKind.I16) }
    | I32 { type_prim(p, TypeKind.I32) }
    | I64 { type_prim(p, TypeKind.I64) }
    | U8 { type_prim(p, TypeKind.U8) }
    | U16 { type_prim(p, TypeKind.U16) }
    | U32 { type_prim(p, TypeKind.U32) }
    | U64 { type_prim(p, TypeKind.U64) }
    | BOOL { type_prim(p, TypeKind.Bool) }
    | STAR MUT type_spec { type_ptr(p, $3) }   # AGAST #3930
    | STAR type_spec { type_ptr(p, $2) }
    | LBRACKET NUMBER RBRACKET type_spec { type_array(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4) }
    # `[N]i32`, `[N * 2]u8` (AGAST #2153): any constant integer expression
    # over consts already declared in this file, folded here by
    # const_fold_int.  Tried after the NUMBER form, so `[3]i32` is unchanged.
    | LBRACKET expr RBRACKET type_spec { type_array_expr(p, $2, $1.line, $1.col, $4) }
    # `[T]`, the slice type (AGAST #1614 / #1529): sugar for `Span<T>`
    # (LANGUAGE_SPEC §3.4), built exactly as `Span<T>` is (ritz0's
    # make_slice_type).  Tried after both `[N]T` forms: an unsized `[u8]` has no
    # type after its `]`, so neither of them matches it.
    | LBRACKET first_generic_type_arg RBRACKET { type_slice(p, $2) }
    | AT AMP type_spec { type_mut_ref(p, $3) }
    | AT type_spec { type_ref(p, $2) }
    # Function-pointer field types: `handler: fn(*Task) -> i32`.  Function
    # pointers in LLVM are plain `ptr` (opaque), so we lower to TypeKind.Ptr
    # and consume the inner signature for syntax acceptance only.  Without
    # this alternative, structs containing fn-typed fields (Task,
    # TaskServer, ...) fail to parse and silently drop out of the AST,
    # leaving downstream references opaque.  ritz-task-169.
    #
    # AGAST #1671: the signature is no longer discarded.  type_fn records it
    # (params + return type) in p.last_fn_sig, so a call through a
    # `pred: fn(u8) -> bool` value is emitted `call i1 %f(i8 ...)` to match
    # the callee's definition rather than `call i64 %f(i64 ...)`.
    # AGAST #3690: the `fn` token locates the type (a refused call through it).
    | FN LPAREN fn_ptr_params RPAREN ARROW type_spec { type_fn(p, $3, $6, $1.line, $1.col) }
    | FN LPAREN fn_ptr_params RPAREN { type_fn(p, $3, type_void(p), $1.line, $1.col) }
    | FN LPAREN RPAREN ARROW type_spec { type_fn(p, 0 as *Param, $5, $1.line, $1.col) }
    | FN LPAREN RPAREN { type_fn(p, 0 as *Param, type_void(p), $1.line, $1.col) }
    # The unit type `()` (AGAST #2272), as in `Result<(), E>`.  It has no
    # value, so it is TypeKind.Void; as a generic argument it spells "unit", as
    # ritz0's mangle_type_name spells an empty TupleType.
    | LPAREN RPAREN { type_void(p) }
    # A tuple type `(A, B, ...)` (AGAST #2956), two or more elements: a
    # struct type_tuple synthesizes once per spelling, named as ritz0's
    # mangle_type_name spells a TupleType ("tuple_u32_u32") and laid out as
    # ritz0's `{A, B}`.  Disjoint from `()` above, which has no element.
    | LPAREN tuple_type_elems RPAREN { type_tuple(p, $2) }
    # Generic: EVERY type arg drives name mangling (AGAST #1574) —
    # `Pair<i64, i32>` mangles to "Pair$i64$i32", `Result<Vec<u8>, StrView>`
    # to "Result$Vec$u8$StrView".  Each arg's last_type_name is captured
    # right after it parses, before later args clobber it.
    # generic_args consumes the closing `>` too — or, for `Vec<Vec<i64>>`,
    # lets a nested argument's `>>` close this list (AGAST #1300).
    # `dyn Trait` (AGAST #2298): ritz1 has no trait objects, and whether the
    # language does is AGAST #1620's call.  Refused at the `dyn`, once, and
    # parsed as the bare trait name so the rest of the item still parses;
    # g_attr_errors fails the compile.  Before the IDENT forms, which would
    # read `dyn` as a type name and leave the trait name over.
    | dyn_kw type_spec { $2 }
    | IDENT LT generic_args { type_generic_with_saved(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | IDENT { type_named(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    ;

# The `dyn` of `dyn Trait` (AGAST #2298).  `dyn` is no keyword in ritz1's
# lexer, so this matches an IDENT and fails unless its text is `dyn`.
dyn_kw -> i32
    : IDENT { dyn_kw_refuse(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    ;

# A tuple type's elements (AGAST #2956): one or more, with one optional
# trailing comma.  Each element is captured by tuple_type_elem with its
# type_spec's *TypeRef (AGAST #4035: no parse state left to clobber).
# A one-element tuple must keep its comma — `(i32,)` (AGAST #4459) — because
# `(i32)` is a parenthesized type, not a tuple; the two-element arm is tried
# first so `(i32, i64)` is never mistaken for `(i32,)` plus a stray `i64`.
# A tuple ends in `)`, never `>>`, so type_spec_shr needs no tuple form.
tuple_type_elems -> *TupleElem
    : tuple_type_elem COMMA tuple_type_elem tuple_type_more { tuple_elem_link($1, tuple_elem_link($3, $4)) }
    | tuple_type_elem COMMA { $1 }
    ;

tuple_type_more -> *TupleElem
    : COMMA tuple_type_elem tuple_type_more { tuple_elem_link($2, $3) }
    | COMMA { 0 as *TupleElem }
    | { 0 as *TupleElem }
    ;

tuple_type_elem -> *TupleElem
    : type_spec { tuple_elem_new(p, $1) }
    ;

# -----------------------------------------------------------------------------
# Nested generics closing with `>>` (AGAST #1300, ritz0 parity with #1299)
#
# The lexer emits `>>` as ONE token (SHR), so `Vec<Vec<i64>>` ends in SHR,
# never GT GT.  Rather than split the token (which would need parser state
# that survives backtracking), the grammar lets an SHR close TWO type-argument
# lists at once:
#
#   type_spec_shr   a generic type whose closing token is SHR: the first `>`
#                   closes its own list, the second closes the ENCLOSING list.
#   generic_args    a type-argument list plus whatever closes it: a GT, or a
#                   last argument that is a type_spec_shr (which closed it).
#
# A prefixed argument (`*T`, `@T`, `@&T`, `[N]T`) whose generic ends the
# list is a type_spec_shr too: `Vec<*Vec<i32>>` (AGAST #2943).
#
# `A<B<C<D<i64>>>>` lexes as A < B < C < D < i64 SHR SHR: D is a
# type_spec_shr closing C; C<...> is complete; B is a type_spec_shr closing
# A.  One SHR supplies at most two closers, so no deeper family is needed.
#
# Expression context never reaches these rules through SHR: `a >> b` and
# `a < b >> c` still parse via shift_tail's SHR, because type_spec_shr
# requires `IDENT LT` before the SHR and every caller requires a following
# token (`(`, `{`, or the enclosing list's closer) that a shift does not have.
# -----------------------------------------------------------------------------

# Type-argument list after `<`, INCLUDING its closer.  Returns the list of
# captured arguments, in order (every arg drives name mangling, #1574).
generic_args -> *GenericArg
    : first_generic_type_arg type_arg_tail GT { link_generic_arg($1, $2) }
    | first_generic_type_arg_shr { $1 }
    | first_generic_type_arg type_arg_tail_shr { link_generic_arg($1, $2) }
    ;

# A generic type closed by SHR; the second `>` belongs to the enclosing list.
# The prefixed forms mirror type_spec's: `Vec<*Vec<i32>>` ends in a pointer
# to a generic, so `*Vec<i32>>` is itself SHR-closed (AGAST #2943).  Each
# wraps the inner type exactly as its type_spec alternative does.  `[N]`
# needs no NUMBER form: type_array_expr folds a literal length to the same
# type type_array builds.
type_spec_shr -> *TypeRef
    : IDENT LT first_generic_type_arg type_arg_tail SHR { type_generic_with_saved(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, link_generic_arg($3, $4)) }
    | STAR MUT type_spec_shr { type_ptr(p, $3) }   # AGAST #3930
    | STAR type_spec_shr { type_ptr(p, $2) }
    | LBRACKET expr RBRACKET type_spec_shr { type_array_expr(p, $2, $1.line, $1.col, $4) }
    | AT AMP type_spec_shr { type_mut_ref(p, $3) }
    | AT type_spec_shr { type_ref(p, $2) }
    ;

# Capture-wrapper: parse a type_spec and snapshot its type code and
# last_type_name into a heap record, so subsequent type_arg_tail parsing
# (which may itself contain generics) doesn't lose the first generic
# argument's mangled name.  A heap record rather than a single global slot
# keeps this reentrant for `HashMap<String, Vec<Connection>>`.
first_generic_type_arg -> *GenericArg
    : type_arg_start type_spec { capture_generic_arg_at(p, $2, $1) }
    ;

first_generic_type_arg_shr -> *GenericArg
    : type_arg_start type_spec_shr { capture_generic_arg_at(p, $2, $1) }
    ;

# Zero-width: the token index the type argument starts at, so a failed trait
# bound is located at it (AGAST #3469).
type_arg_start -> i32
    : { generic_arg_mark(p) }
    ;

# Extra args whose LAST one is a type_spec_shr: that SHR closed the list.
# Each arg goes through a capture rule so its name is snapshotted before the
# next arg parses (#1574).
type_arg_tail_shr -> *GenericArg
    : COMMA first_generic_type_arg type_arg_tail_shr { link_generic_arg($2, $3) }
    | COMMA first_generic_type_arg_shr { $2 }
    ;

# Optional comma-separated extra type args after the first, as captured
# records (null when there are none): `Result<T, E>`, `HashMap<K, V>`.
type_arg_tail -> *GenericArg
    : COMMA first_generic_type_arg type_arg_tail { link_generic_arg($2, $3) }
    | { 0 as *GenericArg }
    ;

# Comma-separated param list for function-pointer signatures.  Each param
# is a bare type (`fn(*Task) -> i32`, ritz-task-169) or a named one
# (`fn(node_id: NodeId, offset: Point)`, AGAST #1544); the forms may mix.
# The fn pointer itself lowers to TypeKind.Ptr; the params are kept as a Param
# list for its signature (AGAST #1671).  Each param is built by fn_ptr_param
# right after its type_spec, while last_type_name / pointee state is fresh
# (a later param would clobber it).
# The named alternative comes FIRST: a bare IDENT type (`fn(Point)`) would
# otherwise be consumed by type_spec and leave `: T` unparseable.  When no
# COLON follows the IDENT, the named alternative fails with no side effects
# and the bare one re-parses it as a type.
fn_ptr_params -> *Param
    : fn_ptr_param COMMA fn_ptr_params { param_link($1, $3) }
    | fn_ptr_param { $1 }
    ;

fn_ptr_param -> *Param
    : IDENT COLON type_spec { param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | type_spec { param_new(p, StrView { ptr: (0 as *u8), len: (0) as i64 }, $1, 0, 0) }
    ;

# Type name - matches type keywords and identifiers (for generic call parsing)
# Returns the token so we can extract the type name string
type_name -> Token
    : I8 { $1 }
    | I16 { $1 }
    | I32 { $1 }
    | I64 { $1 }
    | U8 { $1 }
    | U16 { $1 }
    | U32 { $1 }
    | U64 { $1 }
    | BOOL { $1 }
    | IDENT { $1 }
    ;

# Statement block
block -> *Stmt
    : NEWLINE INDENT stmts DEDENT { $3 }
    | stmt { $1 }
    ;

stmts -> *Stmt
    : stmt stmts { stmt_link($1, $2) }
    | { 0 as *Stmt }
    ;

stmt -> *Stmt
    : let_stmt
    | var_stmt
    | return_stmt
    | if_stmt
    | match_stmt
    | assert_stmt
    | control_stmt
    | assign_stmt
    | defer_stmt
    | unsafe_stmt
    | asm_stmt
    | expr_stmt
    ;

# Inline assembly (LANGUAGE_SPEC §18.6, LARB R50, AGAST #3394):
#   asm ARCH (clause, ...)?:
#       <lines of text>
# The lexer hands each body line over whole, as one ASM_LINE (lexer.ritz
# asm body mode), so `$`, `%` and `(%rax)` survive.  stmt_asm checks
# everything that needs no types; lowering is AGAST #3395.
asm_stmt -> *Stmt
    : ASM IDENT asm_clauses COLON NEWLINE INDENT asm_lines DEDENT
      { stmt_asm(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, $3, $7, $1.line, $1.col) }
    | ASM IDENT COLON NEWLINE INDENT asm_lines DEDENT
      { stmt_asm(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, 0 as *AsmOperand, $6, $1.line, $1.col) }
    ;

asm_clauses -> *AsmOperand
    : LPAREN asm_clause_list RPAREN { $2 }
    ;

asm_clause_list -> *AsmOperand
    : asm_clause COMMA asm_clause_list { asm_operand_link($1, $3) }
    | asm_clause { $1 }
    ;

# `in` is a keyword; `out`, `inout` and `clobber` are not, so they come as an
# IDENT and asm_clause_new reads the word.  `clobber REG` is `IDENT IDENT`.
asm_clause -> *AsmOperand
    : IN IDENT COLON IDENT
      { asm_clause_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, StrView { ptr: ($4.start), len: ($4.len) as i64 }, $4.line, $4.col) }
    | IN IDENT
      { asm_clause_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, StrView { ptr: (null), len: (0) as i64 }, 0, 0) }
    | IDENT IDENT COLON IDENT
      { asm_clause_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, StrView { ptr: ($4.start), len: ($4.len) as i64 }, $4.line, $4.col) }
    | IDENT IDENT
      { asm_clause_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col, StrView { ptr: (null), len: (0) as i64 }, 0, 0) }
    ;

asm_lines -> *AsmLine
    : asm_line asm_lines { asm_line_link($1, $2) }
    | asm_line { $1 }
    ;

# The last line of a file may have no NEWLINE.
asm_line -> *AsmLine
    : ASM_LINE NEWLINE { asm_line_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | ASM_LINE { asm_line_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    ;

# `unsafe` + a block (AGAST #2248), as ritz0's parse_unsafe.  ritz1 enforces nothing inside it, so it lowers as a plain
# nested block: see StmtKind.Unsafe.
unsafe_stmt -> *Stmt
    : UNSAFE block { stmt_unsafe(p, $2, $1.line, $1.col) }
    ;

# `defer <stmt>` or `defer` + an indented block (LANGUAGE_SPEC §13.7, LARB
# R14, AGAST #1625).  The statement runs at each exit of the innermost
# enclosing block; see own_defer (ownership.ritz).  A bare `defer` parses
# with a null body so the emitter can refuse it at the `defer`, as it
# refuses a deferred `let` / `return` / `break` (own_defer_refusal).
defer_stmt -> *Stmt
    : DEFER NEWLINE INDENT stmts DEDENT { stmt_defer(p, $4, 1, $1.line, $1.col) }
    | DEFER NEWLINE { stmt_defer(p, 0 as *Stmt, 0, $1.line, $1.col) }
    | DEFER stmt { stmt_defer(p, $2, 0, $1.line, $1.col) }
    ;

# `assert <cond>` and `assert <cond>, "message"`.  Lowers to a runtime
# check via StmtKind.Assert — see emit_assert_stmt (emitter_print.ritz), which
# prints the message and, for `a OP b`, both operands (AGAST #1869).
assert_stmt -> *Stmt
    : ASSERT expr NEWLINE { stmt_assert(p, $2, StrView { ptr: (null), len: (0) as i64 }, $1.line, $1.col) }
    | ASSERT expr COMMA STRING NEWLINE { stmt_assert(p, $2, StrView { ptr: ($4.string_val), len: ($4.string_len) as i64 }, $1.line, $1.col) }
    # The message is a "..." (StrView) literal only: a c"..." message is C in
    # Ritz clothing (AGAST #3794).  Parsed only to refuse it at the literal,
    # in ritz0's wording, rather than fail the whole item as a parse error.
    | ASSERT expr COMMA CSTRING NEWLINE { assert_cstring_message_refused(p, $2, $4.line, $4.col, $1.line, $1.col) }
    ;

# Control flow statements (while, for, loop, break, continue)
control_stmt -> *Stmt
    : while_stmt
    | for_stmt
    | loop_stmt
    | break_stmt
    | continue_stmt
    ;

# Name bound by `let` / `var`.  `self` lexes as SELF, not IDENT, but ritz0
# accepts it as an ordinary binding name (63_executor binds
# `let self: *SimpleFuture = ...`).  Reads need nothing extra: primary_expr
# already turns SELF into an ExprKind.Ident (AGAST #1632).
binding_name -> Token
    : IDENT { $1 }
    | SELF { $1 }
    ;

# A name `self` may take as well as an IDENT: a fn's, a struct field's (its
# declaration, a literal's init, a `.member`) and a `for` variable's.
# LANGUAGE_SPEC §2: `self` is not a keyword.  It still lexes as SELF, so the
# receiver forms stay param's separate alternatives (AGAST #3331).
name -> Token
    : IDENT { $1 }
    | SELF { $1 }
    ;

let_stmt -> *Stmt
    # stmt_let_decl marks the binding immutable (AGAST #2028, let_check.ritz).
    # Tuple-destructure: `let (x, y, ...) = expr` — see stmt_tuple_decl.
    # Names after the second are tuple_bind_more's (AGAST #109).  A match /
    # if block init ends in DEDENT, as below (AGAST #2594).
    : LET LPAREN IDENT COMMA IDENT tuple_bind_more RPAREN ASSIGN match_expr_rhs
      { stmt_tuple_more(stmt_named2(stmt_named(stmt_tuple_decl(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $9, $1.line, $1.col, $2.line, $2.col), $3.line, $3.col), $5.line, $5.col), $6) }
    | LET LPAREN IDENT COMMA IDENT tuple_bind_more RPAREN ASSIGN if_expr_rhs
      { stmt_tuple_more(stmt_named2(stmt_named(stmt_tuple_decl(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $9, $1.line, $1.col, $2.line, $2.col), $3.line, $3.col), $5.line, $5.col), $6) }
    | LET LPAREN IDENT COMMA IDENT tuple_bind_more RPAREN ASSIGN expr NEWLINE
      { stmt_tuple_more(stmt_named2(stmt_named(stmt_tuple_decl(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $9, $1.line, $1.col, $2.line, $2.col), $3.line, $3.col), $5.line, $5.col), $6) }
    # Match-expression RHS forms — match_expr ends in DEDENT, not NEWLINE,
    # so the trailing NEWLINE in the regular forms cannot match.  These
    # alternatives must come first so they win the start_pos race.
    | LET binding_name COLON var_type ASSIGN match_expr_rhs
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | LET binding_name ASSIGN match_expr_rhs
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    # If-expression RHS (#1613) — ends in DEDENT for the same reason.
    | LET binding_name COLON var_type ASSIGN if_expr_rhs
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | LET binding_name ASSIGN if_expr_rhs
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    | LET binding_name COLON var_type ASSIGN expr NEWLINE
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | LET binding_name ASSIGN expr NEWLINE
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    # AGAST #4543: the value expression ends in an else-less block `if`, whose
    # DEDENT replaces the NEWLINE.  Parser success; Sema refuses at that `if`.
    | LET binding_name COLON var_type ASSIGN expr open_if_ended
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | LET binding_name ASSIGN expr open_if_ended
      { stmt_named(stmt_let_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    ;

# A tuple destructure's names after its second (AGAST #109), `, c, d` of
# `let (a, b, c, d) = e`; none for the two-name form.
tuple_bind_more -> *TupleName
    : COMMA IDENT tuple_bind_more { tuple_name_link(tuple_name_new(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $2.line, $2.col), $3) }
    | { 0 as *TupleName }
    ;

# Match-expression RHS — used in let/var bindings.  The match block ends
# in DEDENT (no NEWLINE) so this rule absorbs it as a self-contained form.
match_expr_rhs -> *Expr
    : MATCH expr NEWLINE INDENT match_arms DEDENT
      { expr_match(p, $2, $5, $1.line, $1.col) }
    ;

# If-expression RHS (AGAST #1613) — used in let/var bindings and `return`:
#     let n: i32 = if c
#         1
#     else
#         0
# The else block ends in DEDENT (or, for `else if`, in the nested if_stmt's
# DEDENT), never in a NEWLINE of its own, so like match_expr_rhs it needs its
# own alternatives rather than `expr NEWLINE`.  `else` is mandatory: an `if`
# with no `else` has no value (LANGUAGE_SPEC §6.1), so it does not parse here.
# A trailing nested if/else in either block is that block's value; see
# expr_if / if_arm_from_block.
if_expr_rhs -> *Expr
    : IF expr block ELSE block { expr_if(p, $2, $3, $5, $1.line, $1.col) }
    # AGAST #4543: the else-less form still PARSES here — one arm, no value.
    # `else_absent` fails it when an `else` follows (already claimed above),
    # so it only takes the `if c` + body shape.  Sema refuses it at this
    # `if` with ritz0's #1406 wording (if_arm_check), rather than the parser
    # failing at whatever token comes next.
    | IF expr block else_absent { expr_if_open(p, $2, $3, $1.line, $1.col) }
    ;

var_stmt -> *Stmt
    # Match-expression RHS forms — see let_stmt for rationale.
    : VAR binding_name COLON var_type ASSIGN match_expr_rhs
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name ASSIGN match_expr_rhs
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON var_type ASSIGN if_expr_rhs
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name ASSIGN if_expr_rhs
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON var_type ASSIGN expr NEWLINE
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    # AGAST #2098: `var p: *[N][M]T` with no initialiser latches its shape, as
    # var_type does.  Every other no-init type keeps type_spec.
    # AGAST #3930: the same for `var p: *mut [N][M]T`.
    | VAR binding_name COLON STAR MUT type_spec NEWLINE
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, capture_var_type(p, type_ptr_nd(p, $6)), 0 as *Expr, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON STAR STAR type_spec NEWLINE   # AGAST #3635
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, capture_var_type(p, type_ptr_nd(p, type_ptr_nd(p, $6))), 0 as *Expr, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON STAR type_spec NEWLINE
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, capture_var_type(p, type_ptr_nd(p, $5)), 0 as *Expr, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON var_nd_type NEWLINE   # AGAST #4122
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, 0 as *Expr, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name COLON type_spec NEWLINE
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, 0 as *Expr, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name ASSIGN expr NEWLINE
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    # AGAST #4543: else-less block `if` as the value (see let_stmt).
    | VAR binding_name COLON var_type ASSIGN expr open_if_ended
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $1.line, $1.col), $2.line, $2.col) }
    | VAR binding_name ASSIGN expr open_if_ended
      { stmt_named(stmt_var_decl(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, 0, $4, $1.line, $1.col), $2.line, $2.col) }
    ;

# Variable type - like type_spec but captures the type name for struct types
# This prevents the type name from being clobbered when parsing the initializer expression
var_type -> *TypeRef
    : var_nd_type { $1 }   # AGAST #4122
    | STAR MUT type_spec { capture_var_type(p, type_ptr_nd(p, $3)) }   # AGAST #3930
    | STAR STAR type_spec { capture_var_type(p, type_ptr_nd(p, type_ptr_nd(p, $3))) }   # AGAST #3635
    | STAR type_spec { capture_var_type(p, type_ptr_nd(p, $2)) }   # AGAST #2098
    | type_spec { capture_var_type(p, $1) }
    ;

# AGAST #4122: a local's type holding a `*[N][M]T` other than as the whole
# type (var_type's own `*` / `**` forms): behind a reference, `@*[N][M]T` /
# `@&*[N][M]T`, or as the element of an array, `[K]*[N][M]T`.  Each latches
# the shape (capture_var_type), with or without an initialiser.
var_nd_type -> *TypeRef
    : AT AMP STAR type_spec { capture_var_type(p, type_mut_ref(p, type_ptr_nd(p, $4))) }
    | AT STAR type_spec { capture_var_type(p, type_ref(p, type_ptr_nd(p, $3))) }
    | LBRACKET NUMBER RBRACKET STAR type_spec { capture_var_type(p, type_array(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, type_ptr_nd(p, $5))) }
    ;

return_stmt -> *Stmt
    # `return match v` + indented arms (#1618).  match_expr_rhs ends in
    # DEDENT, not NEWLINE, so the generic form below can never match it —
    # same reason let/var and match_arm carry match_expr_rhs forms.
    : RETURN match_expr_rhs { stmt_return(p, $2, $1.line, $1.col) }
    # `return if c` + arms + `else` (#1613); same DEDENT reason.
    | RETURN if_expr_rhs { stmt_return(p, $2, $1.line, $1.col) }
    | RETURN expr NEWLINE { stmt_return(p, $2, $1.line, $1.col) }
    # AGAST #4543: else-less block `if` as the returned value (see let_stmt).
    | RETURN expr open_if_ended { stmt_return(p, $2, $1.line, $1.col) }
    | RETURN NEWLINE { stmt_return(p, 0 as *Expr, $1.line, $1.col) }
    ;

if_stmt -> *Stmt
    : IF expr block else_clause { stmt_if(p, $2, $3, $4, $1.line, $1.col) }
    ;

else_clause -> *Stmt
    : ELSE block { $2 }
    | { 0 as *Stmt }
    ;

while_stmt -> *Stmt
    : WHILE expr block { stmt_while(p, $2, $3, $1.line, $1.col) }
    ;

for_stmt -> *Stmt
    : FOR for_var IN expr DOTDOT expr block
      { stmt_named(stmt_for(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $7, $1.line, $1.col), $2.line, $2.col) }
    | FOR for_var IN expr DOTDOTEQ expr block
      { stmt_named(stmt_for_inclusive(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $6, $7, $1.line, $1.col), $2.line, $2.col) }
    | FOR for_var IN expr block
      { stmt_named(stmt_for_iter(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }, $4, $5, $1.line, $1.col), $2.line, $2.col) }
    ;

# The loop variable, noted as a binding before the body is parsed: a bare
# `pass` in the body of `for pass in ..` reads the variable (AGAST #3320).
for_var -> Token
    : name { for_var_name(p.ctx, $1) }
    ;

# Infinite loop:  loop\n  body
# (ritz-task-87/AGAST cluster.)
loop_stmt -> *Stmt
    : LOOP block { stmt_loop(p, $2, $1.line, $1.col) }
    ;

# Match expression / statement (ritz-task-87).  Discriminates over an
# expression and dispatches to one of N pattern-arms.  AST shape mirrors
# ritz0: `MatchArm` carries pattern info inline (no separate Pattern node).
#
# Grammar:
#   match_stmt : MATCH expr NEWLINE INDENT match_arms DEDENT
#   match_arms : match_arm+
#   match_arm  : arm_pattern FAT_ARROW match_expr_rhs
#              | arm_pattern FAT_ARROW NEWLINE INDENT stmts DEDENT
#              | arm_pattern FAT_ARROW arm_body NEWLINE
#              | arm_pattern FAT_ARROW assign_stmt
#              | arm_pattern FAT_ARROW (return_stmt | break_stmt | continue_stmt)
#   arm_pattern : pattern ('|' pattern)*
#   pattern   : NUMBER | TRUE | FALSE | STRING | IDENT | IDENT '(' inner ')'
#              | IDENT '{' IDENT (',' IDENT)* '}'  (and each `E.`-qualified)
#   inner      : IDENT  (single binding or `_` wildcard, treated as IDENT here)
#   arm_body   : expr   (a bare `pass` is the no-op arm)
match_stmt -> *Stmt
    : MATCH expr NEWLINE INDENT match_arms DEDENT
      { stmt_match(p, $2, $5, $1.line, $1.col) }
    ;

match_arms -> *MatchArm
    : match_arm match_arms { match_arm_link($1, $2) }
    | match_arm { $1 }
    ;

match_arm -> *MatchArm
    # Nested-match arm body (`None => match g()` + indented arms, #1479).
    # match_expr_rhs ends in DEDENT, not NEWLINE, so the generic form below
    # can never match it — same reason let/var carry match_expr_rhs forms.
    # Order is not load-bearing (the parser backtracks; mutation-checked), but
    # trying it first avoids parsing the whole inner match twice.
    : arm_pattern FAT_ARROW match_expr_rhs { match_arm_set_body_or_pass($1, $3) }
    # Block-bodied arm (`None =>` + indented statements, #1454).  Its value is
    # the block's trailing bare expression, as for an `if` branch; see
    # match_arm_set_block_tail; a trailing match or if/else counts (#2429).
    # Ends in DEDENT, so no trailing NEWLINE either.
    | arm_pattern FAT_ARROW NEWLINE INDENT stmts DEDENT { match_arm_set_block_tail(p, $1, $5) }
    | arm_pattern FAT_ARROW arm_body NEWLINE { match_arm_set_body_or_pass($1, $3) }
    # Assignment arm (`5 => r = 5`, #1617): a one-statement block with no
    # value.  After the expression form so only assignment arms pay for the
    # backtrack (the expr form fails at ASSIGN, where it wants NEWLINE).
    | arm_pattern FAT_ARROW assign_stmt { match_arm_set_block($1, $3) }
    # Control-flow arms (`Ok(v) => return v + 1`, `None => break`,
    # `None => continue`; AGAST #1654, #1689): one-statement blocks with no
    # value.  The arm leaves through its `ret` / `br`; emit_match_arm_stmts
    # and StmtKind.Break / StmtKind.Continue open the unreachable block that carries
    # the arm's (zero) phi edge.
    | arm_pattern FAT_ARROW return_stmt { match_arm_set_block($1, $3) }
    | arm_pattern FAT_ARROW break_stmt { match_arm_set_block($1, $3) }
    | arm_pattern FAT_ARROW continue_stmt { match_arm_set_block($1, $3) }
    ;

# An arm's pattern: one, or an or-pattern `A | B | C` (LANGUAGE_SPEC §8.2,
# AGAST #4450).  The alternatives after the first chain from its `or_next`;
# each is a pattern of its own, with its own head_span for the errors said at
# an alternative.  What one may be depends on the scrutinee, so the match
# judges them (match_refuse_or_alternatives in emitter_match.ritz).
arm_pattern -> *MatchArm
    : pattern or_alternatives { pattern_or_link($1, $2) }
    ;

or_alternatives -> *MatchArm
    : PIPE pattern or_alternatives { pattern_or_link($2, $3) }
    | { 0 as *MatchArm }
    ;

pattern -> *MatchArm
    # Every arm keeps where its pattern begins (head_span), for the error at an
    # arm no value can reach and for naming the arm that covers it (AGAST #2349).
    : NUMBER { pattern_head_at(pattern_lit_int(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }), $1.line, $1.col) }
    | TRUE { pattern_head_at(pattern_bool(p, 1, $1.line, $1.col), $1.line, $1.col) }
    | FALSE { pattern_head_at(pattern_bool(p, 0, $1.line, $1.col), $1.line, $1.col) }
    # A string literal compares a StrView (LANGUAGE_SPEC §8.2, AGAST #1876).
    | STRING { pattern_head_at(pattern_str(p, $1), $1.line, $1.col) }
    # A char literal is u8 (§2.6), so its pattern is an integer literal
    # pattern typed u8 (LANGUAGE_SPEC §8.2, LARB R72, AGAST #4196).
    | CHAR { pattern_head_at(pattern_char(p, $1), $1.line, $1.col) }
    # Qualified variant patterns `Opt.None =>` / `Opt.Some(v) =>` (AGAST
    # #1794; #1466 is the constructor side).  Arms resolve variants by name,
    # exactly as for the unqualified forms below, so the enum qualifier
    # resolves nothing; it is kept, as an enum's name there is a use of it
    # (AGAST #3907).  Listed before `IDENT ...`, which would otherwise take
    # `Opt` alone as a binding and fail at the DOT.
    # Each keeps where it begins, for the error when the scrutinee's enum
    # declares no such variant (AGAST #2431).
    # `E.V(a, b, ..)` / `V(a, b, ..)`: every field of a multi-field variant,
    # bound positionally (AGAST #1295).  Tried before the one-binding forms.
    | IDENT DOT IDENT LPAREN IDENT COMMA IDENT tuple_bind_more RPAREN { pattern_qualified_by(pattern_head_at(pattern_variant_binds(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, tuple_name_link(tuple_name_new(p, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $5.line, $5.col), tuple_name_link(tuple_name_new(p, StrView { ptr: ($7.start), len: ($7.len) as i64 }, $7.line, $7.col), $8))), $1.line, $1.col), StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    # `E.V { b, a }` / `V { b, a }`: a struct variant's fields by name, each
    # once, any order (docs/ENUM_VARIANTS.md §4, AGAST #4187).
    | IDENT DOT IDENT LBRACE IDENT tuple_bind_more RBRACE { pattern_qualified_by(pattern_head_at(pattern_variant_named(p, $1, $3, tuple_name_link(tuple_name_new(p, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $5.line, $5.col), $6)), $1.line, $1.col), StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    | IDENT DOT IDENT LPAREN IDENT RPAREN { pattern_qualified_by(pattern_head_at(pattern_variant_inner(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $5.line, $5.col), $1.line, $1.col), StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    # The qualifier is kept for `mod.CONST =>`, refused as module access (AGAST #2215).
    | IDENT DOT IDENT { pattern_qualified_by(pattern_head_at(pattern_ident_or_wildcard(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }), $1.line, $1.col), StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    | IDENT LPAREN IDENT COMMA IDENT tuple_bind_more RPAREN { pattern_head_at(pattern_variant_binds(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, tuple_name_link(tuple_name_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $3.line, $3.col), tuple_name_link(tuple_name_new(p, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $5.line, $5.col), $6))), $1.line, $1.col) }
    | IDENT LBRACE IDENT tuple_bind_more RBRACE { pattern_head_at(pattern_variant_named(p, $1, $1, tuple_name_link(tuple_name_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $3.line, $3.col), $4)), $1.line, $1.col) }
    | IDENT LPAREN IDENT RPAREN { pattern_head_at(pattern_variant_inner(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $3.line, $3.col), $1.line, $1.col) }
    | IDENT { pattern_head_at(pattern_ident_at(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col), $1.line, $1.col) }
    ;

# arm_body is an expression; a bare `pass` (no-op arm) comes back as an
# expr_pass (apply_postfix_p, AGAST #3320): the match_arm action sets is_pass=1
# and keeps its position (AGAST #2236); otherwise body is the expression.
arm_body -> *Expr
    : expr { $1 }
    ;

break_stmt -> *Stmt
    : BREAK NEWLINE { stmt_break(p, $1.line, $1.col) }
    ;

continue_stmt -> *Stmt
    : CONTINUE NEWLINE { stmt_continue(p, $1.line, $1.col) }
    ;

assign_stmt -> *Stmt
    # binding_name, so a `var self` can be reassigned.  With IDENT here,
    # `self = v` fell through to `postfix_expr ASSIGN`, which stored v through
    # self's VALUE as if it were an address (AGAST #1632).
    : binding_name ASSIGN assign_rhs
      { stmt_assign_name(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3, $1.line, $1.col) }
    | binding_name compound_op expr NEWLINE
      { stmt_compound_assign(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $2, $3, $1.line, $1.col) }
    # `*e` is no postfix_expr, and `STAR expr` takes all of `*p + 1`.
    | STAR expr ASSIGN assign_rhs
      { stmt_assign_deref(p, $2, $4, $1.line, $1.col) }
    | STAR expr compound_op expr NEWLINE
      { stmt_compound_assign_deref(p, $2, $3, $4, $1.line, $1.col) }
    # Every other lvalue (`n[i]`, `v.f`, `(*e).f[i]`, `a.b.c`, ...) is one
    # postfix_expr; stmt_assign_lvalue picks its statement kind (AGAST #1819).
    # The lvalue starts at the rule's own start, so start_pos IS its token
    # index: the zero-width assign_pos wrapper bought nothing (AGAST #4378).
    | postfix_expr ASSIGN assign_rhs
      { stmt_assign_lvalue(p, start_pos, $1, OpKind.Unset, $3) }
    | postfix_expr compound_op expr NEWLINE
      { stmt_assign_lvalue(p, start_pos, $1, $2, $3) }
    ;

# The value after `=`: an if / match block value (AGAST #2369) or an expression
# ending its line. The block forms end in DEDENT, as for let_stmt, so they
# can't be `expr NEWLINE`; they come first because an inline `if c then a else
# b` is an expr too, and only fails the block form at its THEN.
assign_rhs -> *Expr
    : match_expr_rhs { $1 }
    | if_expr_rhs { $1 }
    | expr NEWLINE { $1 }
    # AGAST #4543: else-less block `if` as the assigned value (see let_stmt).
    | expr open_if_ended { $1 }
    ;

# Compound assignment operators: +=, -=, *=, /=, and their wrapping forms
# +%=, -%=, *%= (LARB R63).  Returns the operation type (OpKind.Add, OpKind.AddWrap,
# etc.); the stmt_compound_assign* builders set Expr.wrapping from the _WRAP
# code, so no Expr ever carries one.
compound_op -> OpKind
    : PLUS_EQ { OpKind.Add }
    | MINUS_EQ { OpKind.Sub }
    | STAR_EQ { OpKind.Mul }
    | SLASH_EQ { OpKind.Div }
    | PLUSPCT_EQ { OpKind.AddWrap }
    | MINUSPCT_EQ { OpKind.SubWrap }
    | STARPCT_EQ { OpKind.MulWrap }
    ;

expr_stmt -> *Stmt
    : expr NEWLINE { stmt_expr(p, $1, $1.span.line, $1.span.col) }
    # AGAST #4543: a statement whose operand is an else-less block `if`
    # (`*p + if c` + its body) ends at that block's DEDENT.
    | expr open_if_ended { stmt_expr(p, $1, $1.span.line, $1.span.col) }
    ;

# Expression grammar (left-factored to avoid exponential backtracking)
# Each rule parses the operand once, then optionally continues with the operator
expr -> *Expr
    : or_expr
    ;

# A binary operator at the end of a line continues the expression onto the
# next one, at the same indent (LANGUAGE_SPEC §2.2, AGAST #2954):
#
#     a == 0 and
#     b == 0
#
# ritz0's Pratt loop skips the NEWLINEs after the infix operator it has just
# consumed; this is that rule.  One NEWLINE is all there can be: the lexer
# folds blank and comment-only lines.  A deeper-indented continuation brings
# no INDENT or DEDENT either: the lexer lays it out as one (LARB R46, #3388).
op_nl -> i32
    : NEWLINE { 0 }
    | { 0 }
    ;

# A block operand (`5 + match x` + its arms) ends in DEDENT with no NEWLINE
# after it, so the next line's first token comes straight after it.  That
# line is a new statement (§2.2: a line that doesn't end in an operator ends
# it), even when it starts with `-` or `*` (AGAST #3435).  Each operator tail
# tries this first: it matches nothing, and fails unless the token before is
# a DEDENT, so the tail ends there.
block_ended -> i32
    : { block_ended_check(p) }
    ;

# AGAST #4543: the statement terminator when its value expression ended in a
# block operand: an `if` (expr_if_open, expr_if_operand #4553) or a `match`
# (expr_match_operand, #4049).  Such a block consumes the DEDENT and leaves
# no NEWLINE, so `expr NEWLINE` cannot match; this matches nothing and fails
# unless p.pos is exactly where that operand ended.  Position-keyed, not
# `block_ended`, so a node built by a speculative alternative over other
# tokens cannot satisfy it.
open_if_ended -> i32
    : { open_if_ended_check(p) }
    ;

# AGAST #4543: fails (matches nothing) when an `else` follows, so an
# else-less alternative does not claim a block `if` that has one.
else_absent -> i32
    : { else_absent_check(p) }
    ;

or_expr -> *Expr
    : and_expr or_tail { apply_binary_opt_p(p, $1, $2) }
    ;

or_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | OR op_nl and_expr or_tail { binary_op_new(p, OpKind.Or, $3, $4) }
    | OROR op_nl and_expr or_tail { binary_op_new(p, OpKind.Or, $3, $4) }
    | { 0 as *BinaryOp }
    ;

and_expr -> *Expr
    : bit_or_expr and_tail { apply_binary_opt_p(p, $1, $2) }
    ;

and_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | AND op_nl bit_or_expr and_tail { binary_op_new(p, OpKind.And, $3, $4) }
    | ANDAND op_nl bit_or_expr and_tail { binary_op_new(p, OpKind.And, $3, $4) }
    | { 0 as *BinaryOp }
    ;

# Bitwise OR (lowest bitwise precedence)
bit_or_expr -> *Expr
    : bit_xor_expr bit_or_tail { apply_binary_opt_p(p, $1, $2) }
    ;

bit_or_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | PIPE op_nl bit_xor_expr bit_or_tail { binary_op_new(p, OpKind.BitOr, $3, $4) }
    | { 0 as *BinaryOp }
    ;

# Bitwise XOR
bit_xor_expr -> *Expr
    : bit_and_expr bit_xor_tail { apply_binary_opt_p(p, $1, $2) }
    ;

bit_xor_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | CARET op_nl bit_and_expr bit_xor_tail { binary_op_new(p, OpKind.BitXor, $3, $4) }
    | { 0 as *BinaryOp }
    ;

# Bitwise AND (highest bitwise precedence)
bit_and_expr -> *Expr
    : cmp_expr bit_and_tail { apply_binary_opt_p(p, $1, $2) }
    ;

bit_and_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | AMP op_nl cmp_expr bit_and_tail { binary_op_new(p, OpKind.BitAnd, $3, $4) }
    | { 0 as *BinaryOp }
    ;

cmp_expr -> *Expr
    : shift_expr cmp_tail { apply_binary_opt_p(p, $1, $2) }
    ;

cmp_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | EQ op_nl shift_expr { binary_op_new(p, OpKind.Eq, $3, 0 as *BinaryOp) }
    | NE op_nl shift_expr { binary_op_new(p, OpKind.Ne, $3, 0 as *BinaryOp) }
    | LT op_nl shift_expr { binary_op_new(p, OpKind.Lt, $3, 0 as *BinaryOp) }
    | LE op_nl shift_expr { binary_op_new(p, OpKind.Le, $3, 0 as *BinaryOp) }
    | GT op_nl shift_expr { binary_op_new(p, OpKind.Gt, $3, 0 as *BinaryOp) }
    | GE op_nl shift_expr { binary_op_new(p, OpKind.Ge, $3, 0 as *BinaryOp) }
    | { 0 as *BinaryOp }
    ;

# Shift expressions (higher precedence than comparison, lower than addition)
shift_expr -> *Expr
    : add_expr shift_tail { apply_binary_opt_p(p, $1, $2) }
    ;

shift_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | SHL op_nl add_expr shift_tail { binary_op_new(p, OpKind.Shl, $3, $4) }
    | SHR op_nl add_expr shift_tail { binary_op_new(p, OpKind.Shr, $3, $4) }
    | { 0 as *BinaryOp }
    ;

add_expr -> *Expr
    : mul_expr add_tail { apply_binary_opt_p(p, $1, $2) }
    ;

add_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | PLUS op_nl mul_expr add_tail { binary_op_new(p, OpKind.Add, $3, $4) }
    | MINUS op_nl mul_expr add_tail { binary_op_new(p, OpKind.Sub, $3, $4) }
    # LARB R63: `+%` and `-%` bind as `+` and `-` do; binary_op_new unwraps
    # the _WRAP code to the plain op with Expr.wrapping set.
    | PLUSPCT op_nl mul_expr add_tail { binary_op_new(p, OpKind.AddWrap, $3, $4) }
    | MINUSPCT op_nl mul_expr add_tail { binary_op_new(p, OpKind.SubWrap, $3, $4) }
    | { 0 as *BinaryOp }
    ;

mul_expr -> *Expr
    : cast_expr mul_tail { apply_binary_opt_p(p, $1, $2) }
    ;

mul_tail -> *BinaryOp
    : block_ended { 0 as *BinaryOp }
    | STAR op_nl cast_expr mul_tail { binary_op_new(p, OpKind.Mul, $3, $4) }
    | SLASH op_nl cast_expr mul_tail { binary_op_new(p, OpKind.Div, $3, $4) }
    | PERCENT op_nl cast_expr mul_tail { binary_op_new(p, OpKind.Mod, $3, $4) }
    # LARB R63: `*%` binds as `*` does (see add_tail).
    | STARPCT op_nl cast_expr mul_tail { binary_op_new(p, OpKind.MulWrap, $3, $4) }
    | { 0 as *BinaryOp }
    ;

# Cast expression: unary_expr ("as" type)*
# Cast binds looser than unary prefix ops, so `@x as i64` parses as `(@x) as i64`
cast_expr -> *Expr
    : unary_expr cast_tail { apply_cast_tail(p, $1, $2) }
    ;

cast_tail -> *CastTail
    : block_ended { 0 as *CastTail }
    | AS op_nl cast_type cast_tail { cast_tail_new(p, $3, $4, $1.line, $1.col) }
    | { 0 as *CastTail }
    ;

# A cast's target type (AGAST #3124), as ritz0's _try_parse_cast_type_args
# reads it.  It sits in expression context, so `<` after a name may be a
# comparison: `f(a as Sz < b, c > d)` is two arguments, not a cast to
# `Sz<b, c>`.  A type is kept only when no operand follows it
# (cast_type_end); otherwise a bare name is retried and the `<` is left to
# the comparison.  `x as *Box<i64>` (or `Box<i64>`) at end of line, before
# `)`, `.` or an operator, is the generic type.
cast_type -> *TypeRef
    # AGAST #4122: `x as *[N][M]T`, which cast_tail_new records the shape of.
    : STAR type_spec cast_type_end { type_ptr_nd(p, $2) }
    | type_spec cast_type_end { $1 }
    | IDENT { type_named(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    ;

# Matches nothing; fails when the next token starts an operand.
cast_type_end -> i32
    : { cast_type_end_check(p) }
    ;

unary_expr -> *Expr
    : MINUS unary_expr { expr_unary(p, OpKind.Neg, $2, $1.line, $1.col) }
    | NOT unary_expr { expr_unary(p, OpKind.Not, $2, $1.line, $1.col) }
    | BANG unary_expr { expr_unary(p, OpKind.Not, $2, $1.line, $1.col) }
    | TILDE unary_expr { expr_unary(p, OpKind.BitNot, $2, $1.line, $1.col) }
    | STAR unary_expr { expr_unary(p, OpKind.Deref, $2, $1.line, $1.col) }
    # AGAST #1456: an ExprKind.Await node; async_lower.ritz lowers it (#3814).
    | AWAIT unary_expr { expr_await(p, $2, $1.start, $1.line, $1.col) }
    # AGAST #3934: `heap e` mallocs a T, stores e and is the *T, as ritz0's
    # HeapExpr; a call of ritzlib.memory's `__heap_new<T>` (expr_heap).
    | HEAP unary_expr { expr_heap(p, $2, $1.line, $1.col) }
    | addr_expr { $1 }
    ;

# Address-of binds tighter than cast, so @ts as *i64 is (@ts) as *i64
#
# `@*e` / `@&*e`: address of a dereference, i.e. the pointer `e` itself
# (tempest lib/history.ritz re-borrows `history:& T` as `@*history`, AGAST
# #1599).  A deref is a unary, not a postfix, so `AT addr_expr` cannot reach
# it.  The AST stays OpKind.Addr(OpKind.Deref e) rather than folding to `e`: call
# argument coercion keys on the OpKind.Addr wrapper (`f(@x)` into a by-value
# struct param), and emit_lvalue_ptr resolves the deref to `e`.  The operand
# is a unary_expr so `@**pp` and `@*-x`-style chains nest like `*` does.
addr_expr -> *Expr
    : AT AMP STAR unary_expr
      { expr_unary(p, OpKind.AddrMut, expr_unary(p, OpKind.Deref, $4, $3.line, $3.col), $1.line, $1.col) }
    | AT STAR unary_expr
      { expr_unary(p, OpKind.Addr, expr_unary(p, OpKind.Deref, $3, $2.line, $2.col), $1.line, $1.col) }
    | AT AMP addr_expr { expr_unary(p, OpKind.AddrMut, $3, $1.line, $1.col) }
    | AT addr_expr { expr_unary(p, OpKind.Addr, $2, $1.line, $1.col) }
    | postfix_expr { $1 }
    ;

postfix_expr -> *Expr
    # `a[:]` (AGAST #1794) is split off as full_slice_tail because it needs
    # the receiver built so far: it becomes `a.slice(0, a.len())`, ritz0's
    # lowering for Vec (a copy), String and Span.  Absent, $3 is null and
    # apply_full_slice_p returns the postfix chain unchanged.
    # A parenthesised primary keeps its parens' meaning: `(t.f)(..)` calls the
    # field's fn pointer, `t.f(..)` the method (AGAST #2120).  Same parse as
    # the `{ $2 }` primary_expr had, which moved here so a failed `( expr )`
    # is not parsed twice.
    : LPAREN expr RPAREN postfix_ops full_slice_tail? { apply_full_slice_p(p, apply_postfix_paren_p(p, $2, $4), $5) }
    | primary_expr postfix_ops full_slice_tail? { apply_full_slice_p(p, apply_postfix_p(p, $1, $2), $3) }
    ;

# `[:]` plus any postfix ops after it (`a[:].len()`).  Returns a marker op
# whose `next` is that trailing chain, so it is never null when present.
full_slice_tail -> *PostfixOp
    : LBRACKET COLON RBRACKET postfix_ops { full_slice_tail_new(p, $4) }
    ;

postfix_ops -> *PostfixOp
    : postfix_op postfix_ops { postfix_link($1, $2) }
    | { 0 as *PostfixOp }
    ;

postfix_op -> *PostfixOp
    # Pointer-typed generic call: `option_is_none<*Page>(@p)` lowers to a
    # call with mangled suffix `$ptr_Page`, matching ritz0's mangling.
    # MUST appear before the plain LT type_name GT alternative so the
    # generator tries this one first; otherwise STAR after LT trips the
    # plain rule's parse-failure cascade and the enclosing fn gets dropped
    # by parse_item's anchor-skip recovery (AGAST #186).
    : LT STAR type_name GT LPAREN call_args? RPAREN { postfix_generic_call_ptr(p, $3, $6) }
    # Reference-typed generic call: `id<@E>(e)` mangles to `$ref_E` as in
    # ritz0 (AGAST #1794).  Without this the generic_args form below parsed
    # it but gave the argument no spelling: `call void @id$(void ...)`.
    | LT AT type_name GT LPAREN call_args? RPAREN { postfix_generic_call_ref(p, $3, $6) }
    | LT type_name GT LPAREN call_args? RPAREN { postfix_generic_call(p, $2, $5) }
    # Generic call with a full type-argument list: `vec_new<Vec<i64>>()`
    # (closed by SHR, AGAST #1300), `second<i64, i32>(a, b)` (AGAST #1612).
    # `f(a < b, c > (d))` lexes the same way as a two-argument call; the
    # action REJECTS (sets p.error, so postfix_ops backtracks and `<` parses
    # as a comparison) any 2+-argument list naming a bare lowercase
    # identifier — a value, by Ritz naming style.  See
    # postfix_generic_call_list.
    | LT generic_args LPAREN call_args? RPAREN { postfix_generic_call_list(p, $2, $4) }
    | LPAREN call_args? RPAREN { postfix_call(p, $2) }
    | LBRACKET expr DOTDOT expr RBRACKET { postfix_range_index(p, $2, $4) }
    | LBRACKET expr DOTDOTEQ expr RBRACKET { postfix_range_index_inclusive(p, $2, $4) }
    # ritz0's colon slices (AGAST #3766): `[lo:hi]` is `[lo..hi]`, `[:hi]` is
    # `[0..hi]` and `[lo:]` is `[lo..a.len()]`, its end filled in by
    # apply_postfix_p once the receiver is built.  `[:]` fails all three and
    # is full_slice_tail's.
    | LBRACKET expr COLON expr RBRACKET { postfix_range_index(p, $2, $4) }
    | LBRACKET expr COLON RBRACKET { postfix_open_end_slice(p, $2) }
    | LBRACKET COLON expr RBRACKET { postfix_open_start_slice(p, $3) }
    | LBRACKET expr RBRACKET { postfix_index(p, $2, $1.line, $1.col) }
    | DOT name { postfix_member(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }) }
    # `t.0`: a tuple's element, its synthesized struct's field "0" (AGAST
    # #2956).  `t.0.1` lexes `0.1` as one FLOAT and is not parsed.
    | DOT NUMBER { postfix_member(p, StrView { ptr: ($2.start), len: ($2.len) as i64 }) }
    | QUESTION { postfix_try_new(p) }
    ;

args -> *Expr
    : expr COMMA args { expr_link($1, $3) }
    | expr { $1 }
    ;

# Call arguments: `args` plus ONE optional trailing comma (`f(a, b,)`),
# matching ritz0 (AGAST #1452).  Kept out of `args` itself because the array
# literal's own `LBRACKET args COMMA RBRACKET` (#1507) would then accept
# `[1, 2,,]`.
call_args -> *Expr
    : args COMMA { $1 }
    | args { $1 }
    ;

primary_expr -> *Expr
    : FLOAT { expr_float(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | NUMBER { expr_int_lit(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | TRUE { expr_true(p, $1.line, $1.col) }
    | FALSE { expr_false(p, $1.line, $1.col) }
    | STRING { expr_string(p, $1) }
    | CSTRING { expr_string(p, $1) }
    | CHAR { expr_char(p, $1) }
    | NIL { expr_nil(p, $1.line, $1.col) }
    | NULL { expr_nil(p, $1.line, $1.col) }
    | SELF { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    # The unit value `()` (AGAST #2272), as in `Ok(())`.  `( expr )` is tried
    # first (postfix_expr) and fails at the RPAREN, so this sees only `()`.
    | LPAREN RPAREN { expr_unit(p, $1.line, $1.col) }
    # A tuple expression `(a, b, ...)` (AGAST #2956), one or more elements
    # and an optional trailing comma.  `( expr )` is tried first
    # (postfix_expr) and fails at the COMMA.  A struct literal whose type
    # tuple_resolve_module names from its slot at module end.
    # `call_args` needs an argument, so `(42,)` (AGAST #4459) takes the arm
    # below; the two-element arm is first so `(1, 2)` never parses as `(1,)`
    # with `2` left over.
    | LPAREN expr COMMA call_args RPAREN { tuple_lit(p, $2, $4, $1.line, $1.col) }
    | LPAREN expr COMMA RPAREN { tuple_lit(p, $2, null, $1.line, $1.col) }
    # `Pair<i64, Vec<i64>> { ... }` — multi-arg and `>>`-closed lists via
    # generic_args (AGAST #1300); mangles on every argument like type_spec.
    | IDENT LT generic_args struct_lit { generic_struct_lit_arg(p, $1, $3, $4) }
    # `sizeof([8]u8)` / `sizeof([2][3]Pair)` (AGAST #2124): an array type
    # is no expression, so read it as a type.  The length is any constant
    # expression, `sizeof([N * 2]u8)`, as in a declaration (AGAST #2167).  The action rejects any callee
    # but `sizeof`.  Other types (`i32`, `Pair`, `*u8`) still parse as
    # expressions and are resolved as types by the emitter.
    | IDENT LPAREN LBRACKET expr RBRACKET type_spec RPAREN
      { sizeof_array_type_call(p, $1, $3, $4, $6) }
    # `sizeof(Box<i64>)` / `sizeof(Two<u8, Box<i64>>)` (AGAST #3268): a
    # generic instance is a type, but as an expression it reads as
    # `Box < i64 >` and fails at the `)`.  generic_args consumes the closer,
    # so `sizeof(n < m)` fails here (no `>`) and falls through to the
    # comparison.  The action rejects any callee but `sizeof`.
    | IDENT LPAREN IDENT LT generic_args RPAREN
      { sizeof_generic_type_call(p, $1, $3, $5) }
    # `Unit {}`: an empty struct literal (AGAST #2955), the only literal a
    # field-less struct has.  `IDENT struct_lit?` below consumes the braces
    # too, but its empty field list is a null `*FieldInit`, which reads as "no
    # literal": the struct's name was lowered as a variable.
    | IDENT LBRACE RBRACE { struct_lit_empty(p, $1) }
    # `Msg.SetViewport { width: 1, height: 2 }`: a qualified named variant
    # literal (docs/ENUM_VARIANTS.md §5, AGAST #4275).  At least one
    # `name: value` after the brace, so `E.V {}` never parses here; the
    # receiver is then `Msg` and postfix_ops reads `.SetViewport`.
    # named_variants.ritz makes it `Msg.SetViewport(1, 2)`.
    | IDENT DOT IDENT LBRACE field_init COMMA field_inits RBRACE
      { qualified_struct_lit(p, $1, $3, field_init_link($5, $7)) }
    | IDENT DOT IDENT LBRACE field_init RBRACE { qualified_struct_lit(p, $1, $3, $5) }
    | IDENT struct_lit? { ident_or_struct(p, $1, $2) }
    # Primitive type tokens as expression idents — needed for
    # `sizeof(i32)` / `sizeof(i64)` / etc. (AGAST #174).  The lexer
    # categorises `i32` etc. as their own token kinds (TOK_I32, …)
    # rather than IDENTs, so `primary_expr` must accept them
    # explicitly here.  Lowers to ExprKind.Ident carrying the type name —
    # emitter_expr_call's `sizeof` builtin (and any other site that
    # checks `e.args.kind == ExprKind.Ident` with text "i32"/"u8"/…) then
    # works without further changes.
    | I8 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | I16 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | I32 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | I64 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | U8 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | U16 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | U32 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | U64 { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    | BOOL { expr_ident(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col) }
    # `( expr )` is postfix_expr's first alternative (AGAST #2120).
    # Inline if-expression: `if c then a else b` (AGAST #1753).  Both arms
    # are full expressions, as in ritz0's parse_if, so `else 255 as i32`
    # casts the arm and `else if ...` right-nests.  `else` is mandatory: an
    # `if` with no `else` has no value.  Lowered to the block form's ExprKind.If
    # (expr_if_inline), so arms, narrowing and monomorph share #1613's path.
    # A statement-initial `if` still tries if_stmt first; it fails at THEN
    # (no block) and expr_stmt picks this up.
    | IF expr THEN expr ELSE expr
      { expr_if_inline(p, $2, $4, $6, $1.line, $1.col) }
    # A block `if`/`else` as an operand (`5 + if c` + then body + `else` +
    # else body), which ritz0 accepts as an expression (AGAST #4553).  The
    # else block ends in DEDENT, so the statement holding it terminates with
    # `open_if_ended` rather than `expr NEWLINE`; expr_if_operand notes where
    # (as expr_if_open does for the else-less form, #4543).  Listed before
    # the else-less alternative so an `if` with an `else` is claimed whole
    # rather than parsed to its then block and rejected by `else_absent`.
    | IF expr block ELSE block
      { expr_if_operand(p, $2, $3, $5, $1.line, $1.col) }
    # AGAST #4543: a block `if` as an operand (`5 + if c` + its body).  One
    # arm, no value; Sema refuses it at this `if` (#1406), so the parser no
    # longer fails at the operand's end.  `else_absent` keeps this
    # alternative from claiming the with-`else` form, which #4553 matches
    # above.
    | IF expr block else_absent
      { expr_if_open(p, $2, $3, $1.line, $1.col) }
    # Array fill literal: `[value; N]` — produces an array of size N where
    # each element is `value`.  Mirrors ritz0; squeeze/cryptosec rely on
    # this for inflate/sbox table init and valet's link step would
    # otherwise drop the enclosing functions silently. (AGAST #178)
    # Listed BEFORE the regular array literal so the backtracking parser
    # tries the fill shape first; if SEMICOLON isn't present after the
    # first expr it falls through to the comma-separated form below.
    | LBRACKET expr SEMICOLON NUMBER RBRACKET
      { expr_array_fill(p, $2, StrView { ptr: ($4.start), len: ($4.len) as i64 }, $1.line, $1.col) }
    # Array literal: [e1, e2, ...] — used to initialize fixed-size arrays
    # and slice/Span coercions.  Stored as ExprKind.ArrayLit with elements as
    # a linked list in `args`.
    | LBRACKET args RBRACKET { expr_array(p, $2, $1.line, $1.col) }
    # Empty array literal: `let d: [0]u8 = []` (AGAST #1794).
    | LBRACKET RBRACKET { expr_array(p, 0 as *Expr, $1.line, $1.col) }
    # Same, with one optional trailing comma: `[1, 2, 3,]`.  Multi-line
    # tables (cryptosec's AES S-boxes, ed25519's L_BYTES) end every row in
    # a comma, including the last.  Scoped to the array literal rather than
    # to `args`, which is shared with call arguments. (AGAST #1507)
    | LBRACKET args COMMA RBRACKET { expr_array(p, $2, $1.line, $1.col) }
    # `match` as expression: `let x = match scrut\n  arm => body\n  ...`.
    # Reuses the same arm-list grammar as match_stmt; the AST node uses
    # ExprKind.Match (kind=18) instead of StmtKind.Match so it slots into expr
    # contexts (let-RHS, function tail, arm bodies).  Note the match
    # block ends in DEDENT — no trailing NEWLINE — so callers expecting a
    # NEWLINE after the let must tolerate the DEDENT-terminated form.  As an
    # operand (`5 + match c` + its arms, AGAST #4049) the statement holding
    # it ends at that DEDENT through `open_if_ended`: expr_match_operand
    # notes where, as expr_if_operand does for a block `if` (#4553).
    | MATCH expr NEWLINE INDENT match_arms DEDENT
      { expr_match_operand(p, $2, $5, $1.line, $1.col) }
    # Closures and lambdas (LARB R56, AGAST #3471): ritz0's `|x| e`,
    # `|x: T, y| e`, `|| e` and `fn(params) [-> R] e`, read whole and refused
    # at the `|` / `||` / `fn` in ritz0's words rather than left to fail as
    # "unexpected '|'".  The `-> R` is read as `ARROW type_spec`, not
    # return_type, whose action records the enclosing fn's return type.
    # closure_ahead declines a `|` that follows a type (`fn f() -> A | B`,
    # whose one-line body is tried as a stmt) before any token is read, so
    # the parse still fails at the `|` and is refused as a union (#3409).
    | closure_ahead PIPE closure_params PIPE expr { closure_refused(p, $2.start, $2.line, $2.col) }
    | closure_ahead PIPE PIPE expr { closure_refused(p, $2.start, $2.line, $2.col) }
    | closure_ahead OROR expr { closure_refused(p, $2.start, $2.line, $2.col) }
    | FN LPAREN params? RPAREN ARROW type_spec expr
      { closure_refused(p, $1.start, $1.line, $1.col) }
    | FN LPAREN params? RPAREN expr { closure_refused(p, $1.start, $1.line, $1.col) }
    ;

# Zero-width: fails (p.error) when the `|` at p.pos follows a type.
closure_ahead -> i32
    : { closure_ahead_check(p) }
    ;

# A refused closure's parameters (AGAST #3471): `x`, `x: T`, comma-separated,
# one trailing comma.  Read only so the closure is consumed whole.
closure_params -> i32
    : closure_param COMMA closure_params { 0 }
    | closure_param COMMA { 0 }
    | closure_param { 0 }
    ;

closure_param -> i32
    : IDENT COLON type_spec { 0 }
    | IDENT { 0 }
    ;

struct_lit -> *FieldInit
    : LBRACE field_inits RBRACE { $2 }
    ;

field_inits -> *FieldInit
    : field_init COMMA field_inits { field_init_link($1, $3) }
    | field_init { $1 }
    | { 0 as *FieldInit }
    ;

field_init -> *FieldInit
    # An if value (AGAST #2369). The lexer resumes INDENT/DEDENT inside the
    # braces for its blocks; see lexer.ritz's layout frame.
    : name COLON if_expr_rhs { field_init_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | name COLON expr { field_init_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    ;

# =============================================================================
# Generic type parameters (<T>, <K, V>, etc.)
# =============================================================================

generic_params -> *TypeParam
    : LT type_param_list GT { $2 }
    ;

type_param_list -> *TypeParam
    : type_param COMMA type_param_list { type_param_link($1, $3) }
    | type_param { $1 }
    ;

# A parameter and its trait bound, `T: A + B` (LANGUAGE_SPEC §11.5, LARB R55,
# AGAST #3469).  The bound is a check made at instantiation (trait_bound.ritz).
type_param -> *TypeParam
    : IDENT COLON trait_bound_list { type_param_bounded(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $3) }
    | IDENT { type_param_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }) }
    ;

trait_bound_list -> *TraitBound
    : IDENT PLUS trait_bound_list { trait_bound_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, $3) }
    | IDENT { trait_bound_new(p, StrView { ptr: ($1.start), len: ($1.len) as i64 }, $1.line, $1.col, 0 as *TraitBound) }
    ;

# =============================================================================
# Impl blocks
# impl<T> Trait for Type { methods }
# impl<T> Type { methods }
# Generic-typed forms also supported: impl<T> Trait for Vec<T>, impl<T> Vec<T>
# Type args after the IDENT are consumed for syntax acceptance: name
# mangling keys off the bare type name (matches struct_def behaviour), and
# impl_block_with_args keeps them for R81's free-parameter check (#4002).
# The target is a type_name, so a primitive (`impl u8`, `impl Speak for i32`)
# parses and monomorph refuses it, located at the type (LARB R36, #3371).
# =============================================================================

impl_block -> *ImplBlock
    : IMPL generic_params? IDENT LT generic_args FOR type_name LT generic_args NEWLINE INDENT impl_methods DEDENT
      { impl_block_with_args(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($7.start), len: ($7.len) as i64 }, $9, $2, $12) }
    | IMPL generic_params? IDENT LT generic_args FOR type_name NEWLINE INDENT impl_methods DEDENT
      { impl_block_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($7.start), len: ($7.len) as i64 }, $2, null, $10) }
    | IMPL generic_params? IDENT FOR type_name LT generic_args NEWLINE INDENT impl_methods DEDENT
      { impl_block_generic_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $7, $2, $10) }
    # AGAST #4294 (R36's revisit): `impl Trait for *u8`, a trait impl on the
    # built-in pointer type.  Before the plain form, which would fail at STAR
    # and sink the block.  Only `*u8` is admitted, in the trait's file.
    | IMPL generic_params? IDENT FOR STAR type_name NEWLINE INDENT impl_methods DEDENT
      { impl_block_ptr_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($6.start), len: ($6.len) as i64 }, $2, $9, $5.line, $5.col) }
    | IMPL generic_params? IDENT FOR type_name NEWLINE INDENT impl_methods DEDENT
      { impl_block_new(p, StrView { ptr: ($3.start), len: ($3.len) as i64 }, StrView { ptr: ($5.start), len: ($5.len) as i64 }, $2, null, $8) }
    | IMPL generic_params? type_name LT generic_args NEWLINE INDENT impl_methods DEDENT
      { impl_block_with_args(p, StrView { ptr: (0 as *u8), len: (0) as i64 }, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $5, $2, $8) }
    | IMPL generic_params? type_name NEWLINE INDENT impl_methods DEDENT
      { impl_block_new(p, StrView { ptr: (0 as *u8), len: (0) as i64 }, StrView { ptr: ($3.start), len: ($3.len) as i64 }, $2, null, $6) }
    ;

impl_methods -> *FnDef
    : fn_def impl_methods { fn_link($1, $2) }
    | { 0 as *FnDef }
    ;
