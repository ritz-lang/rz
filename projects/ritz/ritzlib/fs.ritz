# ritzlib/fs.ritz - Filesystem utility functions
#
# High-level filesystem operations built on sys.ritz syscalls.
#
# One path API over `StrView` (AGAST #1477). A "..." literal is a StrView;
# a String passes string_as_view(@s); a C string passes strview_from_cstr(p).
#
#   predicates   path_exists / is_dir / is_file / is_symlink    -> bool
#   queries      stat / lstat -> Result<Stat, i32>, file_size -> Result<i64, i32>
#   whole files  read_file -> Result<String, i32>, write_file -> Result<i64, i32>
#   mutation     mkdir / unlink / rmdir -> Result<i32, i32> (Ok(0)), copy_file
#   paths        path_join -> String; path_basename / dirname / extension / stem
#                -> StrView, a view into the input (no allocation)
#
# Every Err carries the positive kernel errno (2 = ENOENT, 17 = EEXIST, ...).
# A path of FS_PATH_MAX bytes or more fails with ENAMETOOLONG (36).
#
# Note: Stat struct and STAT_SIZE are defined in ritzlib/sys.ritz

import ritzlib.sys
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.option

# ============================================================================
# stat / lstat -> Result<Stat, i32>
# ============================================================================
# `Stat` is the kernel's x86_64 `struct stat`, declared once in ritzlib/sys.ritz
# (st_dev @0, st_ino @8, st_nlink @16, st_mode @24, st_uid @28, st_gid @32,
# st_size @48, st_blksize @56, st_blocks @64; 144 bytes). fs reuses it rather
# than declaring a second type.
#
#     match stat("/etc/passwd")
#         Ok(st) => print_int(st.st_size)
#         Err(errno) => ...            # positive errno, e.g. 2 = ENOENT
#
# Err carries the positive kernel errno. A path longer than FS_PATH_MAX
# (PATH_MAX, 4096 including the NUL) fails with ENAMETOOLONG (36) without a
# syscall.

const FS_PATH_MAX: i64 = 4096
const FS_ENAMETOOLONG: i32 = 36

# Copy a (ptr, len) path into `buf` and NUL-terminate it. A StrView carries no
# terminator, so it cannot be handed to the kernel directly.
# Returns 0 on success, FS_ENAMETOOLONG if it does not fit.
fn fs_path_cstr(path: @StrView, buf: *u8) -> i32
    if path.len >= FS_PATH_MAX
        return FS_ENAMETOOLONG
    for i in 0..path.len
        *(buf + i) = *(path.ptr + i)
    *(buf + path.len) = 0
    0

# Shared body of stat/lstat. `follow` selects stat(2) (1) or lstat(2) (0).
fn fs_stat_impl(path: @StrView, follow: i32) -> Result<Stat, i32>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(perr)
    var st: Stat
    var ret: i32 = 0
    if follow != 0
        ret = sys_stat2(@cpath[0], @st)
    else
        ret = sys_lstat2(@cpath[0], @st)
    if ret < 0
        return Err(-ret)
    Ok(st)

# Status of the file at `path`, following symlinks.
pub fn stat(path: StrView) -> Result<Stat, i32>
    fs_stat_impl(@path, 1)

# Status of the file at `path`; a symlink is reported as itself.
pub fn lstat(path: StrView) -> Result<Stat, i32>
    fs_stat_impl(@path, 0)

# ============================================================================
# Stat buffer accessors (legacy)
# ============================================================================
# Kept for code that still stats into a raw [144]u8. They read through the
# Stat struct, so the field offsets live in one place (sys.ritz).
# New code: `stat(path)` / `lstat(path)` and the Stat fields.

pub fn stat_get_dev(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_dev

pub fn stat_get_ino(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_ino

pub fn stat_get_nlink(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_nlink

pub fn stat_get_mode(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_mode

pub fn stat_get_uid(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_uid

pub fn stat_get_gid(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_gid

pub fn stat_get_size(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_size

pub fn stat_get_blksize(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_blksize

pub fn stat_get_blocks(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_blocks

# ============================================================================
# File type helpers
# ============================================================================

pub fn mode_is_dir(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 4) as i32

pub fn mode_is_file(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 8) as i32

pub fn mode_is_link(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == '\n') as i32

pub fn mode_is_char(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 2) as i32

pub fn mode_is_block(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 6) as i32

pub fn mode_is_fifo(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 1) as i32

pub fn mode_is_socket(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 12) as i32

# ============================================================================
# Path predicates -> bool
# ============================================================================
# These use lstat(2): a symlink is reported as itself, never as its target, so
# is_dir(link-to-dir) is false and a recursive walk does not follow links.

# st_mode of `path` (lstat), or -1 if it cannot be statted.
fn fs_lstat_mode(path: @StrView) -> i32
    var r: Result<Stat, i32> = fs_stat_impl(path, 0)
    match r
        Ok(st) => st.st_mode
        Err(_) => -1

# True if anything (file, directory, dangling symlink, ...) exists at `path`.
pub fn path_exists(path: StrView) -> bool
    fs_lstat_mode(@path) >= 0

pub fn is_dir(path: StrView) -> bool
    let mode: i32 = fs_lstat_mode(@path)
    mode >= 0 and mode_is_dir(mode) != 0

pub fn is_file(path: StrView) -> bool
    let mode: i32 = fs_lstat_mode(@path)
    mode >= 0 and mode_is_file(mode) != 0

pub fn is_symlink(path: StrView) -> bool
    let mode: i32 = fs_lstat_mode(@path)
    mode >= 0 and mode_is_link(mode) != 0

# Size in bytes of `path` (lstat: a symlink's own size).
pub fn file_size(path: StrView) -> Result<i64, i32>
    var r: Result<Stat, i32> = fs_stat_impl(@path, 0)
    match r
        Ok(st) => Ok(st.st_size)
        Err(e) => Err(e)

# ============================================================================
# Dirent helpers (getdents64 structure)
# ============================================================================
# struct linux_dirent64 {
#   u64 d_ino;           // 0: 8 bytes
#   u64 d_off;           // 8: 8 bytes
#   u16 d_reclen;        // 16: 2 bytes
#   u8  d_type;          // 18: 1 byte
#   char d_name[];       // 19: variable
# }
#
# The fixed part is sys.ritz's Dirent64. A DirEntry is the decoded, typed view
# of one record: `name` points into the DirIter's buffer, so it is valid only
# until the next dir_next/dir_next_entry or dir_close on that iterator.

pub struct DirEntry
    ino: i64             # inode number
    kind: u8             # DT_REG, DT_DIR, DT_LNK, ... (sys.ritz)
    name: StrView        # entry name, without the trailing NUL

const DIRENT_NAME_OFFSET: i64 = 19

# Decode the linux_dirent64 record at `entry`.
pub fn dirent_entry(entry: *u8) -> DirEntry
    let d: *Dirent64 = entry as *Dirent64
    let name: *u8 = entry + DIRENT_NAME_OFFSET
    DirEntry { ino: d.d_ino, kind: d.d_type, name: strview_from_cstr(name) }

pub fn dirent_get_ino(entry: *u8) -> i64
    let d: *Dirent64 = entry as *Dirent64
    d.d_ino

pub fn dirent_get_reclen(entry: *u8) -> i32
    let d: *Dirent64 = entry as *Dirent64
    d.d_reclen as i32

# Legacy: prefer dirent_entry(entry).kind.
pub fn dirent_get_type(entry: *u8) -> u8
    let d: *Dirent64 = entry as *Dirent64
    d.d_type

# Legacy: prefer dirent_entry(entry).name (a StrView). Same pointer, but this
# form skips the strlen that building the view costs.
pub fn dirent_get_name(entry: *u8) -> *u8
    entry + DIRENT_NAME_OFFSET

# Note: DT_* constants are defined in ritzlib/sys.ritz

# ============================================================================
# Path utilities (pure string work; no syscalls)
# ============================================================================

# Join `dir` and `name` with exactly one '/' between them, into a new String.
# An empty `dir` yields `name` unchanged; a `dir` ending in '/' adds none.
pub fn path_join(dir: StrView, name: StrView) -> String
    var r: String = string_with_cap(dir.len + name.len + 2)
    string_push_bytes(@r, dir.ptr, dir.len)
    if dir.len > 0 and *(dir.ptr + dir.len - 1) != '/'
        string_push(@r, '/')
    string_push_bytes(@r, name.ptr, name.len)
    r

# Index of the last '/' in `path`, or -1.
fn fs_last_slash(path: @StrView) -> i64
    var last: i64 = -1
    for i in 0..path.len
        if *(path.ptr + i) == '/'
            last = i
    last

# Index of the dot that starts the extension of `path`'s final component, or
# -1 if it has none. A dot that opens the component (".gitignore") is not one.
fn fs_ext_dot(path: @StrView) -> i64
    var last_dot: i64 = -1
    var last_slash: i64 = -1
    for i in 0..path.len
        let c: u8 = *(path.ptr + i)
        if c == '/'
            last_slash = i
        else if c == '.'
            last_dot = i
    if last_dot < 0 or last_dot < last_slash or last_dot == last_slash + 1
        return -1
    last_dot

# The final component: everything after the last '/' ("/a/b.txt" -> "b.txt").
# A view into `path`.
pub fn path_basename(path: StrView) -> StrView
    let slash: i64 = fs_last_slash(@path)
    if slash < 0
        return path
    strview_from_ptr(path.ptr + slash + 1, path.len - slash - 1)

# Everything before the last '/' ("/a/b.txt" -> "/a"); "/" for a top-level
# path and "." when there is no '/'. A view into `path` (or the literal ".").
pub fn path_dirname(path: StrView) -> StrView
    let slash: i64 = fs_last_slash(@path)
    if slash < 0
        return "."
    if slash == 0
        return strview_from_ptr(path.ptr, 1)
    strview_from_ptr(path.ptr, slash)

# The extension without its dot ("/a/b.txt" -> "txt"), or an empty view.
pub fn path_extension(path: StrView) -> StrView
    let dot: i64 = fs_ext_dot(@path)
    if dot < 0
        return strview_from_ptr(path.ptr + path.len, 0)
    strview_from_ptr(path.ptr + dot + 1, path.len - dot - 1)

# `path` without its extension ("/a/b.txt" -> "/a/b"); `path` if it has none.
pub fn path_stem(path: StrView) -> StrView
    let dot: i64 = fs_ext_dot(@path)
    if dot < 0
        return path
    strview_from_ptr(path.ptr, dot)

# ============================================================================
# File operations -> Result (Err = positive errno)
# ============================================================================

const FS_EIO: i32 = 5

# open(2) a StrView path. Returns the fd, or -errno.
fn fs_open(path: @StrView, flags: i32, mode: i32) -> i32
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return -perr
    sys_open3(@cpath[0], flags, mode)

# Write all `len` bytes at `data` to `fd`. Returns 0, or a positive errno.
fn fs_write_all(fd: i32, data: *u8, len: i64) -> i32
    var written: i64 = 0
    while written < len
        let n: i64 = sys_write(fd, data + written, len - written)
        if n < 0
            return -(n as i32)
        if n == 0
            return FS_EIO
        written += n
    0

# The whole contents of the file at `path`.
pub fn read_file(path: StrView) -> Result<String, i32>
    let fd: i32 = fs_open(@path, O_RDONLY, 0)
    if fd < 0
        return Err(-fd)
    var out: String = string_new()
    var buf: [4096]u8
    loop
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n < 0
            sys_close(fd)
            string_drop(@out)
            return Err(-(n as i32))
        if n == 0
            break
        string_push_bytes(@out, @buf[0], n)
    sys_close(fd)
    Ok(out)

# Create or truncate `path` (mode 0644) and write `content` to it.
# Ok carries the number of bytes written.
pub fn write_file(path: StrView, content: StrView) -> Result<i64, i32>
    # O_WRONLY | O_CREAT | O_TRUNC = 1 + 64 + 512 = 577; 0644 = 420
    let fd: i32 = fs_open(@path, 577, 420)
    if fd < 0
        return Err(-fd)
    let werr: i32 = fs_write_all(fd, content.ptr, content.len)
    sys_close(fd)
    if werr != 0
        return Err(werr)
    Ok(content.len)

# Copy `src` to `dest` (created or truncated with `mode`).
# Ok carries the number of bytes copied. `dest` is not created if `src`
# cannot be opened.
pub fn copy_file(src: StrView, dest: StrView, mode: i32) -> Result<i64, i32>
    let src_fd: i32 = fs_open(@src, O_RDONLY, 0)
    if src_fd < 0
        return Err(-src_fd)
    let dest_fd: i32 = fs_open(@dest, 577, mode)
    if dest_fd < 0
        sys_close(src_fd)
        return Err(-dest_fd)

    var buf: [8192]u8
    var total: i64 = 0
    var err: i32 = 0
    loop
        let nread: i64 = sys_read(src_fd, @buf[0], 8192)
        if nread < 0
            err = -(nread as i32)
            break
        if nread == 0
            break
        err = fs_write_all(dest_fd, @buf[0], nread)
        if err != 0
            break
        total += nread

    sys_close(src_fd)
    sys_close(dest_fd)
    if err != 0
        return Err(err)
    Ok(total)

# Map a raw syscall return (0 or -errno) to Result<i32, i32>.
fn fs_unit(ret: i32) -> Result<i32, i32>
    if ret < 0
        return Err(-ret)
    Ok(0)

# Create directory `path` with `mode` (e.g. 493 = 0755). EEXIST if present.
pub fn mkdir(path: StrView, mode: i32) -> Result<i32, i32>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(@path, @cpath[0])
    if perr != 0
        return Err(perr)
    fs_unit(sys_mkdir(@cpath[0], mode))

# Remove the (non-directory) entry at `path`.
pub fn unlink(path: StrView) -> Result<i32, i32>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(@path, @cpath[0])
    if perr != 0
        return Err(perr)
    fs_unit(sys_unlink(@cpath[0]))

# Remove the empty directory at `path`.
pub fn rmdir(path: StrView) -> Result<i32, i32>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(@path, @cpath[0])
    if perr != 0
        return Err(perr)
    fs_unit(sys_rmdir(@cpath[0]))

# ============================================================================
# Directory Iteration
# ============================================================================
# High-level directory iteration API using getdents64.
#
# Usage:
#     var dir: DirIter = dir_open("/path/to/dir")
#     while dir_next(@dir)
#         let e: DirEntry = dir_entry(@dir)   # e.ino, e.kind, e.name (StrView)
#         # process entry...
#     dir_close(@dir)
#
# dir_entry_name / dir_entry_type are the older *u8 / u8 accessors.

const DIR_BUF_SIZE: i64 = 4096

pub struct DirIter
    fd: i32              # Directory file descriptor
    buf: [4096]u8        # Buffer for getdents64
    buf_pos: i64         # Current position in buffer
    buf_len: i64         # Bytes read into buffer
    entry: *u8           # Current entry pointer

# Open a directory for iteration.
# Returns a DirIter - check with dir_valid() before using.
pub fn dir_open(path: StrView) -> DirIter
    var dir: DirIter
    dir.fd = fs_open(@path, O_RDONLY + O_DIRECTORY, 0)
    dir.buf_pos = 0
    dir.buf_len = 0
    dir.entry = null
    dir

# Check if directory was opened successfully.
pub fn dir_valid(dir: *DirIter) -> i32
    (dir.fd >= 0) as i32

# Advance to the next record; 1 if `dir.entry` now points at one, 0 at the end.
# Shared by dir_next and dir_next_entry. It takes @&DirIter and only touches
# fields, because ritz1 cannot forward an @&T parameter into a *T one
# (AGAST #1652).
fn dir_advance(dir: @&DirIter) -> i32
    # Need more data?
    if dir.buf_pos >= dir.buf_len
        # Read next batch of entries
        dir.buf_len = sys_getdents64(dir.fd, @dir.buf[0], DIR_BUF_SIZE)
        dir.buf_pos = 0

        if dir.buf_len <= 0
            dir.entry = null
            return 0

    # Point to current entry
    dir.entry = @dir.buf[0] + dir.buf_pos

    # Advance position for next call
    let reclen: i32 = dirent_get_reclen(dir.entry)
    dir.buf_pos = dir.buf_pos + reclen as i64

    1

# Advance to next directory entry.
# Returns 1 if an entry is available, 0 if done.
pub fn dir_next(dir: *DirIter) -> i32
    dir_advance(dir)

# The current entry as a typed DirEntry. Only valid after dir_next() returns 1;
# before that (or after the end) it is { ino: 0, kind: DT_UNKNOWN, name: "" }.
pub fn dir_entry(dir: @DirIter) -> DirEntry
    if dir.entry == null
        return DirEntry { ino: 0, kind: DT_UNKNOWN, name: strview_empty() }
    dirent_entry(dir.entry)

# Advance and return the next entry, or None when the directory is exhausted
# (or was never opened). The entry's name borrows the iterator's buffer.
#
#     loop
#         var next: Option<DirEntry> = dir_next_entry(@&dir)
#         if option_is_none<DirEntry>(@next) == 1
#             break
#         match next
#             Some(e) => handle(@e)        # handle returns a value, see #1654
#             None => 0
pub fn dir_next_entry(dir: @&DirIter) -> Option<DirEntry>
    # An unopened iterator (fd < 0) ends here too: getdents64 fails, buf_len <= 0.
    if dir_advance(dir) == 0
        return None
    Some(dirent_entry(dir.entry))

# Get name of current entry.
# Only valid after dir_next() returns 1.
pub fn dir_entry_name(dir: *DirIter) -> *u8
    if dir.entry == null
        return null
    dirent_get_name(dir.entry)

# Get type of current entry.
# Returns DT_REG, DT_DIR, etc. from sys.ritz
pub fn dir_entry_type(dir: *DirIter) -> u8
    if dir.entry == null
        return 0
    dirent_get_type(dir.entry)

# Check if current entry is a directory.
pub fn dir_entry_is_dir(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_DIR) as i32

# Check if current entry is a regular file.
pub fn dir_entry_is_file(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_REG) as i32

# Check if current entry is a symlink.
pub fn dir_entry_is_link(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_LNK) as i32

# Close the directory iterator.
pub fn dir_close(dir: *DirIter)
    if dir.fd >= 0
        sys_close(dir.fd)
        dir.fd = -1
