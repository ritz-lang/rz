# ritzlib/fs.ritz - Filesystem utility functions
#
# High-level filesystem operations built on sys.ritz syscalls.
#
# One path API over `StrView` (AGAST #1477). A "..." literal is a StrView;
# a String passes string_as_view(@s); a C string passes strview_from_cstr(p).
#
#   predicates   path_exists / is_dir / is_file / is_symlink    -> bool
#   queries      stat / lstat -> Result<Stat, Errno>, file_size -> Result<i64, Errno>
#   whole files  read_file -> Result<String, Errno>, write_file -> Result<i64, Errno>
#   mutation     mkdir / unlink / rmdir -> Result<i32, Errno> (Ok(0)), copy_file
#   directories  dir_open -> Result<DirIter, Errno>; dir_next -> bool;
#                dir_entry_type -> Option<u8>; dir_entry / dir_next_entry
#   paths        path_join -> String; path_basename / dirname / extension / stem
#                -> StrView, a view into the input (no allocation)
#
# Every Err is a ritzlib.errno `Errno` (NoEnt, Exist, ...; Other(n) for a code
# without a variant), never a -1 / null sentinel or a bare number (AGAST
# #4248). A path of FS_PATH_MAX bytes or more fails with NameTooLong.
#
# Note: Stat struct and STAT_SIZE are defined in ritzlib/sys.ritz

import ritzlib.sys
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.option
import ritzlib.memory  # malloc, free: DirIter's getdents buffer
# Errno is part of this API (every Err), so importers of fs get it too.
pub import ritzlib.errno

# ============================================================================
# stat / lstat -> Result<Stat, Errno>
# ============================================================================
# `Stat` is the kernel's x86_64 `struct stat`, declared once in ritzlib/sys.ritz
# (st_dev @0, st_ino @8, st_nlink @16, st_mode @24, st_uid @28, st_gid @32,
# st_size @48, st_blksize @56, st_blocks @64; 144 bytes). fs reuses it rather
# than declaring a second type.
#
#     match stat("/etc/passwd")
#         Ok(st) => print("{st.st_size}")
#         Err(e) => ...                # an Errno, e.g. NoEnt
#
# A path longer than FS_PATH_MAX (PATH_MAX, 4096 including the NUL) fails with
# NameTooLong without a syscall.

const FS_PATH_MAX: i64 = 4096
const FS_ENAMETOOLONG: i32 = 36

# Copy a (ptr, len) path into `buf` and NUL-terminate it. A StrView carries no
# terminator, so it cannot be handed to the kernel directly.
# Returns 0 on success, FS_ENAMETOOLONG if it does not fit.
fn fs_path_cstr(path: StrView, buf: *u8) -> i32
    if path.len >= FS_PATH_MAX
        return FS_ENAMETOOLONG
    for i in 0..path.len
        *(buf + i) = *(path.ptr + i)
    *(buf + path.len) = 0
    0

# Shared body of stat/lstat. `follow` selects stat(2) (1) or lstat(2) (0).
fn fs_stat_impl(path: StrView, follow: i32) -> Result<Stat, Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    var st: Stat
    var ret: i32 = 0
    if follow != 0
        ret = sys_stat2(@cpath[0], @&st)
    else
        ret = sys_lstat2(@cpath[0], @&st)
    if ret < 0
        return Err(errno_from_raw(ret))
    Ok(st)

# Status of the file at `path`, following symlinks.
pub fn stat(path: StrView) -> Result<Stat, Errno>
    fs_stat_impl(path, 1)

# Status of the file at `path`; a symlink is reported as itself.
pub fn lstat(path: StrView) -> Result<Stat, Errno>
    fs_stat_impl(path, 0)

# ============================================================================
# File type helpers
# ============================================================================

pub fn mode_is_dir(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 4

pub fn mode_is_file(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 8

pub fn mode_is_link(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == '\n'

pub fn mode_is_char(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 2

pub fn mode_is_block(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 6

pub fn mode_is_fifo(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 1

pub fn mode_is_socket(mode: i32) -> bool
    let type_bits: i32 = mode / 4096
    return type_bits == 12

# ============================================================================
# Path predicates -> bool
# ============================================================================
# These use lstat(2): a symlink is reported as itself, never as its target, so
# is_dir(link-to-dir) is false and a recursive walk does not follow links.

# st_mode of `path` (lstat), or None if it cannot be statted.
fn fs_lstat_mode(path: StrView) -> Option<i32>
    var r: Result<Stat, Errno> = fs_stat_impl(path, 0)
    match r
        Ok(st) => Some(st.st_mode)
        Err(_) => None

# True if anything (file, directory, dangling symlink, ...) exists at `path`.
pub fn path_exists(path: StrView) -> bool
    let m: Option<i32> = fs_lstat_mode(path)
    option_is_some<i32>(@m)

pub fn is_dir(path: StrView) -> bool
    match fs_lstat_mode(path)
        Some(mode) => mode_is_dir(mode)
        None => false

pub fn is_file(path: StrView) -> bool
    match fs_lstat_mode(path)
        Some(mode) => mode_is_file(mode)
        None => false

pub fn is_symlink(path: StrView) -> bool
    match fs_lstat_mode(path)
        Some(mode) => mode_is_link(mode)
        None => false

# Size in bytes of `path` (lstat: a symlink's own size).
pub fn file_size(path: StrView) -> Result<i64, Errno>
    var r: Result<Stat, Errno> = fs_stat_impl(path, 0)
    match r
        Ok(st) => Ok(st.st_size)
        Err(e) => Err(e)

# ============================================================================
# Dirent helpers (getdents64 structure)
# ============================================================================
# struct linux_dirent64 {
#   u64 d_ino;           // 0: 8 bytes
#   u64 d_off;           // 8: 8 bytes
#   u16 d_reclen;        // 16: 2 bytes
#   u8  d_type;          // 18: 1 byte
#   char d_name[];       // 19: variable
# }
#
# The fixed part is sys.ritz's Dirent64. A DirEntry is the decoded, typed view
# of one record: `name` points into the DirIter's buffer, so it is valid only
# until the next dir_next/dir_next_entry or dir_close on that iterator.

pub struct DirEntry
    ino: i64             # inode number
    kind: u8             # DT_REG, DT_DIR, DT_LNK, ... (sys.ritz)
    name: StrView        # entry name, without the trailing NUL

const DIRENT_NAME_OFFSET: i64 = 19

# Note: DT_* constants are defined in ritzlib/sys.ritz

# ============================================================================
# Path utilities (pure string work; no syscalls)
# ============================================================================

# Join `dir` and `name` with exactly one '/' between them, into a new String.
# An empty `dir` yields `name` unchanged; a `dir` ending in '/' adds none.
pub fn path_join(dir: StrView, name: StrView) -> String
    var r: String = string_with_cap(dir.len + name.len + 2)
    r.push_span(Span<u8> { ptr: (dir.ptr), len: (dir.len) as i64 })
    if dir.len > 0 and *(dir.ptr + dir.len - 1) != '/'
        r.push('/')
    r.push_span(Span<u8> { ptr: (name.ptr), len: (name.len) as i64 })
    r

# Index of the last '/' in `path`, or None.
fn fs_last_slash(path: StrView) -> Option<i64>
    var last: i64 = -1
    for i in 0..path.len
        if *(path.ptr + i) == '/'
            last = i
    if last < 0
        return None
    Some(last)

# Index of the dot that starts the extension of `path`'s final component, or
# None if it has none. A dot that opens the component (".gitignore") is not one.
fn fs_ext_dot(path: StrView) -> Option<i64>
    var last_dot: i64 = -1
    var last_slash: i64 = -1
    for i in 0..path.len
        let c: u8 = *(path.ptr + i)
        if c == '/'
            last_slash = i
        else if c == '.'
            last_dot = i
    if last_dot < 0 or last_dot < last_slash or last_dot == last_slash + 1
        return None
    Some(last_dot)

# The final component: everything after the last '/' ("/a/b.txt" -> "b.txt").
# A view into `path`.
pub fn path_basename(path: StrView) -> StrView
    match fs_last_slash(path)
        Some(slash) => return strview_from_ptr(path.ptr + slash + 1, path.len - slash - 1)
        None => return path

# Everything before the last '/' ("/a/b.txt" -> "/a"); "/" for a top-level
# path and "." when there is no '/'. A view into `path` (or the literal ".").
pub fn path_dirname(path: StrView) -> StrView
    match fs_last_slash(path)
        Some(slash) =>
            if slash == 0
                return strview_from_ptr(path.ptr, 1)
            return strview_from_ptr(path.ptr, slash)
        None => return "."

# The extension without its dot ("/a/b.txt" -> "txt"), or an empty view.
pub fn path_extension(path: StrView) -> StrView
    match fs_ext_dot(path)
        Some(dot) => return strview_from_ptr(path.ptr + dot + 1, path.len - dot - 1)
        None => return strview_from_ptr(path.ptr + path.len, 0)

# `path` without its extension ("/a/b.txt" -> "/a/b"); `path` if it has none.
pub fn path_stem(path: StrView) -> StrView
    match fs_ext_dot(path)
        Some(dot) => return strview_from_ptr(path.ptr, dot)
        None => return path

# ============================================================================
# File operations -> Result<T, Errno>
# ============================================================================

const FS_EIO: i32 = 5

# open(2) a StrView path. Returns the fd, or -errno.
fn fs_open(path: StrView, flags: i32, mode: i32) -> i32
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return -perr
    sys_open3(@cpath[0], flags, mode)

# Write all `len` bytes at `data` to `fd`. Returns 0, or a positive errno.
fn fs_write_all(fd: i32, data: *u8, len: i64) -> i32
    var written: i64 = 0
    while written < len
        let n: i64 = sys_write(fd, data + written, len - written)
        if n < 0
            return -(n as i32)
        if n == 0
            return FS_EIO
        written += n
    0

# The whole contents of the file at `path`.
pub fn read_file(path: StrView) -> Result<String, Errno>
    let fd: i32 = fs_open(path, O_RDONLY, 0)
    if fd < 0
        return Err(errno_from_raw(fd))
    var out: String = string_new()
    var buf: [4096]u8
    loop
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n < 0
            sys_close(fd)
            return Err(errno_from_raw(n as i32))
        if n == 0
            break
        out.push_span(Span<u8> { ptr: (@buf[0]), len: (n) as i64 })
    sys_close(fd)
    Ok(out)

# Create or truncate `path` (mode 0644) and write `content` to it.
# Ok carries the number of bytes written.
pub fn write_file(path: StrView, content: StrView) -> Result<i64, Errno>
    # O_WRONLY | O_CREAT | O_TRUNC = 1 + 64 + 512 = 577; 0644 = 420
    let fd: i32 = fs_open(path, 577, 420)
    if fd < 0
        return Err(errno_from_raw(fd))
    let werr: i32 = fs_write_all(fd, content.ptr, content.len)
    sys_close(fd)
    if werr != 0
        return Err(errno_from_raw(werr))
    Ok(content.len)

# Copy `src` to `dest` (created or truncated with `mode`).
# Ok carries the number of bytes copied. `dest` is not created if `src`
# cannot be opened.
pub fn copy_file(src: StrView, dest: StrView, mode: i32) -> Result<i64, Errno>
    let src_fd: i32 = fs_open(src, O_RDONLY, 0)
    if src_fd < 0
        return Err(errno_from_raw(src_fd))
    let dest_fd: i32 = fs_open(dest, 577, mode)
    if dest_fd < 0
        sys_close(src_fd)
        return Err(errno_from_raw(dest_fd))

    var buf: [8192]u8
    var total: i64 = 0
    var err: i32 = 0
    loop
        let nread: i64 = sys_read(src_fd, @buf[0], 8192)
        if nread < 0
            err = -(nread as i32)
            break
        if nread == 0
            break
        err = fs_write_all(dest_fd, @buf[0], nread)
        if err != 0
            break
        total += nread

    sys_close(src_fd)
    sys_close(dest_fd)
    if err != 0
        return Err(errno_from_raw(err))
    Ok(total)

# Map a raw syscall return (0 or -errno) to Result<i32, Errno>.
fn fs_unit(ret: i32) -> Result<i32, Errno>
    if ret < 0
        return Err(errno_from_raw(ret))
    Ok(0)

# Create directory `path` with `mode` (e.g. 493 = 0755). EEXIST if present.
pub fn mkdir(path: StrView, mode: i32) -> Result<i32, Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_unit(sys_mkdir(@cpath[0], mode))

# Remove the (non-directory) entry at `path`.
pub fn unlink(path: StrView) -> Result<i32, Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_unit(sys_unlink(@cpath[0]))

# Remove the empty directory at `path`.
pub fn rmdir(path: StrView) -> Result<i32, Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_unit(sys_rmdir(@cpath[0]))

# ============================================================================
# Paths, permissions, cwd -> Result<_, Errno> (AGAST #4637)
# ============================================================================
#
#   access(path, mode) / chdir / rename / chmod / symlink -> Result<(), Errno>
#   cwd() / read_link(path) -> Result<String, Errno>
#   set_times(path, atime: FileTime, mtime: FileTime) -> Result<(), Errno>
#
# Each takes StrView paths; a path of FS_PATH_MAX bytes or more is
# Err(NameTooLong) without a syscall.

# Map a raw syscall return (0 or -errno) to Result<(), Errno>.
fn fs_done(ret: i32) -> Result<(), Errno>
    if ret < 0
        return Err(errno_from_raw(ret))
    Ok(())

# Whether `path` permits `mode`: F_OK (exists), or R_OK + W_OK + X_OK
# summed, checked against the real uid as access(2) does.
pub fn access(path: StrView, mode: i32) -> Result<(), Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_done(sys_access(@cpath[0], mode))

# Change this process's working directory.
pub fn chdir(path: StrView) -> Result<(), Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_done(sys_chdir(@cpath[0]))

# Move `from` to `to` (rename(2)), replacing a file at `to`. Err(Other(18))
# (EXDEV) across filesystems: copy_file then unlink instead.
pub fn rename(from: StrView, to: StrView) -> Result<(), Errno>
    var cfrom: [4096]u8
    var cto: [4096]u8
    let ferr: i32 = fs_path_cstr(from, @cfrom[0])
    if ferr != 0
        return Err(errno_from_raw(ferr))
    let terr: i32 = fs_path_cstr(to, @cto[0])
    if terr != 0
        return Err(errno_from_raw(terr))
    fs_done(sys_rename(@cfrom[0], @cto[0]))

# Set the permission bits of `path` (chmod(2)), e.g. 493 = 0755.
pub fn chmod(path: StrView, mode: i32) -> Result<(), Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    fs_done(sys_chmod(@cpath[0], mode))

# Create a symbolic link at `link` whose contents are `target` (which need
# not exist).
pub fn symlink(target: StrView, link: StrView) -> Result<(), Errno>
    var ctarget: [4096]u8
    var clink: [4096]u8
    let terr: i32 = fs_path_cstr(target, @ctarget[0])
    if terr != 0
        return Err(errno_from_raw(terr))
    let lerr: i32 = fs_path_cstr(link, @clink[0])
    if lerr != 0
        return Err(errno_from_raw(lerr))
    fs_done(sys_symlink(@ctarget[0], @clink[0]))

# The current working directory, an absolute path.
pub fn cwd() -> Result<String, Errno>
    var buf: [4096]u8
    # getcwd(2) returns the length including the NUL.
    let n: i64 = sys_getcwd(@buf[0], 4096)
    if n < 0
        return Err(errno_from_raw(n as i32))
    var len: i64 = n
    if len > 0 and buf[len - 1] == 0
        len -= 1
    var out: String = string_with_cap(len + 1)
    out.push_span(Span<u8> { ptr: @buf[0], len: len })
    Ok(out)

# The contents of the symbolic link at `path` (readlink(2)): Err(Inval) if
# `path` is not a symlink.
pub fn read_link(path: StrView) -> Result<String, Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    var buf: [4096]u8
    let n: i64 = sys_readlink(@cpath[0], @buf[0], 4096)
    if n < 0
        return Err(errno_from_raw(n as i32))
    # readlink(2) truncates silently: a full buffer may have lost bytes.
    if n >= 4096
        return Err(Errno.NameTooLong)
    var out: String = string_with_cap(n + 1)
    out.push_span(Span<u8> { ptr: @buf[0], len: n })
    Ok(out)

# One timestamp for set_times: the current time, unchanged, or a moment in
# nanoseconds since the Unix epoch.
pub enum FileTime
    Now
    Omit
    At(i64)

# Fill one utimensat(2) timespec slot (two i64s at `ts`) from `t`.
fn fs_timespec(t: FileTime, ts: @&[2]i64)
    match t
        Now =>
            ts[0] = 0
            ts[1] = UTIME_NOW
        Omit =>
            ts[0] = 0
            ts[1] = UTIME_OMIT
        At(ns) =>
            ts[0] = ns / 1000000000
            ts[1] = ns % 1000000000

# Set the access and modification times of `path` (utimensat(2), following
# symlinks). `touch` is set_times(path, FileTime.Now, FileTime.Now).
pub fn set_times(path: StrView, atime: FileTime, mtime: FileTime) -> Result<(), Errno>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(errno_from_raw(perr))
    var a: [2]i64
    var m: [2]i64
    fs_timespec(atime, @&a)
    fs_timespec(mtime, @&m)
    var times: [4]i64
    times[0] = a[0]
    times[1] = a[1]
    times[2] = m[0]
    times[3] = m[1]
    fs_done(sys_utimensat(at_fdcwd(), @cpath[0], @times[0], 0))

# ============================================================================
# Directory Iteration
# ============================================================================
# High-level directory iteration API using getdents64.
#
# Usage:
#     var dir: DirIter = match dir_open("/path/to/dir")
#         Ok(d) => d
#         Err(e) => return ...                # NoEnt, NotDir, Acces, ...
#     while dir_next(@dir)
#         let e: DirEntry = dir_entry(@dir)   # e.ino, e.kind, e.name (StrView)
#         # process entry...
#     dir_close(@dir)
#
# entry_type() is the Option<u8> accessor for the raw d_type; dir.entry()
# is the typed entry. dir.entry().name replaces the removed *u8
# dir_entry_name (it returned null with no current entry).

const DIR_BUF_SIZE: i64 = 4096

# `buf` is a heap block of DIR_BUF_SIZE, not an inline array. DirIter is
# returned by value inside Result; a 4096-byte field makes that aggregate
# about 4 KB, and clang's instruction selection then takes about a minute
# on dir_open and on every caller. dir_close frees the block. A copy of a
# DirIter aliases the same block; close it once.
pub struct DirIter
    fd: i32              # Directory file descriptor
    buf: *u8             # getdents64 buffer, or null once closed
    buf_pos: i64         # Current position in buffer
    buf_len: i64         # Bytes read into buffer
    entry: *u8           # Current entry pointer

# Open a directory for iteration; Err (NoEnt, NotDir, Acces, ...) if it
# cannot be opened. Release the Ok iterator with dir_close.
# standard-exempt: raw-alloc: getdents buffer owned by DirIter, freed in close
pub fn dir_open(path: StrView) -> Result<DirIter, Errno>
    let fd: i32 = fs_open(path, O_RDONLY + O_DIRECTORY, 0)
    if fd < 0
        return Err(errno_from_raw(fd))
    let buf: *u8 = malloc(DIR_BUF_SIZE)
    if buf == null
        sys_close(fd)
        return Err(Errno.NoMem)
    var dir: DirIter
    dir.fd = fd
    dir.buf = buf
    dir.buf_pos = 0
    dir.buf_len = 0
    dir.entry = null
    Ok(dir)

# Advance to the next record; true if `dir.entry` now points at one, false at
# the end. Shared by dir_next and dir_next_entry. It takes @&DirIter and only
# touches fields, because ritz1 cannot forward an @&T parameter into a *T one
# (AGAST #1652).
fn dir_advance(dir: @&DirIter) -> bool
    # Closed: fd < 0 and buf already freed. Do not hand getdents a null pointer.
    if dir.fd < 0 or dir.buf == null
        dir.entry = null
        return false

    # Need more data?
    if dir.buf_pos >= dir.buf_len
        # Read next batch of entries
        dir.buf_len = sys_getdents64(dir.fd, dir.buf, DIR_BUF_SIZE)
        dir.buf_pos = 0

        if dir.buf_len <= 0
            dir.entry = null
            return false

    # Point to current entry
    dir.entry = dir.buf + dir.buf_pos

    # Advance position for next call
    let d: *Dirent64 = dir.entry as *Dirent64
    let reclen: i32 = d.d_reclen as i32
    dir.buf_pos = dir.buf_pos + reclen as i64

    true

# Methods (S-IMPL-1): a DirIter is the subject of every operation on it.
impl DirIter
    # Advance to next directory entry.
    # Returns true if an entry is available, false if done.
    pub fn next(self: @&DirIter) -> bool
        dir_advance(self)

    # The current entry as a typed DirEntry. Only valid after next() returns
    # true; before that (or after the end) it is { ino: 0, kind: DT_UNKNOWN,
    # name: "" }. Prefer next_entry, which cannot be consulted out of order.
    pub fn entry(self: @DirIter) -> DirEntry
        if self.entry == null
            return DirEntry { ino: 0, kind: DT_UNKNOWN, name: strview_empty() }
        let d: *Dirent64 = self.entry as *Dirent64
        let name: *u8 = self.entry + DIRENT_NAME_OFFSET
        DirEntry { ino: d.d_ino, kind: d.d_type, name: strview_from_cstr(name) }

    # Advance and return the next entry, or None when the directory is exhausted
    # (or was never opened). The entry's name borrows the iterator's buffer.
    #
    #     loop
    #         match dir.next_entry()
    #             Some(e) => handle(@e)
    #             None => break
    pub fn next_entry(self: @&DirIter) -> Option<DirEntry>
        # A closed iterator (fd < 0, buffer freed) ends here too.
        if not dir_advance(self)
            return None
        let d: *Dirent64 = self.entry as *Dirent64
        let name: *u8 = self.entry + DIRENT_NAME_OFFSET
        Some(DirEntry { ino: d.d_ino, kind: d.d_type, name: strview_from_cstr(name) })

    # Type of the current entry: Some(DT_REG), Some(DT_DIR), etc. from sys.ritz;
    # None when there is no current entry (before next(), or after the end).
    pub fn entry_type(self: @DirIter) -> Option<u8>
        if self.entry == null
            return None
        let d: *Dirent64 = self.entry as *Dirent64
        Some(d.d_type)

    # Check if current entry is a directory.
    pub fn entry_is_dir(self: @DirIter) -> bool
        match self.entry_type()
            Some(t) => t == DT_DIR
            None => false

    # Check if current entry is a regular file.
    pub fn entry_is_file(self: @DirIter) -> bool
        match self.entry_type()
            Some(t) => t == DT_REG
            None => false

    # Check if current entry is a symlink.
    pub fn entry_is_link(self: @DirIter) -> bool
        match self.entry_type()
            Some(t) => t == DT_LNK
            None => false

    # Close the directory iterator and free its getdents buffer.
    # A second close is a no-op.
    pub fn close(self: @&DirIter)
        if self.fd >= 0
            sys_close(self.fd)
            self.fd = -1
        if self.buf != null
            free(self.buf)
            self.buf = null
        self.entry = null

# ============================================================================
# remove_dir_all -> Result<(), Errno> (AGAST #4637)
# ============================================================================

# Remove the directory at `path` and everything under it. Symlinks are
# removed, never followed, so nothing outside the tree is touched. Err(NotDir)
# if `path` is not a directory (use unlink); the first other error stops the
# walk and is returned, leaving what remains in place.
pub fn remove_dir_all(path: StrView) -> Result<(), Errno>
    var dir: DirIter
    match dir_open(path)
        Ok(d) => dir = d
        Err(e) => return Err(e)
    var failed: Option<Errno> = None
    loop
        match dir.next_entry()
            Some(e) =>
                if e.name.eq(".") or e.name.eq("..")
                    continue
                let child: String = path_join(path, e.name)
                var is_tree: bool = e.kind == DT_DIR
                # Some filesystems report DT_UNKNOWN: ask lstat (no follow).
                if e.kind == DT_UNKNOWN
                    is_tree = is_dir(child.as_view())
                var r: Result<(), Errno> = Ok(())
                if is_tree
                    r = remove_dir_all(child.as_view())
                else
                    match unlink(child.as_view())
                        Ok(_) => pass
                        Err(err) => r = Err(err)
                match r
                    Ok(_) => pass
                    Err(err) =>
                        failed = Some(err)
                        break
            None => break
    dir.close()
    match failed
        Some(err) => return Err(err)
        None => pass
    match rmdir(path)
        Ok(_) => Ok(())
        Err(err) => Err(err)
