# ritzlib/fs.ritz - Filesystem utility functions
#
# High-level filesystem operations built on sys.ritz syscalls.
#
# String-based API with Result error handling for safety.
# Legacy *u8 functions kept for backward compatibility.
#
# Note: Stat struct and STAT_SIZE are defined in ritzlib/sys.ritz

import ritzlib.sys
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.option

# ============================================================================
# stat / lstat -> Result<Stat, i32>
# ============================================================================
# `Stat` is the kernel's x86_64 `struct stat`, declared once in ritzlib/sys.ritz
# (st_dev @0, st_ino @8, st_nlink @16, st_mode @24, st_uid @28, st_gid @32,
# st_size @48, st_blksize @56, st_blocks @64; 144 bytes). fs reuses it rather
# than declaring a second type.
#
#     match stat("/etc/passwd")
#         Ok(st) => print_int(st.st_size)
#         Err(errno) => ...            # positive errno, e.g. 2 = ENOENT
#
# Err carries the positive kernel errno. A path longer than FS_PATH_MAX
# (PATH_MAX, 4096 including the NUL) fails with ENAMETOOLONG (36) without a
# syscall.

const FS_PATH_MAX: i64 = 4096
const FS_ENAMETOOLONG: i32 = 36

# Copy a (ptr, len) path into `buf` and NUL-terminate it. A StrView carries no
# terminator, so it cannot be handed to the kernel directly.
# Returns 0 on success, FS_ENAMETOOLONG if it does not fit.
fn fs_path_cstr(path: @StrView, buf: *u8) -> i32
    if path.len >= FS_PATH_MAX
        return FS_ENAMETOOLONG
    for i in 0..path.len
        *(buf + i) = *(path.ptr + i)
    *(buf + path.len) = 0
    0

# Shared body of stat/lstat. `follow` selects stat(2) (1) or lstat(2) (0).
fn fs_stat_impl(path: @StrView, follow: i32) -> Result<Stat, i32>
    var cpath: [4096]u8
    let perr: i32 = fs_path_cstr(path, @cpath[0])
    if perr != 0
        return Err(perr)
    var st: Stat
    var ret: i32 = 0
    if follow != 0
        ret = sys_stat2(@cpath[0], @st)
    else
        ret = sys_lstat2(@cpath[0], @st)
    if ret < 0
        return Err(-ret)
    Ok(st)

# Status of the file at `path`, following symlinks.
pub fn stat(path: StrView) -> Result<Stat, i32>
    fs_stat_impl(@path, 1)

# Status of the file at `path`; a symlink is reported as itself.
pub fn lstat(path: StrView) -> Result<Stat, i32>
    fs_stat_impl(@path, 0)

# ============================================================================
# Stat buffer accessors (legacy)
# ============================================================================
# Kept for code that still stats into a raw [144]u8. They read through the
# Stat struct, so the field offsets live in one place (sys.ritz).
# New code: `stat(path)` / `lstat(path)` and the Stat fields.

pub fn stat_get_dev(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_dev

pub fn stat_get_ino(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_ino

pub fn stat_get_nlink(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_nlink

pub fn stat_get_mode(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_mode

pub fn stat_get_uid(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_uid

pub fn stat_get_gid(statbuf: *u8) -> i32
    let st: *Stat = statbuf as *Stat
    st.st_gid

pub fn stat_get_size(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_size

pub fn stat_get_blksize(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_blksize

pub fn stat_get_blocks(statbuf: *u8) -> i64
    let st: *Stat = statbuf as *Stat
    st.st_blocks

# ============================================================================
# File type helpers
# ============================================================================

pub fn mode_is_dir(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 4) as i32

pub fn mode_is_file(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 8) as i32

pub fn mode_is_link(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == '\n') as i32

pub fn mode_is_char(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 2) as i32

pub fn mode_is_block(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 6) as i32

pub fn mode_is_fifo(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 1) as i32

pub fn mode_is_socket(mode: i32) -> i32
    let type_bits: i32 = mode / 4096
    return (type_bits == 12) as i32

# ============================================================================
# Path checking
# ============================================================================

pub fn path_exists(path: *u8) -> i32
    var statbuf: [144]u8
    return (sys_lstat(path, @statbuf[0]) == 0) as i32

pub fn is_directory(path: *u8) -> i32
    var statbuf: [144]u8
    if sys_lstat(path, @statbuf[0]) != 0
        return 0
    return mode_is_dir(stat_get_mode(@statbuf[0]))

pub fn is_regular_file(path: *u8) -> i32
    var statbuf: [144]u8
    if sys_lstat(path, @statbuf[0]) != 0
        return 0
    return mode_is_file(stat_get_mode(@statbuf[0]))

pub fn is_symlink(path: *u8) -> i32
    var statbuf: [144]u8
    if sys_lstat(path, @statbuf[0]) != 0
        return 0
    return mode_is_link(stat_get_mode(@statbuf[0]))

pub fn file_size(path: *u8) -> i64
    var statbuf: [144]u8
    if sys_lstat(path, @statbuf[0]) != 0
        return -1
    return stat_get_size(@statbuf[0])

# ============================================================================
# Dirent helpers (getdents64 structure)
# ============================================================================
# struct linux_dirent64 {
#   u64 d_ino;           // 0: 8 bytes
#   u64 d_off;           // 8: 8 bytes
#   u16 d_reclen;        // 16: 2 bytes
#   u8  d_type;          // 18: 1 byte
#   char d_name[];       // 19: variable
# }
#
# The fixed part is sys.ritz's Dirent64. A DirEntry is the decoded, typed view
# of one record: `name` points into the DirIter's buffer, so it is valid only
# until the next dir_next/dir_next_entry or dir_close on that iterator.

pub struct DirEntry
    ino: i64             # inode number
    kind: u8             # DT_REG, DT_DIR, DT_LNK, ... (sys.ritz)
    name: StrView        # entry name, without the trailing NUL

const DIRENT_NAME_OFFSET: i64 = 19

# Built field by field rather than as `DirEntry { .., name: strview_..() }`:
# ritz1 drops a struct-valued field of a struct literal (it GEPs the field and
# never stores to it), which leaves `name` uninitialised (AGAST #1655).
fn direntry_make(ino: i64, kind: u8, name: *u8, name_len: i64) -> DirEntry
    var e: DirEntry
    e.ino = ino
    e.kind = kind
    e.name.ptr = name
    e.name.len = name_len
    e

# Decode the linux_dirent64 record at `entry`.
pub fn dirent_entry(entry: *u8) -> DirEntry
    let d: *Dirent64 = entry as *Dirent64
    let name: *u8 = entry + DIRENT_NAME_OFFSET
    direntry_make(d.d_ino, d.d_type, name, strlen(name))

pub fn dirent_get_ino(entry: *u8) -> i64
    let d: *Dirent64 = entry as *Dirent64
    d.d_ino

pub fn dirent_get_reclen(entry: *u8) -> i32
    let d: *Dirent64 = entry as *Dirent64
    d.d_reclen as i32

# Legacy: prefer dirent_entry(entry).kind.
pub fn dirent_get_type(entry: *u8) -> u8
    let d: *Dirent64 = entry as *Dirent64
    d.d_type

# Legacy: prefer dirent_entry(entry).name (a StrView). Same pointer, but this
# form skips the strlen that building the view costs.
pub fn dirent_get_name(entry: *u8) -> *u8
    entry + DIRENT_NAME_OFFSET

# Note: DT_* constants are defined in ritzlib/sys.ritz

# ============================================================================
# Path utilities
# ============================================================================

pub fn path_join(dir: *u8, name: *u8, buf: *u8) -> i64
    var pos: i64 = 0
    var i: i64 = 0

    # Copy directory
    while *(dir + i) != 0
        *(buf + pos) = *(dir + i)
        pos += 1
        i += 1

    # Add separator if needed
    if pos > 0 and *(buf + pos - 1) != 47
        *(buf + pos) = 47  # '/'
        pos += 1

    # Copy name
    i = 0
    while *(name + i) != 0
        *(buf + pos) = *(name + i)
        pos += 1
        i += 1

    *(buf + pos) = 0
    return pos

pub fn path_basename(path: *u8) -> *u8
    var last_slash: *u8 = null
    var i: i64 = 0
    while *(path + i) != 0
        if *(path + i) == '/'
            last_slash = path + i
        i += 1
    if last_slash != null
        return last_slash + 1
    return path

pub fn path_dirname(path: *u8, buf: *u8) -> *u8
    var last_slash: i64 = -1
    var i: i64 = 0
    while *(path + i) != 0
        if *(path + i) == '/'
            last_slash = i
        i += 1

    if last_slash < 0
        # No slash, dirname is "."
        *buf = 46
        *(buf + 1) = 0
        return buf

    if last_slash == 0
        # Root
        *buf = 47
        *(buf + 1) = 0
        return buf

    # Copy up to last slash
    for i in 0..last_slash
        *(buf + i) = *(path + i)
    *(buf + i) = 0
    return buf

# ============================================================================
# Copy file helper
# ============================================================================

pub fn copy_file(src: *u8, dest: *u8, mode: i32) -> i32
    let src_fd: i32 = sys_open(src, O_RDONLY)
    if src_fd < 0
        return -1

    # O_WRONLY | O_CREAT | O_TRUNC = 1 + 64 + 512 = 577
    let dest_fd: i32 = sys_open3(dest, 577, mode)
    if dest_fd < 0
        sys_close(src_fd)
        return -1

    var buf: [8192]u8
    var result: i32 = 0

    loop
        let nread: i64 = sys_read(src_fd, @buf[0], 8192)
        if nread < 0
            result = -1
            break
        if nread == 0
            break

        var written: i64 = 0
        while written < nread
            let n: i64 = sys_write(dest_fd, @buf[0] + written, nread - written)
            if n <= 0
                result = -1
                break
            written += n
        if result != 0
            break

    sys_close(src_fd)
    sys_close(dest_fd)
    return result

# ============================================================================
# String-based path utilities (no null-termination dependency)
# ============================================================================

# Join two path components into a new String.
pub fn path_join_string(dir: *String, name: *String) -> String
    var result: String = string_clone(dir)

    # Add separator if needed
    let dir_len: i64 = string_len(dir)
    if dir_len > 0 and string_char_at(dir, dir_len - 1) != 47  # '/'
        string_push(@result, 47)

    # Append name
    string_push_string(@result, name)
    return result

# Get the filename component from a path (after last '/').
pub fn path_basename_string(path: *String) -> String
    let len: i64 = string_len(path)
    var last_slash: i64 = -1

    for i in 0..len
        if string_char_at(path, i) == '/'  # '/'
            last_slash = i

    if last_slash < 0
        return string_clone(path)

    return string_slice(path, last_slash + 1, len)

# Get the directory component from a path (before last '/').
pub fn path_dirname_string(path: *String) -> String
    let len: i64 = string_len(path)
    var last_slash: i64 = -1

    for i in 0..len
        if string_char_at(path, i) == '/'  # '/'
            last_slash = i

    if last_slash < 0
        # No slash - return "."
        return string_from(".")

    if last_slash == 0
        # Root - return "/"
        return string_from("/")

    return string_slice(path, 0, last_slash)

# Get file extension (after last '.', or empty if none).
pub fn path_extension_string(path: *String) -> String
    let len: i64 = string_len(path)
    var last_dot: i64 = -1
    var last_slash: i64 = -1

    for i in 0..len
        let c: u8 = string_char_at(path, i)
        if c == '/'  # '/'
            last_slash = i
        else if c == '.'  # '.'
            last_dot = i

    # No dot, or dot before last slash, or dot at start of basename
    if last_dot < 0 or last_dot < last_slash or last_dot == last_slash + 1
        return string_new()

    return string_slice(path, last_dot + 1, len)

# Strip extension from path.
pub fn path_stem_string(path: *String) -> String
    let len: i64 = string_len(path)
    var last_dot: i64 = -1
    var last_slash: i64 = -1

    for i in 0..len
        let c: u8 = string_char_at(path, i)
        if c == '/'  # '/'
            last_slash = i
        else if c == '.'  # '.'
            last_dot = i

    # No dot, or dot before last slash, or dot at start of basename
    if last_dot < 0 or last_dot < last_slash or last_dot == last_slash + 1
        return string_clone(path)

    return string_slice(path, 0, last_dot)

# ============================================================================
# File operations with String paths and Result types
# ============================================================================

# Error codes for filesystem operations
const FS_ERR_NOT_FOUND: i32 = 1
const FS_ERR_PERMISSION: i32 = 2
const FS_ERR_IO: i32 = 3
const FS_ERR_NOT_DIR: i32 = 4
const FS_ERR_IS_DIR: i32 = 5
const FS_ERR_EXISTS: i32 = 6
const FS_ERR_UNKNOWN: i32 = 99

# Check if path exists (String version).
pub fn path_exists_string(path: *String) -> i32
    var statbuf: [144]u8
    # Need to null-terminate for syscall
    let cstr: *u8 = string_as_ptr(path)
    return (sys_lstat(cstr, @statbuf[0]) == 0) as i32

# Check if path is a directory (String version).
pub fn is_directory_string(path: *String) -> i32
    var statbuf: [144]u8
    let cstr: *u8 = string_as_ptr(path)
    if sys_lstat(cstr, @statbuf[0]) != 0
        return 0
    return mode_is_dir(stat_get_mode(@statbuf[0]))

# Check if path is a regular file (String version).
pub fn is_regular_file_string(path: *String) -> i32
    var statbuf: [144]u8
    let cstr: *u8 = string_as_ptr(path)
    if sys_lstat(cstr, @statbuf[0]) != 0
        return 0
    return mode_is_file(stat_get_mode(@statbuf[0]))

# Get file size with Result error handling.
pub fn file_size_string(path: *String) -> Result<i64, i32>
    var statbuf: [144]u8
    let cstr: *u8 = string_as_ptr(path)
    if sys_lstat(cstr, @statbuf[0]) != 0
        return Err(FS_ERR_NOT_FOUND)
    return Ok(stat_get_size(@statbuf[0]))

# Read entire file contents into a String.
# Returns error code (0 = success, negative = error).
# TODO: Migrate to Result<String, i32> now that struct-in-enum works.
pub fn read_file_string(path: *String, out: *String) -> i32
    let cstr: *u8 = string_as_ptr(path)
    let fd: i32 = sys_open(cstr, O_RDONLY)
    if fd < 0
        return -FS_ERR_NOT_FOUND

    # Get file size first
    var statbuf: [144]u8
    if sys_fstat(fd, @statbuf[0]) != 0
        sys_close(fd)
        return -FS_ERR_IO

    # Ensure capacity
    string_clear(out)

    # Read in chunks
    var buf: [4096]u8
    loop
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n < 0
            sys_close(fd)
            return -FS_ERR_IO
        if n == 0
            break
        for i in 0..n
            string_push(out, buf[i])

    sys_close(fd)
    return 0

# Write string contents to a file, creating it if needed.
# Returns Err on permission error or write failure.
pub fn write_file_string(path: *String, content: *String) -> Result<i64, i32>
    let cstr: *u8 = string_as_ptr(path)
    # O_WRONLY | O_CREAT | O_TRUNC = 1 + 64 + 512 = 577
    let fd: i32 = sys_open3(cstr, 577, 420)  # 0644 octal = 420 decimal
    if fd < 0
        return Err(FS_ERR_PERMISSION)

    let data: *u8 = string_as_ptr(content)
    let len: i64 = string_len(content)
    var written: i64 = 0

    while written < len
        let n: i64 = sys_write(fd, data + written, len - written)
        if n <= 0
            sys_close(fd)
            return Err(FS_ERR_IO)
        written += n

    sys_close(fd)
    return Ok(written)

# Create a directory with the given mode.
# Returns 0 on success, or negative error code.
pub fn mkdir_string(path: *String, mode: i32) -> i32
    let cstr: *u8 = string_as_ptr(path)
    let ret: i32 = sys_mkdir(cstr, mode)
    if ret < 0
        if ret == -17  # EEXIST
            return -FS_ERR_EXISTS
        return -FS_ERR_PERMISSION
    return 0

# Remove a file.
# Returns 0 on success, or negative error code.
pub fn unlink_string(path: *String) -> i32
    let cstr: *u8 = string_as_ptr(path)
    let ret: i32 = sys_unlink(cstr)
    if ret < 0
        if ret == -2  # ENOENT
            return -FS_ERR_NOT_FOUND
        if ret == -21  # EISDIR
            return -FS_ERR_IS_DIR
        return -FS_ERR_PERMISSION
    return 0

# Remove an empty directory.
# Returns 0 on success, or negative error code.
pub fn rmdir_string(path: *String) -> i32
    let cstr: *u8 = string_as_ptr(path)
    let ret: i32 = sys_rmdir(cstr)
    if ret < 0
        if ret == -2  # ENOENT
            return -FS_ERR_NOT_FOUND
        if ret == -20  # ENOTDIR
            return -FS_ERR_NOT_DIR
        return -FS_ERR_PERMISSION
    return 0

# Copy a file to a new location.
pub fn copy_file_string(src: *String, dest: *String, mode: i32) -> Result<i64, i32>
    let src_cstr: *u8 = string_as_ptr(src)
    let dest_cstr: *u8 = string_as_ptr(dest)

    let src_fd: i32 = sys_open(src_cstr, O_RDONLY)
    if src_fd < 0
        return Err(FS_ERR_NOT_FOUND)

    # O_WRONLY | O_CREAT | O_TRUNC = 577
    let dest_fd: i32 = sys_open3(dest_cstr, 577, mode)
    if dest_fd < 0
        sys_close(src_fd)
        return Err(FS_ERR_PERMISSION)

    var buf: [8192]u8
    var total: i64 = 0

    loop
        let nread: i64 = sys_read(src_fd, @buf[0], 8192)
        if nread < 0
            sys_close(src_fd)
            sys_close(dest_fd)
            return Err(FS_ERR_IO)
        if nread == 0
            break

        var written: i64 = 0
        while written < nread
            let n: i64 = sys_write(dest_fd, @buf[0] + written, nread - written)
            if n <= 0
                sys_close(src_fd)
                sys_close(dest_fd)
                return Err(FS_ERR_IO)
            written += n
        total += written

    sys_close(src_fd)
    sys_close(dest_fd)
    return Ok(total)

# ============================================================================
# Directory Iteration
# ============================================================================
# High-level directory iteration API using getdents64.
#
# Usage:
#     var dir: DirIter = dir_open(c"/path/to/dir")
#     while dir_next(@dir)
#         let e: DirEntry = dir_entry(@dir)   # e.ino, e.kind, e.name (StrView)
#         # process entry...
#     dir_close(@dir)
#
# dir_entry_name / dir_entry_type are the older *u8 / u8 accessors.

const DIR_BUF_SIZE: i64 = 4096

pub struct DirIter
    fd: i32              # Directory file descriptor
    buf: [4096]u8        # Buffer for getdents64
    buf_pos: i64         # Current position in buffer
    buf_len: i64         # Bytes read into buffer
    entry: *u8           # Current entry pointer

# Open a directory for iteration.
# Returns a DirIter - check with dir_valid() before using.
pub fn dir_open(path: *u8) -> DirIter
    var dir: DirIter
    dir.fd = sys_open(path, O_RDONLY + O_DIRECTORY)
    dir.buf_pos = 0
    dir.buf_len = 0
    dir.entry = null
    dir

# Open a directory for iteration (String version).
pub fn dir_open_string(path: *String) -> DirIter
    let cstr: *u8 = string_as_ptr(path)
    dir_open(cstr)

# Check if directory was opened successfully.
pub fn dir_valid(dir: *DirIter) -> i32
    (dir.fd >= 0) as i32

# Advance to the next record; 1 if `dir.entry` now points at one, 0 at the end.
# Shared by dir_next and dir_next_entry. It takes @&DirIter and only touches
# fields, because ritz1 cannot forward an @&T parameter into a *T one
# (AGAST #1652).
fn dir_advance(dir: @&DirIter) -> i32
    # Need more data?
    if dir.buf_pos >= dir.buf_len
        # Read next batch of entries
        dir.buf_len = sys_getdents64(dir.fd, @dir.buf[0], DIR_BUF_SIZE)
        dir.buf_pos = 0

        if dir.buf_len <= 0
            dir.entry = null
            return 0

    # Point to current entry
    dir.entry = @dir.buf[0] + dir.buf_pos

    # Advance position for next call
    let reclen: i32 = dirent_get_reclen(dir.entry)
    dir.buf_pos = dir.buf_pos + reclen as i64

    1

# Advance to next directory entry.
# Returns 1 if an entry is available, 0 if done.
pub fn dir_next(dir: *DirIter) -> i32
    dir_advance(dir)

# The current entry as a typed DirEntry. Only valid after dir_next() returns 1;
# before that (or after the end) it is { ino: 0, kind: DT_UNKNOWN, name: "" }.
pub fn dir_entry(dir: @DirIter) -> DirEntry
    if dir.entry == null
        return direntry_make(0, DT_UNKNOWN, null, 0)
    dirent_entry(dir.entry)

# Advance and return the next entry, or None when the directory is exhausted
# (or was never opened). The entry's name borrows the iterator's buffer.
#
#     loop
#         var next: Option<DirEntry> = dir_next_entry(@&dir)
#         if option_is_none<DirEntry>(@next) == 1
#             break
#         match next
#             Some(e) => handle(@e)        # handle returns a value, see #1654
#             None => 0
pub fn dir_next_entry(dir: @&DirIter) -> Option<DirEntry>
    # An unopened iterator (fd < 0) ends here too: getdents64 fails, buf_len <= 0.
    if dir_advance(dir) == 0
        return None
    Some(dirent_entry(dir.entry))

# Get name of current entry.
# Only valid after dir_next() returns 1.
pub fn dir_entry_name(dir: *DirIter) -> *u8
    if dir.entry == null
        return null
    dirent_get_name(dir.entry)

# Get type of current entry.
# Returns DT_REG, DT_DIR, etc. from sys.ritz
pub fn dir_entry_type(dir: *DirIter) -> u8
    if dir.entry == null
        return 0
    dirent_get_type(dir.entry)

# Check if current entry is a directory.
pub fn dir_entry_is_dir(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_DIR) as i32

# Check if current entry is a regular file.
pub fn dir_entry_is_file(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_REG) as i32

# Check if current entry is a symlink.
pub fn dir_entry_is_link(dir: *DirIter) -> i32
    (dir_entry_type(dir) == DT_LNK) as i32

# Close the directory iterator.
pub fn dir_close(dir: *DirIter)
    if dir.fd >= 0
        sys_close(dir.fd)
        dir.fd = -1
