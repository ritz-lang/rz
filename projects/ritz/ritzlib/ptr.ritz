# ritzlib/ptr.ritz - reads through a raw pointer that take ownership
#
# `*p` of a move-only value is "cannot move out of a reference" (LANGUAGE_SPEC
# §13.2). Container code, which keeps its elements in raw memory, reads them
# with ptr_read instead.

# A bitwise read of `*p`. The caller owns the result, and the memory at `p`
# stops being a value: reading it again, or dropping it, is a double drop.
pub fn ptr_read<T>(p: *T) -> T
    var out: T
    let d: *u8 = @out as *u8
    let s: *u8 = p as *u8
    var i: i64 = 0
    while i < sizeof(T)
        *(d + i) = *(s + i)
        i = i + 1
    return out
