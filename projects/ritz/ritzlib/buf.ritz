# ritzlib/buf.ritz - Buffer and reader utilities for parsing
#
# Provides buffered input streams with lookahead, essential for parsers.
#
# Types:
# - Buffer: Read-only view into byte data with position tracking (does not own memory)
# - GrowBuf: Growable byte buffer for accumulating data (type alias for Vec<u8>)
#
# GrowBuf is now backed by Vec<u8> with automatic Drop cleanup.
#
# API shape (#1478):
# - Text goes in as a StrView ("..." literals are StrViews) and comes out as a
#   StrView slice of the underlying bytes: zero-copy, never truncated.
#       var b = buf_new("key = value")
#       let key: StrView = buf_take_ident(@&b)
# - The one read that must decode (buf_take_quoted) appends to an @&String.
# - Predicates return bool; buf_take_while / buf_skip_while take a typed
#   `fn(u8) -> bool` (buf_is_digit, buf_is_ident, buf_is_space, or your own).
# - Receivers are @Buffer / @GrowBuf when read-only and @&Buffer / @&GrowBuf
#   when they move the cursor or mutate; a local passes as @b either way.
# - buf_init(*u8, len) and growbuf_data() remain for C interop.
#
# DEPRECATED, kept for one release after #1478: the caller-sized out-buffer
# forms buf_peek_n, buf_read_until, buf_read_while_digit,
# buf_read_while_alnum and buf_read_quoted.  They NUL-terminate inside
# max_len and silently truncate.  Use buf_peek_view / buf_take_* instead.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.drop
import ritzlib.strview
import ritzlib.string

# ============================================================================
# Buffer: In-memory byte buffer with position tracking
# ============================================================================

struct Buffer
    data: *u8       # Pointer to data (not owned)
    len: i64        # Length of data
    pos: i64        # Current read position

pub fn buf_init(buf: @&Buffer, data: *u8, len: i64) -> i32
    buf.data = data
    buf.len = len
    buf.pos = 0
    return 0

# Point `buf` at the bytes of `s` (a "..." literal is a StrView).
pub fn buf_from_str(buf: @&Buffer, s: StrView) -> i32
    buf.data = s.ptr
    buf.len = s.len
    buf.pos = 0
    return 0

# A cursor at the start of `s`.  The Buffer borrows s's bytes; it must not
# outlive them.
pub fn buf_new(s: StrView) -> Buffer
    var buf: Buffer
    buf.data = s.ptr
    buf.len = s.len
    buf.pos = 0
    return buf

# ============================================================================
# Position and bounds
# ============================================================================

pub fn buf_pos(buf: @Buffer) -> i64
    return buf.pos

pub fn buf_len(buf: @Buffer) -> i64
    return buf.len

pub fn buf_remaining(buf: @Buffer) -> i64
    return buf.len - buf.pos

pub fn buf_eof(buf: @Buffer) -> bool
    return buf.pos >= buf.len

# The unread bytes, as a slice (does not advance).
pub fn buf_rest(buf: @Buffer) -> StrView
    if buf.pos >= buf.len
        return strview_from_ptr(buf.data + buf.len, 0)
    return strview_from_ptr(buf.data + buf.pos, buf.len - buf.pos)

# ============================================================================
# Peek operations (don't advance position)
# ============================================================================

pub fn buf_peek(buf: @Buffer) -> u8
    if buf.pos >= buf.len
        return 0
    return *(buf.data + buf.pos)

pub fn buf_peek_at(buf: @Buffer, offset: i64) -> u8
    let pos: i64 = buf.pos + offset
    if pos < 0 or pos >= buf.len
        return 0
    return *(buf.data + pos)

# Up to `n` bytes from the cursor, as a slice (does not advance).  Fewer
# than `n` near the end; empty for n <= 0.
pub fn buf_peek_view(buf: @Buffer, n: i64) -> StrView
    var take: i64 = n
    let avail: i64 = buf.len - buf.pos
    if take > avail
        take = avail
    if take < 0
        take = 0
    return strview_from_ptr(buf.data + buf.pos, take)

# DEPRECATED (#1478): copies into a caller-sized buffer.  Use buf_peek_view.
pub fn buf_peek_n(buf: @Buffer, out: *u8, n: i64) -> i64
    var i: i64 = 0
    while i < n and buf.pos + i < buf.len
        *(out + i) = *(buf.data + buf.pos + i)
        i += 1
    return i

# ============================================================================
# Consume operations (advance position)
# ============================================================================

pub fn buf_advance(buf: @&Buffer) -> u8
    if buf.pos >= buf.len
        return 0
    let c: u8 = *(buf.data + buf.pos)
    buf.pos = buf.pos + 1
    return c

pub fn buf_advance_n(buf: @&Buffer, n: i64) -> i64
    let avail: i64 = buf.len - buf.pos
    if n > avail
        n = avail
    buf.pos = buf.pos + n
    return n

pub fn buf_skip(buf: @&Buffer, n: i64) -> i32
    buf.pos = buf.pos + n
    if buf.pos > buf.len
        buf.pos = buf.len
    return 0

# ============================================================================
# Pattern matching (peek-based, don't advance unless match)
# ============================================================================

# Consume `c` if it is next.
pub fn buf_match_char(buf: @&Buffer, c: u8) -> bool
    if buf.pos < buf.len and *(buf.data + buf.pos) == c
        buf.pos = buf.pos + 1
        return true
    return false

# Consume `s` if the unread bytes start with it.
pub fn buf_match_str(buf: @&Buffer, s: StrView) -> bool
    if not buf_starts_with(buf, s)
        return false
    buf.pos = buf.pos + s.len
    return true

# Do the unread bytes start with `s`?  (does not advance)
pub fn buf_starts_with(buf: @Buffer, s: StrView) -> bool
    if buf.pos + s.len > buf.len
        return false
    for i in 0..s.len
        if *(buf.data + buf.pos + i) != *(s.ptr + i)
            return false
    return true

# ============================================================================
# Skip utilities
# ============================================================================

pub fn buf_skip_whitespace(buf: @&Buffer) -> i64
    var count: i64 = 0
    while buf.pos < buf.len
        let c: u8 = *(buf.data + buf.pos)
        if c != ' ' and c != '\t' and c != '\n' and c != '\r'  # space, tab, newline, carriage return
            break
        buf.pos = buf.pos + 1
        count += 1
    return count

pub fn buf_skip_until(buf: @&Buffer, c: u8) -> i64
    var count: i64 = 0
    while buf.pos < buf.len and *(buf.data + buf.pos) != c
        buf.pos = buf.pos + 1
        count += 1
    return count

# Skip bytes while `pred` holds; returns how many were skipped.
pub fn buf_skip_while(buf: @&Buffer, pred: fn(u8) -> bool) -> i64
    let start: i64 = buf.pos
    while buf.pos < buf.len and pred(*(buf.data + buf.pos))
        buf.pos = buf.pos + 1
    return buf.pos - start

# ============================================================================
# Byte predicates (for buf_take_while / buf_skip_while)
# ============================================================================

pub fn buf_is_digit(c: u8) -> bool
    return c >= '0' and c <= '9'

# [A-Za-z0-9_]
pub fn buf_is_ident(c: u8) -> bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_'

# space, tab, newline, carriage return (the set buf_skip_whitespace skips)
pub fn buf_is_space(c: u8) -> bool
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

# ============================================================================
# Zero-copy reads: each returns a StrView slice of the buffer's own bytes,
# valid as long as those bytes are.  Nothing is copied or truncated.
# ============================================================================

# Consume bytes while `pred` holds and return them.
pub fn buf_take_while(buf: @&Buffer, pred: fn(u8) -> bool) -> StrView
    let start: i64 = buf.pos
    while buf.pos < buf.len and pred(*(buf.data + buf.pos))
        buf.pos = buf.pos + 1
    return strview_from_ptr(buf.data + start, buf.pos - start)

# Consume up to (not including) `c`, or to the end, and return it.
pub fn buf_take_until(buf: @&Buffer, c: u8) -> StrView
    let start: i64 = buf.pos
    while buf.pos < buf.len and *(buf.data + buf.pos) != c
        buf.pos = buf.pos + 1
    return strview_from_ptr(buf.data + start, buf.pos - start)

# Consume a run of [0-9].
pub fn buf_take_digits(buf: @&Buffer) -> StrView
    return buf_take_while(buf, buf_is_digit)

# Consume a run of [A-Za-z0-9_].
pub fn buf_take_ident(buf: @&Buffer) -> StrView
    return buf_take_while(buf, buf_is_ident)

# Read a `quote`-delimited string, decoding \n \t \r \\ and \<quote> (any
# other \x yields x), and APPEND the decoded bytes to `out`.
#   true:  terminated; the cursor is past the closing quote.
#   false: not at `quote` (cursor and `out` untouched), or unterminated (the
#          partial content is in `out`, the cursor at the end).
pub fn buf_take_quoted(buf: @&Buffer, quote: u8, out: @&String) -> bool
    if buf.pos >= buf.len or *(buf.data + buf.pos) != quote
        return false
    buf.pos = buf.pos + 1  # opening quote

    while buf.pos < buf.len
        var c: u8 = *(buf.data + buf.pos)
        buf.pos = buf.pos + 1
        if c == quote
            return true
        if c == '\\'
            if buf.pos >= buf.len
                return false
            c = *(buf.data + buf.pos)
            buf.pos = buf.pos + 1
            if c == 'n'
                c = '\n'
            else if c == 't'
                c = '\t'
            else if c == 'r'
                c = '\r'
        string_push(out, c)
    return false

# ============================================================================
# DEPRECATED out-buffer reads (kept for one release after #1478)
# ============================================================================
# Each copies into a caller-sized `out`, NUL-terminates within `max_len`
# (so max_len 4 yields at most 3 bytes) and silently truncates.  Use the
# buf_take_* forms above.

pub fn buf_read_until(buf: @&Buffer, c: u8, out: *u8, max_len: i64) -> i64
    var count: i64 = 0
    while buf.pos < buf.len and count < max_len - 1
        let ch: u8 = *(buf.data + buf.pos)
        if ch == c
            break
        *(out + count) = ch
        buf.pos = buf.pos + 1
        count += 1
    *(out + count) = 0
    return count

pub fn buf_read_while_digit(buf: @&Buffer, out: *u8, max_len: i64) -> i64
    var count: i64 = 0
    while buf.pos < buf.len and count < max_len - 1
        let c: u8 = *(buf.data + buf.pos)
        if c < '0' or c > '9'  # '0' to '9'
            break
        *(out + count) = c
        buf.pos = buf.pos + 1
        count += 1
    *(out + count) = 0
    return count

pub fn buf_read_while_alnum(buf: @&Buffer, out: *u8, max_len: i64) -> i64
    var count: i64 = 0
    while buf.pos < buf.len and count < max_len - 1
        let c: u8 = *(buf.data + buf.pos)
        let is_alpha: i32 = ((c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')) as i32
        let is_digit: i32 = (c >= '0' and c <= '9') as i32
        let is_underscore: i32 = (c == '_') as i32  # '_'
        if is_alpha == 0 and is_digit == 0 and is_underscore == 0
            break
        *(out + count) = c
        buf.pos = buf.pos + 1
        count += 1
    *(out + count) = 0
    return count

pub fn buf_read_quoted(buf: @&Buffer, quote: u8, out: *u8, max_len: i64) -> i64
    # Read a quoted string, handling escapes
    if buf.pos >= buf.len or *(buf.data + buf.pos) != quote
        return -1  # Not starting with quote

    buf.pos = buf.pos + 1  # Skip opening quote
    var count: i64 = 0

    while buf.pos < buf.len and count < max_len - 1
        let c: u8 = *(buf.data + buf.pos)
        if c == quote
            buf.pos = buf.pos + 1  # Skip closing quote
            *(out + count) = 0
            return count
        if c == '\\'  # backslash
            buf.pos = buf.pos + 1
            if buf.pos >= buf.len
                break
            let escape: u8 = *(buf.data + buf.pos)
            if escape == 'n'  # 'n'
                *(out + count) = 10
            else if escape == 't'  # 't'
                *(out + count) = 9
            else if escape == 'r'  # 'r'
                *(out + count) = 13
            else if escape == '\\'  # '\'
                *(out + count) = 92
            else if escape == quote
                *(out + count) = quote
            else
                *(out + count) = escape
            count += 1
            buf.pos = buf.pos + 1
        else
            *(out + count) = c
            count += 1
            buf.pos = buf.pos + 1

    *(out + count) = 0
    return -1  # Unterminated string

# ============================================================================
# Position save/restore (for backtracking)
# ============================================================================

pub fn buf_save(buf: @Buffer) -> i64
    return buf.pos

pub fn buf_restore(buf: @&Buffer, pos: i64) -> i32
    buf.pos = pos
    return 0

# ============================================================================
# Line/column tracking (useful for error messages)
# ============================================================================

struct BufLoc
    line: i32
    col: i32
    offset: i64

pub fn buf_get_loc(buf: @Buffer, loc: @&BufLoc) -> i32
    loc.line = 1
    loc.col = 1
    loc.offset = buf.pos

    for i in 0..buf.pos
        if *(buf.data + i) == '\n'  # newline
            loc.line = loc.line + 1
            loc.col = 1
        else
            loc.col = loc.col + 1
    return 0

# ============================================================================
# GrowBuf: Growable byte buffer (for accumulating data)
# ============================================================================
# GrowBuf is now backed by Vec<u8> for memory management.
# This provides:
# - Automatic memory management via Drop trait
# - Efficient growth via realloc
# - Binary compatible with old code (same struct layout)
#
# The struct layout (data, len, cap) matches Vec<u8> exactly, so existing
# code that accesses b.data, b.len, b.cap continues to work.

struct GrowBuf
    data: *u8       # Pointer to heap-allocated bytes
    len: i64        # Current length (bytes used)
    cap: i64        # Capacity (bytes allocated)

# ============================================================================
# Drop trait for automatic cleanup
# ============================================================================

impl Drop for GrowBuf
    fn drop(self: @&GrowBuf)
        if self.data != null
            free(self.data)
        self.data = null
        self.len = 0
        self.cap = 0

# ============================================================================
# Constructor functions
# ============================================================================

# Create a new empty growable buffer.
pub fn growbuf_new() -> GrowBuf
    var b: GrowBuf
    b.data = null
    b.len = 0
    b.cap = 0
    return b

# Create a new growable buffer with pre-allocated capacity.
pub fn growbuf_with_cap(cap: i64) -> GrowBuf
    var b: GrowBuf
    if cap <= 0
        b.data = null
        b.len = 0
        b.cap = 0
        return b

    b.data = malloc(cap)
    if b.data == null
        b.len = 0
        b.cap = 0
        return b

    b.len = 0
    b.cap = cap
    return b

# Free the buffer (deprecated - GrowBuf has automatic Drop).
# Kept for backward compatibility with existing code.
pub fn growbuf_free(b: @&GrowBuf) -> i32
    if b.data != null
        free(b.data)
    b.data = null
    b.len = 0
    b.cap = 0
    return 0

# ============================================================================
# Growth and capacity
# ============================================================================

# Grow the buffer to a new capacity.
pub fn growbuf_grow(b: @&GrowBuf, new_cap: i64) -> i32
    if new_cap <= b.cap
        return 0

    let new_data: *u8 = realloc(b.data, new_cap)
    if new_data == null
        return -1

    b.data = new_data
    b.cap = new_cap
    return 0

# Ensure the buffer has at least the given capacity.
pub fn growbuf_ensure_cap(b: @&GrowBuf, needed: i64) -> i32
    if b.cap >= needed
        return 0

    var new_cap: i64 = b.cap
    if new_cap == 0
        new_cap = 64
    while new_cap < needed
        new_cap *= 2

    return growbuf_grow(b, new_cap)

# ============================================================================
# Append operations
# ============================================================================

# Append bytes to the buffer.
pub fn growbuf_append(b: @&GrowBuf, data: *u8, len: i64) -> i32
    if growbuf_ensure_cap(b, b.len + len) != 0
        return -1

    for i in 0..len
        *(b.data + b.len + i) = *(data + i)
    b.len = b.len + len
    return 0

# Append the bytes of `s` (a "..." literal is a StrView).
pub fn growbuf_append_view(b: @&GrowBuf, s: StrView) -> i32
    return growbuf_append(b, s.ptr, s.len)

# Append a single byte to the buffer.
pub fn growbuf_append_byte(b: @&GrowBuf, byte: u8) -> i32
    if growbuf_ensure_cap(b, b.len + 1) != 0
        return -1
    *(b.data + b.len) = byte
    b.len = b.len + 1
    return 0

# ============================================================================
# Accessors
# ============================================================================

# Clear all bytes (keeps capacity).
pub fn growbuf_clear(b: @&GrowBuf) -> i32
    b.len = 0
    return 0

# Get length (number of bytes).
pub fn growbuf_len(b: @GrowBuf) -> i64
    return b.len

# Get capacity (allocated bytes).
pub fn growbuf_cap(b: @GrowBuf) -> i64
    return b.cap

# Get raw data pointer (C interop; prefer growbuf_view).
pub fn growbuf_data(b: @GrowBuf) -> *u8
    return b.data

# The bytes appended so far, as a slice.  Invalidated by the next append
# (which may reallocate), clear or free.
pub fn growbuf_view(b: @GrowBuf) -> StrView
    return strview_from_ptr(b.data, b.len)

# Get byte at index.
pub fn growbuf_get(b: @GrowBuf, idx: i64) -> u8
    if idx < 0 or idx >= b.len
        return 0
    return *(b.data + idx)

# Check if buffer is empty.
pub fn growbuf_is_empty(b: @GrowBuf) -> bool
    return b.len == 0

# ============================================================================
# File reading utilities
# ============================================================================
# Common patterns for reading files into buffers.

pub fn read_all_fd(fd: i32, b: @&GrowBuf) -> i64
    # Read entire file descriptor into GrowBuf, return bytes read or -1 on error
    let chunk_size: i64 = 4096
    var temp: [4096]u8
    var total: i64 = 0

    loop
        let n: i64 = sys_read(fd, @temp[0], chunk_size)
        if n < 0
            return -1
        if n == 0
            break
        if growbuf_append(b, @temp[0], n) != 0
            return -1
        total += n

    return total
