# ritzlib/result.ritz - `Result<T, E>`, a success value or an error

import ritzlib.option

# Result<T, E> - Result type for error handling
#
# Represents either a success value (Ok) or an error value (Err).
# Use for functions that can fail.
#
# Example:
#     fn parse_int(s: *u8) -> Result<i32, i32>
#         if strlen(s) == 0
#             return Err(1)  # Error code for empty string
#         # ... parsing logic ...
#         return Ok(value)

enum Result<T, E>
    Ok(T)
    Err(E)

# Methods (S-IMPL-1): a Result is the subject of every operation on it.
impl<T, E> Result<T, E>
    # Check if result is success
    pub fn is_ok(self: *Result<T, E>) -> bool
        match *self
            Ok(_) => true
            Err(_) => false

    # Check if result is error
    pub fn is_err(self: *Result<T, E>) -> bool
        match *self
            Ok(_) => false
            Err(_) => true

    # Note: unwrap and unwrap_err are not implementable without panic! macro
    # Use unwrap_or instead for safe unwrapping with a default value

    # Unwrap the success value or return default
    pub fn unwrap_or(self: *Result<T, E>, default: T) -> T
        match *self
            Ok(v) => v
            Err(_) => default

    # Convert Result to Option, discarding the error
    pub fn ok(self: *Result<T, E>) -> Option<T>
        match *self
            Ok(v) => Some(v)
            Err(_) => None

    # Convert Result to Option of the error, discarding the success value
    pub fn err(self: *Result<T, E>) -> Option<E>
        match *self
            Ok(_) => None
            Err(e) => Some(e)
