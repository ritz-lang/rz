# ritzlib/net.ritz - Networking primitives for TCP/IP communication
#
# standard-exempt-file(sys_*): status-return, out-param: the socket syscall ABI
# (#4636): raw -errno results and the kernel's addrlen/optlen out-pointers;
# Socket is the layer that returns Result.
#
# Provides socket operations for building network clients and servers.
# Designed with HTTP 1.0/1.1 (and future HTTP/2, HTTP/3) in mind.
#
# Architecture:
# - Low-level syscall wrappers for sockets
# - Address types (IPv4, IPv6)
# - Connection abstractions
# - Non-blocking I/O support for async patterns
#
# Usage:
#   # Server
#   var sock: Socket
#   match socket_tcp()                      # Result<Socket, Errno>
#       Ok(s) => sock = s
#       Err(e) => ...                       # e.g. MFile: Other(24)
#   sock.set_reuseaddr()
#   match sock.bind("0.0.0.0", 8080)        # Result<(), Errno>
#       Ok(_) => pass
#       Err(e) => ...                       # AddrInUse; Inval = bad address
#   sock.listen(128)                        # Result<(), Errno>
#   match sock.accept()                     # Result<Socket, Errno>
#       Ok(client) =>
#           client.send("HTTP/1.1 200 OK\r\n\r\nHello")   # Span<u8>, Result<i64, Errno>
#           client.close()                  # Result<(), Errno>
#       Err(e) => ...
#
#   # Client (socket_tcp as above)
#   sock.connect("127.0.0.1", 8080)         # Result<(), Errno>; ConnRefused
#   sock.send_str(string_as_view(@request)) # StrView, Result<i64, Errno>
#   var buf: Vec<u8> = vec_new<u8>()
#   sock.recv(@&buf, 4096)                  # appends; Ok(0) at EOF
#   sock.close()
#
# Addresses are StrViews (AGAST #1483), and every Err is a ritzlib.errno
# `Errno` (AGAST #4298; was a positive i32 errno): socket_tcp / socket_udp
# and the epoll wrappers return Result too, never a -1 fd.
# No entry point takes a raw `*u8` address or buffer (#3835 deleted the
# socket_send / socket_recv / socket_bind_any forms), and none takes a raw
# `*Socket`: a Socket is borrowed `@&Socket`, and close, listen, accept and
# the option setters return Result, not 0-or-negative-errno (#3880).
# tools/test_ritzlib_net_api.py guards both.  The sys_* syscall shims stay
# raw by design: their pointer arguments are the kernel ABI.

import ritzlib.sys  # For sys_read, sys_write, sys_close, syscallN
import ritzlib.str  # For memset, strlen
import ritzlib.string  # For String type
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec
import ritzlib.option
import ritzlib.result
# Errno is part of this API (every Err), so importers of net get it too.
pub import ritzlib.errno

# ============================================================================
# Socket syscall numbers
# ============================================================================
# Syscall numbers come from ritzlib.sys, the only place ritzlib declares them
# (AGAST #1857).

# fcntl operations
const F_GETFL: i32 = 3
const F_SETFL: i32 = 4
const O_NONBLOCK_FLAG: i32 = 2048   # 0x800

# Socket option for retrieving pending error after non-blocking connect
const SO_ERROR: i32 = 4

# Receive- and send-timeout socket options (struct timeval values).  Used
# to bound recv() and send() syscalls so a hung peer can't lock a client
# forever during the protocol-level handshake.
const SO_RCVTIMEO: i32 = 20
const SO_SNDTIMEO: i32 = 21

# connect(2)'s "SYN in flight" errno, for the non-blocking connect timeout
const E_INPROGRESS: i32 = 115

# ============================================================================
# Socket constants
# ============================================================================

# Address families
const AF_INET: i32 = 2        # IPv4
const AF_INET6: i32 = 10      # IPv6

# Socket types
const SOCK_STREAM: i32 = 1    # TCP
const SOCK_DGRAM: i32 = 2     # UDP
const SOCK_NONBLOCK: i32 = 2048   # Non-blocking flag (can OR with type)
const SOCK_CLOEXEC: i32 = 524288  # Close-on-exec flag

# Socket options
const SOL_SOCKET: i32 = 1
const SO_REUSEADDR: i32 = 2
const SO_REUSEPORT: i32 = 15
const SO_KEEPALIVE: i32 = 9
const SO_RCVBUF: i32 = 8
const SO_SNDBUF: i32 = 7

# TCP options
const IPPROTO_TCP: i32 = 6
const TCP_NODELAY: i32 = 1
const TCP_CORK: i32 = 3

# Epoll events
const EPOLLIN: i32 = 1
const EPOLLOUT: i32 = 4
const EPOLLERR: i32 = 8
const EPOLLHUP: i32 = 16
const EPOLLET: u32 = 2147483648  # 0x80000000 - Edge-triggered
const EPOLL_CTL_ADD: i32 = 1
const EPOLL_CTL_DEL: i32 = 2
const EPOLL_CTL_MOD: i32 = 3

# ============================================================================
# Address structures
# ============================================================================

# IPv4 socket address (16 bytes)
# Layout matches struct sockaddr_in
struct SockAddrIn
    family: i16       # AF_INET (2)
    port: u16         # Port in network byte order
    addr: u32         # IPv4 address in network byte order
    zero: [8]u8       # Padding

# IPv6 socket address (28 bytes)
struct SockAddrIn6
    family: i16       # AF_INET6 (10)
    port: u16         # Port in network byte order
    flowinfo: u32     # Flow info
    addr: [16]u8      # IPv6 address
    scope_id: u32     # Scope ID

# Any socket address, with its length (struct sockaddr_storage, 128 bytes,
# plus the socklen_t the kernel reads and writes beside it). For an accept
# that wants the peer, len starts at 128 and the kernel lowers it; for a
# connect, fill bytes (e.g. copy a SockAddrIn in) and set len (16 for IPv4).
pub struct SockAddrStorage
    bytes: [128]u8
    len: i32

# An empty SockAddrStorage, zeroed, with len = 128 (all of it on offer).
pub fn sockaddr_storage_new() -> SockAddrStorage
    var s: SockAddrStorage
    for i in 0..128
        s.bytes[i] = 0
    s.len = 128
    s

# ============================================================================
# Socket handle
# ============================================================================

struct Socket
    fd: i32           # File descriptor
    family: i32       # AF_INET or AF_INET6
    socktype: i32     # SOCK_STREAM or SOCK_DGRAM

# ============================================================================
# Byte order conversion (host to network)
# ============================================================================

# Convert 16-bit host to network byte order (big-endian)
pub fn htons(val: i32) -> u16
    let high: u16 = ((val >> 8) & 255) as u16
    let low: u16 = (val & 255) as u16
    return (low << 8) | high

# Convert 16-bit network to host byte order
pub fn ntohs(val: u16) -> i32
    let high: i32 = (val >> 8) as i32
    let low: i32 = (val & 255) as i32
    return (low << 8) | high

# Convert 32-bit host to network byte order
pub fn htonl(val: i64) -> u32
    let b0: u32 = ((val >> 24) & 255) as u32
    let b1: u32 = ((val >> 16) & 255) as u32
    let b2: u32 = ((val >> 8) & 255) as u32
    let b3: u32 = (val & 255) as u32
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0

# Convert 32-bit network to host byte order
pub fn ntohl(val: i32) -> i32
    let b0: i32 = (val >> 24) & 255
    let b1: i32 = (val >> 16) & 255
    let b2: i32 = (val >> 8) & 255
    let b3: i32 = val & 255
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0

# ============================================================================
# IP address parsing
# ============================================================================

# Parse a dotted-quad IPv4 address ("127.0.0.1") to network byte order.
#
# Exactly four dot-separated decimal octets, each 1-3 digits and at most 255,
# and nothing else: an empty, short, long or non-numeric string is None, so
# garbage is no longer indistinguishable from 0.0.0.0 (AGAST #1483).  Only
# the view's `len` bytes are read; it needs no terminator.
pub fn parse_ipv4(s: StrView) -> Option<u32>
    var result: u32 = 0
    var octet: u32 = 0
    var digits: i32 = 0
    var shift: i32 = 0

    for i in 0..s.len
        let c: u8 = *(s.ptr + i)
        if c >= '0' and c <= '9'
            digits += 1
            if digits > 3
                return None
            octet = octet * 10 + (c - '0') as u32
        else if c == '.'
            if digits == 0 or octet > 255 or shift == 24
                return None
            result = result | (octet << shift)
            shift += 8
            octet = 0
            digits = 0
        else
            return None

    if digits == 0 or octet > 255 or shift != 24
        return None
    Some(result | (octet << shift))

# INADDR_ANY (0.0.0.0)
const INADDR_ANY: u32 = 0

# INADDR_LOOPBACK (127.0.0.1) in network byte order
pub fn inaddr_loopback() -> u32
    match parse_ipv4("127.0.0.1")
        Some(a) => a
        None => 0

# ============================================================================
# Socket syscall wrappers
# ============================================================================

pub fn sys_socket(domain: i32, socktype: i32, protocol: i32) -> i32
    return syscall3(SYS_SOCKET, domain as i64, socktype as i64, protocol as i64) as i32

# standard-exempt: raw-ptr-param: bind(2) syscall ABI
pub fn sys_bind(fd: i32, addr: *u8, addrlen: i32) -> i32
    return syscall3(SYS_BIND, fd as i64, addr as i64, addrlen as i64) as i32

pub fn sys_listen(fd: i32, backlog: i32) -> i32
    return syscall2(SYS_LISTEN, fd as i64, backlog as i64) as i32

# standard-exempt: raw-ptr-param: accept(2) syscall ABI
pub fn sys_accept(fd: i32, addr: *u8, addrlen: *i32) -> i32
    return syscall3(SYS_ACCEPT, fd as i64, addr as i64, addrlen as i64) as i32

# standard-exempt: raw-ptr-param: accept4(2) syscall ABI
pub fn sys_accept4(fd: i32, addr: *u8, addrlen: *i32, flags: i32) -> i32
    return syscall4(SYS_ACCEPT4, fd as i64, addr as i64, addrlen as i64, flags as i64) as i32

# standard-exempt: raw-ptr-param: connect(2) syscall ABI
pub fn sys_connect(fd: i32, addr: *u8, addrlen: i32) -> i32
    return syscall3(SYS_CONNECT, fd as i64, addr as i64, addrlen as i64) as i32

# standard-exempt: raw-ptr-param: setsockopt(2) syscall ABI
pub fn sys_setsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: i32) -> i32
    return syscall5(SYS_SETSOCKOPT, fd as i64, level as i64, optname as i64, optval as i64, optlen as i64) as i32

# standard-exempt: raw-ptr-param: getsockopt(2) syscall ABI
pub fn sys_getsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: *i32) -> i32
    return syscall5(SYS_GETSOCKOPT, fd as i64, level as i64, optname as i64, optval as i64, optlen as i64) as i32

pub fn sys_shutdown(fd: i32, how: i32) -> i32
    return syscall2(SYS_SHUTDOWN, fd as i64, how as i64) as i32

# standard-exempt: raw-ptr-param: getsockname(2) syscall ABI
pub fn sys_getsockname(fd: i32, addr: *u8, addrlen: *i32) -> i32
    return syscall3(SYS_GETSOCKNAME, fd as i64, addr as i64, addrlen as i64) as i32

pub fn sys_epoll_create1(flags: i32) -> i32
    return syscall1(SYS_EPOLL_CREATE1, flags as i64) as i32

# standard-exempt: raw-ptr-param: epoll_ctl(2) syscall ABI
pub fn sys_epoll_ctl(epfd: i32, op: i32, fd: i32, event: *u8) -> i32
    return syscall4(SYS_EPOLL_CTL, epfd as i64, op as i64, fd as i64, event as i64) as i32

# standard-exempt: raw-ptr-param: epoll_wait(2) syscall ABI
pub fn sys_epoll_wait(epfd: i32, events: *u8, maxevents: i32, timeout: i32) -> i32
    return syscall4(SYS_EPOLL_WAIT, epfd as i64, events as i64, maxevents as i64, timeout as i64) as i32

# ============================================================================
# High-level socket operations
# ============================================================================

# An IPv4 socket(2) of `socktype` (flags OR'd in) as Ok(Socket), or
# Err(errno) (e.g. Other(24), EMFILE, out of descriptors).  `kind` is the
# bare SOCK_STREAM / SOCK_DGRAM recorded in the handle.
fn socket_open(socktype: i32, kind: i32) -> Result<Socket, Errno>
    let fd: i32 = sys_socket(AF_INET, socktype, 0)
    if fd < 0
        return Err(errno_from_raw(fd))
    var sock: Socket
    sock.fd = fd
    sock.family = AF_INET
    sock.socktype = kind
    Ok(sock)

# A TCP socket (IPv4), or Err(errno) from socket(2).
pub fn socket_tcp() -> Result<Socket, Errno>
    socket_open(SOCK_STREAM, SOCK_STREAM)

# A non-blocking TCP socket (IPv4), or Err(errno) from socket(2).
pub fn socket_tcp_nonblock() -> Result<Socket, Errno>
    socket_open(SOCK_STREAM | SOCK_NONBLOCK, SOCK_STREAM)

# A UDP socket (IPv4), or Err(errno) from socket(2).
pub fn socket_udp() -> Result<Socket, Errno>
    socket_open(SOCK_DGRAM, SOCK_DGRAM)

# A syscall's 0-or-negative-errno return as Ok(()) or Err(its Errno).
fn unit_result(rc: i32) -> Result<(), Errno>
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(())

# A sockaddr_in for `ip` (network byte order) and `port` (host order).
fn sockaddr_in(ip: u32, port: i32) -> SockAddrIn
    var addr: SockAddrIn
    addr.family = AF_INET as i16
    addr.port = htons(port)
    addr.addr = ip
    memset(@addr.zero[0], 0, 8)
    addr

# An accept(2)/accept4(2) return as Ok(the connected Socket) or Err(errno).
fn accepted(fd: i32) -> Result<Socket, Errno>
    if fd < 0
        return Err(errno_from_raw(fd))
    var client: Socket
    client.fd = fd
    client.family = AF_INET
    client.socktype = SOCK_STREAM
    Ok(client)

# fcntl wrapper for setting/clearing socket flags.  Used by the timeout
# variant of connect to flip O_NONBLOCK on and off around the connect call.
fn sys_fcntl_set(fd: i32, flags: i32) -> i32
    return syscall3(SYS_FCNTL, fd as i64, F_SETFL as i64, flags as i64) as i32

fn sys_fcntl_get(fd: i32) -> i32
    return syscall3(SYS_FCNTL, fd as i64, F_GETFL as i64, 0) as i32

# ============================================================================
# Epoll operations (for async/event-driven I/O)
# ============================================================================

# The x86_64 kernel's `struct epoll_event`, which is __attribute__((packed)):
# 12 bytes, `data` at offset 4, a 12-byte stride in epoll_wait's array.
# Unpacked it would be 16 bytes with `data` at 8 (AGAST #4302).
[[packed]]
struct EpollEvent
    events: u32       # EPOLLIN, EPOLLOUT, etc.
    data: u64         # User data (fd or pointer)

# A syscall's fd-or-count-or-negative-errno return as Ok(n) or Err(Errno).
fn count_result(rc: i32) -> Result<i32, Errno>
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(rc)

# A new epoll instance's fd, or Err(errno) from epoll_create1(2).
pub fn epoll_create() -> Result<i32, Errno>
    count_result(sys_epoll_create1(0))

# Watch `fd` for `events`.  Err(Exist) if it is already watched.
pub fn epoll_add(epfd: i32, fd: i32, events: u32) -> Result<(), Errno>
    var ev: EpollEvent
    ev.events = events
    ev.data = fd as u64
    unit_result(sys_epoll_ctl(epfd, EPOLL_CTL_ADD, fd, @ev as *u8))

# Stop watching `fd`.  Err(NoEnt) if it is not watched.
pub fn epoll_del(epfd: i32, fd: i32) -> Result<(), Errno>
    unit_result(sys_epoll_ctl(epfd, EPOLL_CTL_DEL, fd, null))

# Change the events `fd` is watched for.  Err(NoEnt) if it is not watched.
pub fn epoll_mod(epfd: i32, fd: i32, events: u32) -> Result<(), Errno>
    var ev: EpollEvent
    ev.events = events
    ev.data = fd as u64
    unit_result(sys_epoll_ctl(epfd, EPOLL_CTL_MOD, fd, @ev as *u8))

# Wait up to `timeout_ms` for events: Ok(the number of ready fds, 0 on
# timeout), or Err(errno) from epoll_wait(2), e.g. Intr.
pub fn epoll_wait_events(epfd: i32, events: @&EpollEvent, maxevents: i32, timeout_ms: i32) -> Result<i32, Errno>
    count_result(sys_epoll_wait(epfd, events as *u8, maxevents, timeout_ms))

# ============================================================================
# Methods (S-IMPL-1): a Socket is the subject of every operation on it.
# ============================================================================

impl Socket
    # Whether the socket holds an open descriptor (false once closed)
    pub fn valid(self: @Socket) -> bool
        self.fd >= 0

    # Close the socket and mark it closed (fd = -1), so a second close, or a
    # close of a socket that never opened, is Ok(()) and closes nothing.
    # Err(errno) from close(2); the fd is released either way (Linux frees it
    # even when close reports EINTR or EIO), so it is still marked closed.
    #
    # A mutable borrow, not an owned Socket: the caller keeps the (now closed)
    # handle, which valid() then reports as closed (AGAST #3880).
    pub fn close(self: @&Socket) -> Result<(), Errno>
        if self.fd < 0
            return Ok(())
        let rc: i32 = sys_close(self.fd)
        self.fd = -1
        unit_result(rc)

    # Set an integer socket option.  Err(errno) from setsockopt(2).
    pub fn set_opt_int(self: @&Socket, level: i32, optname: i32, value: i32) -> Result<(), Errno>
        var val: i32 = value
        unit_result(sys_setsockopt(self.fd, level, optname, @val as *u8, 4))

    # Enable SO_REUSEADDR
    pub fn set_reuseaddr(self: @&Socket) -> Result<(), Errno>
        self.set_opt_int(SOL_SOCKET, SO_REUSEADDR, 1)

    # Enable SO_REUSEPORT
    pub fn set_reuseport(self: @&Socket) -> Result<(), Errno>
        self.set_opt_int(SOL_SOCKET, SO_REUSEPORT, 1)

    # Enable TCP_NODELAY (disable Nagle's algorithm)
    pub fn set_nodelay(self: @&Socket) -> Result<(), Errno>
        self.set_opt_int(IPPROTO_TCP, TCP_NODELAY, 1)

    # Set both SO_RCVTIMEO and SO_SNDTIMEO on a socket so subsequent recv/send
    # calls fail with -EAGAIN after the timeout instead of blocking forever.
    #
    # Implements the timeval-based form expected by Linux:
    #   struct timeval {
    #       i64 tv_sec;
    #       i64 tv_usec;
    #   };
    #
    # Ok(()), or Err(errno) from the first setsockopt that fails.  Pass 0 for
    # `timeout_ms` to clear timeouts (sets both fields to zero — kernel treats
    # that as "no timeout").
    pub fn set_io_timeout(self: @&Socket, timeout_ms: i32) -> Result<(), Errno>
        var tv: [2]i64
        tv[0] = (timeout_ms / 1000) as i64
        tv[1] = ((timeout_ms % 1000) * 1000) as i64

        let r1: i32 = sys_setsockopt(self.fd, SOL_SOCKET, SO_RCVTIMEO, @tv[0] as *u8, 16)
        if r1 < 0
            return Err(errno_from_raw(r1))
        unit_result(sys_setsockopt(self.fd, SOL_SOCKET, SO_SNDTIMEO, @tv[0] as *u8, 16))

    # Bind the socket to an IPv4 address and port.  Err(Inval) if `addr`
    # isn't a dotted quad (parse_ipv4); otherwise Err(errno) from bind(2),
    # e.g. AddrInUse.
    pub fn bind(self: @&Socket, addr: StrView, port: i32) -> Result<(), Errno>
        var ip: u32 = 0
        match parse_ipv4(addr)
            Some(a) => ip = a
            None => return Err(Errno.Inval)
        var sa: SockAddrIn = sockaddr_in(ip, port)
        unit_result(sys_bind(self.fd, @sa as *u8, 16))

    # Listen for connections.  Err(errno) from listen(2).
    pub fn listen(self: @&Socket, backlog: i32) -> Result<(), Errno>
        unit_result(sys_listen(self.fd, backlog))

    # Accept a connection (blocking).  Ok(the connected Socket), or Err(errno)
    # from accept(2), e.g. Inval if `self` isn't listening.
    pub fn accept(self: @&Socket) -> Result<Socket, Errno>
        var addr: SockAddrIn
        var addrlen: i32 = 16
        accepted(sys_accept(self.fd, @addr as *u8, @addrlen))

    # Accept a connection without blocking; the accepted Socket is non-blocking
    # too.  Err(Again) when no connection is pending, else Err(errno).
    pub fn accept_nonblock(self: @&Socket) -> Result<Socket, Errno>
        var addr: SockAddrIn
        var addrlen: i32 = 16
        accepted(sys_accept4(self.fd, @addr as *u8, @addrlen, SOCK_NONBLOCK))

    # Connect to an IPv4 address and port (blocking).  Err(Inval) if `addr`
    # isn't a dotted quad; otherwise Err(errno) from connect(2), e.g.
    # ConnRefused.
    pub fn connect(self: @&Socket, addr: StrView, port: i32) -> Result<(), Errno>
        var ip: u32 = 0
        match parse_ipv4(addr)
            Some(a) => ip = a
            None => return Err(Errno.Inval)
        var sa: SockAddrIn = sockaddr_in(ip, port)
        unit_result(sys_connect(self.fd, @sa as *u8, 16))

    # Connect to a server with a wall-clock timeout in milliseconds.
    #
    # Standard "non-blocking connect" recipe (POSIX):
    #   1. Snapshot the socket's current flags, OR in O_NONBLOCK.
    #   2. Issue connect().  Either succeeds immediately (rare on TCP) or
    #      returns -EINPROGRESS, which means the SYN is in flight.
    #   3. poll(POLLOUT) with the timeout.  Writable = connect resolved.
    #   4. getsockopt(SO_ERROR) — 0 means success, anything else is the
    #      pending errno (ECONNREFUSED, ETIMEDOUT, etc.).
    #   5. Restore the original blocking flags.
    #
    # Ok(()) once connected, with the socket blocking again.  Err(Inval) if
    # `addr` isn't a dotted quad; Err(TimedOut) if the kernel didn't resolve
    # the connect within `timeout_ms`; otherwise Err(errno) from fcntl,
    # connect, poll or SO_ERROR (e.g. ConnRefused).  Before #3835 this returned
    # -1/-2/-3 categories and lost the errno.
    #
    # This is the standard fix for the "if a half-broken peer is on the port,
    # regular connect() blocks for the kernel's TCP retry timeout (~75s)"
    # failure mode that bit nexus during the G-wedge testing.
    pub fn connect_timeout(self: @&Socket, addr: StrView, port: i32, timeout_ms: i32) -> Result<(), Errno>
        var ip: u32 = 0
        match parse_ipv4(addr)
            Some(a) => ip = a
            None => return Err(Errno.Inval)
        var sa: SockAddrIn = sockaddr_in(ip, port)

        # 1. Save current flags and switch to non-blocking
        let orig_flags: i32 = sys_fcntl_get(self.fd)
        if orig_flags < 0
            return Err(errno_from_raw(orig_flags))

        let set_rc: i32 = sys_fcntl_set(self.fd, orig_flags | O_NONBLOCK_FLAG)
        if set_rc < 0
            return Err(errno_from_raw(set_rc))

        # 2. Issue connect.  Expected to return -EINPROGRESS for TCP; 0 is the
        # loopback fast path, anything else a hard failure.
        let rc: i32 = sys_connect(self.fd, @sa as *u8, 16)
        if rc != (0 - E_INPROGRESS)
            sys_fcntl_set(self.fd, orig_flags)
            return unit_result(rc)

        # 3. Wait for the socket to become writable, with timeout.
        var pfd: PollFd
        pfd.fd = self.fd
        pfd.events = POLLOUT
        pfd.revents = 0

        let poll_rc: i32 = sys_poll(@pfd, 1, timeout_ms)

        # Restore blocking mode regardless of outcome.  We're either going to
        # use the socket synchronously after this (caller expects blocking
        # I/O) or close it on error.
        sys_fcntl_set(self.fd, orig_flags)

        if poll_rc == 0
            return Err(Errno.TimedOut)
        if poll_rc < 0
            return Err(errno_from_raw(poll_rc))

        # 4. The connect's outcome, POLLERR included, is in SO_ERROR.
        var so_error: i32 = 0
        var optlen: i32 = 4
        let err_rc: i32 = sys_getsockopt(self.fd, SOL_SOCKET, SO_ERROR, @so_error as *u8, @optlen)
        if err_rc < 0
            return Err(errno_from_raw(err_rc))
        if so_error != 0
            return Err(errno_from_raw(so_error))
        Ok(())

    # Send every byte of `data`, writing again after a short write or EINTR.
    # Ok(data.len), or Err(errno) from the first write that fails (bytes
    # before it have been sent).
    pub fn send_all(self: @&Socket, data: Span<u8>) -> Result<i64, Errno>
        var sent: i64 = 0
        while sent < data.len
            let n: i64 = sys_write(self.fd, data.ptr + sent, data.len - sent)
            if n < 0
                if n != (0 - EINTR) as i64
                    return Err(errno_from_raw(n as i32))
            else
                sent += n
        Ok(sent)

    # send_all for text: a "..." literal, a string_as_view(@s), a slice.
    pub fn send_str(self: @&Socket, s: StrView) -> Result<i64, Errno>
        self.send_all(span_from_strview(s))

    # Receive at most `max` bytes, appended to `buf` (one read, retried on
    # EINTR).  Ok(bytes read), Ok(0) at end of stream, or Err(errno).
    pub fn recv_into(self: @&Socket, buf: @&Vec<u8>, max: i64) -> Result<i64, Errno>
        if not buf.ensure_cap(buf.len + max)
            return Err(Errno.NoMem)
        loop
            let n: i64 = sys_read(self.fd, buf.data + buf.len, max)
            if n >= 0
                buf.len += n
                return Ok(n)
            if n != (0 - EINTR) as i64
                return Err(errno_from_raw(n as i32))

    # Short aliases for the common calls.
    pub fn send(self: @&Socket, data: Span<u8>) -> Result<i64, Errno>
        self.send_all(data)

    pub fn recv(self: @&Socket, buf: @&Vec<u8>, max: i64) -> Result<i64, Errno>
        self.recv_into(buf, max)
