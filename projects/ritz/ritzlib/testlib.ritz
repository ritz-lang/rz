# ritzlib/testlib.ritz - Helpers for `[[test]]` integration tests
#
# Centralises the boilerplate that was previously copy-pasted across every
# tier 2-4 test_*.ritz file:
#
#   * buf_eq / buf_contains  — byte-span comparison
#   * sandbox_path           — pid-suffixed paths under $TMPDIR (else /tmp)
#   * exec_capture           — run a binary with the given args, env and stdin
#                              (delivered race-free via a temp file) and
#                              capture its stdout and stderr, merged
#   * capture                — run an in-process body as a child process
#                              (process.spawn_fn) and capture its stdout and
#                              stderr, apart
#
# File I/O is ritzlib.fs's read_file / write_file (AGAST #4643 deleted the
# cstr copies here, which also collided with fs's names).
#
# Lessons baked in here:
#
#   * Read-until-EOF: `sys_read` returns on ANY data, not just on close.  A
#     fast parent reading a single chunk would silently truncate the child's
#     output, surfacing as bizarre length-mismatch flakes.  Every read path
#     loops until EOF.
#   * Temp-file stdin > pipe stdin: even with pre-fork buffering, pipe-fed
#     stdin had ~5% flake under ritz0 --test's harness on contended boxes.
#     Temp file is race-free; the child sees a regular file with full
#     contents and a clean EOF.
#
# Every input is a StrView, a Span<StrView> or a Span<u8>, and every failure an
# Err(Errno) (AGAST #4643): this file is the template every example test
# copies, so a C-string shape here spreads to all of them.  The fork and exec
# live in ritzlib.process (spawn_env_merged, spawn_fn), not here.

import ritzlib.sys
# Every type this API names comes with it (#3891): String (sandbox_path),
# Vec (Captured.out), StrView and Span (the params), Result, and
# ritzlib.process's ProcessResult and Errno (exec_capture).
pub import ritzlib.gvec
pub import ritzlib.string
pub import ritzlib.strview
pub import ritzlib.span
pub import ritzlib.result
pub import ritzlib.process
import ritzlib.fd
import ritzlib.os.env

# ============================================================================
# Buffer primitives
# ============================================================================

# Compare two byte spans.  true when they are the same length and bytes.
pub fn buf_eq(a: Span<u8>, b: Span<u8>) -> bool
    if a.len != b.len
        return false
    var i: i64 = 0
    while i < a.len
        if *(a.ptr + i) != *(b.ptr + i)
            return false
        i += 1
    return true

# Find needle anywhere in hay.
# Empty needle always matches (mirrors strstr/grep semantics).
# true if found, else false.
pub fn buf_contains(hay: Span<u8>, needle: Span<u8>) -> bool
    if needle.len == 0
        return true
    if needle.len > hay.len
        return false
    var i: i64 = 0
    while i <= hay.len - needle.len
        if buf_eq(Span<u8> { ptr: hay.ptr + i, len: needle.len }, needle)
            return true
        i += 1
    return false

# ============================================================================
# Sandbox paths
# ============================================================================

# "<tmp>/ritz_<prefix>_<pid>_<suffix>", where <tmp> is $TMPDIR when it is set
# and non-empty, else /tmp.  $TMPDIR matters because a host's /tmp may be
# mounted noexec: a test that links a program into its sandbox and runs it
# then fails to spawn, so the gate gives every test an exec-capable $TMPDIR.
# The pid keeps parallel test workers (gate slots, compiler variants) from
# colliding; the suffix tells a test's own paths apart ("src", "dst",
# "subdir").  A path the kernel wants as a C string is `p.as_ptr()`; one going
# to a StrView API is `p.as_view()`.
pub fn sandbox_path(prefix: StrView, suffix: StrView) -> String
    match env_get("TMPDIR")
        Some(dir) =>
            return sandbox_path_under(dir, prefix, suffix)
        None =>
            return sandbox_path_under("", prefix, suffix)

# sandbox_path with the directory given: "<dir>/ritz_<prefix>_<pid>_<suffix>".
# An empty `dir` is /tmp, and a trailing '/' on it is not doubled.
pub fn sandbox_path_under(dir: StrView, prefix: StrView, suffix: StrView) -> String
    var base: StrView = "/tmp"
    if not dir.is_empty()
        base = dir
    if base.len > 1 and base.ends_with("/")
        base = StrView { ptr: base.ptr, len: base.len - 1 }
    var p: String = string_from(base)
    p.push_str("/ritz_")
    p.push_str(prefix)
    p.push('_')
    let pid: String = string_from_i64(process_id() as i64)
    p.push_string(@pid)
    p.push('_')
    p.push_str(suffix)
    p

# ============================================================================
# Process exec / capture
# ============================================================================

# What exec_capture or capture saw: how the child exited (status.exit_code,
# or status.signaled / status.signal) and what it wrote.  exec_capture merges
# stderr into `out` in the order written, so its `err` is empty; capture
# keeps them apart, stdout in `out` and stderr in `err`.  c.output() and
# c.err_output() are those as a Span<u8>, for buf_eq / buf_contains.
pub struct Captured
    status: ProcessResult
    out: Vec<u8>
    err: Vec<u8>

impl Captured
    # The captured stdout (exec_capture: stdout and stderr) as a view.
    # span_from_vec, not `@self.out`: ritz1 emits a ptrtoint, not a Span, for
    # `@` of a Vec field in a Span slot.
    pub fn output(self: @Captured) -> Span<u8>
        span_from_vec<u8>(@self.out)

    # The captured stderr as a view (capture only; empty for exec_capture).
    pub fn err_output(self: @Captured) -> Span<u8>
        span_from_vec<u8>(@self.err)

# Run `bin` with `args` (argv[1..]; argv[0] is `bin`), environment exactly
# `env` ("KEY=VALUE" views; empty is an empty environment, not ours), and
# `stdin` as its whole input; wait for it and capture its output.
#
# `bin` is a path ("./grep", "/bin/sh"): with an empty env there is no PATH to
# search.  A `bin` that is missing or not executable is Err(NoEnt) / Err(Acces)
# before anything forks, not a child that exits 127.
#
# stdin is written to a temp file (sandbox_path("stdin", "in")) that the child
# reads as fd 0: it sees all of it and then a clean EOF, an empty `stdin`
# included, never the harness's own stdin.  Pipe-fed stdin had a ~5% flake
# under the harness on contended boxes, and can SIGPIPE the parent when the
# child never reads it.  The file is unlinked as soon as it is open, so it
# never outlives the call.  Output is read until EOF, not one read(2): a
# read returns on any data, and stopping early truncates (see the header).
pub fn exec_capture(bin: StrView, args: Span<StrView>, env: Span<StrView>, stdin: Span<u8>) -> Result<Captured, Errno>
    var path: String = sandbox_path("stdin", "in")
    let fd_w: i32 = sys_open3(path.as_ptr(), O_WRONLY + O_CREAT + O_TRUNC, 384)
    if fd_w < 0
        return Err(errno_from_raw(fd_w))
    var done: i64 = 0
    while done < stdin.len
        let w: i64 = sys_write(fd_w, stdin.ptr + done, stdin.len - done)
        if w <= 0
            sys_close(fd_w)
            sys_unlink(path.as_ptr())
            return Err(errno_from_raw(w as i32))
        done += w
    sys_close(fd_w)
    let fd_r: i32 = sys_open(path.as_ptr(), O_RDONLY)
    sys_unlink(path.as_ptr())
    if fd_r < 0
        return Err(errno_from_raw(fd_r))

    let spawned: Result<Process, Errno> = spawn_env_merged(bin, args, env, fd_r)
    sys_close(fd_r)
    match spawned
        Ok(p) =>
            var q: Process = p
            let out: Vec<u8> = q.read_stdout_all()
            let waited: Result<ProcessResult, Errno> = q.wait()
            q.cleanup()
            match waited
                Ok(st) => Ok(Captured { status: st, out: out, err: vec_new<u8>() })
                Err(e) => Err(e)
        Err(e) => Err(e)

# Run `body` in a child process (ritzlib.process's spawn_fn) with stdin at
# EOF and its stdout and stderr on two pipes; wait for it and capture both,
# apart.  c.status.exit_code is body's return value, and a body killed by a
# signal is status.signaled.  A test of what a printer writes calls the
# printer in a body: `capture(case_help)`, then buf_eq(c.output(), "...").
#
# Both pipes are drained together (poll), not one then the other: a child
# that fills the stderr pipe (64 KiB) while the parent waits on stdout's EOF
# would block forever.  Err only when a pipe, the fork or the wait fails.
pub fn capture(body: fn() -> i32) -> Result<Captured, Errno>
    var p: Process = spawn_fn(body)?
    p.close_stdin()
    var out: Vec<u8> = vec_new<u8>()
    var err: Vec<u8> = vec_new<u8>()
    let drained: Result<(), Errno> = drain_both(p.stdout(), @&out, p.stderr(), @&err)
    # Before the wait: if the drain failed, a child still writing a full pipe
    # gets EPIPE instead of blocking forever, and the wait returns.
    p.close_pipes()
    let waited: Result<ProcessResult, Errno> = p.wait()
    p.cleanup()
    drained?
    Ok(Captured { status: waited?, out: out, err: err })

# The usual capture test, as one assert-ing helper: `body` exits 0 having
# written exactly `out` to stdout and `err` to stderr.  A failure names the
# calling test's line.
[[test_helper]]
pub fn expect_capture(body: fn() -> i32, out: Span<u8>, err: Span<u8>)
    match capture(body)
        Ok(c) =>
            assert c.status.success()
            assert buf_eq(c.output(), out)
            assert buf_eq(c.err_output(), err)
        Err(_) =>
            assert false, "fork"

# Read `a` into `a_into` and `b` into `b_into` until both are at EOF,
# reading whichever poll says is ready.  The Fds are borrowed: their owner
# closes them.
fn drain_both(a: Fd, a_into: @&Vec<u8>, b: Fd, b_into: @&Vec<u8>) -> Result<(), Errno>
    var fds: [2]PollFd
    # A drained end's slot is -1, which poll skips.
    fds[0] = PollFd { fd: a.raw(), events: POLLIN, revents: 0 }
    fds[1] = PollFd { fd: b.raw(), events: POLLIN, revents: 0 }
    while fds[0].fd >= 0 or fds[1].fd >= 0
        fds[0].revents = 0
        fds[1].revents = 0
        match poll(span_from_ptr<PollFd>(@fds[0], 2), -1)
            Ok(_) => pass
            Err(err) => match err
                Intr => continue
                _ => return Err(err)
        if fds[0].revents != 0 and not read_chunk(a, a_into)?
            fds[0].fd = -1
        if fds[1].revents != 0 and not read_chunk(b, b_into)?
            fds[1].fd = -1
    Ok(())

# One read(2) from `fd` onto `into`: Ok(false) at EOF.
fn read_chunk(fd: Fd, into: @&Vec<u8>) -> Result<bool, Errno>
    var chunk: [4096]u8
    let n: i64 = fd.read(span_from_ptr<u8>(@chunk[0], 4096))?
    into.push_span(span_from_ptr<u8>(@chunk[0], n))
    Ok(n > 0)
