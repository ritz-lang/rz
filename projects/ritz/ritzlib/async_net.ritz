# ritzlib/async_net.ritz - Async TCP networking
#
# io_uring I/O on sockets.  Sockets themselves are ritzlib.net's Socket:
# socket_tcp, Socket.bind / listen / connect / accept / shutdown and the
# option setters, all Result.  This module adds only what goes through the
# runtime's ring: runtime_accept, runtime_send, runtime_recv.
#
# Example server:
#   var srv: Socket = socket_tcp()?
#   srv.set_reuseaddr()?
#   srv.bind("0.0.0.0", 8080)?
#   srv.listen(128)?
#   var client: Socket = runtime_accept(@&rt, @srv)?
#   runtime_send(@&rt, client.raw(), "hello")
#
# Until AGAST #4645 this module duplicated net's API on bare i32 fds with
# 0-or-negative-errno returns (tcp_socket, tcp_bind, tcp_listen, tcp_accept,
# tcp_connect, tcp_shutdown, tcp_getsockname, set_reuseaddr, ...).  Those
# are gone, with no wrappers; tools/test_async_net_api.py keeps them gone.

import ritzlib.sys
import ritzlib.uring
import ritzlib.async.runtime
import ritzlib.result
import ritzlib.errno
# Socket is part of this API (runtime_accept), so importers get it too.
pub import ritzlib.net

# ============================================================================
# Async operations via runtime
# ============================================================================

# Accept a connection on the listening `server` asynchronously via io_uring.
# Ok(the connected Socket) or Err(errno) from submission or the completion.
pub fn runtime_accept(rt: @&Runtime, server: @Socket) -> Result<Socket, Errno>
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    # Get an SQE
    let sqe: @&IoUringSqe = match rt.ring.get_sqe()
        Some(p) => p
        None => return Err(Errno.NoMem)

    # Prepare accept SQE
    sqe.prep_accept(server.raw(), 0, user_data)
    rt.ring.sqe_submit()

    # Submit and wait for completion
    match rt.ring.submit_and_wait(1)
        Ok(_) => pass
        Err(e) => return Err(e)

    # Get the completion
    let cqe: @IoUringCqe = match rt.ring.peek_cqe()
        Some(p) => p
        None => return Err(Errno.Io)

    let result: i32 = cqe.res
    rt.ring.cqe_seen(@*cqe)
    if result < 0
        return Err(errno_from_raw(result))

    return Ok(socket_from_raw(result))

# Send data asynchronously via io_uring.
# Ok(bytes written) or Err(errno) from submission or the completion.
pub fn runtime_send(rt: @&Runtime, fd: i32, buf_sv: Span<u8>) -> Result<i64, Errno>
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    let sqe: @&IoUringSqe = match rt.ring.get_sqe()
        Some(p) => p
        None => return Err(Errno.NoMem)

    # Use WRITE for send (works for sockets)
    sqe.prep_write(fd, buf_sv, 0, user_data)
    rt.ring.sqe_submit()

    match rt.ring.submit_and_wait(1)
        Ok(_) => pass
        Err(e) => return Err(e)

    let cqe: @IoUringCqe = match rt.ring.peek_cqe()
        Some(p) => p
        None => return Err(Errno.Io)

    let result: i64 = cqe.res as i64
    rt.ring.cqe_seen(@*cqe)
    if result < 0
        return Err(errno_from_raw(result as i32))

    return Ok(result)

# Receive data asynchronously via io_uring.
# Ok(bytes read, 0 at EOF) or Err(errno) from submission or the completion.
pub fn runtime_recv(rt: @&Runtime, fd: i32, buf_sv: Span<u8>) -> Result<i64, Errno>
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    let sqe: @&IoUringSqe = match rt.ring.get_sqe()
        Some(p) => p
        None => return Err(Errno.NoMem)

    # Use READ for recv (works for sockets)
    sqe.prep_read(fd, buf_sv, 0, user_data)
    rt.ring.sqe_submit()

    match rt.ring.submit_and_wait(1)
        Ok(_) => pass
        Err(e) => return Err(e)

    let cqe: @IoUringCqe = match rt.ring.peek_cqe()
        Some(p) => p
        None => return Err(Errno.Io)

    let result: i64 = cqe.res as i64
    rt.ring.cqe_seen(@*cqe)
    if result < 0
        return Err(errno_from_raw(result as i32))

    return Ok(result)
