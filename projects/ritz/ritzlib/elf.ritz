# ritzlib/elf.ritz - ELF Binary Format Parser
#
# Parses ELF object files and executables to extract symbol information.
# Used by the test runner to discover test functions from compiled .o files.
#
# ELF64 format reference: https://refspecs.linuxfoundation.org/elf/gabi4+/ch4.eheader.html

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.strview
import ritzlib.endian

# ============================================================================
# ELF Constants
# ============================================================================

# ELF Magic bytes
const ELF_MAGIC_0: u8 = 0x7f
const ELF_MAGIC_1: u8 = 0x45  # 'E'
const ELF_MAGIC_2: u8 = 0x4c  # 'L'
const ELF_MAGIC_3: u8 = 0x46  # 'F'

# ELF Class (32-bit vs 64-bit)
const ELFCLASS64: u8 = 2

# ELF Type (e_type)
pub const ET_EXEC: i16 = 2    # Executable file
pub const ET_DYN: i16 = 3     # Shared object / PIE

# ELF Data encoding
const ELFDATA2LSB: u8 = 1  # Little-endian

# Section header types
const SHT_NULL: i32 = 0
const SHT_SYMTAB: i32 = 2    # Symbol table
const SHT_STRTAB: i32 = 3    # String table
const SHT_DYNSYM: i32 = 11   # Dynamic symbol table

# Symbol binding (upper 4 bits of st_info)
const STB_LOCAL: u8 = 0
const STB_GLOBAL: u8 = 1
const STB_WEAK: u8 = 2

# Symbol type (lower 4 bits of st_info)
const STT_NOTYPE: u8 = 0
const STT_FUNC: u8 = 2

# ============================================================================
# ELF64 Structures
# ============================================================================
# These mirror the ELF64 header structures

# ELF64 File Header (64 bytes)
struct Elf64_Ehdr
    e_ident: [16]u8       # Magic number and other info
    e_type: i16           # Object file type
    e_machine: i16        # Architecture
    e_version: i32        # Object file version
    e_entry: i64          # Entry point virtual address
    e_phoff: i64          # Program header table file offset
    e_shoff: i64          # Section header table file offset
    e_flags: i32          # Processor-specific flags
    e_ehsize: i16         # ELF header size in bytes
    e_phentsize: i16      # Program header table entry size
    e_phnum: i16          # Program header table entry count
    e_shentsize: i16      # Section header table entry size
    e_shnum: i16          # Section header table entry count
    e_shstrndx: i16       # Section header string table index

# ELF64 Section Header (64 bytes)
struct Elf64_Shdr
    sh_name: i32          # Section name (string table index)
    sh_type: i32          # Section type
    sh_flags: i64         # Section flags
    sh_addr: i64          # Section virtual address at execution
    sh_offset: i64        # Section file offset
    sh_size: i64          # Section size in bytes
    sh_link: i32          # Link to another section
    sh_info: i32          # Additional section information
    sh_addralign: i64     # Section alignment
    sh_entsize: i64       # Entry size if section holds table

# ELF64 Symbol Table Entry (24 bytes)
struct Elf64_Sym
    st_name: i32          # Symbol name (string table index)
    st_info: u8           # Symbol type and binding
    st_other: u8          # Symbol visibility
    st_shndx: i16         # Section index
    st_value: i64         # Symbol value
    st_size: i64          # Symbol size

# ============================================================================
# ELF Reader
# ============================================================================

struct ElfReader
    data: *u8             # File data
    size: i64             # File size
    ehdr: *Elf64_Ehdr     # Pointer to ELF header
    shdr: *Elf64_Shdr     # Pointer to section header table
    symtab: *Elf64_Sym    # Pointer to symbol table
    symtab_count: i64     # Number of symbols
    strtab: *u8           # Pointer to string table
    strtab_size: i64      # Bytes in the string table

# Why an ELF image cannot be read.  The reader is left pointing at whatever
# was validly set before the failure (nothing, for a rejected header).
pub enum ElfError
    TooShort       # smaller than an ELF64 header
    NotElf         # wrong magic
    NotElf64       # EI_CLASS is not ELFCLASS64
    BigEndian      # EI_DATA is not little-endian
    NoSections     # e_shoff / e_shnum are zero
    NoSymtab       # no SHT_SYMTAB section

# Header fields are read with ritzlib.endian's little-endian readers, at an
# offset into the image's span: a header that points past the end of the
# image stops the program rather than reading beyond it (AGAST #4644).  A
# symbol name is a StrView of the .strtab string (get_symbol_name); StrView's
# `starts_with` tests its prefix.

# Check if symbol is a function
pub fn elf_is_function(info: u8) -> bool
    let sym_type: u8 = info & 0x0f
    if sym_type == STT_FUNC
        return true
    return false

# Check if symbol is global
pub fn elf_is_global(info: u8) -> bool
    let binding: u8 = info >> 4
    if binding == STB_GLOBAL
        return true
    return false

# Methods (S-IMPL-1): an ElfReader is the subject of every operation on it.
impl ElfReader
    # Initialize an ELF reader from file data.  Ok(()) when `data` is a
    # little-endian ELF64 image with a header.
    pub fn init(self: @&ElfReader, data_sv: Span<u8>) -> Result<(), ElfError>
        let data: *u8 = data_sv.ptr
        let size: i64 = data_sv.len
        self.data = data
        self.size = size
        self.ehdr = null
        self.shdr = null
        self.symtab = null
        self.symtab_count = 0
        self.strtab = null
        self.strtab_size = 0

        # Check minimum size for ELF header
        if size < 64
            return Err(ElfError.TooShort)

        # Check ELF magic
        if *data != ELF_MAGIC_0
            return Err(ElfError.NotElf)
        if *(data + 1) != ELF_MAGIC_1
            return Err(ElfError.NotElf)
        if *(data + 2) != ELF_MAGIC_2
            return Err(ElfError.NotElf)
        if *(data + 3) != ELF_MAGIC_3
            return Err(ElfError.NotElf)

        # Check 64-bit
        if *(data + 4) != ELFCLASS64
            return Err(ElfError.NotElf64)

        # Check little-endian
        if *(data + 5) != ELFDATA2LSB
            return Err(ElfError.BigEndian)

        self.ehdr = data as *Elf64_Ehdr
        return Ok(())

    # The whole image, as a span: header reads are offsets into it.
    pub fn image(self: @ElfReader) -> Span<u8>
        return span_from_ptr<u8>(self.data, self.size)

    # Parse section headers and find symbol/string tables
    # Ok(()) when section headers were found and a symbol table located.
    pub fn parse_sections(self: @&ElfReader) -> Result<(), ElfError>
        let ehdr: *Elf64_Ehdr = self.ehdr
        if ehdr == null
            return Err(ElfError.NoSections)

        let data: *u8 = self.data
        let img: [u8] = self.image()

        # Get section header offset and count
        # Note: We read raw bytes due to potential alignment issues
        let shoff: i64 = endian_read_u64_le(img, 40) as i64  # e_shoff at offset 40
        let shentsize: i32 = endian_read_u16_le(img, 58) as i32  # e_shentsize at offset 58
        let shnum: i32 = endian_read_u16_le(img, 60) as i32  # e_shnum at offset 60

        if shoff == 0 or shnum == 0
            return Err(ElfError.NoSections)

        self.shdr = (data + shoff) as *Elf64_Shdr

        # Find .symtab and .strtab sections
        for i in 0..shnum
            let sh: i64 = shoff + (i as i64 * shentsize as i64)
            let sh_type: i32 = endian_read_u32_le(img, sh + 4) as i32  # sh_type at offset 4

            if sh_type == SHT_SYMTAB
                # Found symbol table
                let sh_offset: i64 = endian_read_u64_le(img, sh + 24) as i64  # sh_offset at offset 24
                let sh_size: i64 = endian_read_u64_le(img, sh + 32) as i64  # sh_size at offset 32
                let sh_entsize: i64 = endian_read_u64_le(img, sh + 56) as i64  # sh_entsize at offset 56
                let sh_link: i32 = endian_read_u32_le(img, sh + 40) as i32  # sh_link at offset 40 (strtab index)

                self.symtab = (data + sh_offset) as *Elf64_Sym
                if sh_entsize > 0
                    self.symtab_count = sh_size / sh_entsize

                # Get the linked string table
                let strtab_sh: i64 = shoff + (sh_link as i64 * shentsize as i64)
                let strtab_offset: i64 = endian_read_u64_le(img, strtab_sh + 24) as i64
                self.strtab = data + strtab_offset
                self.strtab_size = endian_read_u64_le(img, strtab_sh + 32) as i64  # sh_size

        if self.symtab == null
            return Err(ElfError.NoSymtab)

        return Ok(())

    # Get the name of a symbol, or None when the symbol table is absent or the
    # index is out of range.
    # The name is a view of the string table's NUL-terminated entry, bounded
    # by the table's size; a name that runs off the end is None.
    pub fn get_symbol_name(self: @ElfReader, sym_index: i64) -> Option<StrView>
        if self.symtab == null or self.strtab == null
            return None
        if sym_index < 0 or sym_index >= self.symtab_count
            return None

        # Read symbol's st_name field: entries are sizeof(Elf64_Sym) = 24 bytes
        let syms: [u8] = span_from_ptr<u8>(self.symtab as *u8, self.symtab_count * 24)
        let st_name: i32 = endian_read_u32_le(syms, sym_index * 24) as i32

        if st_name < 0 or st_name as i64 >= self.strtab_size
            return None
        let name: *u8 = self.strtab + st_name
        let room: i64 = self.strtab_size - st_name as i64
        var n: i64 = 0
        while n < room and *(name + n) != 0
            n += 1
        if n == room
            return None
        return Some(strview_from_ptr(name, n))

    # Get symbol info byte (type in lower 4 bits, binding in upper 4 bits)
    pub fn get_symbol_info(self: @ElfReader, sym_index: i64) -> u8
        if self.symtab == null
            return 0
        if sym_index < 0 or sym_index >= self.symtab_count
            return 0

        let sym_ptr: *u8 = (self.symtab as *u8) + (sym_index * 24)
        return *(sym_ptr + 4)  # st_info at offset 4

    # Get number of symbols
    pub fn symbol_count(self: @ElfReader) -> i64
        return self.symtab_count

    # Count the global functions whose name starts with "test_".  (It took a
    # `callback: *u8, user_data: *u8` pair it never called until AGAST #4644;
    # nothing passed one.)
    pub fn find_test_functions(self: @ElfReader) -> i32
        var count: i32 = 0
        var i: i64 = 0

        while i < self.symtab_count
            let info: u8 = self.get_symbol_info(i)

            # Only look at global functions
            if elf_is_function(info) and elf_is_global(info)
                match self.get_symbol_name(i)
                    Some(name) =>
                        if name.starts_with("test_")
                            count += 1
                    None => pass

            i += 1

        return count

    # Print all test functions found in an ELF file
    pub fn print_test_functions(self: @ElfReader)
        print("Test functions found:\n")
        var i: i64 = 0

        while i < self.symtab_count
            let info: u8 = self.get_symbol_info(i)

            if elf_is_function(info) and elf_is_global(info)
                match self.get_symbol_name(i)
                    Some(name) =>
                        if name.starts_with("test_")
                            print("  {name}\n")
                    None => pass

            i += 1
