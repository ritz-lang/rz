# ritzlib/timer.ritz - High-performance timing utilities
#
# Provides nanosecond-precision timing for benchmarking and profiling.
# Uses clock_gettime(CLOCK_MONOTONIC) for reliable, monotonic timestamps.

import ritzlib.sys
import ritzlib.io


# ============================================================================
# Constants
# ============================================================================

pub const CLOCK_REALTIME: i32 = 0
pub const CLOCK_MONOTONIC: i32 = 1
pub const CLOCK_PROCESS_CPUTIME_ID: i32 = 2
pub const CLOCK_THREAD_CPUTIME_ID: i32 = 3
pub const CLOCK_MONOTONIC_RAW: i32 = 4
pub const CLOCK_REALTIME_COARSE: i32 = 5
pub const CLOCK_MONOTONIC_COARSE: i32 = 6

# SYS_CLOCK_GETTIME: ritzlib.sys (AGAST #1857).

pub const NANOS_PER_SEC: i64 = 1000000000
pub const NANOS_PER_MILLI: i64 = 1000000
pub const NANOS_PER_MICRO: i64 = 1000


# ============================================================================
# Timespec structure
# ============================================================================

struct Timespec
    tv_sec: i64
    tv_nsec: i64


# ============================================================================
# Timer structure for elapsed time measurement
# ============================================================================

struct Timer
    start: Timespec
    end: Timespec


# ============================================================================
# Functions
# ============================================================================

# Get current time with nanosecond precision. `ts` is the kernel's output.
pub fn clock_gettime(clock_id: i32, ts: @&Timespec) -> i32
    let ret = syscall2(SYS_CLOCK_GETTIME, clock_id as i64, ts as i64)
    return ret as i32


# Get monotonic time in nanoseconds (since some unspecified epoch).
# CLOCK_MONOTONIC does not fail on Linux, so there is no error to report; a
# failed syscall (never observed) leaves `ts` zeroed and yields 0.
pub fn now_nanos() -> i64
    var ts: Timespec
    ts.tv_sec = 0
    ts.tv_nsec = 0
    clock_gettime(CLOCK_MONOTONIC, @&ts)
    return ts.tv_sec * NANOS_PER_SEC + ts.tv_nsec


# Get monotonic time in microseconds
pub fn now_micros() -> i64
    return now_nanos() / NANOS_PER_MICRO


# Get monotonic time in milliseconds
pub fn now_millis() -> i64
    return now_nanos() / NANOS_PER_MILLI


# Methods (S-IMPL-1): a Timer is the subject of every operation on it.
impl Timer
    # Initialize a timer
    pub fn init(self: *Timer) -> i32
        self.start.tv_sec = 0
        self.start.tv_nsec = 0
        self.end.tv_sec = 0
        self.end.tv_nsec = 0
        return 0

    # Start the timer
    pub fn start(self: *Timer) -> i32
        return clock_gettime(CLOCK_MONOTONIC, @&self.start)

    # Stop the timer
    pub fn stop(self: *Timer) -> i32
        return clock_gettime(CLOCK_MONOTONIC, @&self.end)

    # Get elapsed time in nanoseconds
    pub fn elapsed_nanos(self: *Timer) -> i64
        let start_ns = self.start.tv_sec * NANOS_PER_SEC + self.start.tv_nsec
        let end_ns = self.end.tv_sec * NANOS_PER_SEC + self.end.tv_nsec
        return end_ns - start_ns

    # Get elapsed time in microseconds
    pub fn elapsed_micros(self: *Timer) -> i64
        return self.elapsed_nanos() / NANOS_PER_MICRO

    # Get elapsed time in milliseconds
    pub fn elapsed_millis(self: *Timer) -> i64
        return self.elapsed_nanos() / NANOS_PER_MILLI

    # Get elapsed time in seconds (as floating point approximation via i64)
    # Returns microseconds * 1000 for 3 decimal places of precision
    pub fn elapsed_secs_x1000(self: *Timer) -> i64
        return self.elapsed_micros() * 1000 / NANOS_PER_MICRO

    # Print elapsed time in human-readable format
    pub fn print(self: *Timer) -> i32
        let ns = self.elapsed_nanos()
        if ns < 1000
            print("{ns}ns")
        else if ns < 1000000
            let frac = (ns % 1000) / 100
            print("{ns / 1000}.{frac}µs")
        else if ns < 1000000000
            let frac = (ns % 1000000) / 100000
            print("{ns / 1000000}.{frac}ms")
        else
            let frac = (ns % 1000000000) / 100000000
            print("{ns / 1000000000}.{frac}s")
        return 0


# ============================================================================
# Stopwatch for cumulative timing
# ============================================================================

struct Stopwatch
    total_ns: i64
    count: i64
    running: i32
    start_ns: i64


# A Stopwatch is the subject of every operation on it (S-IMPL-1).
impl Stopwatch
    pub fn init(self: *Stopwatch) -> i32
        self.total_ns = 0
        self.count = 0
        self.running = 0
        self.start_ns = 0
        return 0

    # Start the stopwatch.  false if it was already running.
    pub fn start(self: *Stopwatch) -> bool
        if self.running != 0
            return false    # Already running
        self.running = 1
        self.start_ns = now_nanos()
        return true

    # Stop the stopwatch.  false if it was not running.
    pub fn stop(self: *Stopwatch) -> bool
        if self.running == 0
            return false    # Not running
        let end_ns = now_nanos()
        self.total_ns = self.total_ns + (end_ns - self.start_ns)
        self.count = self.count + 1
        self.running = 0
        return true

    pub fn reset(self: *Stopwatch) -> i32
        self.total_ns = 0
        self.count = 0
        self.running = 0
        self.start_ns = 0
        return 0

    pub fn total_nanos(self: *Stopwatch) -> i64
        return self.total_ns

    pub fn avg_nanos(self: *Stopwatch) -> i64
        if self.count == 0
            return 0
        return self.total_ns / self.count

    pub fn count(self: *Stopwatch) -> i64
        return self.count

    # Print stopwatch stats
    pub fn print(self: *Stopwatch) -> i32
        print("Stopwatch: total={self.total_ns / 1000000}ms, count={self.count}, avg=")
        if self.count > 0
            let avg_us = self.total_ns / self.count / 1000
            print("{avg_us}µs")
        else
            print("N/A")
        return 0
