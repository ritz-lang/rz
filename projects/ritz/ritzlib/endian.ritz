# ritzlib/endian.ritz - big- and little-endian integers in a byte buffer

# Reading and writing multi-byte integers out of a byte buffer, in the byte
# order a wire or file format chose.  This is the one copy for the ecosystem
# (AGAST #1858, LARB review/4 infra.md M6): before it, every package that
# parsed a format carried its own `be16_2182`, `load32_le`, `read_key_len`,
# `load_be64`, nine spellings of the same four shifts.
#
# A read takes a pointer to the first byte and returns the integer; a write
# takes the pointer and the value and stores the integer's bytes there.  The
# functions are byte-addressed, so the pointer need not be aligned (MADT
# entries, TCP headers and ELF records are packed).  There is no bounds
# check: the caller owns the buffer, as with `*u8` everywhere.
#
# This is the byte-codec/C-ABI boundary the standard's raw-ptr-param rule
# documents as exempt (S-PTR-1): the raw `*u8` is the API, not an accident.
# Callers pass `p + n` into the middle of a larger buffer they own, and no
# length exists at the call boundary (`sha512_transform(ctx, block: *u8)`
# is exactly 128 bytes; `poly1305_init(ctx, key: *u8)` exactly 32), so a
# Span parameter could not check anything -- it would have to invent a
# length.  Every entry point below carries an exemption naming that reason.
#
# Naming is §15.3's prefixed free functions, so a caller writes
# `endian_read_u16_be(p)` and there is no doubt which integer, order or
# direction it is.  Integer byte swapping itself is the language's
# `x.swap_bytes()` (ritzlib/tests/test_bitops.ritz), not this module.

# ============================================================================
# Reads
# ============================================================================

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u16_be(p: *u8) -> u16
    let b0: u16 = (*p) as u16
    let b1: u16 = (*(p + 1)) as u16
    return (b0 << 8) | b1

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u16_le(p: *u8) -> u16
    let b0: u16 = (*p) as u16
    let b1: u16 = (*(p + 1)) as u16
    return b0 | (b1 << 8)

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u32_be(p: *u8) -> u32
    let b0: u32 = (*p) as u32
    let b1: u32 = (*(p + 1)) as u32
    let b2: u32 = (*(p + 2)) as u32
    let b3: u32 = (*(p + 3)) as u32
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u32_le(p: *u8) -> u32
    let b0: u32 = (*p) as u32
    let b1: u32 = (*(p + 1)) as u32
    let b2: u32 = (*(p + 2)) as u32
    let b3: u32 = (*(p + 3)) as u32
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u64_be(p: *u8) -> u64
    let lo: u64 = endian_read_u32_be(p + 4) as u64
    let hi: u64 = endian_read_u32_be(p) as u64
    return (hi << 32) | lo

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 read at a caller-chosen offset, no length at the call boundary
pub fn endian_read_u64_le(p: *u8) -> u64
    let lo: u64 = endian_read_u32_le(p) as u64
    let hi: u64 = endian_read_u32_le(p + 4) as u64
    return lo | (hi << 32)

# ============================================================================
# Writes
# ============================================================================

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u16_be(p: *u8, v: u16)
    *(p + 0) = ((v >> 8) & 0xff) as u8
    *(p + 1) = (v & 0xff) as u8

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u16_le(p: *u8, v: u16)
    *(p + 0) = (v & 0xff) as u8
    *(p + 1) = ((v >> 8) & 0xff) as u8

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u32_be(p: *u8, v: u32)
    *(p + 0) = ((v >> 24) & 0xff) as u8
    *(p + 1) = ((v >> 16) & 0xff) as u8
    *(p + 2) = ((v >> 8) & 0xff) as u8
    *(p + 3) = (v & 0xff) as u8

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u32_le(p: *u8, v: u32)
    *(p + 0) = (v & 0xff) as u8
    *(p + 1) = ((v >> 8) & 0xff) as u8
    *(p + 2) = ((v >> 16) & 0xff) as u8
    *(p + 3) = ((v >> 24) & 0xff) as u8

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u64_be(p: *u8, v: u64)
    endian_write_u32_be(p, (v >> 32) as u32)
    endian_write_u32_be(p + 4, (v & 0xffffffff) as u32)

# standard-exempt: raw-ptr-param: byte-codec boundary; unaligned *u8 write at a caller-chosen offset, the caller owns the buffer length
pub fn endian_write_u64_le(p: *u8, v: u64)
    endian_write_u32_le(p, (v & 0xffffffff) as u32)
    endian_write_u32_le(p + 4, (v >> 32) as u32)
