# ritzlib/mapping.ritz - mmap_anon, mmap_shared and munmap: mappings as Result<Span<u8>, Errno>
#
# The typed layer over sys.ritz's sys_mmap / sys_munmap (AGAST #4638). The
# raw syscalls return a pointer that holds -errno on failure (-12, not -1)
# and an i32 status; these return a Result whose Err is a ritzlib.errno
# `Errno`, and a mapping is a Span<u8> that carries its own length:
#
#     match mmap_anon(64 * 1024)
#         Ok(m) =>
#             var buf: Span<u8> = m        # zeroed, read-write, private
#             ...
#             munmap(buf)                  # Result<(), Errno>
#         Err(e) => ...                    # NoMem, Inval (length <= 0), ...
#
# Ownership: the Span from mmap_anon owns the mapping and must be passed to
# munmap once, whole (munmap of a sub-span unmaps just those pages, and an
# unaligned start is Err(Inval)). sys_mmap / sys_mmap_anon stay the raw
# boundary for the page source and kernels.
#
# mmap_shared maps a file (a memfd, as zeus hands its rings between
# processes) shared and read-write, as the same kind of Span; munmap
# releases it the same way.
import ritzlib.sys
import ritzlib.span
import ritzlib.result
import ritzlib.fd { Fd }
# Errno is part of this API (every Err), so importers get it too.
pub import ritzlib.errno

# `len` bytes of zeroed, private, read-write memory, or the kernel's error:
# Err(Inval) for a length of 0 or less (mmap(2) would refuse 0 the same way;
# a negative one is refused here before it becomes a huge unsigned size).
pub fn mmap_anon(len: i64) -> Result<Span<u8>, Errno>
    if len <= 0
        return Err(Errno.Inval)
    mapped(sys_mmap_anon(len), len)

# The first `len` bytes of the file behind `fd`, mapped shared and
# read-write: a store reaches the file, and every other mapping of it (a
# memfd passed to another process sees the same bytes). Err(Inval) for a
# length of 0 or less, else the kernel's error: BadF for a closed fd,
# Acces for one not open read-write. A mapping past the file's end is
# allowed, but touching a page wholly past it raises SIGBUS: size the file
# first (Fd.truncate).
# standard-exempt: raw-alloc: ritzlib.mapping IS the mmap owner: mmap_shared makes the mapping munmap releases
[[target_os = "linux"]]
pub fn mmap_shared(fd: @Fd, len: i64) -> Result<Span<u8>, Errno>
    if len <= 0
        return Err(Errno.Inval)
    mapped(sys_mmap(0, len, PROT_READ + PROT_WRITE, MAP_SHARED, fd.raw(), 0), len)

# What sys_mmap returned for `len` bytes, as a Result.
fn mapped(p: *u8, len: i64) -> Result<Span<u8>, Errno>
    let raw: i64 = p as i64
    # Linux returns -errno in [-4095, -1]; harland -errno too. No user
    # mapping is at 0 or in the negative (kernel) half (memory.mmap_failed).
    if raw <= 0
        if raw == 0
            return Err(Errno.NoMem)
        return Err(errno_from_raw(raw as i32))
    Ok(span_from_ptr<u8>(p, len))

# Unmap what one mmap_anon or mmap_shared returned. Err(Inval) for an
# unaligned start.
# standard-exempt: raw-alloc: ritzlib.mapping IS the mmap owner: munmap releases the mapping mmap_anon made
pub fn munmap(m: Span<u8>) -> Result<(), Errno>
    let rc: i32 = sys_munmap(m.ptr, m.len)
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(())
