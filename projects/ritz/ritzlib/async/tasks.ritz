# ritzlib/async/tasks.ritz - Multi-task async executor with io_uring
#
# This module provides concurrent task execution for servers:
#   - TaskPool: Fixed-size pool of async tasks
#   - spawn_task: Add a new task to the pool
#   - run_tasks: Event loop that polls all tasks concurrently
#
# Design:
#   Each task has state (IDLE, WAITING, READY) and a user_data.
#   When io_uring completes, we find the task by user_data and mark it READY.
#   The event loop processes all READY tasks, which may submit new I/O.
#
# Usage:
#   var pool: TaskPool
#   task_pool_init(@pool)
#
#   # In accept loop, spawn connection handlers
#   spawn_task(@pool, client_fd, handle_connection)
#
#   # Run all tasks until idle
#   run_tasks(@pool, @ring)

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async_net
import ritzlib.iovec
import ritzlib.option

# ============================================================================
# Constants
# ============================================================================

const MAX_TASKS: i32 = 256              # Maximum concurrent tasks
const TASK_BUFFER_SIZE: i32 = 8192      # Per-task I/O buffer size

# Task states
const TASK_IDLE: i32 = 0                # Slot is unused
const TASK_WAITING: i32 = 1             # Waiting for I/O completion
const TASK_READY: i32 = 2               # Ready to be polled

# Error codes
const ETIME: i32 = -62                  # Timer expired (from io_uring timeout)

# Sentinel value for `task.io_result` indicating no I/O has completed yet.
# Used to distinguish "fresh task — please submit your initial I/O" from
# "I/O completed with 0 bytes" (clean EOF).  The value is chosen to be
# outside the range of any plausible recv() result (recv on an 8 KiB buffer
# returns 0..8192 or a small negative errno).
pub const TASK_IO_FRESH: i32 = 0x40000000

# ============================================================================
# Task - A single async task
# ============================================================================

struct Task
    # Task identity
    id: i64                             # Unique task ID (matches user_data)
    state: i32                          # IDLE, WAITING, READY

    # I/O state
    fd: i32                             # File descriptor for this task
    io_result: i32                      # Result from last I/O operation

    # Handler callback and state machine
    handler: fn(*Task) -> i32           # Poll function (-1=pending, else=done)
    handler_state: i32                  # State machine position

    # Buffers for I/O
    read_buf: [8192]u8
    write_buf: [8192]u8
    read_len: i32                       # Bytes in read buffer
    write_len: i32                      # Bytes to write
    write_pos: i32                      # Current write position

    # User data pointer (for handler context)
    user_data: *u8

    # Keep-alive state
    request_count: i32              # Number of requests handled on this connection

    # Vectored I/O builder for zero-copy responses
    iov_builder: IoVecBuilder

    # Idle timeout tracking
    last_activity: i64              # Unix timestamp of last activity (seconds)

# ============================================================================
# TaskPool - Pool of async tasks
# ============================================================================

struct TaskPool
    tasks: [256]Task                    # Fixed task array
    next_id: i64                        # Next task ID to assign
    active_count: i32                   # Number of active tasks
    ring: *IoUring                      # io_uring instance (external)

# Make the task named by `task_id` READY with `result`.  An I/O completion for
# a task that is no longer live is dropped: there is nothing to wake.
fn task_pool_wake(pool: *TaskPool, task_id: i64, result: i32)
    # ritz1 mis-emits a bare `match` on a method returning Option<*T>; bind
    # the Option to a typed local first (AGAST #4445).
    let found: Option<*Task> = pool.find(task_id)
    let task: *Task = match found
        Some(t) => t
        None => return
    task.io_result = result
    task.state = TASK_READY

# ============================================================================
# Time helpers
# ============================================================================

# Get current time in seconds (for idle timeout tracking)
pub fn get_current_time() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec

# ============================================================================
# Task lifecycle
# ============================================================================

# ============================================================================
# I/O helpers for tasks
# ============================================================================

# ============================================================================
# Simplified I/O helpers (use pool stored in task.user_data)
# ============================================================================

# ============================================================================
# Zero-copy send operations (kernel 6.0+)
# ============================================================================
#
# Zero-copy send avoids the kernel copy from userspace to socket buffer.
# The kernel references the userspace buffer directly until TCP ACK.
#
# IMPORTANT: The write buffer MUST remain valid until CQE is received!
# This is naturally satisfied when using task.write_buf since tasks
# are not recycled until I/O completes.

# ============================================================================
# Splice operations (zero-copy between file descriptors)
# ============================================================================
#
# Splice transfers data between two fds without copying through userspace.
# For sendfile-style operations over io_uring, use splice with a pipe.

# ============================================================================
# Event loop
# ============================================================================

# ============================================================================
# High-level server pattern: Accept loop with task spawning
# ============================================================================

# Server context for accept loop
struct TaskServer
    listen_fd: i32
    pool: TaskPool
    ring: IoUring
    accept_user_data: i64               # Special user_data for accept
    running: i32
    # Shutdown hook - called once per event loop iteration
    # Return non-zero to trigger shutdown
    shutdown_hook: fn() -> i32
    # Idle timeout in seconds (0 = disabled)
    idle_timeout: i32
    # Special user_data for timeout
    timeout_user_data: i64
    # Timeout spec for idle check timer (1 second intervals)
    timeout_ts: KernelTimespec
    # Maximum concurrent connections (0 = unlimited)
    max_connections: i32

# Allocate and initialise a TaskServer (~5MB, too large for the stack).  A raw
# pointer, null on allocation or init failure; private to the boundary, so the
# public constructor can report the same failure as None.
fn task_server_alloc(listen_fd: i32) -> *TaskServer
    # TaskServer is large due to TaskPool containing arrays
    # Allocate via mmap
    let size: i64 = 5 * 1024 * 1024  # 5MB to be safe
    let flags: i32 = MAP_PRIVATE + MAP_ANONYMOUS
    let prot: i32 = PROT_READ + PROT_WRITE
    let ptr: *u8 = sys_mmap(0, size, prot, flags, -1, 0)
    if ptr == (-1 as *u8)
        return null

    let srv: *TaskServer = ptr as *TaskServer
    let ret: i32 = srv.init(listen_fd)
    if ret < 0
        sys_munmap(ptr, size)
        return null

    return srv

# Create a TaskServer on the heap.  None on allocation or init failure.
pub fn task_server_create(listen_fd: i32) -> Option<*TaskServer>
    let srv: *TaskServer = task_server_alloc(listen_fd)
    if srv == null
        return None
    return Some(srv)

# ============================================================================
# Internal: Core event loop - shared by both accept modes
# ============================================================================

# ============================================================================
# Public API: Server run modes
# ============================================================================

# ============================================================================
# Methods (S-IMPL-1): each type is the subject of every operation on it.
# ============================================================================

impl TaskPool
    # Initialize the task pool
    pub fn init(self: *TaskPool, ring: @&IoUring)
        self.next_id = 1
        self.active_count = 0
        self.ring = ring

        # Initialize all task slots
        for i in 0..MAX_TASKS
            let task = @&self.tasks[i]
            task.id = 0
            task.state = TASK_IDLE
            task.fd = -1
            task.io_result = TASK_IO_FRESH
            task.handler = null
            task.handler_state = 0
            task.read_len = 0
            task.write_len = 0
            task.write_pos = 0
            task.user_data = null

    # Find a free task slot, or None if the pool is full.
    pub fn alloc(self: *TaskPool) -> Option<*Task>
        for i in 0..MAX_TASKS
            if self.tasks[i].state == TASK_IDLE
                return Some(@self.tasks[i])
        return None

    # Find a live task by its ID (user_data), or None if there is none.
    pub fn find(self: *TaskPool, task_id: i64) -> Option<*Task>
        for i in 0..MAX_TASKS
            if self.tasks[i].id == task_id
                if self.tasks[i].state != TASK_IDLE
                    return Some(@self.tasks[i])
        return None

    # Spawn a new task for handling a connection.
    # true on success, false if the pool is full.
    pub fn spawn(self: *TaskPool, fd: i32, handler: fn(*Task) -> i32) -> bool
        let found: Option<*Task> = self.alloc()
        let task: *Task = match found
            Some(t) => t
            None => return false

        # Initialize the task
        task.id = self.next_id
        self.next_id += 1
        task.state = TASK_READY          # Start in READY state for first poll
        task.fd = fd
        task.io_result = TASK_IO_FRESH   # Sentinel: no I/O has completed yet
        task.handler = handler
        task.handler_state = 0
        task.read_len = 0
        task.write_len = 0
        task.write_pos = 0
        task.user_data = self as *u8     # Store self pointer for I/O helpers
        task.request_count = 0           # No requests yet
        task.last_activity = get_current_time()  # Initialize activity timestamp

        self.active_count += 1
        return true

    # Mark a task as complete and free its slot
    pub fn complete(self: *TaskPool, task: @&Task)
        # Close the fd if still open
        if task.fd >= 0
            sys_close(task.fd)
            task.fd = -1

        task.state = TASK_IDLE
        task.id = 0
        self.active_count -= 1

    # Submit an async recv for a task
    # Returns true once queued, false if the SQ is full (no SQE).
    pub fn submit_recv(self: *TaskPool, task: @&Task) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        sqe.prep_recv(task.fd, Span<u8> { ptr: @task.read_buf[0], len: TASK_BUFFER_SIZE as i64 }, 0, task.id)
        self.ring.sqe_submit()  # Advance the SQ tail
        task.state = TASK_WAITING
        return true

    # Submit an async send for a task
    # Returns true once queued, false if the SQ is full (no SQE).
    # standard-exempt: ptr-len-param: false positive: `task` is a *Task, `len` its buffer length, not a byte span
    pub fn submit_send(self: *TaskPool, task: @&Task, len: i32) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        task.write_len = len
        task.write_pos = 0
        sqe.prep_send(task.fd, Span<u8> { ptr: @task.write_buf[0], len: len as i64 }, 0, task.id)
        self.ring.sqe_submit()  # Advance the SQ tail
        task.state = TASK_WAITING
        return true

    # Submit a relative timeout SQE.  When the timer fires, the runtime
    # wakes the task with `io_result` set to the kernel return code
    # (typically -ETIME / -62 for a clean timeout).  Used to yield the
    # task while polling user-space state — e.g. valet's proxy waiting on
    # a shm-ring response from a zeus worker without blocking other
    # connections in-flight.
    #
    # The KernelTimespec MUST live until the CQE fires.  Pass a pointer
    # into stable storage (a Task field, a static, or the task's own
    # read/write buf) — not a stack temporary.
    pub fn submit_timeout(self: *TaskPool, task: @&Task, ts: @&KernelTimespec) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        # count=0, flags=0 means "fire after the relative duration in ts".
        sqe.prep_timeout(ts, 0, 0, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit a NOP SQE keyed on the task.  NOP fires immediately and is the
    # only universally-supported "wake me up when the kernel processes the
    # next batch" primitive — IORING_OP_TIMEOUT returns EINVAL on some
    # kernels (including WSL2 6.6), and IORING_OP_FUTEX_WAIT is 6.7+.
    #
    # Use cases:
    #   * Cooperative yield: a handler that's polling user-space state
    #     (e.g. a shm-ring response) submits a NOP and yields the task.
    #     The framework dispatches CQE→handler on next loop iteration,
    #     letting other tasks run in between.
    #
    # Cost: tight polling loop while the task is "yielded" — but cheaper
    # than blocking the whole io_uring loop on a futex_wait syscall, and it
    # allows N concurrent tasks to actually overlap their async work.
    pub fn submit_nop(self: *TaskPool, task: @&Task) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        sqe.prep_nop(task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit an async send of `len` bytes from an external buffer.  Unlike
    # task_send, it does not touch task.write_len / write_pos — the caller
    # tracks progress through `buf` (short sends are the caller's to resume).
    # The buffer MUST stay valid until the CQE arrives.  Returns true once queued, false if the SQ is full (no SQE).
    # The _submit_ form takes the pool explicitly, for handlers that keep
    # their own state in task.user_data (tome, valet's TLS path).
    pub fn submit_send_buf(self: *TaskPool, task: @&Task, buf_sv: Span<u8>) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false
        sqe.prep_send(task.fd, buf_sv, 0, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit an async recv of up to `len` bytes into an external buffer (for
    # requests that outgrow task.read_buf).  The buffer MUST stay valid until
    # the CQE arrives.  Returns true once queued, false if the SQ is full (no SQE).
    pub fn submit_recv_buf(self: *TaskPool, task: @&Task, buf_sv: Span<u8>) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false
        sqe.prep_recv(task.fd, buf_sv, 0, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit an async vectored send for a task
    # iov is the array of Iovec structs and carries its own count
    # Returns true once queued, false if the SQ is full (no SQE).
    pub fn submit_sendv(self: *TaskPool, task: @&Task, iov: Span<Iovec>) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        # Use writev with offset=-1 to indicate no seek (for sockets)
        sqe.prep_writev(task.fd, iov, -1, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit an async zero-copy send for a task
    # Uses the task's write_buf, which must remain valid until completion
    # Returns true once queued, false if the SQ is full (no SQE).
    # Errors from the operation itself arrive in the CQE.
    # standard-exempt: ptr-len-param: false positive: `task` is a *Task, `len` its buffer length, not a byte span
    pub fn submit_send_zc(self: *TaskPool, task: @&Task, len: i32) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        task.write_len = len
        task.write_pos = 0
        sqe.prep_send_zc(task.fd, Span<u8> { ptr: @task.write_buf[0], len: len as i64 }, 0, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit an async zero-copy send from an external buffer
    # CAUTION: The buffer MUST remain valid until CQE is received!
    # Use this for sending data that's already in a stable location
    # (e.g., static .rodata strings, mmap'd files, pre-allocated pools)
    pub fn submit_send_zc_buf(self: *TaskPool, task: @&Task, buf_sv: Span<u8>) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        sqe.prep_send_zc(task.fd, buf_sv, 0, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Submit a splice operation
    # fd_out: destination fd (e.g., socket)
    # fd_in: source fd (e.g., file)
    # off_in: offset in source file (-1 to use and update file position)
    # len: number of bytes to transfer
    # Returns true once queued, false if the SQ is full (no SQE).
    # Errors from the operation itself arrive in the CQE.
    pub fn submit_splice(self: *TaskPool, task: @&Task, fd_out: i32, fd_in: i32, off_in: i64, len: u32, splice_flags: i32) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        # For sockets, off_out should be -1 (non-seekable)
        sqe.prep_splice(fd_out, -1, fd_in, off_in, len, splice_flags, task.id)
        self.ring.sqe_submit()
        task.state = TASK_WAITING
        return true

    # Run all tasks, polling READY tasks and waiting for I/O
    # Returns when all tasks are complete
    pub fn run(self: *TaskPool) -> i32
        loop
            # First, poll all READY tasks
            var submitted: i32 = 0
            for i in 0..MAX_TASKS
                let task = @&self.tasks[i]
                if task.state == TASK_READY
                    # Poll the handler (extract fn ptr first)
                    let h: fn(*Task) -> i32 = task.handler
                    let result = h(task)
                    if result >= 0
                        # Task is complete
                        self.complete(task)
                    # If result < 0 (pending), handler should have submitted I/O

            # Submit any pending SQEs
            self.ring.submit()

            # Count active tasks
            if self.active_count == 0
                break

            # Wait for at least one completion
            match self.ring.submit_and_wait(1)
                Ok(_) => pass
                Err(e) => return -e.code()

            # Process all available CQEs
            loop
                let cqe: *IoUringCqe = match self.ring.peek_cqe()
                    Some(p) => p
                    None => break

                # Find the task and wake it
                task_pool_wake(self, cqe.user_data, cqe.res)

                self.ring.cqe_seen(@*cqe)

        return 0

impl Task
    # Submit recv using pool from task.user_data
    pub fn recv(self: *Task) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_recv(self)

    # Submit timeout using pool from task.user_data
    pub fn timeout(self: *Task, ts: @&KernelTimespec) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_timeout(self, ts)

    # Submit NOP using pool from task.user_data
    pub fn yield(self: *Task) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_nop(self)

    # Submit send using pool from task.user_data
    # standard-exempt: ptr-len-param: false positive: `task` is a *Task, `len` its buffer length, not a byte span
    pub fn send(self: *Task, len: i32) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_send(self, len)

    pub fn send_buf(self: *Task, buf: Span<u8>) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_send_buf(self, buf)

    pub fn recv_buf(self: *Task, buf: Span<u8>) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_recv_buf(self, buf)

    # Submit vectored send using pool from task.user_data
    pub fn sendv(self: *Task, iov: Span<Iovec>) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_sendv(self, iov)

    # Submit vectored send using the task's built-in IoVecBuilder
    # Call this after building a response in task.iov_builder
    pub fn sendv_builder(self: *Task) -> bool
        let pool = self.user_data as *TaskPool
        let iov: Span<Iovec> = Span<Iovec> { ptr: (self.iov_builder.ptr()), len: (self.iov_builder.count()) as i64 }
        return pool.submit_sendv(self, iov)

    # Submit zero-copy send using pool from task.user_data
    # standard-exempt: ptr-len-param: false positive: `task` is a *Task, `len` its buffer length, not a byte span
    pub fn send_zc(self: *Task, len: i32) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_send_zc(self, len)

    # Zero-copy send from external buffer (simplified API)
    pub fn send_zc_buf(self: *Task, buf: Span<u8>) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_send_zc_buf(self, buf)

    # Submit splice using pool from task.user_data
    # Transfers len bytes from fd_in at off_in to task's socket (task.fd)
    pub fn splice(self: *Task, fd_in: i32, off_in: i64, len: u32, splice_flags: i32) -> bool
        let pool = self.user_data as *TaskPool
        return pool.submit_splice(self, self.fd, fd_in, off_in, len, splice_flags)

    # Reset task state for keep-alive (after send completes, prepare for next recv)
    # This properly handles the task state so it will poll and submit a new recv
    pub fn reset_for_recv(self: *Task) -> bool
        let pool = self.user_data as *TaskPool

        # Reset state for next request
        self.handler_state = 0      # Back to RECV state
        self.io_result = 0          # Clear previous I/O result
        self.read_len = 0           # Clear read buffer

        # Submit the next recv directly (don't wait for next poll)
        return pool.submit_recv(self)

impl TaskServer
    pub fn init(self: *TaskServer, listen_fd: i32) -> i32
        self.listen_fd = listen_fd
        self.accept_user_data = 0            # Reserve 0 for accept
        self.running = 0
        self.shutdown_hook = null
        self.idle_timeout = 0
        self.max_connections = 0             # 0 = unlimited
        # Use a large positive value for timeout user_data
        # Task IDs start at 1 and increment, so this won't conflict
        self.timeout_user_data = 0x7FFFFFFE

        # Initialize timeout timespec
        self.timeout_ts.tv_sec = 0
        self.timeout_ts.tv_nsec = 0

        # Initialize io_uring
        let ret = self.ring.init(256)
        if ret < 0
            return ret

        # Initialize task pool
        (@self.pool).init(@&self.ring)
        return 0

    # Set a shutdown hook that's called once per event loop iteration
    # Hook returns non-zero to trigger shutdown
    pub fn set_shutdown_hook(self: *TaskServer, hook: fn() -> i32)
        self.shutdown_hook = hook

    # Set idle timeout for connections (in seconds, 0 = disabled)
    pub fn set_idle_timeout(self: *TaskServer, timeout_secs: i32)
        self.idle_timeout = timeout_secs

    pub fn set_max_connections(self: *TaskServer, max_conns: i32)
        self.max_connections = max_conns

    # Submit a timeout SQE to wake up the event loop periodically for idle checks
    # Uses 1-second intervals to balance responsiveness with overhead
    # NOTE: Currently disabled - io_uring timeout causing EINVAL on some systems
    pub fn submit_idle_timeout(self: *TaskServer) -> i32
        # DISABLED: The io_uring timeout is returning EINVAL
        # For now, idle timeouts only work when there's other activity
        return 0

        # Original implementation:
        # if srv.idle_timeout <= 0
        #     return 0
        # let sqe = uring_get_sqe(@srv.ring)
        # if sqe == null
        #     return -12
        # srv.timeout_ts.tv_sec = 1
        # srv.timeout_ts.tv_nsec = 0
        # uring_prep_timeout(sqe, @srv.timeout_ts, 0, 0, srv.timeout_user_data)
        # uring_sqe_submit(@srv.ring)
        # return 0

    pub fn destroy(self: *TaskServer)
        self.ring.destroy()

    # Free a heap-allocated TaskServer
    pub fn free(self: *TaskServer)
        if self == null
            return
        self.destroy()
        let size: i64 = 5 * 1024 * 1024
        sys_munmap(self as *u8, size)

    # Submit an accept SQE
    pub fn submit_accept(self: *TaskServer) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        sqe.prep_accept(self.listen_fd, 0, self.accept_user_data)
        self.ring.sqe_submit()  # Advance the SQ tail
        return true

    # Submit a multishot accept SQE (kernel 5.19+)
    # Only needs to be submitted once - generates continuous CQEs for new connections
    pub fn submit_accept_multishot(self: *TaskServer) -> bool
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return false

        sqe.prep_accept_multishot(self.listen_fd, 0, self.accept_user_data)
        self.ring.sqe_submit()
        return true

    # Process all READY tasks, calling their handlers
    pub fn poll_tasks(self: *TaskServer)
        for i in 0..MAX_TASKS
            let task = @&self.pool.tasks[i]
            if task.state == TASK_READY
                let h: fn(*Task) -> i32 = task.handler
                let result = h(task)
                if result >= 0
                    (@self.pool).complete(task)

    # Handle a new connection (shared by both modes)
    pub fn handle_accept(self: *TaskServer, client_fd: i32, handler: fn(*Task) -> i32)
        # Check max connections limit
        if self.max_connections > 0 and (@self.pool).active_count >= self.max_connections
            # At connection limit, reject new connection
            sys_close(client_fd)
            return

        # Set TCP_NODELAY for low latency
        set_nodelay(client_fd)
        let spawned = (@self.pool).spawn(client_fd, handler)
        if not spawned
            # Pool full, close connection
            sys_close(client_fd)

    # Wake a task with an I/O result
    pub fn wake_task(self: *TaskServer, task_id: i64, result: i32)
        let found: Option<*Task> = (@self.pool).find(task_id)
        let task: *Task = match found
            Some(t) => t
            None => return
        task.io_result = result
        task.state = TASK_READY
        task.last_activity = get_current_time()  # Update activity timestamp

    # Check for idle connections and close them
    # Returns number of connections closed
    pub fn check_idle(self: *TaskServer) -> i32
        if self.idle_timeout <= 0
            return 0

        let now: i64 = get_current_time()
        let timeout_secs: i64 = self.idle_timeout as i64
        var closed: i32 = 0

        for i in 0..MAX_TASKS
            let task = @&self.pool.tasks[i]
            # Only check tasks that are waiting for I/O (not IDLE, not READY)
            if task.state == TASK_WAITING
                let idle_time: i64 = now - task.last_activity
                if idle_time >= timeout_secs
                    # Connection is idle too long - close it
                    (@self.pool).complete(task)
                    closed += 1

        return closed

    pub fn stop(self: *TaskServer)
        self.running = 0

    # Run the server event loop with a connection handler
    pub fn run(self: *TaskServer, handler: fn(*Task) -> i32) -> i32
        self.running = 1

        # Submit initial accept
        self.submit_accept()

        # Submit initial idle check timeout if enabled
        self.submit_idle_timeout()

        self.ring.submit()

        loop
            # Check shutdown hook at start of each iteration
            if self.shutdown_hook != null
                let hook: fn() -> i32 = self.shutdown_hook
                if hook() != 0
                    self.running = 0

            if self.running == 0
                break

            # Poll all READY tasks
            self.poll_tasks()

            # Submit any pending I/O and wait for completions
            match self.ring.submit_and_wait(1)
                Ok(_) => pass
                Err(e) => return -e.code()

            # Process all CQEs
            loop
                let cqe: *IoUringCqe = match self.ring.peek_cqe()
                    Some(p) => p
                    None => break

                let user_data = cqe.user_data
                let cqe_res = cqe.res

                if user_data == self.accept_user_data
                    # New connection accepted
                    if cqe_res >= 0
                        self.handle_accept(cqe_res, handler)
                    # Re-submit accept for next connection
                    self.submit_accept()
                else if user_data == self.timeout_user_data
                    # Timeout fired - check idle connections and re-submit
                    self.check_idle()
                    self.submit_idle_timeout()
                else
                    # Wake the task
                    self.wake_task(user_data, cqe_res)

                self.ring.cqe_seen(@*cqe)

        return 0

    # Run server with multishot accept (kernel 5.19+)
    # More efficient than task_server_run - only one accept SQE needed
    pub fn run_multishot(self: *TaskServer, handler: fn(*Task) -> i32) -> i32
        self.running = 1

        # Submit multishot accept - only needs to be done once
        self.submit_accept_multishot()

        # Submit initial idle check timeout if enabled
        self.submit_idle_timeout()

        self.ring.submit()

        loop
            # Check shutdown hook at start of each iteration
            if self.shutdown_hook != null
                let hook: fn() -> i32 = self.shutdown_hook
                if hook() != 0
                    self.running = 0

            if self.running == 0
                break

            # Poll all READY tasks
            self.poll_tasks()

            # Submit any pending I/O and wait for completions
            match self.ring.submit_and_wait(1)
                Ok(_) => pass
                Err(e) => return -e.code()

            # Process all CQEs
            loop
                let cqe: *IoUringCqe = match self.ring.peek_cqe()
                    Some(p) => p
                    None => break

                let user_data = cqe.user_data
                let cqe_res = cqe.res
                let cqe_flags = cqe.flags

                if user_data == self.accept_user_data
                    # New connection from multishot accept
                    if cqe_res >= 0
                        self.handle_accept(cqe_res, handler)

                    # With multishot, only re-submit if IORING_CQE_F_MORE is NOT set
                    # (which means the multishot was cancelled or errored)
                    if (cqe_flags & IORING_CQE_F_MORE) == 0
                        if cqe.res < 0
                            # Error - re-submit multishot
                            self.submit_accept_multishot()
                else if user_data == self.timeout_user_data
                    # Timeout fired - check idle connections and re-submit
                    self.check_idle()
                    self.submit_idle_timeout()
                else
                    # Wake the task
                    self.wake_task(user_data, cqe_res)

                self.ring.cqe_seen(@*cqe)

        return 0
