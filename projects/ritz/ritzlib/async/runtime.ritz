# ritzlib/async/runtime.ritz - Drive one future on one io_uring
#
# ritzlib.async.tasks runs many tasks on a ring; this module runs one future, or
# one blocking operation at a time, on a ring of its own.
#
#   - Runtime: holds the io_uring instance and the waker for the current future
#   - runtime_read / write / close: submit one operation and wait for it
#   - runtime_poll_read / write: submit one operation and return Pending, for
#     use inside a poll function
#   - block_on: poll a future to completion, waiting on the ring when Pending
#
# Usage:
#   fn main() -> i32
#       var rt: Runtime
#       if runtime_init(@rt) < 0
#           return 1
#       let poll_fn: fn(*u8) -> i32 = my_poll_fn
#       let result: i32 = block_on(@rt, @future as *u8, poll_fn)
#       runtime_destroy(@rt)
#       result

import ritzlib.sys
import ritzlib.uring

# ============================================================================
# Constants
# ============================================================================

# Poll result encoding (same as compiler-generated futures)
pub const POLL_PENDING: i32 = -1   # -1 = Pending, any other value = Ready(value)

# ============================================================================
# Runtime - the async I/O runtime
# ============================================================================

# Runtime holds the io_uring instance and coordinates async operations.
# Only one runtime should be active at a time per thread.
struct Runtime
    # The io_uring instance
    ring: IoUring
    # Is the runtime initialized?
    initialized: i32
    # Global user_data counter for tracking operations
    next_user_data: i64
    # The operation the current future is suspended on
    waker_user_data: i64
    waker_io_result: i32
    waker_active: i32

# Initialize the runtime with an io_uring instance
# Returns 0 on success, negative error code on failure
pub fn runtime_init(rt: *Runtime) -> i32
    rt.initialized = 0
    rt.next_user_data = 1
    rt.waker_user_data = 0
    rt.waker_io_result = 0
    rt.waker_active = 0

    # Initialize io_uring with 256 entries (good default)
    let ret: i32 = uring_init(@rt.ring, 256)
    if ret < 0
        return ret

    rt.initialized = 1
    return 0

# Destroy the runtime, cleaning up io_uring resources
pub fn runtime_destroy(rt: *Runtime)
    if rt.initialized != 0
        uring_destroy(@rt.ring)
        rt.initialized = 0

# ============================================================================
# I/O Operations - submit to io_uring and get result
# ============================================================================

# Submit a read operation and wait for completion
# This is a blocking call - it submits to io_uring and waits for the result
pub fn runtime_read(rt: *Runtime, fd: i32, buf: *u8, count: i32, offset: i64) -> i64
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    # Get an SQE
    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    if sqe == (null)
        return -12  # ENOMEM

    # Prepare the read
    uring_prep_read(sqe, fd, buf, count, offset, user_data)
    uring_sqe_submit(@rt.ring)

    # Submit and wait for completion
    let ret: i32 = uring_submit_and_wait(@rt.ring, 1)
    if ret < 0
        return ret as i64

    # Get the completion
    let cqe: *IoUringCqe = uring_peek_cqe(@rt.ring)
    if cqe == (null)
        return -5  # EIO

    let result: i64 = cqe.res as i64
    uring_cqe_seen(@rt.ring, cqe)

    return result

# Submit a write operation and wait for completion
pub fn runtime_write(rt: *Runtime, fd: i32, buf: *u8, count: i32, offset: i64) -> i64
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    if sqe == (null)
        return -12  # ENOMEM

    uring_prep_write(sqe, fd, buf, count, offset, user_data)
    uring_sqe_submit(@rt.ring)

    let ret: i32 = uring_submit_and_wait(@rt.ring, 1)
    if ret < 0
        return ret as i64

    let cqe: *IoUringCqe = uring_peek_cqe(@rt.ring)
    if cqe == (null)
        return -5  # EIO

    let result: i64 = cqe.res as i64
    uring_cqe_seen(@rt.ring, cqe)

    return result

# Submit a close operation and wait for completion
pub fn runtime_close(rt: *Runtime, fd: i32) -> i32
    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1

    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    if sqe == (null)
        return -12  # ENOMEM

    uring_prep_close(sqe, fd, user_data)
    uring_sqe_submit(@rt.ring)

    let ret: i32 = uring_submit_and_wait(@rt.ring, 1)
    if ret < 0
        return ret

    let cqe: *IoUringCqe = uring_peek_cqe(@rt.ring)
    if cqe == (null)
        return -5  # EIO

    let result: i32 = cqe.res
    uring_cqe_seen(@rt.ring, cqe)

    return result

# ============================================================================
# Waker - which operation the current future is suspended on
# ============================================================================

pub fn runtime_waker_register(rt: *Runtime, user_data: i64)
    rt.waker_user_data = user_data
    rt.waker_active = 1

pub fn runtime_waker_clear(rt: *Runtime)
    rt.waker_active = 0
    rt.waker_user_data = 0

# Hand over the result of the completed operation, leaving none behind
fn runtime_take_io_result(rt: *Runtime) -> i32
    let result: i32 = rt.waker_io_result
    rt.waker_io_result = 0
    return result

# Queue a prepared SQE, suspend the future on it, and return Pending
fn runtime_suspend_on(rt: *Runtime, user_data: i64) -> i32
    uring_sqe_submit(@rt.ring)
    runtime_waker_register(rt, user_data)
    return POLL_PENDING

# ============================================================================
# Poll operations - submit I/O and suspend, for use inside a poll function
# ============================================================================
#
# Call one from a poll function and return what it returns.  The first call
# submits the operation and returns POLL_PENDING; once block_on has seen the
# completion, the next call returns the result.
#
# A result of 0 cannot be told from "no result yet" (AGAST #2328).

pub fn runtime_poll_read(rt: *Runtime, fd: i32, buf: *u8, len: i32, offset: i64) -> i32
    if rt.waker_io_result != 0
        return runtime_take_io_result(rt)

    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    if sqe == (null)
        return -12  # ENOMEM

    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1
    uring_prep_read(sqe, fd, buf, len, offset, user_data)
    return runtime_suspend_on(rt, user_data)

pub fn runtime_poll_write(rt: *Runtime, fd: i32, buf: *u8, len: i32, offset: i64) -> i32
    if rt.waker_io_result != 0
        return runtime_take_io_result(rt)

    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    if sqe == (null)
        return -12  # ENOMEM

    let user_data: i64 = rt.next_user_data
    rt.next_user_data = rt.next_user_data + 1
    uring_prep_write(sqe, fd, buf, len, offset, user_data)
    return runtime_suspend_on(rt, user_data)

# ============================================================================
# block_on - run a future to completion
# ============================================================================

# Wait for at least one completion and record the one the waker is armed for
pub fn runtime_wait_for_io(rt: *Runtime) -> i32
    # Submit any pending SQEs and wait for at least one CQE
    let ret: i32 = uring_submit_and_wait(@rt.ring, 1)
    if ret < 0
        return ret

    # Process completions
    var processed: i32 = 0
    while processed < 100  # Safety limit
        let cqe: *IoUringCqe = uring_peek_cqe(@rt.ring)
        if cqe == (null)
            break  # No more completions

        # Check if this completion matches our waker
        let user_data: i64 = cqe.user_data
        let io_result: i32 = cqe.res

        if rt.waker_active != 0
            if rt.waker_user_data == user_data
                rt.waker_io_result = io_result
                runtime_waker_clear(rt)

        uring_cqe_seen(@rt.ring, cqe)
        processed += 1

    return 0

# Poll a future until it is Ready, waiting on io_uring whenever it is Pending.
# A future that returns Pending must have suspended on an operation; one that
# has not could never be woken, so block_on returns -EINVAL rather than spin.
pub fn block_on(rt: *Runtime, future_ptr: *u8, poll_fn: fn(*u8) -> i32) -> i32
    var completed: i32 = 0
    var result: i32 = 0

    while completed == 0
        result = poll_fn(future_ptr)

        if result != POLL_PENDING
            completed = 1
        else
            if rt.waker_active != 0
                let wait_result: i32 = runtime_wait_for_io(rt)
                if wait_result < 0
                    result = wait_result
                    completed = 1
            else
                result = -22  # EINVAL
                completed = 1

    return result

# ============================================================================
# Global Runtime (for convenience)
# ============================================================================

# Global runtime instance - initialized lazily
var g_runtime: Runtime
var g_runtime_initialized: i32 = 0

# Get or initialize the global runtime
pub fn get_runtime() -> *Runtime
    if g_runtime_initialized == 0
        let ret: i32 = runtime_init(@g_runtime)
        if ret >= 0
            g_runtime_initialized = 1
    return @g_runtime

# Clean up the global runtime (call at program exit)
pub fn cleanup_runtime()
    if g_runtime_initialized != 0
        runtime_destroy(@g_runtime)
        g_runtime_initialized = 0
