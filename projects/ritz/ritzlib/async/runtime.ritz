# ritzlib/async/runtime.ritz - Drive one future on one io_uring
#
# ritzlib.async.tasks runs many tasks on a ring; this module runs one future, or
# one blocking operation at a time, on a ring of its own.
#
#   - Runtime: holds the io_uring instance and the waker for the current future
#   - runtime_read / write / close: submit one operation and wait for it
#   - runtime_poll_read / write: submit one operation and return Pending, for
#     use inside a poll function
#   - block_on: poll a future to completion, waiting on the ring when Pending
#   - spawn: queue a held future; run_spawned: drive the queue concurrently
#     (LARB R79)
#
# Usage:
#   fn main() -> i32
#       var rt: Runtime
#       if rt.init() < 0
#           return 1
#       var p = my_async_fn()
#       block_on(@rt, @&p)
#       let result: i32 = await p
#       rt.destroy()
#       result

import ritzlib.sys
import ritzlib.uring
import ritzlib.result
import ritzlib.errno
import ritzlib.strview

# ============================================================================
# Constants
# ============================================================================

# A hand-written poll source returns `Option<i32>`: `None` while Pending and
# `Some(result)` once Ready, whatever the result (0 at EOF, -1 for -EPERM).
# The status is the Option's, so no i32 is reserved (AGAST #4558).

# Maximum number of futures queued on one runtime with spawn().  The queue is a
# fixed array, like TaskPool's: ritzlib allocates nothing.
pub const SPAWN_MAX_TASKS: i32 = 64

# Spawn-task states (AGAST #4481)
const SPAWN_IDLE: i32 = 0      # Slot is unused
const SPAWN_WAITING: i32 = 1   # Suspended on an operation (`user_data`)
const SPAWN_READY: i32 = 2     # Due a poll (freshly spawned, or woken)

# ============================================================================
# SpawnTask - one future queued with spawn()
# ============================================================================

# A future plus the per-task waker slot its poll routes I/O to.  The single
# waker fields on Runtime cannot serve N concurrent futures: each registration
# would overwrite the last, and completions for earlier tasks would be dropped.
# So while a spawn task is being polled, `Runtime.current_task` names it and
# runtime_poll_* records this task's own `user_data`, result and readiness.
struct SpawnTask
    f: @&Future                    # The future to poll (nominal, R79)
    user_data: i64                 # user_data of the task's outstanding op
    state: i32                     # SPAWN_IDLE, SPAWN_WAITING, SPAWN_READY
    io_result: i32                 # Result of the completed operation
    io_ready: i32                  # 1 when io_result is valid (0 is a result too)

# ============================================================================
# Runtime - the async I/O runtime
# ============================================================================

# Runtime holds the io_uring instance and coordinates async operations.
# Only one runtime should be active at a time per thread.
struct Runtime
    # The io_uring instance
    ring: IoUring
    # Is the runtime initialized?
    initialized: i32
    # Global user_data counter for tracking operations
    next_user_data: i64
    # The operation the current future is suspended on
    waker_user_data: i64
    # Its result, valid only while waker_io_ready is set.  0 (EOF) and -1
    # (-EPERM) are results like any other, so the flag says whether there is
    # one, not the value (AGAST #2328; tasks.ritz's TASK_IO_FRESH is the same).
    waker_io_result: i32
    waker_io_ready: i32
    waker_active: i32
    # Futures queued with spawn(), and the number not yet finished.  While a
    # spawned future's poll runs, current_task is its index (0 - 1 outside a
    # poll), so runtime_poll_* can route the operation to that task's slot.
    # Legacy users leave current_task at -1 and see the single waker unchanged.
    spawn_tasks: [SPAWN_MAX_TASKS]SpawnTask
    spawn_count: i32
    current_task: i32

# ============================================================================
# I/O Operations - submit to io_uring and get result
# ============================================================================

# ============================================================================
# Waker - which operation the current future is suspended on
# ============================================================================

# Hand over the result of the completed operation, leaving none behind
fn runtime_take_io_result(rt: *Runtime) -> i32
    let result: i32 = rt.waker_io_result
    rt.waker_io_result = 0
    rt.waker_io_ready = 0
    return result

# The spawn-task counterpart of runtime_take_io_result: hand the task the
# result of its completed operation and clear the slot.
fn runtime_task_take_io_result(t: *SpawnTask) -> i32
    let result: i32 = t.io_result
    t.io_result = 0
    t.io_ready = 0
    return result

# Queue a prepared SQE and suspend the future on it: on the current spawn task
# when one is being polled, on the single waker otherwise.  Return Pending.
fn runtime_suspend_on(rt: *Runtime, user_data: i64) -> Option<i32>
    rt.ring.sqe_submit()
    if rt.current_task >= 0
        let t = @&rt.spawn_tasks[rt.current_task]
        t.user_data = user_data
        t.state = SPAWN_WAITING
    else
        rt.waker_register(user_data)
    return None

# ============================================================================
# Poll operations - submit I/O and suspend, for use inside a poll function
# ============================================================================
#
# Call one from a poll function and return what it returns.  The first call
# submits the operation and returns None (Pending); once block_on has seen the
# completion, the next call returns Some(result), whatever its value: 0 at
# EOF, or -1 for -EPERM (AGAST #4558).

# ============================================================================
# block_on - run a future to completion
# ============================================================================

# Route one completion to whoever is waiting for it: the single waker (legacy
# block_on and hand-written poll drivers) or the spawn task that submitted the
# operation.  A completion nobody is waiting for is dropped, as before.
fn runtime_dispatch_completion(rt: *Runtime, user_data: i64, io_result: i32)
    if rt.waker_active != 0 and rt.waker_user_data == user_data
        rt.waker_io_result = io_result
        rt.waker_io_ready = 1
        rt.waker_clear()
        return

    for i in 0..SPAWN_MAX_TASKS
        let t = @&rt.spawn_tasks[i]
        if t.state == SPAWN_WAITING and t.user_data == user_data
            t.io_result = io_result
            t.io_ready = 1
            t.state = SPAWN_READY
            return

# A Pending poll with nothing registered to wake it: the future can never run
# again, so returning would hand the caller an unfinished future.
fn block_on_contract_violation()
    block_on_fatal("block_on: Pending future did not suspend on the ring")

# Loud failure for the loop's impossible states: message on stderr, exit 101.
fn block_on_fatal(msg: StrView)
    ritz_platform_fatal(msg.ptr, msg.len, 101)

# ============================================================================
# spawn - queue held futures, run them concurrently (LARB R79)
# ============================================================================
#
# R79 names spawn(rt, @&p): it queues a future the caller holds, and some drain
# entry point drives the queue.  The queue is a fixed array on the Runtime, so
# nothing is allocated.  Each task gets its own waker slot (SpawnTask), since
# the Runtime's single waker would be overwritten by each registration and
# completions for every earlier task would be dropped.
#
# The caller keeps the future alive until the drain returns:
#
#   var p = read_one(rt, fd)
#   spawn(rt, @&p)
#   run_spawned(rt)
#   let n: i32 = await p
#
# The loud contract of block_on applies here too: a poll that reports Pending
# without suspending on the ring can never be woken, so the drain fails loudly
# rather than returning with an unfinished future or spinning.

# Loud failure for impossible spawn states and a full queue: stderr, exit 101.
fn spawn_fatal(msg: StrView)
    ritz_platform_fatal(msg.ptr, msg.len, 101)

# ============================================================================
# Global Runtime (for convenience)
# ============================================================================

# Global runtime instance - initialized lazily
var g_runtime: Runtime
var g_runtime_initialized: i32 = 0

# Get or initialize the global runtime
pub fn get_runtime() -> *Runtime
    if g_runtime_initialized == 0
        let ret: i32 = g_runtime.init()
        if ret >= 0
            g_runtime_initialized = 1
    return @g_runtime

# Clean up the global runtime (call at program exit)
pub fn cleanup_runtime()
    if g_runtime_initialized != 0
        g_runtime.destroy()
        g_runtime_initialized = 0

# ============================================================================
# Methods (S-IMPL-1): a Runtime is the subject of every operation on it.
# ============================================================================

impl Runtime
    # Initialize the runtime with an io_uring instance
    # Returns 0 on success, negative error code on failure
    pub fn init(self: *Runtime) -> i32
        self.initialized = 0
        self.next_user_data = 1
        self.waker_user_data = 0
        self.waker_io_result = 0
        self.waker_io_ready = 0
        self.waker_active = 0
        self.spawn_count = 0
        self.current_task = 0 - 1

        # Initialize the spawn queue slots
        for i in 0..SPAWN_MAX_TASKS
            let t = @&self.spawn_tasks[i]
            t.user_data = 0
            t.state = SPAWN_IDLE
            t.io_result = 0
            t.io_ready = 0

        # Initialize io_uring with 256 entries (good default)
        let ret: i32 = self.ring.init(256)
        if ret < 0
            return ret

        self.initialized = 1
        return 0

    # Destroy the runtime, cleaning up io_uring resources
    pub fn destroy(self: *Runtime)
        if self.initialized != 0
            self.ring.destroy()
            self.initialized = 0

    # Submit a read operation and wait for completion.
    # Ok(bytes read, 0 at EOF) or Err(errno) from submission or the completion.
    pub fn read(self: *Runtime, fd: i32, buf_sv: Span<u8>, offset: i64) -> Result<i64, Errno>
        let user_data: i64 = self.next_user_data
        self.next_user_data = self.next_user_data + 1

        # Get an SQE
        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return Err(Errno.NoMem)

        # Prepare the read
        sqe.prep_read(fd, buf_sv, offset, user_data)
        self.ring.sqe_submit()

        # Submit and wait for completion
        match self.ring.submit_and_wait(1)
            Ok(_) => pass
            Err(e) => return Err(e)

        # Get the completion
        let cqe: *IoUringCqe = match self.ring.peek_cqe()
            Some(p) => p
            None => return Err(Errno.Io)

        let result: i64 = cqe.res as i64
        self.ring.cqe_seen(@*cqe)
        if result < 0
            return Err(errno_from_raw(result as i32))

        return Ok(result)

    # Submit a write operation and wait for completion.
    # Ok(bytes written) or Err(errno) from submission or the completion.
    pub fn write(self: *Runtime, fd: i32, buf_sv: Span<u8>, offset: i64) -> Result<i64, Errno>
        let user_data: i64 = self.next_user_data
        self.next_user_data = self.next_user_data + 1

        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return Err(Errno.NoMem)

        sqe.prep_write(fd, buf_sv, offset, user_data)
        self.ring.sqe_submit()

        match self.ring.submit_and_wait(1)
            Ok(_) => pass
            Err(e) => return Err(e)

        let cqe: *IoUringCqe = match self.ring.peek_cqe()
            Some(p) => p
            None => return Err(Errno.Io)

        let result: i64 = cqe.res as i64
        self.ring.cqe_seen(@*cqe)
        if result < 0
            return Err(errno_from_raw(result as i32))

        return Ok(result)

    # Submit a close operation and wait for completion.
    # Ok(()) or Err(errno) from submission or the completion.
    pub fn close(self: *Runtime, fd: i32) -> Result<(), Errno>
        let user_data: i64 = self.next_user_data
        self.next_user_data = self.next_user_data + 1

        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return Err(Errno.NoMem)

        sqe.prep_close(fd, user_data)
        self.ring.sqe_submit()

        match self.ring.submit_and_wait(1)
            Ok(_) => pass
            Err(e) => return Err(e)

        let cqe: *IoUringCqe = match self.ring.peek_cqe()
            Some(p) => p
            None => return Err(Errno.Io)

        let result: i32 = cqe.res
        self.ring.cqe_seen(@*cqe)
        if result < 0
            return Err(errno_from_raw(result))

        return Ok(())

    pub fn waker_register(self: *Runtime, user_data: i64)
        self.waker_user_data = user_data
        self.waker_active = 1

    pub fn waker_clear(self: *Runtime)
        self.waker_active = 0
        self.waker_user_data = 0

    pub fn poll_read(self: *Runtime, fd: i32, buf_sv: Span<u8>, offset: i64) -> Option<i32>
        if self.current_task >= 0
            let t = @&self.spawn_tasks[self.current_task]
            if t.io_ready != 0
                return Some(runtime_task_take_io_result(t))
        else if self.waker_io_ready != 0
            return Some(runtime_take_io_result(self))

        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return Some(-12)  # ENOMEM

        let user_data: i64 = self.next_user_data
        self.next_user_data = self.next_user_data + 1
        sqe.prep_read(fd, buf_sv, offset, user_data)
        return runtime_suspend_on(self, user_data)

    pub fn poll_write(self: *Runtime, fd: i32, buf_sv: Span<u8>, offset: i64) -> Option<i32>
        if self.current_task >= 0
            let t = @&self.spawn_tasks[self.current_task]
            if t.io_ready != 0
                return Some(runtime_task_take_io_result(t))
        else if self.waker_io_ready != 0
            return Some(runtime_take_io_result(self))

        let sqe: *IoUringSqe = match self.ring.get_sqe()
            Some(p) => p
            None => return Some(-12)  # ENOMEM

        let user_data: i64 = self.next_user_data
        self.next_user_data = self.next_user_data + 1
        sqe.prep_write(fd, buf_sv, offset, user_data)
        return runtime_suspend_on(self, user_data)

    # Wait for at least one completion and record the one the waker is armed for
    pub fn wait_for_io(self: *Runtime) -> i32
        # Submit any pending SQEs and wait for at least one CQE
        match self.ring.submit_and_wait(1)
            Ok(_) => pass
            Err(e) => return -e.code()

        # Process completions
        var processed: i32 = 0
        while processed < 100  # Safety limit
            let cqe: *IoUringCqe = match self.ring.peek_cqe()
                Some(p) => p
                None => break  # No more completions

            # Hand this completion to its owner
            let user_data: i64 = cqe.user_data
            let io_result: i32 = cqe.res
            runtime_dispatch_completion(self, user_data, io_result)

            self.ring.cqe_seen(@*cqe)
            processed += 1

        return 0

    # Poll a future until it is Ready (LARB R79), waiting on io_uring whenever the
    # future's poll reports Pending.  Returns nothing; the caller reads the result
    # with `await p`.
    #
    # A poll that reports Pending must have suspended on an operation (LARB R78).
    # One that did not can never be woken, so the future would stay unfinished: a
    # silent return would let `await p` read an unset result slot, and a busy loop
    # would hang.  Both are contract violations, so fail loudly instead.
    pub fn block_on(self: *Runtime, f: @&Future)
        while !future_poll(f)
            if self.waker_active == 0
                block_on_contract_violation()
            let wait_result: i32 = self.wait_for_io()
            if wait_result < 0
                block_on_fatal("block_on: runtime_wait_for_io failed")

    # Queue a held future for run_spawned.  The caller's future must outlive the
    # drain.  A full queue is a program error: there is no return value to report
    # it (R79 gives spawn none), so it fails loudly rather than dropping the task.
    pub fn spawn(self: *Runtime, f: @&Future)
        for i in 0..SPAWN_MAX_TASKS
            let t = @&self.spawn_tasks[i]
            if t.state == SPAWN_IDLE
                t.f = f
                t.user_data = 0
                t.io_result = 0
                t.io_ready = 0
                t.state = SPAWN_READY
                self.spawn_count += 1
                return

        spawn_fatal("spawn: future queue is full")

    # Poll every spawned future until it is finished, waiting on the ring while
    # all unfinished tasks are suspended.  Returns 0 once the queue is drained, or
    # the negative code from a failed wait.
    pub fn run_spawned(self: *Runtime) -> i32
        while self.spawn_count > 0
            # Poll each task that is due, routing its I/O to its own waker slot
            for i in 0..SPAWN_MAX_TASKS
                let t = @&self.spawn_tasks[i]
                if t.state == SPAWN_READY
                    self.current_task = i
                    let done: bool = future_poll(t.f)
                    self.current_task = 0 - 1

                    if done
                        t.state = SPAWN_IDLE
                        t.io_ready = 0
                        t.user_data = 0
                        self.spawn_count -= 1
                    else if t.state != SPAWN_WAITING
                        # Pending with nothing registered to wake it (R78)
                        spawn_fatal("run_spawned: Pending future did not suspend on the ring")

            if self.spawn_count == 0
                break

            # All unfinished tasks are suspended: wait for at least one completion
            let wait_result: i32 = self.wait_for_io()
            if wait_result < 0
                return wait_result

        return 0
