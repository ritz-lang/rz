# ritzlib/io.ritz - High-level I/O functions
#
# Provides convenient wrappers for common I/O operations.
# Imports low-level syscalls from sys.ritz.

import ritzlib.sys
import ritzlib.string
import ritzlib.strview
import ritzlib.fmt.digits
import ritzlib.gvec
import ritzlib.result
import ritzlib.errno

# ============================================================================
# Output functions
# ============================================================================

# Print a StrView to stdout (zero-copy, no strlen needed)
pub fn prints(s: StrView)
    sys_write(STDOUT, s.ptr, s.len)

# Print a StrView to stderr (zero-copy, no strlen needed)
pub fn eprints(s: StrView)
    sys_write(STDERR, s.ptr, s.len)

# C interop: print a NUL-terminated C string (`*u8`, e.g. `c"..."` or a
# pointer from argv/envp) to stdout.  Walks the string to find its length.
# For Ritz text prefer prints(StrView): `prints("...")` needs no strlen.
# standard-exempt: raw-ptr-param: C string ABI: a NUL-terminated string from argv/envp or c"..."
pub fn prints_cstr(s: *u8)
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    sys_write(STDOUT, s, len)

# C interop: print a NUL-terminated C string to stderr (computes strlen).
# For Ritz text prefer eprints(StrView).
# standard-exempt: raw-ptr-param: C string ABI: a NUL-terminated string from argv/envp or c"..."
pub fn eprints_cstr(s: *u8)
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    sys_write(STDERR, s, len)

# C interop: print a NUL-terminated C string and a newline to stdout
# (computes strlen).  For Ritz text prefer println(StrView).
# standard-exempt: raw-ptr-param: C string ABI: a NUL-terminated string from argv/envp or c"..."
pub fn println_cstr(s: *u8)
    prints_cstr(s)
    print_char(10)

# C interop: print a NUL-terminated C string and a newline to stderr
# (computes strlen).  For Ritz text prefer eprintln(StrView).
# standard-exempt: raw-ptr-param: C string ABI: a NUL-terminated string from argv/envp or c"..."
pub fn eprintln_cstr(s: *u8)
    eprints_cstr(s)
    eprint_char(10)

pub fn print_char(c: u8)
    var buf: [1]u8
    buf[0] = c
    sys_write(STDOUT, @buf[0], 1)

pub fn eprint_char(c: u8)
    var buf: [1]u8
    buf[0] = c
    sys_write(STDERR, @buf[0], 1)

# Digits come from ritzlib.fmt (one routine for every formatter, #1856).
pub fn print_int(n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    sys_write(STDOUT, @buf[0], len)

pub fn eprint_int(n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    sys_write(STDERR, @buf[0], len)

# A negative prints as its two's-complement bits, like print_hex64:
# print_hex(-1) is 0xffffffffffffffff.
pub fn print_hex(n: i64)
    var buf: [18]u8
    buf[0] = '0'
    buf[1] = 'x'
    let len: i64 = fmt_u64_hex_into(@buf[2], n as u64)
    sys_write(STDOUT, @buf[0], len + 2)

pub fn print_size_human(size: i64)
    if size < 1024
        print_int(size)
        return

    var units: [4]u8
    units[0] = 75   # 'K'
    units[1] = 77   # 'M'
    units[2] = 71   # 'G'
    units[3] = 84   # 'T'

    var s: i64 = size
    var unit: i32 = 0
    s /= 1024

    while s >= 1024 and unit < 3
        s /= 1024
        unit += 1

    print_int(s)
    print_char(units[unit])

# ============================================================================
# Newline helpers
# ============================================================================

# Print a StrView followed by newline
pub fn println(s: StrView)
    prints(s)
    print_char(10)

# Print a StrView to stderr followed by newline
pub fn eprintln(s: StrView)
    eprints(s)
    eprint_char(10)

pub fn newline()
    print_char(10)

# ============================================================================
# String type output functions
#
# Each takes the String by shared borrow: call as print_string(@s).
# ============================================================================

pub fn print_string(s: @String)
    let v: StrView = s.as_view()
    sys_write(STDOUT, v.ptr, v.len)

pub fn eprint_string(s: @String)
    let v: StrView = s.as_view()
    sys_write(STDERR, v.ptr, v.len)

pub fn println_string(s: @String)
    print_string(s)
    print_char(10)

pub fn eprintln_string(s: @String)
    eprint_string(s)
    eprint_char(10)

# Print an i64 as a String (uses proper String type internally).
pub fn print_i64(n: i64)
    var s: String = string_from_i64(n)
    print_string(@s)

# Print an i64 with newline.
pub fn println_i64(n: i64)
    var s: String = string_from_i64(n)
    println_string(@s)

# Print to stderr.
pub fn eprint_i64(n: i64)
    var s: String = string_from_i64(n)
    eprint_string(@s)

pub fn eprintln_i64(n: i64)
    var s: String = string_from_i64(n)
    eprintln_string(@s)

# Print a u64 in hex format.
pub fn print_hex64(n: u64)
    var s: String = string_from_hex(n)
    print_string(@s)

pub fn println_hex64(n: u64)
    var s: String = string_from_hex(n)
    println_string(@s)

# ============================================================================
# Reading a whole fd
# ============================================================================

# Read entire file descriptor into a Vec<u8>, appending to what is there.
# Here, not in gvec, because gvec is core and reading an fd is hosted
# (AGAST #4119).
# Ok(bytes read), or Err(errno) from read(2) or the push allocation.
# ritzlib's only read-all-fd loop (#1942): buf.ritz's GrowBuf copy was
# deleted, so a parser reads into a Vec<u8> and points a Buffer at
# (v.data, v.len).
pub fn vec_read_all_fd(fd: i32, v: @&Vec<u8>) -> Result<i64, Errno>
    let chunk_size: i64 = 4096
    var temp: [4096]u8
    var total: i64 = 0

    loop
        let n: i64 = sys_read(fd, @temp[0], chunk_size)
        if n < 0
            return Err(errno_from_raw(n as i32))
        if n == 0
            break
        if not vec_push_bytes<u8>(v, Span<u8> { ptr: (@temp[0]), len: (n) as i64 })
            return Err(Errno.NoMem)
        total += n

    return Ok(total)
