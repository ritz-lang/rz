# ritzlib/process.ritz - Process spawning and I/O
#
# Simple, direct process management for subprocess testing.
# Spawns child processes with connected stdin/stdout/stderr pipes.
#
# Design principles:
# - No BufferedStreamReader nonsense - simple read/write ops
# - Ownership: Process owns pipe FDs, cleaned up on drop
# - Vec<u8> for output capture (growable, owned)
# - Clear, intent-revealing API
#
# Usage (AGAST #1481): the command and its arguments are StrViews, so a
# "..." literal, a string_as_view(@s) or a slice all pass straight in.
#
#   var args: [2]StrView
#   args[0] = "-c"
#   args[1] = "echo hi"
#   match spawn("sh", span_from_ptr<StrView>(@args[0], 2))
#       Ok(p) =>
#           var q: Process = p
#           process_write_all(@&q, "input")      # Result<i64, Errno>
#           var out: Vec<u8> = process_read_stdout_all(@&q)
#           match process_wait(@&q)              # Result<ProcessResult, Errno>
#               Ok(r) => if result_success(@r) ...
#               Err(e) => ...                    # Child: already waited
#           process_cleanup(@&q)
#       Err(e) => ...            # an Errno: NoEnt, Acces, ...
#
#   match find_command("sh")     # Option<String>: the path $PATH resolves to
#       Some(path) => ...
#       None => ...
#
# Every fn on a live Process takes `@&Process`: they close fds and record the
# wait.  process_valid only reads it, so it takes `@Process` (AGAST #3750).
# spawn_env(cmd, args, env) gives the child exactly `env`; spawn inherits ours.
# spawn_env_merged(cmd, args, env, stdin_fd) also reads stdin from a file and
# merges stderr into stdout (2>&1), for test harnesses (AGAST #4643).
#
# Every Err is a ritzlib.errno `Errno`, never a -1 or a negative errno
# (AGAST #4298).
#
# In an event loop (AGAST #4815): p.set_nonblocking(), then poll the
# borrowed Fds p.stdin() / p.stdout() / p.stderr() and move bytes with
# try_write / try_read (ritzlib.fd), which tell WouldBlock from EOF and
# Err(Pipe).  Block SIGPIPE to get Err(Pipe) rather than a kill.  The child
# starts with an empty signal mask, so blocking signals for a signalfd here
# does not leak into it.

import ritzlib.sys
import ritzlib.memory
import ritzlib.gvec
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
# signalfd_new and signalfd_create_for_shutdown return an owned Fd.
import ritzlib.fd
# Errno is part of this API (every Err), so importers of process get it too.
pub import ritzlib.errno
import ritzlib.os.env

# ============================================================================
# Process - Subprocess handle with connected pipes
# ============================================================================

struct Process
    pid: i32            # Child process ID
    stdin_fd: i32       # Write end of stdin pipe (-1 if closed)
    stdout_fd: i32      # Read end of stdout pipe (-1 if closed)
    stderr_fd: i32      # Read end of stderr pipe (-1 if closed)
    waited: i32         # 1 if already waited, 0 otherwise

# ============================================================================
# ProcessResult - Exit status from wait()
# ============================================================================

struct ProcessResult
    exit_code: i32      # Exit code (0-255) if exited normally
    signaled: i32       # 1 if killed by signal, 0 otherwise
    signal: i32         # Signal number if signaled

# ============================================================================
# find_command / find_command_in -> Option<String>
# ============================================================================

# The directories searched when $PATH is unset or empty.
fn process_default_path() -> StrView
    "/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

# Resolve `name` against `path`, a ':'-separated directory list in $PATH form.
#
# - A name containing '/' is a path, not a search: it comes back unchanged,
#   whether or not it exists (exec reports that).
# - Otherwise the first `dir/name` that sys_access(X_OK) accepts wins.  An
#   empty component means the current directory, as in POSIX $PATH; a dir
#   with a trailing '/' gets no second one.
# - An empty name or an empty `path` finds nothing.
pub fn find_command_in(name: StrView, path: StrView) -> Option<String>
    if name.len == 0
        return None
    if name.find_byte('/') < name.len
        return Some(string_from(name))
    if path.len == 0
        return None

    var start: i64 = 0
    loop
        var end: i64 = start
        while end < path.len and *(path.ptr + end) != ':'
            end += 1

        # The dir, or "." for an empty component.  Two one-armed ifs, not
        # if/else: ritz1 types an if/else of calls as the fn's return value
        # (AGAST #3749).
        var cand: String = string_new()
        cand.push_span(Span<u8> { ptr: (path.ptr + start), len: (end - start) as i64 })
        if end == start
            cand.push('.')
        if cand.char_at(cand.len() - 1) != '/'
            cand.push('/')
        cand.push_str(name)

        if sys_access(cand.as_ptr(), X_OK) == 0
            return Some(cand)

        if end >= path.len
            break
        start = end + 1
    None

# Resolve `name` the way a shell would: against $PATH, or against the
# default list (/usr/local/bin, /usr/bin, /bin, and the sbin dirs) when $PATH
# is unset or empty.  See find_command_in for the rules.
pub fn find_command(name: StrView) -> Option<String>
    var path: StrView = env_get_or("PATH", "")
    if path.len == 0
        path = process_default_path()
    find_command_in(name, path)

# ============================================================================
# Process spawning
# ============================================================================

# A NUL-terminated copy of each view in `head` then each in `rest`, behind a
# null-terminated array of pointers to them: the argv / envp shape execve(2)
# takes.  One malloc holds both, so one free(result as *u8) releases it.
# Null if the allocation fails.
#
# None of the views need a terminator: exactly `len` bytes of each are copied.
#
# standard-exempt: raw-alloc: the malloc IS the argv/envp block execve(2) takes; the fork/exec boundary owns it
fn cstr_array(head: Span<StrView>, rest: Span<StrView>) -> **u8
    let n: i64 = head.len + rest.len
    var total: i64 = 0
    for i in 0..head.len
        let a: *StrView = head.ptr + i
        total += a.len + 1
    for i in 0..rest.len
        let a: *StrView = rest.ptr + i
        total += a.len + 1
    let block: *u8 = malloc((n + 1) * 8 + total)
    if block == null
        return null
    let ptrs: **u8 = block as **u8
    var off: i64 = (n + 1) * 8
    for i in 0..n
        # A var and a one-armed if, not an if/else value (ritz1, AGAST #3749).
        var a: *StrView = head.ptr + i
        if i >= head.len
            a = rest.ptr + (i - head.len)
        memcpy(block + off, a.ptr, a.len)
        *(block + off + a.len) = 0
        *(ptrs + i) = block + off
        off += a.len + 1
    *(ptrs + n) = null
    ptrs

# Spawn `cmd` with `args` (argv[1..]; argv[0] is `cmd` exactly as given).
#
# `cmd` is resolved with find_command before anything is forked, so a
# command that is not there is Err(NoEnt) and one that cannot be executed
# is Err(Acces), not a child that exits 127.  Pipe or fork
# failure is Err(errno) too.  The child inherits this process's environment.
pub fn spawn(cmd: StrView, args: Span<StrView>) -> Result<Process, Errno>
    spawn_env(cmd, args, env_iter())

# spawn, but the child's environment is exactly `env`, one "KEY=VALUE" view
# per entry, in that order: nothing of ours is merged in, and an empty span
# is an empty environment.
#
# standard-exempt: raw-alloc: frees the transient envp block after execve(2); the fork/exec boundary owns it
pub fn spawn_env(cmd: StrView, args: Span<StrView>, env: Span<StrView>) -> Result<Process, Errno>
    let envp: **u8 = cstr_array(span_empty<StrView>(), env)
    if envp == null
        return Err(Errno.NoMem)
    let r: Result<Process, Errno> = spawn_with_envp(cmd, args, envp, -1, false)
    free(envp as *u8)
    r

# spawn_env, but wired the way a test harness wants (AGAST #4643): the child
# reads its stdin from `stdin_fd` (dup'd onto its fd 0; the caller still owns
# and closes `stdin_fd`), and its stderr goes down the stdout pipe, as
# `cmd <&stdin_fd 2>&1` would, so read_stdout_all gets both, interleaved in
# the order the child wrote them.  The Process has no stdin or stderr pipe:
# stdin_fd and stderr_fd are -1.  A negative `stdin_fd` is Err(BadF).
#
# Use a regular file for `stdin_fd`, not a pipe the parent fills afterwards:
# the child sees the whole input and a clean EOF, the parent can't take a
# SIGPIPE from a child that never reads it, and nothing deadlocks on a full
# pipe (ritzlib.testlib's exec_capture, whose temp-file stdin fixed a ~5%
# flake that pipe-fed stdin had).
#
# standard-exempt: raw-alloc: frees the transient envp block after execve(2); the fork/exec boundary owns it
pub fn spawn_env_merged(cmd: StrView, args: Span<StrView>, env: Span<StrView>, stdin_fd: i32) -> Result<Process, Errno>
    if stdin_fd < 0
        return Err(Errno.BadF)
    let envp: **u8 = cstr_array(span_empty<StrView>(), env)
    if envp == null
        return Err(Errno.NoMem)
    let r: Result<Process, Errno> = spawn_with_envp(cmd, args, envp, stdin_fd, true)
    free(envp as *u8)
    r

# ============================================================================
# Exec - execve(2) in place, prepared before fork
# ============================================================================

# `path` run with argv `args` (args[0] is argv[0]) and this process's
# environment.  Everything execve(2) needs is built by exec_prepare, so a
# forked child can run() it without allocating.  The arrays are private: the
# raw argv/envp never leave this module (AGAST #4648).
struct Exec
    path: **u8   # cstr_array of [path]: path[0] is the C string
    argv: **u8
    envp: **u8

# An Exec of `path` with argv `args` and this process's environment.
# `path` is used as given: no $PATH search (find_command does that).
# Err(NoMem) if the arrays can't be allocated.
pub fn exec_prepare(path: StrView, args: Span<StrView>) -> Result<Exec, Errno>
    var p: StrView = path
    let pathv: **u8 = cstr_array(span_from_ptr<StrView>(@p, 1), span_empty<StrView>())
    let argv: **u8 = cstr_array(args, span_empty<StrView>())
    let envp: **u8 = cstr_array(env_iter(), span_empty<StrView>())
    var ex: Exec = Exec { path: pathv, argv: argv, envp: envp }
    if pathv == null or argv == null or envp == null
        ex.free()
        return Err(Errno.NoMem)
    Ok(ex)

impl Exec
    # Replace this process with the prepared command.  Returns only if
    # execve(2) fails, with its Errno.
    pub fn run(self: @Exec) -> Errno
        errno_from_raw(sys_execve(*self.path, self.argv, self.envp))

    # Release the arrays (the parent's copy after fork, or after a failed run).
    #
    # standard-exempt: raw-alloc: frees the argv/envp blocks exec_prepare built for execve(2)
    pub fn free(self: @&Exec)
        if self.path != null
            free(self.path as *u8)
            self.path = null
        if self.argv != null
            free(self.argv as *u8)
            self.argv = null
        if self.envp != null
            free(self.envp as *u8)
            self.envp = null

# spawn / spawn_env / spawn_env_merged: resolve `cmd`, build argv, fork.
# `envp` is never null; `stdin_fd` and `merge` are spawn_fork's.
#
# standard-exempt: raw-alloc: frees the transient argv block after execve(2); the fork/exec boundary owns it
fn spawn_with_envp(cmd: StrView, args: Span<StrView>, envp: **u8, stdin_fd: i32, merge: bool) -> Result<Process, Errno>
    var path: String = string_new()
    match find_command(cmd)
        Some(found) => path = found
        None => return Err(Errno.NoEnt)
    let acc: i32 = sys_access(path.as_ptr(), X_OK)
    if acc < 0
        return Err(errno_from_raw(acc))

    var argv0: StrView = cmd
    let argv: **u8 = cstr_array(span_from_ptr<StrView>(@argv0, 1), args)
    if argv == null
        return Err(Errno.NoMem)

    let r: Result<Process, Errno> = spawn_fork(path.as_ptr(), argv, envp, stdin_fd, merge)
    free(argv as *u8)
    r

# The pipe/fork/exec under spawn.  `path` is already resolved (find_command
# results always hold a '/'), so the child execs it as is.  Err is the
# Errno of a failed pipe or fork; a failed exec is the child's exit
# 127.  `envp` is never null: spawn passes env_iter()'s entries, since a null
# envp would give the child an empty environment (AGAST #1750).
#
# `stdin_fd` >= 0 is dup'd onto the child's stdin instead of the stdin pipe,
# and `merge` sends its stderr down the stdout pipe; the unused pipe ends are
# closed in the parent and left -1 in the Process.  All three pipes are made
# either way, so the error paths stay one shape.
#
# standard-exempt: lib-exit: the forked child before execve(2) has no caller to return to (S-ERR-3)
fn spawn_fork(path: *u8, argv: **u8, envp: **u8, stdin_fd: i32, merge: bool) -> Result<Process, Errno>
    let child_envp: **u8 = envp

    var p: Process
    p.pid = -1
    p.stdin_fd = -1
    p.stdout_fd = -1
    p.stderr_fd = -1
    p.waited = 0

    # Create pipes for stdin, stdout, stderr
    # pipe() returns [read_fd, write_fd]
    var stdin_pipe: [2]i32
    var stdout_pipe: [2]i32
    var stderr_pipe: [2]i32

    let e_in: i32 = sys_pipe(@stdin_pipe[0])
    if e_in < 0
        return Err(errno_from_raw(e_in))
    let e_out: i32 = sys_pipe(@stdout_pipe[0])
    if e_out < 0
        sys_close(stdin_pipe[0])
        sys_close(stdin_pipe[1])
        return Err(errno_from_raw(e_out))
    let e_err: i32 = sys_pipe(@stderr_pipe[0])
    if e_err < 0
        sys_close(stdin_pipe[0])
        sys_close(stdin_pipe[1])
        sys_close(stdout_pipe[0])
        sys_close(stdout_pipe[1])
        return Err(errno_from_raw(e_err))

    # Fork
    let pid: i32 = sys_fork()

    if pid < 0
        # Fork failed - close all pipes
        sys_close(stdin_pipe[0])
        sys_close(stdin_pipe[1])
        sys_close(stdout_pipe[0])
        sys_close(stdout_pipe[1])
        sys_close(stderr_pipe[0])
        sys_close(stderr_pipe[1])
        return Err(errno_from_raw(pid))

    if pid == 0
        # Child process
        # Redirect stdin/stdout/stderr to pipes
        # stdin reads from the pipe, or from stdin_fd; stdout writes to its
        # pipe; stderr to its own pipe, or (merge) to stdout's.  Two one-armed
        # ifs, not if/else (ritz1, AGAST #3749).
        var child_in: i32 = stdin_pipe[0]
        if stdin_fd >= 0
            child_in = stdin_fd
        var child_err: i32 = stderr_pipe[1]
        if merge
            child_err = stdout_pipe[1]
        sys_dup2(child_in, STDIN)
        sys_dup2(stdout_pipe[1], STDOUT)
        sys_dup2(child_err, STDERR)
        if stdin_fd > STDERR
            sys_close(stdin_fd)

        # Close unused pipe ends
        sys_close(stdin_pipe[0])
        sys_close(stdin_pipe[1])
        sys_close(stdout_pipe[0])
        sys_close(stdout_pipe[1])
        sys_close(stderr_pipe[0])
        sys_close(stderr_pipe[1])

        # Unblock every signal before exec (AGAST #4815): the mask survives
        # execve(2), and a parent that blocks signals for its signalfd must
        # not hand that mask to a program that expects SIGINT or SIGTERM to
        # stop it.  Nothing to report on failure: the child can only exec.
        let none: SigSet = sigset_empty()
        none.set_mask()

        sys_execve(path, argv, child_envp)

        # If we get here, exec failed
        sys_exit(127)

    # Parent process
    # Close child's ends of pipes
    sys_close(stdin_pipe[0])   # Child reads from stdin
    sys_close(stdout_pipe[1])  # Child writes to stdout
    sys_close(stderr_pipe[1])  # Child writes to stderr

    # Store our ends
    p.pid = pid
    p.stdin_fd = stdin_pipe[1]   # We write to child's stdin
    p.stdout_fd = stdout_pipe[0]  # We read from child's stdout
    p.stderr_fd = stderr_pipe[0]  # We read from child's stderr
    if stdin_fd >= 0
        sys_close(p.stdin_fd)
        p.stdin_fd = -1
    if merge
        sys_close(p.stderr_fd)
        p.stderr_fd = -1

    Ok(p)

# Run `body` as a child process: fork, and in the child put stdin, stdout and
# stderr on three pipes and exit with body's return value.  The parent gets
# the Process with its ends, as from spawn: write and close_stdin, read the
# output (stdout and stderr apart), wait, cleanup.  A body killed by a signal
# is wait's `signaled`.  Err is the Errno of a failed pipe or fork.  For
# testing what a function writes (ritzlib.testlib's capture).
#
# standard-exempt: lib-exit: the forked child has no caller to return to; its exit status is body's value (S-ERR-3)
pub fn spawn_fn(body: fn() -> i32) -> Result<Process, Errno>
    var inp: Pipe = pipe()?
    var out: Pipe
    match pipe()
        Ok(p) => out = p
        Err(err) =>
            inp.close()
            return Err(err)
    var err_p: Pipe
    match pipe()
        Ok(p) => err_p = p
        Err(err) =>
            inp.close()
            out.close()
            return Err(err)
    match fork()
        Ok(side) => match side
            Child =>
                inp.read.dup_to(STDIN)
                out.write.dup_to(STDOUT)
                err_p.write.dup_to(STDERR)
                inp.close()
                out.close()
                err_p.close()
                sys_exit(body())
                # Never reached: sys_exit doesn't return, but the arm needs a
                # value of the match's type (Ritz has no never type).
                Err(Errno.Other(0))
            Parent(pid) =>
                inp.read.close()
                out.write.close()
                err_p.write.close()
                # The Process owns the parent's ends from here (close_pipes).
                Ok(Process { pid: pid, stdin_fd: inp.write.raw(), stdout_fd: out.read.raw(), stderr_fd: err_p.read.raw(), waited: 0 })
        Err(err) =>
            inp.close()
            out.close()
            err_p.close()
            Err(err)

# ============================================================================
# Process validity check
# ============================================================================

# Methods (S-IMPL-1): a Process is the subject of every operation on it.
impl Process
    pub fn valid(self: @Process) -> bool
        if self.pid > 0
            return true
        return false

    # Write all of `data` to stdin, retrying short writes and EINTR.
    # Ok(bytes written: data.len unless the pipe stopped taking bytes), or
    # Err(BadF) once stdin is closed, Err(Pipe) once the child closed it, ...
    pub fn write_all(self: @&Process, data: StrView) -> Result<i64, Errno>
        if self.stdin_fd < 0
            return Err(Errno.BadF)
        var done: i64 = 0
        while done < data.len
            let n: i64 = sys_write(self.stdin_fd, data.ptr + done, data.len - done)
            if n == -(EINTR as i64)
                continue
            if n < 0
                return Err(errno_from_raw(n as i32))
            if n == 0
                break
            done += n
        Ok(done)

    # The parent's ends of the child's pipes as borrowed Fds (AGAST #4815),
    # for poll, set_nonblocking, try_read and try_write.  The Process still
    # owns them: never close a borrowed Fd (use close_stdin / close_pipes /
    # cleanup).  A pipe the Process closed, or never had (spawn_env_merged's
    # stdin and stderr), is a closed Fd: raw() -1, every operation Err(BadF).
    pub fn stdin(self: @Process) -> Fd
        fd_borrow(self.stdin_fd)

    pub fn stdout(self: @Process) -> Fd
        fd_borrow(self.stdout_fd)

    pub fn stderr(self: @Process) -> Fd
        fd_borrow(self.stderr_fd)

    # Put every open parent end (stdin, stdout, stderr) in O_NONBLOCK, for an
    # event loop that polls them.  Only the parent's ends change: the child's
    # are separate open files and stay blocking.  The first error wins.
    pub fn set_nonblocking(self: @Process) -> Result<(), Errno>
        var ends: [3]i32
        ends[0] = self.stdin_fd
        ends[1] = self.stdout_fd
        ends[2] = self.stderr_fd
        for i in 0..3
            let end: Fd = fd_borrow(ends[i])
            if end.valid()
                match end.set_nonblocking(true)
                    Err(e) => return Err(e)
                    Ok(_) => pass
        Ok(())

    # Close stdin (signals EOF to child)
    pub fn close_stdin(self: @&Process)
        if self.stdin_fd >= 0
            sys_close(self.stdin_fd)
            self.stdin_fd = -1

# ============================================================================
# Reading from process stdout
# ============================================================================

# A read(2) of at most `max` bytes from `fd` into `buf`: Ok(bytes read, 0
# at EOF), or Err(BadF) if the pipe is closed (fd < 0), else Err(errno).
fn pipe_read(fd: i32, buf: *u8, max: i64) -> Result<i64, Errno>
    if fd < 0
        return Err(Errno.BadF)
    let n: i64 = sys_read(fd, buf, max)
    if n < 0
        return Err(errno_from_raw(n as i32))
    Ok(n)

impl Process
    # Read up to `buf.len` bytes of the child's stdout into `buf`: Ok(bytes
    # read, 0 at EOF), Err(BadF) once the pipe is closed, else Err(errno).
    pub fn read_stdout(self: @&Process, buf: Span<u8>) -> Result<i64, Errno>
        pipe_read(self.stdout_fd, buf.ptr, buf.len)

    # Read all stdout into a Vec<u8> (caller owns the Vec)
    pub fn read_stdout_all(self: @&Process) -> Vec<u8>
        var output: Vec<u8> = vec_new<u8>()

        if self.stdout_fd < 0
            return output

        var temp: [4096]u8

        loop
            let n: i64 = sys_read(self.stdout_fd, @temp[0], 4096)
            if n <= 0
                break
            output.push_span(Span<u8> { ptr: (@temp[0]), len: (n) as i64 })

        return output

    # Read one line from stdout (up to newline or EOF)
    pub fn read_line(self: @&Process) -> Vec<u8>
        var line: Vec<u8> = vec_new<u8>()

        if self.stdout_fd < 0
            return line

        var c: u8 = 0

        loop
            let n: i64 = sys_read(self.stdout_fd, @c, 1)
            if n <= 0
                break
            line.push(c)
            if c == '\n'
                break

        return line

# ============================================================================
# Reading from process stderr
# ============================================================================

impl Process
    # read_stdout for the child's stderr.
    pub fn read_stderr(self: @&Process, buf: Span<u8>) -> Result<i64, Errno>
        pipe_read(self.stderr_fd, buf.ptr, buf.len)

    pub fn read_stderr_all(self: @&Process) -> Vec<u8>
        var output: Vec<u8> = vec_new<u8>()

        if self.stderr_fd < 0
            return output

        var temp: [4096]u8

        loop
            let n: i64 = sys_read(self.stderr_fd, @temp[0], 4096)
            if n <= 0
                break
            output.push_span(Span<u8> { ptr: (@temp[0]), len: (n) as i64 })

        return output

# ============================================================================
# Waiting for process
# ============================================================================

impl Process
    # Close stdin (EOF for the child), then block until it exits: Ok(how it
    # exited), Err(Child) if there is nothing to wait for (never spawned, or
    # already waited), or Err(errno) from wait4(2).  Before #4298 every failure
    # was a ProcessResult whose exit_code was -1.
    pub fn wait(self: @&Process) -> Result<ProcessResult, Errno>
        if self.pid < 0 or self.waited != 0
            return Err(Errno.Child)

        # Close stdin to signal EOF if not already closed
        self.close_stdin()

        var status: i32 = 0
        let ret: i32 = sys_wait4(self.pid, @status, 0, null)

        if ret < 0
            return Err(errno_from_raw(ret))

        self.waited = 1
        Ok(status_result(status))

    # The child's result if it has exited (reaping it, as wait does), or
    # None if it is still running or there is nothing to wait for.  Never blocks:
    # for a caller with a deadline (AGAST #3883).
    pub fn try_wait(self: @&Process) -> Option<ProcessResult>
        if self.pid < 0 or self.waited != 0
            return None
        var status: i32 = 0
        if sys_wait4(self.pid, @status, WNOHANG, null) <= 0
            return None
        self.waited = 1
        Some(status_result(status))

# A wait4 status as a ProcessResult.
fn status_result(status: i32) -> ProcessResult
    var result: ProcessResult
    result.exit_code = -1
    result.signaled = 0
    result.signal = 0

    # WIFEXITED: (status & 127) == 0
    # WEXITSTATUS: (status >> 8) & 255
    # WIFSIGNALED: (status & 127) != 0 and (status & 127) != 127
    # WTERMSIG: status & 127

    let term_signal: i32 = status & 127

    if term_signal == 0
        # Exited normally
        result.exit_code = (status / 256) & 255
        result.signaled = 0
    else if term_signal != 127
        # Killed by signal
        result.signaled = 1
        result.signal = term_signal
        result.exit_code = 128 + term_signal

    return result

# ============================================================================
# ProcessResult helpers
# ============================================================================

# Exited normally with code 0.  The code itself is r.exit_code.
impl ProcessResult
    pub fn success(self: @ProcessResult) -> bool
        self.signaled == 0 and self.exit_code == 0

# ============================================================================
# Process cleanup
# ============================================================================

impl Process
    # Kill the process (if still running)
    pub fn kill(self: @&Process)
        if self.pid > 0 and self.waited == 0
            sys_kill(self.pid, SIGKILL)

    # Close all pipe file descriptors
    pub fn close_pipes(self: @&Process)
        if self.stdin_fd >= 0
            sys_close(self.stdin_fd)
            self.stdin_fd = -1
        if self.stdout_fd >= 0
            sys_close(self.stdout_fd)
            self.stdout_fd = -1
        if self.stderr_fd >= 0
            sys_close(self.stderr_fd)
            self.stderr_fd = -1

    # Full cleanup: wait for child if needed, close pipes
    pub fn cleanup(self: @&Process)
        if self.pid > 0 and self.waited == 0
            # Try to wait non-blocking first
            var status: i32 = 0
            let ret: i32 = sys_wait4(self.pid, @status, WNOHANG, null)
            if ret == 0
                # Still running - kill it
                sys_kill(self.pid, SIGTERM)
                # Brief pause
                var ts: [2]i64
                ts[0] = 0
                ts[1] = 10000000  # 10ms
                sys_nanosleep(@ts[0], null)
                # Check again
                let ret2: i32 = sys_wait4(self.pid, @status, WNOHANG, null)
                if ret2 == 0
                    # Still alive - SIGKILL
                    sys_kill(self.pid, SIGKILL)
                    sys_wait4(self.pid, @status, 0, null)

        self.close_pipes()

# ============================================================================
# Drop trait implementation (for automatic cleanup)
# ============================================================================
# NOTE: ritz1 impl blocks may not be fully supported yet
# impl Drop for Process
#     fn drop(self: @&Process)
#         process_cleanup(self)

# ============================================================================
# fork / exec / wait_pid / kill -> Result (AGAST #4637)
# ============================================================================
# The bare process primitives, for a caller that needs the child itself (a
# daemon, a server worker, a redirect spawn does not cover). To run a program
# and read its output, use spawn above.
#
#     match fork()
#         Ok(fr) => match fr
#             Child =>
#                 ...                          # e.g. p.write.dup_to(1)
#                 exec("/bin/echo", args)      # returns only on failure
#                 sys_exit(127)
#             Parent(pid) =>
#                 match wait_pid(pid)          # Result<ProcessResult, Errno>
#                     Ok(r) => r.exit_code ...
#         Err(e) => ...                        # Again, NoMem

# Which side of a fork this is: the child, or the parent with the child's pid.
pub enum ForkResult
    Child
    Parent(i32)

# fork(2): Ok(Child) in the new process, Ok(Parent(pid)) in this one.
pub fn fork() -> Result<ForkResult, Errno>
    let pid: i32 = sys_fork()
    if pid < 0
        return Err(errno_from_raw(pid))
    if pid == 0
        return Ok(ForkResult.Child)
    Ok(ForkResult.Parent(pid))

# Replace this process with the program at `path` (no $PATH search: see
# find_command), argv[0] = `path`, argv[1..] = `args`, this process's
# environment. Returns only if execve(2) failed, with why (NoEnt, Acces, ...).
#
# standard-exempt: raw-alloc: frees the argv/envp blocks when execve(2) returns; the fork/exec boundary owns it
pub fn exec(path: StrView, args: Span<StrView>) -> Errno
    var argv0: StrView = path
    let argv: **u8 = cstr_array(span_from_ptr<StrView>(@argv0, 1), args)
    if argv == null
        return Errno.NoMem
    let envp: **u8 = cstr_array(env_iter(), span_empty<StrView>())
    if envp == null
        free(argv as *u8)
        return Errno.NoMem
    # argv[0] is a NUL-terminated copy of `path`: hand that to the kernel.
    let rc: i32 = sys_execve(*argv, argv, envp)
    free(envp as *u8)
    free(argv as *u8)
    errno_from_raw(rc)

# Block until child `pid` exits (wait4(2)): Ok(how it exited), Err(Child) if
# it is not a child of this process or was already reaped.
pub fn wait_pid(pid: i32) -> Result<ProcessResult, Errno>
    var status: i32 = 0
    var ret: i32 = sys_wait4(pid, @status, 0, null)
    while ret == -EINTR
        ret = sys_wait4(pid, @status, 0, null)
    if ret < 0
        return Err(errno_from_raw(ret))
    Ok(status_result(status))

# wait_pid without blocking: Ok(Some(result)) if `pid` has exited (reaping
# it), Ok(None) if it is still running, Err(Child) if there is nothing to wait for.
pub fn try_wait_pid(pid: i32) -> Result<Option<ProcessResult>, Errno>
    var status: i32 = 0
    let ret: i32 = sys_wait4(pid, @status, WNOHANG, null)
    if ret < 0
        return Err(errno_from_raw(ret))
    if ret == 0
        return Ok(None)
    Ok(Some(status_result(status)))

# A child reaped by try_wait_any: which one, and how it exited.
pub struct Reaped
    pid: i32
    result: ProcessResult

# try_wait_pid for whichever child has exited (wait4(-1, WNOHANG)):
# Ok(Some(reaped)) reaping one, Ok(None) if every child is still running,
# Err(Child) if there are no children to wait for.
pub fn try_wait_any() -> Result<Option<Reaped>, Errno>
    var status: i32 = 0
    let ret: i32 = sys_wait4(-1, @status, WNOHANG, null)
    if ret < 0
        return Err(errno_from_raw(ret))
    if ret == 0
        return Ok(None)
    Ok(Some(Reaped { pid: ret, result: status_result(status) }))

# Send signal `sig` to process `pid` (kill(2)); sig 0 only checks it exists.
# Err(Other(3)) (ESRCH) if there is no such process.
pub fn kill(pid: i32, sig: i32) -> Result<(), Errno>
    let rc: i32 = sys_kill(pid, sig)
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(())

# Ignore signal `signum` (rt_sigaction(2) with SIG_IGN), e.g. SIGPIPE in a
# server so a write to a closed peer is Err(Pipe) instead of a kill.
[[target_os = "linux"]]
pub fn signal_ignore(signum: i32) -> Result<(), Errno>
    # struct kernel_sigaction { sa_handler @0, sa_flags @8, sa_restorer @16,
    # sa_mask @24 }: all zero but sa_handler = SIG_IGN (1).
    var act: [32]u8
    var i: i64 = 0
    while i < 32
        act[i] = 0
        i += 1
    act[0] = 1
    let rc: i32 = sys_rt_sigaction(signum, @act[0], null, 8)
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(())

# ============================================================================
# Process ids (AGAST #4691): infallible, so plain values
# ============================================================================

# This process's id (getpid(2)).
pub fn process_id() -> i32
    sys_getpid()

# The id of the process that forked this one (getppid(2)); 1, or a
# subreaper's id, once that parent has exited.
[[target_os = "linux"]]
pub fn parent_process_id() -> i32
    sys_getppid()

# This process's real user id (getuid(2)).
[[target_os = "linux"]]
pub fn user_id() -> u32
    sys_getuid() as u32

# Start a new session and process group led by this process (setsid(2)),
# with no controlling terminal: Ok(the new session id, this pid). A child
# about to take a terminal of its own (ritzlib.term's make_controlling_tty)
# does this first. Err(Perm) if this process already leads a process group.
[[target_os = "linux"]]
pub fn new_session() -> Result<i32, Errno>
    # Straight to the kernel, as fd.ritz's fd_fcntl does: this is the
    # Result form, so ritzlib.sys gets no C-shaped sys_setsid to pin.
    let rc: i32 = syscall0(SYS_SETSID) as i32
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(rc)

# ============================================================================
# Signal mask and signalfd (AGAST #4691)
# ============================================================================
#
#     var set: SigSet = sigset_of(SIGTERM)
#     set.add(SIGINT)
#     set.block()                               # Result<SigSet, Errno>: the mask before
#     set.signalfd(SIGNALFD_NONBLOCK | SIGNALFD_CLOEXEC)   # Result<Fd, Errno>
#     match signalfd_read(@sfd)                 # Result<Option<i32>, Errno>
#         Ok(pending) => match pending
#             Some(sig) => ...                  # SIGTERM or SIGINT
#             None => ...                       # nothing pending
#         Err(e) => ...

# SigSet.signalfd flags (SFD_NONBLOCK, SFD_CLOEXEC).
pub const SIGNALFD_NONBLOCK: i32 = 2048
pub const SIGNALFD_CLOEXEC: i32 = 524288

const PROC_SIG_BLOCK: i32 = 0
const PROC_SIG_SETMASK: i32 = 2
const PROC_SIGSET_BYTES: i64 = 8
const PROC_SIGINFO_BYTES: i64 = 128
const PROC_EIO: i32 = 5

# A set of signals 1..64, as the kernel's 64-bit mask: signal n is bit n - 1.
pub struct SigSet
    bits: u64

# The set with no signals in it.
pub fn sigset_empty() -> SigSet
    SigSet { bits: 0 }

# The set holding just `sig`.
pub fn sigset_of(sig: i32) -> SigSet
    var s: SigSet = sigset_empty()
    s.add(sig)
    s

# rt_sigprocmask(2) with `how` and `set`: Ok(the mask before).
[[target_os = "linux"]]
fn sigmask_change(how: i32, bits: u64) -> Result<SigSet, Errno>
    var next: i64 = bits as i64
    var prev: i64 = 0
    let rc: i32 = sys_rt_sigprocmask(how, @next, @prev, PROC_SIGSET_BYTES)
    if rc < 0
        return Err(errno_from_raw(rc))
    Ok(SigSet { bits: prev as u64 })

# Methods (S-IMPL-1): a SigSet is the subject of every operation on it.
impl SigSet
    # Put `sig` in the set; a number outside 1..64 names no signal and is ignored.
    pub fn add(self: @&SigSet, sig: i32)
        if sig >= 1 and sig <= 64
            self.bits = self.bits | ((1 as u64) << ((sig - 1) as u64))

    # Is `sig` in the set? Never for a number outside 1..64.
    pub fn contains(self: @SigSet, sig: i32) -> bool
        if sig < 1 or sig > 64
            return false
        (self.bits & ((1 as u64) << ((sig - 1) as u64))) != 0

    # Block these signals, added to those already blocked (rt_sigprocmask(2)
    # SIG_BLOCK): Ok(the mask before), which `old.set_mask()` puts back.
    pub fn block(self: @SigSet) -> Result<SigSet, Errno>
        sigmask_change(PROC_SIG_BLOCK, self.bits)

    # Make this set the whole signal mask (SIG_SETMASK; sigset_empty()
    # unblocks everything): Ok(the mask before).
    pub fn set_mask(self: @SigSet) -> Result<SigSet, Errno>
        sigmask_change(PROC_SIG_SETMASK, self.bits)

    # A new signalfd(2) that reads these signals (block() them first, or they
    # are delivered as usual instead), owned by the caller. `flags`:
    # SIGNALFD_NONBLOCK, SIGNALFD_CLOEXEC; anything else is Err(Inval).
    pub fn signalfd(self: @SigSet, flags: i32) -> Result<Fd, Errno>
        var mask: i64 = self.bits as i64
        let rc: i32 = sys_signalfd4(-1, @mask, flags)
        if rc < 0
            return Err(errno_from_raw(rc))
        Ok(fd_adopt(rc))

# The next pending signal from signalfd `fd`: Ok(Some(signal number)),
# Ok(None) if a nonblocking fd has none pending. A short read is Err(Io).
[[target_os = "linux"]]
pub fn signalfd_read(fd: @Fd) -> Result<Option<i32>, Errno>
    # struct signalfd_siginfo is 128 bytes; ssi_signo is the u32 at offset 0.
    var info: [128]u8
    match fd.read(Span<u8> { ptr: @info[0], len: PROC_SIGINFO_BYTES })
        Ok(n) =>
            if n != PROC_SIGINFO_BYTES
                return Err(errno_from_raw(PROC_EIO))
        Err(e) =>
            match e
                Again => return Ok(None)
                _ => return Err(e)
    let signo: i32 = (info[0] as i32) | ((info[1] as i32) << 8) | ((info[2] as i32) << 16) | ((info[3] as i32) << 24)
    Ok(Some(signo))

# Block SIGTERM and SIGINT and return a signalfd(2) that reads them instead
# (nonblocking, close-on-exec), for a server's graceful shutdown in its poll
# loop: read it with signalfd_read. The caller owns the Fd.
[[target_os = "linux"]]
pub fn signalfd_create_for_shutdown() -> Result<Fd, Errno>
    var set: SigSet = sigset_of(SIGTERM)
    set.add(SIGINT)
    match set.block()
        Ok(_) => set.signalfd(SIGNALFD_NONBLOCK | SIGNALFD_CLOEXEC)
        Err(e) => Err(e)
