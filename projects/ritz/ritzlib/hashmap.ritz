# ritzlib/hashmap.ritz - Hash maps: HashMap<K, V>, and HashMapI64
#
# HashMap<K: Hash + Eq, V> (AGAST #1858) takes any key type with ritzlib's
# Hash and Eq (hash.ritz):
#   var m: HashMap<StrView, i64> = hashmap_new<StrView, i64>()
#   m.insert("one", 1)
#   match m.get("one")       # Option<i64>: a missing key is None
#       Some(v) => v
#       None => 0
#   hashmap_drop(@&m)
# A primitive key works where the trait's file impls Hash/Eq for it: hash.ritz
# carries i64 (R36 revisit, #4294), so HashMap<i64, V> is legal too.
#
# HashMapI64, below it, maps i64 to i64.
# Provides O(1) average lookup, insert, and delete.
# Uses open addressing with linear probing.
#
# Usage:
#   var m: HashMapI64 = hashmap_i64_new()
#   hashmap_i64_insert(@&m, 42, 100)
#   let val: i64 = hashmap_i64_get(@m, 42)
#
# Or by index (LANGUAGE_SPEC §7.8): `m[42] = 100` inserts, and `m[42]` reads,
# ending the program on a missing key.

import ritzlib.memory
import ritzlib.str      # memcpy
import ritzlib.hash
import ritzlib.drop
import ritzlib.fmt.digits      # fmt_i64_into: the one digit routine (AGAST #1856)
import ritzlib.strview  # StrView
import ritzlib.gvec     # Vec<T>, HashMap's slots
import ritzlib.option   # Option<V>, HashMap.get

# Core (tools/ritzlib_layers.py, AGAST #4119): no ritzlib.sys, so a missing key
# ends the program through this platform hook.  ritzlib.sys defines it for a
# hosted program (stderr, then exit); a freestanding one defines its own.
extern fn ritz_platform_fatal(msg: *u8, len: i64, status: i32)

# What a table slot holds.  A lookup stops at Empty and steps over Tomb, so a
# removal leaves Tomb to keep the probe chains through it intact; insert
# reuses the first Tomb on the key's chain.
pub enum Slot
    Empty   # never used
    Full    # holds a live key/value
    Tomb    # held a key that was removed

struct HashMapEntryI64
    key: i64
    value: i64
    state: Slot

struct HashMapI64
    entries: *HashMapEntryI64  # Array of entries
    cap: i64                    # Capacity (power of 2)
    len: i64                    # Number of occupied entries
    tombstones: i64             # Number of tombstones

# ============================================================================
# Drop trait implementation
# ============================================================================

impl Drop for HashMapI64
    fn drop(self: @&HashMapI64)
        let ptr: *u8 = self.entries as *u8
        if ptr != null
            free(ptr)
        self.entries = null
        self.cap = 0
        self.len = 0
        self.tombstones = 0

# ============================================================================
# Constructor
# ============================================================================

pub fn hashmap_i64_new() -> HashMapI64
    return hashmap_i64_with_cap(16)

pub fn hashmap_i64_with_cap(cap: i64) -> HashMapI64
    return hashmap_i64_with_cap_in(null, cap)

# A HashMapI64 whose table comes from `a` (AGAST #4327): every grow builds the
# bigger table there too, and drop frees back to it (the block's header names
# its owner; see malloc_in). A null `a` is the global heap.
pub fn hashmap_i64_new_in(a: *Allocator) -> HashMapI64
    return hashmap_i64_with_cap_in(a, 16)

# hashmap_i64_with_cap, with the table from `a`; empty (cap 0, entries null)
# if `a` is out of memory.
pub fn hashmap_i64_with_cap_in(a: *Allocator, cap: i64) -> HashMapI64
    # Initialize to null BEFORE malloc to prevent Drop on garbage if malloc fails
    var m: HashMapI64 = HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 }

    # Round up to power of 2
    var actual_cap: i64 = 16
    while actual_cap < cap
        actual_cap *= 2

    let size: i64 = actual_cap * sizeof(HashMapEntryI64)
    m.entries = malloc_in(a, size) as *HashMapEntryI64
    if m.entries == null
        return m
    m.cap = actual_cap

    # Initialize all entries to empty
    for i in 0..actual_cap
        let entry: *HashMapEntryI64 = m.entries + i
        entry.state = Slot.Empty

    return m

# ============================================================================
# Method syntax support - enables m.len(), m.insert(k, v), etc.
# ============================================================================

impl HashMapI64
    # Get the number of entries in the map.
    pub fn len(self: @HashMapI64) -> i64
        return self.len

    # Get the capacity of the map.
    pub fn cap(self: @HashMapI64) -> i64
        return self.cap

    # Check if the map is empty.
    pub fn is_empty(self: @HashMapI64) -> bool
        self.len == 0

    # Insert or update a key-value pair.
    pub fn insert(self: @&HashMapI64, key: i64, value: i64)
        hashmap_i64_insert(self, key, value)

    # Get value for key (returns 0 if not found).
    pub fn get(self: @HashMapI64, key: i64) -> i64
        return hashmap_i64_get(self, key)

    # Check if key exists.
    pub fn contains(self: @HashMapI64, key: i64) -> bool
        return hashmap_i64_contains(self, key)

    # Remove a key (returns 1 if removed, 0 if not found).
    pub fn remove(self: @&HashMapI64, key: i64) -> i32
        return hashmap_i64_remove(self, key)

# ============================================================================
# Core operations (standalone functions)
# ============================================================================

pub fn hashmap_i64_len(m: @HashMapI64) -> i64
    return m.len

pub fn hashmap_i64_cap(m: @HashMapI64) -> i64
    return m.cap

pub fn hashmap_i64_is_empty(m: @HashMapI64) -> bool
    m.len == 0

# Drop (free) the hashmap - prefer automatic Drop via scope exit.
pub fn hashmap_i64_drop(m: @&HashMapI64)
    let ptr: *u8 = m.entries as *u8
    if ptr != null
        free(ptr)
    m.entries = null
    m.cap = 0
    m.len = 0
    m.tombstones = 0

# Clear all entries without freeing the backing allocation — used when a
# scope owns the map for its lifetime but wants to reuse the slab between
# logical phases (e.g. emit_fn resetting the per-function locals map at
# function start).  Cheaper than drop + new for the common `cap` case.
pub fn hashmap_i64_clear(m: @&HashMapI64)
    if m.entries == null
        return
    var i: i64 = 0
    while i < m.cap
        let entry: *HashMapEntryI64 = m.entries + i
        entry.state = Slot.Empty
        i = i + 1
    m.len = 0
    m.tombstones = 0

# ============================================================================
# Find, Insert, Get, Contains, Remove
# ============================================================================

# Where key's probe chain starts: its hash masked to the power-of-2 capacity.
fn hashmap_i64_home(m: @HashMapI64, key: i64) -> i64
    (hash_i64(key) as i64) & (m.cap - 1)

# The one lookup probe: the index of the Full slot holding key, or None.  It
# stops at the first Empty slot and steps over Tomb ones.  get, value_ptr,
# contains and remove are all wrappers over it.
pub fn hashmap_i64_find(m: @HashMapI64, key: i64) -> Option<i64>
    let mask: i64 = m.cap - 1
    var idx: i64 = hashmap_i64_home(m, key)
    var i: i64 = 0
    while i < m.cap
        let entry: *HashMapEntryI64 = m.entries + idx
        if entry.state == Slot.Empty
            return None
        if entry.state == Slot.Full and entry.key == key
            return Some(idx)
        idx = (idx + 1) & mask
        i += 1
    None

# The slot insert writes key to: key's own slot if present, else the first
# Tomb on its chain, else the Empty slot ending the chain; -1 if the table is
# full with neither.
pub fn hashmap_i64_find_slot(m: @HashMapI64, key: i64) -> i64
    let mask: i64 = m.cap - 1
    var idx: i64 = hashmap_i64_home(m, key)
    var first_tomb: i64 = -1
    var i: i64 = 0
    while i < m.cap
        let entry: *HashMapEntryI64 = m.entries + idx
        if entry.state == Slot.Empty
            if first_tomb >= 0
                return first_tomb
            return idx
        if entry.state == Slot.Tomb
            if first_tomb < 0
                first_tomb = idx
        else if entry.key == key
            return idx
        idx = (idx + 1) & mask
        i += 1
    first_tomb

# Insert or update a key-value pair
pub fn hashmap_i64_insert(m: @&HashMapI64, key: i64, value: i64)
    # An empty table (dropped, or its allocator was out of memory) gets one.
    if m.cap == 0
        hashmap_i64_grow(m)
        if m.cap == 0
            return
    # Check load factor and resize if needed (> 75%)
    let load: i64 = (m.len + m.tombstones + 1) * 100 / m.cap
    if load > 75
        hashmap_i64_grow(m)

    let idx: i64 = hashmap_i64_find_slot(m, key)
    if idx < 0
        # Table full - should not happen after resize
        return

    let entry: *HashMapEntryI64 = m.entries + idx

    if entry.state == Slot.Full  # key is present - update
        entry.value = value
    else
        if entry.state == Slot.Tomb
            m.tombstones = m.tombstones - 1
        entry.key = key
        entry.value = value
        entry.state = Slot.Full
        m.len = m.len + 1

# Get value for key (returns 0 if not found - use contains to check)
pub fn hashmap_i64_get(m: @HashMapI64, key: i64) -> i64
    match hashmap_i64_find(m, key)
        Some(idx) =>
            let entry: *HashMapEntryI64 = m.entries + idx
            entry.value
        None => 0

# The value slot for key, or None when the key is missing.
pub fn hashmap_i64_value_ptr(m: @HashMapI64, key: i64) -> Option<*i64>
    match hashmap_i64_find(m, key)
        Some(idx) =>
            let entry: *HashMapEntryI64 = m.entries + idx
            Some(@entry.value)
        None => None

# `m[key]` on a key the map doesn't hold (LANGUAGE_SPEC §7.8): a reference can't be
# empty, so `index` and `index_mut` end the program here, with status 101.
# Test for a key with hashmap_i64_contains, or read it with hashmap_i64_get.
pub fn hashmap_i64_missing_key(key: i64)
    let prefix: StrView = "HashMapI64: key not found: "
    var buf: [48]u8
    memcpy(@buf[0], prefix.ptr, prefix.len)
    let n: i64 = prefix.len + fmt_i64_into(@buf[prefix.len], key)
    ritz_platform_fatal(@buf[0], n, 101)

# ============================================================================
# Indexing: m[k] (LANGUAGE_SPEC §7.8, LARB R15)
# ============================================================================

# A shared use of `m[k]`: a read, `.f`, `@m[k]`.
impl Index for HashMapI64
    pub fn index(self: @HashMapI64, key: i64) -> @i64
        let p: *i64 = match hashmap_i64_value_ptr(self, key)
            Some(p) => p
            None =>
                hashmap_i64_missing_key(key)
                null as *i64
        @*p

# A mutable use of `m[k]`: `@&m[k]`, `m[k] += x`.
impl IndexMut for HashMapI64
    pub fn index_mut(self: @&HashMapI64, key: i64) -> @&i64
        let p: *i64 = match hashmap_i64_value_ptr(self, key)
            Some(p) => p
            None =>
                hashmap_i64_missing_key(key)
                null as *i64
        @&*p

# `m[k] = v`, which inserts a missing key.
impl IndexSet for HashMapI64
    pub fn index_set(self: @&HashMapI64, key: i64, value: i64)
        hashmap_i64_insert(self, key, value)

# Check if key exists
pub fn hashmap_i64_contains(m: @HashMapI64, key: i64) -> bool
    match hashmap_i64_find(m, key)
        Some(_) => true
        None => false

# Remove a key (returns 1 if removed, 0 if not found).  Its slot becomes a
# Tomb so the chains of keys probed past it still reach them.
pub fn hashmap_i64_remove(m: @&HashMapI64, key: i64) -> i32
    let idx: i64 = match hashmap_i64_find(m, key)
        Some(idx) => idx
        None => return 0
    let entry: *HashMapEntryI64 = m.entries + idx
    entry.state = Slot.Tomb
    m.len = m.len - 1
    m.tombstones = m.tombstones + 1
    1

# Grow the table (double capacity)
pub fn hashmap_i64_grow(m: @&HashMapI64)
    let old_entries: *HashMapEntryI64 = m.entries
    let old_cap: i64 = m.cap

    # Allocate new table with double capacity
    # The new table comes from the same Allocator as the old one.
    var new_cap: i64 = old_cap * 2
    if new_cap == 0
        new_cap = 16
    let size: i64 = new_cap * sizeof(HashMapEntryI64)
    let new_entries: *HashMapEntryI64 = malloc_in(allocator_of(old_entries as *u8), size) as *HashMapEntryI64
    if new_entries == null
        return  # Out of memory: keep the old table
    m.entries = new_entries
    m.cap = new_cap
    m.len = 0
    m.tombstones = 0

    # Initialize new entries to empty
    for i in 0..new_cap
        let entry: *HashMapEntryI64 = m.entries + i
        entry.state = Slot.Empty

    # Rehash all occupied entries from old table
    for i in 0..old_cap
        let old_entry: *HashMapEntryI64 = old_entries + i
        if old_entry.state == Slot.Full
            hashmap_i64_insert(m, old_entry.key, old_entry.value)

    # Free old table (free(null) is a no-op)
    free(old_entries as *u8)

# ============================================================================
# HashMap<K: Hash + Eq, V> - the generic map
# ============================================================================
# The same open addressing as HashMapI64: linear probing over a power-of-2
# table of slots, each Empty, Full or Tomb.  The table is a Vec whose len is
# its capacity, every slot initialised.

struct HashMapEntry<K, V>
    key: K
    value: V
    state: Slot

struct HashMap<K: Hash + Eq, V>
    slots: Vec<HashMapEntry<K, V>>
    len: i64          # Full slots
    tombstones: i64   # Tomb slots

# An empty map with 16 slots.
pub fn hashmap_new<K: Hash + Eq, V>() -> HashMap<K, V>
    hashmap_with_cap<K, V>(16)

# An empty map with room for cap slots, rounded up to a power of 2 (min 16).
pub fn hashmap_with_cap<K: Hash + Eq, V>(cap: i64) -> HashMap<K, V>
    hashmap_with_cap_in<K, V>(null, cap)

# An empty map whose table comes from `a` (AGAST #4120): each grow builds the
# bigger table in `a` too, and hashmap_drop gives it back there. A null `a`
# is the global heap.
pub fn hashmap_new_in<K: Hash + Eq, V>(a: *Allocator) -> HashMap<K, V>
    hashmap_with_cap_in<K, V>(a, 16)

# hashmap_with_cap, with the table from `a`.
pub fn hashmap_with_cap_in<K: Hash + Eq, V>(a: *Allocator, cap: i64) -> HashMap<K, V>
    var n: i64 = 16
    while n < cap
        n *= 2
    var m: HashMap<K, V>
    m.slots = vec_with_cap_in<HashMapEntry<K, V>>(a, n)
    m.slots.len = n
    for i in 0..n
        let e: *HashMapEntry<K, V> = vec_get_ptr<HashMapEntry<K, V>>(@&m.slots, i)
        e.state = Slot.Empty
    m.len = 0
    m.tombstones = 0
    m

# Free the table.  The map is empty afterwards, with no slots; it can't be
# used again until reassigned from hashmap_new.
pub fn hashmap_drop<K: Hash + Eq, V>(m: @&HashMap<K, V>)
    vec_drop<HashMapEntry<K, V>>(@&m.slots)
    m.len = 0
    m.tombstones = 0

impl<K: Hash + Eq, V> HashMap<K, V>
    # The number of keys.
    pub fn len(self: @HashMap<K, V>) -> i64
        self.len

    # Insert key, or overwrite its value if present.
    pub fn insert(self: @&HashMap<K, V>, key: K, value: V)
        hashmap_insert<K, V>(self, key, value)

    # The value for key, or None.
    pub fn get(self: @HashMap<K, V>, key: K) -> Option<V>
        hashmap_get<K, V>(self, key)

    pub fn contains(self: @HashMap<K, V>, key: K) -> bool
        hashmap_find<K, V>(self, @key) >= 0

    # Remove key: true if it was there.
    pub fn remove(self: @&HashMap<K, V>, key: K) -> bool
        hashmap_remove<K, V>(self, key)

fn hashmap_slot<K: Hash + Eq, V>(m: @HashMap<K, V>, i: i64) -> *HashMapEntry<K, V>
    m.slots.data + i

# The index of the Full slot holding key, or -1: it stops at the first Empty
# slot and steps over Tomb ones.
fn hashmap_find<K: Hash + Eq, V>(m: @HashMap<K, V>, key: @K) -> i64
    let mask: i64 = m.slots.len - 1
    var idx: i64 = (key.hash() as i64) & mask
    for i in 0..m.slots.len
        let e: *HashMapEntry<K, V> = hashmap_slot<K, V>(m, idx)
        if e.state == Slot.Empty
            return -1
        if e.state == Slot.Full and e.key.equals(key)
            return idx
        idx = (idx + 1) & mask
    -1

# The slot insert writes key to: key's own, else the first Tomb on its chain,
# else the Empty slot ending it; -1 if the table has neither.
fn hashmap_find_slot<K: Hash + Eq, V>(m: @HashMap<K, V>, key: @K) -> i64
    let mask: i64 = m.slots.len - 1
    var idx: i64 = (key.hash() as i64) & mask
    var first_tomb: i64 = -1
    for i in 0..m.slots.len
        let e: *HashMapEntry<K, V> = hashmap_slot<K, V>(m, idx)
        if e.state == Slot.Empty
            if first_tomb >= 0
                return first_tomb
            return idx
        if e.state == Slot.Tomb
            if first_tomb < 0
                first_tomb = idx
        else if e.key.equals(key)
            return idx
        idx = (idx + 1) & mask
    first_tomb

pub fn hashmap_insert<K: Hash + Eq, V>(m: @&HashMap<K, V>, key: K, value: V)
    # Keep Full + Tomb at most 75% of the table.
    if (m.len + m.tombstones + 1) * 100 / m.slots.len > 75
        hashmap_grow<K, V>(m)
    let idx: i64 = hashmap_find_slot<K, V>(m, @key)
    let e: *HashMapEntry<K, V> = hashmap_slot<K, V>(m, idx)
    if e.state == Slot.Full
        e.value = value
        return
    if e.state == Slot.Tomb
        m.tombstones -= 1
    e.key = key
    e.value = value
    e.state = Slot.Full
    m.len += 1

pub fn hashmap_get<K: Hash + Eq, V>(m: @HashMap<K, V>, key: K) -> Option<V>
    let idx: i64 = hashmap_find<K, V>(m, @key)
    if idx < 0
        return None
    let e: *HashMapEntry<K, V> = hashmap_slot<K, V>(m, idx)
    Some(e.value)

# Remove key, leaving a Tomb so the chains through its slot stay intact.
pub fn hashmap_remove<K: Hash + Eq, V>(m: @&HashMap<K, V>, key: K) -> bool
    let idx: i64 = hashmap_find<K, V>(m, @key)
    if idx < 0
        return false
    let e: *HashMapEntry<K, V> = hashmap_slot<K, V>(m, idx)
    e.state = Slot.Tomb
    m.len -= 1
    m.tombstones += 1
    true

# The number of keys in the map.
pub fn hashmap_len<K: Hash + Eq, V>(m: @HashMap<K, V>) -> i64
    m.len

# The number of slots in the table, a power of 2.  With hashmap_slot_state
# and hashmap_slot_value this walks every entry:
#   for i in 0..hashmap_cap(@m)
#       if hashmap_slot_state(@m, i) == Slot.Full
#           let v: V = hashmap_slot_value(@m, i)
# A caller must not insert or remove until the walk ends.
pub fn hashmap_cap<K: Hash + Eq, V>(m: @HashMap<K, V>) -> i64
    m.slots.len

# The state of slot i: Empty, Full or Tomb.  Tomb is a slot that held a
# removed key; a walk that wants every key treats it as empty.
pub fn hashmap_slot_state<K: Hash + Eq, V>(m: @HashMap<K, V>, i: i64) -> Slot
    let e: *HashMapEntry<K, V> = m.slots.data + i
    e.state

# The value in slot i.  Meaningful when hashmap_slot_state says Full.
pub fn hashmap_slot_value<K: Hash + Eq, V>(m: @HashMap<K, V>, i: i64) -> V
    let e: *HashMapEntry<K, V> = m.slots.data + i
    e.value

# Remove every key, leaving the table allocated at its current capacity.
# The map never frees a value, so the caller drops what its values own
# first (as HashMapI64's clear does for its i64 values: nothing).
pub fn hashmap_clear<K: Hash + Eq, V>(m: @&HashMap<K, V>)
    for i in 0..m.slots.len
        let e: *HashMapEntry<K, V> = m.slots.data + i
        e.state = Slot.Empty
    m.len = 0
    m.tombstones = 0

# Double the table and reinsert every Full slot, dropping the Tombs.
fn hashmap_grow<K: Hash + Eq, V>(m: @&HashMap<K, V>)
    # In the old table's Allocator (null, the global heap, for hashmap_new).
    let a: *Allocator = allocator_of(m.slots.data as *u8)
    var bigger: HashMap<K, V> = hashmap_with_cap_in<K, V>(a, m.slots.len * 2)
    for i in 0..m.slots.len
        let e: *HashMapEntry<K, V> = m.slots.data + i
        if e.state == Slot.Full
            hashmap_insert<K, V>(@&bigger, e.key, e.value)
    hashmap_drop<K, V>(m)
    m.slots = bigger.slots
    m.len = bigger.len
