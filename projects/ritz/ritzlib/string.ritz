# ritzlib/string.ritz - Owned string type
#
# String provides an owned, growable UTF-8 string.
# Internally uses Vec<u8> for storage.
#
# For low-level C-style string operations on *u8, see ritzlib.str
# (strlen, strcmp, strcpy, memcpy, etc.)
#
# Usage:
#   var s: String = string_from("hello")
#   s.push_str(" world")
#   prints(s.as_ptr())
#   # Automatic cleanup when s goes out of scope (Drop trait)

import ritzlib.memory
import ritzlib.str     # memcpy, strlen
import ritzlib.gvec
import ritzlib.drop
import ritzlib.hash
import ritzlib.fmt.digits
import ritzlib.strview  # StrView: the one byte-view type (AGAST #1930)

# ============================================================================
# String - Owned UTF-8 String
# ============================================================================
# Wrapper around Vec<u8> with string-specific operations.
# Always null-terminated for C interop.

struct String
    data: Vec<u8>    # Underlying byte storage

# ============================================================================
# Drop trait implementation for automatic cleanup
# ============================================================================

# The bytes are freed by the owning binding's drop (AGAST #2159, #1854):
# this impl frees through the Vec<u8> field first, which nulls its data, so
# the field's own drop that follows is a no-op. Don't call string_drop on an
# owned String: it would free the bytes a second time.
impl Drop for String
    fn drop(self: @&String)
        self.data.deinit()

# ============================================================================
# Constructors
# ============================================================================

# Create an empty string.
pub fn string_new() -> String
    var s: String = String { data: vec_new<u8>() }
    return s

# Create a string with pre-allocated capacity.
pub fn string_with_cap(cap: i64) -> String
    var s: String = String { data: vec_with_cap<u8>(cap) }
    return s

# An empty string whose bytes come from `a` (AGAST #4120): every grow and the
# final string_drop go back to `a`. See vec_new_in.
# standard-exempt: raw-ptr-param: allocator: the *Allocator this string draws its bytes from
pub fn string_new_in(a: *Allocator) -> String
    var s: String = String { data: vec_new_in<u8>(a) }
    return s

# string_with_cap, with the bytes from `a`.
# standard-exempt: ptr-len-param: allocator: `cap` sizes the allocation this *Allocator creates
# standard-exempt: raw-ptr-param: allocator: the *Allocator that sizes and owns the bytes
pub fn string_with_cap_in(a: *Allocator, cap: i64) -> String
    var s: String = String { data: vec_with_cap_in<u8>(a, cap) }
    return s

# Create a string from a StrView (the default string literal type in RERITZ).
# Copies the bytes into owned storage.
# Example: let s: String = string_from("hello")
pub fn string_from(sv: StrView) -> String
    var s: String = String { data: vec_new<u8>() }

    # Reserve room for the NUL string_as_ptr adds; on failure, stay empty.
    if s.data.ensure_cap(sv.len + 1)
        s.push_span(Span<u8> { ptr: sv.ptr, len: sv.len })

    return s

# Create a string from a C string (null-terminated *u8).
# DEPRECATED: Use string_from() with StrView instead.
# For FFI C strings, convert to StrView first: string_from(strview_from_cstr(cstr))
# standard-exempt: raw-ptr-param: NUL-terminated C-string ABI
pub fn string_from_cstr(cstr: *u8) -> String
    var s: String = String { data: vec_new<u8>() }

    # Reserve room for the NUL string_as_ptr adds; on failure, stay empty.
    let len: i64 = strlen(cstr)
    if s.data.ensure_cap(len + 1)
        s.push_span(Span<u8> { ptr: cstr, len: len })

    return s

# Create a string from a slice of bytes (not null-terminated).
pub fn string_from_bytes(bytes: Span<u8>) -> String
    var s: String = String { data: vec_new<u8>() }

    # Reserve room for the NUL string_as_ptr adds; on failure, stay empty.
    if s.data.ensure_cap(bytes.len + 1)
        s.push_span(bytes)

    return s

# Create a string from a StrView.
# This is the primary way to convert string literals to owned Strings in RERITZ mode.
# Example: let s: String = string_from_strview("hello")
pub fn string_from_strview(sv: StrView) -> String
    return string_from_bytes(Span<u8> { ptr: (sv.ptr), len: (sv.len) as i64 })

# A malloc'd NUL-terminated copy of sv; the caller free()s it. This was
# StrView.to_cstr until AGAST #4601 made ritzlib.strview heap-free. For a view
# already NUL-terminated (every literal is), sv.as_cstr_unchecked() copies nothing.
pub fn strview_to_cstr(sv: StrView) -> *u8
    let buf: *u8 = malloc(sv.len + 1)
    memcpy(buf, sv.ptr, sv.len)
    *(buf + sv.len) = 0
    return buf

# ============================================================================
# Number to String conversion
# ============================================================================

# Convert an i64 to a String.
pub fn string_from_i64(n: i64) -> String
    var s: String = string_new()
    s.push_i64(n)
    return s

# Convert a u64 to a hex string (with 0x prefix).
pub fn string_from_hex(n: u64) -> String
    var s: String = string_new()
    s.push_str("0x")
    var buf: [16]u8
    let len: i64 = fmt_u64_hex_into(@buf[0], n)
    s.push_span(Span<u8> { ptr: @buf[0], len: len })
    return s

# ============================================================================
# Case conversion (ASCII)
# ============================================================================

# Return a new String with the view's ASCII uppercase letters lowered.
# Allocates: a StrView cannot own the rewritten bytes.
pub fn strview_to_lower(sv: StrView) -> String
    var out: String = string_with_cap(sv.len)
    var i: i64 = 0
    while i < sv.len
        var b: u8 = *(sv.ptr + i)
        if b >= 65 and b <= 90
            b = b + 32
        out.push(b)
        i += 1
    return out

# ============================================================================
# Method syntax (LARB R66, AGAST #3495)
# ============================================================================
# The instance methods carry the implementation; the free fns they used to
# wrap are gone (AGAST #4533). Constructors are static: `String.from("x")`.
# `drop` is not defined here: ritz0 takes any `drop` method as the type's
# destructor, so explicit early freeing is `s.deinit()` instead.
impl String
    pub fn new() -> String
        return string_new()

    pub fn with_cap(cap: i64) -> String
        return string_with_cap(cap)

    pub fn from(sv: StrView) -> String
        return string_from(sv)

    # standard-exempt: raw-ptr-param: NUL-terminated C-string ABI
    pub fn from_cstr(cstr: *u8) -> String
        return string_from_cstr(cstr)

    pub fn from_bytes(bytes: Span<u8>) -> String
        return string_from_bytes(bytes)

    pub fn from_strview(sv: StrView) -> String
        return string_from_strview(sv)

    pub fn from_i64(n: i64) -> String
        return string_from_i64(n)

    pub fn from_hex(n: u64) -> String
        return string_from_hex(n)

    # Drop (free) the string.
    pub fn deinit(self: @&String)
        self.data.deinit()

    # Get the length of the string (not including null terminator).
    pub fn len(self: @String) -> i64
        return self.data.len

    # Get the capacity of the string.
    pub fn cap(self: @String) -> i64
        return self.data.cap

    # Check if the string is empty.
    pub fn is_empty(self: @String) -> bool
        if self.data.len == 0
            return true
        return false

    # Get a null-terminated C string pointer.
    # The pointer is valid until the String is modified or dropped.
    # If the byte for the NUL can't be allocated, nothing is written: an empty
    # String reads as c"", a non-empty one returns null (AGAST #3551).
    # standard-exempt: null-return: raw pointer to the String's own buffer; null only when the NUL slot allocation fails (allocator boundary)
    pub fn as_ptr(self: @&String) -> *u8
        # Ensure null-terminated
        let len: i64 = self.data.len
        if not self.data.ensure_cap(len + 1)
            if len == 0
                return c""
            return null
        let ptr: *u8 = self.data.data
        *(ptr + len) = 0  # Null terminate
        return ptr

    # Borrow the string's bytes as a StrView (no copy, no NUL needed).
    # The view is valid until the String is modified or dropped. This is how a
    # String prints in an interpolation: print("s={s.as_view()}") (#1641),
    # and how it reaches a StrView-taking API: path_exists(s.as_view()).
    pub fn as_view(self: @String) -> StrView
        return StrView { ptr: self.data.data, len: self.data.len }

    # Get a byte at the given index.
    pub fn get(self: @String, idx: i64) -> u8
        return self.data.get(idx)

    # Push a single byte onto the string.
    pub fn push(self: @&String, b: u8) -> bool
        return self.data.push(b)

    # Push a StrView onto the string. A "..." literal is a StrView, so it passes
    # straight in. For a NUL-terminated C string use s.push_cstr.
    pub fn push_str(self: @&String, sv: StrView) -> bool
        return self.push_span(Span<u8> { ptr: sv.ptr, len: sv.len })

    # Push a NUL-terminated C string onto the string (FFI / *u8 interop).
    # The length is measured first, so cstr may be s.as_ptr() itself.
    # standard-exempt: raw-ptr-param: NUL-terminated C-string ABI
    pub fn push_cstr(self: @&String, cstr: *u8) -> bool
        return self.push_span(Span<u8> { ptr: cstr, len: strlen(cstr) })

    # Push another String onto this string. `other` may be `s` itself.
    pub fn push_string(self: @&String, other: @String) -> bool
        return self.push_span(Span<u8> { ptr: other.data.data, len: other.data.len })

    # Push a slice of bytes (explicit length, no null-termination required).
    #
    # The one bulk append every other push_*, constructor and clone goes through
    # (AGAST #1931): reserve the whole length once, then memcpy. true on success,
    # false if the reserve fails, in which case the String is left untouched.
    # len <= 0 appends nothing. `bytes` may point into the string's own buffer: it is
    # re-derived after the reserve, which can move that buffer.
    pub fn push_span(self: @&String, bytes_sv: Span<u8>) -> bool
        let bytes: *u8 = bytes_sv.ptr
        let len: i64 = bytes_sv.len
        if len <= 0
            return true
        let old_len: i64 = self.data.len
        # Keep old_len + len (and `Vec.ensure_cap`'s doubling of it) from overflowing.
        if len > 4611686018427387904 - old_len
            return false

        # Is the source inside our own buffer? Remember its offset if so.
        let base: i64 = self.data.data as i64
        let src: i64 = bytes as i64
        var own: bool = false
        if base != 0 and src >= base and src < base + self.data.cap
            own = true

        if not self.data.ensure_cap(old_len + len)
            return false

        var from: *u8 = bytes
        if own
            from = self.data.data + (src - base)
        memcpy(self.data.data + old_len, from, len)
        self.data.len = old_len + len
        return true

    # format_into's sink (LANGUAGE_SPEC §2.6, AGAST #4555). The compiler
    # builds the Span from the bytes it is appending.
    pub fn push_bytes(self: @&String, bytes: Span<u8>) -> bool
        return self.push_span(bytes)

    # Clear the string (keeps capacity).
    pub fn clear(self: @&String)
        self.data.clear()

    # Pop the last byte.
    pub fn pop(self: @&String) -> u8
        return self.data.pop()

    # Compare a String with a StrView for equality. A "..." literal is a StrView:
    #     if s.eq("hello")
    pub fn eq(self: @String, other: StrView) -> bool
        return self.eq_strview(other)

    # Compare two Strings for equality.
    pub fn eq_string(self: @String, b: @String) -> bool
        return self.eq_strview(b.as_view())

    # Hash a string (for use in HashMap).
    pub fn hash(self: @String) -> u64
        var h: u64 = fnv1a_init()
        let len: i64 = self.data.len
        for i in 0..len
            h = fnv1a_byte(h, self.data.get(i))
        return h

    # Compare a String to a C string.
    # standard-exempt: raw-ptr-param: NUL-terminated C-string ABI
    pub fn eq_cstr(self: @String, cstr: *u8) -> bool
        let len: i64 = self.data.len

        var i: i64 = 0
        while i < len
            if *(cstr + i) == 0
                return false  # cstr is shorter
            if self.data.get(i) != *(cstr + i)
                return false
            i += 1

        # Check that cstr ends here
        if *(cstr + len) != 0
            return false

        return true

    # Clone a string (deep copy).
    pub fn clone(self: @String) -> String
        # One bulk copy; on a failed reserve the clone is empty.
        var clone: String = string_new()
        clone.push_span(Span<u8> { ptr: self.data.data, len: self.data.len })
        return clone

    # Check if string starts with a prefix String.
    pub fn starts_with_string(self: @String, prefix: @String) -> bool
        let len: i64 = self.data.len
        let prefix_len: i64 = prefix.data.len

        if prefix_len > len
            return false

        var i: i64 = 0
        while i < prefix_len
            if self.data.get(i) != prefix.data.get(i)
                return false
            i += 1

        return true

    # Check if string ends with a suffix String.
    pub fn ends_with_string(self: @String, suffix: @String) -> bool
        let len: i64 = self.data.len
        let suffix_len: i64 = suffix.data.len

        if suffix_len > len
            return false

        let start: i64 = len - suffix_len
        var i: i64 = 0
        while i < suffix_len
            if self.data.get(start + i) != suffix.data.get(i)
                return false
            i += 1

        return true

    # Check if string contains a substring String.
    pub fn contains_string(self: @String, needle: @String) -> bool
        let len: i64 = self.data.len
        let needle_len: i64 = needle.data.len

        if needle_len == 0
            return true  # Empty needle always matches

        if needle_len > len
            return false

        let search_end: i64 = len - needle_len + 1
        for i in 0..search_end
            var j: i64 = 0
            var found: i32 = 1
            while j < needle_len
                if self.data.get(i + j) != needle.data.get(j)
                    found = 0
                    j = needle_len  # Break
                j += 1
            if found == 1
                return true

        return false

    # Index of the first occurrence of needle in self, or self.data.len when there
    # is none (S-RESULT-1's sanctioned index-or-length form, not an error).
    # Compare `i < self.data.len`.
    pub fn find(self: @String, needle: @String) -> i64
        let len: i64 = self.data.len
        let needle_len: i64 = needle.data.len

        if needle_len == 0
            return 0  # Empty needle at start

        if needle_len > len
            return len

        let search_end: i64 = len - needle_len + 1
        for i in 0..search_end
            var j: i64 = 0
            var found: i32 = 1
            while j < needle_len
                if self.data.get(i + j) != needle.data.get(j)
                    found = 0
                    j = needle_len  # Break
                j += 1
            if found == 1
                return i

        return len

    # Extract a substring from start (inclusive) to end (exclusive).
    pub fn slice(self: @String, start: i64, end: i64) -> String
        let len: i64 = self.data.len
        var result: String = string_new()

        # Clamp bounds
        var st: i64 = start
        var en: i64 = end
        if st < 0
            st = 0
        if en > len
            en = len
        if st >= en
            return result

        # Copy bytes
        for i in st..en
            result.push(self.data.get(i))

        return result

    # Get character at index (returns 0 for out of bounds).
    pub fn char_at(self: @String, idx: i64) -> u8
        if idx < 0 or idx >= self.data.len
            return 0
        return self.data.get(idx)

    # Set character at index. true on success, false if out of bounds.
    pub fn set_char(self: @&String, idx: i64, c: u8) -> bool
        if idx < 0 or idx >= self.data.len
            return false
        self.data.set(idx, c)
        return true

    # Check if string starts with a prefix.
    pub fn starts_with(self: @String, prefix: StrView) -> bool
        if prefix.len > self.data.len
            return false
        var i: i64 = 0
        while i < prefix.len
            if self.data.get(i) != *(prefix.ptr + i)
                return false
            i += 1

        return true

    # Check if string ends with a suffix.
    pub fn ends_with(self: @String, suffix: StrView) -> bool
        let suffix_len: i64 = suffix.len
        let len: i64 = self.data.len
        if suffix_len > len
            return false

        let start: i64 = len - suffix_len
        var i: i64 = 0
        while i < suffix_len
            if self.data.get(start + i) != *(suffix.ptr + i)
                return false
            i += 1

        return true

    # Check if string contains a substring.
    pub fn contains(self: @String, needle: StrView) -> bool
        let needle_len: i64 = needle.len

        if needle_len == 0
            return true  # Empty needle always matches

        let len: i64 = self.data.len
        if needle_len > len
            return false

        let search_end: i64 = len - needle_len + 1
        for i in 0..search_end
            var j: i64 = 0
            var found: i32 = 1
            while j < needle_len
                if self.data.get(i + j) != *(needle.ptr + j)
                    found = 0
                    j = needle_len  # Break
                j += 1
            if found == 1
                return true

        return false

    # Push an i64 value onto the string in decimal: the String replacement for
    # str.itoa, with no caller-sized buffer. true on success.
    pub fn push_i64(self: @&String, n: i64) -> bool
        var buf: [20]u8
        let len: i64 = fmt_i64_into(@buf[0], n)
        return self.push_span(Span<u8> { ptr: @buf[0], len: len })

    # Return a new String with ASCII uppercase letters lowered.
    # Bytes outside 'A'..'Z' are copied unchanged (no Unicode awareness).
    pub fn to_lower(self: @String) -> String
        var out: String = string_with_cap(self.len())
        var i: i64 = 0
        while i < self.len()
            var b: u8 = self.get(i)
            if b >= 65 and b <= 90
                b = b + 32
            out.push(b)
            i += 1
        return out

    # Compare a String's bytes to a StrView's, without allocating.
    pub fn eq_strview(self: @String, sv: StrView) -> bool
        let mine: StrView = self.as_view()
        return mine.eq(sv)
