# ritzlib/json.ritz - JSON parser and writer: json_parse(StrView) -> Result<Json, JsonError>
#
# A JSON parser and writer for .ritz-meta files, LSP messages and configs.
# Supports: objects, arrays, strings, numbers, booleans, null.
#
# A document is a `Json`, an enum that owns its parts: a `Str` holds a String,
# an `Array` a Vec<Json>, an `Object` a Vec<JsonMember> (key String + value).
# It frees itself when its binding ends; there is nothing to free by hand.
#
# Usage (AGAST #4690):
#     match json_parse(input)                     # input: StrView
#         Ok(root) => use_root(root)
#         Err(err) => report(err)                 # {err} prints err.message()
#
# Lookups borrow from the document and return Option, so a missing field, an
# out-of-range index and a value of another kind are all None:
#     root.get_field("key") -> Option<@Json>      (key: StrView)
#     arr.get_index(i)      -> Option<@Json>
#     v.get_string()        -> Option<StrView>    (borrows from v)
#     v.get_number()        -> Option<i64>
#     v.get_bool()          -> Option<bool>
# or take the parts: `match *v` on Array(xs) / Object(ms), or v.items() and
# v.members().  The jp_* parser primitives are private.
#
# Numbers are i64: the integer part, truncated toward zero and saturated at
# the i64 bounds; fraction digits are consumed and dropped.  Object keys are
# Strings with a length, so a key may hold a decoded \u0000.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.result
import ritzlib.option
import ritzlib.strview
import ritzlib.string
import ritzlib.ptr
import ritzlib.fmt.digits  # Json.emit's numbers
import ritzlib.fmt.display  # impl Display for JsonError
import ritzlib.fmt.impls    # fmt_show_strview
import ritzlib.fmt.writer   # Writer

# =============================================================================
# Types
# =============================================================================

# One `"key": value` pair of an object, in document order.
pub struct JsonMember
    key: String
    value: Json

pub enum Json
    Null
    Bool(bool)
    Number(i64)
    Str(String)
    Array(Vec<Json>)
    Object(Vec<JsonMember>)

pub enum JsonErrorKind
    UnexpectedChar        # a value was expected here, or the input is empty
    UnterminatedString    # the input ended inside a string
    ExpectedColon         # an object key without its ':'
    ExpectedBracket       # an array without its closing ']'
    ExpectedBrace         # an object without its closing '}'
    OutOfMemory
    InvalidEscape         # an escape RFC 8259 lacks (\q), bad \uXXXX hex, an
                          # unpaired surrogate; pos = the backslash
    ControlChar           # raw U+0000-U+001F inside a string (RFC 8259 §7
                          # requires them escaped); pos = that byte

pub struct JsonError
    kind: JsonErrorKind
    pos: i64              # byte offset of the error in the input

impl JsonError
    pub fn message(self: @JsonError) -> StrView
        match self.kind
            UnexpectedChar => "unexpected character"
            UnterminatedString => "unterminated string"
            ExpectedColon => "expected ':'"
            ExpectedBracket => "expected ']'"
            ExpectedBrace => "expected '}'"
            OutOfMemory => "out of memory"
            InvalidEscape => "invalid escape"
            ControlChar => "control character in string"

impl Display for JsonError
    fn show(self: @JsonError, w: @&Writer) -> i64
        fmt_show_strview(self.message(), w)

# =============================================================================
# Ownership
# =============================================================================

# A Vec frees its buffer, not the elements it holds, so a Json frees its
# children itself: its drop moves each one out of its Vec, and the moved-out
# value drops where it is bound.  The parser calls the same drains on a
# half-built Vec when a parse fails.
fn json_drain_items(xs: @&Vec<Json>)
    let base: *Json = xs.as_ptr()
    let n: i64 = xs.len
    xs.len = 0
    var i: i64 = 0
    while i < n
        let child: Json = ptr_read<Json>(base + i)
        i += 1

fn json_drain_members(ms: @&Vec<JsonMember>)
    let base: *JsonMember = ms.as_ptr()
    let n: i64 = ms.len
    ms.len = 0
    var i: i64 = 0
    while i < n
        let member: JsonMember = ptr_read<JsonMember>(base + i)
        i += 1

impl Drop for Json
    fn drop(self: @&Json)
        match *self
            Array(xs) =>
                json_drain_items(@&xs)
            Object(ms) =>
                json_drain_members(@&ms)
            _ =>
                pass

# =============================================================================
# Parser
# =============================================================================

struct JsonParser
    src: StrView        # Input
    pos: i64            # Current position

# What `\uXXXX` (or a surrogate pair) decoded to.
struct JsonEscape
    cp: i32             # the code point
    used: i64           # bytes consumed from the 'u' on (5 or 11)

# Value of the four hex digits at src[pos..pos+4), or None if one is not a hex
# digit or `end` comes first.
fn jp_hex4(src: StrView, pos: i64, end: i64) -> Option<i32>
    if pos + 4 > end
        return None
    var val: i32 = 0
    var k: i64 = 0
    while k < 4
        let b: u8 = src.get(pos + k)
        let c: i32 = b as i32
        var d: i32 = 0 - 1
        if c >= 48 and c <= 57          # '0'-'9'
            d = c - 48
        else if c >= 97 and c <= 102    # 'a'-'f'
            d = c - 87
        else if c >= 65 and c <= 70     # 'A'-'F'
            d = c - 55
        if d < 0
            return None
        val = val * 16 + d
        k += 1
    Some(val)

# Append code point `cp` (U+0000..U+10FFFF, not a surrogate) to `out` as
# UTF-8; false if the String could not grow.
fn jp_put_utf8(out: @&String, cp: i32) -> bool
    if cp < 0x80
        return out.push(cp as u8)
    if cp < 0x800
        return out.push((0xC0 | (cp >> 6)) as u8) and out.push((0x80 | (cp & 0x3F)) as u8)
    if cp < 0x10000
        return out.push((0xE0 | (cp >> 12)) as u8) and out.push((0x80 | ((cp >> 6) & 0x3F)) as u8) and out.push((0x80 | (cp & 0x3F)) as u8)
    out.push((0xF0 | (cp >> 18)) as u8) and out.push((0x80 | ((cp >> 12) & 0x3F)) as u8) and out.push((0x80 | ((cp >> 6) & 0x3F)) as u8) and out.push((0x80 | (cp & 0x3F)) as u8)

# The \uXXXX escape whose 'u' is at src[pos], combining a surrogate pair
# \uD8xx\uDCxx into one code point; None if the hex is bad or a surrogate is
# unpaired.
fn jp_decode_u(src: StrView, pos: i64, end: i64) -> Option<JsonEscape>
    let hi: i32 = match jp_hex4(src, pos + 1, end)
        Some(h) => h
        None => return None
    if hi >= 0xDC00 and hi <= 0xDFFF
        return None                     # a low surrogate first
    if hi < 0xD800 or hi > 0xDBFF
        return Some(JsonEscape { cp: hi, used: 5 })
    # A high surrogate must be followed directly by \u and a low surrogate.
    let lo_at: i64 = pos + 5
    if lo_at + 1 >= end
        return None
    if src.get(lo_at) != 92 or src.get(lo_at + 1) != 117   # '\\' 'u'
        return None
    let lo: i32 = match jp_hex4(src, lo_at + 2, end)
        Some(l) => l
        None => return None
    if lo < 0xDC00 or lo > 0xDFFF
        return None
    Some(JsonEscape { cp: 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00), used: 11 })

impl JsonParser
    fn fail(self: @JsonParser, kind: JsonErrorKind) -> JsonError
        JsonError { kind: kind, pos: self.pos }

    # The byte at pos, or -1 at the end.
    fn peek(self: @JsonParser) -> i32
        if self.pos >= self.src.len
            return 0 - 1
        let b: u8 = self.src.get(self.pos)   # bound first: a method result `as i32` sign-extends
        b as i32

    fn skip_ws(self: @&JsonParser)
        while self.pos < self.src.len
            let ch: i32 = self.peek()
            if ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r'
                self.pos += 1
            else
                return

    # Consume `lit` if the input continues with it.
    fn match_lit(self: @&JsonParser, lit: StrView) -> bool
        if self.pos + lit.len > self.src.len
            return false
        for i in 0..lit.len
            if self.src.get(self.pos + i) != lit.get(i)
                return false
        self.pos += lit.len
        true

    fn parse_value(self: @&JsonParser) -> Result<Json, JsonError>
        self.skip_ws()
        let ch: i32 = self.peek()
        if ch == '"'
            return match self.parse_string()
                Ok(s) => Ok(Json.Str(s))
                Err(e) => Err(e)
        if ch == '-' or (ch >= '0' and ch <= '9')
            return Ok(self.parse_number())
        if ch == '['
            return self.parse_array()
        if ch == '{'
            return self.parse_object()
        if ch == 't' and self.match_lit("true")
            return Ok(Json.Bool(true))
        if ch == 'f' and self.match_lit("false")
            return Ok(Json.Bool(false))
        if ch == 'n' and self.match_lit("null")
            return Ok(Json.Null)
        Err(self.fail(JsonErrorKind.UnexpectedChar))

    # The string at pos, decoded.  The first pass finds the closing quote and
    # rejects raw control bytes; the second decodes the escapes, so a string
    # that never closes is UnterminatedString whatever escapes it holds.
    fn parse_string(self: @&JsonParser) -> Result<String, JsonError>
        if self.peek() != '"'
            return Err(self.fail(JsonErrorKind.UnexpectedChar))
        self.pos += 1  # Skip opening quote
        let start: i64 = self.pos

        while self.pos < self.src.len
            let ch: i32 = self.peek()
            if ch == '"'
                break
            if ch < 0x20
                # RFC 8259 §7: U+0000-U+001F must be escaped.  pos is at the
                # byte, which is where the error points.
                return Err(self.fail(JsonErrorKind.ControlChar))
            self.pos += 1
            if ch == '\\' and self.pos < self.src.len
                self.pos += 1  # the escaped byte, even a quote

        let end: i64 = self.pos
        if self.peek() != '"'
            return Err(self.fail(JsonErrorKind.UnterminatedString))
        self.pos += 1  # Skip closing quote

        # Decoded text is never longer than its escaped form.
        var out: String = string_with_cap(end - start)
        var i: i64 = start
        while i < end
            let ch: u8 = self.src.get(i)
            if ch != '\\'
                if not out.push(ch)
                    return Err(self.fail(JsonErrorKind.OutOfMemory))
                i += 1
                continue
            let at: i64 = i          # the backslash
            i += 1
            if i >= end
                break
            let esc: u8 = self.src.get(i)
            if esc == 'u'
                let dec: JsonEscape = match jp_decode_u(self.src, i, end)
                    Some(d) => d
                    None => return Err(JsonError { kind: JsonErrorKind.InvalidEscape, pos: at })
                if not jp_put_utf8(@&out, dec.cp)
                    return Err(self.fail(JsonErrorKind.OutOfMemory))
                i += dec.used
                continue
            var b: u8 = esc
            if esc == 'n'
                b = 10
            else if esc == 't'
                b = 9
            else if esc == 'r'
                b = 13
            else if esc == 'b'
                b = 8
            else if esc == 'f'
                b = 12
            else if esc != '/' and esc != '"' and esc != '\\'
                # RFC 8259 has no other escape: "\q" is an error, not "q".
                return Err(JsonError { kind: JsonErrorKind.InvalidEscape, pos: at })
            if not out.push(b)
                return Err(self.fail(JsonErrorKind.OutOfMemory))
            i += 1
        Ok(out)

    # The integer part, truncated toward zero, saturated at the i64 bounds.
    # Fraction digits are consumed but not accumulated (#4571): a valid
    # number of any length parses without overflowing.
    fn parse_number(self: @&JsonParser) -> Json
        var neg: bool = false
        if self.peek() == '-'
            neg = true
            self.pos += 1

        # Negative numbers accumulate below zero so that i64 MIN is reachable.
        let i64_max: i64 = 9223372036854775807
        let i64_min: i64 = 0 - i64_max - 1
        var val: i64 = 0
        var has_decimal: bool = false

        while self.pos < self.src.len
            let ch: i32 = self.peek()
            if ch >= 48 and ch <= 57  # '0'-'9'
                if not has_decimal
                    let d: i64 = (ch - 48) as i64
                    if neg
                        if val < (i64_min + d) / 10
                            val = i64_min
                        else
                            val = val * 10 - d
                    else
                        if val > (i64_max - d) / 10
                            val = i64_max
                        else
                            val = val * 10 + d
                self.pos += 1
            else if ch == '.' and not has_decimal
                has_decimal = true
                self.pos += 1
            else
                break
        Json.Number(val)

    fn parse_array(self: @&JsonParser) -> Result<Json, JsonError>
        self.pos += 1  # '['
        self.skip_ws()
        var items: Vec<Json> = vec_new<Json>()
        match self.fill_array(@&items)
            Some(err) =>
                json_drain_items(@&items)
                return Err(err)
            None =>
                pass
        Ok(Json.Array(items))

    # Parse the items and the closing ']' into `items`; the error, if any.
    fn fill_array(self: @&JsonParser, items: @&Vec<Json>) -> Option<JsonError>
        if self.peek() != ']'  # Not an empty array
            loop
                match self.parse_value()
                    Ok(item) =>
                        if not items.push(item)
                            return Some(self.fail(JsonErrorKind.OutOfMemory))
                    Err(e) =>
                        return Some(e)
                self.skip_ws()
                if self.peek() == ','
                    self.pos += 1
                    self.skip_ws()
                else
                    break
        if self.peek() != ']'
            return Some(self.fail(JsonErrorKind.ExpectedBracket))
        self.pos += 1
        None

    fn parse_object(self: @&JsonParser) -> Result<Json, JsonError>
        self.pos += 1  # '{'
        self.skip_ws()
        var members: Vec<JsonMember> = vec_new<JsonMember>()
        match self.fill_object(@&members)
            Some(err) =>
                json_drain_members(@&members)
                return Err(err)
            None =>
                pass
        Ok(Json.Object(members))

    # Parse the members and the closing '}' into `members`; the error, if any.
    fn fill_object(self: @&JsonParser, members: @&Vec<JsonMember>) -> Option<JsonError>
        if self.peek() != '}'  # Not an empty object
            loop
                self.skip_ws()
                let key: String = match self.parse_string()
                    Ok(k) => k
                    Err(e) => return Some(e)
                self.skip_ws()
                if self.peek() != ':'
                    return Some(self.fail(JsonErrorKind.ExpectedColon))
                self.pos += 1
                match self.parse_value()
                    Ok(value) =>
                        if not members.push(JsonMember { key: key, value: value })
                            return Some(self.fail(JsonErrorKind.OutOfMemory))
                    Err(e) =>
                        return Some(e)
                self.skip_ws()
                if self.peek() == ','
                    self.pos += 1
                else
                    break
        self.skip_ws()
        if self.peek() != '}'
            return Some(self.fail(JsonErrorKind.ExpectedBrace))
        self.pos += 1
        None

# =============================================================================
# Public API
# =============================================================================

# Parse the first JSON value in `input`; trailing input is ignored.
pub fn json_parse(input: StrView) -> Result<Json, JsonError>
    var p: JsonParser = JsonParser { src: input, pos: 0 }
    p.parse_value()

# =============================================================================
# Access and output
# =============================================================================

# Methods (S-IMPL-1): a Json is the subject of every operation on it.
impl Json
    # The value of `key` in object `self`; None if `self` is not an object or
    # has no such key.  Keys compare byte-for-byte, length included.
    pub fn get_field(self: @Json, key: StrView) -> Option<@Json>
        match *self
            Object(ms) =>
                let base: *JsonMember = ms.as_ptr()
                for i in 0..ms.len
                    let m: *JsonMember = base + i
                    if m.key.eq(key)
                        return Some(@m.value)
                None
            _ =>
                None

    # Element `idx` of array `self`; None if `self` is not an array or `idx`
    # is out of range.
    pub fn get_index(self: @Json, idx: i64) -> Option<@Json>
        match *self
            Array(xs) =>
                if idx < 0 or idx >= xs.len
                    return None
                let base: *Json = xs.as_ptr()
                Some(@*(base + idx))
            _ =>
                None

    # A view of a string value's bytes, borrowed from `self`.
    pub fn get_string(self: @Json) -> Option<StrView>
        match *self
            Str(s) => Some(s.as_view())
            _ => None

    pub fn get_number(self: @Json) -> Option<i64>
        match *self
            Number(n) => Some(n)
            _ => None

    pub fn get_bool(self: @Json) -> Option<bool>
        match *self
            Bool(b) => Some(b)
            _ => None

    pub fn is_null(self: @Json) -> bool
        match *self
            Null => true
            _ => false

    # The elements of an array; empty for any other value.
    pub fn items(self: @Json) -> Span<Json>
        match *self
            Array(xs) => Span<Json> { ptr: xs.as_ptr(), len: xs.len }
            _ => Span<Json> { ptr: null, len: 0 }

    # The members of an object, in document order; empty for any other value.
    pub fn members(self: @Json) -> Span<JsonMember>
        match *self
            Object(ms) => Span<JsonMember> { ptr: ms.as_ptr(), len: ms.len }
            _ => Span<JsonMember> { ptr: null, len: 0 }

    pub fn array_len(self: @Json) -> i64
        self.items().len

    pub fn object_len(self: @Json) -> i64
        self.members().len

    # Append the JSON text of `self` to buf.
    pub fn emit(self: @Json, buf: @&Vec<u8>)
        match *self
            Null =>
                json_emit_text("null", buf)
            Bool(b) =>
                if b
                    json_emit_text("true", buf)
                else
                    json_emit_text("false", buf)
            Number(n) =>
                var num_buf: [20]u8
                let digits: StrView = fmt_i64_into(@num_buf, n)
                json_emit_text(digits, buf)
            Str(s) =>
                json_emit_string(s.as_view(), buf)
            Array(xs) =>
                json_emit_byte(91, buf)  # '['
                let base: *Json = xs.as_ptr()
                for i in 0..xs.len
                    if i > 0
                        json_emit_text(", ", buf)
                    let child: @Json = @*(base + i)
                    child.emit(buf)
                json_emit_byte(93, buf)  # ']'
            Object(ms) =>
                json_emit_byte(123, buf)  # '{'
                let base: *JsonMember = ms.as_ptr()
                for i in 0..ms.len
                    if i > 0
                        json_emit_text(", ", buf)
                    let m: *JsonMember = base + i
                    json_emit_string(m.key.as_view(), buf)
                    json_emit_text(": ", buf)
                    m.value.emit(buf)
                json_emit_byte(125, buf)  # '}'

    # The JSON text of `self`; the caller owns the String.
    pub fn to_string(self: @Json) -> String
        var buf: Vec<u8> = vec_with_cap<u8>(256)
        self.emit(@&buf)
        string_from_bytes(Span<u8> { ptr: (buf.data), len: (buf.len) as i64 })

# Append one byte to buf.
fn json_emit_byte(b: u8, buf: @&Vec<u8>)
    buf.push(b)

# Append `s` to buf as it is.
fn json_emit_text(s: StrView, buf: @&Vec<u8>)
    buf.push_span(Span<u8> { ptr: s.ptr, len: s.len })

# Emit s[0..len) as a JSON string literal.  Length-driven, so an embedded NUL
# (a decoded \u0000) is written as \u0000 rather than ending the string.
# Control characters U+0000-U+001F, which RFC 8259 forbids raw inside a
# string, are written as \n \t \r \b \f or \u00XX.
pub fn json_emit_bytes(s_sv: Span<u8>, buf: @&Vec<u8>)
    let s: *u8 = s_sv.ptr
    let len: i64 = s_sv.len
    buf.push(34)  # '"'
    if s != null
        var i: i64 = 0
        while i < len
            let ch: u8 = *(s + i)
            if ch == '"'  # '"'
                buf.push(92)  # '\'
                buf.push(34)
            else if ch == '\\'  # '\'
                buf.push(92)
                buf.push(92)
            else if ch == '\n'  # '\n'
                buf.push(92)
                buf.push(110)
            else if ch == '\t'  # '\t'
                buf.push(92)
                buf.push(116)
            else if ch == '\r'  # '\r'
                buf.push(92)
                buf.push(114)
            else if ch == 8  # backspace
                buf.push(92)
                buf.push(98)   # 'b'
            else if ch == 12  # form feed
                buf.push(92)
                buf.push(102)  # 'f'
            else if ch < 32  # other control characters: \u00XX
                json_emit_text("\\u00", buf)
                buf.push(jp_hex_digit(ch >> 4))
                buf.push(jp_hex_digit(ch & 15))
            else
                buf.push(ch)
            i += 1
    buf.push(34)  # '"'

# Lowercase hex digit for 0..15.
fn jp_hex_digit(d: u8) -> u8
    if d < 10
        return d + 48   # '0'
    return d + 87       # 'a' - 10

# Emit `s` as a JSON string literal (see json_emit_bytes).
pub fn json_emit_string(s: StrView, buf: @&Vec<u8>)
    json_emit_bytes(Span<u8> { ptr: s.ptr, len: s.len }, buf)
