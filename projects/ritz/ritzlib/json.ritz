# ritzlib/json.ritz - JSON Parser
#
# A simple JSON parser for reading .ritz-meta files.
# Supports: objects, arrays, strings, numbers, booleans, null.
#
# Usage (AGAST #1482):
#   match json_parse(input)                     # input: StrView
#       Ok(root) => use_root(root)              # json_free(root) when done
#       Err(err) => report(err.code, err.pos)   # json_error_message(err.code)
#
# Lookups return Option rather than a null/0 sentinel:
#   json_get_field(obj, "key") -> Option<*JsonValue>   (key: StrView)
#   json_get_index(arr, i)     -> Option<*JsonValue>
#   json_get_string(v)         -> Option<StrView>      (borrows from v)
#   json_get_number(v)         -> Option<i64>
#   json_get_bool(v)           -> Option<bool>
# Each is None for a missing field, an out-of-range index, a null `v` or a
# value of another kind.  The jp_* parser primitives are private.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.result
import ritzlib.option
import ritzlib.strview
import ritzlib.string

# =============================================================================
# JSON Value Types
# =============================================================================

const JSON_NULL: i32 = 0
const JSON_BOOL: i32 = 1
const JSON_NUMBER: i32 = 2
const JSON_STRING: i32 = 3
const JSON_ARRAY: i32 = 4
const JSON_OBJECT: i32 = 5

struct JsonValue
    kind: i32           # JSON_* type constant
    # For primitives:
    bool_val: i32       # 0 or 1 for booleans
    num_val: i64        # Integer value for numbers
    float_val: i64      # Unused for now (would need float support)
    str_val: *u8        # Heap-allocated string (null-terminated)
    str_len: i64        # String length
    # For arrays/objects:
    items: **JsonValue  # Array of JsonValue pointers
    count: i64          # Number of items
    keys: **u8          # For objects: array of key strings

# Error codes for JSON parsing
const JSON_ERR_NONE: i32 = 0
const JSON_ERR_UNEXPECTED_CHAR: i32 = 1
const JSON_ERR_UNTERMINATED_STRING: i32 = 2
const JSON_ERR_EXPECTED_COLON: i32 = 3
const JSON_ERR_EXPECTED_BRACKET: i32 = 4
const JSON_ERR_EXPECTED_BRACE: i32 = 5
const JSON_ERR_OUT_OF_MEMORY: i32 = 6
const JSON_ERR_INVALID_ESCAPE: i32 = 7   # escape RFC 8259 lacks (\q), bad \uXXXX hex,
                                         # unpaired surrogate, or \u0000 in a key
const JSON_ERR_CONTROL_CHAR: i32 = 8     # raw U+0000-U+001F inside a string (RFC 8259
                                         # §7 requires them escaped); pos = that byte

# Error type for JSON parsing
struct JsonError
    code: i32           # JSON_ERR_* error code
    pos: i64            # Position of error in input

# =============================================================================
# JSON Parser State
# =============================================================================

struct JsonParser
    src: *u8            # Input buffer
    len: i64            # Input length
    pos: i64            # Current position
    err: i32            # JSON_ERR_* for a failure more specific than "unexpected
                        # character" (set where the parse returns null)

# =============================================================================
# Helper Functions
# =============================================================================

# Raw allocation of a zeroed JsonValue; null when malloc fails.  Private: the
# public constructor below turns that failure into None.
fn json_value_alloc_raw() -> *JsonValue
    let v: *JsonValue = malloc(sizeof(JsonValue)) as *JsonValue
    if v == null
        return null
    # Zero all fields
    v.kind = JSON_NULL
    v.bool_val = 0
    v.num_val = 0
    v.float_val = 0
    v.str_val = null
    v.str_len = 0
    v.items = null
    v.count = 0
    v.keys = null
    return v

# A zeroed JsonValue, or None when the allocation fails.
pub fn json_alloc_value() -> Option<*JsonValue>
    let v: *JsonValue = json_value_alloc_raw()
    if v == null
        return None
    return Some(v)

pub fn json_free(v: *JsonValue)
    if v == null
        return

    # Free string value
    if v.str_val != null
        free(v.str_val)

    # Free array/object items recursively
    if v.items != null
        for i in 0..v.count
            json_free(*(v.items + i))
        free(v.items as *u8)

    # Free object keys
    if v.keys != null
        for i in 0..v.count
            let key: *u8 = *(v.keys + i)
            if key != null
                free(key)
        free(v.keys as *u8)

    free(v as *u8)

# =============================================================================
# Parser Primitives
# =============================================================================

fn jp_at_end(p: *JsonParser) -> i32
    return (p.pos >= p.len) as i32

fn jp_peek(p: *JsonParser) -> i32
    if p.pos >= p.len
        return 0
    return *(p.src + p.pos) as i32

fn jp_advance(p: *JsonParser) -> i32
    if p.pos >= p.len
        return 0
    let ch: i32 = *(p.src + p.pos) as i32
    p.pos = p.pos + 1
    return ch

fn jp_skip_ws(p: *JsonParser)
    while p.pos < p.len
        let ch: i32 = jp_peek(p)
        if ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r'
            jp_advance(p)
        else
            return

fn jp_expect(p: *JsonParser, ch: i32) -> i32
    jp_skip_ws(p)
    if jp_peek(p) == ch
        jp_advance(p)
        return 1
    return 0

fn jp_match_str(p: *JsonParser, s: *u8) -> i32
    var len: i64 = strlen(s)
    if p.pos + len > p.len
        return 0
    for i in 0..len
        if *(p.src + p.pos + i) != *(s + i)
            return 0
    p.pos = p.pos + len
    return 1

# =============================================================================
# Parse Functions
# =============================================================================
# Note: ritz0 pre-registers all function signatures, so these can call each other.

fn jp_parse_value(p: *JsonParser) -> *JsonValue
    jp_skip_ws(p)
    let ch: i32 = jp_peek(p)

    # String
    if ch == '"'  # '"'
        return jp_parse_string(p, 0)

    # Number (including negative)
    if ch == '-' or (ch >= '0' and ch <= '9')  # '-' or digit
        return jp_parse_number(p)

    # Array
    if ch == '['  # '['
        return jp_parse_array(p)

    # Object
    if ch == '{'  # '{'
        return jp_parse_object(p)

    # true
    if ch == 't'  # 't'
        if jp_match_str(p, c"true") != 0
            let v: *JsonValue = match json_alloc_value()
                Some(x) => x
                None => return null
            v.kind = JSON_BOOL
            v.bool_val = 1
            return v
        return null

    # false
    if ch == 'f'  # 'f'
        if jp_match_str(p, c"false") != 0
            let v: *JsonValue = match json_alloc_value()
                Some(x) => x
                None => return null
            v.kind = JSON_BOOL
            v.bool_val = 0
            return v
        return null

    # null
    if ch == 'n'  # 'n'
        if jp_match_str(p, c"null") != 0
            let v: *JsonValue = match json_alloc_value()
                Some(x) => x
                None => return null
            # kind is already JSON_NULL
            return v
        return null

    return null

# Value of the four hex digits at src[pos..pos+4), or -1 if one is not a hex
# digit or `end` comes first.
fn jp_hex4(src: *u8, pos: i64, end: i64) -> i32
    if pos + 4 > end
        return 0 - 1
    var val: i32 = 0
    var k: i64 = 0
    while k < 4
        let c: i32 = *(src + pos + k) as i32
        var d: i32 = 0 - 1
        if c >= 48 and c <= 57          # '0'-'9'
            d = c - 48
        else if c >= 97 and c <= 102    # 'a'-'f'
            d = c - 87
        else if c >= 65 and c <= 70     # 'A'-'F'
            d = c - 55
        if d < 0
            return 0 - 1
        val = val * 16 + d
        k += 1
    return val

# Write code point `cp` (U+0000..U+10FFFF, not a surrogate) to `dst` as UTF-8;
# returns the byte count, 1-4.
fn jp_put_utf8(dst: *u8, cp: i32) -> i64
    if cp < 0x80
        *dst = cp as u8
        return 1
    if cp < 0x800
        *dst = (0xC0 | (cp >> 6)) as u8
        *(dst + 1) = (0x80 | (cp & 0x3F)) as u8
        return 2
    if cp < 0x10000
        *dst = (0xE0 | (cp >> 12)) as u8
        *(dst + 1) = (0x80 | ((cp >> 6) & 0x3F)) as u8
        *(dst + 2) = (0x80 | (cp & 0x3F)) as u8
        return 3
    *dst = (0xF0 | (cp >> 18)) as u8
    *(dst + 1) = (0x80 | ((cp >> 12) & 0x3F)) as u8
    *(dst + 2) = (0x80 | ((cp >> 6) & 0x3F)) as u8
    *(dst + 3) = (0x80 | (cp & 0x3F)) as u8
    return 4

# Fail a string parse on an invalid escape: report JSON_ERR_INVALID_ESCAPE at
# `at`, the offset of the escape's backslash.
fn jp_bad_escape(p: *JsonParser, str: *u8, at: i64) -> *JsonValue
    free(str)
    p.err = JSON_ERR_INVALID_ESCAPE
    p.pos = at
    return null

# Code point of the \uXXXX escape whose 'u' is at src[pos], combining a
# surrogate pair \uD8xx\uDCxx into one; -1 if the hex is bad or a surrogate
# is unpaired.  *used is set to the bytes consumed from the 'u' on (5 or 11).
fn jp_decode_u(src: *u8, pos: i64, end: i64, used: *i64) -> i32
    let hi: i32 = jp_hex4(src, pos + 1, end)
    if hi < 0 or (hi >= 0xDC00 and hi <= 0xDFFF)
        return 0 - 1                    # bad hex, or a low surrogate first
    *used = 5
    if hi < 0xD800 or hi > 0xDBFF
        return hi
    # A high surrogate must be followed directly by \u and a low surrogate.
    let lo_at: i64 = pos + 5
    if lo_at + 1 >= end
        return 0 - 1
    if *(src + lo_at) as i32 != 92 or *(src + lo_at + 1) as i32 != 117   # '\\' 'u'
        return 0 - 1
    let lo: i32 = jp_hex4(src, lo_at + 2, end)
    if lo < 0xDC00 or lo > 0xDFFF       # also catches lo == -1 (bad hex)
        return 0 - 1
    *used = 11
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)

# Parse the string at p.pos.  `is_key` != 0 for an object key, which is kept
# as a NUL-terminated *u8 with no length (JsonValue.keys), so \u0000 is rejected
# there: json_get_field would otherwise match {"a\u0000b": 1} on "a".  A string
# value keeps \u0000: str_len counts it and json_get_string returns all bytes.
# A raw U+0000-U+001F byte is JSON_ERR_CONTROL_CHAR in keys and values alike
# (AGAST #3941), so no raw NUL reaches a key either.
fn jp_parse_string(p: *JsonParser, is_key: i32) -> *JsonValue
    if jp_peek(p) != 34  # '"'
        return null
    jp_advance(p)  # Skip opening quote

    let start: i64 = p.pos

    # First pass: find the closing quote and bound the decoded length.  It
    # counts 1 per escape plus 1 per other byte, so \uXXXX counts 5 (decodes
    # to at most 3 bytes) and a surrogate pair counts 10 (decodes to 4): the
    # estimate never undercounts, because no escape decodes to more bytes
    # than it occupies in the input.
    var escaped_len: i64 = 0
    while p.pos < p.len
        let ch: i32 = jp_peek(p)
        if ch == '"'  # closing quote
            break
        if ch < 0x20
            # RFC 8259 §7: U+0000-U+001F must be escaped.  Copying one raw
            # would also let a raw NUL truncate a key, as \u0000 did (#3918).
            # p.pos is already at the byte, which is where the error points.
            p.err = JSON_ERR_CONTROL_CHAR
            return null
        if ch == '\\'  # backslash
            jp_advance(p)
            if p.pos < p.len
                jp_advance(p)
            escaped_len += 1
        else
            jp_advance(p)
            escaped_len += 1

    let raw_len: i64 = p.pos - start

    if jp_peek(p) != 34
        return null  # Unterminated string
    jp_advance(p)  # Skip closing quote

    # Allocate and copy string, handling escapes
    let str: *u8 = malloc(escaped_len + 1)
    if str == null
        return null

    let end: i64 = start + raw_len
    var src_pos: i64 = start
    var dst_pos: i64 = 0
    while src_pos < end
        let ch: i32 = *(p.src + src_pos) as i32
        if ch == '\\'  # backslash
            src_pos += 1
            if src_pos < end
                let esc: i32 = *(p.src + src_pos) as i32
                if esc == 'u'
                    var used: i64 = 0
                    let cp: i32 = jp_decode_u(p.src, src_pos, end, @used)
                    if cp < 0 or (cp == 0 and is_key != 0)
                        return jp_bad_escape(p, str, src_pos - 1)
                    dst_pos += jp_put_utf8(str + dst_pos, cp)
                    src_pos += used
                else
                    if esc == 'n'  # 'n'
                        *(str + dst_pos) = 10  # newline
                    else if esc == 't'  # 't'
                        *(str + dst_pos) = 9  # tab
                    else if esc == 'r'  # 'r'
                        *(str + dst_pos) = 13  # carriage return
                    else if esc == 'b'  # 'b'
                        *(str + dst_pos) = 8  # backspace
                    else if esc == 'f'  # 'f'
                        *(str + dst_pos) = 12  # form feed
                    else if esc == '/'  # '/'
                        *(str + dst_pos) = 47
                    else if esc == '"'  # '"'
                        *(str + dst_pos) = 34
                    else if esc == '\\'  # '\'
                        *(str + dst_pos) = 92
                    else
                        # RFC 8259 has no other escape: "\q" is an error, not "q".
                        return jp_bad_escape(p, str, src_pos - 1)
                    dst_pos += 1
                    src_pos += 1
        else
            *(str + dst_pos) = ch as u8
            dst_pos += 1
            src_pos += 1
    *(str + dst_pos) = 0

    var v: *JsonValue = null
    match json_alloc_value()
        Some(x) => v = x
        None =>
            free(str)
            return null
    v.kind = JSON_STRING
    v.str_val = str
    v.str_len = dst_pos
    return v

fn jp_parse_number(p: *JsonParser) -> *JsonValue
    var neg: i32 = 0
    if jp_peek(p) == '-'  # '-'
        neg = 1
        jp_advance(p)

    var val: i64 = 0
    var has_decimal: i32 = 0
    var decimal_places: i64 = 0

    while p.pos < p.len
        let ch: i32 = jp_peek(p)
        if ch >= 48 and ch <= 57  # '0'-'9'
            if has_decimal != 0
                decimal_places += 1
            val = val * 10 + (ch - 48) as i64
            jp_advance(p)
        else if ch == '.' and has_decimal == 0  # '.'
            has_decimal = 1
            jp_advance(p)
        else
            break

    if neg != 0
        val = 0 - val

    let v: *JsonValue = match json_alloc_value()
        Some(x) => x
        None => return null
    v.kind = JSON_NUMBER
    v.num_val = val
    # Note: For float support, we'd need to track decimal_places
    return v

fn jp_parse_array(p: *JsonParser) -> *JsonValue
    if jp_peek(p) != 91  # '['
        return null
    jp_advance(p)
    jp_skip_ws(p)

    # Collect items
    var items: Vec<u8> = vec_with_cap<u8>(64)  # Store pointers (8 bytes each)
    var count: i64 = 0

    if jp_peek(p) != 93  # Not empty array
        loop
            var item: *JsonValue = jp_parse_value(p)
            if item == null
                # Error - free what we have
                vec_drop<u8>(@&items)
                return null

            # Store pointer (8 bytes)
            vec_push_bytes<u8>(@&items, @item as *u8, 8)
            count += 1

            jp_skip_ws(p)
            if jp_peek(p) == ','  # ','
                jp_advance(p)
                jp_skip_ws(p)
            else
                break

    if jp_peek(p) != 93  # ']'
        # Free all parsed items
        for i in 0..count
            let ptr: *JsonValue = *((items.data + i * 8) as **JsonValue)
            json_free(ptr)
        vec_drop<u8>(@&items)
        return null
    jp_advance(p)

    # Create array value
    var v: *JsonValue = null
    match json_alloc_value()
        Some(x) => v = x
        None =>
            vec_drop<u8>(@&items)
            return null

    v.kind = JSON_ARRAY
    v.count = count

    if count > 0
        v.items = malloc(count * 8) as **JsonValue
        if v.items == null
            vec_drop<u8>(@&items)
            json_free(v)
            return null
        memcpy(v.items as *u8, items.data, count * 8)

    vec_drop<u8>(@&items)
    return v

fn jp_parse_object(p: *JsonParser) -> *JsonValue
    if jp_peek(p) != 123  # '{'
        return null
    jp_advance(p)
    jp_skip_ws(p)

    # Collect key-value pairs
    var keys_vec: Vec<u8> = vec_with_cap<u8>(64)
    var vals_vec: Vec<u8> = vec_with_cap<u8>(64)
    var count: i64 = 0

    if jp_peek(p) != 125  # Not empty object
        loop
            jp_skip_ws(p)

            # Parse key (must be string)
            let key_val: *JsonValue = jp_parse_string(p, 1)
            if key_val == null
                vec_drop<u8>(@&keys_vec)
                vec_drop<u8>(@&vals_vec)
                return null

            # Steal the string from key_val
            var key: *u8 = key_val.str_val
            key_val.str_val = null  # Prevent double-free
            json_free(key_val)

            jp_skip_ws(p)
            if jp_peek(p) != 58  # ':'
                free(key)
                vec_drop<u8>(@&keys_vec)
                vec_drop<u8>(@&vals_vec)
                return null
            jp_advance(p)

            # Parse value
            var val: *JsonValue = jp_parse_value(p)
            if val == null
                free(key)
                vec_drop<u8>(@&keys_vec)
                vec_drop<u8>(@&vals_vec)
                return null

            # Store pointers
            vec_push_bytes<u8>(@&keys_vec, @key as *u8, 8)
            vec_push_bytes<u8>(@&vals_vec, @val as *u8, 8)
            count += 1

            jp_skip_ws(p)
            if jp_peek(p) == ','  # ','
                jp_advance(p)
            else
                break

    jp_skip_ws(p)
    if jp_peek(p) != 125  # '}'
        # Free all
        for i in 0..count
            let k: *u8 = *((keys_vec.data + i * 8) as **u8)
            let v: *JsonValue = *((vals_vec.data + i * 8) as **JsonValue)
            free(k)
            json_free(v)
        vec_drop<u8>(@&keys_vec)
        vec_drop<u8>(@&vals_vec)
        return null
    jp_advance(p)

    # Create object value
    var obj: *JsonValue = null
    match json_alloc_value()
        Some(x) => obj = x
        None =>
            vec_drop<u8>(@&keys_vec)
            vec_drop<u8>(@&vals_vec)
            return null

    obj.kind = JSON_OBJECT
    obj.count = count

    if count > 0
        obj.keys = malloc(count * 8) as **u8
        obj.items = malloc(count * 8) as **JsonValue
        if obj.keys == null or obj.items == null
            vec_drop<u8>(@&keys_vec)
            vec_drop<u8>(@&vals_vec)
            json_free(obj)
            return null
        memcpy(obj.keys as *u8, keys_vec.data, count * 8)
        memcpy(obj.items as *u8, vals_vec.data, count * 8)

    vec_drop<u8>(@&keys_vec)
    vec_drop<u8>(@&vals_vec)
    return obj

# =============================================================================
# Public API
# =============================================================================

# Parse the first JSON value in `input`; trailing input is ignored.
pub fn json_parse(input: StrView) -> Result<*JsonValue, JsonError>
    var p: JsonParser
    p.src = input.ptr
    p.len = input.len
    p.pos = 0
    p.err = JSON_ERR_NONE

    let v: *JsonValue = jp_parse_value(@p)
    if v == null
        var err: JsonError
        err.code = JSON_ERR_UNEXPECTED_CHAR
        if p.err != JSON_ERR_NONE
            err.code = p.err
        err.pos = p.pos
        return Err(err)

    return Ok(v)

# Deprecated (AGAST #1482): the (ptr, len) form of json_parse.  Kept as a
# wrapper for one commit; use json_parse(strview_from_ptr(input, len)).
pub fn json_parse2(input: *u8, len: i64) -> Result<*JsonValue, JsonError>
    return json_parse(strview_from_ptr(input, len))

# =============================================================================
# Error Helpers
# =============================================================================

pub fn json_error_message(code: i32) -> StrView
    if code == JSON_ERR_UNEXPECTED_CHAR
        return "unexpected character"
    if code == JSON_ERR_UNTERMINATED_STRING
        return "unterminated string"
    if code == JSON_ERR_EXPECTED_COLON
        return "expected ':'"
    if code == JSON_ERR_EXPECTED_BRACKET
        return "expected ']'"
    if code == JSON_ERR_EXPECTED_BRACE
        return "expected '}'"
    if code == JSON_ERR_OUT_OF_MEMORY
        return "out of memory"
    if code == JSON_ERR_INVALID_ESCAPE
        return "invalid escape"
    if code == JSON_ERR_CONTROL_CHAR
        return "control character in string"
    return "unknown error"

# =============================================================================
# Object Access Helpers
# =============================================================================

# The value of `key` in object `obj`; None if `obj` is null, not an object,
# or has no such key.  Keys compare byte-for-byte.
pub fn json_get_field(obj: *JsonValue, key: StrView) -> Option<*JsonValue>
    if obj == null
        return None
    if obj.kind != JSON_OBJECT
        return None

    for i in 0..obj.count
        let k: *u8 = *(obj.keys + i)
        if strview_eq_cstr(key, k)
            return Some(*(obj.items + i))
    return None

# Element `idx` of array `arr`; None if `arr` is null, not an array, or
# `idx` is out of range.
pub fn json_get_index(arr: *JsonValue, idx: i64) -> Option<*JsonValue>
    if arr == null
        return None
    if arr.kind != JSON_ARRAY
        return None
    if idx < 0 or idx >= arr.count
        return None
    return Some(*(arr.items + idx))

# A view of a string value's bytes, borrowed from `v` (valid until json_free).
pub fn json_get_string(v: *JsonValue) -> Option<StrView>
    if v == null
        return None
    if v.kind != JSON_STRING
        return None
    return Some(strview_from_ptr(v.str_val, v.str_len))

pub fn json_get_number(v: *JsonValue) -> Option<i64>
    if v == null
        return None
    if v.kind != JSON_NUMBER
        return None
    return Some(v.num_val)

pub fn json_get_bool(v: *JsonValue) -> Option<bool>
    if v == null
        return None
    if v.kind != JSON_BOOL
        return None
    return Some(v.bool_val != 0)

pub fn json_is_null(v: *JsonValue) -> i32
    if v == null
        return 1
    return (v.kind == JSON_NULL) as i32

pub fn json_array_len(v: *JsonValue) -> i64
    if v == null
        return 0
    if v.kind != JSON_ARRAY
        return 0
    return v.count

pub fn json_object_len(v: *JsonValue) -> i64
    if v == null
        return 0
    if v.kind != JSON_OBJECT
        return 0
    return v.count

# =============================================================================
# JSON Emitter
# =============================================================================

pub fn json_emit_value(v: *JsonValue, buf: *Vec<u8>) -> i32
    if v == null
        vec_push_str(buf, c"null")
        return 0

    if v.kind == JSON_NULL
        vec_push_str(buf, c"null")
    else if v.kind == JSON_BOOL
        if v.bool_val != 0
            vec_push_str(buf, c"true")
        else
            vec_push_str(buf, c"false")
    else if v.kind == JSON_NUMBER
        var num_buf: [32]u8
        itoa(v.num_val, @num_buf[0])
        vec_push_str(buf, @num_buf[0])
    else if v.kind == JSON_STRING
        json_emit_bytes(v.str_val, v.str_len, buf)
    else if v.kind == JSON_ARRAY
        vec_push<u8>(buf, 91)  # '['
        for i in 0..v.count
            if i > 0
                vec_push_str(buf, c", ")
            json_emit_value(*(v.items + i), buf)
        vec_push<u8>(buf, 93)  # ']'
    else if v.kind == JSON_OBJECT
        vec_push<u8>(buf, 123)  # '{'
        for i in 0..v.count
            if i > 0
                vec_push_str(buf, c", ")
            json_emit_string(*(v.keys + i), buf)
            vec_push_str(buf, c": ")
            json_emit_value(*(v.items + i), buf)
        vec_push<u8>(buf, 125)  # '}'
    return 0

# Emit s[0..len) as a JSON string literal.  Length-driven, so an embedded NUL
# (a decoded \u0000) is written as \u0000 rather than ending the string.
# Control characters U+0000-U+001F, which RFC 8259 forbids raw inside a
# string, are written as \n \t \r \b \f or \u00XX.
pub fn json_emit_bytes(s: *u8, len: i64, buf: *Vec<u8>) -> i32
    vec_push<u8>(buf, 34)  # '"'
    if s != null
        var i: i64 = 0
        while i < len
            let ch: u8 = *(s + i)
            if ch == '"'  # '"'
                vec_push<u8>(buf, 92)  # '\'
                vec_push<u8>(buf, 34)
            else if ch == '\\'  # '\'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 92)
            else if ch == '\n'  # '\n'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 110)
            else if ch == '\t'  # '\t'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 116)
            else if ch == '\r'  # '\r'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 114)
            else if ch == 8  # backspace
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 98)   # 'b'
            else if ch == 12  # form feed
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 102)  # 'f'
            else if ch < 32  # other control characters: \u00XX
                vec_push_str(buf, c"\\u00")
                vec_push<u8>(buf, jp_hex_digit(ch >> 4))
                vec_push<u8>(buf, jp_hex_digit(ch & 15))
            else
                vec_push<u8>(buf, ch)
            i += 1
    vec_push<u8>(buf, 34)  # '"'
    return 0

# Lowercase hex digit for 0..15.
fn jp_hex_digit(d: u8) -> u8
    if d < 10
        return d + 48   # '0'
    return d + 87       # 'a' - 10

# Emit NUL-terminated `s` as a JSON string literal (see json_emit_bytes).
pub fn json_emit_string(s: *u8, buf: *Vec<u8>) -> i32
    if s == null
        return json_emit_bytes(s, 0, buf)
    return json_emit_bytes(s, strlen(s), buf)

# The JSON text of `v`; the caller owns the String (string_drop).
pub fn json_to_string(v: *JsonValue) -> String
    var buf: Vec<u8> = vec_with_cap<u8>(256)
    json_emit_value(v, @buf)
    let out: String = string_from_bytes(buf.data, buf.len)
    vec_drop<u8>(@&buf)
    return out
