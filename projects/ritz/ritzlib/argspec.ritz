# ritzlib/argspec.ritz - Command-line parsing, the idiomatic way (AGAST #1448)
#
# Arguments are `StrView`s, the spec is a struct holding a `Vec<ArgFlag>`,
# lookups return `Option`, and failures come back as `Result<_, ArgError>`
# instead of being printed from inside the parser:
#
#     var all = args_from_argv(argc, argv)
#     var spec = argspec_new("demo", "Does a demo")
#     spec.switch('v', "verbose", "Say more")
#     spec.option('n', "count", "NUM", "How many", Some("10"))
#     spec.positionals("FILE", "Input files", 0, ARGS_UNLIMITED)
#     match spec.parse(args_tail(@all))   # Span<StrView>
#         Ok(p) => run(p)
#         Err(e) => spec.error_print(@e)
#
# and inside `run`: p.switch("verbose") -> bool,
# p.value("n") -> Option<StrView>, p.int("count") ->
# Result<i64, ArgError>, p.positional(0) -> Option<StrView>.
# A name matches an option's long name, or its short name if it is one byte.
#
# Nothing is copied: every StrView handed back points into argv (or into the
# literals the spec was built from), so it lives as long as they do.  Release
# storage with ParsedArgs.deinit / ArgSpec.deinit.  examples/tier2_stdlib/77_args
# calls every public function here.
#
# ritz1 compiles this module: 77_args and the tier2 examples ported to it in
# #1490 build and pass under ritz1 and ritz1_selfhosted.  Keep it that way.
# The code avoids constructs ritz1 has not always lowered: string literals in
# struct-literal fields (#1467), block or nested match arms (#1454, #1479),
# `f().field` (#1470), multi-type-argument calls (#1471) and payload-carrying
# user enums (#1295).  That last one is why ArgError is a struct with a
# payload-free kind enum rather than an enum with payloads.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec

# Pass as `max` to ArgSpec.positionals for "no upper bound".
pub const ARGS_UNLIMITED: i64 = -1

# ============================================================================
# argv as views
# ============================================================================

# Every argv entry, argv[0] included, as a StrView over argv's own bytes.
# Nothing is copied; Vec<StrView>.deinit releases the vector only.
pub fn args_from_argv(argc: i32, argv: **u8) -> Vec<StrView>
    var all = vec_new<StrView>()
    var i: i32 = 0
    while i < argc
        all.push(strview_from_cstr(*(argv + i)))
        i += 1
    all

# The arguments after the program name, as a slice borrowed from `all`.
pub fn args_tail(all: @Vec<StrView>) -> Span<StrView>
    if all.len <= 1
        return span_empty<StrView>()
    span_from_ptr<StrView>(all.data + 1, all.len - 1)

# The i-th argument of a slice, or None when i is out of range.
pub fn args_get(args: @Span<StrView>, i: i64) -> Option<StrView>
    if i < 0 or i >= args.len
        return None
    Some(args.get(i))

# ============================================================================
# The spec
# ============================================================================

# One option.  Build these with ArgSpec.switch / ArgSpec.option.
pub struct ArgFlag
    short: u8               # 0 when the option has no short form
    long: StrView           # empty when the option has no long form
    value_name: StrView     # placeholder shown in help (NUM); empty for switches
    help: StrView
    takes_value: bool       # false: a switch (-v); true: takes a value (-n NUM)
    has_default: bool
    default: StrView        # meaningful only when has_default

# A whole command line: options, then one run of positional arguments.
pub struct ArgSpec
    program: StrView
    about: StrView
    flags: Vec<ArgFlag>
    pos_name: StrView       # empty: the program takes no positionals
    pos_help: StrView
    pos_min: i64
    pos_max: i64            # ARGS_UNLIMITED: no upper bound

pub fn argspec_new(program: StrView, about: StrView) -> ArgSpec
    let flags = vec_new<ArgFlag>()
    let no_name = strview_empty()
    let no_help = strview_empty()
    let spec = ArgSpec { program: program, about: about, flags: flags, pos_name: no_name, pos_help: no_help, pos_min: 0, pos_max: 0 }
    spec

fn argflag_new(short: u8, long: StrView, value_name: StrView, help: StrView, takes_value: bool, has_default: bool, default: StrView) -> ArgFlag
    let f = ArgFlag { short: short, long: long, value_name: value_name, help: help, takes_value: takes_value, has_default: has_default, default: default }
    f

impl ArgSpec
    # A boolean option.  Pass short = 0 or long = "" to omit that form.
    pub fn switch(self: @&ArgSpec, short: u8, long: StrView, help: StrView)
        let f = argflag_new(short, long, strview_empty(), help, false, false, strview_empty())
        self.flags.push(f)

    # An option that takes a value, with an optional default.
    pub fn option(self: @&ArgSpec, short: u8, long: StrView, value_name: StrView, help: StrView, default: Option<StrView>)
        let has_default: bool = option_is_some<StrView>(@default)
        let value: StrView = option_unwrap_or<StrView>(@default, strview_empty())
        let f = argflag_new(short, long, value_name, help, true, has_default, value)
        self.flags.push(f)

    # Accept between min and max positional arguments (max = ARGS_UNLIMITED
    # for no bound).  Without this call the program accepts none.
    pub fn positionals(self: @&ArgSpec, name: StrView, help: StrView, min: i64, max: i64)
        self.pos_name = name
        self.pos_help = help
        self.pos_min = min
        self.pos_max = max

    # The compiler frees the Vec fields at scope end (AGAST #2159); this leaves
    # the spec empty, and is safe to call on any spec.  Not named `drop`:
    # ritz0 treats `drop` as the RAII hook (#4445).
    pub fn deinit(self: @&ArgSpec)
        self.flags.len = 0

    # Index of the option called `name` (see find_index), or None.
    pub fn find(self: @ArgSpec, name: StrView) -> Option<i64>
        let idx = find_index(self, name)
        if idx < 0
            return None
        Some(idx)

# Internal helpers take a StrView by value: it's Copy, so a name that is
# looked up and then reported is still usable (#2414; #1489 once made it
# a move).
fn find_long(spec: @ArgSpec, name: StrView) -> i64
    if name.len == 0
        return -1
    var i: i64 = 0
    while i < spec.flags.len
        let f = spec.flags.get(i)
        if (f.long).eq(name)
            return i
        i += 1
    -1

fn find_short(spec: @ArgSpec, c: u8) -> i64
    if c == 0
        return -1
    var i: i64 = 0
    while i < spec.flags.len
        let f = spec.flags.get(i)
        if f.short == c
            return i
        i += 1
    -1

# Long-name match first, then a one-byte name against the short forms.
fn find_index(spec: @ArgSpec, name: StrView) -> i64
    let by_long = find_long(spec, name)
    if by_long >= 0
        return by_long
    if name.len == 1
        return find_short(spec, name.get(0))
    -1

fn flag_takes_value(spec: @ArgSpec, idx: i64) -> bool
    let f = spec.flags.get(idx)
    f.takes_value

# ============================================================================
# Errors
# ============================================================================

pub enum ArgErrorKind
    UnknownOption           # text: the option name as written, without dashes
    MissingValue            # text: the option that needed a value
    UnexpectedValue         # text: a switch given `--switch=value`
    MissingPositional       # text: the spec's positional name; limit: the min
    TooManyPositionals      # text: the first surplus argument; limit: the max
    NotANumber              # text: the offending value
    NotSet                  # text: the name looked up

# `dashes` is what goes in front of `text` when it names an option: what the
# user typed ("--" from parse_long, "-" from parse_short), so `--f` is
# reported as '--f' even when `-f` is a valid short option (#3991).  For
# NotSet it is the dashes of the spec option the name resolved to; it is
# empty for the kinds whose text is not an option.
pub struct ArgError
    kind: ArgErrorKind
    text: StrView
    limit: i64
    dashes: StrView

# An error whose text is not an option name (dashes empty).
fn arg_error(kind: ArgErrorKind, text: StrView, limit: i64) -> ArgError
    let e = ArgError { kind: kind, text: text, limit: limit, dashes: strview_empty() }
    e

# An error about the option `text`, written with `dashes` in front.
fn arg_error_opt(kind: ArgErrorKind, text: StrView, dashes: StrView) -> ArgError
    let e = ArgError { kind: kind, text: text, limit: 0, dashes: dashes }
    e

# ============================================================================
# Parsing
# ============================================================================

# What was given for one option.  Parallel to ArgSpec.flags, by index.
pub struct ArgSlot
    present: bool
    value: StrView          # empty for a switch

# The outcome of a successful ArgSpec.parse.  Borrows the spec (a raw
# pointer, so the compiler doesn't drop the caller's flags), so the spec must
# outlive it; its own Vecs are freed at scope end.
pub struct ParsedArgs
    spec: *ArgSpec        # borrowed: the result shares the spec (no copy)
    slots: Vec<ArgSlot>
    positionals: Vec<StrView>

fn argslot_new(present: bool, value: StrView) -> ArgSlot
    let s = ArgSlot { present: present, value: value }
    s

fn parsed_new(spec: @ArgSpec) -> ParsedArgs
    var slots = vec_new<ArgSlot>()
    var i: i64 = 0
    while i < spec.flags.len
        slots.push(argslot_new(false, strview_empty()))
        i += 1
    let positionals = vec_new<StrView>()
    let p = ParsedArgs { spec: spec, slots: slots, positionals: positionals }
    p

fn record(p: @&ParsedArgs, idx: i64, value: StrView)
    p.slots.set(idx, argslot_new(true, value))

# `--name` or `--name=value` at args[i]; `--name VALUE` also reads args[i+1]
# (the caller skips it — see long_takes_next).  Some(error) on failure.
fn parse_long(spec: @ArgSpec, args: Span<StrView>, i: i64, p: @&ParsedArgs) -> Option<ArgError>
    let arg = args.get(i)
    let body = arg.skip(2)
    let eq = body.find_byte('=')
    if eq < body.len
        let name = body.take(eq)
        let idx = find_long(spec, name)
        if idx < 0
            return Some(arg_error_opt(ArgErrorKind.UnknownOption, name, "--"))
        if flag_takes_value(spec, idx) == false
            return Some(arg_error_opt(ArgErrorKind.UnexpectedValue, name, "--"))
        record(p, idx, body.skip(eq + 1))
        return None
    let idx2 = find_long(spec, body)
    if idx2 < 0
        return Some(arg_error_opt(ArgErrorKind.UnknownOption, body, "--"))
    if flag_takes_value(spec, idx2) == false
        record(p, idx2, strview_empty())
        return None
    if i + 1 >= args.len
        return Some(arg_error_opt(ArgErrorKind.MissingValue, body, "--"))
    record(p, idx2, args.get(i + 1))
    None

# True when the option at args[i] consumes args[i + 1] as its value.
fn long_takes_next(spec: @ArgSpec, arg: StrView) -> bool
    let body = arg.skip(2)
    if body.find_byte('=') < body.len
        return false
    let idx = find_long(spec, body)
    if idx < 0
        return false
    flag_takes_value(spec, idx)

# A short cluster at args[i]: -v, -vq, -n7, -vn 7.
fn parse_short(spec: @ArgSpec, args: Span<StrView>, i: i64, p: @&ParsedArgs) -> Option<ArgError>
    let arg = args.get(i)
    var j: i64 = 1
    while j < arg.len
        let idx = find_short(spec, arg.get(j))
        if idx < 0
            return Some(arg_error_opt(ArgErrorKind.UnknownOption, arg.slice(j, j + 1), "-"))
        if flag_takes_value(spec, idx)
            if j + 1 < arg.len
                record(p, idx, arg.skip(j + 1))
                return None
            if i + 1 >= args.len
                return Some(arg_error_opt(ArgErrorKind.MissingValue, arg.slice(j, j + 1), "-"))
            record(p, idx, args.get(i + 1))
            return None
        record(p, idx, strview_empty())
        j += 1
    None

# True when the short cluster at args[i] ends in a value option with no
# attached value, i.e. it consumes args[i + 1].
fn short_takes_next(spec: @ArgSpec, arg: StrView) -> bool
    var j: i64 = 1
    while j < arg.len
        let idx = find_short(spec, arg.get(j))
        if idx < 0
            return false
        if flag_takes_value(spec, idx)
            return j + 1 >= arg.len
        j += 1
    false

fn is_option(arg: StrView) -> bool
    arg.len >= 2 and arg.get(0) == '-'

fn is_long(arg: StrView) -> bool
    arg.get(1) == '-'

fn is_double_dash(arg: StrView) -> bool
    arg.len == 2 and arg.get(0) == '-' and arg.get(1) == '-'

fn parse_into(spec: @ArgSpec, args: Span<StrView>, p: @&ParsedArgs) -> Option<ArgError>
    var only_positionals: bool = false
    var i: i64 = 0
    while i < args.len
        let arg = args.get(i)
        if only_positionals or is_option(arg) == false
            p.positionals.push(arg)
            i += 1
        else if is_double_dash(arg)
            only_positionals = true
            i += 1
        else if is_long(arg)
            let failed = parse_long(spec, args, i, p)
            if option_is_some<ArgError>(@failed)
                return failed
            if long_takes_next(spec, arg)
                i += 1
            i += 1
        else
            let failed2 = parse_short(spec, args, i, p)
            if option_is_some<ArgError>(@failed2)
                return failed2
            if short_takes_next(spec, arg)
                i += 1
            i += 1

    let n = p.positionals.len
    if n < spec.pos_min
        return Some(arg_error(ArgErrorKind.MissingPositional, spec.pos_name, spec.pos_min))
    if spec.pos_max >= 0 and n > spec.pos_max
        let extra = p.positionals.get(spec.pos_max)
        return Some(arg_error(ArgErrorKind.TooManyPositionals, extra, spec.pos_max))
    None

fn parse_failed(p: @&ParsedArgs, e: ArgError) -> Result<ParsedArgs, ArgError>
    p.deinit()
    Err(e)

impl ArgSpec
    # Report an error the conventional way: "<program>: <message>" on stderr.
    pub fn error_print(self: @ArgSpec, e: @ArgError)
        # Annotated: ritz1 gives an un-annotated `let` of a StrView field read
        # through a reference an i64 slot.
        let prog: StrView = self.program
        let text: StrView = e.text
        let dashes: StrView = e.dashes
        let k = e.kind
        if k == ArgErrorKind.UnknownOption
            eprint("{prog}: unknown option '{dashes}{text}'\n")
        else if k == ArgErrorKind.MissingValue
            eprint("{prog}: option '{dashes}{text}' requires a value\n")
        else if k == ArgErrorKind.UnexpectedValue
            eprint("{prog}: option '{dashes}{text}' doesn't accept a value\n")
        else if k == ArgErrorKind.MissingPositional
            eprint("{prog}: missing required argument '{text}'\n")
        else if k == ArgErrorKind.TooManyPositionals
            eprint("{prog}: too many arguments (at most {e.limit}): unexpected '{text}'\n")
        else if k == ArgErrorKind.NotANumber
            eprint("{prog}: invalid number '{text}'\n")
        else
            eprint("{prog}: option '{dashes}{text}' has no value\n")

    # Parse `args` (the arguments only — see args_tail) against this spec.
    pub fn parse(self: @ArgSpec, args: Span<StrView>) -> Result<ParsedArgs, ArgError>
        var p = parsed_new(self)
        let failed = parse_into(self, args, @&p)
        if option_is_some<ArgError>(@failed)
            return parse_failed(@&p, option_unwrap_or<ArgError>(@failed, arg_error(ArgErrorKind.NotSet, strview_empty(), 0)))
        Ok(p)

    # Usage line, description, options and arguments, on stdout.
    pub fn print_help(self: @ArgSpec)
        print("Usage: {self.program}")
        if self.flags.len > 0
            print(" [OPTIONS]")
        if self.pos_name.len > 0 and self.pos_min == 0
            print(" [{self.pos_name}]")
        else if self.pos_name.len > 0
            print(" {self.pos_name}")
        if self.pos_name.len > 0 and (self.pos_max < 0 or self.pos_max > 1)
            print("...")
        print("\n")
        if self.about.len > 0
            print("\n{self.about}\n")
        if self.flags.len > 0
            print("\nOptions:\n")
            var i: i64 = 0
            while i < self.flags.len
                let f = self.flags.get(i)
                print_flag_help(@f)
                i += 1
        if self.pos_name.len > 0
            print("\nArguments:\n  {self.pos_name}\n        {self.pos_help}\n")

# ============================================================================
# Reading the result
# ============================================================================

fn slot_at(p: @ParsedArgs, idx: i64) -> ArgSlot
    p.slots.get(idx)

# The value for option `idx` (-1 = unknown): given, else default, else None.
fn value_at(p: @ParsedArgs, idx: i64) -> Option<StrView>
    if idx < 0
        return None
    let f = p.spec.flags.get(idx)
    if f.takes_value == false
        return None
    let s = slot_at(p, idx)
    if s.present
        return Some(s.value)
    if f.has_default
        return Some(f.default)
    None

impl ParsedArgs
    # Was the option given at all (switch or value)?
    pub fn is_set(self: @ParsedArgs, name: StrView) -> bool
        let idx = find_index(@*self.spec, name)
        if idx < 0
            return false
        let s = slot_at(self, idx)
        s.present

    # Was the switch given?  False for unknown names and for value options.
    pub fn switch(self: @ParsedArgs, name: StrView) -> bool
        let idx = find_index(@*self.spec, name)
        if idx < 0
            return false
        if flag_takes_value(@*self.spec, idx)
            return false
        let s = slot_at(self, idx)
        s.present

    # The option's value: what was given, else its default, else None.
    # None for unknown names and for switches.
    pub fn value(self: @ParsedArgs, name: StrView) -> Option<StrView>
        value_at(self, find_index(@*self.spec, name))

    # The option's value (see ParsedArgs.value) as a decimal i64.
    # Err(NotSet) when there is no value, Err(NotANumber) when it isn't one.
    pub fn int(self: @ParsedArgs, name: StrView) -> Result<i64, ArgError>
        let v = value_at(self, find_index(@*self.spec, name))
        if not option_is_some<StrView>(@v)
            return Err(arg_error_opt(ArgErrorKind.NotSet, name, lookup_dashes(@*self.spec, name)))
        arg_parse_i64(option_unwrap_or<StrView>(@v, strview_empty()))

    # All positional arguments, in order, as a slice borrowed from `p`.
    pub fn positionals(self: @ParsedArgs) -> Span<StrView>
        span_from_vec<StrView>(@self.positionals)

    # The i-th positional argument, or None.
    pub fn positional(self: @ParsedArgs, i: i64) -> Option<StrView>
        let all = self.positionals()
        args_get(@all, i)

    # As ArgSpec.deinit: the compiler frees slots and positionals at scope
    # end; this leaves the result empty.  Not named `drop` (#4445).
    pub fn deinit(self: @&ParsedArgs)
        self.slots.len = 0
        self.positionals.len = 0

# The dashes of the spec option `name` resolves to (see find_index): "-"
# for a one-byte name that is not a long name (a short option), else "--".
fn lookup_dashes(spec: @ArgSpec, name: StrView) -> StrView
    if name.len == 1
        if find_long(spec, name) < 0
            return "-"
    "--"

# ============================================================================
# Numbers
# ============================================================================

# A whole decimal i64: optional sign, then digits only, range-checked
# (strview_parse_i64), with the failure reported as NotANumber.
pub fn arg_parse_i64(s: StrView) -> Result<i64, ArgError>
    match s.parse_i64()
        Some(n) => Ok(n)
        None => Err(arg_error(ArgErrorKind.NotANumber, s, 0))

# ============================================================================
# Help
# ============================================================================

# One option's two help lines: "  -n, --count=NUM" then its indented help.
# The short form is a u8, which `{}` would print as a number, so it goes
# through print_char.
fn print_flag_help(f: @ArgFlag)
    if f.short != 0
        print("  -")
        print_char(f.short)
        if f.long.len > 0
            print(", ")
    else
        print("      ")
    if f.long.len > 0 and f.takes_value
        print("--{f.long}={f.value_name}")
    else if f.long.len > 0
        print("--{f.long}")
    else if f.takes_value
        print(" {f.value_name}")
    if f.takes_value and f.has_default
        print("\n        {f.help} (default: {f.default})\n")
    else
        print("\n        {f.help}\n")
