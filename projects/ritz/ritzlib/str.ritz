# ritzlib/str.ritz - C-string interop only; new code uses StrView/String
#
# Every string here is a NUL-terminated *u8: use these at the C boundary
# (argv, syscalls, C APIs). Elsewhere use StrView (ritzlib.strview, borrowed)
# or String (ritzlib.string, owned); strview_from_cstr views a C string.
#
#   strlen            -> strview_len / string_len
#   streq, strneq     -> strview_eq, strview_eq_cstr (strview_take to bound)
#   strcmp            -> strview_cmp
#   strchr            -> strview_find_byte
#   strstr            -> strview_find, strview_contains
#   strcpy            -> string_from (the String owns its copy)
#   strcat            -> string_push_str, string_push_string
#   atoi              -> strview_parse_i64 (None for "", "abc", "12x", overflow)
#   itoa              -> string_push_i64 / string_from_i64 / `{n}`; it is gone
#                        (AGAST #4685), and fmt_i64_into(@buf20, n) is the
#                        no-allocation form
#
# The byte predicates (isdigit .. tolower) take a u8, not a C string, and are
# fine to use. memset/memcpy/memcmp/bcmp/memmove live here because the
# compiler emits calls to those symbols.


# ============================================================================
# Length and comparison
# ============================================================================

# standard-exempt: raw-ptr-param: C string ABI: strlen(3)
pub fn strlen(s: *u8) -> i64
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    return len

# standard-exempt: raw-ptr-param: C string ABI: strcmp(3) equality, no ordering
pub fn streq(a: *u8, b: *u8) -> bool
    var i: i64 = 0
    while *(a + i) != 0 and *(b + i) != 0
        if *(a + i) != *(b + i)
            return false
        i += 1
    return *(a + i) == *(b + i)

# standard-exempt: ptr-len-param, raw-ptr-param: C string ABI: strncmp(3) bound, NUL-terminated *u8
pub fn strneq(a: *u8, b: *u8, n: i64) -> bool
    var i: i64 = 0
    while i < n and *(a + i) != 0 and *(b + i) != 0
        if *(a + i) != *(b + i)
            return false
        i += 1
    if i == n
        return true
    return *(a + i) == *(b + i)

# C strcmp: three-way ordering (-1/0/1), not an error (S-RESULT-1).
# standard-exempt: sentinel-return, raw-ptr-param: C string ABI: strcmp(3) three-way ordering, not an error
pub fn strcmp(a: *u8, b: *u8) -> i32
    var i: i64 = 0
    while *(a + i) != 0 and *(b + i) != 0
        if *(a + i) < *(b + i)
            return -1
        if *(a + i) > *(b + i)
            return 1
        i += 1
    if *(a + i) == 0 and *(b + i) == 0
        return 0
    if *(a + i) == 0
        return -1
    return 1

# ============================================================================
# Search
# ============================================================================

# C strchr: a pointer into `s`, or null when `c` is absent (C string ABI,
# S-OPTION-1's foreign-ABI null case). New code uses strview_find_byte.
# standard-exempt: null-return, raw-ptr-param: C string ABI: strchr(3), null is "not found"
pub fn strchr(s: *u8, c: u8) -> *u8
    var i: i64 = 0
    while *(s + i) != 0
        if *(s + i) == c
            return s + i
        i += 1
    if c == 0
        return s + i
    return null

# C strstr: a pointer into `haystack`, or null when `needle` is absent (C
# string ABI, S-OPTION-1's foreign-ABI null case). New code uses strview_find.
# standard-exempt: null-return, raw-ptr-param: C string ABI: strstr(3), null is "not found"
pub fn strstr(haystack: *u8, needle: *u8) -> *u8
    if *needle == 0
        return haystack
    var i: i64 = 0
    while *(haystack + i) != 0
        var j: i64 = 0
        while *(needle + j) != 0 and *(haystack + i + j) == *(needle + j)
            j += 1
        if *(needle + j) == 0
            return haystack + i
        i += 1
    return null

# ============================================================================
# Copy and concatenate
# ============================================================================

# standard-exempt: raw-ptr-param: C string ABI: strcpy(3)
pub fn strcpy(dest: *u8, src: *u8) -> *u8
    var i: i64 = 0
    while *(src + i) != 0
        *(dest + i) = *(src + i)
        i += 1
    *(dest + i) = 0
    return dest

# standard-exempt: raw-ptr-param: C string ABI: strcat(3)
pub fn strcat(dest: *u8, src: *u8) -> *u8
    var len: i64 = strlen(dest)
    strcpy(dest + len, src)
    return dest

# ============================================================================
# Conversion
# ============================================================================

# C interop. Reads "abc" as 0 and "12x" as 12, and wraps on overflow; new code
# uses strview_parse_i64, which returns None for all three.
# standard-exempt: raw-ptr-param: C string ABI: atoi(3)
pub fn atoi(s: *u8) -> i64
    var result: i64 = 0
    var neg: i32 = 0
    var i: i64 = 0

    # Skip whitespace
    while *(s + i) == ' ' or *(s + i) == '\t'
        i += 1

    # Check sign
    if *(s + i) == '-'  # '-'
        neg = 1
        i += 1
    else if *(s + i) == '+'  # '+'
        i += 1

    # Parse digits. C atoi wraps on overflow: spelled `*%`/`+%`/`-%` because
    # plain operators trap (LARB R63).
    while *(s + i) >= '0' and *(s + i) <= '9'
        result = result *% 10 +% (*(s + i) - '0') as i64
        i += 1

    if neg != 0
        return 0 -% result
    return result

# ============================================================================
# Character classification
# ============================================================================

pub fn isdigit(c: u8) -> bool
    return c >= '0' and c <= '9'

pub fn isalpha(c: u8) -> bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')

pub fn isalnum(c: u8) -> bool
    return isdigit(c) or isalpha(c)

pub fn isspace(c: u8) -> bool
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'

pub fn isupper(c: u8) -> bool
    return c >= 'A' and c <= 'Z'

pub fn islower(c: u8) -> bool
    return c >= 'a' and c <= 'z'

pub fn toupper(c: u8) -> u8
    if c >= 'a' and c <= 'z'
        return c - 32
    return c

pub fn tolower(c: u8) -> u8
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c

# ============================================================================
# Memory operations
# ============================================================================

# standard-exempt: raw-ptr-param: LLVM/libc ABI symbol: memset(3), the compiler emits calls
pub fn memset(dest: *u8, c: u8, n: i64) -> *u8
    for i in 0..n
        *(dest + i) = c
    return dest

# standard-exempt: ptr-len-param, raw-ptr-param: LLVM/libc ABI symbol: memcpy(3), the compiler emits calls
pub fn memcpy(dest: *u8, src: *u8, n: i64) -> *u8
    for i in 0..n
        *(dest + i) = *(src + i)
    return dest

# C memcmp: three-way ordering (-1/0/1), not an error (S-RESULT-1).
# standard-exempt: sentinel-return, raw-ptr-param: C memcmp(3) ABI: three-way ordering, not an error
# standard-exempt: ptr-len-param: LLVM/libc ABI symbol: memcmp(3), the compiler emits calls
pub fn memcmp(a: *u8, b: *u8, n: i64) -> i32
    for i in 0..n
        if *(a + i) < *(b + i)
            return -1
        if *(a + i) > *(b + i)
            return 1
    return 0

# ----------------------------------------------------------------------------
# Compiler-synthesized primitives
#
# LLVM may emit calls to these even when no Ritz source names them:
#   - at -O2 it rewrites `memcmp(a, b, n) == 0` into `bcmp`, since only
#     equality is observed and bcmp need not compute an ordering;
#   - it lowers copies it cannot prove non-overlapping into `memmove`.
#
# Ritz links freestanding with no libc, so ritzlib must supply the whole set
# LLVM is entitled to synthesize (memcpy, memset, memcmp, bcmp, memmove).
# Omitting one does not fail at compile time — it fails at link time, far from
# the cause. That is how bootstrap stage 2 broke: building ritz1 died on
# `undefined reference to 'bcmp'` from a comparison nobody wrote.
#
# Keep this set complete. Adding a definition here is cheap; diagnosing the
# link error it prevents is not.
# ----------------------------------------------------------------------------

# Equality-only comparison. Returns 0 when the first n bytes match, non-zero
# otherwise. Unlike memcmp the magnitude and sign carry no meaning, which is
# what lets it stop at the first differing byte without ordering it.
# standard-exempt: ptr-len-param, raw-ptr-param: LLVM/libc ABI symbol: bcmp(3), the compiler emits calls
pub fn bcmp(a: *u8, b: *u8, n: i64) -> i32
    for i in 0..n
        if *(a + i) != *(b + i)
            return 1
    return 0

# Copy that stays correct when the regions overlap.
#
# Direction matters: copying forward while dest > src overwrites source bytes
# before they are read. Comparing as integers because Ritz has no relational
# operator on raw pointers.
# standard-exempt: ptr-len-param, raw-ptr-param: LLVM/libc ABI symbol: memmove(3), the compiler emits calls
pub fn memmove(dest: *u8, src: *u8, n: i64) -> *u8
    if n <= 0
        return dest

    let d: i64 = dest as i64
    let s: i64 = src as i64
    if d == s
        return dest

    if d < s
        # Destination is below the source: ascending order reads each byte
        # before the write that would clobber it.
        for i in 0..n
            *(dest + i) = *(src + i)
    else
        # Destination overlaps above the source: walk down from the top.
        var i: i64 = n
        while i > 0
            i = i - 1
            *(dest + i) = *(src + i)

    return dest
