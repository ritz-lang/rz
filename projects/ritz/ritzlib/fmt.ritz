# ritzlib/fmt.ritz - the one integer-to-text digit routine
#
# Every ritzlib integer formatter (print_int, eprint_int, print_hex, itoa,
# string_push_i64, string_from_hex, iovec_append_int/uint, testlib's pid
# suffix) writes its digits through these functions. Add a formatter by
# calling them, not by writing another `% 10` loop: AGAST #1856 found seven
# copies, and four printed only "-" for i64's minimum because `0 - n` wraps.
#
# Each writes into a caller buffer, returns the byte count, and writes no
# NUL. Sizes: fmt_i64_into needs 20 bytes, fmt_u64_into 20, fmt_u64_hex_into
# 16. No imports, so any module (and freestanding code) can use it.

# Decimal digits of n into buf. Returns the count (1..20).
pub fn fmt_u64_into(buf: *u8, n: u64) -> i64
    # Count digits first so they can be written in place, most significant
    # first, with no temporary buffer.
    var len: i64 = 1
    var t: u64 = n / 10
    while t != 0
        len += 1
        t = t / 10

    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        *(buf + i) = ((v % 10) + 48) as u8  # '0' + digit
        v = v / 10
        i -= 1
    len

# n in decimal, with a leading '-' when negative. Returns the count (1..20).
pub fn fmt_i64_into(buf: *u8, n: i64) -> i64
    if n < 0
        *buf = 45  # '-'
        # Negate in u64: 0 - n wraps for i64's minimum in i64, but its
        # magnitude 2^63 is representable as a u64.
        let bits: u64 = n as u64
        let mag: u64 = 0 - bits
        return 1 + fmt_u64_into(buf + 1, mag)
    fmt_u64_into(buf, n as u64)

# Lowercase hex digits of n into buf, no "0x" prefix, no leading zeros
# ("0" for zero). Returns the count (1..16).
pub fn fmt_u64_hex_into(buf: *u8, n: u64) -> i64
    var len: i64 = 1
    var t: u64 = n / 16
    while t != 0
        len += 1
        t = t / 16

    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        let digit: u64 = v % 16
        if digit < 10
            *(buf + i) = (digit + 48) as u8  # '0'..'9'
        else
            *(buf + i) = (digit + 87) as u8  # 'a'..'f' (97 - 10)
        v = v / 16
        i -= 1
    len
