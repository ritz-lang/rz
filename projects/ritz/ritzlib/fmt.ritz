# ritzlib/fmt.ritz - formatting and printing: the one import
#
# AGAST #201 (#198 Phase 2, docs/V1_ABI_CLEANUP.md "Output"). `import
# ritzlib.fmt` brings in:
#
#   print / eprint          builtins with `{x}` interpolation (LANGUAGE_SPEC §2.6)
#   println / eprintln      ritzlib.io: a StrView and a newline, stdout / stderr
#   write / writeln         a StrView (and a newline) to any Writer
#   format                  a StrView copied into a new String
#   Writer and its sinks    ritzlib.fmt.writer
#   Display, Debug          ritzlib.fmt.display
#   fmt_show_T ...          the built-in types' formatting fns, ritzlib.fmt.impls
#   FmtSpec                 the `{x:spec}` specifiers, ritzlib.fmt.spec
#   fmt_*_into              integer digits, ritzlib.fmt.digits
#
# Freestanding code imports ritzlib.fmt.digits alone: everything else here
# is hosted (tools/ritzlib_layers.py).
#
# `print("x = {x}")` is lowered at compile time; write / writeln / format
# take their text as it is until the interpolation lowering moves onto
# Display (#202).

pub import ritzlib.fmt.digits
pub import ritzlib.fmt.spec
pub import ritzlib.fmt.writer
pub import ritzlib.fmt.impls
pub import ritzlib.fmt.display
pub import ritzlib.io
import ritzlib.errno
import ritzlib.string

# Every byte of s to w, or the Writer's error (AGAST #4930: a Result, not a
# byte count).
pub fn write(w: @&Writer, s: StrView) -> Result<(), Errno>
    w.write_str(s)

# s and a newline to w. Stops at the first error.
pub fn writeln(w: @&Writer, s: StrView) -> Result<(), Errno>
    w.write_str(s)?
    w.write_byte(10)

# s in a new String; the caller drops it.
pub fn format(s: StrView) -> String
    string_from(s)
