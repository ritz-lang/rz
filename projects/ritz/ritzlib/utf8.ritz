# ritzlib/utf8.ritz - decoding UTF-8 text one code point at a time.
#
#     let u = utf8_unit_at(text, i)     # text: [u8], i < text.len
#     u.cp                              # the code point (u32)
#     u.len                             # its length in bytes: 1 to 4
#
# Well-formed is RFC 3629's: no overlong forms, no surrogates, nothing above
# U+10FFFF. A byte that doesn't start a well-formed sequence is a unit of
# length 1 with the code point 0xDC00 + the byte: a lone surrogate no
# well-formed text decodes to (Python's "surrogateescape"), so malformed
# text still steps forward byte by byte, and a malformed byte matches only
# the same byte. ritzlib.regex and ritzlib.glob read their text through it.

import ritzlib.span

# One unit of text: a code point and its length in bytes.
pub struct Utf8Unit
    cp: u32
    len: i64

# The unit starting at s[i]; i must be below s.len.
pub fn utf8_unit_at(s: [u8], i: i64) -> Utf8Unit
    let b = s[i]
    if b < 0x80
        return Utf8Unit { cp: b as u32, len: 1 }
    let bad = Utf8Unit { cp: 0xDC00 + b as u32, len: 1 }
    # The sequence length, the range its second byte must fall in (no
    # overlongs, no surrogates, nothing above U+10FFFF) and the lead's bits.
    var n: i64 = 0
    var lo: u8 = 0x80
    var hi: u8 = 0xBF
    var cp: u32 = 0
    if b >= 0xC2 and b <= 0xDF
        n = 2
        cp = (b & 0x1F) as u32
    else if b >= 0xE0 and b <= 0xEF
        n = 3
        cp = (b & 0x0F) as u32
        if b == 0xE0
            lo = 0xA0
        else if b == 0xED
            hi = 0x9F
    else if b >= 0xF0 and b <= 0xF4
        n = 4
        cp = (b & 0x07) as u32
        if b == 0xF0
            lo = 0x90
        else if b == 0xF4
            hi = 0x8F
    else
        return bad
    if i + n > s.len or s[i + 1] < lo or s[i + 1] > hi
        return bad
    for k in 1..n
        let c = s[i + k]
        if c < 0x80 or c > 0xBF
            return bad
        cp = (cp << 6) | (c & 0x3F) as u32
    Utf8Unit { cp: cp, len: n }
