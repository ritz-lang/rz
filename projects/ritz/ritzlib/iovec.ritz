# ritzlib/iovec.ritz - Vectored I/O for scatter/gather writes
#
# Provides zero-copy string building using iovec arrays for writev/sendmsg.
# Static strings point directly to .rodata, dynamic strings use a pool.

import ritzlib.sys
import ritzlib.str
import ritzlib.io
import ritzlib.span
import ritzlib.fmt.digits
import ritzlib.result

# ============================================================================
# iovec structure (matches Linux struct iovec)
# ============================================================================

pub struct Iovec
    base: *u8      # Pointer to buffer
    len: u64       # Length of buffer


# ============================================================================
# Small string optimization slot (16 bytes inline storage)
# ============================================================================

const INLINE_SIZE: i32 = 16

struct InlineSlot
    data: [16]u8   # Inline storage for small strings
    len: i32       # Length used (0 = slot is a pointer, not inline)


# ============================================================================
# IoVec Builder - builds vectored strings for writev
# ============================================================================
#
# Usage (valet/lib/response.ritz builds its responses this way):
#   var builder: IoVecBuilder
#   builder.init()
#   builder.append_span(status_line)     # a Span<u8>: pre-computed length
#   builder.append_bytes(Span<u8> { ptr: c"Content-Length: ", len: 16 })
#   builder.append_int(13)
#   builder.append_crlf()
#   builder.append_crlf()
#   builder.append_span(body)
#   let count = builder.count()
#   writev(fd, builder.ptr(), count)

const MAX_IOVECS: i32 = 32
const POOL_SIZE: i32 = 512   # Bytes for dynamic strings

struct IoVecBuilder
    iovecs: [32]Iovec       # Array of iovec entries
    pool: [512]u8           # Pool for dynamic string data
    count: i32              # Number of iovecs used
    pool_used: i32          # Bytes used in pool


# Each append is Ok(the number of bytes it added) or Err(IovecError) when
# there is no room: the builder holds at most MAX_IOVECS entries and the
# pool at most POOL_SIZE bytes.  Ok(len) is a real value (the tests compare
# it), so the failure cannot be an in-band length.
pub enum IovecError
    TooManyVecs
    PoolFull


# Methods (S-IMPL-1): an IoVecBuilder is the subject of every operation on it.
impl IoVecBuilder
    # Initialize builder
    pub fn init(self: *IoVecBuilder)
        self.count = 0
        self.pool_used = 0

    # Reset builder for reuse (keeps memory)
    pub fn reset(self: *IoVecBuilder)
        self.count = 0
        self.pool_used = 0

    # Get pointer to iovec array (for writev)
    pub fn ptr(self: *IoVecBuilder) -> *Iovec
        return @self.iovecs[0]

    # Get number of iovecs
    pub fn count(self: *IoVecBuilder) -> i32
        return self.count

    # Append a Span<u8> slice (zero-copy, length already known - NO strlen!)
    # This is the preferred method for Ritz strings.
    pub fn append_span(self: *IoVecBuilder, s: Span<u8>) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        self.iovecs[self.count].base = s.ptr
        self.iovecs[self.count].len = s.len as u64
        self.count += 1
        return Ok(s.len as i32)

    # Append a static string (zero-copy - points directly at the view's bytes).
    # A StrView carries its length, so there is no strlen here.
    pub fn append_static(self: *IoVecBuilder, s: StrView) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        let slen: u64 = s.len as u64
        self.iovecs[self.count].base = s.ptr
        self.iovecs[self.count].len = slen
        self.count += 1
        return Ok(slen as i32)

    # Append a static string with explicit length (for binary data)
    pub fn append_bytes(self: *IoVecBuilder, data: Span<u8>) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        self.iovecs[self.count].base = data.ptr
        self.iovecs[self.count].len = data.len as u64
        self.count += 1
        return Ok(data.len as i32)

    # Append a Str slice (zero-copy - uses pre-computed length)
    # This is the preferred method for static strings with known lengths
    # Note: Works with Span<u8> since Str and Span<u8> are structurally identical
    pub fn append_str(self: *IoVecBuilder, s: Span<u8>) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        self.iovecs[self.count].base = s.ptr
        self.iovecs[self.count].len = s.len as u64
        self.count += 1
        return Ok(s.len as i32)

    # Append a dynamic string (copies to pool)
    pub fn append_copy(self: *IoVecBuilder, s: StrView) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        let slen: i32 = s.len as i32
        if self.pool_used + slen > POOL_SIZE
            return Err(IovecError.PoolFull)  # Pool exhausted

        # Copy to pool
        let dest: *u8 = @self.pool[self.pool_used]
        for i in 0..slen
            *(dest + i) = *(s.ptr + i)

        self.iovecs[self.count].base = dest
        self.iovecs[self.count].len = slen as u64
        self.count += 1
        self.pool_used += slen
        return Ok(slen)

    # Append an integer as decimal string (uses pool)
    # standard-exempt: ptr-len-param: false positive: `n` is the integer to encode, not a buffer length
    pub fn append_int(self: *IoVecBuilder, n: i64) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        # i64 min is 19 digits + sign (fmt_i64_into)
        if self.pool_used + 21 > POOL_SIZE
            return Err(IovecError.PoolFull)

        let dest: *u8 = @self.pool[self.pool_used]
        let len: i32 = fmt_i64_into(dest, n) as i32

        self.iovecs[self.count].base = dest
        self.iovecs[self.count].len = len as u64
        self.count += 1
        self.pool_used += len
        return Ok(len)

    # Append unsigned integer
    # standard-exempt: ptr-len-param: false positive: `n` is the integer to encode, not a buffer length
    pub fn append_uint(self: *IoVecBuilder, n: u64) -> Result<i32, IovecError>
        if self.count >= MAX_IOVECS
            return Err(IovecError.TooManyVecs)

        if self.pool_used + 20 > POOL_SIZE
            return Err(IovecError.PoolFull)

        let dest: *u8 = @self.pool[self.pool_used]
        let len: i32 = fmt_u64_into(dest, n) as i32

        self.iovecs[self.count].base = dest
        self.iovecs[self.count].len = len as u64
        self.count += 1
        self.pool_used += len
        return Ok(len)

    # Convenience: append CRLF
    pub fn append_crlf(self: *IoVecBuilder) -> Result<i32, IovecError>
        return self.append_static("\r\n")

    # Total bytes across all iovecs
    pub fn total_len(self: *IoVecBuilder) -> i64
        var total: i64 = 0
        for i in 0..self.count
            total += self.iovecs[i].len as i64
        return total

    # For debugging: print all iovecs
    pub fn debug_print(self: *IoVecBuilder)
        let total = self.total_len()
        print("IoVecBuilder: {self.count} iovecs, {self.pool_used} pool bytes, {total} total bytes\n")

        for i in 0..self.count
            print("  [{i}] len={self.iovecs[i].len as i64}\n")
