# ritzlib/cmp.ritz - Ordering, the result of a three-way comparison
#
# Every ritzlib three-way compare (StrView.cmp, Span<u8>'s cmp, cmp_i64) returns an
# Ordering, not C's -1/0/1 i32 (AGAST #4639): a caller names the outcome it
# means (`a.cmp(b) == Ordering.Less`, `a.cmp(b).is_ge()`) instead of comparing
# an integer against zero.
#
#     match a.cmp(b)
#         Less => ...
#         Equal => ...
#         Greater => ...
#
# `Ord` is a type with a total order: what ritzlib.sort's sort<T: Ord> needs of
# T (AGAST #4913). Its method is `compare`, not `cmp`, for the reason
# hash.ritz's Eq has `equals`: a type has one method per name (§15.3), and
# StrView already has a by-value `cmp`.
#
# No imports: heap-free (BARE in tools/ritzlib_layers.py), so ritzlib.strview
# and freestanding code can use it.

pub enum Ordering
    Less
    Equal
    Greater

impl Ordering
    pub fn is_eq(self: Ordering) -> bool
        return self == Ordering.Equal

    pub fn is_ne(self: Ordering) -> bool
        return self != Ordering.Equal

    pub fn is_lt(self: Ordering) -> bool
        return self == Ordering.Less

    pub fn is_gt(self: Ordering) -> bool
        return self == Ordering.Greater

    pub fn is_le(self: Ordering) -> bool
        return self != Ordering.Greater

    pub fn is_ge(self: Ordering) -> bool
        return self != Ordering.Less

    # Less <-> Greater; Equal stays. Sorts descending: `b.cmp(a)` is
    # `a.cmp(b).reverse()`.
    pub fn reverse(self: Ordering) -> Ordering
        if self == Ordering.Less
            return Ordering.Greater
        if self == Ordering.Greater
            return Ordering.Less
        return Ordering.Equal

# Three-way compare of two i64s.
pub fn cmp_i64(a: i64, b: i64) -> Ordering
    if a < b
        return Ordering.Less
    if a > b
        return Ordering.Greater
    return Ordering.Equal

# A total order: a.compare(@b) is Less when a goes before b.
pub trait Ord
    fn compare(self: @Self, other: @Self) -> Ordering

# A primitive's impl is legal only in the trait's file (spec §12.2).
impl Ord for i64
    fn compare(self: @i64, other: @i64) -> Ordering
        cmp_i64(*self, *other)
