# ritzlib/cstr.ritz - C interop only; StrView/String everywhere else
#
# The one module that names a NUL-terminated *u8 (AGAST #4688), like Rust's
# std::ffi::CStr: use it where a C API, argv/envp or the kernel hands you a
# string with no length, or wants one with a NUL. Ritz text is StrView
# (ritzlib.strview, borrowed) or String (ritzlib.string, owned):
#
#   strlen, strview_from_cstr  a C string -> a view of its bytes
#   string_from_cstr           a C string -> an owned String
#   cstr_of                    a String   -> its NUL-terminated *u8
#   streq, strneq              compare two C strings
#   eprints_cstr, eprintln_cstr  print a C string to stderr
#
# The Ritz forms of what is gone: push_str(StrView) for push_cstr, `==` for
# eq_cstr, starts_with("...") for starts_with_cstr, parse_i64 for atoi,
# find/contains/find_byte for strstr/strchr, string_from(sv) for strcpy.

import ritzlib.sys
import ritzlib.string
import ritzlib.strview

# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn strlen(s: *u8) -> i64
    var len: i64 = 0
    while *(s + len) != 0
        len += 1
    return len

# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn streq(a: *u8, b: *u8) -> bool
    var i: i64 = 0
    while *(a + i) != 0 and *(b + i) != 0
        if *(a + i) != *(b + i)
            return false
        i += 1
    return *(a + i) == *(b + i)

# standard-exempt: ptr-len-param, raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn strneq(a: *u8, b: *u8, n: i64) -> bool
    var i: i64 = 0
    while i < n and *(a + i) != 0 and *(b + i) != 0
        if *(a + i) != *(b + i)
            return false
        i += 1
    if i == n
        return true
    return *(a + i) == *(b + i)

# A view of the bytes of a C string, up to its NUL.
# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn strview_from_cstr(cstr: *u8) -> StrView
    var s: StrView
    s.ptr = cstr
    s.len = 0
    while *(cstr + s.len) != 0
        s.len += 1
    return s

# An owned copy of a C string's bytes. Empty if the allocation fails.
# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn string_from_cstr(cstr: *u8) -> String
    return string_from(strview_from_cstr(cstr))

# The String's bytes as a NUL-terminated *u8, valid until the String changes or
# drops. A String keeps a slot for the NUL (String.as_ptr), so no copy is made.
# standard-exempt: ptr-return: ritzlib.cstr IS the C-string boundary
pub fn cstr_of(s: @&String) -> *u8
    return s.as_ptr()

# C interop: print a C string to stderr; prefer eprints(StrView).
# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn eprints_cstr(s: *u8)
    sys_write(STDERR, s, strlen(s))

# C interop: print a C string and a newline to stderr; prefer eprintln(StrView).
# standard-exempt: raw-ptr-param: ritzlib.cstr IS the C-string boundary
pub fn eprintln_cstr(s: *u8)
    eprints_cstr(s)
    var nl: [1]u8
    nl[0] = 10
    sys_write(STDERR, @nl[0], 1)
