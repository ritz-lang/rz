# ritzlib/ct.ritz - Constant-time comparison (AGAST #1863)
#
# For comparing secrets (passwords, MACs, tokens) where the time taken must
# not depend on WHERE two inputs differ. A strcmp/memcmp that stops at the
# first mismatch lets an attacker recover a secret byte by byte from timing.
#
# ct_bytes_eq(a, a_len, b, b_len) -> bool
#   True iff the two byte strings have equal length and contents.
#   Running time depends only on a_len (pass the attacker-supplied input as
#   `a`, the secret as `b`); it reveals nothing about b's contents and, for
#   b_len > 0, does not branch on b_len. Every byte of a is examined.
#
# This is a comparison, not a barrier against the optimiser: like every
# constant-time routine written in a compiled language it relies on the
# compiler not turning the OR-accumulation back into an early exit, which
# LLVM does not do for this shape. cryptosec has its own mem_eq for
# equal-length buffers; this one is for callers that do not depend on
# cryptosec (tome AUTH).

pub fn ct_bytes_eq(a: *u8, a_len: i64, b: *u8, b_len: i64) -> bool
    # An empty secret is public information (no password set); answer
    # directly rather than index b at all.
    if b_len <= 0
        return a_len == 0

    # Length mismatch contributes to the difference, not to control flow.
    var diff: u64 = (a_len ^ b_len) as u64

    for i in 0..a_len
        # Past the end of b, read b[0] instead (index masked, no branch) and
        # rely on the length term above to report the mismatch.
        let in_range: u64 = (i < b_len) as u64
        let mask: u64 = 0 - in_range
        let j: i64 = ((i as u64) & mask) as i64
        let xa: u64 = *(a + i) as u64
        let xb: u64 = *(b + j) as u64
        diff = diff | (xa ^ xb)

    return diff == 0
