# ritzlib/span.ritz - Non-owning views into contiguous memory
#
# Span<T> is a lightweight, non-owning view into an array of T elements.
# - No allocation, no ownership - just a pointer and length
# - Can be created from Vec<T>, arrays, or raw pointers
# - Ideal for passing slices of data to functions without copying
# - Zero-cost abstraction: compiles down to (ptr, len) pair
#
# Usage:
#   var v: Vec<u8> = ...
#   let span: Span<u8> = span_from_vec<u8>(@v)
#   let sub: Span<u8> = span_slice<u8>(@span, 1, 5)
#
# Common patterns:
#   span_from_strview("hello")   # Span<u8> from a StrView
#   span_from_vec<i32>(@v)       # Span<i32> from Vec
#   span_from_ptr<u8>(ptr, len)  # Span<u8> from raw pointer
#
# Note: Span does NOT own the memory it points to. The underlying data
# must outlive any spans referencing it.

import ritzlib.str
import ritzlib.gvec
import ritzlib.strview
import ritzlib.cmp  # Bytes.cmp -> Ordering
import ritzlib.memory  # Span.secure_zero's volatile stores
# Note: selective imports like { StrView } are not yet supported by ritz1

# ============================================================================
# Span<T> - Non-owning view into contiguous memory
# ============================================================================

struct Span<T>
    ptr: *T        # Pointer to first element (not owned)
    len: i64       # Number of elements

# ============================================================================
# Span constructors
# ============================================================================

# Create an empty span
pub fn span_empty<T>() -> Span<T>
    var s: Span<T>
    s.ptr = null
    s.len = 0
    return s

# Create a span from a raw pointer and length
# standard-exempt: ptr-len-param: Span constructor: this is the raw-pair-to-Span boundary
# standard-exempt: raw-ptr-param: Span constructor: this is the raw-pair-to-Span boundary
pub fn span_from_ptr<T>(ptr: *T, len: i64) -> Span<T>
    var s: Span<T>
    s.ptr = ptr
    s.len = len
    return s

# Create a span from a Vec<T>
pub fn span_from_vec<T>(v: @Vec<T>) -> Span<T>
    var s: Span<T>
    s.ptr = v.data
    s.len = v.len
    return s

# The bytes of `v` itself, sizeof(T) of them, to fill or zero in place (a
# plain-data T: one without pointers it owns). A view of `v`: valid while
# `v` is.
pub fn span_of_bytes<T>(v: @&T) -> Span<u8>
    var s: Span<u8>
    s.ptr = v as *u8
    s.len = sizeof(T)
    return s

# Create a Span<u8> from a StrView (zero-cost, same memory layout)
# This is useful for bridging between string literals and Span<u8> APIs
pub fn span_from_strview(sv: StrView) -> Span<u8>
    var s: Span<u8>
    s.ptr = sv.ptr
    s.len = sv.len
    return s

# Methods (S-IMPL-1): a Span<T> is the subject of every generic operation.
# Every receiver is `self: @Span<T>` (S-IMPL-3, AGAST #4682): no method
# changes the span itself. copy_from, fill and zero write the elements, which
# the span reaches through its pointer, so a `let` span can be filled.
impl<T> Span<T>
    # Get length of span
    pub fn len(self: @Span<T>) -> i64
        return self.len

    # Check if span is empty
    pub fn is_empty(self: @Span<T>) -> bool
        if self.len == 0
            return true
        return false

    # Get element at index (unchecked)
    pub fn get(self: @Span<T>, idx: i64) -> T
        return *(self.ptr + idx)

    # Get pointer to element at index (unchecked)
    # standard-exempt: ptr-return: the raw accessor for interop: unchecked element pointer
    pub fn get_ptr(self: @Span<T>, idx: i64) -> *T
        return self.ptr + idx

    # Get raw pointer to span data
    # standard-exempt: ptr-return: the raw accessor for interop: the span's data pointer
    pub fn as_ptr(self: @Span<T>) -> *T
        return self.ptr

    # Create a sub-span [start:end)
    pub fn slice(self: @Span<T>, start: i64, end: i64) -> Span<T>
        var result: Span<T>
        if start < 0
            start = 0
        if end > self.len
            end = self.len
        if start >= end
            result.ptr = null
            result.len = 0
            return result
        result.ptr = self.ptr + start
        result.len = end - start
        return result

    # Create a span from start to end of original
    pub fn from(self: @Span<T>, start: i64) -> Span<T>
        return self.slice(start, self.len)

    # Create a span from beginning to index
    pub fn to(self: @Span<T>, end: i64) -> Span<T>
        return self.slice(0, end)

    # Copy src's elements to the front of self: memcpy/memmove's replacement
    # (AGAST #4639). Copies min(self.len, src.len) elements, so it never
    # writes past self, and returns that count. Overlap-safe: src may be a
    # slice of the same buffer, either side of self.
    pub fn copy_from(self: @Span<T>, src: Span<T>) -> i64
        var n: i64 = src.len
        if self.len < n
            n = self.len
        if n > 0
            memmove(self.ptr as *u8, src.ptr as *u8, n * sizeof(T))
        return n

    # Set every element to v: memset's replacement (AGAST #4639).
    pub fn fill(self: @Span<T>, v: T)
        for i in 0..self.len
            *(self.ptr + i) = v

    # Zero every byte of the span (len * sizeof(T)): memzero(p, n)'s
    # replacement (AGAST #4638). Plain stores: if nothing reads the memory
    # again the optimiser may delete them, so wipe a secret with secure_zero.
    pub fn zero(self: @Span<T>)
        if self.len > 0
            memset(self.ptr as *u8, 0, self.len * sizeof(T))

    # Zero every byte of the span so that the optimiser cannot remove the
    # writes, even when nothing reads them again: wipe keys and other secrets
    # with this (`key.secure_zero()`, AGAST #4638). The volatile stores are
    # ritzlib.memory's secure_zero (#1864); ritz0/tests/test_secure_zero.py
    # checks they survive -O2 through this method too.
    pub fn secure_zero(self: @Span<T>)
        if self.len > 0
            secure_zero(self.ptr as *u8, self.len * sizeof(T))

# ============================================================================
# Bytes: the byte operations of a Span<u8> (AGAST #4684)
# ============================================================================

# Span<u8> and StrView share one layout ({ ptr: *u8, len: i64 }), so every
# byte operation is StrView's: one implementation, two spellings (AGAST
# #1930). They are methods through a trait because an inherent `impl
# Span<u8>` beside `impl<T> Span<T>` is refused, while a trait impl on one
# instantiation is allowed in the trait's own file (LANGUAGE_SPEC §12, R36's
# revisit, AGAST #4294). Call them as methods: `a.eq(@b)`, `s.as_strview()`.
pub trait Bytes
    fn as_strview(self: @Self) -> StrView
    fn eq(self: @Self, other: @Span<u8>) -> bool
    fn contains(self: @Self, needle: @Span<u8>) -> bool
    fn starts_with(self: @Self, prefix: @Span<u8>) -> bool
    fn ends_with(self: @Self, suffix: @Span<u8>) -> bool
    fn find(self: @Self, needle: @Span<u8>) -> i64
    fn find_byte(self: @Self, c: u8) -> i64
    fn cmp(self: @Self, other: @Span<u8>) -> Ordering

impl Bytes for Span<u8>
    # The same bytes as a StrView (zero-cost: one layout).
    fn as_strview(self: @Span<u8>) -> StrView
        return StrView { ptr: self.ptr, len: self.len }

    # Byte-for-byte equality.
    fn eq(self: @Span<u8>, other: @Span<u8>) -> bool
        return self.as_strview().eq(other.as_strview())

    # Whether `needle` occurs anywhere in the span.
    fn contains(self: @Span<u8>, needle: @Span<u8>) -> bool
        return self.as_strview().contains(needle.as_strview())

    fn starts_with(self: @Span<u8>, prefix: @Span<u8>) -> bool
        return self.as_strview().starts_with(prefix.as_strview())

    fn ends_with(self: @Span<u8>, suffix: @Span<u8>) -> bool
        return self.as_strview().ends_with(suffix.as_strview())

    # Index of the first occurrence of `needle`, or self.len when there is
    # none: the S-RESULT-1 index-or-length form, not an error.
    fn find(self: @Span<u8>, needle: @Span<u8>) -> i64
        return self.as_strview().find(needle.as_strview())

    # Index of the first `c`, or self.len when there is none (S-RESULT-1).
    fn find_byte(self: @Span<u8>, c: u8) -> i64
        return self.as_strview().find_byte(c)

    # Three-way compare: memcmp's replacement (AGAST #4639).
    fn cmp(self: @Span<u8>, other: @Span<u8>) -> Ordering
        return self.as_strview().cmp(other.as_strview())

# ============================================================================
# Span<u8> from a raw (pointer, length) pair
# ============================================================================

# Create a Span<u8> from a pointer and length
# standard-exempt: ptr-len-param: Span constructor: this is the raw-pair-to-Span boundary
# standard-exempt: raw-ptr-param: Span constructor: this is the raw-pair-to-Span boundary
pub fn span_from_bytes(ptr: *u8, len: i64) -> Span<u8>
    var s: Span<u8>
    s.ptr = ptr
    s.len = len
    return s

# Create a Span<u8> with explicit length (alias for span_from_ptr)
# Useful for compile-time constants where length is known
# standard-exempt: ptr-len-param: Span constructor: this is the raw-pair-to-Span boundary
# standard-exempt: raw-ptr-param: Span constructor: this is the raw-pair-to-Span boundary
pub fn span_literal(ptr: *u8, len: i64) -> Span<u8>
    var s: Span<u8>
    s.ptr = ptr
    s.len = len
    return s


# ritz1's slice-syntax lowering keys on whether a generic function named
# `span_slice` is visible to tell a program that imports ritzlib.span from one
# that does not (ritz1/src/monomorph.ritz).  Keep the symbol as a thin method
# forwarder so that detection still works; callers use `s.slice(lo, hi)`.
# standard-exempt: free-fn-method: ritz1 looks up this exact generic free-fn symbol to detect ritzlib.span (AGAST #4445)
pub fn span_slice<T>(s: @Span<T>, start: i64, end: i64) -> Span<T>
    return s.slice(start, end)
