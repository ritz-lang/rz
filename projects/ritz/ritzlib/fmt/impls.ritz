# ritzlib/fmt/impls.ritz - Display and Debug for the built-in types
#
# AGAST #201 (#198 Phase 2). One set of fns per built-in type T:
#
#     fmt_show_T(v, w)             Display: what `{v}` prints
#     fmt_show_T_with(v, w, spec)  Display under a format spec (`{v:08x}`);
#                                  `?` is Debug
#     fmt_debug_T(v, w)            Debug: what `{v:?}` prints
#
# for T in i8 i16 i32 i64 u8 u16 u32 u64 bool strview string cstr (*u8) and
# bytes (Span<u8>). Each returns the bytes written, or a negative value from
# the Writer (or -1 for a spec outside the v1 set).
#
# These fns are still the bodies.  R36's revisit (Aaron, 2026-11-20,
# AGAST #4294) makes `impl Display for i64` legal in the file that declares
# the trait, so ritzlib.fmt.display now has those impls, one line each; the
# `fmt_show_T` fns stay for the `_with` spec forms and the explicit calls in
# ritzlib.tests.  A type outside the ruling (a primitive in another file, an
# inherent impl, Option/Result) is still refused (§12.2, LARB R36 / R26).
#
# Display matches what print's `{x}` prints today (LANGUAGE_SPEC §2.6): signed
# decimal with '-', unsigned decimal, true/false, a view's bytes, a C string
# up to its NUL. Under x X b o a negative signed value prints its two's
# complement at its own width: `{-1 as i8:x}` is `ff`.

import ritzlib.fmt.digits
import ritzlib.fmt.spec
import ritzlib.fmt.writer
import ritzlib.string
import ritzlib.strview

# ============================================================================
# Padding
# ============================================================================

# Write body[0..len] padded to spec.width. `sign` leading bytes of the body
# (a '-') go before zero padding. `dflt` is the alignment when the spec has
# none: right for numbers, left for text.
fn fmt_write_padded(w: @&Writer, body: *u8, len: i64, sign: i64, spec: @FmtSpec, dflt: u8) -> i64
    let pad: i64 = spec.width - len
    if pad <= 0
        return w.write(body, len)
    if spec.zero
        let a: i64 = w.write(body, sign)
        if a < 0
            return a
        let z: i64 = w.write_fill(48, pad)
        if z < 0
            return z
        let b: i64 = w.write(body + sign, len - sign)
        if b < 0
            return b
        return spec.width
    var align: u8 = spec.align
    if align == FMT_ALIGN_NONE
        align = dflt
    var before: i64 = 0
    if align == FMT_ALIGN_RIGHT
        before = pad
    else if align == FMT_ALIGN_CENTER
        before = pad / 2
    let x: i64 = w.write_fill(32, before)
    if x < 0
        return x
    let y: i64 = w.write(body, len)
    if y < 0
        return y
    let z: i64 = w.write_fill(32, pad - before)
    if z < 0
        return z
    spec.width

# ============================================================================
# Integers
# ============================================================================

# mag in the spec's radix, after a '-' when neg.
fn fmt_write_int(w: @&Writer, neg: bool, mag: u64, spec: @FmtSpec) -> i64
    if not spec.ok
        return -1
    var buf: [66]u8
    var sign: i64 = 0
    if neg
        buf[0] = 45  # '-'
        sign = 1
    var upper: i32 = 0
    if spec.upper
        upper = 1
    let n: i64 = fmt_u64_radix_into(@buf[sign] as *u8, mag, spec.radix, upper)
    fmt_write_padded(w, @buf[0] as *u8, sign + n, sign, spec, FMT_ALIGN_RIGHT)

# A signed value `bits` wide. Decimal is signed; x X b o print the value's
# two's complement in `bits` bits.
fn fmt_write_signed(w: @&Writer, v: i64, bits: u64, spec: @FmtSpec) -> i64
    if spec.radix != 10
        var raw: u64 = v as u64
        if bits < 64
            raw = raw & (((1 as u64) << bits) - 1)
        return fmt_write_int(w, false, raw, spec)
    if v < 0
        # Negate in u64: i64's minimum has no i64 negation (AGAST #1856).
        let mag: u64 = 0 - (v as u64)
        return fmt_write_int(w, true, mag, spec)
    fmt_write_int(w, false, v as u64, spec)

fn fmt_signed_with(w: @&Writer, v: i64, bits: u64, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    fmt_write_signed(w, v, bits, @s)

fn fmt_unsigned_with(w: @&Writer, v: u64, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    fmt_write_int(w, false, v, @s)

pub fn fmt_show_i64(v: i64, w: @&Writer) -> i64
    let s: FmtSpec = fmt_spec_default()
    fmt_write_signed(w, v, 64, @s)

pub fn fmt_show_i32(v: i32, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_show_i16(v: i16, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_show_i8(v: i8, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_show_u64(v: u64, w: @&Writer) -> i64
    let s: FmtSpec = fmt_spec_default()
    fmt_write_int(w, false, v, @s)

pub fn fmt_show_u32(v: u32, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

pub fn fmt_show_u16(v: u16, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

pub fn fmt_show_u8(v: u8, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

pub fn fmt_show_i64_with(v: i64, w: @&Writer, spec: StrView) -> i64
    fmt_signed_with(w, v, 64, spec)

pub fn fmt_show_i32_with(v: i32, w: @&Writer, spec: StrView) -> i64
    fmt_signed_with(w, v as i64, 32, spec)

pub fn fmt_show_i16_with(v: i16, w: @&Writer, spec: StrView) -> i64
    fmt_signed_with(w, v as i64, 16, spec)

pub fn fmt_show_i8_with(v: i8, w: @&Writer, spec: StrView) -> i64
    fmt_signed_with(w, v as i64, 8, spec)

pub fn fmt_show_u64_with(v: u64, w: @&Writer, spec: StrView) -> i64
    fmt_unsigned_with(w, v, spec)

pub fn fmt_show_u32_with(v: u32, w: @&Writer, spec: StrView) -> i64
    fmt_unsigned_with(w, v as u64, spec)

pub fn fmt_show_u16_with(v: u16, w: @&Writer, spec: StrView) -> i64
    fmt_unsigned_with(w, v as u64, spec)

pub fn fmt_show_u8_with(v: u8, w: @&Writer, spec: StrView) -> i64
    fmt_unsigned_with(w, v as u64, spec)

# An integer's Debug is its Display.
pub fn fmt_debug_i64(v: i64, w: @&Writer) -> i64
    fmt_show_i64(v, w)

pub fn fmt_debug_i32(v: i32, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_debug_i16(v: i16, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_debug_i8(v: i8, w: @&Writer) -> i64
    fmt_show_i64(v as i64, w)

pub fn fmt_debug_u64(v: u64, w: @&Writer) -> i64
    fmt_show_u64(v, w)

pub fn fmt_debug_u32(v: u32, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

pub fn fmt_debug_u16(v: u16, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

pub fn fmt_debug_u8(v: u8, w: @&Writer) -> i64
    fmt_show_u64(v as u64, w)

# ============================================================================
# Text
# ============================================================================

# Bytes under a spec: width and alignment apply (left by default); a radix
# letter has no meaning for text and is ignored.
fn fmt_text_with(w: @&Writer, ptr: *u8, len: i64, spec: @FmtSpec) -> i64
    if not spec.ok
        return -1
    var s: FmtSpec = *spec
    s.zero = false
    fmt_write_padded(w, ptr, len, 0, @s, FMT_ALIGN_LEFT)

pub fn fmt_show_bool(v: bool, w: @&Writer) -> i64
    if v
        return w.write_str("true")
    w.write_str("false")

pub fn fmt_show_bool_with(v: bool, w: @&Writer, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    var t: StrView = "false"
    if v
        t = "true"
    fmt_text_with(w, t.ptr, t.len, @s)

pub fn fmt_debug_bool(v: bool, w: @&Writer) -> i64
    fmt_show_bool(v, w)

pub fn fmt_show_strview(v: StrView, w: @&Writer) -> i64
    w.write(v.ptr, v.len)

pub fn fmt_show_strview_with(v: StrView, w: @&Writer, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    if s.ok and s.debug
        return fmt_debug_strview(v, w)
    fmt_text_with(w, v.ptr, v.len, @s)

pub fn fmt_show_string(v: @String, w: @&Writer) -> i64
    fmt_show_strview(string_as_view(v), w)

pub fn fmt_show_string_with(v: @String, w: @&Writer, spec: StrView) -> i64
    fmt_show_strview_with(string_as_view(v), w, spec)

pub fn fmt_debug_string(v: @String, w: @&Writer) -> i64
    fmt_debug_strview(string_as_view(v), w)

fn fmt_cstr_len(p: *u8) -> i64
    var n: i64 = 0
    while *(p + n) != 0
        n += 1
    n

# A NUL-terminated C string; a null pointer writes nothing.
pub fn fmt_show_cstr(v: *u8, w: @&Writer) -> i64
    if v == null
        return 0
    w.write(v, fmt_cstr_len(v))

pub fn fmt_show_cstr_with(v: *u8, w: @&Writer, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    if s.ok and s.debug
        return fmt_debug_cstr(v, w)
    if v == null
        return fmt_text_with(w, v, 0, @s)
    fmt_text_with(w, v, fmt_cstr_len(v), @s)

# Quoted and escaped, as fmt_debug_strview; a null pointer is `null`.
pub fn fmt_debug_cstr(v: *u8, w: @&Writer) -> i64
    if v == null
        return w.write_str("null")
    fmt_debug_strview(StrView { ptr: v, len: fmt_cstr_len(v) }, w)

# A Span<u8>'s bytes, as they are.
pub fn fmt_show_bytes(v: Span<u8>, w: @&Writer) -> i64
    w.write(v.ptr, v.len)

pub fn fmt_show_bytes_with(v: Span<u8>, w: @&Writer, spec: StrView) -> i64
    let s: FmtSpec = fmt_spec_parse(spec)
    if s.ok and s.debug
        return fmt_debug_bytes(v, w)
    fmt_text_with(w, v.ptr, v.len, @s)

# `[1, 2, 255]`
pub fn fmt_debug_bytes(v: Span<u8>, w: @&Writer) -> i64
    var total: i64 = w.write_byte(91)   # '['
    if total < 0
        return total
    var i: i64 = 0
    while i < v.len
        if i > 0
            let c: i64 = w.write_str(", ")
            if c < 0
                return c
            total = total + c
        let n: i64 = fmt_show_u64(*(v.ptr + i) as u64, w)
        if n < 0
            return n
        total = total + n
        i += 1
    let e: i64 = w.write_byte(93)        # ']'
    if e < 0
        return e
    total + e

# The escape for byte c inside Debug quotes, into esc; 0 when c prints as
# itself.
fn fmt_escape(c: u8, esc: *u8) -> i64
    if c == 34 or c == 92       # '"' '\\'
        *esc = 92
        *(esc + 1) = c
        return 2
    if c == 10 or c == 9 or c == 13
        *esc = 92
        if c == 10
            *(esc + 1) = 110    # n
        else if c == 9
            *(esc + 1) = 116    # t
        else
            *(esc + 1) = 114    # r
        return 2
    if c < 32 or c > 126
        *esc = 92
        *(esc + 1) = 120        # x
        fmt_u64_radix_into(esc + 2, (c >> 4) as u64, 16, 0)
        fmt_u64_radix_into(esc + 3, (c & 15) as u64, 16, 0)
        return 4
    0

# `"a\"b\n"`: quoted; '"', '\\', \n \t \r escaped, other bytes outside
# ' '..'~' as \xNN. Runs of plain bytes go to the Writer in one write.
pub fn fmt_debug_strview(v: StrView, w: @&Writer) -> i64
    var total: i64 = w.write_byte(34)
    if total < 0
        return total
    var esc: [4]u8
    var run: i64 = 0
    var i: i64 = 0
    while i <= v.len
        var n: i64 = 0
        if i < v.len
            n = fmt_escape(*(v.ptr + i), @esc[0] as *u8)
        if n > 0 or i == v.len
            if i > run
                let a: i64 = w.write(v.ptr + run, i - run)
                if a < 0
                    return a
                total = total + a
            if n > 0
                let b: i64 = w.write(@esc[0] as *u8, n)
                if b < 0
                    return b
                total = total + b
            run = i + 1
        i += 1
    let e: i64 = w.write_byte(34)
    if e < 0
        return e
    total + e
