# ritzlib/fmt/writer.ritz - Writer: one byte sink for every formatter
#
# AGAST #201 (#198 Phase 2, docs/V1_ABI_CLEANUP.md "Writer abstraction").
# A Writer is a fn pointer plus the state its sink needs, so Display impls
# and the print builtins can target stdout, stderr, any fd, a String, a
# fixed buffer or nothing, through one call:
#
#     var w = stdout_writer()
#     w.write_str("hello\n")?
#
# write_str / write_byte / write_fill return Result<(), Errno> (AGAST #4930):
# a write that succeeds took every byte, so success has no count to report.
# A full span is NoSpc and a String that can't grow is NoMem, both writing
# nothing; an fd sink retries short writes and returns the kernel's errno (Io
# for a write that made no progress), which may follow a partial write.
# The raw `write(data, len)` the print builtins lower to keeps the count
# protocol: len, or the -errno. `len` counts every byte a sink has accepted,
# so a null_writer measures what would be written.
#
# Writers are short-lived stack values and the sink they name (a String, a
# buffer) must outlive them (V1_ABI_CLEANUP "Implementation-time questions" 4).
#
# A Writer is also a `format_into` sink (LANGUAGE_SPEC §2.6): its
# `push_bytes` method makes `format_into(@&w, "x = {x}\n")` work on any sink.

import ritzlib.sys
import ritzlib.errno
import ritzlib.string

pub struct Writer
    sink: fn(@&Writer, *u8, i64) -> i64   # the sink's write; see the constructors
    state: *u8                            # sink-specific: the String, or the span's bytes
    fd: i32                               # fd sinks: the file descriptor
    cap: i64                              # span sink: the buffer's size
    len: i64                              # bytes accepted so far, every sink

# Methods (S-IMPL-1): a Writer is the subject of every operation on it.
impl Writer
    # format_into's sink (LANGUAGE_SPEC §2.6, AGAST #4555): 0 when every
    # byte was accepted, -1 otherwise. The compiler builds the Span.
    # `write` stays the raw pair the write/writeln builtins lower to.
    # standard-exempt: status-return: LANGUAGE_SPEC §2.6 sink protocol: format_into's lowering calls push_bytes and ignores its i32
    pub fn push_bytes(self: @&Writer, data: Span<u8>) -> i32
        if self.write(data.ptr, data.len) == data.len
            return 0
        -1

    # Write len bytes from data. Returns len, or the -errno on error. The
    # `write`/`writeln` builtins lower to this exact (data, len) signature.
    # standard-exempt: ptr-len-param: compiler ABI: `write`/`writeln` lower to this exact signature
# standard-exempt: raw-ptr-param: compiler ABI: the write/writeln builtins lower to this signature
    pub fn write(self: @&Writer, data: *u8, len: i64) -> i64
        if len <= 0
            return 0
        let n: i64 = (self.sink)(self, data, len)
        if n > 0
            self.len = self.len + n
        n

    # Every byte of s, or the sink's error.
    pub fn write_str(self: @&Writer, s: StrView) -> Result<(), Errno>
        errno_check(self.write(s.ptr, s.len))

    pub fn write_byte(self: @&Writer, b: u8) -> Result<(), Errno>
        var one: [1]u8
        one[0] = b
        errno_check(self.write(@one[0] as *u8, 1))

    # `b` written n times (padding). Stops at the first error, which may
    # leave a prefix of the padding written.
    pub fn write_fill(self: @&Writer, b: u8, n: i64) -> Result<(), Errno>
        var chunk: [32]u8
        var i: i64 = 0
        while i < 32
            chunk[i] = b
            i += 1
        var left: i64 = n
        while left > 0
            var step: i64 = left
            if step > 32
                step = 32
            errno_check(self.write(@chunk[0] as *u8, step))?
            left = left - step
        Ok(())

    # Bytes accepted so far.
    pub fn len(self: @Writer) -> i64
        self.len

# ============================================================================
# Sinks: each returns len, or the -errno
# ============================================================================

# Write all len bytes to w.fd, retrying short writes.
fn fd_sink(w: @&Writer, data: *u8, len: i64) -> i64
    var done: i64 = 0
    while done < len
        let n: i64 = sys_write(w.fd, data + done, len - done)
        if n < 0
            return n
        if n == 0
            return -5     # -EIO: the fd accepted nothing
        done = done + n
    done

fn string_sink(w: @&Writer, data: *u8, len: i64) -> i64
    let s: *String = w.state as *String
    if not s.push_span(Span<u8> { ptr: (data), len: (len) as i64 })
        return -12        # -ENOMEM: the String couldn't grow
    len

# All or nothing: a write that doesn't fit is -ENOSPC and leaves the buffer as it was.
fn span_sink(w: @&Writer, data: *u8, len: i64) -> i64
    if len > w.cap - w.len
        return -28        # -ENOSPC
    var i: i64 = 0
    while i < len
        *(w.state + w.len + i) = *(data + i)
        i += 1
    len

fn null_sink(w: @&Writer, data: *u8, len: i64) -> i64
    len

pub fn fd_writer(fd: i32) -> Writer
    Writer { sink: fd_sink, state: null, fd: fd, cap: 0, len: 0 }

pub fn stdout_writer() -> Writer
    fd_writer(1)

pub fn stderr_writer() -> Writer
    fd_writer(2)

# Appends to *s.
pub fn string_writer(s: @&String) -> Writer
    Writer { sink: string_sink, state: s as *u8, fd: -1, cap: 0, len: 0 }

# Fills buf from its start; writer_view is what has been written.
pub fn span_writer(buf: Span<u8>) -> Writer
    Writer { sink: span_sink, state: buf.ptr, fd: -1, cap: buf.len, len: 0 }

# Accepts and discards everything; writer_len measures the output.
pub fn null_writer() -> Writer
    Writer { sink: null_sink, state: null, fd: -1, cap: 0, len: 0 }

# What a span_writer has written so far.
impl Writer
    pub fn view(self: @Writer) -> StrView
        StrView { ptr: self.state, len: self.len }
