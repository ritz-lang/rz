# ritzlib/fmt/digits.ritz - the one integer-to-text digit routine
#
# Moved from ritzlib/fmt.ritz by AGAST #201: `ritzlib.fmt` is now the hosted
# formatting surface (Writer, Display), and this file stays core, importable
# by freestanding code (tools/ritzlib_layers.py).
#
# Every ritzlib integer formatter (print_int, eprint_int, print_hex, itoa,
# string_push_i64, string_from_hex, iovec_append_int/uint, testlib's pid
# suffix, ritzlib.fmt.impls) writes its digits through these functions. Add
# a formatter by calling them, not by writing another `% 10` loop: AGAST
# #1856 found seven copies, and four printed only "-" for i64's minimum
# because `0 - n` wraps.
#
# Each writes into a caller buffer, returns the byte count, and writes no
# NUL. Sizes: fmt_i64_into needs 20 bytes, fmt_u64_into 20, fmt_u64_hex_into
# 16, fmt_u64_radix_into 64 (base 2). No imports, so any module (and
# freestanding code) can use it.

# Decimal digits of n into buf. Returns the count (1..20).
# standard-exempt: ptr-len-param: false positive: `n` is the integer being formatted, not a buffer length
# standard-exempt: raw-ptr-param: format buffer sink: caller sizes buf for the documented 20 bytes
pub fn fmt_u64_into(buf: *u8, n: u64) -> i64
    # Count digits first so they can be written in place, most significant
    # first, with no temporary buffer.
    var len: i64 = 1
    var t: u64 = n / 10
    while t != 0
        len += 1
        t = t / 10

    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        *(buf + i) = ((v % 10) + 48) as u8  # '0' + digit
        v = v / 10
        i -= 1
    len

# n in decimal, with a leading '-' when negative. Returns the count (1..20).
# standard-exempt: ptr-len-param: false positive: `n` is the integer being formatted, not a buffer length
# standard-exempt: raw-ptr-param: format buffer sink: caller sizes buf for the documented 20 bytes
pub fn fmt_i64_into(buf: *u8, n: i64) -> i64
    if n < 0
        *buf = 45  # '-'
        # Negate in u64: 0 - n wraps for i64's minimum in i64, but its
        # magnitude 2^63 is representable as a u64.
        let bits: u64 = n as u64
        let mag: u64 = 0 -% bits
        return 1 + fmt_u64_into(buf + 1, mag)
    fmt_u64_into(buf, n as u64)

# Lowercase hex digits of n into buf, no "0x" prefix, no leading zeros
# ("0" for zero). Returns the count (1..16).
# standard-exempt: ptr-len-param: false positive: `n` is the integer being formatted, not a buffer length
# standard-exempt: raw-ptr-param: format buffer sink: caller sizes buf for the documented 16 bytes
pub fn fmt_u64_hex_into(buf: *u8, n: u64) -> i64
    var len: i64 = 1
    var t: u64 = n / 16
    while t != 0
        len += 1
        t = t / 16

    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        let digit: u64 = v % 16
        if digit < 10
            *(buf + i) = (digit + 48) as u8  # '0'..'9'
        else
            *(buf + i) = (digit + 87) as u8  # 'a'..'f' (97 - 10)
        v = v / 16
        i -= 1
    len

# Digits of n in base `radix` (2..16) into buf, no prefix, no leading zeros
# ("0" for zero). `upper` gives 'A'..'F' above 9. Returns the count
# (1..64). Covers the {x:x} / {x:X} / {x:b} / {x:o} format specs.
# standard-exempt: ptr-len-param: false positive: `n` is the integer being formatted, not a buffer length
# standard-exempt: raw-ptr-param: format buffer sink: caller sizes buf for the documented 64 bytes
pub fn fmt_u64_radix_into(buf: *u8, n: u64, radix: u64, upper: bool) -> i64
    var len: i64 = 1
    var t: u64 = n / radix
    while t != 0
        len += 1
        t = t / radix

    var letter: u64 = 87   # 'a' - 10
    if upper
        letter = 55        # 'A' - 10
    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        let digit: u64 = v % radix
        if digit < 10
            *(buf + i) = (digit + 48) as u8
        else
            *(buf + i) = (digit + letter) as u8
        v = v / radix
        i -= 1
    len
