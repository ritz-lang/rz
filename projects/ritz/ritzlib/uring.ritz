    # standard-exempt: raw-ptr-param: io_uring SQE ABI: connect addr register
    # Prepare a connect SQE (socket connect)
    pub fn prep_connect(self: *IoUringSqe, fd: i32, addr: *u8, addrlen: i32, user_data: i64)
        self.opcode = IORING_OP_CONNECT
        self.flags = 0
        self.ioprio = 0
