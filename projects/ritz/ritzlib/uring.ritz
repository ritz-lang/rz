    # standard-exempt: raw-ptr-param: io_uring SQE ABI: iovec register
    # Prepare a readv SQE (scatter read)
    pub fn prep_readv(self: *IoUringSqe, fd: i32, iov: *u8, nr_vecs: i32, offset: i64, user_data: i64)
        self.opcode = IORING_OP_READV
        self.flags = 0
        self.ioprio = 0
        self.fd = fd
        self.off = offset
        self.addr = iov as i64
        self.len = nr_vecs
        self.rw_flags = 0
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # standard-exempt: raw-ptr-param: io_uring SQE ABI: iovec register
    # Prepare a writev SQE (gather write)
    pub fn prep_writev(self: *IoUringSqe, fd: i32, iov: *u8, nr_vecs: i32, offset: i64, user_data: i64)
        self.opcode = IORING_OP_WRITEV
        self.flags = 0
        self.ioprio = 0
        self.fd = fd
        self.off = offset
        self.addr = iov as i64
        self.len = nr_vecs
        self.rw_flags = 0
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # standard-exempt: raw-ptr-param: io_uring SQE ABI: accept addr registers
    # Prepare a multishot accept SQE
    # Only needs to be submitted once - generates continuous CQEs for new connections
    # Check IORING_CQE_F_MORE flag to know if multishot is still active
    pub fn prep_accept_multishot(self: *IoUringSqe, fd: i32, addr: *u8, addrlen: *i32, flags: i32, user_data: i64)
        self.opcode = IORING_OP_ACCEPT
        self.flags = 0
        self.ioprio = IORING_ACCEPT_MULTISHOT as u16  # IOPRIO field holds accept flags
        self.fd = fd
        self.off = addrlen as i64  # addr2 in union
        self.addr = addr as i64
        self.len = 0
        self.rw_flags = flags
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # standard-exempt: raw-ptr-param: io_uring SQE ABI: timespec register
    # Prepare a timeout SQE
    # ts: pointer to KernelTimespec with timeout duration
    # count: number of completions to wait for (0 = just timeout)
    # flags: IORING_TIMEOUT_* flags (usually 0)
    # standard-exempt: ptr-len-param: io_uring ABI: the SQE timespec and count fields
    pub fn prep_timeout(self: *IoUringSqe, ts: *KernelTimespec, count: u32, flags: u32, user_data: i64)
        self.opcode = IORING_OP_TIMEOUT
        self.flags = 0
        self.ioprio = 0
        self.fd = -1
        self.off = count as i64
        self.addr = ts as i64
        self.len = 1  # nr_args
        self.rw_flags = flags as i32
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # Prepare a NOP SQE — generates an immediate CQE without doing any work.
    # Used as a cooperative-yield primitive when richer wake mechanisms
    # (TIMEOUT, FUTEX_WAIT) aren't available on the running kernel.
    pub fn prep_nop(self: *IoUringSqe, user_data: i64)
        self.opcode = IORING_OP_NOP
        self.flags = 0
        self.ioprio = 0
        self.fd = -1
        self.off = 0
        self.addr = 0
        self.len = 0
        self.rw_flags = 0
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # standard-exempt: raw-ptr-param: io_uring SQE ABI: buffer and length registers
    # Prepare a zero-copy send SQE
    # fd: socket file descriptor
    # buf: pointer to data buffer (MUST remain valid until CQE!)
    # len: number of bytes to send
    # flags: MSG_* flags (usually 0)
    # user_data: completion identifier
    # standard-exempt: ptr-len-param: io_uring ABI: the SQE buffer and length fields
    pub fn prep_send_zc(self: *IoUringSqe, fd: i32, buf: *u8, len: u64, flags: i32, user_data: i64)
        self.opcode = IORING_OP_SEND_ZC
        self.flags = 0
        self.ioprio = 0
        self.fd = fd
        self.off = 0
        self.addr = buf as i64
        self.len = len as i32
        self.rw_flags = flags  # MSG_* flags
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # standard-exempt: raw-ptr-param: io_uring SQE ABI: buffer and length registers
    # Prepare a zero-copy send with notification request
    # When IORING_SEND_ZC_REPORT_USAGE is set, the kernel reports whether
    # zero-copy was actually used via the IORING_CQE_F_NOTIF flag in the CQE.
    # standard-exempt: ptr-len-param: io_uring ABI: the SQE buffer and length fields
    pub fn prep_send_zc_report(self: *IoUringSqe, fd: i32, buf: *u8, len: u64, flags: i32, user_data: i64)
        self.opcode = IORING_OP_SEND_ZC
        self.flags = 0
        self.ioprio = IORING_SEND_ZC_REPORT_USAGE
        self.fd = fd
        self.off = 0
        self.addr = buf as i64
        self.len = len as i32
        self.rw_flags = flags
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = 0
        self.pad1 = 0
        self.pad2 = 0

    # Prepare a splice SQE
    # fd_out: output file descriptor (e.g., socket)
    # off_out: output offset (-1 for non-seekable like sockets)
    # fd_in: input file descriptor (stored in splice_fd_in field)
    # off_in: input offset (stored in addr as union with splice_off_in)
    # len: number of bytes to transfer
    # splice_flags: SPLICE_F_* flags
    # user_data: completion identifier
    pub fn prep_splice(self: *IoUringSqe, fd_out: i32, off_out: i64, fd_in: i32, off_in: i64, len: u32, splice_flags: i32, user_data: i64)
        self.opcode = IORING_OP_SPLICE
        self.flags = 0
        self.ioprio = 0
        self.fd = fd_out              # Output fd
        self.off = off_out            # Output offset (-1 for sockets)
        self.addr = off_in            # Input offset (splice_off_in union)
        self.len = len as i32
        self.rw_flags = splice_flags  # SPLICE_F_* flags
        self.user_data = user_data
        self.buf_index = 0
        self.personality = 0
        self.splice_fd_in = fd_in     # Input fd
        self.pad1 = 0
        self.pad2 = 0

impl IoUringCqe
    # Get user_data from a CQE
    pub fn get_data64(self: *IoUringCqe) -> i64
        return self.user_data
