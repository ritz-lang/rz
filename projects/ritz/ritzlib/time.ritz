# ritzlib/time.ritz - Duration, sleep(Duration) and the wall clock
#
# (AGAST #4637) The typed layer over nanosleep(2) and gettimeofday(2), so a
# program never builds a timespec array by hand:
#
#     sleep(duration_ms(250))
#     sleep_ms(10)
#     let tv: Timeval = now()             # tv.tv_sec, tv.tv_usec
#
# For elapsed-time measurement use ritzlib.timer's monotonic clock
# (now_nanos, Timer): the wall clock here can jump.

import ritzlib.sys

const TIME_EINTR: i32 = 4
const TIME_NANOS_PER_SEC: i64 = 1000000000

# A span of time, in nanoseconds (about 292 years either way).
pub struct Duration
    nanos: i64

pub fn duration_ns(n: i64) -> Duration
    Duration { nanos: n }

pub fn duration_us(n: i64) -> Duration
    Duration { nanos: n * 1000 }

pub fn duration_ms(n: i64) -> Duration
    Duration { nanos: n * 1000000 }

pub fn duration_secs(n: i64) -> Duration
    Duration { nanos: n * TIME_NANOS_PER_SEC }

# Methods (S-IMPL-1): a Duration is the subject of every operation on it.
# Each conversion truncates toward zero.
impl Duration
    pub fn as_nanos(self: Duration) -> i64
        self.nanos

    pub fn as_micros(self: Duration) -> i64
        self.nanos / 1000

    pub fn as_millis(self: Duration) -> i64
        self.nanos / 1000000

    pub fn as_secs(self: Duration) -> i64
        self.nanos / TIME_NANOS_PER_SEC

# standard-exempt: free-fn-method: sleep is the verb and `d` its argument; d.sleep() would read as the Duration sleeping
# Block this thread for at least `d`. A signal does not cut it short: the
# remaining time is slept again. A zero or negative Duration returns at once.
pub fn sleep(d: Duration)
    if d.nanos <= 0
        return
    var req: [2]i64
    var rem: [2]i64
    req[0] = d.nanos / TIME_NANOS_PER_SEC
    req[1] = d.nanos % TIME_NANOS_PER_SEC
    while sys_nanosleep(@req[0], @rem[0]) == -TIME_EINTR
        req[0] = rem[0]
        req[1] = rem[1]

# sleep(duration_ms(ms)).
pub fn sleep_ms(ms: i64)
    sleep(duration_ms(ms))

# The wall-clock time now: seconds and microseconds since the Unix epoch.
pub fn now() -> Timeval
    var tv: Timeval
    tv.tv_sec = 0
    tv.tv_usec = 0
    sys_gettimeofday(@tv, null)
    tv

# now() in milliseconds since the Unix epoch.
pub fn now_unix_ms() -> i64
    let tv: Timeval = now()
    tv.tv_sec * 1000 + tv.tv_usec / 1000
