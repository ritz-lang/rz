# ritzlib/errno.ritz - `Errno`, a typed kernel error code (AGAST #4248)
#
# The Err payload of ritzlib's fallible syscall wrappers (ritzlib.fs, #4248;
# ritzlib.net and ritzlib.process, #4298). One variant per errno those
# wrappers actually return, numbered as on Linux x86_64, plus `Other(n)` so a
# code without a variant keeps its number instead of being lost.
#
#     match read_file(path)
#         Ok(s) => ...
#         Err(e) => match e
#             NoEnt => ...                   # a missing file is fine here
#             _ =>
#                 eprint("cannot read: ")
#                 errno_write(2, e)          # "Permission denied", ...
#
# (A nested pattern, `Err(NoEnt)`, binds a local named NoEnt: match twice.)
#
# The variant names follow harland's kernel `Errno` (syscall/errno.ritz) and
# deliberately differ from ritzlib.sys's `ENOENT`/`EACCES`/... i32 consts,
# which stay the raw numbers: `e.code() == ENOENT` compares the two.
#
# `Errno` carries data (`Other`), so `e as i32` is an error: use `e.code()`.

import ritzlib.sys
import ritzlib.strview
import ritzlib.fmt.digits { fmt_i64_into }

pub enum Errno
    Perm            # EPERM 1: operation not permitted
    NoEnt           # ENOENT 2: no such file or directory
    Intr            # EINTR 4: interrupted system call
    Io              # EIO 5: input/output error
    BadF            # EBADF 9: bad file descriptor
    Child           # ECHILD 10: no child processes
    Again           # EAGAIN 11: resource temporarily unavailable
    NoMem           # ENOMEM 12: cannot allocate memory
    Acces           # EACCES 13: permission denied
    Exist           # EEXIST 17: file exists
    NotDir          # ENOTDIR 20: not a directory
    IsDir           # EISDIR 21: is a directory
    Inval           # EINVAL 22: invalid argument
    NoSpc           # ENOSPC 28: no space left on device
    Pipe            # EPIPE 32: broken pipe
    NameTooLong     # ENAMETOOLONG 36: file name too long
    NotEmpty        # ENOTEMPTY 39: directory not empty
    AddrInUse       # EADDRINUSE 98: address already in use
    ConnReset       # ECONNRESET 104: connection reset by peer
    TimedOut        # ETIMEDOUT 110: connection timed out
    ConnRefused     # ECONNREFUSED 111: connection refused
    Other(i32)      # any other errno, by its positive number

# The Errno for kernel error number `code`. Either sign is accepted, so a raw
# syscall return (-errno) converts directly: errno_from_raw(-2) is NoEnt.
pub fn errno_from_raw(code: i32) -> Errno
    var n: i32 = code
    if n < 0
        n = -n
    match n
        1 => Errno.Perm
        2 => Errno.NoEnt
        4 => Errno.Intr
        5 => Errno.Io
        9 => Errno.BadF
        10 => Errno.Child
        11 => Errno.Again
        12 => Errno.NoMem
        13 => Errno.Acces
        17 => Errno.Exist
        20 => Errno.NotDir
        21 => Errno.IsDir
        22 => Errno.Inval
        28 => Errno.NoSpc
        32 => Errno.Pipe
        36 => Errno.NameTooLong
        39 => Errno.NotEmpty
        98 => Errno.AddrInUse
        104 => Errno.ConnReset
        110 => Errno.TimedOut
        111 => Errno.ConnRefused
        _ => Errno.Other(n)

# Methods (S-IMPL-1): an Errno is the subject of every operation on it.
impl Errno
    # The positive kernel error number (NoEnt -> 2; Other(n) -> n).
    pub fn code(self: Errno) -> i32
        match self
            Perm => 1
            NoEnt => 2
            Intr => 4
            Io => 5
            BadF => 9
            Child => 10
            Again => 11
            NoMem => 12
            Acces => 13
            Exist => 17
            NotDir => 20
            IsDir => 21
            Inval => 22
            NoSpc => 28
            Pipe => 32
            NameTooLong => 36
            NotEmpty => 39
            AddrInUse => 98
            ConnReset => 104
            TimedOut => 110
            ConnRefused => 111
            Other(n) => n

    # The symbolic name ("ENOENT"); "EUNKNOWN" for Other (code has its number).
    pub fn name(self: Errno) -> StrView
        match self
            Perm => "EPERM"
            NoEnt => "ENOENT"
            Intr => "EINTR"
            Io => "EIO"
            BadF => "EBADF"
            Child => "ECHILD"
            Again => "EAGAIN"
            NoMem => "ENOMEM"
            Acces => "EACCES"
            Exist => "EEXIST"
            NotDir => "ENOTDIR"
            IsDir => "EISDIR"
            Inval => "EINVAL"
            NoSpc => "ENOSPC"
            Pipe => "EPIPE"
            NameTooLong => "ENAMETOOLONG"
            NotEmpty => "ENOTEMPTY"
            AddrInUse => "EADDRINUSE"
            ConnReset => "ECONNRESET"
            TimedOut => "ETIMEDOUT"
            ConnRefused => "ECONNREFUSED"
            Other(_) => "EUNKNOWN"

    # The message strerror(3) gives ("No such file or directory"); "Unknown error"
    # for Other, which errno_write completes with the number.
    pub fn message(self: Errno) -> StrView
        match self
            Perm => "Operation not permitted"
            NoEnt => "No such file or directory"
            Intr => "Interrupted system call"
            Io => "Input/output error"
            BadF => "Bad file descriptor"
            Child => "No child processes"
            Again => "Resource temporarily unavailable"
            NoMem => "Cannot allocate memory"
            Acces => "Permission denied"
            Exist => "File exists"
            NotDir => "Not a directory"
            IsDir => "Is a directory"
            Inval => "Invalid argument"
            NoSpc => "No space left on device"
            Pipe => "Broken pipe"
            NameTooLong => "File name too long"
            NotEmpty => "Directory not empty"
            AddrInUse => "Address already in use"
            ConnReset => "Connection reset by peer"
            TimedOut => "Connection timed out"
            ConnRefused => "Connection refused"
            Other(_) => "Unknown error"

# Write strerror(3)'s text for `e` to `fd`, with no newline: the message, or
# "Unknown error <n>" for Other(n) (glibc's wording). Returns bytes written.
pub fn errno_write(fd: i32, e: Errno) -> i64
    let msg: StrView = e.message()
    var buf: [96]u8
    var len: i64 = 0
    for i in 0..msg.len
        buf[len] = *(msg.ptr + i)
        len += 1
    match e
        Other(n) =>
            buf[len] = ' '
            len += 1
            var num: [20]u8
            let digits: StrView = fmt_i64_into(@num, n as i64)
            for i in 0..digits.len
                buf[len] = *(digits.ptr + i)
                len += 1
        _ => pass
    sys_write(fd, @buf[0], len)
