# ritzlib/os/env.ritz - Environment variable access (Ritz-native)
#
# Replaces the C-shaped `ritzlib.env` (which required passing `envp: **u8`
# everywhere) with typed accessors that work from any function in the program,
# regardless of the user's `main` signature.
#
# The first call builds a `Span<StrView>` of "KEY=VALUE" entries and caches
# it for the lifetime of the process.  The entries come from the envp the
# kernel handed `_start`, which every `_start` stores in `__ritz_envp`
# (AGAST #3737).  Only when that is null (a `_start` that doesn't set it, or
# Harland, which passes none) is /proc/self/environ read instead: a process
# that isn't dumpable (prctl(PR_SET_DUMPABLE, 0), a setuid/setgid exec) may
# not open that file, and used to see an empty environment.
#
# Usage:
#   import ritzlib.os.env
#
#   pub fn main() -> i32
#       let port: StrView = env_get_or("PORT", "8080")
#       let debug: Option<StrView> = env_get("DEBUG")
#       0
#
# A get-or-die helper (`env_must`) deliberately does NOT live here: S-ERR-3
# says a library returns its failure, so the program that wants to exit 1
# defines that helper on top of env_get (see examples/.../41_osenv).
#
# Notes:
#   - All keys/values are `StrView` (zero-copy view into the cached buffer).
#   - The cached environ is loaded once and never refreshed — Ritz programs
#     are not expected to setenv() at runtime. (If they do, the new bytes
#     won't be visible through this API.)
#   - On Harland, with no envp and no /proc/self/environ, lookups return None.
#   - There is no raw `**u8` envp accessor: to run a child with this
#     environment, use ritzlib.process (spawn, or exec_prepare + run after a
#     fork), which builds execve(2)'s arrays from env_iter (AGAST #4648).

import ritzlib.cstr
import ritzlib.sys
import ritzlib.span
import ritzlib.strview
import ritzlib.memory
import ritzlib.option
import ritzlib.io
import ritzlib.str

const INITIAL_BUF: i64 = 4096

# ============================================================================
# Module-private cache
# ============================================================================

struct EnvCache
    initialized: i32
    raw: *u8           # owned buffer holding /proc/self/environ contents
    raw_len: i64
    entries: Span<StrView>   # NUL-separated views into `raw`

var g_env: EnvCache

# The kernel's envp, stored by `_start` (ritz0's, ritz1's test-mode one, and
# every runtime/*.ll shim); null if no `_start` set it.  Those define it weak,
# so this definition and theirs are one storage once linked, and it exists
# even in a binary whose `_start` predates it.
pub var __ritz_envp: **u8 = null

# ============================================================================
# Lazy load: EnvCache is the owning type (S-OWN-2)
# ============================================================================
# Every allocation below belongs to g_env: the /proc/self/environ buffer, the
# StrView array that indexes it (or the start envp).
# They live for the whole process and are never freed, so these methods are
# the type's constructor and growth functions rather than a Drop.

impl EnvCache
    # Build the cache from the kernel envp or /proc/self/environ, once.
    fn load(self: @&EnvCache) -> bool
        if self.initialized == 1
            return true

        if __ritz_envp != null
            self.raw = null
            self.raw_len = 0
            self.set_entries_from_envp(__ritz_envp)
            self.initialized = 1
            return true

        let fd: i32 = sys_open(c"/proc/self/environ", 0)   # O_RDONLY
        if fd < 0
            # No /proc/self/environ — Harland or sandboxed. Cache empty.
            self.raw = null
            self.raw_len = 0
            self.entries = span_empty<StrView>()
            self.initialized = 1
            return true

        # Read until EOF, growing the buffer as needed.
        var cap: i64 = INITIAL_BUF
        var buf: *u8 = malloc(cap)
        var len: i64 = 0
        if buf == null
            sys_close(fd)
            return false

        loop
            let space: i64 = cap - len
            if space < 256
                let new_cap: i64 = cap * 2
                let new_buf: *u8 = malloc(new_cap)
                if new_buf == null
                    free(buf)
                    sys_close(fd)
                    return false
                memcpy(new_buf, buf, len)
                free(buf)
                buf = new_buf
                cap = new_cap

            let n: i64 = sys_read(fd, buf + len, cap - len)
            if n <= 0
                break
            len = len + n

        sys_close(fd)

        self.raw = buf
        self.raw_len = len
        self.set_entries_from_raw(Span<u8> { ptr: buf, len: len })
        self.initialized = 1
        return true

    # One StrView per "KEY=VALUE" string of a NULL-terminated envp.  The views
    # point at the strings themselves, each NUL-terminated just past its view.
# standard-exempt: raw-ptr-param: execve(2) envp ABI: a NULL-terminated vector of C strings
    fn set_entries_from_envp(self: @&EnvCache, envp: **u8)
        var count: i64 = 0
        while *(envp + count) != null
            count = count + 1
        if count == 0
            self.entries = span_empty<StrView>()
            return
        let arr_buf: *u8 = malloc(count * 16)   # sizeof(StrView)
        if arr_buf == null
            self.entries = span_empty<StrView>()
            return
        let arr: *StrView = arr_buf as *StrView
        var i: i64 = 0
        while i < count
            var view: StrView
            view.ptr = *(envp + i)
            view.len = strlen(view.ptr)
            *(arr + i) = view
            i = i + 1
        self.entries = span_from_ptr<StrView>(arr, count)

    # Parse a NUL-separated buffer into self.entries, one StrView per entry.
    fn set_entries_from_raw(self: @&EnvCache, buf_sv: Span<u8>)
        let buf: *u8 = buf_sv.ptr
        let len: i64 = buf_sv.len
        if buf == null or len <= 0
            self.entries = span_empty<StrView>()
            return

        # First pass — count entries (each NUL terminates one entry).
        var count: i64 = 0
        var i: i64 = 0
        while i < len
            if *(buf + i) == 0
                count = count + 1
            i = i + 1

        if count == 0
            self.entries = span_empty<StrView>()
            return

        let bytes: i64 = count * 16   # sizeof(StrView)
        let arr_buf: *u8 = malloc(bytes)
        if arr_buf == null
            self.entries = span_empty<StrView>()
            return
        let arr: *StrView = arr_buf as *StrView

        # Second pass — slice into views.
        var idx: i64 = 0
        var start: i64 = 0
        i = 0
        while i < len
            if *(buf + i) == 0
                var view: StrView
                view.ptr = buf + start
                view.len = i - start
                *(arr + idx) = view
                idx = idx + 1
                start = i + 1
            i = i + 1

        self.entries = span_from_ptr<StrView>(arr, count)

# ============================================================================
# Internal: scan a "KEY=VALUE" StrView for the value matching `name`
# ============================================================================

fn entry_matches(entry: StrView, name: StrView) -> i32
    if entry.len < name.len + 1
        return 0
    var i: i64 = 0
    while i < name.len
        if *(entry.ptr + i) != *(name.ptr + i)
            return 0
        i = i + 1
    if *(entry.ptr + name.len) != '='
        return 0
    return 1

fn entry_value(entry: StrView, name: StrView) -> StrView
    var v: StrView
    v.ptr = entry.ptr + name.len + 1
    v.len = entry.len - name.len - 1
    return v

# ============================================================================
# Public API
# ============================================================================

# Look up an environment variable. Returns None if not set.
pub fn env_get(name: StrView) -> Option<StrView>
    g_env.load()
    var i: i64 = 0
    let n: i64 = g_env.entries.len
    while i < n
        let e: StrView = *(g_env.entries.ptr + i)
        if entry_matches(e, name) != 0
            return Some(entry_value(e, name))
        i = i + 1
    return None

# env_get for a caller holding an @StrView. Kept as the reference form on
# purpose (#2414): by value it would just be env_get, and removing it is an
# API change for another ticket. A `*StrView` value still fits `@StrView`.
pub fn env_get_p(name: @StrView) -> Option<StrView>
    return env_get(*name)

# Look up an environment variable, returning `default` if not set.
pub fn env_get_or(name: StrView, default: StrView) -> StrView
    let v: Option<StrView> = env_get(name)
    match v
        Some(s) => s
        None => default

# Iterate all environment entries as Span<StrView> of "KEY=VALUE".
pub fn env_iter() -> Span<StrView>
    g_env.load()
    return g_env.entries
