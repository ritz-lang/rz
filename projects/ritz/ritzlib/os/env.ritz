# ritzlib/os/env.ritz - Environment variable access (Ritz-native)
#
# Replaces the C-shaped `ritzlib.env` (which required passing `envp: **u8`
# everywhere) with typed accessors that work from any function in the program,
# regardless of the user's `main` signature.
#
# The first call lazily reads /proc/self/environ via sys_read into a heap
# buffer, parses it into a `Span<StrView>` of "KEY=VALUE" entries, and caches
# the result for the lifetime of the process.
#
# Usage:
#   import ritzlib.os.env
#
#   pub fn main() -> i32
#       let port: StrView = env_get_or(s"PORT", s"8080")
#       let debug: Option<StrView> = env_get(s"DEBUG")
#       let home: StrView = env_must(s"HOME")            # exits 1 if missing
#       0
#
# Notes:
#   - All keys/values are `StrView` (zero-copy view into the cached buffer).
#   - The cached environ is loaded once and never refreshed — Ritz programs
#     are not expected to setenv() at runtime. (If they do, the new bytes
#     won't be visible through this API.)
#   - On Harland, /proc/self/environ doesn't exist; lookups return None.

import ritzlib.sys
import ritzlib.span
import ritzlib.strview
import ritzlib.memory
import ritzlib.option
import ritzlib.io

const INITIAL_BUF: i64 = 4096

# ============================================================================
# Module-private cache
# ============================================================================

struct EnvCache
    initialized: i32
    raw: *u8           # owned buffer holding /proc/self/environ contents
    raw_len: i64
    entries: Span<StrView>   # NUL-separated views into `raw`

var g_env: EnvCache

# ============================================================================
# Lazy load
# ============================================================================

fn env_load() -> i32
    if g_env.initialized == 1
        return 0

    let fd: i32 = sys_open(c"/proc/self/environ", 0)   # O_RDONLY
    if fd < 0
        # No /proc/self/environ — Harland or sandboxed. Cache empty.
        g_env.raw = null
        g_env.raw_len = 0
        g_env.entries = span_empty<StrView>()
        g_env.initialized = 1
        return 0

    # Read until EOF, growing the buffer as needed.
    var cap: i64 = INITIAL_BUF
    var buf: *u8 = malloc(cap)
    var len: i64 = 0
    if buf == null
        sys_close(fd)
        return -1

    loop
        let space: i64 = cap - len
        if space < 256
            let new_cap: i64 = cap * 2
            let new_buf: *u8 = malloc(new_cap)
            if new_buf == null
                free(buf)
                sys_close(fd)
                return -1
            memcpy(new_buf, buf, len)
            free(buf)
            buf = new_buf
            cap = new_cap

        let n: i64 = sys_read(fd, buf + len, cap - len)
        if n <= 0
            break
        len = len + n

    sys_close(fd)

    g_env.raw = buf
    g_env.raw_len = len
    g_env.entries = parse_environ(buf, len)
    g_env.initialized = 1
    return 0

# Parse a NUL-separated buffer into Span<StrView>, one StrView per entry.
fn parse_environ(buf: *u8, len: i64) -> Span<StrView>
    if buf == null or len <= 0
        return span_empty<StrView>()

    # First pass — count entries (each NUL terminates one entry).
    var count: i64 = 0
    var i: i64 = 0
    while i < len
        if *(buf + i) == 0
            count = count + 1
        i = i + 1

    if count == 0
        return span_empty<StrView>()

    let bytes: i64 = count * 16   # sizeof(StrView)
    let arr_buf: *u8 = malloc(bytes)
    if arr_buf == null
        return span_empty<StrView>()
    let arr: *StrView = arr_buf as *StrView

    # Second pass — slice into views.
    var idx: i64 = 0
    var start: i64 = 0
    i = 0
    while i < len
        if *(buf + i) == 0
            var view: StrView
            view.ptr = buf + start
            view.len = i - start
            *(arr + idx) = view
            idx = idx + 1
            start = i + 1
        i = i + 1

    return span_from_ptr<StrView>(arr, count)

# ============================================================================
# Internal: scan a "KEY=VALUE" StrView for the value matching `name`
# ============================================================================

fn entry_matches(entry: *StrView, name: *StrView) -> i32
    if entry.len < name.len + 1
        return 0
    var i: i64 = 0
    while i < name.len
        if *(entry.ptr + i) != *(name.ptr + i)
            return 0
        i = i + 1
    if *(entry.ptr + name.len) != '='
        return 0
    return 1

fn entry_value(entry: *StrView, name: *StrView) -> StrView
    var v: StrView
    v.ptr = entry.ptr + name.len + 1
    v.len = entry.len - name.len - 1
    return v

# ============================================================================
# Public API
# ============================================================================

# Look up an environment variable. Returns None if not set.
pub fn env_get(name: StrView) -> Option<StrView>
    env_load()
    var i: i64 = 0
    let n: i64 = g_env.entries.len
    while i < n
        let e: *StrView = g_env.entries.ptr + i
        if entry_matches(e, @name) != 0
            return Some(entry_value(e, @name))
        i = i + 1
    return None

# Same as env_get but takes the name as a *StrView (avoids the move-of-StrView
# when callers already have a stable handle).
pub fn env_get_p(name: *StrView) -> Option<StrView>
    env_load()
    var i: i64 = 0
    let n: i64 = g_env.entries.len
    while i < n
        let e: *StrView = g_env.entries.ptr + i
        if entry_matches(e, name) != 0
            return Some(entry_value(e, name))
        i = i + 1
    return None

# Look up an environment variable, returning `default` if not set.
pub fn env_get_or(name: StrView, default: StrView) -> StrView
    let v: Option<StrView> = env_get(name)
    match v
        Some(s) => s
        None => default

# Look up an environment variable, exiting 1 with a friendly error if missing.
pub fn env_must(name: StrView) -> StrView
    let v: Option<StrView> = env_get(name)
    match v
        Some(s) => s
        None =>
            eprints_cstr(c"error: required environment variable not set: ")
            eprints(name)
            eprints_cstr(c"\n")
            sys_exit(1)
            # unreachable
            var empty: StrView
            empty.ptr = null
            empty.len = 0
            empty

# Iterate all environment entries as Span<StrView> of "KEY=VALUE".
pub fn env_iter() -> Span<StrView>
    env_load()
    return g_env.entries
