# ritzlib/memory.ritz - Memory allocation infrastructure
#
# Provides allocation primitives for Ritz programs:
# - Arena: Fast bump allocator for batch allocations (reset all at once)
# - Pool: Fixed-size block allocator (TODO)
# - Global process heap with simple allocation/free
#
# Design principles:
# - Arena is the primary allocator for compilers, parsers, etc.
# - Arenas are cheap to create and destroy (single mmap/munmap)
# - No per-allocation tracking needed - just bump the offset
# - Call m.reset() to reuse memory, m.destroy() to free
#
# standard-exempt-file: raw-alloc: ritzlib.memory IS the process allocator; S-OWN-2 sanctions allocator modules
import ritzlib.str  # For memcpy, memset, memcmp

# ritzlib.memory is core (tools/ritzlib_layers.py, AGAST #4119): it builds for
# a freestanding target, so it does not import ritzlib.sys.  The default page
# source is these two platform hooks instead.  A hosted program gets them from
# ritzlib.sys (anonymous mmap); a freestanding one (a kernel) defines both
# itself, e.g. over its frame allocator, or, if it only ever allocates under
# page_source_set, as stubs that return null and -1.
extern fn ritz_platform_page_map(len: i64) -> *u8
extern fn ritz_platform_page_unmap(p: *u8, len: i64) -> i32

# ============================================================================
# Arena Allocator
# ============================================================================
# Fast bump allocator: allocations just increment an offset.
# Memory is freed all at once via reset() or destroy().
# Perfect for compilers (one arena per AST), parsers, etc.

const ARENA_DEFAULT_SIZE: i64 = 1048576  # 1 MB default

# Did sys_mmap fail? Linux returns -errno in [-4095, -1] (e.g. -12 for
# ENOMEM), not just -1 (MAP_FAILED is libc's translation). Comparing against
# -1 alone missed every real failure: arena_new kept base = -12 and malloc
# returned -12 + HEADER_SIZE = 4 (AGAST #1983). Harland returns -errno too
# (-12, -22, -3), cast to *u8, so `== null` misses it. No user mapping is at 0
# or in the negative (kernel) half, so both mean failure (AGAST #3551).
# standard-exempt: raw-ptr-param: allocator: an mmap result register, a *u8 that may hold -errno
pub fn mmap_failed(p: *u8) -> bool
    return p as i64 <= 0

# ============================================================================
# Page source
# ============================================================================
# Every allocator here (Arena, the process heap, malloc's slabs and large
# blocks) gets its memory from one page source and gives it back there. The
# default is the platform hooks above (anonymous mmap on a hosted target); a
# kernel can install its own frame allocator instead, and a test can install
# one that fails (AGAST #1857).
#
#   map(len)       len bytes of zeroed read-write memory, or a value for which
#                  mmap_failed is true (null, or -errno as the kernels return)
#   unmap(p, len)  give back what one map(len) returned; 0 on success
#
# Install a source before the first allocation, or restore the previous one
# before anything allocated under it is freed: memory goes back to whichever
# source is installed when it is released.
pub struct PageSource
    map: fn(i64) -> *u8
    unmap: fn(*u8, i64) -> i32

var g_page_source: PageSource
var g_page_source_installed: bool = false

fn page_unmap_default(p: *u8, len: i64) -> i32
    return ritz_platform_page_unmap(p, len)

fn page_map_default(len: i64) -> *u8
    return ritz_platform_page_map(len)

# The installed page source (the platform hooks until page_source_set).
pub fn page_source_get() -> PageSource
    if g_page_source_installed
        return g_page_source
    return PageSource { map: page_map_default, unmap: page_unmap_default }

fn page_map(len: i64) -> *u8
    if not g_page_source_installed
        return ritz_platform_page_map(len)
    let f: fn(i64) -> *u8 = g_page_source.map
    return f(len)

fn page_unmap(p: *u8, len: i64) -> i32
    if not g_page_source_installed
        return ritz_platform_page_unmap(p, len)
    let f: fn(*u8, i64) -> i32 = g_page_source.unmap
    return f(p, len)

# ============================================================================
# Arena
# ============================================================================

struct Arena
    base: *u8       # Base pointer from the page source
    size: i64       # Total size of arena
    offset: i64     # Current allocation offset (next free byte)

# Create a new arena with the given capacity
pub fn arena_new(size: i64) -> Arena
    var a: Arena
    a.base = page_map(size)
    if mmap_failed(a.base)
        # mmap failed
        a.base = null
        a.size = 0
        a.offset = 0
        return a
    a.size = size
    a.offset = 0
    return a

# Create a new arena with default size (1 MB)
pub fn arena_default() -> Arena
    return arena_new(ARENA_DEFAULT_SIZE)

# ============================================================================
# Process Heap
# ============================================================================
# Simple mmap-based heap for when you need per-allocation free.
# For most use cases, prefer Arena instead.

# Allocate `size` bytes from the process heap
# standard-exempt: null-return: process-heap allocation is the raw allocator boundary: null is out-of-memory
pub fn heap_alloc(size: i64) -> *u8
    if size <= 0
        return null
    let p: *u8 = page_map(size)
    if mmap_failed(p)
        return null
    return p

# Free `size` bytes of heap memory at `ptr`
# standard-exempt: ptr-len-param: allocator: frees an allocation by its original size
# standard-exempt: raw-ptr-param: allocator: frees a raw block by its original size
pub fn heap_free(ptr: *u8, size: i64) -> i32
    if ptr == null or size <= 0
        return 0
    return page_unmap(ptr, size)

# Reallocate memory to a new size
# Note: Requires knowing the old size (limitation of mmap-based approach)
# standard-exempt: null-return: heap reallocation is the raw allocator boundary: null is out-of-memory
# standard-exempt: raw-ptr-param: allocator: reallocation primitive, a raw block in and out
pub fn heap_realloc(ptr: *u8, old_size: i64, new_size: i64) -> *u8
    if new_size <= 0
        if ptr != null and old_size > 0
            heap_free(ptr, old_size)
        return null

    let new_ptr: *u8 = heap_alloc(new_size)
    if new_ptr == null
        return null

    # Copy old data (up to the smaller of old/new size)
    var copy_size: i64 = old_size
    if new_size < old_size
        copy_size = new_size

    var i: i64 = 0
    while i < copy_size
        *(new_ptr + i) = *(ptr + i)
        i += 1

    # Free old memory
    if ptr != null and old_size > 0
        heap_free(ptr, old_size)

    return new_ptr

# ============================================================================
# Memory utilities
# ============================================================================
# Note: memcpy, memset, memcmp are provided by ritzlib.str

# Zero `n` bytes at `dst`. Plain stores: if `dst` is never read again the
# optimiser may delete them. Wiping a secret needs secure_zero.
# standard-exempt: ptr-len-param: raw memory primitive: writes zeros over an arbitrary byte range
# standard-exempt: raw-ptr-param: raw memory primitive: zeroes an arbitrary byte range
pub fn memzero(dst: *u8, n: i64)
    memset(dst, 0, n)

# Zero `n` bytes at `dst` so that the optimiser cannot remove the writes,
# even when nothing reads `dst` again (AGAST #1864). Use it to wipe keys and
# other secrets before their memory goes out of scope or is freed. A plain
# zeroing loop there is a dead store that -O2 or LTO deletes.
#
# Every write is a volatile_store (LANGUAGE_SPEC §18.4), which is never
# removed, merged or invented. Bytes up to the first 8-byte boundary, aligned
# u64 words, then the tail bytes: 2 KB is 256 stores, not 2048. Volatile
# stores are not vectorised, so this is slower than memzero on large buffers.
# standard-exempt: ptr-len-param: raw memory primitive: writes zeros over an arbitrary byte range
# standard-exempt: raw-ptr-param: raw memory primitive: volatile-zeroes an arbitrary byte range
pub fn secure_zero(dst: *u8, n: i64)
    var i: i64 = 0
    while i < n and ((dst as u64 + i as u64) & 7) != 0
        let b: *u8 = dst + i
        volatile_store(b, 0)
        i += 1
    while i + 8 <= n
        let w: *u64 = (dst + i) as *u64
        volatile_store(w, 0)
        i += 8
    while i < n
        let b: *u8 = dst + i
        volatile_store(b, 0)
        i += 1

# ============================================================================
# jemalloc-style Allocator
# ============================================================================
# A proper malloc/free implementation with size classes.
# - No need to track sizes when freeing
# - Size class bins for common sizes (16-2048 bytes)
# - Direct mmap for large allocations (>2048 bytes)
# - Free lists per size class for fast reuse

const NUM_SIZE_CLASSES: i32 = 9
const MEM_PAGE_SIZE: i64 = 4096
const LARGE_THRESHOLD: i64 = 2048
const HEADER_SIZE: i64 = 16  # Block header (size + padding for alignment)

# Size class block sizes (including header)
# Class 0: 32 bytes  (usable: 16)
# Class 1: 48 bytes  (usable: 32)
# Class 2: 80 bytes  (usable: 64)
# Class 3: 144 bytes (usable: 128)
# Class 4: 272 bytes (usable: 256)
# Class 5: 528 bytes (usable: 512)
# Class 6: 1040 bytes (usable: 1024)
# Class 7: 2064 bytes (usable: 2048)
# Class 8+: mmap direct

# Block sizes by class lookup (ritz1 doesn't support const array literals)
# const BLOCK_SIZES: [9]i64 = [32, 48, 80, 144, 272, 528, 1040, 2064, 0]

# Block header stored before each allocation
# For size-class: stores class index (0-8)
# For large: stores actual mmap size (negative to indicate large)
# For a block from a.alloc(..): owner is a, and size_class is the whole
# block's length (header included) as a.alloc handed it out.
struct BlockHeader
    size_class: i64   # 0-8 for bins, negative for mmap size, length if owned
    owner: *Allocator # null: the global heap below; else the block's Allocator

# Free list node (embedded in free blocks, after header)
struct FreeNode
    next: *FreeNode

# Size class bin - manages allocations of one size
struct SizeBin
    free_list: *FreeNode  # Free list head
    block_size: i64       # Total block size (header + usable)
    slab: *u8             # Current slab being carved
    slab_offset: i64      # Next allocation offset in slab
    home: *Heap           # The heap whose source its slabs come from

# A size-class heap over one page source (AGAST #4326): the bins below, and
# the source their 64 KiB slabs and its large blocks map from and unmap to.
# g_alloc, the global heap behind malloc/free, is one with no source of its
# own: it follows whichever PageSource page_source_set has installed. A Heap
# from heap_init keeps the PageSource it was given, whatever is installed
# later, and an Allocator over it (heap_allocator) puts small blocks in its
# slabs rather than a page apiece.
pub struct Heap
    bins: [9]SizeBin      # One per size class
    initialized: i32
    own_source: bool      # false: the installed page source (g_alloc)
    source: PageSource    # when own_source
    slabs: *FreeNode      # every slab mapped, chained through its first word
    large: *LargeLink     # live large blocks from heap_allocator

# Global allocator instance
var g_alloc: Heap

# The first SLAB_LINK_SIZE bytes of each slab link it into its Heap's slabs;
# blocks are carved after them, still 16-aligned.
const SLAB_SIZE: i64 = 65536
const SLAB_LINK_SIZE: i64 = 16

# Ahead of each large block heap_allocator hands out: its mapping's length
# and its place in the Heap's large list, so heap_destroy can unmap it.
struct LargeLink
    prev: *LargeLink
    next: *LargeLink
    map_len: i64
    pad: i64

const LARGE_LINK_SIZE: i64 = 32

fn heap_page_map(h: *Heap, len: i64) -> *u8
    if not h.own_source
        return page_map(len)
    let f: fn(i64) -> *u8 = h.source.map
    return f(len)

fn heap_page_unmap(h: *Heap, p: *u8, len: i64) -> i32
    if not h.own_source
        return page_unmap(p, len)
    let f: fn(*u8, i64) -> i32 = h.source.unmap
    return f(p, len)

# Get block size for a size class
fn get_block_size(class: i32) -> i64
    if class == 0
        return 32
    if class == 1
        return 48
    if class == 2
        return 80
    if class == 3
        return 144
    if class == 4
        return 272
    if class == 5
        return 528
    if class == 6
        return 1040
    if class == 7
        return 2064
    return 0

# Get size class for a requested size
# Maps size ranges to classes: ≤16 → 0, ≤32 → 1, ≤64 → 2, ... ≤2048 → 7, >2048 → -1
fn get_size_class(size: i64) -> i32
    if size <= 0
        return -1
    if size <= 16
        return 0
    if size <= 32
        return 1
    if size <= 64
        return 2
    if size <= 128
        return 3
    if size <= 256
        return 4
    if size <= 512
        return 5
    if size <= 1024
        return 6
    if size <= 2048
        return 7
    return -1  # Large allocation

# Initialize a size bin, leaving home unset: heap_bind points it at its heap
# where that heap's address is final (alloc_init for g_alloc, heap_init,
# heap_allocator and heap_destroy for a caller's Heap). No bin is used
# before it is bound.
fn bin_init(bin: *SizeBin, block_size: i64)
    bin.free_list = null
    bin.block_size = block_size
    bin.slab = null
    bin.slab_offset = 0

# Allocate a new 64 KiB slab for a bin, from its heap's source, linked into
# that heap's slabs
fn bin_new_slab(bin: *SizeBin) -> i32
    let h: *Heap = bin.home
    let slab: *u8 = heap_page_map(h, SLAB_SIZE)
    if mmap_failed(slab)
        return -1
    let link: *FreeNode = slab as *FreeNode
    link.next = h.slabs
    h.slabs = link
    bin.slab = slab
    bin.slab_offset = SLAB_LINK_SIZE
    return 0

# Carve one block of `class` from bin's current slab, which has room.
fn bin_carve(bin: *SizeBin, class: i64) -> *u8
    let block: *u8 = bin.slab + bin.slab_offset
    bin.slab_offset = bin.slab_offset + bin.block_size

    # Set up header
    let header: *BlockHeader = block as *BlockHeader
    header.size_class = class
    header.owner = null

    # Return pointer after header
    return block + HEADER_SIZE

# bin_alloc once bin's slab is used up: a new slab from the bin's heap, then
# carve. Once per 64 KiB, so out of line: malloc's inlined fast path stays
# small, and the heap argument costs the hot path nothing.
[[noinline]]
fn bin_refill(bin: *SizeBin, class: i64) -> *u8
    if bin_new_slab(bin) != 0
        return null
    return bin_carve(bin, class)

# Allocate from a bin; its heap is bin.home
fn bin_alloc(bin: *SizeBin, class: i64) -> *u8
    # Try free list first
    if bin.free_list != null
        let node: *FreeNode = bin.free_list
        bin.free_list = node.next
        # The header is at (node - HEADER_SIZE)
        let header: *BlockHeader = (node as i64 - HEADER_SIZE) as *BlockHeader
        header.size_class = class
        return node as *u8

    # Carve from slab
    if bin.slab == null or bin.slab_offset + bin.block_size > SLAB_SIZE
        return bin_refill(bin, class)
    return bin_carve(bin, class)

# Free to a bin
fn bin_free(bin: *SizeBin, ptr: *u8)
    # Add to free list
    let node: *FreeNode = ptr as *FreeNode
    node.next = bin.free_list
    bin.free_list = node

# Empty bins, no slabs, no large blocks.
fn heap_init_bins(h: *Heap)
    for i in 0..NUM_SIZE_CLASSES
        bin_init(@h.bins[i], get_block_size(i))
    h.slabs = null
    h.large = null
    h.initialized = 1

# Point every bin at its heap, so a slab refill knows where to map from. Split
# from heap_init_bins because a caller's Heap is bound where its address is
# final: heap_init, heap_allocator and heap_destroy all call it.
fn heap_bind(h: *Heap)
    for i in 0..NUM_SIZE_CLASSES
        h.bins[i].home = h

# Initialize the global allocator
fn alloc_init()
    if g_alloc.initialized != 0
        return
    heap_init_bins(@g_alloc)
    heap_bind(@g_alloc)

# ============================================================================
# Public API: malloc, free, realloc
# ============================================================================

# Allocate size bytes
# standard-exempt: null-return: malloc(3) ABI: null is out-of-memory, the allocator boundary itself
pub fn malloc(size: i64) -> *u8
    if size <= 0
        return null

    # The check is inline: alloc_init is a call, and malloc is the hot path.
    if g_alloc.initialized == 0
        alloc_init()

    let class: i64 = get_size_class(size) as i64

    if class < 0
        # Large allocation - use mmap directly.
        # The header holds 0 - mmap_size, where mmap_size is size + HEADER_SIZE
        # rounded up to whole pages: malloc(8192) -> 8208 -> 3 pages -> -12288.
        # A size near i64 max wraps mmap_size to <= 0 (ritz arithmetic wraps),
        # which mmap rejects, so it fails as null below.  Every step wraps, by
        # request (LARB R63).
        let total_size: i64 = size +% HEADER_SIZE
        # Round up to page size
        let pages: i64 = (total_size +% MEM_PAGE_SIZE -% 1) / MEM_PAGE_SIZE
        let mmap_size: i64 = pages *% MEM_PAGE_SIZE

        let block: *u8 = page_map(mmap_size)
        if mmap_failed(block)
            return null

        # Store negative size to indicate large block
        let header: *BlockHeader = block as *BlockHeader
        header.size_class = 0 - mmap_size
        header.owner = null

        return block + HEADER_SIZE

    # Small allocation - use bins
    return bin_alloc(@g_alloc.bins[class], class)

# `heap e` (LANGUAGE_SPEC §2, AGAST #3934): one T from malloc, holding `value`.
# ritz1 lowers `heap e` to `__heap_new(e)`; ritz0 inlines the same malloc,
# store and `*T` (emitter_llvmlite._emit_heap_expr).  Not for direct use.
pub fn __heap_new<T>(value: T) -> *T
    let p: *T = malloc(sizeof(T)) as *T
    *p = value
    p

# Free a pointer (no size needed!)
# standard-exempt: raw-ptr-param: allocator: frees a raw block, the allocation boundary itself
pub fn free(ptr: *u8)
    if ptr == null
        return

    # Read header
    let header: *BlockHeader = (ptr as i64 - HEADER_SIZE) as *BlockHeader
    let size_class: i64 = header.size_class

    # A malloc_in block goes back to the Allocator it came from.
    if header.owner != null
        allocator_release(header.owner, header as *u8, size_class)
        return

    if size_class < 0
        # Large allocation - munmap
        let block: *u8 = (ptr as i64 - HEADER_SIZE) as *u8
        let mmap_size: i64 = 0 - size_class
        page_unmap(block, mmap_size)
        return

    # Small allocation - return to bin
    let class: i32 = size_class as i32
    if class >= 0 and class < NUM_SIZE_CLASSES
        bin_free(@g_alloc.bins[class], ptr)

# Reallocate to new size
# standard-exempt: null-return: realloc(3) ABI: null is out-of-memory, the allocator boundary itself
# standard-exempt: raw-ptr-param: allocator: realloc(3) ABI, a raw block in and out
pub fn realloc(ptr: *u8, new_size: i64) -> *u8
    if ptr == null
        return malloc(new_size)

    if new_size <= 0
        free(ptr)
        return null

    # Read old size class
    let header: *BlockHeader = (ptr as i64 - HEADER_SIZE) as *BlockHeader
    let old_class: i64 = header.size_class

    # A malloc_in block stays with its Allocator.
    if header.owner != null
        return realloc_owned(header.owner, ptr, old_class - HEADER_SIZE, new_size)

    var old_usable: i64 = 0
    if old_class < 0
        # Large block
        old_usable = (0 - old_class) - HEADER_SIZE
    else
        # Get usable size from block size
        old_usable = get_block_size(old_class as i32) - HEADER_SIZE

    # Only a small block staying in its own bin is returned as-is. A large
    # (mmap) block always moves, whether it grows or shrinks: there is no
    # in-place mremap growth, so realloc(malloc(8192), 16384) is a new block
    # and the old mapping is unmapped (AGAST #1983).
    let new_class: i32 = get_size_class(new_size)
    if new_class >= 0 and new_class == old_class as i32
        return ptr  # Fits in same class, no change needed

    # Need to allocate new block
    let new_ptr: *u8 = malloc(new_size)
    if new_ptr == null
        return null

    # Copy data
    var copy_size: i64 = old_usable
    if new_size < copy_size
        copy_size = new_size

    memcpy(new_ptr, ptr, copy_size)

    # Free old block
    free(ptr)

    return new_ptr

# Allocate and zero-initialize
# Null when count * size does not fit an i64 (it used to wrap: AGAST #1857),
# or either is negative.
# standard-exempt: null-return: calloc(3) ABI: null is out-of-memory or an overflowing size, the allocator boundary itself
pub fn calloc(count: i64, size: i64) -> *u8
    if count < 0 or size < 0
        return null
    if size != 0 and count > 9223372036854775807 / size
        return null
    let total: i64 = count * size
    let ptr: *u8 = malloc(total)
    if ptr != null
        memzero(ptr, total)
    return ptr

# ============================================================================
# Allocator: per-instance heaps (AGAST #4120)
# ============================================================================
# malloc/free/realloc above are one global heap. An Allocator is any other
# source of memory -- an Arena, a subsystem's own pages, a kernel heap -- that
# a Vec, String or HashMap can be built on (vec_new_in, string_new_in,
# hashmap_new_in) and that every later grow and the final free go back to.
#
#   ctx               the allocator's state (an *Arena, a *PageSource, ...)
#   alloc(ctx, len)   len bytes of read-write memory, 8-aligned, or null
#   free(ctx, p, len) give back what one alloc(ctx, len) returned
#
# This is the shape goliath's allocator had (AGAST #1881) plus a ctx, so one
# alloc fn can serve many instances; goliath now uses this type.
#
# a.alloc(size) takes size + HEADER_SIZE bytes from a, and the header
# names a as the block's owner. Plain free and realloc read that header, so
# collection code calls them unchanged and a block never goes back to the
# wrong allocator; a null owner is the global heap (a null Allocator.alloc(n) is
# malloc(n)). An Allocator must stay where it is (a global, or a var that
# outlives the blocks) while any block it gave out is live: the header points
# at it.
pub struct Allocator
    ctx: *u8
    alloc: fn(*u8, i64) -> *u8
    free: fn(*u8, *u8, i64) -> i32

# The Allocator that owns p (a block from malloc, malloc_in or realloc), or
# null for the global heap and for a null p.
# standard-exempt: null-return: null here means the global heap (or a null p), a distinguished allocator, not absence of an owner
# standard-exempt: raw-ptr-param: allocator: recovers the owning Allocator from a raw block
pub fn allocator_of(p: *u8) -> *Allocator
    if p == null
        return null
    let header: *BlockHeader = (p as i64 - HEADER_SIZE) as *BlockHeader
    return header.owner

# Hand a whole block (header included) back to its owner.
fn allocator_release(a: *Allocator, block: *u8, len: i64)
    let f: fn(*u8, *u8, i64) -> i32 = a.free
    f(a.ctx, block, len)

# realloc of an owned block: in place while it fits, else a new block from the
# same Allocator. new_size > 0, `usable` is what the block holds.
fn realloc_owned(a: *Allocator, ptr: *u8, usable: i64, new_size: i64) -> *u8
    if new_size <= usable
        return ptr
    let new_ptr: *u8 = a.malloc(new_size)
    if new_ptr == null
        return null
    memcpy(new_ptr, ptr, usable)
    free(ptr)
    return new_ptr

# ---- Allocators over ritzlib's own sources ----

fn arena_allocator_alloc(ctx: *u8, len: i64) -> *u8
    return (ctx as *Arena).alloc(len)

fn arena_allocator_free(ctx: *u8, p: *u8, len: i64) -> i32
    return 0

fn pages_allocator_alloc(ctx: *u8, len: i64) -> *u8
    let src: *PageSource = ctx as *PageSource
    let f: fn(i64) -> *u8 = src.map
    let p: *u8 = f(pages_round(len))
    if mmap_failed(p)
        return null
    return p

fn pages_allocator_free(ctx: *u8, p: *u8, len: i64) -> i32
    let src: *PageSource = ctx as *PageSource
    let f: fn(*u8, i64) -> i32 = src.unmap
    return f(p, pages_round(len))

fn pages_round(len: i64) -> i64
    return (len + MEM_PAGE_SIZE - 1) / MEM_PAGE_SIZE * MEM_PAGE_SIZE

# ---- Heap: a size-class layer over a PageSource (AGAST #4326) ----

# The size class heap_allocator serves a len-byte request (header included)
# from, or -1 for a large block.
fn heap_class(len: i64) -> i32
    if len <= HEADER_SIZE
        return 0
    return get_size_class(len - HEADER_SIZE)

fn heap_allocator_alloc(ctx: *u8, len: i64) -> *u8
    let h: *Heap = ctx as *Heap
    let class: i64 = heap_class(len) as i64
    if class >= 0
        # bin_alloc returns the block's usable bytes; the caller (malloc_in)
        # writes its own header over the bin's, so hand out the whole block.
        let p: *u8 = bin_alloc(@h.bins[class], class)
        if p == null
            return null
        return p - HEADER_SIZE
    let map_len: i64 = pages_round(len + LARGE_LINK_SIZE)
    if map_len <= len
        return null
    let m: *u8 = heap_page_map(h, map_len)
    if mmap_failed(m)
        return null
    let link: *LargeLink = m as *LargeLink
    link.prev = null
    link.next = h.large
    link.map_len = map_len
    if h.large != null
        h.large.prev = link
    h.large = link
    return m + LARGE_LINK_SIZE

fn heap_allocator_free(ctx: *u8, p: *u8, len: i64) -> i32
    let h: *Heap = ctx as *Heap
    let class: i32 = heap_class(len)
    if class >= 0
        bin_free(@h.bins[class], p + HEADER_SIZE)
        return 0
    let link: *LargeLink = (p as i64 - LARGE_LINK_SIZE) as *LargeLink
    if link.prev != null
        link.prev.next = link.next
    else
        h.large = link.next
    if link.next != null
        link.next.prev = link.prev
    return heap_page_unmap(h, link as *u8, link.map_len)

# ============================================================================
# Methods (S-IMPL-1): each type is the subject of every operation on it.
# ============================================================================

impl PageSource
    # Install `src` as the page source; returns the one it replaces.
    pub fn set(self: PageSource) -> PageSource
        let prev: PageSource = page_source_get()
        g_page_source = self
        g_page_source_installed = true
        return prev

    # An Allocator whose every block is its own whole-page mapping from `src`,
    # given back to `src` on free, whichever PageSource page_source_set has
    # installed by then. Every small block costs a page: heap_allocator, below,
    # packs them into slabs from the source instead.
    pub fn allocator(self: *PageSource) -> Allocator
        return Allocator { ctx: self as *u8, alloc: pages_allocator_alloc, free: pages_allocator_free }

impl Arena
    # Allocate `size` bytes from the arena
    # Returns pointer to allocated memory, or nil on failure
    # standard-exempt: null-return: arena bump allocation is the raw allocator boundary: null is out-of-memory (S-OWN-2 sanctions allocator modules)
    # standard-exempt: ptr-len-param: allocator: raw memory primitive below the span layer
    pub fn alloc(self: *Arena, size: i64) -> *u8
        if size <= 0
            return null

        # Align to 8 bytes for safety
        let aligned_size: i64 = (size + 7) & (0 - 8)

        if self.offset + aligned_size > self.size
            # Out of space
            return null

        let ptr: *u8 = self.base + self.offset
        self.offset = self.offset + aligned_size
        return ptr

    # Allocate and zero-initialize `size` bytes
    # standard-exempt: ptr-len-param: allocator: raw memory primitive below the span layer
    pub fn alloc_zero(self: *Arena, size: i64) -> *u8
        let ptr: *u8 = self.alloc(size)
        if ptr == null
            return ptr

        # Zero the memory
        var i: i64 = 0
        while i < size
            *(ptr + i) = 0
            i += 1

        return ptr

    # Allocate space for `count` elements of `elem_size` bytes each
    # standard-exempt: ptr-len-param: allocator: raw memory primitive below the span layer
    pub fn alloc_array(self: *Arena, count: i64, elem_size: i64) -> *u8
        return self.alloc(count * elem_size)

    # Reset the arena (free all allocations, keep the memory)
    pub fn reset(self: *Arena)
        self.offset = 0

    # Destroy the arena (free the underlying memory)
    pub fn destroy(self: *Arena)
        if self.base != null and self.size > 0
            page_unmap(self.base, self.size)
        self.base = null
        self.size = 0
        self.offset = 0

    # Get the current usage of the arena
    pub fn used(self: *Arena) -> i64
        return self.offset

    # Get the remaining capacity of the arena
    pub fn remaining(self: *Arena) -> i64
        return self.size - self.offset

    # Check if arena is valid (successfully allocated)
    pub fn valid(self: *Arena) -> bool
        if self.base != null
            return true
        return false

    # An Allocator over `arena`: blocks are bumped out of it, and free gives
    # nothing back: the memory returns on arena_reset / arena_destroy, which must
    # not happen while a collection on it is still in use.
    pub fn allocator(self: *Arena) -> Allocator
        return Allocator { ctx: self as *u8, alloc: arena_allocator_alloc, free: arena_allocator_free }

impl Allocator
    # size bytes owned by `a`; free/realloc route them back there. A null `a` is
    # the global heap.
    # standard-exempt: null-return: allocation through an Allocator is the raw allocator boundary: null is out-of-memory
    # standard-exempt: ptr-len-param: allocator: raw memory primitive below the span layer
    pub fn malloc(self: *Allocator, size: i64) -> *u8
        if self == null
            return malloc(size)
        if size <= 0
            return null
        let total: i64 = size + HEADER_SIZE
        # size near i64 max wraps total; refuse rather than ask for a tiny block.
        if total <= size
            return null
        let f: fn(*u8, i64) -> *u8 = self.alloc
        let block: *u8 = f(self.ctx, total)
        if block == null
            return null
        let header: *BlockHeader = block as *BlockHeader
        header.size_class = total
        header.owner = self
        return block + HEADER_SIZE

impl Heap
    # Fill `h` as a Heap whose slabs and large blocks map from `src` and unmap to
    # it, whatever page_source_set installs later. Nothing is mapped until the
    # first block. Fills in place rather than returning a Heap: a Heap is large,
    # and ritz0 emits an internal sret-copy helper for a large by-value return.
    # `h` must stay at this address while its Allocator or any block from it is
    # live.
    pub fn init(self: *Heap, src: PageSource)
        heap_init_bins(self)
        self.own_source = true
        self.source = src
        heap_bind(self)

    # An Allocator over `h`: small blocks come out of h's size-class slabs and
    # free puts them back in its bins; a block over 2 KiB is its own mapping from
    # h's source. h must stay where it is while the Allocator or any block from
    # it is live. Binds h's bins to h: this is where a Heap's address is final.
    pub fn allocator(self: *Heap) -> Allocator
        heap_bind(self)
        return Allocator { ctx: self as *u8, alloc: heap_allocator_alloc, free: heap_allocator_free }

    # Unmap every slab and every live large block of h to its source, and leave
    # h empty, ready for reuse. Every block from h is gone with them: nothing
    # allocated from it may be used, or freed, afterwards. The global heap is
    # never destroyed (a no-op on it).
    pub fn destroy(self: *Heap)
        if self == @g_alloc
            return
        var s: *FreeNode = self.slabs
        while s != null
            let next: *FreeNode = s.next
            heap_page_unmap(self, s as *u8, SLAB_SIZE)
            s = next
        var l: *LargeLink = self.large
        while l != null
            let next: *LargeLink = l.next
            heap_page_unmap(self, l as *u8, l.map_len)
            l = next
        heap_init_bins(self)
        heap_bind(self)
