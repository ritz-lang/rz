# ritzlib.os.env's env_raw_envp: the one **u8 escape hatch, kept for
# execve interop (AGAST #1480).
#
# env_raw_envp() must hand back a NULL-terminated array of C strings that
# lists exactly the entries env_iter() sees, in the same order, so a program
# that execs a child passes on the same environment it was given.

import ritzlib.sys
import ritzlib.str
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.os.env

fn raw_count(envp: **u8) -> i64
    var n: i64 = 0
    while *(envp + n) != null
        n += 1
    n

[[test]]
fn test_env_raw_envp_not_null() -> i32
    let envp: **u8 = env_raw_envp()
    assert envp != null
    0

[[test]]
fn test_env_raw_envp_count_matches_iter() -> i32
    let envp: **u8 = env_raw_envp()
    let entries: Span<StrView> = env_iter()
    # The harness environment always has at least PATH.
    assert entries.len > 0
    assert raw_count(envp) == entries.len
    0

[[test]]
fn test_env_raw_envp_entries_match_iter() -> i32
    let envp: **u8 = env_raw_envp()
    let entries: Span<StrView> = env_iter()
    var i: i64 = 0
    while i < entries.len
        let e: *StrView = entries.ptr + i
        let c: *u8 = *(envp + i)
        # Same bytes, and NUL-terminated right where the view ends.
        assert strlen(c) == e.len
        assert c == e.ptr
        i += 1
    0

[[test]]
fn test_env_raw_envp_is_cached() -> i32
    # Two calls return the same array: no per-call allocation.
    assert env_raw_envp() == env_raw_envp()
    0

[[test]]
fn test_env_raw_envp_finds_path() -> i32
    # A known variable is reachable through the raw array as "PATH=...".
    let envp: **u8 = env_raw_envp()
    var found: i32 = 0
    var i: i64 = 0
    while *(envp + i) != null
        let v: StrView = strview_from_cstr(*(envp + i))
        if strview_starts_with_cstr(@v, c"PATH=") != 0
            found = 1
        i += 1
    assert found == 1
    0
