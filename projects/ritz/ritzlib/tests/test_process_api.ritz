# ritzlib.process: the StrView / Span API (AGAST #1481).
#
#   find_command_in(name: StrView, path: StrView) -> Option<String>
#   find_command(name: StrView) -> Option<String>        ($PATH, or a default)
#   spawn(cmd: StrView, args: Span<StrView>) -> Result<Process, Errno>
#   p.write_all(data: StrView) -> Result<i64, Errno>
#   process_read_stdout / process_read_stderr -> Result<i64, Errno>
#   p.wait() -> Result<ProcessResult, Errno>
#   p.valid() and the other methods on a live Process (#3750)
#   Every Err is a ritzlib.errno Errno (AGAST #4298).
#   r.success() -> bool
#
# A StrView carries no terminator, so every test that matters here hands the
# API a view whose bytes run on past its length (a slice of a longer
# literal): the callee must copy exactly `len` bytes and terminate them itself.

import ritzlib.sys
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.fs
import ritzlib.time
import ritzlib.process

# 1 if `o` is Some and its String equals `want`.
fn some_is(o: @Option<String>, want: StrView) -> i32
    match *o
        Some(s) => s.eq(want) as i32
        None => 0

fn is_none(o: @Option<String>) -> bool
    match *o
        Some(_) => false
        None => true

# The errno number of a failed spawn, 0 if it succeeded.
fn spawn_err(r: @Result<Process, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

# The count of an Ok, -1000 - errno for an Err (so a test sees which).
fn count_of(r: Result<i64, Errno>) -> i64
    match r
        Ok(n) => n
        Err(e) => -1000 - e.code() as i64

# p.wait()'s exit code, or -1000 - errno if it failed.
fn wait_code(p: @&Process) -> i32
    match p.wait()
        Ok(res) => res.exit_code
        Err(e) => -1000 - e.code()

# A spawned process run to completion: its exit code (-1 if spawn failed)
# and everything it wrote to stdout.
struct Ran
    code: i32
    out: Vec<u8>

fn run(r: Result<Process, Errno>) -> Ran
    match r
        Ok(p) =>
            var q: Process = p
            let out: Vec<u8> = q.read_stdout_all()
            let code: i32 = wait_code(@&q)
            q.cleanup()
            Ran { code: code, out: out }
        Err(_) => Ran { code: -1, out: vec_new<u8>() }

# ============================================================================
# find_command_in -> Option<String>
# ============================================================================

[[test]]
fn test_find_command_in_skips_missing_dirs() -> i32
    var o: Option<String> = find_command_in("env", "/nonexistent-ritz:/usr/bin")
    assert some_is(@o, "/usr/bin/env") == 1
    0

[[test]]
fn test_find_command_in_dir_with_trailing_slash() -> i32
    var o: Option<String> = find_command_in("env", "/usr/bin/")
    assert some_is(@o, "/usr/bin/env") == 1
    0

[[test]]
fn test_find_command_in_needs_execute_permission() -> i32
    # /etc/passwd exists but is not executable.
    var o: Option<String> = find_command_in("passwd", "/etc")
    assert is_none(@o)
    0

[[test]]
fn test_find_command_in_not_found_is_none() -> i32
    var o: Option<String> = find_command_in("ritz-no-such-command", "/usr/bin:/bin")
    assert is_none(@o)
    0

[[test]]
fn test_find_command_in_empty_path_is_none() -> i32
    var o: Option<String> = find_command_in("env", "")
    assert is_none(@o)
    0

[[test]]
fn test_find_command_in_uses_view_length() -> i32
    # name "env" and dir "/usr/bin", both views into longer literals.
    let name: StrView = ("envXYZ").slice(0, 3)
    let path: StrView = ("/usr/binNOPE").slice(0, 8)
    var o: Option<String> = find_command_in(name, path)
    assert some_is(@o, "/usr/bin/env") == 1
    0

[[test]]
fn test_find_command_in_slash_name_is_returned_as_is() -> i32
    # A name with a '/' is a path, not a PATH lookup -- exactly as before.
    var o: Option<String> = find_command_in("./not/here", "/usr/bin")
    assert some_is(@o, "./not/here") == 1
    0

# ============================================================================
# find_command -> Option<String>
# ============================================================================

[[test]]
fn test_find_command_finds_sh() -> i32
    var o: Option<String> = find_command("sh")
    match o
        Some(s) =>
            assert s.ends_with("/sh")
            assert access(s.as_view(), X_OK).is_ok()
        None =>
            assert false
    0

[[test]]
fn test_find_command_missing_is_none() -> i32
    var o: Option<String> = find_command("ritz-no-such-command")
    assert is_none(@o)
    0

# ============================================================================
# spawn(cmd, args) -> Result<Process, Errno>
# ============================================================================

[[test]]
fn test_spawn_no_args_cat_echoes_stdin() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            assert count_of(q.write_all("hello\n")) == 6
            q.close_stdin()
            var out: Vec<u8> = q.read_stdout_all()
            assert out.as_view().eq("hello\n")
            assert wait_code(@&q) == 0
            q.cleanup()
        Err(_) =>
            assert false
    0

[[test]]
fn test_spawn_searches_path_and_passes_args() -> i32
    var args: [2]StrView
    args[0] = "-c"
    args[1] = "exit 3"
    let ran: Ran = run(spawn("sh", @args))
    assert ran.code == 3
    0

[[test]]
fn test_spawn_args_are_exact_bytes() -> i32
    # An arg with a space, an empty arg, and an arg that is a view into a
    # longer literal: the child must see "a b", "" and "xyz".
    var args: [5]StrView
    args[0] = "-c"
    args[1] = "printf '%s|%s|%s|%s' \"$#\" \"$1\" \"$2\" \"$3\""
    args[2] = "a b"
    args[3] = ""
    args[4] = ("xyzNOPE").slice(0, 3)
    # sh -c CMD NAME ARGS...: args[2] is $0, so shift the view by one.
    var shifted: [6]StrView
    shifted[0] = args[0]
    shifted[1] = args[1]
    shifted[2] = "zero"
    shifted[3] = args[2]
    shifted[4] = args[3]
    shifted[5] = args[4]
    let ran: Ran = run(spawn("sh", @shifted))
    assert ran.code == 0
    assert ran.out.as_view().eq("3|a b||xyz")
    0

[[test]]
fn test_spawn_argv0_is_cmd_as_given() -> i32
    # argv[0] is `cmd` exactly as the caller wrote it, not the resolved path.
    var args: [2]StrView
    args[0] = "-c"
    args[1] = "printf '%s' \"$0\""
    let ran: Ran = run(spawn(("shNOPE").slice(0, 2), @args))
    assert ran.code == 0
    assert ran.out.as_view().eq("sh")
    0

[[test]]
fn test_spawn_missing_command_is_enoent() -> i32
    var r: Result<Process, Errno> = spawn("ritz-no-such-command", span_empty<StrView>())
    assert spawn_err(@r) == 2
    match r
        Ok(_) =>
            assert false
        Err(e) => match e
            NoEnt => pass
            _ =>
                assert false
    0

[[test]]
fn test_spawn_not_executable_is_eacces() -> i32
    # Found (a '/' path is taken as is) but not executable: Err(13), no fork.
    var r: Result<Process, Errno> = spawn("/etc/passwd", span_empty<StrView>())
    assert spawn_err(@r) == 13
    match r
        Ok(_) =>
            assert false
        Err(e) => match e
            Acces => pass
            _ =>
                assert false
    0

# ============================================================================
# p.write_all(StrView)
# ============================================================================

[[test]]
fn test_process_write_all_writes_view_length() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            assert count_of(q.write_all(("abcNOPE").slice(0, 3))) == 3
            q.close_stdin()
            var out: Vec<u8> = q.read_stdout_all()
            assert out.as_view().eq("abc")
            assert wait_code(@&q) == 0
            q.cleanup()
        Err(_) =>
            assert false
    0

[[test]]
fn test_process_write_all_after_close_is_badf() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            q.close_stdin()
            match q.write_all("x")
                Ok(_) =>
                    assert false
                Err(e) => match e
                    BadF => pass
                    _ =>
                        assert false
            assert wait_code(@&q) == 0
            q.cleanup()
        Err(_) =>
            assert false
    0

# ============================================================================
# process_read_stdout / process_read_stderr -> Result<i64, Errno> (#4298)
# ============================================================================

[[test]]
fn test_process_read_stdout_reads_then_eof() -> i32
    var args: [2]StrView
    args[0] = "-c"
    args[1] = "printf out; printf err >&2"
    match spawn("sh", @args)
        Ok(p) =>
            var q: Process = p
            var buf: Vec<u8> = vec_zeroed<u8>(16)
            assert count_of(q.read_stdout(span_from_vec<u8>(@buf))) == 3
            assert buf.as_view().slice(0, 3).eq("out")
            assert count_of(q.read_stdout(span_from_vec<u8>(@buf))) == 0
            assert count_of(q.read_stderr(span_from_vec<u8>(@buf))) == 3
            assert buf.as_view().slice(0, 3).eq("err")
            assert wait_code(@&q) == 0
            q.cleanup()
        Err(_) =>
            assert false
    0

[[test]]
fn test_process_read_after_close_is_badf() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            q.kill()
            assert wait_code(@&q) == 128 + 9
            q.close_pipes()
            var buf: Vec<u8> = vec_zeroed<u8>(4)
            assert count_of(q.read_stdout(span_from_vec<u8>(@buf))) == -1000 - EBADF as i64
            assert count_of(q.read_stderr(span_from_vec<u8>(@buf))) == -1000 - EBADF as i64
            q.cleanup()
        Err(_) =>
            assert false
    0

# ============================================================================
# p.valid(), r.success() -> bool
# ============================================================================

# Spawn `sh -c script`, wait for it, and return its ProcessResult; the
# Process is checked valid through a shared reference first.
[[test_helper]]
fn sh_result(script: StrView) -> ProcessResult
    var args: [2]StrView
    args[0] = "-c"
    args[1] = script
    var bad: ProcessResult = ProcessResult { exit_code: -1, signaled: 0, signal: 0 }
    match spawn("sh", @args)
        Ok(p) =>
            var q: Process = p
            assert q.valid()
            var res: ProcessResult = bad
            match q.wait()
                Ok(w) => res = w
                Err(_) =>
                    assert false
            q.cleanup()
            res
        Err(_) => bad

[[test]]
fn test_result_success_is_true_on_exit_0() -> i32
    let r: ProcessResult = sh_result("exit 0")
    let ok: bool = r.success()
    assert ok
    assert r.exit_code == 0
    0

[[test]]
fn test_result_success_is_false_on_nonzero_exit() -> i32
    let r: ProcessResult = sh_result("exit 3")
    assert not r.success()
    assert r.exit_code == 3
    0

[[test]]
fn test_result_success_is_false_when_signaled() -> i32
    # Killed by SIGKILL: not a success, whatever exit_code holds.
    let r: ProcessResult = sh_result("kill -9 $$")
    assert r.signaled == 1
    assert r.signal == 9
    assert not r.success()
    0

[[test]]
fn test_result_success_rule() -> i32
    # The rule itself, on hand-built results: success needs BOTH no signal
    # and exit code 0.  (process_wait never builds the last one, since it
    # sets exit_code to 128 + signal, so only this test pins the signal half.)
    let ok: ProcessResult = ProcessResult { exit_code: 0, signaled: 0, signal: 0 }
    let code: ProcessResult = ProcessResult { exit_code: 1, signaled: 0, signal: 0 }
    let sig: ProcessResult = ProcessResult { exit_code: 0, signaled: 1, signal: 9 }
    assert ok.success()
    assert not code.success()
    assert not sig.success()
    0

[[test]]
fn test_process_kill_then_wait_reports_signal() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            q.kill()
            match q.wait()
                Ok(res) =>
                    assert res.signaled == 1
                    assert res.exit_code == 128 + 9
                Err(_) =>
                    assert false
            # A second wait finds nothing to wait for: Err(Child), not a
            # ProcessResult whose exit_code -1 stands for "failed".
            match q.wait()
                Ok(_) =>
                    assert false
                Err(e) => match e
                    Child => pass
                    _ =>
                        assert false
            q.cleanup()
        Err(_) =>
            assert false
    0

# ============================================================================
# p.try_wait() -> Option<ProcessResult>  (AGAST #3883)
# ============================================================================

[[test_helper]]
fn try_wait_code(o: @Option<ProcessResult>) -> i32
    match *o
        Some(r) => r.exit_code
        None => -100

[[test]]
fn test_process_try_wait_is_none_while_running_then_reaps() -> i32
    var r: Result<Process, Errno> = spawn("/bin/cat", span_empty<StrView>())
    match r
        Ok(p) =>
            var q: Process = p
            # cat blocks on its open stdin: still running, nothing reaped.
            var o: Option<ProcessResult> = q.try_wait()
            assert try_wait_code(@o) == -100
            assert q.waited == 0
            q.close_stdin()
            var tries: i32 = 0
            o = q.try_wait()
            # Up to 30 s: only a cap, since the loop ends as soon as cat
            # exits.  It was 5 s, which a loaded host can use up (#3942).
            while try_wait_code(@o) == -100 and tries < 3000
                sleep_ms(10)
                o = q.try_wait()
                tries += 1
            assert try_wait_code(@o) == 0
            assert q.waited == 1
            # Reaped once: a second call finds nothing.
            o = q.try_wait()
            assert try_wait_code(@o) == -100
            q.cleanup()
        Err(_) =>
            assert false
    0
