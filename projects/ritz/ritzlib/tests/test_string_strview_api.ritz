# Tests for ritzlib/string's StrView-taking API (AGAST #1474).
#
# string_push_str / string_starts_with / string_ends_with / string_contains
# take a StrView, so a bare "..." literal passes straight in. string_eq
# compares a String with a StrView and returns bool. The *u8 cases have their
# own names: string_push_cstr and string_eq_cstr. String-vs-String comparison
# is string_eq_string.
#
# Several tests use a StrView that is NOT NUL-terminated (a 3-byte view of
# "hello"). A *u8 implementation reads up to the NUL and gets those wrong,
# which is how these tests tell the two signatures apart.
import ritzlib.string
import ritzlib.strview

# ============================================================================
# string_push_str(s, StrView) / string_push_cstr(s, *u8)
# ============================================================================

[[test]]
fn test_push_str_literal() -> i32
    var s: String = string_from("ab")
    string_push_str(@s, "cd")
    if string_eq(@s, "abcd") == false
        return 1
    return 0

[[test]]
fn test_push_str_respects_view_len() -> i32
    # Only the view's 3 bytes are appended, not everything up to the NUL.
    var s: String = string_new()
    string_push_str(@s, strview_from_ptr(c"hello", 3))
    if string_len(@s) != 3
        return 1
    if string_eq(@s, "hel") == false
        return 2
    return 0

[[test]]
fn test_push_str_empty() -> i32
    var s: String = string_from("x")
    string_push_str(@s, "")
    if string_len(@s) != 1
        return 1
    return 0

[[test]]
fn test_push_cstr() -> i32
    var s: String = string_from("0x")
    let p: *u8 = c"ff"
    string_push_cstr(@s, p)
    if string_eq(@s, "0xff") == false
        return 1
    return 0

# ============================================================================
# string_eq(s, StrView) -> bool / string_eq_string(a, b)
# ============================================================================

[[test]]
fn test_eq_true() -> i32
    var s: String = string_from("hello")
    let r: bool = string_eq(@s, "hello")
    if r == false
        return 1
    return 0

[[test]]
fn test_eq_different_bytes() -> i32
    var s: String = string_from("hello")
    if string_eq(@s, "hellO")
        return 1
    return 0

[[test]]
fn test_eq_view_is_prefix() -> i32
    # "hel" is a prefix of "hello": equal bytes, different length.
    var s: String = string_from("hello")
    if string_eq(@s, "hel")
        return 1
    if string_eq(@s, "hello world")
        return 2
    return 0

[[test]]
fn test_eq_respects_view_len() -> i32
    var s: String = string_from("hel")
    if string_eq(@s, strview_from_ptr(c"hello", 3)) == false
        return 1
    return 0

[[test]]
fn test_eq_empty() -> i32
    var s: String = string_new()
    if string_eq(@s, "") == false
        return 1
    if string_eq(@s, "a")
        return 2
    return 0

[[test]]
fn test_eq_string() -> i32
    var a: String = string_from("test")
    var b: String = string_from("test")
    var c: String = string_from("tesT")
    if string_eq_string(@a, @b) != 1
        return 1
    if string_eq_string(@a, @c) != 0
        return 2
    return 0

# ============================================================================
# string_starts_with(s, StrView)
# ============================================================================

[[test]]
fn test_starts_with_true() -> i32
    var s: String = string_from("hello world")
    if string_starts_with(@s, "hello") != 1
        return 1
    if string_starts_with(@s, "hello world") != 1
        return 2
    return 0

[[test]]
fn test_starts_with_false() -> i32
    var s: String = string_from("hello world")
    if string_starts_with(@s, "world") != 0
        return 1
    if string_starts_with(@s, "hello world!") != 0
        return 2
    return 0

[[test]]
fn test_starts_with_empty() -> i32
    var s: String = string_from("abc")
    if string_starts_with(@s, "") != 1
        return 1
    return 0

[[test]]
fn test_starts_with_respects_view_len() -> i32
    # s = "help"; the view is "hel" (3 bytes of "hello"), so it matches.
    var s: String = string_from("help")
    if string_starts_with(@s, strview_from_ptr(c"hello", 3)) != 1
        return 1
    return 0

# ============================================================================
# string_ends_with(s, StrView)
# ============================================================================

[[test]]
fn test_ends_with_true() -> i32
    var s: String = string_from("hello world")
    if string_ends_with(@s, "world") != 1
        return 1
    if string_ends_with(@s, "hello world") != 1
        return 2
    return 0

[[test]]
fn test_ends_with_false() -> i32
    var s: String = string_from("hello world")
    if string_ends_with(@s, "hello") != 0
        return 1
    if string_ends_with(@s, "xhello world") != 0
        return 2
    return 0

[[test]]
fn test_ends_with_empty() -> i32
    var s: String = string_from("abc")
    if string_ends_with(@s, "") != 1
        return 1
    return 0

[[test]]
fn test_ends_with_respects_view_len() -> i32
    # The view is "ld" (2 bytes of "ldx"); "world" ends with "ld", not "ldx".
    var s: String = string_from("world")
    if string_ends_with(@s, strview_from_ptr(c"ldx", 2)) != 1
        return 1
    return 0

# ============================================================================
# string_contains(s, StrView)
# ============================================================================

[[test]]
fn test_contains_true() -> i32
    var s: String = string_from("hello world")
    if string_contains(@s, "lo wo") != 1
        return 1
    if string_contains(@s, "hello") != 1
        return 2
    if string_contains(@s, "world") != 1
        return 3
    return 0

[[test]]
fn test_contains_false() -> i32
    var s: String = string_from("hello world")
    if string_contains(@s, "xyz") != 0
        return 1
    if string_contains(@s, "hello world!") != 0
        return 2
    if string_contains(@s, "worle") != 0
        return 3
    return 0

[[test]]
fn test_contains_empty() -> i32
    var s: String = string_from("abc")
    if string_contains(@s, "") != 1
        return 1
    return 0

[[test]]
fn test_contains_respects_view_len() -> i32
    # The view is "o w" (3 bytes of "o wx"); the String contains "o w" only.
    var s: String = string_from("hello world")
    if string_contains(@s, strview_from_ptr(c"o wx", 3)) != 1
        return 1
    return 0
