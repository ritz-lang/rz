# ritzlib.process's Exec: execve(2) in place, prepared before fork (AGAST
# #4648, which retired ritzlib.os.env's raw **u8 env_raw_envp).
#
#   exec_prepare(path, args)  -> Ok(Exec): `path` and argv `args` (argv[0]
#                                included), with THIS process's environment,
#                                built before fork so the child allocates
#                                nothing
#   ex.run()                  -> replaces the process; returns only on
#                                failure, with the Errno
#
# The child is /usr/bin/env: it prints its environment as "KEY=VALUE\n"
# lines in environ order, so the expected output is the parent's env_iter().

import ritzlib.sys
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.errno
import ritzlib.fd
import ritzlib.process
import ritzlib.os.env


[[test]]
fn test_exec_inherits_parent_env() -> i32
    assert env_iter().len > 0
    let argv: [1]StrView = ["env"]
    var ex: Exec = match exec_prepare("/usr/bin/env", @argv)
        Ok(e) => e
        Err(_) => return 1

    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return 1
    let pid: i32 = match fork()
        Ok(side) => match side
            Child =>
                p.write.dup_to(1)
                p.close()
                ex.run()
                sys_exit(126)
                0
            Parent(child) => child
        Err(_) => return 1
    p.write.close()
    ex.free()

    var got: String = string_new()
    assert p.read.read_to_end(@&got).is_ok()
    p.close()
    match wait_pid(pid)
        Ok(r) =>
            assert r.success()
        Err(_) =>
            assert false, "wait_pid"

    var want: String = string_new()
    let entries: Span<StrView> = env_iter()
    for i in 0..entries.len
        want.push_str(entries[i])
        want.push('\n')
    assert got.as_view().eq(want.as_view())
    0

[[test]]
fn test_exec_missing_path_returns_enoent() -> i32
    # A failed execve(2) returns, so this needs no fork.
    let argv: [1]StrView = ["nope"]
    var ex: Exec = match exec_prepare("/ritz-no-such-dir/nope", @argv)
        Ok(e) => e
        Err(_) => return 1
    let e: Errno = ex.run()
    ex.free()
    match e
        NoEnt => pass
        _ =>
            assert false
    0

[[test]]
fn test_exec_args_use_view_length() -> i32
    # Views into longer strings: each argv entry is exactly `len` bytes.
    # /bin/sh -c 'exit 7' x: the exit status shows argv reached the child.
    let argv: [3]StrView = [("shXX").slice(0, 2), ("-cZZ").slice(0, 2), ("exit 7;;;").slice(0, 6)]
    var ex: Exec = match exec_prepare(("/bin/shQQ").slice(0, 7), @argv)
        Ok(e) => e
        Err(_) => return 1
    let pid: i32 = match fork()
        Ok(side) => match side
            Child =>
                ex.run()
                sys_exit(126)
                0
            Parent(child) => child
        Err(_) => return 1
    ex.free()
    match wait_pid(pid)
        Ok(r) =>
            assert r.exit_code == 7
        Err(_) =>
            assert false, "wait_pid"
    0
