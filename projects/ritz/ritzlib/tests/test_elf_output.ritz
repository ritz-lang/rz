# Byte-exact stdout of ritzlib.elf's elf_print_test_functions (AGAST #1684).
#
# It was a prints/prints_cstr chain; #1684 made each line one interpolated
# print.  The child reads this test binary (/proc/self/exe) and prints its
# test functions; the parent builds the expected bytes independently by
# walking the same symbol table, and requires the two `pub fn
# test_elf_output_marker*` below to be among them (the harness gives non-pub
# functions, [[test]] ones included, internal linkage, so they are not
# listed).  ritzlib/tests/test_elf.ritz is a manual tool that needs a file
# argument, so nothing exercised the printer before.
#
# Run under testlib's capture: a forked child, stdout and stderr on their
# own pipes.

import ritzlib.io
import ritzlib.strview
import ritzlib.result
import ritzlib.fs
import ritzlib.elf
import ritzlib.testlib


# ============================================================================
# Cases
# ============================================================================

# A reader over `image`, this test binary's bytes, its sections parsed.
# The reader points into `image`, which must outlive it.
fn reader_over(image: @String) -> Result<ElfReader, ElfError>
    var reader: ElfReader
    reader.init(span_from_strview(image.as_view()))?
    reader.parse_sections()?
    Ok(reader)

# The child: print this binary's test functions.  Exits 2 when the binary
# can't be read, 3 when it doesn't parse.
fn case_print_self() -> i32
    match read_file("/proc/self/exe")
        Ok(image) => match reader_over(@image)
            Ok(reader) =>
                reader.print_test_functions()
                0
            Err(_) => 3
        Err(_) => 2

# Expected bytes, assembled from the symbol table without the printer, and
# how many of this file's markers were listed.
struct Want
    text: String
    mine: i32

fn build_want(reader: @ElfReader) -> Want
    var want = Want { text: string_from("Test functions found:\n"), mine: 0 }
    var i: i64 = 0
    while i < reader.symtab_count
        let info: u8 = reader.get_symbol_info(i)
        if elf_is_function(info) and elf_is_global(info)
            match reader.get_symbol_name(i)
                Some(name) =>
                    if name.starts_with("test_")
                        want.text.push_str("  ")
                        want.text.push_str(name)
                        want.text.push_str("\n")
                        if name.starts_with("test_elf_output_marker")
                            want.mine += 1
                None => pass
        i += 1
    want

[[test]]
fn test_elf_print_test_functions_exact() -> i32
    match read_file("/proc/self/exe")
        Ok(image) => match reader_over(@image)
            Ok(reader) =>
                let want = build_want(@reader)
                assert want.mine == 2
                match capture(case_print_self)
                    Ok(c) =>
                        assert c.status.success()
                        assert buf_eq(c.output(), span_from_strview(want.text.as_view()))
                        assert c.err.len == 0
                    Err(_) =>
                        assert false, "fork"
            Err(_) =>
                assert false, "parse /proc/self/exe"
        Err(_) =>
            assert false, "read /proc/self/exe"
    0

# Global `test_` functions for the printer to find (see the header).
pub fn test_elf_output_marker_a() -> i32
    1

pub fn test_elf_output_marker_b() -> i32
    2
