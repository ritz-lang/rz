# Tests for ritzlib/sort.ritz: sort<T: Ord>, a stable merge sort (AGAST #4913).

import ritzlib.cmp
import ritzlib.gvec
import ritzlib.sort

# A key and where it started: stability is the order of `at` among equal keys.
struct Keyed
    key: i64
    at: i64

impl Ord for Keyed
    fn compare(self: @Keyed, other: @Keyed) -> Ordering
        cmp_i64(self.key, other.key)

fn ints(values: [i64]) -> Vec<i64>
    var v: Vec<i64> = vec_new<i64>()
    for i in 0..values.len
        v.push(values[i])
    v

fn ascending(v: @Vec<i64>) -> bool
    for i in 1..v.len()
        if v.get(i - 1) > v.get(i)
            return false
    true

[[test]]
fn test_sort_empty_and_one() -> i32
    var none: Vec<i64> = vec_new<i64>()
    sort<i64>(@&none)
    assert none.len() == 0
    var one: Vec<i64> = vec_new<i64>()
    one.push(7)
    sort<i64>(@&one)
    assert one.len() == 1 and one.get(0) == 7
    0

[[test]]
fn test_sort_orders_i64() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(5)
    v.push(-3)
    v.push(9)
    v.push(0)
    v.push(5)
    v.push(-3)
    v.push(2)
    sort<i64>(@&v)
    assert v.len() == 7
    assert v.get(0) == -3 and v.get(1) == -3 and v.get(2) == 0 and v.get(3) == 2
    assert v.get(4) == 5 and v.get(5) == 5 and v.get(6) == 9
    0

# Lengths across the merge's run boundaries (powers of two and either side),
# from a reversed and a scrambled start.
[[test]]
fn test_sort_many_lengths() -> i32
    for n in 2..70
        var rev: Vec<i64> = vec_new<i64>()
        var mixed: Vec<i64> = vec_new<i64>()
        for i in 0..n
            rev.push(n - i)
            mixed.push((i * 37 + 11) % 23)
        sort<i64>(@&rev)
        sort<i64>(@&mixed)
        assert rev.len() == n and mixed.len() == n
        assert ascending(@rev), "a reversed Vec sorts"
        assert ascending(@mixed), "a scrambled Vec sorts"
        for i in 0..n
            assert rev.get(i) == i + 1
    0

[[test]]
fn test_sort_is_stable() -> i32
    var v: Vec<Keyed> = vec_new<Keyed>()
    for i in 0..40
        v.push(Keyed { key: (i * 7) % 3, at: i })
    sort<Keyed>(@&v)
    for i in 1..v.len()
        let a = v.get(i - 1)
        let b = v.get(i)
        assert a.key <= b.key
        if a.key == b.key
            assert a.at < b.at, "equal keys keep their order"
    0
