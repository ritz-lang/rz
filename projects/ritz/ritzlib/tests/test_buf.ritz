# Test ritzlib/buf.ritz - Buffer and GrowBuf types
#
# Tests both:
# - Buffer: read-only cursor over bytes it does not own
# - GrowBuf: owned growable buffer with Drop trait
#
# Written against the idiomatic API (#1478): StrView in, StrView slices out
# (zero-copy, no caller-sized out-buffers), bool predicates, and a typed
# `fn(u8) -> bool` predicate for buf_take_while.  The old
# `(out: *u8, max_len)` forms are kept for one release; their own section at
# the bottom pins them until they are removed.

import ritzlib.sys
import ritzlib.buf
import ritzlib.string
import ritzlib.strview

# "abc" == view, as a bool (StrView.eq returns i32).
fn view_is(v: StrView, want: StrView) -> bool
    return v.eq(want)

fn is_vowel(c: u8) -> bool
    return c == 'a' or c == 'e' or c == 'i' or c == 'o' or c == 'u'

fn never(c: u8) -> bool
    return false

# ============================================================================
# GrowBuf tests
# ============================================================================

[[test]]
fn test_growbuf_new() -> i32
    # New buffer should be empty
    var b: GrowBuf = growbuf_new()
    if b.len != 0
        return 1
    if b.cap != 0
        return 2
    # No need to free - Drop handles it
    return 0

[[test]]
fn test_growbuf_with_cap() -> i32
    # Buffer with capacity should have allocated memory
    var b: GrowBuf = growbuf_with_cap(64)
    if b.len != 0
        return 1
    if b.cap != 64
        return 2
    if b.data == null
        return 3
    return 0

[[test]]
fn test_growbuf_append_byte() -> i32
    # Append single bytes
    var b: GrowBuf = growbuf_new()
    b.append_byte('A')
    b.append_byte('B')
    b.append_byte('C')
    if not view_is(b.view(), "ABC")
        return 1
    return 0

[[test]]
fn test_growbuf_append() -> i32
    # Append multiple bytes at once
    var b: GrowBuf = growbuf_new()
    b.append("hello")
    if not view_is(b.view(), "hello")
        return 1
    return 0

[[test]]
fn test_growbuf_append_view() -> i32
    # A "..." literal is a StrView and appends without a length argument.
    var b: GrowBuf = growbuf_new()
    if not b.append_view("key")
        return 1
    b.append_view("")
    b.append_view("=val")
    if not view_is(b.view(), "key=val")
        return 2
    return 0

[[test]]
fn test_growbuf_view_is_zero_copy() -> i32
    var b: GrowBuf = growbuf_new()
    let empty: StrView = b.view()
    if empty.len != 0
        return 1
    b.append("xyz")
    let v: StrView = b.view()
    if v.ptr != b.data
        return 2
    if v.len != 3
        return 3
    return 0

[[test]]
fn test_growbuf_clear() -> i32
    # Clear should reset length but keep capacity
    var b: GrowBuf = growbuf_with_cap(64)
    b.append_byte(65)
    b.append_byte(66)
    if b.len != 2
        return 1
    b.clear()
    if b.len != 0
        return 2
    if b.cap != 64
        return 3
    return 0

[[test]]
fn test_growbuf_grow() -> i32
    # Growth should preserve existing data
    var b: GrowBuf = growbuf_new()
    b.append_byte(65)
    b.append_byte(66)
    b.grow(1024)
    if b.cap != 1024
        return 1
    if not view_is(b.view(), "AB")
        return 2
    return 0

[[test]]
fn test_growbuf_accessors() -> i32
    var b: GrowBuf = growbuf_with_cap(32)
    b.append_byte(65)
    b.append_byte(66)
    if b.len() != 2
        return 1
    if b.cap() != 32
        return 2
    let bytes: Span<u8> = b.as_span()
    if bytes.ptr != b.data or bytes.len != 2
        return 3
    if bytes[0] != 65 or bytes[1] != 66
        return 7
    if b.get(0) != 65
        return 4
    if b.get(1) != 66
        return 5
    if b.is_empty()
        return 6
    return 0

[[test]]
fn test_growbuf_is_empty() -> i32
    # bool predicate
    var b: GrowBuf = growbuf_new()
    if not b.is_empty()
        return 1
    b.append_byte(65)
    if b.is_empty()
        return 2
    b.clear()
    if not b.is_empty()
        return 3
    return 0

# ============================================================================
# Buffer: construction and position
# ============================================================================

[[test]]
fn test_buffer_init() -> i32
    # init points an existing cursor at a Span<u8>
    var buf: Buffer
    buf.init("hello world")
    if buf.len != 11
        return 1
    if buf.pos != 0
        return 2
    return 0

[[test]]
fn test_buf_new_from_view() -> i32
    # buf_new takes a StrView and returns the cursor by value
    let sv: StrView = "hello"
    let buf: Buffer = buf_new(sv)
    if buf.len != 5
        return 1
    if buf.pos != 0
        return 2
    if buf.data != sv.ptr
        return 3
    return 0

[[test]]
fn test_buf_new_sub_view() -> i32
    # A StrView carries its own length: no NUL is needed or read.
    let whole: StrView = "abc123_x9 rest"
    var buf: Buffer = buf_new(whole.take(9))
    let id: StrView = buf.take_ident()
    if not view_is(id, "abc123_x9")
        return 1
    if not buf.eof()
        return 2
    return 0

[[test]]
fn test_buffer_from_str() -> i32
    # buf_from_str takes a StrView (a "..." literal)
    var buf: Buffer
    buf.from_str("hello")
    if buf.len != 5
        return 1
    if buf.pos != 0
        return 2
    return 0

[[test]]
fn test_buffer_eof() -> i32
    # bool predicate
    var buf: Buffer = buf_new("ab")
    if buf.eof()
        return 1
    buf.advance()
    buf.advance()
    if not buf.eof()
        return 2
    return 0

[[test]]
fn test_buffer_remaining() -> i32
    var buf: Buffer = buf_new("hello")
    if buf.remaining() != 5
        return 1
    buf.advance()
    buf.advance()
    if buf.remaining() != 3
        return 2
    return 0

[[test]]
fn test_buf_rest() -> i32
    # The unread tail as a zero-copy slice
    var buf: Buffer = buf_new("hello")
    buf.skip(2)
    let rest: StrView = buf.rest()
    if not view_is(rest, "llo")
        return 1
    if rest.ptr != buf.data + 2
        return 2
    if buf.pos != 2
        return 3
    buf.skip(10)
    if buf.rest().len != 0
        return 4
    return 0

# ============================================================================
# Buffer: peek and advance
# ============================================================================

[[test]]
fn test_buffer_peek() -> i32
    var buf: Buffer = buf_new("abc")
    if buf.peek() != 'a'
        return 1
    if buf.pos != 0
        return 2
    if buf.peek() != 'a'
        return 3
    return 0

[[test]]
fn test_buffer_peek_at() -> i32
    var buf: Buffer = buf_new("abc")
    if buf.peek_at(0) != 'a'
        return 1
    if buf.peek_at(1) != 'b'
        return 2
    if buf.peek_at(2) != 'c'
        return 3
    if buf.peek_at(3) != 0   # Out of bounds
        return 4
    return 0

[[test]]
fn test_buf_peek_view() -> i32
    # Up to n bytes from the cursor, without consuming them
    var buf: Buffer = buf_new("hello")
    if not view_is(buf.peek_view(3), "hel")
        return 1
    if buf.pos != 0
        return 2
    # Clamped to what is left, not truncated to a caller's array
    buf.skip(3)
    if not view_is(buf.peek_view(100), "lo")
        return 3
    if buf.peek_view(0).len != 0
        return 4
    if buf.peek_view(-1).len != 0
        return 5
    return 0

[[test]]
fn test_buffer_advance() -> i32
    var buf: Buffer = buf_new("abc")
    if buf.advance() != 'a'
        return 1
    if buf.pos != 1
        return 2
    if buf.advance() != 'b'
        return 3
    if buf.pos != 2
        return 4
    return 0

# ============================================================================
# Buffer: matching (bool predicates, StrView patterns)
# ============================================================================

[[test]]
fn test_buffer_match_char() -> i32
    var buf: Buffer = buf_new("abc")
    if not buf.match_char('a')
        return 1
    if buf.pos != 1
        return 2
    if buf.match_char('a')    # 'a' again - should fail
        return 3
    if buf.pos != 1
        return 4
    return 0

[[test]]
fn test_buffer_match_str() -> i32
    var buf: Buffer = buf_new("hello world")
    if not buf.match_str("hello")
        return 1
    if buf.pos != 5
        return 2
    if buf.match_str(" there")
        return 3
    if buf.pos != 5
        return 4
    if not buf.match_str(" world")
        return 5
    if buf.pos != 11
        return 6
    # Empty pattern matches anywhere, even at EOF
    if not buf.match_str("")
        return 7
    # Pattern longer than what is left
    buf.restore(9)
    if buf.match_str("ldx")
        return 8
    return 0

[[test]]
fn test_buffer_match_str_not_nul_terminated() -> i32
    # The pattern's length comes from the StrView, so a slice that stops
    # mid-string matches only its own bytes.
    let pat: StrView = "help me"
    var buf: Buffer = buf_new("hello")
    if not buf.match_str(pat.take(3))
        return 1
    if buf.pos != 3
        return 2
    return 0

[[test]]
fn test_buffer_starts_with() -> i32
    var buf: Buffer = buf_new("hello world")
    if not buf.starts_with("hello")
        return 1
    if buf.pos != 0  # Position unchanged
        return 2
    if buf.starts_with("world")
        return 3
    if buf.starts_with("hello world!")
        return 4
    return 0

[[test]]
fn test_buffer_starts_with_stops_at_len() -> i32
    # The bytes after the view DO match: only buf.len may stop the compare.
    let whole: StrView = "hello world"
    var buf: Buffer = buf_new(whole.take(5))
    if buf.starts_with("hello ")
        return 1
    if buf.match_str("hello w")
        return 2
    if buf.pos != 0
        return 3
    if not buf.match_str("hello")
        return 4
    return 0

# ============================================================================
# Buffer: skipping
# ============================================================================

[[test]]
fn test_buffer_skip_whitespace() -> i32
    var buf: Buffer = buf_new("   abc")
    if buf.skip_whitespace() != 3
        return 1
    if buf.pos != 3
        return 2
    if buf.peek() != 'a'
        return 3
    return 0

[[test]]
fn test_buf_take_while_typed_pred() -> i32
    # pred is a real `fn(u8) -> bool`.
    var buf: Buffer = buf_new("aeiXou")
    if buf.take_while(is_vowel).len != 3
        return 1
    if buf.peek() != 'X'
        return 2
    if buf.take_while(is_vowel).len != 0
        return 3
    buf.advance()
    if not view_is(buf.take_while(is_vowel), "ou")
        return 4
    if not buf.eof()
        return 5
    if buf.take_while(is_vowel).len != 0
        return 6
    return 0

[[test]]
fn test_buf_take_while_with_byte_predicates() -> i32
    var buf: Buffer = buf_new(" \t42x_9 ")
    if buf.take_while(buf_is_space).len != 2
        return 1
    if not view_is(buf.take_while(buf_is_digit), "42")
        return 2
    if not view_is(buf.take_while(buf_is_ident), "x_9")
        return 3
    return 0

[[test]]
fn test_byte_predicates() -> i32
    if not buf_is_digit('0') or not buf_is_digit('9')
        return 1
    if buf_is_digit('a') or buf_is_digit('/') or buf_is_digit(':')
        return 2
    if not buf_is_ident('_') or not buf_is_ident('Z') or not buf_is_ident('a') or not buf_is_ident('7')
        return 3
    if buf_is_ident('-') or buf_is_ident(' ') or buf_is_ident('@') or buf_is_ident('[')
        return 4
    if not buf_is_space(' ') or not buf_is_space('\t') or not buf_is_space('\n') or not buf_is_space('\r')
        return 5
    if buf_is_space('x') or buf_is_space(0)
        return 6
    return 0

# ============================================================================
# Buffer: zero-copy reads (StrView slices of the underlying bytes)
# ============================================================================

[[test]]
fn test_buf_take_until() -> i32
    var buf: Buffer = buf_new("name:value")
    let key: StrView = buf.take_until(':')
    if not view_is(key, "name")
        return 1
    # Slice of the buffer itself, no copy
    if key.ptr != buf.data
        return 2
    # Stops before the delimiter
    if buf.peek() != ':'
        return 3
    buf.advance()
    # No delimiter: everything that is left
    if not view_is(buf.take_until('#'), "value")
        return 4
    if not buf.eof()
        return 5
    # At EOF: empty view
    if buf.take_until(':').len != 0
        return 6
    return 0

[[test]]
fn test_buf_take_until_no_truncation() -> i32
    # The old form silently truncated at max_len; a slice cannot.
    var g: GrowBuf = growbuf_new()
    var i: i64 = 0
    while i < 5000
        g.append_byte('a' + (i % 26) as u8)
        i += 1
    g.append_byte(';')
    var buf: Buffer = buf_new(g.view())
    let v: StrView = buf.take_until(';')
    if v.len != 5000
        return 1
    if buf.pos != 5000
        return 2
    return 0

[[test]]
fn test_buf_take_while() -> i32
    var buf: Buffer = buf_new("ouch")
    let v: StrView = buf.take_while(is_vowel)
    if not view_is(v, "ou")
        return 1
    if buf.pos != 2
        return 2
    if buf.take_while(never).len != 0
        return 3
    if buf.pos != 2
        return 4
    return 0

[[test]]
fn test_buf_take_digits() -> i32
    var buf: Buffer = buf_new("12345abc")
    let v: StrView = buf.take_digits()
    if not view_is(v, "12345")
        return 1
    if buf.pos != 5
        return 2
    # Not at a digit: empty, position unchanged
    if buf.take_digits().len != 0
        return 3
    if buf.pos != 5
        return 4
    return 0

[[test]]
fn test_buf_take_ident() -> i32
    var buf: Buffer = buf_new("abc_123 end")
    if not view_is(buf.take_ident(), "abc_123")
        return 1
    if buf.peek() != ' '
        return 2
    if buf.take_ident().len != 0
        return 3
    return 0

[[test]]
fn test_buf_take_quoted_escapes() -> i32
    # Escapes are decoded, so the result cannot be a slice; it is appended
    # to a String the caller owns.  No max_len, no truncation.
    var buf: Buffer = buf_new("\"a\\tb\\\"c\\\\d\\n\\qe\" tail")
    var s: String = string_new()
    if not buf.take_quoted('"', @&s)
        return 1
    if not s.eq("a\tb\"c\\d\nqe")
        return 2
    # Past the closing quote
    if buf.pos != 17
        return 3
    if buf.peek() != ' '
        return 4
    return 0

[[test]]
fn test_buf_take_quoted_appends() -> i32
    var buf: Buffer = buf_new("'x' 'yz'")
    var s: String = string_new()
    s.push_str("<")
    buf.take_quoted('\'', @&s)
    buf.skip_whitespace()
    buf.take_quoted('\'', @&s)
    if not s.eq("<xyz")
        return 1
    return 0

[[test]]
fn test_buf_take_quoted_not_at_quote() -> i32
    var buf: Buffer = buf_new("abc")
    var s: String = string_new()
    if buf.take_quoted('"', @&s)
        return 1
    if buf.pos != 0
        return 2
    if s.len() != 0
        return 3
    return 0

[[test]]
fn test_buf_take_quoted_unterminated() -> i32
    # false; the partial content is left in `out`, the cursor at EOF
    var buf: Buffer = buf_new("'unterminated")
    var s: String = string_new()
    if buf.take_quoted('\'', @&s)
        return 1
    if not s.eq("unterminated")
        return 2
    if not buf.eof()
        return 3
    # A trailing lone backslash is unterminated too
    var b2: Buffer = buf_new("\"ab\\")
    var s2: String = string_new()
    if b2.take_quoted('"', @&s2)
        return 4
    if not s2.eq("ab")
        return 5
    return 0

[[test]]
fn test_buf_take_quoted_long() -> i32
    # Longer than any old out-buffer: nothing is dropped
    var g: GrowBuf = growbuf_new()
    g.append_byte('"')
    var i: i64 = 0
    while i < 3000
        g.append_byte('q')
        i += 1
    g.append_byte('"')
    var buf: Buffer = buf_new(g.view())
    var s: String = string_new()
    if not buf.take_quoted('"', @&s)
        return 1
    if s.len() != 3000
        return 2
    if not buf.eof()
        return 3
    return 0

# ============================================================================
# Buffer: save/restore and line:col
# ============================================================================

[[test]]
fn test_buffer_save_restore() -> i32
    var buf: Buffer = buf_new("hello")
    buf.advance()
    buf.advance()
    let saved: i64 = buf.save()
    if saved != 2
        return 1
    buf.advance()
    buf.advance()
    if buf.pos != 4
        return 2
    buf.restore(saved)
    if buf.pos != 2
        return 3
    return 0

[[test]]
fn test_buffer_get_loc() -> i32
    var buf: Buffer = buf_new("line1\nline2\nline3")
    var loc: BufLoc

    buf.get_loc(@&loc)
    if loc.line != 1
        return 1
    if loc.col != 1
        return 2

    buf.skip(6)  # "line1\n"
    buf.get_loc(@&loc)
    if loc.line != 2
        return 3
    if loc.col != 1
        return 4

    buf.skip(2)  # "li"
    buf.get_loc(@&loc)
    if loc.line != 2
        return 5
    if loc.col != 3
        return 6
    return 0

# ============================================================================
# Deprecated out-buffer forms (kept for one release after #1478)
# ============================================================================

[[test]]
fn test_legacy_read_until() -> i32
    var buf: Buffer = buf_new("hello,world")
    var out: [16]u8
    let count: i64 = buf.read_until(',', Span<u8> { ptr: @out[0], len: 16 })
    if count != 5
        return 1
    if out[0] != 'h'
        return 2
    if out[4] != 'o'
        return 3
    if out[5] != 0    # NUL terminator
        return 4
    return 0

[[test]]
fn test_legacy_read_while_digit() -> i32
    var buf: Buffer = buf_new("12345abc")
    var out: [16]u8
    if buf.read_while_digit(Span<u8> { ptr: @out[0], len: 16 }) != 5
        return 1
    if out[0] != '1' or out[4] != '5'
        return 2
    return 0

[[test]]
fn test_legacy_peek_n() -> i32
    var buf: Buffer = buf_new("hello")
    var out: [8]u8
    if buf.peek_n(Span<u8> { ptr: @out[0], len: 3 }) != 3
        return 1
    if out[0] != 'h' or out[2] != 'l'
        return 2
    return 0

[[test]]
fn test_buf_skip_while_typed_pred() -> i32
    var buf: Buffer = buf_new("123ab")
    if buf.skip_while(buf_is_digit) != 3
        return 1
    if buf.pos != 3
        return 2
    if buf.skip_while(buf_is_digit) != 0
        return 3
    if buf.skip_while(buf_is_ident) != 2
        return 4
    if not buf.eof()
        return 5
    return 0
