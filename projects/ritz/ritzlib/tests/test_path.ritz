# Tests for ritzlib/path.ritz: lexical path resolution (AGAST #4776).
#
# Harland's kernel takes absolute paths only, so userspace resolves a
# relative path and its `.`/`..` against the cwd before the syscall.

import ritzlib.errno
import ritzlib.fs { chdir }
import ritzlib.path
import ritzlib.result
import ritzlib.string
import ritzlib.strview

# Whether resolving `path` against `cwd` gives exactly `want`.
fn resolves_to(cwd: StrView, path: StrView, want: StrView) -> bool
    match path_resolve(cwd, path)
        Ok(out) => out.eq(want)
        Err(_) => false

# Errno codes the resolver returns (Errno carries data, so it has no ==).
const NOENT: i32 = 2
const INVAL: i32 = 22
const NAMETOOLONG: i32 = 36

# The Errno code resolving `path` against `cwd` fails with; 0 on Ok.
fn resolve_error(cwd: StrView, path: StrView) -> i32
    match path_resolve(cwd, path)
        Ok(_) => 0
        Err(e) => e.code()

[[test]]
fn test_absolute_passes_through() -> i32
    assert resolves_to("/bin", "/etc/hostname", "/etc/hostname")
    assert resolves_to("/", "/", "/")
    0

[[test]]
fn test_relative_joins_cwd() -> i32
    assert resolves_to("/", "etc", "/etc")
    assert resolves_to("/", "etc/hostname", "/etc/hostname")
    assert resolves_to("/etc", "hostname", "/etc/hostname")
    assert resolves_to("/a/b", "c/d", "/a/b/c/d")
    0

[[test]]
fn test_dot_is_the_same_directory() -> i32
    assert resolves_to("/etc", ".", "/etc")
    assert resolves_to("/etc", "./motd", "/etc/motd")
    assert resolves_to("/", ".", "/")
    0

[[test]]
fn test_dotdot_is_the_parent() -> i32
    assert resolves_to("/etc", "..", "/")
    assert resolves_to("/bin", "../etc", "/etc")
    assert resolves_to("/bin", "../etc/hostname", "/etc/hostname")
    assert resolves_to("/a/b/c", "../..", "/a")
    0

[[test]]
fn test_dotdot_clamps_at_root() -> i32
    assert resolves_to("/", "..", "/")
    assert resolves_to("/bin", "../..", "/")
    assert resolves_to("/bin", "../../../etc", "/etc")
    assert resolves_to("/x", "/../..", "/")
    0

[[test]]
fn test_mixed_components() -> i32
    assert resolves_to("/", "a/./b/../c", "/a/c")
    assert resolves_to("/q", "/a/./b/../c", "/a/c")
    # `..` is a component, not a prefix: these are names.
    assert resolves_to("/", "..a/b..", "/..a/b..")
    assert resolves_to("/", ".hidden", "/.hidden")
    0

[[test]]
fn test_repeated_and_trailing_slashes() -> i32
    assert resolves_to("/", "//etc//hostname", "/etc/hostname")
    assert resolves_to("/", "etc/", "/etc")
    assert resolves_to("/", "etc///", "/etc")
    assert resolves_to("/", "///", "/")
    0

[[test]]
fn test_cwd_is_normalised_too() -> i32
    assert resolves_to("/etc/", "motd", "/etc/motd")
    assert resolves_to("//a/./b/", "..", "/a")
    0

[[test]]
fn test_empty_path_is_noent() -> i32
    assert resolve_error("/", "") == NOENT
    0

[[test]]
fn test_relative_cwd_is_inval() -> i32
    assert resolve_error("etc", "motd") == INVAL
    assert resolve_error("", "motd") == INVAL
    # An absolute path needs no cwd.
    assert resolves_to("", "/etc", "/etc")
    0

# A path of `n` bytes: "/" then n - 1 'a's.
fn long_path(n: i64) -> String
    var s: String = string_new()
    s.push('/')
    for i in 1..n
        s.push('a')
    s

[[test]]
fn test_path_max() -> i32
    # PATH_MAX counts the NUL a syscall needs, so PATH_MAX - 1 bytes fit.
    var fits: String = long_path(PATH_MAX - 1)
    assert resolves_to("/", fits.as_view(), fits.as_view())
    var over: String = long_path(PATH_MAX)
    assert resolve_error("/", over.as_view()) == NAMETOOLONG
    # The limit is on the resolved path: the join can overflow it...
    var name: String = string_new()
    for i in 0..PATH_MAX - 2
        name.push('a')
    assert resolve_error("/bin", name.as_view()) == NAMETOOLONG
    # ...and `..` can bring a long spelling back under it.
    var back: String = long_path(PATH_MAX)
    back.push_str("/..")
    assert resolves_to("/", back.as_view(), "/")
    0


# Whether path_absolute(path) gives exactly `want`.
fn absolute_is(path: StrView, want: StrView) -> bool
    match path_absolute(path)
        Ok(out) => out.eq(want)
        Err(_) => false

# path_absolute reads this process's cwd (each [[test]] runs in its own
# child, so the chdir stays here).
[[test]]
fn test_path_absolute_uses_getcwd() -> i32
    assert chdir("/").is_ok()
    assert absolute_is("etc/../tmp/", "/tmp")
    assert chdir("/tmp").is_ok()
    assert absolute_is(".", "/tmp")
    assert absolute_is("/a/./b", "/a/b")
    0
