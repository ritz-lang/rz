# Tests for fs.ritz path manipulation (AGAST #1477): one StrView API.
#
# path_basename/dirname/extension/stem return a StrView INTO the input (no
# allocation); path_join returns an owned String. Filesystem-touching tests
# live in test_fs_ops.ritz, which keeps each file under build.py's per-file
# test timeout.

import ritzlib.fs
import ritzlib.string
import ritzlib.strview

# a == b, byte for byte.
fn sv_is(a: StrView, b: StrView) -> bool
    strview_eq(@a, @b) == 1

fn string_is(s: @String, b: StrView) -> bool
    string_eq(s, b)

# ============================================================================
# path_join -> String
# ============================================================================

[[test]]
fn test_path_join() -> i32
    var r: String = path_join("/home/user", "file.txt")
    if not string_is(@r, "/home/user/file.txt")
        return 1
    0

[[test]]
fn test_path_join_trailing_slash() -> i32
    var r: String = path_join("/home/user/", "file.txt")
    if not string_is(@r, "/home/user/file.txt")
        return 1
    0

[[test]]
fn test_path_join_empty_dir() -> i32
    # No separator is invented for an empty directory part.
    var r: String = path_join("", "file.txt")
    if not string_is(@r, "file.txt")
        return 1
    0

[[test]]
fn test_path_join_from_string_views() -> i32
    # String callers pass string_as_view.
    var dir: String = string_from("/tmp")
    var name: String = string_from("x")
    var r: String = path_join(string_as_view(@dir), string_as_view(@name))
    if not string_is(@r, "/tmp/x")
        return 1
    0

[[test]]
fn test_path_join_ignores_bytes_past_view() -> i32
    # A StrView carries no terminator: only `len` bytes may be copied.
    let whole: StrView = "/tmpGARBAGE"
    let dir: StrView = strview_slice(@whole, 0, 4)
    var r: String = path_join(dir, "f")
    if not string_is(@r, "/tmp/f")
        return 1
    0

# ============================================================================
# path_basename -> StrView
# ============================================================================

[[test]]
fn test_path_basename() -> i32
    if not sv_is(path_basename("/home/user/file.txt"), "file.txt")
        return 1
    0

[[test]]
fn test_path_basename_no_slash() -> i32
    if not sv_is(path_basename("file.txt"), "file.txt")
        return 1
    0

[[test]]
fn test_path_basename_is_view_into_input() -> i32
    let p: StrView = "/home/user/file.txt"
    let b: StrView = path_basename(p)
    if b.ptr != p.ptr + 11
        return 1
    if b.len != 8
        return 2
    0

# ============================================================================
# path_dirname -> StrView
# ============================================================================

[[test]]
fn test_path_dirname() -> i32
    if not sv_is(path_dirname("/home/user/file.txt"), "/home/user")
        return 1
    0

[[test]]
fn test_path_dirname_root() -> i32
    if not sv_is(path_dirname("/file.txt"), "/")
        return 1
    0

[[test]]
fn test_path_dirname_no_slash() -> i32
    if not sv_is(path_dirname("file.txt"), ".")
        return 1
    0

[[test]]
fn test_path_dirname_is_view_into_input() -> i32
    let p: StrView = "/home/user/file.txt"
    let d: StrView = path_dirname(p)
    if d.ptr != p.ptr
        return 1
    if d.len != 10
        return 2
    0

# ============================================================================
# path_extension / path_stem -> StrView
# ============================================================================

[[test]]
fn test_path_extension() -> i32
    if not sv_is(path_extension("/home/user/file.txt"), "txt")
        return 1
    0

[[test]]
fn test_path_extension_none() -> i32
    # Bound first: ritz1 cannot read a field off a call result (#1647).
    let ext: StrView = path_extension("/home/user/file")
    if ext.len != 0
        return 1
    0

[[test]]
fn test_path_extension_dotfile() -> i32
    # A leading dot names a hidden file; it does not start an extension.
    # Bound first: ritz1 cannot read a field off a call result (#1647).
    let ext: StrView = path_extension("/home/user/.gitignore")
    if ext.len != 0
        return 1
    0

[[test]]
fn test_path_extension_dot_in_directory() -> i32
    # The dot belongs to a directory component, not the file.
    # Bound first: ritz1 cannot read a field off a call result (#1647).
    let ext: StrView = path_extension("/a.d/file")
    if ext.len != 0
        return 1
    0

[[test]]
fn test_path_stem() -> i32
    if not sv_is(path_stem("/home/user/file.txt"), "/home/user/file")
        return 1
    0

[[test]]
fn test_path_stem_no_ext() -> i32
    if not sv_is(path_stem("/home/user/file"), "/home/user/file")
        return 1
    0

[[test]]
fn test_string_as_view() -> i32
    var s: String = string_from("abc")
    let v: StrView = string_as_view(@s)
    if v.len != 3
        return 1
    if not sv_is(v, "abc")
        return 2
    0
