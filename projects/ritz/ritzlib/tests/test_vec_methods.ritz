# Tests for Vec<T> method syntax (v.method() instead of vec_method<T>(@v))
import ritzlib.gvec
import ritzlib.sys
import ritzlib.string

# ============================================================================
# Basic method tests
# ============================================================================

[[test]]
fn test_vec_method_len() -> i32
    var v: Vec<i64> = vec_new<i64>()
    if v.len() != 0
        return 1
    v.push(10)
    if v.len() != 1
        return 2
    return 0

[[test]]
fn test_vec_method_cap() -> i32
    var v: Vec<i64> = vec_with_cap<i64>(16)
    if v.cap() < 16
        return 1
    return 0

[[test]]
fn test_vec_method_is_empty_true() -> i32
    var v: Vec<i32> = vec_new<i32>()
    if not v.is_empty()
        return 1
    return 0

[[test]]
fn test_vec_method_is_empty_false() -> i32
    var v: Vec<i32> = vec_new<i32>()
    v.push(42)
    if v.is_empty()
        return 1
    return 0

[[test]]
fn test_vec_method_push() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(100)
    v.push(200)
    v.push(300)
    if v.len() != 3
        return 1
    return 0

[[test]]
fn test_vec_method_pop() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(10)
    v.push(20)
    v.push(30)
    let x: i64 = v.pop()
    if x != 30
        return 1
    if v.len() != 2
        return 2
    return 0

[[test]]
fn test_vec_method_get() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(100)
    v.push(200)
    v.push(300)
    if v.get(0) != 100
        return 1
    if v.get(1) != 200
        return 2
    if v.get(2) != 300
        return 3
    return 0

[[test]]
fn test_vec_method_set() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.set(1, 42)
    if v.get(1) != 42
        return 1
    return 0

# Vec.set past the end is a bug in the caller, not a status to return (AGAST
# #4648): it ends the program with status 101, as `m[k]` on a missing key
# does.  The child's stderr is closed so the message doesn't reach the log.
fn vec_set_exit_code(idx: i64) -> i32
    let pid: i32 = sys_fork()
    if pid == 0
        sys_close(2)
        var v: Vec<i64> = vec_new<i64>()
        v.push(1)
        v.push(2)
        v.push(3)
        v.set(idx, 9)
        sys_exit(0)
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    return (status >> 8) & 255

[[test]]
fn test_vec_method_set_out_of_range_ends_program() -> i32
    if vec_set_exit_code(2) != 0
        return 1
    if vec_set_exit_code(3) != 101
        return 2
    if vec_set_exit_code(-1) != 101
        return 3
    return 0

[[test]]
fn test_vec_method_clear() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.clear()
    if v.len() != 0
        return 1
    if not v.is_empty()
        return 2
    return 0

[[test]]
fn test_vec_method_first() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(100)
    v.push(200)
    v.push(300)
    if v.first() != 100
        return 1
    return 0

[[test]]
fn test_vec_method_last() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(100)
    v.push(200)
    v.push(300)
    if v.last() != 300
        return 1
    return 0

[[test]]
fn test_vec_method_slice() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)

    var part: Vec<i64> = v.slice(1, 4)
    if part.len() != 3
        return 1
    if part.get(0) != 20
        return 2
    if part.get(1) != 30
        return 3
    if part.get(2) != 40
        return 4
    return 0

# ============================================================================
# Chaining tests
# ============================================================================

[[test]]
fn test_vec_method_chaining() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(1)
    v.push(2)
    v.push(3)

    # Chain: get slice, then get length
    var part: Vec<i64> = v.slice(0, 2)
    if part.len() != 2
        return 1

    # Get first from slice
    if part.first() != 1
        return 2

    # Get last from slice
    if part.last() != 2
        return 3

    return 0

# ============================================================================
# Type variations (ensure generic impl works for different types)
# ============================================================================

[[test]]
fn test_vec_method_i32() -> i32
    var v: Vec<i32> = vec_new<i32>()
    v.push(42 as i32)
    v.push(99 as i32)
    if v.len() != 2
        return 1
    if v.get(0) != 42 as i32
        return 2
    return 0

[[test]]
fn test_vec_method_u8() -> i32
    var v: Vec<u8> = vec_new<u8>()
    v.push(65)  # 'A'
    v.push(66)  # 'B'
    v.push(67)  # 'C'
    if v.len() != 3
        return 1
    if v.first() != 65
        return 2
    if v.last() != 67
        return 3
    return 0

# ============================================================================
# replace: move an element out of the middle
# ============================================================================

[[test]]
fn test_vec_method_replace() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(10)
    v.push(20)
    v.push(30)
    if v.replace(1, 25) != 20
        return 1
    if v.len() != 3 or v.get(1) != 25
        return 2
    if v.get(0) != 10 or v.get(2) != 30
        return 3
    return 0

# A move-only element comes out whole and owned; the new one stays in.
[[test]]
fn test_vec_method_replace_move_only() -> i32
    var v: Vec<String> = vec_new<String>()
    v.push(string_from("one"))
    v.push(string_from("two"))
    var out: String = v.replace(0, string_from("uno"))
    if not out.eq("one")
        return 1
    out = v.replace(1, string_new())
    if not out.eq("two")
        return 2
    if v.len() != 2
        return 3
    # Vec drops only its buffer: release the elements it still holds.
    var a: String = v.replace(0, string_new())
    if not a.eq("uno")
        return 4
    return 0

# ============================================================================
# as_view: the elements' bytes as a StrView (AGAST #4773)
# ============================================================================

# A Vec<u8> views as its text: same bytes, same length, no copy.
[[test]]
fn test_vec_as_view_bytes() -> i32
    var v: Vec<u8> = vec_new<u8>()
    v.push_view("abc")
    let sv: StrView = v.as_view()
    if sv.len != 3
        return 1
    if not sv.eq("abc")
        return 2
    if sv.ptr != v.as_ptr()
        return 3
    return 0

# An empty Vec views as an empty StrView.
[[test]]
fn test_vec_as_view_empty() -> i32
    var v: Vec<u8> = vec_new<u8>()
    let sv: StrView = v.as_view()
    if sv.len != 0
        return 1
    if not sv.is_empty()
        return 2
    return 0

# The view tracks the Vec as it is when taken: a later push is not in it.
[[test]]
fn test_vec_as_view_snapshot_len() -> i32
    var v: Vec<u8> = vec_with_cap<u8>(8)
    v.push_view("ab")
    let sv: StrView = v.as_view()
    v.push(99)
    if sv.len != 2
        return 1
    if v.as_view().len != 3
        return 2
    return 0

# A wider element views as all of its bytes: len * sizeof(T).
[[test]]
fn test_vec_as_view_wide_elements() -> i32
    var v: Vec<u32> = vec_new<u32>()
    v.push(1)
    v.push(2)
    let sv: StrView = v.as_view()
    if sv.len != 8
        return 1
    if sv.ptr != v.as_ptr() as *u8
        return 2
    return 0
