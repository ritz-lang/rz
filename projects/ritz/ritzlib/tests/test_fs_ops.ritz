# Tests for fs.ritz filesystem operations over StrView paths (AGAST #1477).
#
# Predicates (path_exists/is_dir/is_file/is_symlink) return bool. Fallible
# operations return Result<T, Errno> (ritzlib.errno, AGAST #4248): the helpers
# below compare errno_code(e), 2 = ENOENT, 17 = EEXIST.
#
# Each test owns its fixtures under /tmp and removes them, so the verdict does
# not depend on the cwd build.py runs the binary from.

import ritzlib.sys
import ritzlib.fs
import ritzlib.errno
import ritzlib.str
import ritzlib.memory
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.string
import ritzlib.strview
import ritzlib.result

# "/tmp/ritzlib_<pid>_<name>" into dst (>= 96 bytes); returns dst. The pid
# keeps concurrent test runs (gate slots, compiler variants) off each other's
# fixtures (AGAST #4084). ritzlib.testlib's make_sandbox_path does the same,
# but its pub read_file/write_file collide with ritzlib.fs's.
fn pid_tmp_path(dst: *u8, name: *u8) -> *u8
    let head: *u8 = c"/tmp/ritzlib_"
    let head_len: i64 = strlen(head)
    memcpy(dst, head, head_len)
    var i: i64 = head_len + fmt_i64_into(dst + head_len, sys_getpid() as i64)
    *(dst + i) = '_'
    i += 1
    let name_len: i64 = strlen(name)
    memcpy(dst + i, name, name_len)
    *(dst + i + name_len) = 0
    dst

# pid_tmp_path as a StrView.
fn tmp_view(dst: *u8, name: *u8) -> StrView
    strview_from_cstr(pid_tmp_path(dst, name))

fn i64_err(r: *Result<i64, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

fn i64_ok(r: *Result<i64, Errno>) -> i64
    match *r
        Ok(v) => v
        Err(_) => -1

fn unit_err(r: *Result<i32, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

fn string_err(r: *Result<String, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

# 1 if `r` is Ok and its String equals `want`.
fn string_ok_is(r: *Result<String, Errno>, want: StrView) -> i32
    match *r
        Ok(s) => s.eq(want) as i32
        Err(_) => 0

# ============================================================================
# Predicates -> bool
# ============================================================================

[[test]]
fn test_path_exists() -> i32
    if not path_exists("/tmp")
        return 1
    if path_exists("/nonexistent/path/that/should/not/exist")
        return 2
    0

[[test]]
fn test_path_exists_uses_view_length() -> i32
    # "/tmp" followed by bytes outside the view: the kernel must see "/tmp".
    let whole: StrView = "/tmpNOPE_NOT_A_DIR"
    if not path_exists(whole.slice(0, 4))
        return 1
    0

[[test]]
fn test_is_dir() -> i32
    if not is_dir("/tmp")
        return 1
    if is_dir("/nonexistent/x")
        return 2
    0

[[test]]
fn test_is_file() -> i32
    var pathbuf: [96]u8
    let path: StrView = tmp_view(@pathbuf[0], c"fs_ops_file.tmp")
    var w: Result<i64, Errno> = write_file(path, "x")
    if i64_err(@w) != 0
        return 1
    if not is_file(path)
        return 2
    # A directory must not satisfy the predicate.
    if is_file("/tmp")
        return 3
    unlink(path)
    if is_file(path)
        return 4
    0

[[test]]
fn test_is_symlink() -> i32
    var linkbuf: [96]u8
    let link: StrView = tmp_view(@linkbuf[0], c"fs_ops_link.tmp")
    unlink(link)
    if sys_symlink(c"/tmp", @linkbuf[0]) != 0
        return 1
    if not is_symlink(link)
        return 2
    # Predicates use lstat: the link itself is not a directory.
    if is_dir(link)
        return 3
    if is_symlink("/tmp")
        return 4
    unlink(link)
    0

# ============================================================================
# file_size -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_file_size_ok() -> i32
    var pathbuf: [96]u8
    let path: StrView = tmp_view(@pathbuf[0], c"fs_ops_size.tmp")
    var w: Result<i64, Errno> = write_file(path, "12345")
    if i64_err(@w) != 0
        return 1
    var r: Result<i64, Errno> = file_size(path)
    unlink(path)
    if i64_ok(@r) != 5
        return 2
    0

[[test]]
fn test_file_size_err_is_errno() -> i32
    var r: Result<i64, Errno> = file_size("/nonexistent/path")
    if i64_err(@r) != 2
        return 1
    0

# ============================================================================
# read_file -> Result<String, Errno>, write_file -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_write_then_read_file() -> i32
    var pathbuf: [96]u8
    let path: StrView = tmp_view(@pathbuf[0], c"fs_ops_rw.tmp")
    var w: Result<i64, Errno> = write_file(path, "Hello, Result!")
    if i64_ok(@w) != 14
        return 1
    var r: Result<String, Errno> = read_file(path)
    unlink(path)
    if string_ok_is(@r, "Hello, Result!") == 0
        return 2
    0

[[test]]
fn test_read_file_missing_is_enoent() -> i32
    var missingbuf: [96]u8
    var r: Result<String, Errno> = read_file(tmp_view(@missingbuf[0], c"does_not_exist.tmp"))
    if string_err(@r) != 2
        return 1
    0

[[test]]
fn test_read_file_missing_is_noent_variant() -> i32
    # The Err is the typed variant, not just a number that happens to be 2.
    var missingbuf: [96]u8
    match read_file(tmp_view(@missingbuf[0], c"does_not_exist.tmp"))
        Ok(_) => return 1
        Err(e) => match e
            NoEnt => pass
            _ => return 2
    0

[[test]]
fn test_read_file_dir_is_eisdir() -> i32
    match read_file("/tmp")
        Ok(_) => return 1
        Err(e) => match e
            IsDir => pass
            _ => return 2
    0

[[test]]
fn test_write_file_bad_dir_is_enoent() -> i32
    var w: Result<i64, Errno> = write_file("/nonexistent/dir/f", "x")
    if i64_err(@w) != 2
        return 1
    0

# ============================================================================
# mkdir / rmdir / unlink -> Result<i32, Errno>
# ============================================================================

[[test]]
fn test_mkdir_rmdir() -> i32
    var pathbuf: [96]u8
    let path: StrView = tmp_view(@pathbuf[0], c"fs_ops_dir")
    rmdir(path)
    var mk: Result<i32, Errno> = mkdir(path, 493)  # 0755
    if unit_err(@mk) != 0
        return 1
    if not is_dir(path)
        return 2
    var again: Result<i32, Errno> = mkdir(path, 493)
    if unit_err(@again) != 17
        return 3
    match again
        Ok(_) => return 6
        Err(e) => match e
            Exist => pass
            _ => return 7
    var rm: Result<i32, Errno> = rmdir(path)
    if unit_err(@rm) != 0
        return 4
    if path_exists(path)
        return 5
    0

[[test]]
fn test_unlink_missing_is_enoent() -> i32
    var missingbuf: [96]u8
    var r: Result<i32, Errno> = unlink(tmp_view(@missingbuf[0], c"does_not_exist.tmp"))
    if unit_err(@r) != 2
        return 1
    0

# ============================================================================
# copy_file -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_copy_file() -> i32
    var srcbuf: [96]u8
    let src: StrView = tmp_view(@srcbuf[0], c"fs_ops_src.tmp")
    var dstbuf: [96]u8
    let dst: StrView = tmp_view(@dstbuf[0], c"fs_ops_dst.tmp")
    write_file(src, "Content to copy")
    var c: Result<i64, Errno> = copy_file(src, dst, 420)  # 0644
    if i64_ok(@c) != 15
        return 1
    var r: Result<String, Errno> = read_file(dst)
    unlink(src)
    unlink(dst)
    if string_ok_is(@r, "Content to copy") == 0
        return 2
    0

[[test]]
fn test_copy_file_missing_src_is_enoent() -> i32
    var missingbuf: [96]u8
    var neverbuf: [96]u8
    let never: StrView = tmp_view(@neverbuf[0], c"fs_ops_never.tmp")
    var c: Result<i64, Errno> = copy_file(tmp_view(@missingbuf[0], c"does_not_exist.tmp"), never, 420)
    if i64_err(@c) != 2
        return 1
    if path_exists(never)
        return 2
    0

# ============================================================================
# dir_open(StrView) -> Result<DirIter, Errno>
# ============================================================================

[[test]]
fn test_dir_open_view() -> i32
    match dir_open("/tmp")
        Ok(d) =>
            var dir: DirIter = d
            dir.close()
        Err(_) => return 1
    match dir_open("/nonexistent/x")
        Ok(_) => return 2
        Err(e) => match e
            NoEnt => pass
            _ => return 3
    match dir_open("/proc/self/exe")
        Ok(_) => return 4
        Err(e) => match e
            NotDir => pass
            _ => return 5
    0
