# Tests for fs.ritz filesystem operations over StrView paths (AGAST #1477).
#
# Predicates (path_exists/is_dir/is_file/is_symlink) return bool. Fallible
# operations return Result<T, Errno> (ritzlib.errno, AGAST #4248): the helpers
# below compare e.code(), 2 = ENOENT, 17 = EEXIST.
#
# Each test owns its fixtures under a sandbox_path and removes them, so the verdict does
# not depend on the cwd build.py runs the binary from.

import ritzlib.fs
import ritzlib.errno
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.gvec
import ritzlib.testlib

# errno code of `r`'s Err, 0 when it is Ok.
fn err_code<T>(r: @Result<T, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

# true if `r` is Ok and its String equals `want`.
fn string_ok_is(r: @Result<String, Errno>, want: StrView) -> bool
    match *r
        Ok(s) => s.eq(want)
        Err(_) => false

# ============================================================================
# Predicates -> bool
# ============================================================================

[[test]]
fn test_path_exists() -> i32
    if not path_exists("/tmp")
        return 1
    if path_exists("/nonexistent/path/that/should/not/exist")
        return 2
    0

[[test]]
fn test_path_exists_uses_view_length() -> i32
    # "/tmp" followed by bytes outside the view: the kernel must see "/tmp".
    let whole: StrView = "/tmpNOPE_NOT_A_DIR"
    if not path_exists(whole.slice(0, 4))
        return 1
    0

[[test]]
fn test_is_dir() -> i32
    if not is_dir("/tmp")
        return 1
    if is_dir("/nonexistent/x")
        return 2
    0

[[test]]
fn test_is_file() -> i32
    let path: String = sandbox_path("fs_ops", "file.tmp")
    var w: Result<i64, Errno> = write_file(path.as_view(), "x")
    if err_code(@w) != 0
        return 1
    if not is_file(path.as_view())
        return 2
    # A directory must not satisfy the predicate.
    if is_file("/tmp")
        return 3
    unlink(path.as_view())
    if is_file(path.as_view())
        return 4
    0

[[test]]
fn test_is_symlink() -> i32
    let link: String = sandbox_path("fs_ops", "link.tmp")
    unlink(link.as_view())
    if symlink("/tmp", link.as_view()).is_err()
        return 1
    if not is_symlink(link.as_view())
        return 2
    # Predicates use lstat: the link itself is not a directory.
    if is_dir(link.as_view())
        return 3
    if is_symlink("/tmp")
        return 4
    unlink(link.as_view())
    0

# ============================================================================
# file_size -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_file_size_ok() -> i32
    let path: String = sandbox_path("fs_ops", "size.tmp")
    var w: Result<i64, Errno> = write_file(path.as_view(), "12345")
    if err_code(@w) != 0
        return 1
    var r: Result<i64, Errno> = file_size(path.as_view())
    unlink(path.as_view())
    if r.unwrap_or(-1) != 5
        return 2
    0

[[test]]
fn test_file_size_err_is_errno() -> i32
    var r: Result<i64, Errno> = file_size("/nonexistent/path")
    if err_code(@r) != 2
        return 1
    0

# ============================================================================
# read_file -> Result<String, Errno>, write_file -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_write_then_read_file() -> i32
    let path: String = sandbox_path("fs_ops", "rw.tmp")
    var w: Result<i64, Errno> = write_file(path.as_view(), "Hello, Result!")
    if w.unwrap_or(-1) != 14
        return 1
    var r: Result<String, Errno> = read_file(path.as_view())
    unlink(path.as_view())
    if not string_ok_is(@r, "Hello, Result!")
        return 2
    0

[[test]]
fn test_read_file_missing_is_enoent() -> i32
    let missing: String = sandbox_path("fs_ops", "does_not_exist.tmp")
    var r: Result<String, Errno> = read_file(missing.as_view())
    if err_code(@r) != 2
        return 1
    0

[[test]]
fn test_read_file_missing_is_noent_variant() -> i32
    # The Err is the typed variant, not just a number that happens to be 2.
    let missing: String = sandbox_path("fs_ops", "does_not_exist.tmp")
    match read_file(missing.as_view())
        Ok(_) => return 1
        Err(e) => match e
            NoEnt => pass
            _ => return 2
    0

[[test]]
fn test_read_file_dir_is_eisdir() -> i32
    match read_file("/tmp")
        Ok(_) => return 1
        Err(e) => match e
            IsDir => pass
            _ => return 2
    0

# write_file replaces the whole file: a shorter rewrite leaves no tail of the
# old bytes, and an empty one leaves an empty file (AGAST #4830).
[[test]]
fn test_write_file_shorter_replaces_all() -> i32
    let path: String = sandbox_path("fs_ops", "shorter.tmp")
    write_file(path.as_view(), "Hello, world")
    var w: Result<i64, Errno> = write_file(path.as_view(), "Hi")
    var r: Result<String, Errno> = read_file(path.as_view())
    unlink(path.as_view())
    if w.unwrap_or(-1) != 2
        return 1
    if not string_ok_is(@r, "Hi")
        return 2
    0

[[test]]
fn test_write_file_empty_truncates() -> i32
    let path: String = sandbox_path("fs_ops", "empty.tmp")
    write_file(path.as_view(), "old contents")
    var w: Result<i64, Errno> = write_file(path.as_view(), "")
    var size: Result<i64, Errno> = file_size(path.as_view())
    var r: Result<String, Errno> = read_file(path.as_view())
    unlink(path.as_view())
    if w.unwrap_or(-1) != 0
        return 1
    if size.unwrap_or(-1) != 0
        return 2
    if not string_ok_is(@r, "")
        return 3
    0

[[test]]
fn test_write_file_empty_creates() -> i32
    let path: String = sandbox_path("fs_ops", "new_empty.tmp")
    unlink(path.as_view())
    var w: Result<i64, Errno> = write_file(path.as_view(), "")
    let made: bool = is_file(path.as_view())
    var size: Result<i64, Errno> = file_size(path.as_view())
    unlink(path.as_view())
    if w.unwrap_or(-1) != 0
        return 1
    if not made
        return 2
    if size.unwrap_or(-1) != 0
        return 3
    0

[[test]]
fn test_write_file_to_dir_is_eisdir() -> i32
    match write_file("/tmp", "x")
        Ok(_) => return 1
        Err(e) => match e
            IsDir => pass
            _ => return 2
    0

[[test]]
fn test_write_file_bad_dir_is_enoent() -> i32
    var w: Result<i64, Errno> = write_file("/nonexistent/dir/f", "x")
    if err_code(@w) != 2
        return 1
    0

# ============================================================================
# mkdir / rmdir / unlink -> Result<i32, Errno>
# ============================================================================

[[test]]
fn test_mkdir_rmdir() -> i32
    let path: String = sandbox_path("fs_ops", "dir")
    rmdir(path.as_view())
    var mk: Result<i32, Errno> = mkdir(path.as_view(), 493)  # 0755
    if err_code(@mk) != 0
        return 1
    if not is_dir(path.as_view())
        return 2
    var again: Result<i32, Errno> = mkdir(path.as_view(), 493)
    if err_code(@again) != 17
        return 3
    match again
        Ok(_) => return 6
        Err(e) => match e
            Exist => pass
            _ => return 7
    var rm: Result<i32, Errno> = rmdir(path.as_view())
    if err_code(@rm) != 0
        return 4
    if path_exists(path.as_view())
        return 5
    0

[[test]]
fn test_unlink_missing_is_enoent() -> i32
    let missing: String = sandbox_path("fs_ops", "does_not_exist.tmp")
    var r: Result<i32, Errno> = unlink(missing.as_view())
    if err_code(@r) != 2
        return 1
    0

# ============================================================================
# copy_file -> Result<i64, Errno>
# ============================================================================

[[test]]
fn test_copy_file() -> i32
    let src: String = sandbox_path("fs_ops", "src.tmp")
    let dst: String = sandbox_path("fs_ops", "dst.tmp")
    write_file(src.as_view(), "Content to copy")
    var c: Result<i64, Errno> = copy_file(src.as_view(), dst.as_view(), 420)  # 0644
    if c.unwrap_or(-1) != 15
        return 1
    var r: Result<String, Errno> = read_file(dst.as_view())
    unlink(src.as_view())
    unlink(dst.as_view())
    if not string_ok_is(@r, "Content to copy")
        return 2
    0

[[test]]
fn test_copy_file_missing_src_is_enoent() -> i32
    let missing: String = sandbox_path("fs_ops", "does_not_exist.tmp")
    let never: String = sandbox_path("fs_ops", "never.tmp")
    var c: Result<i64, Errno> = copy_file(missing.as_view(), never.as_view(), 420)
    if err_code(@c) != 2
        return 1
    if path_exists(never.as_view())
        return 2
    0

# ============================================================================
# dir_open(StrView) -> Result<DirIter, Errno>
# ============================================================================

[[test]]
fn test_dir_open_view() -> i32
    match dir_open("/tmp")
        Ok(d) =>
            var dir: DirIter = d
            dir.close()
        Err(_) => return 1
    match dir_open("/nonexistent/x")
        Ok(_) => return 2
        Err(e) => match e
            NoEnt => pass
            _ => return 3
    match dir_open("/proc/self/exe")
        Ok(_) => return 4
        Err(e) => match e
            NotDir => pass
            _ => return 5
    0

# sync (AGAST #4833): Linux's sync(2) flushes every file system and never
# fails. Harland's (the same number) is exercised by Buddhafinger's QEMU
# acceptance test (projects/buddhafinger/tools/test_harland_console.sh).
[[test]]
fn test_sync_is_ok_on_linux() -> i32
    assert sync().is_ok()
    0

# ============================================================================
# temp_dir / temp_dir_from -> Result<StrView, Errno> (AGAST #4957)
# ============================================================================

# Whether `r` is Ok(`want`).
fn dir_is(r: Result<StrView, Errno>, want: StrView) -> bool
    match r
        Ok(d) => d.eq(want)
        Err(_) => false

# An unusable $TMPDIR (unset, empty, relative, missing, a file) is /tmp.
[[test]]
fn test_temp_dir_from_falls_back_to_tmp() -> i32
    assert dir_is(temp_dir_from(None), "/tmp")
    assert dir_is(temp_dir_from(Some("")), "/tmp")
    assert dir_is(temp_dir_from(Some("tmp")), "/tmp")
    assert dir_is(temp_dir_from(Some("/nonexistent/tmpdir")), "/tmp")
    let file: String = sandbox_path("fs_ops", "tmpdir_file.tmp")
    assert write_file(file.as_view(), "x").is_ok()
    assert dir_is(temp_dir_from(Some(file.as_view())), "/tmp")
    unlink(file.as_view())
    0

# A $TMPDIR naming a directory by an absolute path is used as it is.
[[test]]
fn test_temp_dir_from_takes_a_tmpdir_directory() -> i32
    let dir: String = sandbox_path("fs_ops", "tmpdir")
    rmdir(dir.as_view())
    assert mkdir(dir.as_view(), 448).is_ok()
    let got: bool = dir_is(temp_dir_from(Some(dir.as_view())), dir.as_view())
    rmdir(dir.as_view())
    assert got
    0

# temp_dir is the rule applied to this process's $TMPDIR: some directory.
[[test]]
fn test_temp_dir_is_a_directory() -> i32
    match temp_dir()
        Ok(d) =>
            assert is_dir(d)
        Err(_) => return 1
    0

# ============================================================================
# list_dir -> Result<Vec<String>, Errno> (AGAST #4957)
# ============================================================================

fn lists(names: @Vec<String>, want: StrView) -> bool
    for i in 0..names.len()
        if names[i].eq(want)
            return true
    false

# A directory's names, without "." and ".."; a file is NotDir, a missing
# path NoEnt.
[[test]]
fn test_list_dir_names_the_entries() -> i32
    let dir: String = sandbox_path("fs_ops", "listdir")
    remove_dir_all(dir.as_view())
    assert mkdir(dir.as_view(), 493).is_ok()
    let a: String = path_join(dir.as_view(), "a")
    let sub: String = path_join(dir.as_view(), "sub")
    assert write_file(a.as_view(), "x").is_ok()
    assert mkdir(sub.as_view(), 493).is_ok()
    var ok: bool = false
    match list_dir(dir.as_view())
        Ok(names) =>
            ok = names.len() == 2 and lists(@names, "a") and lists(@names, "sub")
        Err(_) => pass
    var not_dir: bool = false
    match list_dir(a.as_view())
        Ok(_) => pass
        Err(e) => match e
            NotDir => not_dir = true
            _ => pass
    remove_dir_all(dir.as_view())
    var missing: bool = false
    match list_dir(dir.as_view())
        Ok(_) => pass
        Err(e) => match e
            NoEnt => missing = true
            _ => pass
    assert ok
    assert not_dir
    assert missing
    0
