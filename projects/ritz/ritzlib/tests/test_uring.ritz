# Test io_uring bindings
#
# Note: These tests require Linux 5.1+ with io_uring support.

import ritzlib.sys
import ritzlib.uring

[[test]]
fn test_uring_constants()
    # Verify syscall numbers
    assert SYS_IO_URING_SETUP == 425
    assert SYS_IO_URING_ENTER == 426
    assert SYS_IO_URING_REGISTER == 427

    # Verify opcode values
    assert IORING_OP_NOP == 0
    assert IORING_OP_READ == 22
    assert IORING_OP_WRITE == 23
    assert IORING_OP_ACCEPT == '\r'

[[test]]
fn test_uring_struct_sizes()
    # Verify struct sizes match kernel expectations
    # SQE should be 64 bytes
    # CQE should be 16 bytes
    # These are checked implicitly by correct field offsets

    # For now just verify the constants exist
    assert SQE_SIZE == '@'
    assert CQE_SIZE == 16

[[test]]
fn test_uring_init_destroy()
    # Test ring initialization and cleanup
    var ring: IoUring

    # Initialize with 8 entries
    let ret: i32 = ring.init(8)

    if ret < 0
        # io_uring not available (old kernel or container restriction)
        # Skip test gracefully
        return

    # Verify ring was set up
    assert ring.ring_fd >= 0
    assert ring.sq_entries >= 8
    assert ring.cq_entries >= 8

    # Clean up
    ring.destroy()

[[test]]
fn test_uring_sqe_preparation()
    var ring: IoUring
    let ret: i32 = ring.init(8)

    if ret < 0
        return  # Skip if io_uring not available

    # Get an SQE
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            assert false

    # Prepare a read operation
    var buf: [64]u8
    sqe.prep_read(0, @buf[0], 64, 0, 12345)

    # Verify SQE fields
    assert sqe.opcode == IORING_OP_READ
    assert sqe.fd == 0
    assert sqe.len == '@'
    assert sqe.user_data == 12345

    ring.destroy()

[[test]]
fn test_uring_nop()
    # Submit a NOP operation and verify completion
    var ring: IoUring
    let ret: i32 = ring.init(8)

    if ret < 0
        return  # Skip if io_uring not available

    # Prepare a NOP
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            assert false

    sqe.opcode = IORING_OP_NOP
    sqe.user_data = 42

    ring.sqe_submit()

    # Submit and wait for completion
    let submit_ret: i32 = ring.submit_and_wait(1)
    if submit_ret < 0
        ring.destroy()
        return

    # Get the CQE
    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            assert false
    assert cqe.user_data == 42
    assert cqe.res == 0  # NOP should succeed with 0

    ring.cqe_seen(@*cqe)
    ring.destroy()

# ----------------------------------------------------------------------------
# Free-running counters (AGAST #4548). The kernel's SQ/CQ head and tail are
# u32 counters that wrap; only the slot index is masked. These rows build a
# ring over local memory with the counters at the i32 wrap point, so plain
# `+`/`-` (which trap, LARB R63) would stop the program.
# ----------------------------------------------------------------------------

fn wrap_ring(ring: *IoUring, sq_head: *i32, sq_tail: *i32, cq_head: *i32, cq_tail: *i32, sq_array: *i32, sqes: *IoUringSqe)
    ring.ring_fd = 0 - 1
    ring.sq_head = sq_head
    ring.sq_tail = sq_tail
    ring.sq_mask = 7
    ring.sq_entries = 8
    ring.sq_array = sq_array
    ring.sqes = sqes
    ring.cq_head = cq_head
    ring.cq_tail = cq_tail
    ring.cq_mask = 7
    ring.cq_entries = 8

[[test]]
fn test_uring_sq_tail_wraps()
    var sq_head: i32 = 2147483647 - 2
    var sq_tail: i32 = 2147483647
    var cq_head: i32 = 0
    var cq_tail: i32 = 0
    var sq_array: [8]i32
    var sqes: [8]IoUringSqe
    var ring: IoUring
    wrap_ring(@ring, @sq_head, @sq_tail, @cq_head, @cq_tail, @sq_array[0], @sqes[0])

    # Three in flight across the wrap: the ring still has room.
    var sqe: *IoUringSqe = null
    match ring.get_sqe()
        Some(p) => sqe = p
        None =>
            assert false
    assert sqe == @sqes[7]
    ring.sqe_submit()
    assert sq_tail == 0 - 2147483647 - 1

[[test]]
fn test_uring_submit_counts_across_wrap()
    var sq_head: i32 = 2147483647
    var sq_tail: i32 = 0 - 2147483647 - 1
    var cq_head: i32 = 0
    var cq_tail: i32 = 0
    var sq_array: [8]i32
    var sqes: [8]IoUringSqe
    var ring: IoUring
    wrap_ring(@ring, @sq_head, @sq_tail, @cq_head, @cq_tail, @sq_array[0], @sqes[0])

    # One pending SQE (tail - head wraps to 1); fd -1 makes the enter fail
    # with -EBADF instead of submitting anything.
    assert ring.submit() < 0
    assert ring.submit_and_wait(0) < 0

[[test]]
fn test_uring_cq_head_wraps()
    var sq_head: i32 = 0
    var sq_tail: i32 = 0
    var cq_head: i32 = 2147483647
    var cq_tail: i32 = 0 - 2147483647 - 1
    var sq_array: [8]i32
    var sqes: [8]IoUringSqe
    var ring: IoUring
    wrap_ring(@ring, @sq_head, @sq_tail, @cq_head, @cq_tail, @sq_array[0], @sqes[0])

    var cqe: *IoUringCqe = null
    match ring.peek_cqe()
        Some(p) => cqe = p
        None =>
            assert false
    ring.cqe_seen(@*cqe)
    assert cq_head == cq_tail
