# test_fs_stat.ritz - Typed fs API: stat()/lstat() -> Result<Stat, Errno>
# (AGAST #1476). DirEntry tests live in test_fs_dirent.ritz; the split keeps
# each file under build.py's 180s per-file test timeout.
#
# Each test owns its fixtures under a sandbox_path and removes them, so the verdict does
# not depend on the cwd build.py happens to run the binary from.

import ritzlib.fs
import ritzlib.sys { Stat }
import ritzlib.errno
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.option
import ritzlib.testlib

# ============================================================================
# Helpers
# ============================================================================

fn zero_stat() -> Stat
    var s: Stat
    s.st_dev = 0
    s.st_ino = 0
    s.st_nlink = 0
    s.st_mode = 0
    s.st_uid = 0
    s.st_gid = 0
    s.st_size = -1
    s.st_blksize = 0
    s.st_blocks = 0
    s

fn stat_or_zero(r: @Result<Stat, Errno>) -> Stat
    match *r
        Ok(s) => s
        Err(_) => zero_stat()

fn err_of(r: @Result<Stat, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

# `len` bytes of 'x' written to `path` (created or truncated).
fn write_fixture(path: StrView, len: i64) -> Result<i64, Errno>
    var body: String = string_new()
    for i in 0..len
        body.push('x')
    write_file(path, body.as_view())

# ============================================================================
# stat / lstat
# ============================================================================

[[test]]
fn test_stat_directory_ok() -> i32
    var r: Result<Stat, Errno> = stat("/tmp")
    if not r.is_ok()
        return 1
    let st: Stat = stat_or_zero(@r)
    if not mode_is_dir(st.st_mode)
        return 2
    if st.st_ino == 0
        return 3
    0

[[test]]
fn test_stat_missing_is_enoent() -> i32
    var r: Result<Stat, Errno> = stat("/nonexistent/ritz_1476/x")
    if not r.is_err()
        return 1
    # Err carries the positive kernel errno: 2 = ENOENT.
    if err_of(@r) != 2
        return 2
    0

[[test]]
fn test_stat_size_matches_written_bytes() -> i32
    let p: String = sandbox_path("fs_stat", "1476_size.tmp")
    if write_fixture(p.as_view(), 37).is_err()
        return 1
    var r: Result<Stat, Errno> = stat(p.as_view())
    let st: Stat = stat_or_zero(@r)
    unlink(p.as_view())
    if st.st_size != 37
        return 2
    if not mode_is_file(st.st_mode)
        return 3
    if st.st_nlink != 1
        return 4
    0

[[test]]
fn test_stat_unterminated_view() -> i32
    # A StrView is (ptr, len) with no NUL. "/tmpXYZ" sliced to 4 bytes must
    # stat "/tmp", not "/tmpXYZ" -- stat() has to terminate the path itself.
    let whole: StrView = "/tmpXYZ"
    let v: StrView = whole.slice(0, 4)
    var r: Result<Stat, Errno> = stat(v)
    if not r.is_ok()
        return 1
    if not mode_is_dir(stat_or_zero(@r).st_mode)
        return 2
    var l: Result<Stat, Errno> = lstat(v)
    if not l.is_ok()
        return 3
    0

[[test]]
fn test_stat_path_too_long() -> i32
    var big: String = string_new()
    for i in 0..5000
        big.push('a')
    var r: Result<Stat, Errno> = stat(big.as_view())
    # 36 = ENAMETOOLONG, reported without touching the kernel.
    if err_of(@r) != 36
        return 1
    match r
        Ok(_) => return 2
        Err(e) => match e
            NameTooLong => pass
            _ => return 3
    0

[[test]]
fn test_lstat_vs_stat_on_symlink() -> i32
    let target: String = sandbox_path("fs_stat", "1476_target.tmp")
    let link: String = sandbox_path("fs_stat", "1476_link.tmp")
    unlink(link.as_view())
    if write_fixture(target.as_view(), 5).is_err()
        return 1
    if symlink(target.as_view(), link.as_view()).is_err()
        unlink(target.as_view())
        return 2
    var rl: Result<Stat, Errno> = lstat(link.as_view())
    var rs: Result<Stat, Errno> = stat(link.as_view())
    let sl: Stat = stat_or_zero(@rl)
    let ss: Stat = stat_or_zero(@rs)
    unlink(link.as_view())
    unlink(target.as_view())
    if not mode_is_link(sl.st_mode)
        return 3
    if not mode_is_file(ss.st_mode)
        return 4
    if ss.st_size != 5
        return 5
    0

