# test_fs_stat.ritz - Typed fs API: stat()/lstat() -> Result<Stat, Errno>
# (AGAST #1476). DirEntry tests live in test_fs_dirent.ritz; the split keeps
# each file under build.py's 180s per-file test timeout.
#
# Each test owns its fixtures under /tmp and removes them, so the verdict does
# not depend on the cwd build.py happens to run the binary from.

import ritzlib.sys
import ritzlib.fs
import ritzlib.errno
import ritzlib.str
import ritzlib.memory
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.strview
import ritzlib.result
import ritzlib.option

# ============================================================================
# Helpers
# ============================================================================

# "/tmp/ritzlib_<pid>_<name>" into dst (>= 96 bytes); returns dst. The pid
# keeps concurrent test runs (gate slots, compiler variants) off each other's
# fixtures (AGAST #4084). ritzlib.testlib's sandbox_path now builds the same
# shape as a String (AGAST #4643 dropped the read_file/write_file that kept
# these files off testlib); this helper predates it.
fn pid_tmp_path(dst: *u8, name: *u8) -> *u8
    let head: *u8 = c"/tmp/ritzlib_"
    let head_len: i64 = strlen(head)
    memcpy(dst, head, head_len)
    var i: i64 = head_len + fmt_i64_into(dst + head_len, sys_getpid() as i64)
    *(dst + i) = '_'
    i += 1
    let name_len: i64 = strlen(name)
    memcpy(dst + i, name, name_len)
    *(dst + i + name_len) = 0
    dst

fn zero_stat() -> Stat
    var s: Stat
    s.st_dev = 0
    s.st_ino = 0
    s.st_nlink = 0
    s.st_mode = 0
    s.st_uid = 0
    s.st_gid = 0
    s.st_size = -1
    s.st_blksize = 0
    s.st_blocks = 0
    s

fn stat_or_zero(r: *Result<Stat, Errno>) -> Stat
    match *r
        Ok(s) => s
        Err(_) => zero_stat()

fn err_of(r: *Result<Stat, Errno>) -> i32
    match *r
        Ok(_) => 0
        Err(e) => e.code()

fn write_fixture(path: *u8, len: i64) -> i32
    let fd: i32 = sys_open3(path, 577, 420)
    if fd < 0
        return fd
    var buf: [64]u8
    for i in 0..len
        buf[i] = 'x' as u8
    sys_write(fd, @buf[0], len)
    sys_close(fd)
    0

# ============================================================================
# stat / lstat
# ============================================================================

[[test]]
fn test_stat_directory_ok() -> i32
    var r: Result<Stat, Errno> = stat("/tmp")
    if not r.is_ok()
        return 1
    let st: Stat = stat_or_zero(@r)
    if not mode_is_dir(st.st_mode)
        return 2
    if st.st_ino == 0
        return 3
    0

[[test]]
fn test_stat_missing_is_enoent() -> i32
    var r: Result<Stat, Errno> = stat("/nonexistent/ritz_1476/x")
    if not r.is_err()
        return 1
    # Err carries the positive kernel errno: 2 = ENOENT.
    if err_of(@r) != 2
        return 2
    0

[[test]]
fn test_stat_size_matches_written_bytes() -> i32
    var pbuf: [96]u8
    let p: *u8 = pid_tmp_path(@pbuf[0], c"1476_size.tmp")
    if write_fixture(p, 37) != 0
        return 1
    var r: Result<Stat, Errno> = stat(strview_from_cstr(p))
    let st: Stat = stat_or_zero(@r)
    sys_unlink(p)
    if st.st_size != 37
        return 2
    if not mode_is_file(st.st_mode)
        return 3
    if st.st_nlink != 1
        return 4
    0

[[test]]
fn test_stat_unterminated_view() -> i32
    # A StrView is (ptr, len) with no NUL. "/tmpXYZ" sliced to 4 bytes must
    # stat "/tmp", not "/tmpXYZ" -- stat() has to terminate the path itself.
    let v: StrView = strview_from_ptr(c"/tmpXYZ", 4)
    var r: Result<Stat, Errno> = stat(v)
    if not r.is_ok()
        return 1
    if not mode_is_dir(stat_or_zero(@r).st_mode)
        return 2
    var l: Result<Stat, Errno> = lstat(v)
    if not l.is_ok()
        return 3
    0

[[test]]
fn test_stat_path_too_long() -> i32
    var big: [5000]u8
    for i in 0..5000
        big[i] = 'a' as u8
    var r: Result<Stat, Errno> = stat(strview_from_ptr(@big[0], 5000))
    # 36 = ENAMETOOLONG, reported without touching the kernel.
    if err_of(@r) != 36
        return 1
    match r
        Ok(_) => return 2
        Err(e) => match e
            NameTooLong => pass
            _ => return 3
    0

[[test]]
fn test_lstat_vs_stat_on_symlink() -> i32
    var targetbuf: [96]u8
    let target: *u8 = pid_tmp_path(@targetbuf[0], c"1476_target.tmp")
    var linkbuf: [96]u8
    let link: *u8 = pid_tmp_path(@linkbuf[0], c"1476_link.tmp")
    sys_unlink(link)
    if write_fixture(target, 5) != 0
        return 1
    if sys_symlink(target, link) != 0
        sys_unlink(target)
        return 2
    var rl: Result<Stat, Errno> = lstat(strview_from_cstr(link))
    var rs: Result<Stat, Errno> = stat(strview_from_cstr(link))
    let sl: Stat = stat_or_zero(@rl)
    let ss: Stat = stat_or_zero(@rs)
    sys_unlink(link)
    sys_unlink(target)
    if not mode_is_link(sl.st_mode)
        return 3
    if not mode_is_file(ss.st_mode)
        return 4
    if ss.st_size != 5
        return 5
    0

