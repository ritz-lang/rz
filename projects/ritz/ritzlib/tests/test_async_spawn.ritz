# test_async_spawn.ritz - spawn/run_spawned drive held futures (LARB R79,
# AGAST #4481)
#
# LARB R79 names spawn(rt, @&p): it queues a future the caller holds, and an
# entry point drains the queue.  ritzlib.async.runtime adds both: `spawn`
# stores the future, and `run_spawned` polls the queue until every task has
# finished, waiting on the ring while all incomplete tasks are suspended.  The
# caller keeps each future alive and reads its result with `await p`.
#
# The concurrency is the point.  Each queued future submits its operation and
# suspends, so several tasks are waiting on the same ring at once; one shared
# waker slot would be overwritten by each registration and every earlier
# task's completion would be dropped.  The N-task test writes its pipes in
# reverse order so completions do not even arrive in submission order.

import ritzlib.sys
import ritzlib.io
import ritzlib.async.runtime

# One byte from `fd`, suspending on the ring until it arrives.  Awaiting a
# plain i32-returning call is the hand-written poll source form (R78): -1 while
# Pending, re-evaluated on each poll.
async fn read_byte(rt: *Runtime, fd: i32, buf: *u8) -> i32
    let n: i32 = await rt.poll_read(fd, Span<u8> { ptr: (buf), len: (1) as i64 }, 0)
    n

# No await: this future finishes on its first poll, so it never suspends.
async fn constant() -> i32
    1234

# A poll source that is always Pending and registers nothing on the ring.
fn always_pending(x: i32) -> i32
    0 - 1

async fn spawn_never_ready() -> i32
    let v: i32 = await always_pending(0)
    v

# ============================================================================
# (a) Several tasks, concurrent, completions out of submission order
# ============================================================================

[[test]]
fn test_spawn_n_futures_all_complete() -> i32
    var p0: [2]i32
    var p1: [2]i32
    var p2: [2]i32
    if sys_pipe(@p0[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    if sys_pipe(@p1[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    if sys_pipe(@p2[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    let pid: i32 = sys_fork()
    if pid == 0
        # Child: write the pipes in reverse submission order, pausing so each
        # read completes separately and in that order.
        sys_close(p0[0])
        sys_close(p1[0])
        sys_close(p2[0])

        var ts: [2]i64
        ts[0] = 0
        ts[1] = 20000000   # 20ms

        sys_nanosleep(@ts[0], null)
        sys_write(p2[1], c"c", 1)
        sys_nanosleep(@ts[0], null)
        sys_write(p1[1], c"b", 1)
        sys_nanosleep(@ts[0], null)
        sys_write(p0[1], c"a", 1)

        sys_close(p0[1])
        sys_close(p1[1])
        sys_close(p2[1])
        sys_exit(0)

    sys_close(p0[1])
    sys_close(p1[1])
    sys_close(p2[1])

    var rt: Runtime
    if rt.init() < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var b0: [1]u8
    var b1: [1]u8
    var b2: [1]u8
    var f0 = read_byte(@rt, p0[0], @b0[0])
    var f1 = read_byte(@rt, p1[0], @b1[0])
    var f2 = read_byte(@rt, p2[0], @b2[0])

    rt.spawn(@&f0)
    rt.spawn(@&f1)
    rt.spawn(@&f2)
    let drain_result: i32 = rt.run_spawned()

    let n0: i32 = await f0
    let n1: i32 = await f1
    let n2: i32 = await f2

    rt.destroy()
    sys_close(p0[0])
    sys_close(p1[0])
    sys_close(p2[0])

    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)

    if drain_result != 0
        prints("FAIL: run_spawned should return 0\n")
        return 1
    if n0 != 1 or n1 != 1 or n2 != 1
        prints("FAIL: every spawned read should return 1 byte\n")
        return 1
    if b0[0] != 97 or b1[0] != 98 or b2[0] != 99
        prints("FAIL: each task should read its own pipe's byte\n")
        return 1
    if rt.spawn_count != 0
        prints("FAIL: the queue should be empty after the drain\n")
        return 1
    return 0

# ============================================================================
# (b) A task that completes on its first poll
# ============================================================================

[[test]]
fn test_spawn_immediate_future_completes() -> i32
    var rt: Runtime
    if rt.init() < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var p = constant()
    rt.spawn(@&p)
    let drain_result: i32 = rt.run_spawned()
    let v: i32 = await p
    rt.destroy()

    if drain_result != 0
        prints("FAIL: run_spawned should return 0\n")
        return 1
    if v != 1234
        prints("FAIL: expected 1234 from the immediate future, got ")
        print_int(v as i64)
        prints("\n")
        return 1
    return 0

# ============================================================================
# (c) A task that suspends on real I/O and completes when the data is written
# ============================================================================

[[test]]
fn test_spawn_suspends_on_real_io() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    sys_write(fds[1], c"Z", 1)

    var rt: Runtime
    if rt.init() < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var buf: [1]u8
    var p = read_byte(@rt, fds[0], @buf[0])
    rt.spawn(@&p)
    let drain_result: i32 = rt.run_spawned()
    let n: i32 = await p
    rt.destroy()
    sys_close(fds[0])
    sys_close(fds[1])

    if drain_result != 0
        prints("FAIL: run_spawned should return 0\n")
        return 1
    if n != 1
        prints("FAIL: the spawned read should return 1 byte, got ")
        print_int(n as i64)
        prints("\n")
        return 1
    if buf[0] != 90
        prints("FAIL: the read did not land in the task's buffer\n")
        return 1
    return 0

# ============================================================================
# The loud contract: Pending without suspending can never be woken
# ============================================================================

[[test]]
fn test_spawn_pending_without_a_waker_fails_loudly() -> i32
    var err_pipe: [2]i32
    if sys_pipe(@err_pipe[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    let pid: i32 = sys_fork()
    if pid == 0
        # Child: run_spawned must not return; the contract violation exits 101.
        sys_dup2(err_pipe[1], 2)
        sys_close(err_pipe[0])
        sys_close(err_pipe[1])

        var rt: Runtime
        if rt.init() < 0
            sys_exit(2)
        var p = spawn_never_ready()
        rt.spawn(@&p)
        rt.run_spawned()
        sys_exit(0)   # reached only if the failure was not loud

    sys_close(err_pipe[1])
    # Drain stderr to EOF before reaping (docs/TESTING.md gotcha 1). A single
    # read returns on the first chunk; closing then would SIGPIPE the child's
    # trailing newline write and it would die signal-killed instead of exiting
    # 101 (AGAST #4487).
    var msg: [256]u8
    var n: i64 = 0
    loop
        let r: i64 = sys_read(err_pipe[0], @msg[0], 256)
        if r <= 0
            break
        if n == 0
            n = r
    sys_close(err_pipe[0])

    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    let code: i32 = (status >> 8) & 255

    if code != 101
        prints("FAIL: expected exit 101 for a Pending future with no waker\n")
        return 1
    if n <= 0
        prints("FAIL: expected a failure message on stderr\n")
        return 1
    return 0
