# ritzlib.process: what environment does a spawned child get? (AGAST #1750)
#
#   spawn(cmd, args)           -> the child INHERITS the parent's environment
#                                 (ritzlib.os.env's env_raw_envp()).
#   spawn_env(cmd, args, env)  -> the child gets exactly `env`, one
#                                 "KEY=VALUE" view per entry (AGAST #3750).
#
# Before #1750 a null envp went straight to execve(2), which on Linux means an
# EMPTY environment: every child the raw spawn forms started ran with no PATH,
# no HOME, nothing.  spawn_env took over the explicit-envp case from the raw
# `**u8` envp form when #3750 deleted that.
#
# The child is /usr/bin/env with no arguments: it prints its environment as
# "KEY=VALUE\n" lines, in environ order, which makes the expected output
# exactly computable from the parent's env_iter().

import ritzlib.sys
import ritzlib.str
import ritzlib.gvec
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.process
import ritzlib.os.env

# The bytes /usr/bin/env prints for the parent's own environment.
fn expected_env_output() -> Vec<u8>
    var out: Vec<u8> = vec_new<u8>()
    let entries: Span<StrView> = env_iter()
    var i: i64 = 0
    while i < entries.len
        let e: *StrView = entries.ptr + i
        vec_push_bytes<u8>(@&out, e.ptr, e.len)
        vec_push<u8>(@&out, '\n' as u8)
        i += 1
    out

fn bytes_eq(a: *Vec<u8>, b: *Vec<u8>) -> i32
    if a.len != b.len
        return 0
    var i: i64 = 0
    while i < a.len
        if *(a.data + i) != *(b.data + i)
            return 0
        i += 1
    1

# Run a spawned child to completion: stdout into *out; 1 if it exited 0,
# 0 if it did not, -1 if the spawn itself failed.
fn collect(r: *Result<Process, Errno>, out: *Vec<u8>) -> i32
    match *r
        Ok(p) =>
            var q: Process = p
            *out = process_read_stdout_all(@&q)
            var ok: i32 = 0
            match process_wait(@&q)
                Ok(res) => ok = result_success(@res) as i32
                Err(_) => ok = 0
            process_cleanup(@&q)
            ok
        Err(_) => -1

# /usr/bin/env under spawn_env with `env`; stdout into *out.
fn run_env(env: Span<StrView>, out: *Vec<u8>) -> i32
    var r: Result<Process, Errno> = spawn_env("/usr/bin/env", span_empty<StrView>(), env)
    collect(@r, out)

[[test]]
fn test_spawn_inherits_parent_env() -> i32
    # The harness environment always has at least PATH, so "inherited" and
    # "empty" are distinguishable.
    assert env_iter().len > 0
    var r: Result<Process, Errno> = spawn("/usr/bin/env", span_empty<StrView>())
    var got: Vec<u8> = vec_new<u8>()
    assert collect(@r, @got) == 1
    var want: Vec<u8> = expected_env_output()
    assert got.len > 0
    assert bytes_eq(@got, @want) == 1
    0

[[test]]
fn test_spawn_env_is_exact() -> i32
    # An explicit env is passed through untouched, NOT merged with ours.
    var env: [1]StrView
    env[0] = "RITZ_PROCESS_ENV_TEST=1"
    var got: Vec<u8> = vec_new<u8>()
    assert run_env(span_from_ptr<StrView>(@env[0], 1), @got) == 1
    let v: StrView = strview_from_ptr(got.data, got.len)
    assert strview_eq_cstr(v, c"RITZ_PROCESS_ENV_TEST=1\n")
    0

[[test]]
fn test_spawn_env_uses_view_length() -> i32
    # Views into longer literals: each entry must be exactly `len` bytes,
    # terminated by spawn_env, and in the order given.
    var env: [2]StrView
    env[0] = strview_slice("A=1NOPE", 0, 3)
    env[1] = strview_slice("B=twoXYZ", 0, 5)
    var got: Vec<u8> = vec_new<u8>()
    assert run_env(span_from_ptr<StrView>(@env[0], 2), @got) == 1
    let v: StrView = strview_from_ptr(got.data, got.len)
    assert strview_eq_cstr(v, c"A=1\nB=two\n")
    0

[[test]]
fn test_spawn_env_empty_is_empty() -> i32
    # An empty span is an empty environment, not "inherit".
    var got: Vec<u8> = vec_new<u8>()
    assert run_env(span_empty<StrView>(), @got) == 1
    assert got.len == 0
    0

[[test]]
fn test_spawn_env_missing_command_is_enoent() -> i32
    var r: Result<Process, Errno> = spawn_env("ritz-no-such-command", span_empty<StrView>(), span_empty<StrView>())
    match r
        Ok(_) =>
            assert false
        Err(e) => match e
            NoEnt => pass
            _ =>
                assert false
    0
