# ritzlib.process: what environment does a spawned child get? (AGAST #1750)
#
#   spawn(cmd, args)           -> the child INHERITS the parent's environment
#                                 (spawn_env with env_iter(), AGAST #4648).
#   spawn_env(cmd, args, env)  -> the child gets exactly `env`, one
#                                 "KEY=VALUE" view per entry (AGAST #3750).
#
# Before #1750 a null envp went straight to execve(2), which on Linux means an
# EMPTY environment: every child the raw spawn forms started ran with no PATH,
# no HOME, nothing.  spawn_env took over the explicit-envp case from the raw
# `**u8` envp form when #3750 deleted that.
#
# The child is /usr/bin/env with no arguments: it prints its environment as
# "KEY=VALUE\n" lines, in environ order, which makes the expected output
# exactly computable from the parent's env_iter().

import ritzlib.gvec
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.process
import ritzlib.os.env

# The bytes /usr/bin/env prints for the parent's own environment.
fn expected_env_output() -> String
    var out: String = string_new()
    let entries: Span<StrView> = env_iter()
    for i in 0..entries.len
        out.push_str(entries[i])
        out.push('\n')
    out

# A spawned child run to completion: whether it exited 0 and its stdout.
# `spawned` is false (and ok with it) if the spawn itself failed.
struct Collected
    spawned: bool
    ok: bool
    out: Vec<u8>

fn collect(r: Result<Process, Errno>) -> Collected
    match r
        Ok(p) =>
            var q: Process = p
            let out: Vec<u8> = q.read_stdout_all()
            var ok: bool = false
            match q.wait()
                Ok(res) => ok = res.success()
                Err(_) => ok = false
            q.cleanup()
            Collected { spawned: true, ok: ok, out: out }
        Err(_) => Collected { spawned: false, ok: false, out: vec_new<u8>() }

# /usr/bin/env under spawn_env with `env`.
fn run_env(env: Span<StrView>) -> Collected
    collect(spawn_env("/usr/bin/env", span_empty<StrView>(), env))

[[test]]
fn test_spawn_inherits_parent_env() -> i32
    # The harness environment always has at least PATH, so "inherited" and
    # "empty" are distinguishable.
    assert env_iter().len > 0
    let got: Collected = collect(spawn("/usr/bin/env", span_empty<StrView>()))
    assert got.spawned and got.ok
    let want: String = expected_env_output()
    assert got.out.len > 0
    assert got.out.as_view().eq(want.as_view())
    0

[[test]]
fn test_spawn_env_is_exact() -> i32
    # An explicit env is passed through untouched, NOT merged with ours.
    let env: [1]StrView = ["RITZ_PROCESS_ENV_TEST=1"]
    let got: Collected = run_env(@env)
    assert got.spawned and got.ok
    assert got.out.as_view().eq("RITZ_PROCESS_ENV_TEST=1\n")
    0

[[test]]
fn test_spawn_env_uses_view_length() -> i32
    # Views into longer literals: each entry must be exactly `len` bytes,
    # terminated by spawn_env, and in the order given.
    let env: [2]StrView = [("A=1NOPE").slice(0, 3), ("B=twoXYZ").slice(0, 5)]
    let got: Collected = run_env(@env)
    assert got.spawned and got.ok
    assert got.out.as_view().eq("A=1\nB=two\n")
    0

[[test]]
fn test_spawn_env_empty_is_empty() -> i32
    # An empty span is an empty environment, not "inherit".
    let got: Collected = run_env(span_empty<StrView>())
    assert got.spawned and got.ok
    assert got.out.len == 0
    0

[[test]]
fn test_spawn_env_missing_command_is_enoent() -> i32
    var r: Result<Process, Errno> = spawn_env("ritz-no-such-command", span_empty<StrView>(), span_empty<StrView>())
    match r
        Ok(_) =>
            assert false
        Err(e) => match e
            NoEnt => pass
            _ =>
                assert false
    0

[[test]]
fn test_spawn_env_merged_negative_stdin_fd_is_badf() -> i32
    # spawn_env_merged (AGAST #4643) dups stdin_fd onto the child's fd 0; a
    # negative one is refused before anything forks.
    var r: Result<Process, Errno> = spawn_env_merged("/bin/true", span_empty<StrView>(), span_empty<StrView>(), -1)
    match r
        Ok(_) =>
            assert false
        Err(e) => match e
            BadF => pass
            _ =>
                assert false
    0
