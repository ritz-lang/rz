# Byte-exact stdout of ritzlib.iovec's iovec_debug_print (AGAST #1684).
#
# It was a prints/print_int chain; #1684 made it interpolated print.
#
# ritz1 parity: ritz0/tests/test_ritzlib_output_goldens.py.
# Each case runs under testlib's capture.

import ritzlib.io
import ritzlib.strview
import ritzlib.iovec
import ritzlib.testlib


# ============================================================================
# Cases
# ============================================================================

fn case_empty() -> i32
    var b: IoVecBuilder
    b.init()
    b.debug_print()
    0

fn case_mixed() -> i32
    var b: IoVecBuilder
    b.init()
    b.append_static("GET ")
    b.append_copy("/index.html")
    b.append_int(-1234)
    b.append_crlf()
    b.debug_print()
    0

[[test]]
fn test_iovec_debug_print_empty_exact() -> i32
    expect_capture(case_empty, "IoVecBuilder: 0 iovecs, 0 pool bytes, 0 total bytes\n", "")
    0

[[test]]
fn test_iovec_debug_print_exact() -> i32
    expect_capture(case_mixed, "IoVecBuilder: 4 iovecs, 16 pool bytes, 22 total bytes\n  [0] len=4\n  [1] len=11\n  [2] len=5\n  [3] len=2\n", "")
    0
