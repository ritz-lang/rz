# Tests for ritzlib/str.ritz atoi: C atoi(3) semantics, wrapping on overflow.
#
# atoi documents "wraps on overflow". Since plain `+`/`-`/`*` trap (LARB R63,
# AGAST #3488) the wrap has to be spelled `+%`/`-%`/`*%` (AGAST #4548).

import ritzlib.str

[[test]]
fn test_atoi_plain() -> i32
    assert atoi(c"0") == 0
    assert atoi(c"42") == 42
    assert atoi(c"  -17") == 0 - 17
    assert atoi(c"+8x") == 8
    assert atoi(c"abc") == 0
    0

[[test]]
fn test_atoi_i64_min() -> i32
    # The positive accumulator reaches 2^63 on the last digit before negation.
    assert atoi(c"-9223372036854775808") == 0 - 9223372036854775807 - 1
    0

[[test]]
fn test_atoi_wraps_past_u64() -> i32
    # 2^64 + 1 wraps to 1.
    assert atoi(c"18446744073709551617") == 1
    0
