# Tests for ritzlib.argspec (AGAST #1448): argv views, args_tail/args_get, and spec lookup.
#
# Split across test_argspec_*.ritz because the runner compiles one harness
# per test and gives each FILE 180s; the helpers below are repeated per file.
#
# The legacy ArgParser API (args_init / args_parse / ...) is deliberately not
# covered here: its layout is pinned by ritz1 (#1440) and it is on its way out
# once callers are ported.  Everything below goes through ArgSpec/ParsedArgs.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Helpers
# ============================================================================

# A spec shaped like a small coreutil:  demo [-v] [-q] [-n NUM] [--name=S] FILE...
fn demo_spec() -> ArgSpec
    var spec = argspec_new("demo", "A demo program")
    argspec_switch(@&spec, 'v', "verbose", "Say more")
    argspec_switch(@&spec, 'q', "", "Say less (short only)")
    argspec_option(@&spec, 'n', "count", "NUM", "How many", Some("10"))
    argspec_option(@&spec, 0, "name", "S", "Who (long only, no default)", None)
    argspec_positionals(@&spec, "FILE", "Input files", 1, 3)
    spec

fn find_or(spec: @ArgSpec, name: StrView) -> i64
    match argspec_find(spec, name)
        Some(i) => i
        None => -1

fn sv_eq(a: StrView, b: StrView) -> bool
    strview_eq(@a, @b) != 0

fn opt_is(o: Option<StrView>, want: StrView) -> bool
    match o
        Some(s) => sv_eq(s, want)
        None => false

fn opt_none(o: Option<StrView>) -> bool
    match o
        Some(s) => false
        None => true

# ============================================================================
# argv -> Vec<StrView> / Span<StrView>
# ============================================================================

[[test]]
fn test_args_from_argv_views_every_entry() -> i32
    var raw: [3]*u8
    raw[0] = c"prog"
    raw[1] = c"-v"
    raw[2] = c"file.txt"
    var all = args_from_argv(3, @raw[0])
    assert vec_len<StrView>(@all) == 3
    assert sv_eq(vec_get<StrView>(@all, 0), "prog")
    assert sv_eq(vec_get<StrView>(@all, 2), "file.txt")
    vec_drop<StrView>(@&all)
    0

[[test]]
fn test_args_tail_skips_program_name() -> i32
    var raw: [3]*u8
    raw[0] = c"prog"
    raw[1] = c"a"
    raw[2] = c"b"
    var all = args_from_argv(3, @raw[0])
    let tail = args_tail(@all)
    assert tail.len == 2
    assert opt_is(args_get(@tail, 0), "a")
    assert opt_is(args_get(@tail, 1), "b")
    vec_drop<StrView>(@&all)
    0

[[test]]
fn test_args_tail_of_empty_is_empty() -> i32
    var all = args_from_argv(0, null)
    let tail = args_tail(@all)
    assert tail.len == 0
    0

[[test]]
fn test_args_get_out_of_range_is_none() -> i32
    var a: [1]StrView
    a[0] = "only"
    let s = span_from_ptr<StrView>(@a[0], 1)
    assert opt_is(args_get(@s, 0), "only")
    assert opt_none(args_get(@s, 1))
    assert opt_none(args_get(@s, -1))
    0

# ============================================================================
# Spec construction and lookup
# ============================================================================

[[test]]
fn test_argspec_find_by_long_and_short() -> i32
    var spec = demo_spec()
    let by_long: i64 = find_or(@spec, "count")
    let by_short: i64 = find_or(@spec, "n")
    let short_only: i64 = find_or(@spec, "q")
    let missing: i64 = find_or(@spec, "nope")
    assert by_long == 2
    assert by_short == 2
    assert short_only == 1
    assert missing == -1
    argspec_drop(@&spec)
    0

[[test]]
fn test_argspec_find_empty_name_matches_nothing() -> i32
    # "q" has no long name; an empty lookup must not match its empty long.
    var spec = demo_spec()
    let idx: i64 = find_or(@spec, "")
    assert idx == -1
    argspec_drop(@&spec)
    0
