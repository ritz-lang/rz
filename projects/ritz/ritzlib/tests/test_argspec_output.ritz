# Byte-exact stdout/stderr of ritzlib.argspec's printers (AGAST #1642).
#
# arg_error_print and argspec_print_help were hand-rolled eprints/prints
# chains; #1642 turned them into print/eprint interpolation.  These goldens
# pin every byte (and which fd it goes to) so a conversion that drops a
# space, a quote or a newline, or writes to the wrong stream, fails here.
# examples/tier2_stdlib/77_args checks the same text through `$(...)`, which
# strips trailing newlines, and does not reach every error kind.
#
# Each case runs under testlib's capture: a forked child with fd 1 and fd 2
# on their own pipes.

import ritzlib.io
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec
import ritzlib.testlib


# ============================================================================
# Cases
# ============================================================================

fn demo_spec() -> ArgSpec
    var spec = argspec_new("demo", "A demo program")
    spec.switch('v', "verbose", "Say more")
    spec.switch('q', "", "Say less")
    spec.option('n', "count", "NUM", "How many", Some("10"))
    spec.option(0, "name", "S", "Who", None)
    spec.option('x', "", "N", "Short value", Some("3"))
    spec.switch(0, "dry-run", "Pretend")
    spec.positionals("FILE", "Input files", 1, 3)
    spec

fn report(spec: @ArgSpec, kind: ArgErrorKind, text: StrView, limit: i64, dashes: StrView)
    let e = ArgError { kind: kind, text: text, limit: limit, dashes: dashes }
    spec.error_print(@e)

fn case_option_errors() -> i32
    let spec = demo_spec()
    report(@spec, ArgErrorKind.UnknownOption, "bogus", 0, "--")
    report(@spec, ArgErrorKind.UnknownOption, "z", 0, "-")
    report(@spec, ArgErrorKind.MissingValue, "n", 0, "-")
    report(@spec, ArgErrorKind.MissingValue, "count", 0, "--")
    report(@spec, ArgErrorKind.UnexpectedValue, "verbose", 0, "--")
    report(@spec, ArgErrorKind.NotSet, "count", 0, "--")
    report(@spec, ArgErrorKind.NotSet, "q", 0, "-")
    0

# A one-letter name printed with the dashes carried in the error, not
# guessed from its length (#3991): `--f` stays '--f'.
fn case_one_letter_long() -> i32
    let spec = demo_spec()
    report(@spec, ArgErrorKind.UnknownOption, "f", 0, "--")
    report(@spec, ArgErrorKind.MissingValue, "f", 0, "--")
    report(@spec, ArgErrorKind.UnexpectedValue, "f", 0, "--")
    0

fn case_value_errors() -> i32
    let spec = demo_spec()
    report(@spec, ArgErrorKind.MissingPositional, "FILE", 1, "")
    report(@spec, ArgErrorKind.TooManyPositionals, "d", 3, "")
    report(@spec, ArgErrorKind.TooManyPositionals, "e", -1, "")
    report(@spec, ArgErrorKind.NotANumber, "abc", 0, "")
    0

fn print_int_error(spec: @ArgSpec, p: @ParsedArgs, name: StrView) -> i32
    match p.int(name)
        Ok(n) => 0
        Err(e) => print_err(spec, e)

fn print_err(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    0

# NotSet from parsed_int takes the dashes of the option the name resolved to:
# a one-letter LONG name gets "--", a short one "-", an unknown long "--".
fn case_not_set_dashes() -> i32
    var spec = argspec_new("ns", "")
    spec.option(0, "f", "V", "One-letter long", None)
    spec.option('g', "", "V", "Short only", None)
    var none = vec_new<StrView>()
    match spec.parse(span_from_vec<StrView>(@none))
        Ok(p) => report_not_set(@spec, @p)
        Err(e) => print_err(@spec, e)
    0

fn report_not_set(spec: @ArgSpec, p: @ParsedArgs) -> i32
    print_int_error(spec, p, "f")
    print_int_error(spec, p, "g")
    print_int_error(spec, p, "nosuch")
    0

fn case_help_full() -> i32
    let spec = demo_spec()
    spec.print_help()
    0

fn case_help_minimal() -> i32
    let bare = argspec_new("bare", "")
    bare.print_help()
    var one = argspec_new("one", "")
    one.positionals("ARG", "The arg", 0, 1)
    one.print_help()
    var many = argspec_new("many", "Lots")
    many.positionals("F", "Files", 0, ARGS_UNLIMITED)
    many.print_help()
    0

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_option_errors_exact_stderr() -> i32
    expect_capture(case_option_errors, "", "demo: unknown option '--bogus'\ndemo: unknown option '-z'\ndemo: option '-n' requires a value\ndemo: option '--count' requires a value\ndemo: option '--verbose' doesn't accept a value\ndemo: option '--count' has no value\ndemo: option '-q' has no value\n")
    0

[[test]]
fn test_one_letter_long_keeps_double_dash() -> i32
    expect_capture(case_one_letter_long, "", "demo: unknown option '--f'\ndemo: option '--f' requires a value\ndemo: option '--f' doesn't accept a value\n")
    0

[[test]]
fn test_not_set_dashes_follow_the_spec() -> i32
    expect_capture(case_not_set_dashes, "", "ns: option '--f' has no value\nns: option '-g' has no value\nns: option '--nosuch' has no value\n")
    0

[[test]]
fn test_value_errors_exact_stderr() -> i32
    expect_capture(case_value_errors, "", "demo: missing required argument 'FILE'\ndemo: too many arguments (at most 3): unexpected 'd'\ndemo: too many arguments (at most -1): unexpected 'e'\ndemo: invalid number 'abc'\n")
    0

[[test]]
fn test_help_full_exact_stdout() -> i32
    expect_capture(case_help_full, "Usage: demo [OPTIONS] FILE...\n\nA demo program\n\nOptions:\n  -v, --verbose\n        Say more\n  -q\n        Say less\n  -n, --count=NUM\n        How many (default: 10)\n      --name=S\n        Who\n  -x N\n        Short value (default: 3)\n      --dry-run\n        Pretend\n\nArguments:\n  FILE\n        Input files\n", "")
    0

[[test]]
fn test_help_minimal_exact_stdout() -> i32
    expect_capture(case_help_minimal, "Usage: bare\nUsage: one [ARG]\n\nArguments:\n  ARG\n        The arg\nUsage: many [F]...\n\nLots\n\nArguments:\n  F\n        Files\n", "")
    0
