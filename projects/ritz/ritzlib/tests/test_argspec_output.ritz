# Byte-exact stdout/stderr of ritzlib.argspec's printers (AGAST #1642).
#
# arg_error_print and argspec_print_help were hand-rolled eprints/prints
# chains; #1642 turned them into print/eprint interpolation.  These goldens
# pin every byte (and which fd it goes to) so a conversion that drops a
# space, a quote or a newline, or writes to the wrong stream, fails here.
# examples/tier2_stdlib/77_args checks the same text through `$(...)`, which
# strips trailing newlines, and does not reach every error kind.
#
# Each case runs in a forked child with fd 1 and fd 2 on their own pipes.
# The capture helpers are repeated in test_args_output, test_testing_output
# and test_env_output: the runner builds one harness per file.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Capture helpers
# ============================================================================

var g_out: [4096]u8
var g_out_len: i64 = 0
var g_err: [4096]u8
var g_err_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = sys_read(fd, buf + got, cap - got)
        if n > 0
            got = got + n
    got

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

# Run case `which` in a child with stdout/stderr captured into g_out/g_err.
# Returns the child's exit status.
fn run_case(which: i32) -> i32
    var o: [2]i32
    var e: [2]i32
    sys_pipe(@o[0])
    sys_pipe(@e[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_dup2(e[1], 2)
        sys_close(o[0])
        sys_close(o[1])
        sys_close(e[0])
        sys_close(e[1])
        sys_exit(run_body(which))
    sys_close(o[1])
    sys_close(e[1])
    g_out_len = read_all(o[0], @g_out[0], 4096)
    g_err_len = read_all(e[0], @g_err[0], 4096)
    sys_close(o[0])
    sys_close(e[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

fn out_is(want: StrView) -> i32
    bytes_differ(@g_out[0], g_out_len, want)

fn err_is(want: StrView) -> i32
    bytes_differ(@g_err[0], g_err_len, want)

# ============================================================================
# Cases
# ============================================================================

fn demo_spec() -> ArgSpec
    var spec = argspec_new("demo", "A demo program")
    argspec_switch(@&spec, 'v', "verbose", "Say more")
    argspec_switch(@&spec, 'q', "", "Say less")
    argspec_option(@&spec, 'n', "count", "NUM", "How many", Some("10"))
    argspec_option(@&spec, 0, "name", "S", "Who", None)
    argspec_option(@&spec, 'x', "", "N", "Short value", Some("3"))
    argspec_switch(@&spec, 0, "dry-run", "Pretend")
    argspec_positionals(@&spec, "FILE", "Input files", 1, 3)
    spec

fn report(spec: @ArgSpec, kind: ArgErrorKind, text: StrView, limit: i64)
    let e = ArgError { kind: kind, text: text, limit: limit }
    arg_error_print(spec, @e)

fn case_option_errors() -> i32
    let spec = demo_spec()
    report(@spec, ArgErrorKind.UnknownOption, "bogus", 0)
    report(@spec, ArgErrorKind.UnknownOption, "z", 0)
    report(@spec, ArgErrorKind.MissingValue, "n", 0)
    report(@spec, ArgErrorKind.MissingValue, "count", 0)
    report(@spec, ArgErrorKind.UnexpectedValue, "verbose", 0)
    report(@spec, ArgErrorKind.NotSet, "count", 0)
    report(@spec, ArgErrorKind.NotSet, "q", 0)
    0

fn case_value_errors() -> i32
    let spec = demo_spec()
    report(@spec, ArgErrorKind.MissingPositional, "FILE", 1)
    report(@spec, ArgErrorKind.TooManyPositionals, "d", 3)
    report(@spec, ArgErrorKind.TooManyPositionals, "e", -1)
    report(@spec, ArgErrorKind.NotANumber, "abc", 0)
    0

fn case_help_full() -> i32
    let spec = demo_spec()
    argspec_print_help(@spec)
    0

fn case_help_minimal() -> i32
    let bare = argspec_new("bare", "")
    argspec_print_help(@bare)
    var one = argspec_new("one", "")
    argspec_positionals(@&one, "ARG", "The arg", 0, 1)
    argspec_print_help(@one)
    var many = argspec_new("many", "Lots")
    argspec_positionals(@&many, "F", "Files", 0, ARGS_UNLIMITED)
    argspec_print_help(@many)
    0

fn run_body(which: i32) -> i32
    if which == 1
        return case_option_errors()
    if which == 2
        return case_value_errors()
    if which == 3
        return case_help_full()
    case_help_minimal()

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_option_errors_exact_stderr() -> i32
    assert run_case(1) == 0
    assert out_is("") == 0
    assert err_is("demo: unknown option '--bogus'\ndemo: unknown option '-z'\ndemo: option '-n' requires a value\ndemo: option '--count' requires a value\ndemo: option '--verbose' doesn't accept a value\ndemo: option '--count' has no value\ndemo: option '-q' has no value\n") == 0
    0

[[test]]
fn test_value_errors_exact_stderr() -> i32
    assert run_case(2) == 0
    assert out_is("") == 0
    assert err_is("demo: missing required argument 'FILE'\ndemo: too many arguments (at most 3): unexpected 'd'\ndemo: too many arguments (at most -1): unexpected 'e'\ndemo: invalid number 'abc'\n") == 0
    0

[[test]]
fn test_help_full_exact_stdout() -> i32
    assert run_case(3) == 0
    assert err_is("") == 0
    assert out_is("Usage: demo [OPTIONS] FILE...\n\nA demo program\n\nOptions:\n  -v, --verbose\n        Say more\n  -q\n        Say less\n  -n, --count=NUM\n        How many (default: 10)\n      --name=S\n        Who\n  -x N\n        Short value (default: 3)\n      --dry-run\n        Pretend\n\nArguments:\n  FILE\n        Input files\n") == 0
    0

[[test]]
fn test_help_minimal_exact_stdout() -> i32
    assert run_case(4) == 0
    assert err_is("") == 0
    assert out_is("Usage: bare\nUsage: one [ARG]\n\nArguments:\n  ARG\n        The arg\nUsage: many [F]...\n\nLots\n\nArguments:\n  F\n        Files\n") == 0
    0
