# Tests for ritzlib/cmp.ritz: Ordering, what every three-way compare returns
# (AGAST #4639, replacing the C -1/0/1 i32).

import ritzlib.cmp

[[test]]
fn test_ordering_predicates() -> i32
    assert Ordering.Less.is_lt()
    assert Ordering.Less.is_le()
    assert Ordering.Less.is_ne()
    assert not Ordering.Less.is_eq()
    assert not Ordering.Less.is_gt()
    assert not Ordering.Less.is_ge()

    assert Ordering.Equal.is_eq()
    assert Ordering.Equal.is_le()
    assert Ordering.Equal.is_ge()
    assert not Ordering.Equal.is_ne()
    assert not Ordering.Equal.is_lt()
    assert not Ordering.Equal.is_gt()

    assert Ordering.Greater.is_gt()
    assert Ordering.Greater.is_ge()
    assert Ordering.Greater.is_ne()
    assert not Ordering.Greater.is_eq()
    assert not Ordering.Greater.is_lt()
    assert not Ordering.Greater.is_le()
    0

[[test]]
fn test_ordering_reverse() -> i32
    assert Ordering.Less.reverse() == Ordering.Greater
    assert Ordering.Equal.reverse() == Ordering.Equal
    assert Ordering.Greater.reverse() == Ordering.Less
    0

[[test]]
fn test_cmp_i64() -> i32
    assert cmp_i64(1, 2) == Ordering.Less
    assert cmp_i64(2, 2) == Ordering.Equal
    assert cmp_i64(0 - 9223372036854775807 - 1, 9223372036854775807) == Ordering.Less
    assert cmp_i64(3, 0 - 3) == Ordering.Greater
    0
