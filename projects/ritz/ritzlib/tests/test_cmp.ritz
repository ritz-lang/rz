# Tests for ritzlib/cmp.ritz: Ordering, what every three-way compare returns
# (AGAST #4639, replacing the C -1/0/1 i32).

import ritzlib.cmp

[[test]]
fn test_ordering_predicates() -> i32
    # Bound to locals: ritz1 cannot type a method call on an enum-variant
    # path (`Ordering.Less.is_lt()`) as an assert condition.
    let less: Ordering = Ordering.Less
    let equal: Ordering = Ordering.Equal
    let greater: Ordering = Ordering.Greater

    assert less.is_lt()
    assert less.is_le()
    assert less.is_ne()
    assert not less.is_eq()
    assert not less.is_gt()
    assert not less.is_ge()

    assert equal.is_eq()
    assert equal.is_le()
    assert equal.is_ge()
    assert not equal.is_ne()
    assert not equal.is_lt()
    assert not equal.is_gt()

    assert greater.is_gt()
    assert greater.is_ge()
    assert greater.is_ne()
    assert not greater.is_eq()
    assert not greater.is_lt()
    assert not greater.is_le()
    0

[[test]]
fn test_ordering_reverse() -> i32
    # Locals, as in test_ordering_predicates: ritz1 cannot type a method
    # call on an enum-variant path.
    let less: Ordering = Ordering.Less
    let equal: Ordering = Ordering.Equal
    let greater: Ordering = Ordering.Greater

    assert less.reverse() == Ordering.Greater
    assert equal.reverse() == Ordering.Equal
    assert greater.reverse() == Ordering.Less
    0

[[test]]
fn test_cmp_i64() -> i32
    assert cmp_i64(1, 2) == Ordering.Less
    assert cmp_i64(2, 2) == Ordering.Equal
    assert cmp_i64(0 - 9223372036854775807 - 1, 9223372036854775807) == Ordering.Less
    assert cmp_i64(3, 0 - 3) == Ordering.Greater
    0
