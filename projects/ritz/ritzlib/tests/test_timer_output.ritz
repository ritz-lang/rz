# Byte-exact stdout of ritzlib.timer's printers (AGAST #1684).
#
# timer_print and stopwatch_print were prints/print_int chains; #1684 made
# each one interpolated print.  Elapsed time is pinned by filling the Timer /
# Stopwatch fields directly, so every unit branch (ns, µs, ms, s) and the
# N/A branch print fixed bytes.
#
# The microsecond unit is "µs", two UTF-8 bytes (C2 B5): a "..." literal
# holds those bytes, so the expectations compare them exactly.
#
# ritz1 parity: ritz0/tests/test_ritzlib_output_goldens.py.
# Each case runs under testlib's capture.

import ritzlib.io
import ritzlib.strview
import ritzlib.timer
import ritzlib.testlib


# ============================================================================
# Cases
# ============================================================================

# Print a Timer whose elapsed time is exactly `ns`, then a newline.
fn show(ns: i64)
    var t: Timer
    t.init()
    t.end.tv_nsec = ns
    t.print()
    print("\n")

fn case_timer() -> i32
    show(0)
    show(999)
    show(-5)
    show(1000)
    show(1999)
    show(999999)
    show(1000000)
    show(2345678)
    show(1000000000)
    show(12345678901)
    0

fn case_stopwatch() -> i32
    var sw: Stopwatch
    sw.init()
    sw.total_ns = 5000000
    sw.print()
    print("\n")
    sw.total_ns = 7500000
    sw.count = 3
    sw.print()
    0

[[test]]
fn test_timer_print_exact() -> i32
    expect_capture(case_timer, "0ns\n999ns\n-5ns\n1.0µs\n1.9µs\n999.9µs\n1.0ms\n2.3ms\n1.0s\n12.3s\n", "")
    0

[[test]]
fn test_stopwatch_print_exact() -> i32
    expect_capture(case_stopwatch, "Stopwatch: total=5ms, count=0, avg=N/A\nStopwatch: total=7ms, count=3, avg=2500µs", "")
    0
