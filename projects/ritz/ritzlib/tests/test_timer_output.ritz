# Byte-exact stdout of ritzlib.timer's printers (AGAST #1684).
#
# timer_print and stopwatch_print were prints/print_int chains; #1684 made
# each one interpolated print.  Elapsed time is pinned by filling the Timer /
# Stopwatch fields directly, so every unit branch (ns, µs, ms, s) and the
# N/A branch print fixed bytes.
#
# The microsecond unit prints as "µ", not "µs": ritz0 sizes a plain "..."
# literal by code points, not bytes, so "µs" loses its last byte (#1694).
# Expectations are c"..." (sized by NUL) so they hold the real bytes; when
# #1694 is fixed, every "µ" below becomes "µs".
#
# ritz1 parity: ritz0/test_ritzlib_output_goldens.py.
# Capture helpers: see test_argspec_output.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.timer


# ============================================================================
# Capture helpers
# ============================================================================

var g_out: [4096]u8
var g_out_len: i64 = 0
var g_err: [4096]u8
var g_err_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = sys_read(fd, buf + got, cap - got)
        if n > 0
            got = got + n
    got

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

# Run case `which` in a child with stdout/stderr captured into g_out/g_err.
# Returns the child's exit status.
fn run_case(which: i32) -> i32
    var o: [2]i32
    var e: [2]i32
    sys_pipe(@o[0])
    sys_pipe(@e[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_dup2(e[1], 2)
        sys_close(o[0])
        sys_close(o[1])
        sys_close(e[0])
        sys_close(e[1])
        sys_exit(run_body(which))
    sys_close(o[1])
    sys_close(e[1])
    g_out_len = read_all(o[0], @g_out[0], 4096)
    g_err_len = read_all(e[0], @g_err[0], 4096)
    sys_close(o[0])
    sys_close(e[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

fn out_is(want: StrView) -> i32
    bytes_differ(@g_out[0], g_out_len, want)

fn out_is_c(want: *u8) -> i32
    var n: i64 = 0
    while *(want + n) != 0
        n += 1
    bytes_differ(@g_out[0], g_out_len, StrView { ptr: want, len: n })

fn err_is(want: StrView) -> i32
    bytes_differ(@g_err[0], g_err_len, want)

# ============================================================================
# Cases
# ============================================================================

# Print a Timer whose elapsed time is exactly `ns`, then a newline.
fn show(ns: i64)
    var t: Timer
    timer_init(@t)
    t.end.tv_nsec = ns
    timer_print(@t)
    print("\n")

fn case_timer() -> i32
    show(0)
    show(999)
    show(-5)
    show(1000)
    show(1999)
    show(999999)
    show(1000000)
    show(2345678)
    show(1000000000)
    show(12345678901)
    0

fn case_stopwatch() -> i32
    var sw: Stopwatch
    stopwatch_init(@sw)
    sw.total_ns = 5000000
    stopwatch_print(@sw)
    print("\n")
    sw.total_ns = 7500000
    sw.count = 3
    stopwatch_print(@sw)
    0

fn run_body(which: i32) -> i32
    if which == 1
        return case_timer()
    case_stopwatch()

[[test]]
fn test_timer_print_exact() -> i32
    assert run_case(1) == 0
    assert out_is_c(c"0ns\n999ns\n-5ns\n1.0µ\n1.9µ\n999.9µ\n1.0ms\n2.3ms\n1.0s\n12.3s\n") == 0
    assert err_is("") == 0
    0

[[test]]
fn test_stopwatch_print_exact() -> i32
    assert run_case(2) == 0
    assert out_is_c(c"Stopwatch: total=5ms, count=0, avg=N/A\nStopwatch: total=7ms, count=3, avg=2500µ") == 0
    assert err_is("") == 0
    0
