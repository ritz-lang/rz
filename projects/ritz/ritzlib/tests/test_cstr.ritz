# Tests for ritzlib/cstr.ritz: the one C-interop module (AGAST #4688).

import ritzlib.cstr
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview

[[test]]
fn test_strlen_stops_at_nul() -> i32
    assert strlen(c"") == 0
    assert strlen(c"hello") == 5
    0

[[test]]
fn test_streq() -> i32
    assert streq(c"abc", c"abc")
    assert not streq(c"abc", c"abd")
    assert not streq(c"abc", c"ab")
    assert not streq(c"ab", c"abc")
    assert streq(c"", c"")
    0

[[test]]
fn test_strneq_bounds_the_compare() -> i32
    assert strneq(c"abcX", c"abcY", 3)
    assert not strneq(c"abcX", c"abcY", 4)
    assert strneq(c"ab", c"ab", 9)
    0

[[test]]
fn test_strview_from_cstr_measures_to_nul() -> i32
    let v: StrView = strview_from_cstr(c"hello")
    assert v.len() == 5
    assert v.eq("hello")
    assert strview_from_cstr(c"").is_empty()
    0

[[test]]
fn test_string_from_cstr_copies() -> i32
    var s: String = string_from_cstr(c"copy me")
    assert s.eq("copy me")
    assert s.len() == 7
    s.deinit()
    0

[[test]]
fn test_cstr_of_is_nul_terminated() -> i32
    var s: String = string_from("abc")
    let p: *u8 = cstr_of(@&s)
    assert *p == 'a'
    assert *(p + 3) == 0
    assert strlen(p) == 3
    assert streq(p, c"abc")
    s.deinit()
    0

[[test]]
fn test_cstr_of_empty_string() -> i32
    var s: String = string_new()
    assert strlen(cstr_of(@&s)) == 0
    s.deinit()
    0

[[test]]
fn test_vec_push_view_appends_bytes() -> i32
    var v: Vec<u8> = vec_new<u8>()
    assert v.push_view("he")
    assert v.push_view("")
    assert v.push_view("llo")
    assert v.len == 5
    assert strview_from_ptr(v.data, v.len).eq("hello")
    v.deinit()
    0
