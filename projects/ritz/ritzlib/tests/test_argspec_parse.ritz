# Tests for ritzlib.argspec (AGAST #1448): argspec_parse success paths and the parsed_* readers.
#
# Split across test_argspec_*.ritz because the runner compiles one harness
# per test and gives each FILE 180s; the helpers below are repeated per file.
#
# The legacy ArgParser API (args_init / args_parse / ...) is deliberately not
# covered here: its layout is pinned by ritz1 (#1440) and it is on its way out
# once callers are ported.  Everything below goes through ArgSpec/ParsedArgs.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec

# ============================================================================
# Helpers
# ============================================================================

# A spec shaped like a small coreutil:  demo [-v] [-q] [-n NUM] [--name=S] FILE...
fn demo_spec() -> ArgSpec
    var spec = argspec_new("demo", "A demo program")
    argspec_switch(@&spec, 'v', "verbose", "Say more")
    argspec_switch(@&spec, 'q', "", "Say less (short only)")
    argspec_option(@&spec, 'n', "count", "NUM", "How many", Some("10"))
    argspec_option(@&spec, 0, "name", "S", "Who (long only, no default)", None)
    argspec_positionals(@&spec, "FILE", "Input files", 1, 3)
    spec

fn kind_code(k: ArgErrorKind) -> i64
    match k
        UnknownOption => 1
        MissingValue => 2
        UnexpectedValue => 3
        MissingPositional => 4
        TooManyPositionals => 5
        NotANumber => 6
        NotSet => 7

fn err_code(e: ArgError) -> i64
    kind_code(e.kind)

fn sv_eq(a: StrView, b: StrView) -> bool
    strview_eq(@a, @b) != 0

fn opt_is(o: Option<StrView>, want: StrView) -> bool
    match o
        Some(s) => sv_eq(s, want)
        None => false

fn opt_none(o: Option<StrView>) -> bool
    match o
        Some(s) => false
        None => true

# ============================================================================
# Parsing: success paths
# ============================================================================

[[test]]
fn test_parse_defaults_when_nothing_given() -> i32
    var spec = demo_spec()
    var a: [1]StrView
    a[0] = "in.txt"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 1))
        Ok(p) => check_defaults(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_defaults(p: @ParsedArgs) -> i32
    if (parsed_switch(p, "verbose") == false) == false
        return 1
    if (parsed_is_set(p, "count") == false) == false
        return 2
    if (opt_is(parsed_value(p, "count"), "10")) == false      # default
        return 3
    if (opt_none(parsed_value(p, "name"))) == false            # no default
        return 4
    if (opt_is(parsed_positional(p, 0), "in.txt")) == false
        return 5
    0

[[test]]
fn test_parse_long_forms() -> i32
    var spec = demo_spec()
    var a: [5]StrView
    a[0] = "--verbose"
    a[1] = "--count=42"
    a[2] = "--name"
    a[3] = "bob"
    a[4] = "x"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 5))
        Ok(p) => check_long_forms(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_long_forms(p: @ParsedArgs) -> i32
    if parsed_switch(p, "count")  # a value option is not a switch
        return 90
    if (parsed_switch(p, "verbose")) == false
        return 6
    if (parsed_switch(p, "v")) == false
        return 7
    if (parsed_is_set(p, "count")) == false
        return 8
    if (opt_is(parsed_value(p, "count"), "42")) == false
        return 9
    if (opt_is(parsed_value(p, "name"), "bob")) == false
        return 10
    if (opt_is(parsed_positional(p, 0), "x")) == false
        return 11
    0

[[test]]
fn test_parse_short_forms_bundled_and_attached() -> i32
    var spec = demo_spec()
    var a: [4]StrView
    a[0] = "-vq"
    a[1] = "-n7"
    a[2] = "f1"
    a[3] = "f2"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 4))
        Ok(p) => check_short_forms(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_short_forms(p: @ParsedArgs) -> i32
    if (parsed_switch(p, "v")) == false
        return 12
    if (parsed_switch(p, "q")) == false
        return 13
    if (opt_is(parsed_value(p, "n"), "7")) == false
        return 14
    let ps = parsed_positionals(p)
    if (ps.len == 2) == false
        return 15
    if (opt_is(args_get(@ps, 1), "f2")) == false
        return 16
    0

[[test]]
fn test_parse_short_value_in_next_arg() -> i32
    var spec = demo_spec()
    var a: [3]StrView
    a[0] = "-vn"
    a[1] = "99"
    a[2] = "f"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 3))
        Ok(p) => check_short_next(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_short_next(p: @ParsedArgs) -> i32
    if (parsed_switch(p, "verbose")) == false
        return 17
    if (opt_is(parsed_value(p, "count"), "99")) == false
        return 18
    if (opt_is(parsed_positional(p, 0), "f")) == false
        return 19
    if (opt_none(parsed_positional(p, 1))) == false
        return 20
    0

[[test]]
fn test_parse_double_dash_ends_options() -> i32
    var spec = demo_spec()
    var a: [3]StrView
    a[0] = "--"
    a[1] = "-v"
    a[2] = "--count=1"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 3))
        Ok(p) => check_double_dash(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_double_dash(p: @ParsedArgs) -> i32
    if (parsed_switch(p, "v") == false) == false
        return 21
    if (opt_is(parsed_positional(p, 0), "-v")) == false
        return 22
    if (opt_is(parsed_positional(p, 1), "--count=1")) == false
        return 23
    0

[[test]]
fn test_parse_lone_dash_is_positional() -> i32
    var spec = demo_spec()
    var a: [1]StrView
    a[0] = "-"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 1))
        Ok(p) => check_lone_dash(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_lone_dash(p: @ParsedArgs) -> i32
    if (opt_is(parsed_positional(p, 0), "-")) == false
        return 24
    0

[[test]]
fn test_parse_last_value_wins() -> i32
    var spec = demo_spec()
    var a: [3]StrView
    a[0] = "-n1"
    a[1] = "--count=2"
    a[2] = "f"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 3))
        Ok(p) => check_last_wins(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_last_wins(p: @ParsedArgs) -> i32
    if (opt_is(parsed_value(p, "count"), "2")) == false
        return 25
    0

[[test]]
fn test_parse_unknown_name_lookups_are_none() -> i32
    var spec = demo_spec()
    var a: [1]StrView
    a[0] = "f"
    match argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 1))
        Ok(p) => check_unknown_lookup(@p)
        Err(e) => (100 + err_code(e)) as i32

fn check_unknown_lookup(p: @ParsedArgs) -> i32
    if (parsed_switch(p, "bogus") == false) == false
        return 26
    if (parsed_is_set(p, "bogus") == false) == false
        return 27
    if (opt_none(parsed_value(p, "bogus"))) == false
        return 28
    0

[[test]]
fn test_parsed_drop_releases_storage() -> i32
    var spec = demo_spec()
    var a: [1]StrView
    a[0] = "f"
    var r = argspec_parse(@spec, span_from_ptr<StrView>(@a[0], 1))
    let n: i64 = match r
        Ok(p) => drop_and_count(p)
        Err(e) => -1
    assert n == 0
    argspec_drop(@&spec)
    assert vec_len<ArgFlag>(@spec.flags) == 0
    0

fn drop_and_count(p: ParsedArgs) -> i64
    var q = p
    parsed_drop(@&q)
    vec_len<StrView>(@q.positionals)
