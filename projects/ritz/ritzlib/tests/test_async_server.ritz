# test_async_server.ritz - Test ritzlib's async runtime
#
# ritzlib.async.tasks runs N tasks on one ring; ritzlib.async.runtime drives one
# future.  These tests schedule real work through both.

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async.tasks
import ritzlib.async.runtime


# ============================================================================
# Test 1: Task initialization and pool management
# ============================================================================

[[test]]
fn test_task_pool_init() -> i32
    var ring: IoUring
    let ret = uring_init(@ring, 64)
    if ret < 0
        prints("FAIL: uring_init failed\n")
        return 1

    var pool: TaskPool
    task_pool_init(@pool, @ring)

    # Verify initial state
    if pool.active_count != 0
        prints("FAIL: active_count should be 0\n")
        uring_destroy(@ring)
        return 1

    if pool.next_id != 1
        prints("FAIL: next_id should be 1\n")
        uring_destroy(@ring)
        return 1

    uring_destroy(@ring)
    prints("OK: task_pool_init\n")
    return 0


# ============================================================================
# Test 2: Task allocation
# ============================================================================

fn dummy_handler(task: *Task) -> i32
    return 0

[[test]]
fn test_task_alloc() -> i32
    var ring: IoUring
    uring_init(@ring, 64)

    var pool: TaskPool
    task_pool_init(@pool, @ring)

    # Spawn a task
    let ret = spawn_task(@pool, 99, dummy_handler)
    if ret != 0
        prints("FAIL: spawn_task failed\n")
        uring_destroy(@ring)
        return 1

    if pool.active_count != 1
        prints("FAIL: active_count should be 1\n")
        uring_destroy(@ring)
        return 1

    # Find the task
    let task = task_pool_find(@pool, 1)  # First task gets ID 1
    if task == null
        prints("FAIL: task not found\n")
        uring_destroy(@ring)
        return 1

    if task.fd != 99
        prints("FAIL: task.fd should be 99\n")
        uring_destroy(@ring)
        return 1

    if task.state != TASK_READY
        prints("FAIL: task.state should be TASK_READY\n")
        uring_destroy(@ring)
        return 1

    uring_destroy(@ring)
    prints("OK: task_alloc\n")
    return 0


# ============================================================================
# Test 3: Task completion
# ============================================================================

[[test]]
fn test_task_complete() -> i32
    var ring: IoUring
    uring_init(@ring, 64)

    var pool: TaskPool
    task_pool_init(@pool, @ring)

    # Spawn a task (use -1 for fd so sys_close doesn't fail)
    spawn_task(@pool, -1, dummy_handler)

    if pool.active_count != 1
        prints("FAIL: active_count should be 1 after spawn\n")
        uring_destroy(@ring)
        return 1

    # Complete the task
    let task = task_pool_find(@pool, 1)
    task.fd = -1  # Prevent close attempt
    task_complete(@pool, task)

    if pool.active_count != 0
        prints("FAIL: active_count should be 0 after complete\n")
        uring_destroy(@ring)
        return 1

    # Task should now be idle
    if task.state != TASK_IDLE
        prints("FAIL: task.state should be TASK_IDLE\n")
        uring_destroy(@ring)
        return 1

    uring_destroy(@ring)
    prints("OK: task_complete\n")
    return 0


# ============================================================================
# Test 4: run_tasks resumes a task after its I/O completes
# ============================================================================

var g_yield_polls: i32 = 0

fn yield_once_handler(task: *Task) -> i32
    g_yield_polls = g_yield_polls + 1
    if task.handler_state == 0
        task.handler_state = 1
        task_yield(task)
        return -1
    return 0

[[test]]
fn test_run_tasks_resumes_after_yield() -> i32
    var ring: IoUring
    uring_init(@ring, 64)

    var pool: TaskPool
    task_pool_init(@pool, @ring)

    g_yield_polls = 0
    spawn_task(@pool, -1, yield_once_handler)

    let ret = run_tasks(@pool)
    uring_destroy(@ring)

    if ret != 0
        prints("FAIL: run_tasks failed\n")
        return 1
    if g_yield_polls != 2
        prints("FAIL: the handler should be polled twice\n")
        return 1
    if pool.active_count != 0
        prints("FAIL: the task should have completed\n")
        return 1
    return 0


# ============================================================================
# Test 5: block_on suspends a future on real I/O
# ============================================================================

struct PipeOp
    rt: *Runtime
    fd: i32
    buf: *u8
    len: i32
    polls: i32

fn pipe_read_poll(raw: *u8) -> i32
    let op = raw as *PipeOp
    op.polls = op.polls + 1
    return runtime_poll_read(op.rt, op.fd, op.buf, op.len, 0)

fn pipe_write_poll(raw: *u8) -> i32
    let op = raw as *PipeOp
    op.polls = op.polls + 1
    return runtime_poll_write(op.rt, op.fd, op.buf, op.len, 0)

[[test]]
fn test_block_on_read_suspends_then_returns_the_io_result() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    sys_write(fds[1], c"hello", 5)

    var rt: Runtime
    if runtime_init(@rt) < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var buf: [8]u8
    var op: PipeOp
    op.rt = @rt
    op.fd = fds[0]
    op.buf = @buf[0]
    op.len = 5
    op.polls = 0

    let poll_fn: fn(*u8) -> i32 = pipe_read_poll
    let result: i32 = block_on(@rt, @op as *u8, poll_fn)
    let leftover: i32 = rt.waker_io_result
    let armed: i32 = rt.waker_active
    runtime_destroy(@rt)
    sys_close(fds[0])
    sys_close(fds[1])

    if result != 5
        prints("FAIL: block_on should return the bytes read\n")
        return 1
    if op.polls != 2
        prints("FAIL: the future should be polled once per side of the I/O\n")
        return 1
    if buf[0] != 104
        prints("FAIL: the read did not land in the buffer\n")
        return 1
    if leftover != 0
        prints("FAIL: taking the result should clear it\n")
        return 1
    if armed != 0
        prints("FAIL: the completion should disarm the waker\n")
        return 1
    return 0

[[test]]
fn test_block_on_write_reaches_the_fd() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    var rt: Runtime
    if runtime_init(@rt) < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var op: PipeOp
    op.rt = @rt
    op.fd = fds[1]
    op.buf = c"hi"
    op.len = 2
    op.polls = 0

    let poll_fn: fn(*u8) -> i32 = pipe_write_poll
    let result: i32 = block_on(@rt, @op as *u8, poll_fn)
    runtime_destroy(@rt)

    var buf: [4]u8
    let n: i64 = sys_read(fds[0], @buf[0], 4)
    sys_close(fds[0])
    sys_close(fds[1])

    if result != 2
        prints("FAIL: block_on should return the bytes written\n")
        return 1
    if n != 2
        prints("FAIL: the bytes should be in the pipe\n")
        return 1
    if buf[1] != 105
        prints("FAIL: the wrong bytes reached the pipe\n")
        return 1
    return 0


# ============================================================================
# Test 6: block_on refuses to spin on a future that can never wake
# ============================================================================

fn always_pending_poll(raw: *u8) -> i32
    return POLL_PENDING

[[test]]
fn test_block_on_pending_without_a_waker_is_einval() -> i32
    var rt: Runtime
    if runtime_init(@rt) < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    var unused: i32 = 0
    let poll_fn: fn(*u8) -> i32 = always_pending_poll
    let result: i32 = block_on(@rt, @unused as *u8, poll_fn)
    runtime_destroy(@rt)

    if result != -22
        prints("FAIL: expected -EINVAL\n")
        return 1
    return 0


# ============================================================================
# Test 7: only the registered operation's completion disarms the waker
# ============================================================================

fn submit_nop(rt: *Runtime, user_data: i64)
    let sqe: *IoUringSqe = uring_get_sqe(@rt.ring)
    uring_prep_nop(sqe, user_data)
    uring_sqe_submit(@rt.ring)

[[test]]
fn test_waker_ignores_another_operations_completion() -> i32
    var rt: Runtime
    if runtime_init(@rt) < 0
        prints("FAIL: runtime_init failed\n")
        return 1

    runtime_waker_register(@rt, 500)

    submit_nop(@rt, 600)
    runtime_wait_for_io(@rt)
    let after_stray: i32 = rt.waker_active

    submit_nop(@rt, 500)
    runtime_wait_for_io(@rt)
    let after_match: i32 = rt.waker_active
    runtime_destroy(@rt)

    if after_stray != 1
        prints("FAIL: a stray completion disarmed the waker\n")
        return 1
    if after_match != 0
        prints("FAIL: the matching completion should disarm the waker\n")
        return 1
    return 0


# ============================================================================
# Test 8: Uring vectored I/O prep functions exist
# ============================================================================

[[test]]
fn test_uring_writev() -> i32
    var ring: IoUring
    uring_init(@ring, 64)

    let sqe = uring_get_sqe(@ring)
    if sqe == null
        prints("FAIL: uring_get_sqe failed\n")
        uring_destroy(@ring)
        return 1

    # Just verify the function compiles and can be called
    var buf: [16]u8
    uring_prep_writev(sqe, 1, @buf[0], 1, 0, 123)

    if sqe.opcode != IORING_OP_WRITEV
        prints("FAIL: opcode should be IORING_OP_WRITEV\n")
        uring_destroy(@ring)
        return 1

    if sqe.user_data != 123
        prints("FAIL: user_data should be 123\n")
        uring_destroy(@ring)
        return 1

    uring_destroy(@ring)
    prints("OK: uring_writev\n")
    return 0
