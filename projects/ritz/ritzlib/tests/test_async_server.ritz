# test_async_server.ritz - Test ritzlib's async runtime
#
# ritzlib.async.tasks runs N tasks on one ring; ritzlib.async.runtime drives one
# future.  These tests schedule real work through both.

import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.iovec
import ritzlib.span
import ritzlib.async.tasks
import ritzlib.async.runtime
import ritzlib.fd
import ritzlib.net
import ritzlib.option
import ritzlib.result

# A test whose Runtime could not be created fails with this.
fn no_runtime() -> i32
    prints("FAIL: Runtime.new failed\n")
    1


# A fresh 64-entry ring, or None where io_uring is unavailable.
fn test_ring() -> Option<IoUring>
    match IoUring.new(64)
        Ok(r) => Some(r)
        Err(_) => None

# ============================================================================
# Test 1: Task initialization and pool management
# ============================================================================

[[test]]
fn test_task_pool_init()
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return
    var pool: TaskPool
    pool.init(@&ring)

    assert pool.active_count == 0
    assert pool.next_id == 1
    ring.destroy()


# ============================================================================
# Test 2: Task allocation
# ============================================================================

fn dummy_handler(task: @&Task) -> TaskStep
    TaskStep.Done

[[test]]
fn test_task_alloc()
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return
    var pool: TaskPool
    pool.init(@&ring)

    # The pool takes the descriptor; 99 is never opened, so closing it is a no-op.
    assert pool.spawn(fd_adopt(99), dummy_handler)
    assert pool.active_count == 1

    # First task gets ID 1
    let task: @&Task = match pool.find(1)
        Some(t) => t
        None => return assert_never()
    assert task.fd == 99
    assert task.state == TASK_READY
    ring.destroy()


# ============================================================================
# Test 3: Task completion
# ============================================================================

[[test]]
fn test_task_complete()
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return
    var pool: TaskPool
    pool.init(@&ring)

    # A closed Fd (-1), so completing the task closes nothing.
    assert pool.spawn(fd_adopt(-1), dummy_handler)
    assert pool.active_count == 1

    let task: @&Task = match pool.find(1)
        Some(t) => t
        None => return assert_never()
    pool.complete(task)

    assert pool.active_count == 0
    assert task.state == TASK_IDLE
    ring.destroy()

# A full pool refuses the task and closes the descriptor it was handed: the
# pool owns it from the call on (AGAST #4929).
[[test]]
fn test_spawn_on_a_full_pool_closes_the_fd()
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return
    var pool: TaskPool
    pool.init(@&ring)
    for i in 0..256
        assert pool.spawn(fd_adopt(-1), dummy_handler)

    var fds: [2]i32
    assert sys_pipe(@fds[0]) == 0
    assert not pool.spawn(fd_adopt(fds[0]), dummy_handler)
    # The read end was closed: a second close of it is EBADF.
    assert sys_close(fds[0]) < 0
    sys_close(fds[1])
    ring.destroy()

# Reached only on a broken invariant: fails the test.
[[test_helper]]
fn assert_never()
    assert false


# ============================================================================
# Test 4: TaskPool.run resumes a task after its I/O completes
# ============================================================================

var g_yield_polls: i32 = 0

fn yield_once_handler(task: @&Task) -> TaskStep
    g_yield_polls = g_yield_polls + 1
    if task.handler_state == 0
        task.handler_state = 1
        task.yield()
        return TaskStep.Pending
    TaskStep.Done

[[test]]
fn test_run_tasks_resumes_after_yield()
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return
    var pool: TaskPool
    pool.init(@&ring)

    g_yield_polls = 0
    assert pool.spawn(fd_adopt(-1), yield_once_handler)

    let ran: bool = match pool.run()
        Ok(_) => true
        Err(_) => false
    ring.destroy()

    assert ran
    # Pending kept the task for its NOP's completion; Done finished it.
    assert g_yield_polls == 2
    assert pool.active_count == 0


# ============================================================================
# Test 4b: TaskServer.new serves a listener until its shutdown hook says so
# ============================================================================

var g_hook_calls: i32 = 0

fn stop_now() -> bool
    g_hook_calls = g_hook_calls + 1
    true

fn close_listener(listener: @&Socket)
    listener.close()

[[test]]
fn test_task_server_runs_until_the_shutdown_hook_is_true()
    var listener: Socket = match socket_tcp()
        Ok(s) => s
        Err(_) => return
    assert listener.bind("127.0.0.1", 0).is_ok()
    assert listener.listen(8).is_ok()

    let srv: @&TaskServer = match TaskServer.new(@listener)
        Ok(s) => s
        Err(_) => return close_listener(@&listener)
    g_hook_calls = 0
    srv.set_shutdown_hook(stop_now)
    let ran: bool = match srv.run(dummy_handler)
        Ok(_) => true
        Err(_) => false
    srv.free()
    listener.close()

    assert ran
    assert g_hook_calls == 1


# ============================================================================
# Test 5: block_on suspends a future on real I/O
# ============================================================================

struct PipeOp
    rt: *Runtime
    fd: i32
    buf: *u8
    len: i32
    polls: i32

# Poll sources over the runtime's poll operations.  A plain fn returning
# `Option<i32>` (None = Pending, AGAST #4558) is awaited directly by the
# compiler-generated future; there is no hand-written adapter to cast to
# *Future (LARB R79, AGAST #4009).
fn pipe_read_source(op: *PipeOp) -> Option<i32>
    op.polls = op.polls + 1
    return op.rt.poll_read(op.fd, Span<u8> { ptr: (op.buf), len: (op.len) as i64 }, 0)

fn pipe_write_source(op: *PipeOp) -> Option<i32>
    op.polls = op.polls + 1
    return op.rt.poll_write(op.fd, Span<u8> { ptr: (op.buf), len: (op.len) as i64 }, 0)

async fn pipe_read(op: *PipeOp) -> i32
    let result: i32 = await pipe_read_source(op)
    result

async fn pipe_write(op: *PipeOp) -> i32
    let result: i32 = await pipe_write_source(op)
    result

[[test]]
fn test_block_on_read_suspends_then_returns_the_io_result() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    sys_write(fds[1], c"hello", 5)

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    var buf: [8]u8
    var op: PipeOp
    op.rt = @rt
    op.fd = fds[0]
    op.buf = @buf[0]
    op.len = 5
    op.polls = 0

    var p = pipe_read(@op)
    rt.block_on(@&p)
    let result: i32 = await p
    let leftover: i32 = rt.waker_io_ready
    let armed: i32 = rt.waker_active
    rt.destroy()
    sys_close(fds[0])
    sys_close(fds[1])

    if result != 5
        prints("FAIL: block_on should return the bytes read\n")
        return 1
    if op.polls != 2
        prints("FAIL: the future should be polled once per side of the I/O\n")
        return 1
    if buf[0] != 104
        prints("FAIL: the read did not land in the buffer\n")
        return 1
    if leftover != 0
        prints("FAIL: taking the result should clear it\n")
        return 1
    if armed != 0
        prints("FAIL: the completion should disarm the waker\n")
        return 1
    return 0

[[test]]
fn test_block_on_write_reaches_the_fd() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    var op: PipeOp
    op.rt = @rt
    op.fd = fds[1]
    op.buf = c"hi"
    op.len = 2
    op.polls = 0

    var p = pipe_write(@op)
    rt.block_on(@&p)
    let result: i32 = await p
    rt.destroy()

    var buf: [4]u8
    let n: i64 = sys_read(fds[0], @buf[0], 4)
    sys_close(fds[0])
    sys_close(fds[1])

    if result != 2
        prints("FAIL: block_on should return the bytes written\n")
        return 1
    if n != 2
        prints("FAIL: the bytes should be in the pipe\n")
        return 1
    if buf[1] != 105
        prints("FAIL: the wrong bytes reached the pipe\n")
        return 1
    return 0


# ============================================================================
# Test 5b: a result of 0 or -1 is a result, not "none yet" (AGAST #2328)
# ============================================================================
#
# 0 is a read at EOF or a zero-length write; -1 is -EPERM.  Before #2328 the runtime took a stored result of 0 to
# mean "nothing has completed", so an EOF read was resubmitted for ever.

[[test]]
fn test_block_on_read_at_eof_returns_zero() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1
    sys_close(fds[1])   # closed and empty: the read completes with 0

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    var buf: [8]u8
    var op: PipeOp
    op.rt = @rt
    op.fd = fds[0]
    op.buf = @buf[0]
    op.len = 8
    op.polls = 0

    var p = pipe_read(@op)
    rt.block_on(@&p)
    let result: i32 = await p
    let leftover: i32 = rt.waker_io_ready
    rt.destroy()
    sys_close(fds[0])

    if result != 0
        prints("FAIL: a read at EOF should return 0\n")
        return 1
    if op.polls != 2
        prints("FAIL: the EOF read was resubmitted instead of returned\n")
        return 1
    if leftover != 0
        prints("FAIL: taking the result should clear it\n")
        return 1
    return 0

[[test]]
fn test_block_on_zero_length_write_returns_zero() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    var op: PipeOp
    op.rt = @rt
    op.fd = fds[1]
    op.buf = c"x"
    op.len = 0
    op.polls = 0

    var p = pipe_write(@op)
    rt.block_on(@&p)
    let result: i32 = await p
    rt.destroy()
    sys_close(fds[0])
    sys_close(fds[1])

    if result != 0
        prints("FAIL: a zero-length write should return 0\n")
        return 1
    if op.polls != 2
        prints("FAIL: the zero-length write was resubmitted instead of returned\n")
        return 1
    return 0

# io_uring will not easily fail a pipe read with -EPERM, so stand in for
# runtime_wait_for_io: record -1 as the completed operation's result.  The
# source takes it as Some(-1) and clears the flag: the Option, not the value,
# says Ready (AGAST #4558).
[[test]]
fn test_poll_source_eperm_result_is_not_pending() -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    var buf: [4]u8
    var op: PipeOp
    op.rt = @rt
    op.fd = fds[0]
    op.buf = @buf[0]
    op.len = 1
    op.polls = 0

    rt.waker_io_result = -1
    rt.waker_io_ready = 1

    let polled: Option<i32> = pipe_read_source(@op)
    let cleared: i32 = rt.waker_io_ready
    rt.destroy()
    sys_close(fds[0])
    sys_close(fds[1])

    if polled.is_none()
        prints("FAIL: an -EPERM completion should be Ready, not Pending\n")
        return 1
    if polled.unwrap() != -1
        prints("FAIL: an -EPERM completion should be returned as -1, not read as Pending\n")
        return 1
    if op.polls != 1
        prints("FAIL: the recorded result should be taken on the first poll\n")
        return 1
    if cleared != 0
        prints("FAIL: taking the result should clear it\n")
        return 1
    return 0


# ============================================================================
# Test 6: block_on refuses to spin on a future that can never wake
# ============================================================================
#
# The public block_on takes @&Future and fails loudly on this contract
# violation: a Pending poll that registered no waker would stay unfinished for
# ever (see test_block_on_future.ritz).  The failure exits the process, so fork.

fn always_pending(x: i32) -> Option<i32>
    return None

async fn never_ready() -> i32
    let v: i32 = await always_pending(0)
    v

[[test]]
fn test_block_on_pending_without_a_waker_fails_loudly() -> i32
    var err_pipe: [2]i32
    if sys_pipe(@err_pipe[0]) < 0
        prints("FAIL: sys_pipe failed\n")
        return 1

    let pid: i32 = sys_fork()
    if pid == 0
        # Child: block_on must not return; the contract violation exits 101.
        sys_dup2(err_pipe[1], 2)
        sys_close(err_pipe[0])
        sys_close(err_pipe[1])

        match Runtime.new()
            Ok(r) =>
                var rt: Runtime = r
                var p = never_ready()
                rt.block_on(@&p)
                sys_exit(0)   # reached only if the failure was not loud
            Err(_) => sys_exit(2)

    sys_close(err_pipe[1])
    # Drain stderr to EOF before reaping (docs/TESTING.md gotcha 1). A single
    # read returns on the first chunk; closing then would SIGPIPE the child's
    # trailing newline write and it would die signal-killed instead of exiting
    # 101 (AGAST #4487).
    var msg: [256]u8
    var n: i64 = 0
    loop
        let r: i64 = sys_read(err_pipe[0], @msg[0], 256)
        if r <= 0
            break
        if n == 0
            n = r
    sys_close(err_pipe[0])

    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    let code: i32 = (status >> 8) & 255

    if code != 101
        prints("FAIL: expected exit 101 for a Pending poll with no waker\n")
        return 1
    if n <= 0
        prints("FAIL: expected a failure message on stderr\n")
        return 1
    return 0


# ============================================================================
# Test 7: only the registered operation's completion disarms the waker
# ============================================================================

fn submit_nop(rt: *Runtime, user_data: i64)
    let sqe: @&IoUringSqe = match rt.ring.get_sqe()
        Some(p) => p
        None => return
    sqe.prep_nop(user_data)
    rt.ring.sqe_submit()

[[test]]
fn test_waker_ignores_another_operations_completion() -> i32
    var rt: Runtime = match Runtime.new()
        Ok(r) => r
        Err(_) => return no_runtime()

    rt.waker_register(500)

    submit_nop(@rt, 600)
    assert rt.wait_for_io().is_ok()
    let after_stray: i32 = rt.waker_active

    submit_nop(@rt, 500)
    assert rt.wait_for_io().is_ok()
    let after_match: i32 = rt.waker_active
    rt.destroy()

    if after_stray != 1
        prints("FAIL: a stray completion disarmed the waker\n")
        return 1
    if after_match != 0
        prints("FAIL: the matching completion should disarm the waker\n")
        return 1
    return 0


# ============================================================================
# Test 8: Uring vectored I/O prep functions exist
# ============================================================================

[[test]]
fn test_uring_writev() -> i32
    var ring: IoUring = match test_ring()
        Some(r) => r
        None => return 0
    let sqe: @&IoUringSqe = match ring.get_sqe()
        Some(p) => p
        None => return no_sqe(@&ring)

    # Just verify the function compiles and can be called
    var vecs: [1]Iovec
    sqe.prep_writev(1, Span<Iovec> { ptr: @vecs[0], len: 1 }, 0, 123)

    if sqe.opcode != IORING_OP_WRITEV
        prints("FAIL: opcode should be IORING_OP_WRITEV\n")
        ring.destroy()
        return 1

    if sqe.user_data != 123
        prints("FAIL: user_data should be 123\n")
        ring.destroy()
        return 1

    ring.destroy()
    prints("OK: uring_writev\n")
    return 0

# get_sqe found no free entry on a fresh ring: fail the test.
fn no_sqe(ring: @&IoUring) -> i32
    prints("FAIL: get_sqe failed\n")
    ring.destroy()
    1
