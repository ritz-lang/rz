# Test suite for ritzlib/ct.ritz - constant-time comparison (AGAST #1863)
#
# Run with: python3 ritz0/ritz0.py --test ritzlib/tests/test_ct.ritz

import ritzlib.ct

[[test]]
fn test_ct_bytes_eq_equal() -> i32
    assert ct_bytes_eq(c"secret123", 9, c"secret123", 9)
    0

[[test]]
fn test_ct_bytes_eq_differs_last_byte() -> i32
    assert !ct_bytes_eq(c"secret123", 9, c"secret124", 9)
    0

[[test]]
fn test_ct_bytes_eq_differs_first_byte() -> i32
    assert !ct_bytes_eq(c"Secret123", 9, c"secret123", 9)
    0

[[test]]
fn test_ct_bytes_eq_prefix_is_not_equal() -> i32
    # Neither a prefix nor an extension of the secret matches.
    assert !ct_bytes_eq(c"secret", 6, c"secret123", 9)
    assert !ct_bytes_eq(c"secret1234", 10, c"secret123", 9)
    0

[[test]]
fn test_ct_bytes_eq_embedded_nul() -> i32
    # Lengths, not NUL terminators, bound the comparison.
    assert !ct_bytes_eq(c"pw\0junk", 7, c"pw", 2)
    0

[[test]]
fn test_ct_bytes_eq_empty() -> i32
    assert ct_bytes_eq(c"", 0, c"", 0)
    assert !ct_bytes_eq(c"", 0, c"x", 1)
    assert !ct_bytes_eq(c"x", 1, c"", 0)
    0
