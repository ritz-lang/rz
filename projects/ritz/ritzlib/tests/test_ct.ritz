# Test suite for ritzlib/ct.ritz - constant-time comparison (AGAST #1863)
#
# Run with: python3 ritz0/ritz0.py --test ritzlib/tests/test_ct.ritz

import ritzlib.ct
import ritzlib.strview

[[test]]
fn test_ct_eq_equal() -> i32
    assert ct_eq("secret123", "secret123")
    0

[[test]]
fn test_ct_eq_differs_last_byte() -> i32
    assert !ct_eq("secret123", "secret124")
    0

[[test]]
fn test_ct_eq_differs_first_byte() -> i32
    assert !ct_eq("Secret123", "secret123")
    0

[[test]]
fn test_ct_eq_prefix_is_not_equal() -> i32
    # Neither a prefix nor an extension of the secret matches.
    assert !ct_eq("secret", "secret123")
    assert !ct_eq("secret1234", "secret123")
    0

[[test]]
fn test_ct_eq_embedded_nul() -> i32
    # Lengths, not NUL terminators, bound the comparison.
    let given: StrView = "pw\0junk"
    assert given.len == 7
    assert !ct_eq(given, "pw")
    0

[[test]]
fn test_ct_eq_empty() -> i32
    assert ct_eq("", "")
    assert !ct_eq("", "x")
    assert !ct_eq("x", "")
    0
