# Test suite for ritzlib/json.ritz
#
# Tests JSON parsing and emitting functionality on `enum Json` (AGAST #4690):
# a parsed document owns its parts and frees itself at the end of its scope.
# Run with: python3 ritz0/ritz0.py --test ritzlib/tests/test_json.ritz

import ritzlib.cstr
import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.json
import ritzlib.gvec
import ritzlib.result
import ritzlib.option
import ritzlib.strview
import ritzlib.string
import ritzlib.span
import ritzlib.fs

# =============================================================================
# Helpers: the Option API flattened to a bool or sentinel so that tests can
# assert on one value.  Lookups borrow from the document (Option<@Json>), so
# the helpers take the Option itself and never outlive it.
# =============================================================================

const NO_NUMBER: i64 = -999999

# Error kinds as numbers, so a test compares one i32.
const K_NONE: i32 = 0 - 1          # the parse succeeded
const K_UNEXPECTED_CHAR: i32 = 1
const K_UNTERMINATED_STRING: i32 = 2
const K_EXPECTED_COLON: i32 = 3
const K_EXPECTED_BRACKET: i32 = 4
const K_EXPECTED_BRACE: i32 = 5
const K_OUT_OF_MEMORY: i32 = 6
const K_INVALID_ESCAPE: i32 = 7
const K_CONTROL_CHAR: i32 = 8

fn kind_code(k: JsonErrorKind) -> i32
    match k
        UnexpectedChar => K_UNEXPECTED_CHAR
        UnterminatedString => K_UNTERMINATED_STRING
        ExpectedColon => K_EXPECTED_COLON
        ExpectedBracket => K_EXPECTED_BRACKET
        ExpectedBrace => K_EXPECTED_BRACE
        OutOfMemory => K_OUT_OF_MEMORY
        InvalidEscape => K_INVALID_ESCAPE
        ControlChar => K_CONTROL_CHAR

# The error kind of parsing `input`, or K_NONE if it parses.
fn err_code(input: StrView) -> i32
    match json_parse(input)
        Ok(v) => K_NONE
        Err(e) => kind_code(e.kind)

# The error offset of parsing `input`, or -1 if it parses.
fn err_pos(input: StrView) -> i64
    match json_parse(input)
        Ok(v) => 0 - 1
        Err(e) => e.pos

fn parses(input: StrView) -> bool
    match json_parse(input)
        Ok(v) => true
        Err(e) => false

fn is_some(o: Option<@Json>) -> bool
    match o
        Some(v) => true
        None => false

fn num(v: @Json) -> i64
    match v.get_number()
        Some(n) => n
        None => NO_NUMBER

# The number at the Option, or NO_NUMBER for None / a non-number.
fn num_of(o: Option<@Json>) -> i64
    match o
        Some(v) => num(v)
        None => NO_NUMBER

# Step into object member `key` of an Option (None stays None).
fn sub(o: Option<@Json>, key: StrView) -> Option<@Json>
    match o
        Some(v) =>
            let r: @Json = v
            r.get_field(key)
        None => None

# Step into array element `idx` of an Option.
fn nth(o: Option<@Json>, idx: i64) -> Option<@Json>
    match o
        Some(v) =>
            let r: @Json = v
            r.get_index(idx)
        None => None

fn is_bool(v: @Json) -> bool
    match *v
        Bool(b) => true
        _ => false

fn is_number(v: @Json) -> bool
    match *v
        Number(n) => true
        _ => false

fn is_string(v: @Json) -> bool
    match *v
        Str(s) => true
        _ => false

fn is_array(v: @Json) -> bool
    match *v
        Array(xs) => true
        _ => false

fn is_object(v: @Json) -> bool
    match *v
        Object(ms) => true
        _ => false

fn str_is(o: Option<StrView>, want: StrView) -> bool
    match o
        Some(sv) => sv.eq(want)
        None => false

fn str_none(o: Option<StrView>) -> bool
    match o
        Some(sv) => false
        None => true

# 1 for Some(true), 0 for Some(false), -1 for None.
fn bool_state(o: Option<bool>) -> i32
    match o
        Some(b) => if b then 1 else 0
        None => 0 - 1

# Parse `input` (one JSON string) and compare its decoded bytes with `want`.
fn decodes_to(input: StrView, want: Span<u8>) -> bool
    match json_parse(input)
        Ok(root) => str_is(root.get_string(), want.as_strview())
        Err(e) => false

# The compact text of the document parsed from `input`; "" if it does not parse.
fn reemit(input: StrView) -> String
    match json_parse(input)
        Ok(root) => root.to_string()
        Err(e) => string_new()

fn str_of(o: Option<@Json>) -> Option<StrView>
    match o
        Some(v) =>
            let r: @Json = v
            r.get_string()
        None => None

fn bool_of(o: Option<@Json>) -> Option<bool>
    match o
        Some(v) =>
            let r: @Json = v
            r.get_bool()
        None => None

fn null_of(o: Option<@Json>) -> bool
    match o
        Some(v) =>
            let r: @Json = v
            r.is_null()
        None => false

# =============================================================================
# Primitive Parsing Tests
# =============================================================================

[[test]]
fn test_parse_null() -> i32
    let root: Json = match json_parse("null")
        Ok(j) => j
        Err(e) => return 1
    assert root.is_null()
    0

[[test]]
fn test_parse_true() -> i32
    let root: Json = match json_parse("true")
        Ok(j) => j
        Err(e) => return 1
    assert is_bool(@root)
    assert bool_state(root.get_bool()) == 1
    0

[[test]]
fn test_parse_false() -> i32
    let root: Json = match json_parse("false")
        Ok(j) => j
        Err(e) => return 1
    assert is_bool(@root)
    assert bool_state(root.get_bool()) == 0
    0

[[test]]
fn test_parse_number_positive() -> i32
    let root: Json = match json_parse("42")
        Ok(j) => j
        Err(e) => return 1
    assert is_number(@root)
    assert num(@root) == 42
    0

[[test]]
fn test_parse_number_negative() -> i32
    let root: Json = match json_parse("-123")
        Ok(j) => j
        Err(e) => return 1
    assert is_number(@root)
    assert num(@root) == 0 - 123
    0

[[test]]
fn test_parse_number_zero() -> i32
    let root: Json = match json_parse("0")
        Ok(j) => j
        Err(e) => return 1
    assert is_number(@root)
    assert num(@root) == 0
    0

# #4571: the integer part saturates at i64 and fraction digits are
# consumed without being accumulated, so long valid numbers never trap.
[[test]]
fn test_parse_number_long_fraction_truncates() -> i32
    let root: Json = match json_parse("3.14159265358979323846")
        Ok(j) => j
        Err(e) => return 1
    assert num(@root) == 3
    0

[[test]]
fn test_parse_number_long_integer_saturates_max() -> i32
    let root: Json = match json_parse("123456789012345678901234567890")
        Ok(j) => j
        Err(e) => return 1
    assert num(@root) == 9223372036854775807
    0

[[test]]
fn test_parse_number_long_negative_saturates_min() -> i32
    let root: Json = match json_parse("-123456789012345678901234567890")
        Ok(j) => j
        Err(e) => return 1
    assert num(@root) == 0 - 9223372036854775807 - 1
    0

[[test]]
fn test_parse_number_i64_bounds_exact() -> i32
    let hi: Json = match json_parse("9223372036854775807")
        Ok(j) => j
        Err(e) => return 1
    assert num(@hi) == 9223372036854775807
    let lo: Json = match json_parse("-9223372036854775808")
        Ok(j) => j
        Err(e) => return 1
    assert num(@lo) == 0 - 9223372036854775807 - 1
    0

# =============================================================================
# String Parsing Tests
# =============================================================================

[[test]]
fn test_parse_string_simple() -> i32
    let root: Json = match json_parse("\"hello\"")
        Ok(j) => j
        Err(e) => return 1
    assert is_string(@root)
    assert str_is(root.get_string(), "hello")
    0

[[test]]
fn test_parse_string_empty() -> i32
    let root: Json = match json_parse("\"\"")
        Ok(j) => j
        Err(e) => return 1
    assert is_string(@root)
    assert str_is(root.get_string(), "")
    0

[[test]]
fn test_parse_string_escape_quote() -> i32
    # Input: "he\"llo"
    let root: Json = match json_parse("\"he\\\"llo\"")
        Ok(j) => j
        Err(e) => return 1
    # Result should be: he"llo
    assert str_is(root.get_string(), "he\"llo")
    0

[[test]]
fn test_parse_string_escape_newline() -> i32
    # Input: "line1\nline2"
    let root: Json = match json_parse("\"line1\\nline2\"")
        Ok(j) => j
        Err(e) => return 1
    # Result should contain an actual newline character
    assert str_is(root.get_string(), "line1\nline2")
    0

# =============================================================================
# Array Parsing Tests
# =============================================================================

[[test]]
fn test_parse_array_empty() -> i32
    let root: Json = match json_parse("[]")
        Ok(j) => j
        Err(e) => return 1
    assert is_array(@root)
    assert root.array_len() == 0
    0

[[test]]
fn test_parse_array_single() -> i32
    let root: Json = match json_parse("[42]")
        Ok(j) => j
        Err(e) => return 1
    assert is_array(@root)
    assert root.array_len() == 1
    assert num_of(root.get_index(0)) == 42
    0

[[test]]
fn test_parse_array_multiple() -> i32
    let root: Json = match json_parse("[1, 2, 3]")
        Ok(j) => j
        Err(e) => return 1
    assert is_array(@root)
    assert root.array_len() == 3
    assert num_of(root.get_index(0)) == 1
    assert num_of(root.get_index(1)) == 2
    assert num_of(root.get_index(2)) == 3
    0

[[test]]
fn test_parse_array_mixed() -> i32
    let root: Json = match json_parse("[1, \"hello\", true, null]")
        Ok(j) => j
        Err(e) => return 1
    assert is_array(@root)
    assert root.array_len() == 4
    assert num_of(root.get_index(0)) == 1
    assert str_is(str_of(nth(Some(@root), 1)), "hello")
    assert bool_state(bool_of(nth(Some(@root), 2))) == 1
    assert null_of(nth(Some(@root), 3))
    0

[[test]]
fn test_parse_array_nested() -> i32
    let root: Json = match json_parse("[[1, 2], [3, 4]]")
        Ok(j) => j
        Err(e) => return 1
    assert root.array_len() == 2
    assert num_of(nth(nth(Some(@root), 0), 0)) == 1
    assert num_of(nth(nth(Some(@root), 0), 1)) == 2
    assert num_of(nth(nth(Some(@root), 1), 0)) == 3
    assert num_of(nth(nth(Some(@root), 1), 1)) == 4
    0

# =============================================================================
# Object Parsing Tests
# =============================================================================

[[test]]
fn test_parse_object_empty() -> i32
    let root: Json = match json_parse("{}")
        Ok(j) => j
        Err(e) => return 1
    assert is_object(@root)
    assert root.object_len() == 0
    0

[[test]]
fn test_parse_object_single() -> i32
    let root: Json = match json_parse("{\"name\": \"test\"}")
        Ok(j) => j
        Err(e) => return 1
    assert is_object(@root)
    assert root.object_len() == 1
    assert str_is(str_of(sub(Some(@root), "name")), "test")
    0

[[test]]
fn test_parse_object_multiple() -> i32
    let root: Json = match json_parse("{\"a\": 1, \"b\": 2, \"c\": 3}")
        Ok(j) => j
        Err(e) => return 1
    assert root.object_len() == 3
    assert num_of(root.get_field("a")) == 1
    assert num_of(root.get_field("b")) == 2
    assert num_of(root.get_field("c")) == 3
    0

[[test]]
fn test_parse_object_nested() -> i32
    let root: Json = match json_parse("{\"outer\": {\"inner\": 42}}")
        Ok(j) => j
        Err(e) => return 1
    assert is_object(@root)
    assert is_some(root.get_field("outer"))
    assert num_of(sub(root.get_field("outer"), "inner")) == 42
    0

# Three levels of objects and arrays, reached by chained get_field/get_index.
[[test]]
fn test_parse_object_deeply_nested_lookups() -> i32
    let root: Json = match json_parse("{\"a\": {\"b\": {\"c\": {\"d\": 4, \"e\": [10, {\"f\": \"deep\"}]}, \"x\": 3}, \"y\": 2}, \"z\": 1}")
        Ok(j) => j
        Err(e) => return 1
    assert num_of(root.get_field("z")) == 1
    assert num_of(sub(root.get_field("a"), "y")) == 2
    assert num_of(sub(sub(root.get_field("a"), "b"), "x")) == 3
    let c: Option<@Json> = sub(sub(root.get_field("a"), "b"), "c")
    assert num_of(sub(c, "d")) == 4
    assert num_of(nth(sub(c, "e"), 0)) == 10
    assert str_is(str_of(sub(nth(sub(c, "e"), 1), "f")), "deep")
    # A miss anywhere along the chain stays a miss.
    assert not is_some(sub(sub(sub(root.get_field("a"), "b"), "nope"), "d"))
    assert not is_some(sub(sub(root.get_field("a"), "x"), "x"))
    # Each level is an object of the expected size.
    assert root.object_len() == 2
    match sub(root.get_field("a"), "b")
        Some(b) =>
            let r: @Json = b
            assert r.object_len() == 2
        None =>
            assert false
    0

# =============================================================================
# Access Helper Tests
# =============================================================================

[[test]]
fn test_json_get_field_missing() -> i32
    let root: Json = match json_parse("{\"a\": 1}")
        Ok(j) => j
        Err(e) => return 1
    assert not is_some(root.get_field("nonexistent"))
    0

[[test]]
fn test_json_get_index_bounds() -> i32
    let root: Json = match json_parse("[1, 2, 3]")
        Ok(j) => j
        Err(e) => return 1
    # Valid index
    assert is_some(root.get_index(1))
    # Out of bounds
    assert not is_some(root.get_index(10))
    # Negative index
    assert not is_some(root.get_index(0 - 1))
    0

[[test]]
fn test_json_array_len() -> i32
    let root: Json = match json_parse("[1, 2, 3, 4, 5]")
        Ok(j) => j
        Err(e) => return 1
    assert root.array_len() == 5
    assert root.items().len == 5
    0

[[test]]
fn test_json_object_len() -> i32
    let root: Json = match json_parse("{\"a\": 1, \"b\": 2}")
        Ok(j) => j
        Err(e) => return 1
    assert root.object_len() == 2
    0

# A value of another kind has no items and no members.
[[test]]
fn test_json_len_of_other_kinds_is_zero() -> i32
    let n: Json = match json_parse("7")
        Ok(j) => j
        Err(e) => return 1
    assert n.array_len() == 0
    assert n.object_len() == 0
    let arr: Json = match json_parse("[1]")
        Ok(j) => j
        Err(e) => return 1
    assert arr.object_len() == 0
    let obj: Json = match json_parse("{\"a\": 1}")
        Ok(j) => j
        Err(e) => return 1
    assert obj.array_len() == 0
    0

# members() lists the pairs in document order, duplicates included.
[[test]]
fn test_json_members_in_document_order() -> i32
    let root: Json = match json_parse("{\"z\": 1, \"a\": 2, \"z\": 3}")
        Ok(j) => j
        Err(e) => return 1
    let ms: Span<JsonMember> = root.members()
    assert ms.len == 3
    let base: *JsonMember = ms.ptr
    assert (*(base + 0)).key.eq("z")
    assert (*(base + 1)).key.eq("a")
    assert (*(base + 2)).key.eq("z")
    assert num(@(*(base + 2)).value) == 3
    # get_field finds the first of the duplicates.
    assert num_of(root.get_field("z")) == 1
    0

[[test]]
fn test_json_items_in_order() -> i32
    let root: Json = match json_parse("[5, 6, 7]")
        Ok(j) => j
        Err(e) => return 1
    let xs: Span<Json> = root.items()
    assert xs.len == 3
    let base: *Json = xs.ptr
    assert num(@*(base + 0)) == 5
    assert num(@*(base + 2)) == 7
    0

# =============================================================================
# Error Handling Tests.  The kind says what was wrong, pos where.
# =============================================================================

[[test]]
fn test_parse_invalid_empty() -> i32
    assert err_code("") == K_UNEXPECTED_CHAR
    assert err_code("   ") == K_UNEXPECTED_CHAR
    0

[[test]]
fn test_parse_invalid_unclosed_string() -> i32
    assert err_code("\"unclosed") == K_UNTERMINATED_STRING
    assert err_pos("\"unclosed") == 9
    # A trailing backslash does not hide the missing quote.
    assert err_code("\"ab\\") == K_UNTERMINATED_STRING
    assert err_code("\"ab\\\"") == K_UNTERMINATED_STRING
    0

[[test]]
fn test_parse_invalid_unclosed_array() -> i32
    assert err_code("[1, 2") == K_EXPECTED_BRACKET
    # Nothing after the bracket: a value was expected.
    assert err_code("[") == K_UNEXPECTED_CHAR
    assert err_code("[1 2]") == K_EXPECTED_BRACKET
    assert err_pos("[1 2]") == 3
    0

[[test]]
fn test_parse_invalid_unclosed_object() -> i32
    assert err_code("{\"a\": 1") == K_EXPECTED_BRACE
    assert err_code("{") == K_UNEXPECTED_CHAR
    assert err_code("{\"a\": 1 \"b\": 2}") == K_EXPECTED_BRACE
    0

[[test]]
fn test_parse_invalid_missing_colon() -> i32
    assert err_code("{\"a\" 1}") == K_EXPECTED_COLON
    assert err_pos("{\"a\" 1}") == 5
    assert err_code("{\"a\"}") == K_EXPECTED_COLON
    0

[[test]]
fn test_parse_invalid_unexpected_char() -> i32
    assert err_code("x") == K_UNEXPECTED_CHAR
    assert err_code("tru") == K_UNEXPECTED_CHAR
    assert err_code("nul") == K_UNEXPECTED_CHAR
    assert err_code("[1,]") == K_UNEXPECTED_CHAR
    assert err_pos("[1,]") == 3
    assert err_code("[,1]") == K_UNEXPECTED_CHAR
    # An object key must be a string.
    assert err_code("{1: 2}") == K_UNEXPECTED_CHAR
    assert err_code("{\"a\": }") == K_UNEXPECTED_CHAR
    0

# An error deep inside is the inner error, not the outer container's.
[[test]]
fn test_parse_invalid_error_reports_innermost() -> i32
    assert err_code("[1, [2, {\"a\": \"x\"},") == K_UNEXPECTED_CHAR
    assert err_code("{\"a\": [1, 2}") == K_EXPECTED_BRACKET
    assert err_pos("{\"a\": [1, 2}") == 11
    assert err_code("[{\"a\": 1]") == K_EXPECTED_BRACE
    assert err_code("[{\"a\" 1}]") == K_EXPECTED_COLON
    0

# Trailing input after the first value is ignored.
[[test]]
fn test_parse_ignores_trailing_input() -> i32
    let root: Json = match json_parse("[1] garbage")
        Ok(j) => j
        Err(e) => return 1
    assert root.array_len() == 1
    0

