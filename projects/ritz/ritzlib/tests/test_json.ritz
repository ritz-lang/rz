# =============================================================================
# Deprecated wrapper json_parse2(ptr, len): same Result as json_parse
# =============================================================================

[[test]]
fn test_parse2_success() -> i32
    let input = c"{\"key\": 42}"
    var result: Result<*JsonValue, JsonError> = json_parse2(input, strlen(input))
    let success: i32 = match result
        Ok(root) => check_parse2_result(root, 42)
        Err(err) => 1
    success

fn check_parse2_result(root: *JsonValue, expected: i64) -> i32
    if root.kind != JSON_OBJECT
        json_free(root)
        return 1
    let val: *JsonValue = field(root, "key")
    if val == null or val.num_val != expected
        json_free(root)
        return 1
    json_free(root)
    0

[[test]]
fn test_parse2_error() -> i32
    let input = c""
    var result: Result<*JsonValue, JsonError> = json_parse2(input, 0)
    let success: i32 = match result
        Ok(root) => handle_unexpected_ok(root)
        Err(err) => check_err_code(err.code, JSON_ERR_UNEXPECTED_CHAR)
    success

fn handle_unexpected_ok(root: *JsonValue) -> i32
    json_free(root)
    1

fn check_err_code(got: i32, expected: i32) -> i32
    if got == expected
        return 0
    1

[[test]]
fn test_parse2_null() -> i32
    let input = c"null"
    var result: Result<*JsonValue, JsonError> = json_parse2(input, strlen(input))
    let success: i32 = match result
        Ok(root) => check_null_result(root)
        Err(err) => 1
    success

fn check_null_result(root: *JsonValue) -> i32
    if root.kind == JSON_NULL
        json_free(root)
        return 0
    json_free(root)
    1

[[test]]
fn test_parse2_array() -> i32
    let input = c"[1, 2, 3]"
    var result: Result<*JsonValue, JsonError> = json_parse2(input, strlen(input))
    let success: i32 = match result
        Ok(root) => check_array_result(root, 3)
        Err(err) => 1
    success

fn check_array_result(root: *JsonValue, expected_count: i64) -> i32
    if root.kind == JSON_ARRAY and root.count == expected_count
        json_free(root)
        return 0
    json_free(root)
    1

[[test]]
fn test_error_message() -> i32
    let msg: StrView = json_error_message(JSON_ERR_UNEXPECTED_CHAR)
    assert strview_eq(msg, "unexpected character")
    let msg2: StrView = json_error_message(JSON_ERR_UNTERMINATED_STRING)
    assert strview_eq(msg2, "unterminated string")
    assert strview_eq(json_error_message(99), "unknown error")
    0

# =============================================================================
# Option API (AGAST #1482): a missing or wrong-kind value is None, which is
# distinct from a present 0 / false / "".
# =============================================================================

fn is_some(o: Option<*JsonValue>) -> bool
    match o
        Some(v) => true
        None => false

fn str_is(o: Option<StrView>, want: StrView) -> bool
    match o
        Some(sv) => strview_eq(sv, want)
        None => false

fn str_none(o: Option<StrView>) -> bool
    match o
        Some(sv) => false
        None => true

# 1 for Some(true), 0 for Some(false), -1 for None.
fn bool_state(o: Option<bool>) -> i32
    match o
        Some(b) => if b then 1 else 0
        None => 0 - 1

fn err_pos(r: Result<*JsonValue, JsonError>) -> i64
    match r
        Ok(v) => 0 - 1
        Err(e) => e.pos

[[test]]
fn test_parse_respects_strview_len() -> i32
    # Only the first two bytes are in view: "12", not 12345.
    let root: *JsonValue = parse_or_null(strview_from_ptr(c"12345", 2))
    assert root != null
    assert num(root) == 12
    json_free(root)
    0

[[test]]
fn test_parse_error_pos() -> i32
    assert err_pos(json_parse("[1, 2")) == 5
    assert err_pos(json_parse("")) == 0
    0

[[test]]
fn test_get_field_option() -> i32
    let root: *JsonValue = parse_or_null("{\"name\": \"x\", \"zero\": 0}")
    assert root != null
    assert is_some(json_get_field(root, "name"))
    assert not is_some(json_get_field(root, "missing"))
    assert not is_some(json_get_field(root, "nam"))
    assert not is_some(json_get_field(null as *JsonValue, "name"))
    # A present 0 is Some(0), not the old missing-field default.
    assert num(field(root, "zero")) == 0
    assert num(field(root, "missing")) == NO_NUMBER
    json_free(root)
    0

[[test]]
fn test_get_field_strview_key_not_nul_terminated() -> i32
    let root: *JsonValue = parse_or_null("{\"name\": 7}")
    assert root != null
    # "names" sliced to 4 bytes: matches by length, not by a terminator.
    assert num(field(root, strview_slice("names", 0, 4))) == 7
    assert not is_some(json_get_field(root, "names"))
    json_free(root)
    0

[[test]]
fn test_get_field_on_non_object() -> i32
    let root: *JsonValue = parse_or_null("[1]")
    assert root != null
    assert not is_some(json_get_field(root, "0"))
    json_free(root)
    0

[[test]]
fn test_get_index_option() -> i32
    let root: *JsonValue = parse_or_null("[0, 1]")
    assert root != null
    assert is_some(json_get_index(root, 0))
    assert is_some(json_get_index(root, 1))
    assert not is_some(json_get_index(root, 2))
    assert not is_some(json_get_index(root, 0 - 1))
    assert num(at(root, 0)) == 0
    let obj: *JsonValue = parse_or_null("{\"a\": 1}")
    assert not is_some(json_get_index(obj, 0))
    json_free(obj)
    json_free(root)
    0

[[test]]
fn test_get_string_option() -> i32
    let root: *JsonValue = parse_or_null("[\"hello\", \"\", 5]")
    assert root != null
    assert str_is(json_get_string(at(root, 0)), "hello")
    assert str_is(json_get_string(at(root, 1)), "")
    assert str_none(json_get_string(at(root, 2)))
    assert str_none(json_get_string(null as *JsonValue))
    json_free(root)
    0

[[test]]
fn test_get_string_len_counts_escapes_once() -> i32
    let root: *JsonValue = parse_or_null("\"a\\tb\"")
    assert root != null
    # The view spans the decoded bytes: a, TAB, b.
    let want: [3]u8 = [97, 9, 98]
    assert str_is(json_get_string(root), strview_from_ptr(@want[0], 3))
    json_free(root)
    0

[[test]]
fn test_get_number_option() -> i32
    let root: *JsonValue = parse_or_null("[-7, \"7\", null]")
    assert root != null
    assert num(at(root, 0)) == 0 - 7
    assert num(at(root, 1)) == NO_NUMBER
    assert num(at(root, 2)) == NO_NUMBER
    assert num(null as *JsonValue) == NO_NUMBER
    json_free(root)
    0

[[test]]
fn test_get_bool_option() -> i32
    let root: *JsonValue = parse_or_null("[true, false, 0, null]")
    assert root != null
    assert bool_state(json_get_bool(at(root, 0))) == 1
    assert bool_state(json_get_bool(at(root, 1))) == 0
    assert bool_state(json_get_bool(at(root, 2))) == 0 - 1
    assert bool_state(json_get_bool(at(root, 3))) == 0 - 1
    assert bool_state(json_get_bool(null as *JsonValue)) == 0 - 1
    json_free(root)
    0

[[test]]
fn test_to_string_roundtrip_is_owned_string() -> i32
    let root: *JsonValue = parse_or_null("{\"k\": [1, \"a\\\"b\", null, true]}")
    assert root != null
    var out: String = json_to_string(root)
    assert string_eq(@out, "{\"k\": [1, \"a\\\"b\", null, true]}")
    assert string_len(@out) == 30
    # Re-parse the emitted text: a fixed point.
    let again: *JsonValue = parse_or_null(string_as_view(@out))
    assert again != null
    var out2: String = json_to_string(again)
    assert string_eq_string(@out, @out2)
    string_drop(@&out2)
    string_drop(@&out)
    json_free(again)
    json_free(root)
    0

# =============================================================================
# String escapes (AGAST #3914): \b \f \/ and \uXXXX decoded to UTF-8, a
# surrogate pair combined into one 4-byte sequence.  A malformed \u escape is
# JSON_ERR_INVALID_ESCAPE at the offset of its backslash.
# =============================================================================

fn err_code(r: Result<*JsonValue, JsonError>) -> i32
    match r
        Ok(v) => 0 - 1
        Err(e) => e.code

# Parse `input` (one JSON string) and compare its decoded bytes with want[0..n].
fn decodes_to(input: StrView, want: *u8, n: i64) -> bool
    let root: *JsonValue = parse_or_null(input)
    if root == null
        return false
    let ok: bool = str_is(json_get_string(root), strview_from_ptr(want, n))
    json_free(root)
    ok

[[test]]
fn test_escape_backspace() -> i32
    let want: [3]u8 = [97, 8, 98]
    assert decodes_to("\"a\\bb\"", @want[0], 3)
    0

[[test]]
fn test_escape_formfeed() -> i32
    let want: [3]u8 = [97, 12, 98]
    assert decodes_to("\"a\\fb\"", @want[0], 3)
    0

[[test]]
fn test_escape_solidus() -> i32
    let want: [3]u8 = [97, 47, 98]
    assert decodes_to("\"a\\/b\"", @want[0], 3)
    0

[[test]]
fn test_escape_u_one_byte() -> i32
    # U+0041 -> "A"; U+0000-U+007F encode as one byte.
    let want: [3]u8 = [120, 65, 121]
    assert decodes_to("\"x\\u0041y\"", @want[0], 3)
    0

[[test]]
fn test_escape_u_two_bytes() -> i32
    # U+00E9 (e acute) -> C3 A9
    let want: [4]u8 = [120, 0xC3, 0xA9, 121]
    assert decodes_to("\"x\\u00e9y\"", @want[0], 4)
    0

[[test]]
fn test_escape_u_uppercase_hex() -> i32
    let want: [2]u8 = [0xC3, 0xA9]
    assert decodes_to("\"\\u00E9\"", @want[0], 2)
    0

[[test]]
fn test_escape_u_two_byte_boundary() -> i32
    # U+07FF is the last 2-byte code point -> DF BF; U+0800 the first 3-byte.
    let want2: [2]u8 = [0xDF, 0xBF]
    assert decodes_to("\"\\u07ff\"", @want2[0], 2)
    let want3: [3]u8 = [0xE0, 0xA0, 0x80]
    assert decodes_to("\"\\u0800\"", @want3[0], 3)
    0

[[test]]
fn test_escape_u_three_bytes() -> i32
    # U+20AC (euro sign) -> E2 82 AC
    let want: [5]u8 = [120, 0xE2, 0x82, 0xAC, 121]
    assert decodes_to("\"x\\u20acy\"", @want[0], 5)
    0

[[test]]
fn test_escape_u_surrogate_pair_four_bytes() -> i32
    # U+1F600 as the pair D83D DE00 -> F0 9F 98 80 (one sequence, not two
    # 3-byte encodings of the halves).
    let want: [6]u8 = [120, 0xF0, 0x9F, 0x98, 0x80, 121]
    assert decodes_to("\"x\\ud83d\\ude00y\"", @want[0], 6)
    0

[[test]]
fn test_escape_u_mixed_document() -> i32
    # Every escape kind in one string, as an LSP client would send text.
    let want: [12]u8 = [0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 10, 47, 34]
    assert decodes_to("\"\\u00e9\\u20ac\\ud83d\\ude00\\n\\/\\\"\"", @want[0], 12)
    0

[[test]]
fn test_escape_u_lone_high_surrogate() -> i32
    # High surrogate then the closing quote.
    let r: Result<*JsonValue, JsonError> = json_parse("\"ab\\ud83d\"")
    assert err_code(r) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"ab\\ud83d\"")) == 3
    0

[[test]]
fn test_escape_u_high_surrogate_then_plain_text() -> i32
    assert err_code(json_parse("\"\\ud83dxxxxxx\"")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_high_surrogate_then_non_low() -> i32
    # A second \u that is not a low surrogate does not complete the pair.
    assert err_code(json_parse("\"\\ud83d\\u0041\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"\\ud83d\\u0041\"")) == 1
    # Two high surrogates in a row.
    assert err_code(json_parse("\"\\ud83d\\ud83d\"")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_lone_low_surrogate() -> i32
    assert err_code(json_parse("\"a\\ude00b\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"a\\ude00b\"")) == 2
    0

[[test]]
fn test_escape_u_bad_hex_digit() -> i32
    assert err_code(json_parse("\"\\u00g9\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"\\u00g9\"")) == 1
    # Bad hex in the low half of a pair.
    assert err_code(json_parse("\"\\ud83d\\ude0z\"")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_truncated() -> i32
    # Fewer than four hex digits before the closing quote.
    assert err_code(json_parse("\"\\u00e\"")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_error_inside_container() -> i32
    # The code survives the array/object unwinding.
    assert err_code(json_parse("[1, {\"k\": \"\\uzzzz\"}]")) == JSON_ERR_INVALID_ESCAPE
    assert err_code(json_parse("{\"\\ude00\": 1}")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_error_message_invalid_escape() -> i32
    assert strview_eq(json_error_message(JSON_ERR_INVALID_ESCAPE), "invalid escape")
    0

# The whole message table, ends included.  JSON_ERR_INVALID_ESCAPE is the last
# code: the one after it must be "unknown error".  examples/tier5_async/
# 79_ritzlib_json prints codes 0..8 against a golden, so adding a code moves
# that golden too -- update both in the same commit (the gate's corpus run,
# not ritzlib/tests, is what caught it last time).
[[test]]
fn test_error_message_table() -> i32
    assert strview_eq(json_error_message(JSON_ERR_NONE), "unknown error")
    assert strview_eq(json_error_message(JSON_ERR_UNEXPECTED_CHAR), "unexpected character")
    assert strview_eq(json_error_message(JSON_ERR_UNTERMINATED_STRING), "unterminated string")
    assert strview_eq(json_error_message(JSON_ERR_EXPECTED_COLON), "expected ':'")
    assert strview_eq(json_error_message(JSON_ERR_EXPECTED_BRACKET), "expected ']'")
    assert strview_eq(json_error_message(JSON_ERR_EXPECTED_BRACE), "expected '}'")
    assert strview_eq(json_error_message(JSON_ERR_OUT_OF_MEMORY), "out of memory")
    assert strview_eq(json_error_message(JSON_ERR_INVALID_ESCAPE), "invalid escape")
    assert JSON_ERR_INVALID_ESCAPE == 7
    assert strview_eq(json_error_message(JSON_ERR_CONTROL_CHAR), "control character in string")
    assert JSON_ERR_CONTROL_CHAR == 8
    assert strview_eq(json_error_message(JSON_ERR_CONTROL_CHAR + 1), "unknown error")
    assert strview_eq(json_error_message(-1), "unknown error")
    0

# =============================================================================
# Unknown escapes and \u0000 (AGAST #3918).  RFC 8259 allows only
# \" \\ \/ \b \f \n \r \t \uXXXX; any other escape is JSON_ERR_INVALID_ESCAPE
# at its backslash (it used to decode "\q" to "q").  \u0000 is valid JSON and
# is kept in a string value -- str_len and json_get_string carry it -- but
# rejected in an object key, which is a NUL-terminated *u8 with no length:
# {"a\u0000b": 1} would otherwise be found by json_get_field(obj, "a").
# =============================================================================

[[test]]
fn test_escape_unknown_rejected() -> i32
    assert err_code(json_parse("\"\\q\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"\\q\"")) == 1
    assert err_code(json_parse("\"ab\\xcd\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("\"ab\\xcd\"")) == 3
    # Escapes other languages have but JSON does not.
    assert err_code(json_parse("\"\\'\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_code(json_parse("\"\\0\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_code(json_parse("\"\\a\"")) == JSON_ERR_INVALID_ESCAPE
    assert err_code(json_parse("\"\\U0041\"")) == JSON_ERR_INVALID_ESCAPE
    0

[[test]]
fn test_escape_unknown_in_container_and_key() -> i32
    assert err_code(json_parse("[1, {\"k\": \"a\\qb\"}]")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("[1, {\"k\": \"a\\qb\"}]")) == 12
    assert err_code(json_parse("{\"\\q\": 1}")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("{\"\\q\": 1}")) == 2
    0

[[test]]
fn test_escape_all_rfc_escapes_still_accepted() -> i32
    let want: [8]u8 = [34, 92, 47, 8, 12, 10, 13, 9]
    assert decodes_to("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", @want[0], 8)
    0

[[test]]
fn test_escape_u0000_kept_in_value() -> i32
    # The NUL is in the value and counted by str_len: nothing after it is lost.
    let want: [3]u8 = [97, 0, 98]
    assert decodes_to("\"a\\u0000b\"", @want[0], 3)
    let root: *JsonValue = parse_or_null("\"a\\u0000b\"")
    assert root != null
    assert root.str_len == 3
    json_free(root)
    0

[[test]]
fn test_escape_u0000_rejected_in_key() -> i32
    assert err_code(json_parse("{\"a\\u0000b\": 1}")) == JSON_ERR_INVALID_ESCAPE
    assert err_pos(json_parse("{\"a\\u0000b\": 1}")) == 3
    # Nested object key, after a valid member.
    assert err_code(json_parse("{\"x\": {\"\\u0000\": 1}}")) == JSON_ERR_INVALID_ESCAPE
    # Other \u escapes in a key are fine.
    let root: *JsonValue = parse_or_null("{\"\\u0041\": 7}")
    assert root != null
    assert num(field(root, "A")) == 7
    json_free(root)
    0

# =============================================================================
# Raw control characters (AGAST #3941).  RFC 8259 §7: U+0000-U+001F must be
# escaped inside a string.  A raw one is JSON_ERR_CONTROL_CHAR at that byte;
# it used to be copied, and a raw 0x00 in a key truncated the key just as
# \u0000 did before #3918.  Whitespace between tokens (tab, LF, CR) is not
# inside a string and stays legal.
# =============================================================================

[[test]]
fn test_control_char_raw_tab_newline_cr_rejected() -> i32
    assert err_code(json_parse("\"a\tb\"")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("\"a\tb\"")) == 2
    assert err_code(json_parse("\"a\nb\"")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("\"a\nb\"")) == 2
    assert err_code(json_parse("\"\rb\"")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("\"\rb\"")) == 1
    0

[[test]]
fn test_control_char_raw_nul_rejected_in_value() -> i32
    # "a<00>b" as a value: rejected at the NUL (offset 2).
    let src: [5]u8 = [34, 97, 0, 98, 34]
    assert err_code(json_parse(strview_from_ptr(@src[0], 5))) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse(strview_from_ptr(@src[0], 5))) == 2
    0

[[test]]
fn test_control_char_raw_nul_rejected_in_key() -> i32
    # {"a<00>b": 1} -- json_get_field(obj, "a") would have found it.
    let src: [10]u8 = [123, 34, 97, 0, 98, 34, 58, 32, 49, 125]
    assert err_code(json_parse(strview_from_ptr(@src[0], 10))) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse(strview_from_ptr(@src[0], 10))) == 3
    0

[[test]]
fn test_control_char_range_bounds() -> i32
    # 0x01 and 0x1F are the inner edges of the range; 0x20 and 0x7F (DEL,
    # which RFC 8259 does not require escaping) are accepted.
    let lo: [3]u8 = [34, 1, 34]
    assert err_code(json_parse(strview_from_ptr(@lo[0], 3))) == JSON_ERR_CONTROL_CHAR
    let hi: [3]u8 = [34, 31, 34]
    assert err_code(json_parse(strview_from_ptr(@hi[0], 3))) == JSON_ERR_CONTROL_CHAR
    let want_sp: [1]u8 = [32]
    assert decodes_to("\" \"", @want_sp[0], 1)
    let del: [3]u8 = [34, 127, 34]
    let want_del: [1]u8 = [127]
    assert decodes_to(strview_from_ptr(@del[0], 3), @want_del[0], 1)
    # UTF-8 bytes >= 0x80 are not control characters.
    let e: [4]u8 = [34, 0xC3, 0xA9, 34]
    let want_e: [2]u8 = [0xC3, 0xA9]
    assert decodes_to(strview_from_ptr(@e[0], 4), @want_e[0], 2)
    0

[[test]]
fn test_control_char_in_container_and_key() -> i32
    assert err_code(json_parse("[1, {\"k\": \"a\tb\"}]")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("[1, {\"k\": \"a\tb\"}]")) == 12
    assert err_code(json_parse("{\"a\tb\": 1}")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("{\"a\tb\": 1}")) == 3
    0

[[test]]
fn test_control_char_unterminated_reports_first_control() -> i32
    # A raw newline in an unclosed string is reported where it is, not at EOF.
    assert err_code(json_parse("[\"open\n]")) == JSON_ERR_CONTROL_CHAR
    assert err_pos(json_parse("[\"open\n]")) == 6
    0

[[test]]
fn test_control_char_whitespace_between_tokens_ok() -> i32
    let root: *JsonValue = parse_or_null("{\n\t\"a\":\r\n\t[1,\t2]\n}")
    assert root != null
    assert num(at(field(root, "a"), 1)) == 2
    json_free(root)
    0

[[test]]
fn test_control_char_escaped_forms_still_accepted() -> i32
    let want: [3]u8 = [9, 10, 31]
    assert decodes_to("\"\\t\\n\\u001f\"", @want[0], 3)
    0

[[test]]
fn test_emit_u0000_value_round_trips() -> i32
    # The emitter writes the value's str_len bytes, not up to the first NUL.
    let root: *JsonValue = parse_or_null("\"a\\u0000b\"")
    assert root != null
    var output: String = json_to_string(root)
    assert string_eq(@output, "\"a\\u0000b\"")
    let again: *JsonValue = parse_or_null(string_as_view(@output))
    assert again != null
    assert again.str_len == 3
    json_free(again)
    string_drop(@&output)
    json_free(root)
    0

[[test]]
fn test_emit_control_chars_as_u_escapes() -> i32
    # Raw control characters are not valid inside a JSON string: the emitter
    # writes \b \f by name and the rest of U+0000-U+001F as \u00XX.
    let root: *JsonValue = parse_or_null("\"\\u0001\\b\\f\\u001f\"")
    assert root != null
    var output: String = json_to_string(root)
    assert string_eq(@output, "\"\\u0001\\b\\f\\u001f\"")
    string_drop(@&output)
    json_free(root)
    0
