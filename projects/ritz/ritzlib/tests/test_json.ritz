[[test]]
fn test_emit_null() -> i32
    let root: *JsonValue = parse_or_null("null")
    assert root != null

    var output: String = json_to_string(root)
    assert string_eq(@output, "null")

    string_drop(@&output)
    json_free(root)
    0

[[test]]
fn test_emit_bool_true() -> i32
    let root: *JsonValue = parse_or_null("true")
    assert root != null

    var output: String = json_to_string(root)
    assert string_eq(@output, "true")

    string_drop(@&output)
    json_free(root)
    0

[[test]]
fn test_emit_number() -> i32
    let root: *JsonValue = parse_or_null("42")
    assert root != null

    var output: String = json_to_string(root)
    assert string_eq(@output, "42")

    string_drop(@&output)
    json_free(root)
    0

[[test]]
fn test_emit_string() -> i32
    let root: *JsonValue = parse_or_null("\"hello\"")
    assert root != null

    var output: String = json_to_string(root)
