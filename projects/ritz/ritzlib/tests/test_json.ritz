# Test suite for ritzlib/json.ritz
#
# Tests JSON parsing and emitting functionality.
# Run with: python3 ritz0/ritz0.py --test ritzlib/tests/test_json.ritz

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.json
import ritzlib.result
import ritzlib.option
import ritzlib.strview
import ritzlib.string

# =============================================================================
# Helpers: the Option/Result API flattened to a pointer or sentinel so that
# tests can assert on one value.  The "Option API" section at the end tests
# the Options themselves.
# =============================================================================

fn parse_or_null(input: StrView) -> *JsonValue
    match json_parse(input)
        Ok(v) => v
        Err(e) => null as *JsonValue

fn field(obj: *JsonValue, key: StrView) -> *JsonValue
    match json_get_field(obj, key)
        Some(v) => v
        None => null as *JsonValue

fn at(arr: *JsonValue, idx: i64) -> *JsonValue
    match json_get_index(arr, idx)
        Some(v) => v
        None => null as *JsonValue

const NO_NUMBER: i64 = -999999

fn num(v: *JsonValue) -> i64
    match json_get_number(v)
        Some(n) => n
        None => NO_NUMBER

# =============================================================================
# Primitive Parsing Tests
# =============================================================================

[[test]]
fn test_parse_null() -> i32
    let root: *JsonValue = parse_or_null("null")
    assert root != null
    assert root != null
    assert root.kind == JSON_NULL
    json_free(root)
    0

[[test]]
fn test_parse_true() -> i32
    let root: *JsonValue = parse_or_null("true")
    assert root != null
    assert root.kind == JSON_BOOL
    assert root.bool_val == 1
    json_free(root)
    0

[[test]]
fn test_parse_false() -> i32
    let root: *JsonValue = parse_or_null("false")
    assert root != null
    assert root.kind == JSON_BOOL
    assert root.bool_val == 0
    json_free(root)
    0

[[test]]
fn test_parse_number_positive() -> i32
    let root: *JsonValue = parse_or_null("42")
    assert root != null
    assert root.kind == JSON_NUMBER
    assert root.num_val == 42
    json_free(root)
    0

[[test]]
fn test_parse_number_negative() -> i32
    let root: *JsonValue = parse_or_null("-123")
    assert root != null
    assert root.kind == JSON_NUMBER
    assert root.num_val == 0 - 123
    json_free(root)
    0

[[test]]
fn test_parse_number_zero() -> i32
    let root: *JsonValue = parse_or_null("0")
    assert root != null
    assert root.kind == JSON_NUMBER
    assert root.num_val == 0
    json_free(root)
    0

# =============================================================================
# String Parsing Tests
# =============================================================================

[[test]]
fn test_parse_string_simple() -> i32
    let root: *JsonValue = parse_or_null("\"hello\"")
    assert root != null
    assert root.kind == JSON_STRING
    assert streq(root.str_val, c"hello") != 0
    json_free(root)
    0

[[test]]
fn test_parse_string_empty() -> i32
    let root: *JsonValue = parse_or_null("\"\"")
    assert root != null
    assert root.kind == JSON_STRING
    assert root.str_len == 0
    json_free(root)
    0

[[test]]
fn test_parse_string_escape_quote() -> i32
    # Input: "he\"llo"
    var input: [10]u8
    input[0] = 34   # "
    input[1] = 104  # h
    input[2] = 101  # e
    input[3] = 92   # \
    input[4] = 34   # "
    input[5] = 108  # l
    input[6] = 108  # l
    input[7] = 111  # o
    input[8] = 34   # "
    input[9] = 0    # null

    let root: *JsonValue = parse_or_null(strview_from_ptr(@input[0], 9))
    assert root != null
    assert root.kind == JSON_STRING
    # Result should be: he"llo
    assert root.str_len == 6
    json_free(root)
    0

[[test]]
fn test_parse_string_escape_newline() -> i32
    # Input: "line1\nline2"
    var input: [16]u8
    input[0] = 34   # "
    input[1] = 108  # l
    input[2] = 105  # i
    input[3] = 110  # n
    input[4] = 101  # e
    input[5] = 49   # 1
    input[6] = 92   # \
    input[7] = 110  # n
    input[8] = 108  # l
    input[9] = 105  # i
    input[10] = 110 # n
    input[11] = 101 # e
    input[12] = 50  # 2
    input[13] = 34  # "
    input[14] = 0   # null

    let root: *JsonValue = parse_or_null(strview_from_ptr(@input[0], 14))
    assert root != null
    assert root.kind == JSON_STRING
    # Result should contain actual newline character
    assert root.str_len == 11
    json_free(root)
    0

# =============================================================================
# Array Parsing Tests
# =============================================================================

[[test]]
fn test_parse_array_empty() -> i32
    let root: *JsonValue = parse_or_null("[]")
    assert root != null
    assert root.kind == JSON_ARRAY
    assert root.count == 0
    json_free(root)
    0

[[test]]
fn test_parse_array_single() -> i32
    let root: *JsonValue = parse_or_null("[42]")
    assert root != null
    assert root.kind == JSON_ARRAY
    assert root.count == 1
    let item: *JsonValue = at(root, 0)
    assert item.kind == JSON_NUMBER
    assert item.num_val == 42
    json_free(root)
    0

[[test]]
fn test_parse_array_multiple() -> i32
    let root: *JsonValue = parse_or_null("[1, 2, 3]")
    assert root != null
    assert root.kind == JSON_ARRAY
    assert root.count == 3
    assert num(at(root, 0)) == 1
    assert num(at(root, 1)) == 2
    assert num(at(root, 2)) == 3
    json_free(root)
    0

[[test]]
fn test_parse_array_mixed() -> i32
    let root: *JsonValue = parse_or_null("[1, \"hello\", true, null]")
    assert root != null
    assert root.kind == JSON_ARRAY
    assert root.count == 4

    let n: *JsonValue = at(root, 0)
    assert n.kind == JSON_NUMBER
    assert n.num_val == 1

    let s: *JsonValue = at(root, 1)
    assert s.kind == JSON_STRING
    assert streq(s.str_val, c"hello") != 0

    let b: *JsonValue = at(root, 2)
    assert b.kind == JSON_BOOL
    assert b.bool_val == 1

    let nl: *JsonValue = at(root, 3)
    assert nl.kind == JSON_NULL

    json_free(root)
    0

[[test]]
fn test_parse_array_nested() -> i32
    let root: *JsonValue = parse_or_null("[[1, 2], [3, 4]]")
    assert root != null
    assert root.kind == JSON_ARRAY
    assert root.count == 2

    let arr1: *JsonValue = at(root, 0)
    assert arr1.kind == JSON_ARRAY
    assert arr1.count == 2
    assert num(at(arr1, 0)) == 1
    assert num(at(arr1, 1)) == 2

    let arr2: *JsonValue = at(root, 1)
    assert arr2.kind == JSON_ARRAY
    assert arr2.count == 2
    assert num(at(arr2, 0)) == 3
    assert num(at(arr2, 1)) == 4

    json_free(root)
    0

# =============================================================================
# Object Parsing Tests
# =============================================================================

[[test]]
fn test_parse_object_empty() -> i32
    let root: *JsonValue = parse_or_null("{}")
    assert root != null
    assert root.kind == JSON_OBJECT
    assert root.count == 0
    json_free(root)
    0

[[test]]
fn test_parse_object_single() -> i32
    let root: *JsonValue = parse_or_null("{\"name\": \"test\"}")
    assert root != null
    assert root.kind == JSON_OBJECT
    assert root.count == 1

    let name: *JsonValue = field(root, "name")
    assert name != null
    assert name.kind == JSON_STRING
    assert streq(name.str_val, c"test") != 0

    json_free(root)
    0

[[test]]
fn test_parse_object_multiple() -> i32
    let root: *JsonValue = parse_or_null("{\"a\": 1, \"b\": 2, \"c\": 3}")
    assert root != null
    assert root.kind == JSON_OBJECT
    assert root.count == 3

    assert num(field(root, "a")) == 1
    assert num(field(root, "b")) == 2
    assert num(field(root, "c")) == 3

    json_free(root)
    0

[[test]]
fn test_parse_object_nested() -> i32
    let root: *JsonValue = parse_or_null("{\"outer\": {\"inner\": 42}}")
    assert root != null
    assert root.kind == JSON_OBJECT

    let outer: *JsonValue = field(root, "outer")
    assert outer != null
    assert outer.kind == JSON_OBJECT

    let inner: *JsonValue = field(outer, "inner")
    assert inner != null
    assert inner.kind == JSON_NUMBER
    assert inner.num_val == 42

    json_free(root)
    0

