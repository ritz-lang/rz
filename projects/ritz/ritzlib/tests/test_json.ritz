[[test]]
fn test_parse_whitespace_around_value() -> i32
    let root: Json = match json_parse("   42   ")
        Ok(j) => j
        Err(e) => return 1
    assert num(@root) == 42
    0

[[test]]
fn test_parse_whitespace_in_array() -> i32
    let root: Json = match json_parse("[ 1 , 2 , 3 ]")
        Ok(j) => j
        Err(e) => return 1
    assert root.array_len() == 3
    0

[[test]]
fn test_parse_whitespace_in_object() -> i32
    let root: Json = match json_parse("{ \"a\" : 1 , \"b\" : 2 }")
        Ok(j) => j
        Err(e) => return 1
    assert root.object_len() == 2
    assert num_of(root.get_field("b")) == 2
    0

# =============================================================================
# JSON Emitter Tests
# =============================================================================

# emit appends to the caller's buffer and can't fail, so it returns nothing
# (AGAST #4648): two emits into one buffer are the two texts back to back.
[[test]]
fn test_emit_appends_to_buffer() -> i32
    let root: Json = match json_parse("[1, true]")
        Ok(j) => j
        Err(e) => return 1

    var buf: Vec<u8> = vec_with_cap<u8>(16)
    root.emit(@&buf)
    json_emit_string("k", @&buf)
    root.emit(@&buf)
    let want: StrView = "[1, true]\"k\"[1, true]"
    assert buf.len == want.len
    for i in 0..want.len
        assert buf.get(i) == *(want.ptr + i)
    0

[[test]]
fn test_emit_null() -> i32
    assert reemit("null").eq("null")
    0

[[test]]
fn test_emit_bool() -> i32
    assert reemit("true").eq("true")
    assert reemit("false").eq("false")
    0

[[test]]
fn test_emit_number() -> i32
    assert reemit("42").eq("42")
    assert reemit("-7").eq("-7")
    assert reemit("0").eq("0")
    assert reemit("9223372036854775807").eq("9223372036854775807")
    assert reemit("-9223372036854775808").eq("-9223372036854775808")
    # Fractions were dropped at parse time.
    assert reemit("3.99").eq("3")
    0

[[test]]
fn test_emit_string() -> i32
    assert reemit("\"hello\"").eq("\"hello\"")
    assert reemit("\"\"").eq("\"\"")
    0

[[test]]
fn test_emit_array() -> i32
    assert reemit("[1, 2, 3]").eq("[1, 2, 3]")
    assert reemit("[]").eq("[]")
    assert reemit("[ 1,2 ,3 ]").eq("[1, 2, 3]")
    0

[[test]]
fn test_emit_object() -> i32
    assert reemit("{\"a\": 1}").eq("{\"a\": 1}")
    assert reemit("{}").eq("{}")
    # Members keep document order.
    assert reemit("{\"b\":2,\"a\":1}").eq("{\"b\": 2, \"a\": 1}")
    0

# =============================================================================
# Errors as values: the message for each kind, and Display.
# =============================================================================

fn message_of(kind: JsonErrorKind) -> StrView
    let e: JsonError = JsonError { kind: kind, pos: 0 }
    e.message()

[[test]]
fn test_error_message_table() -> i32
    assert message_of(JsonErrorKind.UnexpectedChar).eq("unexpected character")
    assert message_of(JsonErrorKind.UnterminatedString).eq("unterminated string")
    assert message_of(JsonErrorKind.ExpectedColon).eq("expected ':'")
    assert message_of(JsonErrorKind.ExpectedBracket).eq("expected ']'")
    assert message_of(JsonErrorKind.ExpectedBrace).eq("expected '}'")
    assert message_of(JsonErrorKind.OutOfMemory).eq("out of memory")
    assert message_of(JsonErrorKind.InvalidEscape).eq("invalid escape")
    assert message_of(JsonErrorKind.ControlChar).eq("control character in string")
    0

# The message of an error a parse really returned.
[[test]]
fn test_error_message_from_parse() -> i32
    match json_parse("{\"a\" 1}")
        Ok(v) =>
            assert false
        Err(e) =>
            assert e.message().eq("expected ':'")
            assert e.pos == 5
    0

# =============================================================================
# Option API (AGAST #1482): a missing or wrong-kind value is None, which is
# distinct from a present 0 / false / "".
# =============================================================================

[[test]]
fn test_parse_respects_strview_len() -> i32
    # Only the first two bytes are in view: "12", not 12345.
    let whole: StrView = "12345"
    let root: Json = match json_parse(whole.slice(0, 2))
        Ok(j) => j
        Err(e) => return 1
    assert num(@root) == 12
    0

[[test]]
fn test_parse_error_pos() -> i32
    assert err_pos("[1, 2") == 5
    assert err_pos("") == 0
    0

[[test]]
fn test_get_field_option() -> i32
    let root: Json = match json_parse("{\"name\": \"x\", \"zero\": 0}")
        Ok(j) => j
        Err(e) => return 1
    assert is_some(root.get_field("name"))
    assert not is_some(root.get_field("missing"))
    assert not is_some(root.get_field("nam"))
    # A present 0 is Some(0), not a missing-field default.
    assert num_of(root.get_field("zero")) == 0
    assert num_of(root.get_field("missing")) == NO_NUMBER
    0

[[test]]
fn test_get_field_strview_key_not_nul_terminated() -> i32
    let root: Json = match json_parse("{\"name\": 7}")
        Ok(j) => j
        Err(e) => return 1
    # "names" sliced to 4 bytes: matches by length, not by a terminator.
    let names: StrView = "names"
    assert num_of(root.get_field(names.slice(0, 4))) == 7
    assert not is_some(root.get_field("names"))
    0

[[test]]
fn test_get_field_on_non_object() -> i32
    let root: Json = match json_parse("[1]")
        Ok(j) => j
        Err(e) => return 1
    assert not is_some(root.get_field("0"))
    0

[[test]]
fn test_get_index_option() -> i32
    let root: Json = match json_parse("[0, 1]")
        Ok(j) => j
        Err(e) => return 1
    assert is_some(root.get_index(0))
    assert is_some(root.get_index(1))
    assert not is_some(root.get_index(2))
    assert not is_some(root.get_index(0 - 1))
    assert num_of(root.get_index(0)) == 0
    let obj: Json = match json_parse("{\"a\": 1}")
        Ok(j) => j
        Err(e) => return 1
    assert not is_some(obj.get_index(0))
    0

[[test]]
fn test_get_string_option() -> i32
    let root: Json = match json_parse("[\"hello\", \"\", 5]")
        Ok(j) => j
        Err(e) => return 1
    assert str_is(str_of(nth(Some(@root), 0)), "hello")
    assert str_is(str_of(nth(Some(@root), 1)), "")
    assert str_none(str_of(nth(Some(@root), 2)))
    0

[[test]]
fn test_get_string_len_counts_escapes_once() -> i32
    let root: Json = match json_parse("\"a\\tb\"")
        Ok(j) => j
        Err(e) => return 1
    # The view spans the decoded bytes: a, TAB, b.
    assert str_is(root.get_string(), "a\tb")
    0

[[test]]
fn test_get_number_option() -> i32
    let root: Json = match json_parse("[-7, \"7\", null]")
        Ok(j) => j
        Err(e) => return 1
    assert num_of(root.get_index(0)) == 0 - 7
    assert num_of(root.get_index(1)) == NO_NUMBER
    assert num_of(root.get_index(2)) == NO_NUMBER
    0

[[test]]
fn test_get_bool_option() -> i32
    let root: Json = match json_parse("[true, false, 0, null]")
        Ok(j) => j
        Err(e) => return 1
    assert bool_state(bool_of(nth(Some(@root), 0))) == 1
    assert bool_state(bool_of(nth(Some(@root), 1))) == 0
    assert bool_state(bool_of(nth(Some(@root), 2))) == 0 - 1
    assert bool_state(bool_of(nth(Some(@root), 3))) == 0 - 1
    0

[[test]]
fn test_to_string_roundtrip_is_owned_string() -> i32
    let root: Json = match json_parse("{\"k\": [1, \"a\\\"b\", null, true]}")
        Ok(j) => j
        Err(e) => return 1
    var out: String = root.to_string()
    assert out.eq("{\"k\": [1, \"a\\\"b\", null, true]}")
    assert out.len() == 30
    # Re-parse the emitted text: a fixed point.
    let again: Json = match json_parse(out.as_view())
        Ok(j) => j
        Err(e) => return 1
    var out2: String = again.to_string()
    assert out.eq_string(@out2)
    0

# =============================================================================
# String escapes (AGAST #3914): \b \f \/ and \uXXXX decoded to UTF-8, a
# surrogate pair combined into one 4-byte sequence.  A malformed \u escape is
# InvalidEscape at the offset of its backslash.
# =============================================================================

[[test]]
fn test_escape_backspace() -> i32
    let want: [3]u8 = [97, 8, 98]
    assert decodes_to("\"a\\bb\"", @want)
    0

[[test]]
fn test_escape_formfeed() -> i32
    let want: [3]u8 = [97, 12, 98]
    assert decodes_to("\"a\\fb\"", @want)
    0

[[test]]
fn test_escape_solidus() -> i32
    let want: [3]u8 = [97, 47, 98]
    assert decodes_to("\"a\\/b\"", @want)
    0

[[test]]
fn test_escape_u_one_byte() -> i32
    # U+0041 -> "A"; U+0000-U+007F encode as one byte.
    let want: [3]u8 = [120, 65, 121]
    assert decodes_to("\"x\\u0041y\"", @want)
    0

[[test]]
fn test_escape_u_two_bytes() -> i32
    # U+00E9 (e acute) -> C3 A9
    let want: [4]u8 = [120, 0xC3, 0xA9, 121]
    assert decodes_to("\"x\\u00e9y\"", @want)
    0

[[test]]
fn test_escape_u_uppercase_hex() -> i32
    let want: [2]u8 = [0xC3, 0xA9]
    assert decodes_to("\"\\u00E9\"", @want)
    0

[[test]]
fn test_escape_u_two_byte_boundary() -> i32
    # U+07FF is the last 2-byte code point -> DF BF; U+0800 the first 3-byte.
    let want2: [2]u8 = [0xDF, 0xBF]
    assert decodes_to("\"\\u07ff\"", @want2)
    let want3: [3]u8 = [0xE0, 0xA0, 0x80]
    assert decodes_to("\"\\u0800\"", @want3)
    0

[[test]]
fn test_escape_u_three_bytes() -> i32
    # U+20AC (euro sign) -> E2 82 AC
    let want: [5]u8 = [120, 0xE2, 0x82, 0xAC, 121]
    assert decodes_to("\"x\\u20acy\"", @want)
    0

[[test]]
fn test_escape_u_surrogate_pair_four_bytes() -> i32
    # U+1F600 as the pair D83D DE00 -> F0 9F 98 80 (one sequence, not two
    # 3-byte encodings of the halves).
    let want: [6]u8 = [120, 0xF0, 0x9F, 0x98, 0x80, 121]
    assert decodes_to("\"x\\ud83d\\ude00y\"", @want)
    0

[[test]]
fn test_escape_u_mixed_document() -> i32
    # Every escape kind in one string, as an LSP client would send text.
    let want: [12]u8 = [0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 10, 47, 34]
    assert decodes_to("\"\\u00e9\\u20ac\\ud83d\\ude00\\n\\/\\\"\"", @want)
    0

[[test]]
fn test_escape_u_lone_high_surrogate() -> i32
    # High surrogate then the closing quote.
    assert err_code("\"ab\\ud83d\"") == K_INVALID_ESCAPE
    assert err_pos("\"ab\\ud83d\"") == 3
    0

[[test]]
fn test_escape_u_high_surrogate_then_plain_text() -> i32
    assert err_code("\"\\ud83dxxxxxx\"") == K_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_high_surrogate_then_non_low() -> i32
    # A second \u that is not a low surrogate does not complete the pair.
    assert err_code("\"\\ud83d\\u0041\"") == K_INVALID_ESCAPE
    assert err_pos("\"\\ud83d\\u0041\"") == 1
    # Two high surrogates in a row.
    assert err_code("\"\\ud83d\\ud83d\"") == K_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_lone_low_surrogate() -> i32
    assert err_code("\"a\\ude00b\"") == K_INVALID_ESCAPE
    assert err_pos("\"a\\ude00b\"") == 2
    0

[[test]]
fn test_escape_u_bad_hex_digit() -> i32
    assert err_code("\"\\u00g9\"") == K_INVALID_ESCAPE
    assert err_pos("\"\\u00g9\"") == 1
    # Bad hex in the low half of a pair.
    assert err_code("\"\\ud83d\\ude0z\"") == K_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_truncated() -> i32
    # Fewer than four hex digits before the closing quote.
    assert err_code("\"\\u00e\"") == K_INVALID_ESCAPE
    0

[[test]]
fn test_escape_u_error_inside_container() -> i32
    # The kind survives the array/object unwinding.
    assert err_code("[1, {\"k\": \"\\uzzzz\"}]") == K_INVALID_ESCAPE
    assert err_code("{\"\\ude00\": 1}") == K_INVALID_ESCAPE
    0

# =============================================================================
# Unknown escapes and \u0000 (AGAST #3918).  RFC 8259 allows only
# \" \\ \/ \b \f \n \r \t \uXXXX; any other escape is InvalidEscape at its
# backslash.  \u0000 is valid JSON and is kept in a string value and in an
# object key: both are length-checked Strings, so {"a\u0000b": 1} is not found
# by get_field("a").
# =============================================================================

[[test]]
fn test_escape_unknown_rejected() -> i32
    assert err_code("\"\\q\"") == K_INVALID_ESCAPE
    assert err_pos("\"\\q\"") == 1
    assert err_code("\"ab\\xcd\"") == K_INVALID_ESCAPE
    assert err_pos("\"ab\\xcd\"") == 3
    # Escapes other languages have but JSON does not.
    assert err_code("\"\\'\"") == K_INVALID_ESCAPE
    assert err_code("\"\\0\"") == K_INVALID_ESCAPE
    assert err_code("\"\\a\"") == K_INVALID_ESCAPE
    assert err_code("\"\\U0041\"") == K_INVALID_ESCAPE
    0

[[test]]
fn test_escape_unknown_in_container_and_key() -> i32
    assert err_code("[1, {\"k\": \"a\\qb\"}]") == K_INVALID_ESCAPE
    assert err_pos("[1, {\"k\": \"a\\qb\"}]") == 12
    assert err_code("{\"\\q\": 1}") == K_INVALID_ESCAPE
    assert err_pos("{\"\\q\": 1}") == 2
    0

[[test]]
fn test_escape_all_rfc_escapes_still_accepted() -> i32
    let want: [8]u8 = [34, 92, 47, 8, 12, 10, 13, 9]
    assert decodes_to("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", @want)
    0

[[test]]
fn test_escape_u0000_kept_in_value() -> i32
    # The NUL is in the value and counted: nothing after it is lost.
    let want: [3]u8 = [97, 0, 98]
    assert decodes_to("\"a\\u0000b\"", @want)
    let root: Json = match json_parse("\"a\\u0000b\"")
        Ok(j) => j
        Err(e) => return 1
    match root.get_string()
        Some(sv) =>
            assert sv.len == 3
        None =>
            assert false
    0

# \u0000 in an object key is accepted: the key is a String with a length.
[[test]]
fn test_escape_u0000_accepted_in_key() -> i32
    assert parses("{\"a\\u0000b\": 1}")
    assert parses("{\"x\": {\"\\u0000\": 1}}")
    # Other \u escapes in a key are fine too.
    let root: Json = match json_parse("{\"\\u0041\": 7}")
        Ok(j) => j
        Err(e) => return 1
    assert num_of(root.get_field("A")) == 7
    0

# {"a\u0000b": 1, "a": 2}: the 3-byte key and the 1-byte key are distinct.
[[test]]
fn test_key_with_embedded_nul_is_distinct() -> i32
    let root: Json = match json_parse("{\"a\\u0000b\": 1, \"a\": 2}")
        Ok(j) => j
        Err(e) => return 1
    assert root.members().len == 2
    assert num_of(root.get_field("a")) == 2
    var key: String = string_new()
    assert key.push(97)
    assert key.push(0)
    assert key.push(98)
    assert key.len() == 3
    assert num_of(root.get_field(key.as_view())) == 1
    # Neither prefix of the 3-byte key matches it.
    let whole_key: StrView = key.as_view()
    let prefix: StrView = whole_key.slice(0, 2)
    assert not is_some(root.get_field(prefix))
    assert not is_some(root.get_field("b"))
    # The members themselves hold the 3-byte key.
    let base: *JsonMember = root.members().ptr
    assert (*base).key.len() == 3
    assert (*(base + 1)).key.len() == 1
    # And it is written back as \u0000, then parses to the same thing.
    var text: String = root.to_string()
    assert text.eq("{\"a\\u0000b\": 1, \"a\": 2}")
    let again: Json = match json_parse(text.as_view())
        Ok(j) => j
        Err(e) => return 1
    assert num_of(again.get_field(key.as_view())) == 1
    assert num_of(again.get_field("a")) == 2
    0

# =============================================================================
# Raw control characters (AGAST #3941).  RFC 8259 §7: U+0000-U+001F must be
# escaped inside a string.  A raw one is ControlChar at that byte.  Whitespace
# between tokens (tab, LF, CR) is not inside a string and stays legal.
# =============================================================================

[[test]]
fn test_control_char_raw_tab_newline_cr_rejected() -> i32
    assert err_code("\"a\tb\"") == K_CONTROL_CHAR
    assert err_pos("\"a\tb\"") == 2
    assert err_code("\"a\nb\"") == K_CONTROL_CHAR
    assert err_pos("\"a\nb\"") == 2
    assert err_code("\"\rb\"") == K_CONTROL_CHAR
    assert err_pos("\"\rb\"") == 1
    0

[[test]]
fn test_control_char_raw_nul_rejected_in_value() -> i32
    # "a<00>b" as a value: rejected at the NUL (offset 2).
    assert err_code("\"a\0b\"") == K_CONTROL_CHAR
    assert err_pos("\"a\0b\"") == 2
    0

[[test]]
fn test_control_char_raw_nul_rejected_in_key() -> i32
    # {"a<00>b": 1}: a raw NUL is rejected in a key as in a value.
    assert err_code("{\"a\0b\": 1}") == K_CONTROL_CHAR
    assert err_pos("{\"a\0b\": 1}") == 3
    0

[[test]]
fn test_control_char_range_bounds() -> i32
    # 0x01 and 0x1F are the inner edges of the range; 0x20 and 0x7F (DEL,
    # which RFC 8259 does not require escaping) are accepted.
    assert err_code("\"\x01\"") == K_CONTROL_CHAR
    assert err_code("\"\x1f\"") == K_CONTROL_CHAR
    let want_sp: [1]u8 = [32]
    assert decodes_to("\" \"", @want_sp)
    let want_del: [1]u8 = [127]
    assert decodes_to("\"\x7f\"", @want_del)
    # UTF-8 bytes >= 0x80 are not control characters.
    let want_e: [2]u8 = [0xC3, 0xA9]
    assert decodes_to("\"é\"", @want_e)
    0

[[test]]
fn test_control_char_in_container_and_key() -> i32
    assert err_code("[1, {\"k\": \"a\tb\"}]") == K_CONTROL_CHAR
    assert err_pos("[1, {\"k\": \"a\tb\"}]") == 12
    assert err_code("{\"a\tb\": 1}") == K_CONTROL_CHAR
    assert err_pos("{\"a\tb\": 1}") == 3
    0

[[test]]
fn test_control_char_unterminated_reports_first_control() -> i32
    # A raw newline in an unclosed string is reported where it is, not at EOF.
    assert err_code("[\"open\n]") == K_CONTROL_CHAR
    assert err_pos("[\"open\n]") == 6
    0

[[test]]
fn test_control_char_whitespace_between_tokens_ok() -> i32
    let root: Json = match json_parse("{\n\t\"a\":\r\n\t[1,\t2]\n}")
        Ok(j) => j
        Err(e) => return 1
    assert num_of(nth(root.get_field("a"), 1)) == 2
    0

[[test]]
fn test_control_char_escaped_forms_still_accepted() -> i32
    let want: [3]u8 = [9, 10, 31]
    assert decodes_to("\"\\t\\n\\u001f\"", @want)
    0

[[test]]
fn test_emit_u0000_value_round_trips() -> i32
    # The emitter writes every byte of the value, not up to the first NUL.
    let root: Json = match json_parse("\"a\\u0000b\"")
        Ok(j) => j
        Err(e) => return 1
    var output: String = root.to_string()
    assert output.eq("\"a\\u0000b\"")
    let again: Json = match json_parse(output.as_view())
        Ok(j) => j
        Err(e) => return 1
    match again.get_string()
        Some(sv) =>
            assert sv.len == 3
        None =>
            assert false
    0

[[test]]
fn test_emit_control_chars_as_u_escapes() -> i32
    # Raw control characters are not valid inside a JSON string: the emitter
    # writes \b \f by name and the rest of U+0000-U+001F as \u00XX.
    assert reemit("\"\\u0001\\b\\f\\u001f\"").eq("\"\\u0001\\b\\f\\u001f\"")
    0

# =============================================================================
# RFC 8259 round trip: parse -> to_string -> parse -> to_string is a fixed
# point over a document with every value kind, nesting and every escape.
# =============================================================================

fn rfc_doc() -> StrView
    "{\"nul\": null, \"t\": true, \"f\": false, \"n\": -42, \"big\": 9223372036854775807, \"s\": \"q\\\" b\\\\ s\\/ \\b\\f\\n\\r\\t \\u00e9 \\u20ac \\ud83d\\ude00 \\u0001 \\u0000\", \"empty\": [], \"eo\": {}, \"arr\": [1, [2, [3, {\"k\": []}]], \"x\"], \"obj\": {\"a\": {\"b\": {\"c\": [null, false]}}}, \"k\\\"ey\\n\": 0}"

[[test]]
fn test_rfc8259_round_trip() -> i32
    let first: Json = match json_parse(rfc_doc())
        Ok(j) => j
        Err(e) => return 1
    var text1: String = first.to_string()
    let second: Json = match json_parse(text1.as_view())
        Ok(j) => j
        Err(e) => return 1
    var text2: String = second.to_string()
    assert text1.eq_string(@text2)
    # A third generation, from the second text, for good measure.
    assert reemit(text2.as_view()).eq_string(@text1)
    # What survived: kinds, values and the decoded string bytes.
    assert second.object_len() == 11
    assert null_of(second.get_field("nul"))
    assert bool_state(bool_of(second.get_field("f"))) == 0
    assert num_of(second.get_field("n")) == 0 - 42
    assert num_of(second.get_field("big")) == 9223372036854775807
    match str_of(second.get_field("s"))
        Some(sv) =>
            assert sv.len == 30
        None =>
            assert false
    assert num_of(nth(nth(nth(second.get_field("arr"), 1), 1), 0)) == 3
    assert null_of(nth(sub(sub(sub(second.get_field("obj"), "a"), "b"), "c"), 0))
    assert num_of(second.get_field(("k\"ey\n"))) == 0
    0

# =============================================================================
# Ownership: a Json frees what it owns, on success and on a failed parse.
# The resident set (pages, from /proc/self/statm) must not grow by the size of
# the documents parsed: each loop would leak tens of MB if the drain broke.
# =============================================================================

# Resident pages of this process, or -1 if /proc/self/statm is unreadable.
# statm is "size resident shared ...": the second number.
fn rss_pages() -> i64
    match read_file("/proc/self/statm")
        Ok(s) =>
            let v: StrView = s.as_view()
            var i: i64 = 0
            while i < v.len and v.get(i) != ' '
                i += 1
            i += 1
            var n: i64 = 0
            while i < v.len and v.get(i) >= '0' and v.get(i) <= '9'
                n = n * 10 + (v.get(i) - '0') as i64
                i += 1
            n
        Err(e) =>
            0 - 1

# 4 MiB, in 4 KiB pages.
const RSS_SLACK_PAGES: i64 = 1024
const LEAK_ROUNDS: i64 = 20000

fn nested_doc() -> StrView
    "{\"users\": [{\"name\": \"alice\", \"tags\": [\"a\", \"b\", \"c\"], \"meta\": {\"id\": 1, \"ok\": true, \"x\": null}}, {\"name\": \"bob\", \"tags\": [], \"meta\": {\"id\": 2, \"ok\": false, \"x\": [1, 2, [3, [4, [5]]]]}}], \"title\": \"a fairly long string value so each round allocates a few hundred bytes more\", \"n\": 12345}"

# Parse (and drop) the document once; also emit it, so to_string's buffers are
# part of the loop.  The Json drops when it leaves the match arm.
fn parse_and_drop(input: StrView) -> i64
    match json_parse(input)
        Ok(root) =>
            let s: String = root.to_string()
            s.len()
        Err(e) =>
            0 - 1

[[test]]
fn test_drop_does_not_leak() -> i32
    # Warm up: the allocator's first pages and the String/Vec growth paths.
    for w in 0..200
        assert parse_and_drop(nested_doc()) > 0
    let before: i64 = rss_pages()
    assert before > 0
    for r in 0..LEAK_ROUNDS
        assert parse_and_drop(nested_doc()) > 0
    let after: i64 = rss_pages()
    assert after - before < RSS_SLACK_PAGES
    0

# A parse that fails midway frees the half-built containers.
fn parse_fails(input: StrView) -> bool
    match json_parse(input)
        Ok(root) => false
        Err(e) => true

[[test]]
fn test_failed_parse_does_not_leak() -> i32
    for w in 0..200
        assert parse_fails("[1,[2,{\"a\":\"x\"},")
    let before: i64 = rss_pages()
    assert before > 0
    for r in 0..LEAK_ROUNDS
        # Failure after finished children at several depths and kinds.
        assert parse_fails("[1,[2,{\"a\":\"x\"},")
        assert parse_fails("{\"k\": [\"aaaaaaaaaaaaaaaaaaaaaaaaaaaa\", {\"j\": [1, 2, 3]}], \"z\": {\"y\": [true, null, \"s\"]}, \"w\" 1}")
        assert parse_fails("[\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", [[[\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"]]], \"c\\q\"]")
        assert parse_fails("{\"a\": {\"b\": [{\"c\": \"dddddddddddddddddddddddddddd\"}, {\"e\": 1}")
    let after: i64 = rss_pages()
    assert after - before < RSS_SLACK_PAGES
    0
