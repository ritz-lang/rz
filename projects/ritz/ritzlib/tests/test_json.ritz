[[test]]
fn test_json_get_field_missing() -> i32
    let root: *JsonValue = parse_or_null("{\"a\": 1}")
    assert root != null

    let missing: *JsonValue = field(root, "nonexistent")
    assert missing == null

    json_free(root)
    0

[[test]]
fn test_json_get_index_bounds() -> i32
    let root: *JsonValue = parse_or_null("[1, 2, 3]")
    assert root != null

    # Valid index
    let valid: *JsonValue = at(root, 1)
    assert valid != null

    # Out of bounds
    let oob: *JsonValue = at(root, 10)
    assert oob == null

    # Negative index
    let neg: *JsonValue = at(root, 0 - 1)
    assert neg == null

    json_free(root)
    0

