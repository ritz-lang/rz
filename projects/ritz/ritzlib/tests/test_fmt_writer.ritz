# ritzlib.fmt.writer: the Writer and its six sinks (AGAST #201).
#
# Runs under ritz0 (the package step) and ritz1 / ritz1_selfhosted
# (make ritzlib-tests-ritz1).

import ritzlib.fmt
import ritzlib.string
import ritzlib.span
import ritzlib.strview
import ritzlib.sys

fn view_is(w: @Writer, want: StrView) -> bool
    strview_eq(w.view(), want)

[[test]]
fn test_span_writer_fills_from_the_start() -> i32
    var buf: [16]u8
    var w: Writer = span_writer(span_from_ptr<u8>(@buf[0], 16))
    assert w.write_str("abc") == 3
    assert w.write_byte(100) == 1
    assert w.len() == 4
    assert view_is(@w, "abcd")
    0

[[test]]
fn test_span_writer_refuses_overflow_whole() -> i32
    var buf: [4]u8
    var w: Writer = span_writer(span_from_ptr<u8>(@buf[0], 4))
    assert w.write_str("ab") == 2
    # Three more bytes don't fit: -1, and nothing of them is written.
    assert w.write_str("cde") == -1
    assert view_is(@w, "ab")
    assert w.write_str("cd") == 2
    assert view_is(@w, "abcd")
    assert w.write_byte(101) == -1
    0

[[test]]
fn test_string_writer_appends() -> i32
    var s: String = string_from("x=")
    var w: Writer = string_writer(@&s)
    assert w.write_str("12") == 2
    assert w.write_fill(46, 40) == 40   # longer than one fill chunk
    assert string_len(@s) == 44
    assert w.len() == 42
    assert strview_starts_with(string_as_view(@s), "x=12....")
    0

[[test]]
fn test_null_writer_counts() -> i32
    var w: Writer = null_writer()
    assert w.write_str("hello") == 5
    assert w.write_str(", world") == 7
    assert w.len() == 12
    0

[[test]]
fn test_empty_write_is_zero() -> i32
    var w: Writer = null_writer()
    assert w.write_str("") == 0
    assert w.len() == 0
    0

[[test]]
fn test_fd_writer_writes_the_fd() -> i32
    var fds: [2]i32
    assert sys_pipe(@fds[0]) == 0
    var w: Writer = fd_writer(fds[1])
    assert writeln(@&w, "piped") == 6
    assert sys_close(fds[1]) == 0
    var got: [16]u8
    let n: i64 = sys_read(fds[0], @got[0], 16)
    sys_close(fds[0])
    assert n == 6
    assert strview_eq(strview_from_ptr(@got[0], 6), "piped\n")
    0

[[test]]
fn test_fd_writer_reports_the_error() -> i32
    var w: Writer = fd_writer(-1)
    assert write(@&w, "x") < 0
    assert w.len() == 0
    0

[[test]]
fn test_std_writers_name_their_fds() -> i32
    let o: Writer = stdout_writer()
    let e: Writer = stderr_writer()
    assert o.fd == 1
    assert e.fd == 2
    0

[[test]]
fn test_writer_is_a_format_into_sink() -> i32
    var buf: [32]u8
    var w: Writer = span_writer(span_from_ptr<u8>(@buf[0], 32))
    let n: i64 = 42
    let ok: bool = true
    format_into(@&w, "n={n} ok={ok}")
    assert view_is(@w, "n=42 ok=true")
    0

[[test]]
fn test_format_copies() -> i32
    var s: String = format("abc")
    assert strview_eq(string_as_view(@s), "abc")
    0
