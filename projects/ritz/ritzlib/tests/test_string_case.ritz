# Tests for ASCII case conversion (string_to_lower / strview_to_lower).
# In their own file because test_string_methods.ritz has a pre-existing
# compile failure (test_method_len) that would mask these.

import ritzlib.string

[[test]]
fn test_string_to_lower() -> i32
    var s: String = string_from("DejaVu Sans-42!")
    let lower: String = string_to_lower(@s)
    var expect: String = string_from("dejavu sans-42!")
    assert string_eq(@lower, @expect) == 1
    # Original untouched
    var orig: String = string_from("DejaVu Sans-42!")
    assert string_eq(@s, @orig) == 1
    0

[[test]]
fn test_strview_to_lower() -> i32
    let sv: StrView = "MiXeD Case"
    let lower: String = strview_to_lower(sv)
    var expect: String = string_from("mixed case")
    assert string_eq(@lower, @expect) == 1
    0

[[test]]
fn test_strview_to_lower_empty() -> i32
    let empty: StrView = ""
    let el: String = strview_to_lower(empty)
    assert string_len(@el) == 0
    0
