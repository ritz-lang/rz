# ritzlib.fmt.display: the Display and Debug traits (AGAST #201).
#
# A user struct implements both; String's impls are ritzlib's. The generic
# fmt_show / fmt_show_debug / fmt_show_with reach them through the bound.
#
# Runs under ritz0 (the package step) and ritz1 / ritz1_selfhosted
# (make ritzlib-tests-ritz1).

import ritzlib.fmt
import ritzlib.string
import ritzlib.span
import ritzlib.strview

struct Point
    x: i64
    y: i64

impl Display for Point
    fn show(self: @Point, w: @&Writer) -> i64
        let before: i64 = w.len
        format_into(w, "({self.x}, {self.y})")
        w.len - before

impl Debug for Point
    fn show_debug(self: @Point, w: @&Writer) -> i64
        let before: i64 = w.len
        format_into(w, "Point \{ x: {self.x}, y: {self.y} }")
        w.len - before

var g_buf: [256]u8

fn fresh() -> Writer
    span_writer(span_from_ptr<u8>(@g_buf[0], 256))

fn view_is(w: @Writer, want: StrView) -> bool
    strview_eq(writer_view(w), want)

[[test]]
fn test_a_user_impl_is_called_as_a_method() -> i32
    let p: Point = Point { x: 1, y: -2 }
    var w: Writer = fresh()
    assert p.show(@&w) == 7
    assert view_is(@w, "(1, -2)")
    0

[[test]]
fn test_display_and_debug_through_the_bound() -> i32
    let p: Point = Point { x: 3, y: 4 }
    var w: Writer = fresh()
    assert fmt_show(@p, @&w) == 6
    writer_write_byte(@&w, 124)
    assert fmt_show_debug(@p, @&w) == 20
    assert view_is(@w, "(3, 4)|Point { x: 3, y: 4 }")
    0

[[test]]
fn test_show_with_pads_any_display_type() -> i32
    let p: Point = Point { x: 3, y: 4 }
    var w: Writer = fresh()
    assert fmt_show_with(@p, @&w, ">8") == 8
    writer_write_byte(@&w, 124)
    assert fmt_show_with(@p, @&w, "<8") == 8
    writer_write_byte(@&w, 124)
    assert fmt_show_with(@p, @&w, "^9") == 9
    writer_write_byte(@&w, 124)
    assert fmt_show_with(@p, @&w, "") == 6
    writer_write_byte(@&w, 124)
    assert fmt_show_with(@p, @&w, "<2") == 6   # never truncates
    assert view_is(@w, "  (3, 4)|(3, 4)  | (3, 4)  |(3, 4)|(3, 4)")
    0

[[test]]
fn test_show_with_refuses_a_bad_spec_and_debug() -> i32
    let p: Point = Point { x: 0, y: 0 }
    var w: Writer = fresh()
    assert fmt_show_with(@p, @&w, "q") == -1
    assert fmt_show_with(@p, @&w, "?") == -1   # `?` is Debug: fmt_show_debug
    assert writer_len(@w) == 0
    0

[[test]]
fn test_string_implements_both() -> i32
    var s: String = string_from("hi\n")
    var w: Writer = fresh()
    assert s.show(@&w) == 3
    assert s.show_debug(@&w) == 6
    assert fmt_show(@s, @&w) == 3
    assert fmt_show_with(@s, @&w, ">4") == 4
    assert view_is(@w, "hi\n\"hi\\n\"hi\n hi\n")
    0
