# test_fs_dirent.ritz - Typed fs API: DirEntry { ino, kind, name: StrView }
# from dir_next_entry / dir_entry (AGAST #1476). stat tests: test_fs_stat.ritz.
#
# Each test owns its fixtures under a sandbox_path and removes them, so the verdict does
# not depend on the cwd build.py happens to run the binary from.

import ritzlib.fs
import ritzlib.sys { Stat }
import ritzlib.errno
import ritzlib.string
import ritzlib.strview
import ritzlib.result
import ritzlib.option
import ritzlib.testlib

# ============================================================================
# Helpers
# ============================================================================

fn inode_of(path: StrView) -> i64
    match stat(path)
        Ok(st) => st.st_ino
        Err(_) => -1

fn entry_or_empty(o: @Option<DirEntry>) -> DirEntry
    match *o
        Some(e) => e
        None => DirEntry { ino: -1, kind: 0, name: strview_empty() }

# `len` bytes of 'x' written to `path` (created or truncated).
fn write_fixture(path: StrView, len: i64) -> Result<i64, Errno>
    var body: String = string_new()
    for i in 0..len
        body.push('x')
    write_file(path, body.as_view())

# ============================================================================
# DirEntry
# ============================================================================

[[test]]
fn test_dir_next_entry_yields_typed_entries() -> i32
    let d: String = sandbox_path("fs_dirent", "1476_dir")
    let f: String = path_join(d.as_view(), "alpha")
    let sub: String = path_join(d.as_view(), "beta")
    unlink(f.as_view())
    rmdir(sub.as_view())
    rmdir(d.as_view())
    if mkdir(d.as_view(), 493).is_err()
        return 1
    if write_fixture(f.as_view(), 3).is_err()
        return 2
    if mkdir(sub.as_view(), 493).is_err()
        return 3
    let f_ino: i64 = inode_of(f.as_view())

    var seen_alpha: i32 = 0
    var seen_beta: i32 = 0
    var count: i32 = 0
    var bad: i32 = 0
    var dir: DirIter = match dir_open(d.as_view())
        Ok(it) => it
        Err(_) => return 7
    loop
        var o: Option<DirEntry> = dir.next_entry()
        if option_is_none<DirEntry>(@o)
            break
        let e: DirEntry = entry_or_empty(@o)
        count += 1
        if (e.name).eq("alpha")
            seen_alpha = 1
            # The view spans exactly the name; the NUL is not counted.
            if e.name.len != 5
                bad = 10
            if e.kind != DT_REG
                bad = 11
            if e.ino != f_ino
                bad = 12
        else if (e.name).eq("beta")
            seen_beta = 1
            if e.kind != DT_DIR
                bad = 13
    dir.close()
    unlink(f.as_view())
    rmdir(sub.as_view())
    rmdir(d.as_view())
    if bad != 0
        return bad
    if seen_alpha == 0
        return 4
    if seen_beta == 0
        return 5
    # alpha, beta, ".", ".."
    if count != 4
        return 6
    0

[[test]]
fn test_dir_open_missing_is_err() -> i32
    match dir_open("/nonexistent/ritz_1476")
        Ok(_) => return 1
        Err(e) => match e
            NoEnt => pass
            _ => return 2
    0

[[test]]
fn test_dir_next_entry_after_end_is_none() -> i32
    var dir: DirIter = match dir_open("/tmp")
        Ok(it) => it
        Err(_) => return 1
    loop
        var o: Option<DirEntry> = dir.next_entry()
        if option_is_none<DirEntry>(@o)
            break
    # Exhausted: still None, and dir_entry is the empty entry, not stale bytes.
    var again: Option<DirEntry> = dir.next_entry()
    if not option_is_none<DirEntry>(@again)
        return 2
    let e: DirEntry = dir.entry()
    dir.close()
    if e.ino != 0 or e.kind != DT_UNKNOWN or e.name.len != 0
        return 3
    0

[[test]]
fn test_dir_entry_matches_next_entry() -> i32
    var dir: DirIter = match dir_open("/tmp")
        Ok(it) => it
        Err(_) => return 7
    var checked: i32 = 0
    loop
        var o: Option<DirEntry> = dir.next_entry()
        if option_is_none<DirEntry>(@o)
            break
        let next_e: DirEntry = entry_or_empty(@o)
        let e: DirEntry = dir.entry()
        if e.ino != next_e.ino
            return 1
        if e.kind != next_e.kind
            return 2
        if e.name.ptr != next_e.name.ptr or e.name.len != next_e.name.len
            return 3
        checked += 1
    dir.close()
    if checked == 0
        return 6
    0
