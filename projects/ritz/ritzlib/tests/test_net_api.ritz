# ritzlib.net: the StrView / Span API (AGAST #1483).
#
#   parse_ipv4(s: StrView) -> Option<u32>
#   socket_valid(sock: @Socket) -> bool
#   socket_bind(sock: @&Socket, addr: StrView, port: i32) -> Result<(), Errno>
#   socket_connect(sock: @&Socket, addr: StrView, port: i32) -> Result<(), Errno>
#   socket_connect_timeout(sock: @&Socket, addr: StrView, port: i32, timeout_ms: i32)
#       -> Result<(), Errno>
#   socket_send_all(sock: @&Socket, data: Span<u8>) -> Result<i64, Errno>
#   socket_send_str(sock: @&Socket, s: StrView) -> Result<i64, Errno>
#   socket_recv_into(sock: @&Socket, buf: @&Vec<u8>, max: i64) -> Result<i64, Errno>
#
# and (AGAST #3880) the rest of the Socket API, borrowed the same way:
#
#   socket_close / socket_set_reuseaddr / socket_set_reuseport /
#   socket_set_nodelay(sock: @&Socket) -> Result<(), Errno>
#   socket_set_opt_int(sock: @&Socket, level, optname, value) -> Result<(), Errno>
#   socket_set_io_timeout(sock: @&Socket, timeout_ms: i32) -> Result<(), Errno>
#   socket_listen(sock: @&Socket, backlog: i32) -> Result<(), Errno>
#   socket_accept / socket_accept_nonblock(sock: @&Socket) -> Result<Socket, Errno>
#
# and (AGAST #4298) the constructors and epoll wrappers, which used to hand
# back a -1 fd or a negative errno:
#
#   socket_tcp / socket_tcp_nonblock / socket_udp() -> Result<Socket, Errno>
#   epoll_create() -> Result<i32, Errno>
#   epoll_add / epoll_mod(epfd: i32, fd: i32, events: u32) -> Result<(), Errno>
#   epoll_del(epfd: i32, fd: i32) -> Result<(), Errno>
#   epoll_wait_events(epfd, events: @&EpollEvent, max, timeout_ms) -> Result<i32, Errno>
#
# and (AGAST #4928) the readers, so no test hands getsockname(2) or
# getsockopt(2) an out-parameter:
#
#   s.local_ip() -> Result<u32, Errno>                  network byte order
#   s.get_opt_int(level, optname) -> Result<i32, Errno>
#   s.recv_timeout_ms() / s.send_timeout_ms() -> Result<i64, Errno>
#
# An Err carries a ritzlib.errno Errno (was a positive i32 errno, AGAST
# #4298); the helpers below compare its errno_code with the numbers.
#
# Addresses are handed over as slices of a longer literal wherever it
# matters: a StrView carries no terminator, so the parser must stop at `len`.
#
# Everything runs over 127.0.0.1 on a kernel-chosen port (bind to port 0),
# so no test depends on what else is listening on this host.

import ritzlib.sys
import ritzlib.gvec
import ritzlib.string
import ritzlib.strview
import ritzlib.span
import ritzlib.option
import ritzlib.result
import ritzlib.errno
import ritzlib.fd
import ritzlib.process
import ritzlib.time
import ritzlib.net

const E_BADF: i32 = 9
const E_AGAIN: i32 = 11
const E_INVAL: i32 = 22
const E_ADDRINUSE: i32 = 98
const E_TIMEDOUT: i32 = 110
const E_CONNREFUSED: i32 = 111

# 127.0.0.1 in network byte order, as the kernel stores it: the bytes
# 7f 00 00 01 in memory, which is 0x0100007f read as a little-endian u32.
const LOOPBACK_NBO: u32 = 16777343

# ============================================================================
# Helpers
# ============================================================================

fn ip_is(o: Option<u32>, want: u32) -> i32
    match o
        Some(a) => (a == want) as i32
        None => 0

fn ip_none(o: Option<u32>) -> i32
    match o
        Some(_) => 0
        None => 1

# The errno number of an Err, 0 for Ok.
fn unit_err(r: Result<(), Errno>) -> i32
    match r
        Ok(_) => 0
        Err(e) => e.code()

# The count of an Ok, -1000 - errno for an Err (so a test sees which).
fn count_of(r: Result<i64, Errno>) -> i64
    match r
        Ok(n) => n
        Err(e) => -1000 - e.code() as i64

# The value of an Ok (an fd, a ready count), -1000 - errno for an Err.
fn int_of(r: Result<i32, Errno>) -> i32
    match r
        Ok(n) => n
        Err(e) => -1000 - e.code()

# A closed Socket (fd -1): what a failed constructor or accept stands in as,
# so the test's next socket call reports EBADF.
fn dead_socket() -> Socket
    var dead: Socket
    dead.fd = -1
    dead.family = AF_INET
    dead.socktype = SOCK_STREAM
    dead

# A fresh TCP socket (a closed one if socket(2) failed).
fn tcp() -> Socket
    match socket_tcp()
        Ok(s) => s
        Err(_) => dead_socket()

# The Socket of an Ok accept; a closed one (fd -1) for an Err.
fn peer_of(r: Result<Socket, Errno>) -> Socket
    match r
        Ok(s) => s
        Err(_) => dead_socket()

# The errno number of an Err accept, 0 for Ok (whose Socket is closed).
fn accept_err(r: Result<Socket, Errno>) -> i32
    match r
        Ok(s) =>
            var t: Socket = s
            t.close()
            0
        Err(e) => e.code()

# The port the kernel gave a socket bound to port 0, in host byte order
# (-1000 - errno if getsockname failed).
fn bound_port(sock: @Socket) -> i32
    int_of(sock.local_port())

# The address a socket is bound to, network byte order (u32 max on Err).
fn bound_addr(sock: @Socket) -> u32
    sock.local_ip().unwrap_or(4294967295)

# A listening server on 127.0.0.1:<any> (a closed one if bind failed); its
# port is bound_port(@srv).
fn listen_loopback() -> Socket
    var s: Socket = tcp()
    if s.bind("127.0.0.1", 0).is_err()
        s.close()
        return s
    s.listen(4)
    s

# ============================================================================
# parse_ipv4 -> Option<u32>
# ============================================================================

[[test]]
fn test_parse_ipv4_loopback() -> i32
    assert ip_is(parse_ipv4("127.0.0.1"), LOOPBACK_NBO) == 1
    0

[[test]]
fn test_parse_ipv4_any_is_some_zero() -> i32
    # 0.0.0.0 is a real address, distinct from a parse failure.
    assert ip_is(parse_ipv4("0.0.0.0"), 0) == 1
    0

[[test]]
fn test_parse_ipv4_broadcast() -> i32
    assert ip_is(parse_ipv4("255.255.255.255"), 4294967295) == 1
    0

[[test]]
fn test_parse_ipv4_octet_order() -> i32
    # 10.20.30.40 -> bytes 0a 14 1e 28 in memory.
    assert ip_is(parse_ipv4("10.20.30.40"), 673059850) == 1
    0

[[test]]
fn test_parse_ipv4_stops_at_len() -> i32
    # The bytes after the view would make it invalid ("...1:80").
    assert ip_is(parse_ipv4(("127.0.0.1:80").slice(0, 9)), LOOPBACK_NBO) == 1
    0

[[test]]
fn test_parse_ipv4_rejects_garbage() -> i32
    assert ip_none(parse_ipv4("localhost")) == 1
    assert ip_none(parse_ipv4("")) == 1
    assert ip_none(parse_ipv4("1.2.3.4x")) == 1
    assert ip_none(parse_ipv4(" 1.2.3.4")) == 1
    0

[[test]]
fn test_parse_ipv4_rejects_wrong_octet_count() -> i32
    assert ip_none(parse_ipv4("1.2.3")) == 1
    assert ip_none(parse_ipv4("1.2.3.4.5")) == 1
    0

[[test]]
fn test_parse_ipv4_rejects_empty_octet() -> i32
    assert ip_none(parse_ipv4("1..3.4")) == 1
    assert ip_none(parse_ipv4(".1.2.3")) == 1
    assert ip_none(parse_ipv4("1.2.3.")) == 1
    0

[[test]]
fn test_parse_ipv4_rejects_octet_over_255() -> i32
    assert ip_none(parse_ipv4("256.0.0.1")) == 1
    assert ip_none(parse_ipv4("1.2.3.999")) == 1
    # Large enough to wrap a u32 accumulator back under 256.
    assert ip_none(parse_ipv4("4294967297.0.0.1")) == 1
    0

[[test]]
fn test_inaddr_loopback() -> i32
    assert inaddr_loopback() == LOOPBACK_NBO
    0

# ============================================================================
# socket_valid -> bool
# ============================================================================

[[test]]
fn test_socket_valid_is_bool() -> i32
    var s: Socket = tcp()
    assert s.valid()
    assert s.valid()
    s.close()
    assert not s.valid()
    assert not s.valid()
    0

# ============================================================================
# socket_bind -> Result<(), Errno>
# ============================================================================

[[test]]
fn test_bind_loopback_ok() -> i32
    var s: Socket = tcp()
    assert s.bind("127.0.0.1", 0).is_ok()
    assert bound_addr(@s) == LOOPBACK_NBO
    assert bound_port(@s) > 0
    s.close()
    0

[[test]]
fn test_bind_address_from_a_slice() -> i32
    var s: Socket = tcp()
    assert s.bind(("127.0.0.1NOPE").slice(0, 9), 0).is_ok()
    assert bound_addr(@s) == LOOPBACK_NBO
    s.close()
    0

[[test]]
fn test_bind_garbage_address_is_einval() -> i32
    # Before #1483 "localhost" parsed to 0 and bound 0.0.0.0.
    var s: Socket = tcp()
    assert unit_err(s.bind("localhost", 0)) == E_INVAL
    s.close()
    0

[[test]]
fn test_bind_syscall_failure_is_positive_errno() -> i32
    var a: Socket = listen_loopback()
    let port: i32 = bound_port(@a)
    assert a.fd >= 0
    var b: Socket = tcp()
    assert unit_err(b.bind("127.0.0.1", port)) == E_ADDRINUSE
    b.close()
    a.close()
    0

[[test]]
fn test_bind_method() -> i32
    var s: Socket = tcp()
    assert s.bind("127.0.0.1", 0).is_ok()
    assert bound_addr(@s) == LOOPBACK_NBO
    s.close()
    0

[[test]]
fn test_bind_any_address_binds_every_interface() -> i32
    # socket_bind_any is gone (#3835): "0.0.0.0" is how to say it.
    var s: Socket = tcp()
    assert s.bind("0.0.0.0", 0).is_ok()
    assert bound_addr(@s) == 0
    s.close()
    0

# ============================================================================
# close / option setters / listen / accept -> Result (AGAST #3880)
# ============================================================================

# Linux option numbers, spelled out so a setter that sets the wrong option
# fails here.  L_ prefixed: net.ritz has its own.
const L_SOL_SOCKET: i32 = 1
const L_SO_REUSEADDR: i32 = 2
const L_SO_KEEPALIVE: i32 = 9
const L_SO_REUSEPORT: i32 = 15
const L_SO_RCVTIMEO: i32 = 20
const L_SO_SNDTIMEO: i32 = 21
const L_IPPROTO_TCP: i32 = 6
const L_TCP_NODELAY: i32 = 1

# An integer option's value, -1 if getsockopt fails.
fn opt_of(sock: @Socket, level: i32, name: i32) -> i32
    sock.get_opt_int(level, name).unwrap_or(-1)

[[test]]
fn test_close_marks_closed_and_is_idempotent() -> i32
    var s: Socket = tcp()
    assert s.close().is_ok()
    assert s.fd == -1
    assert s.close().is_ok()
    var t: Socket = tcp()
    assert t.close().is_ok()
    assert not t.valid()
    0

[[test]]
fn test_close_failure_is_errno_and_still_marks_closed() -> i32
    var s: Socket = tcp()
    # Closed behind the Socket's back, through a second handle on its fd.
    var behind: Socket = socket_from_raw(s.raw())
    assert behind.close().is_ok()
    assert unit_err(s.close()) == E_BADF
    assert s.fd == -1
    0

[[test]]
fn test_option_setters_set_their_option() -> i32
    var s: Socket = tcp()
    assert s.set_reuseaddr().is_ok()
    assert opt_of(@s, L_SOL_SOCKET, L_SO_REUSEADDR) == 1
    assert s.set_reuseport().is_ok()
    assert opt_of(@s, L_SOL_SOCKET, L_SO_REUSEPORT) == 1
    assert s.set_nodelay().is_ok()
    assert opt_of(@s, L_IPPROTO_TCP, L_TCP_NODELAY) == 1
    assert s.set_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE, 1).is_ok()
    assert opt_of(@s, L_SOL_SOCKET, L_SO_KEEPALIVE) == 1
    # The kernel stores SO_*TIMEO in jiffies and rounds up, so the readback
    # is exact only for a whole number of ticks. 3000 ms is one at
    # HZ=100/250/300/1000; 1250 ms read back as 1252 at HZ=250.
    assert s.set_io_timeout(3000).is_ok()
    assert s.recv_timeout_ms().unwrap_or(-1) == 3000
    assert s.send_timeout_ms().unwrap_or(-1) == 3000
    assert s.set_io_timeout(0).is_ok()
    assert s.send_timeout_ms().unwrap_or(-1) == 0
    var t: Socket = tcp()
    assert t.set_reuseaddr().is_ok()
    assert opt_of(@t, L_SOL_SOCKET, L_SO_REUSEADDR) == 1
    t.close()
    s.close()
    0

[[test]]
fn test_option_setter_failures_are_positive_errno() -> i32
    var s: Socket = tcp()
    s.close()
    assert unit_err(s.set_reuseaddr()) == E_BADF
    assert unit_err(s.set_reuseport()) == E_BADF
    assert unit_err(s.set_nodelay()) == E_BADF
    assert unit_err(s.set_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE, 1)) == E_BADF
    assert unit_err(s.set_io_timeout(100)) == E_BADF
    0

[[test]]
fn test_listen_ok_and_failure_is_errno() -> i32
    var s: Socket = tcp()
    assert s.bind("127.0.0.1", 0).is_ok()
    assert s.listen(4).is_ok()
    s.close()
    assert unit_err(s.listen(4)) == E_BADF
    0

[[test]]
fn test_accept_failure_is_errno_not_a_dead_socket() -> i32
    # Not listening: accept(2) is EINVAL.  Before #3880 this came back as a
    # Socket whose fd was -22.
    var s: Socket = tcp()
    assert accept_err(s.accept()) == E_INVAL
    assert accept_err(s.accept_nonblock()) == E_INVAL
    s.close()
    assert accept_err(s.accept()) == E_BADF
    0

[[test]]
fn test_accept_nonblock_eagain_then_nonblocking_peer() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    assert srv.fd >= 0
    # A blocking listener, nothing pending: accept4(SOCK_NONBLOCK) only
    # makes the *accepted* socket non-blocking, so make srv non-blocking too.
    assert fd_borrow(srv.raw()).set_nonblocking(true).is_ok()
    assert accept_err(srv.accept_nonblock()) == E_AGAIN

    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    match srv.accept_nonblock()
        Ok(p) =>
            var peer: Socket = p
            assert peer.valid()
            assert peer.family == AF_INET and peer.socktype == SOCK_STREAM
            assert fd_borrow(peer.raw()).is_nonblocking().unwrap_or(false)
            assert peer.close().is_ok()
        Err(_) =>
            assert 0 == 1
    c.close()
    srv.close()
    0

[[test]]
fn test_accept_method_returns_connected_socket() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    var peer: Socket = peer_of(srv.accept())
    assert peer.valid()
    assert count_of(c.send_str("ok")) == 2
    var buf: Vec<u8> = vec_new<u8>()
    assert count_of(peer.recv_into(@&buf, 8)) == 2
    peer.close()
    c.close()
    srv.close()
    0

# ============================================================================
# socket_connect -> Result<(), Errno>
# ============================================================================

[[test]]
fn test_connect_loopback_ok() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    assert srv.fd >= 0
    var c: Socket = tcp()
    assert c.connect(("127.0.0.1:x").slice(0, 9), port).is_ok()
    c.close()
    srv.close()
    0

[[test]]
fn test_connect_garbage_address_is_einval() -> i32
    var c: Socket = tcp()
    assert unit_err(c.connect("not-an-ip", 80)) == E_INVAL
    c.close()
    0

[[test]]
fn test_connect_refused_is_positive_errno() -> i32
    # A port that was bound and released: nothing is listening on it.
    var tmp: Socket = tcp()
    tmp.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@tmp)
    tmp.close()
    var c: Socket = tcp()
    assert unit_err(c.connect("127.0.0.1", port)) == E_CONNREFUSED
    c.close()
    0

# ============================================================================
# socket_connect_timeout -> Result<(), Errno> (AGAST #3835)
# ============================================================================

[[test]]
fn test_connect_timeout_loopback_ok() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    assert srv.fd >= 0
    var c: Socket = tcp()
    # A slice of a longer literal: the address needs no terminator.
    assert c.connect_timeout(("127.0.0.1:x").slice(0, 9), port, 5000).is_ok()
    # The socket is blocking again afterwards: a send of one byte completes.
    assert count_of(c.send_str("x")) == 1
    c.close()
    srv.close()
    0

[[test]]
fn test_connect_timeout_garbage_address_is_einval() -> i32
    # EINVAL, not a connect to 0.0.0.0, where this very listener (bound to
    # 127.0.0.1) would have answered.
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert unit_err(c.connect_timeout("bogus", port, 1000)) == E_INVAL
    c.close()
    srv.close()
    0

[[test]]
fn test_connect_timeout_refused_is_the_errno() -> i32
    # The raw form said -3; the errno is ECONNREFUSED.
    var tmp: Socket = tcp()
    tmp.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@tmp)
    tmp.close()
    var c: Socket = tcp()
    assert unit_err(c.connect_timeout("127.0.0.1", port, 5000)) == E_CONNREFUSED
    c.close()
    0

[[test]]
fn test_connect_timeout_expiry_is_etimedout() -> i32
    # A listener with backlog 0 whose accept queue is already full drops
    # the next SYN, so that connect stays in progress until the timeout.
    var srv: Socket = tcp()
    assert srv.bind("127.0.0.1", 0).is_ok()
    srv.listen(0)
    let port: i32 = bound_port(@srv)
    var a: Socket = tcp()
    assert a.connect("127.0.0.1", port).is_ok()
    var b: Socket = tcp()
    assert unit_err(b.connect_timeout("127.0.0.1", port, 100)) == E_TIMEDOUT
    b.close()
    a.close()
    srv.close()
    0

[[test]]
fn test_connect_timeout_bad_fd_is_ebadf() -> i32
    # A failing fcntl is its errno, not a bare -1.
    var c: Socket = tcp()
    c.close()
    assert unit_err(c.connect_timeout("127.0.0.1", 80, 100)) == E_BADF
    0

[[test]]
fn test_connect_method() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    c.close()
    srv.close()
    0

# ============================================================================
# socket_send_all / socket_send_str / socket_recv_into
# ============================================================================

[[test]]
fn test_send_and_recv_into_round_trip() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    var peer: Socket = peer_of(srv.accept())
    assert peer.valid()

    assert count_of(c.send_all("hello world")) == 11
    var buf: Vec<u8> = vec_new<u8>()
    assert count_of(peer.recv_into(@&buf, 64)) == 11
    assert buf.as_view().eq("hello world")

    peer.close()
    c.close()
    srv.close()
    0

[[test]]
fn test_recv_into_appends_and_respects_max() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    c.connect("127.0.0.1", port)
    var peer: Socket = peer_of(srv.accept())

    assert count_of(c.send_str(("abcdefNOPE").slice(0, 6))) == 6
    var buf: Vec<u8> = vec_new<u8>()
    buf.push('>')
    # At most 4 bytes this time; the rest stays in the socket.
    assert count_of(peer.recv_into(@&buf, 4)) == 4
    assert buf.as_view().eq(">abcd")
    assert count_of(peer.recv_into(@&buf, 64)) == 2
    assert buf.as_view().eq(">abcdef")

    peer.close()
    c.close()
    srv.close()
    0

[[test]]
fn test_recv_into_eof_is_ok_zero() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    c.connect("127.0.0.1", port)
    var peer: Socket = peer_of(srv.accept())
    c.close()
    var buf: Vec<u8> = vec_new<u8>()
    assert count_of(peer.recv_into(@&buf, 64)) == 0
    assert buf.len == 0
    peer.close()
    srv.close()
    0

[[test]]
fn test_send_and_recv_errors_are_positive_errno() -> i32
    var s: Socket = tcp()
    s.close()
    assert count_of(s.send_all("x")) == -1000 - E_BADF as i64
    var buf: Vec<u8> = vec_new<u8>()
    assert count_of(s.recv_into(@&buf, 8)) == -1000 - E_BADF as i64
    assert buf.len == 0
    0

[[test]]
fn test_send_all_sends_a_vec_span_and_methods() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    var peer: Socket = peer_of(srv.accept())

    var out: Vec<u8> = vec_new<u8>()
    out.push('h')
    out.push('i')
    assert count_of(c.send(span_from_vec<u8>(@out))) == 2
    var msg: String = string_from("there")
    assert count_of(c.send_str(msg.as_view())) == 5
    var buf: Vec<u8> = vec_new<u8>()
    var got: i64 = 0
    while got < 7
        let n: i64 = count_of(peer.recv(@&buf, 64))
        assert n > 0
        got += n
    assert buf.as_view().eq("hithere")

    peer.close()
    c.close()
    srv.close()
    0

# A blocking write() on a TCP socket only comes back short when something
# cuts it off; SO_SNDTIMEO does, once the call has spent that long in total
# waiting for buffer space.  16 MiB is more than loopback buffers hold, and
# the forked reader reads nothing for 3 s, then drains without pausing.  So
# the first write() fills the buffers and comes back short after the 2 s
# timeout, and send_all must keep going: its next write() waits ~1 s for the
# reader to start, inside its own 2 s.
#
# One sleep, with a second of slack either way, is the only timing here.
# This test used to have its reader sleep 10 ms after every 64 KiB against a
# 300 ms timeout: 256 wake-ups that each had to come within 300 ms, which a
# loaded host missed in about half of all runs (AGAST #3942).  If the reader
# wakes early, the first write() just completes: the test passes without
# covering a short write, rather than failing.
# The child exits 0 iff it read every byte.
# The forked reader: 3 s asleep, then accept and read to EOF.  0 iff it read
# all `total` bytes.
fn drain_after_3s(srv: @&Socket, total: i64) -> i32
    sleep_ms(3000)
    var peer: Socket = peer_of(srv.accept())
    var got: i64 = 0
    var chunk: Vec<u8> = vec_with_cap<u8>(65536)
    loop
        chunk.clear()
        let n: i64 = count_of(peer.recv_into(@&chunk, 65536))
        if n <= 0
            break
        got += n
    if got == total then 0 else 1

[[test]]
fn test_send_all_completes_after_short_writes() -> i32
    let total: i64 = 16777216
    # Filled before the fork, so the first write() starts right after connect.
    var big: Vec<u8> = vec_zeroed<u8>(total)
    assert big.len == total
    span_from_vec<u8>(@big).fill('z')
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    assert srv.fd >= 0

    let pid: i32 = match fork()
        Ok(side) => match side
            Child =>
                sys_exit(drain_after_3s(@&srv, total))
                0
            Parent(child) => child
        Err(_) => return 1

    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    assert c.set_io_timeout(2000).is_ok()
    assert count_of(c.send_all(span_from_vec<u8>(@big))) == total
    c.close()

    let waited: Result<ProcessResult, Errno> = wait_pid(pid)
    srv.close()
    match waited
        Ok(r) =>
            assert r.success()
        Err(_) =>
            assert false, "wait_pid"
    0

# ============================================================================
# socket_tcp / socket_tcp_nonblock / socket_udp -> Result<Socket, Errno>
# (AGAST #4298: was a Socket whose fd < 0 meant failure)
# ============================================================================

[[test]]
fn test_socket_tcp_is_ok_stream() -> i32
    match socket_tcp()
        Ok(s) =>
            var t: Socket = s
            assert t.fd >= 0
            assert t.family == AF_INET and t.socktype == SOCK_STREAM
            assert not fd_borrow(t.raw()).is_nonblocking().unwrap_or(true)
            assert t.close().is_ok()
        Err(_) =>
            assert 0 == 1
    0

[[test]]
fn test_socket_tcp_nonblock_is_ok_nonblocking() -> i32
    match socket_tcp_nonblock()
        Ok(s) =>
            var t: Socket = s
            assert t.fd >= 0
            # The bare SOCK_STREAM, not SOCK_STREAM | SOCK_NONBLOCK.
            assert t.socktype == SOCK_STREAM
            assert fd_borrow(t.raw()).is_nonblocking().unwrap_or(false)
            t.close()
        Err(_) =>
            assert 0 == 1
    0

[[test]]
fn test_socket_udp_is_ok_dgram() -> i32
    match socket_udp()
        Ok(s) =>
            var t: Socket = s
            assert t.fd >= 0
            assert t.family == AF_INET and t.socktype == SOCK_DGRAM
            # A datagram socket binds like any other.
            assert t.bind("127.0.0.1", 0).is_ok()
            t.close()
        Err(_) =>
            assert 0 == 1
    0

# ============================================================================
# Err is an Errno: match the variant itself
# ============================================================================

[[test]]
fn test_bind_garbage_address_is_inval_variant() -> i32
    var s: Socket = tcp()
    match s.bind("localhost", 0)
        Ok(_) =>
            assert 0 == 1
        Err(e) => match e
            Inval => pass
            _ =>
                assert 0 == 1
    s.close()
    0

[[test]]
fn test_connect_refused_is_connrefused_variant() -> i32
    var tmp: Socket = tcp()
    tmp.bind("127.0.0.1", 0)
    let port: i32 = bound_port(@tmp)
    tmp.close()
    var c: Socket = tcp()
    match c.connect("127.0.0.1", port)
        Ok(_) =>
            assert 0 == 1
        Err(e) => match e
            ConnRefused => pass
            _ =>
                assert 0 == 1
    c.close()
    0

# ============================================================================
# epoll_create / epoll_add / epoll_mod / epoll_del / epoll_wait_events
# -> Result (AGAST #4298: were raw fds and negative errnos)
# ============================================================================

const L_EPOLLIN: u32 = 1

# A fresh pipe (both ends closed if pipe(2) failed, so the test's next use
# of them reports EBADF).
fn new_pipe() -> Pipe
    match pipe()
        Ok(p) => p
        Err(_) => Pipe { read: fd_adopt(-1), write: fd_adopt(-1) }

[[test]]
fn test_epoll_create_is_ok_fd() -> i32
    var ep: Fd = fd_adopt(int_of(epoll_create()))
    assert ep.raw() >= 0
    assert ep.close().is_ok()
    0

[[test]]
fn test_epoll_add_twice_is_exist() -> i32
    var epfd: Fd = fd_adopt(int_of(epoll_create()))
    let ep: i32 = epfd.raw()
    var p: Pipe = new_pipe()
    let r: i32 = p.read.raw()
    assert epoll_add(ep, r, L_EPOLLIN).is_ok()
    assert unit_err(epoll_add(ep, r, L_EPOLLIN)) == EEXIST
    match epoll_add(ep, r, L_EPOLLIN)
        Ok(_) =>
            assert 0 == 1
        Err(e) => match e
            Exist => pass
            _ =>
                assert 0 == 1
    p.close()
    epfd.close()
    0

[[test]]
fn test_epoll_del_and_mod_of_unwatched_fd_is_noent() -> i32
    var epfd: Fd = fd_adopt(int_of(epoll_create()))
    let ep: i32 = epfd.raw()
    var p: Pipe = new_pipe()
    let r: i32 = p.read.raw()
    assert unit_err(epoll_del(ep, r)) == ENOENT
    assert unit_err(epoll_mod(ep, r, L_EPOLLIN)) == ENOENT
    assert epoll_add(ep, r, L_EPOLLIN).is_ok()
    assert epoll_mod(ep, r, L_EPOLLIN).is_ok()
    assert epoll_del(ep, r).is_ok()
    assert unit_err(epoll_del(ep, r)) == ENOENT
    # A closed epoll fd is EBADF, not a bare -9.
    epfd.close()
    assert unit_err(epoll_add(ep, r, L_EPOLLIN)) == E_BADF
    p.close()
    0

[[test]]
fn test_epoll_wait_events_counts_ready_fds() -> i32
    var epfd: Fd = fd_adopt(int_of(epoll_create()))
    let ep: i32 = epfd.raw()
    var p: Pipe = new_pipe()
    assert epoll_add(ep, p.read.raw(), L_EPOLLIN).is_ok()
    # Room for more than one event whatever EpollEvent's padding.
    var evs: [4]EpollEvent
    # Idle: a timeout of 0 is Ok(0), not an error.
    assert int_of(epoll_wait_events(ep, @&evs[0], 1, 0)) == 0
    assert count_of(p.write.write("x")) == 1
    assert int_of(epoll_wait_events(ep, @&evs[0], 1, 0)) == 1
    assert (evs[0].events & L_EPOLLIN) != 0
    p.close()
    epfd.close()
    # On a closed epoll fd the wait is Err(BadF).
    assert int_of(epoll_wait_events(ep, @&evs[0], 1, 0)) == -1000 - E_BADF
    0

# AGAST #4302: EpollEvent must match the x86_64 kernel's packed
# `struct epoll_event` — 12 bytes, `data` at offset 4.  Unpacked, Ritz laid
# it out as 16 bytes with `data` at 8, so epoll_ctl read the fd from the
# wrong bytes and a multi-event wait's evs[1] was 4 bytes off.

fn ep_off(base: *u8, field: *u8) -> i64
    field as i64 - base as i64

[[test]]
fn test_epoll_event_is_kernel_layout() -> i32
    assert sizeof(EpollEvent) == 12
    var ev: EpollEvent
    let base: *u8 = @ev as *u8
    assert ep_off(base, @ev.events as *u8) == 0
    assert ep_off(base, @ev.data as *u8) == 4
    var evs: [2]EpollEvent
    assert ep_off(@evs[0] as *u8, @evs[1] as *u8) == 12
    0

# The fd epoll_add registered comes back in `.data`, read through the
# kernel's offset as well as the field, for each of two ready fds.
[[test]]
fn test_epoll_wait_events_returns_fd_in_data() -> i32
    var epfd: Fd = fd_adopt(int_of(epoll_create()))
    let ep: i32 = epfd.raw()
    var a: Pipe = new_pipe()
    var b: Pipe = new_pipe()
    let ar: i32 = a.read.raw()
    let br: i32 = b.read.raw()
    assert epoll_add(ep, ar, L_EPOLLIN).is_ok()
    assert epoll_add(ep, br, L_EPOLLIN).is_ok()
    assert count_of(a.write.write("x")) == 1
    assert count_of(b.write.write("x")) == 1
    # Poison the buffer so a stale or misplaced byte cannot pass by luck.
    var evs: [4]EpollEvent
    let raw: *u8 = @evs[0] as *u8
    var i: i64 = 0
    while i < 48
        *(raw + i) = 0xAA
        i += 1
    assert int_of(epoll_wait_events(ep, @&evs[0], 4, 0)) == 2
    var seen_a: i32 = 0
    var seen_b: i32 = 0
    var k: i64 = 0
    while k < 2
        # The kernel writes event k at k * 12, data at +4.
        let kdata: u64 = *((raw + k * 12 + 4) as *u64)
        assert evs[k].data == kdata
        assert (evs[k].events & L_EPOLLIN) != 0
        if kdata == ar as u64
            seen_a += 1
        if kdata == br as u64
            seen_b += 1
        k += 1
    assert seen_a == 1
    assert seen_b == 1
    # epoll_mod re-registers `.data` the same way.
    assert epoll_mod(ep, ar, L_EPOLLIN).is_ok()
    assert int_of(epoll_wait_events(ep, @&evs[0], 1, 0)) >= 1
    assert evs[0].data == ar as u64 or evs[0].data == br as u64
    a.close()
    b.close()
    epfd.close()
    0

# ============================================================================
# shutdown / raw / local_port / socket_from_raw (AGAST #4645)
#
# What async_net's i32-fd API (tcp_shutdown, tcp_getsockname, ...) did,
# on the Socket.
# ============================================================================

[[test]]
fn test_local_port_is_the_kernel_chosen_port() -> i32
    var s: Socket = tcp()
    assert s.bind("127.0.0.1", 0).is_ok()
    let got: i32 = int_of(s.local_port())
    assert got > 0
    # It is the port the socket is on: a connect to it reaches this listener.
    assert s.listen(1).is_ok()
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", got).is_ok()
    c.close()
    s.close()
    0

[[test]]
fn test_local_port_of_closed_socket_is_ebadf() -> i32
    var s: Socket = tcp()
    s.close()
    assert int_of(s.local_port()) == -1000 - E_BADF
    0

[[test]]
fn test_raw_is_the_descriptor() -> i32
    var s: Socket = tcp()
    assert s.raw() == s.fd
    assert s.raw() >= 0
    s.close()
    assert s.raw() == -1
    0

[[test]]
fn test_socket_from_raw_adopts_the_descriptor() -> i32
    var s: Socket = tcp()
    var t: Socket = socket_from_raw(s.raw())
    assert t.fd == s.fd
    assert t.family == AF_INET and t.socktype == SOCK_STREAM
    # The same descriptor: an option set through one is seen through the other.
    assert t.set_reuseaddr().is_ok()
    assert t.bind("127.0.0.1", 0).is_ok()
    assert int_of(s.local_port()) == int_of(t.local_port())
    s.close()
    0

[[test]]
fn test_shutdown_write_gives_peer_eof() -> i32
    var srv: Socket = listen_loopback()
    let port: i32 = bound_port(@srv)
    var c: Socket = tcp()
    assert c.connect("127.0.0.1", port).is_ok()
    var peer: Socket = peer_of(srv.accept())
    assert peer.valid()
    assert count_of(c.send_str("hi")) == 2
    assert c.shutdown(SHUT_WR).is_ok()
    var buf: Vec<u8> = vec_new<u8>()
    assert count_of(peer.recv_into(@&buf, 8)) == 2
    # The half-close reached the peer: the next read is end of stream.
    assert count_of(peer.recv_into(@&buf, 8)) == 0
    peer.close()
    c.close()
    srv.close()
    0

[[test]]
fn test_shutdown_unconnected_is_enotconn() -> i32
    var s: Socket = tcp()
    assert unit_err(s.shutdown(SHUT_RDWR)) == 107
    s.close()
    assert unit_err(s.shutdown(SHUT_RDWR)) == E_BADF
    0

# ============================================================================
# local_ip / get_opt_int / recv_timeout_ms / send_timeout_ms (AGAST #4928)
#
# The readers beside bind / set_opt_int / set_io_timeout, so a caller never
# hands getsockname(2) or getsockopt(2) an out-parameter.
# ============================================================================

[[test]]
fn test_local_ip_is_the_bound_address() -> i32
    var s: Socket = tcp()
    assert s.bind("127.0.0.1", 0).is_ok()
    match s.local_ip()
        Ok(ip) =>
            assert ip == LOOPBACK_NBO
        Err(_) =>
            assert false, "local_ip"
    s.close()
    match s.local_ip()
        Ok(_) =>
            assert false, "local_ip of a closed socket"
        Err(e) =>
            assert e.code() == E_BADF
    0

[[test]]
fn test_get_opt_int_reads_what_set_opt_int_set() -> i32
    var s: Socket = tcp()
    assert s.get_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE).unwrap_or(-1) == 0
    assert s.set_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE, 1).is_ok()
    assert s.get_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE).unwrap_or(-1) == 1
    s.close()
    match s.get_opt_int(L_SOL_SOCKET, L_SO_KEEPALIVE)
        Ok(_) =>
            assert false, "get_opt_int of a closed socket"
        Err(e) =>
            assert e.code() == E_BADF
    0

[[test]]
fn test_timeouts_read_back_what_set_io_timeout_set() -> i32
    var s: Socket = tcp()
    assert s.recv_timeout_ms().unwrap_or(-1) == 0
    assert s.send_timeout_ms().unwrap_or(-1) == 0
    assert s.set_io_timeout(3000).is_ok()
    assert s.recv_timeout_ms().unwrap_or(-1) == 3000
    assert s.send_timeout_ms().unwrap_or(-1) == 3000
    s.close()
    assert s.recv_timeout_ms().is_err()
    assert s.send_timeout_ms().is_err()
    0
