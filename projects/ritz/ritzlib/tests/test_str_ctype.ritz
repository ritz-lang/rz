# Tests for ritzlib/str.ritz character classification: each predicate is a
# bool (AGAST #4639; they returned an i32 0/1 before).

import ritzlib.str

[[test]]
fn test_isdigit() -> i32
    assert isdigit('0')
    assert isdigit('9')
    assert not isdigit('/')
    assert not isdigit(':')
    assert not isdigit('a')
    0

[[test]]
fn test_isalpha_isupper_islower() -> i32
    assert isalpha('A') and isalpha('Z') and isalpha('a') and isalpha('z')
    assert not isalpha('@') and not isalpha('[') and not isalpha('`') and not isalpha('{')
    assert isupper('Q') and not isupper('q')
    assert islower('q') and not islower('Q')
    assert not isupper('1') and not islower('1')
    0

[[test]]
fn test_isalnum_isspace() -> i32
    assert isalnum('5') and isalnum('k') and isalnum('K')
    assert not isalnum('_') and not isalnum(' ')
    assert isspace(' ') and isspace('\t') and isspace('\n') and isspace('\r')
    assert not isspace('a') and not isspace(0)
    0

[[test]]
fn test_ctype_is_bool() -> i32
    # A bool slot takes the result directly: `!= 0` is gone.
    let b: bool = isdigit('7')
    assert b
    0
