# vec_zeroed / box_zeroed / box_empty: owned, all-zero memory without a value
# to copy in, and a Box holding nothing
import ritzlib.gvec
import ritzlib.box
import ritzlib.span

struct Big
    tag: i64
    window: [65536]u8

[[test]]
fn test_vec_zeroed_len_cap_and_zero() -> i32
    var v: Vec<u8> = vec_zeroed<u8>(4096)
    if v.len() != 4096 or v.cap() != 4096
        return 1
    let s: [u8] = v[0..v.len()]
    for i in 0..s.len
        if s[i] != 0
            return 2
    s[4095] = 7
    if v.get(4095) != 7
        return 3
    0

[[test]]
fn test_vec_zeroed_wider_element() -> i32
    var v: Vec<i64> = vec_zeroed<i64>(3)
    if v.len() != 3 or v.get(0) != 0 or v.get(2) != 0
        return 1
    v.push(5)
    if v.len() != 4 or v.get(3) != 5
        return 2
    0

[[test]]
fn test_vec_zeroed_empty_for_nonpositive() -> i32
    var a: Vec<u8> = vec_zeroed<u8>(0)
    var b: Vec<u8> = vec_zeroed<u8>(-4)
    if a.len() != 0 or b.len() != 0
        return 1
    0

[[test]]
fn test_box_zeroed_big_value() -> i32
    var b: Box<Big> = box_zeroed<Big>()
    if not b.valid()
        return 1
    if b.tag != 0 or b.window[65535] != 0
        return 2
    b.tag = 9
    b.window[100] = 3
    let p: *Big = b.as_ptr()
    if p.tag != 9 or p.window[100] != 3
        return 3
    0

struct Holder
    big: Box<Big>
    other: Box<Big>

fn holder_new(which: i32) -> Holder
    if which == 0
        return Holder { big: box_zeroed<Big>(), other: box_empty<Big>() }
    Holder { big: box_empty<Big>(), other: box_zeroed<Big>() }

[[test]]
fn test_box_empty_is_invalid_and_drops() -> i32
    var e: Box<Big> = box_empty<Big>()
    if e.valid()
        return 1
    var h: Holder = holder_new(1)
    if h.big.valid() or not h.other.valid()
        return 2
    h.other.tag = 4
    if h.other.tag != 4
        return 3
    0
