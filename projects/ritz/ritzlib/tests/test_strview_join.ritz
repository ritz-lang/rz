# Tests for ritzlib/string's strview_join2 / strview_join3 (AGAST #4915).
#
# About 45 ritz1/src sites malloc a buffer, memcpy two or more views into
# it by hand, NUL-terminate it (the emitter still reads names as *u8) and
# wrap the result in a StrView. These two helpers are that loop, written
# once. The caller owns the returned view's buffer and frees it with
# `free(result.ptr)` — same lifetime the hand-written loop had.
import ritzlib.memory  # free
import ritzlib.string
import ritzlib.strview

# ============================================================================
# strview_join2(a, b)
# ============================================================================

[[test]]
fn test_join2_concatenates() -> i32
    let r: StrView = strview_join2("foo", "bar")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.eq("foobar")
    0

[[test]]
fn test_join2_left_empty() -> i32
    let r: StrView = strview_join2("", "bar")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.eq("bar")
    0

[[test]]
fn test_join2_right_empty() -> i32
    let r: StrView = strview_join2("foo", "")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.eq("foo")
    0

[[test]]
fn test_join2_both_empty() -> i32
    let r: StrView = strview_join2("", "")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.len == 0
    0

# The result is NUL-terminated (the emitter reads names as *u8) and is a
# fresh buffer, not a re-wrap of either input's own storage.
[[test]]
fn test_join2_is_nul_terminated_and_fresh() -> i32
    let a: StrView = "foo"
    let b: StrView = "bar"
    let r: StrView = strview_join2(a, b)
    defer free(r.ptr)  # the caller owns the joined buffer
    assert *(r.ptr + r.len) == 0
    assert r.ptr != a.ptr and r.ptr != b.ptr
    0

# ============================================================================
# strview_join3(a, sep, b)
# ============================================================================

[[test]]
fn test_join3_concatenates_with_separator() -> i32
    let r: StrView = strview_join3("Type", "_", "method")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.eq("Type_method")
    0

[[test]]
fn test_join3_empty_separator_is_join2() -> i32
    let r: StrView = strview_join3("foo", "", "bar")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert r.eq("foobar")
    0

[[test]]
fn test_join3_is_nul_terminated() -> i32
    let r: StrView = strview_join3("a", "_", "b")
    defer free(r.ptr)  # the caller owns the joined buffer
    assert *(r.ptr + r.len) == 0
    0
