# Tests for ritzlib.errno: the typed kernel error code fs's, net's and
# process's Results carry (AGAST #4248, #4298).

import ritzlib.sys
import ritzlib.errno
import ritzlib.strview
import ritzlib.string
import ritzlib.result
import ritzlib.fd

# ritz1 cannot emit a method call whose receiver is a qualified variant
# literal (`code(Errno.NoEnt)`), so a variant's method is reached through a
# local parameter here.
fn code(e: Errno) -> i32
    e.code()

fn name(e: Errno) -> StrView
    e.name()

fn message(e: Errno) -> StrView
    e.message()

# errno_write's output through a pipe, compared with `want`: errno_write
# takes the raw fd number, so it writes to the pipe's write end by number.
fn written_is(e: Errno, want: StrView) -> bool
    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return false
    let n: i64 = errno_write(p.write.raw(), e)
    p.write.close()
    var got: String = string_new()
    let read: Result<i64, Errno> = p.read.read_to_end(@&got)
    p.read.close()
    read.unwrap_or(-1) == n and got.as_view().eq(want)

[[test]]
fn test_from_raw_named_variants() -> i32
    # Every named variant, by its Linux x86_64 number, round-trips.
    var codes: [21]i32 = [1, 2, 4, 5, 9, 10, 11, 12, 13, 17, 20, 21, 22, 28, 32, 36, 39, 98, 104, 110, 111]
    for i in 0..21
        if errno_from_raw(codes[i]).code() != codes[i]
            return 1 + i as i32
    0

[[test]]
fn test_from_raw_picks_the_variant() -> i32
    match errno_from_raw(2)
        NoEnt => pass
        _ => return 1
    match errno_from_raw(17)
        Exist => pass
        _ => return 2
    match errno_from_raw(36)
        NameTooLong => pass
        _ => return 3
    0

[[test]]
fn test_from_raw_accepts_negated_syscall_return() -> i32
    match errno_from_raw(-13)
        Acces => pass
        _ => return 1
    if errno_from_raw(-95).code() != 95
        return 2
    0

[[test]]
fn test_other_keeps_the_number() -> i32
    match errno_from_raw(95)
        Other(n) =>
            if n != 95
                return 1
        _ => return 2
    0

[[test]]
fn test_codes_match_sys_consts() -> i32
    if code(Errno.NoEnt) != ENOENT
        return 1
    if code(Errno.Acces) != EACCES
        return 2
    if code(Errno.Exist) != EEXIST
        return 3
    if code(Errno.IsDir) != EISDIR
        return 4
    if code(Errno.NotDir) != ENOTDIR
        return 5
    if code(Errno.Inval) != EINVAL
        return 6
    if code(Errno.Io) != EIO
        return 7
    if code(Errno.NoSpc) != ENOSPC
        return 8
    if code(Errno.BadF) != EBADF
        return 9
    if code(Errno.Intr) != EINTR
        return 10
    if code(Errno.Again) != EAGAIN
        return 11
    if code(Errno.Perm) != EPERM
        return 12
    if code(Errno.NotEmpty) != ENOTEMPTY
        return 13
    if code(Errno.Child) != ECHILD
        return 14
    if code(Errno.NoMem) != ENOMEM
        return 15
    if code(Errno.Pipe) != EPIPE
        return 16
    0

# The variants net.ritz and process.ritz return (AGAST #4298).
[[test]]
fn test_net_and_process_variants() -> i32
    match errno_from_raw(-98)
        AddrInUse => pass
        _ => return 1
    match errno_from_raw(-104)
        ConnReset => pass
        _ => return 2
    match errno_from_raw(-110)
        TimedOut => pass
        _ => return 3
    match errno_from_raw(-111)
        ConnRefused => pass
        _ => return 4
    match errno_from_raw(10)
        Child => pass
        _ => return 5
    match errno_from_raw(12)
        NoMem => pass
        _ => return 6
    match errno_from_raw(32)
        Pipe => pass
        _ => return 7
    if not (name(Errno.ConnRefused)).eq("ECONNREFUSED")
        return 8
    if not (message(Errno.ConnRefused)).eq("Connection refused")
        return 9
    if not (name(Errno.AddrInUse)).eq("EADDRINUSE")
        return 10
    if not (message(Errno.AddrInUse)).eq("Address already in use")
        return 11
    if not (message(Errno.TimedOut)).eq("Connection timed out")
        return 12
    if not (message(Errno.ConnReset)).eq("Connection reset by peer")
        return 13
    if not (message(Errno.Child)).eq("No child processes")
        return 14
    if not (message(Errno.NoMem)).eq("Cannot allocate memory")
        return 15
    if not (message(Errno.Pipe)).eq("Broken pipe")
        return 16
    0

[[test]]
fn test_name() -> i32
    if not (name(Errno.NoEnt)).eq("ENOENT")
        return 1
    if not (name(Errno.NameTooLong)).eq("ENAMETOOLONG")
        return 2
    if not (name(Errno.Other(95))).eq("EUNKNOWN")
        return 3
    0

[[test]]
fn test_message() -> i32
    if not (message(Errno.NoEnt)).eq("No such file or directory")
        return 1
    if not (message(Errno.Acces)).eq("Permission denied")
        return 2
    0

[[test]]
fn test_write_named() -> i32
    if not written_is(Errno.Exist, "File exists")
        return 1
    0

[[test]]
fn test_write_other_appends_number() -> i32
    if not written_is(Errno.Other(95), "Unknown error 95")
        return 1
    0
