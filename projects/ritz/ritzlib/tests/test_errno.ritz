# Tests for ritzlib.errno: the typed kernel error code fs's, net's and
# process's Results carry (AGAST #4248, #4298).

import ritzlib.sys
import ritzlib.errno
import ritzlib.strview
import ritzlib.str
import ritzlib.memory

# ritz1 cannot emit a method call whose receiver is a qualified variant
# literal (`code(Errno.NoEnt)`), so a variant's method is reached through a
# local parameter here.
fn code(e: Errno) -> i32
    e.code()

fn name(e: Errno) -> StrView
    e.name()

fn message(e: Errno) -> StrView
    e.message()

# errno_write's output through a pipe, compared with `want`. 1 if equal.
fn written_is(e: Errno, want: StrView) -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) != 0
        return 0
    let n: i64 = errno_write(fds[1], e)
    sys_close(fds[1])
    var buf: [128]u8
    let got: i64 = sys_read(fds[0], @buf[0], 128)
    sys_close(fds[0])
    if n != got
        return 0
    strview_eq(strview_from_ptr(@buf[0], got), want) as i32

[[test]]
fn test_from_raw_named_variants() -> i32
    # Every named variant, by its Linux x86_64 number, round-trips.
    var codes: [21]i32 = [1, 2, 4, 5, 9, 10, 11, 12, 13, 17, 20, 21, 22, 28, 32, 36, 39, 98, 104, 110, 111]
    for i in 0..21
        if errno_from_raw(codes[i]).code() != codes[i]
            return 1 + i as i32
    0

[[test]]
fn test_from_raw_picks_the_variant() -> i32
    match errno_from_raw(2)
        NoEnt => pass
        _ => return 1
    match errno_from_raw(17)
        Exist => pass
        _ => return 2
    match errno_from_raw(36)
        NameTooLong => pass
        _ => return 3
    0

[[test]]
fn test_from_raw_accepts_negated_syscall_return() -> i32
    match errno_from_raw(-13)
        Acces => pass
        _ => return 1
    if errno_from_raw(-95).code() != 95
        return 2
    0

[[test]]
fn test_other_keeps_the_number() -> i32
    match errno_from_raw(95)
        Other(n) =>
            if n != 95
                return 1
        _ => return 2
    0

[[test]]
fn test_codes_match_sys_consts() -> i32
    if code(Errno.NoEnt) != ENOENT
        return 1
    if code(Errno.Acces) != EACCES
        return 2
    if code(Errno.Exist) != EEXIST
        return 3
    if code(Errno.IsDir) != EISDIR
        return 4
    if code(Errno.NotDir) != ENOTDIR
        return 5
    if code(Errno.Inval) != EINVAL
        return 6
    if code(Errno.Io) != EIO
        return 7
    if code(Errno.NoSpc) != ENOSPC
        return 8
    if code(Errno.BadF) != EBADF
        return 9
    if code(Errno.Intr) != EINTR
        return 10
    if code(Errno.Again) != EAGAIN
        return 11
    if code(Errno.Perm) != EPERM
        return 12
    if code(Errno.NotEmpty) != ENOTEMPTY
        return 13
    if code(Errno.Child) != ECHILD
        return 14
    if code(Errno.NoMem) != ENOMEM
        return 15
    if code(Errno.Pipe) != EPIPE
        return 16
    0

# The variants net.ritz and process.ritz return (AGAST #4298).
[[test]]
fn test_net_and_process_variants() -> i32
    match errno_from_raw(-98)
        AddrInUse => pass
        _ => return 1
    match errno_from_raw(-104)
        ConnReset => pass
        _ => return 2
    match errno_from_raw(-110)
        TimedOut => pass
        _ => return 3
    match errno_from_raw(-111)
        ConnRefused => pass
        _ => return 4
    match errno_from_raw(10)
        Child => pass
        _ => return 5
    match errno_from_raw(12)
        NoMem => pass
        _ => return 6
    match errno_from_raw(32)
        Pipe => pass
        _ => return 7
    if not strview_eq(name(Errno.ConnRefused), "ECONNREFUSED")
        return 8
    if not strview_eq(message(Errno.ConnRefused), "Connection refused")
        return 9
    if not strview_eq(name(Errno.AddrInUse), "EADDRINUSE")
        return 10
    if not strview_eq(message(Errno.AddrInUse), "Address already in use")
        return 11
    if not strview_eq(message(Errno.TimedOut), "Connection timed out")
        return 12
    if not strview_eq(message(Errno.ConnReset), "Connection reset by peer")
        return 13
    if not strview_eq(message(Errno.Child), "No child processes")
        return 14
    if not strview_eq(message(Errno.NoMem), "Cannot allocate memory")
        return 15
    if not strview_eq(message(Errno.Pipe), "Broken pipe")
        return 16
    0

[[test]]
fn test_name() -> i32
    if not strview_eq(name(Errno.NoEnt), "ENOENT")
        return 1
    if not strview_eq(name(Errno.NameTooLong), "ENAMETOOLONG")
        return 2
    if not strview_eq(name(Errno.Other(95)), "EUNKNOWN")
        return 3
    0

[[test]]
fn test_message() -> i32
    if not strview_eq(message(Errno.NoEnt), "No such file or directory")
        return 1
    if not strview_eq(message(Errno.Acces), "Permission denied")
        return 2
    0

[[test]]
fn test_write_named() -> i32
    if written_is(Errno.Exist, "File exists") == 0
        return 1
    0

[[test]]
fn test_write_other_appends_number() -> i32
    if written_is(Errno.Other(95), "Unknown error 95") == 0
        return 1
    0
