# Tests for ritzlib.errno: the typed kernel error code fs's Results carry
# (AGAST #4248).

import ritzlib.sys
import ritzlib.errno
import ritzlib.strview
import ritzlib.str
import ritzlib.memory

# errno_write's output through a pipe, compared with `want`. 1 if equal.
fn written_is(e: Errno, want: StrView) -> i32
    var fds: [2]i32
    if sys_pipe(@fds[0]) != 0
        return 0
    let n: i64 = errno_write(fds[1], e)
    sys_close(fds[1])
    var buf: [128]u8
    let got: i64 = sys_read(fds[0], @buf[0], 128)
    sys_close(fds[0])
    if n != got
        return 0
    strview_eq(strview_from_ptr(@buf[0], got), want) as i32

[[test]]
fn test_from_raw_named_variants() -> i32
    # Every named variant, by its Linux x86_64 number, round-trips.
    var codes: [14]i32 = [1, 2, 4, 5, 9, 11, 13, 17, 20, 21, 22, 28, 36, 39]
    for i in 0..14
        if errno_code(errno_from_raw(codes[i])) != codes[i]
            return 1 + i as i32
    0

[[test]]
fn test_from_raw_picks_the_variant() -> i32
    match errno_from_raw(2)
        NoEnt => pass
        _ => return 1
    match errno_from_raw(17)
        Exist => pass
        _ => return 2
    match errno_from_raw(36)
        NameTooLong => pass
        _ => return 3
    0

[[test]]
fn test_from_raw_accepts_negated_syscall_return() -> i32
    match errno_from_raw(-13)
        Acces => pass
        _ => return 1
    if errno_code(errno_from_raw(-95)) != 95
        return 2
    0

[[test]]
fn test_other_keeps_the_number() -> i32
    match errno_from_raw(95)
        Other(n) =>
            if n != 95
                return 1
        _ => return 2
    0

[[test]]
fn test_codes_match_sys_consts() -> i32
    if errno_code(Errno.NoEnt) != ENOENT
        return 1
    if errno_code(Errno.Acces) != EACCES
        return 2
    if errno_code(Errno.Exist) != EEXIST
        return 3
    if errno_code(Errno.IsDir) != EISDIR
        return 4
    if errno_code(Errno.NotDir) != ENOTDIR
        return 5
    if errno_code(Errno.Inval) != EINVAL
        return 6
    if errno_code(Errno.Io) != EIO
        return 7
    if errno_code(Errno.NoSpc) != ENOSPC
        return 8
    if errno_code(Errno.BadF) != EBADF
        return 9
    if errno_code(Errno.Intr) != EINTR
        return 10
    if errno_code(Errno.Again) != EAGAIN
        return 11
    if errno_code(Errno.Perm) != EPERM
        return 12
    if errno_code(Errno.NotEmpty) != ENOTEMPTY
        return 13
    0

[[test]]
fn test_name() -> i32
    if not strview_eq(errno_name(Errno.NoEnt), "ENOENT")
        return 1
    if not strview_eq(errno_name(Errno.NameTooLong), "ENAMETOOLONG")
        return 2
    if not strview_eq(errno_name(Errno.Other(95)), "EUNKNOWN")
        return 3
    0

[[test]]
fn test_message() -> i32
    if not strview_eq(errno_message(Errno.NoEnt), "No such file or directory")
        return 1
    if not strview_eq(errno_message(Errno.Acces), "Permission denied")
        return 2
    0

[[test]]
fn test_write_named() -> i32
    if written_is(Errno.Exist, "File exists") == 0
        return 1
    0

[[test]]
fn test_write_other_appends_number() -> i32
    if written_is(Errno.Other(95), "Unknown error 95") == 0
        return 1
    0
