# Timer elapsed-time accessors with fixed start/end values (AGAST #4613).
#
# The start and end Timespecs are set directly, without calling the clock or
# sleeping, so each accessor has an exact expected value.
# elapsed_secs_x1000 returned elapsed_micros() until #4613; it now returns
# seconds x1000, which is the same value as elapsed_millis().

import ritzlib.errno
import ritzlib.timer

# start = 1.500000000 s, end = 3.750123456 s: elapsed 2.250123456 s.
fn fixed_timer() -> Timer
    var t: Timer = timer_new()
    t.start.tv_sec = 1
    t.start.tv_nsec = 500000000
    t.end.tv_sec = 3
    t.end.tv_nsec = 750123456
    t

[[test]]
fn test_timer_elapsed_units() -> i32
    var t: Timer = fixed_timer()
    assert t.elapsed_nanos() == 2250123456
    assert t.elapsed_micros() == 2250123
    assert t.elapsed_millis() == 2250
    0

[[test]]
fn test_timer_elapsed_secs_x1000() -> i32
    var t: Timer = fixed_timer()
    assert t.elapsed_secs_x1000() == 2250
    # Under one millisecond rounds down to 0.
    t = timer_new()
    t.end.tv_nsec = 999999
    assert t.elapsed_secs_x1000() == 0
    0

# AGAST #4930: the clock and the Timer report through Result, not a status.

[[test]]
fn test_timer_new_is_zeroed() -> i32
    let t: Timer = timer_new()
    assert t.start.tv_sec == 0 and t.start.tv_nsec == 0
    assert t.end.tv_sec == 0 and t.end.tv_nsec == 0
    assert t.elapsed_nanos() == 0
    0

[[test]]
fn test_clock_gettime_returns_the_time() -> i32
    let r: Result<Timespec, Errno> = clock_gettime(CLOCK_MONOTONIC)
    assert r.is_ok()
    let ts: Timespec = r.unwrap_or(Timespec { tv_sec: -1, tv_nsec: -1 })
    assert ts.tv_nsec >= 0 and ts.tv_nsec < NANOS_PER_SEC
    assert ts.tv_sec > 0 or ts.tv_nsec > 0
    0

[[test]]
fn test_clock_gettime_bad_clock_is_einval() -> i32
    var code: i32 = 0
    match clock_gettime(-99)
        Ok(_) => code = 0
        Err(e) => code = e.code()
    assert code == 22
    0

[[test]]
fn test_timer_start_stop_are_ok() -> i32
    var t: Timer = timer_new()
    assert t.start().is_ok()
    assert t.stop().is_ok()
    assert t.elapsed_nanos() >= 0
    0

[[test]]
fn test_stopwatch_new_and_reset() -> i32
    var sw: Stopwatch = stopwatch_new()
    assert sw.count() == 0 and sw.total_nanos() == 0
    assert sw.start()
    assert sw.stop()
    assert sw.count() == 1
    sw.reset()
    assert sw.count() == 0 and sw.total_nanos() == 0
    0
