# ritzlib.time: Duration, sleep and the wall clock (AGAST #4637).
#
#   duration_ns / duration_us / duration_ms / duration_secs(n) -> Duration
#   Duration.as_nanos / as_micros / as_millis / as_secs() -> i64
#   sleep(d: Duration), sleep_ms(ms: i64)
#   now() -> Timeval                       wall clock (gettimeofday)
#   now_unix_ms() -> i64                   the same, in milliseconds
#
# Elapsed time is measured with ritzlib.timer's monotonic now_nanos.

import ritzlib.sys
import ritzlib.time
import ritzlib.timer

[[test]]
fn test_duration_constructors_agree() -> i32
    assert duration_secs(2).as_nanos() == 2000000000
    assert duration_ms(1500).as_nanos() == 1500000000
    assert duration_us(7).as_nanos() == 7000
    assert duration_ns(42).as_nanos() == 42
    assert duration_ms(1500).as_secs() == 1
    assert duration_ms(1500).as_millis() == 1500
    assert duration_us(2500).as_millis() == 2
    assert duration_ns(2500).as_micros() == 2
    0

[[test]]
fn test_sleep_ms_waits_at_least_that_long() -> i32
    let t0: i64 = now_nanos()
    sleep_ms(30)
    assert now_nanos() - t0 >= 30000000
    0

[[test]]
fn test_sleep_duration_over_a_second_boundary() -> i32
    # 1.005 s exercises the seconds field of the timespec, not just nanos.
    let t0: i64 = now_nanos()
    sleep(duration_ms(1005))
    let dt: i64 = now_nanos() - t0
    assert dt >= 1005000000
    assert dt < 5000000000
    0

[[test]]
fn test_sleep_zero_and_negative_return_at_once() -> i32
    let t0: i64 = now_nanos()
    sleep(duration_ns(0))
    sleep_ms(-5)
    assert now_nanos() - t0 < 1000000000
    0

[[test]]
fn test_now_is_after_2020_and_ms_agrees() -> i32
    let tv: Timeval = now()
    # 2020-01-01T00:00:00Z = 1577836800.
    assert tv.tv_sec > 1577836800
    assert tv.tv_usec >= 0
    assert tv.tv_usec < 1000000
    let ms: i64 = now_unix_ms()
    assert ms >= tv.tv_sec * 1000
    assert ms < (tv.tv_sec + 60) * 1000
    0
