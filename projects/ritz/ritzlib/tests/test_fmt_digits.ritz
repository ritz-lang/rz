# Tests for ritzlib/fmt/digits.ritz.
#
# AGAST #4685: each routine takes a `[u8]` and returns a StrView of its
# digits (it took a bare `*u8` and returned a count). `upper` is a bool
# (AGAST #4639; it was an i32 flag). A too-short span traps: that is
# tools/test_fmt_digits_trap.py, since a trap ends the test binary.

import ritzlib.fmt.digits
import ritzlib.strview

[[test]]
fn test_radix_upper_and_lower() -> i32
    var buf: [64]u8
    assert fmt_u64_radix_into(@buf, 0xbeef as u64, 16, true).eq("BEEF")
    assert fmt_u64_radix_into(@buf, 0xbeef as u64, 16, false).eq("beef")
    0

[[test]]
fn test_radix_binary_and_zero() -> i32
    var buf: [64]u8
    assert fmt_u64_radix_into(@buf, 5, 2, false).eq("101")
    assert fmt_u64_radix_into(@buf, 0, 8, true).eq("0")
    0

[[test]]
fn test_radix_u64_max_in_base_2_fills_64() -> i32
    var buf: [64]u8
    let d: StrView = fmt_u64_radix_into(@buf, 0 -% (1 as u64), 2, false)
    assert d.len == 64
    assert d.ptr == @buf[0]
    0

[[test]]
fn test_i64_view_is_the_digits() -> i32
    var buf: [20]u8
    let d: StrView = fmt_i64_into(@buf, 1234)
    assert d.eq("1234")
    assert d.ptr == @buf[0]
    assert fmt_i64_into(@buf, 0).eq("0")
    assert fmt_i64_into(@buf, -7).eq("-7")
    0

[[test]]
fn test_i64_extremes_fit_20() -> i32
    var buf: [20]u8
    let lo: i64 = 0 - 9223372036854775807 - 1
    assert fmt_i64_into(@buf, lo).eq("-9223372036854775808")
    assert fmt_i64_into(@buf, 9223372036854775807).eq("9223372036854775807")
    0

[[test]]
fn test_u64_max_fits_20() -> i32
    var buf: [20]u8
    assert fmt_u64_into(@buf, 0 -% (1 as u64)).eq("18446744073709551615")
    assert fmt_u64_into(@buf, 42).eq("42")
    0

[[test]]
fn test_hex_lower_no_prefix() -> i32
    var buf: [16]u8
    assert fmt_u64_hex_into(@buf, 0xdeadbeef as u64).eq("deadbeef")
    assert fmt_u64_hex_into(@buf, 0).eq("0")
    assert fmt_u64_hex_into(@buf, 0 -% (1 as u64)).eq("ffffffffffffffff")
    0

[[test]]
fn test_larger_span_writes_from_its_start() -> i32
    var buf: [32]u8 = [120; 32]   # 'x'
    let d: StrView = fmt_i64_into(@buf, -55)
    assert d.eq("-55")
    assert buf[3] == 120           # nothing past the digits
    0
