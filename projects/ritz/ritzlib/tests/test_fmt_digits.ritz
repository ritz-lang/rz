# Tests for ritzlib/fmt/digits.ritz's radix writer: `upper` is a bool
# (AGAST #4639; it was an i32 flag).

import ritzlib.fmt.digits
import ritzlib.strview

[[test]]
fn test_radix_upper_and_lower() -> i32
    var buf: [64]u8
    let n: i64 = fmt_u64_radix_into(@buf[0], 0xbeef as u64, 16, true)
    assert strview_from_ptr(@buf[0], n).eq("BEEF")
    let m: i64 = fmt_u64_radix_into(@buf[0], 0xbeef as u64, 16, false)
    assert strview_from_ptr(@buf[0], m).eq("beef")
    0

[[test]]
fn test_radix_binary_and_zero() -> i32
    var buf: [64]u8
    let n: i64 = fmt_u64_radix_into(@buf[0], 5, 2, false)
    assert strview_from_ptr(@buf[0], n).eq("101")
    let z: i64 = fmt_u64_radix_into(@buf[0], 0, 8, true)
    assert strview_from_ptr(@buf[0], z).eq("0")
    0
