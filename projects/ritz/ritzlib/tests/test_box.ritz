# ritzlib/tests/test_box.ritz - Box<T> owns its value: dropping the Box drops it

import ritzlib.box
import ritzlib.gvec

var g_drops: i32 = 0

struct Tracked
    id: i32

impl Drop for Tracked
    fn drop(self: @&Tracked)
        g_drops += 1

# No Drop of its own: dropped by dropping its move-only parts.
struct Parts
    t: Tracked
    v: Vec<i64>

fn boxed_parts(id: i32) -> Box<Parts>
    var v: Vec<i64> = vec_new<i64>()
    v.push(id as i64)
    box_new<Parts>(Parts { t: Tracked { id: id }, v: v })

fn consume(b: Box<Tracked>) -> i32
    b.id

[[test]]
fn test_box_drops_its_value_at_scope_end() -> i32
    g_drops = 0
    if true
        let b: Box<Tracked> = box_new<Tracked>(Tracked { id: 1 })
        assert b.id == 1
        assert g_drops == 0
    assert g_drops == 1
    0

[[test]]
fn test_box_drops_the_parts_of_its_value() -> i32
    g_drops = 0
    if true
        let b: Box<Parts> = boxed_parts(4)
        # Bound first: ritz1 resolves `b.v.get` at Box<Parts> (AGAST #4778).
        let v: @Vec<i64> = @b.v
        assert v.len() == 1
        assert v.get(0) == 4
    assert g_drops == 1
    0

[[test]]
fn test_box_explicit_drop_then_scope_end_drops_once() -> i32
    g_drops = 0
    if true
        var b: Box<Tracked> = box_new<Tracked>(Tracked { id: 2 })
        b.drop()
        assert g_drops == 1
        assert not b.valid()
    assert g_drops == 1
    0

[[test]]
fn test_moved_box_drops_in_its_new_owner_only() -> i32
    g_drops = 0
    if true
        let b: Box<Tracked> = box_new<Tracked>(Tracked { id: 3 })
        assert consume(b) == 3
        assert g_drops == 1
    assert g_drops == 1
    0

[[test]]
fn test_empty_box_drops_nothing_until_it_holds_a_value() -> i32
    g_drops = 0
    if true
        var b: Box<Tracked> = box_empty<Tracked>()
        assert not b.valid()
        b = box_new<Tracked>(Tracked { id: 5 })
        assert b.valid()
        assert b.id == 5
        assert g_drops == 0
    assert g_drops == 1
    0
