# Test suite for ritzlib/memory.ritz
#
# Tests the Arena allocator and heap functions.
# Run with: python3 ritz0/ritz0.py --test ritzlib/tests/test_memory.ritz

import ritzlib.memory
import ritzlib.sys
import ritzlib.string
import ritzlib.str

# ============================================================================
# Arena Tests
# ============================================================================

[[test]]
fn test_arena_new() -> i32
    var a: Arena = arena_new(4096)
    assert arena_valid(@a) == 1
    assert arena_used(@a) == 0
    assert arena_remaining(@a) == 4096
    arena_destroy(@a)
    0

[[test]]
fn test_arena_default() -> i32
    var a: Arena = arena_default()
    assert arena_valid(@a) == 1
    assert a.size == 1048576  # 1 MB
    arena_destroy(@a)
    0

[[test]]
fn test_arena_alloc() -> i32
    var a: Arena = arena_new(4096)

    # Allocate 100 bytes
    let p1: *u8 = arena_alloc(@a, 100)
    assert p1 != null
    # 100 bytes rounds up to 104 (aligned to 8)
    assert arena_used(@a) == 104

    # Allocate another 50 bytes
    let p2: *u8 = arena_alloc(@a, 50)
    assert p2 != null
    # 50 rounds to 56, total 160
    assert arena_used(@a) == 160

    # Pointers should be different
    assert p1 != p2

    arena_destroy(@a)
    0

[[test]]
fn test_arena_alloc_zero() -> i32
    var a: Arena = arena_new(4096)

    let p: *u8 = arena_alloc_zero(@a, 16)
    assert p != null

    # Verify all bytes are zero
    for i in 0..16
        assert *(p + i) == 0

    arena_destroy(@a)
    0

[[test]]
fn test_arena_alloc_array() -> i32
    var a: Arena = arena_new(4096)

    # Allocate array of 10 i64s (80 bytes)
    let arr: *i64 = arena_alloc_array(@a, 10, 8) as *i64
    assert arr != null
    assert arena_used(@a) == 80

    # Write to the array
    for i in 0..10
        *(arr + i) = i * 10

    # Read back
    assert *(arr + 0) == 0
    assert *(arr + 5) == 50
    assert *(arr + 9) == 'Z'

    arena_destroy(@a)
    0

[[test]]
fn test_arena_reset() -> i32
    var a: Arena = arena_new(4096)

    # Allocate some memory
    arena_alloc(@a, 100)
    arena_alloc(@a, 200)
    assert arena_used(@a) > 0

    # Reset
    arena_reset(@a)
    assert arena_used(@a) == 0
    assert arena_remaining(@a) == 4096

    # Can allocate again
    let p: *u8 = arena_alloc(@a, 50)
    assert p != null
    assert arena_used(@a) == 56

    arena_destroy(@a)
    0

[[test]]
fn test_arena_exhaustion() -> i32
    var a: Arena = arena_new(128)

    # Allocate most of the arena
    let p1: *u8 = arena_alloc(@a, 100)
    assert p1 != null

    # Try to allocate more than remaining (should fail)
    let p2: *u8 = arena_alloc(@a, 100)
    assert p2 == null

    arena_destroy(@a)
    0

# ============================================================================
# Heap Tests
# ============================================================================

[[test]]
fn test_heap_alloc_free() -> i32
    let size: i64 = 1024
    let p: *u8 = heap_alloc(size)
    assert p != null

    # Write some data
    *p = 42
    *(p + 1) = 43
    assert *p == 42
    assert *(p + 1) == 43

    # Free it
    let result: i32 = heap_free(p, size)
    assert result == 0
    0

[[test]]
fn test_heap_realloc() -> i32
    let old_size: i64 = 64
    let new_size: i64 = 128

    # Allocate initial buffer
    let p1: *u8 = heap_alloc(old_size)
    assert p1 != null

    # Write some data
    for i in 0..old_size
        *(p1 + i) = (i % 256) as u8

    # Reallocate to larger size
    let p2: *u8 = heap_realloc(p1, old_size, new_size)
    assert p2 != null

    # Verify data preserved
    for i in 0..old_size
        assert *(p2 + i) == (i % 256) as u8

    heap_free(p2, new_size)
    0

# ============================================================================
# Memory Utility Tests
# ============================================================================

[[test]]
fn test_memcpy() -> i32
    var src: [16]u8
    var dst: [16]u8

    # Initialize source
    for i in 0..16
        src[i] = (i + 1) as u8
        dst[i] = 0

    # Copy
    memcpy(@dst[0], @src[0], 16)

    # Verify
    for i in 0..16
        assert dst[i] == (i + 1) as u8
    0

[[test]]
fn test_memset() -> i32
    var buf: [16]u8

    # Set all to 42
    memset(@buf[0], 42, 16)

    # Verify
    for i in 0..16
        assert buf[i] == 42
    0

[[test]]
fn test_memzero() -> i32
    var buf: [16]u8

    # Initialize with non-zero
    for i in 0..16
        buf[i] = 0xFF as u8

    # Zero it
    memzero(@buf[0], 16)

    # Verify
    for i in 0..16
        assert buf[i] == 0
    0

[[test]]
fn test_memcmp_equal() -> i32
    var a: [8]u8
    var b: [8]u8

    for i in 0..8
        a[i] = (i + 10) as u8
        b[i] = (i + 10) as u8

    assert memcmp(@a[0], @b[0], 8) == 0
    0

[[test]]
fn test_memcmp_less() -> i32
    var a: [8]u8
    var b: [8]u8

    for i in 0..8
        a[i] = (i + 10) as u8
        b[i] = (i + 10) as u8

    # Make a < b at position 4
    a[4] = 0
    b[4] = 100

    assert memcmp(@a[0], @b[0], 8) < 0
    0

[[test]]
fn test_memcmp_greater() -> i32
    var a: [8]u8
    var b: [8]u8

    for i in 0..8
        a[i] = (i + 10) as u8
        b[i] = (i + 10) as u8

    # Make a > b at position 4
    a[4] = 100
    b[4] = 0

    assert memcmp(@a[0], @b[0], 8) > 0
    0

# ----------------------------------------------------------------------------
# bcmp / memmove
#
# LLVM is entitled to synthesize calls to a small set of libc primitives even
# when the source never names them. At -O2 it rewrites `memcmp(a,b,n) == 0`
# into `bcmp`, and lowers overlapping copies to `memmove`. Ritz links
# freestanding, so ritzlib IS the libc for these — if we do not define them the
# failure surfaces as a link error (`undefined reference to 'bcmp'`), which is
# exactly how bootstrap stage 2 broke while building ritz1.
# ----------------------------------------------------------------------------

[[test]]
fn test_bcmp_equal() -> i32
    var a: [8]u8
    var b: [8]u8

    for i in 0..8
        a[i] = (i + 10) as u8
        b[i] = (i + 10) as u8

    assert bcmp(@a[0], @b[0], 8) == 0
    0

[[test]]
fn test_bcmp_differs() -> i32
    var a: [8]u8
    var b: [8]u8

    for i in 0..8
        a[i] = (i + 10) as u8
        b[i] = (i + 10) as u8

    # bcmp reports "differs", not ordering — only zero/non-zero is meaningful.
    b[4] = 99
    assert bcmp(@a[0], @b[0], 8) != 0

    # A difference past the compared length must not be observed.
    assert bcmp(@a[0], @b[0], 4) == 0
    0

[[test]]
fn test_bcmp_zero_length() -> i32
    var a: [4]u8
    var b: [4]u8
    a[0] = 1
    b[0] = 2

    # Zero-length compares are equal regardless of contents.
    assert bcmp(@a[0], @b[0], 0) == 0
    0

[[test]]
fn test_memmove_no_overlap() -> i32
    var src: [16]u8
    var dst: [16]u8

    for i in 0..16
        src[i] = (i + 1) as u8
        dst[i] = 0

    memmove(@dst[0], @src[0], 16)

    for i in 0..16
        assert dst[i] == (i + 1) as u8
    0

[[test]]
fn test_memmove_overlap_forward() -> i32
    # dst > src: a naive forward copy clobbers bytes it has yet to read.
    var buf: [16]u8
    for i in 0..16
        buf[i] = (i + 1) as u8

    # Shift [0..8) up by 4 -> buf[4..12) should become 1,2,3,4,5,6,7,8
    memmove(@buf[4], @buf[0], 8)

    for i in 0..8
        assert buf[4 + i] == (i + 1) as u8
    # Bytes below the destination are untouched.
    assert buf[0] == 1
    assert buf[1] == 2
    assert buf[2] == 3
    assert buf[3] == 4
    0

[[test]]
fn test_memmove_overlap_backward() -> i32
    # dst < src: the forward direction is the safe one here.
    var buf: [16]u8
    for i in 0..16
        buf[i] = (i + 1) as u8

    # Shift [4..12) down by 4 -> buf[0..8) should become 5,6,7,8,9,10,11,12
    memmove(@buf[0], @buf[4], 8)

    for i in 0..8
        assert buf[i] == (i + 5) as u8
    0

[[test]]
fn test_memmove_same_pointer() -> i32
    var buf: [8]u8
    for i in 0..8
        buf[i] = (i + 1) as u8

    memmove(@buf[0], @buf[0], 8)

    for i in 0..8
        assert buf[i] == (i + 1) as u8
    0

# ============================================================================
# Struct Allocation Tests
# ============================================================================

struct TestStruct
    x: i32
    y: i32
    ptr: *u8

[[test]]
fn test_arena_alloc_struct() -> i32
    var a: Arena = arena_new(4096)

    # Allocate a struct (12 bytes, rounds to 16)
    let s: *TestStruct = arena_alloc(@a, 24) as *TestStruct
    assert s != null

    # Set fields
    s.x = 10
    s.y = 20
    s.ptr = null

    assert s.x == '\n'
    assert s.y == 20

    arena_destroy(@a)
    0

[[test]]
fn test_arena_multiple_structs() -> i32
    var a: Arena = arena_new(4096)

    # Allocate several structs
    let s1: *TestStruct = arena_alloc(@a, 24) as *TestStruct
    let s2: *TestStruct = arena_alloc(@a, 24) as *TestStruct
    let s3: *TestStruct = arena_alloc(@a, 24) as *TestStruct

    assert s1 != null
    assert s2 != null
    assert s3 != null

    # They should be distinct
    assert s1 != s2
    assert s2 != s3

    # Set values
    s1.x = 1
    s2.x = 2
    s3.x = 3

    # Verify no overlap
    assert s1.x == 1
    assert s2.x == 2
    assert s3.x == 3

    arena_destroy(@a)
    0

# ============================================================================
# jemalloc-style Allocator Tests (malloc/free/realloc)
# ============================================================================

[[test]]
fn test_malloc_small() -> i32
    # Test small allocations in different size classes
    let p1: *u8 = malloc(8)     # Class 0
    let p2: *u8 = malloc(16)    # Class 0
    let p3: *u8 = malloc(32)    # Class 1
    let p4: *u8 = malloc(64)    # Class 2
    let p5: *u8 = malloc(128)   # Class 3
    let p6: *u8 = malloc(256)   # Class 4
    let p7: *u8 = malloc(512)   # Class 5
    let p8: *u8 = malloc(1024)  # Class 6
    let p9: *u8 = malloc(2048)  # Class 7

    assert p1 != null
    assert p2 != null
    assert p3 != null
    assert p4 != null
    assert p5 != null
    assert p6 != null
    assert p7 != null
    assert p8 != null
    assert p9 != null

    # All pointers should be different
    assert p1 != p2
    assert p2 != p3
    assert p3 != p4

    free(p1)
    free(p2)
    free(p3)
    free(p4)
    free(p5)
    free(p6)
    free(p7)
    free(p8)
    free(p9)
    0

[[test]]
fn test_malloc_large() -> i32
    # Test large allocation (>2048 bytes, goes to mmap)
    let p: *u8 = malloc(8192)
    assert p != null

    # Write to verify it's usable
    *p = 42
    *(p + 8191) = 99
    assert *p == 42
    assert *(p + 8191) == 'c'

    free(p)
    0

[[test]]
fn test_malloc_large_header() -> i32
    # AGAST #1983: a large block's header holds 0 - mmap_size, where
    # mmap_size = (size + HEADER_SIZE) rounded up to whole pages.
    # malloc(8192) needs 8192 + 16 = 8208 bytes -> 3 pages -> -12288.
    let p: *u8 = malloc(8192)
    assert p != null
    let h: i64 = *((p as i64 - 16) as *i64)
    assert h == -12288
    free(p)
    0

[[test]]
fn test_realloc_large_grow_moves() -> i32
    # AGAST #1983: growing a large (mmap) block past its mapping must return a
    # new block, preserve the contents, and give a fully writable new size.
    let p: *u8 = malloc(8192)
    assert p != null
    for i in 0..8192
        *(p + i) = (i % 251) as u8

    let q: *u8 = realloc(p, 16384)
    assert q != null
    assert (p as i64) != (q as i64)
    # 16384 + 16 -> 5 pages
    let h: i64 = *((q as i64 - 16) as *i64)
    assert h == -20480

    for i in 0..8192
        assert *(q + i) == (i % 251) as u8
    *(q + 16383) = 7
    assert *(q + 16383) == 7

    free(q)
    0

# Linux mmap reports failure as -errno (e.g. -ENOMEM = -12), not just -1.
# 2^60 bytes cannot be mapped, so each allocator must report failure as null
# instead of handing back a small bogus address. AGAST #1983 found that the
# `== -1` checks missed every real failure.
fn unmappable_size() -> i64
    1152921504606846976

[[test]]
fn test_malloc_mmap_failure_returns_null() -> i32
    let p: *u8 = malloc(unmappable_size())
    assert p == null
    0

[[test]]
fn test_malloc_size_overflow_returns_null() -> i32
    # size + header + page rounding must not wrap to a small mapping
    let p: *u8 = malloc(9223372036854775807)
    assert p == null
    0

[[test]]
fn test_realloc_mmap_failure_keeps_block() -> i32
    let p: *u8 = malloc(8192)
    assert p != null
    *p = 5
    let q: *u8 = realloc(p, unmappable_size())
    assert q == null
    # The old block is untouched and still owned by the caller.
    assert *p == 5
    free(p)
    0

[[test]]
fn test_arena_mmap_failure_has_null_base() -> i32
    var a: Arena = arena_new(unmappable_size())
    assert a.base == null
    assert a.size == 0
    0

[[test]]
fn test_heap_alloc_mmap_failure_returns_null() -> i32
    let p: *u8 = heap_alloc(unmappable_size())
    assert p == null
    0

# AGAST #3551: no user mapping is at 0 or at a negative address (that half of
# the address space is the kernel's), so either is a failed mmap, whatever the
# errno: harland returns -12/-22/-3, Linux anything in [-4095, -1].
[[test]]
fn test_mmap_failed_on_zero_and_negative() -> i32
    assert mmap_failed(null)
    assert mmap_failed(-1 as *u8)
    assert mmap_failed(-12 as *u8)
    assert mmap_failed(-4095 as *u8)
    assert mmap_failed(-4096 as *u8)
    assert mmap_failed(-9223372036854775807 as *u8)
    0

[[test]]
fn test_mmap_failed_false_for_a_mapping() -> i32
    let p: *u8 = sys_mmap_anon(4096)
    assert not mmap_failed(p)
    assert not mmap_failed(1 as *u8)
    sys_munmap(p, 4096)
    0

# AGAST #3551: string_as_ptr NUL-terminates in place, which needs one byte
# past len. When that reserve fails it must not write anyway: rzsh's first
# string_as_ptr on an empty word, after a failed slab mmap on harland, wrote
# the NUL through a null data pointer (CR2 0). Here a String whose next
# growth asks for 2^60 bytes stands in for an exhausted heap.
[[test]]
fn test_string_as_ptr_failed_reserve_returns_null_without_writing() -> i32
    var s: String = string_new()
    s.data.data = null
    s.data.len = 576460752303423488   # 2^59: growth doubles cap to 2^60
    s.data.cap = 576460752303423488
    let p: *u8 = string_as_ptr(@&s)
    assert p == null
    assert s.data.data == null
    assert s.data.len == 576460752303423488
    0

# The case rzsh hit: an empty String (an empty quoted word) whose first
# reserve is a small malloc, i.e. a 64 KiB slab mmap, that fails. With the
# address-space limit at 1 byte every new mapping fails with -ENOMEM in this
# test's own (forked) process; the limit is restored before returning.
const RLIMIT_AS: i64 = 9

struct RLimit
    cur: i64
    max: i64

[[test]]
fn test_string_as_ptr_of_empty_string_when_malloc_fails() -> i32
    var old: RLimit = RLimit { cur: 0, max: 0 }
    assert syscall4(SYS_PRLIMIT64, 0, RLIMIT_AS, 0, @old as i64) == 0
    var tight: RLimit = RLimit { cur: 1, max: old.max }
    assert syscall4(SYS_PRLIMIT64, 0, RLIMIT_AS, @tight as i64, 0) == 0

    # Precondition: small mallocs really fail (no bin has a slab yet).
    let m: *u8 = malloc(16)
    var s: String = string_new()
    let p: *u8 = string_as_ptr(@&s)
    let pushed: bool = string_push(@&s, 65)

    syscall4(SYS_PRLIMIT64, 0, RLIMIT_AS, @old as i64, 0)
    assert m == null
    # A readable "", and nothing written through the null data pointer.
    assert p != null
    assert *p == 0
    assert s.data.data == null
    assert not pushed
    assert string_len(@s) == 0
    0

[[test]]
fn test_malloc_write_read() -> i32
    # Allocate and write data
    let p: *u8 = malloc(100)
    assert p != null

    for i in 0..100
        *(p + i) = (i % 256) as u8

    # Read back
    for i in 0..100
        assert *(p + i) == (i % 256) as u8

    free(p)
    0

[[test]]
fn test_free_and_reuse() -> i32
    # Allocate, free, allocate again - should reuse
    let p1: *u8 = malloc(32)
    assert p1 != null
    *p1 = 10

    free(p1)

    # Allocate same size - might get same block from free list
    let p2: *u8 = malloc(32)
    assert p2 != null

    # Write new value
    *p2 = 20
    assert *p2 == 20

    free(p2)
    0

[[test]]
fn test_calloc() -> i32
    let p: *u8 = calloc(10, 10)  # 100 bytes, zero-initialized
    assert p != null

    # Verify all zeros
    for i in 0..100
        assert *(p + i) == 0

    free(p)
    0

# AGAST #1857: count * size wrapped. (2^61 + 1) * 8 is 2^64 + 8, i.e. 8, so
# calloc handed back an 8-byte block for a 16 EiB request.
[[test]]
fn test_calloc_overflow_returns_null() -> i32
    assert calloc(2305843009213693953, 8) == null
    assert calloc(8, 2305843009213693953) == null
    assert calloc(-1, 8) == null
    assert calloc(8, -1) == null
    0

# ============================================================================
# Page source (AGAST #1857)
# ============================================================================
# Every allocator in ritzlib.memory gets its pages from one PageSource, which a
# kernel (or a test) can install in place of the mmap default. One whose map
# answers -ENOMEM (-12), as Linux and harland both do, makes each allocator
# return null; a working one serves (and gets back) every page.

var g_src_maps: i32 = 0
var g_src_unmaps: i32 = 0

fn enomem_map(len: i64) -> *u8
    g_src_maps += 1
    return -12 as *u8

fn counting_map(len: i64) -> *u8
    g_src_maps += 1
    return sys_mmap_anon(len)

fn counting_unmap(p: *u8, len: i64) -> i32
    g_src_unmaps += 1
    return sys_munmap(p, len)

[[test]]
fn test_page_source_enomem_makes_every_allocator_return_null() -> i32
    let prev: PageSource = page_source_set(PageSource { map: enomem_map, unmap: counting_unmap })
    # Class 6 (1040-byte blocks) may hold a slab, or freed blocks, from before
    # this test: take blocks until the bin needs a new slab. 64 KiB is 63
    # blocks, so 200 tries always get there.
    var held: [200]*u8
    var n: i32 = 0
    var small: *u8 = malloc(1000)
    while small != null and n < 200
        held[n] = small
        n += 1
        small = malloc(1000)
    let large: *u8 = malloc(8192)
    let zeroed: *u8 = calloc(4, 1024)
    let h: *u8 = heap_alloc(4096)
    var a: Arena = arena_new(4096)
    let maps: i32 = g_src_maps
    page_source_set(prev)
    for i in 0..n
        free(held[i])

    assert small == null
    assert large == null
    assert zeroed == null
    assert h == null
    assert a.base == null
    # Each one asked the installed source, not mmap.
    assert maps == 5
    0

[[test]]
fn test_page_source_serves_and_takes_back_pages() -> i32
    let prev: PageSource = page_source_set(PageSource { map: counting_map, unmap: counting_unmap })
    let p: *u8 = malloc(8192)
    assert p != null
    *(p + 8191) = 9
    assert *(p + 8191) == 9
    free(p)
    var a: Arena = arena_new(4096)
    assert a.base != null
    arena_destroy(@a)
    let maps: i32 = g_src_maps
    let unmaps: i32 = g_src_unmaps
    page_source_set(prev)

    assert maps == 2
    assert unmaps == 2
    0

[[test]]
fn test_page_source_set_returns_the_previous_source() -> i32
    let first: PageSource = page_source_set(PageSource { map: enomem_map, unmap: counting_unmap })
    let mine: PageSource = page_source_set(first)
    # The default (mmap) source is back: allocation works again.
    let p: *u8 = malloc(8192)
    assert p != null
    free(p)
    # And what came back out is the one installed.
    let f: fn(i64) -> *u8 = mine.map
    let before: i32 = g_src_maps
    f(4096)
    assert g_src_maps == before + 1
    0

[[test]]
fn test_realloc_grow() -> i32
    # Start small
    let p1: *u8 = malloc(16)
    assert p1 != null

    # Write data
    for i in 0..16
        *(p1 + i) = (i + 1) as u8

    # Grow to larger size class
    let p2: *u8 = realloc(p1, 100)
    assert p2 != null

    # Verify data preserved
    for i in 0..16
        assert *(p2 + i) == (i + 1) as u8

    free(p2)
    0

[[test]]
fn test_realloc_shrink() -> i32
    # Start larger
    let p1: *u8 = malloc(256)
    assert p1 != null

    # Write data
    for i in 0..256
        *(p1 + i) = (i % 256) as u8

    # Shrink
    let p2: *u8 = realloc(p1, 32)
    assert p2 != null

    # Verify data preserved (first 32 bytes)
    for i in 0..32
        assert *(p2 + i) == (i % 256) as u8

    free(p2)
    0

[[test]]
fn test_realloc_null() -> i32
    # realloc(NULL, size) should behave like malloc
    let p: *u8 = realloc(null, 64)
    assert p != null

    *p = 42
    assert *p == 42

    free(p)
    0

[[test]]
fn test_realloc_zero() -> i32
    # realloc(ptr, 0) should free and return NULL
    let p1: *u8 = malloc(64)
    assert p1 != null

    let p2: *u8 = realloc(p1, 0)
    assert p2 == null
    # p1 has been freed
    0

[[test]]
fn test_free_null() -> i32
    # free(NULL) should be a no-op
    free(null)
    0

[[test]]
fn test_many_allocations() -> i32
    # Stress test: many small allocations
    var ptrs: [100]*u8

    for i in 0..100
        ptrs[i] = malloc(32)
        assert ptrs[i] != null
        *(ptrs[i]) = i as u8

    # Verify all values
    for i in 0..100
        assert *(ptrs[i]) == i as u8

    # Free all
    for i in 0..100
        free(ptrs[i])
    0

[[test]]
fn test_mixed_sizes() -> i32
    # Allocate different sizes interleaved
    let p1: *u8 = malloc(8)
    let p2: *u8 = malloc(1024)
    let p3: *u8 = malloc(64)
    let p4: *u8 = malloc(4096)  # Large allocation
    let p5: *u8 = malloc(128)

    assert p1 != null
    assert p2 != null
    assert p3 != null
    assert p4 != null
    assert p5 != null

    # Free in different order
    free(p3)
    free(p1)
    free(p5)
    free(p2)
    free(p4)
    0

[[test]]
fn test_size_class_boundaries() -> i32
    # Test allocations at size class boundaries
    let p16: *u8 = malloc(16)    # Max for class 0
    let p17: *u8 = malloc(17)    # Min for class 1
    let p32: *u8 = malloc(32)    # Max for class 1
    let p33: *u8 = malloc(33)    # Min for class 2

    assert p16 != null
    assert p17 != null
    assert p32 != null
    assert p33 != null

    free(p16)
    free(p17)
    free(p32)
    free(p33)
    0
