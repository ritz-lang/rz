# test_fs_iter.ritz - Tests for directory iteration
#
# dir_open -> Result<DirIter, Errno> (AGAST #4248). Tests run with the package
# dir (ritzlib/tests) as cwd, so "." is this directory and ".." is ritzlib.
#
# These used to count failures in globals through assert_true/assert_gt while
# every test returned 0, so none could fail: test_dir_iterate_projects opened
# "projects", which does not exist from this cwd, and passed anyway. They
# assert now.

import ritzlib.sys
import ritzlib.fs
import ritzlib.errno
import ritzlib.result
import ritzlib.option
import ritzlib.strview

[[test]]
fn test_dir_open_close() -> i32
    match dir_open(".")
        Ok(d) =>
            var dir: DirIter = d
            dir_close(@dir)
        Err(_) => return 1
    0

[[test]]
fn test_dir_open_invalid() -> i32
    match dir_open("/this/path/does/not/exist")
        Ok(d) =>
            var dir: DirIter = d
            dir_close(@dir)
            return 1
        Err(e) =>
            assert errno_code(e) == ENOENT, "dir_open of a missing dir is ENOENT"
    0

[[test]]
fn test_dir_iterate_current() -> i32
    var dir: DirIter = match dir_open(".")
        Ok(d) => d
        Err(_) => return 1
    var count: i64 = 0
    while dir_next(@dir)
        count += 1
    dir_close(@dir)
    # ".", ".." and this file at least.
    assert count >= 3, "current dir has entries"
    0

[[test]]
fn test_dir_entry_name() -> i32
    var dir: DirIter = match dir_open(".")
        Ok(d) => d
        Err(_) => return 1
    var found_dot: bool = false
    var found_self: bool = false
    while dir_next(@dir)
        let name: StrView = dir_entry(@dir).name
        if strview_eq_cstr(name, c".")
            found_dot = true
        if strview_eq_cstr(name, c"test_fs_iter.ritz")
            found_self = true
    dir_close(@dir)
    assert found_dot, "found . entry"
    assert found_self, "found this test file"
    0

[[test]]
fn test_dir_entry_is_dir() -> i32
    var dir: DirIter = match dir_open(".")
        Ok(d) => d
        Err(_) => return 1
    var found_subdir: bool = false
    while dir_next(@dir)
        if dir_entry_is_dir(@dir)
            found_subdir = true
            break
    dir_close(@dir)
    # At least . and .. are directories.
    assert found_subdir, "found a directory entry"
    0

[[test]]
fn test_dir_iterate_parent() -> i32
    # ".." is ritzlib: dozens of modules.
    var dir: DirIter = match dir_open("..")
        Ok(d) => d
        Err(_) => return 1
    var count: i64 = 0
    var found_fs: bool = false
    while dir_next(@dir)
        let name: StrView = dir_entry(@dir).name
        if not strview_eq_cstr(name, c".") and not strview_eq_cstr(name, c"..")
            count += 1
        if strview_eq_cstr(name, c"fs.ritz")
            found_fs = true
    dir_close(@dir)
    assert count > 5, "ritzlib has multiple entries"
    assert found_fs, "ritzlib holds fs.ritz"
    0

[[test]]
fn test_dir_entry_type_without_entry_is_none() -> i32
    # No current entry (before dir_next): None, not a DT_UNKNOWN sentinel.
    var dir: DirIter = match dir_open(".")
        Ok(d) => d
        Err(_) => return 1
    let t: Option<u8> = dir_entry_type(@dir)
    let none: bool = option_is_none<u8>(@t)
    dir_close(@dir)
    assert none, "dir_entry_type with no entry is None"
    0

[[test]]
fn test_mode_helpers_return_bool() -> i32
    # 16384 = S_IFDIR, 32768 = S_IFREG, 40960 = S_IFLNK (mode >> 12).
    let d: bool = mode_is_dir(16384)
    let f: bool = mode_is_file(32768)
    let l: bool = mode_is_link(40960)
    if not d or not f or not l
        return 1
    0

[[test]]
fn test_dir_next_returns_bool() -> i32
    var dir: DirIter = match dir_open(".")
        Ok(d) => d
        Err(_) => return 1
    let advanced: bool = dir_next(@dir)
    dir_close(@dir)
    if not advanced
        return 2
    0
