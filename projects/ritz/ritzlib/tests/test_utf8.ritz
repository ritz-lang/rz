# Tests for ritzlib/utf8.ritz: one code point at a time (AGAST #4972).

import ritzlib.gvec
import ritzlib.span
import ritzlib.strview
import ritzlib.utf8

fn unit(text: StrView, i: i64) -> Utf8Unit
    utf8_unit_at(span_from_strview(text), i)

# The first unit of these bytes: malformed text can't be a literal.
fn unit_of(b0: u8, b1: u8, b2: u8, b3: u8, n: i64) -> Utf8Unit
    var v: Vec<u8> = vec_new<u8>()
    v.push(b0)
    v.push(b1)
    v.push(b2)
    v.push(b3)
    utf8_unit_at(v[0..n], 0)

[[test]]
fn test_utf8_well_formed_units() -> i32
    let a = unit("a", 0)
    assert a.cp == 0x61 and a.len == 1
    let e = unit("é", 0)                       # U+00E9
    assert e.cp == 0xE9 and e.len == 2
    let euro = unit("x€", 1)                   # U+20AC
    assert euro.cp == 0x20AC and euro.len == 3
    let g = unit("𝄞", 0)                       # U+1D11E
    assert g.cp == 0x1D11E and g.len == 4
    0

[[test]]
fn test_utf8_malformed_bytes_are_units_of_one() -> i32
    let overlong = unit_of(0xC0, 0x80, 0, 0, 2)
    assert overlong.len == 1 and overlong.cp == 0xDCC0
    let surrogate = unit_of(0xED, 0xA0, 0x80, 0, 3)       # U+D800 encoded
    assert surrogate.len == 1 and surrogate.cp == 0xDCED
    let above = unit_of(0xF4, 0x90, 0x80, 0x80, 4)        # past U+10FFFF
    assert above.len == 1
    let cut = unit_of(0xE2, 0x82, 0, 0, 2)                # truncated
    assert cut.len == 1 and cut.cp == 0xDCE2
    let lone = unit_of(0x80, 0, 0, 0, 1)                  # a continuation byte
    assert lone.len == 1 and lone.cp == 0xDC80
    let bad_tail = unit_of(0xE2, 0x82, 0x41, 0, 3)
    assert bad_tail.len == 1
    0
