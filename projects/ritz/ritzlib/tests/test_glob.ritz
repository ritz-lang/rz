# Tests for ritzlib/glob.ritz: shell-style path patterns (AGAST #4972).

import ritzlib.glob
import ritzlib.string
import ritzlib.strview

[[test]]
fn test_glob_literal_is_the_whole_path() -> i32
    assert glob_match("src/main.ritz", "src/main.ritz")
    assert not glob_match("src/main.ritz", "src/main.ritzx")
    assert not glob_match("main.ritz", "src/main.ritz")
    assert glob_match("", "")
    assert not glob_match("", "a")
    0

[[test]]
fn test_glob_star_stays_in_its_segment() -> i32
    assert glob_match("*.ritz", "a.ritz")
    assert glob_match("*.ritz", ".ritz")
    assert not glob_match("*.ritz", "src/a.ritz")
    assert glob_match("src/*.ritz", "src/a.ritz")
    assert not glob_match("src/*", "src/x/a.ritz")
    assert glob_match("*", "README")
    assert not glob_match("*", "a/b")
    # `**` inside a segment is a `*`: no `/` either.
    assert glob_match("a**b", "axyb")
    assert not glob_match("a**b", "a/b")
    0

[[test]]
fn test_glob_globstar_spans_directories() -> i32
    assert glob_match("**/*.ritz", "a.ritz")
    assert glob_match("**/*.ritz", "src/core/a.ritz")
    assert not glob_match("**/*.ritz", "src/core/a.py")
    assert glob_match("a/**/b", "a/b")
    assert glob_match("a/**/b", "a/x/b")
    assert glob_match("a/**/b", "a/x/y/b")
    assert not glob_match("a/**/b", "a/xb")
    assert glob_match("src/**", "src/a")
    assert glob_match("src/**", "src/x/y")
    assert not glob_match("src/**", "srcx/a")
    assert glob_match("**", "any/depth/at/all")
    0

[[test]]
fn test_glob_question_is_one_code_point() -> i32
    assert glob_match("?.txt", "a.txt")
    assert glob_match("?.txt", "é.txt")        # two bytes, one code point
    assert not glob_match("?.txt", ".txt")
    assert not glob_match("a?b", "a/b")
    0

[[test]]
fn test_glob_classes() -> i32
    assert glob_match("[abc].c", "b.c")
    assert not glob_match("[abc].c", "d.c")
    assert glob_match("[a-c]x", "cx")
    assert not glob_match("[a-c]x", "dx")
    assert glob_match("[!a]x", "bx")
    assert not glob_match("[!a]x", "ax")
    assert glob_match("[^a]x", "bx")
    assert not glob_match("[^a]x", "ax")
    assert glob_match("[]]", "]")              # `]` first is a member
    assert glob_match("[-a]", "-")             # `-` first, and last, is literal
    assert glob_match("[a-]", "-")
    assert glob_match("[é-ê]", "ê")
    assert not glob_match("[é-ê]", "e")
    assert not glob_match("[!a]", "/")         # never a `/`
    assert glob_match("[\\]]", "]")            # a backslash escapes inside
    0

[[test]]
fn test_glob_unclosed_bracket_and_escapes_are_literal() -> i32
    assert glob_match("a[b", "a[b")
    assert not glob_match("a[b", "ab")
    assert glob_match("\\*", "*")
    assert not glob_match("\\*", "x")
    assert glob_match("a\\", "a\\")            # a trailing backslash is itself
    0

[[test]]
fn test_glob_compiled_once_matches_many() -> i32
    let g = glob_compile("**/test_*.ritz")
    assert g.matches("test/test_glob.ritz")
    assert g.matches("test_a.ritz")
    assert not g.matches("test/glob.ritz")
    0

[[test]]
fn test_glob_runs_in_linear_time() -> i32
    # A backtracking matcher takes exponential time on this; the state set
    # takes len(path) * len(pattern) steps.
    var path = string_new()
    for i in 0..4000
        path.push('a')
    assert not glob_match("*a*a*a*a*a*a*a*a*a*a*b", path.as_view())
    path.push('b')
    assert glob_match("*a*a*a*a*a*a*a*a*a*a*b", path.as_view())
    0
