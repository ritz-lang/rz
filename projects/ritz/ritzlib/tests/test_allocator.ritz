# Allocator-aware collections (AGAST #4120)
#
# A Vec, String or HashMap built with an `_in` constructor takes its memory
# from that Allocator, and every later grow and the final drop go back to the
# same one: the block's header names its owner, so plain realloc/free route
# there. Collections built the usual way stay on the global heap. Each test
# counts what its allocator handed out and got back.

import ritzlib.memory
import ritzlib.gvec
import ritzlib.string
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.box
import ritzlib.sys

# An Arena behind a counting Allocator. ctx points at one of these.
struct CountingArena
    arena: Arena
    allocs: i64
    frees: i64
    live_bytes: i64

fn counting_alloc(ctx: *u8, len: i64) -> *u8
    let c: *CountingArena = ctx as *CountingArena
    let p: *u8 = arena_alloc(@c.arena, len)
    if p != null
        c.allocs += 1
        c.live_bytes += len
    return p

fn counting_free(ctx: *u8, p: *u8, len: i64) -> i32
    let c: *CountingArena = ctx as *CountingArena
    c.frees += 1
    c.live_bytes -= len
    return 0

fn counting_new(c: *CountingArena, size: i64) -> Allocator
    c.arena = arena_new(size)
    c.allocs = 0
    c.frees = 0
    c.live_bytes = 0
    return Allocator { ctx: c as *u8, alloc: counting_alloc, free: counting_free }

fn in_arena(c: *CountingArena, p: *u8) -> bool
    let lo: i64 = c.arena.base as i64
    return p as i64 >= lo and p as i64 < lo + c.arena.size

# The acceptance test: one Vec on an arena allocator and one on the global
# heap, side by side; each drop goes back to its own allocator.
[[test]]
fn test_vec_on_arena_and_global_heap_coexist() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 65536)

    var av: Vec<i64> = vec_new_in<i64>(@a)
    var gv: Vec<i64> = vec_new<i64>()
    for i in 0..100
        assert vec_push<i64>(@&av, i)
        assert vec_push<i64>(@&gv, i * 2)

    assert allocator_of(av.data as *u8) == @a
    assert allocator_of(gv.data as *u8) == null
    assert in_arena(@c, av.data as *u8)
    assert not in_arena(@c, gv.data as *u8)
    for i in 0..100
        assert vec_get<i64>(@av, i) == i
        assert vec_get<i64>(@gv, i) == i * 2
    # Growing 8 -> 16 -> 32 -> 64 -> 128 elements: 5 blocks from the arena,
    # 4 of them already handed back by realloc.
    assert c.allocs == 5
    assert c.frees == 4

    # The global Vec's drop does not touch the arena allocator...
    let frees_before: i64 = c.frees
    let gdata: *u8 = gv.data as *u8
    vec_drop<i64>(@&gv)
    assert c.frees == frees_before
    # ...its 1 KiB block is back on the global heap: the next malloc of that
    # size class gets it again.
    let again: *u8 = malloc(1024)
    assert again == gdata
    free(again)

    # The arena Vec's drop goes back to the arena allocator.
    vec_drop<i64>(@&av)
    assert c.frees == frees_before + 1
    assert c.allocs == c.frees
    assert c.live_bytes == 0
    arena_destroy(@c.arena)
    0

[[test]]
fn test_vec_with_cap_in_reserves_from_the_allocator() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 65536)
    var v: Vec<i32> = vec_with_cap_in<i32>(@a, 50)
    assert vec_cap<i32>(@v) == 50
    assert c.allocs == 1
    assert allocator_of(v.data as *u8) == @a
    for i in 0..50
        vec_push<i32>(@&v, i as i32)
    # Within capacity: no new block.
    assert c.allocs == 1
    vec_drop<i32>(@&v)
    assert c.frees == 1
    assert c.live_bytes == 0
    arena_destroy(@c.arena)
    0

[[test]]
fn test_string_on_an_allocator() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 65536)
    var s: String = string_new_in(@a)
    var g: String = string_new()
    for i in 0..40
        string_push_str(@&s, "abc")
        string_push_str(@&g, "xyz")
    assert string_len(@s) == 120
    assert string_eq(@s, "abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc")
    assert allocator_of(s.data.data) == @a
    assert allocator_of(g.data.data) == null
    let frees_before: i64 = c.frees
    string_drop(@&g)
    assert c.frees == frees_before
    string_drop(@&s)
    assert c.allocs == c.frees
    assert c.live_bytes == 0

    var w: String = string_with_cap_in(@a, 10)
    assert string_cap(@w) == 10
    assert allocator_of(w.data.data) == @a
    string_drop(@&w)
    assert c.allocs == c.frees
    arena_destroy(@c.arena)
    0

struct Pt
    x: i64
    y: i64

impl Hash for Pt
    pub fn hash(self: @Pt) -> u64
        fnv1a_i64(fnv1a_i64(fnv1a_init(), self.x), self.y)

impl Eq for Pt
    pub fn equals(self: @Pt, other: @Pt) -> bool
        self.x == other.x and self.y == other.y

fn get_or(m: @HashMap<Pt, i64>, k: Pt, d: i64) -> i64
    match m.get(k)
        Some(v) => v
        None => d

# A HashMap's grow builds a bigger table: in the map's own allocator.
[[test]]
fn test_hashmap_on_an_allocator_grows_in_it() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 262144)
    var m: HashMap<Pt, i64> = hashmap_new_in<Pt, i64>(@a)
    assert allocator_of(m.slots.data as *u8) == @a
    for i in 0..100
        m.insert(Pt { x: i, y: 0 - i }, i * 10)
    # 16 slots -> 32 -> 64 -> 128 -> 256.
    assert m.slots.len == 256
    assert allocator_of(m.slots.data as *u8) == @a
    assert c.allocs == 5
    assert c.frees == 4
    for i in 0..100
        assert get_or(@m, Pt { x: i, y: 0 - i }, -1) == i * 10
    hashmap_drop<Pt, i64>(@&m)
    assert c.allocs == c.frees
    assert c.live_bytes == 0

    var g: HashMap<Pt, i64> = hashmap_new<Pt, i64>()
    for i in 0..100
        g.insert(Pt { x: i, y: i }, i)
    assert allocator_of(g.slots.data as *u8) == null
    hashmap_drop<Pt, i64>(@&g)
    assert c.allocs == c.frees
    arena_destroy(@c.arena)
    0

# The low-level interface: malloc_in / realloc / free on a tagged block.
[[test]]
fn test_malloc_in_realloc_free_route_to_the_owner() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 65536)
    let p: *u8 = malloc_in(@a, 24)
    assert p != null
    assert c.allocs == 1
    for i in 0..24
        *(p + i) = i as u8
    # Fits the usable size: stays put.
    assert realloc(p, 20) == p
    assert c.allocs == 1
    # Grows: a new block from the same allocator, the old one freed there.
    let q: *u8 = realloc(p, 4000)
    assert q != null
    assert q != p
    assert allocator_of(q) == @a
    assert c.allocs == 2
    assert c.frees == 1
    for i in 0..24
        assert *(q + i) == i as u8
    free(q)
    assert c.frees == 2
    assert c.live_bytes == 0
    # realloc(p, 0) frees into the owner too.
    let r: *u8 = malloc_in(@a, 8)
    assert realloc(r, 0) == null
    assert c.allocs == c.frees
    # A null allocator is the global heap.
    let h: *u8 = malloc_in(null, 64)
    assert h != null
    assert allocator_of(h) == null
    free(h)
    assert allocator_of(null) == null
    arena_destroy(@c.arena)
    0

# An allocator that is out of memory makes the _in constructors fail empty.
fn none_alloc(ctx: *u8, len: i64) -> *u8
    return null

fn none_free(ctx: *u8, p: *u8, len: i64) -> i32
    return 0

[[test]]
fn test_exhausted_allocator_returns_null() -> i32
    var a: Allocator = Allocator { ctx: null, alloc: none_alloc, free: none_free }
    assert malloc_in(@a, 16) == null
    var v: Vec<i64> = vec_with_cap_in<i64>(@a, 10)
    assert v.data == null
    assert vec_cap<i64>(@v) == 0
    var e: Vec<i64> = vec_new_in<i64>(@a)
    assert e.data == null
    0

# ritzlib's own arena_allocator: blocks come from the Arena; free gives
# nothing back until the arena is reset or destroyed.
[[test]]
fn test_arena_allocator_backs_a_vec() -> i32
    var ar: Arena = arena_new(65536)
    var a: Allocator = arena_allocator(@ar)
    var v: Vec<i64> = vec_new_in<i64>(@a)
    for i in 0..300
        vec_push<i64>(@&v, i)
    let lo: i64 = ar.base as i64
    assert v.data as i64 >= lo and v.data as i64 < lo + ar.size
    for i in 0..300
        assert vec_get<i64>(@v, i) == i
    let used: i64 = arena_used(@ar)
    vec_drop<i64>(@&v)
    assert arena_used(@ar) == used
    arena_destroy(@ar)
    0

# pages_allocator: every block is its own mapping from the given PageSource,
# and goes back to that source on free, whatever source is installed then.
var g_pa_maps: i64 = 0
var g_pa_unmaps: i64 = 0

fn pa_map(len: i64) -> *u8
    g_pa_maps += 1
    return sys_mmap_anon(len)

fn pa_unmap(p: *u8, len: i64) -> i32
    g_pa_unmaps += 1
    return sys_munmap(p, len)

fn enomem_map(len: i64) -> *u8
    return -12 as *u8

fn never_unmap(p: *u8, len: i64) -> i32
    return -1

[[test]]
fn test_pages_allocator_frees_to_its_own_source() -> i32
    var src: PageSource = PageSource { map: pa_map, unmap: pa_unmap }
    var a: Allocator = pages_allocator(@src)
    var v: Vec<u8> = vec_with_cap_in<u8>(@a, 100)
    assert g_pa_maps == 1
    for i in 0..5000
        vec_push<u8>(@&v, (i % 251) as u8)
    let maps: i64 = g_pa_maps
    assert maps > 1
    assert g_pa_unmaps == maps - 1
    # Swap the global page source for one that can't map or unmap: the Vec's
    # memory still goes back to its own source.
    let prev: PageSource = page_source_set(PageSource { map: enomem_map, unmap: never_unmap })
    for i in 0..5000
        assert vec_get<u8>(@v, i) == (i % 251) as u8
    vec_drop<u8>(@&v)
    page_source_set(prev)
    assert g_pa_unmaps == maps
    0

# ============================================================================
# Heap: a size-class layer per PageSource (AGAST #4326)
# ============================================================================
# A Heap carves small blocks out of 64 KiB slabs from its own PageSource, as
# the global heap does from the installed one, so a subsystem on its own pages
# no longer pays a page per small block. heap_destroy gives every slab and
# every live large block back to that source.

var g_hp_maps: i64 = 0
var g_hp_unmaps: i64 = 0
var g_hp_live: i64 = 0

fn hp_map(len: i64) -> *u8
    let p: *u8 = sys_mmap_anon(len)
    if not mmap_failed(p)
        g_hp_maps += 1
        g_hp_live += len
    return p

fn hp_unmap(p: *u8, len: i64) -> i32
    g_hp_unmaps += 1
    g_hp_live -= len
    return sys_munmap(p, len)

fn hp_reset()
    g_hp_maps = 0
    g_hp_unmaps = 0
    g_hp_live = 0

# The acceptance test: 1000 small Vec<u8>s take a few slabs, not 1000 pages,
# and destroying the heap unmaps every slab to the heap's own source, even
# with a failing source installed globally in the meantime.
[[test]]
fn test_heap_allocator_packs_small_vecs_into_slabs() -> i32
    hp_reset()
    var h: Heap
    heap_init(@h, PageSource { map: hp_map, unmap: hp_unmap })
    var a: Allocator = heap_allocator(@h)
    assert g_hp_maps == 0
    # The Vec headers live on the global heap, allocated before the swap.
    let vs: *Vec<u8> = calloc(1000, sizeof(Vec<u8>)) as *Vec<u8>
    assert vs != null
    let prev: PageSource = page_source_set(PageSource { map: enomem_map, unmap: never_unmap })
    for i in 0..1000
        let vp: *Vec<u8> = vs + i
        *vp = vec_new_in<u8>(@a)
        for j in 0..12
            assert vec_push<u8>(@&*vp, (i + j) as u8)
        assert allocator_of(vp.data as *u8) == @a
    page_source_set(prev)
    # 1000 live 16-byte blocks plus their freed 8-byte first blocks: a slab
    # or two per size class.
    assert g_hp_maps >= 1
    assert g_hp_maps <= 4
    assert g_hp_unmaps == 0
    for i in 0..1000
        let vp: *Vec<u8> = vs + i
        assert vp.len == 12
        for j in 0..12
            assert vec_get<u8>(@*vp, j) == (i + j) as u8
    # Drop half of them: the blocks go back to the heap's bins, not the source.
    for i in 0..500
        vec_drop<u8>(@&*(vs + i))
    assert g_hp_unmaps == 0
    # Those freed blocks are reused before any new slab is mapped.
    let maps: i64 = g_hp_maps
    for i in 0..500
        let vp: *Vec<u8> = vs + i
        *vp = vec_with_cap_in<u8>(@a, 16)
        assert vp.data != null
    assert g_hp_maps == maps
    heap_destroy(@h)
    assert g_hp_unmaps == g_hp_maps
    assert g_hp_live == 0
    free(vs as *u8)
    0

# A block over the largest size class is its own mapping from the heap's
# source: free unmaps it there, and heap_destroy unmaps one still live.
[[test]]
fn test_heap_allocator_large_blocks_use_its_source() -> i32
    hp_reset()
    var h: Heap
    heap_init(@h, PageSource { map: hp_map, unmap: hp_unmap })
    var a: Allocator = heap_allocator(@h)
    let p: *u8 = malloc_in(@a, 10000)
    assert p != null
    assert g_hp_maps == 1
    assert allocator_of(p) == @a
    for i in 0..10000
        *(p + i) = (i % 199) as u8
    # Grows into another large mapping; the old one goes back to the source.
    let q: *u8 = realloc(p, 30000)
    assert q != null
    assert g_hp_maps == 2
    assert g_hp_unmaps == 1
    for i in 0..10000
        assert *(q + i) == (i % 199) as u8
    let r: *u8 = malloc_in(@a, 5000)
    assert r != null
    assert g_hp_maps == 3
    free(r)
    assert g_hp_unmaps == 2
    # One small block too, so there is a slab to give back.
    let s: *u8 = malloc_in(@a, 40)
    assert s != null
    assert g_hp_maps == 4
    # q and the slab are still live: destroy unmaps both.
    heap_destroy(@h)
    assert g_hp_unmaps == 4
    assert g_hp_live == 0
    0

# Two heaps on one source keep their own bins: a block freed into one is not
# handed out by the other.
[[test]]
fn test_heaps_keep_their_own_bins() -> i32
    hp_reset()
    var h1: Heap
    heap_init(@h1, PageSource { map: hp_map, unmap: hp_unmap })
    var h2: Heap
    heap_init(@h2, PageSource { map: hp_map, unmap: hp_unmap })
    var a1: Allocator = heap_allocator(@h1)
    var a2: Allocator = heap_allocator(@h2)
    let p: *u8 = malloc_in(@a1, 24)
    free(p)
    let q: *u8 = malloc_in(@a2, 24)
    assert q != p
    assert allocator_of(q) == @a2
    # h1 hands its own freed block back out.
    let r: *u8 = malloc_in(@a1, 24)
    assert r == p
    heap_destroy(@h1)
    heap_destroy(@h2)
    assert g_hp_unmaps == g_hp_maps
    assert g_hp_live == 0
    0

# ============================================================================
# HashMapI64 and Box<T> on an Allocator (AGAST #4327)
# ============================================================================

# HashMapI64's grow builds its bigger table in the map's own allocator.
[[test]]
fn test_hashmap_i64_on_an_allocator_grows_in_it() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 262144)
    var m: HashMapI64 = hashmap_i64_new_in(@a)
    assert c.allocs == 1
    assert allocator_of(m.entries as *u8) == @a
    for i in 0..100
        hashmap_i64_insert(@&m, i * 7, i)
    # 16 entries -> 32 -> 64 -> 128 -> 256.
    assert hashmap_i64_cap(@m) == 256
    assert allocator_of(m.entries as *u8) == @a
    assert c.allocs == 5
    assert c.frees == 4
    for i in 0..100
        assert hashmap_i64_get(@m, i * 7) == i
    hashmap_i64_drop(@&m)
    assert c.allocs == c.frees
    assert c.live_bytes == 0

    var w: HashMapI64 = hashmap_i64_with_cap_in(@a, 100)
    assert hashmap_i64_cap(@w) == 128
    assert allocator_of(w.entries as *u8) == @a
    hashmap_i64_drop(@&w)
    assert c.allocs == c.frees

    # The plain constructor stays on the global heap.
    var g: HashMapI64 = hashmap_i64_new()
    for i in 0..100
        hashmap_i64_insert(@&g, i, i)
    assert allocator_of(g.entries as *u8) == null
    hashmap_i64_drop(@&g)
    assert c.allocs == c.frees
    arena_destroy(@c.arena)
    0

struct BoxPayload
    a: i64
    b: i64
    c: i64

[[test]]
fn test_box_on_an_allocator() -> i32
    var c: CountingArena
    var a: Allocator = counting_new(@c, 65536)
    var b: Box<BoxPayload> = box_new_in<BoxPayload>(@a, BoxPayload { a: 1, b: 2, c: 3 })
    assert box_valid<BoxPayload>(@b)
    assert c.allocs == 1
    assert allocator_of(b.ptr as *u8) == @a
    assert in_arena(@c, b.ptr as *u8)
    let v: BoxPayload = box_get<BoxPayload>(@b)
    assert v.a == 1 and v.b == 2 and v.c == 3
    box_drop<BoxPayload>(@&b)
    assert c.frees == 1
    assert c.live_bytes == 0

    # Out of memory: an empty Box.
    var none: Allocator = Allocator { ctx: null, alloc: none_alloc, free: none_free }
    var e: Box<i64> = box_new_in<i64>(@none, 5)
    assert not box_valid<i64>(@e)

    # The plain constructor stays on the global heap.
    var g: Box<i64> = box_new<i64>(7)
    assert allocator_of(g.ptr as *u8) == null
    box_drop<i64>(@&g)
    assert c.frees == 1
    arena_destroy(@c.arena)
    0
