[[test]]
fn test_span_method_len() -> i32
    var s: Span<u8> = "test"
    assert s.len() == 4
    0

[[test]]
fn test_span_method_is_empty() -> i32
    var empty: Span<u8> = span_empty<u8>()
    var nonempty: Span<u8> = "a"
    assert empty.is_empty()
    assert not nonempty.is_empty()
    0

[[test]]
fn test_span_method_slice() -> i32
    var s: Span<u8> = "hello"
    var sub: Span<u8> = s.slice(1, 4)
    assert sub.len() == 3
    0

# ============================================================================
# copy_from / fill / cmp (AGAST #4639: memcpy, memmove, memset, memcmp)
# ============================================================================

[[test]]
fn test_span_copy_from() -> i32
    var buf: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
    var dst: Span<u8> = span_from_ptr<u8>(@buf[0], 8)
    let n: i64 = dst.copy_from("abc")
    assert n == 3
    assert buf[0] == 'a'
    assert buf[2] == 'c'
    assert buf[3] == 0
    0

[[test]]
fn test_span_copy_from_truncates_to_dest() -> i32
    # The destination's length bounds the copy: no write past it.
    var buf: [4]u8 = [0, 0, 0, 0]
    var dst: Span<u8> = span_from_ptr<u8>(@buf[0], 2)
    assert dst.copy_from("xyz") == 2
    assert buf[0] == 'x'
    assert buf[1] == 'y'
    assert buf[2] == 0
    0

[[test]]
fn test_span_copy_from_overlapping() -> i32
    # memmove semantics: shifting right inside one buffer keeps the bytes.
    var buf: [6]u8 = ['a', 'b', 'c', 'd', 'e', 0]
    var all: Span<u8> = span_from_ptr<u8>(@buf[0], 6)
    var dst: Span<u8> = all.slice(1, 5)
    assert dst.copy_from(all.slice(0, 4)) == 4
    assert buf[0] == 'a'
    assert buf[1] == 'a'
    assert buf[2] == 'b'
    assert buf[3] == 'c'
    assert buf[4] == 'd'
    # And shifting left.
    var left: Span<u8> = all.slice(0, 4)
    assert left.copy_from(all.slice(1, 5)) == 4
    assert buf[0] == 'a'
    assert buf[1] == 'b'
    assert buf[3] == 'd'
    0

[[test]]
fn test_span_copy_from_wide_elements() -> i32
    # Counts are elements, not bytes.
    var src: [3]i64 = [7, 8, 9]
    var dst_arr: [3]i64 = [0, 0, 0]
    var dst: Span<i64> = span_from_ptr<i64>(@dst_arr[0], 3)
    assert dst.copy_from(span_from_ptr<i64>(@src[0], 3)) == 3
    assert dst_arr[0] == 7
    assert dst_arr[2] == 9
    0

[[test]]
fn test_span_fill() -> i32
    var buf: [5]u8 = [1, 1, 1, 1, 1]
    var all: Span<u8> = span_from_ptr<u8>(@buf[0], 5)
    var mid: Span<u8> = all.slice(1, 4)
    mid.fill('z')
    assert buf[0] == 1
    assert buf[1] == 'z'
    assert buf[3] == 'z'
    assert buf[4] == 1
    var wide: [2]i32 = [0, 0]
    var w: Span<i32> = span_from_ptr<i32>(@wide[0], 2)
    w.fill(0 - 1)
    assert wide[0] == 0 - 1
    assert wide[1] == 0 - 1
    0

# zero / secure_zero (AGAST #4638: memzero(p, n) and secure_zero(p, n)).
# Each zeroes exactly the span's bytes: its len elements of sizeof(T) each.
# The volatile-store guarantee of secure_zero is pinned in
# ritz0/tests/test_secure_zero.py; this checks the range.
[[test]]
fn test_span_zero_exact_range() -> i32
    var buf: [8]u8 = [9, 9, 9, 9, 9, 9, 9, 9]
    var all: Span<u8> = span_from_ptr<u8>(@buf[0], 8)
    var mid: Span<u8> = all.slice(2, 7)
    mid.zero()
    assert buf[1] == 9
    assert buf[2] == 0
    assert buf[6] == 0
    assert buf[7] == 9
    0

[[test]]
fn test_span_secure_zero_exact_range() -> i32
    # Every head offset 0..8 and length 0..20, so the word loop, the byte
    # head and the byte tail are each hit with and without the others.
    var buf: [40]u8
    var all: Span<u8> = span_from_ptr<u8>(@buf[0], 40)
    for off in 0..9
        for n in 0..21
            all.fill(0xAA)
            var s: Span<u8> = all.slice(off, off + n)
            s.secure_zero()
            for k in 0..40
                let inside: bool = k >= off and k < off + n
                if inside and buf[k] != 0
                    return 1
                if not inside and buf[k] != 0xAA
                    return 2
    0

[[test]]
fn test_span_zero_wide_elements() -> i32
    # A Span<i64> of 3 zeroes 24 bytes, not 3.
    var wide: [4]i64 = [0 - 1, 0 - 1, 0 - 1, 0 - 1]
    var w: Span<i64> = span_from_ptr<i64>(@wide[0], 3)
    w.zero()
    assert wide[0] == 0
    assert wide[2] == 0
    assert wide[3] == 0 - 1
    var key: [4]i64 = [7, 7, 7, 7]
    var k: Span<i64> = span_from_ptr<i64>(@key[0], 3)
    k.secure_zero()
    assert key[0] == 0
    assert key[2] == 0
    assert key[3] == 7
    0

[[test]]
fn test_span_zero_empty_is_a_noop() -> i32
    var e: Span<u8> = span_empty<u8>()
    e.zero()
    e.secure_zero()
    0

[[test]]
fn test_span_cmp() -> i32
    var a: Span<u8> = "abc"
    var b: Span<u8> = "abd"
    var c: Span<u8> = "ab"
    assert a.cmp(@b) == Ordering.Less
    assert b.cmp(@a) == Ordering.Greater
    assert a.cmp(@a) == Ordering.Equal
    assert a.cmp(@c) == Ordering.Greater
    0

# ============================================================================
# Bytes: Span<u8>'s byte methods through `impl Bytes for Span<u8>` (AGAST #4684)
# ============================================================================

[[test]]
fn test_span_as_strview() -> i32
    let s: Span<u8> = span_from_strview("hello")
    let v: StrView = s.as_strview()
    assert v.len == 5
    assert v.eq("hello")
    0

[[test]]
fn test_span_find_byte() -> i32
    let s: Span<u8> = span_from_strview("hello")
    assert s.find_byte(108) == 2       # 'l'
    assert s.find_byte(122) == s.len   # 'z': absent is the length
    0

[[test]]
fn test_span_bytes_beside_generic_methods() -> i32
    # The trait's methods and impl<T> Span<T>'s resolve on one receiver,
    # through a reference as well as on the value.
    let s: Span<u8> = span_from_strview("key=value")
    let eq_at: i64 = s.find_byte(61)   # '='
    let key: Span<u8> = s.to(eq_at)
    let val: Span<u8> = s.from(eq_at + 1)
    let want_key: Span<u8> = span_from_strview("key")
    let want_val: Span<u8> = span_from_strview("value")
    assert key.eq(@want_key)
    let r: @Span<u8> = @val
    assert r.eq(@want_val)
    assert r.len() == 5
    assert s.starts_with(@key) and s.ends_with(@val)
    0

struct Pair
    a: i32
    b: i64

[[test]]
fn test_span_of_bytes_fills_the_value_in_place() -> i32
    var p = Pair { a: 1, b: 2 }
    let bytes: Span<u8> = span_of_bytes<Pair>(@&p)
    assert bytes.len == sizeof(Pair)
    bytes.fill(255)
    assert p.a == -1
    assert p.b == -1
    bytes.zero()
    assert p.a == 0 and p.b == 0
    0
