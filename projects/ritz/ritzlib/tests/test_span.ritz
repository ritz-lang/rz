# Tests for Span<T> - non-owning views into memory

import ritzlib.span
import ritzlib.gvec
import ritzlib.cmp  # Ordering

# ============================================================================
# Span<u8> construction tests
# ============================================================================

[[test]]
fn test_span_empty() -> i32
    var s: Span<u8> = span_empty<u8>()
    assert s.len == 0
    assert s.ptr == null
    0

[[test]]
fn test_span_from_strview() -> i32
    var s: Span<u8> = span_from_strview("hello")
    assert s.len == 5
    assert s.ptr != null
    # The StrView-built span must equal the R62 literal span.
    var lit: Span<u8> = "hello"
    assert s.eq(@lit)
    0

[[test]]
fn test_span_from_ptr() -> i32
    var data: [4]u8 = [10, 20, 30, 40]
    var s: Span<u8> = span_from_ptr<u8>(@data[0], 4)
    assert s.len == 4
    assert s.get(0) == '\n'
    assert s.get(3) == 40
    0

[[test]]
fn test_span_from_vec() -> i32
    var v: Vec<u8> = vec_new<u8>()
    v.push(1)
    v.push(2)
    v.push(3)
    var s: Span<u8> = span_from_vec<u8>(@v)
    assert s.len == 3
    assert s.get(0) == 1
    assert s.get(2) == 3
    0

# ============================================================================
# Span<u8> accessor tests
# ============================================================================

[[test]]
fn test_span_len() -> i32
    var s: Span<u8> = "test"
    assert s.len() == 4
    0

[[test]]
fn test_span_is_empty() -> i32
    var empty: Span<u8> = span_empty<u8>()
    var nonempty: Span<u8> = "a"
    assert empty.is_empty()
    assert not nonempty.is_empty()
    0

[[test]]
fn test_span_get() -> i32
    var s: Span<u8> = "abc"
    assert s.get(0) == 'a'  # 'a'
    assert s.get(1) == 'b'  # 'b'
    assert s.get(2) == 'c'  # 'c'
    0

# ============================================================================
# Span<u8> slicing tests
# ============================================================================

[[test]]
fn test_span_slice_basic() -> i32
    var s: Span<u8> = "hello"
    var sub: Span<u8> = s.slice(1, 4)  # "ell"
    assert sub.len == 3
    assert sub.get(0) == 'e'  # 'e'
    assert sub.get(1) == 108  # 'l'
    assert sub.get(2) == 108  # 'l'
    0

[[test]]
fn test_span_slice_from() -> i32
    var s: Span<u8> = "hello"
    var sub: Span<u8> = s.from(2)  # "llo"
    assert sub.len == 3
    assert sub.get(0) == 108  # 'l'
    0

[[test]]
fn test_span_slice_to() -> i32
    var s: Span<u8> = "hello"
    var sub: Span<u8> = s.to(2)  # "he"
    assert sub.len == 2
    assert sub.get(0) == 104  # 'h'
    assert sub.get(1) == 'e'  # 'e'
    0

# ============================================================================
# Span<u8> comparison tests
# ============================================================================

[[test]]
fn test_span_eq() -> i32
    var a: Span<u8> = "hello"
    var b: Span<u8> = "hello"
    var c: Span<u8> = "world"
    assert a.eq(@b)
    assert not a.eq(@c)
    0

[[test]]
fn test_span_eq_empty() -> i32
    var a: Span<u8> = span_empty<u8>()
    var b: Span<u8> = span_empty<u8>()
    assert a.eq(@b)
    0

# ============================================================================
# Span<u8> search tests
# ============================================================================

[[test]]
fn test_span_contains() -> i32
    var haystack: Span<u8> = "hello world"
    var needle: Span<u8> = "world"
    var missing: Span<u8> = "foo"
    assert haystack.contains(@needle)
    assert not haystack.contains(@missing)
    0

[[test]]
fn test_span_contains_empty() -> i32
    var haystack: Span<u8> = "hello"
    var empty: Span<u8> = span_empty<u8>()
    assert haystack.contains(@empty)
    0

[[test]]
fn test_span_starts_with() -> i32
    var s: Span<u8> = "hello world"
    var prefix: Span<u8> = "hello"
    var not_prefix: Span<u8> = "world"
    assert s.starts_with(@prefix)
    assert not s.starts_with(@not_prefix)
    0

[[test]]
fn test_span_ends_with() -> i32
    var s: Span<u8> = "hello world"
    var suffix: Span<u8> = "world"
    var not_suffix: Span<u8> = "hello"
    assert s.ends_with(@suffix)
    assert not s.ends_with(@not_suffix)
    0

[[test]]
fn test_span_find() -> i32
    var haystack: Span<u8> = "hello world"
    var needle: Span<u8> = "world"
    var missing: Span<u8> = "foo"
    assert haystack.find(@needle) == 6
    assert haystack.find(@missing) == haystack.len
    0

[[test]]
fn test_span_find_at_start() -> i32
    var haystack: Span<u8> = "hello world"
    var needle: Span<u8> = "hello"
    assert haystack.find(@needle) == 0
    0

# ============================================================================
# Span<i64> tests (different element type)
# ============================================================================

[[test]]
fn test_span_i64() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(100)
    v.push(200)
    v.push(300)
    var s: Span<i64> = span_from_vec<i64>(@v)
    assert s.len == 3
    assert s.get(0) == 'd'
    assert s.get(2) == 300
    0

[[test]]
fn test_span_i64_slice() -> i32
    var v: Vec<i64> = vec_new<i64>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    var s: Span<i64> = span_from_vec<i64>(@v)
    var sub: Span<i64> = s.slice(1, 3)
    assert sub.len == 2
    assert sub.get(0) == 20
    assert sub.get(1) == 30
    0

