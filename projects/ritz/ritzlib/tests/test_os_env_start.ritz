# ritzlib.os.env reads the envp the kernel handed `_start` (AGAST #3737).
#
# The raw **u8 accessor env_raw_envp this file used to test is gone (AGAST
# #4648): ritzlib.process's spawn and exec_prepare build execve(2)'s envp
# from env_iter, and tests/test_process_exec.ritz covers that.

import ritzlib.sys
import ritzlib.strview
import ritzlib.span
import ritzlib.os.env

[[test]]
fn test_env_comes_from_start_envp() -> i32
    # AGAST #3737: the test binary's `_start` (ritz0's or ritz1's test mode)
    # stored the kernel's envp, and env_iter's entries are its strings, not
    # copies read from /proc/self/environ.
    assert __ritz_envp != null
    let entries: Span<StrView> = env_iter()
    assert entries.len > 0
    let first: *StrView = entries.ptr
    assert first.ptr == *__ritz_envp
    0
