# Byte-exact stdout of ritzlib.lang.tokens' token_print (AGAST #1684).
#
# It was a prints/print_int/sys_write chain; #1684 made it interpolated
# print, the token text going through a StrView.  The `foo` case pins that
# exactly `len` bytes are printed, not up to a NUL.  ritz1 parity:
# ritz0/test_ritzlib_output_goldens.py.
#
# Capture helpers: see test_argspec_output.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.lang.tokens


# ============================================================================
# Capture helpers
# ============================================================================

var g_out: [4096]u8
var g_out_len: i64 = 0
var g_err: [4096]u8
var g_err_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = sys_read(fd, buf + got, cap - got)
        if n > 0
            got = got + n
    got

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

# Run case `which` in a child with stdout/stderr captured into g_out/g_err.
# Returns the child's exit status.
fn run_case(which: i32) -> i32
    var o: [2]i32
    var e: [2]i32
    sys_pipe(@o[0])
    sys_pipe(@e[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_dup2(e[1], 2)
        sys_close(o[0])
        sys_close(o[1])
        sys_close(e[0])
        sys_close(e[1])
        sys_exit(run_body(which))
    sys_close(o[1])
    sys_close(e[1])
    g_out_len = read_all(o[0], @g_out[0], 4096)
    g_err_len = read_all(e[0], @g_err[0], 4096)
    sys_close(o[0])
    sys_close(e[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

fn out_is(want: StrView) -> i32
    bytes_differ(@g_out[0], g_out_len, want)

fn err_is(want: StrView) -> i32
    bytes_differ(@g_err[0], g_err_len, want)

# ============================================================================
# Cases
# ============================================================================

fn run_body(which: i32) -> i32
    var t = token_new(5, c"ident", 5, 3, 7)
    token_print(@t)
    t = token_new(2, c"foobar", 3, 10, 200)
    token_print(@t)
    t = token_new(0, c"", 0, 1, 1)
    token_print(@t)
    0

[[test]]
fn test_token_print_exact() -> i32
    assert run_case(1) == 0
    assert out_is("3:7 kind=5 'ident'\n10:200 kind=2 'foo'\n1:1 kind=0\n") == 0
    assert err_is("") == 0
    0
