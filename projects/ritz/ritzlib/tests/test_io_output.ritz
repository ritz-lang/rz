# Byte-exact stdout of ritzlib.io's printers whose bodies #4565 changed when
# it deleted print_int / print_hex / print_string / prints_cstr /
# println_cstr: print_size_human now interpolates, println_string,
# print_i64 and print_hex64 print a view of their String.
#
# Each case runs under testlib's capture: a forked child, stdout and stderr
# on their own pipes.

import ritzlib.io
import ritzlib.strview
import ritzlib.string
import ritzlib.testlib


# ============================================================================
# Cases
# ============================================================================

fn case_size_human() -> i32
    print_size_human(0)
    print_char(' ')
    print_size_human(1023)
    print_char(' ')
    print_size_human(-5)
    print_char(' ')
    print_size_human(1024)
    print_char(' ')
    print_size_human(1536)
    print_char(' ')
    print_size_human(5 * 1024 * 1024)
    print_char(' ')
    print_size_human(3 * 1024 * 1024 * 1024)
    print_char(' ')
    # Past T it stays in T: 2048 TiB is "2048T".
    print_size_human(2048 * 1024 * 1024 * 1024 * 1024)
    0

fn case_strings() -> i32
    var s: String = string_from("ab")
    println_string(@s)
    print_i64(-9223372036854775807 - 1)
    print_char(' ')
    print_hex64(255)
    print_char(' ')
    print_hex64(-1 as u64)
    newline()
    0

[[test]]
fn test_print_size_human_exact() -> i32
    expect_capture(case_size_human, "0 1023 -5 1K 1K 5M 3G 2048T", "")
    0

[[test]]
fn test_string_backed_printers_exact() -> i32
    expect_capture(case_strings, "ab\n-9223372036854775808 0xff 0xffffffffffffffff\n", "")
    0
