# Byte-exact stdout of ritzlib.io's printers whose bodies #4565 changed when
# it deleted print_int / print_hex / print_string / prints_cstr /
# println_cstr: print_size_human now interpolates, println_string,
# print_i64 and print_hex64 print a view of their String.
#
# Capture helpers: see test_argspec_output.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.string


# ============================================================================
# Capture helpers
# ============================================================================

var g_out: [4096]u8
var g_out_len: i64 = 0
var g_err: [4096]u8
var g_err_len: i64 = 0

fn read_all(fd: i32, buf: *u8, cap: i64) -> i64
    var got: i64 = 0
    var n: i64 = 1
    while n > 0 and got < cap
        n = sys_read(fd, buf + got, cap - got)
        if n > 0
            got = got + n
    got

# 0 when buf[0..len] is exactly `want`.
fn bytes_differ(buf: *u8, len: i64, want: StrView) -> i32
    if len != want.len
        return 1
    var i: i64 = 0
    while i < len
        if *(buf + i) != *(want.ptr + i)
            return 2
        i += 1
    0

# Run case `which` in a child with stdout/stderr captured into g_out/g_err.
# Returns the child's exit status.
fn run_case(which: i32) -> i32
    var o: [2]i32
    var e: [2]i32
    sys_pipe(@o[0])
    sys_pipe(@e[0])
    let pid: i32 = sys_fork()
    if pid == 0
        sys_dup2(o[1], 1)
        sys_dup2(e[1], 2)
        sys_close(o[0])
        sys_close(o[1])
        sys_close(e[0])
        sys_close(e[1])
        sys_exit(run_body(which))
    sys_close(o[1])
    sys_close(e[1])
    g_out_len = read_all(o[0], @g_out[0], 4096)
    g_err_len = read_all(e[0], @g_err[0], 4096)
    sys_close(o[0])
    sys_close(e[0])
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)
    (status >> 8) & 255

fn out_is(want: StrView) -> i32
    bytes_differ(@g_out[0], g_out_len, want)

fn err_is(want: StrView) -> i32
    bytes_differ(@g_err[0], g_err_len, want)

# ============================================================================
# Cases
# ============================================================================

fn case_size_human() -> i32
    print_size_human(0)
    print_char(' ')
    print_size_human(1023)
    print_char(' ')
    print_size_human(-5)
    print_char(' ')
    print_size_human(1024)
    print_char(' ')
    print_size_human(1536)
    print_char(' ')
    print_size_human(5 * 1024 * 1024)
    print_char(' ')
    print_size_human(3 * 1024 * 1024 * 1024)
    print_char(' ')
    # Past T it stays in T: 2048 TiB is "2048T".
    print_size_human(2048 * 1024 * 1024 * 1024 * 1024)
    0

fn case_strings() -> i32
    var s: String = string_from("ab")
    println_string(@s)
    print_i64(-9223372036854775807 - 1)
    print_char(' ')
    print_hex64(255)
    print_char(' ')
    print_hex64(-1 as u64)
    newline()
    0

fn run_body(which: i32) -> i32
    if which == 1
        return case_size_human()
    case_strings()

[[test]]
fn test_print_size_human_exact() -> i32
    assert run_case(1) == 0
    assert out_is("0 1023 -5 1K 1K 5M 3G 2048T") == 0
    assert err_is("") == 0
    0

[[test]]
fn test_string_backed_printers_exact() -> i32
    assert run_case(2) == 0
    assert out_is("ab\n-9223372036854775808 0xff 0xffffffffffffffff\n") == 0
    assert err_is("") == 0
    0
