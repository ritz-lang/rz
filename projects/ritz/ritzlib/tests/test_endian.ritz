# Tests for ritzlib/endian.ritz
#
# Every read and write takes a Span<u8> and a byte offset into it (AGAST
# #4644).  An offset whose bytes do not fit the span ends the program with
# status 101; that path cannot run inside a [[test]], so
# ritz0/tests/test_endian_bounds.py pins it.

import ritzlib.span
import ritzlib.endian

# ============================================================================
# Reads
# ============================================================================

[[test]]
fn test_read_u16_be() -> i32
    var b: [2]u8 = [0x12, 0x34]
    assert endian_read_u16_be(@b, 0) == 0x1234
    0

[[test]]
fn test_read_u16_le() -> i32
    var b: [2]u8 = [0x34, 0x12]
    assert endian_read_u16_le(@b, 0) == 0x1234
    0

[[test]]
fn test_read_u32_be() -> i32
    var b: [4]u8 = [0xde, 0xad, 0xbe, 0xef]
    assert endian_read_u32_be(@b, 0) == 0xdeadbeef
    0

[[test]]
fn test_read_u32_le() -> i32
    var b: [4]u8 = [0xef, 0xbe, 0xad, 0xde]
    assert endian_read_u32_le(@b, 0) == 0xdeadbeef
    0

[[test]]
fn test_read_u64_be() -> i32
    var b: [8]u8 = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]
    assert endian_read_u64_be(@b, 0) == 0x0123456789abcdef
    0

[[test]]
fn test_read_u64_le() -> i32
    var b: [8]u8 = [0xef, 0xcd, 0xab, 0x89, 0x67, 0x45, 0x23, 0x01]
    assert endian_read_u64_le(@b, 0) == 0x0123456789abcdef
    0

# A read at an odd offset: the byte-addressed form must not assume alignment.
[[test]]
fn test_read_unaligned() -> i32
    var b: [5]u8 = [0x00, 0xde, 0xad, 0xbe, 0xef]
    assert endian_read_u32_be(@b, 1) == 0xdeadbeef
    0

# The last whole field of a span is in range: the check is `off + n <= len`,
# not `off + n < len`.
[[test]]
fn test_read_at_the_end_of_the_span() -> i32
    var b: [10]u8 = [0, 0, 0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]
    assert endian_read_u64_be(@b, 2) == 0x0123456789abcdef
    assert endian_read_u16_le(@b, 8) == 0xefcd
    0

# An offset is relative to the span, not to the buffer it was sliced from.
[[test]]
fn test_read_through_a_sub_span() -> i32
    var b: [6]u8 = [0xff, 0xff, 0x12, 0x34, 0x56, 0x78]
    let s: [u8] = @b
    let tail: [u8] = s[2..6]
    assert endian_read_u32_be(tail, 0) == 0x12345678
    assert endian_read_u16_le(tail, 2) == 0x7856
    0

# ============================================================================
# Writes
# ============================================================================

[[test]]
fn test_write_u16_be() -> i32
    var b: [2]u8 = [0, 0]
    endian_write_u16_be(@b, 0, 0x1234)
    assert b[0] == 0x12
    assert b[1] == 0x34
    0

[[test]]
fn test_write_u16_le() -> i32
    var b: [2]u8 = [0, 0]
    endian_write_u16_le(@b, 0, 0x1234)
    assert b[0] == 0x34
    assert b[1] == 0x12
    0

[[test]]
fn test_write_u32_be() -> i32
    var b: [4]u8 = [0, 0, 0, 0]
    endian_write_u32_be(@b, 0, 0xdeadbeef)
    assert b[0] == 0xde
    assert b[1] == 0xad
    assert b[2] == 0xbe
    assert b[3] == 0xef
    0

[[test]]
fn test_write_u32_le() -> i32
    var b: [4]u8 = [0, 0, 0, 0]
    endian_write_u32_le(@b, 0, 0xdeadbeef)
    assert b[0] == 0xef
    assert b[1] == 0xbe
    assert b[2] == 0xad
    assert b[3] == 0xde
    0

[[test]]
fn test_write_u64_be() -> i32
    var b: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
    endian_write_u64_be(@b, 0, 0x0123456789abcdef)
    assert b[0] == 0x01
    assert b[3] == 0x67
    assert b[4] == 0x89
    assert b[7] == 0xef
    0

[[test]]
fn test_write_u64_le() -> i32
    var b: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
    endian_write_u64_le(@b, 0, 0x0123456789abcdef)
    assert b[0] == 0xef
    assert b[3] == 0x89
    assert b[4] == 0x67
    assert b[7] == 0x01
    0

# A write at an offset touches its own bytes and no others.
[[test]]
fn test_write_at_an_offset() -> i32
    var b: [6]u8 = [0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa]
    endian_write_u32_le(@b, 1, 0x01020304)
    assert b[0] == 0xaa
    assert b[1] == 0x04
    assert b[4] == 0x01
    assert b[5] == 0xaa
    0

# ============================================================================
# Round trips
# ============================================================================

[[test]]
fn test_round_trip() -> i32
    var b: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
    endian_write_u16_be(@b, 0, 0x1234)
    assert endian_read_u16_be(@b, 0) == 0x1234
    endian_write_u32_le(@b, 0, 0x89abcdef)
    assert endian_read_u32_le(@b, 0) == 0x89abcdef
    endian_write_u64_be(@b, 0, 0xfedcba9876543210)
    assert endian_read_u64_be(@b, 0) == 0xfedcba9876543210
    endian_write_u64_le(@b, 0, 0xfedcba9876543210)
    assert endian_read_u64_le(@b, 0) == 0xfedcba9876543210
    0
