# AGAST #4930: the status returns ritzlib's fmt and hashmap kept became
# Option / Result, and the one place a Writer Result turns back into
# Display's i64 count.
#
# Runs under ritz0 (the package step) and ritz1 / ritz1_selfhosted
# (make ritzlib-tests-ritz1).

import ritzlib.errno
import ritzlib.fmt
import ritzlib.hashmap

# --- HashMapI64.find_slot: Option<i64>, not -1 ---------------------------------

[[test]]
fn test_find_slot_of_a_missing_key_is_where_insert_puts_it() -> i32
    var m: HashMapI64 = hashmap_i64_new()
    let slot: Option<i64> = m.find_slot(7)
    assert slot.is_some()
    m.insert(7, 70)
    # Now the key is present: its own slot, the one find names.
    assert m.find_slot(7).unwrap_or(-1) == m.find(7).unwrap_or(-2)
    assert m.find_slot(7).unwrap_or(-1) == slot.unwrap_or(-3)
    0

[[test]]
fn test_find_slot_of_a_full_table_is_none() -> i32
    # insert grows at 75%, so only a table filled behind its back is full:
    # every slot Full, none holding the key, and no Tomb to reuse.
    var m: HashMapI64 = hashmap_i64_with_cap(16)
    var i: i64 = 0
    while i < m.cap
        let e: *HashMapEntryI64 = m.entries + i
        e.key = 1000 + i
        e.value = i
        e.state = Slot.Full
        i += 1
    m.len = m.cap
    assert m.find_slot(7).is_none()
    # A present key is still found in a full table.
    assert m.find_slot(1003).is_some()
    0

# --- fmt_count: a Writer Result as Display's count ----------------------------

[[test]]
fn test_fmt_count_is_n_on_ok() -> i32
    var w: Writer = null_writer()
    assert fmt_count(w.write_str("abcd"), 4) == 4
    0

[[test]]
fn test_fmt_count_is_the_negative_errno_on_err() -> i32
    var buf: [2]u8
    var w: Writer = span_writer(@buf)
    assert fmt_count(w.write_str("abc"), 3) == -28    # -ENOSPC
    assert fmt_count(Err(Errno.BadF), 1) == -9
    0
