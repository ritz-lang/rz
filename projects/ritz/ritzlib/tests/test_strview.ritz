[[test]]
fn test_strview_trim() -> i32
    let s: StrView = "  hello  "
    let trimmed: StrView = s.trim()
    assert trimmed.eq("hello")
    0

[[test]]
fn test_strview_trim_start() -> i32
    let s: StrView = "  hello"
    let trimmed: StrView = s.trim_start()
    assert trimmed.eq("hello")
    0

[[test]]
fn test_strview_trim_end() -> i32
    let s: StrView = "hello  "
    let trimmed: StrView = s.trim_end()
    assert trimmed.eq("hello")
    0

# ============================================================================
# Edge cases
# ============================================================================

[[test]]
fn test_strview_empty_operations() -> i32
    let empty: StrView = strview_empty()
    let other: StrView = "hello"

    # Empty contains empty
    assert empty.contains(empty)
    assert other.contains(empty)

    # Empty doesn't contain non-empty
    assert not empty.contains(other)

    # Empty equals empty
    let empty2: StrView = strview_empty()
    assert empty.eq(empty2)
    0

[[test]]
fn test_strview_single_char() -> i32
    let s: StrView = "x"
    assert s.len == 1
    assert s.get(0) == 'x'
    assert s.find_byte('x') == 0
    assert s.find_byte('y') == s.len
    0

# ============================================================================
# FFI/C-string conversion tests
# ============================================================================

[[test]]
fn test_strview_owned_cstr_copy() -> i32
    let s: StrView = "hello"
    var owned: String = string_from(s)
    let cstr: *u8 = owned.as_ptr()
    # Verify it's null-terminated
    assert *(cstr + 5) == 0
    # Verify content
    assert *cstr == 'h'
    assert *(cstr + 4) == 'o'
    # owned's drop releases the buffer
    0

# ============================================================================
# rfind tests
# ============================================================================

[[test]]
fn test_strview_rfind() -> i32
    let s: StrView = "a/b/c.ttf"
    let slash: StrView = "/"
    assert s.rfind(slash) == 3
    let dash: StrView = "-"
    assert s.rfind(dash) == s.len
    # Method syntax
    assert s.rfind("/") == 3
    assert s.rfind("c.ttf") == 4
    0

[[test]]
fn test_strview_rfind_edge_cases() -> i32
    let s: StrView = "aaa"
    # Last occurrence wins
    assert s.rfind("a") == 2
    assert s.rfind("aa") == 1
    # Needle longer than haystack
    assert s.rfind("aaaa") == s.len
    # Empty needle matches at end
    assert s.rfind("") == 3
    0

# ============================================================================
# strview_parse_i64 tests (the StrView replacement for str.atoi)
# ============================================================================

# Some(n) -> n; None -> a sentinel no test input produces.
fn parsed_or_sentinel(s: StrView) -> i64
    let r = s.parse_i64()
    option_unwrap_or<i64>(@r, 7777)

fn parse_is_none(s: StrView) -> bool
    let r = s.parse_i64()
    option_is_none<i64>(@r)

[[test]]
fn test_strview_parse_i64_valid() -> i32
    assert parsed_or_sentinel("42") == 42
    assert parsed_or_sentinel("-7") == -7
    assert parsed_or_sentinel("+5") == 5
    assert parsed_or_sentinel("0") == 0
    assert parsed_or_sentinel("-0") == 0
    assert parsed_or_sentinel("007") == 7
    assert not parse_is_none("42")
    0

[[test]]
fn test_strview_parse_i64_empty_is_none() -> i32
    assert parse_is_none("")
    assert parse_is_none("-")
    assert parse_is_none("+")
    0

[[test]]
fn test_strview_parse_i64_not_a_number_is_none() -> i32
    # atoi("abc") returns 0; the StrView form reports the failure.
    assert parse_is_none("abc")
    assert parse_is_none("12x")
    assert parse_is_none(" 42")
    assert parse_is_none("42 ")
    assert parse_is_none("--1")
    0

[[test]]
fn test_strview_parse_i64_range() -> i32
    let max: i64 = 9223372036854775807
    let min: i64 = -9223372036854775807 - 1
    assert parsed_or_sentinel("9223372036854775807") == max
    assert parsed_or_sentinel("-9223372036854775808") == min
    assert parse_is_none("9223372036854775808")
    assert parse_is_none("-9223372036854775809")
    assert parse_is_none("99999999999999999999")
    0

[[test]]
fn test_strview_parse_i64_borrows_a_slice() -> i32
    # Parses exactly the view, not up to a NUL: "12" out of "123".
    let whole: StrView = "123"
    let head: StrView = whole.take(2)
    let r = head.parse_i64()
    assert option_unwrap_or<i64>(@r, 7777) == 12
    0

# ============================================================================
# By-value params (#2414): a call can pass a temporary or a literal straight
# in, which an `@StrView` slot could not take without a named local first.
# ============================================================================

[[test]]
fn test_strview_by_value_takes_temporaries() -> i32
    assert (("  ab  ").trim()).eq("ab")
    assert (("xxab").skip(2)).starts_with("a")
    assert ("hello").find("ll") == 2
    0

[[test]]
fn test_strview_by_value_leaves_callers_view_alone() -> i32
    let s: StrView = "  pad  "
    let t: StrView = s.trim()
    assert s.len == 7
    assert t.len == 3
    0

fn method_through_borrow(p: @StrView) -> i64
    return p.find("d")

[[test]]
fn test_strview_by_value_method_on_a_borrowed_receiver() -> i32
    let s: StrView = "pad"
    assert method_through_borrow(@s) == 2
    assert s.trim().eq("pad")
    0

# ============================================================================
# Scanning: trim_start_byte, split_digits (AGAST #4925)
# ============================================================================

[[test]]
fn test_strview_trim_start_byte_drops_the_leading_run() -> i32
    let s: StrView = "   ab "
    assert s.trim_start_byte(' ').eq("ab ")
    let x: StrView = "xxyx"
    assert x.trim_start_byte('x').eq("yx")
    0

[[test]]
fn test_strview_trim_start_byte_without_a_run_is_the_view() -> i32
    let s: StrView = "ab"
    assert s.trim_start_byte(' ').eq("ab")
    assert s.trim_start_byte('\t').len == 2
    0

[[test]]
fn test_strview_trim_start_byte_of_all_or_nothing_is_empty() -> i32
    let s: StrView = "   "
    assert s.trim_start_byte(' ').is_empty()
    assert strview_empty().trim_start_byte(' ').is_empty()
    0

[[test]]
fn test_strview_split_digits_splits_at_the_first_non_digit() -> i32
    let s: StrView = "128 x i8"
    let p: SplitPair = s.split_digits()
    assert p.before.eq("128")
    assert p.after.eq(" x i8")
    assert p.before.parse_i64().unwrap_or(0) == 128
    0

[[test]]
fn test_strview_split_digits_with_no_digits_is_all_after() -> i32
    let s: StrView = "x4"
    let p: SplitPair = s.split_digits()
    assert p.before.is_empty()
    assert p.after.eq("x4")
    let e: SplitPair = strview_empty().split_digits()
    assert e.before.is_empty() and e.after.is_empty()
    0

[[test]]
fn test_strview_split_digits_of_all_digits_is_all_before() -> i32
    let s: StrView = "0042"
    let p: SplitPair = s.split_digits()
    assert p.before.eq("0042")
    assert p.after.is_empty()
    0
