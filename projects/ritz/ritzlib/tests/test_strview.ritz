# Tests for ritzlib/strview.ritz

import ritzlib.cstr
import ritzlib.strview
import ritzlib.option
import ritzlib.cmp  # Ordering
import ritzlib.memory
import ritzlib.string  # string_from: owned NUL-terminated copy (AGAST #4601)

# ============================================================================
# Constructor tests
# ============================================================================

[[test]]
fn test_strview_empty() -> i32
    let s: StrView = strview_empty()
    assert s.len == 0
    assert s.is_empty()
    0

[[test]]
fn test_strview_from_cstr() -> i32
    # Subject: strview_from_cstr measures a NUL-terminated *u8, so its input is a c"".
    let s: StrView = strview_from_cstr(c"hello")
    assert s.len == 5
    assert not s.is_empty()
    0

[[test]]
fn test_strview_from_ptr() -> i32
    # Subject: strview_from_ptr builds a view from a raw (ptr, len) pair.
    let data: StrView = "hello world"
    let s: StrView = strview_from_ptr(data.ptr, 5)  # Just "hello"
    assert s.len == 5
    assert s.get(0) == 'h'
    assert s.get(4) == 'o'
    0

# ============================================================================
# Comparison tests
# ============================================================================

[[test]]
fn test_strview_eq() -> i32
    let a: StrView = "hello"
    let b: StrView = "hello"
    let c: StrView = "world"
    assert a.eq(b)
    assert not a.eq(c)
    0

[[test]]
fn test_strview_eq_cstr() -> i32
    let s: StrView = "hello"
    assert s.eq("hello")
    assert not s.eq("world")
    assert not s.eq("hell")  # Shorter
    assert not s.eq("hello!")  # Longer
    0

[[test]]
fn test_strview_cmp() -> i32
    let a: StrView = "apple"
    let b: StrView = "banana"
    let c: StrView = "apple"
    let d: StrView = "app"
    let e: StrView = "application"

    # apple < banana; banana > apple; apple == apple
    assert a.cmp(b) == Ordering.Less
    assert b.cmp(a) == Ordering.Greater
    assert a.cmp(c) == Ordering.Equal

    # apple > app (longer); apple < application (shorter, so a prefix)
    assert a.cmp(d) == Ordering.Greater
    assert a.cmp(e) == Ordering.Less

    # A byte differs past the first: hello vs hella / hellp
    let h: StrView = "hello"
    assert h.cmp("hella") == Ordering.Greater
    assert h.cmp("hellp") == Ordering.Less
    0

[[test]]
fn test_strview_cmp_empty() -> i32
    let empty: StrView = strview_empty()
    let nonempty: StrView = "x"
    assert empty.cmp(nonempty) == Ordering.Less
    assert nonempty.cmp(empty) == Ordering.Greater
    let empty2: StrView = strview_empty()
    assert empty.cmp(empty2) == Ordering.Equal
    0

[[test]]
fn test_strview_cmp_unsigned_bytes() -> i32
    # Bytes compare unsigned: "é" leads with 0xC3, which sorts after 'z'.
    let hi: StrView = "é"
    assert hi.cmp("z") == Ordering.Greater
    0

[[test]]
fn test_strview_cmp_helpers() -> i32
    let a: StrView = "abc"
    assert a.cmp("abd").is_lt()
    assert a.cmp("abc").is_eq()
    assert a.cmp("abb").is_ge()
    0

# ============================================================================
# Slicing tests
# ============================================================================

[[test]]
fn test_strview_slice() -> i32
    let s: StrView = "hello world"
    let sub: StrView = s.slice(0, 5)
    assert sub.len == 5
    assert sub.eq("hello")
    0

[[test]]
fn test_strview_take_skip() -> i32
    let s: StrView = "hello world"

    let first5: StrView = s.take(5)
    assert first5.len == 5
    assert first5.eq("hello")

    let rest: StrView = s.skip(6)
    assert rest.len == 5
    assert rest.eq("world")
    0

# ============================================================================
# Search tests
# ============================================================================

[[test]]
fn test_strview_starts_with() -> i32
    let s: StrView = "hello world"
    let prefix: StrView = "hello"
    let wrong: StrView = "world"

    assert s.starts_with(prefix)
    assert not s.starts_with(wrong)
    0

[[test]]
fn test_strview_ends_with() -> i32
    let s: StrView = "hello world"
    let suffix: StrView = "world"
    let wrong: StrView = "hello"

    assert s.ends_with(suffix)
    assert not s.ends_with(wrong)
    0

[[test]]
fn test_strview_contains() -> i32
    let s: StrView = "hello world"
    let needle: StrView = "lo wo"
    let wrong: StrView = "xyz"

    assert s.contains(needle)
    assert not s.contains(wrong)
    0

[[test]]
fn test_strview_find() -> i32
    let s: StrView = "hello world"
    let needle: StrView = "world"

    assert s.find(needle) == 6

    let not_found: StrView = "xyz"
    assert s.find(not_found) == s.len
    0

[[test]]
fn test_strview_find_byte() -> i32
    let s: StrView = "hello world"

    assert s.find_byte('o') == 4  # First 'o'
    assert s.find_byte(' ') == 5  # Space
    assert s.find_byte('x') == s.len  # Not found
    0

# ============================================================================
# Split tests
# ============================================================================

[[test]]
fn test_strview_split_once() -> i32
    let s: StrView = "key=value=more"
    match s.split_once('=')
        Some(p) =>
            assert p.before.eq("key")
            assert p.after.eq("value=more")
        None =>
            assert false
    0

[[test]]
fn test_strview_split_once_edges() -> i32
    # The delimiter first or last leaves an empty side, which is still Some.
    let lead: StrView = "=v"
    match lead.split_once('=')
        Some(p) =>
            assert p.before.len == 0
            assert p.after.eq("v")
        None =>
            assert false
    let trail: StrView = "k="
    match trail.split_once('=')
        Some(p) =>
            assert p.before.eq("k")
            assert p.after.len == 0
        None =>
            assert false
    0

[[test]]
fn test_strview_split_once_not_found() -> i32
    let s: StrView = "nodelimiter"
    assert s.split_once('=').is_none()
    let empty: StrView = strview_empty()
    assert empty.split_once('=').is_none()
    0

# ============================================================================
# Trim tests
