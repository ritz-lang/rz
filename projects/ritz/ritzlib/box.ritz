# ritzlib/box.ritz - Owned heap allocation
#
# Box<T> provides a heap-allocated container for a single value.
# - Ownership semantics: one owner, automatic cleanup via Drop trait
# - Heap allocation via malloc/free, or an Allocator's (box_new_in)
# - Generic via monomorphization
#
# Usage:
#   var b: Box<i32> = box_new<i32>(42)
#   let val: i32 = b.get()
#   b.set(100)
#   # Automatic cleanup when b goes out of scope (Drop trait)

import ritzlib.memory
import ritzlib.drop

# ============================================================================
# Box<T> - Heap-allocated single value
# ============================================================================
# Unlike a stack-allocated wrapper, Box<T> stores a *pointer* to heap memory.
# The value T is stored on the heap, not inline in the struct.

struct Box<T>
    ptr: *T    # Pointer to heap-allocated T

# ============================================================================
# Drop trait implementation for automatic cleanup
# ============================================================================

impl<T> Drop for Box<T>
    fn drop(self: @&Box<T>)
        if self.ptr != null
            free(self.ptr as *u8)
        self.ptr = null

# ============================================================================
# Deref / DerefMut: `b.f` is the boxed value's field (LANGUAGE_SPEC §7.7, R17)
# ============================================================================
# The Box's own `ptr` comes first; any other field reaches through the box, as
# a place: `b.x` reads through `deref`, `b.x = 5` and `@&b.x` go through
# `deref_mut`.

impl<T> Deref for Box<T>
    fn deref(self: @Box<T>) -> @T
        @*self.ptr

impl<T> DerefMut for Box<T>
    fn deref_mut(self: @&Box<T>) -> @&T
        @&*self.ptr

# ============================================================================
# Method syntax support
# ============================================================================

impl<T> Box<T>
    # Get the value from a Box (returns a copy).
    pub fn get(self: @Box<T>) -> T
        return *self.ptr

    # Get a pointer to the value (for in-place modification).
    pub fn as_ptr(self: @Box<T>) -> *T
        return self.ptr

    # Set a new value in the Box (overwrites the old value).
    pub fn set(self: @&Box<T>, value: T)
        *self.ptr = value

    # Check if a Box is valid (successfully allocated).
    pub fn valid(self: @Box<T>) -> bool
        if self.ptr != null
            return true
        return false

# ============================================================================
# Constructor
# ============================================================================

# Create a new Box containing a copy of the value.
# Allocates sizeof(T) bytes on the heap.
pub fn box_new<T>(value: T) -> Box<T>
    # Allocate memory for T
    let b: Box<T> = Box<T> { ptr: malloc(sizeof(T)) as *T }
    if b.ptr != null
        # Copy value to heap
        *b.ptr = value
    return b

# A Box whose value lives in memory from `a` (AGAST #4327); drop frees it
# back there (the block's header names its owner; see malloc_in). Empty (ptr
# null, valid() 0) if `a` is out of memory. A null `a` is the global heap.
# standard-exempt: raw-ptr-param: allocator: the *Allocator the boxed value lives in
pub fn box_new_in<T>(a: *Allocator, value: T) -> Box<T>
    let b: Box<T> = Box<T> { ptr: a.malloc(sizeof(T)) as *T }
    if b.ptr != null
        *b.ptr = value
    return b
