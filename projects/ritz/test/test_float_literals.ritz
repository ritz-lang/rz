# Float literal support: constants, arithmetic, comparison, negation.
#
# Was tests/float_test.ritz, a main()-returns-0 program that no gate ever
# ran: build.py discovers test/ only (AGAST #1386).

const PI: f64 = 3.14159265359
const NEGATIVE: f64 = -2.5
const SMALL: f64 = 0.001

[[test]]
fn test_float_arithmetic() -> i32
    let x: f64 = 1.5
    let y: f64 = 2.5
    assert x + y == 4.0, "1.5 + 2.5"
    assert y - x == 1.0, "2.5 - 1.5"
    assert x * y == 3.75, "1.5 * 2.5"
    assert y / x > 1.66 and y / x < 1.67, "2.5 / 1.5"
    0

[[test]]
fn test_float_constants() -> i32
    let area: f64 = PI * 2.0 * 2.0
    assert area > 12.566 and area < 12.567, "PI * 4"
    assert NEGATIVE < 0.0, "negative const"
    assert SMALL > 0.0 and SMALL < 0.01, "small const"
    0

[[test]]
fn test_float_comparison() -> i32
    let x: f64 = 1.5
    let y: f64 = 2.5
    assert x < y, "1.5 < 2.5"
    assert y > x, "2.5 > 1.5"
    assert x == 1.5, "1.5 == 1.5"
    0

[[test]]
fn test_float_negation() -> i32
    let x: f64 = 1.5
    let neg_x: f64 = -x
    assert neg_x < 0.0, "-1.5 < 0"
    assert neg_x == -1.5, "-x == -1.5"
    0
