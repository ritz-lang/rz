# Tuple type support (Issue #94): construction and .N field access.
#
# Was tests/tuple_test.ritz, a main()-counts-failures program that no gate
# ever ran: build.py discovers test/ only (AGAST #1386).

[[test]]
fn test_basic_tuple() -> i32
    let t: (i32, i32) = (1, 2)
    assert t.0 == 1, "t.0"
    assert t.1 == 2, "t.1"
    0

[[test]]
fn test_tuple_addition() -> i32
    let t: (i32, i32) = (10, 20)
    assert t.0 + t.1 == 30, "t.0 + t.1"
    0

[[test]]
fn test_mixed_tuple() -> i32
    let t: (i32, i64, i32) = (1, 100, 3)
    let a: i32 = t.0
    let b: i64 = t.1
    let c: i32 = t.2
    assert a == 1, "t.0"
    assert b == 100, "t.1"
    assert c == 3, "t.2"
    0

[[test]]
fn test_single_element_tuple() -> i32
    let t: (i32,) = (42,)
    assert t.0 == 42, "t.0"
    0

# One-element tuples in every position a tuple type may appear (AGAST #4459).
# ritz0 is the reference; ritz1 and ritz1_selfhosted must agree.

fn tuple1_param(t: (i32,)) -> i32
    t.0

fn tuple1_return() -> (i32,)
    (9,)

[[test]]
fn test_single_element_tuple_param_type() -> i32
    assert tuple1_param((7,)) == 7, "param type"
    0

[[test]]
fn test_single_element_tuple_return_type() -> i32
    let t: (i32,) = tuple1_return()
    assert t.0 == 9, "return type"
    0

[[test]]
fn test_single_element_tuple_nested() -> i32
    let t: ((i32,), i32) = ((5,), 6)
    let inner: (i32,) = t.0
    assert inner.0 == 5, "nested t.0"
    assert t.1 == 6, "nested t.1"
    0
