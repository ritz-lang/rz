# State a closure would have captured, in a struct beside a fn field
# (LARB R56, LANGUAGE_SPEC §5.6; the call is R41's `h.f(...)`, §5.5)

import ritzlib.io

fn scale(k: i32, x: i32) -> i32
    x * k

fn affine(a: i32, b: i32, x: i32) -> i32
    x * a + b

struct Scaler
    k: i32
    f: fn(i32, i32) -> i32

struct Affine
    a: i32
    b: i32
    f: fn(i32, i32, i32) -> i32

fn main() -> i32
    # One value of state
    let s = Scaler { k: 10, f: scale }
    let result = s.f(s.k, 5)
    if result == 50
        prints("fn field state: PASS\n")
    else
        prints("fn field state: FAIL\n")
        return 1

    # Two values of state
    let t = Affine { a: 2, b: 3, f: affine }
    let result2 = t.f(t.a, t.b, 10)
    if result2 == 23  # 10 * 2 + 3
        prints("fn field multi-state: PASS\n")
    else
        prints("fn field multi-state: FAIL\n")
        return 1

    prints("All fn-field state tests passed!\n")
    0
