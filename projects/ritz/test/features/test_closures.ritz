# Named fns passed by name, which replace closures (LARB R56, LANGUAGE_SPEC §5.6)

import ritzlib.io

fn double(x: i32) -> i32
    x * 2

fn add_one(x: i32) -> i32
    x + 1

# Test 1: a named fn as an argument
fn apply(f: fn(i32) -> i32, x: i32) -> i32
    return f(x)

# Test 2: a higher-order fn
fn map_int(arr: *i32, len: i32, f: fn(i32) -> i32, out: *i32)
    for i in 0..len
        *(out + i) = f(*(arr + i))

fn main() -> i32
    let result = apply(double, 21)
    if result == 42
        prints("fn by name: PASS\n")
    else
        prints("fn by name: FAIL\n")
        return 1
    
    var arr: [3]i32
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    var out: [3]i32
    map_int(@arr[0], 3, add_one, @out[0])
    
    if out[0] == 11 and out[1] == 21 and out[2] == 31
        prints("fn map: PASS\n")
    else
        prints("fn map: FAIL\n")
        return 1
    
    prints("All fn-value tests passed!\n")
    0
