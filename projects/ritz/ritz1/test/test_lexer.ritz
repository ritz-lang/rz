# ritz1/test/test_lexer.ritz - unit tests for ritz1/src/lexer.ritz
#
# Run by `make ritz1-unit` (tools/ritz1_unit.py), a bootstrap gate step.
# The lexer is the direct-coded scanner of AGAST #1821: lexer_init takes the
# source and nothing else, and every rule below is the grammar's token
# definition (grammars/ritz1.grammar) as the NFA lexer it replaced lexed it.

import ritzlib.cstr
import ritzlib.str
import ritzlib.strview
import tokens_gen
import lexer

fn feed(lex: *Lexer, src: StrView)
  lexer_init(lex, StrView { ptr: (src.ptr), len: (src.len) })

# The next token's kind (`assert next_kind(lex) == TOK_X` prints both).
fn next_kind(lex: *Lexer) -> i32
  let tok: Token = lexer_next(lex)
  tok.kind

# The next token's length.
fn next_len(lex: *Lexer) -> i32
  let tok: Token = lexer_next(lex)
  tok.text.len as i32

[[test]]
fn test_tokens_in_order() -> i32
  var lex: Lexer
  feed(@lex, "main ( x)")
  let t1: Token = lexer_next(@lex)
  assert t1.kind == TOK_IDENT
  assert t1.text.len == 4
  assert t1.text.get(0) == 109  # m
  assert t1.line == 1
  assert t1.col == 1
  let t2: Token = lexer_next(@lex)
  assert t2.kind == TOK_LPAREN
  assert t2.col == 6       # the skipped space still advances the column
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_RPAREN
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_keyword_beats_identifier_of_the_same_length() -> i32
  # Longest match, then the keyword: `as` and `asm` are keywords, `asmx`
  # and `i8x` identifiers.
  var lex: Lexer
  feed(@lex, "as asm asmx i8 i8x _")
  assert next_kind(@lex) == TOK_AS
  assert next_kind(@lex) == TOK_ASM
  let t: Token = lexer_next(@lex)
  assert t.kind == TOK_IDENT
  assert t.text.len == 4
  assert next_kind(@lex) == TOK_I8
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_operators_take_the_longest_match() -> i32
  var lex: Lexer
  feed(@lex, "..= .. . [[ >>= ->")
  assert next_kind(@lex) == TOK_DOTDOTEQ
  assert next_kind(@lex) == TOK_DOTDOT
  assert next_kind(@lex) == TOK_DOT
  assert next_kind(@lex) == TOK_LBRACKET2
  assert next_kind(@lex) == TOK_SHR       # no `>>=`: `>>` then `=`
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_ARROW
  0

[[test]]
fn test_colon_amp_is_one_token_only_unspaced() -> i32
  # AGAST #1565: `:&` is the borrow sigil, as ritz0 lexes it; `: &` is a
  # COLON and the legacy `&T` type's AMP.  `:&&` is `:&` then `&`.
  var lex: Lexer
  feed(@lex, ":& : & :&&")
  assert next_kind(@lex) == TOK_COLON_AMP
  assert next_kind(@lex) == TOK_COLON
  assert next_kind(@lex) == TOK_AMP
  assert next_kind(@lex) == TOK_COLON_AMP
  assert next_kind(@lex) == TOK_AMP
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_colon_eq_is_one_token_only_unspaced() -> i32
  # AGAST #3911: `:=` is the move-parameter sigil, as ritz0 lexes it; `: =`
  # is a COLON and an ASSIGN.  `:==` is `:=` then `=`.
  var lex: Lexer
  feed(@lex, ":= : = :==")
  assert next_kind(@lex) == TOK_COLON_EQ
  assert next_kind(@lex) == TOK_COLON
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_COLON_EQ
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_numbers_and_their_suffixes() -> i32
  var lex: Lexer
  feed(@lex, "0x1F 0b102 0x 1.5 1. 7u8 5usize_max 2.5f32 ")
  let hex: Token = lexer_next(@lex)
  assert hex.kind == TOK_NUMBER
  assert hex.text.len == 4
  assert next_len(@lex) == 4               # 0b10, then the 2
  assert next_len(@lex) == 1
  assert next_len(@lex) == 1               # `0x` with no digit is `0` then `x`
  assert next_kind(@lex) == TOK_IDENT
  let f: Token = lexer_next(@lex)
  assert f.kind == TOK_FLOAT
  assert f.text.len == 3
  assert next_kind(@lex) == TOK_NUMBER     # `1.` is no float
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 3               # 7u8
  assert next_len(@lex) == 1               # 5, then usize_max
  assert next_kind(@lex) == TOK_IDENT
  let f32: Token = lexer_next(@lex)
  assert f32.kind == TOK_FLOAT
  assert f32.text.len == 6
  0

# AGAST #3929: a FLOAT may carry an exponent, with or without a fraction.
[[test]]
fn test_float_exponents() -> i32
  var lex: Lexer
  feed(@lex, "2.0e10 1e-5 1E+3 2.5e3f32 1.e5 7")
  let a: Token = lexer_next(@lex)
  assert a.kind == TOK_FLOAT
  assert a.text.len == 6
  let b: Token = lexer_next(@lex)
  assert b.kind == TOK_FLOAT
  assert b.text.len == 4
  let c: Token = lexer_next(@lex)
  assert c.kind == TOK_FLOAT
  assert c.text.len == 4
  let d: Token = lexer_next(@lex)
  assert d.kind == TOK_FLOAT
  assert d.text.len == 8                        # the suffix after the exponent
  assert next_kind(@lex) == TOK_NUMBER     # `1.e5` is 1 . e5
  assert next_kind(@lex) == TOK_DOT
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_NUMBER
  0

# ritz0's refusal, at the byte where the exponent's digit should be.
[[test]]
fn test_an_exponent_needs_a_digit() -> i32
  var lex: Lexer
  feed(@lex, "x 1e+ y")
  assert next_kind(@lex) == TOK_IDENT
  let t: Token = lexer_next(@lex)
  assert t.kind == TOK_ERROR
  assert t.col == 6
  assert lex.error_msg.len > 0
  0

# A number after `.` is a tuple index: no exponent there, as ritz0, so an
# `e` with no digit after one is no exponent error either (`p.1e+ q`).
[[test]]
fn test_no_exponent_after_a_dot() -> i32
  var lex: Lexer
  feed(@lex, "p.1e5 p.1e+ q")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  assert next_kind(@lex) == TOK_IDENT      # e
  assert next_kind(@lex) == TOK_PLUS
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_a_tuple_index_after_a_dot_is_no_float() -> i32
  var lex: Lexer
  feed(@lex, "p.0.1")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  0

[[test]]
fn test_char_literals() -> i32
  var lex: Lexer
  feed(@lex, "'a' '\\'' '\\x41' ''")
  assert next_len(@lex) == 3
  assert next_len(@lex) == 4
  let x: Token = lexer_next(@lex)
  assert x.kind == TOK_CHAR
  assert x.text.len == 6
  assert next_kind(@lex) == TOK_ERROR      # '' is no char literal
  0

[[test]]
fn test_a_short_hex_char_is_a_located_error() -> i32
  var lex: Lexer
  feed(@lex, "x = '\\x4'")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 7                      # the `x` of `\x4`
  assert lex.error_msg.len > 0
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_unmatched_byte_is_one_error_token() -> i32
  var lex: Lexer
  feed(@lex, "a`b")
  assert next_kind(@lex) == TOK_IDENT
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.text.len == 1
  assert bad.text.get(0) == 96  # `
  assert lex.error_msg.len == 0
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_dollar_is_a_fatal_error() -> i32
  # `$` outside asm is refused with a message, and lexing stops there.
  var lex: Lexer
  feed(@lex, "a$b")
  assert next_kind(@lex) == TOK_IDENT
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.text.get(0) == 36  # $
  assert lex.error_msg.len > 0
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_a_nul_byte_is_source_not_the_end() -> i32
  var lex: Lexer
  feed(@lex, "a\0b")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ERROR
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_reinit_lexes_a_new_source() -> i32
  var lex: Lexer
  feed(@lex, "main()")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_LPAREN
  # A second source, mid-way through the first: position, line and column
  # all restart.
  feed(@lex, "(zz")
  let t: Token = lexer_next(@lex)
  assert t.kind == TOK_LPAREN
  assert t.col == 1
  assert t.line == 1
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_function_header_and_block() -> i32
  var lex: Lexer
  feed(@lex, "fn main() -> i32\n  return 42\n")
  assert next_kind(@lex) == TOK_FN
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_LPAREN
  assert next_kind(@lex) == TOK_RPAREN
  assert next_kind(@lex) == TOK_ARROW
  assert next_kind(@lex) == TOK_I32
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_INDENT
  let ret: Token = lexer_next(@lex)
  assert ret.kind == TOK_RETURN
  assert ret.line == 2
  assert ret.col == 3
  let num: Token = lexer_next(@lex)
  assert num.kind == TOK_NUMBER
  assert num.text.len == 2
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_DEDENT
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_string_is_cooked() -> i32
  var lex: Lexer
  feed(@lex, "\"a\\n\\\"b\\x41\"")   # source text: "a\n\"b\x41"
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_STRING
  assert s.text.len == 12
  assert s.string_val.len == 5
  assert s.string_val.get(0) == 97
  assert s.string_val.get(1) == 10
  assert s.string_val.get(2) == 34
  assert s.string_val.get(3) == 98
  assert s.string_val.get(4) == 65
  0

[[test]]
fn test_an_unterminated_string_is_a_fatal_error_at_its_quote() -> i32
  # ritz0's message and place (lexer.py _lex_string).  The newline before it
  # is counted; lexing stops at the error (#3886: it was "unexpected
  # character" at the cutting newline, which it swallowed uncounted).
  var lex: Lexer
  feed(@lex, "a\nx = \"ab\ny")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.text.get(0) == 34                  # the opening "
  assert bad.line == 2
  assert bad.col == 5
  assert lex.error_msg.eq("Unterminated string literal")
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_a_string_cut_off_by_the_end_of_input_is_the_same_error() -> i32
  var lex: Lexer
  feed(@lex, "x = \"ab")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 5
  assert lex.error_msg.eq("Unterminated string literal")
  assert lex.pos == lex.len
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_cstring_is_cooked_without_braces() -> i32
  var lex: Lexer
  feed(@lex, "c\"\\x41\\t\" c\"\\{\"")
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_CSTRING
  assert s.text.len == 9
  assert s.string_val.len == 2
  assert s.string_val.get(0) == 65
  assert s.string_val.get(1) == 9
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR             # c"..." has no `\{`
  assert bad.col == 14                     # the `{` of `\{`
  assert lex.error_msg.len > 0
  0

[[test]]
fn test_a_cstring_stops_at_its_newline() -> i32
  # As "..." does and ritz0 does (lexer.py _lex_cstring): a raw newline cuts
  # a c"..." off, an error at its `c`, ritz0's span.  It used to take the
  # newline and leave lex.line behind (#3886).
  var lex: Lexer
  feed(@lex, "a\nx = c\"a\nb\" z")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.text.get(0) == 99                  # the c of c"
  assert bad.line == 2
  assert bad.col == 5
  assert lex.error_msg.eq("Unterminated C-string literal")
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_an_unclosed_cstring_is_an_error_not_an_identifier() -> i32
  # No closing quote anywhere: no longer the identifier `c` (#1434), emitted
  # at the end of the line.  At the end of input, lex.pos stops at len.
  var lex: Lexer
  feed(@lex, "c c\"ab")
  let c: Token = lexer_next(@lex)
  assert c.kind == TOK_IDENT               # a `c` with no quote is a name
  assert c.text.len == 1
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 3
  assert lex.error_msg.eq("Unterminated C-string literal")
  assert lex.pos == lex.len
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_an_escaped_quote_does_not_close_a_cstring() -> i32
  var lex: Lexer
  feed(@lex, "c\"a\\\"b\" z")             # source text: c"a\"b" z
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_CSTRING
  assert s.text.len == 7
  assert s.string_val.len == 3
  assert s.string_val.get(1) == 34
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_an_unclosed_cstring_still_refuses_its_bad_escapes() -> i32
  # The escape error comes first, as in ritz0: `\{` is no c"..." escape.
  var lex: Lexer
  feed(@lex, "c\"\\{\n")
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 4
  assert lex.error_msg.len > 0
  0

# AGAST #3888: every token's `start` points into the source, not just those
# lexer_token built.  The layout tokens are zero-length at the byte the
# lexer stands on: an INDENT or DEDENT at the first byte of the line's first
# token (same line and column, so a lookup by `text.ptr` gives that token's
# span either way), the EOF and end-of-input DEDENTs one past the last byte.

# 1 if `tok` is `kind`, starts `off` bytes into `src`, and is `len` long.
fn is_at(tok: Token, kind: i32, src: *u8, off: i64, len: i32) -> i32
  if tok.kind != kind or tok.text.len != len as i64
    return 0
  if (tok.text.ptr as i64) - (src as i64) != off
    return 0
  1

# The next token of `kind`, skipping others.
fn next_of(lex: *Lexer, kind: i32) -> Token
  var tok: Token = lexer_next(lex)
  while tok.kind != kind and tok.kind != TOK_EOF
    tok = lexer_next(lex)
  tok

[[test]]
fn test_indent_and_dedent_point_at_the_next_token() -> i32
  # Offsets: "f\n" 0-1, "  x\n" 2-5 (x at 4), "y\n" 6-7.
  var lex: Lexer
  let src: StrView = "f\n  x\ny\n"
  feed(@lex, src)
  let ind: Token = next_of(@lex, TOK_INDENT)
  assert is_at(ind, TOK_INDENT, src.ptr, 4, 0) == 1
  assert ind.line == 2
  assert ind.col == 3
  let ded: Token = next_of(@lex, TOK_DEDENT)
  assert is_at(ded, TOK_DEDENT, src.ptr, 6, 0) == 1
  assert ded.line == 3
  assert ded.col == 1
  0

[[test]]
fn test_queued_dedents_point_at_the_next_token() -> i32
  # Two blocks close at `z` (offset 10): the first DEDENT and the queued one.
  var lex: Lexer
  let src: StrView = "a\n  b\n    c\nz\n"
  feed(@lex, src)
  let d1: Token = next_of(@lex, TOK_DEDENT)
  assert is_at(d1, TOK_DEDENT, src.ptr, 12, 0) == 1
  let d2: Token = lexer_next(@lex)
  assert is_at(d2, TOK_DEDENT, src.ptr, 12, 0) == 1
  0

[[test]]
fn test_end_of_input_dedent_and_eof_point_past_the_source() -> i32
  var lex: Lexer
  let src: StrView = "a\n  b\n"
  feed(@lex, src)
  let ded: Token = next_of(@lex, TOK_DEDENT)
  assert is_at(ded, TOK_DEDENT, src.ptr, 6, 0) == 1
  let eof: Token = lexer_next(@lex)
  assert is_at(eof, TOK_EOF, src.ptr, 6, 0) == 1
  0

[[test]]
fn test_a_tab_indent_error_points_at_the_tab() -> i32
  # lexer_fail: the tab at offset 3, after the indentation's one space.
  var lex: Lexer
  let src: StrView = "a\n \tb\n"
  feed(@lex, src)
  let bad: Token = next_of(@lex, TOK_ERROR)
  assert is_at(bad, TOK_ERROR, src.ptr, 3, 1) == 1
  assert lex.error_msg.len > 0
  0

[[test]]
fn test_an_asm_body_indent_points_at_its_text() -> i32
  # lexer_asm_line_start's INDENT, at `nop` (offset 14), then the line.
  var lex: Lexer
  let src: StrView = "asm x86_64:\n  nop\n"
  feed(@lex, src)
  let ind: Token = next_of(@lex, TOK_INDENT)
  assert is_at(ind, TOK_INDENT, src.ptr, 14, 0) == 1
  let line: Token = lexer_next(@lex)
  assert is_at(line, TOK_ASM_LINE, src.ptr, 14, 3) == 1
  0
