# ritz1/test/test_ast_query.ritz - ast_query's array dimensions, as values (AGAST #4926)
#
# The emitter and call_check compare an argument's array with the one its
# param points at as ArrayDims: array_dims_1d builds one, array_dims_nd is a
# Result of what an N-D shape leaves once indexed (Err(DimsMiss.NotArray), an
# element, with nothing left), and param_pointee_dims reads a param's, in
# place of C's `int f(ArrayDims *out, ...)`.  Run by `make ritz1-unit`
# (tools/ritz1_unit.py).

import ritzlib.memory
import ritzlib.option
import ritzlib.str
import ritzlib.strview
import ast
import ast_query

# A `[d0][d1][d2]Pt` shape, `rank` deep.
fn shape_of(rank: i32, d0: i32, d1: i32, d2: i32) -> ArrayShape
    var sh: ArrayShape
    memset(@sh as *u8, 0, sizeof(ArrayShape))
    sh.rank = rank
    sh.dims[0] = d0
    sh.dims[1] = d1
    sh.dims[2] = d2
    sh.leaf_type = TypeKind.Struct
    sh.leaf_name = "Pt"
    sh.leaf_pointee = TypeKind.Void
    sh

[[test]]
fn test_a_1d_array_is_one_dimension() -> i32
    let d: ArrayDims = array_dims_1d(5, TypeKind.I32, strview_empty())
    assert d.rank == 1
    assert d.dims[0] == 5
    assert d.leaf == TypeKind.I32
    assert d.name.len == 0
    0

[[test]]
fn test_a_1d_array_of_structs_names_its_element() -> i32
    let d: ArrayDims = array_dims_1d(3, TypeKind.Struct, "Pt")
    assert d.leaf == TypeKind.Struct
    assert d.name.eq("Pt")
    0

[[test]]
fn test_an_unindexed_nd_shape_is_every_dimension() -> i32
    var sh: ArrayShape = shape_of(3, 2, 3, 4)
    let d: ArrayDims = match array_dims_nd(@sh, 0)
        Ok(x) => x
        Err(_) => return 1
    assert d.rank == 3
    assert d.dims[0] == 2 and d.dims[1] == 3 and d.dims[2] == 4
    assert d.leaf == TypeKind.Struct
    assert d.name.eq("Pt")
    0

[[test]]
fn test_an_indexed_nd_shape_is_the_dimensions_left() -> i32
    var sh: ArrayShape = shape_of(3, 2, 3, 4)
    let d: ArrayDims = match array_dims_nd(@sh, 2)
        Ok(x) => x
        Err(_) => return 1
    assert d.rank == 1
    assert d.dims[0] == 4
    assert d.name.eq("Pt")
    0

[[test]]
fn test_a_fully_indexed_nd_shape_is_no_array() -> i32
    var sh: ArrayShape = shape_of(2, 3, 4, 0)
    match array_dims_nd(@sh, 2)
        Ok(_) => return 1
        Err(miss) =>
            assert miss == DimsMiss.NotArray
    0

[[test]]
fn test_indexing_past_an_nd_shape_is_no_array() -> i32
    var sh: ArrayShape = shape_of(2, 3, 4, 0)
    match array_dims_nd(@sh, 3)
        Ok(_) => return 1
        Err(miss) =>
            assert miss == DimsMiss.NotArray
    0

[[test]]
fn test_a_param_points_at_its_1d_array() -> i32
    var p: Param
    memset(@p as *u8, 0, sizeof(Param))
    p.param_pointee_array_size = 6
    p.param_pointee_array_elem_type = TypeKind.U8
    p.param_type_name = strview_empty()
    let d: ArrayDims = param_pointee_dims(@p)
    assert d.rank == 1
    assert d.dims[0] == 6
    assert d.leaf == TypeKind.U8
    0

[[test]]
fn test_a_param_points_at_its_nd_array() -> i32
    var sh: ArrayShape = shape_of(2, 3, 4, 0)
    var p: Param
    memset(@p as *u8, 0, sizeof(Param))
    p.param_pointee_array_shape = @sh
    let d: ArrayDims = param_pointee_dims(@p)
    assert d.rank == 2
    assert d.dims[0] == 3 and d.dims[1] == 4
    assert d.name.eq("Pt")
    0

[[test]]
fn test_dims_match_by_every_dimension() -> i32
    var sh: ArrayShape = shape_of(2, 3, 4, 0)
    var other: ArrayShape = shape_of(2, 3, 5, 0)
    var a: ArrayDims = match array_dims_nd(@sh, 0)
        Ok(x) => x
        Err(_) => return 1
    var b: ArrayDims = match array_dims_nd(@sh, 0)
        Ok(x) => x
        Err(_) => return 1
    var c: ArrayDims = match array_dims_nd(@other, 0)
        Ok(x) => x
        Err(_) => return 1
    assert array_dims_match(@a, @b) == 1
    assert array_dims_match(@a, @c) == 0
    0

[[test]]
fn test_no_call_is_no_variant_constructor() -> i32
    let clash: Option<VariantClash> = user_variant_ctor_ambiguous(null, null)
    assert clash.is_none()
    let miscounted: Option<VariantAt> = user_variant_ctor_miscounted(null, null)
    assert miscounted.is_none()
    0
