# ritz1/test/test_array_src.ritz - the emitter's array and place shapes, as values (AGAST #4926)
#
# emitter_call_lower describes a whole array an expression reads as an
# ArraySrc, built by array_src, and the type of a place as a PlaceType, built
# by place_type and stepped through a pointer by place_deref_type, an Option
# of what `*x` reads, in place of C's `int f(..., ArraySrc *out)` /
# `bool f(..., PlaceType *out)`.  These hold what the constructors build,
# what a deref reaches, and when there is nothing to reach.  Run by
# `make ritz1-unit` (tools/ritz1_unit.py).

import ritzlib.option
import ritzlib.strview
import ast
import emitter_call_lower

[[test]]
fn test_array_src_holds_its_shape() -> i32
    let a: ArraySrc = array_src(4, TypeKind.Struct, "Pt")
    assert a.size == 4
    assert a.elem == TypeKind.Struct
    assert a.name.eq("Pt")
    0

[[test]]
fn test_array_src_of_scalars_names_nothing() -> i32
    let a: ArraySrc = array_src(16, TypeKind.U8, strview_empty())
    assert a.size == 16
    assert a.elem == TypeKind.U8
    assert a.name.len == 0
    0

[[test]]
fn test_place_type_holds_its_parts() -> i32
    let p: PlaceType = place_type(TypeKind.Ptr, TypeKind.Struct, "Pt")
    assert p.kind == TypeKind.Ptr
    assert p.pointee == TypeKind.Struct
    assert p.name.eq("Pt")
    0

[[test]]
fn test_deref_of_a_pointer_is_its_pointee() -> i32
    let d: PlaceType = match place_deref_type(place_type(TypeKind.Ptr, TypeKind.I32, strview_empty()))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.I32
    assert d.pointee == TypeKind.Unknown
    0

[[test]]
fn test_deref_of_a_struct_pointer_holds_the_struct() -> i32
    let d: PlaceType = match place_deref_type(place_type(TypeKind.MutRef, TypeKind.Struct, "Pt"))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.Struct
    assert d.pointee == TypeKind.Struct
    assert d.name.eq("Pt")
    0

[[test]]
fn test_deref_of_a_pointer_pointer_is_a_pointer() -> i32
    let d: PlaceType = match place_deref_type(place_type(TypeKind.PtrPtr, TypeKind.Struct, "Pt"))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.Ptr
    assert d.pointee == TypeKind.Struct
    assert d.name.eq("Pt")
    0

[[test]]
fn test_deref_of_a_non_pointer_is_none() -> i32
    assert place_deref_type(place_type(TypeKind.I64, TypeKind.Unknown, strview_empty())).is_none()
    assert place_deref_type(place_type(TypeKind.Struct, TypeKind.Unknown, "Pt")).is_none()
    0
