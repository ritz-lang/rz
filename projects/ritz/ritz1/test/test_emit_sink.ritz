# ritz1/test/test_emit_sink.ritz - what the format_into sink treats as a register (AGAST #4696)
#
# EmitterState.push_bytes (emitter_core.ritz) is where IR text becomes IR for a
# ported file: a piece of the digits after `%.` is a register operand, and a
# register operand after `, ptr ` is the base of a GEP or the pointer of a
# load/store.  These pin the two decisions, which have no other test: no IR
# text in the corpus reaches them from a ported file.  Run by `make
# ritz1-unit` (tools/ritz1_unit.py).

import ritzlib.strview
import ir_operand

[[test]]
fn test_register_digits_are_a_register() -> i32
    assert register_digits("0") == 0
    assert register_digits("17") == 17
    assert register_digits("2147483647") == 2147483647
    0

[[test]]
fn test_anything_else_is_not_a_register() -> i32
    assert register_digits("") == -1
    assert register_digits("1x") == -1
    assert register_digits("-3") == -1
    assert register_digits("i64") == -1
    assert register_digits("2147483648") == -1      # past an i32
    assert register_digits("12345678901") == -1     # eleven digits
    assert register_digits("00000000000000000001") == -1   # long enough to hide an overflow
    assert register_digits("1:") == -1              # `:` follows `9`
    assert register_digits("1/") == -1              # `/` precedes `0`
    assert register_digits("00000000001") == -1     # eleven digits, however small
    0

[[test]]
fn test_a_ptr_operand_of_a_gep_is_its_base() -> i32
    assert reg_operand_kind_of("  %.7 = getelementptr i8, ptr ") == REG_GEP_BASE
    assert reg_operand_kind_of("  %.7 = getelementptr %Packed, ptr ") == REG_GEP_BASE
    0

[[test]]
fn test_a_ptr_operand_of_a_load_or_store_is_accessed() -> i32
    assert reg_operand_kind_of("  %.9 = load i32, ptr ") == REG_ACCESS_PTR
    assert reg_operand_kind_of("  store i32 %.3, ptr ") == REG_ACCESS_PTR
    0

[[test]]
fn test_any_other_operand_is_plain() -> i32
    assert reg_operand_kind_of("  %.9 = add i64 ") == REG_PLAIN
    assert reg_operand_kind_of("  %.9 = getelementptr i8, ptr %.4, i64 ") == REG_PLAIN
    assert reg_operand_kind_of("  call void @f(ptr ") == REG_PLAIN
    assert reg_operand_kind_of(", ptr ") == REG_PLAIN
    assert reg_operand_kind_of("  %.7 = getelementptr ptr ") == REG_PLAIN    # no separator
    0
