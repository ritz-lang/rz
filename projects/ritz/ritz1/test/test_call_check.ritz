# ritz1/test/test_call_check.ritz - call_check's place types, as values (AGAST #4926)
#
# call_check types an argument's place as a CaPlace: built by ca_place_new,
# and stepped through a pointer by ca_place_deref, an Option of what `*x`
# reads, in place of C's `int f(..., CaPlace *out)`.  These hold what a
# deref reaches, and when there is nothing to reach.  Run by
# `make ritz1-unit` (tools/ritz1_unit.py).

import ritzlib.option
import ritzlib.strview
import ast
import call_check

[[test]]
fn test_deref_of_a_pointer_is_its_pointee() -> i32
    let d: CaPlace = match ca_place_deref(ca_place_new(TypeKind.Ptr, TypeKind.I32, strview_empty()))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.I32
    assert d.pointee == TypeKind.Unknown
    0

[[test]]
fn test_deref_of_a_struct_pointer_holds_the_struct() -> i32
    let d: CaPlace = match ca_place_deref(ca_place_new(TypeKind.Ptr, TypeKind.Struct, "Pt"))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.Struct
    assert d.pointee == TypeKind.Struct
    assert d.name.eq("Pt")
    0

[[test]]
fn test_deref_of_a_pointer_pointer_is_a_pointer() -> i32
    let d: CaPlace = match ca_place_deref(ca_place_new(TypeKind.PtrPtr, TypeKind.Ptr, "Pt"))
        Some(p) => p
        None => return 1
    assert d.kind == TypeKind.Ptr
    assert d.pointee == TypeKind.Struct
    0

[[test]]
fn test_a_value_has_nothing_to_deref() -> i32
    let found: Option<CaPlace> = ca_place_deref(ca_place_new(TypeKind.I32, TypeKind.Void, strview_empty()))
    assert found.is_none()
    0
