# ritz1/test/test_let_check.ritz - let_check's places and values, as values (AGAST #4926)
#
# let_check walks a write's target down a `let`'s own storage as a LetPlace,
# each step an Option of the next place (let_place_index here), and types an
# untyped `let`'s value as an Option<SemaTy> (let_value), in place of C's
# `int f(..., LetPlace *out)`.  These hold what each step reaches, and when it
# reaches nothing.  Run by `make ritz1-unit` (tools/ritz1_unit.py).

import ritzlib.str
import ritzlib.option
import ritzlib.strview
import ast
import sema
import let_check

# A `[d0][d1]Pt` shape.
fn shape_2d(d0: i32, d1: i32) -> ArrayShape
    var sh: ArrayShape
    memset(@sh as *u8, 0, sizeof(ArrayShape))
    sh.rank = 2
    sh.dims[0] = d0
    sh.dims[1] = d1
    sh.leaf_type = TypeKind.Struct
    sh.leaf_name = "Pt"
    sh.leaf_pointee = TypeKind.Void
    sh

[[test]]
fn test_an_element_of_a_1d_array_is_its_element_type() -> i32
    var a: LetPlace = let_place_new("xs", TypeKind.Array, strview_empty())
    a.elem = TypeKind.Struct
    a.elem_name = "Pt"
    let e: LetPlace = match let_place_index(a)
        Some(p) => p
        None => return 1
    assert e.kind == TypeKind.Struct
    assert e.type_name.eq("Pt")
    assert e.elem == TypeKind.Void and e.elem_name.len == 0
    assert e.name.eq("xs")
    0

[[test]]
fn test_an_nd_array_is_its_leaf_once_every_dimension_is_indexed() -> i32
    var sh: ArrayShape = shape_2d(2, 3)
    var g: LetPlace = let_place_new("g", TypeKind.Array, strview_empty())
    g.shape = @sh
    let row: LetPlace = match let_place_index(g)
        Some(p) => p
        None => return 1
    assert row.kind == TypeKind.Array
    assert row.depth == 1
    let cell: LetPlace = match let_place_index(row)
        Some(p) => p
        None => return 2
    assert cell.kind == TypeKind.Struct
    assert cell.type_name.eq("Pt")
    assert cell.shape == null and cell.depth == 0
    0

[[test]]
fn test_a_pointer_has_no_element_in_the_let() -> i32
    let p: LetPlace = let_place_new("p", TypeKind.Ptr, "Pt")
    let found: Option<LetPlace> = let_place_index(p)
    assert found.is_none()
    0

[[test]]
fn test_let_value_types_structs_and_scalars_only() -> i32
    let s: SemaTy = match let_value(TypeKind.Struct, "Pt")
        Some(t) => t
        None => return 1
    assert s.kind == TypeKind.Struct and s.name.eq("Pt")
    # A scalar keeps no name.
    let i: SemaTy = match let_value(TypeKind.I32, "ignored")
        Some(t) => t
        None => return 2
    assert i.kind == TypeKind.I32 and i.name.len == 0
    let nameless: Option<SemaTy> = let_value(TypeKind.Struct, strview_empty())
    assert nameless.is_none()
    let ptr: Option<SemaTy> = let_value(TypeKind.Ptr, "Pt")
    assert ptr.is_none()
    0
