# ritz1/test/test_lexer_nfa.ritz - unit tests for ritz1/src/lexer_nfa.ritz
#
# Run by `make ritz1-unit` (tools/ritz1_unit.py), a bootstrap gate step.
# The lexer is the direct-coded scanner of AGAST #1821: lexer_init takes the
# source and nothing else, and every rule below is the grammar's token
# definition (grammars/ritz1.grammar) as the NFA lexer it replaced lexed it.

import ritzlib.str
import ritzlib.strview
import tokens_gen
import lexer_nfa

fn feed(lex: *Lexer, src: StrView)
  lexer_init(lex, src.ptr, src.len)

# The next token's kind (`assert next_kind(lex) == TOK_X` prints both).
fn next_kind(lex: *Lexer) -> i32
  let tok: Token = lexer_next(lex)
  tok.kind

# The next token's length.
fn next_len(lex: *Lexer) -> i32
  let tok: Token = lexer_next(lex)
  tok.len

[[test]]
fn test_tokens_in_order() -> i32
  var lex: Lexer
  feed(@lex, "main ( x)")
  let t1: Token = lexer_next(@lex)
  assert t1.kind == TOK_IDENT
  assert t1.len == 4
  assert *t1.start == 109  # m
  assert t1.line == 1
  assert t1.col == 1
  let t2: Token = lexer_next(@lex)
  assert t2.kind == TOK_LPAREN
  assert t2.col == 6       # the skipped space still advances the column
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_RPAREN
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_keyword_beats_identifier_of_the_same_length() -> i32
  # Longest match, then the keyword: `as` and `asm` are keywords, `asmx`
  # and `i8x` identifiers.
  var lex: Lexer
  feed(@lex, "as asm asmx i8 i8x _")
  assert next_kind(@lex) == TOK_AS
  assert next_kind(@lex) == TOK_ASM
  let t: Token = lexer_next(@lex)
  assert t.kind == TOK_IDENT
  assert t.len == 4
  assert next_kind(@lex) == TOK_I8
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_operators_take_the_longest_match() -> i32
  var lex: Lexer
  feed(@lex, "..= .. . [[ >>= ->")
  assert next_kind(@lex) == TOK_DOTDOTEQ
  assert next_kind(@lex) == TOK_DOTDOT
  assert next_kind(@lex) == TOK_DOT
  assert next_kind(@lex) == TOK_LBRACKET2
  assert next_kind(@lex) == TOK_SHR       # no `>>=`: `>>` then `=`
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_ARROW
  0

[[test]]
fn test_colon_amp_is_one_token_only_unspaced() -> i32
  # AGAST #1565: `:&` is the borrow sigil, as ritz0 lexes it; `: &` is a
  # COLON and the legacy `&T` type's AMP.  `:&&` is `:&` then `&`.
  var lex: Lexer
  feed(@lex, ":& : & :&&")
  assert next_kind(@lex) == TOK_COLON_AMP
  assert next_kind(@lex) == TOK_COLON
  assert next_kind(@lex) == TOK_AMP
  assert next_kind(@lex) == TOK_COLON_AMP
  assert next_kind(@lex) == TOK_AMP
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_colon_eq_is_one_token_only_unspaced() -> i32
  # AGAST #3911: `:=` is the move-parameter sigil, as ritz0 lexes it; `: =`
  # is a COLON and an ASSIGN.  `:==` is `:=` then `=`.
  var lex: Lexer
  feed(@lex, ":= : = :==")
  assert next_kind(@lex) == TOK_COLON_EQ
  assert next_kind(@lex) == TOK_COLON
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_COLON_EQ
  assert next_kind(@lex) == TOK_ASSIGN
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_numbers_and_their_suffixes() -> i32
  var lex: Lexer
  feed(@lex, "0x1F 0b102 0x 1.5 1. 7u8 5usize_max 2.5f32 ")
  let hex: Token = lexer_next(@lex)
  assert hex.kind == TOK_NUMBER
  assert hex.len == 4
  assert next_len(@lex) == 4               # 0b10, then the 2
  assert next_len(@lex) == 1
  assert next_len(@lex) == 1               # `0x` with no digit is `0` then `x`
  assert next_kind(@lex) == TOK_IDENT
  let f: Token = lexer_next(@lex)
  assert f.kind == TOK_FLOAT
  assert f.len == 3
  assert next_kind(@lex) == TOK_NUMBER     # `1.` is no float
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 3               # 7u8
  assert next_len(@lex) == 1               # 5, then usize_max
  assert next_kind(@lex) == TOK_IDENT
  let f32: Token = lexer_next(@lex)
  assert f32.kind == TOK_FLOAT
  assert f32.len == 6
  0

[[test]]
fn test_a_tuple_index_after_a_dot_is_no_float() -> i32
  var lex: Lexer
  feed(@lex, "p.0.1")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  assert next_kind(@lex) == TOK_DOT
  assert next_len(@lex) == 1
  0

[[test]]
fn test_char_literals() -> i32
  var lex: Lexer
  feed(@lex, "'a' '\\'' '\\x41' ''")
  assert next_len(@lex) == 3
  assert next_len(@lex) == 4
  let x: Token = lexer_next(@lex)
  assert x.kind == TOK_CHAR
  assert x.len == 6
  assert next_kind(@lex) == TOK_ERROR      # '' is no char literal
  0

[[test]]
fn test_a_short_hex_char_is_a_located_error() -> i32
  var lex: Lexer
  feed(@lex, "x = '\\x4'")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 7                      # the `x` of `\x4`
  assert lex.error_msg != null
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_unmatched_byte_is_one_error_token() -> i32
  var lex: Lexer
  feed(@lex, "a`b")
  assert next_kind(@lex) == TOK_IDENT
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.len == 1
  assert *bad.start == 96  # `
  assert lex.error_msg == null
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_dollar_is_a_fatal_error() -> i32
  # `$` outside asm is refused with a message, and lexing stops there.
  var lex: Lexer
  feed(@lex, "a$b")
  assert next_kind(@lex) == TOK_IDENT
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert *bad.start == 36  # $
  assert lex.error_msg != null
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_a_nul_byte_is_source_not_the_end() -> i32
  var lex: Lexer
  feed(@lex, "a\0b")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ERROR
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_reinit_lexes_a_new_source() -> i32
  var lex: Lexer
  feed(@lex, "main()")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_LPAREN
  # A second source, mid-way through the first: position, line and column
  # all restart.
  feed(@lex, "(zz")
  let t: Token = lexer_next(@lex)
  assert t.kind == TOK_LPAREN
  assert t.col == 1
  assert t.line == 1
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_function_header_and_block() -> i32
  var lex: Lexer
  feed(@lex, "fn main() -> i32\n  return 42\n")
  assert next_kind(@lex) == TOK_FN
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_LPAREN
  assert next_kind(@lex) == TOK_RPAREN
  assert next_kind(@lex) == TOK_ARROW
  assert next_kind(@lex) == TOK_I32
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_INDENT
  let ret: Token = lexer_next(@lex)
  assert ret.kind == TOK_RETURN
  assert ret.line == 2
  assert ret.col == 3
  let num: Token = lexer_next(@lex)
  assert num.kind == TOK_NUMBER
  assert num.len == 2
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_DEDENT
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_string_is_cooked() -> i32
  var lex: Lexer
  feed(@lex, "\"a\\n\\\"b\\x41\"")   # source text: "a\n\"b\x41"
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_STRING
  assert s.len == 12
  assert s.string_len == 5
  assert *(s.string_val + 0) == 97
  assert *(s.string_val + 1) == 10
  assert *(s.string_val + 2) == 34
  assert *(s.string_val + 3) == 98
  assert *(s.string_val + 4) == 65
  0

[[test]]
fn test_an_unterminated_string_is_a_fatal_error_at_its_quote() -> i32
  # ritz0's message and place (lexer.py _lex_string).  The newline before it
  # is counted; lexing stops at the error (#3886: it was "unexpected
  # character" at the cutting newline, which it swallowed uncounted).
  var lex: Lexer
  feed(@lex, "a\nx = \"ab\ny")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert *bad.start == 34                  # the opening "
  assert bad.line == 2
  assert bad.col == 5
  assert streq(lex.error_msg, c"Unterminated string literal") == 1
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_a_string_cut_off_by_the_end_of_input_is_the_same_error() -> i32
  var lex: Lexer
  feed(@lex, "x = \"ab")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 5
  assert streq(lex.error_msg, c"Unterminated string literal") == 1
  assert lex.pos == lex.len
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_cstring_is_cooked_without_braces() -> i32
  var lex: Lexer
  feed(@lex, "c\"\\x41\\t\" c\"\\{\"")
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_CSTRING
  assert s.len == 9
  assert s.string_len == 2
  assert *(s.string_val + 0) == 65
  assert *(s.string_val + 1) == 9
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR             # c"..." has no `\{`
  assert bad.col == 14                     # the `{` of `\{`
  assert lex.error_msg != null
  0

[[test]]
fn test_a_cstring_stops_at_its_newline() -> i32
  # As "..." does and ritz0 does (lexer.py _lex_cstring): a raw newline cuts
  # a c"..." off, an error at its `c`, ritz0's span.  It used to take the
  # newline and leave lex.line behind (#3886).
  var lex: Lexer
  feed(@lex, "a\nx = c\"a\nb\" z")
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_NEWLINE
  assert next_kind(@lex) == TOK_IDENT
  assert next_kind(@lex) == TOK_ASSIGN
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert *bad.start == 99                  # the c of c"
  assert bad.line == 2
  assert bad.col == 5
  assert streq(lex.error_msg, c"Unterminated C-string literal") == 1
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_an_unclosed_cstring_is_an_error_not_an_identifier() -> i32
  # No closing quote anywhere: no longer the identifier `c` (#1434), emitted
  # at the end of the line.  At the end of input, lex.pos stops at len.
  var lex: Lexer
  feed(@lex, "c c\"ab")
  let c: Token = lexer_next(@lex)
  assert c.kind == TOK_IDENT               # a `c` with no quote is a name
  assert c.len == 1
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 3
  assert streq(lex.error_msg, c"Unterminated C-string literal") == 1
  assert lex.pos == lex.len
  assert next_kind(@lex) == TOK_EOF
  0

[[test]]
fn test_an_escaped_quote_does_not_close_a_cstring() -> i32
  var lex: Lexer
  feed(@lex, "c\"a\\\"b\" z")             # source text: c"a\"b" z
  let s: Token = lexer_next(@lex)
  assert s.kind == TOK_CSTRING
  assert s.len == 7
  assert s.string_len == 3
  assert *(s.string_val + 1) == 34
  assert next_kind(@lex) == TOK_IDENT
  0

[[test]]
fn test_an_unclosed_cstring_still_refuses_its_bad_escapes() -> i32
  # The escape error comes first, as in ritz0: `\{` is no c"..." escape.
  var lex: Lexer
  feed(@lex, "c\"\\{\n")
  let bad: Token = lexer_next(@lex)
  assert bad.kind == TOK_ERROR
  assert bad.col == 4
  assert lex.error_msg != null
  0
