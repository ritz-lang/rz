# ritz1/test/test_byte_buffers.ritz - hex digests are Strings (AGAST #4924)
#
# sha256_hex and u64_to_hex16 return their digits as a String rather than
# writing them into a caller's `*u8`.  Their hex is part of the fn cache's and
# the interface-text store's keys, which ritz0 writes too, so the digits must
# not change: these pin them against Python's hashlib and the 16-digit
# zero-padded form hex16_strict reads back.  Run by `make ritz1-unit`
# (tools/ritz1_unit.py).

import ritzlib.string
import ritzlib.strview
import sha256
import fn_cache

# `n` copies of 'a'.
fn a_times(n: i64) -> String
    var s: String = string_new()
    for i in 0..n
        s.push('a')
    s

# sha256_hex of `n` 'a's is `want`.
fn sha_of_as_is(n: i64, want: StrView) -> bool
    var data: String = a_times(n)
    var hex: String = sha256_hex(data.as_view())
    hex.eq(want)

[[test]]
fn test_sha256_hex_of_empty_and_abc() -> i32
    var empty: String = sha256_hex("")
    assert empty.eq("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    var abc: String = sha256_hex("abc")
    assert abc.eq("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    0

# The padding takes one tail block below 56 bytes of remainder and two from
# 56 on; 64 is a whole block and an empty tail.
[[test]]
fn test_sha256_hex_across_the_tail_block_boundaries() -> i32
    assert sha_of_as_is(55, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
    assert sha_of_as_is(56, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
    assert sha_of_as_is(64, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")
    assert sha_of_as_is(119, "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb")
    assert sha_of_as_is(200, "c2a908d98f5df987ade41b5fce213067efbcc21ef2240212a41e54b5e7c28ae5")
    0

# A view with more bytes after it hashes only its own.
[[test]]
fn test_sha256_hex_reads_only_the_view() -> i32
    let text: StrView = "abcdef"
    var hex: String = sha256_hex(text.take(3))
    assert hex.eq("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    0

[[test]]
fn test_u64_to_hex16_is_sixteen_zero_padded_digits() -> i32
    var zero: String = u64_to_hex16(0)
    assert zero.eq("0000000000000000")
    var mixed: String = u64_to_hex16(0x0123456789abcdef)
    assert mixed.eq("0123456789abcdef")
    var top: String = u64_to_hex16(0xfedcba9876543210)
    assert top.eq("fedcba9876543210")
    0

# The memo and sig readers parse the digits back: the round trip is exact.
[[test]]
fn test_u64_to_hex16_round_trips_through_hex16_to_u64() -> i32
    let h: u64 = 0x8000000000000001
    var hex: String = u64_to_hex16(h)
    assert hex16_to_u64(hex.as_view()) == h
    0
