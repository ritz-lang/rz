# ritz1/test/test_generic_infer.ritz - generic_infer's GiType builders, as values (AGAST #4926)
#
# generic_infer types a call's arguments as GiTypes.  Its builders return one
# (gi_new) or an Option of one where a type may not spell (gi_array_spell,
# gi_ptr_type, gi_type_from_suffix), in place of C's `int f(..., GiType *out)`.
# These hold what each builds, and when it builds nothing.  Run by
# `make ritz1-unit` (tools/ritz1_unit.py).

import ritzlib.option
import ritzlib.strview
import ast
import generic_infer

[[test]]
fn test_gi_new_is_what_it_is_given() -> i32
    let t: GiType = gi_new(TypeKind.Ptr, "Point", TypeKind.Struct)
    assert t.kind == TypeKind.Ptr
    assert t.name.eq("Point")
    assert t.pointee == TypeKind.Struct
    0

[[test]]
fn test_an_array_spells_as_a_type_argument() -> i32
    let a: GiType = match gi_array_spell(4, TypeKind.I32, strview_empty(), TypeKind.Void)
        Some(t) => t
        None => return 1
    assert a.kind == TypeKind.Array and a.pointee == TypeKind.Void
    assert a.name.eq("arr4_i32")
    let p: GiType = match gi_array_spell(2, TypeKind.Ptr, "Point", TypeKind.Struct)
        Some(t) => t
        None => return 2
    assert p.name.eq("arr2_ptr_Point")
    assert gi_array_spell(0, TypeKind.I32, strview_empty(), TypeKind.Void).is_none()   # no N
    assert gi_array_spell(3, TypeKind.Void, strview_empty(), TypeKind.Void).is_none()  # no E
    0

[[test]]
fn test_a_pointer_is_to_a_primitive_or_a_named_struct() -> i32
    let pp: GiType = match gi_ptr_type(TypeKind.Ref, strview_empty(), TypeKind.U8)
        Some(t) => t
        None => return 1
    assert pp.kind == TypeKind.Ref and pp.pointee == TypeKind.U8 and pp.name.len == 0
    let ps: GiType = match gi_ptr_type(TypeKind.Ptr, "Point", TypeKind.Void)
        Some(t) => t
        None => return 2
    assert ps.pointee == TypeKind.Struct and ps.name.eq("Point")
    assert gi_ptr_type(TypeKind.Ptr, strview_empty(), TypeKind.Struct).is_none()   # unnamed
    0

[[test]]
fn test_a_suffix_names_a_type_or_none() -> i32
    let u: GiType = match gi_type_from_suffix("$u8")
        Some(t) => t
        None => return 1
    assert u.kind == TypeKind.U8 and u.name.len == 0
    let s: GiType = match gi_type_from_suffix("$Point")
        Some(t) => t
        None => return 2
    assert s.kind == TypeKind.Struct and s.name.eq("Point")
    let p: GiType = match gi_type_from_suffix("$ptr_u8")
        Some(t) => t
        None => return 3
    assert p.kind == TypeKind.Ptr and p.pointee == TypeKind.U8
    let a: GiType = match gi_type_from_suffix("$arr4_i32")
        Some(t) => t
        None => return 4
    assert a.kind == TypeKind.Array and a.name.eq("arr4_i32")
    assert gi_type_from_suffix("$").is_none()
    0
