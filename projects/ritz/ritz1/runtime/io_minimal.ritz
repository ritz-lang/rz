# Minimal I/O functions for ritz1 examples
# Only pure functions - no malloc/free/String dependencies

import ritzlib.sys

fn prints(s: *u8)
    var len: i64 = 0
    while *(s + len) != 0
        len = len + 1
    sys_write(STDOUT, s, len)

fn eprints(s: *u8)
    var len: i64 = 0
    while *(s + len) != 0
        len = len + 1
    sys_write(STDERR, s, len)

fn print_char(c: u8)
    var buf: [1]u8
    buf[0] = c
    sys_write(STDOUT, @buf[0], 1)

fn eprint_char(c: u8)
    var buf: [1]u8
    buf[0] = c
    sys_write(STDERR, @buf[0], 1)

# The decimal digits of n into buf (20 bytes, enough for u64's maximum);
# returns how many.  "0" for zero.
fn fmt_u64_minimal(buf: *u8, n: u64) -> i64
    var len: i64 = 1
    var tmp: u64 = n / 10
    while tmp > 0
        len = len + 1
        tmp = tmp / 10
    var v: u64 = n
    var i: i64 = len - 1
    while i >= 0
        *(buf + i) = ((v % 10) + 48) as u8
        v = v / 10
        i = i - 1
    len

# n in decimal to fd.  The magnitude is taken in u64: `0 - n` has no i64
# result for i64's minimum and stops the program (LARB R63, AGAST #4572).
fn write_int(fd: i32, n: i64)
    var buf: [21]u8
    var len: i64 = 0
    var mag: u64 = n as u64
    if n < 0
        buf[0] = 45  # '-'
        len = 1
        mag = 0 -% mag
    len = len + fmt_u64_minimal(@buf[len], mag)
    sys_write(fd, @buf[0], len)

fn print_int(n: i64)
    write_int(STDOUT, n)

fn eprint_int(n: i64)
    write_int(STDERR, n)
