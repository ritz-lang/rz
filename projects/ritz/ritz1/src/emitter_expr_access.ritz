# Auto-extracted from emitter_expr.ritz — IDENT + INDEX + MEMBER codegen.

import ast
import index_through
import ast_helpers
import emitter_core
import emitter_expr
import emitter_expr_arith   # emit_nd_index_value (AGAST #1509)


# Check if ident name is "None" (4 chars: N o n e).
fn is_ident_none(name: *u8, len: i32) -> i32
    if len == 4
        if *name == 78 and *(name + 1) == 111 and *(name + 2) == 110 and *(name + 3) == 101
            return 1
    return 0

fn emit_whole_array_error(s: *EmitterState, e: *Expr)
    emit_nd_error(s, e.span.line, e.span.col, c"a whole array is not a value here in ritz1 (index it, copy it into an array of the same type, or take its address with @)")

fn emit_expr_ident(s: *EmitterState, e: *Expr) -> i32
    # AGAST #1509: a multi-dimensional array as a whole value (`h = g`,
    # `f(g)`, ...) is not lowered: the paths below load one i64 out of it.
    # `a:& [N][M]T` has a value, its pointer, as below (AGAST #2290).
    if nd_array_ident_shape(s, e) != null and lent_array_ident(s, e) == null
        emit_nd_error(s, e.span.line, e.span.col, c"a multi-dimensional array is not a value in ritz1 (index it, or take an element's address with @)")
        return 0
    # Unit-variant None → `%Option$... = { i8 1, [N x i8] zero }` aggregate
    # (ritz-task-133: matches ritz0 tag convention Some=0, None=1).
    if is_ident_none(e.ident_ptr, e.ident_len) == 1
        # Only treat as None if not shadowed by local/global/const.
        if is_const(s, e.ident_ptr, e.ident_len) == 0
            if find_local(s, e.ident_ptr, e.ident_len) < 0
                if find_global(s, e.ident_ptr, e.ident_len) == null
                    # Resolve enum context (var decl / call param, else the
                    # fn return type outside call args) — shared with
                    # Some/Ok/Err ctors (AGAST #1498).
                    var enum_name: *u8 = null
                    var enum_name_len: i32 = 0
                    resolve_enum_ctx(s, @enum_name, @enum_name_len)
                    if enum_name == null
                        return emit_no_enum_ctx_error(s, e)   # AGAST #2454
                    # alloca + zero-init + store tag=1 + load.
                    let slot: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, slot)
                    emit_str(s, c" = alloca %")
                    emit_name(s, enum_name, enum_name_len)
                    emit_str(s, c"  ; None\n")
                    emit_str(s, c"  store %")
                    emit_name(s, enum_name, enum_name_len)
                    emit_str(s, c" zeroinitializer, ptr ")
                    emit_reg(s, slot)
                    emit_str(s, c"\n")
                    let tptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, tptr)
                    emit_str(s, c" = getelementptr %")
                    emit_name(s, enum_name, enum_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, slot)
                    emit_str(s, c", i32 0, i32 0\n")
                    emit_str(s, c"  store i8 1, ptr ")
                    emit_reg(s, tptr)
                    emit_str(s, c"\n")
                    let result: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, result)
                    emit_str(s, c" = load %")
                    emit_name(s, enum_name, enum_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, slot)
                    emit_str(s, c"\n")
                    return result

    if is_const(s, e.ident_ptr, e.ident_len) == 1
        # AGAST #189 — scalar struct consts (`const FOO: StrView = "..."`)
        # are emitted by emit_const_struct_entry as a real `%StructTy`
        # global; load the aggregate so call sites that expect a struct
        # type (e.g. mausoleum's `build_path(suffix: StrView, ...)`) are
        # fed a properly-typed value instead of the legacy `add i64 0, 0`
        # which produced the i64-vs-%StrView verifier error.
        let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
        if ce != null and ce.const_type == TYPE_ARRAY
            emit_whole_array_error(s, e)   # AGAST #2287, as for a local
            return 0
        if ce != null and ce.const_type == TYPE_STRUCT and ce.type_name_len > 0 and ce.value_expr != null and ce.value_expr.kind == EXPR_STRING_LIT
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            emit_str(s, c" = load %")
            emit_name(s, ce.type_name, ce.type_name_len)
            emit_str(s, c", ptr @")
            emit_name(s, ce.name, ce.name_len)
            emit_str(s, c"\n")
            return result
        # AGAST #2341: a string `*u8` const is its literal.  Its folded value is
        # 0, which is what `*P` used to read.
        if ce != null and ce.const_type == TYPE_PTR and ce.value_expr != null and ce.value_expr.kind == EXPR_CSTRING_LIT
            return emit_expr(s, ce.value_expr)
        # AGAST #2155: an integer-initialised float const is its float value.
        var folded: i64 = 0
        let cft: i32 = const_int_init_float_ty(s, ce, @folded)
        if cft != 0
            let fres: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, fres)
            emit_str(s, c" = sitofp i64 ")
            emit_int(s, folded)
            if cft == TYPE_F32
                emit_str(s, c" to float\n")
            else
                emit_str(s, c" to double\n")
            return fres
        let val: i64 = find_const(s, e.ident_ptr, e.ident_len)
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, val)
        emit_str(s, c"\n")
        return result

    let loc: i32 = find_local(s, e.ident_ptr, e.ident_len)
    if loc >= 0
        let local_var: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        let var_type: i32 = local_var.var_type
        # AGAST #2287: this path has no array value to give; loading the slot
        # read the first 8 bytes as an i64.  Whatever takes a whole array has
        # its own path (emit_array_local_whole_assign, emit_call_arg).
        # AGAST #2290: `a:& [N]T` does have one: read bare it's the borrow's
        # pointer, which a reference slot takes.
        if var_type == TYPE_ARRAY
            if lent_array_ident(s, e) != null
                return loc
            emit_whole_array_error(s, e)
            return 0
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load ")
        emit_llvm_type_struct(s, var_type, local_var.type_name, local_var.type_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, loc)
        emit_str(s, c"\n")

        if var_type == TYPE_I32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = sext i32 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if var_type == TYPE_U32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i32 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if var_type == TYPE_U8 or var_type == TYPE_I8
            # AGAST #2021: i8 sign-extends, matching the i8 global reload and
            # every *i8 / [N]i8 element load; zext made `let x: i8 = -3`
            # compare as 0xFD against a sext'd p[i] of 0xFF..FD.
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            if var_type == TYPE_I8
                emit_str(s, c" = sext i8 ")
            else
                emit_str(s, c" = zext i8 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if var_type == TYPE_U16 or var_type == TYPE_I16
            # Was missing: u16/i16 idents left their value at i16 width,
            # so any subsequent `store i64 %val` (the unified-i64 path)
            # produced an LLVM type-mismatch error.  Extend like u8/i8.
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            if var_type == TYPE_I16
                emit_str(s, c" = sext i16 ")
            else
                emit_str(s, c" = zext i16 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if var_type == TYPE_BOOL
            # AGAST #2994: a `b:& bool` param's one byte, as the i64 a bool
            # value lives in (#1646).
            let bext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bext)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return bext
        else if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
            # Pointers are already stored/loaded as i64, no conversion needed
            return result
        return result

    # Check for global variable
    let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
    if glob != null
        if glob.var_type == TYPE_ARRAY
            emit_whole_array_error(s, e)   # AGAST #2287, as for a local
            return 0
        # Load from global variable.  AGAST #2427: a struct is loaded whole at
        # its own type, as a local is; `emit_llvm_type` gave it i64, so every
        # site taking the value (`return gh`, `var v: Vec<i32> = g`, an
        # argument, a field init, an assignment) was invalid IR.
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load ")
        if glob.var_type == TYPE_STRUCT and glob.type_name_len > 0
            emit_llvm_type_struct(s, glob.var_type, glob.type_name, glob.type_name_len)
        else
            emit_llvm_type(s, glob.var_type)
        emit_str(s, c", ptr @")
        emit_name(s, glob.name, glob.name_len)
        emit_str(s, c"\n")
        # Extend to i64 if needed
        if glob.var_type == TYPE_I32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = sext i32 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if glob.var_type == TYPE_U32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i32 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if glob.var_type == TYPE_U16 or glob.var_type == TYPE_I16
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            if glob.var_type == TYPE_I16
                emit_str(s, c" = sext i16 ")
            else
                emit_str(s, c" = zext i16 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if glob.var_type == TYPE_U8 or glob.var_type == TYPE_I8
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            if glob.var_type == TYPE_I8
                emit_str(s, c" = sext i8 ")
            else
                emit_str(s, c" = zext i8 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return ext
        else if glob.var_type == TYPE_BOOL
            # AGAST #3001: the i1 byte, as the i64 a bool value lives in
            # (#1646), as for a `b:& bool` param above.  The raw i1 was invalid
            # IR in `not g`, `g and h`, `g as i32` and `f(g)`.
            let bext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bext)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, result)
            emit_str(s, c" to i64\n")
            return bext
        return result

    # AGAST #1503: a function name used as a value (`apply(double, 5)`,
    # `let f: fn(i32) -> i32 = double`, `cb as *u8`) yields the function's
    # address.  Checked after locals/globals so those still shadow a fn of
    # the same name.  fn_map holds both this module's fns and the ones merged
    # in from imports; the extern is registered unconditionally because
    # emit_extern_declarations skips any fn this .ll defines itself, so an
    # imported fn (defined in another .ll) gets its `declare` and a local one
    # doesn't.  Pointers are i64 in ritz1's unified value model.
    let fn_def: *FnDef = find_fn(s, e.ident_ptr, e.ident_len)
    if fn_def != null
        add_extern(s, fn_def.name, fn_def.name_len)
        let fn_addr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fn_addr)
        emit_str(s, c" = ptrtoint ptr @")
        emit_name(s, fn_def.name, fn_def.name_len)
        emit_str(s, c" to i64\n")
        return fn_addr

    # AGAST #2422: `Empty` where the slot is a `Slot<i32>`.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, e.ident_ptr, e.ident_len, @ivi)
    if iei >= 0 and enum_variant_kind(iei, ivi) == ENUM_VARIANT_UNIT
        var in_len: i32 = 0
        let in_name: *u8 = enum_name_at(iei, @in_len)
        return emit_unit_variant_value(s, in_name, in_len, ivi)

    # AGAST #1600 / #1610: a bare unit variant `B` of a user enum, as the
    # qualified `S.B` builds it.  Checked last, so a const / local / global /
    # fn of the same name still wins (bare_unit_variant_enum also checks).
    var vi: i32 = 0
    var other_ei: i32 = 0
    let var_ei: i32 = bare_unit_variant_enum(s, e, @vi, @other_ei)
    if var_ei >= 0
        var en_len: i32 = 0
        let en: *u8 = enum_name_at(var_ei, @en_len)
        return emit_unit_variant_value(s, en, en_len, vi)
    if var_ei == 0 - 2
        return emit_ambiguous_variant_error(s, e.ident_ptr, e.ident_len, e.span, vi, other_ei)

    emit_ir_error_begin(s, c"unknown identifier '")
    emit_ir_error_end(s, e.ident_ptr, e.ident_len)
    let zero: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, zero)
    emit_str(s, c" = add i64 0, 0\n")
    return zero

# LLVM element type of a primitive const array, matching the emit_llvm_type
# spelling emit_const_array_entry used for the `@NAME = internal constant
# [N x T]` global, so the GEP stride equals the stored stride. Null for
# element kinds emit_global_array_index cannot load and widen to i64
# (struct, float, bool) — those keep their previous lowering.
fn const_array_elem_llvm(t: i32) -> *u8
    if t == TYPE_I8 or t == TYPE_U8
        return c"i8"
    if t == TYPE_I16 or t == TYPE_U16
        return c"i16"
    if t == TYPE_I32 or t == TYPE_U32
        return c"i32"
    if t == TYPE_I64 or t == TYPE_U64
        return c"i64"
    if t == TYPE_PTR
        return c"ptr"   # AGAST #2357: `const A: [N]*u8 = ["A", "B"]`
    return null

# `name[idx]` on a module-level `[size x elem_ty]` global (a `var` global or a
# primitive const array): GEP the global directly, load the element at its
# width, and widen it to the i64 every expression value is carried in.
fn emit_global_array_index(s: *EmitterState, name: *u8, name_len: i32, size: i32, elem_t: i32, elem_ty: *u8, idx_expr: *Expr) -> i32
    let gidx: i32 = emit_expr(s, idx_expr)
    let gptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, gptr)
    emit_str(s, c" = getelementptr [")
    emit_int(s, size as i64)
    emit_str(s, c" x ")
    emit_str(s, elem_ty)
    emit_str(s, c"], ptr @")
    emit_name(s, name, name_len)
    emit_str(s, c", i64 0, i64 ")
    emit_reg(s, gidx)
    emit_str(s, c"\n")
    let gval: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, gval)
    emit_str(s, c" = load ")
    emit_str(s, elem_ty)
    emit_str(s, c", ptr ")
    emit_reg(s, gptr)
    emit_str(s, c"\n")
    return emit_array_elem_widen(s, gval, elem_t, elem_ty)

# `v[i]` element read through a pointer to a Vec$T struct: load the data
# pointer (field 0), GEP by the element stride decoded from the `Vec$<T>`
# suffix, load and widen to i64.  `vec_ptr` is a `ptr` register: a Vec
# local's alloca, or the value of a `@Vec<T>` / `@&Vec<T>` reference.
fn emit_vec_ptr_index(s: *EmitterState, vec_ptr: i32, type_name: *u8, type_name_len: i32, idx_expr: *Expr) -> i32
    let idx_v: i32 = emit_expr(s, idx_expr)
    # GEP to data ptr field (index 0 of Vec struct)
    let v_data_ptr_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v_data_ptr_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, vec_ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let v_data_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v_data_ptr)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, v_data_ptr_ptr)
    emit_str(s, c"\n")
    # Decode element type from suffix after "Vec$".
    let v_en: *u8 = type_name + 4
    let v_el: i32 = type_name_len - 4
    var v_ty: *u8 = c"i64"
    var v_kind: i32 = TYPE_I64
    if v_el == 2 and *(v_en + 0) == 'u' and *(v_en + 1) == '8'
        v_ty = c"i8"
        v_kind = TYPE_U8
    else if v_el == 2 and *(v_en + 0) == 'i' and *(v_en + 1) == '8'
        v_ty = c"i8"
        v_kind = TYPE_I8
    else if v_el == 3 and *(v_en + 0) == 'u' and *(v_en + 1) == '1' and *(v_en + 2) == '6'
        v_ty = c"i16"
        v_kind = TYPE_U16
    else if v_el == 3 and *(v_en + 0) == 'i' and *(v_en + 1) == '1' and *(v_en + 2) == '6'
        v_ty = c"i16"
        v_kind = TYPE_I16
    else if v_el == 3 and *(v_en + 0) == 'u' and *(v_en + 1) == '3' and *(v_en + 2) == '2'
        v_ty = c"i32"
        v_kind = TYPE_U32
    else if v_el == 3 and *(v_en + 0) == 'i' and *(v_en + 1) == '3' and *(v_en + 2) == '2'
        v_ty = c"i32"
        v_kind = TYPE_I32
    let v_ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v_ep)
    emit_str(s, c" = getelementptr ")
    emit_str(s, v_ty)
    emit_str(s, c", ptr ")
    emit_reg(s, v_data_ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, idx_v)
    emit_str(s, c"\n")
    let v_val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v_val)
    emit_str(s, c" = load ")
    emit_str(s, v_ty)
    emit_str(s, c", ptr ")
    emit_reg(s, v_ep)
    emit_str(s, c"\n")
    # Extend to i64 for uniform value representation.
    if v_kind == TYPE_U8
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i8 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    else if v_kind == TYPE_I8
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i8 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    else if v_kind == TYPE_U16
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i16 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    else if v_kind == TYPE_I16
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i16 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    else if v_kind == TYPE_U32
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i32 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    else if v_kind == TYPE_I32
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i32 ")
        emit_reg(s, v_val)
        emit_str(s, c" to i64\n")
        return ext
    return v_val

# AGAST #2321: `p[i]` on `p: *[N]T` / `@[N]T` / `@&[N]T` is element i of the array
# behind it, stride T, as ritz0 reads it.  The pointee named no element, so this
# took the byte path: one byte at offset i, and a clang error for `@&`.  A struct
# element has no by-value read (#1562), so it's refused: the byte path gives an
# integer, which `p[1] + 1` and `p[1] as i64` took without a word.  `p[1].x` never
# gets here.  Returns 1 and sets `out` when it took `e`.
fn emit_array_ptr_index(s: *EmitterState, e: *Expr, out: *i32) -> i32
    let loc: *LocalVar = array_ptr_index_base(s, e.left)
    if loc == null
        return 0
    let elem: i32 = loc.pointee_array_elem_type
    if e.right != null and e.right.kind == EXPR_RANGE
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to an array can't be sliced (only String, Vec and Span can)")
        return 1
    if elem == TYPE_ARRAY
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to a multi-dimensional array can't be indexed in ritz1")
        return 1
    # A `*[N]*U` has a `**U` view and never gets here (#2522); a `*[N]**U` has none.
    if elem == TYPE_PTR or elem == TYPE_PTR_PTR
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to an array of pointers can't be indexed in ritz1")
        return 1
    if elem == TYPE_STRUCT
        emit_nd_error(s, e.span.line, e.span.col, c"a whole struct element can't be read through a pointer to an array in ritz1 (read its fields)")
        return 1
    let elem_ty: *u8 = local_array_elem_llvm(elem)
    let idx: i32 = emit_expr(s, e.right)
    let base: i32 = emit_load_ptr(s, loc.reg)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr [")
    emit_int(s, loc.pointee_array_size as i64)
    emit_str(s, c" x ")
    emit_str(s, elem_ty)
    emit_str(s, c"], ptr ")
    emit_reg(s, base)
    emit_str(s, c", i64 0, i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    let loaded: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, loaded)
    emit_str(s, c" = load ")
    emit_str(s, elem_ty)
    emit_str(s, c", ptr ")
    emit_reg(s, elem_ptr)
    emit_str(s, c"\n")
    *out = emit_array_elem_widen(s, loaded, elem, elem_ty)
    return 1

# "Vec$..", "Span$.." or "String": what `[lo..hi]` slices (AGAST #2451).
fn is_sliceable_name(name: *u8, len: i32) -> i32
    if name == null
        return 0
    if len > 4 and memcmp(name, c"Vec$", 4) == 0
        return 1
    if len > 5 and memcmp(name, c"Span$", 5) == 0
        return 1
    if len == 6 and memcmp(name, c"String", 6) == 0
        return 1
    return 0

# What a refused `[lo..hi]` names its base, as ritz0's _unsliceable does
# (AGAST #2521).
fn unsliceable_message(base_type: i32) -> *u8
    if base_type == TYPE_ARRAY
        return c"an array can't be sliced (only String, Vec and Span can)"
    if base_type == TYPE_PTR_PTR
        return c"a pointer to a pointer can't be sliced (only String, Vec and Span can)"
    if base_type == TYPE_PTR or base_type == TYPE_REF or base_type == TYPE_MUT_REF
        return c"a pointer can't be sliced (only String, Vec and Span can)"
    return c"this can't be sliced (only String, Vec and Span can)"

# AGAST #2537: `(*r)[i]` where `*r` is a `*T` and T is the scalar `elem`:
# `*r` is the pointer (an i64), so GEP it at T's own memory type
# (local_array_elem_llvm: `i1` for bool, `float` / `double` for floats) and
# widen as an array element is.
fn emit_deref_index(s: *EmitterState, e: *Expr, elem: i32) -> i32
    let ty: *u8 = local_array_elem_llvm(elem)
    let base: i32 = emit_expr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let base_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base_ptr)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, base)
    emit_str(s, c" to ptr\n")
    let ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr)
    emit_str(s, c" = getelementptr ")
    emit_str(s, ty)
    emit_str(s, c", ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load ")
    emit_str(s, ty)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c"\n")
    return emit_array_elem_widen(s, val, elem, ty)

# AGAST #2330, #2996: `e`, a whole struct element, where a number goes.  A copy
# (`let s: S = a[i]`, `g(a[i])`) is s.struct_copy_expr; anything else put a `%S`
# where clang wanted an i64 (`a[i] as i32`, `return a[i]`, `a[i] + 1`).  Refuses
# it, located, and returns 1; returns 0 for a copy.
fn whole_struct_elem_refused(s: *EmitterState, e: *Expr) -> i32
    return struct_value_refused(s, e, c"a whole struct element is not a value here in ritz1 (copy it into a `let s: S`, or read its fields)")

# The shared refusal: a struct value `e` where a number goes, located at `e`
# with `msg`.  1 when refused; 0 when `e` is the copy being emitted.
fn struct_value_refused(s: *EmitterState, e: *Expr, msg: *u8) -> i32
    if s.struct_copy_expr == e
        return 0
    emit_nd_error(s, e.span.line, e.span.col, msg)
    return 1

# AGAST #3008: the plain struct `e` is by value, when it is a local, a param or
# a call result (`s`, `mk()`, `q.make()`); null/0 otherwise.  An enum, which
# resolve_expr_struct_name names too, is no struct to find_struct: it is an
# integer to `as` (§10.4) with its own refusals.  A `[N]S` element is
# whole_struct_elem_refused's.
fn struct_value_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or (e.kind != EXPR_IDENT and e.kind != EXPR_CALL and e.kind != EXPR_METHOD)
        return
    var name: *u8 = null
    var len: i32 = 0
    resolve_expr_struct_name(s, e, @name, @len)
    if name == null or len == 0 or find_struct(s, name, len) == null
        return
    *out_name = name
    *out_len = len

# AGAST #3008: `s as i32`, `mk() as i32` on a struct `S`: ritz0's refusal (#2999).
# ritz1 emitted the `%S` as the integer and clang refused the IR.  1 when refused.
fn struct_cast_to_int_refused(s: *EmitterState, e: *Expr) -> i32
    if int_prim_bits(e.op) == 0
        return 0
    var name: *u8 = null
    var len: i32 = 0
    struct_value_name(s, e.left, @name, @len)
    if name == null
        return 0
    let target: *u8 = primitive_name_from_type(e.op)
    var n: i32 = 0
    let head: *u8 = ctor_join(c"cannot cast struct `", 20, name, len, c"` to `", 6, @n)
    let tail: *u8 = c"`: a struct is not an integer (read one of its fields, or take its address with @)"
    let msg: *u8 = ctor_join(head, n, target, strlen(target) as i32, tail, strlen(tail) as i32, @n)
    return struct_value_refused(s, e.left, msg)

# AGAST #3008: `return s`, `return mk()` or a tail `mk()` in an `-> i64` fn, on a
# struct `S`: ritz0's refusal (#2999).  1 when refused.
fn struct_return_as_int_refused(s: *EmitterState, value: *Expr, ret_type: i32) -> i32
    if int_prim_bits(ret_type) == 0
        return 0
    var name: *u8 = null
    var len: i32 = 0
    struct_value_name(s, value, @name, @len)
    if name == null
        return 0
    let ret_name: *u8 = primitive_name_from_type(ret_type)
    var n: i32 = 0
    let head: *u8 = ctor_join(c"the fn returns `", 16, ret_name, strlen(ret_name) as i32, c"`, but this is struct `", 23, @n)
    let tail: *u8 = c"`: a struct is not an integer (return one of its fields)"
    let msg: *u8 = ctor_join(head, n, name, len, tail, strlen(tail) as i32, @n)
    return struct_value_refused(s, value, msg)

fn emit_expr_index(s: *EmitterState, e: *Expr) -> i32
    # AGAST #2440: `p[i]` through a reference or pointer.
    if index_refused(s, e) == 1 or box_index_refused(s, e) == 1
        return 0
    let through: *LocalVar = index_through(s, e)
    if through != null
        # AGAST #2330: a struct element of a pointer to an array, as a value.  A
        # copy, `let s: S = p[i]` or `g(p[i])`, doesn't come here, and its fields
        # don't either.  This was #2321's located refusal, and `*(q + i)` failed
        # at clang for `p[i] + 1`, `p[i] as i64` and `return p[i]`.
        if through.array_view == 1 and through.pointee_type == TYPE_STRUCT and whole_struct_elem_refused(s, e) == 1
            return 0
        var th: ThroughIndex
        index_through_fill(e, through_spill(s, through), @th)
        return emit_expr(s, @th.deref)
    # AGAST #1509: `g[i][j]` over a multi-dimensional array (one GEP chain).
    var nd_val: i32 = 0
    if emit_nd_index_value(s, e, @nd_val) == 1
        return nd_val
    var ap_val: i32 = 0
    if emit_array_ptr_index(s, e, @ap_val) == 1
        return ap_val
    # AGAST #2332: `a[i][j]` with `a: [N]*T`.  It took the byte path.
    if is_array_elem_index(s, e) == 1
        if e.right != null and e.right.kind == EXPR_RANGE
            emit_nd_error(s, e.span.line, e.span.col, c"an element of an array of pointers can't be sliced (only String, Vec and Span can)")
            return 0
        var ei_sum: Expr
        var ei_deref: Expr
        elem_index_as_deref(e, @ei_sum, @ei_deref)
        return emit_expr(s, @ei_deref)
    # Check if base is an array, pointer-to-pointer (e.g., argv: **u8), or pointer
    #
    # AGAST #1328: resolve the base through locals THEN globals, and carry the
    # pointee kind so the fallback pointer path below can load the element at
    # its real width.  Previously (a) a global base hit find_local_type's
    # TYPE_I64 miss value and fell into the byte path (`g[i]` on a global
    # *i32 read one byte of a 4-byte slot), and (b) even for locals there was
    # no pointee-typed path at all — `p[i]` on a local *i32 also byte-loaded.
    var base_type: i32 = TYPE_PTR
    var elem_pointee: i32 = TYPE_UNKNOWN
    var local: *LocalVar = null
    if e.left.kind == EXPR_IDENT
        base_type = find_local_type(s, e.left.ident_ptr, e.left.ident_len)
        local = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if base_type == TYPE_UNKNOWN
            let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if glob != null
                base_type = glob.var_type
                elem_pointee = glob.pointee_type
            else
                # Neither local nor global: preserve the historical byte-path
                # default rather than letting TYPE_UNKNOWN leak downstream.
                base_type = TYPE_PTR
        else if local != null
            elem_pointee = local.pointee_type

    # A range index `a[lo..hi]` slices a Vec, Span or String only, and monomorph
    # rewrites one into `v.slice(lo, hi)` (AGAST #2451).  What reaches here is
    # refused, located (#2521).
    if e.right != null and e.right.kind == EXPR_RANGE
        # AGAST #2290: ritz0 slices no array, so a borrowed one isn't either.
        if local != null and base_type == TYPE_ARRAY and local.is_lent == 1
            emit_nd_error(s, e.span.line, e.span.col, c"an `a:& [N]T` param can't be sliced (only String, Vec and Span can)")
            return 0
        # AGAST #2451: a Vec, Span or String local was sliced here into a bare
        # address, so `t[1]` read bytes and `t.len` had no struct.  What
        # monomorph didn't rewrite is refused rather than read as an address.
        if base_type == TYPE_STRUCT and local != null
            if is_sliceable_name(local.type_name, local.type_name_len) == 1
                emit_nd_error(s, e.span.line, e.span.col, c"this slice of a Vec, Span or String isn't lowered by ritz1 (`let t = v[lo..hi]` is)")
            else
                emit_nd_error(s, e.span.line, e.span.col, c"a struct can't be sliced (only String, Vec and Span can)")
            return 0
        # AGAST #2521: nothing else slices (LANGUAGE_SPEC §3.4, R9 rules 5 and
        # 6).  An array, a raw `*T` and a `**Vec` were lowered here to a bare
        # address in an i64 (#110, #1974), read as 20 for the first two and as
        # garbage for the third.  ritz0 refuses each, at the same place.
        # A base that isn't a name defaulted to TYPE_PTR above: ask its type.
        var named: i32 = base_type
        if e.left.kind != EXPR_IDENT
            named = get_expr_type(s, e.left)
        emit_nd_error(s, e.span.line, e.span.col, unsliceable_message(named))
        return 0

    if base_type == TYPE_ARRAY and local != null and local.array_elem_type == TYPE_STRUCT and local.type_name_len > 0
        # AGAST #2592: a whole struct element of a `[N]P` local is a `%P`
        # value, as the global (#1553) and field (#188) arms load it.  It was
        # read as a `[N x i64]` slot, so `let p: P = ps[1]` stored an i64 into
        # a %P slot and clang refused the IR.  AGAST #2996: a copy only.
        if whole_struct_elem_refused(s, e) == 1
            return 0
        let sidx: i32 = emit_expr(s, e.right)
        let sptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sptr)
        emit_str(s, c" = getelementptr [")
        emit_int(s, local.array_size as i64)
        emit_str(s, c" x ")
        emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
        emit_str(s, c"], ptr ")
        emit_reg(s, local.reg)
        emit_str(s, c", i64 0, i64 ")
        emit_reg(s, sidx)
        emit_str(s, c"\n")
        let sval: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sval)
        emit_str(s, c" = load ")
        emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, sptr)
        emit_str(s, c"\n")
        return sval

    if base_type == TYPE_ARRAY and local != null
        # Array local - use GEP [0, index] to get element, then load.
        # AGAST #1564: at the alloca's own element type (local_array_elem_llvm);
        # u32/u16/i16 used to fall to `[N x i64]` over a narrower alloca.
        # A float / double element is the value itself (#1966): no widen.
        let elem_ty: *u8 = local_array_elem_llvm(local.array_elem_type)
        let idx: i32 = emit_expr(s, e.right)
        let elem_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr [")
        emit_int(s, local.array_size as i64)
        emit_str(s, c" x ")
        emit_str(s, elem_ty)
        emit_str(s, c"], ptr ")
        emit_reg(s, local.reg)
        emit_str(s, c", i64 0, i64 ")
        emit_reg(s, idx)
        emit_str(s, c"\n")
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load ")
        emit_str(s, elem_ty)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")
        return emit_array_elem_widen(s, result, local.array_elem_type, elem_ty)

    # AGAST #1504: a GLOBAL `[N]T` array. The branch above covers only an
    # array local, so a global array fell through to the pointer fallback
    # (`load i64 @g; inttoptr; gep`), which used the array's first element as
    # a base address and segfaulted. GEP the global directly instead.
    # `g[i].field` goes through emit_member_ptr, not here.
    if base_type == TYPE_ARRAY and local == null and e.left.kind == EXPR_IDENT
        let garr: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
        if garr != null and garr.array_elem_type == TYPE_STRUCT and garr.array_elem_type_name_len > 0
            # AGAST #1553: a whole struct element (`let q: P = g[i]`) is a
            # struct value: `load %P` from the `[N x %P]` GEP, the same form
            # a struct-valued deref or call yields, so a %P slot can take it.
            # AGAST #2996: a copy only.
            if whole_struct_elem_refused(s, e) == 1
                return 0
            let sidx: i32 = emit_expr(s, e.right)
            let sptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, sptr)
            emit_str(s, c" = getelementptr [")
            emit_int(s, garr.array_size as i64)
            emit_str(s, c" x ")
            emit_llvm_type_struct(s, TYPE_STRUCT, garr.array_elem_type_name, garr.array_elem_type_name_len)
            emit_str(s, c"], ptr @")
            emit_name(s, garr.name, garr.name_len)
            emit_str(s, c", i64 0, i64 ")
            emit_reg(s, sidx)
            emit_str(s, c"\n")
            let sval: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, sval)
            emit_str(s, c" = load ")
            emit_llvm_type_struct(s, TYPE_STRUCT, garr.array_elem_type_name, garr.array_elem_type_name_len)
            emit_str(s, c", ptr ")
            emit_reg(s, sptr)
            emit_str(s, c"\n")
            return sval
        if garr != null and garr.array_elem_type != TYPE_STRUCT
            return emit_global_array_index(s, garr.name, garr.name_len, garr.array_size, garr.array_elem_type, global_array_elem_llvm(garr), e.right)

    # AGAST #1534: a module `const T: [N]X = [...]`. emit_const_array_entry
    # emits it as `@T = internal constant [N x X]`, but T is neither a local
    # nor a global, so it fell to the pointer fallback below, where
    # emit_expr_ident inlined the const's scalar value (0) as the base:
    # `inttoptr i64 0` plus a byte-wide GEP — a segfault (cryptosec SBOX/RCON).
    # Index the const's global at its real element width instead. A local of
    # the same name shadows the const (local != null skips this).
    if local == null and e.left.kind == EXPR_IDENT
        let carr: *ConstEntry = find_const_entry(s, e.left.ident_ptr, e.left.ident_len)
        if carr != null and carr.const_type == TYPE_ARRAY and carr.value_expr != null and (carr.value_expr.kind == EXPR_ARRAY_LIT or carr.value_expr.kind == EXPR_ARRAY_FILL)
            let cty: *u8 = const_array_elem_llvm(carr.array_elem_type)
            if cty != null
                return emit_global_array_index(s, carr.name, carr.name_len, carr.array_size, carr.array_elem_type, cty, e.right)

    # task-101: Span$T indexing on a struct local — `let b = s.as_bytes(); b[0]`
    # or `let b = "ABC"; b[0]`. Without this, emit_expr(e.left) loads the whole
    # %Span$u8 aggregate and the ptr-to-byte fallback's
    # `inttoptr i64 %base to ptr` fails because %base is a struct, not i64.
    # Mirrors the Vec$T struct-field path below, but for a whole-struct local.
    # NOTE: lane-bleed from ritz-task-101 into ritz-task-110's emitter_expr_access
    # lane — necessary because the emit_var_decl Span$u8 alloca fix in -101
    # depends on this to keep `bytes[0]` compiling.
    # Vec$T local indexing — `v[i]` where v: Vec<T>.  Mirrors the
    # Span$T branch below; emit_member_ptr's Vec-field path handles the
    # `s.vec_field[i]` shape but not bare-local `v[i]`.  Without this,
    # vec_push_u16_method's `v[0] == 3` lowers to `inttoptr i64 %vec_struct`
    # which clang rejects (struct → ptr not allowed).
    if e.left.kind == EXPR_IDENT and local != null and local.var_type == TYPE_STRUCT and local.type_name_len > 4
        if *(local.type_name + 0) == 'V' and *(local.type_name + 1) == 'e' and *(local.type_name + 2) == 'c' and *(local.type_name + 3) == '$'
            return emit_vec_ptr_index(s, local.reg, local.type_name, local.type_name_len, e.right)

    if e.left.kind == EXPR_IDENT and local != null and local.var_type == TYPE_STRUCT and local.type_name_len >= 5
        if *(local.type_name + 0) == 'S' and *(local.type_name + 1) == 'p' and *(local.type_name + 2) == 'a' and *(local.type_name + 3) == 'n' and *(local.type_name + 4) == '$'
            let idx_s: i32 = emit_expr(s, e.right)
            # GEP to data ptr field (index 0 of Span struct)
            let data_ptr_ptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, data_ptr_ptr)
            emit_str(s, c" = getelementptr %")
            emit_name(s, local.type_name, local.type_name_len)
            emit_str(s, c", ptr ")
            emit_reg(s, local.reg)
            emit_str(s, c", i32 0, i32 0\n")
            let data_ptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, data_ptr)
            emit_str(s, c" = load ptr, ptr ")
            emit_reg(s, data_ptr_ptr)
            emit_str(s, c"\n")
            # Decode element type from suffix after "Span$"
            let elem_name_s: *u8 = local.type_name + 5
            let elem_len_s: i32 = local.type_name_len - 5
            var elem_ty_s3: *u8 = c"i64"
            var elem_kind_s: i32 = TYPE_I64
            if elem_len_s == 2 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '8'
                elem_ty_s3 = c"i8"
                elem_kind_s = TYPE_U8
            else if elem_len_s == 2 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '8'
                elem_ty_s3 = c"i8"
                elem_kind_s = TYPE_I8
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '3' and *(elem_name_s + 2) == '2'
                elem_ty_s3 = c"i32"
                elem_kind_s = TYPE_I32
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '3' and *(elem_name_s + 2) == '2'
                elem_ty_s3 = c"i32"
                elem_kind_s = TYPE_U32
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '1' and *(elem_name_s + 2) == '6'
                elem_ty_s3 = c"i16"
                elem_kind_s = TYPE_I16
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '1' and *(elem_name_s + 2) == '6'
                elem_ty_s3 = c"i16"
                elem_kind_s = TYPE_U16
            # GEP by index
            let elem_ptr_s: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, elem_ptr_s)
            emit_str(s, c" = getelementptr ")
            emit_str(s, elem_ty_s3)
            emit_str(s, c", ptr ")
            emit_reg(s, data_ptr)
            emit_str(s, c", i64 ")
            emit_reg(s, idx_s)
            emit_str(s, c"\n")
            let val_s: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, val_s)
            emit_str(s, c" = load ")
            emit_str(s, elem_ty_s3)
            emit_str(s, c", ptr ")
            emit_reg(s, elem_ptr_s)
            emit_str(s, c"\n")
            # Zero/sign-extend to i64 for uniform value representation
            if elem_kind_s == TYPE_U8
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = zext i8 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            else if elem_kind_s == TYPE_I8
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = sext i8 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            else if elem_kind_s == TYPE_I32
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = sext i32 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            else if elem_kind_s == TYPE_U32
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = zext i32 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            else if elem_kind_s == TYPE_I16
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = sext i16 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            else if elem_kind_s == TYPE_U16
                let ext: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ext)
                emit_str(s, c" = zext i16 ")
                emit_reg(s, val_s)
                emit_str(s, c" to i64\n")
                return ext
            return val_s

    # Check for struct member array access: s.field[idx] where field is an array
    if e.left.kind == EXPR_MEMBER
        var member_result: MemberPtrResult
        emit_member_ptr(s, e.left, @member_result)
        if member_result.success == 1
            let field: *StructField = member_result.field
            if field.field_type == TYPE_ARRAY
                let et: i32 = field.array_elem_type
                # AGAST #2996: a whole struct element is a copy only.
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0 and whole_struct_elem_refused(s, e) == 1
                    return 0
                # Array field in struct - GEP directly into it
                let idx: i32 = emit_expr(s, e.right)
                let elem_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, elem_ptr)
                emit_str(s, c" = getelementptr [")
                emit_int(s, field.array_size as i64)
                emit_str(s, c" x ")
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    # AGAST #188: struct-array RHS — `[N x %T]` so the GEP
                    # element stride matches the actual struct layout.  Without
                    # this, `doc.fields[i + 1]` (RHS-read) used `[64 x i64]`
                    # GEP and `load i64`, but the LHS expects `%FieldEntry`,
                    # tripping clang's IR-verifier on `store %FieldEntry %i64val`
                    # in mausoleum doc_remove_field's compaction loop.
                    emit_llvm_type_struct(s, TYPE_STRUCT, field.array_elem_type_name, field.array_elem_type_name_len)
                else
                    # AGAST #1814: the field's declared element type.
                    emit_str(s, field_array_elem_llvm(et))
                emit_str(s, c"], ptr ")
                emit_reg(s, member_result.reg)
                emit_str(s, c", i64 0, i64 ")
                emit_reg(s, idx)
                emit_str(s, c"\n")
                # Load element. Integer/pointer elements load at their own
                # width (array_elem_llvm) and widen to i64. Bool loads its i1
                # and zero-extends. AGAST #1954: f32 / f64 elements load the
                # field's own `float` / `double` (field_array_elem_llvm) and
                # are returned as-is, as #1966's `loc[i]` and #1973's `p[i]`
                # are; get_expr_type reports F32 / F64 for them. They used to
                # fail closed (f32) or bit-load an i64 (f64).
                var load_ty: *u8 = array_elem_llvm(et)
                if et == TYPE_BOOL or et == TYPE_F32 or et == TYPE_F64
                    load_ty = field_array_elem_llvm(et)
                let result: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, result)
                emit_str(s, c" = load ")
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    # AGAST #188: load the struct value as `%T`, not as i64.
                    emit_llvm_type_struct(s, TYPE_STRUCT, field.array_elem_type_name, field.array_elem_type_name_len)
                else
                    emit_str(s, load_ty)
                emit_str(s, c", ptr ")
                emit_reg(s, elem_ptr)
                emit_str(s, c"\n")
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    return result
                if et == TYPE_F32 or et == TYPE_F64
                    return result
                if et == TYPE_BOOL
                    let bext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, bext)
                    emit_str(s, c" = zext i1 ")
                    emit_reg(s, result)
                    emit_str(s, c" to i64\n")
                    return bext
                # Extend to i64 if needed (zext unsigned, sext signed,
                # ptrtoint pointers; i64 as-is).
                return emit_array_elem_widen(s, result, et, load_ty)
            # AGAST #184: `obj.fwd[i]` value-read where `fwd: **Foo` is a
            # pointer to an array of *Foo (skip-list / hash-bucket pattern).
            # Pre-fix this fell through to "; ERROR: unhandled EXPR_MEMBER"
            # then a wrong-byte-stride GEP using an undef base — see
            # tome's `update[k].forward[k]` RHS-read.
            #
            # Lowering: load the field (a ptr to the *Foo array) → GEP by
            # ptr stride → load to materialise the i-th *Foo → ptrtoint
            # to i64 for the unified value model.
            else if field.field_type == TYPE_PTR_PTR and field.field_type_name_len > 0
                let idx_pp: i32 = emit_expr(s, e.right)
                let arr_base_pp: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, arr_base_pp)
                emit_str(s, c" = load ptr, ptr ")
                emit_reg(s, member_result.reg)
                emit_str(s, c"\n")
                let slot_pp: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, slot_pp)
                emit_str(s, c" = getelementptr ptr, ptr ")
                emit_reg(s, arr_base_pp)
                emit_str(s, c", i64 ")
                emit_reg(s, idx_pp)
                emit_str(s, c"\n")
                let val_pp: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, val_pp)
                emit_str(s, c" = load ptr, ptr ")
                emit_reg(s, slot_pp)
                emit_str(s, c"\n")
                let pti_pp: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, pti_pp)
                emit_str(s, c" = ptrtoint ptr ")
                emit_reg(s, val_pp)
                emit_str(s, c" to i64\n")
                return pti_pp
            # AGAST #1596: `x.f[i]` value-read with `f: *T` (primitive int
            # pointee) or `**T`: load the pointer from the field, GEP by the
            # pointee width, load and widen. Without this arm the read fell
            # through to the byte path below (`getelementptr i8` +
            # `load i8`) whatever the pointee was.
            else if (field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR) and ptr_field_elem_kind(field) != TYPE_UNKNOWN and ptr_field_elem_kind(field) != TYPE_STRUCT
                let pf_kind: i32 = ptr_field_elem_kind(field)
                # AGAST #2053: f32 / f64 pointees load as float / double
                # (ptr_field_elem_llvm), not array_elem_llvm's i64, and are
                # not widened (emit_array_elem_widen leaves them as-is).
                let pf_ty: *u8 = ptr_field_elem_llvm(pf_kind)
                let pf_idx: i32 = emit_expr(s, e.right)
                let pf_ptr: i32 = emit_ptr_field_elem_addr(s, member_result.reg, field, pf_kind, pf_idx)
                let pf_val: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, pf_val)
                emit_str(s, c" = load ")
                emit_str(s, pf_ty)
                emit_str(s, c", ptr ")
                emit_reg(s, pf_ptr)
                emit_str(s, c"\n")
                return emit_array_elem_widen(s, pf_val, pf_kind, pf_ty)
            # Port of ritz0 bedc85b: Vec<T> field indexing — s.vec_field[i]
            # The field is a Vec$T struct: { *T data, i64 len, i64 cap }.
            # We already have a ptr to the Vec struct in member_result.reg; load
            # the data ptr (field 0), GEP by idx, load the element, extend to i64.
            else if field.field_type == TYPE_STRUCT and field.field_type_name_len > 4
                if *(field.field_type_name + 0) == 'V' and *(field.field_type_name + 1) == 'e' and *(field.field_type_name + 2) == 'c' and *(field.field_type_name + 3) == '$'
                    let idx_v: i32 = emit_expr(s, e.right)
                    # GEP to data field of Vec struct
                    let data_ptr_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, data_ptr_ptr)
                    emit_str(s, c" = getelementptr %")
                    emit_name(s, field.field_type_name, field.field_type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c", i32 0, i32 0\n")
                    # Load data pointer
                    let data_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, data_ptr)
                    emit_str(s, c" = load ptr, ptr ")
                    emit_reg(s, data_ptr_ptr)
                    emit_str(s, c"\n")
                    # Determine element type from suffix after "Vec$"
                    let elem_name: *u8 = field.field_type_name + 4
                    let elem_len: i32 = field.field_type_name_len - 4
                    # Match common suffixes: i32, i64, u8, i8, u16, i16, u32
                    var elem_ty_str: *u8 = c"i64"
                    var elem_kind: i32 = TYPE_I64
                    if elem_len == 2 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '8'
                        elem_ty_str = c"i8"
                        elem_kind = TYPE_U8
                    else if elem_len == 2 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '8'
                        elem_ty_str = c"i8"
                        elem_kind = TYPE_I8
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '3' and *(elem_name + 2) == '2'
                        elem_ty_str = c"i32"
                        elem_kind = TYPE_I32
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '3' and *(elem_name + 2) == '2'
                        elem_ty_str = c"i32"
                        elem_kind = TYPE_U32
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '6' and *(elem_name + 2) == '4'
                        elem_ty_str = c"i64"
                        elem_kind = TYPE_I64
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '6' and *(elem_name + 2) == '4'
                        elem_ty_str = c"i64"
                        elem_kind = TYPE_I64
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '1' and *(elem_name + 2) == '6'
                        elem_ty_str = c"i16"
                        elem_kind = TYPE_I16
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '1' and *(elem_name + 2) == '6'
                        elem_ty_str = c"i16"
                        elem_kind = TYPE_U16
                    # GEP by index
                    let elem_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, elem_ptr)
                    emit_str(s, c" = getelementptr ")
                    emit_str(s, elem_ty_str)
                    emit_str(s, c", ptr ")
                    emit_reg(s, data_ptr)
                    emit_str(s, c", i64 ")
                    emit_reg(s, idx_v)
                    emit_str(s, c"\n")
                    # Load the element
                    let val_reg: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, val_reg)
                    emit_str(s, c" = load ")
                    emit_str(s, elem_ty_str)
                    emit_str(s, c", ptr ")
                    emit_reg(s, elem_ptr)
                    emit_str(s, c"\n")
                    # Extend to i64 for uniform value representation
                    if elem_kind == TYPE_I32
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = sext i32 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    else if elem_kind == TYPE_U32
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = zext i32 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    else if elem_kind == TYPE_I16
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = sext i16 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    else if elem_kind == TYPE_U16
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = zext i16 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    else if elem_kind == TYPE_I8
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = sext i8 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    else if elem_kind == TYPE_U8
                        let ext: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ext)
                        emit_str(s, c" = zext i8 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i64\n")
                        return ext
                    return val_reg

    # Port of ritz0 bedc85b: Vec<T> indexing on call receiver — mk()[i].
    # When the index base is a call returning Vec<T>, spill the returned
    # struct to a stack slot, then GEP to the data pointer + index.
    if e.left.kind == EXPR_CALL
        # Look up the callee's return type
        let cfn: *FnDef = find_call_fn(s, e.left)
        if cfn != null and cfn.return_type == TYPE_STRUCT and cfn.return_type_name_len > 4
            if *(cfn.return_type_name + 0) == 'V' and *(cfn.return_type_name + 1) == 'e' and *(cfn.return_type_name + 2) == 'c' and *(cfn.return_type_name + 3) == '$'
                # Evaluate the call (returns a struct value register)
                let call_val: i32 = emit_expr(s, e.left)
                let idx_v: i32 = emit_expr(s, e.right)
                # Allocate a stack slot for the returned Vec and store
                let slot: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, slot)
                emit_str(s, c" = alloca %")
                emit_name(s, cfn.return_type_name, cfn.return_type_name_len)
                emit_str(s, c"\n")
                emit_str(s, c"  store %")
                emit_name(s, cfn.return_type_name, cfn.return_type_name_len)
                emit_str(s, c" ")
                emit_reg(s, call_val)
                emit_str(s, c", ptr ")
                emit_reg(s, slot)
                emit_str(s, c"\n")
                # GEP to data field
                let data_ptr_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, data_ptr_ptr)
                emit_str(s, c" = getelementptr %")
                emit_name(s, cfn.return_type_name, cfn.return_type_name_len)
                emit_str(s, c", ptr ")
                emit_reg(s, slot)
                emit_str(s, c", i32 0, i32 0\n")
                let data_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, data_ptr)
                emit_str(s, c" = load ptr, ptr ")
                emit_reg(s, data_ptr_ptr)
                emit_str(s, c"\n")
                # Decode elem type suffix after "Vec$"
                let elem_name2: *u8 = cfn.return_type_name + 4
                let elem_len2: i32 = cfn.return_type_name_len - 4
                var elem_ty_s2: *u8 = c"i64"
                var elem_kind2: i32 = TYPE_I64
                if elem_len2 == 2 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '8'
                    elem_ty_s2 = c"i8"
                    elem_kind2 = TYPE_U8
                else if elem_len2 == 2 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '8'
                    elem_ty_s2 = c"i8"
                    elem_kind2 = TYPE_I8
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '3' and *(elem_name2 + 2) == '2'
                    elem_ty_s2 = c"i32"
                    elem_kind2 = TYPE_I32
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '3' and *(elem_name2 + 2) == '2'
                    elem_ty_s2 = c"i32"
                    elem_kind2 = TYPE_U32
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '6' and *(elem_name2 + 2) == '4'
                    elem_ty_s2 = c"i64"
                    elem_kind2 = TYPE_I64
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '6' and *(elem_name2 + 2) == '4'
                    elem_ty_s2 = c"i64"
                    elem_kind2 = TYPE_I64
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '1' and *(elem_name2 + 2) == '6'
                    elem_ty_s2 = c"i16"
                    elem_kind2 = TYPE_I16
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '1' and *(elem_name2 + 2) == '6'
                    elem_ty_s2 = c"i16"
                    elem_kind2 = TYPE_U16
                # GEP by index
                let elem_ptr2: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, elem_ptr2)
                emit_str(s, c" = getelementptr ")
                emit_str(s, elem_ty_s2)
                emit_str(s, c", ptr ")
                emit_reg(s, data_ptr)
                emit_str(s, c", i64 ")
                emit_reg(s, idx_v)
                emit_str(s, c"\n")
                # Load
                let val2: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, val2)
                emit_str(s, c" = load ")
                emit_str(s, elem_ty_s2)
                emit_str(s, c", ptr ")
                emit_reg(s, elem_ptr2)
                emit_str(s, c"\n")
                # Extend to i64
                if elem_kind2 == TYPE_I32
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = sext i32 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                else if elem_kind2 == TYPE_U32
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = zext i32 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                else if elem_kind2 == TYPE_I16
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = sext i16 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                else if elem_kind2 == TYPE_U16
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = zext i16 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                else if elem_kind2 == TYPE_I8
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = sext i8 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                else if elem_kind2 == TYPE_U8
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = zext i8 ")
                    emit_reg(s, val2)
                    emit_str(s, c" to i64\n")
                    return ext
                return val2

    # AGAST #2537: `(*r)[i]` with `r: **T` GEPs and loads T (get_expr_type's
    # deref_index_elem), widened as an array element is.  It took the byte
    # path below: wrong values on an integer, invalid IR on a float.
    let dix: i32 = deref_index_elem(s, e)
    if dix != TYPE_VOID
        return emit_deref_index(s, e, dix)

    let base: i32 = emit_expr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)

    if base_type == TYPE_PTR_PTR
        # Pointer-to-pointer: index by pointer size, load pointer
        # First convert base i64 back to ptr
        let base_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, base_ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, base)
        emit_str(s, c" to ptr\n")

        let ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr ptr, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx)
        emit_str(s, c"\n")

        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, ptr)
        emit_str(s, c"\n")

        # Convert ptr to i64 for our uniform value representation
        let pti: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, pti)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return pti
    else if (base_type == TYPE_PTR or base_type == TYPE_REF or base_type == TYPE_MUT_REF) and (elem_pointee == TYPE_I16 or elem_pointee == TYPE_U16 or elem_pointee == TYPE_I32 or elem_pointee == TYPE_U32 or elem_pointee == TYPE_I64 or elem_pointee == TYPE_U64 or elem_pointee == TYPE_I8 or elem_pointee == TYPE_F32 or elem_pointee == TYPE_F64)
        # AGAST #1328: pointee-typed pointer indexing — GEP by the element
        # stride and load at the element width, then extend to i64 for the
        # uniform value representation.  Covers `p[i]` / `g[i]` where the
        # base is a local or global *i16/*u16/*i32/*u32/*i64/*u64/*i8.
        # AGAST #1973: a *f32 / *f64 pointee GEPs and loads `float` /
        # `double` (local_array_elem_llvm's spelling) and returns the value
        # as-is; it used to fall to the byte path below (`load i8`).
        var elem_ty: *u8 = c"i64"
        if elem_pointee == TYPE_F32 or elem_pointee == TYPE_F64
            elem_ty = local_array_elem_llvm(elem_pointee)
        else if elem_pointee == TYPE_I8
            elem_ty = c"i8"
        else if elem_pointee == TYPE_I16 or elem_pointee == TYPE_U16
            elem_ty = c"i16"
        else if elem_pointee == TYPE_I32 or elem_pointee == TYPE_U32
            elem_ty = c"i32"
        let base_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, base_ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, base)
        emit_str(s, c" to ptr\n")
        let ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr ")
        emit_str(s, elem_ty)
        emit_str(s, c", ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx)
        emit_str(s, c"\n")
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load ")
        emit_str(s, elem_ty)
        emit_str(s, c", ptr ")
        emit_reg(s, ptr)
        emit_str(s, c"\n")
        if elem_pointee == TYPE_I64 or elem_pointee == TYPE_U64 or elem_pointee == TYPE_F32 or elem_pointee == TYPE_F64
            return result
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        if elem_pointee == TYPE_U16 or elem_pointee == TYPE_U32
            emit_str(s, c" = zext ")
        else
            emit_str(s, c" = sext ")
        emit_str(s, elem_ty)
        emit_str(s, c" ")
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return ext
    else
        # Pointer-to-byte: index by 1, load byte
        # First convert i64 value back to ptr
        let base_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, base_ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, base)
        emit_str(s, c" to ptr\n")

        let ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr i8, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx)
        emit_str(s, c"\n")

        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = load i8, ptr ")
        emit_reg(s, ptr)
        emit_str(s, c"\n")

        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i8 ")
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return ext

# Build a `%Enum` value whose tag is `tag` (alloca + zero + store i8 + load),
# for a unit variant: the qualified `Shade.Light` (emit_expr_member) and,
# AGAST #1600, the bare `Light` (emit_expr_ident).  The result register is a
# struct-typed SSA value usable as a call arg or var-decl initializer.
# AGAST #2422: 1 when (name, len) is an instance of a generic enum
# (`Slot$i32`), which monomorph recorded as an enum of that name.
pub fn is_enum_instance(name: *u8, len: i32) -> i32
    if name == null or len <= 0
        return 0
    let ei: i32 = enum_find(name, len)
    (ei >= 0 and enum_is_generic(ei) == ENUM_INSTANCE) as i32

# AGAST #2422: a generic enum's variant has no enum of its own to build:
# `Full(5)` is a `Slot<i32>` only because its slot says so, as in ritz0.  The
# slot is the typed let's, the parameter's or field's (ctx_enum_name), else the
# enclosing fn's return type outside a call argument.  When that is an instance
# declaring variant `name`, its tracker index (*out_vi the tag); else -1.
pub fn slot_instance_variant(s: *EmitterState, name: *u8, len: i32, out_vi: *i32) -> i32
    var en: *u8 = s.ctx_enum_name
    var en_len: i32 = s.ctx_enum_name_len
    if en == null and s.ctx_enum_arg == 0
        en = s.ret_type_name
        en_len = s.ret_type_name_len
    if is_enum_instance(en, en_len) == 0
        return 0 - 1
    let vi: i32 = enum_variant_index(en, en_len, name, len)
    if vi < 0
        return 0 - 1
    *out_vi = vi
    enum_find(en, en_len)

fn emit_unit_variant_value(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32) -> i32
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c"  ; enum variant ctor\n")
    # Zero-init so any padding is deterministic
    emit_str(s, c"  store %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    # Pointer to the tag byte (field 0)
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    emit_str(s, c"  store i8 ")
    emit_int(s, tag as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    return val

# Copy `len` bytes of `src` to `dst`; returns `dst + len`.
fn put_bytes(dst: *u8, src: *u8, len: i32) -> *u8
    for i in 0..len
        *(dst + i) = *(src + i)
    return dst + len

# AGAST #2451: `t.len` on a String local names no field: one located error, in
# ritz0's words, where it fell to the unlocated "unhandled EXPR_MEMBER".
# Returns 1 after reporting `e`.
fn unknown_field_refused(s: *EmitterState, e: *Expr) -> i32
    if e.left == null or e.left.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if loc == null or loc.var_type != TYPE_STRUCT or loc.type_name == null
        return 0
    let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
    if st == null
        return 0
    var f: *StructField = st.fields
    while f != null
        if buf_eq(f.name, f.name_len, e.ident_ptr, e.ident_len) == 1
            return 0
        f = f.next
    # "Unknown field '<f>' in struct '<S>'"
    let msg: *u8 = malloc((e.ident_len + loc.type_name_len + 40) as i64) as *u8
    var w: *u8 = put_bytes(msg, c"Unknown field '", 15)
    w = put_bytes(w, e.ident_ptr, e.ident_len)
    w = put_bytes(w, c"' in struct '", 13)
    w = put_bytes(w, loc.type_name, loc.type_name_len)
    w = put_bytes(w, c"'", 1)
    *w = 0
    emit_nd_error(s, e.span.line, e.span.col, msg)
    return 1

fn emit_expr_member(s: *EmitterState, e: *Expr) -> i32
    # expr.field - member access on struct.
    #
    # Qualified enum variant: `Shade.Light` / `Result.Ok`.  When the LHS
    # ident is a known enum type and the RHS is one of its variants,
    # materialize a %Shade-typed value: alloca + store i8 <tag> + load %Shade.
    # The result register is a struct-typed SSA value usable as a call arg
    # or var-decl initializer; downstream var-decl narrowing handles the
    # alloca-width / store-type so `let a = Shade.Light` packs correctly.
    if e.left.kind == EXPR_IDENT
        if is_enum_type(e.left.ident_ptr, e.left.ident_len) == 1
            let variant_idx: i32 = enum_variant_index(e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len)
            if variant_idx >= 0
                # AGAST #1466: `Option.None` built `alloca %Option`, which
                # clang rejects (ritz1 has no generic-enum specialisation;
                # ritz0 rejects the form).
                if enum_is_generic(enum_find(e.left.ident_ptr, e.left.ident_len)) == 1
                    return emit_qualified_variant_error(s, e, c"is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. None")
                return emit_unit_variant_value(s, e.left.ident_ptr, e.left.ident_len, variant_idx)
    #
    # Namespace-const fallback (ritz0 parity — test_issue_namespace_const_field).
    # `module_name.CONST_NAME` where `module_name` isn't a local/global/const
    # is treated as an opaque module qualifier: emit the const value directly.
    # Matches ritz0's name_resolver behaviour where unknown qualifiers are
    # tolerated when the suffix resolves to a module-scoped constant.
    if e.left.kind == EXPR_IDENT
        let qualifier_local: i32 = find_local(s, e.left.ident_ptr, e.left.ident_len)
        if qualifier_local < 0
            if find_global(s, e.left.ident_ptr, e.left.ident_len) == null
                if is_const(s, e.left.ident_ptr, e.left.ident_len) == 0
                    if is_const(s, e.ident_ptr, e.ident_len) == 1
                        let v: i64 = find_const(s, e.ident_ptr, e.ident_len)
                        let result: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, result)
                        emit_str(s, c" = add i64 0, ")
                        emit_int(s, v)
                        emit_str(s, c"\n")
                        return result

    # Use emit_member_ptr helper for both direct and nested access
    # AGAST #3006: a value read, so `b.f` reads through a Box.
    var member_result: MemberPtrResult
    let box_read: i32 = s.box_read
    s.box_read = 1
    emit_member_ptr(s, e, @member_result)
    s.box_read = box_read
    if member_result.success == 1
        let field: *StructField = member_result.field
        let field_ptr: i32 = member_result.reg
        # Load the field value
        let val_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, val_reg)
        emit_str(s, c" = load ")
        emit_field_llvm_type(s, field)
        emit_str(s, c", ptr ")
        emit_reg(s, field_ptr)
        emit_str(s, c"\n")
        # Convert to i64 if needed
        if field.field_type == TYPE_I32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = sext i32 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_U32
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i32 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_I8
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = sext i8 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_U8
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i8 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_I16
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = sext i16 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_U16
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i16 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else if field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR
            let pti: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, pti)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return pti
        else if field.field_type == TYPE_BOOL
            # AGAST #1646: a bool field is stored as i1 but, like every other
            # scalar, read into an i64 register. Operators (`not`, `and`,
            # `==`), `-> bool` returns and bool call args all assume i64;
            # the raw i1 load was invalid IR in each. See bool_reg_is_i1.
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, val_reg)
            emit_str(s, c" to i64\n")
            return ext
        else
            return val_reg
    if unknown_field_refused(s, e) == 1
        return 0
    emit_ir_error(s, c"unhandled EXPR_MEMBER")

    # Unhandled path — return 0
    return 0

