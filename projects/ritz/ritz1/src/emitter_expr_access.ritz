# IDENT + INDEX + MEMBER codegen (split out of emitter_expr.ritz).
#
# Written in the Emitter style (ARCHITECTURE.md, AGAST #4696): one
# `format_into` per instruction, names and type spellings as StrViews.

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import emitter_core
import emitter_seam   # emit_expr / emit_stmt / ...: the emit table (AGAST #4697)
import text_bridge     # StrView views of the older *u8 text APIs (AGAST #4696)
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import diag                 # diag_error_at (AGAST #3445)
import deref_field          # df_no_field_once (AGAST #3015)
import ritzlib.cstr
import ritzlib.io
import ritzlib.str
import ritzlib.string
import ritzlib.option
import ritzlib.strview
import ritzlib.memory      # malloc: through_spill (AGAST #4697)
import ritzlib.fmt.digits  # fmt_i64_into: through_spill
import emitter_call_lower   # AGAST #1818: below the emission modules
import emitter_decl   # AGAST #1818: below the emission modules
import text_bridge   # no_name / unnamed (AGAST #4696)


# =============================================================================
# Names as text
# =============================================================================

# The identifier `e` names (an Ident, or the field of a Member).
fn ident_text(e: *Expr) -> StrView
    e.ident

# The struct type a local is declared with.
fn local_type_text(lv: *LocalVar) -> StrView
    StrView { ptr: lv_type_name(lv), len: lv_type_name_len(lv) as i64 }

# The struct type a field is declared with.
fn field_type_text(f: *StructField) -> StrView
    StrView { ptr: f.field_type_name, len: f.field_type_name_len as i64 }

# The name of enum `ei`.
fn enum_text(s: *EmitterState, ei: i32) -> StrView
    var len: i32 = 0
    let name: *u8 = enum_name_at(s.mono.pctx, ei, @len)
    StrView { ptr: name, len: len as i64 }

# =============================================================================
# Loads, and the i64 every value is carried in
# =============================================================================

# `v`, a `t` just loaded at its own width, as the i64 every expression value is
# carried in: an integer below 64 bits extended by its sign, a bool's i1
# zero-extended, a pointer's `ptr` converted.  An i64 / u64 and a float are the
# value already, as is anything else (a struct, a reference).
fn widen_loaded(s: *EmitterState, t: TypeKind, v: i32) -> i32
    match t
        TypeKind.I8 => ir_sext_i8_i64(s.out, @s.reg_counter, v)
        TypeKind.U8 => ir_zext_i8_i64(s.out, @s.reg_counter, v)
        TypeKind.I16 => ir_sext_i16_i64(s.out, @s.reg_counter, v)
        TypeKind.U16 => ir_zext_i16_i64(s.out, @s.reg_counter, v)
        TypeKind.I32 => ir_sext_i32_i64(s.out, @s.reg_counter, v)
        TypeKind.U32 => ir_zext_i32_i64(s.out, @s.reg_counter, v)
        TypeKind.Bool => ir_zext_i1_i64(s.out, @s.reg_counter, v)
        TypeKind.Ptr | TypeKind.PtrPtr => ir_ptrtoint_i64(s.out, @s.reg_counter, v)
        _ => v

# A `t` (spelled `ty` in memory) loaded from `ptr` and widened.
fn emit_elem_load(s: *EmitterState, t: TypeKind, ty: StrView, ptr: i32) -> i32
    let v: i32 = next_reg(s)
    format_into(s, "  %.{v} = load {ty}, ptr %.{ptr}\n")
    widen_loaded(s, t, v)

# Element `idx` of the `t` sequence the `ptr` register `base` points at: GEP by
# T's stride, load at T's memory type (elem_mem_llvm) and widen.
fn emit_ptr_elem_read(s: *EmitterState, t: TypeKind, base: i32, idx: i32) -> i32
    let ty: StrView = elem_mem_llvm(t)
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = getelementptr {ty}, ptr %.{base}, i64 %.{idx}\n")
    emit_elem_load(s, t, ty, p)

# Element `idx` of the inline `[size x T]` at register `base` (an alloca, a
# field, or what a pointer to an array holds), loaded and widened.
fn emit_array_elem_read(s: *EmitterState, t: TypeKind, size: i32, base: i32, idx: i32) -> i32
    let ty: StrView = elem_mem_llvm(t)
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = getelementptr [{size} x {ty}], ptr %.{base}, i64 0, i64 %.{idx}\n")
    emit_elem_load(s, t, ty, p)

# The address of element `idx` of the inline `[size x %elem]` at register `base`.
fn emit_struct_elem_addr(s: *EmitterState, size: i32, elem: StrView, base: i32, idx: i32) -> i32
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = getelementptr [{size} x ")
    emit_llvm_type_struct(s, TypeKind.Struct, elem)
    format_into(s, "], ptr %.{base}, i64 0, i64 %.{idx}\n")
    p

# The struct `%name` at `ptr`, as a value (a deferred load when it is large).
fn emit_struct_load(s: *EmitterState, name: StrView, ptr: i32) -> i32
    let v: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TypeKind.Struct, v, name, ptr, no_name())
    v

# =============================================================================
# Identifiers
# =============================================================================

# Check if ident name is "None" (4 chars: N o n e).
# AGAST #2434: true when a bare `None` is a user enum's unit variant here, as
# users_variant_wins decides for a call `Some(5)`: a user enum declares the
# unit `None` (or two do: bare_unit_variant_enum's -2, reported by the bare
# unit-variant path) and no Option slot gives the builtin an enum.  A slot
# that is the user's enum (`let x: E = None`, a param of E) is the user's
# whatever the fn returns.
pub fn users_none_wins(s: *EmitterState, e: *Expr) -> bool
    if e == null or e.kind != ExprKind.Ident or is_ident_none(ident_text(e)) == 0
        return false
    var vi: i32 = 0
    var other: i32 = 0
    let ei: i32 = bare_unit_variant_enum(s, e, @vi, @other)
    if ei == 0 - 1
        return false
    if ei >= 0 and s.ctx_enum_name != null
        let ctx: StrView = StrView { ptr: s.ctx_enum_name, len: s.ctx_enum_name_len as i64 }
        if ctx.eq(enum_text(s, ei))
            return true
    unnamed(resolve_enum_ctx(s))

# A const, local or global named `name` hides the builtin `None`.
fn none_shadowed(s: *EmitterState, name: StrView) -> bool
    is_const(s, name) == 1 or find_local(s, name) >= 0 or find_global(s, name) != null

# A unit variant of enum `en` whose tag is `tag` (of type `tag_ty`): alloca,
# zero-init, store the tag, load the `%en` value.  `note` says which, in the
# alloca's comment.
fn emit_tagged_unit(s: *EmitterState, en: StrView, note: StrView, tag_ty: StrView, tag: i64) -> i32
    let n: String = ir_name(en)
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    format_into(s, "{n.as_view()}  ; {note}\n")
    entry_alloca_reg_end(s)
    # Zero-init so any padding is deterministic.
    format_into(s, "  store %{n.as_view()} zeroinitializer, ptr %.{slot}\n")
    # The tag byte is field 0.
    let tag_ptr: i32 = next_reg(s)
    gep_struct_open(s, tag_ptr, en)
    format_into(s, ", ptr %.{slot}, i32 0, i32 0\n")
    format_into(s, "  store {tag_ty} {tag}, ptr %.{tag_ptr}\n")
    let val: i32 = next_reg(s)
    format_into(s, "  %.{val} = load %{n.as_view()}, ptr %.{slot}\n")
    val

# The builtin `None`: a `%Option$...` with tag 1 (ritz-task-133: ritz0's tag
# convention, Some=0, None=1), the enum its slot names.
fn emit_builtin_none(s: *EmitterState, e: *Expr) -> i32
    let en: StrView = resolve_enum_ctx(s)
    if unnamed(en)
        return emit_no_enum_ctx_error(s, e)   # AGAST #2454
    emit_tagged_unit(s, en, "None", "i8", 1)

# A const's value.
fn emit_const_value(s: *EmitterState, e: *Expr, name: StrView) -> i32
    let ce: *ConstEntry = find_const_entry(s, name)
    if ce != null
        if ce.const_type == TypeKind.Array
            emit_whole_array_error(s, e)   # AGAST #2287, as for a local
            return 0
        # AGAST #189: a scalar struct const (`const FOO: StrView = "..."`) is
        # a real `%StructTy` global (emit_const_struct_entry): load the
        # aggregate, so a site wanting the struct gets one and not the legacy
        # `add i64 0, 0`.
        if ce.const_type == TypeKind.Struct and ce.type_name_len > 0 and ce.value_expr != null
            let result: i32 = next_reg(s)
            emit_struct_load_or_defer(s, TypeKind.Struct, result, StrView { ptr: ce.type_name, len: ce.type_name_len as i64 }, 0 - 1, StrView { ptr: ce.name, len: ce.name_len as i64 })
            return result
        # AGAST #2341: a string `*u8` const is its literal.  Its folded value
        # is 0, which is what `*P` used to read.
        if ce.const_type == TypeKind.Ptr and ce.value_expr != null and ce.value_expr.kind == ExprKind.CstringLit
            return emit_expr(s, ce.value_expr)
    # AGAST #2155: an integer-initialised float const is its float value.
    var folded: i64 = 0
    let cft: TypeKind = const_int_init_float_ty(s, ce, @folded)
    if cft != TypeKind.Void
        let fres: i32 = next_reg(s)
        let fty: StrView = if cft == TypeKind.F32 then "float" else "double"
        format_into(s, "  %.{fres} = sitofp i64 {folded} to {fty}\n")
        return fres
    # AGAST #2176: a float-literal const is its literal, a `double`.
    let lft: TypeKind = const_float_lit_init_ty(ce)
    if lft != TypeKind.Void
        let dv: i32 = emit_expr(s, ce.value_expr)
        if lft == TypeKind.F64
            return dv
        return ir_fptrunc_f64_f32(s.out, @s.reg_counter, dv)
    let val: i64 = find_const(s, name)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = add i64 0, {val}\n")
    result

# A scalar local or global of type `t` just loaded into `r`, as an i64.  A
# pointer or reference slot holds the i64 already.  AGAST #2021: an i8
# sign-extends, matching every *i8 / [N]i8 element load.  A u16 / i16 left at
# its width broke the next `store i64`.  AGAST #2994, #3001: a bool's i1
# byte is zero-extended (#1646); the raw i1 was invalid IR in `not g`.
fn widen_slot_value(s: *EmitterState, t: TypeKind, r: i32) -> i32
    if ty_is_ptr(t) == 1
        return r
    widen_loaded(s, t, r)

# A local's value, `index` its slot.
fn emit_local_value(s: *EmitterState, e: *Expr, index: i32, lv: *LocalVar) -> i32
    let var_type: TypeKind = lv_var_type(lv)
    # AGAST #2287: no array value to give; loading the slot read the first 8
    # bytes as an i64.  Whatever takes a whole array has its own path
    # (emit_array_local_whole_assign, emit_call_arg).  AGAST #2322: nor does
    # `a:& [N]T`; its pointer leaked into `var x: i64 = a`, `a as i64` and
    # `a == null`, all of which ritz0 refuses.  The slots that take its
    # pointer get it from emit_array_arg_addr.
    if var_type == TypeKind.Array
        emit_whole_array_error(s, e)
        return 0
    let result: i32 = next_reg(s)
    emit_struct_load_or_defer(s, var_type, result, local_type_text(lv), index, no_name())
    widen_slot_value(s, var_type, result)

# A global's value.  AGAST #2427: a struct is loaded whole at its own type, as
# a local is; read as an i64, every site taking it was invalid IR.
fn emit_global_value(s: *EmitterState, e: *Expr, glob: *GlobalVarDef) -> i32
    if glob.var_type == TypeKind.Array
        emit_whole_array_error(s, e)   # AGAST #2287, as for a local
        return 0
    let result: i32 = next_reg(s)
    if glob.var_type == TypeKind.Struct and glob.type_name_len > 0
        emit_struct_load_or_defer(s, TypeKind.Struct, result, StrView { ptr: glob.type_name, len: glob.type_name_len as i64 }, 0 - 1, StrView { ptr: glob.name, len: glob.name_len as i64 })
    else
        let ty: StrView = llvm_text(ty_value_llvm(glob.var_type))
        let g: String = ir_name(StrView { ptr: glob.name, len: glob.name_len as i64 })
        format_into(s, "  %.{result} = load {ty}, ptr @{g.as_view()}\n")
    widen_slot_value(s, glob.var_type, result)

# AGAST #1503: a function name used as a value (`apply(double, 5)`, `let f:
# fn(i32) -> i32 = double`, `cb as *u8`) is the function's address, an i64 as
# every pointer is.  The extern is registered unconditionally:
# emit_extern_declarations skips a fn this .ll defines, so an imported one gets
# its `declare` and a local one doesn't.
fn emit_fn_address(s: *EmitterState, f: *FnDef) -> i32
    add_extern(s, StrView { ptr: f.name, len: f.name_len as i64 })
    let addr: i32 = next_reg(s)
    # AGAST #4356: a private free fn's symbol carries its file (fn_symbol).
    var sym_len: i32 = 0
    let sym_ptr: *u8 = fn_symbol(f, @sym_len)
    let sym: String = ir_name(StrView { ptr: sym_ptr, len: sym_len as i64 })
    format_into(s, "  %.{addr} = ptrtoint ptr @{sym.as_view()} to i64\n")
    addr

pub fn emit_expr_ident(s: *EmitterState, e: *Expr) -> i32
    let name: StrView = ident_text(e)
    # AGAST #1509: a multi-dimensional array as a whole value (`h = g`,
    # `f(g)`, ...) is not lowered: the paths below load one i64 out of it.
    # `a:& [N][M]T` has none either (AGAST #2322).
    if nd_array_ident_shape(s, e) != null
        emit_nd_error_sv(s, e.span.line, e.span.col, "a multi-dimensional array is not a value in ritz1 (index it, or take an element's address with @)")
        return 0
    # AGAST #2434: a user's unit `None` is built below, as any bare unit
    # variant; a const, local or global named None shadows the builtin.
    if is_ident_none(name) == 1 and not users_none_wins(s, e) and not none_shadowed(s, name)
        return emit_builtin_none(s, e)
    if is_const(s, name) == 1
        return emit_const_value(s, e, name)
    let index: i32 = find_local(s, name)
    if index >= 0
        return emit_local_value(s, e, index, find_local_struct_name(s, name))
    let glob: *GlobalVarDef = find_global(s, name)
    if glob != null
        return emit_global_value(s, e, glob)
    # Checked after locals and globals, so those shadow a fn of the same name.
    let fn_def: *FnDef = find_fn(s, name)
    if fn_def != null
        return emit_fn_address(s, fn_def)

    # AGAST #2422: `Empty` where the slot is a `Slot<i32>`.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, name, @ivi)
    if iei >= 0 and enum_variant_kind(s.mono.pctx, iei, ivi) == ENUM_VARIANT_UNIT
        return emit_unit_variant_value(s, enum_text(s, iei), ivi)

    # AGAST #1600 / #1610: a bare unit variant `B` of a user enum, as the
    # qualified `S.B` builds it.  Checked last, so a const / local / global /
    # fn of the same name still wins (bare_unit_variant_enum also checks).
    var vi: i32 = 0
    var other_ei: i32 = 0
    let var_ei: i32 = bare_unit_variant_enum(s, e, @vi, @other_ei)
    if var_ei >= 0
        return emit_unit_variant_value(s, enum_text(s, var_ei), vi)
    if var_ei == 0 - 2
        return emit_ambiguous_variant_error(s, name, e.span, vi, other_ei)
    # AGAST #3021: `Empty` where the slot names no `Slot` instance.
    let no_inst: i32 = emit_no_instance_error(s, name, e.span)
    if no_inst != 0
        return no_inst

    # A name nothing declares never gets here: Sema refuses it first, in
    # ritz0's words (call_check_ident, AGAST #4595).  What does is a declared
    # name with no value here, such as a payload variant used bare.
    var msg: String = string_new()
    format_into(@&msg, "unknown identifier '{name}'")
    emit_ir_error_sv(s, e.span, msg.as_view())
    let zero: i32 = next_reg(s)
    format_into(s, "  %.{zero} = add i64 0, 0\n")
    zero

# =============================================================================
# Indexing
# =============================================================================

# LLVM element type of a primitive const array (the spelling
# emit_const_array_entry gave the `@NAME = internal constant [N x T]`
# global, so the GEP stride equals the stored stride), or `no_name()` for
# element kinds emit_global_array_index cannot load and widen to i64 -- struct
# and `**T` -- which keep their previous lowering.  Integers, `*T` (#2357:
# `const A: [N]*u8 = ["A", "B"]`), bool (#3949: `[N x i1]`, without which
# `KS[i]` loaded KS whole) and floats (LARB R60: `[N x double]` /
# `[N x float]`, emit_const_array_shared_entry) are types.ritz's memory
# spelling.
pub fn const_elem_llvm(t: TypeKind) -> StrView
    if t == TypeKind.PtrPtr
        return no_name()
    llvm_text(ty_mem_llvm(t))

# AGAST #1553 / #3325: `name[idx]` on a module-level `[size x %elem]` global
# (a `var` global or a const struct array) as a struct value: `load %elem`
# from the element's GEP, the form a struct-valued deref or call yields.
fn emit_struct_array_elem_load(s: *EmitterState, name: StrView, size: i32, elem: StrView, idx_expr: *Expr) -> i32
    let sptr: i32 = emit_struct_array_elem_ptr(s, name, size, elem, idx_expr)
    emit_struct_load(s, elem, sptr)

# The address of `name[idx]` in a module `[size x %elem]` global or const.
pub fn emit_struct_array_elem_ptr(s: *EmitterState, name: StrView, size: i32, elem: StrView, idx_expr: *Expr) -> i32
    let sidx: i32 = emit_expr(s, idx_expr)
    let sptr: i32 = next_reg(s)
    format_into(s, "  %.{sptr} = getelementptr [{size} x ")
    emit_llvm_type_struct(s, TypeKind.Struct, elem)
    let g: String = ir_name(name)
    format_into(s, "], ptr @{g.as_view()}, i64 0, i64 %.{sidx}\n")
    sptr

# `name[idx]` on a module-level `[size x ty]` global (a `var` global or a
# primitive const array): GEP the global directly, load the element at its
# width, and widen it to the i64 every expression value is carried in.
fn emit_global_array_index(s: *EmitterState, name: StrView, size: i32, elem: TypeKind, ty: StrView, idx_expr: *Expr) -> i32
    let gidx: i32 = emit_expr(s, idx_expr)
    let gptr: i32 = next_reg(s)
    let g: String = ir_name(name)
    format_into(s, "  %.{gptr} = getelementptr [{size} x {ty}], ptr @{g.as_view()}, i64 0, i64 %.{gidx}\n")
    emit_elem_load(s, elem, ty, gptr)

# The element kind of a `Vec$T` / `Span$T` whose `T` is `elem`: an integer of
# up to 32 bits by its name, else an i64 slot.
fn view_elem_kind(elem: StrView) -> TypeKind
    let t: TypeKind = ty_from_name(elem)
    if ty_int_in(t, 8, 32) == 1
        return t
    TypeKind.I64

# `v[i]` through the Vec$T / Span$T struct at the `ptr` register `view`, whose
# type `name` carries T after its `prefix` bytes ("Vec$", "Span$"): load the
# data pointer (field 0), GEP by T's stride, load and widen.  `idx` is the
# index, already emitted.
fn emit_view_elem(s: *EmitterState, view: i32, name: StrView, prefix: i64, idx: i32) -> i32
    let kind: TypeKind = view_elem_kind(name.slice(prefix, name.len))
    let ty: StrView = llvm_text(ty_mem_llvm(kind))
    let data_field: i32 = next_reg(s)
    gep_struct_open(s, data_field, name)
    format_into(s, ", ptr %.{view}, i32 0, i32 0\n")
    let data: i32 = next_reg(s)
    format_into(s, "  %.{data} = load ptr, ptr %.{data_field}\n")
    let elem_ptr: i32 = next_reg(s)
    format_into(s, "  %.{elem_ptr} = getelementptr {ty}, ptr %.{data}, i64 %.{idx}\n")
    emit_elem_load(s, kind, ty, elem_ptr)

# `v[idx_expr]` through the Vec / Span at `view`: the index, then the element.
fn emit_view_index(s: *EmitterState, view: i32, name: StrView, prefix: i64, idx_expr: *Expr) -> i32
    let idx: i32 = emit_expr(s, idx_expr)
    emit_view_elem(s, view, name, prefix, idx)

# A `Vec$T` type name.
fn is_vec_name(name: StrView) -> bool
    name.len > 4 and name.starts_with("Vec$")

# AGAST #2321: `p[i]` on `p: *[N]T` / `@[N]T` / `@&[N]T` is element i of the array
# behind it, stride T, as ritz0 reads it.  The pointee named no element, so this
# took the byte path: one byte at offset i, and a clang error for `@&`.  A struct
# element has no by-value read (#1562), so it's refused: the byte path gives an
# integer, which `p[1] + 1` and `p[1] as i64` took without a word.  `p[1].x` never
# gets here.  None when `e` is no such index.
fn emit_array_ptr_index(s: *EmitterState, e: *Expr) -> Option<i32>
    let loc: *LocalVar = array_ptr_index_base(s, e.left)
    if loc == null
        return None
    if is_range_index(e)
        emit_nd_error_sv(s, e.span.line, e.span.col, "a pointer to an array can't be sliced (only String, Vec and Span can)")
        return Some(0)
    let elem: TypeKind = lv_pointee_array_elem_type(loc)
    let refusal: StrView = array_ptr_elem_refusal(elem)
    if not unnamed(refusal)
        emit_nd_error_sv(s, e.span.line, e.span.col, refusal)
        return Some(0)
    let idx: i32 = emit_expr(s, e.right)
    let base: i32 = emit_load_ptr(s, loc.reg)
    Some(emit_array_elem_read(s, elem, lv_pointee_array_size(loc), base, idx))

# Why an element of kind `elem` can't be read through a pointer to an array;
# `no_name()` when it can.
fn array_ptr_elem_refusal(elem: TypeKind) -> StrView
    match elem
        TypeKind.Array => "a pointer to a multi-dimensional array can't be indexed in ritz1"
        # A `*[N]*U` has a `**U` view and never gets here (#2522); a `*[N]**U` has none.
        TypeKind.Ptr | TypeKind.PtrPtr => "a pointer to an array of pointers can't be indexed in ritz1"
        TypeKind.Struct => "a whole struct element can't be read through a pointer to an array in ritz1 (read its fields)"
        _ => no_name()

# "Vec$..", "Span$.." or "String": what `[lo..hi]` slices (AGAST #2451).
pub fn is_sliceable_name(name: StrView) -> bool
    if name.ptr == null
        return false
    is_vec_name(name) or (name.len > 5 and name.starts_with("Span$")) or name.eq("String")

# What a refused `[lo..hi]` names its base, as ritz0's _unsliceable does
# (AGAST #2521).  Every base is refused: an array or a pointer is named, and
# any other base gets the plain refusal.
fn unsliceable_message(base_type: TypeKind) -> StrView
    match base_type
        TypeKind.Array => "an array can't be sliced (only String, Vec and Span can)"
        TypeKind.PtrPtr => "a pointer to a pointer can't be sliced (only String, Vec and Span can)"
        TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef => "a pointer can't be sliced (only String, Vec and Span can)"
        _ => "this can't be sliced (only String, Vec and Span can)"

# `e[lo..hi]`: an index by a range.
fn is_range_index(e: *Expr) -> bool
    e.right != null and e.right.kind == ExprKind.Range

# AGAST #2537: `(*r)[i]` where `*r` is a `*T` and T is the scalar `elem`:
# `*r` is the pointer (an i64), so GEP it at T's own memory type
# (local_array_elem_llvm: `i1` for bool, `float` / `double` for floats) and
# widen as an array element is.
fn emit_deref_index(s: *EmitterState, e: *Expr, elem: TypeKind) -> i32
    let base_ptr: i32 = emit_index_base_ptr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    emit_ptr_elem_read(s, elem, base_ptr, idx)

# AGAST #2330, #2996: `e`, a whole struct element, where a number goes.  A copy
# (`let s: S = a[i]`, `g(a[i])`) is s.struct_copy_expr; anything else put a `%S`
# where clang wanted an i64 (`a[i] as i32`, `return a[i]`, `a[i] + 1`).  Refuses
# it, located, and returns true; false for a copy.
#
# AGAST #4450: an enum element (`a[i]` of `[N]E`, `p[i]` of `*E`) is no
# struct: its `%E` is the value every consumer reads the tag of, as a local's
# (unit_enum_expr_name), so it is never refused here.
pub fn whole_struct_elem_refused(s: *EmitterState, e: *Expr) -> bool
    if unit_enum_expr_name(s, e).len > 0
        return false
    struct_value_refused(s, e, whole_struct_value_message())

# A struct element of type `name` (a known struct) where a copy can't take it:
# whole_struct_elem_refused, for the element kinds that name their struct.
fn struct_elem_refused(s: *EmitterState, e: *Expr, name: StrView) -> bool
    name.len > 0 and find_struct(s, name) != null and whole_struct_elem_refused(s, e)

# The shared refusal: a struct value `e` where a number goes, located at `e`
# with `msg`.  True when refused; false when `e` is the copy being emitted.
fn struct_value_refused(s: *EmitterState, e: *Expr, msg: StrView) -> bool
    if s.struct_copy_expr == e
        return false
    emit_nd_error_sv(s, e.span.line, e.span.col, msg)
    true

# AGAST #3008: `s as i32`, `mk() as i32` on a struct `S`: ritz0's refusal (#2999).
# ritz1 emitted the `%S` as the integer and clang refused the IR.  1 when refused.
pub fn struct_cast_to_int_refused(s: *EmitterState, e: *Expr) -> i32
    if ty_int_bits(e.type_kind) == 0
        return 0
    let name: StrView = struct_value_name(s, e.left)
    if unnamed(name)
        return 0
    var msg: String = string_new()
    format_into(@&msg, "cannot cast struct `{name}` to `{primitive_spelling(e.type_kind)}`: a struct is not an integer (read one of its fields, or take its address with @)")
    struct_value_refused(s, e.left, msg.as_view()) as i32

# AGAST #3008: `return s`, `return mk()` or a tail `mk()` in an `-> i64` fn, on a
# struct `S`: ritz0's refusal (#2999).  True when refused.
pub fn struct_return_as_int_refused(s: *EmitterState, value: *Expr, ret_type: TypeKind) -> bool
    if ty_int_bits(ret_type) == 0
        return false
    let name: StrView = struct_value_name(s, value)
    if unnamed(name)
        return false
    var msg: String = string_new()
    format_into(@&msg, "the fn returns `{primitive_spelling(ret_type)}`, but this is struct `{name}`: a struct is not an integer (return one of its fields)")
    struct_value_refused(s, value, msg.as_view())

# What an index store's base points at (AGAST #3565): a scalar kind, or
# TypeKind.Struct and the struct's `name`.  `pp` when the base is a `**T`, whose
# element is a pointer (kind TypeKind.Ptr).  Kind TypeKind.Void: nothing typed.
pub struct StorePointee
    kind: TypeKind
    name: StrView
    pp: bool

fn no_pointee() -> StorePointee
    StorePointee { kind: TypeKind.Void, name: no_name(), pp: false }

fn scalar_pointee(t: TypeKind) -> StorePointee
    StorePointee { kind: t, name: no_name(), pp: false }

fn struct_pointee(name: StrView) -> StorePointee
    StorePointee { kind: TypeKind.Struct, name: name, pp: false }

# A `**T` base: its element is a pointer.
fn pointer_pointee() -> StorePointee
    StorePointee { kind: TypeKind.Ptr, name: no_name(), pp: true }

# A scalar `t`, else the known struct `name`, else nothing.
fn scalar_or_struct_pointee(s: *EmitterState, t: TypeKind, name: StrView) -> StorePointee
    if primitive_name_len(t) > 0
        return scalar_pointee(t)
    if t != TypeKind.Struct or name.ptr == null or name.len == 0 or find_struct(s, name) == null
        return no_pointee()
    struct_pointee(name)

# AGAST #3565: the pointee of `x`, the root of an index store's base (a local,
# param, global, field, cast or call).  A `**T` root's element is a pointer.  A
# `*T` root has what ptr_root_pointee says, or for a global (which
# ptr_root_pointee leaves to its callers' own global arms) its recorded
# pointee.  sema_index_store.ritz's index_store_check accepts exactly these roots.
fn index_store_root_pointee(s: *EmitterState, x: *Expr) -> StorePointee
    # AGAST #3757: `@a[i]`, the address of an inline array's element.
    if x.kind == ExprKind.Unary
        return addr_elem_root_pointee(s, x)
    # AGAST #3757: `p as @&T` (a `ptr`, #1754) points at T as `p as *T` does;
    # the parser records a scalar T (cast_tail_new) as it does a struct.
    if x.kind == ExprKind.Cast and x.type_kind == TypeKind.MutRef
        return scalar_or_struct_pointee(s, ptr_slot_flat(x.cast_ptr_kind), ident_text(x))
    var pp: bool = false
    match x.kind
        ExprKind.Cast =>
            pp = x.type_kind == TypeKind.PtrPtr
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, x)
            pp = fd != null and fd.return_type == TypeKind.PtrPtr
        ExprKind.Member =>
            let fld: *StructField = member_field_def(s, x)
            pp = fld != null and fld.field_type == TypeKind.PtrPtr
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, ident_text(x))
            if loc == null
                return global_store_pointee(s, find_global(s, ident_text(x)))
            pp = lv_var_type(loc) == TypeKind.PtrPtr
        _ =>
            return no_pointee()
    if pp
        return pointer_pointee()
    let root: NamedKind = ptr_root_pointee(s, x)
    StorePointee { kind: root.kind, name: root.name, pp: false }

# The pointee of global `glob` as an index store's root (null: not a global).
fn global_store_pointee(s: *EmitterState, glob: *GlobalVarDef) -> StorePointee
    if glob == null
        return no_pointee()
    if glob.var_type == TypeKind.PtrPtr
        return pointer_pointee()
    if glob.var_type != TypeKind.Ptr
        return no_pointee()
    let name: StrView = StrView { ptr: glob.pointee_type_name, len: glob.pointee_type_name_len as i64 }
    scalar_or_struct_pointee(s, glob.pointee_type, name)

# AGAST #3757: the element type of `@a[i]` (`@` only, not `@&`) over an
# inline array (a local, global or field `[N]T`, any rank): its scalar kind,
# or TypeKind.Struct with the name written.  Nothing for anything else (a
# pointer or view element, a Vec).  `@a[i] + k` strides by it
# (ptr_arith_elem_size).  sema_index_store.ritz's isc_addr_elem_ok accepts a
# subset (named arrays).
fn addr_elem_root_pointee(s: *EmitterState, x: *Expr) -> StorePointee
    if x.op != OpKind.Addr or x.operand == null or x.operand.kind != ExprKind.Index
        return no_pointee()
    let rec: ElemRecord = array_elem_record(s, x.operand)
    scalar_or_struct_pointee(s, rec.elem, rec.name)

# AGAST #3757: the base `e` of an expression-target index as a `ptr` register:
# emit_expr's i64 converted, or the `ptr` an `as @&T` cast already is (#1754).
pub fn emit_index_base_ptr(s: *EmitterState, e: *Expr) -> i32
    let base: i32 = emit_expr(s, e)
    if expr_is_ptr_valued(s, e) == 1
        return base
    ir_inttoptr_ptr(s.out, @s.reg_counter, base)

# AGAST #3565: the pointee of an index store's base `x` when it names a `*T`
# or `**T`: a root index_store_root_pointee types, or pointer arithmetic
# `y + k` / `y - k` down the left spine of one.  Nothing otherwise.
pub fn index_store_base_pointee(s: *EmitterState, x: *Expr) -> StorePointee
    var root: *Expr = x
    while root.kind == ExprKind.Binary
        if root.op != OpKind.Add and root.op != OpKind.Sub
            return no_pointee()
        # `q - p` of two pointers is a count, not a pointer.
        if root.op == OpKind.Sub and index_store_base_pointee(s, root.right).kind != TypeKind.Void
            return no_pointee()
        root = root.left
    # An `as @&T` cast is a `ptr`, and a reference does no arithmetic.
    if root != x and root.kind == ExprKind.Cast and root.type_kind == TypeKind.MutRef
        return no_pointee()
    index_store_root_pointee(s, root)

# AGAST #3833: `(e as *S)[i]` and `(q + k)[i]` over a `*S`: the `%S` at
# element i, at a stride of sizeof(S).  A copy only (the caller refuses the
# rest, whole_struct_elem_refused).
fn emit_struct_ptr_index(s: *EmitterState, e: *Expr, name: StrView) -> i32
    let base_ptr: i32 = emit_index_base_ptr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let ptr: i32 = next_reg(s)
    format_into(s, "  %.{ptr} = getelementptr ")
    emit_llvm_type_struct(s, TypeKind.Struct, name)
    format_into(s, ", ptr %.{base_ptr}, i64 %.{idx}\n")
    emit_struct_load(s, name, ptr)

# `e` read as `*(base + i)` (elem_index_as_deref), at the pointee's stride and
# width.
fn emit_index_as_deref(s: *EmitterState, e: *Expr) -> i32
    var sum: Expr
    var deref: Expr
    elem_index_as_deref(s, e, @sum, @deref)
    emit_expr(s, @deref)

# The index forms that need no base type (through a borrow, a range, N-D,
# array-pointer, element-pointer, call-result and cast bases): the value, or
# 0 after a refusal; None when `e` is none of them.
fn try_emit_index_early(s: *EmitterState, e: *Expr) -> Option<i32>
    # AGAST #2440: `p[i]` through a reference or pointer.
    if through_slice_refused(s, e) == 1
        return Some(0)
    # `f()[i]` of a `-> [N]T` call is read from a spill in emit_expr (AGAST
    # #3234); emit_call_array_index puts a local in its place before here.
    let through: *LocalVar = index_through(s, e)
    if through != null
        # AGAST #2330: a struct element of a pointer to an array, as a value.  A
        # copy, `let s: S = p[i]` or `g(p[i])`, doesn't come here, and its fields
        # don't either.  This was #2321's located refusal, and `*(q + i)` failed
        # at clang for `p[i] + 1`, `p[i] as i64` and `return p[i]`.
        if lv_is_array_view(through) == 1 and lv_pointee_type(through) == TypeKind.Struct and whole_struct_elem_refused(s, e)
            return Some(0)
        var th: ThroughIndex
        index_through_fill(s, e, through_spill(s, through), @th)
        return Some(emit_expr(s, @th.deref))
    let ranged: bool = is_range_index(e)
    # AGAST #3403: a range on an N-D array (`a[1][0..2]`, `h.m[1][0..2]`, a
    # plane pointer's `q[1][0..2]`) is #2521's refusal, in ritz0's words.
    # emit_nd_index_value below lowered the range as an index value, and
    # ritz1 refused it unlocated, as "unknown expression kind".
    if ranged
        var nd_depth: i32 = 0
        if nd_index_shape(s, e, @nd_depth) != null
            emit_nd_error_sv(s, e.span.line, e.span.col, unsliceable_message(TypeKind.Array))
            return Some(0)
    # AGAST #1509: `g[i][j]` over a multi-dimensional array (one GEP chain).
    var nd_val: i32 = 0
    if emit_nd_index_value(s, e, @nd_val) == 1
        return Some(nd_val)
    match emit_array_ptr_index(s, e)
        Some(v) => return Some(v)
        None => pass
    match try_emit_elem_ptr_index(s, e, ranged)
        Some(v) => return Some(v)
        None => pass
    if ranged
        return None
    try_emit_ptr_root_index(s, e)

# `p[i]` over an element pointer that indexes as `*(p + i)`: an element of an
# array of pointers, a `**T` element, a `*S` local, a `*E` of a user enum.
fn try_emit_elem_ptr_index(s: *EmitterState, e: *Expr, ranged: bool) -> Option<i32>
    # AGAST #2332: `a[i][j]` with `a: [N]*T`.  It took the byte path.
    if is_array_elem_index(s, e) == 1
        if ranged
            emit_nd_error_sv(s, e.span.line, e.span.col, "an element of an array of pointers can't be sliced (only String, Vec and Span can)")
            return Some(0)
        # AGAST #3188: a struct pointee is a copy only, as a `[N]S` element is.
        if struct_elem_refused(s, e, deref_pointee_struct_name(s, e.left))
            return Some(0)
        return Some(emit_index_as_deref(s, e))
    # AGAST #3058: `b[i][j]` with `b: [N]**T` is `*(b[i] + j)`, a `*T` loaded at a
    # pointer's stride.  It took the byte path: one i8 at `b[i] + j`.
    if is_ptr_ptr_elem_index(s, e) == 1
        return Some(emit_index_as_deref(s, e))
    # AGAST #3052: `p[i]` with `p: *S` is `*(p + i)`, the `%S` at a stride of
    # sizeof(S).  It took the byte path: one i8 at `p + i`, an i64 where a
    # `%S` goes, so `let c: S = p[0]` failed at clang.
    let ps_name: StrView = ptr_local_struct_index(s, e)
    if ps_name.len > 0
        # AGAST #3188: a copy only.  `let n: i32 = p[0]`, `p[0] + 1` and
        # `return p[0]` put the `%S` where an integer goes, and clang refused it.
        if struct_elem_refused(s, e, ps_name)
            return Some(0)
        return Some(emit_index_as_deref(s, e))
    # AGAST #4450: `g[i]`, `h.ks[i]`, `f()[i]` through any `*E` (E a user
    # enum) is `*(g + i)`, the `%E` at E's stride -- the value
    # unit_enum_expr_name reads the tag of.  A global's or a field's took the
    # byte path: one i8 widened to i64, where a `%E` goes.
    if ptr_index_user_enum(s, e).len > 0
        return Some(emit_index_as_deref(s, e))
    None

# `p[i]` (not a range) over a pointer the base's root types: `(*r)[i]`, a call's
# `f()[i]`, a cast's or arithmetic's `(e as *T)[i]` / `(q + k)[i]`.
fn try_emit_ptr_root_index(s: *EmitterState, e: *Expr) -> Option<i32>
    # AGAST #3147: `(*r)[i]` with `*r` a `*C` (`r: **C`, `@*C`, `@&*C`) is
    # `*(*r + i)`, the `%C` at a stride of sizeof(C), as #3122 stores one.  It
    # took the byte path: one i8, an i64 where a `%C` goes.  A copy only, as
    # `p[i]` is.
    let dp_name: StrView = deref_ptr_ptr_struct_name(s, e.left)
    if dp_name.len > 0 and find_struct(s, dp_name) != null
        if whole_struct_elem_refused(s, e)
            return Some(0)
        return Some(emit_index_as_deref(s, e))
    # AGAST #3527: `f()[i]` with `f` returning a `*T` or `**T` is `*(f() + i)`,
    # at the pointee's stride and width (ptr_root_pointee, as #3442 stores
    # one): a scalar T, a `%S` (a copy only) or a `ptr`.  It took the byte
    # path: `arr()[1]` over a `*i32` read byte 1 of a[0].
    #
    # AGAST #4060: and `b.arr()[i]`, a method returning `*T` / `**T`, as #3528
    # stores one.  It took the byte path too: `b.arr()[1]` over a `*i32` read 0.
    # ptr_arith_elem_size (stride) and inline_ptr_pointee (width) take a
    # method root too, so the `*(b.arr() + i)` loads a T at T's stride.
    let cb_fd: *FnDef = call_fn_def(s, e.left)
    if cb_fd != null
        var cb_name: *u8 = null
        var cb_len: i32 = 0
        let cb_kind: TypeKind = fn_ptr_return_pointee(s, cb_fd, @cb_name, @cb_len)
        if cb_kind != TypeKind.Void or cb_fd.return_type == TypeKind.PtrPtr
            if cb_kind == TypeKind.Struct and whole_struct_elem_refused(s, e)
                return Some(0)
            return Some(emit_index_as_deref(s, e))
    # AGAST #3756, #3833: `(e as *T)[i]`, `(e as **T)[i]` and `(q + k)[i]` read
    # element i at the pointee's stride and width, as emit_ptr_base_index_store
    # (#3565) stores one: a scalar T, a `%S` (a copy only) or, through a `**T`,
    # a `ptr`.  They took the byte path: one i8 at `base + i` (`(q + 1)[1]`
    # over a `*i32` read byte 1 of a[1]).
    if e.left.kind == ExprKind.Cast or e.left.kind == ExprKind.Binary
        let tb: StorePointee = index_store_base_pointee(s, e.left)
        if tb.kind == TypeKind.Struct
            if whole_struct_elem_refused(s, e)
                return Some(0)
            return Some(emit_struct_ptr_index(s, e, tb.name))
        if tb.kind != TypeKind.Void
            return Some(emit_deref_index(s, e, tb.kind))
    None

# What an index's base is, when it is a name: its type (TypeKind.Ptr when it
# isn't a name, or names nothing), a pointer's element kind when known, and
# the local it names.
struct IndexBase
    kind: TypeKind
    pointee: TypeKind
    local: *LocalVar

# AGAST #1328: the base resolves through locals THEN globals, and carries the
# pointee kind so the pointer path can load the element at its real width.  A
# global base used to hit find_local_type's miss value and take the byte path
# (`g[i]` on a global *i32 read one byte of a 4-byte slot).
fn index_base(s: *EmitterState, e: *Expr) -> IndexBase
    var b: IndexBase = IndexBase { kind: TypeKind.Ptr, pointee: TypeKind.Unknown, local: null }
    if e.left.kind != ExprKind.Ident
        return b
    let name: StrView = ident_text(e.left)
    b.kind = find_local_type(s, name)
    b.local = find_local_struct_name(s, name)
    if b.kind != TypeKind.Unknown
        if b.local != null
            b.pointee = lv_pointee_type(b.local)
        return b
    let glob: *GlobalVarDef = find_global(s, name)
    if glob == null
        # Neither local nor global: the byte path, rather than letting
        # TypeKind.Unknown leak downstream.
        b.kind = TypeKind.Ptr
        return b
    b.kind = glob.var_type
    b.pointee = glob.pointee_type
    b

# Why `x[lo..hi]` on a named base is refused.  A range index slices a Vec,
# Span or String only, and monomorph rewrites one into `v.slice(lo, hi)`
# (AGAST #2451); what reaches here is refused, located (#2521).
fn named_slice_refusal(e: *Expr, base: IndexBase) -> StrView
    if base.local != null
        # AGAST #2290: ritz0 slices no array, so a borrowed one isn't either.
        if base.kind == TypeKind.Array and lv_is_lent(base.local) == 1
            return "an `a:& [N]T` param can't be sliced (only String, Vec and Span can)"
        # AGAST #2451: a Vec, Span or String local was sliced here into a bare
        # address, so `t[1]` read bytes and `t.len` had no struct.  What
        # monomorph didn't rewrite is refused rather than read as an address.
        if base.kind == TypeKind.Struct
            if is_sliceable_name(local_type_text(base.local))
                return "this slice of a Vec, Span or String isn't lowered by ritz1 (`let t = v[lo..hi]` is)"
            return "a struct can't be sliced (only String, Vec and Span can)"
    # AGAST #2521: nothing else slices (LANGUAGE_SPEC §3.4, R9 rules 5 and
    # 6).  An array, a raw `*T` and a `**Vec` were lowered here to a bare
    # address in an i64 (#110, #1974), read as 20 for the first two and as
    # garbage for the third.  ritz0 refuses each, at the same place.  A base
    # that isn't a name defaulted to TypeKind.Ptr: ask its type.
    if e.left.kind != ExprKind.Ident
        return unsliceable_message(expr_slot_ty(e.left))
    unsliceable_message(base.kind)

# `x[i]` on a named local, global or const (and `x[a..b]` on one), by its base.
fn try_emit_index_named(s: *EmitterState, e: *Expr, base: IndexBase) -> Option<i32>
    if is_range_index(e)
        emit_nd_error_sv(s, e.span.line, e.span.col, named_slice_refusal(e, base))
        return Some(0)
    let local: *LocalVar = base.local
    if base.kind == TypeKind.Array
        if local != null
            return Some(emit_local_array_index(s, e, local))
        # AGAST #1504: a GLOBAL `[N]T` array: GEP the global directly.  It fell
        # to the pointer fallback (`load i64 @g; inttoptr; gep`), which used the
        # first element as a base address and segfaulted.  `g[i].field` goes
        # through emit_member_ptr, not here.
        if e.left.kind == ExprKind.Ident
            match try_emit_global_array_index(s, e, find_global(s, ident_text(e.left)))
                Some(v) => return Some(v)
                None => pass
    if local == null
        if e.left.kind == ExprKind.Ident
            return try_emit_const_array_index(s, e, find_const_entry(s, ident_text(e.left)))
        return None
    try_emit_view_local_index(s, e, local)

# `a[i]` on a `[N]T` local.
fn emit_local_array_index(s: *EmitterState, e: *Expr, local: *LocalVar) -> i32
    let elem: TypeKind = lv_array_elem_type(local)
    if elem == TypeKind.Struct and lv_type_name_len(local) > 0
        # AGAST #2592: a whole struct element of a `[N]P` local is a `%P`
        # value, as the global (#1553) and field (#188) arms load it.  It was
        # read as a `[N x i64]` slot, so `let p: P = ps[1]` stored an i64 into
        # a %P slot and clang refused the IR.  AGAST #2996: a copy only.
        if whole_struct_elem_refused(s, e)
            return 0
        let sidx: i32 = emit_expr(s, e.right)
        let sptr: i32 = emit_struct_elem_addr(s, lv_array_size(local), local_type_text(local), local.reg, sidx)
        return emit_struct_load(s, local_type_text(local), sptr)
    # GEP [0, index] at the alloca's own element type (AGAST #1564: u32 / u16
    # / i16 used to fall to `[N x i64]` over a narrower alloca), then load.  A
    # float / double element is the value itself (#1966): no widen.
    let idx: i32 = emit_expr(s, e.right)
    emit_array_elem_read(s, elem, lv_array_size(local), local.reg, idx)

# `g[i]` on a `[N]T` global (null: none of that name).
fn try_emit_global_array_index(s: *EmitterState, e: *Expr, garr: *GlobalVarDef) -> Option<i32>
    if garr == null
        return None
    let name: StrView = StrView { ptr: garr.name, len: garr.name_len as i64 }
    if garr.array_elem_type != TypeKind.Struct
        let ty: StrView = elem_mem_llvm(garr.array_elem_type)
        return Some(emit_global_array_index(s, name, garr.array_size, garr.array_elem_type, ty, e.right))
    if garr.array_elem_type_name_len == 0
        return None
    # AGAST #1553: a whole struct element (`let q: P = g[i]`) is a struct
    # value: `load %P` from the `[N x %P]` GEP, the same form a struct-valued
    # deref or call yields, so a %P slot can take it.  AGAST #2996: a copy only.
    if whole_struct_elem_refused(s, e)
        return Some(0)
    let elem: StrView = StrView { ptr: garr.array_elem_type_name, len: garr.array_elem_type_name_len as i64 }
    Some(emit_struct_array_elem_load(s, name, garr.array_size, elem, e.right))

# AGAST #1534: `T[i]` on a module `const T: [N]X = [...]`, which
# emit_const_array_entry emits as `@T = internal constant [N x X]`.  T is
# neither a local nor a global, so it fell to the pointer fallback, where
# emit_expr_ident inlined the const's scalar value (0) as the base: a segfault
# (cryptosec SBOX/RCON).  Index the const's global at its element width.  A
# local of the same name shadows the const (the caller asks only without one).
fn try_emit_const_array_index(s: *EmitterState, e: *Expr, carr: *ConstEntry) -> Option<i32>
    if carr == null or carr.const_type != TypeKind.Array or carr.value_expr == null
        return None
    let lit: bool = carr.value_expr.kind == ExprKind.ArrayLit
    if not lit and carr.value_expr.kind != ExprKind.ArrayFill
        return None
    let name: StrView = StrView { ptr: carr.name, len: carr.name_len as i64 }
    # AGAST #3325: a struct element (`KS[1]` of `[N]StrView`) is read as a
    # global's is (#1553): emit_const_array_entry declares the const
    # `[N x %P]`.  AGAST #3946: a refused struct fill reads its placeholder
    # global.
    if carr.array_elem_type == TypeKind.Struct and carr.array_elem_type_name_len > 0 and (lit or const_struct_fill_global(carr) == 1)
        if whole_struct_elem_refused(s, e)
            return Some(0)
        let elem: StrView = StrView { ptr: carr.array_elem_type_name, len: carr.array_elem_type_name_len as i64 }
        return Some(emit_struct_array_elem_load(s, name, carr.array_size, elem, e.right))
    let cty: StrView = const_elem_llvm(carr.array_elem_type)
    if unnamed(cty)
        return None
    Some(emit_global_array_index(s, name, carr.array_size, carr.array_elem_type, cty, e.right))

# `v[i]` on a Vec$T or Span$T local (task-101: `let b = s.as_bytes(); b[0]`,
# `let b = "ABC"; b[0]`; `v[i]` with `v: Vec<T>`).  Loading the whole struct
# and taking the byte path's `inttoptr i64 %base` was invalid IR: a struct is
# not an i64.
fn try_emit_view_local_index(s: *EmitterState, e: *Expr, local: *LocalVar) -> Option<i32>
    if lv_var_type(local) != TypeKind.Struct
        return None
    let name: StrView = local_type_text(local)
    if is_vec_name(name)
        return Some(emit_view_index(s, local.reg, name, 4, e.right))
    if name.starts_with("Span$")
        return Some(emit_view_index(s, local.reg, name, 5, e.right))
    None

# `s.f[i]` with `f: [N]T` inline in s: the element at `mr`'s field address.
fn emit_field_array_index(s: *EmitterState, e: *Expr, mr: *MemberPtrResult, field: *StructField) -> i32
    let et: TypeKind = field.array_elem_type
    if et != TypeKind.Struct or field.array_elem_type_name_len == 0
        # AGAST #1814: the field's declared element type.  Integer and
        # pointer elements widen to i64, a bool's i1 zero-extends, and an
        # f32 / f64 element is its own `float` / `double` (AGAST #1954).
        let idx: i32 = emit_expr(s, e.right)
        return emit_array_elem_read(s, et, field.array_size, mr.reg, idx)
    # AGAST #2996: a whole struct element is a copy only.
    if whole_struct_elem_refused(s, e)
        return 0
    # AGAST #188: a struct element is GEP'd as `[N x %T]`, so the stride
    # matches the struct's layout, and loaded as `%T`, not as i64 (mausoleum
    # doc_remove_field's `doc.fields[i + 1]`).
    let elem: StrView = StrView { ptr: field.array_elem_type_name, len: field.array_elem_type_name_len as i64 }
    let idx: i32 = emit_expr(s, e.right)
    let elem_ptr: i32 = emit_struct_elem_addr(s, field.array_size, elem, mr.reg, idx)
    emit_struct_load(s, elem, elem_ptr)

# `s.field[i]`: an array, pointer or Vec field.  None when `e.left` is no
# member with such a field.
fn try_emit_index_member(s: *EmitterState, e: *Expr) -> Option<i32>
    if e.left.kind != ExprKind.Member
        return None
    var member_result: MemberPtrResult
    emit_member_ptr(s, e.left, @member_result)
    if member_result.success != 1
        return None
    let field: *StructField = member_result.field
    let ft: TypeKind = field.field_type
    if ft == TypeKind.Array
        return Some(emit_field_array_index(s, e, @member_result, field))
    # AGAST #184: `obj.fwd[i]` with `fwd: **Foo`, a pointer to an array of
    # *Foo (skip-list / hash-bucket pattern; tome's `update[k].forward[k]`):
    # load the field, GEP at a pointer's stride, load the i-th *Foo, and
    # carry it as an i64.
    if ft == TypeKind.PtrPtr and field.field_type_name_len > 0
        let idx: i32 = emit_expr(s, e.right)
        let arr: i32 = next_reg(s)
        format_into(s, "  %.{arr} = load ptr, ptr %.{member_result.reg}\n")
        return Some(emit_ptr_elem_read(s, TypeKind.Ptr, arr, idx))
    # AGAST #1596: `x.f[i]` with `f: *T` (a primitive pointee) or `**T`: load
    # the pointer from the field, GEP by the pointee width, load and widen.
    # AGAST #2053: an f32 / f64 pointee loads as float / double, not widened.
    let pf_kind: TypeKind = ptr_field_elem_kind(field)
    if (ft == TypeKind.Ptr or ft == TypeKind.PtrPtr) and pf_kind != TypeKind.Unknown and pf_kind != TypeKind.Struct
        let pf_ty: StrView = elem_mem_llvm(pf_kind)
        let pf_idx: i32 = emit_expr(s, e.right)
        let pf_ptr: i32 = emit_ptr_field_elem_addr(s, member_result.reg, field, pf_kind, pf_idx)
        return Some(emit_elem_load(s, pf_kind, pf_ty, pf_ptr))
    # AGAST #3972: `x.f[i]` with `f: *S`, the whole S by value, as `p[i]` on a
    # `*S` local is (#3052).  It took the byte path: one `load i8`, stored as
    # the %S (lexis's `rule_entry_new(rule.selectors.selectors[k], ...)`),
    # which clang refused.  A Vec, Span or String pointee indexes through.
    if ptr_field_struct_elem(s, field) == 1
        if whole_struct_elem_refused(s, e)
            return Some(0)
        let ps_idx: i32 = emit_expr(s, e.right)
        let ps_ptr: i32 = emit_ptr_field_elem_addr(s, member_result.reg, field, TypeKind.Struct, ps_idx)
        return Some(emit_struct_load(s, field_type_text(field), ps_ptr))
    # Port of ritz0 bedc85b: `s.vec_field[i]`, through the Vec$T field's
    # address in member_result.reg.
    if ft == TypeKind.Struct and is_vec_name(field_type_text(field))
        return Some(emit_view_index(s, member_result.reg, field_type_text(field), 4, e.right))
    None

# Port of ritz0 bedc85b: `mk()[i]` on a call returning Vec<T>: spill the
# returned struct to a stack slot, then index through it.
fn try_emit_index_call(s: *EmitterState, e: *Expr) -> Option<i32>
    if e.left.kind != ExprKind.Call
        return None
    let cfn: *FnDef = find_call_fn(s, e.left)
    if cfn == null or cfn.return_type != TypeKind.Struct
        return None
    let vec: StrView = StrView { ptr: cfn.return_type_name, len: cfn.return_type_name_len as i64 }
    if not is_vec_name(vec)
        return None
    let call_val: i32 = emit_expr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let slot: i32 = next_reg(s)
    let vec_ir: String = ir_name(vec)
    entry_alloca_reg_begin_named(s, slot)
    format_into(s, "{vec_ir.as_view()}\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, vec, call_val, slot)
    Some(emit_view_elem(s, slot, vec, 4, idx))

# The element a pointer base `p[i]` reads: a pointer's for a `**T`, the
# pointee's own for a `*T` / reference to an integer other than u8 or a float
# (AGAST #1328, #1973), else a byte.
fn through_ptr_elem(base_type: TypeKind, pointee: TypeKind) -> TypeKind
    if base_type == TypeKind.PtrPtr
        return TypeKind.Ptr
    let ptr_like: bool = base_type == TypeKind.Ptr or base_type == TypeKind.Ref or base_type == TypeKind.MutRef
    let typed: bool = (ty_is_int(pointee) == 1 and pointee != TypeKind.U8) or ty_is_float(pointee) == 1
    if ptr_like and typed
        return pointee
    TypeKind.U8

# The fallback: `p[i]` through a pointer, by its pointee, or a byte.
fn emit_index_through_ptr(s: *EmitterState, e: *Expr, base: IndexBase) -> i32
    # AGAST #2537: `(*r)[i]` with `r: **T` GEPs and loads T (get_expr_type's
    # deref_index_elem), widened as an array element is.  It took the byte
    # path: wrong values on an integer, invalid IR on a float.
    let dix: TypeKind = deref_index_elem(s, e)
    if dix != TypeKind.Void
        return emit_deref_index(s, e, dix)
    let elem: TypeKind = through_ptr_elem(base.kind, base.pointee)
    let base_reg: i32 = emit_expr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, base_reg)
    emit_ptr_elem_read(s, elem, base_ptr, idx)

pub fn emit_expr_index(s: *EmitterState, e: *Expr) -> i32
    match try_emit_index_early(s, e)
        Some(v) => return v
        None => pass
    let base: IndexBase = index_base(s, e)
    match try_emit_index_named(s, e, base)
        Some(v) => return v
        None => pass
    match try_emit_index_member(s, e)
        Some(v) => return v
        None => pass
    match try_emit_index_call(s, e)
        Some(v) => return v
        None => pass
    emit_index_through_ptr(s, e, base)

# =============================================================================
# Enum variants
# =============================================================================

# AGAST #2422: 1 when `name` is an instance of a generic enum (`Slot$i32`),
# which monomorph recorded as an enum of that name.
pub fn is_enum_instance(ctx: *ParseCtx, name: StrView) -> i32
    if name.ptr == null or name.len <= 0
        return 0
    let ei: i32 = enum_find(ctx, name)
    (ei >= 0 and enum_is_generic(ctx, ei) == ENUM_INSTANCE) as i32

# AGAST #2422: a generic enum's variant has no enum of its own to build:
# `Full(5)` is a `Slot<i32>` only because its slot says so, as in ritz0.  The
# slot is the typed let's, the parameter's or field's (ctx_enum_name), else the
# enclosing fn's return type outside a call argument.  When that is an instance
# declaring variant `name`, its tracker index (*out_vi the tag); else -1.
pub fn slot_instance_variant(s: *EmitterState, name: StrView, out_vi: *i32) -> i32
    var en: StrView = StrView { ptr: s.ctx_enum_name, len: s.ctx_enum_name_len as i64 }
    if en.ptr == null and s.ctx_enum_arg == 0
        en = StrView { ptr: s.ret_type_name, len: s.ret_type_name_len as i64 }
    if is_enum_instance(s.mono.pctx, en) == 0
        return 0 - 1
    let vi: i32 = enum_variant_index(s.mono.pctx, en, name)
    if vi < 0
        return 0 - 1
    *out_vi = vi
    enum_find(s.mono.pctx, en)

# AGAST #3021: a generic enum's bare constructor (`Full(6)`, `Empty`) whose
# slot names no instance of it, refused at the constructor:
#   file:line:col: can't infer the `Slot` instance `Full` builds: give its
#   slot a `Slot<...>` type
# A call lowered to one to an undeclared `@Full`, so the link failed with no
# location; a unit variant was "unknown identifier".  Returns an i64 zero so
# the fn still emits (the error stops the output), 0 when `name` is no
# generic enum's variant.
pub fn emit_no_instance_error(s: *EmitterState, name: StrView, span: SrcSpan) -> i32
    var vi: i32 = 0
    let ei: i32 = generic_enum_of_variant(s.mono.pctx, name, @vi)
    if ei < 0
        return 0
    let en: StrView = enum_text(s, ei)
    format_into(s, "  ; ERROR: generic enum constructor with no instance\n")
    diag_error_at(emitter_source_file(), span)
    eprint("can't infer the `{en}` instance `{name}` builds: give its slot a `{en}<...>` type\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0  ; constructor with no instance (error)\n")
    z

# A `%Enum` value whose tag is variant `tag`'s, for a unit variant: the
# qualified `Shade.Light` (emit_expr_member) and, AGAST #1600, the bare
# `Light` (emit_expr_ident).  The result register is a struct-typed SSA value
# usable as a call arg or var-decl initializer.
fn emit_unit_variant_value(s: *EmitterState, en: StrView, tag: i32) -> i32
    let tag_ty: StrView = enum_tag_ty_named(s.mono.pctx, en)
    emit_tagged_unit(s, en, "enum variant ctor", tag_ty, enum_tag_value_named(s.mono.pctx, en, tag))

# =============================================================================
# Members
# =============================================================================

# AGAST #2451: `t.len` on a String local names no field: one located error, in
# ritz0's words (R17 rule 5(a) since #3015), where it fell to the unlocated
# "unhandled EXPR_MEMBER".  True after reporting `e`.
fn unknown_field_refused(s: *EmitterState, e: *Expr) -> bool
    if e.left == null or e.left.kind != ExprKind.Ident
        return false
    let loc: *LocalVar = find_local_struct_name(s, ident_text(e.left))
    if loc == null or lv_var_type(loc) != TypeKind.Struct or lv_type_name(loc) == null
        return false
    let st: *StructDef = find_struct(s, local_type_text(loc))
    if st == null
        return false
    let field: StrView = ident_text(e)
    var f: *StructField = st.fields
    while f != null
        let fname: StrView = StrView { ptr: f.name, len: f.name_len as i64 }
        if fname.eq(field)
            return false
        f = f.next
    # R17 rule 5(a)'s words, at the field name (AGAST #3015): "`S` has no field
    # `f`".  Sema (deref_field.ritz) has usually said it already; it says it once.
    let words: *u8 = df_no_field_once(s.mono.pctx, s.module, e, st)
    if words != null
        emit_nd_error_sv(s, df_line(e), df_col(e), strview_from_cstr(words))
    true

# AGAST #3362: `s.f` with `s` a local or param whose struct type is declared
# nowhere (`var s: Foo`, or `String` with no `import ritzlib.string`).  It fell
# to the unlocated "unhandled EXPR_MEMBER".  One located error at `s`, naming
# the type, once per name in a row: a second access, or a `String` that #3347
# already refused at its literal, is the same mistake and says nothing more.
# True when `e` is that case (reported now or before).
fn unknown_struct_member_refused(s: *EmitterState, e: *Expr) -> bool
    if e.left == null or e.left.kind != ExprKind.Ident
        return false
    let loc: *LocalVar = find_local_struct_name(s, ident_text(e.left))
    if loc == null or lv_var_type(loc) != TypeKind.Struct or lv_type_name(loc) == null or lv_type_name_len(loc) <= 0
        return false
    let tn: StrView = local_type_text(loc)
    if find_struct(s, tn) != null
        return false
    let reported: StrView = StrView { ptr: s.unknown_struct_name, len: s.unknown_struct_name_len as i64 }
    if s.error_count > 0 and reported.eq(tn)
        return true
    diag_error_at(emitter_source_file(), e.left.span)
    eprint("`{ident_text(e.left)}` is a `{tn}`, which names no declared struct: it has no field `{ident_text(e)}` (is an import missing?)\n")
    s.error_count = s.error_count + 1
    s.unknown_struct_name = lv_type_name(loc)
    s.unknown_struct_name_len = lv_type_name_len(loc)
    true

# AGAST #4263: `o.expect("x").v` / `o.frob().v`, a field of a method call the
# arm above couldn't type, because the method is none of the receiver's.  It
# fell to "unhandled EXPR_MEMBER" at the outer expression.  Emitting the call
# reports that method by itself, located at its name (refuse_no_method).
# True when the call reported an error.
pub fn method_base_refused(s: *EmitterState, e: *Expr) -> bool
    if e.left == null or e.left.kind != ExprKind.Method
        return false
    let before: i32 = s.error_count
    emit_expr(s, e.left)
    s.error_count > before

# AGAST #4155: `p.len` with `p` a `*i32` local or param, or `x.len` with `x` an
# `i64`: a scalar has no fields.  It fell to "unhandled EXPR_MEMBER" (and ritz0
# raised a ValueError traceback).  One located error at the base, naming it and
# its type, in ritz0's words (type_checker.py, _refuse_primitive_member).  A
# local whose type the emitter only guessed (bk_unsure) is left alone.
# True when `e` is that case.
pub fn primitive_member_refused(s: *EmitterState, e: *Expr) -> bool
    if e.left == null or e.left.kind != ExprKind.Ident
        return false
    let loc: *LocalVar = find_local_struct_name(s, ident_text(e.left))
    if loc == null or lv_bk_unsure(loc) == 1 or lv_type_name_len(loc) > 0
        return false
    var sigil: StrView = ""
    var scalar: TypeKind = lv_var_type(loc)
    if scalar == TypeKind.Ptr
        sigil = "*"
        scalar = lv_pointee_type(loc)
    else if scalar == TypeKind.I64 and loc.is_bool == 1
        scalar = TypeKind.Bool
    let name: StrView = primitive_spelling(scalar)
    if unnamed(name)
        return false
    format_into(s, "  ; ERROR\n")
    diag_error_at(emitter_source_file(), e.left.span)   # located at the base
    eprint("`{ident_text(e.left)}` has type `{sigil}{name}`, which is not a struct: it has no field `{ident_text(e)}`\n")
    s.error_count = s.error_count + 1
    true

# `"lit".ptr` / `"lit".len` (AGAST #4301).  A bare literal is a StrView (#98):
# `.ptr` is its NUL-terminated @.str global, as a `c"lit"` is (a *u8, carried
# as i64), and `.len` its byte count, known here.  ritz0 types `.len` as an
# i64 like any StrView's, so a narrowing `let n: i32 = "lit".len` is refused
# by both (narrowing.ritz does not exempt it as a constant).  No other field.
fn emit_strlit_field(s: *EmitterState, e: *Expr) -> i32
    let lit: *Expr = e.left
    let field: StrView = ident_text(e)
    if field.eq("len")
        let r: i32 = next_reg(s)
        format_into(s, "  %.{r} = add i64 0, {lit.string_val.len as i64}  ; string-literal .len\n")
        return r
    if field.eq("ptr")
        let str_idx: i32 = add_string(s, lit.string_val)
        let bytes: i64 = ((lit.string_val.len as i32) + 1) as i64   # the literal and its NUL
        let gep: i32 = next_reg(s)
        format_into(s, "  %.{gep} = getelementptr [{bytes} x i8], ptr @.str.{str_idx as i64}, i64 0, i64 0\n")
        let r: i32 = next_reg(s)
        format_into(s, "  %.{r} = ptrtoint ptr %.{gep} to i64  ; string-literal .ptr\n")
        return r
    # deref_field.ritz refuses any other field first, in these words; this
    # is the backstop, so a miss there is an error and never bad IR.
    format_into(s, "  ; ERROR\n")
    diag_error_at(emitter_source_file(), e.span)
    eprint("`StrView` has no field `{field}`\n")
    s.error_count = s.error_count + 1
    0

# Qualified enum variant: `Shade.Light` / `Result.Ok`.  When the LHS ident is a
# known enum type and the RHS one of its variants, a %Shade-typed value
# (emit_unit_variant_value); downstream var-decl narrowing handles the
# alloca-width / store-type so `let a = Shade.Light` packs correctly.  None
# when `e` is no such variant.
fn try_emit_qualified_variant(s: *EmitterState, e: *Expr) -> Option<i32>
    let en: StrView = ident_text(e.left)
    if is_enum_type(s.mono.pctx, en) == 0
        return None
    let variant_idx: i32 = enum_variant_index(s.mono.pctx, en, ident_text(e))
    if variant_idx < 0
        return None
    # AGAST #1466: `Option.None` built `alloca %Option`, which clang rejects
    # (ritz1 has no generic-enum specialisation; ritz0 rejects the form).
    if enum_is_generic(s.mono.pctx, enum_find(s.mono.pctx, en)) == 1
        return Some(emit_qualified_variant_error_sv(s, e, "is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. None"))
    Some(emit_unit_variant_value(s, en, variant_idx))

# `expr.field`: member access on a struct, a qualified enum variant, or a
# string literal's `.ptr` / `.len`.
pub fn emit_expr_member(s: *EmitterState, e: *Expr) -> i32
    match e.left.kind
        ExprKind.Ident =>
            match try_emit_qualified_variant(s, e)
                Some(v) => return v
                None => pass
            # `m.K` / `m.f`: no `module.item` access (§15.3, AGAST #2215).  Was a
            # flat lookup of K (ritz0's too), so it compiled while `m.f()` did not.
            if is_module_item(s, e.left.ident.ptr, (e.left.ident.len as i32), e.ident.ptr, (e.ident.len as i32)) == 1
                return emit_module_item_error(s, e.left.ident.ptr, (e.left.ident.len as i32), e.ident.ptr, (e.ident.len as i32), e.span.line, e.span.col)
        ExprKind.StringLit =>
            return emit_strlit_field(s, e)
        _ => pass

    # emit_member_ptr: the field's address, for direct and nested access.
    var member_result: MemberPtrResult
    emit_member_ptr(s, e, @member_result)
    if member_result.success == 1
        let field: *StructField = member_result.field
        let field_ptr: i32 = member_result.reg
        if field.field_type == TypeKind.Struct
            # AGAST #4461: a whole-struct field value is a copy candidate.
            return emit_struct_load(s, field_type_text(field), field_ptr)
        let val_reg: i32 = next_reg(s)
        format_into(s, "  %.{val_reg} = load ")
        emit_field_llvm_type(s, field)
        format_into(s, ", ptr %.{field_ptr}\n")
        # AGAST #1646: a bool field is stored as i1 but, like every other
        # scalar, read into an i64 register; the raw i1 was invalid IR in
        # `not`, `and`, `==`, a `-> bool` return and a bool call arg.
        return widen_loaded(s, field.field_type, val_reg)
    if method_base_refused(s, e)   # AGAST #4263
        return 0
    if unknown_field_refused(s, e)
        return 0
    if unknown_struct_member_refused(s, e)   # AGAST #3362
        return 0
    if primitive_member_refused(s, e)   # AGAST #4155
        return 0
    emit_ir_error_sv(s, e.span, "unhandled EXPR_MEMBER")
    0

var g_base_spills: i32 = 0

# "#" + up to 20 digits of an i64 + NUL (AGAST #1820: no magic alloc sizes).
const BASE_SPILL_NAME_BUF: i64 = 24

# =============================================================================
# Spills and through-index places that emit their operand (AGAST #1818: moved
# up from emitter_types / index_through, which no longer reach emit_expr).
# =============================================================================
# AGAST #2329: `view`, bound, at an emitting site.  A base_array_view's base is
# evaluated once, into a `*T` local named `#k`, so `x[i]` is `*(#k + i)` the way a
# local's is `*(p# + i)`; anything else is `view` itself.
pub fn through_spill(s: *EmitterState, view: *LocalVar) -> *LocalVar
    if view == null or lv_array_base(view) == null
        return view
    let val: i32 = emit_expr(s, lv_array_base(view))
    let slot: i32 = entry_alloca(s, "i64")
    format_into(s, "  store i64 %.{val}, ptr %.{slot}\n")
    g_base_spills = g_base_spills + 1
    # The local's name outlives this fn (the scope keeps the pointer), so it
    # is its own allocation, not a String dropped at the end of the fn.
    let name: *u8 = malloc(BASE_SPILL_NAME_BUF)
    *name = '#'   # no identifier has one
    let len: i32 = 1 + fmt_i64_into(Span<u8> { ptr: name + 1, len: BASE_SPILL_NAME_BUF - 1 }, g_base_spills as i64).len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, slot, TypeKind.Ptr, StrView { ptr: (lv_type_name(view)), len: (lv_type_name_len(view)) as i64 }, lv_pointee_type(view), 0, TypeKind.Void)
    let bound: *LocalVar = local_at(s, s.local_count - 1)
    lv_mark_array_view(bound)
    bound

# AGAST #2098 / #3635: the `ptr` a plane_ptr_shape base `e` is, in a register:
# a local's slot loaded (twice for `*r`, r a `**`), else `e` (or the X of a
# `*X`) evaluated.
pub fn emit_plane_ptr(s: *EmitterState, e: *Expr) -> i32
    var x: *Expr = e
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        x = e.operand
    if x.kind == ExprKind.Ident
        let lv: *LocalVar = find_local_struct_name(s, x.ident)
        if lv != null
            var r: i32 = next_reg(s)
            format_into(s, "  %.{r} = load ptr, ptr %.{lv.reg}\n")
            if local_holds_plane_ptr(lv) == 1   # AGAST #4122: a ref too
                let r2: i32 = next_reg(s)
                format_into(s, "  %.{r2} = load ptr, ptr %.{r}\n")
                r = r2
            return r
    let v: i32 = emit_expr(s, x)
    let ptr: i32 = next_reg(s)
    format_into(s, "  %.{ptr} = inttoptr i64 %.{v} to ptr\n")
    # AGAST #4122: `*s.q` / `*gq` / `*f()` loads the `*[N][M]T` the `**` holds.
    if x != e and base_plane_ptr_ptr(s, x) != null
        let held: i32 = next_reg(s)
        format_into(s, "  %.{held} = load ptr, ptr %.{ptr}\n")
        return held
    ptr

# AGAST #2250: `e` read into a by-value slot of struct `name`.  `c:& C` reads
# as the pointer, but the slot holds a `C`, so a `c:& C` param of that type
# copies its referent here: the aggregate register, as emit_expr gives for any
# other struct value.  0 when `e` is anything else.  `c:& [2]C` names `C` as
# well: an array is no `C`, so it stays the pointer, which clang refuses.  A
# move-only C was refused on Sema (own_check.ritz's oc_lent_read, AGAST #3507).
pub fn emit_lent_referent(s: *EmitterState, e: *Expr, name: StrView) -> i32
    var loc: *LocalVar = lent_local(s, e)
    if loc == null
        loc = lent_self_local(s, e)
    if loc == null or lv_var_type(loc) == TypeKind.Array
        return 0
    if name_eq(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, name) == 0
        return 0
    var src: i32 = emit_expr(s, e)
    if lv_var_type(loc) == TypeKind.Ptr
        # An impl's `self:& T` is a `*T` local, so its value is an i64.
        let addr: i32 = next_reg(s)
        format_into(s, "  %.{addr} = inttoptr i64 %.{src} to ptr  ; #2278 lent self\n")
        src = addr
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TypeKind.Struct, val, name, src, no_name())
    return val

# emit_expr, with `e` marked as a copy into a struct slot when `ty` is one (#2330).
pub fn emit_struct_copy(s: *EmitterState, e: *Expr, ty: TypeKind) -> i32
    let saved: *Expr = s.struct_copy_expr
    if ty == TypeKind.Struct
        s.struct_copy_expr = e
    let reg: i32 = emit_expr(s, e)
    s.struct_copy_expr = saved
    return reg

struct NdIndexPtr
    reg: i32              # ptr register of the element / sub-array
    depth: i32            # indices applied, 1..shape.rank
    shape: *ArrayShape

# AGAST #2570: `q[i][j][k]` with more indices than q's plane has dimensions.
# index_through leaves a plane pointer to the N-D path, which can't take it,
# and the rest read past q (it crashed): refused, located, as ritz0 refuses it.
# Returns 1 with a full-depth *out over %0 when it refused (the error fails the
# build; callers then don't report again), 0 when `e` isn't such a chain.
fn nd_plane_overindex(s: *EmitterState, e: *Expr, out: *NdIndexPtr) -> i32
    if e == null or e.kind != ExprKind.Index
        return 0
    var chain: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @chain)   # AGAST #4122: `a[k]` a base
    if chain == 0   # `a[k]` itself: the plane pointer, not an index into it
        return 0
    let sh: *ArrayShape = plane_ptr_shape(s, base)
    if sh == null
        return 0
    emit_nd_error_sv(s, e.span.line, e.span.col, "this indexes more dimensions than the plane of the multi-dimensional array it points at has")
    out.reg = 0
    out.depth = sh.rank
    out.shape = sh
    return 1

# Emit the GEP for an N-D index chain `e` into *out.  Returns 0 (emitting
# nothing) when nd_index_shape does not recognise `e`.  The indices are
# evaluated in source order, outermost dimension first.
pub fn emit_nd_index_ptr(s: *EmitterState, e: *Expr, out: *NdIndexPtr) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null
        return nd_plane_overindex(s, e, out)
    var chain: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @chain)   # AGAST #4122: `a[k]` a base
    # AGAST #2097: a field base `s.m` / `p.m` / `a.b.m` is addressed before
    # the indices are evaluated, as ritz0 does.
    var base_reg: i32 = 0
    let plane_sh: *ArrayShape = plane_ptr_shape(s, base)   # #3635: `s.p[i][j]` is one
    if base.kind == ExprKind.Member and plane_sh == null
        var mp: MemberPtrResult
        emit_member_ptr(s, base, @mp)
        # Reported, then emitted anyway (over %.0) so callers do not fall
        # through to a 1-D path and report again; the error fails the build.
        if mp.success != 1
            emit_nd_error_sv(s, e.span.line, e.span.col, "cannot address the multi-dimensional array field this index chain starts from in ritz1")
        base_reg = mp.reg
    # AGAST #2570: a plane pointer `q` is GEP'd from its value, not its slot.
    # Loaded before the indices, as a field base is addressed before them.
    var plane: i32 = 0
    # AGAST #2098: `(*q)[i][j]` is `q[i][j]`; #3635: a field, global or call
    # base too, and `(*r)[i][j]` through a `**`.
    if plane_sh != null
        plane = 1
        base_reg = emit_plane_ptr(s, base)
    var regs: [8]i32
    var j: i32 = 0
    while j < depth
        # The j-th index (source order) sits depth-1-j levels below `e`.
        var node: *Expr = e
        var k: i32 = 0
        while k < depth - 1 - j
            node = node.left
            k = k + 1
        regs[j] = emit_expr(s, node.right)
        j = j + 1
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = getelementptr ")
    emit_array_shape_llvm(s, sh, 0)
    format_into(s, ", ptr ")
    if plane == 1 or base.kind == ExprKind.Member
        format_into(s, "%.{base_reg}")
    else
        let lv: *LocalVar = find_local_struct_name(s, base.ident)
        if lv != null
            format_into(s, "%.{lv.reg}")
        else
            let name_ir1: String = ir_name(base.ident)
            format_into(s, "@{name_ir1.as_view()}")
    format_into(s, ", i64 0")
    j = 0
    while j < depth
        format_into(s, ", i64 %.{regs[j]}")
        j = j + 1
    format_into(s, "\n")
    out.reg = r
    out.depth = depth
    out.shape = sh
    return 1

# The value of `e` = `g[i]..[k]` over an N-D array, in *out_reg.  Returns 0
# when `e` is not an N-D index chain.  Only a full-depth chain to a leaf is a
# value; a row (`g[i]` of `[N][M]T`) is a located error rather than a guess
# at an aggregate load.  AGAST #3322: a row bound to an `[M]T` local
# (`let r = g[i]`, annotated or not) or passed to an `[M]T` parameter is
# copied by the whole-array paths and never reaches here.
#
# AGAST #3306: a full-depth chain to a struct leaf loads the `%P` at the
# element's address, as #2099 stores one: a copy only (`let p: P = g[i][j]`,
# `g[0][0] = g[2][1]`, `f(g[i][j])`), as a 1-D `[N]S` element is (#2330).
# A leaf naming no struct (a generic clone that kept `T`, #3141) stays the
# located error: `load %T` would be invalid IR.
fn emit_nd_index_value(s: *EmitterState, e: *Expr, out_reg: *i32) -> i32
    var ndp: NdIndexPtr
    if emit_nd_index_ptr(s, e, @ndp) == 0
        return 0
    let sh: *ArrayShape = ndp.shape
    var leaf_st: *StructDef = null
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0
        leaf_st = find_struct(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    if ndp.depth < sh.rank or (sh.leaf_type == TypeKind.Struct and leaf_st == null)
        emit_nd_error_sv(s, e.span.line, e.span.col, "a row or a struct element of a multi-dimensional array is not a value in ritz1 (index every dimension, use .field, or take its address with @)")
        *out_reg = 0
        return 1
    if sh.leaf_type == TypeKind.Struct
        *out_reg = 0
        if whole_struct_elem_refused(s, e)
            return 1
        let sv: i32 = next_reg(s)
        emit_struct_load_or_defer(s, TypeKind.Struct, sv, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, ndp.reg, no_name())
        *out_reg = sv
        return 1
    let ty: StrView = elem_mem_llvm(sh.leaf_type)
    let v: i32 = next_reg(s)
    format_into(s, "  %.{v} = load {ty}, ptr %.{ndp.reg}\n")
    *out_reg = emit_array_elem_widen(s, v, sh.leaf_type, elem_mem_llvm(sh.leaf_type))
    return 1
