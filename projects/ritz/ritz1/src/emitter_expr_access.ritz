# Auto-extracted from emitter_expr.ritz — IDENT + INDEX + MEMBER codegen.

import ast
import types           # the one primitive type table (AGAST #1889)
import index_through
import ast_helpers
import emitter_core
import emitter_ir
import diag                 # diag_error_at (AGAST #3445)
import emitter_expr
import emitter_expr_arith   # emit_nd_index_value (AGAST #1509)
import deref_field          # df_no_field_once (AGAST #3015)
import emitter_expr_call
import emitter_match
import ritzlib.io
import ritzlib.str


# Check if ident name is "None" (4 chars: N o n e).
pub fn is_ident_none(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4
        if *name == 78 and *(name + 1) == 111 and *(name + 2) == 110 and *(name + 3) == 101
            return 1
    return 0

# AGAST #2434: 1 when a bare `None` is a user enum's unit variant here, as
# users_variant_wins decides for a call `Some(5)`: a user enum declares the
# unit `None` (or two do: bare_unit_variant_enum's -2, reported by the bare
# unit-variant path) and no Option slot gives the builtin an enum.  A slot
# that is the user's enum (`let x: E = None`, a param of E) is the user's
# whatever the fn returns.
pub fn users_none_wins(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_IDENT or is_ident_none(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0
        return 0
    var vi: i32 = 0
    var other: i32 = 0
    let ei: i32 = bare_unit_variant_enum(s, e, @vi, @other)
    if ei == 0 - 1
        return 0
    if ei >= 0 and s.ctx_enum_name != null
        var en_len: i32 = 0
        let en: *u8 = enum_name_at(ei, @en_len)
        if name_eq(StrView { ptr: (s.ctx_enum_name), len: (s.ctx_enum_name_len) as i64 }, StrView { ptr: (en), len: (en_len) as i64 }) == 1
            return 1
    var bn: *u8 = null
    var bn_len: i32 = 0
    if resolve_enum_ctx(s, @bn, @bn_len) == 1
        return 0
    1

# AGAST #3054: an array Sema refused in a pointer slot's own words never gets
# here (ref_value.ritz): any Sema error stops the compile before emission.
pub fn emit_whole_array_error(s: *EmitterState, e: *Expr)
    emit_nd_error(s, e.span.line, e.span.col, c"a whole array is not a value here (index it, copy it into an array of the same type, or take its address with @)")

pub fn emit_expr_ident(s: *EmitterState, e: *Expr) -> i32
    # AGAST #1509: a multi-dimensional array as a whole value (`h = g`,
    # `f(g)`, ...) is not lowered: the paths below load one i64 out of it.
    # `a:& [N][M]T` has none either (AGAST #2322).
    if nd_array_ident_shape(s, e) != null
        emit_nd_error(s, e.span.line, e.span.col, c"a multi-dimensional array is not a value in ritz1 (index it, or take an element's address with @)")
        return 0
    # Unit-variant None → `%Option$... = { i8 1, [N x i8] zero }` aggregate
    # (ritz-task-133: matches ritz0 tag convention Some=0, None=1).
    # AGAST #2434: a user's unit `None` is built below, as any bare unit variant.
    if is_ident_none(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1 and users_none_wins(s, e) == 0
        # Only treat as None if not shadowed by local/global/const.
        if is_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0
            if find_local(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0
                if find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == null
                    # Resolve enum context (var decl / call param, else the
                    # fn return type outside call args) — shared with
                    # Some/Ok/Err ctors (AGAST #1498).
                    var enum_name: *u8 = null
                    var enum_name_len: i32 = 0
                    resolve_enum_ctx(s, @enum_name, @enum_name_len)
                    if enum_name == null
                        return emit_no_enum_ctx_error(s, e)   # AGAST #2454
                    # alloca + zero-init + store tag=1 + load.
                    let slot: i32 = next_reg(s)
                    entry_alloca_reg_begin_named(s, slot)
                    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
                    emit_str(s, c"  ; None\n")
                    entry_alloca_reg_end(s)
                    emit_str(s, IR_STORE_STRUCT)
                    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
                    emit_str(s, c" zeroinitializer, ptr ")
                    emit_reg(s, slot)
                    emit_str(s, IR_NL)
                    let tptr: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, tptr)
                    emit_str(s, IR_GEP_NAMED)
                    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, slot)
                    emit_str(s, c", i32 0, i32 0\n")
                    emit_store_imm(s, IR_TY_I8, 1, tptr)
                    let result: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, result)
                    emit_str(s, IR_LOAD_NAMED)
                    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, slot)
                    emit_str(s, IR_NL)
                    return result

    if is_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
        # AGAST #189 — scalar struct consts (`const FOO: StrView = "..."`)
        # are emitted by emit_const_struct_entry as a real `%StructTy`
        # global; load the aggregate so call sites that expect a struct
        # type (e.g. mausoleum's `build_path(suffix: StrView, ...)`) are
        # fed a properly-typed value instead of the legacy `add i64 0, 0`
        # which produced the i64-vs-%StrView verifier error.
        let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if ce != null and ce.const_type == TYPE_ARRAY
            emit_whole_array_error(s, e)   # AGAST #2287, as for a local
            return 0
        if ce != null and ce.const_type == TYPE_STRUCT and ce.type_name_len > 0 and ce.value_expr != null
            let result: i32 = next_reg(s)
            emit_struct_load_or_defer(s, TYPE_STRUCT, result, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 }, 0 - 1, ce.name, ce.name_len)
            return result
        # AGAST #2341: a string `*u8` const is its literal.  Its folded value is
        # 0, which is what `*P` used to read.
        if ce != null and ce.const_type == TYPE_PTR and ce.value_expr != null and ce.value_expr.kind == EXPR_CSTRING_LIT
            return emit_expr(s, ce.value_expr)
        # AGAST #2155: an integer-initialised float const is its float value.
        var folded: i64 = 0
        let cft: i32 = const_int_init_float_ty(s, ce, @folded)
        if cft != 0
            let fres: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, fres)
            emit_str(s, c" = sitofp i64 ")
            emit_int(s, folded)
            if cft == TYPE_F32
                emit_str(s, c" to float\n")
            else
                emit_str(s, c" to double\n")
            return fres
        # AGAST #2176: a float-literal const is its literal, a `double`.
        let lft: i32 = const_float_lit_init_ty(ce)
        if lft != 0
            let dv: i32 = emit_expr(s, ce.value_expr)
            if lft == TYPE_F64
                return dv
            let nres: i32 = ir_fptrunc_f64_f32(s.out, @s.reg_counter, dv)
            return nres
        let val: i64 = find_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, val)
        emit_str(s, IR_NL)
        return result

    let loc: i32 = find_local(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc >= 0
        let local_var: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        let var_type: i32 = local_var.var_type
        # AGAST #2287: this path has no array value to give; loading the slot
        # read the first 8 bytes as an i64.  Whatever takes a whole array has
        # its own path (emit_array_local_whole_assign, emit_call_arg).
        # AGAST #2322: nor does `a:& [N]T`.  It read as its pointer here (#2290),
        # which leaked the address into `var x: i64 = a`, `a as i64` and
        # `a == null`, all of which ritz0 refuses.  The slots that take its
        # pointer get it from emit_array_arg_addr; the by-value and copy slots
        # read the array behind it on their own paths.
        if var_type == TYPE_ARRAY
            emit_whole_array_error(s, e)
            return 0
        let result: i32 = next_reg(s)
        emit_struct_load_or_defer(s, var_type, result, StrView { ptr: (local_var.type_name), len: (local_var.type_name_len) as i64 }, loc, null, 0)

        if var_type == TYPE_I32
            let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, result)
            return ext
        else if var_type == TYPE_U32
            let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, result)
            return ext
        else if ty_int_bits(var_type) == 8
            # AGAST #2021: i8 sign-extends, matching the i8 global reload and
            # every *i8 / [N]i8 element load; zext made `let x: i8 = -3`
            # compare as 0xFD against a sext'd p[i] of 0xFF..FD.
            let ext: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ext)
            if var_type == TYPE_I8
                emit_str(s, c" = sext i8 ")
            else
                emit_str(s, c" = zext i8 ")
            emit_reg(s, result)
            emit_str(s, IR_TO_I64)
            return ext
        else if ty_int_bits(var_type) == 16
            # Was missing: u16/i16 idents left their value at i16 width,
            # so any subsequent `store i64 %val` (the unified-i64 path)
            # produced an LLVM type-mismatch error.  Extend like u8/i8.
            let ext: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ext)
            if var_type == TYPE_I16
                emit_str(s, c" = sext i16 ")
            else
                emit_str(s, c" = zext i16 ")
            emit_reg(s, result)
            emit_str(s, IR_TO_I64)
            return ext
        else if var_type == TYPE_BOOL
            # AGAST #2994: a `b:& bool` param's one byte, as the i64 a bool
            # value lives in (#1646).
            let bext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, result)
            return bext
        else if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
            # Pointers are already stored/loaded as i64, no conversion needed
            return result
        return result

    # Check for global variable
    let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if glob != null
        if glob.var_type == TYPE_ARRAY
            emit_whole_array_error(s, e)   # AGAST #2287, as for a local
            return 0
        # Load from global variable.  AGAST #2427: a struct is loaded whole at
        # its own type, as a local is; `emit_llvm_type` gave it i64, so every
        # site taking the value (`return gh`, `var v: Vec<i32> = g`, an
        # argument, a field init, an assignment) was invalid IR.
        let result: i32 = next_reg(s)
        if glob.var_type == TYPE_STRUCT and glob.type_name_len > 0
            emit_struct_load_or_defer(s, TYPE_STRUCT, result, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 }, 0 - 1, glob.name, glob.name_len)
        else
            emit_str(s, IR_INDENT)
            emit_reg(s, result)
            emit_str(s, IR_LOAD)
            emit_str(s, ty_value_llvm(glob.var_type))
            emit_str(s, c", ptr @")
            emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            emit_str(s, IR_NL)
        # Extend to i64 if needed
        if glob.var_type == TYPE_I32
            let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, result)
            return ext
        else if glob.var_type == TYPE_U32
            let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, result)
            return ext
        else if ty_int_bits(glob.var_type) == 16
            let ext: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ext)
            if glob.var_type == TYPE_I16
                emit_str(s, c" = sext i16 ")
            else
                emit_str(s, c" = zext i16 ")
            emit_reg(s, result)
            emit_str(s, IR_TO_I64)
            return ext
        else if ty_int_bits(glob.var_type) == 8
            let ext: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ext)
            if glob.var_type == TYPE_I8
                emit_str(s, c" = sext i8 ")
            else
                emit_str(s, c" = zext i8 ")
            emit_reg(s, result)
            emit_str(s, IR_TO_I64)
            return ext
        else if glob.var_type == TYPE_BOOL
            # AGAST #3001: the i1 byte, as the i64 a bool value lives in
            # (#1646), as for a `b:& bool` param above.  The raw i1 was invalid
            # IR in `not g`, `g and h`, `g as i32` and `f(g)`.
            let bext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, result)
            return bext
        return result

    # AGAST #1503: a function name used as a value (`apply(double, 5)`,
    # `let f: fn(i32) -> i32 = double`, `cb as *u8`) yields the function's
    # address.  Checked after locals/globals so those still shadow a fn of
    # the same name.  fn_map holds both this module's fns and the ones merged
    # in from imports; the extern is registered unconditionally because
    # emit_extern_declarations skips any fn this .ll defines itself, so an
    # imported fn (defined in another .ll) gets its `declare` and a local one
    # doesn't.  Pointers are i64 in ritz1's unified value model.
    let fn_def: *FnDef = find_fn(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if fn_def != null
        add_extern(s, StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 })
        let fn_addr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, fn_addr)
        emit_str(s, c" = ptrtoint ptr @")
        # AGAST #4356: a private free fn's symbol carries its file (fn_symbol).
        var fn_sym_len: i32 = 0
        let fn_sym: *u8 = fn_symbol(fn_def, @fn_sym_len)
        emit_name(s, StrView { ptr: (fn_sym), len: (fn_sym_len) as i64 })
        emit_str(s, IR_TO_I64)
        return fn_addr

    # AGAST #2422: `Empty` where the slot is a `Slot<i32>`.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, @ivi)
    if iei >= 0 and enum_variant_kind(iei, ivi) == ENUM_VARIANT_UNIT
        var in_len: i32 = 0
        let in_name: *u8 = enum_name_at(iei, @in_len)
        return emit_unit_variant_value(s, StrView { ptr: (in_name), len: (in_len) as i64 }, ivi)

    # AGAST #1600 / #1610: a bare unit variant `B` of a user enum, as the
    # qualified `S.B` builds it.  Checked last, so a const / local / global /
    # fn of the same name still wins (bare_unit_variant_enum also checks).
    var vi: i32 = 0
    var other_ei: i32 = 0
    let var_ei: i32 = bare_unit_variant_enum(s, e, @vi, @other_ei)
    if var_ei >= 0
        var en_len: i32 = 0
        let en: *u8 = enum_name_at(var_ei, @en_len)
        return emit_unit_variant_value(s, StrView { ptr: (en), len: (en_len) as i64 }, vi)
    if var_ei == 0 - 2
        return emit_ambiguous_variant_error(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, e.span, vi, other_ei)
    # AGAST #3021: `Empty` where the slot names no `Slot` instance.
    let no_inst: i32 = emit_no_instance_error(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, e.span)
    if no_inst != 0
        return no_inst

    emit_ir_error_begin(s, e.span, c"unknown identifier '")
    emit_ir_error_end(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    let zero: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, zero)
    emit_str(s, IR_ADD_ZERO)
    return zero

# LLVM element type of a primitive const array (the spelling
# emit_const_array_entry gave the `@NAME = internal constant [N x T]`
# global, so the GEP stride equals the stored stride), or null for element
# kinds emit_global_array_index cannot load and widen to i64 -- struct and
# float -- which keep their previous lowering.  Integers, `*T` (#2357:
# `const A: [N]*u8 = ["A", "B"]`) and bool (#3949: `[N x i1]`, without which
# `KS[i]` loaded KS whole) are types.ritz's memory spelling.
pub fn const_elem_llvm(t: i32) -> *u8
    # LARB R60: a float const table is declared `[N x double]` / `[N x float]`
    # by emit_const_array_shared_entry, so its elements are indexed at that
    # width like any other.
    if t == TYPE_PTR_PTR
        return null
    ty_mem_llvm(t)

# AGAST #1553 / #3325: `name[idx]` on a module-level `[size x %P]` global (a
# `var` global or a const struct array) as a struct value: `load %P` from the
# element's GEP, the form a struct-valued deref or call yields.
fn emit_struct_array_elem_load(s: *EmitterState, name_sv: StrView, size: i32, tn: *u8, tl: i32, idx_expr: *Expr) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let sptr: i32 = emit_struct_array_elem_ptr(s, StrView { ptr: (name), len: (name_len) as i64 }, size, tn, tl, idx_expr)
    let sval: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TYPE_STRUCT, sval, StrView { ptr: (tn), len: (tl) as i64 }, sptr, null, 0)
    sval

# The address of `name[idx]` in a module `[size x %tn]` global or const.
pub fn emit_struct_array_elem_ptr(s: *EmitterState, name_sv: StrView, size: i32, tn: *u8, tl: i32, idx_expr: *Expr) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let sidx: i32 = emit_expr(s, idx_expr)
    let sptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, size as i64)
    emit_str(s, IR_X)
    emit_llvm_type_struct(s, TYPE_STRUCT, StrView { ptr: (tn), len: (tl) as i64 })
    emit_str(s, c"], ptr @")
    emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_I64_ZERO)
    emit_reg(s, sidx)
    emit_str(s, IR_NL)
    sptr

# `name[idx]` on a module-level `[size x elem_ty]` global (a `var` global or a
# primitive const array): GEP the global directly, load the element at its
# width, and widen it to the i64 every expression value is carried in.
fn emit_global_array_index(s: *EmitterState, name_sv: StrView, size: i32, elem_t: i32, elem_ty: *u8, idx_expr: *Expr) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let gidx: i32 = emit_expr(s, idx_expr)
    let gptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, gptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, size as i64)
    emit_str(s, IR_X)
    emit_str(s, elem_ty)
    emit_str(s, c"], ptr @")
    emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_I64_ZERO)
    emit_reg(s, gidx)
    emit_str(s, IR_NL)
    let gval: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, gval)
    emit_str(s, IR_LOAD)
    emit_str(s, elem_ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, gptr)
    emit_str(s, IR_NL)
    return emit_array_elem_widen(s, gval, elem_t, elem_ty)

# `v[i]` element read through a pointer to a Vec$T struct: load the data
# pointer (field 0), GEP by the element stride decoded from the `Vec$<T>`
# suffix, load and widen to i64.  `vec_ptr` is a `ptr` register: a Vec
# local's alloca, or the value of a `@Vec<T>` / `@&Vec<T>` reference.
fn emit_vec_ptr_index(s: *EmitterState, vec_ptr: i32, type_name_sv: StrView, idx_expr: *Expr) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    let idx_v: i32 = emit_expr(s, idx_expr)
    # GEP to data ptr field (index 0 of Vec struct)
    let v_data_ptr_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, v_data_ptr_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, vec_ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let v_data_ptr: i32 = next_reg(s)
    emit_load_into(s, IR_TY_PTR, v_data_ptr, v_data_ptr_ptr)
    # Decode element type from suffix after "Vec$".
    let v_en: *u8 = type_name + 4
    let v_el: i32 = type_name_len - 4
    var v_ty: *u8 = c"i64"
    var v_kind: i32 = TYPE_I64
    if v_el == 2 and *(v_en + 0) == 'u' and *(v_en + 1) == '8'
        v_ty = c"i8"
        v_kind = TYPE_U8
    else if v_el == 2 and *(v_en + 0) == 'i' and *(v_en + 1) == '8'
        v_ty = c"i8"
        v_kind = TYPE_I8
    else if v_el == 3 and *(v_en + 0) == 'u' and *(v_en + 1) == '1' and *(v_en + 2) == '6'
        v_ty = c"i16"
        v_kind = TYPE_U16
    else if v_el == 3 and *(v_en + 0) == 'i' and *(v_en + 1) == '1' and *(v_en + 2) == '6'
        v_ty = c"i16"
        v_kind = TYPE_I16
    else if v_el == 3 and *(v_en + 0) == 'u' and *(v_en + 1) == '3' and *(v_en + 2) == '2'
        v_ty = c"i32"
        v_kind = TYPE_U32
    else if v_el == 3 and *(v_en + 0) == 'i' and *(v_en + 1) == '3' and *(v_en + 2) == '2'
        v_ty = c"i32"
        v_kind = TYPE_I32
    let v_ep: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, v_ep)
    emit_str(s, c" = getelementptr ")
    emit_str(s, v_ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, v_data_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_v)
    emit_str(s, IR_NL)
    let v_val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, v_val)
    emit_str(s, IR_LOAD)
    emit_str(s, v_ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, v_ep)
    emit_str(s, IR_NL)
    # Extend to i64 for uniform value representation.
    if v_kind == TYPE_U8
        let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, v_val)
        return ext
    else if v_kind == TYPE_I8
        let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, v_val)
        return ext
    else if v_kind == TYPE_U16
        let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, v_val)
        return ext
    else if v_kind == TYPE_I16
        let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, v_val)
        return ext
    else if v_kind == TYPE_U32
        let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, v_val)
        return ext
    else if v_kind == TYPE_I32
        let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, v_val)
        return ext
    return v_val

# AGAST #2321: `p[i]` on `p: *[N]T` / `@[N]T` / `@&[N]T` is element i of the array
# behind it, stride T, as ritz0 reads it.  The pointee named no element, so this
# took the byte path: one byte at offset i, and a clang error for `@&`.  A struct
# element has no by-value read (#1562), so it's refused: the byte path gives an
# integer, which `p[1] + 1` and `p[1] as i64` took without a word.  `p[1].x` never
# gets here.  Returns 1 and sets `out` when it took `e`.
fn emit_array_ptr_index(s: *EmitterState, e: *Expr, out: *i32) -> i32
    let loc: *LocalVar = array_ptr_index_base(s, e.left)
    if loc == null
        return 0
    let elem: i32 = loc.pointee_array_elem_type
    if e.right != null and e.right.kind == EXPR_RANGE
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to an array can't be sliced (only String, Vec and Span can)")
        return 1
    if elem == TYPE_ARRAY
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to a multi-dimensional array can't be indexed in ritz1")
        return 1
    # A `*[N]*U` has a `**U` view and never gets here (#2522); a `*[N]**U` has none.
    if elem == TYPE_PTR or elem == TYPE_PTR_PTR
        emit_nd_error(s, e.span.line, e.span.col, c"a pointer to an array of pointers can't be indexed in ritz1")
        return 1
    if elem == TYPE_STRUCT
        emit_nd_error(s, e.span.line, e.span.col, c"a whole struct element can't be read through a pointer to an array in ritz1 (read its fields)")
        return 1
    let elem_ty: *u8 = elem_mem_llvm(elem)
    let idx: i32 = emit_expr(s, e.right)
    let base: i32 = emit_load_ptr(s, loc.reg)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, loc.pointee_array_size as i64)
    emit_str(s, IR_X)
    emit_str(s, elem_ty)
    emit_str(s, IR_RBRACK_PTR)
    emit_reg(s, base)
    emit_str(s, IR_I64_ZERO)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    let loaded: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, loaded)
    emit_str(s, IR_LOAD)
    emit_str(s, elem_ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_NL)
    *out = emit_array_elem_widen(s, loaded, elem, elem_ty)
    return 1

# "Vec$..", "Span$.." or "String": what `[lo..hi]` slices (AGAST #2451).
pub fn is_sliceable_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return 0
    if len > 4 and memcmp(name, c"Vec$", 4) == 0
        return 1
    if len > 5 and memcmp(name, c"Span$", 5) == 0
        return 1
    if len == 6 and memcmp(name, c"String", 6) == 0
        return 1
    return 0

# What a refused `[lo..hi]` names its base, as ritz0's _unsliceable does
# (AGAST #2521).
fn unsliceable_message(base_type: i32) -> *u8
    if base_type == TYPE_ARRAY
        return c"an array can't be sliced (only String, Vec and Span can)"
    if base_type == TYPE_PTR_PTR
        return c"a pointer to a pointer can't be sliced (only String, Vec and Span can)"
    if base_type == TYPE_PTR or base_type == TYPE_REF or base_type == TYPE_MUT_REF
        return c"a pointer can't be sliced (only String, Vec and Span can)"
    return c"this can't be sliced (only String, Vec and Span can)"

# AGAST #2537: `(*r)[i]` where `*r` is a `*T` and T is the scalar `elem`:
# `*r` is the pointer (an i64), so GEP it at T's own memory type
# (local_array_elem_llvm: `i1` for bool, `float` / `double` for floats) and
# widen as an array element is.
fn emit_deref_index(s: *EmitterState, e: *Expr, elem: i32) -> i32
    let ty: *u8 = elem_mem_llvm(elem)
    let base_ptr: i32 = emit_index_base_ptr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, c" = getelementptr ")
    emit_str(s, ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD)
    emit_str(s, ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr)
    emit_str(s, IR_NL)
    return emit_array_elem_widen(s, val, elem, ty)

# AGAST #2330, #2996: `e`, a whole struct element, where a number goes.  A copy
# (`let s: S = a[i]`, `g(a[i])`) is s.struct_copy_expr; anything else put a `%S`
# where clang wanted an i64 (`a[i] as i32`, `return a[i]`, `a[i] + 1`).  Refuses
# it, located, and returns 1; returns 0 for a copy.
pub fn whole_struct_elem_refused(s: *EmitterState, e: *Expr) -> i32
    return struct_value_refused(s, e, whole_struct_value_message())

# A whole struct element or deref (`a[i]`, `*q`) in an integer slot: one message
# for both (AGAST #2525).
pub fn whole_struct_value_message() -> *u8
    return c"a whole struct is not a value here in ritz1 (copy it into a `let s: S`, or read its fields)"

# The shared refusal: a struct value `e` where a number goes, located at `e`
# with `msg`.  1 when refused; 0 when `e` is the copy being emitted.
fn struct_value_refused(s: *EmitterState, e: *Expr, msg: *u8) -> i32
    if s.struct_copy_expr == e
        return 0
    emit_nd_error(s, e.span.line, e.span.col, msg)
    return 1

# AGAST #3008: the plain struct `e` is by value, when it is a local, a param or
# a call result (`s`, `mk()`, `q.make()`); null/0 otherwise.  An enum, which
# resolve_expr_struct_name names too, is no struct to find_struct: it is an
# integer to `as` (§10.4) with its own refusals.  A `[N]S` element is
# whole_struct_elem_refused's.
pub fn struct_value_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var name: *u8 = null
    var len: i32 = 0
    if e.kind == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        # AGAST #2525: `*q`, `*(q + i)` with `q: *S`, which loads the `%S`.
        deref_pointee_struct_name(s, e.operand, @name, @len)
    else if e.kind == EXPR_IDENT or e.kind == EXPR_CALL or e.kind == EXPR_METHOD
        resolve_expr_struct_name(s, e, @name, @len)
    else
        return
    if name == null or len == 0 or find_struct(s, StrView { ptr: (name), len: (len) as i64 }) == null
        return
    *out_name = name
    *out_len = len

# AGAST #3008: `s as i32`, `mk() as i32` on a struct `S`: ritz0's refusal (#2999).
# ritz1 emitted the `%S` as the integer and clang refused the IR.  1 when refused.
pub fn struct_cast_to_int_refused(s: *EmitterState, e: *Expr) -> i32
    if ty_int_bits(e.op) == 0
        return 0
    var name: *u8 = null
    var len: i32 = 0
    struct_value_name(s, e.left, @name, @len)
    if name == null
        return 0
    let target: *u8 = primitive_name_from_type(e.op)
    var n: i32 = 0
    let head: *u8 = ctor_join(StrView { ptr: (c"cannot cast struct `"), len: (20) as i64 }, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"` to `"), len: (6) as i64 }, @n)
    let tail: *u8 = c"`: a struct is not an integer (read one of its fields, or take its address with @)"
    let msg: *u8 = ctor_join(StrView { ptr: (head), len: (n) as i64 }, StrView { ptr: (target), len: (strlen(target) as i32) as i64 }, StrView { ptr: (tail), len: (strlen(tail) as i32) as i64 }, @n)
    return struct_value_refused(s, e.left, msg)

# AGAST #3008: `return s`, `return mk()` or a tail `mk()` in an `-> i64` fn, on a
# struct `S`: ritz0's refusal (#2999).  1 when refused.
pub fn struct_return_as_int_refused(s: *EmitterState, value: *Expr, ret_type: i32) -> i32
    if ty_int_bits(ret_type) == 0
        return 0
    var name: *u8 = null
    var len: i32 = 0
    struct_value_name(s, value, @name, @len)
    if name == null
        return 0
    let ret_name: *u8 = primitive_name_from_type(ret_type)
    var n: i32 = 0
    let head: *u8 = ctor_join(StrView { ptr: (c"the fn returns `"), len: (16) as i64 }, StrView { ptr: (ret_name), len: (strlen(ret_name) as i32) as i64 }, StrView { ptr: (c"`, but this is struct `"), len: (23) as i64 }, @n)
    let tail: *u8 = c"`: a struct is not an integer (return one of its fields)"
    let msg: *u8 = ctor_join(StrView { ptr: (head), len: (n) as i64 }, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (tail), len: (strlen(tail) as i32) as i64 }, @n)
    return struct_value_refused(s, value, msg)

# AGAST #3565: the pointee of `x`, the root of an index store's base (a
# local, param, global, field, cast or call).  A `**T` root sets *out_pp and
# returns TYPE_PTR: its element is a pointer.  A `*T` root returns what
# ptr_root_pointee says, or for a global (which ptr_root_pointee leaves to
# its callers' own global arms) its recorded pointee.  0 for anything else.
# sema_index_store.ritz's index_store_check accepts exactly these roots.
pub fn index_store_root_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32, out_pp: *i32) -> i32
    *out_name = null
    *out_len = 0
    *out_pp = 0
    var pp: i32 = 0
    # AGAST #3757: `@a[i]`, the address of an inline array's element.
    if x.kind == EXPR_UNARY
        return addr_elem_root_pointee(s, x, out_name, out_len)
    # AGAST #3757: `p as @&T` (a `ptr`, #1754) points at T as `p as *T` does;
    # the parser records a scalar T (cast_tail_new) as it does a struct.
    if x.kind == EXPR_CAST and x.op == TYPE_MUT_REF
        let rk: i32 = x.int_val as i32
        if primitive_name_len(rk) > 0
            return rk
        if rk != TYPE_STRUCT or x.ident_len == 0 or find_struct(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) == null
            return 0
        *out_name = x.ident_ptr
        *out_len = x.ident_len
        return TYPE_STRUCT
    if x.kind == EXPR_CAST
        pp = (x.op == TYPE_PTR_PTR) as i32
    else if x.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, x)
        pp = (fd != null and fd.return_type == TYPE_PTR_PTR) as i32
    else if x.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, x)
        pp = (fld != null and fld.field_type == TYPE_PTR_PTR) as i32
    else if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if loc != null
            pp = (loc.var_type == TYPE_PTR_PTR) as i32
        else
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if glob == null
                return 0
            if glob.var_type == TYPE_PTR_PTR
                pp = 1
            else if glob.var_type != TYPE_PTR
                return 0
            else if primitive_name_len(glob.pointee_type) > 0
                return glob.pointee_type
            else
                let gn: *u8 = glob.pointee_type_name
                let gl: i32 = glob.pointee_type_name_len
                if gn == null or gl == 0 or find_struct(s, StrView { ptr: (gn), len: (gl) as i64 }) == null
                    return 0
                *out_name = gn
                *out_len = gl
                return TYPE_STRUCT
    else
        return 0
    if pp == 1
        *out_pp = 1
        return TYPE_PTR
    ptr_root_pointee(s, x, out_name, out_len)

# AGAST #3757: the element type of `@a[i]` (`@` only, not `@&`) over an
# inline array (a local, global or field `[N]T`, any rank): its scalar kind,
# or TYPE_STRUCT with the name written.  0 for anything else (a pointer or
# view element, a Vec).  `@a[i] + k` strides by it (ptr_arith_elem_size).
# sema_index_store.ritz's isc_addr_elem_ok accepts a subset (named arrays).
fn addr_elem_root_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    if x.op != OP_ADDR or x.operand == null or x.operand.kind != EXPR_INDEX
        return 0
    var elem: i32 = TYPE_VOID
    var slot: i32 = TYPE_VOID
    var name: *u8 = null
    var len: i32 = 0
    array_elem_record(s, x.operand, @elem, @slot, @name, @len)
    if primitive_name_len(elem) > 0
        return elem
    if elem != TYPE_STRUCT or name == null or len == 0 or find_struct(s, StrView { ptr: (name), len: (len) as i64 }) == null
        return 0
    *out_name = name
    *out_len = len
    TYPE_STRUCT

# AGAST #3757: the base `e` of an expression-target index as a `ptr` register:
# emit_expr's i64 converted, or the `ptr` an `as @&T` cast already is (#1754).
pub fn emit_index_base_ptr(s: *EmitterState, e: *Expr) -> i32
    let base: i32 = emit_expr(s, e)
    if expr_is_ptr_valued(s, e) == 1
        return base
    let bptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, base)
    bptr

# AGAST #3565: the pointee of an index store's base `x` when it names a `*T`
# or `**T` (out_pp): a root index_store_root_pointee types, or pointer
# arithmetic `y + k` / `y - k` down the left spine of one.  0 otherwise.
pub fn index_store_base_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32, out_pp: *i32) -> i32
    var root: *Expr = x
    while root.kind == EXPR_BINARY
        if root.op != OP_ADD and root.op != OP_SUB
            return 0
        # `q - p` of two pointers is a count, not a pointer.
        if root.op == OP_SUB and index_store_base_pointee(s, root.right, out_name, out_len, out_pp) != 0
            *out_name = null
            *out_len = 0
            *out_pp = 0
            return 0
        root = root.left
    # An `as @&T` cast is a `ptr`, and a reference does no arithmetic.
    if root != x and root.kind == EXPR_CAST and root.op == TYPE_MUT_REF
        return 0
    index_store_root_pointee(s, root, out_name, out_len, out_pp)

# AGAST #3833: `(e as *S)[i]` and `(q + k)[i]` over a `*S`: the `%S` at
# element i, at a stride of sizeof(S).  A copy only (the caller refuses the
# rest, whole_struct_elem_refused).
fn emit_struct_ptr_index(s: *EmitterState, e: *Expr, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let base_ptr: i32 = emit_index_base_ptr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, c" = getelementptr ")
    emit_llvm_type_struct(s, TYPE_STRUCT, StrView { ptr: (name), len: (len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TYPE_STRUCT, val, StrView { ptr: (name), len: (len) as i64 }, ptr, null, 0)
    return val

pub fn emit_expr_index(s: *EmitterState, e: *Expr) -> i32
    # AGAST #2440: `p[i]` through a reference or pointer.
    if through_slice_refused(s, e) == 1
        return 0
    # `f()[i]` of a `-> [N]T` call is read from a spill in emit_expr (AGAST
    # #3234); emit_call_array_index puts a local in its place before here.
    let through: *LocalVar = index_through(s, e)
    if through != null
        # AGAST #2330: a struct element of a pointer to an array, as a value.  A
        # copy, `let s: S = p[i]` or `g(p[i])`, doesn't come here, and its fields
        # don't either.  This was #2321's located refusal, and `*(q + i)` failed
        # at clang for `p[i] + 1`, `p[i] as i64` and `return p[i]`.
        if through.array_view == 1 and through.pointee_type == TYPE_STRUCT and whole_struct_elem_refused(s, e) == 1
            return 0
        var th: ThroughIndex
        index_through_fill(s, e, through_spill(s, through), @th)
        return emit_expr(s, @th.deref)
    # AGAST #3403: a range on an N-D array (`a[1][0..2]`, `h.m[1][0..2]`, a
    # plane pointer's `q[1][0..2]`) is #2521's refusal, in ritz0's words.
    # emit_nd_index_value below lowered the range as an index value, and
    # ritz1 refused it unlocated, as "unknown expression kind".
    if e.right != null and e.right.kind == EXPR_RANGE
        var nd_depth: i32 = 0
        if nd_index_shape(s, e, @nd_depth) != null
            emit_nd_error(s, e.span.line, e.span.col, unsliceable_message(TYPE_ARRAY))
            return 0
    # AGAST #1509: `g[i][j]` over a multi-dimensional array (one GEP chain).
    var nd_val: i32 = 0
    if emit_nd_index_value(s, e, @nd_val) == 1
        return nd_val
    var ap_val: i32 = 0
    if emit_array_ptr_index(s, e, @ap_val) == 1
        return ap_val
    # AGAST #2332: `a[i][j]` with `a: [N]*T`.  It took the byte path.
    if is_array_elem_index(s, e) == 1
        if e.right != null and e.right.kind == EXPR_RANGE
            emit_nd_error(s, e.span.line, e.span.col, c"an element of an array of pointers can't be sliced (only String, Vec and Span can)")
            return 0
        # AGAST #3188: a struct pointee is a copy only, as a `[N]S` element is.
        var ei_name: *u8 = null
        var ei_len: i32 = 0
        deref_pointee_struct_name(s, e.left, @ei_name, @ei_len)
        if ei_len > 0 and find_struct(s, StrView { ptr: (ei_name), len: (ei_len) as i64 }) != null and whole_struct_elem_refused(s, e) == 1
            return 0
        var ei_sum: Expr
        var ei_deref: Expr
        elem_index_as_deref(s, e, @ei_sum, @ei_deref)
        return emit_expr(s, @ei_deref)
    # AGAST #3058: `b[i][j]` with `b: [N]**T` is `*(b[i] + j)`, a `*T` loaded at a
    # pointer's stride.  It took the byte path: one i8 at `b[i] + j`.
    if is_ptr_ptr_elem_index(s, e) == 1
        var pp_sum: Expr
        var pp_deref: Expr
        elem_index_as_deref(s, e, @pp_sum, @pp_deref)
        return emit_expr(s, @pp_deref)
    # AGAST #3052: `p[i]` with `p: *S` is `*(p + i)`, the `%S` at a stride of
    # sizeof(S).  It took the byte path: one i8 at `p + i`, an i64 where a
    # `%S` goes, so `let c: S = p[0]` failed at clang.
    var ps_name: *u8 = null
    var ps_len: i32 = 0
    ptr_local_struct_index(s, e, @ps_name, @ps_len)
    if ps_len > 0
        # AGAST #3188: a copy only.  `let n: i32 = p[0]`, `p[0] + 1` and
        # `return p[0]` put the `%S` where an integer goes, and clang refused it.
        if find_struct(s, StrView { ptr: (ps_name), len: (ps_len) as i64 }) != null and whole_struct_elem_refused(s, e) == 1
            return 0
        var ps_sum: Expr
        var ps_deref: Expr
        elem_index_as_deref(s, e, @ps_sum, @ps_deref)
        return emit_expr(s, @ps_deref)
    # AGAST #3147: `(*r)[i]` with `*r` a `*C` (`r: **C`, `@*C`, `@&*C`) is
    # `*(*r + i)`, the `%C` at a stride of sizeof(C), as #3122 stores one.  It
    # took the byte path below: one i8, an i64 where a `%C` goes.  A copy only,
    # as `p[i]` is above.
    if e.right != null and e.right.kind != EXPR_RANGE
        var dp_name: *u8 = null
        var dp_len: i32 = 0
        deref_ptr_ptr_struct_name(s, e.left, @dp_name, @dp_len)
        if dp_len > 0 and find_struct(s, StrView { ptr: (dp_name), len: (dp_len) as i64 }) != null
            if whole_struct_elem_refused(s, e) == 1
                return 0
            var dp_sum: Expr
            var dp_deref: Expr
            elem_index_as_deref(s, e, @dp_sum, @dp_deref)
            return emit_expr(s, @dp_deref)
    # AGAST #3527: `f()[i]` with `f` returning a `*T` or `**T` is `*(f() + i)`,
    # at the pointee's stride and width (ptr_root_pointee, as #3442 stores
    # one): a scalar T, a `%S` (a copy only, as `p[i]` above) or a `ptr`.  It
    # took the byte path below: `arr()[1]` over a `*i32` read byte 1 of a[0].
    #
    # AGAST #4060: and `b.arr()[i]`, a method returning `*T` / `**T`, as #3528
    # stores one.  It took the byte path too: `b.arr()[1]` over a `*i32` read 0.
    # ptr_arith_elem_size (stride) and inline_ptr_pointee (width) take a
    # method root too, so the `*(b.arr() + i)` below loads a T at T's stride.
    let cb_fd: *FnDef = call_fn_def(s, e.left)
    if cb_fd != null and e.right != null and e.right.kind != EXPR_RANGE
        var cb_name: *u8 = null
        var cb_len: i32 = 0
        let cb_kind: i32 = fn_ptr_return_pointee(s, cb_fd, @cb_name, @cb_len)
        var cb_ok: i32 = 0
        if cb_kind != 0
            cb_ok = 1
        else if cb_fd.return_type == TYPE_PTR_PTR
            cb_ok = 1
        if cb_ok == 1
            if cb_kind == TYPE_STRUCT and whole_struct_elem_refused(s, e) == 1
                return 0
            var cb_sum: Expr
            var cb_deref: Expr
            elem_index_as_deref(s, e, @cb_sum, @cb_deref)
            return emit_expr(s, @cb_deref)
    # AGAST #3756, #3833: `(e as *T)[i]`, `(e as **T)[i]` and `(q + k)[i]` read
    # element i at the pointee's stride and width, as emit_ptr_base_index_store
    # (#3565) stores one: a scalar T, a `%S` (a copy only, as `p[i]` above) or,
    # through a `**T`, a `ptr`.  They took the byte path below: one i8 at
    # `base + i` (`(q + 1)[1]` over a `*i32` read byte 1 of a[1]).
    if (e.left.kind == EXPR_CAST or e.left.kind == EXPR_BINARY) and e.right != null and e.right.kind != EXPR_RANGE
        var tb_name: *u8 = null
        var tb_len: i32 = 0
        var tb_pp: i32 = 0
        let tb_kind: i32 = index_store_base_pointee(s, e.left, @tb_name, @tb_len, @tb_pp)
        if tb_kind == TYPE_STRUCT and tb_pp == 0
            if whole_struct_elem_refused(s, e) == 1
                return 0
            return emit_struct_ptr_index(s, e, StrView { ptr: (tb_name), len: (tb_len) as i64 })
        if tb_kind != 0
            return emit_deref_index(s, e, tb_kind)
    # Check if base is an array, pointer-to-pointer (e.g., argv: **u8), or pointer
    #
    # AGAST #1328: resolve the base through locals THEN globals, and carry the
    # pointee kind so the fallback pointer path below can load the element at
    # its real width.  Previously (a) a global base hit find_local_type's
    # TYPE_I64 miss value and fell into the byte path (`g[i]` on a global
    # *i32 read one byte of a 4-byte slot), and (b) even for locals there was
    # no pointee-typed path at all — `p[i]` on a local *i32 also byte-loaded.
    var base_type: i32 = TYPE_PTR
    var elem_pointee: i32 = TYPE_UNKNOWN
    var local: *LocalVar = null
    if e.left.kind == EXPR_IDENT
        base_type = find_local_type(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        local = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if base_type == TYPE_UNKNOWN
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if glob != null
                base_type = glob.var_type
                elem_pointee = glob.pointee_type
            else
                # Neither local nor global: preserve the historical byte-path
                # default rather than letting TYPE_UNKNOWN leak downstream.
                base_type = TYPE_PTR
        else if local != null
            elem_pointee = local.pointee_type

    # A range index `a[lo..hi]` slices a Vec, Span or String only, and monomorph
    # rewrites one into `v.slice(lo, hi)` (AGAST #2451).  What reaches here is
    # refused, located (#2521).
    if e.right != null and e.right.kind == EXPR_RANGE
        # AGAST #2290: ritz0 slices no array, so a borrowed one isn't either.
        if local != null and base_type == TYPE_ARRAY and local.is_lent == 1
            emit_nd_error(s, e.span.line, e.span.col, c"an `a:& [N]T` param can't be sliced (only String, Vec and Span can)")
            return 0
        # AGAST #2451: a Vec, Span or String local was sliced here into a bare
        # address, so `t[1]` read bytes and `t.len` had no struct.  What
        # monomorph didn't rewrite is refused rather than read as an address.
        if base_type == TYPE_STRUCT and local != null
            if is_sliceable_name(StrView { ptr: (local.type_name), len: (local.type_name_len) as i64 }) == 1
                emit_nd_error(s, e.span.line, e.span.col, c"this slice of a Vec, Span or String isn't lowered by ritz1 (`let t = v[lo..hi]` is)")
            else
                emit_nd_error(s, e.span.line, e.span.col, c"a struct can't be sliced (only String, Vec and Span can)")
            return 0
        # AGAST #2521: nothing else slices (LANGUAGE_SPEC §3.4, R9 rules 5 and
        # 6).  An array, a raw `*T` and a `**Vec` were lowered here to a bare
        # address in an i64 (#110, #1974), read as 20 for the first two and as
        # garbage for the third.  ritz0 refuses each, at the same place.
        # A base that isn't a name defaulted to TYPE_PTR above: ask its type.
        var named: i32 = base_type
        if e.left.kind != EXPR_IDENT
            named = expr_slot_ty(e.left)
        emit_nd_error(s, e.span.line, e.span.col, unsliceable_message(named))
        return 0

    if base_type == TYPE_ARRAY and local != null and local.array_elem_type == TYPE_STRUCT and local.type_name_len > 0
        # AGAST #2592: a whole struct element of a `[N]P` local is a `%P`
        # value, as the global (#1553) and field (#188) arms load it.  It was
        # read as a `[N x i64]` slot, so `let p: P = ps[1]` stored an i64 into
        # a %P slot and clang refused the IR.  AGAST #2996: a copy only.
        if whole_struct_elem_refused(s, e) == 1
            return 0
        let sidx: i32 = emit_expr(s, e.right)
        let sptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sptr)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, local.array_size as i64)
        emit_str(s, IR_X)
        emit_llvm_type_struct(s, TYPE_STRUCT, StrView { ptr: (local.type_name), len: (local.type_name_len) as i64 })
        emit_str(s, IR_RBRACK_PTR)
        emit_reg(s, local.reg)
        emit_str(s, IR_I64_ZERO)
        emit_reg(s, sidx)
        emit_str(s, IR_NL)
        let sval: i32 = next_reg(s)
        emit_struct_load_or_defer(s, TYPE_STRUCT, sval, StrView { ptr: (local.type_name), len: (local.type_name_len) as i64 }, sptr, null, 0)
        return sval

    if base_type == TYPE_ARRAY and local != null
        # Array local - use GEP [0, index] to get element, then load.
        # AGAST #1564: at the alloca's own element type (local_array_elem_llvm);
        # u32/u16/i16 used to fall to `[N x i64]` over a narrower alloca.
        # A float / double element is the value itself (#1966): no widen.
        let elem_ty: *u8 = elem_mem_llvm(local.array_elem_type)
        let idx: i32 = emit_expr(s, e.right)
        let elem_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, local.array_size as i64)
        emit_str(s, IR_X)
        emit_str(s, elem_ty)
        emit_str(s, IR_RBRACK_PTR)
        emit_reg(s, local.reg)
        emit_str(s, IR_I64_ZERO)
        emit_reg(s, idx)
        emit_str(s, IR_NL)
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, IR_LOAD)
        emit_str(s, elem_ty)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_NL)
        return emit_array_elem_widen(s, result, local.array_elem_type, elem_ty)

    # AGAST #1504: a GLOBAL `[N]T` array. The branch above covers only an
    # array local, so a global array fell through to the pointer fallback
    # (`load i64 @g; inttoptr; gep`), which used the array's first element as
    # a base address and segfaulted. GEP the global directly instead.
    # `g[i].field` goes through emit_member_ptr, not here.
    if base_type == TYPE_ARRAY and local == null and e.left.kind == EXPR_IDENT
        let garr: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if garr != null and garr.array_elem_type == TYPE_STRUCT and garr.array_elem_type_name_len > 0
            # AGAST #1553: a whole struct element (`let q: P = g[i]`) is a
            # struct value: `load %P` from the `[N x %P]` GEP, the same form
            # a struct-valued deref or call yields, so a %P slot can take it.
            # AGAST #2996: a copy only.
            if whole_struct_elem_refused(s, e) == 1
                return 0
            return emit_struct_array_elem_load(s, StrView { ptr: (garr.name), len: (garr.name_len) as i64 }, garr.array_size, garr.array_elem_type_name, garr.array_elem_type_name_len, e.right)
        if garr != null and garr.array_elem_type != TYPE_STRUCT
            return emit_global_array_index(s, StrView { ptr: (garr.name), len: (garr.name_len) as i64 }, garr.array_size, garr.array_elem_type, elem_mem_llvm(garr.array_elem_type), e.right)

    # AGAST #1534: a module `const T: [N]X = [...]`. emit_const_array_entry
    # emits it as `@T = internal constant [N x X]`, but T is neither a local
    # nor a global, so it fell to the pointer fallback below, where
    # emit_expr_ident inlined the const's scalar value (0) as the base:
    # `inttoptr i64 0` plus a byte-wide GEP — a segfault (cryptosec SBOX/RCON).
    # Index the const's global at its real element width instead. A local of
    # the same name shadows the const (local != null skips this).
    if local == null and e.left.kind == EXPR_IDENT
        let carr: *ConstEntry = find_const_entry(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if carr != null and carr.const_type == TYPE_ARRAY and carr.value_expr != null and (carr.value_expr.kind == EXPR_ARRAY_LIT or carr.value_expr.kind == EXPR_ARRAY_FILL)
            # AGAST #3325: a struct element (`KS[1]` of `[N]StrView`) is read
            # as a global's is (#1553): emit_const_array_entry declares the
            # const `[N x %P]`.
            # AGAST #3946: a refused struct fill reads its placeholder global.
            if carr.array_elem_type == TYPE_STRUCT and carr.array_elem_type_name_len > 0 and (carr.value_expr.kind == EXPR_ARRAY_LIT or const_struct_fill_global(carr) == 1)
                if whole_struct_elem_refused(s, e) == 1
                    return 0
                return emit_struct_array_elem_load(s, StrView { ptr: (carr.name), len: (carr.name_len) as i64 }, carr.array_size, carr.array_elem_type_name, carr.array_elem_type_name_len, e.right)
            let cty: *u8 = const_elem_llvm(carr.array_elem_type)
            if cty != null
                return emit_global_array_index(s, StrView { ptr: (carr.name), len: (carr.name_len) as i64 }, carr.array_size, carr.array_elem_type, cty, e.right)

    # task-101: Span$T indexing on a struct local — `let b = s.as_bytes(); b[0]`
    # or `let b = "ABC"; b[0]`. Without this, emit_expr(e.left) loads the whole
    # %Span$u8 aggregate and the ptr-to-byte fallback's
    # `inttoptr i64 %base to ptr` fails because %base is a struct, not i64.
    # Mirrors the Vec$T struct-field path below, but for a whole-struct local.
    # NOTE: lane-bleed from ritz-task-101 into ritz-task-110's emitter_expr_access
    # lane — necessary because the emit_var_decl Span$u8 alloca fix in -101
    # depends on this to keep `bytes[0]` compiling.
    # Vec$T local indexing — `v[i]` where v: Vec<T>.  Mirrors the
    # Span$T branch below; emit_member_ptr's Vec-field path handles the
    # `s.vec_field[i]` shape but not bare-local `v[i]`.  Without this,
    # vec_push_u16_method's `v[0] == 3` lowers to `inttoptr i64 %vec_struct`
    # which clang rejects (struct → ptr not allowed).
    if e.left.kind == EXPR_IDENT and local != null and local.var_type == TYPE_STRUCT and local.type_name_len > 4
        if *(local.type_name + 0) == 'V' and *(local.type_name + 1) == 'e' and *(local.type_name + 2) == 'c' and *(local.type_name + 3) == '$'
            return emit_vec_ptr_index(s, local.reg, StrView { ptr: (local.type_name), len: (local.type_name_len) as i64 }, e.right)

    if e.left.kind == EXPR_IDENT and local != null and local.var_type == TYPE_STRUCT and local.type_name_len >= 5
        if *(local.type_name + 0) == 'S' and *(local.type_name + 1) == 'p' and *(local.type_name + 2) == 'a' and *(local.type_name + 3) == 'n' and *(local.type_name + 4) == '$'
            let idx_s: i32 = emit_expr(s, e.right)
            # GEP to data ptr field (index 0 of Span struct)
            let data_ptr_ptr: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, data_ptr_ptr)
            emit_str(s, IR_GEP_NAMED)
            emit_name(s, StrView { ptr: (local.type_name), len: (local.type_name_len) as i64 })
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, local.reg)
            emit_str(s, c", i32 0, i32 0\n")
            let data_ptr: i32 = next_reg(s)
            emit_load_into(s, IR_TY_PTR, data_ptr, data_ptr_ptr)
            # Decode element type from suffix after "Span$"
            let elem_name_s: *u8 = local.type_name + 5
            let elem_len_s: i32 = local.type_name_len - 5
            var elem_ty_s3: *u8 = c"i64"
            var elem_kind_s: i32 = TYPE_I64
            if elem_len_s == 2 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '8'
                elem_ty_s3 = c"i8"
                elem_kind_s = TYPE_U8
            else if elem_len_s == 2 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '8'
                elem_ty_s3 = c"i8"
                elem_kind_s = TYPE_I8
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '3' and *(elem_name_s + 2) == '2'
                elem_ty_s3 = c"i32"
                elem_kind_s = TYPE_I32
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '3' and *(elem_name_s + 2) == '2'
                elem_ty_s3 = c"i32"
                elem_kind_s = TYPE_U32
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'i' and *(elem_name_s + 1) == '1' and *(elem_name_s + 2) == '6'
                elem_ty_s3 = c"i16"
                elem_kind_s = TYPE_I16
            else if elem_len_s == 3 and *(elem_name_s + 0) == 'u' and *(elem_name_s + 1) == '1' and *(elem_name_s + 2) == '6'
                elem_ty_s3 = c"i16"
                elem_kind_s = TYPE_U16
            # GEP by index
            let elem_ptr_s: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, elem_ptr_s)
            emit_str(s, c" = getelementptr ")
            emit_str(s, elem_ty_s3)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, data_ptr)
            emit_str(s, IR_I64_SEP)
            emit_reg(s, idx_s)
            emit_str(s, IR_NL)
            let val_s: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, val_s)
            emit_str(s, IR_LOAD)
            emit_str(s, elem_ty_s3)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, elem_ptr_s)
            emit_str(s, IR_NL)
            # Zero/sign-extend to i64 for uniform value representation
            if elem_kind_s == TYPE_U8
                let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, val_s)
                return ext
            else if elem_kind_s == TYPE_I8
                let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, val_s)
                return ext
            else if elem_kind_s == TYPE_I32
                let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, val_s)
                return ext
            else if elem_kind_s == TYPE_U32
                let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, val_s)
                return ext
            else if elem_kind_s == TYPE_I16
                let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, val_s)
                return ext
            else if elem_kind_s == TYPE_U16
                let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, val_s)
                return ext
            return val_s

    # Check for struct member array access: s.field[idx] where field is an array
    if e.left.kind == EXPR_MEMBER
        var member_result: MemberPtrResult
        emit_member_ptr(s, e.left, @member_result)
        if member_result.success == 1
            let field: *StructField = member_result.field
            if field.field_type == TYPE_ARRAY
                let et: i32 = field.array_elem_type
                # AGAST #2996: a whole struct element is a copy only.
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0 and whole_struct_elem_refused(s, e) == 1
                    return 0
                # Array field in struct - GEP directly into it
                let idx: i32 = emit_expr(s, e.right)
                let elem_ptr: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, elem_ptr)
                emit_str(s, IR_GEP_ARRAY)
                emit_int(s, field.array_size as i64)
                emit_str(s, IR_X)
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    # AGAST #188: struct-array RHS — `[N x %T]` so the GEP
                    # element stride matches the actual struct layout.  Without
                    # this, `doc.fields[i + 1]` (RHS-read) used `[64 x i64]`
                    # GEP and `load i64`, but the LHS expects `%FieldEntry`,
                    # tripping clang's IR-verifier on `store %FieldEntry %i64val`
                    # in mausoleum doc_remove_field's compaction loop.
                    emit_llvm_type_struct(s, TYPE_STRUCT, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })
                else
                    # AGAST #1814: the field's declared element type.
                    emit_str(s, elem_mem_llvm(et))
                emit_str(s, IR_RBRACK_PTR)
                emit_reg(s, member_result.reg)
                emit_str(s, IR_I64_ZERO)
                emit_reg(s, idx)
                emit_str(s, IR_NL)
                # Load element. Integer/pointer elements load at their own
                # width (array_elem_llvm) and widen to i64. Bool loads its i1
                # and zero-extends. AGAST #1954: f32 / f64 elements load the
                # field's own `float` / `double` (field_array_elem_llvm) and
                # are returned as-is, as #1966's `loc[i]` and #1973's `p[i]`
                # are; get_expr_type reports F32 / F64 for them. They used to
                # fail closed (f32) or bit-load an i64 (f64).
                var load_ty: *u8 = elem_mem_llvm(et)
                if et == TYPE_BOOL or et == TYPE_F32 or et == TYPE_F64
                    load_ty = elem_mem_llvm(et)
                let result: i32 = next_reg(s)
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    # AGAST #188: load the struct value as `%T`, not as i64.
                    emit_struct_load_or_defer(s, TYPE_STRUCT, result, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, elem_ptr, null, 0)
                else
                    emit_str(s, IR_INDENT)
                    emit_reg(s, result)
                    emit_str(s, IR_LOAD)
                    emit_str(s, load_ty)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, elem_ptr)
                    emit_str(s, IR_NL)
                if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
                    return result
                if et == TYPE_F32 or et == TYPE_F64
                    return result
                if et == TYPE_BOOL
                    let bext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, result)
                    return bext
                # Extend to i64 if needed (zext unsigned, sext signed,
                # ptrtoint pointers; i64 as-is).
                return emit_array_elem_widen(s, result, et, load_ty)
            # AGAST #184: `obj.fwd[i]` value-read where `fwd: **Foo` is a
            # pointer to an array of *Foo (skip-list / hash-bucket pattern).
            # Pre-fix this fell through to "; ERROR: unhandled EXPR_MEMBER"
            # then a wrong-byte-stride GEP using an undef base — see
            # tome's `update[k].forward[k]` RHS-read.
            #
            # Lowering: load the field (a ptr to the *Foo array) → GEP by
            # ptr stride → load to materialise the i-th *Foo → ptrtoint
            # to i64 for the unified value model.
            else if field.field_type == TYPE_PTR_PTR and field.field_type_name_len > 0
                let idx_pp: i32 = emit_expr(s, e.right)
                let arr_base_pp: i32 = next_reg(s)
                emit_load_into(s, IR_TY_PTR, arr_base_pp, member_result.reg)
                let slot_pp: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, slot_pp)
                emit_str(s, c" = getelementptr ptr, ptr ")
                emit_reg(s, arr_base_pp)
                emit_str(s, IR_I64_SEP)
                emit_reg(s, idx_pp)
                emit_str(s, IR_NL)
                let val_pp: i32 = next_reg(s)
                emit_load_into(s, IR_TY_PTR, val_pp, slot_pp)
                let pti_pp: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, val_pp)
                return pti_pp
            # AGAST #1596: `x.f[i]` value-read with `f: *T` (primitive int
            # pointee) or `**T`: load the pointer from the field, GEP by the
            # pointee width, load and widen. Without this arm the read fell
            # through to the byte path below (`getelementptr i8` +
            # `load i8`) whatever the pointee was.
            else if (field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR) and ptr_field_elem_kind(field) != TYPE_UNKNOWN and ptr_field_elem_kind(field) != TYPE_STRUCT
                let pf_kind: i32 = ptr_field_elem_kind(field)
                # AGAST #2053: f32 / f64 pointees load as float / double
                # (ptr_field_elem_llvm), not array_elem_llvm's i64, and are
                # not widened (emit_array_elem_widen leaves them as-is).
                let pf_ty: *u8 = elem_mem_llvm(pf_kind)
                let pf_idx: i32 = emit_expr(s, e.right)
                let pf_ptr: i32 = emit_ptr_field_elem_addr(s, member_result.reg, field, pf_kind, pf_idx)
                let pf_val: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, pf_val)
                emit_str(s, IR_LOAD)
                emit_str(s, pf_ty)
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, pf_ptr)
                emit_str(s, IR_NL)
                return emit_array_elem_widen(s, pf_val, pf_kind, pf_ty)
            # AGAST #3972: `x.f[i]` with `f: *S`, the whole S by value, as
            # `p[i]` on a `*S` local is (#3052).  It took the byte path below:
            # one `load i8`, stored as the %S (lexis's
            # `rule_entry_new(rule.selectors.selectors[k], ...)`), which
            # clang refused.  A Vec, Span or String pointee indexes through.
            else if ptr_field_struct_elem(s, field) == 1
                if whole_struct_elem_refused(s, e) == 1
                    return 0
                let ps_idx: i32 = emit_expr(s, e.right)
                let ps_ptr: i32 = emit_ptr_field_elem_addr(s, member_result.reg, field, TYPE_STRUCT, ps_idx)
                let ps_val: i32 = next_reg(s)
                emit_struct_load_or_defer(s, TYPE_STRUCT, ps_val, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, ps_ptr, null, 0)
                return ps_val
            # Port of ritz0 bedc85b: Vec<T> field indexing — s.vec_field[i]
            # The field is a Vec$T struct: { *T data, i64 len, i64 cap }.
            # We already have a ptr to the Vec struct in member_result.reg; load
            # the data ptr (field 0), GEP by idx, load the element, extend to i64.
            else if field.field_type == TYPE_STRUCT and field.field_type_name_len > 4
                if *(field.field_type_name + 0) == 'V' and *(field.field_type_name + 1) == 'e' and *(field.field_type_name + 2) == 'c' and *(field.field_type_name + 3) == '$'
                    let idx_v: i32 = emit_expr(s, e.right)
                    # GEP to data field of Vec struct
                    let data_ptr_ptr: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, data_ptr_ptr)
                    emit_str(s, IR_GEP_NAMED)
                    emit_name(s, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, member_result.reg)
                    emit_str(s, c", i32 0, i32 0\n")
                    # Load data pointer
                    let data_ptr: i32 = next_reg(s)
                    emit_load_into(s, IR_TY_PTR, data_ptr, data_ptr_ptr)
                    # Determine element type from suffix after "Vec$"
                    let elem_name: *u8 = field.field_type_name + 4
                    let elem_len: i32 = field.field_type_name_len - 4
                    # Match common suffixes: i32, i64, u8, i8, u16, i16, u32
                    var elem_ty_str: *u8 = c"i64"
                    var elem_kind: i32 = TYPE_I64
                    if elem_len == 2 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '8'
                        elem_ty_str = c"i8"
                        elem_kind = TYPE_U8
                    else if elem_len == 2 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '8'
                        elem_ty_str = c"i8"
                        elem_kind = TYPE_I8
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '3' and *(elem_name + 2) == '2'
                        elem_ty_str = c"i32"
                        elem_kind = TYPE_I32
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '3' and *(elem_name + 2) == '2'
                        elem_ty_str = c"i32"
                        elem_kind = TYPE_U32
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '6' and *(elem_name + 2) == '4'
                        elem_ty_str = c"i64"
                        elem_kind = TYPE_I64
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '6' and *(elem_name + 2) == '4'
                        elem_ty_str = c"i64"
                        elem_kind = TYPE_I64
                    else if elem_len == 3 and *(elem_name + 0) == 'i' and *(elem_name + 1) == '1' and *(elem_name + 2) == '6'
                        elem_ty_str = c"i16"
                        elem_kind = TYPE_I16
                    else if elem_len == 3 and *(elem_name + 0) == 'u' and *(elem_name + 1) == '1' and *(elem_name + 2) == '6'
                        elem_ty_str = c"i16"
                        elem_kind = TYPE_U16
                    # GEP by index
                    let elem_ptr: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, elem_ptr)
                    emit_str(s, c" = getelementptr ")
                    emit_str(s, elem_ty_str)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, data_ptr)
                    emit_str(s, IR_I64_SEP)
                    emit_reg(s, idx_v)
                    emit_str(s, IR_NL)
                    # Load the element
                    let val_reg: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, val_reg)
                    emit_str(s, IR_LOAD)
                    emit_str(s, elem_ty_str)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, elem_ptr)
                    emit_str(s, IR_NL)
                    # Extend to i64 for uniform value representation
                    if elem_kind == TYPE_I32
                        let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    else if elem_kind == TYPE_U32
                        let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    else if elem_kind == TYPE_I16
                        let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    else if elem_kind == TYPE_U16
                        let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    else if elem_kind == TYPE_I8
                        let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    else if elem_kind == TYPE_U8
                        let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, val_reg)
                        return ext
                    return val_reg

    # Port of ritz0 bedc85b: Vec<T> indexing on call receiver — mk()[i].
    # When the index base is a call returning Vec<T>, spill the returned
    # struct to a stack slot, then GEP to the data pointer + index.
    if e.left.kind == EXPR_CALL
        # Look up the callee's return type
        let cfn: *FnDef = find_call_fn(s, e.left)
        if cfn != null and cfn.return_type == TYPE_STRUCT and cfn.return_type_name_len > 4
            if *(cfn.return_type_name + 0) == 'V' and *(cfn.return_type_name + 1) == 'e' and *(cfn.return_type_name + 2) == 'c' and *(cfn.return_type_name + 3) == '$'
                # Evaluate the call (returns a struct value register)
                let call_val: i32 = emit_expr(s, e.left)
                let idx_v: i32 = emit_expr(s, e.right)
                # Allocate a stack slot for the returned Vec and store
                let slot: i32 = next_reg(s)
                entry_alloca_reg_begin_named(s, slot)
                emit_name(s, StrView { ptr: (cfn.return_type_name), len: (cfn.return_type_name_len) as i64 })
                emit_str(s, IR_NL)
                entry_alloca_reg_end(s)
                emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (cfn.return_type_name), len: (cfn.return_type_name_len) as i64 }, call_val, slot)
                # GEP to data field
                let data_ptr_ptr: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, data_ptr_ptr)
                emit_str(s, IR_GEP_NAMED)
                emit_name(s, StrView { ptr: (cfn.return_type_name), len: (cfn.return_type_name_len) as i64 })
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, slot)
                emit_str(s, c", i32 0, i32 0\n")
                let data_ptr: i32 = next_reg(s)
                emit_load_into(s, IR_TY_PTR, data_ptr, data_ptr_ptr)
                # Decode elem type suffix after "Vec$"
                let elem_name2: *u8 = cfn.return_type_name + 4
                let elem_len2: i32 = cfn.return_type_name_len - 4
                var elem_ty_s2: *u8 = c"i64"
                var elem_kind2: i32 = TYPE_I64
                if elem_len2 == 2 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '8'
                    elem_ty_s2 = c"i8"
                    elem_kind2 = TYPE_U8
                else if elem_len2 == 2 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '8'
                    elem_ty_s2 = c"i8"
                    elem_kind2 = TYPE_I8
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '3' and *(elem_name2 + 2) == '2'
                    elem_ty_s2 = c"i32"
                    elem_kind2 = TYPE_I32
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '3' and *(elem_name2 + 2) == '2'
                    elem_ty_s2 = c"i32"
                    elem_kind2 = TYPE_U32
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '6' and *(elem_name2 + 2) == '4'
                    elem_ty_s2 = c"i64"
                    elem_kind2 = TYPE_I64
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '6' and *(elem_name2 + 2) == '4'
                    elem_ty_s2 = c"i64"
                    elem_kind2 = TYPE_I64
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'i' and *(elem_name2 + 1) == '1' and *(elem_name2 + 2) == '6'
                    elem_ty_s2 = c"i16"
                    elem_kind2 = TYPE_I16
                else if elem_len2 == 3 and *(elem_name2 + 0) == 'u' and *(elem_name2 + 1) == '1' and *(elem_name2 + 2) == '6'
                    elem_ty_s2 = c"i16"
                    elem_kind2 = TYPE_U16
                # GEP by index
                let elem_ptr2: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, elem_ptr2)
                emit_str(s, c" = getelementptr ")
                emit_str(s, elem_ty_s2)
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, data_ptr)
                emit_str(s, IR_I64_SEP)
                emit_reg(s, idx_v)
                emit_str(s, IR_NL)
                # Load
                let val2: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, val2)
                emit_str(s, IR_LOAD)
                emit_str(s, elem_ty_s2)
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, elem_ptr2)
                emit_str(s, IR_NL)
                # Extend to i64
                if elem_kind2 == TYPE_I32
                    let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, val2)
                    return ext
                else if elem_kind2 == TYPE_U32
                    let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, val2)
                    return ext
                else if elem_kind2 == TYPE_I16
                    let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, val2)
                    return ext
                else if elem_kind2 == TYPE_U16
                    let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, val2)
                    return ext
                else if elem_kind2 == TYPE_I8
                    let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, val2)
                    return ext
                else if elem_kind2 == TYPE_U8
                    let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, val2)
                    return ext
                return val2

    # AGAST #2537: `(*r)[i]` with `r: **T` GEPs and loads T (get_expr_type's
    # deref_index_elem), widened as an array element is.  It took the byte
    # path below: wrong values on an integer, invalid IR on a float.
    let dix: i32 = deref_index_elem(s, e)
    if dix != TYPE_VOID
        return emit_deref_index(s, e, dix)

    let base: i32 = emit_expr(s, e.left)
    let idx: i32 = emit_expr(s, e.right)

    if base_type == TYPE_PTR_PTR
        # Pointer-to-pointer: index by pointer size, load pointer
        # First convert base i64 back to ptr
        let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, base)

        let ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr ptr, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx)
        emit_str(s, IR_NL)

        let result: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, result, ptr)

        # Convert ptr to i64 for our uniform value representation
        let pti: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, result)
        return pti
    else if (base_type == TYPE_PTR or base_type == TYPE_REF or base_type == TYPE_MUT_REF) and ((ty_is_int(elem_pointee) == 1 and elem_pointee != TYPE_U8) or ty_is_float(elem_pointee) == 1)
        # AGAST #1328: pointee-typed pointer indexing — GEP by the element
        # stride and load at the element width, then extend to i64 for the
        # uniform value representation.  Covers `p[i]` / `g[i]` where the
        # base is a local or global *i16/*u16/*i32/*u32/*i64/*u64/*i8.
        # AGAST #1973: a *f32 / *f64 pointee GEPs and loads `float` /
        # `double` (local_array_elem_llvm's spelling) and returns the value
        # as-is; it used to fall to the byte path below (`load i8`).
        let elem_ty: *u8 = elem_mem_llvm(elem_pointee)
        let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, base)
        let ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr ")
        emit_str(s, elem_ty)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, base_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx)
        emit_str(s, IR_NL)
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, IR_LOAD)
        emit_str(s, elem_ty)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, ptr)
        emit_str(s, IR_NL)
        if ty_int_bits(elem_pointee) == 64 or elem_pointee == TYPE_F32 or elem_pointee == TYPE_F64
            return result
        let ext: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ext)
        if ty_is_unsigned(elem_pointee) == 1
            emit_str(s, c" = zext ")
        else
            emit_str(s, c" = sext ")
        emit_str(s, elem_ty)
        emit_str(s, IR_SP)
        emit_reg(s, result)
        emit_str(s, IR_TO_I64)
        return ext
    else
        # Pointer-to-byte: index by 1, load byte
        # First convert i64 value back to ptr
        let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, base)

        let ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr)
        emit_str(s, c" = getelementptr i8, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx)
        emit_str(s, IR_NL)

        let result: i32 = next_reg(s)
        emit_load_into(s, IR_TY_I8, result, ptr)

        let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, result)
        return ext

# Build a `%Enum` value whose tag is `tag` (alloca + zero + store i8 + load),
# for a unit variant: the qualified `Shade.Light` (emit_expr_member) and,
# AGAST #1600, the bare `Light` (emit_expr_ident).  The result register is a
# struct-typed SSA value usable as a call arg or var-decl initializer.
# AGAST #2422: 1 when (name, len) is an instance of a generic enum
# (`Slot$i32`), which monomorph recorded as an enum of that name.
pub fn is_enum_instance(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    let ei: i32 = enum_find(StrView { ptr: (name), len: (len) as i64 })
    (ei >= 0 and enum_is_generic(ei) == ENUM_INSTANCE) as i32

# AGAST #2422: a generic enum's variant has no enum of its own to build:
# `Full(5)` is a `Slot<i32>` only because its slot says so, as in ritz0.  The
# slot is the typed let's, the parameter's or field's (ctx_enum_name), else the
# enclosing fn's return type outside a call argument.  When that is an instance
# declaring variant `name`, its tracker index (*out_vi the tag); else -1.
pub fn slot_instance_variant(s: *EmitterState, name_sv: StrView, out_vi: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var en: *u8 = s.ctx_enum_name
    var en_len: i32 = s.ctx_enum_name_len
    if en == null and s.ctx_enum_arg == 0
        en = s.ret_type_name
        en_len = s.ret_type_name_len
    if is_enum_instance(StrView { ptr: (en), len: (en_len) as i64 }) == 0
        return 0 - 1
    let vi: i32 = enum_variant_index(StrView { ptr: (en), len: (en_len) as i64 }, StrView { ptr: (name), len: (len) as i64 })
    if vi < 0
        return 0 - 1
    *out_vi = vi
    enum_find(StrView { ptr: (en), len: (en_len) as i64 })

# AGAST #3021: a generic enum's bare constructor (`Full(6)`, `Empty`) whose
# slot names no instance of it, refused at the constructor:
#   file:line:col: can't infer the `Slot` instance `Full` builds: give its
#   slot a `Slot<...>` type
# A call lowered to one to an undeclared `@Full`, so the link failed with no
# location; a unit variant was "unknown identifier".  Returns an i64 zero so
# the fn still emits (the error stops the output), 0 when `name` is no
# generic enum's variant.
pub fn emit_no_instance_error(s: *EmitterState, name_sv: StrView, span: SrcSpan) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var vi: i32 = 0
    let ei: i32 = generic_enum_of_variant(StrView { ptr: (name), len: (len) as i64 }, @vi)
    if ei < 0
        return 0
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(ei, @en_len)
    emit_str(s, c"  ; ERROR: generic enum constructor with no instance\n")
    diag_error_at(emitter_source_file(), span)
    eprints_cstr(c"can't infer the `")
    eprint_bytes(StrView { ptr: (en), len: (en_len) as i64 })
    eprints_cstr(c"` instance `")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints_cstr(c"` builds: give its slot a `")
    eprint_bytes(StrView { ptr: (en), len: (en_len) as i64 })
    eprints_cstr(c"<...>` type\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0  ; constructor with no instance (error)\n")
    z

fn emit_unit_variant_value(s: *EmitterState, enum_name_sv: StrView, tag: i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, c"  ; enum variant ctor\n")
    entry_alloca_reg_end(s)
    # Zero-init so any padding is deterministic
    emit_str(s, IR_STORE_STRUCT)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    # Pointer to the tag byte (field 0)
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    emit_store_imm(s, IR_TY_I8, tag as i64, tag_ptr)
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    return val

# Copy `len` bytes of `src` to `dst`; returns `dst + len`.
fn put_bytes(dst: *u8, src_sv: StrView) -> *u8
    var src: *u8 = src_sv.ptr
    var len: i32 = src_sv.len as i32
    for i in 0..len
        *(dst + i) = *(src + i)
    return dst + len

# AGAST #2451: `t.len` on a String local names no field: one located error, in
# ritz0's words (R17 rule 5(a) since #3015), where it fell to the unlocated "unhandled EXPR_MEMBER".
# Returns 1 after reporting `e`.
fn unknown_field_refused(s: *EmitterState, e: *Expr) -> i32
    if e.left == null or e.left.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc == null or loc.var_type != TYPE_STRUCT or loc.type_name == null
        return 0
    let st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
    if st == null
        return 0
    var f: *StructField = st.fields
    while f != null
        if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
            return 0
        f = f.next
    # R17 rule 5(a)'s words, at the field name (AGAST #3015): "`S` has no field
    # `f`".  Sema (deref_field.ritz) has usually said it already; it says it once.
    let words: *u8 = df_no_field_once(s.module, e, st)
    if words != null
        emit_nd_error(s, df_line(e), df_col(e), words)
    return 1

# AGAST #3362: `s.f` with `s` a local or param whose struct type is declared
# nowhere (`var s: Foo`, or `String` with no `import ritzlib.string`).  It fell
# to the unlocated "unhandled EXPR_MEMBER".  One located error at `s`, naming
# the type, once per name in a row: a second access, or a `String` that #3347
# already refused at its literal, is the same mistake and says nothing more.
# Returns 1 when `e` is that case (reported now or before).
fn unknown_struct_member_refused(s: *EmitterState, e: *Expr) -> i32
    if e.left == null or e.left.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc == null or loc.var_type != TYPE_STRUCT or loc.type_name == null or loc.type_name_len <= 0
        return 0
    if find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 }) != null
        return 0
    if s.error_count > 0 and name_eq(StrView { ptr: (s.unknown_struct_name), len: (s.unknown_struct_name_len) as i64 }, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 }) == 1
        return 1
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.left.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.left.span.col as i64)
    eprints_cstr(c": error: `")
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    eprints_cstr(c"` is a `")
    eprint_bytes(StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
    eprints_cstr(c"`, which names no declared struct: it has no field `")
    eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    eprints_cstr(c"` (is an import missing?)\n")
    s.error_count = s.error_count + 1
    s.unknown_struct_name = loc.type_name
    s.unknown_struct_name_len = loc.type_name_len
    return 1

# AGAST #4263: `o.expect("x").v` / `o.frob().v`, a field of a method call the
# arm above couldn't type, because the method is none of the receiver's.  It
# fell to "unhandled EXPR_MEMBER" at the outer expression.  Emitting the call
# reports that method by itself, located at its name (refuse_no_method).
# Returns 1 when the call reported an error.
pub fn method_base_refused(s: *EmitterState, e: *Expr) -> i32
    if e.left == null or e.left.kind != EXPR_METHOD
        return 0
    let before: i32 = s.error_count
    emit_expr(s, e.left)
    if s.error_count > before
        return 1
    0

# AGAST #4155: `p.len` with `p` a `*i32` local or param, or `x.len` with `x` an
# `i64`: a scalar has no fields.  It fell to "unhandled EXPR_MEMBER" (and ritz0
# raised a ValueError traceback).  One located error at the base, naming it and
# its type, in ritz0's words (type_checker.py, _refuse_primitive_member).  A
# local whose type the emitter only guessed (bk_unsure) is left alone.
# Returns 1 when `e` is that case.
pub fn primitive_member_refused(s: *EmitterState, e: *Expr) -> i32
    if e.left == null or e.left.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc == null or loc.bk_unsure == 1 or loc.type_name_len > 0
        return 0
    var sigil: *u8 = c""
    var scalar: i32 = loc.var_type
    if loc.var_type == TYPE_PTR
        sigil = c"*"
        scalar = loc.pointee_type
    else if loc.var_type == TYPE_I64 and loc.is_bool == 1
        scalar = TYPE_BOOL
    let name: *u8 = primitive_name_from_type(scalar)
    if name == null
        return 0
    emit_str(s, c"  ; ERROR\n")
    diag_error_at(emitter_source_file(), e.left.span)   # located at the base
    eprints_cstr(c"`")
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    eprints_cstr(c"` has type `")
    eprints_cstr(sigil)
    eprints_cstr(name)
    eprints_cstr(c"`, which is not a struct: it has no field `")
    eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    eprints_cstr(c"`\n")
    s.error_count = s.error_count + 1
    return 1

# `"lit".ptr` / `"lit".len` (AGAST #4301).  A bare literal is a StrView (#98):
# `.ptr` is its NUL-terminated @.str global, as a `c"lit"` is (a *u8, carried
# as i64), and `.len` its byte count, known here.  ritz0 types `.len` as an
# i64 like any StrView's, so a narrowing `let n: i32 = "lit".len` is refused
# by both (narrowing.ritz does not exempt it as a constant).  No other field.
fn emit_strlit_field(s: *EmitterState, e: *Expr) -> i32
    let lit: *Expr = e.left
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"len"), len: (3) as i64 }) == 1
        let r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, r)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, lit.string_len as i64)
        emit_str(s, c"  ; string-literal .len\n")
        return r
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"ptr"), len: (3) as i64 }) == 1
        let str_idx: i32 = add_string(s, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
        let gep: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, gep)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, (lit.string_len + 1) as i64)
        emit_str(s, c" x i8], ptr @.str.")
        emit_int(s, str_idx as i64)
        emit_str(s, c", i64 0, i64 0\n")
        let r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, r)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, gep)
        emit_str(s, c" to i64  ; string-literal .ptr\n")
        return r
    # deref_field.ritz refuses any other field first, in these words; this
    # is the backstop, so a miss there is an error and never bad IR.
    emit_str(s, c"  ; ERROR\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints_cstr(c"`StrView` has no field `")
    eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    eprints_cstr(c"`\n")
    s.error_count = s.error_count + 1
    0

pub fn emit_expr_member(s: *EmitterState, e: *Expr) -> i32
    # expr.field - member access on struct.
    #
    # Qualified enum variant: `Shade.Light` / `Result.Ok`.  When the LHS
    # ident is a known enum type and the RHS is one of its variants,
    # materialize a %Shade-typed value: alloca + store i8 <tag> + load %Shade.
    # The result register is a struct-typed SSA value usable as a call arg
    # or var-decl initializer; downstream var-decl narrowing handles the
    # alloca-width / store-type so `let a = Shade.Light` packs correctly.
    if e.left.kind == EXPR_IDENT
        if is_enum_type(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == 1
            let variant_idx: i32 = enum_variant_index(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if variant_idx >= 0
                # AGAST #1466: `Option.None` built `alloca %Option`, which
                # clang rejects (ritz1 has no generic-enum specialisation;
                # ritz0 rejects the form).
                if enum_is_generic(enum_find(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })) == 1
                    return emit_qualified_variant_error(s, e, c"is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. None")
                return emit_unit_variant_value(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, variant_idx)
    if e.left.kind == EXPR_STRING_LIT
        return emit_strlit_field(s, e)
    #
    # `m.K` / `m.f`: no `module.item` access (§15.3, AGAST #2215).  Was a
    # flat lookup of K (ritz0's too), so it compiled while `m.f()` did not.
    if e.left.kind == EXPR_IDENT
        if is_module_item(s, e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len) == 1
            return emit_module_item_error(s, e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len, e.span.line, e.span.col)

    # Use emit_member_ptr helper for both direct and nested access
    var member_result: MemberPtrResult
    emit_member_ptr(s, e, @member_result)
    if member_result.success == 1
        let field: *StructField = member_result.field
        let field_ptr: i32 = member_result.reg
        # Load the field value
        let val_reg: i32 = next_reg(s)
        if field.field_type == TYPE_STRUCT
            # AGAST #4461: a whole-struct field value is a copy candidate.
            emit_struct_load_or_defer(s, TYPE_STRUCT, val_reg, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, field_ptr, null, 0)
        else
            emit_str(s, IR_INDENT)
            emit_reg(s, val_reg)
            emit_str(s, IR_LOAD)
            emit_field_llvm_type(s, field)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, field_ptr)
            emit_str(s, IR_NL)
        # Convert to i64 if needed
        if field.field_type == TYPE_I32
            let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_U32
            let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_I8
            let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_U8
            let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_I16
            let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_U16
            let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else if field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR
            let pti: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, val_reg)
            return pti
        else if field.field_type == TYPE_BOOL
            # AGAST #1646: a bool field is stored as i1 but, like every other
            # scalar, read into an i64 register. Operators (`not`, `and`,
            # `==`), `-> bool` returns and bool call args all assume i64;
            # the raw i1 load was invalid IR in each.
            let ext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, val_reg)
            return ext
        else
            return val_reg
    if method_base_refused(s, e) == 1   # AGAST #4263
        return 0
    if unknown_field_refused(s, e) == 1
        return 0
    if unknown_struct_member_refused(s, e) == 1   # AGAST #3362
        return 0
    if primitive_member_refused(s, e) == 1   # AGAST #4155
        return 0
    emit_ir_error(s, e.span, c"unhandled EXPR_MEMBER")

    # Unhandled path — return 0
    return 0

