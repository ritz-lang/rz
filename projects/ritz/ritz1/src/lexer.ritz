# ritz1/src/lexer.ritz - ritz1's lexer
#
# A direct-coded scanner (AGAST #1821).  lexer_next_token dispatches on the
# next byte: layout (indentation, newlines, brackets), comments and blanks
# here; then a token, the longest match of the grammar's token definitions
# (grammars/ritz1.grammar), a keyword beating an identifier of the same text:
#   identifiers and keywords   lexer_scan_ident (+ lexer_keyword, generated)
#   numbers                    lexer_scan_number
#   "..." and c"..."           lexer_scan_string
#   '.'                        lexer_scan_char
#   operators and punctuation  lexer_operator (generated)
# lexer_keyword and lexer_operator are generated by ritzgen into
# lexer_scan_gen.ritz; ritzgen refuses a grammar whose regex tokens differ
# from the ones the scan_* functions here implement.
#
# This was a Thompson NFA, rebuilt from the grammar's regex strings for every
# file and every interpolation placeholder (~557 KB of stack each) and
# simulated by recursive backtracking.  The module keeps its name so its
# importers are unchanged.  The token stream is byte-identical to the NFA's
# for every .ritz file in the repo, its quirks included.  #3886 then made an
# unterminated "..." / c"..." ritz0's located error at its start, and a raw
# newline cut a c"..." off as it does a "...".

import tokens_gen
import lexer_scan_gen
import ritzlib.memory

# Maximum indentation depth (nested blocks): the size of Lexer.indent_stack.
# Deeper nesting is a located lexer error (AGAST #1813); it used to be pushed
# with no bounds check, writing past the array into the fields after it.
const MAX_INDENT_DEPTH: i32 = 64

# Maximum bracket nesting: the size of Lexer.bracket_kinds.  Deeper is a
# located lexer error (AGAST #3447); past it the kinds used to go unrecorded,
# silently.  ritz0 has no limit.
const MAX_BRACKET_DEPTH: i32 = 64

# Initial capacity of the cooked-string scratch buffer.  This is a starting
# size, NOT a cap — `lexer_str_push` grows it geometrically.  See the
# `string_buf` comment on `struct Lexer`.
const STRING_SCRATCH_INIT: i32 = 256

# Lexer state
# NOTE: Using i64 for position/length fields to handle large files; i32 elsewhere for efficiency
struct Lexer
  src: *u8
  len: i64                 # File size (use i64 for large files)
  pos: i64                 # Current position (use i64 for large files)
  line: i32
  col: i32
  # Indentation tracking - array embedded in struct
  # NOTE: Using i32 instead of i64 since indent depth is at most 64
  indent_stack: [64]i32    # Stack of indentation levels
  indent_depth: i32        # Current depth in indent_stack
  at_line_start: i32       # 1 if at start of line, 0 otherwise
  pending_dedents: i32     # Number of DEDENT tokens to emit
  bracket_depth: i32       # Nesting depth of (), [], {} - no NEWLINE/INDENT/DEDENT when > 0
  # The open brackets' kinds (`(`, `[` or `{`), for the error below.
  bracket_kinds: [64]u8    # MAX_BRACKET_DEPTH
  # No block opens inside brackets (LARB R46a, AGAST #3388): their line
  # breaks and indentation are ignored, so a `match` there, or an `if` whose
  # line ends before its `then`, is refused at the keyword.  #2369's "layout
  # frame", which laid a bracket's lines out again after an `if` condition,
  # is gone.  if_line is the line of an `if` inside brackets still waiting
  # for its `then`, 0 if none.
  if_line: i32
  if_col: i32
  if_start: *u8
  if_depth: i32            # the bracket depth it is at
  line_indent: i32         # leading spaces of the current line
  last_kind: i32           # the last token returned
  # Continuation lines (LARB R46, AGAST #3388).  The line after one that
  # ends, outside brackets, in a binary operator or `as` opens and closes no
  # block, and must be indented at least as far as its statement.  A trailing
  # `>` / `>>` may close a generic list instead: on a line holding a
  # declaration keyword (decl_line), as in `fn f() -> Vec<T>`, it opens the
  # body's block; elsewhere (a field `data: Vec<u8>`) the next line is a
  # continuation only if it is deeper (cont_line 2).
  cont_line: i32           # 1 if the next line is a continuation, 2 if it is when deeper
  decl_line: i32           # 1 once this line has `fn`, `struct`, ... outside brackets
  # Cooked-string scratch buffer (escapes expanded).  ritz-task-1267.
  #
  # This used to be a fixed `[8192]i8` arena shared by *every* string
  # literal in the file, with each write guarded by `if pos < MAX_STRING_LEN`.
  # Once a source file's literals totalled more than 8 KiB the guard
  # silently stopped writing: the token that straddled the boundary got a
  # truncated `string_len` and every literal after it got `string_len == 0`.
  # ritz1 compiling its own `emitter.ritz` (8 KiB of literals by
  # `register_builtin_structs`) therefore emitted `@.str.N = [1 x i8] c"\00"`
  # for the tail of the module — producing, among other things, a struct
  # named `%\00\00\00` and a `.ll` with no `; ModuleID` header.  A compiler
  # must never silently drop source, and a fixed arena can't express
  # "however many literals this file has", so the arena is gone.
  #
  # Now: a single heap scratch buffer that grows on demand and is rewound
  # (`string_pos = 0`) at the start of each literal.  `lexer_str_finish`
  # copies the finished literal into its own exact-sized heap allocation,
  # so token `string_val` pointers are stable for the life of the process
  # and are unaffected by later growth or by `lexer_reset` between files.
  string_buf: *i8          # heap scratch; null until the first literal
  string_cap: i32          # bytes allocated in string_buf
  string_pos: i32          # write cursor within the literal being cooked
  # AGAST #1813: the message for the TOK_ERROR just returned, or null for an
  # unrecognised character.  Set by lexer_fail, which also stops the lexer.
  error_msg: *u8
  # asm body mode (LANGUAGE_SPEC §18.6, AGAST #3394).  An `asm` block's body is
  # text, not Ritz: `movq $3, %rcx` and `nopl (%rax)` must reach the parser
  # whole.  A line that starts with `asm` (outside brackets) and ends in `:`
  # puts the lexer in this mode for the lines indented under it: each becomes
  # one TOK_ASM_LINE (lexer_asm_line), then NEWLINE.  The first gets the
  # block's INDENT; a deeper one gets no INDENT of its own (its extra
  # indentation is dropped).  The first line no deeper than the `asm` line
  # leaves the mode and is laid out as usual, DEDENTing the body.
  asm_line: i32            # 1 from an `asm` at bracket depth 0 to its NEWLINE
  asm_base: i32            # that line's indentation
  asm_raw: i32             # 1 while lexing an asm body
  asm_body: i32            # 1 once the body's INDENT has been pushed

# Point the lexer at a new source, keeping its string scratch buffer.
pub fn lexer_reset(lex: *Lexer, src_sv: StrView) -> i32
  var src: *u8 = src_sv.ptr
  var len: i64 = src_sv.len
  lex.src = src
  lex.len = len
  lex.pos = 0
  lex.line = 1
  lex.col = 1
  # Reset indentation tracking (MUST be 1, not 0!)
  lex.indent_stack[0] = 0  # Base indentation level is 0
  lex.indent_depth = 1     # Stack has one element (important!)
  lex.at_line_start = 1    # Start at beginning of first line
  lex.pending_dedents = 0
  lex.bracket_depth = 0    # Not inside any brackets
  lexer_layout_reset(lex)
  lexer_asm_reset(lex)
  # Reset string buffer
  lex.string_pos = 0
  lex.error_msg = null
  0

# No pending `if`, no continuation, no token seen.
fn lexer_layout_reset(lex: *Lexer)
  lex.line_indent = 0
  lex.if_line = 0
  lex.if_col = 0
  lex.if_start = null
  lex.if_depth = 0
  lex.last_kind = 0
  lex.cont_line = 0
  lex.decl_line = 0

# Not in, or about to enter, an asm body.
fn lexer_asm_reset(lex: *Lexer)
  lex.asm_line = 0
  lex.asm_base = 0
  lex.asm_raw = 0
  lex.asm_body = 0

# At the start of a line in asm body mode (AGAST #3394), with lex.pos at its
# first byte.  Returns 1 with a token in out_tok (the body's INDENT, or a tab
# error), 0 to go on scanning: a blank or comment-only line was skipped, the
# line's text is next (at_line_start is 0), or the line ends the body (the
# mode is off and at_line_start still 1, so it is laid out as usual).
fn lexer_asm_line_start(lex: *Lexer, out_tok: *Token) -> i32
  var indent: i32 = 0
  while lexer_peek_at(lex, indent) == 32  # space
    indent = indent + 1
  let c: i32 = lexer_peek_at(lex, indent)
  # A blank or comment-only line, a tab, or the end of input: as anywhere.
  if c == 10 or c == 35 or c == 9 or lex.pos + indent >= lex.len
    return lexer_handle_indent(lex, out_tok)
  if indent <= lex.asm_base
    lex.asm_raw = 0
    return 0
  lex.pos = lex.pos + indent
  lex.col = lex.col + indent
  lex.line_indent = indent
  lex.at_line_start = 0
  if lex.asm_body == 1
    return 0
  if lex.indent_depth >= MAX_INDENT_DEPTH
    return lexer_fail(lex, out_tok, c"blocks nested more than 64 levels deep")
  lex.asm_body = 1
  lex.indent_stack[lex.indent_depth] = indent
  lex.indent_depth = lex.indent_depth + 1
  *out_tok = token_new(TOK_INDENT, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
  1

# One line of an asm body, from lex.pos (past its indentation) to the end of
# the line, as TOK_ASM_LINE.  A `#` and what follows it is a comment and is
# left out, as is trailing whitespace; the newline is lexed next, as usual.
fn lexer_asm_text(lex: *Lexer) -> Token
  let start: i64 = lex.pos
  let line: i32 = lex.line
  let col: i32 = lex.col
  var end: i64 = start
  while end < lex.len and *(lex.src + end) != 10 and *(lex.src + end) != 35
    end = end + 1
  var stop: i64 = end
  while end < lex.len and *(lex.src + end) != 10
    end = end + 1
  while stop > start and (*(lex.src + stop - 1) == 32 or *(lex.src + stop - 1) == 9 or *(lex.src + stop - 1) == 13)
    stop = stop - 1
  lex.col = lex.col + (end - start) as i32
  lex.pos = end
  token_new(TOK_ASM_LINE, StrView { ptr: (lex.src + start), len: ((stop - start) as i32) as i64 }, line, col)

# 1 if `kind` is an infix operator, one a line can end in with the expression
# going on: ritz0's Parser.PRECEDENCE less the ranges, which ritz1's grammar
# takes in `for` headers and slices only.
fn lexer_is_infix(kind: i32) -> i32
  if kind == TOK_OR or kind == TOK_OROR or kind == TOK_AND or kind == TOK_ANDAND
    return 1
  if kind == TOK_PIPE or kind == TOK_CARET or kind == TOK_AMP
    return 1
  if kind == TOK_EQ or kind == TOK_NE or kind == TOK_LT or kind == TOK_LE
    return 1
  if kind == TOK_GT or kind == TOK_GE or kind == TOK_SHL or kind == TOK_SHR
    return 1
  if kind == TOK_PLUS or kind == TOK_MINUS or kind == TOK_STAR or kind == TOK_SLASH
    return 1
  if kind == TOK_PERCENT or kind == TOK_AS
    return 1
  0

# The line just ended (outside brackets) makes the next a continuation (LARB
# R46) if it ends in an infix operator: 1, or 2 for a `>` / `>>`, which may
# close a generic list (`data: Vec<u8>`), so only a deeper line continues it.
# On a declaration's line (`fn f() -> Vec<T>`) a `>` / `>>` is that close: 0.
fn lexer_ends_in_operator(lex: *Lexer) -> i32
  if lexer_is_infix(lex.last_kind) == 0
    return 0
  if lex.last_kind == TOK_GT or lex.last_kind == TOK_SHR
    if lex.decl_line == 1
      return 0
    return 2
  1

# Fatal TOK_ERROR at an `if` / `match` keyword (start, line, col) that would open
# a block inside brackets (LARB R46a), naming the innermost bracket.  ritz0's
# message (#3429).
fn lexer_fail_block(lex: *Lexer, start: *u8, line: i32, col: i32) -> Token
  var bracket: u8 = 40
  if lex.bracket_depth >= 1 and lex.bracket_depth <= MAX_BRACKET_DEPTH
    bracket = lex.bracket_kinds[lex.bracket_depth - 1]
  lex.error_msg = c"a block can't open inside `(`: bind the `if`/`match` to a `let` first"
  if bracket == 91
    lex.error_msg = c"a block can't open inside `[`: bind the `if`/`match` to a `let` first"
  if bracket == 123
    lex.error_msg = c"a block can't open inside `{`: bind the `if`/`match` to a `let` first"
  lex.pos = lex.len
  lex.pending_dedents = 0
  lex.cont_line = 0
  token_new(TOK_ERROR, StrView { ptr: (start), len: (1) as i64 }, line, col)

# Return a located, fatal TOK_ERROR at the current position and stop lexing:
# the next lexer_next returns EOF.  The tab case used to return TOK_ERROR
# without advancing, so tokenize looped forever printing the same error.
fn lexer_fail(lex: *Lexer, out_tok: *Token, msg: *u8) -> i32
  *out_tok = token_new(TOK_ERROR, StrView { ptr: (lex.src + lex.pos), len: (1) as i64 }, lex.line, lex.col)
  lex.error_msg = msg
  lex.pos = lex.len
  lex.pending_dedents = 0
  1

# The byte a one-char escape `\<esc>` cooks to, or -1 if the language defines
# no such escape (AGAST #1978).  `braces` is 1 for "..." and '.' literals,
# which (as in ritz0) also accept `\{` and `\}`; c"..." has no interpolation,
# so there they are unknown.  Every arm used to end in "unknown escape -> the
# literal char", which silently turned c"a\qb" into "aqb".  `\x` takes two
# more bytes, so it is cooked by lexer_cook_escape_at, the entry point every
# literal kind uses; expr_char and print's re-cooker (emitter_print) too.
pub fn lexer_cook_escape(esc: i32, braces: i32) -> i32
  if esc == 110       # \n
    return 10
  if esc == 116       # \t
    return 9
  if esc == 114       # \r
    return 13
  if esc == 92        # \\
    return 92
  if esc == 34        # \"
    return 34
  if esc == 39        # \'
    return 39
  if esc == 48        # \0
    return 0
  if esc == 101       # \e, ESC (AGAST #1872)
    return 27
  if braces == 1 and (esc == 123 or esc == 125)  # \{ \}
    return esc
  -1

# lexer_cook_escape_at's failures, besides lexer_cook_escape's -1 (unknown).
const ESCAPE_HEX_DIGITS: i32 = -2   # `\x` without two hex digits
const ESCAPE_HEX_RANGE: i32 = -3    # `\xNN` above 0x7F

# Value of hex digit `c`, or -1.
fn lexer_hex_val(c: i32) -> i32
  if c >= 48 and c <= 57      # 0-9
    return c - 48
  if c >= 97 and c <= 102     # a-f
    return c - 87
  if c >= 65 and c <= 70      # A-F
    return c - 55
  -1

# The byte the escape whose escape char (the one after the backslash) is at
# `p` cooks to, or a negative failure code.  `avail` is how many bytes of the
# literal remain from `p` on; a `\x` short of two never reads past them.
# ritz0's twin is lexer.py `decode_escape`; the two must agree.
#
# AGAST #1872: `\xNN` is exactly two hex digits, either case, at most 0x7F.
# A literal is UTF-8 text, so a lone byte above 0x7F would be half a
# character; a non-ASCII character is written as itself.
pub fn lexer_cook_escape_at(p: *u8, avail: i64, braces: i32) -> i32
  let esc: i32 = ((*p) as i32) & 255
  if esc != 120               # not \x
    return lexer_cook_escape(esc, braces)
  if avail < 3
    return ESCAPE_HEX_DIGITS
  let hi: i32 = lexer_hex_val(((*(p + 1)) as i32) & 255)
  let lo: i32 = lexer_hex_val(((*(p + 2)) as i32) & 255)
  if hi < 0 or lo < 0
    return ESCAPE_HEX_DIGITS
  let v: i32 = hi * 16 + lo
  if v > 127
    return ESCAPE_HEX_RANGE
  v

# Source bytes an escape occupies after its backslash: 3 for `\xNN`, else 1.
pub fn lexer_escape_width(esc: i32) -> i32
  if esc == 120
    return 3
  1

# Append the NUL-terminated `text` to `buf` at `n`; returns the new length.
fn lexer_msg_append(buf: *u8, n: i64, text: *u8) -> i64
  var k: i64 = n
  var i: i64 = 0
  while *(text + i) != 0
    *(buf + k) = *(text + i)
    k = k + 1
    i = i + 1
  k

# Longest escape message is under 120 bytes; round up (AGAST #1820).
const LEXER_ESCAPE_MSG_BUF: i64 = 160

# Fatal, located TOK_ERROR for a bad escape: `p` points at its escape char
# (the byte after the backslash), at source offset `pos` -- the column ritz0
# reports -- and `code` is lexer_cook_escape_at's failure.  The messages are
# ritz0's (lexer.py decode_escape):
#   Unknown escape sequence '\q'
#   Hex escape '\x' needs exactly two hex digits
#   Hex escape '\xC3' is above '\x7F': ...
fn lexer_fail_escape(lex: *Lexer, pos: i64, line: i32, col: i32, p: *u8, code: i32) -> Token
  # Fatal path: never freed.  The longest message is under 120 bytes.
  let msg: *u8 = malloc(LEXER_ESCAPE_MSG_BUF)
  var n: i64 = 0
  if code == ESCAPE_HEX_DIGITS
    n = lexer_msg_append(msg, n, c"Hex escape '\\x' needs exactly two hex digits")
  else if code == ESCAPE_HEX_RANGE
    n = lexer_msg_append(msg, n, c"Hex escape '\\x")
    *(msg + n) = *(p + 1)
    *(msg + n + 1) = *(p + 2)
    n = lexer_msg_append(msg, n + 2, c"' is above '\\x7F': a literal is UTF-8 text, so write a non-ASCII character as itself")
  else
    n = lexer_msg_append(msg, n, c"Unknown escape sequence '\\")
    *(msg + n) = *p
    *(msg + n + 1) = 39
    n = n + 2
  *(msg + n) = 0
  lex.error_msg = msg
  lex.pos = lex.len
  lex.pending_dedents = 0
  token_new(TOK_ERROR, StrView { ptr: (lex.src + pos), len: (1) as i64 }, line, col)

# Initialize a lexer on `src` (`len` bytes).  Nothing to build: the scanner
# is code (AGAST #1821).
pub fn lexer_init(lex: *Lexer, src_sv: StrView) -> i32
  var src: *u8 = src_sv.ptr
  var len: i64 = src_sv.len
  # Lexers are usually `var lex: Lexer` on the stack, so the cooked-string
  # scratch MUST be zeroed here: a garbage `string_buf` would be handed
  # straight to realloc.
  lex.string_buf = null
  lex.string_cap = 0
  lexer_reset(lex, StrView { ptr: (src), len: (len) })

# ============================================================================
# Cooked-string scratch buffer (ritz-task-1267)
# ============================================================================
#
# Contract: `lexer_str_begin` before the first byte of a literal,
# `lexer_str_push` per cooked byte, `lexer_str_finish` to take ownership of
# an exact-sized, NUL-terminated heap copy.  The scratch itself is reused
# across literals; the copy is what tokens point at.

# Rewind the scratch to the start of a fresh literal.
fn lexer_str_begin(lex: *Lexer)
  lex.string_pos = 0

# Append one cooked byte, growing the scratch geometrically.  There is
# deliberately no upper bound: the only limit on a string literal's length
# is available memory.
fn lexer_str_push(lex: *Lexer, b: i8)
  if lex.string_pos >= lex.string_cap
    var new_cap: i32 = lex.string_cap * 2
    if new_cap < STRING_SCRATCH_INIT
      new_cap = STRING_SCRATCH_INIT
    let grown: *u8 = realloc(lex.string_buf as *u8, new_cap as i64)
    if grown == null
      return
    lex.string_buf = grown as *i8
    lex.string_cap = new_cap
  *(lex.string_buf + lex.string_pos) = b
  lex.string_pos = lex.string_pos + 1

# Copy the cooked literal into its own heap allocation and return it.
# NUL-terminated so callers that treat it as a cstring keep working; the
# authoritative length is `lex.string_pos` (embedded NULs are legal).
fn lexer_str_finish(lex: *Lexer) -> *u8
  let n: i32 = lex.string_pos
  let out: *u8 = malloc((n as i64) + 1)
  if out == null
    return null
  var i: i32 = 0
  while i < n
    *(out + i) = (*(lex.string_buf + i)) as u8
    i = i + 1
  *(out + n) = 0
  out

# Helper: get current character at position
fn lexer_peek_at(lex: *Lexer, offset: i32) -> i32
  let pos: i64 = lex.pos + offset
  if pos >= lex.len
    return 0  # EOF
  (*(lex.src + pos)) & 255

# Helper: skip a line comment (starting at #)
fn lexer_skip_comment(lex: *Lexer) -> i32
  while lex.pos < lex.len
    let ch: i32 = lexer_peek_at(lex, 0)
    if ch == 10  # newline
      return 0
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
  0

# Handle indentation at line start
# Returns: 1 if we should return a token, 0 if we should continue scanning
fn lexer_handle_indent(lex: *Lexer, out_tok: *Token) -> i32
  # Count leading spaces
  var indent: i32 = 0
  while lexer_peek_at(lex, indent) == 32  # space
    indent = indent + 1

  # Check for tab (error); ritz0's message.
  if lexer_peek_at(lex, indent) == 9  # tab
    lex.pos = lex.pos + indent
    lex.col = lex.col + indent
    return lexer_fail(lex, out_tok, c"Tabs not allowed for indentation; use spaces")

  # Skip blank lines (just newline after spaces)
  if lexer_peek_at(lex, indent) == 10  # newline
    lex.pos = lex.pos + indent + 1
    lex.line = lex.line + 1
    lex.col = 1
    # Stay at line start for next line
    return 0  # Continue scanning

  # Skip comment-only lines (but NOT @attributes)
  if lexer_peek_at(lex, indent) == 35  # '#'
    lex.pos = lex.pos + indent
    lex.col = lex.col + indent
    lexer_skip_comment(lex)
    # The main loop will handle the newline
    return 0  # Continue scanning

  # Advance past leading spaces
  lex.pos = lex.pos + indent
  lex.col = lex.col + indent
  lex.line_indent = indent

  # Get current indentation level from stack
  let current: i32 = lex.indent_stack[lex.indent_depth - 1]

  # A continuation (LARB R46) opens and closes no block.  `current` is its
  # statement's indentation: continuation lines push none.  ritz0's message,
  # at column 1.  After a `>` / `>>` (cont_line 2) only a deeper line is one.
  if lex.cont_line == 2 and indent <= current
    lex.cont_line = 0
  if lex.cont_line != 0
    lex.cont_line = 0
    lex.at_line_start = 0
    if indent < current
      lex.col = 1
      return lexer_fail(lex, out_tok, c"continuation line is indented less than the statement it continues; indent it at least as far as the statement's first line")
    return 0

  if indent > current
    # Deeper indentation - push and emit INDENT
    if lex.indent_depth >= MAX_INDENT_DEPTH
      return lexer_fail(lex, out_tok, c"blocks nested more than 64 levels deep")
    lex.indent_stack[lex.indent_depth] = indent
    lex.indent_depth = lex.indent_depth + 1
    *out_tok = token_new(TOK_INDENT, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
    lex.at_line_start = 0
    return 1

  if indent < current
    # Shallower indentation - pop and queue DEDENTs
    var count: i32 = 0
    while lex.indent_depth > 1
      if lex.indent_stack[lex.indent_depth - 1] <= indent
        break
      lex.indent_depth = lex.indent_depth - 1
      count = count + 1
    # Queue all but one DEDENT (we return the first one now)
    lex.pending_dedents = count - 1
    *out_tok = token_new(TOK_DEDENT, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
    lex.at_line_start = 0
    return 1

  # Same indentation - just continue
  lex.at_line_start = 0
  0

# Get next token from the lexer, noting the `if` / `match` inside brackets
# (LARB R46a) and the declaration keywords (LARB R46).
pub fn lexer_next(lex: *Lexer) -> Token
  var tok: Token = lexer_next_token(lex)
  # AGAST #3394: `asm ... :` NEWLINE starts an asm body.
  if tok.kind == TOK_ASM and lex.bracket_depth == 0
    lex.asm_line = 1
    lex.asm_base = lex.line_indent
  if tok.kind == TOK_NEWLINE and lex.asm_line == 1
    lex.asm_line = 0
    if lex.last_kind == TOK_COLON and lex.bracket_depth == 0
      lex.asm_raw = 1
      lex.asm_body = 0
  # LARB R46a: a `match` always opens a block; an `if` inside brackets waits
  # for its `then` (the newline check in lexer_next_token).
  if lex.bracket_depth > 0
    if tok.kind == TOK_MATCH
      return lexer_fail_block(lex, tok.start, tok.line, tok.col)
    if tok.kind == TOK_IF
      lex.if_line = tok.line
      lex.if_col = tok.col
      lex.if_start = tok.start
      lex.if_depth = lex.bracket_depth
    if tok.kind == TOK_THEN
      lex.if_line = 0
  if lex.bracket_depth == 0
    if tok.kind == TOK_FN or tok.kind == TOK_STRUCT or tok.kind == TOK_ENUM
      lex.decl_line = 1
    if tok.kind == TOK_IMPL or tok.kind == TOK_TRAIT or tok.kind == TOK_TYPE or tok.kind == TOK_EXTERN
      lex.decl_line = 1
  lex.last_kind = tok.kind
  tok

# ============================================================================
# The scanner (AGAST #1821)
# ============================================================================
#
# Each scan_* function implements one of the grammar's regex tokens exactly
# as written there (ritzgen checks the text: SCANNED_REGEX_TOKENS), as the
# longest match from lex.pos.  They only measure: lexer_emit makes the token.

# Byte at source offset `at`, or -1 past the end.  (lexer_peek_at answers 0
# there, which a source's own NUL byte would be mistaken for.)
fn lexer_at(lex: *Lexer, at: i64) -> i32
  if at >= lex.len
    return -1
  (*(lex.src + at)) & 255

# Byte classes for lexer_run.
const CLASS_DIGIT: i32 = 0    # [0-9]
const CLASS_HEX: i32 = 1      # [0-9a-fA-F]
const CLASS_BIN: i32 = 2      # [01]
const CLASS_IDENT: i32 = 3    # [a-zA-Z0-9_]

# 1 if `c` (-1 past the end) is in `class`.
fn lexer_in_class(c: i32, class: i32) -> i32
  if c >= 48 and c <= 57         # 0-9
    if class != CLASS_BIN or c <= 49
      return 1
    return 0
  if class == CLASS_HEX
    if lexer_hex_val(c) >= 0
      return 1
  if class == CLASS_IDENT
    if lexer_is_ident_start(c) == 1
      return 1
  0

# 1 if `c` can start an identifier: [a-zA-Z_].
fn lexer_is_ident_start(c: i32) -> i32
  if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
    return 1
  0

# How many bytes from `at` on are in `class`.
fn lexer_run(lex: *Lexer, at: i64, class: i32) -> i64
  var n: i64 = 0
  while lexer_in_class(lexer_at(lex, at + n), class) == 1
    n = n + 1
  n

# How many bytes from `at` on are in `class` or a `_` (a digit separator,
# LANGUAGE_SPEC §2.6, AGAST #3584).  Every `_` a number's digits run into is
# taken in, wherever it stands, for lexer_check_separators to place.
fn lexer_run_sep(lex: *Lexer, at: i64, class: i32) -> i64
  var n: i64 = 0
  var c: i32 = lexer_at(lex, at)
  while c == 95 or lexer_in_class(c, class) == 1                 # _
    n = n + 1
    c = lexer_at(lex, at + n)
  n

# IDENT /[a-zA-Z_][a-zA-Z0-9_]*/, or the keyword (lexer_keyword) it spells.
# A `c` straight before `"` never gets here: it is lexer_scan_string's.
# Returns the kind, its length in *out_len.
fn lexer_scan_ident(lex: *Lexer, out_len: *i32) -> i32
  let at: i64 = lex.pos
  let n: i64 = 1 + lexer_run(lex, at + 1, CLASS_IDENT)
  *out_len = n as i32
  lexer_keyword(lex.src + at, n)

# lexer_match's kind for a number whose exponent has no digit (`1e`, `1e+`,
# `2.0e-x`): *out_len is the offset of the byte where the digit should be.
const LEX_NO_EXP_DIGIT: i32 = -2

# The length of the exponent `[eE][+-]?[0-9]+` at `at`; 0 if no `e`/`E` is
# there, -1 - (offset of the missing digit) when no digit follows the
# `e` and its sign.  As ritz0, an `e` after the digits is always an exponent.
fn lexer_exponent(lex: *Lexer, at: i64) -> i64
  let c: i32 = lexer_at(lex, at)
  if c != 101 and c != 69                                        # e E
    return 0
  var n: i64 = 1
  let sign: i32 = lexer_at(lex, at + 1)
  if sign == 43 or sign == 45                                    # + -
    n = 2
  let digits: i64 = lexer_run_sep(lex, at + n, CLASS_DIGIT)
  if digits == 0
    return -1 - n
  n + digits

# NUMBER /0x[0-9a-fA-F]+|0b[01]+|[0-9]+/ or FLOAT, whichever is longer (they
# never tie).  FLOAT is digits then a fraction `\.[0-9]+`, an exponent
# `[eE][+-]?[0-9]+`, or both (AGAST #3929), as ritz0 lexes it: `2.0e10`,
# `1e-5`.  `1.e5` has no fraction, so it is `1` `.` `e5`.  After `.` (a tuple
# index) there is no exponent, as ritz0.  An `e` with no digit after it (and
# its sign) is LEX_NO_EXP_DIGIT.  Suffixes are lexer_number_suffix's.
# Each digit run also takes in every `_` it meets (lexer_run_sep, AGAST
# #3584); lexer_check_separators refuses the misplaced ones.
fn lexer_scan_number(lex: *Lexer, out_len: *i32) -> i32
  let at: i64 = lex.pos
  let digits: i64 = lexer_run_sep(lex, at, CLASS_DIGIT)
  var mant: i64 = digits
  if lexer_at(lex, at + digits) == 46                            # .
    # A fraction starts with a digit, or a `_` before one (`1._5`, taken in
    # to be refused); `1.e5` and `0.._n` have none.
    var f: i64 = at + digits + 1
    if lexer_at(lex, f) == 95                                    # _
      f = f + 1
    if lexer_in_class(lexer_at(lex, f), CLASS_DIGIT) == 1
      mant = digits + 1 + lexer_run_sep(lex, at + digits + 1, CLASS_DIGIT)
  var exp: i64 = 0
  if lex.last_kind != TOK_DOT
    exp = lexer_exponent(lex, at + mant)
  if exp < 0
    *out_len = (mant - 1 - exp) as i32
    return LEX_NO_EXP_DIGIT
  if mant > digits or exp > 0
    *out_len = (mant + exp) as i32
    return TOK_FLOAT
  var n: i64 = digits
  if lexer_at(lex, at) == 48                                     # 0
    var radix: i64 = 0
    if lexer_at(lex, at + 1) == 120                              # 0x
      radix = lexer_run_sep(lex, at + 2, CLASS_HEX)
    else if lexer_at(lex, at + 1) == 98                          # 0b
      radix = lexer_run_sep(lex, at + 2, CLASS_BIN)
    if radix > 0 and radix + 2 > n
      n = radix + 2
  *out_len = n as i32
  TOK_NUMBER

# CHAR /'([^'\\]|\\.|\\x[^'\n]*)'/ at a `'`: TOK_CHAR with its length in
# *out_len, or -1.  The `\x` arm runs to the next quote on the line, so a
# short or non-hex `'\x1'` is a CHAR that lexer_check_char refuses with the
# hex message.  A `\x` the `\\.` arm also matches (`'\x'`) is the same length.
fn lexer_scan_char(lex: *Lexer, out_len: *i32) -> i32
  let at: i64 = lex.pos
  let c1: i32 = lexer_at(lex, at + 1)
  if c1 < 0 or c1 == 39                                          # '' or EOF
    return -1
  var end: i64 = at + 2                                          # 'c'
  if c1 == 92
    end = at + 3                                                 # '\c'
    if lexer_at(lex, at + 2) == 120                              # '\x...'
      while end < lex.len and lexer_at(lex, end) != 39 and lexer_at(lex, end) != 10
        end = end + 1
    else if lexer_at(lex, at + 2) < 0
      return -1
  if lexer_at(lex, end) != 39
    return -1
  *out_len = (end + 1 - at) as i32
  TOK_CHAR

# The longest token at lex.pos: its kind and, in *out_len, its length; -1 if
# none starts there (a stray byte, the end of input).  "..." / c"..." are lexer_scan_string's.
fn lexer_match(lex: *Lexer, out_len: *i32) -> i32
  let c: i32 = lexer_at(lex, lex.pos)
  if lexer_is_ident_start(c) == 1
    return lexer_scan_ident(lex, out_len)
  if c >= 48 and c <= 57
    return lexer_scan_number(lex, out_len)
  if c == 39
    return lexer_scan_char(lex, out_len)
  lexer_operator(lex.src + lex.pos, lex.len - lex.pos, out_len)

# The one escape cooker (AGAST #1821): every string literal's body goes
# through here, "..." and c"...".  Cooks the bytes from *at into the scratch
# buffer (lexer_str_begin .. lexer_str_finish) up to the closing quote.
# Returns 1 with *at on that quote; 0 if a newline or the end of input comes
# first; -1 with a fatal escape-error token in *err, located by the literal's
# `start` offset, `line` and `col`.  `braces` is as for lexer_cook_escape_at.
fn lexer_cook(lex: *Lexer, at: *i64, braces: i32, start: i64, line: i32, col: i32, err: *Token) -> i32
  lexer_str_begin(lex)
  let end: i64 = lex.len
  var i: i64 = *at
  var status: i32 = 0
  while i < end
    let c: i32 = lexer_at(lex, i)
    if c == 34
      status = 1
      break
    if c == 10
      break
    if c != 92
      lexer_str_push(lex, c as i8)
      i = i + 1
      continue
    i = i + 1                    # the escape char
    if i < end
      let p: *u8 = lex.src + i
      let cooked: i32 = lexer_cook_escape_at(p, end - i, braces)
      if cooked < 0
        *err = lexer_fail_escape(lex, i, line, col + (i - start) as i32, p, cooked)
        return -1
      lexer_str_push(lex, cooked as i8)
      i = i + lexer_escape_width(lexer_at(lex, i))
  *at = i
  status

# A string literal of `kind` whose opening quote is `prefix` bytes on from
# lex.pos ("..." 1, c"..." 2), ending on its own line, as in ritz0: a raw
# newline is in neither (the grammar's [^"\\] would take one).  Returns the
# token, an escape error, or, with no closing quote before the newline or
# the end of input, ritz0's fatal error located at the literal's start (the
# `c` of a c"...", ritz0's span).
fn lexer_scan_string(lex: *Lexer, kind: i32, prefix: i32) -> Token
  var tok: Token = token_new(TOK_ERROR, StrView { ptr: (null), len: (0) as i64 }, 0, 0)
  let start: i64 = lex.pos
  let line: i32 = lex.line
  let col: i32 = lex.col
  var braces: i32 = 1
  if kind == TOK_CSTRING
    braces = 0                   # c"..." has no interpolation
  var at: i64 = start + prefix
  let status: i32 = lexer_cook(lex, @at, braces, start, line, col, @tok)
  if status < 0
    lex.col = tok.col            # scanned up to the bad escape
    return tok
  if status == 0
    var msg: *u8 = c"Unterminated string literal"
    if kind == TOK_CSTRING
      msg = c"Unterminated C-string literal"
    lexer_fail(lex, @tok, msg)   # at lex.pos, still the literal's start
    return tok
  lex.pos = at + 1
  lex.col = col + (lex.pos - start) as i32
  # A token's span length is bounded by Token.len, which is i32; the
  # *position* stays i64 (#1399).
  tok = lexer_token(lex, kind, start, (lex.pos - start) as i32, line, col)
  tok.string_val = lexer_str_finish(lex)
  tok.string_len = lex.string_pos
  tok

# A token of `kind` at source offset `start`.
fn lexer_token(lex: *Lexer, kind: i32, start: i64, len: i32, line: i32, col: i32) -> Token
  token_new(kind, StrView { ptr: (lex.src + start), len: (len) as i64 }, line, col)

# Number literal fix-ups after the match; returns the kind, the length in
# *len updated.
#   AGAST #3232: a number straight after `.` is a tuple field index, never a
#   float, so `p.0.1` is p . 0 . 1: cut a FLOAT back to its leading digits, a
#   bare TOK_NUMBER, as ritz0 does (#2284); the next call lexes `.` then `1`.
#   AGAST #107: a typed integer suffix `[ui](8|16|32|64|size)` is part of a
#   TOK_NUMBER (`0u8`, `0x10i32`), unless an identifier byte follows it
#   (`5usize_max` is `5` + ident).  parse_int (ast_helpers) trims it again.
#   AGAST #1615: `f32` / `f64` is part of a TOK_FLOAT (`2.5f32`); expr_float
#   casts the literal to it.  No follow-byte guard: `2.5f32x` lexes as
#   `2.5f32` + `x`, a parse error either way.
fn lexer_number_suffix(lex: *Lexer, kind: i32, len: *i32) -> i32
  if kind == TOK_FLOAT and lex.last_kind == TOK_DOT
    *len = lexer_run_sep(lex, lex.pos, CLASS_DIGIT) as i32
    return TOK_NUMBER
  let at: i64 = lex.pos + *len
  if kind == TOK_NUMBER
    *len = *len + lexer_int_suffix(lex, at)
  if kind == TOK_FLOAT and at + 2 < lex.len
    let f1: i32 = lexer_at(lex, at + 1)
    let f2: i32 = lexer_at(lex, at + 2)
    # f32 | f64
    if lexer_at(lex, at) == 102 and ((f1 == 51 and f2 == 50) or (f1 == 54 and f2 == 52))
      *len = *len + 3
  kind

# The length of the typed integer suffix at `at` (AGAST #107), or 0.  Each
# form must leave a byte after it in the source (`at + width < len`): one
# that ends the file is not taken, as the NFA lexer had it.
fn lexer_int_suffix(lex: *Lexer, at: i64) -> i32
  let s0: i32 = lexer_at(lex, at)
  # u i: lowercase only, as ritz0's NUMBER_SUFFIXES (AGAST #4273).  `1U32`
  # is `1` + the identifier `U32`, refused downstream at the `U` as ritz0 does.
  if s0 != 117 and s0 != 105
    return 0
  var ext: i32 = 0
  # size
  if at + 4 < lex.len and lexer_at(lex, at + 1) == 115 and lexer_at(lex, at + 2) == 105 and lexer_at(lex, at + 3) == 122 and lexer_at(lex, at + 4) == 101
    ext = 5
  if ext == 0 and at + 2 < lex.len
    let c1: i32 = lexer_at(lex, at + 1)
    let c2: i32 = lexer_at(lex, at + 2)
    # 16 | 32 | 64
    if (c1 == 49 and c2 == 54) or (c1 == 51 and c2 == 50) or (c1 == 54 and c2 == 52)
      ext = 3
  if ext == 0 and at + 1 < lex.len and lexer_at(lex, at + 1) == 56    # 8
    ext = 2
  if ext > 0 and lexer_in_class(lexer_at(lex, at + ext), CLASS_IDENT) == 1
    return 0                     # part of a longer identifier: `usize_max`
  ext

# LANGUAGE_SPEC §2.6, LARB R73 (AGAST #3584): a `_` in a number stands
# between two digits, of its base.  One that starts or ends the digits,
# follows `0x` / `0b`, stands by another `_`, or touches a `.`, an exponent or
# a suffix is a lexer error at it, in ritz0's words (lexer._check_separators).
# lexer_run_sep took every `_` the digits ran into, so each is in the `len`
# bytes from lex.pos.  Returns 1 with the error in *err.
fn lexer_check_separators(lex: *Lexer, len: i32, err: *Token) -> i32
  let at: i64 = lex.pos
  var class: i32 = CLASS_DIGIT
  if lexer_at(lex, at) == 48 and lexer_at(lex, at + 1) == 120     # 0x
    class = CLASS_HEX
  else if lexer_at(lex, at) == 48 and lexer_at(lex, at + 1) == 98 # 0b
    class = CLASS_BIN
  var i: i64 = 0
  while i < len as i64
    if lexer_at(lex, at + i) == 95                                 # _
      if lexer_in_class(lexer_at(lex, at + i - 1), class) == 0 or lexer_in_class(lexer_at(lex, at + i + 1), class) == 0
        lex.pos = at + i
        lex.col = lex.col + i as i32
        lexer_fail(lex, err, c"`_` must stand between two digits of a numeric literal")
        return 1
    i = i + 1
  0

# A number token's text less its `_` separators, in its own allocation, so
# every reader of the literal's text (parse_int, the 2^64 check, a float's
# digits, a suffix) sees the plain digits.  A token without one is untouched.
fn lexer_drop_separators(tok: *Token)
  var n: i32 = 0
  for i in 0..tok.len
    if *(tok.start + i) != 95
      n = n + 1
  if n == tok.len
    return
  let out: *u8 = malloc((n as i64) + 1)
  if out == null
    return
  var j: i32 = 0
  for i in 0..tok.len
    let b: u8 = *(tok.start + i)
    if b != 95
      *(out + j) = b
      j = j + 1
  *(out + n) = 0
  tok.start = out
  tok.len = n

# Track bracket depth for a token of `kind` at `start` (no NEWLINE / INDENT /
# DEDENT inside brackets).  Returns 1 with a fatal error in *err when they
# nest too deep.
fn lexer_track_bracket(lex: *Lexer, kind: i32, start: i64, line: i32, col: i32, err: *Token) -> i32
  if kind == TOK_LPAREN or kind == TOK_LBRACKET or kind == TOK_LBRACE
    if lex.bracket_depth >= MAX_BRACKET_DEPTH
      *err = token_new(TOK_ERROR, StrView { ptr: (lex.src + start), len: (1) as i64 }, line, col)
      lex.error_msg = c"brackets nested more than 64 levels deep"
      lex.pos = lex.len
      lex.pending_dedents = 0
      return 1
    lex.bracket_kinds[lex.bracket_depth] = *(lex.src + start)
    lex.bracket_depth = lex.bracket_depth + 1
  if kind == TOK_RPAREN or kind == TOK_RBRACKET or kind == TOK_RBRACE
    if lex.bracket_depth > 0
      lex.bracket_depth = lex.bracket_depth - 1
  0

# A char literal `'\X'` / `'\xNN'` is cooked later, by expr_char; refuse a
# bad escape here so it is a located lexer error like the string kinds.
# Returns 1 with the error in *err.
fn lexer_check_char(lex: *Lexer, start: i64, len: i32, line: i32, col: i32, err: *Token) -> i32
  if lexer_at(lex, start + 1) != 92
    return 0
  let esc_p: *u8 = lex.src + start + 2
  let avail: i64 = (len - 3) as i64   # bytes from esc char to the closing quote
  let cooked: i32 = lexer_cook_escape_at(esc_p, avail, 1)
  if cooked < 0
    *err = lexer_fail_escape(lex, start + 2, line, col + 2, esc_p, cooked)
    return 1
  if (lexer_escape_width(((*esc_p) as i32) & 255) as i64) != avail
    *err = lexer_token(lex, TOK_ERROR, start, 1, line, col)
    lex.error_msg = c"Character literal must contain exactly one character"
    lex.pos = lex.len
    lex.pending_dedents = 0
    return 1
  0

# The token of `kind`, `len` bytes from lex.pos, which moves past it.
fn lexer_emit(lex: *Lexer, kind: i32, len: i32) -> Token
  let start: i64 = lex.pos
  let line: i32 = lex.line
  let col: i32 = lex.col
  lex.pos = lex.pos + len
  lex.col = lex.col + len
  var tok: Token = lexer_token(lex, kind, start, len, line, col)
  var err: Token = tok
  if lexer_track_bracket(lex, kind, start, line, col, @err) == 1
    return err
  if kind == TOK_CHAR
    if lexer_check_char(lex, start, len, line, col, @err) == 1
      return err
  tok

# One byte no token starts with, as TOK_ERROR ("unexpected character").
fn lexer_bad_byte(lex: *Lexer) -> Token
  let tok: Token = lexer_token(lex, TOK_ERROR, lex.pos, 1, lex.line, lex.col)
  lex.pos = lex.pos + 1
  lex.col = lex.col + 1
  tok

# The token at lex.pos, past layout, blanks and comments.
fn lexer_scan_token(lex: *Lexer) -> Token
  var tok: Token = token_new(TOK_ERROR, StrView { ptr: (null), len: (0) as i64 }, 0, 0)
  let ch: i32 = lexer_at(lex, lex.pos)
  # `$` is no identifier character: a monomorph's internal `W$i32_bump`
  # can't be written (spec §2.5, LARB R37, AGAST #3373).  An asm body's
  # lines never get here.  ritz0's words (ref_rules.DOLLAR_OUTSIDE_ASM).
  if ch == 36
    lexer_fail(lex, @tok, c"`$` isn't part of a name: it's written only in an `asm` body")
    return tok
  # "..." and c"..." end on their line (lexer_scan_string).
  if ch == 34
    return lexer_scan_string(lex, TOK_STRING, 1)
  if ch == 99 and lexer_at(lex, lex.pos + 1) == 34
    return lexer_scan_string(lex, TOK_CSTRING, 2)
  var len: i32 = 0
  var kind: i32 = lexer_match(lex, @len)
  if kind == LEX_NO_EXP_DIGIT
    # ritz0's error, at the byte where the exponent's digit should be.
    lex.pos = lex.pos + len as i64
    lex.col = lex.col + len
    lexer_fail(lex, @tok, c"Expected digit after exponent")
    return tok
  if kind < 0
    return lexer_bad_byte(lex)
  kind = lexer_number_suffix(lex, kind, @len)
  if kind == TOK_NUMBER or kind == TOK_FLOAT
    if lexer_check_separators(lex, len, @tok) == 1
      return tok
  tok = lexer_emit(lex, kind, len)
  if kind == TOK_NUMBER or kind == TOK_FLOAT
    lexer_drop_separators(@tok)
  tok

# Skip a run of [ \t\r] (the grammar's WHITESPACE).
fn lexer_skip_blanks(lex: *Lexer)
  var c: i32 = lexer_at(lex, lex.pos)
  while c == 32 or c == 9 or c == 13
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
    c = lexer_at(lex, lex.pos)

# At the start of a line.  Returns 1 with a token in *out_tok (INDENT,
# DEDENT, an error), 0 to go on scanning.
fn lexer_line_start(lex: *Lexer, out_tok: *Token) -> i32
  # Inside brackets: no INDENT/DEDENT, just skip the leading spaces.
  if lex.bracket_depth > 0
    lex.line_indent = 0
    while lexer_at(lex, lex.pos) == 32
      lex.pos = lex.pos + 1
      lex.col = lex.col + 1
      lex.line_indent = lex.line_indent + 1
    lex.at_line_start = 0
    return 0
  if lex.asm_raw == 1
    return lexer_asm_line_start(lex, out_tok)
  lexer_handle_indent(lex, out_tok)

# At a newline.  Returns 1 with NEWLINE (or an error) in *out_tok, 0 inside
# brackets, where a newline is no token.
fn lexer_newline(lex: *Lexer, out_tok: *Token) -> i32
  let start: i64 = lex.pos
  let line: i32 = lex.line
  let col: i32 = lex.col
  lex.pos = lex.pos + 1
  lex.line = lex.line + 1
  lex.col = 1
  lex.at_line_start = 1
  # Inside brackets, a newline allows multi-line struct literals.  An `if`
  # here whose line ended before its `then`, other than after an operator
  # (its condition goes on), would open a block (LARB R46a).
  if lex.bracket_depth > 0
    if lex.if_line != 0 and lex.if_depth == lex.bracket_depth and lexer_is_infix(lex.last_kind) == 0
      *out_tok = lexer_fail_block(lex, lex.if_start, lex.if_line, lex.if_col)
      return 1
    return 0
  # Outside them, a line ending in an operator makes the next one a
  # continuation (LARB R46).
  lex.cont_line = lexer_ends_in_operator(lex)
  lex.decl_line = 0
  *out_tok = lexer_token(lex, TOK_NEWLINE, start, 1, line, col)
  1

fn lexer_next_token(lex: *Lexer) -> Token
  if lex.pending_dedents > 0
    lex.pending_dedents = lex.pending_dedents - 1
    return token_new(TOK_DEDENT, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
  var tok: Token = token_new(TOK_ERROR, StrView { ptr: (null), len: (0) as i64 }, 0, 0)
  while lex.pos < lex.len
    if lex.at_line_start == 1
      if lexer_line_start(lex, @tok) == 1
        return tok
      continue
    let ch: i32 = lexer_at(lex, lex.pos)
    if ch == 10
      if lexer_newline(lex, @tok) == 1
        return tok
      continue
    # An asm body line is text (AGAST #3394).
    if lex.asm_raw == 1
      return lexer_asm_text(lex)
    if ch == 35                  # '#'
      lexer_skip_comment(lex)
      continue
    if ch == 32 or ch == 9 or ch == 13
      lexer_skip_blanks(lex)
      continue
    return lexer_scan_token(lex)
  # End of input: close the open blocks, then EOF.
  if lex.indent_depth > 1
    lex.indent_depth = lex.indent_depth - 1
    return token_new(TOK_DEDENT, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
  token_new(TOK_EOF, StrView { ptr: (lex.src + lex.pos), len: (0) as i64 }, lex.line, lex.col)
