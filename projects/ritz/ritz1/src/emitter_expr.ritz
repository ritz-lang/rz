# ritz1/src/emitter_expr.ritz - Expression Emission
#
# emit_expr + emit_struct_lit_to_alloca — the heart of LLVM IR generation.
# Split from emitter.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import tokens_gen
import emitter_core
import index_through
import emitter_expr_arith    # emit_expr_binary, emit_expr_unary
import emitter_expr_access   # emit_expr_ident, emit_expr_index, emit_expr_member
import emitter_expr_call     # emit_expr_call, emit_expr_method
import emitter_match         # emit_match (for EXPR_MATCH)
import ownership             # own_note_temp (AGAST #2165)
import bool_check   # AGAST #2342
import struct_index # si_once_* (AGAST #1635)
import literal_slot # AGAST #2341
import float_slot   # int_into_float_slot (AGAST #2945)
import ref_check    # ref_cast_reads_referent (AGAST #3004)

# =============================================================================
# Member pointer helper - emits GEP to get pointer to field
# Returns MemberPtrResult with reg, field info, and success flag
# Handles both direct (var.field) and nested (var.field1.field2) access
# =============================================================================

# Helper to emit GEP for local variable member access
# AGAST #2372: pointers and references between a local's slot and the struct `.`
# names: 0 for a struct, 1 for `*S` and `@S`, 2 for `**S` and `@*S`, and so on.
pub fn local_struct_levels(loc: *LocalVar) -> i32
    if loc.var_type == TYPE_PTR_PTR
        return ptr_ptr_ident_levels(loc.inner_pointee_type)
    if loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
        if loc.pointee_type == TYPE_PTR
            return 2
        if loc.pointee_type == TYPE_PTR_PTR
            return 1 + ptr_ptr_ident_levels(loc.inner_pointee_type)
        return 1
    if loc.var_type == TYPE_PTR
        return 1
    0

# The same for a field.  An `@S` field is a `*S` by now (lower_ref_fields).
pub fn field_struct_levels(f: *StructField) -> i32
    if f.field_type == TYPE_PTR_PTR
        return ptr_ptr_ident_levels(f.inner_pointee_type)
    1

# 1 for a `p:& **S` param, of any depth.
pub fn param_borrows_struct_ptr_ptr(p: *Param) -> i32
    if p.is_borrow != 1 or p.param_type != TYPE_MUT_REF or p.param_pointee_type != TYPE_PTR_PTR
        return 0
    (ptr_ptr_slot_inner(p.param_inner_pointee_type) == TYPE_STRUCT) as i32

# `base` loaded `levels` times.
pub fn emit_load_levels(s: *EmitterState, base: i32, levels: i32) -> i32
    var reg: i32 = base
    for i in 0..levels
        reg = emit_load_ptr(s, reg)
    reg

fn emit_member_gep_local(s: *EmitterState, e: *Expr, result: *MemberPtrResult, loc: *LocalVar, st: *StructDef, field_idx: i32, field: *StructField)
    # For ptr/ref types — load the pointer natively (task #73 migration).
    # Old pattern was `load i64` + `inttoptr` round-trip; opaque pointers
    # let us just `load ptr` from the same slot.
    let base_ptr: i32 = emit_load_levels(s, loc.reg, local_struct_levels(loc))
    # GEP to get pointer to field
    let field_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, field_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, field_idx as i64)
    emit_str(s, c"\n")
    result.reg = field_ptr
    result.field = field
    result.success = 1

# Helper to emit GEP from a base pointer register
fn emit_member_gep_from_ptr(s: *EmitterState, result: *MemberPtrResult, base_ptr: i32, st: *StructDef, field_idx: i32, field: *StructField)
    let field_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, field_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, field_idx as i64)
    emit_str(s, c"\n")
    result.reg = field_ptr
    result.field = field
    result.success = 1

# AGAST #1487: `w[i].field` on a `Vec<Struct>` local. Pre-fix this fell
# through to "unhandled EXPR_MEMBER" even when w was annotated: the index
# branches of emit_member_ptr handled `[N]St`, `[N]*St` and `**St`, not Vec.
#
# The element struct comes from the instantiated Vec's own `data: *T` field
# (its pointee survives monomorphisation, #1440), not from decoding the
# "Vec$" suffix, so `Vec$P` and `Vec$Pair` resolve alike.
#
# Only a Vec VALUE local: through a pointer or reference it's
# emit_through_member_ptr's (#2440).
#
# Lowering: GEP %Vec$T field `data` →
# load `data` → GEP %T by index → GEP into %T for the field.
# Returns 1 on success, 0 (nothing emitted) if `loc` is not a Vec<Struct>.
fn emit_vec_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, loc: *LocalVar) -> i32
    if loc.type_name_len <= 4
        return 0
    if *(loc.type_name + 0) != 'V' or *(loc.type_name + 1) != 'e' or *(loc.type_name + 2) != 'c' or *(loc.type_name + 3) != '$'
        return 0
    if loc.var_type != TYPE_STRUCT
        return 0
    let vec_st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
    if vec_st == null
        return 0
    let data_idx: i32 = find_field_index(vec_st, c"data", 4)
    if data_idx < 0
        return 0
    let data_field: *StructField = get_field_type(vec_st, data_idx)
    if data_field.field_type != TYPE_PTR or data_field.field_type_name_len <= 0
        return 0
    let elem_st: *StructDef = find_struct(s, data_field.field_type_name, data_field.field_type_name_len)
    if elem_st == null
        return 0
    let field_idx: i32 = find_field_index(elem_st, e.ident_ptr, e.ident_len)
    if field_idx < 0
        return 0
    let field: *StructField = get_field_type(elem_st, field_idx)
    let data_pp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, data_pp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, vec_st.name, vec_st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, loc.reg)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, data_idx as i64)
    emit_str(s, c"\n")
    let data_p: i32 = emit_load_ptr(s, data_pp)
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, elem_st.name, elem_st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, data_p)
    emit_str(s, c", i64 ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")
    emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
    return 1

# AGAST #1510: the VALUE of `x`, where x is a pointer to a struct through
# one or more levels of indirection.  Sets *out_st to that struct and
# *out_levels to the number of pointer levels: 1 = `*St`, 2 = `**St`.
# Returns the register holding the loaded pointer, or 0 if the shape or
# static type isn't recognised.
#
# Recursive over the shapes a deref operand takes in practice:
#   IDENT          local `*St` / `@St` / `@&St` (1), or `**St` / `@*St` (2)
#   EXPR_MEMBER    a field of type `*St` (1) or `**St` (2), via emit_member_ptr
#   `*y`           y at levels L >= 2, loaded once more (L - 1)
# So `(*(*b).ops).n`, `(*b.ops).n` and `(**pp).n` all resolve here.
#
# The IDENT arm checks the struct before emitting anything.  The member arm
# may leave dead loads behind when it gives up; the caller reports the
# error, so they are never reached.
fn emit_deref_operand_ptr(s: *EmitterState, x: *Expr, out_st: **StructDef, out_levels: *i32) -> i32
    *out_st = null
    *out_levels = 0
    if x == null
        return 0
    if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        # AGAST #2166: `(*gp).f` with a module-level `var gp: *S` (the
        # `gp.f` form is #1892's arm in emit_member_ptr).  loc is null only
        # when no local of that name shadows the global.
        if loc == null
            let glob: *GlobalVarDef = find_global(s, x.ident_ptr, x.ident_len)
            if glob == null or glob.var_type != TYPE_PTR or glob.pointee_type != TYPE_STRUCT or glob.pointee_type_name_len <= 0
                return 0
            let gst: *StructDef = find_struct(s, glob.pointee_type_name, glob.pointee_type_name_len)
            if gst == null
                return 0
            let gp: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, gp)
            emit_str(s, c" = load ptr, ptr @")
            emit_name(s, glob.name, glob.name_len)
            emit_str(s, c"\n")
            *out_st = gst
            *out_levels = 1
            return gp
        if loc == null or loc.type_name_len <= 0
            return 0
        let levels: i32 = local_struct_levels(loc)
        if levels == 0
            return 0
        let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
        if st == null
            return 0
        *out_st = st
        *out_levels = levels
        return emit_load_ptr(s, loc.reg)
    if x.kind == EXPR_METHOD
        # AGAST #1635: `(*m.index(k)).f`, which a struct's `m[k].f` becomes.
        # The method returns an `@S`, `@&S` or `*S`: an address, in an i64.
        let fd: *FnDef = method_call_def(s, x)
        if fd == null or fd.return_type_name_len <= 0
            return 0
        if fd.return_type != TYPE_REF and fd.return_type != TYPE_MUT_REF and fd.return_type != TYPE_PTR
            return 0
        let mst: *StructDef = find_struct(s, fd.return_type_name, fd.return_type_name_len)
        if mst == null
            return 0
        let addr: i32 = emit_expr(s, x)
        let mp: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, mp)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, addr)
        emit_str(s, c" to ptr\n")
        *out_st = mst
        *out_levels = 1
        return mp
    if x.kind == EXPR_MEMBER
        var inner: MemberPtrResult
        emit_member_ptr(s, x, @inner)
        if inner.success != 1
            return 0
        let f: *StructField = inner.field
        if f.field_type_name_len <= 0
            return 0
        var flevels: i32 = 0
        if f.field_type == TYPE_PTR
            flevels = 1
        else if f.field_type == TYPE_PTR_PTR
            flevels = ptr_ptr_ident_levels(f.inner_pointee_type)
        if flevels == 0
            return 0
        let fst: *StructDef = find_struct(s, f.field_type_name, f.field_type_name_len)
        if fst == null
            return 0
        *out_st = fst
        *out_levels = flevels
        return emit_load_ptr(s, inner.reg)
    if x.kind == EXPR_UNARY and x.op == OP_DEREF
        var sub_st: *StructDef = null
        var sub_levels: i32 = 0
        let sub_reg: i32 = emit_deref_operand_ptr(s, x.operand, @sub_st, @sub_levels)
        if sub_reg == 0 or sub_levels < 2
            return 0
        *out_st = sub_st
        *out_levels = sub_levels - 1
        return emit_load_ptr(s, sub_reg)
    # AGAST #2376: `b[i]` with `b: [N]**S`, or `@a[i]` with `a: [N]*S`: a `**S`,
    # so `(**b[i]).f` reaches S.
    if elem_rooted(x) == 1
        var pl_inner: i32 = TYPE_VOID
        var pl_name: *u8 = null
        var pl_len: i32 = 0
        let pl: i32 = ptr_levels_of(s, x, @pl_inner, @pl_name, @pl_len)
        if pl >= 2 and pl_inner == TYPE_STRUCT and pl_len > 0
            let pl_st: *StructDef = find_struct(s, pl_name, pl_len)
            if pl_st == null
                return 0
            var pl_ptr: i32 = emit_expr(s, x)
            if deref_operand_is_ptr(s, x) == 0
                let pl_val: i32 = pl_ptr
                pl_ptr = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, pl_ptr)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, pl_val)
                emit_str(s, c" to ptr\n")
            *out_st = pl_st
            *out_levels = pl
            return pl_ptr
    # AGAST #2805: `y + k` / `y - k` where y is a `**S` (`qq + 1`, or a call
    # returning one, `vec_as_ptr<*S>(@w) + 1`), or such a call bare: emit_expr
    # strides it by 8, and `(*(qq + 1)).f` loads the `*S` and GEPs into S.  It
    # fell through to the `*S` arm below, which names no S for it, and was an
    # unlocated "unhandled EXPR_MEMBER".
    if x.kind == EXPR_CALL or (x.kind == EXPR_BINARY and (x.op == OP_ADD or x.op == OP_SUB))
        var pp_st: *StructDef = null
        let pp_levels: i32 = ptr_ptr_struct_operand(s, x, @pp_st)
        if pp_levels >= 2
            let pp_val: i32 = emit_expr(s, x)
            let pp_ptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, pp_ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, pp_val)
            emit_str(s, c" to ptr\n")
            *out_st = pp_st
            *out_levels = pp_levels
            return pp_ptr
    # AGAST #1924: `y + k` / `y - k` where y is a `*S` (`*(pp + i) + k`):
    # emit_expr strides it by sizeof(S) (deref_pointee_struct_name names S
    # for the left operand), so `(*(*(pp + i) + k)).f` GEPs into the right
    # element.  Only the one-level case: `(**(ppp + 1)).f` keeps its error.
    # AGAST #2332: and `a[i]` / `a[i] + k` with `a: [N]*S`.
    # AGAST #2526: and a call `f()` (`-> *S`) or a cast `x as *S`.
    if x.kind == EXPR_INDEX or x.kind == EXPR_CALL or x.kind == EXPR_CAST or (x.kind == EXPR_BINARY and (x.op == OP_ADD or x.op == OP_SUB))
        var b_name: *u8 = null
        var b_len: i32 = 0
        deref_pointee_struct_name(s, x, @b_name, @b_len)
        if b_len <= 0
            return 0
        let b_st: *StructDef = find_struct(s, b_name, b_len)
        if b_st == null
            return 0
        let b_val: i32 = emit_expr(s, x)
        let b_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, b_ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, b_val)
        emit_str(s, c" to ptr\n")
        *out_st = b_st
        *out_levels = 1
        return b_ptr
    return 0

# AGAST #2805: the pointer levels (>= 2) of `x` when it is a pointer to
# pointer to a struct S, writing S to *out_st: pointer arithmetic down the left
# spine rooted in anything ptr_levels_of resolves (a `**S` local, param, global
# or field), or in a call returning `**S` (written, or `vec_as_ptr<*S>`, which
# monomorph records as TYPE_PTR_PTR named S, a `ptr_` per extra level, #2791).
# 0 for any other shape.
fn ptr_ptr_struct_operand(s: *EmitterState, x: *Expr, out_st: **StructDef) -> i32
    *out_st = null
    var root: *Expr = x
    while root != null and root.kind == EXPR_BINARY and (root.op == OP_ADD or root.op == OP_SUB)
        root = root.left
    if root == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    var levels: i32 = 0
    if root.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, root)
        if fd == null or fd.return_type != TYPE_PTR_PTR or fd.return_type_name == null
            return 0
        name = fd.return_type_name
        len = fd.return_type_name_len
        levels = 2
        while len > 4 and memcmp(name, c"ptr_", 4) == 0
            name = name + 4
            len = len - 4
            levels = levels + 1
    else
        var inner: i32 = TYPE_VOID
        levels = ptr_levels_of(s, x, @inner, @name, @len)
        if inner != TYPE_STRUCT
            return 0
    if levels < 2 or name == null or len <= 0
        return 0
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return 0
    *out_st = st
    levels

# AGAST #2399: levels between what the call `e` returns and the struct `.` names,
# when there are two or more (`-> **S`, `-> @*S`, `-> @&**S`), with the struct in
# `out_st`.  0 for any other result.
pub fn call_result_struct_levels(s: *EmitterState, e: *Expr, out_st: **StructDef) -> i32
    *out_st = null
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null
        return 0
    if fd.return_type == TYPE_PTR_PTR and e.kind == EXPR_CALL
        return ptr_ptr_struct_operand(s, e, out_st)
    if fd.return_type != TYPE_REF and fd.return_type != TYPE_MUT_REF
        return 0
    let r: *Param = fd.ret_ref
    if r == null or r.param_type_name_len <= 0
        return 0
    var levels: i32 = 0
    if r.param_pointee_type == TYPE_PTR
        levels = 2
    else if r.param_pointee_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(r.param_inner_pointee_type) == TYPE_STRUCT
        levels = 1 + ptr_ptr_ident_levels(r.param_inner_pointee_type)
    else
        return 0
    let st: *StructDef = find_struct(s, r.param_type_name, r.param_type_name_len)
    if st == null
        return 0
    *out_st = st
    levels

# The struct pointer the call `e` returns `levels` levels from it, loaded down
# to the struct's address.  The call is emitted once.
pub fn emit_call_result_struct_ptr(s: *EmitterState, e: *Expr, levels: i32) -> i32
    let val: i32 = emit_expr(s, e)
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, val)
    emit_str(s, c" to ptr  ; call-result levels\n")
    emit_load_levels(s, p, levels - 1)

# AGAST #1924: pointer levels of a `**S` local/param/field from its inner
# pointee slot: 3 for `***S`.  2 when the slot records nothing (the
# pre-#1924 assumption, kept for names whose depth was never recorded).
fn ptr_ptr_ident_levels(slot: i32) -> i32
    let lv: i32 = ptr_ptr_slot_levels(slot)
    if lv < 2
        return 2
    return lv

fn emit_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    result.reg = 0
    result.field = null
    result.success = 0
    emit_member_ptr_at(s, e, result)

fn emit_member_ptr_at(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    # Base case: e.left is an identifier (var.field)
    if e.left.kind == EXPR_IDENT
        # First try local variable
        let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if loc != null
            let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
            if st != null
                let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                if field_idx >= 0
                    let field: *StructField = get_field_type(st, field_idx)
                    # Emit GEP - different handling for ptr/ref vs value types
                    emit_member_gep_local(s, e, result, loc, st, field_idx, field)
                    return
        # Try global variable
        let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
        if glob != null
            if glob.var_type == TYPE_STRUCT
                let st: *StructDef = find_struct(s, glob.type_name, glob.type_name_len)
                if st != null
                    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        let field_ptr: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c" = getelementptr %")
                        emit_name(s, st.name, st.name_len)
                        emit_str(s, c", ptr @")
                        emit_name(s, glob.name, glob.name_len)
                        emit_str(s, c", i32 0, i32 ")
                        emit_int(s, field_idx as i64)
                        emit_str(s, c"\n")
                        result.reg = field_ptr
                        result.field = field
                        result.success = 1
                        return
            # AGAST #1892: `g.f` with `var g: *S` at module level.  Load the
            # global pointer, then GEP into S.  This arm was missing, so both
            # reads and writes (which go through here via emit_assign) fell
            # through to "unhandled EXPR_MEMBER".
            else if glob.var_type == TYPE_PTR and glob.pointee_type == TYPE_STRUCT and glob.pointee_type_name_len > 0
                let pst: *StructDef = find_struct(s, glob.pointee_type_name, glob.pointee_type_name_len)
                if pst != null
                    let pfield_idx: i32 = find_field_index(pst, e.ident_ptr, e.ident_len)
                    if pfield_idx >= 0
                        let pfield: *StructField = get_field_type(pst, pfield_idx)
                        let gp: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, gp)
                        emit_str(s, c" = load ptr, ptr @")
                        emit_name(s, glob.name, glob.name_len)
                        emit_str(s, c"\n")
                        emit_member_gep_from_ptr(s, result, gp, pst, pfield_idx, pfield)
                        return
            # AGAST #2372: and `var g: **S`.
            else if glob.var_type == TYPE_PTR_PTR and glob.pointee_type_name_len > 0
                let qst: *StructDef = find_struct(s, glob.pointee_type_name, glob.pointee_type_name_len)
                if qst != null
                    let qfield_idx: i32 = find_field_index(qst, e.ident_ptr, e.ident_len)
                    if qfield_idx >= 0
                        let qp: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, qp)
                        emit_str(s, c" = load ptr, ptr @")
                        emit_name(s, glob.name, glob.name_len)
                        emit_str(s, c"\n")
                        let qbase: i32 = emit_load_levels(s, qp, ptr_ptr_ident_levels(glob.inner_pointee_type) - 1)
                        emit_member_gep_from_ptr(s, result, qbase, qst, qfield_idx, get_field_type(qst, qfield_idx))
                        return

    # Recursive case: e.left is another EXPR_MEMBER (nested: a.b.c)
    else if e.left.kind == EXPR_MEMBER
        # First get pointer to intermediate field
        var inner_result: MemberPtrResult
        emit_member_ptr(s, e.left, @inner_result)
        if inner_result.success == 1
            let inner_field: *StructField = inner_result.field
            # Inner field must be a struct type to continue nesting
            if inner_field.field_type == TYPE_STRUCT
                let st: *StructDef = find_struct(s, inner_field.field_type_name, inner_field.field_type_name_len)
                if st != null
                    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        emit_member_gep_from_ptr(s, result, inner_result.reg, st, field_idx, field)
                        return
            # Handle pointer-to-struct field: load the pointer, then GEP into the pointed-to struct
            # AGAST #2372: a `**S` field is loaded down to the struct too.
            else if (inner_field.field_type == TYPE_PTR or inner_field.field_type == TYPE_PTR_PTR) and inner_field.field_type_name_len > 0
                # Load the pointer value from the field
                let loaded: i32 = emit_load_levels(s, inner_result.reg, field_struct_levels(inner_field))
                # Now GEP into the pointed-to struct
                let st: *StructDef = find_struct(s, inner_field.field_type_name, inner_field.field_type_name_len)
                if st != null
                    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        emit_member_gep_from_ptr(s, result, loaded, st, field_idx, field)
                        return

    # AGAST #1647: a field of a struct returned BY VALUE, `mk(true).b`,
    # `p.pair().a`, `Q.make(1).x`, `mko(1).inner.x` (the nested arm above
    # recurses into here).  Emit the call once, spill the aggregate into an
    # alloca of the callee's return struct, then GEP the field out of it.
    # Before this the base fell through to "unhandled EXPR_MEMBER".
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        var cr_name: *u8 = null
        var cr_len: i32 = 0
        call_result_struct_name(s, e.left, @cr_name, @cr_len)
        if cr_len > 0
            let cr_st: *StructDef = find_struct(s, cr_name, cr_len)
            if cr_st != null
                let cr_idx: i32 = find_field_index(cr_st, e.ident_ptr, e.ident_len)
                if cr_idx >= 0
                    let cr_field: *StructField = get_field_type(cr_st, cr_idx)
                    let cr_val: i32 = emit_expr(s, e.left)
                    let cr_slot: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, cr_slot)
                    emit_str(s, c" = alloca %")
                    emit_name(s, cr_st.name, cr_st.name_len)
                    emit_str(s, c"  ; call-result member\n  store %")
                    emit_name(s, cr_st.name, cr_st.name_len)
                    emit_str(s, c" ")
                    emit_reg(s, cr_val)
                    emit_str(s, c", ptr ")
                    emit_reg(s, cr_slot)
                    emit_str(s, c"\n")
                    emit_member_gep_from_ptr(s, result, cr_slot, cr_st, cr_idx, cr_field)
                    return
        # AGAST #2399: `h(x).f` with `h` returning `**S` or `@*S`: through
        # every level, as for a local of that type.
        var cl_st: *StructDef = null
        let cl_levels: i32 = call_result_struct_levels(s, e.left, @cl_st)
        if cl_levels >= 2
            let cl_idx: i32 = find_field_index(cl_st, e.ident_ptr, e.ident_len)
            if cl_idx >= 0
                let cl_ptr: i32 = emit_call_result_struct_ptr(s, e.left, cl_levels)
                emit_member_gep_from_ptr(s, result, cl_ptr, cl_st, cl_idx, get_field_type(cl_st, cl_idx))
                return
        # AGAST #2879: a `*S` result is the struct's address, so its field is
        # a place: `sp(@s).x = 3`, `s.me().arr[2] = 5`.  GEP through the
        # pointer the call returns.  The call is emitted once here; `x op= v`
        # shares it between the read and the store (si_once, #2529).
        let cp_st: *StructDef = call_result_ptr_struct(s, e.left)
        if cp_st != null
            let cp_idx: i32 = find_field_index(cp_st, e.ident_ptr, e.ident_len)
            if cp_idx >= 0
                let cp_val: i32 = emit_expr(s, e.left)
                let cp_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, cp_ptr)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, cp_val)
                emit_str(s, c" to ptr  ; *S call-result member\n")
                emit_member_gep_from_ptr(s, result, cp_ptr, cp_st, cp_idx, get_field_type(cp_st, cp_idx))
                return

    # Dereference case: ptr.field - e.left is EXPR_UNARY with OP_DEREF
    # Also: address-of-then-member case: (@expr).field — when the inner
    # expression already resolves through a struct pointer, the outer
    # `.field` is effectively another step into the same struct.  E.g.
    # `(@srv.pool).active_count` ≡ `srv.pool.active_count` since
    # srv:*TaskServer already accesses pool by pointer-GEP. (async/tasks
    # `task_server_handle_accept` uses this idiom.)
    else if e.left.kind == EXPR_UNARY
        if e.left.op == OP_ADDR or e.left.op == OP_ADDR_MUT
            # Treat (@inner).field as inner.field — recurse with a synthetic
            # member expr where the OP_ADDR layer is stripped.
            var sub_e: Expr
            sub_e.kind = EXPR_MEMBER
            sub_e.left = e.left.operand
            sub_e.ident_ptr = e.ident_ptr
            sub_e.ident_len = e.ident_len
            emit_member_ptr(s, @sub_e, result)
            if result.success == 1
                return
        if e.left.op == OP_DEREF
            # AGAST #2449: `(*(@x)).f` / `(*(@&x)).f` is `x.f`: the deref
            # undoes the address-of.  Recurse on the stripped member so every
            # base `x.f` takes (local, field, `a[i]`, `v[i]`) works here too.
            # It fell to the unlocated "unhandled EXPR_MEMBER".
            let d_op: *Expr = e.left.operand
            if d_op != null and d_op.kind == EXPR_UNARY and (d_op.op == OP_ADDR or d_op.op == OP_ADDR_MUT) and d_op.operand != null
                var da_e: Expr = *e
                da_e.left = d_op.operand
                emit_member_ptr(s, @da_e, result)
                return
            # The operand of the dereference should be a pointer-to-struct identifier
            if e.left.operand.kind == EXPR_IDENT
                # Find local by name - need full LocalVar, not just reg
                let loc: *LocalVar = find_local_struct_name(s, e.left.operand.ident_ptr, e.left.operand.ident_len)
                if loc != null
                    # loc should be TYPE_PTR with type_name pointing to struct type
                    if loc.var_type == TYPE_PTR
                        let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
                        if st != null
                            let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                            if field_idx >= 0
                                let field: *StructField = get_field_type(st, field_idx)
                                # OP_DEREF path: native ptr load (task #73 migration)
                                let base_ptr: i32 = emit_load_ptr(s, loc.reg)
                                emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                                return
            # AGAST #1510: the operand is itself a field or a deref —
            # `(*(*b).ops).n`, `(*b.ops).n`, `(**pp).n`.  Resolve its
            # pointee struct recursively, then GEP on it.
            # AGAST #1940: a `**S` ident (`(*pp).n`) falls through to here
            # too; the `*S` ident arm above only takes one level.
            var d_st: *StructDef = null
            var d_levels: i32 = 0
            var d_base: i32 = emit_deref_operand_ptr(s, e.left.operand, @d_st, @d_levels)
            # AGAST #1940: `(*pp).n` with pp a `**S`: `*pp` is still a `*S`,
            # and `.n` auto-derefs it (ritz0 does the same).  Load once more.
            # AGAST #2372: as many times as it takes.
            if d_base != 0 and d_levels >= 2
                d_base = emit_load_levels(s, d_base, d_levels - 1)
                d_levels = 1
            if d_base != 0 and d_levels == 1
                let d_idx: i32 = find_field_index(d_st, e.ident_ptr, e.ident_len)
                if d_idx >= 0
                    let d_field: *StructField = get_field_type(d_st, d_idx)
                    emit_member_gep_from_ptr(s, result, d_base, d_st, d_idx, d_field)
                    return
        # AGAST #175: address-of wrapper, e.g. `(@srv.pool).active_count` —
        # the outer @ is a no-op for member access (the inner expression
        # already yields a pointer-to-struct under the unified value model).
        # Emit through the inner member chain to obtain the parent ptr, then
        # GEP into the inner struct for the requested field.  Without this,
        # the member access fell through to "; ERROR: unhandled EXPR_MEMBER"
        # and a stale `%.0` flowed into the icmp downstream.
        else if e.left.op == OP_ADDR or e.left.op == OP_ADDR_MUT
            if e.left.operand != null and e.left.operand.kind == EXPR_MEMBER
                var addr_inner: MemberPtrResult
                emit_member_ptr(s, e.left.operand, @addr_inner)
                if addr_inner.success == 1
                    let af: *StructField = addr_inner.field
                    if af.field_type == TYPE_STRUCT and af.field_type_name_len > 0
                        let inner_st: *StructDef = find_struct(s, af.field_type_name, af.field_type_name_len)
                        if inner_st != null
                            let fidx2: i32 = find_field_index(inner_st, e.ident_ptr, e.ident_len)
                            if fidx2 >= 0
                                let f2: *StructField = get_field_type(inner_st, fidx2)
                                emit_member_gep_from_ptr(s, result, addr_inner.reg, inner_st, fidx2, f2)
                                return
            else if e.left.operand != null and e.left.operand.kind == EXPR_IDENT
                let aloc: *LocalVar = find_local_struct_name(s, e.left.operand.ident_ptr, e.left.operand.ident_len)
                if aloc != null and aloc.var_type == TYPE_STRUCT and aloc.type_name_len > 0
                    let st_a: *StructDef = find_struct(s, aloc.type_name, aloc.type_name_len)
                    if st_a != null
                        let fidx_a: i32 = find_field_index(st_a, e.ident_ptr, e.ident_len)
                        if fidx_a >= 0
                            let fa: *StructField = get_field_type(st_a, fidx_a)
                            emit_member_gep_local(s, e, result, aloc, st_a, fidx_a, fa)
                            return

    # AGAST #2373: `(x as *S).f` auto-derefs the cast, as `(*(x as *S)).f`
    # does (#2526): emit_deref_operand_ptr resolves an `as *S` to S's address.
    # It fell to "unhandled EXPR_MEMBER in assignment", so the store failed.
    else if e.left.kind == EXPR_CAST
        var c_st: *StructDef = null
        var c_levels: i32 = 0
        let c_base: i32 = emit_deref_operand_ptr(s, e.left, @c_st, @c_levels)
        if c_base != 0 and c_levels == 1
            let c_idx: i32 = find_field_index(c_st, e.ident_ptr, e.ident_len)
            if c_idx >= 0
                emit_member_gep_from_ptr(s, result, c_base, c_st, c_idx, get_field_type(c_st, c_idx))
                return

    # Pointer arithmetic case: (ptr + offset).field - e.left is EXPR_BINARY
    else if e.left.kind == EXPR_BINARY
        # For pointer arithmetic like (p.tokens + p.pos).kind
        # Need to trace back to find the original pointer type
        # Could be: (member + n), (ident + n), or ((expr + n) + m)
        var base_expr: *Expr = e.left.left
        # Walk through cascaded binary ops to find the base
        while base_expr.kind == EXPR_BINARY
            base_expr = base_expr.left

        if base_expr.kind == EXPR_MEMBER
            # The MEMBER access gives us a pointer field - get the type from the field
            var inner_result: MemberPtrResult
            emit_member_ptr(s, base_expr, @inner_result)
            if inner_result.success == 1
                let inner_field: *StructField = inner_result.field
                # If the field is a pointer to a struct, we can use it
                if inner_field.field_type == TYPE_PTR and inner_field.field_type_name_len > 0
                    let st: *StructDef = find_struct(s, inner_field.field_type_name, inner_field.field_type_name_len)
                    if st != null
                        let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            # Evaluate the full binary expression to get the pointer
                            let ptr_val: i32 = emit_expr(s, e.left)
                            let base_ptr: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, base_ptr)
                            emit_str(s, c" = inttoptr i64 ")
                            emit_reg(s, ptr_val)
                            emit_str(s, c" to ptr\n")
                            emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                            return
        else if base_expr.kind == EXPR_IDENT
            # Direct identifier pointer arithmetic: (ptr_var + offset).field
            let loc: *LocalVar = find_local_struct_name(s, base_expr.ident_ptr, base_expr.ident_len)
            if loc != null
                if loc.var_type == TYPE_PTR and loc.type_name_len > 0
                    let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
                    if st != null
                        let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            # Evaluate the full binary expression to get the pointer
                            let ptr_val: i32 = emit_expr(s, e.left)
                            let base_ptr: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, base_ptr)
                            emit_str(s, c" = inttoptr i64 ")
                            emit_reg(s, ptr_val)
                            emit_str(s, c" to ptr\n")
                            emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                            return

    # Array element case: struct_array[idx].field
    # e.left is EXPR_INDEX, representing struct_array[idx]
    else if e.left.kind == EXPR_INDEX
        # AGAST #2440: `p[i].f` through a reference or pointer.
        if index_refused(s, e.left) == 1
            return
        if emit_through_member_ptr(s, e, result) == 1
            return
        # AGAST #2332: `a[i].f` / `a[i][j].f` with `a: [N]*S`, whatever holds
        # the array.  The field arm below took it for an inline `[N]S`.
        if emit_array_elem_member_ptr(s, e, result) == 1
            return
        # AGAST #1509: `g[i][j].field` over a multi-dimensional array of
        # structs.  Any other member access on an N-D base is left
        # unresolved, so the caller reports it instead of guessing.
        var nd_depth: i32 = 0
        let nd_sh: *ArrayShape = nd_index_shape(s, e.left, @nd_depth)
        if nd_sh != null
            if nd_depth == nd_sh.rank and nd_sh.leaf_type == TYPE_STRUCT
                let nd_st: *StructDef = find_struct(s, nd_sh.leaf_name, nd_sh.leaf_name_len)
                if nd_st != null
                    let nd_fidx: i32 = find_field_index(nd_st, e.ident_ptr, e.ident_len)
                    if nd_fidx >= 0
                        var nd_el: NdIndexPtr
                        emit_nd_index_ptr(s, e.left, @nd_el)
                        let nd_fp: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, nd_fp)
                        emit_str(s, c" = getelementptr %")
                        emit_name(s, nd_st.name, nd_st.name_len)
                        emit_str(s, c", ptr ")
                        emit_reg(s, nd_el.reg)
                        emit_str(s, c", i32 0, i32 ")
                        emit_int(s, nd_fidx as i64)
                        emit_str(s, c"\n")
                        result.reg = nd_fp
                        result.field = get_field_type(nd_st, nd_fidx)
                        result.success = 1
            return
        # e.left.left is the array expression (could be var.field for struct array field)
        # e.left.right is the index expression
        # First, we need to get the array element as a pointer
        # If left.left is EXPR_MEMBER, it's something like parser.pos_defs[idx]
        if e.left.left.kind == EXPR_MEMBER
            # Get pointer to the array field
            var inner_result: MemberPtrResult
            emit_member_ptr(s, e.left.left, @inner_result)
            if inner_result.success == 1
                let inner_field: *StructField = inner_result.field
                # The field should be an array type with struct elements
                # For arrays, the element type name is in array_elem_type_name, not field_type_name
                if inner_field.field_type == TYPE_ARRAY and inner_field.array_elem_type_name_len > 0
                    # Find the element struct type
                    let elem_st: *StructDef = find_struct(s, inner_field.array_elem_type_name, inner_field.array_elem_type_name_len)
                    if elem_st != null
                        let field_idx: i32 = find_field_index(elem_st, e.ident_ptr, e.ident_len)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(elem_st, field_idx)
                            # Emit index expression
                            let idx_reg: i32 = emit_expr(s, e.left.right)
                            # GEP into the array to get the element
                            let elem_ptr: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, elem_ptr)
                            emit_str(s, c" = getelementptr [")
                            emit_int(s, inner_field.array_size as i64)
                            emit_str(s, c" x %")
                            emit_name(s, elem_st.name, elem_st.name_len)
                            emit_str(s, c"], ptr ")
                            emit_reg(s, inner_result.reg)
                            emit_str(s, c", i64 0, i64 ")
                            emit_reg(s, idx_reg)
                            emit_str(s, c"\n")
                            # Now GEP into the element struct to get the field
                            emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
                            return
                # AGAST #184: `parent.fwd[i].field` where `fwd: **Foo` is a
                # pointer to an array of *Foo (skip-list / hash-bucket
                # pattern in tome.ritz's ZSetNode.forward).  Pre-fix this
                # fell through to "; ERROR: unhandled EXPR_MEMBER" and the
                # caller emitted `inttoptr i64 %.0 to ptr` (undef SSA).
                #
                # Lowering: load the field (a ptr to the *Foo array) →
                # GEP by index using ptr stride → load to materialise the
                # i-th *Foo → GEP into Foo for the requested member.
                else if inner_field.field_type == TYPE_PTR_PTR and inner_field.field_type_name_len > 0
                    let elem_st_pp: *StructDef = find_struct(s, inner_field.field_type_name, inner_field.field_type_name_len)
                    if elem_st_pp != null
                        let field_idx_pp: i32 = find_field_index(elem_st_pp, e.ident_ptr, e.ident_len)
                        if field_idx_pp >= 0
                            let field_pp: *StructField = get_field_type(elem_st_pp, field_idx_pp)
                            let arr_base: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, arr_base)
                            emit_str(s, c" = load ptr, ptr ")
                            emit_reg(s, inner_result.reg)
                            emit_str(s, c"\n")
                            let idx_pp: i32 = emit_expr(s, e.left.right)
                            let slot_ptr: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, slot_ptr)
                            emit_str(s, c" = getelementptr ptr, ptr ")
                            emit_reg(s, arr_base)
                            emit_str(s, c", i64 ")
                            emit_reg(s, idx_pp)
                            emit_str(s, c"\n")
                            let elem_ptr_pp: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, elem_ptr_pp)
                            emit_str(s, c" = load ptr, ptr ")
                            emit_reg(s, slot_ptr)
                            emit_str(s, c"\n")
                            emit_member_gep_from_ptr(s, result, elem_ptr_pp, elem_st_pp, field_idx_pp, field_pp)
                            return

        # Array-of-struct local variable: `let arr: [N]St; arr[i].field`.
        # Earlier this fell through to the generic emit_expr path which
        # produced "; ERROR: unhandled EXPR_MEMBER" because emit_member_ptr
        # didn't recognise EXPR_INDEX with an ident base.  Resolves the
        # zeus poll-loop case `poll_fds[0].revents`.
        else if e.left.left.kind == EXPR_IDENT
            let arr_loc: *LocalVar = find_local_struct_name(s, e.left.left.ident_ptr, e.left.left.ident_len)
            if arr_loc != null
                if arr_loc.var_type == TYPE_ARRAY and arr_loc.array_elem_type == TYPE_STRUCT and arr_loc.type_name_len > 0
                    let elem_st: *StructDef = find_struct(s, arr_loc.type_name, arr_loc.type_name_len)
                    if elem_st != null
                        let field_idx: i32 = find_field_index(elem_st, e.ident_ptr, e.ident_len)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(elem_st, field_idx)
                            let idx_reg: i32 = emit_expr(s, e.left.right)
                            let elem_ptr: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, elem_ptr)
                            emit_str(s, c" = getelementptr [")
                            emit_int(s, arr_loc.array_size as i64)
                            emit_str(s, c" x %")
                            emit_name(s, elem_st.name, elem_st.name_len)
                            emit_str(s, c"], ptr ")
                            emit_reg(s, arr_loc.reg)
                            emit_str(s, c", i64 0, i64 ")
                            emit_reg(s, idx_reg)
                            emit_str(s, c"\n")
                            emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
                            return
                # AGAST #184: `var arr: [N]*Foo; arr[i].field` — array of
                # pointer-to-struct.  Pre-fix this fell through to "; ERROR:
                # unhandled EXPR_MEMBER" then a wrong-byte-stride load using
                # an undef base.  Affects tome's `update[k].forward[k]` (the
                # value-read RHS of `new_node.forward[k] = update[k].forward[k]`).
                #
                # Lowering: GEP into the array to get the *Foo slot, load it
                # to materialise the *Foo, then GEP into Foo for the field.
                else if arr_loc.var_type == TYPE_ARRAY and (arr_loc.array_elem_type == TYPE_PTR or arr_loc.array_elem_type == TYPE_PTR_PTR) and arr_loc.type_name_len > 0
                    let elem_st_ap: *StructDef = find_struct(s, arr_loc.type_name, arr_loc.type_name_len)
                    if elem_st_ap != null
                        let field_idx_ap: i32 = find_field_index(elem_st_ap, e.ident_ptr, e.ident_len)
                        if field_idx_ap >= 0
                            let field_ap: *StructField = get_field_type(elem_st_ap, field_idx_ap)
                            let idx_reg_ap: i32 = emit_expr(s, e.left.right)
                            let slot_ap: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, slot_ap)
                            emit_str(s, c" = getelementptr [")
                            emit_int(s, arr_loc.array_size as i64)
                            emit_str(s, c" x ptr], ptr ")
                            emit_reg(s, arr_loc.reg)
                            emit_str(s, c", i64 0, i64 ")
                            emit_reg(s, idx_reg_ap)
                            emit_str(s, c"\n")
                            let elem_ptr_ap: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, elem_ptr_ap)
                            emit_str(s, c" = load ptr, ptr ")
                            emit_reg(s, slot_ap)
                            emit_str(s, c"\n")
                            emit_member_gep_from_ptr(s, result, elem_ptr_ap, elem_st_ap, field_idx_ap, field_ap)
                            return
                # AGAST #1908: `p[i].field` where p is a `*St` local or param
                # (ritzunit's `slots[i].pid`).  Same address as `(p + i).field`.
                else if arr_loc.var_type == TYPE_PTR and arr_loc.type_name_len > 0
                    if emit_ptr_elem_member_ptr(s, e, result, arr_loc.type_name, arr_loc.type_name_len) == 1
                        return
                # AGAST #1487: `w[i].field` where w is a Vec<Struct> local.
                else if emit_vec_elem_member_ptr(s, e, result, arr_loc) == 1
                    return
            # AGAST #190: same shape but the base is a global array of struct
            # (`var g_fallback: [100]FallbackPage; g_fallback[i].used`).
            # Without this branch find_local_struct_name returned null and
            # the path fell through to "; ERROR: unhandled EXPR_MEMBER" with
            # a stale `%.0` flowing into the icmp downstream.  Sits at the
            # same indent as `if arr_loc != null` so it doesn't tangle with
            # the local branches above.
            if arr_loc == null
                let g_arr: *GlobalVarDef = find_global(s, e.left.left.ident_ptr, e.left.left.ident_len)
                if g_arr != null
                    if g_arr.var_type == TYPE_ARRAY and g_arr.array_elem_type == TYPE_STRUCT and g_arr.array_elem_type_name_len > 0
                        let g_elem_st: *StructDef = find_struct(s, g_arr.array_elem_type_name, g_arr.array_elem_type_name_len)
                        if g_elem_st != null
                            let g_field_idx: i32 = find_field_index(g_elem_st, e.ident_ptr, e.ident_len)
                            if g_field_idx >= 0
                                let g_field: *StructField = get_field_type(g_elem_st, g_field_idx)
                                let g_idx_reg: i32 = emit_expr(s, e.left.right)
                                let g_elem_ptr: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, g_elem_ptr)
                                emit_str(s, c" = getelementptr [")
                                emit_int(s, g_arr.array_size as i64)
                                emit_str(s, c" x %")
                                emit_name(s, g_elem_st.name, g_elem_st.name_len)
                                emit_str(s, c"], ptr @")
                                emit_name(s, g_arr.name, g_arr.name_len)
                                emit_str(s, c", i64 0, i64 ")
                                emit_reg(s, g_idx_reg)
                                emit_str(s, c"\n")
                                emit_member_gep_from_ptr(s, result, g_elem_ptr, g_elem_st, g_field_idx, g_field)
                                return
                    # AGAST #1908: `g[i].field` where g is a `*St` global
                    # (ritzunit's `g_junit_results[i].name`).
                    if g_arr.var_type == TYPE_PTR and g_arr.pointee_type_name_len > 0
                        if emit_ptr_elem_member_ptr(s, e, result, g_arr.pointee_type_name, g_arr.pointee_type_name_len) == 1
                            return

        # AGAST #2870: `mkp()[i].field` with `mkp() -> *St`: element i of what
        # the call points at is a place, as ritz0 has it (`mk().a` isn't, and
        # stays with the by-value arm above).  The call is emitted once, as
        # the pointer emit_ptr_elem_member_ptr strides.
        else if e.left.left.kind == EXPR_CALL or e.left.left.kind == EXPR_METHOD
            var pc_name: *u8 = null
            var pc_len: i32 = 0
            call_result_pointee_struct(s, e.left.left, @pc_name, @pc_len)
            if pc_len > 0
                if emit_ptr_elem_member_ptr(s, e, result, pc_name, pc_len) == 1
                    return

# AGAST #1908: address of `p[i].field` for `e` = EXPR_MEMBER over EXPR_INDEX,
# where `p` (e.left.left) is a `*St` value and `st_name` names St.  The
# pointer is an i64 value in ritz1, so: inttoptr, GEP one St per index, then
# the field.  Returns 1 with `result` filled, or 0 if St or the field is
# unknown (the caller falls through to the "unhandled EXPR_MEMBER" error).
# AGAST #2332: address of `a[i].field` and `a[i][j].field` for `a: [N]*S`.
# Returns 1 when it took `e`.
fn emit_array_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    if array_elem_pointee(s, e.left.left, @name, @name_len) == TYPE_STRUCT
        return emit_ptr_elem_member_ptr(s, e, result, name, name_len)
    # AGAST #2369: and `a[i].f` with `a: [N]@S` or `[N]@&S`, whose element
    # refers to an S as a `*S` one points at it.
    if array_elem_pointee(s, e.left, @name, @name_len) != TYPE_STRUCT and array_elem_referent(s, e.left, @name, @name_len) != TYPE_STRUCT
        return 0
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if field_idx < 0
        return 0
    # A reference element may come back a `ptr` rather than an i64.
    let elem_ptr: i32 = i64_value_to_ptr(s, e.left, emit_expr(s, e.left))
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1

fn emit_ptr_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, st_name: *u8, st_name_len: i32) -> i32
    let st: *StructDef = find_struct(s, st_name, st_name_len)
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if field_idx < 0
        return 0
    let field: *StructField = get_field_type(st, field_idx)
    let ptr_val: i32 = emit_expr(s, e.left.left)
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let base_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base_ptr)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, ptr_val)
    emit_str(s, c" to ptr\n")
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, field)
    1


# =============================================================================
# Tagged-enum is_ok / is_err / is_some / is_none inline (AGAST #134 companion)
# =============================================================================

# Inline `.is_ok()` / `.is_err()` / `.is_some()` / `.is_none()` for Result$/
# Option$ receivers. Ritzlib's `result_is_ok<T,E>` is generic and isn't
# monomorphized in isolation, so without inlining the method resolves to an
# undefined extern. This mirrors try_emit_enum_unwrap's packed-i64 contract.
# Returns i64 register on success, -1 to fall through to emit_expr_method.
fn try_emit_enum_is_ok(s: *EmitterState, e: *Expr) -> i32
    # Receiver must be an ident bound to a Result$/Option$ local.
    if e.left == null
        return 0 - 1
    if e.left.kind != EXPR_IDENT
        return 0 - 1
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if loc == null
        return 0 - 1
    if is_tagged_enum_type(loc.type_name, loc.type_name_len) == 0
        return 0 - 1

    # Identify which predicate — only 0-arg forms apply.
    if e.args != null
        return 0 - 1
    var want_carrier: i32 = 0 - 1   # 1 = is_ok/is_some, 0 = is_err/is_none
    if e.ident_len == 5
        # "is_ok" = 105 115 95 111 107
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 111 and *(e.ident_ptr + 4) == 107
            want_carrier = 1
    if e.ident_len == 6
        # "is_err" / "is_err" = 105 115 95 101 114 114
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 101 and *(e.ident_ptr + 4) == 114 and *(e.ident_ptr + 5) == 114
            want_carrier = 0
    if e.ident_len == 7
        # "is_some" = 105 115 95 115 111 109 101
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 115 and *(e.ident_ptr + 4) == 111 and *(e.ident_ptr + 5) == 109 and *(e.ident_ptr + 6) == 101
            want_carrier = 1
        # "is_none" = 105 115 95 110 111 110 101
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 110 and *(e.ident_ptr + 4) == 111 and *(e.ident_ptr + 5) == 110 and *(e.ident_ptr + 6) == 101
            want_carrier = 0
    if want_carrier < 0
        return 0 - 1

    # Post-task-133 layout: Result$/Option$ is `{ i8 tag, [N x i8] payload }`.
    # Receiver slot holds that struct.  Pointer-typed locals (*T, @T) store a
    # pointer to the struct; load it through first to reach the aggregate.
    let ptr_reg: i32 = emit_load_levels(s, loc.reg, local_struct_levels(loc))

    # GEP to tag (field 0) and load the i8 directly.  Ok/Some = 0; Err/None = 1.
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, loc.type_name, loc.type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")

    # Carrier (Ok/Some) iff tag == 0; null (Err/None) iff tag != 0.
    let cmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp)
    if want_carrier == 1
        emit_str(s, c" = icmp eq i8 ")
    else
        emit_str(s, c" = icmp ne i8 ")
    emit_reg(s, tag)
    emit_str(s, c", 0  ; is_ok/is_err tag check\n")
    let wide: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, wide)
    emit_str(s, c" = zext i1 ")
    emit_reg(s, cmp)
    emit_str(s, c" to i64\n")
    return wide

# =============================================================================
# Try operator (AGAST #134)
# =============================================================================

# AGAST #1898: the Err / None carrier in `inner_slot` (a `%inner`), rebuilt
# as the enclosing fn's return type in a fresh slot, which is returned.  The
# tag byte is copied; for a Result the Err payload's bytes are copied field 2
# to field 2 — E's size when it can be measured, else the smaller payload.
fn emit_try_err_relayout(s: *EmitterState, inner_slot: i32, inner: *u8, inner_len: i32) -> i32
    let out_name: *u8 = s.ret_type_name
    let out_len: i32 = s.ret_type_name_len
    let out: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, out)
    emit_str(s, c" = alloca %")
    emit_name(s, out_name, out_len)
    emit_str(s, c"  ; try: Err relayout\n")
    emit_str(s, c"  store %")
    emit_name(s, out_name, out_len)
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, out)
    emit_str(s, c"\n")
    # Tag: field 0 of both.
    let tag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, inner_slot)
    emit_str(s, c"\n  store i8 ")
    emit_reg(s, tag)
    emit_str(s, c", ptr ")
    emit_reg(s, out)
    emit_str(s, c"\n")
    # Err payload bytes (Option's None carries none).
    var nbytes: i64 = 0
    if name_eq(out_name, 6, c"Result", 6) == 1 and name_eq(inner, 6, c"Result", 6) == 1
        var e_len: i32 = 0
        let e: *u8 = tagged_enum_arg(s, out_name, out_len, 1, @e_len)
        var e_align: i64 = 1
        if e != null
            nbytes = mangled_type_size_align(s, e, e_len, @e_align)
        if nbytes == 0
            var pad_in: i64 = 0
            var pad_out: i64 = 0
            nbytes = tagged_enum_layout(s, inner, inner_len, @pad_in)
            let n_out: i64 = tagged_enum_layout(s, out_name, out_len, @pad_out)
            if n_out < nbytes
                nbytes = n_out
    if nbytes > 0
        let src: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, src)
        emit_str(s, c" = getelementptr %")
        emit_name(s, inner, inner_len)
        emit_str(s, c", ptr ")
        emit_reg(s, inner_slot)
        emit_str(s, c", i32 0, i32 2\n")
        let dst: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, dst)
        emit_str(s, c" = getelementptr %")
        emit_name(s, out_name, out_len)
        emit_str(s, c", ptr ")
        emit_reg(s, out)
        emit_str(s, c", i32 0, i32 2\n")
        let bytes: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, bytes)
        emit_str(s, c" = load [")
        emit_int(s, nbytes)
        emit_str(s, c" x i8], ptr ")
        emit_reg(s, src)
        emit_str(s, c"\n  store [")
        emit_int(s, nbytes)
        emit_str(s, c" x i8] ")
        emit_reg(s, bytes)
        emit_str(s, c", ptr ")
        emit_reg(s, dst)
        emit_str(s, c"\n")
    out

# Lower `expr?`:
#   * On Some/Ok: extract payload from the carrier struct, continue with it.
#   * On None/Err: early-return the whole struct back to the caller.
#
# Post-task-133 layout: Result$/Option$ is `{ i8 tag, [N x i8] payload }` with
# tag 0 = Ok/Some (carrier) and tag 1 = Err/None.  The enclosing function's
# return type must also be Result$/Option$ with a matching error variant —
# the briefing for `?` already ensures that.  Because the Err/None encoding
# is byte-identical we can return the struct verbatim without a rebuild.
fn emit_expr_try(s: *EmitterState, e: *Expr) -> i32
    # Evaluate the inner Result/Option (yields a struct SSA register).
    let value: i32 = emit_expr(s, e.left)

    # Resolve the carrier's LLVM struct type name.  Prefer the inner
    # expression's declared type; fall back to the enclosing fn's return
    # type when the inner is opaque (same type by definition of `?`).
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    let have_inner: i32 = resolve_scrutinee_enum(s, e.left, @enum_name, @enum_name_len)
    if have_inner == 0
        enum_name = s.ret_type_name
        enum_name_len = s.ret_type_name_len

    # Spill the struct so we can GEP for tag + payload.
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c"  ; try: spill scrutinee\n")
    emit_str(s, c"  store %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c" ")
    emit_reg(s, value)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")

    # Load tag byte at field 0.
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    let tag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")

    # Ok/Some (tag == 0) → fall through to the Ok branch; else early-return.
    let tag_ok: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ok)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag)
    emit_str(s, c", 0  ; try: tag == carrier\n")

    let ok_label: i32 = next_label(s)
    let err_label: i32 = next_label(s)

    emit_str(s, c"  br i1 ")
    emit_reg(s, tag_ok)
    emit_str(s, c", label %")
    emit_label(s, ok_label)
    emit_str(s, c", label %")
    emit_label(s, err_label)
    emit_str(s, c"\n")

    # Err/None branch: early-return the carrier as the enclosing fn's
    # return type.  AGAST #1898: inner (e.g. Result$Big$i32) and outer
    # (Result$i32$i32) are laid out per instantiation like ritz0's, so the
    # Err payload's offset depends on the Ok type: unless the two names
    # match, rebuild the outer value — zeroed, tag copied, E's bytes copied
    # payload to payload — rather than reinterpreting the inner bytes.
    begin_block(s, err_label)
    var ret_slot: i32 = slot
    if is_tagged_enum_type(enum_name, enum_name_len) == 1 and is_tagged_enum_type(s.ret_type_name, s.ret_type_name_len) == 1 and name_eq(enum_name, enum_name_len, s.ret_type_name, s.ret_type_name_len) == 0
        ret_slot = emit_try_err_relayout(s, slot, enum_name, enum_name_len)
    if s.ret_sret == 1
        # AGAST #1730 — never taken today (tagged enums keep their ABI; see
        # struct_ret_uses_sret), but a `ret %T` in an sret fn is invalid IR.
        emit_sret_ret_from_ptr(s, ret_slot)
    else
        let ret_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ret_reg)
        emit_str(s, c" = load %")
        emit_name(s, s.ret_type_name, s.ret_type_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, ret_slot)
        emit_str(s, c"\n")
        emit_str(s, c"  ret %")
        emit_name(s, s.ret_type_name, s.ret_type_name_len)
        emit_str(s, c" ")
        emit_reg(s, ret_reg)
        emit_str(s, c"\n")

    # Ok/Some branch: load the payload from field 2 (#1898).  For scalar payloads,
    # emit_variant_struct stores them as i64 so an i64 load is fine.  For
    # struct payloads (e.g., Result<Vec<u8>, E>'s Ok holds a 24-byte
    # %Vec$u8), an i64 load truncates to 8 bytes — corrupting the value.
    # Detect Result$<Struct>... / Option$<Struct> with
    # tagged_enum_payload_struct.  When found, load that struct type directly.
    begin_block(s, ok_label)
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 2\n")

    # The Ok/Some payload's struct or user-enum type, if any (e.g.
    # "Result$Vec$u8$E" → "Vec$u8"; "Option$Opt" → "Opt"; "Option$i32" →
    # none).  AGAST #2105: a user enum is stored as its aggregate (#1466),
    # so it loads as one, exactly as the match-bind side does (#2100).
    var pay_name_len: i32 = 0
    let pay_name: *u8 = tagged_enum_payload_named(s, enum_name, enum_name_len, @pay_name_len, 1)

    if pay_name == null
        # Scalar payload at its own width (AGAST #1898), widened to i64.
        return emit_tagged_payload_load(s, pay_ptr, enum_name, enum_name_len, 0)
    # Aggregate payload — load the actual type so the 24-byte (or larger)
    # value is preserved for the caller's let-decl / arg coercion.
    let payload: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, payload)
    emit_str(s, c" = load %")
    emit_name(s, pay_name, pay_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"  ; try: unwrap struct payload\n")
    return payload

# =============================================================================
# Expression Emission - Single function to avoid mutual recursion
# =============================================================================

fn emit_expr(s: *EmitterState, e: *Expr) -> i32
    # Safety check for null expression
    if e == null
        eprints_cstr(c"ERROR: emit_expr called with null expression!\n")
        return 0
    if e.kind == EXPR_INT_LIT
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, e.int_val)
        emit_str(s, c"\n")
        return result

    else if e.kind == EXPR_FLOAT_LIT
        # Float literal: emit as a `double` constant via `fadd 0.0, <lit>`.
        # We default to double — narrowing to float happens at the call/store
        # site via fptrunc when the target type is f32.  The raw decimal
        # repr from the source is reused verbatim; LLVM accepts standard
        # decimal float literals (e.g. `1.5`, `3.14`).
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = fadd double 0.0, ")
        emit_name(s, e.string_ptr, e.string_len)
        emit_str(s, c"\n")
        return result

    else if e.kind == EXPR_CHAR_LIT
        # Character literals: emit as i8 value, then extend to i64 for uniformity
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, e.int_val)  # int_val holds the char's ASCII value
        emit_str(s, c"\n")
        return result

    else if e.kind == EXPR_IDENT
        return emit_expr_ident(s, e)
    else if e.kind == EXPR_BINARY
        return emit_expr_binary(s, e)
    else if e.kind == EXPR_UNARY
        return emit_expr_unary(s, e)
    else if e.kind == EXPR_CALL
        # A call registered in si_once runs once; its second emission reuses
        # the first's register. Two users:
        #   - a Vec view's low bound, in both of its fields (AGAST #2501);
        #   - a call in the place of `x op= v`, shared by its read and its
        #     store (monomorph.ritz note_compound_calls, AGAST #2529).
        let call_once: i32 = si_once_find(e)
        if call_once >= 0
            let call_prev: i32 = si_once_take(call_once)
            if call_prev >= 0
                return call_prev
        let call_reg: i32 = emit_expr_call(s, e)
        own_note_temp(s, e, call_reg)   # AGAST #2165: a temporary's drop
        if call_once >= 0
            si_once_set(call_once, call_reg)
        return call_reg
    else if e.kind == EXPR_INDEX
        if e.right != null and e.right.kind != EXPR_RANGE
            bool_check_index(s, e.right)   # AGAST #2342
        return emit_expr_index(s, e)
    else if e.kind == EXPR_CAST
        bool_check_cast(s, e)   # AGAST #2342
        literal_cast(s, e)      # AGAST #2341
        # `expr as <type>` — `e.op` holds the target type kind.
        # Float ↔ int needs explicit instructions (sitofp / fptosi /
        # fptrunc / fpext); same-class casts pass through as i64 wraps
        # (the unified value model already keeps narrow ints in i64).
        let target_ty: i32 = e.op
        if struct_cast_to_int_refused(s, e) == 1   # AGAST #3008
            return 0
        # AGAST #2288: `c as C` with `c:& C` is the referent, as in ritz0.
        # It read as the pointer and ptrtoint'd it.
        if target_ty == TYPE_STRUCT and e.ident_len > 0 and lent_referent_local(s, e.left) != null
            let referent: i32 = emit_lent_referent(s, e.left, e.ident_ptr, e.ident_len)
            if referent != 0
                return referent
        # AGAST #3004: `r as C` with `r: @C`, `@&C` or `*C` is a copy of the
        # referent, as in ritz0.  It emitted `r`'s address as the `%C`.
        if target_ty == TYPE_STRUCT and ref_cast_reads_referent(s, e) == 1
            let ref_addr: i32 = i64_value_to_ptr(s, e.left, emit_expr(s, e.left))
            let ref_val: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ref_val)
            emit_str(s, c" = load ")
            emit_llvm_type_struct(s, TYPE_STRUCT, e.ident_ptr, e.ident_len)
            emit_str(s, c", ptr ")
            emit_reg(s, ref_addr)
            emit_str(s, c"\n")
            return ref_val
        # AGAST #1652: `s as *S` with `s: @&S` (a `ptr`) must yield the i64
        # address the rest of the value model expects; only `as @&T` keeps it.
        # AGAST #1754: and `p as @&S` (`p: *S`, i64) must inttoptr into the
        # `ptr` an `@&T` is lowered as.
        let cast_raw: i32 = emit_expr(s, e.left)
        var cast_src: i32 = cast_raw
        if target_ty != TYPE_MUT_REF
            cast_src = ptr_value_to_i64(s, e.left, cast_raw)
        else
            cast_src = i64_value_to_ptr(s, e.left, cast_raw)
        var src_name: *u8 = null
        var src_name_len: i32 = 0
        if e.left.kind == EXPR_IDENT
            let lv2: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
            if lv2 != null
                src_name = lv2.type_name
                src_name_len = lv2.type_name_len
        var src_ty: i32 = get_expr_type(s, e.left)
        # An enum's discriminant (LANGUAGE_SPEC §10.4), at its representation
        # type: the int → int path below wraps it to the target.
        var enum_src_ty: i32 = 0
        let enum_disc: i32 = emit_enum_to_int(s, e, cast_raw, @enum_src_ty)
        if enum_disc != 0 - 1
            cast_src = enum_disc
            src_ty = enum_src_ty
            src_name = null
            src_name_len = 0
        let src_is_float: i32 = is_float_type(src_ty, src_name, src_name_len)
        let dst_is_float: i32 = is_float_type(target_ty, null, 0)
        if src_is_float == 1 and dst_is_float == 0
            # Float → int: saturating, by the target's signedness (§7.5,
            # AGAST #2192).  A bare fptosi to i8/i16 also left an iN where the
            # unified model wants an i64, and the IR didn't link.
            var ft: i32 = TYPE_F64
            if src_ty == TYPE_F32
                ft = TYPE_F32
            return emit_float_to_int_sat(s, ft, cast_src, target_ty)
        if src_is_float == 0 and dst_is_float == 1
            # Int → float.  Source is i64 in the unified model, where a narrow
            # unsigned value is zero-extended and so non-negative; a u64 with
            # its top bit set is not, and sitofp made it negative (#2192).
            var src_uns: i32 = 0
            if enum_disc == 0 - 1
                int_operand_shape(s, e.left, @src_uns)
            let r: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, r)
            if src_uns == 1
                emit_str(s, c" = uitofp i64 ")
            else
                emit_str(s, c" = sitofp i64 ")
            emit_reg(s, cast_src)
            emit_str(s, c" to ")
            emit_llvm_type(s, target_ty)
            emit_str(s, c"\n")
            return r
        if src_is_float == 1 and dst_is_float == 1
            # f32 ↔ f64
            if src_ty == TYPE_F64 and target_ty == TYPE_F32
                let r: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, r)
                emit_str(s, c" = fptrunc double ")
                emit_reg(s, cast_src)
                emit_str(s, c" to float\n")
                return r
            if src_ty == TYPE_F32 and target_ty == TYPE_F64
                let r: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, r)
                emit_str(s, c" = fpext float ")
                emit_reg(s, cast_src)
                emit_str(s, c" to double\n")
                return r
            return cast_src
        # int → int (AGAST #1602).  Values live in i64 registers, held
        # sign/zero-extended per their own type, so the cast must wrap to
        # an effective width and re-extend.  ritz0's rule: narrowing (or
        # same width) truncates to the target and the result is read with
        # the TARGET's signedness; widening extends from the SOURCE width,
        # zext if either side is unsigned, sext only if both are signed.
        # A non-int-primitive side (bool, pointer, enum, unknown) counts as
        # signed 64-bit; a non-int target (bool, ptr, ...) passes through.
        let dst_bits: i32 = int_prim_bits(target_ty)
        if dst_bits == 0
            return cast_src
        var src_bits: i32 = int_prim_bits(src_ty)
        var src_signed: i32 = int_prim_signed(src_ty)
        if src_bits == 0
            src_bits = 64
            src_signed = 1
        var w: i32 = dst_bits
        var signed: i32 = int_prim_signed(target_ty)
        if src_bits < dst_bits
            w = src_bits
            signed = src_signed * int_prim_signed(target_ty)
        if w == 64
            return cast_src
        let narrow: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, narrow)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, cast_src)
        emit_str(s, c" to i")
        emit_int(s, w as i64)
        emit_str(s, c"\n")
        let wide: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, wide)
        if signed == 1
            emit_str(s, c" = sext i")
        else
            emit_str(s, c" = zext i")
        emit_int(s, w as i64)
        emit_str(s, c" ")
        emit_reg(s, narrow)
        emit_str(s, c" to i64\n")
        return wide

    else if e.kind == EXPR_NIL_LIT
        # nil literal - emit as null pointer (0)
        let zero: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, zero)
        emit_str(s, c" = add i64 0, 0  ; nil\n")
        return zero

    else if e.kind == EXPR_CSTRING_LIT
        # c"..." lowers to *u8 (null-terminated). Emitted here as a GEP to the
        # first element, cast to i64 for downstream integer-flavoured consumers.
        let str_idx: i32 = add_string(s, e.string_ptr, e.string_len)
        let gep_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, gep_reg)
        emit_str(s, c" = getelementptr [")
        emit_int(s, (e.string_len + 1) as i64)
        emit_str(s, c" x i8], ptr @.str.")
        emit_int(s, str_idx as i64)
        emit_str(s, c", i64 0, i64 0\n")
        let ptr_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr_reg)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, gep_reg)
        emit_str(s, c" to i64\n")
        return ptr_reg

    else if e.kind == EXPR_STRING_LIT
        # Bare "..." lowers to a %Span$u8 aggregate { ptr: *u8, len: i64 } —
        # the StrView-shaped view (AGAST #98). Zero allocation: the payload
        # is an @.str global and length is known at compile time. %Span$u8 is
        # supplied by ensure_string_literal_struct when the source does not
        # define it, so no import is required.
        # StrView (ritzlib.strview) has identical layout, so call-site
        # coercion rebuilds the aggregate under the StrView name.
        let str_idx: i32 = add_string(s, e.string_ptr, e.string_len)
        let gep_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, gep_reg)
        emit_str(s, c" = getelementptr [")
        emit_int(s, (e.string_len + 1) as i64)
        emit_str(s, c" x i8], ptr @.str.")
        emit_int(s, str_idx as i64)
        emit_str(s, c", i64 0, i64 0\n")
        # Build %Span$u8 via insertvalue: { ptr, len }
        let sv1: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sv1)
        emit_str(s, c" = insertvalue %Span$u8 undef, ptr ")
        emit_reg(s, gep_reg)
        emit_str(s, c", 0\n")
        let sv2: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sv2)
        emit_str(s, c" = insertvalue %Span$u8 ")
        emit_reg(s, sv1)
        emit_str(s, c", i64 ")
        emit_int(s, e.string_len as i64)
        emit_str(s, c", 1\n")
        return sv2

    else if e.kind == EXPR_STRUCT_LIT
        # Struct literal as an rvalue: TypeName { field: value, ... }
        # (e.ident_ptr/ident_len = struct type name, e.args = FieldInit list).
        # let/var, return, reassignment, nested-field and receiver literals
        # are written straight into their destination slot elsewhere. Every
        # other position (fn/method arg, variant-ctor payload, `[T{..}; N]`
        # element) lands here: fill a temp through the shared field-store
        # loop, then yield the loaded `%T` aggregate. (AGAST #1362)
        return emit_struct_lit_value(s, e)

    else if e.kind == EXPR_MEMBER
        return emit_expr_member(s, e)
    else if e.kind == EXPR_METHOD
        # Inline predicate intrinsics for Result$/Option$ (AGAST #134): the
        # ritzlib `result_is_ok<T,E>` / `option_is_some<T>` generics aren't
        # monomorphized in isolation, so method dispatch would resolve to an
        # undefined extern. Fall through to emit_expr_method for anything
        # that isn't a tagged-enum predicate.
        let pred_reg: i32 = try_emit_enum_is_ok(s, e)
        if pred_reg >= 0
            return pred_reg
        # `m[k] op= x` on a struct: its `index_mut` call is shared by the
        # store and the read, and runs once (struct_index.ritz, AGAST #1635).
        let once: i32 = si_once_find(e)
        if once >= 0
            let prev: i32 = si_once_take(once)
            if prev >= 0
                return prev
            let first: i32 = emit_expr_method(s, e)
            own_note_temp(s, e, first)   # AGAST #2262: a temporary's drop
            si_once_set(once, first)
            return first
        let method_reg: i32 = emit_expr_method(s, e)
        own_note_temp(s, e, method_reg)   # AGAST #2262: a temporary's drop
        return method_reg
    else if e.kind == EXPR_MATCH
        # Match expression — scrutinee in `left`, arms in `args` (recast).
        let arms: *MatchArm = e.args as *MatchArm
        return emit_match(s, e.left, arms, e.span)
    else if e.kind == EXPR_IF
        # If/else expression (AGAST #1613) — see emit_if_expr.
        return emit_if_expr(s, e)
    else if e.kind == EXPR_TRY
        return emit_expr_try(s, e)

    else if e.kind == EXPR_ARRAY_FILL
        # Array fill `[v; N]` with no `[N]T` slot to build in.  Every slot that
        # has one lowers the fill itself (emit_array_fill_into: a typed or
        # inferred `let`, a field, an assignment).  This arm built a shadow
        # `[N x i64]` and returned its ADDRESS as the value, so whatever took it
        # (an enum or Option payload, an untyped pointer-element `let`) silently
        # read garbage.  AGAST #3014: fail closed, located, instead.
        return emit_array_no_slot_error(s, e)

    else if e.kind == EXPR_ARRAY_LIT
        # Array literal `[e1, e2, ...]` in value position: a slot with an
        # `[N]T` (a typed or inferred `let`, a field, an assignment) lowers it
        # itself, with emit_array_lit_into.  (ritz-task-102)
        # AGAST #2266: a literal of struct T is a `[N x %T]`, its elements
        # stored at %T (an i64 store of a %T was invalid IR), and one nobody
        # takes drops them (own_note_array_temp).
        var sel_name: *u8 = null
        var sel_len: i32 = 0
        let sel_n: i32 = array_lit_struct_elem(s, e, @sel_name, @sel_len)
        if sel_n > 0
            let sarr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, sarr)
            emit_str(s, c" = alloca [")
            emit_int(s, sel_n as i64)
            emit_str(s, c" x %")
            emit_name(s, sel_name, sel_len)
            emit_str(s, c"]  ; array literal\n")
            emit_array_lit_into(s, sarr, sel_n, TYPE_STRUCT, sel_name, sel_len, e)
            own_note_array_temp(s, e, sarr)
            let spti: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, spti)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, sarr)
            emit_str(s, c" to i64\n")
            return spti
        # AGAST #3014: a scalar literal with no `[N]T` slot: as EXPR_ARRAY_FILL.
        return emit_array_no_slot_error(s, e)

    emit_ir_error(s, c"unknown expression kind")
    let zero: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, zero)
    emit_str(s, c" = add i64 0, 0\n")
    zero

# AGAST #3014: an array literal or fill of scalars that reached emit_expr has no
# `[N]T` slot, and emit_expr has no type to build one at.  ritz1 used to build
# a shadow `[N x i64]` and return its address, a silent wrong value.
fn emit_array_no_slot_error(s: *EmitterState, e: *Expr) -> i32
    emit_nd_error(s, e.span.line, e.span.col, c"ritz1 cannot build this array literal here: it has no `[N]T` slot (give it one, e.g. `let a: [2]u8 = [..]`)")
    let zero: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, zero)
    emit_str(s, c" = add i64 0, 0\n")
    zero

# =============================================================================
# Array Fill Lowering
# =============================================================================

# Write `[fill_val; arr_size]` into the `[arr_size x elem_ty]` storage at
# `base_reg` (a `ptr` register: a local alloca or a struct-field GEP).
#
# Strategy (mirrors ritz0):
#   * Zero fill (e.g. `[0; 65536]`)  -> llvm.memset
#   * Small N (<= 16)                 -> straight-line unrolled stores
#   * Otherwise                       -> a real LLVM loop
# Unrolling [0; 65536] would emit 65536 GEP+store pairs — clang -O2
# then spends minutes folding it.  (AGAST #178)
#
# Shared by `let buf: [N]T = [v; N]` (emit_var_decl) and by `[v; N]` as an
# array field of a struct literal (emit_var_decl's struct-literal loop and
# emit_struct_lit_to_alloca).  The latter used to go through emit_expr's
# EXPR_ARRAY_FILL fallback, which builds a shadow `[N x i64]` alloca and
# returns its ADDRESS — stored as an i64 over the field's first slots, with
# the fill value never reaching the field at all.  (AGAST #1605)
# Store the `%T` aggregate `agg` into every slot of the `[N x %T]` array at
# `base_reg`. Always a counted loop: clang unrolls the small ones, and a
# large struct array stays O(1) in IR size. (AGAST #1362)
fn emit_array_fill_struct_loop(s: *EmitterState, base_reg: i32, arr_size: i32, st: *StructDef, agg: i32)
    let idx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, idx)
    emit_str(s, c" = alloca i32\n")
    emit_str(s, c"  store i32 0, ptr ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    let l_cond: i32 = next_label(s)
    let l_body: i32 = next_label(s)
    let l_end: i32 = next_label(s)
    emit_str(s, c"  br label %")
    emit_label(s, l_cond)
    emit_str(s, c"\n")
    begin_block(s, l_cond)
    let cur: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cur)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    let cmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp)
    emit_str(s, c" = icmp ult i32 ")
    emit_reg(s, cur)
    emit_str(s, c", ")
    emit_int(s, arr_size as i64)
    emit_str(s, c"\n")
    emit_str(s, c"  br i1 ")
    emit_reg(s, cmp)
    emit_str(s, c", label %")
    emit_label(s, l_body)
    emit_str(s, c", label %")
    emit_label(s, l_end)
    emit_str(s, c"\n")
    begin_block(s, l_body)
    let ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ep)
    emit_str(s, c" = getelementptr [")
    emit_int(s, arr_size as i64)
    emit_str(s, c" x %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c"], ptr ")
    emit_reg(s, base_reg)
    emit_str(s, c", i32 0, i32 ")
    emit_reg(s, cur)
    emit_str(s, c"\n")
    emit_str(s, c"  store %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c" ")
    emit_reg(s, agg)
    emit_str(s, c", ptr ")
    emit_reg(s, ep)
    emit_str(s, c"\n")
    let inc: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, inc)
    emit_str(s, c" = add i32 ")
    emit_reg(s, cur)
    emit_str(s, c", 1\n")
    emit_str(s, c"  store i32 ")
    emit_reg(s, inc)
    emit_str(s, c", ptr ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    emit_str(s, c"  br label %")
    emit_label(s, l_cond)
    emit_str(s, c"\n")
    begin_block(s, l_end)

# AGAST #2062 (moved from emitter_stmt by #2065): `val_reg` = emit_expr(value), stored into an f32 / f64 slot of
# type `dst_ty`.  An integer-typed value (`var x: f64 = 3`, `*p = n`) is the
# i64 every integer is carried in: convert it to the slot's float width by
# int_into_float_slot (exact sources only, by signedness, #2945).  Returns val_reg otherwise —
# float values keep their existing narrowing at the call site.  clang
# rejected the `store double %<i64>` this used to emit.
fn int_to_float_slot(s: *EmitterState, val_reg: i32, dst_ty: i32, value: *Expr) -> i32
    if expr_is_definitely_int(s, value) == 1
        return int_into_float_slot(s, val_reg, value, dst_ty)
    val_reg

fn is_int_ty(t: i32) -> i32
    if t == TYPE_I64 or t == TYPE_I32 or t == TYPE_I16 or t == TYPE_I8 or t == TYPE_U64 or t == TYPE_U32 or t == TYPE_U16 or t == TYPE_U8
        return 1
    0

# Is `e` KNOWN to produce an integer register?  get_expr_type cannot answer
# that: TYPE_I64 is also its fallback for anything it can't type, e.g. a
# float method on an rvalue receiver (`Pt { .. }.scale(2.0)`, gate failure
# test_issue_method_autoborrow_rvalue).  So only forms whose type is
# resolved, not defaulted, count; anything else is left unconverted.  A
# `match` / `if` is never "definitely int": under a float hint
# (set_match_float_hint) its integer arms were already converted.
fn expr_is_definitely_int(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_CHAR_LIT
        return 1
    if e.kind == EXPR_IDENT
        if find_local_idx(s, e.ident_ptr, e.ident_len) >= 0 or find_global(s, e.ident_ptr, e.ident_len) != null
            return is_int_ty(get_expr_type(s, e))
        return 0
    if e.kind == EXPR_CAST
        return is_int_ty(e.op)
    if e.kind == EXPR_CALL
        if call_is_named_syscall_builtin(s, e) == 1 or find_call_fn(s, e) != null
            return is_int_ty(get_expr_type(s, e))
        return 0
    if e.kind == EXPR_MEMBER
        if member_field_def(s, e) != null
            return is_int_ty(get_expr_type(s, e))
        return 0
    if e.kind == EXPR_UNARY and e.op == OP_NEG
        return expr_is_definitely_int(s, e.operand)
    if e.kind == EXPR_BINARY
        if e.op == OP_ADD or e.op == OP_SUB or e.op == OP_MUL or e.op == OP_DIV or e.op == OP_MOD or e.op == OP_BIT_AND or e.op == OP_BIT_OR or e.op == OP_BIT_XOR or e.op == OP_SHL or e.op == OP_SHR
            if expr_is_definitely_int(s, e.left) == 1 and expr_is_definitely_int(s, e.right) == 1
                return 1
    0

# The register to store for one bool / f32 / f64 element of a STRUCT FIELD
# array (`[N x i1]` / `[N x float]` / `[N x double]`, see
# field_array_elem_llvm), or one f32 / f64 element of a LOCAL array (#1966):
# narrowed exactly as emit_struct_lit_field_store narrows a scalar field of
# that type.  `val_reg` is emit_expr(value).  AGAST #1935.
fn emit_field_elem_narrow(s: *EmitterState, val_reg: i32, elem_ty: i32, value: *Expr) -> i32
    if elem_ty == TYPE_BOOL
        if bool_reg_is_i1(s, value) == 1
            return val_reg
        let t1: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, t1)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c" to i1\n")
        return t1
    # AGAST #2065: an integer value into a float slot (`R { a: 3 }`,
    # `r.a = 3`, `p[i] = 3`, `x = 3`) is sitofp'd; it stored the i64.
    if elem_ty == TYPE_F32 or elem_ty == TYPE_F64
        if expr_is_definitely_int(s, value) == 1
            return int_into_float_slot(s, val_reg, value, elem_ty)
    if elem_ty == TYPE_F32 and get_expr_type(s, value) == TYPE_F64
        let tf: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, tf)
        emit_str(s, c" = fptrunc double ")
        emit_reg(s, val_reg)
        emit_str(s, c" to float\n")
        return tf
    val_reg

# The register to `ret` for `value` (already emitted into `val_reg`) from a fn
# returning `ret_type`.  AGAST #2074: a float literal is always a `double`, so
# `1.0` / `return 1.0` from an `-> f32` fn is fptrunc'd (and an integer value
# sitofp'd) exactly as a store into an f32 slot is.  Shared by the implicit
# tail returns (emit_fn / emit_impl_method) and the explicit `return`
# (emit_return).  Any non-float return type passes `val_reg` through.
pub fn float_ret_value(s: *EmitterState, val_reg: i32, ret_type: i32, value: *Expr) -> i32
    if ret_type == TYPE_F32 or ret_type == TYPE_F64
        return emit_field_elem_narrow(s, val_reg, ret_type, value)
    val_reg

# 1 when an element of `[N]elem_ty` is stored with emit_field_elem_narrow at
# `float` / `double` / `i1` width: every f32 / f64 / bool array, field or
# local (#1966; bool locals are `i1` since #2063).
fn array_elem_typed_scalar(elem_ty: i32) -> i32
    if elem_ty == TYPE_F32 or elem_ty == TYPE_F64 or elem_ty == TYPE_BOOL
        return 1
    0

# Write `[v; arr_size]` into the array at `base_reg`, a local array or an
# inline STRUCT FIELD array: both share one element layout (bool `i1`,
# f32 / f64 `float` / `double`; array_elem_typed_scalar).  `elem_name` names a
# struct element's type (AGAST #2288).
fn emit_array_fill_into(s: *EmitterState, base_reg: i32, arr_size: i32, elem_ty: i32, elem_name: *u8, elem_name_len: i32, fill_val: *Expr)
    let fill_elem_ty: i32 = elem_ty
    let fill_arr_size: i32 = arr_size
    var fill_elem_llvm: *u8 = c"i64"
    var fill_elem_bytes: i32 = 8
    if fill_elem_ty == TYPE_I32 or fill_elem_ty == TYPE_U32
        fill_elem_llvm = c"i32"
        fill_elem_bytes = 4
    else if fill_elem_ty == TYPE_U8 or fill_elem_ty == TYPE_I8
        fill_elem_llvm = c"i8"
        fill_elem_bytes = 1
    else if fill_elem_ty == TYPE_U16 or fill_elem_ty == TYPE_I16
        fill_elem_llvm = c"i16"
        fill_elem_bytes = 2
    else if fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR
        fill_elem_llvm = c"ptr"
        fill_elem_bytes = 8
    var field_scalar: i32 = 0
    if array_elem_typed_scalar(fill_elem_ty) == 1
        field_scalar = 1
        fill_elem_llvm = field_array_elem_llvm(fill_elem_ty)
        if fill_elem_ty == TYPE_BOOL
            fill_elem_bytes = 1
        else if fill_elem_ty == TYPE_F32
            fill_elem_bytes = 4
    # `[T { .. }; N]`: the element is the literal's own struct type, stored
    # as a `%T` aggregate built once by the rvalue lowering. (AGAST #1362)
    if fill_val != null and fill_val.kind == EXPR_STRUCT_LIT
        let lit_st: *StructDef = find_struct(s, fill_val.ident_ptr, fill_val.ident_len)
        if lit_st != null
            let agg: i32 = emit_struct_lit_value(s, fill_val)
            emit_array_fill_struct_loop(s, base_reg, fill_arr_size, lit_st, agg)
            return
    # AGAST #2288: `[c; N]` with `c:& C` into a `[N]C` fills with the referent,
    # as in ritz0.  It stored the pointer as an i64.
    if elem_ty == TYPE_STRUCT and lent_referent_local(s, fill_val) != null
        let lent_st: *StructDef = find_struct(s, elem_name, elem_name_len)
        if lent_st != null
            let referent: i32 = emit_lent_referent(s, fill_val, elem_name, elem_name_len)
            if referent != 0
                emit_array_fill_struct_loop(s, base_reg, fill_arr_size, lent_st, referent)
                return
    # AGAST #2976: `[c; N]` of any other struct value into a `[N]C` (a local, a
    # param, a call result, an element or field, a generic `T` at a struct) is
    # the `%C` aggregate emit_expr yields, evaluated once and stored into every
    # `%C` slot. It fell through to the scalar path below: `store i64 <%C>` into
    # `[N x i64]` slots, which clang rejects.
    if elem_ty == TYPE_STRUCT and fill_val != null
        let val_st: *StructDef = find_struct(s, elem_name, elem_name_len)
        if val_st != null
            let val_agg: i32 = emit_expr(s, fill_val)
            emit_array_fill_struct_loop(s, base_reg, fill_arr_size, val_st, val_agg)
            return
    # Fast path: integer-literal zero fill — collapse to memset.
    # Detect EXPR_INT_LIT with int_val == 0 (common case for
    # squeeze's `[0; 65536]` lz_symbols arrays) and EXPR_UNARY
    # OP_NEG over int 0.  Anything else falls into the loop path.
    var fill_is_zero_lit: i32 = 0
    if fill_val != null and fill_val.kind == EXPR_INT_LIT and fill_val.int_val == 0
        fill_is_zero_lit = 1
    if fill_is_zero_lit == 1
        emit_str(s, c"  call void @llvm.memset.p0.i64(ptr ")
        emit_reg(s, base_reg)
        emit_str(s, c", i8 0, i64 ")
        emit_int(s, (fill_arr_size * fill_elem_bytes) as i64)
        emit_str(s, c", i1 false)\n")
        return
    # Evaluate the fill value ONCE — even if it's a function call we
    # only want to invoke it once. Its i64 SSA result is reused for
    # every store.
    let fill_val_reg: i32 = emit_expr(s, fill_val)
    # Pre-truncate the value to the element width so we don't
    # re-emit the trunc inside the loop body (and so a pointer
    # element type gets one inttoptr we can reuse).
    var fill_narrow: i32 = fill_val_reg
    if field_scalar == 1
        fill_narrow = emit_field_elem_narrow(s, fill_val_reg, fill_elem_ty, fill_val)
    else if fill_elem_ty == TYPE_U8 or fill_elem_ty == TYPE_I8
        let t8: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, t8)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, fill_val_reg)
        emit_str(s, c" to i8\n")
        fill_narrow = t8
    else if fill_elem_ty == TYPE_U16 or fill_elem_ty == TYPE_I16
        let t16: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, t16)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, fill_val_reg)
        emit_str(s, c" to i16\n")
        fill_narrow = t16
    else if fill_elem_ty == TYPE_I32 or fill_elem_ty == TYPE_U32
        let t32: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, t32)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, fill_val_reg)
        emit_str(s, c" to i32\n")
        fill_narrow = t32
    else if (fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR) and expr_is_ptr_valued(s, fill_val) == 1
        fill_narrow = fill_val_reg   # AGAST #3029: `@&x` is a `ptr` already
    else if fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR
        let tp: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, tp)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, fill_val_reg)
        emit_str(s, c" to ptr\n")
        fill_narrow = tp
    else if fill_elem_ty == TYPE_REF or fill_elem_ty == TYPE_MUT_REF
        fill_narrow = ptr_value_to_i64(s, fill_val, fill_val_reg)   # AGAST #2369: an `[N]@&T` holds i64s
    if fill_arr_size <= 16
        # Small N: unroll for simple straight-line IR.
        var fi: i32 = 0
        while fi < fill_arr_size
            let fep: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, fep)
            emit_str(s, c" = getelementptr [")
            emit_int(s, fill_arr_size as i64)
            emit_str(s, c" x ")
            emit_str(s, fill_elem_llvm)
            emit_str(s, c"], ptr ")
            emit_reg(s, base_reg)
            emit_str(s, c", i64 0, i64 ")
            emit_int(s, fi as i64)
            emit_str(s, c"\n")
            emit_str(s, c"  store ")
            emit_str(s, fill_elem_llvm)
            emit_str(s, c" ")
            emit_reg(s, fill_narrow)
            emit_str(s, c", ptr ")
            emit_reg(s, fep)
            emit_str(s, c"\n")
            fi = fi + 1
        return
    # Larger N: real LLVM loop with i32 induction var on stack.
    let fi_idx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_idx)
    emit_str(s, c" = alloca i32\n")
    emit_str(s, c"  store i32 0, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, c"\n")
    let fi_cond: i32 = next_label(s)
    let fi_body: i32 = next_label(s)
    let fi_end: i32 = next_label(s)
    emit_str(s, c"  br label %")
    emit_label(s, fi_cond)
    emit_str(s, c"\n")
    begin_block(s, fi_cond)
    let fi_cur: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_cur)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, c"\n")
    let fi_cmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_cmp)
    emit_str(s, c" = icmp ult i32 ")
    emit_reg(s, fi_cur)
    emit_str(s, c", ")
    emit_int(s, fill_arr_size as i64)
    emit_str(s, c"\n")
    emit_str(s, c"  br i1 ")
    emit_reg(s, fi_cmp)
    emit_str(s, c", label %")
    emit_label(s, fi_body)
    emit_str(s, c", label %")
    emit_label(s, fi_end)
    emit_str(s, c"\n")
    begin_block(s, fi_body)
    let fi_cur2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_cur2)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, c"\n")
    let fi_ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_ep)
    emit_str(s, c" = getelementptr [")
    emit_int(s, fill_arr_size as i64)
    emit_str(s, c" x ")
    emit_str(s, fill_elem_llvm)
    emit_str(s, c"], ptr ")
    emit_reg(s, base_reg)
    emit_str(s, c", i32 0, i32 ")
    emit_reg(s, fi_cur2)
    emit_str(s, c"\n")
    emit_str(s, c"  store ")
    emit_str(s, fill_elem_llvm)
    emit_str(s, c" ")
    emit_reg(s, fill_narrow)
    emit_str(s, c", ptr ")
    emit_reg(s, fi_ep)
    emit_str(s, c"\n")
    let fi_inc: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fi_inc)
    emit_str(s, c" = add i32 ")
    emit_reg(s, fi_cur2)
    emit_str(s, c", 1\n")
    emit_str(s, c"  store i32 ")
    emit_reg(s, fi_inc)
    emit_str(s, c", ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, c"\n")
    emit_str(s, c"  br label %")
    emit_label(s, fi_cond)
    emit_str(s, c"\n")
    begin_block(s, fi_end)

# Write the array literal `lit` (`[a, b, ..]`) element by element into the
# `[arr_size x elem]` storage at `base_reg` (a `ptr` register: a local alloca
# or a struct-field GEP). Elements past `arr_size` are ignored.
#
# Shared by `let a: [N]T = [..]` (emit_var_decl) and by `[..]` as an array
# field of a struct literal (emit_struct_lit_array_fill_field). Element
# handling depends on the element type:
#   * scalars: evaluate to i64, then trunc / inttoptr to the element width.
#   * structs (`elem_ty == TYPE_STRUCT`, named by `elem_name`): a struct
#     literal element is written in place into its slot with
#     emit_struct_lit_to_alloca. emit_expr has no lowering for a bare literal
#     that matches the slot. Any other element (a local, a call) is a loaded
#     `%T` aggregate and is stored as one.
# The generic EXPR_ARRAY_LIT arm of emit_expr builds an `[N x i64]` shadow and
# stored each struct element as an i64 (invalid IR). (AGAST #1608)
#
# bool / f32 / f64 elements are `i1` / `float` / `double` in a local and a
# field array alike (array_elem_typed_scalar, #1966, #2063).
fn emit_array_lit_into(s: *EmitterState, base_reg: i32, arr_size: i32, elem_ty: i32, elem_name: *u8, elem_name_len: i32, lit: *Expr)
    var is_struct: i32 = 0
    if elem_ty == TYPE_STRUCT and elem_name_len > 0
        is_struct = 1
    var elem_llvm: *u8 = c"i64"
    var needs_trunc: i32 = 0
    if elem_ty == TYPE_I32 or elem_ty == TYPE_U32
        elem_llvm = c"i32"
        needs_trunc = 1
    else if elem_ty == TYPE_U8 or elem_ty == TYPE_I8
        elem_llvm = c"i8"
        needs_trunc = 1
    else if elem_ty == TYPE_U16 or elem_ty == TYPE_I16
        elem_llvm = c"i16"
        needs_trunc = 1
    else if elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR
        elem_llvm = c"ptr"
    var field_scalar: i32 = 0
    if array_elem_typed_scalar(elem_ty) == 1
        field_scalar = 1
        elem_llvm = field_array_elem_llvm(elem_ty)
    var idx: i32 = 0
    var it: *Expr = lit.args
    while it != null and idx < arr_size
        # A struct-literal element has no value register; GEP first, then
        # write it in place.
        var val_reg: i32 = -1
        if is_struct == 0 or it.kind != EXPR_STRUCT_LIT
            val_reg = emit_expr_into_slot(s, it, elem_ty, elem_name, elem_name_len)   # AGAST #2454
        let elem_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr [")
        emit_int(s, arr_size as i64)
        emit_str(s, c" x ")
        if is_struct == 1
            emit_str(s, c"%")
            emit_name(s, elem_name, elem_name_len)
        else
            emit_str(s, elem_llvm)
        emit_str(s, c"], ptr ")
        emit_reg(s, base_reg)
        emit_str(s, c", i64 0, i64 ")
        emit_int(s, idx as i64)
        emit_str(s, c"\n")
        if is_struct == 1
            if val_reg < 0
                emit_struct_lit_to_alloca(s, it, elem_ptr)
            else
                let agg: i32 = coerce_struct_ret_value(s, it, val_reg, elem_name, elem_name_len)
                emit_str(s, c"  store %")
                emit_name(s, elem_name, elem_name_len)
                emit_str(s, c" ")
                emit_reg(s, agg)
                emit_str(s, c", ptr ")
                emit_reg(s, elem_ptr)
                emit_str(s, c"\n")
        else
            # Narrow the i64 expression value to the element type.
            var stored: i32 = val_reg
            if field_scalar == 1
                stored = emit_field_elem_narrow(s, val_reg, elem_ty, it)
            else if (elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR) and expr_is_ptr_valued(s, it) == 1
                stored = val_reg   # AGAST #3029: `@&x` is a `ptr` already
            else if elem_ty == TYPE_REF or elem_ty == TYPE_MUT_REF
                stored = ptr_value_to_i64(s, it, val_reg)   # AGAST #2369: an `[N]@&T` holds i64s
            else if elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR
                stored = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, stored)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, val_reg)
                emit_str(s, c" to ptr\n")
            else if needs_trunc == 1
                stored = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, stored)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, val_reg)
                emit_str(s, c" to ")
                emit_str(s, elem_llvm)
                emit_str(s, c"\n")
            emit_str(s, c"  store ")
            emit_str(s, elem_llvm)
            emit_str(s, c" ")
            emit_reg(s, stored)
            emit_str(s, c", ptr ")
            emit_reg(s, elem_ptr)
            emit_str(s, c"\n")
        idx = idx + 1
        it = it.next


# If struct literal field `field_idx` of `st` is an inline array initialised
# with `[v; N]` (AGAST #1605) or `[a, b, ..]` (AGAST #1608), GEP to the field
# inside `base_reg` and write it in place; return 1. Otherwise emit nothing
# and return 0 so the caller's generic evaluate-then-store path handles the
# field.
fn emit_struct_lit_array_fill_field(s: *EmitterState, st: *StructDef, field_idx: i32, value: *Expr, base_reg: i32) -> i32
    if value == null or (value.kind != EXPR_ARRAY_FILL and value.kind != EXPR_ARRAY_LIT)
        return 0
    let field: *StructField = get_field_type(st, field_idx)
    if field.field_type != TYPE_ARRAY
        return 0
    literal_field(s, value, field)   # AGAST #2341
    let field_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, field_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, base_reg)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, field_idx as i64)
    emit_str(s, c"\n")
    if value.kind == EXPR_ARRAY_LIT
        emit_array_lit_into(s, field_ptr, field.array_size, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len, value)
    else
        emit_array_fill_into(s, field_ptr, field.array_size, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len, value.left)
    1

# Evaluate struct-literal field `field_idx` of `st` and store it into the
# struct at `base_reg`, at the field's own width.
#
# The ONE field-store dispatch for struct literals: emit_var_decl's
# `let s = S { ... }` loop and emit_struct_lit_to_alloca (tail / return /
# reassignment literals) both call it, so the two cannot drift again. Before
# AGAST #1497 they had: the let loop stored a bool with an 8-byte `store i64`
# (clobbering the next field), and the alloca loop had no bool, u32, i16/u16
# or struct arm and silently dropped those fields.
#
# Values are i64 in ritz1's value model, so narrow fields `trunc` first. The
# exception is a bool expression that emit_expr leaves in an i1 register (a
# bool global's load; see bool_reg_is_i1), stored as is.
# An unlowerable field type is a located error, never a silent skip.
fn emit_struct_lit_field_store(s: *EmitterState, st: *StructDef, field_idx: i32, value: *Expr, base_reg: i32)
    let field: *StructField = get_field_type(st, field_idx)
    bool_check_slot(s, value, field.field_type, field.field_type_name, field.field_type_name_len)
    literal_field(s, value, field)   # AGAST #2341
    # AGAST #3005: a tuple field (`Box<(u32, u32)> { v: (1, 2) }`, a nested
    # tuple) names a nameless tuple literal.
    if field.field_type == TYPE_STRUCT
        tuple_lit_name(s, value, field.field_type_name, field.field_type_name_len)
    # A nested literal (`E { name: V { .. } }`) has no value register:
    # emit_expr rejects a bare EXPR_STRUCT_LIT. Write it in place into the
    # field instead, recursively. (AGAST #1655)
    if value != null and value.kind == EXPR_STRUCT_LIT and field.field_type == TYPE_STRUCT
        let nested_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, nested_ptr)
        emit_str(s, c" = getelementptr %")
        emit_name(s, st.name, st.name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, base_reg)
        emit_str(s, c", i32 0, i32 ")
        emit_int(s, field_idx as i64)
        emit_str(s, c"\n")
        emit_struct_lit_to_alloca(s, value, nested_ptr)
        return
    # AGAST #2142: `Font { cmap: Some(..) }` builds the field's enum.
    let val_reg: i32 = emit_expr_into_field(s, value, field)
    let field_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, field_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, base_reg)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, field_idx as i64)
    emit_str(s, c"\n")
    let ft: i32 = field.field_type
    # What to store: the register and its LLVM type.
    var stored: i32 = val_reg
    var store_ty: *u8 = null
    var trunc_ty: *u8 = null
    if ft == TYPE_I64 or ft == TYPE_U64
        # AGAST #2064: u64 is already an i64 register; no trunc needed.
        store_ty = c"i64"
    else if ft == TYPE_I32 or ft == TYPE_U32
        trunc_ty = c"i32"
    else if ft == TYPE_I16 or ft == TYPE_U16
        trunc_ty = c"i16"
    else if ft == TYPE_I8 or ft == TYPE_U8
        trunc_ty = c"i8"
    else if ft == TYPE_BOOL
        if bool_reg_is_i1(s, value) == 1
            store_ty = c"i1"
        else
            trunc_ty = c"i1"
    else if ft == TYPE_PTR or ft == TYPE_PTR_PTR
        # AGAST #2041: `R { ch: @&c }` -- `@&c` (or an `@&T` local) is
        # already a `ptr`; only an i64-model pointer value needs inttoptr.
        stored = i64_value_to_ptr(s, value, val_reg)
        store_ty = c"ptr"
    else if ft == TYPE_F32
        # Float lit emits as `double`; an f64 value is fptrunc'd, an
        # integer one sitofp'd (#2065), by emit_field_elem_narrow.
        stored = emit_field_elem_narrow(s, val_reg, TYPE_F32, value)
        store_ty = c"float"
    else if ft == TYPE_F64
        stored = emit_field_elem_narrow(s, val_reg, TYPE_F64, value)
        store_ty = c"double"
    else if ft == TYPE_STRUCT and field.field_type_name_len > 0
        # task-103: struct-by-value field (e.g. `Vec$T` in `Wrap`).
        # val_reg is the loaded aggregate (`%Vec$T`), not an i64.
        # A bare "..." is a %Span$u8; a StrView field needs it rebuilt as
        # %StrView (the layout-equivalent pair) before the store (#1669).
        let agg: i32 = coerce_struct_ret_value(s, value, val_reg, field.field_type_name, field.field_type_name_len)
        emit_str(s, c"  store %")
        emit_name(s, field.field_type_name, field.field_type_name_len)
        emit_str(s, c" ")
        emit_reg(s, agg)
        emit_str(s, c", ptr ")
        emit_reg(s, field_ptr)
        emit_str(s, c"\n")
        return
    else
        emit_ir_error(s, c"struct literal field of this type is not lowered")
        return
    if trunc_ty != null
        stored = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, stored)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c" to ")
        emit_str(s, trunc_ty)
        emit_str(s, c"\n")
        store_ty = trunc_ty
    emit_str(s, c"  store ")
    emit_str(s, store_ty)
    emit_str(s, c" ")
    emit_reg(s, stored)
    emit_str(s, c", ptr ")
    emit_reg(s, field_ptr)
    emit_str(s, c"\n")

# =============================================================================
# Struct Literal to Alloca Helper
# =============================================================================

# =============================================================================
# Tuple literals with no tuple type (AGAST #3005)
# =============================================================================
#
# tuple_resolve_module names a tuple literal from its slot when the parse
# knows one (a fn's return type, an annotated let, an enclosing tuple).  The
# rest reach the emitter nameless: `let t = (a, b)`, a call argument, a
# generic struct's field, an if / match arm that binds a name or runs
# statements before its tuple.  Each is named where it is emitted, with its
# arm's bindings in scope: from the slot the emitter knows (a param's or
# field's tuple type, the phi type an earlier arm fixed), else from its
# elements' types, as ritz0 builds the struct from its element values.  A
# struct synthesized here missed emit_struct_types: emit_late_enum_types
# declares it.

# Is `e` a tuple literal (fields "0", "1", ..) nothing has named yet?
fn tuple_lit_nameless(e: *Expr) -> i32
    if e == null or e.kind != EXPR_STRUCT_LIT or e.ident_len != 0
        return 0
    let fi: *FieldInit = e.args as *FieldInit
    if fi == null or fi.name_len != 1 or *fi.name != 48  # '0'
        return 0
    1

fn tuple_lit_arity(e: *Expr) -> i32
    var n: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        n = n + 1
        fi = fi.next
    n

# The tuple struct `name` names when it has `n` elements, or null.
fn tuple_slot_def(s: *EmitterState, name: *u8, len: i32, n: i32) -> *StructDef
    if name == null or len < 6 or memcmp(name, c"tuple_", 6) != 0
        return null
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return null
    var k: i32 = 0
    var f: *StructField = st.fields
    while f != null
        k = k + 1
        f = f.next
    if k != n
        return null
    st

# Element `v`'s type as a tuple field: its kind in *out_ty, a struct's name in
# *out_name / *out_len.  Returns its spelling's length (ritz0's
# mangle_type_name: a struct's name, a primitive's), with the spelling in
# *spell, or 0 when ritz1 can't type it (a pointer, an array, a struct it
# can't name).
fn tuple_elem_type(s: *EmitterState, v: *Expr, out_ty: *i32, out_name: **u8, out_len: *i32, spell: **u8) -> i32
    *out_name = null
    *out_len = 0
    if v.kind == EXPR_STRUCT_LIT
        *out_ty = TYPE_STRUCT
        *out_name = v.ident_ptr
        *out_len = v.ident_len
    else if bool_kind(s, v) == BK_BOOL
        *out_ty = TYPE_BOOL
    else
        *out_ty = get_expr_type(s, v)
        let t: i32 = *out_ty
        if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF or t == TYPE_ARRAY
            return 0
        # A struct or enum value names its type even where get_expr_type
        # says i64 (`Slot.Full(x)`, a variant ctor).
        tuple_decl_struct_name(s, v, out_name, out_len)
        if *out_len > 0
            *out_ty = TYPE_STRUCT
    if *out_ty == TYPE_STRUCT
        *spell = *out_name
        return *out_len
    primitive_arg_spelling(*out_ty, spell)

# A tuple struct `name` with the given element types, registered as the
# parse registers a struct, and queued for emit_late_enum_types.
fn tuple_struct_new(s: *EmitterState, name: *u8, len: i32, tys: *i32, names: **u8, lens: *i32, n: i32) -> *StructDef
    var fields: *StructField = null
    var last: *StructField = null
    for i in 0..n
        let f: *StructField = calloc(1, sizeof(StructField)) as *StructField
        let nm: *u8 = malloc(12)
        let nlen: i32 = write_dec_i32(nm, i)
        *(nm + nlen) = 0
        f.name = nm
        f.name_len = nlen
        f.field_type = *(tys + i)
        f.field_type_name = *(names + i)
        f.field_type_name_len = *(lens + i)
        f.ptr_pointee = TYPE_VOID
        f.array_elem_pointee = TYPE_VOID
        f.inner_pointee_type = TYPE_VOID
        if last == null
            fields = f
        else
            last.next = f
        last = f
    let st: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
    st.name = name
    st.name_len = len
    st.fields = fields
    st.next = s.module.structs
    s.module.structs = st
    let key: i64 = fnv1a_str(name, len) as i64
    if hashmap_i64_contains(@s.struct_map, key) == 0
        hashmap_i64_insert(@&s.struct_map, key, st as i64)
    namelist_push(@s.late_tuples, name, len)
    st

# Name the nameless tuple literal `e` from its elements' types (nested
# nameless tuples first).  Returns 1 once named; 0 after a located error.
fn tuple_lit_infer(s: *EmitterState, e: *Expr) -> i32
    let n: i32 = tuple_lit_arity(e)
    let tys: *i32 = malloc((n as i64) * 4) as *i32
    let names: **u8 = malloc((n as i64) * 8) as **u8
    let lens: *i32 = malloc((n as i64) * 4) as *i32
    let spells: **u8 = malloc((n as i64) * 8) as **u8
    let spell_lens: *i32 = malloc((n as i64) * 4) as *i32
    var total: i32 = 5  # "tuple"
    var i: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let v: *Expr = fi.value
        if tuple_lit_nameless(v) == 1 and tuple_lit_infer(s, v) == 0
            e.ident_ptr = c"(untyped)"
            e.ident_len = 9
            return 0
        var sp: *u8 = null
        let sl: i32 = tuple_elem_type(s, v, tys + i, names + i, lens + i, @sp)
        if sl == 0
            emit_nd_error(s, v.span.line, v.span.col, c"ritz1 can't infer the type of this tuple element (a pointer, an array, or a value whose struct it can't name): give the tuple a type, as `let t: (A, B) = ..` (AGAST #3024)")
            e.ident_ptr = c"(untyped)"
            e.ident_len = 9
            return 0
        *(spells + i) = sp
        *(spell_lens + i) = sl
        total = total + 1 + sl
        i = i + 1
        fi = fi.next
    let name: *u8 = malloc((total + 1) as i64)
    memcpy(name, c"tuple", 5)
    var pos: i32 = 5
    for j in 0..n
        *(name + pos) = 95  # '_'
        memcpy(name + pos + 1, *(spells + j), *(spell_lens + j) as i64)
        pos = pos + 1 + *(spell_lens + j)
    *(name + pos) = 0
    if find_struct(s, name, pos) == null
        tuple_struct_new(s, name, pos, tys, names, lens, n)
    e.ident_ptr = name
    e.ident_len = pos
    1

# Name `e`, if it is a nameless tuple literal: from the slot struct
# `slot` / `slot_len` when that is a tuple of as many elements, else from its
# elements.  Returns 0 after a located error.
fn tuple_lit_name(s: *EmitterState, e: *Expr, slot: *u8, slot_len: i32) -> i32
    if tuple_lit_nameless(e) == 0
        return 1
    let st: *StructDef = tuple_slot_def(s, slot, slot_len, tuple_lit_arity(e))
    if st != null
        e.ident_ptr = st.name
        e.ident_len = st.name_len
        return 1
    tuple_lit_infer(s, e)

# Emit a struct literal into an existing alloca and return the alloca register
# Used for returning struct literals from functions
fn emit_struct_lit_to_alloca(s: *EmitterState, e: *Expr, alloca_reg: i32) -> i32
    tuple_lit_name(s, e, null, 0)   # AGAST #3005
    let st: *StructDef = find_struct(s, e.ident_ptr, e.ident_len)
    if st == null
        emit_ir_error(s, c"struct not found for literal")
        return alloca_reg

    # Iterate through field initializers
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        var field_idx: i32 = find_field_index(st, fi.name, fi.name_len)
        # `a: [v; N]` for an array field is written in place.
        if field_idx >= 0
            if emit_struct_lit_array_fill_field(s, st, field_idx, fi.value, alloca_reg) == 1
                field_idx = -1  # done (AGAST #1605)
        if field_idx >= 0
            emit_struct_lit_field_store(s, st, field_idx, fi.value, alloca_reg)
        fi = fi.next
    alloca_reg

# Lower a struct literal to a value: `alloca %T`, fill it field by field via
# emit_struct_lit_to_alloca, then `load %T`. Returns the aggregate register.
# Unknown struct names are a located error (from emit_struct_lit_to_alloca's
# lookup), never a silently wrong value. (AGAST #1362)
fn emit_struct_lit_value(s: *EmitterState, e: *Expr) -> i32
    tuple_lit_name(s, e, null, 0)   # AGAST #3005
    let st: *StructDef = find_struct(s, e.ident_ptr, e.ident_len)
    if st == null
        emit_ir_error(s, c"struct not found for literal")
        let zero: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, zero)
        emit_str(s, c" = add i64 0, 0\n")
        return zero
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c"  ; rvalue struct literal\n")
    emit_struct_lit_to_alloca(s, e, tmp)
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    val

