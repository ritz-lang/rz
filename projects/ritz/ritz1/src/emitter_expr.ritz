# =============================================================================
# Member pointer helper - emits GEP to get pointer to field
# Returns MemberPtrResult with reg, field info, and success flag
# Handles both direct (var.field) and nested (var.field1.field2) access
# =============================================================================

# Helper to emit GEP for local variable member access
# AGAST #2372: pointers and references between a local's slot and the struct `.`
# names: 0 for a struct, 1 for `*S` and `@S`, 2 for `**S` and `@*S`, and so on.
pub fn local_struct_levels(loc: *LocalVar) -> i32
    if loc.var_type == TYPE_PTR_PTR
        return ptr_ptr_ident_levels(loc.inner_pointee_type)
    if loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
        if loc.pointee_type == TYPE_PTR
            return 2
        if loc.pointee_type == TYPE_PTR_PTR
            return 1 + ptr_ptr_ident_levels(loc.inner_pointee_type)
        return 1
    if loc.var_type == TYPE_PTR
        return 1
    0

# The same for a field.  An `@S` field is a `*S` by now (lower_ref_fields).
pub fn field_struct_levels(f: *StructField) -> i32
    if f.field_type == TYPE_PTR_PTR
        return ptr_ptr_ident_levels(f.inner_pointee_type)
    1

# `base` loaded `levels` times.
pub fn emit_load_levels(s: *EmitterState, base: i32, levels: i32) -> i32
    var reg: i32 = base
    for i in 0..levels
        reg = emit_load_ptr(s, reg)
    reg

fn emit_member_gep_local(s: *EmitterState, e: *Expr, result: *MemberPtrResult, loc: *LocalVar, st: *StructDef, field_idx: i32, field: *StructField)
    # For ptr/ref types — load the pointer natively (task #73 migration).
    # Old pattern was `load i64` + `inttoptr` round-trip; opaque pointers
    # let us just `load ptr` from the same slot.
    let base_ptr: i32 = emit_load_levels(s, loc.reg, local_struct_levels(loc))
    # GEP to get pointer to field
    let field_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, field_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field_idx as i64)
    emit_str(s, IR_NL)
    result.reg = field_ptr
    result.field = field
    result.success = 1

# Helper to emit GEP from a base pointer register
pub fn emit_member_gep_from_ptr(s: *EmitterState, result: *MemberPtrResult, base_ptr: i32, st: *StructDef, field_idx: i32, field: *StructField)
    let field_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, field_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field_idx as i64)
    emit_str(s, IR_NL)
    result.reg = field_ptr
    result.field = field
    result.success = 1

# AGAST #1487: `w[i].field` on a `Vec<Struct>` local. Pre-fix this fell
# through to "unhandled EXPR_MEMBER" even when w was annotated: the index
# branches of emit_member_ptr handled `[N]St`, `[N]*St` and `**St`, not Vec.
#
# The element struct comes from the instantiated Vec's own `data: *T` field
# (its pointee survives monomorphisation, #1440), not from decoding the
# "Vec$" suffix, so `Vec$P` and `Vec$Pair` resolve alike.
#
# Only a Vec VALUE local: through a pointer or reference it's
# emit_through_member_ptr's (#2440).
#
# Lowering: GEP %Vec$T field `data` →
# load `data` → GEP %T by index → GEP into %T for the field.
# Returns 1 on success, 0 (nothing emitted) if `loc` is not a Vec<Struct>.
fn emit_vec_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, loc: *LocalVar) -> i32
    if loc.type_name_len <= 4
        return 0
    if *(loc.type_name + 0) != 'V' or *(loc.type_name + 1) != 'e' or *(loc.type_name + 2) != 'c' or *(loc.type_name + 3) != '$'
        return 0
    if loc.var_type != TYPE_STRUCT
        return 0
    let vec_st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
    if vec_st == null
        return 0
    let data_idx: i32 = find_field_index(vec_st, StrView { ptr: (c"data"), len: (4) as i64 })
    if data_idx < 0
        return 0
    let data_field: *StructField = get_field_type(vec_st, data_idx)
    if data_field.field_type != TYPE_PTR or data_field.field_type_name_len <= 0
        return 0
    let elem_st: *StructDef = find_struct(s, StrView { ptr: (data_field.field_type_name), len: (data_field.field_type_name_len) as i64 })
    if elem_st == null
        return 0
    let field_idx: i32 = find_field_index(elem_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return 0
    let field: *StructField = get_field_type(elem_st, field_idx)
    let data_pp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, data_pp)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (vec_st.name), len: (vec_st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, loc.reg)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, data_idx as i64)
    emit_str(s, IR_NL)
    let data_p: i32 = emit_load_ptr(s, data_pp)
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (elem_st.name), len: (elem_st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, data_p)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
    return 1

# AGAST #1510: the VALUE of `x`, where x is a pointer to a struct through
# one or more levels of indirection.  Sets *out_st to that struct and
# *out_levels to the number of pointer levels: 1 = `*St`, 2 = `**St`.
# Returns the register holding the loaded pointer, or 0 if the shape or
# static type isn't recognised.
#
# Recursive over the shapes a deref operand takes in practice:
#   IDENT          local `*St` / `@St` / `@&St` (1), or `**St` / `@*St` (2)
#   EXPR_MEMBER    a field of type `*St` (1) or `**St` (2), via emit_member_ptr
#   `*y`           y at levels L >= 2, loaded once more (L - 1)
# So `(*(*b).ops).n`, `(*b.ops).n` and `(**pp).n` all resolve here.
#
# The IDENT arm checks the struct before emitting anything.  The member arm
# may leave dead loads behind when it gives up; the caller reports the
# error, so they are never reached.
pub fn emit_deref_operand_ptr(s: *EmitterState, x: *Expr, out_st: **StructDef, out_levels: *i32) -> i32
    *out_st = null
    *out_levels = 0
    if x == null
        return 0
    if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        # AGAST #2166: `(*gp).f` with a module-level `var gp: *S` (the
        # `gp.f` form is #1892's arm in emit_member_ptr).  loc is null only
        # when no local of that name shadows the global.
        if loc == null
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if glob == null or glob.var_type != TYPE_PTR or glob.pointee_type != TYPE_STRUCT or glob.pointee_type_name_len <= 0
                return 0
            let gst: *StructDef = find_struct(s, StrView { ptr: (glob.pointee_type_name), len: (glob.pointee_type_name_len) as i64 })
            if gst == null
                return 0
            let gp: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, gp)
            emit_str(s, c" = load ptr, ptr @")
            emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            emit_str(s, IR_NL)
            *out_st = gst
            *out_levels = 1
            return gp
        if loc == null or loc.type_name_len <= 0
            return 0
        let levels: i32 = local_struct_levels(loc)
        if levels == 0
            return 0
        let st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
        if st == null
            return 0
        *out_st = st
        *out_levels = levels
        return emit_load_ptr(s, loc.reg)
    if x.kind == EXPR_METHOD
        # AGAST #1635: `(*m.index(k)).f`, which a struct's `m[k].f` becomes.
        # The method returns an `@S`, `@&S` or `*S`: an address, in an i64.
        let fd: *FnDef = method_call_def(s, x)
        if fd == null or fd.return_type_name_len <= 0
            return 0
        if fd.return_type != TYPE_REF and fd.return_type != TYPE_MUT_REF and fd.return_type != TYPE_PTR
            return 0
        let mst: *StructDef = find_struct(s, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
        if mst == null
            return 0
        let addr: i32 = emit_expr(s, x)
        let mp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, addr)
        *out_st = mst
        *out_levels = 1
        return mp
    if x.kind == EXPR_MEMBER
        var inner: MemberPtrResult
        emit_member_ptr(s, x, @inner)
        if inner.success != 1
            return 0
        let f: *StructField = inner.field
        if f.field_type_name_len <= 0
            return 0
        var flevels: i32 = 0
        if f.field_type == TYPE_PTR
            flevels = 1
        else if f.field_type == TYPE_PTR_PTR
            flevels = ptr_ptr_ident_levels(f.inner_pointee_type)
        if flevels == 0
            return 0
        let fst: *StructDef = find_struct(s, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        if fst == null
            return 0
        *out_st = fst
        *out_levels = flevels
        return emit_load_ptr(s, inner.reg)
    if x.kind == EXPR_UNARY and x.op == OP_DEREF
        var sub_st: *StructDef = null
        var sub_levels: i32 = 0
        let sub_reg: i32 = emit_deref_operand_ptr(s, x.operand, @sub_st, @sub_levels)
        if sub_reg == 0 or sub_levels < 2
            return 0
        *out_st = sub_st
        *out_levels = sub_levels - 1
        return emit_load_ptr(s, sub_reg)
    # AGAST #2376: `b[i]` with `b: [N]**S`, or `@a[i]` with `a: [N]*S`: a `**S`,
    # so `(**b[i]).f` reaches S.
    if elem_rooted(x) == 1
        var pl_inner: i32 = TYPE_VOID
        var pl_name: *u8 = null
        var pl_len: i32 = 0
        let pl: i32 = ptr_levels_of(s, x, @pl_inner, @pl_name, @pl_len)
        if pl >= 2 and pl_inner == TYPE_STRUCT and pl_len > 0
            let pl_st: *StructDef = find_struct(s, StrView { ptr: (pl_name), len: (pl_len) as i64 })
            if pl_st == null
                return 0
            var pl_ptr: i32 = emit_expr(s, x)
            if deref_operand_is_ptr(s, x) == 0
                let pl_val: i32 = pl_ptr
                pl_ptr = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, pl_ptr)
                emit_str(s, IR_INTTOPTR)
                emit_reg(s, pl_val)
                emit_str(s, c" to ptr\n")
            *out_st = pl_st
            *out_levels = pl
            return pl_ptr
    # AGAST #2805: `y + k` / `y - k` where y is a `**S` (`qq + 1`, or a call
    # returning one, `vec_as_ptr<*S>(@w) + 1`), or such a call bare: emit_expr
    # strides it by 8, and `(*(qq + 1)).f` loads the `*S` and GEPs into S.  It
    # fell through to the `*S` arm below, which names no S for it, and was an
    # unlocated "unhandled EXPR_MEMBER".
    if x.kind == EXPR_CALL or (x.kind == EXPR_BINARY and (x.op == OP_ADD or x.op == OP_SUB))
        var pp_st: *StructDef = null
        let pp_levels: i32 = ptr_ptr_struct_operand(s, x, @pp_st)
        if pp_levels >= 2
            let pp_val: i32 = emit_expr(s, x)
            let pp_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, pp_val)
            *out_st = pp_st
            *out_levels = pp_levels
            return pp_ptr
    # AGAST #1924: `y + k` / `y - k` where y is a `*S` (`*(pp + i) + k`):
    # emit_expr strides it by sizeof(S) (deref_pointee_struct_name names S
    # for the left operand), so `(*(*(pp + i) + k)).f` GEPs into the right
    # element.  Only the one-level case: `(**(ppp + 1)).f` keeps its error.
    # AGAST #2332: and `a[i]` / `a[i] + k` with `a: [N]*S`.
    # AGAST #2526: and a call `f()` (`-> *S`) or a cast `x as *S`.
    if x.kind == EXPR_INDEX or x.kind == EXPR_CALL or x.kind == EXPR_CAST or (x.kind == EXPR_BINARY and (x.op == OP_ADD or x.op == OP_SUB))
        var b_name: *u8 = null
        var b_len: i32 = 0
        deref_pointee_struct_name(s, x, @b_name, @b_len)
        if b_len <= 0
            return 0
        let b_st: *StructDef = find_struct(s, StrView { ptr: (b_name), len: (b_len) as i64 })
        if b_st == null
            return 0
        let b_val: i32 = emit_expr(s, x)
        # AGAST #3443: `x as @&S` is already the `ptr` an `@&T` lowers as
        # (#1754); `as *S` / `as @S` are i64 addresses.
        if x.kind == EXPR_CAST and x.op == TYPE_MUT_REF
            *out_st = b_st
            *out_levels = 1
            return b_val
        let b_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, b_val)
        *out_st = b_st
        *out_levels = 1
        return b_ptr
    return 0

# AGAST #2805: the pointer levels (>= 2) of `x` when it is a pointer to
# pointer to a struct S, writing S to *out_st: pointer arithmetic down the left
# spine rooted in anything ptr_levels_of resolves (a `**S` local, param, global
# or field), or in a call returning `**S` (written, or `vec_as_ptr<*S>`, which
# monomorph records as TYPE_PTR_PTR named S, a `ptr_` per extra level, #2791).
# 0 for any other shape.
fn ptr_ptr_struct_operand(s: *EmitterState, x: *Expr, out_st: **StructDef) -> i32
    *out_st = null
    var root: *Expr = x
    while root != null and root.kind == EXPR_BINARY and (root.op == OP_ADD or root.op == OP_SUB)
        root = root.left
    if root == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    var levels: i32 = 0
    if root.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, root)
        if fd == null or fd.return_type != TYPE_PTR_PTR or fd.return_type_name == null
            return 0
        name = fd.return_type_name
        len = fd.return_type_name_len
        levels = 2
        while len > 4 and memcmp(name, c"ptr_", 4) == 0
            name = name + 4
            len = len - 4
            levels = levels + 1
    else
        var inner: i32 = TYPE_VOID
        levels = ptr_levels_of(s, x, @inner, @name, @len)
        if inner != TYPE_STRUCT
            return 0
    if levels < 2 or name == null or len <= 0
        return 0
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (len) as i64 })
    if st == null
        return 0
    *out_st = st
    levels

# AGAST #2399: levels between what the call `e` returns and the struct `.` names,
# when there are two or more (`-> **S`, `-> @*S`, `-> @&**S`), with the struct in
# `out_st`.  0 for any other result.
pub fn call_result_struct_levels(s: *EmitterState, e: *Expr, out_st: **StructDef) -> i32
    *out_st = null
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null
        return 0
    if fd.return_type == TYPE_PTR_PTR and e.kind == EXPR_CALL
        return ptr_ptr_struct_operand(s, e, out_st)
    if fd.return_type != TYPE_REF and fd.return_type != TYPE_MUT_REF
        return 0
    let r: *Param = fd.ret_ref
    if r == null or r.param_type_name_len <= 0
        return 0
    var levels: i32 = 0
    if r.param_pointee_type == TYPE_PTR
        levels = 2
    else if r.param_pointee_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(r.param_inner_pointee_type) == TYPE_STRUCT
        levels = 1 + ptr_ptr_ident_levels(r.param_inner_pointee_type)
    else
        return 0
    let st: *StructDef = find_struct(s, StrView { ptr: (r.param_type_name), len: (r.param_type_name_len) as i64 })
    if st == null
        return 0
    *out_st = st
    levels

# The struct pointer the call `e` returns `levels` levels from it, loaded down
# to the struct's address.  The call is emitted once.
pub fn emit_call_result_struct_ptr(s: *EmitterState, e: *Expr, levels: i32) -> i32
    let val: i32 = emit_expr(s, e)
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, val)
    emit_str(s, c" to ptr  ; call-result levels\n")
    emit_load_levels(s, p, levels - 1)

# AGAST #190 / #3325: `name[i].field` (e) over a module-level `[size x %P]`
# global, a `var` global or a const struct array: GEP the element, then the
# field.  1 when it resolved the field.
fn emit_named_struct_array_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, name_sv: StrView, size: i32, tn: *u8, tl: i32) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let st: *StructDef = find_struct(s, StrView { ptr: (tn), len: (tl) as i64 })
    if st == null
        return 0
    let fidx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if fidx < 0
        return 0
    let field: *StructField = get_field_type(st, fidx)
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, size as i64)
    emit_str(s, c" x %")
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, c"], ptr @")
    emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_I64_ZERO)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    emit_member_gep_from_ptr(s, result, elem_ptr, st, fidx, field)
    1

# AGAST #3824: the address of field `e.ident` of the struct const `e.left`,
# when `e.left` names one that is lowered to a `%S` global: the same gate as
# emit_expr_ident's load of it (struct_const_global).  Leaves
# `result.success` 0 for any other const, so the caller's error stands.
fn emit_struct_const_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    let ce: *ConstEntry = struct_const_global(s, e.left)
    if ce == null
        return
    let st: *StructDef = find_struct(s, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    if st == null
        return
    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return
    let field_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, field_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, c", ptr @")
    emit_name(s, StrView { ptr: (ce.name), len: (ce.name_len) as i64 })
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field_idx as i64)
    emit_str(s, IR_NL)
    result.reg = field_ptr
    result.field = get_field_type(st, field_idx)
    result.success = 1

# AGAST #4469: a field read straight off an `unwrap()` of a POINTER payload:
# `o.unwrap().f` with Option<@T> / <@&T> / <*T>, or the Result forms (prism's
# `comp.get_window(win1).unwrap().state`, `get_window(..) -> Option<@&Window>`).
# The intrinsic has no FnDef, and call_result_struct_name's unwrap arm names
# only a by-value struct payload, so this base fell to "unhandled
# EXPR_MEMBER" even after #4458 typed the `let` form.  The unwrap loads the
# payload as an i64 holding the pointer; inttoptr it (one load more for a
# `**T` payload) and GEP the pointee's field, as a local of the same kind
# does.  Returns 1 when it resolved the field.
fn unwrap_pointer_payload_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult) -> i32
    if e.left == null
        return 0
    var uw_kind: i32 = TYPE_VOID
    var uw_name: *u8 = null
    var uw_len: i32 = 0
    var uw_pointee: i32 = TYPE_VOID
    if unwrap_payload_pointer_type(s, e.left, @uw_kind, @uw_name, @uw_len, @uw_pointee) == 0 or uw_len == 0
        return 0
    let uw_st: *StructDef = find_struct(s, StrView { ptr: (uw_name), len: (uw_len) as i64 })
    if uw_st == null
        return 0
    let uw_idx: i32 = find_field_index(uw_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if uw_idx < 0
        return 0
    let uw_val: i32 = emit_expr(s, e.left)
    let uw_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, uw_ptr)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, uw_val)
    emit_str(s, c" to ptr  ; unwrap pointer payload member\n")
    # The payload register already holds the pointer the let-declaration
    # path stores in its slot, so one level fewer than local_struct_levels.
    var uw_levels: i32 = 1
    if uw_kind == TYPE_PTR_PTR
        uw_levels = 2
    else if (uw_kind == TYPE_REF or uw_kind == TYPE_MUT_REF) and uw_pointee == TYPE_PTR
        uw_levels = 2
    let uw_base: i32 = emit_load_levels(s, uw_ptr, uw_levels - 1)
    emit_member_gep_from_ptr(s, result, uw_base, uw_st, uw_idx, get_field_type(uw_st, uw_idx))
    1

pub fn emit_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    result.reg = 0
    result.field = null
    result.success = 0
    emit_member_ptr_at(s, e, result)

fn emit_member_ptr_at(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    # Base case: e.left is an identifier (var.field)
    if e.left.kind == EXPR_IDENT
        # First try local variable
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if loc != null
            let st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
            if st != null
                let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if field_idx >= 0
                    let field: *StructField = get_field_type(st, field_idx)
                    # Emit GEP - different handling for ptr/ref vs value types
                    emit_member_gep_local(s, e, result, loc, st, field_idx, field)
                    return
        # Try global variable
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        var gp_len: i32 = 0
        if glob != null
            if glob.var_type == TYPE_STRUCT
                let st: *StructDef = find_struct(s, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 })
                if st != null
                    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        let field_ptr: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, field_ptr)
                        emit_str(s, IR_GEP_NAMED)
                        emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                        emit_str(s, c", ptr @")
                        emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                        emit_str(s, IR_I32_ZERO)
                        emit_int(s, field_idx as i64)
                        emit_str(s, IR_NL)
                        result.reg = field_ptr
                        result.field = field
                        result.success = 1
                        return
            # AGAST #1892: `g.f` with `var g: *S` at module level.  Load the
            # global pointer, then GEP into S.  This arm was missing, so both
            # reads and writes (which go through here via emit_assign) fell
            # through to "unhandled EXPR_MEMBER".  #1554: and `@S` / `@&S`.
            else if global_pointee_struct(glob, @gp_len) != null
                let pst: *StructDef = find_struct(s, StrView { ptr: (glob.pointee_type_name), len: (gp_len) as i64 })
                if pst != null
                    let pfield_idx: i32 = find_field_index(pst, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if pfield_idx >= 0
                        let pfield: *StructField = get_field_type(pst, pfield_idx)
                        let gp: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, gp)
                        emit_str(s, c" = load ptr, ptr @")
                        emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                        emit_str(s, IR_NL)
                        emit_member_gep_from_ptr(s, result, gp, pst, pfield_idx, pfield)
                        return
            # AGAST #2372: and `var g: **S`.
            else if glob.var_type == TYPE_PTR_PTR and glob.pointee_type_name_len > 0
                let qst: *StructDef = find_struct(s, StrView { ptr: (glob.pointee_type_name), len: (glob.pointee_type_name_len) as i64 })
                if qst != null
                    let qfield_idx: i32 = find_field_index(qst, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if qfield_idx >= 0
                        let qp: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, qp)
                        emit_str(s, c" = load ptr, ptr @")
                        emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                        emit_str(s, IR_NL)
                        let qbase: i32 = emit_load_levels(s, qp, ptr_ptr_ident_levels(glob.inner_pointee_type) - 1)
                        emit_member_gep_from_ptr(s, result, qbase, qst, qfield_idx, get_field_type(qst, qfield_idx))
                        return
        # AGAST #3824: `K.f` with `const K: StrView = "..."`, a struct const
        # that emit_const_struct_entry lowers to `@K = internal constant %S`
        # (#189): GEP the field out of that global, as for a `var g: S`.
        # mausoleum's `DEFAULT_COLLECTION_NAME.ptr` fell to "unhandled
        # EXPR_MEMBER" here, so mausoleum and nexus did not build on ritz1.
        else
            emit_struct_const_member_ptr(s, e, result)
            if result.success == 1
                return

    # Recursive case: e.left is another EXPR_MEMBER (nested: a.b.c)
    else if e.left.kind == EXPR_MEMBER
        # First get pointer to intermediate field
        var inner_result: MemberPtrResult
        emit_member_ptr(s, e.left, @inner_result)
        if inner_result.success == 1
            let inner_field: *StructField = inner_result.field
            # Inner field must be a struct type to continue nesting
            if inner_field.field_type == TYPE_STRUCT
                let st: *StructDef = find_struct(s, StrView { ptr: (inner_field.field_type_name), len: (inner_field.field_type_name_len) as i64 })
                if st != null
                    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        emit_member_gep_from_ptr(s, result, inner_result.reg, st, field_idx, field)
                        return
            # Handle pointer-to-struct field: load the pointer, then GEP into the pointed-to struct
            # AGAST #2372: a `**S` field is loaded down to the struct too.
            else if (inner_field.field_type == TYPE_PTR or inner_field.field_type == TYPE_PTR_PTR) and inner_field.field_type_name_len > 0
                # Load the pointer value from the field
                let loaded: i32 = emit_load_levels(s, inner_result.reg, field_struct_levels(inner_field))
                # Now GEP into the pointed-to struct
                let st: *StructDef = find_struct(s, StrView { ptr: (inner_field.field_type_name), len: (inner_field.field_type_name_len) as i64 })
                if st != null
                    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        emit_member_gep_from_ptr(s, result, loaded, st, field_idx, field)
                        return

    # AGAST #1647: a field of a struct returned BY VALUE, `mk(true).b`,
    # `p.pair().a`, `Q.make(1).x`, `mko(1).inner.x` (the nested arm above
    # recurses into here).  Emit the call once, spill the aggregate into an
    # alloca of the callee's return struct, then GEP the field out of it.
    # Before this the base fell through to "unhandled EXPR_MEMBER".
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        var cr_name: *u8 = null
        var cr_len: i32 = 0
        call_result_struct_name(s, e.left, @cr_name, @cr_len)
        if cr_len > 0
            let cr_st: *StructDef = find_struct(s, StrView { ptr: (cr_name), len: (cr_len) as i64 })
            if cr_st != null
                let cr_idx: i32 = find_field_index(cr_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if cr_idx >= 0
                    let cr_field: *StructField = get_field_type(cr_st, cr_idx)
                    let cr_val: i32 = emit_expr(s, e.left)
                    let cr_slot: i32 = next_reg(s)
                    entry_alloca_reg_begin_named(s, cr_slot)
                    emit_name(s, StrView { ptr: (cr_st.name), len: (cr_st.name_len) as i64 })
                    emit_str(s, c"  ; call-result member\n")
                    entry_alloca_reg_end(s)
                    emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (cr_st.name), len: (cr_st.name_len) as i64 }, cr_val, cr_slot)
                    emit_member_gep_from_ptr(s, result, cr_slot, cr_st, cr_idx, cr_field)
                    return
        # AGAST #2399: `h(x).f` with `h` returning `**S` or `@*S`: through
        # every level, as for a local of that type.
        var cl_st: *StructDef = null
        let cl_levels: i32 = call_result_struct_levels(s, e.left, @cl_st)
        if cl_levels >= 2
            let cl_idx: i32 = find_field_index(cl_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if cl_idx >= 0
                let cl_ptr: i32 = emit_call_result_struct_ptr(s, e.left, cl_levels)
                emit_member_gep_from_ptr(s, result, cl_ptr, cl_st, cl_idx, get_field_type(cl_st, cl_idx))
                return
        # AGAST #2879: a `*S` result is the struct's address, so its field is
        # a place: `sp(@s).x = 3`, `s.me().arr[2] = 5`.  GEP through the
        # pointer the call returns.  The call is emitted once here; `x op= v`
        # shares it between the read and the store (si_once, #2529).
        let cp_st: *StructDef = call_result_ptr_struct(s, e.left)
        if cp_st != null
            let cp_idx: i32 = find_field_index(cp_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if cp_idx >= 0
                let cp_val: i32 = emit_expr(s, e.left)
                let cp_ptr: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, cp_ptr)
                emit_str(s, IR_INTTOPTR)
                emit_reg(s, cp_val)
                emit_str(s, c" to ptr  ; *S call-result member\n")
                emit_member_gep_from_ptr(s, result, cp_ptr, cp_st, cp_idx, get_field_type(cp_st, cp_idx))
                return
        # AGAST #4469: a pointer payload's field, `o.unwrap().f`.
        if unwrap_pointer_payload_member_ptr(s, e, result) == 1
            return

    # Dereference case: ptr.field - e.left is EXPR_UNARY with OP_DEREF
    # Also: address-of-then-member case: (@expr).field — when the inner
    # expression already resolves through a struct pointer, the outer
    # `.field` is effectively another step into the same struct.  E.g.
    # `(@srv.pool).active_count` ≡ `srv.pool.active_count` since
    # srv:*TaskServer already accesses pool by pointer-GEP. (async/tasks
    # `task_server_handle_accept` uses this idiom.)
    else if e.left.kind == EXPR_UNARY
        if e.left.op == OP_ADDR or e.left.op == OP_ADDR_MUT
            # Treat (@inner).field as inner.field — recurse with a synthetic
            # member expr where the OP_ADDR layer is stripped.
            var sub_e: Expr
            sub_e.kind = EXPR_MEMBER
            sub_e.left = e.left.operand
            sub_e.ident_ptr = e.ident_ptr
            sub_e.ident_len = e.ident_len
            emit_member_ptr(s, @sub_e, result)
            if result.success == 1
                return
        if e.left.op == OP_DEREF
            # AGAST #2449: `(*(@x)).f` / `(*(@&x)).f` is `x.f`: the deref
            # undoes the address-of.  Recurse on the stripped member so every
            # base `x.f` takes (local, field, `a[i]`, `v[i]`) works here too.
            # It fell to the unlocated "unhandled EXPR_MEMBER".
            let d_op: *Expr = e.left.operand
            if d_op != null and d_op.kind == EXPR_UNARY and (d_op.op == OP_ADDR or d_op.op == OP_ADDR_MUT) and d_op.operand != null
                var da_e: Expr = *e
                da_e.left = d_op.operand
                emit_member_ptr(s, @da_e, result)
                return
            # The operand of the dereference should be a pointer-to-struct identifier
            if e.left.operand.kind == EXPR_IDENT
                # Find local by name - need full LocalVar, not just reg
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.operand.ident_ptr), len: (e.left.operand.ident_len) as i64 })
                if loc != null
                    # loc should be TYPE_PTR with type_name pointing to struct type
                    if loc.var_type == TYPE_PTR
                        let st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
                        if st != null
                            let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                            if field_idx >= 0
                                let field: *StructField = get_field_type(st, field_idx)
                                # OP_DEREF path: native ptr load (task #73 migration)
                                let base_ptr: i32 = emit_load_ptr(s, loc.reg)
                                emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                                return
            # AGAST #1510: the operand is itself a field or a deref —
            # `(*(*b).ops).n`, `(*b.ops).n`, `(**pp).n`.  Resolve its
            # pointee struct recursively, then GEP on it.
            # AGAST #1940: a `**S` ident (`(*pp).n`) falls through to here
            # too; the `*S` ident arm above only takes one level.
            var d_st: *StructDef = null
            var d_levels: i32 = 0
            var d_base: i32 = emit_deref_operand_ptr(s, e.left.operand, @d_st, @d_levels)
            # AGAST #1940: `(*pp).n` with pp a `**S`: `*pp` is still a `*S`,
            # and `.n` auto-derefs it (ritz0 does the same).  Load once more.
            # AGAST #2372: as many times as it takes.
            if d_base != 0 and d_levels >= 2
                d_base = emit_load_levels(s, d_base, d_levels - 1)
                d_levels = 1
            if d_base != 0 and d_levels == 1
                let d_idx: i32 = find_field_index(d_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if d_idx >= 0
                    let d_field: *StructField = get_field_type(d_st, d_idx)
                    emit_member_gep_from_ptr(s, result, d_base, d_st, d_idx, d_field)
                    return
        # AGAST #175: address-of wrapper, e.g. `(@srv.pool).active_count` —
        # the outer @ is a no-op for member access (the inner expression
        # already yields a pointer-to-struct under the unified value model).
        # Emit through the inner member chain to obtain the parent ptr, then
        # GEP into the inner struct for the requested field.  Without this,
        # the member access fell through to "; ERROR: unhandled EXPR_MEMBER"
        # and a stale `%.0` flowed into the icmp downstream.
        else if e.left.op == OP_ADDR or e.left.op == OP_ADDR_MUT
            if e.left.operand != null and e.left.operand.kind == EXPR_MEMBER
                var addr_inner: MemberPtrResult
                emit_member_ptr(s, e.left.operand, @addr_inner)
                if addr_inner.success == 1
                    let af: *StructField = addr_inner.field
                    if af.field_type == TYPE_STRUCT and af.field_type_name_len > 0
                        let inner_st: *StructDef = find_struct(s, StrView { ptr: (af.field_type_name), len: (af.field_type_name_len) as i64 })
                        if inner_st != null
                            let fidx2: i32 = find_field_index(inner_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                            if fidx2 >= 0
                                let f2: *StructField = get_field_type(inner_st, fidx2)
                                emit_member_gep_from_ptr(s, result, addr_inner.reg, inner_st, fidx2, f2)
                                return
            else if e.left.operand != null and e.left.operand.kind == EXPR_IDENT
                let aloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.operand.ident_ptr), len: (e.left.operand.ident_len) as i64 })
                if aloc != null and aloc.var_type == TYPE_STRUCT and aloc.type_name_len > 0
                    let st_a: *StructDef = find_struct(s, StrView { ptr: (aloc.type_name), len: (aloc.type_name_len) as i64 })
                    if st_a != null
                        let fidx_a: i32 = find_field_index(st_a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if fidx_a >= 0
                            let fa: *StructField = get_field_type(st_a, fidx_a)
                            emit_member_gep_local(s, e, result, aloc, st_a, fidx_a, fa)
                            return

    # AGAST #2373: `(x as *S).f` auto-derefs the cast, as `(*(x as *S)).f`
    # does (#2526): emit_deref_operand_ptr resolves an `as *S` to S's address.
    # It fell to "unhandled EXPR_MEMBER in assignment", so the store failed.
    else if e.left.kind == EXPR_CAST
        var c_st: *StructDef = null
        var c_levels: i32 = 0
        let c_base: i32 = emit_deref_operand_ptr(s, e.left, @c_st, @c_levels)
        if c_base != 0 and c_levels == 1
            let c_idx: i32 = find_field_index(c_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if c_idx >= 0
                emit_member_gep_from_ptr(s, result, c_base, c_st, c_idx, get_field_type(c_st, c_idx))
                return

    # Pointer arithmetic case: (ptr + offset).field - e.left is EXPR_BINARY
    else if e.left.kind == EXPR_BINARY
        # For pointer arithmetic like (p.tokens + p.pos).kind
        # Need to trace back to find the original pointer type
        # Could be: (member + n), (ident + n), or ((expr + n) + m)
        var base_expr: *Expr = e.left.left
        # Walk through cascaded binary ops to find the base
        while base_expr.kind == EXPR_BINARY
            base_expr = base_expr.left

        if base_expr.kind == EXPR_MEMBER
            # The MEMBER access gives us a pointer field - get the type from the field
            var inner_result: MemberPtrResult
            emit_member_ptr(s, base_expr, @inner_result)
            if inner_result.success == 1
                let inner_field: *StructField = inner_result.field
                # If the field is a pointer to a struct, we can use it
                if inner_field.field_type == TYPE_PTR and inner_field.field_type_name_len > 0
                    let st: *StructDef = find_struct(s, StrView { ptr: (inner_field.field_type_name), len: (inner_field.field_type_name_len) as i64 })
                    if st != null
                        let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            # Evaluate the full binary expression to get the pointer
                            let ptr_val: i32 = emit_expr(s, e.left)
                            let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ptr_val)
                            emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                            return
        else if base_expr.kind == EXPR_IDENT
            # Direct identifier pointer arithmetic: (ptr_var + offset).field
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (base_expr.ident_ptr), len: (base_expr.ident_len) as i64 })
            if loc != null
                if loc.var_type == TYPE_PTR and loc.type_name_len > 0
                    let st: *StructDef = find_struct(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
                    if st != null
                        let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            # Evaluate the full binary expression to get the pointer
                            let ptr_val: i32 = emit_expr(s, e.left)
                            let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ptr_val)
                            emit_member_gep_from_ptr(s, result, base_ptr, st, field_idx, field)
                            return

    # Array element case: struct_array[idx].field
    # e.left is EXPR_INDEX, representing struct_array[idx]
    else if e.left.kind == EXPR_INDEX
        # AGAST #2440: `p[i].f` through a reference or pointer.
        if through_slice_refused(s, e.left) == 1
            return
        if emit_through_member_ptr(s, e, result) == 1
            return
        # AGAST #2332: `a[i].f` / `a[i][j].f` with `a: [N]*S`, whatever holds
        # the array.  The field arm below took it for an inline `[N]S`.
        if emit_array_elem_member_ptr(s, e, result) == 1
            return
        # AGAST #1509: `g[i][j].field` over a multi-dimensional array of
        # structs.  Any other member access on an N-D base is left
        # unresolved, so the caller reports it instead of guessing.
        var nd_depth: i32 = 0
        let nd_sh: *ArrayShape = nd_index_shape(s, e.left, @nd_depth)
        if nd_sh != null
            if nd_depth == nd_sh.rank and nd_sh.leaf_type == TYPE_STRUCT
                let nd_st: *StructDef = find_struct(s, StrView { ptr: (nd_sh.leaf_name), len: (nd_sh.leaf_name_len) as i64 })
                if nd_st != null
                    let nd_fidx: i32 = find_field_index(nd_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if nd_fidx >= 0
                        var nd_el: NdIndexPtr
                        emit_nd_index_ptr(s, e.left, @nd_el)
                        let nd_fp: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, nd_fp)
                        emit_str(s, IR_GEP_NAMED)
                        emit_name(s, StrView { ptr: (nd_st.name), len: (nd_st.name_len) as i64 })
                        emit_str(s, IR_PTR_SEP)
                        emit_reg(s, nd_el.reg)
                        emit_str(s, IR_I32_ZERO)
                        emit_int(s, nd_fidx as i64)
                        emit_str(s, IR_NL)
                        result.reg = nd_fp
                        result.field = get_field_type(nd_st, nd_fidx)
                        result.success = 1
            return
        # e.left.left is the array expression (could be var.field for struct array field)
        # e.left.right is the index expression
        # First, we need to get the array element as a pointer
        # If left.left is EXPR_MEMBER, it's something like parser.pos_defs[idx]
        if e.left.left.kind == EXPR_MEMBER
            # Get pointer to the array field
            var inner_result: MemberPtrResult
            emit_member_ptr(s, e.left.left, @inner_result)
            if inner_result.success == 1
                let inner_field: *StructField = inner_result.field
                # The field should be an array type with struct elements
                # For arrays, the element type name is in array_elem_type_name, not field_type_name
                if inner_field.field_type == TYPE_ARRAY and inner_field.array_elem_type_name_len > 0
                    # Find the element struct type
                    let elem_st: *StructDef = find_struct(s, StrView { ptr: (inner_field.array_elem_type_name), len: (inner_field.array_elem_type_name_len) as i64 })
                    if elem_st != null
                        let field_idx: i32 = find_field_index(elem_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx >= 0
                            let field: *StructField = get_field_type(elem_st, field_idx)
                            # Emit index expression
                            let idx_reg: i32 = emit_expr(s, e.left.right)
                            # GEP into the array to get the element
                            let elem_ptr: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, elem_ptr)
                            emit_str(s, IR_GEP_ARRAY)
                            emit_int(s, inner_field.array_size as i64)
                            emit_str(s, c" x %")
                            emit_name(s, StrView { ptr: (elem_st.name), len: (elem_st.name_len) as i64 })
                            emit_str(s, IR_RBRACK_PTR)
                            emit_reg(s, inner_result.reg)
                            emit_str(s, IR_I64_ZERO)
                            emit_reg(s, idx_reg)
                            emit_str(s, IR_NL)
                            # Now GEP into the element struct to get the field
                            emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
                            return
                # AGAST #184: `parent.fwd[i].field` where `fwd: **Foo` is a
                # pointer to an array of *Foo (skip-list / hash-bucket
                # pattern in tome.ritz's ZSetNode.forward).  Pre-fix this
                # fell through to "; ERROR: unhandled EXPR_MEMBER" and the
                # caller emitted `inttoptr i64 %.0 to ptr` (undef SSA).
                #
                # Lowering: load the field (a ptr to the *Foo array) →
                # GEP by index using ptr stride → load to materialise the
                # i-th *Foo → GEP into Foo for the requested member.
                else if inner_field.field_type == TYPE_PTR_PTR and inner_field.field_type_name_len > 0
                    let elem_st_pp: *StructDef = find_struct(s, StrView { ptr: (inner_field.field_type_name), len: (inner_field.field_type_name_len) as i64 })
                    if elem_st_pp != null
                        let field_idx_pp: i32 = find_field_index(elem_st_pp, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx_pp >= 0
                            let field_pp: *StructField = get_field_type(elem_st_pp, field_idx_pp)
                            let arr_base: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, arr_base)
                            emit_str(s, IR_LOAD_PTR)
                            emit_reg(s, inner_result.reg)
                            emit_str(s, IR_NL)
                            let idx_pp: i32 = emit_expr(s, e.left.right)
                            let slot_ptr: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, slot_ptr)
                            emit_str(s, c" = getelementptr ptr, ptr ")
                            emit_reg(s, arr_base)
                            emit_str(s, IR_I64_SEP)
                            emit_reg(s, idx_pp)
                            emit_str(s, IR_NL)
                            let elem_ptr_pp: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, elem_ptr_pp)
                            emit_str(s, IR_LOAD_PTR)
                            emit_reg(s, slot_ptr)
                            emit_str(s, IR_NL)
                            emit_member_gep_from_ptr(s, result, elem_ptr_pp, elem_st_pp, field_idx_pp, field_pp)
                            return
                # AGAST #3972: `s.rs[i].k` where `rs: *R` is a pointer field:
                # element i is `*(s.rs + i)`, an R, as `p[i].k` is for a `*R`
                # local (#1908).  Every form (read, store, `@`, `@&`) fell
                # through to "unhandled EXPR_MEMBER" / "cannot take address"
                # (lexis's `@sheet.rules[i].style_rule`).  A pointer to a Vec,
                # Span or String indexes through it and is taken above.
                else if ptr_field_struct_elem(s, inner_field) == 1
                    if emit_ptr_field_elem_member_ptr(s, e, result, inner_result.reg, inner_field) == 1
                        return

        # Array-of-struct local variable: `let arr: [N]St; arr[i].field`.
        # Earlier this fell through to the generic emit_expr path which
        # produced "; ERROR: unhandled EXPR_MEMBER" because emit_member_ptr
        # didn't recognise EXPR_INDEX with an ident base.  Resolves the
        # zeus poll-loop case `poll_fds[0].revents`.
        else if e.left.left.kind == EXPR_IDENT
            let arr_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.left.ident_ptr), len: (e.left.left.ident_len) as i64 })
            if arr_loc != null
                var pp_len: i32 = 0
                let pp_name: *u8 = ptr_ptr_local_struct(s, e.left.left, @pp_len)
                if arr_loc.var_type == TYPE_ARRAY and arr_loc.array_elem_type == TYPE_STRUCT and arr_loc.type_name_len > 0
                    let elem_st: *StructDef = find_struct(s, StrView { ptr: (arr_loc.type_name), len: (arr_loc.type_name_len) as i64 })
                    if elem_st != null
                        let field_idx: i32 = find_field_index(elem_st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx >= 0
                            let field: *StructField = get_field_type(elem_st, field_idx)
                            let idx_reg: i32 = emit_expr(s, e.left.right)
                            let elem_ptr: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, elem_ptr)
                            emit_str(s, IR_GEP_ARRAY)
                            emit_int(s, arr_loc.array_size as i64)
                            emit_str(s, c" x %")
                            emit_name(s, StrView { ptr: (elem_st.name), len: (elem_st.name_len) as i64 })
                            emit_str(s, IR_RBRACK_PTR)
                            emit_reg(s, arr_loc.reg)
                            emit_str(s, IR_I64_ZERO)
                            emit_reg(s, idx_reg)
                            emit_str(s, IR_NL)
                            emit_member_gep_from_ptr(s, result, elem_ptr, elem_st, field_idx, field)
                            return
                # AGAST #184: `var arr: [N]*Foo; arr[i].field` — array of
                # pointer-to-struct.  Pre-fix this fell through to "; ERROR:
                # unhandled EXPR_MEMBER" then a wrong-byte-stride load using
                # an undef base.  Affects tome's `update[k].forward[k]` (the
                # value-read RHS of `new_node.forward[k] = update[k].forward[k]`).
                #
                # Lowering: GEP into the array to get the *Foo slot, load it
                # to materialise the *Foo, then GEP into Foo for the field.
                else if arr_loc.var_type == TYPE_ARRAY and (arr_loc.array_elem_type == TYPE_PTR or arr_loc.array_elem_type == TYPE_PTR_PTR) and arr_loc.type_name_len > 0
                    let elem_st_ap: *StructDef = find_struct(s, StrView { ptr: (arr_loc.type_name), len: (arr_loc.type_name_len) as i64 })
                    if elem_st_ap != null
                        let field_idx_ap: i32 = find_field_index(elem_st_ap, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                        if field_idx_ap >= 0
                            let field_ap: *StructField = get_field_type(elem_st_ap, field_idx_ap)
                            let idx_reg_ap: i32 = emit_expr(s, e.left.right)
                            let slot_ap: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, slot_ap)
                            emit_str(s, IR_GEP_ARRAY)
                            emit_int(s, arr_loc.array_size as i64)
                            emit_str(s, c" x ptr], ptr ")
                            emit_reg(s, arr_loc.reg)
                            emit_str(s, IR_I64_ZERO)
                            emit_reg(s, idx_reg_ap)
                            emit_str(s, IR_NL)
                            let elem_ptr_ap: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, elem_ptr_ap)
                            emit_str(s, IR_LOAD_PTR)
                            emit_reg(s, slot_ap)
                            emit_str(s, IR_NL)
                            emit_member_gep_from_ptr(s, result, elem_ptr_ap, elem_st_ap, field_idx_ap, field_ap)
                            return
                # AGAST #1908: `p[i].field` where p is a `*St` local or param
                # (ritzunit's `slots[i].pid`).  Same address as `(p + i).field`.
                else if arr_loc.var_type == TYPE_PTR and arr_loc.type_name_len > 0
                    if emit_ptr_elem_member_ptr(s, e, result, StrView { ptr: (arr_loc.type_name), len: (arr_loc.type_name_len) as i64 }) == 1
                        return
                # AGAST #3114: `v[i].field` where v is a `**St` local (or a
                # `Some(v)` payload over `Option<**St>`): element i is a `*St`.
                else if pp_name != null
                    if emit_ptr_ptr_elem_member_ptr(s, e, result, StrView { ptr: (pp_name), len: (pp_len) as i64 }) == 1
                        return
                # AGAST #1487: `w[i].field` where w is a Vec<Struct> local.
                else if emit_vec_elem_member_ptr(s, e, result, arr_loc) == 1
                    return
            # AGAST #190: same shape but the base is a global array of struct
            # (`var g_fallback: [100]FallbackPage; g_fallback[i].used`).
            # Without this branch find_local_struct_name returned null and
            # the path fell through to "; ERROR: unhandled EXPR_MEMBER" with
            # a stale `%.0` flowing into the icmp downstream.  Sits at the
            # same indent as `if arr_loc != null` so it doesn't tangle with
            # the local branches above.
            if arr_loc == null
                let g_arr: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.left.ident_ptr), len: (e.left.left.ident_len) as i64 })
                if g_arr != null
                    if g_arr.var_type == TYPE_ARRAY and g_arr.array_elem_type == TYPE_STRUCT and g_arr.array_elem_type_name_len > 0
                        if emit_named_struct_array_member_ptr(s, e, result, StrView { ptr: (g_arr.name), len: (g_arr.name_len) as i64 }, g_arr.array_size, g_arr.array_elem_type_name, g_arr.array_elem_type_name_len) == 1
                            return
                    # AGAST #1908: `g[i].field` where g is a `*St` global
                    # (ritzunit's `g_junit_results[i].name`).
                    if g_arr.var_type == TYPE_PTR and g_arr.pointee_type_name_len > 0
                        if emit_ptr_elem_member_ptr(s, e, result, StrView { ptr: (g_arr.pointee_type_name), len: (g_arr.pointee_type_name_len) as i64 }) == 1
                            return
                # AGAST #3325: `KS[i].len` over a `const KS: [N]P = [...]`,
                # declared `[N x %P]` by emit_const_array_entry.
                else
                    let c_arr: *ConstEntry = find_const_entry(s, StrView { ptr: (e.left.left.ident_ptr), len: (e.left.left.ident_len) as i64 })
                    if c_arr != null and c_arr.const_type == TYPE_ARRAY and c_arr.array_elem_type == TYPE_STRUCT and c_arr.array_elem_type_name_len > 0 and c_arr.value_expr != null and (c_arr.value_expr.kind == EXPR_ARRAY_LIT or const_struct_fill_global(c_arr) == 1)
                        if emit_named_struct_array_member_ptr(s, e, result, StrView { ptr: (c_arr.name), len: (c_arr.name_len) as i64 }, c_arr.array_size, c_arr.array_elem_type_name, c_arr.array_elem_type_name_len) == 1
                            return

        # AGAST #3114: `(*v)[i].field` with v a `**St` local: `*v` is the
        # `*St` emit_ptr_elem_member_ptr strides, as for `p[i].field`.
        # AGAST #3148: and an `@*St` / `@&*St` local or param.
        else if e.left.left.kind == EXPR_UNARY and e.left.left.op == OP_DEREF
            var dpp_len: i32 = 0
            let dpp_name: *u8 = deref_ptr_local_struct(s, e.left.left.operand, @dpp_len)
            if dpp_name != null
                if emit_ptr_elem_member_ptr(s, e, result, StrView { ptr: (dpp_name), len: (dpp_len) as i64 }) == 1
                    return

        # AGAST #2870: `mkp()[i].field` with `mkp() -> *St`: element i of what
        # the call points at is a place, as ritz0 has it (`mk().a` isn't, and
        # stays with the by-value arm above).  The call is emitted once, as
        # the pointer emit_ptr_elem_member_ptr strides.
        else if e.left.left.kind == EXPR_CALL or e.left.left.kind == EXPR_METHOD
            var pc_name: *u8 = null
            var pc_len: i32 = 0
            call_result_pointee_struct(s, e.left.left, @pc_name, @pc_len)
            if pc_len > 0
                if emit_ptr_elem_member_ptr(s, e, result, StrView { ptr: (pc_name), len: (pc_len) as i64 }) == 1
                    return

# AGAST #1908: address of `p[i].field` for `e` = EXPR_MEMBER over EXPR_INDEX,
# where `p` (e.left.left) is a `*St` value and `st_name` names St.  The
# pointer is an i64 value in ritz1, so: inttoptr, GEP one St per index, then
# the field.  Returns 1 with `result` filled, or 0 if St or the field is
# unknown (the caller falls through to the "unhandled EXPR_MEMBER" error).
# AGAST #2332: address of `a[i].field` and `a[i][j].field` for `a: [N]*S`.
# Returns 1 when it took `e`.
fn emit_array_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    if array_elem_pointee(s, e.left.left, @name, @name_len) == TYPE_STRUCT
        return emit_ptr_elem_member_ptr(s, e, result, StrView { ptr: (name), len: (name_len) as i64 })
    # AGAST #2369: and `a[i].f` with `a: [N]@S` or `[N]@&S`, whose element
    # refers to an S as a `*S` one points at it.
    if array_elem_pointee(s, e.left, @name, @name_len) != TYPE_STRUCT and array_elem_referent(s, e.left, @name, @name_len) != TYPE_STRUCT
        return 0
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (name_len) as i64 })
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return 0
    # A reference element may come back a `ptr` rather than an i64.
    let elem_ptr: i32 = i64_value_to_ptr(s, e.left, emit_expr(s, e.left))
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1

# AGAST #3972: address of `x.f[i].field` for `e`, where `f` is a `*St` field
# whose slot is at `field_reg`: load the pointer, GEP one St per index, then
# the field.  Returns 1 with `result` filled, or 0 if St or the field is unknown.
fn emit_ptr_field_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, field_reg: i32, f: *StructField) -> i32
    let st: *StructDef = find_struct(s, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return 0
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let elem_ptr: i32 = emit_ptr_field_elem_addr(s, field_reg, f, TYPE_STRUCT, idx_reg)
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1

fn emit_ptr_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, st_name_sv: StrView) -> i32
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    let st: *StructDef = find_struct(s, StrView { ptr: (st_name), len: (st_name_len) as i64 })
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return 0
    let elem_ptr: i32 = emit_ptr_elem_addr(s, e.left, st)
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1

# The address of `p[i]` for the index `ie`, where `p` (ie.left) is a `*St`
# value: `p` then `i`, each emitted once, and one St per index.  Shared by
# `p[i].field` (#1908) and the method receiver `mkp()[i].m()` (AGAST #2299).
pub fn emit_ptr_elem_addr(s: *EmitterState, ie: *Expr, st: *StructDef) -> i32
    let ptr_val: i32 = emit_expr(s, ie.left)
    let idx_reg: i32 = emit_expr(s, ie.right)
    let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ptr_val)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    elem_ptr

# AGAST #3114: St when `e` names a two-level `**St` local -- `let v: **St`
# (#1933) or a `Some(v)` payload over `Option<**St>` (#3047), both registered
# pointee `*`, inner pointee St -- else null.  A `***St` is not one.
pub fn ptr_ptr_local_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if e == null or e.kind != EXPR_IDENT
        return null
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if lv == null or lv.var_type != TYPE_PTR_PTR or lv.pointee_type != TYPE_PTR or lv.inner_pointee_type != TYPE_STRUCT
        return null
    if lv.type_name_len == 0 or find_struct(s, StrView { ptr: (lv.type_name), len: (lv.type_name_len) as i64 }) == null
        return null
    *out_len = lv.type_name_len
    lv.type_name

# AGAST #3148: St when `*e` is a `*St`: ptr_ptr_local_struct's `**St`, or an
# `@*St` / `@&*St` local or param, which records St as its inner pointee as a
# `**St` does (#3108, #3131).  Only `(*r)[i].f` asks: `r[i]` on a reference
# isn't the `**St` stride ptr_ptr_local_struct's other callers take.
fn deref_ptr_local_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    let pp: *u8 = ptr_ptr_local_struct(s, e, out_len)
    if pp != null or e == null or e.kind != EXPR_IDENT
        return pp
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if lv == null or ref_to_ptr(lv) == 0 or lv.inner_pointee_type != TYPE_STRUCT
        return null
    if lv.type_name_len == 0 or find_struct(s, StrView { ptr: (lv.type_name), len: (lv.type_name_len) as i64 }) == null
        return null
    *out_len = lv.type_name_len
    lv.type_name

# AGAST #3114: address of `v[i].field` with `v` a `**St` local: element i is
# the `*St` in the i-th pointer slot, so stride by pointers, load it, then
# GEP into St.  Returns 1 with `result` filled, or 0 if the field is unknown.
fn emit_ptr_ptr_elem_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult, st_name_sv: StrView) -> i32
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    let st: *StructDef = find_struct(s, StrView { ptr: (st_name), len: (st_name_len) as i64 })
    if st == null
        return 0
    let field_idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if field_idx < 0
        return 0
    let base_ptr: i32 = i64_value_to_ptr(s, e.left.left, emit_expr(s, e.left.left))
    let idx_reg: i32 = emit_expr(s, e.left.right)
    let slot_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, slot_ptr)
    emit_str(s, c" = getelementptr ptr, ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_LOAD_PTR)
    emit_reg(s, slot_ptr)
    emit_str(s, IR_NL)
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1


# =============================================================================
# Tagged-enum is_ok / is_err / is_some / is_none inline (AGAST #134 companion)
# =============================================================================

# Inline `.is_ok()` / `.is_err()` / `.is_some()` / `.is_none()` for Result$/
# Option$ receivers. Ritzlib's `result_is_ok<T,E>` is generic and isn't
# monomorphized in isolation, so without inlining the method resolves to an
# undefined extern. This mirrors try_emit_enum_unwrap's packed-i64 contract.
# Returns i64 register on success, -1 to fall through to emit_expr_method.
# Any other receiver -- a call's result, a method's, a field -- is resolved
# by emit_expr_method, which calls try_emit_enum_pred_at (AGAST #3061).
fn try_emit_enum_is_ok(s: *EmitterState, e: *Expr) -> i32
    # Receiver must be an ident bound to a Result$/Option$ local.
    if e.left == null
        return 0 - 1
    if e.left.kind != EXPR_IDENT
        return 0 - 1
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc == null
        return 0 - 1
    if is_tagged_enum_type(StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 }) == 0
        return 0 - 1
    let want_carrier: i32 = enum_pred_want(e)
    if want_carrier < 0
        return 0 - 1

    # Post-task-133 layout: Result$/Option$ is `{ i8 tag, [N x i8] payload }`.
    # Receiver slot holds that struct.  Pointer-typed locals (*T, @T) store a
    # pointer to the struct; load it through first to reach the aggregate.
    let ptr_reg: i32 = emit_load_levels(s, loc.reg, local_struct_levels(loc))
    emit_enum_tag_test(s, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 }, ptr_reg, want_carrier)

# AGAST #3061: the predicate on a receiver emit_expr_method resolved --
# `mk().is_some()`, `h.get().is_none()`, `h.o.is_ok()`.  `recv` holds the
# enum's address, or (`recv_is_ptr_of_ptr == 1`) a pointer to it, as
# try_emit_enum_unwrap takes them.  -1 when `e` isn't a predicate on a
# tagged enum.
pub fn try_emit_enum_pred_at(s: *EmitterState, e: *Expr, type_name_sv: StrView, recv: i32, recv_is_ptr_of_ptr: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if recv <= 0 or is_tagged_enum_type(StrView { ptr: (type_name), len: (type_name_len) as i64 }) == 0
        return 0 - 1
    let want_carrier: i32 = enum_pred_want(e)
    if want_carrier < 0
        return 0 - 1
    var ptr_reg: i32 = recv
    if recv_is_ptr_of_ptr == 1
        ptr_reg = emit_load_levels(s, recv, 1)
    emit_enum_tag_test(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, ptr_reg, want_carrier)

# 1 for `.is_ok()` / `.is_some()`, 0 for `.is_err()` / `.is_none()`, -1 for
# anything else (only the 0-arg forms are predicates).
fn enum_pred_want(e: *Expr) -> i32
    if e.args != null
        return 0 - 1
    var want_carrier: i32 = 0 - 1   # 1 = is_ok/is_some, 0 = is_err/is_none
    if e.ident_len == 5
        # "is_ok" = 105 115 95 111 107
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 111 and *(e.ident_ptr + 4) == 107
            want_carrier = 1
    if e.ident_len == 6
        # "is_err" / "is_err" = 105 115 95 101 114 114
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 101 and *(e.ident_ptr + 4) == 114 and *(e.ident_ptr + 5) == 114
            want_carrier = 0
    if e.ident_len == 7
        # "is_some" = 105 115 95 115 111 109 101
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 115 and *(e.ident_ptr + 4) == 111 and *(e.ident_ptr + 5) == 109 and *(e.ident_ptr + 6) == 101
            want_carrier = 1
        # "is_none" = 105 115 95 110 111 110 101
        if *(e.ident_ptr + 0) == 105 and *(e.ident_ptr + 1) == 115 and *(e.ident_ptr + 2) == 95 and *(e.ident_ptr + 3) == 110 and *(e.ident_ptr + 4) == 111 and *(e.ident_ptr + 5) == 110 and *(e.ident_ptr + 6) == 101
            want_carrier = 0
    want_carrier

# The i64 0/1 of the tag test on the `%<type_name>` at `ptr_reg`.
fn emit_enum_tag_test(s: *EmitterState, type_name_sv: StrView, ptr_reg: i32, want_carrier: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    # GEP to tag (field 0) and load the i8 directly.  Ok/Some = 0; Err/None = 1.
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, IR_NL)

    # Carrier (Ok/Some) iff tag == 0; null (Err/None) iff tag != 0.
    let cmp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cmp)
    if want_carrier == 1
        emit_str(s, c" = icmp eq i8 ")
    else
        emit_str(s, c" = icmp ne i8 ")
    emit_reg(s, tag)
    emit_str(s, c", 0  ; is_ok/is_err tag check\n")
    let wide: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, cmp)
    return wide

# =============================================================================
# Try operator (AGAST #134)
# =============================================================================

# AGAST #1898: the Err / None carrier in `inner_slot` (a `%inner`), rebuilt
# as the enclosing fn's return type in a fresh slot, which is returned.  The
# tag byte is copied; for a Result the Err payload's bytes are copied field 2
# to field 2 — E's size when it can be measured, else the smaller payload.
fn emit_try_err_relayout(s: *EmitterState, inner_slot: i32, inner_sv: StrView) -> i32
    var inner: *u8 = inner_sv.ptr
    var inner_len: i32 = inner_sv.len as i32
    let out_name: *u8 = s.ret_type_name
    let out_len: i32 = s.ret_type_name_len
    let out: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, out)
    emit_name(s, StrView { ptr: (out_name), len: (out_len) as i64 })
    emit_str(s, c"  ; try: Err relayout\n")
    entry_alloca_reg_end(s)
    emit_str(s, IR_STORE_STRUCT)
    emit_name(s, StrView { ptr: (out_name), len: (out_len) as i64 })
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, out)
    emit_str(s, IR_NL)
    # Tag: field 0 of both.
    let tag: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, inner_slot)
    emit_str(s, c"\n  store i8 ")
    emit_reg(s, tag)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, out)
    emit_str(s, IR_NL)
    # Err payload bytes (Option's None carries none).
    var nbytes: i64 = 0
    if name_eq(StrView { ptr: (out_name), len: (6) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1 and name_eq(StrView { ptr: (inner), len: (6) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        var e_len: i32 = 0
        let e: *u8 = tagged_enum_arg(s, StrView { ptr: (out_name), len: (out_len) as i64 }, 1, @e_len)
        var e_align: i64 = 1
        if e != null
            nbytes = mangled_type_size_align(s, StrView { ptr: (e), len: (e_len) as i64 }, @e_align)
        if nbytes == 0
            var pad_in: i64 = 0
            var pad_out: i64 = 0
            nbytes = tagged_enum_layout(s, StrView { ptr: (inner), len: (inner_len) as i64 }, @pad_in)
            let n_out: i64 = tagged_enum_layout(s, StrView { ptr: (out_name), len: (out_len) as i64 }, @pad_out)
            if n_out < nbytes
                nbytes = n_out
    if nbytes > 0
        let src: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, src)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (inner), len: (inner_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, inner_slot)
        emit_str(s, c", i32 0, i32 2\n")
        let dst: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, dst)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (out_name), len: (out_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, out)
        emit_str(s, c", i32 0, i32 2\n")
        let bytes: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, bytes)
        emit_str(s, c" = load [")
        emit_int(s, nbytes)
        emit_str(s, c" x i8], ptr ")
        emit_reg(s, src)
        emit_str(s, c"\n  store [")
        emit_int(s, nbytes)
        emit_str(s, c" x i8] ")
        emit_reg(s, bytes)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, dst)
        emit_str(s, IR_NL)
    out

# AGAST #3238: the Result / Option an EXPR_METHOD `inner` returns, from the
# method's FnDef (`r.rd()` -> `Result$u32$i32`).  1 when found, else 0.
pub fn try_method_carrier(s: *EmitterState, inner: *Expr, out_name: **u8, out_len: *i32) -> i32
    if inner == null or inner.kind != EXPR_METHOD
        return 0
    let md: *FnDef = method_call_def(s, inner)
    if md == null or md.return_type != TYPE_STRUCT or md.return_type_name_len <= 0
        return 0
    if is_tagged_enum_type(StrView { ptr: (md.return_type_name), len: (md.return_type_name_len) as i64 }) == 0
        return 0
    *out_name = md.return_type_name
    *out_len = md.return_type_name_len
    1

# AGAST #4455: the name ritz0 prints for the enclosing fn's return type after
# `(got ` — `_resolve_fn_return_enum_name`'s enum name, else `None`.  Only a
# registered enum (a user enum or a Result$/Option$ instantiation) names
# itself; a struct, pointer, ref or absent return is `None`.
fn try_ret_enum_name(s: *EmitterState) -> StrView
    if s.fn_ret_type == TYPE_STRUCT and s.ret_type_name != null and s.ret_type_name_len > 0
        let ret_sv: StrView = StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }
        if is_enum_type(ret_sv) == 1 or is_tagged_enum_type(ret_sv) == 1
            return ret_sv
    StrView { ptr: (c"None"), len: (4) as i64 }

# ritz0's `fn_ret_type_name` for the Result message: a struct or enum's name,
# a primitive's keyword (`got i32` for a scalar fn), else `None`.
fn try_ret_type_name(s: *EmitterState) -> StrView
    if s.fn_ret_type == TYPE_STRUCT and s.ret_type_name != null and s.ret_type_name_len > 0
        return StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }
    let pn: *u8 = primitive_name_from_type(s.fn_ret_type)
    if pn != null
        return StrView { ptr: (pn), len: (primitive_name_len(s.fn_ret_type)) as i64 }
    StrView { ptr: (c"None"), len: (4) as i64 }

# AGAST #4455 (LANGUAGE_SPEC §14.2): `?` requires the enclosing function's
# return carrier to match the operand's — an Option for an Option, a Result
# for a Result.  Nothing upstream enforced it: with a scalar-returning fn the
# early return lowered to `ret % %.N` (an empty type name), clang rejected the
# IR, and the compiler exited 0, so check_doc_examples counted the program as
# COMPILED.  ritz0 refuses at the emitter; this mirrors its messages, located
# at the `?` operand as ritz0's are.
#
# `?` on a Result also needs a Result-returning fn with the same E (§14.2,
# AGAST #4467): canonical (mangled) name equality, aliases already resolved by
# monomorphisation.  The different-E message names no type because ritz0 and
# ritz1 spell instantiations differently.
# 1 when refused (the diagnostic is emitted), 0 when the carriers agree.
fn try_carrier_refused(s: *EmitterState, e: *Expr, carrier: *u8, carrier_len: i32) -> i32
    if carrier == null or carrier_len <= 0
        return 0
    let carrier_sv: StrView = StrView { ptr: (carrier), len: (carrier_len) as i64 }
    let ret_sv: StrView = StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }

    if name_eq(carrier_sv, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1 or strview_starts_with(carrier_sv, StrView { ptr: (c"Option$"), len: (7) as i64 })
        # ritz0: the fn must itself return an Option.
        if name_eq(ret_sv, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1 or strview_starts_with(ret_sv, StrView { ptr: (c"Option$"), len: (7) as i64 })
            return 0
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprints("Try operator on an Option used in a function that does not return an Option (got ")
        eprints(try_ret_enum_name(s))
        eprints(")\n")
        return 1

    if strview_starts_with(carrier_sv, StrView { ptr: (c"Result$"), len: (7) as i64 })
        # §14.2: the fn must return a Result, not just any enum.  #4455's
        # weaker check let a Result operand into an Option- or user-enum-
        # returning fn.
        if s.fn_ret_type == TYPE_STRUCT and s.ret_type_name != null and s.ret_type_name_len > 0
            if strview_starts_with(ret_sv, StrView { ptr: (c"Result$"), len: (7) as i64 })
                # ... and with the same E (tagged_enum_arg splits `Result$T$E`).
                var op_e_len: i32 = 0
                let op_e: *u8 = tagged_enum_arg(s, carrier_sv, 1, @op_e_len)
                var ret_e_len: i32 = 0
                let ret_e: *u8 = tagged_enum_arg(s, ret_sv, 1, @ret_e_len)
                if op_e != null and ret_e != null and op_e_len == ret_e_len
                    if name_eq(StrView { ptr: (op_e), len: (op_e_len) as i64 }, StrView { ptr: (ret_e), len: (ret_e_len) as i64 }) == 1
                        return 0
                emit_nd_error_begin(s, e.span.line, e.span.col)
                eprints("Try operator on a Result used in a function returning a Result with a different error type\n")
                return 1
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprints("Try operator used in function not returning Result type (got ")
        eprints(try_ret_type_name(s))
        eprints(")\n")
        return 1
    return 0

# Lower `expr?`:
#   * On Some/Ok: extract payload from the carrier struct, continue with it.
#   * On None/Err: early-return the whole struct back to the caller.
#
# Post-task-133 layout: Result$/Option$ is `{ i8 tag, [N x i8] payload }` with
# tag 0 = Ok/Some (carrier) and tag 1 = Err/None.  The enclosing function's
# return type must carry the same carrier (§14.2); try_carrier_refused checks
# that and refuses otherwise (AGAST #4455 — the briefing does not ensure it).
# Because the Err/None encoding is byte-identical we can return the struct
# verbatim without a rebuild.
fn emit_expr_try(s: *EmitterState, e: *Expr) -> i32
    # Evaluate the inner Result/Option (yields a struct SSA register).
    let value: i32 = emit_expr(s, e.left)

    # Resolve the carrier's LLVM struct type name.  Prefer the inner
    # expression's declared type; fall back to the enclosing fn's return
    # type when the inner is opaque (same type by definition of `?`).
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    var have_inner: i32 = resolve_scrutinee_enum(s, e.left, @enum_name, @enum_name_len)
    # AGAST #3238: a method's Result is its FnDef's, not the fn's: `r.rd()?`
    # in a `-> Result<P, E>` fn spilled a `%Result$u32$E` as `%Result$P$E`.
    if have_inner == 0
        have_inner = try_method_carrier(s, e.left, @enum_name, @enum_name_len)
    if have_inner == 0
        enum_name = s.ret_type_name
        enum_name_len = s.ret_type_name_len

    # AGAST #4455: refuse before lowering anything that assumes the enclosing
    # fn can receive the early return.  An unlocated empty type name used to
    # reach the IR and only clang noticed.
    if try_carrier_refused(s, e, enum_name, enum_name_len) == 1
        return 0

    # Spill the struct so we can GEP for tag + payload.
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, c"  ; try: spill scrutinee\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, value, slot)

    # Load tag byte at field 0.
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    let tag: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, IR_NL)

    # Ok/Some (tag == 0) → fall through to the Ok branch; else early-return.
    let tag_ok: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ok)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag)
    emit_str(s, c", 0  ; try: tag == carrier\n")

    let ok_label: i32 = next_label(s)
    let err_label: i32 = next_label(s)

    emit_str(s, c"  br i1 ")
    emit_reg(s, tag_ok)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, ok_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, err_label)
    emit_str(s, IR_NL)

    # Err/None branch: early-return the carrier as the enclosing fn's
    # return type.  AGAST #1898: inner (e.g. Result$Big$i32) and outer
    # (Result$i32$i32) are laid out per instantiation like ritz0's, so the
    # Err payload's offset depends on the Ok type: unless the two names
    # match, rebuild the outer value — zeroed, tag copied, E's bytes copied
    # payload to payload — rather than reinterpreting the inner bytes.
    begin_block(s, err_label)
    var ret_slot: i32 = slot
    if is_tagged_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1 and is_tagged_enum_type(StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1 and name_eq(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 0
        ret_slot = emit_try_err_relayout(s, slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    if s.ret_sret == 1
        # AGAST #1730 — never taken today (tagged enums keep their ABI; see
        # struct_ret_uses_sret), but a `ret %T` in an sret fn is invalid IR.
        emit_sret_ret_from_ptr(s, ret_slot)
    else
        let ret_reg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ret_reg)
        emit_str(s, IR_LOAD_NAMED)
        emit_name(s, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, ret_slot)
        emit_str(s, IR_NL)
        emit_str(s, c"  ret %")
        emit_name(s, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, ret_reg)
        emit_str(s, IR_NL)

    # Ok/Some branch: load the payload from field 2 (#1898).  For scalar payloads,
    # emit_variant_struct stores them as i64 so an i64 load is fine.  For
    # struct payloads (e.g., Result<Vec<u8>, E>'s Ok holds a 24-byte
    # %Vec$u8), an i64 load truncates to 8 bytes — corrupting the value.
    # Detect Result$<Struct>... / Option$<Struct> with
    # tagged_enum_payload_struct.  When found, load that struct type directly.
    begin_block(s, ok_label)
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 2\n")

    # The Ok/Some payload's struct or user-enum type, if any (e.g.
    # "Result$Vec$u8$E" → "Vec$u8"; "Option$Opt" → "Opt"; "Option$i32" →
    # none).  AGAST #2105: a user enum is stored as its aggregate (#1466),
    # so it loads as one, exactly as the match-bind side does (#2100).
    var pay_name_len: i32 = 0
    let pay_name: *u8 = tagged_enum_payload_named(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, @pay_name_len, 1)

    if pay_name == null
        # Scalar payload at its own width (AGAST #1898), widened to i64.
        return emit_tagged_payload_load(s, pay_ptr, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 0)
    # Aggregate payload — load the actual type so the 24-byte (or larger)
    # value is preserved for the caller's let-decl / arg coercion.
    let payload: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, payload)
    emit_str(s, IR_LOAD_NAMED)
    emit_name(s, StrView { ptr: (pay_name), len: (pay_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, pay_ptr)
    emit_str(s, c"  ; try: unwrap struct payload\n")
    return payload

# AGAST #3040 (LARB R19): `n as E` with `n` an integer, for any enum `E`, is
# ritz0's located refusal at the `as`.  An integer may name no variant; the
# way in is a `match`.  ritz1 stored the i64 as the `%E` and only llc refused
# the IR.  An unannotated local reads as TYPE_I64 whatever it holds, so an
# operand that resolves to an enum is `e as E`, not judged here.  1 when refused.
fn int_as_enum_refused(s: *EmitterState, e: *Expr) -> i32
    if e.op != TYPE_STRUCT or e.ident_len <= 0 or enum_find(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0
        return 0
    if ty_int_bits(expr_slot_ty(e.left)) == 0
        return 0
    var en: *u8 = null
    var en_len: i32 = 0
    if resolve_scrutinee_enum(s, e.left, @en, @en_len) != 0
        return 0
    var n: i32 = 0
    let head: *u8 = c"an integer can't be converted to enum `"
    let tail: *u8 = c"` with `as`: it may name no variant; `match` on it"
    let msg: *u8 = ctor_join(StrView { ptr: (head), len: (strlen(head) as i32) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (tail), len: (strlen(tail) as i32) as i64 }, @n)
    var line: i32 = e.bracket.line
    var col: i32 = e.bracket.col
    if line == 0
        line = e.span.line
        col = e.span.col
    emit_nd_error(s, line, col, msg)
    return 1

# =============================================================================
# Expression Emission - Single function to avoid mutual recursion
# =============================================================================

# AGAST #3234: the `f()[i]` of `e`'s field / index chain (or a method's
# receiver's), `f` a call returning an array by value: `mka()[1].x`.  null if
# there is none.  (`mv().a[1]` has none: emit_member_ptr spills `mv()`.)
pub fn call_array_index_root(s: *EmitterState, e: *Expr) -> *Expr
    if e.kind != EXPR_MEMBER and e.kind != EXPR_METHOD and e.kind != EXPR_INDEX
        return null
    var x: *Expr = e
    if x.kind == EXPR_METHOD
        x = x.left   # the receiver
    while x != null and (x.kind == EXPR_INDEX or x.kind == EXPR_MEMBER)
        let c: *Expr = x.left
        if x.kind == EXPR_INDEX and c != null and (c.kind == EXPR_CALL or c.kind == EXPR_METHOD)
            if x.right == null or x.right.kind == EXPR_RANGE or call_ret_array(s, c) == null
                return null
            return x
        x = c
    null

var g_call_array_spills: i32 = 0

# "#a" + up to 20 digits of an i64 + NUL (AGAST #1820: no magic alloc sizes).
const CALL_ARRAY_NAME_BUF: i64 = 24

# A fresh name `#aK` for the local emit_call_array_index spills to.
fn call_array_local_name() -> *u8
    g_call_array_spills = g_call_array_spills + 1
    let name: *u8 = malloc(CALL_ARRAY_NAME_BUF)
    *name = 35   # '#': no identifier has one
    *(name + 1) = 97   # 'a'
    let len: i32 = 2 + fmt_i64_into(name + 2, g_call_array_spills as i64) as i32
    *(name + len) = 0
    name

# AGAST #3234: an element of a call's by-value array is a value, read from a
# spill as a field of a call's struct is (#2294).  The call is evaluated once,
# into a hidden `[N]T` local `#aK`, and `e` is emitted with `#aK[i]` in place of
# `f()[i]`, so every route a local array's element takes (a field, a method
# whose `self` is shared, a copy) is this one's.  The node is put back after:
# a generic body is emitted once per instantiation.  A store or `@&` into it,
# and a mutating `self`, are refused before emission (ref_value.ritz, on Sema:
# #2518, #4011).
#
# call_array_spill does the first half: it emits the call and puts the local
# in `root.left`, returning the call for call_array_unspill to put back.
pub fn call_array_spill(s: *EmitterState, root: *Expr) -> *Expr
    let call: *Expr = root.left
    let name: *u8 = call_array_local_name()
    let len: i32 = strlen(name) as i32
    let ra: *Param = call_ret_array(s, call)
    let slot: i32 = emit_call_array_temp(s, call, ra)
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, slot, TYPE_ARRAY, StrView { ptr: (ra.param_type_name), len: (ra.param_type_name_len) as i64 }, TYPE_I64, ra.param_array_size, ra.param_array_elem_type)
    let loc: *LocalVar = local_at(s, s.local_count - 1)
    loc.array_elem_pointee = ra.param_array_elem_pointee
    let id: *Expr = malloc(sizeof(Expr)) as *Expr
    memset(id as *u8, 0, sizeof(Expr))
    id.kind = EXPR_IDENT
    id.span = call.span
    id.ident_ptr = name
    id.ident_len = len
    root.left = id
    call

pub fn call_array_unspill(root: *Expr, call: *Expr)
    root.left = call

fn emit_call_array_index(s: *EmitterState, e: *Expr, root: *Expr) -> i32
    let call: *Expr = call_array_spill(s, root)
    let r: i32 = emit_expr(s, e)
    call_array_unspill(root, call)
    r

# The emitter's answers for RITZ1_SEMA_PROBE (sema_probe.ritz's
# SemaProbeEmitter), so sema_probe imports no emitter module (AGAST #3513).
fn probe_bool_kind(s: *u8, e: *Expr) -> i32
    bool_kind(s as *EmitterState, e)

fn probe_slot_type(s: *u8, e: *Expr) -> i32
    synth_slot_ty(s as *EmitterState, e)

fn probe_source_file() -> *u8
    fn_source_file(emitter_current_fn())

pub fn emit_expr(s: *EmitterState, e: *Expr) -> i32
    # AGAST #3739: a temporary's slot is located at the innermost expression
    # being emitted when it was made (frame_limit.ritz).
    if e == null or e.span.line == 0
        return emit_expr_body(s, e)
    let fm_line: i32 = s.fm_line
    let fm_col: i32 = s.fm_col
    frame_mark(s, e.span.line, e.span.col)
    let r: i32 = emit_expr_body(s, e)
    frame_mark(s, fm_line, fm_col)
    r

fn emit_expr_body(s: *EmitterState, e: *Expr) -> i32
    # Safety check for null expression
    if e == null
        eprints_cstr(c"ERROR: emit_expr called with null expression!\n")
        return 0
    if sema_probe_on() == 1
        var em: SemaProbeEmitter = SemaProbeEmitter { s: s as *u8, bool_kind: probe_bool_kind, slot_type: probe_slot_type, source_file: probe_source_file }
        sema_probe_expr(@em, e)
    let ca_root: *Expr = call_array_index_root(s, e)
    if ca_root != null
        return emit_call_array_index(s, e, ca_root)
    if e.kind == EXPR_INT_LIT
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, e.int_val)
        emit_str(s, IR_NL)
        return result

    else if e.kind == EXPR_FLOAT_LIT
        # Float literal: emit as a `double` constant via `fadd 0.0, <lit>`.
        # We default to double — narrowing to float happens at the call/store
        # site via fptrunc when the target type is f32.  The raw decimal
        # repr from the source is reused verbatim; LLVM accepts standard
        # decimal float literals (e.g. `1.5`, `3.14`).
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, c" = fadd double 0.0, ")
        emit_name(s, StrView { ptr: (e.string_ptr), len: (e.string_len) as i64 })
        emit_str(s, IR_NL)
        return result

    else if e.kind == EXPR_CHAR_LIT
        # Character literals: emit as i8 value, then extend to i64 for uniformity
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, e.int_val)  # int_val holds the char's ASCII value
        emit_str(s, IR_NL)
        return result

    else if e.kind == EXPR_IDENT
        return emit_expr_ident(s, e)
    else if e.kind == EXPR_BINARY
        return emit_expr_binary(s, e)
    else if e.kind == EXPR_UNARY
        return emit_expr_unary(s, e)
    else if e.kind == EXPR_CALL
        # A call registered in si_once runs once; its second emission reuses
        # the first's register. Two users:
        #   - a Vec view's low bound, in both of its fields (AGAST #2501);
        #   - a call in the place of `x op= v`, shared by its read and its
        #     store (monomorph.ritz note_compound_calls, AGAST #2529).
        let call_once: i32 = si_once_find(e)
        if call_once >= 0
            let call_prev: i32 = si_once_take(call_once)
            if call_prev >= 0
                return call_prev
        let call_lent: i32 = own_lent_mark()
        let call_reg: i32 = emit_expr_call(s, e)
        own_drop_lent(s, call_lent)     # AGAST #3050: what its args lent
        own_note_temp(s, e, call_reg)   # AGAST #2165: a temporary's drop
        if call_once >= 0
            si_once_set(call_once, call_reg)
        return call_reg
    else if e.kind == EXPR_INDEX
        return emit_expr_index(s, e)
    else if e.kind == EXPR_CAST
        # `expr as <type>` — `e.op` holds the target type kind.
        # Float ↔ int needs explicit instructions (sitofp / fptosi /
        # fptrunc / fpext); same-class casts pass through as i64 wraps
        # (the unified value model already keeps narrow ints in i64).
        let target_ty: i32 = e.op
        own_raw_written(s, e)   # AGAST #4033: `@x as *U` writes x
        if struct_cast_to_int_refused(s, e) == 1   # AGAST #3008
            return 0
        if int_as_enum_refused(s, e) == 1          # AGAST #3040
            return 0
        # AGAST #2288: `c as C` with `c:& C` is the referent, as in ritz0.
        # It read as the pointer and ptrtoint'd it.
        if target_ty == TYPE_STRUCT and e.ident_len > 0 and lent_referent_local(s, e.left) != null
            let referent: i32 = emit_lent_referent(s, e.left, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if referent != 0
                return referent
        # AGAST #3004: `r as C` with `r: @C`, `@&C` or `*C` is a copy of the
        # referent, as in ritz0.  It emitted `r`'s address as the `%C`.
        if target_ty == TYPE_STRUCT and ref_cast_reads_referent(s, e) == 1
            let ref_addr: i32 = i64_value_to_ptr(s, e.left, emit_expr(s, e.left))
            let ref_val: i32 = next_reg(s)
            emit_struct_load_or_defer(s, TYPE_STRUCT, ref_val, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, ref_addr, null, 0)
            return ref_val
        # AGAST #1652: `s as *S` with `s: @&S` (a `ptr`) must yield the i64
        # address the rest of the value model expects; only `as @&T` keeps it.
        # AGAST #1754: and `p as @&S` (`p: *S`, i64) must inttoptr into the
        # `ptr` an `@&T` is lowered as.
        let cast_raw: i32 = emit_expr(s, e.left)
        var cast_src: i32 = cast_raw
        if target_ty != TYPE_MUT_REF
            cast_src = ptr_value_to_i64(s, e.left, cast_raw)
        else
            cast_src = i64_value_to_ptr(s, e.left, cast_raw)
        var src_name: *u8 = null
        var src_name_len: i32 = 0
        if e.left.kind == EXPR_IDENT
            let lv2: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if lv2 != null
                src_name = lv2.type_name
                src_name_len = lv2.type_name_len
        var src_ty: i32 = expr_slot_ty(e.left)
        # An enum's discriminant (LANGUAGE_SPEC §10.4), at its representation
        # type: the int → int path below wraps it to the target.
        if enum_identity_cast(s, e) == 1
            return cast_raw
        var enum_src_ty: i32 = 0
        let enum_disc: i32 = emit_enum_to_int(s, e, cast_raw, @enum_src_ty)
        if enum_disc != 0 - 1
            cast_src = enum_disc
            src_ty = enum_src_ty
            src_name = null
            src_name_len = 0
        let src_is_float: i32 = is_float_type(src_ty, StrView { ptr: (src_name), len: (src_name_len) as i64 })
        let dst_is_float: i32 = is_float_type(target_ty, StrView { ptr: (null), len: (0) as i64 })
        if src_is_float == 1 and dst_is_float == 0
            # Float → int: saturating, by the target's signedness (§7.5,
            # AGAST #2192).  A bare fptosi to i8/i16 also left an iN where the
            # unified model wants an i64, and the IR didn't link.
            var ft: i32 = TYPE_F64
            if src_ty == TYPE_F32
                ft = TYPE_F32
            return emit_float_to_int_sat(s, ft, cast_src, target_ty)
        if src_is_float == 0 and dst_is_float == 1
            # Int → float.  Source is i64 in the unified model, where a narrow
            # unsigned value is zero-extended and so non-negative; a u64 with
            # its top bit set is not, and sitofp made it negative (#2192).
            var src_uns: i32 = 0
            if enum_disc == 0 - 1
                int_operand_shape(s, e.left, @src_uns)
            let r: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, r)
            if src_uns == 1
                emit_str(s, c" = uitofp i64 ")
            else
                emit_str(s, c" = sitofp i64 ")
            emit_reg(s, cast_src)
            emit_str(s, IR_TO_SP)
            emit_str(s, ty_value_llvm(target_ty))
            emit_str(s, IR_NL)
            return r
        if src_is_float == 1 and dst_is_float == 1
            # f32 ↔ f64
            if src_ty == TYPE_F64 and target_ty == TYPE_F32
                let r: i32 = ir_fptrunc_f64_f32(s.out, @s.reg_counter, cast_src)
                return r
            if src_ty == TYPE_F32 and target_ty == TYPE_F64
                let r: i32 = ir_fpext_f32_f64(s.out, @s.reg_counter, cast_src)
                return r
            return cast_src
        # int → int (AGAST #1602).  Values live in i64 registers, held
        # sign/zero-extended per their own type, so the cast must wrap to
        # an effective width and re-extend.  ritz0's rule: narrowing (or
        # same width) truncates to the target and the result is read with
        # the TARGET's signedness; widening extends from the SOURCE width,
        # zext if either side is unsigned, sext only if both are signed.
        # A non-int-primitive side (bool, pointer, enum, unknown) counts as
        # signed 64-bit; a non-int target (bool, ptr, ...) passes through.
        let dst_bits: i32 = ty_int_bits(target_ty)
        if dst_bits == 0
            return cast_src
        var src_bits: i32 = ty_int_bits(src_ty)
        var src_signed: i32 = ty_is_signed(src_ty)
        if src_bits == 0
            src_bits = 64
            src_signed = 1
        var w: i32 = dst_bits
        var signed: i32 = ty_is_signed(target_ty)
        if src_bits < dst_bits
            w = src_bits
            signed = src_signed * ty_is_signed(target_ty)
        if w == 64
            return cast_src
        let narrow: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, narrow)
        emit_str(s, IR_TRUNC)
        emit_reg(s, cast_src)
        emit_str(s, c" to i")
        emit_int(s, w as i64)
        emit_str(s, IR_NL)
        let wide: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, wide)
        if signed == 1
            emit_str(s, c" = sext i")
        else
            emit_str(s, c" = zext i")
        emit_int(s, w as i64)
        emit_str(s, IR_SP)
        emit_reg(s, narrow)
        emit_str(s, IR_TO_I64)
        return wide

    else if e.kind == EXPR_NIL_LIT
        # nil literal - emit as null pointer (0)
        let zero: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, zero)
        emit_str(s, c" = add i64 0, 0  ; nil\n")
        return zero

    else if e.kind == EXPR_CSTRING_LIT
        # c"..." lowers to *u8 (null-terminated). Emitted here as a GEP to the
        # first element, cast to i64 for downstream integer-flavoured consumers.
        let str_idx: i32 = add_string(s, StrView { ptr: (e.string_ptr), len: (e.string_len) as i64 })
        let gep_reg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, gep_reg)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, (e.string_len + 1) as i64)
        emit_str(s, c" x i8], ptr @.str.")
        emit_int(s, str_idx as i64)
        emit_str(s, c", i64 0, i64 0\n")
        let ptr_reg: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, gep_reg)
        return ptr_reg

    else if e.kind == EXPR_STRING_LIT
        # Bare "..." lowers to a %Span$u8 aggregate { ptr: *u8, len: i64 } —
        # the StrView-shaped view (AGAST #98). Zero allocation: the payload
        # is an @.str global and length is known at compile time. %Span$u8 is
        # supplied by ensure_string_literal_struct when the source does not
        # define it, so no import is required.
        # StrView (ritzlib.strview) has identical layout, so call-site
        # coercion rebuilds the aggregate under the StrView name.
        let str_idx: i32 = add_string(s, StrView { ptr: (e.string_ptr), len: (e.string_len) as i64 })
        let gep_reg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, gep_reg)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, (e.string_len + 1) as i64)
        emit_str(s, c" x i8], ptr @.str.")
        emit_int(s, str_idx as i64)
        emit_str(s, c", i64 0, i64 0\n")
        # Build %Span$u8 via insertvalue: { ptr, len }
        let sv1: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sv1)
        emit_str(s, c" = insertvalue %Span$u8 undef, ptr ")
        emit_reg(s, gep_reg)
        emit_str(s, IR_COMMA_0)
        let sv2: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sv2)
        emit_str(s, c" = insertvalue %Span$u8 ")
        emit_reg(s, sv1)
        emit_str(s, IR_I64_SEP)
        emit_int(s, e.string_len as i64)
        emit_str(s, IR_COMMA_1)
        return sv2

    else if e.kind == EXPR_STRUCT_LIT
        # Struct literal as an rvalue: TypeName { field: value, ... }
        # (e.ident_ptr/ident_len = struct type name, e.args = FieldInit list).
        # let/var, return, reassignment, nested-field and receiver literals
        # are written straight into their destination slot elsewhere. Every
        # other position (fn/method arg, variant-ctor payload, `[T{..}; N]`
        # element) lands here: fill a temp through the shared field-store
        # loop, then yield the loaded `%T` aggregate. (AGAST #1362)
        return emit_struct_lit_value(s, e)

    else if e.kind == EXPR_MEMBER
        return emit_expr_member(s, e)
    else if e.kind == EXPR_METHOD
        # Inline predicate intrinsics for Result$/Option$ (AGAST #134): the
        # ritzlib `result_is_ok<T,E>` / `option_is_some<T>` generics aren't
        # monomorphized in isolation, so method dispatch would resolve to an
        # undefined extern. Fall through to emit_expr_method for anything
        # that isn't a tagged-enum predicate.
        let pred_reg: i32 = try_emit_enum_is_ok(s, e)
        if pred_reg >= 0
            return pred_reg
        # `m[k] op= x` on a struct: its `index_mut` call is shared by the
        # store and the read, and runs once (struct_index.ritz, AGAST #1635).
        let once: i32 = si_once_find(e)
        if once >= 0
            let prev: i32 = si_once_take(once)
            if prev >= 0
                return prev
            let first_lent: i32 = own_lent_mark()
            let first: i32 = emit_expr_method(s, e)
            own_drop_lent(s, first_lent)   # AGAST #3050
            own_note_temp(s, e, first)   # AGAST #2262: a temporary's drop
            si_once_set(once, first)
            return first
        let method_lent: i32 = own_lent_mark()
        let method_reg: i32 = emit_expr_method(s, e)
        own_drop_lent(s, method_lent)     # AGAST #3050: what its args lent
        own_note_temp(s, e, method_reg)   # AGAST #2262: a temporary's drop
        return method_reg
    else if e.kind == EXPR_MATCH
        # Match expression — scrutinee in `left`, arms in `args` (recast).
        let arms: *MatchArm = e.args as *MatchArm
        return emit_match(s, e.left, arms, e.span)
    else if e.kind == EXPR_IF
        # If/else expression (AGAST #1613) — see emit_if_expr.
        return emit_if_expr(s, e)
    else if e.kind == EXPR_TRY
        return emit_expr_try(s, e)

    else if e.kind == EXPR_ARRAY_FILL
        # Array fill `[v; N]` with no `[N]T` slot to build in.  Every slot that
        # has one lowers the fill itself (emit_array_fill_into: a typed or
        # inferred `let`, a field, an assignment).  This arm built a shadow
        # `[N x i64]` and returned its ADDRESS as the value, so whatever took it
        # (an enum or Option payload, an untyped pointer-element `let`) silently
        # read garbage.  AGAST #3014: fail closed, located, instead.
        return emit_array_no_slot_error(s, e)

    else if e.kind == EXPR_ARRAY_LIT
        # Array literal `[e1, e2, ...]` in value position: a slot with an
        # `[N]T` (a typed or inferred `let`, a field, an assignment) lowers it
        # itself, with emit_array_lit_into.  (ritz-task-102)
        # AGAST #2266: a literal of struct T is a `[N x %T]`, its elements
        # stored at %T (an i64 store of a %T was invalid IR), and one nobody
        # takes drops them (own_note_array_temp).
        var sel_name: *u8 = null
        var sel_len: i32 = 0
        let sel_n: i32 = array_lit_struct_elem(s, e, @sel_name, @sel_len)
        if sel_n > 0
            let sarr: i32 = next_reg(s)
            entry_alloca_reg_begin(s, sarr)
            emit_str(s, c"[")
            emit_int(s, sel_n as i64)
            emit_str(s, c" x %")
            emit_name(s, StrView { ptr: (sel_name), len: (sel_len) as i64 })
            emit_str(s, c"]  ; array literal\n")
            entry_alloca_reg_end(s)
            emit_array_lit_into(s, sarr, sel_n, TYPE_STRUCT, StrView { ptr: (sel_name), len: (sel_len) as i64 }, e)
            own_note_array_temp(s, e, sarr)
            let spti: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, sarr)
            return spti
        # AGAST #3014: a scalar literal with no `[N]T` slot: as EXPR_ARRAY_FILL.
        return emit_array_no_slot_error(s, e)

    emit_ir_error(s, e.span, c"unknown expression kind")
    let zero: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, zero)
    emit_str(s, IR_ADD_ZERO)
    zero

# AGAST #3014: an array literal or fill of scalars that reached emit_expr has no
# `[N]T` slot, and emit_expr has no type to build one at.  ritz1 used to build
# a shadow `[N x i64]` and return its address, a silent wrong value.
fn emit_array_no_slot_error(s: *EmitterState, e: *Expr) -> i32
    emit_nd_error(s, e.span.line, e.span.col, c"ritz1 cannot build this array literal here: it has no `[N]T` slot (give it one, e.g. `let a: [2]u8 = [..]`)")
    let zero: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, zero)
    emit_str(s, IR_ADD_ZERO)
    zero

# =============================================================================
# Array Fill Lowering
# =============================================================================

# Write `[fill_val; arr_size]` into the `[arr_size x elem_ty]` storage at
# `base_reg` (a `ptr` register: a local alloca or a struct-field GEP).
#
# Strategy (mirrors ritz0):
#   * Zero fill (e.g. `[0; 65536]`)  -> @__ritz_sret_zero (AGAST #3218)
#   * Small N (<= 16)                 -> straight-line unrolled stores
#   * Otherwise                       -> a real LLVM loop
# Unrolling [0; 65536] would emit 65536 GEP+store pairs — clang -O2
# then spends minutes folding it.  (AGAST #178)
#
# Shared by `let buf: [N]T = [v; N]` (emit_var_decl) and by `[v; N]` as an
# array field of a struct literal (emit_var_decl's struct-literal loop and
# emit_struct_lit_to_alloca).  The latter used to go through emit_expr's
# EXPR_ARRAY_FILL fallback, which builds a shadow `[N x i64]` alloca and
# returns its ADDRESS — stored as an i64 over the field's first slots, with
# the fill value never reaching the field at all.  (AGAST #1605)
# Store the `%T` aggregate `agg` into every slot of the `[N x %T]` array at
# `base_reg`. Always a counted loop: clang unrolls the small ones, and a
# large struct array stays O(1) in IR size. (AGAST #1362)
fn emit_array_fill_struct_loop(s: *EmitterState, base_reg: i32, arr_size: i32, st: *StructDef, agg: i32)
    let idx: i32 = next_reg(s)
    entry_alloca_reg(s, idx, c"i32", null)
    emit_str(s, c"  store i32 0, ptr ")
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    let l_cond: i32 = next_label(s)
    let l_body: i32 = next_label(s)
    let l_end: i32 = next_label(s)
    emit_str(s, IR_BR)
    emit_label(s, l_cond)
    emit_str(s, IR_NL)
    begin_block(s, l_cond)
    let cur: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cur)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    let cmp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cmp)
    emit_str(s, c" = icmp ult i32 ")
    emit_reg(s, cur)
    emit_str(s, IR_COMMA)
    emit_int(s, arr_size as i64)
    emit_str(s, IR_NL)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cmp)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, l_body)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, l_end)
    emit_str(s, IR_NL)
    begin_block(s, l_body)
    let ep: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ep)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, arr_size as i64)
    emit_str(s, c" x %")
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_RBRACK_PTR)
    emit_reg(s, base_reg)
    emit_str(s, IR_I32_ZERO)
    emit_reg(s, cur)
    emit_str(s, IR_NL)
    emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (st.name), len: (st.name_len) as i64 }, agg, ep)
    let inc: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, inc)
    emit_str(s, c" = add i32 ")
    emit_reg(s, cur)
    emit_str(s, IR_COMMA_1)
    emit_str(s, c"  store i32 ")
    emit_reg(s, inc)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    emit_str(s, IR_BR)
    emit_label(s, l_cond)
    emit_str(s, IR_NL)
    begin_block(s, l_end)

# AGAST #2062 (moved from emitter_stmt by #2065): `val_reg` = emit_expr(value), stored into an f32 / f64 slot of
# type `dst_ty`.  An integer-typed value (`var x: f64 = 3`, `*p = n`) is the
# i64 every integer is carried in: convert it to the slot's float width by
# int_into_float_slot (exact sources only, by signedness, #2945).  Returns val_reg otherwise —
# float values keep their existing narrowing at the call site.  clang
# rejected the `store double %<i64>` this used to emit.
pub fn int_to_float_slot(s: *EmitterState, val_reg: i32, dst_ty: i32, value: *Expr) -> i32
    if expr_is_definitely_int(s, value) == 1
        return emit_int_into_float_slot(s, val_reg, float_slot_unsigned(value), dst_ty)
    val_reg

fn is_int_ty(t: i32) -> i32
    if ty_is_int(t) == 1
        return 1
    0

# Is `e` KNOWN to produce an integer register?  get_expr_type cannot answer
# that: TYPE_I64 is also its fallback for anything it can't type, e.g. a
# float method on an rvalue receiver (`Pt { .. }.scale(2.0)`, gate failure
# test_issue_method_autoborrow_rvalue).  So only forms whose type is
# resolved, not defaulted, count; anything else is left unconverted.  A
# `match` / `if` is never "definitely int": under a float hint
# (set_match_float_hint) its integer arms were already converted.
fn expr_is_definitely_int(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_CHAR_LIT
        return 1
    if e.kind == EXPR_IDENT
        if find_local_idx(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0 or find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
            return is_int_ty(expr_slot_ty(e))
        return 0
    if e.kind == EXPR_CAST
        return is_int_ty(e.op)
    if e.kind == EXPR_CALL
        if find_call_fn(s, e) != null
            return is_int_ty(expr_slot_ty(e))
        return 0
    if e.kind == EXPR_MEMBER
        if member_field_def(s, e) != null
            return is_int_ty(expr_slot_ty(e))
        return 0
    if e.kind == EXPR_UNARY and e.op == OP_NEG
        return expr_is_definitely_int(s, e.operand)
    if e.kind == EXPR_BINARY
        if e.op == OP_ADD or e.op == OP_SUB or e.op == OP_MUL or e.op == OP_DIV or e.op == OP_MOD or e.op == OP_BIT_AND or e.op == OP_BIT_OR or e.op == OP_BIT_XOR or e.op == OP_SHL or e.op == OP_SHR
            if expr_is_definitely_int(s, e.left) == 1 and expr_is_definitely_int(s, e.right) == 1
                return 1
    0

# The register to store for one bool / f32 / f64 element of a STRUCT FIELD
# array (`[N x i1]` / `[N x float]` / `[N x double]`, see
# field_array_elem_llvm), or one f32 / f64 element of a LOCAL array (#1966):
# narrowed exactly as emit_struct_lit_field_store narrows a scalar field of
# that type.  `val_reg` is emit_expr(value).  AGAST #1935.
pub fn emit_field_elem_narrow(s: *EmitterState, val_reg: i32, elem_ty: i32, value: *Expr) -> i32
    if elem_ty == TYPE_BOOL
        let t1: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val_reg)
        return t1
    # AGAST #2065: an integer value into a float slot (`R { a: 3 }`,
    # `r.a = 3`, `p[i] = 3`, `x = 3`) is sitofp'd; it stored the i64.
    if elem_ty == TYPE_F32 or elem_ty == TYPE_F64
        if expr_is_definitely_int(s, value) == 1
            return emit_int_into_float_slot(s, val_reg, float_slot_unsigned(value), elem_ty)
    if elem_ty == TYPE_F32 and expr_slot_ty(value) == TYPE_F64
        let tf: i32 = ir_fptrunc_f64_f32(s.out, @s.reg_counter, val_reg)
        return tf
    # AGAST #4028: an f32 value into an f64 slot widens (§7.5); it stored the
    # `float` register as `double`.  An if / match is never F32 here (its phi
    # merged at the slot's type under a float hint, or get_expr_type falls back).
    if elem_ty == TYPE_F64 and expr_slot_ty(value) == TYPE_F32
        return emit_float_coerce(s, val_reg, TYPE_F32, TYPE_F64)
    val_reg

# The register to `ret` for `value` (already emitted into `val_reg`) from a fn
# returning `ret_type`.  AGAST #2074: a float literal is always a `double`, so
# `1.0` / `return 1.0` from an `-> f32` fn is fptrunc'd (and an integer value
# sitofp'd) exactly as a store into an f32 slot is.  Shared by the implicit
# tail returns (emit_fn / emit_impl_method) and the explicit `return`
# (emit_return).  Any non-float return type passes `val_reg` through.
pub fn float_ret_value(s: *EmitterState, val_reg: i32, ret_type: i32, value: *Expr) -> i32
    if ret_type == TYPE_F32 or ret_type == TYPE_F64
        return emit_field_elem_narrow(s, val_reg, ret_type, value)
    val_reg

# 1 when an element of `[N]elem_ty` is stored with emit_field_elem_narrow at
# `float` / `double` / `i1` width: every f32 / f64 / bool array, field or
# local (#1966; bool locals are `i1` since #2063).
pub fn array_elem_typed_scalar(elem_ty: i32) -> i32
    if elem_ty == TYPE_F32 or elem_ty == TYPE_F64 or elem_ty == TYPE_BOOL
        return 1
    0

# Write `[v; arr_size]` into the array at `base_reg`, a local array or an
# inline STRUCT FIELD array: both share one element layout (bool `i1`,
# f32 / f64 `float` / `double`; array_elem_typed_scalar).  `elem_name` names a
# struct element's type (AGAST #2288).
pub fn emit_array_fill_into(s: *EmitterState, base_reg: i32, arr_size: i32, elem_ty: i32, elem_name_sv: StrView, fill_val: *Expr)
    var elem_name: *u8 = elem_name_sv.ptr
    var elem_name_len: i32 = elem_name_sv.len as i32
    let fill_elem_ty: i32 = elem_ty
    let fill_arr_size: i32 = arr_size
    var fill_elem_llvm: *u8 = c"i64"
    var fill_elem_bytes: i32 = 8
    if ty_int_bits(fill_elem_ty) == 32
        fill_elem_llvm = c"i32"
        fill_elem_bytes = 4
    else if ty_int_bits(fill_elem_ty) == 8
        fill_elem_llvm = c"i8"
        fill_elem_bytes = 1
    else if ty_int_bits(fill_elem_ty) == 16
        fill_elem_llvm = c"i16"
        fill_elem_bytes = 2
    else if fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR
        fill_elem_llvm = c"ptr"
        fill_elem_bytes = 8
    var field_scalar: i32 = 0
    if array_elem_typed_scalar(fill_elem_ty) == 1
        field_scalar = 1
        fill_elem_llvm = elem_mem_llvm(fill_elem_ty)
        if fill_elem_ty == TYPE_BOOL
            fill_elem_bytes = 1
        else if fill_elem_ty == TYPE_F32
            fill_elem_bytes = 4
    # `[T { .. }; N]`: the element is the literal's own struct type, stored
    # as a `%T` aggregate built once by the rvalue lowering. (AGAST #1362)
    if fill_val != null and fill_val.kind == EXPR_STRUCT_LIT
        let lit_st: *StructDef = find_struct(s, StrView { ptr: (fill_val.ident_ptr), len: (fill_val.ident_len) as i64 })
        if lit_st != null
            let agg: i32 = emit_struct_lit_value(s, fill_val)
            emit_array_fill_struct_loop(s, base_reg, fill_arr_size, lit_st, agg)
            return
    # AGAST #2288: `[c; N]` with `c:& C` into a `[N]C` fills with the referent,
    # as in ritz0.  It stored the pointer as an i64.
    if elem_ty == TYPE_STRUCT and lent_referent_local(s, fill_val) != null
        let lent_st: *StructDef = find_struct(s, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
        if lent_st != null
            let referent: i32 = emit_lent_referent(s, fill_val, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
            if referent != 0
                emit_array_fill_struct_loop(s, base_reg, fill_arr_size, lent_st, referent)
                return
    # AGAST #2976: `[c; N]` of any other struct value into a `[N]C` (a local, a
    # param, a call result, an element or field, a generic `T` at a struct) is
    # the `%C` aggregate emit_expr yields, evaluated once and stored into every
    # `%C` slot. It fell through to the scalar path below: `store i64 <%C>` into
    # `[N x i64]` slots, which clang rejects.
    if elem_ty == TYPE_STRUCT and fill_val != null
        let val_st: *StructDef = find_struct(s, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
        if val_st != null
            let val_agg: i32 = emit_expr(s, fill_val)
            emit_array_fill_struct_loop(s, base_reg, fill_arr_size, val_st, val_agg)
            return
    # Fast path: integer-literal zero fill — collapse to memset.
    # Detect EXPR_INT_LIT with int_val == 0 (common case for
    # squeeze's `[0; 65536]` lz_symbols arrays) and EXPR_UNARY
    # OP_NEG over int 0.  Anything else falls into the loop path.
    var fill_is_zero_lit: i32 = 0
    if fill_val != null and fill_val.kind == EXPR_INT_LIT and fill_val.int_val == 0
        fill_is_zero_lit = 1
    # AGAST #3218: through the module-internal @__ritz_sret_zero, never
    # llvm.memset: codegen lowers a large intrinsic memset to a call to libc
    # `memset`, and a program that does not import ritzlib then fails to link
    # -nostdlib.  The helper is "no-builtins", so it stays a byte loop.
    if fill_is_zero_lit == 1
        emit_str(s, c"  call void @__ritz_sret_zero(ptr ")
        emit_reg(s, base_reg)
        emit_str(s, IR_I64_SEP)
        emit_int(s, (fill_arr_size * fill_elem_bytes) as i64)
        emit_str(s, IR_CLOSE)
        s.sret_helpers_used = 1
        return
    # Evaluate the fill value ONCE — even if it's a function call we
    # only want to invoke it once. Its i64 SSA result is reused for
    # every store.
    let fill_val_reg: i32 = emit_expr(s, fill_val)
    # Pre-truncate the value to the element width so we don't
    # re-emit the trunc inside the loop body (and so a pointer
    # element type gets one inttoptr we can reuse).
    var fill_narrow: i32 = fill_val_reg
    if field_scalar == 1
        fill_narrow = emit_field_elem_narrow(s, fill_val_reg, fill_elem_ty, fill_val)
    else if ty_int_bits(fill_elem_ty) == 8
        let t8: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, fill_val_reg)
        fill_narrow = t8
    else if ty_int_bits(fill_elem_ty) == 16
        let t16: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, fill_val_reg)
        fill_narrow = t16
    else if ty_int_bits(fill_elem_ty) == 32
        let t32: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, fill_val_reg)
        fill_narrow = t32
    else if (fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR) and expr_is_ptr_valued(s, fill_val) == 1
        fill_narrow = fill_val_reg   # AGAST #3029: `@&x` is a `ptr` already
    else if fill_elem_ty == TYPE_PTR or fill_elem_ty == TYPE_PTR_PTR
        let tp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, fill_val_reg)
        fill_narrow = tp
    else if fill_elem_ty == TYPE_REF or fill_elem_ty == TYPE_MUT_REF
        fill_narrow = ptr_value_to_i64(s, fill_val, fill_val_reg)   # AGAST #2369: an `[N]@&T` holds i64s
    if fill_arr_size <= 16
        # Small N: unroll for simple straight-line IR.
        var fi: i32 = 0
        while fi < fill_arr_size
            let fep: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, fep)
            emit_str(s, IR_GEP_ARRAY)
            emit_int(s, fill_arr_size as i64)
            emit_str(s, IR_X)
            emit_str(s, fill_elem_llvm)
            emit_str(s, IR_RBRACK_PTR)
            emit_reg(s, base_reg)
            emit_str(s, IR_I64_ZERO)
            emit_int(s, fi as i64)
            emit_str(s, IR_NL)
            emit_str(s, IR_STORE_IND)
            emit_str(s, fill_elem_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, fill_narrow)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, fep)
            emit_str(s, IR_NL)
            fi = fi + 1
        return
    # Larger N: real LLVM loop with i32 induction var on stack.
    let fi_idx: i32 = next_reg(s)
    entry_alloca_reg(s, fi_idx, c"i32", null)
    emit_str(s, c"  store i32 0, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, IR_NL)
    let fi_cond: i32 = next_label(s)
    let fi_body: i32 = next_label(s)
    let fi_end: i32 = next_label(s)
    emit_str(s, IR_BR)
    emit_label(s, fi_cond)
    emit_str(s, IR_NL)
    begin_block(s, fi_cond)
    let fi_cur: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fi_cur)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, IR_NL)
    let fi_cmp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fi_cmp)
    emit_str(s, c" = icmp ult i32 ")
    emit_reg(s, fi_cur)
    emit_str(s, IR_COMMA)
    emit_int(s, fill_arr_size as i64)
    emit_str(s, IR_NL)
    emit_str(s, c"  br i1 ")
    emit_reg(s, fi_cmp)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, fi_body)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, fi_end)
    emit_str(s, IR_NL)
    begin_block(s, fi_body)
    let fi_cur2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fi_cur2)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, fi_idx)
    emit_str(s, IR_NL)
    let fi_ep: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fi_ep)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, fill_arr_size as i64)
    emit_str(s, IR_X)
    emit_str(s, fill_elem_llvm)
    emit_str(s, IR_RBRACK_PTR)
    emit_reg(s, base_reg)
    emit_str(s, IR_I32_ZERO)
    emit_reg(s, fi_cur2)
    emit_str(s, IR_NL)
    emit_str(s, IR_STORE_IND)
    emit_str(s, fill_elem_llvm)
    emit_str(s, IR_SP)
    emit_reg(s, fill_narrow)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, fi_ep)
    emit_str(s, IR_NL)
    let fi_inc: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fi_inc)
    emit_str(s, c" = add i32 ")
    emit_reg(s, fi_cur2)
    emit_str(s, IR_COMMA_1)
    emit_str(s, c"  store i32 ")
    emit_reg(s, fi_inc)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, fi_idx)
    emit_str(s, IR_NL)
    emit_str(s, IR_BR)
    emit_label(s, fi_cond)
    emit_str(s, IR_NL)
    begin_block(s, fi_end)

# Write the array literal `lit` (`[a, b, ..]`) element by element into the
# `[arr_size x elem]` storage at `base_reg` (a `ptr` register: a local alloca
# or a struct-field GEP). Elements past `arr_size` are ignored.
#
# Shared by `let a: [N]T = [..]` (emit_var_decl) and by `[..]` as an array
# field of a struct literal (emit_struct_lit_array_fill_field). Element
# handling depends on the element type:
#   * scalars: evaluate to i64, then trunc / inttoptr to the element width.
#   * structs (`elem_ty == TYPE_STRUCT`, named by `elem_name`): a struct
#     literal element is written in place into its slot with
#     emit_struct_lit_to_alloca. emit_expr has no lowering for a bare literal
#     that matches the slot. Any other element (a local, a call) is a loaded
#     `%T` aggregate and is stored as one.
# The generic EXPR_ARRAY_LIT arm of emit_expr builds an `[N x i64]` shadow and
# stored each struct element as an i64 (invalid IR). (AGAST #1608)
#
# bool / f32 / f64 elements are `i1` / `float` / `double` in a local and a
# field array alike (array_elem_typed_scalar, #1966, #2063).
pub fn emit_array_lit_into(s: *EmitterState, base_reg: i32, arr_size: i32, elem_ty: i32, elem_name_sv: StrView, lit: *Expr)
    var elem_name: *u8 = elem_name_sv.ptr
    var elem_name_len: i32 = elem_name_sv.len as i32
    var is_struct: i32 = 0
    if elem_ty == TYPE_STRUCT and elem_name_len > 0
        is_struct = 1
    var elem_llvm: *u8 = c"i64"
    var needs_trunc: i32 = 0
    if ty_int_bits(elem_ty) == 32
        elem_llvm = c"i32"
        needs_trunc = 1
    else if ty_int_bits(elem_ty) == 8
        elem_llvm = c"i8"
        needs_trunc = 1
    else if ty_int_bits(elem_ty) == 16
        elem_llvm = c"i16"
        needs_trunc = 1
    else if elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR
        elem_llvm = c"ptr"
    var field_scalar: i32 = 0
    if array_elem_typed_scalar(elem_ty) == 1
        field_scalar = 1
        elem_llvm = elem_mem_llvm(elem_ty)
    var idx: i32 = 0
    var it: *Expr = lit.args
    while it != null and idx < arr_size
        # A struct-literal element has no value register; GEP first, then
        # write it in place.
        var val_reg: i32 = -1
        if is_struct == 0 or it.kind != EXPR_STRUCT_LIT
            val_reg = emit_expr_into_slot(s, it, elem_ty, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })   # AGAST #2454
        let elem_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, arr_size as i64)
        emit_str(s, IR_X)
        if is_struct == 1
            emit_str(s, IR_PCT)
            emit_name(s, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
        else
            emit_str(s, elem_llvm)
        emit_str(s, IR_RBRACK_PTR)
        emit_reg(s, base_reg)
        emit_str(s, IR_I64_ZERO)
        emit_int(s, idx as i64)
        emit_str(s, IR_NL)
        if is_struct == 1
            if val_reg < 0
                emit_struct_lit_to_alloca(s, it, elem_ptr)
            else
                let agg: i32 = coerce_struct_ret_value(s, it, val_reg, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
                emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, agg, elem_ptr)
        else
            # Narrow the i64 expression value to the element type.
            var stored: i32 = val_reg
            if field_scalar == 1
                stored = emit_field_elem_narrow(s, val_reg, elem_ty, it)
            else if (elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR) and expr_is_ptr_valued(s, it) == 1
                stored = val_reg   # AGAST #3029: `@&x` is a `ptr` already
            else if elem_ty == TYPE_REF or elem_ty == TYPE_MUT_REF
                stored = ptr_value_to_i64(s, it, val_reg)   # AGAST #2369: an `[N]@&T` holds i64s
            else if elem_ty == TYPE_PTR or elem_ty == TYPE_PTR_PTR
                stored = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, stored)
                emit_str(s, IR_INTTOPTR)
                emit_reg(s, val_reg)
                emit_str(s, c" to ptr\n")
            else if needs_trunc == 1
                stored = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, stored)
                emit_str(s, IR_TRUNC)
                emit_reg(s, val_reg)
                emit_str(s, IR_TO_SP)
                emit_str(s, elem_llvm)
                emit_str(s, IR_NL)
            emit_str(s, IR_STORE_IND)
            emit_str(s, elem_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, stored)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, elem_ptr)
            emit_str(s, IR_NL)
        idx = idx + 1
        it = it.next


# If struct literal field `field_idx` of `st` is an inline array initialised
# with `[v; N]` (AGAST #1605) or `[a, b, ..]` (AGAST #1608), GEP to the field
# inside `base_reg` and write it in place; return 1. Otherwise emit nothing
# and return 0 so the caller's generic evaluate-then-store path handles the
# field.
pub fn emit_struct_lit_array_fill_field(s: *EmitterState, st: *StructDef, field_idx: i32, value: *Expr, base_reg: i32) -> i32
    if value == null or (value.kind != EXPR_ARRAY_FILL and value.kind != EXPR_ARRAY_LIT)
        return 0
    let field: *StructField = get_field_type(st, field_idx)
    if field.field_type != TYPE_ARRAY
        return 0
    let field_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, field_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_reg)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field_idx as i64)
    emit_str(s, IR_NL)
    if value.kind == EXPR_ARRAY_LIT
        emit_array_lit_into(s, field_ptr, field.array_size, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, value)
    else
        emit_array_fill_into(s, field_ptr, field.array_size, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, value.left)
    1

# Evaluate struct-literal field `field_idx` of `st` and store it into the
# struct at `base_reg`, at the field's own width.
#
# The ONE field-store dispatch for struct literals: emit_var_decl's
# `let s = S { ... }` loop and emit_struct_lit_to_alloca (tail / return /
# reassignment literals) both call it, so the two cannot drift again. Before
# AGAST #1497 they had: the let loop stored a bool with an 8-byte `store i64`
# (clobbering the next field), and the alloca loop had no bool, u32, i16/u16
# or struct arm and silently dropped those fields.
#
# Values are i64 in ritz1's value model (a bool too, AGAST #1646 / #3001), so
# narrow fields `trunc` first.
# An unlowerable field type is a located error, never a silent skip.
pub fn emit_struct_lit_field_store(s: *EmitterState, st: *StructDef, field_idx: i32, value: *Expr, base_reg: i32)
    let field: *StructField = get_field_type(st, field_idx)
    # AGAST #3005: a tuple field (`Box<(u32, u32)> { v: (1, 2) }`, a nested
    # tuple) names a nameless tuple literal.
    if field.field_type == TYPE_STRUCT
        var lname: *u8 = null
        var lname_len: i32 = 0
        tuple_lit_name(s, value, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, @lname, @lname_len)
    # A nested literal (`E { name: V { .. } }`) has no value register:
    # emit_expr rejects a bare EXPR_STRUCT_LIT. Write it in place into the
    # field instead, recursively. (AGAST #1655)
    if value != null and value.kind == EXPR_STRUCT_LIT and field.field_type == TYPE_STRUCT
        let nested_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, nested_ptr)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, base_reg)
        emit_str(s, IR_I32_ZERO)
        emit_int(s, field_idx as i64)
        emit_str(s, IR_NL)
        emit_struct_lit_to_alloca(s, value, nested_ptr)
        return
    # AGAST #1748: an array field from a non-literal (`rows: b.rows`, a
    # local array, a `:&` array param) is copied into the literal's slot,
    # exactly as `h.a = a` assigns it. A `[..]` / `[v; N]` value was written in
    # place by emit_struct_lit_array_fill_field before this is reached.
    if field.field_type == TYPE_ARRAY
        let arr_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, arr_ptr)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, base_reg)
        emit_str(s, IR_I32_ZERO)
        emit_int(s, field_idx as i64)
        emit_str(s, IR_NL)
        emit_array_field_whole_assign(s, arr_ptr, field, value)
        return
    # AGAST #2142: `Font { cmap: Some(..) }` builds the field's enum.
    let val_reg: i32 = emit_expr_into_field(s, value, field)
    let field_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, field_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_reg)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field_idx as i64)
    emit_str(s, IR_NL)
    let ft: i32 = field.field_type
    # What to store: the register and its LLVM type.
    var stored: i32 = val_reg
    var store_ty: *u8 = null
    var trunc_ty: *u8 = null
    if ty_int_bits(ft) == 64
        # AGAST #2064: u64 is already an i64 register; no trunc needed.
        store_ty = c"i64"
    else if ty_int_bits(ft) == 32
        trunc_ty = c"i32"
    else if ty_int_bits(ft) == 16
        trunc_ty = c"i16"
    else if ty_int_bits(ft) == 8
        trunc_ty = c"i8"
    else if ft == TYPE_BOOL
        trunc_ty = c"i1"
    else if ft == TYPE_PTR or ft == TYPE_PTR_PTR
        # AGAST #2041: `R { ch: @&c }` -- `@&c` (or an `@&T` local) is
        # already a `ptr`; only an i64-model pointer value needs inttoptr.
        stored = i64_value_to_ptr(s, value, val_reg)
        store_ty = c"ptr"
    else if ft == TYPE_F32
        # Float lit emits as `double`; an f64 value is fptrunc'd, an
        # integer one sitofp'd (#2065), by emit_field_elem_narrow.
        stored = emit_field_elem_narrow(s, val_reg, TYPE_F32, value)
        store_ty = c"float"
    else if ft == TYPE_F64
        stored = emit_field_elem_narrow(s, val_reg, TYPE_F64, value)
        store_ty = c"double"
    else if ft == TYPE_STRUCT and field.field_type_name_len > 0
        # task-103: struct-by-value field (e.g. `Vec$T` in `Wrap`).
        # val_reg is the loaded aggregate (`%Vec$T`), not an i64.
        # A bare "..." is a %Span$u8; a StrView field needs it rebuilt as
        # %StrView (the layout-equivalent pair) before the store (#1669).
        let agg: i32 = coerce_struct_ret_value(s, value, val_reg, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
        emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, agg, field_ptr)
        return
    else
        emit_ir_error(s, value.span, c"struct literal field of this type is not lowered")
        return
    if trunc_ty != null
        stored = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, stored)
        emit_str(s, IR_TRUNC)
        emit_reg(s, val_reg)
        emit_str(s, IR_TO_SP)
        emit_str(s, trunc_ty)
        emit_str(s, IR_NL)
        store_ty = trunc_ty
    emit_str(s, IR_STORE_IND)
    emit_str(s, store_ty)
    emit_str(s, IR_SP)
    emit_reg(s, stored)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, field_ptr)
    emit_str(s, IR_NL)

# =============================================================================
# Struct Literal to Alloca Helper
# =============================================================================

# =============================================================================
# Tuple literals with no tuple type (AGAST #3005)
# =============================================================================
#
# tuple_resolve_module names a tuple literal from its slot when the parse
# knows one (a fn's return type, an annotated let, an enclosing tuple).  The
# rest reach the emitter nameless: `let t = (a, b)`, a call argument, a
# generic struct's field, an if / match arm that binds a name or runs
# statements before its tuple.  Each is named where it is emitted, with its
# arm's bindings in scope: from the slot the emitter knows (a param's or
# field's tuple type, the phi type an earlier arm fixed), else from its
# elements' types, as ritz0 builds the struct from its element values.  A
# struct synthesized here missed emit_struct_types: emit_late_enum_types
# declares it.

# Is `e` a tuple literal (fields "0", "1", ..) nothing has named yet?
fn tuple_lit_nameless(e: *Expr) -> i32
    if e == null or e.kind != EXPR_STRUCT_LIT or e.ident_len != 0
        return 0
    let fi: *FieldInit = e.args as *FieldInit
    if fi == null or fi.name_len != 1 or *fi.name != 48  # '0'
        return 0
    1

fn tuple_lit_arity(e: *Expr) -> i32
    var n: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        n = n + 1
        fi = fi.next
    n

# The tuple struct `name` names when it has `n` elements, or null.
fn tuple_slot_def(s: *EmitterState, name_sv: StrView, n: i32) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len < 6 or memcmp(name, c"tuple_", 6) != 0
        return null
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (len) as i64 })
    if st == null
        return null
    var k: i32 = 0
    var f: *StructField = st.fields
    while f != null
        k = k + 1
        f = f.next
    if k != n
        return null
    st

# "<prefix><body>", malloc'd; its length in *out_len.
fn tuple_spell_join(prefix_sv: StrView, body_sv: StrView, out_len: *i32) -> *u8
    var prefix: *u8 = prefix_sv.ptr
    var plen: i32 = prefix_sv.len as i32
    var body: *u8 = body_sv.ptr
    var blen: i32 = body_sv.len as i32
    let nm: *u8 = malloc((plen + blen + 1) as i64)
    memcpy(nm, prefix, plen as i64)
    memcpy(nm + plen, body, blen as i64)
    *(nm + plen + blen) = 0
    *out_len = plen + blen
    nm

# AGAST #3024: a `*T` element (`let t = (p, 1)`, p a `*i32` local, param,
# field, call or cast): f is the `*T` field an annotated `(*T, ..)` parses
# to (ptr_pointee T; a primitive T also in array_elem_type, #1304; a struct
# T named by field_type_name), spelled "ptr_" T as ritz0's mangle_type_name
# spells it.  0 when the pointee is not one ritz1 can name.
fn tuple_elem_ptr(s: *EmitterState, v: *Expr, f: *StructField, spell: **u8) -> i32
    var pn: *u8 = null
    var pl: i32 = 0
    let pt: i32 = ptr_root_pointee(s, v, @pn, @pl)
    if pt == 0
        return 0
    f.field_type = TYPE_PTR
    f.ptr_pointee = pt
    if pt == TYPE_STRUCT
        f.field_type_name = pn
        f.field_type_name_len = pl
    else
        f.array_elem_type = pt
        pl = primitive_arg_spelling(pt, @pn)
        if pl <= 0
            return 0
    var n: i32 = 0
    *spell = tuple_spell_join(StrView { ptr: (c"ptr_"), len: (4) as i64 }, StrView { ptr: (pn), len: (pl) as i64 }, @n)
    n

# "arr" + up to 10 digits + "_" + NUL (AGAST #1820: no magic alloc sizes).
const TUPLE_ARR_PREFIX_BUF: i64 = 16

# AGAST #3024: a one-dimensional `[N]T` element (a local's or a field's
# array): f takes its size and element as an annotated `([N]T, ..)` field
# does, spelled "arr" N "_" T as ritz0 spells it (T a primitive, a struct,
# or "ptr_" + either).  0 for any other array (an N-D one, an unnamed
# element).
fn tuple_elem_array(s: *EmitterState, v: *Expr, f: *StructField, spell: **u8) -> i32
    if v.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 })
        if loc == null or loc.var_type != TYPE_ARRAY or loc.array_shape != null
            return 0
        f.array_size = loc.array_size
        f.array_elem_type = loc.array_elem_type
        f.array_elem_pointee = loc.array_elem_pointee
        f.array_elem_type_name = loc.type_name
        f.array_elem_type_name_len = loc.type_name_len
    else if v.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, v)
        if fld == null or fld.field_type != TYPE_ARRAY or fld.array_shape != null
            return 0
        f.array_size = fld.array_size
        f.array_elem_type = fld.array_elem_type
        f.array_elem_pointee = fld.array_elem_pointee
        f.array_elem_type_name = fld.array_elem_type_name
        f.array_elem_type_name_len = fld.array_elem_type_name_len
    else
        return 0
    if f.array_size <= 0
        return 0
    var ptr: i32 = 0
    var leaf: i32 = f.array_elem_type
    if leaf == TYPE_PTR
        ptr = 4
        leaf = f.array_elem_pointee
    var en: *u8 = null
    var el: i32 = 0
    if leaf == TYPE_STRUCT
        en = f.array_elem_type_name
        el = f.array_elem_type_name_len
    else
        el = primitive_arg_spelling(leaf, @en)
    if el <= 0 or en == null
        return 0
    if ptr == 4
        en = tuple_spell_join(StrView { ptr: (c"ptr_"), len: (4) as i64 }, StrView { ptr: (en), len: (el) as i64 }, @el)
    # "arr" + up to 10 digits + "_"
    let pre: *u8 = malloc(TUPLE_ARR_PREFIX_BUF)
    memcpy(pre, c"arr", 3)
    var pl: i32 = 3 + write_dec_i32(pre + 3, f.array_size)
    *(pre + pl) = 95  # '_'
    pl = pl + 1
    f.field_type = TYPE_ARRAY
    var n: i32 = 0
    *spell = tuple_spell_join(StrView { ptr: (pre), len: (pl) as i64 }, StrView { ptr: (en), len: (el) as i64 }, @n)
    n

# Element `v`'s type as a tuple field: written into f (kind, a struct's name,
# a pointer's pointee, an array's size and element) as the parse writes an
# annotated tuple's field.  Returns its spelling's length (ritz0's
# mangle_type_name: a struct's name, a primitive's, "ptr_i32", "arr3_i32"),
# with the spelling in *spell, or 0 when ritz1 can't type it (a `**T`, a
# reference, an N-D array, a struct it can't name).
fn tuple_elem_type(s: *EmitterState, v: *Expr, f: *StructField, spell: **u8) -> i32
    f.field_type_name = null
    f.field_type_name_len = 0
    f.ptr_pointee = TYPE_VOID
    f.array_elem_pointee = TYPE_VOID
    f.inner_pointee_type = TYPE_VOID
    if v.kind == EXPR_STRUCT_LIT
        f.field_type = TYPE_STRUCT
        f.field_type_name = v.ident_ptr
        f.field_type_name_len = v.ident_len
        # A nested nameless tuple was named a moment ago by tuple_lit_infer;
        # its name lives in the side table, not on the node (AGAST #4408).
        if v.ident_len == 0
            var nn: *u8 = null
            var nnl: i32 = 0
            if tuple_name_get(v, @nn, @nnl) == 1
                f.field_type_name = nn
                f.field_type_name_len = nnl
    else if bool_kind(s, v) == BK_BOOL
        f.field_type = TYPE_BOOL
    else
        let t: i32 = expr_slot_ty(v)
        if t == TYPE_PTR
            return tuple_elem_ptr(s, v, f, spell)
        if t == TYPE_ARRAY
            return tuple_elem_array(s, v, f, spell)
        if t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
            return 0
        f.field_type = t
        # A struct or enum value names its type even where get_expr_type
        # says i64 (`Slot.Full(x)`, a variant ctor).
        var nm: *u8 = null
        var nl: i32 = 0
        tuple_decl_struct_name(s, v, @nm, @nl)
        if nl > 0
            f.field_type = TYPE_STRUCT
            f.field_type_name = nm
            f.field_type_name_len = nl
    if f.field_type == TYPE_STRUCT
        *spell = f.field_type_name
        return f.field_type_name_len
    primitive_arg_spelling(f.field_type, spell)

# up to 10 digits of an i32 field index + NUL (AGAST #1820).
const TUPLE_FIELD_NAME_BUF: i64 = 12

# A tuple struct `name` over the element fields `fields` (named "0", "1",
# .. here), registered as the parse registers a struct, and queued for
# emit_late_enum_types.
fn tuple_struct_new(s: *EmitterState, name_sv: StrView, fields: *StructField) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    var f: *StructField = fields
    while f != null
        let nm: *u8 = malloc(TUPLE_FIELD_NAME_BUF)
        let nlen: i32 = write_dec_i32(nm, i)
        *(nm + nlen) = 0
        f.name = nm
        f.name_len = nlen
        i = i + 1
        f = f.next
    let st: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
    st.name = name
    st.name_len = len
    st.fields = fields
    st.next = s.module.structs
    s.module.structs = st
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    if not hashmap_i64_contains(@s.struct_map, key)
        hashmap_i64_insert(@&s.struct_map, key, st as i64)
    namelist_push(@s.late_tuples, StrView { ptr: (name), len: (len) as i64 })
    st

# AGAST #4408 (#1816): the name tuple_lit_name decided for a literal is kept
# here, not written into the Expr.  One emission lowers a literal more than
# once (a call argument, a field or a match arm names it, then emit_expr names
# it again), and the first decision must stand -- exactly what the write made
# true.  This side table is that state without touching the node; ast.ritz
# (#4407) and emitter_core.ritz (#4404) are other rooms' files.
var g_tuple_names_on: i32 = 0
var g_tuple_names: *HashMapI64 = null       # a nameless tuple *Expr -> its struct name
var g_tuple_name_lens: *HashMapI64 = null   # the same *Expr -> that name's length

fn tuple_name_note(e: *Expr, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if g_tuple_names_on == 0
        g_tuple_names = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_tuple_names = hashmap_i64_with_cap(1024)
        g_tuple_name_lens = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_tuple_name_lens = hashmap_i64_with_cap(1024)
        g_tuple_names_on = 1
    hashmap_i64_insert(@&(*g_tuple_names), e as i64, name as i64)
    hashmap_i64_insert(@&(*g_tuple_name_lens), e as i64, len as i64)

# 1 when `e`'s name was already decided this emission, with it in
# out_name/out_len; 0 when it has none yet.
fn tuple_name_get(e: *Expr, out_name: **u8, out_len: *i32) -> i32
    if g_tuple_names_on == 0 or not hashmap_i64_contains(@(*g_tuple_names), e as i64)
        return 0
    *out_name = hashmap_i64_get(@(*g_tuple_names), e as i64) as *u8
    *out_len = hashmap_i64_get(@(*g_tuple_name_lens), e as i64) as i32
    1

# Name the nameless tuple literal `e` from its elements' types (nested
# nameless tuples first).  Writes the name to out_name/out_len and returns 1
# once named; returns 0 after a located error, out_name null.  The name is
# remembered in the side table, never on the node (AGAST #4408).
fn tuple_lit_infer(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    let n: i32 = tuple_lit_arity(e)
    let spells: **u8 = malloc((n as i64) * 8) as **u8
    let spell_lens: *i32 = malloc((n as i64) * 4) as *i32
    var fields: *StructField = null
    var last: *StructField = null
    var total: i32 = 5  # "tuple"
    var i: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let v: *Expr = fi.value
        if tuple_lit_nameless(v) == 1
            var vn: *u8 = null
            var vl: i32 = 0
            if tuple_lit_infer(s, v, @vn, @vl) == 0
                *out_name = null
                *out_len = 0
                return 0
        let f: *StructField = calloc(1, sizeof(StructField)) as *StructField
        var sp: *u8 = null
        let sl: i32 = tuple_elem_type(s, v, f, @sp)
        if sl == 0
            emit_nd_error(s, v.span.line, v.span.col, c"ritz1 can't infer the type of this tuple element (a `**T`, a reference, an N-D array, or a value whose type it can't name): give the tuple a type, as `let t: (A, B) = ..`")
            *out_name = null
            *out_len = 0
            return 0
        if last == null
            fields = f
        else
            last.next = f
        last = f
        *(spells + i) = sp
        *(spell_lens + i) = sl
        total = total + 1 + sl
        i = i + 1
        fi = fi.next
    let name: *u8 = malloc((total + 1) as i64)
    memcpy(name, c"tuple", 5)
    var pos: i32 = 5
    for j in 0..n
        *(name + pos) = 95  # '_'
        memcpy(name + pos + 1, *(spells + j), *(spell_lens + j) as i64)
        pos = pos + 1 + *(spell_lens + j)
    *(name + pos) = 0
    if find_struct(s, StrView { ptr: (name), len: (pos) as i64 }) == null
        tuple_struct_new(s, StrView { ptr: (name), len: (pos) as i64 }, fields)
    *out_name = name
    *out_len = pos
    tuple_name_note(e, StrView { ptr: (name), len: (pos) as i64 })
    1

# Name `e`, if it is a nameless tuple literal: from the slot struct
# `slot` / `slot_len` when that is a tuple of as many elements, else from its
# elements.  Writes the decided name to out_name/out_len and returns 1, or
# returns 0 after a located error with out_name null.  `e` is left as the
# parse built it (AGAST #4408 / #1816).
pub fn tuple_lit_name(s: *EmitterState, e: *Expr, slot_sv: StrView, out_name: **u8, out_len: *i32) -> i32
    var slot: *u8 = slot_sv.ptr
    var slot_len: i32 = slot_sv.len as i32
    *out_name = null
    *out_len = 0
    if tuple_lit_nameless(e) == 0
        if e != null
            *out_name = e.ident_ptr
            *out_len = e.ident_len
        return 1
    # The first site to name this literal fixes it, as the write did.
    if tuple_name_get(e, out_name, out_len) == 1
        return 1
    let st: *StructDef = tuple_slot_def(s, StrView { ptr: (slot), len: (slot_len) as i64 }, tuple_lit_arity(e))
    if st != null
        *out_name = st.name
        *out_len = st.name_len
        tuple_name_note(e, StrView { ptr: (st.name), len: (st.name_len) as i64 })
        return 1
    tuple_lit_infer(s, e, out_name, out_len)

# Emit a struct literal into an existing alloca and return the alloca register
# Used for returning struct literals from functions
pub fn emit_struct_lit_to_alloca(s: *EmitterState, e: *Expr, alloca_reg: i32) -> i32
    var lname: *u8 = null
    var lname_len: i32 = 0
    tuple_lit_name(s, e, StrView { ptr: (null), len: (0) as i64 }, @lname, @lname_len)   # AGAST #3005
    var st: *StructDef = null
    if lname != null
        st = find_struct(s, StrView { ptr: (lname), len: (lname_len) as i64 })
    if st == null
        emit_ir_error(s, e.span, c"struct not found for literal")
        return alloca_reg

    # Iterate through field initializers
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        var field_idx: i32 = find_field_index(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
        # `a: [v; N]` for an array field is written in place.
        if field_idx >= 0
            if emit_struct_lit_array_fill_field(s, st, field_idx, fi.value, alloca_reg) == 1
                field_idx = -1  # done (AGAST #1605)
        if field_idx >= 0
            emit_struct_lit_field_store(s, st, field_idx, fi.value, alloca_reg)
        fi = fi.next
    emit_struct_lit_zero_omitted(s, st, e, alloca_reg)
    alloca_reg

# 1 if struct literal `e` gives a field named `f`.
fn struct_lit_gives(e: *Expr, f: *StructField) -> i32
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if fi.name_len == f.name_len and memcmp(fi.name, f.name, f.name_len as i64) == 0
            return 1
        fi = fi.next
    0

# Zero every field of `st` that struct literal `e` leaves out, in the struct
# at `base_reg` (LANGUAGE_SPEC §9.2, AGAST #1749).  Called after the given
# fields are stored, so a given field is never overwritten.  A scalar is a
# `store zeroinitializer`; an array or struct goes through @__ritz_sret_zero,
# never llvm.memset (AGAST #3218: codegen turns a large one into a libc call,
# and ritz links -nostdlib).  Both literal lowerings call it: emit_var_decl's
# `let` / `var` loop and emit_struct_lit_to_alloca.
pub fn emit_struct_lit_zero_omitted(s: *EmitterState, st: *StructDef, e: *Expr, base_reg: i32)
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if struct_lit_gives(e, f) == 0
            let fp: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, fp)
            emit_str(s, IR_GEP_NAMED)
            emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, base_reg)
            emit_str(s, IR_I32_ZERO)
            emit_int(s, idx as i64)
            emit_str(s, c"  ; omitted field: zero\n")
            if f.field_type == TYPE_ARRAY or f.field_type == TYPE_STRUCT
                emit_str(s, c"  call void @__ritz_sret_zero(ptr ")
                emit_reg(s, fp)
                emit_str(s, c", i64 ptrtoint (ptr getelementptr (")
                emit_field_llvm_type(s, f)
                emit_str(s, c", ptr null, i32 1) to i64))\n")
                s.sret_helpers_used = 1
            else
                emit_str(s, IR_STORE_IND)
                emit_field_llvm_type(s, f)
                emit_str(s, c" zeroinitializer, ptr ")
                emit_reg(s, fp)
                emit_str(s, IR_NL)
        idx = idx + 1
        f = f.next

# Lower a struct literal to a value: `alloca %T`, fill it field by field via
# emit_struct_lit_to_alloca, then `load %T`. Returns the aggregate register.
# Unknown struct names are a located error (from emit_struct_lit_to_alloca's
# lookup), never a silently wrong value. (AGAST #1362)
fn emit_struct_lit_value(s: *EmitterState, e: *Expr) -> i32
    var lname: *u8 = null
    var lname_len: i32 = 0
    tuple_lit_name(s, e, StrView { ptr: (null), len: (0) as i64 }, @lname, @lname_len)   # AGAST #3005
    var st: *StructDef = null
    if lname != null
        st = find_struct(s, StrView { ptr: (lname), len: (lname_len) as i64 })
    if st == null
        emit_ir_error(s, e.span, c"struct not found for literal")
        let zero: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, zero)
        emit_str(s, IR_ADD_ZERO)
        return zero
    let tmp: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, tmp)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, c"  ; rvalue struct literal\n")
    entry_alloca_reg_end(s)
    emit_struct_lit_to_alloca(s, e, tmp)
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD_NAMED)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, tmp)
    emit_str(s, IR_NL)
    val

