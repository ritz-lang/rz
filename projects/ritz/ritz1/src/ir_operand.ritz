# What the IR text of an operand says about it (AGAST #4696).
#
# The format_into sink of a ported emitter file (EmitterState.push_bytes in
# emitter_core.ritz) sees the instruction as pieces of text, not as calls
# naming each register.  It recognises a register operand by its digits after
# `%.`, and decides from the line so far what the register is used for.  Both
# decisions are here, on StrViews alone, so a unit test can state them
# (ritz1/test/test_emit_sink.ritz).

import ritzlib.strview

# What a register operand is, to the packed-align tracking (AGAST #4462):
# anything else; after a `, ptr ` the base of a getelementptr; or the pointer of
# a load / store.
pub const REG_PLAIN: i32 = 0
pub const REG_GEP_BASE: i32 = 1
pub const REG_ACCESS_PTR: i32 = 2

# What a register operand at the end of `line` is.
pub fn reg_operand_kind_of(line: StrView) -> i32
    if line.len < 6 or not line.ends_with(", ptr ")
        return REG_PLAIN
    if line.contains(" = getelementptr ")
        return REG_GEP_BASE
    if line.starts_with("  store ") or line.contains(" = load ")
        return REG_ACCESS_PTR
    REG_PLAIN

# The register number `text` spells in decimal (at most ten digits, as an
# i32); -1 when it is anything else.
pub fn register_digits(text: StrView) -> i32
    if text.len == 0 or text.len > 10
        return 0 - 1
    var reg: i64 = 0
    for i in 0..text.len
        let d: u8 = text.get(i)
        if d < '0' or d > '9'
            return 0 - 1
        reg = reg * 10 + ((d - '0') as i64)
    if reg > 2147483647
        return 0 - 1
    reg as i32
