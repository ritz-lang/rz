# bool_check.ritz - `bool` is its own type (LARB R4, AGAST #2342)
#
# Conditions and `and` / `or` / `not` take bool.  Bitwise operators take
# integers.  `==` / `!=` need both sides the same kind.  bool converts to nothing
# implicitly and nothing converts to it: `b as i32` is 0 or 1, and `x as bool` is
# gone.  ritz0 says the same words (bool_rules.py); the shared table is
# ritz0/test_bool_type.py.
#
# A check on Sema (AGAST #3502, #1816): sema_walk calls each bool_check_* at
# the place the emitter used to, before the place's own sub-expressions, so
# the reports come in the same order.  A report stops the compile before
# emission.
#
# ritz0 reads a kind off the LLVM type: i1 is bool.  ritz1 works it out from
# the expression: sema_bool_kind, from Sema's scope and sema_expr_ty.  #1364's
# "stay silent when unsure" doesn't transfer: a condition sema_bool_kind can't
# type is an error, so the inference has to reach every condition the corpus
# writes.  A slot, where a miss only keeps today's behaviour, stays silent when
# unsure.  The emitter keeps its own copy for codegen (bool_kind.ritz), and
# RITZ1_SEMA_PROBE pins the two together on every expression it lowers.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import diag
import sema
import sema_type
import ritzlib.memory
import ritzlib.hashmap
import ritzlib.str

# What an expression is, as far as this rule cares.
const BK_UNSURE: i32 = 0
const BK_BOOL: i32 = 1
const BK_INT: i32 = 2
const BK_PTR: i32 = 3
const BK_FLOAT: i32 = 4
const BK_OTHER: i32 = 5
const BK_BAD: i32 = 6      # an operator bool_check_binary rejects by itself
const BK_NONE: i32 = -1    # SemaVar.bk / elem_bk: no note made

# The kind of a TYPE_* with its struct name, which may name a primitive.
pub fn bk_of_type(t: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if t == TYPE_BOOL
        return BK_BOOL
    if t == TYPE_F32 or t == TYPE_F64
        return BK_FLOAT
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return BK_PTR
    if t == TYPE_STRUCT
        if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"bool"), len: (4) as i64 }) == 1
            return BK_BOOL
        if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"usize"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"isize"), len: (5) as i64 }) == 1
            return BK_INT
        return BK_OTHER
    if t == TYPE_ARRAY
        return BK_OTHER
    if t == TYPE_VOID
        return BK_UNSURE
    BK_INT

pub fn bk_of_fn(f: *FnDef) -> i32
    bk_of_type(f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })

pub fn bk_arithmetic(l: i32, r: i32) -> i32
    if l == BK_PTR or r == BK_PTR
        return BK_PTR
    if l == BK_FLOAT or r == BK_FLOAT
        return BK_FLOAT
    if l == BK_UNSURE or r == BK_UNSURE
        return BK_UNSURE
    BK_INT

fn bk_words(k: i32) -> *u8
    if k == BK_INT
        return c"an integer"
    if k == BK_PTR
        return c"a pointer"
    if k == BK_FLOAT
        return c"a float"
    c"a struct or enum"

fn bk_write(k: i32)
    if k == BK_INT
        eprints_cstr(c": write `x != 0`")
    else if k == BK_PTR
        eprints_cstr(c": write `p != null`")

fn bool_op_name(op: i32) -> *u8
    if op == OP_AND
        return c"and"
    if op == OP_OR
        return c"or"
    if op == OP_BIT_AND
        return c"&"
    if op == OP_BIT_OR
        return c"|"
    if op == OP_BIT_XOR
        return c"^"
    if op == OP_SHL
        return c"<<"
    if op == OP_SHR
        return c">>"
    if op == OP_ADD
        return c"+"
    if op == OP_SUB
        return c"-"
    if op == OP_MUL
        return c"*"
    if op == OP_DIV
        return c"/"
    c"%"

fn is_comparison(e: *Expr) -> i32
    if e.kind == EXPR_BINARY and e.op >= OP_EQ and e.op <= OP_GE
        return 1
    0

# What `name` is in a mangled `Option$<name>` or `Result$<ok>$<err>`.
fn bk_mangled(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"bool"), len: (4) as i64 }) == 1
        return BK_BOOL
    if len == 2 or len == 3 or len == 5
        if *name == 'i' or *name == 'u'
            if len == 5 and name_eq(StrView { ptr: (name + 1), len: (4) as i64 }, StrView { ptr: (c"size"), len: (4) as i64 }) == 0
                return BK_UNSURE
            if len < 5 and (*(name + 1) < '0' or *(name + 1) > '9')
                return BK_UNSURE
            return BK_INT
    BK_UNSURE

# What `Some(v)`, `Ok(v)` or `Err(v)` binds over the mangled tagged enum `name`.
pub fn bk_tagged_payload(name_sv: StrView, is_err: i32) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < name_len and *(name + i) != '$'
        i += 1
    i += 1
    var end: i32 = i
    while end < name_len and *(name + end) != '$'
        end += 1
    if is_err == 1
        i = end + 1
        end = name_len
    if i >= name_len
        return BK_UNSURE
    bk_mangled(StrView { ptr: (name + i), len: (end - i) as i64 })

# What `Some(v)` / `Ok(v)` / `Err(v)` binds over the mangled tagged enum
# `name`: bk_tagged_payload's kinds, and a pointer for a payload ritz0 mangles
# `ptr_T` (`Option$ptr_u8`), which bk_mangled leaves unsure (AGAST #4200).
# Sema's bool_note_arm and the emitter's payload_bool_kind both read a
# binding with it, so the two agree (#4280).
pub fn bk_tagged_binding(name_sv: StrView, is_err: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'
        i += 1
    i += 1
    if is_err == 1
        while i < len and *(name + i) != '$'
            i += 1
        i += 1
    if i + 4 < len and name_eq(StrView { ptr: (name + i), len: (4) as i64 }, StrView { ptr: (c"ptr_"), len: (4) as i64 }) == 1
        return BK_PTR
    bk_tagged_payload(StrView { ptr: (name), len: (len) as i64 }, is_err)

# --- What an expression is, on Sema --------------------------------------------
#
# sema_bool_kind is the emitter's bool_kind (bool_kind.ritz) read off Sema's
# scope instead of LocalVar and get_expr_type.  bool_note_* record on each
# local what the emitter records on its LocalVar (is_bool / bk_unsure).

# The kind of a SemaTy kind, BK_UNSURE where Sema can't say.
fn sbk_of_ty(t: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if t == TYPE_UNKNOWN
        return BK_UNSURE
    bk_of_type(t, StrView { ptr: (name), len: (name_len) as i64 })

pub fn sbk_const(sm: *Sema, name_sv: StrView) -> *ConstEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return c
        c = c.next
    null

pub fn sbk_global(sm: *Sema, name_sv: StrView) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return g
        g = g.next
    null

fn sbk_name(sm: *Sema, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ce: *ConstEntry = sbk_const(sm, StrView { ptr: (name), len: (len) as i64 })
    if ce != null
        return bk_of_type(ce.const_type, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v != null
        if v.bk != BK_NONE
            return v.bk
        return sbk_of_ty(v.kind, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (name), len: (len) as i64 })
    if g != null
        return bk_of_type(g.var_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if sema_find_fn(sm, StrView { ptr: (name), len: (len) as i64 }) != null
        return BK_PTR
    BK_UNSURE

# What `name[i]` is, for a local or global `name`.
pub fn sbk_element(sm: *Sema, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v != null
        # AGAST #2440: a Vec, Span or String, or a pointer to one, indexes its
        # buffer's element.
        let through: i32 = sbk_through_elem(sm, v)
        if through != TYPE_VOID
            return bk_of_type(through, StrView { ptr: (null), len: (0) as i64 })
        if v.elem_bk != BK_NONE
            return v.elem_bk
        return sbk_of_ty(sbk_named_pointee(v.kind, v.pointee, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }), StrView { ptr: (null), len: (0) as i64 })
    let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (name), len: (len) as i64 })
    if g == null
        # AGAST #3768: `K[i]` of `const K: [N]T` is its T.  AGAST #4403: a
        # struct T too (`KS[i]` of a `const [N]StrView`), now that the
        # emitter's bk_element takes the same element from the ConstEntry.
        let ce: *ConstEntry = sbk_const(sm, StrView { ptr: (name), len: (len) as i64 })
        if ce != null and ce.const_type == TYPE_ARRAY
            return bk_of_type(ce.array_elem_type, StrView { ptr: (ce.array_elem_type_name), len: (ce.array_elem_type_name_len) as i64 })
        return BK_UNSURE
    if g.var_type == TYPE_ARRAY
        return bk_of_type(g.array_elem_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if g.var_type == TYPE_PTR
        return bk_of_type(g.pointee_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if g.var_type == TYPE_PTR_PTR
        return BK_PTR
    BK_UNSURE

# AGAST #3768: the primitive a `*T` of kind `k` points at when Sema left its
# pointee untyped and `name` spells it: a `-> *i32` call's return names its
# pointee "i32" (#1984), as `let p = pi()` binds it.  Else TYPE_UNKNOWN.
fn sbk_named_pointee(k: i32, pointee: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if k != TYPE_PTR or (pointee != TYPE_VOID and pointee != TYPE_UNKNOWN)
        return TYPE_UNKNOWN
    let p: i32 = primitive_type_from_name(StrView { ptr: (name), len: (len) as i64 })
    if p == 0
        return TYPE_UNKNOWN
    p

# The element kind of `v[i]` when `v` indexes through a Vec, Span or String
# (or one level of pointer to one), else TYPE_VOID: through_named_elem.
fn sbk_through_elem(sm: *Sema, v: *SemaVar) -> i32
    sema_through_elem(sm, v.kind, v.pointee, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })

# The field member access `e` reads, through a struct or a pointer to one.
fn sbk_field(sm: *Sema, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var r: SemaTy
    let rk: i32 = sema_expr_ty(sm, e.left, @r)
    var st: *StructDef = null
    if rk == TYPE_STRUCT
        st = sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    else if rk == TYPE_PTR or rk == TYPE_REF or rk == TYPE_MUT_REF
        if r.pointee == TYPE_STRUCT
            st = sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    if st == null
        return null
    let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if idx < 0
        return null
    get_field_type(st, idx)

# The N-D shape `x[i][j]..` indexes, and how many `[]` deep (nd_index_shape):
# an `[N][M]T` local, global or field.
fn sbk_nd_shape(sm: *Sema, e: *Expr, out_depth: *i32) -> *ArrayShape
    var depth: i32 = 0
    var base: *Expr = e
    while base.kind == EXPR_INDEX
        depth = depth + 1
        base = base.left
    var sh: *ArrayShape = null
    if base.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if v != null
            sh = v.shape
        else
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if g != null and g.var_type == TYPE_ARRAY
                sh = g.array_shape
    else if base.kind == EXPR_MEMBER
        let f: *StructField = sbk_field(sm, base)
        if f != null and f.field_type == TYPE_ARRAY
            sh = f.array_shape
    if sh == null or depth > sh.rank
        return null
    *out_depth = depth
    sh

fn sbk_index(sm: *Sema, e: *Expr) -> i32
    if e.right != null and e.right.kind == EXPR_RANGE
        return BK_PTR
    # AGAST #2768: a full-rank `x[i][j]` over an N-D `[N][M]T` is its leaf T.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = sbk_nd_shape(sm, e, @nd_depth)
    if nd_sh != null and nd_depth == nd_sh.rank
        return bk_of_type(nd_sh.leaf_type, StrView { ptr: (nd_sh.leaf_name), len: (nd_sh.leaf_name_len) as i64 })
    let base: *Expr = e.left
    # `(*p)[i]` with `p` a pointer to a Vec, Span or String.
    if base.kind == EXPR_UNARY and base.op == OP_DEREF and base.operand.kind == EXPR_IDENT
        let pv: *SemaVar = sema_find_local(sm, StrView { ptr: (base.operand.ident_ptr), len: (base.operand.ident_len) as i64 })
        if pv != null and pv.kind != TYPE_STRUCT
            let through: i32 = sbk_through_elem(sm, pv)
            if through != TYPE_VOID
                return bk_of_type(through, StrView { ptr: (null), len: (0) as i64 })
    if base.kind == EXPR_IDENT
        let k: i32 = sbk_element(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if k != BK_UNSURE
            return k
    else if base.kind == EXPR_MEMBER
        # AGAST #3024: `t.0[i]` of a nameless tuple's `[N]T` element.
        let tk: i32 = sbk_tuple_elem(sm, base)
        if tk != BK_UNSURE
            return tk
        # AGAST #3768: through what sbk_receiver names, too: `(*p).arr[i]`.
        let f: *StructField = sbk_member_field(sm, base)
        if f != null
            if f.field_type == TYPE_ARRAY
                return bk_of_type(f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
            if f.field_type == TYPE_PTR and f.array_elem_type == TYPE_BOOL
                return BK_BOOL
    # AGAST #3943: else Sema's one element typer, which also sees through a
    # Vec, Span or String a field, call or method holds (`w.vs[0]`, `mk()[0]`).
    var et: SemaTy
    if sema_elem_ty(sm, base, @et) != TYPE_UNKNOWN
        return bk_of_type(et.kind, StrView { ptr: (et.name), len: (et.name_len) as i64 })
    BK_UNSURE

# The first arm with a value: a `return` arm has none, and ritz0's phi skips it.
fn sbk_arms(sm: *Sema, arms: *MatchArm) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            let k: i32 = sema_bool_kind(sm, arm.body)
            if k != BK_UNSURE
                return k
        arm = arm.next
    BK_UNSURE

# What `e?` or `e.unwrap()` gives, for `e` an Option or Result.
fn sbk_payload_of(sm: *Sema, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    sbk_receiver(sm, e, @name, @len)
    if name == null or len <= 0 or is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        return BK_UNSURE
    bk_tagged_payload(StrView { ptr: (name), len: (len) as i64 }, 0)

# The type name method call `e` dispatches on, or null.
pub fn sbk_method_recv(sm: *Sema, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    let rcv: *Expr = e.left
    if rcv == null
        return null
    var name: *u8 = null
    var len: i32 = 0
    if rcv.kind == EXPR_IDENT
        if sema_find_local(sm, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 }) == null and sbk_global(sm, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 }) == null
            # Neither local nor global: a static call names its impl type.
            *out_len = rcv.ident_len
            return rcv.ident_ptr
    if rcv.kind == EXPR_STRUCT_LIT
        *out_len = rcv.ident_len
        return rcv.ident_ptr
    if rcv.kind == EXPR_STRING_LIT
        *out_len = 7
        return c"StrView"
    sbk_receiver(sm, rcv, @name, @len)
    if name == null or len <= 0
        return null
    *out_len = len
    name

# The fn a method call dispatches to, or null.
pub fn sbk_method_def(sm: *Sema, e: *Expr) -> *FnDef
    var tn_len: i32 = 0
    let tn: *u8 = sbk_method_recv(sm, e, @tn_len)
    if tn == null
        return null
    sema_method_fn(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# `expect` is none (AGAST #4263): no emitter lowers it.
fn sbk_is_unwrap(e: *Expr) -> i32
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap"), len: (6) as i64 }) == 1
        return 1
    name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap_or"), len: (9) as i64 })

# 1 when method call `e` on type `tn` is `StrView.as_bytes()`, a Span$u8 the
# emitter lowers inline (try_emit_strview_as_bytes) with no FnDef to read its
# kind off: without this an inferred `let b = s.as_bytes()` is BK_UNSURE, and
# ref_check can't see `@b` is a `@Span$u8` (AGAST #4132).
pub fn bk_is_strview_as_bytes(tn_sv: StrView, e: *Expr) -> i32
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if tn == null or e.args != null
        return 0
    if name_eq(StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 0
        return 0
    name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 })

fn sbk_method(sm: *Sema, e: *Expr) -> i32
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_some"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_none"), len: (7) as i64 }) == 1
        return BK_BOOL
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_ok"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_err"), len: (6) as i64 }) == 1
        return BK_BOOL
    # The carrier's own methods hand back its payload.
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap_or"), len: (9) as i64 }) == 1
        let pk: i32 = sbk_payload_of(sm, e.left)
        if pk != BK_UNSURE
            return pk
    var tn_len: i32 = 0
    let tn: *u8 = sbk_method_recv(sm, e, @tn_len)
    if bk_is_strview_as_bytes(StrView { ptr: (tn), len: (tn_len) as i64 }, e) == 1
        return BK_OTHER
    let fd: *FnDef = sbk_method_def(sm, e)
    if fd != null
        return bk_of_fn(fd)
    # AGAST #4403: a `Span$T` accessor the emitter lowers inline has no
    # FnDef; ask the typer that mirrors those builtins.
    var bt: SemaTy
    if sema_span_method_ty(StrView { ptr: (tn), len: (tn_len) as i64 }, e, @bt) != TYPE_UNKNOWN
        return bk_of_type(bt.kind, StrView { ptr: (bt.name), len: (bt.name_len) as i64 })
    BK_UNSURE

# The signature of fn value `c`, the callee of a nameless call: an element of
# a `[N]fn(..)` local or field, a cast to a fn type, a fn-pointer field, a
# call returning one.  Null when not known.
pub fn sbk_value_fn_sig(sm: *Sema, c: *Expr) -> *FnDef
    if c == null
        return null
    if c.kind == EXPR_INDEX and c.left != null and c.left.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (c.left.ident_ptr), len: (c.left.ident_len) as i64 })
        if v != null
            return v.elem_fn_sig
    else if c.kind == EXPR_INDEX and c.left != null and c.left.kind == EXPR_MEMBER and c.right != null and c.right.kind != EXPR_RANGE
        let af: *StructField = sbk_field(sm, c.left)
        if af != null and af.field_type == TYPE_ARRAY
            return af.elem_fn_sig
    else if c.kind == EXPR_CAST
        return c.fn_sig
    else if c.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, c)
        if f != null and f.field_type == TYPE_PTR
            return f.fn_sig
    else if c.kind == EXPR_CALL
        let fd: *FnDef = sema_call_fn(sm, c)
        if fd != null and fd.return_type == TYPE_PTR
            return fd.ret_fn_sig
    null

fn sbk_call(sm: *Sema, e: *Expr) -> i32
    if e.func_name_len == 0
        let sig: *FnDef = sbk_value_fn_sig(sm, e.left)
        if sig == null
            return BK_UNSURE
        return bk_of_fn(sig)
    # A call through a local: its signature, not a fn of that name.
    if e.func_name_len > 0
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if v != null
            if v.fn_sig != null
                return bk_of_fn(v.fn_sig)
            return BK_UNSURE
    # `volatile_load(p)` / `atomic_*(p, ..)` read p's pointee; a store is void.
    let mem: i32 = mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if mem != 0
        if mem == MEM_VOLATILE_STORE or mem == MEM_ATOMIC_STORE or e.args == null
            return BK_UNSURE
        let pt: i32 = sbk_pointee(sm, e.args)
        if pt == TYPE_UNKNOWN or pt == TYPE_VOID
            return BK_UNSURE
        return bk_of_type(pt, StrView { ptr: (null), len: (0) as i64 })
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd == null
        return BK_UNSURE
    bk_of_fn(fd)

# 1 when `e` names an array (a local, global or const), whose `[i]` is its
# element, not a view's.
fn sbk_is_array(sm: *Sema, e: *Expr) -> i32
    if e.kind != EXPR_IDENT
        return (e.kind == EXPR_MEMBER and sbk_member_kind_is_array(sm, e) == 1) as i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if v != null
        return (v.kind == TYPE_ARRAY) as i32
    let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if g != null
        return (g.var_type == TYPE_ARRAY) as i32
    let ce: *ConstEntry = sbk_const(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    (ce != null and ce.const_type == TYPE_ARRAY) as i32

fn sbk_member_kind_is_array(sm: *Sema, e: *Expr) -> i32
    let f: *StructField = sbk_member_field(sm, e)
    (f != null and f.field_type == TYPE_ARRAY) as i32

# The struct `e` is, or points at: `x`, `(*p).f`, `a[i].f`, `(x as *S).f`, ..
pub fn sbk_receiver(sm: *Sema, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e.kind == EXPR_UNARY and (e.op == OP_DEREF or e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        sbk_receiver(sm, e.operand, out_name, out_len)
    else if e.kind == EXPR_CALL and e.func_name_len == 0
        let sig: *FnDef = sbk_value_fn_sig(sm, e.left)
        if sig != null and (sig.return_type == TYPE_STRUCT or sig.return_type == TYPE_PTR)
            *out_name = sig.return_type_name
            *out_len = sig.return_type_name_len
    else if e.kind == EXPR_BINARY and (e.op == OP_ADD or e.op == OP_SUB)
        sbk_receiver(sm, e.left, out_name, out_len)
    else if e.kind == EXPR_INDEX
        sbk_receiver(sm, e.left, out_name, out_len)
        # `v[i]` of a Vec<S> / Span<S> is an S: its buffer's element.  An
        # array's element is the name itself.
        if *out_name != null and name_is_indexable(StrView { ptr: (*out_name), len: (*out_len) as i64 }) == 1 and sbk_is_array(sm, e.left) == 0
            let st: *StructDef = sema_find_struct(sm, StrView { ptr: (*out_name), len: (*out_len) as i64 })
            *out_name = null
            *out_len = 0
            if st != null
                var di: i32 = find_field_index(st, StrView { ptr: (c"data"), len: (4) as i64 })
                if di < 0
                    di = find_field_index(st, StrView { ptr: (c"ptr"), len: (3) as i64 })
                if di >= 0
                    let df: *StructField = get_field_type(st, di)
                    *out_name = df.field_type_name
                    *out_len = df.field_type_name_len
    else if e.kind == EXPR_CAST and e.ident_len > 0
        *out_name = e.ident_ptr
        *out_len = e.ident_len
    else if e.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if v != null
            *out_name = v.type_name
            *out_len = v.type_name_len
        else
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            # AGAST #3984: a `[N]T` global keeps T as its element's name.
            if g != null and g.var_type == TYPE_ARRAY
                *out_name = g.array_elem_type_name
                *out_len = g.array_elem_type_name_len
            else if g != null
                *out_name = g.type_name
                *out_len = g.type_name_len
            else
                let ce: *ConstEntry = sbk_const(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if ce != null and ce.const_type == TYPE_ARRAY
                    *out_name = ce.array_elem_type_name
                    *out_len = ce.array_elem_type_name_len
                else if ce != null
                    *out_name = ce.type_name
                    *out_len = ce.type_name_len
    else if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        # The first arm that names one.
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null and *out_name == null
            if arm.is_pass == 0 and arm.body != null
                sbk_receiver(sm, arm.body, out_name, out_len)
            arm = arm.next
    else if e.kind == EXPR_METHOD and sbk_is_unwrap(e) == 1
        # `r.unwrap()` of an Option$S / Result$S$E is an S.
        var cname: *u8 = null
        var clen: i32 = 0
        sbk_receiver(sm, e.left, @cname, @clen)
        if cname != null and clen > 0 and is_tagged_enum_type(StrView { ptr: (cname), len: (clen) as i64 }) == 1
            var ok_len: i32 = 0
            let ok: *u8 = sbk_ok_struct(sm, StrView { ptr: (cname), len: (clen) as i64 }, @ok_len)
            if ok != null
                *out_name = ok
                *out_len = ok_len
    else if e.kind == EXPR_METHOD
        # A method's struct, `*S`, or `@S` / `@&S` return names the next
        # receiver.
        let fd: *FnDef = sbk_method_def(sm, e)
        if fd != null and (fd.return_type == TYPE_STRUCT or fd.return_type == TYPE_PTR)
            *out_name = fd.return_type_name
            *out_len = fd.return_type_name_len
        else if fd != null and (fd.return_type == TYPE_REF or fd.return_type == TYPE_MUT_REF)
            # AGAST #4457: `comp.damage_tracker().has_damage()` — the tail's
            # rule, so a method's `-> @S` / `-> @&S` types like a free fn's.
            var t: SemaTy
            if sema_expr_ty(sm, e, @t) == fd.return_type and t.pointee == TYPE_STRUCT
                *out_name = t.name
                *out_len = t.name_len
    else if e.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, e)
        if f != null
            if f.field_type == TYPE_ARRAY
                *out_name = f.array_elem_type_name
                *out_len = f.array_elem_type_name_len
            else
                *out_name = f.field_type_name
                *out_len = f.field_type_name_len
    else
        var t: SemaTy
        let k: i32 = sema_expr_ty(sm, e, @t)
        if k == TYPE_STRUCT or ((k == TYPE_PTR or k == TYPE_REF or k == TYPE_MUT_REF) and t.pointee == TYPE_STRUCT)
            *out_name = t.name
            *out_len = t.name_len

# The field `e` reads, through what sbk_receiver names when Sema can't type
# the receiver: `(*p).f`, `a[i].f`, `(*(*b).ops).n`.
pub fn sbk_member_field(sm: *Sema, e: *Expr) -> *StructField
    let f: *StructField = sbk_field(sm, e)
    if f != null or e.left == null
        return f
    var name: *u8 = null
    var len: i32 = 0
    sbk_receiver(sm, e.left, @name, @len)
    if name == null or len <= 0
        return null
    sbk_struct_field(sm, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# Field `field` of the struct `name`, or of what its `deref` hands back
# (`b.x` on a Box<Point>, AGAST #3015), or null.
pub fn sbk_struct_field(sm: *Sema, name_sv: StrView, field_sv: StrView) -> *StructField
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    var tn: *u8 = name
    var tn_len: i32 = len
    var hops: i32 = 0
    while hops < 4 and tn != null and tn_len > 0
        let st: *StructDef = sema_find_struct(sm, StrView { ptr: (tn), len: (tn_len) as i64 })
        if st == null
            return null
        let idx: i32 = find_field_index(st, StrView { ptr: (field), len: (field_len) as i64 })
        if idx >= 0
            return get_field_type(st, idx)
        let d: *FnDef = sema_impl_method(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"deref"), len: (5) as i64 })
        if d == null
            return null
        tn = d.return_type_name
        tn_len = d.return_type_name_len
        hops += 1
    null

fn sbk_member(sm: *Sema, e: *Expr) -> i32
    # AGAST #3768: `t.1` of a local bound to a nameless tuple.
    let tn: *SemaTupleNote = sbk_tuple_of(sm, e.left)
    let ti: i32 = sbk_tuple_index(tn, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if ti >= 0
        return tn.bk[ti]
    var f: *StructField = sbk_field(sm, e)
    # `colors.ON`: a const reached through its module.
    if f == null and e.left.kind == EXPR_IDENT and sema_find_local(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == null
        let ce: *ConstEntry = sbk_const(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if ce != null
            return bk_of_type(ce.const_type, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    if f == null
        var name: *u8 = null
        var len: i32 = 0
        sbk_receiver(sm, e.left, @name, @len)
        if name == null or len <= 0
            return BK_UNSURE
        f = sbk_struct_field(sm, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if f == null
            return BK_UNSURE
    bk_of_type(f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })

# What `*e` reads, a TYPE_*, or TYPE_UNKNOWN: the pointee of a pointer local,
# global, field or cast, through `p + n` / `p - n` and `@x`.
fn sbk_pointee(sm: *Sema, e: *Expr) -> i32
    let k: i32 = e.kind
    if k == EXPR_BINARY and (e.op == OP_ADD or e.op == OP_SUB)
        return sbk_pointee(sm, e.left)
    if k == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        return sema_expr_type(sm, e.operand)
    # `*a[i]` with `a: [N]*U` (a local, param or field) reads a U.
    if k == EXPR_INDEX and e.right != null and e.right.kind != EXPR_RANGE
        if e.left.kind == EXPR_IDENT
            let av: *SemaVar = sema_find_local(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if av != null and av.kind == TYPE_ARRAY and av.elem_bk == BK_PTR
                return av.elem_pointee
        else if e.left.kind == EXPR_MEMBER
            let af: *StructField = sbk_member_field(sm, e.left)
            if af != null and af.field_type == TYPE_ARRAY and af.array_elem_type == TYPE_PTR
                return af.array_elem_pointee
        return TYPE_UNKNOWN
    # AGAST #3768: `*f()` / `*x.m()` of a `-> *T` / `-> @T` with T a scalar
    # (inline_ptr_pointee): `m[k]` is `*m.index(k)` through `impl Index`.
    if k == EXPR_CALL or k == EXPR_METHOD
        var fd: *FnDef = null
        if k == EXPR_METHOD
            fd = sbk_method_def(sm, e)
        else if e.func_name_len > 0 and sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == null
            fd = sema_call_fn(sm, e)
        if fd == null
            return TYPE_UNKNOWN
        if fd.return_type == TYPE_PTR
            let rp: i32 = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            if rp != 0
                return rp
        let rr: i32 = ret_ref_scalar_pointee(fd)
        if rr != TYPE_VOID
            return rr
        return TYPE_UNKNOWN
    if k == EXPR_CAST
        if e.op == TYPE_PTR_PTR
            return TYPE_PTR
        if e.op == TYPE_PTR
            return e.int_val as i32
        return TYPE_UNKNOWN
    if k == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, e)
        if f == null
            return TYPE_UNKNOWN
        if f.field_type == TYPE_PTR_PTR
            return TYPE_PTR
        if f.field_type == TYPE_PTR
            return f.array_elem_type
        # An `@T` / `@&T` field: the `*T` emit_module lowers it to.
        if f.field_type == TYPE_REF or f.field_type == TYPE_MUT_REF
            if f.field_ref_ptr_pointee != TYPE_VOID and f.field_ref_ptr_pointee != 0
                return TYPE_PTR
            if f.field_type_name_len > 0
                return TYPE_STRUCT
            if f.array_elem_type != 0
                return f.array_elem_type
        return TYPE_UNKNOWN
    if k == EXPR_IDENT
        var t: SemaTy
        let tk: i32 = sema_expr_ty(sm, e, @t)
        if tk == TYPE_PTR_PTR
            return TYPE_PTR
        let np: i32 = sbk_named_pointee(tk, t.pointee, StrView { ptr: (t.name), len: (t.name_len) as i64 })
        if np != TYPE_UNKNOWN
            return np
        if tk == TYPE_PTR or tk == TYPE_REF or tk == TYPE_MUT_REF
            return t.pointee
    TYPE_UNKNOWN

# How many pointer levels `x` has (ptr_levels_of): a `**T` / `***T` local,
# global or field, through `+ n` and `*`, down to 1 under a `*` (`*pp`, which
# `*` reads a T from; AGAST #3768).  0 otherwise.  `*out_slot` is the root's
# inner-pointee slot, whose innermost pointee is that T.
fn sbk_ptr_depth(sm: *Sema, x: *Expr, out_slot: *i32) -> i32
    if x == null
        return 0
    if x.kind == EXPR_BINARY
        if x.op == OP_ADD or x.op == OP_SUB
            return sbk_ptr_depth(sm, x.left, out_slot)
        return 0
    if x.kind == EXPR_UNARY
        if x.op != OP_DEREF
            return 0
        let sub: i32 = sbk_ptr_depth(sm, x.operand, out_slot)
        if sub < 2
            return 0
        return sub - 1
    var slot: i32 = TYPE_VOID
    if x.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if v != null
            if v.kind != TYPE_PTR_PTR
                return 0
            slot = v.inner
        else
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if g == null or g.var_type != TYPE_PTR_PTR
                return 0
            slot = g.inner_pointee_type
    else if x.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, x)
        if f == null or f.field_type != TYPE_PTR_PTR
            return 0
        slot = f.inner_pointee_type
    else
        return 0
    let levels: i32 = ptr_ptr_slot_levels(slot)
    if levels < 2
        return 0
    *out_slot = slot
    levels

# `*e`: its pointee's kind.  A pointee Sema can't type is unsure: the emitter's
# get_expr_type may know it (a bool, a float), and an integer guess there
# would refuse a good program.  (It calls what it can't type an i64.)
fn sbk_deref(sm: *Sema, e: *Expr) -> i32
    # AGAST #2972: `*h` of an integer or `bool` borrow `h:& T` is `h`.
    let o: *Expr = e.operand
    if o.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
        if v != null and v.kind == TYPE_UNKNOWN and (v.bk == BK_BOOL or v.bk == BK_INT)
            return v.bk
    # `*p` of a `**T` (or deeper) is a pointer; `*(*pp + k)` its T.
    var slot: i32 = TYPE_VOID
    let depth: i32 = sbk_ptr_depth(sm, o, @slot)
    if depth >= 2
        return BK_PTR
    if depth == 1 and ptr_ptr_slot_inner(slot) != TYPE_STRUCT
        return sbk_of_ty(ptr_ptr_slot_inner(slot), StrView { ptr: (null), len: (0) as i64 })
    # `*r` of `let r = @x`, whose pointee Sema leaves untyped.
    if o.kind == EXPR_IDENT
        let rv: *SemaVar = sema_find_local(sm, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
        if rv != null and rv.elem_bk != BK_NONE and (rv.pointee == TYPE_VOID or rv.pointee == TYPE_UNKNOWN)
            return rv.elem_bk
    # AGAST #3024: `*(t.0)` of a nameless tuple's `*T` element.
    if o.kind == EXPR_MEMBER
        let tk: i32 = sbk_tuple_elem(sm, o)
        if tk != BK_UNSURE
            return tk
    let pt: i32 = sbk_pointee(sm, o)
    # `*@x` of a struct reads as an i64 to the emitter; `*p` of a `*S` a struct.
    if pt == TYPE_STRUCT and o.kind != EXPR_UNARY
        # Through `x: @S` / `@&S` the emitter's get_expr_type says i64.
        let ok: i32 = sema_expr_type(sm, o)
        if o.kind == EXPR_IDENT and (ok == TYPE_REF or ok == TYPE_MUT_REF)
            return BK_INT
        return BK_OTHER
    if pt == TYPE_BOOL
        return BK_BOOL
    if pt == TYPE_F32 or pt == TYPE_F64
        return BK_FLOAT
    if pt == TYPE_PTR or pt == TYPE_PTR_PTR or pt == TYPE_REF or pt == TYPE_MUT_REF
        return BK_PTR
    if pt == TYPE_UNKNOWN or pt == TYPE_VOID
        # AGAST #3768: `*@a[i]` reads what `a[i]` is, a scalar (not a struct,
        # which the emitter's get_expr_type calls an i64).
        if o.kind == EXPR_UNARY and (o.op == OP_ADDR or o.op == OP_ADDR_MUT)
            let ik: i32 = sema_bool_kind(sm, o.operand)
            if ik == BK_INT or ik == BK_BOOL or ik == BK_FLOAT or ik == BK_PTR
                return ik
        return BK_UNSURE
    BK_INT

# What `e` is, or BK_UNSURE.  See the header.
pub fn sema_bool_kind(sm: *Sema, e: *Expr) -> i32
    if e == null
        return BK_UNSURE
    let k: i32 = e.kind
    if k == EXPR_INT_LIT
        if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
            return BK_BOOL
        if e.lit_kind == LIT_PASS
            return BK_UNSURE
        return BK_INT
    if k == EXPR_CHAR_LIT
        return BK_INT
    if k == EXPR_FLOAT_LIT
        return BK_FLOAT
    if k == EXPR_CSTRING_LIT or k == EXPR_NIL_LIT
        return BK_PTR
    if k == EXPR_STRING_LIT or k == EXPR_STRUCT_LIT or k == EXPR_ARRAY_LIT or k == EXPR_ARRAY_FILL
        return BK_OTHER
    if k == EXPR_IDENT
        return sbk_name(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if k == EXPR_BINARY
        if e.op >= OP_EQ and e.op <= OP_OR
            return BK_BOOL
        let l: i32 = sema_bool_kind(sm, e.left)
        let r: i32 = sema_bool_kind(sm, e.right)
        if l == BK_BOOL or r == BK_BOOL
            return BK_BAD
        if e.op >= OP_BIT_AND and e.op <= OP_SHR
            return BK_INT
        return bk_arithmetic(l, r)
    if k == EXPR_UNARY
        if e.op == OP_NOT
            return BK_BOOL
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT
            return BK_PTR
        if e.op == OP_NEG or e.op == OP_BIT_NOT
            let o: i32 = sema_bool_kind(sm, e.operand)
            if o == BK_BOOL
                return BK_BAD
            return o
        if e.op == OP_DEREF
            return sbk_deref(sm, e)
        return BK_UNSURE
    if k == EXPR_CAST
        return bk_of_type(e.op, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if k == EXPR_MEMBER
        return sbk_member(sm, e)
    if k == EXPR_INDEX
        return sbk_index(sm, e)
    if k == EXPR_CALL
        return sbk_call(sm, e)
    if k == EXPR_METHOD
        return sbk_method(sm, e)
    if k == EXPR_IF or k == EXPR_MATCH
        return sbk_arms(sm, e.args as *MatchArm)
    if k == EXPR_TRY
        return sbk_payload_of(sm, e.left)
    BK_UNSURE

# --- Notes on the locals sema_walk binds ---------------------------------------

fn sbk_last(sm: *Sema) -> *SemaVar
    if sm.scope_top <= 0
        return null
    @sm.scope[sm.scope_top - 1]

# A local's kind, as bool_note_binding notes a pattern binding: bool, an
# integer, a pointer (AGAST #4200: so float_slot_pointer refuses `Some(q) =>
# q` in a float slot, as ritz0 does), or unsure.
fn sbk_binding(k: i32) -> i32
    if k == BK_BOOL or k == BK_INT or k == BK_PTR
        return k
    BK_UNSURE

# What `Some(v)` / `Ok(v)` / `Err(v)` binds over the mangled tagged enum
# `name`, as a binding on Sema: bk_tagged_binding's kinds.
fn sbk_tagged_binding(name_sv: StrView, is_err: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    sbk_binding(bk_tagged_binding(StrView { ptr: (name), len: (len) as i64 }, is_err))

# The `let` / `var` sema_walk just bound.  An unannotated one takes its
# initialiser's kind, judged before it is in scope (`let x = x`).
pub fn bool_note_decl(sm: *Sema, st: *Stmt)
    let v: *SemaVar = sbk_last(sm)
    if v == null
        return
    if st.var_declared_type == TYPE_VOID
        if st.var_init != null
            sm.scope_top = sm.scope_top - 1
            let k: i32 = sema_bool_kind(sm, st.var_init)
            # `var p = match o ..` of a struct: name it for `p.f`.
            var rname: *u8 = null
            var rlen: i32 = 0
            if v.type_name == null or v.type_name_len <= 0
                sbk_receiver(sm, st.var_init, @rname, @rlen)
            # `let r = @&a[i]`: `*r` and `r[0]` are what it points at.
            let init: *Expr = st.var_init
            if init.kind == EXPR_UNARY and (init.op == OP_ADDR or init.op == OP_ADDR_MUT)
                v.elem_bk = sema_bool_kind(sm, init.operand)
            # `let b = f()` with `f -> [N]T`: its elements are T.
            else if init.kind == EXPR_CALL and init.func_name_len > 0
                let rf: *FnDef = sema_call_fn(sm, init)
                if rf != null and rf.ret_array != null
                    let ra: *ArrayElem = rf.ret_array
                    v.elem_bk = bk_of_type(ra.elem, StrView { ptr: (ra.name), len: (ra.name_len) as i64 })
                    v.shape = ra.shape
                    v.elem_pointee = ra.pointee
            # `let a = [true, false]` / `[false; 100]`: its elements.
            else if init.kind == EXPR_ARRAY_LIT and init.args != null
                v.elem_bk = sema_bool_kind(sm, init.args)
            else if init.kind == EXPR_ARRAY_FILL
                v.elem_bk = sema_bool_kind(sm, init.left)
            # AGAST #3768: `let t = (a, b)`: its elements, for `t.1` / `let (x, y) = t`.
            v.bk_tuple = sbk_tuple_of(sm, init)
            sm.scope_top = sm.scope_top + 1
            if rname != null and rlen > 0
                v.type_name = rname
                v.type_name_len = rlen
            if k == BK_BAD
                v.bk = BK_INT
            else
                v.bk = k
        return
    v.bk = bk_of_type(st.var_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
    v.inner = st.var_inner_pointee_type
    if st.var_type == TYPE_ARRAY
        v.elem_fn_sig = st.var_fn_sig
        v.shape = st.var_array_shape
        v.elem_pointee = st.var_array_elem_pointee
        v.elem_bk = bk_of_type(st.var_array_elem_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
    else if st.var_type == TYPE_PTR or st.var_type == TYPE_REF or st.var_type == TYPE_MUT_REF
        # `p: *[N]T` indexes T (#2321), not the array.
        if st.var_pointee_type == TYPE_ARRAY
            v.elem_bk = bk_of_type(st.var_pointee_array_elem_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
        else
            v.elem_bk = bk_of_type(st.var_pointee_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
    else if st.var_type == TYPE_PTR_PTR
        v.elem_bk = BK_PTR

# The param sema_walk just bound.
pub fn bool_note_param(sm: *Sema, p: *Param)
    let v: *SemaVar = sbk_last(sm)
    if v == null
        return
    # `x:& T` binds as the T it borrows (bind_scalar_borrow_param): an integer,
    # `bool`, float, `*T` or `[N]T`; `*x` of a scalar is `x`.
    let pt: i32 = p.param_pointee_type
    # Sema binds a `:&` param untyped: its struct (`c:& C`, `p:& **K`) names
    # it for `p.f`.
    if p.is_borrow == 1 and v.kind == TYPE_UNKNOWN
        v.type_name = p.param_type_name
        v.type_name_len = p.param_type_name_len
    if p.is_borrow == 1 and p.param_type == TYPE_MUT_REF and pt != TYPE_STRUCT
        v.bk = bk_of_type(pt, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        if pt == TYPE_ARRAY
            v.elem_bk = bk_of_type(p.param_pointee_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
            v.shape = p.param_pointee_array_shape
        return
    v.bk = bk_of_type(p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    v.inner = p.param_inner_pointee_type
    if v.inner == TYPE_VOID
        v.inner = p.param_ref_ptr_pointee
    if p.param_type == TYPE_ARRAY
        v.elem_bk = bk_of_type(p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        v.shape = p.param_array_shape
        v.elem_pointee = p.param_array_elem_pointee
    else if p.param_type == TYPE_PTR or p.param_type == TYPE_REF or p.param_type == TYPE_MUT_REF
        if p.param_pointee_type == TYPE_ARRAY
            v.elem_bk = bk_of_type(p.param_pointee_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        else
            v.elem_bk = bk_of_type(p.param_pointee_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else if p.param_type == TYPE_PTR_PTR
        v.elem_bk = BK_PTR

# The two bindings of `let (a, b) = init` sema_walk just bound: the elements
# of the nameless tuple it destructures (sbk_tuple_of), else the fields of the
# struct it does.
pub fn bool_note_tuple(sm: *Sema, st: *Stmt)
    if sm.scope_top < 2 or st.var_init == null
        return
    sm.scope_top = sm.scope_top - 2
    let note: *SemaTupleNote = sbk_tuple_of(sm, st.var_init)
    var k0: i32 = BK_UNSURE
    var k1: i32 = BK_UNSURE
    if note != null
        if note.n >= 2
            k0 = note.bk[0]
            k1 = note.bk[1]
    else
        var lit: *Expr = st.var_init
        if lit.kind == EXPR_IF or lit.kind == EXPR_MATCH
            var arm: *MatchArm = lit.args as *MatchArm
            while arm != null and (arm.is_pass == 1 or arm.body == null)
                arm = arm.next
            lit = null
            if arm != null
                lit = arm.body
        if lit != null and (lit.kind != EXPR_STRUCT_LIT or lit.ident_len != 0)
            var name: *u8 = null
            var len: i32 = 0
            sbk_receiver(sm, lit, @name, @len)
            let ts: *StructDef = sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 })
            if ts != null and ts.fields != null and ts.fields.next != null
                k0 = bk_of_type(ts.fields.field_type, StrView { ptr: (ts.fields.field_type_name), len: (ts.fields.field_type_name_len) as i64 })
                k1 = bk_of_type(ts.fields.next.field_type, StrView { ptr: (ts.fields.next.field_type_name), len: (ts.fields.next.field_type_name_len) as i64 })
    sm.scope_top = sm.scope_top + 2
    let a: *SemaVar = @sm.scope[sm.scope_top - 2]
    a.bk = k0
    let b: *SemaVar = @sm.scope[sm.scope_top - 1]
    b.bk = k1
    if note != null and note.n >= 2
        sbk_tuple_bind(a, note, 0)
        sbk_tuple_bind(b, note, 1)

# --- Nameless tuples (AGAST #3768) ---------------------------------------------
#
# Sema binds `let t = (a, b)` and `let (x, y) = t` untyped: the emitter names
# the tuple's struct at emit time (tuple_lit_name).  bool_check notes each
# nameless tuple literal's elements when the walk reaches it, in its own scope
# (an `if` arm's `let q = 3` then `(q, 1)` sees its q), and the locals bound to
# one carry the note (SemaVar.bk_tuple).

var g_sbk_tuples_on: i32 = 0
var g_sbk_tuples: *HashMapI64 = null       # a nameless tuple literal -> its *SemaTupleNote

fn sbk_is_tuple_lit(e: *Expr) -> i32
    if e == null or e.kind != EXPR_STRUCT_LIT or e.ident_len != 0
        return 0
    let fi: *FieldInit = e.args as *FieldInit
    (fi != null and fi.name_len == 1 and *fi.name == '0') as i32

# The note on nameless tuple literal `e`, its elements judged in the scope now.
fn sbk_tuple_lit(sm: *Sema, e: *Expr) -> *SemaTupleNote
    var n: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null and n < SEMA_TUPLE_MAX
        n += 1
        fi = fi.next
    let note: *SemaTupleNote = malloc(sizeof(SemaTupleNote)) as *SemaTupleNote
    note.n = n
    var i: i32 = 0
    fi = e.args as *FieldInit
    while i < n
        note.bk[i] = sema_bool_kind(sm, fi.value)
        var name: *u8 = null
        var len: i32 = 0
        sbk_receiver(sm, fi.value, @name, @len)
        note.name[i] = name
        note.name_len[i] = len
        note.sub[i] = sbk_tuple_of(sm, fi.value)
        note.elem[i] = sbk_value_elem(sm, fi.value)
        i += 1
        fi = fi.next
    note

# bool_check_struct_lit, on a nameless tuple literal: note it in its scope.
fn sbk_note_tuple_lit(sm: *Sema, e: *Expr)
    if sbk_is_tuple_lit(e) == 0
        return
    if g_sbk_tuples_on == 0
        g_sbk_tuples = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_sbk_tuples = hashmap_i64_with_cap(1024)
        g_sbk_tuples_on = 1
    let note: *SemaTupleNote = sbk_tuple_lit(sm, e)
    if note != null
        (*g_sbk_tuples).insert(e as i64, note as i64)

# The note on the nameless tuple `e` is: a literal, a local bound to one, an
# element of one (`t.0`), or an `if` / `match` whose arms are (its first
# arm's, as sbk_arms).  Null for anything else.
fn sbk_tuple_of(sm: *Sema, e: *Expr) -> *SemaTupleNote
    if e == null
        return null
    if sbk_is_tuple_lit(e) == 1
        if g_sbk_tuples_on == 1
            let has_tuple: bool = (*g_sbk_tuples).contains(e as i64)
            if has_tuple
                return (*g_sbk_tuples).get(e as i64) as *SemaTupleNote
        return sbk_tuple_lit(sm, e)
    if e.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if v == null
            return null
        return v.bk_tuple
    if e.kind == EXPR_MEMBER
        let tn: *SemaTupleNote = sbk_tuple_of(sm, e.left)
        let ti: i32 = sbk_tuple_index(tn, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if ti < 0
            return null
        return tn.sub[ti]
    if e.kind != EXPR_IF and e.kind != EXPR_MATCH
        return null
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            let an: *SemaTupleNote = sbk_tuple_of(sm, arm.body)
            if an != null
                return an
        arm = arm.next
    null

# AGAST #3024: what `*x` / `x[i]` reads for the tuple element `x`, as a
# `let` bound to it would note it: a local's or global's element (sbk_element),
# or a tuple element's own (`(t.0, 1)`); BK_NONE where Sema can't say.
fn sbk_value_elem(sm: *Sema, x: *Expr) -> i32
    var k: i32 = BK_UNSURE
    if x.kind == EXPR_IDENT
        k = sbk_element(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
    else if x.kind == EXPR_MEMBER
        k = sbk_tuple_elem(sm, x)
    if k == BK_UNSURE
        return BK_NONE
    k

# AGAST #3024: what `*m` / `m[i]` reads for `m` an element of a nameless
# tuple (`t.0`), else BK_UNSURE.
fn sbk_tuple_elem(sm: *Sema, m: *Expr) -> i32
    let tn: *SemaTupleNote = sbk_tuple_of(sm, m.left)
    let ti: i32 = sbk_tuple_index(tn, StrView { ptr: (m.ident_ptr), len: (m.ident_len) as i64 })
    if ti < 0 or tn.elem[ti] == BK_NONE
        return BK_UNSURE
    tn.elem[ti]

# Element `name` ("0", "1", ..) of `tn`, or -1.
fn sbk_tuple_index(tn: *SemaTupleNote, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if tn == null or len != 1
        return 0 - 1
    let i: i32 = *name as i32 - 48
    if i < 0 or i >= tn.n
        return 0 - 1
    i

# Binding `v` of a destructure takes element `i` of `tn`: the struct it names
# (Sema binds it untyped) and its own note.
fn sbk_tuple_bind(v: *SemaVar, tn: *SemaTupleNote, i: i32)
    v.bk_tuple = tn.sub[i]
    if tn.elem[i] != BK_NONE
        v.elem_bk = tn.elem[i]   # AGAST #3024
    if v.kind == TYPE_UNKNOWN and tn.name[i] != null and tn.name_len[i] > 0
        v.type_name = tn.name[i]
        v.type_name_len = tn.name_len[i]

# A `for` variable: an integer over a range, an element over `for x in a`.
pub fn bool_note_for(sm: *Sema, st: *Stmt)
    let v: *SemaVar = sbk_last(sm)
    if v == null
        return
    v.bk = BK_INT
    if st.for_end == null
        sm.scope_top = sm.scope_top - 1
        v.bk = sbk_iter_elem(sm, st.for_start)
        sbk_iter_rows(sm, v, st.for_start)
        sm.scope_top = sm.scope_top + 1

# `for r in m` over an N-D `[N][M]..T` (or a row of one, `m[i]`): `r` is a
# row, whose elements are T, or a plane of its own shape.
fn sbk_iter_rows(sm: *Sema, v: *SemaVar, it: *Expr)
    var e: *Expr = it
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        e = e.operand
    var depth: i32 = 0
    var sh: *ArrayShape = null
    if e.kind == EXPR_INDEX
        sh = sbk_nd_shape(sm, e, @depth)
    else if e.kind == EXPR_IDENT
        let lv: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if lv != null
            sh = lv.shape
        else
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g != null and g.var_type == TYPE_ARRAY
                sh = g.array_shape
    else if e.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, e)
        if f != null and f.field_type == TYPE_ARRAY
            sh = f.array_shape
    if sh == null
        return
    # What each turn binds has this many dimensions.
    let rank: i32 = sh.rank - depth - 1
    let leaf: i32 = bk_of_type(sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    if rank <= 0
        v.bk = leaf
        return
    v.bk = BK_OTHER
    v.elem_bk = leaf
    if rank == 1
        return
    v.elem_bk = BK_OTHER
    let sub: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    sub.rank = rank
    for i in 0..rank
        sub.dims[i] = sh.dims[sh.rank - rank + i]
    sub.leaf_type = sh.leaf_type
    sub.leaf_name = sh.leaf_name
    sub.leaf_name_len = sh.leaf_name_len
    sub.leaf_pointee = sh.leaf_pointee
    v.shape = sub

# What `for x in it` binds: an element of the array, Vec or Span `it` (or of
# what `@it` / `@&it` points at), else unsure.
fn sbk_iter_elem(sm: *Sema, it: *Expr) -> i32
    var e: *Expr = it
    if e == null
        return BK_UNSURE
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        e = e.operand
    if e.kind == EXPR_IDENT
        return sbk_element(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if e.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, e)
        if f != null and f.field_type == TYPE_ARRAY
            return bk_of_type(f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
    if e.kind == EXPR_ARRAY_LIT and e.args != null
        return sema_bool_kind(sm, e.args)
    BK_UNSURE

# The binding of match arm `arm` over `scrut`, just bound: `Some(v)` binds the
# payload, a catch-all name the scrutinee.  A struct payload's name goes on
# the binding (Sema binds it untyped) so `v.f` finds the field.
pub fn bool_note_arm(sm: *Sema, arm: *MatchArm, scrut: *Expr)
    let v: *SemaVar = sbk_last(sm)
    if v == null or scrut == null
        return
    var name: *u8 = null
    var len: i32 = 0
    sbk_receiver(sm, scrut, @name, @len)
    if arm.pattern_kind == PAT_IDENT
        if name == null or len <= 0
            v.bk = sbk_binding(sema_bool_kind(sm, scrut))
        return
    if name == null or len <= 0
        v.bk = BK_UNSURE
    else if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        let is_err: i32 = 1 - sbk_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
        v.bk = sbk_tagged_binding(StrView { ptr: (name), len: (len) as i64 }, is_err)
        # A float payload binds a float local, a struct payload a struct one.
        sbk_payload_struct(sm, v, StrView { ptr: (name), len: (len) as i64 }, is_err)
        # AGAST #4265: one sema_arm_payload_ty typed (a struct, a user enum
        # such as fs's Errno) is what its type says, as the emitter has it.
        if v.bk == BK_UNSURE and v.kind != TYPE_UNKNOWN
            v.bk = sbk_of_ty(v.kind, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    else if user_enum_index(StrView { ptr: (name), len: (len) as i64 }) >= 0
        let uf: *StructField = user_enum_tuple_field(StrView { ptr: (name), len: (len) as i64 }, arm_variant_sel(StrView { ptr: (name), len: (len) as i64 }, arm))
        if uf == null
            v.bk = BK_UNSURE
        else
            let k: i32 = bk_of_type(uf.field_type, StrView { ptr: (uf.field_type_name), len: (uf.field_type_name_len) as i64 })
            if k == BK_FLOAT or k == BK_OTHER
                v.bk = k
            else
                v.bk = sbk_binding(k)
            if uf.field_type == TYPE_STRUCT and v.kind == TYPE_UNKNOWN
                v.type_name = uf.field_type_name
                v.type_name_len = uf.field_type_name_len

# The struct an `Option$S` / `Result$S$E` carries in Some / Ok, or null
# (tagged_enum_payload_struct): an Option's whole suffix, a Result's shortest
# `$`-prefix naming a concrete struct (`Result$Vec$E$i32` -> `Vec$E`).
fn sbk_ok_struct(sm: *Sema, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_len = 0
    var dollar: i32 = 0
    while dollar < len and *(name + dollar) != '$'
        dollar += 1
    let sfx: *u8 = name + dollar + 1
    let sfx_len: i32 = len - dollar - 1
    if sfx_len <= 0
        return null
    if name_eq(StrView { ptr: (name), len: (dollar) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        let st: *StructDef = sema_find_struct(sm, StrView { ptr: (sfx), len: (sfx_len) as i64 })
        if st == null
            return null
        *out_len = sfx_len
        return sfx
    var end: i32 = 0
    while end < sfx_len
        end += 1
        while end < sfx_len and *(sfx + end) != '$'
            end += 1
        let pst: *StructDef = sema_find_struct(sm, StrView { ptr: (sfx), len: (end) as i64 })
        if pst != null and pst.type_params == null
            *out_len = end
            return sfx
    null

# The struct a mangled `Option$S` / `Result$S$E` carries, by name, onto `v`.
fn sbk_payload_struct(sm: *Sema, v: *SemaVar, name_sv: StrView, is_err: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'
        i += 1
    i += 1
    var end: i32 = i
    while end < len and *(name + end) != '$'
        end += 1
    if is_err == 1
        i = end + 1
        end = len
    if i >= len or v.kind != TYPE_UNKNOWN
        return
    if name_eq(StrView { ptr: (name + i), len: (end - i) as i64 }, StrView { ptr: (c"f32"), len: (3) as i64 }) == 1 or name_eq(StrView { ptr: (name + i), len: (end - i) as i64 }, StrView { ptr: (c"f64"), len: (3) as i64 }) == 1
        v.bk = BK_FLOAT
        return
    if is_err == 0
        var ok_len: i32 = 0
        let ok: *u8 = sbk_ok_struct(sm, StrView { ptr: (name), len: (len) as i64 }, @ok_len)
        if ok != null
            v.bk = BK_OTHER
            v.type_name = ok
            v.type_name_len = ok_len
        return
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (name + i), len: (end - i) as i64 })
    if st != null
        v.bk = BK_OTHER
        v.type_name = st.name
        v.type_name_len = st.name_len

# 1 for `Some` and `Ok`, the carrier variants.
fn sbk_tag_one(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1
        return 1
    0

# --- Reports -------------------------------------------------------------------

# `path:line:col: error: ` for the place, the first time it is reported: the
# same place can be judged twice (an `if` that is a tail, an `assert` operand).
fn bool_sema_report_span(sm: *Sema, line: i32, col: i32) -> i32
    if sm.bool_err_line == line and sm.bool_err_col == col
        return 0
    sm.bool_err_line = line
    sm.bool_err_col = col
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm), diag_span(line, col))
    1

pub fn bool_sema_report_at(sm: *Sema, e: *Expr) -> i32
    bool_sema_report_span(sm, e.span.line, e.span.col)

# `line:1: error: ` for the place, the first time it is reported: an arm's
# Block, whose span ritz0 reports as its first line, column 1 (AGAST #4439).
pub fn bool_sema_report_line(sm: *Sema, line: i32) -> i32
    bool_sema_report_span(sm, line, 1)

# `line:col: error: ` for the place, the first time it is reported: an `if`
# expression's own span, which ritz0 reports whole (AGAST #4441).
pub fn bool_sema_report_pos(sm: *Sema, line: i32, col: i32) -> i32
    bool_sema_report_span(sm, line, col)

fn bool_require(sm: *Sema, e: *Expr, what: *u8, op: *u8)
    let k: i32 = sema_bool_kind(sm, e)
    if k == BK_BOOL or k == BK_BAD
        return
    # A call to a fn that returns nothing is the procedure check's to report
    # ("`g` returns nothing, so its call has no value"), on the emitter.
    if k == BK_UNSURE and sbk_is_procedure_call(sm, e) == 1
        return
    # So is a method an Option/Result doesn't have (`o.expect("x")`, `o.frob()`):
    # refuse_no_method's "no method `m` on `T`", at the method (AGAST #4263).
    if k == BK_UNSURE and sbk_is_unknown_carrier_method(sm, e) == 1
        return
    if bool_sema_report_at(sm, e) == 0
        return
    eprints_cstr(what)
    if op != null
        eprints_cstr(op)
        eprints_cstr(c"`")
    if k == BK_UNSURE
        eprints_cstr(c" must be bool, and ritz1 cannot tell that it is\n")
        return
    eprints_cstr(c" must be bool, got ")
    eprints_cstr(bk_words(k))
    bk_write(k)
    eprints_cstr(c"\n")

# 1 when `e` is `o.m(...)` on an `Option$`/`Result$` receiver with no fn for
# `m`, and `m` none of the carrier's builtins (unwrap, unwrap_or, is_some...).
fn sbk_is_unknown_carrier_method(sm: *Sema, e: *Expr) -> i32
    if e.kind != EXPR_METHOD or sbk_is_unwrap(e) == 1
        return 0
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_some"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_none"), len: (7) as i64 }) == 1
        return 0
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_ok"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_err"), len: (6) as i64 }) == 1
        return 0
    var tn_len: i32 = 0
    let tn: *u8 = sbk_method_recv(sm, e, @tn_len)
    if tn == null or tn_len < 7
        return 0
    if name_eq(StrView { ptr: (tn), len: (7) as i64 }, StrView { ptr: (c"Option$"), len: (7) as i64 }) == 0 and name_eq(StrView { ptr: (tn), len: (7) as i64 }, StrView { ptr: (c"Result$"), len: (7) as i64 }) == 0
        return 0
    if sema_method_fn(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return 0
    1

fn sbk_is_procedure_call(sm: *Sema, e: *Expr) -> i32
    var fd: *FnDef = null
    if e.kind == EXPR_CALL and e.func_name_len > 0 and sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == null
        fd = sema_call_fn(sm, e)
    else if e.kind == EXPR_METHOD
        fd = sbk_method_def(sm, e)
    (fd != null and fd.return_type == TYPE_VOID) as i32

# `what` is `if condition`, `while condition` or `assert condition`.
pub fn bool_check_cond(sm: *Sema, e: *Expr, what: *u8)
    bool_require(sm, e, what, null)

fn bool_reject_operand(sm: *Sema, e: *Expr, op: *u8, wanted: *u8, bitwise: i32)
    if bool_sema_report_at(sm, e) == 0
        return
    eprints_cstr(c"operand of `")
    eprints_cstr(op)
    eprints_cstr(c"` must be ")
    eprints_cstr(wanted)
    eprints_cstr(c", got bool")
    if bitwise == 1 and is_comparison(e) == 1
        eprints_cstr(c": `x & 1 == 1` is `x & (1 == 1)`: parenthesise `(x & 1) == 1`")
    eprints_cstr(c"\n")

# Every binary operator, before its operands.
pub fn bool_check_binary(sm: *Sema, e: *Expr)
    if e.op == OP_AND or e.op == OP_OR
        bool_require(sm, e.left, c"operand of `", bool_op_name(e.op))
        bool_require(sm, e.right, c"operand of `", bool_op_name(e.op))
        return
    let l: i32 = sema_bool_kind(sm, e.left)
    let r: i32 = sema_bool_kind(sm, e.right)
    if l != BK_BOOL and r != BK_BOOL
        return
    if l == BK_BAD or r == BK_BAD
        return
    if e.op >= OP_EQ and e.op <= OP_GE
        var other: i32 = l
        if l == BK_BOOL
            other = r
        if other != BK_BOOL and other != BK_UNSURE and bool_sema_report_at(sm, e) == 1
            eprints_cstr(c"cannot compare bool with ")
            eprints_cstr(bk_words(other))
            eprints_cstr(c"\n")
        return
    var bad: *Expr = e.right
    if l == BK_BOOL
        bad = e.left
    if e.op >= OP_BIT_AND and e.op <= OP_SHR
        bool_reject_operand(sm, bad, bool_op_name(e.op), c"an integer", 1)
    else
        bool_reject_operand(sm, bad, bool_op_name(e.op), c"a number", 0)

# `not`, `-` and `~`.
pub fn bool_check_unary(sm: *Sema, e: *Expr)
    if e.op == OP_NOT
        bool_require(sm, e.operand, c"operand of `", c"not")
    else if e.op == OP_NEG and sema_bool_kind(sm, e.operand) == BK_BOOL
        bool_reject_operand(sm, e.operand, c"-", c"a number", 0)
    else if e.op == OP_BIT_NOT and sema_bool_kind(sm, e.operand) == BK_BOOL
        bool_reject_operand(sm, e.operand, c"~", c"an integer", 1)

# A value of kind `v` lands in a slot of kind `slot`, at line:col.  Silent when
# either side is unsure.
fn bool_check_kinds(sm: *Sema, v: i32, slot: i32, line: i32, col: i32)
    if slot == BK_UNSURE or slot == BK_OTHER or slot == BK_BAD
        return
    if v == BK_UNSURE or v == BK_OTHER or v == BK_BAD or v == slot
        return
    if v != BK_BOOL and slot != BK_BOOL
        return
    if bool_sema_report_span(sm, line, col) == 0
        return
    if v == BK_BOOL
        eprints_cstr(c"cannot use bool as ")
        eprints_cstr(bk_words(slot))
        if slot == BK_INT
            eprints_cstr(c": write `b as i32`")
    else
        eprints_cstr(c"cannot use ")
        eprints_cstr(bk_words(v))
        eprints_cstr(c" as bool")
        bk_write(v)
    eprints_cstr(c"\n")

pub fn bool_check_slot_kind(sm: *Sema, e: *Expr, slot: i32)
    if e != null
        bool_check_kinds(sm, sema_bool_kind(sm, e), slot, e.span.line, e.span.col)

pub fn bool_check_slot(sm: *Sema, e: *Expr, t: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    bool_check_slot_kind(sm, e, bk_of_type(t, StrView { ptr: (name), len: (name_len) as i64 }))

# `a[i]`: a bool would widen to a perfectly good GEP.
pub fn bool_check_index(sm: *Sema, e: *Expr)
    bool_check_slot_kind(sm, e, BK_INT)

# The arms of an `if` or `match` value agree with the first one that has a value.
pub fn bool_check_arms(sm: *Sema, arms: *MatchArm)
    let first: i32 = sbk_arms(sm, arms)
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            bool_check_slot_kind(sm, arm.body, first)
        arm = arm.next

# `x as T`, with T's kind in `e.op`.
pub fn bool_check_cast(sm: *Sema, e: *Expr)
    let target: i32 = bk_of_type(e.op, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if target == BK_BOOL
        if bool_sema_report_at(sm, e) == 1
            eprints_cstr(c"`as bool` is removed: write `x != 0`\n")
        return
    if (target == BK_FLOAT or target == BK_PTR) and sema_bool_kind(sm, e.left) == BK_BOOL
        if bool_sema_report_at(sm, e) == 1
            eprints_cstr(c"cannot cast bool to ")
            eprints_cstr(bk_words(target))
            eprints_cstr(c"\n")

fn bool_check_args(sm: *Sema, params: *Param, args: *Expr)
    var p: *Param = params
    var a: *Expr = args
    while p != null and a != null
        # A `:&` param borrows a place: whether it fits is the borrow's to say
        # (place_fits_borrow), in ritz0's words.  Its slot isn't the pointer a
        # place of `bool` would otherwise be checked against (AGAST #2994).
        if p.is_borrow != 1
            bool_check_slot(sm, a, p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        p = p.next
        a = a.next

pub fn bool_check_call(sm: *Sema, e: *Expr)
    if e.func_name_len == 0
        return
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if v != null
        if v.fn_sig != null
            bool_check_args(sm, v.fn_sig.params, e.args)
        return
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd != null
        bool_check_args(sm, fd.params, e.args)

pub fn bool_check_method(sm: *Sema, e: *Expr)
    var tn_len: i32 = 0
    let tn: *u8 = sbk_method_recv(sm, e, @tn_len)
    if tn == null
        return
    let fd: *FnDef = sema_method_fn(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if fd == null or fd.params == null
        return
    # `self` is the receiver, not the first argument (AGAST #2942).
    if name_eq(StrView { ptr: (fd.params.name), len: (fd.params.name_len) as i64 }, StrView { ptr: (c"self"), len: (4) as i64 }) == 1
        bool_check_args(sm, fd.params.next, e.args)
    else
        bool_check_args(sm, fd.params, e.args)

# `S { f: v, .. }`: each value lands in its field.
pub fn bool_check_struct_lit(sm: *Sema, e: *Expr)
    sbk_note_tuple_lit(sm, e)
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if st == null
        return
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let idx: i32 = find_field_index(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
        if idx >= 0
            let f: *StructField = get_field_type(st, idx)
            bool_check_slot(sm, fi.value, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        fi = fi.next

# Every expression, before its sub-expressions: the operators, casts, indexes
# and calls, a struct literal's fields, and an `if` / `match` value's arms.
# Thrown away or not, the arms agree, as on ritz0: a valueless arm (a call to a
# fn returning nothing, #2046) is unsure, so bool_check_kinds lets it be (#3774).
pub fn bool_check_expr(sm: *Sema, e: *Expr)
    let k: i32 = e.kind
    if k == EXPR_BINARY
        bool_check_binary(sm, e)
    else if k == EXPR_UNARY
        bool_check_unary(sm, e)
    else if k == EXPR_CAST
        bool_check_cast(sm, e)
    else if k == EXPR_INDEX
        if e.right != null and e.right.kind != EXPR_RANGE
            bool_check_index(sm, e.right)
    else if k == EXPR_CALL
        bool_check_call(sm, e)
    else if k == EXPR_METHOD
        bool_check_method(sm, e)
    else if k == EXPR_STRUCT_LIT
        bool_check_struct_lit(sm, e)
    else if k == EXPR_IF
        let then_arm: *MatchArm = e.args as *MatchArm
        bool_check_cond(sm, e.left, c"if condition")
        bool_check_arms(sm, then_arm)
    else if k == EXPR_MATCH
        bool_check_arms(sm, e.args as *MatchArm)

# `target = value`, in each spelling the parser has for one.
pub fn bool_check_stmt(sm: *Sema, stmt: *Stmt)
    if stmt.kind == STMT_ASSIGN
        if stmt.assign_target_len != 0
            bool_check_slot_kind(sm, stmt.assign_value, sbk_name(sm, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }))
            return
        let target: *Expr = stmt.if_cond as *Expr
        if target.kind == EXPR_INDEX and target.right != null and target.right.kind != EXPR_RANGE
            bool_check_index(sm, target.right)
        bool_check_slot_kind(sm, stmt.assign_value, sema_bool_kind(sm, target))
    else if stmt.kind == STMT_INDEX_ASSIGN
        bool_check_index(sm, stmt.while_cond)
        bool_check_slot_kind(sm, stmt.assign_value, sbk_element(sm, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }))
    else if stmt.kind == STMT_LOCAL_FIELD_ASSIGN or stmt.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
        if v == null
            return
        let st: *StructDef = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
        if st == null
            return
        let idx: i32 = find_field_index(st, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        if idx < 0
            return
        let f: *StructField = get_field_type(st, idx)
        if stmt.kind == STMT_LOCAL_FIELD_ASSIGN
            bool_check_slot(sm, stmt.assign_value, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        else if f.field_type == TYPE_ARRAY
            bool_check_index(sm, stmt.while_cond)
            bool_check_slot(sm, stmt.assign_value, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })

# `let a: [N]T = [..]`: each element lands in a T.
pub fn bool_check_array_lit(sm: *Sema, e: *Expr, elem: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if e == null or e.kind != EXPR_ARRAY_LIT
        return
    var el: *Expr = e.args
    while el != null
        bool_check_slot(sm, el, elem, StrView { ptr: (name), len: (name_len) as i64 })
        el = el.next

# The rows of an N-D `[N][M]T` initialiser, depth `d` of `sh`: each leaf row's
# elements land in a T.
fn bool_check_nd_rows(sm: *Sema, sh: *ArrayShape, d: i32, e: *Expr)
    if e == null or e.kind != EXPR_ARRAY_LIT
        return
    if d == sh.rank - 1
        bool_check_array_lit(sm, e, sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        return
    var row: *Expr = e.args
    while row != null
        bool_check_nd_rows(sm, sh, d + 1, row)
        row = row.next

# A `let` / `var` with a declared type: its initialiser lands in it.
pub fn bool_check_decl(sm: *Sema, st: *Stmt)
    if st.var_init == null or st.var_declared_type == TYPE_VOID
        return
    bool_check_slot(sm, st.var_init, st.var_declared_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
    bool_check_array_lit(sm, st.var_init, st.var_array_elem_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
    if st.var_array_shape != null
        bool_check_nd_rows(sm, st.var_array_shape, 0, st.var_init)

# `return v` in the fn being walked.
pub fn bool_check_return(sm: *Sema, v: *Expr)
    let f: *FnDef = sm.cur_fn
    if v != null and f != null
        bool_check_slot(sm, v, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })

# The value a block ends in.  It isn't walked yet, so its own `let`s aren't in
# scope: a tail naming one is read off the declaration.
fn sbk_block(sm: *Sema, stmts: *Stmt) -> i32
    var last: *Stmt = stmts
    if last == null
        return BK_UNSURE
    while last.next != null
        last = last.next
    if last.kind == STMT_IF
        return sbk_if_stmt(sm, last)
    if last.kind == STMT_MATCH
        return sbk_arms(sm, last.if_then as *MatchArm)
    if last.kind != STMT_EXPR
        return BK_UNSURE
    let e: *Expr = last.expr
    if e.kind == EXPR_IDENT
        var st: *Stmt = stmts
        while st != last
            if st.kind == STMT_VAR_DECL and name_eq(StrView { ptr: (st.var_name), len: (st.var_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                if st.var_declared_type != TYPE_VOID
                    return bk_of_type(st.var_declared_type, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
                return sema_bool_kind(sm, st.var_init)
            st = st.next
    sema_bool_kind(sm, e)

fn sbk_if_stmt(sm: *Sema, stmt: *Stmt) -> i32
    let k: i32 = sbk_block(sm, stmt.if_then)
    if k != BK_UNSURE
        return k
    sbk_block(sm, stmt.if_else)

# The last statement of the fn being walked: an `if` or `match` there is its
# value, reported at the statement, as ritz0's phi is; a plain expression
# lands in the return type (not a struct's: the emitter returns those whole).
pub fn bool_check_tail(sm: *Sema, stmt: *Stmt)
    let f: *FnDef = sm.cur_fn
    if f == null
        return
    let slot: i32 = bk_of_type(f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    if slot == BK_UNSURE
        return
    if stmt.kind == STMT_EXPR
        if f.return_type != TYPE_STRUCT
            bool_check_slot_kind(sm, stmt.expr, slot)
    else if stmt.kind == STMT_IF and stmt.if_else != null
        # The arms agree first, as the phi's do, then the value meets the slot.
        var tail: *Stmt = stmt.if_else
        while tail.next != null
            tail = tail.next
        if tail.kind == STMT_EXPR
            bool_check_kinds(sm, sbk_block(sm, stmt.if_else), sbk_block(sm, stmt.if_then), tail.expr.span.line, tail.expr.span.col)
        bool_check_kinds(sm, sbk_if_stmt(sm, stmt), slot, stmt.span.line, stmt.span.col)
    else if stmt.kind == STMT_MATCH
        let arms: *MatchArm = stmt.if_then as *MatchArm
        bool_check_arms(sm, arms)
        bool_check_kinds(sm, sbk_arms(sm, arms), slot, stmt.span.line, stmt.span.col)

# Module level: a `const x: bool` and a global's initialiser.
pub fn bool_check_globals(sm: *Sema)
    var c: *ConstEntry = sm.module.constants
    while c != null
        if c.const_type == TYPE_BOOL
            bool_check_slot(sm, c.value_expr, TYPE_BOOL, StrView { ptr: (null), len: (0) as i64 })
        c = c.next
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if g.is_extern == 0
            bool_check_slot(sm, g.init_expr, g.var_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        g = g.next
