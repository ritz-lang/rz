# ritz1/src/sema_probe.ritz - pin Sema's typer against the emitter's (AGAST #3501)
#
# A test-only probe, off unless RITZ1_SEMA_PROBE is set (main turns it on).
# The Sema walk records sema_expr_ty for every expression it visits, in that
# expression's scope; emit_expr then compares the record with what the
# emitter computes for the same node in its own scope.  The checks moving off
# the emitter (#3502-#3514) stay byte-identical only where the two agree.
#
# The rules, where Sema's answer is known:
#   type: Sema's kind is synth_slot_ty's.  Not for a bool: synth_slot_ty
#         gives a bool's i64 slot (#1646) or a comparison's left operand.
#         Lenient where synth_slot_ty says TypeKind.I64 and Sema an integer type
#         (its default, and a const's folded immediate: `O_RDONLY`,
#         `(p as *S).x`), but never for a local's name, or Sema says a call through a local's `fn(..) -> T`
#         (synth_slot_ty reads no local fn_sig), or a `@S` / `@&S` field
#         that emit_module's lower_ref_fields rewrote to the `*S` the
#         emitter sees (Sema runs first).  bool_kind gets those right;
#         a move that reads widths tightens this rule first.
#   bool: bk_of_type of Sema's type is bool_kind's, where bool_kind is sure.
#   bk:   sema_bool_kind, which bool_check judges with on Sema (#3502), is
#         bool_kind's wherever both are sure.  Where only one is, it is a
#         `bk-gap`, printed as `sema-probe: bk-gap at ...`: a bool report
#         there would read differently, or not at all, than the emitter's
#         did.  ritz0/test_ritz1_sema_type.py holds their count to a ceiling.
#   A struct literal is lenient: synth_slot_ty calls it an i64.  So is a
#   struct or pointer Sema types on `*p`, `a[i]` or `x.m()` (a receiver's
#   shapes, AGAST #3810), `c?` (its Ok / Some struct, #3974) or a unit
#   variant `E.V` (#4251), where synth_slot_ty falls to its i64 default; the
#   bool rule, which bool_kind answers from that default, is skipped there.
# A broken rule prints `sema-probe: mismatch ...` on stderr.  After emission
# main prints `sema-probe: <c> compared, <m> mismatched, <l> lenient, <u>
# unknown, <g> bool-gap`: <g> of the <u> are expressions bool_kind types and
# Sema doesn't yet, what bool_check's move (#3502) must close or keep
# BK_UNSURE for.  ritz0/test_ritz1_sema_type.py runs the matrix corpus with
# it on and requires no mismatch.
#
# This module is Sema's side and imports no emitter module (AGAST #3513): the
# emitter's answers come in through sema_probe_expr's SemaProbeEmitter, which
# emitter_expr fills with bool_kind, synth_slot_ty (the emit-time typer for
# nodes Sema never walked) and the current fn's file.

import ritzlib.sys
import ritzlib.io
import ritzlib.hashmap

import ast
import ast_helpers
import ast_query    # TypeKind.Unknown (AGAST #3513)
import sema
import sema_type
import bool_check
import ritzlib.memory

var g_sema_probe_on: i32 = 0
var g_sema_probe_map: *HashMapI64 = null
var g_sema_probe_local_calls: *HashMapI64 = null
var g_sema_probe_local_names: *HashMapI64 = null
var g_sema_probe_compared: i64 = 0
var g_sema_probe_mismatched: i64 = 0
var g_sema_probe_unknown: i64 = 0
var g_sema_probe_lenient: i64 = 0
var g_sema_probe_bool_gap: i64 = 0
var g_sema_probe_bk_gap: i64 = 0
var g_sema_probe_slot_compared: i64 = 0
var g_sema_probe_slot_mismatched: i64 = 0
var g_sema_probe_slot_lenient: i64 = 0
var g_sema_probe_bk: *HashMapI64 = null        # e -> sema_bool_kind + 100

# The emitter's view of an expression, for sema_probe_expr (AGAST #3513):
# `s` is the *EmitterState, opaque here, that each fn is called with.
pub struct SemaProbeEmitter
    s: *u8
    bool_kind: fn(*u8, *Expr) -> i32
    slot_type: fn(*u8, *Expr) -> TypeKind
    source_file: fn() -> *u8

# `dump` is 1 for RITZ1_SEMA_PROBE=dump: each record is also printed,
# `sema-type: <line>:<col> e<expr kind> <type kind>[ <name>]`, so a test can
# pin Sema's answer for one expression.
pub fn sema_probe_enable(dump: i32)
    g_sema_probe_on = 1 + dump
    g_sema_probe_map = malloc(sizeof(HashMapI64)) as *HashMapI64
    *g_sema_probe_map = hashmap_i64_with_cap(65536)
    g_sema_probe_local_calls = malloc(sizeof(HashMapI64)) as *HashMapI64
    *g_sema_probe_local_calls = hashmap_i64_with_cap(256)
    g_sema_probe_local_names = malloc(sizeof(HashMapI64)) as *HashMapI64
    *g_sema_probe_local_names = hashmap_i64_with_cap(65536)
    g_sema_probe_bk = malloc(sizeof(HashMapI64)) as *HashMapI64
    *g_sema_probe_bk = hashmap_i64_with_cap(65536)

pub fn sema_probe_on() -> i32
    g_sema_probe_on

# Sema's answer for `e`, in the scope the walk has now.
pub fn sema_probe_record(sm: *Sema, e: *Expr)
    if g_sema_probe_on == 0 or e == null
        return
    let t: *SemaTy = malloc(sizeof(SemaTy)) as *SemaTy
    sema_expr_ty(sm, e, t)
    (*g_sema_probe_map).insert(e as i64, t as i64)
    (*g_sema_probe_bk).insert(e as i64, sema_bool_kind(sm, e) as i64 + 100)
    if g_sema_probe_on == 2
        sema_probe_dump(e, t)
    if e.kind == ExprKind.Call and e.func_name_len > 0 and sema_is_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1
        (*g_sema_probe_local_calls).insert(e as i64, 1)
    if e.kind == ExprKind.Ident and sema_is_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
        (*g_sema_probe_local_names).insert(e as i64, 1)

fn sema_probe_dump(e: *Expr, t: *SemaTy)
    eprints_cstr(c"sema-type: ")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c" e")
    eprint_int(e.kind as i64)
    eprints_cstr(c" ")
    eprint_int(t.kind as i64)
    if t.name != null and t.name_len > 0
        eprints_cstr(c" ")
        var i: i32 = 0
        while i < t.name_len
            eprint_char(*(t.name + i))
            i += 1
    eprints_cstr(c"\n")
    # AGAST #4404: the slot type Sema annotated on the node, which the
    # emitter's synth_slot_ty now reads for the node-local arms.  Printed
    # only where Sema has one; other kinds still fall to its own typer.
    if expr_has_sema_ty(e) == 1
        let slot: TypeKind = expr_sema_ty(e)
        if slot != TypeKind.Unknown
            eprints_cstr(c"sema-slot: ")
            eprint_int(e.span.line as i64)
            eprints_cstr(c":")
            eprint_int(e.span.col as i64)
            eprints_cstr(c" e")
            eprint_int(e.kind as i64)
            eprints_cstr(c" ")
            eprint_int(slot as i64)
            eprints_cstr(c"\n")

fn sema_probe_mismatch(em: *SemaProbeEmitter, e: *Expr, rule: *u8, sema_k: i32, emit_k: i32)
    g_sema_probe_mismatched = g_sema_probe_mismatched + 1
    eprints_cstr(c"sema-probe: mismatch ")
    sema_probe_note(em, e, rule, sema_k, emit_k)

# `<rule> at <file>:<line>:<col> expr kind <k>: sema <s>, emitter <e>`.
fn sema_probe_note(em: *SemaProbeEmitter, e: *Expr, rule: *u8, sema_k: i32, emit_k: i32)
    eprints_cstr(rule)
    eprints_cstr(c" at ")
    let source_file: fn() -> *u8 = em.source_file
    eprints_cstr(source_file())
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c" expr kind ")
    eprint_int(e.kind as i64)
    eprints_cstr(c": sema ")
    eprint_int(sema_k as i64)
    eprints_cstr(c", emitter ")
    eprint_int(emit_k as i64)
    eprints_cstr(c"\n")

# True for a call through a local `fn(..) -> T` (Sema typed it off the local's
# signature).  g_sema_probe_local_calls holds the ones the walk saw.
fn sema_probe_local_call(e: *Expr) -> bool
    if e.kind != ExprKind.Call
        return false
    (*g_sema_probe_local_calls).contains(e as i64)

# True for `*p`, `a[i]`, `x.m()` or `c?` that Sema types a struct or a
# pointer, or a user enum's unit variant `E.V` it types as E: synth_slot_ty's
# i64 there is its default, not a type (AGAST #3810, #3974, #4251; the
# emitter lowers `E.V` to its `%E` aggregate, #1660).
fn sema_probe_aggregate_default(ctx: *ParseCtx, e: *Expr, k: TypeKind) -> bool
    if k != TypeKind.Struct and k != TypeKind.Ptr and k != TypeKind.Ref and k != TypeKind.MutRef
        return false
    match e.kind
        ExprKind.Unary =>
            return e.op == OpKind.Deref
        ExprKind.Member =>
            let l: *Expr = e.left
            if k != TypeKind.Struct or l == null or l.kind != ExprKind.Ident
                return false
            let is_local: bool = (*g_sema_probe_local_names).contains(l as i64)
            if is_local
                return false
            return user_enum_index(ctx, StrView { ptr: (l.ident_ptr), len: (l.ident_len) as i64 }) >= 0 and enum_variant_index(ctx, StrView { ptr: (l.ident_ptr), len: (l.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
        _ => pass
    e.kind == ExprKind.Index or e.kind == ExprKind.Method or e.kind == ExprKind.Try

# emit_expr, on entry: compare the record for `e` with the emitter's view.
pub fn sema_probe_expr(ctx: *ParseCtx, em: *SemaProbeEmitter, e: *Expr)
    let bk_of: fn(*u8, *Expr) -> i32 = em.bool_kind
    let type_of: fn(*u8, *Expr) -> TypeKind = em.slot_type
    let s: *u8 = em.s
    let t: *SemaTy = (*g_sema_probe_map).get(e as i64) as *SemaTy
    if t == null
        return
    # AGAST #4410: the slot the emitter reads is the one Sema annotated
    # (expr_slot_ty).  Compare it with synth_slot_ty for every expression the
    # walk reached; the state-dependent arms must already agree before any
    # call site is converted.  Printed as `slot`, never as a `type` mismatch.
    if expr_has_sema_ty(e) == 1
        g_sema_probe_slot_compared = g_sema_probe_slot_compared + 1
        let ss: TypeKind = expr_sema_ty(e)
        let ek: TypeKind = type_of(s, e)
        if ss != ek
            # Where Sema's own typer left the source unknown, the slot's i64
            # is its default, not a disagreement about the emitter's rule
            # (an untyped `let = match`, a tuple payload the checks type).
            # A `@S` / `@&S` field is rewritten to the `*S` the emitter sees
            # after the walk (the same leniency the `type` rule takes).
            let len_unknown: i32 = (t.kind == TypeKind.Unknown) as i32
            let ref_field: i32 = (e.kind == ExprKind.Member and ek == TypeKind.Ptr and (ss == TypeKind.Ref or ss == TypeKind.MutRef)) as i32
            if len_unknown == 1 or ref_field == 1
                g_sema_probe_slot_lenient = g_sema_probe_slot_lenient + 1
            else
                g_sema_probe_slot_mismatched = g_sema_probe_slot_mismatched + 1
                sema_probe_note(em, e, c"slot", (ss as i32), (ek as i32))
    let sbk: i32 = ((*g_sema_probe_bk).get(e as i64) - 100) as i32
    let ebk: i32 = bk_of(s, e)
    if sbk != ebk
        if sbk != BK_UNSURE and ebk != BK_UNSURE
            sema_probe_mismatch(em, e, c"bk", sbk, ebk)
            return
        g_sema_probe_bk_gap = g_sema_probe_bk_gap + 1
        eprints_cstr(c"sema-probe: ")
        sema_probe_note(em, e, c"bk-gap", sbk, ebk)
    if t.kind == TypeKind.Unknown
        g_sema_probe_unknown = g_sema_probe_unknown + 1
        let gk: i32 = bk_of(s, e)
        if gk != BK_UNSURE and gk != BK_BAD
            g_sema_probe_bool_gap = g_sema_probe_bool_gap + 1
        return
    g_sema_probe_compared = g_sema_probe_compared + 1
    if t.kind != TypeKind.Bool
        let ek: TypeKind = type_of(s, e)
        if ek != t.kind
            var int_default: i32 = 0
            if sema_is_int_kind(t.kind) == 1
                let is_local: bool = (*g_sema_probe_local_names).contains(e as i64)
                if not is_local
                    int_default = 1
            let ref_field: i32 = (e.kind == ExprKind.Member and ek == TypeKind.Ptr and (t.kind == TypeKind.Ref or t.kind == TypeKind.MutRef)) as i32
            let struct_lit: i32 = (e.kind == ExprKind.StructLit and ek == TypeKind.I64) as i32
            let aggregate: i32 = (ek == TypeKind.I64 and sema_probe_aggregate_default(ctx, e, t.kind)) as i32
            if ref_field == 1 or struct_lit == 1 or aggregate == 1 or (ek == TypeKind.I64 and (int_default == 1 or sema_probe_local_call(e)))
                g_sema_probe_lenient = g_sema_probe_lenient + 1
                if aggregate == 1
                    return   # bool_kind reads the same default (an int)
            else
                sema_probe_mismatch(em, e, c"type", (t.kind as i32), (ek as i32))
                return
    let bk: i32 = bk_of(s, e)
    if bk != BK_UNSURE and bk != BK_BAD
        let sk: i32 = bk_of_type(t.kind, StrView { ptr: (t.name), len: (t.name_len) as i64 })
        if sk != bk
            sema_probe_mismatch(em, e, c"bool", sk, bk)

pub fn sema_probe_report()
    if g_sema_probe_on == 0
        return
    eprints_cstr(c"sema-probe: ")
    eprint_int(g_sema_probe_compared)
    eprints_cstr(c" compared, ")
    eprint_int(g_sema_probe_mismatched)
    eprints_cstr(c" mismatched, ")
    eprint_int(g_sema_probe_lenient)
    eprints_cstr(c" lenient, ")
    eprint_int(g_sema_probe_unknown)
    eprints_cstr(c" unknown, ")
    eprint_int(g_sema_probe_bool_gap)
    eprints_cstr(c" bool-gap, ")
    eprint_int(g_sema_probe_bk_gap)
    eprints_cstr(c" bk-gap\n")
    eprints_cstr(c"sema-probe-slot: ")
    eprint_int(g_sema_probe_slot_compared)
    eprints_cstr(c" compared, ")
    eprint_int(g_sema_probe_slot_mismatched)
    eprints_cstr(c" mismatched, ")
    eprint_int(g_sema_probe_slot_lenient)
    eprints_cstr(c" lenient\n")
