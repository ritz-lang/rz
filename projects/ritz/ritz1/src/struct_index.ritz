# struct_index.ritz - indexing a struct through `Index`, `IndexMut` and
# `IndexSet` (LANGUAGE_SPEC §7.8, LARB ruling R15, AGAST #1635).
#
# A struct opts into `[]` by implementing up to three compiler-known traits,
# resolved statically by name like `Drop`.  monomorph.ritz rewrites each use of
# `m[k]` on such a struct into the method it means:
#
#   a read, `.f`                 *m.index(k)
#   `@m[k]`                      m.index(k)
#   `@&m[k]`, `m[k].f = x`       m.index_mut(k) / *m.index_mut(k)
#   `m[k] = v`                   m.index_set(k, v), else *m.index_mut(k) = v
#   `m[k] op= x`                 *C = *C op x, C = m.index_mut(k), called once
#
# This module holds what monomorph and the emitter share: which traits a type
# implements, the located refusals (ritz0 prints the same words, from
# ritz0/index_rules.py), and the calls that must be evaluated once.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str

import ast
import diag          # the error prefix (AGAST #3445)

# Which traits a type implements, as a mask.
const SI_INDEX: i32 = 1
const SI_INDEX_MUT: i32 = 2
const SI_INDEX_SET: i32 = 4

# How `m[k]` is used, which decides the trait it needs.
const SI_USE_READ: i32 = 0         # a read, `.f`, `@m[k]`: Index
const SI_USE_ASSIGN: i32 = 1       # `m[k] = v`: IndexSet or IndexMut
const SI_USE_ADDR_MUT: i32 = 2     # `@&m[k]`: IndexMut
const SI_USE_COMPOUND: i32 = 3     # `m[k] op= x`: IndexMut
const SI_USE_FIELD_STORE: i32 = 4  # `m[k].f = x`: IndexMut

var g_si_errors: i32 = 0
var g_si_file: *u8 = null

pub fn struct_index_set_file(path: *u8)
    g_si_file = path

# The main file's path (AGAST #3330: monomorph's errors are located in it).
pub fn struct_index_file() -> *u8
    g_si_file

pub fn struct_index_errors() -> i32
    g_si_errors

fn si_name_eq(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var a_len: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var b_len: i32 = b_sv.len as i32
    if a_len != b_len
        return 0
    if a_len == 0
        return 1
    if memcmp(a, b, a_len as i64) == 0
        return 1
    0

# The length of `name` up to its first `$`: `Pair` of `Pair$i64`.
fn si_head_len(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'
        i += 1
    i

# The traits `type_name` implements.  A monomorphised `Pair$i64` takes them
# from the generic impls of `Pair` too (`impl<T> Index for Pair<T>`, AGAST
# #2847): the parser records such an impl's type as its bare name.
pub fn si_traits(m: *Module, type_name_sv: StrView) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    let head: i32 = si_head_len(StrView { ptr: (type_name), len: (type_len) as i64 })
    var mask: i32 = 0
    var ib: *ImplBlock = m.impls
    while ib != null
        var hit: i32 = 0
        if ib.trait_name != null
            if ib.type_params == null
                hit = si_name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (type_name), len: (type_len) as i64 })
            else if head < type_len
                hit = si_name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (type_name), len: (head) as i64 })
        if hit == 1
            if si_name_eq(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, StrView { ptr: (c"Index"), len: (5) as i64 }) == 1
                mask = mask | SI_INDEX
            else if si_name_eq(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, StrView { ptr: (c"IndexMut"), len: (8) as i64 }) == 1
                mask = mask | SI_INDEX_MUT
            else if si_name_eq(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, StrView { ptr: (c"IndexSet"), len: (8) as i64 }) == 1
                mask = mask | SI_INDEX_SET
        ib = ib.next
    mask

# How many type parameters the generic struct `head` declares, 0 for any
# other name.
fn si_arity(m: *Module, head_sv: StrView) -> i32
    var head: *u8 = head_sv.ptr
    var len: i32 = head_sv.len as i32
    var st: *StructDef = m.structs
    while st != null
        if st.type_params != null and si_name_eq(StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (head), len: (len) as i64 }) == 1
            var n: i32 = 0
            var tp: *TypeParam = st.type_params
            while tp != null
                n += 1
                tp = tp.next
            return n
        st = st.next
    0

# 1 when the module (imports merged) declares a struct `name`: a non-generic
# one, or `Pair$i64` of a generic `Pair` (AGAST #2847).  Or `name` is
# `StrView`: the compiler knows it without `import ritzlib.strview`, so `s[i]`
# on one has no StructDef here and was lowered as an array index, into
# invalid IR (AGAST #4063).  It isn't one of §7.8's built-ins.
pub fn si_is_struct(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if si_name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        return 1
    let head: i32 = si_head_len(StrView { ptr: (name), len: (len) as i64 })
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            if si_name_eq(StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
                return 1
        else if head < len and si_name_eq(StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (name), len: (head) as i64 }) == 1
            return 1
        st = st.next
    0

# Copy the type at `*pos` of the mangled `name` into `out` (at `*at`) as the
# source spells it.  0 when the arities can't account for the name.
fn si_show_take(m: *Module, name_sv: StrView, pos: *i32, out: *u8, at: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let start: i32 = *pos
    var end: i32 = start
    while end < len and *(name + end) != '$'
        end += 1
    if end == start
        return 0
    memcpy(out + *at, name + start, (end - start) as i64)
    *at = *at + end - start
    *pos = end
    let n: i32 = si_arity(m, StrView { ptr: (name + start), len: (end - start) as i64 })
    if n == 0
        return 1
    *(out + *at) = '<'
    *at = *at + 1
    var k: i32 = 0
    while k < n
        if *pos >= len
            return 0
        *pos = *pos + 1   # the `$`
        if k > 0
            *(out + *at) = ','
            *(out + *at + 1) = ' '
            *at = *at + 2
        if si_show_take(m, StrView { ptr: (name), len: (len) as i64 }, pos, out, at) == 0
            return 0
        k += 1
    *(out + *at) = '>'
    *at = *at + 1
    1

# A monomorphised type name as the source spells it: `Pair$i64` is
# `Pair<i64>`, `Pair$i64$i32` `Pair<i64, i32>` (ritz0: deref_rules.display,
# AGAST #2847).  Any other name is itself.
pub fn si_shown(m: *Module, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_len = len
    if si_head_len(StrView { ptr: (name), len: (len) as i64 }) == len
        return name
    # Each `$` becomes at most `, ` and the closing `>`: three bytes.
    let out: *u8 = malloc((len * 3 + 1) as i64)
    var pos: i32 = 0
    var at: i32 = 0
    if si_show_take(m, StrView { ptr: (name), len: (len) as i64 }, @pos, out, @at) == 0 or pos != len
        free(out)
        return name
    *(out + at) = 0
    *out_len = at
    out

# `Vec$T`, `Span$T` and `String` index as the language says (§7.8).
pub fn si_built_in(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if si_name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 1
        return 1
    if len >= 4 and memcmp(name, c"Vec$", 4) == 0
        return 1
    if len >= 5 and memcmp(name, c"Span$", 5) == 0
        return 1
    if si_name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Vec"), len: (3) as i64 }) == 1 or si_name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1
        return 1
    0

# needs_index's words for `type_name`, as one string (AGAST #2452): index_through
# says them through emit_nd_error, for an element that has nothing to index.
pub fn si_needs_index_msg(type_name_sv: StrView) -> *u8
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    let tail: *u8 = c"` can't be indexed: it doesn't implement `Index` (§7.8)"
    let tail_len: i32 = strlen(tail) as i32
    let msg: *u8 = malloc((type_len + tail_len + 2) as i64)
    *msg = '`'
    memcpy(msg + 1, type_name, type_len as i64)
    memcpy(msg + 1 + type_len, tail, (tail_len + 1) as i64)
    msg

# Count a refusal and print its `<file>:<line>:<col>: error: ` (diag).
fn si_error_at(line: i32, col: i32)
    g_si_errors = g_si_errors + 1
    diag_error_at(g_si_file, diag_span(line, col))

# `Index`, `Index` and `IndexSet`, `Index`, `IndexMut` and `IndexSet`.
fn si_print_listed(mask: i32)
    var names: [3]*u8
    var n: i32 = 0
    if (mask & SI_INDEX) != 0
        names[n] = c"`Index`"
        n += 1
    if (mask & SI_INDEX_MUT) != 0
        names[n] = c"`IndexMut`"
        n += 1
    if (mask & SI_INDEX_SET) != 0
        names[n] = c"`IndexSet`"
        n += 1
    var i: i32 = 0
    while i < n
        if i > 0
            if i == n - 1
                eprints(" and ")
            else
                eprints(", ")
        eprints_cstr(names[i])
        i += 1

# 1 when `use` of `m[k]` on `type_name`, which implements `mask`, is allowed;
# else the located refusal, and 0.  (ritz0: index_rules.message.)
pub fn si_check(line: i32, col: i32, type_name_sv: StrView, mask: i32, use: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    var ok: i32 = 0
    if mask != 0
        if use == SI_USE_READ
            ok = ((mask & SI_INDEX) != 0) as i32
        else if use == SI_USE_ASSIGN
            ok = ((mask & (SI_INDEX_SET | SI_INDEX_MUT)) != 0) as i32
        else
            ok = ((mask & SI_INDEX_MUT) != 0) as i32
    if ok == 1
        return 1
    si_error_at(line, col)
    if mask == 0 or use == SI_USE_READ
        eprintln_cstr(si_needs_index_msg(StrView { ptr: (type_name), len: (type_len) as i64 }))
        return 0
    if use == SI_USE_ASSIGN
        eprints("`m[k] = v` needs `IndexSet` or `IndexMut`, and `")
    else
        if use == SI_USE_ADDR_MUT
            eprints("`@&m[k]`")
        else if use == SI_USE_COMPOUND
            eprints("`m[k] op= x`")
        else
            eprints("`m[k].f = x`")
        eprints(" needs `IndexMut`, and `")
    sys_write(2, type_name, type_len as i64)
    eprints("` implements only ")
    si_print_listed(mask)
    eprints("\n")
    0

# `p[k] = v` and the other writes with `p` an `@M` (§3.2): ref_check's words,
# which it can't say itself once the store is a method call.
pub fn si_refuse_write_through(line: i32, col: i32)
    si_error_at(line, col)
    eprintln("cannot write through an `@T`: make it `@&T`")

# `m[k]` on a by-value call's result `base`: `@base` (`@&base` when
# `mutable`) would lend a temporary to `index` / `index_mut`, which return a
# reference into it.  ritz0's ref_rules.lent_temp_escapes words, at `base`
# (AGAST #2847; Aaron's ruling on AGAST #3215).
pub fn si_refuse_lent(base: *Expr, mutable: i32)
    si_error_at(base.span.line, base.span.col)
    eprints("this call returns a reference, and `")
    if mutable == 1
        eprints("@&")
    else
        eprints("@")
    diag_eprint_lent(base)
    eprints("` lends a temporary that's dropped when the call returns: bind it to a local first\n")

# A fresh, zeroed Expr.
pub fn si_new_expr(kind: ExprKind, line: i32, col: i32) -> *Expr
    let e: *Expr = malloc(sizeof(Expr)) as *Expr
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = kind
    e.span.line = line
    e.span.col = col
    e.next = null
    e

# `recv.<method>(args)`: `args` is a list linked through `next`.
pub fn si_method(recv: *Expr, method_sv: StrView, args: *Expr, line: i32, col: i32) -> *Expr
    var method: *u8 = method_sv.ptr
    var method_len: i32 = method_sv.len as i32
    let call: *Expr = si_new_expr(ExprKind.Method, line, col)
    call.left = recv
    call.ident_ptr = method
    call.ident_len = method_len
    call.args = args
    call

# Note `call`, made for `m[k]` (`place`) used as `use`, for ref_loan (R11a).
# `addr` is 1 when the call is `@m[k]` / `@&m[k]` itself; `line:col` is a
# store's statement.  A field store's place is the whole `m[k].f…` it writes
# (si_field_place), as ritz0's MoveChecker._write_place (AGAST #4160).
pub fn si_mark(call: *Expr, place: *Expr, use: i32, addr: i32, line: i32, col: i32)
    let st: *IndexStep = malloc(sizeof(IndexStep)) as *IndexStep
    st.place = place
    st.use = use
    st.addr = addr
    st.at.line = line
    st.at.col = col
    call.index_step = st

# A copy of the store target `t`, a field chain `m[k].f…` down to `root`
# (`m[k]`), for ref_loan: si_into_deref turns `root` into `*<call>` in place.
# The copy shares `m` and `k`, which nothing rewrites.
pub fn si_field_place(t: *Expr, root: *Expr) -> *Expr
    if t == root
        let ix: *Expr = si_new_expr(ExprKind.Index, root.span.line, root.span.col)
        ix.left = root.left
        ix.right = root.right
        return ix
    let f: *Expr = si_new_expr(ExprKind.Member, t.span.line, t.span.col)
    f.ident_ptr = t.ident_ptr
    f.ident_len = t.ident_len
    f.left = si_field_place(t.left, root)
    f

# `*e`.
pub fn si_deref(e: *Expr, line: i32, col: i32) -> *Expr
    let d: *Expr = si_new_expr(ExprKind.Unary, line, col)
    d.op = OpKind.Deref
    d.operand = e
    d

# ----------------------------------------------------------------------------
# Calls evaluated once.  `m[k] op= x` arrives as `*C = *C op x` with one call
# node C shared by the store and the read: the emitter emits C at the first and
# hands its register to the second, so `index_mut` runs once (AGAST #2529).
# Each emission of the statement (a `defer` body is emitted at every exit)
# comes as such a pair, so the second of each clears the entry.
# ----------------------------------------------------------------------------

var g_si_once: **Expr = null
var g_si_once_reg: *i32 = null
var g_si_once_count: i32 = 0
var g_si_once_cap: i32 = 0

pub fn si_once_add(e: *Expr)
    if g_si_once_count == g_si_once_cap
        var cap: i32 = 16
        if g_si_once_cap > 0
            cap = g_si_once_cap * 2
        let nodes: **Expr = malloc((cap as i64) * 8) as **Expr
        let regs: *i32 = malloc((cap as i64) * 4) as *i32
        var i: i32 = 0
        while i < g_si_once_count
            *(nodes + i) = *(g_si_once + i)
            *(regs + i) = *(g_si_once_reg + i)
            i += 1
        g_si_once = nodes
        g_si_once_reg = regs
        g_si_once_cap = cap
    *(g_si_once + g_si_once_count) = e
    *(g_si_once_reg + g_si_once_count) = -1
    g_si_once_count += 1

# The slot of `e` among the calls evaluated once, or -1.
pub fn si_once_find(e: *Expr) -> i32
    var i: i32 = 0
    while i < g_si_once_count
        if *(g_si_once + i) == e
            return i
        i += 1
    -1

# The register an earlier emission of slot `i` left, or -1 when this is the
# first of the pair (record it with si_once_set).  Reading it clears the slot.
pub fn si_once_take(i: i32) -> i32
    let r: i32 = *(g_si_once_reg + i)
    *(g_si_once_reg + i) = -1
    r

pub fn si_once_set(i: i32, reg: i32)
    *(g_si_once_reg + i) = reg
