# ritz1/src/sema_index_store.ritz - an index store ritz1 can't lower
#
# AGAST #3565.  An expression-target index store `x[i] = v` (a StmtKind.Assign
# whose target is an ExprKind.Index) is lowered by one of emit_assign's arms for
# its base: an array element or `**T` element (base ExprKind.Index), `(*p)[i]`
# (ExprKind.Unary), `x.f[i]` (ExprKind.Member, which refuses what it can't type
# itself, #1439), `b.m()[i]` (ExprKind.Method, #3528), `f()[i]` (ExprKind.Call,
# #3442), and `(e as *T)[i]`, `(q + k)[i]`, `(p)[i]` (ExprKind.Cast, ExprKind.Binary
# and ExprKind.Ident: emit_ptr_base_index_store).  A target none of them takes
# reached the generic deref path, which read `x[i]` as a VALUE and stored
# through it: always a miscompile, most often a SIGSEGV.
#
# index_store_check refuses, before emission, the targets it can show none
# of them takes.  Not every base: index_through also lowers names, calls and
# casts that are (or point at) a `[N]T`, Vec, Span or String (#2329, #2726),
# and Sema doesn't type those views, so they are left to the emitter.  It
# refuses, unless emit_ptr_base_index_store / emit_call_base_index_store
# store through it (isc_base_ok: a local, param, global, field, cast or named
# call that is a `**T`, or a `*T` with a scalar or known-struct pointee, or
# an inline array element's `@a[i]` (#3757), under any `+ k` / `- k` chain;
# or an `as @&T` cast to one, #3757), a base that is
#   - of an integer, float or bool type (index_scalar_check reports it);
#   - pointer arithmetic, which no view takes (`(@v[0] + 1)[i]` of a Vec); or
#   - a name or call Sema types as a `*T` to such a scalar.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema
import sema_type
import ritzlib.strview

# The global `name`, or null.
fn isc_global(sm: *Sema, name_sv: StrView) -> *GlobalVarDef
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(g.name, name_sv) == 1
            return g
        g = g.next
    null

# 1 when `x`, an index store base's root, is a `**T` or a `*T` whose pointee
# the emitter can stride by (index_store_root_pointee's roots).
fn isc_root_ok(sm: *Sema, x: *Expr) -> i32
    let k: ExprKind = x.kind
    if k == ExprKind.Unary
        return isc_addr_elem_ok(sm, x)
    if k != ExprKind.Cast and k != ExprKind.Call and k != ExprKind.Member and k != ExprKind.Ident
        return 0
    # A call through a local fn pointer: the emitter resolves no FnDef for it.
    if k == ExprKind.Call and isc_local_call(sm, x) == 1
        return 0
    if k == ExprKind.Ident and sema_find_local(sm, x.ident) == null
        # A global `*S` keeps S on pointee_type_name, not where Sema reads it.
        let g: *GlobalVarDef = isc_global(sm, x.ident)
        if g == null
            return 0
        if g.var_type == TypeKind.PtrPtr
            return 1
        if g.var_type != TypeKind.Ptr
            return 0
        if primitive_name_len(g.pointee_type) > 0
            return 1
        return (g.pointee_type_name.len > 0 and sema_find_struct(sm, g.pointee_type_name) != null) as i32
    var t: SemaTy
    let kind: TypeKind = sema_expr_ty(sm, x, @t)
    if kind == TypeKind.PtrPtr
        return 1
    # AGAST #3757: `p as @&T` points at T as `p as *T` does.
    if kind != TypeKind.Ptr and (k != ExprKind.Cast or kind != TypeKind.MutRef)
        return 0
    if primitive_name_len(t.pointee) > 0
        return 1
    if t.name.ptr == null or t.name.len == 0
        return 0
    # A call's `*i32` return names its pointee "i32" (#1984).
    if primitive_type_from_name(t.name) != TypeKind.Void
        return 1
    (sema_find_struct(sm, t.name) != null) as i32

# AGAST #3757: 1 for `@a[i]` (`@`, not `@&`) of a local, param or global
# `[N]T` named `a` with a scalar or known-struct element, a subset of
# addr_elem_root_pointee's roots (which also takes fields and higher ranks).
fn isc_addr_elem_ok(sm: *Sema, x: *Expr) -> i32
    if x.op != OpKind.Addr or x.operand == null or x.operand.kind != ExprKind.Index
        return 0
    let a: *Expr = x.operand.left
    if a == null or a.kind != ExprKind.Ident
        return 0
    if x.operand.right != null and x.operand.right.kind == ExprKind.Range
        return 0
    var elem: TypeKind = TypeKind.Void
    var name: StrView = strview_empty()
    let v: *SemaVar = sema_find_local(sm, a.ident)
    if v != null
        if v.kind != TypeKind.Array
            return 0
        elem = v.index_elem
        name = v.type_name
    else
        let g: *GlobalVarDef = isc_global(sm, a.ident)
        if g == null or g.var_type != TypeKind.Array
            return 0
        elem = g.array_elem_type
        name = g.array_elem_type_name
    if primitive_name_len(elem) > 0
        return 1
    (elem == TypeKind.Struct and name.ptr != null and name.len > 0 and sema_find_struct(sm, name) != null) as i32

# 1 for a call with no name, or through a local of that name.
fn isc_local_call(sm: *Sema, e: *Expr) -> i32
    if e.func_name.len == 0
        return 1
    sema_is_local(sm, e.func_name)

# 1 when `x` is a `*T` / `**T` base the emitter stores through: a root
# isc_root_ok takes, under `+ k` / `- k` steps whose right side isn't itself
# a pointer (`q - p` is a count).
fn isc_base_ok(sm: *Sema, x: *Expr) -> i32
    var root: *Expr = x
    while root.kind == ExprKind.Binary
        if root.op != OpKind.Add and root.op != OpKind.Sub
            return 0
        if root.op == OpKind.Sub and isc_base_ok(sm, root.right) == 1
            return 0
        root = root.left
    # An `as @&T` cast roots no arithmetic (index_store_base_pointee).
    if root != x and root.kind == ExprKind.Cast and root.type_kind == TypeKind.MutRef
        return 0
    isc_root_ok(sm, root)

# 1 when `x` is a name or call Sema types as a `*T` with an integer, float
# or bool T, which index_store_root_pointee would have typed if it could: no
# `[N]T` or Vec index_through could see through.  A call through a local
# fn pointer is one.
fn isc_scalar_ptr(sm: *Sema, x: *Expr) -> i32
    var t: SemaTy
    if sema_expr_ty(sm, x, @t) != TypeKind.Ptr
        return 0
    if primitive_name_len(t.pointee) > 0
        return 1
    (t.name.len > 0 and primitive_type_from_name(t.name) != TypeKind.Void) as i32

# Refuse the index store whose target is `target` when no emit_assign arm
# lowers it.  sema_walk calls this for each expression-target assignment.
pub fn index_store_check(sm: *Sema, target: *Expr)
    if target == null or target.kind != ExprKind.Index or target.left == null
        return
    let base: *Expr = target.left
    let k: ExprKind = base.kind
    if k != ExprKind.Cast and k != ExprKind.Binary and k != ExprKind.Ident and k != ExprKind.Call
        return
    if isc_base_ok(sm, base) == 1
        return
    # A scalar base is index_scalar_check's, which sema_walk runs on the
    # target as on any other index (AGAST #3755).
    if primitive_name_len(sema_expr_type(sm, base)) > 0
        return
    # Pointer arithmetic is no view index_through takes: only
    # emit_ptr_base_index_store stores through it.
    if k != ExprKind.Binary and isc_scalar_ptr(sm, base) == 0
        return
    sema_error_at(sm, target.span.line, target.span.col)
    eprints("can't store through this element: ritz1 stores into `x[i]` here only when `x` is a `*T` or `**T` it can type\n")

# AGAST #3755: an index of an integer, float or bool has nothing to index.
# ritz1 read the value as an address (`var n: i64 = 0` then `n[0] = 5` or
# `n[0]` SIGSEGVd): the emitter's scalar_local_refused left an `i64` / `u64`
# local alone, since an emitter local may carry a pointer as one, but Sema
# binds the declared type (and since AGAST #3893 this is the only check: the
# emitter's went).  ritz0's words, at the `[`, from _index_through.  A slice
# (`n[a..b]`) is index_through's to refuse.

# Report `[`-located §7.8 words when `kind` is a scalar; 1 if it reported.
fn isc_scalar_refused(sm: *Sema, kind: TypeKind, line: i32, col: i32) -> i32
    if primitive_name_len(kind) == 0
        return 0
    sema_error_at(sm, line, col)
    eprints("`")
    eprints_cstr(primitive_name_from_type(kind))
    eprints("` can't be indexed: it doesn't implement `Index` (§7.8)\n")
    1

# `e`, an ExprKind.Index read or store target, whose base Sema types as a scalar:
# a scalar element too, `x[i][j]` (AGAST #3943).  sema_walk_expr calls this for
# every index it visits.  1 if it reported.
pub fn index_scalar_check(sm: *Sema, e: *Expr) -> i32
    if e.left == null or e.right == null or e.right.kind == ExprKind.Range
        return 0
    var line: i32 = e.span.line
    var col: i32 = e.span.col
    if e.bracket.line > 0   # index_through's index_bracket_line / _col
        line = e.bracket.line
        col = e.bracket.col
    isc_scalar_refused(sm, sema_expr_type(sm, e.left), line, col)

# `st`, a StmtKind.IndexAssign `n[i] = v` / `n[i] op= v`, whose name Sema types
# as a scalar.  Its `[` is st.bracket.
pub fn index_name_scalar_check(sm: *Sema, st: *Stmt)
    var t: SemaTy
    isc_scalar_refused(sm, sema_name_ty(sm, st.assign_target, @t), st.bracket.line, st.bracket.col)

# AGAST #3799: `s.f[i] = v` / `p.f[i] = v` (StmtKind.LocalFieldIndexAssign,
# receiver st.var_name) and `(*p).f[i] = v` (StmtKind.MemberIndexAssign,
# receiver st.if_cond), and their `op=` forms, whose field `f`, st.assign_target,
# Sema types as a scalar.  st.bracket is where the field name is (#3015); the
# grammar puts its `[` next, after any blanks on the same line.
pub fn index_field_scalar_check(sm: *Sema, st: *Stmt)
    var r: SemaTy
    if st.kind == StmtKind.LocalFieldIndexAssign
        sema_name_ty(sm, st.var_name, @r)
    else if st.if_cond != null
        sema_expr_ty(sm, st.if_cond, @r)
    else
        return
    var t: SemaTy
    let kind: TypeKind = sema_field_ty(sm, @r, st.assign_target, @t)
    var col: i32 = st.bracket.col + (st.assign_target.len as i32)
    var c: *u8 = st.assign_target.ptr + (st.assign_target.len as i32)
    while *c == ' ' or *c == 9   # ' ', '\t'
        col += 1
        c += 1
    isc_scalar_refused(sm, kind, st.bracket.line, col)
