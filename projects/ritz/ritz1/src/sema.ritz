# ritz1/src/sema.ritz - the checking phase: a `Sema` context over the AST
#
# AGAST #3462 (step 1 of #1816; LARB review/5 ritz1 N1).  ritz1 ran every
# semantic check inside code generation, as a `pub fn *check*(s:
# *EmitterState, ..)` called mid-lowering, so a check ran only where codegen
# reached and every new rule grew the emitter.  Sema is the phase those
# checks move to.  main runs it once per module, after infer_generic_calls
# and monomorphize_module and before emit_module, and stops the compile on
# any error it reports.  A check on Sema takes `sm: *Sema` and reads the AST
# only.  tools/test_ritz1_emitter_check_freeze.py keeps a new one from going
# on EmitterState ("Where a new check goes", ritz1/ARCHITECTURE.md).
#
# Sema walks exactly the fns emit_module lowers: the module's own
# non-generic fns (first of each name), then the methods of its non-generic
# impls.  Monomorphisation has already run, so a generic fn is judged in each
# instance, as the emitter judged it.
#
# Its scope is lexical: a block, a `for` or a match arm puts back what it
# bound on exit (binder_check's discipline).  Each binding carries its
# declared type, and sema_expr_type (sema_type.ritz) types an expression from
# them, answering TYPE_UNKNOWN rather than guessing (AGAST #3501).
#
# The checks on it:
#   must_use_check (must_use.ritz, AGAST #2137): a discarded [[must_use]] call.
#   index_store_check (sema_index_store.ritz, AGAST #3565): an `x[i] = v`
#     whose base is a view of a scalar no emit_assign arm stores through.
#   index_scalar_check / index_name_scalar_check (sema_index_store.ritz, AGAST
#     #3755): `n[i]` or `n[i] = v` with `n` an integer, float or bool.
#   check_implicit_narrowing (narrowing.ritz, AGAST #1364 / #3505): a typed
#     `let` / `var` whose initialiser may not fit.
#   bool_check_* (bool_check.ritz, AGAST #2342, #3502): `bool` is its own type.
#   call_check_* (call_check.ritz, AGAST #1629, #3503): a call's callee is
#     known and its arguments fit it.
#   let_check_* (let_check.ritz, AGAST #2028, #3504): a `let` is immutable,
#     and a struct of one type never goes where another is declared.
#   tail_value_check (tail_value.ritz, AGAST #2236, #3511): a `-> T` fn
#     can't reach its end without a value.
#   enum_as_int_* (enum_as_int.ritz, AGAST #2136, #3511): an enum value where
#     an integer is expected.
#   deref_impls_check / deref_field_stmt (deref_field.ritz, AGAST #3015 /
#     #3509): a `DerefMut` impl needs its `Deref`; `.` through either is
#     resolved into an annotated step call before the other checks see it.
#   ref_loan_check_* (ref_loan.ritz, AGAST #2438, #3506): a borrow of a place
#     an overlapping loan holds; Sema's blocks end the loans.
#   ref_value_check_* (ref_value.ritz, AGAST #2338, #2374, #2340, #3926,
#     #4011): no write or `@&` through an `@T`; a reference to a local doesn't
#     leave its fn; and the slot checks: a reference doesn't fit a by-value
#     slot, nor a value a reference slot, nor `@x` an `@&T`; arrays, casts, a
#     call's temporary, `[v; n]`.
#   literal_* / float_slot_check (literal_slot.ritz, float_slot.ritz, AGAST
#     #2341, #2945, #3510): a literal or integer fits its slot; they annotate
#     the AST (a `*u8` literal, Expr.slot_type, float_slot_unsigned).
#   own_check_* (own_check.ritz, AGAST #2158, #3507): the move check (§13): a
#     use of a moved value, a move out of a reference, an element or a global,
#     a deferred statement at each exit; it annotates FnDef.own_binds, the
#     bindings the emitter's drop insertion gives a flag.
#
# It still imports emitter_core for pure helpers (name_eq, eprint_bytes,
# find_impl_method_by_symbol); moving them off emitter_core belongs to #1816's
# layering child tickets.

import ritzlib.sys
import ritzlib.io
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.str

import ast
import diag          # the error prefix (AGAST #3445)
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import ritzlib.memory

# What Sema knows of a value's type (AGAST #3501): the subset of LocalVar the
# checks read.  kind is a TYPE_*, or TYPE_UNKNOWN when Sema can't say; a
# check treats that as bool_check treats BK_UNSURE.  name is the struct (or
# primitive-named struct, `usize`) a TYPE_STRUCT is, and the struct a pointer
# or reference points at.  Unlike LocalVar, a bool is TYPE_BOOL here: the
# emitter's i64 bool slot (#1646) is a codegen fact, not a type.
struct SemaTy
    kind: i32
    name: *u8
    name_len: i32
    pointee: i32          # the pointee's TYPE_* for a pointer or reference
    fn_sig: *FnDef        # a `fn(..) -> T` value's signature; null otherwise
    # An array is typed by its element (AGAST #3943, #4259): pointee is the
    # element's kind (an N-D array's leaf T), name the leaf's struct, and
    # shape its N-D `[N][M]..T` shape, null for one dimension
    # (sema_type.ritz's sema_arr_ty / sema_arr_elem).
    shape: *ArrayShape

# bool_check's note on a local bound to a nameless tuple (AGAST #3768), which
# Sema binds untyped: each element's BK_* and the struct it names (null when
# none), the element's own note when it is a nameless tuple too, and what a
# pointer or array element's `*x` / `x[i]` reads.  Elements
# past the SEMA_TUPLE_MAX-th get none.
const SEMA_TUPLE_MAX: i32 = 8

struct SemaTupleNote
    n: i32
    bk: [8]i32
    name: [8]*u8
    name_len: [8]i32
    sub: [8]*SemaTupleNote
    # AGAST #3024: what `*x` / `x[i]` of a `*T` / `[N]T` element reads (its
    # BK_*), BK_NONE where Sema can't say.
    elem: [8]i32

# A local in scope: its name, declared type and whether it is a `let`.
struct SemaVar
    name: *u8
    name_len: i32
    kind: i32
    type_name: *u8
    type_name_len: i32
    pointee: i32
    fn_sig: *FnDef
    is_let: i32
    # The integer type its declaration WROTE, for the narrowing check
    # (narrowing.ritz, AGAST #3505); 0 when unwritten or not an integer.
    narrow: i32
    # AGAST #4410: the slot type an unannotated `let`/`var` takes from its
    # initialiser, as emit_var_decl infers it (a float method's width, else
    # i64).  TYPE_UNKNOWN for an annotated declaration and every other
    # binding.  sema_slot_ty reads it for the local's own name.
    init_slot: i32
    # T of a written `[N]T` local or param, or of the `[N]T` a `*[N]T` points
    # at: what `x[i]` is (sema_type.ritz, AGAST #3510); TYPE_VOID otherwise.
    # The one field for an array's element (AGAST #3943): with `shape` below,
    # sema_elem_ty types `x[i]` from it.
    index_elem: i32
    # bool_check's notes (AGAST #3502), BK_NONE (-1) until it makes one: what
    # the local is (a `let` takes its initialiser's kind) and what its
    # element `x[i]` is.  The emitter keeps the same on LocalVar.
    bk: i32
    elem_bk: i32
    elem_fn_sig: *FnDef   # a `[N]fn(..) -> T` local's element signature
    # The N-D shape `x[i]` indexes: an `[N][M]..T` local's, a row's of one
    # (`for r in m`), or the `[N][M]..T` a `*[N][M]..T` points at (AGAST #4259).
    shape: *ArrayShape
    inner: i32            # a `**T` local's inner-pointee slot (ptr_ptr_slot_levels)
    elem_pointee: i32     # U of a `[N]*U` local: what `*a[i]` reads
    # The `name:& T` / `self:&` param this local is, or null: call_check's
    # lent_local (AGAST #3503; the emitter's LocalVar.is_lent, #2250).
    lent: *Param
    # let_check's view of the local (AGAST #3504), as the emitter's LocalVar
    # records it: its TYPE_* (TYPE_UNKNOWN where Sema can't say), the struct
    # it is or points at, its pointee, an array's element TYPE_*, a `name:& C`
    # param (let_lent), and a local bound to a nameless tuple literal (tuple).
    # let_note_* set them.  (A local bound to an unannotated `"..."` is a
    # StrView here already, where the emitter's is a `Span$u8` it marks.)
    let_kind: i32
    let_name: *u8
    let_name_len: i32
    let_pointee: i32
    let_elem: i32
    let_lent: i32
    tuple: i32
    bk_tuple: *SemaTupleNote   # bool_check's tuple note (AGAST #3768); else null

struct Sema
    module: *Module
    file: *u8              # the input path every diagnostic names
    error_count: i32
    fn_map: HashMapI64     # fnv1a(name) -> the first FnDef of that name
    struct_map: HashMapI64 # fnv1a(name) -> the first StructDef of that name
    # The locals in scope in the fn being walked, innermost last.
    scope: *SemaVar
    scope_top: i32
    scope_cap: i32
    cur_fn: *FnDef         # the fn being walked; null for a global or const
    # Where bool_check last reported: one report per place (AGAST #2342).
    bool_err_line: i32
    bool_err_col: i32
    # AGAST #3975: the impl whose method is being walked; null for a free fn.
    # A bare `self:&` is parsed nameless (impl_name_bare_self leaves it to the
    # emitter, which reads the ImplBlock), so sema_bind_param names it here.
    cur_impl: *ImplBlock

pub fn sema_init(sm: *Sema, m: *Module, file: *u8)
    sm.module = m
    sm.file = file
    sm.error_count = 0
    sm.fn_map = hashmap_i64_with_cap(4096)
    var f: *FnDef = m.functions
    while f != null
        let k: i64 = fnv1a_str(f.name, f.name_len) as i64
        if not hashmap_i64_contains(@sm.fn_map, k)
            hashmap_i64_insert(@&sm.fn_map, k, f as i64)
        f = f.next
    sm.struct_map = hashmap_i64_with_cap(1024)
    var st: *StructDef = m.structs
    while st != null
        let sk: i64 = fnv1a_str(st.name, st.name_len) as i64
        if not hashmap_i64_contains(@sm.struct_map, sk)
            hashmap_i64_insert(@&sm.struct_map, sk, st as i64)
        st = st.next
    sm.scope_cap = 256
    sm.scope = malloc(sm.scope_cap as i64 * sizeof(SemaVar)) as *SemaVar
    sm.scope_top = 0
    sm.cur_fn = null
    sm.bool_err_line = 0
    sm.bool_err_col = 0
    sm.cur_impl = null

# --- Diagnostics ---------------------------------------------------------------

# `<file>:<line>:<col>: error: ` (diag) -- the caller writes the rest of the
# line.  Counts one error.
pub fn sema_error_at(sm: *Sema, line: i32, col: i32)
    diag_error_at(sm.file, diag_span(line, col))
    sm.error_count = sm.error_count + 1

# The file the fn being walked comes from (a specialised generic may come from
# an import), else the input's: where its diagnostics point.
pub fn sema_file(sm: *Sema) -> *u8
    if sm.cur_fn != null and sm.cur_fn.def_file != null
        return sm.cur_fn.def_file
    sm.file

# --- Name resolution -----------------------------------------------------------

# The fn named `name`: the first of that name in the module, as the
# emitter's find_fn resolves it.
pub fn sema_find_fn(sm: *Sema, name: *u8, len: i32) -> *FnDef
    let fd: *FnDef = hashmap_i64_get(@sm.fn_map, fnv1a_str(name, len) as i64) as *FnDef
    if fd == null
        return null
    if name_eq(fd.name, fd.name_len, name, len) == 1
        return fd
    # The map is keyed by the hash alone: a hit with another name is a
    # collision, so scan (first occurrence wins).
    var cur: *FnDef = sm.module.functions
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    null

# The fn a named call `e` calls, as the emitter's find_call_fn resolves it:
# a generic instance by its type suffix, else the fn, else an impl method by
# its `Type_method` symbol.  Null for a nameless call.
pub fn sema_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name_len == 0
        return null
    if e.call_type_suffix_len <= 0
        let f: *FnDef = sema_find_fn(sm, e.func_name, e.func_name_len)
        if f != null
            return f
        return find_impl_method_by_symbol(sm.module, e.func_name, e.func_name_len)
    let n: i32 = e.func_name_len + e.call_type_suffix_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + n) = 0
    let fd: *FnDef = sema_find_fn(sm, buf, n)
    free(buf)
    fd

# --- Scope ---------------------------------------------------------------------

# The `{ ptr: *u8, len: i64 }` StrView / Span$u8 a string literal lowers to,
# which emit_module supplies (ensure_string_literal_struct) when the module
# doesn't define it: Sema runs first, so it reads its own copy.
var g_sema_strview: StructDef
var g_sema_span_u8: StructDef
var g_sema_view_ptr: StructField
var g_sema_view_len: StructField

fn sema_view_struct(name: *u8, len: i32) -> *StructDef
    var st: *StructDef = null
    if name_eq(name, len, c"StrView", 7) == 1
        st = @g_sema_strview
    else if name_eq(name, len, c"Span$u8", 7) == 1
        st = @g_sema_span_u8
    else
        return null
    g_sema_view_ptr.name = c"ptr"
    g_sema_view_ptr.name_len = 3
    g_sema_view_ptr.field_type = TYPE_PTR
    g_sema_view_ptr.array_elem_type = TYPE_U8   # the pointee
    g_sema_view_ptr.inner_pointee_type = TYPE_VOID
    g_sema_view_ptr.next = @g_sema_view_len
    g_sema_view_len.name = c"len"
    g_sema_view_len.name_len = 3
    g_sema_view_len.field_type = TYPE_I64
    g_sema_view_len.inner_pointee_type = TYPE_VOID
    st.name = name
    st.name_len = len
    st.fields = @g_sema_view_ptr
    st

# AGAST #4251: the structs Sema made for nameless tuple literals `(a, b, ..)`
# (sema_type.ritz's sema_tuple_ty).  The emitter names its own `tuple_*`
# struct as it lowers the literal (tuple_lit_infer), from its spelling of each
# element's type; Sema names one `(tuple)NNNNNN`, which no struct can be named.
# Its fields are reached through sema_recv_struct (`p.0`, `let (a, b) = p`)
# and the move check; sema_find_struct doesn't name it.
const SEMA_TUPLE_NAME_LEN: i32 = 13
var g_sema_tuples: **StructDef
var g_sema_tuple_count: i32 = 0
var g_sema_tuple_cap: i32 = 0

# A new tuple struct with `fields`, named for its index.
pub fn sema_tuple_new(fields: *StructField) -> *StructDef
    if g_sema_tuple_count >= g_sema_tuple_cap
        var cap: i32 = g_sema_tuple_cap * 2
        if cap < 8
            cap = 8
        g_sema_tuples = realloc(g_sema_tuples as *u8, (cap as i64) * 8) as **StructDef
        g_sema_tuple_cap = cap
    let st: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
    let name: *u8 = malloc(16)
    memcpy(name, c"(tuple)", 7)
    var n: i32 = g_sema_tuple_count
    var at: i32 = SEMA_TUPLE_NAME_LEN - 1
    while at >= 7
        *(name + at) = ('0' as i32 + n % 10) as u8
        n = n / 10
        at -= 1
    *(name + SEMA_TUPLE_NAME_LEN) = 0
    st.name = name
    st.name_len = SEMA_TUPLE_NAME_LEN
    st.fields = fields
    let ts: **StructDef = g_sema_tuples
    ts[g_sema_tuple_count] = st
    g_sema_tuple_count = g_sema_tuple_count + 1
    st

# The tuple struct `name` names, or null.
pub fn sema_tuple_struct(name: *u8, len: i32) -> *StructDef
    if name == null or len != SEMA_TUPLE_NAME_LEN or name_eq(name, 7, c"(tuple)", 7) == 0
        return null
    var n: i32 = 0
    var at: i32 = 7
    while at < SEMA_TUPLE_NAME_LEN
        n = n * 10 + (*(name + at) as i32 - '0' as i32)
        at += 1
    if n < 0 or n >= g_sema_tuple_count
        return null
    let ts: **StructDef = g_sema_tuples
    ts[n]

# The struct named `name`: the first of that name, as the emitter's
# find_struct resolves it.  Not a tuple struct Sema made: a nameless tuple
# takes the type of the slot it is written into (the emitter's tuple_lit_name),
# so the checks comparing one struct with another leave it be.
pub fn sema_find_struct(sm: *Sema, name: *u8, len: i32) -> *StructDef
    if name == null or len <= 0
        return null
    let st: *StructDef = hashmap_i64_get(@sm.struct_map, fnv1a_str(name, len) as i64) as *StructDef
    if st == null
        return sema_view_struct(name, len)
    if name_eq(st.name, st.name_len, name, len) == 1
        return st
    var cur: *StructDef = sm.module.structs
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    null

# --- Scope ---------------------------------------------------------------------
#
# A binding carries its declared type (AGAST #3501).  sema_walk binds params,
# `let` / `var`, `for` variables, tuple and match-arm bindings, typed
# (AGAST #3810); one whose type it can't state is bound TYPE_UNKNOWN, which
# still shadows an outer name.

pub fn sema_ty_unknown(t: *SemaTy)
    t.kind = TYPE_UNKNOWN
    t.name = null
    t.name_len = 0
    t.pointee = TYPE_VOID
    t.fn_sig = null
    t.shape = null

pub fn sema_bind_ty(sm: *Sema, name: *u8, len: i32, t: *SemaTy, is_let: i32)
    if name == null or len <= 0
        return
    if sm.scope_top >= sm.scope_cap
        sm.scope_cap = sm.scope_cap * 2
        sm.scope = realloc(sm.scope as *u8, sm.scope_cap as i64 * sizeof(SemaVar)) as *SemaVar
    let v: *SemaVar = @sm.scope[sm.scope_top]
    v.name = name
    v.name_len = len
    v.kind = t.kind
    v.type_name = t.name
    v.type_name_len = t.name_len
    v.pointee = t.pointee
    v.fn_sig = t.fn_sig
    v.is_let = is_let
    v.narrow = 0
    v.init_slot = TYPE_UNKNOWN
    v.index_elem = TYPE_VOID
    v.bk = 0 - 1
    v.elem_bk = 0 - 1
    v.elem_fn_sig = null
    v.shape = null
    v.inner = TYPE_VOID
    v.elem_pointee = TYPE_VOID
    v.lent = null
    v.let_kind = t.kind
    v.let_name = t.name
    v.let_name_len = t.name_len
    v.let_pointee = t.pointee
    v.let_elem = TYPE_VOID
    v.let_lent = 0
    v.tuple = 0
    v.bk_tuple = null
    sm.scope_top = sm.scope_top + 1

# A binding Sema can't type.
pub fn sema_bind(sm: *Sema, name: *u8, len: i32)
    var t: SemaTy
    sema_ty_unknown(@t)
    sema_bind_ty(sm, name, len, @t, 0)

# The innermost local named `name`, or null.
pub fn sema_find_local(sm: *Sema, name: *u8, len: i32) -> *SemaVar
    var i: i32 = sm.scope_top - 1
    while i >= 0
        let v: *SemaVar = @sm.scope[i]
        if name_eq(v.name, v.name_len, name, len) == 1
            return v
        i = i - 1
    null

# 1 when a local named `name` is in scope.
pub fn sema_is_local(sm: *Sema, name: *u8, len: i32) -> i32
    (sema_find_local(sm, name, len) != null) as i32

# --- Methods -------------------------------------------------------------------
#
# The fn a method call `x.m()` on a value of type `type_name` calls, as the
# emitter's method_callee_def resolves it: a ritzlib UFCS helper
# (`vec_push$T`, `strview_get`, `string_len`), else the type's impl method,
# else a specialised generic impl method (`W$i32_dup`).

pub fn sema_impl_method(sm: *Sema, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, type_name, type_name_len) == 1
            var mm: *FnDef = ib.methods
            while mm != null
                if name_eq(mm.name, mm.name_len, method, method_len) == 1
                    return mm
                mm = mm.next
        ib = ib.next
    null

# The impl block whose methods hold `f`, or null.
pub fn sema_impl_of(sm: *Sema, f: *FnDef) -> *ImplBlock
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            if method == f
                return ib
            method = method.next
        ib = ib.next
    null

# `a` + `sep` + `b`, heap-allocated; *out_len is its length.
fn sema_join(a: *u8, a_len: i32, sep: u8, b: *u8, b_len: i32, out_len: *i32) -> *u8
    var n: i32 = a_len + b_len
    if sep != 0
        n = n + 1
    let buf: *u8 = malloc(n as i64 + 1)
    var k: i32 = 0
    for i in 0..a_len
        *(buf + k) = *(a + i)
        k += 1
    if sep != 0
        *(buf + k) = sep
        k += 1
    for i in 0..b_len
        *(buf + k) = *(b + i)
        k += 1
    *(buf + n) = 0
    *out_len = n
    buf

pub fn sema_spec_impl_method(sm: *Sema, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    var n: i32 = 0
    let buf: *u8 = sema_join(type_name, type_name_len, '_', method, method_len, @n)
    let fd: *FnDef = sema_find_fn(sm, buf, n)
    free(buf)
    fd

# A method call's callee: an impl method, else a specialised generic impl's.
# Never a free fn: the UFCS tables went with LARB R66 (#3497).
pub fn sema_method_fn(sm: *Sema, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    let m: *FnDef = sema_impl_method(sm, type_name, type_name_len, method, method_len)
    if m != null
        return m
    sema_spec_impl_method(sm, type_name, type_name_len, method, method_len)
