# generic_infer.ritz - a generic call's type args, from its arguments (AGAST #1982)
#
# LANGUAGE_SPEC section 4.4: a call `f(args)` to a generic `f<T...>` binds
# each T by matching each param's type against its argument's type (`T`,
# `@T`, `@&T`, `*T`, `Vec<T>`, `@Vec<T>` ...).  An integer literal argument
# to a bare `T` param binds T to i64, as `let x = 3` would, unless another
# argument binds T.  An explicit `f<T>(...)` is left alone.  A T that no
# argument binds (one only in the return type), or that two arguments bind
# differently, is a located error:
#
#     can't infer `T` for `f`: write `f<T>(...)`
#
# The pass runs before monomorphize_module and only fills in
# Expr.call_type_suffix, so the call is then exactly the spelled-out one.
# Every body is walked, generic templates too: in `fn g<T>(x: T)` a call
# `f(x)` becomes `f<T>(x)` ("$T"), which specialising g substitutes as it
# does for a written `f<T>(x)`.  Calls are inferred inside-out, so `f(g(x))`
# knows g's instance before it types f's argument.
#
# Mirrors ritz0's Monomorphizer._infer_call_type_args (monomorph.py): the
# same argument typing, the same literal rule, the same message.  An
# argument whose type this pass can't tell binds nothing.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str

import ast
import diag          # the error prefix (AGAST #3445)
import ast_helpers
import monomorph

# The type of an expression, as far as this pass can tell.  kind is a TYPE_*;
# name is the struct's mangled name for TypeKind.Struct, and the pointee struct's
# for a TypeKind.Ptr / TypeKind.Ref / TypeKind.MutRef whose pointee is TypeKind.Struct.
# AGAST #3277: for a TypeKind.Array, name is the whole `[N]E` already spelled as a
# type argument, "arr" N "_" E (gi_array_spell), and a T binds to it as is.
struct GiType
    kind: TypeKind
    name: *u8
    name_len: i32
    pointee: TypeKind

# ----------------------------------------------------------------------------
# Locals of the fn being walked: params, then each let/var as it's declared.
# Names are unique within a fn (#2395), so a flat table per fn is enough.
# ----------------------------------------------------------------------------
var g_gi_names: **u8 = null
var g_gi_name_lens: *i32 = null
var g_gi_kinds: *TypeKind = null
var g_gi_tnames: **u8 = null
var g_gi_tname_lens: *i32 = null
var g_gi_pointees: *TypeKind = null
var g_gi_count: i32 = 0
var g_gi_cap: i32 = 0

var g_gi_errors: i32 = 0
var g_gi_input: *u8 = null   # the file compiled
var g_gi_file: *u8 = null    # the file the fn being walked is written in

fn gi_add_local(name_sv: StrView, t: *GiType)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if g_gi_count >= g_gi_cap
        var cap: i64 = (g_gi_cap as i64) * 2
        if cap < 64
            cap = 64
        g_gi_names = realloc(g_gi_names as *u8, cap * 8) as **u8
        g_gi_name_lens = realloc(g_gi_name_lens as *u8, cap * 4) as *i32
        g_gi_kinds = realloc(g_gi_kinds as *u8, cap * sizeof(TypeKind)) as *TypeKind
        g_gi_tnames = realloc(g_gi_tnames as *u8, cap * 8) as **u8
        g_gi_tname_lens = realloc(g_gi_tname_lens as *u8, cap * 4) as *i32
        g_gi_pointees = realloc(g_gi_pointees as *u8, cap * sizeof(TypeKind)) as *TypeKind
        g_gi_cap = cap as i32
    *(g_gi_names + g_gi_count) = name
    *(g_gi_name_lens + g_gi_count) = name_len
    *(g_gi_kinds + g_gi_count) = t.kind
    *(g_gi_tnames + g_gi_count) = t.name
    *(g_gi_tname_lens + g_gi_count) = t.name_len
    *(g_gi_pointees + g_gi_count) = t.pointee
    g_gi_count = g_gi_count + 1

fn gi_find_local(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var i: i32 = g_gi_count - 1
    while i >= 0
        if *(g_gi_name_lens + i) == name_len and memcmp(*(g_gi_names + i), name, name_len as i64) == 0
            return i
        i = i - 1
    -1

fn gi_set(out: *GiType, kind: TypeKind, name_sv: StrView, pointee: TypeKind) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.kind = kind
    out.name = name
    out.name_len = name_len
    out.pointee = pointee
    1

fn gi_is_ptr_kind(k: TypeKind) -> i32
    if k == TypeKind.Ptr or k == TypeKind.Ref or k == TypeKind.MutRef
        return 1
    0

# AGAST #3277: a 1-D `[size]elem` as a type argument, spelled as ast_helpers'
# spell_last_array spells `g<[4]i32>`'s, so monomorph's array_arg_decode reads
# it back: "arr" size "_" E, E a primitive's name, a struct's (elem_name), or
# "ptr_" + either for a `*U` element (U elem_pointee).  Sets *out to
# TypeKind.Array and returns 1, or 0 for an element a suffix can't spell.
# AGAST #4178: an array element (elem TypeKind.Array, elem_name its own
# spelling) nests as spell_last_array nests `[N][M]E`: "arr2_arr3_u8".
fn gi_array_spell(size: i32, elem: TypeKind, elem_name_sv: StrView, elem_pointee: TypeKind, out: *GiType) -> i32
    var elem_name: *u8 = elem_name_sv.ptr
    var elem_name_len: i32 = elem_name_sv.len as i32
    var e: *u8 = null
    var el: i32 = 0
    var ptr: i32 = 0
    match elem
        TypeKind.Struct | TypeKind.Array =>
            e = elem_name
            el = elem_name_len
        TypeKind.Ptr =>
            ptr = 1
            if elem_pointee == TypeKind.Struct
                e = elem_name
                el = elem_name_len
            else
                el = primitive_arg_spelling(elem_pointee, @e)
        _ =>
            el = primitive_arg_spelling(elem, @e)
    if e == null or el <= 0 or size <= 0
        return 0
    # "arr" + up to 10 digits + "_" + "ptr_" + E + NUL
    let buf: *u8 = malloc((el + 19) as i64)
    memcpy(buf, c"arr", 3)
    var pos: i32 = 3
    pos = pos + write_dec_i32(buf + pos, size)
    *(buf + pos) = 95   # '_'
    pos = pos + 1
    if ptr == 1
        memcpy(buf + pos, c"ptr_", 4)
        pos = pos + 4
    memcpy(buf + pos, e, el as i64)
    pos = pos + el
    *(buf + pos) = 0
    gi_set(out, TypeKind.Array, StrView { ptr: (buf), len: (pos) as i64 }, TypeKind.Void)

# 1 for a primitive TYPE_* that a suffix can spell.
fn gi_is_prim(k: TypeKind) -> i32
    var s: *u8 = null
    if primitive_arg_spelling(k, @s) > 0
        return 1
    0

# A plain integer literal (`3`, `-3`): its T binds weakly (see the header).
fn gi_is_int_literal(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg
        return gi_is_int_literal(e.operand)
    if e.kind != ExprKind.IntLit
        return 0
    if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE or e.lit_kind == LIT_UNIT or e.lit_kind == LIT_PASS
        return 0
    1

# The type a one-argument suffix ("$u8", "$Vec$u8", "$ptr_u8") names.
fn gi_type_from_suffix(suffix_sv: StrView, out: *GiType) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let k: TypeKind = parse_type_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 })
    match k
        TypeKind.Array =>
            # AGAST #3277: "$arr4_i32" is the array gi_array_spell spelled.
            var arr: ArrayArg
            if suffix_len < 2 or array_arg_decode(StrView { ptr: (suffix + 1), len: (suffix_len - 1) as i64 }, @arr) == 0
                return 0
            return gi_set(out, TypeKind.Array, StrView { ptr: (suffix + 1), len: (suffix_len - 1) as i64 }, TypeKind.Void)
        TypeKind.Void =>
            return 0
        _ => pass
    var n: *u8 = null
    var nl: i32 = 0
    get_type_name_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }, @n, @nl)
    match k
        TypeKind.Ptr =>
            let pk: TypeKind = primitive_type_from_name(StrView { ptr: (n), len: (nl) as i64 })
            if pk != TypeKind.Void
                return gi_set(out, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, pk)
            return gi_set(out, TypeKind.Ptr, StrView { ptr: (n), len: (nl) as i64 }, TypeKind.Struct)
        TypeKind.Struct =>
            return gi_set(out, TypeKind.Struct, StrView { ptr: (n), len: (nl) as i64 }, TypeKind.Void)
        _ => pass
    gi_set(out, k, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)

# The return type of a call: a plain fn's, or a one-parameter generic's with
# its suffix substituted (`vec_new<u64>()` is a Vec$u64).
fn gi_call_type(mono: *MonoCtx, m: *Module, e: *Expr, out: *GiType) -> i32
    let f: *FnDef = find_fn_in_module(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if f == null or f.return_type == TypeKind.Void
        return 0
    if f.type_params == null
        if f.return_type == TypeKind.Struct
            if f.return_type_name == null
                return 0
            return gi_set(out, TypeKind.Struct, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }, TypeKind.Void)
        if gi_is_prim(f.return_type) == 1
            return gi_set(out, f.return_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        return 0
    if e.call_type_suffix_len <= 0 or f.type_params.next != null or f.return_type_name == null
        return 0
    let tp: *TypeParam = f.type_params
    let rn: *u8 = f.return_type_name
    let rl: i32 = f.return_type_name_len
    var is_tp: i32 = 0
    if rl == tp.name_len and memcmp(rn, tp.name, rl as i64) == 0
        is_tp = 1
    if f.return_type == TypeKind.Struct
        if is_tp == 1
            return gi_type_from_suffix(StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 }, out)
        var sn: *u8 = null
        var sl: i32 = 0
        substitute_type_param_in_name(mono, StrView { ptr: (rn), len: (rl) as i64 }, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 }, @sn, @sl)
        return gi_set(out, TypeKind.Struct, StrView { ptr: (sn), len: (sl) as i64 }, TypeKind.Void)
    if gi_is_ptr_kind(f.return_type) == 1 and is_tp == 1
        var inner: GiType
        if gi_type_from_suffix(StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 }, @inner) == 0
            return 0
        if inner.kind == TypeKind.Struct
            return gi_set(out, f.return_type, StrView { ptr: (inner.name), len: (inner.name_len) as i64 }, TypeKind.Struct)
        if gi_is_prim(inner.kind) == 1
            return gi_set(out, f.return_type, StrView { ptr: (null), len: (0) as i64 }, inner.kind)
        if inner.kind == TypeKind.Array and inner.name != null
            # AGAST #4182: `put<[2]i32>(..)` is a `*[2]i32`; name keeps the
            # `[N]E` spelling ("arr2_i32") for gi_index_type.
            return gi_set(out, f.return_type, StrView { ptr: (inner.name), len: (inner.name_len) as i64 }, TypeKind.Array)
    0

# The struct a value of type t is, or points at (one level): its name, or null.
fn gi_struct_of(t: *GiType, out_len: *i32) -> *u8
    if t.kind == TypeKind.Struct or (gi_is_ptr_kind(t.kind) == 1 and t.pointee == TypeKind.Struct)
        *out_len = t.name_len
        return t.name
    *out_len = 0
    null

fn gi_member_type(mono: *MonoCtx, m: *Module, e: *Expr, out: *GiType) -> i32
    var base: GiType
    if gi_type_of(mono, m, e.left, @base) == 0
        return 0
    var sl: i32 = 0
    let sn: *u8 = gi_struct_of(@base, @sl)
    if sn == null
        return 0
    let st: *StructDef = find_concrete_struct(m, StrView { ptr: (sn), len: (sl) as i64 })
    if st == null
        return gi_instance_member_type(mono, m, sn, sl, e, out)
    var f: *StructField = st.fields
    while f != null
        if f.name_len == e.ident_len and memcmp(f.name, e.ident_ptr, e.ident_len as i64) == 0
            if f.field_type == TypeKind.Struct and f.field_type_name != null
                return gi_set(out, TypeKind.Struct, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, TypeKind.Void)
            if gi_is_prim(f.field_type) == 1
                return gi_set(out, f.field_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            return 0
        f = f.next
    0

# AGAST #4299: `b.v` where b is a generic struct's instance (`Bag$Nope`, a
# `var b: Bag<Nope>`): monomorph hasn't made `Bag$Nope` yet, so the field is
# read off the template `Bag<T>` and its type has the instance's args put in
# for the params (`T` is `Nope`; `V` of `Pair<K, V>` is the 2nd arg), then
# typed as the one-argument suffix "$Nope" is.  Mirrors ritz0, which types
# the member through the instantiated struct.
fn gi_instance_member_type(mono: *MonoCtx, m: *Module, sn: *u8, sl: i32, e: *Expr, out: *GiType) -> i32
    var i: i32 = 0
    while i < sl and *(sn + i) != '$'   # '$'
        i = i + 1
    if i == sl
        return 0
    let st: *StructDef = find_generic_struct(m, StrView { ptr: (sn), len: (i) as i64 })
    if st == null
        return 0
    let f: *StructField = gi_field_named(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if f == null
        return 0
    if f.field_type != TypeKind.Struct or f.field_type_name == null
        if gi_is_prim(f.field_type) == 1
            return gi_set(out, f.field_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        return 0
    let suffix: *u8 = sn + i
    let sfl: i32 = sl - i
    let cap: i32 = mangled_arg_capacity(StrView { ptr: (suffix), len: (sfl) as i64 })
    let starts: *i32 = malloc((cap as i64) * 4) as *i32
    let lens: *i32 = malloc((cap as i64) * 4) as *i32
    var r: i32 = 0
    if split_mangled_args(mono.pctx, m, StrView { ptr: (suffix), len: (sfl) as i64 }, starts, lens) == count_type_params(st.type_params)
        var fl: i32 = f.field_type_name_len
        let tn: *u8 = substitute_params_in_mangled(mono, st.type_params, suffix, starts, lens, StrView { ptr: (f.field_type_name), len: (fl) as i64 }, @fl)
        # As a one-argument suffix: "$" + the substituted type's name.
        let one: *u8 = malloc((fl + 2) as i64)
        *one = 36
        memcpy(one + 1, tn, fl as i64)
        *(one + fl + 1) = 0
        r = gi_type_from_suffix(StrView { ptr: (one), len: (fl + 1) as i64 }, out)
    free(starts as *u8)
    free(lens as *u8)
    r

# `b[i]`: a Vec's or Span's element, a `*T`'s T, or a `[N]E`'s or `*[N]E`'s E.
fn gi_index_type(mono: *MonoCtx, m: *Module, e: *Expr, out: *GiType) -> i32
    var base: GiType
    if gi_type_of(mono, m, e.left, @base) == 0
        return 0
    if base.kind == TypeKind.Ptr and base.pointee != TypeKind.Struct and gi_is_prim(base.pointee) == 1
        return gi_set(out, base.pointee, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
    # A 1-D `[N]E` local's element (AGAST #3408: `Span { ptr: @a[1], .. }`),
    # or a `*[N]E`'s, as a `-> *T` at T = `[N]E` returns (AGAST #4182).
    if (base.kind == TypeKind.Array or (base.kind == TypeKind.Ptr and base.pointee == TypeKind.Array)) and base.name != null
        var arr: ArrayArg
        if array_arg_decode(StrView { ptr: (base.name), len: (base.name_len) as i64 }, @arr) == 0
            return 0
        match arr.elem
            TypeKind.Struct =>
                return gi_set(out, TypeKind.Struct, StrView { ptr: (arr.name), len: (arr.name_len) as i64 }, TypeKind.Void)
            TypeKind.Ptr =>
                return gi_set(out, TypeKind.Ptr, StrView { ptr: (arr.name), len: (arr.name_len) as i64 }, arr.pointee)
            _ => pass
        if gi_is_prim(arr.elem) == 1
            return gi_set(out, arr.elem, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        return 0
    var sl: i32 = 0
    let sn: *u8 = gi_struct_of(@base, @sl)
    if sn == null
        return 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    if classify_collection_type(StrView { ptr: (sn), len: (sl) as i64 }, @suf, @suf_len) == 0
        return 0
    gi_type_from_suffix(StrView { ptr: (suf), len: (suf_len) as i64 }, out)

# The type of `e`, or 0 when this pass can't tell.  Literals take their
# default type, as `let x = <literal>` gives them.
fn gi_type_of(mono: *MonoCtx, m: *Module, e: *Expr, out: *GiType) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    match k
        ExprKind.IntLit =>
            if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
                return gi_set(out, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            if e.lit_kind == LIT_UNIT or e.lit_kind == LIT_PASS
                return 0
            return gi_set(out, TypeKind.I64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        ExprKind.FloatLit =>
            return gi_set(out, TypeKind.F64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        ExprKind.CharLit =>
            return gi_set(out, TypeKind.U8, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        ExprKind.StringLit =>
            return gi_set(out, TypeKind.Struct, StrView { ptr: (c"StrView"), len: (7) as i64 }, TypeKind.Void)
        ExprKind.CstringLit =>
            return gi_set(out, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, TypeKind.U8)
        ExprKind.Ident =>
            let idx: i32 = gi_find_local(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if idx < 0
                return 0
            return gi_set(out, *(g_gi_kinds + idx), StrView { ptr: (*(g_gi_tnames + idx)), len: (*(g_gi_tname_lens + idx)) as i64 }, *(g_gi_pointees + idx))
        ExprKind.Cast =>
            if e.type_kind == TypeKind.Ptr
                if e.cast_pointee == TypeKind.Struct and e.ident_ptr != null
                    return gi_set(out, TypeKind.Ptr, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, TypeKind.Struct)
                if gi_is_prim(e.cast_pointee) == 1
                    return gi_set(out, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, e.cast_pointee)
                return 0
            if gi_is_prim(e.type_kind) == 1
                return gi_set(out, e.type_kind, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            return 0
        ExprKind.Unary =>
            if e.op == OpKind.Not
                return gi_set(out, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            var inner: GiType
            if gi_type_of(mono, m, e.operand, @inner) == 0
                return 0
            match e.op
                OpKind.Neg | OpKind.BitNot =>
                    return gi_set(out, inner.kind, StrView { ptr: (inner.name), len: (inner.name_len) as i64 }, inner.pointee)
                OpKind.Deref =>
                    if gi_is_ptr_kind(inner.kind) == 0
                        return 0
                    if inner.pointee == TypeKind.Struct
                        return gi_set(out, TypeKind.Struct, StrView { ptr: (inner.name), len: (inner.name_len) as i64 }, TypeKind.Void)
                    if gi_is_prim(inner.pointee) == 1
                        return gi_set(out, inner.pointee, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
                    return 0
                _ => pass
            if e.op == OpKind.Addr or e.op == OpKind.AddrMut
                var rk: TypeKind = TypeKind.Ref
                if e.op == OpKind.AddrMut
                    rk = TypeKind.MutRef
                if inner.kind == TypeKind.Struct
                    return gi_set(out, rk, StrView { ptr: (inner.name), len: (inner.name_len) as i64 }, TypeKind.Struct)
                if gi_is_prim(inner.kind) == 1
                    return gi_set(out, rk, StrView { ptr: (null), len: (0) as i64 }, inner.kind)
            return 0
        ExprKind.Binary =>
            if op_is_cmp_or_logic(e.op)
                return gi_set(out, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            let lk: i32 = gi_type_of(mono, m, e.left, out)
            if lk == 0 or gi_is_int_literal(e.left) == 1
                var r: GiType
                if gi_is_int_literal(e.right) == 0 and gi_type_of(mono, m, e.right, @r) == 1
                    return gi_set(out, r.kind, StrView { ptr: (r.name), len: (r.name_len) as i64 }, r.pointee)
            return lk
        ExprKind.Call =>
            return gi_call_type(mono, m, e, out)
        ExprKind.Member =>
            return gi_member_type(mono, m, e, out)
        ExprKind.Index =>
            return gi_index_type(mono, m, e, out)
        ExprKind.StructLit =>
            return gi_struct_lit_type(m, e, out)
        _ => pass
    0

# AGAST #3064: `D { .. }` is a D, and `Box<i32> { .. }` (parsed as `Box$i32`)
# a Box$i32, so an un-annotated `let t = D { .. }` binds T in `take(@t)`.  A
# generic struct's literal without args (`Cell { v: 3 }`) has them by now:
# gi_slot or gi_struct_lit_args renamed it (#3408).  A tuple literal (no name)
# is untyped.  Mirrors ritz0's _infer_value_type.
fn gi_struct_lit_type(m: *Module, e: *Expr, out: *GiType) -> i32
    if e.ident_ptr == null or e.ident_len <= 0
        return 0
    if find_concrete_struct(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == null
        # Not a plain struct: an instance only when spelled with its args.
        var i: i32 = 0
        while i < e.ident_len and *(e.ident_ptr + i) != '$'   # '$'
            i = i + 1
        if i == e.ident_len or find_generic_struct(m, StrView { ptr: (e.ident_ptr), len: (i) as i64 }) == null
            return 0
    gi_set(out, TypeKind.Struct, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, TypeKind.Void)

# How a type binds a bare T: a primitive's name, a struct's mangled name, or
# "ptr_" and the pointee's.  null for anything a suffix can't spell.
fn gi_spell(t: *GiType, out_len: *i32) -> *u8
    var s: *u8 = null
    var n: i32 = 0
    if t.kind == TypeKind.Struct or (t.kind == TypeKind.Array and t.name != null)
        *out_len = t.name_len
        return t.name
    if gi_is_ptr_kind(t.kind) == 1
        if t.pointee == TypeKind.Struct
            s = t.name
            n = t.name_len
        else
            n = primitive_arg_spelling(t.pointee, @s)
        if s == null or n <= 0
            *out_len = 0
            return null
        let buf: *u8 = malloc((n + 5) as i64)
        memcpy(buf, c"ptr_", 4)
        memcpy(buf + 4, s, n as i64)
        *(buf + 4 + n) = 0
        *out_len = n + 4
        return buf
    n = primitive_arg_spelling(t.kind, @s)
    *out_len = n
    if n <= 0
        return null
    s

# ----------------------------------------------------------------------------
# Binding: one slot per type param of the callee.
# ----------------------------------------------------------------------------
struct GiBind
    names: **u8      # bound spelling, null when unbound
    lens: *i32
    conflict: *i32   # 1 when two arguments bound it differently
    lit: *i32        # 1 when an integer literal would bind it (to i64)

fn gi_bind(b: *GiBind, idx: i32, s: *u8, n: i32)
    if s == null or n <= 0
        return
    let prev: *u8 = *(b.names + idx)
    if prev == null
        *(b.names + idx) = s
        *(b.lens + idx) = n
        return
    let pl: i32 = *(b.lens + idx)
    if pl != n or memcmp(prev, s, n as i64) != 0
        *(b.conflict + idx) = 1

# Match one `$`-component of a param type name, `_`-piece by `_`-piece
# (`ptr_A`, `arr2_A`, `ptr_ptr_A`), against the argument from `ai` (#3516).
# A param piece takes one argument piece, or the whole mangled argument when
# it is the component's last (`ptr_Vec$u8` binds A = `Vec$u8`).  Other pieces
# match exactly, so a component naming no param is a plain comparison.  Like
# gi_match_mangled, it binds as it goes.  The argument end, or -1 for no match.
fn gi_match_pieces(ctx: *ParseCtx, m: *Module, tps: *TypeParam, p_sv: StrView, a_sv: StrView, ai: i32, b: *GiBind) -> i32
    var p: *u8 = p_sv.ptr
    var plen: i32 = p_sv.len as i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var pi: i32 = 0
    var x: i32 = ai
    while pi < plen
        var pe: i32 = pi
        while pe < plen and *(p + pe) != '_'   # '_'
            pe = pe + 1
        let idx: i32 = type_param_index(tps, StrView { ptr: (p + pi), len: (pe - pi) as i64 })
        var xe: i32 = x
        if idx >= 0 and pe == plen
            xe = mangled_arg_end(ctx, m, StrView { ptr: (a), len: (alen) as i64 }, x)
        else
            while xe < alen and *(a + xe) != '_' and *(a + xe) != '$'   # '_' '$'
                xe = xe + 1
        if idx >= 0
            gi_bind(b, idx, a + x, xe - x)   # an empty piece binds nothing
        else if xe - x != pe - pi or memcmp(p + pi, a + x, (pe - pi) as i64) != 0
            return -1
        x = xe
        if pe < plen
            if x >= alen or *(a + x) != '_'
                return -1
            x = x + 1
        pi = pe + 1
    if x < alen and *(a + x) != '$'
        return -1
    x

# Match a mangled param type name (`Vec$T`, `Pair$T$U`) against an
# argument's (`Vec$u64`), component by component: a type param's component
# takes one whole mangled argument (`Vec$u8` in `Vec$Vec$u8`), and any other
# binds what its `_`-pieces name (`Box2$ptr_A` against `Box2$ptr_u8`).
fn gi_match_mangled(ctx: *ParseCtx, m: *Module, tps: *TypeParam, p_sv: StrView, a_sv: StrView, b: *GiBind)
    var p: *u8 = p_sv.ptr
    var plen: i32 = p_sv.len as i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var pi: i32 = 0
    var ai: i32 = 0
    while pi < plen
        if ai >= alen
            return
        var pe: i32 = pi
        while pe < plen and *(p + pe) != '$'   # '$'
            pe = pe + 1
        let idx: i32 = type_param_index(tps, StrView { ptr: (p + pi), len: (pe - pi) as i64 })
        var ae: i32 = ai
        if idx >= 0
            ae = mangled_arg_end(ctx, m, StrView { ptr: (a), len: (alen) as i64 }, ai)
            gi_bind(b, idx, a + ai, ae - ai)
        else
            ae = gi_match_pieces(ctx, m, tps, StrView { ptr: (p + pi), len: (pe - pi) as i64 }, StrView { ptr: (a), len: (alen) as i64 }, ai, b)
            if ae < 0
                return
        pi = pe + 1
        ai = ae + 1

# A param written `pname` (a struct-ish name: `T`, `Vec$T`) against an
# argument of type t.
fn gi_unify_named(ctx: *ParseCtx, m: *Module, tps: *TypeParam, pname_sv: StrView, t: *GiType, b: *GiBind)
    var pname: *u8 = pname_sv.ptr
    var plen: i32 = pname_sv.len as i32
    let idx: i32 = type_param_index(tps, StrView { ptr: (pname), len: (plen) as i64 })
    if idx >= 0
        var n: i32 = 0
        let s: *u8 = gi_spell(t, @n)
        gi_bind(b, idx, s, n)
        return
    if t.kind == TypeKind.Struct
        gi_match_mangled(ctx, m, tps, StrView { ptr: (pname), len: (plen) as i64 }, StrView { ptr: (t.name), len: (t.name_len) as i64 }, b)

fn gi_unify_param(ctx: *ParseCtx, m: *Module, tps: *TypeParam, p: *Param, t: *GiType, b: *GiBind)
    let pk: TypeKind = p.param_type
    if p.param_type_name == null or p.param_type_name_len <= 0
        return
    # `x:& T` takes T's value; its argument is the referent itself.
    if p.is_borrow == 1 or pk == TypeKind.Struct
        if p.is_borrow == 1 and p.param_pointee_type != TypeKind.Struct
            return
        gi_unify_named(ctx, m, tps, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, t, b)
        return
    if gi_is_ptr_kind(pk) == 1 and p.param_pointee_type == TypeKind.Struct and gi_is_ptr_kind(t.kind) == 1
        var inner: GiType
        if t.pointee == TypeKind.Struct
            gi_set(@inner, TypeKind.Struct, StrView { ptr: (t.name), len: (t.name_len) as i64 }, TypeKind.Void)
        else
            gi_set(@inner, t.pointee, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        gi_unify_named(ctx, m, tps, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, @inner, b)

# 1 when `p` is a bare `T` (or `x:& T`) of the callee: what a literal binds.
fn gi_bare_param_index(tps: *TypeParam, p: *Param) -> i32
    if p.param_type_name == null
        return -1
    if p.param_type == TypeKind.Struct or (p.is_borrow == 1 and p.param_pointee_type == TypeKind.Struct)
        return type_param_index(tps, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    -1

fn gi_eprint_n(s: *u8, n: i32)
    for i in 0..n
        eprint_char(*(s + i))

fn gi_error(e: *Expr, tp: *TypeParam, fname_sv: StrView)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    diag_error_at(g_gi_file, e.span)
    eprints_cstr(c"can't infer `")
    gi_eprint_n(tp.name, tp.name_len)
    eprints_cstr(c"` for `")
    gi_eprint_n(fname, flen)
    eprints_cstr(c"`: write `")
    gi_eprint_n(fname, flen)
    eprint_char('<')
    gi_eprint_n(tp.name, tp.name_len)
    eprints_cstr(c">(...)`\n")
    g_gi_errors = g_gi_errors + 1

# AGAST #3986, #4159: an array-literal call argument, `put([a, b])` or `heap
# [a, b]` (`__heap_new([a, b])`), binds T to the `[N]E` ritz0's type checker
# gives the literal: N its length, E its first element's type (`[x, 5]` with
# an i32 x is `[2]i32`; `[5, x]` is `[2]i64`).  1 and *out set, or 0: for
# `[]`, which ritz0 can't type either.  AGAST #4178: a nested literal's
# first element types by this same rule, so `[ [1, 2], [3, 4] ]` is
# `[2][2]i64`, as ritz0's ArrayLit rule recurses.
fn gi_array_lit_type(mono: *MonoCtx, m: *Module, arg: *Expr, out: *GiType) -> i32
    if arg == null or arg.kind != ExprKind.ArrayLit or arg.args == null
        return 0
    var n: i32 = 0
    var it: *Expr = arg.args
    while it != null
        n = n + 1
        it = it.next
    var el: GiType
    if gi_type_of(mono, m, arg.args, @el) == 0 and gi_array_lit_type(mono, m, arg.args, @el) == 0
        return 0
    gi_array_spell(n, el.kind, StrView { ptr: (el.name), len: (el.name_len) as i64 }, el.pointee, out)

fn gi_infer_call(mono: *MonoCtx, m: *Module, e: *Expr)
    if e.call_type_suffix_len > 0
        return
    let f: *FnDef = find_generic_function(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if f == null or gi_find_local(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) >= 0
        return
    let n: i32 = count_type_params(f.type_params)
    var b: GiBind
    b.names = malloc((n as i64) * 8) as **u8
    b.lens = malloc((n as i64) * 4) as *i32
    b.conflict = malloc((n as i64) * 4) as *i32
    b.lit = malloc((n as i64) * 4) as *i32
    for i in 0..n
        *(b.names + i) = null
        *(b.lens + i) = 0
        *(b.conflict + i) = 0
        *(b.lit + i) = 0
    var p: *Param = f.params
    var arg: *Expr = e.args
    while p != null and arg != null
        if gi_is_int_literal(arg) == 1
            let li: i32 = gi_bare_param_index(f.type_params, p)
            if li >= 0
                *(b.lit + li) = 1
        else
            var t: GiType
            if gi_type_of(mono, m, arg, @t) == 1 or gi_array_lit_type(mono, m, arg, @t) == 1
                gi_unify_param(mono.pctx, m, f.type_params, p, @t, @b)
        p = p.next
        arg = arg.next
    # The suffix: "$" and each binding, in the callee's param order.
    var total: i32 = 0
    var tp: *TypeParam = f.type_params
    var i: i32 = 0
    var failed: i32 = 0
    while tp != null
        if *(b.names + i) == null and *(b.lit + i) == 1
            *(b.names + i) = c"i64"
            *(b.lens + i) = 3
        if *(b.names + i) == null or *(b.conflict + i) == 1
            if failed == 0
                gi_error(e, tp, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
            failed = 1
        total = total + 1 + *(b.lens + i)
        tp = tp.next
        i = i + 1
    if failed == 0
        let buf: *u8 = malloc((total + 1) as i64)
        var pos: i32 = 0
        for j in 0..n
            *(buf + pos) = 36   # '$'
            memcpy(buf + pos + 1, *(b.names + j), *(b.lens + j) as i64)
            pos = pos + 1 + *(b.lens + j)
        *(buf + pos) = 0
        e.call_type_suffix = buf
        e.call_type_suffix_len = pos
        # A failed trait bound on an inferred argument is at the call (AGAST #3469).
        generic_use_note(mono.pctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (buf), len: (pos) as i64 }, null, e.span, g_gi_file)
    free(b.names as *u8)
    free(b.lens as *u8)
    free(b.conflict as *u8)
    free(b.lit as *u8)

# ----------------------------------------------------------------------------
# The walk: statements in order, a let's value before its name is typed, a
# call's arguments before the call.
# ----------------------------------------------------------------------------
fn gi_walk_stmts(mono: *MonoCtx, m: *Module, s: *Stmt)
    var cur: *Stmt = s
    while cur != null
        gi_walk_stmt(mono, m, cur)
        cur = cur.next

fn gi_walk_arms(mono: *MonoCtx, m: *Module, arms: *MatchArm)
    var arm: *MatchArm = arms
    while arm != null
        gi_walk_stmts(mono, m, arm.body_stmts)
        gi_walk_expr(mono, m, arm.body)
        arm = arm.next

fn gi_note_decl(mono: *MonoCtx, m: *Module, s: *Stmt)
    var t: GiType
    if s.var_declared_type != TypeKind.Void
        if s.var_type == TypeKind.Struct and s.var_type_name == null
            return
        if s.var_type == TypeKind.Array
            # A 1-D `var a: [N]E`; `[N][M]E` spells as no type argument, so
            # binds nothing (TypeKind.Void), but `a` is still a local.
            gi_set(@t, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
            if s.var_array_shape == null
                gi_array_spell(s.var_array_size, s.var_array_elem_type, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, s.var_array_elem_pointee, @t)
            gi_add_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, @t)
            return
        gi_set(@t, s.var_type, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, s.var_pointee_type)
        gi_add_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, @t)
    else if gi_type_of(mono, m, s.var_init, @t) == 1
        gi_add_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, @t)

# ----------------------------------------------------------------------------
# AGAST #2927: an untyped `let s = Full(5)` / `var s = Empty`, `Full` a variant
# of a generic `enum Slot<T>` that no other enum declares.  No slot names the
# instance, so ritz1 lowered it to a call to an undefined `@Full`.  The let is
# typed here, before monomorph records the instances lets name, as if written
# `let s: Slot<i64> = Full(5)`: the fn's return type when it is an instance of
# that enum (as #2430 has it for `Some(5)`), else the instance the payload
# binds by the section 4.4 rule above.  A type param the payload leaves
# unbound (any of a unit variant's) is a located error.  Mirrors ritz0's
# Monomorphizer._infer_variant_let.
# ----------------------------------------------------------------------------
var g_gi_ret_name: *u8 = null   # the walked fn's return type, a struct's name
var g_gi_ret_len: i32 = 0

# 1 when a fn of the module is named `name`: it is called, not constructed.
fn gi_fn_named(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        if f.name_len == len and memcmp(f.name, name, len as i64) == 0
            return 1
        f = f.next
    0

fn gi_variant_error(e: *Expr, tp: *TypeParam, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    diag_error_at(g_gi_file, e.span)
    eprints_cstr(c"can't infer `")
    gi_eprint_n(tp.name, tp.name_len)
    eprints_cstr(c"` for `")
    gi_eprint_n(name, len)
    eprints_cstr(c"`: give the binding a type\n")
    g_gi_errors = g_gi_errors + 1

# A variant's payload field `f` against its argument `arg`: what it binds.
fn gi_unify_field(mono: *MonoCtx, m: *Module, tps: *TypeParam, f: *StructField, arg: *Expr, b: *GiBind)
    if f.field_type_name == null or f.field_type_name_len <= 0
        return
    if gi_is_int_literal(arg) == 1
        if f.field_type == TypeKind.Struct
            let li: i32 = type_param_index(tps, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            if li >= 0
                *(b.lit + li) = 1
        return
    var t: GiType
    if gi_type_of(mono, m, arg, @t) == 0
        return
    if f.field_type == TypeKind.Struct
        gi_unify_named(mono.pctx, m, tps, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @t, b)
    else if gi_is_ptr_kind(f.field_type) == 1 and f.ptr_pointee == TypeKind.Struct and gi_is_ptr_kind(t.kind) == 1
        var inner: GiType
        if t.pointee == TypeKind.Struct
            gi_set(@inner, TypeKind.Struct, StrView { ptr: (t.name), len: (t.name_len) as i64 }, TypeKind.Void)
        else
            gi_set(@inner, t.pointee, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        gi_unify_named(mono.pctx, m, tps, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @inner, b)

fn gi_type_variant_let(mono: *MonoCtx, m: *Module, s: *Stmt)
    let init: *Expr = s.var_init
    if s.var_declared_type != TypeKind.Void or init == null
        return
    var name: *u8 = null
    var len: i32 = 0
    var args: *Expr = null
    if init.kind == ExprKind.Call and init.call_type_suffix_len == 0
        name = init.func_name
        len = init.func_name_len
        args = init.args
    else if init.kind == ExprKind.Ident
        name = init.ident_ptr
        len = init.ident_len
    else
        return
    if name == null or gi_find_local(StrView { ptr: (name), len: (len) as i64 }) >= 0 or gi_fn_named(m, StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    var vi: i32 = 0
    let ei: i32 = generic_enum_of_variant(mono.pctx, StrView { ptr: (name), len: (len) as i64 }, @vi)
    if ei < 0
        return
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(mono.pctx, ei, @en_len)
    if en_len == 6 and (memcmp(en, c"Option", 6) == 0 or memcmp(en, c"Result", 6) == 0)
        return   # the builtin constructors' (#2430)
    var tname: *u8 = null
    var tlen: i32 = 0
    if g_gi_ret_len > en_len and memcmp(g_gi_ret_name, en, en_len as i64) == 0 and *(g_gi_ret_name + en_len) == '$'
        tname = g_gi_ret_name
        tlen = g_gi_ret_len
    else
        let tps: *TypeParam = generic_enum_params(mono.pctx, ei)
        let n: i32 = count_type_params(tps)
        if n == 0
            return
        var b: GiBind
        b.names = malloc((n as i64) * 8) as **u8
        b.lens = malloc((n as i64) * 4) as *i32
        b.conflict = malloc((n as i64) * 4) as *i32
        b.lit = malloc((n as i64) * 4) as *i32
        for i in 0..n
            *(b.names + i) = null
            *(b.lens + i) = 0
            *(b.conflict + i) = 0
            *(b.lit + i) = 0
        var f: *StructField = enum_variant_fields(mono.pctx, ei, vi)
        var arg: *Expr = args
        while f != null and arg != null
            gi_unify_field(mono, m, tps, f, arg, @b)
            f = f.next
            arg = arg.next
        # The name: the enum's, then "$" and each binding in param order.
        var total: i32 = en_len
        var tp: *TypeParam = tps
        var i: i32 = 0
        while tp != null
            if *(b.names + i) == null and *(b.lit + i) == 1
                *(b.names + i) = c"i64"
                *(b.lens + i) = 3
            if (*(b.names + i) == null or *(b.conflict + i) == 1) and tname == null
                gi_variant_error(init, tp, StrView { ptr: (name), len: (len) as i64 })
                tname = c""
            total = total + 1 + *(b.lens + i)
            tp = tp.next
            i = i + 1
        if tname == null
            let buf: *u8 = malloc((total + 1) as i64)
            memcpy(buf, en, en_len as i64)
            var pos: i32 = en_len
            for j in 0..n
                *(buf + pos) = 36   # '$'
                memcpy(buf + pos + 1, *(b.names + j), *(b.lens + j) as i64)
                pos = pos + 1 + *(b.lens + j)
            *(buf + pos) = 0
            tname = buf
            tlen = pos
        free(b.names as *u8)
        free(b.lens as *u8)
        free(b.conflict as *u8)
        free(b.lit as *u8)
    if tlen <= 0
        return   # refused
    s.var_declared_type = TypeKind.Struct
    s.var_type = TypeKind.Struct
    s.var_type_name = tname
    s.var_type_name_len = tlen

fn gi_walk_stmt(mono: *MonoCtx, m: *Module, s: *Stmt)
    let k: StmtKind = s.kind
    match k
        StmtKind.VarDecl =>
            if s.var_declared_type != TypeKind.Void and s.var_type == TypeKind.Struct
                gi_slot(mono.pctx, m, s.var_init, s.var_type_name, s.var_type_name_len)
            gi_walk_expr(mono, m, s.var_init)
            gi_type_variant_let(mono, m, s)
            gi_note_decl(mono, m, s)
        StmtKind.Expr =>
            gi_walk_expr(mono, m, s.expr)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.LocalFieldAssign =>
            gi_walk_expr(mono, m, s.assign_value)
        StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldIndexAssign =>
            gi_walk_expr(mono, m, s.while_cond)
            gi_walk_expr(mono, m, s.assign_value)
        StmtKind.If =>
            gi_walk_expr(mono, m, s.if_cond)
            gi_walk_stmts(mono, m, s.if_then)
            gi_walk_stmts(mono, m, s.if_else)
        StmtKind.While =>
            gi_walk_expr(mono, m, s.while_cond)
            gi_walk_stmts(mono, m, s.while_body)
        StmtKind.For =>
            gi_walk_expr(mono, m, s.for_start)
            gi_walk_expr(mono, m, s.for_end)
            gi_walk_stmts(mono, m, s.for_body)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            gi_walk_stmts(mono, m, s.while_body)
        StmtKind.Asm =>
            pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
        StmtKind.Return =>
            gi_slot(mono.pctx, m, s.return_value, g_gi_ret_name, g_gi_ret_len)
            gi_walk_expr(mono, m, s.return_value)
        StmtKind.Assert =>
            gi_walk_expr(mono, m, s.if_cond)
        StmtKind.TupleDecl =>
            gi_walk_expr(mono, m, s.var_init)
        StmtKind.Match =>
            gi_walk_expr(mono, m, s.if_cond)
            gi_walk_arms(mono, m, s.if_then as *MatchArm)
        _ => pass

# ----------------------------------------------------------------------------
# AGAST #3408 (LARB R51, LANGUAGE_SPEC section 9.2): a generic struct's literal
# may leave out its type args.  `Box2 { v: x }` for `struct Box2<X>` names no
# instance (`Box2<u8> { .. }` parses as the name `Box2$u8`), so this pass
# renames it to one before monomorph, as if spelled out:
#   1. The slot it fills decides: a typed let/var, a parameter (a plain fn's,
#      an explicit `f<..>(..)`'s, a plain impl's method's), a field, the fn's
#      return type (`return`, the tail, each branch of a tail if/match).  The
#      slot wins; a literal field value then takes the slot's type, as in the
#      spelled-out literal, and a value of another type is that field's error.
#      In an args-less literal or inferred generic call, a field or param
#      whose type names none of its params is a slot too (LARB R51a, #3431).
#   2. No slot (an untyped let): the field values bind the params by the
#      section 4.4 call rule above (an integer literal alone binds i64).  An
#      untyped let doesn't borrow the fn's return type.
#   3. A param neither binds, or two fields bind differently, is a located
#      error naming every param:
#        can't infer `X` for `Box2`: write its type arguments, `Box2<X> { .. }`
# Mirrors ritz0's _struct_lit_from_slot / _infer_struct_lit_args (#3407).
# #3311 refused every such literal.
# ----------------------------------------------------------------------------

# The generic struct an args-less literal `e` names, or null.
fn gi_argless_struct(ctx: *ParseCtx, m: *Module, e: *Expr) -> *StructDef
    if e == null or e.kind != ExprKind.StructLit or e.ident_ptr == null or e.ident_len <= 0
        return null
    if find_concrete_struct(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return null
    # A tuple over a generic parameter (`tuple_T_T`, #2975) is a template
    # struct the compiler names and substitutes itself, not a written literal.
    if tuple_reg_lookup(ctx, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return null
    find_generic_struct(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# Rule 1: `e`, or each branch it ends in, fills a slot of type (sn, sl), a
# mangled struct name.  An args-less literal of that struct's generic takes
# the slot's instance; a slot of another type leaves it to its fields.
fn gi_slot(ctx: *ParseCtx, m: *Module, e: *Expr, sn: *u8, sl: i32)
    if e == null or sn == null or sl <= 0
        return
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        gi_slot_arms(ctx, m, e.args as *MatchArm, sn, sl)
        return
    if gi_argless_struct(ctx, m, e) == null
        return
    let n: i32 = e.ident_len
    if sl <= n + 1 or memcmp(sn, e.ident_ptr, n as i64) != 0 or *(sn + n) != '$'   # '$'
        return
    let buf: *u8 = malloc((sl + 1) as i64)
    memcpy(buf, sn, sl as i64)
    *(buf + sl) = 0
    e.ident_ptr = buf
    e.ident_len = sl

fn gi_slot_arms(ctx: *ParseCtx, m: *Module, arms: *MatchArm, sn: *u8, sl: i32)
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0
            gi_slot(ctx, m, arm.body, sn, sl)
        arm = arm.next

# The last statement of a block is its value: a tail, or an if / match whose
# branches end in one.
fn gi_slot_block(ctx: *ParseCtx, m: *Module, stmts: *Stmt, sn: *u8, sl: i32)
    var last: *Stmt = stmts
    if last == null
        return
    while last.next != null
        last = last.next
    match last.kind
        StmtKind.Expr =>
            gi_slot(ctx, m, last.expr, sn, sl)
        StmtKind.If =>
            gi_slot_block(ctx, m, last.if_then, sn, sl)
            gi_slot_block(ctx, m, last.if_else, sn, sl)
        StmtKind.Match =>
            gi_slot_arms(ctx, m, last.if_then as *MatchArm, sn, sl)
        _ => pass

# Each by-value struct param of `params` is its argument's slot.  With
# `tps`, the callee is generic and (suffix, starts, lens) its written args;
# a null suffix, its args still inferred: only a param naming none of `tps`
# is a slot (LARB R51a, #3431).
fn gi_slot_args(mono: *MonoCtx, m: *Module, params: *Param, args: *Expr, tps: *TypeParam, suffix: *u8, starts: *i32, lens: *i32)
    var p: *Param = params
    var a: *Expr = args
    while p != null and a != null
        if p.param_type == TypeKind.Struct and p.is_borrow == 0 and p.param_type_name != null
            var pn: *u8 = p.param_type_name
            var pl: i32 = p.param_type_name_len
            if tps == null
                gi_slot(mono.pctx, m, a, pn, pl)
            else if suffix != null
                pn = substitute_params_in_mangled(mono, tps, suffix, starts, lens, StrView { ptr: (pn), len: (pl) as i64 }, @pl)
                gi_slot(mono.pctx, m, a, pn, pl)
            else if gi_names_type_param(tps, StrView { ptr: (pn), len: (pl) as i64 }) == 0
                gi_slot(mono.pctx, m, a, pn, pl)
        p = p.next
        a = a.next

# `f(args)`: a plain fn's params, or a generic's with its written args.  A
# generic call whose args are inferred gives only its fully-known params
# (LARB R51a): the rest come from the args.
fn gi_slot_call(mono: *MonoCtx, m: *Module, e: *Expr)
    if e.func_name == null or gi_find_local(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) >= 0
        return
    let f: *FnDef = find_fn_in_module(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if f == null
        return
    if f.type_params == null
        gi_slot_args(mono, m, f.params, e.args, null, null, null, null)
        return
    if e.call_type_suffix_len <= 0
        gi_slot_args(mono, m, f.params, e.args, f.type_params, null, null, null)
        return
    let cap: i32 = mangled_arg_capacity(StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 })
    let starts: *i32 = malloc((cap as i64) * 4) as *i32
    let lens: *i32 = malloc((cap as i64) * 4) as *i32
    if split_mangled_args(mono.pctx, m, StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 }, starts, lens) == count_type_params(f.type_params)
        gi_slot_args(mono, m, f.params, e.args, f.type_params, e.call_type_suffix, starts, lens)
    free(starts as *u8)
    free(lens as *u8)

# `recv.method(args)` on a plain impl: its params after `self`.
fn gi_slot_method(mono: *MonoCtx, m: *Module, e: *Expr)
    var rt: GiType
    if gi_type_of(mono, m, e.left, @rt) == 0
        return
    var rl: i32 = 0
    let rn: *u8 = gi_struct_of(@rt, @rl)
    if rn == null
        return
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_name_len == rl and memcmp(ib.type_name, rn, rl as i64) == 0
            var method: *FnDef = ib.methods
            while method != null
                if method.name_len == e.ident_len and memcmp(method.name, e.ident_ptr, e.ident_len as i64) == 0
                    let p: *Param = method.params
                    if p != null and p.name_len == 4 and memcmp(p.name, c"self", 4) == 0
                        gi_slot_args(mono, m, p.next, e.args, null, null, null, null)
                    return
                method = method.next
        ib = ib.next

# LARB R51a (#3431): 1 when the mangled type name (`Tag2$u8$A`, `Box2$ptr_A`,
# `Vec$tuple_A_B`) names any of `tps` in a component or a `_`-piece of one;
# 0 when it is fully known, so a slot while `tps` are still being inferred.
# Partly known counts as naming one.  A struct whose own name has a param as
# a `_`-piece (`My_A`) counts too: the safe way, no slot, as before R51a.
# Mirrors ritz0's _names_type_param (#3430).
fn gi_names_type_param(tps: *TypeParam, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if tps == null or name == null
        return 0
    var pos: i32 = 0
    while pos < len
        var end: i32 = pos
        while end < len and *(name + end) != '$' and *(name + end) != '_'   # '$' '_'
            end = end + 1
        if type_param_index(tps, StrView { ptr: (name + pos), len: (end - pos) as i64 }) >= 0
            return 1
        pos = end + 1
    0

fn gi_field_named(st: *StructDef, name_sv: StrView) -> *StructField
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *StructField = st.fields
    while f != null
        if f.name_len == len and memcmp(f.name, name, len as i64) == 0
            return f
        f = f.next
    null

# A literal whose struct is known gives each field value that field's type
# as its slot: `Outer { b: Box2 { v: 8 } }`, `Box2<Box2<u16>> { v: Box2 { v: 1 } }`.
# An args-less literal's args aren't known while its field values are walked,
# so only a field whose type names none of its params is a slot (LARB R51a,
# #3431): `W { a: 3, t: Tagged { n: 4 } }`, `t: Tagged<u8>`.  One naming a
# param (`t: Box2<A>`) is none: its value infers, then binds A.
fn gi_field_slots(mono: *MonoCtx, m: *Module, e: *Expr)
    if e.ident_ptr == null or e.ident_len <= 0
        return
    var st: *StructDef = find_concrete_struct(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    var tps: *TypeParam = null
    var suffix: *u8 = null
    var starts: *i32 = null
    var lens: *i32 = null
    if st == null
        var i: i32 = 0
        while i < e.ident_len and *(e.ident_ptr + i) != '$'   # '$'
            i = i + 1
        st = find_generic_struct(m, StrView { ptr: (e.ident_ptr), len: (i) as i64 })
        if st == null or st.type_params == null
            return
        tps = st.type_params
        if i < e.ident_len
            suffix = e.ident_ptr + i
            let sfl: i32 = e.ident_len - i
            let cap: i32 = mangled_arg_capacity(StrView { ptr: (suffix), len: (sfl) as i64 })
            starts = malloc((cap as i64) * 4) as *i32
            lens = malloc((cap as i64) * 4) as *i32
            if split_mangled_args(mono.pctx, m, StrView { ptr: (suffix), len: (sfl) as i64 }, starts, lens) != count_type_params(tps)
                free(starts as *u8)
                free(lens as *u8)
                return
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let f: *StructField = gi_field_named(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
        if f != null and f.field_type == TypeKind.Struct and f.field_type_name != null
            var fname: *u8 = f.field_type_name
            var flen: i32 = f.field_type_name_len
            if tps == null
                gi_slot(mono.pctx, m, fi.value, fname, flen)
            else if suffix != null
                fname = substitute_params_in_mangled(mono, tps, suffix, starts, lens, StrView { ptr: (fname), len: (flen) as i64 }, @flen)
                gi_slot(mono.pctx, m, fi.value, fname, flen)
            else if gi_names_type_param(tps, StrView { ptr: (fname), len: (flen) as i64 }) == 0
                gi_slot(mono.pctx, m, fi.value, fname, flen)
        fi = fi.next
    if starts != null
        free(starts as *u8)
        free(lens as *u8)

fn gi_struct_lit_error(e: *Expr, st: *StructDef, tp: *TypeParam)
    diag_error_at(g_gi_file, e.span)
    eprints_cstr(c"can't infer `")
    gi_eprint_n(tp.name, tp.name_len)
    eprints_cstr(c"` for `")
    gi_eprint_n(e.ident_ptr, e.ident_len)
    eprints_cstr(c"`: write its type arguments, `")
    gi_eprint_n(e.ident_ptr, e.ident_len)
    eprint_char('<')
    var p: *TypeParam = st.type_params
    while p != null
        gi_eprint_n(p.name, p.name_len)
        if p.next != null
            eprints_cstr(c", ")
        p = p.next
    eprints_cstr(c"> { .. }`\n")
    g_gi_errors = g_gi_errors + 1

# Rules 2 and 3: an args-less literal no slot named binds its params from
# its (already walked) field values.
fn gi_struct_lit_args(mono: *MonoCtx, m: *Module, e: *Expr, st: *StructDef)
    let tps: *TypeParam = st.type_params
    let n: i32 = count_type_params(tps)
    var b: GiBind
    b.names = malloc((n as i64) * 8) as **u8
    b.lens = malloc((n as i64) * 4) as *i32
    b.conflict = malloc((n as i64) * 4) as *i32
    b.lit = malloc((n as i64) * 4) as *i32
    for i in 0..n
        *(b.names + i) = null
        *(b.lens + i) = 0
        *(b.conflict + i) = 0
        *(b.lit + i) = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let f: *StructField = gi_field_named(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
        if f != null
            gi_unify_field(mono, m, tps, f, fi.value, @b)
        fi = fi.next
    # The name: the struct's, then "$" and each binding in param order.
    var total: i32 = e.ident_len
    var failed: i32 = 0
    var tp: *TypeParam = tps
    var i: i32 = 0
    while tp != null
        if *(b.names + i) == null and *(b.lit + i) == 1
            *(b.names + i) = c"i64"
            *(b.lens + i) = 3
        if (*(b.names + i) == null or *(b.conflict + i) == 1) and failed == 0
            gi_struct_lit_error(e, st, tp)
            failed = 1
        total = total + 1 + *(b.lens + i)
        tp = tp.next
        i = i + 1
    if failed == 0
        let buf: *u8 = malloc((total + 1) as i64)
        memcpy(buf, e.ident_ptr, e.ident_len as i64)
        var pos: i32 = e.ident_len
        for j in 0..n
            *(buf + pos) = 36   # '$'
            memcpy(buf + pos + 1, *(b.names + j), *(b.lens + j) as i64)
            pos = pos + 1 + *(b.lens + j)
        *(buf + pos) = 0
        e.ident_ptr = buf
        e.ident_len = pos
    free(b.names as *u8)
    free(b.lens as *u8)
    free(b.conflict as *u8)
    free(b.lit as *u8)

fn gi_walk_list(mono: *MonoCtx, m: *Module, list: *Expr)
    var cur: *Expr = list
    while cur != null
        gi_walk_expr(mono, m, cur)
        cur = cur.next

fn gi_walk_expr(mono: *MonoCtx, m: *Module, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Call =>
            gi_slot_call(mono, m, e)
            gi_walk_list(mono, m, e.args)
            gi_infer_call(mono, m, e)
        ExprKind.StructLit =>
            # A slot has renamed it by now if one could (#3408); its fields are
            # its values' slots, then walked, then bind what's still args-less.
            let st: *StructDef = gi_argless_struct(mono.pctx, m, e)
            gi_field_slots(mono, m, e)
            # The field inits are a *FieldInit list recast to *Expr.
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                gi_walk_expr(mono, m, fi.value)
                fi = fi.next
            if st != null
                gi_struct_lit_args(mono, m, e, st)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            gi_walk_expr(mono, m, e.left)
            gi_walk_expr(mono, m, e.right)
        ExprKind.Unary =>
            gi_walk_expr(mono, m, e.operand)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            gi_walk_expr(mono, m, e.left)
        ExprKind.Method =>
            gi_walk_expr(mono, m, e.left)
            gi_slot_method(mono, m, e)
            gi_walk_list(mono, m, e.args)
        ExprKind.ArrayLit =>
            gi_walk_list(mono, m, e.args)
        ExprKind.Match | ExprKind.If =>
            gi_walk_expr(mono, m, e.left)
            gi_walk_arms(mono, m, e.args as *MatchArm)
        _ => pass

fn gi_walk_fn(mono: *MonoCtx, m: *Module, f: *FnDef, impl_name_sv: StrView)
    var impl_name: *u8 = impl_name_sv.ptr
    var impl_len: i32 = impl_name_sv.len as i32
    g_gi_count = 0
    g_gi_ret_name = null
    g_gi_ret_len = 0
    if f.return_type == TypeKind.Struct and f.return_type_name != null
        g_gi_ret_name = f.return_type_name
        g_gi_ret_len = f.return_type_name_len
    g_gi_file = g_gi_input
    if f.def_file != null
        g_gi_file = f.def_file
    var p: *Param = f.params
    while p != null
        var t: GiType
        # Not typed, a param still shadows: gi_infer_call skips a call through it.
        gi_set(@t, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        if p.param_type == TypeKind.Array
            # AGAST #3277: a by-value `a: [N]E`.
            gi_array_spell(p.param_array_size, p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, p.param_array_elem_pointee, @t)
        else if p.is_self_borrow == 1 and p.param_type_name_len == 0
            gi_set(@t, TypeKind.Struct, StrView { ptr: (impl_name), len: (impl_len) as i64 }, TypeKind.Void)
        else if p.is_borrow == 1 and p.param_pointee_type == TypeKind.Struct
            gi_set(@t, TypeKind.Struct, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.Void)
        else if p.is_borrow == 1
            gi_set(@t, p.param_pointee_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void)
        else
            gi_set(@t, p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, p.param_pointee_type)
        gi_add_local(StrView { ptr: (p.name), len: (p.name_len) as i64 }, @t)
        p = p.next
    gi_slot_block(mono.pctx, m, f.body, g_gi_ret_name, g_gi_ret_len)   # the tail (#3408)
    gi_walk_stmts(mono, m, f.body)

# Fill in the type args of every `f(args)` call to a generic `f`.  Returns
# how many calls it refused (each already reported).
pub fn infer_generic_calls(mono: *MonoCtx, m: *Module, input_path: *u8) -> i32
    g_gi_input = input_path
    g_gi_errors = 0
    var f: *FnDef = m.functions
    while f != null
        gi_walk_fn(mono, m, f, StrView { ptr: (null), len: (0) as i64 })
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            gi_walk_fn(mono, m, method, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
            method = method.next
        ib = ib.next
    g_gi_errors
