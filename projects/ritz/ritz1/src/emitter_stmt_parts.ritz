# ritz1/src/emitter_stmt_parts.ritz - statement lowering that never recurses into a statement or expression: for-loop headers and element slots, if / match arm phi types, array and N-D row copies
#
# Split out by AGAST #1818: these never reach emit_expr / emit_stmt, so they
# sit below the emission modules, which import them.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory
import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import tokens_gen
import emitter_core
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import narrowing           # narrow_note_decl (AGAST #1364, #3505)
import ownership          # move check + drops (AGAST #2158)
import ref_check          # ref_view (AGAST #2338)
import bool_check   # AGAST #2342
import bool_kind
import sema_type    # name_is_indexable (AGAST #3510)
import emitter_asm   # emit_asm_block (AGAST #3395)
import tail_value   # tail_stmts_diverge (AGAST #3323)
import emitter_call_lower   # AGAST #1818: below the emission modules
import emitter_decl   # AGAST #1818: below the emission modules
import diag                 # diag_error_at (AGAST #3621)
import float_slot   # float_slot_unsigned (AGAST #3313, #4376)
import monomorph     # ArrayArg (AGAST #3029)
import mono_clone   # AGAST #1818: cloning moved out of monomorph
import binder_check
import text_bridge   # StrView views of the older *u8 text APIs (AGAST #4696)
import ritzlib.strview
import ritzlib.string

# AGAST #2960: the struct a `ptr`-valued if / match arm points at, or
# no_name(): `@&x` with x a struct (or `:&` struct) local, `@&a.b` a struct
# field, an `@&S` local, or a nested if / match all of whose value arms name
# one S.
fn ptr_arm_struct(s: *EmitterState, e: *Expr) -> StrView
    if e == null
        return no_name()
    match e.kind
        ExprKind.If | ExprKind.Match =>
            return ptr_arms_struct(s, e.args as *MatchArm)
        ExprKind.Ident =>
            let rl: *LocalVar = find_local_struct_name(s, e.ident)
            if rl == null or lv_var_type(rl) != TypeKind.MutRef or lv_pointee_type(rl) != TypeKind.Struct
                return no_name()
            return local_type_name(rl)
        ExprKind.Unary =>
            if e.op == OpKind.AddrMut and e.operand != null
                return addr_mut_struct(s, e.operand)
        _ => pass
    no_name()

# The struct `@&o` points at: a struct local (or a `:&` one) or a struct field.
fn addr_mut_struct(s: *EmitterState, o: *Expr) -> StrView
    match o.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, o.ident)
            if loc == null
                return no_name()
            if lv_var_type(loc) != TypeKind.Struct and lent_struct_local(s, o) == null
                return no_name()
            return local_type_name(loc)
        ExprKind.Member =>
            let f: *StructField = resolve_member_chain_field(s, o)
            if f == null or f.field_type != TypeKind.Struct
                return no_name()
            return named_or_none(f.field_type_name)
        _ => pass
    no_name()

# A local's type name; no_name() when it has none.
fn local_type_name(loc: *LocalVar) -> StrView
    named_or_none(lv_name(loc))

# `name`, or no_name() when it is empty.
fn named_or_none(name: StrView) -> StrView
    if name.len == 0
        return no_name()
    name

# AGAST #2960: the one struct every value arm of `arms` points at, or no_name().
fn ptr_arms_struct(s: *EmitterState, arms: *MatchArm) -> StrView
    var name: StrView = no_name()
    var a: *MatchArm = arms
    while a != null
        if a.is_pass == 0 and a.body != null
            let an: StrView = ptr_arm_struct(s, a.body)
            if unnamed(an) or (not unnamed(name) and name_eq(name, an) == 0)
                return no_name()
            name = an
        a = a.next
    name

# AGAST #2960: an un-annotated `let p = if … @&c else @&c` (or match) holds
# what `let p: @&C = …` does: an `@&C` slot, the `ptr` phi stored as is, so
# `p.x` reaches C.  Asked before the arms are emitted, in the let's scope, as
# arms_ptr_valued is.  It stayed an i64 with no name: `p.x = 3` was
# "unhandled EXPR_MEMBER".  Returns the struct's name, or no_name().
pub fn ptr_phi_let_struct(s: *EmitterState, init: *Expr) -> StrView
    if arms_ptr_valued(s, init.args as *MatchArm) == 0
        return no_name()
    ptr_arms_struct(s, init.args as *MatchArm)

# An i64 zero: a value for an init that was refused, so the let still binds.
pub fn emit_zero_i64(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0\n")
    z

# AGAST #2097: the ArrayShape of `var.field` for a StmtKind.LocalFieldIndexAssign
# `var.field[i] = v`, null when the field is not multi-dimensional.
pub fn local_field_nd_shape(s: *EmitterState, stmt: *Stmt) -> *ArrayShape
    var base: Expr
    base.kind = ExprKind.Ident
    base.ident = stmt.var_name
    var mem: Expr
    mem.kind = ExprKind.Member
    mem.left = @base
    mem.ident = stmt.assign_target
    nd_array_member_shape(s, @mem)

# AGAST #1946: when `e` is a match / if expression bound or returned at float
# type (`ty`, or a TypeKind.Struct named "f32" / "f64"), tell it to merge at that
# type so its phi, every arm and the slot / `ret` agree.  emit_match and
# emit_if_expr consume the hint on entry.
pub fn set_match_float_hint(s: *EmitterState, e: *Expr, ty: TypeKind, ty_name: StrView)
    s.fcx.match_float_hint = TypeKind.Void
    if e != null and (e.kind == ExprKind.Match or e.kind == ExprKind.If)
        s.fcx.match_float_hint = slot_float_type(ty, ty_name)

# TypeKind.F32 / TypeKind.F64 when a slot of type (ty, ty_name) is a float, else Void.
pub fn slot_float_type(ty: TypeKind, ty_name: StrView) -> TypeKind
    if ty == TypeKind.F32 or ty == TypeKind.F64
        return ty
    if ty_name.len == 3 and is_float_type(ty, ty_name) == 1
        if ty_name.get(1) == '3'   # "f32"
            return TypeKind.F32
        return TypeKind.F64
    TypeKind.Void

# AGAST #3205: the fn's tail statement is a match and the fn returns a struct
# or enum (`ret_type`, named s.fcx.ret_type_name): if no arm yields a value (every
# arm `return`s), the match's phi is typed as that, which the implicit `ret`
# names, not i64.  emit_match_arms consumes the hint.
pub fn set_match_agg_hint(s: *EmitterState, ret_type: TypeKind)
    if ret_type != TypeKind.Struct
        return
    s.fcx.match_agg_hint = s.fcx.ret_type_name

# AGAST #2388: a struct the iterable form walks through its header: a Vec<T>,
# a Span<T> or a StrView.  ritz0 takes any struct opening with a pointer and
# an integer; these are the ones that mean it.
fn is_for_header_name(name: StrView) -> bool
    if unnamed(name)
        return false
    if name.len > 4 and name.starts_with("Vec$")
        return true
    if name.len > 5 and name.starts_with("Span$")
        return true
    name_eq(name, "StrView") == 1

# find_struct, for a name that's a header.  Null for anything else, and for a
# header whose `data` and `len` aren't where the loop reads them.
pub fn for_header_struct(s: *EmitterState, name: StrView) -> *StructDef
    if not is_for_header_name(name)
        return null
    let st: *StructDef = find_struct(s, name)
    if st == null or st.fields == null or st.fields.next == null
        return null
    let data: *StructField = st.fields
    if data.field_type != TypeKind.Ptr and data.field_type != TypeKind.PtrPtr
        return null
    if data.next.field_type != TypeKind.I64
        return null
    st

# What a header's elements are, read off its `data` field as the monomorph left
# it: a struct T by name, a primitive T in array_elem_type, and `*T` as a `**`
# field.  True if that names the element; a type this can't name is refused
# rather than walked at a guessed stride, which `Vec<S>` was at 8 bytes.
pub fn for_header_elem(s: *EmitterState, st: *StructDef, out: *ForElem) -> bool
    let data: *StructField = st.fields
    let data_name: StrView = data.field_type_name
    if data.field_type == TypeKind.Ptr
        if data_name.len > 0
            # AGAST #2411: a non-generic user enum is a `%C` the loop walks at
            # its layout (#1797), bound as a struct element is.  AGAST #3647:
            # and an Option / Result instance (`%Option$i64`), at the layout
            # tagged_enum_layout gives it, as ptr_pointee_size strides it (#1578).
            if find_struct(s, data_name) == null and user_enum_index(s.sym.mono.pctx, data_name) < 0 and is_tagged_enum_type(data_name) == 0
                return false
            out.elem = TypeKind.Struct
            out.name = data.field_type_name
            return true
        if primitive_name_len(data.array_elem_type) == 0
            return false
        out.elem = data.array_elem_type
        return true
    # `Vec$ptr_Node` names Node, and `Vec$ptr_u8` nothing: its pointee is only
    # in the suffix.  `Vec$ptr_ptr_u8` names no struct there is, and is refused.
    out.elem = TypeKind.Ptr
    if data_name.len > 0
        if find_struct(s, data_name) == null
            return false
        out.pointee = TypeKind.Struct
        out.pointee_name = data.field_type_name
        return true
    let st_name: StrView = st.name
    let after: i64 = st_name.find_byte('$') + 5   # past `$ptr_`
    out.pointee = primitive_type_from_name(st_name.slice(after, st_name.len))
    true

# The LLVM type of one element of a `for` iterable: `%S` for a struct element.
# emit_llvm_type spells that i64, which is neither its size nor its stride.
# The name goes through emit_name: this can follow `= getelementptr `, where a
# packed struct marks the GEP (AGAST #4462).
pub fn emit_for_elem_llvm(s: *EmitterState, elem: TypeKind, name: StrView)
    if elem == TypeKind.Struct and name.len > 0
        format_into(s, "%")
        emit_name(s, name)
    else
        format_into(s, "{ty_value_llvm(elem)}")

# AGAST #2388: a slot for the header value `val`, which has no place of its own:
# a call's result, a literal or a const.  Nothing else can write to it.  The alloca
# is static, so it is written into the fn's entry-block buffer, out of any enclosing loop.
pub fn emit_for_header_spill(s: *EmitterState, st: *StructDef, val: i32) -> i32
    let slot: i32 = next_reg(s)
    let st_name: StrView = st.name
    let st_ir: String = ir_name(st_name)
    entry_alloca_reg_begin_named(s, slot)
    format_into(s, "{st_ir.as_view()}\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, st_name, val, slot)
    slot

# The struct a call in iterable position returns by value.  `as_bytes` is only
# the builtin on a StrView: a user's method of that name is whatever it says.
pub fn for_call_struct_name(s: *EmitterState, e: *Expr) -> StrView
    let named: StrView = call_result_struct_name(s, e)
    if named.len > 0 or e.kind != ExprKind.Method or e.left == null or e.left.kind != ExprKind.Ident
        return named
    if name_eq(e.ident, "as_bytes") == 0
        return named
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident)
    if loc != null and name_eq(lv_name(loc), "StrView") == 1
        return "Span$u8"
    named

# AGAST #2410: the LLVM type of what the loop binds: an element, or a `[M x T]` row
# when `row` is M.  AGAST #3379: or the plane `[M x [N x ..T]]` when `plane`
# is non-null, spelled as the `[M][N]..T` local's alloca is.
pub fn emit_for_slot_llvm(s: *EmitterState, elem: TypeKind, name: StrView, row: i32, plane: *ArrayShape)
    if plane != null
        emit_array_shape_llvm(s, plane, 0)
    else if row > 0
        format_into(s, "[{row} x ")
        emit_for_elem_llvm(s, elem, name)
        format_into(s, "]")
    else
        emit_for_elem_llvm(s, elem, name)

# AGAST #2410: the array a `*[N]T` / `@[N]T` / `@&[N]T` local points at, read
# once: its N and T (and what a `*U` element points at) into `src`, and the
# array's address returned.  (`*[N][M]T` doesn't parse on ritz1.)
pub fn for_array_ptr(s: *EmitterState, loc: *LocalVar, src: *ForIterSrc) -> i32
    src.elem_type = lv_pointee_array_elem_type(loc)
    src.arr_size = lv_pointee_array_size(loc)
    let en: StrView = array_ptr_elem_name(loc)
    src.elem_name = en
    src.bind_pointee = elem_recorded_pointee(s, src.elem_type, lv_pointee_array_elem_pointee(loc), en, @src.bind_name)
    emit_load_ptr(s, loc.reg)

# AGAST #2533: whether the field `e` names is in a call's temporary, as `mk().a`
# and `mk().h.a` are with `h` by value.  ritz0 takes no address of one (#2518).
# AGAST #3207: a link through a pointer leaves the temporary, so `mk().p.a`
# with `p: *H` is the place `p` points at, as `mkp().a` is with `mkp() -> *H`.
# `mkp()[0].a` is a place too: an index stops the search.
pub fn member_in_call_temp(s: *EmitterState, e: *Expr) -> bool
    var m: *Expr = e
    while m != null and m.kind == ExprKind.Member and m.left != null
        let l: *Expr = m.left
        if l.kind == ExprKind.Call or l.kind == ExprKind.Method
            # By value only: a `*S` call's field is where the call points.
            return call_result_ptr_struct(s, l) == null
        if l.kind != ExprKind.Member
            return false
        # `m` reaches into the field `l` names.  A by-value struct is part of
        # whatever holds `l`: look further.  A pointer leads elsewhere.  A link
        # that won't resolve stays refused, as every call's field was.
        let lf: *StructField = resolve_member_chain_field(s, l)
        if lf == null
            return true
        if lf.field_type == TypeKind.Ptr or lf.field_type == TypeKind.Ref or lf.field_type == TypeKind.MutRef
            return false
        m = l
    false

# What a `for x in <iterable>` walks, as for_iter_resolve found it: the
# iterable's kind and storage, the element's type, and the binding's.
# Where a `for` iterable's elements are.
enum ForIterKind
    Unsupported   # not an iterable ritz1 lowers
    ArrayReg      # an array whose address is in `data_reg`
    HeaderReg     # a Vec / Span / StrView header whose address is in `data_reg`
    ArraySym      # a const or global array, at its symbol

struct ForIterSrc
    iter_kind: ForIterKind
    elem_type: TypeKind
    arr_size: i32
    data_reg: i32
    type_name: StrView
    const_name: StrView
    bind_pointee: TypeKind
    bind_name: StrView
    elem_name: StrView
    row_size: i32
    plane: *ArrayShape

# `for x in a` / `in @a` with `a` named: a local, const or global array (or a
# Vec / Span local) into `src`.  Returns the iterable's N-D shape, or `nd_in`.
pub fn for_iter_ident(s: *EmitterState, src: *ForIterSrc, iter: *Expr, arr_ident: *Expr, via_addr: bool, nd_in: *ArrayShape) -> *ArrayShape
    let name: StrView = arr_ident.ident
    let loc: *LocalVar = find_local_struct_name(s, name)
    if loc != null
        if lv_var_type(loc) == TypeKind.Array
            src.iter_kind = ForIterKind.ArrayReg
            src.data_reg = loc.reg
            if lv_array_shape(loc) != null
                # AGAST #1509: a multi-dimensional array yields rows.  It
                # used to GEP the alloca as `[N x i64]` and load garbage.
                return lv_array_shape(loc)
            src.elem_type = lv_array_elem_type(loc)
            src.arr_size = lv_array_size(loc)
            src.elem_name = lv_name(loc)
            src.bind_pointee = elem_recorded_pointee(s, src.elem_type, lv_array_elem_pointee(loc), elem_name_of(src), @src.bind_name)
        else if not via_addr and array_ptr_named(s, name) != null
            # AGAST #2410: `a: *[N]T` / `@[N]T` / `@&[N]T` walks the array
            # it points at.
            src.data_reg = for_array_ptr(s, loc, src)
            src.iter_kind = ForIterKind.ArrayReg
        return nd_in
    # Iter is not a local — try a module const array
    # (`const VALUES: [3]i32 = [2,3,5]`).  emit_const_array_entry
    # emits `@VALUES = internal constant [3 x i32] [...]`; we GEP
    # off the global symbol below.
    let centry: *ConstEntry = find_const_entry(s, name)
    if centry != null and centry.const_type == TypeKind.Array and (not via_addr or iter.op == OpKind.Addr)
        src.iter_kind = ForIterKind.ArraySym
        src.elem_type = centry.array_elem_type
        src.arr_size = centry.array_size
        src.const_name = centry.name
        src.elem_name = centry.array_elem_type_name
        # AGAST #1866: `for p in T` over a `[N]*u8` table binds a `*u8`.
        src.bind_pointee = elem_recorded_pointee(s, src.elem_type, centry.array_elem_pointee, elem_name_of(src), @src.bind_name)
        return nd_in
    let glob: *GlobalVarDef = find_global(s, name)
    if glob == null or glob.var_type != TypeKind.Array
        return nd_in
    src.iter_kind = ForIterKind.ArraySym
    src.const_name = glob.name
    if glob.array_shape != null
        return glob.array_shape
    src.elem_type = glob.array_elem_type
    src.arr_size = glob.array_size
    src.elem_name = glob.array_elem_type_name
    src.bind_pointee = elem_recorded_pointee(s, src.elem_type, glob.array_elem_pointee, elem_name_of(src), @src.bind_name)
    nd_in

# The element type name `src` holds.
fn elem_name_of(src: *ForIterSrc) -> StrView
    src.elem_name

# GEP `elem_ptr` to element `idx` of what `src` walks: through a Vec / Span /
# StrView header's data pointer, or into the array (in a reg or at a symbol).
pub fn emit_for_elem_ptr(s: *EmitterState, src: *ForIterSrc, elem_ptr: i32, idx: i32)
    if src.iter_kind == ForIterKind.HeaderReg
        # `data` is field 0 and `len` field 1, as for_header_struct checked.
        let data_ptr_ptr: i32 = next_reg(s)
        gep_struct_open(s, data_ptr_ptr, src.type_name)
        format_into(s, ", ptr %.{src.data_reg}, i32 0, i32 0\n")
        let data_ptr: i32 = next_reg(s)
        format_into(s, "  %.{data_ptr} = load ptr, ptr %.{data_ptr_ptr}\n")
        format_into(s, "  %.{elem_ptr} = getelementptr ")
        emit_for_elem_llvm(s, src.elem_type, elem_name_of(src))
        format_into(s, ", ptr %.{data_ptr}, i64 %.{idx}\n")
        return
    format_into(s, "  %.{elem_ptr} = getelementptr [{src.arr_size} x ")
    emit_for_slot_llvm(s, src.elem_type, elem_name_of(src), src.row_size, src.plane)
    format_into(s, "], ptr ")
    # A local array or a field is an SSA reg; a const or global
    # array is its symbol.
    if src.iter_kind == ForIterKind.ArraySym
        let sym: String = ir_name(src.const_name)
        format_into(s, "@{sym.as_view()}")
    else
        format_into(s, "%.{src.data_reg}")
    format_into(s, ", i64 0, i64 %.{idx}\n")

# Emit the LLVM type `[N x T]` of inline array field `field`.
pub fn emit_array_field_llvm_type(s: *EmitterState, field: *StructField)
    format_into(s, "[{field.array_size} x ")
    if field.array_elem_type == TypeKind.Struct and field.array_elem_type_name.len > 0
        let elem_ir: String = ir_name(field.array_elem_type_name)
        format_into(s, "%{elem_ir.as_view()}]")
        return
    format_into(s, "{elem_mem_llvm(field.array_elem_type)}]")

# `  call void @__ritz_sret_copy(ptr dst, ptr src, i64 ptrtoint (ptr getelementptr (`:
# the start of a pointer-to-pointer copy, left open for the caller's type and
# then sret_copy_close.
fn sret_copy_open(s: *EmitterState, dst_ptr: i32, src_ptr: i32)
    format_into(s, "  call void @__ritz_sret_copy(ptr %.{dst_ptr}, ptr %.{src_ptr}, i64 ptrtoint (ptr getelementptr (")

fn sret_copy_close(s: *EmitterState)
    format_into(s, ", ptr null, i32 1) to i64))\n")
    s.ir.sret_helpers_used = 1

# Copy `[N x T]` (spelled for `field`) from `src_ptr` over `dst_ptr` as one
# aggregate load + store: every element is read before any is written.
# AGAST #1748: an array of SRET_MIN_BYTES or more is copied pointer-to-
# pointer, as emit_local_array_copy does (#2306): clang -O2 splits a large
# first-class `[N x T]` load/store into one scalar per element. The two
# arrays are distinct or the same, never partially overlapping.
pub fn emit_array_field_copy(s: *EmitterState, field: *StructField, src_ptr: i32, dst_ptr: i32)
    var align: i64 = 8
    let et_name: StrView = field.array_elem_type_name
    if elem_size_align(s, field.array_elem_type, et_name, @align) * (field.array_size as i64) >= SRET_MIN_BYTES
        sret_copy_open(s, dst_ptr, src_ptr)
        emit_array_field_llvm_type(s, field)
        sret_copy_close(s)
        return
    let agg: i32 = next_reg(s)
    format_into(s, "  %.{agg} = load ")
    emit_array_field_llvm_type(s, field)
    format_into(s, ", ptr %.{src_ptr}\n")
    format_into(s, "  store ")
    emit_array_field_llvm_type(s, field)
    format_into(s, " %.{agg}, ptr %.{dst_ptr}\n")

# The address of the array behind array_ptr_local's `loc`.
pub fn emit_array_ptr_base(s: *EmitterState, loc: *LocalVar) -> i32
    if lv_var_type(loc) == TypeKind.Array
        return loc.reg
    emit_load_ptr(s, loc.reg)

# True when `*e` is a whole `[N]T` (array_ptr_shape), which isn't a value on its own.
pub fn deref_names_array(s: *EmitterState, e: *Expr) -> bool
    var sh: ArraySrc
    array_ptr_shape(s, e, @sh) == 1

# AGAST #2517: fill `out` when `value` is a 1-D row of an N-D array (nd_row_shape:
# `g[i]` of `[N][M]T`, `c[i][j]` of `[N][M][K]T`).  The base is any
# nd_index_shape knows: a local, a global, a field, or a field of a call's
# result, by value or through `*S`.  Emits nothing; emit_nd_index_ptr finds it.
pub fn nd_row_src(s: *EmitterState, value: *Expr, out: *ArraySrc) -> bool
    if value.kind != ExprKind.Index or value.right == null or value.right.kind == ExprKind.Range
        return false
    let sh: *ArrayShape = nd_row_shape(s, value)
    if sh == null
        return false
    array_src_set(out, sh.dims[sh.rank - 1], sh.leaf_type, sh.leaf_name)
    true

# The address of global array `g`, in a register.
pub fn emit_global_array_ptr(s: *EmitterState, g: *GlobalVarDef) -> i32
    let ptr: i32 = next_reg(s)
    let sym: String = ir_name(g.name)
    format_into(s, "  %.{ptr} = getelementptr i8, ptr @{sym.as_view()}, i64 0\n")
    ptr

# True when two N-D shapes are the same type: rank, every dim and the leaf.
pub fn array_shapes_match(a: *ArrayShape, b: *ArrayShape) -> bool
    if a.rank != b.rank or a.leaf_pointee != b.leaf_pointee
        return false
    for d in 0..a.rank
        if a.dims[d] != b.dims[d]
            return false
    let a_leaf: StrView = a.leaf_name
    let b_leaf: StrView = b.leaf_name
    array_elem_types_match(a.leaf_type, a_leaf, b.leaf_type, b_leaf) == 1

# Copy the dimension-`from` plane of `sh` (the whole array at 0) from
# `src_ptr` over `dst_ptr`: one aggregate load + store, or pointer-to-pointer
# when large (as emit_local_array_copy).
pub fn emit_nd_plane_copy(s: *EmitterState, sh: *ArrayShape, from: i32, dst_ptr: i32, src_ptr: i32)
    var leaves: i64 = 1
    for d in from..sh.rank
        leaves = leaves * (sh.dims[d] as i64)
    var align: i64 = 8
    if elem_size_align(s, sh.leaf_type, sh.leaf_name, @align) * leaves >= SRET_MIN_BYTES
        sret_copy_open(s, dst_ptr, src_ptr)
        emit_array_shape_llvm(s, sh, from)
        sret_copy_close(s)
        return
    let agg: i32 = next_reg(s)
    format_into(s, "  %.{agg} = load ")
    emit_array_shape_llvm(s, sh, from)
    format_into(s, ", ptr %.{src_ptr}\n")
    format_into(s, "  store ")
    emit_array_shape_llvm(s, sh, from)
    format_into(s, " %.{agg}, ptr %.{dst_ptr}\n")

# The address of row `idx` of the dimension-`d` plane of `sh` at `ptr`.
pub fn emit_nd_row_gep(s: *EmitterState, sh: *ArrayShape, d: i32, ptr: i32, idx: i32) -> i32
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = getelementptr ")
    emit_array_shape_llvm(s, sh, d)
    format_into(s, ", ptr %.{ptr}, i64 0, i64 {idx}\n")
    r

# The number of elements an array literal `[a, b, ..]` lists.
pub fn array_lit_count(e: *Expr) -> i32
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        n = n + 1
        it = it.next
    n

# AGAST #2048: `x.f = v` / `pp.f = v` / `o.p.f = v` where `f` is an f32 /
# f64 field at `field_ptr` and `val_reg` is emit_expr(value).  Stores
# `float` / `double` (an f64 value into an f32 field is fptrunc'd by
# emit_field_elem_narrow, as struct-literal init does) and returns true;
# returns false for any other field type.  Both field-assign paths fell to
# `store i64` here, which clang rejects.
pub fn emit_float_field_store(s: *EmitterState, field_ptr: i32, field_ty: TypeKind, val_reg: i32, value: *Expr) -> bool
    if field_ty != TypeKind.F32 and field_ty != TypeKind.F64
        return false
    let fval: i32 = emit_field_elem_narrow(s, val_reg, field_ty, value)
    let fty: StrView = if field_ty == TypeKind.F32 then "float" else "double"
    format_into(s, "  store {fty} %.{fval}, ptr %.{field_ptr}\n")
    true

# AGAST #1814: `x.f[i] = v` where `f` is an inline `[N]T` array field at
# `field_ptr`. GEP the element at the field's DECLARED element type
# (field_array_elem_llvm, ritz0's layout) and store `val` at that width.
# Shared by both member-index store paths, which used to carry their own
# i8/i32/i64/ptr ladders and stored u16/u32/bool elements as 8-byte i64.
# `place` is the array field stored into (`h.a` of `h.a[i] = v`), whose old
# element is dropped when a binding owns it (own_drop_old_elem, AGAST #3377).
pub fn emit_field_array_elem_store(s: *EmitterState, field_ptr: i32, field: *StructField, idx: i32, val: i32, val_expr: *Expr, place: *Expr)
    let et: TypeKind = field.array_elem_type
    let et_name: StrView = field.array_elem_type_name
    let is_struct: bool = et == TypeKind.Struct and et_name.len > 0
    let elem_ptr: i32 = next_reg(s)
    format_into(s, "  %.{elem_ptr} = getelementptr [{field.array_size} x ")
    if is_struct
        # AGAST #188: struct-array LHS — `[N x %T]` so the GEP and the store
        # agree with the struct value being stored.
        emit_llvm_type_struct(s, TypeKind.Struct, et_name)
    else
        format_into(s, "{elem_mem_llvm(et)}")
    format_into(s, "], ptr %.{field_ptr}, i64 0, i64 %.{idx}\n")
    if is_struct
        own_drop_old_elem(s, place, elem_ptr, et_name)
        # AGAST #188: `store %T %val` matches the `load %T` of the RHS.
        # AGAST #4461: an sret-sized struct copied from a held load becomes a
        # `@__ritz_sret_copy` call instead of a first-class store.
        emit_struct_store_or_copy(s, TypeKind.Struct, et_name, val, elem_ptr)
        return
    if et == TypeKind.Bool
        # A bool value is an i64 register (AGAST #1646): truncate it.
        let bit: i32 = next_reg(s)
        format_into(s, "  %.{bit} = trunc i64 %.{val} to i1\n")
        format_into(s, "  store i1 %.{bit}, ptr %.{elem_ptr}\n")
        return
    let mem: StrView = elem_mem_llvm(et)
    var sval: i32 = val
    if et == TypeKind.F32 or et == TypeKind.F64
        # AGAST #1954: `float` / `double` (field_array_elem_llvm), an f64
        # value into an f32 slot fptrunc'd, as #1973's `p[i] = v` does.
        # f32 failed closed; f64 stored `i64`, which only type-checked while
        # the `x.f[i]` read also bit-loaded an i64.
        sval = emit_field_elem_narrow(s, val, et, val_expr)
    else if (et != TypeKind.Ptr and et != TypeKind.PtrPtr) or expr_is_ptr_valued(s, val_expr) == 0
        # Integers / pointers at their own width (trunc / inttoptr); i64
        # elements store all 8 bytes.  AGAST #3170: `h.a[i] = @&x` into a
        # `[N]*T` field is a `ptr` already.
        sval = emit_array_elem_narrow(s, val, et, mem)
    format_into(s, "  store {mem} %.{sval}, ptr %.{elem_ptr}\n")

# AGAST #2559: the struct type of a statement-`if` arm's value, or no_name().
# The arm's last statement is its value: a trailing expression (a static
# call `B.new(..)` is typed by its callee), a `match` (emit_match published
# its phi type, #1666), or a nested statement `if` (an `else if` chain),
# which published its own.  Called right after the arm is emitted, so its
# `let`s are still in scope.
pub fn if_stmt_arm_agg(s: *EmitterState, list: *Stmt) -> StrView
    if list == null
        return no_name()
    let last: *Stmt = last_stmt(list)
    match last.kind
        StmtKind.If =>
            return s.fcx.last_if_stmt_agg_name
        StmtKind.Match =>
            return s.fcx.last_match_agg_name
        StmtKind.Expr =>
            if last.expr != null
                return expr_arm_agg(s, last.expr)
        _ => pass
    no_name()

# if_stmt_arm_agg for an arm whose value is the expression `e`.
fn expr_arm_agg(s: *EmitterState, e: *Expr) -> StrView
    let lent: *LocalVar = lent_referent_local(s, e)
    if lent != null   # AGAST #2288: emit_if_stmt_arm read the referent
        return lv_name(lent)
    var name: StrView = resolve_expr_struct_name(s, e)
    if unnamed(name)
        name = call_result_struct_name(s, e)
    if unnamed(name)
        name = span_assoc_arm_type(s, e)   # AGAST #4194
    # AGAST #2950: `*r` with `r: @C` / `@&C` / `*C` loads the %C.
    if unnamed(name) and e.kind == ExprKind.Unary and e.op == OpKind.Deref
        name = deref_pointee_struct_name(s, e.operand)
    name

# The last statement of the non-empty list `list`.
fn last_stmt(list: *Stmt) -> *Stmt
    var last: *Stmt = list
    while last.next != null
        last = last.next
    last

# AGAST #2950: a statement-`if` arm's `@&x` value `reg` (a `ptr`) as the i64
# its phi holds, asked while the arm's `let`s are in scope.  The phi was i64
# over `ptr`s; a tail one in a `-> @&C` fn is converted back at the `ret`
# (emit_implicit_return_tail).
pub fn if_stmt_arm_ptr_settle(s: *EmitterState, list: *Stmt, reg: i32, agg: StrView) -> i32
    if reg <= 0 or not unnamed(agg)
        return reg
    let last: *Stmt = last_stmt(list)
    if last.kind != StmtKind.Expr or arm_value_is_ptr(s, last.expr) == 0
        return reg
    ptr_value_to_i64(s, last.expr, reg)

# True if `st` is an `if` / `match`, as a statement or an expression statement.
pub fn stmt_is_if_or_match(st: *Stmt) -> bool
    if st.kind == StmtKind.If or st.kind == StmtKind.Match
        return true
    st.kind == StmtKind.Expr and st.expr != null and (st.expr.kind == ExprKind.If or st.expr.kind == ExprKind.Match)

# AGAST #3421: settle a statement-`if` arm's scalar value `reg` against the
# merge's float type `fr` in the arm's own block, before its `br`, as a match
# arm's is (LARB R43, §7.5: an integer arm converts in a float slot; one next
# to a float arm without one is Sema's refusal, AGAST #4933).  The arm's
# value is its last statement: an expression, or a nested `if` / `match`
# statement, whose phi type it published (last_match_float_ty).  Its phi was
# `i64` over doubles.
pub fn if_stmt_arm_float_settle(s: *EmitterState, list: *Stmt, reg: i32, agg: StrView, fr: *MatchResult) -> i32
    if reg <= 0 or not unnamed(agg)
        return reg
    let last: *Stmt = last_stmt(list)
    if last.kind == StmtKind.Expr and last.expr != null
        return match_arm_float_settle(s, last.expr, reg, fr)
    if last.kind == StmtKind.If or last.kind == StmtKind.Match
        return float_arm_settle(s, s.fcx.last_match_float_ty, null, last.span, reg, fr)
    reg

# True if the statement `if` `stmt` has no value to give: a statement follows
# it, or its list's value is unread (s.fcx.if_stmt_discarded).  Consumes the mark.
pub fn if_stmt_is_discarded(s: *EmitterState, stmt: *Stmt) -> bool
    let marked: *Stmt = s.fcx.if_stmt_discarded
    s.fcx.if_stmt_discarded = null
    stmt.next != null or stmt == marked

# AGAST #3323: an arm's phi incoming.  An arm that never reaches the merge (a
# `return`, a `while true` with no `break`) has no value, but the phi still
# names its block, so it gets IF_ARM_DIVERGES and the zero constant of the
# phi's type: `if c / return a / else / b` as a fn tail.  Its merge was
# `unreachable` with no phi, dropping the else value (a SIGSEGV).
#
# AGAST #4871: divergence wins over a register.  An arm ending in a `match`
# (or an inner `if`) whose arms all `return` still left that match's
# `phi i64 [ 0, .. ]` as its value; the enclosing ifs carried it up and a
# `-> S` fn's implicit tail was `ret %S` of an i64.  No path reads a
# diverging arm's value, so it is the zero constant; when every arm diverges
# there is no phi and the fn's last block is `unreachable`.
const IF_ARM_DIVERGES: i32 = -1

pub fn if_stmt_arm_incoming(result: i32, list: *Stmt) -> i32
    if tail_stmts_diverge(list) == 1
        return IF_ARM_DIVERGES
    result

pub fn emit_if_phi_incoming(s: *EmitterState, reg: i32, agg: StrView, float_ty: TypeKind)
    if reg != IF_ARM_DIVERGES
        format_into(s, "%.{reg}")
    else
        format_into(s, "{phi_zero(agg, float_ty)}")

# The zero constant of a phi of struct type `agg` (when named), else of float
# type `float_ty` (AGAST #3421), else an integer.
fn phi_zero(agg: StrView, float_ty: TypeKind) -> StrView
    if not unnamed(agg)
        return "zeroinitializer"
    if float_ty != TypeKind.Void
        return "0.0"
    "0"

# AGAST #2563: the phi type a statement-`if` arm of struct type `agg` asks
# for.  The Span$u8 / StrView pair (layout-equal, #168) takes the fn's return
# type when that is one of the two, since a tail `if` feeds the implicit
# `ret`: a `"..."` arm is a %Span$u8 (#98) but a `-> StrView` fn returns
# %StrView.  Any other type is `agg` itself.
pub fn if_stmt_phi_type(s: *EmitterState, agg: StrView, ret_type: TypeKind) -> StrView
    if agg.len <= 0 or ret_type != TypeKind.Struct or s.fcx.ret_type_name.len <= 0
        return agg
    let ret_name: StrView = s.fcx.ret_type_name
    if is_layout_equiv_pair(agg, ret_name) == 1
        return ret_name
    agg

# AGAST #2563: rebuild a statement-`if` arm's value `reg` of type `agg` as
# the phi's type when they are the Span$u8 / StrView pair, in the arm's own
# block before its `br` (as emit_match_arm_body does, #1662).
pub fn if_stmt_arm_settle(s: *EmitterState, reg: i32, agg: StrView, phi: StrView) -> i32
    if reg > 0 and is_layout_equiv_pair(agg, phi) == 1
        return rebuild_layout_equiv(s, reg, agg, phi)
    reg

# True if range `for j in a..b` is unsigned: a bound is a u64, by binary `<`'s
# rule (emit_expr_binary, #2361), so `for j in 0..big` with `big: u64 = 1 << 63`
# runs (#1636) and `-3..2` stays signed.  This one answer picks both the
# compare and j's type in the body (#3328).  ritz0's _for_range_unsigned.
pub fn for_range_unsigned(s: *EmitterState, stmt: *Stmt) -> bool
    var start_uns: i32 = 0
    var end_uns: i32 = 0
    let start_bits: i32 = int_operand_shape(s, stmt.for_start, @start_uns)
    let end_bits: i32 = int_operand_shape(s, stmt.for_end, @end_uns)
    (start_bits == 64 and start_uns == 1) or (end_bits == 64 and end_uns == 1)

# AGAST #4080: the type for_range_type gives `for x in a..b`'s x, from the
# bounds as int_operand_shape reads them (a literal is told apart first).
pub fn for_range_var_type(s: *EmitterState, stmt: *Stmt) -> TypeKind
    let sl: Option<i64> = lit_int_value(stmt.for_start)
    let el: Option<i64> = lit_int_value(stmt.for_end)
    var su: i32 = 0
    var eu: i32 = 0
    let sb: i32 = int_operand_shape(s, stmt.for_start, @su)
    let eb: i32 = int_operand_shape(s, stmt.for_end, @eu)
    for_range_type(int_kind_of(sb, su), sl, int_kind_of(eb, eu), el)

# A range bound's i64 register at the loop variable's type `t`: truncated when
# `t` is narrower (ritz1 holds every integer in an i64), else as it is.
pub fn for_bound_at(s: *EmitterState, reg: i32, t: TypeKind) -> i32
    let bits: i32 = ty_int_bits(t)
    if bits == 0 or bits >= 64
        return reg
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = trunc i64 %.{reg} to {ty_mem_llvm(t)}\n")
    r

# `break` / `continue`: run the defers of the scopes it leaves and jump to
# `target`, then open a dead block.  `begin_block` makes the dead block the
# active insertion point, so the enclosing IF/loop captures the right
# `current_label` when building PHI predecessor labels.  Without this,
# then/else_exit labels point at the pre-break block which isn't actually a
# CFG predecessor of the merge — LLVM's "Remove unreachable blocks" pass then
# crashes when it tries to remove the real (dead) predecessor from the PHI.
# (ritz-task-195)  Nothing when there is no loop to leave (`target` < 0).
fn emit_loop_jump(s: *EmitterState, target: i32)
    if target < 0
        return
    own_loop_jump(s)   # AGAST #2158: drop the loop body's bindings
    format_into(s, "  br label %L{target}\n")
    begin_block(s, next_label(s))
    clear_last_expr(s)

# `break`, running the defers of the scopes it leaves.
pub fn emit_break_stmt(s: *EmitterState, stmt: *Stmt)
    emit_loop_jump(s, s.fcx.break_label)

# `continue`, running the defers of the scopes it leaves.
pub fn emit_continue_stmt(s: *EmitterState, stmt: *Stmt)
    emit_loop_jump(s, s.fcx.continue_label)



# =============================================================================
# From emitter_match.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
struct MatchResult
    values: *i32   # register numbers holding each arm's result
    labels: *i32   # exit label numbers for each arm's result
    count: i32
    # AGAST #1645: LLVM struct type the arms yield (`%StrView`, `%Point`),
    # or null when they yield the usual i64 scalar.  The merge phi is emitted
    # at this type.
    agg_name: StrView
    # AGAST #1946: TypeKind.F32 / TypeKind.F64 when the arms yield a float, else 0.
    # Fixed by the enclosing let / return's hint (match_float_hint) or by
    # the first float-valued arm; later arms are coerced to it.
    float_ty: TypeKind
    # AGAST #2092: the enclosing let / return's float hint itself (0 if
    # none), handed on to a match / if that is an arm's value tail so the
    # annotation reaches every nested tail, as in ritz0.  Unlike float_ty it
    # is never set by an arm: an unannotated match passes nothing down.
    hint_ty: TypeKind
    # Arms recorded as i64 values before float_ty was fixed: they cannot be
    # coerced after the fact (their `br` is already emitted).
    int_arms: i32
    # AGAST #1654: arms whose body expression produced no value (a call to a
    # void fn: emit_expr returns register 0, which is never defined).  Any
    # such arm makes the match valueless: emit_match emits no phi.
    void_arms: i32
    # AGAST #2046: where the first valueless arm is (its innermost void
    # call), for the error when the match's value is wanted.
    void_line: i32
    void_col: i32
    # AGAST #2950: 1 when every value arm yields a `ptr` (`@&x`), so the phi
    # is a `ptr` (arms_ptr_valued, asked before the arms are emitted).
    ptr_ty: i32
    # AGAST #3276: the whole `[N]T` each arm stores its value into, or null
    # (the arms meet in a phi).  See emit_match_into.
    into: *ArrayInto
    # AGAST #3696: the `alloca %T` register every arm of a large struct %T
    # (at the sret threshold) stores its value into, or 0.  The merge loads
    # it instead of a `phi %T`.  slot_misses counts value arms recorded
    # before the slot existed; any forces the phi back (match_merge_slot).
    slot: i32
    slot_misses: i32
    # AGAST #3028: 1 when nothing reads the match's value (a match statement
    # before the block's last, or an expression arm of such a match).  An
    # expression arm's `t` with `t:& T` then reads nothing, as in ritz0.
    discarded: i32

# AGAST #3276: where a `match` of whole arrays stores each arm's array: the
# `[N x T]` at `ptr`, held to N (`size`) and T (`et`; a struct's `name`).
struct ArrayInto
    ptr: i32
    size: i32
    et: TypeKind
    name: StrView

# AGAST #1946: the float type (TypeKind.F32 / TypeKind.F64) arm value `e` was just
# emitted at, or 0.  A nested match / if publishes its phi type as it
# completes, which is immediately before this is asked.
pub fn match_arm_float_ty(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind == ExprKind.Match or e.kind == ExprKind.If
        return s.fcx.last_match_float_ty
    binop_operand_float_ty(s, e)

# AGAST #1946: settle a scalar arm's value against the phi's float type.  A
# float slot (result.hint_ty) fixes it up front; otherwise the first float arm
# does, and an integer arm on either side of it was refused on Sema (LARB
# R43, float_slot.ritz's float_mix_settle, AGAST #4933).  Once
# fixed, a float of the other width, or in a slot an integer, is converted in
# the arm's own block before its `br`.  Called while
# the arm's pattern binding is in scope.  Returns the register to record.
pub fn match_arm_float_settle(s: *EmitterState, arm_body: *Expr, body_reg: i32, result: *MatchResult) -> i32
    float_arm_settle(s, match_arm_float_ty(s, arm_body), arm_body, arm_body.span, body_reg, result)

# AGAST #3421: match_arm_float_settle for an arm whose value is of float type
# `aft` (0 if none).  A statement `if`'s arms come here too, and one whose
# value is a nested statement `if` / `match` has no expression (`arm_body`
# null): its phi's type is `aft`, and if that is an integer in a float merge,
# it is the R43 mix Sema refused (the nested one had the slot too, so it would
# be float).
# `at` is the arm's value, where an arm Sema could not type is reported.
pub fn float_arm_settle(s: *EmitterState, aft: TypeKind, arm_body: *Expr, at: SrcSpan, body_reg: i32, result: *MatchResult) -> i32
    if result.float_ty == TypeKind.Void
        if aft == TypeKind.Void
            result.int_arms = result.int_arms + 1
            return body_reg
        if result.int_arms > 0
            refuse_arm_beside_float(s, at)
        result.float_ty = aft
        return body_reg
    if aft == result.float_ty
        return body_reg
    if aft != TypeKind.Void
        return emit_float_coerce(s, body_reg, aft, result.float_ty)
    if arm_body == null
        refuse_arm_beside_float(s, at)
        return body_reg
    if is_int_const_type(expr_slot_ty(arm_body)) == 1
        # AGAST #3313, LARB R43a: an integer arm lands in the float slot as
        # `let a: f64 = x` does (§7.5): a literal or an exact type (i32 into
        # f64) converts, a lossy one (i64) is refused (ritz0 does the same).
        if result.hint_ty != TypeKind.Void
            return emit_int_into_float_slot(s, body_reg, float_slot_unsigned(arm_body), result.float_ty)
        # LARB R43 (#3385): with no float slot (hint_ty Void) the float type
        # came from an earlier arm, and Sema refused an integer arm next to
        # it at the merge (float_slot.ritz's float_mix_settle, AGAST #4933).
        refuse_arm_beside_float(s, at)
        return body_reg
    # A pointer arm was refused on Sema, in ritz0's words (AGAST #3626, #3892).
    emit_ir_error_sv(s, arm_body.span, "match arm yields a non-numeric value where the other arms yield a float")
    body_reg

# A non-float arm and a float arm meet with no float slot to settle them.
# LARB R43's integer arm is Sema's, refused at the merge (float_mix_settle,
# AGAST #4933); what reaches here is an arm Sema could not type (a `bool`),
# which has no float to become either.
fn refuse_arm_beside_float(s: *EmitterState, at: SrcSpan)
    emit_ir_error_sv(s, at, "this if / match arm's value is not a float, but another arm's is, and nothing gives the merge a float type; write it as a float or annotate the binding")

# The i64 condition `cond` as the i1 a `br` takes (AGAST #1367): every
# condition value, a bool included, is an i64 register.
pub fn cond_to_i1(s: *EmitterState, cond: i32) -> i32
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = icmp ne i64 %.{cond}, 0\n")
    r

# `br i1 %.cond_i1` to `then_label` or `else_label`.
pub fn br_if(s: *EmitterState, cond_i1: i32, then_label: i32, else_label: i32)
    format_into(s, "  br i1 %.{cond_i1}, label %L{then_label}, label %L{else_label}\n")

# `br label` to `label`.
pub fn br_to(s: *EmitterState, label: i32)
    format_into(s, "  br label %L{label}\n")
