import tokens_gen
import lexer
import ast
import ast_helpers
import parser_gen
import monomorph
import mono_clone   # AGAST #1818: cloning moved out of monomorph
import impl_placement   # refuse_misplaced_impls (LARB R65, AGAST #3494)
import generic_infer   # infer_generic_calls (AGAST #1982)
import struct_index   # struct_index_errors (AGAST #1635)
import struct_variants   # same-named struct conflicts (AGAST #4111)
import type_twins     # types follow the fn rule (AGAST #4609)
import binder_check   # binder_check_module (AGAST #2407)
import type_name_check   # refuse_unknown_type_names (AGAST #3932)
import named_variants   # named struct-variant forms (AGAST #4187)
import async_lower    # async_lower_module (AGAST #3814)
import main_abi       # the program entry ABI (AGAST #200)
import reachability   # reach_check_module (AGAST #2520)
import sema_walk      # sema_check_module (AGAST #3462)
import import_vis     # a plain import is private (AGAST #3891)
import sema_probe     # RITZ1_SEMA_PROBE (AGAST #3501)
import emitter
import fn_cache
import sha256
import iface_text   # interface texts ritz1 writes (AGAST #2113)
import emitter_core

# =============================================================================
# Error Reporting Helpers
# =============================================================================

# Print "prefix<path>suffix\n" as a single error line.
fn err2(prefix: StrView, path: *u8) -> i32
    var s: String = string_from_strview(prefix)
    s.push_str(strview_from_cstr(path))
    eprintln_string(@s)
    -1

# Print "prefix<path>middle<extra>\n" as a single error line.
fn err3(prefix: StrView, path: *u8, extra: *u8) -> i32
    var s: String = string_from_strview(prefix)
    s.push_str(strview_from_cstr(path))
    s.push_str(strview_from_cstr(extra))
    eprintln_string(@s)
    -1

# =============================================================================
# File I/O Helpers
# =============================================================================

# The arena the module's IR is written into (AGAST #4696).  Address space, not
# memory: pages are mapped untouched and only the bytes written are resident.
# 1 GiB is the most IR a module can write (the buffers never grow); a host that refuses that much address space gets the
# largest power-of-two share it will give, down to 128 MiB.
const IR_ARENA_BYTES: i64 = 1073741824
const IR_ARENA_MIN_BYTES: i64 = 134217728
# What the arena keeps for the buffers' headers and alignment.
const IR_ARENA_SLACK_BYTES: i64 = 65536

fn ir_arena_open() -> Arena
    var size: i64 = IR_ARENA_BYTES
    var arena: Arena = arena_new(size)
    while not arena.valid() and size > IR_ARENA_MIN_BYTES
        size = size / 2
        arena = arena_new(size)
    if not arena.valid()
        eprint("error: ritz1 could not map memory for the module's IR\n")
        sys_exit(1)
    arena

fn read_file(path: *u8) -> Vec<u8>
    var buf: Vec<u8> = vec_new<u8>()
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        err2("Error: Cannot open file: ", path)
        return buf

    # Read in chunks, each appended whole (AGAST #4454: not a push per byte).
    var chunk: [4096]u8
    let chunk_ptr: *u8 = @chunk[0]
    var n: i64 = 1
    while n > 0
        n = sys_read(fd, chunk_ptr, 4096)
        if n > 0
            buf.push_bytes(chunk_ptr, n)

    sys_close(fd)
    # Add null terminator
    buf.push(0)
    buf

fn write_file(path: *u8, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i64 = data_sv.len
    let fd: i32 = sys_open3(path, O_WRONLY + O_CREAT + O_TRUNC, 420)
    if fd < 0
        return err2("Error: Cannot create output file: ", path)
    # A write may take only part of the bytes (a file-size limit, a signal):
    # write the rest, and fail on an error such as ENOSPC rather than leave a
    # truncated .ll behind exit 0 (AGAST #4454).
    while len > 0
        let n: i64 = sys_write(fd, data, len)
        if n <= 0
            sys_close(fd)
            return err2("Error: Cannot write output file: ", path)
        data = data + n
        len = len - n
    if sys_close(fd) < 0
        return err2("Error: Cannot write output file: ", path)
    0

# =============================================================================
# Tokenizer
# =============================================================================

fn tokenize(path: *u8, src_sv: StrView, tokens: *Vec<Token>) -> i32
    var src: *u8 = src_sv.ptr
    var src_len: i64 = src_sv.len
    # The scanner is code: nothing to build per file (AGAST #1821).
    var lex: Lexer
    lexer_init(@lex, StrView { ptr: (src), len: (src_len) })

    var errors: i32 = 0
    loop
        var tok: Token = lexer_next(@lex)
        let kind: i32 = tok.kind
        let line: i32 = tok.line
        let col: i32 = tok.col
        # For STRING-like tokens, copy string_val to heap (lexer buffer is on stack)
        let needs_copy: i32 = (kind == TOK_STRING or kind == TOK_CSTRING) as i32
        if needs_copy == 1 and tok.string_val != null and tok.string_len > 0
            let heap_str: *u8 = malloc(tok.string_len as i64)
            for i in 0..tok.string_len
                *(heap_str + i) = *(tok.string_val + i)
            tok.string_val = heap_str
        # Always push the token first (moves tok)
        tokens.push(tok)
        # Then check conditions on kind (not tok)
        if kind == TOK_EOF
            break
        if kind == TOK_ERROR
            # "error: <path>:<line>:<col>: <what>", like the parser's
            # diagnostics (AGAST #1813).
            var msg: String = string_from("error: ")
            msg.push_str(strview_from_cstr(path))
            msg.push_str(":")
            msg.push_i64(line as i64)
            msg.push_str(":")
            msg.push_i64(col as i64)
            msg.push_str(": ")
            if lex.error_msg.len > 0
                msg.push_str(lex.error_msg)
                lex.error_msg = ""
            else
                msg.push_str("Lexer error: unexpected character")
            eprintln_string(@msg)
            errors = errors + 1

    errors

# =============================================================================
# Parser
# =============================================================================

fn parse_tokens(ctx: *ParseCtx, tokens: *Vec<Token>) -> *Module
    var p: Parser
    # Arena for AST nodes, sized to the input (AGAST #1730).  A fixed 4 MB
    # was NOT plenty: ritz1's own emitter_stmt.ritz overran it, and with no
    # bound check the overrun silently corrupted the heap.  Use interp.ritz's
    # bound (a few 128-byte nodes per token, 1 KB per token) with the old
    # 4 MB as a floor.  Untouched pages of a large malloc cost nothing.
    var arena_bytes: i64 = 4096 + (tokens.len as i64) * 1024
    if arena_bytes < 4194304
        arena_bytes = 4194304
    let arena: *u8 = malloc(arena_bytes)
    if arena == null
        eprintln("Error: Failed to allocate parser arena")
        return null
    parser_arena_set_cap(ctx, arena_bytes)
    parser_init(@p, ctx, tokens.data, tokens.len as i32, arena)

    let m: *Module = parse_module(@p)

    if p.error != 0
        # Every failure module_require_eof produces is already reported at
        # a line and column; only an unreported one gets a (located) line
        # here, never a second, unlocated "Parse error at pos N" (#3691).
        parser_report_unreported(@p)
        return null

    m

# =============================================================================
# E.from (LANGUAGE_SPEC §10.4, AGAST #1880)
# =============================================================================

# Does `m` import ritzlib.option (the result type of a generated `from`)?
fn imports_option(m: *Module) -> i32
    var imp: *ImportDecl = m.imports
    while imp != null
        let a: *ImportPath = imp.path
        if a != null and a.next != null and a.next.next == null
            if (StrView { ptr: (a.segment), len: (a.segment_len) as i64 }).eq("ritzlib")
                if (StrView { ptr: (a.next.segment), len: (a.next.segment_len) as i64 }).eq("option")
                    return 1
        imp = imp.next
    0

# Parse the generated `E__from` fns of the enums with a representation type
# that `m` declared (tracker indices >= first_ei) into `m`, as if written in
# its source: ritz0 does the same (parser.py, _enum_from_fns).  Only for a
# module that imports ritzlib.option; elsewhere `E.from` is a located error
# (emit_expr_method).  Returns -1 on a lex/parse failure of the generated text.
fn add_enum_from_fns(ctx: *ParseCtx, m: *Module, path: *u8) -> i32
    if imports_option(m) == 0
        return 0
    var text: String = string_new()
    enum_from_source(m, @&text)
    let gen_len: i64 = text.len()
    if gen_len == 0
        return 0
    let gen: *u8 = text.as_ptr()
    var tokens: Vec<Token> = vec_with_cap<Token>(1024)
    if tokenize(path, text.as_view(), @tokens) > 0
        err2("Lexer errors in the generated from() of: ", path)
        return -1
    let gm: *Module = parse_tokens(ctx, @tokens)
    if gm == null
        err2("Parse error in the generated from() of: ", path)
        return -1
    # The AST slices the text: steal the buffer, as add_main_adapter does.
    keep_source_alive(gen)
    text.data.data = null
    # Not in the source: identical enums in two files each generate one
    # (AGAST #2148, fns_conflict).
    var gf: *FnDef = gm.functions
    while gf != null
        gf.from_generated = 1
        # AGAST #4609: every object that uses it defines its own copy (an
        # import's too, its body kept by strip_to_interface), internal.
        gf.is_local = 1
        gf = gf.next
    merge_module_into(m, gm)
    0

# =============================================================================
# The program entry ABI (AGAST #200, main_abi.ritz)
# =============================================================================

# 1 under --test-table: the runner supplies `main` and the file's own is
# dropped, so lower_main leaves it alone (ritz0's _lower_main skips test mode).
var g_test_table: i32 = 0

# Check this file's `main`; if it needs the entry adapter, rename it
# `__ritz_main` and parse the adapter (plus the span runtime for a Span main)
# into `m`, as if written in the source.  Runs on the input file's module
# right after its parse, before its fns are marked local and before imports
# merge (ritz0 runs _lower_main before _resolve), so the generated fns are
# local and go through every later pass like any other.  An async main is
# left to async_lower, which gives it its own synchronous wrapper.  Returns
# -1 on an error (already reported); the module is unchanged then.
fn lower_main(ctx: *ParseCtx, m: *Module, path: *u8) -> i32
    if g_test_table == 1
        return 0
    let f: *FnDef = main_abi_find(m)
    if f == null or f.is_async == 1
        return 0
    if main_abi_check(ctx, f, path) > 0
        return -1
    if main_abi_needs_adapter(f) == 0
        return 0
    var text: String = string_new()
    main_abi_source(f, @&text)
    let gen: *u8 = text.as_ptr()
    let gen_len: i64 = text.len()
    var tokens: Vec<Token> = vec_with_cap<Token>(1024)
    if tokenize(path, StrView { ptr: (gen), len: (gen_len) }, @tokens) > 0
        err2("Lexer errors in the generated main adapter of: ", path)
        return -1
    let gm: *Module = parse_tokens(ctx, @tokens)
    if gm == null
        err2("Parse error in the generated main adapter of: ", path)
        return -1
    # The AST slices the text: it lives as long as the compile. Steal the
    # buffer from `text`, or its Drop (AGAST #2159) frees it at return.
    keep_source_alive(gen)
    text.data.data = null
    main_abi_rename(f)
    merge_module_into(m, gm)
    0

# =============================================================================
# Import Resolution - Inline imported code into the module
# =============================================================================

# Track processed import paths.  A Vec has a Drop impl (AGAST #2159), and a
# module-level value of a Drop type is refused: it would never be dropped.
# So the Vec lives behind a raw pointer that is allocated once and leaked
# until compiler exit, like the source buffers below.
var g_processed: *Vec<String> = null

fn processed_vec() -> *Vec<String>
    if g_processed == null
        let p: *Vec<String> = malloc(sizeof(Vec<String>)) as *Vec<String>
        *p = Vec<String> { data: null, len: 0, cap: 0 }
        g_processed = p
    g_processed

# Source buffers backing AST string slices.  We "leak" each by stealing
# its `data` pointer from the local Vec<u8> in load_and_parse; the OS
# reclaims at process exit.  The compiler runs once, so a per-import
# malloc-leak is acceptable and saves us a Vec<*u8> global (which would
# need ritz1 mangling support for pointer-typed type args).
fn keep_source_alive(src_ptr: *u8)
    # Intentionally a no-op — `src_ptr` is the malloced backing buffer,
    # leaked-by-design until compiler exit.  Keeping the function (with
    # a dummy use of src_ptr to satisfy the parser) so call sites stay
    # readable and we have a single place to wire a real keep-alive when
    # ritz1 ever gains pointer-typed generic type-arg mangling.
    let _: *u8 = src_ptr

fn was_import_processed(path: @String) -> i32
    let g: *Vec<String> = processed_vec()
    let n: i64 = g.len()
    for i in 0..n
        let entry_ptr: *String = g.get_ptr(i)
        if entry_ptr.eq_string(path)
            return 1
    0

fn mark_import_processed(path: String)
    processed_vec().push(path)

# The g_processed key of the file at `path` (AGAST #2148): its canonical
# path, as ritz0's processed_files holds Path.resolve()d ones, so a module
# reached by two spellings (a relative import and the RITZ_PATH symlink farm,
# or an import cycle back to the main file) is merged once.  The raw path if
# it cannot be canonicalised.
fn import_key(path: *u8) -> String
    var key: String = string_new()
    if push_canonical_path(@key, path) == 0
        key.push_str(strview_from_cstr(path))
    key

# Return the directory portion (up to and including the trailing '/'), or
# an empty StrView if path has no directory component.
fn path_dir(path: *u8) -> StrView
    var len: i64 = 0
    var last_slash: i64 = -1
    while *(path + len) != 0
        if *(path + len) == '/'
            last_slash = len
        len += 1
    var sv: StrView
    sv.ptr = path
    if last_slash >= 0
        sv.len = last_slash + 1
    else
        sv.len = 0
    sv

# Return the parent directory view of `dir` (which is expected to end in '/').
# E.g. parent_dir_view("/a/b/c/") -> "/a/b/" with len pointing at trailing slash.
# Returns an empty StrView when there is no parent component.
fn parent_dir_view(dir: StrView) -> StrView
    var out: StrView
    out.ptr = dir.ptr
    out.len = 0
    if dir.len <= 1
        return out
    # Skip the trailing '/'.
    var i: i64 = dir.len - 2
    while i >= 0
        if *(dir.ptr + i) == '/'
            out.len = i + 1
            return out
        i -= 1
    out

# Build "dir/seg1/seg2/....ritz" from a dir view and import segment list.
# Caller owns the returned String.
fn build_import_path(dir: StrView, imp: *ImportPath) -> String
    var out: String = string_from_strview(dir)
    # Ensure separator between dir and segments (only if dir doesn't end with '/').
    if out.len() > 0
        if out.char_at(out.len() - 1) != '/'
            out.push('/')
    var seg: *ImportPath = imp
    while seg != null
        out.push_span(Span<u8> { ptr: (seg.segment), len: (seg.segment_len as i64) as i64 })
        if seg.next != null
            out.push('/')
        seg = seg.next
    out.push_str(".ritz")
    out

# Build "dir/<pkg>/<sub>/<rest...>.ritz" — inserts `sub` after the first
# import segment (the package name). Used to honor `sources = ["lib", "src"]`
# in workspace ritz.toml files: ritz0 reads ritz.toml at resolve time; ritz1
# probes the two values that every workspace project actually uses (lib, src).
# Returns an empty String when there is no remaining segment after the pkg
# name (e.g. bare `import pkg`) — the subdir probe would be meaningless.
fn build_import_path_with_sub(dir: StrView, imp: *ImportPath, sub: *u8) -> String
    if imp == null
        return string_new()
    if imp.next == null
        return string_new()
    var out: String = string_from_strview(dir)
    if out.len() > 0
        if out.char_at(out.len() - 1) != '/'
            out.push('/')
    # First segment: the package name.
    out.push_span(Span<u8> { ptr: (imp.segment), len: (imp.segment_len as i64) as i64 })
    out.push('/')
    # The subdir (e.g. "lib" or "src").
    out.push_str(strview_from_cstr(sub))
    out.push('/')
    # Remaining segments.
    var seg: *ImportPath = imp.next
    while seg != null
        out.push_span(Span<u8> { ptr: (seg.segment), len: (seg.segment_len as i64) as i64 })
        if seg.next != null
            out.push('/')
        seg = seg.next
    out.push_str(".ritz")
    out

# Does the first segment of this import path equal "ritzlib"?
fn import_is_ritzlib(imp: *ImportPath) -> i32
    if imp == null
        return 0
    var seg_view: StrView
    seg_view.ptr = imp.segment
    seg_view.len = imp.segment_len as i64
    seg_view.eq("ritzlib") as i32

# The `--dep <name>=<dir>` entries (AGAST #3825), `:`-joined, in order: one
# per (namespace, source root), as build.py's ritz1_compile_cmd passes them.
# They carry what ritz0 gets from --deps and ritz1 can't read without a TOML
# parser: a namespace's declared `sources`.  zeus declares
# `sources = ["lib", "examples"]`; RITZ_PATH's <entry>/<ns>/{lib,src} probe
# never looked in examples/, so `import zeus.echo_handler` failed under ritz1.
var g_dep_ptr: *u8 = null
var g_dep_len: i64 = 0

# `import <name>.<rest>` against each `--dep <name>=<dir>`, in order:
# `<dir>/<rest>.ritz`, as ritz0's DependencyMapping.resolve_import probes
# `<path>/<source>/<rest>`.  The first file that opens wins; every miss
# before it is recorded (AGAST #2030).  An empty String when none opens.
#
# Unlike ritz0, a miss falls through to the source-dir and RITZ_PATH probes:
# those are what resolved every namespace before #3825, and a dep that lacks
# the module must not break a build that resolved it there.
fn try_open_dep_import(imp: *ImportPath) -> String
    if imp == null or g_dep_len == 0
        return string_new()
    if imp.next == null
        return string_new()
    var ds: i64 = 0
    var di: i64 = 0
    while di <= g_dep_len
        if di == g_dep_len or *(g_dep_ptr + di) == ':'
            var eq: i64 = ds
            while eq < di and *(g_dep_ptr + eq) != '='
                eq = eq + 1
            if eq - ds == imp.segment_len as i64 and eq + 1 < di
                if memcmp(g_dep_ptr + ds, imp.segment, eq - ds) == 0
                    var dir: StrView
                    dir.ptr = g_dep_ptr + eq + 1
                    dir.len = di - eq - 1
                    var candidate: String = build_import_path(dir, imp.next)
                    let fd: i32 = sys_open(candidate.as_ptr(), O_RDONLY)
                    if fd >= 0
                        sys_close(fd)
                        return candidate
                    dep_record_miss(candidate.as_ptr())
            ds = di + 1
        di = di + 1
    string_new()

# Try to open an import file, checking source-dir first, then each colon-
# separated entry in RITZ_PATH (mirroring ritz0/Python's os.pathsep semantics).
# Returns a fresh String with the resolved path, or empty String if not found.
# Sets *found_via_ritz_path to 1 when RITZ_PATH was used.
#
# Every candidate probed and missed before the hit goes to dep_record_miss():
# a file appearing there later would win, so the sig's fast path must check
# it is still missing (AGAST #2030).
#
# Multi-path RITZ_PATH support is essential for the workspace builds: `./rz`
# orchestrates dependencies across many sibling projects (zeus, valet, nexus,
# ...) and constructs RITZ_PATH like `/path/ritz:/path/zeus:/path/cryptosec`.
# Earlier ritz1 only honored the first path, so any cross-project import
# beyond ritzlib failed with "Could not read import: <module>".
fn try_open_import(imp: *ImportPath, source_dir: StrView, ritz_path: StrView, found_via_ritz_path: *i32) -> String
    *found_via_ritz_path = 0

    # Declared namespaces first, as ritz0 checks its --deps first.
    var dep_hit: String = try_open_dep_import(imp)
    if dep_hit.len() > 0
        return dep_hit

    # ritzlib imports skip source-dir and resolve only via RITZ_PATH.
    let is_ritzlib: i32 = import_is_ritzlib(imp)

    # First try relative to source file (unless this is a ritzlib import).
    # We walk up the source_dir ancestry, probing `<ancestor>/<imp>.ritz` at
    # each level. This mirrors ritz0's ImportResolver._try_resolve_path which
    # resolves intra-project imports like `lib.m7m_types` (mausoleum) or
    # `src.store` (nexus) by climbing to the project root, where ritz.toml's
    # source_roots like ["src", "lib", "test"] live as actual directories.
    # Cap the climb at 8 levels — workspace projects never go deeper.
    if is_ritzlib == 0
        var sd_ptr: *u8 = source_dir.ptr
        var sd_len: i64 = source_dir.len
        var levels: i32 = 0
        while levels < 8
            if sd_len <= 0
                levels = 8
            else
                var dir_view: StrView
                dir_view.ptr = sd_ptr
                dir_view.len = sd_len
                var candidate: String = build_import_path(dir_view, imp)
                let fd: i32 = sys_open(candidate.as_ptr(), O_RDONLY)
                if fd >= 0
                    sys_close(fd)
                    return candidate
                dep_record_miss(candidate.as_ptr())

                # Climb to parent directory.
                var parent_view: StrView
                parent_view.ptr = sd_ptr
                parent_view.len = sd_len
                let parent: StrView = parent_dir_view(parent_view)
                if parent.len == 0
                    levels = 8
                else
                    if parent.len == sd_len
                        # Defensive: parent didn't shrink — bail out.
                        levels = 8
                    else
                        sd_len = parent.len
                        levels += 1

    # Then try each colon-separated entry in RITZ_PATH.
    if ritz_path.len > 0
        var remaining: StrView = ritz_path
        while remaining.len > 0
            var seg: StrView = remaining
            var rest: StrView = strview_empty()
            var had_delim: i32 = 0
            match remaining.split_once(':')
                Some(p) =>
                    seg = p.before
                    rest = p.after
                    had_delim = 1
                None => pass

            if seg.len > 0
                # Snapshot fields — StrView is moved on by-value pass, so we
                # rebuild a fresh view for each of the three probes below.
                let seg_ptr: *u8 = seg.ptr
                let seg_len: i64 = seg.len

                # Direct probe: <entry>/<pkg>/<rest>.ritz
                # Required for ritzlib (laid out flat under <entry>/ritzlib/).
                var seg_direct: StrView
                seg_direct.ptr = seg_ptr
                seg_direct.len = seg_len
                var candidate: String = build_import_path(seg_direct, imp)
                let fd: i32 = sys_open(candidate.as_ptr(), O_RDONLY)
                if fd >= 0
                    sys_close(fd)
                    *found_via_ritz_path = 1
                    return candidate
                dep_record_miss(candidate.as_ptr())

                # Workspace probes: <entry>/<pkg>/lib/<rest>.ritz and
                # <entry>/<pkg>/src/<rest>.ritz. Mirrors ritz0's
                # _auto_detect_dependencies_from_ritz_path: every workspace
                # project (valet, zeus, nexus, mausoleum, tome, ...) puts its
                # public API under one of `sources = [...]` in ritz.toml. We
                # probe lib then src — those are the only two values used by
                # the app stack, and ritz1 gets to skip the TOML parser.
                var seg_lib: StrView
                seg_lib.ptr = seg_ptr
                seg_lib.len = seg_len
                var c_lib: String = build_import_path_with_sub(seg_lib, imp, c"lib")
                if c_lib.len() > 0
                    let fd_lib: i32 = sys_open(c_lib.as_ptr(), O_RDONLY)
                    if fd_lib >= 0
                        sys_close(fd_lib)
                        *found_via_ritz_path = 1
                        return c_lib
                    dep_record_miss(c_lib.as_ptr())

                var seg_src: StrView
                seg_src.ptr = seg_ptr
                seg_src.len = seg_len
                var c_src: String = build_import_path_with_sub(seg_src, imp, c"src")
                if c_src.len() > 0
                    let fd_src: i32 = sys_open(c_src.as_ptr(), O_RDONLY)
                    if fd_src >= 0
                        sys_close(fd_src)
                        *found_via_ritz_path = 1
                        return c_src
                    dep_record_miss(c_src.as_ptr())

            if had_delim == 0
                # No more delimiters; we already tried `seg` (the full
                # remaining view), so we're done.
                remaining.ptr = null
                remaining.len = 0
            else
                remaining = rest

    string_new()

# Append the human-readable dotted import path ("foo.bar.baz") to a String.
fn append_import_display(s: *String, imp: *ImportPath)
    var seg: *ImportPath = imp
    while seg != null
        s.push_span(Span<u8> { ptr: (seg.segment), len: (seg.segment_len as i64) as i64 })
        if seg.next != null
            s.push('.')
        seg = seg.next

# =============================================================================
# Constant conflicts across files (AGAST #2149)
# =============================================================================
#
# A const may be defined in several merged files only if every definition is
# the same: same declared type and a structurally identical initializer.
# This is ritz0's rule (import_resolver.py _consts_equal / _exprs_equal): an
# Ident compares by name, because both definitions resolve in the same
# merged const namespace, so `5` and `2 + 3` differ even though they fold to
# one value.  As in ritz0, a [[target_os]] const and an ungated one of the
# same name are never compared (ritzunit's reporter.ritz has its own
# `const TIOCGWINSZ: i64` beside ritzlib.sys's gated `u64` one).  ritz1 drops
# non-matching [[target_os]] variants at parse time, so two gated
# definitions left here are for the same target and are compared.

fn bytes_same(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var a_len: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var b_len: i32 = b_sv.len as i32
    if a_len != b_len
        return 0
    if a_len == 0
        return 1
    if memcmp(a, b, a_len as i64) == 0
        return 1
    0

fn const_exprs_same(a: *Expr, b: *Expr) -> i32
    if a == null or b == null
        if a == b
            return 1
        return 0
    if a.kind != b.kind
        return 0
    let k: ExprKind = a.kind
    match k
        ExprKind.IntLit | ExprKind.CharLit =>
            if a.int_val == b.int_val
                return 1
            return 0
        ExprKind.StringLit | ExprKind.CstringLit | ExprKind.FloatLit =>
            return bytes_same(a.string_val, b.string_val)
        ExprKind.Ident =>
            return bytes_same(a.ident, b.ident)
        ExprKind.Unary =>
            if a.op != b.op
                return 0
            return const_exprs_same(a.operand, b.operand)
        ExprKind.Binary =>
            if a.op != b.op
                return 0
            if const_exprs_same(a.left, b.left) == 0
                return 0
            return const_exprs_same(a.right, b.right)
        ExprKind.Cast =>
            # type_kind is the target type; for `as *T`, cast_ptr_kind / ident_* name T.
            if a.type_kind != b.type_kind
                return 0
            if a.type_kind == TypeKind.Ptr
                if a.cast_ptr_kind != b.cast_ptr_kind
                    return 0
                if bytes_same(a.ident, b.ident) == 0
                    return 0
            return const_exprs_same(a.left, b.left)
        ExprKind.ArrayLit =>
            var ea: *Expr = a.args
            var eb: *Expr = b.args
            while ea != null and eb != null
                if const_exprs_same(ea, eb) == 0
                    return 0
                ea = ea.next
                eb = eb.next
            if ea == eb
                return 1
            return 0
        ExprKind.ArrayFill =>
            if a.int_val != b.int_val
                return 0
            return const_exprs_same(a.left, b.left)
        _ => pass
    # Anything else (struct literals, calls, ...): conservatively different,
    # as ritz0 does.
    0

fn consts_same(a: *ConstEntry, b: *ConstEntry) -> i32
    if a.const_type != b.const_type
        return 0
    if bytes_same(StrView { ptr: (a.type_name), len: (a.type_name_len) as i64 }, StrView { ptr: (b.type_name), len: (b.type_name_len) as i64 }) == 0
        return 0
    if a.array_size != b.array_size or a.array_elem_type != b.array_elem_type
        return 0
    if bytes_same(StrView { ptr: (a.array_elem_type_name), len: (a.array_elem_type_name_len) as i64 }, StrView { ptr: (b.array_elem_type_name), len: (b.array_elem_type_name_len) as i64 }) == 0
        return 0
    const_exprs_same(a.value_expr, b.value_expr)

# Report every const of `other` (the import at `path`, with everything it
# imported merged in) that `m` already defines differently, at the
# definition's own file:line:col.  Returns -1 if there was one, else 0.
fn check_const_conflicts(m: *Module, other: *Module, path: *u8) -> i32
    var bad: i32 = 0
    var c: *ConstEntry = other.constants
    while c != null
        var e: *ConstEntry = m.constants
        while e != null
            if e.target_gated == c.target_gated and bytes_same(StrView { ptr: (e.name), len: (e.name_len) as i64 }, StrView { ptr: (c.name), len: (c.name_len) as i64 }) == 1
                if consts_same(e, c) == 0
                    var msg: String = string_from("Error: ")
                    if c.def_file != null
                        msg.push_str(strview_from_cstr(c.def_file))
                    else
                        msg.push_str(strview_from_cstr(path))
                    msg.push(':')
                    msg.push_i64(c.line as i64)
                    msg.push(':')
                    msg.push_i64(c.col as i64)
                    msg.push_str(": Conflicting constant definition for '")
                    msg.push_span(Span<u8> { ptr: (c.name), len: (c.name_len as i64) as i64 })
                    if c.target_gated == 1
                        msg.push_str("': defined differently for same target_os")
                    else
                        msg.push_str("': defined differently in multiple files")
                    eprintln_string(@msg)
                    bad = 1
                break
            e = e.next
        c = c.next
    if bad == 1
        return -1
    0

# =============================================================================
# Function conflicts across files (AGAST #2148)
# =============================================================================
#
# A fn name may have at most one definition in any one file's
# namespace (LANGUAGE_SPEC §15.3).  A private fn is in its own file's only
# (AGAST #1858): two files' private fns of one name coexist, and so do a
# private one and a `pub` one its file doesn't import (fns_coexist);
# keep_one_fn then keeps the one this compile sees.  Two `pub` ones always
# conflict.  ritz0's rule (import_resolver.py _register_item, _fns_coexist):
# bodies are not compared (an import is seen through its interface).  A
# `[[target_os]]` fn beside an ungated one of the same name is a conflict on
# the gated target, as for structs (#4054/#4111, AGAST #4270): after
# filtering at most one definition survives, and gated-out fns never reach
# the module (two gated out are struct_variants.ritz's fn_variants_check).
# Two generated `E__from` fns come from enums already checked identical, so
# they do not conflict.  `extern fn` declarations (body == null) are not
# definitions.
#
# The diagnostic names the earlier definition first in ritz0's registration
# order, where a file's imports come before the file's own items.

# 1 if `a` and `b` are two definitions of one fn name that may not coexist.
fn fns_conflict(a: *FnDef, b: *FnDef) -> i32
    if a.def_file == null or b.def_file == null
        return 0
    if a.body == null or b.body == null
        return 0
    if a.from_generated == 1 and b.from_generated == 1
        return 0
    if bytes_same(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (b.name), len: (b.name_len) as i64 }) == 0
        return 0
    # Only two ungated fns can share a name: a gated variant in the module
    # is gated to the target compiled for, so it conflicts with any other.
    if a.target_gated == 0 and b.target_gated == 0 and fns_coexist(a, b) == 1
        return 0
    1

# 1 if two ungated fns of one name, from two files, may both exist (AGAST
# #1858): a private fn is in its own file's namespace only, so it clashes
# only with a `pub` fn its file imports (directly, or by `pub import`).
fn fns_coexist(a: *FnDef, b: *FnDef) -> i32
    if streq(a.def_file, b.def_file)
        return 0
    if a.is_pub == 1 and b.is_pub == 1
        return 0
    if a.is_pub == 0 and b.is_pub == 0
        return 1
    var private: *FnDef = a
    var public: *FnDef = b
    if a.is_pub == 1
        private = b
        public = a
    var key: String = import_key(private.def_file)
    let sees: i32 = vis_sees(key.as_ptr(), public)
    1 - sees

# Of the ungated fns of one name fns_coexist let through, keep the one the
# input sees: its own (is_local), or else the `pub` one, or else the first.
# The others are other files' private fns: the input can't call them
# (§15.2, call_check's error needs the one kept) and their own objects define
# them (internal linkage).  An instance of a dropped fn's file's generic that
# calls it binds to the kept one, which call_check refuses as private to the
# kept one's file, at the call in the generic.
fn keep_one_candidate(f: *FnDef) -> i32
    if f.target_gated == 0 and f.body != null and f.from_generated == 0
        return 1
    0

fn keep_one_fn(m: *Module)
    var f: *FnDef = m.functions
    while f != null
        # Every group of two or more has a private member: start from it.
        var removed: i32 = 0
        if f.is_pub == 0 and keep_one_candidate(f) == 1
            var best: *FnDef = f
            var count: i32 = 0
            var g: *FnDef = m.functions
            while g != null
                if keep_one_candidate(g) == 1 and bytes_same(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 1
                    count += 1
                    if best.is_local == 0 and (g.is_local == 1 or (g.is_pub == 1 and best.is_pub == 0))
                        best = g
                g = g.next
            if count > 1
                # Unlink every other one of f's name.
                var prev: *FnDef = null
                var h: *FnDef = m.functions
                while h != null
                    let nxt: *FnDef = h.next
                    if h != best and keep_one_candidate(h) == 1 and bytes_same(StrView { ptr: (h.name), len: (h.name_len) as i64 }, StrView { ptr: (best.name), len: (best.name_len) as i64 }) == 1
                        if prev == null
                            m.functions = nxt
                        else
                            prev.next = nxt
                    else
                        prev = h
                    h = nxt
                removed = 1
        # A group is rare: start over rather than track f's predecessor.
        if removed == 1
            f = m.functions
        else
            f = f.next

# "Error: <later>:<line>: Conflicting function definition for 'X': defined in
# both <earlier> and <later>"
fn report_fn_conflict(earlier: *FnDef, later: *FnDef)
    var msg: String = string_from("Error: ")
    msg.push_str(strview_from_cstr(later.def_file))
    msg.push(':')
    msg.push_i64(later.line as i64)
    msg.push_str(": Conflicting function definition for '")
    msg.push_span(Span<u8> { ptr: (later.name), len: (later.name_len as i64) as i64 })
    msg.push_str("': defined in both ")
    msg.push_str(strview_from_cstr(earlier.def_file))
    msg.push_str(" and ")
    msg.push_str(strview_from_cstr(later.def_file))
    eprintln_string(@msg)

# Two definitions of one name inside a single freshly parsed file `m` (its
# generated `E__from` fns included).  Returns -1 if there was one, else 0.
fn check_fn_dups_in_file(m: *Module) -> i32
    var bad: i32 = 0
    var f: *FnDef = m.functions
    while f != null
        var g: *FnDef = f.next
        while g != null
            if fns_conflict(f, g) == 1
                report_fn_conflict(f, g)
                bad = 1
                break
            g = g.next
        f = f.next
    if bad == 1
        return -1
    0

# Every fn of `other` (an import of the file `m_path`, with everything it
# imported merged in) that `m` already defines.  `m` holds m_path's own fns
# and those of its earlier imports; m_path's own come after `other`'s.
# Returns -1 if there was a conflict, else 0.
fn check_fn_conflicts(m: *Module, other: *Module, m_path: *u8) -> i32
    var bad: i32 = 0
    var c: *FnDef = other.functions
    while c != null
        var e: *FnDef = m.functions
        while e != null
            if fns_conflict(e, c) == 1
                if streq(e.def_file, m_path)
                    report_fn_conflict(c, e)
                else
                    report_fn_conflict(e, c)
                bad = 1
                break
            e = e.next
        c = c.next
    if bad == 1
        return -1
    0

# Merge imported_module's declarations into main module m.
# Each list is preserved by walking to its tail and prepending the main list.
fn merge_module_into(m: *Module, other: *Module)
    if other.structs != null
        var last: *StructDef = other.structs
        while last.next != null
            last = last.next
        last.next = m.structs
        m.structs = other.structs
    # AGAST #3994: append, not prepend.  Enum indices are positions in this
    # chain and the tracker this replaced recorded enums in parse order
    # (importer first, then its imports depth-first), so appending keeps
    # every recorded index and the "first declared wins" lookups unchanged.
    if other.enums != null
        if m.enums == null
            m.enums = other.enums
        else
            var last_e: *EnumDef = m.enums
            while last_e.next != null
                last_e = last_e.next
            last_e.next = other.enums
    if other.functions != null
        var last: *FnDef = other.functions
        while last.next != null
            last = last.next
        last.next = m.functions
        m.functions = other.functions
    if other.constants != null
        var last: *ConstEntry = other.constants
        while last.next != null
            last = last.next
        last.next = m.constants
        m.constants = other.constants
    if other.globals != null
        var last: *GlobalVarDef = other.globals
        while last.next != null
            last = last.next
        last.next = m.globals
        m.globals = other.globals
    if other.impls != null
        var last: *ImplBlock = other.impls
        while last.next != null
            last = last.next
        last.next = m.impls
        m.impls = other.impls

# =============================================================================
# Interface texts (G9c, AGAST #1901)
# =============================================================================
#
# ritz0 stores each module's interface as Ritz source next to its own
# (pickled) interface: the module with every body strip_to_interface drops
# turned into a declaration-only `fn ... = extern` (#1900), and its lines
# emptied, so every kept line and column is the source's.  The format and
# the key are defined in ritz0/module_interface.py ("Interface text"):
#
#   <store>/objects/<k[:2]>/<k>.rzi.ritz
#   k = sha256_hex("ritz-iface-text-v2\n" + sha256_hex(source bytes))
#   <store> = $RITZ_CACHE_DIR, else ~/.cache/ritz/cas (cas.py default_root)
#
# The key holds the source's bytes only, never a path or a compiler, so an
# import is lexed and parsed from its interface whenever one is stored,
# under the import's real path for diagnostics.  On a miss the source is
# parsed, and ritz1 stores its text (iface_text.ritz, AGAST #2113) for the
# next compile, byte-identical to the one ritz0 writes.
#
# The file-level fast path records each import by its interface text
# (dep_record_note below), so a body-only edit of an import that keeps its
# text keeps the importer's sig valid (fn_cache sig_deps_unchanged).
#
# RITZ1_PARSE_LOG=<file> appends the path of every *source* this process
# lexes and parses (the main file included, interface texts not), like
# ritz0's RITZ0_PARSE_LOG.
#
# RITZ1_PARSE_ONLY=1 (or `--parse-only`, AGAST #4379) stops after the parse
# and its alias second pass, before any check reads the AST, and reports the
# lex and parse wall time to stderr.  See fn main.

# The stored interface text of a module with these bytes (NUL-terminated,
# like read_file), or an empty Vec when none is stored.
fn read_iface_text(src_sv: StrView) -> Vec<u8>
    var src: *u8 = src_sv.ptr
    var len: i64 = src_sv.len
    var path: String = iface_text_path(StrView { ptr: (src), len: (len) })
    if path.len() == 0
        return vec_new<u8>()
    let fd: i32 = sys_open(path.as_ptr(), O_RDONLY)
    if fd < 0
        return vec_new<u8>()
    sys_close(fd)
    let text: Vec<u8> = read_file(path.as_ptr())
    text

# RITZ1_PARSE_LOG: note that `path`'s source is being lexed and parsed.
fn parse_log_note(path: *u8)
    let log: StrView = env_get_or("RITZ1_PARSE_LOG", strview_empty())
    if log.len == 0
        return
    var log_path: String = string_from_strview(log)
    let fd: i32 = sys_open3(log_path.as_ptr(), O_WRONLY + O_CREAT + O_APPEND, 420)
    if fd < 0
        return
    var line: String = string_new()
    line.push_str(strview_from_cstr(path))
    line.push('\n')
    sys_write(fd, line.as_ptr(), line.len() as i64)
    sys_close(fd)

# 1 when environment variable `name` holds a truthy value; 0 when it is
# unset, empty or "0".  (RITZ1_PARSE_ONLY, AGAST #4379.)
fn env_flag(name: StrView) -> i32
    let v: StrView = env_get_or(name, strview_empty())
    if v.len == 0
        return 0
    if v.len == 1 and *v.ptr == '0'
        return 0
    1

# The offset of each line of buf[0..len) (malloc'd, freed by the caller), and
# their count in *out_count.  Line n (1-based) starts at starts[n - 1].
fn line_starts(buf_sv: StrView, out_count: *i32) -> *i64
    var buf: *u8 = buf_sv.ptr
    var len: i64 = buf_sv.len
    var n: i32 = 1
    for i in 0..len
        if *(buf + i) == '\n'
            n = n + 1
    let starts: *i64 = malloc((n as i64) * 8) as *i64
    *starts = 0
    var k: i32 = 1
    for j in 0..len
        if *(buf + j) == '\n'
            *(starts + k) = j + 1
            k = k + 1
    *out_count = n
    starts

# 1 if line `n` (1-based) of buf, indexed by `starts`, holds `= extern`; 0
# if not or past the end.
fn line_has_extern_decl(buf_sv: StrView, starts: *i64, count: i32, n: i32) -> i32
    var buf: *u8 = buf_sv.ptr
    var len: i64 = buf_sv.len
    if n < 1 or n > count
        return 0
    var i: i64 = *(starts + (n - 1))
    var stop: i64 = len
    if n < count
        stop = *(starts + n) - 1
    while i + 8 <= stop
        if (StrView { ptr: (buf + i), len: (stop - i) as i64 }).starts_with("= extern")
            return 1
        i = i + 1
    0

# AGAST #3419: an interface text appends ` = extern` to every header whose
# body it dropped, so each of those parses as a written declaration
# (decl_fn_def_new's extern_decl), which no `pub` check reads.  The text
# keeps the source's line numbers: a declaration is written iff the source's
# own line where the text's header ends says `= extern` too.
struct IfaceLines
    text: *u8
    text_len: i64
    text_starts: *i64
    text_count: i32
    src: *u8
    src_len: i64
    src_starts: *i64
    src_count: i32

fn iface_fix_extern_decl(f: *FnDef, l: *IfaceLines)
    if f.extern_decl == 0
        return
    var n: i32 = f.line
    while n <= l.text_count and line_has_extern_decl(StrView { ptr: (l.text), len: (l.text_len) }, l.text_starts, l.text_count, n) == 0
        n = n + 1
    if n > l.text_count
        return
    if line_has_extern_decl(StrView { ptr: (l.src), len: (l.src_len) }, l.src_starts, l.src_count, n) == 0
        f.extern_decl = 0

fn iface_fix_extern_decls(m: *Module, text_sv: StrView, src_sv: StrView)
    var text: *u8 = text_sv.ptr
    var text_len: i64 = text_sv.len
    var src: *u8 = src_sv.ptr
    var src_len: i64 = src_sv.len
    var l: IfaceLines = IfaceLines { text: text, text_len: text_len, text_starts: null, text_count: 0, src: src, src_len: src_len, src_starts: null, src_count: 0 }
    l.text_starts = line_starts(StrView { ptr: (text), len: (text_len) }, @l.text_count)
    l.src_starts = line_starts(StrView { ptr: (src), len: (src_len) }, @l.src_count)
    var f: *FnDef = m.functions
    while f != null
        iface_fix_extern_decl(f, @l)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var mt: *FnDef = ib.methods
        while mt != null
            iface_fix_extern_decl(mt, @l)
            mt = mt.next
        ib = ib.next
    free(l.text_starts as *u8)
    free(l.src_starts as *u8)

# Read / tokenize / parse a single import: its stored interface text if
# there is one, else its source.  Returns a parsed Module, or null on any
# failure (already reported to stderr).  Steals the buffers' data to keep
# the AST-pointed-into bytes alive via keep_source_alive().
fn load_and_parse(ctx: *ParseCtx, path: @&String) -> *Module
    let path_ptr: *u8 = path.as_ptr()
    var src: Vec<u8> = read_file(path_ptr)
    if src.len == 0
        return null

    var text: Vec<u8> = read_iface_text(StrView { ptr: (src.data), len: (src.len - 1) })
    var lex_buf: *u8 = src.data
    var lex_len: i64 = src.len - 1
    if text.len > 0
        lex_buf = text.data
        lex_len = text.len - 1
    else
        parse_log_note(path_ptr)

    var tokens: Vec<Token> = vec_with_cap<Token>(24000)
    let lex_err: i32 = tokenize(path_ptr, StrView { ptr: (lex_buf), len: (lex_len) }, @tokens)
    if lex_err > 0
        err2("Lexer errors in: ", path_ptr)
        return null

    # A miss: the interface text, from the tokens as the lexer made them.
    var made: Vec<u8> = vec_new<u8>()
    var made_ok: bool = false
    if text.len == 0 and iface_text_build(StrView { ptr: (src.data), len: (src.len - 1) }, tokens.data, tokens.len, @&made) == 0
        made_ok = true

    # AGAST #4609: the twins this file sees, renamed for the second pass;
    # after the interface text is made, which keeps the source's names.
    twin_rename_tokens(ctx, path_ptr, tokens.data, tokens.len)

    # Name the file in parse diagnostics (AGAST #1301).
    parser_set_source_file(ctx, path_ptr)
    let mod: *Module = parse_tokens(ctx, @tokens)
    if mod == null
        err2("Parse error in: ", path_ptr)
        return null
    # The cached IR depends on the interface text (AGAST #1807, #2113): the
    # one read, or the one stored now.  If none could be stored, on the
    # source's bytes, which fn_cache's check reads when there is no text.
    var dep_buf: *u8 = src.data
    var dep_len: i64 = src.len - 1
    if text.len > 0
        iface_fix_extern_decls(mod, StrView { ptr: (lex_buf), len: (lex_len) }, StrView { ptr: (src.data), len: (src.len - 1) })   # AGAST #3419
        dep_buf = text.data
        dep_len = text.len - 1
    else if made_ok
        # Stored only once the source has parsed, as ritz0 does.
        if iface_text_store(StrView { ptr: (src.data), len: (src.len - 1) }, StrView { ptr: (made.data), len: (made.len) }) == 0
            dep_buf = made.data
            dep_len = made.len
    if add_enum_from_fns(ctx, mod, path_ptr) < 0
        return null

    dep_record_note(path_ptr, StrView { ptr: (dep_buf), len: (dep_len) })

    # Keep the lexed buffer alive: AST nodes point into it.
    keep_source_alive(lex_buf)
    src.data = null  # Prevent Vec Drop from freeing.
    text.data = null

    mod

# =============================================================================
# Module interfaces (G9b, AGAST #1899)
# =============================================================================
#
# An imported module contributes only *declarations* to this file's IR: its
# fns are is_local == 0 and emit as `declare`.  But monomorph's instantiation
# collector and the emitter's enum-type scans walk EVERY body in the merged
# module, so a body-only edit to an import used to change the importer's IR
# (e.g. an extra internal instantiation only the import itself needs).
#
# So each import is cut down to its interface as it is loaded, with ritz0's
# rule (ritz0/module_interface.py body_needed): every fn body is dropped
# except those the importer instantiates itself -- generic fns, and methods
# of generic impls or with their own type params -- and async fns, whose
# future the importer builds from their locals (AGAST #3814).  ritz1 parses
# trait default bodies without keeping them, so this drops a superset of
# what ritz0's interface drops: the importer's IR depends only
# on what ritz0's interface hash covers, which is what build.py keys ritz1
# objects on (cas_module_key).
#
# An import read from its interface text (#1901, load_and_parse) holds
# `= extern` declarations where the bodies were; they share the same
# stripped_body() sentinel, so stripping it again changes nothing.

# Every stripped fn shares ast_helpers' stripped_body(), the body of a
# declaration-only `fn ... = extern` too (#1900).  Non-null on purpose:
# `body == null` means `extern fn`.

fn strip_to_interface(ctx: *ParseCtx, m: *Module)
    let body: *Stmt = stripped_body(ctx)
    var f: *FnDef = m.functions
    while f != null
        # An async fn keeps its body, as in ritz0: the importer builds its
        # future, whose fields are the fn's locals (AGAST #3814).
        # A pub [[inline]] fn keeps its body too, as in the interface text:
        # an eligible one the importer defines available_externally, so -O2
        # can inline it (fn_inline_kept, fn_inline_import; AGAST #3585).
        # A generated `E.from` keeps its body too: each object defines its own
        # (AGAST #4609), as ritz0's body_needed keeps it.
        if f.type_params == null and f.body != null and f.is_async == 0 and fn_inline_kept(ctx, f) == 0 and f.from_generated != 1
            f.body = body
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                if method.type_params == null and method.body != null
                    method.body = body
                method = method.next
        ib = ib.next

# Resolve imports recursively, merging into the main module.
# `m_path` is m's own file (AGAST #2148: check_fn_conflicts' ordering).
fn resolve_imports(ctx: *ParseCtx, m: *Module, m_path: *u8, source_dir: StrView, ritz_path: StrView) -> i32
    var m_key: String = import_key(m_path)
    let vm: *VisMod = vis_module(m_key.as_ptr())
    var imp: *ImportDecl = m.imports
    while imp != null
        # Find the import file.
        var found_via_ritz_path: i32 = 0
        var path: String = try_open_import(imp.path, source_dir, ritz_path, @found_via_ritz_path)
        if path.is_empty()
            var msg: String = string_from("Error: Could not read import: ")
            append_import_display(@msg, imp.path)
            msg.push_str(".ritz")
            eprintln_string(@msg)
            return -1

        # Cycle detection.
        var key: String = import_key(path.as_ptr())
        vis_edge(vm, key.as_ptr(), imp)   # AGAST #3891
        let import_vm: *VisMod = vis_module(key.as_ptr())
        if was_import_processed(@key) == 1
            imp = imp.next
            continue
        mark_import_processed(key)

        let decl_mark: i32 = type_decl_log_count(ctx)   # AGAST #3907
        let trait_mark: i32 = trait_declared_count(ctx)   # AGAST #3467
        let gated_mark: i32 = gated_decl_count(ctx)
        let import_module: *Module = load_and_parse(ctx, @&path)
        if import_module == null
            return -1
        strip_to_interface(ctx, import_module)
        vis_names(import_vm, import_module)   # before its imports merge in
        vis_type_names(ctx, import_vm, decl_mark)   # its enums and aliases
        vis_r54_names(ctx, import_vm, trait_mark, gated_mark)   # R54's extra names
        if check_fn_dups_in_file(import_module) < 0
            return -1

        # Child imports: ALWAYS use the resolved file's directory as the
        # source_dir for relative imports.  Earlier behaviour cleared
        # source_dir whenever the file was found via RITZ_PATH (i.e. the
        # symlink-farm path the workspace builds use), which broke bare
        # imports inside dependency packages — e.g. squeeze/lib/gzip.ritz
        # has `import crc32` that should resolve as a sibling file, but
        # source_dir was empty so it fell through to RITZ_PATH, where no
        # bare `crc32.ritz` exists.
        #
        # ritzlib's internal imports are not affected — try_open_import
        # special-cases ritzlib.* and skips source_dir for those, so
        # they continue to flow through RITZ_PATH.
        let child_dir: StrView = path_dir(path.as_ptr())
        let res: i32 = resolve_imports(ctx, import_module, path.as_ptr(), child_dir, ritz_path)
        if res < 0
            return -1

        if check_const_conflicts(m, import_module, path.as_ptr()) < 0
            return -1
        if check_fn_conflicts(m, import_module, m_path) < 0
            return -1
        merge_module_into(m, import_module)

        imp = imp.next

    0

# =============================================================================
# Argument parsing
# =============================================================================

struct CliArgs
    input_path: *u8
    output_path: *u8
    ritz_path: StrView    # .len == 0 if none was supplied
    dash_dash: i32
    # `--target-os <os>` (AGAST #1550): selects `[[target_os = "..."]]`
    # variants.  Defaults to "linux", as ritz0's --target-os does.
    target_os: StrView
    # `--target-arch <arch>` (LANGUAGE_SPEC §17.2, AGAST #4117): selects
    # `[[target_arch = "..."]]` variants.  Defaults to "x86_64", the arch of
    # the triple ritz1 emits (emitter.ritz); ritz0 derives its default from
    # --target's triple.
    target_arch: StrView
    # `--target <triple>` (AGAST #4607): the triple build_pipeline passes
    # ritz0 too.  ritz1 reads only whether it is freestanding (`-none-`):
    # a trap or a failing assert then stops through ritz_platform_fatal.
    # Empty when not given.
    target: StrView
    # `--test-table` (AGAST #1908): compile as the root of a test binary
    # (LANGUAGE_SPEC §17.1), as ritz0's --test-table does.
    test_table: i32
    # `--iface-text` (AGAST #2113): write the input's interface text to the
    # output path instead of compiling it (ritz0/test_interface_text.py
    # compares it with ritz0's over the corpus).
    iface_text: i32
    # `--parse-only` (AGAST #4379): lex and parse, report the wall time, then
    # stop before anything reads the AST.  RITZ1_PARSE_ONLY=1 does the same.
    parse_only: i32
    # `--stack-protector` (AGAST #2590): every fn but a [[naked]] one gets
    # LLVM's sspstrong, as ritz0's --stack-protector does.
    stack_protector: i32
    # `--no-red-zone` (AGAST #4308): every fn ritz1 defines gets LLVM's
    # noredzone, as ritz0's --no-red-zone does.
    no_red_zone: i32
    # Every `--dep <name>=<dir>` (AGAST #3825), in order, `:`-joined; null
    # and 0 when there is none.  See g_dep_ptr.
    deps_ptr: *u8
    deps_len: i64

# Append `entry` to the `:`-joined list at `*ptr`/`*len`.  The old buffer is
# leaked, like -I's merge below: the compiler runs once per process.
fn deps_append(ptr: **u8, len: *i64, entry: *u8)
    let n: i64 = strlen(entry)
    let sep: i64 = if *len > 0 then 1 else 0
    let buf: *u8 = malloc(*len + sep + n + 1)
    if *len > 0
        memcpy(buf, *ptr, *len)
        *(buf + *len) = ':' as u8
    memcpy(buf + *len + sep, entry, n)
    *(buf + *len + sep + n) = 0 as u8
    *ptr = buf
    *len = *len + sep + n

# 1 when `s` is `<name>=<dir>` with neither part empty.
fn dep_entry_ok(s: *u8) -> i32
    let n: i64 = strlen(s)
    var i: i64 = 0
    while i < n
        if *(s + i) == '='
            if i > 0 and i + 1 < n
                return 1
            return 0
        i = i + 1
    0

# `ritz1 -- <input>` output: $TMPDIR/ritz1_dashdash_<pid>.ll, $TMPDIR
# defaulting to /tmp (AGAST #4216).  It was a fixed /tmp name, which two
# concurrent runs on one host (rooms, gates) both wrote.
var g_dashdash_out: [4200]u8

fn dashdash_output_path() -> StrView
    var dir: StrView = env_get_or("TMPDIR", strview_empty())
    if dir.len == 0 or dir.len > 4096
        dir = "/tmp"
    let dst: *u8 = @g_dashdash_out[0]
    var i: i64 = 0
    while i < dir.len
        *(dst + i) = *(dir.ptr + i)
        i = i + 1
    let name: StrView = "/ritz1_dashdash_"
    var k: i64 = 0
    while k < name.len
        *(dst + i) = *(name.ptr + k)
        i = i + 1
        k = k + 1
    let pid: [u8] = Span<u8> { ptr: dst + i, len: FMT_DEC_MAX }   # g_dashdash_out has room
    i = i + fmt_i64_into(pid, sys_getpid() as i64).len
    let ext: StrView = ".ll"
    k = 0
    while k < ext.len
        *(dst + i) = *(ext.ptr + k)
        i = i + 1
        k = k + 1
    *(dst + i) = 0
    StrView { ptr: (dst), len: (i) as i64 }

# `argv` is main's `args` (#204): each view points into the kernel's argv,
# so its `.ptr` is NUL-terminated and serves as a `*u8` path.
fn parse_cli(argv: Span<StrView>) -> CliArgs
    var args: CliArgs
    args.input_path = null
    args.output_path = null
    args.ritz_path.ptr = null
    args.ritz_path.len = 0
    args.dash_dash = 0
    args.target_os = strview_from_cstr(c"linux")
    args.target_arch = strview_from_cstr(c"x86_64")
    args.target = strview_empty()
    args.test_table = 0
    args.iface_text = 0
    args.parse_only = 0
    args.stack_protector = 0
    args.no_red_zone = 0
    args.deps_ptr = null
    args.deps_len = 0

    if argv.len < 2
        return args

    let first: StrView = argv[1]

    # Support `ritz1 -- <input.ritz>` form used by test harnesses.
    if first.eq("--")
        args.dash_dash = 1
        if argv.len < 3
            return args
        args.input_path = argv[2].ptr
        args.output_path = dashdash_output_path().ptr
        return args

    if argv.len < 4
        return args

    args.input_path = argv[1].ptr
    let flag: StrView = argv[2]
    if not flag.eq("-o")
        eprintln("Error: Expected -o flag")
        args.input_path = null
        return args
    args.output_path = argv[3].ptr

    # Options after `-o <out>`, in any order:
    #   -I <path>          additive to RITZ_PATH, not a replacement.  Treats
    #                      `-I` like gcc's: prepends to the lookup list.
    #   --target-os <os>   see CliArgs.target_os.
    #   --target-arch <a>  see CliArgs.target_arch.
    #   --target <triple>  see CliArgs.target.
    #   --test-table       see CliArgs.test_table.
    #   --iface-text       see CliArgs.iface_text.
    #   --parse-only       see CliArgs.parse_only.
    #   --stack-protector  see CliArgs.stack_protector.
    #   --no-red-zone      see CliArgs.no_red_zone.
    #   --dep <name>=<dir> repeatable; see try_open_import.
    # Anything else is ignored, as it always has been.
    var dash_i_view: StrView
    dash_i_view.ptr = null
    dash_i_view.len = 0
    var i: i64 = 4
    while i < argv.len
        let opt: StrView = argv[i]
        let is_dash_i: bool = opt.eq("-I")
        let is_target_os: bool = opt.eq("--target-os")
        let is_target_arch: bool = opt.eq("--target-arch")
        let is_target: bool = opt.eq("--target")
        let is_dep: bool = opt.eq("--dep")
        if opt.eq("--test-table")
            args.test_table = 1
            i = i + 1
        else if opt.eq("--iface-text")
            args.iface_text = 1
            i = i + 1
        else if opt.eq("--parse-only")
            args.parse_only = 1
            i = i + 1
        else if opt.eq("--stack-protector")
            args.stack_protector = 1
            i = i + 1
        else if opt.eq("--no-red-zone")
            args.no_red_zone = 1
            i = i + 1
        else if is_dep
            if i + 1 >= argv.len or dep_entry_ok(argv[i + 1].ptr) == 0
                eprintln("Error: --dep needs <name>=<dir>")
                args.input_path = null
                return args
            deps_append(@&args.deps_ptr, @&args.deps_len, argv[i + 1].ptr)
            i = i + 2
        else if is_dash_i or is_target_os or is_target_arch or is_target
            if i + 1 >= argv.len
                if is_dash_i
                    eprintln("Error: -I needs a path")
                else if is_target_os
                    eprintln("Error: --target-os needs an OS name")
                else if is_target
                    eprintln("Error: --target needs a target triple")
                else
                    eprintln("Error: --target-arch needs an architecture name")
                args.input_path = null
                return args
            if is_dash_i
                dash_i_view = argv[i + 1]
            else if is_target_os
                args.target_os = argv[i + 1]
            else if is_target
                args.target = argv[i + 1]
            else
                args.target_arch = argv[i + 1]
            i = i + 2
        else
            i = i + 1

    # Pull RITZ_PATH from env (if any) and merge with -I.  Earlier behaviour
    # was: -I OVERRIDES env, which broke workspace builds where the wrapper
    # script (`./rz`) passes a multi-project RITZ_PATH for cross-project
    # imports, but build.py also passes `-I <ritz_root>` for ritzlib.
    # ritzlib.os.env (AGAST #1750).  The view points into the cached
    # /proc/self/environ bytes, which stay alive for the whole process.
    let env_view: StrView = env_get_or("RITZ_PATH", strview_empty())

    if dash_i_view.len > 0 and env_view.len > 0
        # Merge: <-I path>:<env path>.  We allocate a small buffer; this
        # is leaked by design (the compiler runs once per process).
        let total: i64 = dash_i_view.len + 1 + env_view.len + 1
        let buf: *u8 = malloc(total)
        memcpy(buf, dash_i_view.ptr, dash_i_view.len)
        *(buf + dash_i_view.len) = ':' as u8
        memcpy(buf + dash_i_view.len + 1, env_view.ptr, env_view.len)
        *(buf + dash_i_view.len + 1 + env_view.len) = 0 as u8
        args.ritz_path.ptr = buf
        args.ritz_path.len = dash_i_view.len + 1 + env_view.len
    else if dash_i_view.len > 0
        args.ritz_path = dash_i_view
    else if env_view.len > 0
        args.ritz_path = env_view

    args

# Ensure a RITZ_PATH view ends with '/'. May allocate if it doesn't; caller
# doesn't need to free (we leak the small buffer — compiler runs once).
fn normalize_ritz_path(rp: StrView) -> StrView
    if rp.len == 0
        return rp
    if *(rp.ptr + rp.len - 1) == '/'
        return rp
    let buf: *u8 = malloc(rp.len + 2)
    for k in 0..rp.len
        *(buf + k) = *(rp.ptr + k)
    *(buf + rp.len) = '/'
    *(buf + rp.len + 1) = 0
    var out: StrView
    out.ptr = buf
    out.len = rp.len + 1
    out

# Unlink the input file's own `fn main` from m.functions (test mode).
fn drop_local_main(m: *Module)
    var prev: *FnDef = null
    var f: *FnDef = m.functions
    while f != null
        let next: *FnDef = f.next
        if f.is_local == 1 and (StrView { ptr: (f.name), len: (f.name_len) as i64 }).eq("main")
            if prev == null
                m.functions = next
            else
                prev.next = next
        else
            prev = f
        f = next

fn print_usage()
    eprintln("Usage: ritz1 <input.ritz> -o <output.ll> [-I <ritz_path>] [--target-os <os>] [--target-arch <arch>] [--target <triple>] [--test-table] [--iface-text] [--parse-only] [--stack-protector] [--no-red-zone] [--dep <name>=<dir>]...")
    eprintln("       ritz1 -- <input.ritz>")

# Parse the main file's tokens, mark its fns local, and resolve (parse and
# merge) its imports.  Returns null on any failure (already reported).
# Called twice when the first pass records a type alias (AGAST #1475).
fn parse_program(ctx: *ParseCtx, tokens: *Vec<Token>, input_path: *u8, source_dir: StrView, ritz_path: StrView) -> *Module
    # Parse
    parser_set_source_file(ctx, input_path)
    let decl_mark: i32 = type_decl_log_count(ctx)   # AGAST #3907
    let alias_mark: i32 = alias_use_count(ctx)
    let m: *Module = parse_tokens(ctx, tokens)
    vis_alias_uses_set(alias_mark, alias_use_count(ctx))
    if m == null
        return null
    if add_enum_from_fns(ctx, m, input_path) < 0
        return null
    if lower_main(ctx, m, input_path) < 0
        return null
    if check_fn_dups_in_file(m) < 0
        return null

    # AGAST #194: mark every FnDef parsed from THIS file as is_local=1
    # *before* resolve_imports prepends imported FnDefs (those stay
    # is_local=0). emit_fn uses the flag to decide define-vs-declare —
    # only local fns get a body, imports become extern declarations.
    # This is the core of modular emit: each .ll contains only the
    # current file's bodies + its own (internal) monomorph instantiations.
    # A declaration-only `fn ... = extern` (#1900) is defined in another
    # object: it stays is_local=0 and is declared as an import is.
    var local_fn: *FnDef = m.functions
    while local_fn != null
        if fn_is_decl(ctx, local_fn) == 0
            local_fn.is_local = 1
        local_fn = local_fn.next
    var local_ib: *ImplBlock = m.impls
    while local_ib != null
        var local_method: *FnDef = local_ib.methods
        while local_method != null
            if fn_is_decl(ctx, local_method) == 0
                local_method.is_local = 1
            local_method = local_method.next
        local_ib = local_ib.next

    # Resolve imports recursively
    # An import cycle back to this file must not merge it again (as ritz0's
    # resolve() adds the main file to processed_files first): its fns would
    # conflict with themselves (AGAST #2148).
    var main_key: String = import_key(input_path)
    let main_vm: *VisMod = vis_module(main_key.as_ptr())
    vis_edges_reset(main_vm)   # a second pass lists its imports afresh
    vis_names(main_vm, m)   # AGAST #3891: before its imports merge in
    vis_type_names(ctx, main_vm, decl_mark)   # AGAST #3907: its enums and aliases
    mark_import_processed(import_key(input_path))
    if resolve_imports(ctx, m, input_path, source_dir, ritz_path) < 0
        eprintln("Error: Import resolution failed")
        return null
    keep_one_fn(m)   # AGAST #1858: one of each name the input sees
    # AGAST #4609: two definitions of one type name conflict only where a
    # file sees both; a twin the input doesn't see is renamed by the second
    # pass (main), so this pass's other checks see both under one name.
    if type_twins_settle(ctx, m, input_path) < 0
        return null
    # AGAST #4111: every struct of the closure is noted now, gated out or not.
    if struct_variants_check() < 0
        return null
    # AGAST #4055: two fns gated out for one other target.
    if fn_variants_check() < 0
        return null
    vis_compute(main_vm)
    # LARB R54 (AGAST #3467): each name of a selective import is one its
    # module defines, before any later pass reads the merged module.
    if vis_selective_check(main_vm, input_path) > 0
        return null

    m

# =============================================================================
# Main Entry Point
# =============================================================================

pub fn main(argv: Span<StrView>) -> i32
    let ctx: *ParseCtx = parse_ctx_new()   # AGAST #4623: the compile's parse state
    let args: CliArgs = parse_cli(argv)
    if args.input_path == null
        print_usage()
        return 1
    set_target_os(ctx, StrView { ptr: (args.target_os.ptr), len: (args.target_os.len as i32) as i64 })
    set_target_arch(ctx, StrView { ptr: (args.target_arch.ptr), len: (args.target_arch.len as i32) as i64 })
    # Cached IR depends on the compiler, the target OS, the target arch and
    # the import roots (see cache_fingerprint in fn_cache.ritz).
    g_dep_ptr = args.deps_ptr
    g_dep_len = args.deps_len
    g_test_table = args.test_table   # lower_main (AGAST #200)
    emitter_set_stack_protector(args.stack_protector)   # AGAST #2590
    emitter_set_no_red_zone(args.no_red_zone)           # AGAST #4308
    let freestanding: i32 = target_is_freestanding(args.target)   # AGAST #4607
    let cache_fp: u64 = cache_fingerprint(StrView { ptr: (args.target_os.ptr), len: (args.target_os.len) }, StrView { ptr: (args.target_arch.ptr), len: (args.target_arch.len) }, StrView { ptr: (args.ritz_path.ptr), len: (args.ritz_path.len) }, args.input_path, StrView { ptr: (args.deps_ptr), len: (args.deps_len) }, args.stack_protector, args.no_red_zone, freestanding)

    # Read source file
    var src: Vec<u8> = read_file(args.input_path)
    if src.len == 0
        return 1

    # The interface text alone: lexed, never parsed (AGAST #2113).
    if args.iface_text == 1
        var itoks: Vec<Token> = vec_with_cap<Token>(24000)
        if tokenize(args.input_path, StrView { ptr: (src.data), len: (src.len - 1) }, @itoks) > 0
            return 1
        var itext: Vec<u8> = vec_new<u8>()
        if iface_text_build(StrView { ptr: (src.data), len: (src.len - 1) }, itoks.data, itoks.len, @&itext) < 0
            err2("Error: a declared fn has no body lines in: ", args.input_path)
            return 1
        if write_file(args.output_path, StrView { ptr: (itext.data), len: (itext.len) }) < 0
            return 1
        return 0

    # RITZ1_PARSE_ONLY=1 or `--parse-only` (AGAST #4379): lex and parse, then
    # stop before the first check reads the AST.  It reports lex/parse wall
    # time on stderr, so a #4374-style parse regression can be measured with
    # the compiler's own clock instead of an external one.  The mode neither
    # reads nor writes the sig cache (that fast path skips the parse it is
    # meant to measure) and writes no .ll.  Unset or "0": a no-op.
    let parse_only: i32 = if args.parse_only == 1 then 1 else env_flag(strview_from_cstr(c"RITZ1_PARSE_ONLY"))

    # File-level fast path: if the sig records this source, this compiler
    # identity and unchanged imports, and the .ll is current (or can be
    # spliced from the sig), skip lex/parse/emit entirely.  This is the single biggest win for
    # no-op rebuilds (full-stack 12m30s → ~30s).
    # Test mode's IR is not the module's: it neither reads nor writes the sig
    # (ritz0 skips its fn cache in test mode too).
    if parse_only == 0 and args.test_table == 0 and check_source_unchanged(args.input_path, StrView { ptr: (src.data), len: (src.len - 1) }, args.output_path, cache_fp) == 1
        var skip_msg: String = string_from("Skipped (unchanged): ")
        skip_msg.push_str(strview_from_cstr(args.input_path))
        println_string(@skip_msg)
        return 0

    # Tokenize. Typical compiler input files produce under 20K tokens;
    # bigger files realloc organically.
    parse_log_note(args.input_path)
    var tokens: Vec<Token> = vec_with_cap<Token>(24000)
    let lex_start: i64 = if parse_only == 1 then now_nanos() else 0
    let lex_errors: i32 = tokenize(args.input_path, StrView { ptr: (src.data), len: (src.len - 1) }, @tokens)
    let lex_end: i64 = if parse_only == 1 then now_nanos() else 0
    if lex_errors > 0
        var msg: String = string_from("Lexer errors: ")
        msg.push_i64(lex_errors as i64)
        eprintln_string(@msg)
        return 1

    # Get source directory for relative imports
    let source_dir: StrView = path_dir(args.input_path)
    let ritz_path: StrView = normalize_ritz_path(args.ritz_path)

    # Parse this file and everything it imports.
    let parse_start: i64 = if parse_only == 1 then now_nanos() else 0
    var m: *Module = parse_program(ctx, @tokens, args.input_path, source_dir, ritz_path)
    if m == null
        return 1

    # AGAST #1475: type aliases resolve at parse time (type_named replays the
    # target's parse state).  The first pass can't see an alias used before
    # its declaration, or declared in an imported module (imports are parsed
    # after their importer), so if it recorded any alias, parse everything
    # again with the alias table populated.  Programs without aliases (ritz1
    # itself included) pay nothing.
    # AGAST #2167: likewise an array length naming a const the first pass
    # hadn't parsed yet (imported, or declared later): the second pass folds
    # it against every const the first one merged.
    # AGAST #4609: likewise a twin type to rename (type_twins.ritz).
    # AGAST #4769: the second pass parses an importer before its imports, so
    # it can replay an alias's first-pass snapshot (`[N]u8` with an imported
    # N, not folded yet) before the alias's own file records the folded one.
    # alias_stale() says a use did; parse once more, against settled aliases.
    # Each such pass settles at least one more alias (an alias of an alias,
    # each in its own module, settles one link per pass), so the alias count
    # plus two passes always suffice; past that the table is cycling.
    var passes: i32 = 1
    var again: bool = type_alias_count(ctx) > 0 or array_len_pending(ctx) > 0 or twin_renames_pending(ctx) == 1
    while again
        again = false
        alias_stale_clear(ctx)
        array_len_seed(ctx, m.constants)
        processed_vec().clear()
        dep_record_reset()
        enum_program_reset(ctx)
        tuple_regs_reset(ctx)   # AGAST #3030
        tn_notes_reset(ctx)     # AGAST #4021
        test_fns_reset(ctx)
        struct_variants_reset()
        named_forms_reset(ctx)   # AGAST #4187
        # Fresh views: ritz0's move checker treats StrView as move-only
        # (AGAST #1489), so the first pass's copies can't be passed again.
        let source_dir2: StrView = path_dir(args.input_path)
        let ritz_path2: StrView = normalize_ritz_path(args.ritz_path)
        m = parse_program(ctx, @tokens, args.input_path, source_dir2, ritz_path2)
        if m == null
            return 1
        passes = passes + 1
        again = alias_stale(ctx) and passes < type_alias_count(ctx) + 2
    if alias_stale(ctx)
        # Never emit what a stale snapshot built (a `[0 x T]` global).
        eprintln("error: type aliases did not settle: a use keeps replaying a changed alias")
        return 1
    let parse_end: i64 = if parse_only == 1 then now_nanos() else 0
    twin_variant_views(ctx, m)   # AGAST #4609

    # RITZ1_PARSE_ONLY (AGAST #4379): the parse phase, alias second pass
    # included, is done; every phase after this point reads the AST.  Report
    # the wall time and stop with success, writing neither IR nor a sig.
    if parse_only == 1
        eprints("ritz1 parse-only: path=")
        eprints_cstr(args.input_path)
        eprint(" lex_ns={lex_end - lex_start} parse_ns={parse_end - parse_start}\n")
        return 0

    # AGAST #3994: the program's enum nodes are the merged Module.enums; the
    # accessors every later pass calls (sema, emitter, monomorph) index that
    # root.  Set it before the first reader (named_variants_resolve).
    enum_program_set(ctx, m)

    # `V { b, a } =>` and `V { a: 1, b: 2 }` -> their positional forms
    # (AGAST #4187), before any pass reads a pattern or a literal.
    if named_variants_resolve(ctx, m) > 0
        return 1

    # Test mode (LANGUAGE_SPEC §17.1): ritzunit supplies `main`, so the
    # file's own goes, before anything can emit or call it.
    if args.test_table == 1
        drop_local_main(m)
        emitter_set_test_mode(1)

    # An `impl` on a built-in type no module declares (AGAST #3162): before
    # the template below makes `Span` look declared.
    if refuse_impls_on_builtin_types(ctx, m, args.input_path) > 0
        return 1
    # ...or on a type nothing declares or imports (AGAST #3264).
    if refuse_impls_on_unknown_types(ctx, m, args.input_path) > 0
        return 1
    # ...or outside its type's (or trait's) file, or on one instantiation
    # (LARB R65, AGAST #3494).
    if refuse_misplaced_impls(ctx, m, args.input_path) > 0
        return 1

    # `Span<T>` without `import ritzlib.span` (AGAST #3127): before anything
    # resolves a `Span<X>` against the module's structs.
    ensure_builtin_span_template(m)

    # A local named like a const, global or variant (AGAST #2407).  Before
    # monomorphisation, so a generic fn is judged once, used or not.
    if binder_check_module(ctx, m, args.input_path) > 0
        return 1

    # `async fn` / `await` become ritz0's state machine (AGAST #3814), once,
    # before the remaining checks and the emit; a bare async call is refused
    # (§16.2).  After binder_check (AGAST #4230): lowering turns an async fn's
    # `let` into a future's field, so a later binding of its name would no
    # longer be seen as a reuse.  ritz0 judges binders on the source too.
    if async_lower_module(m, args.input_path) > 0
        return 1

    # A written type name that names nothing (AGAST #3932): it emitted `%Nope`
    # IR clang refused, unlocated.  Before monomorphisation, as binder_check.
    if refuse_unknown_type_names(ctx, m) > 0
        return 1

    # A statement that can never run (AGAST #2520, LARB): before
    # monomorphisation, so a generic fn is judged once, used or not.
    if reach_check_module(m, args.input_path) > 0
        return 1

    # Monomorphize: generate specialized versions of generic functions.  It
    # also rewrites `m[k]` on a struct into its Index/IndexMut/IndexSet call,
    # and refuses (located) a use the struct's traits don't cover (§7.8).
    # `f(args)` to a generic `f<T>` takes T from its arguments (§4.4, AGAST
    # #1982), so monomorph sees it as the spelled-out `f<T>(args)`.
    # Monomorphisation's tables, from generic inference through emission
    # (AGAST #4454: they were module globals).
    let mono: *MonoCtx = mono_ctx_new(ctx)
    if infer_generic_calls(mono, m, args.input_path) > 0
        return 1
    struct_index_set_file(args.input_path)
    monomorphize_module(mono, m)
    if struct_index_errors() > 0 or monomorph_errors(mono) > 0
        return 1

    # The checking phase (AGAST #3462, #1816): every check on Sema, over the
    # fns emit_module lowers.  Any error stops the compile before emission.
    # A new check goes there, not on EmitterState (ritz1/ARCHITECTURE.md).
    # RITZ1_SEMA_PROBE pins Sema's typer against the emitter's (AGAST #3501).
    let probe: StrView = env_get_or("RITZ1_SEMA_PROBE", strview_empty())
    if probe.len > 0
        sema_probe_enable((probe.len == 4 and *probe.ptr == 'd') as i32)
    if sema_check_module(mono, m, args.input_path) > 0
        return 1

    # Emit IR.  The module's text is a String on the module's Arena (AGAST
    # #4696); the whole arena goes back at once when this fn returns, after the
    # .ll is written.
    var ir_arena: Arena = ir_arena_open()
    defer ir_arena.destroy()
    var ir_alloc: Allocator = ir_arena.allocator()
    # Sized to the room left after the entry-alloca buffer (emit_module's), so it
    # never grows; see arena_string.
    let ir: *String = arena_string(@ir_alloc, ir_arena.remaining() - ENTRY_ALLOCA_BYTES - IR_ARENA_SLACK_BYTES)
    emitter_set_source_file(args.input_path)   # AGAST #1813
    let emit_errors: i32 = emit_module(m, ir, @ir_alloc, mono, freestanding)
    sema_probe_report()
    # AGAST #4609: a renamed twin's methods under the `T_m` its object defines.
    if twin_renames_pending(ctx) == 1
        let fixed: String = twin_fix_ir_symbols(ctx, m, ir.as_view())
        ir.clear()
        if not ir.push_string(@fixed)
            eprint("error: ritz1's IR for this module does not fit its arena\n")
            return 1

    # AGAST #1369.  This return value was previously discarded, and it was a
    # hardcoded 0 anyway: an expression the emitter could not lower was written
    # into the IR as a `; ERROR: ...` COMMENT, a zero was substituted for its
    # value, and the compiler exited 0.  Downstream, build.py printed its tick
    # and clang linked a program that segfaulted (a call through the
    # substituted null) or silently used a stale value (a dropped store).
    #
    # Refuse here, and refuse BEFORE write_file so no output is left for a
    # build system to pick up.  Individual messages have already gone to
    # stderr from emit_ir_error.
    #
    # AGAST #3257: the summary names only the errors printed without a
    # file:line:col.  After a located error alone it is noise, so it is left
    # out; the exit status is 1 either way.  Since #3445 every emit_ir_error
    # is located; what is left unlocated is emitter_core's
    # count_unlocated_error (a construct with no position to report).
    if emit_errors > 0
        let unlocated: i32 = emit_unlocated_errors()
        if unlocated > 0
            eprint("error: ritz1 emitted {unlocated as i64} unlowerable expression(s); refusing to write output\n")
        return 1

    # Write output
    if write_file(args.output_path, ir.as_view()) < 0
        return 1

    # Write the sig: source hash, compiler identity, import hashes and a
    # snapshot of the emitted IR.  Next invocation's `check_source_unchanged`
    # can then short-circuit emission entirely — even if the orchestrator
    # wiped its artifact tempdir, the cached IR lives in the sig cache and
    # gets spliced back into the requested output.
    if args.test_table == 1
        return 0
    var sig_out: *SigData = sig_data_new()
    if sig_out != null
        sig_out.source_hash = source_file_hash(StrView { ptr: (src.data), len: (src.len - 1) })
        # Stamp the sig with *this* binary's identity (AGAST #1279).  Without
        # it the cache is keyed on the source alone, so a rebuilt ritz1 reuses
        # IR emitted by the compiler it replaced.
        # AGAST #1550: and with the target OS, which picks the variants.
        sig_out.compiler_hash = cache_fp
        # Take a heap copy of ir.data — sig_data_free() owns the buffer.
        let ir_len: i64 = ir.len()
        if ir_len > 0
            let ir_copy: *u8 = malloc(ir_len + 1)
            if ir_copy != null
                memcpy(ir_copy, ir.as_view().ptr, ir_len)
                *(ir_copy + ir_len) = 0
                sig_out.module_ir = ir_copy
                sig_out.module_ir_len = ir_len
        # Every file the resolver loaded, with the bytes it parsed (#1807).
        sig_take_deps(sig_out)
        var sig_path: String = sig_path_from_src(args.input_path)
        write_sig_file(sig_path.as_ptr(), sig_out)
        sig_data_free(sig_out)

    0
