# ritz1/src/main.ritz - Main Entry Point for ritz1 Compiler
#
# The ritz1 compiler: compiles Ritz source to LLVM IR.
# Uses the generated parser (parser_gen.ritz) and emitter (emitter.ritz).
#
# Usage: ritz1 input.ritz -o output.ll [-I ritz_path]
#        ritz1 -- input.ritz               # end-of-flags; writes /tmp default
#
# Pipeline:
#   1. Read source file
#   2. Tokenize with NFA lexer
#   3. Parse to AST using generated parser
#   4. Resolve imports (recursively merge modules)
#   5. Monomorphize generics
#   6. Emit LLVM IR
#   7. Write to output file

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory
import ritzlib.option
import ritzlib.span
import ritzlib.os.env
import ritzlib.string
import ritzlib.strview

# Lexer and parser infrastructure
import tokens_gen
import nfa
import lexer_nfa
import lexer_setup_gen
import ast
import ast_helpers
import parser_gen
import monomorph
import emitter
import fn_cache
import sha256

# =============================================================================
# Error Reporting Helpers
# =============================================================================

# Print "prefix<path>suffix\n" as a single error line.
fn err2(prefix: StrView, path: *u8) -> i32
    var s: String = string_from_strview(@prefix)
    string_push_cstr(@s, path)
    eprintln_string(@s)
    string_drop(@s)
    -1

# Print "prefix<path>middle<extra>\n" as a single error line.
fn err3(prefix: StrView, path: *u8, extra: *u8) -> i32
    var s: String = string_from_strview(@prefix)
    string_push_cstr(@s, path)
    string_push_cstr(@s, extra)
    eprintln_string(@s)
    string_drop(@s)
    -1

# =============================================================================
# File I/O Helpers
# =============================================================================

fn read_file(path: *u8) -> Vec<u8>
    var buf: Vec<u8> = vec_new<u8>()
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        err2("Error: Cannot open file: ", path)
        return buf

    # Read in chunks
    var chunk: [4096]u8
    let chunk_ptr: *u8 = @chunk[0]
    var n: i64 = 1
    while n > 0
        n = sys_read(fd, chunk_ptr, 4096)
        if n > 0
            for i in 0..n
                vec_push<u8>(@buf, chunk[i])

    sys_close(fd)
    # Add null terminator
    vec_push<u8>(@buf, 0)
    buf

fn write_file(path: *u8, data: *u8, len: i64) -> i32
    let fd: i32 = sys_open3(path, O_WRONLY + O_CREAT + O_TRUNC, 420)
    if fd < 0
        return err2("Error: Cannot create output file: ", path)
    sys_write(fd, data, len)
    sys_close(fd)
    0

# =============================================================================
# Tokenizer
# =============================================================================

fn tokenize(path: *u8, src: *u8, src_len: i64, tokens: *Vec<Token>) -> i32
    # Allocate storage for lexer NFA structures
    var nfa_storage: NFA
    var patterns_storage: [128]TokenPattern
    # Sizes are repeated in the setup_lexer call below (ritz1 cannot parse a
    # const array dimension, so they cannot share a name). Keep them in step:
    # the NFA refuses to grow past what it is told, not past what exists.
    var states_storage: [4096]NFAState
    var trans_storage: [8192]Transition
    # Tier 1 NFA index buffers.
    var sto_storage: [4096]i32    # state_trans_offset[state]
    var stc_storage: [4096]i32    # state_trans_count[state]
    var ti_storage:  [8192]i32    # trans_indices[k]

    # Initialize lexer with NFA patterns
    var lex: Lexer
    setup_lexer(@lex, @nfa_storage, @patterns_storage[0], @states_storage[0], @trans_storage[0], @sto_storage[0], @stc_storage[0], @ti_storage[0], 4096, 8192)
    lexer_reset(@lex, src, src_len)

    var errors: i32 = 0
    while 1 == 1
        var tok: Token = lexer_next(@lex)
        let kind: i32 = tok.kind
        let line: i32 = tok.line
        let col: i32 = tok.col
        # For STRING-like tokens, copy string_val to heap (lexer buffer is on stack)
        let needs_copy: i32 = (kind == TOK_STRING or kind == TOK_CSTRING) as i32
        if needs_copy == 1 and tok.string_val != null and tok.string_len > 0
            let heap_str: *u8 = malloc(tok.string_len as i64)
            for i in 0..tok.string_len
                *(heap_str + i) = *(tok.string_val + i)
            tok.string_val = heap_str
        # Always push the token first (moves tok)
        vec_push<Token>(tokens, tok)
        # Then check conditions on kind (not tok)
        if kind == TOK_EOF
            break
        if kind == TOK_ERROR
            # "error: <path>:<line>:<col>: <what>", like the parser's
            # diagnostics (AGAST #1813).
            var msg: String = string_from("error: ")
            string_push_cstr(@msg, path)
            string_push_str(@msg, ":")
            string_push_i64(@msg, line as i64)
            string_push_str(@msg, ":")
            string_push_i64(@msg, col as i64)
            string_push_str(@msg, ": ")
            if lex.error_msg != null
                string_push_cstr(@msg, lex.error_msg)
                lex.error_msg = null
            else
                string_push_str(@msg, "Lexer error: unexpected character")
            eprintln_string(@msg)
            string_drop(@msg)
            errors = errors + 1

    errors

# =============================================================================
# Parser
# =============================================================================

fn parse_tokens(tokens: *Vec<Token>) -> *Module
    var p: Parser
    # Arena for AST nodes, sized to the input (AGAST #1730).  A fixed 4 MB
    # was NOT plenty: ritz1's own emitter_stmt.ritz overran it, and with no
    # bound check the overrun silently corrupted the heap.  Use interp.ritz's
    # bound (a few 128-byte nodes per token, 1 KB per token) with the old
    # 4 MB as a floor.  Untouched pages of a large malloc cost nothing.
    var arena_bytes: i64 = 4096 + (tokens.len as i64) * 1024
    if arena_bytes < 4194304
        arena_bytes = 4194304
    let arena: *u8 = malloc(arena_bytes)
    if arena == null
        eprintln("Error: Failed to allocate parser arena")
        return null
    parser_arena_set_cap(arena_bytes)
    parser_init(@p, tokens.data, tokens.len as i32, arena)

    let m: *Module = parse_module(@p)

    if p.error != 0
        var msg: String = string_from("Parse error at pos ")
        string_push_i64(@msg, p.pos as i64)
        eprintln_string(@msg)
        string_drop(@msg)
        return null

    m

# =============================================================================
# E.from (LANGUAGE_SPEC §10.4, AGAST #1880)
# =============================================================================

# Does `m` import ritzlib.option (the result type of a generated `from`)?
fn imports_option(m: *Module) -> i32
    var imp: *ImportDecl = m.imports
    while imp != null
        let a: *ImportPath = imp.path
        if a != null and a.next != null and a.next.next == null
            if a.segment_len == 7 and memcmp(a.segment, c"ritzlib", 7) == 0
                if a.next.segment_len == 6 and memcmp(a.next.segment, c"option", 6) == 0
                    return 1
        imp = imp.next
    0

# Parse the generated `E__from` fns of the enums with a representation type
# that `m` declared (tracker indices >= first_ei) into `m`, as if written in
# its source: ritz0 does the same (parser.py, _enum_from_fns).  Only for a
# module that imports ritzlib.option; elsewhere `E.from` is a located error
# (emit_expr_method).  Returns -1 on a lex/parse failure of the generated text.
fn add_enum_from_fns(m: *Module, first_ei: i32, path: *u8) -> i32
    if imports_option(m) == 0
        return 0
    var gen_len: i64 = 0
    let gen: *u8 = enum_from_source(first_ei, @gen_len)
    if gen == null or gen_len == 0
        return 0
    var tokens: Vec<Token> = vec_with_cap<Token>(1024)
    if tokenize(path, gen, gen_len, @tokens) > 0
        err2("Lexer errors in the generated from() of: ", path)
        return -1
    let gm: *Module = parse_tokens(@tokens)
    if gm == null
        err2("Parse error in the generated from() of: ", path)
        return -1
    keep_source_alive(gen)
    merge_module_into(m, gm)
    0

# =============================================================================
# Import Resolution - Inline imported code into the module
# =============================================================================

# Track processed import paths.  Vec<String> globals zero-initialise
# correctly (vec_new's null/0/0 shape matches LLVM zeroinitializer), so
# no explicit init pass is needed — vec_push grows on demand.
var g_processed: Vec<String>

# Source buffers backing AST string slices.  We "leak" each by stealing
# its `data` pointer from the local Vec<u8> in load_and_parse; the OS
# reclaims at process exit.  The compiler runs once, so a per-import
# malloc-leak is acceptable and saves us a Vec<*u8> global (which would
# need ritz1 mangling support for pointer-typed type args).
fn keep_source_alive(src_ptr: *u8)
    # Intentionally a no-op — `src_ptr` is the malloced backing buffer,
    # leaked-by-design until compiler exit.  Keeping the function (with
    # a dummy use of src_ptr to satisfy the parser) so call sites stay
    # readable and we have a single place to wire a real keep-alive when
    # ritz1 ever gains pointer-typed generic type-arg mangling.
    let _: *u8 = src_ptr

fn was_import_processed(path: @String) -> i32
    let n: i64 = vec_len<String>(@g_processed)
    for i in 0..n
        let entry_ptr: *String = vec_get_ptr<String>(@g_processed, i)
        if string_eq_string(entry_ptr, path)
            return 1
    0

fn mark_import_processed(path: String)
    vec_push<String>(@g_processed, path)

# Return the directory portion (up to and including the trailing '/'), or
# an empty StrView if path has no directory component.
fn path_dir(path: *u8) -> StrView
    var len: i64 = 0
    var last_slash: i64 = -1
    while *(path + len) != 0
        if *(path + len) == '/'
            last_slash = len
        len += 1
    var sv: StrView
    sv.ptr = path
    if last_slash >= 0
        sv.len = last_slash + 1
    else
        sv.len = 0
    sv

# Return the parent directory view of `dir` (which is expected to end in '/').
# E.g. parent_dir_view("/a/b/c/") -> "/a/b/" with len pointing at trailing slash.
# Returns an empty StrView when there is no parent component.
fn parent_dir_view(dir: StrView) -> StrView
    var out: StrView
    out.ptr = dir.ptr
    out.len = 0
    if dir.len <= 1
        return out
    # Skip the trailing '/'.
    var i: i64 = dir.len - 2
    while i >= 0
        if *(dir.ptr + i) == '/'
            out.len = i + 1
            return out
        i -= 1
    out

# Build "dir/seg1/seg2/....ritz" from a dir view and import segment list.
# Caller owns the returned String.
fn build_import_path(dir: StrView, imp: *ImportPath) -> String
    var out: String = string_from_strview(@dir)
    # Ensure separator between dir and segments (only if dir doesn't end with '/').
    if string_len(@out) > 0
        if string_char_at(@out, string_len(@out) - 1) != '/'
            string_push(@out, '/')
    var seg: *ImportPath = imp
    while seg != null
        string_push_bytes(@out, seg.segment, seg.segment_len as i64)
        if seg.next != null
            string_push(@out, '/')
        seg = seg.next
    string_push_str(@out, ".ritz")
    out

# Build "dir/<pkg>/<sub>/<rest...>.ritz" — inserts `sub` after the first
# import segment (the package name). Used to honor `sources = ["lib", "src"]`
# in workspace ritz.toml files: ritz0 reads ritz.toml at resolve time; ritz1
# probes the two values that every workspace project actually uses (lib, src).
# Returns an empty String when there is no remaining segment after the pkg
# name (e.g. bare `import pkg`) — the subdir probe would be meaningless.
fn build_import_path_with_sub(dir: StrView, imp: *ImportPath, sub: *u8) -> String
    if imp == null
        return string_new()
    if imp.next == null
        return string_new()
    var out: String = string_from_strview(@dir)
    if string_len(@out) > 0
        if string_char_at(@out, string_len(@out) - 1) != '/'
            string_push(@out, '/')
    # First segment: the package name.
    string_push_bytes(@out, imp.segment, imp.segment_len as i64)
    string_push(@out, '/')
    # The subdir (e.g. "lib" or "src").
    string_push_cstr(@out, sub)
    string_push(@out, '/')
    # Remaining segments.
    var seg: *ImportPath = imp.next
    while seg != null
        string_push_bytes(@out, seg.segment, seg.segment_len as i64)
        if seg.next != null
            string_push(@out, '/')
        seg = seg.next
    string_push_str(@out, ".ritz")
    out

# Does the first segment of this import path equal "ritzlib"?
fn import_is_ritzlib(imp: *ImportPath) -> i32
    if imp == null
        return 0
    var seg_view: StrView
    seg_view.ptr = imp.segment
    seg_view.len = imp.segment_len as i64
    strview_eq_cstr(@seg_view, c"ritzlib")

# Try to open an import file, checking source-dir first, then each colon-
# separated entry in RITZ_PATH (mirroring ritz0/Python's os.pathsep semantics).
# Returns a fresh String with the resolved path, or empty String if not found.
# Sets *found_via_ritz_path to 1 when RITZ_PATH was used.
#
# Every candidate probed and missed before the hit goes to dep_record_miss():
# a file appearing there later would win, so the sig's fast path must check
# it is still missing (AGAST #2030).
#
# Multi-path RITZ_PATH support is essential for the workspace builds: `./rz`
# orchestrates dependencies across many sibling projects (zeus, valet, nexus,
# ...) and constructs RITZ_PATH like `/path/ritz:/path/zeus:/path/cryptosec`.
# Earlier ritz1 only honored the first path, so any cross-project import
# beyond ritzlib failed with "Could not read import: <module>".
fn try_open_import(imp: *ImportPath, source_dir: StrView, ritz_path: StrView, found_via_ritz_path: *i32) -> String
    *found_via_ritz_path = 0

    # ritzlib imports skip source-dir and resolve only via RITZ_PATH.
    let is_ritzlib: i32 = import_is_ritzlib(imp)

    # First try relative to source file (unless this is a ritzlib import).
    # We walk up the source_dir ancestry, probing `<ancestor>/<imp>.ritz` at
    # each level. This mirrors ritz0's ImportResolver._try_resolve_path which
    # resolves intra-project imports like `lib.m7m_types` (mausoleum) or
    # `src.store` (nexus) by climbing to the project root, where ritz.toml's
    # source_roots like ["src", "lib", "test"] live as actual directories.
    # Cap the climb at 8 levels — workspace projects never go deeper.
    if is_ritzlib == 0
        var sd_ptr: *u8 = source_dir.ptr
        var sd_len: i64 = source_dir.len
        var levels: i32 = 0
        while levels < 8
            if sd_len <= 0
                levels = 8
            else
                var dir_view: StrView
                dir_view.ptr = sd_ptr
                dir_view.len = sd_len
                var candidate: String = build_import_path(dir_view, imp)
                let fd: i32 = sys_open(string_as_ptr(@candidate), O_RDONLY)
                if fd >= 0
                    sys_close(fd)
                    return candidate
                dep_record_miss(string_as_ptr(@candidate))
                string_drop(@candidate)

                # Climb to parent directory.
                var parent_view: StrView
                parent_view.ptr = sd_ptr
                parent_view.len = sd_len
                let parent: StrView = parent_dir_view(parent_view)
                if parent.len == 0
                    levels = 8
                else
                    if parent.len == sd_len
                        # Defensive: parent didn't shrink — bail out.
                        levels = 8
                    else
                        sd_len = parent.len
                        levels += 1

    # Then try each colon-separated entry in RITZ_PATH.
    if ritz_path.len > 0
        var remaining: StrView = ritz_path
        while remaining.len > 0
            var seg: StrView
            var rest: StrView
            let had_delim: i32 = strview_split_once(@remaining, ':', @seg, @rest)

            if seg.len > 0
                # Snapshot fields — StrView is moved on by-value pass, so we
                # rebuild a fresh view for each of the three probes below.
                let seg_ptr: *u8 = seg.ptr
                let seg_len: i64 = seg.len

                # Direct probe: <entry>/<pkg>/<rest>.ritz
                # Required for ritzlib (laid out flat under <entry>/ritzlib/).
                var seg_direct: StrView
                seg_direct.ptr = seg_ptr
                seg_direct.len = seg_len
                var candidate: String = build_import_path(seg_direct, imp)
                let fd: i32 = sys_open(string_as_ptr(@candidate), O_RDONLY)
                if fd >= 0
                    sys_close(fd)
                    *found_via_ritz_path = 1
                    return candidate
                dep_record_miss(string_as_ptr(@candidate))
                string_drop(@candidate)

                # Workspace probes: <entry>/<pkg>/lib/<rest>.ritz and
                # <entry>/<pkg>/src/<rest>.ritz. Mirrors ritz0's
                # _auto_detect_dependencies_from_ritz_path: every workspace
                # project (valet, zeus, nexus, mausoleum, tome, ...) puts its
                # public API under one of `sources = [...]` in ritz.toml. We
                # probe lib then src — those are the only two values used by
                # the app stack, and ritz1 gets to skip the TOML parser.
                var seg_lib: StrView
                seg_lib.ptr = seg_ptr
                seg_lib.len = seg_len
                var c_lib: String = build_import_path_with_sub(seg_lib, imp, c"lib")
                if string_len(@c_lib) > 0
                    let fd_lib: i32 = sys_open(string_as_ptr(@c_lib), O_RDONLY)
                    if fd_lib >= 0
                        sys_close(fd_lib)
                        *found_via_ritz_path = 1
                        return c_lib
                    dep_record_miss(string_as_ptr(@c_lib))
                string_drop(@c_lib)

                var seg_src: StrView
                seg_src.ptr = seg_ptr
                seg_src.len = seg_len
                var c_src: String = build_import_path_with_sub(seg_src, imp, c"src")
                if string_len(@c_src) > 0
                    let fd_src: i32 = sys_open(string_as_ptr(@c_src), O_RDONLY)
                    if fd_src >= 0
                        sys_close(fd_src)
                        *found_via_ritz_path = 1
                        return c_src
                    dep_record_miss(string_as_ptr(@c_src))
                string_drop(@c_src)

            if had_delim == 0
                # No more delimiters; we already tried `seg` (the full
                # remaining view), so we're done.
                remaining.ptr = null
                remaining.len = 0
            else
                remaining = rest

    string_new()

# Append the human-readable dotted import path ("foo.bar.baz") to a String.
fn append_import_display(s: *String, imp: *ImportPath)
    var seg: *ImportPath = imp
    while seg != null
        string_push_bytes(s, seg.segment, seg.segment_len as i64)
        if seg.next != null
            string_push(s, '.')
        seg = seg.next

# =============================================================================
# Constant conflicts across files (AGAST #2149)
# =============================================================================
#
# A const may be defined in several merged files only if every definition is
# the same: same declared type and a structurally identical initializer.
# This is ritz0's rule (import_resolver.py _consts_equal / _exprs_equal): an
# Ident compares by name, because both definitions resolve in the same
# merged const namespace, so `5` and `2 + 3` differ even though they fold to
# one value.  As in ritz0, a [[target_os]] const and an ungated one of the
# same name are never compared (ritzunit's reporter.ritz has its own
# `const TIOCGWINSZ: i64` beside ritzlib.sys's gated `u64` one).  ritz1 drops
# non-matching [[target_os]] variants at parse time, so two gated
# definitions left here are for the same target and are compared.

fn bytes_same(a: *u8, a_len: i32, b: *u8, b_len: i32) -> i32
    if a_len != b_len
        return 0
    if a_len == 0
        return 1
    if memcmp(a, b, a_len as i64) == 0
        return 1
    0

fn const_exprs_same(a: *Expr, b: *Expr) -> i32
    if a == null or b == null
        if a == b
            return 1
        return 0
    if a.kind != b.kind
        return 0
    let k: i32 = a.kind
    if k == EXPR_INT_LIT or k == EXPR_CHAR_LIT
        if a.int_val == b.int_val
            return 1
        return 0
    if k == EXPR_STRING_LIT or k == EXPR_CSTRING_LIT or k == EXPR_FLOAT_LIT
        return bytes_same(a.string_ptr, a.string_len, b.string_ptr, b.string_len)
    if k == EXPR_IDENT
        return bytes_same(a.ident_ptr, a.ident_len, b.ident_ptr, b.ident_len)
    if k == EXPR_UNARY
        if a.op != b.op
            return 0
        return const_exprs_same(a.operand, b.operand)
    if k == EXPR_BINARY
        if a.op != b.op
            return 0
        if const_exprs_same(a.left, b.left) == 0
            return 0
        return const_exprs_same(a.right, b.right)
    if k == EXPR_CAST
        # op is the target type; for `as *T`, int_val / ident_* name T.
        if a.op != b.op
            return 0
        if a.op == TYPE_PTR
            if a.int_val != b.int_val
                return 0
            if bytes_same(a.ident_ptr, a.ident_len, b.ident_ptr, b.ident_len) == 0
                return 0
        return const_exprs_same(a.left, b.left)
    if k == EXPR_ARRAY_LIT
        var ea: *Expr = a.args
        var eb: *Expr = b.args
        while ea != null and eb != null
            if const_exprs_same(ea, eb) == 0
                return 0
            ea = ea.next
            eb = eb.next
        if ea == eb
            return 1
        return 0
    if k == EXPR_ARRAY_FILL
        if a.int_val != b.int_val
            return 0
        return const_exprs_same(a.left, b.left)
    # Anything else (struct literals, calls, ...): conservatively different,
    # as ritz0 does.
    0

fn consts_same(a: *ConstEntry, b: *ConstEntry) -> i32
    if a.const_type != b.const_type
        return 0
    if bytes_same(a.type_name, a.type_name_len, b.type_name, b.type_name_len) == 0
        return 0
    if a.array_size != b.array_size or a.array_elem_type != b.array_elem_type
        return 0
    if bytes_same(a.array_elem_type_name, a.array_elem_type_name_len, b.array_elem_type_name, b.array_elem_type_name_len) == 0
        return 0
    const_exprs_same(a.value_expr, b.value_expr)

# Report every const of `other` (the import at `path`, with everything it
# imported merged in) that `m` already defines differently, at the
# definition's own file:line:col.  Returns -1 if there was one, else 0.
fn check_const_conflicts(m: *Module, other: *Module, path: *u8) -> i32
    var bad: i32 = 0
    var c: *ConstEntry = other.constants
    while c != null
        var e: *ConstEntry = m.constants
        while e != null
            if e.target_gated == c.target_gated and bytes_same(e.name, e.name_len, c.name, c.name_len) == 1
                if consts_same(e, c) == 0
                    var msg: String = string_from("Error: ")
                    if c.def_file != null
                        string_push_cstr(@msg, c.def_file)
                    else
                        string_push_cstr(@msg, path)
                    string_push(@msg, ':')
                    string_push_i64(@msg, c.line as i64)
                    string_push(@msg, ':')
                    string_push_i64(@msg, c.col as i64)
                    string_push_str(@msg, ": Conflicting constant definition for '")
                    string_push_bytes(@msg, c.name, c.name_len as i64)
                    if c.target_gated == 1
                        string_push_str(@msg, "': defined differently for same target_os")
                    else
                        string_push_str(@msg, "': defined differently in multiple files")
                    eprintln_string(@msg)
                    string_drop(@msg)
                    bad = 1
                break
            e = e.next
        c = c.next
    if bad == 1
        return -1
    0

# Merge imported_module's declarations into main module m.
# Each list is preserved by walking to its tail and prepending the main list.
fn merge_module_into(m: *Module, other: *Module)
    if other.structs != null
        var last: *StructDef = other.structs
        while last.next != null
            last = last.next
        last.next = m.structs
        m.structs = other.structs
    if other.functions != null
        var last: *FnDef = other.functions
        while last.next != null
            last = last.next
        last.next = m.functions
        m.functions = other.functions
    if other.constants != null
        var last: *ConstEntry = other.constants
        while last.next != null
            last = last.next
        last.next = m.constants
        m.constants = other.constants
    if other.globals != null
        var last: *GlobalVarDef = other.globals
        while last.next != null
            last = last.next
        last.next = m.globals
        m.globals = other.globals
    if other.impls != null
        var last: *ImplBlock = other.impls
        while last.next != null
            last = last.next
        last.next = m.impls
        m.impls = other.impls

# =============================================================================
# Interface texts (G9c, AGAST #1901)
# =============================================================================
#
# ritz0 stores each module's interface as Ritz source next to its own
# (pickled) interface: the module with every body strip_to_interface drops
# turned into a declaration-only `fn ... = extern` (#1900), and its lines
# emptied, so every kept line and column is the source's.  The format and
# the key are defined in ritz0/module_interface.py ("Interface text"):
#
#   <store>/objects/<k[:2]>/<k>.rzi.ritz
#   k = sha256_hex("ritz-iface-text-v1\n" + sha256_hex(source bytes))
#   <store> = $RITZ_CACHE_DIR, else ~/.cache/ritz/cas (cas.py default_root)
#
# The key holds the source's bytes only, never a path or a compiler, so an
# import is lexed and parsed from its interface whenever one is stored,
# under the import's real path for diagnostics.  On a miss the source is
# parsed, as before; ritz1 writing the text itself is #2113.
#
# RITZ1_PARSE_LOG=<file> appends the path of every *source* this process
# lexes and parses (the main file included, interface texts not), like
# ritz0's RITZ0_PARSE_LOG.

# The store path of the interface text of a module with these bytes, or an
# empty String if there is no store root.  Caller owns it.
fn iface_text_path(src: *u8, len: i64) -> String
    var out: String = string_new()
    let explicit: StrView = env_get_or("RITZ_CACHE_DIR", strview_empty())
    let home: StrView = env_get_or("HOME", strview_empty())
    if explicit.len > 0
        # cas.py expands a leading `~` (Path.expanduser).
        if *(explicit.ptr) == '~' and (explicit.len == 1 or *(explicit.ptr + 1) == '/')
            if home.len == 0
                return out
            string_push_bytes(@out, home.ptr, home.len)
            string_push_bytes(@out, explicit.ptr + 1, explicit.len - 1)
        else
            string_push_bytes(@out, explicit.ptr, explicit.len)
    else
        if home.len == 0
            return out
        string_push_bytes(@out, home.ptr, home.len)
        string_push_str(@out, "/.cache/ritz/cas")
    var inner: [64]u8
    sha256_hex(src, len, @inner[0])
    var pre: String = string_from("ritz-iface-text-v1\n")
    string_push_bytes(@pre, @inner[0], 64)
    var k: [64]u8
    sha256_hex(string_as_ptr(@pre), string_len(@pre) as i64, @k[0])
    string_drop(@pre)
    string_push_str(@out, "/objects/")
    string_push_bytes(@out, @k[0], 2)
    string_push(@out, '/')
    string_push_bytes(@out, @k[0], 64)
    string_push_str(@out, ".rzi.ritz")
    out

# The stored interface text of a module with these bytes (NUL-terminated,
# like read_file), or an empty Vec when none is stored.
fn read_iface_text(src: *u8, len: i64) -> Vec<u8>
    var path: String = iface_text_path(src, len)
    if string_len(@path) == 0
        string_drop(@path)
        return vec_new<u8>()
    let fd: i32 = sys_open(string_as_ptr(@path), O_RDONLY)
    if fd < 0
        string_drop(@path)
        return vec_new<u8>()
    sys_close(fd)
    let text: Vec<u8> = read_file(string_as_ptr(@path))
    string_drop(@path)
    text

# RITZ1_PARSE_LOG: note that `path`'s source is being lexed and parsed.
fn parse_log_note(path: *u8)
    let log: StrView = env_get_or("RITZ1_PARSE_LOG", strview_empty())
    if log.len == 0
        return
    var log_path: String = string_from_strview(@log)
    let fd: i32 = sys_open3(string_as_ptr(@log_path), O_WRONLY + O_CREAT + O_APPEND, 420)
    string_drop(@log_path)
    if fd < 0
        return
    var line: String = string_new()
    string_push_cstr(@line, path)
    string_push(@line, '\n')
    sys_write(fd, string_as_ptr(@line), string_len(@line) as i64)
    string_drop(@line)
    sys_close(fd)

# Read / tokenize / parse a single import: its stored interface text if
# there is one, else its source.  Returns a parsed Module, or null on any
# failure (already reported to stderr).  Steals the buffers' data to keep
# the AST-pointed-into bytes alive via keep_source_alive().
fn load_and_parse(path: @String) -> *Module
    let path_ptr: *u8 = string_as_ptr(path)
    var src: Vec<u8> = read_file(path_ptr)
    if src.len == 0
        return null

    var text: Vec<u8> = read_iface_text(src.data, src.len - 1)
    var lex_buf: *u8 = src.data
    var lex_len: i64 = src.len - 1
    if text.len > 0
        lex_buf = text.data
        lex_len = text.len - 1
    else
        parse_log_note(path_ptr)

    var tokens: Vec<Token> = vec_with_cap<Token>(24000)
    let lex_err: i32 = tokenize(path_ptr, lex_buf, lex_len, @tokens)
    if lex_err > 0
        err2("Lexer errors in: ", path_ptr)
        return null

    # Name the file in parse diagnostics (AGAST #1301).
    parser_set_source_file(path_ptr)
    let first_ei: i32 = enum_count()
    let mod: *Module = parse_tokens(@tokens)
    if mod == null
        err2("Parse error in: ", path_ptr)
        return null
    if add_enum_from_fns(mod, first_ei, path_ptr) < 0
        return null

    # The cached IR depends on these exact bytes (AGAST #1807).
    dep_record_note(path_ptr, src.data, src.len - 1)

    # Keep the lexed buffer alive: AST nodes point into it.
    keep_source_alive(lex_buf)
    src.data = null  # Prevent Vec Drop from freeing.
    text.data = null

    mod

# =============================================================================
# Module interfaces (G9b, AGAST #1899)
# =============================================================================
#
# An imported module contributes only *declarations* to this file's IR: its
# fns are is_local == 0 and emit as `declare`.  But monomorph's instantiation
# collector and the emitter's enum-type scans walk EVERY body in the merged
# module, so a body-only edit to an import used to change the importer's IR
# (e.g. an extra linkonce_odr instantiation only the import itself needs).
#
# So each import is cut down to its interface as it is loaded, with ritz0's
# rule (ritz0/module_interface.py body_needed): every fn body is dropped
# except those the importer instantiates itself -- generic fns, and methods
# of generic impls or with their own type params.  ritz1 has no async fns,
# and parses trait default bodies without keeping them, so this drops a
# superset of what ritz0's interface drops: the importer's IR depends only
# on what ritz0's interface hash covers, which is what build.py keys ritz1
# objects on (cas_module_key).
#
# An import read from its interface text (#1901, load_and_parse) holds
# `= extern` declarations where the bodies were; they share the same
# stripped_body() sentinel, so stripping it again changes nothing.

# Every stripped fn shares ast_helpers' stripped_body(), the body of a
# declaration-only `fn ... = extern` too (#1900).  Non-null on purpose:
# `body == null` means `extern fn`.

fn strip_to_interface(m: *Module)
    let body: *Stmt = stripped_body()
    var f: *FnDef = m.functions
    while f != null
        if f.type_params == null and f.body != null
            f.body = body
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                if method.type_params == null and method.body != null
                    method.body = body
                method = method.next
        ib = ib.next

# Resolve imports recursively, merging into the main module.
fn resolve_imports(m: *Module, source_dir: StrView, ritz_path: StrView) -> i32
    var imp: *ImportDecl = m.imports
    while imp != null
        # Find the import file.
        var found_via_ritz_path: i32 = 0
        var path: String = try_open_import(imp.path, source_dir, ritz_path, @found_via_ritz_path)
        if string_is_empty(@path)
            var msg: String = string_from("Error: Could not read import: ")
            append_import_display(@msg, imp.path)
            string_push_str(@msg, ".ritz")
            eprintln_string(@msg)
            string_drop(@msg)
            string_drop(@path)
            return -1

        # Cycle detection.
        if was_import_processed(@path) == 1
            string_drop(@path)
            imp = imp.next
            continue
        mark_import_processed(string_clone(@path))

        let import_module: *Module = load_and_parse(@path)
        if import_module == null
            string_drop(@path)
            return -1
        strip_to_interface(import_module)

        # Child imports: ALWAYS use the resolved file's directory as the
        # source_dir for relative imports.  Earlier behaviour cleared
        # source_dir whenever the file was found via RITZ_PATH (i.e. the
        # symlink-farm path the workspace builds use), which broke bare
        # imports inside dependency packages — e.g. squeeze/lib/gzip.ritz
        # has `import crc32` that should resolve as a sibling file, but
        # source_dir was empty so it fell through to RITZ_PATH, where no
        # bare `crc32.ritz` exists.
        #
        # ritzlib's internal imports are not affected — try_open_import
        # special-cases ritzlib.* and skips source_dir for those, so
        # they continue to flow through RITZ_PATH.
        let child_dir: StrView = path_dir(string_as_ptr(@path))
        let res: i32 = resolve_imports(import_module, child_dir, ritz_path)
        if res < 0
            string_drop(@path)
            return -1

        if check_const_conflicts(m, import_module, string_as_ptr(@path)) < 0
            string_drop(@path)
            return -1
        merge_module_into(m, import_module)

        # Don't drop path — it's owned by g_processed now (we cloned above).
        string_drop(@path)
        imp = imp.next

    0

# =============================================================================
# Argument parsing
# =============================================================================

struct CliArgs
    input_path: *u8
    output_path: *u8
    ritz_path: StrView    # .len == 0 if none was supplied
    dash_dash: i32
    # `--target-os <os>` (AGAST #1550): selects `[[target_os = "..."]]`
    # variants.  Defaults to "linux", as ritz0's --target-os does.
    target_os: StrView
    # `--test-table` (AGAST #1908): compile as the root of a test binary
    # (LANGUAGE_SPEC §17.1), as ritz0's --test-table does.
    test_table: i32

fn parse_cli(argc: i32, argv: **u8) -> CliArgs
    var args: CliArgs
    args.input_path = null
    args.output_path = null
    args.ritz_path.ptr = null
    args.ritz_path.len = 0
    args.dash_dash = 0
    args.target_os = strview_from_cstr(c"linux")
    args.test_table = 0

    if argc < 2
        return args

    let first: StrView = strview_from_cstr(argv[1])

    # Support `ritz1 -- <input.ritz>` form used by test harnesses.
    if strview_eq_cstr(@first, c"--")
        args.dash_dash = 1
        if argc < 3
            return args
        args.input_path = argv[2]
        args.output_path = c"/tmp/ritz1_dashdash_out.ll"
        return args

    if argc < 4
        return args

    args.input_path = argv[1]
    let flag: StrView = strview_from_cstr(argv[2])
    if not strview_eq_cstr(@flag, c"-o")
        eprintln("Error: Expected -o flag")
        args.input_path = null
        return args
    args.output_path = argv[3]

    # Options after `-o <out>`, in any order:
    #   -I <path>          additive to RITZ_PATH, not a replacement.  Treats
    #                      `-I` like gcc's: prepends to the lookup list.
    #   --target-os <os>   see CliArgs.target_os.
    #   --test-table       see CliArgs.test_table.
    # Anything else is ignored, as it always has been.
    var dash_i_view: StrView
    dash_i_view.ptr = null
    dash_i_view.len = 0
    var i: i32 = 4
    while i < argc
        let opt: StrView = strview_from_cstr(argv[i])
        let is_dash_i: bool = strview_eq_cstr(@opt, c"-I")
        let is_target_os: bool = strview_eq_cstr(@opt, c"--target-os")
        if strview_eq_cstr(@opt, c"--test-table")
            args.test_table = 1
            i = i + 1
        else if is_dash_i or is_target_os
            if i + 1 >= argc
                if is_dash_i
                    eprintln("Error: -I needs a path")
                else
                    eprintln("Error: --target-os needs an OS name")
                args.input_path = null
                return args
            if is_dash_i
                dash_i_view = strview_from_cstr(argv[i + 1])
            else
                args.target_os = strview_from_cstr(argv[i + 1])
            i = i + 2
        else
            i = i + 1

    # Pull RITZ_PATH from env (if any) and merge with -I.  Earlier behaviour
    # was: -I OVERRIDES env, which broke workspace builds where the wrapper
    # script (`./rz`) passes a multi-project RITZ_PATH for cross-project
    # imports, but build.py also passes `-I <ritz_root>` for ritzlib.
    # ritzlib.os.env (AGAST #1750).  The view points into the cached
    # /proc/self/environ bytes, which stay alive for the whole process.
    let env_view: StrView = env_get_or("RITZ_PATH", strview_empty())

    if dash_i_view.len > 0 and env_view.len > 0
        # Merge: <-I path>:<env path>.  We allocate a small buffer; this
        # is leaked by design (the compiler runs once per process).
        let total: i64 = dash_i_view.len + 1 + env_view.len + 1
        let buf: *u8 = malloc(total)
        memcpy(buf, dash_i_view.ptr, dash_i_view.len)
        *(buf + dash_i_view.len) = ':' as u8
        memcpy(buf + dash_i_view.len + 1, env_view.ptr, env_view.len)
        *(buf + dash_i_view.len + 1 + env_view.len) = 0 as u8
        args.ritz_path.ptr = buf
        args.ritz_path.len = dash_i_view.len + 1 + env_view.len
    else if dash_i_view.len > 0
        args.ritz_path = dash_i_view
    else if env_view.len > 0
        args.ritz_path = env_view

    args

# Ensure a RITZ_PATH view ends with '/'. May allocate if it doesn't; caller
# doesn't need to free (we leak the small buffer — compiler runs once).
fn normalize_ritz_path(rp: StrView) -> StrView
    if rp.len == 0
        return rp
    if *(rp.ptr + rp.len - 1) == '/'
        return rp
    let buf: *u8 = malloc(rp.len + 2)
    for k in 0..rp.len
        *(buf + k) = *(rp.ptr + k)
    *(buf + rp.len) = '/'
    *(buf + rp.len + 1) = 0
    var out: StrView
    out.ptr = buf
    out.len = rp.len + 1
    out

# Unlink the input file's own `fn main` from m.functions (test mode).
fn drop_local_main(m: *Module)
    var prev: *FnDef = null
    var f: *FnDef = m.functions
    while f != null
        let next: *FnDef = f.next
        if f.is_local == 1 and f.name_len == 4 and memcmp(f.name, c"main", 4) == 0
            if prev == null
                m.functions = next
            else
                prev.next = next
        else
            prev = f
        f = next

fn print_usage()
    eprintln("Usage: ritz1 <input.ritz> -o <output.ll> [-I <ritz_path>] [--target-os <os>] [--test-table]")
    eprintln("       ritz1 -- <input.ritz>")

# Parse the main file's tokens, mark its fns local, and resolve (parse and
# merge) its imports.  Returns null on any failure (already reported).
# Called twice when the first pass records a type alias (AGAST #1475).
fn parse_program(tokens: *Vec<Token>, input_path: *u8, source_dir: StrView, ritz_path: StrView) -> *Module
    # Parse
    parser_set_source_file(input_path)
    let first_ei: i32 = enum_count()
    let m: *Module = parse_tokens(tokens)
    if m == null
        return null
    if add_enum_from_fns(m, first_ei, input_path) < 0
        return null

    # AGAST #194: mark every FnDef parsed from THIS file as is_local=1
    # *before* resolve_imports prepends imported FnDefs (those stay
    # is_local=0). emit_fn uses the flag to decide define-vs-declare —
    # only local fns get a body, imports become extern declarations.
    # This is the core of modular emit: each .ll contains only the
    # current file's bodies + linkonce_odr monomorph instantiations.
    # A declaration-only `fn ... = extern` (#1900) is defined in another
    # object: it stays is_local=0 and is declared as an import is.
    var local_fn: *FnDef = m.functions
    while local_fn != null
        if fn_is_decl(local_fn) == 0
            local_fn.is_local = 1
        local_fn = local_fn.next
    var local_ib: *ImplBlock = m.impls
    while local_ib != null
        var local_method: *FnDef = local_ib.methods
        while local_method != null
            if fn_is_decl(local_method) == 0
                local_method.is_local = 1
            local_method = local_method.next
        local_ib = local_ib.next

    # Resolve imports recursively
    if resolve_imports(m, source_dir, ritz_path) < 0
        eprintln("Error: Import resolution failed")
        return null

    m

# =============================================================================
# Main Entry Point
# =============================================================================

fn main(argc: i32, argv: **u8) -> i32
    let args: CliArgs = parse_cli(argc, argv)
    if args.input_path == null
        print_usage()
        return 1
    set_target_os(args.target_os.ptr, args.target_os.len as i32)
    # Cached IR depends on the compiler, the target OS and the import
    # roots (see cache_fingerprint in fn_cache.ritz).
    let cache_fp: u64 = cache_fingerprint(args.target_os.ptr, args.target_os.len, args.ritz_path.ptr, args.ritz_path.len, args.input_path)

    # Read source file
    var src: Vec<u8> = read_file(args.input_path)
    if src.len == 0
        return 1

    # File-level fast path: if the sig records this source, this compiler
    # identity and unchanged imports, and the .ll is current (or can be
    # spliced from the sig), skip lex/parse/emit entirely.  This is the single biggest win for
    # no-op rebuilds (full-stack 12m30s → ~30s).
    # Test mode's IR is not the module's: it neither reads nor writes the sig
    # (ritz0 skips its fn cache in test mode too).
    if args.test_table == 0 and check_source_unchanged(args.input_path, src.data, src.len - 1, args.output_path, cache_fp) == 1
        var skip_msg: String = string_from("Skipped (unchanged): ")
        string_push_cstr(@skip_msg, args.input_path)
        println_string(@skip_msg)
        string_drop(@skip_msg)
        return 0

    # Tokenize. Typical compiler input files produce under 20K tokens;
    # bigger files realloc organically.
    parse_log_note(args.input_path)
    var tokens: Vec<Token> = vec_with_cap<Token>(24000)
    let lex_errors: i32 = tokenize(args.input_path, src.data, src.len - 1, @tokens)
    if lex_errors > 0
        var msg: String = string_from("Lexer errors: ")
        string_push_i64(@msg, lex_errors as i64)
        eprintln_string(@msg)
        string_drop(@msg)
        return 1

    # Get source directory for relative imports
    let source_dir: StrView = path_dir(args.input_path)
    let ritz_path: StrView = normalize_ritz_path(args.ritz_path)

    # Parse this file and everything it imports.
    var m: *Module = parse_program(@tokens, args.input_path, source_dir, ritz_path)
    if m == null
        return 1

    # AGAST #1475: type aliases resolve at parse time (type_named replays the
    # target's parse state).  The first pass can't see an alias used before
    # its declaration, or declared in an imported module (imports are parsed
    # after their importer), so if it recorded any alias, parse everything
    # again with the alias table populated.  Programs without aliases (ritz1
    # itself included) pay nothing.
    if type_alias_count() > 0
        vec_clear<String>(@g_processed)
        dep_record_reset()
        enum_tracker_reset()
        test_fns_reset()
        # Fresh views: ritz0's move checker treats StrView as move-only
        # (AGAST #1489), so the first pass's copies can't be passed again.
        let source_dir2: StrView = path_dir(args.input_path)
        let ritz_path2: StrView = normalize_ritz_path(args.ritz_path)
        m = parse_program(@tokens, args.input_path, source_dir2, ritz_path2)
        if m == null
            return 1

    # Test mode (LANGUAGE_SPEC §17.1): ritzunit supplies `main`, so the
    # file's own goes, before anything can emit or call it.
    if args.test_table == 1
        drop_local_main(m)
        emitter_set_test_mode(1)

    # Monomorphize: generate specialized versions of generic functions
    monomorphize_module(m)

    # Emit IR
    var ir: Vec<u8> = vec_with_cap<u8>(131072)  # 128KB seed; realloc as needed
    emitter_set_source_file(args.input_path)   # AGAST #1813
    let emit_errors: i32 = emit_module(m, @ir)

    # AGAST #1369.  This return value was previously discarded, and it was a
    # hardcoded 0 anyway: an expression the emitter could not lower was written
    # into the IR as a `; ERROR: ...` COMMENT, a zero was substituted for its
    # value, and the compiler exited 0.  Downstream, build.py printed its tick
    # and clang linked a program that segfaulted (a call through the
    # substituted null) or silently used a stale value (a dropped store).
    #
    # Refuse here, and refuse BEFORE write_file so no output is left for a
    # build system to pick up.  Individual messages have already gone to
    # stderr from emit_ir_error.
    if emit_errors > 0
        eprints_cstr(c"error: ritz1 emitted ")
        eprint_int(emit_errors as i64)
        eprints_cstr(c" unlowerable expression(s); refusing to write output\n")
        return 1

    # Write output
    if write_file(args.output_path, ir.data, ir.len as i64) < 0
        return 1

    # Write the sig: source hash, compiler identity, import hashes and a
    # snapshot of the emitted IR.  Next invocation's `check_source_unchanged`
    # can then short-circuit emission entirely — even if the orchestrator
    # wiped its artifact tempdir, the cached IR lives in the sig cache and
    # gets spliced back into the requested output.
    if args.test_table == 1
        return 0
    var sig_out: *SigData = sig_data_new()
    if sig_out != null
        sig_out.source_hash = source_file_hash(src.data, src.len - 1)
        # Stamp the sig with *this* binary's identity (AGAST #1279).  Without
        # it the cache is keyed on the source alone, so a rebuilt ritz1 reuses
        # IR emitted by the compiler it replaced.
        # AGAST #1550: and with the target OS, which picks the variants.
        sig_out.compiler_hash = cache_fp
        # Take a heap copy of ir.data — sig_data_free() owns the buffer.
        let ir_len: i64 = ir.len as i64
        if ir_len > 0
            let ir_copy: *u8 = malloc(ir_len + 1)
            if ir_copy != null
                memcpy(ir_copy, ir.data, ir_len)
                *(ir_copy + ir_len) = 0
                sig_out.module_ir = ir_copy
                sig_out.module_ir_len = ir_len
        # Every file the resolver loaded, with the bytes it parsed (#1807).
        sig_take_deps(sig_out)
        var sig_path: String = sig_path_from_src(args.input_path)
        write_sig_file(string_as_ptr(@sig_path), sig_out)
        string_drop(@sig_path)
        sig_data_free(sig_out)

    0
