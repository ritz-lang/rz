# Auto-extracted from emitter_expr.ritz — CALL + METHOD codegen.

import ast
import ast_helpers
import emitter_core
import binder_check   # binder_call_refuse (AGAST #2407)
import float_slot     # int_into_float_slot (AGAST #2945)
import emitter_expr
import emitter_print
import emitter_stmt   # the whole-array copy (AGAST #2287)
import emitter_expr_access   # emit_whole_array_error (AGAST #2287)
import narrowing
