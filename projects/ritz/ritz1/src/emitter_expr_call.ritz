# AGAST #3125: `Span<T>` is `{ ptr, len }`, so `.ptr()`, `.is_empty()` and
# `.slice(lo, hi)` are struct operations a module that only receives a span
# can call without importing ritzlib.span, as ritz0's
# _try_emit_builtin_span_method lowers them.  As there, a method the module
# does define (ritzlib.span's `is_empty` / `slice`, a UFCS `span_*` helper)
# wins: this runs only when method_callee_def finds none.  `receiver_reg` is
# the receiver the dispatcher already evaluated, read as try_emit_len_builtin
# reads it.  `.ptr()` is the i64 pointer value, `.is_empty()` the i64 0 / 1 a
# comparison gives, and `.slice(lo, hi)` a %Span$T view
# `{ ptr + lo, hi - lo }`.  Returns -1 when not applicable.
fn try_emit_span_builtin(s: *EmitterState, e: *Expr, type_name: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: bool) -> i32
    if not type_name.starts_with("Span$")
        return -1
    var method: SpanMethod = SpanMethod.Ptr
    match span_method_of(e)
        Some(m) => method = m
        None => return -1
    if method_callee_def(s, type_name, e.ident) != null
        return -1

    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr
        let loaded: i32 = next_reg(s)
        emit_load_into(s, "ptr", loaded, receiver_reg)
        struct_ptr = loaded

    # The field `.ptr()` reads (0), or `len` (1): `.slice` computes it too,
    # unused, so the IR keeps the GEP it always had.
    var field: i32 = 1
    if method == SpanMethod.Ptr
        field = 0
    let fptr: i32 = span_field_ptr(s, type_name, struct_ptr, field)
    match method
        SpanMethod.Ptr =>
            let p: i32 = next_reg(s)
            emit_load_into(s, "ptr", p, fptr)
            ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, p)
        SpanMethod.IsEmpty =>
            let n: i32 = next_reg(s)
            emit_load_into(s, "i64", n, fptr)
            let z: i32 = next_reg(s)
            format_into(s, "  %.{z} = icmp eq i64 %.{n}, 0\n")
            ir_zext_i1_i64(s.ir.out, @s.fcx.reg_counter, z)
        SpanMethod.Slice => emit_span_slice(s, e, type_name, struct_ptr)

# The Span methods try_emit_span_builtin lowers.
enum SpanMethod
    Ptr
    IsEmpty
    Slice

# Which Span method `e` calls: `.ptr()` / `.is_empty()` with no arguments,
# `.slice(lo, hi)` with two.
fn span_method_of(e: *Expr) -> Option<SpanMethod>
    let name: StrView = e.ident
    if e.args == null
        if name_eq(name, "ptr") == 1
            return Some(SpanMethod.Ptr)
        if name_eq(name, "is_empty") == 1
            return Some(SpanMethod.IsEmpty)
        return None
    if name_eq(name, "slice") == 1 and e.args.next != null and e.args.next.next == null
        return Some(SpanMethod.Slice)
    None

# `%.N = getelementptr %<span>, ptr %.{struct_ptr}, i32 0, i32 {field}`: the
# address of the span's `ptr` (0) or `len` (1) field.
fn span_field_ptr(s: *EmitterState, type_name: StrView, struct_ptr: i32, field: i32) -> i32
    let fptr: i32 = next_reg(s)
    gep_struct_open(s, fptr, type_name)
    format_into(s, ", ptr %.{struct_ptr}, i32 0, i32 {field}\n")
    fptr

# `.slice(lo, hi)`: the view `{ ptr + lo * size, hi - lo }`; the element's size
# scales `lo` into a byte offset.
fn emit_span_slice(s: *EmitterState, e: *Expr, type_name: StrView, struct_ptr: i32) -> i32
    var align: i64 = 1
    let elem: StrView = StrView { ptr: (type_name.ptr + 5), len: (type_name.len - 5) }
    let elem_size: i64 = mangled_type_size_align(s, elem, @align)
    if elem_size <= 0 and is_unit_arg(elem) == 0
        emit_ir_error_sv(s, e.span, "Span.slice: can't measure the element type")
        return 0
    let lo: i32 = emit_expr(s, e.args)
    let hi: i32 = emit_expr(s, e.args.next)
    let base_ptr_ptr: i32 = next_reg(s)
    gep_struct_open(s, base_ptr_ptr, type_name)
    format_into(s, ", ptr %.{struct_ptr}, i32 0, i32 0\n")
    let base_ptr: i32 = next_reg(s)
    emit_load_into(s, "ptr", base_ptr, base_ptr_ptr)
    let off: i32 = next_reg(s)
    format_into(s, "  %.{off} = mul i64 %.{lo}, {elem_size}\n")
    let at: i32 = next_reg(s)
    format_into(s, "  %.{at} = getelementptr i8, ptr %.{base_ptr}, i64 %.{off}\n")
    let len: i32 = next_reg(s)
    format_into(s, "  %.{len} = sub i64 %.{hi}, %.{lo}\n")
    let ty_ir: String = ir_name(type_name)
    let v1: i32 = next_reg(s)
    format_into(s, "  %.{v1} = insertvalue %{ty_ir.as_view()} undef, ptr %.{at}, 0\n")
    let v2: i32 = next_reg(s)
    format_into(s, "  %.{v2} = insertvalue %{ty_ir.as_view()} %.{v1}, i64 %.{len}, 1\n")
    v2

# Emit one call argument with the enum context its parameter dictates
# (AGAST #1498).  `p` is the matching callee Param, or null when unknown.
# A tagged-enum param makes a bare `Some(x)` / `None` / `Ok(x)` / `Err(x)`
# argument build that enum; any other param clears the context, so neither a
# surrounding typed let's type nor (via ctx_enum_arg) the enclosing fn's
# return type leaks into the argument.  Saved and restored like
# emit_var_decl does.
fn emit_call_arg(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    # AGAST #3260: a receiver lent as a `:&` param passes a place's address.
    if p != null and param_is_self(p) == 1 and p.is_borrow == 1
        let lent: i32 = emit_borrowed_place(s, arg, p)
        if lent != 0
            return lent
    # AGAST #3005: a tuple param names a nameless tuple literal argument.
    if p != null and p.param_type == TypeKind.Struct
        var arg_name: *u8 = null
        var arg_name_len: i32 = 0
        let arg_name_sv: StrView = tuple_lit_name(s, arg, p.param_type_name).unwrap_or(no_name())
        arg_name = arg_name_sv.ptr
        arg_name_len = arg_name_sv.len as i32
    if p != null and param_self_is_ptr(p) == 0
        if p.param_type == TypeKind.Array
            return emit_array_arg_value(s, arg, p)   # AGAST #2287
        let array_addr: i32 = emit_array_arg_addr(s, arg, p)
        if array_addr != 0
            return array_addr
        let sv_arr: *Expr = strview_array_src(s, arg, p)   # AGAST #2305
        if sv_arr != null
            return emit_strview_of_array(s, sv_arr)
        let place_addr: i32 = emit_borrowed_place(s, arg, p)   # AGAST #2335
        if place_addr != 0
            return place_addr
        # The Span cascade builds its Span from the local; it reads no value.
        if param_is_span(p) == 1 and arg.kind == ExprKind.Ident
            let span_src: *LocalVar = find_local_struct_name(s, arg.ident)
            if span_src != null and lv_var_type(span_src) == TypeKind.Array
                return 0
    let saved_name: StrView = s.fcx.ctx_enum_name
    let saved_arg: i32 = s.fcx.ctx_enum_arg
    var saved_slot: SlotCtx
    if p != null
        enter_slot_ctx(s, @saved_slot, p.param_type, p.param_type_name)
    else
        enter_slot_ctx(s, @saved_slot, TypeKind.Void, strview_empty())
    s.fcx.ctx_enum_name = strview_empty()
    s.fcx.ctx_enum_arg = 1
    if p != null
        if p.param_type == TypeKind.Struct and p.param_type_name.len > 0
            if is_tagged_enum_type(p.param_type_name) == 1 or is_enum_instance(s.sym.mono.pctx, p.param_type_name) == 1
                s.fcx.ctx_enum_name = p.param_type_name
    # AGAST #2279: a `c:& C` argument copies into a by-value `C` param.  A lent
    # `self` param is a `ptr` (emit_impl_method).
    var reg: i32 = 0
    # LARB R43 (#3385): an f32 / f64 param is a float slot for an if / match
    # argument; emit_match_arms / emit_if_expr take the hint on entry.
    if p != null and (arg.kind == ExprKind.If or arg.kind == ExprKind.Match)
        s.fcx.match_float_hint = param_float_type(p)
    if p != null and param_self_is_ptr(p) == 0
        reg = emit_expr_by_value(s, arg, p.param_type, p.param_type_name)
    else
        reg = emit_expr(s, arg)
    s.fcx.ctx_enum_name = saved_name
    s.fcx.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, arg, reg, p)
    return reg

# AGAST #2142: emit `e`, whose value is stored into a slot of declared type
# (ty, name): an assignment target (local, `x.f`, `*p`) or a struct-literal
# field.  As emit_call_arg does for a parameter, a tagged-enum slot makes a
# bare `Some(x)` / `None` / `Rect(..)` build that enum; any other slot clears
# the context and (via ctx_enum_arg) bars the enclosing fn's return type, so
# a ctor with no enum to land in is a ritz1 error, not invalid IR.  Without
# this, `held = Some(..)` / `f.cmap = None` / `Font { cmap: Some(..) }`
# emitted `add i64 0, 0 ; variant w/ no enum ctx` and clang rejected it.
pub fn emit_expr_into_slot_impl(s: *EmitterState, e: *Expr, ty: TypeKind, name: StrView) -> i32
    if ty == TypeKind.Struct
        let referent: i32 = emit_lent_referent(s, e, name)
        if referent != 0
            return referent
    let saved_name: StrView = s.fcx.ctx_enum_name
    let saved_arg: i32 = s.fcx.ctx_enum_arg
    s.fcx.ctx_enum_name = strview_empty()
    s.fcx.ctx_enum_arg = 1
    var saved_slot: SlotCtx
    enter_slot_ctx(s, @saved_slot, ty, name)
    if ty == TypeKind.Struct and not unnamed(name) and name.len > 0
        if is_tagged_enum_type(name) == 1 or is_enum_instance(s.sym.mono.pctx, name) == 1
            s.fcx.ctx_enum_name = name
    # AGAST #4028 / #4029: an if / match into a float slot (`v = if c then y
    # else y`, `S { d: match .. }`) merges at the slot's type, as a let does;
    # its phi was the arms' width, stored at the slot's.
    set_match_float_hint(s, e, ty, name)
    var reg: i32 = emit_struct_copy(s, e, ty)
    s.fcx.ctx_enum_name = saved_name
    s.fcx.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if ty == TypeKind.Struct
        reg = coerce_array_to_span(s, e, reg, name)   # AGAST #2502
    return reg

# AGAST #2390: emit_expr_into_slot for a slot the caller stores straight into:
# an array element (`a[i] = v`, `h.a[i] = v`, `g[i] = v`) or a pointee
# (`*p = v`).  A bare "..." is a %Span$u8 (#98) and a StrView slot holds a
# %StrView, the layout-equal pair (#168): rebuild it, as the `let`, assign,
# return and struct-literal sites do, or clang refuses the store.  Kept out of
# emit_expr_into_slot itself: those sites rebuild after it, and a second
# rebuild would read a %StrView as a %Span$u8.
pub fn emit_store_into_slot(s: *EmitterState, e: *Expr, ty: TypeKind, name: StrView) -> i32
    let reg: i32 = emit_expr_into_slot(s, e, ty, name)
    if ty != TypeKind.Struct or unnamed(name) or name.len <= 0
        return reg
    return coerce_struct_ret_value(s, e, reg, name)

# AGAST #2502: `reg` is `e`'s value headed for a `Span<T>` / `[T]` slot.  When
# `e` is `@a` over an `[N]T` local, that value is `@a`'s address as an i64,
# which no Span slot holds: build `Span { &a[0], N }` instead, as the Span
# parameter cascade in emit_expr_call does (ritz-task-102).  A `let` / `var`
# initialiser, an assignment and a struct-literal field emitted
# `store %Span$u8 <i64>` and clang rejected it.  Any other `e`: `reg`.
pub fn coerce_array_to_span(s: *EmitterState, e: *Expr, reg: i32, name: StrView) -> i32
    let loc: *LocalVar = span_array_source(s, e, name)
    if loc == null
        let placed: i32 = emit_span_of_addr_place(s, e, name)   # AGAST #2305
        if placed != 0
            return placed
        return reg
    span_array_elem_fits(s, e, loc, name)   # AGAST #2781
    return emit_span_of_array(s, loc, name)

# AGAST #2305: `Span { &x[0], N }` for `@x` into the `Span$T` slot `name`,
# where `x` is a whole 1-D array that isn't a local: a global, an
# inline field, `*p` for `p: *[N]T`.  ritz0 takes each (`g(@G)`, `g(@h.a)`);
# they passed `@x`'s i64 where the %Span$T goes, and clang refused it.  The
# element is held to the Span's as for a local (#2781); an element this can't
# spell isn't judged.  0 when `e` is anything else; emits nothing then.
fn emit_span_of_addr_place(s: *EmitterState, e: *Expr, name: StrView) -> i32
    if e == null or unnamed(name) or name.len <= 5 or not name.starts_with("Span$")
        return 0
    if e.kind != ExprKind.Unary or (e.op != OpKind.Addr and e.op != OpKind.AddrMut) or e.operand == null
        return 0
    let x: *Expr = e.operand
    # AGAST #4666 (was #4671): `@b.v` with `b.v` a `Vec<T>` field is
    # `{ b.v.data, b.v.len }`, as `@v` of a Vec local is (span_param_arg).
    # It passed the field's address, a ptrtoint, where the %Span$T goes.
    if x.kind == ExprKind.Member
        let vf: *StructField = resolve_member_chain_field(s, x)
        if vf != null and vf.field_type == TypeKind.Struct and vf.field_type_name.len > 4 and name_eq(vf.field_type_name.take(4), "Vec$") == 1
            if name_eq(StrView { ptr: (vf.field_type_name.ptr + 4), len: ((vf.field_type_name.len as i32) - 4) as i64 }, StrView { ptr: (name.ptr + 5), len: (name.len - 5) }) == 0
                return 0   # `@Vec<A>` into `Span<B>`: the arg checks judge it
            var vmr: MemberPtrResult
            emit_member_ptr(s, x, @vmr)
            if vmr.success != 1
                return 0
            return emit_span_of_vec_ptr(s, vf.field_type_name, vmr.reg, name)
    var src: ArraySrc
    if arg_array_shape(s, x, @src) == 0
        return 0
    if src.elem != TypeKind.Ptr and src.elem != TypeKind.PtrPtr
        span_elem_fits(s, e, src.elem, StrView { ptr: (src.name), len: (src.name_len) as i64 }, name)
    var ptr: i32 = 0
    if array_place_shape(s, x, @src) == 1
        ptr = emit_array_place_ptr(s, x)
    else
        var mr: MemberPtrResult
        emit_member_ptr(s, x, @mr)
        ptr = mr.reg
    emit_span_value(s, ptr, src.size, name)

# `StrView { &x[0], N }` of strview_array_src's array `x`, or `{ x, N }` when
# `x` points at it.
fn emit_strview_of_array(s: *EmitterState, x: *Expr) -> i32
    var src: ArraySrc
    if strview_array_ptr(s, x)
        array_ptr_shape(s, x, @src)
        return emit_span_value(s, emit_array_ptr_value(s, x), src.size, "StrView")
    arg_array_shape(s, x, @src)
    var ptr: i32 = 0
    if array_place_shape(s, x, @src) == 1
        ptr = emit_array_place_ptr(s, x)
    else
        var mr: MemberPtrResult
        emit_member_ptr(s, x, @mr)
        ptr = mr.reg
    emit_span_value(s, ptr, src.size, "StrView")

# AGAST #2287: the `[N x T]` value of `arg` for by-value array param `p`.  As in
# ritz0, `g(p)` and `g(@a)` read through the pointer.  Each value is copied into
# a fresh `[N x T]` by emit_array_local_whole_assign, whose checks it gets, so
# it is what `let b: [N]T = arg` accepts.  The next argument can't change it.
# AGAST #2306: a large `[N]T` is passed `ptr byval`, so the slot itself is the
# argument (LLVM copies it at the call) and nothing is loaded first-class.
fn emit_array_arg_value(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    var value: *Expr = arg
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        value = arg.operand
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_array_value_llvm_type(s, p)
    format_into(s, "  ; #2287 array arg\n")
    entry_alloca_reg_end(s)
    let ptr_loc: *LocalVar = array_ptr_local(s, value)
    if p.param_array_shape != null
        emit_nd_array_value_into(s, slot, p.param_array_shape, value)   # AGAST #3634
    else if ptr_loc != null and lv_is_lent(ptr_loc) == 0
        emit_array_ptr_arg_copy(s, value, ptr_loc, slot, p)
    else
        emit_array_local_whole_assign(s, slot, p.param_array_size, p.param_array_elem_type, p.param_type_name, value)
    if array_param_uses_byval(s, p) == 1
        return slot
    let val: i32 = next_reg(s)
    format_into(s, "  %.{val} = load ")
    emit_array_value_llvm_type(s, p)
    format_into(s, ", ptr %.{slot}\n")
    return val

# AGAST #2287: `g(a)` with `a` a whole array, into a param that takes it by
# address: the address, as an i64 like `g(@a)`, which the arg cascades turn into
# what the param is.  This argument used to read the array's first 8 bytes and
# hand them to the callee as a pointer.  0 when `arg` is anything else.
fn emit_array_arg_addr(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if param_takes_array_ref(p) == 0
        return 0
    var ptr: i32 = 0
    var place: ArraySrc
    # AGAST #2290: a reborrow.  An `@[N]T` slot is an i64; the `ptr` slots
    # (`:&`, `@&[N]T`) take the pointer itself.  AGAST #2322: this is the only
    # place a bare `a:& [N]T` is its pointer; emit_expr_ident refuses it.
    if lent_local(s, arg) != null
        let lent: *LocalVar = lent_array_ident(s, arg)
        if lent == null
            return 0
        if p.param_type != TypeKind.Ref
            return lent.reg
        ptr = lent.reg
    else if array_place_shape(s, arg, @place) == 1
        ptr = emit_array_place_ptr(s, arg)
    else if arg.kind == ExprKind.Member and arg_field_is_array(s, arg)
        var mr: MemberPtrResult
        emit_member_ptr(s, arg, @mr)
        ptr = mr.reg
    if ptr == 0
        return 0
    let addr: i32 = next_reg(s)
    format_into(s, "  %.{addr} = ptrtoint ptr %.{ptr} to i64  ; #2287 array by address\n")
    return addr

# AGAST #2279: `return c` or a tail `c` with `c:& C` in a fn returning `C`: the
# value is the referent.  Emits the `ret` and returns 1; 0 when `e` is anything
# else.  Only s.fcx.ret_type_name's slot reads it.
# AGAST #2302: `return e` / a tail `e` in a `-> [N]T` fn, whose return `ra` is
# that type as a param.  As ritz0, the return is a first-class `[N x T]`: `e` is
# copied into a fresh one by emit_array_local_whole_assign, whose checks it
# gets (so it returns what `let b: [N]T = e` accepts), and that is loaded and
# returned.  Returns 1 when `ra` is non-null, i.e. when this was the return.
# AGAST #3181: a large `[N]T` is built in a slot the same way, which is then
# copied pointer-to-pointer into the caller's `%ret.sret` (`ret void`).
pub fn emit_array_return(s: *EmitterState, e: *Expr, ra: *Param) -> i32
    if ra == null
        return 0
    let slot: i32 = emit_array_return_slot(s, ra)
    if ra.param_array_shape != null
        emit_nd_array_value_into(s, slot, ra.param_array_shape, e)   # AGAST #3634
    else
        emit_array_local_whole_assign(s, slot, ra.param_array_size, ra.param_array_elem_type, ra.param_type_name, e)
    emit_array_return_from(s, ra, slot)

# AGAST #2305: a `-> [N]T` fn whose last statement is an `if` / `else`: each
# arm's tail is the array returned, as `if c then a else b` is.  Before this the
# arms' i64 value met emit_implicit_return_tail's refusal.  0 when `st` is no
# such tail, or the fn returns no array.
# AGAST #3276: a tail `match` (StmtKind.Match) too: each arm's value is returned.
pub fn emit_array_return_if_stmt(s: *EmitterState, st: *Stmt, ra: *Param) -> i32
    if ra == null or st == null
        return 0
    if st.kind == StmtKind.Match
        let mslot: i32 = emit_array_return_slot(s, ra)
        emit_array_match_into(s, mslot, ra.param_array_size, ra.param_array_elem_type, ra.param_type_name, st.if_cond, st.if_then as *MatchArm, st.span)
        return emit_array_return_from(s, ra, mslot)
    if st.kind != StmtKind.If or st.if_else == null
        return 0
    let slot: i32 = emit_array_return_slot(s, ra)
    emit_array_stmt_if_into(s, slot, ra.param_array_size, ra.param_array_elem_type, ra.param_type_name, st)
    emit_array_return_from(s, ra, slot)

pub fn emit_lent_return(s: *EmitterState, e: *Expr, ret_type: TypeKind) -> i32
    if ret_type != TypeKind.Struct
        return 0
    let val: i32 = emit_lent_referent(s, e, s.fcx.ret_type_name)
    if val == 0
        return 0
    if s.fcx.ret_sret == 1
        emit_sret_ret_value(s, val)   # AGAST #1730
        return 1
    format_into(s, "  ret ")
    emit_llvm_type_struct(s, TypeKind.Struct, s.fcx.ret_type_name)
    format_into(s, " %.{val}\n")
    return 1

# emit_expr for a by-value slot of type `ty` whose enum context, if any, the
# caller has set: a `let` or a parameter (#2279).  An array element (#2250) is
# emit_expr_into_slot's, which sets the element's enum (AGAST #2454).
pub fn emit_expr_by_value(s: *EmitterState, e: *Expr, ty: TypeKind, name: StrView) -> i32
    if ty == TypeKind.Struct
        let referent: i32 = emit_lent_referent(s, e, name)
        if referent != 0
            return referent
    return emit_struct_copy(s, e, ty)

# emit_expr_into_slot for a struct field.
pub fn emit_expr_into_field_impl(s: *EmitterState, e: *Expr, field: *StructField) -> i32
    return emit_expr_into_slot(s, e, field.field_type, field.field_type_name)

# The address of a place borrowed by `p`, as an i64 like `@x`; every slot
# converts that to what it is.  0 when `arg` is anything else.
# AGAST #2354: every slot reads `arg` as expr_is_ptr_valued says it is, and an
# `@&U` local is a `ptr`, so its place's address stays one.
fn emit_borrowed_place(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if borrow_arg_kind(s, arg, p) != BorrowKind.Place
        return 0
    let ptr: i32 = emit_lvalue_ptr(s, arg)
    if ptr < 0
        emit_ir_error_sv(s, arg.span, "cannot take mutable address")
        return 0
    if expr_is_ptr_valued(s, arg) == 1
        return ptr
    let addr: i32 = next_reg(s)
    format_into(s, "  %.{addr} = ptrtoint ptr %.{ptr} to i64  ; #2335 borrowed place\n")
    return addr

# Emit an Ok/Some/Err/None constructor as a `%Result$.../Option$...` struct
# value. `tag` is the variant index (0 = Ok/Some, 1 = Err/None).
# `payload_expr` is null for unit variants.  Returns the register holding
# the loaded struct value.  `ctor` is the constructor, for the error when
# nothing names its enum.
fn emit_variant_struct(s: *EmitterState, tag: i32, ctor: *Expr) -> i32
    let enum_name: StrView = resolve_enum_ctx(s)
    if unnamed(enum_name)
        return emit_no_enum_ctx_error(s, ctor)
    return emit_variant_build(s, enum_name, tag, ctor.args)

# AGAST #1797: `Holds(x)`, a payload variant of a user enum (unqualified, as
# ritz0's variant_to_enum resolves it: enum_of_variant), with its payload:
# AGAST #1295: every field of a tuple variant, `Rect(w, h)`, and of a struct
# variant built positionally, `Big(1, 2, 3)`.  The qualified `Opt.Holds(x)` is an
# ExprKind.Method: emit_qualified_variant_ctor (#1466).  Returns 0 when `e` is
# not one.
# AGAST #2039: a callee two enums declare is the located ambiguity error,
# not the last-declared enum's ctor.
fn try_emit_user_variant_ctor(s: *EmitterState, e: *Expr) -> i32
    # AGAST #2422: `Full(5)` in a `Slot<i32>` slot builds that instance.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, e.func_name, @ivi)
    if iei >= 0
        let ikind: i32 = enum_variant_kind(s.sym.mono.pctx, iei, ivi)
        # AGAST #1295: a payload variant takes its fields' values (counted
        # by emit_variant_build).
        if (ikind == ENUM_VARIANT_UNIT and e.args == null) or ((ikind == ENUM_VARIANT_TUPLE or ikind == ENUM_VARIANT_STRUCT) and e.args != null)
            let in_name: StrView = enum_name_at(s.sym.mono.pctx, iei)
            return emit_variant_build(s, in_name, ivi, e.args)
    var amb_a: i32 = 0
    var amb_b: i32 = 0
    if user_variant_ctor_ambiguous(s.sym.mono.pctx, e, @amb_a, @amb_b) == 1
        return emit_ambiguous_variant_error(s, e.func_name, e.span, amb_a, amb_b)
    let en: StrView = user_variant_ctor_enum(s.sym.mono.pctx, e)
    if en.ptr == null
        # AGAST #3021: a generic enum's `Full(6)` no slot names an instance
        # of is refused here; it called an undeclared `@Full`.  A fn of that
        # name is still the call.
        if find_fn(s, e.func_name) == null
            # AGAST #4153: `Z(1)` / `One()`, a variant given the wrong count.
            var mei: i32 = 0
            var mvi: i32 = 0
            if user_variant_ctor_miscounted(s.sym.mono.pctx, e, @mei, @mvi) == 1
                return emit_payload_count_refusal(s, mei, mvi, e)
            return emit_no_instance_error(s, e.func_name, e.span)
        return 0
    var vi: i32 = 0
    var other: i32 = 0
    enum_of_variant_unique(s.sym.mono.pctx, e.func_name, @vi, @other)
    return emit_variant_build(s, en, vi, e.args)

# AGAST #1466: `E.V(args)`, variant `vi` of enum `ei` (see qualified_variant),
# lowered as the unqualified `V(args)` is (try_emit_user_variant_ctor): a
# tuple or struct variant with one value per field (AGAST #1295), or a unit variant called with none.
# Anything else ritz1 cannot build is a located error, never IR.
fn emit_qualified_variant_ctor(s: *EmitterState, e: *Expr, ei: i32, vi: i32) -> i32
    if enum_is_generic(s.sym.mono.pctx, ei) == 1
        return emit_qualified_variant_error_sv(s, e, "is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. Some(x) / Ok(x) / None")
    let en: StrView = enum_name_at(s.sym.mono.pctx, ei)
    let kind: i32 = enum_variant_kind(s.sym.mono.pctx, ei, vi)
    # AGAST #1295: a tuple variant, or a struct one built positionally, takes
    # one value per field (emit_variant_build counts them, located); a unit
    # variant none.  The rest is the count's error, as unqualified (#4153).
    if kind == ENUM_VARIANT_UNIT
        if e.args == null
            return emit_variant_build(s, en, vi, null)
        return emit_payload_count_refusal(s, ei, vi, e)
    if e.args == null
        return emit_payload_count_refusal(s, ei, vi, e)
    return emit_variant_build(s, en, vi, e.args)

# AGAST #2288: `E.Full(c)`, `Full(c)` or `Some(c)` with `c:& C`, when the
# variant's declared payload is `C`: the referent, as in ritz0.  0 when `e` is
# anything else, or the payload is no `C` (a `Full(*C)` keeps the pointer).
fn emit_lent_payload(s: *EmitterState, enum_name: StrView, tag: i32, e: *Expr) -> i32
    if lent_referent_local(s, e) == null
        return 0
    let pay: StrView = variant_payload_type_name(s, enum_name, tag)
    if pay.len <= 0
        return 0
    return emit_lent_referent(s, e, pay)

# AGAST #2926: emit a variant's payload with the enum context its declared
# type gives, as emit_call_arg does for a parameter: `Has(Some(6))` with
# `Has(Option<i32>)` builds `%Option$i32`, and a payload slot that is no enum
# bars the outer one.  Only a payload whose type is known takes a slot; any
# other keeps the context it had.
fn emit_payload_into_slot(s: *EmitterState, enum_name: StrView, tag: i32, e: *Expr) -> i32
    let pay_ty: StrView = variant_payload_type_name(s, enum_name, tag)
    if pay_ty.len <= 0
        return emit_expr(s, e)
    let saved_name: StrView = s.fcx.ctx_enum_name
    let saved_arg: i32 = s.fcx.ctx_enum_arg
    s.fcx.ctx_enum_name = strview_empty()
    s.fcx.ctx_enum_arg = 1
    if is_tagged_enum_type(pay_ty) == 1 or is_enum_instance(s.sym.mono.pctx, pay_ty) == 1
        s.fcx.ctx_enum_name = pay_ty
    # AGAST #4678: a struct payload is a copy into the variant's slot, as a
    # struct argument is, so a whole struct element (`Some(m.params[i])`,
    # `Ok(p[i])`) is its value rather than refused (whole_struct_elem_refused).
    var reg: i32 = 0
    if find_struct(s, pay_ty) != null
        reg = emit_struct_copy(s, e, TypeKind.Struct)
    else
        reg = emit_expr(s, e)
    s.fcx.ctx_enum_name = saved_name
    s.fcx.ctx_enum_arg = saved_arg
    reg

# AGAST #3029: write the array literal or fill `e` into the payload buffer at
# `pay_ptr`, at its declared `[N]T` (variant_array_payload), as a struct
# literal's array field is (emit_struct_lit_array_fill_field).  emit_expr has
# no slot for one: it built a shadow `[N x i64]` and the payload got its
# ADDRESS (#3014 refused that).
fn emit_array_payload_into(s: *EmitterState, pay_ptr: i32, arr: *ArrayArg, e: *Expr)
    if e.kind == ExprKind.ArrayLit
        emit_array_lit_into(s, pay_ptr, arr.size, arr.elem, arr.name, e)
    else
        emit_array_fill_into(s, pay_ptr, arr.size, arr.elem, arr.name, e.left)

# AGAST #1295: one evaluated variant payload field, between evaluating it
# (eval_variant_payload) and storing it into the enum (store_variant_payload).
struct VariantPayload
    have: PayloadHave
    reg: i32
    arr: ArrayArg

# What an evaluated payload field holds.
enum PayloadHave
    Nothing   # `Ok(())`, a unit variant
    Value     # a value in `reg`
    InPlace   # an array literal / fill, written in place from `arr`

# Evaluate payload field `sel` (variant_sel: field k of variant `tag`;
# Result / Option pass their 0 / 1) from `e`, null for none.
fn eval_variant_payload(s: *EmitterState, enum_name: StrView, sel: i32, e: *Expr, pv: *VariantPayload)
    pv.have = PayloadHave.Nothing
    pv.reg = 0
    # AGAST #3029: an array literal payload is written in place, below.
    let arr_payload: i32 = variant_array_payload(s, enum_name, sel, e, @pv.arr)
    # AGAST #2272: `Ok(())` carries a zero-byte payload: nothing to store.
    if arr_payload == 1
        pv.have = PayloadHave.InPlace
    else if e != null and is_unit_expr(e) == 0
        pv.reg = emit_lent_payload(s, enum_name, sel, e)
        if pv.reg == 0
            pv.reg = emit_payload_into_slot(s, enum_name, sel, e)
        pv.have = PayloadHave.Value

# Store the evaluated payload field `sel` (eval_variant_payload, from `e`)
# into the enum at `slot`, at the field's offset and type.
fn store_variant_payload(s: *EmitterState, slot: i32, enum_name: StrView, sel: i32, e: *Expr, pv: *VariantPayload)
    match pv.have
        PayloadHave.Nothing => pass
        PayloadHave.InPlace =>
            let arr_ptr: i32 = emit_payload_ptr(s, slot, enum_name, sel)
            emit_array_payload_into(s, arr_ptr, @pv.arr, e)
        PayloadHave.Value =>
            store_variant_value(s, slot, enum_name, sel, e, pv.reg)

# Payload field `sel`'s value `reg` into field 2 (the `[N x i8]` buffer after
# the pad, AGAST #1898), at the field's offset (AGAST #1295).  ritz1's expr
# evaluation always yields an i64-width register for scalar / ptr payloads; it
# is stored at the payload's own width (truncated), as ritz0 stores it.  A
# struct payload (e.g. `Vec<u8>` or `StrView`) is the aggregate register,
# stored by its declared name (payload_aggregate_name).
fn store_variant_value(s: *EmitterState, slot: i32, enum_name: StrView, sel: i32, e: *Expr, reg: i32)
    let pay_ptr: i32 = emit_payload_ptr(s, slot, enum_name, sel)
    let aggregate: StrView = payload_aggregate_name(s, enum_name, sel, e)
    if not unnamed(aggregate)
        emit_struct_store_or_copy(s, TypeKind.Struct, aggregate, reg, pay_ptr)
        return
    # AGAST #1945: a float payload is stored at its own type; a literal
    # (always double) or an integer is converted first.
    var store_reg: i32 = reg
    let pay_ft: TypeKind = tagged_enum_float_type(s, enum_name, sel)
    if pay_ft != TypeKind.Void
        store_reg = emit_float_coerce(s, reg, expr_slot_ty(e), pay_ft)
    else
        # AGAST #2384: an `@&T` payload (`Some(r)`, `r: @&C`, into an
        # `Option<@&C>`) is a `ptr`; the payload slot holds an i64.
        store_reg = ptr_value_to_i64(s, e, reg)
    emit_tagged_payload_store(s, store_reg, pay_ptr, enum_name, sel)

# The struct or enum payload field `sel` of `enum_name` holds, as `e` builds
# it; unnamed for a scalar.
fn payload_aggregate_name(s: *EmitterState, enum_name: StrView, sel: i32, e: *Expr) -> StrView
    let built: StrView = variant_payload_aggregate(s, e)
    if not unnamed(built)
        return built
    # AGAST #1797: a user enum's tuple variant declares its payload type; a
    # struct one is the aggregate whatever the expression form.
    let uf: *StructField = user_enum_tuple_field(s.sym.mono.pctx, enum_name, sel)
    if uf != null and uf.field_type == TypeKind.Struct and uf.field_type_name.len > 0
        return uf.field_type_name
    # AGAST #2987: a tagged enum's payload declared as an enum (a tagged one,
    # an instance or a user enum: `Some(Some(6))` in an `Option<Option<i32>>`,
    # `Ok(None)` in a `Result<Option<i32>, E>`) is that aggregate whatever the
    # expression form: the payload was built in its slot
    # (emit_payload_into_slot).  It was stored as an i64: invalid IR.
    let decl_sv: StrView = tagged_enum_arg(s, enum_name, sel)
    if decl_sv.ptr == null or decl_sv.len <= 0
        return no_name()
    if is_tagged_enum_type(decl_sv) == 1 or enum_find(s.sym.mono.pctx, decl_sv) >= 0
        return decl_sv
    no_name()


# Build `%Enum` with tag `tag` and payload `payload_expr` (null: none) in a
# zeroed alloca, and load it.  `enum_name` is a tagged enum (Result$/Option$,
# where `tag` 0 / 1 also picks Ok-Some / Err for the payload width) or a
# user enum (AGAST #1797; the payload type is the tuple variant's).
# AGAST #1295: `payload_expr` is the head of the argument list: a user
# enum's variant takes one value per field, each stored at its offset.
fn emit_variant_build(s: *EmitterState, enum_name: StrView, tag: i32, payload_expr: *Expr) -> i32
    let ei: i32 = user_enum_index(s.sym.mono.pctx, enum_name)
    if ei >= 0 and tag >= 0 and tag < enum_variant_count(s.sym.mono.pctx, ei) and payload_expr != null
        let nf: i32 = enum_variant_field_count(s.sym.mono.pctx, ei, tag)
        var na: i32 = 0
        var a: *Expr = payload_expr
        while a != null
            na += 1
            a = a.next
        if nf > 0 and na != nf
            emit_payload_count_error(s, ei, tag, payload_expr, payload_expr.span)
        if nf > 1 and na == nf
            # Evaluated left to right, each straight into its field.
            let mslot: i32 = emit_variant_slot(s, enum_name, tag)
            var arg: *Expr = payload_expr
            var k: i32 = 0
            while arg != null
                var fpv: VariantPayload
                let sel: i32 = variant_sel(tag, k)
                eval_variant_payload(s, enum_name, sel, arg, @fpv)
                store_variant_payload(s, mslot, enum_name, sel, arg, @fpv)
                arg = arg.next
                k += 1
            return emit_variant_load(s, mslot, enum_name)

    # Emit payload first (may consume registers); keep expr value for store.
    var pv: VariantPayload
    eval_variant_payload(s, enum_name, tag, payload_expr, @pv)
    let slot: i32 = emit_variant_slot(s, enum_name, tag)
    store_variant_payload(s, slot, enum_name, tag, payload_expr, @pv)
    # Load the assembled struct to return its value.
    return emit_variant_load(s, slot, enum_name)

# =============================================================================
# AGAST #167 — SIMD builtin lowering
#
# ritz0 (Python) handles SIMD intrinsics in emitter_llvmlite.py via direct LLVM
# IR generation rather than going through the regular call path.  ritz1's
# generic call path always emits `call i64 @name`, which mismatches when the
# binding is a `<N x iM>` vector type.  These helpers port ritz0's inline
# lowering for the simd_* builtins (simd_loadu, simd_xor, simd_add, etc.).
# Vector-type selection: prefer the binding context (`s.fcx.ctx_simd_name`, set
# by emit_var_decl / emit_assign) for simd_load/loadu where the type is not
# encoded in the args; for binary ops fall back to walking the arg locals.
# =============================================================================

# `simd_loadu(ptr) -> vec<N,T>` / `simd_load(...)`: emit an inline LLVM load
# with the vector type pulled from `s.fcx.ctx_simd_name` (set by the enclosing
# `let v: v4i32 = ...` / `v = ...`).  `unaligned == 1` → align 1; else use
# 16-byte (SSE2) or 32-byte (AVX2) alignment based on the chosen vec type.
fn emit_simd_loadu(s: *EmitterState, e: *Expr, unaligned: bool) -> i32
    if e.args == null
        return simd_refused(s, e, "simd_load(u) requires a pointer argument")
    let arg_reg: i32 = emit_expr(s, e.args)
    # No operand to read the type from: the binding context, else v4i32 (the
    # most common SSE2 shape).  Keeps IR well-formed even when we can't
    # infer; the user will get a clear type error downstream if it doesn't
    # match the binding.
    let vec_name: StrView = simd_type_of(s, null)
    let vt: StrView = simd_vec_llvm(vec_name)
    let align: i64 = simd_align(vec_name, unaligned)
    # Convert i64 ptr-as-int to ptr (ritz1's unified value model passes
    # all pointers as i64 except when the param is TypeKind.MutRef).
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = inttoptr i64 %.{arg_reg} to ptr  ; simd_load: ptr cast\n")
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = load {vt}, ptr %.{p}, align {align}\n")
    return result

# `simd_storeu(ptr, vec)` / `simd_store(...)`: emit inline LLVM store.
fn emit_simd_storeu(s: *EmitterState, e: *Expr, unaligned: bool) -> i32
    if e.args == null or e.args.next == null
        return simd_refused(s, e, "simd_store(u) requires (ptr, vec)")
    let ptr_reg: i32 = emit_expr(s, e.args)
    let vec_reg: i32 = emit_expr(s, e.args.next)
    let vec_name: StrView = simd_type_of(s, e.args.next)
    let vt: StrView = simd_vec_llvm(vec_name)
    let align: i64 = simd_align(vec_name, unaligned)
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = inttoptr i64 %.{ptr_reg} to ptr  ; simd_store: ptr cast\n")
    format_into(s, "  store {vt} %.{vec_reg}, ptr %.{p}, align {align}\n")
    # Void result — return a sentinel i64 0.  Callers that bind the result
    # see a harmless no-op value; the typical use is statement-position
    # `simd_storeu(...)` where the value is dropped.
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0  ; simd_store void\n")
    return z

# `simd_xor(a,b)` / `simd_add(a,b)` — binary vector ops (`opname` is the IR
# opcode, "xor" / "add").  Vector type is derived from the args
# (vector-typed locals) or context.
fn emit_simd_binop(s: *EmitterState, e: *Expr, opname: StrView) -> i32
    if e.args == null or e.args.next == null
        # ritz0's words (AGAST #4665): emitter/intrinsics.py.
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprint_bytes(e.func_name)
        eprints("() requires 2 arguments (vector, vector)\n")
        return simd_zero(s)
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: StrView = resolve_simd_arg_type(s, e.args)
    if unnamed(vec_name)
        vec_name = simd_type_of(s, e.args.next)
    let vt: StrView = simd_vec_llvm(vec_name)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = {opname} {vt} %.{a_reg}, %.{b_reg}\n")
    return result

# `simd_extract(vec, idx) -> elem` — `extractelement`.
fn emit_simd_extract(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        return simd_refused(s, e, "simd_extract requires (vec, idx)")
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    let vec_name: StrView = simd_type_of(s, e.args)
    # `idx_reg` is i64 in the unified value model; truncate to i32 for
    # the extractelement opcode.
    let i32idx: i32 = ir_trunc_i64_i32(s.ir.out, @s.fcx.reg_counter, idx_reg)
    let elem: i32 = next_reg(s)
    format_into(s, "  %.{elem} = extractelement {simd_vec_llvm(vec_name)} %.{vec_reg}, i32 %.{i32idx}\n")
    # Element is the vector's scalar type — extend to i64 for the unified
    # value model so downstream consumers work uniformly.
    if simd_vector_elem_bits(vec_name) == 64
        return elem
    let ext: i32 = next_reg(s)
    format_into(s, "  %.{ext} = sext {simd_elem_llvm(vec_name)} %.{elem} to i64\n")
    return ext

# `simd_insert(vec, idx, val) -> vec` — `insertelement`.
fn emit_simd_insert(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        return simd_refused(s, e, "simd_insert requires (vec, idx, val)")
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    let val_reg: i32 = emit_expr(s, e.args.next.next)
    let vec_name: StrView = simd_type_of(s, e.args)
    let vt: StrView = simd_vec_llvm(vec_name)
    let et: StrView = simd_elem_llvm(vec_name)
    let i32idx: i32 = ir_trunc_i64_i32(s.ir.out, @s.fcx.reg_counter, idx_reg)
    # Truncate val from i64 down to the element width.
    var val_narrow: i32 = val_reg
    if simd_vector_elem_bits(vec_name) != 64
        val_narrow = next_reg(s)
        format_into(s, "  %.{val_narrow} = trunc i64 %.{val_reg} to {et}\n")
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = insertelement {vt} %.{vec_reg}, {et} %.{val_narrow}, i32 %.{i32idx}\n")
    return result

# `simd_shuffle(a, b, mask...)` — `shufflevector`.  Mask args must all be
# integer literals (compile-time constants).
fn emit_simd_shuffle(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        return simd_refused(s, e, "simd_shuffle requires (vec, vec, mask...)")
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    let vt: StrView = simd_vec_llvm(simd_type_of(s, e.args))
    let mask: *Expr = e.args.next.next
    var mask_count: i32 = 0
    var mask_arg: *Expr = mask
    while mask_arg != null
        mask_count = mask_count + 1
        mask_arg = mask_arg.next
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = shufflevector {vt} %.{a_reg}, {vt} %.{b_reg}, <{mask_count} x i32> <")
    mask_arg = mask
    while mask_arg != null
        if mask_arg != mask
            format_into(s, ", ")
        # Best-effort: 0 for a non-literal (LLVM rejects it, but the compiler
        # at least doesn't crash).  ritz0 raises here.
        var v: i64 = 0
        if mask_arg.kind == ExprKind.IntLit
            v = mask_arg.int_val
        format_into(s, "i32 {v}")
        mask_arg = mask_arg.next
    format_into(s, ">\n")
    return result

# `simd_rotl(vec, n)` — rotate-left by constant n.  Implemented as
# `(v << n) | (v >> (bits - n))`.  `n` must be a compile-time integer
# literal so we can broadcast the shift constants directly.
fn emit_simd_rotl(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        return simd_refused(s, e, "simd_rotl requires (vec, n)")
    let vec_reg: i32 = emit_expr(s, e.args)
    let vec_name: StrView = simd_type_of(s, e.args)
    let vt: StrView = simd_vec_llvm(vec_name)
    let et: StrView = simd_elem_llvm(vec_name)
    let count: i32 = simd_vector_elem_count(vec_name)
    let shift_amount: i64 = simd_const_arg(e.args.next)
    let right_shift: i64 = (simd_vector_elem_bits(vec_name) as i64) - shift_amount
    # Broadcast splats for the left/right shift constants.
    let left_shifted: i32 = next_reg(s)
    format_into(s, "  %.{left_shifted} = shl {vt} %.{vec_reg}, ")
    emit_simd_splat(s, et, count, shift_amount)
    let right_shifted: i32 = next_reg(s)
    format_into(s, "  %.{right_shifted} = lshr {vt} %.{vec_reg}, ")
    emit_simd_splat(s, et, count, right_shift)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = or {vt} %.{left_shifted}, %.{right_shifted}\n")
    return result

# `<et v, et v, ...>` (`count` lanes) and the end of the line.
fn emit_simd_splat(s: *EmitterState, et: StrView, count: i32, v: i64)
    format_into(s, "<")
    for i in 0..count
        if i > 0
            format_into(s, ", ")
        format_into(s, "{et} {v}")
    format_into(s, ">\n")

# `simd_sad(a: v16i8, b: v16i8) -> v2i64` — sum of absolute differences,
# routes to `llvm.x86.sse2.psad.bw`.  The result type differs from the args.
fn emit_simd_sad(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        return simd_refused(s, e, "simd_sad requires (vec, vec)")
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    add_extern(s, "llvm.x86.sse2.psad.bw")
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = call <2 x i64> @llvm.x86.sse2.psad.bw(<16 x i8> %.{a_reg}, <16 x i8> %.{b_reg})\n")
    return result

# `simd_clmul(a: v2i64, b: v2i64, imm8: u8) -> v2i64` — carryless multiply
# (PCLMULQDQ).  imm must be a compile-time constant 0-255.
fn emit_simd_clmul(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        return simd_refused(s, e, "simd_clmul requires (vec, vec, imm8)")
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    let imm: i64 = simd_const_arg(e.args.next.next)
    add_extern(s, "llvm.x86.pclmulqdq")
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = call <2 x i64> @llvm.x86.pclmulqdq(<2 x i64> %.{a_reg}, <2 x i64> %.{b_reg}, i8 {imm})\n")
    return result

# A simd builtin's constant operand: an integer literal, or one cast
# (`3 as u8`); 0 for anything else.
fn simd_const_arg(x: *Expr) -> i64
    if x.kind == ExprKind.IntLit
        return x.int_val
    if x.kind == ExprKind.Cast and x.left != null and x.left.kind == ExprKind.IntLit
        return x.left.int_val
    0

# A malformed simd call: the located refusal, and a 0 in its place.
fn simd_refused(s: *EmitterState, e: *Expr, msg: StrView) -> i32
    emit_ir_error_sv(s, e.span, msg)
    simd_zero(s)

# `%.z = add i64 0, 0`, the value an erroneous simd call stands for.
fn simd_zero(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0\n")
    z

# As resolve_simd_arg_type, defaulting to v4i32 (the most common SSE2 shape).
fn simd_type_of(s: *EmitterState, arg: *Expr) -> StrView
    let name: StrView = resolve_simd_arg_type(s, arg)
    if unnamed(name)
        return "v4i32"
    name

# A vector load / store's alignment: 1 when unaligned; else the vector's
# width, 32 bytes for an AVX2 type and 16 for an SSE2 one.
fn simd_align(name: StrView, unaligned: bool) -> i64
    if unaligned
        return 1
    if simd_vector_elem_bits(name) * simd_vector_elem_count(name) >= 256
        return 32
    16

# Generic x86 LLVM-intrinsic dispatch — emit `call <vec_type> @<llvm_name>(...)`.
# Used for the SHA-NI and AES-NI families which take and return SIMD vectors
# but aren't simd_*-prefixed.  Adds the LLVM intrinsic name to the externs
# table so the matching `declare` is emitted in emit_extern_declarations.
# `vec_name` chooses the vector LLVM type for both args and result.
# `arity` is the number of vector args (1, 2, or 3).
fn emit_x86_simd_intrinsic(s: *EmitterState, e: *Expr, llvm_name: StrView, arity: i32, vec_name: StrView) -> i32
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4
        arg_regs[arg_count] = emit_expr(s, arg_it)
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        return simd_refused(s, e, "x86 intrinsic arity mismatch")
    add_extern(s, llvm_name)
    let vt: StrView = simd_vec_llvm(vec_name)
    let callee: String = ir_name(llvm_name)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = call {vt} @{callee.as_view()}(")
    for k in 0..arg_count
        if k > 0
            format_into(s, ", ")
        let r: i32 = arg_regs[k]
        format_into(s, "{vt} %.{r}")
    format_into(s, ")\n")
    return result

# SHA-NI wrapper: those intrinsics take and return <4 x i32>, the only type
# the builtins accept (ritz0 rejects others), so no cast is needed.
fn emit_x86_intrinsic_v4i32(s: *EmitterState, e: *Expr, llvm_name: StrView, arity: i32) -> i32
    emit_x86_simd_intrinsic(s, e, llvm_name, arity, "v4i32")

# AES-NI (AGAST #1609): `llvm.x86.aesni.*` take and return only <2 x i64>,
# but the ritz builtins accept any 128-bit integer vector, as ritz0 does.  An
# operand whose type resolves to anything but v2i64 (in practice v4i32) is
# bitcast to <2 x i64> on the way in, and the result is bitcast back to the
# state operand's (first arg's) type.  An operand whose type cannot be
# resolved is taken as v2i64, which is what this path emitted before.
# `Some(imm8)` appends a trailing `i8 <imm8>` immediate after the `arity`
# vector args (aeskeygenassist's rcon, AGAST #3266).  The
# caller has already consumed that arg, so it is not walked here.
fn emit_x86_intrinsic_v2i64(s: *EmitterState, e: *Expr, llvm_name: StrView, arity: i32, imm8: Option<i64>) -> i32
    # An immediate takes the place of any argument past `arity`.
    var has_imm: bool = false
    var imm: i64 = 0
    match imm8
        Some(v) =>
            has_imm = true
            imm = v
        None => pass
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var res_name: StrView = "v2i64"
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4 and (not has_imm or arg_count < arity)
        var reg: i32 = emit_expr(s, arg_it)
        let a_name: StrView = resolve_simd_arg_type(s, arg_it)
        if not unnamed(a_name)
            if arg_count == 0
                res_name = a_name
            if name_eq(a_name, "v2i64") == 0
                reg = emit_simd_bitcast(s, reg, a_name, "<2 x i64>")
        arg_regs[arg_count] = reg
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        emit_ir_error_sv(s, e.span, "x86 intrinsic arity mismatch")
        let z: i32 = next_reg(s)
        format_into(s, "  %.{z} = add i64 0, 0\n")
        return z
    add_extern(s, llvm_name)
    let result: i32 = next_reg(s)
    let callee: String = ir_name(llvm_name)
    format_into(s, "  %.{result} = call <2 x i64> @{callee.as_view()}(")
    for k in 0..arg_count
        if k > 0
            format_into(s, ", ")
        format_into(s, "<2 x i64> %.{arg_regs[k]}")
    if has_imm
        format_into(s, ", i8 {imm}")
    format_into(s, ")\n")
    if name_eq(res_name, "v2i64") == 1
        return result
    let cast_out: i32 = next_reg(s)
    format_into(s, "  %.{cast_out} = bitcast <2 x i64> %.{result} to ")
    emit_simd_vector_type(s, res_name)
    format_into(s, "\n")
    return cast_out

# `%.N = bitcast <from> %.reg to <to>`: `reg`, of the SIMD vector type named
# `from`, as the vector type spelled `to`.
fn emit_simd_bitcast(s: *EmitterState, reg: i32, from: StrView, to: StrView) -> i32
    let cast: i32 = next_reg(s)
    format_into(s, "  %.{cast} = bitcast ")
    emit_simd_vector_type(s, from)
    format_into(s, " %.{reg} to {to}\n")
    cast

# `aeskeygenassist(key, rcon)` (AGAST #3266) -> the key's vector type.  LLVM
# declares rcon `immarg`: it must be a constant i8 in the call itself, so as
# in ritz0 it has to be an integer literal (optionally cast), masked to a
# byte.  Anything else is a compile error, not IR clang would refuse.
fn emit_aeskeygenassist(s: *EmitterState, e: *Expr) -> i32
    let llvm_name: StrView = "llvm.x86.aesni.aeskeygenassist"
    if e.args == null or e.args.next == null or e.args.next.next != null
        emit_ir_error_sv(s, e.span, "aeskeygenassist() requires 2 arguments (key, rcon)")
        return emit_x86_intrinsic_v2i64(s, e, llvm_name, 2, None)
    let rcon: *Expr = e.args.next
    var imm: i64 = 0
    if rcon.kind == ExprKind.IntLit
        imm = rcon.int_val & 255
    else if rcon.kind == ExprKind.Cast and rcon.left != null and rcon.left.kind == ExprKind.IntLit
        imm = rcon.left.int_val & 255
    else
        emit_ir_error_sv(s, e.span, "aeskeygenassist() second arg (rcon) must be an integer literal (LLVM i8 immediate)")
    emit_x86_intrinsic_v2i64(s, e, llvm_name, 1, Some(imm))

# volatile_* / atomic_* / fence (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879).
# `xgetbv(xcr)` (AGAST #4657): XCR `xcr` (ecx in) as a u64, edx:eax.  The
# operand is an integer in the i64 value model, so it is truncated to the
# i32 ecx takes; Sema has checked the arity (intrinsic_check.ritz).  ritz0's
# lowering (emitter/intrinsics.py _xgetbv), the same asm and constraints.
fn emit_xgetbv(s: *EmitterState, e: *Expr) -> i32
    let x: i32 = mem_narrow(s, emit_expr(s, e.args), 32)
    let pair: i32 = next_reg(s)
    format_into(s, "  %.{pair} = call {{ i32, i32 }} asm sideeffect \"xgetbv\", \"={{ax}},={{dx}},{{cx}},~{{dirflag}},~{{fpsr}},~{{flags}}\"(i32 %.{x})\n")
    var half: [2]i32
    for k in 0..2
        let part: i32 = next_reg(s)
        format_into(s, "  %.{part} = extractvalue {{ i32, i32 }} %.{pair}, {k}\n")
        half[k] = next_reg(s)
        format_into(s, "  %.{half[k]} = zext i32 %.{part} to i64\n")
    let hi: i32 = next_reg(s)
    format_into(s, "  %.{hi} = shl i64 %.{half[1]}, 32\n")
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = or i64 %.{half[0]}, %.{hi}\n")
    r

# How many arguments the MEM_* builtin `id` takes.
fn mem_builtin_arity(id: i32) -> i32
    if id == MEM_FENCE
        return 0
    if id == MEM_VOLATILE_LOAD or id == MEM_ATOMIC_LOAD
        return 1
    if id == MEM_ATOMIC_CMPXCHG
        return 3
    2

# The `atomicrmw` operation of a read-modify-write MEM_* builtin `id` (the
# loads, stores, cmpxchg and fence are emit_mem_builtin's before it asks).
fn atomicrmw_op(id: i32) -> StrView
    if id == MEM_ATOMIC_XCHG
        return "xchg"
    if id == MEM_ATOMIC_ADD
        return "add"
    if id == MEM_ATOMIC_SUB
        return "sub"
    if id == MEM_ATOMIC_AND
        return "and"
    if id == MEM_ATOMIC_OR
        return "or"
    "xor"

# The arity refusal: `<name> takes N argument(s)`.
fn mem_arity_error(s: *EmitterState, e: *Expr, want: i32)
    if want == 0
        mem_builtin_error(s, e, "takes 0 arguments")
    else if want == 1
        mem_builtin_error(s, e, "takes 1 argument")
    else if want == 2
        mem_builtin_error(s, e, "takes 2 arguments")
    else
        mem_builtin_error(s, e, "takes 3 arguments")

fn emit_mem_builtin(s: *EmitterState, e: *Expr, id: i32) -> i32
    let want: i32 = mem_builtin_arity(id)
    var argc: i32 = 0
    var a: *Expr = e.args
    while a != null
        argc += 1
        a = a.next
    if argc != want
        mem_arity_error(s, e, want)
        return 0
    if id == MEM_FENCE
        format_into(s, "  fence seq_cst\n")
        return 0
    let pty: TypeKind = mem_builtin_pointee(s, e.args)
    let bits: i32 = mem_int_type_bits(pty)
    if bits == 0
        mem_builtin_error(s, e, "needs a pointer to an integer type (i8..u64)")
        return 0
    # The pointer: an i64 address (or already a ptr, as for OpKind.Deref).
    let addr: i32 = emit_expr(s, e.args)
    var ptr: i32 = addr
    if deref_operand_is_ptr(s, e.args) == 0
        ptr = next_reg(s)
        format_into(s, "  %.{ptr} = inttoptr i64 %.{addr} to ptr\n")
    # Value operands, left to right, at the pointee width.
    var v1: i32 = -1
    var v2: i32 = -1
    if want >= 2
        v1 = mem_narrow(s, emit_expr(s, e.args.next), bits)
    if want == 3
        v2 = mem_narrow(s, emit_expr(s, e.args.next.next), bits)
    # LLVM requires an explicit alignment on atomics: the natural one.
    let align: i32 = bits / 8
    if id == MEM_VOLATILE_STORE
        format_into(s, "  store volatile i{bits} %.{v1}, ptr %.{ptr}\n")
        return 0
    if id == MEM_ATOMIC_STORE
        format_into(s, "  store atomic i{bits} %.{v1}, ptr %.{ptr} seq_cst, align {align}\n")
        return 0
    let raw: i32 = next_reg(s)
    if id == MEM_VOLATILE_LOAD
        format_into(s, "  %.{raw} = load volatile i{bits}, ptr %.{ptr}\n")
        return mem_widen(s, raw, bits, pty)
    if id == MEM_ATOMIC_LOAD
        format_into(s, "  %.{raw} = load atomic i{bits}, ptr %.{ptr} seq_cst, align {align}\n")
        return mem_widen(s, raw, bits, pty)
    if id == MEM_ATOMIC_CMPXCHG
        # { iN, i1 }: the old value, and whether it equalled `expected`.
        format_into(s, "  %.{raw} = cmpxchg ptr %.{ptr}, i{bits} %.{v1}, i{bits} %.{v2} seq_cst seq_cst\n")
        let old: i32 = next_reg(s)
        format_into(s, "  %.{old} = extractvalue {{ i{bits}, i1 }} %.{raw}, 0\n")
        return mem_widen(s, old, bits, pty)
    let op: StrView = atomicrmw_op(id)
    format_into(s, "  %.{raw} = atomicrmw {op} ptr %.{ptr}, i{bits} %.{v1} seq_cst\n")
    mem_widen(s, raw, bits, pty)

# =============================================================================
# sizeof (LANGUAGE_SPEC §7.9, AGAST #2124)
#
# `sizeof(T)` is the size of type T; `sizeof(expr)` the size of expr's TYPE.
# The operand is never evaluated: these helpers only read declarations, and
# emit_expr_call emits one constant.  Every non-type operand used to come out
# as 8 (so `mem_zero(@key[0], sizeof(key))` wiped 8 bytes of a 64-byte key),
# and so did an unknown type name.  Each helper answers -1 when it cannot
# tell, and the caller makes that a located error: no guess survives.
# =============================================================================

fn emit_call_intrinsic(s: *EmitterState, e: *Expr, ci: *CallIntrinsic) -> i32
    match ci.op
        CallIntrinsicOp.SimdLoad => emit_simd_loadu(s, e, ci.arg == 1)
        CallIntrinsicOp.SimdStore => emit_simd_storeu(s, e, ci.arg == 1)
        CallIntrinsicOp.SimdXor => emit_simd_binop(s, e, "xor")
        CallIntrinsicOp.SimdAdd => emit_simd_binop(s, e, "add")
        CallIntrinsicOp.SimdExtract => emit_simd_extract(s, e)
        CallIntrinsicOp.SimdInsert => emit_simd_insert(s, e)
        CallIntrinsicOp.SimdShuffle => emit_simd_shuffle(s, e)
        CallIntrinsicOp.SimdRotl => emit_simd_rotl(s, e)
        CallIntrinsicOp.SimdSad => emit_simd_sad(s, e)
        CallIntrinsicOp.SimdClmul => emit_simd_clmul(s, e)
        CallIntrinsicOp.X86V4i32 => emit_x86_intrinsic_v4i32(s, e, ci.llvm, ci.arg)
        CallIntrinsicOp.X86V2i64 => emit_x86_intrinsic_v2i64(s, e, ci.llvm, ci.arg, None)
        CallIntrinsicOp.AesKeygenAssist => emit_aeskeygenassist(s, e)
        CallIntrinsicOp.Xgetbv => emit_xgetbv(s, e)

# The name a call `e` names (`print`, `vec_new`), without its type suffix.
fn call_func_name(e: *Expr) -> StrView
    e.func_name

# print / eprint / println / eprintln of a literal: its result when lowered here.
fn try_emit_print_call(s: *EmitterState, e: *Expr) -> Option<i32>
    # print() / eprint() built-ins: the same lowering to fd 1 / fd 2 (#1641).
    # println / eprintln take it too, but only for an interpolated literal
    # (a plain one stays the ritzlib.io function that adds the newline).
    let name: StrView = call_func_name(e)
    var print_fd: i64 = 0
    var print_newline: bool = false
    if name_eq(name, "print") == 1
        print_fd = 1
    else if name_eq(name, "eprint") == 1
        print_fd = 2
    else if name_eq(name, "println") == 1
        print_fd = 1
        print_newline = true
    else if name_eq(name, "eprintln") == 1
        print_fd = 2
        print_newline = true
    # Only an interpolated literal is lowered here; a plain one still
    # resolves to whatever `println` names in this file, as ritz0 has it.
    if print_newline and (e.args == null or e.args.next != null or interp_lit_has_placeholder(e.args) == 0)
        return None
    if print_fd == 0
        return None
    # print(str) -> syscall(1, fd, str_ptr, str_len)
    let arg: *Expr = e.args
    # "..." interpolates `{expr}` placeholders; a C-string literal is written verbatim,
    # and rejected if it holds one (AGAST #1521, #1394).  emitter_print.ritz
    # has the lowering.
    if arg != null and (arg.kind == ExprKind.StringLit or arg.kind == ExprKind.CstringLit)
        return Some(emit_print_literal(s, print_fd, arg, print_newline))
    if arg != null
        # Non-literal: evaluated for its effects; its length is unknown.
        let str_reg: i32 = emit_expr(s, arg)
        let result: i32 = next_reg(s)
        format_into(s, "  ; print() with non-literal - strlen unknown\n  %.{result} = add i64 0, 0\n")
        return Some(result)
    let zero: i32 = next_reg(s)
    format_into(s, "  %.{zero} = add i64 0, 0\n")
    return Some(zero)

# The built-in calls checked before user fns (variant ctors, print, write,
# format_into, sizeof, __builtin_alloca, intrinsics, memory builtins): its
# result when `e` is one.
fn try_emit_call_builtin(s: *EmitterState, e: *Expr) -> Option<i32>
    let name: StrView = call_func_name(e)
    # Variant constructor: Some(x) / Ok(x) / None / Err(x) -> %Result$.../
    # Option$... struct.  Handled before the generic call path so
    # match/return paths get a type-correct aggregate (ritz-task-133).
    # AGAST #2453: a user enum declaring `Ok` / `Some` (or `Err` / `None`)
    # builds its own variant unless an Option / Result slot names the builtin.
    if users_variant_wins(s, e)
        return Some(try_emit_user_variant_ctor(s, e))
    if is_variant_carrier(name) == 1
        # Ok / Some = tag 0
        return Some(emit_variant_struct(s, 0, e))
    if is_variant_null(name) == 1
        # Err = tag 1 (None is the no-arg case, handled in emit_expr_ident)
        return Some(emit_variant_struct(s, 1, e))
    # User-enum payload variant `Holds(x)` (AGAST #1797).  Before the
    # generic call path, as ritz0 checks variant_to_enum before functions.
    let user_ctor: i32 = try_emit_user_variant_ctor(s, e)
    if user_ctor != 0
        return Some(user_ctor)
    # write(w, "...{x}...") / writeln: Display through the Writer the
    # program named, not an implicit one (AGAST #4381, ritz0's #202). Only
    # an interpolated literal is lowered here; a plain one is the ordinary
    # StrView call. Checked before user fns, like print.
    let is_writeln: bool = name_eq(name, "writeln") == 1
    if is_writeln or name_eq(name, "write") == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            let wlit: *Expr = e.args.next
            if wlit.kind == ExprKind.StringLit and interp_lit_has_placeholder(wlit) == 1
                return Some(emit_write_literal(s, wlit, e.args, is_writeln))

    # format_into(sink, "...") -- print's literal, appended to a buffer
    # through sink.push_bytes (AGAST #1824). emitter_print.ritz has it.
    if name_eq(name, "format_into") == 1
        return Some(emit_format_into(s, e))
    match try_emit_print_call(s, e)
        Some(printed) => return Some(printed)
        None => pass

    if name_eq(name, "sizeof") == 1
        # sizeof(T) / sizeof(expr) -> compile-time constant; the operand is
        # not evaluated (AGAST #2124, see sizeof_call_value).
        let type_size: i64 = sizeof_call_value(s, e)
        let result: i32 = next_reg(s)
        format_into(s, "  %.{result} = add i64 0, {type_size}\n")
        return Some(result)

    if name_eq(name, "__builtin_alloca") == 1
        return Some(emit_builtin_alloca(s, e))

    let intrinsic: *CallIntrinsic = call_intrinsic_named(name)
    if intrinsic != null
        return Some(emit_call_intrinsic(s, e, intrinsic))
    # AGAST #1879: volatile / atomic memory builtins.  Reserved names, as in
    # ritz0: checked before user fns, so they never become an extern.
    let mem_id: i32 = mem_builtin_id(name)
    if mem_id != 0
        return Some(emit_mem_builtin(s, e, mem_id))
    None

# __builtin_alloca(size) -> `alloca i8, i64 size`, as the i64 pointer value;
# with no argument, one entry-block byte.
fn emit_builtin_alloca(s: *EmitterState, e: *Expr) -> i32
    let arg: *Expr = e.args
    if arg != null
        let size_reg: i32 = emit_expr(s, arg)
        let alloca_reg: i32 = next_reg(s)
        format_into(s, "  %.{alloca_reg} = alloca i8, i64 %.{size_reg}\n")
        return ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, alloca_reg)
    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg(s, alloca_reg, "i8")
    ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, alloca_reg)

# What emit_expr_call learned about a call through a value: the local slot
# holding the fn pointer (-1: none), its signature, and a nameless callee's
# evaluated address (-1: none).
struct CallCallee
    icall_local: i32
    icall_sig: *FnDef
    callee_val: i32

# Each argument of `e` evaluated, left to right, into `args`; their count.
fn emit_untyped_call_args(s: *EmitterState, e: *Expr, args: *i32) -> i32
    var argc: i32 = 0
    var arg: *Expr = e.args
    while arg != null
        args[argc] = emit_expr(s, arg)
        argc += 1
        arg = arg.next
    argc

# `%.{result} = call i64 %.{fp}(i64 %.a, ...)`: a call through a fn pointer
# whose signature is unknown, so every argument and the result are i64s.
fn emit_untyped_icall(s: *EmitterState, result: i32, fp: i32, args: *i32, argc: i32)
    format_into(s, "  %.{result} = call i64 %.{fp}(")
    for j in 0..argc
        if j > 0
            format_into(s, ", ")
        let a: i32 = args[j]
        format_into(s, "i64 %.{a}")
    format_into(s, ")\n")

# A call of a fn-pointer local or of a nameless callee: fills `c`; its result
# when the untyped `call i64` path lowered it whole.
fn try_emit_indirect_call(s: *EmitterState, e: *Expr, c: *CallCallee) -> Option<i32>
    # Indirect call via local fn-ptr.  When `e.func_name` matches a
    # local variable (e.g. `let h: fn(*Task) -> i32 = task.handler`),
    # the call must load the function pointer from the slot and use
    # `call ... %ptr(...)` rather than `call ... @h(...)`.  Without
    # this, the linker fails with "undefined reference to `h`" because
    # we mistakenly registered the symbol as an extern.  Common in
    # ritzlib's async/tasks (`run_tasks`, `task_server_poll_tasks`,
    # `task_server_run_multishot`) and valet's connection dispatcher.
    #
    # AGAST #1671: when the local's declared type is a `fn(...) -> T` whose
    # signature the parser kept (params and typed `let`s), fall through to
    # the direct-call path below with that signature standing in for the
    # callee's FnDef: args convert to the real param types and the result
    # is read at the real return width (`call i1 %f(i8 ...)`, then zext).
    # The untyped `call i64 %f(i64 ...)` below remains only for locals
    # whose type is unknown (e.g. inferred `let h = task.handler`).
    let name: StrView = call_func_name(e)
    c.icall_local = find_local(s, name)
    c.icall_sig = null
    c.callee_val = -1
    if c.icall_local >= 0 and e.call_type_suffix.len == 0
        let lv: *LocalVar = find_local_struct_name(s, name)
        # AGAST #2407: a local named like a fn is the local, so a call of one
        # that holds no fn value is an error, not a call of the fn or a jump
        # to the value.
        if lv != null and lv_fn_sig(lv) == null and lv.not_fn == 1
            binder_call_refuse(fn_source_file(emitter_current_fn()), e.span.line, e.span.col, name)
            format_into(s, "  ; ERROR: a call of a local that holds no fn\n")
            s.diag.error_count = s.diag.error_count + 1
            return Some(0)
        if lv != null
            c.icall_sig = lv_fn_sig(lv)
        if fn_is_procedure(c.icall_sig) == 1   # AGAST #2260: a fn pointer
            reject_procedure_value(s, e, name)
    # AGAST #2255, #2246: a local of this name is a fn pointer, not the procedure.
    if c.icall_local < 0 and e.func_name.len > 0
        note_callee(s, e, find_call_fn(s, e), name)
    # AGAST #1747: a nameless call (`fs[i](..)`): the callee is an expression
    # in `left`, evaluated first (left to right), to an i64 address.  With a
    # known signature it takes the typed path below, as a typed fn-ptr local
    # does; otherwise it is the untyped `call i64` an untyped local gets.
    if e.func_name.len == 0
        c.icall_sig = call_callee_sig(s, e)
        if fn_is_procedure(c.icall_sig) == 1   # AGAST #2260
            reject_procedure_value(s, e, no_name())
        c.callee_val = emit_expr(s, e.left)
        if c.icall_sig == null
            let ut_args: *i32 = call_reg_slots(e.args, 0)
            let ut_argc: i32 = emit_untyped_call_args(s, e, ut_args)
            let ut_fp: i32 = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, c.callee_val)
            let ut_result: i32 = next_reg(s)
            emit_untyped_icall(s, ut_result, ut_fp, ut_args, ut_argc)
            return Some(ut_result)
    if c.icall_local >= 0 and e.call_type_suffix.len == 0 and c.icall_sig == null
        # Evaluate args first, then load the fn pointer from its slot.  The
        # local's type is unknown, so the call is the i64 value model's.
        let icall_args: *i32 = call_reg_slots(e.args, 0)
        let icall_argc: i32 = emit_untyped_call_args(s, e, icall_args)
        let icall_fp: i32 = next_reg(s)
        emit_load_into(s, "ptr", icall_fp, c.icall_local)
        let icall_result: i32 = next_reg(s)
        emit_untyped_icall(s, icall_result, icall_fp, icall_args, icall_argc)
        return Some(icall_result)
    None

# `%.{dst} = trunc i64 %.{src} to i{bits}`: an i64 value narrowed to a param's
# width.
fn emit_trunc_i64(s: *EmitterState, src: i32, bits: i32) -> i32
    let dst: i32 = next_reg(s)
    format_into(s, "  %.{dst} = trunc i64 %.{src} to i{bits}\n")
    dst

# The width a post-monomorph primitive param name (`u16` left as a struct
# name) is passed at, or 0 when it is passed as the i64 it is (bool, usize,
# isize, u64, i64, f32, f64).
fn primitive_param_trunc_bits(name: StrView) -> i32
    if name_eq(name, "u8") == 1 or name_eq(name, "i8") == 1
        return 8
    if name_eq(name, "u16") == 1 or name_eq(name, "i16") == 1
        return 16
    if name_eq(name, "u32") == 1 or name_eq(name, "i32") == 1
        return 32
    0

# A float arg into a float param: passed as is when the widths agree, else
# fptrunc'd / fpext'd; an integer source is converted exactly (#2945).
fn call_convert_float_arg(s: *EmitterState, arg: *Expr, reg: i32, param_type: TypeKind) -> i32
    # The arg expression's type picks the path (default lit-int → i64 →
    # sitofp).
    var src_ty: TypeKind = TypeKind.I64
    if arg != null
        src_ty = float_arg_src_type(s, arg, param_type)
    if src_ty == param_type
        return reg
    if src_ty == TypeKind.F64 and param_type == TypeKind.F32
        let trunc: i32 = next_reg(s)
        format_into(s, "  %.{trunc} = fptrunc double %.{reg} to float\n")
        return trunc
    if src_ty == TypeKind.F32 and param_type == TypeKind.F64
        let ext: i32 = next_reg(s)
        format_into(s, "  %.{ext} = fpext float %.{reg} to double\n")
        return ext
    # Integer source: exact only, by its signedness (#2945).
    emit_int_into_float_slot(s, reg, float_slot_unsigned(arg), param_type)

# A typed param's arg, by the param's value type: bool, float or a by-value aggregate.
fn call_convert_value_arg(s: *EmitterState, e: *Expr, j: i32, param_ptr: *Param, arg_regs: *i32, converted_regs: *i32)
    let arg_expr: *Expr = nth_arg(e.args, j)
    let reg: i32 = arg_regs[j]
    let type_name: StrView = param_ptr.param_type_name
    match param_ptr.param_type
        TypeKind.Bool =>
            # Callee expects i1; every bool value is an i64 register
            # (AGAST #1646, a bool global's load too since #3001), so
            # trunc.  `takes(yes())` passed the zext'd i64 as is (#1646).
            converted_regs[j] = emit_trunc_i64(s, reg, 1)
        TypeKind.F32 | TypeKind.F64 =>
            converted_regs[j] = call_convert_float_arg(s, arg_expr, reg, param_ptr.param_type)
        _ =>
            if is_span_param(param_ptr)
                converted_regs[j] = span_param_arg(s, arg_expr, param_ptr, reg)
            else if param_ptr.param_type != TypeKind.Struct or type_name.len == 0
                converted_regs[j] = reg
            else if name_eq(type_name, "StrView") == 1
                # A string literal is rebuilt as the StrView the param wants.
                let sv_lit: i32 = emit_strview_from_lit(s, arg_expr, reg)
                converted_regs[j] = if sv_lit >= 0 then sv_lit else reg
            else if type_name.len != 7 and arg_expr != null and arg_expr.kind == ExprKind.Unary and (arg_expr.op == OpKind.Addr or arg_expr.op == OpKind.AddrMut)
                # Final fallback for a by-value struct param not matched by any
                # specialised branch.  ptr_value_ coercion regression:
                # `sum_point(@p)` where p: PointI and the callee takes PointI
                # by value.  emit_expr(@p) emitted i64 (ptrtoint of the
                # alloca); we need the %PointI value: inttoptr + load.
                let fb_pp: i32 = next_reg(s)
                format_into(s, "  %.{fb_pp} = inttoptr i64 %.{reg} to ptr\n")
                let fb_v: i32 = next_reg(s)
                let ty_ir: String = ir_name(type_name)
                format_into(s, "  %.{fb_v} = load %{ty_ir.as_view()}, ptr %.{fb_pp}\n")
                converted_regs[j] = fb_v
            else
                converted_regs[j] = reg

# AGAST #113 — auto-borrow: an `@Struct` param (i64 at the call site) of a
# struct-valued actual.  -1 when the actual needs no borrow.
fn call_ref_struct_arg(s: *EmitterState, ref_arg: *Expr, param_ptr: *Param, reg: i32) -> i32
    if ref_arg == null
        return -1
    if ref_arg.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, ref_arg.ident)
        if loc != null and lv_var_type(loc) == TypeKind.MutRef
            # AGAST #187 — narrow TypeKind.MutRef → TypeKind.Ref coercion.
            # Caller has `@&T` (lowered as `ptr`); callee expects `@T`
            # (lowered as `i64`).  `reg` is a freshly-loaded `ptr` from the
            # caller's MUT_REF slot; a `ptrtoint` makes the call-site i64
            # signature match.  Repro: tome.ritz:3327
            # `pubsub_unsubscribe(ps: @&PubSub)` calling
            # `pubsub_find_channel(ps: @PubSub, …)`.
            #
            # Narrow scoping: only when the actual arg is an ExprKind.Ident
            # whose local has var_type == TypeKind.MutRef.  An earlier
            # broader attempt (#184 reverted) regressed
            # test_issue_strview_as_bytes by hitting StrView struct args.
            let pti_mr: i32 = next_reg(s)
            format_into(s, "  %.{pti_mr} = ptrtoint ptr %.{reg} to i64  ; #187 @&T->@T\n")
            return pti_mr
        if loc != null and lv_var_type(loc) == TypeKind.Struct
            # The local slot's address as i64 (the load emit_expr made is
            # left orphaned — harmless).
            let pti_r: i32 = next_reg(s)
            let slot: i32 = loc.reg
            format_into(s, "  %.{pti_r} = ptrtoint ptr %.{slot} to i64\n")
            return pti_r
    # Rvalue auto-borrow: `f(call_returning_struct())` where f wants
    # @Struct.  `reg` holds the %Struct value the call returned: spill it
    # to a stack slot and pass the slot's address as i64.  Without this,
    # the struct-typed reg gets cast to i64 implicitly (clang rejects).
    if (ref_arg.kind == ExprKind.Method or ref_arg.kind == ExprKind.Call) and not call_returns_address(s, ref_arg)
        let type_name: StrView = param_ptr.param_type_name
        let spill: i32 = next_reg(s)
        entry_alloca_reg_begin_named(s, spill)
        let ty_ir: String = ir_name(type_name)
        format_into(s, "{ty_ir.as_view()}  ; rvalue auto-borrow\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, type_name, reg, spill)
        return ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, spill)
    -1

# Arg j into the typed param `param_ptr`'s representation, in converted_regs[j].
fn call_convert_param_arg(s: *EmitterState, e: *Expr, j: i32, param_ptr: *Param, arg_regs: *i32, converted_regs: *i32, param_types: *TypeKind)
    param_types[j] = param_ptr.param_type
    let arg_expr: *Expr = nth_arg(e.args, j)
    let reg: i32 = arg_regs[j]
    let pt: TypeKind = param_ptr.param_type
    let type_name: StrView = param_ptr.param_type_name
    if param_uses_byval(s, param_ptr) == 1
        # AGAST #1739 — already the byval slot (emit_call_arg).
        converted_regs[j] = reg
        return
    # AGAST #176: Span$u8 / StrView -> i64 coercion for legacy *u8
    # (TypeKind.Ptr / TypeKind.Ref / TypeKind.I64) params.  Bare "..." lowers to
    # %Span$u8 (#98); without this coercion `takes_cstr("...")`
    # emits `call void @takes_cstr(i64 %.span)` and the IR verifier
    # rejects the aggregate-into-i64 mismatch.  helper returns the
    # coerced i64 reg or -1 (fall through to the regular cascade).
    # Also subsumes the narrower string-literal coercion ritz-task-172
    # added for cryptosec's hkdf_expand_label("key", …) call site.
    let s176_reg: i32 = try_emit_span_to_i64_arg(s, arg_expr, pt, reg)
    if s176_reg >= 0
        converted_regs[j] = s176_reg
        return
    # Truncate i64 values to smaller types if needed
    let bits: i32 = ty_int_bits(pt)
    if bits == 8 or bits == 16 or bits == 32
        converted_regs[j] = emit_trunc_i64(s, reg, bits)
    else if pt == TypeKind.Struct and type_name.len > 0 and is_primitive_type_name(type_name) == 1
        # Post-monomorph primitive param (vec_push_u16_method parity):
        # `T` substituted with u16/i32/etc. but left TypeKind.Struct in AST.
        # emit_llvm_type_struct maps the name back for signatures;
        # match by truncating i64 arg down to primitive width.
        let pbits: i32 = primitive_param_trunc_bits(type_name)
        converted_regs[j] = if pbits > 0 then emit_trunc_i64(s, reg, pbits) else reg
    else if (pt == TypeKind.Ptr or pt == TypeKind.PtrPtr) and expr_is_ptr_valued(s, arg_expr) == 1
        # AGAST #1644: `*T` params are i64 in ritz1's value model,
        # but `@&v` and a TypeKind.MutRef ident are `ptr`.
        let ptr_arg: i32 = next_reg(s)
        format_into(s, "  %.{ptr_arg} = ptrtoint ptr %.{reg} to i64  ; #1644 @&T->*T\n")
        converted_regs[j] = ptr_arg
    else if pt == TypeKind.Ref and expr_is_ptr_valued(s, arg_expr) == 1
        # AGAST #2416: an `@T` param is i64 too, so `rd(@&c)` (a `ptr`)
        # needs the same ptrtoint, for a struct of any size or a scalar.
        converted_regs[j] = ptr_value_to_i64(s, arg_expr, reg)
    else if pt == TypeKind.MutRef
        # TypeKind.MutRef params expect ptr.  An `@&T` ident, `@&v` or
        # `v as @&T` is already `ptr`; anything else -- `@v`, a `*T`
        # value, and (AGAST #1757) a `-> @&T` call result, which
        # get_expr_type calls TypeKind.MutRef but is i64 -- is inttoptr'd.
        converted_regs[j] = i64_value_to_ptr(s, arg_expr, reg)
    else if pt == TypeKind.Ref and type_name.len > 0
        let borrowed: i32 = call_ref_struct_arg(s, arg_expr, param_ptr, reg)
        converted_regs[j] = if borrowed >= 0 then borrowed else reg
    else
        call_convert_value_arg(s, e, j, param_ptr, arg_regs, converted_regs)

# Convert each evaluated arg to its param's type before the call (the i64 value
# model to the callee's ABI); an unknown callee takes i64s.
fn call_convert_args(s: *EmitterState, e: *Expr, fn_def: *FnDef, arg_regs: *i32, arg_count: i32, converted_regs: *i32, param_types: *TypeKind)
    var param_ptr: *Param = null
    if fn_def != null
        param_ptr = fn_def.params
    for j in 0..arg_count
        if param_ptr != null
            call_convert_param_arg(s, e, j, param_ptr, arg_regs, converted_regs, param_types)
            param_ptr = param_ptr.next
        else
            # fn_def is null - external function, assume i64 for all args
            # But a `ptr`-valued argument (`@&v`, an `@&T` local) needs a
            # ptrtoint; a `-> @&T` call result is already i64 (AGAST #1758).
            param_types[j] = TypeKind.I64
            let arg_expr: *Expr = nth_arg(e.args, j)
            # AGAST #176: Span$u8 / StrView -> i64 coercion (extern path).
            # When fn_def is missing we assume `i64` per arg; a %Span$u8
            # aggregate would otherwise flow through unchanged and fail IR
            # verification at the callsite.  The helper handles the resolve
            # + extractvalue + ptrtoint and returns -1 on no-match.
            let s176_ext_reg: i32 = try_emit_span_to_i64_arg(s, arg_expr, TypeKind.I64, arg_regs[j])
            if s176_ext_reg >= 0
                converted_regs[j] = s176_ext_reg
            else
                converted_regs[j] = ptr_value_to_i64(s, arg_expr, arg_regs[j])

pub fn emit_expr_call(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    match try_emit_call_builtin(s, e)
        Some(builtin) => return builtin
        None => pass

    var cc: CallCallee = CallCallee { icall_local: 0 - 1, icall_sig: null, callee_val: 0 - 1 }
    match try_emit_indirect_call(s, e, @cc)
        Some(indirect) => return indirect
        None => pass
    let icall_local: i32 = cc.icall_local
    let icall_sig: *FnDef = cc.icall_sig
    let callee_val: i32 = cc.callee_val

    # Regular function call - register as external if not defined in this module
    # The full function name carries the type suffix (e.g., "vec_new$u8" for
    # vec_new<u8>()), sized from name+suffix: a fixed [128]u8 was overrun by a
    # long name (AGAST #1813).
    var full: String = string_with_cap(((e.func_name.len as i32) + (e.call_type_suffix.len as i32) + 1) as i64)
    full.push_span(Span<u8> { ptr: e.func_name.ptr, len: e.func_name.len })
    if e.call_type_suffix.len > 0
        full.push_span(Span<u8> { ptr: e.call_type_suffix.ptr, len: e.call_type_suffix.len })
    let full_name: StrView = full.as_view()
    # Look up the callee first: its params give each argument its enum
    # context (AGAST #1498), and its return type is needed below.  A typed
    # indirect call (AGAST #1671) uses the fn type's signature instead and
    # names no symbol, so it registers no extern.
    var fn_def: *FnDef = icall_sig
    # AGAST #4356: true when fn_def came from the impl table, never mangled.
    var fn_from_impl: bool = false
    # AGAST #3690: a byval past 4 GiB is a clang verifier abort, unlocated.
    if icall_sig != null and refuse_huge_fn_type_byval(s, icall_sig) == 1
        return 0
    if icall_sig == null
        add_extern(s, full_name)
        fn_def = find_fn(s, full_name)
        # R10: `C_g(c)` is the method `c.g()` calls; impl methods aren't in
        # fn_map, so without this the call took the untyped i64 fallback and
        # clang refused it, unlocated (AGAST #2447).
        if fn_def == null
            fn_def = find_impl_method_by_symbol(s.sym.module, full_name)
            fn_from_impl = true
        # AGAST #3255, #3667: Sema's call_check refused a call no fn answers
        # (AGAST #3503), so one reaching here is a Sema / emitter split.
        if fn_def == null
            var msg: String = string_new()
            format_into(@&msg, "a call Sema passed names no fn: '{full_name}'")
            emit_ir_error_sv(s, e.span, msg.as_view())
            return 0
        fn_def = lent_self_call_view(s, fn_def)
    # AGAST #4356: a private free fn's symbol carries its defining file, so
    # an instance emitted in this object resolves its module's definition.
    # Not a method (twins may not share `T_m`, type_twins.ritz; its define
    # keeps the plain name).
    var callee_sym: StrView = full_name
    if not fn_from_impl and fn_private_free(fn_def) == 1
        callee_sym = fn_symbol(fn_def)
    # AGAST #1629: Sema's call_check has judged the argument count and each
    # argument's kind (AGAST #3503).

    # Sized from the argument list (AGAST #1813): a fixed [16] dropped every
    # argument past the 16th.
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg2: *Expr = e.args
    var ap: *Param = null
    if fn_def != null
        ap = fn_def.params
    while arg2 != null
        arg_regs[arg_count] = emit_call_arg(s, arg2, ap)
        arg_count += 1
        if ap != null
            ap = ap.next
        arg2 = arg2.next

    # fn_def is a direct callee or the signature of a fn value.
    if refuse_array_return(s, e, fn_def)
        return 0
    var ret_type: TypeKind = TypeKind.I64  # Default for unknown functions
    var ret_struct: StrView = no_name()
    if fn_def != null
        ret_type = fn_def.return_type
        if fn_def.return_type == TypeKind.Struct
            ret_struct = fn_def.return_type_name

    # Convert argument values to match parameter types BEFORE emitting call
    let converted_regs: *i32 = call_reg_slots(e.args, 0)
    let param_types: *TypeKind = call_reg_slots(e.args, 0) as *TypeKind
    call_convert_args(s, e, fn_def, arg_regs, arg_count, converted_regs, param_types)
    # AGAST #4853: a callee declared by its typed prototype takes `ptr` for
    # each pointer param, and gives a `ptr` result back as the i64 it is here.
    let typed: bool = icall_sig == null and typed_proto_callee(s, fn_def, fn_from_impl)
    if typed
        var tp: *Param = fn_def.params
        for j in 0..arg_count
            if ty_is_ptr(tp.param_type) == 1
                converted_regs[j] = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, converted_regs[j])
            tp = tp.next

    # Now emit the call with converted registers.  A typed indirect call
    # loads the fn pointer from its slot here, after the args.
    var icall_fp_reg: i32 = -1
    if callee_val >= 0
        icall_fp_reg = next_reg(s)
        format_into(s, "  %.{icall_fp_reg} = inttoptr i64 %.{callee_val} to ptr\n")
    else if icall_sig != null
        icall_fp_reg = next_reg(s)
        emit_load_into(s, "ptr", icall_fp_reg, icall_local)
    var call_result: i32 = 0
    # AGAST #1730 — a large struct comes back through a caller-owned slot
    # (also for typed indirect calls: the pointee was defined the same way).
    var call_sret: i32 = 0
    # [[callconv = "win64"]] on the callee, or on the fn type of a typed
    # indirect call (fn_def is then its signature) -- AGAST #1879.
    let call_cc: *u8 = fn_callconv_kw(s.sym.mono.pctx, fn_def)
    if struct_ret_uses_sret(s, ret_type, ret_struct) == 1
        call_sret = emit_sret_call_slot(s, ret_struct)
    call_sret = emit_call_sret_array_slot(s, fn_def, call_sret)   # AGAST #3181
    if call_sret > 0 or ret_type == TypeKind.Void
        # An sret call's value is the slot; a void call has none.
        if call_sret > 0
            call_result = next_reg(s)
        format_into(s, "  call {llvm_text(call_cc)}void ")
    else
        call_result = next_reg(s)
        format_into(s, "  %.{call_result}")
        if typed and ty_is_ptr(ret_type) == 1
            format_into(s, " = call {llvm_text(call_cc)}ptr ")
        else
            emit_call_ret_kw(s, fn_def, ret_type, ret_struct, llvm_text(call_cc))
    if icall_fp_reg >= 0
        format_into(s, "%.{icall_fp_reg}(")
    else
        let sym_ir: String = ir_name(callee_sym)
        format_into(s, "@{sym_ir.as_view()}(")
    if call_sret > 0
        emit_call_sret_attr(s, fn_def, ret_struct)
        format_into(s, "%.{call_sret}")

    # Each converted arg after its param's LLVM type (AGAST #1739); an arg
    # past the params, or of an unknown callee, is an i64.
    var p: *Param = null
    if fn_def != null
        p = fn_def.params
    for j in 0..arg_count
        if j > 0 or call_sret > 0
            format_into(s, ", ")
        if p != null and typed
            format_into(s, "{typed_proto_kind(p.param_type)}")
            p = p.next
        else if p != null
            emit_param_llvm_type(s, p)
            p = p.next
        else
            format_into(s, "i64")
        let arg_reg: i32 = converted_regs[j]
        format_into(s, " %.{arg_reg}")

    format_into(s, ")\n")
    if typed and ty_is_ptr(ret_type) == 1
        call_result = ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, call_result)
    if call_sret > 0
        call_result = emit_call_sret_result(s, fn_def, call_result, call_sret, ret_struct)

    return widen_call_result(s, ret_type, ret_struct, call_result)

# Which tagged-enum unwrap a method name asks for.
enum UnwrapKind
    NotUnwrap
    Unwrap      # `.unwrap()`: traps on None / Err
    UnwrapOr    # `.unwrap_or(d)`: d on None / Err

fn unwrap_kind_named(method: StrView) -> UnwrapKind
    if name_eq(method, "unwrap") == 1
        return UnwrapKind.Unwrap
    if name_eq(method, "unwrap_or") == 1
        return UnwrapKind.UnwrapOr
    UnwrapKind.NotUnwrap

# Option<T>.unwrap / .unwrap_or and Result<T,E>.unwrap / .unwrap_or — inline
# intrinsic matching the tag-encoded i64 representation that ritz1 uses for
# tagged enums (see emitter_match.ritz and is_variant_carrier in this file):
#   tag==1 payload   → Some(x) / Ok(x)  : (1 << 48) | (x & 0xFFFFFFFFFFFF)
#   tag==0 payload   → None / Err(x)    : (x & 0xFFFFFFFFFFFF)
#
# This mirrors ritz0's `_try_emit_enum_unwrap_method` (emitter_llvmlite.py
# ~line 7808) but works directly against the packed i64 rather than an
# { i8 tag, ... } struct.
#
# recv_value_reg: if non-negative, an i64 register already holding the
#   enum value (set by emit_expr_method when the receiver is a call
#   result). If -1, load from the stack slot `receiver_reg`.
# Returns an i64 register with the payload on success, -1 if this helper
# doesn't apply. (ritz-task-106)
fn try_emit_enum_unwrap(s: *EmitterState, e: *Expr, type_name: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: bool, recv_value_reg: i32) -> i32
    # Type must be Option$... or Result$...
    if not type_name.starts_with("Option$") and not type_name.starts_with("Result$")
        return -1

    # Method must be "unwrap" (0 args) or "unwrap_or" (1 arg).
    let kind: UnwrapKind = unwrap_kind_named(e.ident)
    let is_unwrap: bool = kind == UnwrapKind.Unwrap
    match kind
        UnwrapKind.NotUnwrap =>
            return -1
        UnwrapKind.Unwrap =>
            if e.args != null
                return -1
        UnwrapKind.UnwrapOr =>
            if e.args == null
                return -1

    # Materialise the receiver into a stack slot we can GEP against.  The
    # struct has shape `{ i8 tag, [N x i8] payload }` (ritz-task-133).
    #
    # Three receiver forms feed this helper:
    #   recv_value_reg >= 0          — aggregate value already in a register
    #                                  (ExprKind.Call / ExprKind.Method chain).
    #   receiver_reg, not recv_is_ptr_of_ptr — ident holding the struct
    #                                  directly in its slot.
    #   receiver_reg, recv_is_ptr_of_ptr —     ident holding a pointer to
    #                                  the struct (rare in practice).
    var scrut_slot: i32 = receiver_reg
    if recv_value_reg >= 0
        scrut_slot = next_reg(s)
        entry_alloca_reg_begin_named(s, scrut_slot)
        let ty_ir: String = ir_name(type_name)
        format_into(s, "{ty_ir.as_view()}  ; unwrap scrut spill\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, type_name, recv_value_reg, scrut_slot)
    else if recv_is_ptr_of_ptr
        scrut_slot = next_reg(s)
        emit_load_into(s, "ptr", scrut_slot, receiver_reg)

    # tag = load i8 from field 0
    let tag_ptr: i32 = next_reg(s)
    gep_struct_open(s, tag_ptr, type_name)
    format_into(s, ", ptr %.{scrut_slot}, i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_load_into(s, "i8", tag_reg, tag_ptr)

    # AGAST #4603: unwrap() of a None / Err traps, as ritz0's does: the tag
    # check branches to `llvm.trap` (SIGILL), and the payload is read only
    # on the Some / Ok path.  It loaded the payload unchecked, so a None
    # unwrapped to 0 and the program carried on.
    if is_unwrap
        emit_unwrap_tag_trap(s, tag_reg)

    # payload = the Ok / Some payload at field 2 (AGAST #1898), loaded at its
    # own width and widened to i64 because ritz1's call/arith paths expect
    # i64-width scalars; aggregate unwrap returns would need a more careful
    # type-oracle pass — deferred.
    let pay_ptr: i32 = next_reg(s)
    gep_struct_open(s, pay_ptr, type_name)
    format_into(s, ", ptr %.{scrut_slot}, i32 0, i32 2\n")
    # AGAST #2594: a struct payload (`Option<P>`) loads as its `%P`, as `?`
    # does (emit_try's aggregate arm); an i64 load gave clang `store %P <i64>`.
    # AGAST #3250 / #2863: `unwrap_or(d)` selects between that `%P` and the
    # default's `%P`; it selected i64s, so a struct (`Vec$E`) default was an
    # aggregate where clang wanted an i64.
    # AGAST #3620: a user-enum payload (`Option<HotkeyAction>`) is its `%E`
    # aggregate as well, as `Some(x)` builds it (#2100): an i64 load gave
    # `match o.unwrap()` clang's `store %E <i64>` (prism's test_input).
    let pay_name: StrView = tagged_enum_payload_named(s, type_name, 1)
    if pay_name.ptr != null
        return emit_unwrap_struct_payload(s, e, is_unwrap, pay_name, pay_ptr, tag_reg)
    let payload: i32 = emit_tagged_payload_load(s, pay_ptr, type_name, 0)

    if is_unwrap
        # unwrap(): the tag check above already trapped on None / Err.
        return payload

    # unwrap_or(default): select payload when tag==0, else default.
    let tag_ok: i32 = next_reg(s)
    format_into(s, "  %.{tag_ok} = icmp eq i8 %.{tag_reg}, 0  ; unwrap_or tag check (Ok/Some == 0)\n")

    # AGAST #4679: a `"q"` default of a `*u8` payload is its bytes, as in any
    # `*u8` slot (literal_slot.ritz's lit_into_ptr): Sema never types this
    # argument, so it stayed a `%Span$u8` in an i64 select.
    let arg: StrView = tagged_enum_arg(s, type_name, 0)
    if e.args.kind == ExprKind.StringLit and arg.ptr != null and name_eq(arg, "ptr_u8") == 1
        e.args.kind = ExprKind.CstringLit
    let default_reg: i32 = emit_expr(s, e.args)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = select i1 %.{tag_ok}, i64 %.{payload}, i64 %.{default_reg}\n")
    return result

# The struct payload `%P` of an unwrap at `pay_ptr`: unwrap() is its load;
# unwrap_or(d) selects between it and d's `%P` by the tag.
fn emit_unwrap_struct_payload(s: *EmitterState, e: *Expr, is_unwrap: bool, pay_name: StrView, pay_ptr: i32, tag_reg: i32) -> i32
    let pay_ir: String = ir_name(pay_name)
    let pay_ty: StrView = pay_ir.as_view()
    let agg: i32 = next_reg(s)
    format_into(s, "  %.{agg} = load %{pay_ty}, ptr %.{pay_ptr}  ; unwrap struct payload\n")
    if is_unwrap
        return agg
    let ok_agg: i32 = next_reg(s)
    format_into(s, "  %.{ok_agg} = icmp eq i8 %.{tag_reg}, 0  ; unwrap_or tag check (Ok/Some == 0)\n")
    # AGAST #4679: the default is a value of the payload's type, as a
    # `let` of it is: a `"/"` is rebuilt from its `%Span$u8` into the
    # `%StrView` the select wants, and a struct element is its copy.
    let def_agg: i32 = emit_store_into_slot(s, e.args, TypeKind.Struct, pay_name)
    let sel_agg: i32 = next_reg(s)
    format_into(s, "  %.{sel_agg} = select i1 %.{ok_agg}, %{pay_ty} %.{agg}, %{pay_ty} %.{def_agg}\n")
    sel_agg

# =============================================================================
# BitOps intrinsics on integer-primitive receivers (AGAST #1506)
# =============================================================================
#
# `x.rotl(3)` on a u32, `(state[d] ^ state[a]).rotl(16)` in cryptosec's
# chacha20.  Mirrors ritz0's _try_emit_bitops_intrinsic: the six BitOps
# methods on u8..u64 / i8..i64 lower to LLVM intrinsics at the receiver's
# REAL width.  ritz1 carries every integer in an i64 register, so the value
# is truncated to iN, the intrinsic runs at iN, and the result is extended
# back to i64 (sign-extended for a signed Self, zero-extended otherwise) —
# the same "consumers see i64" contract the Type_method fallback honours.
# A rotate done at i64 instead would be silently wrong (0x80000001 rotl 1
# is 3 at 32 bits, 0x100000002 at 64).

# Lower `recv.<bitop>(args)` when the receiver is an integer primitive.
# recv_value_reg >= 0 means the receiver was already evaluated (call and
# method-chain receivers) and must not be evaluated again.  Returns -1 when
# this is not a BitOps call on an integer, leaving the caller's path intact.
fn try_emit_int_bitops(s: *EmitterState, e: *Expr, recv_value_reg: i32) -> i32
    let mid: i32 = bitops_method_id(e.ident)
    if mid < 0
        return 0 - 1
    let rt: TypeKind = int_method_recv_type(s, e.left)
    let bits: i32 = ty_int_bits(rt)
    if bits == 0
        return 0 - 1
    var nargs: i32 = 0
    var a: *Expr = e.args
    while a != null
        nargs = nargs + 1
        a = a.next
    # rotl / rotr take the shift amount; the others take nothing.
    let rotate: bool = mid <= 1
    let want_args: i32 = rotate as i32
    if nargs != want_args
        # ritz0's words (AGAST #4665): emitter/intrinsics.py.
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprint_bytes(e.ident)
        if rotate
            eprints("() requires exactly 1 argument\n")
        else
            eprints("() takes no arguments\n")
        let bad: i32 = next_reg(s)
        format_into(s, "  %.{bad} = add i64 0, 0\n")
        return bad

    var recv: i32 = recv_value_reg
    if recv < 0
        recv = emit_expr(s, e.left)
    # swap_bytes on a byte is the identity (llvm.bswap has no i8 form).
    if mid == 5 and bits == 8
        return recv

    # Narrow the i64 receiver (and shift amount) to iN.
    var nrecv: i32 = recv
    if bits < 64
        nrecv = next_reg(s)
        format_into(s, "  %.{nrecv} = trunc i64 %.{recv} to i{bits}\n")
    var namt: i32 = 0
    if rotate
        let amt: i32 = emit_expr(s, e.args)
        namt = amt
        if bits < 64
            namt = next_reg(s)
            format_into(s, "  %.{namt} = trunc i64 %.{amt} to i{bits}\n")

    var wi: i32 = 0
    if bits == 16
        wi = 1
    else if bits == 32
        wi = 2
    else if bits == 64
        wi = 3
    g_bitops_decl_mask = g_bitops_decl_mask | ((1 as i64) << ((mid * 4 + wi) as i64))

    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = call i{bits} ")
    emit_bitops_intrinsic_name(s, mid, bits)
    format_into(s, "(i{bits} %.{nrecv}")
    if rotate
        # rotl/rotr: funnel shift of x with itself by n.
        format_into(s, ", i{bits} %.{nrecv}, i{bits} %.{namt}")
    else if mid == 2 or mid == 3
        # is_zero_poison = false: a zero input yields the bit width.
        format_into(s, ", i1 false")
    format_into(s, ")\n")

    if bits == 64
        return r
    # Counts are u8 (zero-extend); Self results extend by Self's signedness.
    let widened: i32 = next_reg(s)
    let self_result: bool = rotate or mid == 5
    let extend: StrView = if self_result and ty_is_signed(rt) == 1 then "sext" else "zext"
    format_into(s, "  %.{widened} = {extend} i{bits} %.{r} to i64\n")
    widened

# =============================================================================
# Float intrinsics on f32/f64 receivers (AGAST #1370)
# =============================================================================
#
# `x.ceil()`, `(x + 0.25).floor()`, `p.y.round()`, `n.abs()`.  Mirrors ritz0's
# _try_emit_float_intrinsic exactly:
#
#   abs   -> llvm.fabs.{f32,f64}  (an and-mask, never a libcall)
#   floor -> t = sitofp(fptosi x to i64); t > x ? t - 1 : t
#   ceil  -> t = sitofp(fptosi x to i64); t < x ? t + 1 : t
#   round -> trunc(x < 0 ? x - 0.5 : x + 0.5)      (half away from zero)
#
# floor/ceil/round are inline because llvm.floor & co. lower to libm
# libcalls on baseline x86-64 and ritz links no libc (AGAST #1321).  Valid
# for |x| < 2^63, as in ritz0.  Unlike the integer BitOps path the value
# stays in its `float` / `double` register: that is ritz1's float model.
#
# Primitive-receiver dispatch: emit_expr_method asks this before resolving
# a struct receiver (whose call / chain paths spill the value as i64, which a
# float is not); integer BitOps (try_emit_int_bitops, #1506) runs at the
# unresolved-receiver fallback.

# `%r = <op> T %a, <k>`: a float op against a constant.
fn float_op_const(s: *EmitterState, op: StrView, ft: TypeKind, a: i32, k: StrView) -> i32
    let r: i32 = next_reg(s)
    let fty: StrView = float_llvm_name(ft)
    format_into(s, "  %.{r} = {op} {fty} %.{a}, {k}\n")
    r

# `%r = fcmp <pred> T %a, %b`
fn float_cmp(s: *EmitterState, pred: StrView, ft: TypeKind, a: i32, b: i32) -> i32
    let r: i32 = next_reg(s)
    let fty: StrView = float_llvm_name(ft)
    format_into(s, "  %.{r} = fcmp {pred} {fty} %.{a}, %.{b}\n")
    r

# Lower `recv.<ceil|floor|round|abs>()` when the receiver is f32/f64.
# Returns -1 when it is not, leaving emit_expr_method's paths intact; the
# receiver is not evaluated in that case.
fn try_emit_float_method(s: *EmitterState, e: *Expr) -> i32
    let ft: TypeKind = float_method_result_ty(s, e)
    if ft == TypeKind.Void
        return 0 - 1
    let mid: i32 = float_method_id(e.ident)
    # Evaluated exactly once, whatever its shape (ident, binary, call, chain).
    let x: i32 = emit_expr(s, e.left)
    let fty: StrView = float_llvm_name(ft)

    if mid == 3
        let r: i32 = next_reg(s)
        let fabs: StrView = if ft == TypeKind.F32 then "f32" else "f64"
        format_into(s, "  %.{r} = call {fty} @llvm.fabs.{fabs}({fty} %.{x})\n")
        if ft == TypeKind.F32
            g_float_decl_mask = g_float_decl_mask | 1
        else
            g_float_decl_mask = g_float_decl_mask | 2
        return r

    if mid == 1
        let t: i32 = emit_float_trunc(s, ft, x)
        let gt: i32 = float_cmp(s, "ogt", ft, t, x)
        let m1: i32 = float_op_const(s, "fsub", ft, t, "1.0")
        return emit_float_select(s, ft, gt, m1, t)
    if mid == 0
        let t: i32 = emit_float_trunc(s, ft, x)
        let lt: i32 = float_cmp(s, "olt", ft, t, x)
        let p1: i32 = float_op_const(s, "fadd", ft, t, "1.0")
        return emit_float_select(s, ft, lt, p1, t)

    # round: half away from zero.
    let neg: i32 = next_reg(s)
    format_into(s, "  %.{neg} = fcmp olt {fty} %.{x}, 0.0\n")
    let lo: i32 = float_op_const(s, "fsub", ft, x, "0.5")
    let hi: i32 = float_op_const(s, "fadd", ft, x, "0.5")
    let adj: i32 = emit_float_select(s, ft, neg, lo, hi)
    emit_float_trunc(s, ft, adj)

# `x`, `@a` (a: [N]T) or `@v` / `@&v` (v: Vec<T>) into a `Span<T>` parameter `p`:
# build the Span from the array, or from `{ v.data, v.len }`.  `reg` is the
# argument as emit_expr left it (`@v` is the ptrtoint of v's slot); any other
# argument comes back as `reg`.  Shared by free calls and the static method
# arm, which lacked it (AGAST #3246: `R.new(@data)` passed the Vec's address).
fn span_param_arg(s: *EmitterState, arg: *Expr, p: *Param, reg: i32) -> i32
    let span_ty: StrView = p.param_type_name
    # Array-value -> Span<T> coerce: when the actual is an
    # identifier bound to a TypeKind.Array local, construct
    # Span { &arr[0], N } using the declared array type.
    # (ritz-task-102)
    if arg != null and arg.kind == ExprKind.Ident
        let arr_loc: *LocalVar = find_local_struct_name(s, arg.ident)
        if arr_loc != null and lv_var_type(arr_loc) == TypeKind.Array
            return emit_span_of_array(s, arr_loc, span_ty)
    if arg == null or arg.kind != ExprKind.Unary
        return reg
    # Port of ritz0 bedc85b: `@vec` -> Span<T> coercion at call site.
    # When the parameter is `Span<T>` and the argument is `@v` where
    # v is a Vec<T> local, materialize a Span struct from
    # { v.data, v.len } so the callee receives a proper slice view.
    if (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut) and arg.operand.kind == ExprKind.Ident
        let src_loc: *LocalVar = find_local_struct_name(s, arg.operand.ident)
        if src_loc != null
            let vec_ty: StrView = lv_name(src_loc)
            if vec_ty.len > 4 and vec_ty.starts_with("Vec$")
                # `@v` is the i64 ptrtoint of v's slot: back to a ptr.
                # AGAST #3247: `@&v` is the slot's `ptr` itself.
                var span_vec_ptr: i32 = reg
                if arg.op == OpKind.Addr
                    span_vec_ptr = next_reg(s)
                    format_into(s, "  %.{span_vec_ptr} = inttoptr i64 %.{reg} to ptr\n")
                return emit_span_of_vec_ptr(s, vec_ty, span_vec_ptr, span_ty)
    # @array_ident -> Span<T>: construct Span { &arr[0], N }.
    # (test_issue_span_slice_range: `tail_sum(@buf)` where
    # buf is [4]u8.)  The inner-ident branch above already
    # handles the bare `arr` case; this handles `@arr`
    # which is ExprKind.Unary OpKind.Addr wrapping ExprKind.Ident.
    if arg.operand.kind == ExprKind.Ident
        let arr_loc2: *LocalVar = find_local_struct_name(s, arg.operand.ident)
        if arr_loc2 != null and lv_var_type(arr_loc2) == TypeKind.Array
            span_array_elem_fits(s, arg, arr_loc2, span_ty)   # AGAST #2366
            return emit_span_of_array(s, arr_loc2, span_ty)
    # AGAST #2305: `@G`, `@h.a`, `@*p`.
    let placed: i32 = emit_span_of_addr_place(s, arg, span_ty)
    if placed != 0
        return placed
    reg

# What emit_expr_method resolved about a method call's receiver (AGAST #1818:
# the locals its receiver arms and dispatchers shared).
struct MethodRecv
    # The receiver's struct (or impl target) name; empty when unresolved.
    type_name: StrView
    receiver_reg: i32
    # True when the stack slot holds a pointer value (e.g. parameter *Vec<T>);
    # false when it holds the struct body directly (e.g. local Vec<T> binding).
    recv_is_ptr_of_ptr: bool
    # Non-negative when the receiver's i64 value has already been computed
    # in a register (ExprKind.Call / ExprKind.Method paths). -1 means "materialise
    # by loading from the stack slot". Used by tagged-enum intrinsics that
    # work against the i64 value directly rather than a ptr.
    recv_value_reg: i32
    # Pointers between what the receiver holds and its struct, for a `self: **S`
    # (AGAST #2403); -1 when the arm below didn't say.
    recv_levels: i32
    # The receiver's place: a register pointing at what it holds, so
    # `recv_levels + 1` pointers from its struct, or -1 (AGAST #3071).  A
    # `self: **S` takes it, or what it holds, at the levels `self` declares.
    recv_base: i32

# `  %.{slot} = alloca <ty>  ; <why>` in the entry block, for a register
# already taken.
fn alloca_slot(s: *EmitterState, slot: i32, ty: StrView, why: StrView)
    entry_alloca_reg_begin(s, slot)
    format_into(s, "{ty}  ; {why}\n")
    entry_alloca_reg_end(s)

# `  %.{slot} = alloca %<name>  ; <why>` in the entry block: a struct value's
# spill slot.
fn alloca_struct_slot(s: *EmitterState, slot: i32, name: StrView, why: StrView)
    entry_alloca_reg_begin_named(s, slot)
    let name_ir: String = ir_name(name)
    format_into(s, "{name_ir.as_view()}  ; {why}\n")
    entry_alloca_reg_end(s)

# `%{dst} = inttoptr i64 %{val} to ptr  ; <why>`: a returned or loaded pointer
# as the receiver's place.
fn recv_inttoptr(s: *EmitterState, val: i32, why: StrView) -> i32
    let dst: i32 = next_reg(s)
    format_into(s, "  %.{dst} = inttoptr i64 %.{val} to ptr  ; {why}\n")
    dst

# `%{dst} = getelementptr [N x %S], ptr %{base}, i64 0, i64 %{idx}`: element
# `idx` of an inline `[N]S`, as the receiver's place.
fn struct_array_elem(s: *EmitterState, base: i32, size: i32, st: StrView, idx: i32) -> i32
    let dst: i32 = next_reg(s)
    let st_ir: String = ir_name(st)
    format_into(s, "  %.{dst} = getelementptr [{size} x %{st_ir.as_view()}], ptr %.{base}, i64 0, i64 %.{idx}\n")
    dst

# Emit `Type.method(args)`'s argument registers, coerced to the params.
# No receiver: params line up from the head (AGAST #1498).
fn static_method_args(s: *EmitterState, e: *Expr, sm_method: *FnDef, sm_conv: *i32) -> i32
    let sm_arg_regs: *i32 = call_reg_slots(e.args, 0)
    var sm_arg_count: i32 = 0
    var sm_arg: *Expr = e.args
    var sm_ap: *Param = sm_method.params
    while sm_arg != null
        sm_arg_regs[sm_arg_count] = emit_call_arg(s, sm_arg, sm_ap)
        sm_arg_count = sm_arg_count + 1
        if sm_ap != null
            sm_ap = sm_ap.next
        sm_arg = sm_arg.next
    # Coerce args to formal param widths.  The static dispatch
    # has NO self/receiver, so we walk method.params from the
    # head (no skip).  Float-narrow lit→f32 via fptrunc when
    # the param type is f32 — same pattern as f32-aware var-decl
    # narrowing (commit 960a388).  Integer and bool args are
    # trunc'd to the param width like the instance arm's
    # (AGAST #1733).  Other types pass-through.
    var sm_p: *Param = sm_method.params
    var sm_arg_e: *Expr = e.args
    for k in 0..sm_arg_count
        sm_conv[k] = sm_arg_regs[k]
        if sm_p != null
            let sm_nrw: StrView = method_arg_narrow_ty(sm_p)
            let sm_sv: i32 = method_strview_arg(s, sm_p, sm_arg_e, sm_arg_regs[k])   # AGAST #3495
            if sm_sv >= 0
                sm_conv[k] = sm_sv
            else if not unnamed(sm_nrw)
                sm_conv[k] = emit_method_arg_trunc(s, sm_arg_regs[k], sm_nrw)
            else if is_span_param(sm_p)
                sm_conv[k] = span_param_arg(s, sm_arg_e, sm_p, sm_arg_regs[k])   # AGAST #3246
            else if param_takes_addr_value(s, sm_arg_e, sm_p)
                sm_conv[k] = i64_value_to_ptr(s, sm_arg_e, sm_arg_regs[k])   # AGAST #2287
            else if sm_p.param_type == TypeKind.F32 or sm_p.param_type == TypeKind.F64
                # A float literal is a double, an int one an i64
                # (AGAST #2561: `P.st(2)` passed `float %<i64>`).
                sm_conv[k] = method_float_arg(s, sm_p, sm_arg_e, sm_arg_regs[k])
            sm_p = sm_p.next
        if sm_arg_e != null
            sm_arg_e = sm_arg_e.next
    sm_arg_count

# An impl method a `Type.method` call names, and the impl block holding it.
struct StaticMethod
    def: *FnDef
    ib: *ImplBlock

# The impl method `Type.method` names; None when no impl of `Type` has it.
fn static_method_def(s: *EmitterState, type_sv: StrView, method_sv: StrView) -> Option<StaticMethod>
    var sib: *ImplBlock = s.sym.module.impls
    while sib != null
        if name_eq(sib.type_name, type_sv) == 1
            var sm_it: *FnDef = sib.methods
            while sm_it != null
                if name_eq(sm_it.name, method_sv) == 1
                    return Some(StaticMethod { def: sm_it, ib: sib })
                sm_it = sm_it.next
        sib = sib.next
    None

# `Type.method(args)` with no receiver: its result when it is one.
fn try_emit_static_method(s: *EmitterState, e: *Expr) -> Option<i32>
    if e.left.kind != ExprKind.Ident
        return None
    let type_sv: StrView = e.left.ident
    let method_sv: StrView = e.ident
    if find_local_struct_name(s, type_sv) != null
        return None
    let static_glob: *GlobalVarDef = find_global(s, type_sv)
    if static_glob != null and global_is_receiver(static_glob) != 0
        return None
    # Look for an impl block whose type_name matches the LHS ident.
    var found: StaticMethod = StaticMethod { def: null, ib: null }
    match static_method_def(s, type_sv, method_sv)
        Some(m) => found = m
        None => return None
    let sm_ib: *ImplBlock = found.ib
    var sm_method: *FnDef = found.def
    # The callee's symbol: `<Type>_<method>`, or for a generic impl
    # the slot's instance's (AGAST #3309).
    let sm_generic: bool = sm_ib.type_params != null
    if sm_generic
        sm_method = generic_static_method(s, e)
        if sm_method == null
            return Some(0)
    note_method_callee(s, e, sm_method)   # AGAST #2237
    if refuse_array_return(s, e, sm_method)
        return Some(0)
    # A receiver is what `self` takes, and a type isn't one, as in
    # ritz0 (AGAST #2393): a lent `self` either (#3236).
    if param_is_self(sm_method.params) == 1
        static_call_of_self_error(s, e, sm_method)
        return Some(0)
    # Evaluate args first.
    let sm_conv: *i32 = call_reg_slots(e.args, 0)
    let sm_arg_count: i32 = static_method_args(s, e, sm_method, sm_conv)
    # Emit the call: %r = call <ret_type> @<Type>_<method>(args)
    # AGAST #1730 — large struct results come back via an sret slot.
    let ret_name: StrView = sm_method.return_type_name
    var sm_sret: i32 = 0
    if struct_ret_uses_sret(s, sm_method.return_type, ret_name) == 1
        sm_sret = emit_sret_call_slot(s, ret_name)
    sm_sret = emit_call_sret_array_slot(s, sm_method, sm_sret)   # AGAST #3181
    # A void method binds no result register (AGAST #1733, as
    # #1581 did for the instance arm): `%r = call void` is invalid.
    var sm_result: i32 = 0
    if sm_sret > 0
        sm_result = next_reg(s)
        format_into(s, "  call void")
    else if sm_method.return_type == TypeKind.Void
        format_into(s, "  call void")
    else
        sm_result = next_reg(s)
        format_into(s, "  %.{sm_result} = call ")
        emit_fn_ret_llvm_type(s, sm_method)   # AGAST #2302: `-> [N]T` is `[N x T]`
    if sm_generic
        let callee_ir: String = ir_name(sm_method.name)
        format_into(s, " @{callee_ir.as_view()}(")
    else
        let type_ir: String = ir_name(type_sv)
        let method_ir: String = ir_name(method_sv)
        format_into(s, " @{type_ir.as_view()}_{method_ir.as_view()}(")
    if sm_sret > 0
        emit_call_sret_attr(s, sm_method, ret_name)
        format_into(s, "%.{sm_sret}")
    var sm_p2: *Param = sm_method.params
    for k in 0..sm_arg_count
        if k > 0 or sm_sret > 0
            format_into(s, ", ")
        if sm_p2 != null
            emit_param_llvm_type(s, sm_p2)   # AGAST #1739
            sm_p2 = sm_p2.next
        else
            format_into(s, "i64")
        let arg_reg: i32 = sm_conv[k]
        format_into(s, " %.{arg_reg}")
    format_into(s, ")\n")
    # Register the extern like the instance arm does (#1518): a
    # method from an imported impl has its body in the owning
    # module's .ll and needs a `declare` here (AGAST #2568).
    # emit_extern_declarations skips one this .ll defines
    # (is_local_function), so no local check is needed here.
    # A generic impl's instance is specialised into this module.
    if not sm_generic
        add_method_extern(s, type_sv, method_sv)
    if sm_sret > 0
        return Some(emit_call_sret_result(s, sm_method, sm_result, sm_sret, ret_name))
    # AGAST #1962: a narrow result (`call i32 @C_get`) must be
    # widened to the i64 value model like the instance arm's,
    # or `return C.get(...)` from an i32 fn truncs an i32 reg.
    Some(widen_method_result(s, sm_result, sm_method.return_type))

# A local, global or struct-const receiver.
fn method_recv_ident(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Look up the receiver type from locals
    let loc: *LocalVar = find_local_struct_name(s, recv.ident)
    if loc != null
        r.type_name = lv_name(loc)
        # Get address of receiver for auto-borrowing
        r.receiver_reg = loc.reg
        # Pointer-typed locals (*T, @T, @@T) spill an i64 into the slot;
        # the slot therefore points at a pointer, not at the struct.
        # AGAST #2372: `**S` and `@*S` are further from it; load down to the
        # slot that holds the `*S`.
        r.recv_levels = local_struct_levels(loc)
        r.recv_base = loc.reg
        if r.recv_levels > 0
            r.receiver_reg = emit_load_levels(s, loc.reg, r.recv_levels - 1)
            r.recv_is_ptr_of_ptr = true
        return
    # AGAST #2044: a global receiver (`g_p.get()`).  A struct
    # global's address `@g` is the receiver itself (auto-borrowed,
    # so a mutating method writes the global); a `*S` global holds
    # a pointer in `@g`, so it is dispatched ptr-of-ptr, like a
    # pointer-typed local (cf. emit_member_ptr's #1892 arm).  An
    # `@S` / `@&S` global holds the same `ptr` at runtime (#3093).
    let rglob: *GlobalVarDef = find_global(s, recv.ident)
    if rglob != null
        var rg_ptr_of_ptr: i32 = -1
        if rglob.var_type == TypeKind.Struct and rglob.type_name.len > 0
            r.type_name = rglob.type_name
            rg_ptr_of_ptr = 0
        else if (rglob.var_type == TypeKind.Ptr or rglob.var_type == TypeKind.Ref or rglob.var_type == TypeKind.MutRef) and rglob.pointee_type == TypeKind.Struct and rglob.pointee_type_name.len > 0
            r.type_name = rglob.pointee_type_name
            rg_ptr_of_ptr = 1
        if rg_ptr_of_ptr >= 0
            # Name `@g` as a register so every dispatcher below can
            # take it like a local's slot.
            let rg_reg: i32 = next_reg(s)
            let g_ir: String = ir_name(rglob.name)
            format_into(s, "  %.{rg_reg} = getelementptr i8, ptr @{g_ir.as_view()}, i64 0  ; global receiver\n")
            r.receiver_reg = rg_reg
            r.recv_is_ptr_of_ptr = rg_ptr_of_ptr == 1
            r.recv_levels = rg_ptr_of_ptr
            r.recv_base = rg_reg
        return
    # AGAST #4589: a struct const receiver (`V1_WIKI.as_ptr()` with
    # `const V1_WIKI: StrView = "..."`).  The const is an `internal
    # constant` `%S` global (#189), so its value is loaded (the
    # ident's own path) and spilled to a slot at `%S`: the method
    # runs on that copy, and a `*self` method cannot write the const.
    let rconst: *ConstEntry = find_const_entry(s, recv.ident)
    if rconst != null and rconst.const_type == TypeKind.Struct and rconst.type_name.len > 0 and rconst.value_expr != null
        r.type_name = rconst.type_name
        r.recv_value_reg = emit_expr(s, recv)
        let rc_slot: i32 = next_reg(s)
        alloca_struct_slot(s, rc_slot, r.type_name, "struct-const receiver copy")
        emit_struct_store_or_copy(s, TypeKind.Struct, r.type_name, r.recv_value_reg, rc_slot)
        r.receiver_reg = rc_slot
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0

# `arr[i].m()`, `PS[i].m()`, `q[i].m()` with an ident base.
fn method_recv_local_index(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # AGAST #1981: `arr[i].m()` on a local `[N]St` -- the element's
    # address is the receiver, dispatched in place (a mutating method
    # such as Vec.push writes the array slot, not a copy).  Mirrors
    # emit_member_ptr's `arr[i].field` arm.  Without it the receiver
    # type went unresolved ("cannot determine receiver type").
    let arr_loc: *LocalVar = find_local_struct_name(s, recv.left.ident)
    if arr_loc != null and lv_var_type(arr_loc) == TypeKind.Array and lv_array_elem_type(arr_loc) == TypeKind.Struct and lv_type_name_len(arr_loc) > 0
        let arr_idx: i32 = emit_expr(s, recv.right)
        r.type_name = lv_name(arr_loc)
        r.receiver_reg = struct_array_elem(s, arr_loc.reg, lv_array_size(arr_loc), r.type_name, arr_idx)
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else if const_struct_array_elem(s, recv) != null
        # AGAST #3360: `PS[i].m()` on a module `const PS: [N]S`: the
        # element's address in the const's data is the receiver, as a
        # local array's is.  let_check has refused a mutable lend of it.
        let ca: *ConstEntry = const_struct_array_elem(s, recv)
        r.type_name = ca.array_elem_type_name
        r.receiver_reg = emit_struct_array_elem_ptr(s, ca.name, ca.array_size, r.type_name, recv.right)
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else
        # AGAST #3143: `q[i].m()` with `q` a `*S` local, param or global:
        # element i of what `q` points at is a place, as for `q[i].f`
        # (#1908) and `mkp()[i].m()` (#2299), so a mutating method writes
        # it in place.  `q` and the index are emitted once each.
        var pq_st: *StructDef = null
        if arr_loc != null
            if lv_var_type(arr_loc) == TypeKind.Ptr and lv_type_name_len(arr_loc) > 0
                pq_st = find_struct(s, lv_name(arr_loc))
        else
            let pq_g: *GlobalVarDef = find_global(s, recv.left.ident)
            if pq_g != null and pq_g.var_type == TypeKind.Ptr and pq_g.pointee_type == TypeKind.Struct and pq_g.pointee_type_name.len > 0
                pq_st = find_struct(s, pq_g.pointee_type_name)
        if pq_st != null
            r.type_name = pq_st.name
            r.receiver_reg = emit_ptr_elem_addr(s, recv, pq_st)
            r.recv_is_ptr_of_ptr = false
            r.recv_levels = 0

# The slot a struct-valued call or method result `recv_value_reg` is the
# receiver in: a temporary's own slot (AGAST #2262: so the method and the
# temporary's drop see one value), the slot an sret call left it in (AGAST
# #2073: emit_sret_call_result loaded the value from it, so no copy), or a
# fresh `%S` spill.  A struct value is a real `%S`, so it is stored at the
# struct type, or clang rejects `store i64 %<%S>` (tagged enum,
# ritz-task-133; any user struct, AGAST #2073).  0 when the result is no
# struct value: a primitive, or nothing named.
fn struct_result_slot(s: *EmitterState, r: *MethodRecv, why: StrView) -> i32
    if r.type_name.len == 0
        return 0
    let held: i32 = own_temp_slot_of(s, r.recv_value_reg)
    if held > 0
        return held
    if s.fcx.sret_last_slot > 0 and s.fcx.sret_last_val == r.recv_value_reg
        return s.fcx.sret_last_slot
    if is_primitive_type_name(r.type_name) == 1
        return 0
    let slot: i32 = next_reg(s)
    alloca_struct_slot(s, slot, r.type_name, why)
    emit_struct_store_or_copy(s, TypeKind.Struct, r.type_name, r.recv_value_reg, slot)
    slot

# A call-result receiver, `f().m()`.
fn method_recv_call(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Receiver is a direct call. Resolve its callee's return type name
    # so we know which struct we're calling a method on, then emit the
    # call itself and materialise the result into a stack slot so the
    # ptr-dispatch fallback paths still have something to pass.
    # (ritz-task-106)
    let fn_def: *FnDef = find_call_fn(s, recv)
    if fn_def != null and fn_def.return_type == TypeKind.Struct and fn_def.return_type_name.len > 0
        r.type_name = fn_def.return_type_name
    # AGAST #2946: a `*S` return (`sp(@s).me()`) names S too, and the
    # returned pointer itself is the receiver -- not a spill of it (as the
    # ExprKind.Method arm, #2883).
    var call_ptr_st: *StructDef = null
    if r.type_name.len == 0
        call_ptr_st = call_result_ptr_struct(s, recv)
    # AGAST #2399: a `**S` or `@*S` return, loaded down to S's address.
    var call_lv_st: *StructDef = null
    var call_levels: i32 = 0
    if r.type_name.len == 0 and call_ptr_st == null
        call_levels = call_result_struct_levels(s, recv, @call_lv_st)
    r.recv_value_reg = emit_expr(s, recv)
    var call_slot: i32 = 0
    if call_levels >= 2
        r.type_name = call_lv_st.name
        let levels_ptr: i32 = recv_inttoptr(s, r.recv_value_reg, "call-result levels receiver")
        call_slot = emit_load_levels(s, levels_ptr, call_levels - 1)
    else if call_ptr_st != null
        r.type_name = call_ptr_st.name
        call_slot = recv_inttoptr(s, r.recv_value_reg, "*S call-result receiver")
    else
        call_slot = struct_result_slot(s, r, "method-on-call-result (struct value)")
        if call_slot == 0
            call_slot = next_reg(s)
            alloca_slot(s, call_slot, "i64", "method-call-on-call-result receiver")
            emit_store_typed(s, "i64", r.recv_value_reg, call_slot)
    r.receiver_reg = call_slot
    r.recv_is_ptr_of_ptr = false
    r.recv_levels = (call_ptr_st != null) as i32

# A method-result receiver, `a.f().m()`.
fn method_recv_chain(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Recursive chain: `a.foo().bar()`. Emit the inner method call to
    # get the value and spill it to a stack slot. We cannot name the
    # outer receiver's struct type without an impl-table lookup, so
    # type_name stays empty and the stub fires unless an intrinsic that
    # ignores type_name matches.  Enum-unwrap is gated on a named
    # type_name so recursive chaining through `.unwrap()` isn't
    # supported yet. (ritz-task-106)
    # AGAST #2594: when the inner method returns a struct
    # (`c.me().tp(3)`), call_result_struct_name names it; the result is a
    # `%S` value, spilled at that type and dispatched like a call's.
    r.type_name = call_result_struct_name(s, recv)
    # AGAST #2883: a `*S` return (`s.me().me()`) names S too, and the
    # returned pointer itself is the receiver -- not a spill of it.
    var chain_ptr_st: *StructDef = null
    if r.type_name.len == 0
        chain_ptr_st = call_result_ptr_struct(s, recv)
    r.recv_value_reg = emit_expr(s, recv)
    var chain_slot: i32 = 0
    if chain_ptr_st != null
        r.type_name = chain_ptr_st.name
        chain_slot = recv_inttoptr(s, r.recv_value_reg, "*S method-result receiver")
    else
        # As the ExprKind.Call arm (#2262, #2073).
        chain_slot = struct_result_slot(s, r, "method-on-method-result (struct value)")
        if chain_slot == 0
            r.type_name = no_name()
            chain_slot = next_reg(s)
            alloca_slot(s, chain_slot, "i64", "method-call-on-method-result receiver")
            emit_store_typed(s, "i64", r.recv_value_reg, chain_slot)
    r.receiver_reg = chain_slot
    r.recv_is_ptr_of_ptr = false
    r.recv_levels = (chain_ptr_st != null) as i32

# A field receiver, `r.raw.push(9)`.
fn method_recv_member(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Field receiver: `r.raw.push(9)`, `q.a.get()`, `o.q.a.get()`.
    # emit_member_ptr yields the field's address, which IS the
    # receiver pointer for in-place (auto-borrowed) dispatch — a
    # mutating method writes through to the field, not a copy.  A
    # pointer-typed field (`p: *T`) holds a pointer in that slot, so
    # it is dispatched ptr-of-ptr, like a pointer-typed local.
    # (AGAST #1512)
    var mres: MemberPtrResult
    emit_member_ptr(s, recv, @mres)
    if mres.success != 1 or mres.field == null
        return
    let rf: *StructField = mres.field
    if rf.field_type_name.len > 0
        match rf.field_type
            TypeKind.Struct =>
                r.type_name = rf.field_type_name
                r.receiver_reg = mres.reg
                r.recv_is_ptr_of_ptr = false
                r.recv_levels = 0
            TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                r.type_name = rf.field_type_name
                r.recv_levels = field_struct_levels(rf)
                r.recv_base = mres.reg
                r.receiver_reg = emit_load_levels(s, mres.reg, r.recv_levels - 1)   # AGAST #2372
                r.recv_is_ptr_of_ptr = true
            _ => pass
    if r.type_name.len == 0
        # A primitive field: `e.key.equals(k)` on a specialised
        # HashMapEntry<K, V> with K = i64 (AGAST #1858).  The field's
        # address mres.reg is the `self: @i64` receiver, as a
        # primitive local's slot is.  A specialised field keeps its
        # substituted name ("i64", subst_value_field), so this is
        # after the named arms, not their `else`.  Dispatch only when
        # an impl method exists, so the BitOps path below keeps a
        # field with none (AGAST #4294).
        let pf_name: StrView = primitive_spelling(rf.field_type)
        if not unnamed(pf_name) and find_impl_method(s, pf_name, e.ident) != null
            r.type_name = pf_name
            r.receiver_reg = mres.reg
            r.recv_is_ptr_of_ptr = false
            r.recv_levels = 0

# A cast or deref receiver, `(p as @&S).m()`, `(*pp).m()`.
fn method_recv_deref(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    if recv.kind == ExprKind.Cast and (recv.type_kind == TypeKind.Ptr or recv.type_kind == TypeKind.Ref or recv.type_kind == TypeKind.MutRef) and recv.cast_ptr_kind == (TypeKind.Struct as i32)
        # AGAST #4161: `(p as @&S).m()`, `(p as @S).m()`, `(p as *S).m()`.
        # apply_cast_tail names the cast's struct (#1453, #3443), and
        # emit_deref_operand_ptr turns the cast's value into S's address, as
        # it does for `(p as @&S).f`.  So the method runs on the pointee, as
        # with `(*p).m()`.
        var cr_st: *StructDef = null
        var cr_levels: i32 = 0
        let cr_reg: i32 = emit_deref_operand_ptr(s, recv, @cr_st, @cr_levels)
        if cr_reg != 0 and cr_levels == 1
            r.type_name = cr_st.name
            r.receiver_reg = cr_reg
            r.recv_is_ptr_of_ptr = false
            r.recv_levels = 0
    else if recv.kind == ExprKind.Unary and recv.op == OpKind.Deref
        # AGAST #2145: `(*pp).m()` with pp a `**S` (param, local, field):
        # `*pp` is a `*S` value, so dispatch like a `*S` local -- the
        # loaded pp points at the slot holding the `*S` (ptr-of-ptr).
        # emit_deref_operand_ptr resolves pp the way emit_member_ptr's
        # `(*pp).w` arm (#1940) does.
        var dr_st: *StructDef = null
        var dr_levels: i32 = 0
        let dr_reg: i32 = emit_deref_operand_ptr(s, recv.operand, @dr_st, @dr_levels)
        if dr_reg == 0
            return
        if dr_levels == 1
            # AGAST #3109: a deref that leaves the struct itself, `(*(q + k)).m()`,
            # `(*q).m()`, `(**pp).m()`.  LARB R9 (#2175): `*p` is a place, so the
            # method runs on the pointee -- the loaded operand IS its address,
            # as a struct local's slot is.  The operand is emitted once, above.
            r.type_name = dr_st.name
            r.receiver_reg = dr_reg
            r.recv_is_ptr_of_ptr = false
            r.recv_levels = 0
        # AGAST #2404: through a `***S` or deeper `*p` is a `**S`, and the
        # loaded p is that many loads from the slot holding the `*S`.
        else if dr_levels >= 2
            r.type_name = dr_st.name
            r.receiver_reg = emit_load_levels(s, dr_reg, dr_levels - 2)
            r.recv_is_ptr_of_ptr = true
            r.recv_levels = dr_levels - 1
            r.recv_base = dr_reg

# A `**S` or deeper receiver no arm above names (AGAST #2404).
fn method_recv_ptr_ptr(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # AGAST #2404: a `**S` or deeper that no arm above names (a global, an
    # element of a `[N]**S` or of a `***S`).  Evaluated once, then loaded down
    # to the slot holding the `*S`, as a `**S` local is.  A global or a local
    # array's element is a place, so a `self: **S` (#3071) takes it there.
    if r.type_name.len != 0 or r.receiver_reg != 0 or r.recv_value_reg >= 0
        return
    let pp: PtrLevels = recv_ptr_ptr_levels(s, recv)
    let pp_levels: i32 = pp.levels
    if pp_levels < 2
        return
    r.type_name = pp.name
    r.recv_is_ptr_of_ptr = true
    r.recv_levels = pp_levels
    if recv.kind == ExprKind.Ident or recv_elem_is_local_array(s, recv)
        r.recv_base = emit_lvalue_ptr(s, recv)
        r.receiver_reg = emit_load_levels(s, r.recv_base, pp_levels - 1)
    else
        let pp_val: i32 = emit_expr(s, recv)
        let pp_ptr: i32 = recv_inttoptr(s, pp_val, "**S receiver")
        r.receiver_reg = emit_load_levels(s, pp_ptr, pp_levels - 2)

# A receiver that is a struct literal or a string literal: spilled to a slot,
# which is the receiver.
fn method_recv_literal(s: *EmitterState, recv: *Expr, r: *MethodRecv)
    if recv.kind == ExprKind.StructLit
        # Rvalue-struct receiver: `Point { x: 2.0 }.scale(...)`.  Spill
        # the struct literal into a stack slot and use that slot as the
        # receiver pointer, mirroring the pattern used for chained calls.
        # The struct lit's name (recv.ident) IS the type name,
        # so we know which impl table to consult without value emission.
        r.type_name = recv.ident
        let lit_slot: i32 = next_reg(s)
        alloca_struct_slot(s, lit_slot, r.type_name, "rvalue struct-lit receiver")
        emit_struct_lit_to_alloca(s, recv, lit_slot)
        r.receiver_reg = lit_slot
    else
        # AGAST #3156: `"lit".len()`.  A bare literal is a StrView (#98): its
        # %Span$u8 value is rebuilt as a %StrView and spilled, and the slot is
        # the receiver, as a StrView local's is -- so `impl StrView` methods
        # and the `strview_*` UFCS fallback resolve the same way.
        let sl_val: i32 = emit_expr(s, recv)
        let sl_sv: i32 = emit_strview_from_lit(s, recv, sl_val)
        r.type_name = "StrView"
        let sl_slot: i32 = next_reg(s)
        alloca_slot(s, sl_slot, "%StrView", "string-literal receiver")
        format_into(s, "  store %StrView %.{sl_sv}, ptr %.{sl_slot}\n")
        r.receiver_reg = sl_slot
    r.recv_is_ptr_of_ptr = false
    r.recv_levels = 0

# Resolve the receiver's type and place into `r`, by the receiver's shape.
fn method_recv_resolve(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    if recv.kind == ExprKind.Index
        method_recv_index(s, e, recv, r)
    else
        match recv.kind
            ExprKind.Ident =>
                method_recv_ident(s, e, recv, r)
            ExprKind.Call =>
                method_recv_call(s, e, recv, r)
            ExprKind.Method =>
                method_recv_chain(s, e, recv, r)
            ExprKind.StructLit | ExprKind.StringLit =>
                method_recv_literal(s, recv, r)
            ExprKind.Member =>
                method_recv_member(s, e, recv, r)
            _ =>
                method_recv_deref(s, e, recv, r)
    method_recv_ptr_ptr(s, e, recv, r)

# An element receiver, `recv` an ExprKind.Index: its address is the receiver
# wherever the element is a place.
fn method_recv_index(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # The element's struct, as index_through_struct, emit_through_elem_ptr and
    # array_elem_pointee name it (AGAST #2332, #2443).
    let through: Option<StrView> = index_through_struct(s, recv)
    let through_name: StrView = through.unwrap_or(no_name())
    var elem_name: *u8 = through_name.ptr
    var elem_len: i32 = through_name.len as i32
    let ptr_elem: NamedKind = array_elem_pointee(s, recv)   # `[N]*S`'s S, AGAST #2332
    if through.is_some() and elem_name != null
        # AGAST #2443: `p[i].m()` through a `*`, `@` or `@&` Vec, Span or String
        # (R9), and `v[i].m()` on one: the element's address is the receiver, so
        # a mutating method writes the element in place.
        var elem_sv: StrView = StrView { ptr: (elem_name), len: (elem_len) as i64 }
        r.receiver_reg = emit_through_elem_ptr(s, recv, @elem_sv)
        r.type_name = elem_sv
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else if nd_struct_leaf(s, recv) != null
        # AGAST #3306: `g[i][j].m()` over an N-D `[..]S` (local, global,
        # field, plane pointer): the element's address is the receiver, as
        # for `arr[i].m()` (#1981), so a mutating method writes it in place.
        let nd_st: *StructDef = nd_struct_leaf(s, recv)
        var nd_recv: NdIndexPtr
        emit_nd_index_ptr(s, recv, @nd_recv)
        r.receiver_reg = nd_recv.reg
        r.type_name = nd_st.name
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else if ptr_elem.kind == TypeKind.Struct
        # AGAST #2332: `a[i].m()` with `a: [N]*S`: the element IS the receiver.
        elem_name = ptr_elem.name.ptr
        elem_len = ptr_elem.name.len as i32
        var elem_ptr: i32 = 0
        if recv_elem_is_local_array(s, recv)
            # AGAST #3071: a local array's element is a place, so a `self: **S`
            # can take it.  Its index runs once: the element loads from it.
            r.recv_base = emit_lvalue_ptr(s, recv)
            elem_ptr = emit_load_ptr(s, r.recv_base)
        else
            let elem_val: i32 = emit_expr(s, recv)
            elem_ptr = next_reg(s)
            format_into(s, "  %.{elem_ptr} = inttoptr i64 %.{elem_val} to ptr\n")
        r.type_name = StrView { ptr: (elem_name), len: (elem_len) as i64 }
        r.receiver_reg = elem_ptr
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 1
    else if recv.left == null
        return
    else if recv.left.kind == ExprKind.Ident and (recv.right == null or recv.right.kind != ExprKind.Range)
        method_recv_local_index(s, e, recv, r)
    else if recv.right == null or recv.right.kind == ExprKind.Range
        return   # a slice (`a[lo..hi].m()`): no element to name
    else if (recv.left.kind == ExprKind.Call or recv.left.kind == ExprKind.Method) and call_ptr_elem_struct(s, recv.left) != null
        # AGAST #2299: `mkp()[i].m()` with `mkp() -> *S`: element i of what the
        # call points at is a place, as emit_member_ptr's `mkp()[i].f` arm
        # (#2870) has it, so a mutating method writes it in place.  The call
        # and the index are emitted once each.
        let pe_st: *StructDef = call_ptr_elem_struct(s, recv.left)
        r.type_name = pe_st.name
        r.receiver_reg = emit_ptr_elem_addr(s, recv, pe_st)
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else if recv.left.kind == ExprKind.Index and index_elem_ptr_struct(s, recv.left) != null
        # AGAST #3199: `a[i][j].m()` with `a: [N]*S` is `*(a[i] + j)` (#2377):
        # element j of what `a[i]` points at is a place, as for `q[i].m()`
        # (#3143), so a mutating method writes it in place.  `a[i]` and `j`
        # are emitted once each.
        let ae_st: *StructDef = index_elem_ptr_struct(s, recv.left)
        r.type_name = ae_st.name
        r.receiver_reg = emit_ptr_elem_addr(s, recv, ae_st)
        r.recv_is_ptr_of_ptr = false
        r.recv_levels = 0
    else if recv.left.kind == ExprKind.Member and field_struct_array_elem(s, recv.left) != null
        # AGAST #3234: `v.a[i].m()` with `a: [N]S` inline in v (and so
        # `mv().a[i].m()`, which emit_call_array_index spills to a local):
        # the element's address is the receiver, as for `arr[i].m()` (#1981).
        # The field's place and the index are emitted once each.
        let fa_st: *StructDef = field_struct_array_elem(s, recv.left)
        var fa_res: MemberPtrResult
        emit_member_ptr(s, recv.left, @fa_res)
        if fa_res.success == 1
            let fa_idx: i32 = emit_expr(s, recv.right)
            r.type_name = fa_st.name
            r.receiver_reg = struct_array_elem(s, fa_res.reg, fa_res.field.array_size, r.type_name, fa_idx)
            r.recv_is_ptr_of_ptr = false
            r.recv_levels = 0

# The built-in dispatchers, before the impl lookup: the result when one fired.
fn try_emit_method_builtin(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv) -> Option<i32>
    let ptr_of_ptr: bool = r.recv_is_ptr_of_ptr
    if r.type_name.len > 0
        # Tagged-enum intrinsic: Option/Result .unwrap / .unwrap_or. Needs a
        # resolved receiver struct name to know it's a tagged enum; runs
        # before the cannot-determine-receiver-type stub so ExprKind.Call
        # receivers with Option$/Result$ returns resolve cleanly without
        # needing ritzlib unwrap helpers that don't exist. (ritz-task-106)
        let enum_unwrap: i32 = try_emit_enum_unwrap(s, e, r.type_name, r.receiver_reg, ptr_of_ptr, r.recv_value_reg)
        if enum_unwrap >= 0
            return Some(enum_unwrap)
        # `.is_some()` / `.is_ok()` and their negations on a receiver no
        # local names (AGAST #3061): inline, as on a local.
        let enum_pred: i32 = try_emit_enum_pred_at(s, e, r.type_name, r.receiver_reg, ptr_of_ptr as i32)
        if enum_pred >= 0
            return Some(enum_pred)
    else
        # R36's revisit (#4294): a primitive or `*u8` receiver dispatches to the
        # trait impl on that built-in type (only legal in the trait's file).  Only
        # when such a method exists: otherwise the BitOps intrinsics below keep
        # their no-impl-name path (`x.count_ones()`).
        let br_name: StrView = builtin_receiver_name(s, recv)
        if not unnamed(br_name)
            if find_impl_method(s, br_name, e.ident) != null
                r.type_name = br_name

    if r.type_name.len == 0
        # Integer-primitive receiver: BitOps intrinsics (AGAST #1506).
        # Only reached when no struct type resolved, so it cannot shadow
        # a user impl method of the same name.
        let bitop: i32 = try_emit_int_bitops(s, e, r.recv_value_reg)
        if bitop >= 0
            return Some(bitop)
        # ritz0's words (AGAST #4665): emitter/calls.py, a receiver whose type
        # nothing names (`(1, 2).foo()`).
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprints("Cannot call method '")
        eprint_bytes(e.ident)
        eprints("' on unknown type\n")
        let zero: i32 = next_reg(s)
        format_into(s, "  %.{zero} = add i64 0, 0\n")
        return Some(zero)

    # Built-in method dispatchers (run BEFORE the default Type_method mangling).
    # Mirrors ritz0's Wave-1 dispatch chain — catches obvious intrinsic patterns
    # that ritz1 doesn't have impl-table entries for.

    # StrView.as_bytes() -> inline Span<u8>
    let sv_bytes: i32 = try_emit_strview_as_bytes(s, e, r.type_name, r.receiver_reg, ptr_of_ptr as i32)
    if sv_bytes >= 0
        return Some(sv_bytes)

    # Vec/Span/StrView .len() -> direct field load
    let len_val: i32 = try_emit_len_builtin(s, e, r.type_name, r.receiver_reg, ptr_of_ptr as i32)
    if len_val >= 0
        return Some(len_val)

    # AGAST #3267: `let h = "..."` is the layout-equal %Span$u8 here but a
    # StrView in ritz0, so `h.get(i)` on a module with no Span<u8> `get`
    # (cryptosec imports only ritzlib.strview) is `impl StrView`'s, as ritz0
    # calls it.  Before the Span builtins, so `h.slice(..)` is StrView's too.
    # The UFCS fallback did this with `strview_*` until LARB R66 (#3497).
    if name_eq(r.type_name, "Span$u8") == 1 and span_u8_method_is_strview(s, e.ident) == 1
        r.type_name = "StrView"

    # Span .ptr() / .is_empty() / .slice(lo, hi) with no method defining them
    let span_val: i32 = try_emit_span_builtin(s, e, r.type_name, r.receiver_reg, ptr_of_ptr)
    if span_val >= 0
        return Some(span_val)
    None

# Coerce the evaluated args to the method's params (self skipped) into conv_regs.
fn method_coerce_args(s: *EmitterState, e: *Expr, mfn: *FnDef, arg_regs: *i32, conv_regs: *i32, arg_count: i32)
    var mp: *Param = null
    if mfn != null
        mp = mfn.params
        if mp != null
            mp = mp.next
    # Argument j, walked alongside its param.
    var mbe: *Expr = e.args
    for j in 0..arg_count
        if mp != null
            # Integer args are i64 registers; narrow them to the param width
            # like the free-fn and UFCS paths do, or the call passes an i64
            # register under an iN type (AGAST #1607, #1580).
            let narrow_to: StrView = method_arg_narrow_ty(mp)
            let sv_arg: i32 = method_strview_arg(s, mp, mbe, arg_regs[j])   # AGAST #3495
            if sv_arg >= 0
                conv_regs[j] = sv_arg
            else if not unnamed(narrow_to)
                conv_regs[j] = emit_method_arg_trunc(s, arg_regs[j], narrow_to)
            else if is_span_param(mp) and mbe != null
                # AGAST #2305: `r.len(@a)` builds its Span as `len(@a)` does.
                conv_regs[j] = span_param_arg(s, mbe, mp, arg_regs[j])
            else if mp.param_type == TypeKind.F32 or mp.param_type == TypeKind.F64
                conv_regs[j] = method_float_arg(s, mp, mbe, arg_regs[j])   # AGAST #2561
            else if param_takes_addr_value(s, mbe, mp)
                # AGAST #2287: as the free-call cascade does for any `@&T`.
                conv_regs[j] = i64_value_to_ptr(s, mbe, arg_regs[j])
            else if mp.param_type == TypeKind.MutRef
                # AGAST #1758: `@&v`, an `@&T` ident and `v as @&T` are
                # already `ptr`; an i64 value (a `-> @&T` call result) is
                # inttoptr'd.  The UFCS arm did this until LARB R66 (#3497)
                # sent ritzlib's methods here.
                conv_regs[j] = i64_value_to_ptr(s, mbe, arg_regs[j])
            else if (mp.param_type == TypeKind.Ref or mp.param_type == TypeKind.Ptr or mp.param_type == TypeKind.PtrPtr) and expr_is_ptr_valued(s, mbe) == 1
                # AGAST #2416: `r.get(@&c)` into `c: @C`, as the free call does.
                # AGAST #3071: and `q.swap(@&e)` into `n: *C` (or `**C`).
                conv_regs[j] = ptr_value_to_i64(s, mbe, arg_regs[j])
            else if mp.param_type == TypeKind.Ref and mp.param_type_name.len > 0 and mbe != null and mbe.kind == ExprKind.Ident
                let mloc: *LocalVar = find_local_struct_name(s, mbe.ident)
                if mloc != null and lv_var_type(mloc) == TypeKind.Struct
                    let pti_m: i32 = next_reg(s)
                    format_into(s, "  %.{pti_m} = ptrtoint ptr %.{mloc.reg} to i64\n")
                    conv_regs[j] = pti_m
            # An integer for a by-value struct param, which the newtype box
            # used to store into the struct, is Sema's call_check's to refuse
            # (LARB R47b, §9.2, #3420; AGAST #3503).
            mp = mp.next
        if mbe != null
            mbe = mbe.next

# The LLVM type a method's scalar result is called at: ty_mem_llvm's spelling
# for a bool, a narrow integer or a float; i64 for a pointer (the value model
# holds one in an i64) and for any kind with no scalar spelling.
fn method_ret_scalar(rtype: TypeKind) -> StrView
    if ty_is_ptr(rtype) == 1
        return "i64"
    let mem: StrView = llvm_text(ty_mem_llvm(rtype))
    if unnamed(mem) then "i64" else mem

# ` = call <ret> @`: a first-class method result, typed as the method's
# `define` spells it.
fn emit_method_call_ret(s: *EmitterState, mfn: *FnDef, rtype: TypeKind)
    if ret_array_of(mfn) != null
        format_into(s, " = call ")
        emit_fn_ret_llvm_type(s, mfn)   # AGAST #2302: `[N x T]`
        format_into(s, " @")
    else if rtype == TypeKind.Struct and mfn != null and mfn.return_type_name.len > 0
        # Struct-returning impl methods (e.g. `clone_self(self) -> S`).
        # Match the `define weak_odr %S @S_clone_self(...)` signature
        # rather than the i64 fallback — clang rejects the type mismatch.
        format_into(s, " = call ")
        emit_llvm_type_struct(s, TypeKind.Struct, mfn.return_type_name)
        format_into(s, " @")
    else
        format_into(s, " = call {method_ret_scalar(rtype)} @")

# `Type_method(receiver, args)`: the impl method the receiver's type names.
fn emit_impl_method_call(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv) -> i32
    # Fallback: Build mangled function name: Type_method
    # Emit: call <rt> @Type_method(ptr %receiver, args...)
    #
    # AGAST #113 — walk the impl blocks to find the method's FnDef so we can
    # coerce struct-ref args (auto-borrow) and narrow non-i64 return values.
    # Without the FnDef, fall back to the pre-#113 `call i64 @...(i64 ...)`.
    let method_sv: StrView = e.ident
    var mfn: *FnDef = find_impl_method(s, r.type_name, method_sv)
    # AGAST #2096: a generic impl's method specialized at the receiver's type
    # (`w.dup()` on W<i32> -> `W$i32_dup`) lives in the module's functions,
    # not in an impl block.  Without its FnDef the call fell back to
    # `call i64`, against `define %W$i32` (or `define i32` for `-> T`).
    # It is defined as a free fn, so its `*W<T>` self is the i64 value-model
    # pointer, not the impl define's forced `ptr` (see recv_ty below).
    var mfn_is_spec: bool = false
    if mfn == null
        mfn = find_spec_impl_method(s, r.type_name, method_sv)
        mfn_is_spec = mfn != null
    if mfn == null and refuse_no_method(s, e, r.type_name)
        return 0
    note_method_callee(s, e, mfn)   # AGAST #2237
    if refuse_array_return(s, e, mfn)
        return 0
    if refuse_receiver_short_of_self(s, recv, mfn, r.recv_levels)
        return 0
    # AGAST #3071: a `self` two levels or more from its struct is the pointer
    # at those levels: the place of a receiver one short (lent, §5.4), or what
    # one with the levels holds.  Not the `*S` the dispatch below loads.
    if pass_self_at_its_levels(s, recv, mfn, r.recv_levels, r.recv_base, @r.receiver_reg) == 1
        r.recv_is_ptr_of_ptr = false

    # A pointer-typed receiver (local, param or field `*T`) sits in a slot
    # that holds the pointer: load it and pass that, not the slot (AGAST #1692).
    if r.recv_is_ptr_of_ptr
        let recv_ptr: i32 = next_reg(s)
        emit_load_into(s, "ptr", recv_ptr, r.receiver_reg)
        r.receiver_reg = recv_ptr

    var self_param: *Param = null
    if mfn != null and param_self_is_value(mfn.params) == 1
        self_param = mfn.params
        r.receiver_reg = emit_self_value(s, self_param, r.receiver_reg)

    # First, evaluate all arguments and collect their registers
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    let conv_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg: *Expr = e.args
    # Params walked alongside, skipping self (AGAST #1498).
    var ap: *Param = null
    if mfn != null
        ap = mfn.params
        if ap != null
            ap = ap.next
    while arg != null
        arg_regs[arg_count] = emit_call_arg(s, arg, ap)
        conv_regs[arg_count] = arg_regs[arg_count]
        arg_count = arg_count + 1
        if ap != null
            ap = ap.next
        arg = arg.next

    method_coerce_args(s, e, mfn, arg_regs, conv_regs, arg_count)

    var rtype: TypeKind = TypeKind.I64
    if mfn != null
        rtype = mfn.return_type

    # A specialized `Type$T_method` declares a pointer self (`*W<T>`, `@W<T>`)
    # as i64 (emit_llvm_type), so pass the receiver as one (AGAST #2096).
    var recv_ty: StrView = "ptr "
    if mfn_is_spec and mfn.params != null
        let sp: TypeKind = mfn.params.param_type
        if sp == TypeKind.Ptr or sp == TypeKind.Ref
            let recv_int: i32 = next_reg(s)
            format_into(s.ir.out, "  %.{recv_int} = ptrtoint ptr %.{r.receiver_reg} to i64\n")
            r.receiver_reg = recv_int
            recv_ty = "i64 "

    # Emit the call with the correct return type keyword.  A void method is
    # `call void` with no result register; binding one to `call i64` would
    # mismatch the `define void` (AGAST #1581).
    var result: i32 = 0
    # AGAST #1730 — large struct results come back via an sret slot.
    var ret_name: StrView = no_name()
    if mfn != null
        ret_name = mfn.return_type_name
    var m_sret: i32 = 0
    if mfn != null and struct_ret_uses_sret(s, rtype, ret_name) == 1
        m_sret = emit_sret_call_slot(s, ret_name)
    m_sret = emit_call_sret_array_slot(s, mfn, m_sret)   # AGAST #3181
    if m_sret > 0
        result = next_reg(s)
        format_into(s, "  call void @")
    else if rtype == TypeKind.Void
        format_into(s, "  call void @")
    else
        result = next_reg(s)
        format_into(s, "  %.{result}")
        emit_method_call_ret(s, mfn, rtype)
    let type_ir: String = ir_name(r.type_name)
    let method_ir: String = ir_name(method_sv)
    format_into(s, "{type_ir.as_view()}_{method_ir.as_view()}(")
    if m_sret > 0
        emit_call_sret_attr(s, mfn, ret_name)
        format_into(s, "%.{m_sret}, ")
    if self_param != null
        emit_param_llvm_type(s, self_param)
        format_into(s, " ")
    else
        format_into(s, "{recv_ty}")
    format_into(s, "%.{r.receiver_reg}")

    # Emit args with formal types (or i64 fallback when fn_def missing).
    var mp2: *Param = null
    if mfn != null
        mp2 = mfn.params
        if mp2 != null
            mp2 = mp2.next
    for j in 0..arg_count
        format_into(s, ", ")
        if mp2 != null
            emit_param_llvm_type(s, mp2)   # AGAST #1739
            mp2 = mp2.next
        else
            format_into(s, "i64")
        let arg_reg: i32 = conv_regs[j]
        format_into(s, " %.{arg_reg}")
    format_into(s, ")\n")
    if m_sret > 0
        result = emit_call_sret_result(s, mfn, result, m_sret, ret_name)

    # Add method to extern declarations (uses malloc for stable name storage).
    # Skip it only when THIS .ll defines the body (is_local == 1): a `declare`
    # beside the local `define` is an invalid redefinition. A method found in
    # an imported impl (is_local == 0, AGAST #194) has its body in the owning
    # module's .ll, so it needs the declare like an unknown method (#1518).
    if mfn == null or mfn.is_local == 0
        add_method_extern(s, r.type_name, method_sv)

    return widen_method_result(s, result, rtype)

pub fn emit_expr_method_impl(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    # `m.f()`: no `module.item` access (§15.3, AGAST #2215); was "cannot
    # determine receiver type", unlocated.
    if e.left != null and e.left.kind == ExprKind.Ident
        if is_module_item(s, e.left.ident, e.ident) == 1
            return emit_module_item_error(s, e.left.ident, e.ident, e.span.line, e.span.col)
    # Method call: receiver.method(args)
    # e.left is the receiver expression
    # e.ident is the method name
    # e.args is the argument list
    #
    # Strategy: Determine receiver type, mangle to Type_method, call with receiver as first arg
    #
    # Receiver kinds handled:
    #   ExprKind.Ident  — look up the local binding's struct type
    #   ExprKind.Call   — resolve callee return type, materialise the struct
    #                 value into a stack slot for ptr-passing dispatch
    #                 (ritz-task-106)
    #   ExprKind.Method — recursive chain `a.foo().bar()`; we emit the inner
    #                 call for value correctness but can only resolve the
    #                 outer method through an intrinsic that doesn't need
    #                 a resolved struct type, since the inner method's
    #                 return type isn't indexed in ritz1's impl table
    #                 yet. (ritz-task-106)
    var r: MethodRecv = MethodRecv { type_name: no_name(), receiver_reg: 0, recv_is_ptr_of_ptr: false, recv_value_reg: 0 - 1, recv_levels: 0 - 1, recv_base: 0 - 1 }

    # Float-primitive receiver: ceil/floor/round/abs (AGAST #1370).  Before
    # any receiver resolution: the call / chain arms below spill the receiver
    # as an i64, and a float lives in a `float` / `double` register.  A
    # struct receiver is never float-typed, so no impl method is shadowed.
    let fmeth: i32 = try_emit_float_method(s, e)
    if fmeth >= 0
        return fmeth

    # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum value,
    # not a method call.  Before the impl lookup: in ritz0 a variant wins
    # over an impl method of the same name (a local named `Opt` still
    # shadows the enum; qualified_variant checks that).
    var qvi: i32 = 0
    let qei: i32 = qualified_variant(s, e, @qvi)
    if qei >= 0
        return emit_qualified_variant_ctor(s, e, qei, qvi)

    # `E.from(v)` for an enum with no generated `from` (LANGUAGE_SPEC §10.4).
    let from_reg: i32 = try_emit_enum_from(s, e)
    if from_reg != 0 - 1
        return from_reg

    # `Span.empty()`: T from the slot, not a receiver (AGAST #2296).
    let span_assoc: i32 = try_emit_span_assoc(s, e)
    if span_assoc != 0 - 1
        return span_assoc

    # Static-method dispatch: `Vec2.new(...)`.  When the LHS ident matches
    # a STRUCT or IMPL name (and not a local/global), we don't pass a
    # receiver — emit a direct call to `<Type>_<method>(args)` and return.
    # Mirrors ritz0's static-method path (Type.method desugars to a free
    # call against the impl table entry without a self argument).  Must
    # come BEFORE the local-lookup branch so a struct named like a local
    # variable still routes correctly.
    #
    # A global named like the type that can't be a receiver doesn't shadow it,
    # as in ritz0 (AGAST #2575): `var String: i32` beside `String.from(x)`.
    # A struct global does (`var Opt: S`).  monomorph's
    # rewrite_static_ufcs_call hid this for the UFCS table's types until
    # LARB R66 (#3497) deleted the table.
    match try_emit_static_method(s, e)
        Some(static_reg) => return static_reg
        None => pass
    # AGAST #2550: `(@d).m()` and `(@&d).m()` dispatch on `d`, as in ritz0 —
    # the receiver is auto-borrowed anyway, so the address-of names the
    # same place.  Its `@T`-into-`@&T` refusal already ran in the checker.
    var recv: *Expr = e.left
    while recv.kind == ExprKind.Unary and (recv.op == OpKind.Addr or recv.op == OpKind.AddrMut) and recv.operand != null
        recv = recv.operand
    method_recv_resolve(s, e, recv, @r)

    match try_emit_method_builtin(s, e, recv, @r)
        Some(builtin_reg) => return builtin_reg
        None => pass

    emit_impl_method_call(s, e, recv, @r)
