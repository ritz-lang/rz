# AGAST #1813: per-call register arrays, sized from the argument list.  They
# were `[16]i32` locals: two sites dropped arguments past the 16th (a 17-arg
# call passed 16 and miscompiled with exit 0); the others wrote past the
# array.  `min` reserves slots the caller appends beyond the written args.
fn call_reg_slots(args: *Expr, min: i32) -> *i32
    var n: i32 = 0
    var a: *Expr = args
    while a != null
        n = n + 1
        a = a.next
    if n < min
        n = min
    if n < 1
        n = 1
    return malloc((n as i64) * 4) as *i32

# =============================================================================
# Method-dispatch helpers (ported from ritz0 Wave-1 commit 0278a27).
#
# Runs before the regular impl-table lookup so missing UFCS wrappers don't
# block obvious intrinsic patterns. Mirrors the dispatch chain from the
# holy-fuck-wip branch — StrView builtins, Vec/Span/StrView .len(), and a
# UFCS fallback that rewrites `v.method(args)` -> `vec_method$T(&v, args)`
# (similarly for Span$T, StrView) when the monomorphized wrapper exists.
# =============================================================================

# 1 if a TYPE_STRUCT param named (name, len) is no scalar newtype, so its arg
# goes as it is.  A tagged enum's arg is already the enum struct, even a bare
# `None`, which get_expr_type reports as i64 (AGAST #1498).  AGAST #2411: so is
# a user enum's (`v.push(C.B)` on a Vec<C>), and `usize` / `isize` are the i64
# the arg already is: boxing either wrote `store i64` of a `%C`, or an
# `alloca %usize`.
fn param_takes_arg_unboxed(name: *u8, len: i32) -> i32
    if is_tagged_enum_type(name, len) == 1
        return 1
    if user_enum_index(name, len) >= 0
        return 1
    if name_eq(name, len, c"usize", 5) == 1 or name_eq(name, len, c"isize", 5) == 1
        return 1
    0

fn starts_with(name: *u8, len: i32, prefix: *u8, prefix_len: i32) -> i32
    if len < prefix_len
        return 0
    for i in 0..prefix_len
        if *(name + i) != *(prefix + i)
            return 0
    1

# StrView.as_bytes() -> Span<u8> — bypasses the missing StrView_as_bytes impl
# Returns -1 if not applicable, else the LLVM register holding the Span<u8>.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is *StrView);
# 0 when the stack slot is the struct itself.
fn try_emit_strview_as_bytes(s: *EmitterState, e: *Expr, type_name: *u8, type_name_len: i32, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    # Must be "StrView"
    if name_eq(type_name, type_name_len, c"StrView", 7) == 0
        return -1
    # Method must be "as_bytes"
    if name_eq(e.ident_ptr, e.ident_len, c"as_bytes", 8) == 0
        return -1
    # No args
    if e.args != null
        return -1

    # If the receiver is *StrView (pointer), dereference once to get ptr-to-struct.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, loaded)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, receiver_reg)
        emit_str(s, c"\n")
        struct_ptr = loaded

    # Load %StrView from the receiver pointer
    let sv: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sv)
    emit_str(s, c" = load %StrView, ptr ")
    emit_reg(s, struct_ptr)
    emit_str(s, c"\n")

    # Extract the ptr and len fields
    let ptr_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, sv)
    emit_str(s, c", 0\n")

    let len_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, len_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, sv)
    emit_str(s, c", 1\n")

    # Build the %Span$u8 { ptr, i64 } value inline
    let span1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, span1)
    emit_str(s, c" = insertvalue %Span$u8 undef, ptr ")
    emit_reg(s, ptr_reg)
    emit_str(s, c", 0\n")

    let span2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, span2)
    emit_str(s, c" = insertvalue %Span$u8 ")
    emit_reg(s, span1)
    emit_str(s, c", i64 ")
    emit_reg(s, len_reg)
    emit_str(s, c", 1\n")
    return span2

# Vec/Span/StrView .len() — load the len field (index 1) directly.
# Returns -1 if not applicable, else the register holding an i64 length.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is
# *Vec<T> etc.); 0 when the stack slot *is* the struct.
fn try_emit_len_builtin(s: *EmitterState, e: *Expr, type_name: *u8, type_name_len: i32, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    # Must be .len() with no args
    if name_eq(e.ident_ptr, e.ident_len, c"len", 3) == 0
        return -1
    if e.args != null
        return -1

    # Type must be Vec$T, Span$T, or StrView
    var matched: i32 = 0
    if starts_with(type_name, type_name_len, c"Vec$", 4) == 1
        matched = 1
    else if starts_with(type_name, type_name_len, c"Span$", 5) == 1
        matched = 1
    else if name_eq(type_name, type_name_len, c"StrView", 7) == 1
        matched = 1
    if matched == 0
        return -1

    # If the receiver is a pointer, load the stack slot to get the actual struct pointer.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, loaded)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, receiver_reg)
        emit_str(s, c"\n")
        struct_ptr = loaded

    # %len_ptr = getelementptr %Type, ptr %r, i32 0, i32 1
    # %len    = load i64, ptr %len_ptr
    let len_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, len_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, struct_ptr)
    emit_str(s, c", i32 0, i32 1\n")

    let len_val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, len_val)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, len_ptr)
    emit_str(s, c"\n")
    return len_val

# AGAST #3125: `Span<T>` is `{ ptr, len }`, so `.ptr()`, `.is_empty()` and
# `.slice(lo, hi)` are struct operations a module that only receives a span
# can call without importing ritzlib.span, as ritz0's
# _try_emit_builtin_span_method lowers them.  As there, a method the module
# does define (ritzlib.span's `is_empty` / `slice`, a UFCS `span_*` helper)
# wins: this runs only when method_callee_def finds none.  `receiver_reg` is
# the receiver the dispatcher already evaluated, read as try_emit_len_builtin
# reads it.  `.ptr()` is the i64 pointer value, `.is_empty()` the i64 0 / 1 a
# comparison gives, and `.slice(lo, hi)` a %Span$T view
# `{ ptr + lo, hi - lo }`.  Returns -1 when not applicable.
fn try_emit_span_builtin(s: *EmitterState, e: *Expr, type_name: *u8, type_name_len: i32, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    if starts_with(type_name, type_name_len, c"Span$", 5) == 0
        return -1
    var op: i32 = 0
    if e.args == null and name_eq(e.ident_ptr, e.ident_len, c"ptr", 3) == 1
        op = 1
    else if e.args == null and name_eq(e.ident_ptr, e.ident_len, c"is_empty", 8) == 1
        op = 2
    else if name_eq(e.ident_ptr, e.ident_len, c"slice", 5) == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            op = 3
    if op == 0
        return -1
    if method_callee_def(s, type_name, type_name_len, e.ident_ptr, e.ident_len) != null
        return -1

    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, loaded)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, receiver_reg)
        emit_str(s, c"\n")
        struct_ptr = loaded

    # The field `.ptr()` reads (0) or the one the others start from (1).
    var field: i32 = 1
    if op == 1
        field = 0
    let fptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, struct_ptr)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, field as i64)
    emit_str(s, c"\n")

    if op == 1
        let p: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, p)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, fptr)
        emit_str(s, c"\n")
        let pi: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, pi)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, p)
        emit_str(s, c" to i64\n")
        return pi

    if op == 2
        let n: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, n)
        emit_str(s, c" = load i64, ptr ")
        emit_reg(s, fptr)
        emit_str(s, c"\n")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, n)
        emit_str(s, c", 0\n")
        let b: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, b)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, z)
        emit_str(s, c" to i64\n")
        return b

    # slice: the element's size scales `lo` into a byte offset.
    var align: i64 = 1
    let elem_size: i64 = mangled_type_size_align(s, type_name + 5, type_name_len - 5, @align)
    if elem_size <= 0 and is_unit_arg(type_name + 5, type_name_len - 5) == 0
        emit_ir_error(s, c"Span.slice: can't measure the element type")
        return 0
    let lo: i32 = emit_expr(s, e.args)
    let hi: i32 = emit_expr(s, e.args.next)
    let base_ptr_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base_ptr_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, struct_ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let base_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base_ptr)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, base_ptr_ptr)
    emit_str(s, c"\n")
    let off: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, off)
    emit_str(s, c" = mul i64 ")
    emit_reg(s, lo)
    emit_str(s, c", ")
    emit_int(s, elem_size)
    emit_str(s, c"\n")
    let at: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, at)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, off)
    emit_str(s, c"\n")
    let len: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, len)
    emit_str(s, c" = sub i64 ")
    emit_reg(s, hi)
    emit_str(s, c", ")
    emit_reg(s, lo)
    emit_str(s, c"\n")
    let v1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c" undef, ptr ")
    emit_reg(s, at)
    emit_str(s, c", 0\n")
    let v2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c" ")
    emit_reg(s, v1)
    emit_str(s, c", i64 ")
    emit_reg(s, len)
    emit_str(s, c", 1\n")
    return v2

# A string literal passed to a `StrView` param, rebuilt as a %StrView value.
# `reg` is emit_expr's result for `arg`. Also rebuilds any other arg whose
# value is a %Span$u8 (e.g. an un-annotated literal local, #2103). Returns
# the %StrView register, or -1 when no rebuild is needed (the caller passes
# the value through).
fn emit_strview_from_lit(s: *EmitterState, arg: *Expr, reg: i32) -> i32
    if arg == null
        return -1
    var p: i32 = 0 - 1
    var l: i32 = 0 - 1
    if arg.kind == EXPR_STRING_LIT
        # Bare "..." already produced a %Span$u8 aggregate. Span<u8> and
        # StrView are layout-compatible but nominally distinct in LLVM IR,
        # so rebuild the aggregate under the StrView name.
        p = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, p)
        emit_str(s, c" = extractvalue %Span$u8 ")
        emit_reg(s, reg)
        emit_str(s, c", 0\n")
        l = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, l)
        emit_str(s, c" = extractvalue %Span$u8 ")
        emit_reg(s, reg)
        emit_str(s, c", 1\n")
    else if arg.kind == EXPR_CSTRING_LIT
        # c"..." is a pointer (as i64); its length is known statically.
        p = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, p)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, reg)
        emit_str(s, c" to ptr\n")
    else
        # AGAST #2103: any other %Span$u8-valued arg -- an un-annotated
        # `let t = "..."` / `var w = "..."` local is typed Span$u8 -- is
        # the layout-equivalent pair (#168) and is rebuilt the same way.
        var src_name: *u8 = null
        var src_len: i32 = 0
        resolve_expr_struct_name(s, arg, @src_name, @src_len)
        if is_layout_equiv_pair(src_name, src_len, c"StrView", 7) == 1
            return rebuild_layout_equiv(s, reg, src_name, src_len, c"StrView", 7)
        return -1
    let sv1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sv1)
    emit_str(s, c" = insertvalue %StrView undef, ptr ")
    emit_reg(s, p)
    emit_str(s, c", 0\n")
    let sv2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sv2)
    emit_str(s, c" = insertvalue %StrView ")
    emit_reg(s, sv1)
    emit_str(s, c", i64 ")
    if l >= 0
        emit_reg(s, l)
    else
        emit_int(s, arg.string_len as i64)
    emit_str(s, c", 1\n")
    return sv2

# The impl method `type_name.method` defined in this module, or null.
fn find_impl_method(s: *EmitterState, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, type_name, type_name_len) == 1
            var mm: *FnDef = ib.methods
            while mm != null
                if name_eq(mm.name, mm.name_len, method, method_len) == 1
                    return mm
                mm = mm.next
        ib = ib.next
    return null

# UFCS fallback: when the receiver has a known container type, dispatch
# `v.method(args)` to the monomorphized helper — `vec_method$T`, `span_method$T`,
# or `strview_method`. The receiver is passed as a pointer (ptr), consistent
# with the ritzlib signatures.
#
# Returns -1 if the mangled function isn't defined (caller should fall back
# to the current Type_method mangling); otherwise the register holding the call result.
fn try_emit_ufcs_method(s: *EmitterState, e: *Expr, type_name: *u8, type_name_len: i32, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    let fn_def: *FnDef = ufcs_fn_def(s, type_name, type_name_len, e.ident_ptr, e.ident_len)
    if fn_def == null
        return -1
    note_method_callee(s, e, fn_def)   # AGAST #2237
    return emit_ufcs_call(s, e, fn_def, receiver_reg, recv_is_ptr_of_ptr, type_name, type_name_len)

# The monomorphized UFCS helper `type_name.method` dispatches to
# (`vec_method$T`, `span_method$T`, `strview_method`, or a non-generic
# ritzlib prefix), or null when there is none.
fn ufcs_fn_def(s: *EmitterState, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    # Pick the UFCS prefix and suffix source
    var prefix_buf: [16]u8
    var prefix_len: i32 = 0
    var append_suffix: i32 = 0
    var suffix_start: i32 = 0

    if starts_with(type_name, type_name_len, c"Vec$", 4) == 1
        prefix_buf[0] = 'v'
        prefix_buf[1] = 'e'
        prefix_buf[2] = 'c'
        prefix_buf[3] = '_'
        prefix_len = 4
        append_suffix = 1
        suffix_start = 3   # "$..." starts at index 3 of "Vec$..."
    else if starts_with(type_name, type_name_len, c"Span$", 5) == 1
        prefix_buf[0] = 's'
        prefix_buf[1] = 'p'
        prefix_buf[2] = 'a'
        prefix_buf[3] = 'n'
        prefix_buf[4] = '_'
        prefix_len = 5
        append_suffix = 1
        suffix_start = 4   # "$..." starts at index 4 of "Span$..."
    else if name_eq(type_name, type_name_len, c"StrView", 7) == 1
        prefix_buf[0] = 's'
        prefix_buf[1] = 't'
        prefix_buf[2] = 'r'
        prefix_buf[3] = 'v'
        prefix_buf[4] = 'i'
        prefix_buf[5] = 'e'
        prefix_buf[6] = 'w'
        prefix_buf[7] = '_'
        prefix_len = 8
        append_suffix = 0
    else
        # Non-generic ritzlib types. A user impl method of the same name
        # wins, so the table can never shadow a real `impl String`.
        var ng_len: i32 = 0
        let ng: *u8 = ufcs_non_generic_prefix(type_name, type_name_len, @ng_len)
        if ng == null
            return null
        if find_impl_method(s, type_name, type_name_len, method, method_len) != null
            return null
        for i in 0..ng_len
            prefix_buf[i] = *(ng + i)
        prefix_len = ng_len
        append_suffix = 0

    # Build: <prefix><method>[<$T>].  Heap, sized exactly: a fixed [128]u8
    # was overrun by a long method or type name (AGAST #1813).
    let mangled: *u8 = malloc((prefix_len + method_len + type_name_len + 1) as i64)
    var mangled_len: i32 = 0
    for i in 0..prefix_len
        mangled[mangled_len] = prefix_buf[i]
        mangled_len += 1
    for i in 0..method_len
        mangled[mangled_len] = *(method + i)
        mangled_len += 1
    if append_suffix == 1
        for i in suffix_start..type_name_len
            mangled[mangled_len] = *(type_name + i)
            mangled_len += 1

    # Must resolve to a known function for us to dispatch here
    var fn_def: *FnDef = find_fn(s, mangled, mangled_len)
    # AGAST #2404: a non-generic `vec_total(s: Span<u8>)` is `v.total()` on a
    # `Vec<u8>` too, as in ritz0, unless the type has a `total` of its own.
    if fn_def == null and append_suffix == 1
        if find_impl_method(s, type_name, type_name_len, method, method_len) == null and find_spec_impl_method(s, type_name, type_name_len, method, method_len) == null
            fn_def = find_fn(s, mangled, prefix_len + method_len)
    free(mangled)
    return fn_def

# AGAST #2404: the `Span<T>` a `Vec<T>` at `vec` (a `ptr`) views, `{ data, len }`
# read by field name as ritz0 does, when a UFCS helper takes its receiver as a
# Span by value.  0 when `vec_name` isn't a struct with both fields.
fn emit_vec_as_span(s: *EmitterState, vec_name: *u8, vec_len: i32, vec: i32, p: *Param) -> i32
    let st: *StructDef = find_struct(s, vec_name, vec_len)
    if st == null
        return 0
    let di: i32 = find_field_index(st, c"data", 4)
    let li: i32 = find_field_index(st, c"len", 3)
    if di < 0 or li < 0
        return 0
    var regs: [2]i32
    let idx: [2]i32 = [di, li]
    for k in 0..2
        let fp: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fp)
        emit_str(s, c" = getelementptr %")
        emit_name(s, vec_name, vec_len)
        emit_str(s, c", ptr ")
        emit_reg(s, vec)
        emit_str(s, c", i32 0, i32 ")
        emit_int(s, idx[k] as i64)
        emit_str(s, c"\n")
        regs[k] = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, regs[k])
        if k == 0
            emit_str(s, c" = load ptr, ptr ")
        else
            emit_str(s, c" = load i64, ptr ")
        emit_reg(s, fp)
        emit_str(s, c"\n")
    let sp1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sp1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, p.param_type_name, p.param_type_name_len)
    emit_str(s, c" undef, ptr ")
    emit_reg(s, regs[0])
    emit_str(s, c", 0\n")
    let sp2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sp2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, p.param_type_name, p.param_type_name_len)
    emit_str(s, c" ")
    emit_reg(s, sp1)
    emit_str(s, c", i64 ")
    emit_reg(s, regs[1])
    emit_str(s, c", 1\n")
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, null, sp2, p)
    sp2

# The function a method call `type_name.method(..)` dispatches to, in
# emit_expr_method's order: a UFCS helper, a method of a non-generic impl,
# else a specialized generic impl method `Type$T_method` (monomorph adds
# those to the module's functions, not to its impls).  Null when unknown.
# let_check.ritz reads its params (AGAST #2032).
fn method_callee_def(s: *EmitterState, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    let u: *FnDef = ufcs_fn_def(s, type_name, type_name_len, method, method_len)
    if u != null
        return u
    let m: *FnDef = find_impl_method(s, type_name, type_name_len, method, method_len)
    if m != null
        return m
    return find_spec_impl_method(s, type_name, type_name_len, method, method_len)

# The specialized generic impl method `Type$T_method` (`W$i32_dup`), or null.
# monomorph's specialize_impl_method adds these to the module's functions as
# free fns, not to an impl block, so an impl-table walk never finds them.
fn find_spec_impl_method(s: *EmitterState, type_name: *u8, type_name_len: i32, method: *u8, method_len: i32) -> *FnDef
    let n: i32 = type_name_len + 1 + method_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..type_name_len
        *(buf + i) = *(type_name + i)
    *(buf + type_name_len) = '_'
    for i in 0..method_len
        *(buf + type_name_len + 1 + i) = *(method + i)
    *(buf + n) = 0
    let fd: *FnDef = find_fn(s, buf, n)
    free(buf)
    return fd

# The by-value `self` argument read from the receiver at `recv`, a `ptr`.  It's
# read here, before the arguments, because that's when a call evaluates its
# receiver: `c.g(bump(@&c))` passes the c from before the bump (AGAST #2393).
fn emit_self_value(s: *EmitterState, p: *Param, recv: i32) -> i32
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load ")
    emit_llvm_type_struct(s, p.param_type, p.param_type_name, p.param_type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, recv)
    emit_str(s, c"\n")
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, null, val, p)
    val

# 1 when a UFCS helper's first param `p` is the receiver's own struct type
# `type_name` by value (AGAST #2414), not a pointer or reference to it.
fn ufcs_self_is_value(p: *Param, type_name: *u8, type_name_len: i32) -> i32
    if p.param_type != TYPE_STRUCT or p.is_borrow != 0 or p.param_type_name_len <= 0
        return 0
    name_eq(p.param_type_name, p.param_type_name_len, type_name, type_name_len)

# Emit the UFCS call to `fn_def` with the receiver passed as a pointer, or
# by value when the helper's first param takes it so.
fn emit_ufcs_call(s: *EmitterState, e: *Expr, fn_def: *FnDef, receiver_reg: i32, recv_is_ptr_of_ptr: i32, type_name: *u8, type_name_len: i32) -> i32
    # If the receiver is a pointer type, its stack slot holds an i64 pointer —
    # load it first so the callee receives the real struct pointer.
    var recv_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, loaded)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, receiver_reg)
        emit_str(s, c"\n")
        recv_ptr = loaded
    # AGAST #2404: a `Vec<T>` into a `s: Span<T>` receiver is the Span it
    # views, read before the arguments as any receiver is.
    var self_span: i32 = 0
    if fn_def.params != null and param_is_span(fn_def.params) == 1 and starts_with(type_name, type_name_len, c"Vec$", 4) == 1
        self_span = emit_vec_as_span(s, type_name, type_name_len, recv_ptr, fn_def.params)
    else if fn_def.params != null and ufcs_self_is_value(fn_def.params, type_name, type_name_len) == 1
        # AGAST #2414: a helper taking its receiver by value, `strview_eq(a:
        # StrView, ..)`, gets the struct, not the pointer to it.
        self_span = emit_self_value(s, fn_def.params, recv_ptr)

    # Evaluate the argument expressions first (receiver is already a ptr register)
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg: *Expr = e.args
    # Params walked alongside, skipping the receiver (AGAST #1498).
    var ap: *Param = fn_def.params
    if ap != null
        ap = ap.next
    while arg != null
        # Receiver is argument 1, as ritz0 numbers it (AGAST #1948).
        check_struct_ptr_arg(s, e, e.ident_ptr, e.ident_len, arg_count + 2, arg, ap)
        check_array_arg(s, e, e.ident_ptr, e.ident_len, arg_count + 2, arg, ap)
        arg_regs[arg_count] = emit_call_arg(s, arg, ap)
        arg_count = arg_count + 1
        if ap != null
            ap = ap.next
        arg = arg.next

    # Convert argument values to match parameter types (skip the receiver slot)
    let converted_regs: *i32 = call_reg_slots(e.args, 0)
    var param_ptr: *Param = fn_def.params
    # Skip receiver param
    if param_ptr != null
        param_ptr = param_ptr.next
    for j in 0..arg_count
        if param_ptr != null
            if param_uses_byval(s, param_ptr) == 1
                # AGAST #1739 — already the byval slot (emit_call_arg).
                converted_regs[j] = arg_regs[j]
            else if param_ptr.param_type == TYPE_U8 or param_ptr.param_type == TYPE_I8
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i8\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_I32 or param_ptr.param_type == TYPE_U32
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i32\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_I16 or param_ptr.param_type == TYPE_U16
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i16\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_MUT_REF
                let cast: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, cast)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to ptr\n")
                converted_regs[j] = cast
            else if param_ptr.param_type == TYPE_BOOL
                # Callee expects i1. Bool values are i64 registers and need a
                # trunc, except a bool global's i1 load (task-99 #100). This
                # used to ask get_expr_type == TYPE_BOOL, which also passed a
                # bool CALL's zext'd i64 straight through: `takes(yes())`
                # was invalid IR. See bool_reg_is_i1 (AGAST #1646).
                var arg_expr: *Expr = e.args
                var k: i32 = 0
                while k < j and arg_expr != null
                    arg_expr = arg_expr.next
                    k = k + 1
                var already_i1: i32 = 0
                if arg_expr != null
                    if bool_reg_is_i1(s, arg_expr) == 1
                        already_i1 = 1
                if already_i1 == 1
                    converted_regs[j] = arg_regs[j]
                else
                    let bool_trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, bool_trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i1\n")
                    converted_regs[j] = bool_trunc
            else if param_float_type(param_ptr) != 0
                # AGAST #2412: `v.push(1.5)` on a Vec<f32> passed the literal's
                # `double` as `float`.  vec_push$f32's `item: T` is f32 by now.
                converted_regs[j] = ufcs_float_arg(s, param_ptr, nth_arg(e.args, j), arg_regs[j])
            else if param_ptr.param_type == TYPE_STRUCT and param_ptr.param_type_name_len > 0
                # Scalar→struct newtype boxing: when the formal is a single-
                # field (or narrow aggregate) struct but the arg is an
                # integer-typed scalar expression (literal, arithmetic, const),
                # materialize a proper struct value so the call signature
                # matches.  Gate on a narrow scalar type — pointers and other
                # structs pass through so a 2-field struct like Span<T> isn't
                # corrupted by an 8-byte opaque-ptr reinterpret.
                var arg_expr: *Expr = e.args
                var k: i32 = 0
                while k < j and arg_expr != null
                    arg_expr = arg_expr.next
                    k = k + 1
                var is_scalar_int: i32 = 0
                # A tagged or user enum, or `usize`, is never a scalar newtype
                # (param_takes_arg_unboxed).
                var box_probe: *Expr = arg_expr
                if param_takes_arg_unboxed(param_ptr.param_type_name, param_ptr.param_type_name_len) == 1
                    box_probe = null
                # A struct literal is already the `%T` aggregate (#1362).
                if box_probe != null and box_probe.kind == EXPR_STRUCT_LIT
                    box_probe = null
                # AGAST #2560: so is `*p` of an `@S` / `@&S` (`v.push(*p)` on
                # a Vec<S>), which get_expr_type reports as an i64.  Mirrors
                # the emit_expr_method guard.
                if box_probe != null and box_probe.kind == EXPR_UNARY and box_probe.op == OP_DEREF
                    var dname: *u8 = null
                    var dlen: i32 = 0
                    deref_pointee_struct_name(s, box_probe.operand, @dname, @dlen)
                    if dlen > 0
                        box_probe = null
                if box_probe != null
                    let at: i32 = get_expr_type(s, box_probe)
                    if at == TYPE_I8 or at == TYPE_U8 or at == TYPE_I16 or at == TYPE_U16 or at == TYPE_I32 or at == TYPE_U32 or at == TYPE_I64 or at == TYPE_U64
                        is_scalar_int = 1
                var sv_lit: i32 = 0 - 1
                if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"StrView", 7) == 1
                    sv_lit = emit_strview_from_lit(s, arg_expr, arg_regs[j])
                if sv_lit >= 0
                    converted_regs[j] = sv_lit
                else if is_scalar_int == 0
                    converted_regs[j] = arg_regs[j]
                else if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u16", 3) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i16", 3) == 1
                    # Post-monomorph primitive (vec_push_u16_method parity):
                    # the param was a generic `T` substituted with u16/i16 but
                    # left TYPE_STRUCT in the AST.  Just truncate the i64 arg.
                    let t16: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, t16)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i16\n")
                    converted_regs[j] = t16
                else if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u8", 2) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i8", 2) == 1
                    let t8: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, t8)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i8\n")
                    converted_regs[j] = t8
                else if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u32", 3) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i32", 3) == 1
                    let t32: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, t32)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i32\n")
                    converted_regs[j] = t32
                else
                    # alloca %T; store i64 arg into it (opaque-ptr reinterpret);
                    # load %T — this works for newtypes whose single field fits
                    # in 8 bytes.  LLVM accepts a typed-load from differently-
                    # typed alloca with opaque pointers.
                    let box_slot: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, box_slot)
                    emit_str(s, c" = alloca %")
                    emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                    emit_str(s, c"  ; newtype arg box\n")
                    emit_str(s, c"  store i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c", ptr ")
                    emit_reg(s, box_slot)
                    emit_str(s, c"\n")
                    let boxed: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, boxed)
                    emit_str(s, c" = load %")
                    emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, box_slot)
                    emit_str(s, c"\n")
                    converted_regs[j] = boxed
            else
                converted_regs[j] = arg_regs[j]
            param_ptr = param_ptr.next
        else
            converted_regs[j] = arg_regs[j]

    # Emit the call. Receiver goes in as ptr; then the converted args.
    let ret_type: i32 = fn_def.return_type
    var call_result: i32 = 0
    # AGAST #1730 — a large struct comes back through a caller-owned slot.
    var ufcs_sret: i32 = 0
    if struct_ret_uses_sret(s, ret_type, fn_def.return_type_name, fn_def.return_type_name_len) == 1
        ufcs_sret = emit_sret_call_slot(s, fn_def.return_type_name, fn_def.return_type_name_len)
    if ufcs_sret > 0
        call_result = next_reg(s)
        emit_str(s, c"  call void @")
    else if ret_type == TYPE_VOID
        emit_str(s, c"  call void @")
    else
        call_result = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, call_result)
        if ret_array_of(fn_def) != null
            emit_str(s, c" = call ")
            emit_fn_ret_llvm_type(s, fn_def)   # AGAST #2302: `[N x T]`
            emit_str(s, c" @")
        else if ret_type == TYPE_STRUCT and fn_def.return_type_name_len > 0
            # emit_llvm_type_struct routes tagged-enum Result$/Option$ to i64
            # (task-99 cluster #3).
            emit_str(s, c" = call ")
            emit_llvm_type_struct(s, TYPE_STRUCT, fn_def.return_type_name, fn_def.return_type_name_len)
            emit_str(s, c" @")
        else if ret_type == TYPE_BOOL
            # The helper is `define i1`; calling it as i64 read the return
            # register's garbage upper bits as true (AGAST #2882).
            emit_str(s, c" = call i1 @")
        else if ret_type == TYPE_I32 or ret_type == TYPE_U32
            emit_str(s, c" = call i32 @")
        else if ret_type == TYPE_I16 or ret_type == TYPE_U16
            emit_str(s, c" = call i16 @")
        else if ret_type == TYPE_I8 or ret_type == TYPE_U8
            emit_str(s, c" = call i8 @")
        else if ret_type == TYPE_MUT_REF
            emit_str(s, c" = call ptr @")
        else
            emit_str(s, c" = call i64 @")
    emit_name(s, fn_def.name, fn_def.name_len)
    emit_str(s, c"(")
    if ufcs_sret > 0
        emit_sret_attr(s, fn_def.return_type_name, fn_def.return_type_name_len)
        emit_reg(s, ufcs_sret)
        emit_str(s, c", ")
    if self_span > 0
        emit_param_llvm_type(s, fn_def.params)
        emit_str(s, c" ")
        emit_reg(s, self_span)
    else
        emit_str(s, c"ptr ")
        emit_reg(s, recv_ptr)

    # Emit the args with their parameter types
    var p: *Param = fn_def.params
    if p != null
        p = p.next  # skip receiver
    for j in 0..arg_count
        emit_str(s, c", ")
        if p != null
            emit_param_llvm_type(s, p)   # AGAST #1739
            p = p.next
        else
            emit_str(s, c"i64")
        emit_str(s, c" ")
        emit_reg(s, converted_regs[j])
    emit_str(s, c")\n")
    if ufcs_sret > 0
        emit_sret_call_result(s, call_result, ufcs_sret, fn_def.return_type_name, fn_def.return_type_name_len)

    # Register as an external so link-time lookups succeed even if monomorphization
    # instantiated this helper in a sibling module.
    add_extern(s, fn_def.name, fn_def.name_len)

    # Widen a bool or narrow int result to the i64 value model, as the
    # impl-method arm does.
    if ret_type == TYPE_MUT_REF
        let pti: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, pti)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return pti
    widen_method_result(s, call_result, ret_type)

# Tagged-enum variant constructors (ritz-task-133 rewrite).
#
# Layout (ritz0 parity, AGAST #1898):
# `%Result$... = type { i8 tag, [P x i8] pad, [N x i8] payload }` — declared
# once per instantiation by emit_tagged_enum_types in emitter.ritz; see
# tagged_enum_layout in emitter_core.
# Tag convention matches ritz0:
#   Ok   -> 0   Err  -> 1    (enum Result { Ok(T), Err(E) })
#   Some -> 0   None -> 1    (enum Option { Some(T), None })
#
# Construction shape:
#   %a = alloca %Result$T
#   %pt = getelementptr %Result$T, ptr %a, i32 0, i32 0
#   store i8 <tag>, ptr %pt
#   %pp = getelementptr %Result$T, ptr %a, i32 0, i32 2    ; [N x i8]
#   store <payload-llvm-type> %v, ptr %pp                  ; scalars at own width
#   %r = load %Result$T, ptr %a
# See emitter_match.ritz for the consumer side (extract tag, load payload).
fn is_variant_carrier(name: *u8, name_len: i32) -> i32
    if name_len == 4
        # "Some"
        if *name == 83 and *(name + 1) == 111 and *(name + 2) == 109 and *(name + 3) == 101
            return 1
    if name_len == 2
        # "Ok"
        if *name == 79 and *(name + 1) == 107
            return 1
    return 0

fn is_variant_null(name: *u8, name_len: i32) -> i32
    if name_len == 4
        # "None"
        if *name == 78 and *(name + 1) == 111 and *(name + 2) == 110 and *(name + 3) == 101
            return 1
    if name_len == 3
        # "Err"
        if *name == 69 and *(name + 1) == 114 and *(name + 2) == 114
            return 1
    return 0

# Resolve the enum name to alloca for a variant constructor.  Prefers an
# explicit context set by emit_var_decl for `let r: Result<_,_> = Ok(x)`
# bindings; falls back to the enclosing function's return type (which covers
# tail-expression returns inside a Result/Option-returning function — the
# common case).  Returns 0 when no enum context is available; callers should
# emit a defensive zero value rather than invalid IR in that case.
fn resolve_enum_ctx(s: *EmitterState, out_name: **u8, out_len: *i32) -> i32
    if s.ctx_enum_name != null
        if s.ctx_enum_name_len > 0
            if is_tagged_enum_type(s.ctx_enum_name, s.ctx_enum_name_len) == 1
                *out_name = s.ctx_enum_name
                *out_len = s.ctx_enum_name_len
                return 1
    # AGAST #1498: inside a call argument the enclosing fn's return type
    # says nothing about the argument's type — borrowing it built an
    # %Option$i64 for an Option<i32> param.
    if s.ctx_enum_arg == 1
        *out_name = null
        *out_len = 0
        return 0
    if s.ret_type_name != null
        if s.ret_type_name_len > 0
            if is_tagged_enum_type(s.ret_type_name, s.ret_type_name_len) == 1
                *out_name = s.ret_type_name
                *out_len = s.ret_type_name_len
                return 1
    *out_name = null
    *out_len = 0
    return 0

# Emit one call argument with the enum context its parameter dictates
# (AGAST #1498).  `p` is the matching callee Param, or null when unknown.
# A tagged-enum param makes a bare `Some(x)` / `None` / `Ok(x)` / `Err(x)`
# argument build that enum; any other param clears the context, so neither a
# surrounding typed let's type nor (via ctx_enum_arg) the enclosing fn's
# return type leaks into the argument.  Saved and restored like
# emit_var_decl does.
fn emit_call_arg(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    # AGAST #3005: a tuple param names a nameless tuple literal argument.
    if p != null and p.param_type == TYPE_STRUCT
        tuple_lit_name(s, arg, p.param_type_name, p.param_type_name_len)
    if p != null and param_self_is_ptr(p) == 0
        if p.param_type == TYPE_ARRAY
            return emit_array_arg_value(s, arg, p)   # AGAST #2287
        let array_addr: i32 = emit_array_arg_addr(s, arg, p)
        if array_addr != 0
            return array_addr
        let place_addr: i32 = emit_borrowed_place(s, arg, p)   # AGAST #2335
        if place_addr != 0
            return place_addr
        # The Span cascade builds its Span from the local; it reads no value.
        if param_is_span(p) == 1 and arg.kind == EXPR_IDENT
            let span_src: *LocalVar = find_local_struct_name(s, arg.ident_ptr, arg.ident_len)
            if span_src != null and span_src.var_type == TYPE_ARRAY
                return 0
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    var saved_slot: SlotCtx
    if p != null
        enter_slot_ctx(s, @saved_slot, p.param_type, p.param_type_name, p.param_type_name_len)
    else
        enter_slot_ctx(s, @saved_slot, 0, null, 0)
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    if p != null
        if p.param_type == TYPE_STRUCT and p.param_type_name_len > 0
            if is_tagged_enum_type(p.param_type_name, p.param_type_name_len) == 1 or is_enum_instance(p.param_type_name, p.param_type_name_len) == 1
                s.ctx_enum_name = p.param_type_name
                s.ctx_enum_name_len = p.param_type_name_len
    # AGAST #2279: a `c:& C` argument copies into a by-value `C` param.  A lent
    # `self` param is a `ptr` (emit_impl_method).
    var reg: i32 = 0
    if p != null and param_self_is_ptr(p) == 0
        reg = emit_expr_by_value(s, arg, p.param_type, p.param_type_name, p.param_type_name_len)
    else
        reg = emit_expr(s, arg)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, arg, reg, p)
    return reg

# AGAST #2142: emit `e`, whose value is stored into a slot of declared type
# (ty, name): an assignment target (local, `x.f`, `*p`) or a struct-literal
# field.  As emit_call_arg does for a parameter, a tagged-enum slot makes a
# bare `Some(x)` / `None` / `Rect(..)` build that enum; any other slot clears
# the context and (via ctx_enum_arg) bars the enclosing fn's return type, so
# a ctor with no enum to land in is a ritz1 error, not invalid IR.  Without
# this, `held = Some(..)` / `f.cmap = None` / `Font { cmap: Some(..) }`
# emitted `add i64 0, 0 ; variant w/ no enum ctx` and clang rejected it.
fn emit_expr_into_slot(s: *EmitterState, e: *Expr, ty: i32, name: *u8, name_len: i32) -> i32
    if ty == TYPE_STRUCT
        let referent: i32 = emit_lent_referent(s, e, name, name_len)
        if referent != 0
            return referent
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    var saved_slot: SlotCtx
    enter_slot_ctx(s, @saved_slot, ty, name, name_len)
    if ty == TYPE_STRUCT and name != null and name_len > 0
        if is_tagged_enum_type(name, name_len) == 1 or is_enum_instance(name, name_len) == 1
            s.ctx_enum_name = name
            s.ctx_enum_name_len = name_len
    var reg: i32 = emit_struct_copy(s, e, ty)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if ty == TYPE_STRUCT
        reg = coerce_array_to_span(s, e, reg, name, name_len)   # AGAST #2502
    return reg

# AGAST #2390: emit_expr_into_slot for a slot the caller stores straight into:
# an array element (`a[i] = v`, `h.a[i] = v`, `g[i] = v`) or a pointee
# (`*p = v`).  A bare "..." is a %Span$u8 (#98) and a StrView slot holds a
# %StrView, the layout-equal pair (#168): rebuild it, as the `let`, assign,
# return and struct-literal sites do, or clang refuses the store.  Kept out of
# emit_expr_into_slot itself: those sites rebuild after it, and a second
# rebuild would read a %StrView as a %Span$u8.
fn emit_store_into_slot(s: *EmitterState, e: *Expr, ty: i32, name: *u8, name_len: i32) -> i32
    let reg: i32 = emit_expr_into_slot(s, e, ty, name, name_len)
    if ty != TYPE_STRUCT or name == null or name_len <= 0
        return reg
    return coerce_struct_ret_value(s, e, reg, name, name_len)

# AGAST #2502: the `[N]T` local `@e` names when `e` is `@a` and the slot
# (name, name_len) is a `Span<T>` / `[T]` (one type since #1614); else null.
fn span_array_source(s: *EmitterState, e: *Expr, name: *u8, name_len: i32) -> *LocalVar
    if e == null or name == null or name_len <= 5
        return null
    if memcmp(name, c"Span$", 5) != 0
        return null
    if e.kind != EXPR_UNARY or e.op != OP_ADDR or e.operand == null
        return null
    if e.operand.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.operand.ident_ptr, e.operand.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY
        return null
    return loc

# AGAST #2502: `reg` is `e`'s value headed for a `Span<T>` / `[T]` slot.  When
# `e` is `@a` over an `[N]T` local, that value is `@a`'s address as an i64,
# which no Span slot holds: build `Span { &a[0], N }` instead, as the Span
# parameter cascade in emit_expr_call does (ritz-task-102).  A `let` / `var`
# initialiser, an assignment and a struct-literal field emitted
# `store %Span$u8 <i64>` and clang rejected it.  Any other `e`: `reg`.
fn coerce_array_to_span(s: *EmitterState, e: *Expr, reg: i32, name: *u8, name_len: i32) -> i32
    let loc: *LocalVar = span_array_source(s, e, name, name_len)
    if loc == null
        return reg
    span_array_elem_fits(s, e, loc, name, name_len)   # AGAST #2781
    return emit_span_of_array(s, loc, name, name_len)

# AGAST #2781, #2366: `@a` with `a: [N]T1` fits the `Span$T2` slot (name,
# name_len) only when T1 is T2, or the Span views the array at T2's stride.  The
# array-store rule (LARB R5, #2343): the same located error as ritz0, at `e`.
# Compared as monomorphisation spells T: `u8`, a struct's name, `ptr_u8`.  An
# element this can't spell (a deeper pointer, a nested array) isn't judged.
fn span_array_elem_fits(s: *EmitterState, e: *Expr, loc: *LocalVar, name: *u8, name_len: i32) -> i32
    if loc.array_shape != null
        return 1
    var elem: *u8 = null
    var elem_len: i32 = 0
    var ptr_prefix: i32 = 0
    if loc.array_elem_type == TYPE_STRUCT
        elem = loc.type_name
        elem_len = loc.type_name_len
    else if loc.array_elem_type == TYPE_PTR
        elem_len = primitive_arg_spelling(loc.array_elem_pointee, @elem)
        ptr_prefix = 4
    else
        elem_len = primitive_arg_spelling(loc.array_elem_type, @elem)
    if elem == null or elem_len <= 0
        return 1
    # name is `Span$` + [`ptr_`] + elem.
    if name_len == 5 + ptr_prefix + elem_len
        if ptr_prefix == 0 or memcmp(name + 5, c"ptr_", 4) == 0
            if memcmp(name + 5 + ptr_prefix, elem, elem_len as i64) == 0
                return 1
    ref_array_error(s, e)
    0

# `Span { &a[0], N }` of the `[N]T` local `loc`, as a `%<span_name>` register.
fn emit_span_of_array(s: *EmitterState, loc: *LocalVar, span_name: *u8, span_name_len: i32) -> i32
    let elem0: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem0)
    emit_str(s, c" = getelementptr [")
    emit_int(s, loc.array_size as i64)
    emit_str(s, c" x ")
    if loc.array_elem_type == TYPE_I32 or loc.array_elem_type == TYPE_U32
        emit_str(s, c"i32")
    else if loc.array_elem_type == TYPE_I64 or loc.array_elem_type == TYPE_U64
        emit_str(s, c"i64")
    else if loc.array_elem_type == TYPE_U8 or loc.array_elem_type == TYPE_I8
        emit_str(s, c"i8")
    else if loc.array_elem_type == TYPE_U16 or loc.array_elem_type == TYPE_I16
        emit_str(s, c"i16")
    else if loc.array_elem_type == TYPE_PTR or loc.array_elem_type == TYPE_PTR_PTR
        emit_str(s, c"ptr")
    else
        emit_str(s, c"i64")
    emit_str(s, c"], ptr ")
    emit_reg(s, loc.reg)
    emit_str(s, c", i64 0, i64 0\n")
    let sp1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sp1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, span_name, span_name_len)
    emit_str(s, c" undef, ptr ")
    emit_reg(s, elem0)
    emit_str(s, c", 0\n")
    let sp2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, sp2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, span_name, span_name_len)
    emit_str(s, c" ")
    emit_reg(s, sp1)
    emit_str(s, c", i64 ")
    emit_int(s, loc.array_size as i64)
    emit_str(s, c", 1\n")
    return sp2

# The `name:& T` param `e` names, or null (LocalVar.is_lent, AGAST #2250).
fn lent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.is_lent == 0
        return null
    return loc

# AGAST #2287, #2302: an `-> [N]T` callee whose `[N x T]` isn't known (no
# ret_array_param) has no array return: the i64 it would come back in is no
# array.  1 once refused.  Every parsed `-> [N]T` has one; this fails closed.
fn refuse_array_return(s: *EmitterState, e: *Expr, callee: *FnDef) -> i32
    if callee == null or callee.return_type != TYPE_ARRAY or ret_array_of(callee) != null
        return 0
    emit_whole_array_error(s, e)
    1

# AGAST #2287: the `[N x T]` value of `arg` for by-value array param `p`.  As in
# ritz0, `g(p)` and `g(@a)` read through the pointer.  Each value is copied into
# a fresh `[N x T]` by emit_array_local_whole_assign, whose checks it gets, so
# it is what `let b: [N]T = arg` accepts.  The next argument can't change it.
fn emit_array_arg_value(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    var value: *Expr = arg
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        value = arg.operand
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_param_llvm_type(s, p)
    emit_str(s, c"  ; #2287 array arg\n")
    let ptr_loc: *LocalVar = array_ptr_local(s, value)
    if ptr_loc != null and ptr_loc.is_lent == 0
        emit_array_ptr_arg_copy(s, value, ptr_loc, slot, p)
    else
        emit_array_local_whole_assign(s, slot, p.param_array_size, p.param_array_elem_type, p.param_type_name, p.param_type_name_len, value)
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load ")
    emit_param_llvm_type(s, p)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    return val

# `g(p)` with `p: *[N]T` into a by-value `[N]T`: the array behind the pointer.
fn emit_array_ptr_arg_copy(s: *EmitterState, value: *Expr, loc: *LocalVar, slot: i32, p: *Param)
    if loc.pointee_array_size != p.param_array_size
        emit_ir_error(s, c"array length does not match the local array's length")
        return
    if array_store_fits(s, value, loc.pointee_array_elem_type, loc.type_name, loc.type_name_len, p.param_array_elem_type, p.param_type_name, p.param_type_name_len) == 0
        return
    emit_local_array_copy(s, p.param_array_size, p.param_array_elem_type, p.param_type_name, p.param_type_name_len, emit_load_ptr(s, loc.reg), slot)

# 1 when `p` takes an array by address: `a:& [N]T`, `a: @[N]T`, `a: @&[N]T`.
# `*[N]T` doesn't: ritz0 refuses `g(a)` there.
fn param_takes_array_ref(p: *Param) -> i32
    if p.param_type != TYPE_REF and p.param_type != TYPE_MUT_REF
        return 0
    if p.param_pointee_type == TYPE_ARRAY
        return 1
    0

# 1 when `arg` came back from emit_call_arg as an address, for `@&T` param `p` of
# a cascade that otherwise leaves its value alone.
fn param_takes_addr_value(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if p.param_type != TYPE_MUT_REF
        return 0
    if param_takes_array_ref(p) == 1
        return 1
    if borrow_arg_kind(s, arg, p) == BORROW_PLACE
        return 1
    0

# AGAST #2287: `g(a)` with `a` a whole array, into a param that takes it by
# address: the address, as an i64 like `g(@a)`, which the arg cascades turn into
# what the param is.  This argument used to read the array's first 8 bytes and
# hand them to the callee as a pointer.  0 when `arg` is anything else.
fn emit_array_arg_addr(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if param_takes_array_ref(p) == 0
        return 0
    var ptr: i32 = 0
    var place: ArraySrc
    # AGAST #2290: a reborrow.  An `@[N]T` slot is an i64; the `ptr` slots take
    # the pointer it reads as.
    if lent_local(s, arg) != null
        let lent: *LocalVar = lent_array_ident(s, arg)
        if lent == null or p.param_type != TYPE_REF
            return 0
        ptr = lent.reg
    else if array_place_shape(s, arg, @place) == 1
        ptr = emit_array_place_ptr(s, arg)
    else if arg.kind == EXPR_MEMBER and arg_field_is_array(s, arg) == 1
        var mr: MemberPtrResult
        emit_member_ptr(s, arg, @mr)
        ptr = mr.reg
    if ptr == 0
        return 0
    let addr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, addr)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, ptr)
    emit_str(s, c" to i64  ; #2287 array by address\n")
    return addr

fn arg_field_is_array(s: *EmitterState, arg: *Expr) -> i32
    let f: *StructField = member_field_def(s, arg)
    if f == null or f.field_type != TYPE_ARRAY or f.array_shape != null
        return 0
    1

# AGAST #2250: `e` read into a by-value slot of struct `name`.  `c:& C` reads
# as the pointer, but the slot holds a `C`, so a `c:& C` param of that type
# copies its referent here: the aggregate register, as emit_expr gives for any
# other struct value.  0 when `e` is anything else.  `c:& [2]C` names `C` as
# well: an array is no `C`, so it stays the pointer, which clang refuses.
fn emit_lent_referent(s: *EmitterState, e: *Expr, name: *u8, name_len: i32) -> i32
    let loc: *LocalVar = lent_local(s, e)
    if loc == null or loc.var_type == TYPE_ARRAY
        return 0
    if name_eq(loc.type_name, loc.type_name_len, name, name_len) == 0
        return 0
    own_check_lent_read(s, e, name, name_len)
    let src: i32 = emit_expr(s, e)
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, src)
    emit_str(s, c"\n")
    return val

# AGAST #2288: the `c:& C` param `e` names, when C is a struct, or null.  A
# by-value read with no slot type at hand (an if / match arm, a `c as C`)
# takes C from the param itself: an integer T is already a plain local and
# `a:& [N]T` an array one.
fn lent_referent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_local(s, e)
    if loc == null or loc.var_type != TYPE_MUT_REF or loc.pointee_type != TYPE_STRUCT
        return null
    return loc

# AGAST #2279: `return c` or a tail `c` with `c:& C` in a fn returning `C`: the
# value is the referent.  Emits the `ret` and returns 1; 0 when `e` is anything
# else.  Only s.ret_type_name's slot reads it.
# AGAST #2302: `return e` / a tail `e` in a `-> [N]T` fn, whose return `ra` is
# that type as a param.  As ritz0, the return is a first-class `[N x T]`: `e` is
# copied into a fresh one by emit_array_local_whole_assign, whose checks it
# gets (so it returns what `let b: [N]T = e` accepts), and that is loaded and
# returned.  Returns 1 when `ra` is non-null, i.e. when this was the return.
fn emit_array_return(s: *EmitterState, e: *Expr, ra: *Param) -> i32
    if ra == null
        return 0
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_param_llvm_type(s, ra)
    emit_str(s, c"  ; #2302 array return\n")
    emit_array_local_whole_assign(s, slot, ra.param_array_size, ra.param_array_elem_type, ra.param_type_name, ra.param_type_name_len, e)
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load ")
    emit_param_llvm_type(s, ra)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n  ret ")
    emit_param_llvm_type(s, ra)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c"\n")
    1

fn emit_lent_return(s: *EmitterState, e: *Expr, ret_type: i32) -> i32
    if ret_type != TYPE_STRUCT
        return 0
    let val: i32 = emit_lent_referent(s, e, s.ret_type_name, s.ret_type_name_len)
    if val == 0
        return 0
    if s.ret_sret == 1
        emit_sret_ret_value(s, val)   # AGAST #1730
        return 1
    emit_str(s, c"  ret ")
    emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c"\n")
    return 1

# AGAST #2279: the local `e` names, when its slot can be loaded as the struct a
# fn returns; null otherwise.  A pointer or reference slot holds an address and
# an array slot its first element, so loading either as the struct is a silent
# wrong value.  They take the generic path, whose mismatch clang refuses.
fn struct_value_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null
        return null
    let t: i32 = loc.var_type
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF or t == TYPE_ARRAY
        return null
    return loc

# AGAST #2279: the `a:& [N]T` param `e` names, read whole, or null.  It's an
# array local whose slot is the array behind the borrow (#2290).  A move-only T
# is reported here, as emit_lent_referent does; the caller still checks the
# slot's length and element type.
fn lent_array_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_array_ident(s, e)
    if loc == null
        return null
    own_check_lent_read(s, e, loc.type_name, loc.type_name_len)
    return loc

# emit_expr for a by-value slot of type `ty` whose enum context, if any, the
# caller has set: a `let` or a parameter (#2279).  An array element (#2250) is
# emit_expr_into_slot's, which sets the element's enum (AGAST #2454).
fn emit_expr_by_value(s: *EmitterState, e: *Expr, ty: i32, name: *u8, name_len: i32) -> i32
    if ty == TYPE_STRUCT
        let referent: i32 = emit_lent_referent(s, e, name, name_len)
        if referent != 0
            return referent
    return emit_struct_copy(s, e, ty)

# emit_expr, with `e` marked as a copy into a struct slot when `ty` is one (#2330).
fn emit_struct_copy(s: *EmitterState, e: *Expr, ty: i32) -> i32
    let saved: *Expr = s.struct_copy_expr
    if ty == TYPE_STRUCT
        s.struct_copy_expr = e
    let reg: i32 = emit_expr(s, e)
    s.struct_copy_expr = saved
    return reg

# emit_expr_into_slot for a struct field.
fn emit_expr_into_field(s: *EmitterState, e: *Expr, field: *StructField) -> i32
    return emit_expr_into_slot(s, e, field.field_type, field.field_type_name, field.field_type_name_len)

# AGAST #1948: the struct a pointer-to-struct param points at, or null.
# `p: *T`, `p: @T` and `p: @&T` qualify (not the auto-deref `p:& T` borrow,
# whose argument is a value), and only when T names a struct the module
# defines: a primitive pointee, or a name that resolves to nothing, says
# nothing checkable.
fn param_pointee_struct(s: *EmitterState, p: *Param, out_len: *i32) -> *u8
    *out_len = 0
    if p == null or p.is_borrow == 1 or p.param_type_name_len <= 0
        return null
    if p.param_type != TYPE_PTR and p.param_type != TYPE_REF and p.param_type != TYPE_MUT_REF
        return null
    if p.param_pointee_type != TYPE_STRUCT
        return null
    if find_struct(s, p.param_type_name, p.param_type_name_len) == null
        return null
    *out_len = p.param_type_name_len
    return p.param_type_name

# AGAST #1948: the struct an argument expression statically points at, or
# null when it is not one of the shapes whose pointee ritz1 knows for sure:
#   `@x` / `@&x`     x a struct-typed local, or a struct-typed field chain;
#   `x`              x a local declared `*T` / `@T` / `@&T` with T a struct.
# Anything else (casts, calls, arithmetic, globals) answers null: the check
# fails OPEN on shapes it cannot type, never by guessing.
fn arg_pointee_struct(s: *EmitterState, arg: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if arg == null
        return null
    var name: *u8 = null
    var len: i32 = 0
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        let x: *Expr = arg.operand
        if x == null
            return null
        if x.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
            if loc == null or (loc.var_type != TYPE_STRUCT and lent_struct_local(s, x) == null)
                return null
            name = loc.type_name
            len = loc.type_name_len
        else if x.kind == EXPR_MEMBER
            let f: *StructField = member_field_def(s, x)
            if f == null or f.field_type != TYPE_STRUCT
                return null
            name = f.field_type_name
            len = f.field_type_name_len
        else
            return null
    else if arg.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, arg.ident_ptr, arg.ident_len)
        if loc == null
            return null
        if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
            return null
        if loc.pointee_type != TYPE_STRUCT
            return null
        name = loc.type_name
        len = loc.type_name_len
    else
        return null
    if name == null or len <= 0
        return null
    if find_struct(s, name, len) == null
        return null
    *out_len = len
    return name

# `error: file:line:col: argument N of `f` has the wrong type: `, as ritz0 words
# it; the caller finishes the line and counts the error.
fn eprint_arg_type_error(call: *Expr, fname: *u8, flen: i32, argno: i32)
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_int(call.span.line as i64)
    eprint_char(':')
    eprint_int(call.span.col as i64)
    eprints_cstr(c": argument ")
    eprint_int(argno as i64)
    eprints_cstr(c" of `")
    for i in 0..flen
        eprint_char(*(fname + i))
    eprints_cstr(c"` has the wrong type: ")

fn array_arg_error(s: *EmitterState, call: *Expr, fname: *u8, flen: i32, argno: i32, why: *u8)
    emit_str(s, c"  ; ERROR: whole array argument mismatch (AGAST #2287)\n")
    eprint_arg_type_error(call, fname, flen, argno)
    eprints_cstr(why)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# 1 when `p` is a `Span<T>`: emit_expr_call builds one from a local array.
fn param_is_span(p: *Param) -> i32
    if p.param_type != TYPE_STRUCT or p.param_type_name == null or p.param_type_name_len <= 5
        return 0
    return (memcmp(p.param_type_name, c"Span$", 5) == 0) as i32

# AGAST #2290: every dimension of an array, for comparing one with the array a
# reference param points at.  `leaf` is what the innermost dimension holds.
struct ArrayDims
    rank: i32
    dims: [8]i32
    leaf: i32
    name: *u8
    name_len: i32

# What ref_arg_dims can say about an argument.
const ARG_DIMS_UNKNOWN: i32 = 0
const ARG_DIMS_ARRAY: i32 = 1
const ARG_DIMS_NOT_ARRAY: i32 = 2

fn array_dims_1d(out: *ArrayDims, size: i32, elem: i32, name: *u8, name_len: i32) -> i32
    out.rank = 1
    out.dims[0] = size
    out.leaf = elem
    out.name = name
    out.name_len = name_len
    ARG_DIMS_ARRAY

# The array left of `sh` once `from` indices are applied.  With none left it's
# an element.
fn array_dims_nd(out: *ArrayDims, sh: *ArrayShape, from: i32) -> i32
    if from >= sh.rank
        return ARG_DIMS_NOT_ARRAY
    out.rank = sh.rank - from
    var i: i32 = 0
    while i < out.rank
        out.dims[i] = sh.dims[from + i]
        i = i + 1
    out.leaf = sh.leaf_type
    out.name = sh.leaf_name
    out.name_len = sh.leaf_name_len
    ARG_DIMS_ARRAY

fn array_dims_match(a: *ArrayDims, b: *ArrayDims) -> i32
    if a.rank != b.rank
        return 0
    var i: i32 = 0
    while i < a.rank
        if a.dims[i] != b.dims[i]
            return 0
        i = i + 1
    return array_elem_types_match(a.leaf, a.name, a.name_len, b.leaf, b.name, b.name_len)

# What the place `value` holds: its array's dimensions in `out`, or that it's no
# array, or ARG_DIMS_UNKNOWN when ritz1 can't tell from here.  Emits nothing.
fn place_array_dims(s: *EmitterState, value: *Expr, out: *ArrayDims) -> i32
    var src: ArraySrc
    if arg_array_shape(s, value, @src) == 1
        return array_dims_1d(out, src.size, src.elem, src.name, src.name_len)
    if value.kind == EXPR_IDENT
        let sh: *ArrayShape = nd_array_ident_shape(s, value)
        if sh != null
            return array_dims_nd(out, sh, 0)
        if find_local_struct_name(s, value.ident_ptr, value.ident_len) != null or find_global(s, value.ident_ptr, value.ident_len) != null
            return ARG_DIMS_NOT_ARRAY
        return ARG_DIMS_UNKNOWN
    if value.kind == EXPR_MEMBER
        let msh: *ArrayShape = nd_array_member_shape(s, value)
        if msh != null
            return array_dims_nd(out, msh, 0)
        let f: *StructField = member_field_def(s, value)
        if f != null and f.field_type != TYPE_ARRAY
            return ARG_DIMS_NOT_ARRAY
        return ARG_DIMS_UNKNOWN
    if value.kind == EXPR_INDEX
        var depth: i32 = 0
        let ish: *ArrayShape = nd_index_shape(s, value, @depth)
        if ish != null
            return array_dims_nd(out, ish, depth)
        # An element of a 1-D array.
        var base: ArrayDims
        if value.left.kind != EXPR_INDEX and place_array_dims(s, value.left, @base) == ARG_DIMS_ARRAY
            return ARG_DIMS_NOT_ARRAY
    ARG_DIMS_UNKNOWN

# What `arg` points at, for a param that takes an array by address.
fn ref_arg_dims(s: *EmitterState, arg: *Expr, out: *ArrayDims) -> i32
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        return place_array_dims(s, arg.operand, out)
    if arg.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, arg.ident_ptr, arg.ident_len)
        if loc != null and loc.var_type != TYPE_ARRAY
            let ploc: *LocalVar = array_ptr_local(s, arg)
            if ploc != null
                var en_len: i32 = 0
                let en: *u8 = array_ptr_elem_name(ploc, @en_len)   # #2548
                return array_dims_1d(out, ploc.pointee_array_size, ploc.pointee_array_elem_type, en, en_len)
            if loc.is_lent == 1
                return ARG_DIMS_NOT_ARRAY
            # AGAST #2323: `let p: @[N]T = @a` and `var p = @a` record N and T,
            # and array_ptr_local answered for them.  A pointer local whose
            # pointee is known and no array (`p: *i32`, `*u8`, `**T`, `@S`) is
            # what ritz0 refuses: `a[i]` in the callee would read past it.  One
            # that records no pointee, or an array without its N, says nothing.
            if loc.var_type == TYPE_PTR or loc.var_type == TYPE_PTR_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
                if loc.pointee_type == TYPE_ARRAY or loc.pointee_type == TYPE_UNKNOWN or loc.pointee_type == TYPE_VOID
                    return ARG_DIMS_UNKNOWN
                return ARG_DIMS_NOT_ARRAY
    return place_array_dims(s, arg, out)

# The array `p`, an `@[N]T` or the like, points at.
fn param_pointee_dims(out: *ArrayDims, p: *Param)
    if p.param_pointee_array_shape != null
        array_dims_nd(out, p.param_pointee_array_shape, 0)
    else
        array_dims_1d(out, p.param_pointee_array_size, p.param_pointee_array_elem_type, p.param_type_name, p.param_type_name_len)

# AGAST #2290: `a[i]` in the callee trusts the N and T its param declares, so an
# argument that isn't that array is an out-of-bounds access there.  ritz0 checks
# them by type; ritz1 checks what it can see from the argument.
fn check_array_ref_arg(s: *EmitterState, call: *Expr, fname: *u8, flen: i32, argno: i32, arg: *Expr, p: *Param)
    var got: ArrayDims
    let known: i32 = ref_arg_dims(s, arg, @got)
    if known == ARG_DIMS_UNKNOWN
        return
    if known == ARG_DIMS_NOT_ARRAY
        array_arg_error(s, call, fname, flen, argno, c"the parameter points at an array")
        return
    var want: ArrayDims
    param_pointee_dims(@want, p)
    if array_dims_match(@got, @want) == 0
        array_arg_error(s, call, fname, flen, argno, c"the array isn't the one the parameter points at")

# Fill `out` when `arg` is a whole 1-D array, as a place or an inline field.
fn arg_array_shape(s: *EmitterState, arg: *Expr, out: *ArraySrc) -> i32
    if array_place_shape(s, arg, out) == 1
        return 1
    if arg.kind == EXPR_MEMBER and arg_field_is_array(s, arg) == 1
        let f: *StructField = member_field_def(s, arg)
        return array_src_set(out, f.array_size, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len)
    0

# AGAST #2287: a whole array argument has to fit its param, as in ritz0, which
# checks it by LLVM type.  A by-value `[N]T` takes the same length (the copy
# checks the element); `a:& [N]T`, `@[N]T` and `@&[N]T` the same array, since an
# address can't convert; a Span<T> any length.  Everything else refuses it:
# `*i32` and `*[N]T` included, where this used to pass the first 8 bytes.  That
# goes for `a:& [N]T` too, which ritz0 reads as the array here.
fn check_array_arg(s: *EmitterState, call: *Expr, fname: *u8, flen: i32, argno: i32, arg: *Expr, p: *Param)
    if p == null or name_eq(p.name, p.name_len, c"self", 4) == 1
        return
    if check_borrow_arg(s, fname, flen, argno, arg, p) == 1
        return
    let literal: i32 = (arg.kind == EXPR_ARRAY_LIT or arg.kind == EXPR_ARRAY_FILL) as i32
    if literal == 0 and param_takes_array_ref(p) == 1
        check_array_ref_arg(s, call, fname, flen, argno, arg, p)
        return
    var src: ArraySrc
    if literal == 0 and arg_array_shape(s, arg, @src) == 0
        return
    if p.param_type == TYPE_ARRAY
        if literal == 0 and src.size != p.param_array_size
            array_arg_error(s, call, fname, flen, argno, c"the array's length isn't the parameter's")
        return
    if param_is_span(p) == 1
        return
    if param_takes_array_ref(p) == 0
        array_arg_error(s, call, fname, flen, argno, c"the parameter doesn't take a whole array")
        return
    array_arg_error(s, call, fname, flen, argno, c"an array literal has no address to pass")

# AGAST #2335: what a bare argument to a `name:& T` param is.  LARB R1's second
# exception: a place of type `T` is borrowed, as if written `@&x`, the language's
# only implicit borrow, for every T.  What isn't a place of `T` passes if it's a
# pointer to one (an `@&T` or a `*T`), whether a place or a call result.  An
# rvalue is refused: there's nothing for the caller to observe.
const BORROW_PASS: i32 = 0      # as it's written, by the value paths
const BORROW_PLACE: i32 = 1     # a place of `T`: its address
const BORROW_RVALUE: i32 = 2
const BORROW_MISFIT: i32 = 3    # a place of something else
const BORROW_UNTYPED: i32 = 4   # an argument ritz1 can't type from here
const BORROW_SHARED: i32 = 5    # reached through an `@T`, which is read-only

# The type of a place, as far as ritz1 can tell without emitting it.  `name` is
# a struct's, or for a pointer the struct it points at.
struct PlaceType
    kind: i32
    pointee: i32
    name: *u8
    name_len: i32

fn place_type_set(out: *PlaceType, kind: i32, pointee: i32, name: *u8, name_len: i32) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = name_len
    1

fn kind_is_pointer(t: i32) -> i32
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return 1
    0

# What `*x` gives, for `x` of type `base`.
fn place_deref_type(base: *PlaceType, out: *PlaceType) -> i32
    var held: i32 = TYPE_UNKNOWN
    if base.name_len > 0
        held = TYPE_STRUCT
    if base.kind == TYPE_PTR_PTR
        return place_type_set(out, TYPE_PTR, held, base.name, base.name_len)
    if kind_is_pointer(base.kind) == 0
        return 0
    return place_type_set(out, base.pointee, held, base.name, base.name_len)

# What `x[i]` gives.  The array shapes know what they hold; a pointer is `*x`.
fn place_index_type(s: *EmitterState, value: *Expr, out: *PlaceType) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, value, @depth)
    if sh != null
        if depth < sh.rank
            return place_type_set(out, TYPE_ARRAY, TYPE_UNKNOWN, sh.leaf_name, sh.leaf_name_len)
        return place_type_set(out, sh.leaf_type, TYPE_UNKNOWN, sh.leaf_name, sh.leaf_name_len)
    var src: ArraySrc
    if arg_array_shape(s, value.left, @src) == 1
        var held: i32 = TYPE_UNKNOWN
        if src.name_len > 0
            held = TYPE_STRUCT
        return place_type_set(out, src.elem, held, src.name, src.name_len)
    var base: PlaceType
    if place_type_of(s, value.left, @base) == 0
        return 0
    return place_deref_type(@base, out)

# The field `e` names on a base member_field_def can't see through: `a[i].f`,
# `(*c).f`.  Null when the base is no struct, or a pointer to one.
fn place_field_def(s: *EmitterState, e: *Expr) -> *StructField
    var base: PlaceType
    if place_type_of(s, e.left, @base) == 0 or base.name_len <= 0
        return null
    let st: *StructDef = find_struct(s, base.name, base.name_len)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    get_field_type(st, idx)

# 1 and `out` when ritz1 can type the place `e`.
fn place_type_of(s: *EmitterState, e: *Expr, out: *PlaceType) -> i32
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null
            return place_type_set(out, loc.var_type, loc.pointee_type, loc.type_name, loc.type_name_len)
        let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if g == null
            return 0
        if kind_is_pointer(g.var_type) == 1
            return place_type_set(out, g.var_type, g.pointee_type, g.pointee_type_name, g.pointee_type_name_len)
        return place_type_set(out, g.var_type, TYPE_UNKNOWN, g.type_name, g.type_name_len)
    if e.kind == EXPR_MEMBER
        var f: *StructField = member_field_def(s, e)
        if f == null
            f = place_field_def(s, e)
        if f == null
            return 0
        return place_type_set(out, f.field_type, ptr_field_elem_kind(f), f.field_type_name, f.field_type_name_len)
    if e.kind == EXPR_INDEX
        return place_index_type(s, e, out)
    if e.kind == EXPR_UNARY and e.op == OP_DEREF
        var base: PlaceType
        var pointer: *Expr = e.operand
        if pointer.kind == EXPR_BINARY
            pointer = find_base_expr(pointer)
        if place_type_of(s, pointer, @base) == 0
            return 0
        return place_deref_type(@base, out)
    0

# 1 when `e` is a place: it names storage the caller can see afterwards.
fn arg_is_place(s: *EmitterState, e: *Expr) -> i32
    var root: *Expr = e
    while root.kind == EXPR_MEMBER or root.kind == EXPR_INDEX
        if root.kind == EXPR_INDEX and root.right != null and root.right.kind == EXPR_RANGE
            return 0
        root = root.left
    if root.kind == EXPR_UNARY and root.op == OP_DEREF
        return 1
    if root.kind == EXPR_IDENT
        if find_local_struct_name(s, root.ident_ptr, root.ident_len) != null
            return 1
        return (find_global(s, root.ident_ptr, root.ident_len) != null) as i32
    # A field or element of a call result: `@&g().x` isn't lowered either.
    0

# The struct a method receiver names (by value or through a pointer), or
# null when ritz1 cannot type it without emitting it.
# 1 when `recv` names no value, so it's the type of a static call.
fn method_recv_is_type(s: *EmitterState, recv: *Expr) -> i32
    if recv == null or recv.kind != EXPR_IDENT
        return 0
    if find_local_struct_name(s, recv.ident_ptr, recv.ident_len) != null
        return 0
    return (find_global(s, recv.ident_ptr, recv.ident_len) == null) as i32

# AGAST #2296: `Span.empty()`, whose receiver is the type `Span` and whose T
# is never spelled: the slot it lands in names the `Span$T` (slot_struct_name),
# and the value is `{ null, 0 }` without ritzlib.span, as in ritz0's
# _try_emit_associated_builtin_call.  With no `Span$T` slot it is a located
# refusal, ritz0's text.  -1 when `e` isn't a call on the type `Span`.
fn try_emit_span_assoc(s: *EmitterState, e: *Expr) -> i32
    let recv: *Expr = e.left
    if recv == null or recv.kind != EXPR_IDENT or name_eq(recv.ident_ptr, recv.ident_len, c"Span", 4) == 0
        return 0 - 1
    if method_recv_is_type(s, recv) == 0
        return 0 - 1
    var tlen: i32 = 0
    let tname: *u8 = slot_struct_name(s, @tlen)
    if tname == null or tlen <= 5 or memcmp(tname, c"Span$", 5) != 0
        return emit_qualified_variant_error(s, e, c"needs its type argument from the slot it lands in: a `-> Span<T>` return, a `let s: Span<T>` or a `Span<T>` parameter")
    if name_eq(e.ident_ptr, e.ident_len, c"empty", 5) == 0 or e.args != null
        return 0 - 1
    let half: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, half)
    emit_str(s, c" = insertvalue %")
    emit_name(s, tname, tlen)
    emit_str(s, c" undef, ptr null, 0  ; Span.empty()\n")
    let out: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, out)
    emit_str(s, c" = insertvalue %")
    emit_name(s, tname, tlen)
    emit_str(s, c" ")
    emit_reg(s, half)
    emit_str(s, c", i64 0, 1\n")
    return out

fn method_recv_type(s: *EmitterState, recv: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if recv == null
        return null
    if recv.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, recv.ident_ptr, recv.ident_len)
        if loc != null
            *out_len = loc.type_name_len
            return loc.type_name
        let g: *GlobalVarDef = find_global(s, recv.ident_ptr, recv.ident_len)
        if g != null
            *out_len = g.type_name_len
            return g.type_name
        # `S.make(..)`: a static method's receiver is the type.
        *out_len = recv.ident_len
        return recv.ident_ptr as *u8
    if recv.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, recv)
        if f == null
            return null
        *out_len = f.field_type_name_len
        return f.field_type_name
    return null

# The function a method call dispatches to (UFCS helper, impl method or
# specialized generic impl method), or null.
fn method_call_def(s: *EmitterState, e: *Expr) -> *FnDef
    var tlen: i32 = 0
    let tname: *u8 = method_recv_type(s, e.left, @tlen)
    if tname == null or tlen <= 0
        return null
    return method_callee_def(s, tname, tlen, e.ident_ptr, e.ident_len)

# AGAST #2394: 1 when the call or method `arg` already returns an address
# (`-> @T`, `-> @&T` or `-> *T`, all i64 at a call), so an `@T` param takes
# its result as is.  Only a `-> T` struct result is a value to spill and
# auto-borrow: `sid(sid(p))` spilled sid's `@C` as a `%C` and clang refused it.
fn call_returns_address(s: *EmitterState, arg: *Expr) -> i32
    var t: i32 = get_expr_type(s, arg)
    # get_expr_type types a method's float result only.
    if arg.kind == EXPR_METHOD
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return 0
        t = m.return_type
    (t == TYPE_REF or t == TYPE_MUT_REF or t == TYPE_PTR) as i32

# What `arg`, no place, does for `p`: it passes if it's the pointer `p` is.
fn rvalue_borrow_kind(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if arg.kind == EXPR_NIL_LIT or arg.kind == EXPR_CSTRING_LIT
        return BORROW_RVALUE
    var t: i32 = get_expr_type(s, arg)
    # get_expr_type types a method's float result only.
    if arg.kind == EXPR_METHOD
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return BORROW_UNTYPED
        t = m.return_type
    if t == TYPE_REF
        return BORROW_SHARED
    if p.param_pointee_type == TYPE_PTR
        if t == TYPE_PTR_PTR
            return BORROW_PASS
    else if kind_is_pointer(t) == 1
        return BORROW_PASS
    BORROW_RVALUE

# 1 when pointer place `pl` is the `*U` that `p`, a `:& *U`, borrows.
fn pointer_place_fits(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    let want: i32 = p.param_ref_ptr_pointee
    # Unrecorded on one side: nothing to compare, as check_struct_ptr_arg.
    if want == TYPE_VOID or pl.pointee == TYPE_UNKNOWN
        return 1
    # AGAST #3101: `r:& T` at T = `*[N]E` takes a `*[N]E` place: the same N
    # and E, as ritz0 compares `[3 x i32]**` with `[2 x i32]**`.
    if want == TYPE_ARRAY and p.param_pointee_array_size > 0
        if pl.pointee != TYPE_ARRAY
            return 0
        var got: ArrayDims
        if ref_arg_dims(s, arg, @got) != ARG_DIMS_ARRAY
            return 1
        var dims: ArrayDims
        param_pointee_dims(@dims, p)
        return array_dims_match(@got, @dims)
    if want == TYPE_STRUCT or pl.pointee == TYPE_STRUCT
        return (want == pl.pointee and name_eq(p.param_type_name, p.param_type_name_len, pl.name, pl.name_len) == 1) as i32
    # Exactly, as place_fits_borrow: a `*u32` isn't the `*i32` (#2530).
    return (want == pl.pointee) as i32

# 1 when the place `arg`, of type `pl`, holds the `T` of `p`: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `:& u32` doesn't take an `i32` (#2530).
fn place_fits_borrow(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    let pt: i32 = p.param_pointee_type
    if pl.kind != TYPE_ARRAY and pl.kind != TYPE_STRUCT
        # AGAST #2994: a `bool` local or param is a `bool`, though its slot is
        # kept as an i64, as ref_bool_local; so it fits no `:& i64` either.
        if arg.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, arg.ident_ptr, arg.ident_len)
            if loc != null and loc.is_bool == 1
                return (pt == TYPE_BOOL) as i32
        return (pl.kind == pt) as i32
    if pl.kind == TYPE_STRUCT
        return (pt == TYPE_STRUCT and name_eq(p.param_type_name, p.param_type_name_len, pl.name, pl.name_len) == 1) as i32
    if pl.kind == TYPE_ARRAY
        if pt != TYPE_ARRAY
            return 0
        var got: ArrayDims
        var want: ArrayDims
        if place_array_dims(s, arg, @got) != ARG_DIMS_ARRAY
            return 0
        param_pointee_dims(@want, p)
        return array_dims_match(@got, @want)
    0

# AGAST #2354: 1 when `arg` names a by-value `@&U` param of the fn being emitted.
fn ident_is_ref_param(arg: *Expr) -> i32
    let f: *FnDef = emitter_current_fn()
    if arg.kind != EXPR_IDENT or f == null
        return 0
    var q: *Param = f.params
    while q != null
        if q.param_type == TYPE_MUT_REF and q.is_borrow == 0 and name_eq(q.name, q.name_len, arg.ident_ptr, arg.ident_len) == 1
            return 1
        q = q.next
    0

# What a pointer place does for `p`: `*U` into `:& *U` is a place of `T`; into
# `:& U`, or `**U` into `:& *U`, it's the pointer to one, and passes.
# AGAST #2372: a `**S` as deep as `:& **S` is a place of it too: passing its value
# left the callee one level short.
fn pointer_place_kind(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    if param_borrows_struct_ptr_ptr(p) == 1
        var inner: i32 = TYPE_VOID
        var name: *u8 = null
        var name_len: i32 = 0
        if ptr_levels_of(s, arg, @inner, @name, @name_len) == ptr_ptr_ident_levels(p.param_inner_pointee_type)
            return BORROW_PLACE
    if p.param_pointee_type != TYPE_PTR
        return BORROW_PASS
    if pl.kind == TYPE_PTR_PTR or pl.pointee == TYPE_PTR
        return BORROW_PASS
    # AGAST #2354: an `@&U` place holds a pointer as a `*U` does, so it's the
    # place `:& *U`, `:& @&U` (and `:& T` at T = `@&U`) borrow, as on ritz0.
    # An `@U` one never gets here: place_behind_shared_ref refused it.  An
    # `@&U` param is no place: ritz0 gives it no storage to borrow.
    if pl.kind != TYPE_PTR and (pl.kind != TYPE_MUT_REF or ident_is_ref_param(arg) == 1)
        return BORROW_MISFIT
    if pointer_place_fits(s, arg, pl, p) == 1
        return BORROW_PLACE
    BORROW_MISFIT

# 1 when the place `e` is an `@T`, or the nearest indirection on its path to the
# root is one.  An `@&T` or `*T` nearer than that makes it writable.
fn place_behind_shared_ref(s: *EmitterState, e: *Expr) -> i32
    var pl: PlaceType
    if place_type_of(s, e, @pl) == 1 and pl.kind == TYPE_REF
        return 1
    var at: *Expr = e
    while at != null
        if at.kind == EXPR_MEMBER or at.kind == EXPR_INDEX
            at = at.left
        else if at.kind == EXPR_UNARY and at.op == OP_DEREF
            at = at.operand
            if at.kind == EXPR_BINARY
                at = find_base_expr(at)
        else
            return 0
        if place_type_of(s, at, @pl) == 1
            if pl.kind == TYPE_REF
                return 1
            if kind_is_pointer(pl.kind) == 1
                return 0
    0

# Emits nothing, so it can be asked again at each step of a call.
fn borrow_arg_kind(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if p == null or p.is_borrow != 1 or p.param_type != TYPE_MUT_REF
        return BORROW_PASS
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        return BORROW_PASS
    # An `a:& [N]T` param reads as the pointer it's bound to.
    if lent_array_ident(s, arg) != null
        return BORROW_PASS
    if arg_is_place(s, arg) == 0
        return rvalue_borrow_kind(s, arg, p)
    if place_behind_shared_ref(s, arg) == 1
        return BORROW_SHARED
    var pl: PlaceType
    if place_type_of(s, arg, @pl) == 0 or pl.kind == TYPE_UNKNOWN
        return BORROW_UNTYPED
    if kind_is_pointer(pl.kind) == 1
        return pointer_place_kind(s, arg, @pl, p)
    if place_fits_borrow(s, arg, @pl, p) == 1
        return BORROW_PLACE
    BORROW_MISFIT

fn borrow_arg_error(s: *EmitterState, arg: *Expr, fname: *u8, flen: i32, argno: i32, why: *u8)
    emit_str(s, c"  ; ERROR: argument to a `:&` param (AGAST #2335)\n")
    eprint_arg_type_error(arg, fname, flen, argno)
    eprints_cstr(why)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# Reports what can't go in `:&` param `p`, and answers 1 if it did.
fn check_borrow_arg(s: *EmitterState, fname: *u8, flen: i32, argno: i32, arg: *Expr, p: *Param) -> i32
    let k: i32 = borrow_arg_kind(s, arg, p)
    # check_array_ref_arg says which array it wanted.
    if k == BORROW_MISFIT and param_takes_array_ref(p) == 1
        return 0
    if k == BORROW_RVALUE
        borrow_arg_error(s, arg, fname, flen, argno, c"a `:&` parameter needs a place to borrow, and this is a temporary")
    else if k == BORROW_MISFIT
        borrow_arg_error(s, arg, fname, flen, argno, c"this place doesn't hold what the `:&` parameter borrows")
    else if k == BORROW_SHARED
        borrow_arg_error(s, arg, fname, flen, argno, c"a `:&` parameter can't borrow through an `@T`, which is read-only")
    else if k == BORROW_UNTYPED
        borrow_arg_error(s, arg, fname, flen, argno, c"ritz1 can't tell what this argument is: write `@&` before it")
    else
        return 0
    1

# The address of a place borrowed by `p`, as an i64 like `@x`; every slot
# converts that to what it is.  0 when `arg` is anything else.
# AGAST #2354: every slot reads `arg` as expr_is_ptr_valued says it is, and an
# `@&U` local is a `ptr`, so its place's address stays one.
fn emit_borrowed_place(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if borrow_arg_kind(s, arg, p) != BORROW_PLACE
        return 0
    let ptr: i32 = emit_lvalue_ptr(s, arg)
    if ptr < 0
        emit_ir_error(s, c"cannot take mutable address")
        return 0
    if expr_is_ptr_valued(s, arg) == 1
        return ptr
    let addr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, addr)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, ptr)
    emit_str(s, c" to i64  ; #2335 borrowed place\n")
    return addr

# AGAST #1948: passing a pointer to struct A where a pointer to struct B is
# expected is a located error, as in ritz0 (#1366).  ritz1's value model
# makes every pointer an i64, so nothing downstream (clang included) can see
# the pointee: a GrowBuf passed as `@&Vec<u8>` ran only because the two share
# a layout, and with different layouts the callee silently reads and writes
# the wrong fields.  `call` is the call expression (for its location),
# `fname` the callee as written in the diagnostic, `argno` 1-based.
fn check_struct_ptr_arg(s: *EmitterState, call: *Expr, fname: *u8, flen: i32, argno: i32, arg: *Expr, p: *Param)
    var want_len: i32 = 0
    let want: *u8 = param_pointee_struct(s, p, @want_len)
    if want == null
        return
    var got_len: i32 = 0
    let got: *u8 = arg_pointee_struct(s, arg, @got_len)
    if got == null
        return
    if name_eq(want, want_len, got, got_len) == 1
        return
    emit_str(s, c"  ; ERROR: struct pointer argument mismatch (AGAST #1948)\n")
    eprint_arg_type_error(call, fname, flen, argno)
    for i in 0..want_len
        eprint_char(*(want + i))
    eprints_cstr(c"* != ")
    for i in 0..got_len
        eprint_char(*(got + i))
    eprints_cstr(c"*\n")
    s.error_count = s.error_count + 1

# AGAST #1739 — a large by-value struct param is passed `ptr byval(%T)`.
# Spill the argument into a fresh slot right after evaluating it, before the
# next argument runs (which keeps evaluation order: a later arg cannot change
# what this one passes).  The value is almost always a `load %T` just
# emitted, so rewrite_large_struct_copies (#1732) turns this store into a
# pointer-to-pointer @__ritz_sret_copy.  Returns the slot; every arg-coercion
# cascade passes it through and the call writes it as `ptr byval(%T)`.
fn spill_byval_arg(s: *EmitterState, arg: *Expr, reg: i32, p: *Param) -> i32
    var val: i32 = reg
    # `f(@x)` for a by-value param: emit_expr gave the address as an i64
    # (the same case the free-call fallback cascade materialises with a
    # load).
    if arg != null and arg.kind == EXPR_UNARY
        if arg.op == OP_ADDR or arg.op == OP_ADDR_MUT
            let pp: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, pp)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, reg)
            emit_str(s, c" to ptr\n")
            val = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, val)
            emit_str(s, c" = load %")
            emit_name(s, p.param_type_name, p.param_type_name_len)
            emit_str(s, c", ptr ")
            emit_reg(s, pp)
            emit_str(s, c"\n")
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, p.param_type_name, p.param_type_name_len)
    emit_str(s, c"  ; #1739 byval arg\n")
    emit_str(s, c"  store %")
    emit_name(s, p.param_type_name, p.param_type_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    return slot

# Emit an Ok/Some/Err/None constructor as a `%Result$.../Option$...` struct
# value. `tag` is the variant index (0 = Ok/Some, 1 = Err/None).
# `payload_expr` is null for unit variants.  Returns the register holding
# the loaded struct value.  `ctor` is the constructor, for the error when
# nothing names its enum.
fn emit_variant_struct(s: *EmitterState, tag: i32, ctor: *Expr) -> i32
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    let ok: i32 = resolve_enum_ctx(s, @enum_name, @enum_name_len)
    if ok == 0
        return emit_no_enum_ctx_error(s, ctor)
    return emit_variant_build(s, enum_name, enum_name_len, tag, ctor.args)

# The constructor emit_ctor_type_error last refused.
var g_ctor_refused: *Expr = null

# "this constructor's type can't be inferred here", at `ctor`, once: a let or
# arms that couldn't name the enum say so, and then the constructor, emitted
# with none, reaches the fallback below (AGAST #2430, #2454).
fn emit_ctor_type_error(s: *EmitterState, ctor: *Expr)
    if ctor == g_ctor_refused
        return
    g_ctor_refused = ctor
    emit_nd_error(s, ctor.span.line, ctor.span.col, c"this constructor's type can't be inferred here: bind it with a typed `let` first")

# AGAST #2454: a Some/None/Ok/Err that nothing gives an enum is a located
# error.  It lowered to `add i64 0, 0` and the program ran on that zero: an
# array literal's, an if / match arm's, `a[i] = ` and a statement's all did,
# until each took its enum.  Inside a call argument or a slot whose type isn't
# an enum it is #1498 / #2142's refusal, now located too.  Returns an i64 zero
# so the rest of the fn still emits; the error stops the output.
fn emit_no_enum_ctx_error(s: *EmitterState, ctor: *Expr) -> i32
    if s.ctx_enum_arg == 1
        emit_nd_error(s, ctor.span.line, ctor.span.col, c"variant constructor has no enum context: the parameter or slot it goes into is not an Option/Result")
    else
        emit_ctor_type_error(s, ctor)
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0  ; constructor with no enum (error)\n")
    return z

# AGAST #2453: 1 when the call `e` named like a builtin constructor (Some /
# Ok / None / Err) is a user enum's variant here: a user enum declares it (or
# two do: try_emit_user_variant_ctor reports that) and no Option / Result
# slot gives the builtin an enum.  ritz0's slot decides the same way: in an
# Option-returning fn the tail `Some(7)` stays the builtin.
fn users_variant_wins(s: *EmitterState, e: *Expr) -> i32
    if is_variant_carrier(e.func_name, e.func_name_len) == 0 and is_variant_null(e.func_name, e.func_name_len) == 0
        return 0
    var a: i32 = 0
    var b: i32 = 0
    if user_variant_ctor_ambiguous(e, @a, @b) == 0
        var en: *u8 = null
        var en_len: i32 = 0
        user_variant_ctor_enum(e, @en, @en_len)
        if en == null
            return 0
        # The let's slot is this user enum (`let x: E = Ok(5)`, or an untyped
        # let #1797 typed %E): the user's variant, whatever the fn returns.
        if s.ctx_enum_name != null and name_eq(s.ctx_enum_name, s.ctx_enum_name_len, en, en_len) == 1
            return 1
    var bn: *u8 = null
    var bn_len: i32 = 0
    if resolve_enum_ctx(s, @bn, @bn_len) == 1
        return 0
    return 1

# AGAST #1797: `Holds(x)`, a payload variant of a user enum (unqualified, as
# ritz0's variant_to_enum resolves it: enum_of_variant).  Only a tuple
# variant's single payload is constructed here; a struct variant's field
# list (`Big(1, 2, 3)`) is not.  The qualified `Opt.Holds(x)` is an
# EXPR_METHOD: emit_qualified_variant_ctor (#1466).  Returns 0 when `e` is
# not one.
# AGAST #2039: a callee two enums declare is the located ambiguity error,
# not the last-declared enum's ctor.
fn try_emit_user_variant_ctor(s: *EmitterState, e: *Expr) -> i32
    # AGAST #2422: `Full(5)` in a `Slot<i32>` slot builds that instance.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, e.func_name, e.func_name_len, @ivi)
    if iei >= 0
        let ikind: i32 = enum_variant_kind(iei, ivi)
        if (ikind == ENUM_VARIANT_UNIT and e.args == null) or (ikind == ENUM_VARIANT_TUPLE and e.args != null and e.args.next == null)
            var in_len: i32 = 0
            let in_name: *u8 = enum_name_at(iei, @in_len)
            return emit_variant_build(s, in_name, in_len, ivi, e.args)
    var amb_a: i32 = 0
    var amb_b: i32 = 0
    if user_variant_ctor_ambiguous(e, @amb_a, @amb_b) == 1
        return emit_ambiguous_variant_error(s, e.func_name, e.func_name_len, e.span, amb_a, amb_b)
    var en: *u8 = null
    var en_len: i32 = 0
    user_variant_ctor_enum(e, @en, @en_len)
    if en == null
        # AGAST #3021: a generic enum's `Full(6)` no slot names an instance
        # of is refused here; it called an undeclared `@Full`.  A fn of that
        # name is still the call.
        if find_fn(s, e.func_name, e.func_name_len) == null
            return emit_no_instance_error(s, e.func_name, e.func_name_len, e.span)
        return 0
    var vi: i32 = 0
    var other: i32 = 0
    enum_of_variant_unique(e.func_name, e.func_name_len, @vi, @other)
    return emit_variant_build(s, en, en_len, vi, e.args)

# AGAST #1466: `E.V(args)`, variant `vi` of enum `ei` (see qualified_variant),
# lowered as the unqualified `V(args)` is (try_emit_user_variant_ctor): a
# tuple variant with its one payload, or a unit variant called with none.
# Anything else ritz1 cannot build is a located error, never IR.
fn emit_qualified_variant_ctor(s: *EmitterState, e: *Expr, ei: i32, vi: i32) -> i32
    if enum_is_generic(ei) == 1
        return emit_qualified_variant_error(s, e, c"is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. Some(x) / Ok(x) / None")
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(ei, @en_len)
    let kind: i32 = enum_variant_kind(ei, vi)
    if kind == ENUM_VARIANT_UNIT
        if e.args != null
            return emit_qualified_variant_error(s, e, c"takes no payload")
        return emit_variant_build(s, en, en_len, vi, null)
    if kind == ENUM_VARIANT_TUPLE
        if e.args == null or e.args.next != null
            return emit_qualified_variant_error(s, e, c"takes 1 payload value")
        return emit_variant_build(s, en, en_len, vi, e.args)
    return emit_qualified_variant_error(s, e, c"is a struct variant: constructing one is not supported by ritz1 yet (AGAST #1295)")

# The struct or enum a variant payload's register holds, null/0 for an i64-width
# scalar.  ritz1 lacks a full expr-type oracle so this peeks at the expression
# form: emit_variant_build stores by it, and a constructor scrutinee is named by
# it (AGAST #2419), so the two can't disagree.
fn variant_payload_aggregate(s: *EmitterState, payload_expr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if payload_expr.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, payload_expr.ident_ptr, payload_expr.ident_len)
        if loc != null
            if loc.var_type == TYPE_STRUCT
                if loc.type_name_len > 0
                    *out_name = loc.type_name
                    *out_len = loc.type_name_len
                    return
        # AGAST #2144: `Ok(Vacant)` / `Some(Vacant)`, a bare unit variant
        # of a user enum, is the enum aggregate as `Ok(Opt.Vacant)` is
        # (it was stored as an i64: invalid IR).  A same-named const /
        # local / global / fn wins, as in emit_expr_ident.
        var bvi: i32 = 0
        var bother: i32 = 0
        let bei: i32 = bare_unit_variant_enum(s, payload_expr, @bvi, @bother)
        if bei >= 0
            *out_name = enum_name_at(bei, out_len)
    else if payload_expr.kind == EXPR_STRING_LIT
        # Bare "..." lowers to a %Span$u8 aggregate (AGAST #98) —
        # layout-equal to StrView; storing it as i64 was invalid IR
        # for `Some("10")` (AGAST #1498).
        *out_name = c"Span$u8"
        *out_len = 7
    else if payload_expr.kind == EXPR_STRUCT_LIT
        # AGAST #1362: `Some(Point { .. })` / `Ok(Font { .. })` — the
        # rvalue struct literal yields its loaded `%Struct` aggregate.
        let lit_st: *StructDef = find_struct(s, payload_expr.ident_ptr, payload_expr.ident_len)
        if lit_st != null
            *out_name = lit_st.name
            *out_len = lit_st.name_len
    else if payload_expr.kind == EXPR_MEMBER
        # AGAST #1664: `Some(s.value)` with a struct-typed field (StrView,
        # at any depth, through @ / * / by value) — the field load yields
        # the `%Struct` aggregate, not an i64.
        let fld: *StructField = resolve_member_chain_field(s, payload_expr)
        if fld != null
            if fld.field_type == TYPE_STRUCT
                if fld.field_type_name_len > 0
                    *out_name = fld.field_type_name
                    *out_len = fld.field_type_name_len
                    return
        # AGAST #1466: `Err(ArgError.Bad)`, a qualified unit variant, is
        # the enum aggregate too.
        qualified_variant_enum(s, payload_expr, out_name, out_len)
    else if payload_expr.kind == EXPR_CALL
        # AGAST #1466: a user-enum ctor `Err(Missing(5))` is the enum
        # aggregate (it was stored as an i64: invalid IR).
        user_variant_ctor_enum(payload_expr, out_name, out_len)
        if *out_name != null
            return
        let fn_def: *FnDef = find_call_fn(s, payload_expr)
        if fn_def != null
            if fn_def.return_type == TYPE_STRUCT
                if fn_def.return_type_name_len > 0
                    *out_name = fn_def.return_type_name
                    *out_len = fn_def.return_type_name_len
    else if payload_expr.kind == EXPR_METHOD
        # AGAST #1466: `Err(ArgError.Missing(s))`, likewise.
        qualified_variant_enum(s, payload_expr, out_name, out_len)
        if *out_name != null
            return
        # AGAST #2572: `Some(v[lo..hi])` is `Some(v.slice(lo, hi))` after
        # #2451's rewrite: the `%Span$T` / `%Vec$T` / `%String` the callee
        # returns (it was stored as an i64: invalid IR).
        let md: *FnDef = method_call_def(s, payload_expr)
        if md != null
            if md.return_type == TYPE_STRUCT
                if md.return_type_name_len > 0
                    *out_name = md.return_type_name
                    *out_len = md.return_type_name_len

# AGAST #2288: `E.Full(c)`, `Full(c)` or `Some(c)` with `c:& C`, when the
# variant's declared payload is `C`: the referent, as in ritz0.  0 when `e` is
# anything else, or the payload is no `C` (a `Full(*C)` keeps the pointer).
fn emit_lent_payload(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, e: *Expr) -> i32
    if lent_referent_local(s, e) == null
        return 0
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type_name(s, enum_name, enum_name_len, tag, @pay_len)
    if pay == null or pay_len <= 0
        return 0
    return emit_lent_referent(s, e, pay, pay_len)

# The struct / enum type variant `tag` of `enum_name` declares for its payload:
# a tagged enum's type argument, or a user enum's (or instance's) tuple field.
# null (out_len 0) when the payload is a scalar or unknown.
fn variant_payload_type_name(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, out_len: *i32) -> *u8
    var pay: *u8 = tagged_enum_arg(s, enum_name, enum_name_len, tag, out_len)
    let uf: *StructField = user_enum_tuple_field(enum_name, enum_name_len, tag)
    if uf != null and uf.field_type == TYPE_STRUCT
        pay = uf.field_type_name
        *out_len = uf.field_type_name_len
    pay

# AGAST #2926: emit a variant's payload with the enum context its declared
# type gives, as emit_call_arg does for a parameter: `Has(Some(6))` with
# `Has(Option<i32>)` builds `%Option$i32`, and a payload slot that is no enum
# bars the outer one.  Only a payload whose type is known takes a slot; any
# other keeps the context it had.
fn emit_payload_into_slot(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, e: *Expr) -> i32
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type_name(s, enum_name, enum_name_len, tag, @pay_len)
    if pay == null or pay_len <= 0
        return emit_expr(s, e)
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    if is_tagged_enum_type(pay, pay_len) == 1 or is_enum_instance(pay, pay_len) == 1
        s.ctx_enum_name = pay
        s.ctx_enum_name_len = pay_len
    let reg: i32 = emit_expr(s, e)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    reg

# AGAST #3029: 1, and the `[N]T` in *out, when `e` is an array literal or fill
# and variant `tag` of `enum_name` declares an array payload: a user enum's
# tuple field (`V([2]u8)`) or a tagged enum's argument (`Option<[2]u8>`, spelt
# `arr2_u8`).  0 for anything else.
fn variant_array_payload(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, e: *Expr, out: *ArrayArg) -> i32
    if e == null or (e.kind != EXPR_ARRAY_LIT and e.kind != EXPR_ARRAY_FILL)
        return 0
    variant_array_type(s, enum_name, enum_name_len, tag, out)

# AGAST #3029: 1, and the `[N]T` in *out, when variant `tag` of `enum_name`
# declares an array payload.  The match binding reads it back at that type
# (emit_array_payload_bind).
fn variant_array_type(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, out: *ArrayArg) -> i32
    if enum_name == null or enum_name_len <= 0
        return 0
    let uf: *StructField = user_enum_tuple_field(enum_name, enum_name_len, tag)
    if uf != null
        if uf.field_type != TYPE_ARRAY or uf.array_size <= 0
            return 0
        out.size = uf.array_size
        out.elem = uf.array_elem_type
        out.pointee = uf.array_elem_pointee
        out.name = uf.array_elem_type_name
        out.name_len = uf.array_elem_type_name_len
        return 1
    var arg_len: i32 = 0
    let arg: *u8 = tagged_enum_arg(s, enum_name, enum_name_len, tag, @arg_len)
    if arg == null or arg_len <= 0
        return 0
    array_arg_decode(arg, arg_len, out)

# AGAST #3029: write the array literal or fill `e` into the payload buffer at
# `pay_ptr`, at its declared `[N]T` (variant_array_payload), as a struct
# literal's array field is (emit_struct_lit_array_fill_field).  emit_expr has
# no slot for one: it built a shadow `[N x i64]` and the payload got its
# ADDRESS (#3014 refused that).
fn emit_array_payload_into(s: *EmitterState, pay_ptr: i32, arr: *ArrayArg, e: *Expr)
    literal_array(s, e, arr.elem, arr.pointee)   # AGAST #2341
    if e.kind == EXPR_ARRAY_LIT
        emit_array_lit_into(s, pay_ptr, arr.size, arr.elem, arr.name, arr.name_len, e)
    else
        emit_array_fill_into(s, pay_ptr, arr.size, arr.elem, arr.name, arr.name_len, e.left)

# Build `%Enum` with tag `tag` and payload `payload_expr` (null: none) in a
# zeroed alloca, and load it.  `enum_name` is a tagged enum (Result$/Option$,
# where `tag` 0 / 1 also picks Ok-Some / Err for the payload width) or a
# user enum (AGAST #1797; the payload type is the tuple variant's).
fn emit_variant_build(s: *EmitterState, enum_name: *u8, enum_name_len: i32, tag: i32, payload_expr: *Expr) -> i32

    # Emit payload first (may consume registers); keep expr value for store.
    var payload_reg: i32 = 0
    var have_payload: i32 = 0
    # AGAST #3029: an array literal payload is written in place, below.
    var arr_pay: ArrayArg
    let arr_payload: i32 = variant_array_payload(s, enum_name, enum_name_len, tag, payload_expr, @arr_pay)
    # AGAST #2272: `Ok(())` carries a zero-byte payload: nothing to store.
    if arr_payload == 1
        have_payload = 2
    else if payload_expr != null and is_unit_expr(payload_expr) == 0
        payload_reg = emit_lent_payload(s, enum_name, enum_name_len, tag, payload_expr)
        if payload_reg == 0
            payload_reg = emit_payload_into_slot(s, enum_name, enum_name_len, tag, payload_expr)
        have_payload = 1

    # alloca %Enum
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c"  ; variant ctor\n")

    # Zero the whole struct so padding bytes are deterministic (matches
    # ritz0's default-initialized alloca).
    emit_str(s, c"  store %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")

    # Store tag at field 0 (i8).
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    emit_str(s, c"  store i8 ")
    emit_int(s, tag as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")

    if have_payload == 2
        let arr_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, arr_ptr)
        emit_str(s, c" = getelementptr %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, slot)
        emit_str(s, c", i32 0, i32 2\n")
        emit_array_payload_into(s, arr_ptr, @arr_pay, payload_expr)

    if have_payload == 1
        # Payload goes into field 2 (the `[N x i8]` buffer after the pad,
        # AGAST #1898).  ritz1's expr evaluation always yields an i64-width
        # register for scalar / ptr payloads; it is stored at the payload's
        # own width (truncated), as ritz0 stores it.  For struct
        # payloads (e.g. `Vec<u8>` or `StrView`) emit_expr returns the
        # aggregate register — store it by its declared name when we can
        # recover the type, else fall back to the scalar store.
        let pay_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, pay_ptr)
        emit_str(s, c" = getelementptr %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, slot)
        emit_str(s, c", i32 0, i32 2\n")

        var aggregate_name: *u8 = null
        var aggregate_name_len: i32 = 0
        variant_payload_aggregate(s, payload_expr, @aggregate_name, @aggregate_name_len)
        var is_aggregate: i32 = (aggregate_name != null) as i32

        # AGAST #1797: a user enum's tuple variant declares its payload
        # type; a struct one is the aggregate whatever the expression form.
        if is_aggregate == 0
            let uf: *StructField = user_enum_tuple_field(enum_name, enum_name_len, tag)
            if uf != null
                if uf.field_type == TYPE_STRUCT and uf.field_type_name_len > 0
                    is_aggregate = 1
                    aggregate_name = uf.field_type_name
                    aggregate_name_len = uf.field_type_name_len

        # AGAST #2987: a tagged enum's payload declared as an enum (a tagged
        # one, an instance or a user enum: `Some(Some(6))` in an
        # `Option<Option<i32>>`, `Ok(None)` in a `Result<Option<i32>, E>`)
        # is that aggregate whatever the expression form: the payload was
        # built in its slot (emit_payload_into_slot).  It was stored as an
        # i64: invalid IR.
        if is_aggregate == 0
            var decl_len: i32 = 0
            let decl: *u8 = tagged_enum_arg(s, enum_name, enum_name_len, tag, @decl_len)
            if decl != null and decl_len > 0
                if is_tagged_enum_type(decl, decl_len) == 1 or enum_find(decl, decl_len) >= 0
                    is_aggregate = 1
                    aggregate_name = decl
                    aggregate_name_len = decl_len

        if is_aggregate == 1
            emit_str(s, c"  store %")
            emit_name(s, aggregate_name, aggregate_name_len)
            emit_str(s, c" ")
            emit_reg(s, payload_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, pay_ptr)
            emit_str(s, c"\n")
        else
            # AGAST #1945: a float payload is stored at its own type; a
            # literal (always double) or an integer is converted first.
            var store_reg: i32 = payload_reg
            let pay_ft: i32 = tagged_enum_float_type(s, enum_name, enum_name_len, tag)
            if pay_ft != 0
                store_reg = emit_float_coerce(s, payload_reg, get_expr_type(s, payload_expr), pay_ft)
            else
                # AGAST #2384: an `@&T` payload (`Some(r)`, `r: @&C`, into an
                # `Option<@&C>`) is a `ptr`; the payload slot holds an i64.
                store_reg = ptr_value_to_i64(s, payload_expr, payload_reg)
            emit_tagged_payload_store(s, store_reg, pay_ptr, enum_name, enum_name_len, tag)

    # Load the assembled struct to return its value.
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    return result

# =============================================================================
# AGAST #167 — SIMD builtin lowering
#
# ritz0 (Python) handles SIMD intrinsics in emitter_llvmlite.py via direct LLVM
# IR generation rather than going through the regular call path.  ritz1's
# generic call path always emits `call i64 @name`, which mismatches when the
# binding is a `<N x iM>` vector type.  These helpers port ritz0's inline
# lowering for the simd_* builtins (simd_loadu, simd_xor, simd_add, etc.).
# Vector-type selection: prefer the binding context (`s.ctx_simd_name`, set
# by emit_var_decl / emit_assign) for simd_load/loadu where the type is not
# encoded in the args; for binary ops fall back to walking the arg locals.
# =============================================================================

# The AES-NI builtins lowered by emit_x86_intrinsic_v2i64.
fn is_aesni_builtin(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"aesenc", 6) == 1
        return 1
    if name_eq(name, len, c"aesenclast", 10) == 1
        return 1
    if name_eq(name, len, c"aesdec", 6) == 1
        return 1
    if name_eq(name, len, c"aesdeclast", 10) == 1
        return 1
    if name_eq(name, len, c"aesimc", 6) == 1
        return 1
    0

# The simd_* builtins whose emitters (emit_simd_clmul, emit_simd_sad) always
# return <2 x i64>, independent of their operands' types.
fn is_v2i64_result_builtin(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"simd_clmul", 10) == 1
        return 1
    if name_eq(name, len, c"simd_sad", 8) == 1
        return 1
    0

# AGAST #2052: the vector type a type-preserving simd_* call's emitter gives
# its result, so a consumer of the nested call (simd_storeu, an AES-NI
# operand, another binop) types it the same way.  Each branch repeats the
# choice its emitter makes — keep them in step:
#   simd_xor/simd_add          (emit_simd_binop)   first, then second operand
#   simd_insert/shuffle/rotl   (emit_simd_insert/_shuffle/_rotl) first operand
#   simd_load/simd_loadu       (emit_simd_loadu)   context chain only
# each defaulting to v4i32.  Returns 0 for any other call (not one of these).
fn resolve_simd_call_result_type(s: *EmitterState, call: *Expr, out_name: **u8, out_len: *i32) -> i32
    let n: *u8 = call.func_name
    let nl: i32 = call.func_name_len
    var found: i32 = 0
    if name_eq(n, nl, c"simd_xor", 8) == 1 or name_eq(n, nl, c"simd_add", 8) == 1
        if call.args == null or call.args.next == null
            return 0
        found = resolve_simd_arg_type(s, call.args, out_name, out_len)
        if found == 0
            found = resolve_simd_arg_type(s, call.args.next, out_name, out_len)
    else if name_eq(n, nl, c"simd_insert", 11) == 1 or name_eq(n, nl, c"simd_shuffle", 12) == 1 or name_eq(n, nl, c"simd_rotl", 9) == 1
        if call.args == null
            return 0
        found = resolve_simd_arg_type(s, call.args, out_name, out_len)
    else if name_eq(n, nl, c"simd_loadu", 10) == 1 or name_eq(n, nl, c"simd_load", 9) == 1
        found = resolve_simd_arg_type(s, null, out_name, out_len)
    else
        return 0
    if found == 0
        *out_name = c"v4i32"
        *out_len = 5
    1

# Resolve SIMD vector type-name for an arg expression — looks at ident
# locals first (they carry `type_name = "v4i32"` etc.), then falls back to
# the binding context.  Returns 1 if resolved, 0 otherwise.  An AES-NI call
# resolves to its state operand's type.
fn resolve_simd_arg_type(s: *EmitterState, arg: *Expr, out_name: **u8, out_len: *i32) -> i32
    if arg != null
        if arg.kind == EXPR_IDENT
            let lv: *LocalVar = find_local_struct_name(s, arg.ident_ptr, arg.ident_len)
            if lv != null
                if is_simd_vector_type_name(lv.type_name, lv.type_name_len) == 1
                    *out_name = lv.type_name
                    *out_len = lv.type_name_len
                    return 1
        else if arg.kind == EXPR_UNARY
            # `*p` — check the operand (deref of *v4i32 → v4i32 value).
            return resolve_simd_arg_type(s, arg.operand, out_name, out_len)
        else if arg.kind == EXPR_CALL and is_aesni_builtin(arg.func_name, arg.func_name_len) == 1
            # An AES-NI call has its state operand's type (AGAST #1609).
            if resolve_simd_arg_type(s, arg.args, out_name, out_len) == 1
                return 1
        else if arg.kind == EXPR_CALL and is_v2i64_result_builtin(arg.func_name, arg.func_name_len) == 1
            # simd_clmul / simd_sad always emit <2 x i64>, whatever the
            # binding context says (AGAST #2051).
            *out_name = c"v2i64"
            *out_len = 5
            return 1
        else if arg.kind == EXPR_CALL and resolve_simd_call_result_type(s, arg, out_name, out_len) == 1
            # A type-preserving simd_* call (AGAST #2052).
            return 1
    if s.ctx_simd_name != null
        if s.ctx_simd_name_len > 0
            *out_name = s.ctx_simd_name
            *out_len = s.ctx_simd_name_len
            return 1
    # Fall through to the enclosing fn's return type — needed for tail-
    # expression `return simd_loadu(...)` shapes (squeeze/crc32_simd has
    # `fn load_vec(...) -> v2i64 \n  simd_loadu(data as *i64)`).
    if s.ret_type_name != null
        if s.ret_type_name_len > 0
            if is_simd_vector_type_name(s.ret_type_name, s.ret_type_name_len) == 1
                *out_name = s.ret_type_name
                *out_len = s.ret_type_name_len
                return 1
    0

# `simd_loadu(ptr) -> vec<N,T>` / `simd_load(...)`: emit an inline LLVM load
# with the vector type pulled from `s.ctx_simd_name` (set by the enclosing
# `let v: v4i32 = ...` / `v = ...`).  `unaligned == 1` → align 1; else use
# 16-byte (SSE2) or 32-byte (AVX2) alignment based on the chosen vec type.
fn emit_simd_loadu(s: *EmitterState, e: *Expr, unaligned: i32) -> i32
    if e.args == null
        emit_ir_error(s, c"simd_load(u) requires a pointer argument")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let arg_reg: i32 = emit_expr(s, e.args)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, null, @vec_name, @vec_name_len) == 0
        # No context — default to v4i32 (most common SSE2 shape).  Keeps
        # IR well-formed even when we can't infer; the user will get a
        # clear type error downstream if it doesn't match the binding.
        vec_name = c"v4i32"
        vec_name_len = 5
    # Convert i64 ptr-as-int to ptr (ritz1's unified value model passes
    # all pointers as i64 except when the param is TYPE_MUT_REF).
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, arg_reg)
    emit_str(s, c" to ptr  ; simd_load: ptr cast\n")
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, p)
    if unaligned == 1
        emit_str(s, c", align 1\n")
    else
        # AVX2 names use 32-byte alignment; SSE2 names use 16-byte.
        let bits: i32 = simd_vector_elem_bits(vec_name, vec_name_len)
        let count: i32 = simd_vector_elem_count(vec_name, vec_name_len)
        if (bits * count) >= 256
            emit_str(s, c", align 32\n")
        else
            emit_str(s, c", align 16\n")
    return result

# `simd_storeu(ptr, vec)` / `simd_store(...)`: emit inline LLVM store.
fn emit_simd_storeu(s: *EmitterState, e: *Expr, unaligned: i32) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, c"simd_store(u) requires (ptr, vec)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let ptr_reg: i32 = emit_expr(s, e.args)
    let vec_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args.next, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, ptr_reg)
    emit_str(s, c" to ptr  ; simd_store: ptr cast\n")
    emit_str(s, c"  store ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, vec_reg)
    emit_str(s, c", ptr ")
    emit_reg(s, p)
    if unaligned == 1
        emit_str(s, c", align 1\n")
    else
        let bits2: i32 = simd_vector_elem_bits(vec_name, vec_name_len)
        let count2: i32 = simd_vector_elem_count(vec_name, vec_name_len)
        if (bits2 * count2) >= 256
            emit_str(s, c", align 32\n")
        else
            emit_str(s, c", align 16\n")
    # Void result — return a sentinel i64 0.  Callers that bind the result
    # see a harmless no-op value; the typical use is statement-position
    # `simd_storeu(...)` where the value is dropped.
    let z2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z2)
    emit_str(s, c" = add i64 0, 0  ; simd_store void\n")
    return z2

# `simd_xor(a,b)` / `simd_add(a,b)` — binary vector ops.  Vector type is
# derived from the args (vector-typed locals) or context.
fn emit_simd_binop(s: *EmitterState, e: *Expr, opname: *u8) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, c"simd binop requires 2 vector args")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        if resolve_simd_arg_type(s, e.args.next, @vec_name, @vec_name_len) == 0
            vec_name = c"v4i32"
            vec_name_len = 5
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = ")
    emit_str(s, opname)
    emit_str(s, c" ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, a_reg)
    emit_str(s, c", ")
    emit_reg(s, b_reg)
    emit_str(s, c"\n")
    return result

# `simd_extract(vec, idx) -> elem` — `extractelement`.
fn emit_simd_extract(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, c"simd_extract requires (vec, idx)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # `idx_reg` is i64 in the unified value model; truncate to i32 for
    # the extractelement opcode.
    let i32idx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, i32idx)
    emit_str(s, c" = trunc i64 ")
    emit_reg(s, idx_reg)
    emit_str(s, c" to i32\n")
    let elem: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem)
    emit_str(s, c" = extractelement ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, vec_reg)
    emit_str(s, c", i32 ")
    emit_reg(s, i32idx)
    emit_str(s, c"\n")
    # Element is the vector's scalar type — extend to i64 for the unified
    # value model so downstream consumers work uniformly.
    let bits: i32 = simd_vector_elem_bits(vec_name, vec_name_len)
    if bits == 64
        return elem
    let ext: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ext)
    emit_str(s, c" = sext ")
    emit_simd_elem_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, elem)
    emit_str(s, c" to i64\n")
    return ext

# `simd_insert(vec, idx, val) -> vec` — `insertelement`.
fn emit_simd_insert(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, c"simd_insert requires (vec, idx, val)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    let val_reg: i32 = emit_expr(s, e.args.next.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    let i32idx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, i32idx)
    emit_str(s, c" = trunc i64 ")
    emit_reg(s, idx_reg)
    emit_str(s, c" to i32\n")
    # Truncate val from i64 down to the element width.
    let bits: i32 = simd_vector_elem_bits(vec_name, vec_name_len)
    var val_narrow: i32 = val_reg
    if bits != 64
        val_narrow = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, val_narrow)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c" to ")
        emit_simd_elem_type(s, vec_name, vec_name_len)
        emit_str(s, c"\n")
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = insertelement ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, vec_reg)
    emit_str(s, c", ")
    emit_simd_elem_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, val_narrow)
    emit_str(s, c", i32 ")
    emit_reg(s, i32idx)
    emit_str(s, c"\n")
    return result

# `simd_shuffle(a, b, mask...)` — `shufflevector`.  Mask args must all be
# integer literals (compile-time constants).
fn emit_simd_shuffle(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, c"simd_shuffle requires (vec, vec, mask...)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # Count + emit mask values.  All must be integer literals.
    var mask_count: i32 = 0
    var mask_arg: *Expr = e.args.next.next
    while mask_arg != null
        mask_count = mask_count + 1
        mask_arg = mask_arg.next
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = shufflevector ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, a_reg)
    emit_str(s, c", ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, b_reg)
    emit_str(s, c", <")
    emit_int(s, mask_count as i64)
    emit_str(s, c" x i32> <")
    mask_arg = e.args.next.next
    var first: i32 = 1
    while mask_arg != null
        if first == 0
            emit_str(s, c", ")
        first = 0
        emit_str(s, c"i32 ")
        if mask_arg.kind == EXPR_INT_LIT
            emit_int(s, mask_arg.int_val)
        else
            # Best-effort: emit 0 for non-literal (LLVM rejects but the
            # compiler at least doesn't crash).  ritz0 raises here.
            emit_int(s, 0)
        mask_arg = mask_arg.next
    emit_str(s, c">\n")
    return result

# `simd_rotl(vec, n)` — rotate-left by constant n.  Implemented as
# `(v << n) | (v >> (bits - n))`.  `n` must be a compile-time integer
# literal so we can broadcast the shift constants directly.
fn emit_simd_rotl(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, c"simd_rotl requires (vec, n)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # Extract shift amount as a compile-time constant.
    var shift_amount: i64 = 0
    var shift_expr: *Expr = e.args.next
    if shift_expr.kind == EXPR_INT_LIT
        shift_amount = shift_expr.int_val
    else if shift_expr.kind == EXPR_CAST and shift_expr.left != null and shift_expr.left.kind == EXPR_INT_LIT
        shift_amount = shift_expr.left.int_val
    let bits: i32 = simd_vector_elem_bits(vec_name, vec_name_len)
    let count: i32 = simd_vector_elem_count(vec_name, vec_name_len)
    let right_shift: i64 = (bits as i64) - shift_amount
    # Build broadcast splats for left/right shift constants.
    let left_shifted: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, left_shifted)
    emit_str(s, c" = shl ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, vec_reg)
    emit_str(s, c", <")
    var li: i32 = 0
    while li < count
        if li > 0
            emit_str(s, c", ")
        emit_simd_elem_type(s, vec_name, vec_name_len)
        emit_str(s, c" ")
        emit_int(s, shift_amount)
        li = li + 1
    emit_str(s, c">\n")
    let right_shifted: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, right_shifted)
    emit_str(s, c" = lshr ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, vec_reg)
    emit_str(s, c", <")
    var ri: i32 = 0
    while ri < count
        if ri > 0
            emit_str(s, c", ")
        emit_simd_elem_type(s, vec_name, vec_name_len)
        emit_str(s, c" ")
        emit_int(s, right_shift)
        ri = ri + 1
    emit_str(s, c">\n")
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = or ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" ")
    emit_reg(s, left_shifted)
    emit_str(s, c", ")
    emit_reg(s, right_shifted)
    emit_str(s, c"\n")
    return result

# `simd_sad(a: v16i8, b: v16i8) -> v2i64` — sum of absolute differences,
# routes to `llvm.x86.sse2.psad.bw`.  The result type differs from the args.
fn emit_simd_sad(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, c"simd_sad requires (vec, vec)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    add_extern(s, c"llvm.x86.sse2.psad.bw", 21)
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @llvm.x86.sse2.psad.bw(<16 x i8> ")
    emit_reg(s, a_reg)
    emit_str(s, c", <16 x i8> ")
    emit_reg(s, b_reg)
    emit_str(s, c")\n")
    return result

# `simd_clmul(a: v2i64, b: v2i64, imm8: u8) -> v2i64` — carryless multiply
# (PCLMULQDQ).  imm must be a compile-time constant 0-255.
fn emit_simd_clmul(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, c"simd_clmul requires (vec, vec, imm8)")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var imm: i64 = 0
    let imm_expr: *Expr = e.args.next.next
    if imm_expr.kind == EXPR_INT_LIT
        imm = imm_expr.int_val
    else if imm_expr.kind == EXPR_CAST and imm_expr.left != null and imm_expr.left.kind == EXPR_INT_LIT
        imm = imm_expr.left.int_val
    add_extern(s, c"llvm.x86.pclmulqdq", 18)
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @llvm.x86.pclmulqdq(<2 x i64> ")
    emit_reg(s, a_reg)
    emit_str(s, c", <2 x i64> ")
    emit_reg(s, b_reg)
    emit_str(s, c", i8 ")
    emit_int(s, imm)
    emit_str(s, c")\n")
    return result

# Generic x86 LLVM-intrinsic dispatch — emit `call <vec_type> @<llvm_name>(...)`.
# Used for the SHA-NI and AES-NI families which take and return SIMD vectors
# but aren't simd_*-prefixed.  Adds the LLVM intrinsic name to the externs
# table so the matching `declare` is emitted in emit_extern_declarations.
# `vec_name` chooses the vector LLVM type for both args and result.
# `arity` is the number of vector args (1, 2, or 3).
fn emit_x86_simd_intrinsic(s: *EmitterState, e: *Expr, llvm_name: *u8, llvm_name_len: i32, arity: i32, vec_name: *u8, vec_name_len: i32) -> i32
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4
        arg_regs[arg_count] = emit_expr(s, arg_it)
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        emit_ir_error(s, c"x86 intrinsic arity mismatch")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    add_extern(s, llvm_name, llvm_name_len)
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = call ")
    emit_simd_vector_type(s, vec_name, vec_name_len)
    emit_str(s, c" @")
    emit_name(s, llvm_name, llvm_name_len)
    emit_str(s, c"(")
    var k: i32 = 0
    while k < arg_count
        if k > 0
            emit_str(s, c", ")
        emit_simd_vector_type(s, vec_name, vec_name_len)
        emit_str(s, c" ")
        emit_reg(s, arg_regs[k])
        k = k + 1
    emit_str(s, c")\n")
    return result

# SHA-NI wrapper: those intrinsics take and return <4 x i32>, the only type
# the builtins accept (ritz0 rejects others), so no cast is needed.
fn emit_x86_intrinsic_v4i32(s: *EmitterState, e: *Expr, llvm_name: *u8, llvm_name_len: i32, arity: i32) -> i32
    return emit_x86_simd_intrinsic(s, e, llvm_name, llvm_name_len, arity, c"v4i32", 5)

# AES-NI (AGAST #1609): `llvm.x86.aesni.*` take and return only <2 x i64>,
# but the ritz builtins accept any 128-bit integer vector, as ritz0 does.  An
# operand whose type resolves to anything but v2i64 (in practice v4i32) is
# bitcast to <2 x i64> on the way in, and the result is bitcast back to the
# state operand's (first arg's) type.  An operand whose type cannot be
# resolved is taken as v2i64, which is what this path emitted before.
fn emit_x86_intrinsic_v2i64(s: *EmitterState, e: *Expr, llvm_name: *u8, llvm_name_len: i32, arity: i32) -> i32
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var res_name: *u8 = c"v2i64"
    var res_name_len: i32 = 5
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4
        var reg: i32 = emit_expr(s, arg_it)
        var a_name: *u8 = null
        var a_len: i32 = 0
        if resolve_simd_arg_type(s, arg_it, @a_name, @a_len) == 1
            if arg_count == 0
                res_name = a_name
                res_name_len = a_len
            if name_eq(a_name, a_len, c"v2i64", 5) == 0
                let cast_in: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, cast_in)
                emit_str(s, c" = bitcast ")
                emit_simd_vector_type(s, a_name, a_len)
                emit_str(s, c" ")
                emit_reg(s, reg)
                emit_str(s, c" to <2 x i64>\n")
                reg = cast_in
        arg_regs[arg_count] = reg
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        emit_ir_error(s, c"x86 intrinsic arity mismatch")
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = add i64 0, 0\n")
        return z
    add_extern(s, llvm_name, llvm_name_len)
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @")
    emit_name(s, llvm_name, llvm_name_len)
    emit_str(s, c"(")
    var k: i32 = 0
    while k < arg_count
        if k > 0
            emit_str(s, c", ")
        emit_str(s, c"<2 x i64> ")
        emit_reg(s, arg_regs[k])
        k = k + 1
    emit_str(s, c")\n")
    if name_eq(res_name, res_name_len, c"v2i64", 5) == 1
        return result
    let cast_out: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cast_out)
    emit_str(s, c" = bitcast <2 x i64> ")
    emit_reg(s, result)
    emit_str(s, c" to ")
    emit_simd_vector_type(s, res_name, res_name_len)
    emit_str(s, c"\n")
    return cast_out

fn emit_mem_int_ty(s: *EmitterState, bits: i32)
    emit_str(s, c"i")
    emit_int(s, bits as i64)

# Truncate an i64 value register to `bits` (no-op at 64).
fn mem_narrow(s: *EmitterState, v: i32, bits: i32) -> i32
    if bits == 64
        return v
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = trunc i64 ")
    emit_reg(s, v)
    emit_str(s, c" to ")
    emit_mem_int_ty(s, bits)
    emit_str(s, c"\n")
    r

# Extend an iN result to the i64 value model by the pointee's signedness.
fn mem_widen(s: *EmitterState, v: i32, bits: i32, ty: i32) -> i32
    if bits == 64
        return v
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    if ty == TYPE_I8 or ty == TYPE_I16 or ty == TYPE_I32
        emit_str(s, c" = sext ")
    else
        emit_str(s, c" = zext ")
    emit_mem_int_ty(s, bits)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c" to i64\n")
    r

# volatile_* / atomic_* / fence (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879).
fn emit_mem_builtin(s: *EmitterState, e: *Expr, id: i32) -> i32
    var want: i32 = 2
    if id == MEM_FENCE
        want = 0
    else if id == MEM_VOLATILE_LOAD or id == MEM_ATOMIC_LOAD
        want = 1
    else if id == MEM_ATOMIC_CMPXCHG
        want = 3
    var argc: i32 = 0
    var a: *Expr = e.args
    while a != null
        argc += 1
        a = a.next
    if argc != want
        if want == 0
            mem_builtin_error(s, e, c"takes 0 arguments")
        else if want == 1
            mem_builtin_error(s, e, c"takes 1 argument")
        else if want == 2
            mem_builtin_error(s, e, c"takes 2 arguments")
        else
            mem_builtin_error(s, e, c"takes 3 arguments")
        return 0
    if id == MEM_FENCE
        emit_str(s, c"  fence seq_cst\n")
        return 0
    let pty: i32 = mem_builtin_pointee(s, e.args)
    let bits: i32 = mem_int_type_bits(pty)
    if bits == 0
        mem_builtin_error(s, e, c"needs a pointer to an integer type (i8..u64)")
        return 0
    # The pointer: an i64 address (or already a ptr, as for OP_DEREF).
    let addr: i32 = emit_expr(s, e.args)
    var ptr: i32 = addr
    if deref_operand_is_ptr(s, e.args) == 0
        ptr = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, addr)
        emit_str(s, c" to ptr\n")
    # Value operands, left to right, at the pointee width.
    var v1: i32 = -1
    var v2: i32 = -1
    if want >= 2
        v1 = mem_narrow(s, emit_expr(s, e.args.next), bits)
    if want == 3
        v2 = mem_narrow(s, emit_expr(s, e.args.next.next), bits)
    if id == MEM_VOLATILE_STORE or id == MEM_ATOMIC_STORE
        emit_str(s, c"  store ")
        if id == MEM_VOLATILE_STORE
            emit_str(s, c"volatile ")
        else
            emit_str(s, c"atomic ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c" ")
        emit_reg(s, v1)
        emit_str(s, c", ptr ")
        emit_reg(s, ptr)
        if id == MEM_ATOMIC_STORE
            # LLVM requires an explicit alignment on atomics: the natural one.
            emit_str(s, c" seq_cst, align ")
            emit_int(s, (bits / 8) as i64)
        emit_str(s, c"\n")
        return 0
    let raw: i32 = next_reg(s)
    if id == MEM_VOLATILE_LOAD or id == MEM_ATOMIC_LOAD
        emit_str(s, c"  ")
        emit_reg(s, raw)
        if id == MEM_VOLATILE_LOAD
            emit_str(s, c" = load volatile ")
        else
            emit_str(s, c" = load atomic ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c", ptr ")
        emit_reg(s, ptr)
        if id == MEM_ATOMIC_LOAD
            emit_str(s, c" seq_cst, align ")
            emit_int(s, (bits / 8) as i64)
        emit_str(s, c"\n")
        return mem_widen(s, raw, bits, pty)
    if id == MEM_ATOMIC_CMPXCHG
        # { iN, i1 }: the old value, and whether it equalled `expected`.
        emit_str(s, c"  ")
        emit_reg(s, raw)
        emit_str(s, c" = cmpxchg ptr ")
        emit_reg(s, ptr)
        emit_str(s, c", ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c" ")
        emit_reg(s, v1)
        emit_str(s, c", ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c" ")
        emit_reg(s, v2)
        emit_str(s, c" seq_cst seq_cst\n")
        let old: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, old)
        emit_str(s, c" = extractvalue { ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c", i1 } ")
        emit_reg(s, raw)
        emit_str(s, c", 0\n")
        return mem_widen(s, old, bits, pty)
    emit_str(s, c"  ")
    emit_reg(s, raw)
    emit_str(s, c" = atomicrmw ")
    if id == MEM_ATOMIC_XCHG
        emit_str(s, c"xchg")
    else if id == MEM_ATOMIC_ADD
        emit_str(s, c"add")
    else if id == MEM_ATOMIC_SUB
        emit_str(s, c"sub")
    else if id == MEM_ATOMIC_AND
        emit_str(s, c"and")
    else if id == MEM_ATOMIC_OR
        emit_str(s, c"or")
    else
        emit_str(s, c"xor")
    emit_str(s, c" ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", ")
    emit_mem_int_ty(s, bits)
    emit_str(s, c" ")
    emit_reg(s, v1)
    emit_str(s, c" seq_cst\n")
    mem_widen(s, raw, bits, pty)

# =============================================================================
# sizeof (LANGUAGE_SPEC §7.9, AGAST #2124)
#
# `sizeof(T)` is the size of type T; `sizeof(expr)` the size of expr's TYPE.
# The operand is never evaluated: these helpers only read declarations, and
# emit_expr_call emits one constant.  Every non-type operand used to come out
# as 8 (so `mem_zero(@key[0], sizeof(key))` wiped 8 bytes of a 64-byte key),
# and so did an unknown type name.  Each helper answers -1 when it cannot
# tell, and the caller makes that a located error: no guess survives.
# =============================================================================

# Size of one value of kind `t` (struct / enum `name` when t == TYPE_STRUCT;
# a primitive spelled as a name is accepted too), or -1 for a type that does
# not exist.  Unlike elem_size_align, never falls back to 8.
fn sizeof_kind_size(s: *EmitterState, t: i32, name: *u8, name_len: i32) -> i64
    if t == TYPE_STRUCT
        if name == null or name_len <= 0
            return -1
        let prim: i64 = prim_name_size(name, name_len)
        if prim > 0
            return prim
        if find_struct(s, name, name_len) != null or is_tagged_enum_type(name, name_len) == 1 or user_enum_index(name, name_len) >= 0
            return get_struct_size_by_name(s, name, name_len)
        return -1
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return 8
    let sz: i64 = ptr_pointee_size(s, t, null, 0)
    if sz > 0
        return sz
    return -1

fn sizeof_shape_size(s: *EmitterState, sh: *ArrayShape, skip_outer: i32) -> i64
    var n: i64 = 1
    var d: i32 = skip_outer
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    let leaf: i64 = sizeof_kind_size(s, sh.leaf_type, sh.leaf_name, sh.leaf_name_len)
    if leaf < 0
        return -1
    return n * leaf

fn sizeof_times(count: i64, elem: i64) -> i64
    if elem < 0
        return -1
    return count * elem

# A type alias `name`, sized; -1 when `name` is no alias (or sizes to nothing).
fn sizeof_alias_size(s: *EmitterState, name: *u8, len: i32) -> i64
    var count: i64 = 0
    var leaf: i32 = TYPE_VOID
    var leaf_name: *u8 = null
    var leaf_len: i32 = 0
    if type_alias_sizeof_shape(name, len, @count, @leaf, @leaf_name, @leaf_len) == 0
        return -1
    return sizeof_times(count, sizeof_kind_size(s, leaf, leaf_name, leaf_len))

# 1 when `name` is a value in scope: a local or param, a global or a const.
fn sizeof_is_value(s: *EmitterState, name: *u8, len: i32) -> i32
    if find_local_idx(s, name, len) >= 0
        return 1
    if find_global(s, name, len) != null
        return 1
    if find_const_entry(s, name, len) != null
        return 1
    return 0

# A type spelled as an identifier: a primitive, struct, enum or alias.
fn sizeof_type_name_size(s: *EmitterState, name: *u8, len: i32) -> i64
    let alias_sz: i64 = sizeof_alias_size(s, name, len)
    if alias_sz >= 0
        return alias_sz
    return sizeof_kind_size(s, TYPE_STRUCT, name, len)

# 1 when `e` spells a type rather than a value (`u8`, `Pair`, `*Pair`): the
# operand of `sizeof(*u8)` parses as a deref of the name `u8`.
fn sizeof_names_type(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_TYPE_OPERAND
        return 1
    if e.kind == EXPR_IDENT
        if sizeof_is_value(s, e.ident_ptr, e.ident_len) == 1
            return 0
        if sizeof_type_name_size(s, e.ident_ptr, e.ident_len) >= 0
            return 1
        return 0
    if e.kind == EXPR_UNARY and (e.op == OP_DEREF or e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        return sizeof_names_type(s, e.operand)
    return 0

# The newest declaration of `name` in this function (null if none, or if
# the table overflowed and can no longer be trusted).
fn sizeof_find_decl(s: *EmitterState, name: *u8, len: i32) -> *NarrowDecl
    if s.narrow_decl_overflow != 0
        return null
    var i: i32 = s.narrow_decl_count - 1
    while i >= 0
        let d: *NarrowDecl = @s.narrow_decls[i]
        if name_eq(d.name, d.name_len, name, len) == 1
            return d
        i = i - 1
    return null

fn sizeof_local_size(s: *EmitterState, lv: *LocalVar, depth: i32) -> i64
    let t: i32 = lv.var_type
    if t == TYPE_ARRAY
        if lv.array_shape != null
            return sizeof_shape_size(s, lv.array_shape, 0)
        return sizeof_times(lv.array_size as i64, sizeof_kind_size(s, lv.array_elem_type, lv.type_name, lv.type_name_len))
    if t == TYPE_STRUCT
        return sizeof_kind_size(s, TYPE_STRUCT, lv.type_name, lv.type_name_len)
    if lv.is_bool == 1
        return 1
    if narrow_int_width(t) == 0
        return sizeof_kind_size(s, t, lv.type_name, lv.type_name_len)
    # An integer slot: ritz1 keeps every integer in i64, and the parser
    # defaults a missing annotation to TYPE_I64, so the slot can't say.
    # An unannotated `let x = init` has init's type, as in ritz0.
    let d: *NarrowDecl = sizeof_find_decl(s, lv.name, lv.name_len)
    if d != null and d.declared == TYPE_VOID
        if d.init == null
            return -1
        return sizeof_expr_size(s, d.init, depth + 1)
    return sizeof_kind_size(s, t, null, 0)

fn sizeof_global_size(s: *EmitterState, g: *GlobalVarDef) -> i64
    if g.var_type == TYPE_ARRAY
        if g.array_shape != null
            return sizeof_shape_size(s, g.array_shape, 0)
        return sizeof_times(g.array_size as i64, sizeof_kind_size(s, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len))
    return sizeof_kind_size(s, g.var_type, g.type_name, g.type_name_len)

fn sizeof_ident_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    # A value in scope wins over a type of the same name, as in ritz0.
    # The written integer type first (narrow_ident_type: consts, annotated
    # locals, params, narrow globals).
    let nt: i32 = narrow_ident_type(s, e)
    if nt != NARROW_UNKNOWN
        return sizeof_kind_size(s, nt, null, 0)
    let lidx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
    if lidx >= 0
        return sizeof_local_size(s, local_at(s, lidx), depth)
    let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
    if g != null
        return sizeof_global_size(s, g)
    let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
    if ce != null
        if ce.const_type == TYPE_ARRAY
            return sizeof_times(ce.array_size as i64, sizeof_kind_size(s, ce.array_elem_type, ce.array_elem_type_name, ce.array_elem_type_name_len))
        return sizeof_kind_size(s, ce.const_type, ce.type_name, ce.type_name_len)
    return sizeof_type_name_size(s, e.ident_ptr, e.ident_len)

# The struct an element of array `b` (a local or global ident) is, or 0.
fn sizeof_array_elem_struct(s: *EmitterState, b: *Expr, name: **u8, len: *i32) -> i32
    if b.kind != EXPR_IDENT
        return 0
    let lidx: i32 = find_local_idx(s, b.ident_ptr, b.ident_len)
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        if lv.var_type == TYPE_ARRAY and lv.array_shape == null and lv.array_elem_type == TYPE_STRUCT
            *name = lv.type_name
            *len = lv.type_name_len
            return 1
        return 0
    let g: *GlobalVarDef = find_global(s, b.ident_ptr, b.ident_len)
    if g != null and g.var_type == TYPE_ARRAY and g.array_shape == null and g.array_elem_type == TYPE_STRUCT
        *name = g.array_elem_type_name
        *len = g.array_elem_type_name_len
        return 1
    return 0

# The field `e` (an EXPR_MEMBER) names: member_field_def's receivers, plus
# an element of a struct array (`ps[i].f`).
fn sizeof_member_field(s: *EmitterState, e: *Expr) -> *StructField
    let f: *StructField = member_field_def(s, e)
    if f != null
        return f
    # AGAST #2152: `arr[i].m`, `(*p).m`, `g[i][j].m` -- the emitter's own
    # type-only resolver.
    let rf: *StructField = resolve_member_chain_field(s, e)
    if rf != null
        return rf
    if e.left == null or e.left.kind != EXPR_INDEX
        return null
    var sname: *u8 = null
    var slen: i32 = 0
    if sizeof_array_elem_struct(s, e.left.left, @sname, @slen) == 0
        return null
    let st: *StructDef = find_struct(s, sname, slen)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    return get_field_type(st, idx)

# `base[i]`: one element of an array (local, global or field) or pointer.
fn sizeof_index_size(s: *EmitterState, e: *Expr) -> i64
    if e.right != null and e.right.kind == EXPR_RANGE
        return -1
    # AGAST #2152: any index chain over an N-D array (local, global or a
    # field through any base): `s.m[0][1]`, `arr[1].m[0][2]`, `g[1][2]`.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null
        return sizeof_shape_size(s, nd_sh, nd_depth)
    let b: *Expr = e.left
    if b.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, b)
        if f == null
            return -1
        if f.field_type == TYPE_ARRAY and f.array_shape != null
            return sizeof_shape_size(s, f.array_shape, 1)   # AGAST #2097: a row
        if f.field_type == TYPE_ARRAY
            return sizeof_kind_size(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len)
        if f.field_type == TYPE_PTR
            return sizeof_kind_size(s, ptr_field_elem_kind(f), f.field_type_name, f.field_type_name_len)
        return -1
    if b.kind != EXPR_IDENT
        return -1
    let lidx: i32 = find_local_idx(s, b.ident_ptr, b.ident_len)
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        if lv.var_type == TYPE_ARRAY
            if lv.array_shape != null
                return sizeof_shape_size(s, lv.array_shape, 1)
            return sizeof_kind_size(s, lv.array_elem_type, lv.type_name, lv.type_name_len)
        if lv.var_type == TYPE_PTR_PTR
            return 8
        if lv.var_type == TYPE_PTR
            return sizeof_kind_size(s, lv.pointee_type, lv.type_name, lv.type_name_len)
        return -1
    let g: *GlobalVarDef = find_global(s, b.ident_ptr, b.ident_len)
    if g != null
        if g.var_type == TYPE_ARRAY
            if g.array_shape != null
                return sizeof_shape_size(s, g.array_shape, 1)
            return sizeof_kind_size(s, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len)
        if g.var_type == TYPE_PTR_PTR
            return 8
        if g.var_type == TYPE_PTR
            return sizeof_kind_size(s, g.pointee_type, g.type_name, g.type_name_len)
    return -1

# `*p`: the pointee of a pointer local / param / global.
fn sizeof_deref_size(s: *EmitterState, e: *Expr) -> i64
    let o: *Expr = e.operand
    if o == null or o.kind != EXPR_IDENT
        return -1
    let lidx: i32 = find_local_idx(s, o.ident_ptr, o.ident_len)
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        if lv.var_type == TYPE_PTR_PTR
            return 8
        if lv.var_type == TYPE_PTR or lv.var_type == TYPE_REF or lv.var_type == TYPE_MUT_REF
            return sizeof_kind_size(s, lv.pointee_type, lv.type_name, lv.type_name_len)
        return -1
    let g: *GlobalVarDef = find_global(s, o.ident_ptr, o.ident_len)
    if g != null
        if g.var_type == TYPE_PTR_PTR
            return 8
        if g.var_type == TYPE_PTR
            return sizeof_kind_size(s, g.pointee_type, g.type_name, g.type_name_len)
    return -1

# Size of `e`'s type, or -1 when it can't be determined.  `depth` bounds the
# walk through unannotated locals' initialisers.
fn sizeof_expr_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    if e == null or depth > 16
        return -1
    let k: i32 = e.kind
    if k == EXPR_TYPE_OPERAND
        return sizeof_times(e.int_val, sizeof_kind_size(s, e.op, e.ident_ptr, e.ident_len))
    if k == EXPR_IDENT
        return sizeof_ident_size(s, e, depth)
    if k == EXPR_INT_LIT or k == EXPR_FLOAT_LIT or k == EXPR_CSTRING_LIT
        return 8
    if k == EXPR_CHAR_LIT
        return 1
    if k == EXPR_STRING_LIT
        return sizeof_kind_size(s, TYPE_STRUCT, c"StrView", 7)
    if k == EXPR_MEMBER
        let f: *StructField = sizeof_member_field(s, e)
        if f == null
            return -1
        if f.field_type == TYPE_ARRAY and f.array_shape != null
            return sizeof_shape_size(s, f.array_shape, 0)   # AGAST #2097
        if f.field_type == TYPE_ARRAY
            return sizeof_times(f.array_size as i64, sizeof_kind_size(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len))
        return sizeof_kind_size(s, f.field_type, f.field_type_name, f.field_type_name_len)
    if k == EXPR_INDEX
        return sizeof_index_size(s, e)
    if k == EXPR_UNARY
        if sizeof_names_type(s, e) == 1
            return 8   # `*u8`, `@Pair`: a pointer type
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT
            return 8
        if e.op == OP_DEREF
            return sizeof_deref_size(s, e)
        return sizeof_expr_size(s, e.operand, depth + 1)
    if k == EXPR_BINARY
        # As ritz0: a comparison or `and`/`or` is a bool, anything else
        # has its left operand's type.
        if e.op >= OP_EQ and e.op <= OP_OR
            return 1
        return sizeof_expr_size(s, e.left, depth + 1)
    if k == EXPR_CAST
        return sizeof_kind_size(s, e.op, null, 0)
    if k == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, e)
        if fd == null
            return -1
        return sizeof_kind_size(s, fd.return_type, fd.return_type_name, fd.return_type_name_len)
    return -1

# "error: <file>:<line>:<col>: sizeof: ..." — counted, so main refuses to
# write the output.
fn sizeof_error(s: *EmitterState, e: *Expr, name: *u8, len: i32)
    emit_str(s, c"  ; ERROR: sizeof operand\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    if name != null
        eprints_cstr(c": sizeof: unknown type or value `")
        var i: i32 = 0
        while i < len
            eprint_char(*(name + i))
            i += 1
        eprints_cstr(c"`\n")
    else
        eprints_cstr(c": sizeof: cannot determine the type of this expression\n")
    s.error_count = s.error_count + 1

# The constant `sizeof(...)` folds to; reports and returns 0 when unknown.
fn sizeof_call_value(s: *EmitterState, e: *Expr) -> i64
    let arg: *Expr = e.args
    if arg == null or arg.next != null
        emit_nd_error(s, e.span.line, e.span.col, c"sizeof takes exactly one argument (a type or an expression)")
        return 0
    let sz: i64 = sizeof_expr_size(s, arg, 0)
    if sz >= 0
        return sz
    if arg.kind == EXPR_IDENT and sizeof_is_value(s, arg.ident_ptr, arg.ident_len) == 0
        sizeof_error(s, arg, arg.ident_ptr, arg.ident_len)
    else
        sizeof_error(s, arg, null, 0)
    return 0

fn emit_expr_call(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    bool_check_call(s, e)      # AGAST #2342
    literal_call(s, e)         # AGAST #2341
    # Variant constructor: Some(x) / Ok(x) / None / Err(x) -> %Result$.../
    # Option$... struct.  Handled before the generic call path so
    # match/return paths get a type-correct aggregate (ritz-task-133).
    # AGAST #2453: a user enum declaring `Ok` / `Some` (or `Err` / `None`)
    # builds its own variant unless an Option / Result slot names the builtin.
    if users_variant_wins(s, e) == 1
        return try_emit_user_variant_ctor(s, e)
    if is_variant_carrier(e.func_name, e.func_name_len) == 1
        # Ok / Some = tag 0
        return emit_variant_struct(s, 0, e)
    if is_variant_null(e.func_name, e.func_name_len) == 1
        # Err = tag 1 (None is the no-arg case, handled in emit_expr_ident)
        return emit_variant_struct(s, 1, e)
    # User-enum payload variant `Holds(x)` (AGAST #1797).  Before the
    # generic call path, as ritz0 checks variant_to_enum before functions.
    let user_ctor: i32 = try_emit_user_variant_ctor(s, e)
    if user_ctor != 0
        return user_ctor
    # print() / eprint() built-ins: the same lowering to fd 1 / fd 2 (#1641).
    var print_fd: i64 = 0
    if name_eq(e.func_name, e.func_name_len, c"print", 5) == 1
        print_fd = 1
    else if name_eq(e.func_name, e.func_name_len, c"eprint", 6) == 1
        print_fd = 2

    # format_into(sink, "...") -- print's literal, appended to a buffer
    # through sink.push_bytes (AGAST #1824). emitter_print.ritz has it.
    if name_eq(e.func_name, e.func_name_len, c"format_into", 11) == 1
        return emit_format_into(s, e)

    if print_fd != 0
        # print(str) -> syscall(1, fd, str_ptr, str_len)
        # Get the first argument - should be a string literal
        var arg: *Expr = e.args
        if arg != null
            # "..." interpolates `{expr}` placeholders; c"..." is written
            # verbatim, and rejected if it holds one (AGAST #1521, #1394).
            # emitter_print.ritz has the lowering.
            if arg.kind == EXPR_STRING_LIT or arg.kind == EXPR_CSTRING_LIT
                return emit_print_literal(s, print_fd, arg)
            else
                # Non-literal: evaluate the expression and call syscall
                let str_reg: i32 = emit_expr(s, arg)
                let result: i32 = next_reg(s)
                emit_str(s, c"  ; print() with non-literal - strlen unknown\n")
                emit_str(s, c"  ")
                emit_reg(s, result)
                emit_str(s, c" = add i64 0, 0\n")
                return result
        let zero: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, zero)
        emit_str(s, c" = add i64 0, 0\n")
        return zero

    # Check if this is __builtin_alloca
    var is_alloca: i32 = 0
    if e.func_name_len == 16
        # Check for "__builtin_alloca"
        if *(e.func_name + 0) == 95   # _
            if *(e.func_name + 1) == 95   # _
                if *(e.func_name + 2) == 98   # b
                    if *(e.func_name + 3) == 117  # u
                        if *(e.func_name + 4) == 105  # i
                            if *(e.func_name + 5) == 108  # l
                                if *(e.func_name + 6) == 116  # t
                                    if *(e.func_name + 7) == 105  # i
                                        if *(e.func_name + 8) == 110  # n
                                            if *(e.func_name + 9) == 95   # _
                                                if *(e.func_name + 10) == 97  # a
                                                    if *(e.func_name + 11) == 108 # l
                                                        if *(e.func_name + 12) == 108 # l
                                                            if *(e.func_name + 13) == 111 # o
                                                                if *(e.func_name + 14) == 99 # c
                                                                    if *(e.func_name + 15) == 97 # a
                                                                        is_alloca = 1

    # Check if this is sizeof
    var is_sizeof: i32 = 0
    if e.func_name_len == 6
        if memcmp(e.func_name, c"sizeof", 6) == 0
            is_sizeof = 1

    if is_sizeof == 1
        # sizeof(T) / sizeof(expr) -> compile-time constant; the operand is
        # not evaluated (AGAST #2124, see sizeof_call_value).
        let type_size: i64 = sizeof_call_value(s, e)
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, type_size)
        emit_str(s, c"\n")
        return result

    if is_alloca == 1
        # __builtin_alloca(size) -> alloca i8, i64 size
        var arg: *Expr = e.args
        if arg != null
            let size_reg: i32 = emit_expr(s, arg)
            let alloca_reg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, alloca_reg)
            emit_str(s, c" = alloca i8, i64 ")
            emit_reg(s, size_reg)
            emit_str(s, c"\n")
            # Convert to i64 for uniform representation
            let ptr_reg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ptr_reg)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c" to i64\n")
            return ptr_reg
        # No argument - allocate 1 byte
        let alloca_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, alloca_reg)
        emit_str(s, c" = alloca i8\n")
        let ptr_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr_reg)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, alloca_reg)
        emit_str(s, c" to i64\n")
        return ptr_reg

    # AGAST #167: SIMD intrinsic dispatch.  Before the regular call path
    # (which always emits `call i64 @<name>` and registers an extern), look
    # for `simd_*` builtin names and lower them inline to native LLVM
    # vector instructions.  Without this, `let v: v4i32 = simd_loadu(...)`
    # produced `call i64 @simd_loadu(ptr ...)` then `store %v4i32 ...` and
    # the IR verifier rejected the type mismatch.  Mirrors ritz0's
    # _try_emit_simd_builtin lowering.
    if name_eq(e.func_name, e.func_name_len, c"simd_loadu", 10) == 1
        return emit_simd_loadu(s, e, 1)
    if name_eq(e.func_name, e.func_name_len, c"simd_load", 9) == 1
        return emit_simd_loadu(s, e, 0)
    if name_eq(e.func_name, e.func_name_len, c"simd_storeu", 11) == 1
        return emit_simd_storeu(s, e, 1)
    if name_eq(e.func_name, e.func_name_len, c"simd_store", 10) == 1
        return emit_simd_storeu(s, e, 0)
    if name_eq(e.func_name, e.func_name_len, c"simd_xor", 8) == 1
        return emit_simd_binop(s, e, c"xor")
    if name_eq(e.func_name, e.func_name_len, c"simd_add", 8) == 1
        return emit_simd_binop(s, e, c"add")
    if name_eq(e.func_name, e.func_name_len, c"simd_extract", 12) == 1
        return emit_simd_extract(s, e)
    if name_eq(e.func_name, e.func_name_len, c"simd_insert", 11) == 1
        return emit_simd_insert(s, e)
    if name_eq(e.func_name, e.func_name_len, c"simd_shuffle", 12) == 1
        return emit_simd_shuffle(s, e)
    if name_eq(e.func_name, e.func_name_len, c"simd_rotl", 9) == 1
        return emit_simd_rotl(s, e)
    if name_eq(e.func_name, e.func_name_len, c"simd_sad", 8) == 1
        return emit_simd_sad(s, e)
    if name_eq(e.func_name, e.func_name_len, c"simd_clmul", 10) == 1
        return emit_simd_clmul(s, e)
    # AGAST #167: x86 SHA-NI / AES-NI intrinsics that take and return SIMD
    # vectors.  They map to LLVM intrinsics directly (`llvm.x86.sha256rnds2`,
    # etc.); without explicit dispatch, ritz1's generic call path emits
    # `call i64 @sha256rnds2(i64 %vec_arg, ...)` and the verifier rejects
    # the vector-into-i64 mismatch.  v4i32-returning ones first; the v2i64
    # AES family below.
    if name_eq(e.func_name, e.func_name_len, c"sha256rnds2", 11) == 1
        return emit_x86_intrinsic_v4i32(s, e, c"llvm.x86.sha256rnds2", 20, 3)
    if name_eq(e.func_name, e.func_name_len, c"sha256msg1", 10) == 1
        return emit_x86_intrinsic_v4i32(s, e, c"llvm.x86.sha256msg1", 19, 2)
    if name_eq(e.func_name, e.func_name_len, c"sha256msg2", 10) == 1
        return emit_x86_intrinsic_v4i32(s, e, c"llvm.x86.sha256msg2", 19, 2)
    if name_eq(e.func_name, e.func_name_len, c"aesenc", 6) == 1
        return emit_x86_intrinsic_v2i64(s, e, c"llvm.x86.aesni.aesenc", 21, 2)
    if name_eq(e.func_name, e.func_name_len, c"aesenclast", 10) == 1
        return emit_x86_intrinsic_v2i64(s, e, c"llvm.x86.aesni.aesenclast", 25, 2)
    if name_eq(e.func_name, e.func_name_len, c"aesdec", 6) == 1
        return emit_x86_intrinsic_v2i64(s, e, c"llvm.x86.aesni.aesdec", 21, 2)
    if name_eq(e.func_name, e.func_name_len, c"aesdeclast", 10) == 1
        return emit_x86_intrinsic_v2i64(s, e, c"llvm.x86.aesni.aesdeclast", 25, 2)
    if name_eq(e.func_name, e.func_name_len, c"aesimc", 6) == 1
        return emit_x86_intrinsic_v2i64(s, e, c"llvm.x86.aesni.aesimc", 21, 1)
    # AGAST #1879: volatile / atomic memory builtins.  Reserved names, as in
    # ritz0: checked before user fns, so they never become an extern.
    let mem_id: i32 = mem_builtin_id(e.func_name, e.func_name_len)
    if mem_id != 0
        return emit_mem_builtin(s, e, mem_id)

    # Indirect call via local fn-ptr.  When `e.func_name` matches a
    # local variable (e.g. `let h: fn(*Task) -> i32 = task.handler`),
    # the call must load the function pointer from the slot and use
    # `call ... %ptr(...)` rather than `call ... @h(...)`.  Without
    # this, the linker fails with "undefined reference to `h`" because
    # we mistakenly registered the symbol as an extern.  Common in
    # ritzlib's async/tasks (`run_tasks`, `task_server_poll_tasks`,
    # `task_server_run_multishot`) and valet's connection dispatcher.
    #
    # AGAST #1671: when the local's declared type is a `fn(...) -> T` whose
    # signature the parser kept (params and typed `let`s), fall through to
    # the direct-call path below with that signature standing in for the
    # callee's FnDef: args convert to the real param types and the result
    # is read at the real return width (`call i1 %f(i8 ...)`, then zext).
    # The untyped `call i64 %f(i64 ...)` below remains only for locals
    # whose type is unknown (e.g. inferred `let h = task.handler`).
    let icall_local: i32 = find_local(s, e.func_name, e.func_name_len)
    # AGAST #2407: a local named like a fn is the local, so a call of one that
    # holds no fn value is an error, not a call of the fn or a jump to the value.
    if icall_local >= 0 and e.call_type_suffix_len == 0
        let named: *LocalVar = find_local_struct_name(s, e.func_name, e.func_name_len)
        if named != null and named.fn_sig == null and named.not_fn == 1
            binder_call_refuse(fn_source_file(emitter_current_fn()), e.span.line, e.span.col, e.func_name, e.func_name_len)
            emit_str(s, c"  ; ERROR: a call of a local that holds no fn\n")
            s.error_count = s.error_count + 1
            return 0
    # AGAST #2255: a local of this name is a fn pointer, not the procedure.
    if icall_local < 0 and e.func_name_len > 0 and value_wanted(s, e) == 1
        if fn_is_procedure(find_call_fn(s, e)) == 1
            reject_procedure_value(s, e, e.func_name, e.func_name_len)
    var icall_sig: *FnDef = null
    if icall_local >= 0 and e.call_type_suffix_len == 0
        let icall_lv: *LocalVar = find_local_struct_name(s, e.func_name, e.func_name_len)
        if icall_lv != null
            icall_sig = icall_lv.fn_sig
        if fn_is_procedure(icall_sig) == 1   # AGAST #2260: a fn pointer
            reject_procedure_value(s, e, e.func_name, e.func_name_len)
    # AGAST #1747: a nameless call (`fs[i](..)`): the callee is an expression
    # in `left`, evaluated first (left to right), to an i64 address.  With a
    # known signature it takes the typed path below, as a typed fn-ptr local
    # does; otherwise it is the untyped `call i64` an untyped local gets.
    var callee_val: i32 = -1
    if e.func_name_len == 0
        icall_sig = call_callee_sig(s, e)
        if fn_is_procedure(icall_sig) == 1   # AGAST #2260
            reject_procedure_value(s, e, null, 0)
        callee_val = emit_expr(s, e.left)
        if icall_sig == null
            let ut_args: *i32 = call_reg_slots(e.args, 0)
            var ut_argc: i32 = 0
            var ut_arg: *Expr = e.args
            while ut_arg != null
                ut_args[ut_argc] = emit_expr(s, ut_arg)
                ut_argc += 1
                ut_arg = ut_arg.next
            let ut_fp: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ut_fp)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, callee_val)
            emit_str(s, c" to ptr\n")
            let ut_result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ut_result)
            emit_str(s, c" = call i64 ")
            emit_reg(s, ut_fp)
            emit_str(s, c"(")
            for j in 0..ut_argc
                if j > 0
                    emit_str(s, c", ")
                emit_str(s, c"i64 ")
                emit_reg(s, ut_args[j])
            emit_str(s, c")\n")
            return ut_result
    if icall_local >= 0 and e.call_type_suffix_len == 0 and icall_sig == null
        # Evaluate args first.
        let icall_args: *i32 = call_reg_slots(e.args, 0)
        var icall_argc: i32 = 0
        var icall_arg: *Expr = e.args
        while icall_arg != null
            icall_args[icall_argc] = emit_expr(s, icall_arg)
            icall_argc += 1
            icall_arg = icall_arg.next
        # Load fn pointer from the slot.
        let icall_fp: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, icall_fp)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, icall_local)
        emit_str(s, c"\n")
        # Emit indirect call. We don't know the return type precisely,
        # so default to i64 (the unified value model).  Args are passed
        # as i64 — fn-ptr locals are typed as `fn(*T) -> i32` etc., but
        # ritz1's local tracker doesn't carry the signature.
        let icall_result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, icall_result)
        emit_str(s, c" = call i64 ")
        emit_reg(s, icall_fp)
        emit_str(s, c"(")
        for j in 0..icall_argc
            if j > 0
                emit_str(s, c", ")
            emit_str(s, c"i64 ")
            emit_reg(s, icall_args[j])
        emit_str(s, c")\n")
        return icall_result

    # Regular function call - register as external if not defined in this module
    # Build the full function name with type suffix (e.g., "vec_new$u8" for vec_new<u8>())
    # Heap, sized for the longer of name+suffix and "__ritz_builtin_"+name: a
    # fixed [128]u8 was overrun by a long name (AGAST #1813).
    let full_name: *u8 = malloc((e.func_name_len + e.call_type_suffix_len + 16) as i64)
    var full_len: i32 = 0
    # Copy base function name
    for i in 0..e.func_name_len
        full_name[full_len] = *(e.func_name + i)
        full_len = full_len + 1
    # Append type suffix if present (generic call)
    if e.call_type_suffix_len > 0
        for i in 0..e.call_type_suffix_len
            full_name[full_len] = *(e.call_type_suffix + i)
            full_len = full_len + 1
    # Look up the callee first: its params give each argument its enum
    # context (AGAST #1498), and its return type is needed below.  A typed
    # indirect call (AGAST #1671) uses the fn type's signature instead and
    # names no symbol, so it registers no extern.
    var fn_def: *FnDef = icall_sig
    # AGAST #1791: ritz0's named syscall builtins (`write`, `open`, ..).  The
    # call goes to the reserved weak_odr body @__ritz_builtin_<name>, never
    # to a user fn of that name (ritz0 tests builtins first).  fn_def stays
    # null, so the args take the extern path's i64 conversions.
    var sys_builtin: i32 = 0
    if call_is_named_syscall_builtin(s, e) == 1   # no local of that name
        sys_builtin = 1
        let prefix: *u8 = c"__ritz_builtin_"
        full_len = 0
        for i in 0..15
            full_name[full_len] = *(prefix + i)
            full_len += 1
        for i in 0..e.func_name_len
            full_name[full_len] = *(e.func_name + i)
            full_len += 1
        add_extern(s, full_name, full_len)
    else if icall_sig == null
        add_extern(s, full_name, full_len)
        fn_def = find_fn(s, full_name, full_len)
        # R10: `C_g(c)` is the method `c.g()` calls; impl methods aren't in
        # fn_map, so without this the call took the untyped i64 fallback and
        # clang refused it, unlocated (AGAST #2447).
        if fn_def == null
            fn_def = find_impl_method_by_symbol(s.module, full_name, full_len)

    # Sized from the argument list (AGAST #1813): a fixed [16] dropped every
    # argument past the 16th.  Room for the 3 a syscall builtin is padded to.
    let arg_regs: *i32 = call_reg_slots(e.args, 3)
    var arg_count: i32 = 0
    var arg2: *Expr = e.args
    var ap: *Param = null
    if fn_def != null
        ap = fn_def.params
    while arg2 != null
        check_struct_ptr_arg(s, e, e.func_name, e.func_name_len, arg_count + 1, arg2, ap)
        check_array_arg(s, e, e.func_name, e.func_name_len, arg_count + 1, arg2, ap)
        arg_regs[arg_count] = emit_call_arg(s, arg2, ap)
        arg_count += 1
        if ap != null
            ap = ap.next
        arg2 = arg2.next

    # AGAST #1791: ritz0 takes 1 to 3 arguments for any named syscall builtin
    # and leaves the unused argument registers unset.  Every body takes three,
    # so pad with zeros (the kernel ignores them).
    if sys_builtin == 1
        if arg_count < 1 or arg_count > 3
            emit_ir_error_begin(s, c"named syscall builtin takes 1 to 3 arguments: '")
            emit_ir_error_end(s, e.func_name, e.func_name_len)
        while arg_count < 3
            let pad: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, pad)
            emit_str(s, c" = add i64 0, 0\n")
            arg_regs[arg_count] = pad
            arg_count += 1

    # fn_def is a direct callee or the signature of a fn value.
    if refuse_array_return(s, e, fn_def) == 1
        return 0
    var ret_type: i32 = TYPE_I64  # Default for unknown functions
    var ret_struct_name: *u8 = null
    var ret_struct_name_len: i32 = 0
    if fn_def != null
        ret_type = fn_def.return_type
        if fn_def.return_type == TYPE_STRUCT
            ret_struct_name = fn_def.return_type_name
            ret_struct_name_len = fn_def.return_type_name_len

    # Convert argument values to match parameter types BEFORE emitting call
    let converted_regs: *i32 = call_reg_slots(e.args, 3)
    let param_types: *i32 = call_reg_slots(e.args, 3)
    var param_ptr: *Param = null
    if fn_def != null
        param_ptr = fn_def.params
    for j in 0..arg_count
        if param_ptr != null
            param_types[j] = param_ptr.param_type
            # AGAST #176: Span$u8 / StrView -> i64 coercion for legacy *u8
            # (TYPE_PTR / TYPE_REF / TYPE_I64) params.  Bare "..." lowers to
            # %Span$u8 (#98); without this coercion `eprints_cstr("...")`
            # emits `call void @eprints_cstr(i64 %.span)` and the IR verifier
            # rejects the aggregate-into-i64 mismatch.  helper returns the
            # coerced i64 reg or -1 (fall through to the regular cascade).
            # Also subsumes the narrower string-literal coercion ritz-task-172
            # added for cryptosec's hkdf_expand_label("key", …) call site.
            var s176_arg_iter: *Expr = e.args
            var s176_ai: i32 = 0
            while s176_ai < j and s176_arg_iter != null
                s176_arg_iter = s176_arg_iter.next
                s176_ai = s176_ai + 1
            var s176_reg: i32 = 0 - 1
            if param_uses_byval(s, param_ptr) == 0
                s176_reg = try_emit_span_to_i64_arg(s, s176_arg_iter, param_ptr.param_type, arg_regs[j])
            if param_uses_byval(s, param_ptr) == 1
                # AGAST #1739 — already the byval slot (emit_call_arg).
                converted_regs[j] = arg_regs[j]
            else if s176_reg >= 0
                converted_regs[j] = s176_reg
            # Truncate i64 values to smaller types if needed
            else if param_ptr.param_type == TYPE_U8 or param_ptr.param_type == TYPE_I8
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i8\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_I32 or param_ptr.param_type == TYPE_U32
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i32\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_I16 or param_ptr.param_type == TYPE_U16
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i16\n")
                converted_regs[j] = trunc
            else if param_ptr.param_type == TYPE_STRUCT and param_ptr.param_type_name_len > 0 and is_primitive_type_name(param_ptr.param_type_name, param_ptr.param_type_name_len) == 1
                # Post-monomorph primitive param (vec_push_u16_method parity):
                # `T` substituted with u16/i32/etc. but left TYPE_STRUCT in AST.
                # emit_llvm_type_struct maps the name back for signatures;
                # match by truncating i64 arg down to primitive width.
                if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u8", 2) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i8", 2) == 1
                    let tp8: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, tp8)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i8\n")
                    converted_regs[j] = tp8
                else if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u16", 3) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i16", 3) == 1
                    let tp16: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, tp16)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i16\n")
                    converted_regs[j] = tp16
                else if name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"u32", 3) == 1 or name_eq(param_ptr.param_type_name, param_ptr.param_type_name_len, c"i32", 3) == 1
                    let tp32: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, tp32)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i32\n")
                    converted_regs[j] = tp32
                else
                    # bool/usize/isize/u64/i64/f32/f64: passthrough.
                    converted_regs[j] = arg_regs[j]
            else if (param_ptr.param_type == TYPE_PTR or param_ptr.param_type == TYPE_PTR_PTR) and expr_is_ptr_valued(s, nth_arg(e.args, j)) == 1
                # AGAST #1644: `*T` params are i64 in ritz1's value model,
                # but `@&v` and a TYPE_MUT_REF ident are `ptr`.
                let ptr_arg: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ptr_arg)
                emit_str(s, c" = ptrtoint ptr ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i64  ; #1644 @&T->*T\n")
                converted_regs[j] = ptr_arg
            else if param_ptr.param_type == TYPE_REF and expr_is_ptr_valued(s, nth_arg(e.args, j)) == 1
                # AGAST #2416: an `@T` param is i64 too, so `rd(@&c)` (a `ptr`)
                # needs the same ptrtoint, for a struct of any size or a scalar.
                converted_regs[j] = ptr_value_to_i64(s, nth_arg(e.args, j), arg_regs[j])
            else if param_ptr.param_type == TYPE_MUT_REF
                # TYPE_MUT_REF params expect ptr.  An `@&T` ident, `@&v` or
                # `v as @&T` is already `ptr`; anything else -- `@v`, a `*T`
                # value, and (AGAST #1757) a `-> @&T` call result, which
                # get_expr_type calls TYPE_MUT_REF but is i64 -- is inttoptr'd.
                converted_regs[j] = i64_value_to_ptr(s, nth_arg(e.args, j), arg_regs[j])
            else if param_ptr.param_type == TYPE_REF and param_ptr.param_type_name_len > 0
                # AGAST #113 — auto-borrow: @Struct param + Struct-valued ident
                # actual. Callsite emits `i64` for TYPE_REF, but emit_expr of a
                # struct ident loaded `%Struct`. Take the local slot's address
                # as i64 instead (the load is left orphaned — harmless).
                var ref_arg: *Expr = e.args
                var rk: i32 = 0
                while rk < j and ref_arg != null
                    ref_arg = ref_arg.next
                    rk = rk + 1
                var ref_done: i32 = 0
                # AGAST #187 — narrow TYPE_MUT_REF → TYPE_REF coercion.
                # Caller has `@&T` (lowered as `ptr`); callee expects `@T`
                # (lowered as `i64`).  arg_regs[j] is a freshly-loaded `ptr`
                # from the caller's MUT_REF slot; insert a `ptrtoint` so the
                # call-site i64 signature matches.  Repro: tome.ritz:3327
                # `pubsub_unsubscribe(ps: @&PubSub)` calling
                # `pubsub_find_channel(ps: @PubSub, …)`.
                #
                # Narrow scoping: only when the actual arg is an EXPR_IDENT
                # whose local has var_type == TYPE_MUT_REF.  An earlier
                # broader attempt (#184 reverted) regressed
                # test_issue_strview_as_bytes by hitting StrView struct args.
                if ref_arg != null and ref_arg.kind == EXPR_IDENT
                    let mr_loc: *LocalVar = find_local_struct_name(s, ref_arg.ident_ptr, ref_arg.ident_len)
                    if mr_loc != null and mr_loc.var_type == TYPE_MUT_REF
                        let pti_mr: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, pti_mr)
                        emit_str(s, c" = ptrtoint ptr ")
                        emit_reg(s, arg_regs[j])
                        emit_str(s, c" to i64  ; #187 @&T->@T\n")
                        converted_regs[j] = pti_mr
                        ref_done = 1
                if ref_done == 0 and ref_arg != null and ref_arg.kind == EXPR_IDENT
                    let ref_loc: *LocalVar = find_local_struct_name(s, ref_arg.ident_ptr, ref_arg.ident_len)
                    if ref_loc != null and ref_loc.var_type == TYPE_STRUCT
                        let pti_r: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, pti_r)
                        emit_str(s, c" = ptrtoint ptr ")
                        emit_reg(s, ref_loc.reg)
                        emit_str(s, c" to i64\n")
                        converted_regs[j] = pti_r
                        ref_done = 1
                # Rvalue auto-borrow: `f(call_returning_struct())` where
                # f wants @Struct.  arg_regs[j] holds the %Struct value
                # returned by the call — spill it to a stack slot and
                # pass the slot's address as i64.  Without this, the
                # struct-typed reg gets cast to i64 implicitly (clang
                # rejects).
                if ref_done == 0 and ref_arg != null
                    if (ref_arg.kind == EXPR_METHOD or ref_arg.kind == EXPR_CALL) and call_returns_address(s, ref_arg) == 0
                        let spill: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, spill)
                        emit_str(s, c" = alloca %")
                        emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                        emit_str(s, c"  ; rvalue auto-borrow\n")
                        emit_str(s, c"  store %")
                        emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, arg_regs[j])
                        emit_str(s, c", ptr ")
                        emit_reg(s, spill)
                        emit_str(s, c"\n")
                        let pti_rv: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, pti_rv)
                        emit_str(s, c" = ptrtoint ptr ")
                        emit_reg(s, spill)
                        emit_str(s, c" to i64\n")
                        converted_regs[j] = pti_rv
                        ref_done = 1
                if ref_done == 0
                    converted_regs[j] = arg_regs[j]
            else if param_ptr.param_type == TYPE_BOOL
                # Callee expects i1. Bool values are i64 registers and need a
                # trunc, except a bool global's i1 load (task-99 #100). This
                # used to ask get_expr_type == TYPE_BOOL, which also passed a
                # bool CALL's zext'd i64 straight through: `takes(yes())`
                # was invalid IR. See bool_reg_is_i1 (AGAST #1646).
                var bool_arg_expr: *Expr = e.args
                var bk: i32 = 0
                while bk < j and bool_arg_expr != null
                    bool_arg_expr = bool_arg_expr.next
                    bk = bk + 1
                var bool_already_i1: i32 = 0
                if bool_arg_expr != null
                    if bool_reg_is_i1(s, bool_arg_expr) == 1
                        bool_already_i1 = 1
                if bool_already_i1 == 1
                    converted_regs[j] = arg_regs[j]
                else
                    let bool_trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, bool_trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i1\n")
                    converted_regs[j] = bool_trunc
            else if param_ptr.param_type == TYPE_F32 or param_ptr.param_type == TYPE_F64
                # Callee expects float / double.  Coerce based on actual arg
                # type: int → sitofp; double-when-target-is-float → fptrunc;
                # already-matching float passthrough.  The arg expression's
                # type tells us which path (default lit-int → i64 → sitofp).
                var f_arg_expr: *Expr = e.args
                var fk: i32 = 0
                while fk < j and f_arg_expr != null
                    f_arg_expr = f_arg_expr.next
                    fk = fk + 1
                var src_ty: i32 = TYPE_I64
                if f_arg_expr != null
                    src_ty = get_expr_type(s, f_arg_expr)
                if src_ty == TYPE_F32 and param_ptr.param_type == TYPE_F32
                    converted_regs[j] = arg_regs[j]
                else if src_ty == TYPE_F64 and param_ptr.param_type == TYPE_F64
                    converted_regs[j] = arg_regs[j]
                else if src_ty == TYPE_F64 and param_ptr.param_type == TYPE_F32
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = fptrunc double ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to float\n")
                    converted_regs[j] = trunc
                else if src_ty == TYPE_F32 and param_ptr.param_type == TYPE_F64
                    let ext: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ext)
                    emit_str(s, c" = fpext float ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to double\n")
                    converted_regs[j] = ext
                else
                    # Integer source: exact only, by its signedness (#2945).
                    converted_regs[j] = int_into_float_slot(s, arg_regs[j], f_arg_expr, param_ptr.param_type)
            else if param_ptr.param_type == TYPE_STRUCT and param_ptr.param_type_name != null and param_ptr.param_type_name_len > 4 and *(param_ptr.param_type_name + 0) == 'S' and *(param_ptr.param_type_name + 1) == 'p' and *(param_ptr.param_type_name + 2) == 'a' and *(param_ptr.param_type_name + 3) == 'n' and *(param_ptr.param_type_name + 4) == '$'
                # Port of ritz0 bedc85b: `@vec` -> Span<T> coercion at call site.
                # When the parameter is `Span<T>` and the argument is `@v` where
                # v is a Vec<T> local, materialize a Span struct from
                # { v.data, v.len } so the callee receives a proper slice view.
                var span_arg_expr: *Expr = e.args
                var sak: i32 = 0
                while sak < j and span_arg_expr != null
                    span_arg_expr = span_arg_expr.next
                    sak = sak + 1
                var coerced: i32 = 0
                # Array-value -> Span<T> coerce: when the actual is an
                # identifier bound to a TYPE_ARRAY local, construct
                # Span { &arr[0], N } using the declared array type.
                # (ritz-task-102)
                if span_arg_expr != null and span_arg_expr.kind == EXPR_IDENT
                    let arr_loc: *LocalVar = find_local_struct_name(s, span_arg_expr.ident_ptr, span_arg_expr.ident_len)
                    if arr_loc != null and arr_loc.var_type == TYPE_ARRAY
                        converted_regs[j] = emit_span_of_array(s, arr_loc, param_ptr.param_type_name, param_ptr.param_type_name_len)
                        coerced = 1
                if coerced == 0 and span_arg_expr != null and span_arg_expr.kind == EXPR_UNARY
                    if span_arg_expr.op == OP_ADDR and span_arg_expr.operand.kind == EXPR_IDENT
                        let src_loc: *LocalVar = find_local_struct_name(s, span_arg_expr.operand.ident_ptr, span_arg_expr.operand.ident_len)
                        if src_loc != null and src_loc.type_name_len > 4
                            if *(src_loc.type_name + 0) == 'V' and *(src_loc.type_name + 1) == 'e' and *(src_loc.type_name + 2) == 'c' and *(src_loc.type_name + 3) == '$'
                                # Convert the i64 arg (ptrtoint of alloca) back to ptr
                                let span_vec_ptr: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, span_vec_ptr)
                                emit_str(s, c" = inttoptr i64 ")
                                emit_reg(s, arg_regs[j])
                                emit_str(s, c" to ptr\n")
                                # GEP to data field (offset 0)
                                let sp_data_pp: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp_data_pp)
                                emit_str(s, c" = getelementptr %")
                                emit_name(s, src_loc.type_name, src_loc.type_name_len)
                                emit_str(s, c", ptr ")
                                emit_reg(s, span_vec_ptr)
                                emit_str(s, c", i32 0, i32 0\n")
                                let sp_data: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp_data)
                                emit_str(s, c" = load ptr, ptr ")
                                emit_reg(s, sp_data_pp)
                                emit_str(s, c"\n")
                                # GEP to len field (offset 1)
                                let sp_len_p: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp_len_p)
                                emit_str(s, c" = getelementptr %")
                                emit_name(s, src_loc.type_name, src_loc.type_name_len)
                                emit_str(s, c", ptr ")
                                emit_reg(s, span_vec_ptr)
                                emit_str(s, c", i32 0, i32 1\n")
                                let sp_len: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp_len)
                                emit_str(s, c" = load i64, ptr ")
                                emit_reg(s, sp_len_p)
                                emit_str(s, c"\n")
                                # Build Span { data, len }
                                let sp1: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp1)
                                emit_str(s, c" = insertvalue %")
                                emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                                emit_str(s, c" undef, ptr ")
                                emit_reg(s, sp_data)
                                emit_str(s, c", 0\n")
                                let sp2: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, sp2)
                                emit_str(s, c" = insertvalue %")
                                emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                                emit_str(s, c" ")
                                emit_reg(s, sp1)
                                emit_str(s, c", i64 ")
                                emit_reg(s, sp_len)
                                emit_str(s, c", 1\n")
                                converted_regs[j] = sp2
                                coerced = 1
                    # @array_ident -> Span<T>: construct Span { &arr[0], N }.
                    # (test_issue_span_slice_range: `tail_sum(@buf)` where
                    # buf is [4]u8.)  The inner-ident branch above already
                    # handles the bare `arr` case; this handles `@arr`
                    # which is EXPR_UNARY OP_ADDR wrapping EXPR_IDENT.
                    if coerced == 0 and span_arg_expr.operand.kind == EXPR_IDENT
                        let arr_loc2: *LocalVar = find_local_struct_name(s, span_arg_expr.operand.ident_ptr, span_arg_expr.operand.ident_len)
                        if arr_loc2 != null and arr_loc2.var_type == TYPE_ARRAY
                            span_array_elem_fits(s, span_arg_expr, arr_loc2, param_ptr.param_type_name, param_ptr.param_type_name_len)   # AGAST #2366
                            converted_regs[j] = emit_span_of_array(s, arr_loc2, param_ptr.param_type_name, param_ptr.param_type_name_len)
                            coerced = 1
                if coerced == 0
                    converted_regs[j] = arg_regs[j]
            else if param_ptr.param_type == TYPE_STRUCT and param_ptr.param_type_name_len == 7
                # Check if this is StrView (7 chars)
                var is_strview: i32 = 0
                if *(param_ptr.param_type_name + 0) == 'S' and *(param_ptr.param_type_name + 1) == 't'
                    if *(param_ptr.param_type_name + 2) == 'r' and *(param_ptr.param_type_name + 3) == 'V'
                        if *(param_ptr.param_type_name + 4) == 'i' and *(param_ptr.param_type_name + 5) == 'e'
                            if *(param_ptr.param_type_name + 6) == 'w'
                                is_strview = 1
                if is_strview == 1
                    # Get the argument expression to check if it's a string literal
                    var arg_expr: *Expr = e.args
                    var k: i32 = 0
                    while k < j and arg_expr != null
                        arg_expr = arg_expr.next
                        k = k + 1
                    let sv_lit: i32 = emit_strview_from_lit(s, arg_expr, arg_regs[j])
                    if sv_lit >= 0
                        converted_regs[j] = sv_lit
                    else
                        converted_regs[j] = arg_regs[j]
                else
                    converted_regs[j] = arg_regs[j]
            else
                # Final fallback for TYPE_STRUCT params not matched by any
                # specialised branch (StrView/Span/primitive).  ptr_value_
                # coercion regression: `sum_point(@p)` where p: PointI and
                # the callee takes PointI by value.  emit_expr(@p) emitted
                # i64 (ptrtoint of the alloca); we need %PointI value.  If
                # the arg is OP_ADDR/OP_ADDR_MUT and the param is a
                # struct, inttoptr+load to materialise the value.
                var fb_arg: *Expr = e.args
                var fk: i32 = 0
                while fk < j and fb_arg != null
                    fb_arg = fb_arg.next
                    fk = fk + 1
                var fb_done: i32 = 0
                if param_ptr.param_type == TYPE_STRUCT and param_ptr.param_type_name_len > 0
                    if fb_arg != null and fb_arg.kind == EXPR_UNARY
                        if fb_arg.op == OP_ADDR or fb_arg.op == OP_ADDR_MUT
                            let fb_pp: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, fb_pp)
                            emit_str(s, c" = inttoptr i64 ")
                            emit_reg(s, arg_regs[j])
                            emit_str(s, c" to ptr\n")
                            let fb_v: i32 = next_reg(s)
                            emit_str(s, c"  ")
                            emit_reg(s, fb_v)
                            emit_str(s, c" = load %")
                            emit_name(s, param_ptr.param_type_name, param_ptr.param_type_name_len)
                            emit_str(s, c", ptr ")
                            emit_reg(s, fb_pp)
                            emit_str(s, c"\n")
                            converted_regs[j] = fb_v
                            fb_done = 1
                if fb_done == 0
                    converted_regs[j] = arg_regs[j]
            param_ptr = param_ptr.next
        else
            # fn_def is null - external function, assume i64 for all args
            # But if argument is TYPE_MUT_REF, it's loaded as ptr, needs ptrtoint
            param_types[j] = TYPE_I64
            var arg_expr: *Expr = e.args
            var k: i32 = 0
            while k < j and arg_expr != null
                arg_expr = arg_expr.next
                k = k + 1
            # AGAST #176: Span$u8 / StrView -> i64 coercion (extern path).
            # When fn_def is missing we assume `i64` per arg; a %Span$u8
            # aggregate would otherwise flow through unchanged and fail IR
            # verification at the callsite.  The helper handles the resolve
            # + extractvalue + ptrtoint and returns -1 on no-match.
            let s176_ext_reg: i32 = try_emit_span_to_i64_arg(s, arg_expr, TYPE_I64, arg_regs[j])
            if s176_ext_reg >= 0
                converted_regs[j] = s176_ext_reg
            else
                var need_convert: i32 = 0
                if arg_expr != null
                    let arg_type: i32 = get_expr_type(s, arg_expr)
                    if arg_type == TYPE_MUT_REF
                        # Value is ptr, need to convert to i64
                        need_convert = 1
                if need_convert == 1
                    let pti: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, pti)
                    emit_str(s, c" = ptrtoint ptr ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c" to i64\n")
                    converted_regs[j] = pti
                else
                    converted_regs[j] = arg_regs[j]

    # Now emit the call with converted registers.  A typed indirect call
    # loads the fn pointer from its slot here, after the args.
    var icall_fp_reg: i32 = -1
    if callee_val >= 0
        icall_fp_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, icall_fp_reg)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, callee_val)
        emit_str(s, c" to ptr\n")
    else if icall_sig != null
        icall_fp_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, icall_fp_reg)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, icall_local)
        emit_str(s, c"\n")
    var call_result: i32 = 0
    # AGAST #1730 — a large struct comes back through a caller-owned slot
    # (also for typed indirect calls: the pointee was defined the same way).
    var call_sret: i32 = 0
    # [[callconv = "win64"]] on the callee, or on the fn type of a typed
    # indirect call (fn_def is then its signature) -- AGAST #1879.
    let call_cc: *u8 = fn_callconv_kw(fn_def)
    if struct_ret_uses_sret(s, ret_type, ret_struct_name, ret_struct_name_len) == 1
        call_sret = emit_sret_call_slot(s, ret_struct_name, ret_struct_name_len)
    if call_sret > 0
        call_result = next_reg(s)
        emit_str(s, c"  call ")
        emit_str(s, call_cc)
        emit_str(s, c"void ")
    else if ret_type == TYPE_VOID
        # void call - no result register assignment
        emit_str(s, c"  call ")
        emit_str(s, call_cc)
        emit_str(s, c"void ")
    else
        call_result = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, call_result)
        if ret_array_of(fn_def) != null
            # AGAST #2302: a `[N x T]` value, which emit_array_local_whole_assign
            # stores; a discarded call drops it.
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_fn_ret_llvm_type(s, fn_def)
            emit_str(s, c" ")
        else if ret_type == TYPE_STRUCT and ret_struct_name_len > 0
            # emit_llvm_type_struct routes tagged-enum Result$/Option$ to i64
            # (task-99 cluster #3).
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_llvm_type_struct(s, TYPE_STRUCT, ret_struct_name, ret_struct_name_len)
            emit_str(s, c" ")
        else if ret_type == TYPE_BOOL
            # Bool-returning fns emit `define i1 @f(...)`, so the call must
            # match: `call i1 @f(...)`.  Without this branch the call site
            # emits `call i64` and clang rejects the type mismatch.  The
            # zext-to-i64 happens below in the return-narrow block.
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i1 ")
        else if ret_type == TYPE_F32
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"float ")
        else if ret_type == TYPE_F64
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"double ")
        else if ret_type == TYPE_I32 or ret_type == TYPE_U32
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i32 ")
        else if ret_type == TYPE_I16 or ret_type == TYPE_U16
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i16 ")
        else if ret_type == TYPE_I8 or ret_type == TYPE_U8
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i8 ")
        else if ret_type == TYPE_MUT_REF
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"ptr ")
        else if ret_type == TYPE_PTR or ret_type == TYPE_REF
            # Match definition's return type (emit_llvm_type emits i64 for TYPE_PTR/TYPE_REF)
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i64 ")
        else
            emit_str(s, c" = call ")
            emit_str(s, call_cc)
            emit_str(s, c"i64 ")
    if icall_fp_reg >= 0
        emit_reg(s, icall_fp_reg)
    else
        emit_str(s, c"@")
        emit_name(s, full_name, full_len)
    emit_str(s, c"(")
    if call_sret > 0
        emit_sret_attr(s, ret_struct_name, ret_struct_name_len)
        emit_reg(s, call_sret)

    for j in 0..arg_count
        if j > 0 or call_sret > 0
            emit_str(s, c", ")
        if fn_def != null
            # Reset param_ptr to walk params again
            var p: *Param = fn_def.params
            var k: i32 = 0
            while k < j and p != null
                p = p.next
                k = k + 1
            if p != null
                emit_param_llvm_type(s, p)   # AGAST #1739
            else
                emit_str(s, c"i64")
        else
            emit_str(s, c"i64")
        emit_str(s, c" ")
        emit_reg(s, converted_regs[j])

    emit_str(s, c")\n")
    if call_sret > 0
        emit_sret_call_result(s, call_result, call_sret, ret_struct_name, ret_struct_name_len)

    # Extend smaller return types to i64 for consistent value representation
    if ret_type == TYPE_BOOL
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_I32
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i32 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_U32
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i32 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_I16
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i16 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_U16
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i16 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_I8
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = sext i8 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_U8
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i8 ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return ext
    else if ret_type == TYPE_STRUCT and ret_struct_name_len > 0 and is_primitive_type_name(ret_struct_name, ret_struct_name_len) == 1
        # Post-monomorph primitive return (vec_push_u16_method parity):
        # generic `T` substituted with u16/i32/etc. leaves TYPE_STRUCT in
        # the AST.  emit_llvm_type_struct emitted the LLVM primitive type
        # for the `call` opcode; now extend to i64 so the caller's
        # expression-level representation stays uniform.
        if name_eq(ret_struct_name, ret_struct_name_len, c"u8", 2) == 1
            let e8: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e8)
            emit_str(s, c" = zext i8 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e8
        else if name_eq(ret_struct_name, ret_struct_name_len, c"i8", 2) == 1
            let e8s: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e8s)
            emit_str(s, c" = sext i8 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e8s
        else if name_eq(ret_struct_name, ret_struct_name_len, c"u16", 3) == 1
            let e16: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e16)
            emit_str(s, c" = zext i16 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e16
        else if name_eq(ret_struct_name, ret_struct_name_len, c"i16", 3) == 1
            let e16s: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e16s)
            emit_str(s, c" = sext i16 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e16s
        else if name_eq(ret_struct_name, ret_struct_name_len, c"u32", 3) == 1
            let e32: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e32)
            emit_str(s, c" = zext i32 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e32
        else if name_eq(ret_struct_name, ret_struct_name_len, c"i32", 3) == 1
            let e32s: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, e32s)
            emit_str(s, c" = sext i32 ")
            emit_reg(s, call_result)
            emit_str(s, c" to i64\n")
            return e32s
        # bool/usize/isize/u64/i64/f32/f64: no extension.
        return call_result
    else if ret_type == TYPE_MUT_REF
        # TYPE_MUT_REF call returns ptr — convert to i64 for consistent value representation
        let pti: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, pti)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, call_result)
        emit_str(s, c" to i64\n")
        return pti
    # TYPE_PTR/TYPE_REF calls now return i64 directly — no conversion needed
    return call_result

# Option<T>.unwrap / .unwrap_or and Result<T,E>.unwrap / .unwrap_or — inline
# intrinsic matching the tag-encoded i64 representation that ritz1 uses for
# tagged enums (see emitter_match.ritz and is_variant_carrier in this file):
#   tag==1 payload   → Some(x) / Ok(x)  : (1 << 48) | (x & 0xFFFFFFFFFFFF)
#   tag==0 payload   → None / Err(x)    : (x & 0xFFFFFFFFFFFF)
#
# This mirrors ritz0's `_try_emit_enum_unwrap_method` (emitter_llvmlite.py
# ~line 7808) but works directly against the packed i64 rather than an
# { i8 tag, ... } struct.
#
# recv_value_reg: if non-negative, an i64 register already holding the
#   enum value (set by emit_expr_method when the receiver is a call
#   result). If -1, load from the stack slot `receiver_reg`.
# Returns an i64 register with the payload on success, -1 if this helper
# doesn't apply. (ritz-task-106)
fn try_emit_enum_unwrap(s: *EmitterState, e: *Expr, type_name: *u8, type_name_len: i32, receiver_reg: i32, recv_is_ptr_of_ptr: i32, recv_value_reg: i32) -> i32
    # Type must be Option$... or Result$...
    var is_opt: i32 = starts_with(type_name, type_name_len, c"Option$", 7)
    var is_res: i32 = starts_with(type_name, type_name_len, c"Result$", 7)
    if is_opt == 0 and is_res == 0
        return -1

    # Method must be "unwrap" (0 args) or "unwrap_or" (1 arg).
    var is_unwrap: i32 = 0
    var is_unwrap_or: i32 = 0
    if e.ident_len == 6
        if *(e.ident_ptr + 0) == 117   # u
            if *(e.ident_ptr + 1) == 110   # n
                if *(e.ident_ptr + 2) == 119   # w
                    if *(e.ident_ptr + 3) == 114   # r
                        if *(e.ident_ptr + 4) == 97    # a
                            if *(e.ident_ptr + 5) == 112    # p
                                is_unwrap = 1
    if e.ident_len == 9
        if *(e.ident_ptr + 0) == 117   # u
            if *(e.ident_ptr + 1) == 110   # n
                if *(e.ident_ptr + 2) == 119   # w
                    if *(e.ident_ptr + 3) == 114   # r
                        if *(e.ident_ptr + 4) == 97    # a
                            if *(e.ident_ptr + 5) == 112    # p
                                if *(e.ident_ptr + 6) == 95    # _
                                    if *(e.ident_ptr + 7) == 111   # o
                                        if *(e.ident_ptr + 8) == 114   # r
                                            is_unwrap_or = 1
    if is_unwrap == 0 and is_unwrap_or == 0
        return -1
    if is_unwrap == 1 and e.args != null
        return -1
    if is_unwrap_or == 1
        if e.args == null
            return -1

    # Materialise the receiver into a stack slot we can GEP against.  The
    # struct has shape `{ i8 tag, [N x i8] payload }` (ritz-task-133).
    #
    # Three receiver forms feed this helper:
    #   recv_value_reg >= 0          — aggregate value already in a register
    #                                  (EXPR_CALL / EXPR_METHOD chain).
    #   receiver_reg + recv_is_ptr_of_ptr==0 — ident holding the struct
    #                                  directly in its slot.
    #   receiver_reg + recv_is_ptr_of_ptr==1 — ident holding a pointer to
    #                                  the struct (rare in practice).
    var scrut_slot: i32 = 0
    if recv_value_reg >= 0
        scrut_slot = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, scrut_slot)
        emit_str(s, c" = alloca %")
        emit_name(s, type_name, type_name_len)
        emit_str(s, c"  ; unwrap scrut spill\n")
        emit_str(s, c"  store %")
        emit_name(s, type_name, type_name_len)
        emit_str(s, c" ")
        emit_reg(s, recv_value_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, scrut_slot)
        emit_str(s, c"\n")
    else
        scrut_slot = receiver_reg
        if recv_is_ptr_of_ptr == 1
            let loaded: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, loaded)
            emit_str(s, c" = load ptr, ptr ")
            emit_reg(s, receiver_reg)
            emit_str(s, c"\n")
            scrut_slot = loaded

    # tag = load i8 from field 0
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, scrut_slot)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_reg)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")

    # payload = the Ok / Some payload at field 2 (AGAST #1898), loaded at its
    # own width and widened to i64 because ritz1's call/arith paths expect
    # i64-width scalars; aggregate unwrap returns would need a more careful
    # type-oracle pass — deferred.
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, scrut_slot)
    emit_str(s, c", i32 0, i32 2\n")
    if is_unwrap == 1
        # AGAST #2594: a struct payload (`Option<P>`) loads as its `%P`, as
        # `?` does (emit_try's aggregate arm); an i64 load gave clang
        # `store %P <i64>`.  unwrap_or's select is still i64 (#2863).
        var pay_name_len: i32 = 0
        let pay_name: *u8 = tagged_enum_payload_named(s, type_name, type_name_len, @pay_name_len, 0)
        if pay_name != null
            let agg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, agg)
            emit_str(s, c" = load %")
            emit_name(s, pay_name, pay_name_len)
            emit_str(s, c", ptr ")
            emit_reg(s, pay_ptr)
            emit_str(s, c"  ; unwrap struct payload\n")
            return agg
    let payload: i32 = emit_tagged_payload_load(s, pay_ptr, type_name, type_name_len, 0)

    if is_unwrap == 1
        # unwrap(): return payload assuming tag==0 (Ok/Some).  ritz0 traps
        # on None/Err; we emit branchless IR that always yields the
        # payload, which is sufficient for the existing Wave-2 tests.
        return payload

    # unwrap_or(default): select payload when tag==0, else default.
    let tag_ok: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ok)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", 0  ; unwrap_or tag check (Ok/Some == 0)\n")

    let default_reg: i32 = emit_expr(s, e.args)
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = select i1 ")
    emit_reg(s, tag_ok)
    emit_str(s, c", i64 ")
    emit_reg(s, payload)
    emit_str(s, c", i64 ")
    emit_reg(s, default_reg)
    emit_str(s, c"\n")
    return result

# =============================================================================
# BitOps intrinsics on integer-primitive receivers (AGAST #1506)
# =============================================================================
#
# `x.rotl(3)` on a u32, `(state[d] ^ state[a]).rotl(16)` in cryptosec's
# chacha20.  Mirrors ritz0's _try_emit_bitops_intrinsic: the six BitOps
# methods on u8..u64 / i8..i64 lower to LLVM intrinsics at the receiver's
# REAL width.  ritz1 carries every integer in an i64 register, so the value
# is truncated to iN, the intrinsic runs at iN, and the result is extended
# back to i64 (sign-extended for a signed Self, zero-extended otherwise) —
# the same "consumers see i64" contract the Type_method fallback honours.
# A rotate done at i64 instead would be silently wrong (0x80000001 rotl 1
# is 3 at 32 bits, 0x100000002 at 64).

# Intrinsic declarations referenced by the current module: bit
# (method_id * 4 + width_index).  Cleared once emitted.
var g_bitops_decl_mask: i64 = 0

# 0 rotl, 1 rotr, 2 clz, 3 ctz, 4 popcnt, 5 swap_bytes; -1 otherwise.
fn bitops_method_id(name: *u8, len: i32) -> i32
    if len == 4
        if *(name) == 'r' and *(name + 1) == 'o' and *(name + 2) == 't'
            if *(name + 3) == 'l'
                return 0
            if *(name + 3) == 'r'
                return 1
    if len == 3
        if *(name + 1) == 'l' and *(name + 2) == 'z' and *(name) == 'c'
            return 2
        if *(name + 1) == 't' and *(name + 2) == 'z' and *(name) == 'c'
            return 3
    if len == 6
        if *(name) == 'p' and *(name + 1) == 'o' and *(name + 2) == 'p' and *(name + 3) == 'c' and *(name + 4) == 'n' and *(name + 5) == 't'
            return 4
    if len == 10
        let want: *u8 = c"swap_bytes"
        for i in 0..10
            if *(name + i) != *(want + i)
                return 0 - 1
        return 5
    0 - 1

# Bit width of an integer primitive, 0 for anything else (bool included).
fn int_prim_bits(t: i32) -> i32
    if t == TYPE_I8 or t == TYPE_U8
        return 8
    if t == TYPE_I16 or t == TYPE_U16
        return 16
    if t == TYPE_I32 or t == TYPE_U32
        return 32
    if t == TYPE_I64 or t == TYPE_U64
        return 64
    0

fn int_prim_signed(t: i32) -> i32
    if t == TYPE_I8 or t == TYPE_I16 or t == TYPE_I32 or t == TYPE_I64
        return 1
    0

# Static type of a BitOps receiver.  get_expr_type reports TYPE_I64 for any
# method call; a BitOps chain is refined here so `x.rotl(1).rotl(2)` rotates
# at x's width, as ritz0 does.  A binary keeps get_expr_type's left-operand
# typing — ritz0 also types `(0 | x)` as i64, and the two must agree.
fn int_method_recv_type(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_METHOD
        let mid: i32 = bitops_method_id(e.ident_ptr, e.ident_len)
        if mid == 2 or mid == 3 or mid == 4
            return TYPE_U8
        if mid >= 0
            return int_method_recv_type(s, e.left)
    if e.kind == EXPR_BINARY
        return int_method_recv_type(s, e.left)
    get_expr_type(s, e)

fn emit_bitops_intrinsic_name(s: *EmitterState, mid: i32, bits: i32)
    if mid == 0
        emit_str(s, c"@llvm.fshl.i")
    else if mid == 1
        emit_str(s, c"@llvm.fshr.i")
    else if mid == 2
        emit_str(s, c"@llvm.ctlz.i")
    else if mid == 3
        emit_str(s, c"@llvm.cttz.i")
    else if mid == 4
        emit_str(s, c"@llvm.ctpop.i")
    else
        emit_str(s, c"@llvm.bswap.i")
    emit_int(s, bits as i64)

# Emit `declare`s for every BitOps intrinsic this module called.  Called from
# emit_module's trailer; the mask is reset so a later module starts clean.
fn emit_bitops_intrinsic_decls(s: *EmitterState)
    var mid: i32 = 0
    while mid < 6
        var wi: i32 = 0
        while wi < 4
            let bit: i64 = (mid * 4 + wi) as i64
            let bits: i32 = 8 << wi
            wi = wi + 1
            if ((g_bitops_decl_mask >> bit) & 1) == 1
                emit_str(s, c"declare i")
                emit_int(s, bits as i64)
                emit_str(s, c" ")
                emit_bitops_intrinsic_name(s, mid, bits)
                emit_str(s, c"(i")
                emit_int(s, bits as i64)
                if mid == 0 or mid == 1
                    emit_str(s, c", i")
                    emit_int(s, bits as i64)
                    emit_str(s, c", i")
                    emit_int(s, bits as i64)
                else if mid == 2 or mid == 3
                    emit_str(s, c", i1")
                emit_str(s, c")\n")
        mid = mid + 1
    g_bitops_decl_mask = 0

# Lower `recv.<bitop>(args)` when the receiver is an integer primitive.
# recv_value_reg >= 0 means the receiver was already evaluated (call and
# method-chain receivers) and must not be evaluated again.  Returns -1 when
# this is not a BitOps call on an integer, leaving the caller's path intact.
fn try_emit_int_bitops(s: *EmitterState, e: *Expr, recv_value_reg: i32) -> i32
    let mid: i32 = bitops_method_id(e.ident_ptr, e.ident_len)
    if mid < 0
        return 0 - 1
    let rt: i32 = int_method_recv_type(s, e.left)
    let bits: i32 = int_prim_bits(rt)
    if bits == 0
        return 0 - 1
    var nargs: i32 = 0
    var a: *Expr = e.args
    while a != null
        nargs = nargs + 1
        a = a.next
    var want_args: i32 = 0
    if mid <= 1
        want_args = 1
    if nargs != want_args
        emit_ir_error(s, c"wrong number of arguments to integer BitOps method")
        let bad: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, bad)
        emit_str(s, c" = add i64 0, 0\n")
        return bad

    var recv: i32 = recv_value_reg
    if recv < 0
        recv = emit_expr(s, e.left)
    # swap_bytes on a byte is the identity (llvm.bswap has no i8 form).
    if mid == 5 and bits == 8
        return recv

    # Narrow the i64 receiver (and shift amount) to iN.
    var nrecv: i32 = recv
    if bits < 64
        nrecv = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, nrecv)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, recv)
        emit_str(s, c" to i")
        emit_int(s, bits as i64)
        emit_str(s, c"\n")
    var namt: i32 = 0
    if mid <= 1
        let amt: i32 = emit_expr(s, e.args)
        namt = amt
        if bits < 64
            namt = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, namt)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, amt)
            emit_str(s, c" to i")
            emit_int(s, bits as i64)
            emit_str(s, c"\n")

    var wi: i32 = 0
    if bits == 16
        wi = 1
    else if bits == 32
        wi = 2
    else if bits == 64
        wi = 3
    g_bitops_decl_mask = g_bitops_decl_mask | ((1 as i64) << ((mid * 4 + wi) as i64))

    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = call i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_bitops_intrinsic_name(s, mid, bits)
    emit_str(s, c"(i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, nrecv)
    if mid <= 1
        # rotl/rotr: funnel shift of x with itself by n.
        emit_str(s, c", i")
        emit_int(s, bits as i64)
        emit_str(s, c" ")
        emit_reg(s, nrecv)
        emit_str(s, c", i")
        emit_int(s, bits as i64)
        emit_str(s, c" ")
        emit_reg(s, namt)
    else if mid == 2 or mid == 3
        # is_zero_poison = false: a zero input yields the bit width.
        emit_str(s, c", i1 false")
    emit_str(s, c")\n")

    if bits == 64
        return r
    # Counts are u8 (zero-extend); Self results extend by Self's signedness.
    let widened: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, widened)
    if mid <= 1 or mid == 5
        if int_prim_signed(rt) == 1
            emit_str(s, c" = sext i")
        else
            emit_str(s, c" = zext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, r)
    emit_str(s, c" to i64\n")
    widened

# =============================================================================
# Float intrinsics on f32/f64 receivers (AGAST #1370)
# =============================================================================
#
# `x.ceil()`, `(x + 0.25).floor()`, `p.y.round()`, `n.abs()`.  Mirrors ritz0's
# _try_emit_float_intrinsic exactly:
#
#   abs   -> llvm.fabs.{f32,f64}  (an and-mask, never a libcall)
#   floor -> t = sitofp(fptosi x to i64); t > x ? t - 1 : t
#   ceil  -> t = sitofp(fptosi x to i64); t < x ? t + 1 : t
#   round -> trunc(x < 0 ? x - 0.5 : x + 0.5)      (half away from zero)
#
# floor/ceil/round are inline because llvm.floor & co. lower to libm
# libcalls on baseline x86-64 and ritz links no libc (AGAST #1321).  Valid
# for |x| < 2^63, as in ritz0.  Unlike the integer BitOps path the value
# stays in its `float` / `double` register: that is ritz1's float model.
#
# Primitive-receiver dispatch: emit_expr_method asks this before resolving
# a struct receiver (whose call / chain paths spill the value as i64, which a
# float is not); integer BitOps (try_emit_int_bitops, #1506) runs at the
# unresolved-receiver fallback.

# llvm.fabs declarations referenced by the current module: bit 0 f32, bit 1
# f64.  Cleared once emitted.
var g_float_decl_mask: i64 = 0

fn emit_float_llvm_ty(s: *EmitterState, ft: i32)
    if ft == TYPE_F32
        emit_str(s, c"float")
    else
        emit_str(s, c"double")

# Emit `declare`s for every float intrinsic this module called.  Called from
# emit_module's trailer, beside emit_bitops_intrinsic_decls.
fn emit_float_intrinsic_decls(s: *EmitterState)
    if (g_float_decl_mask & 1) == 1
        emit_str(s, c"declare float @llvm.fabs.f32(float)\n")
    if (g_float_decl_mask & 2) == 2
        emit_str(s, c"declare double @llvm.fabs.f64(double)\n")
    g_float_decl_mask = 0
    var k: i32 = 0
    while k < 16
        if ((g_fptoi_sat_mask >> k) & 1) == 1
            emit_str(s, c"declare ")
            fptoi_sat_name(s, k, 1)
            emit_str(s, c"(")
            emit_float_llvm_ty(s, fptoi_sat_src(k))
            emit_str(s, c")\n")
        k += 1
    g_fptoi_sat_mask = 0

# llvm.fpto[su]i.sat declarations referenced by the current module, one bit per
# (source width, signedness, target width): see fptoi_sat_key.  Cleared once
# emitted, by emit_float_intrinsic_decls.
var g_fptoi_sat_mask: i64 = 0

# Bit index for a saturating conversion: bit 3 = f64 source, bit 2 = unsigned,
# bits 0-1 = log2(target bits / 8).
fn fptoi_sat_key(ft: i32, bits: i32, unsigned: i32) -> i32
    var k: i32 = 3
    if bits == 8
        k = 0
    else if bits == 16
        k = 1
    else if bits == 32
        k = 2
    if unsigned == 1
        k = k + 4
    if ft != TYPE_F32
        k = k + 8
    k

fn fptoi_sat_src(k: i32) -> i32
    if (k & 8) == 8
        return TYPE_F64
    TYPE_F32

fn fptoi_sat_bits(k: i32) -> i32
    8 << (k & 3)

# `iN @llvm.fpto[su]i.sat.iN.f{32,64}`, without the `iN ` return type unless
# `with_ret`.
fn fptoi_sat_name(s: *EmitterState, k: i32, with_ret: i32)
    if with_ret == 1
        emit_str(s, c"i")
        emit_int(s, fptoi_sat_bits(k) as i64)
        emit_str(s, c" ")
    if (k & 4) == 4
        emit_str(s, c"@llvm.fptoui.sat.i")
    else
        emit_str(s, c"@llvm.fptosi.sat.i")
    emit_int(s, fptoi_sat_bits(k) as i64)
    if (k & 8) == 8
        emit_str(s, c".f64")
    else
        emit_str(s, c".f32")

# `x as <int>` for a float `x` of type ft (LANGUAGE_SPEC §7.5, AGAST #2192):
# round toward zero, saturate at the target's range, NaN is 0, then extend back
# to the i64 every integer is carried in, by the target's signedness.  A bare
# fptosi is poison out of range (`200.0 as u8` through an i8), and could not
# reach a u64 above 2^63 at all.  ritz0's _emit_float_to_int_sat.
pub fn emit_float_to_int_sat(s: *EmitterState, ft: i32, x: i32, target_ty: i32) -> i32
    var signed: i32 = 1
    let bits: i32 = type_code_scalar_bits(target_ty, @signed)
    if target_ty == TYPE_U64
        signed = 0
    let k: i32 = fptoi_sat_key(ft, bits, 1 - signed)
    g_fptoi_sat_mask = g_fptoi_sat_mask | (1 << k)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = call ")
    fptoi_sat_name(s, k, 1)
    emit_str(s, c"(")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, x)
    emit_str(s, c")\n")
    if bits == 64
        return r
    let ext: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ext)
    if signed == 1
        emit_str(s, c" = sext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, r)
    emit_str(s, c" to i64\n")
    ext

# `t = sitofp(fptosi(x))`: truncation toward zero through i64.
fn emit_float_trunc(s: *EmitterState, ft: i32, x: i32) -> i32
    let i: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, i)
    emit_str(s, c" = fptosi ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, x)
    emit_str(s, c" to i64\n")
    let t: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, t)
    emit_str(s, c" = sitofp i64 ")
    emit_reg(s, i)
    emit_str(s, c" to ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c"\n")
    t

# `<dst> = <op> T <a>, <constant>`
fn emit_float_binop_const(s: *EmitterState, op: *u8, ft: i32, a: i32, k: *u8) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = ")
    emit_str(s, op)
    emit_str(s, c" ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, a)
    emit_str(s, c", ")
    emit_str(s, k)
    emit_str(s, c"\n")
    r

# `<dst> = fcmp <pred> T <a>, <b>`
fn emit_float_fcmp(s: *EmitterState, pred: *u8, ft: i32, a: i32, b: i32) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = fcmp ")
    emit_str(s, pred)
    emit_str(s, c" ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, a)
    emit_str(s, c", ")
    emit_reg(s, b)
    emit_str(s, c"\n")
    r

# `<dst> = select i1 <c>, T <a>, T <b>`
fn emit_float_select(s: *EmitterState, ft: i32, cond: i32, a: i32, b: i32) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = select i1 ")
    emit_reg(s, cond)
    emit_str(s, c", ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, a)
    emit_str(s, c", ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, b)
    emit_str(s, c"\n")
    r

# Lower `recv.<ceil|floor|round|abs>()` when the receiver is f32/f64.
# Returns -1 when it is not, leaving emit_expr_method's paths intact; the
# receiver is not evaluated in that case.
fn try_emit_float_method(s: *EmitterState, e: *Expr) -> i32
    let ft: i32 = float_method_result_ty(s, e)
    if ft == 0
        return 0 - 1
    let mid: i32 = float_method_id(e.ident_ptr, e.ident_len)
    # Evaluated exactly once, whatever its shape (ident, binary, call, chain).
    let x: i32 = emit_expr(s, e.left)

    if mid == 3
        let r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, r)
        emit_str(s, c" = call ")
        emit_float_llvm_ty(s, ft)
        if ft == TYPE_F32
            emit_str(s, c" @llvm.fabs.f32(float ")
            g_float_decl_mask = g_float_decl_mask | 1
        else
            emit_str(s, c" @llvm.fabs.f64(double ")
            g_float_decl_mask = g_float_decl_mask | 2
        emit_reg(s, x)
        emit_str(s, c")\n")
        return r

    if mid == 1
        let t: i32 = emit_float_trunc(s, ft, x)
        let gt: i32 = emit_float_fcmp(s, c"ogt", ft, t, x)
        let m1: i32 = emit_float_binop_const(s, c"fsub", ft, t, c"1.0")
        return emit_float_select(s, ft, gt, m1, t)
    if mid == 0
        let t: i32 = emit_float_trunc(s, ft, x)
        let lt: i32 = emit_float_fcmp(s, c"olt", ft, t, x)
        let p1: i32 = emit_float_binop_const(s, c"fadd", ft, t, c"1.0")
        return emit_float_select(s, ft, lt, p1, t)

    # round: half away from zero.
    let neg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, neg)
    emit_str(s, c" = fcmp olt ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, c" ")
    emit_reg(s, x)
    emit_str(s, c", 0.0\n")
    let lo: i32 = emit_float_binop_const(s, c"fsub", ft, x, c"0.5")
    let hi: i32 = emit_float_binop_const(s, c"fadd", ft, x, c"0.5")
    let adj: i32 = emit_float_select(s, ft, neg, lo, hi)
    emit_float_trunc(s, ft, adj)

# `E.from(v)` on the bare name of an enum (not a local or global) that is
# still a method call here: monomorph rewrites every one into `E__from(v)`
# when the generated fn exists (rewrite_enum_from_call, in both its walk and
# its clones of generic bodies), so this is the enum without one -- the
# located error ritz0 gives (enum_from.py).  -1 when `e` is no such call.
fn try_emit_enum_from(s: *EmitterState, e: *Expr) -> i32
    if is_enum_from_call(e) == 0
        return 0 - 1
    if find_local(s, e.left.ident_ptr, e.left.ident_len) >= 0
        return 0 - 1
    if find_global(s, e.left.ident_ptr, e.left.ident_len) != null
        return 0 - 1
    emit_str(s, c"  ; ERROR: enum has no from\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c": enum '")
    eprint_bytes(e.left.ident_ptr, e.left.ident_len)
    eprints_cstr(c"' has no 'from': that needs a representation type ('enum ")
    eprint_bytes(e.left.ident_ptr, e.left.ident_len)
    eprints_cstr(c": <integer type>') and its module must import ritzlib.option\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# LANGUAGE_SPEC §5.4 (AGAST #2403): a `self` that's a pointer to a pointer
# takes the levels it asks for, so a place one level short of it is lent, as
# `@&recv` (`@recv` for `@*S`), the rule `name:& *U` has (§13.3).  Nothing else
# is borrowed for it: a call result, or a receiver two levels short, is
# refused.  `recv_levels` is what the receiver holds, -1 if unknown.  1 when
# it reported an error.
fn refuse_receiver_short_of_self(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32) -> i32
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return 0
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels >= want
        return 0
    if recv_levels + 1 == want and arg_is_place(s, recv) == 1
        # A `let` lends its own storage to a shared `self` only.
        if mfn.params.param_type != TYPE_REF
            let_check_receiver(s, recv)
        return 0
    emit_str(s, c"  ; ERROR: receiver short of `self` (AGAST #2403)\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_int(recv.span.line as i64)
    eprint_char(':')
    eprint_int(recv.span.col as i64)
    eprints_cstr(c": a receiver of a pointer `self` must be a place one level short of it, or have its levels\n")
    s.error_count = s.error_count + 1
    1

# AGAST #3071: 1 for `a[i]` of a local array, which emit_lvalue_ptr places.
fn recv_elem_is_local_array(s: *EmitterState, recv: *Expr) -> i32
    if recv.left == null or recv.left.kind != EXPR_IDENT
        return 0
    let arr: *LocalVar = find_local_struct_name(s, recv.left.ident_ptr, recv.left.ident_len)
    (arr != null and arr.var_type == TYPE_ARRAY) as i32

# AGAST #3071: `self: **S` (any `self` two levels or more from its struct) is
# passed at the levels it declares, from `base`, the receiver's place, which
# holds `recv_levels` pointers.  1 when it set `*out`.  A receiver with no
# place is an error here, not a `*S` passed as the `**S`.
fn pass_self_at_its_levels(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32, base: i32, out: *i32) -> i32
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return 0
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels + 1 < want
        return 0
    if base < 0
        emit_nd_error(s, recv.span.line, recv.span.col, c"this receiver of a `self` two levels from its struct isn't lowered (AGAST #2404)")
        return 0
    *out = emit_load_levels(s, base, recv_levels + 1 - want)
    1

# AGAST #2404: the levels between `recv` and its struct when it's a `**S` or
# deeper that no arm of emit_expr_method names: a global (`var G: **S`), an
# element of a `[N]**S` array, or `a[i]` through a `***S`.  ptr_levels_of types
# all but the last; `a[i]` on a pointer is one level short of `a`.  0 otherwise,
# with *out_name / *out_len the struct's name when it isn't.
fn recv_ptr_ptr_levels(s: *EmitterState, recv: *Expr, out_name: **u8, out_len: *i32) -> i32
    var inner: i32 = TYPE_VOID
    var levels: i32 = 0
    if recv.kind == EXPR_IDENT or recv.kind == EXPR_INDEX
        levels = ptr_levels_of(s, recv, @inner, out_name, out_len)
    if levels == 0 and recv.kind == EXPR_INDEX and recv.left != null and (recv.right == null or recv.right.kind != EXPR_RANGE)
        levels = ptr_levels_of(s, recv.left, @inner, out_name, out_len) - 1
    if levels < 2 or inner != TYPE_STRUCT or *out_len <= 0
        *out_name = null
        *out_len = 0
        return 0
    levels

fn emit_expr_method(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    bool_check_method(s, e)    # AGAST #2342
    literal_method(s, e)       # AGAST #2341
    # Method call: receiver.method(args)
    # e.left is the receiver expression
    # e.ident_ptr/ident_len is the method name
    # e.args is the argument list
    #
    # Strategy: Determine receiver type, mangle to Type_method, call with receiver as first arg
    #
    # Receiver kinds handled:
    #   EXPR_IDENT  — look up the local binding's struct type
    #   EXPR_CALL   — resolve callee return type, materialise the struct
    #                 value into a stack slot for ptr-passing dispatch
    #                 (ritz-task-106)
    #   EXPR_METHOD — recursive chain `a.foo().bar()`; we emit the inner
    #                 call for value correctness but can only resolve the
    #                 outer method through an intrinsic that doesn't need
    #                 a resolved struct type, since the inner method's
    #                 return type isn't indexed in ritz1's impl table
    #                 yet. (ritz-task-106)
    var type_name: *u8 = null
    var type_name_len: i32 = 0
    var receiver_reg: i32 = 0
    # 1 when the stack slot holds a pointer value (e.g. parameter *Vec<T>);
    # 0 when it holds the struct body directly (e.g. local Vec<T> binding).
    var recv_is_ptr_of_ptr: i32 = 0
    var elem_recv: *u8 = null   # AGAST #2332
    var elem_recv_len: i32 = 0
    # Non-negative when the receiver's i64 value has already been computed
    # in a register (EXPR_CALL / EXPR_METHOD paths). -1 means "materialise
    # by loading from the stack slot". Used by tagged-enum intrinsics that
    # work against the i64 value directly rather than a ptr.
    var recv_value_reg: i32 = 0 - 1
    # Pointers between what the receiver holds and its struct, for a `self: **S`
    # (AGAST #2403); -1 when the arm below didn't say.
    var recv_levels: i32 = 0 - 1
    # The receiver's place: a register pointing at what it holds, so
    # `recv_levels + 1` pointers from its struct, or -1 (AGAST #3071).  A
    # `self: **S` takes it, or what it holds, at the levels `self` declares.
    var recv_base: i32 = 0 - 1

    # Float-primitive receiver: ceil/floor/round/abs (AGAST #1370).  Before
    # any receiver resolution: the call / chain arms below spill the receiver
    # as an i64, and a float lives in a `float` / `double` register.  A
    # struct receiver is never float-typed, so no impl method is shadowed.
    let fmeth: i32 = try_emit_float_method(s, e)
    if fmeth >= 0
        return fmeth

    # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum value,
    # not a method call.  Before the impl lookup: in ritz0 a variant wins
    # over an impl method of the same name (a local named `Opt` still
    # shadows the enum; qualified_variant checks that).
    var qvi: i32 = 0
    let qei: i32 = qualified_variant(s, e, @qvi)
    if qei >= 0
        return emit_qualified_variant_ctor(s, e, qei, qvi)

    # `E.from(v)` for an enum with no generated `from` (LANGUAGE_SPEC §10.4).
    let from_reg: i32 = try_emit_enum_from(s, e)
    if from_reg != 0 - 1
        return from_reg

    # `Span.empty()`: T from the slot, not a receiver (AGAST #2296).
    let span_assoc: i32 = try_emit_span_assoc(s, e)
    if span_assoc != 0 - 1
        return span_assoc

    # Static-method dispatch: `Vec2.new(...)`.  When the LHS ident matches
    # a STRUCT or IMPL name (and not a local/global), we don't pass a
    # receiver — emit a direct call to `<Type>_<method>(args)` and return.
    # Mirrors ritz0's static-method path (Type.method desugars to a free
    # call against the impl table entry without a self argument).  Must
    # come BEFORE the local-lookup branch so a struct named like a local
    # variable still routes correctly.
    if e.left.kind == EXPR_IDENT
        let static_loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        let static_glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
        if static_loc == null and static_glob == null
            # Look for an impl block whose type_name matches the LHS ident.
            var sib: *ImplBlock = s.module.impls
            var sm_method: *FnDef = null
            while sib != null and sm_method == null
                if sib.type_name_len == e.left.ident_len
                    var nm_eq: i32 = 1
                    for i in 0..sib.type_name_len
                        if *(sib.type_name + i) != *(e.left.ident_ptr + i)
                            nm_eq = 0
                    if nm_eq == 1
                        var sm_it: *FnDef = sib.methods
                        while sm_it != null and sm_method == null
                            if sm_it.name_len == e.ident_len
                                var meth_eq: i32 = 1
                                for j in 0..sm_it.name_len
                                    if *(sm_it.name + j) != *(e.ident_ptr + j)
                                        meth_eq = 0
                                if meth_eq == 1
                                    sm_method = sm_it
                            sm_it = sm_it.next
                sib = sib.next
            if sm_method != null
                note_method_callee(s, e, sm_method)   # AGAST #2237
                if refuse_array_return(s, e, sm_method) == 1
                    return 0
                # A receiver is what `self` takes, and a type isn't one, as in
                # ritz0 (AGAST #2393).
                if param_self_is_value(sm_method.params) == 1
                    emit_ir_error(s, c"static method call Type.method() but the method expects a `self` parameter")
                    return 0
                # Evaluate args first.
                let sm_arg_regs: *i32 = call_reg_slots(e.args, 0)
                var sm_arg_count: i32 = 0
                var sm_arg: *Expr = e.args
                # No receiver: params line up from the head (AGAST #1498).
                var sm_ap: *Param = sm_method.params
                while sm_arg != null
                    check_struct_ptr_arg(s, e, e.ident_ptr, e.ident_len, sm_arg_count + 1, sm_arg, sm_ap)
                    check_array_arg(s, e, e.ident_ptr, e.ident_len, sm_arg_count + 1, sm_arg, sm_ap)
                    sm_arg_regs[sm_arg_count] = emit_call_arg(s, sm_arg, sm_ap)
                    sm_arg_count = sm_arg_count + 1
                    if sm_ap != null
                        sm_ap = sm_ap.next
                    sm_arg = sm_arg.next
                # Coerce args to formal param widths.  The static dispatch
                # has NO self/receiver, so we walk method.params from the
                # head (no skip).  Float-narrow lit→f32 via fptrunc when
                # the param type is f32 — same pattern as f32-aware var-decl
                # narrowing (commit 960a388).  Integer and bool args are
                # trunc'd to the param width like the instance arm's
                # (AGAST #1733).  Other types pass-through.
                let sm_conv: *i32 = call_reg_slots(e.args, 0)
                var sm_p: *Param = sm_method.params
                var sm_arg_e: *Expr = e.args
                for k in 0..sm_arg_count
                    sm_conv[k] = sm_arg_regs[k]
                    if sm_p != null
                        let sm_nrw: *u8 = method_arg_narrow_suffix(s, sm_p, sm_arg_e)
                        if sm_nrw != null
                            sm_conv[k] = emit_method_arg_trunc(s, sm_arg_regs[k], sm_nrw)
                        else if param_takes_addr_value(s, sm_arg_e, sm_p) == 1
                            sm_conv[k] = i64_value_to_ptr(s, sm_arg_e, sm_arg_regs[k])   # AGAST #2287
                        else if sm_p.param_type == TYPE_F32 or sm_p.param_type == TYPE_F64
                            # A float literal is a double, an int one an i64
                            # (AGAST #2561: `P.st(2)` passed `float %<i64>`).
                            sm_conv[k] = method_float_arg(s, sm_p, sm_arg_e, sm_arg_regs[k])
                        sm_p = sm_p.next
                    if sm_arg_e != null
                        sm_arg_e = sm_arg_e.next
                # Emit the call: %r = call <ret_type> @<Type>_<method>(args)
                # AGAST #1730 — large struct results come back via an sret slot.
                var sm_sret: i32 = 0
                if struct_ret_uses_sret(s, sm_method.return_type, sm_method.return_type_name, sm_method.return_type_name_len) == 1
                    sm_sret = emit_sret_call_slot(s, sm_method.return_type_name, sm_method.return_type_name_len)
                # A void method binds no result register (AGAST #1733, as
                # #1581 did for the instance arm): `%r = call void` is invalid.
                var sm_result: i32 = 0
                if sm_sret > 0
                    sm_result = next_reg(s)
                    emit_str(s, c"  call void")
                else if sm_method.return_type == TYPE_VOID
                    emit_str(s, c"  call void")
                else
                    sm_result = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, sm_result)
                    emit_str(s, c" = call ")
                    emit_fn_ret_llvm_type(s, sm_method)   # AGAST #2302: `-> [N]T` is `[N x T]`
                emit_str(s, c" @")
                emit_name(s, e.left.ident_ptr, e.left.ident_len)
                emit_str(s, c"_")
                emit_name(s, e.ident_ptr, e.ident_len)
                emit_str(s, c"(")
                if sm_sret > 0
                    emit_sret_attr(s, sm_method.return_type_name, sm_method.return_type_name_len)
                    emit_reg(s, sm_sret)
                var sm_p2: *Param = sm_method.params
                for k in 0..sm_arg_count
                    if k > 0 or sm_sret > 0
                        emit_str(s, c", ")
                    if sm_p2 != null
                        emit_param_llvm_type(s, sm_p2)   # AGAST #1739
                        sm_p2 = sm_p2.next
                    else
                        emit_str(s, c"i64")
                    emit_str(s, c" ")
                    emit_reg(s, sm_conv[k])
                emit_str(s, c")\n")
                # Register the extern like the instance arm does (#1518): a
                # method from an imported impl has its body in the owning
                # module's .ll and needs a `declare` here (AGAST #2568).
                # emit_extern_declarations skips one this .ll defines
                # (is_local_function), so no local check is needed here.
                add_method_extern(s, e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len)
                if sm_sret > 0
                    emit_sret_call_result(s, sm_result, sm_sret, sm_method.return_type_name, sm_method.return_type_name_len)
                    return sm_result
                # AGAST #1962: a narrow result (`call i32 @C_get`) must be
                # widened to the i64 value model like the instance arm's,
                # or `return C.get(...)` from an i32 fn truncs an i32 reg.
                return widen_method_result(s, sm_result, sm_method.return_type)
    # AGAST #2550: `(@d).m()` and `(@&d).m()` dispatch on `d`, as in ritz0 —
    # the receiver is auto-borrowed anyway, so the address-of names the
    # same place.  Its `@T`-into-`@&T` refusal already ran in the checker.
    var recv: *Expr = e.left
    while recv.kind == EXPR_UNARY and (recv.op == OP_ADDR or recv.op == OP_ADDR_MUT) and recv.operand != null
        recv = recv.operand
    if recv.kind == EXPR_IDENT
        # Look up the receiver type from locals
        let loc: *LocalVar = find_local_struct_name(s, recv.ident_ptr, recv.ident_len)
        if loc != null
            type_name = loc.type_name
            type_name_len = loc.type_name_len
            # Get address of receiver for auto-borrowing
            receiver_reg = loc.reg
            # Pointer-typed locals (*T, @T, @@T) spill an i64 into the slot;
            # the slot therefore points at a pointer, not at the struct.
            # AGAST #2372: `**S` and `@*S` are further from it; load down to the
            # slot that holds the `*S`.
            recv_levels = local_struct_levels(loc)
            recv_base = loc.reg
            if recv_levels > 0
                receiver_reg = emit_load_levels(s, loc.reg, recv_levels - 1)
                recv_is_ptr_of_ptr = 1
        else
            # AGAST #2044: a global receiver (`g_p.get()`).  A struct
            # global's address `@g` is the receiver itself (auto-borrowed,
            # so a mutating method writes the global); a `*S` global holds
            # a pointer in `@g`, so it is dispatched ptr-of-ptr, like a
            # pointer-typed local (cf. emit_member_ptr's #1892 arm).
            let rglob: *GlobalVarDef = find_global(s, recv.ident_ptr, recv.ident_len)
            if rglob != null
                var rg_ptr_of_ptr: i32 = -1
                if rglob.var_type == TYPE_STRUCT and rglob.type_name_len > 0
                    type_name = rglob.type_name
                    type_name_len = rglob.type_name_len
                    rg_ptr_of_ptr = 0
                else if rglob.var_type == TYPE_PTR and rglob.pointee_type == TYPE_STRUCT and rglob.pointee_type_name_len > 0
                    type_name = rglob.pointee_type_name
                    type_name_len = rglob.pointee_type_name_len
                    rg_ptr_of_ptr = 1
                if rg_ptr_of_ptr >= 0
                    # Name `@g` as a register so every dispatcher below can
                    # take it like a local's slot.
                    let rg_reg: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, rg_reg)
                    emit_str(s, c" = getelementptr i8, ptr @")
                    emit_name(s, rglob.name, rglob.name_len)
                    emit_str(s, c", i64 0  ; global receiver\n")
                    receiver_reg = rg_reg
                    recv_is_ptr_of_ptr = rg_ptr_of_ptr
                    recv_levels = rg_ptr_of_ptr
                    recv_base = rg_reg
    else if recv.kind == EXPR_INDEX and index_through_struct(s, recv, @elem_recv, @elem_recv_len) == 1 and elem_recv != null
        # AGAST #2443: `p[i].m()` through a `*`, `@` or `@&` Vec, Span or String
        # (R9), and `v[i].m()` on one: the element's address is the receiver, so
        # a mutating method writes the element in place.
        receiver_reg = emit_through_elem_ptr(s, recv, @elem_recv, @elem_recv_len)
        type_name = elem_recv
        type_name_len = elem_recv_len
        recv_is_ptr_of_ptr = 0
        recv_levels = 0
    else if recv.kind == EXPR_INDEX and array_elem_pointee(s, recv, @elem_recv, @elem_recv_len) == TYPE_STRUCT
        # AGAST #2332: `a[i].m()` with `a: [N]*S`: the element IS the receiver.
        var elem_ptr: i32 = 0
        if recv_elem_is_local_array(s, recv) == 1
            # AGAST #3071: a local array's element is a place, so a `self: **S`
            # can take it.  Its index runs once: the element loads from it.
            recv_base = emit_lvalue_ptr(s, recv)
            elem_ptr = emit_load_ptr(s, recv_base)
        else
            let elem_val: i32 = emit_expr(s, recv)
            elem_ptr = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, elem_ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, elem_val)
            emit_str(s, c" to ptr\n")
        type_name = elem_recv
        type_name_len = elem_recv_len
        receiver_reg = elem_ptr
        recv_is_ptr_of_ptr = 0
        recv_levels = 1
    else if recv.kind == EXPR_INDEX and recv.left != null and recv.left.kind == EXPR_IDENT and (recv.right == null or recv.right.kind != EXPR_RANGE)
        # AGAST #1981: `arr[i].m()` on a local `[N]St` -- the element's
        # address is the receiver, dispatched in place (a mutating method
        # such as Vec.push writes the array slot, not a copy).  Mirrors
        # emit_member_ptr's `arr[i].field` arm.  Without it the receiver
        # type went unresolved ("cannot determine receiver type").
        let arr_loc: *LocalVar = find_local_struct_name(s, recv.left.ident_ptr, recv.left.ident_len)
        if arr_loc != null and arr_loc.var_type == TYPE_ARRAY and arr_loc.array_elem_type == TYPE_STRUCT and arr_loc.type_name_len > 0
            let arr_idx: i32 = emit_expr(s, recv.right)
            let arr_elem: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, arr_elem)
            emit_str(s, c" = getelementptr [")
            emit_int(s, arr_loc.array_size as i64)
            emit_str(s, c" x %")
            emit_name(s, arr_loc.type_name, arr_loc.type_name_len)
            emit_str(s, c"], ptr ")
            emit_reg(s, arr_loc.reg)
            emit_str(s, c", i64 0, i64 ")
            emit_reg(s, arr_idx)
            emit_str(s, c"\n")
            type_name = arr_loc.type_name
            type_name_len = arr_loc.type_name_len
            receiver_reg = arr_elem
            recv_is_ptr_of_ptr = 0
            recv_levels = 0
    else if recv.kind == EXPR_INDEX and recv.left != null and (recv.left.kind == EXPR_CALL or recv.left.kind == EXPR_METHOD) and recv.right != null and recv.right.kind != EXPR_RANGE and call_ptr_elem_struct(s, recv.left) != null
        # AGAST #2299: `mkp()[i].m()` with `mkp() -> *S`: element i of what the
        # call points at is a place, as emit_member_ptr's `mkp()[i].f` arm
        # (#2870) has it, so a mutating method writes it in place.  The call
        # and the index are emitted once each.
        let pe_st: *StructDef = call_ptr_elem_struct(s, recv.left)
        type_name = pe_st.name
        type_name_len = pe_st.name_len
        receiver_reg = emit_ptr_elem_addr(s, recv, pe_st)
        recv_is_ptr_of_ptr = 0
        recv_levels = 0
    else if recv.kind == EXPR_CALL
        # Receiver is a direct call. Resolve its callee's return type name
        # so we know which struct we're calling a method on, then emit the
        # call itself and materialise the result into a stack slot so the
        # ptr-dispatch fallback paths still have something to pass.
        # (ritz-task-106)
        let fn_def: *FnDef = find_call_fn(s, recv)
        if fn_def != null
            if fn_def.return_type == TYPE_STRUCT
                if fn_def.return_type_name_len > 0
                    type_name = fn_def.return_type_name
                    type_name_len = fn_def.return_type_name_len
        # AGAST #2946: a `*S` return (`sp(@s).me()`) names S too, and the
        # returned pointer itself is the receiver -- not a spill of it (as the
        # EXPR_METHOD arm, #2883).
        var call_ptr_st: *StructDef = null
        if type_name_len == 0
            call_ptr_st = call_result_ptr_struct(s, recv)
        # AGAST #2399: a `**S` or `@*S` return, loaded down to S's address.
        var call_lv_st: *StructDef = null
        var call_levels: i32 = 0
        if type_name_len == 0 and call_ptr_st == null
            call_levels = call_result_struct_levels(s, recv, @call_lv_st)
        recv_value_reg = emit_expr(s, recv)
        var call_slot: i32 = 0
        if call_levels >= 2
            type_name = call_lv_st.name
            type_name_len = call_lv_st.name_len
            call_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, call_slot)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c" to ptr  ; call-result levels receiver\n")
            call_slot = emit_load_levels(s, call_slot, call_levels - 1)
        else if call_ptr_st != null
            type_name = call_ptr_st.name
            type_name_len = call_ptr_st.name_len
            call_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, call_slot)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c" to ptr  ; *S call-result receiver\n")
        else if type_name_len > 0 and own_temp_slot_of(s, recv_value_reg) > 0
            # AGAST #2262: a temporary's slot is the receiver, so the method
            # and the temporary's drop see one value.
            call_slot = own_temp_slot_of(s, recv_value_reg)
        else if type_name_len > 0 and s.sret_last_slot > 0 and s.sret_last_val == recv_value_reg
            # AGAST #2073: an sret call already left its result in memory
            # (emit_sret_call_result loaded `recv_value_reg` from that
            # slot), so the slot itself is the receiver -- no copy.
            call_slot = s.sret_last_slot
        else if type_name_len > 0 and is_primitive_type_name(type_name, type_name_len) == 0
            # A struct-valued result (tagged enum, ritz-task-133; any user
            # struct, AGAST #2073) is a real `%S` value: alloca / store at
            # the struct type, or clang rejects `store i64 %<%S>`.
            call_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, call_slot)
            emit_str(s, c" = alloca %")
            emit_name(s, type_name, type_name_len)
            emit_str(s, c"  ; method-on-call-result (struct value)\n")
            emit_str(s, c"  store %")
            emit_name(s, type_name, type_name_len)
            emit_str(s, c" ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, call_slot)
            emit_str(s, c"\n")
        else
            call_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, call_slot)
            emit_str(s, c" = alloca i64  ; method-call-on-call-result receiver\n")
            emit_str(s, c"  store i64 ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, call_slot)
            emit_str(s, c"\n")
        receiver_reg = call_slot
        recv_is_ptr_of_ptr = 0
        recv_levels = (call_ptr_st != null) as i32
    else if recv.kind == EXPR_METHOD
        # Recursive chain: `a.foo().bar()`. Emit the inner method call to
        # get the value and spill it to a stack slot. We cannot name the
        # outer receiver's struct type without an impl-table lookup, so
        # type_name stays null and the stub fires unless an intrinsic that
        # ignores type_name matches.  Enum-unwrap is gated on a non-null
        # type_name so recursive chaining through `.unwrap()` isn't
        # supported yet. (ritz-task-106)
        # AGAST #2594: when the inner method returns a struct
        # (`c.me().tp(3)`), call_result_struct_name names it; the result is a
        # `%S` value, spilled at that type and dispatched like a call's.
        call_result_struct_name(s, recv, @type_name, @type_name_len)
        # AGAST #2883: a `*S` return (`s.me().me()`) names S too, and the
        # returned pointer itself is the receiver -- not a spill of it.
        var chain_ptr_st: *StructDef = null
        if type_name_len == 0
            chain_ptr_st = call_result_ptr_struct(s, recv)
        recv_value_reg = emit_expr(s, recv)
        var chain_slot: i32 = 0
        if chain_ptr_st != null
            type_name = chain_ptr_st.name
            type_name_len = chain_ptr_st.name_len
            chain_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, chain_slot)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c" to ptr  ; *S method-result receiver\n")
        else if type_name_len > 0 and own_temp_slot_of(s, recv_value_reg) > 0
            chain_slot = own_temp_slot_of(s, recv_value_reg)   # as the EXPR_CALL arm (#2262)
        else if type_name_len > 0 and s.sret_last_slot > 0 and s.sret_last_val == recv_value_reg
            chain_slot = s.sret_last_slot   # as the EXPR_CALL arm (#2073)
        else if type_name_len > 0 and is_primitive_type_name(type_name, type_name_len) == 0
            chain_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, chain_slot)
            emit_str(s, c" = alloca %")
            emit_name(s, type_name, type_name_len)
            emit_str(s, c"  ; method-on-method-result (struct value)\n")
            emit_str(s, c"  store %")
            emit_name(s, type_name, type_name_len)
            emit_str(s, c" ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, chain_slot)
            emit_str(s, c"\n")
        else
            type_name = null
            type_name_len = 0
            chain_slot = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, chain_slot)
            emit_str(s, c" = alloca i64  ; method-call-on-method-result receiver\n")
            emit_str(s, c"  store i64 ")
            emit_reg(s, recv_value_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, chain_slot)
            emit_str(s, c"\n")
        receiver_reg = chain_slot
        recv_is_ptr_of_ptr = 0
        recv_levels = (chain_ptr_st != null) as i32
    else if recv.kind == EXPR_STRUCT_LIT
        # Rvalue-struct receiver: `Point { x: 2.0 }.scale(...)`.  Spill
        # the struct literal into a stack slot and use that slot as the
        # receiver pointer, mirroring the pattern used for chained calls.
        # The struct lit's name (recv.ident_ptr/_len) IS the type name,
        # so we know which impl table to consult without value emission.
        type_name = recv.ident_ptr as *u8
        type_name_len = recv.ident_len
        let lit_slot: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, lit_slot)
        emit_str(s, c" = alloca %")
        emit_name(s, type_name, type_name_len)
        emit_str(s, c"  ; rvalue struct-lit receiver\n")
        emit_struct_lit_to_alloca(s, recv, lit_slot)
        receiver_reg = lit_slot
        recv_is_ptr_of_ptr = 0
        recv_levels = 0
    else if recv.kind == EXPR_MEMBER
        # Field receiver: `r.raw.push(9)`, `q.a.get()`, `o.q.a.get()`.
        # emit_member_ptr yields the field's address, which IS the
        # receiver pointer for in-place (auto-borrowed) dispatch — a
        # mutating method writes through to the field, not a copy.  A
        # pointer-typed field (`p: *T`) holds a pointer in that slot, so
        # it is dispatched ptr-of-ptr, like a pointer-typed local.
        # (AGAST #1512)
        var mres: MemberPtrResult
        emit_member_ptr(s, recv, @mres)
        if mres.success == 1 and mres.field != null
            let rf: *StructField = mres.field
            if rf.field_type_name_len > 0
                if rf.field_type == TYPE_STRUCT
                    type_name = rf.field_type_name
                    type_name_len = rf.field_type_name_len
                    receiver_reg = mres.reg
                    recv_is_ptr_of_ptr = 0
                    recv_levels = 0
                else if rf.field_type == TYPE_PTR or rf.field_type == TYPE_PTR_PTR or rf.field_type == TYPE_REF or rf.field_type == TYPE_MUT_REF
                    type_name = rf.field_type_name
                    type_name_len = rf.field_type_name_len
                    recv_levels = field_struct_levels(rf)
                    recv_base = mres.reg
                    receiver_reg = emit_load_levels(s, mres.reg, recv_levels - 1)   # AGAST #2372
                    recv_is_ptr_of_ptr = 1
    else if recv.kind == EXPR_UNARY and recv.op == OP_DEREF
        # AGAST #2145: `(*pp).m()` with pp a `**S` (param, local, field):
        # `*pp` is a `*S` value, so dispatch like a `*S` local -- the
        # loaded pp points at the slot holding the `*S` (ptr-of-ptr).
        # emit_deref_operand_ptr resolves pp the way emit_member_ptr's
        # `(*pp).w` arm (#1940) does.
        var dr_st: *StructDef = null
        var dr_levels: i32 = 0
        let dr_reg: i32 = emit_deref_operand_ptr(s, recv.operand, @dr_st, @dr_levels)
        if dr_reg != 0 and dr_levels == 1
            # AGAST #3109: a deref that leaves the struct itself, `(*(q + k)).m()`,
            # `(*q).m()`, `(**pp).m()`.  LARB R9 (#2175): `*p` is a place, so the
            # method runs on the pointee -- the loaded operand IS its address,
            # as a struct local's slot is.  The operand is emitted once, above.
            type_name = dr_st.name
            type_name_len = dr_st.name_len
            receiver_reg = dr_reg
            recv_is_ptr_of_ptr = 0
            recv_levels = 0
        # AGAST #2404: through a `***S` or deeper `*p` is a `**S`, and the
        # loaded p is that many loads from the slot holding the `*S`.
        else if dr_reg != 0 and dr_levels >= 2
            type_name = dr_st.name
            type_name_len = dr_st.name_len
            receiver_reg = emit_load_levels(s, dr_reg, dr_levels - 2)
            recv_is_ptr_of_ptr = 1
            recv_levels = dr_levels - 1
            recv_base = dr_reg

    # AGAST #2404: a `**S` or deeper that no arm above names (a global, an
    # element of a `[N]**S` or of a `***S`).  Evaluated once, then loaded down
    # to the slot holding the `*S`, as a `**S` local is.  A global or a local
    # array's element is a place, so a `self: **S` (#3071) takes it there.
    if type_name_len == 0 and receiver_reg == 0 and recv_value_reg < 0
        var pp_name: *u8 = null
        var pp_len: i32 = 0
        let pp_levels: i32 = recv_ptr_ptr_levels(s, recv, @pp_name, @pp_len)
        if pp_levels >= 2
            type_name = pp_name
            type_name_len = pp_len
            recv_is_ptr_of_ptr = 1
            recv_levels = pp_levels
            if recv.kind == EXPR_IDENT or recv_elem_is_local_array(s, recv) == 1
                recv_base = emit_lvalue_ptr(s, recv)
                receiver_reg = emit_load_levels(s, recv_base, pp_levels - 1)
            else
                let pp_val: i32 = emit_expr(s, recv)
                let pp_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, pp_ptr)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, pp_val)
                emit_str(s, c" to ptr  ; **S receiver\n")
                receiver_reg = emit_load_levels(s, pp_ptr, pp_levels - 2)

    # Tagged-enum intrinsic: Option/Result .unwrap / .unwrap_or. Needs a
    # resolved receiver struct name to know it's a tagged enum; runs
    # before the cannot-determine-receiver-type stub so EXPR_CALL
    # receivers with Option$/Result$ returns resolve cleanly without
    # needing ritzlib unwrap helpers that don't exist. (ritz-task-106)
    if type_name != null
        if type_name_len > 0
            let enum_unwrap: i32 = try_emit_enum_unwrap(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr, recv_value_reg)
            if enum_unwrap >= 0
                return enum_unwrap
            # `.is_some()` / `.is_ok()` and their negations on a receiver no
            # local names (AGAST #3061): inline, as on a local.
            let enum_pred: i32 = try_emit_enum_pred_at(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr)
            if enum_pred >= 0
                return enum_pred

    if type_name == null or type_name_len == 0
        # Integer-primitive receiver: BitOps intrinsics (AGAST #1506).
        # Only reached when no struct type resolved, so it cannot shadow
        # a user impl method of the same name.
        let bitop: i32 = try_emit_int_bitops(s, e, recv_value_reg)
        if bitop >= 0
            return bitop
        emit_ir_error(s, c"cannot determine receiver type for method call")
        let zero: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, zero)
        emit_str(s, c" = add i64 0, 0\n")
        return zero

    # Built-in method dispatchers (run BEFORE the default Type_method mangling).
    # Mirrors ritz0's Wave-1 dispatch chain — catches obvious intrinsic patterns
    # that ritz1 doesn't have impl-table entries for.

    # StrView.as_bytes() -> inline Span<u8>
    let sv_bytes: i32 = try_emit_strview_as_bytes(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr)
    if sv_bytes >= 0
        return sv_bytes

    # Vec/Span/StrView .len() -> direct field load
    let len_val: i32 = try_emit_len_builtin(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr)
    if len_val >= 0
        return len_val

    # UFCS dispatch: v.method(args) -> vec_method$T(&v, args)
    let ufcs: i32 = try_emit_ufcs_method(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr)
    if ufcs >= 0
        return ufcs

    # Span .ptr() / .is_empty() / .slice(lo, hi) with no method defining them
    let span_val: i32 = try_emit_span_builtin(s, e, type_name, type_name_len, receiver_reg, recv_is_ptr_of_ptr)
    if span_val >= 0
        return span_val

    # Fallback: Build mangled function name: Type_method
    # Emit: call <rt> @Type_method(ptr %receiver, args...)
    #
    # AGAST #113 — walk the impl blocks to find the method's FnDef so we can
    # coerce struct-ref args (auto-borrow) and narrow non-i64 return values.
    # Without the FnDef, fall back to the pre-#113 `call i64 @...(i64 ...)`.
    var mfn: *FnDef = null
    var ib_it: *ImplBlock = s.module.impls
    while ib_it != null and mfn == null
        if ib_it.type_name_len == type_name_len
            var ib_match: i32 = 1
            for i in 0..type_name_len
                if *(ib_it.type_name + i) != *(type_name + i)
                    ib_match = 0
            if ib_match == 1
                var mm: *FnDef = ib_it.methods
                while mm != null and mfn == null
                    if mm.name_len == e.ident_len
                        var name_match: i32 = 1
                        for i in 0..e.ident_len
                            if *(mm.name + i) != *(e.ident_ptr + i)
                                name_match = 0
                        if name_match == 1
                            mfn = mm
                    mm = mm.next
        ib_it = ib_it.next
    # AGAST #2096: a generic impl's method specialized at the receiver's type
    # (`w.dup()` on W<i32> -> `W$i32_dup`) lives in the module's functions,
    # not in an impl block.  Without its FnDef the call fell back to
    # `call i64`, against `define %W$i32` (or `define i32` for `-> T`).
    # It is defined as a free fn, so its `*W<T>` self is the i64 value-model
    # pointer, not the impl define's forced `ptr` (see recv_ty below).
    var mfn_is_spec: i32 = 0
    if mfn == null
        mfn = find_spec_impl_method(s, type_name, type_name_len, e.ident_ptr, e.ident_len)
        if mfn != null
            mfn_is_spec = 1
    note_method_callee(s, e, mfn)   # AGAST #2237
    if refuse_array_return(s, e, mfn) == 1
        return 0
    if refuse_receiver_short_of_self(s, recv, mfn, recv_levels) == 1
        return 0
    # AGAST #3071: a `self` two levels or more from its struct is the pointer
    # at those levels: the place of a receiver one short (lent, §5.4), or what
    # one with the levels holds.  Not the `*S` the dispatch below loads.
    if pass_self_at_its_levels(s, recv, mfn, recv_levels, recv_base, @receiver_reg) == 1
        recv_is_ptr_of_ptr = 0

    # A pointer-typed receiver (local, param or field `*T`) sits in a slot
    # that holds the pointer: load it and pass that, not the slot (AGAST #1692).
    if recv_is_ptr_of_ptr == 1
        let recv_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, recv_ptr)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, receiver_reg)
        emit_str(s, c"\n")
        receiver_reg = recv_ptr

    var self_param: *Param = null
    if mfn != null and param_self_is_value(mfn.params) == 1
        self_param = mfn.params
        receiver_reg = emit_self_value(s, self_param, receiver_reg)

    # First, evaluate all arguments and collect their registers
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    let conv_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg: *Expr = e.args
    # Params walked alongside, skipping self (AGAST #1498).
    var ap: *Param = null
    if mfn != null
        ap = mfn.params
        if ap != null
            ap = ap.next
    while arg != null
        # Receiver is argument 1, as ritz0 numbers it (AGAST #1948).
        check_struct_ptr_arg(s, e, e.ident_ptr, e.ident_len, arg_count + 2, arg, ap)
        check_array_arg(s, e, e.ident_ptr, e.ident_len, arg_count + 2, arg, ap)
        arg_regs[arg_count] = emit_call_arg(s, arg, ap)
        conv_regs[arg_count] = arg_regs[arg_count]
        arg_count = arg_count + 1
        if ap != null
            ap = ap.next
        arg = arg.next

    # Arg coerce — walk params (skip self) and auto-borrow struct-ref args.
    var mp: *Param = null
    if mfn != null
        mp = mfn.params
        if mp != null
            mp = mp.next
    for j in 0..arg_count
        if mp != null
            # Integer args are i64 registers; narrow them to the param width
            # like the free-fn and UFCS paths do, or the call passes an i64
            # register under an iN type (AGAST #1607, #1580).
            var mbe: *Expr = e.args
            var mbk: i32 = 0
            while mbk < j and mbe != null
                mbe = mbe.next
                mbk = mbk + 1
            let narrow_to: *u8 = method_arg_narrow_suffix(s, mp, mbe)
            if narrow_to != null
                conv_regs[j] = emit_method_arg_trunc(s, arg_regs[j], narrow_to)
            else if mp.param_type == TYPE_F32 or mp.param_type == TYPE_F64
                conv_regs[j] = method_float_arg(s, mp, mbe, arg_regs[j])   # AGAST #2561
            else if param_takes_addr_value(s, mbe, mp) == 1
                # AGAST #2287: as the free-call cascade does for any `@&T`.
                conv_regs[j] = i64_value_to_ptr(s, mbe, arg_regs[j])
            else if (mp.param_type == TYPE_REF or mp.param_type == TYPE_PTR or mp.param_type == TYPE_PTR_PTR) and expr_is_ptr_valued(s, mbe) == 1
                # AGAST #2416: `r.get(@&c)` into `c: @C`, as the free call does.
                # AGAST #3071: and `q.swap(@&e)` into `n: *C` (or `**C`).
                conv_regs[j] = ptr_value_to_i64(s, mbe, arg_regs[j])
            else if mp.param_type == TYPE_REF and mp.param_type_name_len > 0
                var mae: *Expr = e.args
                var mk: i32 = 0
                while mk < j and mae != null
                    mae = mae.next
                    mk = mk + 1
                if mae != null and mae.kind == EXPR_IDENT
                    let mloc: *LocalVar = find_local_struct_name(s, mae.ident_ptr, mae.ident_len)
                    if mloc != null and mloc.var_type == TYPE_STRUCT
                        let pti_m: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, pti_m)
                        emit_str(s, c" = ptrtoint ptr ")
                        emit_reg(s, mloc.reg)
                        emit_str(s, c" to i64\n")
                        conv_regs[j] = pti_m
            else if mp.param_type == TYPE_STRUCT and mp.param_type_name_len > 0 and param_uses_byval(s, mp) == 0
                # (A large struct is already its byval slot, AGAST #1739.)
                # Scalar→struct newtype boxing (mirrors the plain-call path).
                # Gate on a narrow scalar type — pointers and other structs
                # pass through so 2-field structs like Span<T> aren't
                # corrupted by the 8-byte opaque-ptr reinterpret.
                var mae2: *Expr = e.args
                var mk2: i32 = 0
                while mk2 < j and mae2 != null
                    mae2 = mae2.next
                    mk2 = mk2 + 1
                var is_scalar_int2: i32 = 0
                # A tagged or user enum, or `usize`, is never a scalar newtype
                # (param_takes_arg_unboxed).
                if param_takes_arg_unboxed(mp.param_type_name, mp.param_type_name_len) == 1
                    mae2 = null
                # A struct literal is already the `%T` aggregate (#1362).
                if mae2 != null and mae2.kind == EXPR_STRUCT_LIT
                    mae2 = null
                # So is `*r` of a `*T`, which get_expr_type reports as an i64.
                if mae2 != null and mae2.kind == EXPR_UNARY and mae2.op == OP_DEREF
                    var dname: *u8 = null
                    var dlen: i32 = 0
                    deref_pointee_struct_name(s, mae2.operand, @dname, @dlen)
                    if dlen > 0
                        mae2 = null
                # AGAST #2413: so is a call or method call returning a struct
                # (`r.add(S.mk(5))`, `r.add(q.me())`).  get_expr_type has no
                # struct arm for EXPR_METHOD and reports it as i64, so the box
                # below stored the `%S` register as an i64.
                if mae2 != null and (mae2.kind == EXPR_CALL or mae2.kind == EXPR_METHOD)
                    var cname: *u8 = null
                    var clen: i32 = 0
                    call_result_struct_name(s, mae2, @cname, @clen)
                    if clen > 0
                        mae2 = null
                if mae2 != null
                    let at2: i32 = get_expr_type(s, mae2)
                    if at2 == TYPE_I8 or at2 == TYPE_U8 or at2 == TYPE_I16 or at2 == TYPE_U16 or at2 == TYPE_I32 or at2 == TYPE_U32 or at2 == TYPE_I64 or at2 == TYPE_U64
                        is_scalar_int2 = 1
                if is_scalar_int2 == 1
                    let box_slot2: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, box_slot2)
                    emit_str(s, c" = alloca %")
                    emit_name(s, mp.param_type_name, mp.param_type_name_len)
                    emit_str(s, c"  ; newtype arg box\n")
                    emit_str(s, c"  store i64 ")
                    emit_reg(s, arg_regs[j])
                    emit_str(s, c", ptr ")
                    emit_reg(s, box_slot2)
                    emit_str(s, c"\n")
                    let boxed2: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, boxed2)
                    emit_str(s, c" = load %")
                    emit_name(s, mp.param_type_name, mp.param_type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, box_slot2)
                    emit_str(s, c"\n")
                    conv_regs[j] = boxed2
            mp = mp.next

    var rtype: i32 = TYPE_I64
    if mfn != null
        rtype = mfn.return_type

    # A specialized `Type$T_method` declares a pointer self (`*W<T>`, `@W<T>`)
    # as i64 (emit_llvm_type), so pass the receiver as one (AGAST #2096).
    var recv_ty: *u8 = c"ptr "
    if mfn_is_spec == 1 and mfn.params != null
        let sp: i32 = mfn.params.param_type
        if sp == TYPE_PTR or sp == TYPE_REF
            let recv_int: i32 = next_reg(s)
            format_into(s.out, "  %.{recv_int} = ptrtoint ptr %.{receiver_reg} to i64\n")
            receiver_reg = recv_int
            recv_ty = c"i64 "

    # Emit the call with the correct return type keyword.  A void method is
    # `call void` with no result register; binding one to `call i64` would
    # mismatch the `define void` (AGAST #1581).
    var result: i32 = 0
    # AGAST #1730 — large struct results come back via an sret slot.
    var m_sret: i32 = 0
    if mfn != null and struct_ret_uses_sret(s, rtype, mfn.return_type_name, mfn.return_type_name_len) == 1
        m_sret = emit_sret_call_slot(s, mfn.return_type_name, mfn.return_type_name_len)
    if m_sret > 0
        result = next_reg(s)
        emit_str(s, c"  call void @")
    else if rtype == TYPE_VOID
        emit_str(s, c"  call void @")
    else
        result = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
    # An sret call already wrote `call void @`; the result type keyword
    # below is for the first-class forms only.
    if m_sret == 0
        if rtype == TYPE_VOID
            result = 0
        else if ret_array_of(mfn) != null
            emit_str(s, c" = call ")
            emit_fn_ret_llvm_type(s, mfn)   # AGAST #2302: `[N x T]`
            emit_str(s, c" @")
        else if rtype == TYPE_BOOL
            emit_str(s, c" = call i1 @")
        else if rtype == TYPE_I32 or rtype == TYPE_U32
            emit_str(s, c" = call i32 @")
        else if rtype == TYPE_I16 or rtype == TYPE_U16
            emit_str(s, c" = call i16 @")
        else if rtype == TYPE_I8 or rtype == TYPE_U8
            emit_str(s, c" = call i8 @")
        else if rtype == TYPE_F32
            emit_str(s, c" = call float @")
        else if rtype == TYPE_F64
            emit_str(s, c" = call double @")
        else if rtype == TYPE_STRUCT and mfn != null and mfn.return_type_name_len > 0
            # Struct-returning impl methods (e.g. `clone_self(self) -> S`).
            # Match the `define weak_odr %S @S_clone_self(...)` signature
            # rather than the i64 fallback — clang rejects the type mismatch.
            emit_str(s, c" = call ")
            emit_llvm_type_struct(s, TYPE_STRUCT, mfn.return_type_name, mfn.return_type_name_len)
            emit_str(s, c" @")
        else
            emit_str(s, c" = call i64 @")
    emit_name(s, type_name, type_name_len)
    emit_str(s, c"_")
    emit_name(s, e.ident_ptr, e.ident_len)
    emit_str(s, c"(")
    if m_sret > 0
        emit_sret_attr(s, mfn.return_type_name, mfn.return_type_name_len)
        emit_reg(s, m_sret)
        emit_str(s, c", ")
    if self_param != null
        emit_param_llvm_type(s, self_param)
        emit_str(s, c" ")
    else
        emit_str(s, recv_ty)
    emit_reg(s, receiver_reg)

    # Emit args with formal types (or i64 fallback when fn_def missing).
    var mp2: *Param = null
    if mfn != null
        mp2 = mfn.params
        if mp2 != null
            mp2 = mp2.next
    for j in 0..arg_count
        emit_str(s, c", ")
        if mp2 != null
            emit_param_llvm_type(s, mp2)   # AGAST #1739
            mp2 = mp2.next
        else
            emit_str(s, c"i64")
        emit_str(s, c" ")
        emit_reg(s, conv_regs[j])
    emit_str(s, c")\n")
    if m_sret > 0
        emit_sret_call_result(s, result, m_sret, mfn.return_type_name, mfn.return_type_name_len)

    # Add method to extern declarations (uses malloc for stable name storage).
    # Skip it only when THIS .ll defines the body (is_local == 1): a `declare`
    # beside the local `define` is an invalid redefinition. A method found in
    # an imported impl (is_local == 0, AGAST #194) has its body in the owning
    # module's .ll, so it needs the declare like an unknown method (#1518).
    if mfn == null or mfn.is_local == 0
        add_method_extern(s, type_name, type_name_len, e.ident_ptr, e.ident_len)

    return widen_method_result(s, result, rtype)

# Arg narrow — the `trunc i64 ... to iN` suffix a method call's integer or
# bool arg needs to match its param `p`, or null when the i64 register passes
# as is (a wide or non-integer param, or a bool value that is already i1 —
# a bool global's load, see bool_reg_is_i1, AGAST #1646).  Shared by the
# instance (AGAST #1607) and static (`T.m(...)`, AGAST #1733) method arms.
fn method_arg_narrow_suffix(s: *EmitterState, p: *Param, arg: *Expr) -> *u8
    if p.param_type == TYPE_I8 or p.param_type == TYPE_U8
        return c" to i8\n"
    if p.param_type == TYPE_I16 or p.param_type == TYPE_U16
        return c" to i16\n"
    if p.param_type == TYPE_I32 or p.param_type == TYPE_U32
        return c" to i32\n"
    if p.param_type == TYPE_BOOL
        if arg != null
            if bool_reg_is_i1(s, arg) == 1
                return null
        return c" to i1\n"
    return null

# Float arg — coerce a method call's arg register `reg` to its `f32` / `f64`
# param `p`: fptrunc a double (a float literal is always one), fpext a float,
# sitofp an integer (an i64 register), as the free-call cascade does.  Returns
# `reg` for a non-float param or an arg already at the param's width.  Shared
# by the instance and static method arms (AGAST #2561): the instance arm had
# no float arm, so `a.lerp(b, 0.25)` passed `float %<double>`.
fn method_float_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    if p.param_type != TYPE_F32 and p.param_type != TYPE_F64
        return reg
    var src_ty: i32 = TYPE_I64
    if arg != null
        src_ty = get_expr_type(s, arg)
    if src_ty != TYPE_F32 and src_ty != TYPE_F64
        return int_into_float_slot(s, reg, arg, p.param_type)
    emit_float_coerce(s, reg, src_ty, p.param_type)

# TYPE_F32 / TYPE_F64 when param `p` is a float: declared so, or a generic
# `T` monomorph substituted with f32 / f64 and left TYPE_STRUCT.  Else 0.
fn param_float_type(p: *Param) -> i32
    if p.param_type == TYPE_F32 or p.param_type == TYPE_F64
        return p.param_type
    if p.param_type != TYPE_STRUCT
        return 0
    if name_eq(p.param_type_name, p.param_type_name_len, c"f32", 3) == 1
        return TYPE_F32
    if name_eq(p.param_type_name, p.param_type_name_len, c"f64", 3) == 1
        return TYPE_F64
    0

# A UFCS call's arg register `reg` coerced to its float param `p` (AGAST
# #2412): fptrunc a double, fpext a float, sitofp an integer.
fn ufcs_float_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    var src_ty: i32 = TYPE_I64
    if arg != null
        src_ty = get_expr_type(s, arg)
    if src_ty != TYPE_F32 and src_ty != TYPE_F64
        return int_into_float_slot(s, reg, arg, param_float_type(p))
    emit_float_coerce(s, reg, src_ty, param_float_type(p))

# Emit `%t = trunc i64 <reg><suffix>` and return %t.  One format_into
# rather than five emit_str / emit_reg calls (AGAST #1824).
fn emit_method_arg_trunc(s: *EmitterState, reg: i32, suffix: *u8) -> i32
    let t: i32 = next_reg(s)
    format_into(s.out, "  %.{t} = trunc i64 %.{reg}{suffix}")
    return t

# Return narrow — extend a method call's bool/i8/i16/i32 (and unsigned)
# result back to i64 so consumers see the i64 value-model register.  Shared
# by the instance and static (`T.m(...)`, AGAST #1962) method arms; any other
# return type passes through unchanged.
fn widen_method_result(s: *EmitterState, result: i32, rtype: i32) -> i32
    var nw_op: *u8 = null
    if rtype == TYPE_BOOL
        nw_op = c" = zext i1 "
    else if rtype == TYPE_I32
        nw_op = c" = sext i32 "
    else if rtype == TYPE_U32
        nw_op = c" = zext i32 "
    else if rtype == TYPE_I16
        nw_op = c" = sext i16 "
    else if rtype == TYPE_U16
        nw_op = c" = zext i16 "
    else if rtype == TYPE_I8
        nw_op = c" = sext i8 "
    else if rtype == TYPE_U8
        nw_op = c" = zext i8 "
    if nw_op != null
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, nw_op)
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return ext

    return result

