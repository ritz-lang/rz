# AGAST #1813: per-call register arrays, sized from the argument list.  They
# were `[16]i32` locals: two sites dropped arguments past the 16th (a 17-arg
# call passed 16 and miscompiled with exit 0); the others wrote past the
# array.  `min` reserves slots the caller appends beyond the written args.
# AGAST #3125: `Span<T>` is `{ ptr, len }`, so `.ptr()`, `.is_empty()` and
# `.slice(lo, hi)` are struct operations a module that only receives a span
# can call without importing ritzlib.span, as ritz0's
# _try_emit_builtin_span_method lowers them.  As there, a method the module
# does define (ritzlib.span's `is_empty` / `slice`, a UFCS `span_*` helper)
# wins: this runs only when method_callee_def finds none.  `receiver_reg` is
# the receiver the dispatcher already evaluated, read as try_emit_len_builtin
# reads it.  `.ptr()` is the i64 pointer value, `.is_empty()` the i64 0 / 1 a
# comparison gives, and `.slice(lo, hi)` a %Span$T view
# `{ ptr + lo, hi - lo }`.  Returns -1 when not applicable.
fn try_emit_span_builtin(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if not (StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Span$"), len: (5) as i64 })
        return -1
    var op: i32 = 0
    if e.args == null and name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"ptr"), len: (3) as i64 }) == 1
        op = 1
    else if e.args == null and name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_empty"), len: (8) as i64 }) == 1
        op = 2
    else if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"slice"), len: (5) as i64 }) == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            op = 3
    if op == 0
        return -1
    if method_callee_def(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return -1

    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, loaded, receiver_reg)
        struct_ptr = loaded

    # The field `.ptr()` reads (0) or the one the others start from (1).
    var field: i32 = 1
    if op == 1
        field = 0
    let fptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, struct_ptr)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, field as i64)
    emit_str(s, IR_NL)

    if op == 1
        let p: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, p, fptr)
        let pi: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, p)
        return pi

    if op == 2
        let n: i32 = next_reg(s)
        emit_load_into(s, IR_TY_I64, n, fptr)
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, n)
        emit_str(s, IR_COMMA_0)
        let b: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, z)
        return b

    # slice: the element's size scales `lo` into a byte offset.
    var align: i64 = 1
    let elem_size: i64 = mangled_type_size_align(s, StrView { ptr: (type_name + 5), len: (type_name_len - 5) as i64 }, @align)
    if elem_size <= 0 and is_unit_arg(StrView { ptr: (type_name + 5), len: (type_name_len - 5) as i64 }) == 0
        emit_ir_error(s, e.span, c"Span.slice: can't measure the element type")
        return 0
    let lo: i32 = emit_expr(s, e.args)
    let hi: i32 = emit_expr(s, e.args.next)
    let base_ptr_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, base_ptr_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, struct_ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let base_ptr: i32 = next_reg(s)
    emit_load_into(s, IR_TY_PTR, base_ptr, base_ptr_ptr)
    let off: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, off)
    emit_str(s, c" = mul i64 ")
    emit_reg(s, lo)
    emit_str(s, IR_COMMA)
    emit_int(s, elem_size)
    emit_str(s, IR_NL)
    let at: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, at)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, off)
    emit_str(s, IR_NL)
    let len: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len)
    emit_str(s, c" = sub i64 ")
    emit_reg(s, hi)
    emit_str(s, IR_COMMA)
    emit_reg(s, lo)
    emit_str(s, IR_NL)
    let v1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, v1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, c" undef, ptr ")
    emit_reg(s, at)
    emit_str(s, IR_COMMA_0)
    let v2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, v2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, v1)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, len)
    emit_str(s, IR_COMMA_1)
    return v2

# Emit one call argument with the enum context its parameter dictates
# (AGAST #1498).  `p` is the matching callee Param, or null when unknown.
# A tagged-enum param makes a bare `Some(x)` / `None` / `Ok(x)` / `Err(x)`
# argument build that enum; any other param clears the context, so neither a
# surrounding typed let's type nor (via ctx_enum_arg) the enclosing fn's
# return type leaks into the argument.  Saved and restored like
# emit_var_decl does.
fn emit_call_arg(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    # AGAST #3260: a receiver lent as a `:&` param passes a place's address.
    if p != null and param_is_self(p) == 1 and p.is_borrow == 1
        let lent: i32 = emit_borrowed_place(s, arg, p)
        if lent != 0
            return lent
    # AGAST #3005: a tuple param names a nameless tuple literal argument.
    if p != null and p.param_type == TypeKind.Struct
        var arg_name: *u8 = null
        var arg_name_len: i32 = 0
        tuple_lit_name(s, arg, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, @arg_name, @arg_name_len)
    if p != null and param_self_is_ptr(p) == 0
        if p.param_type == TypeKind.Array
            return emit_array_arg_value(s, arg, p)   # AGAST #2287
        let array_addr: i32 = emit_array_arg_addr(s, arg, p)
        if array_addr != 0
            return array_addr
        let sv_arr: *Expr = strview_array_src(s, arg, p)   # AGAST #2305
        if sv_arr != null
            return emit_strview_of_array(s, sv_arr)
        let place_addr: i32 = emit_borrowed_place(s, arg, p)   # AGAST #2335
        if place_addr != 0
            return place_addr
        # The Span cascade builds its Span from the local; it reads no value.
        if param_is_span(p) == 1 and arg.kind == ExprKind.Ident
            let span_src: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
            if span_src != null and lv_var_type(span_src) == TypeKind.Array
                return 0
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    var saved_slot: SlotCtx
    if p != null
        enter_slot_ctx(s, @saved_slot, p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else
        enter_slot_ctx(s, @saved_slot, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    if p != null
        if p.param_type == TypeKind.Struct and p.param_type_name_len > 0
            if is_tagged_enum_type(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 1 or is_enum_instance(s.mono.pctx, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 1
                s.ctx_enum_name = p.param_type_name
                s.ctx_enum_name_len = p.param_type_name_len
    # AGAST #2279: a `c:& C` argument copies into a by-value `C` param.  A lent
    # `self` param is a `ptr` (emit_impl_method).
    var reg: i32 = 0
    # LARB R43 (#3385): an f32 / f64 param is a float slot for an if / match
    # argument; emit_match_arms / emit_if_expr take the hint on entry.
    if p != null and (arg.kind == ExprKind.If or arg.kind == ExprKind.Match)
        s.match_float_hint = param_float_type(p)
    if p != null and param_self_is_ptr(p) == 0
        reg = emit_expr_by_value(s, arg, p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else
        reg = emit_expr(s, arg)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, arg, reg, p)
    return reg

# AGAST #2142: emit `e`, whose value is stored into a slot of declared type
# (ty, name): an assignment target (local, `x.f`, `*p`) or a struct-literal
# field.  As emit_call_arg does for a parameter, a tagged-enum slot makes a
# bare `Some(x)` / `None` / `Rect(..)` build that enum; any other slot clears
# the context and (via ctx_enum_arg) bars the enclosing fn's return type, so
# a ctor with no enum to land in is a ritz1 error, not invalid IR.  Without
# this, `held = Some(..)` / `f.cmap = None` / `Font { cmap: Some(..) }`
# emitted `add i64 0, 0 ; variant w/ no enum ctx` and clang rejected it.
pub fn emit_expr_into_slot(s: *EmitterState, e: *Expr, ty: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if ty == TypeKind.Struct
        let referent: i32 = emit_lent_referent(s, e, StrView { ptr: (name), len: (name_len) as i64 })
        if referent != 0
            return referent
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    var saved_slot: SlotCtx
    enter_slot_ctx(s, @saved_slot, ty, StrView { ptr: (name), len: (name_len) as i64 })
    if ty == TypeKind.Struct and name != null and name_len > 0
        if is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1 or is_enum_instance(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 }) == 1
            s.ctx_enum_name = name
            s.ctx_enum_name_len = name_len
    # AGAST #4028 / #4029: an if / match into a float slot (`v = if c then y
    # else y`, `S { d: match .. }`) merges at the slot's type, as a let does;
    # its phi was the arms' width, stored at the slot's.
    set_match_float_hint(s, e, ty, StrView { ptr: (name), len: (name_len) as i64 })
    var reg: i32 = emit_struct_copy(s, e, ty)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    leave_slot_ctx(s, @saved_slot)
    if ty == TypeKind.Struct
        reg = coerce_array_to_span(s, e, reg, StrView { ptr: (name), len: (name_len) as i64 })   # AGAST #2502
    return reg

# AGAST #2390: emit_expr_into_slot for a slot the caller stores straight into:
# an array element (`a[i] = v`, `h.a[i] = v`, `g[i] = v`) or a pointee
# (`*p = v`).  A bare "..." is a %Span$u8 (#98) and a StrView slot holds a
# %StrView, the layout-equal pair (#168): rebuild it, as the `let`, assign,
# return and struct-literal sites do, or clang refuses the store.  Kept out of
# emit_expr_into_slot itself: those sites rebuild after it, and a second
# rebuild would read a %StrView as a %Span$u8.
pub fn emit_store_into_slot(s: *EmitterState, e: *Expr, ty: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let reg: i32 = emit_expr_into_slot(s, e, ty, StrView { ptr: (name), len: (name_len) as i64 })
    if ty != TypeKind.Struct or name == null or name_len <= 0
        return reg
    return coerce_struct_ret_value(s, e, reg, StrView { ptr: (name), len: (name_len) as i64 })

# AGAST #2502: `reg` is `e`'s value headed for a `Span<T>` / `[T]` slot.  When
# `e` is `@a` over an `[N]T` local, that value is `@a`'s address as an i64,
# which no Span slot holds: build `Span { &a[0], N }` instead, as the Span
# parameter cascade in emit_expr_call does (ritz-task-102).  A `let` / `var`
# initialiser, an assignment and a struct-literal field emitted
# `store %Span$u8 <i64>` and clang rejected it.  Any other `e`: `reg`.
pub fn coerce_array_to_span(s: *EmitterState, e: *Expr, reg: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let loc: *LocalVar = span_array_source(s, e, StrView { ptr: (name), len: (name_len) as i64 })
    if loc == null
        let placed: i32 = emit_span_of_addr_place(s, e, StrView { ptr: (name), len: (name_len) as i64 })   # AGAST #2305
        if placed != 0
            return placed
        return reg
    span_array_elem_fits(s, e, loc, StrView { ptr: (name), len: (name_len) as i64 })   # AGAST #2781
    return emit_span_of_array(s, loc, StrView { ptr: (name), len: (name_len) as i64 })

# AGAST #2305: `Span { &x[0], N }` for `@x` into the `Span$T` slot (name,
# name_len), where `x` is a whole 1-D array that isn't a local: a global, an
# inline field, `*p` for `p: *[N]T`.  ritz0 takes each (`g(@G)`, `g(@h.a)`);
# they passed `@x`'s i64 where the %Span$T goes, and clang refused it.  The
# element is held to the Span's as for a local (#2781); an element this can't
# spell isn't judged.  0 when `e` is anything else; emits nothing then.
fn emit_span_of_addr_place(s: *EmitterState, e: *Expr, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if e == null or name == null or name_len <= 5 or memcmp(name, c"Span$", 5) != 0
        return 0
    if e.kind != ExprKind.Unary or (e.op != OpKind.Addr and e.op != OpKind.AddrMut) or e.operand == null
        return 0
    let x: *Expr = e.operand
    # AGAST #4666 (was #4671): `@b.v` with `b.v` a `Vec<T>` field is
    # `{ b.v.data, b.v.len }`, as `@v` of a Vec local is (span_param_arg).
    # It passed the field's address, a ptrtoint, where the %Span$T goes.
    if x.kind == ExprKind.Member
        let vf: *StructField = resolve_member_chain_field(s, x)
        if vf != null and vf.field_type == TypeKind.Struct and vf.field_type_name_len > 4 and name_eq(StrView { ptr: (vf.field_type_name), len: 4 }, "Vec$") == 1
            if name_eq(StrView { ptr: (vf.field_type_name + 4), len: (vf.field_type_name_len - 4) as i64 }, StrView { ptr: (name + 5), len: (name_len - 5) as i64 }) == 0
                return 0   # `@Vec<A>` into `Span<B>`: the arg checks judge it
            var vmr: MemberPtrResult
            emit_member_ptr(s, x, @vmr)
            if vmr.success != 1
                return 0
            return emit_span_of_vec_ptr(s, StrView { ptr: (vf.field_type_name), len: (vf.field_type_name_len) as i64 }, vmr.reg, name_sv)
    var src: ArraySrc
    if arg_array_shape(s, x, @src) == 0
        return 0
    if src.elem != TypeKind.Ptr and src.elem != TypeKind.PtrPtr
        span_elem_fits(s, e, src.elem, StrView { ptr: (src.name), len: (src.name_len) as i64 }, StrView { ptr: (name), len: (name_len) as i64 })
    var ptr: i32 = 0
    if array_place_shape(s, x, @src) == 1
        ptr = emit_array_place_ptr(s, x)
    else
        var mr: MemberPtrResult
        emit_member_ptr(s, x, @mr)
        ptr = mr.reg
    emit_span_value(s, ptr, src.size, StrView { ptr: (name), len: (name_len) as i64 })

# `StrView { &x[0], N }` of strview_array_src's array `x`, or `{ x, N }` when
# `x` points at it.
fn emit_strview_of_array(s: *EmitterState, x: *Expr) -> i32
    var src: ArraySrc
    if strview_array_ptr(s, x) == 1
        array_ptr_shape(s, x, @src)
        return emit_span_value(s, emit_array_ptr_value(s, x), src.size, StrView { ptr: (c"StrView"), len: (7) as i64 })
    arg_array_shape(s, x, @src)
    var ptr: i32 = 0
    if array_place_shape(s, x, @src) == 1
        ptr = emit_array_place_ptr(s, x)
    else
        var mr: MemberPtrResult
        emit_member_ptr(s, x, @mr)
        ptr = mr.reg
    emit_span_value(s, ptr, src.size, StrView { ptr: (c"StrView"), len: (7) as i64 })

# AGAST #2287: the `[N x T]` value of `arg` for by-value array param `p`.  As in
# ritz0, `g(p)` and `g(@a)` read through the pointer.  Each value is copied into
# a fresh `[N x T]` by emit_array_local_whole_assign, whose checks it gets, so
# it is what `let b: [N]T = arg` accepts.  The next argument can't change it.
# AGAST #2306: a large `[N]T` is passed `ptr byval`, so the slot itself is the
# argument (LLVM copies it at the call) and nothing is loaded first-class.
fn emit_array_arg_value(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    var value: *Expr = arg
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        value = arg.operand
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_array_value_llvm_type(s, p)
    emit_str(s, c"  ; #2287 array arg\n")
    entry_alloca_reg_end(s)
    let ptr_loc: *LocalVar = array_ptr_local(s, value)
    if p.param_array_shape != null
        emit_nd_array_value_into(s, slot, p.param_array_shape, value)   # AGAST #3634
    else if ptr_loc != null and lv_is_lent(ptr_loc) == 0
        emit_array_ptr_arg_copy(s, value, ptr_loc, slot, p)
    else
        emit_array_local_whole_assign(s, slot, p.param_array_size, p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, value)
    if array_param_uses_byval(s, p) == 1
        return slot
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD)
    emit_array_value_llvm_type(s, p)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    return val

# AGAST #2287: `g(a)` with `a` a whole array, into a param that takes it by
# address: the address, as an i64 like `g(@a)`, which the arg cascades turn into
# what the param is.  This argument used to read the array's first 8 bytes and
# hand them to the callee as a pointer.  0 when `arg` is anything else.
fn emit_array_arg_addr(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if param_takes_array_ref(p) == 0
        return 0
    var ptr: i32 = 0
    var place: ArraySrc
    # AGAST #2290: a reborrow.  An `@[N]T` slot is an i64; the `ptr` slots
    # (`:&`, `@&[N]T`) take the pointer itself.  AGAST #2322: this is the only
    # place a bare `a:& [N]T` is its pointer; emit_expr_ident refuses it.
    if lent_local(s, arg) != null
        let lent: *LocalVar = lent_array_ident(s, arg)
        if lent == null
            return 0
        if p.param_type != TypeKind.Ref
            return lent.reg
        ptr = lent.reg
    else if array_place_shape(s, arg, @place) == 1
        ptr = emit_array_place_ptr(s, arg)
    else if arg.kind == ExprKind.Member and arg_field_is_array(s, arg) == 1
        var mr: MemberPtrResult
        emit_member_ptr(s, arg, @mr)
        ptr = mr.reg
    if ptr == 0
        return 0
    let addr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, addr)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, ptr)
    emit_str(s, c" to i64  ; #2287 array by address\n")
    return addr

# AGAST #2250: `e` read into a by-value slot of struct `name`.  `c:& C` reads
# as the pointer, but the slot holds a `C`, so a `c:& C` param of that type
# copies its referent here: the aggregate register, as emit_expr gives for any
# other struct value.  0 when `e` is anything else.  `c:& [2]C` names `C` as
# well: an array is no `C`, so it stays the pointer, which clang refuses.  A
# move-only C was refused on Sema (own_check.ritz's oc_lent_read, AGAST #3507).
pub fn emit_lent_referent(s: *EmitterState, e: *Expr, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var loc: *LocalVar = lent_local(s, e)
    if loc == null
        loc = lent_self_local(s, e)
    if loc == null or lv_var_type(loc) == TypeKind.Array
        return 0
    if name_eq(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return 0
    var src: i32 = emit_expr(s, e)
    if lv_var_type(loc) == TypeKind.Ptr
        # An impl's `self:& T` is a `*T` local, so its value is an i64.
        let addr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, addr)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, src)
        emit_str(s, c" to ptr  ; #2278 lent self\n")
        src = addr
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TypeKind.Struct, val, StrView { ptr: (name), len: (name_len) as i64 }, src, null, 0)
    return val

# AGAST #2279: `return c` or a tail `c` with `c:& C` in a fn returning `C`: the
# value is the referent.  Emits the `ret` and returns 1; 0 when `e` is anything
# else.  Only s.ret_type_name's slot reads it.
# AGAST #2302: `return e` / a tail `e` in a `-> [N]T` fn, whose return `ra` is
# that type as a param.  As ritz0, the return is a first-class `[N x T]`: `e` is
# copied into a fresh one by emit_array_local_whole_assign, whose checks it
# gets (so it returns what `let b: [N]T = e` accepts), and that is loaded and
# returned.  Returns 1 when `ra` is non-null, i.e. when this was the return.
# AGAST #3181: a large `[N]T` is built in a slot the same way, which is then
# copied pointer-to-pointer into the caller's `%ret.sret` (`ret void`).
pub fn emit_array_return(s: *EmitterState, e: *Expr, ra: *Param) -> i32
    if ra == null
        return 0
    let slot: i32 = emit_array_return_slot(s, ra)
    if ra.param_array_shape != null
        emit_nd_array_value_into(s, slot, ra.param_array_shape, e)   # AGAST #3634
    else
        emit_array_local_whole_assign(s, slot, ra.param_array_size, ra.param_array_elem_type, StrView { ptr: (ra.param_type_name), len: (ra.param_type_name_len) as i64 }, e)
    emit_array_return_from(s, ra, slot)

# AGAST #2305: a `-> [N]T` fn whose last statement is an `if` / `else`: each
# arm's tail is the array returned, as `if c then a else b` is.  Before this the
# arms' i64 value met emit_implicit_return_tail's refusal.  0 when `st` is no
# such tail, or the fn returns no array.
# AGAST #3276: a tail `match` (StmtKind.Match) too: each arm's value is returned.
pub fn emit_array_return_if_stmt(s: *EmitterState, st: *Stmt, ra: *Param) -> i32
    if ra == null or st == null
        return 0
    if st.kind == StmtKind.Match
        let mslot: i32 = emit_array_return_slot(s, ra)
        emit_array_match_into(s, mslot, ra.param_array_size, ra.param_array_elem_type, StrView { ptr: (ra.param_type_name), len: (ra.param_type_name_len) as i64 }, st.if_cond, st.if_then as *MatchArm, st.span)
        return emit_array_return_from(s, ra, mslot)
    if st.kind != StmtKind.If or st.if_else == null
        return 0
    let slot: i32 = emit_array_return_slot(s, ra)
    emit_array_stmt_if_into(s, slot, ra.param_array_size, ra.param_array_elem_type, StrView { ptr: (ra.param_type_name), len: (ra.param_type_name_len) as i64 }, st)
    emit_array_return_from(s, ra, slot)

pub fn emit_lent_return(s: *EmitterState, e: *Expr, ret_type: TypeKind) -> i32
    if ret_type != TypeKind.Struct
        return 0
    let val: i32 = emit_lent_referent(s, e, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
    if val == 0
        return 0
    if s.ret_sret == 1
        emit_sret_ret_value(s, val)   # AGAST #1730
        return 1
    emit_str(s, c"  ret ")
    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_NL)
    return 1

# emit_expr for a by-value slot of type `ty` whose enum context, if any, the
# caller has set: a `let` or a parameter (#2279).  An array element (#2250) is
# emit_expr_into_slot's, which sets the element's enum (AGAST #2454).
pub fn emit_expr_by_value(s: *EmitterState, e: *Expr, ty: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if ty == TypeKind.Struct
        let referent: i32 = emit_lent_referent(s, e, StrView { ptr: (name), len: (name_len) as i64 })
        if referent != 0
            return referent
    return emit_struct_copy(s, e, ty)

# emit_expr, with `e` marked as a copy into a struct slot when `ty` is one (#2330).
pub fn emit_struct_copy(s: *EmitterState, e: *Expr, ty: TypeKind) -> i32
    let saved: *Expr = s.struct_copy_expr
    if ty == TypeKind.Struct
        s.struct_copy_expr = e
    let reg: i32 = emit_expr(s, e)
    s.struct_copy_expr = saved
    return reg

# emit_expr_into_slot for a struct field.
pub fn emit_expr_into_field(s: *EmitterState, e: *Expr, field: *StructField) -> i32
    return emit_expr_into_slot(s, e, field.field_type, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })

# The address of a place borrowed by `p`, as an i64 like `@x`; every slot
# converts that to what it is.  0 when `arg` is anything else.
# AGAST #2354: every slot reads `arg` as expr_is_ptr_valued says it is, and an
# `@&U` local is a `ptr`, so its place's address stays one.
fn emit_borrowed_place(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if borrow_arg_kind(s, arg, p) != BORROW_PLACE
        return 0
    let ptr: i32 = emit_lvalue_ptr(s, arg)
    if ptr < 0
        emit_ir_error(s, arg.span, c"cannot take mutable address")
        return 0
    if expr_is_ptr_valued(s, arg) == 1
        return ptr
    let addr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, addr)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, ptr)
    emit_str(s, c" to i64  ; #2335 borrowed place\n")
    return addr

# Emit an Ok/Some/Err/None constructor as a `%Result$.../Option$...` struct
# value. `tag` is the variant index (0 = Ok/Some, 1 = Err/None).
# `payload_expr` is null for unit variants.  Returns the register holding
# the loaded struct value.  `ctor` is the constructor, for the error when
# nothing names its enum.
fn emit_variant_struct(s: *EmitterState, tag: i32, ctor: *Expr) -> i32
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    let ok: i32 = resolve_enum_ctx(s, @enum_name, @enum_name_len)
    if ok == 0
        return emit_no_enum_ctx_error(s, ctor)
    return emit_variant_build(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, ctor.args)

# AGAST #1797: `Holds(x)`, a payload variant of a user enum (unqualified, as
# ritz0's variant_to_enum resolves it: enum_of_variant), with its payload:
# AGAST #1295: every field of a tuple variant, `Rect(w, h)`, and of a struct
# variant built positionally, `Big(1, 2, 3)`.  The qualified `Opt.Holds(x)` is an
# ExprKind.Method: emit_qualified_variant_ctor (#1466).  Returns 0 when `e` is
# not one.
# AGAST #2039: a callee two enums declare is the located ambiguity error,
# not the last-declared enum's ctor.
fn try_emit_user_variant_ctor(s: *EmitterState, e: *Expr) -> i32
    # AGAST #2422: `Full(5)` in a `Slot<i32>` slot builds that instance.
    var ivi: i32 = 0
    let iei: i32 = slot_instance_variant(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @ivi)
    if iei >= 0
        let ikind: i32 = enum_variant_kind(s.mono.pctx, iei, ivi)
        # AGAST #1295: a payload variant takes its fields' values (counted
        # by emit_variant_build).
        if (ikind == ENUM_VARIANT_UNIT and e.args == null) or ((ikind == ENUM_VARIANT_TUPLE or ikind == ENUM_VARIANT_STRUCT) and e.args != null)
            var in_len: i32 = 0
            let in_name: *u8 = enum_name_at(s.mono.pctx, iei, @in_len)
            return emit_variant_build(s, StrView { ptr: (in_name), len: (in_len) as i64 }, ivi, e.args)
    var amb_a: i32 = 0
    var amb_b: i32 = 0
    if user_variant_ctor_ambiguous(s.mono.pctx, e, @amb_a, @amb_b) == 1
        return emit_ambiguous_variant_error(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, e.span, amb_a, amb_b)
    var en: *u8 = null
    var en_len: i32 = 0
    user_variant_ctor_enum(s.mono.pctx, e, @en, @en_len)
    if en == null
        # AGAST #3021: a generic enum's `Full(6)` no slot names an instance
        # of is refused here; it called an undeclared `@Full`.  A fn of that
        # name is still the call.
        if find_fn(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == null
            # AGAST #4153: `Z(1)` / `One()`, a variant given the wrong count.
            var mei: i32 = 0
            var mvi: i32 = 0
            if user_variant_ctor_miscounted(s.mono.pctx, e, @mei, @mvi) == 1
                return emit_payload_count_refusal(s, mei, mvi, e)
            return emit_no_instance_error(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, e.span)
        return 0
    var vi: i32 = 0
    var other: i32 = 0
    enum_of_variant_unique(s.mono.pctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @vi, @other)
    return emit_variant_build(s, StrView { ptr: (en), len: (en_len) as i64 }, vi, e.args)

# AGAST #1466: `E.V(args)`, variant `vi` of enum `ei` (see qualified_variant),
# lowered as the unqualified `V(args)` is (try_emit_user_variant_ctor): a
# tuple or struct variant with one value per field (AGAST #1295), or a unit variant called with none.
# Anything else ritz1 cannot build is a located error, never IR.
fn emit_qualified_variant_ctor(s: *EmitterState, e: *Expr, ei: i32, vi: i32) -> i32
    if enum_is_generic(s.mono.pctx, ei) == 1
        return emit_qualified_variant_error(s, e, c"is a variant of a generic enum: a qualified generic enum value is not supported (ritz0 rejects it too); write the unqualified form, e.g. Some(x) / Ok(x) / None")
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(s.mono.pctx, ei, @en_len)
    let kind: i32 = enum_variant_kind(s.mono.pctx, ei, vi)
    # AGAST #1295: a tuple variant, or a struct one built positionally, takes
    # one value per field (emit_variant_build counts them, located); a unit
    # variant none.  The rest is the count's error, as unqualified (#4153).
    if kind == ENUM_VARIANT_UNIT
        if e.args == null
            return emit_variant_build(s, StrView { ptr: (en), len: (en_len) as i64 }, vi, null)
        return emit_payload_count_refusal(s, ei, vi, e)
    if e.args == null
        return emit_payload_count_refusal(s, ei, vi, e)
    return emit_variant_build(s, StrView { ptr: (en), len: (en_len) as i64 }, vi, e.args)

# AGAST #2288: `E.Full(c)`, `Full(c)` or `Some(c)` with `c:& C`, when the
# variant's declared payload is `C`: the referent, as in ritz0.  0 when `e` is
# anything else, or the payload is no `C` (a `Full(*C)` keeps the pointer).
fn emit_lent_payload(s: *EmitterState, enum_name_sv: StrView, tag: i32, e: *Expr) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if lent_referent_local(s, e) == null
        return 0
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, @pay_len)
    if pay == null or pay_len <= 0
        return 0
    return emit_lent_referent(s, e, StrView { ptr: (pay), len: (pay_len) as i64 })

# AGAST #2926: emit a variant's payload with the enum context its declared
# type gives, as emit_call_arg does for a parameter: `Has(Some(6))` with
# `Has(Option<i32>)` builds `%Option$i32`, and a payload slot that is no enum
# bars the outer one.  Only a payload whose type is known takes a slot; any
# other keeps the context it had.
fn emit_payload_into_slot(s: *EmitterState, enum_name_sv: StrView, tag: i32, e: *Expr) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, @pay_len)
    if pay == null or pay_len <= 0
        return emit_expr(s, e)
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    let saved_arg: i32 = s.ctx_enum_arg
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_enum_arg = 1
    if is_tagged_enum_type(StrView { ptr: (pay), len: (pay_len) as i64 }) == 1 or is_enum_instance(s.mono.pctx, StrView { ptr: (pay), len: (pay_len) as i64 }) == 1
        s.ctx_enum_name = pay
        s.ctx_enum_name_len = pay_len
    # AGAST #4678: a struct payload is a copy into the variant's slot, as a
    # struct argument is, so a whole struct element (`Some(m.params[i])`,
    # `Ok(p[i])`) is its value rather than refused (whole_struct_elem_refused).
    var reg: i32 = 0
    if find_struct(s, StrView { ptr: (pay), len: (pay_len) as i64 }) != null
        reg = emit_struct_copy(s, e, TypeKind.Struct)
    else
        reg = emit_expr(s, e)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    s.ctx_enum_arg = saved_arg
    reg

# AGAST #3029: write the array literal or fill `e` into the payload buffer at
# `pay_ptr`, at its declared `[N]T` (variant_array_payload), as a struct
# literal's array field is (emit_struct_lit_array_fill_field).  emit_expr has
# no slot for one: it built a shadow `[N x i64]` and the payload got its
# ADDRESS (#3014 refused that).
fn emit_array_payload_into(s: *EmitterState, pay_ptr: i32, arr: *ArrayArg, e: *Expr)
    if e.kind == ExprKind.ArrayLit
        emit_array_lit_into(s, pay_ptr, arr.size, arr.elem, StrView { ptr: (arr.name), len: (arr.name_len) as i64 }, e)
    else
        emit_array_fill_into(s, pay_ptr, arr.size, arr.elem, StrView { ptr: (arr.name), len: (arr.name_len) as i64 }, e.left)

# AGAST #1295: one evaluated variant payload field, between evaluating it
# (eval_variant_payload) and storing it into the enum (store_variant_payload).
# have: 0 none (`Ok(())`, a unit variant), 1 a value in reg, 2 an array
# literal / fill written in place from arr.
struct VariantPayload
    have: i32
    reg: i32
    arr: ArrayArg

# Evaluate payload field `sel` (variant_sel: field k of variant `tag`;
# Result / Option pass their 0 / 1) from `e`, null for none.
fn eval_variant_payload(s: *EmitterState, enum_name_sv: StrView, sel: i32, e: *Expr, pv: *VariantPayload)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    pv.have = 0
    pv.reg = 0
    # AGAST #3029: an array literal payload is written in place, below.
    let arr_payload: i32 = variant_array_payload(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, e, @pv.arr)
    # AGAST #2272: `Ok(())` carries a zero-byte payload: nothing to store.
    if arr_payload == 1
        pv.have = 2
    else if e != null and is_unit_expr(e) == 0
        pv.reg = emit_lent_payload(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, e)
        if pv.reg == 0
            pv.reg = emit_payload_into_slot(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, e)
        pv.have = 1

# Store the evaluated payload field `sel` (eval_variant_payload, from `e`)
# into the enum at `slot`, at the field's offset and type.
fn store_variant_payload(s: *EmitterState, slot: i32, enum_name_sv: StrView, sel: i32, e: *Expr, pv: *VariantPayload)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if pv.have == 2
        let arr_ptr: i32 = emit_payload_ptr(s, slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)
        emit_array_payload_into(s, arr_ptr, @pv.arr, e)

    if pv.have == 1
        # Payload goes into field 2 (the `[N x i8]` buffer after the pad,
        # AGAST #1898).  ritz1's expr evaluation always yields an i64-width
        # register for scalar / ptr payloads; it is stored at the payload's
        # own width (truncated), as ritz0 stores it.  For struct
        # payloads (e.g. `Vec<u8>` or `StrView`) emit_expr returns the
        # aggregate register — store it by its declared name when we can
        # recover the type, else fall back to the scalar store.
        # AGAST #1295: field `sel` names, at its offset in the buffer.
        let pay_ptr: i32 = emit_payload_ptr(s, slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)

        var aggregate_name: *u8 = null
        var aggregate_name_len: i32 = 0
        variant_payload_aggregate(s, e, @aggregate_name, @aggregate_name_len)
        var is_aggregate: i32 = (aggregate_name != null) as i32

        # AGAST #1797: a user enum's tuple variant declares its payload
        # type; a struct one is the aggregate whatever the expression form.
        if is_aggregate == 0
            let uf: *StructField = user_enum_tuple_field(s.mono.pctx, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)
            if uf != null
                if uf.field_type == TypeKind.Struct and uf.field_type_name_len > 0
                    is_aggregate = 1
                    aggregate_name = uf.field_type_name
                    aggregate_name_len = uf.field_type_name_len

        # AGAST #2987: a tagged enum's payload declared as an enum (a tagged
        # one, an instance or a user enum: `Some(Some(6))` in an
        # `Option<Option<i32>>`, `Ok(None)` in a `Result<Option<i32>, E>`)
        # is that aggregate whatever the expression form: the payload was
        # built in its slot (emit_payload_into_slot).  It was stored as an
        # i64: invalid IR.
        if is_aggregate == 0
            var decl_len: i32 = 0
            let decl: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, @decl_len)
            if decl != null and decl_len > 0
                if is_tagged_enum_type(StrView { ptr: (decl), len: (decl_len) as i64 }) == 1 or enum_find(s.mono.pctx, StrView { ptr: (decl), len: (decl_len) as i64 }) >= 0
                    is_aggregate = 1
                    aggregate_name = decl
                    aggregate_name_len = decl_len

        if is_aggregate == 1
            emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (aggregate_name), len: (aggregate_name_len) as i64 }, pv.reg, pay_ptr)
        else
            # AGAST #1945: a float payload is stored at its own type; a
            # literal (always double) or an integer is converted first.
            var store_reg: i32 = pv.reg
            let pay_ft: TypeKind = tagged_enum_float_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)
            if pay_ft != TypeKind.Void
                store_reg = emit_float_coerce(s, pv.reg, expr_slot_ty(e), pay_ft)
            else
                # AGAST #2384: an `@&T` payload (`Some(r)`, `r: @&C`, into an
                # `Option<@&C>`) is a `ptr`; the payload slot holds an i64.
                store_reg = ptr_value_to_i64(s, e, pv.reg)
            emit_tagged_payload_store(s, store_reg, pay_ptr, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)


# Build `%Enum` with tag `tag` and payload `payload_expr` (null: none) in a
# zeroed alloca, and load it.  `enum_name` is a tagged enum (Result$/Option$,
# where `tag` 0 / 1 also picks Ok-Some / Err for the payload width) or a
# user enum (AGAST #1797; the payload type is the tuple variant's).
# AGAST #1295: `payload_expr` is the head of the argument list: a user
# enum's variant takes one value per field, each stored at its offset.
fn emit_variant_build(s: *EmitterState, enum_name_sv: StrView, tag: i32, payload_expr: *Expr) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let ei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    if ei >= 0 and tag >= 0 and tag < enum_variant_count(s.mono.pctx, ei) and payload_expr != null
        let nf: i32 = enum_variant_field_count(s.mono.pctx, ei, tag)
        var na: i32 = 0
        var a: *Expr = payload_expr
        while a != null
            na += 1
            a = a.next
        if nf > 0 and na != nf
            emit_payload_count_error(s, ei, tag, payload_expr, payload_expr.span)
        if nf > 1 and na == nf
            # Evaluated left to right, each straight into its field.
            let mslot: i32 = emit_variant_slot(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag)
            var arg: *Expr = payload_expr
            var k: i32 = 0
            while arg != null
                var fpv: VariantPayload
                let sel: i32 = variant_sel(tag, k)
                eval_variant_payload(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, arg, @fpv)
                store_variant_payload(s, mslot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel, arg, @fpv)
                arg = arg.next
                k += 1
            return emit_variant_load(s, mslot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })

    # Emit payload first (may consume registers); keep expr value for store.
    var pv: VariantPayload
    eval_variant_payload(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, payload_expr, @pv)
    let slot: i32 = emit_variant_slot(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag)
    store_variant_payload(s, slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, payload_expr, @pv)
    # Load the assembled struct to return its value.
    return emit_variant_load(s, slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })

# =============================================================================
# AGAST #167 — SIMD builtin lowering
#
# ritz0 (Python) handles SIMD intrinsics in emitter_llvmlite.py via direct LLVM
# IR generation rather than going through the regular call path.  ritz1's
# generic call path always emits `call i64 @name`, which mismatches when the
# binding is a `<N x iM>` vector type.  These helpers port ritz0's inline
# lowering for the simd_* builtins (simd_loadu, simd_xor, simd_add, etc.).
# Vector-type selection: prefer the binding context (`s.ctx_simd_name`, set
# by emit_var_decl / emit_assign) for simd_load/loadu where the type is not
# encoded in the args; for binary ops fall back to walking the arg locals.
# =============================================================================

# `simd_loadu(ptr) -> vec<N,T>` / `simd_load(...)`: emit an inline LLVM load
# with the vector type pulled from `s.ctx_simd_name` (set by the enclosing
# `let v: v4i32 = ...` / `v = ...`).  `unaligned == 1` → align 1; else use
# 16-byte (SSE2) or 32-byte (AVX2) alignment based on the chosen vec type.
fn emit_simd_loadu(s: *EmitterState, e: *Expr, unaligned: i32) -> i32
    if e.args == null
        emit_ir_error(s, e.span, c"simd_load(u) requires a pointer argument")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let arg_reg: i32 = emit_expr(s, e.args)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, null, @vec_name, @vec_name_len) == 0
        # No context — default to v4i32 (most common SSE2 shape).  Keeps
        # IR well-formed even when we can't infer; the user will get a
        # clear type error downstream if it doesn't match the binding.
        vec_name = c"v4i32"
        vec_name_len = 5
    # Convert i64 ptr-as-int to ptr (ritz1's unified value model passes
    # all pointers as i64 except when the param is TypeKind.MutRef).
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, arg_reg)
    emit_str(s, c" to ptr  ; simd_load: ptr cast\n")
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, IR_LOAD)
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, p)
    if unaligned == 1
        emit_str(s, c", align 1\n")
    else
        # AVX2 names use 32-byte alignment; SSE2 names use 16-byte.
        let bits: i32 = simd_vector_elem_bits(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        let count: i32 = simd_vector_elem_count(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        if (bits * count) >= 256
            emit_str(s, c", align 32\n")
        else
            emit_str(s, c", align 16\n")
    return result

# `simd_storeu(ptr, vec)` / `simd_store(...)`: emit inline LLVM store.
fn emit_simd_storeu(s: *EmitterState, e: *Expr, unaligned: i32) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, e.span, c"simd_store(u) requires (ptr, vec)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let ptr_reg: i32 = emit_expr(s, e.args)
    let vec_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args.next, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, ptr_reg)
    emit_str(s, c" to ptr  ; simd_store: ptr cast\n")
    emit_str(s, IR_STORE_IND)
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, vec_reg)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, p)
    if unaligned == 1
        emit_str(s, c", align 1\n")
    else
        let bits2: i32 = simd_vector_elem_bits(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        let count2: i32 = simd_vector_elem_count(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        if (bits2 * count2) >= 256
            emit_str(s, c", align 32\n")
        else
            emit_str(s, c", align 16\n")
    # Void result — return a sentinel i64 0.  Callers that bind the result
    # see a harmless no-op value; the typical use is statement-position
    # `simd_storeu(...)` where the value is dropped.
    let z2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z2)
    emit_str(s, c" = add i64 0, 0  ; simd_store void\n")
    return z2

# `simd_xor(a,b)` / `simd_add(a,b)` — binary vector ops.  Vector type is
# derived from the args (vector-typed locals) or context.
fn emit_simd_binop(s: *EmitterState, e: *Expr, opname: *u8) -> i32
    if e.args == null or e.args.next == null
        # ritz0's words (AGAST #4665): emitter/intrinsics.py.
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprint_bytes(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        eprints("() requires 2 arguments (vector, vector)\n")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        if resolve_simd_arg_type(s, e.args.next, @vec_name, @vec_name_len) == 0
            vec_name = c"v4i32"
            vec_name_len = 5
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = ")
    emit_str(s, opname)
    emit_str(s, IR_SP)
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, a_reg)
    emit_str(s, IR_COMMA)
    emit_reg(s, b_reg)
    emit_str(s, IR_NL)
    return result

# `simd_extract(vec, idx) -> elem` — `extractelement`.
fn emit_simd_extract(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, e.span, c"simd_extract requires (vec, idx)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # `idx_reg` is i64 in the unified value model; truncate to i32 for
    # the extractelement opcode.
    let i32idx: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, idx_reg)
    let elem: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem)
    emit_str(s, c" = extractelement ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, vec_reg)
    emit_str(s, c", i32 ")
    emit_reg(s, i32idx)
    emit_str(s, IR_NL)
    # Element is the vector's scalar type — extend to i64 for the unified
    # value model so downstream consumers work uniformly.
    let bits: i32 = simd_vector_elem_bits(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    if bits == 64
        return elem
    let ext: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ext)
    emit_str(s, c" = sext ")
    emit_simd_elem_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, elem)
    emit_str(s, IR_TO_I64)
    return ext

# `simd_insert(vec, idx, val) -> vec` — `insertelement`.
fn emit_simd_insert(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, e.span, c"simd_insert requires (vec, idx, val)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    let idx_reg: i32 = emit_expr(s, e.args.next)
    let val_reg: i32 = emit_expr(s, e.args.next.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    let i32idx: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, idx_reg)
    # Truncate val from i64 down to the element width.
    let bits: i32 = simd_vector_elem_bits(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    var val_narrow: i32 = val_reg
    if bits != 64
        val_narrow = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, val_narrow)
        emit_str(s, IR_TRUNC)
        emit_reg(s, val_reg)
        emit_str(s, IR_TO_SP)
        emit_simd_elem_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        emit_str(s, IR_NL)
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = insertelement ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, vec_reg)
    emit_str(s, IR_COMMA)
    emit_simd_elem_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, val_narrow)
    emit_str(s, c", i32 ")
    emit_reg(s, i32idx)
    emit_str(s, IR_NL)
    return result

# `simd_shuffle(a, b, mask...)` — `shufflevector`.  Mask args must all be
# integer literals (compile-time constants).
fn emit_simd_shuffle(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, e.span, c"simd_shuffle requires (vec, vec, mask...)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # Count + emit mask values.  All must be integer literals.
    var mask_count: i32 = 0
    var mask_arg: *Expr = e.args.next.next
    while mask_arg != null
        mask_count = mask_count + 1
        mask_arg = mask_arg.next
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = shufflevector ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, a_reg)
    emit_str(s, IR_COMMA)
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, b_reg)
    emit_str(s, c", <")
    emit_int(s, mask_count as i64)
    emit_str(s, c" x i32> <")
    mask_arg = e.args.next.next
    var first: i32 = 1
    while mask_arg != null
        if first == 0
            emit_str(s, IR_COMMA)
        first = 0
        emit_str(s, c"i32 ")
        if mask_arg.kind == ExprKind.IntLit
            emit_int(s, mask_arg.int_val)
        else
            # Best-effort: emit 0 for non-literal (LLVM rejects but the
            # compiler at least doesn't crash).  ritz0 raises here.
            emit_int(s, 0)
        mask_arg = mask_arg.next
    emit_str(s, c">\n")
    return result

# `simd_rotl(vec, n)` — rotate-left by constant n.  Implemented as
# `(v << n) | (v >> (bits - n))`.  `n` must be a compile-time integer
# literal so we can broadcast the shift constants directly.
fn emit_simd_rotl(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, e.span, c"simd_rotl requires (vec, n)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let vec_reg: i32 = emit_expr(s, e.args)
    var vec_name: *u8 = null
    var vec_name_len: i32 = 0
    if resolve_simd_arg_type(s, e.args, @vec_name, @vec_name_len) == 0
        vec_name = c"v4i32"
        vec_name_len = 5
    # Extract shift amount as a compile-time constant.
    var shift_amount: i64 = 0
    var shift_expr: *Expr = e.args.next
    if shift_expr.kind == ExprKind.IntLit
        shift_amount = shift_expr.int_val
    else if shift_expr.kind == ExprKind.Cast and shift_expr.left != null and shift_expr.left.kind == ExprKind.IntLit
        shift_amount = shift_expr.left.int_val
    let bits: i32 = simd_vector_elem_bits(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    let count: i32 = simd_vector_elem_count(StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    let right_shift: i64 = (bits as i64) - shift_amount
    # Build broadcast splats for left/right shift constants.
    let left_shifted: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, left_shifted)
    emit_str(s, c" = shl ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, vec_reg)
    emit_str(s, c", <")
    var li: i32 = 0
    while li < count
        if li > 0
            emit_str(s, IR_COMMA)
        emit_simd_elem_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_int(s, shift_amount)
        li = li + 1
    emit_str(s, c">\n")
    let right_shifted: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, right_shifted)
    emit_str(s, c" = lshr ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, vec_reg)
    emit_str(s, c", <")
    var ri: i32 = 0
    while ri < count
        if ri > 0
            emit_str(s, IR_COMMA)
        emit_simd_elem_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_int(s, right_shift)
        ri = ri + 1
    emit_str(s, c">\n")
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = or ")
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, left_shifted)
    emit_str(s, IR_COMMA)
    emit_reg(s, right_shifted)
    emit_str(s, IR_NL)
    return result

# `simd_sad(a: v16i8, b: v16i8) -> v2i64` — sum of absolute differences,
# routes to `llvm.x86.sse2.psad.bw`.  The result type differs from the args.
fn emit_simd_sad(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null
        emit_ir_error(s, e.span, c"simd_sad requires (vec, vec)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    add_extern(s, StrView { ptr: (c"llvm.x86.sse2.psad.bw"), len: (21) as i64 })
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @llvm.x86.sse2.psad.bw(<16 x i8> ")
    emit_reg(s, a_reg)
    emit_str(s, c", <16 x i8> ")
    emit_reg(s, b_reg)
    emit_str(s, IR_CLOSE)
    return result

# `simd_clmul(a: v2i64, b: v2i64, imm8: u8) -> v2i64` — carryless multiply
# (PCLMULQDQ).  imm must be a compile-time constant 0-255.
fn emit_simd_clmul(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next == null
        emit_ir_error(s, e.span, c"simd_clmul requires (vec, vec, imm8)")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    let a_reg: i32 = emit_expr(s, e.args)
    let b_reg: i32 = emit_expr(s, e.args.next)
    var imm: i64 = 0
    let imm_expr: *Expr = e.args.next.next
    if imm_expr.kind == ExprKind.IntLit
        imm = imm_expr.int_val
    else if imm_expr.kind == ExprKind.Cast and imm_expr.left != null and imm_expr.left.kind == ExprKind.IntLit
        imm = imm_expr.left.int_val
    add_extern(s, StrView { ptr: (c"llvm.x86.pclmulqdq"), len: (18) as i64 })
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @llvm.x86.pclmulqdq(<2 x i64> ")
    emit_reg(s, a_reg)
    emit_str(s, c", <2 x i64> ")
    emit_reg(s, b_reg)
    emit_str(s, c", i8 ")
    emit_int(s, imm)
    emit_str(s, IR_CLOSE)
    return result

# Generic x86 LLVM-intrinsic dispatch — emit `call <vec_type> @<llvm_name>(...)`.
# Used for the SHA-NI and AES-NI families which take and return SIMD vectors
# but aren't simd_*-prefixed.  Adds the LLVM intrinsic name to the externs
# table so the matching `declare` is emitted in emit_extern_declarations.
# `vec_name` chooses the vector LLVM type for both args and result.
# `arity` is the number of vector args (1, 2, or 3).
fn emit_x86_simd_intrinsic(s: *EmitterState, e: *Expr, llvm_name_sv: StrView, arity: i32, vec_name_sv: StrView) -> i32
    var llvm_name: *u8 = llvm_name_sv.ptr
    var llvm_name_len: i32 = llvm_name_sv.len as i32
    var vec_name: *u8 = vec_name_sv.ptr
    var vec_name_len: i32 = vec_name_sv.len as i32
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4
        arg_regs[arg_count] = emit_expr(s, arg_it)
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        emit_ir_error(s, e.span, c"x86 intrinsic arity mismatch")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    add_extern(s, StrView { ptr: (llvm_name), len: (llvm_name_len) as i64 })
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, IR_CALL)
    emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
    emit_str(s, c" @")
    emit_name(s, StrView { ptr: (llvm_name), len: (llvm_name_len) as i64 })
    emit_str(s, c"(")
    var k: i32 = 0
    while k < arg_count
        if k > 0
            emit_str(s, IR_COMMA)
        emit_simd_vector_type(s, StrView { ptr: (vec_name), len: (vec_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, arg_regs[k])
        k = k + 1
    emit_str(s, IR_CLOSE)
    return result

# SHA-NI wrapper: those intrinsics take and return <4 x i32>, the only type
# the builtins accept (ritz0 rejects others), so no cast is needed.
fn emit_x86_intrinsic_v4i32(s: *EmitterState, e: *Expr, llvm_name_sv: StrView, arity: i32) -> i32
    var llvm_name: *u8 = llvm_name_sv.ptr
    var llvm_name_len: i32 = llvm_name_sv.len as i32
    return emit_x86_simd_intrinsic(s, e, StrView { ptr: (llvm_name), len: (llvm_name_len) as i64 }, arity, StrView { ptr: (c"v4i32"), len: (5) as i64 })

# AES-NI (AGAST #1609): `llvm.x86.aesni.*` take and return only <2 x i64>,
# but the ritz builtins accept any 128-bit integer vector, as ritz0 does.  An
# operand whose type resolves to anything but v2i64 (in practice v4i32) is
# bitcast to <2 x i64> on the way in, and the result is bitcast back to the
# state operand's (first arg's) type.  An operand whose type cannot be
# resolved is taken as v2i64, which is what this path emitted before.
# `imm8` >= 0 appends a trailing `i8 <imm8>` immediate after the `arity`
# vector args (aeskeygenassist's rcon, AGAST #3266); -1 means none.  The
# caller has already consumed that arg, so it is not walked here.
fn emit_x86_intrinsic_v2i64(s: *EmitterState, e: *Expr, llvm_name_sv: StrView, arity: i32, imm8: i64) -> i32
    var llvm_name: *u8 = llvm_name_sv.ptr
    var llvm_name_len: i32 = llvm_name_sv.len as i32
    var arg_regs: [4]i32
    var arg_count: i32 = 0
    var res_name: *u8 = c"v2i64"
    var res_name_len: i32 = 5
    var arg_it: *Expr = e.args
    while arg_it != null and arg_count < 4 and (imm8 < 0 or arg_count < arity)
        var reg: i32 = emit_expr(s, arg_it)
        var a_name: *u8 = null
        var a_len: i32 = 0
        if resolve_simd_arg_type(s, arg_it, @a_name, @a_len) == 1
            if arg_count == 0
                res_name = a_name
                res_name_len = a_len
            if name_eq(StrView { ptr: (a_name), len: (a_len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 0
                let cast_in: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, cast_in)
                emit_str(s, c" = bitcast ")
                emit_simd_vector_type(s, StrView { ptr: (a_name), len: (a_len) as i64 })
                emit_str(s, IR_SP)
                emit_reg(s, reg)
                emit_str(s, c" to <2 x i64>\n")
                reg = cast_in
        arg_regs[arg_count] = reg
        arg_count = arg_count + 1
        arg_it = arg_it.next
    if arg_count != arity
        emit_ir_error(s, e.span, c"x86 intrinsic arity mismatch")
        let z: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, z)
        emit_str(s, IR_ADD_ZERO)
        return z
    add_extern(s, StrView { ptr: (llvm_name), len: (llvm_name_len) as i64 })
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = call <2 x i64> @")
    emit_name(s, StrView { ptr: (llvm_name), len: (llvm_name_len) as i64 })
    emit_str(s, c"(")
    var k: i32 = 0
    while k < arg_count
        if k > 0
            emit_str(s, IR_COMMA)
        emit_str(s, c"<2 x i64> ")
        emit_reg(s, arg_regs[k])
        k = k + 1
    if imm8 >= 0
        emit_str(s, c", i8 ")
        emit_int(s, imm8)
    emit_str(s, IR_CLOSE)
    if name_eq(StrView { ptr: (res_name), len: (res_name_len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 1
        return result
    let cast_out: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cast_out)
    emit_str(s, c" = bitcast <2 x i64> ")
    emit_reg(s, result)
    emit_str(s, IR_TO_SP)
    emit_simd_vector_type(s, StrView { ptr: (res_name), len: (res_name_len) as i64 })
    emit_str(s, IR_NL)
    return cast_out

# `aeskeygenassist(key, rcon)` (AGAST #3266) -> the key's vector type.  LLVM
# declares rcon `immarg`: it must be a constant i8 in the call itself, so as
# in ritz0 it has to be an integer literal (optionally cast), masked to a
# byte.  Anything else is a compile error, not IR clang would refuse.
fn emit_aeskeygenassist(s: *EmitterState, e: *Expr) -> i32
    if e.args == null or e.args.next == null or e.args.next.next != null
        emit_ir_error(s, e.span, c"aeskeygenassist() requires 2 arguments (key, rcon)")
        return emit_x86_intrinsic_v2i64(s, e, StrView { ptr: (c"llvm.x86.aesni.aeskeygenassist"), len: (30) as i64 }, 2, -1)
    let rcon: *Expr = e.args.next
    var imm: i64 = -1
    if rcon.kind == ExprKind.IntLit
        imm = rcon.int_val & 255
    else if rcon.kind == ExprKind.Cast and rcon.left != null and rcon.left.kind == ExprKind.IntLit
        imm = rcon.left.int_val & 255
    if imm < 0
        emit_ir_error(s, e.span, c"aeskeygenassist() second arg (rcon) must be an integer literal (LLVM i8 immediate)")
        imm = 0
    emit_x86_intrinsic_v2i64(s, e, StrView { ptr: (c"llvm.x86.aesni.aeskeygenassist"), len: (30) as i64 }, 1, imm)

# volatile_* / atomic_* / fence (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879).
# `xgetbv(xcr)` (AGAST #4657): XCR `xcr` (ecx in) as a u64, edx:eax.  The
# operand is an integer in the i64 value model, so it is truncated to the
# i32 ecx takes; Sema has checked the arity (intrinsic_check.ritz).  ritz0's
# lowering (emitter/intrinsics.py _xgetbv), the same asm and constraints.
fn emit_xgetbv(s: *EmitterState, e: *Expr) -> i32
    let x: i32 = mem_narrow(s, emit_expr(s, e.args), 32)
    let pair: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pair)
    emit_sv(s, " = call { i32, i32 } asm sideeffect \"xgetbv\", \"={ax},={dx},{cx},~{dirflag},~{fpsr},~{flags}\"(i32 ")
    emit_reg(s, x)
    emit_sv(s, ")\n")
    var half: [2]i32
    var k: i32 = 0
    while k < 2
        let part: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, part)
        emit_sv(s, " = extractvalue { i32, i32 } ")
        emit_reg(s, pair)
        if k == 0
            emit_sv(s, ", 0\n")
        else
            emit_sv(s, ", 1\n")
        half[k] = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, half[k])
        emit_sv(s, " = zext i32 ")
        emit_reg(s, part)
        emit_sv(s, " to i64\n")
        k += 1
    let hi: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, hi)
    emit_sv(s, " = shl i64 ")
    emit_reg(s, half[1])
    emit_sv(s, ", 32\n")
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_sv(s, " = or i64 ")
    emit_reg(s, half[0])
    emit_sv(s, ", ")
    emit_reg(s, hi)
    emit_str(s, IR_NL)
    r

fn emit_mem_builtin(s: *EmitterState, e: *Expr, id: i32) -> i32
    var want: i32 = 2
    if id == MEM_FENCE
        want = 0
    else if id == MEM_VOLATILE_LOAD or id == MEM_ATOMIC_LOAD
        want = 1
    else if id == MEM_ATOMIC_CMPXCHG
        want = 3
    var argc: i32 = 0
    var a: *Expr = e.args
    while a != null
        argc += 1
        a = a.next
    if argc != want
        if want == 0
            mem_builtin_error(s, e, c"takes 0 arguments")
        else if want == 1
            mem_builtin_error(s, e, c"takes 1 argument")
        else if want == 2
            mem_builtin_error(s, e, c"takes 2 arguments")
        else
            mem_builtin_error(s, e, c"takes 3 arguments")
        return 0
    if id == MEM_FENCE
        emit_str(s, c"  fence seq_cst\n")
        return 0
    let pty: TypeKind = mem_builtin_pointee(s, e.args)
    let bits: i32 = mem_int_type_bits(pty)
    if bits == 0
        mem_builtin_error(s, e, c"needs a pointer to an integer type (i8..u64)")
        return 0
    # The pointer: an i64 address (or already a ptr, as for OpKind.Deref).
    let addr: i32 = emit_expr(s, e.args)
    var ptr: i32 = addr
    if deref_operand_is_ptr(s, e.args) == 0
        ptr = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, addr)
        emit_str(s, c" to ptr\n")
    # Value operands, left to right, at the pointee width.
    var v1: i32 = -1
    var v2: i32 = -1
    if want >= 2
        v1 = mem_narrow(s, emit_expr(s, e.args.next), bits)
    if want == 3
        v2 = mem_narrow(s, emit_expr(s, e.args.next.next), bits)
    if id == MEM_VOLATILE_STORE or id == MEM_ATOMIC_STORE
        emit_str(s, IR_STORE_IND)
        if id == MEM_VOLATILE_STORE
            emit_str(s, c"volatile ")
        else
            emit_str(s, c"atomic ")
        emit_mem_int_ty(s, bits)
        emit_str(s, IR_SP)
        emit_reg(s, v1)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, ptr)
        if id == MEM_ATOMIC_STORE
            # LLVM requires an explicit alignment on atomics: the natural one.
            emit_str(s, c" seq_cst, align ")
            emit_int(s, (bits / 8) as i64)
        emit_str(s, IR_NL)
        return 0
    let raw: i32 = next_reg(s)
    if id == MEM_VOLATILE_LOAD or id == MEM_ATOMIC_LOAD
        emit_str(s, IR_INDENT)
        emit_reg(s, raw)
        if id == MEM_VOLATILE_LOAD
            emit_str(s, c" = load volatile ")
        else
            emit_str(s, c" = load atomic ")
        emit_mem_int_ty(s, bits)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, ptr)
        if id == MEM_ATOMIC_LOAD
            emit_str(s, c" seq_cst, align ")
            emit_int(s, (bits / 8) as i64)
        emit_str(s, IR_NL)
        return mem_widen(s, raw, bits, pty)
    if id == MEM_ATOMIC_CMPXCHG
        # { iN, i1 }: the old value, and whether it equalled `expected`.
        emit_str(s, IR_INDENT)
        emit_reg(s, raw)
        emit_str(s, c" = cmpxchg ptr ")
        emit_reg(s, ptr)
        emit_str(s, IR_COMMA)
        emit_mem_int_ty(s, bits)
        emit_str(s, IR_SP)
        emit_reg(s, v1)
        emit_str(s, IR_COMMA)
        emit_mem_int_ty(s, bits)
        emit_str(s, IR_SP)
        emit_reg(s, v2)
        emit_str(s, c" seq_cst seq_cst\n")
        let old: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, old)
        emit_str(s, c" = extractvalue { ")
        emit_mem_int_ty(s, bits)
        emit_str(s, c", i1 } ")
        emit_reg(s, raw)
        emit_str(s, IR_COMMA_0)
        return mem_widen(s, old, bits, pty)
    emit_str(s, IR_INDENT)
    emit_reg(s, raw)
    emit_str(s, c" = atomicrmw ")
    if id == MEM_ATOMIC_XCHG
        emit_str(s, c"xchg")
    else if id == MEM_ATOMIC_ADD
        emit_str(s, c"add")
    else if id == MEM_ATOMIC_SUB
        emit_str(s, c"sub")
    else if id == MEM_ATOMIC_AND
        emit_str(s, c"and")
    else if id == MEM_ATOMIC_OR
        emit_str(s, c"or")
    else
        emit_str(s, c"xor")
    emit_str(s, c" ptr ")
    emit_reg(s, ptr)
    emit_str(s, IR_COMMA)
    emit_mem_int_ty(s, bits)
    emit_str(s, IR_SP)
    emit_reg(s, v1)
    emit_str(s, c" seq_cst\n")
    mem_widen(s, raw, bits, pty)

# =============================================================================
# sizeof (LANGUAGE_SPEC §7.9, AGAST #2124)
#
# `sizeof(T)` is the size of type T; `sizeof(expr)` the size of expr's TYPE.
# The operand is never evaluated: these helpers only read declarations, and
# emit_expr_call emits one constant.  Every non-type operand used to come out
# as 8 (so `mem_zero(@key[0], sizeof(key))` wiped 8 bytes of a 64-byte key),
# and so did an unknown type name.  Each helper answers -1 when it cannot
# tell, and the caller makes that a located error: no guess survives.
# =============================================================================

fn emit_call_intrinsic(s: *EmitterState, e: *Expr, ci: *CallIntrinsic) -> i32
    match ci.op
        CallIntrinsicOp.SimdLoad => emit_simd_loadu(s, e, ci.arg)
        CallIntrinsicOp.SimdStore => emit_simd_storeu(s, e, ci.arg)
        CallIntrinsicOp.SimdXor => emit_simd_binop(s, e, c"xor")
        CallIntrinsicOp.SimdAdd => emit_simd_binop(s, e, c"add")
        CallIntrinsicOp.SimdExtract => emit_simd_extract(s, e)
        CallIntrinsicOp.SimdInsert => emit_simd_insert(s, e)
        CallIntrinsicOp.SimdShuffle => emit_simd_shuffle(s, e)
        CallIntrinsicOp.SimdRotl => emit_simd_rotl(s, e)
        CallIntrinsicOp.SimdSad => emit_simd_sad(s, e)
        CallIntrinsicOp.SimdClmul => emit_simd_clmul(s, e)
        CallIntrinsicOp.X86V4i32 => emit_x86_intrinsic_v4i32(s, e, ci.llvm, ci.arg)
        CallIntrinsicOp.X86V2i64 => emit_x86_intrinsic_v2i64(s, e, ci.llvm, ci.arg, -1)
        CallIntrinsicOp.AesKeygenAssist => emit_aeskeygenassist(s, e)
        CallIntrinsicOp.Xgetbv => emit_xgetbv(s, e)

# print / eprint / println / eprintln of a literal: 1 (result in *out) when lowered here.
fn try_emit_print_call(s: *EmitterState, e: *Expr, out: *i32) -> i32
    # print() / eprint() built-ins: the same lowering to fd 1 / fd 2 (#1641).
    # println / eprintln take it too, but only for an interpolated literal
    # (a plain one stays the ritzlib.io function that adds the newline).
    var print_fd: i64 = 0
    var print_newline: i32 = 0
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"print"), len: (5) as i64 }) == 1
        print_fd = 1
    else if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"eprint"), len: (6) as i64 }) == 1
        print_fd = 2
    else if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"println"), len: (7) as i64 }) == 1
        print_fd = 1
        print_newline = 1
    else if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"eprintln"), len: (8) as i64 }) == 1
        print_fd = 2
        print_newline = 1
    # Only an interpolated literal is lowered here; a plain one still
    # resolves to whatever `println` names in this file, as ritz0 has it.
    if print_newline == 1
        if e.args == null or e.args.next != null or interp_lit_has_placeholder(e.args) == 0
            print_fd = 0
            print_newline = 0
    if print_fd == 0
        return 0
    # print(str) -> syscall(1, fd, str_ptr, str_len)
    # Get the first argument - should be a string literal
    var arg: *Expr = e.args
    if arg != null
        # "..." interpolates `{expr}` placeholders; c"..." is written
        # verbatim, and rejected if it holds one (AGAST #1521, #1394).
        # emitter_print.ritz has the lowering.
        if arg.kind == ExprKind.StringLit or arg.kind == ExprKind.CstringLit
            *out = emit_print_literal(s, print_fd, arg, print_newline)
            return 1
        else
            # Non-literal: evaluate the expression and call syscall
            let str_reg: i32 = emit_expr(s, arg)
            let result: i32 = next_reg(s)
            emit_str(s, c"  ; print() with non-literal - strlen unknown\n")
            emit_str(s, IR_INDENT)
            emit_reg(s, result)
            emit_str(s, IR_ADD_ZERO)
            *out = result
            return 1
    let zero: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, zero)
    emit_str(s, IR_ADD_ZERO)
    *out = zero
    return 1

# The built-in calls checked before user fns (variant ctors, print, write,
# format_into, sizeof, __builtin_alloca, intrinsics, memory builtins): 1
# (result in *out) when `e` is one.
fn try_emit_call_builtin(s: *EmitterState, e: *Expr, out: *i32) -> i32
    # Variant constructor: Some(x) / Ok(x) / None / Err(x) -> %Result$.../
    # Option$... struct.  Handled before the generic call path so
    # match/return paths get a type-correct aggregate (ritz-task-133).
    # AGAST #2453: a user enum declaring `Ok` / `Some` (or `Err` / `None`)
    # builds its own variant unless an Option / Result slot names the builtin.
    if users_variant_wins(s, e) == 1
        *out = try_emit_user_variant_ctor(s, e)
        return 1
    if is_variant_carrier(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1
        # Ok / Some = tag 0
        *out = emit_variant_struct(s, 0, e)
        return 1
    if is_variant_null(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1
        # Err = tag 1 (None is the no-arg case, handled in emit_expr_ident)
        *out = emit_variant_struct(s, 1, e)
        return 1
    # User-enum payload variant `Holds(x)` (AGAST #1797).  Before the
    # generic call path, as ritz0 checks variant_to_enum before functions.
    let user_ctor: i32 = try_emit_user_variant_ctor(s, e)
    if user_ctor != 0
        *out = user_ctor
        return 1
    # write(w, "...{x}...") / writeln: Display through the Writer the
    # program named, not an implicit one (AGAST #4381, ritz0's #202). Only
    # an interpolated literal is lowered here; a plain one is the ordinary
    # StrView call. Checked before user fns, like print.
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"write"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"writeln"), len: (7) as i64 }) == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            let wlit: *Expr = e.args.next
            if wlit.kind == ExprKind.StringLit and interp_lit_has_placeholder(wlit) == 1
                var wnl: i32 = 0
                if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"writeln"), len: (7) as i64 }) == 1
                    wnl = 1
                *out = emit_write_literal(s, wlit, e.args, wnl)
                return 1

    # format_into(sink, "...") -- print's literal, appended to a buffer
    # through sink.push_bytes (AGAST #1824). emitter_print.ritz has it.
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"format_into"), len: (11) as i64 }) == 1
        *out = emit_format_into(s, e)
        return 1
    var print_reg: i32 = 0
    if try_emit_print_call(s, e, @print_reg) == 1
        *out = print_reg
        return 1

    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "sizeof") == 1
        # sizeof(T) / sizeof(expr) -> compile-time constant; the operand is
        # not evaluated (AGAST #2124, see sizeof_call_value).
        let type_size: i64 = sizeof_call_value(s, e)
        let result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, type_size)
        emit_str(s, IR_NL)
        *out = result
        return 1

    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "__builtin_alloca") == 1
        # __builtin_alloca(size) -> alloca i8, i64 size
        var arg: *Expr = e.args
        if arg != null
            let size_reg: i32 = emit_expr(s, arg)
            let alloca_reg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, alloca_reg)
            emit_str(s, c" = alloca i8, i64 ")
            emit_reg(s, size_reg)
            emit_str(s, IR_NL)
            # Convert to i64 for uniform representation
            let ptr_reg: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, alloca_reg)
            *out = ptr_reg
            return 1
        # No argument - allocate 1 byte
        let alloca_reg: i32 = next_reg(s)
        entry_alloca_reg(s, alloca_reg, c"i8", null)
        let ptr_reg: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, alloca_reg)
        *out = ptr_reg
        return 1

    let intrinsic: *CallIntrinsic = call_intrinsic_named(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if intrinsic != null
        *out = emit_call_intrinsic(s, e, intrinsic)
        return 1
    # AGAST #1879: volatile / atomic memory builtins.  Reserved names, as in
    # ritz0: checked before user fns, so they never become an extern.
    let mem_id: i32 = mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if mem_id != 0
        *out = emit_mem_builtin(s, e, mem_id)
        return 1
    0

# What emit_expr_call learned about a call through a value: the local slot
# holding the fn pointer (-1: none), its signature, and a nameless callee's
# evaluated address (-1: none).
struct CallCallee
    icall_local: i32
    icall_sig: *FnDef
    callee_val: i32

# A call of a fn-pointer local or of a nameless callee: fills `c`; 1 (result in
# *out) when the untyped `call i64` path lowered it whole.
fn try_emit_indirect_call(s: *EmitterState, e: *Expr, c: *CallCallee, out: *i32) -> i32
    # Indirect call via local fn-ptr.  When `e.func_name` matches a
    # local variable (e.g. `let h: fn(*Task) -> i32 = task.handler`),
    # the call must load the function pointer from the slot and use
    # `call ... %ptr(...)` rather than `call ... @h(...)`.  Without
    # this, the linker fails with "undefined reference to `h`" because
    # we mistakenly registered the symbol as an extern.  Common in
    # ritzlib's async/tasks (`run_tasks`, `task_server_poll_tasks`,
    # `task_server_run_multishot`) and valet's connection dispatcher.
    #
    # AGAST #1671: when the local's declared type is a `fn(...) -> T` whose
    # signature the parser kept (params and typed `let`s), fall through to
    # the direct-call path below with that signature standing in for the
    # callee's FnDef: args convert to the real param types and the result
    # is read at the real return width (`call i1 %f(i8 ...)`, then zext).
    # The untyped `call i64 %f(i64 ...)` below remains only for locals
    # whose type is unknown (e.g. inferred `let h = task.handler`).
    c.icall_local = find_local(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    # AGAST #2407: a local named like a fn is the local, so a call of one that
    # holds no fn value is an error, not a call of the fn or a jump to the value.
    if c.icall_local >= 0 and e.call_type_suffix_len == 0
        let named: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if named != null and lv_fn_sig(named) == null and named.not_fn == 1
            binder_call_refuse(fn_source_file(emitter_current_fn()), e.span.line, e.span.col, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
            emit_str(s, c"  ; ERROR: a call of a local that holds no fn\n")
            s.error_count = s.error_count + 1
            *out = 0
            return 1
    # AGAST #2255, #2246: a local of this name is a fn pointer, not the procedure.
    if c.icall_local < 0 and e.func_name_len > 0
        note_callee(s, e, find_call_fn(s, e), StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    c.icall_sig = null
    if c.icall_local >= 0 and e.call_type_suffix_len == 0
        let icall_lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if icall_lv != null
            c.icall_sig = lv_fn_sig(icall_lv)
        if fn_is_procedure(c.icall_sig) == 1   # AGAST #2260: a fn pointer
            reject_procedure_value(s, e, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    # AGAST #1747: a nameless call (`fs[i](..)`): the callee is an expression
    # in `left`, evaluated first (left to right), to an i64 address.  With a
    # known signature it takes the typed path below, as a typed fn-ptr local
    # does; otherwise it is the untyped `call i64` an untyped local gets.
    c.callee_val = -1
    if e.func_name_len == 0
        c.icall_sig = call_callee_sig(s, e)
        if fn_is_procedure(c.icall_sig) == 1   # AGAST #2260
            reject_procedure_value(s, e, StrView { ptr: (null), len: (0) as i64 })
        c.callee_val = emit_expr(s, e.left)
        if c.icall_sig == null
            let ut_args: *i32 = call_reg_slots(e.args, 0)
            var ut_argc: i32 = 0
            var ut_arg: *Expr = e.args
            while ut_arg != null
                ut_args[ut_argc] = emit_expr(s, ut_arg)
                ut_argc += 1
                ut_arg = ut_arg.next
            let ut_fp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, c.callee_val)
            let ut_result: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ut_result)
            emit_str(s, c" = call i64 ")
            emit_reg(s, ut_fp)
            emit_str(s, c"(")
            for j in 0..ut_argc
                if j > 0
                    emit_str(s, IR_COMMA)
                emit_str(s, c"i64 ")
                emit_reg(s, ut_args[j])
            emit_str(s, IR_CLOSE)
            *out = ut_result
            return 1
    if c.icall_local >= 0 and e.call_type_suffix_len == 0 and c.icall_sig == null
        # Evaluate args first.
        let icall_args: *i32 = call_reg_slots(e.args, 0)
        var icall_argc: i32 = 0
        var icall_arg: *Expr = e.args
        while icall_arg != null
            icall_args[icall_argc] = emit_expr(s, icall_arg)
            icall_argc += 1
            icall_arg = icall_arg.next
        # Load fn pointer from the slot.
        let icall_fp: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, icall_fp, c.icall_local)
        # Emit indirect call. We don't know the return type precisely,
        # so default to i64 (the unified value model).  Args are passed
        # as i64 — fn-ptr locals are typed as `fn(*T) -> i32` etc., but
        # ritz1's local tracker doesn't carry the signature.
        let icall_result: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, icall_result)
        emit_str(s, c" = call i64 ")
        emit_reg(s, icall_fp)
        emit_str(s, c"(")
        for j in 0..icall_argc
            if j > 0
                emit_str(s, IR_COMMA)
            emit_str(s, c"i64 ")
            emit_reg(s, icall_args[j])
        emit_str(s, IR_CLOSE)
        *out = icall_result
        return 1
    0

# A typed param's arg, by the param's value type: bool, float or a by-value aggregate.
fn call_convert_value_arg(s: *EmitterState, e: *Expr, j: i32, param_ptr: *Param, arg_regs: *i32, converted_regs: *i32)
    match param_ptr.param_type
        TypeKind.Bool =>
            # Callee expects i1; every bool value is an i64 register
            # (AGAST #1646, a bool global's load too since #3001), so
            # trunc.  `takes(yes())` passed the zext'd i64 as is (#1646).
            let bool_trunc: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, bool_trunc)
            emit_str(s, IR_TRUNC)
            emit_reg(s, arg_regs[j])
            emit_str(s, c" to i1\n")
            converted_regs[j] = bool_trunc
        TypeKind.F32 | TypeKind.F64 =>
            # Callee expects float / double.  Coerce based on actual arg
            # type: int → sitofp; double-when-target-is-float → fptrunc;
            # already-matching float passthrough.  The arg expression's
            # type tells us which path (default lit-int → i64 → sitofp).
            var f_arg_expr: *Expr = e.args
            var fk: i32 = 0
            while fk < j and f_arg_expr != null
                f_arg_expr = f_arg_expr.next
                fk = fk + 1
            var src_ty: TypeKind = TypeKind.I64
            if f_arg_expr != null
                src_ty = float_arg_src_type(s, f_arg_expr, param_ptr.param_type)
            if src_ty == TypeKind.F32 and param_ptr.param_type == TypeKind.F32
                converted_regs[j] = arg_regs[j]
            else if src_ty == TypeKind.F64 and param_ptr.param_type == TypeKind.F64
                converted_regs[j] = arg_regs[j]
            else if src_ty == TypeKind.F64 and param_ptr.param_type == TypeKind.F32
                let trunc: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, trunc)
                emit_str(s, c" = fptrunc double ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to float\n")
                converted_regs[j] = trunc
            else if src_ty == TypeKind.F32 and param_ptr.param_type == TypeKind.F64
                let ext: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, ext)
                emit_str(s, c" = fpext float ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to double\n")
                converted_regs[j] = ext
            else
                # Integer source: exact only, by its signedness (#2945).
                converted_regs[j] = emit_int_into_float_slot(s, arg_regs[j], float_slot_unsigned(f_arg_expr), param_ptr.param_type)
        _ =>
            if is_span_param(param_ptr) == 1
                var span_arg_expr: *Expr = e.args
                var sak: i32 = 0
                while sak < j and span_arg_expr != null
                    span_arg_expr = span_arg_expr.next
                    sak = sak + 1
                converted_regs[j] = span_param_arg(s, span_arg_expr, param_ptr, arg_regs[j])
            else if param_ptr.param_type == TypeKind.Struct and param_ptr.param_type_name_len == 7
                var is_strview: bool = false
                if name_eq(StrView { ptr: (param_ptr.param_type_name), len: (7) as i64 }, "StrView") == 1
                    is_strview = true
                if is_strview
                    # Get the argument expression to check if it's a string literal
                    var arg_expr: *Expr = e.args
                    var k: i32 = 0
                    while k < j and arg_expr != null
                        arg_expr = arg_expr.next
                        k = k + 1
                    let sv_lit: i32 = emit_strview_from_lit(s, arg_expr, arg_regs[j])
                    if sv_lit >= 0
                        converted_regs[j] = sv_lit
                    else
                        converted_regs[j] = arg_regs[j]
                else
                    converted_regs[j] = arg_regs[j]
            else
                # Final fallback for TypeKind.Struct params not matched by any
                # specialised branch (StrView/Span/primitive).  ptr_value_
                # coercion regression: `sum_point(@p)` where p: PointI and
                # the callee takes PointI by value.  emit_expr(@p) emitted
                # i64 (ptrtoint of the alloca); we need %PointI value.  If
                # the arg is OpKind.Addr/OpKind.AddrMut and the param is a
                # struct, inttoptr+load to materialise the value.
                var fb_arg: *Expr = e.args
                var fk: i32 = 0
                while fk < j and fb_arg != null
                    fb_arg = fb_arg.next
                    fk = fk + 1
                var fb_done: bool = false
                if param_ptr.param_type == TypeKind.Struct and param_ptr.param_type_name_len > 0
                    if fb_arg != null and fb_arg.kind == ExprKind.Unary
                        if fb_arg.op == OpKind.Addr or fb_arg.op == OpKind.AddrMut
                            let fb_pp: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, fb_pp)
                            emit_str(s, IR_INTTOPTR)
                            emit_reg(s, arg_regs[j])
                            emit_str(s, c" to ptr\n")
                            let fb_v: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, fb_v)
                            emit_str(s, IR_LOAD_NAMED)
                            emit_name(s, StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 })
                            emit_str(s, IR_PTR_SEP)
                            emit_reg(s, fb_pp)
                            emit_str(s, IR_NL)
                            converted_regs[j] = fb_v
                            fb_done = true
                if not fb_done
                    converted_regs[j] = arg_regs[j]

# Arg j into the typed param `param_ptr`'s representation, in converted_regs[j].
fn call_convert_param_arg(s: *EmitterState, e: *Expr, j: i32, param_ptr: *Param, arg_regs: *i32, converted_regs: *i32, param_types: *TypeKind)
    param_types[j] = param_ptr.param_type
    # AGAST #176: Span$u8 / StrView -> i64 coercion for legacy *u8
    # (TypeKind.Ptr / TypeKind.Ref / TypeKind.I64) params.  Bare "..." lowers to
    # %Span$u8 (#98); without this coercion `eprints_cstr("...")`
    # emits `call void @eprints_cstr(i64 %.span)` and the IR verifier
    # rejects the aggregate-into-i64 mismatch.  helper returns the
    # coerced i64 reg or -1 (fall through to the regular cascade).
    # Also subsumes the narrower string-literal coercion ritz-task-172
    # added for cryptosec's hkdf_expand_label("key", …) call site.
    var s176_arg_iter: *Expr = e.args
    var s176_ai: i32 = 0
    while s176_ai < j and s176_arg_iter != null
        s176_arg_iter = s176_arg_iter.next
        s176_ai = s176_ai + 1
    var s176_reg: i32 = 0 - 1
    if param_uses_byval(s, param_ptr) == 0
        s176_reg = try_emit_span_to_i64_arg(s, s176_arg_iter, param_ptr.param_type, arg_regs[j])
    if param_uses_byval(s, param_ptr) == 1
        # AGAST #1739 — already the byval slot (emit_call_arg).
        converted_regs[j] = arg_regs[j]
    else if s176_reg >= 0
        converted_regs[j] = s176_reg
    # Truncate i64 values to smaller types if needed
    else if ty_int_bits(param_ptr.param_type) == 8
        let trunc: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, trunc)
        emit_str(s, IR_TRUNC)
        emit_reg(s, arg_regs[j])
        emit_str(s, c" to i8\n")
        converted_regs[j] = trunc
    else if ty_int_bits(param_ptr.param_type) == 32
        let trunc: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, trunc)
        emit_str(s, IR_TRUNC)
        emit_reg(s, arg_regs[j])
        emit_str(s, c" to i32\n")
        converted_regs[j] = trunc
    else if ty_int_bits(param_ptr.param_type) == 16
        let trunc: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, trunc)
        emit_str(s, IR_TRUNC)
        emit_reg(s, arg_regs[j])
        emit_str(s, c" to i16\n")
        converted_regs[j] = trunc
    else if param_ptr.param_type == TypeKind.Struct and param_ptr.param_type_name_len > 0 and is_primitive_type_name(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }) == 1
        # Post-monomorph primitive param (vec_push_u16_method parity):
        # `T` substituted with u16/i32/etc. but left TypeKind.Struct in AST.
        # emit_llvm_type_struct maps the name back for signatures;
        # match by truncating i64 arg down to primitive width.
        if name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
            let tp8: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, tp8)
            emit_str(s, IR_TRUNC)
            emit_reg(s, arg_regs[j])
            emit_str(s, c" to i8\n")
            converted_regs[j] = tp8
        else if name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"u16"), len: (3) as i64 }) == 1 or name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"i16"), len: (3) as i64 }) == 1
            let tp16: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, tp16)
            emit_str(s, IR_TRUNC)
            emit_reg(s, arg_regs[j])
            emit_str(s, c" to i16\n")
            converted_regs[j] = tp16
        else if name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"u32"), len: (3) as i64 }) == 1 or name_eq(StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, StrView { ptr: (c"i32"), len: (3) as i64 }) == 1
            let tp32: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, tp32)
            emit_str(s, IR_TRUNC)
            emit_reg(s, arg_regs[j])
            emit_str(s, c" to i32\n")
            converted_regs[j] = tp32
        else
            # bool/usize/isize/u64/i64/f32/f64: passthrough.
            converted_regs[j] = arg_regs[j]
    else if (param_ptr.param_type == TypeKind.Ptr or param_ptr.param_type == TypeKind.PtrPtr) and expr_is_ptr_valued(s, nth_arg(e.args, j)) == 1
        # AGAST #1644: `*T` params are i64 in ritz1's value model,
        # but `@&v` and a TypeKind.MutRef ident are `ptr`.
        let ptr_arg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr_arg)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, arg_regs[j])
        emit_str(s, c" to i64  ; #1644 @&T->*T\n")
        converted_regs[j] = ptr_arg
    else if param_ptr.param_type == TypeKind.Ref and expr_is_ptr_valued(s, nth_arg(e.args, j)) == 1
        # AGAST #2416: an `@T` param is i64 too, so `rd(@&c)` (a `ptr`)
        # needs the same ptrtoint, for a struct of any size or a scalar.
        converted_regs[j] = ptr_value_to_i64(s, nth_arg(e.args, j), arg_regs[j])
    else if param_ptr.param_type == TypeKind.MutRef
        # TypeKind.MutRef params expect ptr.  An `@&T` ident, `@&v` or
        # `v as @&T` is already `ptr`; anything else -- `@v`, a `*T`
        # value, and (AGAST #1757) a `-> @&T` call result, which
        # get_expr_type calls TypeKind.MutRef but is i64 -- is inttoptr'd.
        converted_regs[j] = i64_value_to_ptr(s, nth_arg(e.args, j), arg_regs[j])
    else if param_ptr.param_type == TypeKind.Ref and param_ptr.param_type_name_len > 0
        # AGAST #113 — auto-borrow: @Struct param + Struct-valued ident
        # actual. Callsite emits `i64` for TypeKind.Ref, but emit_expr of a
        # struct ident loaded `%Struct`. Take the local slot's address
        # as i64 instead (the load is left orphaned — harmless).
        var ref_arg: *Expr = e.args
        var rk: i32 = 0
        while rk < j and ref_arg != null
            ref_arg = ref_arg.next
            rk = rk + 1
        var ref_done: bool = false
        # AGAST #187 — narrow TypeKind.MutRef → TypeKind.Ref coercion.
        # Caller has `@&T` (lowered as `ptr`); callee expects `@T`
        # (lowered as `i64`).  arg_regs[j] is a freshly-loaded `ptr`
        # from the caller's MUT_REF slot; insert a `ptrtoint` so the
        # call-site i64 signature matches.  Repro: tome.ritz:3327
        # `pubsub_unsubscribe(ps: @&PubSub)` calling
        # `pubsub_find_channel(ps: @PubSub, …)`.
        #
        # Narrow scoping: only when the actual arg is an ExprKind.Ident
        # whose local has var_type == TypeKind.MutRef.  An earlier
        # broader attempt (#184 reverted) regressed
        # test_issue_strview_as_bytes by hitting StrView struct args.
        if ref_arg != null and ref_arg.kind == ExprKind.Ident
            let mr_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (ref_arg.ident_ptr), len: (ref_arg.ident_len) as i64 })
            if mr_loc != null and lv_var_type(mr_loc) == TypeKind.MutRef
                let pti_mr: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, pti_mr)
                emit_str(s, c" = ptrtoint ptr ")
                emit_reg(s, arg_regs[j])
                emit_str(s, c" to i64  ; #187 @&T->@T\n")
                converted_regs[j] = pti_mr
                ref_done = true
        if not ref_done and ref_arg != null and ref_arg.kind == ExprKind.Ident
            let ref_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (ref_arg.ident_ptr), len: (ref_arg.ident_len) as i64 })
            if ref_loc != null and lv_var_type(ref_loc) == TypeKind.Struct
                let pti_r: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, pti_r)
                emit_str(s, c" = ptrtoint ptr ")
                emit_reg(s, ref_loc.reg)
                emit_str(s, IR_TO_I64)
                converted_regs[j] = pti_r
                ref_done = true
        # Rvalue auto-borrow: `f(call_returning_struct())` where
        # f wants @Struct.  arg_regs[j] holds the %Struct value
        # returned by the call — spill it to a stack slot and
        # pass the slot's address as i64.  Without this, the
        # struct-typed reg gets cast to i64 implicitly (clang
        # rejects).
        if not ref_done and ref_arg != null
            if (ref_arg.kind == ExprKind.Method or ref_arg.kind == ExprKind.Call) and call_returns_address(s, ref_arg) == 0
                let spill: i32 = next_reg(s)
                entry_alloca_reg_begin_named(s, spill)
                emit_name(s, StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 })
                emit_str(s, c"  ; rvalue auto-borrow\n")
                entry_alloca_reg_end(s)
                emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (param_ptr.param_type_name), len: (param_ptr.param_type_name_len) as i64 }, arg_regs[j], spill)
                let pti_rv: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, spill)
                converted_regs[j] = pti_rv
                ref_done = true
        if not ref_done
            converted_regs[j] = arg_regs[j]
    else
        call_convert_value_arg(s, e, j, param_ptr, arg_regs, converted_regs)

# Convert each evaluated arg to its param's type before the call (the i64 value
# model to the callee's ABI); an unknown callee takes i64s.
fn call_convert_args(s: *EmitterState, e: *Expr, fn_def: *FnDef, arg_regs: *i32, arg_count: i32, converted_regs: *i32, param_types: *TypeKind)
    var param_ptr: *Param = null
    if fn_def != null
        param_ptr = fn_def.params
    for j in 0..arg_count
        if param_ptr != null
            call_convert_param_arg(s, e, j, param_ptr, arg_regs, converted_regs, param_types)
            param_ptr = param_ptr.next
        else
            # fn_def is null - external function, assume i64 for all args
            # But a `ptr`-valued argument (`@&v`, an `@&T` local) needs a
            # ptrtoint; a `-> @&T` call result is already i64 (AGAST #1758).
            param_types[j] = TypeKind.I64
            var arg_expr: *Expr = e.args
            var k: i32 = 0
            while k < j and arg_expr != null
                arg_expr = arg_expr.next
                k = k + 1
            # AGAST #176: Span$u8 / StrView -> i64 coercion (extern path).
            # When fn_def is missing we assume `i64` per arg; a %Span$u8
            # aggregate would otherwise flow through unchanged and fail IR
            # verification at the callsite.  The helper handles the resolve
            # + extractvalue + ptrtoint and returns -1 on no-match.
            let s176_ext_reg: i32 = try_emit_span_to_i64_arg(s, arg_expr, TypeKind.I64, arg_regs[j])
            if s176_ext_reg >= 0
                converted_regs[j] = s176_ext_reg
            else
                converted_regs[j] = ptr_value_to_i64(s, arg_expr, arg_regs[j])

pub fn emit_expr_call(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    var builtin_reg: i32 = 0
    if try_emit_call_builtin(s, e, @builtin_reg) == 1
        return builtin_reg

    var cc: CallCallee = CallCallee { icall_local: 0 - 1, icall_sig: null, callee_val: 0 - 1 }
    var indirect_reg: i32 = 0
    if try_emit_indirect_call(s, e, @cc, @indirect_reg) == 1
        return indirect_reg
    let icall_local: i32 = cc.icall_local
    let icall_sig: *FnDef = cc.icall_sig
    let callee_val: i32 = cc.callee_val

    # Regular function call - register as external if not defined in this module
    # Build the full function name with type suffix (e.g., "vec_new$u8" for vec_new<u8>())
    # Heap, sized from name+suffix: a fixed [128]u8 was overrun by a long name
    # (AGAST #1813).
    let full_name: *u8 = malloc((e.func_name_len + e.call_type_suffix_len + 1) as i64)
    var full_len: i32 = 0
    # Copy base function name
    for i in 0..e.func_name_len
        full_name[full_len] = *(e.func_name + i)
        full_len = full_len + 1
    # Append type suffix if present (generic call)
    if e.call_type_suffix_len > 0
        for i in 0..e.call_type_suffix_len
            full_name[full_len] = *(e.call_type_suffix + i)
            full_len = full_len + 1
    # Look up the callee first: its params give each argument its enum
    # context (AGAST #1498), and its return type is needed below.  A typed
    # indirect call (AGAST #1671) uses the fn type's signature instead and
    # names no symbol, so it registers no extern.
    var fn_def: *FnDef = icall_sig
    # AGAST #4356: 1 when fn_def came from the impl table, never mangled.
    var fn_from_impl: i32 = 0
    # AGAST #3690: a byval past 4 GiB is a clang verifier abort, unlocated.
    if icall_sig != null and refuse_huge_fn_type_byval(s, icall_sig) == 1
        return 0
    if icall_sig == null
        add_extern(s, StrView { ptr: (full_name), len: (full_len) as i64 })
        fn_def = find_fn(s, StrView { ptr: (full_name), len: (full_len) as i64 })
        # R10: `C_g(c)` is the method `c.g()` calls; impl methods aren't in
        # fn_map, so without this the call took the untyped i64 fallback and
        # clang refused it, unlocated (AGAST #2447).
        if fn_def == null
            fn_def = find_impl_method_by_symbol(s.module, StrView { ptr: (full_name), len: (full_len) as i64 })
            fn_from_impl = 1
        # AGAST #3255, #3667: Sema's call_check refused a call no fn answers
        # (AGAST #3503), so one reaching here is a Sema / emitter split.
        if fn_def == null
            emit_ir_error_begin(s, e.span, c"a call Sema passed names no fn: '")
            emit_ir_error_end(s, StrView { ptr: (full_name), len: (full_len) as i64 })
            return 0
        fn_def = lent_self_call_view(s, fn_def)
    # AGAST #4356: a private free fn's symbol carries its defining file, so
    # an instance emitted in this object resolves its module's definition.
    # Not a method (twins may not share `T_m`, type_twins.ritz; its define
    # keeps the plain name).
    var callee_sym: *u8 = full_name
    var callee_sym_len: i32 = full_len
    if fn_from_impl == 0 and fn_private_free(fn_def) == 1
        callee_sym = fn_symbol(fn_def, @callee_sym_len)
    # AGAST #1629: Sema's call_check has judged the argument count and each
    # argument's kind (AGAST #3503).

    # Sized from the argument list (AGAST #1813): a fixed [16] dropped every
    # argument past the 16th.
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg2: *Expr = e.args
    var ap: *Param = null
    if fn_def != null
        ap = fn_def.params
    while arg2 != null
        arg_regs[arg_count] = emit_call_arg(s, arg2, ap)
        arg_count += 1
        if ap != null
            ap = ap.next
        arg2 = arg2.next

    # fn_def is a direct callee or the signature of a fn value.
    if refuse_array_return(s, e, fn_def) == 1
        return 0
    var ret_type: TypeKind = TypeKind.I64  # Default for unknown functions
    var ret_struct_name: *u8 = null
    var ret_struct_name_len: i32 = 0
    if fn_def != null
        ret_type = fn_def.return_type
        if fn_def.return_type == TypeKind.Struct
            ret_struct_name = fn_def.return_type_name
            ret_struct_name_len = fn_def.return_type_name_len

    # Convert argument values to match parameter types BEFORE emitting call
    let converted_regs: *i32 = call_reg_slots(e.args, 0)
    let param_types: *TypeKind = call_reg_slots(e.args, 0) as *TypeKind
    call_convert_args(s, e, fn_def, arg_regs, arg_count, converted_regs, param_types)

    # Now emit the call with converted registers.  A typed indirect call
    # loads the fn pointer from its slot here, after the args.
    var icall_fp_reg: i32 = -1
    if callee_val >= 0
        icall_fp_reg = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, icall_fp_reg)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, callee_val)
        emit_str(s, c" to ptr\n")
    else if icall_sig != null
        icall_fp_reg = next_reg(s)
        emit_load_into(s, IR_TY_PTR, icall_fp_reg, icall_local)
    var call_result: i32 = 0
    # AGAST #1730 — a large struct comes back through a caller-owned slot
    # (also for typed indirect calls: the pointee was defined the same way).
    var call_sret: i32 = 0
    # [[callconv = "win64"]] on the callee, or on the fn type of a typed
    # indirect call (fn_def is then its signature) -- AGAST #1879.
    let call_cc: *u8 = fn_callconv_kw(s.mono.pctx, fn_def)
    if struct_ret_uses_sret(s, ret_type, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }) == 1
        call_sret = emit_sret_call_slot(s, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 })
    call_sret = emit_call_sret_array_slot(s, fn_def, call_sret)   # AGAST #3181
    if call_sret > 0
        call_result = next_reg(s)
        emit_str(s, c"  call ")
        emit_str(s, call_cc)
        emit_str(s, c"void ")
    else if ret_type == TypeKind.Void
        # void call - no result register assignment
        emit_str(s, c"  call ")
        emit_str(s, call_cc)
        emit_str(s, c"void ")
    else
        call_result = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, call_result)
        emit_call_ret_kw(s, fn_def, ret_type, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, call_cc)
    if icall_fp_reg >= 0
        emit_reg(s, icall_fp_reg)
    else
        emit_str(s, c"@")
        emit_name(s, StrView { ptr: (callee_sym), len: (callee_sym_len) as i64 })
    emit_str(s, c"(")
    if call_sret > 0
        emit_call_sret_attr(s, fn_def, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 })
        emit_reg(s, call_sret)

    for j in 0..arg_count
        if j > 0 or call_sret > 0
            emit_str(s, IR_COMMA)
        if fn_def != null
            # Reset param_ptr to walk params again
            var p: *Param = fn_def.params
            var k: i32 = 0
            while k < j and p != null
                p = p.next
                k = k + 1
            if p != null
                emit_param_llvm_type(s, p)   # AGAST #1739
            else
                emit_str(s, c"i64")
        else
            emit_str(s, c"i64")
        emit_str(s, IR_SP)
        emit_reg(s, converted_regs[j])

    emit_str(s, IR_CLOSE)
    if call_sret > 0
        call_result = emit_call_sret_result(s, fn_def, call_result, call_sret, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 })

    return widen_call_result(s, ret_type, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, call_result)

# Option<T>.unwrap / .unwrap_or and Result<T,E>.unwrap / .unwrap_or — inline
# intrinsic matching the tag-encoded i64 representation that ritz1 uses for
# tagged enums (see emitter_match.ritz and is_variant_carrier in this file):
#   tag==1 payload   → Some(x) / Ok(x)  : (1 << 48) | (x & 0xFFFFFFFFFFFF)
#   tag==0 payload   → None / Err(x)    : (x & 0xFFFFFFFFFFFF)
#
# This mirrors ritz0's `_try_emit_enum_unwrap_method` (emitter_llvmlite.py
# ~line 7808) but works directly against the packed i64 rather than an
# { i8 tag, ... } struct.
#
# recv_value_reg: if non-negative, an i64 register already holding the
#   enum value (set by emit_expr_method when the receiver is a call
#   result). If -1, load from the stack slot `receiver_reg`.
# Returns an i64 register with the payload on success, -1 if this helper
# doesn't apply. (ritz-task-106)
fn try_emit_enum_unwrap(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32, recv_value_reg: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    # Type must be Option$... or Result$...
    var is_opt: i32 = ((StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Option$"), len: (7) as i64 })) as i32
    var is_res: i32 = ((StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Result$"), len: (7) as i64 })) as i32
    if is_opt == 0 and is_res == 0
        return -1

    # Method must be "unwrap" (0 args) or "unwrap_or" (1 arg).
    var is_unwrap: bool = false
    var is_unwrap_or: i32 = 0
    if e.ident_len == 6
        if *(e.ident_ptr + 0) == 'u'   # u
            if *(e.ident_ptr + 1) == 'n'   # n
                if *(e.ident_ptr + 2) == 'w'   # w
                    if *(e.ident_ptr + 3) == 'r'   # r
                        if *(e.ident_ptr + 4) == 'a'    # a
                            if *(e.ident_ptr + 5) == 'p'    # p
                                is_unwrap = true
    if e.ident_len == 9
        if *(e.ident_ptr + 0) == 'u'   # u
            if *(e.ident_ptr + 1) == 'n'   # n
                if *(e.ident_ptr + 2) == 'w'   # w
                    if *(e.ident_ptr + 3) == 'r'   # r
                        if *(e.ident_ptr + 4) == 'a'    # a
                            if *(e.ident_ptr + 5) == 'p'    # p
                                if *(e.ident_ptr + 6) == '_'    # _
                                    if *(e.ident_ptr + 7) == 'o'   # o
                                        if *(e.ident_ptr + 8) == 'r'   # r
                                            is_unwrap_or = 1
    if not is_unwrap and is_unwrap_or == 0
        return -1
    if is_unwrap and e.args != null
        return -1
    if is_unwrap_or == 1
        if e.args == null
            return -1

    # Materialise the receiver into a stack slot we can GEP against.  The
    # struct has shape `{ i8 tag, [N x i8] payload }` (ritz-task-133).
    #
    # Three receiver forms feed this helper:
    #   recv_value_reg >= 0          — aggregate value already in a register
    #                                  (ExprKind.Call / ExprKind.Method chain).
    #   receiver_reg + recv_is_ptr_of_ptr==0 — ident holding the struct
    #                                  directly in its slot.
    #   receiver_reg + recv_is_ptr_of_ptr==1 — ident holding a pointer to
    #                                  the struct (rare in practice).
    var scrut_slot: i32 = 0
    if recv_value_reg >= 0
        scrut_slot = next_reg(s)
        entry_alloca_reg_begin_named(s, scrut_slot)
        emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
        emit_str(s, c"  ; unwrap scrut spill\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (type_name), len: (type_name_len) as i64 }, recv_value_reg, scrut_slot)
    else
        scrut_slot = receiver_reg
        if recv_is_ptr_of_ptr == 1
            let loaded: i32 = next_reg(s)
            emit_load_into(s, IR_TY_PTR, loaded, receiver_reg)
            scrut_slot = loaded

    # tag = load i8 from field 0
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, scrut_slot)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I8, tag_reg, tag_ptr)

    # AGAST #4603: unwrap() of a None / Err traps, as ritz0's does: the tag
    # check branches to `llvm.trap` (SIGILL), and the payload is read only
    # on the Some / Ok path.  It loaded the payload unchecked, so a None
    # unwrapped to 0 and the program carried on.
    if is_unwrap
        emit_unwrap_tag_trap(s, tag_reg)

    # payload = the Ok / Some payload at field 2 (AGAST #1898), loaded at its
    # own width and widened to i64 because ritz1's call/arith paths expect
    # i64-width scalars; aggregate unwrap returns would need a more careful
    # type-oracle pass — deferred.
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, scrut_slot)
    emit_str(s, c", i32 0, i32 2\n")
    # AGAST #2594: a struct payload (`Option<P>`) loads as its `%P`, as `?`
    # does (emit_try's aggregate arm); an i64 load gave clang `store %P <i64>`.
    # AGAST #3250 / #2863: `unwrap_or(d)` selects between that `%P` and the
    # default's `%P`; it selected i64s, so a struct (`Vec$E`) default was an
    # aggregate where clang wanted an i64.
    # AGAST #3620: a user-enum payload (`Option<HotkeyAction>`) is its `%E`
    # aggregate as well, as `Some(x)` builds it (#2100): an i64 load gave
    # `match o.unwrap()` clang's `store %E <i64>` (prism's test_input).
    var pay_name_len: i32 = 0
    let pay_name: *u8 = tagged_enum_payload_named(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, @pay_name_len, 1)
    if pay_name != null
        let agg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, agg)
        emit_str(s, IR_LOAD_NAMED)
        emit_name(s, StrView { ptr: (pay_name), len: (pay_name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, pay_ptr)
        emit_str(s, c"  ; unwrap struct payload\n")
        if is_unwrap
            return agg
        let ok_agg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ok_agg)
        emit_str(s, c" = icmp eq i8 ")
        emit_reg(s, tag_reg)
        emit_str(s, c", 0  ; unwrap_or tag check (Ok/Some == 0)\n")
        # AGAST #4679: the default is a value of the payload's type, as a
        # `let` of it is: a `"/"` is rebuilt from its `%Span$u8` into the
        # `%StrView` the select wants, and a struct element is its copy.
        let def_agg: i32 = emit_store_into_slot(s, e.args, TypeKind.Struct, StrView { ptr: (pay_name), len: (pay_name_len) as i64 })
        let sel_agg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sel_agg)
        emit_str(s, c" = select i1 ")
        emit_reg(s, ok_agg)
        emit_str(s, c", %")
        emit_name(s, StrView { ptr: (pay_name), len: (pay_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, agg)
        emit_str(s, c", %")
        emit_name(s, StrView { ptr: (pay_name), len: (pay_name_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, def_agg)
        emit_str(s, IR_NL)
        return sel_agg
    let payload: i32 = emit_tagged_payload_load(s, pay_ptr, StrView { ptr: (type_name), len: (type_name_len) as i64 }, 0)

    if is_unwrap
        # unwrap(): the tag check above already trapped on None / Err.
        return payload

    # unwrap_or(default): select payload when tag==0, else default.
    let tag_ok: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ok)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", 0  ; unwrap_or tag check (Ok/Some == 0)\n")

    # AGAST #4679: a `"q"` default of a `*u8` payload is its bytes, as in any
    # `*u8` slot (literal_slot.ritz's lit_into_ptr): Sema never types this
    # argument, so it stayed a `%Span$u8` in an i64 select.
    var arg_len: i32 = 0
    let arg: *u8 = tagged_enum_arg(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, 0, @arg_len)
    if e.args.kind == ExprKind.StringLit and arg != null and name_eq(StrView { ptr: (arg), len: (arg_len) as i64 }, StrView { ptr: (c"ptr_u8"), len: (6) as i64 }) == 1
        e.args.kind = ExprKind.CstringLit
    let default_reg: i32 = emit_expr(s, e.args)
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = select i1 ")
    emit_reg(s, tag_ok)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, payload)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, default_reg)
    emit_str(s, IR_NL)
    return result

# =============================================================================
# BitOps intrinsics on integer-primitive receivers (AGAST #1506)
# =============================================================================
#
# `x.rotl(3)` on a u32, `(state[d] ^ state[a]).rotl(16)` in cryptosec's
# chacha20.  Mirrors ritz0's _try_emit_bitops_intrinsic: the six BitOps
# methods on u8..u64 / i8..i64 lower to LLVM intrinsics at the receiver's
# REAL width.  ritz1 carries every integer in an i64 register, so the value
# is truncated to iN, the intrinsic runs at iN, and the result is extended
# back to i64 (sign-extended for a signed Self, zero-extended otherwise) —
# the same "consumers see i64" contract the Type_method fallback honours.
# A rotate done at i64 instead would be silently wrong (0x80000001 rotl 1
# is 3 at 32 bits, 0x100000002 at 64).

# Lower `recv.<bitop>(args)` when the receiver is an integer primitive.
# recv_value_reg >= 0 means the receiver was already evaluated (call and
# method-chain receivers) and must not be evaluated again.  Returns -1 when
# this is not a BitOps call on an integer, leaving the caller's path intact.
fn try_emit_int_bitops(s: *EmitterState, e: *Expr, recv_value_reg: i32) -> i32
    let mid: i32 = bitops_method_id(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if mid < 0
        return 0 - 1
    let rt: TypeKind = int_method_recv_type(s, e.left)
    let bits: i32 = ty_int_bits(rt)
    if bits == 0
        return 0 - 1
    var nargs: i32 = 0
    var a: *Expr = e.args
    while a != null
        nargs = nargs + 1
        a = a.next
    var want_args: i32 = 0
    if mid <= 1
        want_args = 1
    if nargs != want_args
        # ritz0's words (AGAST #4665): emitter/intrinsics.py.
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if want_args == 1
            eprints("() requires exactly 1 argument\n")
        else
            eprints("() takes no arguments\n")
        let bad: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, bad)
        emit_str(s, IR_ADD_ZERO)
        return bad

    var recv: i32 = recv_value_reg
    if recv < 0
        recv = emit_expr(s, e.left)
    # swap_bytes on a byte is the identity (llvm.bswap has no i8 form).
    if mid == 5 and bits == 8
        return recv

    # Narrow the i64 receiver (and shift amount) to iN.
    var nrecv: i32 = recv
    if bits < 64
        nrecv = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, nrecv)
        emit_str(s, IR_TRUNC)
        emit_reg(s, recv)
        emit_str(s, c" to i")
        emit_int(s, bits as i64)
        emit_str(s, IR_NL)
    var namt: i32 = 0
    if mid <= 1
        let amt: i32 = emit_expr(s, e.args)
        namt = amt
        if bits < 64
            namt = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, namt)
            emit_str(s, IR_TRUNC)
            emit_reg(s, amt)
            emit_str(s, c" to i")
            emit_int(s, bits as i64)
            emit_str(s, IR_NL)

    var wi: i32 = 0
    if bits == 16
        wi = 1
    else if bits == 32
        wi = 2
    else if bits == 64
        wi = 3
    g_bitops_decl_mask = g_bitops_decl_mask | ((1 as i64) << ((mid * 4 + wi) as i64))

    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = call i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_bitops_intrinsic_name(s, mid, bits)
    emit_str(s, c"(i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_reg(s, nrecv)
    if mid <= 1
        # rotl/rotr: funnel shift of x with itself by n.
        emit_str(s, c", i")
        emit_int(s, bits as i64)
        emit_str(s, IR_SP)
        emit_reg(s, nrecv)
        emit_str(s, c", i")
        emit_int(s, bits as i64)
        emit_str(s, IR_SP)
        emit_reg(s, namt)
    else if mid == 2 or mid == 3
        # is_zero_poison = false: a zero input yields the bit width.
        emit_str(s, c", i1 false")
    emit_str(s, IR_CLOSE)

    if bits == 64
        return r
    # Counts are u8 (zero-extend); Self results extend by Self's signedness.
    let widened: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, widened)
    if mid <= 1 or mid == 5
        if ty_is_signed(rt) == 1
            emit_str(s, c" = sext i")
        else
            emit_str(s, c" = zext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_reg(s, r)
    emit_str(s, IR_TO_I64)
    widened

# =============================================================================
# Float intrinsics on f32/f64 receivers (AGAST #1370)
# =============================================================================
#
# `x.ceil()`, `(x + 0.25).floor()`, `p.y.round()`, `n.abs()`.  Mirrors ritz0's
# _try_emit_float_intrinsic exactly:
#
#   abs   -> llvm.fabs.{f32,f64}  (an and-mask, never a libcall)
#   floor -> t = sitofp(fptosi x to i64); t > x ? t - 1 : t
#   ceil  -> t = sitofp(fptosi x to i64); t < x ? t + 1 : t
#   round -> trunc(x < 0 ? x - 0.5 : x + 0.5)      (half away from zero)
#
# floor/ceil/round are inline because llvm.floor & co. lower to libm
# libcalls on baseline x86-64 and ritz links no libc (AGAST #1321).  Valid
# for |x| < 2^63, as in ritz0.  Unlike the integer BitOps path the value
# stays in its `float` / `double` register: that is ritz1's float model.
#
# Primitive-receiver dispatch: emit_expr_method asks this before resolving
# a struct receiver (whose call / chain paths spill the value as i64, which a
# float is not); integer BitOps (try_emit_int_bitops, #1506) runs at the
# unresolved-receiver fallback.

# Lower `recv.<ceil|floor|round|abs>()` when the receiver is f32/f64.
# Returns -1 when it is not, leaving emit_expr_method's paths intact; the
# receiver is not evaluated in that case.
fn try_emit_float_method(s: *EmitterState, e: *Expr) -> i32
    let ft: TypeKind = float_method_result_ty(s, e)
    if ft == TypeKind.Void
        return 0 - 1
    let mid: i32 = float_method_id(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    # Evaluated exactly once, whatever its shape (ident, binary, call, chain).
    let x: i32 = emit_expr(s, e.left)

    if mid == 3
        let r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, r)
        emit_str(s, IR_CALL)
        emit_float_llvm_ty(s, ft)
        if ft == TypeKind.F32
            emit_str(s, c" @llvm.fabs.f32(float ")
            g_float_decl_mask = g_float_decl_mask | 1
        else
            emit_str(s, c" @llvm.fabs.f64(double ")
            g_float_decl_mask = g_float_decl_mask | 2
        emit_reg(s, x)
        emit_str(s, IR_CLOSE)
        return r

    if mid == 1
        let t: i32 = emit_float_trunc(s, ft, x)
        let gt: i32 = emit_float_fcmp(s, c"ogt", ft, t, x)
        let m1: i32 = emit_float_binop_const(s, c"fsub", ft, t, c"1.0")
        return emit_float_select(s, ft, gt, m1, t)
    if mid == 0
        let t: i32 = emit_float_trunc(s, ft, x)
        let lt: i32 = emit_float_fcmp(s, c"olt", ft, t, x)
        let p1: i32 = emit_float_binop_const(s, c"fadd", ft, t, c"1.0")
        return emit_float_select(s, ft, lt, p1, t)

    # round: half away from zero.
    let neg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, neg)
    emit_str(s, c" = fcmp olt ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, x)
    emit_str(s, c", 0.0\n")
    let lo: i32 = emit_float_binop_const(s, c"fsub", ft, x, c"0.5")
    let hi: i32 = emit_float_binop_const(s, c"fadd", ft, x, c"0.5")
    let adj: i32 = emit_float_select(s, ft, neg, lo, hi)
    emit_float_trunc(s, ft, adj)

# `x`, `@a` (a: [N]T) or `@v` / `@&v` (v: Vec<T>) into a `Span<T>` parameter `p`:
# build the Span from the array, or from `{ v.data, v.len }`.  `reg` is the
# argument as emit_expr left it (`@v` is the ptrtoint of v's slot); any other
# argument comes back as `reg`.  Shared by free calls and the static method
# arm, which lacked it (AGAST #3246: `R.new(@data)` passed the Vec's address).
fn span_param_arg(s: *EmitterState, arg: *Expr, p: *Param, reg: i32) -> i32
    var res: i32 = reg
    # Port of ritz0 bedc85b: `@vec` -> Span<T> coercion at call site.
    # When the parameter is `Span<T>` and the argument is `@v` where
    # v is a Vec<T> local, materialize a Span struct from
    # { v.data, v.len } so the callee receives a proper slice view.
    var coerced: i32 = 0
    # Array-value -> Span<T> coerce: when the actual is an
    # identifier bound to a TypeKind.Array local, construct
    # Span { &arr[0], N } using the declared array type.
    # (ritz-task-102)
    if arg != null and arg.kind == ExprKind.Ident
        let arr_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
        if arr_loc != null and lv_var_type(arr_loc) == TypeKind.Array
            res = emit_span_of_array(s, arr_loc, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
            coerced = 1
    if coerced == 0 and arg != null and arg.kind == ExprKind.Unary
        if (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut) and arg.operand.kind == ExprKind.Ident
            let src_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.operand.ident_ptr), len: (arg.operand.ident_len) as i64 })
            if src_loc != null and lv_type_name_len(src_loc) > 4
                if *(lv_type_name(src_loc) + 0) == 'V' and *(lv_type_name(src_loc) + 1) == 'e' and *(lv_type_name(src_loc) + 2) == 'c' and *(lv_type_name(src_loc) + 3) == '$'
                    # `@v` is the i64 ptrtoint of v's slot: back to a ptr.
                    # AGAST #3247: `@&v` is the slot's `ptr` itself.
                    var span_vec_ptr: i32 = reg
                    if arg.op == OpKind.Addr
                        span_vec_ptr = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, span_vec_ptr)
                        emit_str(s, IR_INTTOPTR)
                        emit_reg(s, reg)
                        emit_str(s, c" to ptr\n")
                    res = emit_span_of_vec_ptr(s, StrView { ptr: (lv_type_name(src_loc)), len: (lv_type_name_len(src_loc)) as i64 }, span_vec_ptr, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
                    coerced = 1
        # @array_ident -> Span<T>: construct Span { &arr[0], N }.
        # (test_issue_span_slice_range: `tail_sum(@buf)` where
        # buf is [4]u8.)  The inner-ident branch above already
        # handles the bare `arr` case; this handles `@arr`
        # which is ExprKind.Unary OpKind.Addr wrapping ExprKind.Ident.
        if coerced == 0 and arg.operand.kind == ExprKind.Ident
            let arr_loc2: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.operand.ident_ptr), len: (arg.operand.ident_len) as i64 })
            if arr_loc2 != null and lv_var_type(arr_loc2) == TypeKind.Array
                span_array_elem_fits(s, arg, arr_loc2, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })   # AGAST #2366
                res = emit_span_of_array(s, arr_loc2, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
                coerced = 1
        if coerced == 0
            # AGAST #2305: `@G`, `@h.a`, `@*p`.
            let placed: i32 = emit_span_of_addr_place(s, arg, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
            if placed != 0
                res = placed
                coerced = 1
    res

# What emit_expr_method resolved about a method call's receiver (AGAST #1818:
# the locals its receiver arms and dispatchers shared).
struct MethodRecv
    type_name: *u8
    type_name_len: i32
    receiver_reg: i32
    # 1 when the stack slot holds a pointer value (e.g. parameter *Vec<T>);
    # 0 when it holds the struct body directly (e.g. local Vec<T> binding).
    recv_is_ptr_of_ptr: i32
    elem_recv: *u8   # AGAST #2332
    elem_recv_len: i32
    # Non-negative when the receiver's i64 value has already been computed
    # in a register (ExprKind.Call / ExprKind.Method paths). -1 means "materialise
    # by loading from the stack slot". Used by tagged-enum intrinsics that
    # work against the i64 value directly rather than a ptr.
    recv_value_reg: i32
    # Pointers between what the receiver holds and its struct, for a `self: **S`
    # (AGAST #2403); -1 when the arm below didn't say.
    recv_levels: i32
    # The receiver's place: a register pointing at what it holds, so
    # `recv_levels + 1` pointers from its struct, or -1 (AGAST #3071).  A
    # `self: **S` takes it, or what it holds, at the levels `self` declares.
    recv_base: i32

# `Type.method(args)` with no receiver: 1 (result in *out) when it is one.
fn try_emit_static_method(s: *EmitterState, e: *Expr, out: *i32) -> i32
    if e.left.kind != ExprKind.Ident
        return 0
    let static_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    let static_glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    var static_shadow: i32 = 0
    if static_glob != null
        static_shadow = global_is_receiver(static_glob)
    if static_loc == null and static_shadow == 0
        # Look for an impl block whose type_name matches the LHS ident.
        var sib: *ImplBlock = s.module.impls
        var sm_method: *FnDef = null
        var sm_ib: *ImplBlock = null
        while sib != null and sm_method == null
            if name_eq(StrView { ptr: (sib.type_name), len: (sib.type_name_len) as i64 }, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == 1
                var sm_it: *FnDef = sib.methods
                while sm_it != null and sm_method == null
                    if name_eq(StrView { ptr: (sm_it.name), len: (sm_it.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                        sm_method = sm_it
                        sm_ib = sib
                    sm_it = sm_it.next
            sib = sib.next
        # The callee's symbol: `<Type>_<method>`, or for a generic impl
        # the slot's instance's (AGAST #3309).
        var sm_name: *u8 = null
        var sm_name_len: i32 = 0
        if sm_method != null and sm_ib.type_params != null
            sm_method = generic_static_method(s, e, @sm_name, @sm_name_len)
            if sm_method == null
                *out = 0
                return 1
        if sm_method != null
            note_method_callee(s, e, sm_method)   # AGAST #2237
            if refuse_array_return(s, e, sm_method) == 1
                *out = 0
                return 1
            # A receiver is what `self` takes, and a type isn't one, as in
            # ritz0 (AGAST #2393): a lent `self` either (#3236).
            if param_is_self(sm_method.params) == 1
                static_call_of_self_error(s, e, sm_method)
                *out = 0
                return 1
            # Evaluate args first.
            let sm_arg_regs: *i32 = call_reg_slots(e.args, 0)
            var sm_arg_count: i32 = 0
            var sm_arg: *Expr = e.args
            # No receiver: params line up from the head (AGAST #1498).
            var sm_ap: *Param = sm_method.params
            while sm_arg != null
                sm_arg_regs[sm_arg_count] = emit_call_arg(s, sm_arg, sm_ap)
                sm_arg_count = sm_arg_count + 1
                if sm_ap != null
                    sm_ap = sm_ap.next
                sm_arg = sm_arg.next
            # Coerce args to formal param widths.  The static dispatch
            # has NO self/receiver, so we walk method.params from the
            # head (no skip).  Float-narrow lit→f32 via fptrunc when
            # the param type is f32 — same pattern as f32-aware var-decl
            # narrowing (commit 960a388).  Integer and bool args are
            # trunc'd to the param width like the instance arm's
            # (AGAST #1733).  Other types pass-through.
            let sm_conv: *i32 = call_reg_slots(e.args, 0)
            var sm_p: *Param = sm_method.params
            var sm_arg_e: *Expr = e.args
            for k in 0..sm_arg_count
                sm_conv[k] = sm_arg_regs[k]
                if sm_p != null
                    let sm_nrw: *u8 = method_arg_narrow_suffix(s, sm_p, sm_arg_e)
                    let sm_sv: i32 = method_strview_arg(s, sm_p, sm_arg_e, sm_arg_regs[k])   # AGAST #3495
                    if sm_sv >= 0
                        sm_conv[k] = sm_sv
                    else if sm_nrw != null
                        sm_conv[k] = emit_method_arg_trunc(s, sm_arg_regs[k], sm_nrw)
                    else if is_span_param(sm_p) == 1
                        sm_conv[k] = span_param_arg(s, sm_arg_e, sm_p, sm_arg_regs[k])   # AGAST #3246
                    else if param_takes_addr_value(s, sm_arg_e, sm_p) == 1
                        sm_conv[k] = i64_value_to_ptr(s, sm_arg_e, sm_arg_regs[k])   # AGAST #2287
                    else if sm_p.param_type == TypeKind.F32 or sm_p.param_type == TypeKind.F64
                        # A float literal is a double, an int one an i64
                        # (AGAST #2561: `P.st(2)` passed `float %<i64>`).
                        sm_conv[k] = method_float_arg(s, sm_p, sm_arg_e, sm_arg_regs[k])
                    sm_p = sm_p.next
                if sm_arg_e != null
                    sm_arg_e = sm_arg_e.next
            # Emit the call: %r = call <ret_type> @<Type>_<method>(args)
            # AGAST #1730 — large struct results come back via an sret slot.
            var sm_sret: i32 = 0
            if struct_ret_uses_sret(s, sm_method.return_type, StrView { ptr: (sm_method.return_type_name), len: (sm_method.return_type_name_len) as i64 }) == 1
                sm_sret = emit_sret_call_slot(s, StrView { ptr: (sm_method.return_type_name), len: (sm_method.return_type_name_len) as i64 })
            sm_sret = emit_call_sret_array_slot(s, sm_method, sm_sret)   # AGAST #3181
            # A void method binds no result register (AGAST #1733, as
            # #1581 did for the instance arm): `%r = call void` is invalid.
            var sm_result: i32 = 0
            if sm_sret > 0
                sm_result = next_reg(s)
                emit_str(s, c"  call void")
            else if sm_method.return_type == TypeKind.Void
                emit_str(s, c"  call void")
            else
                sm_result = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, sm_result)
                emit_str(s, IR_CALL)
                emit_fn_ret_llvm_type(s, sm_method)   # AGAST #2302: `-> [N]T` is `[N x T]`
            emit_str(s, c" @")
            if sm_name != null
                emit_name(s, StrView { ptr: (sm_name), len: (sm_name_len) as i64 })
            else
                emit_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                emit_str(s, c"_")
                emit_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            emit_str(s, c"(")
            if sm_sret > 0
                emit_call_sret_attr(s, sm_method, StrView { ptr: (sm_method.return_type_name), len: (sm_method.return_type_name_len) as i64 })
                emit_reg(s, sm_sret)
            var sm_p2: *Param = sm_method.params
            for k in 0..sm_arg_count
                if k > 0 or sm_sret > 0
                    emit_str(s, IR_COMMA)
                if sm_p2 != null
                    emit_param_llvm_type(s, sm_p2)   # AGAST #1739
                    sm_p2 = sm_p2.next
                else
                    emit_str(s, c"i64")
                emit_str(s, IR_SP)
                emit_reg(s, sm_conv[k])
            emit_str(s, IR_CLOSE)
            # Register the extern like the instance arm does (#1518): a
            # method from an imported impl has its body in the owning
            # module's .ll and needs a `declare` here (AGAST #2568).
            # emit_extern_declarations skips one this .ll defines
            # (is_local_function), so no local check is needed here.
            # A generic impl's instance is specialised into this module.
            if sm_name == null
                add_method_extern(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if sm_sret > 0
                *out = emit_call_sret_result(s, sm_method, sm_result, sm_sret, StrView { ptr: (sm_method.return_type_name), len: (sm_method.return_type_name_len) as i64 })
                return 1
            # AGAST #1962: a narrow result (`call i32 @C_get`) must be
            # widened to the i64 value model like the instance arm's,
            # or `return C.get(...)` from an i32 fn truncs an i32 reg.
            *out = widen_method_result(s, sm_result, sm_method.return_type)
            return 1
    0

# A local, global or struct-const receiver.
fn method_recv_ident(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Look up the receiver type from locals
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
    if loc != null
        r.type_name = lv_type_name(loc)
        r.type_name_len = lv_type_name_len(loc)
        # Get address of receiver for auto-borrowing
        r.receiver_reg = loc.reg
        # Pointer-typed locals (*T, @T, @@T) spill an i64 into the slot;
        # the slot therefore points at a pointer, not at the struct.
        # AGAST #2372: `**S` and `@*S` are further from it; load down to the
        # slot that holds the `*S`.
        r.recv_levels = local_struct_levels(loc)
        r.recv_base = loc.reg
        if r.recv_levels > 0
            r.receiver_reg = emit_load_levels(s, loc.reg, r.recv_levels - 1)
            r.recv_is_ptr_of_ptr = 1
    else
        # AGAST #2044: a global receiver (`g_p.get()`).  A struct
        # global's address `@g` is the receiver itself (auto-borrowed,
        # so a mutating method writes the global); a `*S` global holds
        # a pointer in `@g`, so it is dispatched ptr-of-ptr, like a
        # pointer-typed local (cf. emit_member_ptr's #1892 arm).  An
        # `@S` / `@&S` global holds the same `ptr` at runtime (#3093).
        let rglob: *GlobalVarDef = find_global(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
        if rglob != null
            var rg_ptr_of_ptr: i32 = -1
            if rglob.var_type == TypeKind.Struct and rglob.type_name_len > 0
                r.type_name = rglob.type_name
                r.type_name_len = rglob.type_name_len
                rg_ptr_of_ptr = 0
            else if (rglob.var_type == TypeKind.Ptr or rglob.var_type == TypeKind.Ref or rglob.var_type == TypeKind.MutRef) and rglob.pointee_type == TypeKind.Struct and rglob.pointee_type_name_len > 0
                r.type_name = rglob.pointee_type_name
                r.type_name_len = rglob.pointee_type_name_len
                rg_ptr_of_ptr = 1
            if rg_ptr_of_ptr >= 0
                # Name `@g` as a register so every dispatcher below can
                # take it like a local's slot.
                let rg_reg: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, rg_reg)
                emit_str(s, c" = getelementptr i8, ptr @")
                emit_name(s, StrView { ptr: (rglob.name), len: (rglob.name_len) as i64 })
                emit_str(s, c", i64 0  ; global receiver\n")
                r.receiver_reg = rg_reg
                r.recv_is_ptr_of_ptr = rg_ptr_of_ptr
                r.recv_levels = rg_ptr_of_ptr
                r.recv_base = rg_reg
        else
            # AGAST #4589: a struct const receiver (`V1_WIKI.as_ptr()` with
            # `const V1_WIKI: StrView = "..."`).  The const is an `internal
            # constant` `%S` global (#189), so its value is loaded (the
            # ident's own path) and spilled to a slot at `%S`: the method
            # runs on that copy, and a `*self` method cannot write the const.
            let rconst: *ConstEntry = find_const_entry(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
            if rconst != null and rconst.const_type == TypeKind.Struct and rconst.type_name_len > 0 and rconst.value_expr != null
                r.type_name = rconst.type_name
                r.type_name_len = rconst.type_name_len
                r.recv_value_reg = emit_expr(s, recv)
                let rc_slot: i32 = next_reg(s)
                entry_alloca_reg_begin_named(s, rc_slot)
                emit_name(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 })
                emit_str(s, c"  ; struct-const receiver copy\n")
                entry_alloca_reg_end(s)
                emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.recv_value_reg, rc_slot)
                r.receiver_reg = rc_slot
                r.recv_is_ptr_of_ptr = 0
                r.recv_levels = 0

# `arr[i].m()`, `PS[i].m()`, `q[i].m()` with an ident base.
fn method_recv_local_index(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # AGAST #1981: `arr[i].m()` on a local `[N]St` -- the element's
    # address is the receiver, dispatched in place (a mutating method
    # such as Vec.push writes the array slot, not a copy).  Mirrors
    # emit_member_ptr's `arr[i].field` arm.  Without it the receiver
    # type went unresolved ("cannot determine receiver type").
    let arr_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (recv.left.ident_ptr), len: (recv.left.ident_len) as i64 })
    if arr_loc != null and lv_var_type(arr_loc) == TypeKind.Array and lv_array_elem_type(arr_loc) == TypeKind.Struct and lv_type_name_len(arr_loc) > 0
        let arr_idx: i32 = emit_expr(s, recv.right)
        let arr_elem: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, arr_elem)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, lv_array_size(arr_loc) as i64)
        emit_str(s, c" x %")
        emit_name(s, StrView { ptr: (lv_type_name(arr_loc)), len: (lv_type_name_len(arr_loc)) as i64 })
        emit_str(s, IR_RBRACK_PTR)
        emit_reg(s, arr_loc.reg)
        emit_str(s, IR_I64_ZERO)
        emit_reg(s, arr_idx)
        emit_str(s, IR_NL)
        r.type_name = lv_type_name(arr_loc)
        r.type_name_len = lv_type_name_len(arr_loc)
        r.receiver_reg = arr_elem
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else if const_struct_array_elem(s, recv) != null
        # AGAST #3360: `PS[i].m()` on a module `const PS: [N]S`: the
        # element's address in the const's data is the receiver, as a
        # local array's is.  let_check has refused a mutable lend of it.
        let ca: *ConstEntry = const_struct_array_elem(s, recv)
        r.type_name = ca.array_elem_type_name
        r.type_name_len = ca.array_elem_type_name_len
        r.receiver_reg = emit_struct_array_elem_ptr(s, StrView { ptr: (ca.name), len: (ca.name_len) as i64 }, ca.array_size, ca.array_elem_type_name, ca.array_elem_type_name_len, recv.right)
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else
        # AGAST #3143: `q[i].m()` with `q` a `*S` local, param or global:
        # element i of what `q` points at is a place, as for `q[i].f`
        # (#1908) and `mkp()[i].m()` (#2299), so a mutating method writes
        # it in place.  `q` and the index are emitted once each.
        var pq_st: *StructDef = null
        if arr_loc != null
            if lv_var_type(arr_loc) == TypeKind.Ptr and lv_type_name_len(arr_loc) > 0
                pq_st = find_struct(s, StrView { ptr: (lv_type_name(arr_loc)), len: (lv_type_name_len(arr_loc)) as i64 })
        else
            let pq_g: *GlobalVarDef = find_global(s, StrView { ptr: (recv.left.ident_ptr), len: (recv.left.ident_len) as i64 })
            if pq_g != null and pq_g.var_type == TypeKind.Ptr and pq_g.pointee_type == TypeKind.Struct and pq_g.pointee_type_name_len > 0
                pq_st = find_struct(s, StrView { ptr: (pq_g.pointee_type_name), len: (pq_g.pointee_type_name_len) as i64 })
        if pq_st != null
            r.type_name = pq_st.name
            r.type_name_len = pq_st.name_len
            r.receiver_reg = emit_ptr_elem_addr(s, recv, pq_st)
            r.recv_is_ptr_of_ptr = 0
            r.recv_levels = 0

# A call-result receiver, `f().m()`.
fn method_recv_call(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Receiver is a direct call. Resolve its callee's return type name
    # so we know which struct we're calling a method on, then emit the
    # call itself and materialise the result into a stack slot so the
    # ptr-dispatch fallback paths still have something to pass.
    # (ritz-task-106)
    let fn_def: *FnDef = find_call_fn(s, recv)
    if fn_def != null
        if fn_def.return_type == TypeKind.Struct
            if fn_def.return_type_name_len > 0
                r.type_name = fn_def.return_type_name
                r.type_name_len = fn_def.return_type_name_len
    # AGAST #2946: a `*S` return (`sp(@s).me()`) names S too, and the
    # returned pointer itself is the receiver -- not a spill of it (as the
    # ExprKind.Method arm, #2883).
    var call_ptr_st: *StructDef = null
    if r.type_name_len == 0
        call_ptr_st = call_result_ptr_struct(s, recv)
    # AGAST #2399: a `**S` or `@*S` return, loaded down to S's address.
    var call_lv_st: *StructDef = null
    var call_levels: i32 = 0
    if r.type_name_len == 0 and call_ptr_st == null
        call_levels = call_result_struct_levels(s, recv, @call_lv_st)
    r.recv_value_reg = emit_expr(s, recv)
    var call_slot: i32 = 0
    if call_levels >= 2
        r.type_name = call_lv_st.name
        r.type_name_len = call_lv_st.name_len
        call_slot = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, call_slot)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, r.recv_value_reg)
        emit_str(s, c" to ptr  ; call-result levels receiver\n")
        call_slot = emit_load_levels(s, call_slot, call_levels - 1)
    else if call_ptr_st != null
        r.type_name = call_ptr_st.name
        r.type_name_len = call_ptr_st.name_len
        call_slot = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, call_slot)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, r.recv_value_reg)
        emit_str(s, c" to ptr  ; *S call-result receiver\n")
    else if r.type_name_len > 0 and own_temp_slot_of(s, r.recv_value_reg) > 0
        # AGAST #2262: a temporary's slot is the receiver, so the method
        # and the temporary's drop see one value.
        call_slot = own_temp_slot_of(s, r.recv_value_reg)
    else if r.type_name_len > 0 and s.sret_last_slot > 0 and s.sret_last_val == r.recv_value_reg
        # AGAST #2073: an sret call already left its result in memory
        # (emit_sret_call_result loaded `recv_value_reg` from that
        # slot), so the slot itself is the receiver -- no copy.
        call_slot = s.sret_last_slot
    else if r.type_name_len > 0 and is_primitive_type_name(StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }) == 0
        # A struct-valued result (tagged enum, ritz-task-133; any user
        # struct, AGAST #2073) is a real `%S` value: alloca / store at
        # the struct type, or clang rejects `store i64 %<%S>`.
        call_slot = next_reg(s)
        entry_alloca_reg_begin_named(s, call_slot)
        emit_name(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 })
        emit_str(s, c"  ; method-on-call-result (struct value)\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.recv_value_reg, call_slot)
    else
        call_slot = next_reg(s)
        entry_alloca_reg(s, call_slot, c"i64", c"method-call-on-call-result receiver")
        emit_store_typed(s, IR_TY_I64, r.recv_value_reg, call_slot)
    r.receiver_reg = call_slot
    r.recv_is_ptr_of_ptr = 0
    r.recv_levels = (call_ptr_st != null) as i32

# A method-result receiver, `a.f().m()`.
fn method_recv_chain(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Recursive chain: `a.foo().bar()`. Emit the inner method call to
    # get the value and spill it to a stack slot. We cannot name the
    # outer receiver's struct type without an impl-table lookup, so
    # type_name stays null and the stub fires unless an intrinsic that
    # ignores type_name matches.  Enum-unwrap is gated on a non-null
    # type_name so recursive chaining through `.unwrap()` isn't
    # supported yet. (ritz-task-106)
    # AGAST #2594: when the inner method returns a struct
    # (`c.me().tp(3)`), call_result_struct_name names it; the result is a
    # `%S` value, spilled at that type and dispatched like a call's.
    call_result_struct_name(s, recv, @r.type_name, @r.type_name_len)
    # AGAST #2883: a `*S` return (`s.me().me()`) names S too, and the
    # returned pointer itself is the receiver -- not a spill of it.
    var chain_ptr_st: *StructDef = null
    if r.type_name_len == 0
        chain_ptr_st = call_result_ptr_struct(s, recv)
    r.recv_value_reg = emit_expr(s, recv)
    var chain_slot: i32 = 0
    if chain_ptr_st != null
        r.type_name = chain_ptr_st.name
        r.type_name_len = chain_ptr_st.name_len
        chain_slot = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, chain_slot)
        emit_str(s, IR_INTTOPTR)
        emit_reg(s, r.recv_value_reg)
        emit_str(s, c" to ptr  ; *S method-result receiver\n")
    else if r.type_name_len > 0 and own_temp_slot_of(s, r.recv_value_reg) > 0
        chain_slot = own_temp_slot_of(s, r.recv_value_reg)   # as the ExprKind.Call arm (#2262)
    else if r.type_name_len > 0 and s.sret_last_slot > 0 and s.sret_last_val == r.recv_value_reg
        chain_slot = s.sret_last_slot   # as the ExprKind.Call arm (#2073)
    else if r.type_name_len > 0 and is_primitive_type_name(StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }) == 0
        chain_slot = next_reg(s)
        entry_alloca_reg_begin_named(s, chain_slot)
        emit_name(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 })
        emit_str(s, c"  ; method-on-method-result (struct value)\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.recv_value_reg, chain_slot)
    else
        r.type_name = null
        r.type_name_len = 0
        chain_slot = next_reg(s)
        entry_alloca_reg(s, chain_slot, c"i64", c"method-call-on-method-result receiver")
        emit_store_typed(s, IR_TY_I64, r.recv_value_reg, chain_slot)
    r.receiver_reg = chain_slot
    r.recv_is_ptr_of_ptr = 0
    r.recv_levels = (chain_ptr_st != null) as i32

# A field receiver, `r.raw.push(9)`.
fn method_recv_member(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # Field receiver: `r.raw.push(9)`, `q.a.get()`, `o.q.a.get()`.
    # emit_member_ptr yields the field's address, which IS the
    # receiver pointer for in-place (auto-borrowed) dispatch — a
    # mutating method writes through to the field, not a copy.  A
    # pointer-typed field (`p: *T`) holds a pointer in that slot, so
    # it is dispatched ptr-of-ptr, like a pointer-typed local.
    # (AGAST #1512)
    var mres: MemberPtrResult
    emit_member_ptr(s, recv, @mres)
    if mres.success == 1 and mres.field != null
        let rf: *StructField = mres.field
        if rf.field_type_name_len > 0
            match rf.field_type
                TypeKind.Struct =>
                    r.type_name = rf.field_type_name
                    r.type_name_len = rf.field_type_name_len
                    r.receiver_reg = mres.reg
                    r.recv_is_ptr_of_ptr = 0
                    r.recv_levels = 0
                TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                    r.type_name = rf.field_type_name
                    r.type_name_len = rf.field_type_name_len
                    r.recv_levels = field_struct_levels(rf)
                    r.recv_base = mres.reg
                    r.receiver_reg = emit_load_levels(s, mres.reg, r.recv_levels - 1)   # AGAST #2372
                    r.recv_is_ptr_of_ptr = 1
                _ => pass
        if r.type_name_len == 0
            # A primitive field: `e.key.equals(k)` on a specialised
            # HashMapEntry<K, V> with K = i64 (AGAST #1858).  The field's
            # address mres.reg is the `self: @i64` receiver, as a
            # primitive local's slot is.  A specialised field keeps its
            # substituted name ("i64", subst_value_field), so this is
            # after the named arms, not their `else`.  Dispatch only when
            # an impl method exists, so the BitOps path below keeps a
            # field with none (AGAST #4294).
            let pf_name: *u8 = primitive_name_from_type(rf.field_type)
            if pf_name != null
                let pf_len: i32 = primitive_name_len(rf.field_type)
                if find_impl_method(s, StrView { ptr: (pf_name), len: (pf_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
                    r.type_name = pf_name
                    r.type_name_len = pf_len
                    r.receiver_reg = mres.reg
                    r.recv_is_ptr_of_ptr = 0
                    r.recv_levels = 0

# A cast or deref receiver, `(p as @&S).m()`, `(*pp).m()`.
fn method_recv_deref(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    if recv.kind == ExprKind.Cast and (recv.type_kind == TypeKind.Ptr or recv.type_kind == TypeKind.Ref or recv.type_kind == TypeKind.MutRef) and recv.cast_ptr_kind == (TypeKind.Struct as i32)
        # AGAST #4161: `(p as @&S).m()`, `(p as @S).m()`, `(p as *S).m()`.
        # apply_cast_tail names the cast's struct (#1453, #3443), and
        # emit_deref_operand_ptr turns the cast's value into S's address, as
        # it does for `(p as @&S).f`.  So the method runs on the pointee, as
        # with `(*p).m()`.
        var cr_st: *StructDef = null
        var cr_levels: i32 = 0
        let cr_reg: i32 = emit_deref_operand_ptr(s, recv, @cr_st, @cr_levels)
        if cr_reg != 0 and cr_levels == 1
            r.type_name = cr_st.name
            r.type_name_len = cr_st.name_len
            r.receiver_reg = cr_reg
            r.recv_is_ptr_of_ptr = 0
            r.recv_levels = 0
    else if recv.kind == ExprKind.Unary and recv.op == OpKind.Deref
        # AGAST #2145: `(*pp).m()` with pp a `**S` (param, local, field):
        # `*pp` is a `*S` value, so dispatch like a `*S` local -- the
        # loaded pp points at the slot holding the `*S` (ptr-of-ptr).
        # emit_deref_operand_ptr resolves pp the way emit_member_ptr's
        # `(*pp).w` arm (#1940) does.
        var dr_st: *StructDef = null
        var dr_levels: i32 = 0
        let dr_reg: i32 = emit_deref_operand_ptr(s, recv.operand, @dr_st, @dr_levels)
        if dr_reg != 0 and dr_levels == 1
            # AGAST #3109: a deref that leaves the struct itself, `(*(q + k)).m()`,
            # `(*q).m()`, `(**pp).m()`.  LARB R9 (#2175): `*p` is a place, so the
            # method runs on the pointee -- the loaded operand IS its address,
            # as a struct local's slot is.  The operand is emitted once, above.
            r.type_name = dr_st.name
            r.type_name_len = dr_st.name_len
            r.receiver_reg = dr_reg
            r.recv_is_ptr_of_ptr = 0
            r.recv_levels = 0
        # AGAST #2404: through a `***S` or deeper `*p` is a `**S`, and the
        # loaded p is that many loads from the slot holding the `*S`.
        else if dr_reg != 0 and dr_levels >= 2
            r.type_name = dr_st.name
            r.type_name_len = dr_st.name_len
            r.receiver_reg = emit_load_levels(s, dr_reg, dr_levels - 2)
            r.recv_is_ptr_of_ptr = 1
            r.recv_levels = dr_levels - 1
            r.recv_base = dr_reg

# A `**S` or deeper receiver no arm above names (AGAST #2404).
fn method_recv_ptr_ptr(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    # AGAST #2404: a `**S` or deeper that no arm above names (a global, an
    # element of a `[N]**S` or of a `***S`).  Evaluated once, then loaded down
    # to the slot holding the `*S`, as a `**S` local is.  A global or a local
    # array's element is a place, so a `self: **S` (#3071) takes it there.
    if r.type_name_len == 0 and r.receiver_reg == 0 and r.recv_value_reg < 0
        var pp_name: *u8 = null
        var pp_len: i32 = 0
        let pp_levels: i32 = recv_ptr_ptr_levels(s, recv, @pp_name, @pp_len)
        if pp_levels >= 2
            r.type_name = pp_name
            r.type_name_len = pp_len
            r.recv_is_ptr_of_ptr = 1
            r.recv_levels = pp_levels
            if recv.kind == ExprKind.Ident or recv_elem_is_local_array(s, recv) == 1
                r.recv_base = emit_lvalue_ptr(s, recv)
                r.receiver_reg = emit_load_levels(s, r.recv_base, pp_levels - 1)
            else
                let pp_val: i32 = emit_expr(s, recv)
                let pp_ptr: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, pp_ptr)
                emit_str(s, IR_INTTOPTR)
                emit_reg(s, pp_val)
                emit_str(s, c" to ptr  ; **S receiver\n")
                r.receiver_reg = emit_load_levels(s, pp_ptr, pp_levels - 2)

# Resolve the receiver's type and place into `r`, by the receiver's shape.
fn method_recv_resolve(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv)
    if recv.kind == ExprKind.Ident
        method_recv_ident(s, e, recv, r)
    else if recv.kind == ExprKind.Index and index_through_struct(s, recv, @r.elem_recv, @r.elem_recv_len) == 1 and r.elem_recv != null
        # AGAST #2443: `p[i].m()` through a `*`, `@` or `@&` Vec, Span or String
        # (R9), and `v[i].m()` on one: the element's address is the receiver, so
        # a mutating method writes the element in place.
        r.receiver_reg = emit_through_elem_ptr(s, recv, @r.elem_recv, @r.elem_recv_len)
        r.type_name = r.elem_recv
        r.type_name_len = r.elem_recv_len
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else if recv.kind == ExprKind.Index and nd_struct_leaf(s, recv) != null
        # AGAST #3306: `g[i][j].m()` over an N-D `[..]S` (local, global,
        # field, plane pointer): the element's address is the receiver, as
        # for `arr[i].m()` (#1981), so a mutating method writes it in place.
        let nd_st: *StructDef = nd_struct_leaf(s, recv)
        var nd_recv: NdIndexPtr
        emit_nd_index_ptr(s, recv, @nd_recv)
        r.receiver_reg = nd_recv.reg
        r.type_name = nd_st.name
        r.type_name_len = nd_st.name_len
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else if recv.kind == ExprKind.Index and array_elem_pointee(s, recv, @r.elem_recv, @r.elem_recv_len) == TypeKind.Struct
        # AGAST #2332: `a[i].m()` with `a: [N]*S`: the element IS the receiver.
        var elem_ptr: i32 = 0
        if recv_elem_is_local_array(s, recv) == 1
            # AGAST #3071: a local array's element is a place, so a `self: **S`
            # can take it.  Its index runs once: the element loads from it.
            r.recv_base = emit_lvalue_ptr(s, recv)
            elem_ptr = emit_load_ptr(s, r.recv_base)
        else
            let elem_val: i32 = emit_expr(s, recv)
            elem_ptr = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, elem_ptr)
            emit_str(s, IR_INTTOPTR)
            emit_reg(s, elem_val)
            emit_str(s, c" to ptr\n")
        r.type_name = r.elem_recv
        r.type_name_len = r.elem_recv_len
        r.receiver_reg = elem_ptr
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 1
    else if recv.kind == ExprKind.Index and recv.left != null and recv.left.kind == ExprKind.Ident and (recv.right == null or recv.right.kind != ExprKind.Range)
        method_recv_local_index(s, e, recv, r)
    else if recv.kind == ExprKind.Index and recv.left != null and (recv.left.kind == ExprKind.Call or recv.left.kind == ExprKind.Method) and recv.right != null and recv.right.kind != ExprKind.Range and call_ptr_elem_struct(s, recv.left) != null
        # AGAST #2299: `mkp()[i].m()` with `mkp() -> *S`: element i of what the
        # call points at is a place, as emit_member_ptr's `mkp()[i].f` arm
        # (#2870) has it, so a mutating method writes it in place.  The call
        # and the index are emitted once each.
        let pe_st: *StructDef = call_ptr_elem_struct(s, recv.left)
        r.type_name = pe_st.name
        r.type_name_len = pe_st.name_len
        r.receiver_reg = emit_ptr_elem_addr(s, recv, pe_st)
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else if recv.kind == ExprKind.Index and recv.left != null and recv.left.kind == ExprKind.Index and recv.right != null and recv.right.kind != ExprKind.Range and index_elem_ptr_struct(s, recv.left) != null
        # AGAST #3199: `a[i][j].m()` with `a: [N]*S` is `*(a[i] + j)` (#2377):
        # element j of what `a[i]` points at is a place, as for `q[i].m()`
        # (#3143), so a mutating method writes it in place.  `a[i]` and `j`
        # are emitted once each.
        let ae_st: *StructDef = index_elem_ptr_struct(s, recv.left)
        r.type_name = ae_st.name
        r.type_name_len = ae_st.name_len
        r.receiver_reg = emit_ptr_elem_addr(s, recv, ae_st)
        r.recv_is_ptr_of_ptr = 0
        r.recv_levels = 0
    else if recv.kind == ExprKind.Index and recv.left != null and recv.left.kind == ExprKind.Member and recv.right != null and recv.right.kind != ExprKind.Range and field_struct_array_elem(s, recv.left) != null
        # AGAST #3234: `v.a[i].m()` with `a: [N]S` inline in v (and so
        # `mv().a[i].m()`, which emit_call_array_index spills to a local):
        # the element's address is the receiver, as for `arr[i].m()` (#1981).
        # The field's place and the index are emitted once each.
        let fa_st: *StructDef = field_struct_array_elem(s, recv.left)
        var fa_res: MemberPtrResult
        emit_member_ptr(s, recv.left, @fa_res)
        if fa_res.success == 1
            let fa_idx: i32 = emit_expr(s, recv.right)
            let fa_elem: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, fa_elem)
            emit_str(s, IR_GEP_ARRAY)
            emit_int(s, fa_res.field.array_size as i64)
            emit_str(s, c" x %")
            emit_name(s, StrView { ptr: (fa_st.name), len: (fa_st.name_len) as i64 })
            emit_str(s, IR_RBRACK_PTR)
            emit_reg(s, fa_res.reg)
            emit_str(s, IR_I64_ZERO)
            emit_reg(s, fa_idx)
            emit_str(s, IR_NL)
            r.type_name = fa_st.name
            r.type_name_len = fa_st.name_len
            r.receiver_reg = fa_elem
            r.recv_is_ptr_of_ptr = 0
            r.recv_levels = 0
    else
        match recv.kind
            ExprKind.Call =>
                method_recv_call(s, e, recv, r)
            ExprKind.Method =>
                method_recv_chain(s, e, recv, r)
            ExprKind.StructLit =>
                # Rvalue-struct receiver: `Point { x: 2.0 }.scale(...)`.  Spill
                # the struct literal into a stack slot and use that slot as the
                # receiver pointer, mirroring the pattern used for chained calls.
                # The struct lit's name (recv.ident_ptr/_len) IS the type name,
                # so we know which impl table to consult without value emission.
                r.type_name = recv.ident_ptr as *u8
                r.type_name_len = recv.ident_len
                let lit_slot: i32 = next_reg(s)
                entry_alloca_reg_begin_named(s, lit_slot)
                emit_name(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 })
                emit_str(s, c"  ; rvalue struct-lit receiver\n")
                entry_alloca_reg_end(s)
                emit_struct_lit_to_alloca(s, recv, lit_slot)
                r.receiver_reg = lit_slot
                r.recv_is_ptr_of_ptr = 0
                r.recv_levels = 0
            ExprKind.StringLit =>
                # AGAST #3156: `"lit".len()`.  A bare literal is a StrView (#98): its
                # %Span$u8 value is rebuilt as a %StrView and spilled, and the slot is
                # the receiver, as a StrView local's is -- so `impl StrView` methods
                # and the `strview_*` UFCS fallback resolve the same way.
                let sl_val: i32 = emit_expr(s, recv)
                let sl_sv: i32 = emit_strview_from_lit(s, recv, sl_val)
                r.type_name = c"StrView"
                r.type_name_len = 7
                let sl_slot: i32 = next_reg(s)
                entry_alloca_reg(s, sl_slot, c"%StrView", c"string-literal receiver")
                emit_str(s, c"  store %StrView ")
                emit_reg(s, sl_sv)
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, sl_slot)
                emit_str(s, IR_NL)
                r.receiver_reg = sl_slot
                r.recv_is_ptr_of_ptr = 0
                r.recv_levels = 0
            ExprKind.Member =>
                method_recv_member(s, e, recv, r)
            _ =>
                method_recv_deref(s, e, recv, r)
    method_recv_ptr_ptr(s, e, recv, r)

# The built-in dispatchers, before the impl lookup: 1 (result in *out) when one fired.
fn try_emit_method_builtin(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv, out: *i32) -> i32
    # Tagged-enum intrinsic: Option/Result .unwrap / .unwrap_or. Needs a
    # resolved receiver struct name to know it's a tagged enum; runs
    # before the cannot-determine-receiver-type stub so ExprKind.Call
    # receivers with Option$/Result$ returns resolve cleanly without
    # needing ritzlib unwrap helpers that don't exist. (ritz-task-106)
    if r.type_name != null
        if r.type_name_len > 0
            let enum_unwrap: i32 = try_emit_enum_unwrap(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.receiver_reg, r.recv_is_ptr_of_ptr, r.recv_value_reg)
            if enum_unwrap >= 0
                *out = enum_unwrap
                return 1
            # `.is_some()` / `.is_ok()` and their negations on a receiver no
            # local names (AGAST #3061): inline, as on a local.
            let enum_pred: i32 = try_emit_enum_pred_at(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.receiver_reg, r.recv_is_ptr_of_ptr)
            if enum_pred >= 0
                *out = enum_pred
                return 1

    # R36's revisit (#4294): a primitive or `*u8` receiver dispatches to the
    # trait impl on that built-in type (only legal in the trait's file).  Only
    # when such a method exists: otherwise the BitOps intrinsics below keep
    # their no-impl-name path (`x.count_ones()`).
    if r.type_name == null or r.type_name_len == 0
        var br_len: i32 = 0
        let br: *u8 = builtin_receiver_name(s, recv, @br_len)
        if br != null and find_impl_method(s, StrView { ptr: (br), len: (br_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
            r.type_name = br
            r.type_name_len = br_len

    if r.type_name == null or r.type_name_len == 0
        # Integer-primitive receiver: BitOps intrinsics (AGAST #1506).
        # Only reached when no struct type resolved, so it cannot shadow
        # a user impl method of the same name.
        let bitop: i32 = try_emit_int_bitops(s, e, r.recv_value_reg)
        if bitop >= 0
            *out = bitop
            return 1
        # ritz0's words (AGAST #4665): emitter/calls.py, a receiver whose type
        # nothing names (`(1, 2).foo()`).
        emit_nd_error_begin(s, e.span.line, e.span.col)
        eprints("Cannot call method '")
        eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        eprints("' on unknown type\n")
        let zero: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, zero)
        emit_str(s, IR_ADD_ZERO)
        *out = zero
        return 1

    # Built-in method dispatchers (run BEFORE the default Type_method mangling).
    # Mirrors ritz0's Wave-1 dispatch chain — catches obvious intrinsic patterns
    # that ritz1 doesn't have impl-table entries for.

    # StrView.as_bytes() -> inline Span<u8>
    let sv_bytes: i32 = try_emit_strview_as_bytes(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.receiver_reg, r.recv_is_ptr_of_ptr)
    if sv_bytes >= 0
        *out = sv_bytes
        return 1

    # Vec/Span/StrView .len() -> direct field load
    let len_val: i32 = try_emit_len_builtin(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.receiver_reg, r.recv_is_ptr_of_ptr)
    if len_val >= 0
        *out = len_val
        return 1

    # AGAST #3267: `let h = "..."` is the layout-equal %Span$u8 here but a
    # StrView in ritz0, so `h.get(i)` on a module with no Span<u8> `get`
    # (cryptosec imports only ritzlib.strview) is `impl StrView`'s, as ritz0
    # calls it.  Before the Span builtins, so `h.slice(..)` is StrView's too.
    # The UFCS fallback did this with `strview_*` until LARB R66 (#3497).
    if name_eq(StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 }) == 1
        if span_u8_method_is_strview(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
            r.type_name = c"StrView"
            r.type_name_len = 7

    # Span .ptr() / .is_empty() / .slice(lo, hi) with no method defining them
    let span_val: i32 = try_emit_span_builtin(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, r.receiver_reg, r.recv_is_ptr_of_ptr)
    if span_val >= 0
        *out = span_val
        return 1
    0

# Coerce the evaluated args to the method's params (self skipped) into conv_regs.
fn method_coerce_args(s: *EmitterState, e: *Expr, mfn: *FnDef, arg_regs: *i32, conv_regs: *i32, arg_count: i32)
    var mp: *Param = null
    if mfn != null
        mp = mfn.params
        if mp != null
            mp = mp.next
    for j in 0..arg_count
        if mp != null
            # Integer args are i64 registers; narrow them to the param width
            # like the free-fn and UFCS paths do, or the call passes an i64
            # register under an iN type (AGAST #1607, #1580).
            var mbe: *Expr = e.args
            var mbk: i32 = 0
            while mbk < j and mbe != null
                mbe = mbe.next
                mbk = mbk + 1
            let narrow_to: *u8 = method_arg_narrow_suffix(s, mp, mbe)
            let sv_arg: i32 = method_strview_arg(s, mp, mbe, arg_regs[j])   # AGAST #3495
            if sv_arg >= 0
                conv_regs[j] = sv_arg
            else if narrow_to != null
                conv_regs[j] = emit_method_arg_trunc(s, arg_regs[j], narrow_to)
            else if is_span_param(mp) == 1 and mbe != null
                # AGAST #2305: `r.len(@a)` builds its Span as `len(@a)` does.
                conv_regs[j] = span_param_arg(s, mbe, mp, arg_regs[j])
            else if mp.param_type == TypeKind.F32 or mp.param_type == TypeKind.F64
                conv_regs[j] = method_float_arg(s, mp, mbe, arg_regs[j])   # AGAST #2561
            else if param_takes_addr_value(s, mbe, mp) == 1
                # AGAST #2287: as the free-call cascade does for any `@&T`.
                conv_regs[j] = i64_value_to_ptr(s, mbe, arg_regs[j])
            else if mp.param_type == TypeKind.MutRef
                # AGAST #1758: `@&v`, an `@&T` ident and `v as @&T` are
                # already `ptr`; an i64 value (a `-> @&T` call result) is
                # inttoptr'd.  The UFCS arm did this until LARB R66 (#3497)
                # sent ritzlib's methods here.
                conv_regs[j] = i64_value_to_ptr(s, mbe, arg_regs[j])
            else if (mp.param_type == TypeKind.Ref or mp.param_type == TypeKind.Ptr or mp.param_type == TypeKind.PtrPtr) and expr_is_ptr_valued(s, mbe) == 1
                # AGAST #2416: `r.get(@&c)` into `c: @C`, as the free call does.
                # AGAST #3071: and `q.swap(@&e)` into `n: *C` (or `**C`).
                conv_regs[j] = ptr_value_to_i64(s, mbe, arg_regs[j])
            else if mp.param_type == TypeKind.Ref and mp.param_type_name_len > 0
                var mae: *Expr = e.args
                var mk: i32 = 0
                while mk < j and mae != null
                    mae = mae.next
                    mk = mk + 1
                if mae != null and mae.kind == ExprKind.Ident
                    let mloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (mae.ident_ptr), len: (mae.ident_len) as i64 })
                    if mloc != null and lv_var_type(mloc) == TypeKind.Struct
                        let pti_m: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, pti_m)
                        emit_str(s, c" = ptrtoint ptr ")
                        emit_reg(s, mloc.reg)
                        emit_str(s, IR_TO_I64)
                        conv_regs[j] = pti_m
            # An integer for a by-value struct param, which the newtype box
            # used to store into the struct, is Sema's call_check's to refuse
            # (LARB R47b, §9.2, #3420; AGAST #3503).
            mp = mp.next

# `Type_method(receiver, args)`: the impl method the receiver's type names.
fn emit_impl_method_call(s: *EmitterState, e: *Expr, recv: *Expr, r: *MethodRecv) -> i32
    # Fallback: Build mangled function name: Type_method
    # Emit: call <rt> @Type_method(ptr %receiver, args...)
    #
    # AGAST #113 — walk the impl blocks to find the method's FnDef so we can
    # coerce struct-ref args (auto-borrow) and narrow non-i64 return values.
    # Without the FnDef, fall back to the pre-#113 `call i64 @...(i64 ...)`.
    var mfn: *FnDef = null
    mfn = find_impl_method(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    # AGAST #2096: a generic impl's method specialized at the receiver's type
    # (`w.dup()` on W<i32> -> `W$i32_dup`) lives in the module's functions,
    # not in an impl block.  Without its FnDef the call fell back to
    # `call i64`, against `define %W$i32` (or `define i32` for `-> T`).
    # It is defined as a free fn, so its `*W<T>` self is the i64 value-model
    # pointer, not the impl define's forced `ptr` (see recv_ty below).
    var mfn_is_spec: bool = false
    if mfn == null
        mfn = find_spec_impl_method(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if mfn != null
            mfn_is_spec = true
    if mfn == null and refuse_no_method(s, e, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }) == 1
        return 0
    note_method_callee(s, e, mfn)   # AGAST #2237
    if refuse_array_return(s, e, mfn) == 1
        return 0
    if refuse_receiver_short_of_self(s, recv, mfn, r.recv_levels) == 1
        return 0
    # AGAST #3071: a `self` two levels or more from its struct is the pointer
    # at those levels: the place of a receiver one short (lent, §5.4), or what
    # one with the levels holds.  Not the `*S` the dispatch below loads.
    if pass_self_at_its_levels(s, recv, mfn, r.recv_levels, r.recv_base, @r.receiver_reg) == 1
        r.recv_is_ptr_of_ptr = 0

    # A pointer-typed receiver (local, param or field `*T`) sits in a slot
    # that holds the pointer: load it and pass that, not the slot (AGAST #1692).
    if r.recv_is_ptr_of_ptr == 1
        let recv_ptr: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, recv_ptr, r.receiver_reg)
        r.receiver_reg = recv_ptr

    var self_param: *Param = null
    if mfn != null and param_self_is_value(mfn.params) == 1
        self_param = mfn.params
        r.receiver_reg = emit_self_value(s, self_param, r.receiver_reg)

    # First, evaluate all arguments and collect their registers
    let arg_regs: *i32 = call_reg_slots(e.args, 0)
    let conv_regs: *i32 = call_reg_slots(e.args, 0)
    var arg_count: i32 = 0
    var arg: *Expr = e.args
    # Params walked alongside, skipping self (AGAST #1498).
    var ap: *Param = null
    if mfn != null
        ap = mfn.params
        if ap != null
            ap = ap.next
    while arg != null
        arg_regs[arg_count] = emit_call_arg(s, arg, ap)
        conv_regs[arg_count] = arg_regs[arg_count]
        arg_count = arg_count + 1
        if ap != null
            ap = ap.next
        arg = arg.next

    method_coerce_args(s, e, mfn, arg_regs, conv_regs, arg_count)

    var rtype: TypeKind = TypeKind.I64
    if mfn != null
        rtype = mfn.return_type

    # A specialized `Type$T_method` declares a pointer self (`*W<T>`, `@W<T>`)
    # as i64 (emit_llvm_type), so pass the receiver as one (AGAST #2096).
    var recv_ty: *u8 = c"ptr "
    if mfn_is_spec and mfn.params != null
        let sp: TypeKind = mfn.params.param_type
        if sp == TypeKind.Ptr or sp == TypeKind.Ref
            let recv_int: i32 = next_reg(s)
            format_into(s.out, "  %.{recv_int} = ptrtoint ptr %.{r.receiver_reg} to i64\n")
            r.receiver_reg = recv_int
            recv_ty = c"i64 "

    # Emit the call with the correct return type keyword.  A void method is
    # `call void` with no result register; binding one to `call i64` would
    # mismatch the `define void` (AGAST #1581).
    var result: i32 = 0
    # AGAST #1730 — large struct results come back via an sret slot.
    var m_sret: i32 = 0
    if mfn != null and struct_ret_uses_sret(s, rtype, StrView { ptr: (mfn.return_type_name), len: (mfn.return_type_name_len) as i64 }) == 1
        m_sret = emit_sret_call_slot(s, StrView { ptr: (mfn.return_type_name), len: (mfn.return_type_name_len) as i64 })
    m_sret = emit_call_sret_array_slot(s, mfn, m_sret)   # AGAST #3181
    if m_sret > 0
        result = next_reg(s)
        emit_str(s, c"  call void @")
    else if rtype == TypeKind.Void
        emit_str(s, c"  call void @")
    else
        result = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, result)
    # An sret call already wrote `call void @`; the result type keyword
    # below is for the first-class forms only.
    if m_sret == 0
        if rtype == TypeKind.Void
            result = 0
        else if ret_array_of(mfn) != null
            emit_str(s, IR_CALL)
            emit_fn_ret_llvm_type(s, mfn)   # AGAST #2302: `[N x T]`
            emit_str(s, c" @")
        else if rtype == TypeKind.Bool
            emit_str(s, c" = call i1 @")
        else if ty_int_bits(rtype) == 32
            emit_str(s, c" = call i32 @")
        else if ty_int_bits(rtype) == 16
            emit_str(s, c" = call i16 @")
        else if ty_int_bits(rtype) == 8
            emit_str(s, c" = call i8 @")
        else
            match rtype
                TypeKind.F32 =>
                    emit_str(s, c" = call float @")
                TypeKind.F64 =>
                    emit_str(s, c" = call double @")
                _ =>
                    if rtype == TypeKind.Struct and mfn != null and mfn.return_type_name_len > 0
                        # Struct-returning impl methods (e.g. `clone_self(self) -> S`).
                        # Match the `define weak_odr %S @S_clone_self(...)` signature
                        # rather than the i64 fallback — clang rejects the type mismatch.
                        emit_str(s, IR_CALL)
                        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (mfn.return_type_name), len: (mfn.return_type_name_len) as i64 })
                        emit_str(s, c" @")
                    else
                        emit_str(s, c" = call i64 @")
    emit_name(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 })
    emit_str(s, c"_")
    emit_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    emit_str(s, c"(")
    if m_sret > 0
        emit_call_sret_attr(s, mfn, StrView { ptr: (mfn.return_type_name), len: (mfn.return_type_name_len) as i64 })
        emit_reg(s, m_sret)
        emit_str(s, IR_COMMA)
    if self_param != null
        emit_param_llvm_type(s, self_param)
        emit_str(s, IR_SP)
    else
        emit_str(s, recv_ty)
    emit_reg(s, r.receiver_reg)

    # Emit args with formal types (or i64 fallback when fn_def missing).
    var mp2: *Param = null
    if mfn != null
        mp2 = mfn.params
        if mp2 != null
            mp2 = mp2.next
    for j in 0..arg_count
        emit_str(s, IR_COMMA)
        if mp2 != null
            emit_param_llvm_type(s, mp2)   # AGAST #1739
            mp2 = mp2.next
        else
            emit_str(s, c"i64")
        emit_str(s, IR_SP)
        emit_reg(s, conv_regs[j])
    emit_str(s, IR_CLOSE)
    if m_sret > 0
        result = emit_call_sret_result(s, mfn, result, m_sret, StrView { ptr: (mfn.return_type_name), len: (mfn.return_type_name_len) as i64 })

    # Add method to extern declarations (uses malloc for stable name storage).
    # Skip it only when THIS .ll defines the body (is_local == 1): a `declare`
    # beside the local `define` is an invalid redefinition. A method found in
    # an imported impl (is_local == 0, AGAST #194) has its body in the owning
    # module's .ll, so it needs the declare like an unknown method (#1518).
    if mfn == null or mfn.is_local == 0
        add_method_extern(s, StrView { ptr: (r.type_name), len: (r.type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

    return widen_method_result(s, result, rtype)

pub fn emit_expr_method(s: *EmitterState, e: *Expr) -> i32
    record_assert_site(s, e)   # AGAST #1869: in a [[test]] fn only
    # `m.f()`: no `module.item` access (§15.3, AGAST #2215); was "cannot
    # determine receiver type", unlocated.
    if e.left != null and e.left.kind == ExprKind.Ident
        if is_module_item(s, e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len) == 1
            return emit_module_item_error(s, e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len, e.span.line, e.span.col)
    # Method call: receiver.method(args)
    # e.left is the receiver expression
    # e.ident_ptr/ident_len is the method name
    # e.args is the argument list
    #
    # Strategy: Determine receiver type, mangle to Type_method, call with receiver as first arg
    #
    # Receiver kinds handled:
    #   ExprKind.Ident  — look up the local binding's struct type
    #   ExprKind.Call   — resolve callee return type, materialise the struct
    #                 value into a stack slot for ptr-passing dispatch
    #                 (ritz-task-106)
    #   ExprKind.Method — recursive chain `a.foo().bar()`; we emit the inner
    #                 call for value correctness but can only resolve the
    #                 outer method through an intrinsic that doesn't need
    #                 a resolved struct type, since the inner method's
    #                 return type isn't indexed in ritz1's impl table
    #                 yet. (ritz-task-106)
    var r: MethodRecv = MethodRecv { type_name: null, type_name_len: 0, receiver_reg: 0, recv_is_ptr_of_ptr: 0, elem_recv: null, elem_recv_len: 0, recv_value_reg: 0 - 1, recv_levels: 0 - 1, recv_base: 0 - 1 }

    # Float-primitive receiver: ceil/floor/round/abs (AGAST #1370).  Before
    # any receiver resolution: the call / chain arms below spill the receiver
    # as an i64, and a float lives in a `float` / `double` register.  A
    # struct receiver is never float-typed, so no impl method is shadowed.
    let fmeth: i32 = try_emit_float_method(s, e)
    if fmeth >= 0
        return fmeth

    # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum value,
    # not a method call.  Before the impl lookup: in ritz0 a variant wins
    # over an impl method of the same name (a local named `Opt` still
    # shadows the enum; qualified_variant checks that).
    var qvi: i32 = 0
    let qei: i32 = qualified_variant(s, e, @qvi)
    if qei >= 0
        return emit_qualified_variant_ctor(s, e, qei, qvi)

    # `E.from(v)` for an enum with no generated `from` (LANGUAGE_SPEC §10.4).
    let from_reg: i32 = try_emit_enum_from(s, e)
    if from_reg != 0 - 1
        return from_reg

    # `Span.empty()`: T from the slot, not a receiver (AGAST #2296).
    let span_assoc: i32 = try_emit_span_assoc(s, e)
    if span_assoc != 0 - 1
        return span_assoc

    # Static-method dispatch: `Vec2.new(...)`.  When the LHS ident matches
    # a STRUCT or IMPL name (and not a local/global), we don't pass a
    # receiver — emit a direct call to `<Type>_<method>(args)` and return.
    # Mirrors ritz0's static-method path (Type.method desugars to a free
    # call against the impl table entry without a self argument).  Must
    # come BEFORE the local-lookup branch so a struct named like a local
    # variable still routes correctly.
    #
    # A global named like the type that can't be a receiver doesn't shadow it,
    # as in ritz0 (AGAST #2575): `var String: i32` beside `String.from(x)`.
    # A struct global does (`var Opt: S`).  monomorph's
    # rewrite_static_ufcs_call hid this for the UFCS table's types until
    # LARB R66 (#3497) deleted the table.
    var static_reg: i32 = 0
    if try_emit_static_method(s, e, @static_reg) == 1
        return static_reg
    # AGAST #2550: `(@d).m()` and `(@&d).m()` dispatch on `d`, as in ritz0 —
    # the receiver is auto-borrowed anyway, so the address-of names the
    # same place.  Its `@T`-into-`@&T` refusal already ran in the checker.
    var recv: *Expr = e.left
    while recv.kind == ExprKind.Unary and (recv.op == OpKind.Addr or recv.op == OpKind.AddrMut) and recv.operand != null
        recv = recv.operand
    method_recv_resolve(s, e, recv, @r)

    var builtin_reg: i32 = 0
    if try_emit_method_builtin(s, e, recv, @r, @builtin_reg) == 1
        return builtin_reg

    emit_impl_method_call(s, e, recv, @r)
