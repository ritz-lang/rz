# ritz1/src/type_name_check.ritz - a type name that names nothing (AGAST #3932)
#
# `struct P` / `name: Nope` and `let q: Nope = 0` emitted `%Nope` IR clang
# refused with no source location ("use of undefined type named 'Nope'").
# Every compiler now says "unknown type `Nope`" where the name is written,
# the words #3264 uses for an `impl` on one.  ritz0's half is
# ritz0/type_names.py.
#
# Judged: a struct's fields, a global's type, and a fn's params, return type
# and annotated `let` / `var` locals, generic templates included (with their
# own type parameters, and an impl's, in scope).  Known: a struct or enum of
# the merged module (an import counts), an alias, a primitive, a SIMD vector,
# a built-in (`StrView`, `Span`, `Option`, `Result`), `Self` and `void`.
#
# Only a name the source spells is judged: type_name_written_at locates it
# (ast_helpers.ritz records each one type_named sees).  A name the compiler
# builds, such as a generic instance's `Vec$u8`, has no entry.  Each written
# name is reported once.
#
# Where the AST keeps no source spelling, the parser notes the name instead
# (AGAST #4021, ast_helpers.ritz TnNote): a generic argument (`Option<Nope>`
# is the slot's `Option$Nope`), an enum payload, an alias's target (used or
# not), a cast's type and a struct literal's name (AGAST #3993; a struct
# variant's `Log { .. }` is no type, so it is refused too); and (AGAST #4171)
# a struct-style variant's field and a generic call's type argument
# (`g<Nope>(3)`).  Each note comes with the type parameters in scope
# where it was written (TnScope), and is judged in them.
#
# A slot is judged only when its name is written after the declaration's own
# name, on its line (a return type: anywhere after the fn's name).  The parser
# leaves the last type name it saw in its state, and a slot it doesn't name
# can inherit it: `f: fn(i64) -> i64` after `-> @&T` kept that `T`, and a
# `-> *u8` the last name before it.  Such a name was written earlier, so it
# fails the test; where it was written, it was judged.
#
# Runs after imports merge and before monomorphisation, as binder_check does.

import ritzlib.sys
import ritzlib.io
import ast
import ast_helpers
import diag
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)

# The type parameters in scope: the item's own, and an impl's around a method.
var g_tn_outer: *TypeParam = null
var g_tn_inner: *TypeParam = null

fn tn_in_params(tp: *TypeParam, name_sv: StrView) -> i32
    var cur: *TypeParam = tp
    while cur != null
        if name_eq(cur.name, name_sv) == 1
            return 1
        cur = cur.next
    0

fn tn_builtin(name_sv: StrView) -> i32
    if name_eq(name_sv, "Self") == 1 or name_eq(name_sv, "void") == 1
        return 1
    if name_eq(name_sv, "StrView") == 1 or name_eq(name_sv, "Span") == 1
        return 1
    (name_eq(name_sv, "Option") == 1 or name_eq(name_sv, "Result") == 1) as i32

fn tn_declared(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> i32
    var st: *StructDef = m.structs
    while st != null
        if name_eq(st.name, name_sv) == 1
            return 1
        st = st.next
    (enum_find(ctx, name_sv) >= 0 or type_alias_declared(ctx, name_sv) == 1) as i32

fn tn_known(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> i32
    if is_primitive_type_name(name_sv) == 1 or is_simd_vector_type_name(name_sv) == 1
        return 1
    if tn_builtin(name_sv) == 1
        return 1
    if tn_in_params(g_tn_inner, name_sv) == 1 or tn_in_params(g_tn_outer, name_sv) == 1
        return 1
    tn_declared(ctx, m, name_sv)

const TN_SCAN_MAX: i64 = 4096

# 1 when `ty` is written after `decl` in the same source: on its line if
# `same_line`, else within TN_SCAN_MAX bytes.  Never reads past the source's NUL.
fn tn_written_after(decl: *u8, ty: *u8, same_line: i32) -> i32
    if decl == null
        return 0
    var i: i64 = 0
    while i < TN_SCAN_MAX
        if decl + i == ty
            return 1
        let c: u8 = *(decl + i)
        if c == 0 or (same_line == 1 and c == 10)
            return 0
        i += 1
    0

# 1 if the type name at `name`, written after `decl` (tn_written_after), is
# unknown; reported at the name.
fn tn_judge(ctx: *ParseCtx, m: *Module, decl: *u8, same_line: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    if tn_written_after(decl, name, same_line) == 0
        return 0
    tn_judge_written(ctx, m, name_sv)

# 1 if the type name the source spells at `name` is unknown; reported there.
fn tn_judge_written(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if tn_known(ctx, m, name_sv) == 1
        return 0
    let at: *TypeNameAt = type_name_written_at(ctx, name)
    if at == null or at.reported == 1
        return 0
    at.reported = 1
    diag_error_at(at.file, diag_span(at.line, at.col))
    eprints("unknown type `")
    sys_write(2, name, len as i64)
    eprints("`\n")
    1

fn tn_arms(ctx: *ParseCtx, m: *Module, arms: *MatchArm) -> i32
    var errors: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        errors = errors + tn_stmts(ctx, m, arm.body_stmts)
        errors = errors + tn_expr(ctx, m, arm.body)
        arm = arm.next
    errors

# Only a match or an if/else expression holds statements (binder_check.ritz).
fn tn_expr(ctx: *ParseCtx, m: *Module, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.Match or e.kind == ExprKind.If
        return tn_arms(ctx, m, e.args as *MatchArm)
    0

fn tn_stmts(ctx: *ParseCtx, m: *Module, first: *Stmt) -> i32
    var errors: i32 = 0
    var s: *Stmt = first
    while s != null
        match s.kind
            StmtKind.VarDecl =>
                if s.var_declared_type != TypeKind.Void
                    errors = errors + tn_judge(ctx, m, s.var_name.ptr, 1, s.var_type_name)
                errors = errors + tn_expr(ctx, m, s.var_init)
            StmtKind.For =>
                errors = errors + tn_stmts(ctx, m, s.for_body)
            StmtKind.If =>
                errors = errors + tn_expr(ctx, m, s.if_cond)
                errors = errors + tn_stmts(ctx, m, s.if_then)
                errors = errors + tn_stmts(ctx, m, s.if_else)
            StmtKind.While =>
                errors = errors + tn_expr(ctx, m, s.while_cond)
                errors = errors + tn_stmts(ctx, m, s.while_body)
            StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                errors = errors + tn_stmts(ctx, m, s.while_body)
            StmtKind.Match =>
                errors = errors + tn_arms(ctx, m, s.if_then as *MatchArm)
            StmtKind.Return =>
                errors = errors + tn_expr(ctx, m, s.return_value)
            StmtKind.Expr =>
                errors = errors + tn_expr(ctx, m, s.expr)
            StmtKind.Assign =>
                errors = errors + tn_expr(ctx, m, s.assign_value)
            _ => pass
        s = s.next
    errors

fn tn_fn(ctx: *ParseCtx, m: *Module, f: *FnDef) -> i32
    g_tn_inner = f.type_params
    var errors: i32 = tn_judge(ctx, m, f.name.ptr, 0, f.return_type_name)
    var p: *Param = f.params
    while p != null
        errors = errors + tn_judge(ctx, m, p.name.ptr, 1, p.param_type_name)
        p = p.next
    errors = errors + tn_stmts(ctx, m, f.body)
    g_tn_inner = null
    errors

fn tn_struct(ctx: *ParseCtx, m: *Module, st: *StructDef) -> i32
    g_tn_inner = st.type_params
    var errors: i32 = 0
    var f: *StructField = st.fields
    while f != null
        errors = errors + tn_judge(ctx, m, f.name.ptr, 1, f.field_type_name)
        errors = errors + tn_judge(ctx, m, f.name.ptr, 1, f.array_elem_type_name)
        f = f.next
    g_tn_inner = null
    errors

fn tn_global(ctx: *ParseCtx, m: *Module, g: *GlobalVarDef) -> i32
    var errors: i32 = tn_judge(ctx, m, g.name.ptr, 1, g.type_name)
    errors = errors + tn_judge(ctx, m, g.name.ptr, 1, g.pointee_type_name)
    errors + tn_judge(ctx, m, g.name.ptr, 1, g.array_elem_type_name)

# The names the parser noted (AGAST #4021), each in its item's scope.
fn tn_notes(ctx: *ParseCtx, m: *Module) -> i32
    var errors: i32 = 0
    var s: *TnScope = tn_scopes(ctx)
    while s != null
        g_tn_inner = s.inner
        g_tn_outer = s.outer
        var n: *TnNote = s.notes
        while n != null
            errors = errors + tn_judge_written(ctx, m, StrView { ptr: (n.name), len: (n.len) as i64 })
            n = n.next
        s = s.next
    g_tn_inner = null
    g_tn_outer = null
    errors

# Errors reported; main stops the compile on any.
pub fn refuse_unknown_type_names(ctx: *ParseCtx, m: *Module) -> i32
    var errors: i32 = tn_notes(ctx, m)
    var st: *StructDef = m.structs
    while st != null
        errors = errors + tn_struct(ctx, m, st)
        st = st.next
    var g: *GlobalVarDef = m.globals
    while g != null
        errors = errors + tn_global(ctx, m, g)
        g = g.next
    var f: *FnDef = m.functions
    while f != null
        errors = errors + tn_fn(ctx, m, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        g_tn_outer = ib.type_params
        var method: *FnDef = ib.methods
        while method != null
            errors = errors + tn_fn(ctx, m, method)
            method = method.next
        g_tn_outer = null
        ib = ib.next
    errors
