# ritz1/src/slot_narrowing.ritz - implicit narrowing at an assignment, a call
# argument, a return and a struct literal field
#
# AGAST #4081 and #4218, ritz1's halves of #1444 and #4157 (LANGUAGE_SPEC §7.5).
#
#     fn big() -> i64
#         return 4294967301
#     fn r() -> i32
#         return big()            # error: write `big() as i32`
#     n = big()                   # error, n: i32
#     take(big())                 # error, take(v: i32)
#     P { x: big() }              # error, P.x: i32
#
# A `let` / `var` initialiser has been held to §7.5 since #1446
# (narrowing.ritz's check_implicit_narrowing).  This checks the same rule,
# with the same provably-lossless exemptions (narrow_sema_unproven: a constant
# that fits, a mask `e & K`, an if/match whose every arm fits), wherever else
# an integer converts to a declared integer type:
#
#   * an assignment `place = v` / `place op= v`, at the place's type;
#   * a call argument, at its parameter's type (a fn, a fn pointer, an
#     extern, a static or an instance method);
#   * a struct literal's field initialiser `S { f: v }`, at the field's type;
#   * a `return v` or a fn's tail value, at the return type.  A procedure's
#     tail is discarded, so it is not checked (as in ritz0).  An async fn's
#     `return v` is lowered to `self.__result = v` before sema, so the
#     assignment route judges it at the declared type, and words it as a
#     return of the async fn ("`f` returns"), as ritz0 does (sn_async_result).
#
# ritz0/test_implicit_narrowing_slots.py is the specification, and
# ritz0/test_ritz1_implicit_narrowing_slots.py feeds its tables to ritz1.
#
# One-sided, as narrowing.ritz is: a slot or a value whose integer type Sema
# cannot name (TypeKind.NarrowUnknown, a borrow, a generic) is never refused.
#
# WHERE IT RUNS: on Sema, from sema_walk, at the slots literal_slot.ritz
# visits, before the value's own sub-expressions are walked.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import diag
import sema
import sema_type
import narrowing
import bool_check
import ritzlib.strview

# What a slot is called in the diagnostic: "`n` is", "argument 2 of `take`
# is", "`f` returns".
const SN_PLACE: i32 = 1
const SN_ARG: i32 = 2
const SN_RETURN: i32 = 3
const SN_FIELD: i32 = 4

struct SlotWords
    kind: i32
    # SN_PLACE: the place (`p.x`, `a[..]`, `*p`), or null for "the place
    # assigned"; SN_ARG: the callee; SN_RETURN: the fn; SN_FIELD: the field.
    name: *u8
    name_len: i32
    # SN_PLACE: `name` is a field of `base` (`base.name`); SN_FIELD: the
    # struct; SN_ARG: the index.
    base: *u8
    base_len: i32
    # SN_PLACE shapes 5 and 6: the field of `base` that holds the pointer.
    mid: *u8
    mid_len: i32
    # SN_PLACE: 0 bare, 1 `base.name`, 3 `*name`, 4 `*base.name`,
    # 5 `*base.mid.name`, 6 `**base.mid.name` (2, `name[..]`, is now 0 indexed)
    shape: i32
    # SN_PLACE: 1 when the place is an element of it, `<shape>[..]` (#4309:
    # `*p.x[..]`, `s.x[..]`).
    indexed: i32
    index: i32

# Where a value is reported: ritz0's _value_span (a binary at its left
# operand, a cast at its operand), as float_slot reports it.
fn sn_report_at(e: *Expr) -> *Expr
    var at: *Expr = e
    while (at.kind == ExprKind.Binary or at.kind == ExprKind.Cast) and at.left != null
        at = at.left
    at

fn sn_print(p_sv: StrView)
    narrow_eprint_name(p_sv)

fn sn_print_slot(w: *SlotWords)
    if w.kind == SN_ARG
        eprints("argument ")
        eprint_i64((w.index + 1) as i64)
        eprints(" of `")
        sn_print(StrView { ptr: (w.name), len: (w.name_len) as i64 })
        eprints("` is `")
        return
    if w.kind == SN_FIELD
        eprints("field `")
        sn_print(StrView { ptr: (w.name), len: (w.name_len) as i64 })
        eprints("` of `")
        sn_print(StrView { ptr: (w.base), len: (w.base_len) as i64 })
        eprints("` is `")
        return
    if w.kind == SN_RETURN
        eprint_char('`')
        sn_print(StrView { ptr: (w.name), len: (w.name_len) as i64 })
        eprints("` returns `")
        return
    if w.name == null
        eprints("the place assigned is `")
        return
    eprint_char('`')
    if w.shape >= 3
        eprint_char('*')
    if w.shape == 6
        eprint_char('*')
    if w.shape == 1 or w.shape >= 4
        sn_print(StrView { ptr: (w.base), len: (w.base_len) as i64 })
        eprint_char('.')
    if w.shape >= 5
        sn_print(StrView { ptr: (w.mid), len: (w.mid_len) as i64 })
        eprint_char('.')
    sn_print(StrView { ptr: (w.name), len: (w.name_len) as i64 })
    if w.indexed == 1
        eprints("[..]")
    eprints("` is `")

# `value` lands in integer slot `slot`: refuse it unless it provably fits.
fn sn_check(sm: *Sema, value: *Expr, slot: TypeKind, w: *SlotWords)
    if value == null or slot == TypeKind.NarrowUnknown
        return
    let src: TypeKind = narrow_sema_unproven(sm, value, slot)
    if src == TypeKind.Void
        return
    if bool_sema_report_at(sm, sn_report_at(value)) == 0
        return
    eprints("implicit narrowing: ")
    sn_print_slot(w)
    eprints_cstr(ty_name(slot))
    eprints("` but this value has type `")
    eprints_cstr(ty_name(src))
    eprints("`, and the compiler cannot prove the value fits. Write `<expr> as ")
    eprints_cstr(ty_name(slot))
    eprints("` if truncation is intended\n")

fn sn_words(w: *SlotWords, kind: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    w.kind = kind
    w.name = name
    w.name_len = len
    w.base = null
    w.base_len = 0
    w.mid = null
    w.mid_len = 0
    w.shape = 0
    w.indexed = 0
    w.index = 0

# =============================================================================
# Assignment
# =============================================================================

# The integer type of place `t` (an EXPR_* target), else TypeKind.NarrowUnknown; and
# its words.
fn sn_place_type(sm: *Sema, t: *Expr, w: *SlotWords) -> TypeKind
    sn_words(w, SN_PLACE, strview_empty())
    if t == null
        return TypeKind.NarrowUnknown
    match t.kind
        ExprKind.Ident =>
            w.name = t.ident.ptr
            w.name_len = t.ident.len as i32
            return narrow_sema_name_type(sm, t.ident)
        ExprKind.Member =>
            if t.left != null and t.left.kind == ExprKind.Ident
                w.base = t.left.ident.ptr
                w.base_len = t.left.ident.len as i32
                w.name = t.ident.ptr
                w.name_len = t.ident.len as i32
                w.shape = 1
            let f: *StructField = sbk_member_field(sm, t)
            if f == null
                return TypeKind.NarrowUnknown
            return narrow_known(f.field_type)
        ExprKind.Index =>
            if t.left != null and t.left.kind == ExprKind.Ident
                w.name = t.left.ident.ptr
                w.name_len = t.left.ident.len as i32
                w.indexed = 1
            if t.right == null or t.right.kind == ExprKind.Range
                return TypeKind.NarrowUnknown
            var kind: TypeKind = TypeKind.Void
            var pointee: TypeKind = TypeKind.Void
            sema_index_slot(sm, t, @kind, @pointee)
            return narrow_known(kind)
        _ => pass
    if t.kind == ExprKind.Unary and t.op == OpKind.Deref
        if t.operand != null and t.operand.kind == ExprKind.Ident
            w.name = t.operand.ident.ptr
            w.name_len = t.operand.ident.len as i32
            w.shape = 3
        var pt: SemaTy
        let pk: TypeKind = sema_expr_ty(sm, t.operand, @pt)
        if pk == TypeKind.Ptr or pk == TypeKind.Ref or pk == TypeKind.MutRef
            return narrow_known(pt.pointee)
        return TypeKind.NarrowUnknown
    TypeKind.NarrowUnknown

# The field `field` of the struct `local` is, else null.
fn sn_local_field(sm: *Sema, local_sv: StrView, field_sv: StrView) -> *StructField
    let v: *SemaVar = sema_find_local(sm, local_sv)
    if v == null or v.type_name.ptr == null or v.type_name.len <= 0
        return null
    sbk_struct_field(sm, v.type_name, field_sv)

# `target = value` (and `target op= value`, which the parser makes
# `target = target op value`), in each spelling the parser has for one.
pub fn slot_narrowing_assign(sm: *Sema, st: *Stmt)
    var w: SlotWords
    sn_words(@w, SN_PLACE, strview_empty())
    var slot: TypeKind = TypeKind.NarrowUnknown
    let k: StmtKind = st.kind
    match k
        StmtKind.Assign =>
            if st.assign_target.len != 0
                w.name = st.assign_target.ptr
                w.name_len = st.assign_target.len as i32
                slot = narrow_sema_name_type(sm, st.assign_target)
            else
                slot = sn_place_type(sm, st.if_cond as *Expr, @w)
        StmtKind.IndexAssign =>
            w.name = st.assign_target.ptr
            w.name_len = st.assign_target.len as i32
            w.indexed = 1
            var kind: TypeKind = TypeKind.Void
            var pointee: TypeKind = TypeKind.Void
            sema_named_elem(sm, st.assign_target, @kind, @pointee)
            slot = narrow_known(kind)
        StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            w.base = st.var_name.ptr
            w.base_len = st.var_name.len as i32
            w.name = st.assign_target.ptr
            w.name_len = st.assign_target.len as i32
            w.shape = 1
            let f: *StructField = sn_local_field(sm, st.var_name, st.assign_target)
            slot = sn_field_slot(sm, f, sn_is(k, StmtKind.LocalFieldIndexAssign), @w)
        StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            let f: *StructField = sn_member_field(sm, st, @w)
            slot = sn_field_slot(sm, f, sn_is(k, StmtKind.MemberIndexAssign), @w)
            if k == StmtKind.MemberAssign
                sn_async_result(sm, st.if_cond as *Expr, @w)
        _ => pass
    sn_check(sm, st.assign_value, slot, @w)

fn sn_is(a: StmtKind, b: StmtKind) -> i32
    if a == b
        return 1
    0

# The slot field `f` is (null: unknown), or with `indexed` (`x.f[i] = v`, the
# STMT_*_INDEX_ASSIGN forms, AGAST #4309) the slot an element of it is, as
# `x.f[i]` on the right is typed; the place is then worded `<place>[..]`.
fn sn_field_slot(sm: *Sema, f: *StructField, indexed: i32, w: *SlotWords) -> TypeKind
    if f == null
        return TypeKind.NarrowUnknown
    if indexed == 0
        return narrow_known(f.field_type)
    w.indexed = 1
    var kind: TypeKind = TypeKind.Void
    var pointee: TypeKind = TypeKind.Void
    sema_field_elem(sm, f, @kind, @pointee)
    narrow_known(kind)

# `(*pe).f = v` (or `(*pe).f[i] = v`), the pointer expression `pe` in
# if_cond: the field `f` of the struct `pe` points at, whatever expression `pe` is (AGAST #4288: in
# an async fn the lowering makes a pointer param `p` the future's `self.p`).
#
# ritz0 names the place as written through the pointer, "`*p.f` is" (AGAST
# #4240), "`*q.p.f` is" for `(*q.p).f`, and, as it renders the async
# lowering's `self.<local>` (`*self.n`), "`**self.p.f` is" in a lowered poll.
fn sn_member_field(sm: *Sema, st: *Stmt, w: *SlotWords) -> *StructField
    let pe: *Expr = st.if_cond as *Expr
    if pe == null
        return null
    w.name = st.assign_target.ptr
    w.name_len = st.assign_target.len as i32
    if pe.kind == ExprKind.Ident
        w.base = pe.ident.ptr
        w.base_len = pe.ident.len as i32
        w.shape = 4
    else if pe.kind == ExprKind.Member and pe.left != null and pe.left.kind == ExprKind.Ident
        w.base = pe.left.ident.ptr
        w.base_len = pe.left.ident.len as i32
        w.mid = pe.ident.ptr
        w.mid_len = pe.ident.len as i32
        w.shape = 5
        # A pointer the future holds (a param `p`, `(*p).f`) is `**self.p.f`;
        # a struct local it holds (`s.f`, lowered to `self.s`) is ritz0's
        # `*self.s.f`, the shape-5 words (AGAST #4309).
        if name_eq(StrView { ptr: (w.base), len: (w.base_len) as i64 }, "self") == 1 and sn_poll_fn_len(sm) > 0
            var mt: SemaTy
            let mk: TypeKind = sema_expr_ty(sm, pe, @mt)
            if mk == TypeKind.Ptr or mk == TypeKind.Ref or mk == TypeKind.MutRef
                w.shape = 6
    else
        w.name = null     # "the place assigned"
        w.name_len = 0
    var tn: *u8 = null
    var tn_len: i32 = 0
    sbk_receiver(sm, pe, @tn, @tn_len)
    if tn == null or tn_len <= 0
        return null
    sbk_struct_field(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, st.assign_target)

# The length of `<f>` when the fn being walked is an async fn's lowered poll,
# `fn <f>$poll(self: *<f>$Future)`, else 0.  The lowering sets no flag on the
# poll (and clears is_async), so it is known by its shape.
fn sn_poll_fn_len(sm: *Sema) -> i32
    let f: *FnDef = sm.cur_fn
    if f == null or f.params == null or f.name.len <= 5
        return 0
    let fl: i32 = (f.name.len as i32) - 5   # `<f>$poll` less its `$poll`
    if name_eq(StrView { ptr: (f.name.ptr + fl as i64), len: (5) as i64 }, "$poll") == 0
        return 0
    let tn: *u8 = f.params.param_type_name.ptr
    if (f.params.param_type_name.len as i32) != fl + 7 or name_eq(StrView { ptr: (tn), len: (fl) as i64 }, f.name.take(fl as i64)) == 0
        return 0
    if name_eq(StrView { ptr: (tn + fl as i64), len: (7) as i64 }, "$Future") == 0
        return 0
    fl

# An async fn's `return v` and tail, lowered (async_lower.ritz al_poll_ready)
# to `self.__result = v` in `fn <f>$poll(self: *<f>$Future) -> bool`, are
# returns of `f`: report them as ritz0 does, "`f` returns `i32`" (AGAST
# #4221), not as the lowered place the user never wrote.  The slot stays the
# field's type, which is `f`'s declared return type.
#
# The poll is known by its shape (sn_poll_fn_len): a written
# `(*self).__result = v` takes this route too, and keeps its place wording,
# "`*self.__result` is", unless its fn is `<f>$poll(self: *<f>$Future)`.
fn sn_async_result(sm: *Sema, pe: *Expr, w: *SlotWords)
    if pe == null or pe.kind != ExprKind.Ident or w.kind != SN_PLACE or w.name == null
        return
    if name_eq(pe.ident, "self") == 0 or name_eq(StrView { ptr: (w.name), len: (w.name_len) as i64 }, "__result") == 0
        return
    let fl: i32 = sn_poll_fn_len(sm)
    if fl > 0
        sn_words(w, SN_RETURN, sm.cur_fn.name.take(fl as i64))

# =============================================================================
# Call arguments
# =============================================================================

fn sn_args(sm: *Sema, params: *Param, args: *Expr, name_sv: StrView)
    var w: SlotWords
    sn_words(@w, SN_ARG, name_sv)
    var p: *Param = params
    var a: *Expr = args
    var i: i32 = 0
    while p != null and a != null
        if p.is_borrow == 0 and p.is_self_borrow == 0
            w.index = i
            sn_check(sm, a, narrow_known(p.param_type), @w)
        p = p.next
        a = a.next
        i += 1

# `f(args)`: a fn, an extern, or a fn-pointer local.  A nameless callee
# (`h.cb(x)`, `fs[i](x)`) is not judged: ritz0 does not judge it either.
pub fn slot_narrowing_call(sm: *Sema, e: *Expr)
    if e.func_name.len == 0
        return
    if e.call_type_suffix.len <= 0
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null
            if v.fn_sig != null and v.kind != TypeKind.Array
                sn_args(sm, v.fn_sig.params, e.args, e.func_name)
            return
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd == null or fd.type_params != null
        return
    sn_args(sm, fd.params, e.args, e.func_name)

# `recv.m(args)` and `T.m(args)`, as literal_method finds the callee.
pub fn slot_narrowing_method(sm: *Sema, e: *Expr)
    let tn: StrView = sbk_method_recv(sm, e)
    if tn.ptr == null
        return
    let fd: *FnDef = sema_method_fn(sm, tn, e.ident)
    if fd == null or fd.params == null or fd.type_params != null
        return
    if name_eq(fd.params.name, "self") == 1
        sn_args(sm, fd.params.next, e.args, e.ident)
    else
        sn_args(sm, fd.params, e.args, e.ident)

# =============================================================================
# Struct literal field
# =============================================================================

# `S { f: v, .. }`: each value lands in its field (ritz0's
# _emit_struct_lit_field, #4157).  A nested literal is its own ExprKind.StructLit,
# judged when the walk reaches it.  A generic struct's `T` field is no
# integer type, so it is never refused.
pub fn slot_narrowing_struct_lit(sm: *Sema, e: *Expr)
    let st: *StructDef = sema_find_struct(sm, e.ident)
    if st == null
        return
    var w: SlotWords
    sn_words(@w, SN_FIELD, strview_empty())
    w.base = st.name.ptr
    w.base_len = st.name.len as i32
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let idx: i32 = find_field_index(st, fi.name)
        if idx >= 0
            w.name = fi.name.ptr
            w.name_len = fi.name.len as i32
            sn_check(sm, fi.value, narrow_known(get_field_type(st, idx).field_type), @w)
        fi = fi.next

# =============================================================================
# Return and fn tail
# =============================================================================

# The return slot of the fn being walked, TypeKind.NarrowUnknown when it has none
# that §7.5 judges here.
fn sn_return_slot(sm: *Sema, w: *SlotWords) -> TypeKind
    let f: *FnDef = sm.cur_fn
    if f == null
        return TypeKind.NarrowUnknown
    sn_words(w, SN_RETURN, f.name)
    narrow_known(f.return_type)

# `return v` in the fn being walked.
pub fn slot_narrowing_return(sm: *Sema, v: *Expr)
    var w: SlotWords
    let slot: TypeKind = sn_return_slot(sm, @w)
    sn_check(sm, v, slot, @w)

# `e` is the fn's value: its tail, or the tail of a block or match arm in the
# fn's tail chain (sema_walk's tail_value, AGAST #3980), judged as the walk
# reaches it, so the block's `let`s and the arm's bindings are in scope.
pub fn slot_narrowing_tail(sm: *Sema, e: *Expr)
    var w: SlotWords
    let slot: TypeKind = sn_return_slot(sm, @w)
    sn_check(sm, e, slot, @w)
