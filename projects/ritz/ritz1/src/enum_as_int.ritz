# ritz1/src/enum_as_int.ritz - an enum value where an integer is expected
#
# AGAST #2136.  LANGUAGE_SPEC §10.4: an enum value is its tag, not an
# integer -- "Convert explicitly to pass one as an integer."
#
#     enum St
#         A
#         B
#     fn f() -> i64
#         return St.B     # error: expected i64, found enum 'St'; convert with `as`
#
# ritz1 accepted this at every place a value meets a declared type, so an
# `ElfStatus` or an `Errno` without `as i64` could leak out as an integer.
# It checks
#
#   * `return e` and a tail `e` against the fn's integer return type
#   * `let x: T = e` / `var x: T = e` against a written integer T
#   * `x = e`, `x.f = e`, `p.f = e` against an integer target
#   * each call argument against an integer parameter, as ritz0 says it:
#     "argument N of `f`: expected .." (#3340), the receiver of a method
#     call argument 1
#
# WHERE IT RUNS (AGAST #3511, #1816).  A Sema check: sema_walk calls
# enum_as_int_stmt on each statement before the statement is walked (so a
# `let x: i32 = x` still types the outer x), enum_as_int_tail on a fn's
# trailing expression, and enum_as_int_expr on a match or if expression's
# arm, with the arm's binding in scope.  These are the places emit_stmt,
# emit_fn / emit_impl_method and emit_match_arm_body called it from when it
# ran mid-lowering.  Its own walk (enum_as_int_expr) is that one: call
# arguments under unary / binary / index / range / member / cast / try, not
# into a struct literal or an arm (an arm is judged as an arm).
#
# Like narrowing.ritz it is one-sided: an expression is an enum only when
# eai_enum_value names a non-generic user enum, and a target is an integer
# only when its type was written (an unannotated local is the parser's
# TypeKind.I64 default whatever it holds, so it is never trusted).  A missed
# rejection is a parity gap with ritz0; a false one would refuse a valid
# program.
#
# Sema's typed scope types a local from its annotation, else its
# initialiser's sema_expr_ty, which leaves `let s = St.B` unknown.  The
# emitter's local knew it was an St, so eai_note_decl remembers the enum an
# unannotated `let` / `var` was made from, keyed by the declaration.

import ritzlib.cstr
import ritzlib.strview
import ritzlib.sys
import ritzlib.io
import ritzlib.hashmap
import ritzlib.memory

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import ast_query      # is_tagged_enum_type, user_variant_ctor_enum, is_builtin_const, eprint_bytes
import sema
import sema_type
import narrowing
import bool_check     # sbk_global, sbk_value_fn_sig
import diag           # diag_error_at (AGAST #3621)

# =============================================================================
# Is `e` a user enum value?  (the emitter's user_enum_value_of, on Sema)
# =============================================================================

# Declaration name pointer -> the enum name its initialiser was (a *u8),
# and -> its length, for an unannotated `let` / `var`.
var g_eai_notes: *HashMapI64 = null
var g_eai_note_lens: *HashMapI64 = null
var g_eai_notes_ready: i32 = 0

fn eai_is_enum_name(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    if is_tagged_enum_type(name_sv) == 1
        return 1
    is_enum_type(ctx, name_sv)

fn eai_set(name_sv: StrView, out_name: **u8, out_len: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_name = name
    *out_len = len
    1

# 1 when `name` is a module or builtin const (emit_expr_ident's first stop).
fn eai_is_const(sm: *Sema, name_sv: StrView) -> i32
    var len: i32 = name_sv.len as i32
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, name_sv) == 1
            return 1
        c = c.next
    is_builtin_const(name_sv)

# The (non-generic) enum a qualified variant `E.V(..)` / `E.V` builds, as
# qualified_variant_enum: a local or global named `E` shadows the enum.
fn eai_qualified(sm: *Sema, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    let q: *Expr = e.left
    if q == null or q.kind != ExprKind.Ident
        return 0
    if sema_find_local(sm, q.ident) != null
        return 0
    if sbk_global(sm, q.ident) != null
        return 0
    let ei: i32 = enum_find(sm.pctx, q.ident)
    if ei < 0
        return 0
    if enum_variant_index(sm.pctx, q.ident, e.ident) < 0
        return 0
    if enum_is_generic(sm.pctx, ei) == 1
        return 0
    *out_name = enum_name_at(sm.pctx, ei, out_len)
    1

# The fn a named call `e` calls, as find_call_fn: a typed fn-pointer local
# of the name, else sema_call_fn; a nameless one through its fn value.
fn eai_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name.len == 0
        return sbk_value_fn_sig(sm, e.left)
    narrow_sema_call_fn(sm, e)

# resolve_scrutinee_enum's shapes, from Sema's scope.
fn eai_resolve(sm: *Sema, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    let k: ExprKind = e.kind
    match k
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, e.ident)
            if v == null
                return 0
            if g_eai_notes_ready == 1
                let noted: *u8 = (*g_eai_notes).get(v.name as i64).unwrap_or(0) as *u8
                if noted != null
                    return eai_set(StrView { ptr: (noted), len: ((*g_eai_note_lens).get(v.name as i64).unwrap_or(0) as i32) as i64 }, out_name, out_len)
            # AGAST #2135: a pointer local is no enum value, whatever its
            # type_name says.
            if v.kind == TypeKind.Ptr or v.kind == TypeKind.PtrPtr
                return 0
            if eai_is_enum_name(sm.pctx, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }) == 1
                return eai_set(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, out_name, out_len)
            return 0
        ExprKind.Method =>
            return eai_qualified(sm, e, out_name, out_len)   # `Opt.Holds(40)`
        ExprKind.Call =>
            user_variant_ctor_enum(sm.pctx, e, out_name, out_len)     # `Holds(40)`
            if *out_name != null
                return 1
            let fd: *FnDef = eai_call_fn(sm, e)
            if fd != null and fd.return_type == TypeKind.Struct and eai_is_enum_name(sm.pctx, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }) == 1
                return eai_set(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }, out_name, out_len)
            return 0
        ExprKind.Unary =>
            if e.op != OpKind.Deref
                return 0
            let opnd: *Expr = e.operand
            if opnd != null and opnd.kind == ExprKind.Ident
                # `*p` of a `p: *E` local: E, from the pointee's name.
                let pv: *SemaVar = sema_find_local(sm, opnd.ident)
                if pv != null and pv.kind == TypeKind.Ptr and pv.pointee == TypeKind.Struct
                    if eai_is_enum_name(sm.pctx, StrView { ptr: (pv.type_name), len: (pv.type_name_len) as i64 }) == 1
                        return eai_set(StrView { ptr: (pv.type_name), len: (pv.type_name_len) as i64 }, out_name, out_len)
                    return 0
            return eai_resolve(sm, e.operand, out_name, out_len)
        ExprKind.Member =>
            if eai_qualified(sm, e, out_name, out_len) == 1   # `Opt.Vacant`
                return 1
            # An enum-typed struct field, `h.d` (AGAST #1797).
            var t: SemaTy
            if sema_expr_ty(sm, e, @t) == TypeKind.Struct and eai_is_enum_name(sm.pctx, StrView { ptr: (t.name), len: (t.name_len) as i64 }) == 1
                return eai_set(StrView { ptr: (t.name), len: (t.name_len) as i64 }, out_name, out_len)
            return 0
        _ => pass
    0

# A bare `B`: a unit variant of exactly one enum, the name no const, local,
# global or fn (bare_unit_variant_enum).  The enum index, or -1.
fn eai_bare_unit(sm: *Sema, e: *Expr) -> i32
    if e.kind != ExprKind.Ident
        return 0 - 1
    if eai_is_const(sm, e.ident) == 1
        return 0 - 1
    if sema_find_local(sm, e.ident) != null
        return 0 - 1
    if sbk_global(sm, e.ident) != null
        return 0 - 1
    if sema_find_fn(sm, e.ident) != null
        return 0 - 1
    var vi: i32 = 0
    var other: i32 = 0
    let ei: i32 = enum_of_variant_unique(sm.pctx, e.ident, @vi, @other)
    if ei < 0
        return 0 - 1
    if enum_variant_kind(sm.pctx, ei, vi) != ENUM_VARIANT_UNIT
        return 0 - 1
    ei

# The user enum `e` evaluates to, if any: 1 and its name in out_name/out_len.
fn eai_enum_of(sm: *Sema, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    if e == null
        return 0
    var ei: i32 = 0 - 1
    if eai_resolve(sm, e, out_name, out_len) == 1
        ei = enum_find(sm.pctx, StrView { ptr: (*out_name), len: (*out_len) as i64 })
    else
        ei = eai_bare_unit(sm, e)
        if ei >= 0
            *out_name = enum_name_at(sm.pctx, ei, out_len)
    (ei >= 0 and enum_is_generic(sm.pctx, ei) == 0) as i32

# sema_walk, at the start of each fn: its notes are its own (a generic's
# instances share their declarations).
pub fn eai_begin_fn()
    g_eai_notes_ready = 0

# sema_walk, after binding an unannotated `let` / `var`: the enum its
# initialiser is, if any.
pub fn eai_note_decl(sm: *Sema, st: *Stmt)
    if st.var_declared_type != TypeKind.Void or st.var_init == null or st.var_name.ptr == null
        return
    var en: *u8 = null
    var en_len: i32 = 0
    if eai_enum_of(sm, st.var_init, @en, @en_len) == 0
        return
    if g_eai_notes_ready == 0
        g_eai_notes = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_eai_notes = hashmap_i64_with_cap(256)
        g_eai_note_lens = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_eai_note_lens = hashmap_i64_with_cap(256)
        g_eai_notes_ready = 1
    (*g_eai_notes).insert(st.var_name.ptr as i64, en as i64)
    (*g_eai_note_lens).insert(st.var_name.ptr as i64, en_len as i64)

# =============================================================================
# The report
# =============================================================================

# `e` where an integer of type kind `want` is expected: report it at
# line:col if `e` is an enum.  `want` that is no integer kind is no check.
fn eai_check(sm: *Sema, e: *Expr, want: TypeKind, line: i32, col: i32)
    eai_check_arg(sm, e, want, line, col, StrView { ptr: (null), len: (0) as i64 }, 0)

# eai_check, for argument `argno` of `fname` when `fname` isn't null: ritz0
# says "argument N of `f`: " first (#3340).
fn eai_check_arg(sm: *Sema, e: *Expr, want: TypeKind, line: i32, col: i32, fname_sv: StrView, argno: i32)
    var fname: *u8 = fname_sv.ptr
    if ty_bits(want) == 0
        return
    var en: *u8 = null
    var en_len: i32 = 0
    if eai_enum_of(sm, e, @en, @en_len) == 0
        return
    diag_error_at(sm.file, diag_span(line, col))
    if fname != null
        eprint("argument {argno as i64} of `")
        eprint_bytes(fname_sv)
        eprints("`: ")
    eprints("expected ")
    eprints_cstr(ty_name(want))
    eprints(", found enum '")
    narrow_eprint_name(StrView { ptr: (en), len: (en_len) as i64 })
    eprints("'; convert with `as`\n")
    sm.error_count = sm.error_count + 1

fn eai_check_at(sm: *Sema, e: *Expr, want: TypeKind)
    if e != null
        eai_check(sm, e, want, e.span.line, e.span.col)

# =============================================================================
# Target and parameter types
# =============================================================================

# Type kind of field `f` of the struct local / pointer-to-struct local `name`.
fn eai_local_field_type(sm: *Sema, name_sv: StrView, f_sv: StrView) -> TypeKind
    var len: i32 = name_sv.len as i32
    let v: *SemaVar = sema_find_local(sm, name_sv)
    if v == null or v.type_name == null or v.type_name_len <= 0
        return TypeKind.NarrowUnknown
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    if st == null
        return TypeKind.NarrowUnknown
    let idx: i32 = find_field_index(st, f_sv)
    if idx < 0
        return TypeKind.NarrowUnknown
    let field: *StructField = get_field_type(st, idx)
    narrow_known(field.field_type)

# Type kind of an assignment target expression, or TypeKind.NarrowUnknown.
fn eai_target_type(sm: *Sema, t: *Expr) -> TypeKind
    if t == null
        return TypeKind.NarrowUnknown
    match t.kind
        ExprKind.Ident =>
            return narrow_sema_name_type(sm, t.ident)
        ExprKind.Member =>
            # A field's type is always written.
            var ft: SemaTy
            let fk: TypeKind = sema_expr_ty(sm, t, @ft)
            if fk != TypeKind.Unknown
                return narrow_known(fk)
            return narrow_sema_member_type(sm, t)
        _ => pass
    TypeKind.NarrowUnknown

# The type a method call's receiver dispatches on, as method_recv_type: a
# local's or global's type, a field's, else (a bare name) the type itself.
fn eai_recv_type(sm: *Sema, recv: *Expr) -> StrView
    if recv == null
        return strview_empty()
    match recv.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, recv.ident)
            if v != null
                return StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }
            let g: *GlobalVarDef = sbk_global(sm, recv.ident)
            if g != null
                return StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 }
            return recv.ident
        ExprKind.Member =>
            var t: SemaTy
            if sema_expr_ty(sm, recv, @t) == TypeKind.Unknown
                return strview_empty()
            return StrView { ptr: (t.name), len: (t.name_len) as i64 }
        _ => pass
    strview_empty()

# The fn a method call dispatches to (UFCS helper, impl method or
# specialised generic impl method), as method_call_def; or null.
fn eai_method_fn(sm: *Sema, e: *Expr) -> *FnDef
    let tname: StrView = eai_recv_type(sm, e.left)
    if tname.ptr == null or tname.len <= 0
        return null
    sema_method_fn(sm, tname, e.ident)

# 1 for `T.m(..)`, a static call of `m`: the receiver names a type, no value,
# and `m` takes no `self` (a UFCS helper's first param isn't named self, but
# its receiver is a value).
fn eai_static_call(sm: *Sema, e: *Expr, m: *FnDef) -> i32
    let r: *Expr = e.left
    if r == null or r.kind != ExprKind.Ident or param_is_self(m.params) == 1
        return 0
    if sema_find_local(sm, r.ident) != null
        return 0
    if sbk_global(sm, r.ident) != null
        return 0
    1

# =============================================================================
# The check
# =============================================================================

# Each argument of a call / method call against its parameter, then every
# sub-expression (the same walk as let_check_expr).
pub fn enum_as_int_expr(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Unary =>
            enum_as_int_expr(sm, e.operand)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            enum_as_int_expr(sm, e.left)
            enum_as_int_expr(sm, e.right)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try =>
            enum_as_int_expr(sm, e.left)
        ExprKind.Call | ExprKind.Method =>
            # Numbered as call_check's cc_method numbers them (#3319): a method call
            # is `m(r, ..)`, its receiver argument 1; a static call has none.
            var p: *Param = null
            var fname: *u8 = e.func_name.ptr
            var flen: i32 = e.func_name.len as i32
            var argno: i32 = 1
            if k == ExprKind.Method
                enum_as_int_expr(sm, e.left)
                fname = e.ident.ptr
                flen = e.ident.len as i32
                let m: *FnDef = eai_method_fn(sm, e)
                if m != null
                    p = m.params
                    if p != null and eai_static_call(sm, e, m) == 0
                        p = p.next   # the receiver
                        argno = 2
            else
                let f: *FnDef = eai_call_fn(sm, e)
                if f != null
                    p = f.params
            var a: *Expr = e.args
            while a != null
                enum_as_int_expr(sm, a)
                if p != null
                    eai_check_arg(sm, a, p.param_type, a.span.line, a.span.col, StrView { ptr: (fname), len: (flen) as i64 }, argno)
                    p = p.next
                a = a.next
                argno = argno + 1
        _ => pass

# A fn / method's trailing expression, returned as `ret_type`.
pub fn enum_as_int_tail(sm: *Sema, e: *Expr, ret_type: TypeKind)
    enum_as_int_expr(sm, e)
    eai_check_at(sm, e, ret_type)

# One statement, before it is walked.  `ret_type` is the fn's return type.
pub fn enum_as_int_stmt(sm: *Sema, stmt: *Stmt, ret_type: TypeKind)
    let k: StmtKind = stmt.kind
    let line: i32 = stmt.span.line
    let col: i32 = stmt.span.col
    match k
        StmtKind.VarDecl =>
            enum_as_int_expr(sm, stmt.var_init)
            eai_check(sm, stmt.var_init, stmt.var_declared_type, line, col)
            return
        StmtKind.TupleDecl =>
            enum_as_int_expr(sm, stmt.var_init)
            return
        StmtKind.Return =>
            enum_as_int_expr(sm, stmt.return_value)
            eai_check_at(sm, stmt.return_value, ret_type)
            return
        StmtKind.Assign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            enum_as_int_expr(sm, stmt.assign_value)
            var want: TypeKind = TypeKind.NarrowUnknown
            match k
                StmtKind.Assign =>
                    if stmt.assign_target.len > 0
                        # `x = v` / `x op= v`: the target is a bare name.
                        want = narrow_sema_name_type(sm, stmt.assign_target)
                    else
                        want = eai_target_type(sm, stmt.if_cond as *Expr)
                StmtKind.LocalFieldAssign =>
                    # `name.f = v`
                    want = eai_local_field_type(sm, stmt.var_name, stmt.assign_target)
                StmtKind.MemberAssign =>
                    # `p.f = v`, the pointer expression in if_cond.
                    let pe: *Expr = stmt.if_cond as *Expr
                    if pe != null and pe.kind == ExprKind.Ident
                        want = eai_local_field_type(sm, pe.ident, stmt.assign_target)
                _ => pass
            if want != TypeKind.NarrowUnknown
                eai_check(sm, stmt.assign_value, want, line, col)
            return
        _ => pass
    match k
        StmtKind.Expr =>
            enum_as_int_expr(sm, stmt.expr)
        StmtKind.If | StmtKind.Assert =>
            enum_as_int_expr(sm, stmt.if_cond)
        StmtKind.While =>
            enum_as_int_expr(sm, stmt.while_cond)
        StmtKind.For =>
            enum_as_int_expr(sm, stmt.for_start)
            enum_as_int_expr(sm, stmt.for_end)
        _ => pass
