# ritz1/src/no_effect.ritz - a statement with no effect (LARB R64; AGAST #3492)
#
# LANGUAGE_SPEC §6.6.  An expression whose value is discarded must do
# something.  When its outermost node is a literal, name, field, index,
# borrow, `*p`, cast, aggregate literal or operator, it computes a value and
# throws it away:
#
#     t.ritz:<line>:<col>: error: statement has no effect: the value of `<expr>` is discarded
#
# A string on its own line is the commonest case, a print that was never
# written, so its message adds a hint (the 259 lost zeus "FAIL: …" lines,
# AGAST #3490).  Calls, assignments and `if`/`match`/blocks are allowed; a
# discarded `[[must_use]]` call is must_use.ritz's (§17.8).
#
# LARB R69 (AGAST #3968 / #3997): a block has a value only when it is used as
# one.  The last line of a void fn, a loop body, a statement `if` branch or a
# statement `match` arm is discarded like any other statement, so `_ => 0` in
# a statement match is refused; a do-nothing arm is `_ => pass`.
#
# The message shows the expression as written, the capability ritz0's
# no_effect.py already had (its _Source.text).  A SrcSpan carries only a line
# and a column, so this re-reads the source and walks the logical line: to the
# next newline outside brackets, a `#` comment, a bracket the expression did
# not open, or an inline `if` arm's `else`; quotes and `\` escapes are
# honoured, runs of whitespace collapse.  When the text cannot be recovered
# the node kind's name stands in, as ritz0 does.
#
# Two traps, both ritz0's:
#   * `pass` is the no-op (an ExprKind.IntLit marked LIT_PASS), never refused;
#   * a whole array alone is discarded_array.ritz's, a more specific message
#     at the same positions, so this one stays quiet there.
#
# Sema walks exactly the statements the emitter lowers: sema_walk calls
# no_effect_check for a StmtKind.Expr with a next statement, for the tail of a fn
# or method that returns nothing, and — R69 — for the tail of a block that is
# no value and for a statement `if` / `match`'s arm values.  It takes
# `sm: *Sema`, never an EmitterState (tools/test_ritz1_emitter_check_freeze.py).

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.string

import ast
import ritzlib.fd
import ast_helpers
import sema
import sema_type
import deref_field

# Read `path` whole.  The error path only, so a re-read per report is fine.
fn ne_read_file(path: StrView) -> Vec<u8>
    var buf: Vec<u8> = vec_new<u8>()
    if path.len == 0
        return buf
    var file: Fd = fd_open(path, O_RDONLY, 0).unwrap_or(fd_adopt(-1))
    if not file.valid()
        return buf
    var chunk: [8192]u8
    let chunk_ptr: *u8 = @chunk[0]
    var n: i64 = 1
    while n > 0
        n = file.read(Span<u8> { ptr: chunk_ptr, len: 8192 }).unwrap_or(0)
        if n > 0
            buf.push_bytes(chunk_ptr, n)
    file.close()
    buf

fn ne_is_start(ch: u8) -> i32
    if ch >= 'A' and ch <= 'Z'
        return 1
    if ch >= 'a' and ch <= 'z'
        return 1
    if ch == '_'
        return 1
    0

fn ne_is_word_char(ch: u8) -> i32
    if ne_is_start(ch) == 1
        return 1
    if ch >= '0' and ch <= '9'
        return 1
    0

# Python's str.split() whitespace, which the contract's `<expr>` collapses on.
fn ne_is_space(ch: u8) -> i32
    if ch == ' ' or ch == 9 or ch == 10 or ch == 11 or ch == 12 or ch == 13
        return 1
    0

# The start of a word at `pos` in `text`: a letter or `_`, not preceded by a
# word char.
fn ne_word_start(text: StrView, pos: i64) -> bool
    if ne_is_start(text.get(pos)) == 0
        return false
    pos == 0 or ne_is_word_char(text.get(pos - 1)) == 0

# Collapse runs of whitespace, as ritz0's _Source._joined does.
fn ne_collapse(raw: @String) -> String
    var out: String = string_new()
    var have: i32 = 0
    var pending: i32 = 0
    var i: i64 = 0
    let n: i64 = raw.len()
    while i < n
        let ch: u8 = raw.get(i)
        if ne_is_space(ch) == 1
            if have == 1
                pending = 1
        else
            if pending == 1
                out.push(32)
                pending = 0
            out.push(ch)
            have = 1
        i += 1
    out

# The source text of the expression starting at `line`:`col`, or an empty
# String when it cannot be recovered.  Ported from ritz0/no_effect.py's
# _Source.text: the logical line, from the span to where the expression ends.
fn ne_text(file: StrView, line: i32, col: i32) -> String
    var out: String = string_new()
    if file.len == 0 or line < 1 or col < 1
        return out
    let src: Vec<u8> = ne_read_file(file)
    if src.len == 0
        return out
    let text: StrView = src.as_view()
    # Byte offset `line` starts at (SrcSpan lines are 1-based).
    var pos: i64 = 0
    var ln: i32 = 1
    while ln < line and pos < src.len
        if text.get(pos) == 10
            ln += 1
        pos += 1
    if ln != line or pos >= src.len
        return out
    pos += (col - 1) as i64
    if pos >= src.len
        return out
    var raw: String = string_new()
    var depth: i32 = 0
    var quote: i32 = 0
    var open_ifs: i32 = 0
    var done: i32 = 0
    while pos < src.len and done == 0
        let ch: u8 = text.get(pos)
        if ch == 10
            # End of the logical line: a new one only inside brackets.
            if depth <= 0
                done = 1
            else
                raw.push(32)
            pos += 1
        else if quote != 0
            raw.push(ch)
            if ch == '\\' and pos + 1 < src.len
                # A `\` escape keeps its next byte.
                pos += 1
                raw.push(text.get(pos))
            else if (ch as i32) == quote
                quote = 0
            pos += 1
        else if ch == '"' or ch == '\''
            quote = ch as i32
            raw.push(ch)
            pos += 1
        else if ch == '#'
            # A `#` comment ends the expression.
            done = 1
        else if depth == 0 and (ch == ')' or ch == ']' or ch == '}')
            # Closes a group the expression sits in: `(if c then ^x)`.
            done = 1
        else
            if depth == 0 and ne_word_start(text, pos)
                let wstart: i64 = pos
                pos += 1
                while pos < src.len and ne_is_word_char(text.get(pos)) == 1
                    pos += 1
                let word: StrView = text.slice(wstart, pos)
                if word.eq("else") and open_ifs == 0
                    # An inline `if` arm's end: `if c then ^x else y`.
                    done = 1
                else
                    if word.eq("if")
                        open_ifs += 1
                    else if word.eq("else")
                        open_ifs -= 1
                    raw.push_str(word)
            else
                if ch == '(' or ch == '[' or ch == '{'
                    depth += 1
                if ch == ')' or ch == ']' or ch == '}'
                    depth -= 1
                raw.push(ch)
                pos += 1
    let collapsed: String = ne_collapse(@raw)
    collapsed

fn ne_is_string_kind(k: ExprKind) -> i32
    if k == ExprKind.StringLit or k == ExprKind.CstringLit
        return 1
    0

# ritz0's fallback: the node kind's class name, when the text is lost.
fn ne_kind_name(k: ExprKind) -> StrView
    match k
        ExprKind.IntLit =>
            return "IntLit"
        ExprKind.FloatLit =>
            return "FloatLit"
        ExprKind.NilLit =>
            return "NullLit"
        ExprKind.StringLit =>
            return "StringLit"
        ExprKind.CstringLit =>
            return "CStringLit"
        ExprKind.CharLit =>
            return "CharLit"
        ExprKind.Ident =>
            return "Ident"
        ExprKind.Member =>
            return "Field"
        ExprKind.Index =>
            return "Index"
        ExprKind.Cast =>
            return "Cast"
        ExprKind.StructLit =>
            return "StructLit"
        ExprKind.ArrayLit =>
            return "ArrayLit"
        ExprKind.ArrayFill =>
            return "ArrayFill"
        ExprKind.Binary =>
            return "BinOp"
        ExprKind.Unary =>
            return "UnaryOp"
        ExprKind.Range =>
            return "Range"
        _ => pass
    "Expr"

# 1 when `e` is a place holding a whole array: a local or global `[N]T`, a
# `:& [N]T` param, an array field or `*p` of a `*[N]T`.  ritz0's typing pass
# reports these with "a whole array is not a value here" at the same span
# (type_refs._check_discarded), so this rule stays quiet: in ritz1
# discarded_array.ritz reports the field and the emitter the rest, and a Sema
# error would stop the compile before the emitter could.  Only the three
# shapes ritz0's _check_discarded covers (AGAST #3189, #3054).
fn ne_whole_array_place(sm: *Sema, e: *Expr, k: ExprKind) -> i32
    match k
        ExprKind.Ident =>
            if sema_expr_type(sm, e) == TypeKind.Array
                return 1
            # A `:& [N]T` param reads as the array; its binding is untyped.
            let v: *SemaVar = sema_find_local(sm, e.ident)
            if v != null and v.lent != null
                if v.lent.param_type == TypeKind.Array or v.lent.param_pointee_type == TypeKind.Array
                    return 1
            return 0
        ExprKind.Member =>
            let f: *StructField = df_member_field(sm, e)
            if f != null and f.field_type == TypeKind.Array
                return 1
            return 0
        _ => pass
    if k == ExprKind.Unary and e.op == OpKind.Deref
        var o: SemaTy
        sema_expr_ty(sm, e.operand, @o)
        if o.pointee == TypeKind.Array or o.kind == TypeKind.Array
            return 1
        return 0
    0

# 1 when `e`, a discarded expression, may not be: its outermost node computes
# a value and throws it away (R64).  `pass` and a whole array are excepted.
fn ne_refused(sm: *Sema, e: *Expr, k: ExprKind) -> i32
    match k
        ExprKind.IntLit =>
            if e.lit_kind == LIT_PASS
                return 0
            return 1
        ExprKind.FloatLit | ExprKind.NilLit =>
            return 1
        ExprKind.StringLit | ExprKind.CstringLit | ExprKind.CharLit =>
            return 1
        ExprKind.Ident =>
            # ritz0's _Judge.discarded lets a bound `pass` through as it
            # lets the no-op through.
            if e.ident.eq("pass")
                return 0
            if ne_whole_array_place(sm, e, k) == 1
                return 0
            return 1
        ExprKind.Index | ExprKind.Cast =>
            return 1
        ExprKind.Member =>
            # A whole array is discarded_array.ritz's more specific message, at
            # the same position; this one stays quiet there (trap 6).
            if ne_whole_array_place(sm, e, k) == 1
                return 0
            return 1
        ExprKind.StructLit | ExprKind.ArrayLit | ExprKind.ArrayFill =>
            return 1
        ExprKind.Binary | ExprKind.Unary | ExprKind.Range =>
            # `*p` of a `*[N]T` is a whole array place (trap 6).
            if k == ExprKind.Unary and ne_whole_array_place(sm, e, k) == 1
                return 0
            return 1
        _ => pass
    0

# Report `e`, whose value is discarded, if it has no effect.
pub fn no_effect_check(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    if ne_refused(sm, e, k) == 0
        return
    let file: StrView = sema_file(sm)
    var text: String = ne_text(file, e.span.line, e.span.col)
    sema_error_at(sm, e.span.line, e.span.col)
    eprints("statement has no effect: the value of `")
    if text.len() == 0
        eprints(ne_kind_name(k))
    else
        eprint_string(@text)
    eprints("` is discarded")
    if ne_is_string_kind(k) == 1
        eprints("; a string on its own line prints nothing: call print")
    eprints("\n")

# LARB R69 (AGAST #3968 / #3997): `e`, a discarded statement's expression,
# judged through an `if` / `match` expression's arms (`if c then ^x else 0`),
# as ritz0's _Judge.discarded judges a dropped one's.  Only for a statement's
# own expression: sema_walk_arms judges the arms of one nested in a discarded
# arm.
pub fn no_effect_check_value(sm: *Sema, e: *Expr)
    if e == null
        return
    if e.kind != ExprKind.If and e.kind != ExprKind.Match
        no_effect_check(sm, e)
        return
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        if arm.is_pass == 0
            no_effect_check_value(sm, arm.body)
        arm = arm.next
