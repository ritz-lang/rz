# ritz1/src/ast_query.ritz - pure AST and name queries (AGAST #3513)
#
# Helpers that read only the AST (including its enum nodes), the primitive
# type table (types) and a caller-supplied struct map: no
# EmitterState, no Sema, no emitter global.  They lived in emitter_core until
# #3513 (LARB F5, #1816), which made every Sema module import the emitter for
# `name_eq` and its kin.  Sema
# and the check modules import this module; emitter_core `pub import`s it, so
# an emitter module still reaches every one of them through emitter_core.
#
# #4319 and #4391 moved more of the pure half here, so the Checks modules that
# read it (enum_as_int, literal_slot, call_check, own_check, ref_value) import
# no emitter module: the data-only `LocalVar`, `OwnPath` and `ArrayDims` types
# the Sema side builds an image of a local in, and the pure helpers that fill
# or read them (array dimensions, local placement, struct pointer levels, the
# variant-constructor queries).  Nothing here reads or holds an EmitterState.
#
# Nothing here may import an emitter* or sema* module
# (tools/test_ritz1_emitter_check_freeze.py).

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.hash       # fnv1a_str (struct_map_find)
import ritzlib.hashmap    # HashMapI64
import ritzlib.str        # memcmp (array_elem_types_match, param_is_span)
import ritzlib.strview    # strview_eq (name_eq)

import ast
import types
import ast_helpers   # enum_find / enum_variant_* (AGAST #1660)


# AGAST #4404: N.  Sema's annotation on an Expr (ast.ritz's Expr.sema_ty),
# encoded kind + 2 so the parser arena's zeroing means "not annotated".
# sema_walk notes it for every expression it reaches; the emitter reads it
# through expr_sema_ty rather than re-deriving a type from EmitterState.
pub fn expr_note_sema_ty(e: *Expr, k: TypeKind)
    if e == null
        return
    e.sema_ty = (k as i32) + 2

# The TYPE_* kind Sema gave `e`, or TypeKind.Unknown when it did not annotate it
# (null, or a node the walk never reached).  1 not 2 -- see expr_note_sema_ty.
pub fn expr_sema_ty(e: *Expr) -> TypeKind
    if e == null
        return TypeKind.Unknown
    if e.sema_ty == 0
        return TypeKind.Unknown
    type_kind_of(e.sema_ty - 2)

# 1 when Sema annotated `e` (its answer may still be TypeKind.Unknown).
pub fn expr_has_sema_ty(e: *Expr) -> i32
    (e != null and e.sema_ty != 0) as i32

# AGAST #4404: the slot type a node fixes by itself -- the arms of the
# emitter's old get_expr_type that never read EmitterState: literals, a
# cast's written target, a comparison's i64 bool slot (AGAST #3931 / #1646),
# and `@` / `@&` / `not` / `~`.  TypeKind.Unknown for the kinds whose slot needs
# Sema's scope; those are typed by sema_slot_ty (AGAST #4410).
pub fn expr_local_slot_ty(e: *Expr) -> TypeKind
    if e == null
        return TypeKind.Unknown
    let k: ExprKind = e.kind
    match k
        ExprKind.IntLit =>
            return TypeKind.I64
        ExprKind.FloatLit =>
            return TypeKind.F64
        ExprKind.CharLit =>
            return TypeKind.U8
        ExprKind.StringLit =>
            return TypeKind.Struct   # bare "..." is a StrView (AGAST #98)
        ExprKind.CstringLit | ExprKind.NilLit =>
            return TypeKind.Ptr
        ExprKind.Cast =>
            # Target type stored in e.op (set by expr_cast).
            return e.type_kind
        _ => pass
    if k == ExprKind.Binary and op_is_comparison(e.op)
        return TypeKind.I64
    if k == ExprKind.Unary
        match e.op
            OpKind.Addr =>
                return TypeKind.Ptr
            OpKind.AddrMut =>
                return TypeKind.MutRef
            OpKind.Not | OpKind.BitNot =>
                return TypeKind.I64
            _ => pass
    TypeKind.Unknown

# The slot type the emitter reads (#4404): Sema's annotation from its walk,
# else the node-local answer for a node built after the walk -- a print
# placeholder's parsed expression (`{x as i64}`) never meets Sema.
pub fn expr_slot_ty(e: *Expr) -> TypeKind
    if e == null
        return TypeKind.Unknown
    if e.sema_ty != 0
        return type_kind_of(e.sema_ty - 2)
    expr_local_slot_ty(e)

# Helper to check if name matches a string.  The one i32 (0/1) compare
# retained for the ~500 call sites that test `== 0` / `== 1`; the bytes are
# compared by ritzlib.strview's strview_eq.
pub fn name_eq(name_sv: StrView, target_sv: StrView) -> i32
    if name_sv.eq(target_sv)
        return 1
    0

pub fn eprint_bytes(p_sv: StrView)
    var p: *u8 = p_sv.ptr
    var len: i32 = p_sv.len as i32
    for i in 0..len
        eprint_char(*(p + i))

# Find field index in a struct (returns -1 if not found)
pub fn find_field_index(st: *StructDef, field_sv: StrView) -> i32
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, field_sv) == 1
            return idx
        idx += 1
        f = f.next
    -1

# Get field type from struct definition
pub fn get_field_type(st: *StructDef, field_idx: i32) -> *StructField
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if idx == field_idx
            return f
        idx += 1
        f = f.next
    null

# 1 if `name` is the mangled symbol `<ib.type_name>_<method.name>`.
pub fn impl_method_symbol_eq(ib: *ImplBlock, method: *FnDef, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let type_len: i32 = ib.type_name_len
    if type_len + 1 + method.name_len != len
        return 0
    for mj in 0..type_len
        if *(ib.type_name + mj) != *(name + mj)
            return 0
    if *(name + type_len) != '_'  # '_'
        return 0
    for mk in 0..method.name_len
        if *(method.name + mk) != *(name + type_len + 1 + mk)
            return 0
    1

# The impl method (with a body) whose mangled `Type_method` symbol is `name`,
# or null.  R10: `C_g(c)` names the method `c.g()` calls (AGAST #2447). A method defined by this .ll (is_local == 1) is preferred over an
# imported copy of the same symbol.
pub fn find_impl_method_by_symbol(m: *Module, name_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var found: *FnDef = null
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            if method.body != null and impl_method_symbol_eq(ib, method, StrView { ptr: (name), len: (len) as i64 }) == 1
                if method.is_local == 1
                    return method
                if found == null
                    found = method
            method = method.next
        ib = ib.next
    found

# A fn that yields no value: no return type, or `-> void` (AGAST #2246).
pub fn fn_is_procedure(fd: *FnDef) -> i32
    if fd == null or fd.return_type != TypeKind.Void
        return 0
    1

# Is this name a primitive integer/float/bool type? Used in several places
# where post-monomorphization a generic `T` has been substituted with a
# primitive but the AST still carries TypeKind.Struct — we must NOT emit `%u16`
# struct references or `{ i8 }` fallback decls for those names.
pub fn is_primitive_type_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"i16"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"u16"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"i32"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"u32"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"i64"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"u64"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"f32"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"f64"), len: (3) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"bool"), len: (4) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"usize"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"isize"), len: (5) as i64 }) == 1
        return 1
    0

# AGAST #167: SIMD vector type names (`v4i32`, `v16i8`, etc).  ritz0 treats
# these as builtin types in name_resolver.BUILTIN_TYPES.  ritz1's parser
# accepts them as struct-name annotations; without explicit recognition they
# fall through to the `%v4i32 = type { i8 }` fallback decl, breaking the
# stride for `simd_*` builtins which must produce/consume real LLVM `<N x iM>`
# vectors.  Returns 1 for all SSE2 (128-bit) and AVX2 (256-bit) name shapes
# the cryptosec / squeeze libs use.
pub fn is_simd_vector_type_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i8"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i16"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i32"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v32i8"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i16"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i32"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i64"), len: (5) as i64 }) == 1
        return 1
    0

# Returns 1 if the type name refers to a tagged-enum instantiation
# (`Result$...` or `Option$...`).  After ritz-task-133 these are lowered to a
# real LLVM struct `{ i8, [P x i8], [N x i8] }` (ritz0's layout, #1898) rather
# than the old packed-i64 representation.  Callers that emit payload load /
# store paths still key off this predicate to decide between "scalar slot"
# and "tagged-enum aggregate slot" code shapes.
pub fn is_tagged_enum_type(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name_len >= 7
        # "Result$" = 82 101 115 117 108 116 36
        if *(name + 0) == 'R'
            if *(name + 1) == 'e'
                if *(name + 2) == 's'
                    if *(name + 3) == 'u'
                        if *(name + 4) == 'l'
                            if *(name + 5) == 't'
                                if *(name + 6) == '$'
                                    return 1
        # "Option$" = 79 112 116 105 111 110 36
        if *(name + 0) == 'O'
            if *(name + 1) == 'p'
                if *(name + 2) == 't'
                    if *(name + 3) == 'i'
                        if *(name + 4) == 'o'
                            if *(name + 5) == 'n'
                                if *(name + 6) == '$'
                                    return 1
    return 0

# AGAST #1596: the element kind for indexing THROUGH a pointer-typed struct
# field (`s.data[i]` with `data: *T` or `**T`). `**T` elements are pointers;
# a `*Struct` element is TypeKind.Struct (spelled `%T` from field_type_name);
# primitive pointees (integers, since #2053 f32 / f64, and since #2063 bool)
# come from array_elem_type (#1304); their in-memory spelling is
# ptr_field_elem_llvm.  Anything else (an unrecorded pointee, a non-pointer
# field) is TypeKind.Unknown: ritz1 cannot address it at the right width, so
# callers must fail closed rather than guess a stride.  bool is an `i1`
# everywhere since #2063 (a local `[N]bool` kept i64 slots, so a `*bool`
# had no single stride).
pub fn ptr_field_elem_kind(field: *StructField) -> TypeKind
    if field.field_type == TypeKind.PtrPtr
        return TypeKind.Ptr
    if field.field_type != TypeKind.Ptr
        return TypeKind.Unknown
    if field.field_type_name_len > 0
        return TypeKind.Struct
    let t: TypeKind = field.array_elem_type
    if ty_int_in(t, 8, 16) == 1
        return t
    if ty_int_in(t, 32, 64) == 1
        return t
    if t == TypeKind.F32 or t == TypeKind.F64 or t == TypeKind.Bool
        return t
    return TypeKind.Unknown

# Width in bits a scalar type code is stored at (see tagged_enum_scalar_bits).
pub fn type_code_scalar_bits(t: TypeKind, signed: *i32) -> i32
    *signed = 1
    match t
        TypeKind.I8 =>
            return 8
        TypeKind.I16 =>
            return 16
        TypeKind.I32 =>
            return 32
        _ => pass
    *signed = 0
    match t
        TypeKind.U8 | TypeKind.Bool =>
            return 8
        TypeKind.U16 =>
            return 16
        TypeKind.U32 =>
            return 32
        _ => pass
    *signed = 1
    64

# Tracker index of the non-generic user enum `name`, or -1.
pub fn user_enum_index(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0 - 1
    let ei: i32 = enum_find(ctx, StrView { ptr: (name), len: (len) as i64 })
    if ei < 0
        return 0 - 1
    if enum_is_generic(ctx, ei) == 1
        return 0 - 1
    ei

# AGAST #1295: a variant SELECTOR names one payload field of a user enum's
# variant: `vi + k * VARIANT_FIELD_STRIDE` is field k of variant vi.  Field 0
# is the variant's plain index, so every caller that knew only single-field
# variants (and Result/Option's 0 / 1) passes the same value it always did.
# Only the payload helpers take a selector -- never a tag store or compare.
pub const VARIANT_FIELD_STRIDE: i32 = 65536

pub fn variant_sel(vi: i32, k: i32) -> i32
    vi + k * VARIANT_FIELD_STRIDE

# AGAST #1295: the payload selector of the binding `arm` has selected
# (arm_select_bind) in user enum `name`: field pattern_field_sel of the
# variant it names.  -1 when `name` declares no such variant.
pub fn arm_variant_sel(ctx: *ParseCtx, name_sv: StrView, arm: *MatchArm) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let vi: i32 = enum_variant_index(ctx, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    if vi < 0
        return vi
    variant_sel(vi, arm.pattern_field_sel)

# The payload field selector `sel` (variant_sel) names in user enum `name`:
# field k of a tuple variant, or of a struct variant matched / built
# positionally (docs/ENUM_VARIANTS.md: same layout).  Null when there is none:
# a unit variant, a generic or unknown enum, k past the last field.
pub fn user_enum_tuple_field(ctx: *ParseCtx, name_sv: StrView, sel: i32) -> *StructField
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ei: i32 = user_enum_index(ctx, StrView { ptr: (name), len: (len) as i64 })
    if ei < 0 or sel < 0
        return null
    let vi: i32 = sel % VARIANT_FIELD_STRIDE
    var k: i32 = sel / VARIANT_FIELD_STRIDE
    if vi >= enum_variant_count(ctx, ei)
        return null
    let kind: i32 = enum_variant_kind(ctx, ei, vi)
    if kind != ENUM_VARIANT_TUPLE and kind != ENUM_VARIANT_STRUCT
        return null
    var f: *StructField = enum_variant_fields(ctx, ei, vi)
    while f != null and k > 0
        f = f.next
        k -= 1
    f

# AGAST #1797: the user enum a call `Holds(x)` constructs — a payload
# variant of a non-generic enum (AGAST #1295: any field count), resolved as try_emit_user_variant_ctor
# does (it wins over a same-named fn, as in ritz0).  null/0 otherwise.
# AGAST #1610: also a unit variant called with no arguments, `Red()` (built
# with no payload; it used to fall through to a fn call returning i64).
# AGAST #2039: a name two enums declare is no ctor here (null): the caller,
# try_emit_user_variant_ctor, reports it via user_variant_ctor_ambiguous.
pub fn user_variant_ctor_enum(ctx: *ParseCtx, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != ExprKind.Call
        return
    var vi: i32 = 0
    var other: i32 = 0
    let ei: i32 = enum_of_variant_unique(ctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @vi, @other)
    if ei < 0
        return
    let kind: i32 = enum_variant_kind(ctx, ei, vi)
    if kind == ENUM_VARIANT_UNIT
        if e.args != null
            return
    else if kind == ENUM_VARIANT_TUPLE or kind == ENUM_VARIANT_STRUCT
        # AGAST #1295: one value per field, `Rect(w, h)`, a struct variant's
        # positionally; emit_variant_build checks the count, located.
        if e.args == null
            return
    else
        return
    *out_name = enum_name_at(ctx, ei, out_len)

# AGAST #3995: the user enum a call constructs whatever its slot, for the two
# typers (get_expr_type, Sema's sema_call_ty): user_variant_ctor_enum, less
# a variant named Some / Ok / Err / None, whose call is the builtin Option /
# Result one unless the slot is the user's enum (users_variant_wins).
pub fn user_enum_ctor_call(ctx: *ParseCtx, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != ExprKind.Call
        return
    let n: *u8 = e.func_name
    let l: i32 = e.func_name_len
    if name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
        return
    user_variant_ctor_enum(ctx, e, out_name, out_len)

# The dims of `sh` from dimension `from` inward, and its leaf, as a shape of
# their own: `[3][4]T` from 1 of `[2][3][4]T`.  AGAST #3379: a plane a `for`
# binds, too.
pub fn nd_shape_from(sh: *ArrayShape, from: i32) -> *ArrayShape
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    out.rank = sh.rank - from
    var i: i32 = 0
    while i < out.rank
        out.dims[i] = sh.dims[from + i]
        i = i + 1
    out

# AGAST #2570: how many leaves a `[M][N]..T` holds, M*N..: the size of the flat
# `[M*N..]T` a plane pointer is, so `q + k` strides k whole planes.
pub fn shape_leaf_count(sh: *ArrayShape) -> i32
    var n: i32 = 1
    var i: i32 = 0
    while i < sh.rank
        n = n * sh.dims[i]
        i = i + 1
    n

# AGAST #1965: 1 when `e` is a float literal or a negated one (`-2.5`, which
# #1959 lowers as `fneg double`).  Both are `double`, narrowable to f32.
pub fn is_float_lit_operand(e: *Expr) -> i32
    if e.kind == ExprKind.FloatLit
        return 1
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg
        return is_float_lit_operand(e.operand)
    # AGAST #3607: literals only, `0.0 - 7.0`, is a literal too (ritz0's
    # FloatLitType): it takes the other side's width, and is never an f64
    # meeting an f32.
    if e.kind == ExprKind.Binary and (e.op == OpKind.Add or e.op == OpKind.Sub or e.op == OpKind.Mul or e.op == OpKind.Div)
        return (is_float_lit_operand(e.left) == 1 and is_float_lit_operand(e.right) == 1) as i32
    return 0

# AGAST #2308: the scalar T of a `-> @T` / `-> @&T` fn, or TypeKind.Void.
pub fn ret_ref_scalar_pointee(f: *FnDef) -> TypeKind
    if f == null or f.ret_ref == null or primitive_name_len(f.ret_ref.param_pointee_type) == 0
        return TypeKind.Void
    return f.ret_ref.param_pointee_type

# The volatile and atomic memory builtins (LANGUAGE_SPEC §18.4-§18.5, AGAST
# #1879); emitter_core lowers them.
const MEM_VOLATILE_LOAD: i32 = 1
const MEM_VOLATILE_STORE: i32 = 2
const MEM_ATOMIC_LOAD: i32 = 3
const MEM_ATOMIC_STORE: i32 = 4
const MEM_ATOMIC_XCHG: i32 = 5
const MEM_ATOMIC_CMPXCHG: i32 = 6
const MEM_ATOMIC_ADD: i32 = 7
const MEM_ATOMIC_SUB: i32 = 8
const MEM_ATOMIC_AND: i32 = 9
const MEM_ATOMIC_OR: i32 = 10
const MEM_ATOMIC_XOR: i32 = 11
const MEM_FENCE: i32 = 12

# The MEM_* id of a builtin name, 0 for any other name.
pub fn mem_builtin_id(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"volatile_load"), len: (13) as i64 }) == 1
        return MEM_VOLATILE_LOAD
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"volatile_store"), len: (14) as i64 }) == 1
        return MEM_VOLATILE_STORE
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_load"), len: (11) as i64 }) == 1
        return MEM_ATOMIC_LOAD
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_store"), len: (12) as i64 }) == 1
        return MEM_ATOMIC_STORE
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_xchg"), len: (11) as i64 }) == 1
        return MEM_ATOMIC_XCHG
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_cmpxchg"), len: (14) as i64 }) == 1
        return MEM_ATOMIC_CMPXCHG
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_fetch_add"), len: (16) as i64 }) == 1
        return MEM_ATOMIC_ADD
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_fetch_sub"), len: (16) as i64 }) == 1
        return MEM_ATOMIC_SUB
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_fetch_and"), len: (16) as i64 }) == 1
        return MEM_ATOMIC_AND
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_fetch_or"), len: (15) as i64 }) == 1
        return MEM_ATOMIC_OR
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"atomic_fetch_xor"), len: (16) as i64 }) == 1
        return MEM_ATOMIC_XOR
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"fence"), len: (5) as i64 }) == 1
        return MEM_FENCE
    0

# =============================================================================
# Builtin constants (AGAST #4319, moved off emitter_core so the check modules
# that name them import no emitter module).
# =============================================================================

# The value of a well-known constant from ritzlib.sys, or -9999 for a name
# that is not one.
pub fn find_builtin_const(name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # STDIN, STDOUT, STDERR
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"STDIN"), len: (5) as i64 }) == 1
        return 0
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"STDOUT"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"STDERR"), len: (6) as i64 }) == 1
        return 2
    # O_RDONLY, O_WRONLY, O_RDWR
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"O_RDONLY"), len: (8) as i64 }) == 1
        return 0
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"O_WRONLY"), len: (8) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"O_RDWR"), len: (6) as i64 }) == 1
        return 2
    # Return a sentinel that means "not found"
    return -9999

pub fn is_builtin_const(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if find_builtin_const(StrView { ptr: (name), len: (len) as i64 }) != -9999
        return 1
    0

# =============================================================================
# Struct lookup (AGAST #4319, moved off emitter_core with tagged_enum_arg_in).
# =============================================================================

# find a struct definition by name over any fnv1a(name) -> first-StructDef map
# of `m`'s structs: the emitter's, or Sema's (AGAST #3505).
pub fn struct_map_find(map: *HashMapI64, m: *Module, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    let st: *StructDef = map.get(key) as *StructDef
    if st == null
        return null
    if name_eq(StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
        return st
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *StructDef = m.structs
    while cur != null
        if name_eq(StrView { ptr: (cur.name), len: (cur.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return cur
        cur = cur.next
    return null

# =============================================================================
# Tagged-enum mangled arguments (AGAST #4319, moved off emitter_core).
# =============================================================================

# Arity of the generic one `$`-component of a mangled name names: Result 2,
# Option 1, a generic struct or enum template its parameter count; 0 for a leaf
# (primitive, concrete struct, pointer to a leaf).  `ptr_` prefixes are
# skipped: `ptr_Vec$u8` is one argument.
fn te_component_arity(ctx: *ParseCtx, structs: *HashMapI64, m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var p: *u8 = name
    var n: i32 = len
    var k0: i32 = mangled_ref_prefix(StrView { ptr: (p), len: (n) as i64 })
    while k0 > 0
        p = p + k0
        n = n - k0
        k0 = mangled_ref_prefix(StrView { ptr: (p), len: (n) as i64 })
    if name_eq(StrView { ptr: (p), len: (n) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        return 2
    if name_eq(StrView { ptr: (p), len: (n) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        return 1
    let st: *StructDef = struct_map_find(structs, m, StrView { ptr: (p), len: (n) as i64 })
    if st == null
        # AGAST #3021: a generic enum template's parameter count, so
        # `Option$Slot$i32` splits into Option's one argument `Slot$i32`.
        return enum_type_param_count(ctx, enum_find(ctx, StrView { ptr: (p), len: (n) as i64 }))
    if st.type_params == null
        return 0
    var k: i32 = 0
    var tp: *TypeParam = st.type_params
    while tp != null
        k = k + 1
        tp = tp.next
    k

# End (exclusive) of the mangled type argument starting at buf[pos]: its
# first component plus one nested argument per generic parameter.
fn te_arg_end(ctx: *ParseCtx, structs: *HashMapI64, m: *Module, buf_sv: StrView, pos: i32) -> i32
    var buf: *u8 = buf_sv.ptr
    var len: i32 = buf_sv.len as i32
    var end: i32 = pos
    while end < len and *(buf + end) != '$'   # '$'
        end = end + 1
    let arity: i32 = te_component_arity(ctx, structs, m, StrView { ptr: (buf + pos), len: (end - pos) as i64 })
    var k: i32 = 0
    while k < arity
        if end >= len
            return end
        end = te_arg_end(ctx, structs, m, StrView { ptr: (buf), len: (len) as i64 }, end + 1)
        k = k + 1
    end

# The mangled type argument a tagged-enum variant carries: variant 0 is T
# (Ok / Some), variant 1 is Result's E.  null (out_len 0) for Option's None,
# a non-tagged name, or a name that does not split into exactly its
# arguments.  `Result$Vec$u8$i32`, variant 0 -> `Vec$u8`, 1 -> `i32`.
#
# The EmitterState wrapper (tagged_enum_arg) stays in emitter_core.
pub fn tagged_enum_arg_in(ctx: *ParseCtx, structs: *HashMapI64, m: *Module, name_sv: StrView, variant: i32, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_len = 0
    if name == null or is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        return null
    let start: i32 = 7
    if start >= len
        return null
    let is_result: i32 = name_eq(StrView { ptr: (name), len: (6) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 })
    let end0: i32 = te_arg_end(ctx, structs, m, StrView { ptr: (name), len: (len) as i64 }, start)
    if is_result == 0
        if variant != 0 or end0 != len
            return null
        *out_len = end0 - start
        return name + start
    if end0 + 1 >= len
        return null
    let e_start: i32 = end0 + 1
    let e_end: i32 = te_arg_end(ctx, structs, m, StrView { ptr: (name), len: (len) as i64 }, e_start)
    if e_end != len
        return null
    if variant == 0
        *out_len = end0 - start
        return name + start
    if variant != 1
        return null
    *out_len = e_end - e_start
    return name + e_start

# =============================================================================
# The local and ownership-path images the Sema-side checks read (AGAST #4391)
# =============================================================================
#
# LocalVar is the emitter's record of a local; ref_check builds the image of one
# for a Sema binding (rs_default_loc, ref_local_in), and the checks type their
# places from it (call_check, own_check, ref_value).  OwnPath is what
# own_check reads from ownership through that image.  The two structs and the
# variant-constructor queries lived in emitter_core / emitter_expr_call (#4376,
# #4391); moved here so those Checks modules import no emitter module.  This is
# data only: no EmitterState, no Sema.  #3514 deletes the side channels the
# image itself is made of.
#
# AGAST #4406: every field left is read by lowering (a slot's name/reg, the
# type facts the emitter types with, and the binding flags it decides on).
# The two that only a Sema check read -- a `:&` param's caller-place flag and
# an `@*U` / `@&*U` binding's pointee -- are gone; Sema keeps them on
# ref_check's RsNote (caller_place, ptr_pointee).

# AGAST #4528: an emitter array view.  A non-null `LocalVar.view` marks one:
# the `p#` / `#k` binding that shares a slot holding a `[N]T`'s address.
# `base` is the place an unscoped view (base_array_view) reads; null for a
# view a binding owns.
struct ArrayView
    base: *Expr

# AGAST #4035/#4528: the emitter's record of a local is its name, its slot and
# its `*TypeRef`; only the binding-mode/refinement state lowering mutates is
# kept beside them.  Every type fact is answered from the chain by the `lv_*`
# getters below, which are the LocalVar form of the `tr_*` accessors
# (types.ritz / ast_helpers.ritz).
struct LocalVar
    name: *u8
    name_len: i32
    reg: i32
    # The local's type: built from the flat facts add_local_full receives.
    # 17 flat facts lived here until #4528; tr_*/lv_* answer them now.
    ty: *TypeRef
    # AGAST #1521: 1 for a local declared `: bool`. emit_var_decl stores bools
    # in an i64 slot, so the chain alone cannot say (its kind is TypeKind.I64).
    is_bool: i32
    # AGAST #2342/#4280 refinement bits, see LV_BK_*.
    bk: i32
    # AGAST #2028: 1 for a `let` binding (set by emit_stmt from Stmt.var_is_let).
    # add_local_full clears it, so a `var`, param, range loop or match binding
    # that shadows a `let` is mutable.  See let_check.ritz.
    is_let: i32
    # AGAST #2250/#2286/#2278 binding-mode bits, see LV_LENT_*.
    lent: i32
    # AGAST #2407: 1 when the binding certainly holds no fn value.
    not_fn: i32
    # AGAST #2330/#2329: non-null for an array view (p# / #k); see ArrayView.
    view: *ArrayView
    # AGAST #3579: 1 for an unannotated `let v = "..."` / `var v = "..."`.
    str_view: i32

# AGAST #4280: bk bits.
const LV_BK_UNSURE: i32 = 1
const LV_BK_PTR: i32 = 2
# AGAST #2250/#2286/#2278: lent bits.
const LV_LENT: i32 = 1
const LV_LENT_HOLDS_PTR: i32 = 2
const LV_LENT_SELF: i32 = 4

pub fn lv_bk_unsure(v: *LocalVar) -> i32
    ((v.bk & LV_BK_UNSURE) != 0) as i32

pub fn lv_bk_ptr(v: *LocalVar) -> i32
    ((v.bk & LV_BK_PTR) != 0) as i32

pub fn lv_set_bk_unsure(v: *LocalVar, x: i32)
    if x != 0
        v.bk = v.bk | LV_BK_UNSURE
    else
        v.bk = v.bk & (0 - 1 - LV_BK_UNSURE)

pub fn lv_set_bk_ptr(v: *LocalVar, x: i32)
    if x != 0
        v.bk = v.bk | LV_BK_PTR
    else
        v.bk = v.bk & (0 - 1 - LV_BK_PTR)

pub fn lv_is_lent(v: *LocalVar) -> i32
    ((v.lent & LV_LENT) != 0) as i32

pub fn lv_holds_lent_ptr(v: *LocalVar) -> i32
    ((v.lent & LV_LENT_HOLDS_PTR) != 0) as i32

pub fn lv_is_lent_self(v: *LocalVar) -> i32
    ((v.lent & LV_LENT_SELF) != 0) as i32

pub fn lv_set_is_lent(v: *LocalVar, x: i32)
    if x != 0
        v.lent = v.lent | LV_LENT
    else
        v.lent = v.lent & (0 - 1 - LV_LENT)

pub fn lv_set_holds_lent_ptr(v: *LocalVar, x: i32)
    if x != 0
        v.lent = v.lent | LV_LENT_HOLDS_PTR
    else
        v.lent = v.lent & (0 - 1 - LV_LENT_HOLDS_PTR)

pub fn lv_set_is_lent_self(v: *LocalVar, x: i32)
    if x != 0
        v.lent = v.lent | LV_LENT_SELF
    else
        v.lent = v.lent & (0 - 1 - LV_LENT_SELF)

# =============================================================================
# The LocalVar type facts, answered from `ty` (AGAST #4528)
# =============================================================================

fn lv_tyref(kind: TypeKind) -> *TypeRef
    let t: *TypeRef = malloc(sizeof(TypeRef)) as *TypeRef
    memset(t as *u8, 0, sizeof(TypeRef))
    t.kind = kind
    t.ref_inner = TypeKind.Void
    return t

# lv_tyref for a leaf that records inner-pointee slot `slot` (tr_set_slot).
fn lv_tyref_slot(slot: i32) -> *TypeRef
    let t: *TypeRef = lv_tyref(TypeKind.Void)
    tr_set_slot(t, slot)
    return t

# 1 for a kind a pointer chain continues through.
fn lv_is_ptr_kind(k: TypeKind) -> i32
    (k == TypeKind.Ptr or k == TypeKind.PtrPtr or k == TypeKind.Ref or k == TypeKind.MutRef) as i32

# The name the just-built array element `e` carries, from a flat type name.
# A `[N]S` names S on the element; a `[N]*S` / `[N]@S` names it on the
# pointee, which is what tr_elem_name reads.
fn lv_name_into_elem(e: *TypeRef, name: *u8, name_len: i32)
    if e == null or name == null or name_len <= 0
        return
    if e.kind == TypeKind.Struct
        e.name = name
        e.name_len = name_len
        return
    if lv_is_ptr_kind(e.kind) == 1
        if e.pointee == null
            e.pointee = lv_tyref(TypeKind.Struct)
        e.pointee.name = name
        e.pointee.name_len = name_len
        return
    e.name = name
    e.name_len = name_len

# Build the chain an add_local_full's flat arguments describe.  Depth is kept
# at the two levels the flat model had (`**T` is PTR_PTR -> PTR), so
# tr_ptr_ptr_inner_pointee reads the leaf kind exactly as the flat field did.
pub fn lv_ty_from_flat(var_type: TypeKind, type_name_sv: StrView, pointee: TypeKind, arr_size: i32, arr_elem: TypeKind) -> *TypeRef
    var name: *u8 = type_name_sv.ptr
    var name_len: i32 = type_name_sv.len as i32
    let t: *TypeRef = lv_tyref(var_type)
    # AGAST #4528: the flat type_name is carried on the top node, whatever its
    # kind.  It is a fact the flat model kept even when the kind was the
    # parser's default (a generic's `V` at `*E` names E but has pointee I64),
    # and the checks read it as such.
    t.name = name
    t.name_len = name_len
    if var_type == TypeKind.Array
        t.count = arr_size as i64
        t.elem = lv_tyref(arr_elem)
        # The flat pointee_type of an array local: TypeKind.I64 for a plain
        # `[N]T`, TypeKind.Array for a `a:& [N]T` borrow bound as an array local.
        # The whole-array lowering reads it (`array_ptr_local`, #2305).
        t.pointee = lv_tyref(pointee)
        return t
    if lv_is_ptr_kind(var_type) == 1
        t.pointee = lv_tyref(pointee)
        if var_type == TypeKind.Ref or var_type == TypeKind.MutRef
            t.ref_inner = pointee
        if var_type == TypeKind.PtrPtr and pointee == TypeKind.Ptr
            t.pointee.pointee = lv_tyref(TypeKind.Void)
        else if (var_type == TypeKind.Ref or var_type == TypeKind.MutRef) and pointee == TypeKind.Ptr
            t.pointee.pointee = lv_tyref(TypeKind.Void)
        else if pointee == TypeKind.Array
            t.pointee.elem = lv_tyref(TypeKind.Void)
        return t
    return t

# The LocalVar add_local_full makes, and the image ref_check builds for a Sema
# binding (AGAST #4391).  Clears every field, then records the name and type.
pub fn lv_loc_init(loc: *LocalVar, name_sv: StrView, var_type: TypeKind, type_name_sv: StrView, pointee: TypeKind, arr_size: i32, arr_elem: TypeKind)
    memset(loc as *u8, 0, sizeof(LocalVar))
    loc.name = name_sv.ptr
    loc.name_len = name_sv.len as i32
    loc.ty = lv_ty_from_flat(var_type, type_name_sv, pointee, arr_size, arr_elem)

# The flat kind of the local (was LocalVar.var_type).
pub fn lv_var_type(v: *LocalVar) -> TypeKind
    tr_flat(v.ty)

# The local's own array node (a by-value `[N]T`), null otherwise.
fn lv_own_array(v: *LocalVar) -> *TypeRef
    if v.ty != null and v.ty.kind == TypeKind.Array
        return v.ty
    null

pub fn lv_array_size(v: *LocalVar) -> i32
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return 0
    tr_count(a) as i32

pub fn lv_array_elem_type(v: *LocalVar) -> TypeKind
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return TypeKind.Void
    tr_elem_kind(a)

pub fn lv_array_elem_pointee(v: *LocalVar) -> TypeKind
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return TypeKind.Void
    tr_elem_pointee(a)

pub fn lv_array_shape(v: *LocalVar) -> *ArrayShape
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return null
    tr_shape(a)

pub fn lv_array_rec(v: *LocalVar) -> *ArrayElem
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return null
    a.array_rec

# The name / length the flat type_name(_len) pair held: the top node's name.
pub fn lv_name(v: *LocalVar, out_len: *i32) -> *u8
    if v.ty == null
        *out_len = 0
        return null
    *out_len = v.ty.name_len
    v.ty.name

pub fn lv_name_len(v: *LocalVar) -> i32
    if v.ty == null
        return 0
    v.ty.name_len

# The pointer-only forms, for the many sites that read name and length as a
# pair without an out-parameter.
pub fn lv_type_name(v: *LocalVar) -> *u8
    if v.ty == null
        return null
    v.ty.name

pub fn lv_type_name_len(v: *LocalVar) -> i32
    lv_name_len(v)

pub fn lv_pointee_array_elem_name0(v: *LocalVar) -> *u8
    var l: i32 = 0
    lv_pointee_array_elem_name(v, @l)

pub fn lv_pointee_array_elem_name_len(v: *LocalVar) -> i32
    var l: i32 = 0
    lv_pointee_array_elem_name(v, @l)
    l

pub fn lv_pointee_type(v: *LocalVar) -> TypeKind
    if v.ty == null
        return TypeKind.Void
    # A reference records its referent's flat kind in ref_inner (`@T` -> T,
    # `@*T` -> TypeKind.Ptr); the flat pointee_type was that value.  A pointer's
    # is its immediate pointee.
    if v.ty.kind == TypeKind.Ref or v.ty.kind == TypeKind.MutRef
        return tr_ref_inner(v.ty)
    tr_pointee_kind(v.ty)

pub fn lv_inner_pointee_type(v: *LocalVar) -> i32
    tr_var_inner_pointee(v.ty)

pub fn lv_inner_ref(v: *LocalVar) -> i32
    tr_inner_ref(v.ty)

# The fn signature of the local's type (was LocalVar.fn_sig).
pub fn lv_fn_sig(v: *LocalVar) -> *FnDef
    var t: *TypeRef = v.ty
    while t != null
        if t.fn_sig != null
            return t.fn_sig
        if t.elem != null
            t = t.elem
        else
            t = t.pointee
    null

# The `[N]T` a pointer / reference names (`*[N]T`, `**[N]T`, `@*[N]T`,
# `@[N]T`), or null.  The flat pointee_array_* facts described this node.
fn lv_pa_node(v: *LocalVar, create: i32) -> *TypeRef
    let t: *TypeRef = v.ty
    if t == null
        return null
    # A by-value array local records its flat pointee_type too: a `:& [N]T`
    # borrow is bound as an array local whose pointee is the array (#2305).
    match t.kind
        TypeKind.Array =>
            if t.pointee != null and t.pointee.kind == TypeKind.Array
                return t.pointee
            return null
        TypeKind.Ptr =>
            if t.pointee == null
                if create == 0
                    return null
                t.pointee = lv_tyref(TypeKind.Array)
            if t.pointee.kind == TypeKind.Array
                return t.pointee
            return null
        TypeKind.PtrPtr =>
            if t.pointee == null
                if create == 0
                    return null
                t.pointee = lv_tyref(TypeKind.Ptr)
            if t.pointee.kind == TypeKind.Ptr
                if t.pointee.pointee == null
                    if create == 0
                        return null
                    t.pointee.pointee = lv_tyref(TypeKind.Array)
                if t.pointee.pointee.kind == TypeKind.Array
                    return t.pointee.pointee
            return null
        TypeKind.Ref | TypeKind.MutRef =>
            if t.pointee != null and t.pointee.kind == TypeKind.Array
                return t.pointee
            if t.ref_inner == TypeKind.Ptr
                if t.pointee == null
                    if create == 0
                        return null
                    t.pointee = lv_tyref(TypeKind.Ptr)
                if t.pointee.kind == TypeKind.Ptr
                    if t.pointee.pointee == null
                        if create == 0
                            return null
                        t.pointee.pointee = lv_tyref(TypeKind.Array)
                    if t.pointee.pointee.kind == TypeKind.Array
                        return t.pointee.pointee
            return null
        _ => pass
    null

pub fn lv_pointee_array_size(v: *LocalVar) -> i32
    let a: *TypeRef = lv_pa_node(v, 0)
    if a == null
        return 0
    tr_count(a) as i32

pub fn lv_pointee_array_elem_type(v: *LocalVar) -> TypeKind
    let a: *TypeRef = lv_pa_node(v, 0)
    if a == null
        return TypeKind.Void
    tr_elem_kind(a)

pub fn lv_pointee_array_elem_pointee(v: *LocalVar) -> TypeKind
    let a: *TypeRef = lv_pa_node(v, 0)
    if a == null
        return TypeKind.Void
    tr_elem_pointee(a)

pub fn lv_pointee_array_elem_name(v: *LocalVar, out_len: *i32) -> *u8
    let a: *TypeRef = lv_pa_node(v, 0)
    if a == null
        *out_len = 0
        return null
    tr_elem_name(a, out_len)

pub fn lv_pointee_array_shape(v: *LocalVar) -> *ArrayShape
    let a: *TypeRef = lv_pa_node(v, 0)
    if a == null
        return null
    tr_shape(a)

# =============================================================================
# The setters lowering uses where it used to assign a flat field (AGAST #4528)
# =============================================================================

pub fn lv_set_var_type(v: *LocalVar, k: TypeKind)
    if v.ty == null
        v.ty = lv_tyref(k)
    else
        v.ty.kind = k

# Set the name tr_name answers: the first struct node, else the deepest node's.
pub fn lv_set_type_name(v: *LocalVar, name: *u8, name_len: i32)
    if v.ty == null
        return
    v.ty.name = name
    v.ty.name_len = name_len

pub fn lv_set_pointee_type(v: *LocalVar, k: TypeKind)
    if v.ty == null
        v.ty = lv_tyref(TypeKind.Ptr)
    if v.ty.pointee == null
        v.ty.pointee = lv_tyref(k)
    else
        v.ty.pointee.kind = k
    if v.ty.kind == TypeKind.Ref or v.ty.kind == TypeKind.MutRef
        v.ty.ref_inner = k

pub fn lv_set_array_size(v: *LocalVar, n: i32)
    let a: *TypeRef = lv_own_array(v)
    if a != null
        a.count = n as i64

pub fn lv_set_array_elem_type(v: *LocalVar, k: TypeKind)
    let a: *TypeRef = lv_own_array(v)
    if a == null
        return
    if a.elem == null
        a.elem = lv_tyref(k)
    else
        a.elem.kind = k

# E for `[N]*E` and its kin: the element's pointee fact tr_elem_pointee reads.
pub fn lv_set_array_elem_pointee(v: *LocalVar, k: TypeKind)
    let a: *TypeRef = lv_own_array(v)
    if a == null or a.elem == null
        return
    let e: *TypeRef = a.elem
    match e.kind
        TypeKind.Ptr =>
            if e.pointee == null
                e.pointee = lv_tyref(k)
            else
                e.pointee.kind = k
        TypeKind.PtrPtr =>
            if e.pointee == null
                e.pointee = lv_tyref(TypeKind.Ptr)
            if e.pointee.pointee == null
                e.pointee.pointee = lv_tyref(k)
            else
                e.pointee.pointee.kind = k
        TypeKind.Ref | TypeKind.MutRef =>
            e.ref_inner = k
        _ => pass

pub fn lv_set_array_shape(v: *LocalVar, sh: *ArrayShape)
    let a: *TypeRef = lv_own_array(v)
    if a != null
        a.shape = sh

pub fn lv_set_array_rec(v: *LocalVar, rec: *ArrayElem)
    let a: *TypeRef = lv_own_array(v)
    if a != null
        a.array_rec = rec

# The innermost pointee of a `**T` (the flat inner_pointee_type).  The chain
# is kept at two pointer levels, so the leaf kind is exactly the flat value.
pub fn lv_set_inner_pointee_type(v: *LocalVar, k: i32)
    if v.ty == null
        return
    var slot: *TypeRef = v.ty
    if slot.kind == TypeKind.Ref or slot.kind == TypeKind.MutRef
        # `@*T` / `@&*T` records T as a `**T` does: it is the pointee of the
        # pointer the reference wraps (tr_pointee_kind(ty.pointee)).
        if slot.ref_inner == TypeKind.Ptr
            if slot.pointee == null
                slot.pointee = lv_tyref(TypeKind.Ptr)
            if slot.pointee.pointee == null
                slot.pointee.pointee = lv_tyref_slot(k)
            else
                tr_set_slot(slot.pointee.pointee, k)
            return
        if slot.ref_inner == TypeKind.PtrPtr
            slot = slot.pointee
        else
            return
    if slot == null or slot.kind != TypeKind.PtrPtr
        return
    # The flat inner_pointee_type is independent of the flat pointee_type, and
    # an inferred copy (`let z = p`, p: ***C) left the latter at its parser
    # default.  The chain needs the PTR level for tr_ptr_ptr_inner_pointee to
    # read the leaf back, so make it here.
    if slot.pointee == null
        slot.pointee = lv_tyref(TypeKind.Ptr)
    else if slot.pointee.kind != TypeKind.Ptr
        slot.pointee.kind = TypeKind.Ptr
    if slot.pointee.pointee == null
        slot.pointee.pointee = lv_tyref_slot(k)
    else
        tr_set_slot(slot.pointee.pointee, k)

pub fn lv_set_inner_ref(v: *LocalVar, r: i32)
    if v.ty != null
        v.ty.inner_ref = r

pub fn lv_set_fn_sig(v: *LocalVar, sig: *FnDef)
    if v.ty != null
        v.ty.fn_sig = sig

# Ensure the `[N]T` node the pointee_array_* facts describe exists.
fn lv_pa_ensure(v: *LocalVar) -> *TypeRef
    let a: *TypeRef = lv_pa_node(v, 1)
    if a != null and a.elem == null
        a.elem = lv_tyref(TypeKind.Void)
    a

pub fn lv_set_pointee_array_size(v: *LocalVar, n: i32)
    let a: *TypeRef = lv_pa_ensure(v)
    if a != null
        a.count = n as i64

pub fn lv_set_pointee_array_elem_type(v: *LocalVar, k: TypeKind)
    let a: *TypeRef = lv_pa_ensure(v)
    if a == null
        return
    if a.elem == null
        a.elem = lv_tyref(k)
    else
        a.elem.kind = k

pub fn lv_set_pointee_array_elem_pointee(v: *LocalVar, k: TypeKind)
    let a: *TypeRef = lv_pa_ensure(v)
    if a == null or a.elem == null
        return
    let e: *TypeRef = a.elem
    match e.kind
        TypeKind.Ptr =>
            if e.pointee == null
                e.pointee = lv_tyref(k)
            else
                e.pointee.kind = k
        TypeKind.PtrPtr =>
            if e.pointee == null
                e.pointee = lv_tyref(TypeKind.Ptr)
            if e.pointee.pointee == null
                e.pointee.pointee = lv_tyref(k)
            else
                e.pointee.pointee.kind = k
        TypeKind.Ref | TypeKind.MutRef =>
            e.ref_inner = k
        _ => pass

pub fn lv_set_pointee_array_elem_name(v: *LocalVar, name: *u8, name_len: i32)
    let a: *TypeRef = lv_pa_ensure(v)
    if a == null or a.elem == null
        return
    lv_name_into_elem(a.elem, name, name_len)

pub fn lv_set_pointee_array_shape(v: *LocalVar, sh: *ArrayShape)
    let a: *TypeRef = lv_pa_ensure(v)
    if a != null
        a.shape = sh

# AGAST #2330/#2329: the view flag and base (was array_view / array_base).
pub fn lv_is_array_view(v: *LocalVar) -> i32
    (v.view != null) as i32

pub fn lv_array_base(v: *LocalVar) -> *Expr
    if v.view == null
        return null
    v.view.base

pub fn lv_set_array_view(v: *LocalVar, base: *Expr)
    if v.view == null
        v.view = malloc(sizeof(ArrayView)) as *ArrayView
        v.view.base = null
    v.view.base = base

pub fn lv_mark_array_view(v: *LocalVar)
    lv_set_array_view(v, null)

# AGAST #2242 — a path a binding's value can be moved out along: a move-only
# field of it, or of a field of it that can itself be partly moved.  A path's
# index in OwnBinding.paths is its bit in fmask (and in own_check.ritz's
# fmoved and fshadow).  `up` and `down` are path sets (ownership.ritz's
# own_set_*, AGAST #2319): the bitmask itself for paths 0..30, else an
# interned set's handle.
struct OwnPath
    parent: i32           # the path it is a part of, or -1 (the binding's own)
    idx: i32              # its field index in that struct
    fld: *StructField
    up: i32               # its bit, and those of the paths it is a part of
    down: i32             # its bit, and those of its parts

# AGAST #4391: a user enum variant-constructor query, moved from
# emitter_expr_call; the checks and the emitter both ask it.
pub fn is_variant_carrier(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name_len == 4
        # "Some"
        if *name == 'S' and *(name + 1) == 'o' and *(name + 2) == 'm' and *(name + 3) == 'e'
            return 1
    if name_len == 2
        # "Ok"
        if *name == 'O' and *(name + 1) == 'k'
            return 1
    return 0

pub fn is_variant_null(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name_len == 4
        # "None"
        if *name == 'N' and *(name + 1) == 'o' and *(name + 2) == 'n' and *(name + 3) == 'e'
            return 1
    if name_len == 3
        # "Err"
        if *name == 'E' and *(name + 1) == 'r' and *(name + 2) == 'r'
            return 1
    return 0

# =============================================================================
# Pure helpers the Sema check modules share with the emitter (AGAST #4391)
# =============================================================================
#
# Moved here from emitter_core / emitter_expr_call / emitter_stmt so
# call_check (and, below, own_check and ref_value) import no emitter module
# (#3513, #1816).  Emitter modules reach them through emitter_core's
# `pub import ast_query`, so no call site changed.

# =========================================================================
# The ident-only half of expr_is_ptr_valued: the shape `*x` / `*x = v` see.
# The integer kinds a `:&` borrow binds as a plain local (AGAST #1644).
pub fn is_borrow_scalar_kind(t: TypeKind) -> i32
    if ty_int_in(t, 8, 16) == 1
        return 1
    if ty_int_in(t, 32, 64) == 1
        return 1
    return 0

# =========================================================================
# array_ptr_elem_name: the S of a `*[N]S` / `**[N]S` local (AGAST
# #4391, moved from emitter_core).
# AGAST #2543: the S of `loc`, a `*[N]S` or `**[N]S` local or param, or null.
# #2548: every reader of a `*[N]S`'s element name asks here, not type_name, which
# a `*[N]S` or `**[N]S` local or param leaves empty (#2553).
pub fn array_ptr_elem_name(loc: *LocalVar, out_len: *i32) -> *u8
    var plen: i32 = 0
    let pn: *u8 = lv_pointee_array_elem_name(loc, @plen)
    if plen > 0
        *out_len = plen
        return pn
    lv_name(loc, out_len)

# =========================================================================
# The variant-constructor queries (AGAST #4391; moved from emitter_core).
# AGAST #4153: 1 when the call `e` names a variant of one user enum with a
# list user_variant_ctor_enum leaves to a fn of that name: values for a bare
# variant, `Z(1)`, or none for a payload one, `One()`.  *out_ei / *out_vi
# name the variant.  With no such fn it was "Unknown function: Z".
pub fn user_variant_ctor_miscounted(ctx: *ParseCtx, e: *Expr, out_ei: *i32, out_vi: *i32) -> i32
    if e == null or e.kind != ExprKind.Call
        return 0
    var other: i32 = 0
    let ei: i32 = enum_of_variant_unique(ctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, out_vi, @other)
    if ei < 0
        return 0
    *out_ei = ei
    let kind: i32 = enum_variant_kind(ctx, ei, *out_vi)
    if kind == ENUM_VARIANT_UNIT
        return (e.args != null) as i32
    if kind == ENUM_VARIANT_TUPLE or kind == ENUM_VARIANT_STRUCT
        return (e.args == null) as i32
    0

# AGAST #2039: a call `B()` / `Holds(x)` whose callee name two or more
# non-generic enums declare as a variant.  Returns 1 and fills *out_a /
# *out_b with the two enums to name (enum_of_variant_unique's -2), else 0.
pub fn user_variant_ctor_ambiguous(ctx: *ParseCtx, e: *Expr, out_a: *i32, out_b: *i32) -> i32
    if e == null or e.kind != ExprKind.Call
        return 0
    if enum_of_variant_unique(ctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, out_a, out_b) == 0 - 2
        return 1
    return 0

# =========================================================================
# Helper: find the leftmost/base expression in a chain of binary ops
# e.g., for (a.ptr + pos + i), returns a.ptr
pub fn find_base_expr(e: *Expr) -> *Expr
    if e.kind == ExprKind.Binary
        return find_base_expr(e.left)
    return e

# =========================================================================
# 1 when `p` takes an array by address: `a:& [N]T`, `a: @[N]T`, `a: @&[N]T`.
# `*[N]T` doesn't: ritz0 refuses `g(a)` there.
pub fn param_takes_array_ref(p: *Param) -> i32
    if p.param_type != TypeKind.Ref and p.param_type != TypeKind.MutRef
        return 0
    if p.param_pointee_type == TypeKind.Array
        return 1
    0

# =========================================================================
# 1 when `p` is a `Span<T>`: emit_expr_call builds one from a local array.
pub fn param_is_span(p: *Param) -> i32
    if p.param_type != TypeKind.Struct or p.param_type_name == null or p.param_type_name_len <= 4
        return 0
    return (memcmp(p.param_type_name, c"Span$", 5) == 0) as i32

# AGAST #3473 (LARB R57): the base of a view expression for a slice in a Span
# slot.  monomorph's slice_into_span_slot rewrites a Vec's `v[lo..hi]` there to
# `Span$T { ptr: v.data + lo, len: hi - lo }`; an unrewritten `v[lo..hi]` is
# left as its index.  Either way `v` is returned; the caller decides whether it
# is a Vec or String (a Span's slice views what the Span does, not the Span).
# Null when `e` is neither, or the view's `ptr` doesn't say what it views.
pub fn span_view_base(e: *Expr) -> *Expr
    if e == null
        return null
    if e.kind == ExprKind.Index
        if e.right != null and e.right.kind == ExprKind.Range
            return e.left
        return null
    if e.kind != ExprKind.StructLit or e.ident_ptr == null or e.ident_len <= 5
        return null
    if memcmp(e.ident_ptr, c"Span$", 5) != 0
        return null
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if fi.name_len == 3 and memcmp(fi.name, c"ptr", 3) == 0
            let v: *Expr = fi.value
            if v != null and v.kind == ExprKind.Binary and v.op == OpKind.Add and v.left != null
                if v.left.kind == ExprKind.Member and v.left.ident_len == 4 and memcmp(v.left.ident_ptr, c"data", 4) == 0
                    return v.left.left
            return null
        fi = fi.next
    null

# =========================================================================
# ArrayDims and the array-dimension helpers (AGAST #4391; moved from
# emitter_expr_call; call_check compares a place with its param through them).
# AGAST #2290: every dimension of an array, for comparing one with the array a
# reference param points at.  `leaf` is what the innermost dimension holds.
pub struct ArrayDims
    rank: i32
    dims: [8]i32
    leaf: TypeKind
    name: *u8
    name_len: i32

# What ref_arg_dims can say about an argument.
pub const ARG_DIMS_UNKNOWN: i32 = 0
pub const ARG_DIMS_ARRAY: i32 = 1
pub const ARG_DIMS_NOT_ARRAY: i32 = 2

pub fn array_dims_1d(out: *ArrayDims, size: i32, elem: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.rank = 1
    out.dims[0] = size
    out.leaf = elem
    out.name = name
    out.name_len = name_len
    ARG_DIMS_ARRAY

# The array left of `sh` once `from` indices are applied.  With none left it's
# an element.
pub fn array_dims_nd(out: *ArrayDims, sh: *ArrayShape, from: i32) -> i32
    if from >= sh.rank
        return ARG_DIMS_NOT_ARRAY
    out.rank = sh.rank - from
    var i: i32 = 0
    while i < out.rank
        out.dims[i] = sh.dims[from + i]
        i = i + 1
    out.leaf = sh.leaf_type
    out.name = sh.leaf_name
    out.name_len = sh.leaf_name_len
    ARG_DIMS_ARRAY

pub fn array_dims_match(a: *ArrayDims, b: *ArrayDims) -> i32
    if a.rank != b.rank
        return 0
    var i: i32 = 0
    while i < a.rank
        if a.dims[i] != b.dims[i]
            return 0
        i = i + 1
    return array_elem_types_match(a.leaf, StrView { ptr: (a.name), len: (a.name_len) as i64 }, b.leaf, StrView { ptr: (b.name), len: (b.name_len) as i64 })

# =========================================================================
# The impl a method belongs to, and the `self:&` borrow view (AGAST #4391;
# moved from emitter_expr_call).
# The ImplBlock whose methods hold `f`, or null.
pub fn impl_of_method(m: *Module, f: *FnDef) -> *ImplBlock
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            if method == f
                return ib
            method = method.next
        ib = ib.next
    null

# AGAST #3260: R10's free call `C_get(c)` of a method whose receiver is a bare
# `self:&`.  That receiver names no type: the method path and emit_impl_method
# take it from the ImplBlock, so the free call had none to give its argument,
# and emitted `call @C_get(% ..)`.  Here it's `f` with that receiver spelled
# `self:& C`, C the impl's, and lent as a `c:& C` param is, as ritz0 reads it:
# `C_get(c)` borrows c, and a temporary or a `let` is refused.  Any other `f`
# is itself.  A generic impl's instance is already named (name_untyped_self).
#
# AGAST #3278: a typed `self:& C`, and so a generic instance's bare `self:&`
# once name_untyped_self has named it, is lent the same way.  It's a
# TypeKind.MutRef without is_borrow (Param.is_self_borrow), which ref_check's
# ref_args and call_check's ca_borrow read as an `@&C` slot: `C_bump(c)` was "a value
# doesn't fit a reference slot".  ref_value.ritz (Sema) calls this for the free call too.
# lent_self_call_view over the module `m`: Sema's too (AGAST #4011).
pub fn lent_self_call_view_in(m: *Module, f: *FnDef) -> *FnDef
    if f == null or f.params == null
        return f
    let p: *Param = f.params
    if param_is_self(p) == 0 or p.is_self_borrow == 0 or p.is_borrow == 1
        return f
    var typed: i32 = 0
    if p.param_type == TypeKind.MutRef and p.param_type_name_len > 0
        typed = 1
    if typed == 0 and (p.param_type != TypeKind.Struct or p.param_type_name_len > 0)
        return f
    var ib: *ImplBlock = null
    if typed == 0
        ib = impl_of_method(m, f)
        if ib == null
            return f
    let lent: *Param = malloc(sizeof(Param)) as *Param
    memcpy(lent as *u8, p as *u8, sizeof(Param))
    if typed == 0
        lent.param_type = TypeKind.MutRef
        lent.param_pointee_type = TypeKind.Struct
        lent.param_type_name = ib.type_name
        lent.param_type_name_len = ib.type_name_len
    lent.is_borrow = 1
    let view: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    memcpy(view as *u8, f as *u8, sizeof(FnDef))
    view.params = lent
    view

# =========================================================================
# The array `p`, an `@[N]T` or the like, points at.
pub fn param_pointee_dims(out: *ArrayDims, p: *Param)
    if p.param_pointee_array_shape != null
        array_dims_nd(out, p.param_pointee_array_shape, 0)
    else
        array_dims_1d(out, p.param_pointee_array_size, p.param_pointee_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })

# =========================================================================
# 1 when two array element types name the same type (struct elements by name).
# Exactly the same type, through an address too: `[N]u32` doesn't fit a
# reference to `[N]i32`, though LLVM spells both `i32` (#2367).
pub fn array_elem_types_match(a: TypeKind, a_name_sv: StrView, b: TypeKind, b_name_sv: StrView) -> i32
    var a_name: *u8 = a_name_sv.ptr
    var a_len: i32 = a_name_sv.len as i32
    var b_name: *u8 = b_name_sv.ptr
    var b_len: i32 = b_name_sv.len as i32
    if a == TypeKind.Struct or b == TypeKind.Struct
        if a != b or a_len != b_len or a_len <= 0
            return 0
        return (memcmp(a_name, b_name, a_len as i64) == 0) as i32
    return (a == b) as i32

# =============================================================================
# Local-placement and struct-level helpers the checks share (AGAST #4391)
# =============================================================================
# Moved from emitter_core / emitter_expr for ref_value; emitter modules reach
# them through emitter_core's pub import.

# On the local `loc` bound for `param` (name_array_ptr_param, AGAST #4011: Sema's
# image of it too).
pub fn name_array_ptr_param_loc(loc: *LocalVar, param: *Param)
    let ptr_elem: bool = param.param_pointee_array_elem_type == TypeKind.Ptr and param.param_pointee_array_elem_pointee == TypeKind.Struct
    if param.param_pointee_array_size <= 0 or (param.param_pointee_array_elem_type != TypeKind.Struct and ptr_elem == false)
        return
    if param.param_pointee_type == TypeKind.Array and ptr_elem
        return
    if param.param_pointee_type != TypeKind.Array
        # AGAST #2331: and `@*[N]S` / `@&*[N]S`, as `**[N]S`.
        let ref_ptr: bool = (param.param_type == TypeKind.Ref or param.param_type == TypeKind.MutRef) and param.param_pointee_type == TypeKind.Ptr
        if ref_ptr == false and (param.param_type != TypeKind.PtrPtr or param.param_inner_pointee_type != (TypeKind.Array as i32))
            return
    if loc == null or lv_name_len(loc) <= 0
        return
    var tn_len: i32 = 0
    let tn: *u8 = lv_name(loc, @tn_len)
    lv_set_pointee_array_elem_name(loc, tn, tn_len)
    lv_set_type_name(loc, null, 0)

# AGAST #3074: 1 when the array behind `stmt`'s local holds S or `*S`.
pub fn names_array_elem_struct(stmt: *Stmt) -> i32
    if stmt.var_pointee_array_size <= 0
        return 0
    let elem: TypeKind = stmt.var_pointee_array_elem_type
    (elem == TypeKind.Struct or (elem == TypeKind.Ptr and stmt.var_pointee_array_elem_pointee == TypeKind.Struct)) as i32

# AGAST #2543: a `*[N]S`, `@[N]S`, `@&[N]S` or `**[N]S` local records S in
# pointee_array_elem_name, as such a param does (#2548).  It recorded none, so
# `let p = q` and `let p = *r`, which take S from what they copy, had none for
# `p#`, and `p[i].f` was refused "unhandled EXPR_MEMBER".
#
# AGAST #3074: an `@*[N]S` / `@&*[N]S` local (and `[N]*S`) is named through its
# var_ref, in type_name, which made `*r` a `*S`: `(*r).f` read element 0's f where
# ritz0 refuses it.  It moves to pointee_array_elem_name, as name_array_ptr_param does.
#
# AGAST #3104: and a `**[N]*S` local, which capture_var_type names as `@*[N]*S`.
pub fn name_array_ptr_local(loc: *LocalVar, stmt: *Stmt, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let deep_ptr: bool = ref_to_ptr(loc) == 1 or lv_var_type(loc) == TypeKind.PtrPtr
    if lv_name_len(loc) > 0 and deep_ptr and names_array_elem_struct(stmt) == 1
        var dn: i32 = 0
        let dname: *u8 = lv_name(loc, @dn)
        lv_set_pointee_array_elem_name(loc, dname, dn)
        lv_set_type_name(loc, null, 0)
        return
    if lv_name_len(loc) > 0 or name == null or len <= 0
        return
    if stmt.var_pointee_array_size <= 0 or stmt.var_pointee_array_elem_type != TypeKind.Struct
        return
    let t: TypeKind = lv_var_type(loc)
    let one: bool = (t == TypeKind.Ptr or t == TypeKind.Ref or t == TypeKind.MutRef) and stmt.var_pointee_type == TypeKind.Array
    # AGAST #3079: an `@*[N]S` / `@&*[N]S` (`let r = @q`) is as deep as a `**[N]S`.
    let deep: bool = t == TypeKind.PtrPtr or ((t == TypeKind.Ref or t == TypeKind.MutRef) and stmt.var_pointee_type == TypeKind.Ptr)
    let two: bool = deep and stmt.var_inner_pointee_type == (TypeKind.Array as i32)
    if one or two
        lv_set_pointee_array_elem_name(loc, name, len)

# AGAST #2331: 1 for an `@*T` or `@&*T` local.  It records N and U when T is
# `[N]U`: `*r` reads that `*[N]U`, as it does through a `**[N]U`.
pub fn ref_to_ptr(loc: *LocalVar) -> i32
    let t: TypeKind = lv_var_type(loc)
    if t != TypeKind.Ref and t != TypeKind.MutRef
        return 0
    (lv_pointee_type(loc) == TypeKind.Ptr) as i32

# AGAST #2403: pointers between a `self` param and its struct, as
# local_struct_levels counts a local's: 2 for `**S` and `@*S`.
pub fn self_struct_levels(p: *Param) -> i32
    match p.param_type
        TypeKind.PtrPtr =>
            return ptr_ptr_ident_levels(p.param_inner_pointee_type)
        TypeKind.Ref | TypeKind.MutRef =>
            match p.param_pointee_type
                TypeKind.Ptr =>
                    return 2
                TypeKind.PtrPtr =>
                    return 3
                _ => pass
            return 1
        TypeKind.Ptr =>
            return 1
        _ => pass
    0

# 1 for a `p:& **S` param, of any depth.
pub fn param_borrows_struct_ptr_ptr(p: *Param) -> i32
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef or p.param_pointee_type != TypeKind.PtrPtr
        return 0
    (ptr_ptr_slot_inner(p.param_inner_pointee_type) == TypeKind.Struct) as i32

# AGAST #1924: pointer levels of a `**S` local/param/field from its inner
# pointee slot: 3 for `***S`.  2 when the slot records nothing (the
# pre-#1924 assumption, kept for names whose depth was never recorded).
pub fn ptr_ptr_ident_levels(slot: i32) -> i32
    let lv: i32 = ptr_ptr_slot_levels(slot)
    if lv < 2
        return 2
    return lv

# AGAST #4596: whether a bare-name arm over enum `enum_name_sv` binds the
# scrutinee (§8.2): not a variant the enum declares (Option/Result's when no
# declaration is tracked), and not a qualified `C.G` (no span of its own).
# The emitter binds by it and Sema types the binding by it, so they agree.
pub fn arm_binds_enum_value(ctx: *ParseCtx, arm: *MatchArm, enum_name_sv: StrView) -> i32
    if arm.pattern_kind != PAT_IDENT or arm.pattern_span.line == 0
        return 0
    let name: StrView = StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }
    # A monomorphised `E$T` is declared as `E`.
    var base: i64 = 0
    while base < enum_name_sv.len and *(enum_name_sv.ptr + base) != '$'
        base = base + 1
    let ei: i32 = enum_find(ctx, StrView { ptr: (enum_name_sv.ptr), len: (base) })
    if ei >= 0
        for vi in 0..enum_variant_count(ctx, ei)
            var vlen: i32 = 0
            let vname: *u8 = enum_variant_name(ctx, ei, vi, @vlen)
            if name.eq(StrView { ptr: (vname), len: (vlen) as i64 })
                return 0
        return 1
    if name.eq("Some") or name.eq("None") or name.eq("Ok") or name.eq("Err")
        return 0
    1
