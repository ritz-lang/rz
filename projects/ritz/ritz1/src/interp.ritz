# ritz1/src/interp.ritz - the text half of print interpolation (AGAST #1521)
#
# `print("x={x}\n")` prints `x=5` in ritz0. ritz1 used to print `x={x}` and
# exit 0, because nothing in ritz1 knew about placeholders. This module has
# the rules for reading them. emitter_print.ritz does the lowering.
#
# The rules are ritz0's, copied rather than reinvented (ritz0/lexer.py
# `_lex_string` and emitter_llvmlite.py `_has_interp_placeholder`):
#
#   * `{` opens a placeholder only when a matching `}` follows before the
#     closing quote or end of line. Nested braces count, so `{a{b}}` is one.
#   * `{{` and `}}` are one literal brace each. A lone `}` is literal.
#   * `\{` and `\}` are literal braces (ritz1's lexer already cooks an
#     unknown escape to its own character).
#   * The text between the braces is trimmed, then lexed and parsed as one
#     expression. Empty or unparseable text is an error, not literal text.
#
# Placeholders belong to the print BUILTIN, not to the literal (#1374): a
# `"..."` or `c"..."` used anywhere else keeps its braces as plain bytes.
# ritz1's own emitter depends on that (`"={rax},{rax},{rdi}"` inline-asm
# constraints), so nothing here runs at lex or parse time.

import ritzlib.sys
import ritzlib.memory
import ritzlib.gvec
import tokens_gen
import lexer
import ast
import ast_helpers
import parser_gen

# Python's str.strip() whitespace, which ritz0 trims the expression with:
# space, \t, \n, \v, \f, \r.
fn interp_is_space(c: i32) -> i32
    if c == ' ' or (c >= 9 and c <= 13)
        return 1
    0

# `raw[open]` is a `{` in a "..." literal's raw source text. Return the index
# of the `}` that closes it, or -1 if the literal ends first (in which case
# the `{` is a literal brace). Stops at `"` and newline as ritz0's lexer
# does; the raw text cannot hold an unescaped `"`, so a `"` here is the
# second half of `\"`.
pub fn interp_match_brace(raw_sv: StrView, open: i32) -> i32
    var raw: *u8 = raw_sv.ptr
    var len: i32 = raw_sv.len as i32
    var depth: i32 = 1
    var j: i32 = open + 1
    while j < len
        let c: i32 = *(raw + j) as i32
        if c == '"' or c == 10
            return -1
        if c == '{'
            depth = depth + 1
        else if c == '}'
            depth = depth - 1
            if depth == 0
                return j
        j = j + 1
    -1

# Would this c"..." text have interpolated had it been a "..." literal?
# ritz0's `_has_interp_placeholder`, run on the cooked bytes. `{{` is not
# collapsed in a c-string, so it is skipped here as an escaped brace.
pub fn interp_cstr_has_placeholder(text_sv: StrView) -> i32
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    var i: i32 = 0
    while i < len
        if *(text + i) == '{'
            if i + 1 < len and *(text + i + 1) == '{'
                i = i + 2
                continue
            var depth: i32 = 1
            var j: i32 = i + 1
            while j < len
                let c: i32 = *(text + j) as i32
                if c == '{'
                    depth = depth + 1
                else if c == '}'
                    depth = depth - 1
                    if depth == 0
                        return 1
                j = j + 1
        i = i + 1
    0

# The throwaway parse arena: a base plus 1024 bytes per source byte, the
# "few 128-byte nodes per token" bound below (AGAST #1820: no magic sizes).
const INTERP_ARENA_BASE: i64 = 4096
const INTERP_ARENA_PER_BYTE: i64 = 1024

# Lex and parse one placeholder's text as an expression. Returns null if the
# trimmed text is empty or is not exactly one expression. Every token gets
# the print literal's line and column, so the nodes point at the literal.
#
# The copied text, the tokens and the AST nodes are never freed: AST
# identifiers point into them for the rest of the compile, the same as every
# other source buffer (see keep_source_alive in main.ritz).
pub fn interp_parse_expr(ctx: *ParseCtx, text_sv: StrView, line: i32, col: i32) -> *Expr
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    var lo: i32 = 0
    var hi: i32 = len
    while lo < hi and interp_is_space(*(text + lo) as i32) == 1
        lo = lo + 1
    while hi > lo and interp_is_space(*(text + hi - 1) as i32) == 1
        hi = hi - 1
    if hi == lo
        return null
    let n: i32 = hi - lo
    let src: *u8 = malloc((n + 1) as i64)
    if src == null
        return null
    var k: i32 = 0
    while k < n
        *(src + k) = *(text + lo + k)
        k = k + 1
    *(src + n) = 0

    # The same lexer main.ritz's tokenize() uses.
    var lex: Lexer
    lexer_init(@lex, StrView { ptr: (src), len: (n as i64) })

    var tokens: Vec<Token> = vec_new<Token>()
    loop
        var tok: Token = lexer_next(@lex)
        let kind: i32 = tok.kind
        if kind == TOK_ERROR
            return null
        tok.line = line
        tok.col = col
        tokens.push(tok)
        if kind == TOK_EOF
            break

    # parse_expr allocates a few 128-byte nodes per token; a token is at
    # least one byte of text, so this cannot run out.
    let arena: *u8 = malloc(INTERP_ARENA_BASE + (n as i64) * INTERP_ARENA_PER_BYTE)
    if arena == null
        return null
    parser_arena_set_cap(ctx, INTERP_ARENA_BASE + (n as i64) * INTERP_ARENA_PER_BYTE)   # AGAST #1730
    var p: Parser
    parser_init(@p, ctx, tokens.data, tokens.len as i32, arena)
    let e: *Expr = parse_expr(@p)
    if p.error != 0 or e == null
        return null
    # Exactly one expression: only the end of the text may follow it.
    while p_peek(@p) == TOK_NEWLINE or p_peek(@p) == TOK_DEDENT
        p_advance(@p)
    if p_peek(@p) != TOK_EOF
        return null
    e

# ---------------------------------------------------------------------------
# `{expr:spec}` format specs (AGAST #201, #198 Phase 2)
#
# A placeholder's spec is the text after its last top-level `:` -- not inside
# nested `()`, `[]`, `{}` or a string / char literal. Ritz has no `:`
# operator outside a struct literal's braces, so the split is unambiguous.
# The valid specs are ritzlib/fmt/spec.ritz `fmt_spec_parse`'s v1 set:
#
#     ?               Debug
#     <N  >N  ^N      left / right / centre in a width N
#     [0][N]R         R one of x X b o; a leading 0 needs a width N
#
# N is decimal digits, at most 4096. ritz0's twin is ritz0/interp_spec.py.

# Index of the last top-level `:` in a placeholder's raw text, or -1.
pub fn interp_spec_colon(text_sv: StrView) -> i32
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    var depth: i32 = 0
    var quote: i32 = 0
    var found: i32 = -1
    var i: i32 = 0
    while i < len
        let c: i32 = *(text + i) as i32
        if c == '\\'   # `\`: the next byte is escaped
            i = i + 2
            continue
        if quote != 0
            if c == quote
                quote = 0
        else if c == '"' or c == '\''   # `"` `'`
            quote = c
        else if c == '(' or c == '[' or c == '{'   # ( [ {
            depth = depth + 1
        else if c == ')' or c == ']' or c == '}'   # ) ] }
            depth = depth - 1
        else if c == ':' and depth == 0   # `:`
            found = i
        i = i + 1
    found

fn interp_is_digit(c: i32) -> i32
    if c >= '0' and c <= '9'
        return 1
    0

# Is the `len`-byte spec (the text after the colon) one of the v1 specs?
pub fn interp_spec_valid(spec_sv: StrView) -> i32
    var spec: *u8 = spec_sv.ptr
    var len: i32 = spec_sv.len as i32
    if len == 1 and *spec as i32 == 63   # `?`
        return 1
    var i: i32 = 0
    var align: i32 = 0
    var zero: i32 = 0
    if len > 0
        let first: i32 = *spec as i32
        if first == 60 or first == 62 or first == 94   # < > ^
            align = 1
            i = 1
        else if first == 48 and len > 1   # `0` before a width
            zero = 1
            i = 1
    let digits_at: i32 = i
    var width: i32 = 0
    while i < len and interp_is_digit(*(spec + i) as i32) == 1
        width = width * 10 + (*(spec + i) as i32 - 48)
        if width > 4096
            return 0
        i = i + 1
    let has_width: bool = i > digits_at
    if align == 1
        if has_width and i == len
            return 1
        return 0
    if zero == 1 and not has_width
        return 0
    if i != len - 1
        return 0
    let r: i32 = *(spec + i) as i32
    if r == 120 or r == 88 or r == 98 or r == 111   # x X b o
        return 1
    0

# The placeholder text `text[0..len]` trimmed as interp_parse_expr trims it:
# the start in *out_lo, the length returned.
pub fn interp_trim(text_sv: StrView, out_lo: *i32) -> i32
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    var lo: i32 = 0
    var hi: i32 = len
    while lo < hi and interp_is_space(*(text + lo) as i32) == 1
        lo = lo + 1
    while hi > lo and interp_is_space(*(text + hi - 1) as i32) == 1
        hi = hi - 1
    *out_lo = lo
    hi - lo

# Does the string literal have a `{...}` placeholder? `{{`/`}}` are literal
# braces, and an escaped brace is not a placeholder. ritz0 supplies
# `InterpString` for exactly these (AGAST #4381: ritz1's print/write
# lowering and call_check's shape test share this rule).
pub fn interp_lit_has_placeholder(lit: *Expr) -> i32
    if lit == null or lit.kind != ExprKind.StringLit
        return 0
    let raw: *u8 = lit.ident.ptr
    if raw == null or lit.ident.len < 3
        return 0
    let body: *u8 = raw + 1
    let n: i32 = (lit.ident.len as i32) - 2
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == '\\' and i + 1 < n
            let esc_p: *u8 = body + i + 1
            i = i + 1 + lexer_escape_width(((*esc_p) as i32) & 255)
        else if c == '{' and i + 1 < n and *(body + i + 1) == '{'
            i = i + 2
        else if c == '}' and i + 1 < n and *(body + i + 1) == '}'
            i = i + 2
        else if c == '{' and interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i) >= 0
            return 1
        else
            i = i + 1
    0
