# ritz1/src/narrowing.ritz - implicit narrowing in a typed let/var is an error
#
# AGAST #1364 (decision, option b) / #1446 (ritz1 parity with #1393).
#
#     fn big() -> i64
#         return 4294967301
#     let n: i32 = big()          # error; write `big() as i32`
#
# This is a port of ritz0's `_check_implicit_narrowing`,
# `_provable_int_range` and `_const_int_value` (emitter_llvmlite.py).  The
# rule is identical: a narrowing is rejected unless it is PROVABLY lossless --
#
#   * a compile-time constant expression whose value fits the declared type
#   * a mask `e & K` with constant K >= 0 that fits the declared type
#   * an if/else or match whose every arm is one of the above, or fits on its
#     own (narrow_arms_fit, ritz0's `_arms_fit`, #1444 / #4081)
#
# ritz0/test_implicit_narrowing.py is the specification of the rule, and
# ritz0/test_ritz1_implicit_narrowing.py feeds its tables to both compilers.
# slot_narrowing.ritz holds an assignment, a call argument and a return to the
# same rule (narrow_sema_unproven, AGAST #4081).
#
# THE ONE REAL DIFFERENCE: how the initialiser's type is known.  ritz0 reads
# the LLVM width of the value it just emitted.  ritz1 cannot: its unified
# value model keeps every integer in an i64 register, so every initialiser
# would look 64-bit.  The source type is therefore inferred from RITZ types
# by narrow_src_type below, and that inference is deliberately one-sided: when
# it is not sure, it answers TypeKind.NarrowUnknown and the check stays silent.  A
# missed rejection is a parity gap; a false rejection would refuse a program
# ritz0 accepts, which the regression suite would (rightly) fail on.  In
# The parser defaults an unannotated local to TypeKind.I64 whatever its
# initialiser is, so that default is never read.  Sema records the type
# narrow_src_type infers for the initialiser instead (narrow_sema_decl, AGAST
# #1688): ritz0 sizes the local's slot from the value it emits, the same width.
#
# WHERE IT RUNS (AGAST #3505, #1816).  check_implicit_narrowing is a Sema
# check: sema_walk calls it on every `let` / `var`, before the name is bound,
# so `let x: i32 = x` still sees the outer x.  Sema's scope is lexical, and
# each binding carries the integer type its declaration wrote (SemaVar.narrow:
# a param's, a typed let's, a match binding's payload or scrutinee type).
#
# The rule itself (narrow_src_type, narrow_unproven and the folding under them)
# is also read mid-lowering by sizeof and a match scrutinee's binding.
# float_slot and literal_slot read it on Sema (narrow_sema_src_type,
# narrow_sema_unproven; AGAST #3510).  Those still run on EmitterState, so the
# emitter keeps its per-function table of written annotations
# (narrowing_begin_fn / narrow_note_decl / narrow_note_binding) for them.
# A NarrowEnv says which view a lookup reads; everything else is one copy.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import sema
import sema_type
import bool_check   # sbk_method_def, sbk_receiver (AGAST #1688)
import wrapping     # const_arith_site (AGAST #4665)
import ritzlib.strview   # strview_empty (ritz0 wants it imported here, #3891)

# narrow_src_type answers a TypeKind, TypeKind.NarrowUnknown when it cannot
# tell (never reject on that), or TypeKind.NarrowLit for a bare integer
# literal, which adopts the declared type (#1396) and never narrows.

const I64_MAX: i64 = 9223372036854775807

# Which view of the names in scope a lookup reads: the emitter's table, for
# the codegen paths above, or Sema's scope, for the check.  Exactly one is set.
struct NarrowEnv
    s: *EmitterState
    sm: *Sema

# =============================================================================
# The emitter's per-function table (its codegen readers, see the header)
# =============================================================================

# Called at the start of every fn and impl method, where s.fcx.locals is reset.
pub fn narrowing_begin_fn(s: *EmitterState, params: *Param)
    s.fcx.narrow_params = params
    s.fcx.narrow_decl_count = 0
    s.fcx.narrow_decl_overflow = 0

# emit_var_decl records each `let` / `var` as it is lowered.
pub fn narrow_note_decl(s: *EmitterState, stmt: *Stmt)
    if s.fcx.narrow_decl_count >= 256
        # Lookups could miss a shadowing entry: stop trusting the table.
        s.fcx.narrow_decl_overflow = 1
        return
    var t: TypeKind = TypeKind.NarrowUnknown
    if ty_bits(stmt.var_declared_type) > 0
        t = stmt.var_declared_type
    let idx: i32 = s.fcx.narrow_decl_count
    s.fcx.narrow_decls[idx].name = stmt.var_name
    s.fcx.narrow_decls[idx].decl_type = t
    s.fcx.narrow_decls[idx].declared = stmt.var_declared_type
    s.fcx.narrow_decls[idx].init = stmt.var_init
    s.fcx.narrow_decl_count = idx + 1

# AGAST #3345 / #3358: a match arm's pattern binding (`Some(x)`, `n`) has a
# type too, the payload's or the scrutinee's.  Recorded while the arm is
# emitted (the caller truncates the table to its mark after the arm), so
# `let a: f64 = match o / Some(x) => x` over a u64 is refused as the plain
# `let a: f64 = x` is.  `t` 0 or a non-integer records an unknown.
pub fn narrow_note_binding(s: *EmitterState, name_sv: StrView, t: TypeKind)
    if s.fcx.narrow_decl_count >= 256
        s.fcx.narrow_decl_overflow = 1
        return
    let idx: i32 = s.fcx.narrow_decl_count
    s.fcx.narrow_decls[idx].name = name_sv
    s.fcx.narrow_decls[idx].decl_type = narrow_known(t)
    # Not TypeKind.Void, so sizeof() reads the local's own slot, as before.
    s.fcx.narrow_decls[idx].declared = TypeKind.I64
    s.fcx.narrow_decls[idx].init = null
    s.fcx.narrow_decl_count = idx + 1

# =============================================================================
# Sema's bindings (AGAST #3505)
# =============================================================================
#
# sema_walk binds a name, then notes here the integer type it was written
# with, on that binding.  An unnamed bind (sema_bind_ty skips it) is no note.

fn narrow_sema_note(sm: *Sema, name_sv: StrView, t: TypeKind)
    if sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if v.name.ptr != name_sv.ptr or v.name.len != name_sv.len
        return
    v.narrow = TypeKind.Void
    if ty_bits(t) > 0
        v.narrow = t

pub fn narrow_sema_param(sm: *Sema, p: *Param)
    narrow_sema_note(sm, p.name, p.param_type)

# A `let` / `var`: its annotation, else (AGAST #1688) its initialiser's
# type, as ritz0 sizes an unannotated local's slot from the value it emits.
# A bare literal is an i64 there: `let a = 5` then `let n: i32 = a` is refused.
pub fn narrow_sema_decl(sm: *Sema, st: *Stmt)
    if st.var_declared_type != TypeKind.Void
        narrow_sema_note(sm, st.var_name, st.var_declared_type)
        return
    if sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if v.name.ptr != st.var_name.ptr or v.name.len != st.var_name.len
        return
    # Judged before the name is in scope, as `let a = a` reads the outer a.
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    sm.scope_top = sm.scope_top - 1
    var t: TypeKind = narrow_src_type_in(@env, st.var_init, 0)
    sm.scope_top = sm.scope_top + 1
    if t == TypeKind.NarrowLit
        t = TypeKind.I64
    narrow_sema_note(sm, st.var_name, t)

# A match arm's binding (AGAST #3345 / #3358, as the emitter's
# narrow_note_binding): a payload `Some(x)` has the payload's integer type, a
# catch-all name `n` the scrutinee's.  `scrut` is null for if-expression arms.
pub fn narrow_sema_arm(sm: *Sema, scrut: *Expr, arm: *MatchArm)
    if arm.pattern_kind == PAT_VARIANT and arm.pattern_inner_kind == PAT_IDENT
        narrow_sema_note(sm, arm.pattern_inner_name, narrow_sema_payload(sm, scrut, arm))
    else if arm.pattern_kind == PAT_IDENT and scrut != null
        var env: NarrowEnv
        env.s = null
        env.sm = sm
        narrow_sema_note(sm, arm.pattern_name, narrow_src_type_in(@env, scrut, 0))

# The payload's integer type of `arm`'s variant of the enum `scrut` is, as
# emit_match_arm_body picks the variant (`Some` / `Ok` tag 0, else 1; a user
# enum's own index); 0 when Sema can't type the scrutinee as an enum.
fn narrow_sema_payload(sm: *Sema, scrut: *Expr, arm: *MatchArm) -> TypeKind
    if scrut == null
        return TypeKind.Void
    var e: *Expr = scrut
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut) and e.operand != null
        e = e.operand   # `match @place` matches the enum it addresses
    var t: SemaTy
    if sema_expr_ty(sm, e, @t) != TypeKind.Struct or t.name.ptr == null or t.name.len <= 0
        return TypeKind.Void
    var variant: i32 = 1
    if name_eq(arm.pattern_name, "Some") == 1 or name_eq(arm.pattern_name, "Ok") == 1
        variant = 0
    if user_enum_index(sm.pctx, t.name) >= 0
        let uvi: i32 = arm_variant_sel(sm.pctx, t.name, arm)   # AGAST #1295: the selected field
        if uvi >= 0
            variant = uvi
    tagged_enum_int_type_in(sm.pctx, @sm.struct_map, sm.module, t.name, variant)

# =============================================================================
# Types
# =============================================================================

# A type kind if it is an integer/bool, else TypeKind.NarrowUnknown.
pub fn narrow_known(t: TypeKind) -> TypeKind
    if ty_bits(t) > 0
        return t
    TypeKind.NarrowUnknown

# The const named `name`.  Sema runs before emit_module resolves a const
# that named one not yet parsed (resolve_const_values), so it resolves the
# one it reads, as the emitter's own lookup would find it resolved.
fn narrow_env_const(env: *NarrowEnv, name_sv: StrView) -> *ConstEntry
    if env.s != null
        return find_const_entry(env.s, name_sv)
    let consts: *ConstEntry = env.sm.module.constants
    var c: *ConstEntry = consts
    while c != null
        if name_eq(c.name, name_sv) == 1
            if c.fold_state == CONST_FOLD_PENDING
                const_resolve(consts, c)
            return c
        c = c.next
    null

# Ritz type of an identifier, or TypeKind.NarrowUnknown.  Same precedence as
# emission: constants shadow locals.
pub fn narrow_ident_type(s: *EmitterState, e: *Expr) -> TypeKind
    narrow_name_type(s, e.ident)

pub fn narrow_name_type(s: *EmitterState, name_sv: StrView) -> TypeKind
    var env: NarrowEnv
    env.s = s
    env.sm = null
    narrow_env_name_type(@env, name_sv)

fn narrow_env_name_type(env: *NarrowEnv, name_sv: StrView) -> TypeKind
    var len: i32 = name_sv.len as i32
    let ce: *ConstEntry = narrow_env_const(env, name_sv)
    if ce != null
        if ce.fold_state != CONST_FOLD_DONE
            return TypeKind.NarrowUnknown
        return narrow_known(ce.const_type)
    if env.s == null
        # Sema: the innermost binding of the name, else a global.
        let v: *SemaVar = sema_find_local(env.sm, name_sv)
        if v != null
            if v.narrow == TypeKind.Void
                return TypeKind.NarrowUnknown
            return v.narrow
        # Every global's type is written (the parser refuses an untyped one,
        # #3375), so an i64 / u64 global is trusted here (AGAST #1688).
        var sg: *GlobalVarDef = env.sm.module.globals
        while sg != null
            if name_eq(sg.name, name_sv) == 1
                if ty_is_int(sg.var_type) == 1
                    return sg.var_type
                return TypeKind.NarrowUnknown
            sg = sg.next
        return TypeKind.NarrowUnknown
    let s: *EmitterState = env.s
    if s.fcx.narrow_decl_overflow != 0
        return TypeKind.NarrowUnknown
    # Newest declaration first.  Block scopes are not tracked, so if two
    # declarations of the name disagree the answer is unknown, not a guess.
    var found: i32 = 0
    var t: TypeKind = TypeKind.NarrowUnknown
    var i: i32 = s.fcx.narrow_decl_count - 1
    while i >= 0
        let d: *NarrowDecl = @s.fcx.narrow_decls[i]
        if name_eq(d.name, name_sv) == 1
            if found == 0
                found = 1
                t = d.decl_type
            else if d.decl_type != t
                return TypeKind.NarrowUnknown
        i = i - 1
    if found == 1
        return t
    var p: *Param = s.fcx.narrow_params
    while p != null
        if name_eq(p.name, name_sv) == 1
            return narrow_known(p.param_type)
        p = p.next
    let g: *GlobalVarDef = find_global(s, name_sv)
    if g != null
        return narrow_global_type(g)
    TypeKind.NarrowUnknown

# The emitter's view keeps its narrower-than-64-bit rule for a global (its
# codegen readers, sizeof and a match scrutinee, never needed more).
fn narrow_global_type(g: *GlobalVarDef) -> TypeKind
    let gw: i32 = ty_bits(g.var_type)
    if gw > 1 and gw < 64
        return g.var_type
    TypeKind.NarrowUnknown

# A name's and a `local.field`'s written type from Sema's scope, for
# enum_as_int's targets (AGAST #3511).
pub fn narrow_sema_name_type(sm: *Sema, name_sv: StrView) -> TypeKind
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    narrow_env_name_type(@env, name_sv)

pub fn narrow_sema_member_type(sm: *Sema, e: *Expr) -> TypeKind
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    narrow_env_member_type(@env, e)

# Ritz type of `local.field` / `ptr.field`; field types are always written.
fn narrow_env_member_type(env: *NarrowEnv, e: *Expr) -> TypeKind
    if e.left == null or e.left.kind != ExprKind.Ident
        return TypeKind.NarrowUnknown
    var tn: StrView = strview_empty()
    if env.s != null
        let local: *LocalVar = find_local_struct_name(env.s, e.left.ident)
        if local == null
            return TypeKind.NarrowUnknown
        tn = lv_name(local)
    else
        let v: *SemaVar = sema_find_local(env.sm, e.left.ident)
        if v == null
            return TypeKind.NarrowUnknown
        tn = v.type_name
    if tn.len == 0
        return TypeKind.NarrowUnknown
    var st: *StructDef = null
    if env.s != null
        st = find_struct(env.s, tn)
    else
        st = sema_find_struct(env.sm, tn)
    if st == null
        return TypeKind.NarrowUnknown
    let idx: i32 = find_field_index(st, e.ident)
    if idx < 0
        return TypeKind.NarrowUnknown
    let field: *StructField = get_field_type(st, idx)
    narrow_known(field.field_type)

fn narrow_call_type(env: *NarrowEnv, e: *Expr) -> TypeKind
    var fn_def: *FnDef = null
    if env.s != null
        fn_def = find_call_fn(env.s, e)
    else
        fn_def = narrow_sema_call_fn(env.sm, e)
    if fn_def == null
        return TypeKind.NarrowUnknown
    narrow_known(fn_def.return_type)

# The callee find_call_fn resolves, from Sema's scope: a typed fn-pointer
# local of the name (AGAST #3666), else sema_call_fn.  A nameless call
# (`fs[i](..)`) is not resolved, and a Deref step call does not exist yet
# (deref_field makes it during lowering).
pub fn narrow_sema_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name.len == 0
        return null
    if e.call_type_suffix.len <= 0
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null and v.fn_sig != null and v.kind != TypeKind.Array
            return v.fn_sig
    sema_call_fn(sm, e)

# AGAST #1688: what Sema knows of `p[i]`, `*p`, `x.m()` and `e?`, the
# element, pointee, return or payload type, read only through Sema's view.
fn narrow_sema_place_type(sm: *Sema, e: *Expr) -> TypeKind
    let k: ExprKind = e.kind
    match k
        ExprKind.Index =>
            if e.right == null or e.right.kind == ExprKind.Range
                return TypeKind.NarrowUnknown
            var kind: TypeKind = TypeKind.Void
            var pointee: TypeKind = TypeKind.Void
            sema_index_slot(sm, e, @kind, @pointee)
            return narrow_known(kind)
        ExprKind.Unary =>
            var t: SemaTy
            let pk: TypeKind = sema_expr_ty(sm, e.operand, @t)
            if pk == TypeKind.Ptr or pk == TypeKind.Ref or pk == TypeKind.MutRef
                return narrow_known(t.pointee)
            return TypeKind.NarrowUnknown
        ExprKind.Method =>
            # `.unwrap()` / `.unwrap_or(d)` is the carrier's intrinsic, no FnDef.
            if name_eq(e.ident, "unwrap") == 1 or name_eq(e.ident, "unwrap_or") == 1
                return narrow_sema_payload_of(sm, e.left)
            let fd: *FnDef = sbk_method_def(sm, e)
            if fd == null
                return TypeKind.NarrowUnknown
            return narrow_known(fd.return_type)
        ExprKind.Try =>
            return narrow_sema_payload_of(sm, e.left)
        _ => pass
    TypeKind.NarrowUnknown

# The Ok / Some payload's integer type of an Option / Result `carrier`.
fn narrow_sema_payload_of(sm: *Sema, carrier: *Expr) -> TypeKind
    var name: StrView = strview_empty()
    sbk_receiver(sm, carrier, @name)
    if name.ptr == null or name.len <= 0 or is_tagged_enum_type(name) == 0
        return TypeKind.NarrowUnknown
    narrow_known(tagged_enum_int_type_in(sm.pctx, @sm.struct_map, sm.module, name, 0))

# The type ritz0 would give an arithmetic result: the wider operand, with a
# bare literal adopting the other side (#1396).  Two literals stay i64 in
# ritz0 (#1445), so `2 << 8` is an i64 that the constant rule must clear.
fn narrow_join(a: TypeKind, b: TypeKind) -> TypeKind
    if a == TypeKind.NarrowUnknown or b == TypeKind.NarrowUnknown
        return TypeKind.NarrowUnknown
    if a == TypeKind.NarrowLit and b == TypeKind.NarrowLit
        return TypeKind.I64
    if a == TypeKind.NarrowLit
        return b
    if b == TypeKind.NarrowLit
        return a
    if a == TypeKind.Bool or b == TypeKind.Bool
        return TypeKind.NarrowUnknown
    if ty_bits(b) > ty_bits(a)
        return b
    a

pub fn narrow_is_arith_op(op: OpKind) -> i32
    match op
        OpKind.Add | OpKind.Sub | OpKind.Mul | OpKind.Div | OpKind.Mod =>
            return 1
        OpKind.BitAnd | OpKind.BitOr | OpKind.BitXor | OpKind.Shl | OpKind.Shr =>
            return 1
        _ => pass
    0

# The operators congruent mod 2**width (LARB R73, AGAST #4219): a value path
# through them carries a slot's width down to an if / match below it, so
# `x op= v` (`x = x op v`, v an if) is not a narrowing.  `/`, `%` and `>>`
# are not congruent, nor are comparisons or `&&` / `||`; ritz0's
# _CONGRUENT_BINOPS has the same rows.  Wrapping `+%` / `-%` / `*%` are
# congruent too, and arrive here as the plain op codes with Expr.wrapping set
# (LARB R63, AGAST #3486), so they take these rows unchanged; ritz0 excludes
# them for the same reason.
fn narrow_is_congruent_op(op: OpKind) -> i32
    match op
        OpKind.Add | OpKind.Sub | OpKind.Mul =>
            return 1
        OpKind.BitAnd | OpKind.BitOr | OpKind.BitXor | OpKind.Shl =>
            return 1
        _ => pass
    0

# 1 when operand `e` is an integer literal (`-` and all) and `other` isn't, so
# that `e` is `other`'s type (LARB R21, AGAST #3112).
fn narrow_operand_lit(e: *Expr, other: *Expr) -> i32
    if narrow_is_int_lit(e) == 0
        return 0
    1 - narrow_is_int_lit(other)

fn narrow_is_int_lit(e: *Expr) -> i32
    if e == null
        return 0
    var lit: *Expr = e
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg and e.operand != null
        lit = e.operand
    (lit.kind == ExprKind.IntLit and lit.lit_kind == LIT_PLAIN) as i32

# AGAST #4082: operand `e` of an arithmetic operator, typed `t`, beside
# `other`, typed `ot`.  An all-literal `e` (`0 - 1`, `~63`, `1 << 26`) is one
# literal of its i64 value (narrow_fold_lit), so under R21 it is `other`'s
# type when that value fits it: TypeKind.NarrowLit.  A value that doesn't fit stays
# the i64 it was, as in ritz0 (`_literal_operand_value`).  `arm_i64` says a
# shift's left literal in an `if` arm is an i64, as `1 << n` is there.
fn narrow_folded_side(e: *Expr, other: *Expr, t: TypeKind, ot: TypeKind, arm_i64: i32) -> TypeKind
    var v: i64 = 0
    match narrow_fold_lit(e)
        Some(folded) =>
            v = folded
        None =>
            return t
    if narrow_is_int_lit(other) == 1 or narrow_fold_lit(other).is_some()
        return t        # both literal: the operator itself folds
    if arm_i64 == 1
        return TypeKind.I64
    if ty_is_int(ot) == 1 and ty_bits(ot) < 64 and narrow_fits(v, ot) == 0
        return TypeKind.I64
    TypeKind.NarrowLit

# ritz0's fold_literal_i64 (AGAST #4082): the i64 value of an operator over
# untyped integer literals only, or None.  A bare literal (`5`, `-5`) is one
# already and gives None, as do names and casts.  Unlike
# narrow_const_value, which proves a slot's fit, it folds what the emitter
# computes: `>>` is arithmetic and `/` `%` truncate on negative operands too.
# Any step outside i64, a zero divisor or a count outside 0..63 gives None.
pub fn narrow_fold_lit(e: *Expr) -> Option<i64>
    if e == null or narrow_is_int_lit(e) == 1
        return None
    if e.kind != ExprKind.Binary and e.kind != ExprKind.Unary
        return None
    narrow_fold_lit_in(e)

# narrow_fold_lit's fold, a bare non-negative literal included.
fn narrow_fold_lit_in(e: *Expr) -> Option<i64>
    if e == null
        return None
    let min: i64 = 0 - I64_MAX - 1
    match e.kind
        ExprKind.IntLit =>
            # A negative int_val is a literal only a u64 holds (int_operand_shape).
            if e.lit_kind != LIT_PLAIN or e.int_val < 0
                return None
            return Some(e.int_val)
        ExprKind.Unary =>
            if e.op != OpKind.Neg and e.op != OpKind.BitNot
                return None
            let v: i64 = narrow_fold_lit_in(e.operand)?
            if e.op == OpKind.BitNot
                return Some((0 - 1) - v)
            if v == min
                return None
            return Some(0 - v)
        ExprKind.Binary => pass
        _ =>
            return None
    if narrow_is_arith_op(e.op) == 0
        return None
    let l: i64 = narrow_fold_lit_in(e.left)?
    let r: i64 = narrow_fold_lit_in(e.right)?
    let op: OpKind = e.op
    match op
        OpKind.Shl | OpKind.Shr =>
            if r < 0 or r >= 64
                return None
            if op == OpKind.Shr
                return Some(l >> r)
            if l >= 0 and l > (I64_MAX >> r)
                return None
            if l < 0 and l < (min >> r)
                return None
            return Some(l << r)
        OpKind.Div | OpKind.Mod =>
            if r == 0 or (l == min and r == 0 - 1)
                return None
            if op == OpKind.Div
                return Some(l / r)
            return Some(l % r)
        OpKind.Add =>
            if narrow_add_ok(l, r) == 0
                return None
            return Some(l + r)
        OpKind.Sub =>
            if narrow_sub_ok(l, r) == 0
                return None
            return Some(l - r)
        OpKind.Mul =>
            if narrow_mul_ok(l, r) == 0
                return None
            return Some(l * r)
        _ => pass
    match op
        OpKind.BitAnd =>
            return Some(l & r)
        OpKind.BitOr =>
            return Some(l | r)
        _ => pass
    Some(l ^ r)

# Ritz type of an initialiser, TypeKind.NarrowLit, or TypeKind.NarrowUnknown (see header).
pub fn narrow_src_type(s: *EmitterState, e: *Expr) -> TypeKind
    var env: NarrowEnv
    env.s = s
    env.sm = null
    narrow_src_type_in(@env, e, 0)

# `lit_i64` is 1 inside the arms of an `if` expression, where ritz0 emits
# integer literals with no expected type, so they are i64 there and do NOT
# adopt the other operand or arm: `let a = if c then x else 0` is an i64.
#
# It is NARROW_SLOT for a value tail of a typed slot (AGAST #1445): ritz0
# carries the slot's type into an if / match's arm values
# (_arith_context_nodes), so a literal arm is the slot's type there, as the
# whole initialiser is, and `let n: i32 = if c then x else 255` is an i32.
# Only through if / match, and through operators congruent mod 2**width
# (LARB R73, AGAST #4219): below any other operator an if is that operator's
# operand and its literal arms are i64 again.
const NARROW_SLOT: i32 = 2

fn narrow_src_type_in(env: *NarrowEnv, e: *Expr, lit_i64: i32) -> TypeKind
    if e == null
        return TypeKind.NarrowUnknown
    let k: ExprKind = e.kind
    # What an operator's operand reads: never a slot tail.
    let op_lit: i32 = (lit_i64 == 1) as i32
    match k
        ExprKind.IntLit =>
            if lit_i64 == 1
                return TypeKind.I64
            return TypeKind.NarrowLit
        ExprKind.CharLit =>
            return TypeKind.U8
        ExprKind.Ident =>
            return narrow_env_name_type(env, e.ident)
        ExprKind.Call =>
            return narrow_call_type(env, e)
        ExprKind.Cast =>
            return narrow_known(e.type_kind)
        ExprKind.Member =>
            let mt: TypeKind = narrow_env_member_type(env, e)
            if mt == TypeKind.NarrowUnknown and env.sm != null
                # `a.b.c`: Sema types the chain; a field's type is always written.
                return narrow_known(sema_expr_type(env.sm, e))
            return mt
        _ => pass
    if env.sm != null and (k == ExprKind.Index or k == ExprKind.Method or k == ExprKind.Try)
        return narrow_sema_place_type(env.sm, e)
    if env.sm != null and k == ExprKind.Unary and e.op == OpKind.Deref
        return narrow_sema_place_type(env.sm, e)
    match k
        ExprKind.Binary =>
            if op_is_cmp_or_logic(e.op)
                return TypeKind.Bool
            if e.op == OpKind.Shr
                # AGAST #2360: ritz0's slot typing stops at `>>`, so a literal
                # inside either operand is an i64 there, and so is a literal left
                # operand: `(a << 4) >> 4` and `64 >> a` are i64 even below a u8
                # slot.  Only a bare literal count still adopts the left side.
                let lt: TypeKind = narrow_src_type_in(env, e.left, 1)
                if e.right != null and e.right.kind == ExprKind.IntLit
                    return narrow_join(lt, TypeKind.NarrowLit)
                let ct: TypeKind = narrow_src_type_in(env, e.right, 1)
                return narrow_join(lt, narrow_folded_side(e.right, e.left, ct, lt, 0))
            if narrow_is_arith_op(e.op) == 1
                # LARB R21 (AGAST #3112): a literal operand is the other operand's
                # type, in an `if` arm or under `>>` too: `(a << 4) >> 4` is a's.
                # A shift's left literal is not (`1 << n`), as before.
                # AGAST #4219 (LARB R73): a congruent operator is itself consumed
                # at the slot's width, so it passes the slot marker on to its
                # operands; an if / match below it is then a tail of the slot and
                # its literal arms take the slot's type.  `/`, `%` and the rest
                # keep demoting (`op_lit`), as before.
                var operand_lit: i32 = op_lit
                if narrow_is_congruent_op(e.op) == 1
                    operand_lit = lit_i64
                var lt: TypeKind = TypeKind.NarrowLit
                if e.op == OpKind.Shl or narrow_operand_lit(e.left, e.right) == 0
                    lt = narrow_src_type_in(env, e.left, operand_lit)
                var rt: TypeKind = TypeKind.NarrowLit
                # A shift's count is an amount, not a value at the slot's width.
                var right_lit: i32 = operand_lit
                if e.op == OpKind.Shl
                    right_lit = op_lit
                if narrow_operand_lit(e.right, e.left) == 0
                    rt = narrow_src_type_in(env, e.right, right_lit)
                # AGAST #4082: an all-literal operand is one literal, R21 and all.
                var shl_arm: i32 = 0
                if e.op == OpKind.Shl and op_lit == 1
                    shl_arm = 1     # `1 << n` in an arm is an i64: so is `(1 << 2) << n`
                let lf: TypeKind = narrow_folded_side(e.left, e.right, lt, rt, shl_arm)
                let rf: TypeKind = narrow_folded_side(e.right, e.left, rt, lt, 0)
                return narrow_join(lf, rf)
            return TypeKind.NarrowUnknown
        ExprKind.Unary =>
            match e.op
                OpKind.Not =>
                    return TypeKind.Bool
                OpKind.Neg | OpKind.BitNot =>
                    return narrow_src_type_in(env, e.operand, op_lit)
                _ => pass
            return TypeKind.NarrowUnknown
        ExprKind.If =>
            # AGAST #1613: the wider of the two arms, literals counting as i64,
            # or as the slot's type in a slot's tail (#1445, NARROW_SLOT).
            let then_arm: *MatchArm = e.args as *MatchArm
            let else_arm: *MatchArm = then_arm.next
            if then_arm.is_pass != 0 or then_arm.body == null
                return TypeKind.NarrowUnknown
            if else_arm.is_pass != 0 or else_arm.body == null
                return TypeKind.NarrowUnknown
            var arm_lit: i32 = 1
            if lit_i64 == NARROW_SLOT
                arm_lit = NARROW_SLOT
            return narrow_join(narrow_src_type_in(env, then_arm.body, arm_lit), narrow_src_type_in(env, else_arm.body, arm_lit))
        ExprKind.Match =>
            # Measured against ritz0, not assumed: a literal arm takes the type
            # of the non-literal arms (`match o: A => x_i32, B => 0` is i32), and
            # a match whose arms are ALL literals is i64.  (An `if`'s literal arms
            # are i64 outside a slot's tail; see ExprKind.If above and lit_i64.)
            var t: TypeKind = TypeKind.NarrowLit
            var arm: *MatchArm = e.args as *MatchArm
            if arm == null
                return TypeKind.NarrowUnknown
            while arm != null
                if arm.is_pass != 0 or arm.body == null
                    return TypeKind.NarrowUnknown
                let at: TypeKind = narrow_src_type_in(env, arm.body, lit_i64)
                if at == TypeKind.NarrowUnknown
                    return TypeKind.NarrowUnknown
                if at != TypeKind.NarrowLit
                    if t == TypeKind.NarrowLit
                        t = at
                    else
                        t = narrow_join(t, at)
                    if t == TypeKind.NarrowUnknown
                        return TypeKind.NarrowUnknown
                arm = arm.next
            if t == TypeKind.NarrowLit
                return TypeKind.I64
            return t
        _ => pass
    TypeKind.NarrowUnknown

# =============================================================================
# Constant folding -- port of ritz0's _const_int_value
# =============================================================================
#
# ritz0 folds with Python's unbounded integers; here an intermediate that
# leaves i64 makes the fold give up (return 0 = "not proven").  The two agree
# on every verdict that matters: ritz0's ring ops (+ - * & | ^ <<) only accept
# a result that fits a <= 32-bit declared type, and `>>` / `/` / `%` refuse an
# operand outside [0, 2^63) -- exactly the values that would overflow here.

fn narrow_add_ok(a: i64, b: i64) -> i32
    if b > 0 and a > I64_MAX - b
        return 0
    if b < 0 and a < (0 - I64_MAX - 1) - b
        return 0
    1

fn narrow_sub_ok(a: i64, b: i64) -> i32
    if b < 0 and a > I64_MAX + b
        return 0
    if b > 0 and a < (0 - I64_MAX - 1) + b
        return 0
    1

fn narrow_mul_ok(a: i64, b: i64) -> i32
    if a == 0 or b == 0
        return 1
    let min: i64 = 0 - I64_MAX - 1
    if (a == 0 - 1 and b == min) or (b == 0 - 1 and a == min)
        return 0
    # The overflow check: a wrapped product does not divide back (`*%`, R63).
    let r: i64 = a *% b
    if r / b != a
        return 0
    1

# Exact value of a compile-time integer expression, or None if not proven.
# A named constant narrower than 64 bits is trusted only as the WHOLE
# initialiser: inside an expression it is computed at its own width and
# could wrap before any widening.
fn narrow_const_value(env: *NarrowEnv, e: *Expr, whole: i32) -> Option<i64>
    if e == null
        return None
    match e.kind
        ExprKind.IntLit =>
            return Some(e.int_val)
        ExprKind.Ident =>
            let ce: *ConstEntry = narrow_env_const(env, e.ident)
            if ce == null or ce.fold_state != CONST_FOLD_DONE
                return None
            let w: i32 = ty_bits(ce.const_type)
            if w < 8
                return None
            if w < 64 and whole == 0
                return None
            return Some(ce.value)
        ExprKind.Unary =>
            if e.op != OpKind.Neg and e.op != OpKind.BitNot
                return None
            let v: i64 = narrow_const_value(env, e.operand, 0)?
            if e.op == OpKind.Neg
                if v == 0 - I64_MAX - 1
                    return None
                return Some(0 - v)
            return Some((0 - 1) - v)    # ~v
        _ => pass
    if e.kind != ExprKind.Binary
        return None
    let l: i64 = narrow_const_value(env, e.left, 0)?
    let r: i64 = narrow_const_value(env, e.right, 0)?
    let op: OpKind = e.op
    match op
        OpKind.Shl =>
            # A shift of 64 or more is poison in LLVM, not 0.
            if r < 0 or r >= 64
                return None
            if l >= 0 and l > (I64_MAX >> r)
                return None
            if l < 0 and l < ((0 - I64_MAX - 1) >> r)
                return None
            return Some(l << r)
        OpKind.Shr | OpKind.Div | OpKind.Mod =>
            # Signed and unsigned forms (ashr/lshr, sdiv/udiv) agree only for
            # non-negative operands; see ritz0's comment on `(1 << 62) * 4 >> 60`.
            if l < 0 or r < 0
                return None
            if op == OpKind.Shr
                if r >= 64
                    return None
                return Some(l >> r)
            if r == 0
                return None
            if op == OpKind.Div
                return Some(l / r)
            return Some(l % r)
        OpKind.Add =>
            if narrow_add_ok(l, r) == 0
                return None
            return Some(l + r)
        OpKind.Sub =>
            if narrow_sub_ok(l, r) == 0
                return None
            return Some(l - r)
        OpKind.Mul =>
            if narrow_mul_ok(l, r) == 0
                return None
            return Some(l * r)
        OpKind.BitAnd =>
            return Some(l & r)
        OpKind.BitOr =>
            return Some(l | r)
        OpKind.BitXor =>
            return Some(l ^ r)
        _ => pass
    None

# [*lo, *hi] bounding every value of e; 1 if proven.  Port of ritz0's
# _provable_int_range: constants, `e & K` masks, and match over those.  No
# reasoning about comparisons, loop bounds or variables -- widening this is a
# language decision, pinned by test_implicit_narrowing.py.
fn narrow_provable_range(env: *NarrowEnv, e: *Expr, whole: i32, lo: *i64, hi: *i64) -> i32
    match narrow_const_value(env, e, whole)
        Some(v) =>
            *lo = v
            *hi = v
            return 1
        None => pass
    if e == null
        return 0
    if e.kind == ExprKind.Binary and e.op == OpKind.BitAnd
        var found: i32 = 0
        var best: i64 = 0
        match narrow_const_value(env, e.left, 0)
            Some(k) =>
                if k >= 0
                    best = k
                    found = 1
            None => pass
        match narrow_const_value(env, e.right, 0)
            Some(k) =>
                if k >= 0
                    if found == 0 or k < best
                        best = k
                    found = 1
            None => pass
        if found == 0
            return 0
        *lo = 0
        *hi = best
        return 1
    # An if expression (#1613) is the union of its two arms, as in ritz0.
    if e.kind == ExprKind.Match or e.kind == ExprKind.If
        var arm: *MatchArm = e.args as *MatchArm
        if arm == null
            return 0
        var any: i32 = 0
        var alo: i64 = 0
        var ahi: i64 = 0
        while arm != null
            if arm.is_pass != 0 or arm.body == null
                return 0
            if narrow_provable_range(env, arm.body, 0, @alo, @ahi) == 0
                return 0
            if any == 0 or alo < *lo
                *lo = alo
            if any == 0 or ahi > *hi
                *hi = ahi
            any = 1
            arm = arm.next
        return 1
    0

pub fn narrow_fits(v: i64, t: TypeKind) -> i32
    let w: i32 = ty_bits(t)
    if ty_is_unsigned(t) == 1
        return (v >= 0 and v <= ((1 as i64) << w) - 1) as i32
    let half: i64 = (1 as i64) << (w - 1)
    (v >= 0 - half and v <= half - 1) as i32

# The integer kind of `bits` bits, unsigned when `uns` is 1; 0 for no such kind.
pub fn int_kind_of(bits: i32, uns: i32) -> TypeKind
    var k: TypeKind = TypeKind.Void
    if bits == 8
        k = TypeKind.I8
        if uns == 1
            k = TypeKind.U8
    else if bits == 16
        k = TypeKind.I16
        if uns == 1
            k = TypeKind.U16
    else if bits == 32
        k = TypeKind.I32
        if uns == 1
            k = TypeKind.U32
    else if bits == 64
        k = TypeKind.I64
        if uns == 1
            k = TypeKind.U64
    k

# AGAST #4080 (LANGUAGE_SPEC §6.3): the integer type of `for x in a..b`'s x,
# from its bounds' types `ts` and `te`, ritz0's _emit_for.  A lone untyped
# literal bound (`lit_s` / `lit_e` 1, value `sv` / `ev`) is the other bound's
# type when it fits there, as an operator's literal operand is (LARB R21); one
# that doesn't fit a narrow type widens to an i64.  Two literals are an i64.
# Otherwise the wider bound's width, unsigned when a bound is: any unsigned
# bound below 64 bits, a u64 at 64 (#1636 / #3328).  0 when a bound's type is
# untold.  `sl` / `el` are the bounds' literal values (lit_int_value), None
# for a bound that is no literal.
pub fn for_range_type(ts: TypeKind, sl: Option<i64>, te: TypeKind, el: Option<i64>) -> TypeKind
    match sl
        Some(sv) =>
            match el
                Some(_) =>
                    return TypeKind.I64
                None =>
                    return for_range_lit_type(te, sv)
        None => pass
    match el
        Some(ev) =>
            return for_range_lit_type(ts, ev)
        None => pass
    let sb: i32 = ty_int_bits(ts)
    let eb: i32 = ty_int_bits(te)
    if sb == 0 or eb == 0
        return TypeKind.Void
    var bits: i32 = sb
    if eb > bits
        bits = eb
    var uns: i32 = 0
    if ty_is_unsigned(ts) == 1 and (bits < 64 or ts == TypeKind.U64)
        uns = 1
    if ty_is_unsigned(te) == 1 and (bits < 64 or te == TypeKind.U64)
        uns = 1
    int_kind_of(bits, uns)

# for_range_type of a lone literal bound `v` beside a bound of type `o`: `o`
# when `v` fits there, else an i64; 0 when `o` is untold.
fn for_range_lit_type(o: TypeKind, v: i64) -> TypeKind
    let ob: i32 = ty_int_bits(o)
    if ob == 0
        return TypeKind.Void
    if ob == 64 or narrow_fits(v, o) == 1
        return o
    TypeKind.I64

# AGAST #4080: a range `for`'s x has for_range_type's type, so `take(x)` is
# judged as the emitter will bind it (#3973 binds an iterable's element).  Its
# bounds read the names outside the loop, as `for i in 0..i` does.
pub fn narrow_sema_for(sm: *Sema, st: *Stmt)
    if st.for_end == null or sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if v.name.ptr != st.for_var.ptr or v.name.len != st.for_var.len
        return
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    let sl: Option<i64> = lit_int_value(st.for_start)
    let el: Option<i64> = lit_int_value(st.for_end)
    var ts: TypeKind = TypeKind.Void
    var te: TypeKind = TypeKind.Void
    sm.scope_top = sm.scope_top - 1
    if sl.is_none()
        ts = narrow_src_type_in(@env, st.for_start, 1)
    if el.is_none()
        te = narrow_src_type_in(@env, st.for_end, 1)
    sm.scope_top = sm.scope_top + 1
    narrow_sema_note(sm, st.for_var, for_range_type(ts, sl, te, el))

# =============================================================================
# The check
# =============================================================================

pub fn narrow_eprint_name(name: StrView)
    var i: i32 = 0
    while i < name.len
        eprint_char(name.get(i))
        i += 1

# Reject `let n: i32 = <i64 expr>` unless it provably loses no bits.  A Sema
# check (AGAST #3505): sema_walk calls it on each `let` / `var` before the
# name is bound, so `let x: i32 = x` still sees the outer x.
pub fn check_implicit_narrowing(sm: *Sema, stmt: *Stmt)
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    let decl: TypeKind = stmt.var_declared_type
    let src: TypeKind = narrow_unproven_in(@env, stmt.var_init, decl)
    if src != TypeKind.Void
        narrow_report(sm, stmt, decl, src)

# narrow_src_type read through Sema's scope: an integer into a float slot
# (float_slot.ritz's float_slot_check, AGAST #3510).
pub fn narrow_sema_src_type(sm: *Sema, e: *Expr) -> TypeKind
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    narrow_src_type_in(@env, e, 0)

# narrow_unproven read through Sema's scope: an element of a `[N]T` literal
# (literal_slot.ritz's lit_element, AGAST #3510).
pub fn narrow_sema_unproven(sm: *Sema, init: *Expr, decl: TypeKind) -> TypeKind
    var env: NarrowEnv
    env.s = null
    env.sm = sm
    narrow_unproven_in(@env, init, decl)

# `init`'s type if landing in `decl` narrows it and might lose bits, else 0.
pub fn narrow_unproven(s: *EmitterState, init: *Expr, decl: TypeKind) -> TypeKind
    var env: NarrowEnv
    env.s = s
    env.sm = null
    narrow_unproven_in(@env, init, decl)

fn narrow_unproven_in(env: *NarrowEnv, init: *Expr, decl: TypeKind) -> TypeKind
    let dw: i32 = ty_bits(decl)
    if init == null or dw <= 1 or dw >= 64
        return TypeKind.Void
    # AGAST #4665: a constant value that can't be computed (`8 / 0`,
    # `4294967296 * 4294967296`) is const_arith_check's error, as ritz0's
    # const-eval reports it first: it has no type to narrow, in any slot.
    if env.sm != null and const_arith_site(env.sm, init) != null
        return TypeKind.Void
    let src: TypeKind = narrow_src_type_in(env, init, NARROW_SLOT)
    if src == TypeKind.NarrowUnknown or src == TypeKind.NarrowLit or ty_bits(src) <= dw
        return TypeKind.Void
    var lo: i64 = 0
    var hi: i64 = 0
    if narrow_provable_range(env, init, 1, @lo, @hi) == 1
        if narrow_fits(lo, decl) == 1 and narrow_fits(hi, decl) == 1
            return TypeKind.Void
    if narrow_arms_fit(env, init, decl) == 1
        return TypeKind.Void
    # AGAST #4553: a merge reached through congruent operators (see
    # narrow_congs_fit).  narrow_src_type_in reports the chain's two literal
    # arms as i64; the merge itself is emitted at the slot's width.
    if narrow_congs_fit(env, init, decl) == 1
        return TypeKind.Void
    src

# AGAST #4081 (ritz0's `_arms_fit`, #1444): is `e` an if/match each of whose
# arms fits `decl` on its own?  A merge is as wide as its widest arm, and a
# literal arm is an i64 there, so `if n <= 1 then 1 else n` (n: i32) is an
# i64.  Narrowing it back to the i32 it came from loses nothing: an arm no
# wider than the slot was only extended, and a constant arm is judged by its
# value.  An arm that is itself a merge (`else if`) is judged arm by arm too.
# A mask arm is not a constant: ritz0 judges the arms as emitted, where
# `big() & 255` is an i64, so only the whole-merge range above clears it.
fn narrow_arms_fit(env: *NarrowEnv, e: *Expr, decl: TypeKind) -> i32
    if e == null or (e.kind != ExprKind.If and e.kind != ExprKind.Match)
        return 0
    let dw: i32 = ty_bits(decl)
    var arm: *MatchArm = e.args as *MatchArm
    if arm == null
        return 0
    while arm != null
        if arm.is_pass != 0 or arm.body == null
            return 0
        match narrow_const_value(env, arm.body, 1)
            Some(v) =>
                if narrow_fits(v, decl) == 0
                    return 0
            None =>
                let at: TypeKind = narrow_src_type_in(env, arm.body, 1)
                if at == TypeKind.NarrowUnknown or ty_bits(at) > dw
                    if narrow_arms_fit(env, arm.body, decl) == 0
                        return 0
        arm = arm.next
    1

# AGAST #4553: `let x: i32 = 6 + if c then 1 else 2` is not a narrowing in
# ritz0.  The operators `+ - * & | ^ <<` are congruent mod 2**width
# (#4219), so an if / match reached through them is emitted at the slot's
# width and its literal arms take that width (ritzo's _arith_context_nodes).
# narrow_src_type_in joins two literal arms to i64 outside a slot's own tail,
# which overstates that merge.  Judge the reachable merge by its arms
# instead.  A side scores -1 (fails), 0 (fine, no merge) or 1 (fine, reached
# a merge); only a chain that reaches one is exempt, so `let x: u8 = 200 +
# 100`, whose SUM must fit rather than an arm, is still refused.
fn narrow_congs_fit(env: *NarrowEnv, e: *Expr, decl: TypeKind) -> i32
    if e == null
        return -1
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        if narrow_arms_fit(env, e, decl) == 1
            return 1
        return -1
    if e.kind == ExprKind.Binary and narrow_is_congruent_op(e.op) == 1 and e.wrapping == 0
        let l: i32 = narrow_congs_fit(env, e.left, decl)
        if l < 0
            return -1
        if e.op == OpKind.Shl
            # A shift's right operand is a count, not a value at the slot's
            # width (ritz0's `_arith_context_nodes` does not descend into it).
            return l
        let r: i32 = narrow_congs_fit(env, e.right, decl)
        if r < 0
            return -1
        if l == 1 or r == 1
            return 1
        return 0
    match narrow_const_value(env, e, 1)
        Some(v) =>
            if narrow_fits(v, decl) == 1
                return 0
            return -1
        None => pass
    # AGAST #4584: unary `-` and `~` are congruent mod 2**width as well
    # (ritz0's _CONGRUENT_UNOPS), so `let x: i32 = -match c` with literal arms
    # is judged by its arms, as `6 + match c` is.  After the constant check, so
    # `-128` into an i8 is still judged by its value.
    if e.kind == ExprKind.Unary and (e.op == OpKind.Neg or e.op == OpKind.BitNot)
        return narrow_congs_fit(env, e.operand, decl)
    let at: TypeKind = narrow_src_type_in(env, e, 1)
    if at == TypeKind.NarrowUnknown
        return -1
    if ty_bits(at) <= ty_bits(decl)
        return 0
    -1

fn narrow_report(sm: *Sema, stmt: *Stmt, decl: TypeKind, src: TypeKind)
    if stmt.var_src_file.len > 0
        eprints(stmt.var_src_file)
    else
        eprints("<input>")
    eprint_char(':')
    eprint_i64(stmt.span.line as i64)
    eprint_char(':')
    eprint_i64(stmt.span.col as i64)
    eprints(": error: implicit narrowing: `")
    narrow_eprint_name(stmt.var_name)
    eprints("` is declared `")
    eprints(ty_name(decl))
    eprints("` but its initialiser has type `")
    eprints(ty_name(src))
    eprints("`, and the compiler cannot prove the value fits. Write `<expr> as ")
    eprints(ty_name(decl))
    eprints("` if truncation is intended, or declare `")
    narrow_eprint_name(stmt.var_name)
    eprints("` as `")
    eprints(ty_name(src))
    eprints("`\n")
    sm.error_count = sm.error_count + 1
