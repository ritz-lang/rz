# ritz1/src/sha256.ritz - SHA-256, for interface-text store keys (AGAST #1901)
#
# ritz1 looks up an import's interface text in the artifact store under
#   sha256_hex("ritz-iface-text-v1\n" + sha256_hex(source bytes))
# (ritz0/module_interface.py text_key), so it needs the same hash as the
# writer.  A portable one-shot implementation: ritzlib has none, and the
# compiler may not import another project (cryptosec/lib/sha256.ritz).

var g_sha_k: [64]u32
var g_sha_k_ready: i32 = 0

fn sha_k_init()
    if g_sha_k_ready == 1
        return
    let k: *u32 = @g_sha_k[0]
    k[0] = 0x428a2f98
    k[1] = 0x71374491
    k[2] = 0xb5c0fbcf
    k[3] = 0xe9b5dba5
    k[4] = 0x3956c25b
    k[5] = 0x59f111f1
    k[6] = 0x923f82a4
    k[7] = 0xab1c5ed5
    k[8] = 0xd807aa98
    k[9] = 0x12835b01
    k[10] = 0x243185be
    k[11] = 0x550c7dc3
    k[12] = 0x72be5d74
    k[13] = 0x80deb1fe
    k[14] = 0x9bdc06a7
    k[15] = 0xc19bf174
    k[16] = 0xe49b69c1
    k[17] = 0xefbe4786
    k[18] = 0x0fc19dc6
    k[19] = 0x240ca1cc
    k[20] = 0x2de92c6f
    k[21] = 0x4a7484aa
    k[22] = 0x5cb0a9dc
    k[23] = 0x76f988da
    k[24] = 0x983e5152
    k[25] = 0xa831c66d
    k[26] = 0xb00327c8
    k[27] = 0xbf597fc7
    k[28] = 0xc6e00bf3
    k[29] = 0xd5a79147
    k[30] = 0x06ca6351
    k[31] = 0x14292967
    k[32] = 0x27b70a85
    k[33] = 0x2e1b2138
    k[34] = 0x4d2c6dfc
    k[35] = 0x53380d13
    k[36] = 0x650a7354
    k[37] = 0x766a0abb
    k[38] = 0x81c2c92e
    k[39] = 0x92722c85
    k[40] = 0xa2bfe8a1
    k[41] = 0xa81a664b
    k[42] = 0xc24b8b70
    k[43] = 0xc76c51a3
    k[44] = 0xd192e819
    k[45] = 0xd6990624
    k[46] = 0xf40e3585
    k[47] = 0x106aa070
    k[48] = 0x19a4c116
    k[49] = 0x1e376c08
    k[50] = 0x2748774c
    k[51] = 0x34b0bcb5
    k[52] = 0x391c0cb3
    k[53] = 0x4ed8aa4a
    k[54] = 0x5b9cca4f
    k[55] = 0x682e6ff3
    k[56] = 0x748f82ee
    k[57] = 0x78a5636f
    k[58] = 0x84c87814
    k[59] = 0x8cc70208
    k[60] = 0x90befffa
    k[61] = 0xa4506ceb
    k[62] = 0xbef9a3f7
    k[63] = 0xc67178f2
    g_sha_k_ready = 1

fn sha_rotr(x: u32, n: u32) -> u32
    (x >> n) | (x << (32 - n))

# One 64-byte block into the state h[0..8].
fn sha_block(h: *u32, block: *u8)
    var w: [64]u32
    var i: i32 = 0
    while i < 16
        let b0: u32 = block[i * 4] as u32
        let b1: u32 = block[i * 4 + 1] as u32
        let b2: u32 = block[i * 4 + 2] as u32
        let b3: u32 = block[i * 4 + 3] as u32
        w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        i += 1
    while i < 64
        let x15: u32 = w[i - 15]
        let x2: u32 = w[i - 2]
        let s0: u32 = sha_rotr(x15, 7) ^ sha_rotr(x15, 18) ^ (x15 >> 3)
        let s1: u32 = sha_rotr(x2, 17) ^ sha_rotr(x2, 19) ^ (x2 >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
        i += 1
    var a: u32 = h[0]
    var b: u32 = h[1]
    var c: u32 = h[2]
    var d: u32 = h[3]
    var e: u32 = h[4]
    var f: u32 = h[5]
    var g: u32 = h[6]
    var hh: u32 = h[7]
    i = 0
    while i < 64
        let big1: u32 = sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)
        let choice: u32 = (e & f) ^ ((~e) & g)
        let t1: u32 = hh + big1 + choice + g_sha_k[i] + w[i]
        let big0: u32 = sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)
        let major: u32 = (a & b) ^ (a & c) ^ (b & c)
        let t2: u32 = big0 + major
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i += 1
    h[0] = h[0] + a
    h[1] = h[1] + b
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
    h[5] = h[5] + f
    h[6] = h[6] + g
    h[7] = h[7] + hh

fn sha_hex_digit(v: u32) -> u8
    if v < 10
        return (48 + v) as u8
    (87 + v) as u8

# SHA-256 of data[0..len] as 64 lowercase hex digits into out[0..64]
# (not NUL-terminated).
pub fn sha256_hex(data: *u8, len: i64, out: *u8)
    sha_k_init()
    var h: [8]u32
    h[0] = 0x6a09e667
    h[1] = 0xbb67ae85
    h[2] = 0x3c6ef372
    h[3] = 0xa54ff53a
    h[4] = 0x510e527f
    h[5] = 0x9b05688c
    h[6] = 0x1f83d9ab
    h[7] = 0x5be0cd19
    let hp: *u32 = @h[0]
    var off: i64 = 0
    while off + 64 <= len
        sha_block(hp, data + off)
        off = off + 64
    # The tail, 0x80, zeros and the bit length: one or two blocks.
    var tail: [128]u8
    let tp: *u8 = @tail[0]
    var i: i64 = 0
    while i < 128
        tp[i] = 0
        i += 1
    let rest: i64 = len - off
    i = 0
    while i < rest
        tp[i] = data[off + i]
        i += 1
    tp[rest] = 0x80
    var tlen: i64 = 64
    if rest >= 56
        tlen = 128
    let bits: u64 = (len as u64) * 8
    var j: i64 = 0
    while j < 8
        tp[tlen - 1 - j] = ((bits >> ((j * 8) as u64)) & 255) as u8
        j += 1
    sha_block(hp, tp)
    if tlen == 128
        sha_block(hp, tp + 64)
    var n: i32 = 0
    while n < 8
        let word: u32 = h[n]
        var q: i32 = 0
        while q < 8
            let shift: u32 = (28 - q * 4) as u32
            out[n * 8 + q] = sha_hex_digit((word >> shift) & 15)
            q += 1
        n += 1
