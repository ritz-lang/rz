# ownership.ritz - move checking and drop insertion (AGAST #2158, #1854)
#
# LANGUAGE_SPEC §13.  A type is MOVE-ONLY iff it implements Drop, or a
# field or generic argument of it is move-only (checked transitively).
# Every other type copies, and nothing here ever touches it.
#
# Move check.  Using a move-only binding by value (binding it, assigning it,
# passing it to a by-value parameter, returning it, storing it in a struct
# literal field) moves it; any later use is a located error worded as ritz0's
# move_checker.py words it:
#
#     use of moved value: `t` (moved at F:L:C)
#     cannot borrow `t` - value has been moved
#
# The flow rules are ritz0's: a block stops being checked after a `return`
# directly in it; after an `if`, a binding moved in either arm that falls
# through counts as moved; assigning to a binding makes it an owner again.
# The check runs as each statement is emitted (like let_check.ritz), against
# the bindings this module registered, so shadowing resolves exactly as the
# emitter resolves names.
#
# Drops.  Each owned binding gets an `i1` drop flag (an alloca, hoisted to
# the entry block and zeroed there).  Declaring the binding with a value, or
# assigning to it, sets the flag; moving it clears it.  A drop is
# `if flag { flag = 0; glue(binding) }`, so a binding moved on only some
# paths is dropped exactly on the others.  Drops are emitted
#   - at the end of each block, for the bindings it declared (reverse order);
#   - on `break` / `continue`, for the bindings of the loop body;
#   - on assignment, for the old value (copied aside first, so the new value
#     may still read it);
#   - before every `ret` of the fn, for every binding of the fn (reverse
#     declaration order): own_end_fn inserts them into the finished body,
#     because ritz1 emits `ret` from dozens of sites.  A binding whose block
#     already ended has a cleared flag, so it is not dropped twice.
# Glue: a type's own `drop` (if it has one) runs first, then each move-only
# field is dropped in declaration order.  An array drops its elements in
# index order; an enum (a user enum, or a tagged Option / Result) drops the
# payload of the variant its tag names (AGAST #2165).
#
# Temporaries (AGAST #2165).  A call whose by-value move-only result nobody
# owns -- an expression statement `make(1)`, `make(1).id`, an argument lent
# to an `@T` parameter -- is marked by the move check; emit_expr spills its
# value with a drop flag, and the temporary drops at the end of its
# statement, or of the `if` / `while` condition it is in.  A `return`'s
# temporaries drop before the `ret`, with the fn's bindings.  As in ritz0, a
# method call's result is not a temporary.
#
# Loops (AGAST #2165, ritz0's _check_loop).  A binding declared outside a
# loop must not reach the loop head moved, or the next iteration uses a
# moved value.  ritz1 checks the body once, as it emits it, so alongside
# `moved` each binding carries `shadow`: moved-if-the-head-was-moved.  Uses
# while shadowed are recorded; at the loop's end, if the body's fall-through
# or a `continue` reaches the head with the binding moved, each recorded use
# is reported, as ritz0's re-check of the body reports it.
#
# A fn without move-only bindings, in a module without `impl Drop`, emits
# nothing extra.
#
# Not yet: moves out of a field, and merging match-arm moves (AGAST #2168).
# Tests: ritz0/test_ownership_free_count.py (shared with ritz0) and
# ritz0/test_ritz1_ownership.py.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.memory

import ast
import ast_helpers
import emitter_core
import emitter_expr        # emit_member_gep_from_ptr
import emitter_expr_call   # method_callee_def, find_spec_impl_method
import ll_copy_scan        # ll_line_len, ll_starts_with

const OWN_INIT_CAP: i32 = 16
# Deeper than any real struct nesting; stops a malformed recursive type.
const OWN_MAX_DEPTH: i32 = 32

# Loop move-check events (OwnState.loop_ev): [kind, slot, depth, a, b, c, d]
# with `slot` the binding's storage register (its identity) and `depth` the
# loop nesting depth they belong to.
const OWN_EV_INTS: i32 = 7
const OWN_EV_SAVE: i32 = 1    # loop entry: a = shadow before, b = moved, c:d = its move
const OWN_EV_USE: i32 = 2     # a use while shadowed: a = 1 for a borrow, c:d = where
const OWN_EV_HEAD: i32 = 3    # `continue` with it moved: c:d = the move
const OWN_EV_BREAK: i32 = 4   # `break` with it moved: c:d = the move

pub fn own_init(s: *EmitterState)
    let o: *OwnState = malloc(sizeof(OwnState)) as *OwnState
    o.live = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_count = 0
    o.live_cap = OWN_INIT_CAP
    o.scope_start = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_dead = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_count = 0
    o.scope_cap = OWN_INIT_CAP
    o.all = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.all_count = 0
    o.all_cap = OWN_INIT_CAP
    o.loop_base = -1
    o.ret_seq = 0
    o.has_drop = 0 - 1
    o.temp_exprs = malloc((OWN_INIT_CAP as i64) * 8) as **Expr
    o.temp_expr_count = 0
    o.temp_expr_cap = OWN_INIT_CAP
    o.temps = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.temp_count = 0
    o.temp_cap = OWN_INIT_CAP
    o.stmt_mark = 0
    o.loop_ev = malloc((OWN_INIT_CAP * OWN_EV_INTS * 4) as i64) as *i32
    o.loop_ev_count = 0
    o.loop_ev_cap = OWN_INIT_CAP
    o.loop_depth = 0
    o.last_pop_dead = 0
    s.own = o

fn own_live_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.live
    return @base[i]

fn own_all_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.all
    return @base[i]

fn own_copy_binding(dst: *OwnBinding, src: *OwnBinding)
    memcpy(dst as *u8, src as *u8, sizeof(OwnBinding))

fn own_temp_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.temps
    return @base[i]

# Event `i` of the loop move check (OWN_EV_INTS i32s).
fn own_ev_at(o: *OwnState, i: i32) -> *i32
    let base: *i32 = o.loop_ev
    return base + i * OWN_EV_INTS

fn own_ev_push(o: *OwnState, kind: i32, slot: i32, a: i32, b: i32, c: i32, d: i32)
    if o.loop_ev_count >= o.loop_ev_cap
        let cap: i32 = o.loop_ev_cap * 2
        o.loop_ev = realloc(o.loop_ev as *u8, (cap * OWN_EV_INTS * 4) as i64) as *i32
        o.loop_ev_cap = cap
    let ev: *i32 = own_ev_at(o, o.loop_ev_count)
    ev[0] = kind
    ev[1] = slot
    ev[2] = o.loop_depth
    ev[3] = a
    ev[4] = b
    ev[5] = c
    ev[6] = d
    o.loop_ev_count = o.loop_ev_count + 1

# =============================================================================
# Move-only types
# =============================================================================

# Length of `name` up to its first `$` (a monomorph's base name).
fn own_base_len(name: *u8, len: i32) -> i32
    var i: i32 = 0
    while i < len
        if *(name + i) == 36   # '$'
            return i
        i += 1
    len

# 1 when the type itself has an `impl Drop`.
fn own_has_drop_impl(s: *EmitterState, name: *u8, len: i32) -> i32
    let base_len: i32 = own_base_len(name, len)
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if ib.trait_name != null and name_eq(ib.trait_name, ib.trait_name_len, c"Drop", 4) == 1
            if name_eq(ib.type_name, ib.type_name_len, name, base_len) == 1
                return 1
        ib = ib.next
    0

fn own_move_only_depth(s: *EmitterState, name: *u8, len: i32, depth: i32) -> i32
    if name == null or len <= 0 or depth > OWN_MAX_DEPTH
        return 0
    if own_has_drop_impl(s, name, len) == 1
        return 1
    # Generic arguments: `Vec$Tracked`, `Pair$i32$Tracked`.
    let base_len: i32 = own_base_len(name, len)
    var i: i32 = base_len
    while i < len
        let start: i32 = i + 1
        var j: i32 = start
        while j < len and *(name + j) != 36
            j += 1
        if j > start and own_move_only_depth(s, name + start, j - start, depth + 1) == 1
            return 1
        i = j
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        # A user enum is move-only when a variant's payload is (AGAST #2165).
        let ei: i32 = user_enum_index(name, len)
        if ei < 0
            return 0
        var vi: i32 = 0
        while vi < enum_variant_count(ei)
            if own_fields_move_only(s, enum_variant_fields(ei, vi), depth + 1) == 1
                return 1
            vi += 1
        return 0
    own_fields_move_only(s, st.fields, depth + 1)

# The leaf elements of an N-D array shape, when they are structs: 1, with
# their total count and type.
fn own_shape_elems(sh: *ArrayShape, out_n: *i32, out_name: **u8, out_len: *i32) -> i32
    if sh.leaf_type != TYPE_STRUCT or sh.leaf_name_len <= 0
        return 0
    var n: i32 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * sh.dims[d]
        d += 1
    *out_n = n
    *out_name = sh.leaf_name
    *out_len = sh.leaf_name_len
    1

# An array field of struct elements: 1, with the element count (every
# leaf of an N-D array) and the element type.
fn own_field_array(f: *StructField, out_n: *i32, out_name: **u8, out_len: *i32) -> i32
    if f.field_type != TYPE_ARRAY
        return 0
    if f.array_shape != null
        return own_shape_elems(f.array_shape, out_n, out_name, out_len)
    if f.array_elem_type != TYPE_STRUCT or f.array_size <= 0
        return 0
    *out_n = f.array_size
    *out_name = f.array_elem_type_name
    *out_len = f.array_elem_type_name_len
    1

# 1 when field `f` (of a struct or an enum payload) holds a move-only value.
fn own_field_move_only(s: *EmitterState, f: *StructField, depth: i32) -> i32
    if f.field_type == TYPE_STRUCT
        return own_move_only_depth(s, f.field_type_name, f.field_type_name_len, depth)
    var n: i32 = 0
    var en: *u8 = null
    var el: i32 = 0
    if own_field_array(f, @n, @en, @el) == 1
        return own_move_only_depth(s, en, el, depth)
    0

fn own_fields_move_only(s: *EmitterState, fields: *StructField, depth: i32) -> i32
    var f: *StructField = fields
    while f != null
        if own_field_move_only(s, f, depth) == 1
            return 1
        f = f.next
    0

# 1 when the module has an `impl Drop` at all; without one nothing is
# move-only, and the hooks skip their work.
fn own_any_drop(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.has_drop >= 0
        return o.has_drop
    o.has_drop = 0
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if ib.trait_name != null and name_eq(ib.trait_name, ib.trait_name_len, c"Drop", 4) == 1
            o.has_drop = 1
            return 1
        ib = ib.next
    0

pub fn own_type_is_move_only(s: *EmitterState, name: *u8, len: i32) -> i32
    if own_any_drop(s) == 0
        return 0
    own_move_only_depth(s, name, len, 0)

# =============================================================================
# Drop glue
# =============================================================================

# Emit `call void @<T's drop>(ptr %ptr)` if T has its own drop.
fn own_emit_own_drop(s: *EmitterState, ptr: i32, name: *u8, len: i32)
    if own_has_drop_impl(s, name, len) == 0
        return
    let base_len: i32 = own_base_len(name, len)
    if base_len < len
        # A generic impl: monomorph specialised its methods as `Box$i32_drop`.
        let fd: *FnDef = find_spec_impl_method(s, name, len, c"drop", 4)
        if fd == null
            return
        emit_str(s, c"  call void @")
        emit_name(s, fd.name, fd.name_len)
        emit_str(s, c"(ptr ")
        emit_reg(s, ptr)
        emit_str(s, c")\n")
        add_extern(s, fd.name, fd.name_len)
        return
    emit_str(s, c"  call void @")
    emit_name(s, name, len)
    emit_str(s, c"_drop(ptr ")
    emit_reg(s, ptr)
    emit_str(s, c")\n")
    add_method_extern(s, name, len, c"drop", 4)

# Drop the value of type `name` at `ptr`: its own drop, then its move-only
# struct fields in declaration order, or an enum's payload.
fn own_emit_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, depth: i32)
    if depth > OWN_MAX_DEPTH
        return
    own_emit_own_drop(s, ptr, name, len)
    if is_tagged_enum_type(name, len) == 1
        own_emit_tagged_glue(s, ptr, name, len, depth)
        return
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        let ei: i32 = user_enum_index(name, len)
        if ei >= 0
            own_emit_enum_glue(s, ptr, name, len, ei, depth)
        return
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0) == 1
            var r: MemberPtrResult
            emit_member_gep_from_ptr(s, @r, ptr, st, idx, f)
            own_emit_field_glue(s, r.reg, f, depth + 1)
        idx += 1
        f = f.next

# Drop the move-only field `f` stored at `ptr`.
fn own_emit_field_glue(s: *EmitterState, ptr: i32, f: *StructField, depth: i32)
    if f.field_type == TYPE_STRUCT
        own_emit_glue(s, ptr, f.field_type_name, f.field_type_name_len, depth)
        return
    var n: i32 = 0
    var en: *u8 = null
    var el: i32 = 0
    if own_field_array(f, @n, @en, @el) == 1
        own_emit_array_glue(s, ptr, n, en, el, depth)

# A value (count 0) or an array of `count` elements, at `ptr`.
fn own_emit_value_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, count: i32)
    if count > 0
        own_emit_array_glue(s, ptr, count, name, len, 0)
    else
        own_emit_glue(s, ptr, name, len, 0)

# Drop `n` elements of type `name` from `ptr` on, in index order, with a
# loop (its counter alloca is hoisted to the entry block).
fn own_emit_array_glue(s: *EmitterState, ptr: i32, n: i32, name: *u8, len: i32, depth: i32)
    if n <= 0 or depth > OWN_MAX_DEPTH
        return
    let ctr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ctr)
    emit_str(s, c" = alloca i64  ; array drop index\n  store i64 0, ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n")
    let head: i32 = next_label(s)
    let body: i32 = next_label(s)
    let done: i32 = next_label(s)
    emit_str(s, c"  br label %")
    emit_label(s, head)
    emit_str(s, c"\n")
    begin_block(s, head)
    let i: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, i)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n")
    let more: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, more)
    emit_str(s, c" = icmp slt i64 ")
    emit_reg(s, i)
    emit_str(s, c", ")
    emit_int(s, n as i64)
    emit_str(s, c"\n  br i1 ")
    emit_reg(s, more)
    emit_str(s, c", label %")
    emit_label(s, body)
    emit_str(s, c", label %")
    emit_label(s, done)
    emit_str(s, c"\n")
    begin_block(s, body)
    let ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ep)
    emit_str(s, c" = getelementptr ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, i)
    emit_str(s, c"\n")
    own_emit_glue(s, ep, name, len, depth + 1)
    let nx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, nx)
    emit_str(s, c" = add i64 ")
    emit_reg(s, i)
    emit_str(s, c", 1\n  store i64 ")
    emit_reg(s, nx)
    emit_str(s, c", ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n  br label %")
    emit_label(s, head)
    emit_str(s, c"\n")
    begin_block(s, done)

# `if tag == <tag> {`: branch on the tag of the enum `ename` at `ptr` and
# open the block that drops the payload.  Returns the payload's address
# (field 2 of every payload-carrying enum layout); *out_next gets the label
# own_case_end closes the block with.
fn own_case_begin(s: *EmitterState, ptr: i32, ename: *u8, elen: i32, tag: i32, out_next: *i32) -> i32
    let tp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, ename, elen)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let t: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, t)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tp)
    emit_str(s, c"\n")
    let c: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, c)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, t)
    emit_str(s, c", ")
    emit_int(s, tag as i64)
    emit_str(s, c"\n")
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, c)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    let pp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, ename, elen)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i32 0, i32 2\n")
    *out_next = next
    pp

fn own_case_end(s: *EmitterState, next: i32)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)

# Option$T / Result$T$E: tag 0 holds the Some / Ok payload, tag 1 Result's
# Err payload.
fn own_emit_tagged_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, depth: i32)
    var variants: i32 = 1
    if len > 7 and name_eq(name, 7, c"Result$", 7) == 1
        variants = 2
    var v: i32 = 0
    while v < variants
        var al: i32 = 0
        let a: *u8 = tagged_enum_arg(s, name, len, v, @al)
        if a != null and own_move_only_depth(s, a, al, depth + 1) == 1
            var next: i32 = 0
            let pp: i32 = own_case_begin(s, ptr, name, len, v, @next)
            own_emit_glue(s, pp, a, al, depth + 1)
            own_case_end(s, next)
        v += 1

# A user enum: its tag is the variant's index; the payload's fields sit in
# the payload bytes as variant_payload_size_align lays them out.
fn own_emit_enum_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, ei: i32, depth: i32)
    var vi: i32 = 0
    while vi < enum_variant_count(ei)
        let fields: *StructField = enum_variant_fields(ei, vi)
        if own_fields_move_only(s, fields, depth + 1) == 1
            var next: i32 = 0
            let pp: i32 = own_case_begin(s, ptr, name, len, vi, @next)
            var offset: i64 = 0
            var f: *StructField = fields
            while f != null
                var falign: i64 = 8
                var fsize: i64 = 8
                if f.field_type == TYPE_ARRAY
                    fsize = field_array_size_align(s, f, @falign)
                else
                    fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
                if falign < 1
                    falign = 1
                let rem: i64 = offset % falign
                if rem != 0
                    offset = offset + (falign - rem)
                if own_field_move_only(s, f, depth + 1) == 1
                    var fp: i32 = pp
                    if offset > 0
                        fp = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, fp)
                        emit_str(s, c" = getelementptr i8, ptr ")
                        emit_reg(s, pp)
                        emit_str(s, c", i64 ")
                        emit_int(s, offset)
                        emit_str(s, c"\n")
                    own_emit_field_glue(s, fp, f, depth + 1)
                offset = offset + fsize
                f = f.next
            own_case_end(s, next)
        vi += 1

# `if flag { flag = 0; glue(slot) }`, as basic blocks of the current fn.
fn own_emit_drop(s: *EmitterState, b: *OwnBinding)
    let saved: i32 = last_expr_here(s)
    let f: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, f)
    emit_str(s, c" = load i1, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, f)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    emit_str(s, c"  store i1 0, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    own_emit_value_glue(s, b.slot, b.type_name, b.type_name_len, b.count)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)
    # The block's value (an `if` arm's) still dominates the new block.
    if saved != 0
        set_last_expr(s, saved)

fn own_store_flag(s: *EmitterState, b: *OwnBinding, v: i32)
    emit_str(s, c"  store i1 ")
    emit_int(s, v as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")

# =============================================================================
# Bindings and scopes
# =============================================================================

fn own_grow_live(o: *OwnState)
    if o.live_count < o.live_cap
        return
    let cap: i32 = o.live_cap * 2
    o.live = realloc(o.live as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_cap = cap

fn own_grow_all(o: *OwnState)
    if o.all_count < o.all_cap
        return
    let cap: i32 = o.all_cap * 2
    o.all = realloc(o.all as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.all_cap = cap

pub fn own_push_scope(s: *EmitterState)
    let o: *OwnState = s.own
    if o.scope_count >= o.scope_cap
        let cap: i32 = o.scope_cap * 2
        o.scope_start = realloc(o.scope_start as *u8, (cap as i64) * 4) as *i32
        o.scope_dead = realloc(o.scope_dead as *u8, (cap as i64) * 4) as *i32
        o.scope_cap = cap
    let starts: *i32 = o.scope_start
    let deads: *i32 = o.scope_dead
    starts[o.scope_count] = o.live_count
    deads[o.scope_count] = 0
    o.scope_count = o.scope_count + 1

fn own_scope_is_dead(o: *OwnState) -> i32
    if o.scope_count <= 0
        return 0
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1]

fn own_mark_dead(o: *OwnState)
    if o.scope_count <= 0
        return
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1] = 1

# Drop live[from..] in reverse, without unregistering them.
fn own_drop_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    var i: i32 = o.live_count - 1
    while i >= from
        own_emit_drop(s, own_live_at(o, i))
        i -= 1

# Close the innermost block: drop what it declared (unless the block ended
# in a `return`, after which nothing is reachable) and forget it.  Returns 1
# when the block returned (for the `if` merge in the move check).
pub fn own_pop_scope(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.scope_count <= 0
        return 0
    let starts: *i32 = o.scope_start
    let start: i32 = starts[o.scope_count - 1]
    let dead: i32 = own_scope_is_dead(o)
    if dead == 0
        own_drop_from(s, start)
    o.live_count = start
    o.scope_count = o.scope_count - 1
    o.last_pop_dead = dead
    dead

# Enter / leave a loop body.  `break` and `continue` drop live[loop_base..].
# Entering shadows every unmoved binding (all are outside the loop), saving
# its state for own_loop_exit.
pub fn own_loop_enter(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.loop_base
    o.loop_base = o.live_count
    o.loop_depth = o.loop_depth + 1
    var i: i32 = 0
    while i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        own_ev_push(o, OWN_EV_SAVE, b.slot, b.shadow, b.moved, b.move_line, b.move_col)
        b.shadow = 1 - b.moved
        i += 1
    old

# The first event of `kind` at loop depth `depth` for the binding at `slot`.
fn own_ev_find(o: *OwnState, kind: i32, slot: i32, depth: i32) -> *i32
    var j: i32 = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[0] == kind and ev[1] == slot and ev[2] == depth
            return ev
        j += 1
    null

# After the loop body (its scope already popped, so every live binding is
# from outside the loop).  A binding reaches the head moved when the body
# falls through with it moved or a `continue` leaves with it moved; then
# every use recorded while it was shadowed is an error, as in ritz0's
# re-check of the body.  After the loop a binding is moved if it was at
# entry, at the head, or at a `break`.
pub fn own_loop_exit(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    let depth: i32 = o.loop_depth
    let n: i32 = o.live_count
    # Per live binding: moved at the head, and where.
    var head: *i32 = null
    if n > 0
        head = malloc((n as i64) * 12) as *i32
    var i: i32 = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        head[i * 3] = 0
        if o.last_pop_dead == 0 and b.moved == 1
            head[i * 3] = 1
            head[i * 3 + 1] = b.move_line
            head[i * 3 + 2] = b.move_col
        else
            let hv: *i32 = own_ev_find(o, OWN_EV_HEAD, b.slot, depth)
            if hv != null
                head[i * 3] = 1
                head[i * 3 + 1] = hv[5]
                head[i * 3 + 2] = hv[6]
        i += 1
    # The recorded uses, in order: an error, or (unreported, in an inner
    # loop) a use the enclosing loop's check still has to see.
    var j: i32 = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[0] == OWN_EV_USE and ev[2] == depth
            var bi: i32 = n - 1
            while bi >= 0
                let cb: *OwnBinding = own_live_at(o, bi)
                if cb.slot == ev[1]
                    break
                bi -= 1
            if bi >= 0 and head[bi * 3] == 1
                let ub: *OwnBinding = own_live_at(o, bi)
                if ev[3] == 1
                    own_error_borrow_at(s, ev[5], ev[6], ub)
                else
                    own_error_use_at(s, ev[5], ev[6], ub, head[bi * 3 + 1], head[bi * 3 + 2])
            else if bi >= 0 and depth > 1
                let sv: *i32 = own_ev_find(o, OWN_EV_SAVE, ev[1], depth)
                if sv != null and sv[3] == 1
                    ev[2] = depth - 1
        j += 1
    # The state after the loop, and the enclosing loop's shadow.
    i = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        let sv: *i32 = own_ev_find(o, OWN_EV_SAVE, b.slot, depth)
        var am: i32 = 0
        var al: i32 = 0
        var ac: i32 = 0
        if sv != null and sv[4] == 1
            am = 1
            al = sv[5]
            ac = sv[6]
        else if head[i * 3] == 1
            am = 1
            al = head[i * 3 + 1]
            ac = head[i * 3 + 2]
        else
            let bv: *i32 = own_ev_find(o, OWN_EV_BREAK, b.slot, depth)
            if bv != null
                am = 1
                al = bv[5]
                ac = bv[6]
        b.moved = am
        if am == 1
            b.move_line = al
            b.move_col = ac
        if sv != null
            b.shadow = sv[3]
        i += 1
    if head != null
        free(head as *u8)
    # Forget this loop's events.
    var w: i32 = 0
    j = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[2] < depth
            if w != j
                memcpy(own_ev_at(o, w) as *u8, ev as *u8, (OWN_EV_INTS * 4) as i64)
            w += 1
        j += 1
    o.loop_ev_count = w
    o.loop_depth = depth - 1
    o.loop_base = old

# Before a `break` (is_continue 0) / `continue` (1) branches out of the
# loop body: record the moved outer bindings, then drop the body's.
pub fn own_loop_jump(s: *EmitterState, is_continue: i32)
    let o: *OwnState = s.own
    if o.loop_base < 0
        return
    if own_scope_is_dead(o) == 1
        return
    var kind: i32 = OWN_EV_BREAK
    if is_continue == 1
        kind = OWN_EV_HEAD
    var i: i32 = 0
    while i < o.loop_base and i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        if b.moved == 1 and own_ev_find(o, kind, b.slot, o.loop_depth) == null
            own_ev_push(o, kind, b.slot, 0, 1, b.move_line, b.move_col)
        i += 1
    if o.live_count <= o.loop_base
        return
    own_drop_from(s, o.loop_base)

# =============================================================================
# Temporaries (AGAST #2165)
# =============================================================================

# After emit_expr emitted call `e` as register `reg`: if the move check
# marked it a temporary, spill it with a set drop flag and queue its drop.
pub fn own_note_temp(s: *EmitterState, e: *Expr, reg: i32)
    let o: *OwnState = s.own
    if o.temp_expr_count == 0 or reg == 0
        return
    let te: **Expr = o.temp_exprs
    var i: i32 = 0
    while i < o.temp_expr_count and te[i] != e
        i += 1
    if i >= o.temp_expr_count
        return
    o.temp_expr_count = o.temp_expr_count - 1
    te[i] = te[o.temp_expr_count]
    var len: i32 = 0
    let name: *u8 = own_call_ret_type(s, e, @len)
    if name == null
        return
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c"  ; temporary\n  store ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c" ")
    emit_reg(s, reg)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    let flag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, flag)
    emit_str(s, c" = alloca i1  ; drop flag\n")
    if o.temp_count >= o.temp_cap
        let cap: i32 = o.temp_cap * 2
        o.temps = realloc(o.temps as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
        o.temp_cap = cap
    let b: *OwnBinding = own_temp_at(o, o.temp_count)
    b.name = null
    b.name_len = 0
    b.local_idx = 0 - 1
    b.slot = slot
    b.flag = flag
    b.type_name = name
    b.type_name_len = len
    b.moved = 0
    b.move_line = 0
    b.move_col = 0
    b.count = 0
    b.shadow = 0
    o.temp_count = o.temp_count + 1
    # In `all` too, so a `ret` before its drop (a `return`'s value) drops it.
    own_grow_all(o)
    own_copy_binding(own_all_at(o, o.all_count), b)
    o.all_count = o.all_count + 1
    own_store_flag(s, b, 1)

# Drop temps[from..] (newest first) and forget them.
fn own_drop_temps_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    if o.temp_count <= from
        return
    if own_scope_is_dead(o) == 0
        var i: i32 = o.temp_count - 1
        while i >= from
            own_emit_drop(s, own_temp_at(o, i))
            i -= 1
    o.temp_count = from

# Bracket each statement: own_stmt_begin before it, own_stmt_end (with
# what begin returned) after, which drops the temporaries it made.
pub fn own_stmt_begin(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.stmt_mark
    o.stmt_mark = o.temp_count
    old

pub fn own_stmt_end(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)
    o.stmt_mark = old

# After an `if` / `while` condition, before its branch: its temporaries
# drop here, as ritz0 drops them.
pub fn own_cond_end(s: *EmitterState)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)

# Register the local at `idx` if it is a move-only value.  `owned` is 1 when
# it starts out holding a value (an initialised declaration, a parameter).
fn own_register(s: *EmitterState, idx: i32, owned: i32)
    let loc: *LocalVar = local_at(s, idx)
    var name: *u8 = loc.type_name
    var len: i32 = loc.type_name_len
    var count: i32 = 0
    if loc.var_type == TYPE_ARRAY
        # `[N]T` / `[N][M]..T` of move-only T (AGAST #2165).
        if loc.array_shape != null
            if own_shape_elems(loc.array_shape, @count, @name, @len) == 0
                return
        else if loc.array_elem_type == TYPE_STRUCT and loc.array_size > 0
            count = loc.array_size
        else
            return
    else if loc.var_type != TYPE_STRUCT
        return
    if own_type_is_move_only(s, name, len) == 0
        return
    let o: *OwnState = s.own
    # A redeclaration that reuses its storage is the same binding.
    var i: i32 = 0
    while i < o.live_count
        let lb: *OwnBinding = own_live_at(o, i)
        if lb.slot == loc.reg
            lb.local_idx = idx
            lb.moved = 0
            lb.shadow = 0
            own_store_flag(s, lb, owned)
            return
        i += 1
    let flag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, flag)
    emit_str(s, c" = alloca i1  ; drop flag\n")
    own_grow_live(o)
    let b: *OwnBinding = own_live_at(o, o.live_count)
    b.name = loc.name
    b.name_len = loc.name_len
    b.local_idx = idx
    b.slot = loc.reg
    b.flag = flag
    b.type_name = name
    b.type_name_len = len
    b.moved = 0
    b.move_line = 0
    b.move_col = 0
    b.count = count
    b.shadow = 0
    o.live_count = o.live_count + 1
    own_grow_all(o)
    own_copy_binding(own_all_at(o, o.all_count), b)
    o.all_count = o.all_count + 1
    own_store_flag(s, b, owned)

# Start of a fn body (after its params are bound): the fn's outermost block,
# holding its by-value move-only params, which the callee owns.
pub fn own_begin_fn(s: *EmitterState, params: *Param)
    let o: *OwnState = s.own
    o.live_count = 0
    o.scope_count = 0
    o.all_count = 0
    o.loop_base = -1
    o.ret_seq = 0
    o.temp_expr_count = 0
    o.temp_count = 0
    o.stmt_mark = 0
    o.loop_ev_count = 0
    o.loop_depth = 0
    o.last_pop_dead = 0
    own_push_scope(s)
    var p: *Param = params
    while p != null
        if p.param_type == TYPE_STRUCT
            let idx: i32 = find_local_idx(s, p.name, p.name_len)
            if idx >= 0
                own_register(s, idx, 1)
        p = p.next

# After a `let` / `var`: register the binding it declared.  `before` is
# s.local_count before the declaration (see let_mark_decl).
pub fn own_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx < before or idx < 0
        return
    var owned: i32 = 0
    if stmt.var_init != null
        owned = 1
    own_register(s, idx, owned)

# The registered binding `name` currently resolves to, or null.
fn own_lookup(s: *EmitterState, name: *u8, len: i32) -> *OwnBinding
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return null
    var i: i32 = o.live_count - 1
    while i >= 0
        let b: *OwnBinding = own_live_at(o, i)
        if b.local_idx == idx and name_eq(b.name, b.name_len, name, len) == 1
            return b
        i -= 1
    null

# =============================================================================
# Move check
# =============================================================================

fn own_eprint_loc(line: i32, col: i32)
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)

fn own_eprint_name(name: *u8, len: i32)
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1

fn own_error_use_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding, move_line: i32, move_col: i32)
    own_eprint_loc(line, col)
    eprints_cstr(c": error: use of moved value: `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` (moved at ")
    own_eprint_loc(move_line, move_col)
    eprints_cstr(c")\n")
    s.error_count = s.error_count + 1

fn own_error_borrow_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding)
    own_eprint_loc(line, col)
    eprints_cstr(c": error: cannot borrow `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` - value has been moved\n")
    s.error_count = s.error_count + 1

fn own_error_use(s: *EmitterState, e: *Expr, b: *OwnBinding)
    own_error_use_at(s, e.span.line, e.span.col, b, b.move_line, b.move_col)

fn own_error_borrow(s: *EmitterState, e: *Expr, b: *OwnBinding)
    own_error_borrow_at(s, e.span.line, e.span.col, b)

# A use of an unmoved binding inside a loop: if the binding is shadowed (it
# would be moved here had the loop head been reached with it moved), record
# the use for own_loop_exit.
fn own_note_use(s: *EmitterState, b: *OwnBinding, line: i32, col: i32, borrow: i32)
    let o: *OwnState = s.own
    if o.loop_depth > 0 and b.shadow == 1 and b.moved == 0
        own_ev_push(o, OWN_EV_USE, b.slot, borrow, 0, line, col)

# The move-only struct type a call returns by value (its length in
# *out_len), or null.
fn own_call_ret_type(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    if e.kind != EXPR_CALL
        return null
    let f: *FnDef = find_call_fn(s, e)
    if f == null or f.return_type != TYPE_STRUCT or f.return_type_name_len <= 0
        return null
    if own_type_is_move_only(s, f.return_type_name, f.return_type_name_len) == 0
        return null
    *out_len = f.return_type_name_len
    f.return_type_name

# `e`, a call whose move-only result nobody takes, yields a temporary:
# remember it for own_note_temp.
fn own_mark_temp(s: *EmitterState, e: *Expr)
    var len: i32 = 0
    if own_call_ret_type(s, e, @len) == null
        return
    let o: *OwnState = s.own
    if o.temp_expr_count >= o.temp_expr_cap
        let cap: i32 = o.temp_expr_cap * 2
        o.temp_exprs = realloc(o.temp_exprs as *u8, (cap as i64) * 8) as **Expr
        o.temp_expr_cap = cap
    let te: **Expr = o.temp_exprs
    te[o.temp_expr_count] = e
    o.temp_expr_count = o.temp_expr_count + 1

# 1 when an argument bound to `p` is passed by value (a move).  A reference
# param borrows its argument; an unknown callee is taken as by-value.
fn own_param_moves(p: *Param) -> i32
    if p == null
        return 1
    if p.param_type == TYPE_REF or p.param_type == TYPE_MUT_REF or p.param_type == TYPE_PTR or p.param_type == TYPE_PTR_PTR
        return 0
    1

fn own_walk_args(s: *EmitterState, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        own_walk(s, a, own_param_moves(p))
        if p != null
            p = p.next
        a = a.next

# The struct a method receiver names, as let_check's let_recv_type does.
fn own_recv_def(s: *EmitterState, e: *Expr) -> *FnDef
    let recv: *Expr = e.left
    if recv == null or recv.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, recv.ident_ptr, recv.ident_len)
    if loc == null or loc.type_name_len <= 0
        return null
    return method_callee_def(s, loc.type_name, loc.type_name_len, e.ident_ptr, e.ident_len)

# Check one expression, in evaluation order.  `mv` is 1 when its value is
# used by value (a move for a move-only binding).  Mirrors ritz0's
# MoveChecker._check_expr.  Match / if-expression arms are checked as their
# bodies are emitted (own_check_arm).
pub fn own_walk(s: *EmitterState, e: *Expr, mv: i32)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_IDENT
        let b: *OwnBinding = own_lookup(s, e.ident_ptr, e.ident_len)
        if b == null
            return
        if b.moved == 1
            own_error_use(s, e, b)
            return
        own_note_use(s, b, e.span.line, e.span.col, 0)
        if mv == 1
            b.moved = 1
            b.move_line = e.span.line
            b.move_col = e.span.col
            own_store_flag(s, b, 0)
    else if k == EXPR_UNARY
        if (e.op == OP_ADDR or e.op == OP_ADDR_MUT) and e.operand != null and e.operand.kind == EXPR_IDENT
            let bb: *OwnBinding = own_lookup(s, e.operand.ident_ptr, e.operand.ident_len)
            if bb != null
                if bb.moved == 1
                    own_error_borrow(s, e, bb)
                else
                    own_note_use(s, bb, e.span.line, e.span.col, 1)
            return
        own_walk(s, e.operand, 0)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        own_walk(s, e.left, 0)
        own_walk(s, e.right, 0)
    else if k == EXPR_MEMBER or k == EXPR_CAST
        own_walk(s, e.left, 0)
    else if k == EXPR_TRY
        own_walk(s, e.left, mv)
    else if k == EXPR_CALL
        # sizeof's operand is never evaluated (ritz0 #2124).
        if e.func_name_len == 6 and name_eq(e.func_name, e.func_name_len, c"sizeof", 6) == 1
            return
        var p: *Param = null
        let f: *FnDef = find_call_fn(s, e)
        if f != null
            p = f.params
        own_walk_args(s, e.args, p)
        # A result nobody takes is a temporary (AGAST #2165).
        if mv == 0 and f != null
            own_mark_temp(s, e)
    else if k == EXPR_METHOD
        # The receiver is passed by pointer.  A call result as receiver is
        # not a temporary here: like ritz0, ritz1 drops no method's.
        var rmv: i32 = 0
        if e.left != null and e.left.kind == EXPR_CALL
            rmv = 1
        own_walk(s, e.left, rmv)
        var mp: *Param = null
        let m: *FnDef = own_recv_def(s, e)
        if m != null
            mp = m.params
            if mp != null
                mp = mp.next
        own_walk_args(s, e.args, mp)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            own_walk(s, fi.value, 1)
            fi = fi.next
    else if k == EXPR_MATCH
        own_walk(s, e.left, 1)
    else if k == EXPR_IF
        own_walk(s, e.left, 0)

# 1 when the move check should look at code at this point.
fn own_checking(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.live_count == 0 and own_any_drop(s) == 0
        return 0
    if own_scope_is_dead(o) == 1
        return 0
    1

# The binding a whole-binding assignment `x = v` writes, or null.
fn own_assign_target(s: *EmitterState, stmt: *Stmt) -> *OwnBinding
    if stmt.kind != STMT_ASSIGN
        return null
    if stmt.assign_target_len > 0
        return own_lookup(s, stmt.assign_target, stmt.assign_target_len)
    let t: *Expr = stmt.if_cond as *Expr
    if t != null and t.kind == EXPR_IDENT
        return own_lookup(s, t.ident_ptr, t.ident_len)
    null

# Check one statement before it is emitted (emit_stmt).  Nested statement
# lists are checked as emit_stmt reaches them.  Mirrors ritz0's _check_stmt.
pub fn own_check_stmt(s: *EmitterState, stmt: *Stmt)
    if own_checking(s) == 0
        return
    let k: i32 = stmt.kind
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        own_walk(s, stmt.var_init, 1)
    else if k == STMT_ASSIGN
        let t: *Expr = stmt.if_cond as *Expr
        if stmt.assign_target_len == 0 and t != null and t.kind != EXPR_IDENT
            own_walk(s, t, 0)
        own_walk(s, stmt.assign_value, 1)
    else if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # `x[i] = v`, `x.f = v`, `x.f[i] = v`: x is used, not moved.
        var base: *OwnBinding = null
        if k == STMT_INDEX_ASSIGN
            base = own_lookup(s, stmt.assign_target, stmt.assign_target_len)
        else
            base = own_lookup(s, stmt.var_name, stmt.var_name_len)
        if base != null
            if base.moved == 1
                own_error_use_at(s, stmt.span.line, stmt.span.col, base, base.move_line, base.move_col)
            else
                own_note_use(s, base, stmt.span.line, stmt.span.col, 0)
        if k != STMT_LOCAL_FIELD_ASSIGN
            own_walk(s, stmt.while_cond, 0)
        own_walk(s, stmt.assign_value, 1)
    else if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        own_walk(s, stmt.assign_value, 1)
    else if k == STMT_RETURN
        own_walk(s, stmt.return_value, 1)
    else if k == STMT_EXPR
        own_walk(s, stmt.expr, 0)
    else if k == STMT_IF or k == STMT_ASSERT
        own_walk(s, stmt.if_cond, 0)
    else if k == STMT_WHILE
        own_walk(s, stmt.while_cond, 0)
    else if k == STMT_FOR
        own_walk(s, stmt.for_start, 0)
        own_walk(s, stmt.for_end, 0)

# After a statement is emitted: a `return` ends its block for the check,
# and so does a `break` / `continue` in a loop (their moves reach the loop
# head or exit through own_loop_jump's events instead).
pub fn own_after_stmt(s: *EmitterState, stmt: *Stmt)
    let o: *OwnState = s.own
    if o.scope_count <= 0
        return
    if stmt.kind == STMT_RETURN
        own_mark_dead(o)
    else if (stmt.kind == STMT_BREAK or stmt.kind == STMT_CONTINUE) and o.loop_depth > 0
        own_mark_dead(o)

# A fn's tail expression is its return value: a move.
pub fn own_check_tail(s: *EmitterState, e: *Expr)
    if own_checking(s) == 0
        return
    own_walk(s, e, 1)

# A match / if-expression arm's value expression.
pub fn own_check_arm(s: *EmitterState, e: *Expr)
    if own_checking(s) == 0
        return
    own_walk(s, e, 1)

# =============================================================================
# Reassignment
# =============================================================================

# The LLVM type of a binding's storage: `[N x %T]` for an array (an N-D
# array's leaves are contiguous, so a flat array of them is its layout).
fn own_emit_binding_type(s: *EmitterState, b: *OwnBinding)
    if b.count > 0
        emit_str(s, c"[")
        emit_int(s, b.count as i64)
        emit_str(s, c" x ")
        emit_llvm_type_struct(s, TYPE_STRUCT, b.type_name, b.type_name_len)
        emit_str(s, c"]")
        return
    emit_llvm_type_struct(s, TYPE_STRUCT, b.type_name, b.type_name_len)

# Before `x = v` is emitted: copy x's old value aside with its flag, so it
# can be dropped once v (which may still read x) has been stored.  Returns
# a handle for own_assign_end, or 0 when x is not an owned binding.
pub fn own_assign_begin(s: *EmitterState, stmt: *Stmt, out_old: *i32, out_flag: *i32) -> *OwnBinding
    *out_old = 0
    *out_flag = 0
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let b: *OwnBinding = own_assign_target(s, stmt)
    if b == null
        return null
    let f: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, f)
    emit_str(s, c" = load i1, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca ")
    own_emit_binding_type(s, b)
    emit_str(s, c"\n")
    let v: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v)
    emit_str(s, c" = load ")
    own_emit_binding_type(s, b)
    emit_str(s, c", ptr ")
    emit_reg(s, b.slot)
    emit_str(s, c"\n")
    emit_str(s, c"  store ")
    own_emit_binding_type(s, b)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    *out_old = tmp
    *out_flag = f
    b

# After `x = v` is emitted: x owns v; drop the old value if x owned one.
pub fn own_assign_end(s: *EmitterState, b: *OwnBinding, old: i32, old_flag: i32)
    if b == null
        return
    b.moved = 0
    b.shadow = 0
    own_store_flag(s, b, 1)
    let saved: i32 = last_expr_here(s)
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, old_flag)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    own_emit_value_glue(s, old, b.type_name, b.type_name_len, b.count)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)
    if saved != 0
        set_last_expr(s, saved)

# =============================================================================
# `if` merge for the move check (ritz0's If handling)
# =============================================================================

# The moved state of every live binding: 4 i32s each (moved, its line and
# column, shadow).  null when nothing is tracked.
pub fn own_snapshot(s: *EmitterState) -> *i32
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let snap: *i32 = malloc((o.live_count as i64) * 16 + 4) as *i32
    snap[0] = o.live_count
    var i: i32 = 0
    while i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        snap[1 + i * 4] = b.moved
        snap[2 + i * 4] = b.move_line
        snap[3 + i * 4] = b.move_col
        snap[4 + i * 4] = b.shadow
        i += 1
    snap

pub fn own_restore(s: *EmitterState, snap: *i32)
    if snap == null
        return
    let o: *OwnState = s.own
    var n: i32 = snap[0]
    if n > o.live_count
        n = o.live_count
    var i: i32 = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        b.moved = snap[1 + i * 4]
        b.move_line = snap[2 + i * 4]
        b.move_col = snap[3 + i * 4]
        b.shadow = snap[4 + i * 4]
        i += 1

# Neither arm returned: a binding moved in the then-arm (`after_then`) is
# moved after the `if` too (the else-arm's state is current).  Moved in
# both, it reports the then-arm's move, as ritz0 does.  `shadow` merges the
# same way.
pub fn own_merge_moved(s: *EmitterState, after_then: *i32)
    if after_then == null
        return
    let o: *OwnState = s.own
    var n: i32 = after_then[0]
    if n > o.live_count
        n = o.live_count
    var i: i32 = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        if after_then[1 + i * 4] == 1
            b.moved = 1
            b.move_line = after_then[2 + i * 4]
            b.move_col = after_then[3 + i * 4]
        if after_then[4 + i * 4] == 1
            b.shadow = 1
        i += 1

# STMT_IF, after both arms: settle the move state per ritz0.
pub fn own_if_merge(s: *EmitterState, before: *i32, after_then: *i32, then_dead: i32, has_else: i32, else_dead: i32)
    # Both arms returned: what follows is dead.  Only the then-arm returned:
    # the else-arm's state (current) stands.
    if has_else == 0
        if then_dead == 1
            own_restore(s, before)
    else if then_dead == 0 and else_dead == 1
        own_restore(s, after_then)
    else if then_dead == 0 and else_dead == 0
        own_merge_moved(s, after_then)
    if before != null
        free(before as *u8)
    if after_then != null
        free(after_then as *u8)

# =============================================================================
# End of fn: zero the flags in the entry block, drop before every `ret`
# =============================================================================

fn own_emit_ret_drops(s: *EmitterState)
    let o: *OwnState = s.own
    var i: i32 = o.all_count - 1
    while i >= 0
        let b: *OwnBinding = own_all_at(o, i)
        let seq: i32 = o.ret_seq
        o.ret_seq = o.ret_seq + 1
        let f: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, f)
        emit_str(s, c" = load i1, ptr ")
        emit_reg(s, b.flag)
        emit_str(s, c"\n  br i1 ")
        emit_reg(s, f)
        emit_str(s, c", label %own.d")
        emit_int(s, seq as i64)
        emit_str(s, c", label %own.n")
        emit_int(s, seq as i64)
        emit_str(s, c"\nown.d")
        emit_int(s, seq as i64)
        emit_str(s, c":\n")
        emit_str(s, c"  store i1 0, ptr ")
        emit_reg(s, b.flag)
        emit_str(s, c"\n")
        own_emit_value_glue(s, b.slot, b.type_name, b.type_name_len, b.count)
        emit_str(s, c"  br label %own.n")
        emit_int(s, seq as i64)
        emit_str(s, c"\nown.n")
        emit_int(s, seq as i64)
        emit_str(s, c":\n")
        i -= 1

# Called once the body is complete, before hoist_entry_allocas (which then
# moves the flag allocas above the zeroing stores).
pub fn own_end_fn(s: *EmitterState, body_start: i64)
    let o: *OwnState = s.own
    o.scope_count = 0
    o.live_count = 0
    o.loop_base = -1
    o.temp_expr_count = 0
    o.temp_count = 0
    o.loop_ev_count = 0
    o.loop_depth = 0
    if o.all_count == 0
        return
    let n: i64 = s.out.len - body_start
    if n <= 0
        return
    let base: *u8 = malloc(n)
    memcpy(base, s.out.data + body_start, n)
    let end: *u8 = base + n
    s.out.len = body_start
    var i: i32 = 0
    while i < o.all_count
        own_store_flag(s, own_all_at(o, i), 0)
        i += 1
    var p: *u8 = base
    while p < end
        let ll: i64 = ll_line_len(p, end)
        if ll_starts_with(p, ll, c"  ret ") == 1 or ll_starts_with(p, ll, c"  ret\n") == 1
            own_emit_ret_drops(s)
        vec_push_bytes<u8>(s.out, p, ll)
        p = p + ll
    free(base)
    o.all_count = 0
