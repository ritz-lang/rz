# ownership.ritz - move checking and drop insertion (AGAST #2158, #1854)
#
# LANGUAGE_SPEC §13.  A type is MOVE-ONLY iff it implements Drop, or a
# field or generic argument of it is move-only (checked transitively).
# Every other type copies, and nothing here ever touches it.
#
# Move check.  Using a move-only binding by value (binding it, assigning it,
# passing it to a by-value parameter, returning it, storing it in a struct
# literal field) moves it; any later use is a located error worded as ritz0's
# move_checker.py words it:
#
#     use of moved value: `t` (moved at F:L:C)
#     cannot borrow `t` - value has been moved
#
# The flow rules are ritz0's: a block stops being checked after a `return`
# directly in it; after an `if`, a binding moved in either arm that falls
# through counts as moved; assigning to a binding makes it an owner again.
# The check runs as each statement is emitted (like let_check.ritz), against
# the bindings this module registered, so shadowing resolves exactly as the
# emitter resolves names.
#
# Drops.  Each owned binding gets an `i1` drop flag (an alloca, hoisted to
# the entry block and zeroed there).  Declaring the binding with a value, or
# assigning to it, sets the flag; moving it clears it.  A drop is
# `if flag { flag = 0; glue(binding) }`, so a binding moved on only some
# paths is dropped exactly on the others.  Drops are emitted
#   - at the end of each block, for the bindings it declared (reverse order);
#   - on `break` / `continue`, for the bindings of the loop body;
#   - on assignment, for the old value (copied aside first, so the new value
#     may still read it); and on assignment to a field, for the field's old
#     value (AGAST #2173, see own_field_drop_cond);
#   - before every `ret` of the fn, for every binding of the fn (reverse
#     declaration order): own_end_fn inserts them into the finished body,
#     because ritz1 emits `ret` from dozens of sites.  A binding whose block
#     already ended has a cleared flag, so it is not dropped twice.
# Glue: a type's own `drop` (if it has one) runs first, then each move-only
# field is dropped in declaration order.  An array drops its elements in
# index order; an enum (a user enum, or a tagged Option / Result) drops the
# payload of the variant its tag names (AGAST #2165).
#
# Temporaries (AGAST #2165).  A call whose by-value move-only result nobody
# owns -- an expression statement `make(1)`, `make(1).id`, an argument lent
# to an `@T` parameter -- is marked by the move check; emit_expr spills its
# value with a drop flag, and the temporary drops at the end of its
# statement, or of the `if` / `while` condition it is in.  A `return`'s
# temporaries drop before the `ret`, with the fn's bindings.  A method call's
# result is not a temporary here yet; ritz0's is (AGAST #2257, #2262).
#
# Loops (AGAST #2165, ritz0's _check_loop).  A binding declared outside a
# loop must not reach the loop head moved, or the next iteration uses a
# moved value.  ritz1 checks the body once, as it emits it, so alongside
# `moved` each binding carries `shadow`: moved-if-the-head-was-moved.  Uses
# while shadowed are recorded; at the loop's end, if the body's fall-through
# or a `continue` reaches the head with the binding moved, each recorded use
# is reported, as ritz0's re-check of the body reports it.
#
# Fields (AGAST #2168, #2242).  Moving a move-only field out of a binding
# (`return h.t`, `var u = h.t`, `consume(h.a.t)`) moves that path only, as in
# Rust: the binding's `fmask` bit for it is set at run time, so the binding's
# drop skips it, and the move check rejects a later use that overlaps it: the
# path, a parent of it, or a part of it (`h.a.n`, a sibling, stays usable).
# Assigning a path (`h.a.t = v`) makes it and its parts owned again, unless a
# parent is gone too.  A type with its own `drop` can't be partly moved
# (Rust's E0509).  A temporary whose move-only field is moved out isn't
# dropped (ritz0's rule: no partial drops of a temporary).
#
# ritz0 makes a flag for each path its checker saw moved.  This check runs as
# code is emitted, so a drop can come before a move that reaches it round a
# loop: each binding numbers every path its type has up front (OwnBinding's
# `paths`), and the glue tests them all.  Only OWN_MAX_PATHS paths fit, the
# shallowest first; a move along a path past them moves its nearest numbered
# parent, or the whole binding (AGAST #2319).
#
# Match arms (AGAST #2168, ritz0 #2161).  Each arm of a match or an
# if-expression starts from the move state before it; afterwards a binding
# is moved if an arm that falls through moved it (own_arms_*), `shadow`
# included.
#
# Match scrutinees (AGAST #2174).  A match (statement or expression) moves
# its scrutinee and owns it; a payload binding (`Full(t)`) owns the payload
# for its arm (see own_match_begin).  ritz0 follows the same rule (AGAST
# #2177, move_checker.py _own_payload).
#
# A fn without move-only bindings, in a module without `impl Drop`, emits
# nothing extra.
#
# Tests: ritz0/test_ownership_free_count.py (shared with ritz0) and
# ritz0/test_ritz1_ownership.py.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.memory

import ast
import ast_helpers
import emitter_core
import emitter_expr        # emit_member_gep_from_ptr
import emitter_expr_call   # method_callee_def, find_spec_impl_method
import ll_copy_scan        # ll_line_len, ll_starts_with
import ref_check           # ref_ty_of, ref_through (AGAST #2336)
import index_through       # index_through_value_struct (AGAST #2444)
import emitter_stmt        # emit_stmt, for a deferred statement (AGAST #1625)

const OWN_INIT_CAP: i32 = 16
# Deeper than any real struct nesting; stops a malformed recursive type.
const OWN_MAX_DEPTH: i32 = 32

# Loop move-check events (OwnState.loop_ev): [kind, slot, depth, a, b, c, d,
# e, f] with `slot` the binding's storage register (its identity) and
# `depth` the loop nesting depth they belong to.
const OWN_EV_INTS: i32 = 9
# Loop entry: a = shadow before, b = moved, c:d = its move, e = fmoved,
# f = fshadow before.
const OWN_EV_SAVE: i32 = 1
# A use while shadowed: a = 1 for a borrow + 2 when the whole binding was
# shadowed, c:d = where, e = the paths it would be using moved (fshadow bits),
# b:f = the `defer` it is in (0:0 for none), where it is reported (#2810).
const OWN_EV_USE: i32 = 2
# `continue` / `break` with it (partly) moved: b = moved, c:d = the move,
# e = fmoved.
const OWN_EV_HEAD: i32 = 3
const OWN_EV_BREAK: i32 = 4
# Paths 0..30 can be moved out (one bit each of `fmask`).
const OWN_MAX_PATHS: i32 = 31
const OWN_ALL_PATHS: i32 = 0x7FFFFFFF

pub fn own_init(s: *EmitterState)
    let o: *OwnState = malloc(sizeof(OwnState)) as *OwnState
    o.live = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_count = 0
    o.live_cap = OWN_INIT_CAP
    o.scope_start = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_dead = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_count = 0
    o.scope_cap = OWN_INIT_CAP
    o.all = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.all_count = 0
    o.all_cap = OWN_INIT_CAP
    o.loop_base = -1
    o.ret_seq = 0
    o.has_drop = 0 - 1
    o.temp_exprs = malloc((OWN_INIT_CAP as i64) * 8) as **Expr
    o.temp_expr_count = 0
    o.temp_expr_cap = OWN_INIT_CAP
    o.temps = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.temp_count = 0
    o.temp_cap = OWN_INIT_CAP
    o.stmt_mark = 0
    o.loop_ev = malloc((OWN_INIT_CAP * OWN_EV_INTS * 4) as i64) as *i32
    o.loop_ev_count = 0
    o.loop_ev_cap = OWN_INIT_CAP
    o.loop_depth = 0
    o.last_pop_dead = 0
    o.fm_loc = malloc((OWN_INIT_CAP * 16) as i64) as *i32
    o.fm_count = 0
    o.fm_cap = OWN_INIT_CAP
    o.match_scrut = 0 - 1
    o.fa_cond = 0
    o.fa_path = 0 - 1
    o.fa_mask = 0
    o.defer_stmts = malloc((OWN_INIT_CAP as i64) * 8) as **Stmt
    o.defer_pos = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.defer_ret = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.defer_count = 0
    o.defer_cap = OWN_INIT_CAP
    o.scope_dstart = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.loop_dstart = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.loop_dcap = OWN_INIT_CAP
    o.cur_defer = null
    o.in_ret = 0
    s.own = o
    s.defer_live = 0

fn own_live_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.live
    return @base[i]

fn own_all_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.all
    return @base[i]

fn own_copy_binding(dst: *OwnBinding, src: *OwnBinding)
    memcpy(dst as *u8, src as *u8, sizeof(OwnBinding))

fn own_temp_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.temps
    return @base[i]

# Event `i` of the loop move check (OWN_EV_INTS i32s).
fn own_ev_at(o: *OwnState, i: i32) -> *i32
    let base: *i32 = o.loop_ev
    return base + i * OWN_EV_INTS

fn own_ev_push(o: *OwnState, kind: i32, slot: i32, a: i32, b: i32, c: i32, d: i32, e: i32, f: i32)
    if o.loop_ev_count >= o.loop_ev_cap
        let cap: i32 = o.loop_ev_cap * 2
        o.loop_ev = realloc(o.loop_ev as *u8, (cap * OWN_EV_INTS * 4) as i64) as *i32
        o.loop_ev_cap = cap
    let ev: *i32 = own_ev_at(o, o.loop_ev_count)
    ev[0] = kind
    ev[1] = slot
    ev[2] = o.loop_depth
    ev[3] = a
    ev[4] = b
    ev[5] = c
    ev[6] = d
    ev[7] = e
    ev[8] = f
    o.loop_ev_count = o.loop_ev_count + 1

# AGAST #2168: remember where path `path` of the binding at `slot` moved.
fn own_fm_push(o: *OwnState, slot: i32, path: i32, line: i32, col: i32)
    if o.fm_count >= o.fm_cap
        let cap: i32 = o.fm_cap * 2
        o.fm_loc = realloc(o.fm_loc as *u8, (cap * 16) as i64) as *i32
        o.fm_cap = cap
    let base: *i32 = o.fm_loc
    let r: *i32 = base + o.fm_count * 4
    r[0] = slot
    r[1] = path
    r[2] = line
    r[3] = col
    o.fm_count = o.fm_count + 1

# The index of the latest recorded move of that path, or -1.
fn own_fm_index(o: *OwnState, slot: i32, path: i32) -> i32
    let base: *i32 = o.fm_loc
    var i: i32 = o.fm_count - 1
    while i >= 0
        let r: *i32 = base + i * 4
        if r[0] == slot and r[1] == path
            return i
        i -= 1
    0 - 1

# That move: [slot, path, line, col], or null.
fn own_fm_find(o: *OwnState, slot: i32, path: i32) -> *i32
    let i: i32 = own_fm_index(o, slot, path)
    if i < 0
        return null
    let base: *i32 = o.fm_loc
    base + i * 4

# The path in `bits` (bits != 0) that moved first, as ritz0 names the first
# entry of its moved fields.
fn own_first_moved(o: *OwnState, slot: i32, bits: i32) -> i32
    var best: i32 = 0
    var best_at: i32 = o.fm_count
    var i: i32 = OWN_MAX_PATHS - 1
    while i >= 0
        if (bits & (1 << i)) != 0
            var at: i32 = own_fm_index(o, slot, i)
            if at < 0
                at = o.fm_count
            if at <= best_at
                best = i
                best_at = at
        i -= 1
    best

# =============================================================================
# Move-only types
# =============================================================================

# Length of `name` up to its first `$` (a monomorph's base name).
fn own_base_len(name: *u8, len: i32) -> i32
    var i: i32 = 0
    while i < len
        if *(name + i) == 36   # '$'
            return i
        i += 1
    len

# 1 when the type itself has an `impl Drop`.
fn own_has_drop_impl(s: *EmitterState, name: *u8, len: i32) -> i32
    let base_len: i32 = own_base_len(name, len)
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if ib.trait_name != null and name_eq(ib.trait_name, ib.trait_name_len, c"Drop", 4) == 1
            if name_eq(ib.type_name, ib.type_name_len, name, base_len) == 1
                return 1
        ib = ib.next
    0

fn own_move_only_depth(s: *EmitterState, name: *u8, len: i32, depth: i32) -> i32
    if name == null or len <= 0 or depth > OWN_MAX_DEPTH
        return 0
    if own_has_drop_impl(s, name, len) == 1
        return 1
    # Generic arguments: `Vec$Tracked`, `Pair$i32$Tracked`.
    let base_len: i32 = own_base_len(name, len)
    var i: i32 = base_len
    while i < len
        let start: i32 = i + 1
        var j: i32 = start
        while j < len and *(name + j) != 36
            j += 1
        if j > start and own_move_only_depth(s, name + start, j - start, depth + 1) == 1
            return 1
        i = j
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        # A user enum is move-only when a variant's payload is (AGAST #2165).
        let ei: i32 = user_enum_index(name, len)
        if ei < 0
            return 0
        var vi: i32 = 0
        while vi < enum_variant_count(ei)
            if own_fields_move_only(s, enum_variant_fields(ei, vi), depth + 1) == 1
                return 1
            vi += 1
        return 0
    own_fields_move_only(s, st.fields, depth + 1)

# The leaf elements of an N-D array shape, when they are structs: 1, with
# their total count and type.
fn own_shape_elems(sh: *ArrayShape, out_n: *i32, out_name: **u8, out_len: *i32) -> i32
    if sh.leaf_type != TYPE_STRUCT or sh.leaf_name_len <= 0
        return 0
    var n: i32 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * sh.dims[d]
        d += 1
    *out_n = n
    *out_name = sh.leaf_name
    *out_len = sh.leaf_name_len
    1

# An array field of struct elements: 1, with the element count (every
# leaf of an N-D array) and the element type.
fn own_field_array(f: *StructField, out_n: *i32, out_name: **u8, out_len: *i32) -> i32
    if f.field_type != TYPE_ARRAY
        return 0
    if f.array_shape != null
        return own_shape_elems(f.array_shape, out_n, out_name, out_len)
    if f.array_elem_type != TYPE_STRUCT or f.array_size <= 0
        return 0
    *out_n = f.array_size
    *out_name = f.array_elem_type_name
    *out_len = f.array_elem_type_name_len
    1

# 1 when field `f` (of a struct or an enum payload) holds a move-only value.
fn own_field_move_only(s: *EmitterState, f: *StructField, depth: i32) -> i32
    if f.field_type == TYPE_STRUCT
        return own_move_only_depth(s, f.field_type_name, f.field_type_name_len, depth)
    var n: i32 = 0
    var en: *u8 = null
    var el: i32 = 0
    if own_field_array(f, @n, @en, @el) == 1
        return own_move_only_depth(s, en, el, depth)
    0

fn own_fields_move_only(s: *EmitterState, fields: *StructField, depth: i32) -> i32
    var f: *StructField = fields
    while f != null
        if own_field_move_only(s, f, depth) == 1
            return 1
        f = f.next
    0

# 1 when the module has an `impl Drop` at all; without one nothing is
# move-only, and the hooks skip their work.
fn own_any_drop(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.has_drop >= 0
        return o.has_drop
    o.has_drop = 0
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if ib.trait_name != null and name_eq(ib.trait_name, ib.trait_name_len, c"Drop", 4) == 1
            o.has_drop = 1
            return 1
        ib = ib.next
    0

pub fn own_type_is_move_only(s: *EmitterState, name: *u8, len: i32) -> i32
    if own_any_drop(s) == 0
        return 0
    own_move_only_depth(s, name, len, 0)

# =============================================================================
# Drop glue
# =============================================================================

# Emit `call void @<T's drop>(ptr %ptr)` if T has its own drop.
fn own_emit_own_drop(s: *EmitterState, ptr: i32, name: *u8, len: i32)
    if own_has_drop_impl(s, name, len) == 0
        return
    let base_len: i32 = own_base_len(name, len)
    if base_len < len
        # A generic impl: monomorph specialised its methods as `Box$i32_drop`.
        let fd: *FnDef = find_spec_impl_method(s, name, len, c"drop", 4)
        if fd == null
            return
        emit_str(s, c"  call void @")
        emit_name(s, fd.name, fd.name_len)
        emit_str(s, c"(ptr ")
        emit_reg(s, ptr)
        emit_str(s, c")\n")
        add_extern(s, fd.name, fd.name_len)
        return
    emit_str(s, c"  call void @")
    emit_name(s, name, len)
    emit_str(s, c"_drop(ptr ")
    emit_reg(s, ptr)
    emit_str(s, c")\n")
    add_method_extern(s, name, len, c"drop", 4)

# Drop the value of type `name` at `ptr`: its own drop, then its move-only
# struct fields in declaration order, or an enum's payload.
fn own_emit_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, depth: i32)
    if depth > OWN_MAX_DEPTH
        return
    own_emit_own_drop(s, ptr, name, len)
    if is_tagged_enum_type(name, len) == 1
        own_emit_tagged_glue(s, ptr, name, len, depth)
        return
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        let ei: i32 = user_enum_index(name, len)
        if ei >= 0
            own_emit_enum_glue(s, ptr, name, len, ei, depth)
        return
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0) == 1
            var r: MemberPtrResult
            emit_member_gep_from_ptr(s, @r, ptr, st, idx, f)
            own_emit_field_glue(s, r.reg, f, depth + 1)
        idx += 1
        f = f.next

# Drop the move-only field `f` stored at `ptr`.
fn own_emit_field_glue(s: *EmitterState, ptr: i32, f: *StructField, depth: i32)
    if f.field_type == TYPE_STRUCT
        own_emit_glue(s, ptr, f.field_type_name, f.field_type_name_len, depth)
        return
    var n: i32 = 0
    var en: *u8 = null
    var el: i32 = 0
    if own_field_array(f, @n, @en, @el) == 1
        own_emit_array_glue(s, ptr, n, en, el, depth)

# AGAST #2168, #2242: drop the binding's value at `ptr`, or with `path` >= 0
# that path's value (no drop of its own either way), except the paths whose
# bit is set in the i32 register `mask`: each move-only field in declaration
# order if it isn't moved out, a field with parts of its own part by part.
fn own_emit_masked_glue(s: *EmitterState, ptr: i32, b: *OwnBinding, path: i32, mask: i32)
    var name: *u8 = b.type_name
    var len: i32 = b.type_name_len
    if path >= 0
        let pp: *OwnPath = own_path_at(b, path)
        let pf: *StructField = pp.fld
        name = pf.field_type_name
        len = pf.field_type_name_len
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0) == 1
            let part: i32 = own_child_path(b, path, idx)
            var next: i32 = 0 - 1
            if part >= 0
                let t: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, t)
                emit_str(s, c" = and i32 ")
                emit_reg(s, mask)
                emit_str(s, c", ")
                emit_int(s, (1 << part) as i64)
                emit_str(s, c"\n")
                let c: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, c)
                emit_str(s, c" = icmp eq i32 ")
                emit_reg(s, t)
                emit_str(s, c", 0\n")
                let do_label: i32 = next_label(s)
                next = next_label(s)
                emit_str(s, c"  br i1 ")
                emit_reg(s, c)
                emit_str(s, c", label %")
                emit_label(s, do_label)
                emit_str(s, c", label %")
                emit_label(s, next)
                emit_str(s, c"\n")
                begin_block(s, do_label)
            var r: MemberPtrResult
            emit_member_gep_from_ptr(s, @r, ptr, st, idx, f)
            if part >= 0 and own_has_parts(b, part) == 1
                own_emit_masked_glue(s, r.reg, b, part, mask)
            else
                own_emit_field_glue(s, r.reg, f, 1)
            if next >= 0
                own_case_end(s, next)
        idx += 1
        f = f.next

# The binding's value at `ptr`, with its moved-out paths per the mask
# register `mask` (0: none can be).
fn own_emit_binding_glue(s: *EmitterState, b: *OwnBinding, ptr: i32, mask: i32)
    if mask != 0
        own_emit_masked_glue(s, ptr, b, 0 - 1, mask)
    else
        own_emit_value_glue(s, ptr, b.type_name, b.type_name_len, b.count)

# Load the binding's moved-path mask (0 when it has none).
fn own_load_mask(s: *EmitterState, b: *OwnBinding) -> i32
    if b.fmask == 0
        return 0
    let m: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, m)
    emit_str(s, c" = load i32, ptr ")
    emit_reg(s, b.fmask)
    emit_str(s, c"\n")
    m

# Set (`set` 1) or clear the run-time moved bits `bits`.
fn own_emit_mask_bits(s: *EmitterState, b: *OwnBinding, bits: i32, set: i32)
    if b.fmask == 0 or bits == 0
        return
    let m: i32 = own_load_mask(s, b)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    if set == 1
        emit_str(s, c" = or i32 ")
        emit_reg(s, m)
        emit_str(s, c", ")
        emit_int(s, bits as i64)
    else
        emit_str(s, c" = and i32 ")
        emit_reg(s, m)
        emit_str(s, c", ")
        emit_int(s, (OWN_ALL_PATHS ^ bits) as i64)
    emit_str(s, c"\n  store i32 ")
    emit_reg(s, r)
    emit_str(s, c", ptr ")
    emit_reg(s, b.fmask)
    emit_str(s, c"\n")

fn own_store_mask(s: *EmitterState, b: *OwnBinding, v: i32)
    if b.fmask == 0
        return
    emit_str(s, c"  store i32 ")
    emit_int(s, v as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, b.fmask)
    emit_str(s, c"\n")

# A value (count 0) or an array of `count` elements, at `ptr`.
fn own_emit_value_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, count: i32)
    if count > 0
        own_emit_array_glue(s, ptr, count, name, len, 0)
    else
        own_emit_glue(s, ptr, name, len, 0)

# Drop `n` elements of type `name` from `ptr` on, in index order, with a
# loop (its counter alloca is hoisted to the entry block).
fn own_emit_array_glue(s: *EmitterState, ptr: i32, n: i32, name: *u8, len: i32, depth: i32)
    if n <= 0 or depth > OWN_MAX_DEPTH
        return
    let ctr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ctr)
    emit_str(s, c" = alloca i64  ; array drop index\n  store i64 0, ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n")
    let head: i32 = next_label(s)
    let body: i32 = next_label(s)
    let done: i32 = next_label(s)
    emit_str(s, c"  br label %")
    emit_label(s, head)
    emit_str(s, c"\n")
    begin_block(s, head)
    let i: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, i)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n")
    let more: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, more)
    emit_str(s, c" = icmp slt i64 ")
    emit_reg(s, i)
    emit_str(s, c", ")
    emit_int(s, n as i64)
    emit_str(s, c"\n  br i1 ")
    emit_reg(s, more)
    emit_str(s, c", label %")
    emit_label(s, body)
    emit_str(s, c", label %")
    emit_label(s, done)
    emit_str(s, c"\n")
    begin_block(s, body)
    let ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ep)
    emit_str(s, c" = getelementptr ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, i)
    emit_str(s, c"\n")
    own_emit_glue(s, ep, name, len, depth + 1)
    let nx: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, nx)
    emit_str(s, c" = add i64 ")
    emit_reg(s, i)
    emit_str(s, c", 1\n  store i64 ")
    emit_reg(s, nx)
    emit_str(s, c", ptr ")
    emit_reg(s, ctr)
    emit_str(s, c"\n  br label %")
    emit_label(s, head)
    emit_str(s, c"\n")
    begin_block(s, done)

# `if tag == <tag> {`: branch on the tag of the enum `ename` at `ptr` and
# open the block that drops the payload.  Returns the payload's address
# (field 2 of every payload-carrying enum layout); *out_next gets the label
# own_case_end closes the block with.
fn own_case_begin(s: *EmitterState, ptr: i32, ename: *u8, elen: i32, tag: i32, out_next: *i32) -> i32
    let tp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, ename, elen)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i32 0, i32 0\n")
    let t: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, t)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tp)
    emit_str(s, c"\n")
    let c: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, c)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, t)
    emit_str(s, c", ")
    emit_int(s, tag as i64)
    emit_str(s, c"\n")
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, c)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    let pp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, ename, elen)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c", i32 0, i32 2\n")
    *out_next = next
    pp

fn own_case_end(s: *EmitterState, next: i32)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)

# Option$T / Result$T$E: tag 0 holds the Some / Ok payload, tag 1 Result's
# Err payload.
fn own_emit_tagged_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, depth: i32)
    var variants: i32 = 1
    if len > 7 and name_eq(name, 7, c"Result$", 7) == 1
        variants = 2
    var v: i32 = 0
    while v < variants
        var al: i32 = 0
        let a: *u8 = tagged_enum_arg(s, name, len, v, @al)
        if a != null and own_move_only_depth(s, a, al, depth + 1) == 1
            var next: i32 = 0
            let pp: i32 = own_case_begin(s, ptr, name, len, v, @next)
            own_emit_glue(s, pp, a, al, depth + 1)
            own_case_end(s, next)
        v += 1

# A user enum: its tag is the variant's index; the payload's fields sit in
# the payload bytes as variant_payload_size_align lays them out.
fn own_emit_enum_glue(s: *EmitterState, ptr: i32, name: *u8, len: i32, ei: i32, depth: i32)
    var vi: i32 = 0
    while vi < enum_variant_count(ei)
        let fields: *StructField = enum_variant_fields(ei, vi)
        if own_fields_move_only(s, fields, depth + 1) == 1
            var next: i32 = 0
            let pp: i32 = own_case_begin(s, ptr, name, len, vi, @next)
            var offset: i64 = 0
            var f: *StructField = fields
            while f != null
                var falign: i64 = 8
                var fsize: i64 = 8
                if f.field_type == TYPE_ARRAY
                    fsize = field_array_size_align(s, f, @falign)
                else
                    fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
                if falign < 1
                    falign = 1
                let rem: i64 = offset % falign
                if rem != 0
                    offset = offset + (falign - rem)
                if own_field_move_only(s, f, depth + 1) == 1
                    var fp: i32 = pp
                    if offset > 0
                        fp = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, fp)
                        emit_str(s, c" = getelementptr i8, ptr ")
                        emit_reg(s, pp)
                        emit_str(s, c", i64 ")
                        emit_int(s, offset)
                        emit_str(s, c"\n")
                    own_emit_field_glue(s, fp, f, depth + 1)
                offset = offset + fsize
                f = f.next
            own_case_end(s, next)
        vi += 1

# `if flag { flag = 0; glue(slot) }`, as basic blocks of the current fn.
fn own_emit_drop(s: *EmitterState, b: *OwnBinding)
    let saved: i32 = last_expr_here(s)
    let f: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, f)
    emit_str(s, c" = load i1, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, f)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    emit_str(s, c"  store i1 0, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    own_emit_binding_glue(s, b, b.slot, own_load_mask(s, b))
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)
    # The block's value (an `if` arm's) still dominates the new block.
    if saved != 0
        set_last_expr(s, saved)

fn own_store_flag(s: *EmitterState, b: *OwnBinding, v: i32)
    emit_str(s, c"  store i1 ")
    emit_int(s, v as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")

# =============================================================================
# Bindings and scopes
# =============================================================================

fn own_grow_live(o: *OwnState)
    if o.live_count < o.live_cap
        return
    let cap: i32 = o.live_cap * 2
    o.live = realloc(o.live as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_cap = cap

fn own_grow_all(o: *OwnState)
    if o.all_count < o.all_cap
        return
    let cap: i32 = o.all_cap * 2
    o.all = realloc(o.all as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.all_cap = cap

pub fn own_push_scope(s: *EmitterState)
    let o: *OwnState = s.own
    if o.scope_count >= o.scope_cap
        let cap: i32 = o.scope_cap * 2
        o.scope_start = realloc(o.scope_start as *u8, (cap as i64) * 4) as *i32
        o.scope_dead = realloc(o.scope_dead as *u8, (cap as i64) * 4) as *i32
        o.scope_dstart = realloc(o.scope_dstart as *u8, (cap as i64) * 4) as *i32
        o.scope_cap = cap
    let starts: *i32 = o.scope_start
    let deads: *i32 = o.scope_dead
    let dstarts: *i32 = o.scope_dstart
    starts[o.scope_count] = o.live_count
    deads[o.scope_count] = 0
    dstarts[o.scope_count] = o.defer_count
    o.scope_count = o.scope_count + 1

fn own_scope_is_dead(o: *OwnState) -> i32
    if o.scope_count <= 0
        return 0
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1]

fn own_mark_dead(o: *OwnState)
    if o.scope_count <= 0
        return
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1] = 1

# Drop live[from..] in reverse, without unregistering them.
fn own_drop_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    var i: i32 = o.live_count - 1
    while i >= from
        own_emit_drop(s, own_live_at(o, i))
        i -= 1

# Close the innermost block: drop what it declared (unless the block ended
# in a `return`, after which nothing is reachable) and forget it.  Returns 1
# when the block returned (for the `if` merge in the move check).
pub fn own_pop_scope(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.scope_count <= 0
        return 0
    let starts: *i32 = o.scope_start
    let start: i32 = starts[o.scope_count - 1]
    let dstarts: *i32 = o.scope_dstart
    let dstart: i32 = dstarts[o.scope_count - 1]
    let dead: i32 = own_scope_is_dead(o)
    if dead == 0
        own_unwind(s, start, dstart)   # drops and deferred statements (#1625)
    o.defer_count = dstart
    s.defer_live = dstart
    o.live_count = start
    o.scope_count = o.scope_count - 1
    ref_loans_end(o.scope_count)   # a loan ends with its holder's block (#2438)
    o.last_pop_dead = dead
    dead

# Enter / leave a loop body.  `break` and `continue` drop live[loop_base..].
# Entering shadows every unmoved binding (all are outside the loop), and
# every field of it not moved out, saving its state for own_loop_exit.
pub fn own_loop_enter(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.loop_base
    o.loop_base = o.live_count
    o.loop_depth = o.loop_depth + 1
    # AGAST #1625: `break` / `continue` run the defers registered from here.
    if o.loop_depth >= o.loop_dcap
        let dcap: i32 = o.loop_dcap * 2
        o.loop_dstart = realloc(o.loop_dstart as *u8, (dcap as i64) * 4) as *i32
        o.loop_dcap = dcap
    let ld: *i32 = o.loop_dstart
    ld[o.loop_depth] = o.defer_count
    var i: i32 = 0
    while i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        own_ev_push(o, OWN_EV_SAVE, b.slot, b.shadow, b.moved, b.move_line, b.move_col, b.fmoved, b.fshadow)
        b.shadow = 1 - b.moved
        b.fshadow = 0
        if b.moved == 0
            b.fshadow = OWN_ALL_PATHS ^ b.fmoved
        i += 1
    old

# The first event of `kind` at loop depth `depth` for the binding at `slot`.
fn own_ev_find(o: *OwnState, kind: i32, slot: i32, depth: i32) -> *i32
    var j: i32 = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[0] == kind and ev[1] == slot and ev[2] == depth
            return ev
        j += 1
    null

# Report the recorded use `ev` of `b`, given its state at the loop head
# (`head`: [moved, line, col, fmoved]).  Returns 1 if it was an error.
fn own_report_loop_use(s: *EmitterState, ev: *i32, b: *OwnBinding, head: *i32) -> i32
    let borrow: i32 = ev[3] & 1
    if ev[4] != 0 and (((ev[3] & 2) != 0 and head[0] == 1) or (head[3] & ev[7]) != 0)
        # In a deferred statement: reported at the `defer` (AGAST #2810).
        own_error_defer_at(s, ev[4], ev[8], b)
        return 1
    if (ev[3] & 2) != 0 and head[0] == 1
        if borrow == 1
            own_error_borrow_at(s, ev[5], ev[6], b)
        else
            own_error_use_at(s, ev[5], ev[6], b, head[1], head[2])
        return 1
    let hit: i32 = head[3] & ev[7]
    if hit == 0
        return 0
    if borrow == 1
        own_error_borrow_field_at(s, ev[5], ev[6], b, hit)
    else
        own_error_field_use_at(s, ev[5], ev[6], b, hit)
    1

# After the loop body (its scope already popped, so every live binding is
# from outside the loop).  A binding (or a field of it) reaches the head
# moved when the body falls through with it moved or a `continue` leaves
# with it moved; then every use recorded while it was shadowed is an error,
# as in ritz0's re-check of the body.  After the loop a binding (field) is
# moved if it was at entry, at the head, or at a `break`.
pub fn own_loop_exit(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    let depth: i32 = o.loop_depth
    let n: i32 = o.live_count
    # Per live binding: moved at the head, where, and its fields moved there.
    var head: *i32 = null
    if n > 0
        head = malloc((n as i64) * 16) as *i32
    var i: i32 = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        let h: *i32 = head + i * 4
        h[0] = 0
        h[3] = 0
        if o.last_pop_dead == 0
            h[3] = b.fmoved
            if b.moved == 1
                h[0] = 1
                h[1] = b.move_line
                h[2] = b.move_col
        let hv: *i32 = own_ev_find(o, OWN_EV_HEAD, b.slot, depth)
        if hv != null
            if h[0] == 0 and hv[4] == 1
                h[0] = 1
                h[1] = hv[5]
                h[2] = hv[6]
            h[3] = h[3] | hv[7]
        i += 1
    # The recorded uses, in order: an error, or (unreported, in an inner
    # loop) a use the enclosing loop's check still has to see.
    var j: i32 = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[0] == OWN_EV_USE and ev[2] == depth
            var bi: i32 = n - 1
            while bi >= 0
                let cb: *OwnBinding = own_live_at(o, bi)
                if cb.slot == ev[1]
                    break
                bi -= 1
            var reported: i32 = 0
            if bi >= 0
                reported = own_report_loop_use(s, ev, own_live_at(o, bi), head + bi * 4)
            if bi >= 0 and reported == 0 and depth > 1
                # Still shadowed in the enclosing loop: what it shadowed
                # before this loop was entered.
                let sv: *i32 = own_ev_find(o, OWN_EV_SAVE, ev[1], depth)
                if sv != null
                    var a: i32 = ev[3] & 1
                    if sv[3] == 1
                        a = a | (ev[3] & 2)
                    let fm: i32 = ev[7] & sv[8]
                    if (a & 2) != 0 or fm != 0
                        ev[2] = depth - 1
                        ev[3] = a
                        ev[7] = fm
        j += 1
    # The state after the loop, and the enclosing loop's shadow.
    i = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        let h: *i32 = head + i * 4
        let sv: *i32 = own_ev_find(o, OWN_EV_SAVE, b.slot, depth)
        let bv: *i32 = own_ev_find(o, OWN_EV_BREAK, b.slot, depth)
        var am: i32 = 0
        var al: i32 = 0
        var ac: i32 = 0
        var fm: i32 = h[3]
        if sv != null and sv[4] == 1
            am = 1
            al = sv[5]
            ac = sv[6]
        else if h[0] == 1
            am = 1
            al = h[1]
            ac = h[2]
        else if bv != null and bv[4] == 1
            am = 1
            al = bv[5]
            ac = bv[6]
        if sv != null
            fm = fm | sv[7]
        if bv != null
            fm = fm | bv[7]
        b.moved = am
        if am == 1
            b.move_line = al
            b.move_col = ac
        b.fmoved = fm
        if sv != null
            b.shadow = sv[3]
            b.fshadow = sv[8]
        i += 1
    if head != null
        free(head as *u8)
    # Forget this loop's events.
    var w: i32 = 0
    j = 0
    while j < o.loop_ev_count
        let ev: *i32 = own_ev_at(o, j)
        if ev[2] < depth
            if w != j
                memcpy(own_ev_at(o, w) as *u8, ev as *u8, (OWN_EV_INTS * 4) as i64)
            w += 1
        j += 1
    o.loop_ev_count = w
    o.loop_depth = depth - 1
    o.loop_base = old

# Before a `break` (is_continue 0) / `continue` (1) branches out of the
# loop body: record the (partly) moved outer bindings, then drop the body's.
pub fn own_loop_jump(s: *EmitterState, is_continue: i32)
    let o: *OwnState = s.own
    if o.loop_base < 0
        return
    if own_scope_is_dead(o) == 1
        return
    # AGAST #1625: the body's deferred statements run first, and (#2810) what
    # they move reaches the head / the loop's exit moved.  What follows the
    # jump is unreachable from here, so their moves don't stay.
    let ld: *i32 = o.loop_dstart
    let dbase: i32 = ld[o.loop_depth]
    var snap: *i32 = null
    if o.defer_count > dbase
        snap = own_snapshot(s)
        own_unwind(s, o.loop_base, dbase)
    else if o.live_count > o.loop_base
        own_drop_from(s, o.loop_base)
    var kind: i32 = OWN_EV_BREAK
    if is_continue == 1
        kind = OWN_EV_HEAD
    var i: i32 = 0
    while i < o.loop_base and i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        if b.moved == 1 or b.fmoved != 0
            let ev: *i32 = own_ev_find(o, kind, b.slot, o.loop_depth)
            if ev == null
                own_ev_push(o, kind, b.slot, 0, b.moved, b.move_line, b.move_col, b.fmoved, 0)
            else
                if ev[4] == 0 and b.moved == 1
                    ev[4] = 1
                    ev[5] = b.move_line
                    ev[6] = b.move_col
                ev[7] = ev[7] | b.fmoved
        i += 1
    if snap != null
        own_restore(s, snap)
        free(snap as *u8)

# =============================================================================
# Temporaries (AGAST #2165)
# =============================================================================

# After emit_expr emitted call `e` as register `reg`: if the move check
# marked it a temporary, spill it with a set drop flag and queue its drop.
pub fn own_note_temp(s: *EmitterState, e: *Expr, reg: i32)
    let o: *OwnState = s.own
    if reg == 0 or own_take_temp_mark(o, e) == 0
        return
    var len: i32 = 0
    let name: *u8 = own_call_ret_type(s, e, @len)
    if name == null
        return
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c"  ; temporary\n  store ")
    emit_llvm_type_struct(s, TYPE_STRUCT, name, len)
    emit_str(s, c" ")
    emit_reg(s, reg)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    own_push_temp(s, slot, name, len, 0)

# 1 when the move check marked `e` a temporary; forgets the mark.
fn own_take_temp_mark(o: *OwnState, e: *Expr) -> i32
    if o.temp_expr_count == 0
        return 0
    let te: **Expr = o.temp_exprs
    var i: i32 = 0
    while i < o.temp_expr_count and te[i] != e
        i += 1
    if i >= o.temp_expr_count
        return 0
    o.temp_expr_count = o.temp_expr_count - 1
    te[i] = te[o.temp_expr_count]
    1

# AGAST #2266: after emit_expr wrote array literal `e` (`[N]T` of struct T)
# into the alloca `slot`: if the move check marked it a temporary (nobody
# takes it), queue the drop of its elements, as a `[N]T` binding's.
pub fn own_note_array_temp(s: *EmitterState, e: *Expr, slot: i32)
    let o: *OwnState = s.own
    if own_take_temp_mark(o, e) == 0
        return
    var len: i32 = 0
    var count: i32 = 0
    let name: *u8 = own_temp_type(s, e, @len, @count)
    if name == null
        return
    own_push_temp(s, slot, name, len, count)

# Queue the drop of the temporary at `slot` (a `T`, or `[count]T` when count
# > 0), with a set drop flag.
fn own_push_temp(s: *EmitterState, slot: i32, name: *u8, len: i32, count: i32)
    let o: *OwnState = s.own
    let flag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, flag)
    emit_str(s, c" = alloca i1  ; drop flag\n")
    if o.temp_count >= o.temp_cap
        let cap: i32 = o.temp_cap * 2
        o.temps = realloc(o.temps as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
        o.temp_cap = cap
    let b: *OwnBinding = own_temp_at(o, o.temp_count)
    b.name = null
    b.name_len = 0
    b.local_idx = 0 - 1
    b.slot = slot
    b.flag = flag
    b.type_name = name
    b.type_name_len = len
    b.moved = 0
    b.move_line = 0
    b.move_col = 0
    b.count = count
    b.shadow = 0
    b.paths = null
    b.path_count = 0
    b.fmask = 0
    b.fmoved = 0
    b.fshadow = 0
    b.aux = 0
    o.temp_count = o.temp_count + 1
    # In `all` too, so a `ret` before its drop (a `return`'s value) drops it.
    own_grow_all(o)
    own_copy_binding(own_all_at(o, o.all_count), b)
    o.all_count = o.all_count + 1
    own_store_flag(s, b, 1)

# Drop temps[from..] (newest first) and forget them.
fn own_drop_temps_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    if o.temp_count <= from
        return
    if own_scope_is_dead(o) == 0
        var i: i32 = o.temp_count - 1
        while i >= from
            own_emit_drop(s, own_temp_at(o, i))
            i -= 1
    o.temp_count = from

# Bracket each statement: own_stmt_begin before it, own_stmt_end (with
# what begin returned) after, which drops the temporaries it made.
pub fn own_stmt_begin(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.stmt_mark
    o.stmt_mark = o.temp_count
    old

pub fn own_stmt_end(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)
    o.stmt_mark = old

# After an `if` / `while` condition, before its branch: its temporaries
# drop here, as ritz0 drops them.
pub fn own_cond_end(s: *EmitterState)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)

# AGAST #2168: 1 when a value of struct type `name` can have fields moved
# out: it has no drop of its own and a move-only field.
fn own_partly_movable(s: *EmitterState, name: *u8, len: i32) -> i32
    if own_has_drop_impl(s, name, len) == 1
        return 0
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return 0
    own_fields_move_only(s, st.fields, 0)

# AGAST #2242: path `i` of the binding.
fn own_path_at(b: *OwnBinding, i: i32) -> *OwnPath
    let base: *OwnPath = b.paths
    return @base[i]

# Add a path for each move-only field of the struct `name`, the parts of
# path `parent`, while they fit.  Returns the new path count.
fn own_add_paths(s: *EmitterState, paths: *OwnPath, count: i32, parent: i32, name: *u8, len: i32) -> i32
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return count
    var n: i32 = count
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null and n < OWN_MAX_PATHS
        if own_field_move_only(s, f, 0) == 1
            let bit: i32 = 1 << n
            let p: *OwnPath = @paths[n]
            p.parent = parent
            p.idx = idx
            p.fld = f
            p.up = bit
            p.down = bit
            var a: i32 = parent
            while a >= 0
                let ap: *OwnPath = @paths[a]
                p.up = p.up | (1 << a)
                ap.down = ap.down | bit
                a = ap.parent
            n += 1
        idx += 1
        f = f.next
    n

# The paths of a partly movable struct `name`, shallowest first, so a type
# with too many keeps the ones nearest the binding (their count in *out_n).
# A field stops the walk where it can't be partly moved itself: a type with
# its own drop, an enum, an array.
fn own_build_paths(s: *EmitterState, name: *u8, len: i32, out_n: *i32) -> *OwnPath
    let paths: *OwnPath = malloc((OWN_MAX_PATHS as i64) * sizeof(OwnPath)) as *OwnPath
    var n: i32 = own_add_paths(s, paths, 0, 0 - 1, name, len)
    var i: i32 = 0
    while i < n
        let p: *OwnPath = @paths[i]
        let f: *StructField = p.fld
        if f.field_type == TYPE_STRUCT and own_partly_movable(s, f.field_type_name, f.field_type_name_len) == 1
            n = own_add_paths(s, paths, n, i, f.field_type_name, f.field_type_name_len)
        i += 1
    *out_n = n
    paths

# The path for field `idx` of path `parent`, or -1.
fn own_child_path(b: *OwnBinding, parent: i32, idx: i32) -> i32
    var i: i32 = 0
    while i < b.path_count
        let p: *OwnPath = own_path_at(b, i)
        if p.parent == parent and p.idx == idx
            return i
        i += 1
    0 - 1

# The path for the field `name` of path `parent`, or -1.
fn own_named_path(b: *OwnBinding, parent: i32, name: *u8, len: i32) -> i32
    var i: i32 = 0
    while i < b.path_count
        let p: *OwnPath = own_path_at(b, i)
        if p.parent == parent and name_eq(p.fld.name, p.fld.name_len, name, len) == 1
            return i
        i += 1
    0 - 1

fn own_has_parts(b: *OwnBinding, path: i32) -> i32
    let p: *OwnPath = own_path_at(b, path)
    if p.down != (1 << path)
        return 1
    0

# Register the local at `idx` if it is a move-only value.  `owned` is 1 when
# it starts out holding a value (an initialised declaration, a parameter).
fn own_register(s: *EmitterState, idx: i32, owned: i32)
    let loc: *LocalVar = local_at(s, idx)
    var name: *u8 = loc.type_name
    var len: i32 = loc.type_name_len
    var count: i32 = 0
    if loc.var_type == TYPE_ARRAY
        # `[N]T` / `[N][M]..T` of move-only T (AGAST #2165).
        if loc.array_shape != null
            if own_shape_elems(loc.array_shape, @count, @name, @len) == 0
                return
        else if loc.array_elem_type == TYPE_STRUCT and loc.array_size > 0
            count = loc.array_size
        else
            return
    else if loc.var_type != TYPE_STRUCT
        return
    if own_type_is_move_only(s, name, len) == 0
        return
    let o: *OwnState = s.own
    # A redeclaration that reuses its storage is the same binding.
    var i: i32 = 0
    while i < o.live_count
        let lb: *OwnBinding = own_live_at(o, i)
        if lb.slot == loc.reg
            lb.local_idx = idx
            lb.moved = 0
            lb.shadow = 0
            lb.fmoved = 0
            lb.fshadow = 0
            own_store_flag(s, lb, owned)
            own_store_mask(s, lb, 0)
            return
        i += 1
    let flag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, flag)
    emit_str(s, c" = alloca i1  ; drop flag\n")
    # AGAST #2168: a struct with no drop of its own can be partly moved.
    var fmask: i32 = 0
    var paths: *OwnPath = null
    var path_count: i32 = 0
    if count == 0 and own_partly_movable(s, name, len) == 1
        fmask = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fmask)
        emit_str(s, c" = alloca i32  ; moved fields\n")
        paths = own_build_paths(s, name, len, @path_count)
    own_grow_live(o)
    let b: *OwnBinding = own_live_at(o, o.live_count)
    b.name = loc.name
    b.name_len = loc.name_len
    b.local_idx = idx
    b.slot = loc.reg
    b.flag = flag
    b.type_name = name
    b.type_name_len = len
    b.moved = 0
    b.move_line = 0
    b.move_col = 0
    b.count = count
    b.shadow = 0
    b.paths = paths
    b.path_count = path_count
    b.fmask = fmask
    b.fmoved = 0
    b.fshadow = 0
    b.aux = 0
    o.live_count = o.live_count + 1
    own_grow_all(o)
    own_copy_binding(own_all_at(o, o.all_count), b)
    o.all_count = o.all_count + 1
    own_store_flag(s, b, owned)
    own_store_mask(s, b, 0)

# Start of a fn body (after its params are bound): the fn's outermost block,
# holding its by-value move-only params, which the callee owns.
pub fn own_begin_fn(s: *EmitterState, params: *Param)
    let o: *OwnState = s.own
    o.live_count = 0
    o.scope_count = 0
    o.all_count = 0
    o.loop_base = -1
    o.ret_seq = 0
    o.temp_expr_count = 0
    o.temp_count = 0
    o.stmt_mark = 0
    o.loop_ev_count = 0
    o.loop_depth = 0
    o.last_pop_dead = 0
    o.fm_count = 0
    o.match_scrut = 0 - 1
    o.defer_count = 0
    o.cur_defer = null
    o.in_ret = 0
    s.defer_live = 0
    own_push_scope(s)
    var p: *Param = params
    while p != null
        if p.param_type == TYPE_STRUCT or p.param_type == TYPE_ARRAY
            let idx: i32 = find_local_idx(s, p.name, p.name_len)
            if idx >= 0
                own_register(s, idx, 1)
        p = p.next

# After a `let` / `var`: register the binding it declared.  `before` is
# s.local_count before the declaration (see let_mark_decl).
pub fn own_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx < before or idx < 0
        return
    var owned: i32 = 0
    if stmt.var_init != null
        owned = 1
    own_register(s, idx, owned)

# The registered binding `name` currently resolves to, or null.
fn own_lookup(s: *EmitterState, name: *u8, len: i32) -> *OwnBinding
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return null
    var i: i32 = o.live_count - 1
    while i >= 0
        let b: *OwnBinding = own_live_at(o, i)
        if b.local_idx == idx and name_eq(b.name, b.name_len, name, len) == 1
            return b
        i -= 1
    null

# =============================================================================
# Move check
# =============================================================================

# The file is the one the fn being checked is written in: an instance of an
# imported generic has its lines in that module, not the file compiled
# (AGAST #2890).
fn own_eprint_loc(line: i32, col: i32)
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)

fn own_eprint_name(name: *u8, len: i32)
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1

# AGAST #1625: a deferred statement is checked as if written at each exit it
# runs on.  A binding it names that is moved by then is reported at the
# `defer`, as ritz0 reports it.  Returns 1 when it reported.
fn own_error_in_defer(s: *EmitterState, b: *OwnBinding) -> i32
    let o: *OwnState = s.own
    let d: *Stmt = o.cur_defer
    if d == null
        return 0
    own_error_defer_at(s, d.span.line, d.span.col, b)
    1

fn own_error_defer_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding)
    own_eprint_loc(line, col)
    eprints_cstr(c": error: `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` may be moved before the deferred statement runs\n")
    s.error_count = s.error_count + 1

fn own_error_use_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding, move_line: i32, move_col: i32)
    if own_error_in_defer(s, b) == 1
        return
    own_eprint_loc(line, col)
    eprints_cstr(c": error: use of moved value: `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` (moved at ")
    own_eprint_loc(move_line, move_col)
    eprints_cstr(c")\n")
    s.error_count = s.error_count + 1

fn own_error_borrow_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding)
    if own_error_in_defer(s, b) == 1
        return
    own_eprint_loc(line, col)
    eprints_cstr(c": error: cannot borrow `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` - value has been moved\n")
    s.error_count = s.error_count + 1

fn own_error_use(s: *EmitterState, e: *Expr, b: *OwnBinding)
    own_error_use_at(s, e.span.line, e.span.col, b, b.move_line, b.move_col)

# Field `idx` of the struct `name`, or null.
fn own_struct_field(s: *EmitterState, name: *u8, len: i32, idx: i32) -> *StructField
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return null
    var f: *StructField = st.fields
    var i: i32 = 0
    while f != null and i < idx
        f = f.next
        i += 1
    f

# `b.f.g` for path `path` of the binding (`b` for -1).
fn own_eprint_binding_path(b: *OwnBinding, path: i32)
    if path < 0
        own_eprint_name(b.name, b.name_len)
        return
    let p: *OwnPath = own_path_at(b, path)
    own_eprint_binding_path(b, p.parent)
    eprint_char('.')
    own_eprint_name(p.fld.name, p.fld.name_len)

# AGAST #2168: a use of one of the moved paths `bits` (or of the whole
# binding): `use of moved value: `h.t` (moved at F:L:C)`, for the first moved.
fn own_error_field_use_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding, bits: i32)
    if own_error_in_defer(s, b) == 1
        return
    let path: i32 = own_first_moved(s.own, b.slot, bits)
    own_eprint_loc(line, col)
    eprints_cstr(c": error: use of moved value: `")
    own_eprint_binding_path(b, path)
    eprints_cstr(c"`")
    let r: *i32 = own_fm_find(s.own, b.slot, path)
    if r != null
        eprints_cstr(c" (moved at ")
        own_eprint_loc(r[2], r[3])
        eprints_cstr(c")")
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

fn own_error_borrow_field_at(s: *EmitterState, line: i32, col: i32, b: *OwnBinding, bits: i32)
    if own_error_in_defer(s, b) == 1
        return
    own_eprint_loc(line, col)
    eprints_cstr(c": error: cannot borrow `")
    own_eprint_name(b.name, b.name_len)
    eprints_cstr(c"` - `")
    own_eprint_binding_path(b, own_first_moved(s.own, b.slot, bits))
    eprints_cstr(c"` has been moved\n")
    s.error_count = s.error_count + 1

# `x.f.g`, as written.
fn own_eprint_path(e: *Expr)
    if e.kind == EXPR_MEMBER
        own_eprint_path(e.left)
        eprint_char('.')
        own_eprint_name(e.ident_ptr, e.ident_len)
    else if e.kind == EXPR_IDENT
        own_eprint_name(e.ident_ptr, e.ident_len)

fn own_error_move_from_drop(s: *EmitterState, line: i32, col: i32, e: *Expr, tname: *u8, tlen: i32)
    own_eprint_loc(line, col)
    eprints_cstr(c": error: cannot move out of `")
    own_eprint_path(e)
    eprints_cstr(c"`: `")
    own_eprint_name(tname, own_base_len(tname, tlen))
    eprints_cstr(c"` implements Drop\n")
    s.error_count = s.error_count + 1

# AGAST #2250: `e`, a `name:& T` param, is about to be read by value into a
# slot of type `name`.  A move-only T would then have two owners, so report
# what ritz0's move checker does.  This covers the slots emit_lent_referent
# and lent_array_local read for (`name` is the element's for an array); the
# rest of ritz0's rule is #2240.
pub fn own_check_lent_read(s: *EmitterState, e: *Expr, name: *u8, len: i32)
    if own_move_only_depth(s, name, len, 0) == 0
        return
    ref_error_move_out(s, e.span.line, e.span.col)

fn own_error_borrow(s: *EmitterState, e: *Expr, b: *OwnBinding)
    own_error_borrow_at(s, e.span.line, e.span.col, b)

# Record a use while shadowed (OWN_EV_USE), with the `defer` it is in.
fn own_note_use_ev(o: *OwnState, slot: i32, a: i32, line: i32, col: i32, fs: i32)
    var dl: i32 = 0
    var dc: i32 = 0
    let d: *Stmt = o.cur_defer
    if d != null
        dl = d.span.line
        dc = d.span.col
    own_ev_push(o, OWN_EV_USE, slot, a, dl, line, col, fs, dc)

# A use of an unmoved binding inside a loop: if the binding is shadowed (it
# would be moved here had the loop head been reached with it moved), record
# the use for own_loop_exit.
fn own_note_use(s: *EmitterState, b: *OwnBinding, line: i32, col: i32, borrow: i32)
    let o: *OwnState = s.own
    if o.loop_depth == 0 or b.moved == 1
        return
    let fs: i32 = b.fshadow & (OWN_ALL_PATHS ^ b.fmoved)
    if b.shadow == 1 or fs != 0
        own_note_use_ev(o, b.slot, borrow + b.shadow * 2, line, col, fs)

# A use of the paths `bits` only (AGAST #2168).
fn own_note_field_use(s: *EmitterState, b: *OwnBinding, bits: i32, line: i32, col: i32)
    let o: *OwnState = s.own
    if o.loop_depth == 0 or b.moved == 1
        return
    let fs: i32 = b.fshadow & bits
    if b.shadow == 1 or fs != 0
        own_note_use_ev(o, b.slot, b.shadow * 2, line, col, fs)

# The binding a field / element store `x.f = v`, `x[i] = v` writes into is
# used as a place: an error if it was moved, but not if one of its fields
# was (that field may be the one being assigned).
fn own_note_place_use(s: *EmitterState, b: *OwnBinding, line: i32, col: i32)
    if b.moved == 1
        own_error_use_at(s, line, col, b, b.move_line, b.move_col)
        return
    let o: *OwnState = s.own
    if o.loop_depth > 0 and b.shadow == 1
        own_note_use_ev(o, b.slot, 2, line, col, 0)

# AGAST #2242: the paths a use of `path` overlaps: it and its parents, and
# with `exact` 0 no more, as that names a field of `path` no path covers, so
# what moved out of `path` is its sibling.  With `exact` 1 its parts too.
fn own_overlap(b: *OwnBinding, path: i32, exact: i32) -> i32
    if path < 0
        return 0
    let p: *OwnPath = own_path_at(b, path)
    if exact == 1
        return p.up | p.down
    p.up

# `b.<path> = v`, once v is checked: b must still hold the parents of what
# is stored to; then the path and its parts are owned again (AGAST #2168,
# ritz0's _reown_field).  Their run-time bits clear once v is stored
# (own_field_store_end).
fn own_store_path(s: *EmitterState, b: *OwnBinding, path: i32, exact: i32, line: i32, col: i32)
    if b.moved == 1
        own_error_use_at(s, line, col, b, b.move_line, b.move_col)
        return
    var parents: i32 = own_overlap(b, path, 0)
    if exact == 1
        parents = parents ^ (1 << path)
    if (b.fmoved & parents) != 0
        own_error_field_use_at(s, line, col, b, b.fmoved & own_overlap(b, path, exact))
        return
    own_note_field_use(s, b, parents, line, col)
    if exact == 0
        return
    let p: *OwnPath = own_path_at(b, path)
    let bits: i32 = p.down
    b.fshadow = b.fshadow & (OWN_ALL_PATHS ^ bits)
    b.fmoved = b.fmoved & (OWN_ALL_PATHS ^ bits)

# The leftmost operand of a member path `x.f.g` (x).
fn own_member_root(e: *Expr) -> *Expr
    var r: *Expr = e
    while r.kind == EXPR_MEMBER and r.left != null
        r = r.left
    r

# A member path `x.f1...fn` rooted at a registered single-value binding x:
# fn's field, with x (*out_b) and the first struct along the path that has
# its own drop (*out_drop, null if none); else null.
fn own_member_path(s: *EmitterState, e: *Expr, out_b: **OwnBinding, out_drop: **u8, out_drop_len: *i32) -> *StructField
    if e.kind != EXPR_MEMBER or e.left == null
        return null
    let l: *Expr = e.left
    var tname: *u8 = null
    var tlen: i32 = 0
    if l.kind == EXPR_IDENT
        let b: *OwnBinding = own_lookup(s, l.ident_ptr, l.ident_len)
        if b == null or b.count > 0
            return null
        tname = b.type_name
        tlen = b.type_name_len
        *out_b = b
    else
        let pf: *StructField = own_member_path(s, l, out_b, out_drop, out_drop_len)
        if pf == null or pf.field_type != TYPE_STRUCT
            return null
        tname = pf.field_type_name
        tlen = pf.field_type_name_len
    let st: *StructDef = find_struct(s, tname, tlen)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    if l.kind == EXPR_IDENT
        *out_drop = null
        *out_drop_len = 0
    if *out_drop == null and own_has_drop_impl(s, tname, tlen) == 1
        *out_drop = tname
        *out_drop_len = tlen
    own_struct_field(s, tname, tlen, idx)

# AGAST #2242: the deepest path of `b` along the member path `e`, rooted at
# b (-1 for b itself); *out_exact is 1 when `e` ends on it, 0 when `e` goes on
# into a field no path covers.
fn own_path_of(b: *OwnBinding, e: *Expr, out_exact: *i32) -> i32
    if e.kind != EXPR_MEMBER or e.left == null
        *out_exact = 1
        return 0 - 1
    var exact: i32 = 0
    let parent: i32 = own_path_of(b, e.left, @exact)
    if exact == 0
        *out_exact = 0
        return parent
    let path: i32 = own_named_path(b, parent, e.ident_ptr, e.ident_len)
    if path < 0
        *out_exact = 0
        return parent
    *out_exact = 1
    path

# `call().f` with f a move-only field (ritz0's _is_move_only_field).
fn own_temp_field_move_only(s: *EmitterState, e: *Expr) -> i32
    let l: *Expr = e.left
    if l == null or l.kind != EXPR_CALL
        return 0
    var len: i32 = 0
    let name: *u8 = own_call_ret_type(s, l, @len)
    if name == null
        return 0
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        return 0
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return 0
    own_field_move_only(s, own_struct_field(s, name, len, idx), 0)

# `x.f...` (AGAST #2168, #2242): a use of that path, or with `mv` 1 a move of
# it when the path's value is move-only.
fn own_walk_member(s: *EmitterState, e: *Expr, mv: i32)
    var b: *OwnBinding = null
    var dn: *u8 = null
    var dl: i32 = 0
    let f: *StructField = own_member_path(s, e, @b, @dn, @dl)
    if f == null
        # Moving a move-only field out of a temporary: the rest of the
        # temporary isn't dropped either (ritz0: no partial drops).
        var lmv: i32 = 0
        if mv == 1 and own_temp_field_move_only(s, e) == 1
            lmv = 1
        own_walk(s, e.left, lmv)
        return
    let root: *Expr = own_member_root(e)
    let line: i32 = root.span.line
    let col: i32 = root.span.col
    if b.moved == 1
        own_error_use_at(s, line, col, b, b.move_line, b.move_col)
        return
    var exact: i32 = 0
    let path: i32 = own_path_of(b, e, @exact)
    let overlap: i32 = own_overlap(b, path, exact)
    if (b.fmoved & overlap) != 0
        own_error_field_use_at(s, line, col, b, b.fmoved & overlap)
        return
    own_note_field_use(s, b, overlap, line, col)
    if mv == 0 or own_field_move_only(s, f, 0) == 0
        return
    if dn != null
        own_error_move_from_drop(s, line, col, e, dn, dl)
        return
    if path < 0
        # Can't be tracked per path: the whole binding moves.
        b.moved = 1
        b.move_line = line
        b.move_col = col
        own_store_flag(s, b, 0)
        return
    b.fmoved = b.fmoved | (1 << path)
    own_fm_push(s.own, b.slot, path, line, col)
    own_emit_mask_bits(s, b, 1 << path, 1)

# The move-only struct type a call returns by value (its length in
# *out_len), or null.
fn own_call_ret_type(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    if e.kind != EXPR_CALL
        return null
    let f: *FnDef = find_call_fn(s, e)
    if f == null or f.return_type != TYPE_STRUCT or f.return_type_name_len <= 0
        return null
    if own_type_is_move_only(s, f.return_type_name, f.return_type_name_len) == 0
        return null
    *out_len = f.return_type_name_len
    f.return_type_name

# AGAST #2266: the struct T an array literal `[a, b, ..]` holds, as `[N]T`:
# returns N and writes T's name, or returns 0 (name null) when no element
# names a struct.  The first element whose type ritz1 can name decides; a
# string literal names none (its `%Span$u8` isn't the slot's `%StrView`).
pub fn array_lit_struct_elem(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if e == null or e.kind != EXPR_ARRAY_LIT
        return 0
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        if *out_len == 0 and it.kind == EXPR_STRUCT_LIT and it.ident_len > 0
            *out_name = it.ident_ptr as *u8
            *out_len = it.ident_len
        else if *out_len == 0 and it.kind != EXPR_STRING_LIT
            var t: RefTy
            if ref_ty_of(s, it, @t) == 1 and t.kind == TYPE_STRUCT and t.name_len > 0
                *out_name = t.name
                *out_len = t.name_len
        n += 1
        it = it.next
    if *out_len == 0
        return 0
    n

# The move-only type a temporary `e` holds, or null: a call's result (count
# 0), or an array literal's elements (count N, AGAST #2266).
fn own_temp_type(s: *EmitterState, e: *Expr, out_len: *i32, out_count: *i32) -> *u8
    *out_count = 0
    if e.kind != EXPR_ARRAY_LIT
        return own_call_ret_type(s, e, out_len)
    var name: *u8 = null
    var len: i32 = 0
    let n: i32 = array_lit_struct_elem(s, e, @name, @len)
    if n == 0 or own_type_is_move_only(s, name, len) == 0
        return null
    *out_len = len
    *out_count = n
    name

# `e`, a call or array literal whose move-only value nobody takes, yields a
# temporary: remember it for own_note_temp / own_note_array_temp.
fn own_mark_temp(s: *EmitterState, e: *Expr)
    var len: i32 = 0
    var count: i32 = 0
    if own_temp_type(s, e, @len, @count) == null
        return
    let o: *OwnState = s.own
    if o.temp_expr_count >= o.temp_expr_cap
        let cap: i32 = o.temp_expr_cap * 2
        o.temp_exprs = realloc(o.temp_exprs as *u8, (cap as i64) * 8) as **Expr
        o.temp_expr_cap = cap
    let te: **Expr = o.temp_exprs
    te[o.temp_expr_count] = e
    o.temp_expr_count = o.temp_expr_count + 1

# 1 when an argument bound to `p` is passed by value (a move).  A reference
# param borrows its argument; an unknown callee is taken as by-value.
fn own_param_moves(p: *Param) -> i32
    if p == null
        return 1
    if p.param_type == TYPE_REF or p.param_type == TYPE_MUT_REF or p.param_type == TYPE_PTR or p.param_type == TYPE_PTR_PTR
        return 0
    1

fn own_walk_args(s: *EmitterState, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        own_walk(s, a, own_param_moves(p))
        if p != null
            p = p.next
        a = a.next

# The struct a method receiver names, as emitter_expr_call's method_recv_type does.
fn own_recv_def(s: *EmitterState, e: *Expr) -> *FnDef
    let recv: *Expr = e.left
    if recv == null or recv.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, recv.ident_ptr, recv.ident_len)
    if loc == null or loc.type_name_len <= 0
        return null
    return method_callee_def(s, loc.type_name, loc.type_name_len, e.ident_ptr, e.ident_len)

# AGAST #2336: `e` (`*r`, `r.f`, `p[i]`) names a move-only value behind a
# reference.  Used by value it would have two owners.  A bare `:&` param is
# own_check_lent_read's, at the read.
fn own_moves_out(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        return 0
    var name: *u8 = null
    var len: i32 = 0
    if own_value_struct(s, e, @name, @len) == 0
        return 0
    if own_type_is_move_only(s, name, len) == 0
        return 0
    ref_through(s, e)

# The struct `e` holds by value: 1 and its name, or 0.  `p[i]` and `(*p)[i]` through
# a Vec or Span hold its element (AGAST #2444, R9), which ref_ty_of doesn't name.
fn own_value_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    if e.kind == EXPR_INDEX and index_through(s, e) != null
        return index_through_value_struct(s, e, out_name, out_len)
    var t: RefTy
    if ref_ty_of(s, e, @t) == 0 or t.kind != TYPE_STRUCT or t.name_len == 0
        return 0
    *out_name = t.name
    *out_len = t.name_len
    1

# The line and column an error about `e` points at: where it starts.
fn own_start_of(e: *Expr) -> *Expr
    var r: *Expr = e
    while r.left != null and (r.kind == EXPR_MEMBER or r.kind == EXPR_INDEX or r.kind == EXPR_METHOD)
        r = r.left
    r

# AGAST #2336: a by-value `self` method on a reference to a move-only value.
fn own_check_ref_receiver(s: *EmitterState, e: *Expr)
    var name: *u8 = null
    var len: i32 = 0
    var is_ptr: i32 = 0
    var m: *FnDef = null
    if e.left != null and e.left.kind == EXPR_INDEX and index_through(s, e.left) != null
        # `p[i].m()`: the element's method, on the element's type (AGAST #2444).
        if index_through_value_struct(s, e.left, @name, @len) == 0
            return
        m = method_callee_def(s, name, len, e.ident_ptr, e.ident_len)
    else
        var t: RefTy
        if ref_ty_of(s, e.left, @t) == 0 or t.name_len == 0
            return
        name = t.name
        len = t.name_len
        is_ptr = ref_is_pointer(t.kind)
        m = ref_method_def(s, e)
    if m == null or m.params == null or own_param_moves(m.params) == 0 or m.params.is_borrow == 1
        return
    if name_eq(m.params.name, m.params.name_len, c"self", 4) == 0
        return
    if own_type_is_move_only(s, name, len) == 0
        return
    if is_ptr == 1 or ref_through(s, e.left) == 1
        let at: *Expr = own_start_of(e)
        ref_error_move_out(s, at.span.line, at.span.col)

# A scrutinee moves into its match, unless a reference holds it: that's a read.
fn own_scrutinee_mv(s: *EmitterState, e: *Expr) -> i32
    if ref_through(s, e) == 1
        return 0
    1

# Check one expression, in evaluation order.  `mv` is 1 when its value is
# used by value (a move for a move-only binding).  Mirrors ritz0's
# MoveChecker._check_expr.  Match / if-expression arms are checked as their
# bodies are emitted (own_check_arm).
pub fn own_walk(s: *EmitterState, e: *Expr, mv: i32)
    if e == null
        return
    let k: i32 = e.kind
    if mv == 1 and own_moves_out(s, e) == 1
        let at: *Expr = own_start_of(e)
        ref_error_move_out(s, at.span.line, at.span.col)
        return
    if k == EXPR_IDENT
        let b: *OwnBinding = own_lookup(s, e.ident_ptr, e.ident_len)
        if b == null
            return
        if b.moved == 1
            own_error_use(s, e, b)
            return
        if b.fmoved != 0
            own_error_field_use_at(s, e.span.line, e.span.col, b, b.fmoved)
            return
        own_note_use(s, b, e.span.line, e.span.col, 0)
        if mv == 1
            b.moved = 1
            b.move_line = e.span.line
            b.move_col = e.span.col
            own_store_flag(s, b, 0)
    else if k == EXPR_UNARY
        if (e.op == OP_ADDR or e.op == OP_ADDR_MUT) and e.operand != null and e.operand.kind == EXPR_IDENT
            let bb: *OwnBinding = own_lookup(s, e.operand.ident_ptr, e.operand.ident_len)
            if bb != null
                if bb.moved == 1
                    own_error_borrow(s, e, bb)
                else if bb.fmoved != 0
                    own_error_borrow_field_at(s, e.span.line, e.span.col, bb, bb.fmoved)
                else
                    own_note_use(s, bb, e.span.line, e.span.col, 1)
            return
        own_walk(s, e.operand, 0)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        own_walk(s, e.left, 0)
        own_walk(s, e.right, 0)
    else if k == EXPR_MEMBER
        own_walk_member(s, e, mv)
    else if k == EXPR_CAST
        own_walk(s, e.left, 0)
    else if k == EXPR_TRY
        own_walk(s, e.left, mv)
    else if k == EXPR_CALL
        # sizeof's operand is never evaluated (ritz0 #2124).
        if e.func_name_len == 6 and name_eq(e.func_name, e.func_name_len, c"sizeof", 6) == 1
            return
        var p: *Param = null
        let f: *FnDef = find_call_fn(s, e)
        if f != null
            p = f.params
        own_walk_args(s, e.args, p)
        # A result nobody takes is a temporary (AGAST #2165).
        if mv == 0 and f != null
            own_mark_temp(s, e)
    else if k == EXPR_METHOD
        # A by-value `self` takes the receiver, as a by-value param takes its
        # argument (AGAST #2393).  Any other is passed by pointer.  A call result
        # as receiver is not a temporary here: ritz1 drops no method's yet
        # (AGAST #2262).
        let m: *FnDef = own_recv_def(s, e)
        var rmv: i32 = 0
        if e.left != null and e.left.kind == EXPR_CALL
            rmv = 1
        let taken: *FnDef = ref_method_def(s, e)
        if taken != null and param_self_is_value(taken.params) == 1
            rmv = 1
        own_check_ref_receiver(s, e)
        own_walk(s, e.left, rmv)
        var mp: *Param = null
        if m != null
            mp = m.params
            if mp != null
                mp = mp.next
        own_walk_args(s, e.args, mp)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            own_walk(s, fi.value, 1)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        # A literal owns its elements (ritz0 #2238, AGAST #2266): each moves
        # in, as into a struct literal's field, and a literal nobody takes
        # is a temporary that drops them.
        var el: *Expr = e.args
        while el != null
            if own_moves_out(s, el) == 1
                let eat: *Expr = own_start_of(el)
                ref_error_move_out(s, eat.span.line, eat.span.col)
            else
                own_walk(s, el, 1)
            el = el.next
        if mv == 0
            own_mark_temp(s, e)
    else if k == EXPR_MATCH
        own_walk(s, e.left, own_scrutinee_mv(s, e.left))
    else if k == EXPR_IF
        own_walk(s, e.left, 0)

# 1 when the move check should look at code at this point.
fn own_checking(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    if o.live_count == 0 and own_any_drop(s) == 0
        return 0
    if own_scope_is_dead(o) == 1
        return 0
    1

# The index of field `name` in the binding's struct, or -1.
fn own_field_idx(s: *EmitterState, b: *OwnBinding, name: *u8, len: i32) -> i32
    let st: *StructDef = find_struct(s, b.type_name, b.type_name_len)
    if st == null
        return 0 - 1
    find_field_index(st, name, len)

# The binding a whole-binding assignment `x = v` writes, or null.
fn own_assign_target(s: *EmitterState, stmt: *Stmt) -> *OwnBinding
    if stmt.kind != STMT_ASSIGN
        return null
    if stmt.assign_target_len > 0
        return own_lookup(s, stmt.assign_target, stmt.assign_target_len)
    let t: *Expr = stmt.if_cond as *Expr
    if t != null and t.kind == EXPR_IDENT
        return own_lookup(s, t.ident_ptr, t.ident_len)
    null

# Field stores (AGAST #2173).  `x.f = v` drops the old x.f, as `x = v`
# drops the old x (§13.6), after v is evaluated (v may read or move it):
# iff x owns a value (its drop flag) and f isn't moved out of it (its
# `fmask` bit).  The move check computes that i1 after checking v (whose
# moves it sees) and before re-owning f, into OwnState.fa_cond;
# own_assign_begin copies the old value aside and own_assign_end drops the
# copy once v is stored.  A deeper path `x.a.t = v` drops the old x.a.t on
# x's flag and the bits of a and t: the move check rejects it with a moved
# out (as Rust does, E0382), so the store never re-owns part of a moved
# field.  A field with parts moved out drops what is left of it (AGAST
# #2242).  A store through a pointer, or into an array element, drops nothing
# (AGAST #2179).

# The i1 "x owns the path whose bit and its parents' are `bits`" (x's flag,
# and those bits clear), or 0 when x can't own it (an array binding).
fn own_field_drop_cond(s: *EmitterState, b: *OwnBinding, bits: i32) -> i32
    if b.count > 0
        return 0
    let f: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, f)
    emit_str(s, c" = load i1, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    if b.fmask == 0 or bits == 0
        return f
    let m: i32 = own_load_mask(s, b)
    let t: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, t)
    emit_str(s, c" = and i32 ")
    emit_reg(s, m)
    emit_str(s, c", ")
    emit_int(s, bits as i64)
    emit_str(s, c"\n")
    let c: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, c)
    emit_str(s, c" = icmp eq i32 ")
    emit_reg(s, t)
    emit_str(s, c", 0\n")
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = and i1 ")
    emit_reg(s, f)
    emit_str(s, c", ")
    emit_reg(s, c)
    emit_str(s, c"\n")
    r

# A store to the move-only value at `path` of `b`: the drop condition of its
# old value into o.fa_cond, and when `path` is the value stored to, the mask
# saying which of its parts that old value has left.
fn own_store_cond(s: *EmitterState, b: *OwnBinding, path: i32, exact: i32)
    let o: *OwnState = s.own
    o.fa_cond = own_field_drop_cond(s, b, own_overlap(b, path, 0))
    if exact == 1
        o.fa_path = path
        o.fa_mask = own_load_mask(s, b)

# `t = v` with t a member path `x.f...` rooted at the binding `b`, whose last
# field is `f`.
fn own_field_store_cond(s: *EmitterState, b: *OwnBinding, f: *StructField, path: i32, exact: i32)
    if own_field_move_only(s, f, 0) == 1
        own_store_cond(s, b, path, exact)

# `x.f = v` (STMT_LOCAL_FIELD_ASSIGN) with x the binding `b`: as
# own_field_store_cond; returns f's path, with *out_exact.
fn own_local_field_path(s: *EmitterState, b: *OwnBinding, stmt: *Stmt, out_exact: *i32) -> i32
    let path: i32 = own_named_path(b, 0 - 1, stmt.assign_target, stmt.assign_target_len)
    *out_exact = 0
    if path >= 0
        *out_exact = 1
    let idx: i32 = own_field_idx(s, b, stmt.assign_target, stmt.assign_target_len)
    if idx >= 0
        let f: *StructField = own_struct_field(s, b.type_name, b.type_name_len, idx)
        if f != null
            own_field_store_cond(s, b, f, path, *out_exact)
    path

# Check one statement before it is emitted (emit_stmt).  Nested statement
# lists are checked as emit_stmt reaches them.  Mirrors ritz0's _check_stmt.
pub fn own_check_stmt(s: *EmitterState, stmt: *Stmt)
    let o: *OwnState = s.own
    o.fa_cond = 0
    o.fa_path = 0 - 1
    o.fa_mask = 0
    ref_loans_at(o.scope_count)
    ref_check_stmt(s, stmt)
    if own_checking(s) == 0
        return
    let k: i32 = stmt.kind
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        own_walk(s, stmt.var_init, 1)
    else if k == STMT_ASSIGN
        let t: *Expr = stmt.if_cond as *Expr
        # `x.f... = v` (AGAST #2168, #2242): v first, as ritz0 checks it, since
        # it can move what is stored to; then the path is owned again.
        var pb: *OwnBinding = null
        var pf: *StructField = null
        if stmt.assign_target_len == 0 and t != null and t.kind == EXPR_MEMBER
            var dn: *u8 = null
            var dl: i32 = 0
            pf = own_member_path(s, t, @pb, @dn, @dl)
        if pf == null and stmt.assign_target_len == 0 and t != null and t.kind != EXPR_IDENT
            own_walk(s, t, 0)
        own_walk(s, stmt.assign_value, 1)
        if pf != null
            var exact: i32 = 0
            let path: i32 = own_path_of(pb, t, @exact)
            own_field_store_cond(s, pb, pf, path, exact)
            let root: *Expr = own_member_root(t)
            own_store_path(s, pb, path, exact, root.span.line, root.span.col)
    else if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # `x[i] = v`, `x.f = v`, `x.f[i] = v`: x is used, not moved.
        var base: *OwnBinding = null
        if k == STMT_INDEX_ASSIGN
            base = own_lookup(s, stmt.assign_target, stmt.assign_target_len)
        else
            base = own_lookup(s, stmt.var_name, stmt.var_name_len)
        if k == STMT_LOCAL_FIELD_ASSIGN and base != null and base.count == 0
            # `x.f = v`, as the path store above.
            own_walk(s, stmt.assign_value, 1)
            var exact: i32 = 0
            let path: i32 = own_local_field_path(s, base, stmt, @exact)
            own_store_path(s, base, path, exact, stmt.span.line, stmt.span.col)
            return
        if base != null
            own_note_place_use(s, base, stmt.span.line, stmt.span.col)
        if k != STMT_LOCAL_FIELD_ASSIGN
            own_walk(s, stmt.while_cond, 0)
        own_walk(s, stmt.assign_value, 1)
    else if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        own_walk(s, stmt.assign_value, 1)
    else if k == STMT_RETURN
        own_walk(s, stmt.return_value, 1)
    else if k == STMT_EXPR
        own_walk(s, stmt.expr, 0)
    else if k == STMT_MATCH
        # AGAST #2174: the scrutinee moves into the match, as in the
        # expression form and ritz0 (own_match_begin takes ownership).
        own_walk(s, stmt.if_cond as *Expr, own_scrutinee_mv(s, stmt.if_cond as *Expr))
    else if k == STMT_IF or k == STMT_ASSERT
        own_walk(s, stmt.if_cond, 0)
    else if k == STMT_WHILE
        own_walk(s, stmt.while_cond, 0)
    else if k == STMT_FOR
        own_walk(s, stmt.for_start, 0)
        own_walk(s, stmt.for_end, 0)

# After a statement is emitted: a `return` ends its block for the check,
# and so does a `break` / `continue` in a loop (their moves reach the loop
# head or exit through own_loop_jump's events instead).
pub fn own_after_stmt(s: *EmitterState, stmt: *Stmt)
    let o: *OwnState = s.own
    ref_loans_at(o.scope_count)   # AGAST #2950: the statement's own block
    ref_after_stmt(s, stmt)
    if o.scope_count <= 0
        return
    if stmt.kind == STMT_RETURN
        own_mark_dead(o)
    else if (stmt.kind == STMT_BREAK or stmt.kind == STMT_CONTINUE) and o.loop_depth > 0
        own_mark_dead(o)

# A fn's tail expression is its return value: a move.
pub fn own_check_tail(s: *EmitterState, e: *Expr)
    ref_check_value(s, e)
    if own_checking(s) == 0
        return
    own_walk(s, e, 1)

# A match / if-expression arm's value expression.
pub fn own_check_arm(s: *EmitterState, e: *Expr)
    ref_check_value(s, e)
    if own_checking(s) == 0
        return
    own_walk(s, e, 1)

# =============================================================================
# Reassignment
# =============================================================================

# The LLVM type of a binding's storage: `[N x %T]` for an array (an N-D
# array's leaves are contiguous, so a flat array of them is its layout).
fn own_emit_binding_type(s: *EmitterState, b: *OwnBinding)
    if b.count > 0
        emit_str(s, c"[")
        emit_int(s, b.count as i64)
        emit_str(s, c" x ")
        emit_llvm_type_struct(s, TYPE_STRUCT, b.type_name, b.type_name_len)
        emit_str(s, c"]")
        return
    emit_llvm_type_struct(s, TYPE_STRUCT, b.type_name, b.type_name_len)

# Before `x = v` is emitted: copy x's old value aside with its flag (and
# its moved-field mask), so it can be dropped once v (which may still read
# x) has been stored.  Returns a handle for own_assign_end (a copy of x's
# binding, freed there), or null when x is not an owned binding.
pub fn own_assign_begin(s: *EmitterState, stmt: *Stmt, out_old: *i32, out_flag: *i32) -> *OwnBinding
    *out_old = 0
    *out_flag = 0
    let o: *OwnState = s.own
    if o.fa_cond != 0
        let cond: i32 = o.fa_cond
        o.fa_cond = 0
        return own_field_store_begin(s, stmt, cond, out_old, out_flag)
    if o.live_count == 0
        return null
    let b: *OwnBinding = own_assign_target(s, stmt)
    if b == null
        return null
    let f: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, f)
    emit_str(s, c" = load i1, ptr ")
    emit_reg(s, b.flag)
    emit_str(s, c"\n")
    let m: i32 = own_load_mask(s, b)
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca ")
    own_emit_binding_type(s, b)
    emit_str(s, c"\n")
    let v: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v)
    emit_str(s, c" = load ")
    own_emit_binding_type(s, b)
    emit_str(s, c", ptr ")
    emit_reg(s, b.slot)
    emit_str(s, c"\n")
    emit_str(s, c"  store ")
    own_emit_binding_type(s, b)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    *out_old = tmp
    *out_flag = f
    let h: *OwnBinding = malloc(sizeof(OwnBinding)) as *OwnBinding
    own_copy_binding(h, b)
    h.aux = m
    h.old_field = null
    h

# The field `fname` of the struct `tname` at `base`: a pointer to it (and
# the field in *out_f), or 0.
fn own_field_ptr(s: *EmitterState, base: i32, tname: *u8, tlen: i32, fname: *u8, flen: i32, out_f: **StructField) -> i32
    let st: *StructDef = find_struct(s, tname, tlen)
    if st == null
        return 0
    let idx: i32 = find_field_index(st, fname, flen)
    if idx < 0
        return 0
    let f: *StructField = get_field_type(st, idx)
    var r: MemberPtrResult
    emit_member_gep_from_ptr(s, @r, base, st, idx, f)
    *out_f = f
    r.reg

# A member path `x.f...` rooted at a single-value binding x (*out_b): a
# pointer to its field (*out_f), or 0.
fn own_place_ptr(s: *EmitterState, e: *Expr, out_f: **StructField, out_b: **OwnBinding) -> i32
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return 0
    let l: *Expr = e.left
    if l.kind == EXPR_IDENT
        let b: *OwnBinding = own_lookup(s, l.ident_ptr, l.ident_len)
        if b == null or b.count > 0
            return 0
        *out_b = b
        return own_field_ptr(s, b.slot, b.type_name, b.type_name_len, e.ident_ptr, e.ident_len, out_f)
    var pf: *StructField = null
    let base: i32 = own_place_ptr(s, l, @pf, out_b)
    if base == 0 or pf.field_type != TYPE_STRUCT
        return 0
    own_field_ptr(s, base, pf.field_type_name, pf.field_type_name_len, e.ident_ptr, e.ident_len, out_f)

# AGAST #2173: before the field store `x.f... = v` (own_check_stmt found
# x owns its old value on the i1 `cond`): copy the old value aside.  The
# handle (x's binding, with old_field set) is for own_assign_end.
fn own_field_store_begin(s: *EmitterState, stmt: *Stmt, cond: i32, out_old: *i32, out_flag: *i32) -> *OwnBinding
    var f: *StructField = null
    var b: *OwnBinding = null
    var ptr: i32 = 0
    if stmt.kind == STMT_LOCAL_FIELD_ASSIGN
        b = own_lookup(s, stmt.var_name, stmt.var_name_len)
        if b == null or b.count > 0
            return null
        ptr = own_field_ptr(s, b.slot, b.type_name, b.type_name_len, stmt.assign_target, stmt.assign_target_len, @f)
    else if stmt.kind == STMT_ASSIGN
        ptr = own_place_ptr(s, stmt.if_cond as *Expr, @f, @b)
    if ptr == 0 or f == null or b == null
        return null
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca ")
    emit_field_llvm_type(s, f)
    emit_str(s, c"\n")
    let v: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v)
    emit_str(s, c" = load ")
    emit_field_llvm_type(s, f)
    emit_str(s, c", ptr ")
    emit_reg(s, ptr)
    emit_str(s, c"\n  store ")
    emit_field_llvm_type(s, f)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    *out_old = tmp
    *out_flag = cond
    let h: *OwnBinding = malloc(sizeof(OwnBinding)) as *OwnBinding
    own_copy_binding(h, b)
    let o: *OwnState = s.own
    h.old_field = f
    h.old_path = o.fa_path
    h.aux = o.fa_mask
    h

# After the field store: drop the old value copied aside, if x owned it, and
# clear the stored path's moved bits.  Not before now: a `?` in the value
# leaves with the path still moved.  And whatever the check saw: a later move
# can reach this store round a loop.
fn own_field_store_end(s: *EmitterState, h: *OwnBinding, old: i32, cond: i32)
    let saved: i32 = last_expr_here(s)
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    if h.old_path >= 0 and h.aux != 0 and own_has_parts(h, h.old_path) == 1
        own_emit_masked_glue(s, old, h, h.old_path, h.aux)
    else
        own_emit_field_glue(s, old, h.old_field, 1)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)
    if h.old_path >= 0
        let p: *OwnPath = own_path_at(h, h.old_path)
        own_emit_mask_bits(s, h, p.down, 0)
    if saved != 0
        set_last_expr(s, saved)
    free(h as *u8)

# After `x = v` is emitted: x owns v; drop the old value if x owned one.
# `h` is own_assign_begin's handle; x is looked up again by its storage, as
# emitting v may have moved the live list.
pub fn own_assign_end(s: *EmitterState, h: *OwnBinding, old: i32, old_flag: i32)
    if h == null
        return
    if h.old_field != null
        own_field_store_end(s, h, old, old_flag)
        return
    let o: *OwnState = s.own
    var b: *OwnBinding = h
    var i: i32 = o.live_count - 1
    while i >= 0
        let lb: *OwnBinding = own_live_at(o, i)
        if lb.slot == h.slot
            b = lb
            break
        i -= 1
    b.moved = 0
    b.shadow = 0
    b.fmoved = 0
    b.fshadow = 0
    own_store_flag(s, b, 1)
    own_store_mask(s, b, 0)
    let saved: i32 = last_expr_here(s)
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, old_flag)
    emit_str(s, c", label %")
    emit_label(s, do_label)
    emit_str(s, c", label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, do_label)
    own_emit_binding_glue(s, h, old, h.aux)
    emit_str(s, c"  br label %")
    emit_label(s, next)
    emit_str(s, c"\n")
    begin_block(s, next)
    if saved != 0
        set_last_expr(s, saved)
    free(h as *u8)

# =============================================================================
# `if` merge for the move check (ritz0's If handling)
# =============================================================================

# The moved state of every live binding: OWN_SNAP_INTS i32s each (moved,
# its line and column, shadow, fmoved, fshadow) after a count.  null when
# nothing is tracked.
const OWN_SNAP_INTS: i32 = 6

pub fn own_snapshot(s: *EmitterState) -> *i32
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let snap: *i32 = malloc(((o.live_count * OWN_SNAP_INTS + 1) * 4) as i64) as *i32
    snap[0] = o.live_count
    var i: i32 = 0
    while i < o.live_count
        let b: *OwnBinding = own_live_at(o, i)
        let r: *i32 = snap + 1 + i * OWN_SNAP_INTS
        r[0] = b.moved
        r[1] = b.move_line
        r[2] = b.move_col
        r[3] = b.shadow
        r[4] = b.fmoved
        r[5] = b.fshadow
        i += 1
    snap

pub fn own_restore(s: *EmitterState, snap: *i32)
    if snap == null
        return
    let o: *OwnState = s.own
    var n: i32 = snap[0]
    if n > o.live_count
        n = o.live_count
    var i: i32 = 0
    while i < n
        let b: *OwnBinding = own_live_at(o, i)
        let r: *i32 = snap + 1 + i * OWN_SNAP_INTS
        b.moved = r[0]
        b.move_line = r[1]
        b.move_col = r[2]
        b.shadow = r[3]
        b.fmoved = r[4]
        b.fshadow = r[5]
        i += 1

# Paths meet: what `into` holds is moved (shadowed) if it is on either
# path; a binding moved on both keeps `into`'s move, as ritz0's _join keeps
# the first path's.
fn own_join_snap(into: *i32, other: *i32)
    var n: i32 = into[0]
    if other[0] < n
        n = other[0]
    var i: i32 = 0
    while i < n
        let a: *i32 = into + 1 + i * OWN_SNAP_INTS
        let b: *i32 = other + 1 + i * OWN_SNAP_INTS
        if a[0] == 0 and b[0] == 1
            a[0] = 1
            a[1] = b[1]
            a[2] = b[2]
        a[3] = a[3] | b[3]
        a[4] = a[4] | b[4]
        a[5] = a[5] | b[5]
        i += 1

# Neither arm returned: a binding moved in the then-arm (`after_then`) is
# moved after the `if` too (the else-arm's state is current).  Moved in
# both, it reports the then-arm's move, as ritz0 does.  `shadow` and the
# field bits merge the same way.
pub fn own_merge_moved(s: *EmitterState, after_then: *i32)
    if after_then == null
        return
    let now: *i32 = own_snapshot(s)
    if now == null
        return
    own_join_snap(after_then, now)
    own_restore(s, after_then)
    free(now as *u8)

# Match / if-expression arms (AGAST #2168, ritz0 #2161).  Each arm starts
# from the state before the first (own_arms_begin's snapshot; own_arm_begin
# restores it); own_arm_end joins the state of an arm that falls through
# into `*acc`; own_arms_end settles the result: the join, or (no arm falls
# through) the last arm's state, as ritz0 leaves it.
pub fn own_arms_begin(s: *EmitterState) -> *i32
    own_snapshot(s)

pub fn own_arm_begin(s: *EmitterState, before: *i32)
    own_restore(s, before)

pub fn own_arm_end(s: *EmitterState, acc: **i32)
    let o: *OwnState = s.own
    if o.last_pop_dead == 1
        return
    let now: *i32 = own_snapshot(s)
    if now == null
        return
    if *acc == null
        *acc = now
        return
    own_join_snap(*acc, now)
    free(now as *u8)

pub fn own_arms_end(s: *EmitterState, before: *i32, acc: *i32)
    if acc != null
        own_restore(s, acc)
        free(acc as *u8)
    if before != null
        free(before as *u8)

# Match scrutinees (AGAST #2174).  A match moves its scrutinee (ritz0's
# rule), so the match owns that value: emit_match spills it, and
# own_match_begin registers the spill as a nameless binding in a scope of
# its own.  An arm whose pattern binds a move-only payload (`Full(t)`)
# hands it to the binding (own_match_payload: the binding is owned and
# drops at the arm's end unless moved; the scrutinee's flag is cleared on
# that path); any other arm leaves it to the scrutinee, which
# own_match_end drops after the arms meet.  A borrowed scrutinee (`match
# @s`), or one read through a pointer, moves nothing and owns nothing.

# 1 when the move check just moved `e`, a match scrutinee, by value.
fn own_scrutinee_moved(s: *EmitterState, e: *Expr) -> i32
    if own_checking(s) == 0
        return 0
    let k: i32 = e.kind
    if k == EXPR_IDENT
        let b: *OwnBinding = own_lookup(s, e.ident_ptr, e.ident_len)
        if b != null and b.count == 0 and b.moved == 1
            return 1
        return 0
    if k == EXPR_CALL
        var len: i32 = 0
        if own_call_ret_type(s, e, @len) != null
            return 1
        return match_scrutinee_builds(s, e)   # AGAST #2419
    if k == EXPR_METHOD
        return match_scrutinee_builds(s, e)
    if k == EXPR_MEMBER
        var b: *OwnBinding = null
        var dn: *u8 = null
        var dl: i32 = 0
        let f: *StructField = own_member_path(s, e, @b, @dn, @dl)
        if f != null and dn == null and own_field_move_only(s, f, 0) == 1
            return 1
    0

# Before a match's arms: `slot` holds the spilled scrutinee `e` of enum
# type `name`.  Returns the state for own_match_end.
pub fn own_match_begin(s: *EmitterState, e: *Expr, slot: i32, name: *u8, len: i32) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.match_scrut
    o.match_scrut = 0 - 1
    if e == null or slot == 0 or name == null or len <= 0
        return old
    if own_type_is_move_only(s, name, len) == 0 or own_scrutinee_moved(s, e) == 0
        return old
    own_push_scope(s)
    let flag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, flag)
    emit_str(s, c" = alloca i1  ; drop flag (match scrutinee)\n")
    own_grow_live(o)
    let b: *OwnBinding = own_live_at(o, o.live_count)
    b.name = null
    b.name_len = 0
    b.local_idx = 0 - 1
    b.slot = slot
    b.flag = flag
    b.type_name = name
    b.type_name_len = len
    b.moved = 0
    b.move_line = 0
    b.move_col = 0
    b.count = 0
    b.shadow = 0
    b.paths = null
    b.path_count = 0
    b.fmask = 0
    b.fmoved = 0
    b.fshadow = 0
    b.aux = 0
    o.match_scrut = o.live_count
    o.live_count = o.live_count + 1
    # In `all` too, so a `return` in an arm drops it.
    own_grow_all(o)
    own_copy_binding(own_all_at(o, o.all_count), b)
    o.all_count = o.all_count + 1
    own_store_flag(s, b, 1)
    old

# An arm bound the local `name` to a copy of the payload: when the match
# owns its scrutinee and the payload is move-only, the binding owns it now.
pub fn own_match_payload(s: *EmitterState, name: *u8, len: i32)
    let o: *OwnState = s.own
    if o.match_scrut < 0
        return
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return
    let n: i32 = o.live_count
    own_register(s, idx, 1)
    if o.live_count > n
        own_store_flag(s, own_live_at(o, o.match_scrut), 0)

# After the arms have met (and the result phi is emitted): drop the
# scrutinee where no arm took it, and restore the enclosing match's state.
pub fn own_match_end(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    if o.match_scrut >= 0
        own_pop_scope(s)
    o.match_scrut = old

# STMT_IF, after both arms: settle the move state per ritz0.
pub fn own_if_merge(s: *EmitterState, before: *i32, after_then: *i32, then_dead: i32, has_else: i32, else_dead: i32)
    # Both arms returned: what follows is dead.  Only the then-arm returned:
    # the else-arm's state (current) stands.
    if has_else == 0
        if then_dead == 1
            own_restore(s, before)
    else if then_dead == 0 and else_dead == 1
        own_restore(s, after_then)
    else if then_dead == 0 and else_dead == 0
        own_merge_moved(s, after_then)
    if before != null
        free(before as *u8)
    if after_then != null
        free(after_then as *u8)

# =============================================================================
# End of fn: zero the flags in the entry block, drop before every `ret`
# =============================================================================

fn own_emit_ret_drops(s: *EmitterState)
    let o: *OwnState = s.own
    var i: i32 = o.all_count - 1
    while i >= 0
        let b: *OwnBinding = own_all_at(o, i)
        let seq: i32 = o.ret_seq
        o.ret_seq = o.ret_seq + 1
        let f: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, f)
        emit_str(s, c" = load i1, ptr ")
        emit_reg(s, b.flag)
        emit_str(s, c"\n  br i1 ")
        emit_reg(s, f)
        emit_str(s, c", label %own.d")
        emit_int(s, seq as i64)
        emit_str(s, c", label %own.n")
        emit_int(s, seq as i64)
        emit_str(s, c"\nown.d")
        emit_int(s, seq as i64)
        emit_str(s, c":\n")
        emit_str(s, c"  store i1 0, ptr ")
        emit_reg(s, b.flag)
        emit_str(s, c"\n")
        own_emit_binding_glue(s, b, b.slot, own_load_mask(s, b))
        emit_str(s, c"  br label %own.n")
        emit_int(s, seq as i64)
        emit_str(s, c"\nown.n")
        emit_int(s, seq as i64)
        emit_str(s, c":\n")
        i -= 1

# Called once the body is complete, before hoist_entry_allocas (which then
# moves the flag allocas above the zeroing stores).
pub fn own_end_fn(s: *EmitterState, body_start: i64)
    let o: *OwnState = s.own
    o.scope_count = 0
    o.live_count = 0
    o.loop_base = -1
    o.temp_expr_count = 0
    o.temp_count = 0
    o.loop_ev_count = 0
    o.loop_depth = 0
    o.defer_count = 0
    s.defer_live = 0
    if o.all_count == 0
        return
    let n: i64 = s.out.len - body_start
    if n <= 0
        return
    let base: *u8 = malloc(n)
    memcpy(base, s.out.data + body_start, n)
    let end: *u8 = base + n
    s.out.len = body_start
    var i: i32 = 0
    while i < o.all_count
        own_store_flag(s, own_all_at(o, i), 0)
        i += 1
    var p: *u8 = base
    while p < end
        let ll: i64 = ll_line_len(p, end)
        if ll_starts_with(p, ll, c"  ret ") == 1 or ll_starts_with(p, ll, c"  ret\n") == 1
            own_emit_ret_drops(s)
        vec_push_bytes<u8>(s.out, p, ll)
        p = p + ll
    free(base)
    o.all_count = 0

# =============================================================================
# `defer` (LANGUAGE_SPEC §13.7, LARB R14, AGAST #1625)
# =============================================================================
#
# Nothing is emitted at a `defer`: own_defer registers it in the innermost
# block, at the current end of `live`.  Every exit of that block then emits
# the statement in place, through emit_stmt, as if it were written there --
# so it reads its names' values at exit, and the move check sees it at
# each exit.  A block's deferred statements and its bindings' drops run
# together, newest first (own_unwind):
#   - falling off the end: own_pop_scope (after the arm's value);
#   - `break` / `continue`: own_loop_jump, for the blocks inside the loop;
#   - `return`, `?` and a fn's tail: own_before_ret, before every `ret`
#     (emit_str spots it, once the value is computed), for every block.
# A `defer` that isn't reached registers nothing, since the emitter only
# reaches it on the paths that do.  A deferred statement may move a binding:
# its flag clears, so the drop that follows it is skipped at run time.

fn own_grow_defers(o: *OwnState)
    if o.defer_count < o.defer_cap
        return
    let cap: i32 = o.defer_cap * 2
    o.defer_stmts = realloc(o.defer_stmts as *u8, (cap as i64) * 8) as **Stmt
    o.defer_pos = realloc(o.defer_pos as *u8, (cap as i64) * 4) as *i32
    o.defer_ret = realloc(o.defer_ret as *u8, (cap as i64) * 4) as *i32
    o.defer_cap = cap

# Emit deferred statement `j` here.  Its statements are a block of their
# own, so a `defer` inside it belongs to it.  The value the enclosing block
# was producing (an `if` arm's) still stands afterwards.
fn own_run_defer(s: *EmitterState, j: i32)
    let o: *OwnState = s.own
    let ds: **Stmt = o.defer_stmts
    let d: *Stmt = ds[j]
    let rets: *i32 = o.defer_ret
    let ret_type: i32 = rets[j]
    let saved: i32 = last_expr_here(s)
    let saved_src: *Expr = s.value_source
    let saved_ctx: *u8 = s.ctx_enum_name
    let saved_ctx_len: i32 = s.ctx_enum_name_len
    let saved_defer: *Stmt = o.cur_defer
    own_push_scope(s)
    var st: *Stmt = d.while_body
    while st != null
        o.cur_defer = d
        emit_stmt(s, st, ret_type)
        st = st.next
    o.cur_defer = d
    own_pop_scope(s)
    o.cur_defer = saved_defer
    s.value_source = saved_src
    s.ctx_enum_name = saved_ctx
    s.ctx_enum_name_len = saved_ctx_len
    if saved != 0
        set_last_expr(s, saved)

# Leave the blocks holding live[from..] and defers[dfrom..]: each binding's
# drop and each deferred statement, in reverse order of where they appear.
# A deferred statement reached after binding i (defer_pos > i) runs first.
fn own_unwind(s: *EmitterState, from: i32, dfrom: i32)
    let o: *OwnState = s.own
    if o.defer_count <= dfrom
        own_drop_from(s, from)
        return
    var i: i32 = o.live_count - 1
    var j: i32 = o.defer_count - 1
    while i >= from or j >= dfrom
        var run: i32 = 0
        if j >= dfrom
            if i < from
                run = 1
            else
                let pos: *i32 = o.defer_pos
                if pos[j] > i
                    run = 1
        if run == 1
            own_run_defer(s, j)
            j -= 1
        else
            own_emit_drop(s, own_live_at(o, i))
            i -= 1

# Called by emit_str as a `ret` starts while a `defer` is registered: every
# block is being left, so run them all, innermost first, with the drops
# they interleave with (own_end_fn's drops then find those flags clear).
# What follows a `ret` is unreachable from it, so the moves don't stay.
# The live temporaries (the `return` / `?` / tail expression's) drop first,
# as ritz0 drops the statement's temp frames before its defers (AGAST #2810,
# §13.6 then §13.7); their flags clear, so the `ret`'s drops skip them.
pub fn own_before_ret(s: *EmitterState)
    let o: *OwnState = s.own
    if o.in_ret == 1 or o.defer_count == 0
        return
    if own_scope_is_dead(o) == 1
        return
    o.in_ret = 1
    var t: i32 = o.temp_count - 1
    while t >= 0
        own_emit_drop(s, own_temp_at(o, t))
        t -= 1
    let snap: *i32 = own_snapshot(s)
    own_unwind(s, 0, 0)
    own_restore(s, snap)
    if snap != null
        free(snap as *u8)
    o.in_ret = 0

fn own_defer_error(s: *EmitterState, d: *Stmt, msg: *u8)
    own_eprint_loc(d.span.line, d.span.col)
    eprints_cstr(c": error: ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# What would leave a deferred statement: 0 nothing, 1 `return`, 2 `?`,
# 3 `break`, 4 `continue`.  `loops` counts the loops entered inside it, which
# own their `break` / `continue`.  A nested `defer` is judged when reached.
const DEFER_OK: i32 = 0
const DEFER_RETURN: i32 = 1
const DEFER_TRY: i32 = 2
const DEFER_BREAK: i32 = 3
const DEFER_CONTINUE: i32 = 4

fn own_defer_leaves_arms(arms: *MatchArm, loops: i32) -> i32
    var arm: *MatchArm = arms
    while arm != null
        var r: i32 = own_defer_leaves_stmts(arm.body_stmts, loops)
        if r == DEFER_OK
            r = own_defer_leaves_expr(arm.body, loops)
        if r != DEFER_OK
            return r
        arm = arm.next
    DEFER_OK

fn own_defer_leaves_list(e: *Expr, loops: i32) -> i32
    var a: *Expr = e
    while a != null
        let r: i32 = own_defer_leaves_expr(a, loops)
        if r != DEFER_OK
            return r
        a = a.next
    DEFER_OK

# The kinds own_walk visits, plus a match / if expression's arms.
fn own_defer_leaves_expr(e: *Expr, loops: i32) -> i32
    if e == null
        return DEFER_OK
    let k: i32 = e.kind
    if k == EXPR_TRY
        return DEFER_TRY
    if k == EXPR_UNARY
        return own_defer_leaves_expr(e.operand, loops)
    if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        let r: i32 = own_defer_leaves_expr(e.left, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_expr(e.right, loops)
    if k == EXPR_MEMBER or k == EXPR_CAST
        return own_defer_leaves_expr(e.left, loops)
    if k == EXPR_CALL or k == EXPR_ARRAY_LIT
        return own_defer_leaves_list(e.args, loops)
    if k == EXPR_METHOD
        let r: i32 = own_defer_leaves_expr(e.left, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_list(e.args, loops)
    if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            let r: i32 = own_defer_leaves_expr(fi.value, loops)
            if r != DEFER_OK
                return r
            fi = fi.next
        return DEFER_OK
    if k == EXPR_MATCH or k == EXPR_IF
        let r: i32 = own_defer_leaves_expr(e.left, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_arms(e.args as *MatchArm, loops)
    DEFER_OK

fn own_defer_leaves_stmt(st: *Stmt, loops: i32) -> i32
    let k: i32 = st.kind
    if k == STMT_RETURN
        return DEFER_RETURN
    if k == STMT_BREAK
        if loops == 0
            return DEFER_BREAK
        return DEFER_OK
    if k == STMT_CONTINUE
        if loops == 0
            return DEFER_CONTINUE
        return DEFER_OK
    if k == STMT_EXPR
        return own_defer_leaves_expr(st.expr, loops)
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        return own_defer_leaves_expr(st.var_init, loops)
    if k == STMT_IF
        var r: i32 = own_defer_leaves_expr(st.if_cond, loops)
        if r == DEFER_OK
            r = own_defer_leaves_stmts(st.if_then, loops)
        if r == DEFER_OK
            r = own_defer_leaves_stmts(st.if_else, loops)
        return r
    if k == STMT_ASSERT
        return own_defer_leaves_expr(st.if_cond, loops)
    if k == STMT_WHILE
        let r: i32 = own_defer_leaves_expr(st.while_cond, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_stmts(st.while_body, loops + 1)
    if k == STMT_LOOP
        return own_defer_leaves_stmts(st.while_body, loops + 1)
    if k == STMT_FOR
        var r: i32 = own_defer_leaves_expr(st.for_start, loops)
        if r == DEFER_OK
            r = own_defer_leaves_expr(st.for_end, loops)
        if r == DEFER_OK
            r = own_defer_leaves_stmts(st.for_body, loops + 1)
        return r
    if k == STMT_MATCH
        let r: i32 = own_defer_leaves_expr(st.if_cond as *Expr, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_arms(st.if_then as *MatchArm, loops)
    if k == STMT_ASSIGN
        if st.assign_target_len == 0
            let r: i32 = own_defer_leaves_expr(st.if_cond as *Expr, loops)
            if r != DEFER_OK
                return r
        return own_defer_leaves_expr(st.assign_value, loops)
    if k == STMT_MEMBER_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN
        return own_defer_leaves_expr(st.assign_value, loops)
    if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        let r: i32 = own_defer_leaves_expr(st.while_cond, loops)
        if r != DEFER_OK
            return r
        return own_defer_leaves_expr(st.assign_value, loops)
    DEFER_OK

fn own_defer_leaves_stmts(list: *Stmt, loops: i32) -> i32
    var st: *Stmt = list
    while st != null
        let r: i32 = own_defer_leaves_stmt(st, loops)
        if r != DEFER_OK
            return r
        st = st.next
    DEFER_OK

# The error a `defer` can't be registered with, reported at the `defer`;
# 1 if there was one.
fn own_defer_refusal(s: *EmitterState, d: *Stmt) -> i32
    let body: *Stmt = d.while_body
    if body == null
        own_defer_error(s, d, c"`defer` needs a statement")
        return 1
    if d.defer_is_block == 0 and (body.kind == STMT_VAR_DECL or body.kind == STMT_TUPLE_DECL)
        own_defer_error(s, d, c"a deferred `let` or `var` would die at once")
        return 1
    let r: i32 = own_defer_leaves_stmts(body, 0)
    if r == DEFER_RETURN
        own_defer_error(s, d, c"`return` can't leave a deferred statement")
    else if r == DEFER_TRY
        own_defer_error(s, d, c"`?` can't leave a deferred statement")
    else if r == DEFER_BREAK
        own_defer_error(s, d, c"`break` can't leave a deferred statement")
    else if r == DEFER_CONTINUE
        own_defer_error(s, d, c"`continue` can't leave a deferred statement")
    if r != DEFER_OK
        return 1
    0

# A STMT_DEFER is reached: register it with the innermost block.
pub fn own_defer(s: *EmitterState, d: *Stmt, ret_type: i32)
    let o: *OwnState = s.own
    if own_defer_refusal(s, d) == 1
        return
    if own_scope_is_dead(o) == 1
        return
    own_grow_defers(o)
    let ds: **Stmt = o.defer_stmts
    let pos: *i32 = o.defer_pos
    let rets: *i32 = o.defer_ret
    ds[o.defer_count] = d
    pos[o.defer_count] = o.live_count
    rets[o.defer_count] = ret_type
    o.defer_count = o.defer_count + 1
    s.defer_live = o.defer_count
