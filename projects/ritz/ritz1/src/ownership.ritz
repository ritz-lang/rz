# ownership.ritz - drop insertion (AGAST #2158, #1854)
#
# LANGUAGE_SPEC §13.  A type is MOVE-ONLY iff it implements Drop, or a
# field or generic argument of it is move-only (checked transitively).
# Every other type copies, and nothing here ever touches it.
#
# The move check (a use of a moved value, a move out of a reference, and
# the rest of §13's refusals) runs on Sema, before emission: own_check.ritz
# (AGAST #3507, #1816).  A program that reaches the emitter passed it.  What
# stays here is lowering: which bindings own a value (Sema's annotation,
# FnDef.own_binds), the flags a move clears, and the drops.
#
# Drops.  Each owned binding gets an `i1` drop flag (an alloca, written into
# the fn's entry-block buffer and zeroed there).  Declaring the binding with a value, or
# assigning to it, sets the flag; moving it clears it (own_walk, as each
# statement is emitted).  A drop is `if flag { flag = 0; glue(binding) }`,
# so a binding moved on only some paths is dropped exactly on the others.
# Drops are emitted
#   - at the end of each block, for the bindings it declared (reverse order);
#   - on `break` / `continue`, for the bindings of the loop body;
#   - on assignment, for the old value (copied aside first, so the new value
#     may still read it); and on assignment to a field, for the field's old
#     value (AGAST #2173, see own_field_drop_cond);
#   - before every `ret` of the fn, for the bindings and temporaries live
#     there, newest first (own_before_ret, which the IR sink calls as a `ret`
#     starts, because ritz1 emits `ret` from dozens of sites; AGAST #3508).
#     Which locals own a value is Sema's annotation (FnDef.own_binds), so
#     the drops are known where the `ret` is emitted: nothing rescans the
#     finished body.
# Glue: a type's own `drop` (if it has one) runs first, then each move-only
# field is dropped in declaration order.  An array drops its elements in
# index order; an enum (a user enum, or a tagged Option / Result) drops the
# payload of the variant its tag names (AGAST #2165).
#
# Temporaries (AGAST #2165).  A call whose by-value move-only result nobody
# owns -- an expression statement `make(1)`, `make(1).id`, an argument lent
# to an `@T` parameter -- is marked by own_walk; emit_expr spills its value
# with a drop flag, and the temporary drops at the end of its statement, or
# of the `if` / `while` condition it is in.  A `return`'s temporaries drop
# before the `ret`, with the fn's bindings.
#
# Fields (AGAST #2168, #2242).  Moving a move-only field out of a binding
# (`return h.t`, `var u = h.t`, `consume(h.a.t)`) moves that path only, as in
# Rust: the binding's `fmask` bit for it is set at run time, so the binding's
# drop skips it.  Assigning a path (`h.a.t = v`) makes it and its parts owned
# again.  A temporary whose move-only field is moved out isn't dropped
# (ritz0's rule: no partial drops of a temporary).  A drop can come before a
# move that reaches it round a loop, so each binding numbers every path its
# type has up front (OwnBinding's `paths`), and the glue tests them all.
# Every path is tracked, with no cap (AGAST #2319): a set of paths is an i32
# that is the bitmask itself for paths 0..30 and a handle to an interned word
# array otherwise (see "Path sets", which own_check.ritz shares), and the
# run-time mask is an integer of as many 32-bit words as the paths need.
#
# Match scrutinees (AGAST #2174).  A match (statement or expression) moves
# its scrutinee and owns it; a payload binding (`Full(t)`) owns the payload
# for its arm (see own_match_begin).  ritz0 follows the same rule (AGAST
# #2177, move_checker.py _own_payload).
#
# A fn without move-only bindings, in a module without `impl Drop`, emits
# nothing extra.
#
# The IR is written in ritz1/ARCHITECTURE.md's "Emitter style": a whole
# instruction per `format_into(s, "...")`, text as StrViews.
#
# Tests: ritz0/test_ownership_free_count.py (shared with ritz0) and
# ritz0/test_ritz1_ownership.py.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.hashmap   # HashMapI64 (own_move_only_in)
import ritzlib.memory
import ritzlib.string    # own_set_const's text
import ritzlib.strview

import ast
import ast_helpers
import emitter_core
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import ref_check           # ref_ty_of, ref_through, ref_method_def, ref_temp_call
import text_bridge         # no_name, named_by, tagged_payload (AGAST #4696)
import ritzlib.str

const OWN_INIT_CAP: i32 = 16
# Deeper than any real struct nesting; stops a malformed recursive type.
const OWN_MAX_DEPTH: i32 = 32
# Bits 0..30 of an i32, the paths a set held inline can have.
const OWN_ALL_PATHS: i32 = 0x7FFFFFFF

# `count` values of the struct `name` side by side (an `[N]T` of it, or a
# lone value when count is 0).  `name` is empty when there is none.
pub struct StructElems
    name: StrView
    count: i32

fn no_elems() -> StructElems
    StructElems { name: no_name(), count: 0 }

# =============================================================================
# Path sets (AGAST #2319)
# =============================================================================
#
# A set of path numbers, with no cap.  It is an i32, so it lives wherever the
# i32 bitmasks it replaced did (OwnPath's up and down here; own_check.ritz's
# moved and shadowed fields, its snapshots and loop events) and is copied with
# them.  A set
# of paths 0..30 only is that bitmask (>= 0, as before); any other is -(k+1)
# for entry k of a pool of interned word arrays (32 paths a word, bit i of
# word w for path 32w + i).  Interning keeps one value per set, so `==`
# compares sets and 0 is the empty one.  Only a binding with more than 31
# paths reaches the pool, so other code pays nothing for it.  Sets are never
# freed: a fn's sets are few, and the pool is shared by all of them.

enum SetOp
    Or
    And
    Minus

var g_os_words: *i32 = null    # the entries' words, back to back
var g_os_wlen: i32 = 0
var g_os_wcap: i32 = 0
var g_os_off: *i32 = null      # entry k's first word in g_os_words
var g_os_len: *i32 = null      # and its word count (its top word isn't 0)
var g_os_count: i32 = 0
var g_os_cap: i32 = 0
var g_os_tab: *i32 = null      # open addressing: k + 1 per entry, 0 if free
var g_os_tcap: i32 = 0
var g_os_buf: *i32 = null      # scratch words for the set being built
var g_os_bcap: i32 = 0

# `p` with room for `n` i32s (p may be null).
fn os_grow(p: *i32, n: i32) -> *i32
    if p == null
        return malloc((n as i64) * 4) as *i32
    realloc(p as *u8, (n as i64) * 4) as *i32

# The number of words of set `a` (0 for the empty set).
fn os_len(a: i32) -> i32
    if a > 0
        return 1
    if a == 0
        return 0
    let lens: *i32 = g_os_len
    lens[0 - a - 1]

# Word `i` of set `a`, 0 past its end.
fn os_word(a: i32, i: i32) -> i32
    if a >= 0
        if i == 0
            return a
        return 0
    let k: i32 = 0 - a - 1
    let lens: *i32 = g_os_len
    if i >= lens[k]
        return 0
    let offs: *i32 = g_os_off
    let words: *i32 = g_os_words
    words[offs[k] + i]

# `n` zeroed scratch words.
fn os_scratch(n: i32) -> *i32
    if n > g_os_bcap
        var cap: i32 = 8
        while cap < n
            cap = cap * 2
        g_os_buf = os_grow(g_os_buf, cap)
        g_os_bcap = cap
    let buf: *i32 = g_os_buf
    var i: i32 = 0
    while i < n
        buf[i] = 0
        i += 1
    buf

fn os_hash(w: *i32, n: i32) -> i32
    var h: i64 = n as i64
    var i: i32 = 0
    while i < n
        h = (h * 1000003 + (w[i] as i64)) & 0x7FFFFFFF
        i += 1
    h as i32

# True when entry k holds the words w[0..n).
fn os_same(k: i32, w: *i32, n: i32) -> bool
    let lens: *i32 = g_os_len
    if lens[k] != n
        return false
    let offs: *i32 = g_os_off
    let words: *i32 = g_os_words
    let base: i32 = offs[k]
    var i: i32 = 0
    while i < n
        if words[base + i] != w[i]
            return false
        i += 1
    true

# Put entry k in the hash table.
fn os_slot_in(k: i32)
    let offs: *i32 = g_os_off
    let lens: *i32 = g_os_len
    let words: *i32 = g_os_words
    let tab: *i32 = g_os_tab
    let mask: i32 = g_os_tcap - 1
    var at: i32 = os_hash(words + offs[k], lens[k]) & mask
    while tab[at] != 0
        at = (at + 1) & mask
    tab[at] = k + 1

# Double the hash table (64 slots at first) and re-slot every entry.
fn os_rehash()
    var cap: i32 = g_os_tcap * 2
    if cap < 64
        cap = 64
    if g_os_tab != null
        free(g_os_tab as *u8)
    g_os_tab = malloc((cap as i64) * 4) as *i32
    g_os_tcap = cap
    let tab: *i32 = g_os_tab
    var i: i32 = 0
    while i < cap
        tab[i] = 0
        i += 1
    var k: i32 = 0
    while k < g_os_count
        os_slot_in(k)
        k += 1

# The set whose words are buf[0..n): the bitmask when it fits, else the
# pool's entry for it (added if new).
fn os_make(buf: *i32, n: i32) -> i32
    var len: i32 = n
    while len > 0 and buf[len - 1] == 0
        len -= 1
    if len == 0
        return 0
    if len == 1 and buf[0] > 0
        return buf[0]
    if (g_os_count + 1) * 2 > g_os_tcap
        os_rehash()
    let tab: *i32 = g_os_tab
    let mask: i32 = g_os_tcap - 1
    var at: i32 = os_hash(buf, len) & mask
    while tab[at] != 0
        let k: i32 = tab[at] - 1
        if os_same(k, buf, len)
            return 0 - k - 1
        at = (at + 1) & mask
    if g_os_count >= g_os_cap
        var cap: i32 = g_os_cap * 2
        if cap < 16
            cap = 16
        g_os_off = os_grow(g_os_off, cap)
        g_os_len = os_grow(g_os_len, cap)
        g_os_cap = cap
    if g_os_wlen + len > g_os_wcap
        var wcap: i32 = g_os_wcap * 2
        if wcap < 64
            wcap = 64
        while wcap < g_os_wlen + len
            wcap = wcap * 2
        g_os_words = os_grow(g_os_words, wcap)
        g_os_wcap = wcap
    let k: i32 = g_os_count
    let offs: *i32 = g_os_off
    let lens: *i32 = g_os_len
    let words: *i32 = g_os_words
    offs[k] = g_os_wlen
    lens[k] = len
    var i: i32 = 0
    while i < len
        words[g_os_wlen + i] = buf[i]
        i += 1
    g_os_wlen = g_os_wlen + len
    g_os_count = k + 1
    tab[at] = k + 1
    0 - k - 1

# One word of `a op b`.
fn os_word_op(wa: i32, wb: i32, op: SetOp) -> i32
    match op
        SetOp.Or => wa | wb
        SetOp.And => wa & wb
        SetOp.Minus => wa & (wb ^ (0 - 1))

# `a | b`, `a & b` or `a & ~b`.
fn os_op(a: i32, b: i32, op: SetOp) -> i32
    if a >= 0 and b >= 0
        # Both inline: `a` has no bit 31, so neither has `a & ~b`.
        return os_word_op(a, b, op)
    var n: i32 = os_len(a)
    let nb: i32 = os_len(b)
    if op == SetOp.Or and nb > n
        n = nb
    if op == SetOp.And and nb < n
        n = nb
    let buf: *i32 = os_scratch(n)
    var i: i32 = 0
    while i < n
        buf[i] = os_word_op(os_word(a, i), os_word(b, i), op)
        i += 1
    os_make(buf, n)

pub fn own_set_or(a: i32, b: i32) -> i32
    os_op(a, b, SetOp.Or)

pub fn own_set_and(a: i32, b: i32) -> i32
    os_op(a, b, SetOp.And)

# The paths of `a` that aren't in `b`.
pub fn own_set_minus(a: i32, b: i32) -> i32
    os_op(a, b, SetOp.Minus)

# {path}.
pub fn own_set_bit(path: i32) -> i32
    if path < 31
        return 1 << path
    let buf: *i32 = os_scratch(path / 32 + 1)
    buf[path / 32] = 1 << (path % 32)
    os_make(buf, path / 32 + 1)

# {0 .. n-1}.
pub fn own_set_range(n: i32) -> i32
    if n <= 0
        return 0
    if n < 32
        return (OWN_ALL_PATHS >> (31 - n))
    let words: i32 = (n + 31) / 32
    let buf: *i32 = os_scratch(words)
    var i: i32 = 0
    while i < n / 32
        buf[i] = 0 - 1
        i += 1
    if n % 32 != 0
        buf[n / 32] = (1 << (n % 32)) - 1
    os_make(buf, words)

# 1 when `path` is in `a`.  An i32, as the rest of the set API is: own_check
# tests it with the sets it keeps.
pub fn own_set_has(a: i32, path: i32) -> i32
    if (os_word(a, path / 32) & (1 << (path % 32))) != 0
        return 1
    0

# One past the highest path `a` can hold.
pub fn own_set_top(a: i32) -> i32
    os_len(a) * 32

pub fn own_init(s: *EmitterState)
    let o: *OwnState = malloc(sizeof(OwnState)) as *OwnState
    o.live = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_count = 0
    o.live_cap = OWN_INIT_CAP
    o.scope_start = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_dead = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.scope_count = 0
    o.scope_cap = OWN_INIT_CAP
    o.seq_next = 0
    o.loop_base = -1
    o.loop_tbase = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.loop_tcap = OWN_INIT_CAP
    o.ret_seq = 0
    o.has_drop = 0 - 1
    o.temp_exprs = malloc((OWN_INIT_CAP as i64) * 8) as **Expr
    o.temp_expr_count = 0
    o.temp_expr_cap = OWN_INIT_CAP
    o.temp_last_reg = 0
    o.temp_last_slot = 0
    o.temps = malloc((OWN_INIT_CAP as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.temp_count = 0
    o.temp_cap = OWN_INIT_CAP
    o.stmt_mark = 0
    o.loop_depth = 0
    o.match_scrut = 0 - 1
    o.fa_cond = 0
    o.fa_path = 0 - 1
    o.fa_mask = 0
    o.defer_stmts = malloc((OWN_INIT_CAP as i64) * 8) as **Stmt
    o.defer_pos = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.defer_tpos = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.defer_ret = malloc((OWN_INIT_CAP as i64) * sizeof(TypeKind)) as *TypeKind
    o.defer_count = 0
    o.defer_cap = OWN_INIT_CAP
    o.scope_dstart = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.loop_dstart = malloc((OWN_INIT_CAP as i64) * 4) as *i32
    o.loop_dcap = OWN_INIT_CAP
    o.in_ret = 0
    s.own = o

fn own_live_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.live
    return @base[i]

fn own_copy_binding(dst: *OwnBinding, src: *OwnBinding)
    memcpy(dst as *u8, src as *u8, sizeof(OwnBinding))

fn own_temp_at(o: *OwnState, i: i32) -> *OwnBinding
    let base: *OwnBinding = o.temps
    return @base[i]

# The struct type a binding holds (its elements' type, for an array).
fn own_binding_type(b: *OwnBinding) -> StrView
    StrView { ptr: b.type_name, len: b.type_name_len as i64 }

# A struct field's type name.
fn own_field_type(f: *StructField) -> StrView
    StrView { ptr: f.field_type_name, len: f.field_type_name_len as i64 }

# An expression's identifier (a name, a member's field, a method's name).
fn own_ident(e: *Expr) -> StrView
    StrView { ptr: e.ident_ptr, len: e.ident_len as i64 }

# =============================================================================
# Move-only types
# =============================================================================
#
# The predicates here that end in `_in` (and own_base_len) are Sema's too:
# own_check.ritz and ref_value.ritz ask them with Sema's struct map (AGAST
# #4011), and test their i32 results with i32 predicates of their own.  The
# emitter's wrappers read them as bools.

# Length of `name` up to its first `$` (a monomorph's base name).
pub fn own_base_len(name: StrView) -> i32
    name.find_byte('$') as i32

# True for an `impl Drop for ..` block.
fn own_impl_is_drop(ib: *ImplBlock) -> bool
    if ib.trait_name == null
        return false
    let tr: StrView = StrView { ptr: ib.trait_name, len: ib.trait_name_len as i64 }
    tr.eq("Drop")

# True when the type itself has an `impl Drop`.
fn own_has_drop_impl(s: *EmitterState, name: StrView) -> bool
    own_has_drop_impl_in(s.module, name) == 1

pub fn own_has_drop_impl_in(m: *Module, name: StrView) -> i32
    let base: StrView = name.take(own_base_len(name) as i64)
    var ib: *ImplBlock = m.impls
    while ib != null
        let ty: StrView = StrView { ptr: ib.type_name, len: ib.type_name_len as i64 }
        if own_impl_is_drop(ib) and ty.eq(base)
            return 1
        ib = ib.next
    0

fn own_move_only_depth(s: *EmitterState, name: StrView, depth: i32) -> bool
    own_move_only_in(s.mono.pctx, s.module, @s.struct_map, name, depth) == 1

# own_move_only_depth over `m` and a struct map of its (struct_map_find): the
# emitter's, or Sema's (AGAST #4011).
fn own_move_only_in(ctx: *ParseCtx, m: *Module, map: *HashMapI64, name: StrView, depth: i32) -> i32
    if name.ptr == null or name.len <= 0 or depth > OWN_MAX_DEPTH
        return 0
    if own_has_drop_impl_in(m, name) == 1
        return 1
    # Generic arguments: `Vec$Tracked`, `Pair$i32$Tracked`.
    var i: i64 = own_base_len(name) as i64
    while i < name.len
        let rest: StrView = name.skip(i + 1)
        let arg: StrView = rest.take(rest.find_byte('$'))
        if arg.len > 0 and own_move_only_in(ctx, m, map, arg, depth + 1) == 1
            return 1
        i = i + 1 + arg.len
    let st: *StructDef = struct_map_find(map, m, name)
    if st == null
        # A user enum is move-only when a variant's payload is (AGAST #2165).
        let ei: i32 = user_enum_index(ctx, name)
        if ei < 0
            return 0
        var vi: i32 = 0
        while vi < enum_variant_count(ctx, ei)
            if own_fields_move_only_in(ctx, m, map, enum_variant_fields(ctx, ei, vi), depth + 1) == 1
                return 1
            vi += 1
        return 0
    own_fields_move_only_in(ctx, m, map, st.fields, depth + 1)

# The leaf elements of an N-D array shape, when they are structs: their
# type and total count.
pub fn own_shape_elems(sh: *ArrayShape) -> StructElems
    if sh.leaf_type != TypeKind.Struct or sh.leaf_name_len <= 0
        return no_elems()
    var n: i32 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * sh.dims[d]
        d += 1
    StructElems { name: StrView { ptr: sh.leaf_name, len: sh.leaf_name_len as i64 }, count: n }

# An array field of struct elements: the element type and count (every leaf
# of an N-D array).
fn own_field_array(f: *StructField) -> StructElems
    if f.field_type != TypeKind.Array
        return no_elems()
    if f.array_shape != null
        return own_shape_elems(f.array_shape)
    if f.array_elem_type != TypeKind.Struct or f.array_size <= 0
        return no_elems()
    let elem: StrView = StrView { ptr: f.array_elem_type_name, len: f.array_elem_type_name_len as i64 }
    StructElems { name: elem, count: f.array_size }

# True when field `f` (of a struct or an enum payload) holds a move-only value.
fn own_field_move_only(s: *EmitterState, f: *StructField, depth: i32) -> bool
    own_field_move_only_in(s.mono.pctx, s.module, @s.struct_map, f, depth) == 1

pub fn own_field_move_only_in(ctx: *ParseCtx, m: *Module, map: *HashMapI64, f: *StructField, depth: i32) -> i32
    if f.field_type == TypeKind.Struct
        return own_move_only_in(ctx, m, map, own_field_type(f), depth)
    # Not an array of structs: an empty name, which is no move-only type.
    let arr: StructElems = own_field_array(f)
    own_move_only_in(ctx, m, map, arr.name, depth)

fn own_fields_move_only(s: *EmitterState, fields: *StructField, depth: i32) -> bool
    own_fields_move_only_in(s.mono.pctx, s.module, @s.struct_map, fields, depth) == 1

pub fn own_fields_move_only_in(ctx: *ParseCtx, m: *Module, map: *HashMapI64, fields: *StructField, depth: i32) -> i32
    var f: *StructField = fields
    while f != null
        if own_field_move_only_in(ctx, m, map, f, depth) == 1
            return 1
        f = f.next
    0

# True when the module has an `impl Drop` at all; without one nothing is
# move-only, and the hooks skip their work.  OwnState.has_drop caches it
# (-1 until known).
fn own_any_drop(s: *EmitterState) -> bool
    let o: *OwnState = s.own
    if o.has_drop < 0
        o.has_drop = 0
        var ib: *ImplBlock = s.module.impls
        while ib != null and o.has_drop == 0
            if own_impl_is_drop(ib)
                o.has_drop = 1
            ib = ib.next
    o.has_drop == 1

pub fn own_type_is_move_only(s: *EmitterState, name: StrView) -> bool
    own_any_drop(s) and own_move_only_depth(s, name, 0)

# own_type_is_move_only over `m` and a struct map of its: Sema's (AGAST #4011).
pub fn own_type_is_move_only_in(ctx: *ParseCtx, m: *Module, map: *HashMapI64, name: StrView) -> i32
    var ib: *ImplBlock = m.impls
    while ib != null
        if own_impl_is_drop(ib)
            return own_move_only_in(ctx, m, map, name, 0)
        ib = ib.next
    0

# =============================================================================
# Drop glue
# =============================================================================

# `call void @<T's drop>(ptr %ptr)` if T has its own drop.
fn own_emit_own_drop(s: *EmitterState, ptr: i32, name: StrView)
    if not own_has_drop_impl(s, name)
        return
    if own_base_len(name) < name.len as i32
        # A generic impl: monomorph specialised its methods as `Box$i32_drop`.
        let fd: *FnDef = find_spec_impl_method(s, name, "drop")
        if fd == null
            return
        let callee: StrView = StrView { ptr: fd.name, len: fd.name_len as i64 }
        let callee_ir: String = ir_name(callee)
        format_into(s, "  call void @{callee_ir.as_view()}(ptr %.{ptr})\n")
        add_extern(s, callee)
        return
    let ty_ir: String = ir_name(name)
    format_into(s, "  call void @{ty_ir.as_view()}_drop(ptr %.{ptr})\n")
    add_method_extern(s, name, "drop")

# A pointer to field `idx` of the struct `st` at `ptr`.
fn own_field_gep(s: *EmitterState, ptr: i32, st: *StructDef, idx: i32) -> i32
    let r: i32 = next_reg(s)
    gep_struct_open(s, r, StrView { ptr: st.name, len: st.name_len as i64 })
    format_into(s, ", ptr %.{ptr}, i32 0, i32 {idx}\n")
    r

# `br i1 %cond` to a new block, which is opened; returns the label own_if_close
# closes it with, the one the false edge goes to.
fn own_if_open(s: *EmitterState, cond: i32) -> i32
    let do_label: i32 = next_label(s)
    let next: i32 = next_label(s)
    format_into(s, "  br i1 %.{cond}, label %L{do_label}, label %L{next}\n")
    begin_block(s, do_label)
    next

fn own_if_close(s: *EmitterState, next: i32)
    format_into(s, "  br label %L{next}\n")
    begin_block(s, next)

# Drop the value of type `name` at `ptr`: its own drop, then its move-only
# struct fields in declaration order, or an enum's payload.
fn own_emit_glue(s: *EmitterState, ptr: i32, name: StrView, depth: i32)
    if depth > OWN_MAX_DEPTH
        return
    own_emit_own_drop(s, ptr, name)
    if is_tagged_enum_type(name) == 1
        own_emit_tagged_glue(s, ptr, name, depth)
        return
    let st: *StructDef = find_struct(s, name)
    if st == null
        let ei: i32 = user_enum_index(s.mono.pctx, name)
        if ei >= 0
            own_emit_enum_glue(s, ptr, name, ei, depth)
        return
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0)
            own_emit_field_glue(s, own_field_gep(s, ptr, st, idx), f, depth + 1)
        idx += 1
        f = f.next

# Drop the move-only field `f` stored at `ptr`.
fn own_emit_field_glue(s: *EmitterState, ptr: i32, f: *StructField, depth: i32)
    if f.field_type == TypeKind.Struct
        own_emit_glue(s, ptr, own_field_type(f), depth)
        return
    let arr: StructElems = own_field_array(f)
    if not arr.name.is_empty()
        own_emit_array_glue(s, ptr, arr.count, arr.name, depth)

# AGAST #2168, #2242: drop the binding's value at `ptr`, or with `path` >= 0
# that path's value (no drop of its own either way), except the paths whose
# bit is set in the mask register `mask`: each move-only field in declaration
# order if it isn't moved out, a field with parts of its own part by part.
fn own_emit_masked_glue(s: *EmitterState, ptr: i32, b: *OwnBinding, path: i32, mask: i32)
    var name: StrView = own_binding_type(b)
    if path >= 0
        name = own_field_type(own_path_at(b, path).fld)
    let st: *StructDef = find_struct(s, name)
    if st == null
        return
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0)
            let part: i32 = own_child_path(b, path, idx)
            var next: i32 = 0 - 1
            if part >= 0
                next = own_if_open(s, own_bits_clear(s, b, mask, own_set_bit(part)))
            let fp: i32 = own_field_gep(s, ptr, st, idx)
            if part >= 0 and own_has_parts(b, part)
                own_emit_masked_glue(s, fp, b, part, mask)
            else
                own_emit_field_glue(s, fp, f, 1)
            if next >= 0
                own_if_close(s, next)
        idx += 1
        f = f.next

# The binding's value at `ptr`, with its moved-out paths per the mask
# register `mask` (0: none can be).
fn own_emit_binding_glue(s: *EmitterState, b: *OwnBinding, ptr: i32, mask: i32)
    if mask != 0
        own_emit_masked_glue(s, ptr, b, 0 - 1, mask)
    else
        own_emit_value_glue(s, ptr, own_binding_type(b), b.count)

# AGAST #2319: the run-time mask is an integer of whole 32-bit words, one
# bit per path (an i32 up to 32 paths, an i64 up to 64, ...): its width.
fn own_mask_width(b: *OwnBinding) -> i32
    var words: i32 = (b.path_count + 31) / 32
    if words < 1
        words = 1
    words * 32

# The path set `a` as a constant of the binding's mask type, or with `inv`
# its complement: in decimal for an i32, else in hex (`u0x` + every word,
# the top one first), which LLVM reads at any width.
fn own_set_const(b: *OwnBinding, a: i32, inv: bool) -> String
    let words: i32 = own_mask_width(b) / 32
    var out: String = string_new()
    if words == 1
        var w: i32 = os_word(a, 0)
        if inv
            w = w ^ (0 - 1)
        format_into(@&out, "{w}")
        return out
    let digits: StrView = "0123456789abcdef"
    out.push_str("u0x")
    var i: i32 = words - 1
    while i >= 0
        var w: i32 = os_word(a, i)
        if inv
            w = w ^ (0 - 1)
        var k: i32 = 7
        while k >= 0
            out.push(digits.get(((w >> (k * 4)) & 15) as i64))
            k -= 1
        i -= 1
    out

# The i1 "none of the path set `bits` is set in the mask register `mask`".
fn own_bits_clear(s: *EmitterState, b: *OwnBinding, mask: i32, bits: i32) -> i32
    let width: i32 = own_mask_width(b)
    let t: i32 = next_reg(s)
    let bits_ir: String = own_set_const(b, bits, false)
    format_into(s, "  %.{t} = and i{width} %.{mask}, {bits_ir.as_view()}\n")
    let c: i32 = next_reg(s)
    format_into(s, "  %.{c} = icmp eq i{width} %.{t}, 0\n")
    c

# Load the binding's moved-path mask (0 when it has none).
fn own_load_mask(s: *EmitterState, b: *OwnBinding) -> i32
    if b.fmask == 0
        return 0
    let m: i32 = next_reg(s)
    format_into(s, "  %.{m} = load i{own_mask_width(b)}, ptr %.{b.fmask}\n")
    m

# Set (`set`) or clear the run-time moved bits of the path set `bits`.
fn own_emit_mask_bits(s: *EmitterState, b: *OwnBinding, bits: i32, set: bool)
    if b.fmask == 0 or bits == 0
        return
    let m: i32 = own_load_mask(s, b)
    let r: i32 = next_reg(s)
    let width: i32 = own_mask_width(b)
    let op: StrView = if set then "or" else "and"
    let bits_ir: String = own_set_const(b, bits, not set)
    format_into(s, "  %.{r} = {op} i{width} %.{m}, {bits_ir.as_view()}\n")
    format_into(s, "  store i{width} %.{r}, ptr %.{b.fmask}\n")

# Mark no path moved out.
fn own_clear_mask(s: *EmitterState, b: *OwnBinding)
    if b.fmask == 0
        return
    format_into(s, "  store i{own_mask_width(b)} 0, ptr %.{b.fmask}\n")

# A value (count 0) or an array of `count` elements, at `ptr`.
fn own_emit_value_glue(s: *EmitterState, ptr: i32, name: StrView, count: i32)
    if count > 0
        own_emit_array_glue(s, ptr, count, name, 0)
    else
        own_emit_glue(s, ptr, name, 0)

# A static `alloca` of `ty` in the fn's entry block, with the `  ; <what>`
# comment its line carries.
fn own_entry_alloca(s: *EmitterState, ty: StrView, what: StrView) -> i32
    let r: i32 = entry_alloca_begin(s)
    format_into(s, "{ty}  ; {what}\n")
    entry_alloca_end(s)
    r

# Drop `n` elements of type `name` from `ptr` on, in index order, with a
# loop (its counter alloca is written into the entry-block buffer).
fn own_emit_array_glue(s: *EmitterState, ptr: i32, n: i32, name: StrView, depth: i32)
    if n <= 0 or depth > OWN_MAX_DEPTH
        return
    let ctr: i32 = own_entry_alloca(s, "i64", "array drop index")
    format_into(s, "  store i64 0, ptr %.{ctr}\n")
    let head: i32 = next_label(s)
    let body: i32 = next_label(s)
    let done: i32 = next_label(s)
    format_into(s, "  br label %L{head}\n")
    begin_block(s, head)
    let i: i32 = next_reg(s)
    format_into(s, "  %.{i} = load i64, ptr %.{ctr}\n")
    let more: i32 = next_reg(s)
    format_into(s, "  %.{more} = icmp slt i64 %.{i}, {n}\n")
    format_into(s, "  br i1 %.{more}, label %L{body}, label %L{done}\n")
    begin_block(s, body)
    let ep: i32 = next_reg(s)
    gep_struct_open(s, ep, name)
    format_into(s, ", ptr %.{ptr}, i64 %.{i}\n")
    own_emit_glue(s, ep, name, depth + 1)
    let nx: i32 = next_reg(s)
    format_into(s, "  %.{nx} = add i64 %.{i}, 1\n")
    format_into(s, "  store i64 %.{nx}, ptr %.{ctr}\n")
    format_into(s, "  br label %L{head}\n")
    begin_block(s, done)

# A block that drops one variant's payload (own_case_begin).
struct OwnCase
    payload: i32   # the payload's address
    next: i32      # the label own_if_close closes the block with

# `if tag == <tag> {`: branch on the tag of the enum `ename` at `ptr` and
# open the block that drops the payload, which is field 2 of every
# payload-carrying enum layout.
fn own_case_begin(s: *EmitterState, ptr: i32, ename: StrView, tag: i32) -> OwnCase
    let tp: i32 = next_reg(s)
    gep_struct_open(s, tp, ename)
    format_into(s, ", ptr %.{ptr}, i32 0, i32 0\n")
    let t: i32 = next_reg(s)
    format_into(s, "  %.{t} = load i8, ptr %.{tp}\n")
    let c: i32 = next_reg(s)
    format_into(s, "  %.{c} = icmp eq i8 %.{t}, {tag}\n")
    let next: i32 = own_if_open(s, c)
    let pp: i32 = next_reg(s)
    gep_struct_open(s, pp, ename)
    format_into(s, ", ptr %.{ptr}, i32 0, i32 2\n")
    OwnCase { payload: pp, next: next }

# Option$T / Result$T$E: tag 0 holds the Some / Ok payload, tag 1 Result's
# Err payload.
fn own_emit_tagged_glue(s: *EmitterState, ptr: i32, name: StrView, depth: i32)
    let variants: i32 = if name.len > 7 and name.starts_with("Result$") then 2 else 1
    var v: i32 = 0
    while v < variants
        let a: StrView = tagged_payload(s, name, v)
        if not a.is_empty() and own_move_only_depth(s, a, depth + 1)
            let case: OwnCase = own_case_begin(s, ptr, name, v)
            own_emit_glue(s, case.payload, a, depth + 1)
            own_if_close(s, case.next)
        v += 1

# A user enum: its tag is the variant's index; the payload's fields sit in
# the payload bytes as variant_payload_size_align lays them out.
fn own_emit_enum_glue(s: *EmitterState, ptr: i32, name: StrView, ei: i32, depth: i32)
    var vi: i32 = 0
    while vi < enum_variant_count(s.mono.pctx, ei)
        let fields: *StructField = enum_variant_fields(s.mono.pctx, ei, vi)
        if own_fields_move_only(s, fields, depth + 1)
            let case: OwnCase = own_case_begin(s, ptr, name, vi)
            var offset: i64 = 0
            var f: *StructField = fields
            while f != null
                var falign: i64 = 8
                var fsize: i64 = 8
                if f.field_type == TypeKind.Array
                    fsize = field_array_size_align(s, f, @falign)
                else
                    fsize = elem_size_align(s, f.field_type, own_field_type(f), @falign)
                if falign < 1
                    falign = 1
                let rem: i64 = offset % falign
                if rem != 0
                    offset = offset + (falign - rem)
                if own_field_move_only(s, f, depth + 1)
                    var fp: i32 = case.payload
                    if offset > 0
                        fp = next_reg(s)
                        format_into(s, "  %.{fp} = getelementptr i8, ptr %.{case.payload}, i64 {offset}\n")
                    own_emit_field_glue(s, fp, f, depth + 1)
                offset = offset + fsize
                f = f.next
            own_if_close(s, case.next)
        vi += 1

# The binding's drop flag, loaded.
fn own_load_flag(s: *EmitterState, b: *OwnBinding) -> i32
    let f: i32 = next_reg(s)
    format_into(s, "  %.{f} = load i1, ptr %.{b.flag}\n")
    f

# `if flag { flag = 0; glue(slot) }`, as basic blocks of the current fn.
fn own_emit_drop(s: *EmitterState, b: *OwnBinding)
    let saved: i32 = last_expr_here(s)
    let next: i32 = own_if_open(s, own_load_flag(s, b))
    format_into(s, "  store i1 0, ptr %.{b.flag}\n")
    own_emit_binding_glue(s, b, b.slot, own_load_mask(s, b))
    own_if_close(s, next)
    # The block's value (an `if` arm's) still dominates the new block.
    if saved != 0
        set_last_expr(s, saved)

fn own_store_flag(s: *EmitterState, b: *OwnBinding, owned: bool)
    let bit: StrView = if owned then "1" else "0"
    format_into(s, "  store i1 {bit}, ptr %.{b.flag}\n")

# =============================================================================
# Bindings and scopes
# =============================================================================

fn own_grow_live(o: *OwnState)
    if o.live_count < o.live_cap
        return
    let cap: i32 = o.live_cap * 2
    o.live = realloc(o.live as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
    o.live_cap = cap

# AGAST #3508: the next binding's / temporary's OwnBinding.seq.
fn own_next_seq(o: *OwnState) -> i32
    let q: i32 = o.seq_next
    o.seq_next = q + 1
    q

# `b` as a new nameless binding of `count` values of `ty` (0: one) at `slot`,
# with the drop flag `flag`, owning its whole value; a named one sets its
# name, and the paths it can move out, after.
fn own_init_binding(o: *OwnState, b: *OwnBinding, slot: i32, flag: i32, ty: StrView, count: i32)
    b.name = null
    b.name_len = 0
    b.local_idx = 0 - 1
    b.slot = slot
    b.flag = flag
    b.type_name = ty.ptr
    b.type_name_len = ty.len as i32
    b.moved = 0
    b.count = count
    b.paths = null
    b.path_count = 0
    b.fmask = 0
    b.aux = 0
    b.seq = own_next_seq(o)

pub fn own_push_scope(s: *EmitterState)
    let o: *OwnState = s.own
    if o.scope_count >= o.scope_cap
        let cap: i32 = o.scope_cap * 2
        o.scope_start = realloc(o.scope_start as *u8, (cap as i64) * 4) as *i32
        o.scope_dead = realloc(o.scope_dead as *u8, (cap as i64) * 4) as *i32
        o.scope_dstart = realloc(o.scope_dstart as *u8, (cap as i64) * 4) as *i32
        o.scope_cap = cap
    let starts: *i32 = o.scope_start
    let deads: *i32 = o.scope_dead
    let dstarts: *i32 = o.scope_dstart
    starts[o.scope_count] = o.live_count
    deads[o.scope_count] = 0
    dstarts[o.scope_count] = o.defer_count
    o.scope_count = o.scope_count + 1

# True once a `return` (or a loop's `break` / `continue`) ended the innermost
# block: what follows in it is unreachable.
fn own_scope_is_dead(o: *OwnState) -> bool
    if o.scope_count <= 0
        return false
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1] != 0

fn own_mark_dead(o: *OwnState)
    if o.scope_count <= 0
        return
    let deads: *i32 = o.scope_dead
    deads[o.scope_count - 1] = 1

# Drop live[from..] in reverse, without unregistering them.
fn own_drop_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    var i: i32 = o.live_count - 1
    while i >= from
        own_emit_drop(s, own_live_at(o, i))
        i -= 1

# Close the innermost block: drop what it declared (unless the block ended
# in a `return`, after which nothing is reachable) and forget it.
pub fn own_pop_scope(s: *EmitterState)
    let o: *OwnState = s.own
    if o.scope_count <= 0
        return
    let starts: *i32 = o.scope_start
    let start: i32 = starts[o.scope_count - 1]
    let dstarts: *i32 = o.scope_dstart
    let dstart: i32 = dstarts[o.scope_count - 1]
    if not own_scope_is_dead(o)
        own_unwind(s, start, dstart)   # drops and deferred statements (#1625)
    o.defer_count = dstart
    o.live_count = start
    o.scope_count = o.scope_count - 1

# Enter / leave a loop body.  `break` and `continue` drop live[loop_base..].
pub fn own_loop_enter(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.loop_base
    o.loop_base = o.live_count
    o.loop_depth = o.loop_depth + 1
    # AGAST #1625: `break` / `continue` run the defers registered from here.
    if o.loop_depth >= o.loop_dcap
        let dcap: i32 = o.loop_dcap * 2
        o.loop_dstart = realloc(o.loop_dstart as *u8, (dcap as i64) * 4) as *i32
        o.loop_dcap = dcap
    let ld: *i32 = o.loop_dstart
    ld[o.loop_depth] = o.defer_count
    # AGAST #4387: the temporaries a `break` / `continue` must drop too.
    if o.loop_depth >= o.loop_tcap
        let tcap: i32 = o.loop_tcap * 2
        o.loop_tbase = realloc(o.loop_tbase as *u8, (tcap as i64) * 4) as *i32
        o.loop_tcap = tcap
    let lt: *i32 = o.loop_tbase
    lt[o.loop_depth] = o.temp_count
    old

# After the loop body (its scope already popped).
pub fn own_loop_exit(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    o.loop_depth = o.loop_depth - 1
    o.loop_base = old

# Before a `break` / `continue` branches out of the loop body: drop the
# body's bindings and pending temporaries, running its deferred statements,
# innermost first (AGAST #2158, #4387).  Both leave the body alike.
pub fn own_loop_jump(s: *EmitterState)
    let o: *OwnState = s.own
    if o.loop_base < 0 or own_scope_is_dead(o)
        return
    # AGAST #1625: the body's deferred statements run first.
    let ld: *i32 = o.loop_dstart
    let dbase: i32 = ld[o.loop_depth]
    # AGAST #4387: the statement's pending temporaries leave with it too,
    # innermost first.
    let lt: *i32 = o.loop_tbase
    let tbase: i32 = lt[o.loop_depth]
    if o.temp_count <= tbase and o.defer_count <= dbase
        own_drop_from(s, o.loop_base)
    else
        own_unwind_loop(s, o.loop_base, dbase, tbase)

# =============================================================================
# Temporaries (AGAST #2165)
# =============================================================================

# After emit_expr emitted call `e` as register `reg`: if the move check
# marked it a temporary, spill it with a set drop flag and queue its drop.
pub fn own_note_temp(s: *EmitterState, e: *Expr, reg: i32)
    let o: *OwnState = s.own
    if reg == 0 or not own_take_temp_mark(o, e)
        return
    let t: StructElems = own_temp_type(s, e)
    if t.name.is_empty()
        return
    if t.count > 0
        own_note_array_call_temp(s, e, reg, t)
        return
    let slot: i32 = entry_alloca_begin(s)
    emit_llvm_type_struct(s, TypeKind.Struct, t.name)
    format_into(s, "  ; temporary\n")
    entry_alloca_end(s)
    format_into(s, "  store ")
    emit_llvm_type_struct(s, TypeKind.Struct, t.name)
    format_into(s, " %.{reg}, ptr %.{slot}\n")
    own_push_temp(s, slot, t)
    o.temp_last_reg = reg
    o.temp_last_slot = slot

# AGAST #3258: own_note_temp of a `-> [N]T` call's result `reg`, T needing a
# drop: a `[N x T]` value spilled to a slot, or the sret slot `reg` already is
# (#3181), queued to drop per element as a `[N]T` binding is.
fn own_note_array_call_temp(s: *EmitterState, e: *Expr, reg: i32, t: StructElems)
    let o: *OwnState = s.own
    let ra: *Param = call_ret_array(s, e)
    var slot: i32 = reg
    if array_param_uses_byval(s, ra) == 0
        slot = entry_alloca_begin(s)
        emit_array_value_llvm_type(s, ra)
        format_into(s, "  ; temporary\n")
        entry_alloca_end(s)
        format_into(s, "  store ")
        emit_array_value_llvm_type(s, ra)
        format_into(s, " %.{reg}, ptr %.{slot}\n")
    own_push_temp(s, slot, t)
    o.temp_last_reg = reg
    o.temp_last_slot = slot

# AGAST #2262: the slot own_note_temp just spilled `reg` to, or 0.  A method
# receiver that is a temporary is passed as that slot, not a copy of it.
pub fn own_temp_slot_of(s: *EmitterState, reg: i32) -> i32
    let o: *OwnState = s.own
    if reg == 0 or o.temp_last_reg != reg
        return 0
    o.temp_last_slot

# AGAST #3258: true when the move check marked `e` a temporary, which emitting
# it will spill (own_note_temp); keeps the mark.
pub fn own_temp_marked(s: *EmitterState, e: *Expr) -> bool
    let o: *OwnState = s.own
    let te: **Expr = o.temp_exprs
    var i: i32 = 0
    while i < o.temp_expr_count
        if te[i] == e
            return true
        i += 1
    false

# True when the move check marked `e` a temporary; forgets the mark.
fn own_take_temp_mark(o: *OwnState, e: *Expr) -> bool
    let te: **Expr = o.temp_exprs
    var i: i32 = 0
    while i < o.temp_expr_count and te[i] != e
        i += 1
    if i >= o.temp_expr_count
        return false
    o.temp_expr_count = o.temp_expr_count - 1
    te[i] = te[o.temp_expr_count]
    true

# AGAST #2266: after emit_expr wrote array literal `e` (`[N]T` of struct T)
# into the alloca `slot`: if the move check marked it a temporary (nobody
# takes it), queue the drop of its elements, as a `[N]T` binding's.
pub fn own_note_array_temp(s: *EmitterState, e: *Expr, slot: i32)
    let o: *OwnState = s.own
    if not own_take_temp_mark(o, e)
        return
    let t: StructElems = own_temp_type(s, e)
    if t.name.is_empty()
        return
    own_push_temp(s, slot, t)

# Queue the drop of the temporary at `slot` (a `T`, or `[count]T` when count
# > 0), with a set drop flag.
fn own_push_temp(s: *EmitterState, slot: i32, t: StructElems)
    let o: *OwnState = s.own
    let flag: i32 = own_entry_alloca(s, "i1", "drop flag")
    if o.temp_count >= o.temp_cap
        let cap: i32 = o.temp_cap * 2
        o.temps = realloc(o.temps as *u8, (cap as i64) * sizeof(OwnBinding)) as *OwnBinding
        o.temp_cap = cap
    let b: *OwnBinding = own_temp_at(o, o.temp_count)
    own_init_binding(o, b, slot, flag, t.name, t.count)
    o.temp_count = o.temp_count + 1
    own_store_flag(s, b, true)

# Drop temps[from..] (newest first) and forget them.
fn own_drop_temps_from(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    if o.temp_count <= from
        return
    if not own_scope_is_dead(o)
        var i: i32 = o.temp_count - 1
        while i >= from
            own_emit_drop(s, own_temp_at(o, i))
            i -= 1
    o.temp_count = from

# AGAST #2518 / #3050: `f(@mk())` lends `mk()`'s temporary to f, and it drops
# when f returns, not when the statement ends: `look(@make(1)) * 10 + DROPS`
# counts it.  The `@` (emit_expr_unary) marks the temporaries its operand made
# lent; emit_expr drops those its call's arguments lent once the call is
# emitted.  A stack of their slots, newest last.
var OWN_LENT: *i32 = null
var OWN_LENT_COUNT: i32 = 0
var OWN_LENT_CAP: i32 = 0

# Where `temps` is now, for own_lend_temps.
pub fn own_temp_mark(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    o.temp_count

# `@op` was just emitted: if op is (a part of) a call's temporary, the
# temporaries made since `from` are lent to the call `@op` is an argument of.
pub fn own_lend_temps(s: *EmitterState, op: *Expr, from: i32)
    let o: *OwnState = s.own
    if o.temp_count <= from or ref_temp_call(s, op) == null
        return
    var i: i32 = from
    while i < o.temp_count
        if OWN_LENT_COUNT >= OWN_LENT_CAP
            var cap: i32 = OWN_LENT_CAP * 2
            if cap < 16
                cap = 16
            OWN_LENT = realloc(OWN_LENT as *u8, (cap as i64) * 4) as *i32
            OWN_LENT_CAP = cap
        let lt: *OwnBinding = own_temp_at(o, i)
        OWN_LENT[OWN_LENT_COUNT] = lt.slot
        OWN_LENT_COUNT = OWN_LENT_COUNT + 1
        i += 1

fn own_lent_slot_at(o: *OwnState, i: i32) -> i32
    let b: *OwnBinding = own_temp_at(o, i)
    b.slot

# Before a call's arguments: where the lent stack is.
pub fn own_lent_mark() -> i32
    OWN_LENT_COUNT

# After the call: drop what its arguments lent (newest first) and forget it.
pub fn own_drop_lent(s: *EmitterState, from: i32)
    let o: *OwnState = s.own
    while OWN_LENT_COUNT > from
        OWN_LENT_COUNT = OWN_LENT_COUNT - 1
        let slot: i32 = OWN_LENT[OWN_LENT_COUNT]
        var i: i32 = o.temp_count - 1
        while i >= o.stmt_mark and own_lent_slot_at(o, i) != slot
            i -= 1
        if i >= o.stmt_mark
            if not own_scope_is_dead(o)
                own_emit_drop(s, own_temp_at(o, i))
            var j: i32 = i + 1
            while j < o.temp_count
                own_copy_binding(own_temp_at(o, j - 1), own_temp_at(o, j))
                j += 1
            o.temp_count = o.temp_count - 1

# Bracket each statement: own_stmt_begin before it, own_stmt_end (with
# what begin returned) after, which drops the temporaries it made.
pub fn own_stmt_begin(s: *EmitterState) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.stmt_mark
    o.stmt_mark = o.temp_count
    old

pub fn own_stmt_end(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)
    o.stmt_mark = old

# After an `if` / `while` condition, before its branch: its temporaries
# drop here, as ritz0 drops them.
pub fn own_cond_end(s: *EmitterState)
    let o: *OwnState = s.own
    own_drop_temps_from(s, o.stmt_mark)

# AGAST #2168: true when a value of struct type `name` can have fields moved
# out: it has no drop of its own and a move-only field.
fn own_partly_movable(s: *EmitterState, name: StrView) -> bool
    if own_has_drop_impl(s, name)
        return false
    let st: *StructDef = find_struct(s, name)
    st != null and own_fields_move_only(s, st.fields, 0)

# AGAST #2242: path `i` of the binding.
fn own_path_at(b: *OwnBinding, i: i32) -> *OwnPath
    let base: *OwnPath = b.paths
    return @base[i]

# Add a path for each move-only field of the struct `name`, the parts of
# path `parent`, to the array *pp (room for *cap, grown as it fills).
# Returns the new path count.
fn own_add_paths(s: *EmitterState, pp: **OwnPath, cap: *i32, count: i32, parent: i32, name: StrView) -> i32
    let st: *StructDef = find_struct(s, name)
    if st == null
        return count
    var n: i32 = count
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if own_field_move_only(s, f, 0)
            if n >= *cap
                let nc: i32 = *cap * 2
                *pp = realloc(*pp as *u8, (nc as i64) * sizeof(OwnPath)) as *OwnPath
                *cap = nc
            let paths: *OwnPath = *pp
            let bit: i32 = own_set_bit(n)
            let p: *OwnPath = @paths[n]
            p.parent = parent
            p.idx = idx
            p.fld = f
            p.up = bit
            p.down = bit
            var a: i32 = parent
            while a >= 0
                let ap: *OwnPath = @paths[a]
                p.up = own_set_or(p.up, own_set_bit(a))
                ap.down = own_set_or(ap.down, bit)
                a = ap.parent
            n += 1
        idx += 1
        f = f.next
    n

# How many paths path `i` is a part of.
fn own_path_depth(paths: *OwnPath, i: i32) -> i32
    var d: i32 = 0
    var p: *OwnPath = @paths[i]
    while p.parent >= 0
        d += 1
        p = @paths[p.parent]
    d

# The paths of a partly movable struct `name` (their count in *out_n),
# shallowest first, so the fields nearest the binding get the paths a set
# holds inline.  A field stops the walk where it can't be partly moved
# itself: a type with its own drop, an enum, an array.  Every path is
# tracked (AGAST #2319); only OWN_MAX_DEPTH bounds a malformed recursive type.
fn own_build_paths(s: *EmitterState, name: StrView, out_n: *i32) -> *OwnPath
    var cap: i32 = 32
    var paths: *OwnPath = malloc((cap as i64) * sizeof(OwnPath)) as *OwnPath
    var n: i32 = own_add_paths(s, @paths, @cap, 0, 0 - 1, name)
    var i: i32 = 0
    while i < n
        let p: *OwnPath = @paths[i]
        let f: *StructField = p.fld
        if f.field_type == TypeKind.Struct and own_path_depth(paths, i) < OWN_MAX_DEPTH and own_partly_movable(s, own_field_type(f))
            n = own_add_paths(s, @paths, @cap, n, i, own_field_type(f))
        i += 1
    *out_n = n
    paths

# The path for field `idx` of path `parent`, or -1.
fn own_child_path(b: *OwnBinding, parent: i32, idx: i32) -> i32
    var i: i32 = 0
    while i < b.path_count
        let p: *OwnPath = own_path_at(b, i)
        if p.parent == parent and p.idx == idx
            return i
        i += 1
    0 - 1

# The path for the field `name` of path `parent`, or -1.
fn own_named_path(b: *OwnBinding, parent: i32, name: StrView) -> i32
    var i: i32 = 0
    while i < b.path_count
        let p: *OwnPath = own_path_at(b, i)
        let fname: StrView = StrView { ptr: p.fld.name, len: p.fld.name_len as i64 }
        if p.parent == parent and fname.eq(name)
            return i
        i += 1
    0 - 1

fn own_has_parts(b: *OwnBinding, path: i32) -> bool
    own_path_at(b, path).down != own_set_bit(path)

# AGAST #3507: true when Sema's move check found the local `loc` (by its
# declaration's name pointer) owning a move-only value in the fn being
# emitted (FnDef.own_binds, own_check.ritz).
fn own_annotated(loc: *LocalVar) -> bool
    let f: *FnDef = emitter_current_fn()
    if f == null or f.own_binds == null or loc.name == null
        return false
    let ob: *OwnedBinds = f.own_binds
    let names: **u8 = ob.names
    var i: i32 = 0
    while i < ob.count
        if names[i] == loc.name
            return true
        i += 1
    false

# Register the local at `idx` if it is a move-only value: one Sema's move
# check found owning one (own_annotated).  `owned` when it starts out
# holding a value (an initialised declaration, a parameter).
fn own_register(s: *EmitterState, idx: i32, owned: bool)
    let loc: *LocalVar = local_at(s, idx)
    var name: StrView = StrView { ptr: lv_type_name(loc), len: lv_type_name_len(loc) as i64 }
    var count: i32 = 0
    if lv_var_type(loc) == TypeKind.Array
        # `[N]T` / `[N][M]..T` of move-only T (AGAST #2165).
        if lv_array_shape(loc) != null
            let leaves: StructElems = own_shape_elems(lv_array_shape(loc))
            if leaves.name.is_empty()
                return
            name = leaves.name
            count = leaves.count
        else if lv_array_elem_type(loc) == TypeKind.Struct and lv_array_size(loc) > 0
            count = lv_array_size(loc)
        else
            return
    else if lv_var_type(loc) != TypeKind.Struct
        return
    if not own_annotated(loc)
        return
    let o: *OwnState = s.own
    # A redeclaration that reuses its storage is the same binding.
    var i: i32 = 0
    while i < o.live_count
        let lb: *OwnBinding = own_live_at(o, i)
        if lb.slot == loc.reg
            lb.local_idx = idx
            lb.moved = 0
            own_store_flag(s, lb, owned)
            own_clear_mask(s, lb)
            return
        i += 1
    let flag: i32 = own_entry_alloca(s, "i1", "drop flag")
    # AGAST #2168: a struct with no drop of its own can be partly moved.
    var fmask: i32 = 0
    var paths: *OwnPath = null
    var path_count: i32 = 0
    if count == 0 and own_partly_movable(s, name)
        paths = own_build_paths(s, name, @path_count)
        # One bit per path, in whole 32-bit words (own_mask_width).
        let bits: i32 = (path_count + 31) / 32 * 32
        fmask = entry_alloca_begin(s)
        format_into(s, "i{bits}  ; moved fields\n")
        entry_alloca_end(s)
    own_grow_live(o)
    let b: *OwnBinding = own_live_at(o, o.live_count)
    own_init_binding(o, b, loc.reg, flag, name, count)
    b.name = loc.name
    b.name_len = loc.name_len
    b.local_idx = idx
    b.paths = paths
    b.path_count = path_count
    b.fmask = fmask
    o.live_count = o.live_count + 1
    own_store_flag(s, b, owned)
    own_clear_mask(s, b)

# Start of a fn body (after its params are bound): the fn's outermost block,
# holding its by-value move-only params, which the callee owns.
pub fn own_begin_fn(s: *EmitterState, params: *Param)
    let o: *OwnState = s.own
    o.live_count = 0
    o.scope_count = 0
    o.seq_next = 0
    o.loop_base = -1
    o.ret_seq = 0
    o.temp_expr_count = 0
    o.temp_count = 0
    o.stmt_mark = 0
    o.temp_last_reg = 0   # registers restart per function
    o.loop_depth = 0
    o.match_scrut = 0 - 1
    o.defer_count = 0
    o.in_ret = 0
    own_push_scope(s)
    var p: *Param = params
    while p != null
        if p.param_type == TypeKind.Struct or p.param_type == TypeKind.Array
            let idx: i32 = find_local_idx(s, StrView { ptr: p.name, len: p.name_len as i64 })
            if idx >= 0
                own_register(s, idx, true)
        p = p.next

# After a `let` / `var`: register the binding it declared.  `before` is
# s.local_count before the declaration (see mark_let_local).
pub fn own_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, StrView { ptr: stmt.var_name, len: stmt.var_name_len as i64 })
    if idx < before or idx < 0
        return
    let owned: bool = stmt.var_init != null
    own_register(s, idx, owned)
    if not owned
        own_start_unwritten(s, stmt)

# `var x: T` with no initialiser, T with drop glue (§13.6, AGAST #4033,
# #4096; own_check's oc_start_unwritten checks it).  Each path of T with no
# parts of its own (a type with its own drop, an enum, an array) starts
# unwritten.  x owns the rest, so its flag is set and those paths' mask bits
# too: neither the first store into one nor x's drop runs glue over what the
# stack held.  A T with no paths leaves x owning nothing (its flag clear)
# until it is assigned.
fn own_start_unwritten(s: *EmitterState, stmt: *Stmt)
    let b: *OwnBinding = own_lookup(s, StrView { ptr: stmt.var_name, len: stmt.var_name_len as i64 })
    if b == null or b.count > 0 or b.path_count == 0
        return
    var leaves: i32 = 0
    var i: i32 = 0
    while i < b.path_count
        if not own_has_parts(b, i)
            leaves = own_set_or(leaves, own_set_bit(i))
        i += 1
    own_store_flag(s, b, true)
    own_emit_mask_bits(s, b, leaves, true)

# `@x as *U` that own_check marked (Expr.own_raw, its oc_raw_written): raw
# code writes x's unwritten parts from here, so x owns them: its flag is set
# and those paths' mask bits cleared.
pub fn own_raw_written(s: *EmitterState, e: *Expr)
    if e.own_raw == 0 or e.left == null or e.left.operand == null
        return
    let b: *OwnBinding = own_lookup(s, own_ident(e.left.operand))
    if b == null
        return
    own_store_flag(s, b, true)
    own_emit_mask_bits(s, b, e.own_raw_bits, false)

# After a `let (a, b, ..) = v` (emit_tuple_decl): each name owns the element
# it was bound to, and drops it at scope end unless moved (AGAST #3033).  The
# source was moved into the destructure by own_stmt_moves.
pub fn own_tuple_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    own_tuple_name(s, StrView { ptr: stmt.var_name, len: stmt.var_name_len as i64 }, before)
    own_tuple_name(s, StrView { ptr: stmt.assign_target, len: stmt.assign_target_len as i64 }, before)
    var tn: *TupleName = stmt.tuple_more
    while tn != null
        own_tuple_name(s, StrView { ptr: tn.name, len: tn.len as i64 }, before)
        tn = tn.next

fn own_tuple_name(s: *EmitterState, name: StrView, before: i32)
    let idx: i32 = find_local_idx(s, name)
    if idx < before or idx < 0
        return
    own_register(s, idx, true)

# The registered binding `name` currently resolves to, or null.
fn own_lookup(s: *EmitterState, name: StrView) -> *OwnBinding
    let o: *OwnState = s.own
    if o.live_count == 0
        return null
    let idx: i32 = find_local_idx(s, name)
    if idx < 0
        return null
    var i: i32 = o.live_count - 1
    while i >= 0
        let b: *OwnBinding = own_live_at(o, i)
        let bname: StrView = StrView { ptr: b.name, len: b.name_len as i64 }
        if b.local_idx == idx and bname.eq(name)
            return b
        i -= 1
    null

# =============================================================================
# Move check
# =============================================================================

# Field `idx` of the struct `name`, or null.
fn own_struct_field(s: *EmitterState, name: StrView, idx: i32) -> *StructField
    let st: *StructDef = find_struct(s, name)
    if st == null
        return null
    var f: *StructField = st.fields
    var i: i32 = 0
    while f != null and i < idx
        f = f.next
        i += 1
    f

# AGAST #2242: the paths a use of `path` overlaps: it and its parents, and
# not `exact`, no more, as that names a field of `path` no path covers, so
# what moved out of `path` is its sibling.  When `exact`, its parts too.
fn own_overlap(b: *OwnBinding, path: i32, exact: bool) -> i32
    if path < 0
        return 0
    let p: *OwnPath = own_path_at(b, path)
    if exact
        return own_set_or(p.up, p.down)
    p.up

# A member path `x.f1...fn` rooted at a registered single-value binding x.
struct OwnMember
    fld: *StructField    # fn, or null when `e` is no such path
    b: *OwnBinding       # x
    drop: StrView        # the first struct along the path with its own drop, or no_name()

fn no_member() -> OwnMember
    OwnMember { fld: null, b: null, drop: no_name() }

fn own_member_path(s: *EmitterState, e: *Expr) -> OwnMember
    if e.kind != ExprKind.Member or e.left == null
        return no_member()
    let l: *Expr = e.left
    var mp: OwnMember = no_member()
    var tname: StrView = no_name()
    if l.kind == ExprKind.Ident
        let b: *OwnBinding = own_lookup(s, own_ident(l))
        if b == null or b.count > 0
            return no_member()
        mp.b = b
        tname = own_binding_type(b)
    else
        mp = own_member_path(s, l)
        if mp.fld == null or mp.fld.field_type != TypeKind.Struct
            return no_member()
        tname = own_field_type(mp.fld)
    let st: *StructDef = find_struct(s, tname)
    if st == null
        return no_member()
    let idx: i32 = find_field_index(st, own_ident(e))
    if idx < 0
        return no_member()
    if unnamed(mp.drop) and own_has_drop_impl(s, tname)
        mp.drop = tname
    mp.fld = own_struct_field(s, tname, idx)
    mp

# The deepest path of a binding along a member path (own_path_of).
struct PathHit
    path: i32     # -1 for the binding itself
    exact: bool   # the member path ends on it, not in a field no path covers

# AGAST #2242: the deepest path of `b` along the member path `e`, rooted at b.
fn own_path_of(b: *OwnBinding, e: *Expr) -> PathHit
    if e.kind != ExprKind.Member or e.left == null
        return PathHit { path: 0 - 1, exact: true }
    let parent: PathHit = own_path_of(b, e.left)
    if not parent.exact
        return parent
    let path: i32 = own_named_path(b, parent.path, own_ident(e))
    if path < 0
        return PathHit { path: parent.path, exact: false }
    PathHit { path: path, exact: true }

# `call().f` with f a move-only field (ritz0's _is_move_only_field).
fn own_temp_field_move_only(s: *EmitterState, e: *Expr) -> bool
    let l: *Expr = e.left
    if l == null or l.kind != ExprKind.Call
        return false
    let name: StrView = own_call_ret_type(s, l)
    if name.is_empty()
        return false
    let st: *StructDef = find_struct(s, name)
    if st == null
        return false
    let idx: i32 = find_field_index(st, own_ident(e))
    if idx < 0
        return false
    own_field_move_only(s, own_struct_field(s, name, idx), 0)

# `x.f...` (AGAST #2168, #2242): a use of that path, or when `mv` a move of
# it when the path's value is move-only.
fn own_walk_member(s: *EmitterState, e: *Expr, mv: bool)
    let mp: OwnMember = own_member_path(s, e)
    if mp.fld == null
        # Moving a move-only field out of a temporary: the rest of the
        # temporary isn't dropped either (ritz0: no partial drops).
        own_walk(s, e.left, mv and own_temp_field_move_only(s, e))
        return
    if not mv or not own_field_move_only(s, mp.fld, 0) or not unnamed(mp.drop)
        return
    let b: *OwnBinding = mp.b
    let hit: PathHit = own_path_of(b, e)
    if hit.path < 0
        # Can't be tracked per path: the whole binding moves.
        b.moved = 1
        own_store_flag(s, b, false)
        return
    own_emit_mask_bits(s, b, own_set_bit(hit.path), true)

# The move-only struct type a call or method call returns by value, or
# no_name().
fn own_call_ret_type(s: *EmitterState, e: *Expr) -> StrView
    var f: *FnDef = null
    match e.kind
        ExprKind.Call =>
            f = find_call_fn(s, e)
        ExprKind.Method =>
            f = ref_method_def(s, e)   # AGAST #2262
        _ => pass   # no call: no result
    if f == null or f.return_type != TypeKind.Struct or f.return_type_name_len <= 0
        return no_name()
    let name: StrView = StrView { ptr: f.return_type_name, len: f.return_type_name_len as i64 }
    if not own_type_is_move_only(s, name)
        return no_name()
    name

# AGAST #2266: the struct T an array literal `[a, b, ..]` holds, as `[N]T`:
# T and N, or no_elems() when no element names a struct.  The first element
# whose type ritz1 can name decides; a string literal names none (its
# `%Span$u8` isn't the slot's `%StrView`).
pub fn array_lit_struct_elem(s: *EmitterState, e: *Expr) -> StructElems
    if e == null or e.kind != ExprKind.ArrayLit
        return no_elems()
    var name: StrView = no_name()
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        if name.is_empty()
            name = elem_struct_name(s, it)
        n += 1
        it = it.next
    if name.is_empty()
        return no_elems()
    StructElems { name: name, count: n }

# The struct an array element `it` names, or no_name(): a struct literal's
# type, or a value whose type ritz1 can name.  A string literal names none.
fn elem_struct_name(s: *EmitterState, it: *Expr) -> StrView
    if it.kind == ExprKind.StructLit and it.ident_len > 0
        return own_ident(it)
    if it.kind != ExprKind.StringLit
        var t: RefTy
        if ref_ty_of(s, it, @t) == 1 and t.kind == TypeKind.Struct and t.name_len > 0
            return StrView { ptr: t.name, len: t.name_len as i64 }
    no_name()

# AGAST #2976: array_lit_struct_elem for a fill `[v; N]`: the struct v names
# and N, or no_elems() when v names none.
pub fn array_fill_struct_elem(s: *EmitterState, e: *Expr) -> StructElems
    if e == null or e.kind != ExprKind.ArrayFill or e.left == null
        return no_elems()
    let name: StrView = elem_struct_name(s, e.left)
    if name.is_empty()
        return no_elems()
    StructElems { name: name, count: e.int_val as i32 }

# AGAST #3258: the move-only struct T of a call's `-> [N]T` result, and N; or
# no_elems().
fn own_call_ret_array_type(s: *EmitterState, e: *Expr) -> StructElems
    let ra: *Param = call_ret_array(s, e)
    if ra == null or ra.param_array_elem_type != TypeKind.Struct or ra.param_type_name_len <= 0 or ra.param_array_size <= 0
        return no_elems()
    let name: StrView = StrView { ptr: ra.param_type_name, len: ra.param_type_name_len as i64 }
    if not own_type_is_move_only(s, name)
        return no_elems()
    StructElems { name: name, count: ra.param_array_size }

# The move-only type a temporary `e` holds, or no_elems(): a call's result
# (count 0), its `[N]T` result's elements (count N, AGAST #3258), or an array
# literal's elements (count N, AGAST #2266).
fn own_temp_type(s: *EmitterState, e: *Expr) -> StructElems
    if e.kind == ExprKind.Call or e.kind == ExprKind.Method
        let arr: StructElems = own_call_ret_array_type(s, e)
        if not arr.name.is_empty()
            return arr
    if e.kind != ExprKind.ArrayLit
        return StructElems { name: own_call_ret_type(s, e), count: 0 }
    let lit: StructElems = array_lit_struct_elem(s, e)
    if lit.count == 0 or not own_type_is_move_only(s, lit.name)
        return no_elems()
    lit

# `e`, a call or array literal whose move-only value nobody takes, yields a
# temporary: remember it for own_note_temp / own_note_array_temp.
fn own_mark_temp(s: *EmitterState, e: *Expr)
    if own_temp_type(s, e).name.is_empty()
        return
    let o: *OwnState = s.own
    if o.temp_expr_count >= o.temp_expr_cap
        let cap: i32 = o.temp_expr_cap * 2
        o.temp_exprs = realloc(o.temp_exprs as *u8, (cap as i64) * 8) as **Expr
        o.temp_expr_cap = cap
    let te: **Expr = o.temp_exprs
    te[o.temp_expr_count] = e
    o.temp_expr_count = o.temp_expr_count + 1

# True when an argument bound to `p` is passed by value (a move).  A
# reference or pointer param reaches its argument through it, and borrows
# it; an unknown callee is taken as by-value.
fn own_param_moves(p: *Param) -> bool
    p == null or own_kind_reach(p.param_type) == OwnReach.Owned

fn own_walk_args(s: *EmitterState, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        own_walk(s, a, own_param_moves(p))
        if p != null
            p = p.next
        a = a.next

# The struct a method receiver names, as emitter_expr_call's method_recv_type does.
fn own_recv_def(s: *EmitterState, e: *Expr) -> *FnDef
    let recv: *Expr = e.left
    if recv == null or recv.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, own_ident(recv))
    if loc == null or lv_type_name_len(loc) <= 0
        return null
    let ty: StrView = StrView { ptr: lv_type_name(loc), len: lv_type_name_len(loc) as i64 }
    return method_callee_def(s, ty, own_ident(e))

# The `a[i]` that the place `e` (`a[i]`, `a[i].f.g`) is, or is a field of, when
# `a` is an array held by value: a local, a by-value param, a field of one or a
# call's result.  null otherwise: `p[i]` through a reference is not one.
# A slice `a[i..j]` is no element, and ref_ty_of doesn't type one as a struct,
# so it can't be taken for one.  ritz0's MoveChecker._element_root.
fn own_element_root(s: *EmitterState, e: *Expr) -> *Expr
    var r: *Expr = e
    while r != null and r.kind == ExprKind.Member
        r = r.left
    if r == null or r.kind != ExprKind.Index
        return null
    var b: RefTy
    if ref_ty_of(s, r.left, @b) == 0 or b.kind != TypeKind.Array
        return null
    r

# The line and column an error about `e` points at: where it starts.
pub fn own_start_of(e: *Expr) -> *Expr
    var r: *Expr = e
    while r.left != null and (r.kind == ExprKind.Member or r.kind == ExprKind.Index or r.kind == ExprKind.Method)
        r = r.left
    r

# A scrutinee moves into its match, unless a reference holds it, or it is an
# array's element (#2268): that's a read.
fn own_scrutinee_mv(s: *EmitterState, e: *Expr) -> bool
    ref_through(s, e) == 0 and own_element_root(s, e) == null

# True for `.unwrap()` of a move-only Some/Ok payload, which consumes the
# carrier, so its drop flag clears (AGAST #4490).  own_check refuses a
# borrowed receiver; a program that reaches here passed that check.  A copy
# payload is left to the caller's receiver rule.
fn own_unwrap_consumes(s: *EmitterState, e: *Expr) -> bool
    if e.args != null or not own_ident(e).eq("unwrap")
        return false
    if e.left == null or ref_through(s, e.left) == 1
        return false
    var t: RefTy
    if ref_ty_of(s, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
        return false
    let pay: StrView = named_by(unwrap_payload_struct_name, s, e)
    not pay.is_empty() and own_type_is_move_only(s, pay)

# One expression's moves, in evaluation order: each clears the moved
# binding's drop flag (or sets its moved field's bit) and marks the
# temporaries nobody owns.  `mv` when its value is used by value.  The
# rules (and their errors) are own_check.ritz's oc_walk, on Sema (AGAST
# #3507); a program that reaches here passed them.  Match / if-expression
# arms are walked as their bodies are emitted (own_arm_moves).
pub fn own_walk(s: *EmitterState, e: *Expr, mv: bool)
    if e == null
        return
    match e.kind
        ExprKind.Ident =>
            let b: *OwnBinding = own_lookup(s, own_ident(e))
            if b != null and mv
                b.moved = 1
                own_store_flag(s, b, false)
        ExprKind.Unary =>
            if (e.op == OpKind.Addr or e.op == OpKind.AddrMut) and e.operand != null and e.operand.kind == ExprKind.Ident
                return
            own_walk(s, e.operand, false)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            own_walk(s, e.left, false)
            own_walk(s, e.right, false)
        ExprKind.Member =>
            own_walk_member(s, e, mv)
        ExprKind.Cast =>
            # `v as T` hands its operand's value on: it moves wherever the cast
            # does (ritz0 since #2948; AGAST #2964).
            own_walk(s, e.left, mv)
        ExprKind.Try =>
            # `e?` consumes `e` either way (AGAST #2159), as own_check says.
            own_walk(s, e.left, true)
        ExprKind.Call =>
            # sizeof's operand is never evaluated (ritz0 #2124).
            let callee: StrView = StrView { ptr: e.func_name, len: e.func_name_len as i64 }
            if callee.eq("sizeof")
                return
            var p: *Param = null
            let f: *FnDef = find_call_fn(s, e)
            if f != null
                p = f.params
            own_walk_args(s, e.args, p)
            # A result nobody takes is a temporary (AGAST #2165).
            if not mv and f != null
                own_mark_temp(s, e)
        ExprKind.Method =>
            # A by-value `self` takes the receiver, as a by-value param takes its
            # argument (AGAST #2393).  Any other is passed by pointer, so a call
            # result as receiver is lent: a temporary, dropped after the call
            # (AGAST #2262).  When ritz1 can't find the method, such a receiver
            # stays a move: a leak, where a by-value `self` dropped as a
            # temporary too would be dropped twice.
            let m: *FnDef = own_recv_def(s, e)
            let taken: *FnDef = ref_method_def(s, e)
            var rmv: bool = false
            if taken == null
                rmv = e.left != null and (e.left.kind == ExprKind.Call or e.left.kind == ExprKind.Method)
            else
                rmv = param_self_is_value(taken.params) == 1
            # `.unwrap()` of a move-only Option/Result consumes the carrier (#4490).
            if own_unwrap_consumes(s, e)
                rmv = true
            own_walk(s, e.left, rmv)
            var mp: *Param = null
            if m != null and m.params != null
                mp = m.params.next
            own_walk_args(s, e.args, mp)
            # A result nobody takes is a temporary, as a call's (AGAST #2262).
            if not mv and taken != null
                own_mark_temp(s, e)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                own_walk(s, fi.value, true)
                fi = fi.next
        ExprKind.ArrayLit =>
            # A literal owns its elements (ritz0 #2238, AGAST #2266): each moves
            # in, as into a struct literal's field, and a literal nobody takes
            # is a temporary that drops them.
            var el: *Expr = e.args
            while el != null
                own_walk(s, el, true)
                el = el.next
            if not mv
                own_mark_temp(s, e)
        ExprKind.ArrayFill =>
            # `[v; N]` moves `v` into its element, as `[v]` does (AGAST #2976).
            own_walk(s, e.left, true)
        ExprKind.Match =>
            own_walk(s, e.left, own_scrutinee_mv(s, e.left))
        ExprKind.If =>
            own_walk(s, e.left, false)
        ExprKind.Unset | ExprKind.IntLit | ExprKind.StringLit | ExprKind.NilLit | ExprKind.CharLit | ExprKind.CstringLit | ExprKind.FloatLit | ExprKind.TypeOperand | ExprKind.Await =>
            pass

# True when the move check should look at code at this point.
fn own_checking(s: *EmitterState) -> bool
    let o: *OwnState = s.own
    if o.live_count == 0 and not own_any_drop(s)
        return false
    not own_scope_is_dead(o)

# The index of field `name` in the binding's struct, or -1.
fn own_field_idx(s: *EmitterState, b: *OwnBinding, name: StrView) -> i32
    let st: *StructDef = find_struct(s, own_binding_type(b))
    if st == null
        return 0 - 1
    find_field_index(st, name)

# The binding a whole-binding assignment `x = v` writes, or null.
fn own_assign_target(s: *EmitterState, stmt: *Stmt) -> *OwnBinding
    if stmt.kind != StmtKind.Assign
        return null
    if stmt.assign_target_len > 0
        return own_lookup(s, StrView { ptr: stmt.assign_target, len: stmt.assign_target_len as i64 })
    let t: *Expr = stmt.if_cond as *Expr
    if t != null and t.kind == ExprKind.Ident
        return own_lookup(s, own_ident(t))
    null

# Field stores (AGAST #2173).  `x.f = v` drops the old x.f, as `x = v`
# drops the old x (§13.6), after v is evaluated (v may read or move it):
# iff x owns a value (its drop flag) and f isn't moved out of it (its
# `fmask` bit).  The move check computes that i1 after checking v (whose
# moves it sees) and before re-owning f, into OwnState.fa_cond;
# own_assign_begin copies the old value aside and own_assign_end drops the
# copy once v is stored.  A deeper path `x.a.t = v` drops the old x.a.t on
# x's flag and the bits of a and t: the move check rejects it with a moved
# out (as Rust does, E0382), so the store never re-owns part of a moved
# field.  A field with parts moved out drops what is left of it (AGAST
# #2242).  A store through an `@&T` / `:&` reference drops the field's old
# value unconditionally; through a `*T` it drops nothing (LARB R58, see
# own_store_reach).

# The i1 "x owns the path whose bit and its parents' are `bits`" (x's flag,
# and those bits clear), or 0 when x can't own it (an array binding).
fn own_field_drop_cond(s: *EmitterState, b: *OwnBinding, bits: i32) -> i32
    if b.count > 0
        return 0
    let f: i32 = own_load_flag(s, b)
    if b.fmask == 0 or bits == 0
        return f
    let c: i32 = own_bits_clear(s, b, own_load_mask(s, b), bits)
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = and i1 %.{f}, %.{c}\n")
    r

# =============================================================================
# Stores through a reference (LARB R58, §13.6)
# =============================================================================
#
# A store through an `@T` / `@&T` / `:&` place drops the old value: a mutable
# borrow always refers to a live owned value, so there is no flag to consult.
# A store through a `*T` is a raw write and drops nothing.  Which one a place
# is comes from the typing phase's expression types (ref_ty_of), not from the
# IR already emitted.

# How a place is reached: through a reference, through a raw pointer, or to a
# binding's own storage.
pub enum OwnReach
    Owned
    Ref
    Raw

# How a value of kind `t` reaches what it refers to.  Every other kind is a
# value held in place.  That arm is `_`: spelling out the scalar kinds is
# types.ritz's alone (tests/test_ritz1_type_layout_table.py).
fn own_kind_reach(t: TypeKind) -> OwnReach
    match t
        TypeKind.Ref | TypeKind.MutRef => OwnReach.Ref
        TypeKind.Ptr | TypeKind.PtrPtr => OwnReach.Raw
        _ => OwnReach.Owned

# How the binding `loc` is reached: a `:&` / lent param, or an `@T` / `@&T`
# local, is a reference; a `*T` is raw; anything else is owned.
pub fn own_local_reach(loc: *LocalVar) -> OwnReach
    if loc == null
        return OwnReach.Owned
    # A `:&` param (incl. a `self:&` impl receiver) holds the caller's
    # pointer (AGAST #2286).
    if lv_is_lent(loc) == 1 or lv_holds_lent_ptr(loc) == 1
        return OwnReach.Ref
    own_kind_reach(lv_var_type(loc))

# How the place base `e` is reached: a borrow is a reference, a `*T` is raw,
# anything else is owned.
fn own_place_reach(s: *EmitterState, e: *Expr) -> OwnReach
    if e == null
        return OwnReach.Owned
    if e.kind == ExprKind.Ident
        return own_local_reach(find_local_struct_name(s, own_ident(e)))
    var t: RefTy
    if ref_ty_of(s, e, @t) == 0
        return OwnReach.Owned
    own_kind_reach(t.kind)

# The place a member, an index or a deref is a step into, or null.
fn own_place_base(place: *Expr) -> *Expr
    if place.kind == ExprKind.Member or place.kind == ExprKind.Index
        return place.left
    if place.kind == ExprKind.Unary and place.op == OpKind.Deref
        return place.operand
    null

# How the store target `target` is reached (LARB R58, §13.6): walk up its
# place -- a member's struct, an index's array, a deref's pointer -- and the
# first base that is a reference or pointer says how.  A root binding is
# owned unless it is a borrow.  A step the types can't name is owned, so the
# binding's drop flag decides, as it did before.
pub fn own_store_reach(s: *EmitterState, target: *Expr) -> OwnReach
    var place: *Expr = target
    while place != null
        if place.kind == ExprKind.Ident
            return own_place_reach(s, place)
        let base: *Expr = own_place_base(place)
        if base == null
            return OwnReach.Owned
        let r: OwnReach = own_place_reach(s, base)
        if r != OwnReach.Owned
            return r
        place = base
    OwnReach.Owned

# Drop the old field `f`'s value at `ptr` for a store through a reference:
# its own Drop, then its move-only parts.  Nothing when it isn't move-only.
pub fn own_drop_old_ref_field(s: *EmitterState, ptr: i32, f: *StructField)
    if own_field_move_only(s, f, 0)
        own_emit_field_glue(s, ptr, f, 0)

# Drop the old whole value `name` at `ptr` for a store through a reference.
pub fn own_drop_old_ref_value(s: *EmitterState, ptr: i32, name: StrView)
    if own_type_is_move_only(s, name)
        own_emit_glue(s, ptr, name, 0)

# A store to the move-only value at `path` of `b`: the drop condition of its
# old value into o.fa_cond, and when `path` is the value stored to (`exact`),
# the mask saying which of its parts that old value has left.
fn own_store_cond(s: *EmitterState, b: *OwnBinding, path: i32, exact: bool)
    let o: *OwnState = s.own
    o.fa_cond = own_field_drop_cond(s, b, own_overlap(b, path, false))
    if exact
        o.fa_path = path
        o.fa_mask = own_load_mask(s, b)

# `t = v` with t a member path `x.f...` rooted at the binding `b`, whose last
# field is `f`.
fn own_field_store_cond(s: *EmitterState, b: *OwnBinding, f: *StructField, path: i32, exact: bool)
    if own_field_move_only(s, f, 0)
        own_store_cond(s, b, path, exact)

# `x.f = v` (StmtKind.LocalFieldAssign) with x the binding `b`: as
# own_field_store_cond.
fn own_local_field_store(s: *EmitterState, b: *OwnBinding, stmt: *Stmt)
    let fname: StrView = StrView { ptr: stmt.assign_target, len: stmt.assign_target_len as i64 }
    let path: i32 = own_named_path(b, 0 - 1, fname)
    let idx: i32 = own_field_idx(s, b, fname)
    if idx < 0
        return
    let f: *StructField = own_struct_field(s, own_binding_type(b), idx)
    if f != null
        own_field_store_cond(s, b, f, path, path >= 0)

# Element stores (LARB R39, AGAST #3377; ritz0's _drop_old_element, #3376).
# `a[i] = v`, `g[i][j] = v`, `h.a[i] = v`, once v and the index are evaluated
# and before v is stored: drop the old element at `elem_ptr`, of type `name`,
# when a binding owns the array `arr` (the store's target without its
# indexes): an array local's drop flag, or for a field path `h.a` h's flag
# with `a` not moved out.  Through an `@&T` / `:&` reference it always drops
# (LARB R58); through a `*T` or into a global, nothing does.  Every element
# of an owned Drop array holds a value: such an array must be initialised
# (§3.3).
pub fn own_drop_old_elem(s: *EmitterState, arr: *Expr, elem_ptr: i32, name: StrView)
    if arr == null or name.ptr == null or name.len <= 0
        return
    if not own_type_is_move_only(s, name)
        return
    match own_store_reach(s, arr)
        OwnReach.Ref =>
            # Through a reference it always drops (LARB R58).
            own_emit_glue(s, elem_ptr, name, 0)
            return
        OwnReach.Raw =>
            return
        OwnReach.Owned =>
            pass
    let cond: i32 = own_elem_drop_cond(s, arr)
    if cond == 0
        return
    let saved: i32 = last_expr_here(s)
    let next: i32 = own_if_open(s, cond)
    own_emit_glue(s, elem_ptr, name, 0)
    own_if_close(s, next)
    if saved != 0
        set_last_expr(s, saved)

# The i1 "a binding owns the array `arr`" for own_drop_old_elem, or 0 when
# none does: an array local's flag, or a field path's drop condition.
fn own_elem_drop_cond(s: *EmitterState, arr: *Expr) -> i32
    if arr.kind == ExprKind.Ident
        let b: *OwnBinding = own_lookup(s, own_ident(arr))
        if b == null or b.count == 0
            return 0
        return own_load_flag(s, b)
    if arr.kind != ExprKind.Member
        return 0
    let mp: OwnMember = own_member_path(s, arr)
    if mp.fld == null or mp.b == null or mp.fld.field_type != TypeKind.Array
        return 0
    let hit: PathHit = own_path_of(mp.b, arr)
    own_field_drop_cond(s, mp.b, own_overlap(mp.b, hit.path, false))

# AGAST #4590: the statement-`if` arm's trailing StmtKind.Expr whose value
# the `if` hands on (it has an `else` and is not discarded), or null; set by
# emit_if_stmt_arm.  own_stmt_moves walks it as a move, as own_arm_moves does
# a match arm's: walked as a discarded value, a call there was a temporary,
# dropped at the arm's end after its value went into the phi (a use after
# free in the caller).
var OWN_IF_ARM_MOVES: *Stmt = null

# Mark `st` the value-giving `if` arm's value (null: none); returns the old mark.
pub fn own_mark_if_arm_moves(st: *Stmt) -> *Stmt
    let old: *Stmt = OWN_IF_ARM_MOVES
    OWN_IF_ARM_MOVES = st
    old

# One statement's moves, before it is emitted (emit_stmt), and a field
# store's drop condition (OwnState.fa_cond).  Nested statement lists are
# walked as emit_stmt reaches them.
pub fn own_stmt_moves(s: *EmitterState, stmt: *Stmt)
    let o: *OwnState = s.own
    o.fa_cond = 0
    o.fa_path = 0 - 1
    o.fa_mask = 0
    if not own_checking(s)
        return
    match stmt.kind
        StmtKind.VarDecl | StmtKind.TupleDecl =>
            own_walk(s, stmt.var_init, true)
        StmtKind.Assign =>
            let t: *Expr = stmt.if_cond as *Expr
            # `x.f... = v` (AGAST #2168, #2242): v first, since it can move what
            # is stored to; then the old value's drop condition.
            var mp: OwnMember = no_member()
            if stmt.assign_target_len == 0 and t != null
                if t.kind == ExprKind.Member
                    mp = own_member_path(s, t)
                if mp.fld == null and t.kind != ExprKind.Ident
                    own_walk(s, t, false)
            own_walk(s, stmt.assign_value, true)
            if mp.fld != null
                let hit: PathHit = own_path_of(mp.b, t)
                own_field_store_cond(s, mp.b, mp.fld, hit.path, hit.exact)
        StmtKind.LocalFieldAssign =>
            # `x.f = v`: x is used, not moved; a single-value x drops the old
            # x.f, as the path store above.
            let base: *OwnBinding = own_lookup(s, StrView { ptr: stmt.var_name, len: stmt.var_name_len as i64 })
            own_walk(s, stmt.assign_value, true)
            if base != null and base.count == 0
                own_local_field_store(s, base, stmt)
        StmtKind.IndexAssign | StmtKind.LocalFieldIndexAssign =>
            # `x[i] = v`, `x.f[i] = v`: x is used, not moved.
            own_walk(s, stmt.while_cond, false)
            own_walk(s, stmt.assign_value, true)
        StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            own_walk(s, stmt.assign_value, true)
        StmtKind.Return =>
            own_walk(s, stmt.return_value, true)
        StmtKind.Expr =>
            # AGAST #4590: a value-giving statement `if`'s arm value moves out.
            own_walk(s, stmt.expr, stmt == OWN_IF_ARM_MOVES)
        StmtKind.Match =>
            # AGAST #2174: the scrutinee moves into the match, as in the
            # expression form (own_match_begin takes ownership).
            let scrut: *Expr = stmt.if_cond as *Expr
            own_walk(s, scrut, own_scrutinee_mv(s, scrut))
        StmtKind.If | StmtKind.Assert =>
            own_walk(s, stmt.if_cond, false)
        StmtKind.While =>
            own_walk(s, stmt.while_cond, false)
        StmtKind.For =>
            own_walk(s, stmt.for_start, false)
            own_walk(s, stmt.for_end, false)
        StmtKind.Unset | StmtKind.Break | StmtKind.Continue | StmtKind.Loop | StmtKind.Stripped | StmtKind.Defer | StmtKind.Unsafe | StmtKind.Asm =>
            # No value of their own: a body's statements are walked as they
            # are emitted.
            pass

# After a statement is emitted: a `return` ends its block for the check,
# and so does a `break` / `continue` in a loop (their moves reach the loop
# head or exit through own_loop_jump's events instead).
pub fn own_after_stmt(s: *EmitterState, stmt: *Stmt)
    let o: *OwnState = s.own
    if o.scope_count <= 0
        return
    let jumps: bool = stmt.kind == StmtKind.Break or stmt.kind == StmtKind.Continue
    if stmt.kind == StmtKind.Return or (jumps and o.loop_depth > 0)
        own_mark_dead(o)

# A fn's tail expression is its return value: a move.
pub fn own_tail_moves(s: *EmitterState, e: *Expr)
    if own_checking(s)
        own_walk(s, e, true)

# A match / if-expression arm's value expression.
pub fn own_arm_moves(s: *EmitterState, e: *Expr)
    if own_checking(s)
        own_walk(s, e, true)

# =============================================================================
# Reassignment
# =============================================================================

# The LLVM type of a binding's storage: `[N x %T]` for an array (an N-D
# array's leaves are contiguous, so a flat array of them is its layout).
fn own_emit_binding_type(s: *EmitterState, b: *OwnBinding)
    if b.count > 0
        format_into(s, "[{b.count} x ")
        emit_llvm_type_struct(s, TypeKind.Struct, own_binding_type(b))
        format_into(s, "]")
        return
    emit_llvm_type_struct(s, TypeKind.Struct, own_binding_type(b))

# Before `x = v` is emitted: copy x's old value aside with its flag (and
# its moved-field mask), so it can be dropped once v (which may still read
# x) has been stored.  Returns a handle for own_assign_end (a copy of x's
# binding, freed there), or null when x is not an owned binding.
pub fn own_assign_begin(s: *EmitterState, stmt: *Stmt, out_old: *i32, out_flag: *i32) -> *OwnBinding
    *out_old = 0
    *out_flag = 0
    let o: *OwnState = s.own
    if o.fa_cond != 0
        let cond: i32 = o.fa_cond
        o.fa_cond = 0
        return own_field_store_begin(s, stmt, cond, out_old, out_flag)
    if o.live_count == 0
        return null
    let b: *OwnBinding = own_assign_target(s, stmt)
    if b == null
        return null
    let f: i32 = own_load_flag(s, b)
    let m: i32 = own_load_mask(s, b)
    let tmp: i32 = entry_alloca_begin(s)
    own_emit_binding_type(s, b)
    format_into(s, "\n")
    entry_alloca_end(s)
    let v: i32 = next_reg(s)
    if b.count > 0
        # An array of the binding's struct: not a `%T` value, so not a copy.
        format_into(s, "  %.{v} = load ")
        own_emit_binding_type(s, b)
        format_into(s, ", ptr %.{b.slot}\n")
        format_into(s, "  store ")
        own_emit_binding_type(s, b)
        format_into(s, " %.{v}, ptr %.{tmp}\n")
    else
        emit_struct_load_or_defer(s, TypeKind.Struct, v, own_binding_type(b), b.slot, null, 0)
        emit_struct_store_or_copy(s, TypeKind.Struct, own_binding_type(b), v, tmp)
    *out_old = tmp
    *out_flag = f
    let h: *OwnBinding = malloc(sizeof(OwnBinding)) as *OwnBinding
    own_copy_binding(h, b)
    h.aux = m
    h.old_field = null
    h

# The field `fname` of the struct `tname` at `base`: a pointer to it (and
# the field in *out_f), or 0.
fn own_field_ptr(s: *EmitterState, base: i32, tname: StrView, fname: StrView, out_f: **StructField) -> i32
    let st: *StructDef = find_struct(s, tname)
    if st == null
        return 0
    let idx: i32 = find_field_index(st, fname)
    if idx < 0
        return 0
    let f: *StructField = get_field_type(st, idx)
    let r: i32 = own_field_gep(s, base, st, idx)
    *out_f = f
    r

# A member path `x.f...` rooted at a single-value binding x (*out_b): a
# pointer to its field (*out_f), or 0.
fn own_place_ptr(s: *EmitterState, e: *Expr, out_f: **StructField, out_b: **OwnBinding) -> i32
    if e == null or e.kind != ExprKind.Member or e.left == null
        return 0
    let l: *Expr = e.left
    if l.kind == ExprKind.Ident
        let b: *OwnBinding = own_lookup(s, own_ident(l))
        if b == null or b.count > 0
            return 0
        *out_b = b
        return own_field_ptr(s, b.slot, own_binding_type(b), own_ident(e), out_f)
    var pf: *StructField = null
    let base: i32 = own_place_ptr(s, l, @pf, out_b)
    if base == 0 or pf.field_type != TypeKind.Struct
        return 0
    own_field_ptr(s, base, own_field_type(pf), own_ident(e), out_f)

# AGAST #2173: before the field store `x.f... = v` (own_stmt_moves found
# x owns its old value on the i1 `cond`): copy the old value aside.  The
# handle (x's binding, with old_field set) is for own_assign_end.
fn own_field_store_begin(s: *EmitterState, stmt: *Stmt, cond: i32, out_old: *i32, out_flag: *i32) -> *OwnBinding
    var f: *StructField = null
    var b: *OwnBinding = null
    var ptr: i32 = 0
    match stmt.kind
        StmtKind.LocalFieldAssign =>
            b = own_lookup(s, StrView { ptr: stmt.var_name, len: stmt.var_name_len as i64 })
            if b == null or b.count > 0
                return null
            let fname: StrView = StrView { ptr: stmt.assign_target, len: stmt.assign_target_len as i64 }
            ptr = own_field_ptr(s, b.slot, own_binding_type(b), fname, @f)
        StmtKind.Assign =>
            ptr = own_place_ptr(s, stmt.if_cond as *Expr, @f, @b)
        _ => pass   # own_stmt_moves sets fa_cond for these two only
    if ptr == 0 or f == null or b == null
        return null
    let tmp: i32 = entry_alloca_begin(s)
    emit_field_llvm_type(s, f)
    format_into(s, "\n")
    entry_alloca_end(s)
    let v: i32 = next_reg(s)
    if f.field_type != TypeKind.Struct
        format_into(s, "  %.{v} = load ")
        emit_field_llvm_type(s, f)
        format_into(s, ", ptr %.{ptr}\n")
        format_into(s, "  store ")
        emit_field_llvm_type(s, f)
        format_into(s, " %.{v}, ptr %.{tmp}\n")
    else
        emit_struct_load_or_defer(s, TypeKind.Struct, v, own_field_type(f), ptr, null, 0)
        emit_struct_store_or_copy(s, TypeKind.Struct, own_field_type(f), v, tmp)
    *out_old = tmp
    *out_flag = cond
    let h: *OwnBinding = malloc(sizeof(OwnBinding)) as *OwnBinding
    own_copy_binding(h, b)
    let o: *OwnState = s.own
    h.old_field = f
    h.old_path = o.fa_path
    h.aux = o.fa_mask
    h

# After the field store: drop the old value copied aside, if x owned it, and
# clear the stored path's moved bits.  Not before now: a `?` in the value
# leaves with the path still moved.  And whatever the check saw: a later move
# can reach this store round a loop.
fn own_field_store_end(s: *EmitterState, h: *OwnBinding, old: i32, cond: i32)
    let saved: i32 = last_expr_here(s)
    let next: i32 = own_if_open(s, cond)
    if h.old_path >= 0 and h.aux != 0 and own_has_parts(h, h.old_path)
        own_emit_masked_glue(s, old, h, h.old_path, h.aux)
    else
        own_emit_field_glue(s, old, h.old_field, 1)
    own_if_close(s, next)
    if h.old_path >= 0
        own_emit_mask_bits(s, h, own_path_at(h, h.old_path).down, false)
    if saved != 0
        set_last_expr(s, saved)
    free(h as *u8)

# After `x = v` is emitted: x owns v; drop the old value if x owned one.
# `h` is own_assign_begin's handle; x is looked up again by its storage, as
# emitting v may have moved the live list.
pub fn own_assign_end(s: *EmitterState, h: *OwnBinding, old: i32, old_flag: i32)
    if h == null
        return
    if h.old_field != null
        own_field_store_end(s, h, old, old_flag)
        return
    let o: *OwnState = s.own
    var b: *OwnBinding = h
    var i: i32 = o.live_count - 1
    while i >= 0
        let lb: *OwnBinding = own_live_at(o, i)
        if lb.slot == h.slot
            b = lb
            break
        i -= 1
    b.moved = 0
    own_store_flag(s, b, true)
    own_clear_mask(s, b)
    let saved: i32 = last_expr_here(s)
    let next: i32 = own_if_open(s, old_flag)
    own_emit_binding_glue(s, h, old, h.aux)
    own_if_close(s, next)
    if saved != 0
        set_last_expr(s, saved)
    free(h as *u8)

# Match scrutinees (AGAST #2174).  A match moves its scrutinee (ritz0's
# rule), so the match owns that value: emit_match spills it, and
# own_match_begin registers the spill as a nameless binding in a scope of
# its own.  An arm whose pattern binds a move-only payload (`Full(t)`)
# hands it to the binding (own_match_payload: the binding is owned and
# drops at the arm's end unless moved; the scrutinee's flag is cleared on
# that path); any other arm leaves it to the scrutinee, which
# own_match_end drops after the arms meet.  A borrowed scrutinee (`match
# @s`), or one read through a pointer, moves nothing and owns nothing; its
# move-only payload bindings are lent and can't move (AGAST #2178, checked
# by own_check.ritz on Sema).

# True when the move check just moved `e`, a match scrutinee, by value.
fn own_scrutinee_moved(s: *EmitterState, e: *Expr) -> bool
    if not own_checking(s)
        return false
    match e.kind
        ExprKind.Ident =>
            let b: *OwnBinding = own_lookup(s, own_ident(e))
            b != null and b.count == 0 and b.moved == 1
        ExprKind.Call =>
            not own_call_ret_type(s, e).is_empty() or match_scrutinee_builds(s, e) == 1   # AGAST #2419
        ExprKind.Method =>
            match_scrutinee_builds(s, e) == 1
        ExprKind.Member =>
            let mp: OwnMember = own_member_path(s, e)
            mp.fld != null and unnamed(mp.drop) and own_field_move_only(s, mp.fld, 0)
        ExprKind.Unset | ExprKind.IntLit | ExprKind.StringLit | ExprKind.NilLit | ExprKind.Binary | ExprKind.Unary | ExprKind.Cast | ExprKind.Index | ExprKind.StructLit | ExprKind.CharLit | ExprKind.Range | ExprKind.ArrayLit | ExprKind.CstringLit | ExprKind.Match | ExprKind.Try | ExprKind.FloatLit | ExprKind.ArrayFill | ExprKind.If | ExprKind.TypeOperand | ExprKind.Await =>
            false

# Before a match's arms: `slot` holds the spilled scrutinee `e` of enum
# type `name`.  Returns the state for own_match_end.
pub fn own_match_begin(s: *EmitterState, e: *Expr, slot: i32, name: StrView) -> i32
    let o: *OwnState = s.own
    let old: i32 = o.match_scrut
    o.match_scrut = 0 - 1
    if e == null or slot == 0 or name.ptr == null or name.len <= 0
        return old
    if not own_type_is_move_only(s, name) or not own_scrutinee_moved(s, e)
        return old
    own_push_scope(s)
    let flag: i32 = own_entry_alloca(s, "i1", "drop flag (match scrutinee)")
    own_grow_live(o)
    let b: *OwnBinding = own_live_at(o, o.live_count)
    own_init_binding(o, b, slot, flag, name, 0)
    o.match_scrut = o.live_count
    o.live_count = o.live_count + 1
    own_store_flag(s, b, true)
    old

# An arm bound the local `name` to a copy of the payload: when the match
# owns its scrutinee and the payload is move-only, the binding owns it now.
# When the match owns nothing, the binding is lent and owns nothing (AGAST
# #2178, Rust's E0507).
pub fn own_match_payload(s: *EmitterState, name: StrView)
    let o: *OwnState = s.own
    if o.match_scrut < 0
        return
    let idx: i32 = find_local_idx(s, name)
    if idx < 0
        return
    let n: i32 = o.live_count
    own_register(s, idx, true)
    if o.live_count > n
        own_store_flag(s, own_live_at(o, o.match_scrut), false)

# After the arms have met (and the result phi is emitted): drop the
# scrutinee where no arm took it, and restore the enclosing match's state.
pub fn own_match_end(s: *EmitterState, old: i32)
    let o: *OwnState = s.own
    if o.match_scrut >= 0
        own_pop_scope(s)
    o.match_scrut = old

# =============================================================================
# Before every `ret`: drop what is live (AGAST #3508)
# =============================================================================
#
# The IR sink calls own_before_ret as a `ret` starts.  Every binding and
# temporary still live there drops, newest first by OwnBinding.seq; a
# binding whose block already ended was dropped there (or moved), and one
# declared later isn't reached, so neither is in `live`.  These are the
# drops the pre-#3508 body pass inserted before every `ret` of the finished
# body until #3508, for every binding of the fn; the ones it no longer emits
# found a cleared flag (or one zeroed in the entry block, which no flag needs
# now).

# `if flag { flag = 0; glue(b) }` before a `ret`.  Its blocks are named
# `own.d<n>` / `own.n<n>`, not by next_label, as when the pre-#3508 pass
# emitted them: nothing follows a `ret` in its block, so they need not be the
# current one.
fn own_emit_ret_drop(s: *EmitterState, b: *OwnBinding)
    let o: *OwnState = s.own
    let seq: i32 = o.ret_seq
    o.ret_seq = o.ret_seq + 1
    let f: i32 = own_load_flag(s, b)
    format_into(s, "  br i1 %.{f}, label %own.d{seq}, label %own.n{seq}\n")
    format_into(s, "own.d{seq}:\n")
    format_into(s, "  store i1 0, ptr %.{b.flag}\n")
    own_emit_binding_glue(s, b, b.slot, own_load_mask(s, b))
    format_into(s, "  br label %own.n{seq}\n")
    format_into(s, "own.n{seq}:\n")

# The live bindings and temporaries, newest first.
fn own_emit_ret_drops(s: *EmitterState)
    let o: *OwnState = s.own
    var i: i32 = o.live_count - 1
    var t: i32 = o.temp_count - 1
    while i >= 0 or t >= 0
        let take_temp: bool = i < 0 or (t >= 0 and own_temp_at(o, t).seq > own_live_at(o, i).seq)
        if take_temp
            own_emit_ret_drop(s, own_temp_at(o, t))
            t -= 1
        else
            own_emit_ret_drop(s, own_live_at(o, i))
            i -= 1

# The module's functions are done: forget the last fn, so the module-level
# helper emitters can write their own `ret` (AGAST #4529).  The IR sink runs
# own_before_ret at every `ret`, but the sret copy/zero, print/format, test
# table and platform-hook helpers are emitted outside any fn body: without
# this reset the previous fn's live bindings would drop inside a helper and
# refer to registers that do not exist there (`use of undefined value
# '%.146'` in @__ritz_sret_copy).  own_begin_fn resets the same state at each
# fn's start, so no reset is needed per fn.
pub fn own_reset(s: *EmitterState)
    let o: *OwnState = s.own
    o.scope_count = 0
    o.live_count = 0
    o.loop_base = -1
    o.temp_expr_count = 0
    o.temp_count = 0
    o.temp_last_reg = 0   # registers restart per function
    o.loop_depth = 0
    o.defer_count = 0
    o.seq_next = 0

# =============================================================================
# `defer` (LANGUAGE_SPEC §13.7, LARB R14, AGAST #1625)
# =============================================================================
#
# Nothing is emitted at a `defer`: own_defer registers it in the innermost
# block, at the current end of `live`.  Every exit of that block then emits
# the statement in place, through emit_stmt, as if it were written there --
# so it reads its names' values at exit, and the move check sees it at
# each exit.  A block's deferred statements and its bindings' drops run
# together, newest first (own_unwind):
#   - falling off the end: own_pop_scope (after the arm's value);
#   - `break` / `continue`: own_loop_jump, for the blocks inside the loop;
#   - `return`, `?` and a fn's tail: own_before_ret, before every `ret`
#     (the IR sink spots it, once the value is computed), for every block.
# A `defer` that isn't reached registers nothing, since the emitter only
# reaches it on the paths that do.  A deferred statement may move a binding:
# its flag clears, so the drop that follows it is skipped at run time.

fn own_grow_defers(o: *OwnState)
    if o.defer_count < o.defer_cap
        return
    let cap: i32 = o.defer_cap * 2
    o.defer_stmts = realloc(o.defer_stmts as *u8, (cap as i64) * 8) as **Stmt
    o.defer_pos = realloc(o.defer_pos as *u8, (cap as i64) * 4) as *i32
    o.defer_tpos = realloc(o.defer_tpos as *u8, (cap as i64) * 4) as *i32
    o.defer_ret = realloc(o.defer_ret as *u8, (cap as i64) * sizeof(TypeKind)) as *TypeKind
    o.defer_cap = cap

# Emit deferred statement `j` here.  Its statements are a block of their
# own, so a `defer` inside it belongs to it.  The value the enclosing block
# was producing (an `if` arm's) still stands afterwards.
fn own_run_defer(s: *EmitterState, j: i32)
    let o: *OwnState = s.own
    let ds: **Stmt = o.defer_stmts
    let d: *Stmt = ds[j]
    let rets: *TypeKind = o.defer_ret
    let ret_type: TypeKind = rets[j]
    let saved: i32 = last_expr_here(s)
    let saved_ctx: *u8 = s.ctx_enum_name
    let saved_ctx_len: i32 = s.ctx_enum_name_len
    own_push_scope(s)
    # emit_stmt, through EmitterState (AGAST #3508: no emitter_stmt import).
    let run: fn(*EmitterState, *Stmt, TypeKind) = s.own_emit_stmt
    var st: *Stmt = d.while_body
    while st != null
        run(s, st, ret_type)
        st = st.next
    own_pop_scope(s)
    s.ctx_enum_name = saved_ctx
    s.ctx_enum_name_len = saved_ctx_len
    if saved != 0
        set_last_expr(s, saved)

# Leave the blocks holding live[from..] and defers[dfrom..]: each binding's
# drop and each deferred statement, in reverse order of where they appear.
# A deferred statement reached after binding i (defer_pos > i) runs first.
fn own_unwind(s: *EmitterState, from: i32, dfrom: i32)
    let o: *OwnState = s.own
    if o.defer_count <= dfrom
        own_drop_from(s, from)
        return
    var i: i32 = o.live_count - 1
    var j: i32 = o.defer_count - 1
    while i >= from or j >= dfrom
        # Read each time: a deferred statement's own `defer` may grow it.
        let pos: *i32 = o.defer_pos
        if j >= dfrom and (i < from or pos[j] > i)
            own_run_defer(s, j)
            j -= 1
        else
            own_emit_drop(s, own_live_at(o, i))
            i -= 1

# A `break` / `continue` leaving the loop body (AGAST #4387): as own_unwind,
# but the pending temporaries temps[tfrom..] drop with the bindings, newest
# first by seq, so the arm binding `t` drops before the statement's older
# temporary (§13.6's innermost-first rule).  A deferred statement runs before
# a temporary when it was registered after it (defer_tpos), as it does for a
# binding (defer_pos).
fn own_unwind_loop(s: *EmitterState, from: i32, dfrom: i32, tfrom: i32)
    let o: *OwnState = s.own
    var i: i32 = o.live_count - 1
    var t: i32 = o.temp_count - 1
    var j: i32 = o.defer_count - 1
    while i >= from or t >= tfrom or j >= dfrom
        # Deferred statement j runs first when it was registered after both
        # the binding and the temporary still to drop.  Read each time: a
        # deferred statement's own `defer` may grow them.
        var run: bool = false
        if j >= dfrom
            let pos: *i32 = o.defer_pos
            let tpos: *i32 = o.defer_tpos
            run = (i < from or pos[j] > i) and (t < tfrom or tpos[j] > t)
        if run
            own_run_defer(s, j)
            j -= 1
            # The deferred statements may have consumed (lent) a temporary.
            if t >= o.temp_count
                t = o.temp_count - 1
        else if t >= tfrom and (i < from or own_temp_at(o, t).seq > own_live_at(o, i).seq)
            own_emit_drop(s, own_temp_at(o, t))
            t -= 1
        else
            own_emit_drop(s, own_live_at(o, i))
            i -= 1

# Called by the IR sink as a `ret` starts: every block is being left.  With
# a `defer` registered, run them all, innermost first, with the drops they
# interleave with; the live temporaries (the `return` / `?` / tail
# expression's) drop first, as ritz0 drops the statement's temp frames
# before its defers (AGAST #2810, §13.6 then §13.7).  Otherwise drop what is
# live, newest first (own_emit_ret_drops, AGAST #3508).  What follows a
# `ret` is unreachable from it, so the moves don't stay.
pub fn own_before_ret(s: *EmitterState)
    let o: *OwnState = s.own
    if o.in_ret != 0
        return
    if o.live_count == 0 and o.temp_count == 0 and o.defer_count == 0
        return
    if own_scope_is_dead(o)
        return
    o.in_ret = 1
    if o.defer_count == 0
        own_emit_ret_drops(s)
    else
        var t: i32 = o.temp_count - 1
        while t >= 0
            own_emit_drop(s, own_temp_at(o, t))
            t -= 1
        own_unwind(s, 0, 0)
    o.in_ret = 0

# A StmtKind.Defer is reached: register it with the innermost block.
pub fn own_defer(s: *EmitterState, d: *Stmt, ret_type: TypeKind)
    let o: *OwnState = s.own
    if own_scope_is_dead(o)
        return
    own_grow_defers(o)
    let ds: **Stmt = o.defer_stmts
    let pos: *i32 = o.defer_pos
    let tpos: *i32 = o.defer_tpos
    let rets: *TypeKind = o.defer_ret
    ds[o.defer_count] = d
    pos[o.defer_count] = o.live_count
    tpos[o.defer_count] = o.temp_count
    rets[o.defer_count] = ret_type
    o.defer_count = o.defer_count + 1
