# call_check.ritz - a call's arguments fit its callee (AGAST #1629), on Sema
#
# ritz0 refuses a call with the wrong number of arguments, and one whose
# argument is of another kind than its parameter, at the call.  ritz1 took the
# first silently and turned the second into IR clang refused, pointing at the
# generated .ll.  The shared table is ritz0/test_call_arity_and_type.py.
#
#   known   "Unknown function: f", at the call (AGAST #3255)
#   arity   "`f` called with N argument(s) but defined with M", at the call
#   kind    "argument N of `f` has the wrong type: ...", at the argument
#           (a nameless callee is `<expression>`, as in ritz0; #3348)
#   private "`f` is private to a.ritz; mark it `pub` (#3413)", at the call, and
#           a note at the declaration (AGAST #3419, LARB R45a; ritz0's #3418)
#   points  "argument N of `f` has the wrong type: T* != S*" / an array's
#           mismatch, at the call (AGAST #4173; "What an argument points at")
#   borrow  "argument N of `f` has the wrong type: a `:&` parameter ...", at
#           the argument (AGAST #2335, #4244; "A bare argument to a `:&` param")
#
# AGAST #3503 (#1816): these run on Sema, from sema_walk at each call, not in
# the emitter.  A refused call stops the compile before emission, so the
# emitter only lowers calls whose callee is known and whose arguments fit.
# Sema resolves each call's callee the way emit_expr_call and
# emit_expr_method dispatch it: the builtins and variant constructors they
# lower inline are no calls here, a local holding a fn value is called
# through its signature, and a method goes to its receiver type's UFCS
# helper, else its impl method, else a specialised generic impl method.
#
# A method call counts as `m(r, ..)`, its receiver argument 1, as ritz0 does
# (#3319); a static call has no receiver.
#
# ritz0 spells the rest of a kind error in llvmlite's types; ritz1 names the
# parameter and what it got.  The kind rule is only what is wrong whatever the
# compiler makes of it, and is silent when Sema can't tell (BK_UNSURE):
#
#   a by-value struct param   gets an integer (LARB R47, §9.2: even into a
#                             single-field struct, where a method or UFCS
#                             call used to box it; cc_sure_int, and
#                             cc_boxed for what it can't vouch for,
#                             R47b), a `bool`, a float, `null`, a
#                             c-string, or a pointer to something
#                             else (one to the same struct is ref_check's
#                             "doesn't fit a by-value slot")
#   an int, float or bool     gets a struct value
#   a `*Q` param              gets a struct value of another type than Q
#                             (#3340); one of Q is ref_check's "doesn't fit a
#                             reference slot", as is anything into an `@Q`
#
# An enum into an integer param is enum_as_int's, which runs on free, method
# and static calls alike.
#
# A pointer into an integer is left alone: it's a ptrtoint.  So is a
# `Span<T>` param given `@a` or `@v`, and a StrView given a pointer
# to an array (#3335): those are coercions.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io

import ast
import types
import diag          # the error prefix (AGAST #3445)
import ast_helpers
import interp        # interp_parse_expr: Sema parses print placeholders (AGAST #4697)
import interp_text   # interp_lit_has_placeholder (AGAST #4381), interp_split_literal
import main_abi      # main_abi_call_msg (AGAST #4198)
import ast_query     # name_eq, eprint_bytes, mem_builtin_id, is_tagged_enum_type,
                     # LocalVar and the array-dims helpers, lent_self_call_view_in
                     # (AGAST #4391: was resolved through emitter_core / emitter_expr_call)
import sema
import sema_type
import bool_check    # BK_*, bk_of_type, sema_bool_kind and its sbk_* readers
import tail_value    # tail_note_callee (AGAST #3511)
import ref_check     # RefEnv, ref_local_in, rs_field (AGAST #4173)
import field_slot    # eprint_source_type
import ritzlib.memory
import ritzlib.str
import ritzlib.strview
import ritzlib.fs { path_basename }
import ritzlib.option   # interp_split_literal, interp_parsed_at (AGAST #4697)

# >0 inside an operand emit_expr_call never lowers (`sizeof(x)`, a
# non-literal `print(x)`): its calls aren't judged.
var g_cc_mute: i32 = 0

# 1 when `e`'s arguments are never lowered, so their calls aren't judged.
pub fn call_check_mutes(e: *Expr) -> i32
    if e.kind != ExprKind.Call or e.func_name.len == 0
        return 0
    if name_eq(e.func_name, "sizeof") == 1
        return 1
    if name_eq(e.func_name, "print") == 0 and name_eq(e.func_name, "eprint") == 0
        return 0
    if e.args == null
        return 0
    (e.args.kind != ExprKind.StringLit and e.args.kind != ExprKind.CstringLit) as i32

pub fn call_check_mute(delta: i32)
    g_cc_mute = g_cc_mute + delta

# 1 inside `sizeof(..)` / a non-literal `print(..)`: nothing there is lowered.
pub fn call_check_muted() -> i32
    (g_cc_mute > 0) as i32

# The last place reported, so a call judged twice is said once.
var g_cc_fn: *FnDef = null
var g_cc_line: i32 = 0
var g_cc_col: i32 = 0

# `path:line:col: error: ` the first time this place is reported, counting the
# error; 0 when it was said already.
fn cc_report(sm: *Sema, line: i32, col: i32) -> i32
    let f: *FnDef = sm.cur_fn
    if g_cc_fn == f and g_cc_line == line and g_cc_col == col
        return 0
    g_cc_fn = f
    g_cc_line = line
    g_cc_col = col
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm), diag_span(line, col))
    1

fn cc_count_params(p: *Param) -> i32
    var n: i32 = 0
    var q: *Param = p
    while q != null
        n = n + 1
        q = q.next
    n

fn cc_count_args(a: *Expr) -> i32
    var n: i32 = 0
    var x: *Expr = a
    while x != null
        n = n + 1
        x = x.next
    n

# AGAST #3419 (LARB R45a, LANGUAGE_SPEC §15.2): a call to `fd`, declared
# without `pub` in another file, refused at line:col as ritz0 refuses it
# (#3418), with a note at the declaration: a basename alone is ambiguous
# across packages.  `owner` is the impl's type for a method (`P.get`), null
# for a free call (`helper`, the mangled `P_get`).  1 when refused.
#
# The caller's file is the walked fn's: an instance of another file's
# generic carries that file (specialize copies def_file), so its calls are
# that file's own.  Not checked, as in ritz0: an `extern fn` (no body) and a
# written `fn .. = extern` (extern_decl: a symbol defined elsewhere; an
# import's stripped bodies are checked), monomorph instances (is_pub,
# set by specialize), a generated `E.from`, and a fn whose file isn't known.
fn cc_private(sm: *Sema, line: i32, col: i32, owner: *ImplBlock, name_sv: StrView, fd: *FnDef) -> i32
    if fd == null or fd.is_pub == 1 or fd.body == null or fd.extern_decl == 1
        return 0
    if fd.from_generated == 1 or fd.def_file.len == 0
        return 0
    var here: StrView = strview_empty()
    if sm.cur_fn != null
        here = sm.cur_fn.def_file
    if here.len == 0
        here = sm.file
    if here.len == 0 or here.eq(fd.def_file)
        return 0
    if cc_report(sm, line, col) == 1
        for round in 0..2
            if round == 1
                eprints(fd.def_file)
                eprint_char(':')
                eprint_int(fd.line as i64)
                eprint_char(':')
                eprint("{fd.col as i64}: note: ")
            eprint_char('`')
            if owner != null
                eprint_bytes(owner.type_name)
                eprint_char('.')
            eprint_bytes(name_sv)
            if round == 0
                eprints("` is private to ")
                eprints(path_basename(fd.def_file))
                eprints("; mark it `pub` (#3413)\n")
            else
                eprints("` is declared here\n")
    1

# A call to `name` that no declared, imported or `extern` fn answers,
# refused at the call as ritz0 says it.  ritz1 used to declare `@name(...)`
# and leave it to the no-libc link, whose "undefined reference" names no
# line.  `syscallN` and `cpuid_raw` are no exception: they are ordinary fns
# (ritzlib.sys, cryptosec.cpuid; #3397).  A generic call `nope<i64>(x)` is
# named without its `$i64` (#3667).
fn cc_unknown(sm: *Sema, e: *Expr)
    if cc_report(sm, e.span.line, e.span.col) == 1
        # AGAST #3934: `heap e` calls ritzlib.memory's __heap_new, as
        # ritz0's needs its malloc, and is refused in ritz0's words.
        if is_heap_new(e.func_name) == 1
            eprints("heap requires ritzlib.memory (malloc not found)\n")
            return
        eprints("Unknown function: ")
        eprint_bytes(e.func_name)
        eprint_char('\n')

# `name(args)`, a call to `fd`, reported at line:col in ritz0's words: a
# private fn of another file (#3419), else the argument count.  1 when
# refused, so the caller doesn't pair the arguments up.
fn cc_arity(sm: *Sema, line: i32, col: i32, name_sv: StrView, fd: *FnDef, args: *Expr) -> i32
    if cc_private(sm, line, col, null, name_sv, fd) == 1
        return 1
    let m: i32 = cc_count_params(fd.params)
    let n: i32 = cc_count_args(args)
    if m == n
        return 0
    if cc_report(sm, line, col) == 1
        eprint_char('`')
        eprint_bytes(name_sv)
        eprint("` called with {n as i64} argument(s) but defined with {m as i64}")
        eprint_char('\n')
    1

fn cc_int_type(t: TypeKind) -> i32
    return (ty_is_int(t) == 1) as i32

# The `name:& T` param `e` names, the emitter's lent_local (LocalVar.is_lent,
# AGAST #2250): a `:&` param of an integer, struct or array T.  Null else.
fn cc_lent(sm: *Sema, e: *Expr) -> *Param
    if e == null or e.kind != ExprKind.Ident
        return null
    let v: *SemaVar = sema_find_local(sm, e.ident)
    if v == null or v.lent == null
        return null
    let p: *Param = v.lent
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return null
    let pt: TypeKind = p.param_pointee_type
    if pt != TypeKind.Struct and pt != TypeKind.Array and is_borrow_scalar_kind(pt) == 0
        return null
    p

# The `h:& T` param `e` names when T is an integer or `bool` (AGAST #2972):
# `*h` is `h`.  The emitter's lent_scalar_ident.
fn cc_lent_scalar(sm: *Sema, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Ident
        return 0
    let v: *SemaVar = sema_find_local(sm, e.ident)
    if v == null or v.lent == null
        return 0
    let p: *Param = v.lent
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return 0
    (p.param_pointee_type == TypeKind.Bool or is_borrow_scalar_kind(p.param_pointee_type) == 1) as i32

# The struct a `:&` param `e` borrows, or an empty view: `c:& C` (lent_struct_local).
fn cc_lent_struct(sm: *Sema, e: *Expr) -> StrView
    let p: *Param = cc_lent(sm, e)
    if p == null or p.param_pointee_type != TypeKind.Struct
        return strview_empty()
    p.param_type_name

# 1 if `p` surely points at an integer: a pointer or borrow local to one, a
# `*i64` field, or either plus an offset (`p + i`).
fn cc_int_pointer(sm: *Sema, p: *Expr) -> i32
    match p.kind
        ExprKind.Ident =>
            if cc_lent_scalar(sm, p) == 1
                return 1
            let v: *SemaVar = sema_find_local(sm, p.ident)
            if v != null and v.kind != TypeKind.Array
                if v.kind != TypeKind.Ptr and v.kind != TypeKind.Ref and v.kind != TypeKind.MutRef
                    return 0
                return cc_int_type(v.pointee)
            return 0
        ExprKind.Member =>
            let f: *StructField = sbk_member_field(sm, p)
            if f != null and f.field_type == TypeKind.Ptr
                return cc_int_type(f.array_elem_type)
            return 0
        _ => pass
    if p.kind == ExprKind.Binary and (p.op == OpKind.Add or p.op == OpKind.Sub)
        return cc_int_pointer(sm, p.left)
    0

# 1 if `a`, which sema_bool_kind calls BK_INT, surely is an integer: a
# literal, a cast, a name, a call or method whose callee it resolved, `*p` of
# an integer pointer or borrow, a member read, an element of a name or field
# whose element type is known, and arithmetic or `-` / `~` of these (LARB
# R47b, #3420).
fn cc_sure_int(sm: *Sema, a: *Expr) -> i32
    let k: ExprKind = a.kind
    match k
        ExprKind.IntLit | ExprKind.CharLit | ExprKind.Cast | ExprKind.Ident =>
            return 1
        ExprKind.Call | ExprKind.Method | ExprKind.Member =>
            return 1
        ExprKind.Binary =>
            return (sema_bool_kind(sm, a.left) == BK_INT and cc_sure_int(sm, a.left) == 1 and sema_bool_kind(sm, a.right) == BK_INT and cc_sure_int(sm, a.right) == 1) as i32
        _ => pass
    if k == ExprKind.Unary and (a.op == OpKind.Neg or a.op == OpKind.BitNot)
        return cc_sure_int(sm, a.operand)
    if k == ExprKind.Unary and a.op == OpKind.Deref and a.operand != null
        return cc_int_pointer(sm, a.operand)
    if k == ExprKind.Index and a.left != null
        let base: *Expr = a.left
        if base.kind == ExprKind.Ident
            return (sbk_element(sm, base.ident) == BK_INT) as i32
        if base.kind == ExprKind.Member
            let f: *StructField = sbk_member_field(sm, base)
            if f != null and f.field_type == TypeKind.Array
                return cc_int_type(f.array_elem_type)
    0

# The struct argument `a` statically points at, or an empty view (the
# emitter's arg_pointee_struct, AGAST #1948): `@x` / `@&x` of a struct local,
# a `:&` struct param or a struct field; `x` a local `*T` / `@T` / `@&T`, T a
# struct.  Anything else is empty: it fails open on shapes it cannot type.
fn cc_pointee_struct(sm: *Sema, a: *Expr) -> StrView
    var name: StrView = strview_empty()
    if a.kind == ExprKind.Unary and (a.op == OpKind.Addr or a.op == OpKind.AddrMut)
        let x: *Expr = a.operand
        if x == null
            return strview_empty()
        match x.kind
            ExprKind.Ident =>
                let v: *SemaVar = sema_find_local(sm, x.ident)
                if v == null
                    return strview_empty()
                if v.kind == TypeKind.Struct
                    name = v.type_name
                else
                    let lent: StrView = cc_lent_struct(sm, x)
                    name = lent
            ExprKind.Member =>
                let f: *StructField = sbk_member_field(sm, x)
                if f == null or f.field_type != TypeKind.Struct
                    return strview_empty()
                name = f.field_type_name
            _ =>
                return strview_empty()
    else if a.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, a.ident)
        if v == null or v.lent != null
            return strview_empty()
        if v.kind != TypeKind.Ptr and v.kind != TypeKind.Ref and v.kind != TypeKind.MutRef
            return strview_empty()
        if v.pointee != TypeKind.Struct
            return strview_empty()
        name = v.type_name
    else
        return strview_empty()
    if name.ptr == null or name.len <= 0 or sema_find_struct(sm, name) == null
        return strview_empty()
    name

# What `a` is when it can't be the by-value struct `want`, in words; an empty
# view when it can be, or Sema can't tell.
fn cc_not_a_struct(sm: *Sema, a: *Expr, want_sv: StrView) -> StrView
    var want_len: i32 = want_sv.len as i32
    match a.kind
        ExprKind.NilLit =>
            return "`null`"
        ExprKind.CstringLit =>
            return "a `*u8`"
        _ => pass
    let k: i32 = sema_bool_kind(sm, a)
    if k == BK_FLOAT
        return "a float"
    # Nothing converts to a struct, not even a single-field one (LARB R47,
    # §9.2, #3390).
    if k == BK_INT and cc_sure_int(sm, a) == 1
        return "an integer"
    # Nor any other scalar (LARB R47b, #3420): a bool says so whatever its form.
    if k == BK_BOOL
        return "a `bool`"
    if k != BK_PTR
        return strview_empty()
    # A Span is built from `@a` / `@v` (coerce_array_to_span).
    if want_len > 5 and want_sv.starts_with("Span$")
        return strview_empty()
    # A `c:& C` local reads as the C it borrows (#2250): another struct than
    # `want` is let_check's (#3294).
    if cc_lent(sm, a) != null
        return strview_empty()
    let pointee: StrView = cc_pointee_struct(sm, a)
    if pointee.ptr != null
        if name_eq(pointee, want_sv) == 1
            return strview_empty()   # ref_check's "doesn't fit a by-value slot"
        return "a pointer"
    # A local `*u8` / `*i32` ...: a pointer to no struct at all.  A `*[N]u8`
    # makes a StrView in ritz0, so a pointer to an array isn't judged.
    if a.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, a.ident)
        if v != null and v.lent == null and v.kind == TypeKind.Ptr and v.pointee != TypeKind.Struct and v.pointee != TypeKind.Void and v.pointee != TypeKind.Array and v.pointee != TypeKind.Unknown
            return "a pointer"
    strview_empty()

# The known struct `a` is a value of, or an empty view.
fn cc_struct_value(sm: *Sema, a: *Expr) -> StrView
    var name: StrView = strview_empty()
    # A `c:& C` param is a TypeKind.MutRef local naming its referent (#2250).
    let lent: *Param = cc_lent(sm, a)
    if lent != null
        if lent.param_pointee_type != TypeKind.Struct
            return strview_empty()
        name = lent.param_type_name
    else if a.kind == ExprKind.StringLit
        # A bare literal lowers to a %Span$u8 (AGAST #98), and is named so.
        return "Span$u8"
    else if sema_bool_kind(sm, a) == BK_OTHER
        sbk_receiver(sm, a, @name)
    if name.ptr == null or name.len <= 0 or sema_find_struct(sm, name) == null
        return strview_empty()
    name

fn cc_kind_error(sm: *Sema, a: *Expr, fname_sv: StrView, argno: i32, p: *Param) -> i32
    if cc_report(sm, a.span.line, a.span.col) == 0
        return 0
    eprint("argument {argno as i64} of `")
    eprint_bytes(fname_sv)
    eprints("` has the wrong type: parameter ")
    # A `fn(..)` type names no params (#3348): number the one it missed.
    if p.name.len > 0
        eprint_char('`')
        eprint_bytes(p.name)
        eprint_char('`')
    else
        eprint_int(argno as i64)
    eprints(" is declared `")
    match p.param_type
        TypeKind.Ptr =>
            eprint_char('*')
            eprint_bytes(p.param_type_name)
        TypeKind.Struct =>
            eprint_bytes(p.param_type_name)
        _ =>
            eprints_cstr(primitive_name_from_type(p.param_type))
    eprints("` but its argument is ")
    1

# Argument `argno` of `fname`, `a`, for param `p`: slot_kind_fit's rule.  An
# argument is refused here for a struct on either side; with `num` 1 (a call
# of a named fn: ritz0 judges no method's argument) a float, `null` or pointer
# into an integer param, or a narrow integer into a pointer one (SKF_NUM),
# too, in ritz0's typing pass's words (AGAST #4680).
fn cc_kind(sm: *Sema, fname_sv: StrView, argno: i32, a: *Expr, p: *Param, num: i32)
    if a == null or p == null or p.is_borrow == 1
        return
    var fit: SlotFit
    let pname: StrView = p.param_type_name
    let k: i32 = slot_kind_fit(sm, a, p.param_type, pname, p.param_pointee_type, 0, @fit)
    if k == SKF_NUM and num == 1
        cc_num_error(sm, a, argno, p, @fit)
        return
    if k != SKF_AGG
        return
    if fit.slot_class == SKS_STRUCT
        if cc_kind_error(sm, a, fname_sv, argno, p) == 1
            eprints(cc_not_a_struct(sm, a, p.param_type_name))
            eprint_char('\n')
        return
    if fit.value_class == SKV_STRUCT and cc_kind_error(sm, a, fname_sv, argno, p) == 1
        eprints("a `")
        eprint_bytes(fit.name)
        eprints("`\n")

# --- One rule for a value's kind in its slot (AGAST #4653) ---------------------
#
# Every slot asks slot_kind_fit: a call's argument (cc_kind, above), and a
# `let` / `var`, an assignment, a struct-literal field, a `return` and a fn's
# tail (slot_kind.ritz, which says it in each site's words).  ritz0 has one
# rule too (type_queries.py's _types_compatible, let_rules.py).  A slot is a
# kind, the name a struct (or a pointer's struct pointee) has, and a pointer's
# pointee kind, read off whatever declared it.
#
#   slot              value refused                                 class
#   struct            an integer, float, `bool`, `null`, C string   SKF_AGG
#                     or pointer (cc_not_a_struct)
#   int/float/bool    a struct                                      SKF_AGG
#   int               a float or `null`; a pointer, but into an     SKF_NUM
#                     i64 / u64
#   pointer           a struct, but one of its own pointee          SKF_AGG
#                     (ref_check's) or a String / StrView into a
#                     `*u8` (literal_slot's); a float
#   pointer           an integer narrower than i64 / u64            SKF_NUM
#
# A struct of another struct is let_check's (another_struct_source), said
# in its words at a let, a store, a return and an argument; `other` 1 asks
# for it here too, for the arms of a fn's `if` / `match` tail, which
# let_check doesn't reach.  A value Sema can't type fits.

const SKF_FITS: i32 = 0
const SKF_AGG: i32 = 1    # a struct on one side, or a float / struct into a pointer
const SKF_NUM: i32 = 2    # scalar into scalar: ritz0's type checker's words

const SKS_NONE: i32 = 0
const SKS_STRUCT: i32 = 1
const SKS_INT: i32 = 2
const SKS_FLOAT: i32 = 3
const SKS_BOOL: i32 = 4
const SKS_PTR: i32 = 5

const SKV_NONE: i32 = 0
const SKV_STRUCT: i32 = 1
const SKV_INT: i32 = 2
const SKV_FLOAT: i32 = 3
const SKV_BOOL: i32 = 4
const SKV_NULL: i32 = 5
const SKV_PTR: i32 = 6

# What slot_kind_fit found: the slot's and value's classes, and the value's
# type as Ritz writes it: `name` is a struct's name, a pointer's pointee
# (`*` before it) or a scalar's.
pub struct SlotFit
    slot_class: i32
    value_class: i32
    name: StrView
    slot_pointee: TypeKind   # a pointer slot's pointee, TypeKind.Struct for a known struct
    value_pointee: TypeKind  # a pointer value's pointee

fn skf_named(out: *SlotFit, class: i32, name: StrView) -> i32
    out.value_class = class
    out.name = name
    class

# An integer kind's name, or an empty view for any other kind.
fn skf_int_name(t: TypeKind) -> StrView
    let n: *u8 = primitive_name_from_type(t)
    if ty_int_bits(t) == 0 or n == null
        return strview_empty()
    strview_from_cstr(n)

# The class of value `a`, its type's name into `out`.
fn skf_value(sm: *Sema, a: *Expr, out: *SlotFit) -> i32
    match a.kind
        ExprKind.NilLit =>
            return skf_named(out, SKV_NULL, "null")
        ExprKind.CstringLit =>
            return skf_named(out, SKV_PTR, "u8")
        ExprKind.StringLit | ExprKind.If | ExprKind.Match | ExprKind.ArrayLit | ExprKind.ArrayFill =>
            return SKV_NONE
        _ => pass
    # A `c:& C` param reads as the C it borrows (#2250).
    let lent: i32 = (cc_lent(sm, a) != null) as i32
    let bk: i32 = if lent == 1 then BK_OTHER else sema_bool_kind(sm, a)
    var t: SemaTy
    let k: TypeKind = sema_expr_ty(sm, a, @t)
    if bk == BK_FLOAT
        if k == TypeKind.F32
            return skf_named(out, SKV_FLOAT, "f32")
        return skf_named(out, SKV_FLOAT, "f64")
    if bk == BK_BOOL
        return skf_named(out, SKV_BOOL, "bool")
    if bk == BK_INT and cc_sure_int(sm, a) == 1
        var name: StrView = skf_int_name(k)
        if name.len == 0 and (a.kind == ExprKind.IntLit or a.kind == ExprKind.CharLit)
            name = "i64"
        if name.len == 0
            return SKV_NONE
        return skf_named(out, SKV_INT, name)
    if bk == BK_PTR
        if k != TypeKind.Ptr
            return SKV_NONE
        out.value_pointee = t.pointee
        if t.pointee == TypeKind.Struct
            if t.name.ptr == null or t.name.len <= 0
                return SKV_NONE
            out.value_class = SKV_PTR
            out.name = t.name
            return SKV_PTR
        let pn: *u8 = primitive_name_from_type(t.pointee)
        if pn == null or t.pointee == TypeKind.Void
            return SKV_NONE
        return skf_named(out, SKV_PTR, strview_from_cstr(pn))
    var sv: StrView = cc_struct_value(sm, a)
    if sv.ptr == null and a.kind == ExprKind.StructLit and a.ident.len > 0 and sema_find_struct(sm, a.ident) != null
        sv = a.ident
    if sv.ptr == null
        return SKV_NONE
    out.value_class = SKV_STRUCT
    out.name = sv
    SKV_STRUCT

fn skf_is_view(name_sv: StrView) -> i32
    (name_eq(name_sv, "StrView") == 1 or name_eq(name_sv, "Span$u8") == 1) as i32

# The class of a slot of kind `t`; a pointer's pointee into out.slot_pointee.
fn skf_slot(sm: *Sema, t: TypeKind, name_sv: StrView, pointee: TypeKind, out: *SlotFit) -> i32
    out.slot_pointee = pointee
    match t
        TypeKind.Struct =>
            if name_sv.ptr == null or name_sv.len <= 0 or sema_find_struct(sm, name_sv) == null
                return SKS_NONE
            return SKS_STRUCT
        TypeKind.Bool =>
            return SKS_BOOL
        TypeKind.F32 | TypeKind.F64 =>
            return SKS_FLOAT
        TypeKind.Ptr => pass
        _ =>
            if ty_int_bits(t) > 0
                return SKS_INT
            return SKS_NONE
    # `-> *T` keeps T's name, not its kind: a known struct is the pointee.
    if pointee != TypeKind.Struct and primitive_name_from_type(pointee) == null and name_sv.ptr != null and name_sv.len > 0 and sema_find_struct(sm, name_sv) != null
        out.slot_pointee = TypeKind.Struct
    if out.slot_pointee == TypeKind.Struct and (name_sv.ptr == null or name_sv.len <= 0 or sema_find_struct(sm, name_sv) == null)
        return SKS_NONE
    SKS_PTR

fn skf_wide_int(name: StrView) -> i32
    (name.eq("i64") or name.eq("u64")) as i32

# The enum a slot's type names: `Option$i32` is Option's.
fn skf_enum_base(slot: StrView) -> StrView
    var n: i64 = 0
    while n < slot.len and *(slot.ptr + n) != '$'
        n = n + 1
    slot.take(n)

# 1 if the enum slot `slot` declares variant `v`; 1 too for a slot that is no
# enum.  A built-in Option / Result declares its own variants whether or not
# ritzlib's enum is in scope.
fn skf_enum_declares(sm: *Sema, slot: StrView, v: StrView) -> i32
    let en: StrView = skf_enum_base(slot)
    if enum_find(sm.pctx, en) >= 0
        return (enum_variant_index(sm.pctx, en, v) >= 0) as i32
    if name_eq(en, "Option") == 1
        return (name_eq(v, "Some") == 1 or name_eq(v, "None") == 1) as i32
    if name_eq(en, "Result") == 1
        return (name_eq(v, "Ok") == 1 or name_eq(v, "Err") == 1) as i32
    1

# A bare unit variant of one enum in a slot of an enum that declares no such
# variant (`return Block` in a `-> Option<i32>` fn, `Block` Display's): ritz0's
# "Unknown variant Block in enum Option", at `Block`, in every slot (AGAST
# #4656).  The emitter built the other enum's variant into the slot.
fn skf_bare_variant(sm: *Sema, a: *Expr, slot: StrView) -> i32
    if g_cc_mute > 0 or a.kind != ExprKind.Ident or slot.ptr == null or slot.len <= 0
        return 0
    let v: StrView = a.ident
    if sema_is_local(sm, v) == 1 or sbk_const(sm, v) != null or sbk_global(sm, v) != null or sema_find_fn(sm, v) != null
        return 0
    var vi: i32 = 0 - 1
    var other: i32 = 0 - 1
    let ei: i32 = enum_of_variant_unique(sm.pctx, v, @vi, @other)
    if ei < 0 or enum_variant_kind(sm.pctx, ei, vi) != ENUM_VARIANT_UNIT or skf_enum_declares(sm, slot, v) == 1
        return 0
    if cc_report(sm, a.span.line, a.span.col) == 1
        eprints("Unknown variant ")
        eprint_bytes(v)
        eprints(" in enum ")
        eprint_bytes(skf_enum_base(slot))
        eprint_char('\n')
    1

# Does `a` fit a slot of kind `t` named `name` (a pointer's: its pointee's),
# pointing at `pointee`?  SKF_FITS, or the misfit's class with what was found
# in `out`.  `other` 1: a struct of another struct is judged here too.  A bare
# variant of another enum in an enum slot is said here, the same in every slot
# (skf_bare_variant), and then fits: the slot has nothing to add.
pub fn slot_kind_fit(sm: *Sema, a: *Expr, t: TypeKind, name_sv: StrView, pointee: TypeKind, other: i32, out: *SlotFit) -> i32
    out.slot_class = SKS_NONE
    out.value_class = SKV_NONE
    out.name = strview_empty()
    out.slot_pointee = pointee
    out.value_pointee = TypeKind.Void
    if a == null or skf_bare_variant(sm, a, name_sv) == 1
        return SKF_FITS
    let sc: i32 = skf_slot(sm, t, name_sv, pointee, out)
    out.slot_class = sc
    if sc == SKS_NONE
        return SKF_FITS
    if sc == SKS_STRUCT
        # A C-string literal into a StrView / `Span<u8>` is literal_slot's (#3440).
        if a.kind == ExprKind.CstringLit and skf_is_view(name_sv) == 1
            return SKF_FITS
        if cc_not_a_struct(sm, a, name_sv).ptr != null
            skf_value(sm, a, out)
            return SKF_AGG
        if other == 0 or a.kind == ExprKind.Cast or skf_value(sm, a, out) != SKV_STRUCT
            return SKF_FITS
        let vsv: StrView = out.name
        if name_eq(vsv, name_sv) == 1
            return SKF_FITS
        # A `Span<u8>` converts to a StrView (#168), not back (#3441).
        if name_eq(vsv, "Span$u8") == 1 and name_eq(name_sv, "StrView") == 1
            return SKF_FITS
        return SKF_AGG
    let vc: i32 = skf_value(sm, a, out)
    if vc == SKV_STRUCT
        if sc != SKS_PTR
            return SKF_AGG
        let vn: StrView = out.name
        # One of its own pointee is ref_check's ("a value doesn't fit a
        # reference slot"); a String / StrView into a `*u8` literal_slot's.
        if out.slot_pointee == TypeKind.Struct and name_eq(vn, name_sv) == 1
            return SKF_FITS
        if out.slot_pointee == TypeKind.U8 and (skf_is_view(vn) == 1 or name_eq(vn, "String") == 1)
            return SKF_FITS
        return SKF_AGG
    if sc == SKS_INT
        if vc == SKV_FLOAT or vc == SKV_NULL
            return SKF_NUM
        # A pointer to the slot's own type is ref_value's ("write `*`").
        if vc == SKV_PTR and out.value_pointee != t and ty_int_bits(t) != 64
            return SKF_NUM
        return SKF_FITS
    if sc == SKS_PTR
        if vc == SKV_FLOAT
            return SKF_AGG
        if vc == SKV_INT and skf_wide_int(out.name) == 0
            return SKF_NUM
    SKF_FITS

# How slot_kind_fit's two sides are spelled in a refusal: here, beside SlotFit,
# for cc_num_error and slot_kind.ritz's sites.
pub fn sk_eprint_kind(t: TypeKind)
    let n: *u8 = primitive_name_from_type(t)
    if n == null
        eprint_char('?')
    else
        eprints(strview_from_cstr(n))

# The slot's type, as its declaration wrote it.
pub fn sk_eprint_slot(t: TypeKind, name_sv: StrView, f: *SlotFit)
    if f.slot_class == SKS_STRUCT
        eprint_source_type(name_sv)
    else if f.slot_class == SKS_PTR
        eprint_char('*')
        if f.slot_pointee == TypeKind.Struct
            eprint_source_type(name_sv)
        else
            sk_eprint_kind(f.slot_pointee)
    else
        sk_eprint_kind(t)

# The value's type: a struct's name, a pointer's `*T`, a scalar's or `null`.
pub fn sk_eprint_value(f: *SlotFit)
    if f.value_class == SKV_PTR
        eprint_char('*')
    if f.name.ptr == null
        eprint_char('?')
    else
        eprint_source_type(f.name)

# A float, `null` or pointer argument for an integer param, or a narrow
# integer for a pointer one: ritz0's typing pass's words, at the argument.
fn cc_num_error(sm: *Sema, a: *Expr, argno: i32, p: *Param, fit: *SlotFit)
    if cc_report(sm, a.span.line, a.span.col) == 0
        return
    eprints("argument ")
    eprint_int(argno as i64)
    eprints(" ('")
    eprint_bytes(p.name)
    eprints("'): expected ")
    sk_eprint_slot(p.param_type, p.param_type_name, fit)
    eprints(", got ")
    sk_eprint_value(fit)
    eprint_char('\n')

# Each argument of `fname(args)` against `params`, numbered from `argno`.
fn cc_kinds(sm: *Sema, fname_sv: StrView, argno: i32, params: *Param, args: *Expr, num: i32)
    var p: *Param = params
    var a: *Expr = args
    var n: i32 = argno
    while p != null and a != null
        cc_kind(sm, fname_sv, n, a, p, num)
        p = p.next
        a = a.next
        n = n + 1

# --- The newtype box (LARB R47b, §9.2, #3420) -----------------------------------
#
# A method or UFCS call's arg cascade used to store an integer it found for a
# by-value struct param into the struct.  Nothing converts to a struct, so an
# integer there is refused, at the argument, whatever form cc_sure_int didn't
# vouch for: `a.add(i * 1)`.  Said once: rule A at the same place wins.

# A tagged or user enum, or `usize`, is never a scalar newtype.
fn cc_unboxed_name(ctx: *ParseCtx, name_sv: StrView) -> i32
    if is_tagged_enum_type(name_sv) == 1
        return 1
    if user_enum_index(ctx, name_sv) >= 0
        return 1
    (name_eq(name_sv, "usize") == 1 or name_eq(name_sv, "isize") == 1) as i32

# 1 if `a` already is a struct value, which the cascade passes as it is (the
# emitter's arg_is_struct_value): a struct literal (#1362), `*p` of a `*S` /
# `@S` / `@&S` (AGAST #2560), a call or method returning a struct (#2413,
# #3241), an element of a `[N]S` or a Vec<S> (#3420).
fn cc_struct_arg(sm: *Sema, a: *Expr) -> i32
    if a.kind == ExprKind.StructLit
        return 1
    var fd: *FnDef = null
    if a.kind == ExprKind.Call and a.func_name.len > 0
        fd = cc_named_fn(sm, a)
        let v: *SemaVar = sema_find_local(sm, a.func_name)
        if v != null
            fd = v.fn_sig
    else if a.kind == ExprKind.Method
        fd = sbk_method_def(sm, a)
    if fd != null
        return (fd.return_type == TypeKind.Struct and sema_find_struct(sm, fd.return_type_name) != null) as i32
    if (a.kind == ExprKind.Unary and a.op == OpKind.Deref) or a.kind == ExprKind.Index
        var name: StrView = strview_empty()
        sbk_receiver(sm, a, @name)
        return (name.ptr != null and name.len > 0 and sema_find_struct(sm, name) != null) as i32
    0

fn cc_boxed(sm: *Sema, e: *Expr, argno: i32, a: *Expr, p: *Param, span_ok: i32)
    if a == null or p == null or p.is_borrow == 1
        return
    if p.param_type != TypeKind.Struct or p.param_type_name.ptr == null or p.param_type_name.len <= 0
        return
    if is_primitive_type_name(p.param_type_name) == 1
        return
    if cc_unboxed_name(sm.pctx, p.param_type_name) == 1
        return
    # The method cascade builds a Span param before it would box (#2305).
    if span_ok == 1 and p.param_type_name.len > 5 and (p.param_type_name).starts_with("Span$")
        return
    if sema_find_struct(sm, p.param_type_name) == null
        return
    if cc_struct_arg(sm, a) == 1
        return
    if sema_bool_kind(sm, a) != BK_INT and sema_is_int_kind(sema_expr_type(sm, a)) == 0
        return
    if cc_kind_error(sm, a, e.ident, argno, p) == 1
        eprints("an integer\n")

# Method call `e` (`r.m(..)`, `T.m(..)`, or a UFCS helper's `v.push(..)`),
# against `fd`.  As ritz0 counts it (#3319), the call is its desugaring
# `m(r, ..)`: with `recv` 1 the receiver is argument 1 and fills the first
# param; a static call (`recv` 0) has none.  Arity is reported at the call,
# after a private method of another file (#3419), at the method's name.
fn cc_method(sm: *Sema, e: *Expr, fd: *FnDef, recv: i32)
    # At the method's name, as ritz0's name_span: the parser's `bracket`.
    var at: SrcSpan = e.span
    if e.bracket.line > 0
        at = e.bracket
    if cc_private(sm, at.line, at.col, sema_impl_of(sm, fd), e.ident, fd) == 1
        return
    let want: i32 = cc_count_params(fd.params)
    let given: i32 = cc_count_args(e.args) + recv
    if want != given
        if cc_report(sm, e.span.line, e.span.col) == 1
            eprint_char('`')
            eprint_bytes(e.ident)
            eprint("` called with {given as i64} argument(s) but defined with {want as i64}")
            eprint_char('\n')
        return
    var p: *Param = fd.params
    if recv == 1
        p = p.next
    cc_kinds(sm, e.ident, 1 + recv, p, e.args, 0)
    ca_args(sm, e, e.ident, 1 + recv, p, e.args)   # AGAST #4173

# --- Free calls ------------------------------------------------------------------

# AGAST #3933: `print` / `eprint` take one string literal (LANGUAGE_SPEC's
# expect-error), as ritz0 says: "print() requires a single string literal
# argument", at the argument, or at the call when there isn't exactly one.
# The emitter used to lower a non-literal one to nothing.
fn cc_print_arg(sm: *Sema, e: *Expr)
    if name_eq(e.func_name, "print") == 0 and name_eq(e.func_name, "eprint") == 0
        return
    var line: i32 = e.span.line
    var col: i32 = e.span.col
    if e.args != null and e.args.next == null
        if e.args.kind == ExprKind.StringLit or e.args.kind == ExprKind.CstringLit
            return
        line = e.args.span.line
        col = e.args.span.col
    if cc_report(sm, line, col) == 0
        return
    eprint_bytes(e.func_name)
    eprints("() requires a single string literal argument\n")

# 1 for a name emit_expr_call lowers inline before it looks for a fn: the
# print / format / alloca / sizeof builtins, the SIMD and x86 intrinsics,
# the memory builtins.
fn cc_builtin(name_sv: StrView) -> i32
    var len: i32 = name_sv.len as i32
    if name_eq(name_sv, "print") == 1 or name_eq(name_sv, "eprint") == 1
        return 1
    if name_eq(name_sv, "format_into") == 1 or name_eq(name_sv, "__builtin_alloca") == 1
        return 1
    if name_eq(name_sv, "sizeof") == 1
        return 1
    if len > 5 and name_sv.starts_with("simd_")
        if name_eq(name_sv, "simd_loadu") == 1 or name_eq(name_sv, "simd_load") == 1
            return 1
        if name_eq(name_sv, "simd_storeu") == 1 or name_eq(name_sv, "simd_store") == 1
            return 1
        if name_eq(name_sv, "simd_xor") == 1 or name_eq(name_sv, "simd_add") == 1
            return 1
        if name_eq(name_sv, "simd_extract") == 1 or name_eq(name_sv, "simd_insert") == 1
            return 1
        if name_eq(name_sv, "simd_shuffle") == 1 or name_eq(name_sv, "simd_rotl") == 1
            return 1
        if name_eq(name_sv, "simd_sad") == 1 or name_eq(name_sv, "simd_clmul") == 1
            return 1
    if name_eq(name_sv, "sha256rnds2") == 1 or name_eq(name_sv, "sha256msg1") == 1 or name_eq(name_sv, "sha256msg2") == 1
        return 1
    if name_eq(name_sv, "aesenc") == 1 or name_eq(name_sv, "aesenclast") == 1
        return 1
    if name_eq(name_sv, "aesdec") == 1 or name_eq(name_sv, "aesdeclast") == 1
        return 1
    if name_eq(name_sv, "aesimc") == 1 or name_eq(name_sv, "aeskeygenassist") == 1
        return 1
    if name_eq(name_sv, "xgetbv") == 1
        return 1   # AGAST #4657
    (mem_builtin_id(name_sv) != 0) as i32

# 1 for a println/eprintln/write/writeln call emit_expr_call lowers through
# Display (AGAST #4381): the literal ritz0 reads as an InterpString, in the
# position the special case names. Anything else is the ordinary function.
fn cc_interp_literal_call(e: *Expr) -> i32
    let n: StrView = e.func_name
    if name_eq(n, "println") == 1 or name_eq(n, "eprintln") == 1
        if e.args != null and e.args.next == null
            return interp_lit_has_placeholder(e.args)
        return 0
    if name_eq(n, "write") == 1 or name_eq(n, "writeln") == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            return interp_lit_has_placeholder(e.args.next)
        return 0
    0

# 1 for a call that builds an enum variant, which emit_expr_call lowers
# before it looks for a fn: `Some` / `Ok` / `None` / `Err`, a user enum's
# unit or one-payload variant (AGAST #1797, #1610), a name two enums declare
# (#2039, the ambiguity error), and a generic enum's variant no fn shares
# (#3021, #2422: its slot names the instance).
fn cc_variant_ctor(sm: *Sema, e: *Expr) -> i32
    let name: StrView = e.func_name
    if name_eq(name, "Some") == 1 or name_eq(name, "Ok") == 1
        return 1
    if name_eq(name, "None") == 1 or name_eq(name, "Err") == 1
        return 1
    var a: i32 = 0
    var b: i32 = 0
    if user_variant_ctor_ambiguous(sm.pctx, e, @a, @b) == 1
        return 1
    let en: StrView = user_variant_ctor_enum(sm.pctx, e)
    if en.ptr != null
        return 1
    var vi: i32 = 0
    if generic_enum_of_variant(sm.pctx, name, @vi) >= 0
        return 1
    # AGAST #4153: `Z(1)` / `One()`, refused by emit_expr_call with the count.
    var mei: i32 = 0
    if user_variant_ctor_miscounted(sm.pctx, e, @mei, @vi) == 1 and cc_named_fn(sm, e) == null
        return 1
    0

# The fn `name` + its generic suffix names: a fn, else an impl method by its
# `Type_method` symbol (R10, AGAST #2447), as emit_expr_call looks it up.
fn cc_named_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.call_type_suffix.len <= 0
        let f: *FnDef = sema_find_fn(sm, e.func_name)
        if f != null
            return f
        return find_impl_method_by_symbol(sm.module, e.func_name)
    let n: i32 = (e.func_name.len as i32) + (e.call_type_suffix.len as i32)
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..(e.func_name.len as i32)
        *(buf + i) = *(e.func_name.ptr + i)
    for i in 0..(e.call_type_suffix.len as i32)
        *(buf + (e.func_name.len as i32) + i) = *(e.call_type_suffix.ptr + i)
    *(buf + n) = 0
    var fd: *FnDef = sema_find_fn(sm, StrView { ptr: (buf), len: (n) as i64 })
    if fd == null
        fd = find_impl_method_by_symbol(sm.module, StrView { ptr: (buf), len: (n) as i64 })
    free(buf)
    fd

# The full name of `e`'s callee (`vec_new$u8`), as its errors spell it.
fn cc_full_name(e: *Expr) -> StrView
    let n: i32 = (e.func_name.len as i32) + (e.call_type_suffix.len as i32)
    if e.call_type_suffix.len <= 0
        return e.func_name
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..(e.func_name.len as i32)
        *(buf + i) = *(e.func_name.ptr + i)
    for i in 0..(e.call_type_suffix.len as i32)
        *(buf + (e.func_name.len as i32) + i) = *(e.call_type_suffix.ptr + i)
    *(buf + n) = 0
    StrView { ptr: (buf), len: (n) as i64 }

# AGAST #4198: a call to `main` once main took the entry adapter.  `main` is
# then the adapter, `(argc, argv, envp)`; the user's fn is `__ritz_main`
# (main_abi_rename), whose only caller is the adapter.  Refused at the call
# in ritz0's words (main_abi.MSG_CALL).  1 when refused.
fn cc_adapted_main(sm: *Sema, e: *Expr) -> i32
    if e.call_type_suffix.len > 0 or name_eq(e.func_name, "main") == 0
        return 0
    if sema_find_fn(sm, "__ritz_main") == null   # main_abi_rename's name
        return 0
    if cc_report(sm, e.span.line, e.span.col) == 1
        eprints(main_abi_call_msg())
        eprint_char('\n')
    1

# A call `f(args)` (ExprKind.Call), before its arguments are walked.
pub fn call_check_call(sm: *Sema, e: *Expr)
    if g_cc_mute > 0
        return
    if e.func_name.len == 0
        # `fs[i](..)`, through a fn value of a known signature (AGAST #1747),
        # named `<expression>` as ritz0 names it (#3348).
        let sig: *FnDef = sbk_value_fn_sig(sm, e.left)
        if sig != null and cc_arity(sm, e.span.line, e.span.col, "<expression>", sig, e.args) == 0
            cc_kinds(sm, "<expression>", 1, sig.params, e.args, 0)
            ca_args(sm, e, "<expression>", 1, sig.params, e.args)
        return
    if cc_variant_ctor(sm, e) == 1
        return
    if cc_builtin(e.func_name) == 1 or cc_interp_literal_call(e) == 1
        cc_print_arg(sm, e)
        cc_interp_names(sm, e)   # AGAST #4665
        return
    let full: StrView = cc_full_name(e)
    var fd: *FnDef = null
    # A local of the name is the callee (AGAST #2246, #2407): a typed fn
    # value through its signature; an untyped one isn't judged.
    let v: *SemaVar = sema_find_local(sm, e.func_name)
    if v != null and e.call_type_suffix.len == 0
        if v.fn_sig == null
            return
        fd = v.fn_sig
    else
        if cc_adapted_main(sm, e) == 1
            return
        fd = cc_named_fn(sm, e)
        if fd == null
            cc_unknown(sm, e)
            return
        if v == null
            tail_note_callee(e, fd)   # AGAST #3511: a procedure in a tail
    if cc_arity(sm, e.span.line, e.span.col, full, fd, e.args) == 1
        return
    # R10's `C_get(c)` of a `self:&` method (AGAST #3260, #3278) lends c:
    # that param is a bare `self:&` or an `@&C`, neither of which cc_kind
    # judges, so it needs no lent view here.
    cc_kinds(sm, full, 1, fd.params, e.args, (v == null) as i32)
    # What each argument points at (AGAST #4173), against the params the
    # emitter lowers the call with: `C_get(c)` lends c to a `self:&`.
    var cf: *FnDef = fd
    if v == null
        cf = lent_self_call_view_in(sm.module, fd)
    ca_args(sm, e, e.func_name, 1, cf.params, e.args)

# --- Names (AGAST #4595) ---------------------------------------------------------
#
# A bare name `nope` that nothing declares, refused at the name in ritz0's
# words, "Unknown identifier: nope", as cc_unknown refuses a call.  The
# emitter used to be the first to see it ("ritz1 cannot emit: unknown
# identifier 'nope'").  A name is known when emit_expr_ident lowers it or
# refuses it in its own words: a local, const (a builtin one too), global or
# fn, or a variant some enum declares (a unit variant, a generic enum's with
# or without an instance, one two enums declare, the builtin `None`).
#
# The `x` of `x.f` / `x.m(..)` is no value when it names a type, an enum or
# an impl (`E.V`, `Vec2.new(..)`), so it isn't judged here: the caller hands
# it to call_check_qualifier before walking it.

var g_cc_qualifier: *Expr = null

# `q` is the next name walked, the left of a member or method: not judged.
pub fn call_check_qualifier(q: *Expr)
    g_cc_qualifier = q

fn cc_known_ident(sm: *Sema, name: StrView) -> i32
    if sema_is_local(sm, name) == 1 or sbk_const(sm, name) != null or is_builtin_const(name) == 1
        return 1
    if sbk_global(sm, name) != null or sema_find_fn(sm, name) != null
        return 1
    if name_eq(name, "None") == 1
        return 1
    var vi: i32 = 0
    var other: i32 = 0
    if enum_of_variant_unique(sm.pctx, name, @vi, @other) != 0 - 1
        return 1
    (generic_enum_of_variant(sm.pctx, name, @vi) >= 0) as i32

# --- Names a later check would misread (AGAST #4665) -----------------------------
#
# ritz0 resolves every name before it types anything, so an unknown one is
# "Unknown identifier: x" / "Unknown function: f", never the fault a typing
# check finds in the value it can't type.  sema_walk runs the bool and
# no-effect checks on an expression before its names are walked: this tells
# them to stay quiet where call_check will report the name.

# 1 when `e` is a name nothing declares (`nope`) or a call of one
# (`nope(..)`): call_check refuses it when sema_walk reaches it.
pub fn call_check_names_nothing(sm: *Sema, e: *Expr) -> i32
    if e == null or g_cc_mute > 0
        return 0
    if e.kind == ExprKind.Ident
        return (cc_known_ident(sm, e.ident) == 0) as i32
    if e.kind != ExprKind.Call or e.func_name.len == 0 or e.call_type_suffix.len > 0
        return 0
    let name: StrView = e.func_name
    if cc_builtin(name) == 1 or cc_interp_literal_call(e) == 1 or cc_known_ident(sm, name) == 1
        return 0
    if name_eq(name, "Some") == 1 or name_eq(name, "Ok") == 1 or name_eq(name, "Err") == 1
        return 0
    (cc_named_fn(sm, e) == null) as i32

# The names in a print / format_into / println / write literal's `{expr}`
# placeholders (ritz0's InterpString, name_resolver.py).  Sema is the pass
# that parses them (AGAST #4697): each parse of the literal the emitter
# splits (interp_split_literal) is noted on it (Expr.interp) for the emitter
# to lower, and one that is not exactly one expression is refused here,
# where the emitter would have read it (interp_spec_parsed).  The emitter
# used to parse and refuse it, so it was reported only once every Sema
# check had passed.
fn cc_interp_names(sm: *Sema, e: *Expr)
    if e.args == null
        return
    var lit: *Expr = e.args
    let n: StrView = e.func_name
    if name_eq(n, "format_into") == 1 or name_eq(n, "write") == 1 or name_eq(n, "writeln") == 1
        lit = e.args.next
    if lit == null or lit.kind != ExprKind.StringLit or lit.ident.ptr == null or lit.ident.len < 3
        return
    let split: bool = match interp_split_literal(e)
        Some(x) => x == lit
        None => false
    let is_format: bool = e.func_name.eq("format_into")
    let body: StrView = lit.ident.skip(1).take(lit.ident.len - 2)
    var from: i32 = 0
    loop
        let slot: InterpSlot = match interp_next_slot(body, from)
            Some(found) => found
            None => break
        let text: StrView = body.skip(slot.open + 1).take((slot.close - slot.open - 1) as i64)
        let colon: i32 = interp_spec_colon(text)
        var expr: StrView = text
        var spec: StrView = strview_empty()
        if colon >= 0
            expr = text.take(colon as i64)
            spec = text.skip((colon + 1) as i64)
        # The expression's offset in the raw literal, quotes included.
        let at: i32 = slot.open + 2
        match cc_interp_parse(sm, lit, split, at, expr.len as i32, interp_spec_parsed(colon >= 0, spec, is_format))
            Some(x) => cc_interp_walk(sm, x)
            None => pass
        from = slot.close + 1

# The placeholder of `lit` whose expression is the `len` bytes at raw offset
# `at` (InterpParse.at), parsed: Sema's earlier parse when the literal has
# one, else a new one, noted on a literal the emitter splits.  None when the
# text is not exactly one expression; `lowered`: the emitter reads this one,
# so that is refused, as the emitter refused it until AGAST #4697.
fn cc_interp_parse(sm: *Sema, lit: *Expr, split: bool, at: i32, len: i32, lowered: bool) -> Option<*Expr>
    if split
        match interp_parsed_at(lit, at)
            Some(seen) => return Some(seen)
            None => pass
    let x: *Expr = interp_parse_expr(sm.pctx, lit.ident.skip(at).take(len as i64), lit.span.line, lit.span.col)
    if x != null
        if split
            interp_note_parse(lit, at, x)
        return Some(x)
    if split and lowered
        sema_error_at(sm, lit.span.line, lit.span.col)
        eprints("invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)\n")
    None

# A placeholder's names, as sema_walk would judge them: a qualifier (`E.V`,
# `T.m(..)`) names no value.
fn cc_interp_walk(sm: *Sema, x: *Expr)
    if x == null
        return
    match x.kind
        ExprKind.Ident =>
            call_check_ident(sm, x)
        ExprKind.Member | ExprKind.Method =>
            if x.left != null and x.left.kind == ExprKind.Ident
                call_check_qualifier(x.left)
            cc_interp_walk(sm, x.left)
            if x.kind == ExprKind.Method
                cc_interp_list(sm, x.args)
        ExprKind.Binary | ExprKind.Index =>
            cc_interp_walk(sm, x.left)
            cc_interp_walk(sm, x.right)
        ExprKind.Unary =>
            cc_interp_walk(sm, x.operand)
        ExprKind.Cast =>
            cc_interp_walk(sm, x.left)
        ExprKind.Call =>
            cc_interp_list(sm, x.args)
        _ => pass

fn cc_interp_list(sm: *Sema, first: *Expr)
    var a: *Expr = first
    while a != null
        cc_interp_walk(sm, a)
        a = a.next

# `E.C` with `E` an enum that declares no `C`: ritz0's "Unknown variant C in
# enum E", where it is written.  The emitter said "unhandled EXPR_MEMBER".
pub fn call_check_variant(sm: *Sema, e: *Expr)
    let q: *Expr = e.left
    if g_cc_mute > 0 or q == null or q.kind != ExprKind.Ident or cc_is_value_name(sm, q) == 1
        return
    let en: StrView = q.ident
    if sema_is_local(sm, en) == 1 or enum_find(sm.pctx, en) < 0
        return
    if enum_variant_index(sm.pctx, en, e.ident) >= 0
        return
    if cc_report(sm, e.span.line, e.span.col) == 1
        eprints("Unknown variant ")
        eprint_bytes(e.ident)
        eprints(" in enum ")
        eprint_bytes(en)
        eprint_char('\n')

# 1 when Sema's `t` is surely no Option or Result: a scalar, a float, a
# pointer or reference, an array, or a struct or enum the program declares
# (AGAST #4657).  A carrier is a mangled `Option$T` / `Result$T$E`; a name
# Sema can't place (an alias, a generic's T) is left to the emitter.
fn cc_not_carrier(sm: *Sema, t: *SemaTy) -> i32
    if type_is_scalar_leaf(t.kind)
        return 1
    match t.kind
        TypeKind.F32 | TypeKind.F64 | TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef | TypeKind.Array =>
            return 1
        TypeKind.Struct => pass
        _ =>
            return 0
    if t.name.ptr == null or t.name.len <= 0
        return 0
    let n: StrView = t.name
    if name_eq(n, "Option") == 1 or name_eq(n, "Result") == 1 or n.starts_with("Option$") or n.starts_with("Result$")
        return 0
    if sema_find_struct(sm, n) != null or enum_find(sm.pctx, n) >= 0
        return 1
    0

# `x?` of a value that is no Result or Option (cc_not_carrier).  ritz1 took
# the enclosing fn's carrier for it and lowered a tag read of an i64 or a
# struct (ritz0: _emit_try_op).
pub fn call_check_try(sm: *Sema, e: *Expr)
    if g_cc_mute > 0 or e.left == null
        return
    var t: SemaTy
    if sema_expr_ty(sm, e.left, @t) == TypeKind.Unknown
        return
    if cc_not_carrier(sm, @t) == 0
        return
    if cc_report(sm, e.span.line, e.span.col) == 1
        eprints("Try operator requires a Result or an Option\n")

# 1 when `q` is a module the file imports (any segment of an import's path):
# ritz0's module_names, which qualify a pattern (`token.X =>`).
fn cc_is_import_name(sm: *Sema, q: StrView) -> i32
    var d: *ImportDecl = sm.module.imports
    while d != null
        var p: *ImportPath = d.path
        while p != null
            if name_eq(p.segment, q) == 1
                return 1
            p = p.next
        d = d.next
    0

# `token.A =>` / `token.A(v) =>`, each alternative of an or-pattern: a
# qualifier that is no enum and no imported module is ritz0's "Unknown enum:
# token", at the pattern.  ritz1 took `token.A` for a binding, and reported
# the arm after it as unreachable.  `m.K` of a module item is emitter_match's
# "module item access" error; a built-in carrier qualifies its own variants.
pub fn call_check_pattern_qualifier(sm: *Sema, arm: *MatchArm)
    var pat: *MatchArm = arm
    while pat != null
        if pat.qualifier.ptr != null and pat.qualifier.len > 0
            let q: StrView = pat.qualifier
            let known: i32 = (enum_find(sm.pctx, q) >= 0 or sema_find_struct(sm, q) != null or sema_is_local(sm, q) == 1 or cc_is_import_name(sm, q) == 1) as i32
            let carrier: i32 = (name_eq(q, "Option") == 1 or name_eq(q, "Result") == 1) as i32
            let item: i32 = (sbk_const(sm, pat.pattern_name) != null or sbk_global(sm, pat.pattern_name) != null or sema_find_fn(sm, pat.pattern_name) != null) as i32
            if known == 0 and carrier == 0 and item == 0 and cc_report(sm, pat.head_span.line, pat.head_span.col) == 1
                eprints("Unknown enum: ")
                eprint_bytes(q)
                eprint_char('\n')
        pat = pat.or_next

# An ExprKind.Ident, as sema_walk visits it.
pub fn call_check_ident(sm: *Sema, e: *Expr)
    let q: *Expr = g_cc_qualifier
    g_cc_qualifier = null
    if e == q or g_cc_mute > 0
        return
    let name: StrView = e.ident
    if cc_known_ident(sm, name) == 1
        # AGAST #4661: `let f = id` of a `fn id<T>`: a template has no
        # address, only a call instantiates it (ritz0: name_resolver.py
        # generic_fn_value).  A local of that name shadows it.
        if sema_is_local(sm, name) == 0
            let f: *FnDef = sema_find_fn(sm, name)
            if f != null and f.type_params != null and cc_report(sm, e.span.line, e.span.col) == 1
                eprint_char('`')
                eprint_bytes(name)
                eprints("` is generic, so it can't be used as a value: call it\n")
        return
    if cc_report(sm, e.span.line, e.span.col) == 1
        eprints("Unknown identifier: ")
        eprint_bytes(name)
        eprint_char('\n')

# --- Method calls ----------------------------------------------------------------

# 1 when `x` names a local or a global: a value, not a type.
fn cc_is_value_name(sm: *Sema, x: *Expr) -> i32
    if sema_find_local(sm, x.ident) != null
        return 1
    (sbk_global(sm, x.ident) != null) as i32

# The type an instance method call's receiver dispatches on, as
# emit_expr_method resolves it, or an empty view.
fn cc_recv_type(sm: *Sema, e: *Expr) -> StrView
    var recv: *Expr = e.left
    # `(@d).m()` and `(@&d).m()` dispatch on `d` (AGAST #2550).
    while recv.kind == ExprKind.Unary and (recv.op == OpKind.Addr or recv.op == OpKind.AddrMut) and recv.operand != null
        recv = recv.operand
    match recv.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, recv.ident)
            if v != null
                return v.type_name
            let g: *GlobalVarDef = sbk_global(sm, recv.ident)
            if g == null
                return strview_empty()
            if g.var_type == TypeKind.Struct and g.type_name.len > 0
                return g.type_name
            if (g.var_type == TypeKind.Ptr or g.var_type == TypeKind.Ref or g.var_type == TypeKind.MutRef) and g.pointee_type == TypeKind.Struct and g.pointee_type_name.len > 0
                return g.pointee_type_name
            return strview_empty()
        ExprKind.StringLit =>
            return "StrView"
        ExprKind.StructLit =>
            return recv.ident
        _ => pass
    var name: StrView = strview_empty()
    sbk_receiver(sm, recv, @name)
    if name.ptr == null or name.len <= 0
        return strview_empty()
    name

# 1 for a method emit_expr_method lowers inline on `type_name`: an Option /
# Result's unwrap and predicates, StrView.as_bytes, and the Vec / Span /
# StrView `.len()`.
fn cc_inline_method(type_name_sv: StrView, e: *Expr) -> i32
    var type_name_len: i32 = type_name_sv.len as i32
    let m: StrView = e.ident
    if is_tagged_enum_type(type_name_sv) == 1
        if name_eq(m, "unwrap") == 1 or name_eq(m, "unwrap_or") == 1
            return 1
        if e.args == null and (name_eq(m, "is_ok") == 1 or name_eq(m, "is_err") == 1)
            return 1
        if e.args == null and (name_eq(m, "is_some") == 1 or name_eq(m, "is_none") == 1)
            return 1
    if e.args != null
        return 0
    let sv: i32 = name_eq(type_name_sv, "StrView")
    if sv == 1 and name_eq(m, "as_bytes") == 1
        return 1
    if name_eq(m, "len") == 0
        return 0
    if sv == 1
        return 1
    if type_name_len > 4 and type_name_sv.starts_with("Vec$")
        return 1
    (type_name_len > 5 and type_name_sv.starts_with("Span$")) as i32

# The words for `m`'s argument count, when `m` is a BitOps intrinsic on an
# integer (rotl / rotr take one, clz / ctz / popcnt / swap_bytes none) or a
# float one (ceil / floor / round / abs take none): 0 if it is neither, 1 if
# the count is right, 2 if it takes none, 3 if it takes exactly one.
# ritz0: emitter/intrinsics.py, _try_emit_float_intrinsic.
fn cc_intrinsic_arity(m: StrView, nargs: i32, is_float: i32) -> i32
    if is_float == 1
        if name_eq(m, "ceil") == 1 or name_eq(m, "floor") == 1 or name_eq(m, "round") == 1 or name_eq(m, "abs") == 1
            if nargs == 0
                return 1
            return 2
        return 0
    if name_eq(m, "rotl") == 1 or name_eq(m, "rotr") == 1
        if nargs == 1
            return 1
        return 3
    if name_eq(m, "clz") == 1 or name_eq(m, "ctz") == 1 or name_eq(m, "popcnt") == 1 or name_eq(m, "swap_bytes") == 1
        if nargs == 0
            return 1
        return 2
    0

# `x.m(..)` on an integer or float Sema types (AGAST #4665): an intrinsic's
# argument count, at the call; and a float method that is neither an
# intrinsic nor a trait impl's, at the method's name, in ritz0's words.  The
# emitter said "cannot determine receiver type for method call".  An integer
# method that is no intrinsic is left to the emitter.
fn cc_scalar_method(sm: *Sema, e: *Expr)
    var t: SemaTy
    sema_expr_ty(sm, e.left, @t)
    let is_float: i32 = ty_is_float(t.kind)
    if is_float == 0 and ty_is_int(t.kind) == 0
        return
    let tname: StrView = StrView { ptr: (ty_name(t.kind)), len: (ty_name_len(t.kind)) as i64 }
    let m: StrView = e.ident
    if sema_impl_method(sm, tname, m) != null
        return
    let arity: i32 = cc_intrinsic_arity(m, cc_count_args(e.args), is_float)
    if arity != 0
        if arity > 1 and cc_report(sm, e.span.line, e.span.col) == 1
            eprint_bytes(m)
            if arity == 3
                eprints("() requires exactly 1 argument\n")
            else
                eprints("() takes no arguments\n")
        return
    if is_float == 0
        return
    var line: i32 = e.bracket.line
    var col: i32 = e.bracket.col
    if line <= 0
        line = e.span.line
        col = e.span.col
    if cc_report(sm, line, col) == 1
        eprints("No method '")
        eprint_bytes(m)
        eprints("' found for type '")
        eprint_bytes(tname)
        eprints("'\n")

# A method call `r.m(args)` / `T.m(args)` (ExprKind.Method), after its receiver
# is walked and before its arguments are.
pub fn call_check_method(sm: *Sema, e: *Expr)
    let left: *Expr = e.left
    if left == null or g_cc_mute > 0
        return
    if left.kind == ExprKind.Ident and cc_is_value_name(sm, left) == 0
        # `Opt.Holds(x)`: a variant beats an impl method (AGAST #1466).
        let ei: i32 = enum_find(sm.pctx, left.ident)
        if ei >= 0 and enum_variant_index(sm.pctx, left.ident, e.ident) >= 0
            return
        # `Vec2.new(..)`: a static call of the impl's method, no receiver.
        let sm_method: *FnDef = sema_impl_method(sm, left.ident, e.ident)
        tail_note_callee(e, sm_method)   # AGAST #3511
        if sm_method != null and param_is_self(sm_method.params) == 0
            cc_method(sm, e, sm_method, 0)
        return
    let tn: StrView = cc_recv_type(sm, e)
    if tn.ptr == null or tn.len <= 0
        cc_scalar_method(sm, e)   # AGAST #4665
        return
    if e.args != null and name_eq(tn, "StrView") == 1 and name_eq(e.ident, "as_bytes") == 1
        if cc_report(sm, e.span.line, e.span.col) == 1   # AGAST #4665
            eprints("as_bytes() takes no arguments\n")
        return
    if cc_inline_method(tn, e) == 1
        return
    var mfn: *FnDef = sema_impl_method(sm, tn, e.ident)
    if mfn == null
        mfn = sema_spec_impl_method(sm, tn, e.ident)
    if mfn == null
        return
    tail_note_callee(e, mfn)   # AGAST #3511
    cc_method(sm, e, mfn, param_is_self(mfn.params))
    # The instance arm's cascade skips the first param, self or not.
    cc_boxed_args(sm, e, mfn.params, 1)

fn cc_boxed_args(sm: *Sema, e: *Expr, params: *Param, span_ok: i32)
    if params == null
        return
    var p: *Param = params.next
    var a: *Expr = e.args
    var argno: i32 = 2
    while p != null and a != null
        cc_boxed(sm, e, argno, a, p, span_ok)
        p = p.next
        a = a.next
        argno = argno + 1

# --- What an argument points at (AGAST #4173) ------------------------------------
#
# The emitter's call check, on Sema: an argument that isn't what its param
# points at is "argument N of `f` has the wrong type", at the call, naming the
# callee and the argument as ritz0 does (#1366).  It printed after the slot
# checks' line on the emitter; since those moved to Sema (#4011) and stop the
# compile, it is said here, after them, in walk order.
#
#   a struct pointer   `p: *T` / `@T` / `@&T` given `@x`, `@&x` or a pointer
#                      local of another struct S: "T* != S*" (AGAST #1948)
#   an array           a whole array where the param takes none, a length
#                      that isn't a `[N]T` param's, an array that isn't the
#                      one an `a:& [N]T` / `@[N]T` / `@&[N]T` points at, or no
#                      array at all (#2287, #2290); `@x` of a `[N]T` not of
#                      u8 / i8 into a StrView, at the argument (#2305, #3349)
#
# Types are read off the image of each local the emitter will make (RsNote.loc,
# ref_local_in), globals and fields as the emitter reads them.  What that
# can't type stays unjudged.  A bare argument into a `:&` param is ca_borrow's
# (AGAST #4244), said instead of the array check's.

fn ca_local(sm: *Sema, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    var env: RefEnv
    var is_local: i32 = 0
    ref_local_in(ref_env_of(@env, null, sm), e.ident, @is_local)

# 1 when `e` names a local, typed or not.
fn ca_is_local(sm: *Sema, e: *Expr) -> i32
    (e != null and e.kind == ExprKind.Ident and sema_find_local(sm, e.ident) != null) as i32

fn ca_global(sm: *Sema, e: *Expr) -> *GlobalVarDef
    if e == null or e.kind != ExprKind.Ident or ca_is_local(sm, e) == 1
        return null
    sbk_global(sm, e.ident)

# The last argument reported, so an argument judged twice is said once.
var g_ca_call: *Expr = null
var g_ca_argno: i32 = 0

# `path:line:col: error: argument N of `f` has the wrong type: ` at `at`, once
# per argument of `call`; 0 when it was said already.
fn ca_report(sm: *Sema, call: *Expr, at: *Expr, fname_sv: StrView, argno: i32) -> i32
    if g_ca_call == call and g_ca_argno == argno
        return 0
    g_ca_call = call
    g_ca_argno = argno
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm), at.span)
    eprint("argument {argno as i64} of `")
    eprint_bytes(fname_sv)
    eprints("` has the wrong type: ")
    1

fn ca_error(sm: *Sema, call: *Expr, at: *Expr, fname: StrView, argno: i32, why: StrView)
    if ca_report(sm, call, at, fname, argno) == 1
        eprintln(why)

# The struct a pointer param `p: *T` / `@T` / `@&T` points at, or an empty
# view (the emitter's param_pointee_struct until AGAST #4173): not a `p:& T`,
# whose argument is a value.
fn ca_param_struct(sm: *Sema, p: *Param) -> StrView
    if p == null or p.is_borrow == 1 or p.param_type_name.len <= 0
        return strview_empty()
    if p.param_type != TypeKind.Ptr and p.param_type != TypeKind.Ref and p.param_type != TypeKind.MutRef
        return strview_empty()
    if p.param_pointee_type != TypeKind.Struct or sema_find_struct(sm, p.param_type_name) == null
        return strview_empty()
    p.param_type_name

# The struct `arg` surely points at, or an empty view (the emitter's
# arg_pointee_struct): `@x` / `@&x` of a struct local, a `c:& C` param or a
# struct field; `x` a local `*T` / `@T` / `@&T`.  Anything else fails open.
fn ca_arg_struct(sm: *Sema, arg: *Expr) -> StrView
    var name: StrView = strview_empty()
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        let x: *Expr = arg.operand
        if x == null
            return strview_empty()
        match x.kind
            ExprKind.Ident =>
                let loc: *LocalVar = ca_local(sm, x)
                if loc == null
                    return strview_empty()
                let lent: i32 = (lv_holds_lent_ptr(loc) == 1 and lv_pointee_type(loc) == TypeKind.Struct) as i32
                if lv_var_type(loc) != TypeKind.Struct and lent == 0
                    return strview_empty()
                if ca_names_differ(sm, x, loc) == 1
                    return strview_empty()
                name = lv_name(loc)
            ExprKind.Member =>
                let f: *StructField = rs_field(sm, x)
                if f == null or f.field_type != TypeKind.Struct
                    return strview_empty()
                name = f.field_type_name
            _ =>
                return strview_empty()
    else if arg.kind == ExprKind.Ident
        let loc: *LocalVar = ca_local(sm, arg)
        if loc == null
            return strview_empty()
        if lv_var_type(loc) != TypeKind.Ptr and lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef
            return strview_empty()
        if lv_pointee_type(loc) != TypeKind.Struct or ca_names_differ(sm, arg, loc) == 1
            return strview_empty()
        name = lv_name(loc)
    else
        return strview_empty()
    if name.ptr == null or name.len <= 0 or sema_find_struct(sm, name) == null
        return strview_empty()
    name

# 1 when the image of `x` and Sema's own binding name different structs: an
# inferred `let c = v[i]` through a Vec reads as the container (#2443), where
# Sema, which resolved its `.` through Deref, has the element.  Unjudged.
fn ca_names_differ(sm: *Sema, x: *Expr, loc: *LocalVar) -> i32
    let v: *SemaVar = sema_find_local(sm, x.ident)
    if v == null or v.type_name.len <= 0
        return 0
    1 - name_eq(v.type_name, lv_name(loc))

# AGAST #1948: a pointer to struct S where one to T goes.
fn ca_struct_ptr(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    let want: StrView = ca_param_struct(sm, p)
    if want.ptr == null
        return
    let got: StrView = ca_arg_struct(sm, arg)
    if got.ptr == null or name_eq(want, got) == 1
        return
    # R79: any async fn's `NAME$Future` fits a pointer to the built-in
    # `Future`, by reference.
    if sema_future_ref_fits(want.ptr, want.len as i32, got.ptr, got.len as i32) == 1
        return
    if ca_report(sm, call, call, fname_sv, argno) == 1
        eprint_bytes(want)
        eprints("* != ")
        eprint_bytes(got)
        eprints("*\n")

# --- Arrays ---

# The `*[N]T` / `@[N]T` / `@&[N]T` local `e` names (array_ptr_local), or null.
fn ca_array_ptr_local(sm: *Sema, e: *Expr) -> *LocalVar
    let loc: *LocalVar = ca_local(sm, e)
    if loc == null or lv_pointee_type(loc) != TypeKind.Array or lv_pointee_array_size(loc) <= 0
        return null
    if lv_var_type(loc) == TypeKind.Array and lv_is_lent(loc) == 1
        return loc
    if lv_var_type(loc) != TypeKind.Ptr and lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef
        return null
    loc

# What a `*[N]T` field, global, call or cast `e` that isn't a local was declared
# as (base_ptr_array), or null.
fn ca_base_ptr_array(sm: *Sema, e: *Expr) -> *Param
    var pa: *Param = null
    match e.kind
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, e)
            if f != null
                pa = f.ptr_array
        ExprKind.Ident =>
            let g: *GlobalVarDef = ca_global(sm, e)
            if g != null
                pa = g.ptr_array
        ExprKind.Call =>
            let fd: *FnDef = sema_call_fn(sm, e)
            if fd != null
                pa = fd.ret_ptr_array
        ExprKind.Cast =>
            pa = e.cast_ptr_array
        _ => pass
    if pa == null or pa.param_pointee_array_size <= 0 or pa.param_type == TypeKind.PtrPtr
        return null
    pa

# N and T of the `[N]T` that `*e` is, `e` a `*[N]T` local, param, field, global
# (array_ptr_shape).  A step `p + k` isn't judged.
fn ca_array_ptr_shape(sm: *Sema, e: *Expr, out: *ArrayDims) -> i32
    let loc: *LocalVar = ca_array_ptr_local(sm, e)
    if loc != null
        let en: StrView = array_ptr_elem_name(loc)
        return array_dims_1d(out, lv_pointee_array_size(loc), lv_pointee_array_elem_type(loc), en)
    if e.kind == ExprKind.Binary
        return 0
    let pa: *Param = ca_base_ptr_array(sm, e)
    if pa == null
        return 0
    array_dims_1d(out, pa.param_pointee_array_size, pa.param_pointee_array_elem_type, pa.param_type_name)

# A whole 1-D array `value` reads (arg_array_shape): a local or by-value param,
# a global, `*@a`, `*p` of a `*[N]T`, a field.
fn ca_array_shape(sm: *Sema, value: *Expr, out: *ArrayDims) -> i32
    if value.kind == ExprKind.Ident
        let loc: *LocalVar = ca_local(sm, value)
        if loc != null
            # An inferred `let b = g(a)` of a generic's `[N]T` keeps no N here.
            if lv_var_type(loc) == TypeKind.Array and lv_array_shape(loc) == null and lv_array_size(loc) > 0
                return array_dims_1d(out, lv_array_size(loc), lv_array_elem_type(loc), lv_name(loc))
            return 0
        if ca_is_local(sm, value) == 1
            return 0
        let g: *GlobalVarDef = ca_global(sm, value)
        if g != null and g.var_type == TypeKind.Array and g.array_shape == null
            return array_dims_1d(out, g.array_size, g.array_elem_type, g.array_elem_type_name)
        return 0
    if value.kind == ExprKind.Unary and value.op == OpKind.Deref and value.operand != null
        let o: *Expr = value.operand
        if o.kind == ExprKind.Unary and (o.op == OpKind.Addr or o.op == OpKind.AddrMut) and o.operand != null
            let x: *Expr = o.operand
            if x.kind == ExprKind.Ident or x.kind == ExprKind.Unary
                return ca_array_shape(sm, x, out)
            return 0
        return ca_array_ptr_shape(sm, o, out)
    if value.kind == ExprKind.Member
        let f: *StructField = rs_field(sm, value)
        if f != null and f.field_type == TypeKind.Array and f.array_shape == null
            return array_dims_1d(out, f.array_size, f.array_elem_type, f.array_elem_type_name)
    0

# The N-D array a name or field is (nd_array_base_shape), or null.
fn ca_nd_shape(sm: *Sema, base: *Expr) -> *ArrayShape
    if base.kind == ExprKind.Member
        let f: *StructField = rs_field(sm, base)
        if f == null or f.field_type != TypeKind.Array
            return null
        return f.array_shape
    if base.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = ca_local(sm, base)
    if loc != null
        if lv_var_type(loc) == TypeKind.Array
            return lv_array_shape(loc)
        return null
    let g: *GlobalVarDef = ca_global(sm, base)
    if g != null and g.var_type == TypeKind.Array
        return g.array_shape
    null

# What the place `value` holds (place_array_dims): its dimensions, that it's
# no array, or ARG_DIMS_UNKNOWN.
fn ca_place_dims(sm: *Sema, value: *Expr, out: *ArrayDims) -> i32
    if ca_array_shape(sm, value, out) == 1
        return ARG_DIMS_ARRAY
    match value.kind
        ExprKind.Ident =>
            let sh: *ArrayShape = ca_nd_shape(sm, value)
            if sh != null
                return array_dims_nd(out, sh, 0)
            let loc: *LocalVar = ca_local(sm, value)
            if loc != null and lv_var_type(loc) == TypeKind.Array
                return ARG_DIMS_UNKNOWN
            if loc != null or ca_global(sm, value) != null
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, value)
            if f != null and f.field_type == TypeKind.Array and f.array_shape != null
                return array_dims_nd(out, f.array_shape, 0)
            if f != null and f.field_type != TypeKind.Array
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        _ => pass
    if value.kind == ExprKind.Index
        # The chain's base and depth (nd_index_shape).  A `[K]*[N][M]T`
        # element, or a plane pointer's, isn't judged.
        var depth: i32 = 0
        var base: *Expr = value
        while base.kind == ExprKind.Index
            depth = depth + 1
            base = base.left
        let bl: *LocalVar = ca_local(sm, base)
        if bl != null and (lv_array_rec(bl) != null or lv_pointee_array_shape(bl) != null)
            return ARG_DIMS_UNKNOWN
        let sh: *ArrayShape = ca_nd_shape(sm, base)
        if sh != null
            if depth > sh.rank
                return ARG_DIMS_UNKNOWN
            return array_dims_nd(out, sh, depth)
        # An element of a 1-D array.
        var whole: ArrayDims
        if value.left.kind != ExprKind.Index and ca_place_dims(sm, value.left, @whole) == ARG_DIMS_ARRAY
            return ARG_DIMS_NOT_ARRAY
    ARG_DIMS_UNKNOWN

# What `arg` points at, for a param that takes an array by address (ref_arg_dims).
fn ca_ref_dims(sm: *Sema, arg: *Expr, out: *ArrayDims) -> i32
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return ca_place_dims(sm, arg.operand, out)
    if arg.kind == ExprKind.Ident
        let loc: *LocalVar = ca_local(sm, arg)
        if loc != null and lv_var_type(loc) != TypeKind.Array
            let ploc: *LocalVar = ca_array_ptr_local(sm, arg)
            if ploc != null
                # AGAST #4122: a plane pointer `*[N][M]T` points at its shape.
                if lv_pointee_array_shape(ploc) != null and lv_var_type(ploc) == TypeKind.Ptr
                    return array_dims_nd(out, lv_pointee_array_shape(ploc), 0)
                let en: StrView = array_ptr_elem_name(ploc)
                return array_dims_1d(out, lv_pointee_array_size(ploc), lv_pointee_array_elem_type(ploc), en)
            if lv_is_lent(loc) == 1
                return ARG_DIMS_NOT_ARRAY
            # A pointer whose pointee is known and no array (AGAST #2323).
            if lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.PtrPtr or lv_var_type(loc) == TypeKind.Ref or lv_var_type(loc) == TypeKind.MutRef
                if lv_pointee_type(loc) == TypeKind.Array or lv_pointee_type(loc) == TypeKind.Unknown or lv_pointee_type(loc) == TypeKind.Void
                    return ARG_DIMS_UNKNOWN
                return ARG_DIMS_NOT_ARRAY
    ca_place_dims(sm, arg, out)

# AGAST #2290: `a[i]` in the callee trusts the N and T its param declares.
fn ca_array_ref(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    var got: ArrayDims
    let known: i32 = ca_ref_dims(sm, arg, @got)
    if known == ARG_DIMS_UNKNOWN
        return
    if known == ARG_DIMS_NOT_ARRAY
        ca_error(sm, call, call, fname_sv, argno, "the parameter points at an array")
        return
    # A struct element the image doesn't name (`let p = q` of an `@&[3]S`) is unjudged.
    if got.leaf == TypeKind.Struct and got.name.len <= 0
        return
    var want: ArrayDims
    param_pointee_dims(@want, p)
    if array_dims_match(@got, @want) == 0
        ca_error(sm, call, call, fname_sv, argno, "the array isn't the one the parameter points at")

# 1 when `p` is a StrView.
fn ca_strview(p: *Param) -> i32
    (p.param_type == TypeKind.Struct and name_eq(p.param_type_name, "StrView") == 1) as i32

# 1 when `arg`, into the StrView `p`, is a `[N]u8` / `[N]i8` (bare, `@a`, or a
# `*[N]u8` local, param or field): ritz0 makes it the StrView (strview_array_src).
# 2 when it is `@a` or a `*[N]T` of another element: ritz0's "Type of #1 arg
# mismatch" (the emitter's strview_wrong_array until AGAST #4173).
fn ca_strview_array(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if ca_strview(p) == 0
        return 0
    var src: ArrayDims
    if arg.kind == ExprKind.Ident or arg.kind == ExprKind.Member
        if ca_array_ptr_shape(sm, arg, @src) == 1
            if ty_int_bits(src.leaf) == 8
                return 1
            return 2
    var x: *Expr = arg
    let addr: i32 = (x.kind == ExprKind.Unary and (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null) as i32
    if addr == 1
        x = x.operand
    if ca_array_shape(sm, x, @src) == 0
        return 0
    if ty_int_bits(src.leaf) == 8
        return 1
    if addr == 1
        return 2
    0

# --- A bare argument to a `:&` param (AGAST #2335, #4244) ---
#
# LARB R1's second exception: a place of `T` into a `name:& T` param is
# borrowed, as if written `@&x`.  What isn't one passes if it's the pointer to
# one (an `@&T`, a `*T`), else it is refused at the argument:
#
#   a temporary       "a `:&` parameter needs a place to borrow, ..."
#   another type      "this place doesn't hold what the `:&` parameter borrows"
#                     (exactly, not by width: AGAST #2368, #2530)
#   through an `@T`   "a `:&` parameter can't borrow through an `@T`, ..."
#   untypable         "ritz1 can't tell what this argument is: write `@&` ..."
#
# The emitter's check_borrow_arg until AGAST #4244, so a Sema error anywhere
# in the module hid it.  The emitter keeps borrow_arg_kind to lower a place
# to its address; Sema only says what is refused, so where the emitter tells
# a place from a pointer that passes (a `**S` as deep as `:& **S`), both are
# silent here.

const CA_BORROW_PASS: i32 = 0      # a place of `T`, or the pointer to one
const CA_BORROW_RVALUE: i32 = 2
const CA_BORROW_MISFIT: i32 = 3    # a place of something else
const CA_BORROW_UNTYPED: i32 = 4   # ritz1 can't type it
const CA_BORROW_SHARED: i32 = 5    # reached through an `@T`, read-only

# The type of a place, as the emitter's PlaceType: `name` is a struct's, or for
# a pointer the struct it points at.
struct CaPlace
    kind: TypeKind
    pointee: TypeKind
    name: StrView

fn ca_place_set(out: *CaPlace, kind: TypeKind, pointee: TypeKind, name_sv: StrView) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name_sv
    1

fn ca_is_pointer(t: TypeKind) -> i32
    (t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef) as i32

# What `*x` gives, for `x` of type `base`.
fn ca_place_deref(base: *CaPlace, out: *CaPlace) -> i32
    var held: TypeKind = TypeKind.Unknown
    if base.name.len > 0
        held = TypeKind.Struct
    if base.kind == TypeKind.PtrPtr
        return ca_place_set(out, TypeKind.Ptr, held, base.name)
    if ca_is_pointer(base.kind) == 0
        return 0
    ca_place_set(out, base.pointee, held, base.name)

# The plane `[N][M]T` a plane pointer local `q` (`*[N][M]T`), or `*r` of an
# `@*[N][M]T` / `**[N][M]T` one, points at (plane_ptr_shape), or null.
fn ca_plane_shape(sm: *Sema, e: *Expr) -> *ArrayShape
    var x: *Expr = e
    var deref: i32 = 0
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        x = e.operand
        deref = 1
    let loc: *LocalVar = ca_local(sm, x)
    if loc == null or lv_pointee_array_shape(loc) == null
        return null
    # Its slot holds the plane pointer's address: only `*r` is the pointer.
    let holds: i32 = (lv_pointee_type(loc) == TypeKind.Ptr and (lv_var_type(loc) == TypeKind.PtrPtr or lv_var_type(loc) == TypeKind.Ref or lv_var_type(loc) == TypeKind.MutRef)) as i32
    if holds == 1 and deref == 0
        return null
    lv_pointee_array_shape(loc)

# What `x[i]` gives (place_index_type): the array shapes know what they hold; a
# pointer is `*x`.  An element of a `[K]*[N][M]T` is the emitter's to type.
fn ca_place_index(sm: *Sema, value: *Expr, out: *CaPlace) -> i32
    var depth: i32 = 0
    var base: *Expr = value
    while base.kind == ExprKind.Index
        depth = depth + 1
        base = base.left
    var sh: *ArrayShape = ca_nd_shape(sm, base)
    if sh == null
        sh = ca_plane_shape(sm, base)
    if sh != null and depth <= sh.rank
        if depth < sh.rank
            return ca_place_set(out, TypeKind.Array, TypeKind.Unknown, sh.leaf_name)
        return ca_place_set(out, sh.leaf_type, TypeKind.Unknown, sh.leaf_name)
    var src: ArrayDims
    if ca_array_shape(sm, value.left, @src) == 1
        var held: TypeKind = TypeKind.Unknown
        if src.name.len > 0
            held = TypeKind.Struct
        return ca_place_set(out, src.leaf, held, src.name)
    var b: CaPlace
    if ca_place_type(sm, value.left, @b) == 0
        return 0
    ca_place_deref(@b, out)

# 1 and `out` when Sema can type the place `e` (place_type_of).
fn ca_place_type(sm: *Sema, e: *Expr, out: *CaPlace) -> i32
    match e.kind
        ExprKind.Ident =>
            if ca_is_local(sm, e) == 1
                let loc: *LocalVar = ca_local(sm, e)
                if loc == null
                    return 0
                return ca_place_set(out, lv_var_type(loc), lv_pointee_type(loc), lv_name(loc))
            let g: *GlobalVarDef = sbk_global(sm, e.ident)
            if g == null
                return 0
            if ca_is_pointer(g.var_type) == 1
                return ca_place_set(out, g.var_type, g.pointee_type, g.pointee_type_name)
            return ca_place_set(out, g.var_type, TypeKind.Unknown, g.type_name)
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, e)
            if f == null
                return 0
            return ca_place_set(out, f.field_type, ptr_field_elem_kind(f), f.field_type_name)
        ExprKind.Index =>
            return ca_place_index(sm, e, out)
        _ => pass
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        var b: CaPlace
        if ca_place_type(sm, find_base_expr(e.operand), @b) == 0
            return 0
        return ca_place_deref(@b, out)
    0

# 1 when `e` is a place: it names storage the caller can see afterwards.  A
# field or element of a call result isn't one.
fn ca_arg_is_place(sm: *Sema, e: *Expr) -> i32
    var root: *Expr = e
    while root.kind == ExprKind.Member or root.kind == ExprKind.Index
        if root.kind == ExprKind.Index and root.right != null and root.right.kind == ExprKind.Range
            return 0
        root = root.left
    if root.kind == ExprKind.Unary and root.op == OpKind.Deref
        return 1
    if root.kind != ExprKind.Ident
        return 0
    if ca_is_local(sm, root) == 1
        return 1
    (sbk_global(sm, root.ident) != null) as i32

# What `arg`, no place, does for `p`: it passes if it's the pointer `p` is.
fn ca_rvalue_borrow(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if arg.kind == ExprKind.NilLit or arg.kind == ExprKind.CstringLit
        return CA_BORROW_RVALUE
    var t: TypeKind = sema_expr_type(sm, arg)
    if arg.kind == ExprKind.Method
        let m: *FnDef = sbk_method_def(sm, arg)
        if m == null
            return CA_BORROW_UNTYPED
        t = m.return_type
    if t == TypeKind.Ref
        return CA_BORROW_SHARED
    if p.param_pointee_type == TypeKind.Ptr
        if t == TypeKind.PtrPtr
            return CA_BORROW_PASS
    else if ca_is_pointer(t) == 1
        return CA_BORROW_PASS
    CA_BORROW_RVALUE

# 1 when the place `e` is an `@T`, or the nearest indirection on its path to the
# root is one.  An `@&T` or `*T` nearer than that makes it writable.
fn ca_behind_shared(sm: *Sema, e: *Expr) -> i32
    var pl: CaPlace
    if ca_place_type(sm, e, @pl) == 1 and pl.kind == TypeKind.Ref
        return 1
    var at: *Expr = e
    while at != null
        if at.kind == ExprKind.Member or at.kind == ExprKind.Index
            at = at.left
        else if at.kind == ExprKind.Unary and at.op == OpKind.Deref
            at = find_base_expr(at.operand)
        else
            return 0
        if ca_place_type(sm, at, @pl) == 1
            if pl.kind == TypeKind.Ref
                return 1
            if ca_is_pointer(pl.kind) == 1
                return 0
    0

# AGAST #2354: 1 when `arg` names a by-value `@&U` param of the fn walked.
fn ca_ref_param(sm: *Sema, arg: *Expr) -> i32
    if arg.kind != ExprKind.Ident or sm.cur_fn == null
        return 0
    var q: *Param = sm.cur_fn.params
    while q != null
        if q.param_type == TypeKind.MutRef and q.is_borrow == 0 and name_eq(q.name, arg.ident) == 1
            return 1
        q = q.next
    0

# 1 when pointer place `pl` is the `*U` that `p`, a `:& *U`, borrows.
fn ca_pointer_fits(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    let want: TypeKind = p.param_ref_ptr_pointee
    if want == TypeKind.Void or pl.pointee == TypeKind.Unknown
        return 1
    # AGAST #3101: `r:& T` at T = `*[N]E` takes a `*[N]E` place, the same N and E.
    if want == TypeKind.Array and p.param_pointee_array_size > 0
        if pl.pointee != TypeKind.Array
            return 0
        var got: ArrayDims
        if ca_ref_dims(sm, arg, @got) != ARG_DIMS_ARRAY
            return 1
        # A struct element the image doesn't name (a `var q: *[3]S`) is
        # unjudged, as in ca_array_ref.
        if got.leaf == TypeKind.Struct and got.name.len <= 0
            return 1
        var dims: ArrayDims
        param_pointee_dims(@dims, p)
        return array_dims_match(@got, @dims)
    if want == TypeKind.Struct or pl.pointee == TypeKind.Struct
        return (want == pl.pointee and name_eq(p.param_type_name, pl.name) == 1) as i32
    # Exactly: a `*u32` isn't the `*i32` (#2530).
    (want == pl.pointee) as i32

# A pointer place into `p`: a `*U` into `:& *U` is a place of `T`; into `:& U`,
# or a `**U` into `:& *U`, it's the pointer to one.  An `@&U` place holds a
# pointer as a `*U` does (#2354); an `@&U` param is no place: ritz0 gives it no
# storage.  (A `**S` into `:& **S`, place or pointer, passes either way: #2372.)
fn ca_pointer_place(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    if p.param_pointee_type != TypeKind.Ptr
        return CA_BORROW_PASS
    if pl.kind == TypeKind.PtrPtr or pl.pointee == TypeKind.Ptr
        return CA_BORROW_PASS
    if pl.kind != TypeKind.Ptr and (pl.kind != TypeKind.MutRef or ca_ref_param(sm, arg) == 1)
        return CA_BORROW_MISFIT
    if ca_pointer_fits(sm, arg, pl, p) == 1
        return CA_BORROW_PASS
    CA_BORROW_MISFIT

# 1 when the place `arg`, of type `pl`, holds the `T` of `p`: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `:& u32` doesn't take an `i32`.
fn ca_place_fits(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    let pt: TypeKind = p.param_pointee_type
    if pl.kind != TypeKind.Array and pl.kind != TypeKind.Struct
        # AGAST #2994: a `bool` local is a `bool`, though its slot is an i64.
        let loc: *LocalVar = ca_local(sm, arg)
        if loc != null and loc.is_bool == 1
            return (pt == TypeKind.Bool) as i32
        return (pl.kind == pt) as i32
    if pl.kind == TypeKind.Struct
        return (pt == TypeKind.Struct and name_eq(p.param_type_name, pl.name) == 1) as i32
    if pt != TypeKind.Array
        return 0
    var got: ArrayDims
    var want: ArrayDims
    if ca_place_dims(sm, arg, @got) != ARG_DIMS_ARRAY
        return 0
    param_pointee_dims(@want, p)
    array_dims_match(@got, @want)

# What `arg` is to the `:&` param `p` (the emitter's borrow_arg_kind).
fn ca_borrow_kind(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if p == null or p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return CA_BORROW_PASS
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return CA_BORROW_PASS
    # An `a:& [N]T` param reads as the pointer it's bound to.
    let lent: *LocalVar = ca_local(sm, arg)
    if lent != null and lv_var_type(lent) == TypeKind.Array and lv_is_lent(lent) == 1
        return CA_BORROW_PASS
    if ca_arg_is_place(sm, arg) == 0
        return ca_rvalue_borrow(sm, arg, p)
    if ca_behind_shared(sm, arg) == 1
        return CA_BORROW_SHARED
    var pl: CaPlace
    if ca_place_type(sm, arg, @pl) == 0 or pl.kind == TypeKind.Unknown
        return CA_BORROW_UNTYPED
    if ca_is_pointer(pl.kind) == 1
        return ca_pointer_place(sm, arg, @pl, p)
    if ca_place_fits(sm, arg, @pl, p) == 1
        return CA_BORROW_PASS
    CA_BORROW_MISFIT

# Refuses what can't go in the `:&` param `p`, at the argument.  A misfit into
# an `a:& [N]T` is ca_array_ref's, which says which array it wanted.
fn ca_borrow(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    let k: i32 = ca_borrow_kind(sm, arg, p)
    if k == CA_BORROW_RVALUE
        ca_error(sm, call, arg, fname_sv, argno, "a `:&` parameter needs a place to borrow, and this is a temporary")
    else if k == CA_BORROW_MISFIT and param_takes_array_ref(p) == 0
        ca_error(sm, call, arg, fname_sv, argno, "this place doesn't hold what the `:&` parameter borrows")
    else if k == CA_BORROW_SHARED
        ca_error(sm, call, arg, fname_sv, argno, "a `:&` parameter can't borrow through an `@T`, which is read-only")
    else if k == CA_BORROW_UNTYPED
        ca_error(sm, call, arg, fname_sv, argno, "ritz1 can't tell what this argument is: write `@&` before it")

# AGAST #2287: a whole array argument fits its param: a by-value `[N]T` the same
# N, `a:& [N]T` / `@[N]T` / `@&[N]T` the same array, a Span any; else nothing
# takes it.  A by-value `self` isn't judged.
fn ca_array(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    if name_eq(p.name, "self") == 1 and p.is_borrow == 0
        return
    let sv: i32 = ca_strview_array(sm, arg, p)
    if sv == 1
        return
    if sv == 2
        ca_error(sm, call, arg, fname_sv, argno, "the parameter doesn't take a whole array")
        return
    let literal: i32 = (arg.kind == ExprKind.ArrayLit or arg.kind == ExprKind.ArrayFill) as i32
    if literal == 0 and param_takes_array_ref(p) == 1
        ca_array_ref(sm, call, fname_sv, argno, arg, p)
        return
    var src: ArrayDims
    if literal == 0 and ca_array_shape(sm, arg, @src) == 0
        return
    if p.param_type == TypeKind.Array
        if literal == 0 and src.dims[0] != p.param_array_size
            ca_error(sm, call, call, fname_sv, argno, "the array's length isn't the parameter's")
        return
    if param_is_span(p) == 1
        return
    if param_takes_array_ref(p) == 0
        ca_error(sm, call, call, fname_sv, argno, "the parameter doesn't take a whole array")
        return
    ca_error(sm, call, call, fname_sv, argno, "an array literal has no address to pass")

# Each argument of `call` against `params`, numbered from `argno`.
fn ca_args(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, params: *Param, args: *Expr)
    var p: *Param = params
    var a: *Expr = args
    var n: i32 = argno
    while p != null and a != null
        ca_struct_ptr(sm, call, fname_sv, n, a, p)
        # AGAST #4244: before ca_array, so a refused borrow is said in its own
        # words; ca_report says one error per argument.
        ca_borrow(sm, call, fname_sv, n, a, p)
        ca_array(sm, call, fname_sv, n, a, p)
        p = p.next
        a = a.next
        n = n + 1
