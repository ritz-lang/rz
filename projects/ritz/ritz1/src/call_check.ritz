# call_check.ritz - a call's arguments fit its callee (AGAST #1629)
#
# ritz0 refuses a call with the wrong number of arguments, and one whose
# argument is of another kind than its parameter, at the call.  ritz1 took the
# first silently and turned the second into IR clang refused, pointing at the
# generated .ll.  The shared table is ritz0/test_call_arity_and_type.py.
#
#   known   "Unknown function: f", at the call (AGAST #3255)
#   arity   "`f` called with N argument(s) but defined with M", at the call
#   kind    "argument N of `f` has the wrong type: ...", at the argument
#   private "`f` is private to a.ritz; mark it `pub` (#3413)", at the call, and
#           a note at the declaration (AGAST #3419, LARB R45a; ritz0's #3418)
#
# A method call counts as `m(r, ..)`, its receiver argument 1, as ritz0 does
# (#3319); a static call has no receiver.
#
# ritz0 spells the rest of a kind error in llvmlite's types; ritz1 names the
# parameter and what it got.  The kind rule is only what is wrong whatever the
# compiler makes of it, and is silent when ritz1 can't tell:
#
#   a by-value struct param   gets an integer (LARB R47, §9.2: even into a
#                             single-field struct, where a method or UFCS
#                             call used to box it; cc_sure_int, and
#                             call_check_boxed for what it can't vouch for,
#                             R47b), a `bool`, a float, `null`, a
#                             c-string, or a pointer to something
#                             else (one to the same struct is ref_check's
#                             "doesn't fit a by-value slot")
#   an int, float or bool     gets a struct value
#   a `*Q` param              gets a struct value of another type than Q
#                             (#3340); one of Q is ref_check's "doesn't fit a
#                             reference slot", as is anything into an `@Q`
#
# An enum into an integer param is enum_as_int's, which runs on free, method
# and static calls alike.
#
# A pointer into an integer is left alone: it's a ptrtoint.  So is a
# `Span<T>` param given `@a` or `@v`, and a StrView given a pointer
# to an array (#3335): those are coercions.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import emitter_expr_call   # lent_local, arg_pointee_struct, impl_of_method (#3419)
import bool_check          # bool_kind, bk_of_type, BK_*

# The last place reported, so a call emitted twice is said once.
var g_cc_fn: *FnDef = null
var g_cc_line: i32 = 0
var g_cc_col: i32 = 0

# `error: path:line:col: ` the first time this place is reported, counting the
# error; 0 when it was said already.
fn cc_report(s: *EmitterState, line: i32, col: i32) -> i32
    let f: *FnDef = emitter_current_fn()
    if g_cc_fn == f and g_cc_line == line and g_cc_col == col
        return 0
    g_cc_fn = f
    g_cc_line = line
    g_cc_col = col
    s.error_count = s.error_count + 1
    emit_str(s, c"  ; ERROR: call does not fit its callee (AGAST #1629)\n")
    eprints_cstr(c"error: ")
    var file: *u8 = null
    if f != null
        file = fn_source_file(f)
    if file == null
        file = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_int(line as i64)
    eprint_char(':')
    eprint_int(col as i64)
    eprints_cstr(c": ")
    1

fn cc_count_params(p: *Param) -> i32
    var n: i32 = 0
    var q: *Param = p
    while q != null
        n = n + 1
        q = q.next
    n

fn cc_count_args(a: *Expr) -> i32
    var n: i32 = 0
    var x: *Expr = a
    while x != null
        n = n + 1
        x = x.next
    n

# The part of `path` after its last '/'.
fn cc_basename(path: *u8) -> *u8
    var base: *u8 = path
    var q: *u8 = path
    while *q != 0
        if *q == '/'
            base = q + 1
        q = q + 1
    base

# AGAST #3419 (LARB R45a, LANGUAGE_SPEC §15.2): a call to `fd`, declared
# without `pub` in another file, refused at line:col as ritz0 refuses it
# (#3418), with a note at the declaration: a basename alone is ambiguous
# across packages.  `owner` is the impl's type for a method (`P.get`), null
# for a free call (`helper`, the mangled `P_get`).  1 when refused.
#
# The caller's file is the fn being emitted's: an instance of another file's
# generic carries that file (specialize copies def_file), so its calls are
# that file's own.  Not checked, as in ritz0: an `extern fn` (no body) and a
# written `fn .. = extern` (extern_decl: a symbol defined elsewhere; an
# import's stripped bodies are checked), monomorph instances (is_pub,
# set by specialize), a generated `E.from`, and a fn whose file isn't known.
fn cc_private(s: *EmitterState, line: i32, col: i32, owner: *ImplBlock, name: *u8, len: i32, fd: *FnDef) -> i32
    if fd == null or fd.is_pub == 1 or fd.body == null or fd.extern_decl == 1
        return 0
    if fd.from_generated == 1 or fd.def_file == null
        return 0
    let caller: *FnDef = emitter_current_fn()
    var here: *u8 = null
    if caller != null
        here = caller.def_file
    if here == null
        here = emitter_source_file()
    if here == null or streq(here, fd.def_file) == 1
        return 0
    if cc_report(s, line, col) == 1
        for round in 0..2
            if round == 1
                eprints_cstr(fd.def_file)
                eprint_char(':')
                eprint_int(fd.line as i64)
                eprint_char(':')
                eprint_int(fd.col as i64)
                eprints_cstr(c": note: ")
            eprint_char('`')
            if owner != null
                eprint_bytes(owner.type_name, owner.type_name_len)
                eprint_char('.')
            eprint_bytes(name, len)
            if round == 0
                eprints_cstr(c"` is private to ")
                eprints_cstr(cc_basename(fd.def_file))
                eprints_cstr(c"; mark it `pub` (#3413)\n")
            else
                eprints_cstr(c"` is declared here\n")
    1

# A call to `name` that no declared, imported or `extern` fn answers (the
# caller found no FnDef), refused at the call as ritz0 says it; 1 when refused.
# ritz1 used to declare `@name(...)` and leave it to the no-libc link, whose
# "undefined reference" names no line.  `syscallN` and `cpuid_raw` are no
# exception: they are ordinary fns (ritzlib.sys, cryptosec.cpuid; #3397).  A
# generic call (`f$T`) whose instance is missing is another failure and isn't
# said here.
pub fn call_check_known(s: *EmitterState, line: i32, col: i32, name: *u8, len: i32) -> i32
    if cc_report(s, line, col) == 1
        eprints_cstr(c"Unknown function: ")
        eprint_bytes(name, len)
        eprint_char('\n')
    1

# `name(args)`, a free call to `fd`, reported at line:col in ritz0's words: a
# private fn of another file (#3419), else the argument count.  1 when
# refused, so the caller doesn't pair the arguments up.
pub fn call_check_arity(s: *EmitterState, line: i32, col: i32, name: *u8, len: i32, fd: *FnDef, args: *Expr) -> i32
    if cc_private(s, line, col, null, name, len, fd) == 1
        return 1
    let m: i32 = cc_count_params(fd.params)
    let n: i32 = cc_count_args(args)
    if m == n
        return 0
    if cc_report(s, line, col) == 1
        eprint_char('`')
        eprint_bytes(name, len)
        eprints_cstr(c"` called with ")
        eprint_int(n as i64)
        eprints_cstr(c" argument(s) but defined with ")
        eprint_int(m as i64)
        eprint_char('\n')
    1

fn cc_int_type(t: i32) -> i32
    return (t == TYPE_I8 or t == TYPE_U8 or t == TYPE_I16 or t == TYPE_U16 or t == TYPE_I32 or t == TYPE_U32 or t == TYPE_I64 or t == TYPE_U64) as i32

# 1 if `p` surely points at an integer: a pointer or borrow local to one, a
# `*i64` field, or either plus an offset (`p + i`).
fn cc_int_pointer(s: *EmitterState, p: *Expr) -> i32
    if p.kind == EXPR_IDENT
        if lent_scalar_ident(s, p) != null
            return 1
        let loc: *LocalVar = find_local_struct_name(s, p.ident_ptr, p.ident_len)
        if loc != null and loc.var_type != TYPE_ARRAY
            return cc_int_type(loc.pointee_type)
        return 0
    if p.kind == EXPR_MEMBER
        return cc_int_type(get_member_pointee_type_exact(s, p))
    if p.kind == EXPR_BINARY and (p.op == OP_ADD or p.op == OP_SUB)
        return cc_int_pointer(s, p.left)
    0

# 1 if `a`, which bool_kind calls BK_INT, surely is an integer.  bool_kind
# guesses BK_INT for what get_expr_type can't type (a `*p` of a struct
# pointer), so only these forms are taken at its word: a literal, a cast, a
# name, a call or method whose callee it resolved, `*p` of an integer pointer
# or borrow, a member read (bk_member resolved the field), an element of a
# name or field whose element type is known, and arithmetic or `-` / `~` of
# these (LARB R47b, #3420).
fn cc_sure_int(s: *EmitterState, a: *Expr) -> i32
    let k: i32 = a.kind
    if k == EXPR_INT_LIT or k == EXPR_CHAR_LIT or k == EXPR_CAST or k == EXPR_IDENT
        return 1
    if k == EXPR_CALL or k == EXPR_METHOD or k == EXPR_MEMBER
        return 1
    if k == EXPR_BINARY
        return (bool_kind(s, a.left) == BK_INT and cc_sure_int(s, a.left) == 1 and bool_kind(s, a.right) == BK_INT and cc_sure_int(s, a.right) == 1) as i32
    if k == EXPR_UNARY and (a.op == OP_NEG or a.op == OP_BIT_NOT)
        return cc_sure_int(s, a.operand)
    if k == EXPR_UNARY and a.op == OP_DEREF and a.operand != null
        return cc_int_pointer(s, a.operand)
    if k == EXPR_INDEX and a.left != null
        let base: *Expr = a.left
        if base.kind == EXPR_IDENT
            return (bk_element(s, base.ident_ptr, base.ident_len) == BK_INT) as i32
        if base.kind == EXPR_MEMBER
            let f: *StructField = member_field_def(s, base)
            if f != null and f.field_type == TYPE_ARRAY
                return cc_int_type(f.array_elem_type)
    0

# What `a` is when it can't be the by-value struct `want`, in words; null when
# it can be, or ritz1 can't tell.
fn cc_not_a_struct(s: *EmitterState, a: *Expr, want: *u8, want_len: i32) -> *u8
    if a.kind == EXPR_NIL_LIT
        return c"`null`"
    if a.kind == EXPR_CSTRING_LIT
        return c"a `*u8`"
    let k: i32 = bool_kind(s, a)
    if k == BK_FLOAT
        return c"a float"
    # Nothing converts to a struct, not even a single-field one (LARB R47,
    # §9.2, #3390).
    if k == BK_INT and cc_sure_int(s, a) == 1
        return c"an integer"
    # Nor any other scalar (LARB R47b, #3420): a bool says so whatever its form.
    if k == BK_BOOL
        return c"a `bool`"
    if k != BK_PTR
        return null
    # A Span is built from `@a` / `@v` (coerce_array_to_span, emit_vec_as_span).
    if want_len > 5 and memcmp(want, c"Span$", 5) == 0
        return null
    # A `c:& C` local reads as the C it borrows (#2250): another struct than
    # `want` is let_check's (#3294).
    if lent_local(s, a) != null
        return null
    var plen: i32 = 0
    let pointee: *u8 = arg_pointee_struct(s, a, @plen)
    if pointee != null
        if name_eq(pointee, plen, want, want_len) == 1
            return null   # ref_check's "doesn't fit a by-value slot"
        return c"a pointer"
    # A local `*u8` / `*i32` ...: a pointer to no struct at all.  A `*[N]u8`
    # makes a StrView in ritz0, so a pointer to an array isn't judged.
    if a.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, a.ident_ptr, a.ident_len)
        if loc != null and loc.var_type == TYPE_PTR and loc.pointee_type != TYPE_STRUCT and loc.pointee_type != TYPE_VOID and loc.pointee_type != TYPE_ARRAY
            return c"a pointer"
    null

# The known struct `a` is a value of, or null.
fn cc_struct_value(s: *EmitterState, a: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    # A `c:& C` param is a TYPE_MUT_REF local naming its referent (#2250).
    let lent: *LocalVar = lent_local(s, a)
    if lent != null
        if lent.var_type != TYPE_MUT_REF
            return null
        name = lent.type_name
        len = lent.type_name_len
    else if bool_kind(s, a) == BK_OTHER
        resolve_expr_struct_name(s, a, @name, @len)
    if name == null or len <= 0 or find_struct(s, name, len) == null
        return null
    *out_len = len
    name

fn cc_kind_error(s: *EmitterState, a: *Expr, fname: *u8, flen: i32, argno: i32, p: *Param) -> i32
    if cc_report(s, a.span.line, a.span.col) == 0
        return 0
    eprints_cstr(c"argument ")
    eprint_int(argno as i64)
    eprints_cstr(c" of `")
    eprint_bytes(fname, flen)
    eprints_cstr(c"` has the wrong type: parameter `")
    eprint_bytes(p.name, p.name_len)
    eprints_cstr(c"` is declared `")
    if p.param_type == TYPE_PTR
        eprint_char('*')
        eprint_bytes(p.param_type_name, p.param_type_name_len)
    else if p.param_type == TYPE_STRUCT
        eprint_bytes(p.param_type_name, p.param_type_name_len)
    else
        eprints_cstr(primitive_name_from_type(p.param_type))
    eprints_cstr(c"` but its argument is ")
    1

# Argument `argno` of `fname`, `a`, for param `p`.
pub fn call_check_kind(s: *EmitterState, fname: *u8, flen: i32, argno: i32, a: *Expr, p: *Param)
    if a == null or p == null or p.is_borrow == 1
        return
    let pk: i32 = bk_of_type(p.param_type, p.param_type_name, p.param_type_name_len)
    if p.param_type == TYPE_STRUCT and pk == BK_OTHER
        if find_struct(s, p.param_type_name, p.param_type_name_len) == null
            return
        # A `c"..."` into a StrView / `Span<u8>` is literal_slot's, said at
        # this argument already (AGAST #3440).
        if a.kind == EXPR_CSTRING_LIT and (name_eq(p.param_type_name, p.param_type_name_len, c"StrView", 7) == 1 or name_eq(p.param_type_name, p.param_type_name_len, c"Span$u8", 7) == 1)
            return
        let what: *u8 = cc_not_a_struct(s, a, p.param_type_name, p.param_type_name_len)
        if what != null and cc_kind_error(s, a, fname, flen, argno, p) == 1
            eprints_cstr(what)
            eprint_char('\n')
        return
    # A `*Q` param given a known struct value of another type (#3340).  One of
    # Q itself is ref_check's ("a value doesn't fit a reference slot"), as is
    # anything into an `@Q`, which is TYPE_REF and not judged here.
    if p.param_type == TYPE_PTR and p.param_pointee_type == TYPE_STRUCT
        if p.param_type_name == null or p.param_type_name_len <= 0
            return
        if find_struct(s, p.param_type_name, p.param_type_name_len) == null
            return
        var vlen: i32 = 0
        let val: *u8 = cc_struct_value(s, a, @vlen)
        if val == null or name_eq(val, vlen, p.param_type_name, p.param_type_name_len) == 1
            return
        if cc_kind_error(s, a, fname, flen, argno, p) == 1
            eprints_cstr(c"a `")
            eprint_bytes(val, vlen)
            eprints_cstr(c"`\n")
        return
    if (pk != BK_INT and pk != BK_FLOAT and pk != BK_BOOL) or p.param_type == TYPE_STRUCT
        return
    if primitive_name_from_type(p.param_type) == null
        return
    var len: i32 = 0
    let got: *u8 = cc_struct_value(s, a, @len)
    if got != null and cc_kind_error(s, a, fname, flen, argno, p) == 1
        eprints_cstr(c"a `")
        eprint_bytes(got, len)
        eprints_cstr(c"`\n")

# The newtype box (emitter_expr_call's method and UFCS arg cascades) found an
# integer, by get_expr_type, for by-value struct param `p` of method call `e`:
# it used to store the i64 into the struct.  Nothing converts to a struct
# (LARB R47b, §9.2, #3420), so whatever form cc_sure_int didn't vouch for is
# refused here, at the argument.  Said once: rule A at the same place wins.
pub fn call_check_boxed(s: *EmitterState, e: *Expr, argno: i32, a: *Expr, p: *Param)
    if a == null or p == null
        return
    if cc_kind_error(s, a, e.ident_ptr, e.ident_len, argno, p) == 1
        eprints_cstr(c"an integer\n")

# Method call `e` (`r.m(..)`, `T.m(..)`, or a UFCS helper's `v.push(..)`),
# against `fd`, the callee emit_expr_method dispatches it to (where it calls
# note_method_callee).  As ritz0 counts it (#3319), the call is its desugaring
# `m(r, ..)`: with `recv` 1 the receiver is argument 1 and fills the first
# param; a static call (`recv` 0) has none.  Arity is reported at the call,
# after a private method of another file (#3419), at the method's name.
pub fn call_check_method(s: *EmitterState, e: *Expr, fd: *FnDef, recv: i32)
    if fd == null
        return
    # At the method's name, as ritz0's name_span: the parser's `bracket`.
    var at: SrcSpan = e.span
    if e.bracket.line > 0
        at = e.bracket
    if cc_private(s, at.line, at.col, impl_of_method(s.module, fd), e.ident_ptr, e.ident_len, fd) == 1
        return
    let want: i32 = cc_count_params(fd.params)
    let given: i32 = cc_count_args(e.args) + recv
    if want != given
        if cc_report(s, e.span.line, e.span.col) == 1
            eprint_char('`')
            eprint_bytes(e.ident_ptr, e.ident_len)
            eprints_cstr(c"` called with ")
            eprint_int(given as i64)
            eprints_cstr(c" argument(s) but defined with ")
            eprint_int(want as i64)
            eprint_char('\n')
        return
    var p: *Param = fd.params
    if recv == 1
        p = p.next
    var a: *Expr = e.args
    var argno: i32 = 1 + recv
    while p != null and a != null
        call_check_kind(s, e.ident_ptr, e.ident_len, argno, a, p)
        p = p.next
        a = a.next
        argno = argno + 1
