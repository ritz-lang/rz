# call_check.ritz - a call's arguments fit its callee (AGAST #1629)
#
# ritz0 refuses a call with the wrong number of arguments, and one whose
# argument is of another kind than its parameter, at the call.  ritz1 took the
# first silently and turned the second into IR clang refused, pointing at the
# generated .ll.  The shared table is ritz0/test_call_arity_and_type.py.
#
#   known   "Unknown function: f", at the call (AGAST #3255)
#   arity   "`f` called with N argument(s) but defined with M", at the call
#   kind    "argument N of `f` has the wrong type: ...", at the argument
#
# A method call counts as `m(r, ..)`, its receiver argument 1, as ritz0 does
# (#3319); a static call has no receiver.
#
# ritz0 spells the rest of a kind error in llvmlite's types; ritz1 names the
# parameter and what it got.  The kind rule is only what is wrong whatever the
# compiler makes of it, and is silent when ritz1 can't tell:
#
#   a by-value struct param   gets a float, `null`, a c-string, or a pointer
#                             to something else (one to the same struct is
#                             ref_check's "doesn't fit a by-value slot")
#   an int, float or bool     gets a struct value
#   a `*Q` param              gets a struct value of another type than Q
#                             (#3340); one of Q is ref_check's "doesn't fit a
#                             reference slot", as is anything into an `@Q`
#
# An enum into an integer param is enum_as_int's, which runs on free, method
# and static calls alike.
#
# An integer into a single-field struct is left alone: ritz0 wraps it (a
# coercion ritz1 doesn't have, #3336), and a pointer into an integer is a ptrtoint.
# So is a `Span<T>` param given `@a` or `@v`, and a StrView given a pointer
# to an array (#3335): those are coercions.  ritz0's `syscallN` builtins aren't
# counted (#3334).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import emitter_expr_call   # lent_local, arg_pointee_struct
import bool_check          # bool_kind, bk_of_type, BK_*
import emitter             # is_cpuid_raw_function (AGAST #3255)

# The last place reported, so a call emitted twice is said once.
var g_cc_fn: *FnDef = null
var g_cc_line: i32 = 0
var g_cc_col: i32 = 0

# `error: path:line:col: ` the first time this place is reported, counting the
# error; 0 when it was said already.
fn cc_report(s: *EmitterState, line: i32, col: i32) -> i32
    let f: *FnDef = emitter_current_fn()
    if g_cc_fn == f and g_cc_line == line and g_cc_col == col
        return 0
    g_cc_fn = f
    g_cc_line = line
    g_cc_col = col
    s.error_count = s.error_count + 1
    emit_str(s, c"  ; ERROR: call does not fit its callee (AGAST #1629)\n")
    eprints_cstr(c"error: ")
    var file: *u8 = null
    if f != null
        file = fn_source_file(f)
    if file == null
        file = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_int(line as i64)
    eprint_char(':')
    eprint_int(col as i64)
    eprints_cstr(c": ")
    1

fn cc_count_params(p: *Param) -> i32
    var n: i32 = 0
    var q: *Param = p
    while q != null
        n = n + 1
        q = q.next
    n

fn cc_count_args(a: *Expr) -> i32
    var n: i32 = 0
    var x: *Expr = a
    while x != null
        n = n + 1
        x = x.next
    n

# `syscallN` / `__syscallN` (N in 0..6): ritz1 gives these a body (emit_extern_
# declarations), so with no declaration in scope they're known, not unknown.
# Counted against a declaration when there is one (#3334); a bare one isn't
# counted yet (#3352).
fn cc_is_syscall_name(name: *u8, len: i32) -> i32
    var at: i32 = 0
    if len == 10 and memcmp(name, c"__syscall", 9) == 0
        at = 9
    else if len == 8 and memcmp(name, c"syscall", 7) == 0
        at = 7
    else
        return 0
    let d: u8 = *(name + at)
    return (d >= '0' and d <= '6') as i32

# A call to `name` that no declared, imported or `extern` fn answers (the
# caller found no FnDef), refused at the call as ritz0 says it; 1 when refused.
# ritz1 used to declare `@name(...)` and leave it to the no-libc link, whose
# "undefined reference" names no line.  The names ritz1 gives a body itself
# are not unknown: the `syscallN` builtins and `cpuid_raw` (emit_extern_
# declarations).  A generic call (`f$T`) whose instance is missing is another
# failure and isn't said here.
pub fn call_check_known(s: *EmitterState, line: i32, col: i32, name: *u8, len: i32) -> i32
    if cc_is_syscall_name(name, len) == 1 or is_cpuid_raw_function(name, len) == 1
        return 0
    if cc_report(s, line, col) == 1
        eprints_cstr(c"Unknown function: ")
        eprint_bytes(name, len)
        eprint_char('\n')
    1

# `name(args)` against `params`, reported at line:col in ritz0's words.  1 when
# the counts differ (refused), so the caller doesn't pair the arguments up.
pub fn call_check_arity(s: *EmitterState, line: i32, col: i32, name: *u8, len: i32, params: *Param, args: *Expr) -> i32
    let m: i32 = cc_count_params(params)
    let n: i32 = cc_count_args(args)
    if m == n
        return 0
    if cc_report(s, line, col) == 1
        eprint_char('`')
        eprint_bytes(name, len)
        eprints_cstr(c"` called with ")
        eprint_int(n as i64)
        eprints_cstr(c" argument(s) but defined with ")
        eprint_int(m as i64)
        eprint_char('\n')
    1

# What `a` is when it can't be the by-value struct `want`, in words; null when
# it can be, or ritz1 can't tell.
fn cc_not_a_struct(s: *EmitterState, a: *Expr, want: *u8, want_len: i32) -> *u8
    if a.kind == EXPR_NIL_LIT
        return c"`null`"
    if a.kind == EXPR_CSTRING_LIT
        return c"a `*u8`"
    let k: i32 = bool_kind(s, a)
    if k == BK_FLOAT
        return c"a float"
    if k != BK_PTR
        return null
    # A Span is built from `@a` / `@v` (coerce_array_to_span, emit_vec_as_span).
    if want_len > 5 and memcmp(want, c"Span$", 5) == 0
        return null
    # A `c:& C` local reads as the C it borrows (#2250): another struct than
    # `want` is let_check's (#3294).
    if lent_local(s, a) != null
        return null
    var plen: i32 = 0
    let pointee: *u8 = arg_pointee_struct(s, a, @plen)
    if pointee != null
        if name_eq(pointee, plen, want, want_len) == 1
            return null   # ref_check's "doesn't fit a by-value slot"
        return c"a pointer"
    # A local `*u8` / `*i32` ...: a pointer to no struct at all.  A `*[N]u8`
    # makes a StrView in ritz0, so a pointer to an array isn't judged.
    if a.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, a.ident_ptr, a.ident_len)
        if loc != null and loc.var_type == TYPE_PTR and loc.pointee_type != TYPE_STRUCT and loc.pointee_type != TYPE_VOID and loc.pointee_type != TYPE_ARRAY
            return c"a pointer"
    null

# The known struct `a` is a value of, or null.
fn cc_struct_value(s: *EmitterState, a: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    # A `c:& C` param is a TYPE_MUT_REF local naming its referent (#2250).
    let lent: *LocalVar = lent_local(s, a)
    if lent != null
        if lent.var_type != TYPE_MUT_REF
            return null
        name = lent.type_name
        len = lent.type_name_len
    else if bool_kind(s, a) == BK_OTHER
        resolve_expr_struct_name(s, a, @name, @len)
    if name == null or len <= 0 or find_struct(s, name, len) == null
        return null
    *out_len = len
    name

fn cc_kind_error(s: *EmitterState, a: *Expr, fname: *u8, flen: i32, argno: i32, p: *Param) -> i32
    if cc_report(s, a.span.line, a.span.col) == 0
        return 0
    eprints_cstr(c"argument ")
    eprint_int(argno as i64)
    eprints_cstr(c" of `")
    eprint_bytes(fname, flen)
    eprints_cstr(c"` has the wrong type: parameter `")
    eprint_bytes(p.name, p.name_len)
    eprints_cstr(c"` is declared `")
    if p.param_type == TYPE_PTR
        eprint_char('*')
        eprint_bytes(p.param_type_name, p.param_type_name_len)
    else if p.param_type == TYPE_STRUCT
        eprint_bytes(p.param_type_name, p.param_type_name_len)
    else
        eprints_cstr(primitive_name_from_type(p.param_type))
    eprints_cstr(c"` but its argument is ")
    1

# Argument `argno` of `fname`, `a`, for param `p`.
pub fn call_check_kind(s: *EmitterState, fname: *u8, flen: i32, argno: i32, a: *Expr, p: *Param)
    if a == null or p == null or p.is_borrow == 1
        return
    let pk: i32 = bk_of_type(p.param_type, p.param_type_name, p.param_type_name_len)
    if p.param_type == TYPE_STRUCT and pk == BK_OTHER
        if find_struct(s, p.param_type_name, p.param_type_name_len) == null
            return
        let what: *u8 = cc_not_a_struct(s, a, p.param_type_name, p.param_type_name_len)
        if what != null and cc_kind_error(s, a, fname, flen, argno, p) == 1
            eprints_cstr(what)
            eprint_char('\n')
        return
    # A `*Q` param given a known struct value of another type (#3340).  One of
    # Q itself is ref_check's ("a value doesn't fit a reference slot"), as is
    # anything into an `@Q`, which is TYPE_REF and not judged here.
    if p.param_type == TYPE_PTR and p.param_pointee_type == TYPE_STRUCT
        if p.param_type_name == null or p.param_type_name_len <= 0
            return
        if find_struct(s, p.param_type_name, p.param_type_name_len) == null
            return
        var vlen: i32 = 0
        let val: *u8 = cc_struct_value(s, a, @vlen)
        if val == null or name_eq(val, vlen, p.param_type_name, p.param_type_name_len) == 1
            return
        if cc_kind_error(s, a, fname, flen, argno, p) == 1
            eprints_cstr(c"a `")
            eprint_bytes(val, vlen)
            eprints_cstr(c"`\n")
        return
    if (pk != BK_INT and pk != BK_FLOAT and pk != BK_BOOL) or p.param_type == TYPE_STRUCT
        return
    if primitive_name_from_type(p.param_type) == null
        return
    var len: i32 = 0
    let got: *u8 = cc_struct_value(s, a, @len)
    if got != null and cc_kind_error(s, a, fname, flen, argno, p) == 1
        eprints_cstr(c"a `")
        eprint_bytes(got, len)
        eprints_cstr(c"`\n")

# Method call `e` (`r.m(..)`, `T.m(..)`, or a UFCS helper's `v.push(..)`),
# against `fd`, the callee emit_expr_method dispatches it to (where it calls
# note_method_callee).  As ritz0 counts it (#3319), the call is its desugaring
# `m(r, ..)`: with `recv` 1 the receiver is argument 1 and fills the first
# param; a static call (`recv` 0) has none.  Arity is reported at the call.
pub fn call_check_method(s: *EmitterState, e: *Expr, fd: *FnDef, recv: i32)
    if fd == null
        return
    let want: i32 = cc_count_params(fd.params)
    let given: i32 = cc_count_args(e.args) + recv
    if want != given
        if cc_report(s, e.span.line, e.span.col) == 1
            eprint_char('`')
            eprint_bytes(e.ident_ptr, e.ident_len)
            eprints_cstr(c"` called with ")
            eprint_int(given as i64)
            eprints_cstr(c" argument(s) but defined with ")
            eprint_int(want as i64)
            eprint_char('\n')
        return
    var p: *Param = fd.params
    if recv == 1
        p = p.next
    var a: *Expr = e.args
    var argno: i32 = 1 + recv
    while p != null and a != null
        call_check_kind(s, e.ident_ptr, e.ident_len, argno, a, p)
        p = p.next
        a = a.next
        argno = argno + 1
