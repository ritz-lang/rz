# call_check.ritz - a call's arguments fit its callee (AGAST #1629), on Sema
#
# ritz0 refuses a call with the wrong number of arguments, and one whose
# argument is of another kind than its parameter, at the call.  ritz1 took the
# first silently and turned the second into IR clang refused, pointing at the
# generated .ll.  The shared table is ritz0/test_call_arity_and_type.py.
#
#   known   "Unknown function: f", at the call (AGAST #3255)
#   arity   "`f` called with N argument(s) but defined with M", at the call
#   kind    "argument N of `f` has the wrong type: ...", at the argument
#           (a nameless callee is `<expression>`, as in ritz0; #3348)
#   private "`f` is private to a.ritz; mark it `pub` (#3413)", at the call, and
#           a note at the declaration (AGAST #3419, LARB R45a; ritz0's #3418)
#   points  "argument N of `f` has the wrong type: T* != S*" / an array's
#           mismatch, at the call (AGAST #4173; "What an argument points at")
#   borrow  "argument N of `f` has the wrong type: a `:&` parameter ...", at
#           the argument (AGAST #2335, #4244; "A bare argument to a `:&` param")
#
# AGAST #3503 (#1816): these run on Sema, from sema_walk at each call, not in
# the emitter.  A refused call stops the compile before emission, so the
# emitter only lowers calls whose callee is known and whose arguments fit.
# Sema resolves each call's callee the way emit_expr_call and
# emit_expr_method dispatch it: the builtins and variant constructors they
# lower inline are no calls here, a local holding a fn value is called
# through its signature, and a method goes to its receiver type's UFCS
# helper, else its impl method, else a specialised generic impl method.
#
# A method call counts as `m(r, ..)`, its receiver argument 1, as ritz0 does
# (#3319); a static call has no receiver.
#
# ritz0 spells the rest of a kind error in llvmlite's types; ritz1 names the
# parameter and what it got.  The kind rule is only what is wrong whatever the
# compiler makes of it, and is silent when Sema can't tell (BK_UNSURE):
#
#   a by-value struct param   gets an integer (LARB R47, §9.2: even into a
#                             single-field struct, where a method or UFCS
#                             call used to box it; cc_sure_int, and
#                             cc_boxed for what it can't vouch for,
#                             R47b), a `bool`, a float, `null`, a
#                             c-string, or a pointer to something
#                             else (one to the same struct is ref_check's
#                             "doesn't fit a by-value slot")
#   an int, float or bool     gets a struct value
#   a `*Q` param              gets a struct value of another type than Q
#                             (#3340); one of Q is ref_check's "doesn't fit a
#                             reference slot", as is anything into an `@Q`
#
# An enum into an integer param is enum_as_int's, which runs on free, method
# and static calls alike.
#
# A pointer into an integer is left alone: it's a ptrtoint.  So is a
# `Span<T>` param given `@a` or `@v`, and a StrView given a pointer
# to an array (#3335): those are coercions.

import ritzlib.sys
import ritzlib.io

import ast
import types
import diag          # the error prefix (AGAST #3445)
import ast_helpers
import interp        # interp_lit_has_placeholder (AGAST #4381)
import main_abi      # main_abi_call_msg (AGAST #4198)
import ast_query     # name_eq, eprint_bytes, mem_builtin_id, is_tagged_enum_type,
                     # LocalVar and the array-dims helpers, lent_self_call_view_in
                     # (AGAST #4391: was resolved through emitter_core / emitter_expr_call)
import sema
import sema_type
import bool_check    # BK_*, bk_of_type, sema_bool_kind and its sbk_* readers
import tail_value    # tail_note_callee (AGAST #3511)
import ref_check     # RefEnv, ref_local_in, rs_field (AGAST #4173)
import ritzlib.memory
import ritzlib.str

# >0 inside an operand emit_expr_call never lowers (`sizeof(x)`, a
# non-literal `print(x)`): its calls aren't judged.
var g_cc_mute: i32 = 0

# 1 when `e`'s arguments are never lowered, so their calls aren't judged.
pub fn call_check_mutes(e: *Expr) -> i32
    if e.kind != EXPR_CALL or e.func_name_len == 0
        return 0
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"sizeof"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"print"), len: (5) as i64 }) == 0 and name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"eprint"), len: (6) as i64 }) == 0
        return 0
    if e.args == null
        return 0
    (e.args.kind != EXPR_STRING_LIT and e.args.kind != EXPR_CSTRING_LIT) as i32

pub fn call_check_mute(delta: i32)
    g_cc_mute = g_cc_mute + delta

# 1 inside `sizeof(..)` / a non-literal `print(..)`: nothing there is lowered.
pub fn call_check_muted() -> i32
    (g_cc_mute > 0) as i32

# The last place reported, so a call judged twice is said once.
var g_cc_fn: *FnDef = null
var g_cc_line: i32 = 0
var g_cc_col: i32 = 0

# `path:line:col: error: ` the first time this place is reported, counting the
# error; 0 when it was said already.
fn cc_report(sm: *Sema, line: i32, col: i32) -> i32
    let f: *FnDef = sm.cur_fn
    if g_cc_fn == f and g_cc_line == line and g_cc_col == col
        return 0
    g_cc_fn = f
    g_cc_line = line
    g_cc_col = col
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm), diag_span(line, col))
    1

fn cc_count_params(p: *Param) -> i32
    var n: i32 = 0
    var q: *Param = p
    while q != null
        n = n + 1
        q = q.next
    n

fn cc_count_args(a: *Expr) -> i32
    var n: i32 = 0
    var x: *Expr = a
    while x != null
        n = n + 1
        x = x.next
    n

# The part of `path` after its last '/'.
fn cc_basename(path: *u8) -> *u8
    var base: *u8 = path
    var q: *u8 = path
    while *q != 0
        if *q == '/'
            base = q + 1
        q = q + 1
    base

# AGAST #3419 (LARB R45a, LANGUAGE_SPEC §15.2): a call to `fd`, declared
# without `pub` in another file, refused at line:col as ritz0 refuses it
# (#3418), with a note at the declaration: a basename alone is ambiguous
# across packages.  `owner` is the impl's type for a method (`P.get`), null
# for a free call (`helper`, the mangled `P_get`).  1 when refused.
#
# The caller's file is the walked fn's: an instance of another file's
# generic carries that file (specialize copies def_file), so its calls are
# that file's own.  Not checked, as in ritz0: an `extern fn` (no body) and a
# written `fn .. = extern` (extern_decl: a symbol defined elsewhere; an
# import's stripped bodies are checked), monomorph instances (is_pub,
# set by specialize), a generated `E.from`, and a fn whose file isn't known.
fn cc_private(sm: *Sema, line: i32, col: i32, owner: *ImplBlock, name_sv: StrView, fd: *FnDef) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if fd == null or fd.is_pub == 1 or fd.body == null or fd.extern_decl == 1
        return 0
    if fd.from_generated == 1 or fd.def_file == null
        return 0
    var here: *u8 = null
    if sm.cur_fn != null
        here = sm.cur_fn.def_file
    if here == null
        here = sm.file
    if here == null or streq(here, fd.def_file)
        return 0
    if cc_report(sm, line, col) == 1
        for round in 0..2
            if round == 1
                eprints_cstr(fd.def_file)
                eprint_char(':')
                eprint_int(fd.line as i64)
                eprint_char(':')
                eprint_int(fd.col as i64)
                eprints_cstr(c": note: ")
            eprint_char('`')
            if owner != null
                eprint_bytes(StrView { ptr: (owner.type_name), len: (owner.type_name_len) as i64 })
                eprint_char('.')
            eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
            if round == 0
                eprints_cstr(c"` is private to ")
                eprints_cstr(cc_basename(fd.def_file))
                eprints_cstr(c"; mark it `pub` (#3413)\n")
            else
                eprints_cstr(c"` is declared here\n")
    1

# A call to `name` that no declared, imported or `extern` fn answers,
# refused at the call as ritz0 says it.  ritz1 used to declare `@name(...)`
# and leave it to the no-libc link, whose "undefined reference" names no
# line.  `syscallN` and `cpuid_raw` are no exception: they are ordinary fns
# (ritzlib.sys, cryptosec.cpuid; #3397).  A generic call `nope<i64>(x)` is
# named without its `$i64` (#3667).
fn cc_unknown(sm: *Sema, e: *Expr)
    if cc_report(sm, e.span.line, e.span.col) == 1
        # AGAST #3934: `heap e` calls ritzlib.memory's __heap_new, as
        # ritz0's needs its malloc, and is refused in ritz0's words.
        if is_heap_new(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1
            eprints_cstr(c"heap requires ritzlib.memory (malloc not found)\n")
            return
        eprints_cstr(c"Unknown function: ")
        eprint_bytes(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        eprint_char('\n')

# `name(args)`, a call to `fd`, reported at line:col in ritz0's words: a
# private fn of another file (#3419), else the argument count.  1 when
# refused, so the caller doesn't pair the arguments up.
fn cc_arity(sm: *Sema, line: i32, col: i32, name_sv: StrView, fd: *FnDef, args: *Expr) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if cc_private(sm, line, col, null, StrView { ptr: (name), len: (len) as i64 }, fd) == 1
        return 1
    let m: i32 = cc_count_params(fd.params)
    let n: i32 = cc_count_args(args)
    if m == n
        return 0
    if cc_report(sm, line, col) == 1
        eprint_char('`')
        eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
        eprints_cstr(c"` called with ")
        eprint_int(n as i64)
        eprints_cstr(c" argument(s) but defined with ")
        eprint_int(m as i64)
        eprint_char('\n')
    1

fn cc_int_type(t: i32) -> i32
    return (ty_is_int(t) == 1) as i32

# The `name:& T` param `e` names, the emitter's lent_local (LocalVar.is_lent,
# AGAST #2250): a `:&` param of an integer, struct or array T.  Null else.
fn cc_lent(sm: *Sema, e: *Expr) -> *Param
    if e == null or e.kind != EXPR_IDENT
        return null
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if v == null or v.lent == null
        return null
    let p: *Param = v.lent
    if p.is_borrow != 1 or p.param_type != TYPE_MUT_REF
        return null
    let pt: i32 = p.param_pointee_type
    if pt != TYPE_STRUCT and pt != TYPE_ARRAY and is_borrow_scalar_kind(pt) == 0
        return null
    p

# The `h:& T` param `e` names when T is an integer or `bool` (AGAST #2972):
# `*h` is `h`.  The emitter's lent_scalar_ident.
fn cc_lent_scalar(sm: *Sema, e: *Expr) -> i32
    if e == null or e.kind != EXPR_IDENT
        return 0
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if v == null or v.lent == null
        return 0
    let p: *Param = v.lent
    if p.is_borrow != 1 or p.param_type != TYPE_MUT_REF
        return 0
    (p.param_pointee_type == TYPE_BOOL or is_borrow_scalar_kind(p.param_pointee_type) == 1) as i32

# The struct a `:&` param `e` borrows, or null: `c:& C` (lent_struct_local).
fn cc_lent_struct(sm: *Sema, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    let p: *Param = cc_lent(sm, e)
    if p == null or p.param_pointee_type != TYPE_STRUCT
        return null
    *out_len = p.param_type_name_len
    p.param_type_name

# 1 if `p` surely points at an integer: a pointer or borrow local to one, a
# `*i64` field, or either plus an offset (`p + i`).
fn cc_int_pointer(sm: *Sema, p: *Expr) -> i32
    if p.kind == EXPR_IDENT
        if cc_lent_scalar(sm, p) == 1
            return 1
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
        if v != null and v.kind != TYPE_ARRAY
            if v.kind != TYPE_PTR and v.kind != TYPE_REF and v.kind != TYPE_MUT_REF
                return 0
            return cc_int_type(v.pointee)
        return 0
    if p.kind == EXPR_MEMBER
        let f: *StructField = sbk_member_field(sm, p)
        if f != null and f.field_type == TYPE_PTR
            return cc_int_type(f.array_elem_type)
        return 0
    if p.kind == EXPR_BINARY and (p.op == OP_ADD or p.op == OP_SUB)
        return cc_int_pointer(sm, p.left)
    0

# 1 if `a`, which sema_bool_kind calls BK_INT, surely is an integer: a
# literal, a cast, a name, a call or method whose callee it resolved, `*p` of
# an integer pointer or borrow, a member read, an element of a name or field
# whose element type is known, and arithmetic or `-` / `~` of these (LARB
# R47b, #3420).
fn cc_sure_int(sm: *Sema, a: *Expr) -> i32
    let k: i32 = a.kind
    if k == EXPR_INT_LIT or k == EXPR_CHAR_LIT or k == EXPR_CAST or k == EXPR_IDENT
        return 1
    if k == EXPR_CALL or k == EXPR_METHOD or k == EXPR_MEMBER
        return 1
    if k == EXPR_BINARY
        return (sema_bool_kind(sm, a.left) == BK_INT and cc_sure_int(sm, a.left) == 1 and sema_bool_kind(sm, a.right) == BK_INT and cc_sure_int(sm, a.right) == 1) as i32
    if k == EXPR_UNARY and (a.op == OP_NEG or a.op == OP_BIT_NOT)
        return cc_sure_int(sm, a.operand)
    if k == EXPR_UNARY and a.op == OP_DEREF and a.operand != null
        return cc_int_pointer(sm, a.operand)
    if k == EXPR_INDEX and a.left != null
        let base: *Expr = a.left
        if base.kind == EXPR_IDENT
            return (sbk_element(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 }) == BK_INT) as i32
        if base.kind == EXPR_MEMBER
            let f: *StructField = sbk_member_field(sm, base)
            if f != null and f.field_type == TYPE_ARRAY
                return cc_int_type(f.array_elem_type)
    0

# The struct argument `a` statically points at, or null (the emitter's
# arg_pointee_struct, AGAST #1948): `@x` / `@&x` of a struct local, a `:&`
# struct param or a struct field; `x` a local `*T` / `@T` / `@&T`, T a struct.
# Anything else is null: it fails open on shapes it cannot type.
fn cc_pointee_struct(sm: *Sema, a: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    if a.kind == EXPR_UNARY and (a.op == OP_ADDR or a.op == OP_ADDR_MUT)
        let x: *Expr = a.operand
        if x == null
            return null
        if x.kind == EXPR_IDENT
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if v == null
                return null
            if v.kind == TYPE_STRUCT
                name = v.type_name
                len = v.type_name_len
            else
                name = cc_lent_struct(sm, x, @len)
        else if x.kind == EXPR_MEMBER
            let f: *StructField = sbk_member_field(sm, x)
            if f == null or f.field_type != TYPE_STRUCT
                return null
            name = f.field_type_name
            len = f.field_type_name_len
        else
            return null
    else if a.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (a.ident_ptr), len: (a.ident_len) as i64 })
        if v == null or v.lent != null
            return null
        if v.kind != TYPE_PTR and v.kind != TYPE_REF and v.kind != TYPE_MUT_REF
            return null
        if v.pointee != TYPE_STRUCT
            return null
        name = v.type_name
        len = v.type_name_len
    else
        return null
    if name == null or len <= 0 or sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) == null
        return null
    *out_len = len
    name

# What `a` is when it can't be the by-value struct `want`, in words; null when
# it can be, or Sema can't tell.
fn cc_not_a_struct(sm: *Sema, a: *Expr, want_sv: StrView) -> *u8
    var want: *u8 = want_sv.ptr
    var want_len: i32 = want_sv.len as i32
    if a.kind == EXPR_NIL_LIT
        return c"`null`"
    if a.kind == EXPR_CSTRING_LIT
        return c"a `*u8`"
    let k: i32 = sema_bool_kind(sm, a)
    if k == BK_FLOAT
        return c"a float"
    # Nothing converts to a struct, not even a single-field one (LARB R47,
    # §9.2, #3390).
    if k == BK_INT and cc_sure_int(sm, a) == 1
        return c"an integer"
    # Nor any other scalar (LARB R47b, #3420): a bool says so whatever its form.
    if k == BK_BOOL
        return c"a `bool`"
    if k != BK_PTR
        return null
    # A Span is built from `@a` / `@v` (coerce_array_to_span).
    if want_len > 5 and memcmp(want, c"Span$", 5) == 0
        return null
    # A `c:& C` local reads as the C it borrows (#2250): another struct than
    # `want` is let_check's (#3294).
    if cc_lent(sm, a) != null
        return null
    var plen: i32 = 0
    let pointee: *u8 = cc_pointee_struct(sm, a, @plen)
    if pointee != null
        if name_eq(StrView { ptr: (pointee), len: (plen) as i64 }, StrView { ptr: (want), len: (want_len) as i64 }) == 1
            return null   # ref_check's "doesn't fit a by-value slot"
        return c"a pointer"
    # A local `*u8` / `*i32` ...: a pointer to no struct at all.  A `*[N]u8`
    # makes a StrView in ritz0, so a pointer to an array isn't judged.
    if a.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (a.ident_ptr), len: (a.ident_len) as i64 })
        if v != null and v.lent == null and v.kind == TYPE_PTR and v.pointee != TYPE_STRUCT and v.pointee != TYPE_VOID and v.pointee != TYPE_ARRAY and v.pointee != TYPE_UNKNOWN
            return c"a pointer"
    null

# The known struct `a` is a value of, or null.
fn cc_struct_value(sm: *Sema, a: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    # A `c:& C` param is a TYPE_MUT_REF local naming its referent (#2250).
    let lent: *Param = cc_lent(sm, a)
    if lent != null
        if lent.param_pointee_type != TYPE_STRUCT
            return null
        name = lent.param_type_name
        len = lent.param_type_name_len
    else if a.kind == EXPR_STRING_LIT
        # A bare literal lowers to a %Span$u8 (AGAST #98), and is named so.
        name = c"Span$u8"
        len = 7
    else if sema_bool_kind(sm, a) == BK_OTHER
        sbk_receiver(sm, a, @name, @len)
    if name == null or len <= 0 or sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) == null
        return null
    *out_len = len
    name

fn cc_kind_error(sm: *Sema, a: *Expr, fname_sv: StrView, argno: i32, p: *Param) -> i32
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    if cc_report(sm, a.span.line, a.span.col) == 0
        return 0
    eprints_cstr(c"argument ")
    eprint_int(argno as i64)
    eprints_cstr(c" of `")
    eprint_bytes(StrView { ptr: (fname), len: (flen) as i64 })
    eprints_cstr(c"` has the wrong type: parameter ")
    # A `fn(..)` type names no params (#3348): number the one it missed.
    if p.name_len > 0
        eprint_char('`')
        eprint_bytes(StrView { ptr: (p.name), len: (p.name_len) as i64 })
        eprint_char('`')
    else
        eprint_int(argno as i64)
    eprints_cstr(c" is declared `")
    if p.param_type == TYPE_PTR
        eprint_char('*')
        eprint_bytes(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else if p.param_type == TYPE_STRUCT
        eprint_bytes(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else
        eprints_cstr(primitive_name_from_type(p.param_type))
    eprints_cstr(c"` but its argument is ")
    1

# Argument `argno` of `fname`, `a`, for param `p`.
fn cc_kind(sm: *Sema, fname_sv: StrView, argno: i32, a: *Expr, p: *Param)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    if a == null or p == null or p.is_borrow == 1
        return
    let pk: i32 = bk_of_type(p.param_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    if p.param_type == TYPE_STRUCT and pk == BK_OTHER
        if sema_find_struct(sm, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == null
            return
        # A `c"..."` into a StrView / `Span<u8>` is literal_slot's, said at
        # this argument already (AGAST #3440).
        if a.kind == EXPR_CSTRING_LIT and (name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 }) == 1)
            return
        let what: *u8 = cc_not_a_struct(sm, a, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        if what != null and cc_kind_error(sm, a, StrView { ptr: (fname), len: (flen) as i64 }, argno, p) == 1
            eprints_cstr(what)
            eprint_char('\n')
        return
    # A `*Q` param given a known struct value of another type (#3340).  One of
    # Q itself is ref_check's ("a value doesn't fit a reference slot"), as is
    # anything into an `@Q`, which is TYPE_REF and not judged here.
    if p.param_type == TYPE_PTR and p.param_pointee_type == TYPE_STRUCT
        if p.param_type_name == null or p.param_type_name_len <= 0
            return
        if sema_find_struct(sm, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == null
            return
        # A bare literal is a StrView (#98), lowered as a %Span$u8: into a
        # `*StrView` / `*Span<u8>` it is a value of Q, ref_check's to refuse.
        if a.kind == EXPR_STRING_LIT and (name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 }) == 1)
            return
        var vlen: i32 = 0
        let val: *u8 = cc_struct_value(sm, a, @vlen)
        if val == null or name_eq(StrView { ptr: (val), len: (vlen) as i64 }, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 1
            return
        if cc_kind_error(sm, a, StrView { ptr: (fname), len: (flen) as i64 }, argno, p) == 1
            eprints_cstr(c"a `")
            eprint_bytes(StrView { ptr: (val), len: (vlen) as i64 })
            eprints_cstr(c"`\n")
        return
    if (pk != BK_INT and pk != BK_FLOAT and pk != BK_BOOL) or p.param_type == TYPE_STRUCT
        return
    if primitive_name_from_type(p.param_type) == null
        return
    var len: i32 = 0
    let got: *u8 = cc_struct_value(sm, a, @len)
    if got != null and cc_kind_error(sm, a, StrView { ptr: (fname), len: (flen) as i64 }, argno, p) == 1
        eprints_cstr(c"a `")
        eprint_bytes(StrView { ptr: (got), len: (len) as i64 })
        eprints_cstr(c"`\n")

# Each argument of `fname(args)` against `params`, numbered from `argno`.
fn cc_kinds(sm: *Sema, fname_sv: StrView, argno: i32, params: *Param, args: *Expr)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    var p: *Param = params
    var a: *Expr = args
    var n: i32 = argno
    while p != null and a != null
        cc_kind(sm, StrView { ptr: (fname), len: (flen) as i64 }, n, a, p)
        p = p.next
        a = a.next
        n = n + 1

# --- The newtype box (LARB R47b, §9.2, #3420) -----------------------------------
#
# A method or UFCS call's arg cascade used to store an integer it found for a
# by-value struct param into the struct.  Nothing converts to a struct, so an
# integer there is refused, at the argument, whatever form cc_sure_int didn't
# vouch for: `a.add(i * 1)`.  Said once: rule A at the same place wins.

# A tagged or user enum, or `usize`, is never a scalar newtype.
fn cc_unboxed_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    if user_enum_index(StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    (name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"usize"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"isize"), len: (5) as i64 }) == 1) as i32

# 1 if `a` already is a struct value, which the cascade passes as it is (the
# emitter's arg_is_struct_value): a struct literal (#1362), `*p` of a `*S` /
# `@S` / `@&S` (AGAST #2560), a call or method returning a struct (#2413,
# #3241), an element of a `[N]S` or a Vec<S> (#3420).
fn cc_struct_arg(sm: *Sema, a: *Expr) -> i32
    if a.kind == EXPR_STRUCT_LIT
        return 1
    var fd: *FnDef = null
    if a.kind == EXPR_CALL and a.func_name_len > 0
        fd = cc_named_fn(sm, a)
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (a.func_name), len: (a.func_name_len) as i64 })
        if v != null
            fd = v.fn_sig
    else if a.kind == EXPR_METHOD
        fd = sbk_method_def(sm, a)
    if fd != null
        return (fd.return_type == TYPE_STRUCT and sema_find_struct(sm, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }) != null) as i32
    if (a.kind == EXPR_UNARY and a.op == OP_DEREF) or a.kind == EXPR_INDEX
        var name: *u8 = null
        var len: i32 = 0
        sbk_receiver(sm, a, @name, @len)
        return (name != null and len > 0 and sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) != null) as i32
    0

fn cc_boxed(sm: *Sema, e: *Expr, argno: i32, a: *Expr, p: *Param, span_ok: i32)
    if a == null or p == null or p.is_borrow == 1
        return
    if p.param_type != TYPE_STRUCT or p.param_type_name == null or p.param_type_name_len <= 0
        return
    if is_primitive_type_name(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 1
        return
    if cc_unboxed_name(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 1
        return
    # The method cascade builds a Span param before it would box (#2305).
    if span_ok == 1 and p.param_type_name_len > 5 and memcmp(p.param_type_name, c"Span$", 5) == 0
        return
    if sema_find_struct(sm, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == null
        return
    if cc_struct_arg(sm, a) == 1
        return
    if sema_bool_kind(sm, a) != BK_INT and sema_is_int_kind(sema_expr_type(sm, a)) == 0
        return
    if cc_kind_error(sm, a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, argno, p) == 1
        eprints_cstr(c"an integer\n")

# Method call `e` (`r.m(..)`, `T.m(..)`, or a UFCS helper's `v.push(..)`),
# against `fd`.  As ritz0 counts it (#3319), the call is its desugaring
# `m(r, ..)`: with `recv` 1 the receiver is argument 1 and fills the first
# param; a static call (`recv` 0) has none.  Arity is reported at the call,
# after a private method of another file (#3419), at the method's name.
fn cc_method(sm: *Sema, e: *Expr, fd: *FnDef, recv: i32)
    # At the method's name, as ritz0's name_span: the parser's `bracket`.
    var at: SrcSpan = e.span
    if e.bracket.line > 0
        at = e.bracket
    if cc_private(sm, at.line, at.col, sema_impl_of(sm, fd), StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, fd) == 1
        return
    let want: i32 = cc_count_params(fd.params)
    let given: i32 = cc_count_args(e.args) + recv
    if want != given
        if cc_report(sm, e.span.line, e.span.col) == 1
            eprint_char('`')
            eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            eprints_cstr(c"` called with ")
            eprint_int(given as i64)
            eprints_cstr(c" argument(s) but defined with ")
            eprint_int(want as i64)
            eprint_char('\n')
        return
    var p: *Param = fd.params
    if recv == 1
        p = p.next
    cc_kinds(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, 1 + recv, p, e.args)
    ca_args(sm, e, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, 1 + recv, p, e.args)   # AGAST #4173

# --- Free calls ------------------------------------------------------------------

# AGAST #3933: `print` / `eprint` take one string literal (LANGUAGE_SPEC's
# expect-error), as ritz0 says: "print() requires a single string literal
# argument", at the argument, or at the call when there isn't exactly one.
# The emitter used to lower a non-literal one to nothing.
fn cc_print_arg(sm: *Sema, e: *Expr)
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"print"), len: (5) as i64 }) == 0 and name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"eprint"), len: (6) as i64 }) == 0
        return
    var line: i32 = e.span.line
    var col: i32 = e.span.col
    if e.args != null and e.args.next == null
        if e.args.kind == EXPR_STRING_LIT or e.args.kind == EXPR_CSTRING_LIT
            return
        line = e.args.span.line
        col = e.args.span.col
    if cc_report(sm, line, col) == 0
        return
    eprint_bytes(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    eprints_cstr(c"() requires a single string literal argument\n")

# 1 for a name emit_expr_call lowers inline before it looks for a fn: the
# print / format / alloca / sizeof builtins, the SIMD and x86 intrinsics,
# the memory builtins.
fn cc_builtin(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"print"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"eprint"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"format_into"), len: (11) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"__builtin_alloca"), len: (16) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"sizeof"), len: (6) as i64 }) == 1
        return 1
    if len > 5 and memcmp(name, c"simd_", 5) == 0
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_loadu"), len: (10) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_load"), len: (9) as i64 }) == 1
            return 1
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_storeu"), len: (11) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_store"), len: (10) as i64 }) == 1
            return 1
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_xor"), len: (8) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_add"), len: (8) as i64 }) == 1
            return 1
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_extract"), len: (12) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_insert"), len: (11) as i64 }) == 1
            return 1
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_shuffle"), len: (12) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_rotl"), len: (9) as i64 }) == 1
            return 1
        if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_sad"), len: (8) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_clmul"), len: (10) as i64 }) == 1
            return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"sha256rnds2"), len: (11) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"sha256msg1"), len: (10) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"sha256msg2"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesenc"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesenclast"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesdec"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesdeclast"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesimc"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aeskeygenassist"), len: (15) as i64 }) == 1
        return 1
    (mem_builtin_id(StrView { ptr: (name), len: (len) as i64 }) != 0) as i32

# 1 for a println/eprintln/write/writeln call emit_expr_call lowers through
# Display (AGAST #4381): the literal ritz0 reads as an InterpString, in the
# position the special case names. Anything else is the ordinary function.
fn cc_interp_literal_call(e: *Expr) -> i32
    let n: *u8 = e.func_name
    let l: i32 = e.func_name_len
    if name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"println"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"eprintln"), len: (8) as i64 }) == 1
        if e.args != null and e.args.next == null
            return interp_lit_has_placeholder(e.args)
        return 0
    if name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"write"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"writeln"), len: (7) as i64 }) == 1
        if e.args != null and e.args.next != null and e.args.next.next == null
            return interp_lit_has_placeholder(e.args.next)
        return 0
    0

# 1 for a call that builds an enum variant, which emit_expr_call lowers
# before it looks for a fn: `Some` / `Ok` / `None` / `Err`, a user enum's
# unit or one-payload variant (AGAST #1797, #1610), a name two enums declare
# (#2039, the ambiguity error), and a generic enum's variant no fn shares
# (#3021, #2422: its slot names the instance).
fn cc_variant_ctor(sm: *Sema, e: *Expr) -> i32
    let name: *u8 = e.func_name
    let len: i32 = e.func_name_len
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1
        return 1
    var a: i32 = 0
    var b: i32 = 0
    if user_variant_ctor_ambiguous(e, @a, @b) == 1
        return 1
    var en: *u8 = null
    var en_len: i32 = 0
    user_variant_ctor_enum(e, @en, @en_len)
    if en != null
        return 1
    var vi: i32 = 0
    if generic_enum_of_variant(StrView { ptr: (name), len: (len) as i64 }, @vi) >= 0
        return 1
    # AGAST #4153: `Z(1)` / `One()`, refused by emit_expr_call with the count.
    var mei: i32 = 0
    if user_variant_ctor_miscounted(e, @mei, @vi) == 1 and cc_named_fn(sm, e) == null
        return 1
    0

# The fn `name` + its generic suffix names: a fn, else an impl method by its
# `Type_method` symbol (R10, AGAST #2447), as emit_expr_call looks it up.
fn cc_named_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.call_type_suffix_len <= 0
        let f: *FnDef = sema_find_fn(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if f != null
            return f
        return find_impl_method_by_symbol(sm.module, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    let n: i32 = e.func_name_len + e.call_type_suffix_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + n) = 0
    var fd: *FnDef = sema_find_fn(sm, StrView { ptr: (buf), len: (n) as i64 })
    if fd == null
        fd = find_impl_method_by_symbol(sm.module, StrView { ptr: (buf), len: (n) as i64 })
    free(buf)
    fd

# The full name of `e`'s callee (`vec_new$u8`), as its errors spell it.
fn cc_full_name(e: *Expr, out_len: *i32) -> *u8
    *out_len = e.func_name_len + e.call_type_suffix_len
    if e.call_type_suffix_len <= 0
        return e.func_name
    let buf: *u8 = malloc(*out_len as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + *out_len) = 0
    buf

# AGAST #4198: a call to `main` once main took the entry adapter.  `main` is
# then the adapter, `(argc, argv, envp)`; the user's fn is `__ritz_main`
# (main_abi_rename), whose only caller is the adapter.  Refused at the call
# in ritz0's words (main_abi.MSG_CALL).  1 when refused.
fn cc_adapted_main(sm: *Sema, e: *Expr) -> i32
    if e.call_type_suffix_len > 0 or name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"main"), len: (4) as i64 }) == 0
        return 0
    if sema_find_fn(sm, StrView { ptr: (c"__ritz_main"), len: (11) as i64 }) == null   # main_abi_rename's name
        return 0
    if cc_report(sm, e.span.line, e.span.col) == 1
        eprints_cstr(main_abi_call_msg())
        eprint_char('\n')
    1

# A call `f(args)` (EXPR_CALL), before its arguments are walked.
pub fn call_check_call(sm: *Sema, e: *Expr)
    if g_cc_mute > 0
        return
    if e.func_name_len == 0
        # `fs[i](..)`, through a fn value of a known signature (AGAST #1747),
        # named `<expression>` as ritz0 names it (#3348).
        let sig: *FnDef = sbk_value_fn_sig(sm, e.left)
        if sig != null and cc_arity(sm, e.span.line, e.span.col, StrView { ptr: (c"<expression>"), len: (12) as i64 }, sig, e.args) == 0
            cc_kinds(sm, StrView { ptr: (c"<expression>"), len: (12) as i64 }, 1, sig.params, e.args)
            ca_args(sm, e, StrView { ptr: (c"<expression>"), len: (12) as i64 }, 1, sig.params, e.args)
        return
    if cc_variant_ctor(sm, e) == 1
        return
    if cc_builtin(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1 or cc_interp_literal_call(e) == 1
        cc_print_arg(sm, e)
        return
    var full_len: i32 = 0
    let full: *u8 = cc_full_name(e, @full_len)
    var fd: *FnDef = null
    # A local of the name is the callee (AGAST #2246, #2407): a typed fn
    # value through its signature; an untyped one isn't judged.
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if v != null and e.call_type_suffix_len == 0
        if v.fn_sig == null
            return
        fd = v.fn_sig
    else
        if cc_adapted_main(sm, e) == 1
            return
        fd = cc_named_fn(sm, e)
        if fd == null
            cc_unknown(sm, e)
            return
        if v == null
            tail_note_callee(e, fd)   # AGAST #3511: a procedure in a tail
    if cc_arity(sm, e.span.line, e.span.col, StrView { ptr: (full), len: (full_len) as i64 }, fd, e.args) == 1
        return
    # R10's `C_get(c)` of a `self:&` method (AGAST #3260, #3278) lends c:
    # that param is a bare `self:&` or an `@&C`, neither of which cc_kind
    # judges, so it needs no lent view here.
    cc_kinds(sm, StrView { ptr: (full), len: (full_len) as i64 }, 1, fd.params, e.args)
    # What each argument points at (AGAST #4173), against the params the
    # emitter lowers the call with: `C_get(c)` lends c to a `self:&`.
    var cf: *FnDef = fd
    if v == null
        cf = lent_self_call_view_in(sm.module, fd)
    ca_args(sm, e, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, 1, cf.params, e.args)

# --- Method calls ----------------------------------------------------------------

# 1 when `x` names a local or a global: a value, not a type.
fn cc_is_value_name(sm: *Sema, x: *Expr) -> i32
    if sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) != null
        return 1
    (sbk_global(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) != null) as i32

# The type an instance method call's receiver dispatches on, as
# emit_expr_method resolves it, or null.
fn cc_recv_type(sm: *Sema, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var recv: *Expr = e.left
    # `(@d).m()` and `(@&d).m()` dispatch on `d` (AGAST #2550).
    while recv.kind == EXPR_UNARY and (recv.op == OP_ADDR or recv.op == OP_ADDR_MUT) and recv.operand != null
        recv = recv.operand
    if recv.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
        if v != null
            *out_len = v.type_name_len
            return v.type_name
        let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
        if g == null
            return null
        if g.var_type == TYPE_STRUCT and g.type_name_len > 0
            *out_len = g.type_name_len
            return g.type_name
        if (g.var_type == TYPE_PTR or g.var_type == TYPE_REF or g.var_type == TYPE_MUT_REF) and g.pointee_type == TYPE_STRUCT and g.pointee_type_name_len > 0
            *out_len = g.pointee_type_name_len
            return g.pointee_type_name
        return null
    if recv.kind == EXPR_STRING_LIT
        *out_len = 7
        return c"StrView"
    if recv.kind == EXPR_STRUCT_LIT
        *out_len = recv.ident_len
        return recv.ident_ptr
    var name: *u8 = null
    var len: i32 = 0
    sbk_receiver(sm, recv, @name, @len)
    if name == null or len <= 0
        return null
    *out_len = len
    name

# 1 for a method emit_expr_method lowers inline on `type_name`: an Option /
# Result's unwrap and predicates, StrView.as_bytes, and the Vec / Span /
# StrView `.len()`.
fn cc_inline_method(type_name_sv: StrView, e: *Expr) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    let m: *u8 = e.ident_ptr
    let ml: i32 = e.ident_len
    if is_tagged_enum_type(StrView { ptr: (type_name), len: (type_name_len) as i64 }) == 1
        if name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"unwrap"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"unwrap_or"), len: (9) as i64 }) == 1
            return 1
        if e.args == null and (name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"is_ok"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"is_err"), len: (6) as i64 }) == 1)
            return 1
        if e.args == null and (name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"is_some"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"is_none"), len: (7) as i64 }) == 1)
            return 1
    if e.args != null
        return 0
    let sv: i32 = name_eq(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    if sv == 1 and name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (m), len: (ml) as i64 }, StrView { ptr: (c"len"), len: (3) as i64 }) == 0
        return 0
    if sv == 1
        return 1
    if type_name_len > 4 and memcmp(type_name, c"Vec$", 4) == 0
        return 1
    (type_name_len > 5 and memcmp(type_name, c"Span$", 5) == 0) as i32

# A method call `r.m(args)` / `T.m(args)` (EXPR_METHOD), after its receiver
# is walked and before its arguments are.
pub fn call_check_method(sm: *Sema, e: *Expr)
    let left: *Expr = e.left
    if left == null or g_cc_mute > 0
        return
    if left.kind == EXPR_IDENT and cc_is_value_name(sm, left) == 0
        # `Opt.Holds(x)`: a variant beats an impl method (AGAST #1466).
        let ei: i32 = enum_find(StrView { ptr: (left.ident_ptr), len: (left.ident_len) as i64 })
        if ei >= 0 and enum_variant_index(StrView { ptr: (left.ident_ptr), len: (left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
            return
        # `Vec2.new(..)`: a static call of the impl's method, no receiver.
        let sm_method: *FnDef = sema_impl_method(sm, StrView { ptr: (left.ident_ptr), len: (left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        tail_note_callee(e, sm_method)   # AGAST #3511
        if sm_method != null and param_is_self(sm_method.params) == 0
            cc_method(sm, e, sm_method, 0)
        return
    var tn_len: i32 = 0
    let tn: *u8 = cc_recv_type(sm, e, @tn_len)
    if tn == null or tn_len <= 0
        return
    if cc_inline_method(StrView { ptr: (tn), len: (tn_len) as i64 }, e) == 1
        return
    var mfn: *FnDef = sema_impl_method(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if mfn == null
        mfn = sema_spec_impl_method(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if mfn == null
        return
    tail_note_callee(e, mfn)   # AGAST #3511
    cc_method(sm, e, mfn, param_is_self(mfn.params))
    # The instance arm's cascade skips the first param, self or not.
    cc_boxed_args(sm, e, mfn.params, 1)

fn cc_boxed_args(sm: *Sema, e: *Expr, params: *Param, span_ok: i32)
    if params == null
        return
    var p: *Param = params.next
    var a: *Expr = e.args
    var argno: i32 = 2
    while p != null and a != null
        cc_boxed(sm, e, argno, a, p, span_ok)
        p = p.next
        a = a.next
        argno = argno + 1

# --- What an argument points at (AGAST #4173) ------------------------------------
#
# The emitter's call check, on Sema: an argument that isn't what its param
# points at is "argument N of `f` has the wrong type", at the call, naming the
# callee and the argument as ritz0 does (#1366).  It printed after the slot
# checks' line on the emitter; since those moved to Sema (#4011) and stop the
# compile, it is said here, after them, in walk order.
#
#   a struct pointer   `p: *T` / `@T` / `@&T` given `@x`, `@&x` or a pointer
#                      local of another struct S: "T* != S*" (AGAST #1948)
#   an array           a whole array where the param takes none, a length
#                      that isn't a `[N]T` param's, an array that isn't the
#                      one an `a:& [N]T` / `@[N]T` / `@&[N]T` points at, or no
#                      array at all (#2287, #2290); `@x` of a `[N]T` not of
#                      u8 / i8 into a StrView, at the argument (#2305, #3349)
#
# Types are read off the image of each local the emitter will make (RsNote.loc,
# ref_local_in), globals and fields as the emitter reads them.  What that
# can't type stays unjudged.  A bare argument into a `:&` param is ca_borrow's
# (AGAST #4244), said instead of the array check's.

fn ca_local(sm: *Sema, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    var env: RefEnv
    var is_local: i32 = 0
    ref_local_in(ref_env_of(@env, null, sm), StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, @is_local)

# 1 when `e` names a local, typed or not.
fn ca_is_local(sm: *Sema, e: *Expr) -> i32
    (e != null and e.kind == EXPR_IDENT and sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null) as i32

fn ca_global(sm: *Sema, e: *Expr) -> *GlobalVarDef
    if e == null or e.kind != EXPR_IDENT or ca_is_local(sm, e) == 1
        return null
    sbk_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# The last argument reported, so an argument judged twice is said once.
var g_ca_call: *Expr = null
var g_ca_argno: i32 = 0

# `path:line:col: error: argument N of `f` has the wrong type: ` at `at`, once
# per argument of `call`; 0 when it was said already.
fn ca_report(sm: *Sema, call: *Expr, at: *Expr, fname_sv: StrView, argno: i32) -> i32
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    if g_ca_call == call and g_ca_argno == argno
        return 0
    g_ca_call = call
    g_ca_argno = argno
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm), at.span)
    eprints_cstr(c"argument ")
    eprint_int(argno as i64)
    eprints_cstr(c" of `")
    eprint_bytes(StrView { ptr: (fname), len: (flen) as i64 })
    eprints_cstr(c"` has the wrong type: ")
    1

fn ca_error(sm: *Sema, call: *Expr, at: *Expr, fname_sv: StrView, argno: i32, why: *u8)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    if ca_report(sm, call, at, StrView { ptr: (fname), len: (flen) as i64 }, argno) == 1
        eprints_cstr(why)
        eprint_char('\n')

# The struct a pointer param `p: *T` / `@T` / `@&T` points at, or null (the
# emitter's param_pointee_struct until AGAST #4173): not a `p:& T`, whose
# argument is a value.
fn ca_param_struct(sm: *Sema, p: *Param, out_len: *i32) -> *u8
    *out_len = 0
    if p == null or p.is_borrow == 1 or p.param_type_name_len <= 0
        return null
    if p.param_type != TYPE_PTR and p.param_type != TYPE_REF and p.param_type != TYPE_MUT_REF
        return null
    if p.param_pointee_type != TYPE_STRUCT or sema_find_struct(sm, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == null
        return null
    *out_len = p.param_type_name_len
    p.param_type_name

# The struct `arg` surely points at, or null (the emitter's arg_pointee_struct):
# `@x` / `@&x` of a struct local, a `c:& C` param or a struct field; `x` a
# local `*T` / `@T` / `@&T`.  Anything else fails open.
fn ca_arg_struct(sm: *Sema, arg: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        let x: *Expr = arg.operand
        if x == null
            return null
        if x.kind == EXPR_IDENT
            let loc: *LocalVar = ca_local(sm, x)
            if loc == null
                return null
            let lent: i32 = (loc.holds_lent_ptr == 1 and loc.pointee_type == TYPE_STRUCT) as i32
            if loc.var_type != TYPE_STRUCT and lent == 0
                return null
            if ca_names_differ(sm, x, loc) == 1
                return null
            name = loc.type_name
            len = loc.type_name_len
        else if x.kind == EXPR_MEMBER
            let f: *StructField = rs_field(sm, x)
            if f == null or f.field_type != TYPE_STRUCT
                return null
            name = f.field_type_name
            len = f.field_type_name_len
        else
            return null
    else if arg.kind == EXPR_IDENT
        let loc: *LocalVar = ca_local(sm, arg)
        if loc == null
            return null
        if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
            return null
        if loc.pointee_type != TYPE_STRUCT or ca_names_differ(sm, arg, loc) == 1
            return null
        name = loc.type_name
        len = loc.type_name_len
    else
        return null
    if name == null or len <= 0 or sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) == null
        return null
    *out_len = len
    name

# 1 when the image of `x` and Sema's own binding name different structs: an
# inferred `let c = v[i]` through a Vec reads as the container (#2443), where
# Sema, which resolved its `.` through Deref, has the element.  Unjudged.
fn ca_names_differ(sm: *Sema, x: *Expr, loc: *LocalVar) -> i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
    if v == null or v.type_name_len <= 0
        return 0
    1 - name_eq(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })

# AGAST #1948: a pointer to struct S where one to T goes.
fn ca_struct_ptr(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    var want_len: i32 = 0
    let want: *u8 = ca_param_struct(sm, p, @want_len)
    if want == null
        return
    var got_len: i32 = 0
    let got: *u8 = ca_arg_struct(sm, arg, @got_len)
    if got == null or name_eq(StrView { ptr: (want), len: (want_len) as i64 }, StrView { ptr: (got), len: (got_len) as i64 }) == 1
        return
    # R79: any async fn's `NAME_Future` fits a pointer to the built-in
    # `Future`, by reference.
    if sema_future_ref_fits(want, want_len, got, got_len) == 1
        return
    if ca_report(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno) == 1
        eprint_bytes(StrView { ptr: (want), len: (want_len) as i64 })
        eprints_cstr(c"* != ")
        eprint_bytes(StrView { ptr: (got), len: (got_len) as i64 })
        eprints_cstr(c"*\n")

# --- Arrays ---

# The `*[N]T` / `@[N]T` / `@&[N]T` local `e` names (array_ptr_local), or null.
fn ca_array_ptr_local(sm: *Sema, e: *Expr) -> *LocalVar
    let loc: *LocalVar = ca_local(sm, e)
    if loc == null or loc.pointee_type != TYPE_ARRAY or loc.pointee_array_size <= 0
        return null
    if loc.var_type == TYPE_ARRAY and loc.is_lent == 1
        return loc
    if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
        return null
    loc

# What a `*[N]T` field, global, call or cast `e` that isn't a local was declared
# as (base_ptr_array), or null.
fn ca_base_ptr_array(sm: *Sema, e: *Expr) -> *Param
    var pa: *Param = null
    if e.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, e)
        if f != null
            pa = f.ptr_array
    else if e.kind == EXPR_IDENT
        let g: *GlobalVarDef = ca_global(sm, e)
        if g != null
            pa = g.ptr_array
    else if e.kind == EXPR_CALL
        let fd: *FnDef = sema_call_fn(sm, e)
        if fd != null
            pa = fd.ret_ptr_array
    else if e.kind == EXPR_CAST
        pa = e.cast_ptr_array
    if pa == null or pa.param_pointee_array_size <= 0 or pa.param_type == TYPE_PTR_PTR
        return null
    pa

# N and T of the `[N]T` that `*e` is, `e` a `*[N]T` local, param, field, global
# (array_ptr_shape).  A step `p + k` isn't judged.
fn ca_array_ptr_shape(sm: *Sema, e: *Expr, out: *ArrayDims) -> i32
    let loc: *LocalVar = ca_array_ptr_local(sm, e)
    if loc != null
        var en_len: i32 = 0
        let en: *u8 = array_ptr_elem_name(loc, @en_len)
        return array_dims_1d(out, loc.pointee_array_size, loc.pointee_array_elem_type, StrView { ptr: (en), len: (en_len) as i64 })
    if e.kind == EXPR_BINARY
        return 0
    let pa: *Param = ca_base_ptr_array(sm, e)
    if pa == null
        return 0
    array_dims_1d(out, pa.param_pointee_array_size, pa.param_pointee_array_elem_type, StrView { ptr: (pa.param_type_name), len: (pa.param_type_name_len) as i64 })

# A whole 1-D array `value` reads (arg_array_shape): a local or by-value param,
# a global, `*@a`, `*p` of a `*[N]T`, a field.
fn ca_array_shape(sm: *Sema, value: *Expr, out: *ArrayDims) -> i32
    if value.kind == EXPR_IDENT
        let loc: *LocalVar = ca_local(sm, value)
        if loc != null
            # An inferred `let b = g(a)` of a generic's `[N]T` keeps no N here.
            if loc.var_type == TYPE_ARRAY and loc.array_shape == null and loc.array_size > 0
                return array_dims_1d(out, loc.array_size, loc.array_elem_type, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
            return 0
        if ca_is_local(sm, value) == 1
            return 0
        let g: *GlobalVarDef = ca_global(sm, value)
        if g != null and g.var_type == TYPE_ARRAY and g.array_shape == null
            return array_dims_1d(out, g.array_size, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        return 0
    if value.kind == EXPR_UNARY and value.op == OP_DEREF and value.operand != null
        let o: *Expr = value.operand
        if o.kind == EXPR_UNARY and (o.op == OP_ADDR or o.op == OP_ADDR_MUT) and o.operand != null
            let x: *Expr = o.operand
            if x.kind == EXPR_IDENT or x.kind == EXPR_UNARY
                return ca_array_shape(sm, x, out)
            return 0
        return ca_array_ptr_shape(sm, o, out)
    if value.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, value)
        if f != null and f.field_type == TYPE_ARRAY and f.array_shape == null
            return array_dims_1d(out, f.array_size, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
    0

# The N-D array a name or field is (nd_array_base_shape), or null.
fn ca_nd_shape(sm: *Sema, base: *Expr) -> *ArrayShape
    if base.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, base)
        if f == null or f.field_type != TYPE_ARRAY
            return null
        return f.array_shape
    if base.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = ca_local(sm, base)
    if loc != null
        if loc.var_type == TYPE_ARRAY
            return loc.array_shape
        return null
    let g: *GlobalVarDef = ca_global(sm, base)
    if g != null and g.var_type == TYPE_ARRAY
        return g.array_shape
    null

# What the place `value` holds (place_array_dims): its dimensions, that it's
# no array, or ARG_DIMS_UNKNOWN.
fn ca_place_dims(sm: *Sema, value: *Expr, out: *ArrayDims) -> i32
    if ca_array_shape(sm, value, out) == 1
        return ARG_DIMS_ARRAY
    if value.kind == EXPR_IDENT
        let sh: *ArrayShape = ca_nd_shape(sm, value)
        if sh != null
            return array_dims_nd(out, sh, 0)
        let loc: *LocalVar = ca_local(sm, value)
        if loc != null and loc.var_type == TYPE_ARRAY
            return ARG_DIMS_UNKNOWN
        if loc != null or ca_global(sm, value) != null
            return ARG_DIMS_NOT_ARRAY
        return ARG_DIMS_UNKNOWN
    if value.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, value)
        if f != null and f.field_type == TYPE_ARRAY and f.array_shape != null
            return array_dims_nd(out, f.array_shape, 0)
        if f != null and f.field_type != TYPE_ARRAY
            return ARG_DIMS_NOT_ARRAY
        return ARG_DIMS_UNKNOWN
    if value.kind == EXPR_INDEX
        # The chain's base and depth (nd_index_shape).  A `[K]*[N][M]T`
        # element, or a plane pointer's, isn't judged.
        var depth: i32 = 0
        var base: *Expr = value
        while base.kind == EXPR_INDEX
            depth = depth + 1
            base = base.left
        let bl: *LocalVar = ca_local(sm, base)
        if bl != null and (bl.array_rec != null or bl.pointee_array_shape != null)
            return ARG_DIMS_UNKNOWN
        let sh: *ArrayShape = ca_nd_shape(sm, base)
        if sh != null
            if depth > sh.rank
                return ARG_DIMS_UNKNOWN
            return array_dims_nd(out, sh, depth)
        # An element of a 1-D array.
        var whole: ArrayDims
        if value.left.kind != EXPR_INDEX and ca_place_dims(sm, value.left, @whole) == ARG_DIMS_ARRAY
            return ARG_DIMS_NOT_ARRAY
    ARG_DIMS_UNKNOWN

# What `arg` points at, for a param that takes an array by address (ref_arg_dims).
fn ca_ref_dims(sm: *Sema, arg: *Expr, out: *ArrayDims) -> i32
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        return ca_place_dims(sm, arg.operand, out)
    if arg.kind == EXPR_IDENT
        let loc: *LocalVar = ca_local(sm, arg)
        if loc != null and loc.var_type != TYPE_ARRAY
            let ploc: *LocalVar = ca_array_ptr_local(sm, arg)
            if ploc != null
                # AGAST #4122: a plane pointer `*[N][M]T` points at its shape.
                if ploc.pointee_array_shape != null and ploc.var_type == TYPE_PTR
                    return array_dims_nd(out, ploc.pointee_array_shape, 0)
                var en_len: i32 = 0
                let en: *u8 = array_ptr_elem_name(ploc, @en_len)
                return array_dims_1d(out, ploc.pointee_array_size, ploc.pointee_array_elem_type, StrView { ptr: (en), len: (en_len) as i64 })
            if loc.is_lent == 1
                return ARG_DIMS_NOT_ARRAY
            # A pointer whose pointee is known and no array (AGAST #2323).
            if loc.var_type == TYPE_PTR or loc.var_type == TYPE_PTR_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
                if loc.pointee_type == TYPE_ARRAY or loc.pointee_type == TYPE_UNKNOWN or loc.pointee_type == TYPE_VOID
                    return ARG_DIMS_UNKNOWN
                return ARG_DIMS_NOT_ARRAY
    ca_place_dims(sm, arg, out)

# AGAST #2290: `a[i]` in the callee trusts the N and T its param declares.
fn ca_array_ref(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    var got: ArrayDims
    let known: i32 = ca_ref_dims(sm, arg, @got)
    if known == ARG_DIMS_UNKNOWN
        return
    if known == ARG_DIMS_NOT_ARRAY
        ca_error(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"the parameter points at an array")
        return
    # A struct element the image doesn't name (`let p = q` of an `@&[3]S`) is unjudged.
    if got.leaf == TYPE_STRUCT and got.name_len <= 0
        return
    var want: ArrayDims
    param_pointee_dims(@want, p)
    if array_dims_match(@got, @want) == 0
        ca_error(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"the array isn't the one the parameter points at")

# 1 when `p` is a StrView.
fn ca_strview(p: *Param) -> i32
    (p.param_type == TYPE_STRUCT and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1) as i32

# 1 when `arg`, into the StrView `p`, is a `[N]u8` / `[N]i8` (bare, `@a`, or a
# `*[N]u8` local, param or field): ritz0 makes it the StrView (strview_array_src).
# 2 when it is `@a` or a `*[N]T` of another element: ritz0's "Type of #1 arg
# mismatch" (the emitter's strview_wrong_array until AGAST #4173).
fn ca_strview_array(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if ca_strview(p) == 0
        return 0
    var src: ArrayDims
    if arg.kind == EXPR_IDENT or arg.kind == EXPR_MEMBER
        if ca_array_ptr_shape(sm, arg, @src) == 1
            if ty_int_bits(src.leaf) == 8
                return 1
            return 2
    var x: *Expr = arg
    let addr: i32 = (x.kind == EXPR_UNARY and (x.op == OP_ADDR or x.op == OP_ADDR_MUT) and x.operand != null) as i32
    if addr == 1
        x = x.operand
    if ca_array_shape(sm, x, @src) == 0
        return 0
    if ty_int_bits(src.leaf) == 8
        return 1
    if addr == 1
        return 2
    0

# --- A bare argument to a `:&` param (AGAST #2335, #4244) ---
#
# LARB R1's second exception: a place of `T` into a `name:& T` param is
# borrowed, as if written `@&x`.  What isn't one passes if it's the pointer to
# one (an `@&T`, a `*T`), else it is refused at the argument:
#
#   a temporary       "a `:&` parameter needs a place to borrow, ..."
#   another type      "this place doesn't hold what the `:&` parameter borrows"
#                     (exactly, not by width: AGAST #2368, #2530)
#   through an `@T`   "a `:&` parameter can't borrow through an `@T`, ..."
#   untypable         "ritz1 can't tell what this argument is: write `@&` ..."
#
# The emitter's check_borrow_arg until AGAST #4244, so a Sema error anywhere
# in the module hid it.  The emitter keeps borrow_arg_kind to lower a place
# to its address; Sema only says what is refused, so where the emitter tells
# a place from a pointer that passes (a `**S` as deep as `:& **S`), both are
# silent here.

const CA_BORROW_PASS: i32 = 0      # a place of `T`, or the pointer to one
const CA_BORROW_RVALUE: i32 = 2
const CA_BORROW_MISFIT: i32 = 3    # a place of something else
const CA_BORROW_UNTYPED: i32 = 4   # ritz1 can't type it
const CA_BORROW_SHARED: i32 = 5    # reached through an `@T`, read-only

# The type of a place, as the emitter's PlaceType: `name` is a struct's, or for
# a pointer the struct it points at.
struct CaPlace
    kind: i32
    pointee: i32
    name: *u8
    name_len: i32

fn ca_place_set(out: *CaPlace, kind: i32, pointee: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = name_len
    1

fn ca_is_pointer(t: i32) -> i32
    (t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF) as i32

# What `*x` gives, for `x` of type `base`.
fn ca_place_deref(base: *CaPlace, out: *CaPlace) -> i32
    var held: i32 = TYPE_UNKNOWN
    if base.name_len > 0
        held = TYPE_STRUCT
    if base.kind == TYPE_PTR_PTR
        return ca_place_set(out, TYPE_PTR, held, StrView { ptr: (base.name), len: (base.name_len) as i64 })
    if ca_is_pointer(base.kind) == 0
        return 0
    ca_place_set(out, base.pointee, held, StrView { ptr: (base.name), len: (base.name_len) as i64 })

# The plane `[N][M]T` a plane pointer local `q` (`*[N][M]T`), or `*r` of an
# `@*[N][M]T` / `**[N][M]T` one, points at (plane_ptr_shape), or null.
fn ca_plane_shape(sm: *Sema, e: *Expr) -> *ArrayShape
    var x: *Expr = e
    var deref: i32 = 0
    if e.kind == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        x = e.operand
        deref = 1
    let loc: *LocalVar = ca_local(sm, x)
    if loc == null or loc.pointee_array_shape == null
        return null
    # Its slot holds the plane pointer's address: only `*r` is the pointer.
    let holds: i32 = (loc.pointee_type == TYPE_PTR and (loc.var_type == TYPE_PTR_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF)) as i32
    if holds == 1 and deref == 0
        return null
    loc.pointee_array_shape

# What `x[i]` gives (place_index_type): the array shapes know what they hold; a
# pointer is `*x`.  An element of a `[K]*[N][M]T` is the emitter's to type.
fn ca_place_index(sm: *Sema, value: *Expr, out: *CaPlace) -> i32
    var depth: i32 = 0
    var base: *Expr = value
    while base.kind == EXPR_INDEX
        depth = depth + 1
        base = base.left
    var sh: *ArrayShape = ca_nd_shape(sm, base)
    if sh == null
        sh = ca_plane_shape(sm, base)
    if sh != null and depth <= sh.rank
        if depth < sh.rank
            return ca_place_set(out, TYPE_ARRAY, TYPE_UNKNOWN, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        return ca_place_set(out, sh.leaf_type, TYPE_UNKNOWN, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    var src: ArrayDims
    if ca_array_shape(sm, value.left, @src) == 1
        var held: i32 = TYPE_UNKNOWN
        if src.name_len > 0
            held = TYPE_STRUCT
        return ca_place_set(out, src.leaf, held, StrView { ptr: (src.name), len: (src.name_len) as i64 })
    var b: CaPlace
    if ca_place_type(sm, value.left, @b) == 0
        return 0
    ca_place_deref(@b, out)

# 1 and `out` when Sema can type the place `e` (place_type_of).
fn ca_place_type(sm: *Sema, e: *Expr, out: *CaPlace) -> i32
    if e.kind == EXPR_IDENT
        if ca_is_local(sm, e) == 1
            let loc: *LocalVar = ca_local(sm, e)
            if loc == null
                return 0
            return ca_place_set(out, loc.var_type, loc.pointee_type, StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 })
        let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if g == null
            return 0
        if ca_is_pointer(g.var_type) == 1
            return ca_place_set(out, g.var_type, g.pointee_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })
        return ca_place_set(out, g.var_type, TYPE_UNKNOWN, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if e.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, e)
        if f == null
            return 0
        return ca_place_set(out, f.field_type, ptr_field_elem_kind(f), StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    if e.kind == EXPR_INDEX
        return ca_place_index(sm, e, out)
    if e.kind == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        var b: CaPlace
        if ca_place_type(sm, find_base_expr(e.operand), @b) == 0
            return 0
        return ca_place_deref(@b, out)
    0

# 1 when `e` is a place: it names storage the caller can see afterwards.  A
# field or element of a call result isn't one.
fn ca_arg_is_place(sm: *Sema, e: *Expr) -> i32
    var root: *Expr = e
    while root.kind == EXPR_MEMBER or root.kind == EXPR_INDEX
        if root.kind == EXPR_INDEX and root.right != null and root.right.kind == EXPR_RANGE
            return 0
        root = root.left
    if root.kind == EXPR_UNARY and root.op == OP_DEREF
        return 1
    if root.kind != EXPR_IDENT
        return 0
    if ca_is_local(sm, root) == 1
        return 1
    (sbk_global(sm, StrView { ptr: (root.ident_ptr), len: (root.ident_len) as i64 }) != null) as i32

# What `arg`, no place, does for `p`: it passes if it's the pointer `p` is.
fn ca_rvalue_borrow(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if arg.kind == EXPR_NIL_LIT or arg.kind == EXPR_CSTRING_LIT
        return CA_BORROW_RVALUE
    var t: i32 = sema_expr_type(sm, arg)
    if arg.kind == EXPR_METHOD
        let m: *FnDef = sbk_method_def(sm, arg)
        if m == null
            return CA_BORROW_UNTYPED
        t = m.return_type
    if t == TYPE_REF
        return CA_BORROW_SHARED
    if p.param_pointee_type == TYPE_PTR
        if t == TYPE_PTR_PTR
            return CA_BORROW_PASS
    else if ca_is_pointer(t) == 1
        return CA_BORROW_PASS
    CA_BORROW_RVALUE

# 1 when the place `e` is an `@T`, or the nearest indirection on its path to the
# root is one.  An `@&T` or `*T` nearer than that makes it writable.
fn ca_behind_shared(sm: *Sema, e: *Expr) -> i32
    var pl: CaPlace
    if ca_place_type(sm, e, @pl) == 1 and pl.kind == TYPE_REF
        return 1
    var at: *Expr = e
    while at != null
        if at.kind == EXPR_MEMBER or at.kind == EXPR_INDEX
            at = at.left
        else if at.kind == EXPR_UNARY and at.op == OP_DEREF
            at = find_base_expr(at.operand)
        else
            return 0
        if ca_place_type(sm, at, @pl) == 1
            if pl.kind == TYPE_REF
                return 1
            if ca_is_pointer(pl.kind) == 1
                return 0
    0

# AGAST #2354: 1 when `arg` names a by-value `@&U` param of the fn walked.
fn ca_ref_param(sm: *Sema, arg: *Expr) -> i32
    if arg.kind != EXPR_IDENT or sm.cur_fn == null
        return 0
    var q: *Param = sm.cur_fn.params
    while q != null
        if q.param_type == TYPE_MUT_REF and q.is_borrow == 0 and name_eq(StrView { ptr: (q.name), len: (q.name_len) as i64 }, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 }) == 1
            return 1
        q = q.next
    0

# 1 when pointer place `pl` is the `*U` that `p`, a `:& *U`, borrows.
fn ca_pointer_fits(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    let want: i32 = p.param_ref_ptr_pointee
    if want == TYPE_VOID or pl.pointee == TYPE_UNKNOWN
        return 1
    # AGAST #3101: `r:& T` at T = `*[N]E` takes a `*[N]E` place, the same N and E.
    if want == TYPE_ARRAY and p.param_pointee_array_size > 0
        if pl.pointee != TYPE_ARRAY
            return 0
        var got: ArrayDims
        if ca_ref_dims(sm, arg, @got) != ARG_DIMS_ARRAY
            return 1
        # A struct element the image doesn't name (a `var q: *[3]S`) is
        # unjudged, as in ca_array_ref.
        if got.leaf == TYPE_STRUCT and got.name_len <= 0
            return 1
        var dims: ArrayDims
        param_pointee_dims(@dims, p)
        return array_dims_match(@got, @dims)
    if want == TYPE_STRUCT or pl.pointee == TYPE_STRUCT
        return (want == pl.pointee and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (pl.name), len: (pl.name_len) as i64 }) == 1) as i32
    # Exactly: a `*u32` isn't the `*i32` (#2530).
    (want == pl.pointee) as i32

# A pointer place into `p`: a `*U` into `:& *U` is a place of `T`; into `:& U`,
# or a `**U` into `:& *U`, it's the pointer to one.  An `@&U` place holds a
# pointer as a `*U` does (#2354); an `@&U` param is no place: ritz0 gives it no
# storage.  (A `**S` into `:& **S`, place or pointer, passes either way: #2372.)
fn ca_pointer_place(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    if p.param_pointee_type != TYPE_PTR
        return CA_BORROW_PASS
    if pl.kind == TYPE_PTR_PTR or pl.pointee == TYPE_PTR
        return CA_BORROW_PASS
    if pl.kind != TYPE_PTR and (pl.kind != TYPE_MUT_REF or ca_ref_param(sm, arg) == 1)
        return CA_BORROW_MISFIT
    if ca_pointer_fits(sm, arg, pl, p) == 1
        return CA_BORROW_PASS
    CA_BORROW_MISFIT

# 1 when the place `arg`, of type `pl`, holds the `T` of `p`: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `:& u32` doesn't take an `i32`.
fn ca_place_fits(sm: *Sema, arg: *Expr, pl: *CaPlace, p: *Param) -> i32
    let pt: i32 = p.param_pointee_type
    if pl.kind != TYPE_ARRAY and pl.kind != TYPE_STRUCT
        # AGAST #2994: a `bool` local is a `bool`, though its slot is an i64.
        let loc: *LocalVar = ca_local(sm, arg)
        if loc != null and loc.is_bool == 1
            return (pt == TYPE_BOOL) as i32
        return (pl.kind == pt) as i32
    if pl.kind == TYPE_STRUCT
        return (pt == TYPE_STRUCT and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (pl.name), len: (pl.name_len) as i64 }) == 1) as i32
    if pt != TYPE_ARRAY
        return 0
    var got: ArrayDims
    var want: ArrayDims
    if ca_place_dims(sm, arg, @got) != ARG_DIMS_ARRAY
        return 0
    param_pointee_dims(@want, p)
    array_dims_match(@got, @want)

# What `arg` is to the `:&` param `p` (the emitter's borrow_arg_kind).
fn ca_borrow_kind(sm: *Sema, arg: *Expr, p: *Param) -> i32
    if p == null or p.is_borrow != 1 or p.param_type != TYPE_MUT_REF
        return CA_BORROW_PASS
    if arg.kind == EXPR_UNARY and (arg.op == OP_ADDR or arg.op == OP_ADDR_MUT)
        return CA_BORROW_PASS
    # An `a:& [N]T` param reads as the pointer it's bound to.
    let lent: *LocalVar = ca_local(sm, arg)
    if lent != null and lent.var_type == TYPE_ARRAY and lent.is_lent == 1
        return CA_BORROW_PASS
    if ca_arg_is_place(sm, arg) == 0
        return ca_rvalue_borrow(sm, arg, p)
    if ca_behind_shared(sm, arg) == 1
        return CA_BORROW_SHARED
    var pl: CaPlace
    if ca_place_type(sm, arg, @pl) == 0 or pl.kind == TYPE_UNKNOWN
        return CA_BORROW_UNTYPED
    if ca_is_pointer(pl.kind) == 1
        return ca_pointer_place(sm, arg, @pl, p)
    if ca_place_fits(sm, arg, @pl, p) == 1
        return CA_BORROW_PASS
    CA_BORROW_MISFIT

# Refuses what can't go in the `:&` param `p`, at the argument.  A misfit into
# an `a:& [N]T` is ca_array_ref's, which says which array it wanted.
fn ca_borrow(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    let k: i32 = ca_borrow_kind(sm, arg, p)
    if k == CA_BORROW_RVALUE
        ca_error(sm, call, arg, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"a `:&` parameter needs a place to borrow, and this is a temporary")
    else if k == CA_BORROW_MISFIT and param_takes_array_ref(p) == 0
        ca_error(sm, call, arg, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"this place doesn't hold what the `:&` parameter borrows")
    else if k == CA_BORROW_SHARED
        ca_error(sm, call, arg, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"a `:&` parameter can't borrow through an `@T`, which is read-only")
    else if k == CA_BORROW_UNTYPED
        ca_error(sm, call, arg, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"ritz1 can't tell what this argument is: write `@&` before it")

# AGAST #2287: a whole array argument fits its param: a by-value `[N]T` the same
# N, `a:& [N]T` / `@[N]T` / `@&[N]T` the same array, a Span any; else nothing
# takes it.  A by-value `self` isn't judged.
fn ca_array(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, arg: *Expr, p: *Param)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    if name_eq(StrView { ptr: (p.name), len: (p.name_len) as i64 }, StrView { ptr: (c"self"), len: (4) as i64 }) == 1 and p.is_borrow == 0
        return
    let sv: i32 = ca_strview_array(sm, arg, p)
    if sv == 1
        return
    if sv == 2
        ca_error(sm, call, arg, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"the parameter doesn't take a whole array")
        return
    let literal: i32 = (arg.kind == EXPR_ARRAY_LIT or arg.kind == EXPR_ARRAY_FILL) as i32
    if literal == 0 and param_takes_array_ref(p) == 1
        ca_array_ref(sm, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, arg, p)
        return
    var src: ArrayDims
    if literal == 0 and ca_array_shape(sm, arg, @src) == 0
        return
    if p.param_type == TYPE_ARRAY
        if literal == 0 and src.dims[0] != p.param_array_size
            ca_error(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"the array's length isn't the parameter's")
        return
    if param_is_span(p) == 1
        return
    if param_takes_array_ref(p) == 0
        ca_error(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"the parameter doesn't take a whole array")
        return
    ca_error(sm, call, call, StrView { ptr: (fname), len: (flen) as i64 }, argno, c"an array literal has no address to pass")

# Each argument of `call` against `params`, numbered from `argno`.
fn ca_args(sm: *Sema, call: *Expr, fname_sv: StrView, argno: i32, params: *Param, args: *Expr)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    var p: *Param = params
    var a: *Expr = args
    var n: i32 = argno
    while p != null and a != null
        ca_struct_ptr(sm, call, StrView { ptr: (fname), len: (flen) as i64 }, n, a, p)
        # AGAST #4244: before ca_array, so a refused borrow is said in its own
        # words; ca_report says one error per argument.
        ca_borrow(sm, call, StrView { ptr: (fname), len: (flen) as i64 }, n, a, p)
        ca_array(sm, call, StrView { ptr: (fname), len: (flen) as i64 }, n, a, p)
        p = p.next
        a = a.next
        n = n + 1
