# ritz1/src/must_use.ritz - a discarded call to a [[must_use]] fn
#
# AGAST #2137.  LANGUAGE_SPEC §17.8: the result of a call to a
# `[[must_use]]` fn may not be thrown away.
#
#     [[must_use]]
#     fn check(x: i32) -> i32
#         ...
#     fn main() -> i32
#         check(1)        # error: result of [[must_use]] fn 'check' is discarded
#         0
#
# ritzunit's `pub fn assert_*` return 0 / 1 and are `[[must_use]]`: valet's
# test_tls.ritz (#1903) had void [[test]] fns that called them as bare
# statements, so those tests could never fail.
#
# A call is discarded when it is an expression statement that is not its
# block's value: sema_walk calls must_use_check for a STMT_EXPR with a next
# statement, for the tail of a fn that returns nothing, and — LARB R69,
# AGAST #3997 — for the tail of a block that is no value (a loop body, a
# statement `if`'s branch, a statement `match`'s arm).  ritz0 prints the same
# words (emitter_llvmlite.py _reject_discarded_must_use).
#
# The first check moved off the emitter onto Sema (AGAST #3462).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema

# Report `e`, whose value is discarded, if it calls a [[must_use]] fn.
pub fn must_use_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_CALL or e.func_name_len == 0
        return
    # A local fn pointer of that name is not the fn of that name.
    if sema_is_local(sm, e.func_name, e.func_name_len) == 1
        return
    if is_must_use_fn(sema_call_fn(sm, e)) == 0
        return
    sema_error_at(sm, e.span.line, e.span.col)
    eprints_cstr(c"result of [[must_use]] fn '")
    eprint_bytes(e.func_name, e.func_name_len)
    eprints_cstr(c"' is discarded\n")

# LARB R69 (AGAST #3997): `e`, a discarded statement's expression, judged
# through an `if` / `match` expression's arms (`if c then check(1) else 0`),
# as ritz0's _reject_discarded_tail judges a dropped one's.  Only for a
# statement's own expression: sema_walk_arms judges the arms of one nested in
# a discarded arm.
pub fn must_use_check_value(sm: *Sema, e: *Expr)
    if e == null
        return
    if e.kind != EXPR_IF and e.kind != EXPR_MATCH
        must_use_check(sm, e)
        return
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        if arm.is_pass == 0
            must_use_check_value(sm, arm.body)
        arm = arm.next
