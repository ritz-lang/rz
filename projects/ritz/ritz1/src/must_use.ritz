# ritz1/src/must_use.ritz - a discarded call to a [[must_use]] fn
#
# AGAST #2137.  LANGUAGE_SPEC §17.8: the result of a call to a
# `[[must_use]]` fn may not be thrown away.
#
#     [[must_use]]
#     fn check(x: i32) -> i32
#         ...
#     fn main() -> i32
#         check(1)        # error: result of [[must_use]] fn 'check' is discarded
#         0
#
# ritzunit's `pub fn assert_*` return 0 / 1 and are `[[must_use]]`: valet's
# test_tls.ritz (#1903) had void [[test]] fns that called them as bare
# statements, so those tests could never fail.
#
# A call is discarded when it is an expression statement that is not its
# block's value: emit_stmt calls must_use_check for a STMT_EXPR with a next
# statement, and the fn / method emitters call it for the tail of a fn that
# returns nothing.  ritz0 prints the same words
# (emitter_llvmlite.py _reject_discarded_must_use).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core

# Report `e`, whose value is discarded, if it calls a [[must_use]] fn.
pub fn must_use_check(s: *EmitterState, e: *Expr)
    if e == null or e.kind != EXPR_CALL or e.func_name_len == 0
        return
    # A local fn pointer of that name is not the fn of that name.
    if find_local(s, e.func_name, e.func_name_len) >= 0
        return
    let fd: *FnDef = find_call_fn(s, e)
    if is_must_use_fn(fd) == 0
        return
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c": result of [[must_use]] fn '")
    eprint_bytes(e.func_name, e.func_name_len)
    eprints_cstr(c"' is discarded\n")
    emit_str(s, c"  ; ERROR: discarded [[must_use]] result\n")
    s.error_count = s.error_count + 1
