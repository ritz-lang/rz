# import_vis.ritz - a plain `import` is private (AGAST #3891)
#
# LANGUAGE_SPEC §15.1 / §15.4, LARB R54: `import b` brings in what `b`
# declares and what `b` re-exports with `pub import`.  What `b` reaches only
# through its own plain `import c` is not brought in.  ritz1 merges every
# transitive import into one module (codegen needs them), so the rule is a
# check at the use, as ritz0's import_visibility.py makes it:
#
#   main.ritz:4:15: error: `c_val` is undefined (#3891): it comes from `c`; import it, or have `b` `pub import` it
#
# resolve_imports records each module it loads (vis_names, before the module's
# own imports are merged into it) and every import edge (vis_edge), including
# one to a module already loaded.  vis_compute then marks the visible modules
# (the input's direct imports, and what they `pub import`, transitively) and
# tables every name declared only in the others, with the nearest plain
# import that brings it in (breadth first from the input).  sema_walk asks
# vis_hidden at each use in the input's own fns.
#
# Covered: fns, structs, consts and globals, the items a Module lists, and
# enums and type aliases (AGAST #3907): those live in the parser's global
# tables, which record no file, so resolve_imports marks ast_helpers' log of
# them before a file is parsed and vis_type_names takes what it added.  An
# impl method's mangled name `T_m` is hidden when T is (`T.m()` is a use of T
# at its ExprKind.Ident).  A method on a value names nothing: method syntax
# reaches no free fn (LANGUAGE_SPEC §9.4), so no UFCS call uses a hidden fn.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.memory
import ritzlib.str
import ritzlib.hash
import ritzlib.string
import ritzlib.io

import ast
import ast_helpers   # the enum / alias / trait declaration logs (#3907, #3467)
import diag          # R54's located errors (AGAST #3467)

struct VisName
    name: *u8
    len: i32
    fd: *FnDef        # the fn this name declares, else null (R54's private fn)
    owner: *VisMod    # the module that declares it (AGAST #4609); null for a trait
    next: *VisName

struct VisEdge
    target: *VisMod
    shown: *u8        # the import's path as written: `c`, `ritzlib.str`
    is_pub: i32
    decl: *ImportDecl # the import itself: R54 reads its list (AGAST #3467)
    next: *VisEdge

struct VisMod
    key: *u8          # the canonical path (import_key)
    names: *VisName
    edges: *VisEdge
    visible: i32
    reached: i32
    shown: *u8        # how the nearest importer wrote it
    via: *u8          # that importer, as it was written; null for the input
    queued: *VisMod   # the breadth-first queue's link
    traits: *VisName  # its traits and its items gated out for this target:
                      # R54 only, never tabled (AGAST #3467)
    r54_active: i32   # vis_defined is inside this module (a `pub import` cycle)
    next: *VisMod

# A name of the merged module: hidden, with where it comes from, or visible.
struct VisEntry
    name: *u8
    len: i32
    hidden: i32
    origin: *u8
    via: *u8
    next: *VisEntry

# An impl's method, for its mangled name `T_m` (AGAST #3907).
struct VisImpl
    ty: *u8
    ty_len: i32
    method: *u8
    method_len: i32
    next: *VisImpl

const VIS_BUCKETS: i32 = 4096

var g_vis_mods: *VisMod = null
var g_vis_tab: **VisEntry = null
var g_vis_impls: *VisImpl = null
# The input's own type-alias uses: ast_helpers' alias-use log from .._from
# up to .._to (AGAST #3907).  The last parse_program's, so a second parse
# pass replaces the first's.
var g_vis_alias_from: i32 = 0
var g_vis_alias_to: i32 = 0

pub fn vis_alias_uses_set(from: i32, to: i32)
    g_vis_alias_from = from
    g_vis_alias_to = to

pub fn vis_alias_uses_from() -> i32
    g_vis_alias_from

pub fn vis_alias_uses_to() -> i32
    g_vis_alias_to

fn vis_copy(p_sv: StrView) -> *u8
    var p: *u8 = p_sv.ptr
    var len: i64 = p_sv.len
    let out: *u8 = malloc(len + 1)
    memcpy(out, p, len)
    out[len] = 0
    out

# The module of canonical path `key`, made on first sight.
pub fn vis_module(key: *u8) -> *VisMod
    var vm: *VisMod = g_vis_mods
    while vm != null
        if streq(vm.key, key)
            return vm
        vm = vm.next
    vm = malloc(sizeof(VisMod)) as *VisMod
    vm.key = vis_copy(StrView { ptr: (key), len: (strlen(key)) })
    vm.names = null
    vm.edges = null
    vm.visible = 0
    vm.reached = 0
    vm.shown = null
    vm.via = null
    vm.queued = null
    vm.traits = null
    vm.r54_active = 0
    vm.next = g_vis_mods
    g_vis_mods = vm
    vm

fn vis_new_name(name_sv: StrView, fd: *FnDef, rest: *VisName) -> *VisName
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let n: *VisName = malloc(sizeof(VisName)) as *VisName
    n.name = name
    n.len = len
    n.fd = fd
    n.owner = null
    n.next = rest
    n

fn vis_add_name(vm: *VisMod, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    vm.names = vis_new_name(StrView { ptr: (name), len: (len) as i64 }, null, vm.names)
    vm.names.owner = vm

# What `m` declares itself: call before its imports are merged into it.
pub fn vis_names(vm: *VisMod, m: *Module)
    var f: *FnDef = m.functions
    while f != null
        vm.names = vis_new_name(StrView { ptr: (f.name), len: (f.name_len) as i64 }, f, vm.names)
        vm.names.owner = vm
        f = f.next
    var s: *StructDef = m.structs
    while s != null
        vis_add_name(vm, StrView { ptr: (s.name), len: (s.name_len) as i64 })
        s = s.next
    var c: *ConstEntry = m.constants
    while c != null
        vis_add_name(vm, StrView { ptr: (c.name), len: (c.name_len) as i64 })
        c = c.next
    var g: *GlobalVarDef = m.globals
    while g != null
        vis_add_name(vm, StrView { ptr: (g.name), len: (g.name_len) as i64 })
        g = g.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var meth: *FnDef = ib.methods
        while meth != null
            let vi: *VisImpl = malloc(sizeof(VisImpl)) as *VisImpl
            vi.ty = ib.type_name
            vi.ty_len = ib.type_name_len
            vi.method = meth.name
            vi.method_len = meth.name_len
            vi.next = g_vis_impls
            g_vis_impls = vi
            meth = meth.next
        ib = ib.next

# The enums and type aliases a file declared: ast_helpers' log from `mark`,
# taken just before the file was parsed (AGAST #3907).
pub fn vis_type_names(ctx: *ParseCtx, vm: *VisMod, mark: i32)
    let end: i32 = type_decl_log_count(ctx)
    var i: i32 = mark
    while i < end
        var len: i32 = 0
        let name: *u8 = type_decl_log_at(ctx, i, @len)
        vis_add_name(vm, StrView { ptr: (name), len: (len) as i64 })
        i = i + 1

# The traits a file declared and the items `[[target_os]]` gated out of it:
# ast_helpers' trait and gated logs from the marks taken just before the file
# was parsed.  Kept apart from `names`, so R54 sees them and #3891's table
# doesn't (AGAST #3467).
pub fn vis_r54_names(ctx: *ParseCtx, vm: *VisMod, mark: i32, gated_mark: i32)
    let end: i32 = trait_declared_count(ctx)
    var i: i32 = mark
    while i < end
        var len: i32 = 0
        let name: *u8 = trait_declared_at(ctx, i, @len)
        vm.traits = vis_new_name(StrView { ptr: (name), len: (len) as i64 }, null, vm.traits)
        i = i + 1
    let gated_end: i32 = gated_decl_count(ctx)
    var g: i32 = gated_mark
    while g < gated_end
        var glen: i32 = 0
        let gname: *u8 = gated_decl_at(ctx, g, @glen)
        vm.traits = vis_new_name(StrView { ptr: (gname), len: (glen) as i64 }, null, vm.traits)
        g = g + 1

# Forget `vm`'s import edges, before its imports are resolved again: a second
# parse pass (main.ritz, #1475) would otherwise list each import twice, the
# first pass's copy pointing at that pass's ImportDecls.  (A list R54 refuses
# stops the compile in the first pass, so the second never reports it again.)
pub fn vis_edges_reset(vm: *VisMod)
    vm.edges = null

# `from`'s import of the module at canonical path `key`, written `imp`.
pub fn vis_edge(from: *VisMod, key: *u8, imp: *ImportDecl)
    let e: *VisEdge = malloc(sizeof(VisEdge)) as *VisEdge
    e.target = vis_module(key)
    var shown: String = string_new()
    var seg: *ImportPath = imp.path
    while seg != null
        shown.push_span(Span<u8> { ptr: (seg.segment), len: (seg.segment_len as i64) as i64 })
        if seg.next != null
            shown.push('.')
        seg = seg.next
    e.shown = vis_copy(StrView { ptr: (shown.as_ptr()), len: (shown.len()) })
    e.is_pub = imp.is_pub
    e.decl = imp
    # Appended, so edges keep source order: the nearest import is the first.
    e.next = null
    if from.edges == null
        from.edges = e
    else
        var last: *VisEdge = from.edges
        while last.next != null
            last = last.next
        last.next = e

fn vis_bucket(name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    (fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) % (VIS_BUCKETS as u64)) as i64

fn vis_find(name_sv: StrView) -> *VisEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if g_vis_tab == null
        return null
    var e: *VisEntry = g_vis_tab[vis_bucket(StrView { ptr: (name), len: (len) as i64 })]
    while e != null
        if e.len == len and memcmp(e.name, name, len as i64) == 0
            return e
        e = e.next
    null

fn vis_put(name_sv: StrView, hidden: i32, origin: *u8, via: *u8)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if vis_find(StrView { ptr: (name), len: (len) as i64 }) != null
        return
    let e: *VisEntry = malloc(sizeof(VisEntry)) as *VisEntry
    e.name = name
    e.len = len
    e.hidden = hidden
    e.origin = origin
    e.via = via
    let b: i64 = vis_bucket(StrView { ptr: (name), len: (len) as i64 })
    e.next = g_vis_tab[b]
    g_vis_tab[b] = e

fn vis_is_builtin(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Everywhere even where ritzlib declares them (name_resolver's
    # BUILTIN_TYPES / BUILTIN_GENERICS / BUILTIN_VARIANTS in ritz0).
    if bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"StrView") == 1 or bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Option") == 1
        return 1
    if bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Result") == 1 or bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Span") == 1
        return 1
    if bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Some") == 1 or bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"None") == 1
        return 1
    (bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Ok") == 1 or bytes_eq_cstr(StrView { ptr: (name), len: (len) as i64 }, c"Err") == 1) as i32

fn bytes_eq_cstr(p_sv: StrView, c: *u8) -> i32
    var p: *u8 = p_sv.ptr
    var len: i32 = p_sv.len as i32
    if strlen(c) != len as i64
        return 0
    (memcmp(p, c, len as i64) == 0) as i32

fn vis_put_all(vm: *VisMod, hidden: i32)
    var n: *VisName = vm.names
    while n != null
        if hidden == 0 or vis_is_builtin(StrView { ptr: (n.name), len: (n.len) as i64 }) == 0
            vis_put(StrView { ptr: (n.name), len: (n.len) as i64 }, hidden, vm.shown, vm.via)
        n = n.next

# Table the input's names: `main` is its module, already given its names.
pub fn vis_compute(main: *VisMod)
    g_vis_tab = malloc(VIS_BUCKETS as i64 * 8) as **VisEntry
    memset(g_vis_tab as *u8, 0, VIS_BUCKETS as i64 * 8)
    # Visible: the input, its direct imports, and their `pub import`s.
    main.visible = 1
    var e: *VisEdge = main.edges
    while e != null
        e.target.visible = 1
        e = e.next
    var grew: i32 = 1
    while grew == 1
        grew = 0
        var vm: *VisMod = g_vis_mods
        while vm != null
            if vm.visible == 1
                var pe: *VisEdge = vm.edges
                while pe != null
                    if pe.is_pub == 1 and pe.target.visible == 0
                        pe.target.visible = 1
                        grew = 1
                    pe = pe.next
            vm = vm.next
    var vm2: *VisMod = g_vis_mods
    while vm2 != null
        if vm2.visible == 1
            vis_put_all(vm2, 0)
        vm2 = vm2.next
    # The rest, breadth first from the input: a name's hint is the nearest
    # plain import that brings it in.
    main.reached = 1
    var head: *VisMod = main
    var tail: *VisMod = main
    while head != null
        var qe: *VisEdge = head.edges
        while qe != null
            let t: *VisMod = qe.target
            if t.reached == 0
                t.reached = 1
                t.shown = qe.shown
                t.via = head.shown
                tail.queued = t
                tail = t
            qe = qe.next
        if head.visible == 0
            vis_put_all(head, 1)
        head = head.queued
    # AGAST #3907: `T_m()` is T's method by its mangled name, hidden when T
    # is, unless some visible module declares that name itself.
    var vi: *VisImpl = g_vis_impls
    while vi != null
        let t: *VisEntry = vis_find(StrView { ptr: (vi.ty), len: (vi.ty_len) as i64 })
        if t != null and t.hidden == 1
            let n: i32 = vi.ty_len + 1 + vi.method_len
            let mangled: *u8 = malloc(n as i64 + 1)
            memcpy(mangled, vi.ty, vi.ty_len as i64)
            mangled[vi.ty_len] = '_'
            memcpy(mangled + vi.ty_len + 1, vi.method, vi.method_len as i64)
            mangled[n] = 0
            vis_put(StrView { ptr: (mangled), len: (n) as i64 }, 1, t.origin, t.via)
        vi = vi.next

# The hidden entry for `name`, or null when it is visible, unknown or no
# input was tabled.
pub fn vis_hidden(name_sv: StrView) -> *VisEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *VisEntry = vis_find(StrView { ptr: (name), len: (len) as i64 })
    if e == null or e.hidden == 0
        return null
    e

# =============================================================================
# LARB R54 (LANGUAGE_SPEC §15.1, AGAST #3467; ritz0's #3466)
# =============================================================================
#
# Each name in the input's `import m { … }` must be one `m` defines: declared
# at its top level (a fn, struct, const, global, enum, type alias or trait),
# or re-exported by one of its `pub import`s (only the names a `pub import t
# { x }` lists).  What `m` reaches through its own plain `import` doesn't
# count.  Otherwise, at the name, in ritz0's words:
#
#   main.ritz:1:17: error: `nope` is not defined in a
#
# A private fn in the list is §15.2's error at the import, with call_check's
# exemptions and its note:
#
#   main.ritz:1:17: error: `helper` is private to a.ritz; mark it `pub` (#3413)
#   /abs/a.ritz:1:1: note: `helper` is declared here
#
# Private types and consts count: type privacy isn't enforced.  The list is
# checked but doesn't filter.  Only the input's own imports are checked: every
# file is compiled on its own, so each list is checked in the file that
# writes it.  Run once imports are resolved, before Sema and emission.

# §15.2's private fn, as call_check's cc_private exempts: an `extern fn` (no
# body), a written `fn .. = extern`, a generated `E.from`, and a fn whose file
# isn't known.
fn vis_private_fn(fd: *FnDef) -> i32
    if fd == null or fd.is_pub == 1 or fd.body == null or fd.extern_decl == 1
        return 0
    (fd.from_generated == 0 and fd.def_file != null) as i32

# `name` in `n`'s list.  Of [[target_os]] variants, one that isn't a private
# fn wins, so the private-fn error needs every variant private.
fn vis_in_list(n: *VisName, name_sv: StrView) -> *VisName
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var private: *VisName = null
    var at: *VisName = n
    while at != null
        if at.len == len and memcmp(at.name, name, len as i64) == 0
            if vis_private_fn(at.fd) == 0
                return at
            if private == null
                private = at
        at = at.next
    private

fn vis_listed(it: *ImportItem, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var at: *ImportItem = it
    while at != null
        if at.name_len == len and memcmp(at.name, name, len as i64) == 0
            return 1
        at = at.next
    0

# The declaration of `name` that `vm` defines, or null.  Its own come first;
# then its `pub import`s', in source order.  A `pub import` cycle adds nothing.
fn vis_defined(vm: *VisMod, name_sv: StrView) -> *VisName
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let own: *VisName = vis_in_list(vm.names, StrView { ptr: (name), len: (len) as i64 })
    if own != null
        return own
    let tr: *VisName = vis_in_list(vm.traits, StrView { ptr: (name), len: (len) as i64 })
    if tr != null
        return tr
    if vm.r54_active == 1
        return null
    vm.r54_active = 1
    var found: *VisName = null
    var e: *VisEdge = vm.edges
    while e != null and found == null
        if e.is_pub == 1
            # A name `m`'s `pub import t { x }` lists that `t` doesn't
            # define is `m`'s error, reported when `m` is compiled.
            if e.decl.items == null or vis_listed(e.decl.items, StrView { ptr: (name), len: (len) as i64 }) == 1
                found = vis_defined(e.target, StrView { ptr: (name), len: (len) as i64 })
        e = e.next
    vm.r54_active = 0
    found

# 1 if the `pub` fn `fd` is in the namespace of the module at canonical path
# `key`: one of its imports defines it (declares it, or `pub import`s a module
# that does).  main.ritz fns_coexist's question (AGAST #1858).  Every edge of
# a module is recorded before an import of it is merged, and the input's up
# to the import being merged, which is the one that brings `fd` in.
pub fn vis_sees(key: *u8, fd: *FnDef) -> i32
    let vm: *VisMod = vis_module(key)
    var e: *VisEdge = vm.edges
    while e != null
        let n: *VisName = vis_defined(e.target, StrView { ptr: (fd.name), len: (fd.name_len) as i64 })
        if n != null and n.fd != null
            if n.fd.is_pub == 1 and n.fd.def_file != null and streq(n.fd.def_file, fd.def_file)
                return 1
        e = e.next
    0

# AGAST #4609 (LANGUAGE_SPEC §15.3): types follow the fn rule.  Is the type
# `name` that the module `owner` declares in the namespace of the module
# `vm`: declared there, or defined by one of its imports (declared, or `pub
# import`ed, by the import's module)?
pub fn vis_sees_def(vm: *VisMod, name_sv: StrView, owner: *VisMod) -> i32
    if vm == owner
        return 1
    var e: *VisEdge = vm.edges
    while e != null
        let n: *VisName = vis_defined(e.target, StrView { ptr: (name_sv.ptr), len: (name_sv.len) })
        if n != null and n.owner == owner
            return 1
        e = e.next
    0

# Is any declaration of `name` in the namespace of the module `vm`?
pub fn vis_sees_name(vm: *VisMod, name_sv: StrView) -> i32
    if vis_in_list(vm.names, StrView { ptr: (name_sv.ptr), len: (name_sv.len) }) != null
        return 1
    var e: *VisEdge = vm.edges
    while e != null
        if vis_defined(e.target, StrView { ptr: (name_sv.ptr), len: (name_sv.len) }) != null
            return 1
        e = e.next
    0

# Every module recorded, in no order: the closure's (AGAST #4609).
pub fn vis_mods_head() -> *VisMod
    g_vis_mods

fn vis_eprint(p_sv: StrView)
    var p: *u8 = p_sv.ptr
    var len: i32 = p_sv.len as i32
    for i in 0..len
        eprint_char(p[i])

fn vis_basename(path: *u8) -> *u8
    var base: *u8 = path
    var i: i64 = 0
    while path[i] != 0
        if path[i] == '/'
            base = path + i + 1
        i = i + 1
    base

# Check the input's selective lists; `main` is its module, `file` its path as
# diagnostics name it.  The number of errors reported.
pub fn vis_selective_check(main: *VisMod, file: *u8) -> i32
    var errors: i32 = 0
    var e: *VisEdge = main.edges
    while e != null
        var it: *ImportItem = e.decl.items
        while it != null
            let d: *VisName = vis_defined(e.target, StrView { ptr: (it.name), len: (it.name_len) as i64 })
            if d == null
                diag_error_at(file, diag_span(it.line, it.col))
                eprint_char('`')
                vis_eprint(StrView { ptr: (it.name), len: (it.name_len) as i64 })
                eprints("` is not defined in ")
                eprints_cstr(e.shown)
                eprint_char('\n')
                errors = errors + 1
            else if vis_private_fn(d.fd) == 1
                diag_error_at(file, diag_span(it.line, it.col))
                eprint_char('`')
                vis_eprint(StrView { ptr: (it.name), len: (it.name_len) as i64 })
                eprints("` is private to ")
                eprints_cstr(vis_basename(d.fd.def_file))
                eprints("; mark it `pub` (#3413)\n")
                eprints_cstr(d.fd.def_file)
                eprint_char(':')
                eprint_int(d.fd.line as i64)
                eprint_char(':')
                eprint("{d.fd.col as i64}: note: `")
                vis_eprint(StrView { ptr: (it.name), len: (it.name_len) as i64 })
                eprints("` is declared here\n")
                errors = errors + 1
            it = it.next
        e = e.next
    errors
