# ritz1/src/emitter_print.ritz - lowering of the print builtin (AGAST #1521)
#
# `print("a={a} b={f(b)}\n")` becomes a write of "a=", the value of `a`, a
# write of " b=", the value of `f(b)`, and a write of "\n". This is ritz0's
# `_emit_interp_string_print` / `_emit_print_value`, and the output must be
# byte-identical to ritz0's. Values print by type:
#
#   integers   decimal, signed or unsigned by the Ritz type (AGAST #2128):
#              u8 200 prints `200`, u64::MAX `18446744073709551615`. The
#              digits come from format_into's @__ritz_fmt_int.
#   bool       `true` / `false`
#   StrView    its `len` bytes from `ptr` (also the %Span$u8 a bare "..."
#              lowers to, and a @StrView / *StrView), as ritz0 (#1641)
#   pointers   the NUL-terminated bytes they point at
#   anything   else is a compile error, as in ritz0
#
# Every entry point takes the output fd: print passes 1, eprint 2 (#1641).
#
# Bool and string printing are small helper functions (`@__ritz_print_*`),
# defined once per module that uses them by emit_print_helpers, rather than
# ritz0's inline loops.
#
# interp.ritz holds the placeholder rules and the expression parser.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ast
import emitter_core
import emitter_expr
import emitter_expr_call
import interp
import bool_check   # AGAST #2342
import ast_helpers   # is_test_fn / is_test_helper_fn (AGAST #1869)

# Report an error at a print literal: an IR comment, a stderr line naming
# the literal's line, and one more on s.error_count (AGAST #1369), so ritz1
# exits non-zero instead of writing the output.
fn emit_print_error(s: *EmitterState, lit: *Expr, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_str(s, c"\n")
    eprints_cstr(c"error: ritz1 cannot emit: line ")
    eprint_int(lit.span.line as i64)
    eprints_cstr(c": ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

fn emit_print_zero(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# write(fd, data, len) for bytes known at compile time. Returns the register
# holding the syscall's result (bytes written).
pub fn emit_print_bytes(s: *EmitterState, fd: i64, data: *u8, len: i32) -> i32
    let str_idx: i32 = add_string(s, data, len)
    let gep_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, gep_reg)
    emit_str(s, c" = getelementptr [")
    emit_int(s, (len + 1) as i64)
    emit_str(s, c" x i8], ptr @.str.")
    emit_int(s, str_idx as i64)
    emit_str(s, c", i64 0, i64 0\n")
    let ptr_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr_reg)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, gep_reg)
    emit_str(s, c" to i64\n")
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = call i64 asm sideeffect \"syscall\", ")
    emit_str(s, c"\"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"")
    emit_str(s, c"(i64 1, i64 ")
    emit_int(s, fd)
    emit_str(s, c", i64 ")
    emit_reg(s, ptr_reg)
    emit_str(s, c", i64 ")
    emit_int(s, len as i64)
    emit_str(s, c")\n")
    result

# Is `e` a bool in ritz0's eyes (an i1 there)?  See bool_check.ritz.
fn interp_is_bool(s: *EmitterState, e: *Expr) -> i32
    (bool_kind(s, e) == BK_BOOL) as i32

# Is `name` one of the two `{ ptr, i64 }` view types: StrView, or the
# %Span$u8 a bare "..." literal lowers to (AGAST #98)?
fn interp_is_view_name(name: *u8, len: i32) -> i32
    if name == null
        return 0
    if name_eq(name, len, c"StrView", 7) == 1
        return 1
    name_eq(name, len, c"Span$u8", 7)

# Is `e` a StrView? Returns 1 for a view value (an aggregate register),
# 2 for a pointer or reference to a StrView (an i64 register), else 0.
# Writes the aggregate's LLVM type name. ritz0 decides by LLVM type
# (_is_strview_llvm_type); this finds the same set from ritz1's locals,
# struct fields, calls, consts and literals.
fn interp_strview_kind(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if e.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, e)
        if fld == null or interp_is_view_name(fld.field_type_name, fld.field_type_name_len) == 0
            return 0
        *out_name = fld.field_type_name
        *out_len = fld.field_type_name_len
        if fld.field_type == TYPE_STRUCT
            return 1
        if fld.field_type == TYPE_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF
            return 2
        return 0
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null and interp_is_view_name(loc.type_name, loc.type_name_len) == 1
            if loc.var_type == TYPE_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
                *out_name = loc.type_name
                *out_len = loc.type_name_len
                return 2
    var n: *u8 = null
    var l: i32 = 0
    resolve_expr_struct_name(s, e, @n, @l)
    if interp_is_view_name(n, l) == 1
        *out_name = n
        *out_len = l
        return 1
    0

# Print the StrView `e` (interp_strview_kind `kind`, type `name`) to fd:
# exactly `len` bytes from `ptr`, never a strlen.
fn emit_print_strview(s: *EmitterState, fd: i64, e: *Expr, kind: i32, name: *u8, name_len: i32)
    var v: i32 = emit_expr(s, e)
    if kind == 2
        let p: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, p)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, v)
        emit_str(s, c" to ptr\n")
        let agg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, agg)
        emit_str(s, c" = load %")
        emit_name(s, name, name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, p)
        emit_str(s, c"\n")
        v = agg
    let ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr)
    emit_str(s, c" = extractvalue %")
    emit_name(s, name, name_len)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", 0\n")
    let len: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, len)
    emit_str(s, c" = extractvalue %")
    emit_name(s, name, name_len)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", 1\n")
    let pi: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pi)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, ptr)
    emit_str(s, c" to i64\n")
    emit_str(s, c"  call void @__ritz_print_bytes(i64 ")
    emit_int(s, fd)
    emit_str(s, c", i64 ")
    emit_reg(s, pi)
    emit_str(s, c", i64 ")
    emit_reg(s, len)
    emit_str(s, c")\n")
    s.print_helpers_used = 1

# Print the value of placeholder expression `e` to fd. Returns 0 and reports
# an error if its type has no printed form.
fn emit_print_value(s: *EmitterState, fd: i64, lit: *Expr, e: *Expr) -> i32
    var sv_name: *u8 = null
    var sv_len: i32 = 0
    let sv_kind: i32 = interp_strview_kind(s, e, @sv_name, @sv_len)
    if sv_kind != 0
        emit_print_strview(s, fd, e, sv_kind, sv_name, sv_len)
        return 1
    let ty: i32 = get_expr_type(s, e)
    let is_bool: i32 = interp_is_bool(s, e)
    if is_bool == 0
        # Integers: decimal by Ritz signedness, digits from @__ritz_fmt_int
        # as format_into's (AGAST #2128), then one write.
        var n: i32 = 0
        let p: i32 = emit_fmt_int(s, e, ty, @n)
        if p >= 0
            let pi: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, pi)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, p)
            emit_str(s, c" to i64\n")
            emit_str(s, c"  call void @__ritz_print_bytes(i64 ")
            emit_int(s, fd)
            emit_str(s, c", i64 ")
            emit_reg(s, pi)
            emit_str(s, c", i64 ")
            emit_reg(s, n)
            emit_str(s, c")\n")
            s.print_helpers_used = 1
            return 1
    var helper: *u8 = null
    if is_bool == 1
        helper = c"__ritz_print_bool"
    else if ty == TYPE_PTR or ty == TYPE_PTR_PTR or ty == TYPE_REF or ty == TYPE_MUT_REF
        helper = c"__ritz_print_cstr"
    if helper == null
        emit_print_error(s, lit, c"cannot print this value in a print interpolation: only integers, bool, StrView and pointers have a printed form")
        return 0
    var v: i32 = emit_expr(s, e)
    if is_bool == 1 and bool_reg_is_i1(s, e) == 1
        # A bool global's load is an i1; the helper takes an i64.
        let z: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, z)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, v)
        emit_str(s, c" to i64\n")
        v = z
    emit_str(s, c"  call void @")
    emit_str(s, helper)
    emit_str(s, c"(i64 ")
    emit_int(s, fd)
    emit_str(s, c", i64 ")
    emit_reg(s, v)
    emit_str(s, c")\n")
    s.print_helpers_used = 1
    1

# Cook one escape the way ritz1's lexer does (lexer_nfa.ritz): the six
# named escapes, and any other character stands for itself (`\{` is `{`).
fn interp_cook_escape(c: i32) -> u8
    if c == 110
        return 10
    if c == 116
        return 9
    if c == 114
        return 13
    if c == 48
        return 0
    c as u8

# Lower print(<literal>) to fd. Returns the result register: the write's
# byte count when the literal has no placeholder, else 0, as in ritz0.
pub fn emit_print_literal(s: *EmitterState, fd: i64, lit: *Expr) -> i32
    return emit_interp_literal(s, fd, null, lit)

# Bytes known at compile time: written to fd, or appended to the sink `k`
# when there is one (format_into, AGAST #1824).
fn emit_interp_bytes(s: *EmitterState, fd: i64, k: *FmtSink, data: *u8, len: i32) -> i32
    if k != null
        fmt_push_const(s, k, data, len)
        return 0
    return emit_print_bytes(s, fd, data, len)

# print's literal splitting, for print / eprint (k == null: write to fd) and
# format_into (append each piece to the sink k).
fn emit_interp_literal(s: *EmitterState, fd: i64, k: *FmtSink, lit: *Expr) -> i32
    if lit.kind == EXPR_CSTRING_LIT
        if interp_cstr_has_placeholder(lit.string_ptr, lit.string_len) == 1
            # #1374/#1394: c"..." does not interpolate, so this would print
            # the placeholder verbatim. Reject it, as ritz0 does.
            if k != null
                emit_print_error(s, lit, c"`c\"...\"` literals do not interpolate: the placeholder would be appended verbatim. Use a plain string literal `\"...\"` here, or `{{` for a literal brace")
            else
                emit_print_error(s, lit, c"`c\"...\"` literals do not interpolate: the placeholder would be printed verbatim. Use a plain string literal `\"...\"` here, or `{{` to print a literal brace")
            return emit_print_zero(s)
        if k != null
            fmt_push_const(s, k, lit.string_ptr, lit.string_len)
            return emit_print_zero(s)
        return emit_print_bytes(s, fd, lit.string_ptr, lit.string_len)

    # A "..." literal: split its RAW source text. The cooked text in
    # string_ptr cannot tell `\{x}` from `{x}`. expr_string records the raw
    # token, quotes included, in ident_ptr / ident_len.
    let raw: *u8 = lit.ident_ptr
    if raw == null or lit.ident_len < 2
        if k != null
            fmt_push_const(s, k, lit.string_ptr, lit.string_len)
            return emit_print_zero(s)
        return emit_print_bytes(s, fd, lit.string_ptr, lit.string_len)
    let body: *u8 = raw + 1
    let n: i32 = lit.ident_len - 2
    # Cooked text is never longer than raw. add_string keeps the pointer, so
    # each chunk stays in this buffer for the rest of the compile.
    let buf: *u8 = malloc((n + 1) as i64)
    var start: i32 = 0     # first byte of the chunk not yet written
    var w: i32 = 0         # write cursor in buf
    var placeholders: i32 = 0
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == 92 and i + 1 < n
            *(buf + w) = interp_cook_escape(*(body + i + 1) as i32)
            w = w + 1
            i = i + 2
        else if c == 123 and i + 1 < n and *(body + i + 1) == 123
            *(buf + w) = 123
            w = w + 1
            i = i + 2
        else if c == 125 and i + 1 < n and *(body + i + 1) == 125
            *(buf + w) = 125
            w = w + 1
            i = i + 2
        else if c == 123 and interp_match_brace(body, n, i) >= 0
            let close: i32 = interp_match_brace(body, n, i)
            if w > start
                emit_interp_bytes(s, fd, k, buf + start, w - start)
            start = w
            placeholders = placeholders + 1
            let e: *Expr = interp_parse_expr(body + i + 1, close - i - 1, lit.span.line, lit.span.col)
            if e == null
                emit_print_error(s, lit, c"invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)")
            else if k != null
                fmt_push_value(s, k, lit, e)
            else
                emit_print_value(s, fd, lit, e)
            i = close + 1
        else
            *(buf + w) = c as u8
            w = w + 1
            i = i + 1

    if placeholders == 0 and k == null
        return emit_print_bytes(s, fd, buf, w)
    if w > start
        emit_interp_bytes(s, fd, k, buf + start, w - start)
    emit_print_zero(s)

# The helpers emit_print_value calls. Emitted once, after the functions, by
# a module that used any of them.
pub fn emit_print_helpers(s: *EmitterState)
    if s.print_helpers_used == 0
        return
    emit_str(s, c"\n; print interpolation helpers (AGAST #1521), as ritz0's _emit_print_value\n")
    # A StrView's bytes: one write of exactly len bytes (#1641).
    emit_str(s, c"define internal void @__ritz_print_bytes(i64 %fd, i64 %p, i64 %n) {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    # NUL-terminated bytes at a pointer: strlen, then one write.
    emit_str(s, c"define internal void @__ritz_print_cstr(i64 %fd, i64 %p) {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %ptr = inttoptr i64 %p to ptr\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"scan:\n")
    emit_str(s, c"  %n = phi i64 [ 0, %entry ], [ %n1, %next ]\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %ptr, i64 %n\n")
    emit_str(s, c"  %c = load i8, ptr %cp\n")
    emit_str(s, c"  %nul = icmp eq i8 %c, 0\n")
    emit_str(s, c"  br i1 %nul, label %done, label %next\n")
    emit_str(s, c"next:\n")
    emit_str(s, c"  %n1 = add i64 %n, 1\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    # bool: `true` or `false`.
    emit_str(s, c"@.ritz_print_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_print_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    emit_str(s, c"define internal void @__ritz_print_bool(i64 %fd, i64 %b) {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %t = icmp ne i64 %b, 0\n")
    emit_str(s, c"  %ptr = select i1 %t, ptr @.ritz_print_true, ptr @.ritz_print_false\n")
    emit_str(s, c"  %len = select i1 %t, i64 4, i64 5\n")
    emit_str(s, c"  %pi = ptrtoint ptr %ptr to i64\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %pi, i64 %len)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n")

# =============================================================================
# assert (AGAST #1869; LANGUAGE_SPEC §17.1, §19.2)
# =============================================================================
#
# A failing assert writes to stderr and exits 1:
#
#     <file>:<line>: assertion failed[: <message> | : left OP right]
#       left:  <value>                      } cond is `a OP b` with integer,
#       right: <value>                      } bool or pointer operands
#       in helper <fn> at <file>:<line>     } in a [[test_helper]] fn
#
# byte for byte what ritz0's _emit_assert writes.  In a helper the first
# <file>:<line> is the call site the running [[test]] fn recorded in the
# @__ritz_assert_site_* globals (record_assert_site), or the assert's own
# location when none was recorded.

# __ritz_assert_val's `kind`; ritz0's _ASSERT_* use the same numbers.
const ASSERT_V_SIGNED: i32 = 0
const ASSERT_V_UNSIGNED: i32 = 1
const ASSERT_V_PTR: i32 = 2
const ASSERT_V_BOOL: i32 = 3

pub fn assert_fn_kind(f: *FnDef) -> i32
    if is_test_fn(f) == 1
        return ASSERT_FN_TEST
    if is_test_helper_fn(f) == 1
        return ASSERT_FN_HELPER
    ASSERT_FN_PLAIN

fn assert_cstr_len(t: *u8) -> i32
    var n: i32 = 0
    while *(t + n) != 0
        n += 1
    n

# The basename of the file being compiled: the location an assert reports.
fn assert_file_base(out_len: *i32) -> *u8
    let f: *u8 = emitter_source_file()
    if f == null
        *out_len = 1
        return c"?"
    var n: i32 = 0
    var start: i32 = 0
    while *(f + n) != 0
        if *(f + n) == 47
            start = n + 1
        n += 1
    *out_len = n - start
    f + start

fn assert_file_str(s: *EmitterState) -> i32
    if s.assert_file_str < 0
        var blen: i32 = 0
        let base: *u8 = assert_file_base(@blen)
        s.assert_file_str = add_string(s, base, blen)
    s.assert_file_str

# write(2, data, len) for bytes known at compile time.
fn assert_write(s: *EmitterState, data: *u8, len: i32)
    if len <= 0
        return
    let idx: i32 = add_string(s, data, len)
    s.print_helpers_used = 1
    emit_str(s, c"  call void @__ritz_print_bytes(i64 2, i64 ptrtoint (ptr @.str.")
    emit_int(s, idx as i64)
    emit_str(s, c" to i64), i64 ")
    emit_int(s, len as i64)
    emit_str(s, c")\n")

fn assert_write_c(s: *EmitterState, text: *u8)
    assert_write(s, text, assert_cstr_len(text))

# The value in i64 register `reg` (or the constant `imm` when reg == 0).
fn assert_write_val(s: *EmitterState, reg: i32, imm: i64, kind: i32)
    s.assert_helpers_used = 1
    emit_str(s, c"  call void @__ritz_assert_val(i64 ")
    if reg != 0
        emit_reg(s, reg)
    else
        emit_int(s, imm)
    emit_str(s, c", i64 ")
    emit_int(s, kind as i64)
    emit_str(s, c")\n")

fn assert_write_own_loc(s: *EmitterState, line: i32)
    var blen: i32 = 0
    let base: *u8 = assert_file_base(@blen)
    assert_write(s, base, blen)
    assert_write_c(s, c":")
    assert_write_val(s, 0, line as i64, ASSERT_V_SIGNED)
    assert_write_c(s, c": ")

# How a failing assert prints an operand of type get_expr_type(e); -1: not.
fn assert_operand_kind(s: *EmitterState, e: *Expr) -> i32
    let t: i32 = get_expr_type(s, e)
    if t == TYPE_BOOL
        return ASSERT_V_BOOL
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return ASSERT_V_PTR
    if t == TYPE_U8 or t == TYPE_U16 or t == TYPE_U32 or t == TYPE_U64
        return ASSERT_V_UNSIGNED
    if t == TYPE_I8 or t == TYPE_I16 or t == TYPE_I32 or t == TYPE_I64
        return ASSERT_V_SIGNED
    -1

# `f`'s source name: a generic instance `name$T...` without its suffix.
fn assert_fn_name_len(f: *FnDef) -> i32
    var n: i32 = 0
    while n < f.name_len and *(f.name + n) != 36
        n += 1
    n

fn assert_op_text(op: i32) -> *u8
    if op == OP_EQ
        return c"=="
    if op == OP_NE
        return c"!="
    if op == OP_LT
        return c"<"
    if op == OP_GT
        return c">"
    if op == OP_LE
        return c"<="
    c">="

# In a [[test]] fn, note the location of the call `e` before it is made.  A
# [[test_helper]] reached through it reports that location; helpers do not
# record, so through any depth of helpers the line stays the test's.
pub fn record_assert_site(s: *EmitterState, e: *Expr)
    if s.fn_assert_kind != ASSERT_FN_TEST
        return
    let idx: i32 = assert_file_str(s)
    var blen: i32 = 0
    assert_file_base(@blen)
    s.assert_site_used = 1
    emit_str(s, c"  store ptr @.str.")
    emit_int(s, idx as i64)
    emit_str(s, c", ptr @__ritz_assert_site_file\n")
    emit_str(s, c"  store i64 ")
    emit_int(s, blen as i64)
    emit_str(s, c", ptr @__ritz_assert_site_file_len\n")
    emit_str(s, c"  store i64 ")
    emit_int(s, e.span.line as i64)
    emit_str(s, c", ptr @__ritz_assert_site_line\n")

fn assert_placement_error(s: *EmitterState, stmt: *Stmt)
    emit_str(s, c"  ; ERROR: assert outside [[test]] / [[test_helper]]\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(stmt.span.line as i64)
    eprints_cstr(c":")
    eprint_int(stmt.span.col as i64)
    eprints_cstr(c": assert is only allowed in [[test]] and [[test_helper]] functions, not in '")
    let f: *FnDef = emitter_current_fn()
    if f != null
        eprint_bytes(f.name, assert_fn_name_len(f))
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1

pub fn emit_assert_stmt(s: *EmitterState, stmt: *Stmt)
    bool_check_cond(s, stmt.if_cond, c"assert condition")
    if s.fn_assert_kind == ASSERT_FN_PLAIN
        assert_placement_error(s, stmt)
        return
    let c: *Expr = stmt.if_cond
    # `a OP b`: emit_expr_binary records the two i64 operand registers its
    # compare reads, so the report shows exactly the compared values without
    # evaluating anything twice.
    var is_cmp: i32 = 0
    var lk: i32 = -1
    var rk: i32 = -1
    if c.kind == EXPR_BINARY and c.op >= OP_EQ and c.op <= OP_GE
        is_cmp = 1
        lk = assert_operand_kind(s, c.left)
        rk = assert_operand_kind(s, c.right)
        # A bool local is an i64 slot and `true` an int literal here, so
        # one side known to be bool makes both bool (the type rules say the
        # other is too) — interp_is_bool, as print interpolation decides.
        if interp_is_bool(s, c.left) == 1 or interp_is_bool(s, c.right) == 1
            lk = ASSERT_V_BOOL
            rk = ASSERT_V_BOOL
        s.assert_cap_expr = c
        s.assert_cap_ok = 0
    let a_cond: i32 = emit_expr(s, c)
    s.assert_cap_expr = null
    var show: i32 = 0
    if is_cmp == 1 and s.assert_cap_ok == 1 and lk >= 0 and rk >= 0
        show = 1
    let cap_l: i32 = s.assert_cap_l
    let cap_r: i32 = s.assert_cap_r
    var a_cond_i1: i32 = a_cond
    # Same i1 / i64 decision as STMT_IF (bool_reg_is_i1, AGAST #1646).
    if bool_reg_is_i1(s, c) == 0
        a_cond_i1 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, a_cond_i1)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, a_cond)
        emit_str(s, c", 0\n")
    let a_ok: i32 = next_label(s)
    let a_fail: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, a_cond_i1)
    emit_str(s, c", label %")
    emit_label(s, a_ok)
    emit_str(s, c", label %")
    emit_label(s, a_fail)
    emit_str(s, c"\n")
    begin_block(s, a_fail)

    if s.fn_assert_kind == ASSERT_FN_HELPER
        s.assert_site_used = 1
        let l_site: i32 = next_label(s)
        let l_own: i32 = next_label(s)
        let l_head: i32 = next_label(s)
        let line_r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, line_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_line\n")
        let has_r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, has_r)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, line_r)
        emit_str(s, c", 0\n  br i1 ")
        emit_reg(s, has_r)
        emit_str(s, c", label %")
        emit_label(s, l_site)
        emit_str(s, c", label %")
        emit_label(s, l_own)
        emit_str(s, c"\n")
        begin_block(s, l_site)
        let fp_r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fp_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_file\n")
        let fl_r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fl_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_file_len\n")
        s.print_helpers_used = 1
        emit_str(s, c"  call void @__ritz_print_bytes(i64 2, i64 ")
        emit_reg(s, fp_r)
        emit_str(s, c", i64 ")
        emit_reg(s, fl_r)
        emit_str(s, c")\n")
        assert_write_c(s, c":")
        assert_write_val(s, line_r, 0, ASSERT_V_SIGNED)
        assert_write_c(s, c": ")
        emit_str(s, c"  br label %")
        emit_label(s, l_head)
        emit_str(s, c"\n")
        begin_block(s, l_own)
        assert_write_own_loc(s, stmt.span.line)
        emit_str(s, c"  br label %")
        emit_label(s, l_head)
        emit_str(s, c"\n")
        begin_block(s, l_head)
    else
        assert_write_own_loc(s, stmt.span.line)

    assert_write_c(s, c"assertion failed")
    if stmt.assert_msg != null and stmt.assert_msg_len > 0
        assert_write_c(s, c": ")
        assert_write(s, stmt.assert_msg, stmt.assert_msg_len)
    else if show == 1
        assert_write_c(s, c": left ")
        assert_write_c(s, assert_op_text(c.op))
        assert_write_c(s, c" right")
    assert_write_c(s, c"\n")
    if show == 1
        assert_write_c(s, c"  left:  ")
        assert_write_val(s, cap_l, 0, lk)
        assert_write_c(s, c"\n  right: ")
        assert_write_val(s, cap_r, 0, rk)
        assert_write_c(s, c"\n")
    if s.fn_assert_kind == ASSERT_FN_HELPER
        assert_write_c(s, c"  in helper ")
        let hf: *FnDef = emitter_current_fn()
        if hf != null
            assert_write(s, hf.name, assert_fn_name_len(hf))
        assert_write_c(s, c" at ")
        var blen: i32 = 0
        let base: *u8 = assert_file_base(@blen)
        assert_write(s, base, blen)
        assert_write_c(s, c":")
        assert_write_val(s, 0, stmt.span.line as i64, ASSERT_V_SIGNED)
        assert_write_c(s, c"\n")
    # syscall(60, 1): Linux _exit.  `unreachable` tells LLVM the fail block
    # has no successor.
    emit_str(s, c"  call i64 asm sideeffect \"syscall\", ")
    emit_str(s, c"\"=&{rax},{rax},{rdi},~{rcx},~{r11},~{memory}\"")
    emit_str(s, c"(i64 60, i64 1)\n")
    emit_str(s, c"  unreachable\n")
    begin_block(s, a_ok)

# The call-site globals (weak: one copy across every module of a test
# binary; ritz0 defines the same symbols) and @__ritz_assert_val, the value
# printer: ritz0's _get_assert_val_fn instruction for instruction.
pub fn emit_assert_helpers(s: *EmitterState)
    if s.assert_site_used == 1
        emit_str(s, c"\n; assert call-site globals (AGAST #1869)\n")
        emit_str(s, c"@__ritz_assert_site_file = weak global ptr null\n")
        emit_str(s, c"@__ritz_assert_site_file_len = weak global i64 0\n")
        emit_str(s, c"@__ritz_assert_site_line = weak global i64 0\n")
    if s.assert_helpers_used == 0
        return
    emit_str(s, c"\n; assert value printer (AGAST #1869): kind 0 signed, 1 unsigned, 2 0x-hex, 3 bool\n")
    emit_str(s, c"@.ritz_assert_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_assert_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    emit_str(s, c"define internal void @__ritz_assert_val(i64 %v, i64 %kind) {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %buf = alloca [24 x i8]\n")
    emit_str(s, c"  %end = getelementptr [24 x i8], ptr %buf, i64 0, i64 24\n")
    emit_str(s, c"  %isb = icmp eq i64 %kind, 3\n")
    emit_str(s, c"  br i1 %isb, label %bool, label %num\n")
    emit_str(s, c"bool:\n")
    emit_str(s, c"  %t = icmp ne i64 %v, 0\n")
    emit_str(s, c"  %bp = select i1 %t, ptr @.ritz_assert_true, ptr @.ritz_assert_false\n")
    emit_str(s, c"  %bl = select i1 %t, i64 4, i64 5\n")
    emit_str(s, c"  %bpi = ptrtoint ptr %bp to i64\n")
    emit_str(s, c"  %r0 = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %bpi, i64 %bl)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"num:\n")
    emit_str(s, c"  %iss = icmp eq i64 %kind, 0\n")
    emit_str(s, c"  %isn = icmp slt i64 %v, 0\n")
    emit_str(s, c"  %neg = and i1 %iss, %isn\n")
    emit_str(s, c"  %negv = sub i64 0, %v\n")
    emit_str(s, c"  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    emit_str(s, c"  %ish = icmp eq i64 %kind, 2\n")
    emit_str(s, c"  %base = select i1 %ish, i64 16, i64 10\n")
    emit_str(s, c"  br label %digit\n")
    emit_str(s, c"digit:\n")
    emit_str(s, c"  %p = phi ptr [ %end, %num ], [ %np, %digit ]\n")
    emit_str(s, c"  %val = phi i64 [ %mag, %num ], [ %q, %digit ]\n")
    emit_str(s, c"  %d = urem i64 %val, %base\n")
    emit_str(s, c"  %lo = icmp ult i64 %d, 10\n")
    emit_str(s, c"  %dc = add i64 %d, 48\n")
    emit_str(s, c"  %hc = add i64 %d, 87\n")
    emit_str(s, c"  %ch64 = select i1 %lo, i64 %dc, i64 %hc\n")
    emit_str(s, c"  %ch = trunc i64 %ch64 to i8\n")
    emit_str(s, c"  %np = getelementptr i8, ptr %p, i64 -1\n")
    emit_str(s, c"  store i8 %ch, ptr %np\n")
    emit_str(s, c"  %q = udiv i64 %val, %base\n")
    emit_str(s, c"  %more = icmp ne i64 %q, 0\n")
    emit_str(s, c"  br i1 %more, label %digit, label %done\n")
    # At most 20 digits + "0x" + "-" = 23 bytes: the unconditional stores
    # stay inside the 24-byte buffer.
    emit_str(s, c"done:\n")
    emit_str(s, c"  %xp = getelementptr i8, ptr %np, i64 -1\n")
    emit_str(s, c"  store i8 120, ptr %xp\n")
    emit_str(s, c"  %zp = getelementptr i8, ptr %np, i64 -2\n")
    emit_str(s, c"  store i8 48, ptr %zp\n")
    emit_str(s, c"  %p3 = select i1 %ish, ptr %zp, ptr %np\n")
    emit_str(s, c"  %mp = getelementptr i8, ptr %p3, i64 -1\n")
    emit_str(s, c"  store i8 45, ptr %mp\n")
    emit_str(s, c"  %p4 = select i1 %neg, ptr %mp, ptr %p3\n")
    emit_str(s, c"  %p4i = ptrtoint ptr %p4 to i64\n")
    emit_str(s, c"  %ei = ptrtoint ptr %end to i64\n")
    emit_str(s, c"  %len = sub i64 %ei, %p4i\n")
    emit_str(s, c"  %r1 = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %p4i, i64 %len)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n")

# =============================================================================
# format_into(sink, "...") -- AGAST #1824
# =============================================================================
#
# The literal is split exactly as print's (emit_interp_literal), and every
# piece -- literal text or a formatted value -- is appended with one call to
# `sink.push_bytes(data: *u8, len: i64)`, resolved like a method call on the
# sink's struct: a UFCS helper (string_push_bytes, growbuf_push_bytes,
# vec_push_bytes$u8) or an impl method. ritz0's _emit_format_into is the
# oracle.
#
# A value is formatted into a stack buffer by @__ritz_fmt_int /
# @__ritz_fmt_strlen (emit_format_helpers), not print's write helpers. print
# shares the integer path (emit_fmt_int, AGAST #2128).

# Where format_into appends: the sink pointer and the push_bytes it names.
struct FmtSink
    recv: i32          # register holding the sink as a `ptr`
    callee: *u8        # IR name of push_bytes (no `@`)
    callee_len: i32
    fn_def: *FnDef     # its params (self, data, len) and return type

# Report a format_into error at `at`, naming `name` (may be null) before
# `msg`. Counts like emit_print_error.
fn fmt_error(s: *EmitterState, at: *Expr, name: *u8, name_len: i32, msg: *u8)
    emit_str(s, c"  ; ERROR: format_into\n")
    eprints_cstr(c"error: ritz1 cannot emit: line ")
    eprint_int(at.span.line as i64)
    eprints_cstr(c": format_into: ")
    if name != null
        eprints_cstr(c"type '")
        for i in 0..name_len
            eprint_char(*(name + i))
        eprints_cstr(c"' ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

fn fmt_is_ptr_type(t: i32) -> i32
    if t == TYPE_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return 1
    0

# The struct the sink expression points at, or null. The shapes
# arg_pointee_struct knows (`@x`, `@&x`, `@&a.b`, a `*T` local or param), a
# pointer-typed field (`st.out: *Vec<u8>`), and a call returning `*T`.
fn fmt_sink_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    let named: *u8 = arg_pointee_struct(s, e, out_len)
    if named != null
        return named
    *out_len = 0
    if e.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, e)
        if f != null and fmt_is_ptr_type(f.field_type) == 1 and f.field_type_name_len > 0
            *out_len = f.field_type_name_len
            return f.field_type_name
    else if e.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, e)
        if fd != null and fmt_is_ptr_type(fd.return_type) == 1 and fd.return_type_name_len > 0
            *out_len = fd.return_type_name_len
            return fd.return_type_name
    null

# Is the sink expression a struct value (not a pointer to one)?
fn fmt_sink_is_value(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null and loc.var_type == TYPE_STRUCT
            return 1
    var n: *u8 = null
    var l: i32 = 0
    resolve_expr_struct_name(s, e, @n, @l)
    if n != null
        return 1
    0

# The `ret` type push_bytes is called with.
fn fmt_emit_ret_type(s: *EmitterState, fd: *FnDef)
    let rt: i32 = fd.return_type
    if rt == TYPE_BOOL
        emit_str(s, c"i1")
    else if rt == TYPE_I32 or rt == TYPE_U32
        emit_str(s, c"i32")
    else if rt == TYPE_I16 or rt == TYPE_U16
        emit_str(s, c"i16")
    else if rt == TYPE_I8 or rt == TYPE_U8
        emit_str(s, c"i8")
    else if rt == TYPE_STRUCT and fd.return_type_name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, fd.return_type_name, fd.return_type_name_len)
    else
        emit_str(s, c"i64")

# push_bytes(sink, data, len). `data` is a `ptr` register; the length is the
# register len_reg when it is > 0, else the constant len_imm.
fn fmt_push(s: *EmitterState, k: *FmtSink, data: i32, len_reg: i32, len_imm: i64)
    let p2: *Param = k.fn_def.params.next
    let p3: *Param = p2.next
    var d: i32 = data
    if p2.param_type != TYPE_MUT_REF
        # A `*u8` param is an i64 in ritz1's signatures.
        d = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, d)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, data)
        emit_str(s, c" to i64\n")
    if k.fn_def.return_type == TYPE_VOID
        emit_str(s, c"  call void @")
    else
        let r: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, r)
        emit_str(s, c" = call ")
        fmt_emit_ret_type(s, k.fn_def)
        emit_str(s, c" @")
    emit_name(s, k.callee, k.callee_len)
    emit_str(s, c"(ptr ")
    emit_reg(s, k.recv)
    emit_str(s, c", ")
    emit_param_llvm_type(s, p2)
    emit_str(s, c" ")
    emit_reg(s, d)
    emit_str(s, c", ")
    emit_param_llvm_type(s, p3)
    emit_str(s, c" ")
    if len_reg > 0
        emit_reg(s, len_reg)
    else
        emit_int(s, len_imm)
    emit_str(s, c")\n")

# Append bytes known at compile time.
fn fmt_push_const(s: *EmitterState, k: *FmtSink, data: *u8, len: i32)
    let str_idx: i32 = add_string(s, data, len)
    let g: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, g)
    emit_str(s, c" = getelementptr [")
    emit_int(s, (len + 1) as i64)
    emit_str(s, c" x i8], ptr @.str.")
    emit_int(s, str_idx as i64)
    emit_str(s, c", i64 0, i64 0\n")
    fmt_push(s, k, g, 0, len as i64)

# Append the formatted value of placeholder `e`: as print's table, except
# that unsigned integers format unsigned. Returns 0 after reporting an
# error when `e` has no formatted form.
# Format the integer placeholder `e` (get_expr_type `ty`) into a stack
# buffer with @__ritz_fmt_int. Returns the ptr register of its decimal
# digits and stores their i64 length register in *out_len; -1 when `ty` is
# not an integer type. Signedness comes from the Ritz type: an unsigned
# value is zero-extended and divided unsigned (AGAST #2128). print, eprint
# and format_into all format integers here.
fn emit_fmt_int(s: *EmitterState, e: *Expr, ty: i32, out_len: *i32) -> i32
    var narrow: *u8 = null
    var is_int: i32 = 1
    var signed: i32 = 1
    if ty == TYPE_I64
        narrow = null
    else if ty == TYPE_U64
        signed = 0
    else if ty == TYPE_I32 or ty == TYPE_U32
        narrow = c"i32"
        signed = (ty == TYPE_I32) as i32
    else if ty == TYPE_I16 or ty == TYPE_U16
        narrow = c"i16"
        signed = (ty == TYPE_I16) as i32
    else if ty == TYPE_I8 or ty == TYPE_U8
        narrow = c"i8"
        signed = (ty == TYPE_I8) as i32
    else
        is_int = 0
    if is_int == 0
        return -1
    var v: i32 = emit_expr(s, e)
    if narrow != null
        # ritz1 holds a narrow int in an i64; rebuild it from its width.
        let t: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, t)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, v)
        emit_str(s, c" to ")
        emit_str(s, narrow)
        emit_str(s, c"\n")
        let x: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, x)
        if signed == 1
            emit_str(s, c" = sext ")
        else
            emit_str(s, c" = zext ")
        emit_str(s, narrow)
        emit_str(s, c" ")
        emit_reg(s, t)
        emit_str(s, c" to i64\n")
        v = x
    let buf: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, buf)
    emit_str(s, c" = alloca [24 x i8]\n")
    let start: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, start)
    emit_str(s, c" = call i64 @__ritz_fmt_int(ptr ")
    emit_reg(s, buf)
    emit_str(s, c", i64 ")
    emit_reg(s, v)
    if signed == 1
        emit_str(s, c", i1 1)\n")
    else
        emit_str(s, c", i1 0)\n")
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, buf)
    emit_str(s, c", i64 ")
    emit_reg(s, start)
    emit_str(s, c"\n")
    let n: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, n)
    emit_str(s, c" = sub i64 20, ")
    emit_reg(s, start)
    emit_str(s, c"\n")
    s.fmt_helpers_used = 1
    *out_len = n
    p

fn fmt_push_value(s: *EmitterState, k: *FmtSink, lit: *Expr, e: *Expr) -> i32
    var sv_name: *u8 = null
    var sv_len: i32 = 0
    let sv_kind: i32 = interp_strview_kind(s, e, @sv_name, @sv_len)
    if sv_kind != 0
        var v: i32 = emit_expr(s, e)
        if sv_kind == 2
            let p: i32 = i64_value_to_ptr(s, e, v)
            let agg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, agg)
            emit_str(s, c" = load %")
            emit_name(s, sv_name, sv_len)
            emit_str(s, c", ptr ")
            emit_reg(s, p)
            emit_str(s, c"\n")
            v = agg
        let ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr)
        emit_str(s, c" = extractvalue %")
        emit_name(s, sv_name, sv_len)
        emit_str(s, c" ")
        emit_reg(s, v)
        emit_str(s, c", 0\n")
        let len: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, len)
        emit_str(s, c" = extractvalue %")
        emit_name(s, sv_name, sv_len)
        emit_str(s, c" ")
        emit_reg(s, v)
        emit_str(s, c", 1\n")
        fmt_push(s, k, ptr, len, 0)
        return 1

    let ty: i32 = get_expr_type(s, e)
    if interp_is_bool(s, e) == 1
        let v: i32 = emit_expr(s, e)
        var b: i32 = v
        if bool_reg_is_i1(s, e) == 0
            b = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, b)
            emit_str(s, c" = icmp ne i64 ")
            emit_reg(s, v)
            emit_str(s, c", 0\n")
        let p: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, p)
        emit_str(s, c" = select i1 ")
        emit_reg(s, b)
        emit_str(s, c", ptr @.ritz_fmt_true, ptr @.ritz_fmt_false\n")
        let n: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, n)
        emit_str(s, c" = select i1 ")
        emit_reg(s, b)
        emit_str(s, c", i64 4, i64 5\n")
        s.fmt_helpers_used = 1
        fmt_push(s, k, p, n, 0)
        return 1

    var n: i32 = 0
    let p: i32 = emit_fmt_int(s, e, ty, @n)
    if p >= 0
        fmt_push(s, k, p, n, 0)
        return 1

    if ty == TYPE_PTR or ty == TYPE_PTR_PTR or ty == TYPE_REF or ty == TYPE_MUT_REF
        let v: i32 = emit_expr(s, e)
        let sp: i32 = i64_value_to_ptr(s, e, v)
        let sn: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sn)
        emit_str(s, c" = call i64 @__ritz_fmt_strlen(ptr ")
        emit_reg(s, sp)
        emit_str(s, c")\n")
        s.fmt_helpers_used = 1
        fmt_push(s, k, sp, sn, 0)
        return 1

    fmt_error(s, lit, null, 0, c"cannot format this value: only integers, bool, StrView and pointers have a formatted form")
    0

# Lower format_into(sink, <literal>). The sink is evaluated once, first.
pub fn emit_format_into(s: *EmitterState, e: *Expr) -> i32
    let sink: *Expr = e.args
    var lit: *Expr = null
    if sink != null
        lit = sink.next
    if lit == null or lit.next != null
        fmt_error(s, e, null, 0, c"format_into(sink, \"...\") takes two arguments: a pointer to the buffer and a string literal")
        return emit_print_zero(s)
    if lit.kind != EXPR_STRING_LIT and lit.kind != EXPR_CSTRING_LIT
        fmt_error(s, e, null, 0, c"format_into's second argument must be a string literal: its placeholders are resolved at compile time")
        return emit_print_zero(s)
    if fmt_sink_is_value(s, sink) == 1
        fmt_error(s, e, null, 0, c"format_into's sink must be a pointer to the buffer (`@&buf`), not a value: appending to a copy would be lost")
        return emit_print_zero(s)
    var tn_len: i32 = 0
    let tn: *u8 = fmt_sink_struct(s, sink, @tn_len)
    if tn == null
        fmt_error(s, e, null, 0, c"the sink is not a pointer to a struct with a push_bytes(data: *u8, len: i64) method to append through")
        return emit_print_zero(s)

    # push_bytes, in emit_expr_method's order: a UFCS helper, else an impl
    # method (whose IR name is `Type_push_bytes`).
    var callee: *u8 = null
    var callee_len: i32 = 0
    var fd: *FnDef = ufcs_fn_def(s, tn, tn_len, c"push_bytes", 10)
    if fd != null
        callee = fd.name
        callee_len = fd.name_len
        add_extern(s, fd.name, fd.name_len)
    else
        fd = find_impl_method(s, tn, tn_len, c"push_bytes", 10)
        if fd != null
            callee_len = tn_len + 11
            callee = malloc((callee_len + 1) as i64)
            for i in 0..tn_len
                *(callee + i) = *(tn + i)
            *(callee + tn_len) = '_'
            for i in 0..10
                *(callee + tn_len + 1 + i) = *(c"push_bytes" + i)
            *(callee + callee_len) = 0
            if fd.is_local == 0
                add_method_extern(s, tn, tn_len, c"push_bytes", 10)
    if fd == null
        fmt_error(s, e, tn, tn_len, c"has no push_bytes(data: *u8, len: i64) method to append through")
        return emit_print_zero(s)
    var np: i32 = 0
    var pp: *Param = fd.params
    while pp != null
        np = np + 1
        pp = pp.next
    if np != 3 or fd.params.next.next.param_type != TYPE_I64
        fmt_error(s, e, tn, tn_len, c"push_bytes must take (self, data: *u8, len: i64) to be a format_into sink")
        return emit_print_zero(s)

    let v: i32 = emit_expr(s, sink)
    var k: FmtSink
    k.recv = i64_value_to_ptr(s, sink, v)
    k.callee = callee
    k.callee_len = callee_len
    k.fn_def = fd
    emit_interp_literal(s, 0, @k, lit)

# The helpers fmt_push_value calls. Emitted once, after the functions, by a
# module that used any of them; ritz0's _format_int_helper /
# _format_strlen_helper define the same functions. "no-builtins" keeps
# clang from turning the strlen loop into a libc call.
pub fn emit_format_helpers(s: *EmitterState)
    if s.fmt_helpers_used == 0
        return
    emit_str(s, c"\n; format_into helpers (AGAST #1824), as ritz0's _format_int_helper\n")
    # Decimal digits back to front, ending at buf[20]; returns the first
    # byte's index. A negative signed value's magnitude 0 - v is right read
    # unsigned even for i64::MIN; unsigned values divide unsigned.
    emit_str(s, c"define internal i64 @__ritz_fmt_int(ptr %buf, i64 %v, i1 %signed) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %lt = icmp slt i64 %v, 0\n")
    emit_str(s, c"  %neg = and i1 %signed, %lt\n")
    emit_str(s, c"  %negv = sub i64 0, %v\n")
    emit_str(s, c"  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    emit_str(s, c"  br label %digit\n")
    emit_str(s, c"digit:\n")
    emit_str(s, c"  %pos = phi i64 [ 20, %entry ], [ %np, %digit ]\n")
    emit_str(s, c"  %val = phi i64 [ %mag, %entry ], [ %q, %digit ]\n")
    emit_str(s, c"  %np = sub i64 %pos, 1\n")
    emit_str(s, c"  %d = urem i64 %val, 10\n")
    emit_str(s, c"  %ch64 = add i64 %d, 48\n")
    emit_str(s, c"  %ch = trunc i64 %ch64 to i8\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %buf, i64 %np\n")
    emit_str(s, c"  store i8 %ch, ptr %cp\n")
    emit_str(s, c"  %q = udiv i64 %val, 10\n")
    emit_str(s, c"  %more = icmp ne i64 %q, 0\n")
    emit_str(s, c"  br i1 %more, label %digit, label %sign\n")
    emit_str(s, c"sign:\n")
    emit_str(s, c"  br i1 %neg, label %minus, label %done\n")
    emit_str(s, c"minus:\n")
    emit_str(s, c"  %mp = sub i64 %np, 1\n")
    emit_str(s, c"  %mcp = getelementptr i8, ptr %buf, i64 %mp\n")
    emit_str(s, c"  store i8 45, ptr %mcp\n")
    emit_str(s, c"  br label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  %start = phi i64 [ %np, %sign ], [ %mp, %minus ]\n")
    emit_str(s, c"  ret i64 %start\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"define internal i64 @__ritz_fmt_strlen(ptr %p) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"scan:\n")
    emit_str(s, c"  %n = phi i64 [ 0, %entry ], [ %n1, %scan ]\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %p, i64 %n\n")
    emit_str(s, c"  %c = load i8, ptr %cp\n")
    emit_str(s, c"  %n1 = add i64 %n, 1\n")
    emit_str(s, c"  %nul = icmp eq i8 %c, 0\n")
    emit_str(s, c"  br i1 %nul, label %done, label %scan\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret i64 %n\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"@.ritz_fmt_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_fmt_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
