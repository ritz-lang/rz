# ritz1/src/emitter_print.ritz - lowering of the print builtin (AGAST #1521)
#
# `print("a={a} b={f(b)}\n")` becomes a write of "a=", the value of `a`, a
# write of " b=", the value of `f(b)`, and a write of "\n". This is ritz0's
# `_emit_interp_string_print` / `_emit_print_value`, and the output must be
# byte-identical to ritz0's.
#
# `{x}` is `x.show(w)` when x's type has a Display impl in scope (AGAST
# #4381, ritz0's #202); `{x:?}` is `show_debug`, and a struct with no Debug
# impl auto-derives `Name { field: value, ... }`. `w` is the implicit stdout
# Writer (print/println), stderr's (eprint/eprintln), or the program's own
# (write/writeln). A type with neither an impl nor an intrinsic form is a
# located diagnostic naming the impl to add.
#
# With no impl in scope (a self-contained program), values print by type:
#
#   integers   decimal, signed or unsigned by the Ritz type (AGAST #2128):
#              u8 200 prints `200`, u64::MAX `18446744073709551615`. The
#              digits come from format_into's @__ritz_fmt_int.
#   bool       `true` / `false`
#   StrView    its `len` bytes from `ptr` (also the %Span$u8 a bare "..."
#              lowers to, and a @StrView / *StrView), as ritz0 (#1641)
#   pointers   the NUL-terminated bytes they point at
#   anything   else is the missing-impl diagnostic, as in ritz0
#
# print passes fd 1, eprint fd 2 (#1641).
#
# The module helpers (`@__ritz_print_*`, the implicit Writer's fd sink) are
# defined once per module that uses them, by emit_print_helpers.
#
# interp.ritz holds the placeholder rules and the expression parser.

import ritzlib.cstr    # strview_from_cstr: the source file's name
import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str     # memset (compiler-built Expr nodes)
import ritzlib.strview
import ritzlib.string  # String: messages and names built with format_into
import ritzlib.option
import ast
import types
import emitter_core
import emitter_seam   # emit_expr / emit_stmt / ...: the emit table (AGAST #4697)
import emitter_expr_access   # emit_struct_copy (AGAST #4697)
import text_bridge     # no_name / named_by / llvm_text (AGAST #4696)
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import diag   # diag_error_at (AGAST #3445), fn_display_name (AGAST #4018)
import lexer
import interp
import bool_check   # AGAST #2342
import bool_kind
import ast_helpers   # is_test_fn / is_test_helper_fn (AGAST #1869)
import emitter_call_lower   # AGAST #1818: below the emission modules

# The `write` syscall as inline asm; `(i64 1, i64 <fd>, i64 <ptr>, i64 <len>)`
# follows it.
fn syscall_write_asm() -> StrView
    "call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\""

# A copy of `text` that lives for the rest of the compile: a compiler-built
# name or spelling is held by a local's table, an Expr or the string table
# after the String it was built in is gone (one module per process, so it is
# never freed).
fn kept_copy(text: StrView) -> StrView
    let copy: *u8 = malloc(text.len)
    memcpy(copy, text.ptr, text.len)
    StrView { ptr: copy, len: text.len }

# True when `name` names something: not `no_name()`, and not empty.
fn named(name: StrView) -> bool
    not unnamed(name) and name.len > 0

# A compiler-emitted error at `span`: an IR comment, a stderr line located
# there (diag, AGAST #3445), and one more on s.diag.error_count (AGAST #1369), so
# ritz1 exits non-zero instead of writing the output.
fn fmt_error_at(s: *EmitterState, span: SrcSpan, msg: StrView)
    format_into(s, "  ; ERROR: {msg}\n")
    diag_error_at(emitter_source_file(), span)
    eprints("ritz1 cannot emit: ")
    eprints(msg)
    eprints("\n")
    s.diag.error_count = s.diag.error_count + 1

# fmt_error_at, at a print literal.
fn emit_print_error(s: *EmitterState, lit: *Expr, msg: StrView)
    fmt_error_at(s, lit.span, msg)

# A placeholder `{expr:spec}` (`expr` untrimmed): refuse an unknown spec, and
# -- until AGAST #202 prints specs through ritzlib.fmt's Display -- a valid
# one, rather than print the value without it. ritz0's messages are
# interp_spec.py's, word for word.
fn emit_spec_error(s: *EmitterState, lit: *Expr, expr: StrView, spec: StrView)
    diag_error_at(emitter_source_file(), lit.span)
    if interp_spec_valid(spec) == 0
        var lo: i32 = 0
        let n: i32 = interp_trim(expr, @lo)
        eprints("unknown format spec `")
        eprints(spec)
        eprints("` in `{")
        eprints(StrView { ptr: expr.ptr + lo, len: n as i64 })
        eprints(":")
        eprints(spec)
        eprints("}`: the v1 specs are x X b o, a zero-padded width (08x), <N >N ^N and ?")
    else
        eprints("format spec `")
        eprints(spec)
        eprints("` is parsed but not printed until AGAST #202; drop `:")
        eprints(spec)
        eprints("` for now")
    eprints("\n")
    format_into(s, "  ; ERROR: format spec\n")
    s.diag.error_count = s.diag.error_count + 1

fn emit_print_zero(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0\n")
    z

# A `ptr` register to the compile-time bytes `data`, a module string.
fn str_const_ptr(s: *EmitterState, data: StrView) -> i32
    let idx: i32 = add_string(s, data)
    let size: i64 = data.len + 1
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = getelementptr [{size} x i8], ptr @.str.{idx}, i64 0, i64 0\n")
    p

# Is `e` a bool in ritz0's eyes (an i1 there)?  See bool_check.ritz.
pub fn interp_is_bool(s: *EmitterState, e: *Expr) -> bool
    bool_kind(s, e) == BK_BOOL

# Is `name` one of the two `{ ptr, i64 }` view types: StrView, or the
# %Span$u8 a bare "..." literal lowers to (AGAST #98)?
fn interp_is_view_name(name: StrView) -> bool
    name_eq(name, "StrView") == 1 or name_eq(name, "Span$u8") == 1

fn is_addr_kind(t: TypeKind) -> bool
    t == TypeKind.Ptr or t == TypeKind.Ref or t == TypeKind.MutRef

fn ident_of(e: *Expr) -> StrView
    e.ident

fn local_type_name(lv: *LocalVar) -> StrView
    StrView { ptr: lv_type_name(lv), len: lv_type_name_len(lv) as i64 }

fn field_type_name(f: *StructField) -> StrView
    StrView { ptr: f.field_type_name, len: f.field_type_name_len as i64 }

fn return_type_name(f: *FnDef) -> StrView
    StrView { ptr: f.return_type_name, len: f.return_type_name_len as i64 }

# An element `a[i]`, not a slice `a[i..j]`.
fn is_element(e: *Expr) -> bool
    e != null and e.kind == ExprKind.Index and e.left != null and e.right != null and e.right.kind != ExprKind.Range

# AGAST #4576: the struct the element `e` is BY VALUE (`a[i]`, `p[i]` or
# `args[i]`: a `[N]S` local, field, global or const, a `*S`, or a Vec / Span
# of S); unnamed otherwise.  A placeholder's nodes are parsed after Sema, and
# synth_slot_ty gives an element its storage slot (`args[i]` through a Span is
# the byte path's u8), so the print path asks for the struct by name, as
# `.field` on an element does (index_elem_struct_name).  A pointer element
# (`[N]*S`, a `**S` field) is no struct value: it prints as a pointer.
fn fmt_index_struct(s: *EmitterState, e: *Expr) -> StrView
    if not is_element(e)
        return no_name()
    let n: StrView = element_type_name(s, e)
    # An enum, which these name as well, is no struct to find_struct.
    if not named(n) or find_struct(s, n) == null
        return no_name()
    n

# The type an element `e` names, struct or not (fmt_index_struct's lookup).
fn element_type_name(s: *EmitterState, e: *Expr) -> StrView
    if index_through(s, e) != null
        # A Vec / Span / pointer-to-array buffer: a struct or pointer held there.
        return index_through_value_struct(s, e)
    # `[N]*S` elements (a local, field, global or const) and `**S` fields name
    # S too, for `.field` through them.
    let elem: TypeKind = array_elem_record(s, e).elem
    if elem != TypeKind.Void and elem != TypeKind.Struct
        return no_name()
    if e.left.kind == ExprKind.Member
        let f: *StructField = resolve_member_chain_field(s, e.left)
        if f == null or f.field_type == TypeKind.PtrPtr
            return no_name()
    index_elem_struct_name(s, e)

# AGAST #4576: the view type (StrView, Span$u8) an element `e` POINTS AT, when
# it is one of a `[N]*V` (a local, field, global or const), a `**V` field or a
# `**V` local; unnamed otherwise.  fmt_index_struct leaves these out: the
# element is the pointer, which interp_view_of loads the view through.
fn fmt_index_view_ptr(s: *EmitterState, e: *Expr) -> StrView
    if not is_element(e)
        return no_name()
    var n: StrView = no_name()
    let pointee: NamedKind = array_elem_pointee(s, e)
    if pointee.kind == TypeKind.Struct
        n = pointee.name
    else
        n = ptrptr_type_name(s, e.left)
    if not named(n) or not interp_is_view_name(n)
        return no_name()
    n

# The type a `**T` field or local `b` points through; unnamed for any other.
fn ptrptr_type_name(s: *EmitterState, b: *Expr) -> StrView
    match b.kind
        ExprKind.Member =>
            let f: *StructField = resolve_member_chain_field(s, b)
            if f != null and f.field_type == TypeKind.PtrPtr
                return field_type_name(f)
        ExprKind.Ident =>
            let lv: *LocalVar = find_local_struct_name(s, ident_of(b))
            if lv != null and lv_var_type(lv) == TypeKind.PtrPtr
                return local_type_name(lv)
        _ => pass
    no_name()

# The struct `e` is by value: resolve_expr_struct_name's, else a method call
# returning one (`{s.as_view()}`, #4533: resolve_expr_struct_name's method
# arm only sees `s.sym.module.impls`, and String's impl lives in an imported
# module), else an element `a[i]` / `p[i]` / `args[i]` (AGAST #4576).
fn value_struct_name(s: *EmitterState, e: *Expr) -> StrView
    let resolved: StrView = resolve_expr_struct_name(s, e)
    if named(resolved)
        return resolved
    let returned: StrView = call_result_struct_name(s, e)
    if named(returned)
        return returned
    fmt_index_struct(s, e)

# How a value is one of the `{ ptr, i64 }` view types (StrView, Span$u8).
enum ViewForm
    NotView
    Value      # the aggregate, by value
    Pointer    # a pointer or reference to one (an i64 register)

struct ViewOf
    form: ViewForm
    name: StrView   # the view's LLVM type name

fn not_a_view() -> ViewOf
    ViewOf { form: ViewForm.NotView, name: no_name() }

# Is `e` a StrView, by value or behind a pointer?  ritz0 decides by LLVM type
# (_is_strview_llvm_type); this finds the same set from ritz1's locals, struct
# fields, calls, consts and literals.
fn interp_view_of(s: *EmitterState, e: *Expr) -> ViewOf
    if e.kind == ExprKind.Member
        return member_view_of(s, e)
    if e.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, ident_of(e))
        if loc != null and interp_is_view_name(local_type_name(loc)) and is_addr_kind(lv_var_type(loc))
            return ViewOf { form: ViewForm.Pointer, name: local_type_name(loc) }
    let n: StrView = value_struct_name(s, e)
    if not named(n)
        # An element that points at a view, as a local `*StrView` does (AGAST #4576).
        let pointed: StrView = fmt_index_view_ptr(s, e)
        if named(pointed)
            return ViewOf { form: ViewForm.Pointer, name: pointed }
    if interp_is_view_name(n)
        return ViewOf { form: ViewForm.Value, name: n }
    not_a_view()

# A field `x.f` of a view type: by value, or a pointer or reference to one.
fn member_view_of(s: *EmitterState, e: *Expr) -> ViewOf
    let fld: *StructField = resolve_member_chain_field(s, e)
    if fld == null or not interp_is_view_name(field_type_name(fld))
        return not_a_view()
    if fld.field_type == TypeKind.Struct
        return ViewOf { form: ViewForm.Value, name: field_type_name(fld) }
    if is_addr_kind(fld.field_type)
        return ViewOf { form: ViewForm.Pointer, name: field_type_name(fld) }
    not_a_view()

# =============================================================================
# Display / Debug dispatch (AGAST #4381, ritz0's #202 ported)
#
# `{x}` is `x.show(w)`, `{x:?}` is `x.show_debug(w)`, where `w` is the
# implicit stdout Writer (print/println), stderr's (eprint/eprintln) or the
# one the program named (write/writeln). The value's own impl is the only
# word on how it prints; the compiler's primitive formatters remain the
# fallback for a program with no impl in scope, and `?` additionally
# auto-derives a struct's `Name { field: value, ... }`. A type with neither
# is a located diagnostic naming the impl to add.
# =============================================================================

# Where a print statement's bytes go.
enum SinkKind
    Fd        # the implicit fd: a write syscall per piece
    Writer    # the Writer the program passed to write/writeln

# `arg` is the Writer argument the impl methods take, built once; for an Fd
# sink the fd Writer is built only when an impl is actually called, so a
# self-contained program that only prints ints still needs no Writer struct.
# `isink` / `ilen` are the Writer's field indices.
struct PrintSink
    kind: SinkKind
    fd: i64
    wptr: i32
    arg: *Expr
    isink: i32
    ilen: i32

var g_fmt_seq: i32 = 0
var g_fmt_writer_used: bool = false

fn writer_type() -> StrView
    "Writer"

# A fresh hidden local name, `<role>_<n>`.
fn fmt_name(role: StrView) -> StrView
    let n: i32 = g_fmt_seq
    g_fmt_seq = n + 1
    var name: String = string_new()
    format_into(@&name, "{role}_{n}")
    kept_copy(name.as_view())

# A zeroed Expr, so every field the emitter reads on a compiler-built node
# (bracket, own_raw, slot_type, ...) starts at its "not set" value.
fn fmt_expr_zero(kind: ExprKind, span: SrcSpan) -> *Expr
    let e: *Expr = malloc(sizeof(Expr)) as *Expr
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = kind
    e.span = span
    e

fn fmt_ident_expr(name: StrView, span: SrcSpan) -> *Expr
    let e: *Expr = fmt_expr_zero(ExprKind.Ident, span)
    e.ident = name
    e

fn fmt_unary_expr(op: OpKind, operand: *Expr, span: SrcSpan) -> *Expr
    let e: *Expr = fmt_expr_zero(ExprKind.Unary, span)
    e.op = op
    e.operand = operand
    e

fn fmt_member_expr(base: *Expr, name: StrView, span: SrcSpan) -> *Expr
    let e: *Expr = fmt_expr_zero(ExprKind.Member, span)
    e.left = base
    e.ident = name
    e

fn fmt_method_expr(recv: *Expr, name: StrView, args: *Expr, span: SrcSpan) -> *Expr
    let e: *Expr = fmt_expr_zero(ExprKind.Method, span)
    e.left = recv
    e.ident = name
    e.args = args
    e

# AGAST #4410: a placeholder's expression is parsed *after* the Sema walk, so
# no node in it carries Sema's slot annotation.  Note the emitter's slot type
# on each node here, at construction, so the emit path's expr_slot_ty reads a
# real type instead of the node-local fallback (the `?` an unannotated
# identifier printed, ritzlib/iovec.ritz's regression under #4404).
fn fmt_note_slots(s: *EmitterState, e: *Expr)
    if e == null
        return
    expr_note_sema_ty(e, synth_slot_ty(s, e))
    fmt_note_slots(s, e.left)
    fmt_note_slots(s, e.right)
    fmt_note_slots(s, e.operand)
    fmt_note_slots(s, e.args)
    fmt_note_slots(s, e.next)

# interp_parse_expr, with the parsed nodes' slot types noted.
fn fmt_parse(s: *EmitterState, text: StrView, line: i32, col: i32) -> *Expr
    let e: *Expr = interp_parse_expr(s.sym.mono.pctx, text, line, col)
    if e != null
        fmt_note_slots(s, e)
    e

# The Ritz type of `e`'s value and the name a Display/Debug impl for it would
# be registered under (unnamed when none is derivable).
struct FmtType
    kind: TypeKind
    name: StrView
    is_bool: bool
    pointee: TypeKind

fn fmt_type(kind: TypeKind) -> FmtType
    FmtType { kind: kind, name: no_name(), is_bool: false, pointee: TypeKind.I64 }

# A bool lives in an i64 slot (AGAST #1521).
fn bool_fmt_type() -> FmtType
    FmtType { kind: TypeKind.I64, name: "bool", is_bool: true, pointee: TypeKind.I64 }

# A pointer to `pointee`: a `*u8` dispatches as `ptr_u8`.
fn ptr_fmt_type(kind: TypeKind, pointee: TypeKind) -> FmtType
    var ft: FmtType = fmt_type(kind)
    ft.pointee = pointee
    if pointee == TypeKind.U8
        ft.name = "ptr_u8"
    ft

# The dispatch name of a reference's referent, when it is a primitive or
# `*u8` (`{r}` prints what r refers to, as ritz0 reads a RefType).
fn fmt_pointee_name(kind: TypeKind, inner: i32) -> StrView
    if kind == TypeKind.Ptr and inner == (TypeKind.U8 as i32)
        return "ptr_u8"
    primitive_spelling(kind)

fn fmt_type_of(s: *EmitterState, e: *Expr) -> FmtType
    if e == null
        return fmt_type(TypeKind.I64)
    # get_expr_type alone cannot tell a bool from an i64.
    if interp_is_bool(s, e)
        return bool_fmt_type()
    let t: TypeKind = expr_slot_ty(e)
    # AGAST #4576: an element of a `[N]*T` (a local, field, global or const)
    # is a pointer, whose i64 slot printed its address as a number.
    if e.kind == ExprKind.Index and ty_int_bits(t) > 0
        let rec: ElemRecord = array_elem_record(s, e)
        if rec.elem == TypeKind.Ptr
            return ptr_fmt_type(TypeKind.Ptr, ptr_slot_flat(rec.pointee))
    var ft: FmtType = fmt_type(t)
    match t
        TypeKind.Ref | TypeKind.MutRef =>
            ft.name = referent_name(s, e)
            return ft
        TypeKind.Ptr | TypeKind.PtrPtr =>
            if e.kind == ExprKind.CstringLit
                ft.name = "ptr_u8"
                return ft
            return ptr_fmt_type(t, get_deref_store_type(s, e))
        _ => pass
    let n: StrView = value_struct_name(s, e)
    if named(n)
        ft.kind = TypeKind.Struct
        ft.name = n
        return ft
    if t == TypeKind.Struct
        ft.name = struct_slot_name(s, e)
        return ft
    ft.name = primitive_spelling(t)
    ft

# What the reference `e` refers to: a local's declared referent, or a call's
# declared return type.
fn referent_name(s: *EmitterState, e: *Expr) -> StrView
    var callee: *FnDef = null
    match e.kind
        ExprKind.Ident =>
            return local_referent_name(s, e)
        ExprKind.Call =>
            callee = find_call_fn(s, e)
        ExprKind.Method =>
            callee = method_call_def(s, e)
        _ => pass
    if callee != null and callee.return_type_name_len > 0
        return return_type_name(callee)
    no_name()

# What the reference local `e` refers to: its declared type name, else its
# primitive pointee's.
fn local_referent_name(s: *EmitterState, e: *Expr) -> StrView
    let loc: *LocalVar = find_local_struct_name(s, ident_of(e))
    if loc == null
        return no_name()
    if lv_type_name_len(loc) > 0
        return local_type_name(loc)
    fmt_pointee_name(lv_pointee_type(loc), lv_inner_pointee_type(loc))

# A struct-slot `e` no resolver named: a local's declared type, or a field's
# (resolve_expr_struct_name has no member arm: `{o.inner}`, `{s.f.g}`).
fn struct_slot_name(s: *EmitterState, e: *Expr) -> StrView
    match e.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, ident_of(e))
            if loc != null and lv_type_name_len(loc) > 0
                return local_type_name(loc)
        ExprKind.Member =>
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type_name_len > 0
                return field_type_name(fld)
        _ => pass
    no_name()

# The source spelling a diagnostic uses: `ptr_u8` is `*u8`, and a single
# `$` generic marker reads as `<arg>` (`Span$u8` -> `Span<u8>`).
fn fmt_spelling(name: StrView) -> StrView
    if not named(name)
        return "?"
    if name_eq(name, "ptr_u8") == 1
        return "*u8"
    let at: i64 = only_dollar(name)
    if at < 0
        return name
    let base: StrView = StrView { ptr: name.ptr, len: at }
    let arg: StrView = StrView { ptr: name.ptr + at + 1, len: name.len - at - 1 }
    var spelled: String = string_new()
    format_into(@&spelled, "{base}<{arg}>")
    kept_copy(spelled.as_view())

# Where the one `$` in `name` is; -1 when it has none, or more than one.
fn only_dollar(name: StrView) -> i64
    var at: i64 = -1
    for i in 0..name.len
        if name.get(i) == '$'
            if at >= 0
                return -1
            at = i
    at

# `name` up to its first `$`: a generic instance's base (`Span$u8` -> `Span`).
fn generic_base(name: StrView) -> StrView
    var n: i64 = 0
    while n < name.len and name.get(n) != '$'
        n += 1
    StrView { ptr: name.ptr, len: n }

# `name` is `family` or an instance of it (`Span`, `Span$u8`).
fn in_family(name: StrView, family: StrView) -> bool
    name_eq(generic_base(name), family) == 1

# A built-in target keeps its ritzlib impl as the only word on how it prints;
# no struct's Debug is auto-derived for it (ritz0's is_builtin_target).
fn fmt_is_builtin_target(name: StrView) -> bool
    if name_eq(name, "StrView") == 1 or name_eq(name, "ptr_u8") == 1
        return true
    in_family(name, "Span") or in_family(name, "Option") or in_family(name, "Result")

# `method` of impl `ib` when it is an impl of trait `tname`; null otherwise.
fn impl_trait_method(ib: *ImplBlock, tname: StrView, method: StrView) -> *FnDef
    if ib.trait_name == null or name_eq(StrView { ptr: ib.trait_name, len: ib.trait_name_len as i64 }, tname) == 0
        return null
    var m: *FnDef = ib.methods
    while m != null
        if name_eq(StrView { ptr: m.name, len: m.name_len as i64 }, method) == 1
            return m
        m = m.next
    null

# The first `tname` impl of `type_name` in the module with a `method`; a
# `concrete` one only (no type parameters) when asked.
fn module_trait_method(s: *EmitterState, type_name: StrView, tname: StrView, method: StrView, concrete: bool) -> *FnDef
    var ib: *ImplBlock = s.sym.module.impls
    while ib != null
        if (not concrete or ib.type_params == null) and name_eq(StrView { ptr: ib.type_name, len: ib.type_name_len as i64 }, type_name) == 1
            let m: *FnDef = impl_trait_method(ib, tname, method)
            if m != null
                return m
        ib = ib.next
    null

# The trait impl's method, or null. The impls table is the authority: an
# inherent `show` is not Display, and Display's `show` never answers `?`.
# A generic instance finds a concrete built-in impl under the base name
# (`Span$u8` -> `impl Display for Span<u8>`), or its monomorphized instance
# (`Foo$i32_show`) in the module's functions.
fn fmt_impl_method(s: *EmitterState, type_name: StrView, tname: StrView, method: StrView) -> *FnDef
    let own: *FnDef = module_trait_method(s, type_name, tname, method, false)
    if own != null
        return own
    let base: StrView = generic_base(type_name)
    if base.len < type_name.len
        let generic: *FnDef = module_trait_method(s, base, tname, method, true)
        if generic != null
            return generic
    find_spec_impl_method(s, type_name, method)

# A static alloca of `ty` at register `slot`, commented (entry_alloca_reg's line).
fn alloca_at(s: *EmitterState, slot: i32, ty: StrView, comment: StrView)
    entry_alloca_reg_begin(s, slot)
    format_into(s, "{ty}  ; {comment}\n")
    entry_alloca_reg_end(s)

# Store `e`'s value in a fresh local, so a method call can dispatch on any
# expression form (a binary op, a call, a field) by name. Returns the ident.
fn fmt_materialize(s: *EmitterState, e: *Expr, ft: *FmtType, span: SrcSpan) -> *Expr
    let name: StrView = fmt_name("tmp")
    # A struct receiver is copied into the slot below, so an element `a[i]`
    # is no "whole struct where a number goes" (AGAST #4576).
    let v: i32 = emit_struct_copy(s, e, ft.kind)
    let slot: i32 = next_reg(s)
    match ft.kind
        TypeKind.Struct =>
            entry_alloca_reg_begin_named(s, slot)
            emit_name(s, ft.name)
            format_into(s, "  ; print receiver\n")
            entry_alloca_reg_end(s)
            emit_struct_store_or_copy(s, TypeKind.Struct, ft.name, v, slot)
            add_local_struct(s, name, slot, TypeKind.Struct, ft.name)
        TypeKind.MutRef =>
            alloca_at(s, slot, "ptr", "print receiver (mut ref)")
            format_into(s, "  store ptr %.{v}, ptr %.{slot}\n")
            add_local_full(s, name, slot, TypeKind.MutRef, ft.name, ty_from_name(ft.name), 0, TypeKind.Void)
        TypeKind.Ref | TypeKind.Ptr | TypeKind.PtrPtr =>
            alloca_at(s, slot, "i64", "print receiver (ref/ptr)")
            format_into(s, "  store i64 %.{v}, ptr %.{slot}\n")
            add_local_full(s, name, slot, ft.kind, ft.name, receiver_pointee(ft), 0, TypeKind.Void)
        TypeKind.F32 | TypeKind.F64 =>
            let mem: StrView = llvm_text(ty_mem_llvm(ft.kind))
            alloca_at(s, slot, mem, "print receiver (float)")
            format_into(s, "  store {mem} %.{v}, ptr %.{slot}\n")
            add_local(s, name, slot, ft.kind)
        _ =>
            materialize_int(s, v, slot, ft.kind)
            add_local(s, name, slot, ft.kind)
    if ft.is_bool
        let bl: *LocalVar = find_local_struct_name(s, name)
        if bl != null
            bl.is_bool = 1
    fmt_ident_expr(name, span)

# A reference or pointer receiver's pointee: a `@T`'s named referent, else the
# pointee fmt_type_of found.
fn receiver_pointee(ft: *FmtType) -> TypeKind
    if ft.kind == TypeKind.Ref
        let referent: TypeKind = ty_from_name(ft.name)
        if referent != TypeKind.Void
            return referent
    ft.pointee

# An integer receiver's slot: a narrow one in its own width.
fn materialize_int(s: *EmitterState, v: i32, slot: i32, kind: TypeKind)
    let bits: i32 = ty_int_bits(kind)
    if bits == 0 or bits == 64
        alloca_at(s, slot, "i64", "print receiver")
        format_into(s, "  store i64 %.{v}, ptr %.{slot}\n")
        return
    let mem: StrView = llvm_text(ty_mem_llvm(kind))
    let t: i32 = next_reg(s)
    format_into(s, "  %.{t} = trunc i64 %.{v} to {mem}\n")
    alloca_at(s, slot, mem, "print receiver (narrow int)")
    format_into(s, "  store {mem} %.{t}, ptr %.{slot}\n")

# ---- Writers -------------------------------------------------------------

# The index of `st`'s field `name`, or -1.
fn fmt_writer_field(st: *StructDef, name: StrView) -> i32
    var i: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if name_eq(StrView { ptr: f.name, len: f.name_len as i64 }, name) == 1
            return i
        i = i + 1
        f = f.next
    -1

fn fmt_writer_error(s: *EmitterState, span: SrcSpan)
    fmt_error_at(s, span, "printing needs the Writer struct in scope (ritzlib.fmt.Writer): its Display impls take one")

# The Writer struct's sink / fd / len field indices, as the print paths use them.
struct WriterShape
    found: bool
    sink: i32
    fd: i32
    len: i32

# The Writer in scope, or `found` false after reporting at `span`.
fn fmt_writer_shape(s: *EmitterState, span: SrcSpan) -> WriterShape
    var shape: WriterShape = WriterShape { found: false, sink: -1, fd: -1, len: -1 }
    let st: *StructDef = find_struct(s, writer_type())
    if st != null
        shape.sink = fmt_writer_field(st, "sink")
        shape.fd = fmt_writer_field(st, "fd")
        shape.len = fmt_writer_field(st, "len")
        shape.found = shape.sink >= 0 and shape.fd >= 0 and shape.len >= 0
    if not shape.found
        fmt_writer_error(s, span)
    shape

# The implicit Writer for an fd, built in a hidden local, `@&` it. Built
# here rather than by calling ritzlib.fmt's stdout_writer, so a
# self-contained program prints without importing a body it would have to
# link. The layout is Writer's: sink, state, fd, cap, len.
fn fmt_make_fd_writer(s: *EmitterState, sink: *PrintSink, span: SrcSpan)
    let shape: WriterShape = fmt_writer_shape(s, span)
    if not shape.found
        return
    let slot: i32 = next_reg(s)
    alloca_at(s, slot, "%Writer", "implicit print Writer")
    let isink: i32 = shape.sink
    let ifd: i32 = shape.fd
    let ilen: i32 = shape.len
    let fd: i64 = sink.fd
    let p0: i32 = next_reg(s)
    format_into(s, "  %.{p0} = getelementptr %Writer, ptr %.{slot}, i32 0, i32 {isink}\n  store ptr @__ritz_fmt_fd_sink, ptr %.{p0}\n")
    let p1: i32 = next_reg(s)
    format_into(s, "  %.{p1} = getelementptr %Writer, ptr %.{slot}, i32 0, i32 1\n  store ptr null, ptr %.{p1}\n")
    let p2: i32 = next_reg(s)
    format_into(s, "  %.{p2} = getelementptr %Writer, ptr %.{slot}, i32 0, i32 {ifd}\n  store i32 {fd}, ptr %.{p2}\n")
    let p3: i32 = next_reg(s)
    format_into(s, "  %.{p3} = getelementptr %Writer, ptr %.{slot}, i32 0, i32 3\n  store i64 0, ptr %.{p3}\n")
    let p4: i32 = next_reg(s)
    format_into(s, "  %.{p4} = getelementptr %Writer, ptr %.{slot}, i32 0, i32 {ilen}\n  store i64 0, ptr %.{p4}\n")
    g_fmt_writer_used = true
    sink.isink = isink
    sink.ilen = ilen
    let name: StrView = fmt_name("writer")
    add_local_struct(s, name, slot, TypeKind.Struct, writer_type())
    sink.wptr = slot
    sink.arg = fmt_unary_expr(OpKind.AddrMut, fmt_ident_expr(name, span), span)

# Evaluate the Writer expression write/writeln names, once, into a hidden
# local of reference type, and make it the method argument.  False after an
# error.
fn fmt_explicit_writer(s: *EmitterState, writer_expr: *Expr, sink: *PrintSink, span: SrcSpan) -> bool
    let shape: WriterShape = fmt_writer_shape(s, span)
    if not shape.found
        return false
    let t: TypeKind = expr_slot_ty(writer_expr)
    if not is_addr_kind(t) and t != TypeKind.PtrPtr
        fmt_error_at(s, span, "write/writeln needs a Writer as its first argument (`write(@&w, \"...\")`)")
        return false
    let v: i32 = emit_expr(s, writer_expr)
    let slot: i32 = next_reg(s)
    alloca_at(s, slot, "ptr", "write/writeln Writer")
    var wp: i32 = v
    if t != TypeKind.MutRef
        wp = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, v)
    format_into(s, "  store ptr %.{wp}, ptr %.{slot}\n")
    let name: StrView = fmt_name("wptr")
    add_local_struct(s, name, slot, TypeKind.MutRef, writer_type())
    sink.wptr = slot
    sink.isink = shape.sink
    sink.ilen = shape.len
    sink.arg = fmt_ident_expr(name, span)
    true

# The Writer argument an impl method takes, built once per sink; null after
# an error.
fn fmt_writer_arg(s: *EmitterState, sink: *PrintSink, span: SrcSpan) -> *Expr
    if sink.arg == null and sink.kind == SinkKind.Fd
        fmt_make_fd_writer(s, sink, span)
    sink.arg

# ---- Sink writes ---------------------------------------------------------

# Write the `len` bytes (an i64 register) at the `ptr` register to the sink.
# Returns the bytes accepted.
fn fmt_sink_write_ptr(s: *EmitterState, sink: *PrintSink, ptr: i32, len: i32) -> i32
    match sink.kind
        SinkKind.Fd => fd_write(s, sink.fd, ptr, len)
        SinkKind.Writer => writer_write(s, sink, ptr, len)

fn fd_write(s: *EmitterState, fd: i64, ptr: i32, len: i32) -> i32
    let pi: i32 = ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, ptr)
    let r: i32 = next_reg(s)
    let write: StrView = syscall_write_asm()
    format_into(s, "  %.{r} = {write}(i64 1, i64 {fd}, i64 %.{pi}, i64 %.{len})\n")
    r

# The program's Writer: its sink field, then the `len` accounting ritzlib's
# writer_write would do (without needing the import). The pointer sits in the
# hidden local write/writeln made for it.
fn writer_write(s: *EmitterState, sink: *PrintSink, ptr: i32, len: i32) -> i32
    let wptr: i32 = sink.wptr
    let isink: i32 = sink.isink
    let ilen: i32 = sink.ilen
    let w: i32 = next_reg(s)
    format_into(s, "  %.{w} = load ptr, ptr %.{wptr}\n")
    let sp: i32 = next_reg(s)
    format_into(s, "  %.{sp} = getelementptr %Writer, ptr %.{w}, i32 0, i32 {isink}\n")
    let sf: i32 = next_reg(s)
    format_into(s, "  %.{sf} = load ptr, ptr %.{sp}\n")
    let di: i32 = ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, ptr)
    let got: i32 = next_reg(s)
    format_into(s, "  %.{got} = call i64 %.{sf}(ptr %.{w}, i64 %.{di}, i64 %.{len})\n")
    let lp: i32 = next_reg(s)
    format_into(s, "  %.{lp} = getelementptr %Writer, ptr %.{w}, i32 0, i32 {ilen}\n")
    let old: i32 = next_reg(s)
    format_into(s, "  %.{old} = load i64, ptr %.{lp}\n")
    let pos: i32 = next_reg(s)
    format_into(s, "  %.{pos} = icmp sgt i64 %.{got}, 0\n")
    let acc: i32 = next_reg(s)
    format_into(s, "  %.{acc} = select i1 %.{pos}, i64 %.{got}, i64 0\n")
    let nw: i32 = next_reg(s)
    format_into(s, "  %.{nw} = add i64 %.{old}, %.{acc}\n  store i64 %.{nw}, ptr %.{lp}\n")
    got

# Write compile-time bytes to the sink; returns the bytes accepted.
fn fmt_sink_write_const(s: *EmitterState, sink: *PrintSink, data: StrView) -> i32
    if data.len <= 0
        return emit_print_zero(s)
    let ptr: i32 = str_const_ptr(s, data)
    let n: i32 = next_reg(s)
    let len: i64 = data.len
    format_into(s, "  %.{n} = add i64 0, {len}\n")
    fmt_sink_write_ptr(s, sink, ptr, n)

# The running byte count `total` (0: nothing yet) plus `got`.
fn fmt_sink_add(s: *EmitterState, total: i32, got: i32) -> i32
    if total == 0
        return got
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = add i64 %.{total}, %.{got}\n")
    r

# ---- Intrinsic forms -----------------------------------------------------

# `true` / `false`, written like ritz0's intrinsic bool.
fn fmt_write_bool(s: *EmitterState, sink: *PrintSink, v: i32) -> i32
    let tp: i32 = str_const_ptr(s, "true")
    let fp: i32 = str_const_ptr(s, "false")
    let cond: i32 = next_reg(s)
    format_into(s, "  %.{cond} = icmp ne i64 %.{v}, 0\n")
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = select i1 %.{cond}, ptr %.{tp}, ptr %.{fp}\n")
    let n: i32 = next_reg(s)
    format_into(s, "  %.{n} = select i1 %.{cond}, i64 4, i64 5\n")
    fmt_sink_write_ptr(s, sink, p, n)

# A view's `ptr` and `len`, read off its value: a copy of it (an element
# `args[i]` is one, AGAST #4576), or the view a pointer value points at.
fn fmt_strview_parts(s: *EmitterState, e: *Expr, view: ViewOf) -> ByteRegs
    let ty: String = ir_name(view.name)
    var v: i32 = 0
    if view.form == ViewForm.Pointer
        let p: i32 = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, emit_expr(s, e))
        v = next_reg(s)
        format_into(s, "  %.{v} = load %{ty.as_view()}, ptr %.{p}\n")
    else
        v = emit_struct_copy(s, e, TypeKind.Struct)
    view_fields(s, ty.as_view(), v)

# The two fields of the view aggregate `v` of IR type `%ty`.
fn view_fields(s: *EmitterState, ty: StrView, v: i32) -> ByteRegs
    let ptr: i32 = next_reg(s)
    format_into(s, "  %.{ptr} = extractvalue %{ty} %.{v}, 0\n")
    let len: i32 = next_reg(s)
    format_into(s, "  %.{len} = extractvalue %{ty} %.{v}, 1\n")
    ByteRegs { ptr: ptr, len: len }

# A NUL-terminated pointer (an i64 value): strlen, then one write. The
# strlen helper is emit_format_helpers' (`i64 @__ritz_fmt_strlen(ptr)`).
fn fmt_write_cstr(s: *EmitterState, sink: *PrintSink, v: i32) -> i32
    let p: i32 = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, v)
    let n: i32 = next_reg(s)
    format_into(s, "  %.{n} = call i64 @__ritz_fmt_strlen(ptr %.{p})\n")
    s.ir.fmt_helpers_used = 1
    fmt_sink_write_ptr(s, sink, p, n)

# A bool or an integer in its intrinsic form, the scalars Display and Debug
# share; None for any other type.
fn fmt_intrinsic_scalar(s: *EmitterState, sink: *PrintSink, e: *Expr, ft: *FmtType) -> Option<i32>
    if ft.is_bool
        return Some(fmt_write_bool(s, sink, emit_expr(s, e)))
    if ty_int_bits(ft.kind) > 0
        let digits: ByteRegs = emit_fmt_int(s, e, ft.kind)
        return Some(fmt_sink_write_ptr(s, sink, digits.ptr, digits.len))
    None

# The compiler's own Display form of a value; None for a type it has none.
fn fmt_intrinsic_display(s: *EmitterState, sink: *PrintSink, e: *Expr, ft: *FmtType) -> Option<i32>
    let view: ViewOf = interp_view_of(s, e)
    if view.form != ViewForm.NotView
        let parts: ByteRegs = fmt_strview_parts(s, e, view)
        return Some(fmt_sink_write_ptr(s, sink, parts.ptr, parts.len))
    match fmt_intrinsic_scalar(s, sink, e, ft)
        Some(got) => return Some(got)
        None => pass
    if not is_addr_kind(ft.kind) and ft.kind != TypeKind.PtrPtr
        return None
    let v: i32 = emit_expr(s, e)
    if ft.kind != TypeKind.MutRef
        return Some(fmt_write_cstr(s, sink, v))
    let vi: i32 = next_reg(s)
    format_into(s, "  %.{vi} = ptrtoint ptr %.{v} to i64\n")
    Some(fmt_write_cstr(s, sink, vi))

# ---- Dispatch ------------------------------------------------------------

fn fmt_missing_impl(s: *EmitterState, span: SrcSpan, ft: *FmtType, tname: StrView)
    let p: StrView = fmt_spelling(ft.name)
    var m: String = string_new()
    format_into(@&m, "type `{p}` doesn't implement {tname}; add `impl {tname} for {p}`")
    fmt_error_at(s, span, m.as_view())

# `e.<method>(w)` through the trait impl `m`'s receiver: `e` in a hidden local.
fn fmt_call_impl(s: *EmitterState, e: *Expr, ft: *FmtType, sink: *PrintSink, span: SrcSpan, method: StrView) -> i32
    let id: *Expr = fmt_materialize(s, e, ft, span)
    let w: *Expr = fmt_writer_arg(s, sink, span)
    if w == null
        return 0
    emit_expr_method(s, fmt_method_expr(id, method, w, span))

# A value's Debug: its impl, a struct's auto-derived one, or a scalar's
# intrinsic form; None when it has none.
fn fmt_debug_of(s: *EmitterState, e: *Expr, ft: *FmtType, sink: *PrintSink, span: SrcSpan) -> Option<i32>
    if not named(ft.name)
        return fmt_intrinsic_scalar(s, sink, e, ft)
    if fmt_impl_method(s, ft.name, "Debug", "show_debug") != null
        return Some(fmt_call_impl(s, e, ft, sink, span, "show_debug"))
    if ft.kind == TypeKind.Struct and not fmt_is_builtin_target(ft.name)
        let st: *StructDef = find_struct(s, ft.name)
        if st != null
            return Some(fmt_auto_debug(s, e, ft, st, sink, span))
    fmt_intrinsic_scalar(s, sink, e, ft)

# A struct's auto-derived Debug: `Name { field: value, ... }`, each field
# through its own Debug (a real impl, an auto-derived one, or a scalar's
# intrinsic).
fn fmt_auto_debug(s: *EmitterState, e: *Expr, ft: *FmtType, st: *StructDef, sink: *PrintSink, span: SrcSpan) -> i32
    let spell: StrView = fmt_spelling(ft.name)
    let id: *Expr = fmt_materialize(s, e, ft, span)
    var total: i32 = fmt_sink_write_const(s, sink, spell)
    if st.fields == null
        return total
    total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, " { "))
    var f: *StructField = st.fields
    while f != null
        if f != st.fields
            total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, ", "))
        let fname: StrView = StrView { ptr: f.name, len: f.name_len as i64 }
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, fname))
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, ": "))
        let fe: *Expr = fmt_member_expr(id, fname, span)
        var fft: FmtType = fmt_field_type(f)
        var got: i32 = 0
        match fmt_debug_of(s, fe, @fft, sink, span)
            Some(r) => got = r
            None =>
                fmt_missing_impl(s, span, @fft, "Debug")
                got = emit_print_zero(s)
        total = fmt_sink_add(s, total, got)
        f = f.next
    fmt_sink_add(s, total, fmt_sink_write_const(s, sink, " }"))

# A struct field's declared type, as the dispatcher needs it.
fn fmt_field_type(f: *StructField) -> FmtType
    var ft: FmtType = fmt_type(f.field_type)
    match f.field_type
        TypeKind.Struct =>
            if f.field_type_name_len > 0
                ft.name = field_type_name(f)
            return ft
        TypeKind.Bool =>
            return bool_fmt_type()
        TypeKind.Ptr | TypeKind.PtrPtr =>
            ft.pointee = f.array_elem_type
            if f.array_elem_type == TypeKind.U8 or f.ptr_pointee == TypeKind.U8
                ft.name = "ptr_u8"
            return ft
        TypeKind.Ref | TypeKind.MutRef =>
            if f.field_type_name_len > 0
                ft.name = field_type_name(f)
            else
                ft.name = fmt_pointee_name(f.ptr_pointee, f.inner_pointee_type)
            return ft
        _ => pass
    ft.name = primitive_spelling(f.field_type)
    ft

# One `{expr}` or `{expr:?}`: the value's own impl, else the compiler's
# intrinsic form, else a located diagnostic naming the impl to add.
fn fmt_print_value(s: *EmitterState, sink: *PrintSink, e: *Expr, debug: bool) -> i32
    var ftype: FmtType = fmt_type_of(s, e)
    if debug
        match fmt_debug_of(s, e, @ftype, sink, e.span)
            Some(got) => return got
            None => pass
        fmt_missing_impl(s, e.span, @ftype, "Debug")
        return 0
    if named(ftype.name) and fmt_impl_method(s, ftype.name, "Display", "show") != null
        return fmt_call_impl(s, e, @ftype, sink, e.span, "show")
    match fmt_intrinsic_display(s, sink, e, @ftype)
        Some(got) => return got
        None => pass
    fmt_missing_impl(s, e.span, @ftype, "Display")
    0

# =============================================================================
# A literal's pieces
#
# print / write and format_into split a "..." literal the same way: its RAW
# source text (the cooked text in string_val cannot tell `\{x}` from `{x}`;
# expr_string records the raw token, quotes included, in ident), escapes
# cooked, `{{` / `}}` one brace, and every `{expr}` a value.  The pieces go to print's sink, or to format_into's push_bytes.
# =============================================================================

# Who takes a literal's pieces.
enum PieceDest
    Print     # a PrintSink, through Display / Debug
    Format    # format_into's FmtSink

struct Pieces
    dest: PieceDest
    sink: *PrintSink   # Print's
    k: *FmtSink        # Format's
    total: i32         # Print's bytes written so far (0: nothing yet)
    values: i32        # placeholders seen

# Compile-time text.
fn piece_text(s: *EmitterState, out: *Pieces, text: StrView)
    match out.dest
        PieceDest.Print =>
            out.total = fmt_sink_add(s, out.total, fmt_sink_write_const(s, out.sink, text))
        PieceDest.Format =>
            fmt_push_const(s, out.k, text)

# One placeholder's text, between its braces.  `{x:?}` is Debug, on print's
# sink; any other spec (AGAST #201), and every spec in format_into, is refused
# until AGAST #202 prints it.
fn piece_value(s: *EmitterState, out: *Pieces, lit: *Expr, text: StrView)
    out.values = out.values + 1
    let colon: i32 = interp_spec_colon(text)
    if colon < 0
        piece_expr(s, out, lit, text, false)
        return
    let expr: StrView = StrView { ptr: text.ptr, len: colon as i64 }
    let spec: StrView = StrView { ptr: text.ptr + colon + 1, len: text.len - colon as i64 - 1 }
    if out.dest == PieceDest.Print and name_eq(spec, "?") == 1
        piece_expr(s, out, lit, expr, true)
        return
    emit_spec_error(s, lit, expr, spec)

fn piece_expr(s: *EmitterState, out: *Pieces, lit: *Expr, text: StrView, debug: bool)
    let e: *Expr = fmt_parse(s, text, lit.span.line, lit.span.col)
    if e == null
        emit_print_error(s, lit, "invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)")
        return
    match out.dest
        PieceDest.Print =>
            out.total = fmt_sink_add(s, out.total, fmt_print_value(s, out.sink, e, debug))
        PieceDest.Format =>
            fmt_push_value(s, out.k, lit, e)

# Split the raw literal body `body` into pieces; the cooked text after the
# last placeholder is left for the caller, which writes it differently.
fn split_literal(s: *EmitterState, out: *Pieces, lit: *Expr, body: StrView) -> StrView
    let n: i32 = body.len as i32
    # Cooked text is never longer than raw. add_string keeps the pointer, so
    # each piece stays in this buffer for the rest of the compile.
    let buf: *u8 = malloc((n + 1) as i64)
    var start: i32 = 0     # first byte of the piece not yet written
    var w: i32 = 0         # write cursor in buf
    var i: i32 = 0
    while i < n
        let c: u8 = body.get(i as i64)
        let next: u8 = if i + 1 < n then body.get((i + 1) as i64) else 0
        if c == '\\' and i + 1 < n
            # The lexer's own table (lexer.ritz): it already rejected a bad
            # escape in this literal, so this always cooks. `\xNN` is three
            # bytes after the backslash (AGAST #1872).
            let esc: *u8 = body.ptr + i + 1
            *(buf + w) = lexer_cook_escape_at(esc, (n - i - 1) as i64, 1) as u8
            w = w + 1
            i = i + 1 + lexer_escape_width((next as i32) & 255)
        else if (c == '{' or c == '}') and next == c
            *(buf + w) = c
            w = w + 1
            i = i + 2
        else if c == '{' and interp_match_brace(body, i) >= 0
            let close: i32 = interp_match_brace(body, i)
            if w > start
                piece_text(s, out, StrView { ptr: buf + start, len: (w - start) as i64 })
            start = w
            piece_value(s, out, lit, StrView { ptr: body.ptr + i + 1, len: (close - i - 1) as i64 })
            i = close + 1
        else
            *(buf + w) = c
            w = w + 1
            i = i + 1
    StrView { ptr: buf + start, len: (w - start) as i64 }

# A literal's raw body, between its quotes; unnamed when the token kept none.
fn raw_body(lit: *Expr) -> StrView
    if lit.ident.ptr == null or lit.ident.len < 2
        return no_name()
    lit.ident.skip(1).take(lit.ident.len - 2)

fn cooked_text(lit: *Expr) -> StrView
    lit.string_val

# Why a placeholder in a c"..." literal is refused, as ritz0 words it.
fn cstr_placeholder_msg(dest: PieceDest) -> StrView
    match dest
        PieceDest.Print => "`c\"...\"` literals do not interpolate: the placeholder would be printed verbatim. Use a plain string literal `\"...\"` here, or `{{` to print a literal brace"
        PieceDest.Format => "`c\"...\"` literals do not interpolate: the placeholder would be appended verbatim. Use a plain string literal `\"...\"` here, or `{{` for a literal brace"

# #1374/#1394: c"..." does not interpolate, so a placeholder in one would be
# written verbatim: refused, as ritz0 does.  True when refused.
fn refuse_cstr_placeholder(s: *EmitterState, lit: *Expr, dest: PieceDest) -> bool
    if lit.kind != ExprKind.CstringLit or interp_cstr_has_placeholder(cooked_text(lit)) == 0
        return false
    emit_print_error(s, lit, cstr_placeholder_msg(dest))
    true

# Lower an interpolated print: literal parts, then each placeholder's
# Display/Debug, then a newline for println/writeln. `want_total` returns
# the bytes written (write/writeln's value); print's result keeps its old
# shape (the write when there is no placeholder, else 0).
fn emit_interp_print(s: *EmitterState, sink: *PrintSink, lit: *Expr, newline: bool, want_total: bool) -> i32
    if refuse_cstr_placeholder(s, lit, PieceDest.Print)
        return emit_print_zero(s)
    let body: StrView = raw_body(lit)
    if lit.kind == ExprKind.CstringLit or unnamed(body)
        let r: i32 = fmt_sink_write_const(s, sink, cooked_text(lit))
        if newline and lit.kind == ExprKind.CstringLit
            fmt_sink_add(s, r, fmt_sink_write_const(s, sink, "\n"))
        return r
    var out: Pieces = Pieces { dest: PieceDest.Print, sink: sink, k: null, total: 0, values: 0 }
    let tail: StrView = split_literal(s, @out, lit, body)
    if out.values == 0 and not newline and not want_total
        return fmt_sink_write_const(s, sink, tail)
    if tail.len > 0
        piece_text(s, @out, tail)
    if newline
        piece_text(s, @out, "\n")
    if want_total
        return out.total
    emit_print_zero(s)

# Lower print/println(<literal>) to fd. Returns the result register: the
# write's byte count when the literal has no placeholder, else 0, as ritz0.
pub fn emit_print_literal(s: *EmitterState, fd: i64, lit: *Expr, newline: bool) -> i32
    var sink: PrintSink = PrintSink { kind: SinkKind.Fd, fd: fd, wptr: 0, arg: null, isink: -1, ilen: -1 }
    emit_interp_print(s, @sink, lit, newline, false)

# Lower write/writeln(writer, <literal>): Display through the program's
# Writer. Returns the bytes written.
pub fn emit_write_literal(s: *EmitterState, lit: *Expr, writer_expr: *Expr, newline: bool) -> i32
    var sink: PrintSink = PrintSink { kind: SinkKind.Writer, fd: 0, wptr: 0, arg: null, isink: -1, ilen: -1 }
    if not fmt_explicit_writer(s, writer_expr, @sink, lit.span)
        return emit_print_zero(s)
    emit_interp_print(s, @sink, lit, newline, true)

# format_into's literal: each piece appended to the sink `k`.
fn emit_format_literal(s: *EmitterState, k: *FmtSink, lit: *Expr) -> i32
    if refuse_cstr_placeholder(s, lit, PieceDest.Format)
        return emit_print_zero(s)
    let body: StrView = raw_body(lit)
    if lit.kind == ExprKind.CstringLit or unnamed(body)
        fmt_push_const(s, k, cooked_text(lit))
        return emit_print_zero(s)
    var out: Pieces = Pieces { dest: PieceDest.Format, sink: null, k: k, total: 0, values: 0 }
    let tail: StrView = split_literal(s, @out, lit, body)
    if tail.len > 0
        piece_text(s, @out, tail)
    emit_print_zero(s)

# The helpers the print paths call. Emitted once, after the functions, by a
# module that used any of them.
pub fn emit_print_helpers(s: *EmitterState)
    if s.ir.print_helpers_used == 0 and not g_fmt_writer_used
        return
    let write: StrView = syscall_write_asm()
    format_into(s, "\n; print interpolation helpers (AGAST #1521, #4381), as ritz0's _emit_print_value\n")
    # A StrView's bytes: one write of exactly len bytes (#1641).
    format_into(s, "define internal void @__ritz_print_bytes(i64 %fd, i64 %p, i64 %n)")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %r = {write}(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n\n")
    # NUL-terminated bytes at a pointer: strlen, then one write.
    format_into(s, "define internal void @__ritz_print_cstr(i64 %fd, i64 %p)")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %ptr = inttoptr i64 %p to ptr\n")
    format_into(s, "  br label %scan\n")
    format_into(s, "scan:\n")
    format_into(s, "  %n = phi i64 [ 0, %entry ], [ %n1, %next ]\n")
    format_into(s, "  %cp = getelementptr i8, ptr %ptr, i64 %n\n")
    format_into(s, "  %c = load i8, ptr %cp\n")
    format_into(s, "  %nul = icmp eq i8 %c, 0\n")
    format_into(s, "  br i1 %nul, label %done, label %next\n")
    format_into(s, "next:\n")
    format_into(s, "  %n1 = add i64 %n, 1\n")
    format_into(s, "  br label %scan\n")
    format_into(s, "done:\n")
    format_into(s, "  %r = {write}(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n\n")
    # bool: `true` or `false`.
    format_into(s, "@.ritz_print_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    format_into(s, "@.ritz_print_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    format_into(s, "define internal void @__ritz_print_bool(i64 %fd, i64 %b)")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %t = icmp ne i64 %b, 0\n")
    format_into(s, "  %ptr = select i1 %t, ptr @.ritz_print_true, ptr @.ritz_print_false\n")
    format_into(s, "  %len = select i1 %t, i64 4, i64 5\n")
    format_into(s, "  %pi = ptrtoint ptr %ptr to i64\n")
    format_into(s, "  %r = {write}(i64 1, i64 %fd, i64 %pi, i64 %len)\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n")
    if g_fmt_writer_used
        emit_fd_sink_helper(s)

# The implicit print Writer's sink: the fd in `w.fd` (AGAST #4381).
fn emit_fd_sink_helper(s: *EmitterState)
    let st: *StructDef = find_struct(s, writer_type())
    if st == null
        return
    let ifd: i32 = fmt_writer_field(st, "fd")
    if ifd < 0
        return
    let write: StrView = syscall_write_asm()
    format_into(s, "define internal i64 @__ritz_fmt_fd_sink(ptr %w, i64 %data, i64 %len)")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %fp = getelementptr %Writer, ptr %w, i32 0, i32 {ifd}\n")
    format_into(s, "  %f = load i32, ptr %fp\n")
    format_into(s, "  %fd = sext i32 %f to i64\n")
    format_into(s, "  %r = {write}(i64 1, i64 %fd, i64 %data, i64 %len)\n")
    format_into(s, "  ret i64 %r\n")
    format_into(s, "}}\n")

# =============================================================================
# assert (AGAST #1869; LANGUAGE_SPEC §17.1, §19.2)
#
# A failing assert writes to stderr and exits 1:
#
#     <file>:<line>: assertion failed[: <message> | : left OP right]
#       left:  <value>                      } cond is `a OP b` with integer,
#       right: <value>                      } bool or pointer operands
#       in helper <fn> at <file>:<line>     } in a [[test_helper]] fn
#
# byte for byte what ritz0's _emit_assert writes.  In a helper the first
# <file>:<line> is the call site the running [[test]] fn recorded in the
# @__ritz_assert_site_* globals (record_assert_site), or the assert's own
# location when none was recorded.

# How a failing assert prints a value: @__ritz_assert_val's `kind`.
enum AssertVal
    Signed
    Unsigned
    Ptr
    Bool

# The `kind` number @__ritz_assert_val takes; ritz0's _ASSERT_* use the same.
fn assert_val_code(k: AssertVal) -> i64
    match k
        AssertVal.Signed => 0
        AssertVal.Unsigned => 1
        AssertVal.Ptr => 2
        AssertVal.Bool => 3

# What a failing assert shows of its condition `a OP b`: OP's spelling, how
# each side prints and the registers emit_expr_binary compared.  `op` is
# unnamed when the report shows no values.
struct AssertShown
    op: StrView
    left: AssertVal
    right: AssertVal
    left_reg: i32
    right_reg: i32

pub fn assert_fn_kind(ctx: *ParseCtx, f: *FnDef) -> i32
    if is_test_fn(ctx, f) == 1
        return ASSERT_FN_TEST
    if is_test_helper_fn(ctx, f) == 1
        return ASSERT_FN_HELPER
    ASSERT_FN_PLAIN

# The `exit` syscall's inline asm; `(i64 60, i64 <code>)` follows.
fn syscall_exit_asm() -> StrView
    "call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},~{rcx},~{r11},~{memory}\""

# The basename of the file being compiled: the location an assert reports.
fn assert_file_base() -> StrView
    let f: *u8 = emitter_source_file()
    if f == null
        return "?"
    let path: StrView = strview_from_cstr(f)
    var start: i64 = 0
    for i in 0..path.len
        if path.get(i) == '/'
            start = i + 1
    StrView { ptr: path.ptr + start, len: path.len - start }

fn assert_file_str(s: *EmitterState) -> i32
    if s.ir.assert_file_str < 0
        s.ir.assert_file_str = add_string(s, assert_file_base())
    s.ir.assert_file_str

# write(2, data, len) for bytes known at compile time.
fn assert_write(s: *EmitterState, data: StrView)
    if data.len <= 0
        return
    let idx: i32 = add_string(s, data)
    s.ir.print_helpers_used = 1
    format_into(s, "  call void @__ritz_print_bytes(i64 2, i64 ptrtoint (ptr @.str.{idx} to i64), i64 {data.len})\n")

# The value in i64 register `reg`, printed as `kind` says.
fn assert_write_reg(s: *EmitterState, reg: i32, kind: AssertVal)
    s.ir.assert_helpers_used = 1
    let code: i64 = assert_val_code(kind)
    format_into(s, "  call void @__ritz_assert_val(i64 %.{reg}, i64 {code})\n")

# A line number known at compile time, printed signed.
fn assert_write_line(s: *EmitterState, line: i32)
    s.ir.assert_helpers_used = 1
    let code: i64 = assert_val_code(AssertVal.Signed)
    format_into(s, "  call void @__ritz_assert_val(i64 {line as i64}, i64 {code})\n")

# `<file>:<line>` of the assert itself.
fn assert_write_loc(s: *EmitterState, line: i32)
    assert_write(s, assert_file_base())
    assert_write(s, ":")
    assert_write_line(s, line)

fn assert_write_own_loc(s: *EmitterState, line: i32)
    assert_write_loc(s, line)
    assert_write(s, ": ")

# How a failing assert prints an operand of slot type `t`; None: it doesn't.
fn assert_val_of(t: TypeKind) -> Option<AssertVal>
    match t
        TypeKind.Bool =>
            return Some(AssertVal.Bool)
        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
            return Some(AssertVal.Ptr)
        _ => pass
    if ty_is_unsigned(t) == 1
        return Some(AssertVal.Unsigned)
    if ty_is_signed(t) == 1
        return Some(AssertVal.Signed)
    None

# The source spelling of a comparison operator; unnamed for any other.
fn comparison_spelling(op: OpKind) -> StrView
    match op
        OpKind.Eq => "=="
        OpKind.Ne => "!="
        OpKind.Lt => "<"
        OpKind.Gt => ">"
        OpKind.Le => "<="
        OpKind.Ge => ">="
        OpKind.Unset | OpKind.Add | OpKind.Sub | OpKind.Mul | OpKind.Div | OpKind.Mod | OpKind.And | OpKind.Or | OpKind.BitAnd | OpKind.BitOr | OpKind.BitXor | OpKind.Shl | OpKind.Shr | OpKind.Neg | OpKind.Not | OpKind.Deref | OpKind.Addr | OpKind.BitNot | OpKind.AddrMut | OpKind.AddWrap | OpKind.SubWrap | OpKind.MulWrap => no_name()

# What a failing assert of `c` can show, decided before `c` is emitted.
fn assert_shown_of(s: *EmitterState, c: *Expr) -> AssertShown
    var shown: AssertShown = AssertShown { op: no_name(), left: AssertVal.Signed, right: AssertVal.Signed, left_reg: 0, right_reg: 0 }
    if c.kind != ExprKind.Binary
        return shown
    let op: StrView = comparison_spelling(c.op)
    if unnamed(op)
        return shown
    # A bool local is an i64 slot and `true` an int literal here, so one side
    # known to be bool makes both bool (the type rules say the other is too)
    # — interp_is_bool, as print interpolation decides.
    if interp_is_bool(s, c.left) or interp_is_bool(s, c.right)
        shown.left = AssertVal.Bool
        shown.right = AssertVal.Bool
        shown.op = op
        return shown
    match assert_val_of(expr_slot_ty(c.left))
        Some(l) => shown.left = l
        None => return shown
    match assert_val_of(expr_slot_ty(c.right))
        Some(r) => shown.right = r
        None => return shown
    shown.op = op
    shown

# `f`'s source name: a generic instance `name$T...` without its suffix.
fn assert_fn_source_name(f: *FnDef) -> StrView
    let name: StrView = StrView { ptr: f.name, len: f.name_len as i64 }
    var n: i64 = 0
    while n < name.len and name.get(n) != '$'
        n += 1
    StrView { ptr: name.ptr, len: n }

# The assert's own message (`assert c, "msg"`); empty when it has none.
fn assert_message(stmt: *Stmt) -> StrView
    if stmt.assert_msg == null
        return no_name()
    StrView { ptr: stmt.assert_msg, len: stmt.assert_msg_len as i64 }

# In a [[test]] fn, note the location of the call `e` before it is made.  A
# [[test_helper]] reached through it reports that location; helpers do not
# record, so through any depth of helpers the line stays the test's.
pub fn record_assert_site(s: *EmitterState, e: *Expr)
    if s.fcx.fn_assert_kind != ASSERT_FN_TEST
        return
    let idx: i32 = assert_file_str(s)
    let base_len: i64 = assert_file_base().len
    s.ir.assert_site_used = 1
    format_into(s, "  store ptr @.str.{idx}, ptr @__ritz_assert_site_file\n")
    format_into(s, "  store i64 {base_len}, ptr @__ritz_assert_site_file_len\n")
    format_into(s, "  store i64 {e.span.line as i64}, ptr @__ritz_assert_site_line\n")

fn assert_placement_error(s: *EmitterState, stmt: *Stmt)
    format_into(s, "  ; ERROR: assert outside [[test]] / [[test_helper]]\n")
    diag_error_at(emitter_source_file(), stmt.span)
    eprints("assert is only allowed in [[test]] and [[test_helper]] functions, not in '")
    let f: *FnDef = emitter_current_fn()
    if f != null
        # `main` for an adapted main (#4018), else up to a generic's `$`.
        eprint_bytes(fn_display_name(f).slice(0, assert_fn_source_name(f).len))
    eprints("'\n")
    s.diag.error_count = s.diag.error_count + 1

pub fn emit_assert_stmt(s: *EmitterState, stmt: *Stmt)
    if s.fcx.fn_assert_kind == ASSERT_FN_PLAIN
        assert_placement_error(s, stmt)
        return
    let c: *Expr = stmt.if_cond
    # `a OP b`: emit_expr_binary records the two i64 operand registers its
    # compare reads, so the report shows exactly the compared values without
    # evaluating anything twice.
    var shown: AssertShown = assert_shown_of(s, c)
    if not unnamed(shown.op)
        s.fcx.assert_cap_expr = c
        s.fcx.assert_cap_ok = 0
    let cond: i32 = emit_expr(s, c)
    s.fcx.assert_cap_expr = null
    if s.fcx.assert_cap_ok == 0
        shown.op = no_name()
    shown.left_reg = s.fcx.assert_cap_l
    shown.right_reg = s.fcx.assert_cap_r
    let ok: i32 = assert_branch(s, cond)
    if (s.ir.platform_stop & PSTOP_FREESTANDING) != 0
        assert_fatal_stop(s, stmt, shown)
    else
        assert_report(s, stmt, shown)
    begin_block(s, ok)

# Branch on the i64 condition `cond`: the fail block is opened and the ok
# label returned.  Narrowed to i1 for the `br`, as StmtKind.If does (#1646).
fn assert_branch(s: *EmitterState, cond: i32) -> i32
    let cond_i1: i32 = next_reg(s)
    format_into(s, "  %.{cond_i1} = icmp ne i64 %.{cond}, 0\n")
    let ok: i32 = next_label(s)
    let fail: i32 = next_label(s)
    format_into(s, "  br i1 %.{cond_i1}, label %L{ok}, label %L{fail}\n")
    begin_block(s, fail)
    ok

# A hosted failing assert: the report on fd 2, then exit(1).
fn assert_report(s: *EmitterState, stmt: *Stmt, shown: AssertShown)
    let helper: bool = s.fcx.fn_assert_kind == ASSERT_FN_HELPER
    if helper
        assert_write_site_loc(s, stmt.span.line)
    else
        assert_write_own_loc(s, stmt.span.line)
    let msg: StrView = assert_message(stmt)
    let show: bool = not unnamed(shown.op)
    assert_write(s, "assertion failed")
    if msg.len > 0
        assert_write(s, ": ")
        assert_write(s, msg)
    else if show
        assert_write(s, ": left ")
        assert_write(s, shown.op)
        assert_write(s, " right")
    assert_write(s, "\n")
    if show
        assert_write(s, "  left:  ")
        assert_write_reg(s, shown.left_reg, shown.left)
        assert_write(s, "\n  right: ")
        assert_write_reg(s, shown.right_reg, shown.right)
        assert_write(s, "\n")
    if helper
        assert_write(s, "  in helper ")
        let hf: *FnDef = emitter_current_fn()
        if hf != null
            assert_write(s, assert_fn_source_name(hf))
        assert_write(s, " at ")
        assert_write_loc(s, stmt.span.line)
        assert_write(s, "\n")
    # syscall(60, 1): Linux _exit.  `unreachable` tells LLVM the fail block
    # has no successor.
    let exit: StrView = syscall_exit_asm()
    format_into(s, "  {exit}(i64 60, i64 1)\n")
    format_into(s, "  unreachable\n")

# A [[test_helper]]'s location: the call site the running [[test]] recorded,
# else (no test recorded one) the assert's own.
fn assert_write_site_loc(s: *EmitterState, line: i32)
    s.ir.assert_site_used = 1
    let l_site: i32 = next_label(s)
    let l_own: i32 = next_label(s)
    let l_head: i32 = next_label(s)
    let line_r: i32 = next_reg(s)
    format_into(s, "  %.{line_r} = load i64, ptr @__ritz_assert_site_line\n")
    let has_r: i32 = next_reg(s)
    format_into(s, "  %.{has_r} = icmp ne i64 %.{line_r}, 0\n")
    format_into(s, "  br i1 %.{has_r}, label %L{l_site}, label %L{l_own}\n")
    begin_block(s, l_site)
    let fp_r: i32 = next_reg(s)
    format_into(s, "  %.{fp_r} = load i64, ptr @__ritz_assert_site_file\n")
    let fl_r: i32 = next_reg(s)
    format_into(s, "  %.{fl_r} = load i64, ptr @__ritz_assert_site_file_len\n")
    s.ir.print_helpers_used = 1
    format_into(s, "  call void @__ritz_print_bytes(i64 2, i64 %.{fp_r}, i64 %.{fl_r})\n")
    assert_write(s, ":")
    assert_write_reg(s, line_r, AssertVal.Signed)
    assert_write(s, ": ")
    format_into(s, "  br label %L{l_head}\n")
    begin_block(s, l_own)
    assert_write_own_loc(s, line)
    format_into(s, "  br label %L{l_head}\n")
    begin_block(s, l_head)

# `ritz_platform_fatal(@.str.<idx>, <len>, 1)`, then `unreachable`: a
# freestanding stop with a constant message.
fn emit_platform_fatal_str(s: *EmitterState, idx: i32, len: i64)
    s.ir.platform_stop = s.ir.platform_stop | PSTOP_USED
    format_into(s, "  call void @ritz_platform_fatal(ptr @.str.{idx}, i64 {len}, i32 1)\n")
    format_into(s, "  unreachable\n")

# A freestanding target's failing assert (AGAST #4607): a kernel has no exit
# syscall and no fd 2, so the head line at the assert's own location,
#
#     <file>:<line>: assertion failed[: <message> | : left OP right]
#
# goes to ritz_platform_fatal (which writes the newline) in one call, byte
# for byte ritz0's.  The operand values and a helper's call site take a
# write each: they are a hosted report's.
fn assert_fatal_stop(s: *EmitterState, stmt: *Stmt, shown: AssertShown)
    var m: String = string_new()
    let base: StrView = assert_file_base()
    let line: i64 = stmt.span.line as i64
    format_into(@&m, "{base}:{line}: assertion failed")
    let msg: StrView = assert_message(stmt)
    if msg.len > 0
        format_into(@&m, ": {msg}")
    else if not unnamed(shown.op)
        let op: StrView = shown.op
        format_into(@&m, ": left {op} right")
    let text: StrView = m.as_view()
    emit_platform_fatal_str(s, intern_string(s, text), text.len)

# The call-site globals (weak: one copy across every module of a test
# binary; ritz0 defines the same symbols) and @__ritz_assert_val, the value
# printer: ritz0's _get_assert_val_fn instruction for instruction.
pub fn emit_assert_helpers(s: *EmitterState)
    if s.ir.assert_site_used == 1
        format_into(s, "\n; assert call-site globals (AGAST #1869)\n")
        format_into(s, "@__ritz_assert_site_file = weak global ptr null\n")
        format_into(s, "@__ritz_assert_site_file_len = weak global i64 0\n")
        format_into(s, "@__ritz_assert_site_line = weak global i64 0\n")
    if s.ir.assert_helpers_used == 0
        return
    let write: StrView = syscall_write_asm()
    format_into(s, "\n; assert value printer (AGAST #1869): kind 0 signed, 1 unsigned, 2 0x-hex, 3 bool\n")
    format_into(s, "@.ritz_assert_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    format_into(s, "@.ritz_assert_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    format_into(s, "define internal void @__ritz_assert_val(i64 %v, i64 %kind)")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %buf = alloca [24 x i8]\n")
    format_into(s, "  %end = getelementptr [24 x i8], ptr %buf, i64 0, i64 24\n")
    format_into(s, "  %isb = icmp eq i64 %kind, 3\n")
    format_into(s, "  br i1 %isb, label %bool, label %num\n")
    format_into(s, "bool:\n")
    format_into(s, "  %t = icmp ne i64 %v, 0\n")
    format_into(s, "  %bp = select i1 %t, ptr @.ritz_assert_true, ptr @.ritz_assert_false\n")
    format_into(s, "  %bl = select i1 %t, i64 4, i64 5\n")
    format_into(s, "  %bpi = ptrtoint ptr %bp to i64\n")
    format_into(s, "  %r0 = {write}(i64 1, i64 2, i64 %bpi, i64 %bl)\n")
    format_into(s, "  ret void\n")
    format_into(s, "num:\n")
    format_into(s, "  %iss = icmp eq i64 %kind, 0\n")
    format_into(s, "  %isn = icmp slt i64 %v, 0\n")
    format_into(s, "  %neg = and i1 %iss, %isn\n")
    format_into(s, "  %negv = sub i64 0, %v\n")
    format_into(s, "  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    format_into(s, "  %ish = icmp eq i64 %kind, 2\n")
    format_into(s, "  %base = select i1 %ish, i64 16, i64 10\n")
    format_into(s, "  br label %digit\n")
    format_into(s, "digit:\n")
    format_into(s, "  %p = phi ptr [ %end, %num ], [ %np, %digit ]\n")
    format_into(s, "  %val = phi i64 [ %mag, %num ], [ %q, %digit ]\n")
    format_into(s, "  %d = urem i64 %val, %base\n")
    format_into(s, "  %lo = icmp ult i64 %d, 10\n")
    format_into(s, "  %dc = add i64 %d, 48\n")
    format_into(s, "  %hc = add i64 %d, 87\n")
    format_into(s, "  %ch64 = select i1 %lo, i64 %dc, i64 %hc\n")
    format_into(s, "  %ch = trunc i64 %ch64 to i8\n")
    format_into(s, "  %np = getelementptr i8, ptr %p, i64 -1\n")
    format_into(s, "  store i8 %ch, ptr %np\n")
    format_into(s, "  %q = udiv i64 %val, %base\n")
    format_into(s, "  %more = icmp ne i64 %q, 0\n")
    format_into(s, "  br i1 %more, label %digit, label %done\n")
    # At most 20 digits + "0x" + "-" = 23 bytes: the unconditional stores
    # stay inside the 24-byte buffer.
    format_into(s, "done:\n")
    format_into(s, "  %xp = getelementptr i8, ptr %np, i64 -1\n")
    format_into(s, "  store i8 120, ptr %xp\n")
    format_into(s, "  %zp = getelementptr i8, ptr %np, i64 -2\n")
    format_into(s, "  store i8 48, ptr %zp\n")
    format_into(s, "  %p3 = select i1 %ish, ptr %zp, ptr %np\n")
    format_into(s, "  %mp = getelementptr i8, ptr %p3, i64 -1\n")
    format_into(s, "  store i8 45, ptr %mp\n")
    format_into(s, "  %p4 = select i1 %neg, ptr %mp, ptr %p3\n")
    format_into(s, "  %p4i = ptrtoint ptr %p4 to i64\n")
    format_into(s, "  %ei = ptrtoint ptr %end to i64\n")
    format_into(s, "  %len = sub i64 %ei, %p4i\n")
    format_into(s, "  %r1 = {write}(i64 1, i64 2, i64 %p4i, i64 %len)\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n")

# =============================================================================
# A match with no arm for a repr enum's value (AGAST #4586; LANGUAGE_SPEC §10.1)
#
# An exhaustive match on an `enum E: <int>` with no `_` / binding arm stops
# when the stored discriminant names no variant, writing
#
#     <file>:<line>:<col>: match on <E>: value <v> names no variant
#
# to stderr and exiting 1: byte for byte ritz0's _emit_match_no_variant_trap.
# <v> is the raw discriminant, sign-extended for an `iN` repr.

# True once this module traps: emit_module then defines @__ritz_match_trap.
# A module global, not an EmitterState field (#1816 freezes those).
var g_match_trap_used: bool = false

# Trap with the discriminant held in field 0 of the enum at `slot` (a `ptr`
# register).  The caller ends the block with `unreachable`.
pub fn emit_match_no_variant_trap(s: *EmitterState, enum_name_sv: StrView, slot: i32, line: i32, col: i32)
    let base: StrView = assert_file_base()
    var head: String = string_new()
    format_into(@&head, "{base}:{line as i64}:{col as i64}: match on {enum_name_sv}: value ")
    let text: StrView = head.as_view()
    let idx: i32 = intern_string(s, text)

    let ei: i32 = user_enum_index(s.sym.mono.pctx, enum_name_sv)
    let tag_ty: StrView = llvm_text(enum_tag_llvm(s.sym.mono.pctx, ei))
    let signed: bool = enum_tag_signed(s.sym.mono.pctx, ei) == 1
    let tag_ptr: i32 = next_reg(s)
    gep_struct_open(s, tag_ptr, enum_name_sv)
    format_into(s, ", ptr %.{slot}, i32 0, i32 0\n")
    let tag: i32 = next_reg(s)
    format_into(s, "  %.{tag} = load {tag_ty}, ptr %.{tag_ptr}\n")
    var wide: i32 = tag
    if ty_int_bits(enum_repr(s.sym.mono.pctx, ei)) < 64
        wide = next_reg(s)
        let extend: StrView = if signed then "sext" else "zext"
        format_into(s, "  %.{wide} = {extend} {tag_ty} %.{tag} to i64\n")
    g_match_trap_used = true
    s.ir.sret_helpers_used = 1   # the helper copies with @__ritz_sret_copy
    let sign_arg: i64 = if signed then 1 else 0
    format_into(s, "  call void @__ritz_match_trap(ptr @.str.{idx}, i64 {text.len}, i64 %.{wide}, i64 {sign_arg})\n")

# @__ritz_match_trap(head, hlen, v, signed): ritz0's _match_trap_fn as text.
# The message is built in a stack buffer, then written with its newline and
# the process exits 1.  A freestanding --target stops through one
# `ritz_platform_fatal(buf, len, 1)` instead, which writes the newline itself,
# so the tail drops it and the IR holds no syscall (AGAST #4616).
pub fn emit_match_trap_helper(s: *EmitterState)
    if not g_match_trap_used
        return
    g_match_trap_used = false
    let free: bool = (s.ir.platform_stop & PSTOP_FREESTANDING) != 0
    format_into(s, "\n; match with no arm for a repr enum's value (AGAST #4586)\n")
    if free
        format_into(s, "@.ritz_match_tail = private unnamed_addr constant [17 x i8] c\" names no variant\"\n")
    else
        format_into(s, "@.ritz_match_tail = private unnamed_addr constant [18 x i8] c\" names no variant\\0A\"\n")
    format_into(s, "define internal void @__ritz_match_trap(ptr %head, i64 %hlen, i64 %v, i64 %signed) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %scr = alloca [24 x i8]\n")
    format_into(s, "  %end = getelementptr [24 x i8], ptr %scr, i64 0, i64 24\n")
    format_into(s, "  %cap = add i64 %hlen, 48\n")
    format_into(s, "  %buf = alloca i8, i64 %cap\n")
    format_into(s, "  call void @__ritz_sret_copy(ptr %buf, ptr %head, i64 %hlen)\n")
    format_into(s, "  %sg = icmp ne i64 %signed, 0\n")
    format_into(s, "  %isn = icmp slt i64 %v, 0\n")
    format_into(s, "  %neg = and i1 %sg, %isn\n")
    format_into(s, "  %negv = sub i64 0, %v\n")
    format_into(s, "  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    format_into(s, "  br label %digit\n")
    format_into(s, "digit:\n")
    format_into(s, "  %p = phi ptr [ %end, %entry ], [ %np, %digit ]\n")
    format_into(s, "  %val = phi i64 [ %mag, %entry ], [ %q, %digit ]\n")
    format_into(s, "  %np = getelementptr i8, ptr %p, i64 -1\n")
    format_into(s, "  %d = urem i64 %val, 10\n")
    format_into(s, "  %dc = add i64 %d, 48\n")
    format_into(s, "  %ch = trunc i64 %dc to i8\n")
    format_into(s, "  store i8 %ch, ptr %np\n")
    format_into(s, "  %q = udiv i64 %val, 10\n")
    format_into(s, "  %more = icmp ne i64 %q, 0\n")
    format_into(s, "  br i1 %more, label %digit, label %done\n")
    format_into(s, "done:\n")
    format_into(s, "  %mp = getelementptr i8, ptr %np, i64 -1\n")
    format_into(s, "  store i8 45, ptr %mp\n")
    format_into(s, "  %first = select i1 %neg, ptr %mp, ptr %np\n")
    format_into(s, "  %ei = ptrtoint ptr %end to i64\n")
    format_into(s, "  %fi = ptrtoint ptr %first to i64\n")
    format_into(s, "  %dl = sub i64 %ei, %fi\n")
    format_into(s, "  %dd = getelementptr i8, ptr %buf, i64 %hlen\n")
    format_into(s, "  call void @__ritz_sret_copy(ptr %dd, ptr %first, i64 %dl)\n")
    format_into(s, "  %at = add i64 %hlen, %dl\n")
    format_into(s, "  %td = getelementptr i8, ptr %buf, i64 %at\n")
    let tail_len: i64 = if free then 17 else 18   # the hook writes the newline
    format_into(s, "  call void @__ritz_sret_copy(ptr %td, ptr @.ritz_match_tail, i64 {tail_len})\n")
    format_into(s, "  %len = add i64 %at, {tail_len}\n")
    if free
        s.ir.platform_stop = s.ir.platform_stop | PSTOP_USED
        format_into(s, "  call void @ritz_platform_fatal(ptr %buf, i64 %len, i32 1)\n")
        format_into(s, "  unreachable\n}}\n")
        return
    let write: StrView = syscall_write_asm()
    let exit: StrView = syscall_exit_asm()
    format_into(s, "  %bi = ptrtoint ptr %buf to i64\n")
    format_into(s, "  %w = {write}(i64 1, i64 2, i64 %bi, i64 %len)\n")
    format_into(s, "  %x = {exit}(i64 60, i64 1)\n")
    format_into(s, "  unreachable\n")
    format_into(s, "}}\n")

# =============================================================================
# format_into(sink, "...") -- AGAST #1824
# =============================================================================
#
# The literal is split exactly as print's (split_literal), and every
# piece -- literal text or a formatted value -- is appended with one call to
# `sink.push_bytes(data: Span<u8>)`, resolved like a method call on the
# sink's struct (e.g. GrowBuf.push_bytes). Vec<u8>.push_bytes, the impl
# method #4537 moved off `vec_push_bytes`, still takes `(data, len)`, and
# that shape is still accepted.
# ritz0's _emit_format_into is the oracle.
#
# A value is formatted into a stack buffer by @__ritz_fmt_int /
# @__ritz_fmt_strlen (emit_format_helpers), not print's write helpers. print
# shares the integer path (emit_fmt_int, AGAST #2128).

# Where format_into appends: the sink pointer and the push_bytes it names.
struct FmtSink
    recv: i32          # register holding the sink as a `ptr`
    callee: StrView    # push_bytes's IR name, as ir_name spells it (no `@`)
    fn_def: *FnDef     # its params and return type
    span: bool         # it takes `(self, data: Span<u8>)`, else `(self, data, len)`

# The bytes of a formatted value: a `ptr` register and its i64 length register.
struct ByteRegs
    ptr: i32
    len: i32

# A push's length operand: the i64 register `reg`, or the constant `imm` when
# `reg` is 0.
struct PushLen
    reg: i32
    imm: i64

fn len_in(reg: i32) -> PushLen
    PushLen { reg: reg, imm: 0 }

fn len_const(imm: i64) -> PushLen
    PushLen { reg: 0, imm: imm }

# Report a format_into error at `at`, naming the type `name` (unnamed for
# none) before `msg`. Counts like emit_print_error.
fn fmt_error(s: *EmitterState, at: *Expr, name: StrView, msg: StrView)
    format_into(s, "  ; ERROR: format_into\n")
    diag_error_at(emitter_source_file(), at.span)
    eprints("ritz1 cannot emit: format_into: ")
    if not unnamed(name)
        eprints("type '")
        eprints(name)
        eprints("' ")
    eprints(msg)
    eprints("\n")
    s.diag.error_count = s.diag.error_count + 1

fn fmt_is_ptr_type(t: TypeKind) -> bool
    t == TypeKind.Ptr or t == TypeKind.Ref or t == TypeKind.MutRef

# The struct the sink expression points at; unnamed when none. The shapes
# arg_pointee_struct knows (`@x`, `@&x`, `@&a.b`, a `*T` local or param), a
# pointer-typed field (`st.out: *Vec<u8>`), and a call returning `*T`.
fn fmt_sink_struct(s: *EmitterState, e: *Expr) -> StrView
    let named: StrView = arg_pointee_struct(s, e)
    if named.ptr != null
        return named
    match e.kind
        ExprKind.Member =>
            let f: *StructField = member_field_def(s, e)
            if f != null and fmt_is_ptr_type(f.field_type) and f.field_type_name_len > 0
                return StrView { ptr: f.field_type_name, len: f.field_type_name_len as i64 }
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, e)
            if fd != null and fmt_is_ptr_type(fd.return_type) and fd.return_type_name_len > 0
                return StrView { ptr: fd.return_type_name, len: fd.return_type_name_len as i64 }
        _ => pass
    no_name()

# Is the sink expression a struct value (not a pointer to one)?
fn fmt_sink_is_value(s: *EmitterState, e: *Expr) -> bool
    if e.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, e.ident)
        if loc != null and lv_var_type(loc) == TypeKind.Struct
            return true
    not unnamed(resolve_expr_struct_name(s, e))

# The `ret` type push_bytes is called with: a struct by its name, a bool or
# a narrow integer by its width, anything else as i64.
fn fmt_emit_ret_type(s: *EmitterState, fd: *FnDef)
    let rt: TypeKind = fd.return_type
    if rt == TypeKind.Struct and fd.return_type_name_len > 0
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: fd.return_type_name, len: fd.return_type_name_len as i64 })
        return
    var ty: StrView = "i64"
    if rt == TypeKind.Bool or ty_int_in(rt, 8, 32) == 1
        ty = llvm_text(ty_mem_llvm(rt))
    format_into(s, "{ty}")

# True when push_bytes takes `(self, data: Span<u8>)` (AGAST #4555).
fn fmt_sink_is_span(fd: *FnDef) -> bool
    if fd.params == null
        return false
    let p: *Param = fd.params.next
    if p == null or p.next != null or param_is_span(p) == 0
        return false
    name_eq(StrView { ptr: p.param_type_name, len: p.param_type_name_len as i64 }, "Span$u8") == 1

# True when push_bytes still takes `(self, data, len: i64)`. Vec<u8> does:
# #4537 moved the method into the impl and left this signature.
fn fmt_sink_is_raw(fd: *FnDef) -> bool
    if fd.params == null or fd.params.next == null
        return false
    let last: *Param = fd.params.next.next
    last != null and last.next == null and last.param_type == TypeKind.I64

# The length operand of a push.
fn fmt_push_len(s: *EmitterState, len: PushLen)
    if len.reg > 0
        format_into(s, "%.{len.reg}")
        return
    format_into(s, "{len.imm}")

# `  call void @push_bytes(ptr %.recv, ` or `  %.r = call <ret> @...`, by
# push_bytes's return type: the call up to its data argument.
fn fmt_push_call_open(s: *EmitterState, k: *FmtSink)
    if k.fn_def.return_type == TypeKind.Void
        format_into(s, "  call void ")
    else
        let r: i32 = next_reg(s)
        format_into(s, "  %.{r} = call ")
        fmt_emit_ret_type(s, k.fn_def)
        format_into(s, " ")
    let callee: StrView = k.callee
    let recv: i32 = k.recv
    format_into(s, "@{callee}(ptr %.{recv}, ")

# push_bytes(sink, Span<u8> { ptr: data, len }). `data` is a `ptr` register.
fn fmt_push_span(s: *EmitterState, k: *FmtSink, data: i32, len: PushLen)
    let p2: *Param = k.fn_def.params.next
    let sv1: i32 = next_reg(s)
    format_into(s, "  %.{sv1} = insertvalue ")
    emit_param_llvm_type(s, p2)
    format_into(s, " undef, ptr %.{data}, 0\n")
    let sv2: i32 = next_reg(s)
    format_into(s, "  %.{sv2} = insertvalue ")
    emit_param_llvm_type(s, p2)
    format_into(s, " %.{sv1}, i64 ")
    fmt_push_len(s, len)
    format_into(s, ", 1\n")
    fmt_push_call_open(s, k)
    emit_param_llvm_type(s, p2)
    format_into(s, " %.{sv2})\n")

# push_bytes(sink, data, len), the raw pair Vec<u8> still takes. `data` is a
# `ptr` register.
fn fmt_push_pair(s: *EmitterState, k: *FmtSink, data: i32, len: PushLen)
    let p2: *Param = k.fn_def.params.next
    var d: i32 = data
    if p2.param_type != TypeKind.MutRef
        # A `*u8` param is an i64 in ritz1's signatures.
        d = next_reg(s)
        format_into(s, "  %.{d} = ptrtoint ptr %.{data} to i64\n")
    fmt_push_call_open(s, k)
    emit_param_llvm_type(s, p2)
    format_into(s, " %.{d}, ")
    emit_param_llvm_type(s, p2.next)
    format_into(s, " ")
    fmt_push_len(s, len)
    format_into(s, ")\n")

# Append `len` bytes at the `ptr` register `data` through push_bytes.
fn fmt_push(s: *EmitterState, k: *FmtSink, data: i32, len: PushLen)
    if k.span
        fmt_push_span(s, k, data, len)
        return
    fmt_push_pair(s, k, data, len)

# Append bytes known at compile time.
fn fmt_push_const(s: *EmitterState, k: *FmtSink, data: StrView)
    fmt_push(s, k, str_const_ptr(s, data), len_const(data.len))

# Format the integer placeholder `e` of type `ty` (ty_int_bits(ty) > 0: the
# caller checks) into a stack buffer with @__ritz_fmt_int: its decimal digits
# and their length. Signedness comes from the Ritz type: an unsigned value is
# zero-extended and divided unsigned (AGAST #2128). print, eprint and
# format_into all format integers here.
fn emit_fmt_int(s: *EmitterState, e: *Expr, ty: TypeKind) -> ByteRegs
    let signed: bool = ty_is_signed(ty) == 1
    var v: i32 = emit_expr(s, e)
    if ty_int_bits(ty) < 64
        # ritz1 holds a narrow int in an i64; rebuild it from its width.
        let narrow: StrView = llvm_text(ty_mem_llvm(ty))
        let t: i32 = next_reg(s)
        format_into(s, "  %.{t} = trunc i64 %.{v} to {narrow}\n")
        var ext: StrView = "zext"
        if signed
            ext = "sext"
        let x: i32 = next_reg(s)
        format_into(s, "  %.{x} = {ext} {narrow} %.{t} to i64\n")
        v = x
    let buf: i32 = next_reg(s)
    entry_alloca_reg_begin(s, buf)
    format_into(s, "[24 x i8]\n")
    entry_alloca_reg_end(s)
    let start: i32 = next_reg(s)
    let sign_bit: i32 = signed as i32
    format_into(s, "  %.{start} = call i64 @__ritz_fmt_int(ptr %.{buf}, i64 %.{v}, i1 {sign_bit})\n")
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = getelementptr i8, ptr %.{buf}, i64 %.{start}\n")
    let n: i32 = next_reg(s)
    format_into(s, "  %.{n} = sub i64 20, %.{start}\n")
    s.ir.fmt_helpers_used = 1
    ByteRegs { ptr: p, len: n }

# Append a view's `len` bytes from its `ptr`: loaded first through a pointer
# to one.
fn fmt_push_view(s: *EmitterState, k: *FmtSink, e: *Expr, view: ViewOf)
    let ty: String = ir_name(view.name)
    var v: i32 = emit_expr(s, e)
    if view.form == ViewForm.Pointer
        let p: i32 = i64_value_to_ptr(s, e, v)
        let agg: i32 = next_reg(s)
        format_into(s, "  %.{agg} = load %{ty.as_view()}, ptr %.{p}\n")
        v = agg
    let parts: ByteRegs = view_fields(s, ty.as_view(), v)
    fmt_push(s, k, parts.ptr, len_in(parts.len))

# Append `true` / `false`.
fn fmt_push_bool(s: *EmitterState, k: *FmtSink, e: *Expr)
    let v: i32 = emit_expr(s, e)
    let b: i32 = next_reg(s)
    format_into(s, "  %.{b} = icmp ne i64 %.{v}, 0\n")
    let p: i32 = next_reg(s)
    format_into(s, "  %.{p} = select i1 %.{b}, ptr @.ritz_fmt_true, ptr @.ritz_fmt_false\n")
    let n: i32 = next_reg(s)
    format_into(s, "  %.{n} = select i1 %.{b}, i64 4, i64 5\n")
    s.ir.fmt_helpers_used = 1
    fmt_push(s, k, p, len_in(n))

# Append the NUL-terminated bytes a pointer value points at.
fn fmt_push_cstr(s: *EmitterState, k: *FmtSink, e: *Expr)
    let v: i32 = emit_expr(s, e)
    let sp: i32 = i64_value_to_ptr(s, e, v)
    let sn: i32 = next_reg(s)
    format_into(s, "  %.{sn} = call i64 @__ritz_fmt_strlen(ptr %.{sp})\n")
    s.ir.fmt_helpers_used = 1
    fmt_push(s, k, sp, len_in(sn))

# Append the formatted value of placeholder `e`: as print's table, except
# that unsigned integers format unsigned. A value with no formatted form is
# reported at the literal.
fn fmt_push_value(s: *EmitterState, k: *FmtSink, lit: *Expr, e: *Expr)
    let view: ViewOf = interp_view_of(s, e)
    if view.form != ViewForm.NotView
        fmt_push_view(s, k, e, view)
        return
    if interp_is_bool(s, e)
        fmt_push_bool(s, k, e)
        return
    let ty: TypeKind = expr_slot_ty(e)
    if ty_int_bits(ty) > 0
        let digits: ByteRegs = emit_fmt_int(s, e, ty)
        fmt_push(s, k, digits.ptr, len_in(digits.len))
        return
    if ty == TypeKind.Ptr or ty == TypeKind.PtrPtr or ty == TypeKind.Ref or ty == TypeKind.MutRef
        fmt_push_cstr(s, k, e)
        return
    fmt_error(s, lit, no_name(), "cannot format this value: only integers, bool, StrView and pointers have a formatted form")

# push_bytes on the sink's struct `tn`, in emit_expr_method's order: a
# specialised generic impl method (`Vec$u8_push_bytes`, a free fn of the
# module since monomorph), else a non-generic impl's. Not a free
# `vec_push_bytes`: the UFCS table went with LARB R66 (#3497). Declares it
# when it lives in another module; null when there is none.
fn fmt_find_push_bytes(s: *EmitterState, tn: StrView) -> *FnDef
    let spec: *FnDef = find_spec_impl_method(s, tn, "push_bytes")
    if spec != null
        add_extern(s, StrView { ptr: spec.name, len: spec.name_len as i64 })
        return spec
    let fd: *FnDef = find_impl_method(s, tn, "push_bytes")
    if fd != null and fd.is_local == 0
        add_method_extern(s, tn, "push_bytes")
    fd

# The IR name of `tn`'s push_bytes `fd`: a specialised instance's own name,
# else the impl method's `Type_push_bytes`.
fn push_bytes_ir_name(s: *EmitterState, tn: StrView, fd: *FnDef) -> String
    if fd == find_spec_impl_method(s, tn, "push_bytes")
        return ir_name(StrView { ptr: fd.name, len: fd.name_len as i64 })
    var name: String = string_new()
    format_into(@&name, "{tn}_push_bytes")
    ir_name(name.as_view())

# Lower format_into(sink, <literal>). The sink is evaluated once, first.
pub fn emit_format_into(s: *EmitterState, e: *Expr) -> i32
    let sink: *Expr = e.args
    var lit: *Expr = null
    if sink != null
        lit = sink.next
    if lit == null or lit.next != null
        fmt_error(s, e, no_name(), "format_into(sink, \"...\") takes two arguments: a pointer to the buffer and a string literal")
        return emit_print_zero(s)
    if lit.kind != ExprKind.StringLit and lit.kind != ExprKind.CstringLit
        fmt_error(s, e, no_name(), "format_into's second argument must be a string literal: its placeholders are resolved at compile time")
        return emit_print_zero(s)
    if fmt_sink_is_value(s, sink)
        fmt_error(s, e, no_name(), "format_into's sink must be a pointer to the buffer (`@&buf`), not a value: appending to a copy would be lost")
        return emit_print_zero(s)
    let tn: StrView = fmt_sink_struct(s, sink)
    if unnamed(tn)
        fmt_error(s, e, no_name(), "the sink is not a pointer to a struct with a push_bytes(data: Span<u8>) method to append through")
        return emit_print_zero(s)
    let fd: *FnDef = fmt_find_push_bytes(s, tn)
    if fd == null
        fmt_error(s, e, tn, "has no push_bytes(data: Span<u8>) method to append through")
        return emit_print_zero(s)
    let span: bool = fmt_sink_is_span(fd)
    if not span and not fmt_sink_is_raw(fd)
        fmt_error(s, e, tn, "push_bytes must take (self, data: Span<u8>) to be a format_into sink")
        return emit_print_zero(s)

    let v: i32 = emit_expr(s, sink)
    let callee_ir: String = push_bytes_ir_name(s, tn, fd)
    var k: FmtSink = FmtSink { recv: i64_value_to_ptr(s, sink, v), callee: callee_ir.as_view(), fn_def: fd, span: span }
    emit_format_literal(s, @k, lit)

# The helpers fmt_push_value calls. Emitted once, after the functions, by a
# module that used any of them; ritz0's _format_int_helper /
# _format_strlen_helper define the same functions. "no-builtins" keeps
# clang from turning the strlen loop into a libc call.
pub fn emit_format_helpers(s: *EmitterState)
    if s.ir.fmt_helpers_used == 0
        return
    format_into(s, "\n; format_into helpers (AGAST #1824), as ritz0's _format_int_helper\n")
    # Decimal digits back to front, ending at buf[20]; returns the first
    # byte's index. A negative signed value's magnitude 0 - v is right read
    # unsigned even for i64::MIN; unsigned values divide unsigned.
    format_into(s, "define internal i64 @__ritz_fmt_int(ptr %buf, i64 %v, i1 %signed) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %lt = icmp slt i64 %v, 0\n")
    format_into(s, "  %neg = and i1 %signed, %lt\n")
    format_into(s, "  %negv = sub i64 0, %v\n")
    format_into(s, "  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    format_into(s, "  br label %digit\n")
    format_into(s, "digit:\n")
    format_into(s, "  %pos = phi i64 [ 20, %entry ], [ %np, %digit ]\n")
    format_into(s, "  %val = phi i64 [ %mag, %entry ], [ %q, %digit ]\n")
    format_into(s, "  %np = sub i64 %pos, 1\n")
    format_into(s, "  %d = urem i64 %val, 10\n")
    format_into(s, "  %ch64 = add i64 %d, 48\n")
    format_into(s, "  %ch = trunc i64 %ch64 to i8\n")
    format_into(s, "  %cp = getelementptr i8, ptr %buf, i64 %np\n")
    format_into(s, "  store i8 %ch, ptr %cp\n")
    format_into(s, "  %q = udiv i64 %val, 10\n")
    format_into(s, "  %more = icmp ne i64 %q, 0\n")
    format_into(s, "  br i1 %more, label %digit, label %sign\n")
    format_into(s, "sign:\n")
    format_into(s, "  br i1 %neg, label %minus, label %done\n")
    format_into(s, "minus:\n")
    format_into(s, "  %mp = sub i64 %np, 1\n")
    format_into(s, "  %mcp = getelementptr i8, ptr %buf, i64 %mp\n")
    format_into(s, "  store i8 45, ptr %mcp\n")
    format_into(s, "  br label %done\n")
    format_into(s, "done:\n")
    format_into(s, "  %start = phi i64 [ %np, %sign ], [ %mp, %minus ]\n")
    format_into(s, "  ret i64 %start\n")
    format_into(s, "}}\n\n")
    format_into(s, "define internal i64 @__ritz_fmt_strlen(ptr %p) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  br label %scan\n")
    format_into(s, "scan:\n")
    format_into(s, "  %n = phi i64 [ 0, %entry ], [ %n1, %scan ]\n")
    format_into(s, "  %cp = getelementptr i8, ptr %p, i64 %n\n")
    format_into(s, "  %c = load i8, ptr %cp\n")
    format_into(s, "  %n1 = add i64 %n, 1\n")
    format_into(s, "  %nul = icmp eq i8 %c, 0\n")
    format_into(s, "  br i1 %nul, label %done, label %scan\n")
    format_into(s, "done:\n")
    format_into(s, "  ret i64 %n\n")
    format_into(s, "}}\n\n")
    format_into(s, "@.ritz_fmt_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    format_into(s, "@.ritz_fmt_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
