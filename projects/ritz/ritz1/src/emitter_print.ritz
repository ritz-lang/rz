# ritz1/src/emitter_print.ritz - lowering of the print builtin (AGAST #1521)
#
# `print("a={a} b={f(b)}\n")` becomes a write of "a=", the value of `a`, a
# write of " b=", the value of `f(b)`, and a write of "\n". This is ritz0's
# `_emit_interp_string_print` / `_emit_print_value`, and the output must be
# byte-identical to ritz0's.
#
# `{x}` is `x.show(w)` when x's type has a Display impl in scope (AGAST
# #4381, ritz0's #202); `{x:?}` is `show_debug`, and a struct with no Debug
# impl auto-derives `Name { field: value, ... }`. `w` is the implicit stdout
# Writer (print/println), stderr's (eprint/eprintln), or the program's own
# (write/writeln). A type with neither an impl nor an intrinsic form is a
# located diagnostic naming the impl to add.
#
# With no impl in scope (a self-contained program), values print by type:
#
#   integers   decimal, signed or unsigned by the Ritz type (AGAST #2128):
#              u8 200 prints `200`, u64::MAX `18446744073709551615`. The
#              digits come from format_into's @__ritz_fmt_int.
#   bool       `true` / `false`
#   StrView    its `len` bytes from `ptr` (also the %Span$u8 a bare "..."
#              lowers to, and a @StrView / *StrView), as ritz0 (#1641)
#   pointers   the NUL-terminated bytes they point at
#   anything   else is the missing-impl diagnostic, as in ritz0
#
# Every entry point takes the output fd: print passes 1, eprint 2 (#1641).
#
# Bool and string printing are small helper functions (`@__ritz_print_*`),
# defined once per module that uses them by emit_print_helpers, rather than
# ritz0's inline loops. The implicit Writer's fd sink is emitted there too.
#
# interp.ritz holds the placeholder rules and the expression parser.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str     # memset (compiler-built Expr nodes)
import ritzlib.strview # strview_starts_with (was emitter_expr_call's)
import ritzlib.string  # String for the missing-impl diagnostic
import ast
import types
import emitter_core
import emitter_ir
import diag   # diag_error_at (AGAST #3445)
import emitter_expr
import lexer
import emitter_expr_call
import interp
import bool_check   # AGAST #2342
import bool_kind
import diag          # fn_display_name (AGAST #4018)
import ast_helpers   # is_test_fn / is_test_helper_fn (AGAST #1869)

# Report an error at a print literal: an IR comment, a stderr line located
# at the literal (diag, AGAST #3445; it used to name the line alone), and one
# more on s.error_count (AGAST #1369), so ritz1 exits non-zero instead of
# writing the output.
fn emit_print_error(s: *EmitterState, lit: *Expr, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_str(s, IR_NL)
    diag_error_at(emitter_source_file(), lit.span)
    eprints_cstr(c"ritz1 cannot emit: ")
    eprints_cstr(msg)
    eprint_char('\n')
    s.error_count = s.error_count + 1

fn eprint_bytes_n(p: *u8, n: i32)
    var i: i32 = 0
    while i < n
        eprint_char(*(p + i))
        i = i + 1

# A placeholder `{expr:spec}` (`expr` is `elen` bytes, untrimmed): refuse an
# unknown spec, and -- until AGAST #202 prints specs through ritzlib.fmt's
# Display -- a valid one, rather than print the value without it. ritz0's
# messages are interp_spec.py's, word for word.
fn emit_spec_error(s: *EmitterState, lit: *Expr, expr_sv: StrView, spec_sv: StrView)
    var expr: *u8 = expr_sv.ptr
    var elen: i32 = expr_sv.len as i32
    var spec: *u8 = spec_sv.ptr
    var slen: i32 = spec_sv.len as i32
    diag_error_at(emitter_source_file(), lit.span)
    if interp_spec_valid(StrView { ptr: (spec), len: (slen) as i64 }) == 0
        var lo: i32 = 0
        let n: i32 = interp_trim(StrView { ptr: (expr), len: (elen) as i64 }, @lo)
        eprints_cstr(c"unknown format spec `")
        eprint_bytes_n(spec, slen)
        eprints_cstr(c"` in `{")
        eprint_bytes_n(expr + lo, n)
        eprint_char(':')
        eprint_bytes_n(spec, slen)
        eprints_cstr(c"}`: the v1 specs are x X b o, a zero-padded width (08x), <N >N ^N and ?")
    else
        eprints_cstr(c"format spec `")
        eprint_bytes_n(spec, slen)
        eprints_cstr(c"` is parsed but not printed until AGAST #202; drop `:")
        eprint_bytes_n(spec, slen)
        eprints_cstr(c"` for now")
    eprint_char('\n')
    emit_str(s, c"  ; ERROR: format spec\n")
    s.error_count = s.error_count + 1

fn emit_print_zero(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, IR_ADD_ZERO)
    z

# write(fd, data, len) for bytes known at compile time. Returns the register
# holding the syscall's result (bytes written).
pub fn emit_print_bytes(s: *EmitterState, fd: i64, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    let str_idx: i32 = add_string(s, StrView { ptr: (data), len: (len) as i64 })
    let gep_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, gep_reg)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, (len + 1) as i64)
    emit_str(s, c" x i8], ptr @.str.")
    emit_int(s, str_idx as i64)
    emit_str(s, c", i64 0, i64 0\n")
    let ptr_reg: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, gep_reg)
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, c" = call i64 asm sideeffect \"syscall\", ")
    emit_str(s, c"\"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"")
    emit_str(s, c"(i64 1, i64 ")
    emit_int(s, fd)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, ptr_reg)
    emit_str(s, IR_I64_SEP)
    emit_int(s, len as i64)
    emit_str(s, IR_CLOSE)
    result

# Is `e` a bool in ritz0's eyes (an i1 there)?  See bool_check.ritz.
pub fn interp_is_bool(s: *EmitterState, e: *Expr) -> i32
    (bool_kind(s, e) == BK_BOOL) as i32

# Is `name` one of the two `{ ptr, i64 }` view types: StrView, or the
# %Span$u8 a bare "..." literal lowers to (AGAST #98)?
fn interp_is_view_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return 0
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        return 1
    name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 })

# Is `e` a StrView? Returns 1 for a view value (an aggregate register),
# 2 for a pointer or reference to a StrView (an i64 register), else 0.
# Writes the aggregate's LLVM type name. ritz0 decides by LLVM type
# (_is_strview_llvm_type); this finds the same set from ritz1's locals,
# struct fields, calls, consts and literals.
fn interp_strview_kind(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if e.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, e)
        if fld == null or interp_is_view_name(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }) == 0
            return 0
        *out_name = fld.field_type_name
        *out_len = fld.field_type_name_len
        if fld.field_type == TYPE_STRUCT
            return 1
        if fld.field_type == TYPE_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF
            return 2
        return 0
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if loc != null and interp_is_view_name(StrView { ptr: (loc.type_name), len: (loc.type_name_len) as i64 }) == 1
            if loc.var_type == TYPE_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
                *out_name = loc.type_name
                *out_len = loc.type_name_len
                return 2
    var n: *u8 = null
    var l: i32 = 0
    resolve_expr_struct_name(s, e, @n, @l)
    if interp_is_view_name(StrView { ptr: (n), len: (l) as i64 }) == 1
        *out_name = n
        *out_len = l
        return 1
    0

# =============================================================================
# Display / Debug dispatch (AGAST #4381, ritz0's #202 ported)
#
# `{x}` is `x.show(w)`, `{x:?}` is `x.show_debug(w)`, where `w` is the
# implicit stdout Writer (print/println), stderr's (eprint/eprintln) or the
# one the program named (write/writeln). The value's own impl is the only
# word on how it prints; the compiler's primitive formatters remain the
# fallback for a program with no impl in scope, and `?` additionally
# auto-derives a struct's `Name { field: value, ... }`. A type with neither
# is a located diagnostic naming the impl to add.
# =============================================================================

# Where a print statement's bytes go: an implicit fd (kind 0), or the Writer
# the program passed to write/writeln (kind 1). `arg` is the Writer argument
# the impl methods take, built once; for kind 0 the fd Writer is built only
# when an impl is actually called, so a self-contained program that only
# prints ints still needs no Writer struct.
struct PrintSink
    kind: i32
    fd: i64
    wptr: i32
    arg: *Expr
    isink: i32
    ilen: i32

var g_fmt_seq: i32 = 0
var g_fmt_writer_used: i32 = 0

# The name `Writer` is six bytes.
const FMT_WRITER_NAME: *u8 = c"Writer"
const FMT_WRITER_NAME_LEN: i32 = 6

# role + '_' + up to 20 digits + NUL (AGAST #1820: no magic alloc sizes).
const FMT_NAME_BUF: i64 = 64

# A fresh hidden local name. The buffer is never freed: ritz1 compiles one
# module per process and the name outlives every use.
fn fmt_name(role_sv: StrView, out_len: *i32) -> *u8
    var role: *u8 = role_sv.ptr
    var role_len: i32 = role_sv.len as i32
    let buf: *u8 = malloc(FMT_NAME_BUF)
    var w: i32 = 0
    for i in 0..role_len
        *(buf + w) = *(role + i)
        w = w + 1
    *(buf + w) = 95   # '_'
    w = w + 1
    let n: i32 = g_fmt_seq
    g_fmt_seq = n + 1
    if n == 0
        *(buf + w) = 48
        w = w + 1
    else
        var digits: [16]i32
        var d: i32 = 0
        var v: i32 = n
        while v > 0
            digits[d] = v - (v / 10) * 10
            v = v / 10
            d = d + 1
        while d > 0
            d = d - 1
            *(buf + w) = (48 + digits[d]) as u8
            w = w + 1
    *(buf + w) = 0
    *out_len = w
    buf

# A zeroed Expr, so every field the emitter reads on a compiler-built node
# (bracket, own_raw, slot_type, ...) starts at its "not set" value.
fn fmt_expr_zero() -> *Expr
    let e: *Expr = malloc(sizeof(Expr)) as *Expr
    memset(e as *u8, 0, sizeof(Expr))
    e

fn fmt_ident_expr(name_sv: StrView, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let e: *Expr = fmt_expr_zero()
    e.kind = EXPR_IDENT
    e.ident_ptr = name
    e.ident_len = name_len
    e.span = span
    e

fn fmt_unary_expr(op: i32, operand: *Expr, span: SrcSpan) -> *Expr
    let e: *Expr = fmt_expr_zero()
    e.kind = EXPR_UNARY
    e.op = op
    e.operand = operand
    e.span = span
    e

fn fmt_member_expr(base: *Expr, name_sv: StrView, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let e: *Expr = fmt_expr_zero()
    e.kind = EXPR_MEMBER
    e.left = base
    e.ident_ptr = name
    e.ident_len = name_len
    e.span = span
    e

fn fmt_method_expr(recv: *Expr, name_sv: StrView, args: *Expr, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let e: *Expr = fmt_expr_zero()
    e.kind = EXPR_METHOD
    e.left = recv
    e.ident_ptr = name
    e.ident_len = name_len
    e.args = args
    e.span = span
    e

# AGAST #4410: a placeholder's expression is parsed *after* the Sema walk, so
# no node in it carries Sema's slot annotation.  Note the emitter's slot type
# on each node here, at construction, so the emit path's expr_slot_ty reads a
# real type instead of the node-local fallback (the `?` an unannotated
# identifier printed, ritzlib/iovec.ritz's regression under #4404).
fn fmt_note_slots(s: *EmitterState, e: *Expr)
    if e == null
        return
    expr_note_sema_ty(e, synth_slot_ty(s, e))
    fmt_note_slots(s, e.left)
    fmt_note_slots(s, e.right)
    fmt_note_slots(s, e.operand)
    fmt_note_slots(s, e.args)
    fmt_note_slots(s, e.next)

# interp_parse_expr, with the parsed nodes' slot types noted.
fn fmt_parse(s: *EmitterState, text_sv: StrView, line: i32, col: i32) -> *Expr
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    let e: *Expr = interp_parse_expr(StrView { ptr: (text), len: (len) as i64 }, line, col)
    if e != null
        fmt_note_slots(s, e)
    e

# The Ritz type of `e`'s value and the name a Display/Debug impl for it would
# be registered under (null when none is derivable).
struct FmtType
    kind: i32
    name: *u8
    name_len: i32
    is_bool: i32
    pointee: i32

# The dispatch name of a reference's referent, when it is a primitive or
# `*u8` (`{r}` prints what r refers to, as ritz0 reads a RefType).
fn fmt_pointee_name(kind: i32, inner: i32, out: *FmtType)
    if kind == TYPE_PTR and inner == TYPE_U8
        out.name = c"ptr_u8"
        out.name_len = 6
        return
    let pn: *u8 = primitive_name_from_type(kind)
    if pn != null
        out.name = pn
        out.name_len = primitive_name_len(kind)

fn fmt_type_of(s: *EmitterState, e: *Expr, out: *FmtType)
    out.kind = TYPE_I64
    out.name = null
    out.name_len = 0
    out.is_bool = 0
    out.pointee = TYPE_I64
    if e == null
        return
    # A bool lives in an i64 slot (AGAST #1521), so get_expr_type alone
    # cannot tell it apart from an i64.
    if interp_is_bool(s, e) == 1
        out.kind = TYPE_I64
        out.name = c"bool"
        out.name_len = 4
        out.is_bool = 1
        return
    let t: i32 = expr_slot_ty(e)
    if t == TYPE_REF or t == TYPE_MUT_REF
        out.kind = t
        if e.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if loc != null
                if loc.type_name_len > 0
                    out.name = loc.type_name
                    out.name_len = loc.type_name_len
                else
                    fmt_pointee_name(loc.pointee_type, loc.inner_pointee_type, out)
        else if e.kind == EXPR_CALL
            let fd: *FnDef = find_call_fn(s, e)
            if fd != null and fd.return_type_name_len > 0
                out.name = fd.return_type_name
                out.name_len = fd.return_type_name_len
        else if e.kind == EXPR_METHOD
            let md: *FnDef = method_call_def(s, e)
            if md != null and md.return_type_name_len > 0
                out.name = md.return_type_name
                out.name_len = md.return_type_name_len
        return
    if t == TYPE_PTR or t == TYPE_PTR_PTR
        out.kind = t
        if e.kind == EXPR_CSTRING_LIT
            out.name = c"ptr_u8"
            out.name_len = 6
            return
        let pt: i32 = get_deref_store_type(s, e)
        out.pointee = pt
        if pt == TYPE_U8
            out.name = c"ptr_u8"
            out.name_len = 6
        return
    out.kind = t
    var n: *u8 = null
    var l: i32 = 0
    resolve_expr_struct_name(s, e, @n, @l)
    if n != null and l > 0
        out.name = n
        out.name_len = l
        if out.kind != TYPE_STRUCT
            out.kind = TYPE_STRUCT
        return
    if t == TYPE_STRUCT
        if e.kind == EXPR_IDENT
            let loc2: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if loc2 != null and loc2.type_name_len > 0
                out.name = loc2.type_name
                out.name_len = loc2.type_name_len
        else if e.kind == EXPR_MEMBER
            # resolve_expr_struct_name has no member arm; the field's declared
            # type names it (`{o.inner}`, `{s.f.g}`).
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type_name_len > 0
                out.name = fld.field_type_name
                out.name_len = fld.field_type_name_len
        return
    let pn: *u8 = primitive_name_from_type(t)
    if pn != null
        out.name = pn
        out.name_len = primitive_name_len(t)

# The source spelling a diagnostic uses: `ptr_u8` is `*u8`, and a single
# `$` generic marker reads as `<arg>` (`Span$u8` -> `Span<u8>`).
fn fmt_spelling(name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name == null or name_len <= 0
        *out_len = 1
        return c"?"
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"ptr_u8"), len: (6) as i64 }) == 1
        *out_len = 3
        return c"*u8"
    var dollars: i32 = 0
    var at: i32 = 0 - 1
    for i in 0..name_len
        if *(name + i) == 36
            dollars = dollars + 1
            at = i
    if dollars != 1
        *out_len = name_len
        return name
    let buf: *u8 = malloc((name_len + 3) as i64)
    var w: i32 = 0
    for i in 0..at
        *(buf + w) = *(name + i)
        w = w + 1
    *(buf + w) = 60   # '<'
    w = w + 1
    for i in at + 1..name_len
        *(buf + w) = *(name + i)
        w = w + 1
    *(buf + w) = 62   # '>'
    w = w + 1
    *(buf + w) = 0
    *out_len = w
    buf

# A built-in target keeps its ritzlib impl as the only word on how it prints;
# no struct's Debug is auto-derived for it (ritz0's is_builtin_target).
fn fmt_is_builtin_target(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"ptr_u8"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1 or strview_starts_with(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Span$"), len: (5) as i64 })
        return 1
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1 or strview_starts_with(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Option$"), len: (7) as i64 })
        return 1
    if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1 or strview_starts_with(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"Result$"), len: (7) as i64 })
        return 1
    0

# The trait impl's method, or null. The impls table is the authority: an
# inherent `show` is not Display, and Display's `show` never answers `?`.
# A generic instance finds a concrete built-in impl under the base name
# (`Span$u8` -> `impl Display for Span<u8>`), or its monomorphized instance
# (`Foo$i32_show`) in the module's functions.
fn fmt_impl_method(s: *EmitterState, type_name_sv: StrView, tname_sv: StrView, method_sv: StrView) -> *FnDef
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var tname: *u8 = tname_sv.ptr
    var tname_len: i32 = tname_sv.len as i32
    var method: *u8 = method_sv.ptr
    var method_len: i32 = method_sv.len as i32
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (type_name), len: (type_name_len) as i64 }) == 1
            if ib.trait_name != null and name_eq(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, StrView { ptr: (tname), len: (tname_len) as i64 }) == 1
                var mm: *FnDef = ib.methods
                while mm != null
                    if name_eq(StrView { ptr: (mm.name), len: (mm.name_len) as i64 }, StrView { ptr: (method), len: (method_len) as i64 }) == 1
                        return mm
                    mm = mm.next
        ib = ib.next
    var base_len: i32 = 0
    while base_len < type_name_len and *(type_name + base_len) != 36
        base_len = base_len + 1
    if base_len < type_name_len
        ib = s.module.impls
        while ib != null
            if ib.type_params == null
                if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (type_name), len: (base_len) as i64 }) == 1
                    if ib.trait_name != null and name_eq(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, StrView { ptr: (tname), len: (tname_len) as i64 }) == 1
                        var mm2: *FnDef = ib.methods
                        while mm2 != null
                            if name_eq(StrView { ptr: (mm2.name), len: (mm2.name_len) as i64 }, StrView { ptr: (method), len: (method_len) as i64 }) == 1
                                return mm2
                            mm2 = mm2.next
            ib = ib.next
    return find_spec_impl_method(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (method), len: (method_len) as i64 })

# Store `e`'s value in a fresh local, so a method call can dispatch on any
# expression form (a binary op, a call, a field) by name. Returns the ident.
fn fmt_materialize(s: *EmitterState, e: *Expr, ft: *FmtType, span: SrcSpan) -> *Expr
    var nlen: i32 = 0
    let name: *u8 = fmt_name(StrView { ptr: (c"tmp"), len: (3) as i64 }, @nlen)
    let v: i32 = emit_expr(s, e)
    let slot: i32 = next_reg(s)
    if ft.kind == TYPE_STRUCT
        entry_alloca_reg_begin_named(s, slot)
        emit_name(s, StrView { ptr: (ft.name), len: (ft.name_len) as i64 })
        emit_str(s, c"  ; print receiver\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TYPE_STRUCT, StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, v, slot)
        add_local_struct(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, TYPE_STRUCT, StrView { ptr: (ft.name), len: (ft.name_len) as i64 })
    else if ft.kind == TYPE_MUT_REF
        entry_alloca_reg(s, slot, c"ptr", c"print receiver (mut ref)")
        emit_str(s, c"  store ptr ")
        emit_reg(s, v)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
        let pt: i32 = ty_from_name(StrView { ptr: (ft.name), len: (ft.name_len) as i64 })
        add_local_full(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, TYPE_MUT_REF, StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, pt, 0, 0)
    else if ft.kind == TYPE_REF or ft.kind == TYPE_PTR or ft.kind == TYPE_PTR_PTR
        entry_alloca_reg(s, slot, c"i64", c"print receiver (ref/ptr)")
        emit_str(s, c"  store i64 ")
        emit_reg(s, v)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
        var pt2: i32 = ty_from_name(StrView { ptr: (ft.name), len: (ft.name_len) as i64 })
        if ft.kind == TYPE_PTR or ft.kind == TYPE_PTR_PTR
            pt2 = ft.pointee
        else if pt2 == TYPE_VOID
            pt2 = ft.pointee
        add_local_full(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, ft.kind, StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, pt2, 0, 0)
    else if ft.kind == TYPE_F32 or ft.kind == TYPE_F64
        entry_alloca_reg_begin(s, slot)
        emit_str(s, ty_mem_llvm(ft.kind))
        emit_str(s, c"  ; print receiver (float)\n")
        entry_alloca_reg_end(s)
        emit_str(s, IR_STORE_IND)
        emit_str(s, ty_mem_llvm(ft.kind))
        emit_str(s, IR_SP)
        emit_reg(s, v)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
        add_local(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, ft.kind)
    else if ty_int_bits(ft.kind) > 0 and ty_int_bits(ft.kind) < 64
        let mem: *u8 = ty_mem_llvm(ft.kind)
        let t: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, t)
        emit_str(s, IR_TRUNC)
        emit_reg(s, v)
        emit_str(s, IR_TO_SP)
        emit_str(s, mem)
        emit_str(s, IR_NL)
        entry_alloca_reg_begin(s, slot)
        emit_str(s, mem)
        emit_str(s, c"  ; print receiver (narrow int)\n")
        entry_alloca_reg_end(s)
        emit_str(s, IR_STORE_IND)
        emit_str(s, mem)
        emit_str(s, IR_SP)
        emit_reg(s, t)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
        add_local(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, ft.kind)
    else
        entry_alloca_reg(s, slot, c"i64", c"print receiver")
        emit_str(s, c"  store i64 ")
        emit_reg(s, v)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
        add_local(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, ft.kind)
    if ft.is_bool == 1
        let bl: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (nlen) as i64 })
        if bl != null
            bl.is_bool = 1
    fmt_ident_expr(StrView { ptr: (name), len: (nlen) as i64 }, span)

# ---- Writers -------------------------------------------------------------

fn fmt_writer_field(st: *StructDef, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var i: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (name), len: (name_len) as i64 }) == 1
            return i
        i = i + 1
        f = f.next
    0 - 1

# A compiler-emitted error at a span (emit_print_error's shape, for callers
# that hold a span rather than the print literal's expression).
fn fmt_error_at(s: *EmitterState, span: SrcSpan, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_str(s, IR_NL)
    diag_error_at(emitter_source_file(), span)
    eprints_cstr(c"ritz1 cannot emit: ")
    eprints_cstr(msg)
    eprint_char('\n')
    s.error_count = s.error_count + 1

fn fmt_writer_error(s: *EmitterState, span: SrcSpan)
    fmt_error_at(s, span, c"printing needs the Writer struct in scope (ritzlib.fmt.Writer): its Display impls take one")

# The Writer struct and its sink/fd/len field indices, or -1 each.
fn fmt_writer_shape(s: *EmitterState, span: SrcSpan, out_sink: *i32, out_fd: *i32, out_len: *i32) -> *StructDef
    *out_sink = 0 - 1
    *out_fd = 0 - 1
    *out_len = 0 - 1
    let st: *StructDef = find_struct(s, StrView { ptr: (FMT_WRITER_NAME), len: (FMT_WRITER_NAME_LEN) as i64 })
    if st == null
        fmt_writer_error(s, span)
        return null
    *out_sink = fmt_writer_field(st, StrView { ptr: (c"sink"), len: (4) as i64 })
    *out_fd = fmt_writer_field(st, StrView { ptr: (c"fd"), len: (2) as i64 })
    *out_len = fmt_writer_field(st, StrView { ptr: (c"len"), len: (3) as i64 })
    if *out_sink < 0 or *out_fd < 0 or *out_len < 0
        fmt_writer_error(s, span)
        return null
    st

# The implicit Writer for an fd, built in a hidden local, `@&` it. Built
# here rather than by calling ritzlib.fmt's stdout_writer, so a
# self-contained program prints without importing a body it would have to
# link. The layout is Writer's: sink, state, fd, cap, len.
fn fmt_make_fd_writer(s: *EmitterState, sink: *PrintSink, span: SrcSpan) -> i32
    var isink: i32 = 0 - 1
    var ifd: i32 = 0 - 1
    var ilen: i32 = 0 - 1
    let st: *StructDef = fmt_writer_shape(s, span, @isink, @ifd, @ilen)
    if st == null
        return 0
    let slot: i32 = next_reg(s)
    entry_alloca_reg(s, slot, c"%Writer", c"implicit print Writer")
    let p0: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p0)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, slot)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, isink as i64)
    emit_str(s, c"\n  store ptr @__ritz_fmt_fd_sink, ptr ")
    emit_reg(s, p0)
    emit_str(s, IR_NL)
    let p1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p1)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 1\n  store ptr null, ptr ")
    emit_reg(s, p1)
    emit_str(s, IR_NL)
    let p2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p2)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, slot)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, ifd as i64)
    emit_str(s, c"\n  store i32 ")
    emit_int(s, sink.fd)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, p2)
    emit_str(s, IR_NL)
    let p3: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p3)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 3\n  store i64 0, ptr ")
    emit_reg(s, p3)
    emit_str(s, IR_NL)
    let p4: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p4)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, slot)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, ilen as i64)
    emit_str(s, c"\n  store i64 0, ptr ")
    emit_reg(s, p4)
    emit_str(s, IR_NL)
    g_fmt_writer_used = 1
    sink.isink = isink
    sink.ilen = ilen
    var nlen: i32 = 0
    let name: *u8 = fmt_name(StrView { ptr: (c"writer"), len: (6) as i64 }, @nlen)
    add_local_struct(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, TYPE_STRUCT, StrView { ptr: (FMT_WRITER_NAME), len: (FMT_WRITER_NAME_LEN) as i64 })
    sink.wptr = slot
    sink.arg = fmt_unary_expr(OP_ADDR_MUT, fmt_ident_expr(StrView { ptr: (name), len: (nlen) as i64 }, span), span)
    1

# Evaluate the Writer expression write/writeln names, once, into a hidden
# local of reference type, and return it as the method argument.
fn fmt_explicit_writer(s: *EmitterState, writer_expr: *Expr, sink: *PrintSink, span: SrcSpan) -> i32
    var isink: i32 = 0 - 1
    var ifd: i32 = 0 - 1
    var ilen: i32 = 0 - 1
    let st: *StructDef = fmt_writer_shape(s, span, @isink, @ifd, @ilen)
    if st == null
        return 0
    let t: i32 = expr_slot_ty(writer_expr)
    if t != TYPE_MUT_REF and t != TYPE_REF and t != TYPE_PTR and t != TYPE_PTR_PTR
        fmt_error_at(s, span, c"write/writeln needs a Writer as its first argument (`write(@&w, \"...\")`)")
        return 0
    let v: i32 = emit_expr(s, writer_expr)
    let slot: i32 = next_reg(s)
    entry_alloca_reg(s, slot, c"ptr", c"write/writeln Writer")
    if t == TYPE_MUT_REF
        emit_str(s, c"  store ptr ")
        emit_reg(s, v)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
    else
        let wp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, v)
        emit_str(s, c"  store ptr ")
        emit_reg(s, wp)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, slot)
        emit_str(s, IR_NL)
    var nlen: i32 = 0
    let name: *u8 = fmt_name(StrView { ptr: (c"wptr"), len: (4) as i64 }, @nlen)
    add_local_struct(s, StrView { ptr: (name), len: (nlen) as i64 }, slot, TYPE_MUT_REF, StrView { ptr: (FMT_WRITER_NAME), len: (FMT_WRITER_NAME_LEN) as i64 })
    sink.kind = 1
    sink.wptr = slot
    sink.isink = isink
    sink.ilen = ilen
    sink.arg = fmt_ident_expr(StrView { ptr: (name), len: (nlen) as i64 }, span)
    1

# The Writer argument an impl method takes, built once per sink.
fn fmt_writer_arg(s: *EmitterState, sink: *PrintSink, span: SrcSpan) -> *Expr
    if sink.arg != null
        return sink.arg
    if sink.kind == 0
        if fmt_make_fd_writer(s, sink, span) == 0
            return null
    return sink.arg

# ---- Sink writes ---------------------------------------------------------

# Write `len` bytes at `ptr` to the sink. Returns the bytes accepted.
fn fmt_sink_write_ptr(s: *EmitterState, sink: *PrintSink, ptr: i32, len: i32) -> i32
    if sink.kind == 0
        let pi: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, ptr)
        let r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, r)
        emit_str(s, c" = call i64 asm sideeffect \"syscall\", ")
        emit_str(s, c"\"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"")
        emit_str(s, c"(i64 1, i64 ")
        emit_int(s, sink.fd)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, pi)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, len)
        emit_str(s, IR_CLOSE)
        return r
    # The program's Writer: its sink field, then the `len` accounting
    # ritzlib's writer_write would do (without needing the import). The
    # pointer sits in the hidden local write/writeln made for it.
    let isink: i32 = sink.isink
    let ilen: i32 = sink.ilen
    let w: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, w)
    emit_str(s, IR_LOAD_PTR)
    emit_reg(s, sink.wptr)
    emit_str(s, IR_NL)
    let sp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, w)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, isink as i64)
    emit_str(s, IR_NL)
    let sf: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sf)
    emit_str(s, IR_LOAD_PTR)
    emit_reg(s, sp)
    emit_str(s, IR_NL)
    let di: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, ptr)
    let got: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, got)
    emit_str(s, c" = call i64 ")
    emit_reg(s, sf)
    emit_str(s, c"(ptr ")
    emit_reg(s, w)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, di)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, len)
    emit_str(s, IR_CLOSE)
    let lp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, lp)
    emit_str(s, c" = getelementptr %Writer, ptr ")
    emit_reg(s, w)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, ilen as i64)
    emit_str(s, IR_NL)
    let old: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, old)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, lp)
    emit_str(s, IR_NL)
    let pos: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pos)
    emit_str(s, c" = icmp sgt i64 ")
    emit_reg(s, got)
    emit_str(s, IR_COMMA_0)
    let acc: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, acc)
    emit_str(s, c" = select i1 ")
    emit_reg(s, pos)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, got)
    emit_str(s, c", i64 0\n")
    let nw: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, nw)
    emit_str(s, c" = add i64 ")
    emit_reg(s, old)
    emit_str(s, IR_COMMA)
    emit_reg(s, acc)
    emit_str(s, c"\n  store i64 ")
    emit_reg(s, nw)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, lp)
    emit_str(s, IR_NL)
    got

# Write compile-time bytes to the sink; returns the bytes accepted.
fn fmt_sink_write_const(s: *EmitterState, sink: *PrintSink, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    if len <= 0
        return emit_print_zero(s)
    let idx: i32 = add_string(s, StrView { ptr: (data), len: (len) as i64 })
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, (len + 1) as i64)
    emit_str(s, c" x i8], ptr @.str.")
    emit_int(s, idx as i64)
    emit_str(s, c", i64 0, i64 0\n")
    let n: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, n)
    emit_str(s, c" = add i64 0, ")
    emit_int(s, len as i64)
    emit_str(s, IR_NL)
    return fmt_sink_write_ptr(s, sink, ptr, n)

fn fmt_sink_add(s: *EmitterState, total: i32, got: i32) -> i32
    if total == 0
        return got
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = add i64 ")
    emit_reg(s, total)
    emit_str(s, IR_COMMA)
    emit_reg(s, got)
    emit_str(s, IR_NL)
    r

# ---- Intrinsic forms -----------------------------------------------------

# `true` / `false`, written like ritz0's intrinsic bool.
fn fmt_write_bool(s: *EmitterState, sink: *PrintSink, v: i32) -> i32
    let ti: i32 = add_string(s, StrView { ptr: (c"true"), len: (4) as i64 })
    let fi: i32 = add_string(s, StrView { ptr: (c"false"), len: (5) as i64 })
    let tp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tp)
    emit_str(s, c" = getelementptr [5 x i8], ptr @.str.")
    emit_int(s, ti as i64)
    emit_str(s, c", i64 0, i64 0\n")
    let fp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fp)
    emit_str(s, c" = getelementptr [6 x i8], ptr @.str.")
    emit_int(s, fi as i64)
    emit_str(s, c", i64 0, i64 0\n")
    let is: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, is)
    emit_str(s, c" = icmp ne i64 ")
    emit_reg(s, v)
    emit_str(s, IR_COMMA_0)
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, c" = select i1 ")
    emit_reg(s, is)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, tp)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, fp)
    emit_str(s, IR_NL)
    let n: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, n)
    emit_str(s, c" = select i1 ")
    emit_reg(s, is)
    emit_str(s, c", i64 4, i64 5\n")
    return fmt_sink_write_ptr(s, sink, p, n)

# A StrView-shaped value's (ptr, len), as exactly len bytes.
fn fmt_strview_parts(s: *EmitterState, e: *Expr, kind: i32, name_sv: StrView, out_len: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var v: i32 = emit_expr(s, e)
    if kind == 2
        let p: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, v)
        let agg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, agg)
        emit_str(s, IR_LOAD_NAMED)
        emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, p)
        emit_str(s, IR_NL)
        v = agg
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, v)
    emit_str(s, IR_COMMA_0)
    let len: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, v)
    emit_str(s, IR_COMMA_1)
    *out_len = len
    ptr

# A NUL-terminated pointer (an i64 value): strlen, then one write. The
# strlen helper is emit_format_helpers' (`i64 @__ritz_fmt_strlen(ptr)`).
fn fmt_write_cstr(s: *EmitterState, sink: *PrintSink, v: i32) -> i32
    let p: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, v)
    let n: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, n)
    emit_str(s, c" = call i64 @__ritz_fmt_strlen(ptr ")
    emit_reg(s, p)
    emit_str(s, IR_CLOSE)
    s.fmt_helpers_used = 1
    return fmt_sink_write_ptr(s, sink, p, n)

# The compiler's own Display form of a value, or -1 for a type it has none.
fn fmt_intrinsic_display(s: *EmitterState, sink: *PrintSink, e: *Expr, ft: *FmtType) -> i32
    var sv_name: *u8 = null
    var sv_len: i32 = 0
    let sv_kind: i32 = interp_strview_kind(s, e, @sv_name, @sv_len)
    if sv_kind != 0
        var n: i32 = 0
        let p: i32 = fmt_strview_parts(s, e, sv_kind, StrView { ptr: (sv_name), len: (sv_len) as i64 }, @n)
        return fmt_sink_write_ptr(s, sink, p, n)
    if ft.is_bool == 1
        return fmt_write_bool(s, sink, emit_expr(s, e))
    if ty_int_bits(ft.kind) > 0
        var n2: i32 = 0
        let p2: i32 = emit_fmt_int(s, e, ft.kind, @n2)
        if p2 >= 0
            return fmt_sink_write_ptr(s, sink, p2, n2)
    if ft.kind == TYPE_PTR or ft.kind == TYPE_PTR_PTR or ft.kind == TYPE_REF or ft.kind == TYPE_MUT_REF
        let v: i32 = emit_expr(s, e)
        var vi: i32 = v
        if ft.kind == TYPE_MUT_REF
            vi = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, vi)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, v)
            emit_str(s, IR_TO_I64)
        return fmt_write_cstr(s, sink, vi)
    0 - 1

# The compiler's own Debug form of a scalar, or -1. Text and pointers are
# not: ritzlib's Debug quotes a StrView, and the emitter does not claim to be
# that second implementation of the format.
fn fmt_intrinsic_debug(s: *EmitterState, sink: *PrintSink, e: *Expr, ft: *FmtType) -> i32
    if ft.is_bool == 1
        return fmt_write_bool(s, sink, emit_expr(s, e))
    if ty_int_bits(ft.kind) > 0
        var n: i32 = 0
        let p: i32 = emit_fmt_int(s, e, ft.kind, @n)
        if p >= 0
            return fmt_sink_write_ptr(s, sink, p, n)
    0 - 1

# ---- Dispatch ------------------------------------------------------------

fn fmt_missing_impl(s: *EmitterState, span: SrcSpan, ft: *FmtType, tname_sv: StrView)
    var tname: *u8 = tname_sv.ptr
    var tname_len: i32 = tname_sv.len as i32
    var slen: i32 = 0
    let sp: *u8 = fmt_spelling(StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, @slen)
    # StrViews, not C strings: a type name points into the source and is not
    # NUL-terminated.
    let p: StrView = StrView { ptr: sp, len: slen as i64 }
    let t: StrView = StrView { ptr: tname, len: tname_len as i64 }
    var m: String = string_new()
    format_into(@&m, "type `{p}` doesn't implement {t}; add `impl {t} for {p}`")
    fmt_error_at(s, span, string_as_ptr(@&m))

# A struct's auto-derived Debug: `Name { field: value, ... }`, each field
# through its own Debug (a real impl, an auto-derived one, or a scalar's
# intrinsic).
fn fmt_debug_of(s: *EmitterState, e: *Expr, ft: *FmtType, sink: *PrintSink, span: SrcSpan) -> i32
    if ft.name != null and ft.name_len > 0
        let m: *FnDef = fmt_impl_method(s, StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, StrView { ptr: (c"Debug"), len: (5) as i64 }, StrView { ptr: (c"show_debug"), len: (10) as i64 })
        if m != null
            let id: *Expr = fmt_materialize(s, e, ft, span)
            let w: *Expr = fmt_writer_arg(s, sink, span)
            if w == null
                return 0
            return emit_expr_method(s, fmt_method_expr(id, StrView { ptr: (c"show_debug"), len: (10) as i64 }, w, span))
    if ft.kind == TYPE_STRUCT and ft.name != null and ft.name_len > 0
        if fmt_is_builtin_target(StrView { ptr: (ft.name), len: (ft.name_len) as i64 }) == 0
            let st: *StructDef = find_struct(s, StrView { ptr: (ft.name), len: (ft.name_len) as i64 })
            if st != null
                return fmt_auto_debug(s, e, ft, st, sink, span)
    return fmt_intrinsic_debug(s, sink, e, ft)

fn fmt_auto_debug(s: *EmitterState, e: *Expr, ft: *FmtType, st: *StructDef, sink: *PrintSink, span: SrcSpan) -> i32
    var slen: i32 = 0
    let spell: *u8 = fmt_spelling(StrView { ptr: (ft.name), len: (ft.name_len) as i64 }, @slen)
    let id: *Expr = fmt_materialize(s, e, ft, span)
    var total: i32 = fmt_sink_write_const(s, sink, StrView { ptr: (spell), len: (slen) as i64 })
    if st.fields != null
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (c" { "), len: (3) as i64 }))
        var i: i32 = 0
        var f: *StructField = st.fields
        while f != null
            if i > 0
                total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (c", "), len: (2) as i64 }))
            total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (f.name), len: (f.name_len) as i64 }))
            total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (c": "), len: (2) as i64 }))
            let fe: *Expr = fmt_member_expr(id, StrView { ptr: (f.name), len: (f.name_len) as i64 }, span)
            var fft: FmtType
            fmt_field_type(f, @fft)
            var got: i32 = fmt_debug_of(s, fe, @fft, sink, span)
            if got < 0
                fmt_missing_impl(s, span, @fft, StrView { ptr: (c"Debug"), len: (5) as i64 })
                got = emit_print_zero(s)
            total = fmt_sink_add(s, total, got)
            i = i + 1
            f = f.next
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (c" }"), len: (2) as i64 }))
    total

# A struct field's declared type, as the dispatcher needs it.
fn fmt_field_type(f: *StructField, out: *FmtType)
    out.kind = f.field_type
    out.name = null
    out.name_len = 0
    out.is_bool = 0
    out.pointee = TYPE_I64
    if f.field_type == TYPE_STRUCT and f.field_type_name_len > 0
        out.name = f.field_type_name
        out.name_len = f.field_type_name_len
        return
    if f.field_type == TYPE_BOOL
        out.kind = TYPE_I64
        out.is_bool = 1
        out.name = c"bool"
        out.name_len = 4
        return
    if f.field_type == TYPE_PTR or f.field_type == TYPE_PTR_PTR
        out.pointee = f.array_elem_type
        if f.array_elem_type == TYPE_U8 or f.ptr_pointee == TYPE_U8
            out.name = c"ptr_u8"
            out.name_len = 6
        return
    if f.field_type == TYPE_REF or f.field_type == TYPE_MUT_REF
        if f.field_type_name_len > 0
            out.name = f.field_type_name
            out.name_len = f.field_type_name_len
        else
            fmt_pointee_name(f.ptr_pointee, f.inner_pointee_type, out)
        return
    let pn: *u8 = primitive_name_from_type(f.field_type)
    if pn != null
        out.name = pn
        out.name_len = primitive_name_len(f.field_type)

# One `{expr[:spec]}`: the value's own impl, else the compiler's intrinsic
# form, else a located diagnostic naming the impl to add.
fn fmt_print_value(s: *EmitterState, sink: *PrintSink, lit: *Expr, e: *Expr, spec_sv: StrView) -> i32
    var spec: *u8 = spec_sv.ptr
    var spec_len: i32 = spec_sv.len as i32
    let debug: i32 = (spec_len == 1 and *spec == 63) as i32
    var ftype: FmtType
    fmt_type_of(s, e, @ftype)
    if debug == 1
        let got: i32 = fmt_debug_of(s, e, @ftype, sink, e.span)
        if got >= 0
            return got
        fmt_missing_impl(s, e.span, @ftype, StrView { ptr: (c"Debug"), len: (5) as i64 })
        return 0
    if ftype.name != null and ftype.name_len > 0
        let m: *FnDef = fmt_impl_method(s, StrView { ptr: (ftype.name), len: (ftype.name_len) as i64 }, StrView { ptr: (c"Display"), len: (7) as i64 }, StrView { ptr: (c"show"), len: (4) as i64 })
        if m != null
            let id: *Expr = fmt_materialize(s, e, @ftype, e.span)
            let w: *Expr = fmt_writer_arg(s, sink, e.span)
            if w == null
                return 0
            return emit_expr_method(s, fmt_method_expr(id, StrView { ptr: (c"show"), len: (4) as i64 }, w, e.span))
    let got2: i32 = fmt_intrinsic_display(s, sink, e, @ftype)
    if got2 >= 0
        return got2
    fmt_missing_impl(s, e.span, @ftype, StrView { ptr: (c"Display"), len: (7) as i64 })
    0

# Lower an interpolated print: literal parts, then each placeholder's
# Display/Debug, then a newline for println/writeln. `want_total` returns
# the bytes written (write/writeln's value); print's result keeps its old
# shape (the write when there is no placeholder, else 0).
fn emit_interp_print(s: *EmitterState, sink: *PrintSink, lit: *Expr, newline: i32, want_total: i32) -> i32
    var total: i32 = 0
    if lit.kind == EXPR_CSTRING_LIT
        if interp_cstr_has_placeholder(StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 }) == 1
            emit_print_error(s, lit, c"`c\"...\"` literals do not interpolate: the placeholder would be printed verbatim. Use a plain string literal `\"...\"` here, or `{{` to print a literal brace")
            return emit_print_zero(s)
        let r: i32 = fmt_sink_write_const(s, sink, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
        if newline == 1
            fmt_sink_add(s, r, fmt_sink_write_const(s, sink, StrView { ptr: (c"\n"), len: (1) as i64 }))
        return r
    let raw: *u8 = lit.ident_ptr
    if raw == null or lit.ident_len < 2
        return fmt_sink_write_const(s, sink, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
    let body: *u8 = raw + 1
    let n: i32 = lit.ident_len - 2
    let buf: *u8 = malloc((n + 1) as i64)
    var start: i32 = 0
    var w: i32 = 0
    var placeholders: i32 = 0
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == 92 and i + 1 < n
            let esc_p: *u8 = body + i + 1
            *(buf + w) = lexer_cook_escape_at(esc_p, (n - i - 1) as i64, 1) as u8
            w = w + 1
            i = i + 1 + lexer_escape_width(((*esc_p) as i32) & 255)
        else if c == 123 and i + 1 < n and *(body + i + 1) == 123
            *(buf + w) = 123
            w = w + 1
            i = i + 2
        else if c == 125 and i + 1 < n and *(body + i + 1) == 125
            *(buf + w) = 125
            w = w + 1
            i = i + 2
        else if c == 123 and interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i) >= 0
            let close: i32 = interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i)
            if w > start
                total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (buf + start), len: (w - start) as i64 }))
            start = w
            placeholders = placeholders + 1
            let ptext: *u8 = body + i + 1
            var plen: i32 = close - i - 1
            let colon: i32 = interp_spec_colon(StrView { ptr: (ptext), len: (plen) as i64 })
            if colon >= 0
                let spec: *u8 = ptext + colon + 1
                let slen: i32 = plen - colon - 1
                if slen == 1 and *spec == 63
                    let e: *Expr = fmt_parse(s, StrView { ptr: (ptext), len: (colon) as i64 }, lit.span.line, lit.span.col)
                    if e == null
                        emit_print_error(s, lit, c"invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)")
                    else
                        total = fmt_sink_add(s, total, fmt_print_value(s, sink, lit, e, StrView { ptr: (spec), len: (slen) as i64 }))
                else
                    emit_spec_error(s, lit, StrView { ptr: (ptext), len: (colon) as i64 }, StrView { ptr: (spec), len: (slen) as i64 })
            else
                let e: *Expr = fmt_parse(s, StrView { ptr: (ptext), len: (plen) as i64 }, lit.span.line, lit.span.col)
                if e == null
                    emit_print_error(s, lit, c"invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)")
                else
                    total = fmt_sink_add(s, total, fmt_print_value(s, sink, lit, e, StrView { ptr: (c""), len: (0) as i64 }))
            i = close + 1
        else
            *(buf + w) = c as u8
            w = w + 1
            i = i + 1
    if placeholders == 0 and newline == 0 and want_total == 0
        return fmt_sink_write_const(s, sink, StrView { ptr: (buf), len: (w) as i64 })
    if w > start
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (buf + start), len: (w - start) as i64 }))
    if newline == 1
        total = fmt_sink_add(s, total, fmt_sink_write_const(s, sink, StrView { ptr: (c"\n"), len: (1) as i64 }))
    if want_total == 1
        return total
    emit_print_zero(s)

# Lower print/println(<literal>) to fd. Returns the result register: the
# write's byte count when the literal has no placeholder, else 0, as ritz0.
pub fn emit_print_literal(s: *EmitterState, fd: i64, lit: *Expr, newline: i32) -> i32
    var sink: PrintSink
    sink.kind = 0
    sink.fd = fd
    sink.wptr = 0
    sink.arg = null
    sink.isink = 0 - 1
    sink.ilen = 0 - 1
    return emit_interp_print(s, @sink, lit, newline, 0)

# Lower write/writeln(writer, <literal>): Display through the program's
# Writer. Returns the bytes written.
pub fn emit_write_literal(s: *EmitterState, lit: *Expr, writer_expr: *Expr, newline: i32) -> i32
    var sink: PrintSink
    sink.kind = 1
    sink.fd = 0
    sink.wptr = 0
    sink.arg = null
    sink.isink = 0 - 1
    sink.ilen = 0 - 1
    if fmt_explicit_writer(s, writer_expr, @sink, lit.span) == 0
        return emit_print_zero(s)
    return emit_interp_print(s, @sink, lit, newline, 1)

# Bytes known at compile time: written to fd, or appended to the sink `k`
# when there is one (format_into, AGAST #1824).
fn emit_interp_bytes(s: *EmitterState, fd: i64, k: *FmtSink, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    if k != null
        fmt_push_const(s, k, StrView { ptr: (data), len: (len) as i64 })
        return 0
    return emit_print_bytes(s, fd, StrView { ptr: (data), len: (len) as i64 })

# print's literal splitting, for print / eprint (k == null: write to fd) and
# format_into (append each piece to the sink k).
fn emit_interp_literal(s: *EmitterState, fd: i64, k: *FmtSink, lit: *Expr) -> i32
    if lit.kind == EXPR_CSTRING_LIT
        if interp_cstr_has_placeholder(StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 }) == 1
            # #1374/#1394: c"..." does not interpolate, so this would print
            # the placeholder verbatim. Reject it, as ritz0 does.
            if k != null
                emit_print_error(s, lit, c"`c\"...\"` literals do not interpolate: the placeholder would be appended verbatim. Use a plain string literal `\"...\"` here, or `{{` for a literal brace")
            else
                emit_print_error(s, lit, c"`c\"...\"` literals do not interpolate: the placeholder would be printed verbatim. Use a plain string literal `\"...\"` here, or `{{` to print a literal brace")
            return emit_print_zero(s)
        if k != null
            fmt_push_const(s, k, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
            return emit_print_zero(s)
        return emit_print_bytes(s, fd, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })

    # A "..." literal: split its RAW source text. The cooked text in
    # string_ptr cannot tell `\{x}` from `{x}`. expr_string records the raw
    # token, quotes included, in ident_ptr / ident_len.
    let raw: *u8 = lit.ident_ptr
    if raw == null or lit.ident_len < 2
        if k != null
            fmt_push_const(s, k, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
            return emit_print_zero(s)
        return emit_print_bytes(s, fd, StrView { ptr: (lit.string_ptr), len: (lit.string_len) as i64 })
    let body: *u8 = raw + 1
    let n: i32 = lit.ident_len - 2
    # Cooked text is never longer than raw. add_string keeps the pointer, so
    # each chunk stays in this buffer for the rest of the compile.
    let buf: *u8 = malloc((n + 1) as i64)
    var start: i32 = 0     # first byte of the chunk not yet written
    var w: i32 = 0         # write cursor in buf
    var placeholders: i32 = 0
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == 92 and i + 1 < n
            # The lexer's own table (lexer.ritz): it already rejected a
            # bad escape in this literal, so this always cooks. `\xNN` is
            # three bytes after the backslash (AGAST #1872).
            let esc_p: *u8 = body + i + 1
            *(buf + w) = lexer_cook_escape_at(esc_p, (n - i - 1) as i64, 1) as u8
            w = w + 1
            i = i + 1 + lexer_escape_width(((*esc_p) as i32) & 255)
        else if c == 123 and i + 1 < n and *(body + i + 1) == 123
            *(buf + w) = 123
            w = w + 1
            i = i + 2
        else if c == 125 and i + 1 < n and *(body + i + 1) == 125
            *(buf + w) = 125
            w = w + 1
            i = i + 2
        else if c == 123 and interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i) >= 0
            let close: i32 = interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i)
            if w > start
                emit_interp_bytes(s, fd, k, StrView { ptr: (buf + start), len: (w - start) as i64 })
            start = w
            placeholders = placeholders + 1
            let ptext: *u8 = body + i + 1
            var plen: i32 = close - i - 1
            # AGAST #201: `{expr:spec}`. An unknown spec is refused; a valid
            # one too, until AGAST #202 prints it.
            let colon: i32 = interp_spec_colon(StrView { ptr: (ptext), len: (plen) as i64 })
            if colon >= 0
                emit_spec_error(s, lit, StrView { ptr: (ptext), len: (colon) as i64 }, StrView { ptr: (ptext + colon + 1), len: (plen - colon - 1) as i64 })
            else
                let e: *Expr = fmt_parse(s, StrView { ptr: (ptext), len: (plen) as i64 }, lit.span.line, lit.span.col)
                if e == null
                    emit_print_error(s, lit, c"invalid interpolation expression: a `{...}` placeholder must hold exactly one expression (write `{{` for a literal brace)")
                else
                    fmt_push_value(s, k, lit, e)
            i = close + 1
        else
            *(buf + w) = c as u8
            w = w + 1
            i = i + 1

    if placeholders == 0 and k == null
        return emit_print_bytes(s, fd, StrView { ptr: (buf), len: (w) as i64 })
    if w > start
        emit_interp_bytes(s, fd, k, StrView { ptr: (buf + start), len: (w - start) as i64 })
    emit_print_zero(s)

# The helpers the print paths call. Emitted once, after the functions, by a
# module that used any of them.
pub fn emit_print_helpers(s: *EmitterState)
    if s.print_helpers_used == 0 and g_fmt_writer_used == 0
        return
    emit_str(s, c"\n; print interpolation helpers (AGAST #1521, #4381), as ritz0's _emit_print_value\n")
    # A StrView's bytes: one write of exactly len bytes (#1641).
    emit_str(s, c"define internal void @__ritz_print_bytes(i64 %fd, i64 %p, i64 %n)")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    # NUL-terminated bytes at a pointer: strlen, then one write.
    emit_str(s, c"define internal void @__ritz_print_cstr(i64 %fd, i64 %p)")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %ptr = inttoptr i64 %p to ptr\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"scan:\n")
    emit_str(s, c"  %n = phi i64 [ 0, %entry ], [ %n1, %next ]\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %ptr, i64 %n\n")
    emit_str(s, c"  %c = load i8, ptr %cp\n")
    emit_str(s, c"  %nul = icmp eq i8 %c, 0\n")
    emit_str(s, c"  br i1 %nul, label %done, label %next\n")
    emit_str(s, c"next:\n")
    emit_str(s, c"  %n1 = add i64 %n, 1\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %p, i64 %n)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    # bool: `true` or `false`.
    emit_str(s, c"@.ritz_print_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_print_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    emit_str(s, c"define internal void @__ritz_print_bool(i64 %fd, i64 %b)")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %t = icmp ne i64 %b, 0\n")
    emit_str(s, c"  %ptr = select i1 %t, ptr @.ritz_print_true, ptr @.ritz_print_false\n")
    emit_str(s, c"  %len = select i1 %t, i64 4, i64 5\n")
    emit_str(s, c"  %pi = ptrtoint ptr %ptr to i64\n")
    emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %pi, i64 %len)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n")
    # The implicit print Writer's sink: the fd in `w.fd` (AGAST #4381).
    if g_fmt_writer_used == 1
        let st: *StructDef = find_struct(s, StrView { ptr: (FMT_WRITER_NAME), len: (FMT_WRITER_NAME_LEN) as i64 })
        if st != null
            let ifd: i32 = fmt_writer_field(st, StrView { ptr: (c"fd"), len: (2) as i64 })
            if ifd >= 0
                emit_str(s, c"define internal i64 @__ritz_fmt_fd_sink(ptr %w, i64 %data, i64 %len)")
                emit_no_red_zone_attr(s)
                emit_str(s, c" {\n")
                emit_str(s, c"entry:\n")
                emit_str(s, c"  %fp = getelementptr %Writer, ptr %w, i32 0, i32 ")
                emit_int(s, ifd as i64)
                emit_str(s, c"\n  %f = load i32, ptr %fp\n")
                emit_str(s, c"  %fd = sext i32 %f to i64\n")
                emit_str(s, c"  %r = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 %fd, i64 %data, i64 %len)\n")
                emit_str(s, c"  ret i64 %r\n")
                emit_str(s, c"}\n")

# =============================================================================
# assert (AGAST #1869; LANGUAGE_SPEC §17.1, §19.2)
#
# A failing assert writes to stderr and exits 1:
#
#     <file>:<line>: assertion failed[: <message> | : left OP right]
#       left:  <value>                      } cond is `a OP b` with integer,
#       right: <value>                      } bool or pointer operands
#       in helper <fn> at <file>:<line>     } in a [[test_helper]] fn
#
# byte for byte what ritz0's _emit_assert writes.  In a helper the first
# <file>:<line> is the call site the running [[test]] fn recorded in the
# @__ritz_assert_site_* globals (record_assert_site), or the assert's own
# location when none was recorded.

# __ritz_assert_val's `kind`; ritz0's _ASSERT_* use the same numbers.
const ASSERT_V_SIGNED: i32 = 0
const ASSERT_V_UNSIGNED: i32 = 1
const ASSERT_V_PTR: i32 = 2
const ASSERT_V_BOOL: i32 = 3

pub fn assert_fn_kind(f: *FnDef) -> i32
    if is_test_fn(f) == 1
        return ASSERT_FN_TEST
    if is_test_helper_fn(f) == 1
        return ASSERT_FN_HELPER
    ASSERT_FN_PLAIN

fn assert_cstr_len(t: *u8) -> i32
    var n: i32 = 0
    while *(t + n) != 0
        n += 1
    n

# The basename of the file being compiled: the location an assert reports.
fn assert_file_base(out_len: *i32) -> *u8
    let f: *u8 = emitter_source_file()
    if f == null
        *out_len = 1
        return c"?"
    var n: i32 = 0
    var start: i32 = 0
    while *(f + n) != 0
        if *(f + n) == 47
            start = n + 1
        n += 1
    *out_len = n - start
    f + start

fn assert_file_str(s: *EmitterState) -> i32
    if s.assert_file_str < 0
        var blen: i32 = 0
        let base: *u8 = assert_file_base(@blen)
        s.assert_file_str = add_string(s, StrView { ptr: (base), len: (blen) as i64 })
    s.assert_file_str

# write(2, data, len) for bytes known at compile time.
fn assert_write(s: *EmitterState, data_sv: StrView)
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    if len <= 0
        return
    let idx: i32 = add_string(s, StrView { ptr: (data), len: (len) as i64 })
    s.print_helpers_used = 1
    emit_str(s, c"  call void @__ritz_print_bytes(i64 2, i64 ptrtoint (ptr @.str.")
    emit_int(s, idx as i64)
    emit_str(s, c" to i64), i64 ")
    emit_int(s, len as i64)
    emit_str(s, IR_CLOSE)

fn assert_write_c(s: *EmitterState, text: *u8)
    assert_write(s, StrView { ptr: (text), len: (assert_cstr_len(text)) as i64 })

# The value in i64 register `reg` (or the constant `imm` when reg == 0).
fn assert_write_val(s: *EmitterState, reg: i32, imm: i64, kind: i32)
    s.assert_helpers_used = 1
    emit_str(s, c"  call void @__ritz_assert_val(i64 ")
    if reg != 0
        emit_reg(s, reg)
    else
        emit_int(s, imm)
    emit_str(s, IR_I64_SEP)
    emit_int(s, kind as i64)
    emit_str(s, IR_CLOSE)

fn assert_write_own_loc(s: *EmitterState, line: i32)
    var blen: i32 = 0
    let base: *u8 = assert_file_base(@blen)
    assert_write(s, StrView { ptr: (base), len: (blen) as i64 })
    assert_write_c(s, c":")
    assert_write_val(s, 0, line as i64, ASSERT_V_SIGNED)
    assert_write_c(s, c": ")

# How a failing assert prints an operand of type expr_slot_ty(e); -1: not.
fn assert_operand_kind(s: *EmitterState, e: *Expr) -> i32
    let t: i32 = expr_slot_ty(e)
    if t == TYPE_BOOL
        return ASSERT_V_BOOL
    if t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return ASSERT_V_PTR
    if ty_is_unsigned(t) == 1
        return ASSERT_V_UNSIGNED
    if ty_is_signed(t) == 1
        return ASSERT_V_SIGNED
    -1

# `f`'s source name: a generic instance `name$T...` without its suffix.
fn assert_fn_name_len(f: *FnDef) -> i32
    var n: i32 = 0
    while n < f.name_len and *(f.name + n) != 36
        n += 1
    n

fn assert_op_text(op: i32) -> *u8
    if op == OP_EQ
        return c"=="
    if op == OP_NE
        return c"!="
    if op == OP_LT
        return c"<"
    if op == OP_GT
        return c">"
    if op == OP_LE
        return c"<="
    c">="

# In a [[test]] fn, note the location of the call `e` before it is made.  A
# [[test_helper]] reached through it reports that location; helpers do not
# record, so through any depth of helpers the line stays the test's.
pub fn record_assert_site(s: *EmitterState, e: *Expr)
    if s.fn_assert_kind != ASSERT_FN_TEST
        return
    let idx: i32 = assert_file_str(s)
    var blen: i32 = 0
    assert_file_base(@blen)
    s.assert_site_used = 1
    emit_str(s, c"  store ptr @.str.")
    emit_int(s, idx as i64)
    emit_str(s, c", ptr @__ritz_assert_site_file\n")
    emit_str(s, c"  store i64 ")
    emit_int(s, blen as i64)
    emit_str(s, c", ptr @__ritz_assert_site_file_len\n")
    emit_str(s, c"  store i64 ")
    emit_int(s, e.span.line as i64)
    emit_str(s, c", ptr @__ritz_assert_site_line\n")

fn assert_placement_error(s: *EmitterState, stmt: *Stmt)
    emit_str(s, c"  ; ERROR: assert outside [[test]] / [[test_helper]]\n")
    diag_error_at(emitter_source_file(), stmt.span)
    eprints_cstr(c"assert is only allowed in [[test]] and [[test_helper]] functions, not in '")
    let f: *FnDef = emitter_current_fn()
    if f != null
        # `main` for an adapted main (#4018), else up to a generic's `$`.
        let shown: StrView = fn_display_name(f)
        var n: i32 = assert_fn_name_len(f)
        if shown.len < n as i64
            n = shown.len as i32
        eprint_bytes(StrView { ptr: (shown.ptr), len: (n) as i64 })
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1

pub fn emit_assert_stmt(s: *EmitterState, stmt: *Stmt)
    if s.fn_assert_kind == ASSERT_FN_PLAIN
        assert_placement_error(s, stmt)
        return
    let c: *Expr = stmt.if_cond
    # `a OP b`: emit_expr_binary records the two i64 operand registers its
    # compare reads, so the report shows exactly the compared values without
    # evaluating anything twice.
    var is_cmp: i32 = 0
    var lk: i32 = -1
    var rk: i32 = -1
    if c.kind == EXPR_BINARY and c.op >= OP_EQ and c.op <= OP_GE
        is_cmp = 1
        lk = assert_operand_kind(s, c.left)
        rk = assert_operand_kind(s, c.right)
        # A bool local is an i64 slot and `true` an int literal here, so
        # one side known to be bool makes both bool (the type rules say the
        # other is too) — interp_is_bool, as print interpolation decides.
        if interp_is_bool(s, c.left) == 1 or interp_is_bool(s, c.right) == 1
            lk = ASSERT_V_BOOL
            rk = ASSERT_V_BOOL
        s.assert_cap_expr = c
        s.assert_cap_ok = 0
    let a_cond: i32 = emit_expr(s, c)
    s.assert_cap_expr = null
    var show: i32 = 0
    if is_cmp == 1 and s.assert_cap_ok == 1 and lk >= 0 and rk >= 0
        show = 1
    let cap_l: i32 = s.assert_cap_l
    let cap_r: i32 = s.assert_cap_r
    # Narrowed to i1 for the `br`, as STMT_IF does (AGAST #1646).
    let a_cond_i1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, a_cond_i1)
    emit_str(s, c" = icmp ne i64 ")
    emit_reg(s, a_cond)
    emit_str(s, IR_COMMA_0)
    let a_ok: i32 = next_label(s)
    let a_fail: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, a_cond_i1)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, a_ok)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, a_fail)
    emit_str(s, IR_NL)
    begin_block(s, a_fail)

    if s.fn_assert_kind == ASSERT_FN_HELPER
        s.assert_site_used = 1
        let l_site: i32 = next_label(s)
        let l_own: i32 = next_label(s)
        let l_head: i32 = next_label(s)
        let line_r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, line_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_line\n")
        let has_r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, has_r)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, line_r)
        emit_str(s, c", 0\n  br i1 ")
        emit_reg(s, has_r)
        emit_str(s, IR_LABEL_SEP)
        emit_label(s, l_site)
        emit_str(s, IR_LABEL_SEP)
        emit_label(s, l_own)
        emit_str(s, IR_NL)
        begin_block(s, l_site)
        let fp_r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, fp_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_file\n")
        let fl_r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, fl_r)
        emit_str(s, c" = load i64, ptr @__ritz_assert_site_file_len\n")
        s.print_helpers_used = 1
        emit_str(s, c"  call void @__ritz_print_bytes(i64 2, i64 ")
        emit_reg(s, fp_r)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, fl_r)
        emit_str(s, IR_CLOSE)
        assert_write_c(s, c":")
        assert_write_val(s, line_r, 0, ASSERT_V_SIGNED)
        assert_write_c(s, c": ")
        emit_str(s, IR_BR)
        emit_label(s, l_head)
        emit_str(s, IR_NL)
        begin_block(s, l_own)
        assert_write_own_loc(s, stmt.span.line)
        emit_str(s, IR_BR)
        emit_label(s, l_head)
        emit_str(s, IR_NL)
        begin_block(s, l_head)
    else
        assert_write_own_loc(s, stmt.span.line)

    assert_write_c(s, c"assertion failed")
    if stmt.assert_msg != null and stmt.assert_msg_len > 0
        assert_write_c(s, c": ")
        assert_write(s, StrView { ptr: (stmt.assert_msg), len: (stmt.assert_msg_len) as i64 })
    else if show == 1
        assert_write_c(s, c": left ")
        assert_write_c(s, assert_op_text(c.op))
        assert_write_c(s, c" right")
    assert_write_c(s, c"\n")
    if show == 1
        assert_write_c(s, c"  left:  ")
        assert_write_val(s, cap_l, 0, lk)
        assert_write_c(s, c"\n  right: ")
        assert_write_val(s, cap_r, 0, rk)
        assert_write_c(s, c"\n")
    if s.fn_assert_kind == ASSERT_FN_HELPER
        assert_write_c(s, c"  in helper ")
        let hf: *FnDef = emitter_current_fn()
        if hf != null
            assert_write(s, StrView { ptr: (hf.name), len: (assert_fn_name_len(hf)) as i64 })
        assert_write_c(s, c" at ")
        var blen: i32 = 0
        let base: *u8 = assert_file_base(@blen)
        assert_write(s, StrView { ptr: (base), len: (blen) as i64 })
        assert_write_c(s, c":")
        assert_write_val(s, 0, stmt.span.line as i64, ASSERT_V_SIGNED)
        assert_write_c(s, c"\n")
    # syscall(60, 1): Linux _exit.  `unreachable` tells LLVM the fail block
    # has no successor.
    emit_str(s, c"  call i64 asm sideeffect \"syscall\", ")
    emit_str(s, c"\"=&{rax},{rax},{rdi},~{rcx},~{r11},~{memory}\"")
    emit_str(s, c"(i64 60, i64 1)\n")
    emit_str(s, c"  unreachable\n")
    begin_block(s, a_ok)

# The call-site globals (weak: one copy across every module of a test
# binary; ritz0 defines the same symbols) and @__ritz_assert_val, the value
# printer: ritz0's _get_assert_val_fn instruction for instruction.
pub fn emit_assert_helpers(s: *EmitterState)
    if s.assert_site_used == 1
        emit_str(s, c"\n; assert call-site globals (AGAST #1869)\n")
        emit_str(s, c"@__ritz_assert_site_file = weak global ptr null\n")
        emit_str(s, c"@__ritz_assert_site_file_len = weak global i64 0\n")
        emit_str(s, c"@__ritz_assert_site_line = weak global i64 0\n")
    if s.assert_helpers_used == 0
        return
    emit_str(s, c"\n; assert value printer (AGAST #1869): kind 0 signed, 1 unsigned, 2 0x-hex, 3 bool\n")
    emit_str(s, c"@.ritz_assert_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_assert_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    emit_str(s, c"define internal void @__ritz_assert_val(i64 %v, i64 %kind)")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %buf = alloca [24 x i8]\n")
    emit_str(s, c"  %end = getelementptr [24 x i8], ptr %buf, i64 0, i64 24\n")
    emit_str(s, c"  %isb = icmp eq i64 %kind, 3\n")
    emit_str(s, c"  br i1 %isb, label %bool, label %num\n")
    emit_str(s, c"bool:\n")
    emit_str(s, c"  %t = icmp ne i64 %v, 0\n")
    emit_str(s, c"  %bp = select i1 %t, ptr @.ritz_assert_true, ptr @.ritz_assert_false\n")
    emit_str(s, c"  %bl = select i1 %t, i64 4, i64 5\n")
    emit_str(s, c"  %bpi = ptrtoint ptr %bp to i64\n")
    emit_str(s, c"  %r0 = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %bpi, i64 %bl)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"num:\n")
    emit_str(s, c"  %iss = icmp eq i64 %kind, 0\n")
    emit_str(s, c"  %isn = icmp slt i64 %v, 0\n")
    emit_str(s, c"  %neg = and i1 %iss, %isn\n")
    emit_str(s, c"  %negv = sub i64 0, %v\n")
    emit_str(s, c"  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    emit_str(s, c"  %ish = icmp eq i64 %kind, 2\n")
    emit_str(s, c"  %base = select i1 %ish, i64 16, i64 10\n")
    emit_str(s, c"  br label %digit\n")
    emit_str(s, c"digit:\n")
    emit_str(s, c"  %p = phi ptr [ %end, %num ], [ %np, %digit ]\n")
    emit_str(s, c"  %val = phi i64 [ %mag, %num ], [ %q, %digit ]\n")
    emit_str(s, c"  %d = urem i64 %val, %base\n")
    emit_str(s, c"  %lo = icmp ult i64 %d, 10\n")
    emit_str(s, c"  %dc = add i64 %d, 48\n")
    emit_str(s, c"  %hc = add i64 %d, 87\n")
    emit_str(s, c"  %ch64 = select i1 %lo, i64 %dc, i64 %hc\n")
    emit_str(s, c"  %ch = trunc i64 %ch64 to i8\n")
    emit_str(s, c"  %np = getelementptr i8, ptr %p, i64 -1\n")
    emit_str(s, c"  store i8 %ch, ptr %np\n")
    emit_str(s, c"  %q = udiv i64 %val, %base\n")
    emit_str(s, c"  %more = icmp ne i64 %q, 0\n")
    emit_str(s, c"  br i1 %more, label %digit, label %done\n")
    # At most 20 digits + "0x" + "-" = 23 bytes: the unconditional stores
    # stay inside the 24-byte buffer.
    emit_str(s, c"done:\n")
    emit_str(s, c"  %xp = getelementptr i8, ptr %np, i64 -1\n")
    emit_str(s, c"  store i8 120, ptr %xp\n")
    emit_str(s, c"  %zp = getelementptr i8, ptr %np, i64 -2\n")
    emit_str(s, c"  store i8 48, ptr %zp\n")
    emit_str(s, c"  %p3 = select i1 %ish, ptr %zp, ptr %np\n")
    emit_str(s, c"  %mp = getelementptr i8, ptr %p3, i64 -1\n")
    emit_str(s, c"  store i8 45, ptr %mp\n")
    emit_str(s, c"  %p4 = select i1 %neg, ptr %mp, ptr %p3\n")
    emit_str(s, c"  %p4i = ptrtoint ptr %p4 to i64\n")
    emit_str(s, c"  %ei = ptrtoint ptr %end to i64\n")
    emit_str(s, c"  %len = sub i64 %ei, %p4i\n")
    emit_str(s, c"  %r1 = call i64 asm sideeffect \"syscall\", \"=&{rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %p4i, i64 %len)\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n")

# =============================================================================
# format_into(sink, "...") -- AGAST #1824
# =============================================================================
#
# The literal is split exactly as print's (emit_interp_literal), and every
# piece -- literal text or a formatted value -- is appended with one call to
# `sink.push_bytes(data: *u8, len: i64)`, resolved like a method call on the
# sink's struct: a UFCS helper (string_push_bytes, growbuf_push_bytes,
# vec_push_bytes$u8) or an impl method. ritz0's _emit_format_into is the
# oracle.
#
# A value is formatted into a stack buffer by @__ritz_fmt_int /
# @__ritz_fmt_strlen (emit_format_helpers), not print's write helpers. print
# shares the integer path (emit_fmt_int, AGAST #2128).

# Where format_into appends: the sink pointer and the push_bytes it names.
struct FmtSink
    recv: i32          # register holding the sink as a `ptr`
    callee: *u8        # IR name of push_bytes (no `@`)
    callee_len: i32
    fn_def: *FnDef     # its params (self, data, len) and return type

# Report a format_into error at `at`, naming `name` (may be null) before
# `msg`. Counts like emit_print_error.
fn fmt_error(s: *EmitterState, at: *Expr, name_sv: StrView, msg: *u8)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    emit_str(s, c"  ; ERROR: format_into\n")
    diag_error_at(emitter_source_file(), at.span)
    eprints_cstr(c"ritz1 cannot emit: format_into: ")
    if name != null
        eprints_cstr(c"type '")
        for i in 0..name_len
            eprint_char(*(name + i))
        eprints_cstr(c"' ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

fn fmt_is_ptr_type(t: i32) -> i32
    if t == TYPE_PTR or t == TYPE_REF or t == TYPE_MUT_REF
        return 1
    0

# The struct the sink expression points at, or null. The shapes
# arg_pointee_struct knows (`@x`, `@&x`, `@&a.b`, a `*T` local or param), a
# pointer-typed field (`st.out: *Vec<u8>`), and a call returning `*T`.
fn fmt_sink_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    let named: *u8 = arg_pointee_struct(s, e, out_len)
    if named != null
        return named
    *out_len = 0
    if e.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, e)
        if f != null and fmt_is_ptr_type(f.field_type) == 1 and f.field_type_name_len > 0
            *out_len = f.field_type_name_len
            return f.field_type_name
    else if e.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, e)
        if fd != null and fmt_is_ptr_type(fd.return_type) == 1 and fd.return_type_name_len > 0
            *out_len = fd.return_type_name_len
            return fd.return_type_name
    null

# Is the sink expression a struct value (not a pointer to one)?
fn fmt_sink_is_value(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if loc != null and loc.var_type == TYPE_STRUCT
            return 1
    var n: *u8 = null
    var l: i32 = 0
    resolve_expr_struct_name(s, e, @n, @l)
    if n != null
        return 1
    0

# The `ret` type push_bytes is called with.
fn fmt_emit_ret_type(s: *EmitterState, fd: *FnDef)
    let rt: i32 = fd.return_type
    if rt == TYPE_BOOL
        emit_str(s, c"i1")
    else if ty_int_bits(rt) == 32
        emit_str(s, c"i32")
    else if ty_int_bits(rt) == 16
        emit_str(s, c"i16")
    else if ty_int_bits(rt) == 8
        emit_str(s, c"i8")
    else if rt == TYPE_STRUCT and fd.return_type_name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
    else
        emit_str(s, c"i64")

# push_bytes(sink, data, len). `data` is a `ptr` register; the length is the
# register len_reg when it is > 0, else the constant len_imm.
fn fmt_push(s: *EmitterState, k: *FmtSink, data: i32, len_reg: i32, len_imm: i64)
    let p2: *Param = k.fn_def.params.next
    let p3: *Param = p2.next
    var d: i32 = data
    if p2.param_type != TYPE_MUT_REF
        # A `*u8` param is an i64 in ritz1's signatures.
        d = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, d)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, data)
        emit_str(s, IR_TO_I64)
    if k.fn_def.return_type == TYPE_VOID
        emit_str(s, c"  call void @")
    else
        let r: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, r)
        emit_str(s, IR_CALL)
        fmt_emit_ret_type(s, k.fn_def)
        emit_str(s, c" @")
    emit_name(s, StrView { ptr: (k.callee), len: (k.callee_len) as i64 })
    emit_str(s, c"(ptr ")
    emit_reg(s, k.recv)
    emit_str(s, IR_COMMA)
    emit_param_llvm_type(s, p2)
    emit_str(s, IR_SP)
    emit_reg(s, d)
    emit_str(s, IR_COMMA)
    emit_param_llvm_type(s, p3)
    emit_str(s, IR_SP)
    if len_reg > 0
        emit_reg(s, len_reg)
    else
        emit_int(s, len_imm)
    emit_str(s, IR_CLOSE)

# Append bytes known at compile time.
fn fmt_push_const(s: *EmitterState, k: *FmtSink, data_sv: StrView)
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    let str_idx: i32 = add_string(s, StrView { ptr: (data), len: (len) as i64 })
    let g: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, g)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, (len + 1) as i64)
    emit_str(s, c" x i8], ptr @.str.")
    emit_int(s, str_idx as i64)
    emit_str(s, c", i64 0, i64 0\n")
    fmt_push(s, k, g, 0, len as i64)

# Append the formatted value of placeholder `e`: as print's table, except
# that unsigned integers format unsigned. Returns 0 after reporting an
# error when `e` has no formatted form.
# Format the integer placeholder `e` (get_expr_type `ty`) into a stack
# buffer with @__ritz_fmt_int. Returns the ptr register of its decimal
# digits and stores their i64 length register in *out_len; -1 when `ty` is
# not an integer type. Signedness comes from the Ritz type: an unsigned
# value is zero-extended and divided unsigned (AGAST #2128). print, eprint
# and format_into all format integers here.
fn emit_fmt_int(s: *EmitterState, e: *Expr, ty: i32, out_len: *i32) -> i32
    var narrow: *u8 = null
    var is_int: i32 = 1
    var signed: i32 = 1
    if ty == TYPE_I64
        narrow = null
    else if ty == TYPE_U64
        signed = 0
    else if ty_int_bits(ty) == 32
        narrow = c"i32"
        signed = (ty == TYPE_I32) as i32
    else if ty_int_bits(ty) == 16
        narrow = c"i16"
        signed = (ty == TYPE_I16) as i32
    else if ty_int_bits(ty) == 8
        narrow = c"i8"
        signed = (ty == TYPE_I8) as i32
    else
        is_int = 0
    if is_int == 0
        return -1
    var v: i32 = emit_expr(s, e)
    if narrow != null
        # ritz1 holds a narrow int in an i64; rebuild it from its width.
        let t: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, t)
        emit_str(s, IR_TRUNC)
        emit_reg(s, v)
        emit_str(s, IR_TO_SP)
        emit_str(s, narrow)
        emit_str(s, IR_NL)
        let x: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, x)
        if signed == 1
            emit_str(s, c" = sext ")
        else
            emit_str(s, c" = zext ")
        emit_str(s, narrow)
        emit_str(s, IR_SP)
        emit_reg(s, t)
        emit_str(s, IR_TO_I64)
        v = x
    let buf: i32 = next_reg(s)
    entry_alloca_reg(s, buf, c"[24 x i8]", null)
    let start: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, start)
    emit_str(s, c" = call i64 @__ritz_fmt_int(ptr ")
    emit_reg(s, buf)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, v)
    if signed == 1
        emit_str(s, c", i1 1)\n")
    else
        emit_str(s, c", i1 0)\n")
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, buf)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, start)
    emit_str(s, IR_NL)
    let n: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, n)
    emit_str(s, c" = sub i64 20, ")
    emit_reg(s, start)
    emit_str(s, IR_NL)
    s.fmt_helpers_used = 1
    *out_len = n
    p

fn fmt_push_value(s: *EmitterState, k: *FmtSink, lit: *Expr, e: *Expr) -> i32
    var sv_name: *u8 = null
    var sv_len: i32 = 0
    let sv_kind: i32 = interp_strview_kind(s, e, @sv_name, @sv_len)
    if sv_kind != 0
        var v: i32 = emit_expr(s, e)
        if sv_kind == 2
            let p: i32 = i64_value_to_ptr(s, e, v)
            let agg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, agg)
            emit_str(s, IR_LOAD_NAMED)
            emit_name(s, StrView { ptr: (sv_name), len: (sv_len) as i64 })
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, p)
            emit_str(s, IR_NL)
            v = agg
        let ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ptr)
        emit_str(s, c" = extractvalue %")
        emit_name(s, StrView { ptr: (sv_name), len: (sv_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, v)
        emit_str(s, IR_COMMA_0)
        let len: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, len)
        emit_str(s, c" = extractvalue %")
        emit_name(s, StrView { ptr: (sv_name), len: (sv_len) as i64 })
        emit_str(s, IR_SP)
        emit_reg(s, v)
        emit_str(s, IR_COMMA_1)
        fmt_push(s, k, ptr, len, 0)
        return 1

    let ty: i32 = expr_slot_ty(e)
    if interp_is_bool(s, e) == 1
        let v: i32 = emit_expr(s, e)
        let b: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, b)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, v)
        emit_str(s, IR_COMMA_0)
        let p: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, p)
        emit_str(s, c" = select i1 ")
        emit_reg(s, b)
        emit_str(s, c", ptr @.ritz_fmt_true, ptr @.ritz_fmt_false\n")
        let n: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, n)
        emit_str(s, c" = select i1 ")
        emit_reg(s, b)
        emit_str(s, c", i64 4, i64 5\n")
        s.fmt_helpers_used = 1
        fmt_push(s, k, p, n, 0)
        return 1

    var n: i32 = 0
    let p: i32 = emit_fmt_int(s, e, ty, @n)
    if p >= 0
        fmt_push(s, k, p, n, 0)
        return 1

    if ty == TYPE_PTR or ty == TYPE_PTR_PTR or ty == TYPE_REF or ty == TYPE_MUT_REF
        let v: i32 = emit_expr(s, e)
        let sp: i32 = i64_value_to_ptr(s, e, v)
        let sn: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sn)
        emit_str(s, c" = call i64 @__ritz_fmt_strlen(ptr ")
        emit_reg(s, sp)
        emit_str(s, IR_CLOSE)
        s.fmt_helpers_used = 1
        fmt_push(s, k, sp, sn, 0)
        return 1

    fmt_error(s, lit, StrView { ptr: (null), len: (0) as i64 }, c"cannot format this value: only integers, bool, StrView and pointers have a formatted form")
    0

# Lower format_into(sink, <literal>). The sink is evaluated once, first.
pub fn emit_format_into(s: *EmitterState, e: *Expr) -> i32
    let sink: *Expr = e.args
    var lit: *Expr = null
    if sink != null
        lit = sink.next
    if lit == null or lit.next != null
        fmt_error(s, e, StrView { ptr: (null), len: (0) as i64 }, c"format_into(sink, \"...\") takes two arguments: a pointer to the buffer and a string literal")
        return emit_print_zero(s)
    if lit.kind != EXPR_STRING_LIT and lit.kind != EXPR_CSTRING_LIT
        fmt_error(s, e, StrView { ptr: (null), len: (0) as i64 }, c"format_into's second argument must be a string literal: its placeholders are resolved at compile time")
        return emit_print_zero(s)
    if fmt_sink_is_value(s, sink) == 1
        fmt_error(s, e, StrView { ptr: (null), len: (0) as i64 }, c"format_into's sink must be a pointer to the buffer (`@&buf`), not a value: appending to a copy would be lost")
        return emit_print_zero(s)
    var tn_len: i32 = 0
    let tn: *u8 = fmt_sink_struct(s, sink, @tn_len)
    if tn == null
        fmt_error(s, e, StrView { ptr: (null), len: (0) as i64 }, c"the sink is not a pointer to a struct with a push_bytes(data: *u8, len: i64) method to append through")
        return emit_print_zero(s)

    # push_bytes, in emit_expr_method's order: a specialised generic impl
    # method (`Vec$u8_push_bytes`, a free fn of the module since monomorph),
    # else a non-generic impl's (whose IR name is `Type_push_bytes`). Not a
    # free `vec_push_bytes`: the UFCS table went with LARB R66 (#3497).
    var callee: *u8 = null
    var callee_len: i32 = 0
    var fd: *FnDef = find_spec_impl_method(s, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"push_bytes"), len: (10) as i64 })
    if fd != null
        callee = fd.name
        callee_len = fd.name_len
        add_extern(s, StrView { ptr: (fd.name), len: (fd.name_len) as i64 })
    else
        fd = find_impl_method(s, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"push_bytes"), len: (10) as i64 })
        if fd != null
            callee_len = tn_len + 11
            callee = malloc((callee_len + 1) as i64)
            for i in 0..tn_len
                *(callee + i) = *(tn + i)
            *(callee + tn_len) = '_'
            for i in 0..10
                *(callee + tn_len + 1 + i) = *(c"push_bytes" + i)
            *(callee + callee_len) = 0
            if fd.is_local == 0
                add_method_extern(s, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"push_bytes"), len: (10) as i64 })
    if fd == null
        fmt_error(s, e, StrView { ptr: (tn), len: (tn_len) as i64 }, c"has no push_bytes(data: *u8, len: i64) method to append through")
        return emit_print_zero(s)
    var np: i32 = 0
    var pp: *Param = fd.params
    while pp != null
        np = np + 1
        pp = pp.next
    if np != 3 or fd.params.next.next.param_type != TYPE_I64
        fmt_error(s, e, StrView { ptr: (tn), len: (tn_len) as i64 }, c"push_bytes must take (self, data: *u8, len: i64) to be a format_into sink")
        return emit_print_zero(s)

    let v: i32 = emit_expr(s, sink)
    var k: FmtSink
    k.recv = i64_value_to_ptr(s, sink, v)
    k.callee = callee
    k.callee_len = callee_len
    k.fn_def = fd
    emit_interp_literal(s, 0, @k, lit)

# The helpers fmt_push_value calls. Emitted once, after the functions, by a
# module that used any of them; ritz0's _format_int_helper /
# _format_strlen_helper define the same functions. "no-builtins" keeps
# clang from turning the strlen loop into a libc call.
pub fn emit_format_helpers(s: *EmitterState)
    if s.fmt_helpers_used == 0
        return
    emit_str(s, c"\n; format_into helpers (AGAST #1824), as ritz0's _format_int_helper\n")
    # Decimal digits back to front, ending at buf[20]; returns the first
    # byte's index. A negative signed value's magnitude 0 - v is right read
    # unsigned even for i64::MIN; unsigned values divide unsigned.
    emit_str(s, c"define internal i64 @__ritz_fmt_int(ptr %buf, i64 %v, i1 %signed) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %lt = icmp slt i64 %v, 0\n")
    emit_str(s, c"  %neg = and i1 %signed, %lt\n")
    emit_str(s, c"  %negv = sub i64 0, %v\n")
    emit_str(s, c"  %mag = select i1 %neg, i64 %negv, i64 %v\n")
    emit_str(s, c"  br label %digit\n")
    emit_str(s, c"digit:\n")
    emit_str(s, c"  %pos = phi i64 [ 20, %entry ], [ %np, %digit ]\n")
    emit_str(s, c"  %val = phi i64 [ %mag, %entry ], [ %q, %digit ]\n")
    emit_str(s, c"  %np = sub i64 %pos, 1\n")
    emit_str(s, c"  %d = urem i64 %val, 10\n")
    emit_str(s, c"  %ch64 = add i64 %d, 48\n")
    emit_str(s, c"  %ch = trunc i64 %ch64 to i8\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %buf, i64 %np\n")
    emit_str(s, c"  store i8 %ch, ptr %cp\n")
    emit_str(s, c"  %q = udiv i64 %val, 10\n")
    emit_str(s, c"  %more = icmp ne i64 %q, 0\n")
    emit_str(s, c"  br i1 %more, label %digit, label %sign\n")
    emit_str(s, c"sign:\n")
    emit_str(s, c"  br i1 %neg, label %minus, label %done\n")
    emit_str(s, c"minus:\n")
    emit_str(s, c"  %mp = sub i64 %np, 1\n")
    emit_str(s, c"  %mcp = getelementptr i8, ptr %buf, i64 %mp\n")
    emit_str(s, c"  store i8 45, ptr %mcp\n")
    emit_str(s, c"  br label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  %start = phi i64 [ %np, %sign ], [ %mp, %minus ]\n")
    emit_str(s, c"  ret i64 %start\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"define internal i64 @__ritz_fmt_strlen(ptr %p) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  br label %scan\n")
    emit_str(s, c"scan:\n")
    emit_str(s, c"  %n = phi i64 [ 0, %entry ], [ %n1, %scan ]\n")
    emit_str(s, c"  %cp = getelementptr i8, ptr %p, i64 %n\n")
    emit_str(s, c"  %c = load i8, ptr %cp\n")
    emit_str(s, c"  %n1 = add i64 %n, 1\n")
    emit_str(s, c"  %nul = icmp eq i8 %c, 0\n")
    emit_str(s, c"  br i1 %nul, label %done, label %scan\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret i64 %n\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"@.ritz_fmt_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    emit_str(s, c"@.ritz_fmt_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
