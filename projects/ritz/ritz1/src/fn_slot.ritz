# ritz1/src/fn_slot.ritz - a fn value fits the fn-typed slot it lands in (AGAST #4310)
#
#     fn f(a:& [2]i32) -> i32
#         return a[1]
#
#     let h: fn(@[3]i32) -> i32 = f    # error: cannot initialize
#                                      # fn(@[3]i32) -> i32 with fn([2]i32) -> i32
#
# ritz0's typing pass refuses a fn value whose signature doesn't fit its slot
# (type_queries._types_compatible's FnType branch; #4278 made arrays reached
# through the params agree, _arrays_agree).  ritz1 compared no fn value with
# its slot: an arity mismatch, a value param in a reference slot and the array
# above (which reads a `[3]i32` as a `[2]i32`) all compiled.  The shared table
# is ritz0/test_type_errors_after_emit.py's FN_SLOT_REFUSED / FN_SLOT_ACCEPTED.
#
# THE RULE, as ritz0's: the same number of params; each param fits its slot's
# (`_types_compatible`, and arrays through matching `*` / `@` layers of the
# same length and element type), or is a `name:& T` whose slot is a `@T` /
# `@&T` / `*T` with T fitting; and the return fits.  `_types_compatible`'s
# leniencies are kept, so nothing ritz0 accepts is refused: integers of any
# width fit each other, f32 fits f64, `void` fits anything, a pointer fits an
# i64 / u64 and the other way, any pointer fits a `*u8` and a `*u8` any
# pointer, `*` and `@` fit each other.  A StrView / Span / Future slot, whose
# views ritz0 rules elsewhere, is taken as fitting.
#
# WHERE, in ritz0's words and at ritz0's place (sema_walk hooks each):
#   let / var with a type  "cannot initialize S with V", at the statement
#   assignment             "cannot assign V to S", at the statement
#   argument of a fn call  "argument N ('p'): expected S, got V", at the argument
#   struct literal field   "field 'h': expected S, got V", at the value
#   return                 "return type V doesn't match expected S", at `return`
#   a fn's tail value      "block expression has type V, expected S", at it
# ritz0 judges no method's argument, so neither does this.
#
# SILENT WHEN UNSURE.  Both signatures are decoded off the AST's Param /
# FnDef fields into an FsTy; a part the decoder can't spell as ritz0 spells it
# (a generic fn, a type alias, a mangled generic instance, an N-D array) leaves
# the value unjudged, so a gap here is a missed refusal, never a refused
# program ritz0 accepts.  A global's fn signature is kept on its GlobalVarDef
# and a fn type's `-> *T` / `-> @T` / `-> [N]T` return on its FnDef (#4324).

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.memory

import ast
import types           # ty_name
import diag            # the error prefix
import ast_helpers     # ptr_ptr_slot_*, primitive_type_from_name, type_alias_target_spelling
import ast_query       # name_eq, eprint_bytes, find_field_index, get_field_type
import sema
import sema_type
import bool_check      # sbk_global, sbk_value_fn_sig, sbk_member_field
import ritzlib.strview

# A `fn(..) -> T` base; no TYPE_* is this.
const FS_MAX: i32 = 4

# A type as ritz0 spells and judges it: `n` pointer / reference levels
# (outermost first, each a TypeKind.Ptr / TypeKind.Ref / TypeKind.MutRef) over a base, a
# primitive TYPE_* (TypeKind.Void for none), a TypeKind.Struct `name`, a TypeKind.Array
# of `size` `elem`s, or an TypeKind.FnSig `sig`.  `lent` is a `name:& T` param, whose
# borrow level is not among the levels (ritz0 types the param as T).  `ok` is
# 0 when some part couldn't be decoded.
struct FsTy
    ok: i32
    n: i32
    lv: [4]TypeKind
    base: TypeKind
    name: StrView
    size: i32
    elem: *FsTy
    sig: *FnDef
    lent: i32

fn fs_clear(t: *FsTy)
    t.ok = 1
    t.n = 0
    t.base = TypeKind.Void
    t.name = strview_empty()
    t.size = 0
    t.elem = null
    t.sig = null
    t.lent = 0

fn fs_new() -> *FsTy
    let t: *FsTy = malloc(sizeof(FsTy)) as *FsTy
    fs_clear(t)
    t

fn fs_prim(k: TypeKind) -> i32
    (fs_int(k) == 1 or k == TypeKind.Bool or ty_is_float(k) == 1) as i32

fn fs_int(k: TypeKind) -> i32
    (ty_int_bits(k) != 0) as i32

# An i64 / u64, which a pointer fits and which fits a pointer.
fn fs_word(k: TypeKind) -> i32
    (ty_int_bits(k) == 64) as i32

fn fs_push(t: *FsTy, k: TypeKind)
    if t.n >= FS_MAX
        t.ok = 0
        return
    t.lv[t.n] = k
    t.n = t.n + 1

# A struct name ritz0 spells the same: not a mangled generic instance
# (`Box$u8`), and not an alias, which ritz0 resolves first.
fn fs_name_ok(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    var i: i32 = 0
    while i < len
        if *(name + i) == '$'   # '$'
            return 0
        i = i + 1
    if type_alias_target_spelling(ctx, name_sv).ptr != null
        return 0
    1

# The base `kind` (a primitive, or a struct `name`).
fn fs_base(ctx: *ParseCtx, t: *FsTy, kind: TypeKind, name_sv: StrView)
    if fs_prim(kind) == 1
        t.base = kind
    else if kind == TypeKind.Struct and fs_name_ok(ctx, name_sv) == 1
        t.base = TypeKind.Struct
        t.name = name_sv
    else
        t.ok = 0

# A 1-D `[size]E`, E a primitive or struct (`name`), or a `*U` (`elem_pointee`).
fn fs_array(ctx: *ParseCtx, t: *FsTy, size: i32, elem_kind: TypeKind, name_sv: StrView, elem_pointee: TypeKind, shape: *ArrayShape)
    if shape != null or size <= 0
        t.ok = 0
        return
    t.base = TypeKind.Array
    t.size = size
    let el: *FsTy = fs_new()
    if elem_kind == TypeKind.Ptr
        fs_push(el, TypeKind.Ptr)
        fs_base(ctx, el, elem_pointee, name_sv)
    else
        fs_base(ctx, el, elem_kind, name_sv)
    t.elem = el
    if el.ok == 0
        t.ok = 0

# What a one-level pointer / reference param `p` of kind `k` points at.
fn fs_pointee(ctx: *ParseCtx, t: *FsTy, p: *Param, k: TypeKind)
    let pt: TypeKind = p.param_pointee_type
    if pt == TypeKind.Array
        fs_array(ctx, t, p.param_pointee_array_size, p.param_pointee_array_elem_type, p.param_type_name, p.param_pointee_array_elem_pointee, p.param_pointee_array_shape)
    else if pt == TypeKind.Ptr and k != TypeKind.Ptr
        # `@*U` / `@&*U` / `:& *U`; `@@U` is held as an `@*U` (INNER_REF_*)
        var lk: TypeKind = TypeKind.Ptr
        if p.is_borrow == 0 and p.param_inner_ref == INNER_REF_SHARED
            lk = TypeKind.Ref
        else if p.is_borrow == 0 and p.param_inner_ref == INNER_REF_MUT
            lk = TypeKind.MutRef
        fs_push(t, lk)
        fs_base(ctx, t, p.param_ref_ptr_pointee, p.param_type_name)
    else
        fs_base(ctx, t, pt, p.param_type_name)

# The type param `p` declares.
fn fs_param(ctx: *ParseCtx, p: *Param, t: *FsTy)
    fs_clear(t)
    let k: TypeKind = p.param_type
    if fs_prim(k) == 1 or k == TypeKind.Struct
        fs_base(ctx, t, k, p.param_type_name)
    else if k == TypeKind.Array
        fs_array(ctx, t, p.param_array_size, p.param_array_elem_type, p.param_type_name, p.param_array_elem_pointee, p.param_array_shape)
    else if k == TypeKind.Ptr and p.fn_sig != null
        t.base = TypeKind.FnSig
        t.sig = p.fn_sig
    else
        match k
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                fs_push(t, k)
                fs_pointee(ctx, t, p, k)
            TypeKind.PtrPtr =>
                let slot: i32 = p.param_inner_pointee_type
                let levels: i32 = ptr_ptr_slot_levels(slot)
                if levels < 2
                    t.ok = 0
                    return
                var i: i32 = 0
                while i < levels
                    fs_push(t, TypeKind.Ptr)
                    i = i + 1
                fs_base(ctx, t, ptr_ptr_slot_inner(slot), p.param_type_name)
            _ =>
                t.ok = 0
    if p.is_borrow == 1 or p.is_self_borrow == 1
        # `name:& T` is T to ritz0, with its own fit into a `@T` slot.
        if t.n == 0
            t.ok = 0
            return
        var j: i32 = 1
        while j < t.n
            t.lv[j - 1] = t.lv[j]
            j = j + 1
        t.n = t.n - 1
        t.lent = 1

# The type `fd` returns.
fn fs_ret(sm: *Sema, fd: *FnDef, t: *FsTy)
    fs_clear(t)
    let rt: TypeKind = fd.return_type
    if fd.ret_fn_sig != null
        t.base = TypeKind.FnSig
        t.sig = fd.ret_fn_sig
    else if fd.ret_ref != null
        fs_param(sm.pctx, fd.ret_ref, t)
    else if fd.ret_ptr_array != null
        fs_param(sm.pctx, fd.ret_ptr_array, t)
    else if fd.ret_array_param != null
        fs_param(sm.pctx, fd.ret_array_param, t)
    else
        match rt
            TypeKind.Void =>
                t.base = TypeKind.Void
            TypeKind.Ptr =>
                # A `-> *T` return names T on return_type_name (#1984); a fn type's
                # does too since #4324.
                fs_push(t, TypeKind.Ptr)
                let pt: TypeKind = primitive_type_from_name(fd.return_type_name)
                if pt != TypeKind.Void
                    t.base = pt
                else if sema_find_struct(sm, fd.return_type_name) != null
                    fs_base(sm.pctx, t, TypeKind.Struct, fd.return_type_name)
                else
                    t.ok = 0
            _ =>
                fs_base(sm.pctx, t, rt, fd.return_type_name)

# 1 when every part of `t` decoded, nested signatures too.
fn fs_ok(sm: *Sema, t: *FsTy) -> i32
    if t.ok == 0
        return 0
    match t.base
        TypeKind.FnSig =>
            return fs_sig_ok(sm, t.sig)
        TypeKind.Array =>
            return fs_ok(sm, t.elem)
        _ => pass
    1

# 1 when `fd`'s whole signature decodes: it can be judged and spelled.
fn fs_sig_ok(sm: *Sema, fd: *FnDef) -> i32
    if fd == null or fd.type_params != null
        return 0
    var p: *Param = fd.params
    while p != null
        var t: FsTy
        fs_param(sm.pctx, p, @t)
        if fs_ok(sm, @t) == 0
            return 0
        p = p.next
    var r: FsTy
    fs_ret(sm, fd, @r)
    fs_ok(sm, @r)

# ---- The judgement: ritz0's _types_compatible / _arrays_agree ----

# A struct whose fits ritz0 rules elsewhere (a view, a future): taken as fitting.
fn fs_view_name(t: *FsTy) -> i32
    if t.base != TypeKind.Struct
        return 0
    if name_eq(t.name, "StrView") == 1 or name_eq(t.name, "Future") == 1
        return 1
    if t.name.starts_with("Span")
        return 1
    t.name.ends_with("$Future") as i32

# `a` from level `ai` is a `*u8` exactly.
fn fs_is_byte_ptr(a: *FsTy, ai: i32) -> i32
    (a.n - ai == 1 and a.lv[ai] == TypeKind.Ptr and a.base == TypeKind.U8) as i32

# Does `a` (from its level `ai`) fit where `e` (from `ei`) is wanted?
fn fs_compat(sm: *Sema, a: *FsTy, ai: i32, e: *FsTy, ei: i32) -> i32
    let an: i32 = a.n - ai
    let en: i32 = e.n - ei
    if fs_view_name(a) == 1 or fs_view_name(e) == 1
        return 1
    if an > 0 and en == 0
        if fs_word(e.base) == 1
            return 1
        return (e.base == TypeKind.FnSig and fs_is_byte_ptr(a, ai) == 1) as i32
    if an == 0 and en > 0
        return fs_word(a.base)
    if an > 0 and en > 0
        if fs_is_byte_ptr(e, ei) == 1
            return 1
        if fs_is_byte_ptr(a, ai) == 1 and e.lv[ei] == TypeKind.Ptr
            return 1
        return fs_compat(sm, a, ai + 1, e, ei + 1)
    # Both bases, no levels left.
    if a.base == TypeKind.FnSig or e.base == TypeKind.FnSig
        if a.base == TypeKind.FnSig and e.base == TypeKind.FnSig
            return fs_sig_fits(sm, a.sig, e.sig)
        return 0
    if a.base == TypeKind.Array or e.base == TypeKind.Array
        if a.base == TypeKind.Array and e.base == TypeKind.Array
            return fs_compat(sm, a.elem, 0, e.elem, 0)
        return 0
    if a.base == TypeKind.Void or e.base == TypeKind.Void
        return 1
    if a.base == TypeKind.Struct or e.base == TypeKind.Struct
        if a.base == TypeKind.Struct and e.base == TypeKind.Struct
            return name_eq(a.name, e.name)
        return 0
    if a.base == e.base
        return 1
    if fs_int(a.base) == 1 and fs_int(e.base) == 1
        return 1
    (a.base == TypeKind.F32 and e.base == TypeKind.F64) as i32

# Arrays reached through matching levels have the same length and element.
fn fs_agree(a: *FsTy, ai: i32, e: *FsTy, ei: i32) -> i32
    var i: i32 = ai
    var j: i32 = ei
    while i < a.n and j < e.n
        i = i + 1
        j = j + 1
    if i < a.n or j < e.n or a.base != TypeKind.Array or e.base != TypeKind.Array
        return 1
    if a.size != e.size
        return 0
    let x: *FsTy = a.elem
    let y: *FsTy = e.elem
    if x.n == 0 and y.n == 0 and x.base != TypeKind.Array and y.base != TypeKind.Array and x.base != TypeKind.FnSig and y.base != TypeKind.FnSig
        if x.base == TypeKind.Struct or y.base == TypeKind.Struct
            return (x.base == y.base and name_eq(x.name, y.name) == 1) as i32
        return (x.base == y.base) as i32
    fs_agree(x, 0, y, 0)

# Does fn `a` fit a slot of fn type `e`?  Both decode (fs_sig_ok).
fn fs_sig_fits(sm: *Sema, a: *FnDef, e: *FnDef) -> i32
    var pa: *Param = a.params
    var pe: *Param = e.params
    while pa != null and pe != null
        var x: FsTy
        var y: FsTy
        fs_param(sm.pctx, pa, @x)
        fs_param(sm.pctx, pe, @y)
        var fits: i32 = (fs_compat(sm, @x, 0, @y, 0) == 1 and fs_agree(@x, 0, @y, 0) == 1) as i32
        # A `name:& T` param is physically a `*T` (AGAST #3034).
        if fits == 0 and x.lent == 1 and y.n > 0
            fits = (fs_compat(sm, @x, 0, @y, 1) == 1 and fs_agree(@x, 0, @y, 1) == 1) as i32
        if fits == 0
            return 0
        pa = pa.next
        pe = pe.next
    if pa != null or pe != null
        return 0
    var ra: FsTy
    var re: FsTy
    fs_ret(sm, a, @ra)
    fs_ret(sm, e, @re)
    fs_compat(sm, @ra, 0, @re, 0)

# ---- Spelling, as ritz0's str(Type) ----

fn fs_print(sm: *Sema, t: *FsTy)
    var i: i32 = 0
    while i < t.n
        let k: TypeKind = t.lv[i]
        match k
            TypeKind.Ptr =>
                eprints("*")
            TypeKind.Ref =>
                eprints("@")
            _ =>
                eprints("@&")
        i = i + 1
    match t.base
        TypeKind.FnSig =>
            fs_print_sig(sm, t.sig)
        TypeKind.Array =>
            eprint("[{t.size as i64}]")
            fs_print(sm, t.elem)
        TypeKind.Struct =>
            eprint_bytes(t.name)
        TypeKind.Void =>
            eprints("void")
        _ =>
            eprints_cstr(ty_name(t.base))

fn fs_print_sig(sm: *Sema, fd: *FnDef)
    eprints("fn(")
    var p: *Param = fd.params
    while p != null
        var t: FsTy
        fs_param(sm.pctx, p, @t)
        fs_print(sm, @t)
        if p.next != null
            eprints(", ")
        p = p.next
    eprints(") -> ")
    var r: FsTy
    fs_ret(sm, fd, @r)
    fs_print(sm, @r)

# ---- The value, the slot, the report ----

# The signature of fn value `v`: a local's, a top-level fn's, a field's, a
# call's return, a cast's; null when it is none (or Sema can't say).
fn fs_value_sig(sm: *Sema, v: *Expr) -> *FnDef
    if v == null
        return null
    if v.kind == ExprKind.Ident
        let lv: *SemaVar = sema_find_local(sm, v.ident)
        if lv != null
            return lv.fn_sig
        let g: *GlobalVarDef = sbk_global(sm, v.ident)
        if g != null
            return g.fn_sig   # AGAST #4324: a fn-typed global's signature
        return sema_find_fn(sm, v.ident)
    sbk_value_fn_sig(sm, v)

# The signature of `v` when it is a fn value that doesn't fit slot `slot`
# (both judged and spelled whole), else null.
fn fs_misfit(sm: *Sema, v: *Expr, slot: *FnDef) -> *FnDef
    if slot == null
        return null
    let sig: *FnDef = fs_value_sig(sm, v)
    if sig == null or sig == slot
        return null
    if fs_sig_ok(sm, sig) == 0 or fs_sig_ok(sm, slot) == 0
        return null
    if fs_sig_fits(sm, sig, slot) == 1
        return null
    sig

fn fs_report(sm: *Sema, line: i32, col: i32)
    diag_error_at(sema_file(sm), diag_span(line, col))
    sm.error_count = sm.error_count + 1

# `let h: fn(..) -> T = v` / `var`.
pub fn fn_slot_decl(sm: *Sema, st: *Stmt)
    if st.var_init == null or st.var_declared_type != TypeKind.Ptr
        return
    let sig: *FnDef = fs_misfit(sm, st.var_init, st.var_fn_sig)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints("cannot initialize ")
    fs_print_sig(sm, st.var_fn_sig)
    eprints(" with ")
    fs_print_sig(sm, sig)
    eprints("\n")

# The fn type of the place `target = ..` writes, or null.
fn fs_target_sig(sm: *Sema, st: *Stmt) -> *FnDef
    if st.kind == StmtKind.Assign
        if st.assign_target.len != 0
            let v: *SemaVar = sema_find_local(sm, st.assign_target)
            if v != null
                return v.fn_sig
            # AGAST #4324: a global's fn type is kept on its GlobalVarDef.
            let g: *GlobalVarDef = sbk_global(sm, st.assign_target)
            if g != null
                return g.fn_sig
            return null
        let target: *Expr = st.if_cond as *Expr
        if target != null and target.kind == ExprKind.Member
            let f: *StructField = sbk_member_field(sm, target)
            if f != null and f.field_type == TypeKind.Ptr
                return f.fn_sig
        return null
    if st.kind == StmtKind.LocalFieldAssign
        let v: *SemaVar = sema_find_local(sm, st.var_name)
        if v == null
            return null
        let sd: *StructDef = sema_find_struct(sm, v.type_name)
        if sd == null
            return null
        let idx: i32 = find_field_index(sd, st.assign_target)
        if idx < 0
            return null
        let f: *StructField = get_field_type(sd, idx)
        if f.field_type == TypeKind.Ptr
            return f.fn_sig
    null

# `target = v`.
pub fn fn_slot_assign(sm: *Sema, st: *Stmt)
    let slot: *FnDef = fs_target_sig(sm, st)
    let sig: *FnDef = fs_misfit(sm, st.assign_value, slot)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints("cannot assign ")
    fs_print_sig(sm, sig)
    eprints(" to ")
    fs_print_sig(sm, slot)
    eprints("\n")

# `f(.., v, ..)`, f a top-level fn.
pub fn fn_slot_call(sm: *Sema, e: *Expr)
    if e.func_name.len == 0 or e.call_type_suffix.len > 0
        return
    if sema_find_local(sm, e.func_name) != null
        return
    let fd: *FnDef = sema_find_fn(sm, e.func_name)
    if fd == null or fd.type_params != null
        return
    var p: *Param = fd.params
    var a: *Expr = e.args
    var n: i32 = 1
    while p != null and a != null
        if p.param_type == TypeKind.Ptr and p.fn_sig != null
            let sig: *FnDef = fs_misfit(sm, a, p.fn_sig)
            if sig != null
                fs_report(sm, a.span.line, a.span.col)
                eprint("argument {n as i64} ('")
                eprint_bytes(p.name)
                eprints("'): expected ")
                fs_print_sig(sm, p.fn_sig)
                eprints(", got ")
                fs_print_sig(sm, sig)
                eprints("\n")
        p = p.next
        a = a.next
        n = n + 1

# `S { h: v, .. }`.
pub fn fn_slot_struct_lit(sm: *Sema, e: *Expr)
    let sd: *StructDef = sema_find_struct(sm, e.ident)
    if sd == null or sd.type_params != null
        return
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let idx: i32 = find_field_index(sd, fi.name)
        if idx >= 0
            let f: *StructField = get_field_type(sd, idx)
            if f.field_type == TypeKind.Ptr and f.fn_sig != null
                let sig: *FnDef = fs_misfit(sm, fi.value, f.fn_sig)
                if sig != null
                    fs_report(sm, fi.value.span.line, fi.value.span.col)
                    eprints("field '")
                    eprint_bytes(fi.name)
                    eprints("': expected ")
                    fs_print_sig(sm, f.fn_sig)
                    eprints(", got ")
                    fs_print_sig(sm, sig)
                    eprints("\n")
        fi = fi.next

# `return v` in the fn being walked.
pub fn fn_slot_return(sm: *Sema, st: *Stmt)
    let f: *FnDef = sm.cur_fn
    if f == null or f.return_type != TypeKind.Ptr
        return
    let sig: *FnDef = fs_misfit(sm, st.return_value, f.ret_fn_sig)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints("return type ")
    fs_print_sig(sm, sig)
    eprints(" doesn't match expected ")
    fs_print_sig(sm, f.ret_fn_sig)
    eprints("\n")

# `st`, the last statement of the fn being walked, is its value.
pub fn fn_slot_tail(sm: *Sema, st: *Stmt)
    let f: *FnDef = sm.cur_fn
    if f == null or f.return_type != TypeKind.Ptr or st.kind != StmtKind.Expr
        return
    let sig: *FnDef = fs_misfit(sm, st.expr, f.ret_fn_sig)
    if sig == null
        return
    fs_report(sm, st.expr.span.line, st.expr.span.col)
    eprints("block expression has type ")
    fs_print_sig(sm, sig)
    eprints(", expected ")
    fs_print_sig(sm, f.ret_fn_sig)
    eprints("\n")
