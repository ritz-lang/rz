# ritz1/src/fn_slot.ritz - a fn value fits the fn-typed slot it lands in (AGAST #4310)
#
#     fn f(a:& [2]i32) -> i32
#         return a[1]
#
#     let h: fn(@[3]i32) -> i32 = f    # error: cannot initialize
#                                      # fn(@[3]i32) -> i32 with fn([2]i32) -> i32
#
# ritz0's typing pass refuses a fn value whose signature doesn't fit its slot
# (type_queries._types_compatible's FnType branch; #4278 made arrays reached
# through the params agree, _arrays_agree).  ritz1 compared no fn value with
# its slot: an arity mismatch, a value param in a reference slot and the array
# above (which reads a `[3]i32` as a `[2]i32`) all compiled.  The shared table
# is ritz0/test_type_errors_after_emit.py's FN_SLOT_REFUSED / FN_SLOT_ACCEPTED.
#
# THE RULE, as ritz0's: the same number of params; each param fits its slot's
# (`_types_compatible`, and arrays through matching `*` / `@` layers of the
# same length and element type), or is a `name:& T` whose slot is a `@T` /
# `@&T` / `*T` with T fitting; and the return fits.  `_types_compatible`'s
# leniencies are kept, so nothing ritz0 accepts is refused: integers of any
# width fit each other, f32 fits f64, `void` fits anything, a pointer fits an
# i64 / u64 and the other way, any pointer fits a `*u8` and a `*u8` any
# pointer, `*` and `@` fit each other.  A StrView / Span / Future slot, whose
# views ritz0 rules elsewhere, is taken as fitting.
#
# WHERE, in ritz0's words and at ritz0's place (sema_walk hooks each):
#   let / var with a type  "cannot initialize S with V", at the statement
#   assignment             "cannot assign V to S", at the statement
#   argument of a fn call  "argument N ('p'): expected S, got V", at the argument
#   struct literal field   "field 'h': expected S, got V", at the value
#   return                 "return type V doesn't match expected S", at `return`
#   a fn's tail value      "block expression has type V, expected S", at it
# ritz0 judges no method's argument, so neither does this.
#
# SILENT WHEN UNSURE.  Both signatures are decoded off the AST's Param /
# FnDef fields into an FsTy; a part the decoder can't spell as ritz0 spells it
# (a generic fn, a type alias, a mangled generic instance, an N-D array) leaves
# the value unjudged, so a gap here is a missed refusal, never a refused
# program ritz0 accepts.  A global's fn signature is kept on its GlobalVarDef
# and a fn type's `-> *T` / `-> @T` / `-> [N]T` return on its FnDef (#4324).

import ritzlib.sys
import ritzlib.io
import ritzlib.memory

import ast
import types           # ty_name
import diag            # the error prefix
import ast_helpers     # ptr_ptr_slot_*, primitive_type_from_name, type_alias_target_spelling
import ast_query       # name_eq, eprint_bytes, find_field_index, get_field_type
import sema
import sema_type
import bool_check      # sbk_global, sbk_value_fn_sig, sbk_member_field

# A `fn(..) -> T` base; no TYPE_* is this.
const FS_FN: i32 = 9001
const FS_MAX: i32 = 4

# A type as ritz0 spells and judges it: `n` pointer / reference levels
# (outermost first, each a TYPE_PTR / TYPE_REF / TYPE_MUT_REF) over a base, a
# primitive TYPE_* (TYPE_VOID for none), a TYPE_STRUCT `name`, a TYPE_ARRAY
# of `size` `elem`s, or an FS_FN `sig`.  `lent` is a `name:& T` param, whose
# borrow level is not among the levels (ritz0 types the param as T).  `ok` is
# 0 when some part couldn't be decoded.
struct FsTy
    ok: i32
    n: i32
    lv: [4]i32
    base: i32
    name: *u8
    name_len: i32
    size: i32
    elem: *FsTy
    sig: *FnDef
    lent: i32

fn fs_clear(t: *FsTy)
    t.ok = 1
    t.n = 0
    t.base = TYPE_VOID
    t.name = null
    t.name_len = 0
    t.size = 0
    t.elem = null
    t.sig = null
    t.lent = 0

fn fs_new() -> *FsTy
    let t: *FsTy = malloc(sizeof(FsTy)) as *FsTy
    fs_clear(t)
    t

fn fs_prim(k: i32) -> i32
    (fs_int(k) == 1 or k == TYPE_BOOL or ty_is_float(k) == 1) as i32

fn fs_int(k: i32) -> i32
    (ty_int_bits(k) != 0) as i32

# An i64 / u64, which a pointer fits and which fits a pointer.
fn fs_word(k: i32) -> i32
    (ty_int_bits(k) == 64) as i32

fn fs_push(t: *FsTy, k: i32)
    if t.n >= FS_MAX
        t.ok = 0
        return
    t.lv[t.n] = k
    t.n = t.n + 1

# A struct name ritz0 spells the same: not a mangled generic instance
# (`Box$u8`), and not an alias, which ritz0 resolves first.
fn fs_name_ok(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    var i: i32 = 0
    while i < len
        if *(name + i) == '$'   # '$'
            return 0
        i = i + 1
    var alias_len: i32 = 0
    if type_alias_target_spelling(StrView { ptr: (name), len: (len) as i64 }, @alias_len) != null
        return 0
    1

# The base `kind` (a primitive, or a struct `name`).
fn fs_base(t: *FsTy, kind: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if fs_prim(kind) == 1
        t.base = kind
    else if kind == TYPE_STRUCT and fs_name_ok(StrView { ptr: (name), len: (len) as i64 }) == 1
        t.base = TYPE_STRUCT
        t.name = name
        t.name_len = len
    else
        t.ok = 0

# A 1-D `[size]E`, E a primitive or struct (`name`), or a `*U` (`elem_pointee`).
fn fs_array(t: *FsTy, size: i32, elem_kind: i32, name_sv: StrView, elem_pointee: i32, shape: *ArrayShape)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if shape != null or size <= 0
        t.ok = 0
        return
    t.base = TYPE_ARRAY
    t.size = size
    let el: *FsTy = fs_new()
    if elem_kind == TYPE_PTR
        fs_push(el, TYPE_PTR)
        fs_base(el, elem_pointee, StrView { ptr: (name), len: (len) as i64 })
    else
        fs_base(el, elem_kind, StrView { ptr: (name), len: (len) as i64 })
    t.elem = el
    if el.ok == 0
        t.ok = 0

# What a one-level pointer / reference param `p` of kind `k` points at.
fn fs_pointee(t: *FsTy, p: *Param, k: i32)
    let pt: i32 = p.param_pointee_type
    if pt == TYPE_ARRAY
        fs_array(t, p.param_pointee_array_size, p.param_pointee_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, p.param_pointee_array_elem_pointee, p.param_pointee_array_shape)
    else if pt == TYPE_PTR and k != TYPE_PTR
        # `@*U` / `@&*U` / `:& *U`; `@@U` is held as an `@*U` (INNER_REF_*)
        var lk: i32 = TYPE_PTR
        if p.is_borrow == 0 and p.param_inner_ref == INNER_REF_SHARED
            lk = TYPE_REF
        else if p.is_borrow == 0 and p.param_inner_ref == INNER_REF_MUT
            lk = TYPE_MUT_REF
        fs_push(t, lk)
        fs_base(t, p.param_ref_ptr_pointee, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else
        fs_base(t, pt, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })

# The type param `p` declares.
fn fs_param(p: *Param, t: *FsTy)
    fs_clear(t)
    let k: i32 = p.param_type
    if fs_prim(k) == 1 or k == TYPE_STRUCT
        fs_base(t, k, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else if k == TYPE_ARRAY
        fs_array(t, p.param_array_size, p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, p.param_array_elem_pointee, p.param_array_shape)
    else if k == TYPE_PTR and p.fn_sig != null
        t.base = FS_FN
        t.sig = p.fn_sig
    else if k == TYPE_PTR or k == TYPE_REF or k == TYPE_MUT_REF
        fs_push(t, k)
        fs_pointee(t, p, k)
    else if k == TYPE_PTR_PTR
        let slot: i32 = p.param_inner_pointee_type
        let levels: i32 = ptr_ptr_slot_levels(slot)
        if levels < 2
            t.ok = 0
            return
        var i: i32 = 0
        while i < levels
            fs_push(t, TYPE_PTR)
            i = i + 1
        fs_base(t, ptr_ptr_slot_inner(slot), StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    else
        t.ok = 0
    if p.is_borrow == 1 or p.is_self_borrow == 1
        # `name:& T` is T to ritz0, with its own fit into a `@T` slot.
        if t.n == 0
            t.ok = 0
            return
        var j: i32 = 1
        while j < t.n
            t.lv[j - 1] = t.lv[j]
            j = j + 1
        t.n = t.n - 1
        t.lent = 1

# The type `fd` returns.
fn fs_ret(sm: *Sema, fd: *FnDef, t: *FsTy)
    fs_clear(t)
    let rt: i32 = fd.return_type
    if fd.ret_fn_sig != null
        t.base = FS_FN
        t.sig = fd.ret_fn_sig
    else if fd.ret_ref != null
        fs_param(fd.ret_ref, t)
    else if fd.ret_ptr_array != null
        fs_param(fd.ret_ptr_array, t)
    else if fd.ret_array_param != null
        fs_param(fd.ret_array_param, t)
    else if rt == TYPE_VOID
        t.base = TYPE_VOID
    else if rt == TYPE_PTR
        # A `-> *T` return names T on return_type_name (#1984); a fn type's
        # does too since #4324.
        fs_push(t, TYPE_PTR)
        let pt: i32 = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
        if pt != 0
            t.base = pt
        else if sema_find_struct(sm, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }) != null
            fs_base(t, TYPE_STRUCT, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
        else
            t.ok = 0
    else
        fs_base(t, rt, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })

# 1 when every part of `t` decoded, nested signatures too.
fn fs_ok(sm: *Sema, t: *FsTy) -> i32
    if t.ok == 0
        return 0
    if t.base == FS_FN
        return fs_sig_ok(sm, t.sig)
    if t.base == TYPE_ARRAY
        return fs_ok(sm, t.elem)
    1

# 1 when `fd`'s whole signature decodes: it can be judged and spelled.
fn fs_sig_ok(sm: *Sema, fd: *FnDef) -> i32
    if fd == null or fd.type_params != null
        return 0
    var p: *Param = fd.params
    while p != null
        var t: FsTy
        fs_param(p, @t)
        if fs_ok(sm, @t) == 0
            return 0
        p = p.next
    var r: FsTy
    fs_ret(sm, fd, @r)
    fs_ok(sm, @r)

# ---- The judgement: ritz0's _types_compatible / _arrays_agree ----

# A struct whose fits ritz0 rules elsewhere (a view, a future): taken as fitting.
fn fs_view_name(t: *FsTy) -> i32
    if t.base != TYPE_STRUCT
        return 0
    if name_eq(StrView { ptr: (t.name), len: (t.name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (t.name), len: (t.name_len) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 }) == 1
        return 1
    if t.name_len >= 4 and name_eq(StrView { ptr: (t.name), len: (4) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1
        return 1
    (t.name_len >= 7 and name_eq(StrView { ptr: (t.name + t.name_len - 7), len: (7) as i64 }, StrView { ptr: (c"$Future"), len: (7) as i64 }) == 1) as i32

# `a` from level `ai` is a `*u8` exactly.
fn fs_is_byte_ptr(a: *FsTy, ai: i32) -> i32
    (a.n - ai == 1 and a.lv[ai] == TYPE_PTR and a.base == TYPE_U8) as i32

# Does `a` (from its level `ai`) fit where `e` (from `ei`) is wanted?
fn fs_compat(sm: *Sema, a: *FsTy, ai: i32, e: *FsTy, ei: i32) -> i32
    let an: i32 = a.n - ai
    let en: i32 = e.n - ei
    if fs_view_name(a) == 1 or fs_view_name(e) == 1
        return 1
    if an > 0 and en == 0
        if fs_word(e.base) == 1
            return 1
        return (e.base == FS_FN and fs_is_byte_ptr(a, ai) == 1) as i32
    if an == 0 and en > 0
        return fs_word(a.base)
    if an > 0 and en > 0
        if fs_is_byte_ptr(e, ei) == 1
            return 1
        if fs_is_byte_ptr(a, ai) == 1 and e.lv[ei] == TYPE_PTR
            return 1
        return fs_compat(sm, a, ai + 1, e, ei + 1)
    # Both bases, no levels left.
    if a.base == FS_FN or e.base == FS_FN
        if a.base == FS_FN and e.base == FS_FN
            return fs_sig_fits(sm, a.sig, e.sig)
        return 0
    if a.base == TYPE_ARRAY or e.base == TYPE_ARRAY
        if a.base == TYPE_ARRAY and e.base == TYPE_ARRAY
            return fs_compat(sm, a.elem, 0, e.elem, 0)
        return 0
    if a.base == TYPE_VOID or e.base == TYPE_VOID
        return 1
    if a.base == TYPE_STRUCT or e.base == TYPE_STRUCT
        if a.base == TYPE_STRUCT and e.base == TYPE_STRUCT
            return name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (e.name), len: (e.name_len) as i64 })
        return 0
    if a.base == e.base
        return 1
    if fs_int(a.base) == 1 and fs_int(e.base) == 1
        return 1
    (a.base == TYPE_F32 and e.base == TYPE_F64) as i32

# Arrays reached through matching levels have the same length and element.
fn fs_agree(a: *FsTy, ai: i32, e: *FsTy, ei: i32) -> i32
    var i: i32 = ai
    var j: i32 = ei
    while i < a.n and j < e.n
        i = i + 1
        j = j + 1
    if i < a.n or j < e.n or a.base != TYPE_ARRAY or e.base != TYPE_ARRAY
        return 1
    if a.size != e.size
        return 0
    let x: *FsTy = a.elem
    let y: *FsTy = e.elem
    if x.n == 0 and y.n == 0 and x.base != TYPE_ARRAY and y.base != TYPE_ARRAY and x.base != FS_FN and y.base != FS_FN
        if x.base == TYPE_STRUCT or y.base == TYPE_STRUCT
            return (x.base == y.base and name_eq(StrView { ptr: (x.name), len: (x.name_len) as i64 }, StrView { ptr: (y.name), len: (y.name_len) as i64 }) == 1) as i32
        return (x.base == y.base) as i32
    fs_agree(x, 0, y, 0)

# Does fn `a` fit a slot of fn type `e`?  Both decode (fs_sig_ok).
fn fs_sig_fits(sm: *Sema, a: *FnDef, e: *FnDef) -> i32
    var pa: *Param = a.params
    var pe: *Param = e.params
    while pa != null and pe != null
        var x: FsTy
        var y: FsTy
        fs_param(pa, @x)
        fs_param(pe, @y)
        var fits: i32 = (fs_compat(sm, @x, 0, @y, 0) == 1 and fs_agree(@x, 0, @y, 0) == 1) as i32
        # A `name:& T` param is physically a `*T` (AGAST #3034).
        if fits == 0 and x.lent == 1 and y.n > 0
            fits = (fs_compat(sm, @x, 0, @y, 1) == 1 and fs_agree(@x, 0, @y, 1) == 1) as i32
        if fits == 0
            return 0
        pa = pa.next
        pe = pe.next
    if pa != null or pe != null
        return 0
    var ra: FsTy
    var re: FsTy
    fs_ret(sm, a, @ra)
    fs_ret(sm, e, @re)
    fs_compat(sm, @ra, 0, @re, 0)

# ---- Spelling, as ritz0's str(Type) ----

fn fs_print(sm: *Sema, t: *FsTy)
    var i: i32 = 0
    while i < t.n
        let k: i32 = t.lv[i]
        if k == TYPE_PTR
            eprints_cstr(c"*")
        else if k == TYPE_REF
            eprints_cstr(c"@")
        else
            eprints_cstr(c"@&")
        i = i + 1
    if t.base == FS_FN
        fs_print_sig(sm, t.sig)
    else if t.base == TYPE_ARRAY
        eprints_cstr(c"[")
        eprint_int(t.size as i64)
        eprints_cstr(c"]")
        fs_print(sm, t.elem)
    else if t.base == TYPE_STRUCT
        eprint_bytes(StrView { ptr: (t.name), len: (t.name_len) as i64 })
    else if t.base == TYPE_VOID
        eprints_cstr(c"void")
    else
        eprints_cstr(ty_name(t.base))

fn fs_print_sig(sm: *Sema, fd: *FnDef)
    eprints_cstr(c"fn(")
    var p: *Param = fd.params
    while p != null
        var t: FsTy
        fs_param(p, @t)
        fs_print(sm, @t)
        if p.next != null
            eprints_cstr(c", ")
        p = p.next
    eprints_cstr(c") -> ")
    var r: FsTy
    fs_ret(sm, fd, @r)
    fs_print(sm, @r)

# ---- The value, the slot, the report ----

# The signature of fn value `v`: a local's, a top-level fn's, a field's, a
# call's return, a cast's; null when it is none (or Sema can't say).
fn fs_value_sig(sm: *Sema, v: *Expr) -> *FnDef
    if v == null
        return null
    if v.kind == EXPR_IDENT
        let lv: *SemaVar = sema_find_local(sm, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 })
        if lv != null
            return lv.fn_sig
        let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 })
        if g != null
            return g.fn_sig   # AGAST #4324: a fn-typed global's signature
        return sema_find_fn(sm, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 })
    sbk_value_fn_sig(sm, v)

# The signature of `v` when it is a fn value that doesn't fit slot `slot`
# (both judged and spelled whole), else null.
fn fs_misfit(sm: *Sema, v: *Expr, slot: *FnDef) -> *FnDef
    if slot == null
        return null
    let sig: *FnDef = fs_value_sig(sm, v)
    if sig == null or sig == slot
        return null
    if fs_sig_ok(sm, sig) == 0 or fs_sig_ok(sm, slot) == 0
        return null
    if fs_sig_fits(sm, sig, slot) == 1
        return null
    sig

fn fs_report(sm: *Sema, line: i32, col: i32)
    diag_error_at(sema_file(sm), diag_span(line, col))
    sm.error_count = sm.error_count + 1

# `let h: fn(..) -> T = v` / `var`.
pub fn fn_slot_decl(sm: *Sema, st: *Stmt)
    if st.var_init == null or st.var_declared_type != TYPE_PTR
        return
    let sig: *FnDef = fs_misfit(sm, st.var_init, st.var_fn_sig)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints_cstr(c"cannot initialize ")
    fs_print_sig(sm, st.var_fn_sig)
    eprints_cstr(c" with ")
    fs_print_sig(sm, sig)
    eprints_cstr(c"\n")

# The fn type of the place `target = ..` writes, or null.
fn fs_target_sig(sm: *Sema, st: *Stmt) -> *FnDef
    if st.kind == STMT_ASSIGN
        if st.assign_target_len != 0
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (st.assign_target), len: (st.assign_target_len) as i64 })
            if v != null
                return v.fn_sig
            # AGAST #4324: a global's fn type is kept on its GlobalVarDef.
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (st.assign_target), len: (st.assign_target_len) as i64 })
            if g != null
                return g.fn_sig
            return null
        let target: *Expr = st.if_cond as *Expr
        if target != null and target.kind == EXPR_MEMBER
            let f: *StructField = sbk_member_field(sm, target)
            if f != null and f.field_type == TYPE_PTR
                return f.fn_sig
        return null
    if st.kind == STMT_LOCAL_FIELD_ASSIGN
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (st.var_name), len: (st.var_name_len) as i64 })
        if v == null
            return null
        let sd: *StructDef = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
        if sd == null
            return null
        let idx: i32 = find_field_index(sd, StrView { ptr: (st.assign_target), len: (st.assign_target_len) as i64 })
        if idx < 0
            return null
        let f: *StructField = get_field_type(sd, idx)
        if f.field_type == TYPE_PTR
            return f.fn_sig
    null

# `target = v`.
pub fn fn_slot_assign(sm: *Sema, st: *Stmt)
    let slot: *FnDef = fs_target_sig(sm, st)
    let sig: *FnDef = fs_misfit(sm, st.assign_value, slot)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints_cstr(c"cannot assign ")
    fs_print_sig(sm, sig)
    eprints_cstr(c" to ")
    fs_print_sig(sm, slot)
    eprints_cstr(c"\n")

# `f(.., v, ..)`, f a top-level fn.
pub fn fn_slot_call(sm: *Sema, e: *Expr)
    if e.func_name_len == 0 or e.call_type_suffix_len > 0
        return
    if sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) != null
        return
    let fd: *FnDef = sema_find_fn(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if fd == null or fd.type_params != null
        return
    var p: *Param = fd.params
    var a: *Expr = e.args
    var n: i32 = 1
    while p != null and a != null
        if p.param_type == TYPE_PTR and p.fn_sig != null
            let sig: *FnDef = fs_misfit(sm, a, p.fn_sig)
            if sig != null
                fs_report(sm, a.span.line, a.span.col)
                eprints_cstr(c"argument ")
                eprint_int(n as i64)
                eprints_cstr(c" ('")
                eprint_bytes(StrView { ptr: (p.name), len: (p.name_len) as i64 })
                eprints_cstr(c"'): expected ")
                fs_print_sig(sm, p.fn_sig)
                eprints_cstr(c", got ")
                fs_print_sig(sm, sig)
                eprints_cstr(c"\n")
        p = p.next
        a = a.next
        n = n + 1

# `S { h: v, .. }`.
pub fn fn_slot_struct_lit(sm: *Sema, e: *Expr)
    let sd: *StructDef = sema_find_struct(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if sd == null or sd.type_params != null
        return
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        let idx: i32 = find_field_index(sd, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
        if idx >= 0
            let f: *StructField = get_field_type(sd, idx)
            if f.field_type == TYPE_PTR and f.fn_sig != null
                let sig: *FnDef = fs_misfit(sm, fi.value, f.fn_sig)
                if sig != null
                    fs_report(sm, fi.value.span.line, fi.value.span.col)
                    eprints_cstr(c"field '")
                    eprint_bytes(StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
                    eprints_cstr(c"': expected ")
                    fs_print_sig(sm, f.fn_sig)
                    eprints_cstr(c", got ")
                    fs_print_sig(sm, sig)
                    eprints_cstr(c"\n")
        fi = fi.next

# `return v` in the fn being walked.
pub fn fn_slot_return(sm: *Sema, st: *Stmt)
    let f: *FnDef = sm.cur_fn
    if f == null or f.return_type != TYPE_PTR
        return
    let sig: *FnDef = fs_misfit(sm, st.return_value, f.ret_fn_sig)
    if sig == null
        return
    fs_report(sm, st.span.line, st.span.col)
    eprints_cstr(c"return type ")
    fs_print_sig(sm, sig)
    eprints_cstr(c" doesn't match expected ")
    fs_print_sig(sm, f.ret_fn_sig)
    eprints_cstr(c"\n")

# `st`, the last statement of the fn being walked, is its value.
pub fn fn_slot_tail(sm: *Sema, st: *Stmt)
    let f: *FnDef = sm.cur_fn
    if f == null or f.return_type != TYPE_PTR or st.kind != STMT_EXPR
        return
    let sig: *FnDef = fs_misfit(sm, st.expr, f.ret_fn_sig)
    if sig == null
        return
    fs_report(sm, st.expr.span.line, st.expr.span.col)
    eprints_cstr(c"block expression has type ")
    fs_print_sig(sm, sig)
    eprints_cstr(c", expected ")
    fs_print_sig(sm, f.ret_fn_sig)
    eprints_cstr(c"\n")
