# ritz1/src/index_through.ritz - `[]` through a pointer or reference
#
# AGAST #2440, LARB R9.  `p[i]` means `(*p)[i]` when `p` is a `*T`, `@T` or `@&T` and
# T is a Vec, Span or String, and it's a place in every position: read, store, `+=`,
# `@`, `@&`, `.f`.  Each of those lowers `*(p.data + i)` already, at stride T, so a
# site asks index_through and takes the deref index_through_fill builds, as
# elem_index_as_deref does for `a[i][j]` (#2332).  ritz0's twin is
# Emitter._index_through.
#
# A `*T` over anything else is a raw buffer, and stays on the pointer paths.  A
# reference to anything else is one T: every site asks index_refused first.
#
# AGAST #2442: the value itself is the same place.  `v[i]` on a Vec, Span or String
# local is `*(v.data + i)`, and so is an element that is one: `v[i][j]` and `p[i][j]`
# are `*(v[i].data + j)`.
#
# AGAST #2330: an array behind a pointer is the same place.  `p[i]` and `(*p)[i]` on a
# `*[N]T`, `@[N]T` or `@&[N]T` local are `*(p# + i)`, element i at stride T, where
# `p#` is the `*T` view add_array_view bound with `p`.
#
# AGAST #2329: so are other bases, `h.r[i]`, `g[i]` and `h(p)[i]`.  Their view is in
# no scope (base_array_view): an emitting site binds it with through_spill, which
# evaluates the base once into a `#k` local, and `x[i]` is `*(#k + i)`.  So is
# `(*r)[i]` with `r: **[N]T` (#2553, deref_array_view): the base is `*r`.  And
# (#2331) `(*q)[i]` with `q: **Vec<T>`, `@*Vec<T>` or `@&*Vec<T>`: `q.data` sees through.

import ritzlib.sys
import ritzlib.str

import ast
import ast_helpers    # primitive_name_from_type
import struct_index   # si_traits, si_needs_index_msg (AGAST #2452)
import emitter_core
import emitter_expr   # emit_member_gep_from_ptr

# The Exprs `*(p.data + i)` is made of, for `index_through_fill` to fill.  A String
# reaches its bytes through a Vec, so `*(p.data.data + i)`.
struct ThroughIndex
    field: Expr
    bytes: Expr
    sum: Expr
    deref: Expr

fn name_starts(name: *u8, len: i32, prefix: *u8, prefix_len: i32) -> i32
    if len <= prefix_len
        return 0
    (memcmp(name, prefix, prefix_len as i64) == 0) as i32

fn through_is_string(name: *u8, len: i32) -> i32
    if len != 6
        return 0
    (memcmp(name, c"String", 6) == 0) as i32

# 1 when a struct of this name indexes.
pub fn name_is_indexable(name: *u8, len: i32) -> i32
    if name_starts(name, len, c"Vec$", 4) == 1 or name_starts(name, len, c"Span$", 5) == 1
        return 1
    through_is_string(name, len)

# `p` of `p[i]` and of `(*p)[i]`.
fn through_root(base: *Expr) -> *Expr
    if base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        return base.operand
    base

# 1 when `loc` is a Vec, Span or String itself (#2442).
fn indexes_itself(loc: *LocalVar) -> i32
    if loc.var_type != TYPE_STRUCT
        return 0
    name_is_indexable(loc.type_name, loc.type_name_len)

# 1 when `loc` is a pointer or reference, at one level, to a struct of an indexable name.
fn sees_through(loc: *LocalVar) -> i32
    if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
        return 0
    if loc.pointee_type != TYPE_STRUCT
        return 0
    name_is_indexable(loc.type_name, loc.type_name_len)

# AGAST #2331: 1 when `loc` is a `**T`, `@*T` or `@&*T` with T a Vec, Span or
# String, one level further out than sees_through: `(*q)[i]` is `*((*q).data + i)`.
# index_through_fill's `q.data` sees through both levels.  It read and stored the wrong bytes.
fn sees_through_deref(loc: *LocalVar) -> i32
    if ptr_to_struct_ptr(loc) == 0
        return 0
    name_is_indexable(loc.type_name, loc.type_name_len)

# What an element that is itself a Vec, Span or String is, for `v[i][j]`: only its
# type_name and var_type are read, and every caller has done with it before it emits.
var g_through_elem: LocalVar

# The local `e` indexes through, or null.  `p[lo..hi]` is monomorph's
# `p.slice(lo, hi)` or index_refused's error, and a slice of the value itself
# keeps its own lowering.
pub fn index_through(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_INDEX or e.right == null or e.right.kind == EXPR_RANGE
        return null
    if e.left != null and e.left.kind == EXPR_INDEX
        return index_through_element(s, e.left)
    let root: *Expr = through_root(e.left)
    if root == null
        return null
    if root.kind != EXPR_IDENT
        let ev: *LocalVar = element_array_view(s, root)   # `(*pg[i])[j]` (#2995)
        if ev != null
            return ev
        let fv: *LocalVar = vec_field_through(s, e.left)   # `x.vf[i]` (#2564)
        if fv != null
            return fv
        if root == e.left
            let cv: *LocalVar = call_result_view(s, root)   # `v[1..3][i]` (#2726)
            if cv != null
                return cv
        return base_array_view(s, root)   # `h.r[i]`, `h(p)[i]` (#2329)
    let loc: *LocalVar = find_local_struct_name(s, root.ident_ptr, root.ident_len)
    if loc == null
        return base_array_view(s, root)   # `g[i]` (#2329)
    # `v[i]` on the value itself, but not `(*v)[i]`.
    if root == e.left and indexes_itself(loc) == 1
        return loc
    if root != e.left   # `(*r)[i]` with `r: **[N]T` (#2553)
        let dv: *LocalVar = deref_array_view(s, e.left, loc)
        if dv != null
            return dv
        if sees_through_deref(loc) == 1   # `(*q)[i]` with `q: **Vec<T>` (#2331)
            return loc
    if loc.pointee_type == TYPE_ARRAY
        return array_view_of(s, root)
    if sees_through(loc) == 0
        return null
    loc

# AGAST #2564: `base`, a field `x.vf` that is a Vec, Span or String by value, as the
# local `v[i]` takes on a Vec name (#2442): index_through_fill makes `x.vf[i]` the
# place `*(x.vf.data + i)`, and an element that is a struct S names S.  The member
# path found no S through `x.vf[i]`, so `x.vf[i].f`, `x.vf[i].m()` and
# `x.vf[i] = ...` were "unhandled EXPR_MEMBER", unlocated.  The fill names `base`
# again at each use, so a base holding a call (`h().vf[i]`) isn't taken: it would
# run twice under `+=`.  None reaches here today (member_field_def types no `*T`
# call's field, #2517), so that guard is for when one does.  It's in no scope:
# only type_name and var_type are read.
fn vec_field_through(s: *EmitterState, base: *Expr) -> *LocalVar
    if base == null or base.kind != EXPR_MEMBER or place_without_call(base) == 0
        return null
    let f: *StructField = member_field_def(s, base)
    if f == null or f.field_type != TYPE_STRUCT
        return null
    if name_is_indexable(f.field_type_name, f.field_type_name_len) == 0
        return null
    let v: *LocalVar = malloc(sizeof(LocalVar)) as *LocalVar
    memset(v as *u8, 0, sizeof(LocalVar))
    v.var_type = TYPE_STRUCT
    v.type_name = f.field_type_name
    v.type_name_len = f.field_type_name_len
    v.inner_pointee_type = TYPE_VOID
    v.pointee_array_elem_type = TYPE_VOID
    v.pointee_array_elem_pointee = TYPE_VOID
    v

# AGAST #2726: `base`, a call that returns a Vec or Span by value, as the view of
# its buffer.  #2451 makes `v[lo..hi]` the call `v.slice(lo, hi)`, so `v[1..3][i]`
# indexes a call's result: emit_expr_index took the aggregate for a pointer
# (`inttoptr i64 %"Span$i32"`, which clang refuses).  The view's base is the field
# `base.ptr` / `base.data`, which through_spill evaluates once (the call runs once),
# so `x[i]` is `*(#k + i)` at stride T, as for `h(p)[i]` (#2329).  A String's
# buffer is a Vec, one more level, and isn't taken; nor is an element that's a
# pointer (its pointee isn't recorded).  It's in no scope.
fn call_result_view(s: *EmitterState, base: *Expr) -> *LocalVar
    if base.kind != EXPR_CALL and base.kind != EXPR_METHOD
        return null
    var name: *u8 = null
    var name_len: i32 = 0
    call_result_struct_name(s, base, @name, @name_len)
    if name == null or name_is_indexable(name, name_len) == 0 or through_is_string(name, name_len) == 1
        return null
    var probe: LocalVar
    memset(@probe as *u8, 0, sizeof(LocalVar))
    probe.type_name = name
    probe.type_name_len = name_len
    let f: *StructField = through_buffer(s, @probe)
    if f == null or f.field_type != TYPE_PTR
        return null
    let buf: *Expr = malloc(sizeof(Expr)) as *Expr
    memset(buf as *u8, 0, sizeof(Expr))
    if name_starts(name, name_len, c"Span$", 5) == 1
        through_member(buf, base, base, c"ptr", 3)
    else
        through_member(buf, base, base, c"data", 4)
    unscoped_array_view(s, buf, ptr_field_elem_kind(f), f.field_type_name, f.field_type_name_len, TYPE_VOID)

# 1 when `e` names a place with no call in it: names, fields, indexes, derefs, and
# arithmetic on those in an index (`a[i - 1].vf`).
fn place_without_call(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_IDENT or e.kind == EXPR_INT_LIT
        return 1
    if e.kind == EXPR_MEMBER
        return place_without_call(e.left)
    if e.kind == EXPR_INDEX or e.kind == EXPR_BINARY
        return (place_without_call(e.left) == 1 and place_without_call(e.right) == 1) as i32
    if e.kind == EXPR_UNARY
        return place_without_call(e.operand)
    0

# AGAST #2330: the `p#` view of `root`, a `*[N]T`, `@[N]T` or `@&[N]T` local, or null:
# rows and `*[N]**U` have none (#2522).  It's the local just before `p`, over the
# same slot.
fn array_view_of(s: *EmitterState, root: *Expr) -> *LocalVar
    array_view_named(s, root.ident_ptr, root.ident_len)

fn array_view_named(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    if array_ptr_named(s, name, len) == null
        return null
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 1
        return null
    let loc: *LocalVar = local_at(s, idx)
    let view: *LocalVar = local_at(s, idx - 1)
    if view.array_view == 0 or view.reg != loc.reg
        return null
    if view_lacks_pointee(view) == 1
        return null
    view

# `inner` of `inner[j]` as a local, when `inner` is an index through and its element
# is a Vec, Span or String, or a pointer to one: `[]` sees through that (#2442).
# emit_through_member_ptr loads the pointer for `inner.data`.  An element that's a
# `*S` over any other struct is the view of a raw buffer (#2887).
fn index_through_element(s: *EmitterState, inner: *Expr) -> *LocalVar
    let ev: *LocalVar = element_array_view(s, inner)   # `pg[i][j]` (#2995)
    if ev != null
        return ev
    let outer: *LocalVar = index_through(s, inner)
    if outer == null
        return null
    var name: *u8 = null
    var name_len: i32 = 0
    let held: i32 = through_elem_struct(s, outer, @name, @name_len)
    if name == null
        return null
    if name_is_indexable(name, name_len) == 0
        # AGAST #2887: a `*S` element over a struct that doesn't index is a raw
        # buffer (R9): `pv[i][j]` is `*(pv[i] + j)` at stride S.  The view's base
        # `pv[i]` is evaluated once by through_spill.
        if held == TYPE_PTR_PTR
            return unscoped_array_view(s, inner, TYPE_STRUCT, name, name_len, TYPE_VOID)
        return null
    memset(@g_through_elem as *u8, 0, sizeof(LocalVar))
    g_through_elem.var_type = TYPE_STRUCT
    g_through_elem.type_name = name
    g_through_elem.type_name_len = name_len
    @g_through_elem

# AGAST #2995: `b` = `pg[i]`, an element of a `var pg: [N]*[M]T` local, as the view
# of the array it points at, or null.  Under R9 the element is a pointer to one
# array, so `pg[i][j]` and `(*pg[i])[j]` are element j at stride T, as `p[j]` is on
# a `*[M]T` local (#2330).  They took the raw-buffer path, `*(pg[i] + j)` at stride
# u8, and read the wrong bytes, SILENT.  through_spill evaluates `pg[i]` once.
fn element_array_view(s: *EmitterState, b: *Expr) -> *LocalVar
    if b == null or b.kind != EXPR_INDEX or b.left == null or b.left.kind != EXPR_IDENT
        return null
    if b.right == null or b.right.kind == EXPR_RANGE
        return null
    let loc: *LocalVar = find_local_struct_name(s, b.left.ident_ptr, b.left.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY or loc.array_rec == null
        return null
    let pa: *ArrayElem = loc.array_rec.ptr_array
    if pa == null or loc.array_rec.ptr_array_size <= 0
        return null
    unscoped_array_view(s, b, pa.elem, pa.name, pa.name_len, pa.pointee)

fn through_member(m: *Expr, e: *Expr, base: *Expr, name: *u8, len: i32)
    m.kind = EXPR_MEMBER
    m.span = e.span
    m.left = base
    m.ident_ptr = name
    m.ident_len = len
    m.next = null

# `m` names `view`, the `p#` of `root` (#2330).
fn through_view(m: *Expr, root: *Expr, view: *LocalVar)
    m.kind = EXPR_IDENT
    m.span = root.span
    m.ident_ptr = view.name
    m.ident_len = view.name_len
    m.next = null

# Fill `t` with `*(p.data + i)` for `e`, which index_through took as `loc`.
pub fn index_through_fill(e: *Expr, loc: *LocalVar, t: *ThroughIndex)
    memset(t as *u8, 0, sizeof(ThroughIndex))
    let root: *Expr = through_root(e.left)
    var buffer: *Expr = @t.field
    if loc.array_view == 1
        through_view(@t.field, root, loc)   # `*(p# + i)` (#2330)
    else if name_starts(loc.type_name, loc.type_name_len, c"Span$", 5) == 1
        through_member(@t.field, e, root, c"ptr", 3)
    else
        through_member(@t.field, e, root, c"data", 4)
    if through_is_string(loc.type_name, loc.type_name_len) == 1
        through_member(@t.bytes, e, @t.field, c"data", 4)
        buffer = @t.bytes
    t.sum.kind = EXPR_BINARY
    t.sum.span = e.span
    t.sum.op = OP_ADD
    t.sum.left = buffer
    t.sum.right = e.right
    t.deref.kind = EXPR_UNARY
    t.deref.span = e.span
    t.deref.op = OP_DEREF
    t.deref.operand = @t.sum

# The field of a Vec or Span that points at its elements, or null: a String's is
# a Vec, so it has none here.
fn through_buffer(s: *EmitterState, loc: *LocalVar) -> *StructField
    let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
    if st == null or through_is_string(loc.type_name, loc.type_name_len) == 1
        return null
    var idx: i32 = find_field_index(st, c"data", 4)
    if idx < 0
        idx = find_field_index(st, c"ptr", 3)
    if idx < 0
        return null
    get_field_type(st, idx)

# The kind of an element of `loc`, which sees through, for the slot checks.
pub fn through_elem_kind(s: *EmitterState, loc: *LocalVar) -> i32
    if loc.array_view == 1
        return loc.pointee_type
    if through_is_string(loc.type_name, loc.type_name_len) == 1
        return TYPE_U8
    let f: *StructField = through_buffer(s, loc)
    if f == null
        return TYPE_UNKNOWN
    ptr_field_elem_kind(f)

# The element kind of `name[i]`, if `name` sees through, or TYPE_VOID.
pub fn through_named_elem(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return TYPE_VOID
    let loc: *LocalVar = local_at(s, idx)
    # AGAST #2330: through a pointer to an array, the slot is the element.
    let view: *LocalVar = array_view_named(s, name, len)
    if view != null
        return through_elem_kind(s, view)
    if sees_through(loc) == 0 and indexes_itself(loc) == 0
        return TYPE_VOID
    through_elem_kind(s, loc)

# The struct an element of `loc`'s buffer is or points at, and the field's type
# (TYPE_PTR for `*S` elements, TYPE_PTR_PTR for `*S` held in the buffer), or
# TYPE_VOID for scalars.
fn through_elem_struct(s: *EmitterState, loc: *LocalVar, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if loc.array_view == 1
        # A struct T, named by the view's type_name, is held in the array.
        if loc.pointee_type != TYPE_STRUCT
            return TYPE_VOID
        *out_name = loc.type_name
        *out_len = loc.type_name_len
        return TYPE_PTR
    let f: *StructField = through_buffer(s, loc)
    if f == null or f.field_type_name_len <= 0 or find_struct(s, f.field_type_name, f.field_type_name_len) == null
        return TYPE_VOID
    *out_name = f.field_type_name
    *out_len = f.field_type_name_len
    f.field_type

# The struct `p[i].f` takes a field of, for the type-only paths.  Returns 1 if `e`
# is an index through.
pub fn index_through_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    let loc: *LocalVar = index_through(s, e)
    if loc == null
        return 0
    through_elem_struct(s, loc, out_name, out_len)
    1

# AGAST #2444: the struct an element of `e`, an index through, is by value, for the
# move check.  1 and its name; 0 if `e` isn't an index through, or its element is a
# scalar or a pointer.  ref_ty_of gives `p[i]` the Vec's own name and `(*p)[i]` none.
pub fn index_through_value_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    let loc: *LocalVar = index_through(s, e)
    if loc == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    if through_elem_struct(s, loc, @name, @len) != TYPE_PTR or name == null
        return 0
    *out_name = name
    *out_len = len
    1

# The address of the struct `e`, an index through, is or points at, as a `ptr`
# register, and its name; 0 if `e` isn't one or its element isn't a struct.  An
# element that's a pointer holds the struct's address; otherwise the sum is it.
pub fn emit_through_elem_ptr(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    let loc: *LocalVar = index_through(s, e)
    if loc == null
        return 0
    var name: *u8 = null
    var name_len: i32 = 0
    let held: i32 = through_elem_struct(s, loc, @name, @name_len)
    if name == null
        return 0
    var t: ThroughIndex
    index_through_fill(e, through_spill(s, loc), @t)
    var val: i32 = 0
    if held == TYPE_PTR_PTR
        val = emit_expr(s, @t.deref)
    else
        val = emit_expr(s, @t.sum)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, val)
    emit_str(s, c" to ptr\n")
    *out_name = name
    *out_len = name_len
    elem_ptr

# `p[i].f`'s address, for `e` = the EXPR_MEMBER.  Returns 1 when it took `e`.
pub fn emit_through_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    if index_through_struct(s, e.left, @name, @name_len) == 0 or name == null
        return 0
    let st: *StructDef = find_struct(s, name, name_len)
    let field_idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if field_idx < 0
        return 0
    let elem_ptr: i32 = emit_through_elem_ptr(s, e.left, @name, @name_len)
    emit_member_gep_from_ptr(s, result, elem_ptr, st, field_idx, get_field_type(st, field_idx))
    1

# 1 after reporting `e`, a slice through a pointer or reference that monomorph
# didn't rewrite into `p.slice(lo, hi)` (#2448): a Vec into a Span slot whose
# low bound has a call inside it (#2501), a call in a Span<u8>'s low bound with
# no ritzlib.span.  The range block in
# emit_expr_index reads the struct at the local's own slot, which here holds a
# pointer to it, so a Span sliced garbage.
fn through_slice_refused(s: *EmitterState, e: *Expr) -> i32
    if e.right == null or e.right.kind != EXPR_RANGE
        return 0
    let root: *Expr = through_root(e.left)
    if root == null or root.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, root.ident_ptr, root.ident_len)
    if loc == null or sees_through(loc) == 0
        return 0
    emit_nd_error(s, e.span.line, e.span.col, c"this slice of a Vec, Span or String isn't lowered by ritz1 (`let t = p[lo..hi]` is)")
    1

# 1 after reporting `e`, an index through a reference to something that isn't
# indexable.  `(*q)[i]` names what's behind the reference, so it isn't one of these.
pub fn index_refused(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null
        return 0
    if through_slice_refused(s, e) == 1
        return 1
    if e.left.kind == EXPR_INDEX
        return element_refused(s, e)
    if e.left.kind == EXPR_UNARY and e.left.op == OP_DEREF
        return deref_value_refused(s, e.left)
    if e.left.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if loc == null
        return 0
    if scalar_local_refused(s, e, loc) == 1
        return 1
    # `let p = @x` is an `@T` too, and `let p = @&x` an `@&T` (#2445, #3079).
    if loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
        return 0
    if loc.pointee_type == TYPE_ARRAY or sees_through(loc) == 1
        return 0
    emit_nd_error(s, e.span.line, e.span.col, c"a reference is one value, not a buffer: `[]` needs an array, Vec, Span or String behind it")
    1

# AGAST #2886: 1 after reporting `e`, `n[i]` with `n` a sized scalar local: there
# is nothing to index.  ritz1 compiled it; ritz0 says §7.8's words, at the `[`, from
# _index_through.  An i64 or u64 local may hold a pointer, and an integer `:&`
# borrow binds as a plain T local (is_lent), so neither is refused (as #2885's `*v`).
fn scalar_local_refused(s: *EmitterState, e: *Expr, loc: *LocalVar) -> i32
    if e.right == null or e.right.kind == EXPR_RANGE
        return 0
    if loc.is_lent != 0 or sized_scalar(loc.var_type) == 0
        return 0
    let name: *u8 = primitive_name_from_type(loc.var_type)
    if name == null
        return 0
    emit_nd_error(s, index_bracket_line(e), index_bracket_col(e), si_needs_index_msg(name, strlen(name) as i32))
    1

# Where `e`'s `[` is: the parser's record of it, else (an index the compiler
# built) the start of `e`.
pub fn index_bracket_line(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.line
    e.span.line

pub fn index_bracket_col(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.col
    e.span.col

# AGAST #2452: 1 after reporting `e`, `x[i][j]` with `x[i]` an element held in a
# Vec, Span, String or local `[N]T` that has nothing to index: a struct without
# `Index`, or a scalar.  ritz1 took `sv[0][1]` on a `Vec<S>` for a buffer and failed at clang,
# and `v[0][1]` on a `Vec<i32>` compiled.  §7.8's words, at the second `[`, as
# ritz0's _struct_index and _index_through say them.  An element that's a
# pointer is a raw buffer, and one that's a Vec, Span or String indexes (#2442).
fn element_refused(s: *EmitterState, e: *Expr) -> i32
    if e.right == null or e.right.kind == EXPR_RANGE
        return 0
    var name: *u8 = null
    var len: i32 = 0
    var held: i32 = TYPE_PTR
    var kind: i32 = TYPE_VOID
    let arr: *LocalVar = array_local_of(s, e.left)
    if arr != null
        kind = arr.array_elem_type
        if kind == TYPE_STRUCT
            name = arr.type_name
            len = arr.type_name_len
    else
        let outer: *LocalVar = index_through(s, e.left)
        if outer == null
            return 0
        held = through_elem_struct(s, outer, @name, @len)
        if name == null
            kind = through_elem_kind(s, outer)
    if name != null
        if held != TYPE_PTR or name_is_indexable(name, len) == 1
            return 0
        if (si_traits(s.module, name, len) & SI_INDEX) != 0
            return 0
    else
        name = primitive_name_from_type(kind)
        if name == null
            return 0
        len = strlen(name) as i32
    emit_nd_error(s, index_bracket_line(e), index_bracket_col(e), si_needs_index_msg(name, len))
    1

# The local `[N]T` that `x`, `a[i]`, indexes, or null.
fn array_local_of(s: *EmitterState, x: *Expr) -> *LocalVar
    if x.left == null or x.left.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, x.left.ident_ptr, x.left.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY
        return null
    loc

# 1 for a scalar type no ritz1 local uses to hold a pointer (AGAST #2885).
fn sized_scalar(t: i32) -> i32
    if t == TYPE_I32 or t == TYPE_U8 or t == TYPE_I8 or t == TYPE_U16
        return 1
    if t == TYPE_U32 or t == TYPE_I16 or t == TYPE_F32 or t == TYPE_F64
        return 1
    0

# AGAST #2452: 1 after reporting `d`, the `*v` of `(*v)[i]`, when `v` is a
# struct by value (a Vec, Span, String or any other): there is no pointer to
# follow.  ritz1 read the struct's bytes as an address, and failed at clang or
# compiled.  ritz0 says the same, from array_rules.NOT_A_POINTER.
# AGAST #2885: and any other `*v` (a read, `*v = x`, `@*v`), and `v` a sized
# scalar.  An i64 or u64 local may hold a pointer (ritz1 carries most as i64),
# and an integer `:&` borrow binds as a plain T local (is_lent), so neither is
# refused.
pub fn deref_value_refused(s: *EmitterState, d: *Expr) -> i32
    let v: *Expr = d.operand
    if v == null or v.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, v.ident_ptr, v.ident_len)
    if loc == null or loc.is_lent != 0
        return 0
    if loc.var_type != TYPE_STRUCT and sized_scalar(loc.var_type) == 0
        return 0
    emit_nd_error(s, d.span.line, d.span.col, c"`*x` needs `x` to be a pointer or a reference: this one is a value")
    1

# AGAST #2330: 1 after reporting `p[i] = b` with `b` a whole array, when `loc` is the
# view of a `*[N]T`, `@[N]T` or `@&[N]T`.  `p[i]` is one T (LARB R9), and ritz0
# stored `b` a row on.  ritz0 says the same, from array_rules.ELEMENT_NOT_ARRAY.
pub fn through_whole_array_refused(s: *EmitterState, loc: *LocalVar, value: *Expr, line: i32, col: i32) -> i32
    if loc.array_view == 0 or value == null
        return 0
    let literal: i32 = (value.kind == EXPR_ARRAY_LIT or value.kind == EXPR_ARRAY_FILL) as i32
    if literal == 0 and get_expr_type(s, value) != TYPE_ARRAY
        return 0
    emit_nd_error(s, line, col, c"`p[i]` is one element of the array behind `p`, not the whole array: `*p = a` stores the array")
    1
