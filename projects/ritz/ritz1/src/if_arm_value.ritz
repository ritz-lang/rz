# ritz1/src/if_arm_value.ritz - an if-expression arm with no value
#
# AGAST #1613.  An if expression's arms are its value, so an arm that ends
# in no value (its body is statements alone) is refused:
#
#     let n: i32 = if c == 1
#         if d == 1       # error: an `if` with no `else` has no value ...
#             1
#     else
#         2
#
# A trailing else-less `if` gets ritz0's wording, located where ritz0 puts
# it, at that `if` (LANGUAGE_SPEC §6.1, AGAST #1406); expr_if already turned
# every trailing if/else into the arm's value.  Any other valueless arm (one
# ending in an assignment, say) is refused at the if expression.
#
# An arm that leaves the block (`return`, `break`, `continue`) reaches the
# merge only through the unreachable block the emitter opens after it, so
# its lack of a value is harmless (if_arm_diverges, emitter_match.ritz,
# which emit_match_arm_body still reads).
#
# sema_walk calls this for every if expression, before its condition, as
# emit_if_expr / emit_array_if_into checked both arms before lowering it.
# Moved off the emitter onto Sema (AGAST #3512, #1816; the #3462 pattern).
#
# AGAST #3980: only an if whose value is wanted.  A block's trailing if/else
# (and match) is parsed as its arm's value (block_tail_as_value), so a match
# STATEMENT's `Ok(v) =>` + `if c` / `rc = 4` / `else` / `rc = 1` read as an
# if expression with valueless arms; ritz1 refused it, ritz0 runs it.  As
# ritz0's _find_valueless_if carries `consumed`, sema_walk carries "value
# wanted" down: a block's tail is a value only in a fn that returns one (and
# through a tail `if` / `unsafe` there), a match statement anywhere else is
# discarded, and a discarded match / if hands that to its arms' values.
# Both flags are taken (and cleared) by the walk they are set just before.

var if_arm_g_tail: i32 = 0      # the next block walked ends in its value
var if_arm_g_discard: i32 = 0   # the next expression walked is discarded

# The `if` a value-wanted arm ended in without an `else`, where if_arm_check
# reported it (AGAST #1613).  sema_walk reads it when it reaches that
# statement: the value was wanted, so its tail is not "a statement with no
# effect" (LARB R64, #3492) as well as an arm with no value.
var if_arm_no_else_line: i32 = 0
var if_arm_no_else_col: i32 = 0

pub fn if_arm_no_else_at(line: i32, col: i32) -> i32
    (line == if_arm_no_else_line and col == if_arm_no_else_col) as i32

pub fn if_arm_want_tail(on: i32)
    if_arm_g_tail = on

pub fn if_arm_take_tail() -> i32
    let on: i32 = if_arm_g_tail
    if_arm_g_tail = 0
    on

pub fn if_arm_discard_next(on: i32)
    if_arm_g_discard = on

pub fn if_arm_take_discard() -> i32
    let on: i32 = if_arm_g_discard
    if_arm_g_discard = 0
    on

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import sema

# The last statement of the arm's body, or null.
fn if_arm_last(arm: *MatchArm) -> *Stmt
    var last: *Stmt = arm.body_stmts
    while last != null and last.next != null
        last = last.next
    last

# ritz0's #1406 wording at `line:col`, and the marker sema_walk reads so the
# same `if` is not also reported as a statement with no effect (LARB R64/R69).
fn if_arm_no_else_report(sm: *Sema, line: i32, col: i32)
    if_arm_no_else_line = line
    if_arm_no_else_col = col
    sema_error_at(sm, line, col)
    eprints_cstr(c"an `if` with no `else` has no value when its condition is false, so it cannot be used as a value here; add an `else` arm\n")

fn if_arm_check_one(sm: *Sema, e: *Expr, arm: *MatchArm)
    if arm == null or arm.is_pass == 0
        return
    let last: *Stmt = if_arm_last(arm)
    if last != null and (last.kind == STMT_RETURN or last.kind == STMT_BREAK or last.kind == STMT_CONTINUE)
        return
    if last != null and last.kind == STMT_IF
        if_arm_no_else_report(sm, last.span.line, last.span.col)
    else
        sema_error_at(sm, e.span.line, e.span.col)
        eprints_cstr(c"an `if` expression arm does not end in a value\n")

# Report each arm of the if expression `e` that ends in no value.
pub fn if_arm_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_IF
        return
    let then_arm: *MatchArm = e.args as *MatchArm
    if then_arm == null
        return
    # AGAST #4543: an else-less block `if` used as a value (`let x = if c` +
    # its body).  The grammar builds the one-arm node instead of failing the
    # parse at the next token, so the error lands where ritz0 puts it: at
    # this `if`, with #1406's wording.
    if then_arm.next == null or then_arm.next.else_missing != 0
        if_arm_no_else_report(sm, e.span.line, e.span.col)
        return
    if_arm_check_one(sm, e, then_arm)
    if_arm_check_one(sm, e, then_arm.next)

# AGAST #4543: a value-wanted match arm whose block tail is an else-less
# `if` has no value, the same #1406 shape one result path in (`let x = match`
# with an arm ending in `if c` + its body).  ritz0's _find_valueless_if walks
# a used match's arm bodies and reports at that `if`; sema_walk calls this
# before walking the arm, and the report marks the `if` so its body is not
# also "a statement with no effect".
pub fn if_arm_check_match_arm(sm: *Sema, arm: *MatchArm)
    if arm == null or arm.is_pass == 0
        return
    let last: *Stmt = if_arm_last(arm)
    if last != null and last.kind == STMT_IF and last.if_else == null
        if_arm_no_else_report(sm, last.span.line, last.span.col)
