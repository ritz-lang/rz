# ritz1/src/ast_helpers.ritz - AST Helper Functions for Generated Parser
#
# These functions are called by the parser generated from ritz1.grammar.
# They allocate AST nodes using bump allocation from the parser arena.

# Import AST types only - no ritzlib dependencies for standalone compilation
import ast
import types
import diag          # every located error's prefix (AGAST #3445)
import tokens_gen
import lexer
import struct_variants   # every struct, and gated-out fns (AGAST #4111, #4055)
import ritzlib.memory
import ritzlib.io
import ritzlib.sys
import ritzlib.str
import ritzlib.strview    # strview_eq (was the local buf_eq)

# =============================================================================
# ParseCtx: the compile's parse state (AGAST #4623)
# =============================================================================
#
# One per compile, made by main (parse_ctx_new) and shared by every file's
# Parser (parser_init stores it in p.ctx), so a grammar action reaches it as
# p.ctx and a helper without a Parser takes `ctx: *ParseCtx`.  Sema and
# MonoCtx hold it as `pctx` (the emitter as s.mono.pctx) for the registries
# the later passes read (enum_find, tuple_reg_lookup, trait_declared, ...).
# These were module globals; each field's notes stay where its
# `# State: ParseCtx.x` line marks the old declaration.  The struct is in
# ast.ritz, beside Parser, which holds it.
pub fn parse_ctx_new() -> *ParseCtx
    let ctx: *ParseCtx = calloc(1, sizeof(ParseCtx)) as *ParseCtx
    ctx.last_drop_at = -1
    ctx.var_ptr_array_elem = TypeKind.Void
    ctx.var_ptr_array_elem_pointee = TypeKind.Void
    ctx.nd_reject_line = -1
    ctx.nd_reject_col = -1
    ctx.lit_len_line = -1
    ctx.lit_len_col = -1
    ctx.array_len_line = -1
    ctx.array_len_col = -1
    ctx.open_if_end = 0 - 1
    ctx

# =============================================================================
# Parser allocation (bump allocator using parser's arena)
# =============================================================================

# AGAST #1730 — capacity in bytes of the arena the current parse allocates
# from, set by whoever mallocs it (parse_tokens, interp).  parser_alloc had
# no bound: ritz1's own emitter_stmt.ritz overran the fixed 4 MB arena by
# ~7.5k nodes and silently corrupted the heap until a small change made it
# fatal.  0 = unknown (no check).
# State: ParseCtx.parser_arena_cap

pub fn parser_arena_set_cap(ctx: *ParseCtx, cap: i64)
    ctx.parser_arena_cap = cap

pub fn parser_alloc(p: *Parser, size: i64) -> *u8
    # Bump allocator using the parser's heap arena
    # Align to 8-byte boundary for pointers
    let aligned_offset: i64 = (p.heap_offset + 7) & (0 - 8)
    let result: *u8 = p.heap_base + aligned_offset
    p.heap_offset = aligned_offset + size
    if p.ctx.parser_arena_cap > 0 and p.heap_offset > p.ctx.parser_arena_cap
        eprints("error: ritz1 parser arena exhausted; refusing to overrun the heap\n")
        sys_exit(70)
    # AGAST #3509: zeroed, so a field a constructor doesn't set (Expr.deref_step)
    # reads null, not the arena's last contents.
    memzero(result, size)
    return result

# =============================================================================
# Module helpers
# =============================================================================

# State: ParseCtx.fn_count

pub fn get_fn_count(ctx: *ParseCtx) -> i32
    ctx.fn_count

pub fn module_new(p: *Parser) -> *Module
    # One module_new per file parsed, so this is the per-parse reset point
    # for the dropped-item counter checked by module_require_eof.
    parser_reset_diagnostics(p.ctx)
    p.ctx.tuple_lits = 0   # AGAST #2956: a failed parse's literals are not this file's
    let m: *Module = parser_alloc(p, sizeof(Module)) as *Module
    m.imports = null
    m.constants = null
    m.structs = null
    m.enums = null
    m.functions = null
    m.globals = null
    m.impls = null
    p.module = m
    return m

pub fn module_add_fn(ctx: *ParseCtx, m: *Module, f: *FnDef)
    ctx.fn_count = ctx.fn_count + 1
    if m.functions == null
        m.functions = f
    else
        # Append to end of list
        var curr: *FnDef = m.functions
        while curr.next != null
            curr = curr.next
        curr.next = f

# =============================================================================
# target_os conditional-compilation filter
# =============================================================================
#
# Items marked `[[target_os = "X"]]` are kept only when X is the target OS
# (`--target-os`, default "linux" as in ritz0; AGAST #1550).  Items marked
# `[[target_arch = "A"]]` are kept only when A is the target architecture
# (`--target-arch`, default "x86_64"; LANGUAGE_SPEC §17.2, AGAST #4117).  An
# item carrying both must satisfy both.  The skipped variants must never
# reach the module — otherwise the wrong variant can win the name-based
# dedup, breaking syscalls (e.g. sys_mmap with 4 params instead of 6 →
# r8/r9 garbage → EINVAL → crash).
#
# parse_attr calls check_target_os_filter(p, ident, str) after successfully
# matching `[[ident = "string"]]`. If ident is "target_os" or "target_arch"
# and string is not the corresponding target, we set p.skip_item = 1.
# parse_item consumes this flag and drops the item instead of adding it to
# the module.

# The target OS.  null means the default, "linux".  Set once by main.
# State: ParseCtx.target_os, .target_os_len

# The target architecture.  null means the default, "x86_64".  Set once by
# main.
# State: ParseCtx.target_arch, .target_arch_len

pub fn set_target_os(ctx: *ParseCtx, os_sv: StrView)
    var os: *u8 = os_sv.ptr
    var os_len: i32 = os_sv.len as i32
    ctx.target_os = os
    ctx.target_os_len = os_len

pub fn set_target_arch(ctx: *ParseCtx, arch_sv: StrView)
    var arch: *u8 = arch_sv.ptr
    var arch_len: i32 = arch_sv.len as i32
    ctx.target_arch = arch
    ctx.target_arch_len = arch_len

pub fn check_target_os_filter(p: *Parser, ident_start_sv: StrView, str_val_sv: StrView)
    var ident_start: *u8 = ident_start_sv.ptr
    var ident_len: i32 = ident_start_sv.len as i32
    var str_val: *u8 = str_val_sv.ptr
    var str_len: i32 = str_val_sv.len as i32
    # Only act on `target_os` and `target_arch` attributes.
    let is_os: i32 = ((StrView { ptr: (ident_start), len: (ident_len) as i64 }).eq(StrView { ptr: (c"target_os"), len: (9) as i64 })) as i32
    let is_arch: i32 = ((StrView { ptr: (ident_start), len: (ident_len) as i64 }).eq(StrView { ptr: (c"target_arch"), len: (11) as i64 })) as i32
    if is_os == 0 and is_arch == 0
        return
    if is_os == 1
        if p.ctx.target_os == null
            if (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (c"linux"), len: (5) as i64 })
                return
        else if (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (p.ctx.target_os), len: (p.ctx.target_os_len) as i64 })
            return
    else
        if p.ctx.target_arch == null
            if (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (c"x86_64"), len: (6) as i64 })
                return
        else if (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (p.ctx.target_arch), len: (p.ctx.target_arch_len) as i64 })
            return
    p.skip_item = 1

# AGAST #1908: `[[test]]` (LANGUAGE_SPEC §17.1).  attr_flag notes it for the
# item being parsed (ATTR_TEST in ctx.attr_bits); item_dispatch_fn records that
# FnDef in ctx.test_fns, and every dispatcher clears the note.  A side list
# rather than an FnDef field: FnDefs come from parser_alloc (not zeroed) and
# monomorph's malloc'd clones, so a new field would be garbage on every
# allocation site that did not set it.  Pointers are compared by identity: a
# clone is never a test.
# State: ParseCtx.test_fns, .test_fn_count, .test_fn_cap

fn test_fn_record(ctx: *ParseCtx, f: *FnDef)
    if ctx.test_fn_count == ctx.test_fn_cap
        var cap: i64 = ctx.test_fn_cap * 2
        if cap == 0
            cap = 16
        let grown: *i64 = realloc(ctx.test_fns as *u8, cap * 8) as *i64
        if grown == null
            eprints("error: ritz1: out of memory recording [[test]] functions\n")
            sys_exit(70)
        ctx.test_fns = grown
        ctx.test_fn_cap = cap
    *(ctx.test_fns + ctx.test_fn_count) = f as i64
    ctx.test_fn_count = ctx.test_fn_count + 1

# 1 if `f` was declared `[[test]]` (by identity; see above).
pub fn is_test_fn(ctx: *ParseCtx, f: *FnDef) -> i32
    let key: i64 = f as i64
    var i: i64 = 0
    while i < ctx.test_fn_count
        if *(ctx.test_fns + i) == key
            return 1
        i = i + 1
    0

# 1 if `f` was declared `[[test_helper]]` (AGAST #1869), or is a monomorph
# instance of such a fn (fn_copy_instance_attrs marks those).
pub fn is_test_helper_fn(ctx: *ParseCtx, f: *FnDef) -> i32
    if (item_attr_bits(ctx, f as *u8) & ATTR_TEST_HELPER) != 0
        return 1
    0

# 1 if `f` was declared `[[must_use]]` (AGAST #2137), or is a monomorph
# instance of such a fn (fn_copy_instance_attrs marks those).
pub fn is_must_use_fn(ctx: *ParseCtx, f: *FnDef) -> i32
    if f != null and (item_attr_bits(ctx, f as *u8) & ATTR_MUST_USE) != 0
        return 1
    0

pub fn test_fn_count(ctx: *ParseCtx) -> i64
    ctx.test_fn_count

pub fn test_fn_at(ctx: *ParseCtx, i: i64) -> *FnDef
    *(ctx.test_fns + i) as *FnDef

# Forget every recorded test fn: the driver re-parses from scratch (#1475).
pub fn test_fns_reset(ctx: *ParseCtx)
    ctx.test_fn_count = 0
    ctx.attr_bits = 0
    ctx.attr_target_os = 0
    ctx.attr_target_arch = 0
    # The re-parse allocates new items, possibly at a freed item's address.
    ctx.item_attr_count = 0

# =============================================================================
# Item dispatchers — honour p.skip_item set by attrs (5F.3c)
# =============================================================================
#
# Conditional-compilation flow:
#   1. parse_attrs walks the [[ ... ]] attribute list.  For
#      `[[target_os = "<not the target>"]]`, attr_target_os sets p.skip_item = 1.
#   2. The matching `attrs <item>` alternative in parse_item then calls
#      one of these dispatchers, which:
#        - skip the module_add_* call when p.skip_item == 1
#        - reset p.skip_item to 0
#        - return 1 to signal "alternative matched" to the multi-alt
#          generator template (which only emits `return 1` on void rules;
#          we want explicit-return semantics here for the skip case).
#
# Without these, the grammar action would need to be multi-statement
# (`if not skipped: add_to_module; reset; return 1`), which ritzgen
# doesn't yet support — so we hide the conditional inside a helper.
# AGAST #3467 (LARB R54): every item `[[target_os]]` gates out, by name, in
# parse order, never reset.  Gating decides what is compiled, not what a
# module defines: ritzlib.sys's harland-only names may be listed in an
# `import ritzlib.sys { … }` built for linux, as ritz0 accepts.  import_vis
# marks the log before a file is parsed and reads what the file added.
# State: ParseCtx.gated_names, .gated_lens, .gated_count, .gated_cap

fn gated_decl_log(ctx: *ParseCtx, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if ctx.gated_count >= ctx.gated_cap
        var cap: i32 = ctx.gated_cap * 2
        if cap == 0
            cap = 64
        ctx.gated_names = realloc(ctx.gated_names as *u8, (cap as i64) * 8) as **u8
        ctx.gated_lens = realloc(ctx.gated_lens as *u8, (cap as i64) * 4) as *i32
        ctx.gated_cap = cap
    *(ctx.gated_names + ctx.gated_count) = name
    *(ctx.gated_lens + ctx.gated_count) = len
    ctx.gated_count = ctx.gated_count + 1

pub fn gated_decl_count(ctx: *ParseCtx) -> i32
    ctx.gated_count

pub fn gated_decl_at(ctx: *ParseCtx, i: i32, out_len: *i32) -> *u8
    *out_len = *(ctx.gated_lens + i)
    *(ctx.gated_names + i)

pub fn item_dispatch_fn(p: *Parser, fn_def: *FnDef) -> i32
    # AGAST #4055: a fn gated out never reaches the module, so main's
    # fn-conflict checks can't see two gated to one other target; note it.
    if p.skip_item != 0 and (p.ctx.attr_bits & ATTR_TARGET_ANY) != 0 and fn_def.body != null
        fn_variant_note(StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 }, fn_def.line, parse_file_copy_shared(p), attr_target_key(p.ctx))
    if p.skip_item != 0
        gated_decl_log(p.ctx, StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 })   # AGAST #3467
    if p.skip_item == 0
        module_add_fn(p.ctx, p.module, fn_def)
        # AGAST #2148: what main.ritz's fn-conflict checks read.
        fn_def.def_file = parse_file_copy_shared(p)
        if (p.ctx.attr_bits & ATTR_TARGET_ANY) != 0
            fn_def.target_gated = 1
        if (p.ctx.attr_bits & ATTR_TEST) != 0
            if fn_is_decl(p.ctx, fn_def) == 1
                decl_refused(p.ctx, tok_span_of(p, fn_def.name, fn_def.line), c"[[test]] fn", StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 }, StrView { ptr: (null), len: (0) as i64 }, c"a test needs its body")
            test_fn_record(p.ctx, fn_def)
        if (p.ctx.attr_bits & ATTR_NAKED) != 0
            if fn_is_decl(p.ctx, fn_def) == 1
                decl_refused(p.ctx, tok_span_of(p, fn_def.name, fn_def.line), c"[[naked]] fn", StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 }, StrView { ptr: (null), len: (0) as i64 }, c"a naked fn is its asm body")
            asm_check_naked(p.ctx, fn_def)
        let fn_bits: i32 = p.ctx.attr_bits & (ATTR_INLINE | ATTR_ALWAYS_INLINE | ATTR_NOINLINE | ATTR_WIN64 | ATTR_TEST_HELPER | ATTR_MUST_USE | ATTR_NAKED)
        if fn_bits != 0
            item_attr_record(p.ctx, fn_def as *u8, fn_bits)
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

pub fn item_dispatch_struct(p: *Parser, st: *StructDef) -> i32
    # AGAST #4111: noted kept or not; main checks same-named ones conflict.
    var target: u64 = 0
    if (p.ctx.attr_bits & ATTR_TARGET_ANY) != 0
        target = attr_target_key(p.ctx)
    var exists: i32 = 1
    if p.skip_item != 0
        exists = 0
    struct_variant_note(p.tokens, p.pos, StrView { ptr: (st.name), len: (st.name_len) as i64 }, parse_file_copy_shared(p), target, exists)
    if p.skip_item != 0
        gated_decl_log(p.ctx, StrView { ptr: (st.name), len: (st.name_len) as i64 })   # AGAST #3467
    if p.skip_item == 0
        module_add_struct(p.module, st)
        if (p.ctx.attr_bits & ATTR_PACKED) != 0
            item_attr_record(p.ctx, st as *u8, ATTR_PACKED)
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

pub fn item_dispatch_const(p: *Parser, c: *ConstEntry) -> i32
    if p.skip_item != 0
        gated_decl_log(p.ctx, StrView { ptr: (c.name), len: (c.name_len) as i64 })   # AGAST #3467
    if p.skip_item == 0
        if (p.ctx.attr_bits & ATTR_TARGET_ANY) != 0
            c.target_gated = 1
        module_add_const(p.module, c)
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

pub fn item_dispatch_global(p: *Parser, g: *GlobalVarDef) -> i32
    if p.skip_item != 0 and g != null
        gated_decl_log(p.ctx, StrView { ptr: (g.name), len: (g.name_len) as i64 })   # AGAST #3467
    if p.skip_item == 0
        module_add_global_var(p.module, g)
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

pub fn item_dispatch_enum(p: *Parser) -> i32
    # The enum's EnumDef is already in p.module.enums (enum_def_header built
    # it); just reset skip flag and report progress.
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

# =============================================================================
# Top-level parse termination check (AGAST #1301)
# =============================================================================
#
# `item*` in the module rule stops at the first item it cannot parse.  That
# stop is silent by construction: "no more items" and "this item is
# unparseable" look identical to the generated star-loop.  Before this
# check, the consequence was a module containing only the items before the
# failure, emitted as IR with a zero exit status — a genuine parser gap
# reported as an undefined symbol at link time, or (if nothing referenced
# the dropped function) as a silently wrong binary with no error at all.
#
# module_require_eof runs after item* and asserts the whole token stream was
# consumed.  If it wasn't, it reports file:line:col plus the leading tokens
# of the offending construct and sets p.error, which makes parse_module
# return null and the driver exit non-zero *before* any artifact is written.
#
# Fail loudly.  Partial output is strictly worse than a hard error.

# Path of the file currently being parsed, for diagnostics.  Set by the
# driver (main.ritz) before each parse; null renders as "<input>".
# State: ParseCtx.parse_file

# Count of top-level items the anchor-skip recovery had to throw away for
# the module currently being parsed.  Reset by module_new (i.e. once per
# file), checked by module_require_eof.  Non-zero ⇒ hard parse failure.
# State: ParseCtx.dropped_items

# AGAST #2943: the failure point (Parser.max_pos) of the last dropped item
# reported, -1 for none.  Recovery skips one token and re-tries from the next
# anchor, so `pub fn f` fails twice, at `pub` then at `fn`; both attempts stop
# at the same token, and only the first is reported (and counted).
# State: ParseCtx.last_drop_at

# AGAST #3691: set when module_require_eof fails the parse, each of whose
# failure branches has already printed a located error (or, for
# ctx.attr_errors, the refusals were printed where they were written).  The
# driver prints its own fallback only when this is 0.
# State: ParseCtx.parse_reported

pub fn parser_set_source_file(ctx: *ParseCtx, path: *u8)
    ctx.parse_file = path

pub fn parser_reset_diagnostics(ctx: *ParseCtx)
    ctx.dropped_items = 0
    ctx.last_drop_at = -1
    ctx.parse_reported = 0
    ctx.attr_errors = 0
    ctx.attr_last_err = null
    ctx.asm_last_block = null   # AGAST #3394
    ctx.dyn_last = null   # AGAST #2298
    ctx.closure_last = null   # AGAST #3471
    ctx.array_len_line = -1
    ctx.array_len_col = -1

pub fn parser_dropped_items(ctx: *ParseCtx) -> i32
    ctx.dropped_items

# A failed parse that no located diagnostic covered: report it at token
# p.pos (AGAST #3691).  A no-op when module_require_eof already reported it.
pub fn parser_report_unreported(p: *Parser)
    if p.ctx.parse_reported != 0
        return
    parse_error_at(p, p.pos)
    eprints("cannot parse '")
    eprint_construct(p)
    eprintln("'")

# Write a token's raw lexeme (not NUL-terminated) to stderr.
fn eprint_lexeme(start_sv: StrView)
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    if start == null
        return
    var i: i32 = 0
    while i < len
        eprint_char(*(start + i))
        i = i + 1

# Where token `pos` is (0:0 past the end).
fn parse_span_at(p: *Parser, pos: i32) -> SrcSpan
    if pos >= 0 and pos < p.token_count
        let tok: *Token = p.tokens + pos
        return diag_span(tok.line, tok.col)
    diag_span(0, 0)

# `<file>:<line>:<col>: error: ` at token `pos`; the caller writes the rest.
fn parse_error_at(p: *Parser, pos: i32)
    diag_error_at(p.ctx.parse_file, parse_span_at(p, pos))

# Where the token starting at `at` (a name in the source) is; `line`:0 when
# no token starts there.  For an item that keeps only its line (FnDef).
fn tok_span_of(p: *Parser, at: *u8, line: i32) -> SrcSpan
    var i: i32 = 0
    while i < p.token_count
        let t: *Token = p.tokens + i
        if t.start == at
            return diag_span(t.line, t.col)
        i += 1
    diag_span(line, 0)

# Print the leading tokens of the construct at p.pos: the first token's
# lexeme plus, when it is followed by an identifier, that identifier — so
# `fn nested(...)` reports as `fn nested` rather than a bare `fn`.
fn eprint_construct(p: *Parser)
    if p.pos >= p.token_count
        eprints("<end of file>")
        return
    var at: i32 = p.pos
    var tok: *Token = p.tokens + at
    # `pub fn main` reads better than a bare `pub` (AGAST #2943).
    if tok.kind == TOK_PUB and at + 1 < p.token_count
        eprint_lexeme(StrView { ptr: (tok.start), len: (tok.len) as i64 })
        eprint_char(' ')
        at = at + 1
        tok = p.tokens + at
    eprint_lexeme(StrView { ptr: (tok.start), len: (tok.len) as i64 })
    if at + 1 < p.token_count
        let nxt: *Token = p.tokens + (at + 1)
        if nxt.kind == TOK_IDENT
            eprint_char(' ')
            eprint_lexeme(StrView { ptr: (nxt.start), len: (nxt.len) as i64 })

# =============================================================================
# Attributes (LANGUAGE_SPEC §17, AGAST #1847)
# =============================================================================
#
# Attributes are a closed set.  ritz1 used to accept every bare `[[name]]`
# and drop it, so a `[[packed]]` struct got natural alignment and a
# `[[naked]]` fn a prologue — silently.  Now each attribute is honoured or
# is a located error, and ritz0/parser.py ATTRS holds the same table:
#
#   test           fn      ctx.test_fns (the test table, #1908)
#   target_os=".." fn, struct, const   item filtered out unless it matches
#   packed         struct  `<{ ... }>`, no padding, alignment 1
#   inline         fn      LLVM inlinehint
#   always_inline  fn      LLVM alwaysinline
#   noinline       fn      LLVM noinline
#   callconv=".."  fn, extern fn, fn-type alias   "win64" -> win64cc on the
#                          define / declare / call ("c" is the default)
#   naked          fn      the body must be asm blocks with no clause and no
#                          {name} (asm_check_naked); LLVM `naked noinline`,
#                          the blocks then `unreachable` (emit_naked_fn_body,
#                          AGAST #3395)
#
# The grammar runs these actions before it knows which item follows, and it
# backtracks: `attrs` is re-parsed for every `item` alternative tried.  So
# the item kind comes from token lookahead (attr_item_kind), the bits for the
# item are noted in ctx.attr_bits and committed by the item_dispatch_* that
# succeeds, and an error is printed once per attribute token.
# p.error cannot carry the failure — it is the generated parser's
# backtracking signal — so module_require_eof checks ctx.attr_errors.

const ATTR_TEST: i32 = 1
const ATTR_PACKED: i32 = 2
const ATTR_INLINE: i32 = 4
const ATTR_ALWAYS_INLINE: i32 = 8
const ATTR_NOINLINE: i32 = 16
const ATTR_WIN64: i32 = 32       # [[callconv = "win64"]] (AGAST #1879)
const ATTR_TEST_HELPER: i32 = 64 # [[test_helper]]: may `assert` (AGAST #1869)
const ATTR_TARGET_OS: i32 = 128  # any [[target_os = ..]] (AGAST #2149)
const ATTR_TARGET_ARCH: i32 = 1024  # any [[target_arch = ..]] (§17.2, #4117)
# Every [[target_*]] gate: an item carrying one is a gated variant.
const ATTR_TARGET_ANY: i32 = ATTR_TARGET_OS + ATTR_TARGET_ARCH
const ATTR_MUST_USE: i32 = 256   # [[must_use]]: result may not be discarded (AGAST #2137)
const ATTR_NAKED: i32 = 512      # [[naked]]: body is asm only (§17.5, AGAST #3394)

const ATTR_ITEM_OTHER: i32 = 0
const ATTR_ITEM_FN: i32 = 1
const ATTR_ITEM_STRUCT: i32 = 2
const ATTR_ITEM_CONST: i32 = 3
const ATTR_ITEM_EXTERN_FN: i32 = 4
const ATTR_ITEM_FN_ALIAS: i32 = 5    # `type X = fn(..) ..`

# State: ParseCtx.attr_bits
# The [[target_os]] / [[target_arch]] value hashes, read only while their
# bits are noted.  Reset with ctx.attr_bits after each item.
# State: ParseCtx.attr_target_os, .attr_target_arch, .attr_errors, .attr_last_err

# The identity of one gated item's target: the pair of hashes, in a fixed
# order so that two definitions of one name conflict iff they are gated to
# the same pair (0 when ungated).  A single hash cannot tell `linux` from
# `x86_64`, and two attributes must not let the last one win.
fn attr_target_key(ctx: *ParseCtx) -> u64
    struct_variant_target_pair_key(ctx.attr_target_os, ctx.attr_target_arch)

# (item pointer, ATTR_* bits) pairs, for attributes the emitter reads.
# State: ParseCtx.item_attrs, .item_attr_count, .item_attr_cap

# The kind of item the attribute list at p.pos is attached to: skip the rest
# of the attribute lines and a `pub`, then look at the keyword.  The grammar
# runs each entry's action mid-line, just after the entry (`,` or `]]` is at
# p.pos, AGAST #1919), so the current line is skipped first.
fn attr_item_kind(p: *Parser) -> i32
    var i: i32 = p.pos
    while i < p.token_count and (p.tokens + i).kind != TOK_NEWLINE
        i = i + 1
    while i < p.token_count
        let tok: *Token = p.tokens + i
        if tok.kind == TOK_LBRACKET2
            var at_eol: i32 = 0
            while at_eol == 0 and i < p.token_count
                let t2: *Token = p.tokens + i
                if t2.kind == TOK_NEWLINE
                    at_eol = 1
                i = i + 1
        # `async` too (AGAST #1456): `[[inline]] async fn` is a fn item.
        else if tok.kind == TOK_PUB or tok.kind == TOK_ASYNC or tok.kind == TOK_NEWLINE
            i = i + 1
        else if tok.kind == TOK_FN
            return ATTR_ITEM_FN
        else if tok.kind == TOK_STRUCT
            return ATTR_ITEM_STRUCT
        else if tok.kind == TOK_CONST
            return ATTR_ITEM_CONST
        else if tok.kind == TOK_EXTERN and i + 1 < p.token_count and (p.tokens + (i + 1)).kind == TOK_FN
            return ATTR_ITEM_EXTERN_FN
        else if tok.kind == TOK_TYPE and i + 3 < p.token_count and (p.tokens + (i + 3)).kind == TOK_FN
            return ATTR_ITEM_FN_ALIAS
        else
            return ATTR_ITEM_OTHER
    ATTR_ITEM_OTHER

# `<file>:<line>:<col>: error: attribute '<name>' <msg>`, once per token.
fn attr_error(ctx: *ParseCtx, name_sv: StrView, line: i32, col: i32, msg: *u8)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == ctx.attr_last_err
        return
    ctx.attr_last_err = name
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_at(ctx.parse_file, diag_span(line, col))
    eprints("attribute '")
    eprint_lexeme(StrView { ptr: (name), len: (len) as i64 })
    eprints("' ")
    eprintln_cstr(msg)

fn attr_unknown(ctx: *ParseCtx, name_sv: StrView, line: i32, col: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == ctx.attr_last_err
        return
    ctx.attr_last_err = name
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_name(ctx.parse_file, diag_span(line, col), c"unknown attribute '", StrView { ptr: (name), len: (len) as i64 }, c"' (known: always_inline, callconv, inline, must_use, naked, noinline, packed, target_arch, target_os, test, test_helper)")

# 1 for the attributes written bare, `[[name]]`.
fn attr_is_bare_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"test"), len: (4) as i64 }) or (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"packed"), len: (6) as i64 })
        return 1
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"test_helper"), len: (11) as i64 }) or (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"must_use"), len: (8) as i64 })
        return 1
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"naked"), len: (5) as i64 }) or (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"inline"), len: (6) as i64 })
        return 1
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"always_inline"), len: (13) as i64 }) or (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"noinline"), len: (8) as i64 })
        return 1
    0

# Grammar action for `[[name]]`.
pub fn attr_flag(p: *Parser, name_sv: StrView, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var bit: i32 = 0
    var applies_to: i32 = ATTR_ITEM_FN
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"test"), len: (4) as i64 })
        bit = ATTR_TEST
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"test_helper"), len: (11) as i64 })
        bit = ATTR_TEST_HELPER
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"must_use"), len: (8) as i64 })
        bit = ATTR_MUST_USE
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"packed"), len: (6) as i64 })
        bit = ATTR_PACKED
        applies_to = ATTR_ITEM_STRUCT
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"inline"), len: (6) as i64 })
        bit = ATTR_INLINE
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"always_inline"), len: (13) as i64 })
        bit = ATTR_ALWAYS_INLINE
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"noinline"), len: (8) as i64 })
        bit = ATTR_NOINLINE
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"naked"), len: (5) as i64 })
        bit = ATTR_NAKED
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"target_os"), len: (9) as i64 })
        attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"needs a value: [[target_os = <os name string>]]")
        return 0
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"target_arch"), len: (11) as i64 })
        attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"needs a value: [[target_arch = <arch name string>]]")
        return 0
    else if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"callconv"), len: (8) as i64 })
        attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"needs a value: [[callconv = \"win64\"]] or [[callconv = \"c\"]]")
        return 0
    else
        attr_unknown(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col)
        return 0
    if attr_item_kind(p) != applies_to
        if applies_to == ATTR_ITEM_STRUCT
            attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"applies to struct items only")
        else
            attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"applies to fn items only")
        return 0
    p.ctx.attr_bits = p.ctx.attr_bits | bit
    0

# Grammar action for `[[name = "value"]]`.
pub fn attr_kv(p: *Parser, name_sv: StrView, line: i32, col: i32, str_val_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var str_val: *u8 = str_val_sv.ptr
    var str_len: i32 = str_val_sv.len as i32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"target_os"), len: (9) as i64 })
        let tk: i32 = attr_item_kind(p)
        if tk != ATTR_ITEM_FN and tk != ATTR_ITEM_STRUCT and tk != ATTR_ITEM_CONST
            attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"applies to fn, struct or const items only")
            return 0
        p.ctx.attr_bits = p.ctx.attr_bits | ATTR_TARGET_OS
        p.ctx.attr_target_os = struct_variant_target_hash(StrView { ptr: (c"target_os"), len: (9) as i64 }, StrView { ptr: (str_val), len: (str_len) as i64 })   # AGAST #4111
        check_target_os_filter(p, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (str_val), len: (str_len) as i64 })
        return 0
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"target_arch"), len: (11) as i64 })
        let ak: i32 = attr_item_kind(p)
        if ak != ATTR_ITEM_FN and ak != ATTR_ITEM_STRUCT and ak != ATTR_ITEM_CONST
            attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"applies to fn, struct or const items only")
            return 0
        p.ctx.attr_bits = p.ctx.attr_bits | ATTR_TARGET_ARCH
        p.ctx.attr_target_arch = struct_variant_target_hash(StrView { ptr: (c"target_arch"), len: (11) as i64 }, StrView { ptr: (str_val), len: (str_len) as i64 })
        check_target_os_filter(p, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (str_val), len: (str_len) as i64 })
        return 0
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"callconv"), len: (8) as i64 })
        # LANGUAGE_SPEC §17.7 (AGAST #1879).
        let ck: i32 = attr_item_kind(p)
        if ck != ATTR_ITEM_FN and ck != ATTR_ITEM_EXTERN_FN and ck != ATTR_ITEM_FN_ALIAS
            attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"applies to fn, extern fn or fn-type alias items only")
            return 0
        if (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (c"win64"), len: (5) as i64 })
            p.ctx.attr_bits = p.ctx.attr_bits | ATTR_WIN64
        else if not (StrView { ptr: (str_val), len: (str_len) as i64 }).eq(StrView { ptr: (c"c"), len: (1) as i64 })
            if name != p.ctx.attr_last_err
                p.ctx.attr_last_err = name
                p.ctx.attr_errors = p.ctx.attr_errors + 1
                diag_error_name(p.ctx.parse_file, diag_span(line, col), c"unknown calling convention '", StrView { ptr: (str_val), len: (str_len) as i64 }, c"' (known: c, win64)")
        return 0
    if attr_is_bare_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        attr_error(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col, c"takes no value")
        return 0
    attr_unknown(p.ctx, StrView { ptr: (name), len: (len) as i64 }, line, col)
    0

fn item_attr_record(ctx: *ParseCtx, item: *u8, bits: i32)
    if ctx.item_attr_count + 2 > ctx.item_attr_cap
        var cap: i64 = ctx.item_attr_cap * 2
        if cap == 0
            cap = 32
        let grown: *i64 = realloc(ctx.item_attrs as *u8, cap * 8) as *i64
        if grown == null
            eprints("error: ritz1: out of memory recording attributes\n")
            sys_exit(70)
        ctx.item_attrs = grown
        ctx.item_attr_cap = cap
    *(ctx.item_attrs + ctx.item_attr_count) = item as i64
    *(ctx.item_attrs + ctx.item_attr_count + 1) = bits as i64
    ctx.item_attr_count = ctx.item_attr_count + 2

# ATTR_* bits recorded for `item` (by identity), 0 if none.
fn item_attr_bits(ctx: *ParseCtx, item: *u8) -> i32
    let key: i64 = item as i64
    var i: i64 = 0
    while i < ctx.item_attr_count
        if *(ctx.item_attrs + i) == key
            return *(ctx.item_attrs + i + 1) as i32
        i = i + 2
    0

# 1 if `st` was declared `[[packed]]` (or is a clone of one: monomorph marks
# its specialisations with struct_mark_packed).
pub fn struct_is_packed(ctx: *ParseCtx, st: *StructDef) -> i32
    if st == null
        return 0
    if (item_attr_bits(ctx, st as *u8) & ATTR_PACKED) != 0
        return 1
    0

pub fn struct_mark_packed(ctx: *ParseCtx, st: *StructDef)
    item_attr_record(ctx, st as *u8, ATTR_PACKED)

# 1 if `f` was declared `[[naked]]` (§17.5, AGAST #3395).
pub fn fn_is_naked(ctx: *ParseCtx, f: *FnDef) -> i32
    if (item_attr_bits(ctx, f as *u8) & ATTR_NAKED) != 0
        return 1
    0

# 1 if a module interface keeps free fn `f`'s body: `pub` and marked
# [[inline]] or [[always_inline]], eligible or not (AGAST #3585).  A rule on
# the tokens, so iface_text.ritz writes the same text without a Module;
# ritz0's module_interface.inline_kept.  fn_inline_import below decides
# whether the importer defines it.
pub fn fn_inline_kept(ctx: *ParseCtx, f: *FnDef) -> i32
    if f.is_pub == 0
        return 0
    if (item_attr_bits(ctx, f as *u8) & (ATTR_INLINE | ATTR_ALWAYS_INLINE)) == 0
        return 0
    1

# AGAST #3585: 1 if an importer may define `f` `available_externally`, so
# -O2 inlines it across modules without LTO (`syscallN`, ritzlib.sys).  The
# rule is ritz0's (module_interface.inline_import_eligible, which explains
# it): a free `pub` fn marked [[inline]] / [[always_inline]], not generic,
# async, naked, generated or a declaration, whose body names only its params
# and its own locals, through the statements and expressions ii_stmts
# accepts.  Anything else (a call, a module var, a const) could be private
# to the defining module, which the importer cannot link to.  ritz1 also
# refuses an if-expression and a field or index store; ritz0 inlines those,
# which only costs ritz1 the inlining.  Its body is kept (fn_inline_kept);
# emitter.ritz emit_fn defines it.
pub fn fn_inline_import(ctx: *ParseCtx, f: *FnDef) -> i32
    if (item_attr_bits(ctx, f as *u8) & (ATTR_INLINE | ATTR_ALWAYS_INLINE)) == 0
        return 0
    if f.is_pub == 0 or f.type_params != null or f.is_async != 0 or f.from_generated != 0
        return 0
    if f.body == null or fn_is_decl(ctx, f) == 1 or fn_is_naked(ctx, f) == 1
        return 0
    if f.body.kind == StmtKind.Stripped
        return 0
    ii_stmts(f, f.body)

fn ii_same(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var blen: i32 = b_sv.len as i32
    if alen != blen
        return 0
    var i: i32 = 0
    while i < alen
        if *(a + i) != *(b + i)
            return 0
        i = i + 1
    1

# 1 if `name` is one of `f`'s params or a let / var anywhere in `body`.
fn ii_named(f: *FnDef, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var p: *Param = f.params
    while p != null
        if ii_same(StrView { ptr: (p.name), len: (p.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        p = p.next
    ii_declares(f.body, StrView { ptr: (name), len: (len) as i64 })

fn ii_declares(st: *Stmt, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var s: *Stmt = st
    while s != null
        if s.kind == StmtKind.VarDecl and ii_same(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        if s.kind == StmtKind.If
            if ii_declares(s.if_then, StrView { ptr: (name), len: (len) as i64 }) == 1 or ii_declares(s.if_else, StrView { ptr: (name), len: (len) as i64 }) == 1
                return 1
        if s.kind == StmtKind.While and ii_declares(s.while_body, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        s = s.next
    0

fn ii_stmts(f: *FnDef, st: *Stmt) -> i32
    var s: *Stmt = st
    while s != null
        let k: StmtKind = s.kind
        match k
            StmtKind.VarDecl =>
                if s.var_init != null and ii_expr(f, s.var_init) == 0
                    return 0
            StmtKind.Assign =>
                if ii_named(f, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) == 0 or ii_expr(f, s.assign_value) == 0
                    return 0
            StmtKind.Return =>
                if s.return_value != null and ii_expr(f, s.return_value) == 0
                    return 0
            StmtKind.Expr =>
                if ii_expr(f, s.expr) == 0
                    return 0
            StmtKind.If =>
                if ii_expr(f, s.if_cond) == 0 or ii_stmts(f, s.if_then) == 0 or ii_stmts(f, s.if_else) == 0
                    return 0
            StmtKind.While =>
                if ii_expr(f, s.while_cond) == 0 or ii_stmts(f, s.while_body) == 0
                    return 0
            StmtKind.Asm =>
                var o: *AsmOperand = s.asm_block.operands
                while o != null
                    if o.dir != ASM_CLOBBER and ii_named(f, StrView { ptr: (o.name), len: (o.name_len) as i64 }) == 0
                        return 0
                    o = o.next
            _ =>
                if k != StmtKind.Break and k != StmtKind.Continue
                    return 0
        s = s.next
    1

fn ii_expr(f: *FnDef, e: *Expr) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    match k
        ExprKind.IntLit | ExprKind.CharLit | ExprKind.FloatLit | ExprKind.NilLit =>
            return 1
        ExprKind.Ident =>
            return ii_named(f, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        ExprKind.Binary | ExprKind.Index =>
            if ii_expr(f, e.left) == 0
                return 0
            return ii_expr(f, e.right)
        ExprKind.Unary =>
            return ii_expr(f, e.operand)
        ExprKind.Cast | ExprKind.Member =>
            return ii_expr(f, e.left)
        _ => pass
    0

# LLVM fn attribute text for `f`'s inline attribute (with a leading space),
# or "" when it has none.
pub fn fn_inline_attr(ctx: *ParseCtx, f: *FnDef) -> *u8
    let bits: i32 = item_attr_bits(ctx, f as *u8)
    if (bits & ATTR_INLINE) != 0
        return c" inlinehint"
    if (bits & ATTR_ALWAYS_INLINE) != 0
        return c" alwaysinline"
    if (bits & ATTR_NOINLINE) != 0
        return c" noinline"
    c""

# The LLVM calling-convention keyword for `f` with a trailing space
# ("win64cc "), or "" for the C convention (LANGUAGE_SPEC §17.7, AGAST
# #1879).  `f` is a fn, an extern fn, or the signature of a fn type (a
# `[[callconv]]` fn-type alias's, which type_alias_record marks).
pub fn fn_callconv_kw(ctx: *ParseCtx, f: *FnDef) -> *u8
    if f != null and (item_attr_bits(ctx, f as *u8) & ATTR_WIN64) != 0
        return c"win64cc "
    c""

# A monomorph specialisation `dst` carries its template `src`'s
# [[callconv]] (#1879), [[test_helper]] (#1869), [[must_use]] (#2137) and
# [[inline]] / [[always_inline]] / [[noinline]] (#1961) and [[naked]] (§17.5,
# #3633): it calls, is called, may assert, inlines and gets a prologue as the
# template does.  One record: an item's bits are read from its first record
# only (item_attr_bits).
pub fn fn_copy_instance_attrs(ctx: *ParseCtx, dst: *FnDef, src: *FnDef)
    if src == null
        return
    let bits: i32 = item_attr_bits(ctx, src as *u8) & (ATTR_WIN64 | ATTR_TEST_HELPER | ATTR_MUST_USE | ATTR_INLINE | ATTR_ALWAYS_INLINE | ATTR_NOINLINE | ATTR_NAKED)
    if bits != 0
        item_attr_record(ctx, dst as *u8, bits)

# Describe token `pos` for a diagnostic: its quoted lexeme, or a name for
# the layout tokens whose lexeme is whitespace or empty.
fn eprint_token_desc(p: *Parser, pos: i32)
    if pos < 0 or pos >= p.token_count
        eprints("end of file")
        return
    let tok: *Token = p.tokens + pos
    if tok.kind == TOK_EOF
        eprints("end of file")
    else if tok.kind == TOK_NEWLINE
        eprints("end of line")
    else if tok.kind == TOK_INDENT
        eprints("indent")
    else if tok.kind == TOK_DEDENT
        eprints("dedent")
    else
        eprint_char(39 as u8)
        eprint_lexeme(StrView { ptr: (tok.start), len: (tok.len) as i64 })
        eprint_char(39 as u8)

# `::` was removed in RERITZ (LANGUAGE_SPEC §10.2, §15.3) and ritz1.grammar
# has no `::` token: `aa::f` lexes as IDENT `:` `:` IDENT and the parse fails
# at the first `:`.  If the furthest token reached is that `:`, return the
# qualifier's token index so the error names the `a::b` the way ritz0 does
# (AGAST #2600); otherwise -1.  The two colons must touch: `a: :b` is some
# other mistake.
fn qualified_access_at(p: *Parser, fail_at: i32) -> i32
    let c: i32 = fail_at
    if c < 1 or c + 2 >= p.token_count
        return -1
    let qual: *Token = p.tokens + (c - 1)
    let c1: *Token = p.tokens + c
    let c2: *Token = p.tokens + (c + 1)
    let name: *Token = p.tokens + (c + 2)
    if qual.kind != TOK_IDENT or name.kind != TOK_IDENT
        return -1
    if c1.kind != TOK_COLON or c2.kind != TOK_COLON
        return -1
    if c2.line != c1.line or c2.col != c1.col + 1
        return -1
    c - 1

# `file:line:col: error: `q::n`: `::` was removed in RERITZ ...`, worded exactly as
# ritz0's qualified_access_removed (emitter_llvmlite.py) so both compilers
# give one diagnostic.  `qual` is the qualifier's token index.
fn eprint_qualified_access_removed(p: *Parser, qual: i32)
    let q: *Token = p.tokens + qual
    let n: *Token = p.tokens + (qual + 3)
    parse_error_at(p, qual)
    eprint_char(96 as u8)
    eprint_lexeme(StrView { ptr: (q.start), len: (q.len) as i64 })
    eprints("::")
    eprint_lexeme(StrView { ptr: (n.start), len: (n.len) as i64 })
    eprints("`: `::` was removed in RERITZ (LANGUAGE_SPEC §15.3). ")
    eprints("Imported names share one namespace, so write `")
    eprint_lexeme(StrView { ptr: (n.start), len: (n.len) as i64 })
    eprints("`; an enum variant is `")
    eprint_lexeme(StrView { ptr: (q.start), len: (q.len) as i64 })
    eprint_char(46 as u8)
    eprint_lexeme(StrView { ptr: (n.start), len: (n.len) as i64 })
    eprint_char(96 as u8)

# `m.S` as a type: there is no `module.item` access (LANGUAGE_SPEC §15.3,
# AGAST #2215).  The grammar's type is a bare name, so the parse fails at the
# first `.`.  If the furthest token reached is a `.` between two IDENTs, and
# the token before the qualifier starts a type (`:` `:&` `->` `as` `*` `@` `&`
# `<` `,` `]` `=` `(`), return the qualifier's token index; otherwise -1.
fn dotted_type_at(p: *Parser, fail_at: i32) -> i32
    let c: i32 = fail_at
    if c < 2 or c + 1 >= p.token_count
        return -1
    let qual: *Token = p.tokens + (c - 1)
    let dot: *Token = p.tokens + c
    let name: *Token = p.tokens + (c + 1)
    if dot.kind != TOK_DOT or qual.kind != TOK_IDENT or name.kind != TOK_IDENT
        return -1
    let k: i32 = (p.tokens + (c - 2)).kind
    if k == TOK_COLON or k == TOK_COLON_AMP or k == TOK_ARROW or k == TOK_AS or k == TOK_STAR or k == TOK_AT
        return c - 1
    if k == TOK_AMP or k == TOK_LT or k == TOK_COMMA or k == TOK_RBRACKET or k == TOK_EQ
        return c - 1
    if k == TOK_LPAREN
        return c - 1
    -1

# `file:line:col: error: `a.b.S`: there is no `module.item` access ...`, worded as
# ritz0's module_item_access_removed (ritz0/qualified_access.py).  `qual` is
# the first qualifier's token index; the path runs while `.` IDENT follows.
fn eprint_dotted_type_removed(p: *Parser, qual: i32)
    var last: i32 = qual
    while last + 2 < p.token_count and (p.tokens + (last + 1)).kind == TOK_DOT and (p.tokens + (last + 2)).kind == TOK_IDENT
        last = last + 2
    parse_error_at(p, qual)
    eprint_char(96 as u8)
    var i: i32 = qual
    while i <= last
        let t: *Token = p.tokens + i
        eprint_lexeme(StrView { ptr: (t.start), len: (t.len) as i64 })
        if i < last
            eprint_char(46 as u8)
        i = i + 2
    let n: *Token = p.tokens + last
    eprints("`: there is no `module.item` access (LANGUAGE_SPEC §15.3). ")
    eprints("Imported names share one namespace, so write `")
    eprint_lexeme(StrView { ptr: (n.start), len: (n.len) as i64 })
    eprint_char(96 as u8)

# LARB R52 (AGAST #3411, #1622): an alias names one type; `A | B` isn't a
# type and a type name isn't a pattern (LANGUAGE_SPEC §3.8).  ritz1 never had
# either, so both already fail to parse, at the `|` and at the pattern; these
# give that failure ritz0's words (#3409).

fn is_prim_type_tok(k: i32) -> i32
    if k >= TOK_I8 and k <= TOK_BOOL
        return 1
    0

# A token a type is spelled with: `*[N]Vec<fn(i64) -> @&T>` and the like.
fn is_type_tok(k: i32) -> i32
    if is_prim_type_tok(k) == 1 or k == TOK_IDENT or k == TOK_NUMBER or k == TOK_DOT
        return 1
    if k == TOK_STAR or k == TOK_AT or k == TOK_AMP or k == TOK_MUT or k == TOK_FN
        return 1
    if k == TOK_LBRACKET or k == TOK_RBRACKET or k == TOK_LPAREN or k == TOK_RPAREN
        return 1
    if k == TOK_LT or k == TOK_GT or k == TOK_SHR or k == TOK_COMMA or k == TOK_ARROW
        return 1
    0

# 1 if the furthest token reached is a `|` that follows a type in a type
# position: after a `:`, an alias's `=`, or a return type's `->`.  The scan
# back crosses the type's own tokens; anything else (an `as`, an operand's
# `=`) means the `|` was not after a type, and it stays "unexpected '|'".
# A `|` can't fail after a cast's type: there it's a bitwise or (R52a).
fn union_type_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 2 or fail_at >= p.token_count
        return 0
    if (p.tokens + fail_at).kind != TOK_PIPE
        return 0
    let last: i32 = (p.tokens + (fail_at - 1)).kind
    if is_prim_type_tok(last) == 0 and last != TOK_IDENT and last != TOK_GT and last != TOK_SHR and last != TOK_RBRACKET and last != TOK_RPAREN
        return 0
    var seen_arrow: i32 = 0
    var c: i32 = fail_at - 1
    while c >= 0 and is_type_tok((p.tokens + c).kind) == 1
        if (p.tokens + c).kind == TOK_ARROW
            seen_arrow = 1
        c = c - 1
    if c < 0
        return seen_arrow
    let k: i32 = (p.tokens + c).kind
    if k == TOK_COLON or k == TOK_COLON_AMP
        return 1
    if k == TOK_ASSIGN and c >= 2 and (p.tokens + (c - 1)).kind == TOK_IDENT and (p.tokens + (c - 2)).kind == TOK_TYPE
        return 1
    seen_arrow

# 1 if the furthest token reached begins a type used as a match pattern
# (`i64 =>`, `*u8 =>`, `&i32 =>`, or `A(i64) =>`'s payload): a primitive type
# name, `*` or `&`, at an arm's start or as a payload, whose line reaches
# `=>` across type tokens.  A bare IDENT pattern is a binding, so a user
# type's name (`Point =>`) can't be told apart and is not refused.
fn type_pattern_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 1 or fail_at >= p.token_count
        return 0
    let k: i32 = (p.tokens + fail_at).kind
    if is_prim_type_tok(k) == 0 and k != TOK_STAR and k != TOK_AMP
        return 0
    let before: i32 = (p.tokens + (fail_at - 1)).kind
    var at_pattern: i32 = 0
    if before == TOK_NEWLINE or before == TOK_INDENT or before == TOK_DEDENT
        at_pattern = 1
    if before == TOK_LPAREN and fail_at >= 2 and (p.tokens + (fail_at - 2)).kind == TOK_IDENT
        at_pattern = 1
    if at_pattern == 0
        return 0
    var c: i32 = fail_at
    while c < p.token_count and is_type_tok((p.tokens + c).kind) == 1
        c = c + 1
    if c < p.token_count and (p.tokens + c).kind == TOK_FAT_ARROW
        return 1
    0

# LARB R76 (AGAST #4001): a variant's payload pattern is a name or `_`
# (LANGUAGE_SPEC §8.2).  ritz1's grammar takes only a name there, so a nested
# variant pattern (`Ok(Simple(x))`) already fails to parse at its own `(` and
# a literal (`Some(0)`) at the literal; these give that failure ritz0's words.

fn is_literal_tok(k: i32) -> i32
    if k == TOK_NUMBER or k == TOK_FLOAT or k == TOK_STRING or k == TOK_CSTRING or k == TOK_CHAR
        return 1
    if k == TOK_TRUE or k == TOK_FALSE
        return 1
    0

# 1 if the token at `lparen` opens an arm's variant pattern: `V(` or `E.V(`
# at the start of a line whose `)` is followed by `=>`.
fn arm_variant_open_at(p: *Parser, lparen: i32) -> i32
    if lparen < 2 or lparen >= p.token_count
        return 0
    if (p.tokens + lparen).kind != TOK_LPAREN or (p.tokens + (lparen - 1)).kind != TOK_IDENT
        return 0
    var c: i32 = lparen - 2
    if (p.tokens + c).kind == TOK_DOT
        if c < 2 or (p.tokens + (c - 1)).kind != TOK_IDENT
            return 0
        c = c - 2
    let before: i32 = (p.tokens + c).kind
    if before != TOK_NEWLINE and before != TOK_INDENT and before != TOK_DEDENT
        return 0
    # Across the pattern, to the `)` that closes this `(`, then the `=>`.
    var depth: i32 = 0
    var i: i32 = lparen
    while i < p.token_count
        let k: i32 = (p.tokens + i).kind
        if k == TOK_NEWLINE
            return 0
        if k == TOK_LPAREN
            depth = depth + 1
        if k == TOK_RPAREN
            depth = depth - 1
            if depth == 0
                if i + 1 < p.token_count and (p.tokens + (i + 1)).kind == TOK_FAT_ARROW
                    return 1
                return 0
        i = i + 1
    0

# Where the payload pattern that stopped the parse at `fail_at` starts, or -1:
# the literal itself, or the inner variant's name before the `(` it failed at.
fn payload_pattern_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 3 or fail_at >= p.token_count
        return -1
    let k: i32 = (p.tokens + fail_at).kind
    if is_literal_tok(k) == 1 and arm_variant_open_at(p, fail_at - 1) == 1
        return fail_at
    if k == TOK_LPAREN and (p.tokens + (fail_at - 1)).kind == TOK_IDENT and arm_variant_open_at(p, fail_at - 2) == 1
        return fail_at - 1
    -1

# The removed legacy `&T` / `&mut T` type (LANGUAGE_SPEC §3.2, AGAST #1565):
# no type starts with `&`, so a parse that reached one right after a `:` (or a
# `:&`, as in `x:&& T`) stopped there.  1 for `&T`, 2 for `&mut T`, else 0.
# `:&` is one token, so a COLON before the AMP means `name: &T`, which ritz0
# lexes the same way and refuses with the diagnostic eprint_legacy_amp_type
# copies.
fn legacy_amp_type_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 1 or fail_at >= p.token_count
        return 0
    if (p.tokens + fail_at).kind != TOK_AMP
        return 0
    let before: i32 = (p.tokens + (fail_at - 1)).kind
    if before != TOK_COLON and before != TOK_COLON_AMP
        return 0
    if fail_at + 1 < p.token_count and (p.tokens + (fail_at + 1)).kind == TOK_MUT
        return 2
    1

# The spaced `name: = T` / `self: = T` (AGAST #3911): `:=` is one COLON_EQ
# token, so a parse that stopped at an `=` right after a `:` found no type
# there.  ritz0 lexes it the same way and says "Expected type name" at the
# `=` (parser.py _parse_type_primary); 1 if that is where the parse stopped.
fn colon_assign_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 1 or fail_at >= p.token_count
        return 0
    if (p.tokens + fail_at).kind != TOK_ASSIGN
        return 0
    if (p.tokens + (fail_at - 1)).kind != TOK_COLON
        return 0
    1

# LARB R60: a module-level `let` is ritz0's "there is no module-level `let`"
# (parser.py parses it as a global, the emitter refuses it); ritz1 refuses it
# at the `let`, with the same wording so both compilers give one diagnostic.
fn module_let_at(p: *Parser, fail_at: i32) -> i32
    if fail_at < 0 or fail_at >= p.token_count
        return 0
    ((p.tokens + fail_at).kind == TOK_LET) as i32

# ritz0's wording (parser.py _parse_type_primary), so both compilers give one
# diagnostic.  `kind` is legacy_amp_type_at's answer.
fn eprint_legacy_amp_type(p: *Parser, fail_at: i32, kind: i32)
    parse_error_at(p, fail_at)
    if kind == 2
        eprintln("Legacy `&mut T` syntax is no longer supported. Use `@&T` for mutable reference types.")
        eprintln("  RERITZ migration guide:")
        eprintln("    - `&mut T` → `@&T` (mutable reference type)")
        eprints("    - `data: &mut T` → `data:& T` (mutable borrow parameter)")
    else
        eprintln("Legacy `&T` reference syntax is no longer supported. Use `@T` for reference types.")
        eprintln("  RERITZ migration guide:")
        eprintln("    - `&T` → `@T` (immutable reference type)")
        eprints("    - `data: &T` → `data: T` (const borrow is the default)")

# Called by the generated anchor-skip recovery in parse_item BEFORE it
# skips the construct it could not parse.  p.pos is still at the first
# token of that construct (every failed alternative rewinds to start_pos).
#
# The skip itself is fine — it lets us report every bad item in one run —
# but it must not be silent, and it must not leave the parse "successful".
# Recording the drop here is what turns a vanished function into a
# compile-time error instead of a link-time mystery (AGAST #1301).
#
# AGAST #2943: the error is located at p.max_pos, the furthest token any
# attempt reached (the `>>` of `Vec<*Vec<i32>>`, not the fn holding it), and
# a note names the item.  When nothing past the item's first token was
# consumed there is no deeper point, and the item itself is the error.
# AGAST #1819: the farthest EXPECTED-token failure, for the located parse
# error's "expected ..." half.  p_expect calls p_record_fail with the kind it
# wanted; only kinds wanted at the farthest token the parse reached are kept
# (a rewind does not lower the mark, exactly as with max_pos).  The mark is
# reset per top-level item by the generated item loop, so one item's
# speculative failures cannot leak into the next one's diagnostic.
pub fn p_clear_fail(p: *Parser) -> i32
    p.fail_pos = -1
    p.fail_b0 = 0 as u64
    p.fail_b1 = 0 as u64
    p.fail_b2 = 0 as u64
    0

pub fn p_record_fail(p: *Parser, kind: i32) -> i32
    if kind < 0 or kind > 191
        return 0
    if p.fail_pos < 0 or p.pos > p.fail_pos
        p.fail_pos = p.pos
        p.fail_b0 = 0 as u64
        p.fail_b1 = 0 as u64
        p.fail_b2 = 0 as u64
    else if p.pos < p.fail_pos
        return 0
    if kind < 64
        p.fail_b0 = p.fail_b0 | ((1 as u64) << (kind as u64))
    else if kind < 128
        p.fail_b1 = p.fail_b1 | ((1 as u64) << ((kind - 64) as u64))
    else
        p.fail_b2 = p.fail_b2 | ((1 as u64) << ((kind - 128) as u64))
    1

fn fail_bit(p: *Parser, kind: i32) -> i32
    if kind < 64
        return ((p.fail_b0 >> (kind as u64)) & (1 as u64)) as i32
    if kind < 128
        return ((p.fail_b1 >> ((kind - 64) as u64)) & (1 as u64)) as i32
    ((p.fail_b2 >> ((kind - 128) as u64)) & (1 as u64)) as i32

# `; expected one of: fn, struct, ...` — nothing when the parse recorded no
# failed expectation (e.g. a locate-only refusal).
pub fn p_eprint_expected(p: *Parser)
    if p.fail_pos < 0
        return
    var count: i32 = 0
    var k: i32 = 0
    while k < 192
        if fail_bit(p, k) == 1
            count = count + 1
        k = k + 1
    if count == 0
        return
    eprints("; expected ")
    if count > 1
        eprints("one of: ")
    var seen: i32 = 0
    k = 0
    while k < 192
        if fail_bit(p, k) == 1
            if seen > 0
                eprints(", ")
            eprints_cstr(tok_display_name(k))
            seen = seen + 1
        k = k + 1

pub fn parser_report_dropped_item(p: *Parser) -> i32
    # LARB R60: there is no module-level `let`.  ritz0 parses it as a global
    # and the emitter refuses it; ritz1 refuses it at the `let`, with the same
    # wording, so one rule reads the same under both.
    if module_let_at(p, p.pos) == 1
        p.ctx.dropped_items = p.ctx.dropped_items + 1
        parse_error_at(p, p.pos)
        eprints("there is no module-level `let`")
        eprintln("")
        return 1
    let fail_at: i32 = p.max_pos
    if fail_at > p.pos
        if fail_at == p.ctx.last_drop_at
            return 1
        p.ctx.last_drop_at = fail_at
        p.ctx.dropped_items = p.ctx.dropped_items + 1
        let qual: i32 = qualified_access_at(p, fail_at)
        let dotted: i32 = dotted_type_at(p, fail_at)
        let legacy_amp: i32 = legacy_amp_type_at(p, fail_at)
        if legacy_amp > 0
            eprint_legacy_amp_type(p, fail_at, legacy_amp)
        else if colon_assign_at(p, fail_at) == 1
            parse_error_at(p, fail_at)
            eprints("Expected type name")
        else if qual >= 0
            eprint_qualified_access_removed(p, qual)
        else if dotted >= 0
            eprint_dotted_type_removed(p, dotted)
        else if union_type_at(p, fail_at) == 1
            parse_error_at(p, fail_at)
            eprints("`A | B` isn't a type: declare an enum with a payload per kind (LANGUAGE_SPEC §3.8)")
        else if type_pattern_at(p, fail_at) == 1
            parse_error_at(p, fail_at)
            eprints("a type isn't a pattern")
        else if payload_pattern_at(p, fail_at) >= 0
            parse_error_at(p, payload_pattern_at(p, fail_at))
            eprints("a variant's payload pattern is a name or `_`: match the inner value in its own `match`")
        else
            parse_error_at(p, fail_at)
            eprints("unexpected ")
            eprint_token_desc(p, fail_at)
            # Only when the deepest attempt failed exactly here: an
            # expectation recorded further on describes another token.
            if p.fail_pos == fail_at
                p_eprint_expected(p)
        eprintln("")
        eprints("note: ")
        diag_loc(p.ctx.parse_file, parse_span_at(p, p.pos))
        eprints(": ")
    else
        p.ctx.dropped_items = p.ctx.dropped_items + 1
        parse_error_at(p, p.pos)
    eprints("cannot parse item starting at '")
    eprint_construct(p)
    eprints("'")
    # Nothing past the item's first token was consumed (else the detail line
    # above already said what was expected where).
    if fail_at == p.pos
        p_eprint_expected(p)
    eprintln("")
    return 1

pub fn module_require_eof(p: *Parser) -> i32
    tuple_resolve_module(p)   # AGAST #2956: may report, so first
    # A rejected attribute was reported where it was written (#1847).
    if p.ctx.attr_errors > 0
        p.ctx.parse_reported = 1
        p.error = 1
        return 1

    # Any item the recovery skipped is a dropped top-level definition.
    # A file-wide tally, not at a line: `<file>: error: N ...` (#3445).
    if p.ctx.dropped_items > 0
        diag_file_error_at(p.ctx.parse_file)
        eprint_i64(p.ctx.dropped_items as i64)
        eprintln(" top-level item(s) failed to parse; refusing to emit a partial module")
        p.ctx.parse_reported = 1
        p.error = 1
        return 1

    if p.pos >= p.token_count
        return 0
    let tok: *Token = p.tokens + p.pos
    if tok.kind == TOK_EOF
        return 0

    # Unconsumed tokens remain: item* stopped early without recovering.
    parse_error_at(p, p.pos)
    eprints("cannot parse top-level item starting at '")
    eprint_construct(p)
    eprintln("'")
    eprintln("note: the rest of the file was not parsed; refusing to emit a partial module")
    p.ctx.parse_reported = 1
    p.error = 1
    return 1

pub fn module_add_struct(m: *Module, s: *StructDef)
    if m.structs == null
        m.structs = s
    else
        var curr: *StructDef = m.structs
        while curr.next != null
            curr = curr.next
        curr.next = s

pub fn module_add_const(m: *Module, c: *ConstEntry)
    if m.constants == null
        m.constants = c
    else
        var curr: *ConstEntry = m.constants
        while curr.next != null
            curr = curr.next
        curr.next = c

pub fn module_add_import(m: *Module, i: *ImportDecl)
    if m.imports == null
        m.imports = i
    else
        var curr: *ImportDecl = m.imports
        while curr.next != null
            curr = curr.next
        curr.next = i

pub fn module_add_global(m: *Module, g: *GlobalVarDef)
    if m.globals == null
        m.globals = g
    else
        var curr: *GlobalVarDef = m.globals
        while curr.next != null
            curr = curr.next
        curr.next = g

# Alias for generated parser (grammar uses module_add_global_var)
pub fn module_add_global_var(m: *Module, g: *GlobalVarDef)
    module_add_global(m, g)

pub fn module_add_impl(m: *Module, impl_block: *ImplBlock)
    if m.impls == null
        m.impls = impl_block
    else
        var curr: *ImplBlock = m.impls
        while curr.next != null
            curr = curr.next
        curr.next = impl_block

# =============================================================================
# Impl block helpers
# =============================================================================

# Create a new impl block
# For "impl<T> Drop for Vec<T>": trait_name="Drop", type_name="Vec", type_params=<T>
# For "impl<T> Vec<T>": trait_name=nil, type_name="Vec", type_params=<T>
# `impl Index for String` (LANGUAGE_SPEC §7.8, AGAST #1635): `[]` on a Vec,
# Span or String is the language's, so none can implement `Index`, `IndexMut`
# or `IndexSet`.  Located at the type's name; ritz0 says the same
# (ritz0/index_rules.py builtin_impl).  Backtracking can build a block twice:
# its name is reported once.
# State: ParseCtx.index_impl_last_err

fn index_impl_on_builtin(p: *Parser, trait_name_sv: StrView, type_name_sv: StrView)
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    if not (StrView { ptr: (trait_name), len: (trait_len) as i64 }).eq(StrView { ptr: (c"Index"), len: (5) as i64 }) and not (StrView { ptr: (trait_name), len: (trait_len) as i64 }).eq(StrView { ptr: (c"IndexMut"), len: (8) as i64 }) and not (StrView { ptr: (trait_name), len: (trait_len) as i64 }).eq(StrView { ptr: (c"IndexSet"), len: (8) as i64 })
        return
    if not (StrView { ptr: (type_name), len: (type_len) as i64 }).eq(StrView { ptr: (c"Vec"), len: (3) as i64 }) and not (StrView { ptr: (type_name), len: (type_len) as i64 }).eq(StrView { ptr: (c"Span"), len: (4) as i64 }) and not (StrView { ptr: (type_name), len: (type_len) as i64 }).eq(StrView { ptr: (c"String"), len: (6) as i64 })
        return
    if type_name == p.ctx.index_impl_last_err
        return
    p.ctx.index_impl_last_err = type_name
    p.ctx.attr_errors = p.ctx.attr_errors + 1
    diag_error_at(p.ctx.parse_file, tok_span_of(p, type_name, 0))
    eprints("`")
    sys_write(2, type_name, type_len as i64)
    eprints("` is indexed by the language: it can't implement `")
    sys_write(2, trait_name, trait_len as i64)
    eprintln("` (§7.8)")

# AGAST #3015: where the trait name `at` is (R17's rule-1 errors name it).
fn impl_trait_span(p: *Parser, at: *u8, out: *SrcSpan)
    var i: i32 = 0
    while i < p.token_count
        let t: *Token = p.tokens + i
        if t.start == at
            out.line = t.line
            out.col = t.col
            return
        i += 1

# AGAST #3162: where the `impl` keyword of the block naming `type_name` is:
# the nearest `impl` token before that name (`impl<T> Tr for Span<T>` puts
# generic params and a trait name between them).  Zero if not found.
# AGAST #3264: and where that name is, in `at_type` ("unknown type").
fn impl_keyword_span(p: *Parser, type_name: *u8, out: *SrcSpan, at_type: *SrcSpan)
    out.line = 0
    out.col = 0
    at_type.line = 0
    at_type.col = 0
    var i: i32 = 0
    while i < p.token_count
        let t: *Token = p.tokens + i
        if t.start == type_name
            at_type.line = t.line
            at_type.col = t.col
            var k: i32 = i
            while k >= 0
                let kt: *Token = p.tokens + k
                if kt.kind == TOK_IMPL
                    out.line = kt.line
                    out.col = kt.col
                    return
                k = k - 1
            return
        i += 1

# AGAST #3494 (LARB R65): `type_args` is the target's generic arguments as
# written (`<u8>` of `impl G<u8>`), kept so impl_placement.ritz can refuse one
# instantiation and a fixed parameter among several.  Before this the grammar
# parsed them and threw them away, so every impl looked generic.  They land in
# `ImplBlock.impl_args`, which #4002 added for its free-parameter check.
pub fn impl_block_new(p: *Parser, trait_name_sv: StrView, type_name_sv: StrView, type_params: *TypeParam, type_args: *GenericArg, methods: *FnDef) -> *ImplBlock
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    impl_block_core(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (type_name), len: (type_len) as i64 }, type_params, type_args, methods, 0, StrView { ptr: (null), len: (0) as i64 })

# AGAST #4002 (LARB R81): a form whose target is written `Type<args>` keeps
# the arguments, so refuse_impls_on_unknown_types can judge each one.  A
# free `T` in `impl Box<T>` (no `<T>`) is then "unknown type `T`" at its
# `at`, not a mystery at every method signature that spells it.
pub fn impl_block_with_args(p: *Parser, trait_name_sv: StrView, type_name_sv: StrView, args: *GenericArg, type_params: *TypeParam, methods: *FnDef) -> *ImplBlock
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    impl_block_new(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (type_name), len: (type_len) as i64 }, type_params, args, methods)

# AGAST #4294 (R36's revisit): `impl Trait for *u8`.  The target is spelled
# `ptr_u8` — `*` can't appear in an LLVM symbol — and the AST keeps the
# pointee so `Self` in the impl's signatures spells `@*u8`.  Admitted only in
# the trait's file by monomorph's checks; an inherent impl on it is refused.
pub fn impl_block_ptr_new(p: *Parser, trait_name_sv: StrView, pointee_sv: StrView, type_params: *TypeParam, methods: *FnDef, star_line: i32, star_col: i32) -> *ImplBlock
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var pointee: *u8 = pointee_sv.ptr
    var pointee_len: i32 = pointee_sv.len as i32
    let name: *u8 = parser_alloc(p, (pointee_len + 5) as i64)
    *(name + 0) = 112  # 'p'
    *(name + 1) = 116  # 't'
    *(name + 2) = 114  # 'r'
    *(name + 3) = 95   # '_'
    for i in 0..pointee_len
        *(name + 4 + i) = *(pointee + i)
    *(name + 4 + pointee_len) = 0
    let ib: *ImplBlock = impl_block_core(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (name), len: (pointee_len + 4) as i64 }, type_params, null, methods, 1, StrView { ptr: (pointee), len: (pointee_len) as i64 })
    # `ptr_u8` is not in the source, so impl_keyword_span found no token to
    # name: the `*` the target was written with locates the diagnostic.
    if star_line > 0
        ib.type_span.line = star_line
        ib.type_span.col = star_col
    ib

fn impl_block_core(p: *Parser, trait_name_sv: StrView, type_name_sv: StrView, type_params: *TypeParam, impl_args: *GenericArg, methods: *FnDef, ptr_target: i32, ptr_pointee_sv: StrView) -> *ImplBlock
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    var ptr_pointee: *u8 = ptr_pointee_sv.ptr
    var ptr_pointee_len: i32 = ptr_pointee_sv.len as i32
    if trait_name != null
        index_impl_on_builtin(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (type_name), len: (type_len) as i64 })
    let ib: *ImplBlock = parser_alloc(p, sizeof(ImplBlock)) as *ImplBlock
    ib.ptr_target = ptr_target
    ib.trait_span.line = 0
    ib.trait_span.col = 0
    if trait_name != null
        impl_trait_span(p, trait_name, @ib.trait_span)   # AGAST #3015, #4211
    impl_keyword_span(p, type_name, @ib.impl_span, @ib.type_span)   # AGAST #3162, #3264
    ib.def_file = parse_file_copy_shared(p)
    ib.trait_name = trait_name
    ib.trait_name_len = trait_len
    ib.type_name = type_name
    ib.type_name_len = type_len
    ib.type_params = type_params
    ib.impl_args = impl_args
    ib.methods = methods
    ib.next = null
    var mt: *FnDef = methods
    while mt != null
        # AGAST #2913: a method's file, as item_dispatch_fn records a fn's, so
        # an error in an imported generic impl's instance names its module
        # (fn_source_file; specialize_impl_method's clone copies it).  Methods
        # never reach main.ritz's fn-conflict checks: those run on
        # m.functions before monomorph appends the specialised methods.
        mt.def_file = parse_file_copy_shared(p)
        if mt.type_params != null
            generic_method_error(p.ctx, tok_span_of(p, mt.name, mt.line), mt, StrView { ptr: (type_name), len: (type_len) as i64 })
        if type_params != null and fn_is_decl(p.ctx, mt) == 1
            decl_refused(p.ctx, tok_span_of(p, mt.name, mt.line), c"method", StrView { ptr: (mt.name), len: (mt.name_len) as i64 }, StrView { ptr: (type_name), len: (type_len) as i64 }, c"importers instantiate its body")
        if trait_len == 4 and name_is_drop(trait_name) == 1 and mt.name_len == 4 and name_is_drop_fn(mt.name) == 1
            drop_by_value_error(p.ctx, tok_span_of(p, mt.name, mt.line), mt)
        impl_spell_self(p, mt, StrView { ptr: (type_name), len: (type_len) as i64 }, type_params)   # AGAST #3249
        if ptr_target == 1
            impl_spell_self_ptr(mt, StrView { ptr: (ptr_pointee), len: (ptr_pointee_len) as i64 })   # AGAST #4294
        # LANGUAGE_SPEC §15.2: a trait impl's methods need no `pub`; they are
        # reachable wherever the trait is, so a generic over the trait in
        # another file can call them (AGAST #201, as ritz0's parse_impl).
        if trait_name != null
            mt.is_pub = 1
        if type_params == null
            impl_name_bare_self(mt, StrView { ptr: (type_name), len: (type_len) as i64 })
        mt = mt.next
    tn_claim_impl(p.ctx, type_params, methods)   # AGAST #4021
    return ib

# AGAST #3249: `Self` in a method's params and return type is the impl's
# type, as ritz0's parse_impl spells it (#2258).  type_named left it a struct
# named "Self", which nothing resolves, so a by-value `self: Self`, a `by:
# @Self`, a `-> Self` and anything in a generic impl lowered to `unhandled
# ExprKind.Member`.  In `impl<T> Box<T>` it is `Box<T>`, spelled `Box$T` as
# type_generic_with_saved spells it, so monomorph substitutes T in it like
# a written `@Box<T>`.  (This spells from the impl's type params, assuming a
# generic impl's target args are those params in order, as ritz1's are.)
# AGAST #4294 (R36's revisit): `impl Trait for Span<u8>` is one impl block for
# the concrete instance, as ritz0 records it — the target is `Span$u8`, so its
# methods are `Span$u8_show` and its `self` is `@Span$u8`.  A generic impl
# (`impl<T> Trait for Foo<T>`) keeps the base name; monomorph specializes it.
pub fn impl_block_generic_new(p: *Parser, trait_name_sv: StrView, base_sv: StrView, args: *GenericArg, type_params: *TypeParam, methods: *FnDef) -> *ImplBlock
    var trait_name: *u8 = trait_name_sv.ptr
    var trait_len: i32 = trait_name_sv.len as i32
    var base: *u8 = base_sv.ptr
    var base_len: i32 = base_sv.len as i32
    if type_params != null or args == null
        return impl_block_new(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (base), len: (base_len) as i64 }, type_params, args, methods)
    var name_len: i32 = 0
    let name: *u8 = mangle_generic_args(p, StrView { ptr: (base), len: (base_len) as i64 }, args, @name_len)
    let ib: *ImplBlock = impl_block_new(p, StrView { ptr: (trait_name), len: (trait_len) as i64 }, StrView { ptr: (name), len: (name_len) as i64 }, type_params, args, methods)
    # `Span$u8` is not in the source; locate the diagnostic at the base token
    # the user wrote (`Span`), as the pointer target does with its `*`.
    if ib.type_span.line == 0
        impl_keyword_span(p, base, @ib.impl_span, @ib.type_span)
    ib

fn impl_spell_self(p: *Parser, mt: *FnDef, type_name_sv: StrView, type_params: *TypeParam)
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    var self_len: i32 = 0
    let self_name: *u8 = impl_self_spelling(p, StrView { ptr: (type_name), len: (type_len) as i64 }, type_params, @self_len)
    var prm: *Param = mt.params
    while prm != null
        param_spell_self(prm, StrView { ptr: (self_name), len: (self_len) as i64 })
        prm = prm.next
    if name_is_self_type(StrView { ptr: (mt.return_type_name), len: (mt.return_type_name_len) as i64 }) == 1
        mt.return_type_name = self_name
        mt.return_type_name_len = self_len
    param_spell_self(mt.ret_ref, StrView { ptr: (self_name), len: (self_len) as i64 })
    param_spell_self(mt.ret_ptr_array, StrView { ptr: (self_name), len: (self_len) as i64 })
    param_spell_self(mt.ret_array_param, StrView { ptr: (self_name), len: (self_len) as i64 })

fn param_spell_self(prm: *Param, self_name_sv: StrView)
    var self_name: *u8 = self_name_sv.ptr
    var self_len: i32 = self_name_sv.len as i32
    if prm != null and name_is_self_type(StrView { ptr: (prm.param_type_name), len: (prm.param_type_name_len) as i64 }) == 1
        prm.param_type_name = self_name
        prm.param_type_name_len = self_len

# AGAST #4294: `impl Trait for *u8` spells its impl target `ptr_u8`.
# impl_spell_self wrote that name into every `Self`; turn it into the
# `@*u8` the parser builds for that written type: a reference whose pointee
# is a pointer to the scalar, so `*self` is the `*u8`.
fn impl_spell_self_ptr(mt: *FnDef, pointee_sv: StrView)
    var pointee: *u8 = pointee_sv.ptr
    var pointee_len: i32 = pointee_sv.len as i32
    var ptr_name: *u8 = null
    var ptr_len: i32 = 0
    if pointee != null
        ptr_name = pointee
        ptr_len = pointee_len
    var prm: *Param = mt.params
    while prm != null
        param_spell_ptr_self(prm, StrView { ptr: (ptr_name), len: (ptr_len) as i64 })
        prm = prm.next
    if name_matches_ptr_self(StrView { ptr: (mt.return_type_name), len: (mt.return_type_name_len) as i64 }, StrView { ptr: (ptr_name), len: (ptr_len) as i64 }) == 1
        mt.return_type = TypeKind.Ptr
        mt.return_type_name = ptr_name
        mt.return_type_name_len = ptr_len

fn name_matches_ptr_self(name_sv: StrView, pointee_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var pointee: *u8 = pointee_sv.ptr
    var pointee_len: i32 = pointee_sv.len as i32
    if name == null or pointee == null or len != pointee_len + 4
        return 0
    if memcmp(name, c"ptr_", 4) != 0
        return 0
    ((StrView { ptr: (name + 4), len: (len - 4) as i64 }).eq(StrView { ptr: (pointee), len: (pointee_len) as i64 })) as i32

fn param_spell_ptr_self(prm: *Param, pointee_sv: StrView)
    var pointee: *u8 = pointee_sv.ptr
    var pointee_len: i32 = pointee_sv.len as i32
    if prm == null
        return
    if name_matches_ptr_self(StrView { ptr: (prm.param_type_name), len: (prm.param_type_name_len) as i64 }, StrView { ptr: (pointee), len: (pointee_len) as i64 }) == 0
        return
    prm.param_type_name = pointee
    prm.param_type_name_len = pointee_len
    prm.param_pointee_type = TypeKind.Ptr
    prm.param_inner_pointee_type = (scalar_kind_of_name(StrView { ptr: (pointee), len: (pointee_len) as i64 }) as i32)

# The TYPE_* of a scalar's name; TypeKind.Void for anything else.
fn scalar_kind_of_name(name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"u8"), len: (2) as i64 })
        return TypeKind.U8
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"i8"), len: (2) as i64 })
        return TypeKind.I8
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"u16"), len: (3) as i64 })
        return TypeKind.U16
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"i16"), len: (3) as i64 })
        return TypeKind.I16
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"u32"), len: (3) as i64 })
        return TypeKind.U32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"i32"), len: (3) as i64 })
        return TypeKind.I32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"u64"), len: (3) as i64 })
        return TypeKind.U64
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"i64"), len: (3) as i64 })
        return TypeKind.I64
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"bool"), len: (4) as i64 })
        return TypeKind.Bool
    TypeKind.Void

fn name_is_self_type(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len != 4 or name == null
        return 0
    ((StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"Self"), len: (4) as i64 })) as i32

# `Box` for `impl Box`, `Box$K$V` for `impl<K, V> Box<K, V>`.
fn impl_self_spelling(p: *Parser, type_name_sv: StrView, type_params: *TypeParam, out_len: *i32) -> *u8
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    if type_params == null
        *out_len = type_len
        return type_name
    var total: i32 = type_len
    var tp: *TypeParam = type_params
    while tp != null
        total = total + 1 + tp.name_len
        tp = tp.next
    let out: *u8 = parser_alloc(p, (total + 1) as i64)
    var pos: i32 = 0
    for i in 0..type_len
        *(out + pos) = *(type_name + i)
        pos = pos + 1
    tp = type_params
    while tp != null
        *(out + pos) = 36  # '$'
        pos = pos + 1
        for j in 0..tp.name_len
            *(out + pos) = *(tp.name + j)
            pos = pos + 1
        tp = tp.next
    *(out + pos) = 0
    *out_len = pos
    out

# AGAST #1902: a method's own `<...>` (`impl Box` / `fn conv<T>`) is a
# located error.  Monomorph never specialises a method's type params, so the
# call lowered to `call %T @Box_conv` against `declare %T @Box_conv(...)`;
# ritz0 erased T instead.  The spec does not have them, and ritz0's
# parse_impl rejects them with the same message.  Printed once per method
# (the grammar may re-run the action on backtracking); module_require_eof
# fails the parse via ctx.attr_errors, the parse-time error count.
# State: ParseCtx.generic_method_last_err

fn generic_method_error(ctx: *ParseCtx, at: SrcSpan, mt: *FnDef, type_name_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    if mt.name == ctx.generic_method_last_err
        return
    ctx.generic_method_last_err = mt.name
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_at(ctx.parse_file, at)
    eprints("method '")
    eprint_lexeme(StrView { ptr: (mt.name), len: (mt.name_len) as i64 })
    eprints("' of '")
    eprint_lexeme(StrView { ptr: (type_name), len: (type_len) as i64 })
    eprintln("' has its own type parameters; generic methods are not supported -- use a free generic fn")

# =============================================================================
# Declaration-only fns: `fn ... = extern` (LANGUAGE_SPEC §5.3, AGAST #1900)
# =============================================================================
#
# A declared fn or method has the one body every stripped import shares
# (main.ritz strip_to_interface, #1899), so it is emitted exactly as an
# imported definition is: main() never marks it is_local, the call site
# `declare`s it, and emitting it is a hard error.  It can't be null:
# `body == null` means `extern fn`.

# State: ParseCtx.stripped_body

pub fn stripped_body(ctx: *ParseCtx) -> *Stmt
    ctx.stripped_body.kind = StmtKind.Stripped
    ctx.stripped_body.next = null
    @ctx.stripped_body

pub fn fn_is_decl(ctx: *ParseCtx, f: *FnDef) -> i32
    if f.body == @ctx.stripped_body
        return 1
    0

# One error per item name (the grammar may re-run an action on
# backtracking); counted in ctx.attr_errors, which fails the parse.  ritz0
# prints the same words (parser.py DECL_REFUSED).
# State: ParseCtx.decl_last_err

# `owner` (a generic impl's type name) may be null.
fn decl_refused(ctx: *ParseCtx, at: SrcSpan, what: *u8, name_sv: StrView, owner_sv: StrView, why: *u8)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var owner: *u8 = owner_sv.ptr
    var owner_len: i32 = owner_sv.len as i32
    if name == ctx.decl_last_err
        return
    ctx.decl_last_err = name
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_at(ctx.parse_file, at)
    eprints_cstr(what)
    eprints(" '")
    eprint_lexeme(StrView { ptr: (name), len: (name_len) as i64 })
    if owner != null
        eprints("' of generic impl '")
        eprint_lexeme(StrView { ptr: (owner), len: (owner_len) as i64 })
    eprints("' cannot be declaration-only (= extern): ")
    eprintln_cstr(why)

# Grammar action: `[pub] fn name[<T>](params) [-> R] = extern`.
pub fn decl_fn_def_new(p: *Parser, name_sv: StrView, type_params: *TypeParam, params: *Param, ret: *TypeRef, line: i32, col: i32) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if type_params != null
        decl_refused(p.ctx, diag_span(line, col), c"generic fn", StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (null), len: (0) as i64 }, c"importers instantiate its body")
    let f: *FnDef = generic_fn_def_new(p, StrView { ptr: (name), len: (len) as i64 }, type_params, params, ret, stripped_body(p.ctx), line, col)
    # AGAST #3419: as written.  Read from an interface text, where every
    # stripped body is one of these too, load_and_parse corrects it.
    f.extern_decl = 1
    f

# AGAST #4211: every trait declared, in any file parsed (imports count), so
# `impl Nonesuch for X` is "unknown trait" (refuse_impls_on_unknown_types).
# Grammar action of trait_def; a re-parse records a name twice, harmlessly.
# State: ParseCtx.trait_names, .trait_lens
# AGAST #4294: the file each trait was declared in, so a trait impl on a
# primitive/built-in can be admitted only in the trait's file.
# State: ParseCtx.trait_files, .trait_count, .trait_cap

fn dup_parse_file_name(path: *u8) -> *u8
    if path == null
        return null
    var n: i64 = 0
    while *(path + n) != 0
        n = n + 1
    let buf: *u8 = malloc(n + 1)
    var i: i64 = 0
    while i <= n
        *(buf + i) = *(path + i)
        i = i + 1
    buf

pub fn trait_declared_record(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if ctx.trait_count >= ctx.trait_cap
        var cap: i32 = ctx.trait_cap * 2
        if cap == 0
            cap = 64
        ctx.trait_names = realloc(ctx.trait_names as *u8, (cap as i64) * 8) as **u8
        ctx.trait_lens = realloc(ctx.trait_lens as *u8, (cap as i64) * 4) as *i32
        ctx.trait_files = realloc(ctx.trait_files as *u8, (cap as i64) * 8) as **u8
        ctx.trait_cap = cap
    *(ctx.trait_names + ctx.trait_count) = name
    *(ctx.trait_lens + ctx.trait_count) = len
    *(ctx.trait_files + ctx.trait_count) = dup_parse_file_name(ctx.parse_file)
    ctx.trait_count = ctx.trait_count + 1
    0

# The log in parse order, never reset: import_vis marks it before a file is
# parsed and reads what the file added, for R54's selective-list check
# (AGAST #3467), as with type_decl_log.
pub fn trait_declared_count(ctx: *ParseCtx) -> i32
    ctx.trait_count

pub fn trait_declared_at(ctx: *ParseCtx, i: i32, out_len: *i32) -> *u8
    *out_len = *(ctx.trait_lens + i)
    *(ctx.trait_names + i)

pub fn trait_declared(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < ctx.trait_count
        if (StrView { ptr: (*(ctx.trait_names + i)), len: (*(ctx.trait_lens + i)) as i64 }).eq(StrView { ptr: (name), len: (len) as i64 })
            return 1
        i += 1
    0

fn cstr_eq(a: *u8, b: *u8) -> i32
    if a == null or b == null
        return 0
    var i: i64 = 0
    while *(a + i) != 0 and *(b + i) != 0
        if *(a + i) != *(b + i)
            return 0
        i = i + 1
    (*(a + i) == *(b + i)) as i32

# AGAST #4294: is `name` a trait declared in `file`?  The file of the impl
# (ImplBlock.def_file) is compared with the file the trait was parsed from.
pub fn trait_declared_in_file(ctx: *ParseCtx, name_sv: StrView, file: *u8) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if file == null
        return 0
    var i: i32 = 0
    while i < ctx.trait_count
        if (StrView { ptr: (*(ctx.trait_names + i)), len: (*(ctx.trait_lens + i)) as i64 }).eq(StrView { ptr: (name), len: (len) as i64 })
            if cstr_eq(*(ctx.trait_files + i), file) == 1
                return 1
        i += 1
    0

# Grammar action: `fn name(params) [-> R] = extern` in a trait, at the `fn`
# token, as ritz0 reports it (it passed the line only, so col 0: AGAST #3621).
pub fn trait_decl_refused(ctx: *ParseCtx, name_sv: StrView, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    decl_refused(ctx, diag_span(line, col), c"trait method", StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (null), len: (0) as i64 }, c"a trait method is a signature already; drop '= extern'")
    0

# =============================================================================
# Global variable helpers
# =============================================================================

# Grammar action around a global's type.  #4035: the parsed `*TypeRef` answers
# every fact global_var_new needs, including a `fn(..) -> T`'s signature, so
# there is nothing to latch between the type and the initializer.
pub fn capture_global_fn_sig(p: *Parser, tr: *TypeRef) -> *TypeRef
    tr

# Grammar signature: global_var_new(p, name, len, tr, init_expr, line, col)
pub fn global_var_new(p: *Parser, name_sv: StrView, tr: *TypeRef, init_expr: *Expr, line: i32, col: i32) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let var_type: TypeKind = tr_kind(tr)
    array_lit_length_decl(p, tr, init_expr)   # AGAST #3383 (LARB R42)
    # AGAST #190: bumped from 64 → 96 to fit the array_* fields below.
    # Without the extra slack, parser_alloc handed back 64 bytes and the
    # `array_*` writes scribbled past the end of the allocation into the
    # next arena slab — corrupting whatever the parser allocated next.
    # AGAST #1501: 96 → 128 for src_file/line/col (struct is now 104 bytes).
    let g: *GlobalVarDef = parser_alloc(p, sizeof(GlobalVarDef)) as *GlobalVarDef
    g.name = name as *u8
    g.name_len = len
    g.var_type = var_type
    # AGAST #4324: `var g: fn(..) -> T` keeps the signature capture_global_fn_sig
    # latched; every other type has none.
    let f: *TypeFacts = type_facts(p, tr)
    g.fn_sig = null
    if var_type == TypeKind.Ptr or var_type == TypeKind.Array
        g.fn_sig = f.fn_sig
    # For struct types, the TypeRef carries the name.
    if var_type == TypeKind.Struct
        g.type_name = f.type_name
        g.type_name_len = f.type_name_len
    else
        g.type_name = null
        g.type_name_len = 0
    # Capture pointee type for `var g: *T = ...` declarations so emit can
    # scale pointer arithmetic and pick the right load/store width at use
    # sites (TypeKind.I32 → load i32 + add stride 4, etc.).
    if var_type == TypeKind.Ptr or var_type == TypeKind.Ref or var_type == TypeKind.MutRef
        g.pointee_type = f.pointee_type
    else
        g.pointee_type = TypeKind.I64
    g.inner_pointee_type = tr_ptr_ptr_inner_pointee(tr)
    g.inner_ref = f.inner_ref   # AGAST #2399
    g.ptr_array = ptr_array_of_type(p, tr)   # AGAST #2329
    # AGAST #190: capture array dimensions for `var g: [N]T` so the global
    # gets emitted as `[N x %T] zeroinitializer` and indexing GEPs can
    # synthesise the right stride.  Mirrors what var_decl does for locals
    # via stmt.var_array_size / var_array_elem_type.
    if var_type == TypeKind.Array
        g.array_size = f.array_size
        g.array_elem_type = f.array_elem_type
        g.array_elem_pointee = f.array_elem_pointee
        g.array_elem_type_name = f.array_elem_type_name
        g.array_elem_type_name_len = f.array_elem_type_name_len
        g.array_shape = f.array_shape  # AGAST #1509
    else
        g.array_shape = null
        g.array_size = 0
        g.array_elem_type = TypeKind.Void
        g.array_elem_type_name = null
        g.array_elem_type_name_len = 0
    # AGAST #1908: the St of `var g: *St` (struct size 120, within the 128),
    # and #2374: of `var g: @St`, which a method on `g` needs to be judged.
    if (var_type == TypeKind.Ptr or var_type == TypeKind.Ref or var_type == TypeKind.MutRef) and g.pointee_type == TypeKind.Struct
        g.pointee_type_name = f.type_name
        g.pointee_type_name_len = f.type_name_len
    else if var_type == TypeKind.PtrPtr and ptr_ptr_slot_inner(g.inner_pointee_type) == TypeKind.Struct
        # AGAST #1944: and the S of `var g: **S` (any depth), so `*g + 1`
        # strides sizeof(S) as it does for a `**S` param or local.
        g.pointee_type_name = f.type_name
        g.pointee_type_name_len = f.type_name_len
    else
        g.pointee_type_name = null
        g.pointee_type_name_len = 0
    # AGAST #2399: `var g: @*S` is the `**S` it is at runtime, as a field is
    # (lower_ref_fields).  It was recorded as an `@S`, `*S`'s pointee taken for
    # its own: `g = @q` was refused and `g.f` "unhandled EXPR_MEMBER".
    let ref_slot: i32 = ref_field_ptr_ptr_slot(p, tr)
    if ref_slot != (TypeKind.Void as i32)
        g.var_type = TypeKind.PtrPtr
        g.pointee_type = TypeKind.I64
        g.inner_pointee_type = ref_slot
        g.pointee_type_name = f.type_name
        g.pointee_type_name_len = f.type_name_len
    g.init_expr = init_expr
    g.src_file = parse_file_copy(p)
    g.line = line
    g.col = col
    g.next = null
    g.is_extern = 0
    tn_claim(p, null, null)   # AGAST #4021
    g

# AGAST #1554: the S of a `var g: *S`, `@S` or `@&S` global, or null.  It is
# kept in pointee_type_name (#1908); type_name names only a by-value `var g: S`,
# so a reader that asks type_name about a pointer global is told nothing:
# `g.items + 1` through a `*H` global strode 1 byte, and `*g` / `g.f` on an
# `@S` global loaded i64 or found no field.
pub fn global_pointee_struct(g: *GlobalVarDef, out_len: *i32) -> *u8
    *out_len = 0
    if g == null or g.pointee_type != TypeKind.Struct or g.pointee_type_name_len <= 0
        return null
    if g.var_type != TypeKind.Ptr and g.var_type != TypeKind.Ref and g.var_type != TypeKind.MutRef
        return null
    *out_len = g.pointee_type_name_len
    g.pointee_type_name

# `extern var NAME: T` (LANGUAGE_SPEC §5.3, AGAST #1879): a global with no
# definition here.  emit_global_vars declares it `external global`.
pub fn extern_var_new(p: *Parser, name_sv: StrView, tr: *TypeRef, line: i32, col: i32) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let g: *GlobalVarDef = global_var_new(p, StrView { ptr: (name), len: (len) as i64 }, tr, 0 as *Expr, line, col) as *GlobalVarDef
    g.is_extern = 1
    g

# `extern var NAME: T = v` is a located error, not a parse stop: the symbol
# is defined in another object, so there is nothing to initialise.
pub fn extern_var_init_refused(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if p.skip_item == 0
        diag_error_name(p.ctx.parse_file, diag_span(line, col), c"extern var cannot have an initializer: '", StrView { ptr: (name), len: (len) as i64 }, c"' is defined in another object")
        p.ctx.attr_errors = p.ctx.attr_errors + 1
    extern_var_new(p, StrView { ptr: (name), len: (len) as i64 }, type_prim(p, TypeKind.I64), line, col)

# The type a declaration would spell for an untyped global's initializer, as
# ritz0 names it in "a global needs a type" (#3375), or "T" when the parser
# can't tell (a call, an ident, `null`: ritz0 may name more of those).
fn untyped_global_shown(e: *Expr) -> *u8
    match e.kind
        ExprKind.IntLit =>
            if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
                return c"bool"
            if e.lit_kind == LIT_PLAIN
                return c"i64"
            return c"T"
        ExprKind.FloatLit =>
            return c"f64"
        ExprKind.StringLit =>
            return c"StrView"
        ExprKind.CstringLit =>
            return c"*u8"
        ExprKind.CharLit =>
            return c"u8"
        _ => pass
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg
        let o: *Expr = e.operand
        if o.kind == ExprKind.FloatLit or (o.kind == ExprKind.IntLit and o.lit_kind == LIT_PLAIN)
            return untyped_global_shown(o)
    c"T"

# `var g = expr` (LARB R38, #3375): "a global needs a type: write
# `var g: T = ...`" at the `=`.  Counted like a refused attribute so the
# module emits nothing; it returns an i64 stand-in so later passes see no
# hole where the global was.
pub fn global_var_untyped_refused(p: *Parser, name_sv: StrView, init_expr: *Expr, eq_line: i32, eq_col: i32, line: i32, col: i32) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if p.skip_item == 0
        diag_error_at(p.ctx.parse_file, diag_span(eq_line, eq_col))
        eprints("a global needs a type: write `var ")
        var i: i32 = 0
        while i < len
            eprint_char(*(name + i))
            i += 1
        eprints(": ")
        eprints_cstr(untyped_global_shown(init_expr))
        eprints(" = ...`\n")
        p.ctx.attr_errors = p.ctx.attr_errors + 1
    global_var_new(p, StrView { ptr: (name), len: (len) as i64 }, type_prim(p, TypeKind.I64), 0 as *Expr, line, col)

# Copy of the current parse file's path in the parser arena, or null.
# ctx.parse_file itself is borrowed: for an import it points into a String the
# driver drops as soon as that import is parsed, long before emission.
fn parse_file_copy(p: *Parser) -> *u8
    if p.ctx.parse_file == null
        return null
    var n: i64 = 0
    while *(p.ctx.parse_file + n) != 0
        n = n + 1
    let buf: *u8 = parser_alloc(p, n + 1)
    var i: i64 = 0
    while i <= n
        *(buf + i) = *(p.ctx.parse_file + i)
        i = i + 1
    buf

# parse_file_copy, shared between consecutive callers that see the same path.
# AGAST #1364 records a path on every narrow-integer let/var, and a fresh copy
# each time would grow the arena by a path per declaration.  The cache is
# keyed on CONTENT, never on the ctx.parse_file pointer: that String is freed
# after each import, so a later file can arrive at the same address.
# State: ParseCtx.shared_file_copy

fn parse_file_copy_shared(p: *Parser) -> *u8
    if p.ctx.parse_file == null
        return null
    if p.ctx.shared_file_copy != null
        var i: i64 = 0
        while *(p.ctx.parse_file + i) != 0 and *(p.ctx.parse_file + i) == *(p.ctx.shared_file_copy + i)
            i = i + 1
        if *(p.ctx.parse_file + i) == 0 and *(p.ctx.shared_file_copy + i) == 0
            return p.ctx.shared_file_copy
    p.ctx.shared_file_copy = parse_file_copy(p)
    p.ctx.shared_file_copy

# =============================================================================
# Function definition helpers
# =============================================================================

# Link two FnDef nodes - used for building method lists in impl blocks
pub fn fn_link(first: *FnDef, rest: *FnDef) -> *FnDef
    if first == null
        return rest
    first.next = rest
    return first

# Grammar action for the `pub fn` arms (AGAST #3419): marks `f` exported, so a
# call to it from another file is allowed (LARB R45a, LANGUAGE_SPEC §15.2).
pub fn fn_pub(f: *FnDef) -> *FnDef
    if f != null
        f.is_pub = 1
    f

# Set a FnDef's return type and the name a caller can narrow it by, from the
# parsed `*TypeRef` (#4035).  `-> void` (a TypeKind.Struct named `void`) becomes
# TypeKind.Void: `define %void @...` + `ret void zeroinitializer` is not valid IR.
fn set_fn_return(f: *FnDef, p: *Parser, ret: *TypeRef)
    f.return_type = tr_kind(ret)
    ret_name_of_type(p, ret, @f.return_type_name, @f.return_type_name_len)
    let rt: *u8 = f.return_type_name
    if f.return_type == TypeKind.Struct and f.return_type_name_len == 4 and rt != null and *rt == 'v' and *(rt + 1) == 'o' and *(rt + 2) == 'i' and *(rt + 3) == 'd'
        f.return_type = TypeKind.Void
        f.return_type_name = null
        f.return_type_name_len = 0

pub fn fn_def_new(p: *Parser, name_sv: StrView, params: *Param, ret: *TypeRef, body: *Stmt, line: i32, col: i32) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.name = name as *u8
    f.name_len = len
    f.params = params
    f.ret_fn_sig = fn_ret_fn_sig(ret)               # AGAST #2120
    f.ret_ref = fn_ret_ref(p, ret)                  # AGAST #2308
    f.ret_array = fn_ret_array(p, ret)              # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(p, ret)      # AGAST #2329
    f.ret_array_param = fn_ret_array_param(p, ret)  # AGAST #2302
    set_fn_return(f, p, ret)
    f.body = body
    f.line = line
    f.next = null
    f.type_params = null  # Non-generic function (field at end to preserve layout)
    f.is_local = 0  # AGAST #194: main() flips this to 1 for the input file's fns.
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    f.is_pub = 0   # AGAST #3419: fn_pub sets it for a `pub fn`
    f.col = col
    f.extern_decl = 0   # AGAST #3419: decl_fn_def_new sets it
    tn_claim(p, f.type_params, f)   # AGAST #4021
    return f

# Extern function declaration (no body) - forward declaration
pub fn extern_fn_def_new(p: *Parser, name_sv: StrView, params: *Param, ret: *TypeRef, line: i32, col: i32) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.name = name as *u8
    f.name_len = len
    f.params = params
    f.ret_fn_sig = fn_ret_fn_sig(ret)               # AGAST #2120
    f.ret_ref = fn_ret_ref(p, ret)                  # AGAST #2308
    f.ret_array = fn_ret_array(p, ret)              # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(p, ret)      # AGAST #2329
    f.ret_array_param = fn_ret_array_param(p, ret)  # AGAST #2302
    set_fn_return(f, p, ret)
    f.body = null  # No body for extern functions
    f.line = line
    f.next = null
    f.type_params = null  # Non-generic function (field at end to preserve layout)
    f.is_local = 0
    f.def_file = null
    f.target_gated = 0
    f.from_generated = 0
    f.is_pub = 0
    f.col = col
    f.extern_decl = 0
    tn_claim(p, f.type_params, f)   # AGAST #4021
    return f

# =============================================================================
# Parameter helpers
# =============================================================================

# AGAST #2139: 1 when the just-parsed param type `tr` names a struct: a struct,
# or a pointer / reference whose (innermost) pointee is one.  `*[N]S` /
# `@[N]S` keep S, and `name:& *S` (a TypeKind.MutRef to a TypeKind.Ptr, #2075) keeps
# S, as before.
fn param_type_names_pointee(p: *Parser, tr: *TypeRef) -> i32
    if tr == null
        return 0
    match tr.kind
        TypeKind.Struct =>
            return 1
        TypeKind.Ptr =>
            # AGAST #2145: a `fn(...) -> T` type is a TypeKind.Ptr too but names no
            # pointee; copying one made `f.w` GEP into an earlier param's S.
            if tr.fn_sig != null
                return 0
            let po: *TypeRef = tr.pointee
            if po == null
                return 0
            if po.kind == TypeKind.Struct
                return 1
            if po.kind == TypeKind.Array and po.elem != null
                if po.elem.kind == TypeKind.Struct
                    return 1
                # AGAST #2343: `*[N]*S`, as a by-value `[N]*S` is named.
                if po.elem.kind == TypeKind.Ptr and tr_pointee_kind(po.elem) == TypeKind.Struct
                    return 1
            return 0
        TypeKind.PtrPtr =>
            if ptr_ptr_slot_inner(tr_ptr_ptr_inner_pointee(tr)) == TypeKind.Struct
                return 1
            let arr: *TypeRef = tr_ptr_array(tr)
            if arr != null and arr.elem != null and arr.elem.kind == TypeKind.Struct
                return 1   # AGAST #2553: `**[N]S`
            if ptr_names_array_of_struct_ptrs(p, tr) == 1   # AGAST #3074: `**[N]*S`
                return 1
            return 0
        TypeKind.Ref | TypeKind.MutRef =>
            if tr.ref_inner == TypeKind.Struct
                return 1
            if tr.ref_inner == TypeKind.Ptr and tr_pointee_kind(tr.pointee) == TypeKind.Struct
                return 1
            # AGAST #2331: `@*[N]S` and `@&*[N]S`, as `**[N]S` (name_array_ptr_param).
            let arr: *TypeRef = tr_ptr_array(tr)
            if arr != null and arr.elem != null and arr.elem.kind == TypeKind.Struct
                return 1
            if ptr_names_array_of_struct_ptrs(p, tr) == 1   # AGAST #3074: `@*[N]*S`
                return 1
            # AGAST #2372: `@**S`, as `**S` is named above.
            if tr.ref_inner == TypeKind.PtrPtr and ptr_ptr_slot_inner(tr_ptr_ptr_inner_pointee(tr)) == TypeKind.Struct
                return 1
            if tr.ref_inner == TypeKind.Array and tr.pointee != null and tr.pointee.elem != null
                if tr.pointee.elem.kind == TypeKind.Struct
                    return 1
                if tr.pointee.elem.kind == TypeKind.Ptr and tr_pointee_kind(tr.pointee.elem) == TypeKind.Struct
                    return 1   # AGAST #2343: `@[N]*S`
            return 0
        _ => pass
    return 0

# AGAST #3074: 1 for `**[N]*S`, `@*[N]*S` or `@&*[N]*S`, one level out from the
# `*[N]*S` named above.  Unnamed, `(*q)[i].f` was "unhandled EXPR_MEMBER".  The
# emitter keeps S off the local's type_name (name_array_ptr_param).
fn ptr_names_array_of_struct_ptrs(p: *Parser, tr: *TypeRef) -> i32
    if tr == null or tr.kind == TypeKind.Ptr or tr_ptr_array(tr) == null
        return 0
    let arr: *TypeRef = tr_ptr_array(tr)
    if arr.elem == null
        return 0
    (arr.elem.kind == TypeKind.Ptr and tr_pointee_kind(arr.elem) == TypeKind.Struct) as i32

pub fn param_new(p: *Parser, name_sv: StrView, ty: *TypeRef, line: i32, col: i32) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #3634: a by-value `[N][M]T` keeps its shape (param_of_type).
    note_pass_binding(p.ctx, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3320
    let param: *Param = param_of_type(p, StrView { ptr: (name), len: (len) as i64 }, ty)
    param.name_span.line = line   # AGAST #2407
    param.name_span.col = col
    return param

# The just-parsed type `tr` as a param declares it.  AGAST #2308: a `@T` local
# or return type is recorded this way too, so they all know the same things.
fn param_of_type(p: *Parser, name_sv: StrView, ty: *TypeRef) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let kind: TypeKind = tr_kind(ty)
    let param: *Param = parser_alloc(p, sizeof(Param)) as *Param
    param.name = name as *u8
    param.param_ty = ty   # AGAST #4528
    param.name_span.line = 0
    param.name_span.col = 0
    param.name_len = len
    param.param_type = kind
    # Copy the struct type name for a struct, or a pointer / reference whose
    # pointee is a named type.  AGAST #2139: only then.
    var nm_len: i32 = 0
    if param_type_names_pointee(p, ty) == 1
        param.param_type_name = tr_name(ty, @nm_len)
        param.param_type_name_len = nm_len
    else if kind == TypeKind.Array
        param.param_type_name = tr_elem_name(ty, @nm_len)
        param.param_type_name_len = nm_len
    else
        param.param_type_name = null
        param.param_type_name_len = 0
    # Copy pointee/inner type if this is a pointer or reference type.
    match kind
        TypeKind.Ptr | TypeKind.PtrPtr =>
            param.param_pointee_type = tr_pointee_kind(ty)
        TypeKind.Ref | TypeKind.MutRef =>
            param.param_pointee_type = tr_ref_inner(ty)
        _ =>
            param.param_pointee_type = TypeKind.I64  # Default
    param.param_inner_pointee_type = tr_ptr_ptr_inner_pointee(ty)
    param.param_inner_ref = tr_inner_ref(ty)   # AGAST #2399
    param.param_pointee_array_size = ptr_array_pointee_size(p, ty)
    param.param_pointee_array_elem_type = ptr_array_pointee_elem(p, ty)
    param.param_pointee_array_elem_pointee = ptr_array_elem_pointee(p, ty)
    # AGAST #2279, #2287: `@[N]T` and `@&[N]T` keep N and T, as `*[N]T` does.
    param.param_pointee_array_shape = null
    if (kind == TypeKind.Ref or kind == TypeKind.MutRef) and tr_ref_inner(ty) == TypeKind.Array and ty.pointee != null
        let arr: *TypeRef = ty.pointee
        param.param_pointee_array_size = tr_count(arr) as i32
        param.param_pointee_array_elem_type = tr_elem_kind(arr)
        param.param_pointee_array_elem_pointee = tr_elem_pointee(arr)
        param.param_pointee_array_shape = tr_shape(arr)
    let nd: *ArrayShape = ptr_nd_pointee_shape(p, ty)   # AGAST #2098: `*[N][M]T`
    if nd != null
        param.param_pointee_array_size = nd_shape_count(nd)
        param.param_pointee_array_elem_type = nd.leaf_type
        param.param_pointee_array_elem_pointee = nd.leaf_pointee
        param.param_pointee_array_shape = nd
    param.param_ref_ptr_pointee = TypeKind.Void
    if (kind == TypeKind.Ref or kind == TypeKind.MutRef) and tr_ref_inner(ty) == TypeKind.Ptr
        param.param_ref_ptr_pointee = tr_pointee_kind(ty.pointee)
    param.param_array_size = 0
    param.param_array_elem_type = TypeKind.Void
    param.param_array_elem_pointee = TypeKind.Void
    param.param_array_shape = null
    if kind == TypeKind.Array
        param.param_array_size = tr_count(ty) as i32
        param.param_array_elem_type = tr_elem_kind(ty)
        param.param_array_elem_pointee = tr_elem_pointee(ty)
        param.param_array_shape = tr_shape(ty)   # AGAST #3634: `[N][M]T`
    param.next = null
    param.is_borrow = 0
    param.is_self_borrow = 0
    # AGAST #1671: a `fn(...) -> T` param keeps its signature.
    param.fn_sig = null
    if kind == TypeKind.Ptr
        param.fn_sig = tr_fn_sig(ty)
    return param

# AGAST #2329: the just-parsed `tr` as a param would hold it, when it's a
# `*[N]T`, `@[N]T` or `@&[N]T`, so a field, a global or a return type knows N
# and T, and `x[i]` on one is element i at stride T, as on a local (#2330,
# LARB R9).  null for any other type.
pub fn ptr_array_of_type(p: *Parser, tr: *TypeRef) -> *Param
    if tr == null
        return null
    if tr.kind == TypeKind.Ptr and tr.pointee != null and tr.pointee.kind == TypeKind.Array
        return param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, tr)
    if (tr.kind == TypeKind.Ref or tr.kind == TypeKind.MutRef) and tr_ref_inner(tr) == TypeKind.Array
        return param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, tr)
    # AGAST #4122: and a `**[N][M]..T`, the shape of the `*[N][M]..T` that `*x`
    # reads (plane_ptr_shape; base_ptr_array itself answers for `*` only).
    if tr.kind == TypeKind.PtrPtr and ptr_nd_pointee_shape(p, tr) != null
        return param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, tr)
    null

# `name:& T` (AGAST #1644): a TypeKind.MutRef param that ritz0 auto-derefs.
pub fn param_borrow(p: *Parser, name_sv: StrView, ty: *TypeRef, line: i32, col: i32) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let param: *Param = param_new(p, StrView { ptr: (name), len: (len) as i64 }, ty, line, col)
    param.is_borrow = 1
    # AGAST #2075: for `name:& *T` keep T (the borrowed pointer's own
    # pointee).  The emitter binds the borrow as a plain `*T` local, as ritz0
    # does (see bind_scalar_borrow_param).  Only a borrow uses the field this
    # way: param_new leaves it TypeKind.Void for every other `@&*T`.
    if ty != null and ty.kind == TypeKind.MutRef and tr_ref_inner(ty) == TypeKind.Ptr
        param.param_inner_pointee_type = (tr_pointee_kind(ty.pointee) as i32)
    return param

# `self:& T` (AGAST #2286): see Param.is_self_borrow.
pub fn param_self_borrow(p: *Parser, name_sv: StrView, ty: *TypeRef, line: i32, col: i32) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let param: *Param = param_new(p, StrView { ptr: (name), len: (len) as i64 }, ty, line, col)
    param.is_self_borrow = 1
    return param

pub fn param_link(first: *Param, rest: *Param) -> *Param
    first.next = rest
    return first

# Untyped `self` receiver in impl methods: `fn foo(self)` or `fn foo(self:&)`.
# impl_block_new names the type of a bare `self`, which makes it `self: T`, and
# emit_impl_method takes the type of a `self:&` from the ImplBlock.  Typed
# `self: T` / `self:& T` receivers do not come here: the grammar passes T to
# param_new, as it does for any other name (AGAST #1375, #1632).
pub fn param_self(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # A nameless TypeKind.Struct: any earlier type name is not this one's.
    return param_new(p, StrView { ptr: (name), len: (len) as i64 }, typeref_new(p, TypeKind.Struct), line, col)

# Bare `self:&`: the caller's place, where a bare `self` is a copy (AGAST #2393).
pub fn param_self_lent(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let param: *Param = param_self(p, StrView { ptr: (name), len: (len) as i64 }, line, col)
    param.is_self_borrow = 1
    return param

# 1 for a param named `self`.
pub fn param_is_self(p: *Param) -> i32
    if p == null or p.name_len != 4
        return 0
    if *p.name == 's' and *(p.name + 1) == 'e' and *(p.name + 2) == 'l' and *(p.name + 3) == 'f'
        return 1
    0

# 1 for a `self` passed as a `ptr`: a reference, a pointer or `self:&`.  A by-value
# `self` isn't: it's a by-value param, and goes as `s: T` goes (LARB R10, AGAST
# #2393).  A receiver whose type isn't a named struct or enum stays a `ptr`.
pub fn param_self_is_ptr(p: *Param) -> i32
    if param_is_self(p) == 0
        return 0
    if p.param_type == TypeKind.Struct and p.is_self_borrow == 0 and p.param_type_name_len > 0
        return 0
    1

# 1 for a by-value `self`.
pub fn param_self_is_value(p: *Param) -> i32
    if param_is_self(p) == 1 and param_self_is_ptr(p) == 0
        return 1
    0

fn name_is_drop(n: *u8) -> i32
    (*n == 'D' and *(n + 1) == 'r' and *(n + 2) == 'o' and *(n + 3) == 'p') as i32

fn name_is_drop_fn(n: *u8) -> i32
    (*n == 'd' and *(n + 1) == 'r' and *(n + 2) == 'o' and *(n + 3) == 'p') as i32

# `fn drop(self)`: its own `self` would drop when it returned, and call it again
# (AGAST #2393).  ritz0 prints the same words (ref_rules.DROP_BY_VALUE).  Once per
# method: the grammar may re-run the action on backtracking.
# State: ParseCtx.drop_last_err

fn drop_by_value_error(ctx: *ParseCtx, at: SrcSpan, m: *FnDef)
    let p: *Param = m.params
    if param_is_self(p) == 0 or p.param_type != TypeKind.Struct or p.is_self_borrow == 1 or m == ctx.drop_last_err
        return
    ctx.drop_last_err = m
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error(ctx.parse_file, at, c"`drop` can't take `self` by value: it would drop itself: write `self: @&T`")

# A bare `self` is `self: T` (AGAST #2393).  A generic impl's T is named when it's
# specialised, so that one stays as it was parsed.
fn impl_name_bare_self(m: *FnDef, type_name_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    let p: *Param = m.params
    if param_is_self(p) == 0 or p.param_type != TypeKind.Struct or p.is_self_borrow == 1 or p.param_type_name_len > 0
        return
    p.param_type_name = type_name
    p.param_type_name_len = type_len

# =============================================================================
# Struct definition helpers
# =============================================================================

pub fn struct_def_new(p: *Parser, name_sv: StrView, fields: *StructField, line: i32, col: i32) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *StructDef = parser_alloc(p, sizeof(StructDef)) as *StructDef
    s.name = name as *u8
    s.name_len = len
    s.fields = fields
    s.next = null
    s.type_params = null  # Non-generic struct (field at end to preserve layout)
    s.def_file = parse_file_copy_shared(p)   # AGAST #3494 (R65)
    return s

# AGAST #2399: the inner pointee slot of the `**S` (or deeper) that a just-parsed
# reference field to a pointer to a struct is at runtime; TypeKind.Void for any other.
fn ref_field_ptr_ptr_slot(p: *Parser, tr: *TypeRef) -> i32
    let ty: TypeKind = tr_kind(tr)
    if ty != TypeKind.Ref and ty != TypeKind.MutRef
        return (TypeKind.Void as i32)
    let rf: TypeKind = tr_ref_inner(tr)
    if rf == TypeKind.Ptr and tr_pointee_kind(tr.pointee) == TypeKind.Struct
        return (TypeKind.Struct as i32)
    if rf != TypeKind.PtrPtr
        return (TypeKind.Void as i32)
    let slot: i32 = tr_ptr_ptr_inner_pointee(tr)
    if ptr_ptr_slot_inner(slot) != TypeKind.Struct
        return (TypeKind.Void as i32)
    ptr_slot_deepen(slot, 1)

pub fn field_new(p: *Parser, name_sv: StrView, tr: *TypeRef, line: i32, col: i32) -> *StructField
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let facts: *TypeFacts = type_facts(p, tr)
    let ty: TypeKind = facts.kind
    let f: *StructField = parser_alloc(p, sizeof(StructField)) as *StructField
    f.field_mut_ref = 0
    f.field_shared_ref = 0
    # AGAST #2097: an N-D field keeps its shape.
    f.array_shape = null
    if is_nd_array_type(p, tr) == 1
        f.array_shape = facts.array_shape
    f.name = name as *u8
    # AGAST #1924: `rows: **i32` -> `*(*(s.rows + i) + k)` loads an i32.
    # The slot (AGAST #1815 / #2372): a `@S` field records none, as the flat
    # parse left it, so lowered_field_type still makes it a `*S`.
    f.inner_pointee_type = tr_ptr_ptr_inner_pointee(tr)
    f.field_inner_ref = facts.inner_ref   # AGAST #2399
    f.name_len = len
    f.field_type = ty
    f.ptr_pointee = TypeKind.Void
    if ty == TypeKind.Ptr
        f.ptr_pointee = facts.pointee_type
    f.ptr_array = ptr_array_of_type(p, tr)   # AGAST #2329
    # AGAST #2120: `f: EfiFn` keeps the signature, so `(t.f)(..)` calls typed.
    f.fn_sig = null
    if ty == TypeKind.Ptr
        f.fn_sig = facts.fn_sig
    # AGAST #3666: `fs: [N]fn(..) -> T` ends with its element's fn type too.
    f.elem_fn_sig = null
    if ty == TypeKind.Array
        f.elem_fn_sig = facts.fn_sig
    # Copy struct type name if this is a struct-typed field OR a pointer-to-struct
    # field.  It comes from the chain, never from a sibling field.
    match ty
        TypeKind.Struct =>
            f.field_type_name = facts.type_name
            f.field_type_name_len = facts.type_name_len
        TypeKind.Ptr =>
            if facts.pointee_type == TypeKind.Struct
                f.field_type_name = facts.type_name
                f.field_type_name_len = facts.type_name_len
            else
                f.field_type_name = null
                f.field_type_name_len = 0
        TypeKind.PtrPtr =>
            if facts.inner_pointee_type == (TypeKind.Struct as i32)
                f.field_type_name = facts.type_name
                f.field_type_name_len = facts.type_name_len
            else
                f.field_type_name = null
                f.field_type_name_len = 0
        TypeKind.Ref | TypeKind.MutRef =>
            if facts.ref_inner_type == TypeKind.Struct
                f.field_type_name = facts.type_name
                f.field_type_name_len = facts.type_name_len
            else if ref_field_ptr_ptr_slot(p, tr) != (TypeKind.Void as i32)
                f.field_type_name = facts.type_name
                f.field_type_name_len = facts.type_name_len
                f.inner_pointee_type = ref_field_ptr_ptr_slot(p, tr)
            else
                f.field_type_name = null
                f.field_type_name_len = 0
        _ =>
            f.field_type_name = null
            f.field_type_name_len = 0
    # Copy array info if this is an array type.
    if ty == TypeKind.Array
        f.array_size = facts.array_size
        f.array_elem_type = facts.array_elem_type
        f.array_elem_pointee = facts.array_elem_pointee
        f.array_elem_type_name = facts.array_elem_type_name
        f.array_elem_type_name_len = facts.array_elem_type_name_len
    else
        f.array_size = 0
        f.array_elem_type = TypeKind.Void
        f.array_elem_type_name = null
        f.array_elem_type_name_len = 0
        # AGAST #1304: record the pointee of a primitive pointer field.
        if ty == TypeKind.Ptr and facts.pointee_type != TypeKind.Struct
            f.array_elem_type = facts.pointee_type
        # AGAST #2050: a ref to a primitive records its pointee the same way.
        if ty == TypeKind.Ref or ty == TypeKind.MutRef
            f.field_mut_ref = (ty == TypeKind.MutRef) as i32
            f.field_shared_ref = (ty == TypeKind.Ref) as i32
            let rt: TypeKind = facts.ref_inner_type
            if ty_int_in(rt, 8, 16) == 1
                f.array_elem_type = rt
            else if ty_int_in(rt, 32, 64) == 1
                f.array_elem_type = rt
            else if rt == TypeKind.F32 or rt == TypeKind.F64 or rt == TypeKind.Bool
                f.array_elem_type = rt
    # AGAST #3151: `r: @&*U` keeps U.
    f.field_ref_ptr_pointee = TypeKind.Void
    if (ty == TypeKind.Ref or ty == TypeKind.MutRef) and facts.ref_inner_type == TypeKind.Ptr
        f.field_ref_ptr_pointee = facts.pointee_type
        if ref_field_scalar_pointee(f) == 1
            f.inner_pointee_type = (facts.pointee_type as i32)
    f.next = null
    return f

# AGAST #3151: 1 for an `@*U` / `@&*U` field of a scalar U, a `**U` at runtime
# (lower_ref_fields), as an `@*S` is a `**S`.
pub fn ref_field_scalar_pointee(f: *StructField) -> i32
    let u: TypeKind = f.field_ref_ptr_pointee
    if ty_int_in(u, 8, 16) == 1
        return 1
    if ty_int_in(u, 32, 64) == 1
        return 1
    (u == TypeKind.F32 or u == TypeKind.F64 or u == TypeKind.Bool) as i32

# What an `@T` / `@&T` field `f` is once emit_module's lower_ref_fields has made
# it a pointer: `@*S` a `**S` (AGAST #2399), `@&*i64` a `**i64` (#3151), any
# other with a struct name or an integer pointee a `*T`.  Any other field is
# its own type.  Sema runs before the lowering and asks it (AGAST #3926).
pub fn lowered_field_type(f: *StructField) -> TypeKind
    if f.field_type != TypeKind.Ref and f.field_type != TypeKind.MutRef
        return f.field_type
    if f.field_type_name_len > 0 and ptr_ptr_slot_inner(f.inner_pointee_type) == TypeKind.Struct
        return TypeKind.PtrPtr
    if ref_field_scalar_pointee(f) == 1
        return TypeKind.PtrPtr
    if f.field_type_name_len > 0 or f.array_elem_type != TypeKind.Void
        return TypeKind.Ptr
    f.field_type

# Type parameter helpers (for generics)
pub fn type_param_new(p: *Parser, name_sv: StrView) -> *TypeParam
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let tp: *TypeParam = parser_alloc(p, sizeof(TypeParam)) as *TypeParam
    tp.name = name as *u8
    tp.name_len = len
    tp.next = null
    tp.bounds = null
    return tp

# `T: A + B` (AGAST #3469): the parameter with its bound's traits.
pub fn type_param_bounded(p: *Parser, name_sv: StrView, bounds: *TraitBound) -> *TypeParam
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let tp: *TypeParam = type_param_new(p, StrView { ptr: (name), len: (len) as i64 })
    tp.bounds = bounds
    return tp

pub fn trait_bound_new(p: *Parser, name_sv: StrView, line: i32, col: i32, rest: *TraitBound) -> *TraitBound
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let b: *TraitBound = parser_alloc(p, sizeof(TraitBound)) as *TraitBound
    b.name = name
    b.name_len = len
    b.span = diag_span(line, col)
    b.file = parse_file_copy_shared(p)
    b.next = rest
    return b

pub fn type_param_link(first: *TypeParam, rest: *TypeParam) -> *TypeParam
    first.next = rest
    return first

# Generic function definition (with type parameters)
pub fn generic_fn_def_new(p: *Parser, name_sv: StrView, type_params: *TypeParam, params: *Param, ret: *TypeRef, body: *Stmt, line: i32, col: i32) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    p.ctx.pass_bound = 0   # AGAST #3320: this fn's `pass` bindings end with it
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.name = name as *u8
    f.name_len = len
    f.params = params
    f.ret_fn_sig = fn_ret_fn_sig(ret)               # AGAST #2120
    f.ret_ref = fn_ret_ref(p, ret)                  # AGAST #2308
    f.ret_array = fn_ret_array(p, ret)              # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(p, ret)      # AGAST #2329
    f.ret_array_param = fn_ret_array_param(p, ret)  # AGAST #2302
    set_fn_return(f, p, ret)
    f.body = body
    f.line = line
    f.next = null
    f.type_params = type_params  # Generic type parameters
    f.is_local = 0  # AGAST #194: generic templates are skipped in emit
    f.def_file = null
    f.target_gated = 0
    f.from_generated = 0
    f.is_pub = 0
    f.col = col
    f.extern_decl = 0
    tn_claim(p, f.type_params, f)   # AGAST #4021
    return f

# Generic struct definition (with type parameters)
pub fn generic_struct_def_new(p: *Parser, name_sv: StrView, type_params: *TypeParam, fields: *StructField, line: i32, col: i32) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *StructDef = parser_alloc(p, sizeof(StructDef)) as *StructDef
    s.name = name as *u8
    s.name_len = len
    s.fields = fields
    s.next = null
    s.type_params = type_params  # Generic type parameters (field at end to preserve layout)
    s.def_file = parse_file_copy_shared(p)   # AGAST #3494 (R65)
    tn_claim(p, type_params, null)   # AGAST #4021
    return s

# Grammar action for the field-less `[pub] struct S` (AGAST #2955).  It fails
# the alternative (p.error) when an INDENT follows: that struct has a body,
# and its bodied form failed inside it.  Accepting `struct S` as field-less
# there left the body's INDENT as the next item, so recovery noted the field
# (` c`) rather than the struct (AGAST #3271).
pub fn fieldless_struct_def_new(p: *Parser, name_sv: StrView, type_params: *TypeParam, line: i32, col: i32) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if p.pos < p.token_count and (p.tokens + p.pos).kind == TOK_INDENT
        p.error = 1
        return null
    generic_struct_def_new(p, StrView { ptr: (name), len: (len) as i64 }, type_params, null, line, col)

pub fn field_link(first: *StructField, rest: *StructField) -> *StructField
    first.next = rest
    return first

# =============================================================================
# Const definition helpers
# =============================================================================

pub fn const_new(p: *Parser, name_sv: StrView, tr: *TypeRef, val: *Expr, line: i32, col: i32) -> *ConstEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let facts: *TypeFacts = type_facts(p, tr)
    let ty: TypeKind = facts.kind
    nd_array_reject(p, tr, line, col, c"a const")  # AGAST #1509
    array_lit_length_decl(p, tr, val)   # AGAST #3383 (LARB R42)
    # Bumped from 40 → 128 to fit the extra metadata fields appended to
    # ConstEntry for non-integer constants (value_expr, array_size, etc.).
    let c: *ConstEntry = parser_alloc(p, sizeof(ConstEntry)) as *ConstEntry
    c.name = name as *u8
    c.def_file = parse_file_copy_shared(p)
    c.target_gated = 0  # item_dispatch_const sets it
    c.name_len = len
    c.const_type = ty
    # AGAST #1502: `c.value` is what every use site reads (find_const), so it
    # must be the folded initializer.  It used to be `val.int_val`, which is
    # only meaningful on an int literal: `-7` is a unary-minus node whose
    # int_val is 0, so every negative const silently became 0.
    c.value = 0
    c.fold_state = CONST_FOLD_DONE
    c.src_file = null
    c.line = line
    c.col = col
    var folded: i64 = 0
    if val != null and const_fold_int(p.module.constants, val, 0, @folded) == 1
        c.value = const_wrap_to_type(ty, folded)
    else if is_int_const_type(ty) == 1
        # Names a const not seen yet (later in this file, or imported), or
        # is not a constant at all: the emitter decides once every module is
        # merged, and reports a located error if it still does not fold.
        c.fold_state = CONST_FOLD_PENDING
        c.src_file = parse_file_copy(p)
    else if val != null and val.kind == ExprKind.IntLit
        # Non-integer declared types (float, struct/alias, ...) keep the
        # legacy literal fast path; their real lowering reads value_expr.
        c.value = val.int_val
    c.next = null
    # Preserve the full AST so the emitter can lower complex const shapes
    # (array literals, struct literals, string literals) later on.
    c.value_expr = val
    c.ptr_pointee = TypeKind.Void
    if ty == TypeKind.Ptr
        c.ptr_pointee = facts.pointee_type
    # Capture array element info from the parser's latched state. When
    # ty != TypeKind.Array these are zero/null. parse_type_spec populates
    # the last_array_* side channel when it consumes `[N]T`.
    if ty == TypeKind.Array
        c.array_size = facts.array_size
        c.array_elem_type = facts.array_elem_type
        c.array_elem_pointee = facts.array_elem_pointee
        c.array_elem_type_name = facts.array_elem_type_name
        c.array_elem_type_name_len = facts.array_elem_type_name_len
    else
        c.array_size = 0
        c.array_elem_type = TypeKind.Void
        c.array_elem_type_name = null
        c.array_elem_type_name_len = 0
    # AGAST #189 — capture the named-struct type for scalar struct consts
    # (`const FOO: StrView = "..."`).  parse_type_spec sets
    # the last_type_name side channel when it consumes a struct/named type; we latch it
    # so the emitter can lower the const as a `%StrView { ... }` global
    # and use-site loads can produce the proper aggregate.
    if ty == TypeKind.Struct
        c.type_name = facts.type_name
        c.type_name_len = facts.type_name_len
    else
        c.type_name = null
        c.type_name_len = 0
    return c

# -----------------------------------------------------------------------------
# Integer const folding (AGAST #1502)
# -----------------------------------------------------------------------------

# 1 if `ty` is a declared type whose const must fold to an integer.
pub fn is_int_const_type(ty: TypeKind) -> i32
    if ty_is_signed(ty) == 1
        return 1
    if ty_is_unsigned(ty) == 1
        return 1
    if ty == TypeKind.Bool
        return 1
    0

# `v` wrapped to the declared integer type `ty`, as runtime arithmetic at that
# width would leave it (AGAST #2154): `const M: u8 = 200 + 100` is 44, not
# 300.  Signed types sign-extend back to i64 (i8 200 is -56); unsigned ones
# zero-extend (u8 200 stays 200); bool keeps the low bit, as ritz0 does.
# i64/u64 and non-integer types are returned unchanged.
pub fn const_wrap_to_type(ty: TypeKind, v: i64) -> i64
    match ty
        TypeKind.Bool =>
            return v & 1
        TypeKind.U8 =>
            return v & 0xFF
        TypeKind.U16 =>
            return v & 0xFFFF
        TypeKind.U32 =>
            return v & 0xFFFFFFFF
        # Sign-extend as ((v & mask) ^ sign) - sign, not (v << k) >> k: ritz1's
        # `>>` is always a logical shift (AGAST #1637), so the shift form only
        # works when ritz0 builds this file.
        TypeKind.I8 =>
            return ((v & 0xFF) ^ 0x80) - 0x80
        TypeKind.I16 =>
            return ((v & 0xFFFF) ^ 0x8000) - 0x8000
        TypeKind.I32 =>
            return ((v & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000
        _ => pass
    v

fn const_name_eq(c: *ConstEntry, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if c.name_len != len
        return 0
    var i: i32 = 0
    while i < len
        if *(c.name + i) != *(name + i)
            return 0
        i += 1
    1

# Resolve a PENDING integer const in place against `consts`: 1 and DONE if
# it folds, 0 and BAD otherwise (including a cycle back to itself).
pub fn const_resolve(consts: *ConstEntry, c: *ConstEntry) -> i32
    if c.fold_state == CONST_FOLD_DONE
        return 1
    if c.fold_state != CONST_FOLD_PENDING
        return 0
    c.fold_state = CONST_FOLD_ACTIVE
    var v: i64 = 0
    if c.value_expr != null and const_fold_int(consts, c.value_expr, 1, @v) == 1
        c.value = const_wrap_to_type(c.const_type, v)
        c.fold_state = CONST_FOLD_DONE
        return 1
    c.fold_state = CONST_FOLD_BAD
    0

# The value of the integer const `name` in `consts` (first occurrence wins,
# as in the emitter's const_map).  With resolve == 0 (parse time) only an
# already-folded const counts; with resolve == 1 (emit time, every module
# merged) a PENDING one is resolved first.
fn const_fold_ident(consts: *ConstEntry, name_sv: StrView, resolve: i32, out: *i64) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var c: *ConstEntry = consts
    while c != null
        if const_name_eq(c, StrView { ptr: (name), len: (len) as i64 }) == 1
            if c.fold_state == CONST_FOLD_PENDING and resolve == 1
                const_resolve(consts, c)
            if c.fold_state != CONST_FOLD_DONE
                return 0
            # A float/struct const's `value` is not its value.
            if is_int_const_type(c.const_type) == 0
                return 0
            *out = c.value
            return 1
        c = c.next
    0

# Fold a constant integer expression into *out: int / char / bool literals,
# unary - ~ !, `as` casts (the value is kept; the const's own type governs its
# use), binary arithmetic, bitwise, shift, comparison and logical operators,
# and references to integer consts in `consts`.  Returns 1 on success, 0 if
# `e` is not such an expression (a call, an unknown name, division by zero,
# an out-of-range shift, ...).
pub fn const_fold_int(consts: *ConstEntry, e: *Expr, resolve: i32, out: *i64) -> i32
    if e == null
        return 0
    match e.kind
        ExprKind.IntLit | ExprKind.CharLit =>
            *out = e.int_val
            return 1
        ExprKind.Ident =>
            return const_fold_ident(consts, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, resolve, out)
        ExprKind.Cast =>
            return const_fold_int(consts, e.left, resolve, out)
        ExprKind.Unary =>
            var x: i64 = 0
            if const_fold_int(consts, e.operand, resolve, @x) == 0
                return 0
            # The i64 holds u64 values too (0x8000000000000000 is i64::MIN), so
            # negation is two's complement and wraps by design (LARB R63).
            match e.op
                OpKind.Neg =>
                    *out = 0 -% x
                    return 1
                OpKind.BitNot =>
                    *out = 0 -% x -% 1
                    return 1
                OpKind.Not =>
                    if x == 0
                        *out = 1
                    else
                        *out = 0
                    return 1
                _ => pass
            return 0
        ExprKind.Binary =>
            var a: i64 = 0
            var b: i64 = 0
            if const_fold_int(consts, e.left, resolve, @a) == 0
                return 0
            if const_fold_int(consts, e.right, resolve, @b) == 0
                return 0
            # AGAST #2356: the i64 `a` has lost whether it was a u64.
            if e.op == OpKind.Shr and b >= 0 and b <= 63 and const_expr_is_u64(consts, e.left) == 1
                *out = ((a as u64) >> (b as u64)) as i64
                return 1
            # AGAST #3062: so are `/`, `%` and the ordering compares over a u64.
            if const_fold_unsigned_op(e.op) == 1
                if const_expr_is_u64(consts, e.left) == 1 or const_expr_is_u64(consts, e.right) == 1
                    return const_fold_unsigned(e.op, a as u64, b as u64, out)
            if const_fold_traps(consts, e, a, b) == 1
                return 0   # LARB R63 (AGAST #3489): const_overflow_site names it
            return const_fold_binary(e.op, a, b, out)
        _ => pass
    0

# =============================================================================
# Integer overflow (LARB R63, AGAST #3489)
# =============================================================================
# `+`, `-` and `*` stop the program on overflow at their type, as do signed
# `/` and `%` of the minimum by -1; `+%`, `-%` and `*%` wrap.  A run can only
# stop, so a constant expression has no value there: "overflow in a constant
# expression is a compile error" (ritz0's ConstEvaluator._wrap_if_requested).

# `+`, `-`, `*`, `/` or `%`, as the source spells it.
pub fn arith_op_cstr(op: OpKind) -> *u8
    match op
        OpKind.Add =>
            return c"+"
        OpKind.Sub =>
            return c"-"
        OpKind.Mul =>
            return c"*"
        OpKind.Div =>
            return c"/"
        _ => pass
    c"%"

# 1 when `a op b` (`+`, `-` or `*`) leaves the `bits`-wide type, signed or
# (uns == 1) unsigned.  `a` and `b` are values of that type held in an i64: a
# u64 as its bit pattern.  Computed with the wrapping operators, so the
# question never stops ritz1 itself.
pub fn int_op_overflows(op: OpKind, a: i64, b: i64, bits: i32, uns: i32) -> i32
    var r: i64 = a +% b
    match op
        OpKind.Sub =>
            r = a -% b
        OpKind.Mul =>
            r = a *% b
        _ => pass
    if bits < 64
        # Exact: two operands of at most 32 bits have a sum, difference and
        # product a 64-bit pattern holds (a u32 product as a u64).
        if uns == 1
            return ((r as u64) > ((1 as u64) << (bits as u64)) - 1) as i32
        let hi: i64 = (1 << (bits as i64 - 1)) - 1
        return (r > hi or r < 0 - hi - 1) as i32
    if uns == 1
        match op
            OpKind.Add =>
                return ((r as u64) < (a as u64)) as i32
            OpKind.Sub =>
                return ((a as u64) < (b as u64)) as i32
            _ =>
                return (a != 0 and (r as u64) / (a as u64) != (b as u64)) as i32
    match op
        OpKind.Add =>
            return ((a >= 0) == (b >= 0) and (r >= 0) != (a >= 0)) as i32
        OpKind.Sub =>
            return ((a >= 0) != (b >= 0) and (r >= 0) != (a >= 0)) as i32
        _ => pass
    if a == 0
        return 0
    if a == -1
        return (b == 0 - 9223372036854775807 - 1) as i32
    (r / a != b) as i32

# 1 when folding `e` (operands `a` and `b`, already folded) is an overflow:
# a plain `+ - *` outside i64 (u64 over a u64 operand), or signed MIN / -1.
fn const_fold_traps(consts: *ConstEntry, e: *Expr, a: i64, b: i64) -> i32
    if e.wrapping == 1
        return 0
    var uns: i32 = 0
    if const_expr_is_u64(consts, e.left) == 1 or const_expr_is_u64(consts, e.right) == 1
        uns = 1
    match e.op
        OpKind.Add | OpKind.Sub | OpKind.Mul =>
            return int_op_overflows(e.op, a, b, 64, uns)
        OpKind.Div | OpKind.Mod =>
            return (uns == 0 and b == -1 and a == 0 - 9223372036854775807 - 1) as i32
        _ => pass
    0

# The operation in constant expression `e` whose overflow keeps it from
# folding (const_fold_traps), innermost first; null if there is none.
pub fn const_overflow_site(consts: *ConstEntry, e: *Expr, resolve: i32) -> *Expr
    if e == null
        return null
    match e.kind
        ExprKind.Unary =>
            return const_overflow_site(consts, e.operand, resolve)
        ExprKind.Cast =>
            return const_overflow_site(consts, e.left, resolve)
        ExprKind.Binary => pass
        _ =>
            return null
    let inner: *Expr = const_overflow_site(consts, e.left, resolve)
    if inner != null
        return inner
    let inner_r: *Expr = const_overflow_site(consts, e.right, resolve)
    if inner_r != null
        return inner_r
    var a: i64 = 0
    var b: i64 = 0
    if const_fold_int(consts, e.left, resolve, @a) == 0 or const_fold_int(consts, e.right, resolve, @b) == 0
        return null
    if const_fold_traps(consts, e, a, b) == 1
        return e
    null

# `<file>:<line>:<col>: error: integer overflow in `+` in constant
# expression`, ritz0's ConstEvalError text, at the operation.
pub fn const_overflow_report(file: *u8, site: *Expr)
    diag_error_at(file, diag_span(site.span.line, site.span.col))
    eprints("integer overflow in `")
    eprints_cstr(arith_op_cstr(site.op))
    eprints("` in constant expression\n")

# Is constant expression `e` a u64?  The rule of int_operand_shape in
# emitter_expr_arith.ritz, for the two widths a fold can tell apart: a literal
# only a u64 can hold, a u64 const, `as u64`, and any operator over those.
fn const_expr_is_u64(consts: *ConstEntry, e: *Expr) -> i32
    match e.kind
        ExprKind.IntLit =>
            if e.int_val < 0
                return 1
            return 0
        ExprKind.Cast =>
            if e.type_kind == TypeKind.U64
                return 1
            return 0
        ExprKind.Ident =>
            var c: *ConstEntry = consts
            while c != null
                if const_name_eq(c, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                    if c.const_type == TypeKind.U64
                        return 1
                    return 0
                c = c.next
            return 0
        ExprKind.Unary =>
            return const_expr_is_u64(consts, e.operand)
        _ => pass
    if e.kind == ExprKind.Binary
        if const_expr_is_u64(consts, e.left) == 1
            return 1
        if e.op != OpKind.Shl and e.op != OpKind.Shr
            return const_expr_is_u64(consts, e.right)
    0

# 1 for the operators whose result depends on the operands' signedness
# (`>>` aside, which reads only its left operand).
fn const_fold_unsigned_op(op: OpKind) -> i32
    if op == OpKind.Div or op == OpKind.Mod or op == OpKind.Lt or op == OpKind.Le or op == OpKind.Gt or op == OpKind.Ge
        return 1
    0

# `op` (one const_fold_unsigned_op accepts) on two u64 operands.
fn const_fold_unsigned(op: OpKind, a: u64, b: u64, out: *i64) -> i32
    var r: u64 = 0
    match op
        OpKind.Div | OpKind.Mod =>
            if b == 0
                return 0
            if op == OpKind.Div
                r = a / b
            else
                r = a % b
        OpKind.Lt =>
            if a < b
                r = 1
        OpKind.Le =>
            if a <= b
                r = 1
        OpKind.Gt =>
            if a > b
                r = 1
        _ =>
            if a >= b
                r = 1
    *out = r as i64
    1

# Folding wraps: a plain `+ - *` that would wrap, and signed MIN / -1, were
# refused before here (const_fold_traps, LARB R63), so what reaches this is
# `+%` and its kin, or a value that fits.
fn const_fold_binary(op: OpKind, a: i64, b: i64, out: *i64) -> i32
    match op
        OpKind.Add =>
            *out = a +% b
        OpKind.Sub =>
            *out = a -% b
        OpKind.Mul =>
            *out = a *% b
        OpKind.Div | OpKind.Mod =>
            if b == 0
                return 0
            if op == OpKind.Div
                *out = a / b
            else
                *out = a % b
        OpKind.BitAnd =>
            *out = a & b
        OpKind.BitOr =>
            *out = a | b
        OpKind.BitXor =>
            *out = a ^ b
        OpKind.Shl | OpKind.Shr =>
            if b < 0 or b > 63
                return 0
            if op == OpKind.Shl
                *out = a << b
            else
                *out = a >> b
        _ =>
            let t: i32 = const_fold_compare(op, a, b)
            if t < 0
                return 0
            *out = t as i64
    1

# 1 / 0 for a comparison or logical operator, -1 if `op` is neither.
fn const_fold_compare(op: OpKind, a: i64, b: i64) -> i32
    var t: i32 = 0
    match op
        OpKind.Eq =>
            if a == b
                t = 1
        OpKind.Ne =>
            if a != b
                t = 1
        OpKind.Lt =>
            if a < b
                t = 1
        OpKind.Gt =>
            if a > b
                t = 1
        OpKind.Le =>
            if a <= b
                t = 1
        OpKind.Ge =>
            if a >= b
                t = 1
        OpKind.And =>
            if a != 0 and b != 0
                t = 1
        OpKind.Or =>
            if a != 0 or b != 0
                t = 1
        _ =>
            return -1
    t

# =============================================================================
# Import helpers
# =============================================================================

# `items` is the selective list `{ a, b }`, null when there is none.
pub fn import_new(p: *Parser, path: *ImportPath, items: *ImportItem) -> *ImportDecl
    let i: *ImportDecl = parser_alloc(p, sizeof(ImportDecl)) as *ImportDecl
    i.path = path
    i.next = null
    i.is_pub = 0
    i.items = items
    return i

# `pub import m`: a re-export (LANGUAGE_SPEC §15.4, AGAST #3891).
pub fn import_new_pub(p: *Parser, path: *ImportPath, items: *ImportItem) -> *ImportDecl
    let i: *ImportDecl = import_new(p, path, items)
    i.is_pub = 1
    i

# A name of a selective list, at its token (AGAST #3467, LARB R54).
pub fn import_item_new(p: *Parser, name_sv: StrView, line: i32, col: i32, rest: *ImportItem) -> *ImportItem
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let it: *ImportItem = parser_alloc(p, sizeof(ImportItem)) as *ImportItem
    it.name = name
    it.name_len = len
    it.line = line
    it.col = col
    it.next = rest
    it

pub fn path_new(p: *Parser, seg_sv: StrView, rest: *ImportPath) -> *ImportPath
    var seg: *u8 = seg_sv.ptr
    var len: i32 = seg_sv.len as i32
    let path: *ImportPath = parser_alloc(p, sizeof(ImportPath)) as *ImportPath
    path.segment = seg as *u8
    path.segment_len = len
    path.next = rest
    return path

# =============================================================================
# Type helpers
# =============================================================================

# AGAST #2198: 1 if `name` is `usize` or `isize`.  Neither is a keyword in
# ritz1's lexer, so both reach type_named as an IDENT.
fn is_word_type_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len != 5 or name == null
        return 0
    let c0: u8 = *name
    if c0 != 'u' and c0 != 'i'  # 'u' / 'i'
        return 0
    if *(name + 1) == 's' and *(name + 2) == 'i' and *(name + 3) == 'z' and *(name + 4) == 'e'  # "size"
        return 1
    0

# AGAST #3464 (LARB R53): the type a word type name is, given
# is_word_type_name(name, ..) == 1: `usize` is u64, `isize` is i64.
fn word_type(name: *u8) -> TypeKind
    if *name == 'u'  # 'u'
        return TypeKind.U64
    TypeKind.I64

# =============================================================================
# TypeRef (AGAST #4035): the parser's type, and the accessors that replace the
# 17 `Parser.last_*` type side channels.
# =============================================================================

pub fn typeref_new(p: *Parser, kind: TypeKind) -> *TypeRef
    let t: *TypeRef = parser_alloc(p, sizeof(TypeRef)) as *TypeRef
    t.kind = kind
    t.name = null
    t.name_len = 0
    t.pointee = null
    t.elem = null
    t.count = 0
    t.shape = null
    t.array_rec = null
    t.fn_sig = null
    t.inner_ref = 0
    t.ref_inner = TypeKind.Void
    return t

pub fn type_prim(p: *Parser, kind: TypeKind) -> *TypeRef
    typeref_new(p, kind)

# The unit type `()`: TypeKind.Void, as the flat `0` was before #4035.
pub fn type_void(p: *Parser) -> *TypeRef
    typeref_new(p, TypeKind.Void)

pub fn tr_kind(tr: *TypeRef) -> TypeKind
    if tr == null
        return TypeKind.Void
    tr.kind

# 1 for no written type at all (a `let x = ...`), or the unit type, which the
# flat code spelled `0` and treated alike.
pub fn tr_is_void(tr: *TypeRef) -> i32
    if tr == null or tr.kind == TypeKind.Void
        return 1
    0

# The name `last_type_name` held after parsing this type: a struct's own, or
# the deepest struct a pointer / reference / array wraps.  #4035: defined in
# types.ritz with the other `*TypeRef` accessors; ast_helpers imports it.

# `last_pointee_type`: the immediate pointee of a `*T`/`**T`, or of the
# pointer a reference wraps (`@*T` recorded T).
pub fn tr_pointee_kind(tr: *TypeRef) -> TypeKind
    if tr == null or tr.pointee == null
        return TypeKind.Void
    tr.pointee.kind

pub fn tr_ptr_pointee_kind(tr: *TypeRef) -> TypeKind
    if tr == null
        return TypeKind.Void
    if tr.kind == TypeKind.Ref or tr.kind == TypeKind.MutRef
        return tr_pointee_kind(tr.pointee)
    tr_pointee_kind(tr)

pub fn tr_inner_ref(tr: *TypeRef) -> i32
    if tr == null
        return 0
    if is_indirection_kind(tr.kind) == 0
        return 0
    tr.inner_ref

fn is_indirection_kind(kind: TypeKind) -> i32
    (kind == TypeKind.Ptr or kind == TypeKind.PtrPtr or kind == TypeKind.Ref or kind == TypeKind.MutRef) as i32

# `last_ptr_depth` (`tr_depth`) lives in types.ritz with the other accessors.

# `last_ref_inner_type`: the referent's flat kind of `@T` / `@&T`.
pub fn tr_ref_inner(tr: *TypeRef) -> TypeKind
    if tr == null
        return TypeKind.Void
    if tr.kind != TypeKind.Ref and tr.kind != TypeKind.MutRef
        return TypeKind.Void
    tr.ref_inner

# `last_fn_sig`: the signature of the fn type just parsed (null otherwise).
pub fn tr_fn_sig(tr: *TypeRef) -> *FnDef
    if tr == null
        return null
    tr.fn_sig

# `last_array_shape`: the shape of a `[N][M]..T`.
pub fn tr_shape(tr: *TypeRef) -> *ArrayShape
    if tr == null
        return null
    tr.shape

pub fn tr_count(tr: *TypeRef) -> i64
    if tr == null
        return 0
    tr.count

# `tr_elem` / `tr_pointee` live in types.ritz with the other accessors.

# `last_array_elem_type`.
pub fn tr_elem_kind(tr: *TypeRef) -> TypeKind
    if tr == null or tr.elem == null
        return TypeKind.Void
    tr.elem.kind

# `last_array_elem_pointee`: U for `[N]*U` / `[N]**U` / `[N]@U` / `[N]@&U`.
pub fn tr_elem_pointee(tr: *TypeRef) -> TypeKind
    if tr == null or tr.elem == null
        return TypeKind.Void
    let e: *TypeRef = tr.elem
    match e.kind
        TypeKind.Ptr =>
            return tr_pointee_kind(e)
        TypeKind.PtrPtr =>
            return ptr_slot_flat(tr_ptr_ptr_inner_pointee(e))
        TypeKind.Ref | TypeKind.MutRef =>
            return tr_ref_inner(e)
        _ => pass
    TypeKind.Void

# `last_array_elem_type_name`: the struct an array's element (or the struct
# it points at / refers to) is named, null otherwise.
pub fn tr_elem_name(tr: *TypeRef, out_len: *i32) -> *u8
    *out_len = 0
    if tr == null or tr.elem == null
        return null
    let e: *TypeRef = tr.elem
    match e.kind
        TypeKind.Struct =>
            *out_len = e.name_len
            return e.name
        TypeKind.Ref | TypeKind.MutRef =>
            if tr_ref_inner(e) == TypeKind.Struct
                return tr_name(e.pointee, out_len)
            return null
        TypeKind.Ptr | TypeKind.PtrPtr =>
            if tr_slot_inner(e) == TypeKind.Struct
                return tr_name(e, out_len)
            return null
        _ => pass
    null

# The `[N]..T` a pointer names via `*[N]T`, `**[N]T` or `@*[N]T`; null for any
# other pointer.  This is `ptr_names_array`'s subject.
fn tr_ptr_array(tr: *TypeRef) -> *TypeRef
    if tr == null
        return null
    match tr.kind
        TypeKind.Ptr =>
            if tr.pointee != null and tr.pointee.kind == TypeKind.Array
                return tr.pointee
            return null
        TypeKind.PtrPtr =>
            if tr_depth(tr) == 2 and tr.pointee != null and tr.pointee.kind == TypeKind.Ptr and tr.pointee.pointee != null and tr.pointee.pointee.kind == TypeKind.Array
                return tr.pointee.pointee
            return null
        TypeKind.Ref | TypeKind.MutRef =>
            if tr.ref_inner == TypeKind.Ptr and tr.pointee != null and tr.pointee.pointee != null and tr.pointee.pointee.kind == TypeKind.Array
                return tr.pointee.pointee
            return null
        _ => pass
    null

# `last_inner_pointee_type`: the deepest non-pointer kind of a `*..T`.
pub fn tr_slot_inner(tr: *TypeRef) -> TypeKind
    if tr == null
        return TypeKind.Void
    var p: *TypeRef = tr
    while p != null and (p.kind == TypeKind.Ptr or p.kind == TypeKind.PtrPtr)
        p = p.pointee
    if p == null
        return TypeKind.Void
    p.kind

# AGAST #4450: tr_slot_inner as an inner-pointee slot: the leaf's kind, or the
# packed slot a DeepPtr leaf stands for (TypeRef.deep_slot).
pub fn tr_slot_inner_slot(tr: *TypeRef) -> i32
    var p: *TypeRef = tr
    while p != null and (p.kind == TypeKind.Ptr or p.kind == TypeKind.PtrPtr)
        p = p.pointee
    if p == null
        return TypeKind.Void as i32
    if p.kind == TypeKind.DeepPtr
        return p.deep_slot
    p.kind as i32

# AGAST #4450: make `t` the leaf for inner-pointee slot `slot`.
pub fn tr_set_slot(t: *TypeRef, slot: i32)
    t.kind = ptr_slot_flat(slot)
    t.deep_slot = 0
    if t.kind == TypeKind.DeepPtr
        t.deep_slot = slot

# AGAST #1815 / #1924: `ptr_ptr_inner_pointee`.  A `***T` packs its extra
# levels as multiples of PTR_DEPTH_UNIT, exactly as the flat slot did.
pub fn tr_ptr_ptr_inner_pointee(tr: *TypeRef) -> i32
    var slot: *TypeRef = tr
    if tr != null and (tr.kind == TypeKind.Ref or tr.kind == TypeKind.MutRef)
        slot = tr.pointee
    if slot == null or slot.kind != TypeKind.PtrPtr
        return (TypeKind.Void as i32)
    let d: i32 = tr_depth(slot)
    let deep: i32 = tr_slot_inner_slot(slot)
    if d <= 2
        return deep
    if d < 3 or deep == (TypeKind.Void as i32)
        return (TypeKind.Void as i32)
    ptr_slot_deepen(deep, d - 2)

# AGAST #3108: `var_inner_pointee_of`.
pub fn tr_var_inner_pointee(tr: *TypeRef) -> i32
    if tr != null and (tr.kind == TypeKind.Ref or tr.kind == TypeKind.MutRef) and tr.ref_inner == TypeKind.Ptr
        # AGAST #4450: the slot lv_set_inner_pointee_type wrote (tr_set_slot),
        # its packed `***T` form included: a DeepPtr leaf keeps it on deep_slot.
        # Reading the bare kind gave DeepPtr for `let r = @q` of a `q: **T`, so
        # `***r = v` lost T and stored an i64.
        if tr.pointee == null or tr.pointee.pointee == null
            return (TypeKind.Void as i32)
        let leaf: *TypeRef = tr.pointee.pointee
        if leaf.kind == TypeKind.DeepPtr
            return leaf.deep_slot
        return (leaf.kind as i32)
    tr_ptr_ptr_inner_pointee(tr)

# The first `[N]T` in this type's chain: the type itself, or the array a
# pointer / reference wraps.  Its facts are the ones the flat parser state
# described after parsing the type.
fn tr_array_node(tr: *TypeRef) -> *TypeRef
    var t: *TypeRef = tr
    while t != null
        if t.kind == TypeKind.Array
            return t
        t = t.pointee
    null

fn tr_array_node_elem(tr: *TypeRef) -> *TypeRef
    let a: *TypeRef = tr_array_node(tr)
    if a == null
        return null
    a.elem

# The fn signature of this type: its own, or the one an array's element holds.
fn tr_chain_fn_sig(tr: *TypeRef) -> *FnDef
    var t: *TypeRef = tr
    while t != null
        if t.fn_sig != null
            return t.fn_sig
        if t.elem != null
            t = t.elem
        else
            t = t.pointee
    null

# One flat snapshot of a `*TypeRef`: exactly the facts the 17 `Parser.last_*`
# side channels held after `type_spec` parsed it.  #4035 keeps the flat
# consumers (Param / StructField / GlobalVarDef / Stmt) unchanged by deriving
# that snapshot from the chain instead of latching it on the Parser.
struct TypeFacts
    kind: TypeKind
    type_name: *u8
    type_name_len: i32
    pointee_type: TypeKind
    inner_pointee_type: i32
    ptr_depth: i32
    array_size: i32
    array_elem_type: TypeKind
    array_elem_type_name: *u8
    array_elem_type_name_len: i32
    array_elem_pointee: TypeKind
    array_shape: *ArrayShape
    ref_inner_type: TypeKind
    inner_ref: i32
    fn_sig: *FnDef

pub fn type_facts(p: *Parser, tr: *TypeRef) -> *TypeFacts
    let f: *TypeFacts = parser_alloc(p, sizeof(TypeFacts)) as *TypeFacts
    let kind: TypeKind = tr_kind(tr)
    f.kind = kind
    f.type_name = tr_name(tr, @f.type_name_len)
    # `last_pointee_type`: the pointer's pointee, or, for a reference, the
    # pointer it wraps one level in (`@*T` recorded T) -- and for a reference
    # to a value, that value's own kind (`@S` recorded S, which is what a
    # member or `*g` of a global `@S` reads).
    f.pointee_type = TypeKind.Void
    match kind
        TypeKind.Ptr | TypeKind.PtrPtr =>
            f.pointee_type = tr_pointee_kind(tr)
        TypeKind.Ref | TypeKind.MutRef =>
            if tr.pointee != null
                if tr.ref_inner == TypeKind.Ptr or tr.ref_inner == TypeKind.PtrPtr
                    f.pointee_type = tr_pointee_kind(tr.pointee)
                else
                    f.pointee_type = tr.pointee.kind
        _ => pass
    # `last_inner_pointee_type`: the deepest non-pointer kind, with a
    # reference unwrapped to the pointer it holds (a `@*T` recorded T).
    f.inner_pointee_type = (TypeKind.Void as i32)
    match kind
        TypeKind.Ref | TypeKind.MutRef =>
            f.inner_pointee_type = (tr_slot_inner(tr.pointee) as i32)
        TypeKind.Ptr | TypeKind.PtrPtr =>
            f.inner_pointee_type = (tr_slot_inner(tr) as i32)
        _ => pass
    # `last_ptr_depth`: a reference inherited the pointer's depth from its
    # referent's parse (`@*T` was depth 1).
    f.ptr_depth = 0
    match kind
        TypeKind.Ref | TypeKind.MutRef =>
            f.ptr_depth = tr_depth(tr.pointee)
        TypeKind.Ptr | TypeKind.PtrPtr =>
            f.ptr_depth = tr_depth(tr)
        _ => pass
    # `last_array_*` / `last_array_shape`: the first `[N]T` in the chain, which
    # for a `*[N]T` / `@[N]T` is the pointee's.
    let a: *TypeRef = tr_array_node(tr)
    f.array_size = 0
    f.array_elem_type = TypeKind.Void
    f.array_elem_pointee = TypeKind.Void
    f.array_elem_type_name = null
    f.array_elem_type_name_len = 0
    f.array_shape = null
    if a != null
        f.array_size = tr_count(a) as i32
        f.array_elem_type = tr_elem_kind(a)
        f.array_elem_pointee = tr_elem_pointee(a)
        f.array_elem_type_name = tr_elem_name(a, @f.array_elem_type_name_len)
        f.array_shape = tr_shape(a)
    f.ref_inner_type = tr_ref_inner(tr)
    f.inner_ref = tr_inner_ref(tr)
    f.fn_sig = tr_chain_fn_sig(tr)
    f

pub fn type_named(p: *Parser, name_sv: StrView) -> *TypeRef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #1475: a type alias resolves to its target's TypeRef.
    if p.ctx.alias_count > 0
        let alias_ty: *TypeRef = type_alias_resolve(p, StrView { ptr: (name), len: (len) as i64 })
        if tr_is_void(alias_ty) == 0
            alias_use_log(p, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3907
            return alias_ty
    # AGAST #2198: `usize` / `isize` are primitives, not a TypeKind.Struct named
    # "usize" (which wrote `%usize`, an opaque type clang rejects).  AGAST
    # #3464 (LARB R53): `usize` is another name for `u64` and `isize` for
    # `i64`, so a usize is unsigned (lshr, udiv, icmp ult, uitofp).  A generic
    # argument spells as the integer too (`Vec$u64`, AGAST #3935).
    if is_word_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return type_prim(p, word_type(name))
    # Float types: f32 / f64 are first-class type kinds, not TypeKind.Struct+name.
    # Detect by exact name and return the proper kind so downstream type-
    # tracking (get_expr_type, param_type, etc.) doesn't fall through to
    # struct-shape paths that emit `add i64`/`icmp` instead of fadd/fcmp.
    if len == 3
        if *(name + 0) == 'f' and *(name + 1) == '3' and *(name + 2) == '2'  # 'f','3','2'
            return type_prim(p, TypeKind.F32)
        if *(name + 0) == 'f' and *(name + 1) == '6' and *(name + 2) == '4'  # 'f','6','4'
            return type_prim(p, TypeKind.F64)
    note_type_name_at(p, name)
    let t: *TypeRef = typeref_new(p, TypeKind.Struct)
    t.name = name
    t.name_len = len
    t

# AGAST #3932: where each type name type_named saw was written, keyed by the
# name's pointer into the source, which the AST's type-name slots keep.
# type_name_check.ritz reads it to locate "unknown type `Nope`".  An
# alternative the parser backtracks out of (`a < b` tried as `a<b>(..)`)
# leaves its entry behind; nothing in the AST points at it, so it is never
# looked up.  A name the compiler builds (`Vec$u8`) has no entry.
# struct TypeNameAt: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.type_name_at

fn note_type_name_at(p: *Parser, name: *u8)
    # The action runs just past the IDENT it names.
    if p.pos <= 0 or p.pos > p.token_count
        return
    let t: *Token = p.tokens + (p.pos - 1)
    if t.start != name
        return
    note_type_name_written(p, name, t.line, t.col)

fn note_type_name_written(p: *Parser, name: *u8, line: i32, col: i32)
    let at: *TypeNameAt = parser_alloc(p, sizeof(TypeNameAt)) as *TypeNameAt
    at.name = name
    at.line = line
    at.col = col
    at.file = parse_file_copy_shared(p)
    at.reported = 0
    at.next = p.ctx.type_name_at
    p.ctx.type_name_at = at

# AGAST #4021: a type name written where the AST keeps no source spelling:
# a generic argument (the slot holds the mangled `Option$Nope`), an enum
# payload (enums have no AST node), an alias's target and a cast's type.
# Each is noted as it parses, and the item it sits in claims the notes when
# its action runs (items end after their contents), with the type parameters
# in scope there: a fn's (and, for a method, its impl's, which
# impl_block_new adds), a struct's or an enum's; an alias's or a global's
# none.  type_name_check.ritz judges each note in its scope.
#
# A note is the IDENT a type ended with (`Nope` of `*Nope`); one type_named
# did not record (a primitive, an alias's name) is never reported.
# struct TnNote: ast.ritz, beside ParseCtx (AGAST #4623).

# struct TnScope: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.tn_pending, .tn_scopes, .tn_enum_params

fn tn_note(p: *Parser, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if p.skip_item != 0 or name == null or len <= 0
        return
    let n: *TnNote = parser_alloc(p, sizeof(TnNote)) as *TnNote
    n.name = name
    n.len = len
    n.next = p.ctx.tn_pending
    p.ctx.tn_pending = n

# The token `back` before p.pos when it is an IDENT (the type just parsed
# ended with a name), else null.
fn tn_last_written(p: *Parser, back: i32) -> *Token
    let i: i32 = p.pos - back
    if i < 0 or i >= p.token_count
        return null
    let t: *Token = p.tokens + i
    if t.kind != TOK_IDENT
        return null
    t

# Note the type that ended `back` tokens before p.pos, if it ended with a name.
fn tn_note_last(p: *Parser, back: i32)
    let t: *Token = tn_last_written(p, back)
    if t != null
        tn_note(p, StrView { ptr: (t.start), len: (t.len) as i64 })

# AGAST #4171: a generic call's type argument `g<Nope>(3)` / `g<*Nope>(p)` /
# `g<@Nope>(r)` is a bare token (type_name), never a type_spec, so type_named
# neither saw nor located it: locate it here and note it.
fn tn_note_tok(p: *Parser, tok: Token)
    if p.skip_item != 0 or tok.kind != TOK_IDENT
        return
    note_type_name_written(p, tok.start, tok.line, tok.col)
    tn_note(p, StrView { ptr: (tok.start), len: (tok.len) as i64 })

# AGAST #4171: a generic call's full argument list `g<i32, *Nope>(3)`.  Each
# argument is a type_spec (type_named located it), but only
# type_generic_with_saved noted them.
fn tn_note_args(p: *Parser, ga: *GenericArg)
    var cur: *GenericArg = ga
    while cur != null
        tn_note(p, StrView { ptr: (cur.written), len: (cur.written_len) as i64 })
        cur = cur.next

# AGAST #4171: a struct-style variant's fields (`A` / `    x: Nope`) have no
# StructDef for type_name_check.ritz to walk; the enum claims these notes.
# A slot counts only if its name is written on the field's own line, after
# the field's name, as tn_struct judges a struct's: `f: fn(i64) -> i64`
# after `-> @&T` keeps that `T` (test_unknown_type_name.py KNOWN's `CbE`),
# which was judged where it was written.
fn tn_note_slot(p: *Parser, field: *u8, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if field == null or name == null or (name as i64) <= (field as i64)
        return
    var c: *u8 = field
    while (c as i64) < (name as i64)
        if *c == 10 or *c == 0
            return
        c = c + 1
    tn_note(p, StrView { ptr: (name), len: (len) as i64 })

fn tn_note_fields(p: *Parser, fields: *StructField)
    var f: *StructField = fields
    while f != null
        tn_note_slot(p, f.name, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        tn_note_slot(p, f.name, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
        f = f.next

# The item whose action is running claims every pending note.
fn tn_claim(p: *Parser, inner: *TypeParam, f: *FnDef)
    if p.ctx.tn_pending == null
        return
    let s: *TnScope = parser_alloc(p, sizeof(TnScope)) as *TnScope
    s.inner = inner
    s.outer = null
    s.notes = p.ctx.tn_pending
    s.fn_def = f
    s.next = p.ctx.tn_scopes
    p.ctx.tn_scopes = s
    p.ctx.tn_pending = null

# impl_block_new: its methods see its type parameters.  A method's scope is
# near the list's head: methods claim just before their impl's action runs.
fn tn_claim_impl(ctx: *ParseCtx, params: *TypeParam, methods: *FnDef)
    if params == null
        return
    var f: *FnDef = methods
    while f != null
        var s: *TnScope = ctx.tn_scopes
        while s != null and s.fn_def != f
            s = s.next
        if s != null
            s.outer = params
        f = f.next

# cast_type_end_check: a cast's type ran on into a comparison (`a as Id < b,
# c > d`), so the generic arguments noted after the `as` are values: drop them.
fn tn_drop_after_as(p: *Parser)
    var i: i32 = p.pos - 1
    while i >= 0 and (p.tokens + i).kind != TOK_AS
        i = i - 1
    if i < 0
        return
    let as_at: *u8 = (p.tokens + i).start
    while p.ctx.tn_pending != null and (p.ctx.tn_pending.name as i64) > (as_at as i64)
        p.ctx.tn_pending = p.ctx.tn_pending.next

pub fn tn_scopes(ctx: *ParseCtx) -> *TnScope
    ctx.tn_scopes

# The driver's alias re-parse (main.ritz) builds every module afresh.
pub fn tn_notes_reset(ctx: *ParseCtx)
    ctx.tn_pending = null
    ctx.tn_scopes = null
    ctx.tn_enum_params = null

# Where the type name at `name` was written; null for one no source spells.
# Linear, so asked only about a name already found unknown.
pub fn type_name_written_at(ctx: *ParseCtx, name: *u8) -> *TypeNameAt
    var at: *TypeNameAt = ctx.type_name_at
    while at != null
        if at.name == name
            return at
        at = at.next
    null

# Capture the return type name after parsing return_type but before parsing block.
# This prevents last_type_name from being overwritten by type_spec calls in the function body.
#
# AGAST #175: also capture for TypeKind.Ptr / TypeKind.Ref / TypeKind.MutRef when the
# pointee was a named struct (last_type_name is still populated from the
# inner type_named call — type_ptr doesn't clear it).  Without this, callers
# like `let cqe = uring_peek_cqe(...)` (returning *IoUringCqe) couldn't
# resolve the pointee struct → var-decl narrowing missed → `cqe.field`
# member access fell through to "; ERROR: unhandled EXPR_MEMBER" with a
# stale `%.0` reference.
# AGAST #2120 / #2308 / #2343 / #2329: the return-side records a FnDef keeps,
# all derived from the parsed return `*TypeRef` (#4035).  The body is parsed
# after the return type, so a nested type in it cannot disturb these.
fn fn_ret_fn_sig(ret: *TypeRef) -> *FnDef
    if tr_kind(ret) == TypeKind.Ptr
        return tr_fn_sig(ret)
    null

fn fn_ret_ref(p: *Parser, ret: *TypeRef) -> *Param
    if tr_kind(ret) == TypeKind.Ref or tr_kind(ret) == TypeKind.MutRef
        return param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, ret)
    null

fn fn_ret_ptr_array(p: *Parser, ret: *TypeRef) -> *Param
    let k: TypeKind = tr_kind(ret)
    if k == TypeKind.Ptr or k == TypeKind.Ref or k == TypeKind.MutRef or k == TypeKind.PtrPtr
        return ptr_array_of_type(p, ret)
    null

fn fn_ret_array(p: *Parser, ret: *TypeRef) -> *ArrayElem
    if tr_kind(ret) == TypeKind.Array
        return array_elem_of_type(p, ret)
    null

# AGAST #2302: a `-> [N]T` as a by-value param would hold it.
fn fn_ret_array_param(p: *Parser, ret: *TypeRef) -> *Param
    if tr_kind(ret) == TypeKind.Array
        return param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, ret)
    null

# The name a `-> T` return gives the fn, from the parser state its type_spec
# just left: a struct, the pointee of a `-> *T` / `-> **U` / `-> @T`, or
# nothing where a name would be stale.  Shared by capture_fn_return_type (a
# named fn writes p.fn_return_type_name) and type_fn (a fn type writes
# FnDef.return_type_name), so the two spellings can't drift (AGAST #4324).
fn ret_name_of_type(p: *Parser, tr: *TypeRef, out: **u8, out_len: *i32)
    let ret: TypeKind = tr_kind(tr)
    if ret == TypeKind.Struct
        *out = tr.name
        *out_len = tr.name_len
    else if (ret == TypeKind.Ref or ret == TypeKind.MutRef) and tr_ref_inner(tr) != TypeKind.Struct
        # AGAST #1453: `-> @i64` names nothing; only a struct referent does.
        *out = null
        *out_len = 0
    else if ret == TypeKind.Ptr and primitive_name_len(tr_pointee_kind(tr)) > 0
        # AGAST #1984: `-> *i32` / `-> *u64` name the primitive pointee.
        *out = primitive_name_from_type(tr_pointee_kind(tr))
        *out_len = primitive_name_len(tr_pointee_kind(tr))
    else
        match ret
            TypeKind.PtrPtr =>
                # AGAST #2791: `-> **U` names U as monomorph names a `*T` at T = *U.
                let inner: TypeKind = ptr_slot_flat(tr_ptr_ptr_inner_pointee(tr))
                if primitive_name_len(inner) > 0
                    *out = primitive_name_from_type(inner)
                    *out_len = primitive_name_len(inner)
                else if inner == TypeKind.Struct
                    *out = tr_name(tr, out_len)
                else
                    *out = null
                    *out_len = 0
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                *out = tr_name(tr, out_len)
            _ =>
                *out = null
                *out_len = 0

# AGAST #3634: the return `*TypeRef` itself carries the shape and the fn
# signature, so #4035 leaves nothing to latch on the Parser.
pub fn capture_fn_return_type(p: *Parser, ret: *TypeRef) -> *TypeRef
    ret

# Capture the variable type name after parsing type_spec but before parsing initializer expr.
# This prevents last_type_name from being overwritten when the initializer contains a generic call.
# For example: var lines: Vec<LineBounds> = vec_with_cap<LineBounds>(64)
# After parsing Vec<LineBounds>, last_type_name is "Vec$LineBounds"
# But parsing vec_with_cap<LineBounds>(64) overwrites it with "LineBounds"
# We save to var_type_name (separate from fn_return_type_name) and stmt_var_decl reads from there.
#
# AGAST #2308: an initializer overwrites what a `@T` local's referent was parsed
# into as well, so it's latched here, whole.  A typed `let` nested in the
# initializer (a block arm) replaces the latch, as it does var_type_name, and a
# nested reference then wins.
# State: ParseCtx.var_ref
# AGAST #2822: likewise a `[N]T` annotation's shape (`<[M]U>` in the
# initializer re-sets last_array_*), and a `*[N]T`'s pointee array.
# State: ParseCtx.var_array, .var_array_size, .var_ptr_array_size, .var_ptr_array_elem, .var_ptr_array_elem_pointee, .var_ptr_array_shape, .var_ptr_array_elem_name, .var_ptr_array_elem_name_len

# AGAST #2822: one record of all the latches above per typed decl, so a typed
# `let` nested in the initializer (a block arm) can't replace the outer decl's.
# capture_var_type pushes one, tagged with where the annotation ends;
# stmt_var_decl restores the first one after its `let` (the inner decls'
# records sit above it) and drops it and everything above it.  The grammar
# backtracks: a re-capture first drops the records at or after its own end,
# which a failed alternative left behind.
# struct VarLatch: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.var_latch

# (line, col) strictly after (line2, col2).
fn pos_after(line: i32, col: i32, line2: i32, col2: i32) -> i32
    if line > line2 or (line == line2 and col > col2)
        return 1
    return 0

fn push_var_latch(p: *Parser)
    let end: *Token = p.tokens + (p.pos - 1)
    # A record from another file's parse, or one at/after this annotation
    # (a failed alternative's), is stale.
    while p.ctx.var_latch != null and (p.ctx.var_latch.tokens != p.tokens or pos_after(end.line, end.col, p.ctx.var_latch.line, p.ctx.var_latch.col) == 0)
        p.ctx.var_latch = p.ctx.var_latch.below
    let r: *VarLatch = parser_alloc(p, sizeof(VarLatch)) as *VarLatch
    r.tokens = p.tokens
    r.line = end.line
    r.col = end.col
    r.below = p.ctx.var_latch
    r.type_name = p.var_type_name
    r.type_name_len = p.var_type_name_len
    r.pointee = p.var_pointee
    r.inner_pointee = p.var_inner_pointee
    r.inner_ref = p.var_inner_ref
    r.fn_sig = p.var_fn_sig
    r.ref = p.ctx.var_ref
    r.array = p.ctx.var_array
    r.array_size = p.ctx.var_array_size
    r.ptr_array_size = p.ctx.var_ptr_array_size
    r.ptr_array_elem = p.ctx.var_ptr_array_elem
    r.ptr_array_elem_pointee = p.ctx.var_ptr_array_elem_pointee
    r.ptr_array_shape = p.ctx.var_ptr_array_shape
    r.ptr_array_elem_name = p.ctx.var_ptr_array_elem_name
    r.ptr_array_elem_name_len = p.ctx.var_ptr_array_elem_name_len
    p.ctx.var_latch = r

# Restore the latches of the typed decl whose `let` is at (line, col).
fn pop_var_latch(p: *Parser, line: i32, col: i32)
    var mine: *VarLatch = null
    var r: *VarLatch = p.ctx.var_latch
    while r != null and r.tokens == p.tokens and pos_after(r.line, r.col, line, col) != 0
        mine = r
        r = r.below
    if mine == null
        return
    p.ctx.var_latch = mine.below
    p.var_type_name = mine.type_name
    p.var_type_name_len = mine.type_name_len
    p.var_pointee = mine.pointee
    p.var_inner_pointee = mine.inner_pointee
    p.var_inner_ref = mine.inner_ref
    p.var_fn_sig = mine.fn_sig
    p.ctx.var_ref = mine.ref
    p.ctx.var_array = mine.array
    p.ctx.var_array_size = mine.array_size
    p.ctx.var_ptr_array_size = mine.ptr_array_size
    p.ctx.var_ptr_array_elem = mine.ptr_array_elem
    p.ctx.var_ptr_array_elem_pointee = mine.ptr_array_elem_pointee
    p.ctx.var_ptr_array_shape = mine.ptr_array_shape
    p.ctx.var_ptr_array_elem_name = mine.ptr_array_elem_name
    p.ctx.var_ptr_array_elem_name_len = mine.ptr_array_elem_name_len

pub fn capture_var_type(p: *Parser, tr: *TypeRef) -> *TypeRef
    let ty: TypeKind = tr_kind(tr)
    let facts: *TypeFacts = type_facts(p, tr)
    p.ctx.var_ref = null
    if ty == TypeKind.Ref or ty == TypeKind.MutRef
        p.ctx.var_ref = param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, tr)
    p.ctx.var_array = null
    p.ctx.var_array_size = 0
    if ty == TypeKind.Array
        p.ctx.var_array = array_elem_of_type(p, tr)
        p.ctx.var_array_size = facts.array_size
    p.ctx.var_ptr_array_size = ptr_array_pointee_size(p, tr)
    p.ctx.var_ptr_array_elem = ptr_array_pointee_elem(p, tr)
    p.ctx.var_ptr_array_elem_pointee = ptr_array_elem_pointee(p, tr)
    p.ctx.var_ptr_array_shape = ptr_nd_pointee_shape(p, tr)   # AGAST #2098
    if p.ctx.var_ptr_array_shape != null
        p.ctx.var_ptr_array_size = nd_shape_count(p.ctx.var_ptr_array_shape)
        p.ctx.var_ptr_array_elem = p.ctx.var_ptr_array_shape.leaf_type
        p.ctx.var_ptr_array_elem_pointee = p.ctx.var_ptr_array_shape.leaf_pointee
    # AGAST #3663: and the element's name, as a `*[N]T` param's (#2321).
    p.ctx.var_ptr_array_elem_name = null
    p.ctx.var_ptr_array_elem_name_len = 0
    if ty == TypeKind.Ptr and p.ctx.var_ptr_array_shape == null and (p.ctx.var_ptr_array_elem == TypeKind.Struct or (p.ctx.var_ptr_array_elem == TypeKind.Ptr and p.ctx.var_ptr_array_elem_pointee == TypeKind.Struct))
        p.ctx.var_ptr_array_elem_name = facts.type_name
        p.ctx.var_ptr_array_elem_name_len = facts.type_name_len
    if ty == TypeKind.Struct
        p.var_type_name = facts.type_name
        p.var_type_name_len = facts.type_name_len
    else if ty == TypeKind.Ptr and facts.pointee_type == TypeKind.Struct
        p.var_type_name = facts.type_name
        p.var_type_name_len = facts.type_name_len
    else if (ty == TypeKind.Ref or ty == TypeKind.MutRef) and facts.ref_inner_type == TypeKind.Struct
        p.var_type_name = facts.type_name
        p.var_type_name_len = facts.type_name_len
    else if ty == TypeKind.PtrPtr and ptr_ptr_slot_inner(tr_ptr_ptr_inner_pointee(tr)) == TypeKind.Struct
        p.var_type_name = facts.type_name
        p.var_type_name_len = facts.type_name_len
    else if ty == TypeKind.PtrPtr and ptr_names_array_of_struct_ptrs(p, tr) == 1
        p.var_type_name = facts.type_name
        p.var_type_name_len = facts.type_name_len
    else
        p.var_type_name = null
        p.var_type_name_len = 0
    p.var_pointee = facts.pointee_type
    p.var_inner_pointee = tr_var_inner_pointee(tr)   # AGAST #3108
    p.var_inner_ref = facts.inner_ref   # AGAST #2399
    # AGAST #1671: latch a `let f: fn(...) -> T` signature before the
    # initializer is parsed.
    p.var_fn_sig = null
    if ty == TypeKind.Ptr or ty == TypeKind.Array
        p.var_fn_sig = facts.fn_sig
    push_var_latch(p)
    return tr

# =============================================================================
# Function-pointer types (AGAST #1671)
# =============================================================================
#
# `fn(u8) -> bool` lowers to TypeKind.Ptr like any pointer, but a call through
# such a value must use the callee's real LLVM signature: the callee is
# `define i1 @is_d(i8 ...)`, and calling it as `call i64 %f(i64 ...)` reads
# rax's garbage upper bits as the bool.  type_fn keeps the signature as a
# nameless FnDef (params + return type), the same shape a direct call
# consults, and leaves it in the last_fn_sig side channel tagged with the token position
# the type ended at.  fresh_fn_sig hands it out only while p.pos is still
# there, so it attaches to exactly the declaration whose type it is.
# Its line / col are the type's `fn` token (AGAST #3690): a call through it
# that can't be lowered is refused there.
pub fn type_fn(p: *Parser, params: *Param, ret: *TypeRef, line: i32, col: i32) -> *TypeRef
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    # AGAST #4324: the return side as capture_fn_return_type records it for a
    # named fn, from the same state (the return type_spec is the last thing
    # parsed).  Without these a slot `fn(..) -> *T` / `-> @T` / `-> [N]T` could
    # be neither spelled nor judged (fn_slot was silent on it).
    #
    # ret_fn_sig stays null (AGAST #2120), unlike capture_fn_return_type: a fn
    # type is re-parsed on every backtracked attempt, and each attempt ends on
    # the same token, so a nested `-> fn(..)` would self-chain.
    f.ret_fn_sig = null
    f.ret_ref = null
    f.ret_array = null
    f.ret_ptr_array = ptr_array_of_type(p, ret)   # AGAST #2329
    f.ret_array_param = null
    if tr_kind(ret) == TypeKind.Array
        f.ret_array = array_elem_of_type(p, ret)   # AGAST #2343
        f.ret_array_param = param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, ret)   # AGAST #2302
    if tr_kind(ret) == TypeKind.Ref or tr_kind(ret) == TypeKind.MutRef
        f.ret_ref = param_of_type(p, StrView { ptr: (null), len: (0) as i64 }, ret)   # AGAST #2308
    f.name = null
    f.name_len = 0
    f.params = params
    f.return_type = tr_kind(ret)
    # A `-> *T` / `-> @T` names its pointee as a named fn's return does, so a
    # fn-type slot spells and judges it (AGAST #4324).
    ret_name_of_type(p, ret, @f.return_type_name, @f.return_type_name_len)
    # AGAST #3286: `fn(..) -> void` returns nothing, as fn_def_new
    # normalises `-> void` for a named fn, so fn_is_procedure(sig)
    # refuses a use of its call's value instead of `%r = call void`.
    let rt: *u8 = f.return_type_name
    if f.return_type == TypeKind.Struct and f.return_type_name_len == 4 and rt != null and *rt == 'v' and *(rt + 1) == 'o' and *(rt + 2) == 'i' and *(rt + 3) == 'd'
        f.return_type = TypeKind.Void
        f.return_type_name = null
        f.return_type_name_len = 0
    f.body = null
    f.line = line
    f.next = null
    f.type_params = null
    f.is_local = 0
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    f.is_pub = 0
    f.col = col
    f.extern_decl = 0
    let t: *TypeRef = typeref_new(p, TypeKind.Ptr)
    t.fn_sig = f
    t

# AGAST #1509: 1 when the type just parsed (`ty`, with p's array state) is
# a multi-dimensional array `[N][M]..T`.
pub fn is_nd_array_type(p: *Parser, tr: *TypeRef) -> i32
    if tr != null and tr.kind == TypeKind.Array and tr.elem != null and tr.elem.kind == TypeKind.Array
        return 1
    0

# State: ParseCtx.nd_reject_line, .nd_reject_col

# AGAST #1509: fail closed where ritz1 cannot lower a multi-dimensional
# array type.  Only local and global `var` declarations, (AGAST #2097)
# struct fields and (#2098) the pointee of a `*` param or typed local
# (type_ptr_nd) carry an ArrayShape; an enum payload, parameter, return type, const or other pointee of type
# `[N][M]T` used to be laid out as `[N x i64]` and miscompiled silently.
# `what` names the site ("a struct field", ...).  Reported once per source
# position (the grammar can re-run an action while backtracking); the
# parse-time error count (ctx.attr_errors) fails the compile.
# Returns 1 when it rejected `ty`.
pub fn nd_array_reject(p: *Parser, tr: *TypeRef, line: i32, col: i32, what: *u8) -> i32
    if is_nd_array_type(p, tr) == 0
        return 0
    return nd_array_report(p.ctx, line, col, what)

# The diagnostic itself, for sites that already know the type is N-D.
fn nd_array_report(ctx: *ParseCtx, line: i32, col: i32, what: *u8) -> i32
    if line == ctx.nd_reject_line and col == ctx.nd_reject_col
        return 1
    ctx.nd_reject_line = line
    ctx.nd_reject_col = col
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_at(ctx.parse_file, diag_span(line, col))
    eprints("a multi-dimensional array type is not supported as ")
    eprints_cstr(what)
    eprintln(" in ritz1 (only a local or global `var` or a struct field can be one)")
    return 1

# =============================================================================
# An array literal's length is its slot's N (LANGUAGE_SPEC §3.3, LARB R42)
# =============================================================================
#
# AGAST #3383.  A list or fill must be exactly as long as the `[N]T` it fills:
# nothing is zero-filled, and a longer one is refused the same, at the literal.
# ritz0's twin is TypeChecker._check_literal_length; ritz0/array_rules.py has the
# wording, and ritz0/test_array_literal_length.py holds all three compilers to it.
#
# A slot is an ArrayShape read from depth `at`: dims[at..rank) around a leaf
# (rank 1 for a `[N]T`).  ref_check judges the slots inside a fn (ref_into); a
# const's and a global's initialiser is judged here as it is parsed, every
# nested literal against its row.  A length of 0 is one the caller doesn't know,
# and a leaf this can't spell goes unjudged: wrongly refusing is worse.

# How many elements the array literal or fill `e` has; -1 for anything else.
pub fn array_lit_elements(e: *Expr) -> i64
    if e == null
        return -1
    if e.kind == ExprKind.ArrayFill
        return e.int_val
    if e.kind != ExprKind.ArrayLit
        return -1
    var n: i64 = 0
    var el: *Expr = e.args
    while el != null
        n += 1
        el = el.next
    n

# `T` as Ritz spells it, for a primitive or struct T; null for anything else.
fn array_leaf_spell(kind: TypeKind, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let prim: *u8 = primitive_name_from_type(kind)
    if prim != null
        *out_len = primitive_name_len(kind)
        return prim
    if kind == TypeKind.Struct and name_len > 0
        *out_len = name_len
        return name
    null

# 1 if `e` is an array literal or fill of another length than the slot
# `shape` from `at`, which this can spell.  Only `e` itself is judged.
pub fn array_lit_wrong_length(e: *Expr, shape: *ArrayShape, at: i32) -> i32
    if at >= shape.rank or shape.dims[at] <= 0
        return 0
    let have: i64 = array_lit_elements(e)
    if have < 0 or have == shape.dims[at] as i64
        return 0
    var i: i32 = at
    while i < shape.rank
        if shape.dims[i] <= 0
            return 0
        i += 1
    var kind: TypeKind = shape.leaf_type
    if kind == TypeKind.Ptr
        kind = shape.leaf_pointee
    var len: i32 = 0
    if array_leaf_spell(kind, StrView { ptr: (shape.leaf_name), len: (shape.leaf_name_len) as i64 }, @len) == null
        return 0
    1

# The error itself, at `e`, in `file`; array_lit_wrong_length(e, shape, at) is 1.
pub fn array_lit_length_report(file: *u8, e: *Expr, shape: *ArrayShape, at: i32)
    diag_error_at(file, e.span)
    let have: i64 = array_lit_elements(e)
    eprints("an array literal of ")
    eprint_i64(have)
    if have == 1
        eprints(" element for a `")
    else
        eprints(" elements for a `")
    var i: i32 = at
    while i < shape.rank
        eprint_char('[')
        eprint_i64(shape.dims[i] as i64)
        eprint_char(']')
        i += 1
    var kind: TypeKind = shape.leaf_type
    if kind == TypeKind.Ptr
        eprint_char('*')
        kind = shape.leaf_pointee
    var len: i32 = 0
    let leaf: *u8 = array_leaf_spell(kind, StrView { ptr: (shape.leaf_name), len: (shape.leaf_name_len) as i64 }, @len)
    for j in 0..len
        eprint_char(*(leaf + j))
    eprintln("`")

# The last place a const or global literal was reported: the grammar can re-run
# an action while backtracking.
# State: ParseCtx.lit_len_line, .lit_len_col

# `e` and every literal nested in it, row by row, against `shape` from `at`: a
# const's or a global's initialiser.  Each is a parse error.
fn array_lit_length_walk(ctx: *ParseCtx, e: *Expr, shape: *ArrayShape, at: i32)
    if e == null or at >= shape.rank
        return
    if array_lit_wrong_length(e, shape, at) == 1
        if e.span.line == ctx.lit_len_line and e.span.col == ctx.lit_len_col
            return
        ctx.lit_len_line = e.span.line
        ctx.lit_len_col = e.span.col
        ctx.attr_errors = ctx.attr_errors + 1
        array_lit_length_report(ctx.parse_file, e, shape, at)
        return
    match e.kind
        ExprKind.ArrayFill =>
            array_lit_length_walk(ctx, e.left, shape, at + 1)
        ExprKind.ArrayLit =>
            var el: *Expr = e.args
            while el != null
                array_lit_length_walk(ctx, el, shape, at + 1)
                el = el.next
        _ => pass

# A const's or global's `[N]..T` initialiser, as the parser has just latched
# the type: the N-D shape if there is one, else `[N]T` from the last_array_* side channel.
pub fn array_lit_length_decl(p: *Parser, tr: *TypeRef, init: *Expr)
    if tr_kind(tr) != TypeKind.Array or init == null
        return
    let facts: *TypeFacts = type_facts(p, tr)
    if facts.array_shape != null
        array_lit_length_walk(p.ctx, init, facts.array_shape, 0)
        return
    var one: ArrayShape
    one.rank = 1
    one.dims[0] = facts.array_size
    one.leaf_type = facts.array_elem_type
    one.leaf_name = facts.array_elem_type_name
    one.leaf_name_len = facts.array_elem_type_name_len
    one.leaf_pointee = facts.array_elem_pointee
    array_lit_length_walk(p.ctx, init, @one, 0)

# AGAST #2298: the furthest `dyn` reported in this file, null for none.  The
# grammar re-runs dyn_kw's action each time it backtracks over a `dyn`, and a
# backtrack only ever returns to an earlier token of the same source, so a
# `dyn` at or before this one has been reported already.
# State: ParseCtx.dyn_last

# Grammar action for dyn_kw (AGAST #2298): fail the alternative (p.error)
# unless the IDENT is `dyn`; otherwise refuse it where it is written, once,
# and count it in ctx.attr_errors, which fails the compile.  ritz1 has no trait
# objects; whether the language does is AGAST #1620's decision.
pub fn dyn_kw_refuse(p: *Parser, name_sv: StrView, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if not (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"dyn"), len: (3) as i64 })
        p.error = 1
        return 0
    if p.ctx.dyn_last != null and name <= p.ctx.dyn_last
        return 0
    p.ctx.dyn_last = name
    p.ctx.attr_errors = p.ctx.attr_errors + 1
    diag_error(p.ctx.parse_file, diag_span(line, col), c"`dyn Trait` is not supported (AGAST #1620)")
    return 0

# AGAST #3471: the furthest closure reported in this file, null for none.
# As with ctx.dyn_last, a backtrack re-runs the action over the same `|` / `fn`.
# State: ParseCtx.closure_last

# Grammar action for closure_ahead (AGAST #3471): a `|` that follows a type
# is a union (`-> A | B`), not a closure; fail without reading a token.
pub fn closure_ahead_check(p: *Parser) -> i32
    if union_type_at(p, p.pos) == 1
        p.error = 1
    0

# Grammar action for a closure or lambda expression (LARB R56, AGAST #3471):
# refuse it at its `|` / `||` / `fn`, once, in ritz0's words, and count it in
# ctx.attr_errors, which fails the compile.  The value is a placeholder `null`.
pub fn closure_refused(p: *Parser, at: *u8, line: i32, col: i32) -> *Expr
    if p.skip_item == 0 and (p.ctx.closure_last == null or at > p.ctx.closure_last)
        p.ctx.closure_last = at
        p.ctx.attr_errors = p.ctx.attr_errors + 1
        diag_error(p.ctx.parse_file, diag_span(line, col), c"closures aren't supported: write a named fn and pass it by name (§5.5)")
    expr_nil(p, line, col)

# Grammar action for `[pub] async fn` (AGAST #1456): mark `f` async.
# async_lower.ritz lowers it to ritz0's state machine (AGAST #3814).
pub fn fn_async(p: *Parser, f: *FnDef, col: i32) -> *FnDef
    f.is_async = 1
    f

# Grammar action for `await e` (AGAST #1456): an ExprKind.Await node, which
# async_lower.ritz lowers (AGAST #3814).
pub fn expr_await(p: *Parser, operand: *Expr, at: *u8, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Await
    e.span.line = line
    e.span.col = col
    e.operand = operand
    e.next = null
    e

# Grammar action for `heap e` (AGAST #3934): ritz0's HeapExpr, as the call
# `__heap_new(e)` of ritzlib.memory's generic.  generic_infer binds its T from
# e as for any call (an integer literal is an i64, as ritz0's `heap 42` is a
# *i64), so the slot, the store and the `*T` it returns are the generic's.
# The call is the compiler's, not the input's: sema_vis_use lets it reach
# ritzlib.memory through any import, as ritz0 finds malloc wherever it is
# loaded, and cc_unknown words a missing one as ritz0 does.
pub fn expr_heap(p: *Parser, operand: *Expr, line: i32, col: i32) -> *Expr
    expr_call(p, StrView { ptr: (c"__heap_new"), len: (10) as i64 }, operand, line, col)

# 1 if `name` (a generic instance's `$` suffix aside) is the fn `heap e`
# calls, `__heap_new` (AGAST #3934).
pub fn is_heap_new(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len < 10 or memcmp(name, c"__heap_new", 10) != 0
        return 0
    if len == 10 or name[10] == '$'
        return 1
    0

# The line / col of the token at p.pos (0 / 0 past the end), for sites whose
# action has no position of its own.
fn parse_pos_line(p: *Parser) -> i32
    if p.pos < p.token_count
        let tok: *Token = p.tokens + p.pos
        return tok.line
    0

fn parse_pos_col(p: *Parser) -> i32
    if p.pos < p.token_count
        let tok: *Token = p.tokens + p.pos
        return tok.col
    0

# Parse array size from digit string and build the `[N]elem` TypeRef.
pub fn type_array(p: *Parser, size_str_sv: StrView, elem: *TypeRef) -> *TypeRef
    var size_str: *u8 = size_str_sv.ptr
    var size_len: i32 = size_str_sv.len as i32
    # Parse the size string to an integer
    var size: i32 = 0
    for i in 0..size_len
        let digit: i32 = (*(size_str + i)) as i32 - 48  # '0' = 48
        size = size * 10 + digit
    type_array_sized(p, size, elem)

# AGAST #2153: `[N]T` / `[N * 2]T` — the length is a constant integer
# expression, folded now against the consts parsed so far.
#
# AGAST #2167: imports are merged only after parsing, so a const from an
# import, or one declared later in this file, does not fold on the first
# pass.  That pass records the length as pending (size 0, no diagnostic) and
# main.ritz parses the program again, as it does for a type alias (#1475),
# with array_len_seed() holding every const the first pass merged.  So every
# reader of the length (layout, shapes, mangled names, sizeof) sees the
# folded value: nothing downstream knows a length was ever pending.  What
# still doesn't fold on the second pass is a located error, never a silently
# wrong length.
# State: ParseCtx.array_len_pending, .array_len_reparse, .array_len_seed

# 1 when the first pass left a length to the second.
pub fn array_len_pending(ctx: *ParseCtx) -> i32
    ctx.array_len_pending

# Before the second pass: fold a length the file's own consts can't against
# `consts` (the first pass's merged list), and report what still doesn't.
pub fn array_len_seed(ctx: *ParseCtx, consts: *ConstEntry)
    ctx.array_len_seed = consts
    ctx.array_len_reparse = 1
    ctx.array_len_pending = 0

pub fn type_array_expr(p: *Parser, len_expr: *Expr, line: i32, col: i32, elem: *TypeRef) -> *TypeRef
    var v: i64 = 0
    var folded: i32 = const_fold_int(p.module.constants, len_expr, 0, @v)
    if folded == 0 and p.ctx.array_len_seed != null
        folded = const_fold_int(p.ctx.array_len_seed, len_expr, 1, @v)
    if folded == 0
        if p.ctx.array_len_reparse == 0
            p.ctx.array_len_pending = 1
        else if array_len_overflow(p, len_expr) == 0
            array_len_report(p.ctx, line, col, c"is not a constant integer expression")
        v = 0
    else if v < 0 or v > 2147483647
        array_len_report(p.ctx, line, col, c"is out of range (it must be 0 to 2147483647)")
        v = 0
    type_array_sized(p, v as i32, elem)

# The backtracking parser re-runs an action each time it retries the
# alternative: report each `[` once, as nd_array_report does.
# State: ParseCtx.array_len_line, .array_len_col

# LARB R63 (AGAST #3489): a length that overflows, `[9223372036854775807 + 1]u8`,
# says so at the operation, as ritz0's const evaluator does.  1 if reported.
fn array_len_overflow(p: *Parser, len_expr: *Expr) -> i32
    var site: *Expr = const_overflow_site(p.module.constants, len_expr, 0)
    if site == null and p.ctx.array_len_seed != null
        site = const_overflow_site(p.ctx.array_len_seed, len_expr, 1)
    if site == null
        return 0
    if site.span.line != p.ctx.array_len_line or site.span.col != p.ctx.array_len_col
        p.ctx.array_len_line = site.span.line
        p.ctx.array_len_col = site.span.col
        p.ctx.attr_errors = p.ctx.attr_errors + 1
        const_overflow_report(p.ctx.parse_file, site)
    1

fn array_len_report(ctx: *ParseCtx, line: i32, col: i32, why: *u8)
    if line == ctx.array_len_line and col == ctx.array_len_col
        return
    ctx.array_len_line = line
    ctx.array_len_col = col
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_at(ctx.parse_file, diag_span(line, col))
    eprints("array length ")
    eprintln_cstr(why)

# AGAST #2343: the element of the `[N]T` this type wraps, as an ArrayElem.
fn array_elem_of_type(p: *Parser, tr: *TypeRef) -> *ArrayElem
    let a: *TypeRef = tr_array_node(tr)
    let e: *TypeRef = tr_array_node_elem(tr)
    let ae: *ArrayElem = parser_alloc(p, sizeof(ArrayElem)) as *ArrayElem
    ae.elem = tr_kind(e)
    ae.pointee = tr_elem_pointee(a)
    ae.name = tr_elem_name(a, @ae.name_len)
    ae.shape = tr_shape(a)
    # AGAST #2995: the `[M]T` that the element of `[N]*[M]T` points at.
    ae.ptr_array = null
    ae.ptr_array_size = 0
    ae.ptr_plane = null
    if e != null and e.kind == TypeKind.Ptr
        if e.pointee != null and e.pointee.kind == TypeKind.Array
            if e.pointee.shape == null
                let inner: *ArrayElem = parser_alloc(p, sizeof(ArrayElem)) as *ArrayElem
                inner.elem = tr_elem_kind(e.pointee)
                inner.pointee = tr_elem_pointee(e.pointee)
                inner.name = tr_elem_name(e.pointee, @inner.name_len)
                inner.shape = null
                inner.ptr_array = null
                inner.ptr_array_size = 0
                inner.ptr_plane = null
                ae.ptr_array = inner
                ae.ptr_array_size = tr_count(e.pointee) as i32
            else
                ae.ptr_plane = e.pointee.shape
    return ae

# AGAST #2995 / #1509: `[N]T` from an already-parsed element type `elem`.
fn type_array_sized(p: *Parser, size: i32, elem: *TypeRef) -> *TypeRef
    let t: *TypeRef = typeref_new(p, TypeKind.Array)
    t.elem = elem
    t.count = size as i64
    # AGAST #1509: `[size]<array>` is multi-dimensional.  `elem` is the inner
    # `[M]T`, so prepend `size` to its shape.
    t.shape = null
    if elem != null
        if elem.kind == TypeKind.Array
            t.shape = array_shape_prepend_type(p, size, elem)
    t

# AGAST #1509: rank-2 shape for `[size][M]T`, or one leading dim on a deeper
# inner shape.  null (and reported) past MAX_ARRAY_RANK.
fn array_shape_prepend_type(p: *Parser, size: i32, elem: *TypeRef) -> *ArrayShape
    let inner: *ArrayShape = tr_shape(elem)
    let sh: *ArrayShape = parser_alloc(p, sizeof(ArrayShape)) as *ArrayShape
    sh.dims[0] = size
    if inner == null
        sh.rank = 2
        sh.dims[1] = tr_count(elem) as i32
        sh.leaf_type = tr_elem_kind(elem)
        sh.leaf_name = tr_elem_name(elem, @sh.leaf_name_len)
        sh.leaf_pointee = tr_elem_pointee(elem)
        return sh
    if inner.rank >= MAX_ARRAY_RANK
        diag_error(p.ctx.parse_file, parse_span_at(p, p.pos), c"array type has more than 8 dimensions")
        p.ctx.attr_errors = p.ctx.attr_errors + 1
        return null
    sh.rank = inner.rank + 1
    var d: i32 = 0
    while d < inner.rank
        sh.dims[d + 1] = inner.dims[d]
        d = d + 1
    sh.leaf_type = inner.leaf_type
    sh.leaf_name = inner.leaf_name
    sh.leaf_name_len = inner.leaf_name_len
    sh.leaf_pointee = inner.leaf_pointee
    return sh

# AGAST #1815: the innermost pointee of `**T`, for Param / Stmt /
# GlobalVarDef / StructField.  AGAST #1924: a `***T` (or deeper) packs its
# extra levels in as multiples of PTR_DEPTH_UNIT.
pub fn ptr_ptr_inner_pointee(p: *Parser, tr: *TypeRef) -> i32
    tr_ptr_ptr_inner_pointee(tr)

# AGAST #3108: the inner pointee slot a local type records.
pub fn var_inner_pointee_of(p: *Parser, tr: *TypeRef) -> i32
    tr_var_inner_pointee(tr)

# AGAST #2343: U for `*[N]*U` (TypeKind.Void otherwise).
pub fn ptr_array_elem_pointee(p: *Parser, tr: *TypeRef) -> TypeKind
    if ptr_names_array(p, tr) == 0
        return TypeKind.Void
    let a: *TypeRef = tr_array_node(tr)
    tr_elem_pointee(a)

# AGAST #2539: 1 for `*[N]T` / `**[N]T` / `@*[N]T` / `@&*[N]T`.
fn ptr_names_array(p: *Parser, tr: *TypeRef) -> i32
    let a: *TypeRef = tr_array_node(tr)
    if a == null
        return 0
    if tr == null
        return 0
    match tr.kind
        TypeKind.Ptr =>
            return (a == tr.pointee) as i32
        TypeKind.PtrPtr =>
            if tr_depth(tr) != 2 or tr.pointee == null
                return 0
            if a == tr.pointee.pointee
                return 1
            return 0
        TypeKind.Ref | TypeKind.MutRef =>
            if tr.ref_inner == TypeKind.Ptr and a == tr.pointee.pointee
                return 1
            return 0
        _ => pass
    0

# AGAST #2098: the shape of `*[N][M]..T`; null for any other type.  #3635: and
# a `**[N][M]..T`; #4122: `@*[N][M]..T` / `@&*[N][M]..T`.
pub fn ptr_nd_pointee_shape(p: *Parser, tr: *TypeRef) -> *ArrayShape
    if ptr_names_array(p, tr) == 0
        return null
    let a: *TypeRef = tr_array_node(tr)
    tr_shape(a)

# The element count of `sh`, every dimension multiplied.
fn nd_shape_count(sh: *ArrayShape) -> i32
    var n: i32 = 1
    var i: i32 = 0
    while i < sh.rank
        n = n * sh.dims[i]
        i = i + 1
    n

# AGAST #1953: N for `*[N]T` (0 otherwise), or `**[N]T` (#2539).
pub fn ptr_array_pointee_size(p: *Parser, tr: *TypeRef) -> i32
    if ptr_names_array(p, tr) == 0
        return 0
    let a: *TypeRef = tr_array_node(tr)
    tr_count(a) as i32

# AGAST #1953: T for `*[N]T` (TypeKind.Void otherwise), or `**[N]T` (#2539).
pub fn ptr_array_pointee_elem(p: *Parser, tr: *TypeRef) -> TypeKind
    if ptr_names_array(p, tr) == 0
        return TypeKind.Void
    let a: *TypeRef = tr_array_node(tr)
    tr_elem_kind(a)

# Handle pointer type *T
pub fn type_ptr(p: *Parser, inner: *TypeRef) -> *TypeRef
    nd_array_reject(p, inner, parse_pos_line(p), parse_pos_col(p), c"a pointee")  # AGAST #1509
    type_ptr_nd(p, inner)

# AGAST #2098: `*T`, where an N-D T `[N][M]..T` is lowered (#4122: `**[N]T`,
# `@*[N]T` too).  `inner` is what the `*` wraps.
pub fn type_ptr_nd(p: *Parser, inner: *TypeRef) -> *TypeRef
    var target: *TypeRef = ref_as_pointer(p, inner)   # AGAST #2399
    let t: *TypeRef = typeref_new(p, TypeKind.Ptr)
    # AGAST #184 / #1924: `T` and `**T`/`***T` — the kind is flat PTR_PTR for
    # any depth >= 2; the chain carries the depth.
    if tr_kind(target) == TypeKind.Ptr or tr_kind(target) == TypeKind.PtrPtr
        t.kind = TypeKind.PtrPtr
    t.pointee = target
    # `last_inner_ref`: what the nearest level was, for a write and `*p`.
    if is_indirection_kind(tr_kind(target)) == 0
        t.inner_ref = INNER_REF_NONE
    else
        t.inner_ref = tr_inner_ref(target)
    t

# =============================================================================
# Type aliases (AGAST #1475)
# =============================================================================
#
# `type Name = T` is transparent, as in ritz0: the alias IS T.  ritz1 has no
# type objects, only a kind (TYPE_*) plus side-channel parser state that
# type_spec leaves behind (last_type_name for structs/generics, pointee info
# for pointers, element info for arrays, inner kind for refs).  So an alias
# is a snapshot of exactly that state, taken when its declaration is parsed,
# and type_named replays it wherever the alias name is used as a type.  The
# emitter and monomorph never see an alias name.
#
# The table is process-wide, not per-Parser: aliases must be visible across
# modules (goliath: `import goliath.error { ErrorCode }`).  Because an
# importer is parsed before its imports, and items may be used before they
# are declared, the driver re-parses everything once when the first pass
# recorded any alias (main.ritz, reparse_with_aliases).  Re-recording in that
# pass overwrites each entry by name, which is also how an alias of an alias
# declared later in the file settles.
#
# Parallel pointer arrays of heap entries (not an array of structs), the
# same shape the enum tracker below uses under self-hosting.

struct AliasEntry
    name: *u8
    name_len: i32
    kind: TypeKind
    type_name: *u8
    type_name_len: i32
    pointee_type: TypeKind
    inner_pointee_type: i32
    array_size: i32
    array_elem_type: TypeKind
    array_elem_pointee: TypeKind
    array_elem_type_name: *u8
    array_elem_type_name_len: i32
    ref_inner_type: TypeKind
    inner_ref: i32  # AGAST #2399
    ptr_depth: i32         # AGAST #1924
    array_shape: *ArrayShape  # AGAST #1509
    fn_sig: *FnDef         # AGAST #1879: a fn type's signature (type_fn)
    spelling: *u8          # AGAST #3625: the target as written (type_alias_spell)
    spelling_len: i32

const MAX_TYPE_ALIASES: i32 = 1024

# State: ParseCtx.alias_table, .alias_count

pub fn type_alias_count(ctx: *ParseCtx) -> i32
    ctx.alias_count

# AGAST #3907: every enum and type alias declared, in parse order, across
# every file and both parse passes; never reset.  The tables above record no
# file, so import_vis marks the log before a file is parsed and reads what
# the file added after (type_decl_log_count / type_decl_log_at).
# State: ParseCtx.tdl_names, .tdl_lens, .tdl_count, .tdl_cap

fn type_decl_log(ctx: *ParseCtx, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if ctx.tdl_count >= ctx.tdl_cap
        var cap: i32 = ctx.tdl_cap * 2
        if cap == 0
            cap = 256
        ctx.tdl_names = realloc(ctx.tdl_names as *u8, (cap as i64) * 8) as **u8
        ctx.tdl_lens = realloc(ctx.tdl_lens as *u8, (cap as i64) * 4) as *i32
        ctx.tdl_cap = cap
    *(ctx.tdl_names + ctx.tdl_count) = name
    *(ctx.tdl_lens + ctx.tdl_count) = len
    ctx.tdl_count = ctx.tdl_count + 1

pub fn type_decl_log_count(ctx: *ParseCtx) -> i32
    ctx.tdl_count

pub fn type_decl_log_at(ctx: *ParseCtx, i: i32, out_len: *i32) -> *u8
    *out_len = *(ctx.tdl_lens + i)
    *(ctx.tdl_names + i)

# AGAST #3907: each type alias written, in parse order: type_named replaces
# it with its target, so sema never sees the name.  `name` points into the
# file's tokens, so a use the parser backtracks over and parses again is
# logged once.  Never reset; parse_program marks the input file's range.
# State: ParseCtx.aul_names, .aul_lens, .aul_spans, .aul_count, .aul_cap

fn alias_use_log(p: *Parser, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = p.ctx.aul_count - 1
    while i >= 0 and i >= p.ctx.aul_count - 64
        if *(p.ctx.aul_names + i) == name
            return
        i = i - 1
    if p.ctx.aul_count >= p.ctx.aul_cap
        var cap: i32 = p.ctx.aul_cap * 2
        if cap == 0
            cap = 256
        p.ctx.aul_names = realloc(p.ctx.aul_names as *u8, (cap as i64) * 8) as **u8
        p.ctx.aul_lens = realloc(p.ctx.aul_lens as *u8, (cap as i64) * 4) as *i32
        p.ctx.aul_spans = realloc(p.ctx.aul_spans as *u8, (cap as i64) * sizeof(SrcSpan)) as *SrcSpan
        p.ctx.aul_cap = cap
    *(p.ctx.aul_names + p.ctx.aul_count) = name
    *(p.ctx.aul_lens + p.ctx.aul_count) = len
    # The alias's IDENT is the token just taken.
    *(p.ctx.aul_spans + p.ctx.aul_count) = parse_span_at(p, p.pos - 1)
    p.ctx.aul_count = p.ctx.aul_count + 1

pub fn alias_use_count(ctx: *ParseCtx) -> i32
    ctx.aul_count

pub fn alias_use_at(ctx: *ParseCtx, i: i32, out_len: *i32, out_span: *SrcSpan) -> *u8
    *out_len = *(ctx.aul_lens + i)
    *out_span = *(ctx.aul_spans + i)
    *(ctx.aul_names + i)

fn type_alias_find(ctx: *ParseCtx, name_sv: StrView) -> *AliasEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < ctx.alias_count
        let e: *AliasEntry = *(ctx.alias_table + i) as *AliasEntry
        if (StrView { ptr: (e.name), len: (e.name_len) as i64 }).eq(StrView { ptr: (name), len: (len) as i64 })
            return e
        i = i + 1
    return null

# AGAST #3264: 1 if a `type` alias of that name was declared (an impl on it
# is on a known type).
pub fn type_alias_declared(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if type_alias_find(ctx, StrView { ptr: (name), len: (len) as i64 }) != null
        return 1
    0

# AGAST #3369: how the type an alias names is written, for "write `impl
# Foo`" (LARB R35), with its length in *out_len; null if it wasn't recorded.
# The alias's own tokens (#3625), since the table keeps a pointer, array or
# generic instance (`Box$u8`) only in replay form.
pub fn type_alias_target_spelling(ctx: *ParseCtx, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *AliasEntry = type_alias_find(ctx, StrView { ptr: (name), len: (len) as i64 })
    if e == null
        return null
    *out_len = e.spelling_len
    e.spelling

# 1 if `c` is a letter, digit or `_`.
fn alias_word_char(c: u8) -> i32
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
        return 1
    0

# 1 if `t` is `->`.
fn alias_tok_arrow(t: *Token) -> i32
    if t.len == 2 and *t.start == '-' and *(t.start + 1) == '>'
        return 1
    0

# AGAST #3625: the target of the alias whose name token starts at `name`,
# spelled from its tokens as ritz0's type_to_string prints it: `*Foo`,
# `[4]u8`, `Box<u8, i32>`, `*mut Foo`, `fn(i32) -> i32`.  A space after `,`,
# around `->` and between two words; none elsewhere.  The type's tokens run
# from after the name's `=` to the item's NEWLINE, just before p.pos.
fn type_alias_spell(p: *Parser, name: *u8, out_len: *i32) -> *u8
    var i: i32 = p.pos - 1
    while i >= 0 and (*(p.tokens + i)).start != name
        i = i - 1
    if i < 0
        return null
    let first: i32 = i + 2   # past the name and `=`
    var last: i32 = p.pos - 1
    while last >= first and (*(p.tokens + last)).kind == TOK_NEWLINE
        last = last - 1
    var cap: i32 = 0
    var k: i32 = first
    while k <= last
        cap = cap + (*(p.tokens + k)).len + 2
        k = k + 1
    let buf: *u8 = malloc((cap + 1) as i64)
    var n: i32 = 0
    k = first
    while k <= last
        let t: *Token = p.tokens + k
        if k > first
            let prev: *Token = p.tokens + (k - 1)
            let pc: u8 = *(prev.start + prev.len - 1)
            let words: i32 = alias_word_char(pc) & alias_word_char(*t.start)
            if words == 1 or pc == ',' or alias_tok_arrow(t) == 1 or alias_tok_arrow(prev) == 1
                *(buf + n) = ' '
                n = n + 1
        var j: i32 = 0
        while j < t.len
            *(buf + n) = *(t.start + j)
            n = n + 1
            j = j + 1
        k = k + 1
    *(buf + n) = 0
    *out_len = n
    buf

# Does replaying this kind need the side-channel state?  Primitive kinds
# carry everything in the kind itself, and type_spec's primitive
# alternatives leave the parser state untouched, so an alias of one must
# too (otherwise it would replay whatever stale struct name happened to be
# in last_type_name when the alias was declared).
fn type_alias_kind_has_state(kind: TypeKind) -> i32
    match kind
        TypeKind.Ptr | TypeKind.PtrPtr =>
            return 1
        TypeKind.Struct | TypeKind.Array | TypeKind.Ref | TypeKind.MutRef =>
            return 1
        _ => pass
    return 0

# Grammar action for type_alias_def.  Runs after type_spec, so `tr` is the
# target type.  attrs ran first, so p.skip_item is already set for a
# [[target_os = "<not linux>"]] alias: don't record it.
pub fn type_alias_record(p: *Parser, name_sv: StrView, tr: *TypeRef) -> *TypeRef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if p.skip_item != 0
        gated_decl_log(p.ctx, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3467
        return tr
    # AGAST #4021: the target, before NEWLINE, judged even if the alias is
    # never used (a use replays it, and is judged as the target).
    tn_note_last(p, 2)
    tn_claim(p, null, null)
    var e: *AliasEntry = type_alias_find(p.ctx, StrView { ptr: (name), len: (len) as i64 })
    if e == null
        if p.ctx.alias_table == null
            p.ctx.alias_table = malloc((MAX_TYPE_ALIASES as i64) * 8) as **u8
        if p.ctx.alias_count >= MAX_TYPE_ALIASES
            # Never drop a declaration silently: an unrecorded alias would
            # surface much later as an unknown struct type.
            diag_error(p.ctx.parse_file, parse_span_at(p, p.pos), c"too many type aliases (raise MAX_TYPE_ALIASES)")
            p.error = 1
            return tr
        e = malloc(sizeof(AliasEntry)) as *AliasEntry
        *(p.ctx.alias_table + p.ctx.alias_count) = e as *u8
        p.ctx.alias_count = p.ctx.alias_count + 1
    type_decl_log(p.ctx, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3907: a redeclaration too
    # The alias table is process-wide (it must outlive this Parser's arena), so
    # it keeps the flat snapshot, and type_alias_resolve rebuilds a *TypeRef
    # from it.  Nothing is latched on the Parser any more (#4035).
    let f: *TypeFacts = type_facts(p, tr)
    e.name = name
    e.name_len = len
    e.kind = f.kind
    e.type_name = f.type_name
    e.type_name_len = f.type_name_len
    e.pointee_type = f.pointee_type
    e.inner_pointee_type = f.inner_pointee_type
    e.ptr_depth = f.ptr_depth
    e.array_size = f.array_size
    e.array_elem_type = f.array_elem_type
    e.array_elem_pointee = f.array_elem_pointee
    e.array_elem_type_name = f.array_elem_type_name
    e.array_elem_type_name_len = f.array_elem_type_name_len
    e.array_shape = f.array_shape
    e.ref_inner_type = f.ref_inner_type
    e.inner_ref = f.inner_ref   # AGAST #2399
    # AGAST #1879: a fn-type alias keeps its signature.
    e.fn_sig = f.fn_sig
    if e.fn_sig != null and (p.ctx.attr_bits & ATTR_WIN64) != 0
        item_attr_record(p.ctx, e.fn_sig as *u8, ATTR_WIN64)
    var slen: i32 = 0
    e.spelling = type_alias_spell(p, name, @slen)
    e.spelling_len = slen
    return tr

# Grammar action around an alias's type.  #4035: the *TypeRef is already the
# whole snapshot, so there is nothing left to latch.
pub fn alias_type_latch(p: *Parser, tr: *TypeRef) -> *TypeRef
    tr

# The leaf `*TypeRef` an alias snapshot names: a struct by the recorded name,
# a primitive by the recorded kind.
fn alias_leaf_typeref(p: *Parser, kind: TypeKind, name: *u8, name_len: i32) -> *TypeRef
    let t: *TypeRef = typeref_new(p, kind)
    if kind == TypeKind.Struct
        t.name = name
        t.name_len = name_len
    t

# A pointer chain `depth` levels deep ending in `leaf`, as type_ptr_nd builds
# it (`**T` is PTR_PTR -> PTR -> T).  `inner_ref` goes on the outermost level,
# as type_ptr_nd leaves it.
fn alias_ptr_chain(p: *Parser, depth: i32, leaf: *TypeRef, inner_ref: i32) -> *TypeRef
    var t: *TypeRef = typeref_new(p, TypeKind.Ptr)
    t.pointee = leaf
    var d: i32 = 1
    while d < depth
        let outer: *TypeRef = typeref_new(p, TypeKind.PtrPtr)
        outer.pointee = t
        outer.inner_ref = INNER_REF_NONE
        t = outer
        d = d + 1
    t.inner_ref = inner_ref
    t

# A deep pointee from the flat, PTR_DEPTH_UNIT-packed slot the alias table
# keeps (`tr_ptr_ptr_inner_pointee`'s answer): the kind itself, plus one
# `**` level per PTR_DEPTH_UNIT past the first two.
fn alias_packed_ptr_typeref(p: *Parser, slot: i32, name: *u8, name_len: i32) -> *TypeRef
    let raw: TypeKind = ptr_ptr_slot_inner(slot)
    var depth: i32 = 2
    if ptr_slot_extra(slot) > 0 and raw != TypeKind.Void
        depth = ptr_ptr_slot_levels(slot)
    let leaf: *TypeRef = alias_leaf_typeref(p, raw, name, name_len)
    alias_ptr_chain(p, depth, leaf, INNER_REF_NONE)

# The element of an alias snapshot's array: a primitive, a struct by its
# recorded name, or the pointer / reference / packed-pointer the flat
# `array_elem_type` / `array_elem_pointee` pair describes.
fn alias_array_elem_typeref(p: *Parser, e: *AliasEntry) -> *TypeRef
    let k: TypeKind = e.array_elem_type
    var name: *u8 = e.array_elem_type_name
    var name_len: i32 = e.array_elem_type_name_len
    match k
        TypeKind.Ptr =>
            let t: *TypeRef = typeref_new(p, TypeKind.Ptr)
            t.pointee = alias_leaf_typeref(p, e.array_elem_pointee, name, name_len)
            return t
        TypeKind.PtrPtr =>
            return alias_packed_ptr_typeref(p, (e.array_elem_pointee as i32), name, name_len)
        TypeKind.Ref | TypeKind.MutRef =>
            let t: *TypeRef = typeref_new(p, k)
            t.pointee = alias_leaf_typeref(p, e.array_elem_pointee, name, name_len)
            t.ref_inner = e.array_elem_pointee
            return t
        _ => pass
    alias_leaf_typeref(p, k, name, name_len)

# An array `[N]..T` from an alias snapshot.  `shape` (when present) names every
# dimension; otherwise `count` is the one dimension.
fn alias_array_typeref(p: *Parser, e: *AliasEntry) -> *TypeRef
    let sh: *ArrayShape = e.array_shape
    var count: i64 = e.array_size as i64
    var elem_kind: TypeKind = e.array_elem_type
    if sh != null
        count = sh.dims[0] as i64
        elem_kind = sh.leaf_type
        if sh.rank > 1
            elem_kind = TypeKind.Array
    let t: *TypeRef = typeref_new(p, TypeKind.Array)
    t.count = count
    t.shape = sh
    if elem_kind == TypeKind.Array
        let inner: *TypeRef = typeref_new(p, TypeKind.Array)
        if sh != null and sh.rank > 1
            inner.count = sh.dims[1] as i64
            if sh.rank > 2
                inner.elem = typeref_new(p, TypeKind.Array)
        else
            inner.count = e.array_size as i64
        t.elem = inner
    else
        t.elem = alias_array_elem_typeref(p, e)
    t

# The referent of an alias's `@T` / `@&T`: its own pointer when `ref_inner` is
# one, else the referent kind itself.
fn alias_referent_typeref(p: *Parser, e: *AliasEntry) -> *TypeRef
    match e.ref_inner_type
        TypeKind.Ptr =>
            if e.pointee_type == TypeKind.Array
                let arr: *TypeRef = alias_array_typeref(p, e)
                let ptr: *TypeRef = typeref_new(p, TypeKind.Ptr)
                ptr.pointee = arr
                return ptr
            let ptr: *TypeRef = typeref_new(p, TypeKind.Ptr)
            ptr.pointee = alias_leaf_typeref(p, e.pointee_type, e.type_name, e.type_name_len)
            return ptr
        TypeKind.PtrPtr =>
            # The referent is a `**..T`: its depth comes from the snapshot's
            # ptr_depth, its leaf from the recorded inner pointee.
            var leaf_kind: i32 = e.inner_pointee_type
            if ptr_slot_extra(leaf_kind) > 0
                leaf_kind = (ptr_ptr_slot_inner(leaf_kind) as i32)
            let leaf: *TypeRef = alias_leaf_typeref(p, ptr_slot_flat(leaf_kind), e.type_name, e.type_name_len)
            var depth: i32 = e.ptr_depth
            if depth < 2
                depth = 2
            return alias_ptr_chain(p, depth, leaf, INNER_REF_NONE)
        TypeKind.Array =>
            return alias_array_typeref(p, e)
        _ => pass
    alias_leaf_typeref(p, e.ref_inner_type, e.type_name, e.type_name_len)

# A `*..T` from an alias snapshot: `ptr_depth` levels ending in the recorded
# leaf kind (`PTR_DEPTH_UNIT`-packed past two, as the flat slot was).
fn alias_pointer_typeref(p: *Parser, e: *AliasEntry) -> *TypeRef
    let depth: i32 = e.ptr_depth
    if depth >= 2
        # Every level past two is packed into the inner-pointee slot; unpack
        # it back into the chain the parser would have built.
        if ptr_slot_extra(e.inner_pointee_type) > 0
            return alias_packed_ptr_typeref(p, e.inner_pointee_type, e.type_name, e.type_name_len)
        let leaf_kind: TypeKind = ptr_ptr_slot_inner(e.inner_pointee_type)
        var leaf: *TypeRef = null
        if leaf_kind == TypeKind.Array
            leaf = alias_array_typeref(p, e)
        else
            leaf = alias_leaf_typeref(p, leaf_kind, e.type_name, e.type_name_len)
        return alias_ptr_chain(p, depth, leaf, e.inner_ref)
    var leaf: *TypeRef = null
    if e.pointee_type == TypeKind.Array
        leaf = alias_array_typeref(p, e)
    else
        leaf = alias_leaf_typeref(p, e.pointee_type, e.type_name, e.type_name_len)
    alias_ptr_chain(p, 1, leaf, e.inner_ref)

# Called from type_named.  Returns the alias's target as a `*TypeRef`, or null
# when `name` is not an alias (no alias can be TypeKind.Void: type_spec never
# yields it).  #4035: the alias table keeps the flat snapshot (it outlives the
# Parser arena); this rebuilds the chain from it.
pub fn type_alias_resolve(p: *Parser, name_sv: StrView) -> *TypeRef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *AliasEntry = type_alias_find(p.ctx, StrView { ptr: (name), len: (len) as i64 })
    if e == null
        return null
    var t: *TypeRef = null
    match e.kind
        TypeKind.Struct =>
            t = alias_leaf_typeref(p, TypeKind.Struct, e.type_name, e.type_name_len)
        TypeKind.Ptr | TypeKind.PtrPtr =>
            t = alias_pointer_typeref(p, e)
        TypeKind.Array =>
            t = alias_array_typeref(p, e)
        TypeKind.Ref | TypeKind.MutRef =>
            t = typeref_new(p, e.kind)
            t.pointee = alias_referent_typeref(p, e)
            t.ref_inner = e.ref_inner_type
            t.inner_ref = e.inner_ref
        _ =>
            t = typeref_new(p, e.kind)
    if e.fn_sig != null
        t.fn_sig = e.fn_sig
    t

# `sizeof(Alias)` (AGAST #2124): the alias's target as `count` values of leaf
# kind `*leaf` (struct `*leaf_name` for TypeKind.Struct).  0 when `name` is no
# alias.  The emitter sizes the leaf; an alias of a pointer is one pointer.
# #4035: reads the alias table's flat snapshot, which outlives the Parser.
pub fn type_alias_sizeof_shape(ctx: *ParseCtx, name_sv: StrView, count: *i64, leaf: *TypeKind, leaf_name: **u8, leaf_len: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *AliasEntry = type_alias_find(ctx, StrView { ptr: (name), len: (len) as i64 })
    if e == null
        return 0
    *count = 1
    *leaf = e.kind
    *leaf_name = e.type_name
    *leaf_len = e.type_name_len
    if e.kind == TypeKind.Array
        let sh: *ArrayShape = e.array_shape
        if sh != null
            var n: i64 = 1
            var d: i32 = 0
            while d < sh.rank
                n = n * (sh.dims[d] as i64)
                d = d + 1
            *count = n
            *leaf = sh.leaf_type
            *leaf_name = sh.leaf_name
            *leaf_len = sh.leaf_name_len
        else
            *count = e.array_size as i64
            *leaf = e.array_elem_type
            *leaf_name = e.array_elem_type_name
            *leaf_len = e.array_elem_type_name_len
    return 1

# item dispatcher for type_alias_def: like item_dispatch_enum, the alias
# has no AST node (it lives in the alias table), so only reset skip_item.
pub fn item_dispatch_alias(p: *Parser) -> i32
    p.skip_item = 0
    p.ctx.attr_bits = 0
    p.ctx.attr_target_os = 0
    p.ctx.attr_target_arch = 0
    return 1

# Handle immutable reference type @T
# References are semantically pointers for now - the referent rides in pointee.
pub fn type_ref(p: *Parser, inner: *TypeRef) -> *TypeRef
    let target: *TypeRef = ref_as_pointer(p, inner)   # AGAST #2399
    let t: *TypeRef = typeref_new(p, TypeKind.Ref)
    t.pointee = target
    t.ref_inner = tr_kind(target)
    if is_indirection_kind(tr_kind(target)) == 0
        t.inner_ref = INNER_REF_SHARED
    else
        t.inner_ref = tr_inner_ref(target)
    t

# Handle mutable reference type @&T
pub fn type_mut_ref(p: *Parser, inner: *TypeRef) -> *TypeRef
    let target: *TypeRef = ref_as_pointer(p, inner)   # AGAST #2399
    let t: *TypeRef = typeref_new(p, TypeKind.MutRef)
    t.pointee = target
    t.ref_inner = tr_kind(target)
    if is_indirection_kind(tr_kind(target)) == 0
        t.inner_ref = INNER_REF_MUT
    else
        t.inner_ref = tr_inner_ref(target)
    t

# AGAST #2399: `last_inner_ref`, for a just-parsed type that has a level.
pub fn inner_ref_of(p: *Parser, tr: *TypeRef) -> i32
    tr_inner_ref(tr)

# AGAST #2399: a reference is a pointer, so one to a reference to a struct is
# held as one to a pointer: `@@S` as `@*S`, `*@&S` as `**S`, `@&@*S` as `@&**S`.
# `.` then goes through each level as it does for those.  `inner` is what the
# `@` / `*` wraps; the `*TypeRef` returned is what it wraps now.
fn ref_as_pointer(p: *Parser, inner: *TypeRef) -> *TypeRef
    let k: TypeKind = tr_kind(inner)
    if k != TypeKind.Ref and k != TypeKind.MutRef
        return inner
    let x: TypeKind = tr_ref_inner(inner)
    var named: i32 = 0
    if x == TypeKind.Struct
        named = 1
    else if x == TypeKind.Ptr and tr_pointee_kind(inner.pointee) == TypeKind.Struct
        named = 1
    else if x == TypeKind.PtrPtr and ptr_ptr_slot_inner(tr_ptr_ptr_inner_pointee(inner.pointee)) == TypeKind.Struct
        named = 1
    if named == 0
        return inner
    # The type wrapped is the referent itself, so a `*` on it keeps its name.
    let t: *TypeRef = typeref_new(p, TypeKind.Ptr)
    if tr_kind(inner.pointee) == TypeKind.Ptr or tr_kind(inner.pointee) == TypeKind.PtrPtr
        t.kind = TypeKind.PtrPtr
    t.pointee = inner.pointee
    t.inner_ref = tr_inner_ref(inner)
    t

# Saved identity of ONE generic type argument, captured right after it
# parses.  Without it, mangling `Result<Vec<u8>, StrView>` would read StrView
# as the first argument's name (parsing a later arg clobbers last_type_name).
#
# AGAST #1300: this used to be a single global save slot, which a generic in
# the TAIL overwrote before the outer type was mangled —
# `HashMap<String, Vec<Connection>>` mangled as `HashMap$Connection`.  Each
# capture now gets its own arena record, so nesting is reentrant.
#
# AGAST #1574: the records form the whole argument list (`next`), and EVERY
# argument drives mangling: `Pair<i64, i32>` is `Pair$i64$i32`, not
# `Pair$i64` (which left the second parameter unsubstituted and collided
# with `Pair<i64, i64>`).  The record, GenericArg, is in ast.ritz.
#
# Called from grammar rules first_generic_type_arg / first_generic_type_arg_shr
# right after the argument's type_spec parses, while last_type_name is fresh.
pub fn capture_first_generic_arg(p: *Parser, tr: *TypeRef) -> *GenericArg
    let ga: *GenericArg = parser_alloc(p, sizeof(GenericArg)) as *GenericArg
    let ty: TypeKind = tr_kind(tr)
    let facts: *TypeFacts = type_facts(p, tr)
    ga.ty = ty
    match ty
        TypeKind.Struct =>
            ga.name = facts.type_name
            ga.name_len = facts.type_name_len
        TypeKind.Ptr | TypeKind.PtrPtr =>
            # AGAST #1519: a pointer's pointee is only in parser state now, so
            # spell it here ("ptr_u8", "ptr_ptr_Foo"); generic_arg_spelling
            # returns the saved name.
            var n: i32 = 0
            ga.name = spell_ptr_generic_arg(p, tr, @n)
            ga.name_len = n
        TypeKind.Array =>
            # AGAST #2832: `[2]i8` is "arr2_i8".  It spelled as nothing, so
            # `Box<[2]i8>` and `Box<[4]i64>` were one `%Box$`.
            var n: i32 = 0
            ga.name = spell_last_array(p, tr, @n)
            ga.name_len = n
        TypeKind.Ref | TypeKind.MutRef =>
            # AGAST #2384: `@C` is "ref_C", `@&C` "refmut_C".  Both spelled as
            # nothing, so `Option<@&A>` and `Option<@&B>` were one `%Option$`
            # with no payload to measure or judge.
            var n: i32 = 0
            ga.name = spell_ref_generic_arg(p, tr, @n)
            ga.name_len = n
        TypeKind.Void =>
            # AGAST #2272: `()`.  Only the unit type parses to TypeKind.Void here.
            ga.name = c"unit"
            ga.name_len = 4
        _ =>
            # A primitive, spelled by generic_arg_spelling from `ty`.  AGAST
            # #3935 (LARB R53): `usize` parses to TypeKind.U64 and `isize` to TypeKind.I64
            # (#3464), so `V<usize>` is `V$u64`, one instance with `V<u64>`, as
            # ritz0 (which resolves the names in its parser) spells it.  It kept
            # its source spelling, `V$usize`, a second type `V<u64>` refused.
            ga.name = null
            ga.name_len = 0
    ga.next = null
    ga.written = null
    ga.written_len = 0
    ga.at = diag_span(0, 0)
    let t: *Token = tn_last_written(p, 1)
    if t != null
        ga.written = t.start
        ga.written_len = t.len
    return ga

# The grammar's type_arg_start: where the next type argument starts, as a
# token index (zero-width; AGAST #3469).
pub fn generic_arg_mark(p: *Parser) -> i32
    p.pos

# capture_first_generic_arg for an argument that started at token `start`.
pub fn capture_generic_arg_at(p: *Parser, tr: *TypeRef, start: i32) -> *GenericArg
    let ga: *GenericArg = capture_first_generic_arg(p, tr)
    if start >= 0 and start < p.token_count
        let t: *Token = p.tokens + start
        ga.at = diag_span(t.line, t.col)
    ga

# Spelling of a primitive type argument, as ritz0 mangles it (its type
# name).  Returns its length (0 for a non-primitive) and the bytes in *out.
# AGAST #1922: only u8/i8/i32/i64/u64 were spelled, so `Option<u32>` mangled
# as `Option$` and tagged_enum_layout could not measure it.
pub fn primitive_arg_spelling(ty: TypeKind, out: **u8) -> i32
    match ty
        TypeKind.U8 =>
            *out = c"u8"
            return 2
        TypeKind.I8 =>
            *out = c"i8"
            return 2
        TypeKind.U16 =>
            *out = c"u16"
            return 3
        TypeKind.I16 =>
            *out = c"i16"
            return 3
        TypeKind.U32 =>
            *out = c"u32"
            return 3
        TypeKind.I32 =>
            *out = c"i32"
            return 3
        TypeKind.U64 =>
            *out = c"u64"
            return 3
        TypeKind.I64 =>
            *out = c"i64"
            return 3
        TypeKind.F32 =>
            *out = c"f32"
            return 3
        TypeKind.F64 =>
            *out = c"f64"
            return 3
        TypeKind.Bool =>
            *out = c"bool"
            return 4
        _ => pass
    *out = null
    return 0

# Mangle the pointer type that just parsed as ritz0 does (monomorph.py
# mangle_type_name): "ptr_" per level, then the pointee's spelling — a
# primitive's name or the struct/generic name in last_type_name.  `*u8` is
# "ptr_u8", `**Foo` "ptr_ptr_Foo", `***u8` "ptr_ptr_ptr_u8" (the depth past
# two levels is packed into the inner-pointee slot, AGAST #3686).
fn spell_ptr_generic_arg(p: *Parser, tr: *TypeRef, out_len: *i32) -> *u8
    let ty: TypeKind = tr_kind(tr)
    let facts: *TypeFacts = type_facts(p, tr)
    if facts.inner_pointee_type == (TypeKind.Array as i32)
        # AGAST #2832: `*[2]i8` is "ptr_arr2_i8".
        var n: i32 = 0
        let arr: *u8 = spell_last_array(p, tr.pointee, @n)
        return spell_ptr_parts(p, ty, facts.pointee_type, (TypeKind.Struct as i32), StrView { ptr: (arr), len: (n) as i64 }, out_len)
    # AGAST #3686: past two levels the pointee is itself a `**`; pass the
    # depth-packed slot, as a `***u8` local records it.
    if ty == TypeKind.PtrPtr and facts.pointee_type == TypeKind.PtrPtr
        return spell_ptr_parts(p, ty, TypeKind.Ptr, tr_ptr_ptr_inner_pointee(tr), StrView { ptr: (facts.type_name), len: (facts.type_name_len) as i64 }, out_len)
    return spell_ptr_parts(p, ty, facts.pointee_type, facts.inner_pointee_type, StrView { ptr: (facts.type_name), len: (facts.type_name_len) as i64 }, out_len)

# AGAST #2384: the reference type that just parsed, spelled as ritz0's
# mangle_type_name spells a RefType: "ref_" (`@T`) or "refmut_" (`@&T`), then
# the referent's spelling — a primitive's name, a struct's, a pointer's
# ("ptr_C") or an array's ("arr2_i8").  type_ref leaves the referent's parse
# state in p, so it reads as if the referent alone had just parsed.  A
# referent that has no spelling (a reference to a reference, whose state the
# outer one overwrote; a fn type) spells as "" (out_len 0), as before.
fn spell_ref_generic_arg(p: *Parser, tr: *TypeRef, out_len: *i32) -> *u8
    let ty: TypeKind = tr_kind(tr)
    let facts: *TypeFacts = type_facts(p, tr)
    let inner: TypeKind = facts.ref_inner_type
    var base: *u8 = null
    var base_len: i32 = 0
    match inner
        TypeKind.Struct =>
            base = facts.type_name
            base_len = facts.type_name_len
        TypeKind.Ptr | TypeKind.PtrPtr =>
            base = spell_ptr_generic_arg(p, tr.pointee, @base_len)
        TypeKind.Array =>
            base = spell_last_array(p, tr.pointee, @base_len)
        _ =>
            base_len = primitive_arg_spelling(inner, @base)
    if base == null or base_len <= 0
        *out_len = 0
        return null
    var prefix: *u8 = c"ref_"
    var prefix_len: i32 = 4
    if ty == TypeKind.MutRef
        prefix = c"refmut_"
        prefix_len = 7
    let name: *u8 = parser_alloc(p, (prefix_len + base_len + 1) as i64)
    for i in 0..prefix_len
        *(name + i) = *(prefix + i)
    for i in 0..base_len
        *(name + prefix_len + i) = *(base + i)
    *(name + prefix_len + base_len) = 0
    *out_len = prefix_len + base_len
    return name

# Length of the pointer-like prefix a mangled argument starts with: 4 for
# "ptr_" and "ref_" (`@T`), 7 for "refmut_" (`@&T`, AGAST #2384); 0 if none,
# or if nothing follows it.
pub fn mangled_ref_prefix(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len > 4 and (memcmp(name, c"ptr_", 4) == 0 or memcmp(name, c"ref_", 4) == 0)
        return 4
    if len > 7 and memcmp(name, c"refmut_", 7) == 0
        return 7
    0

# AGAST #2832: the `[N]E` that just parsed, spelled as ritz0's
# mangle_type_name means it: "arr" N "_" E, E being a primitive's name, a
# struct's, or "ptr_" + either for a one-level pointer element.  `[2]i8` is
# "arr2_i8", `[3]Foo` "arr3_Foo", `[4]*u8` "arr4_ptr_u8".  Any other element
# spells as "" (out_len 0), as an unspellable argument always has.  Reads
# the last_array_* side channel, which type_array wrote for this array.
#
# AGAST #3634: a `[N][M]..E` is every dimension's prefix around its leaf, as
# ritz0 nests it: `[2][3]u8` is "arr2_arr3_u8".  monomorph's array_arg_decode
# reads the shape back.
fn spell_last_array(p: *Parser, tr: *TypeRef, out_len: *i32) -> *u8
    let facts: *TypeFacts = type_facts(p, tr)
    var elem: *u8 = null
    var elem_len: i32 = 0
    var ptr: i32 = 0
    let sh: *ArrayShape = facts.array_shape
    var et: TypeKind = facts.array_elem_type
    var ep: TypeKind = facts.array_elem_pointee
    var en: *u8 = facts.array_elem_type_name
    var en_len: i32 = facts.array_elem_type_name_len
    var dims: i32 = 1
    if sh != null
        et = sh.leaf_type
        ep = sh.leaf_pointee
        en = sh.leaf_name
        en_len = sh.leaf_name_len
        dims = sh.rank
    match et
        TypeKind.Struct =>
            elem = en
            elem_len = en_len
        TypeKind.Ptr =>
            ptr = 1
            if ep == TypeKind.Struct
                elem = en
                elem_len = en_len
            else
                elem_len = primitive_arg_spelling(ep, @elem)
        _ =>
            elem_len = primitive_arg_spelling(et, @elem)
    if elem_len <= 0 or elem == null
        *out_len = 0
        return null
    # ("arr" + up to 10 digits + "_") per dimension + "ptr_" + elem
    let name: *u8 = parser_alloc(p, (elem_len + 14 * dims + 5) as i64)
    var pos: i32 = 0
    for d in 0..dims
        *(name + pos) = 97        # 'a'
        *(name + pos + 1) = 114   # 'r'
        *(name + pos + 2) = 114   # 'r'
        pos = pos + 3
        if sh != null
            pos = pos + write_dec_i32(name + pos, sh.dims[d])
        else
            pos = pos + write_dec_i32(name + pos, facts.array_size)
        *(name + pos) = 95  # '_'
        pos = pos + 1
    if ptr == 1
        *(name + pos) = 112      # 'p'
        *(name + pos + 1) = 116  # 't'
        *(name + pos + 2) = 114  # 'r'
        *(name + pos + 3) = 95   # '_'
        pos = pos + 4
    for i in 0..elem_len
        *(name + pos) = *(elem + i)
        pos = pos + 1
    *(name + pos) = 0
    *out_len = pos
    return name

# The decimal digits of n >= 0 at buf; returns how many.
pub fn write_dec_i32(buf: *u8, n: i32) -> i32
    var digits: [10]u8
    var count: i32 = 0
    var v: i32 = n
    if v <= 0
        *buf = 48  # '0'
        return 1
    while v > 0
        digits[count] = (48 + v % 10) as u8
        v = v / 10
        count = count + 1
    for i in 0..count
        *(buf + i) = digits[count - 1 - i]
    return count

# spell_ptr_generic_arg over explicit parts, so an alias table entry (which
# saved the same fields) spells without replaying itself into p.
fn spell_ptr_parts(p: *Parser, ty: TypeKind, pointee: TypeKind, inner: i32, type_name_sv: StrView, out_len: *i32) -> *u8
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var depth: i32 = 1
    var leaf: TypeKind = ptr_slot_flat(inner)
    if ty == TypeKind.PtrPtr
        if pointee != TypeKind.Ptr
            *out_len = 0
            return null
        # AGAST #3686: `inner` is depth-packed past two levels (`***u8` is
        # u8 + PTR_DEPTH_UNIT).  Read raw, it named no primitive, so the
        # argument spelled "" and `first<***u8>` became `first$`, a
        # procedure.
        depth = ptr_ptr_slot_levels(inner)
        leaf = ptr_ptr_slot_inner(inner)
    var base: *u8 = null
    var base_len: i32 = 0
    if leaf == TypeKind.Struct
        base = type_name
        base_len = type_name_len
    else
        base_len = primitive_arg_spelling(leaf, @base)
    if base_len <= 0
        *out_len = 0
        return null
    let total: i32 = depth * 4 + base_len
    let name: *u8 = parser_alloc(p, (total + 1) as i64)
    var pos: i32 = 0
    for d in 0..depth
        *(name + pos) = 112      # 'p'
        *(name + pos + 1) = 116  # 't'
        *(name + pos + 2) = 114  # 'r'
        *(name + pos + 3) = 95   # '_'
        pos = pos + 4
    for i in 0..base_len
        *(name + pos) = *(base + i)
        pos = pos + 1
    *(name + pos) = 0
    *out_len = pos
    return name

# AGAST #2037: build a single-token generic call's suffix — "$" + prefix +
# the type argument's mangled spelling.  The token rules (`f<T>`, `f<*T>`,
# `f<@T>`) never pass the token through type_named, so an alias (`type Id =
# u32`) used to mangle by its own name ("$Id"), instantiating `Vec$Id` where
# a `Vec<Id>` field had resolved to `Vec$u32`.  An alias spells as its
# target, exactly as generic_arg_spelling would after type_named replayed it
# (the table entry holds the final target, so alias-of-alias is settled).
# Anything else spells as the token text.  Reads the table without touching
# parser state.
fn generic_tok_suffix(p: *Parser, prefix_sv: StrView, tok: Token, out_len: *i32) -> *u8
    var prefix: *u8 = prefix_sv.ptr
    var prefix_len: i32 = prefix_sv.len as i32
    var spell: *u8 = tok.start
    var spell_len: i32 = tok.len
    # AGAST #3935 (LARB R53): `usize` / `isize` spell as `u64` / `i64`, as a
    # type_spec argument does (capture_first_generic_arg): `vec_new<usize>`
    # is `vec_new$u64`, returning the `Vec$u64` a `Vec<usize>` local is.
    if is_word_type_name(StrView { ptr: (tok.start), len: (tok.len) as i64 }) == 1
        spell_len = primitive_arg_spelling(word_type(tok.start), @spell)
    else if p.ctx.alias_count > 0
        let e: *AliasEntry = type_alias_find(p.ctx, StrView { ptr: (tok.start), len: (tok.len) as i64 })
        if e != null
            var n: i32 = 0
            match e.kind
                TypeKind.Struct =>
                    spell = e.type_name
                    n = e.type_name_len
                TypeKind.Ptr | TypeKind.PtrPtr =>
                    spell = spell_ptr_parts(p, e.kind, e.pointee_type, e.inner_pointee_type, StrView { ptr: (e.type_name), len: (e.type_name_len) as i64 }, @n)
                _ =>
                    n = primitive_arg_spelling(e.kind, @spell)
            # A target with no spelling (array, fn type, ...) keeps the alias
            # name: no worse than before, and the mismatch stays visible.
            if n > 0
                spell_len = n
            else
                spell = tok.start
    let total: i32 = 1 + prefix_len + spell_len
    let buf: *u8 = parser_alloc(p, (total + 1) as i64)
    *buf = 36  # '$'
    for i in 0..prefix_len
        *(buf + 1 + i) = *(prefix + i)
    for i in 0..spell_len
        *(buf + 1 + prefix_len + i) = *(spell + i)
    *(buf + total) = 0
    *out_len = total
    return buf

# Prepend one captured argument to the (possibly null) list of those after it.
pub fn link_generic_arg(first: *GenericArg, rest: *GenericArg) -> *GenericArg
    first.next = rest
    return first

# Mangled spelling of one argument: the primitive's name, or the captured
# struct/generic/pointer name.  The one speller for generic type annotations,
# struct literals and generic-call suffixes.  Returns its length and stores
# the bytes' address in *out.
pub fn generic_arg_spelling(ga: *GenericArg, out: **u8) -> i32
    if ga.ty == TypeKind.Struct or ga.ty == TypeKind.Ptr or ga.ty == TypeKind.PtrPtr or ga.ty == TypeKind.Array or ga.ty == TypeKind.Void or ga.ty == TypeKind.Ref or ga.ty == TypeKind.MutRef
        *out = ga.name
        return ga.name_len
    # AGAST #2198: `usize` / `isize`, as written (`Vec$usize`).  AGAST #3464:
    # `usize` is TypeKind.U64 now; its spelling is unchanged.
    if (ty_int_bits(ga.ty) == 64) and ga.name != null and ga.name_len > 0
        *out = ga.name
        return ga.name_len
    return primitive_arg_spelling(ga.ty, out)

# Mangle `base<a1, a2, ...>` as "base$a1$a2..." (AGAST #1574), from the
# captured argument list.  Returns an arena-allocated, NUL-terminated name
# and its length in *out_len.
fn mangle_generic_args(p: *Parser, base_name_sv: StrView, ga: *GenericArg, out_len: *i32) -> *u8
    var base_name: *u8 = base_name_sv.ptr
    var base_len: i32 = base_name_sv.len as i32
    var total: i32 = base_len
    var spell: *u8 = null
    var cur: *GenericArg = ga
    while cur != null
        total = total + 1 + generic_arg_spelling(cur, @spell)
        cur = cur.next
    let mangled: *u8 = parser_alloc(p, (total + 1) as i64)
    var pos: i32 = 0
    for i in 0..base_len
        *(mangled + pos) = *(base_name + i)
        pos = pos + 1
    cur = ga
    while cur != null
        *(mangled + pos) = 36  # '$'
        pos = pos + 1
        let n: i32 = generic_arg_spelling(cur, @spell)
        for j in 0..n
            *(mangled + pos) = *(spell + j)
            pos = pos + 1
        cur = cur.next
    *(mangled + pos) = 0
    *out_len = pos
    return mangled

# Mangle a generic type like Result<Vec<u8>, StrView> → Result$Vec$u8$StrView
# from the arguments captured by capture_first_generic_arg.  Returns
# TypeKind.Struct with the name in the last_type_name side channel, like type_generic.
# AGAST #4654: a generic type's base name (`Zork` of `Zork<u8>`, `Vec` of
# `Vec<u8>` with no import) is a token no type_named call saw, and the slot
# keeps only the mangled `Zork$u8`, so nothing judged it.  Locate it at its
# token and note it for type_name_check.ritz, which knows a generic struct
# or enum template by its base name.  `[T]`'s builtin "Span" is no token.
fn tn_note_base(p: *Parser, name_sv: StrView)
    if p.skip_item != 0 or name_sv.ptr == null
        return
    var i: i32 = p.pos - 1
    if i >= p.token_count
        i = p.token_count - 1
    let stop: i32 = i - 512   # the base precedes only its own `<...>`
    while i >= 0 and i > stop
        let t: *Token = p.tokens + i
        if t.start == name_sv.ptr
            if t.kind == TOK_IDENT
                note_type_name_written(p, t.start, t.line, t.col)
                tn_note(p, name_sv)
            return
        i = i - 1

pub fn type_generic_with_saved(p: *Parser, base_name_sv: StrView, ga: *GenericArg) -> *TypeRef
    var base_name: *u8 = base_name_sv.ptr
    var base_len: i32 = base_name_sv.len as i32
    tn_note_base(p, StrView { ptr: (base_name), len: (base_len) as i64 })   # AGAST #4654
    var cur: *GenericArg = ga
    while cur != null
        tn_note(p, StrView { ptr: (cur.written), len: (cur.written_len) as i64 })   # AGAST #4021
        cur = cur.next
    var len: i32 = 0
    let mangled: *u8 = mangle_generic_args(p, StrView { ptr: (base_name), len: (base_len) as i64 }, ga, @len)
    if p.skip_item == 0
        generic_use_note_mangled(p.ctx, StrView { ptr: (mangled), len: (len) as i64 }, ga, diag_span(0, 0), parse_file_copy_shared(p))
    let t: *TypeRef = typeref_new(p, TypeKind.Struct)
    t.name = mangled
    t.name_len = len
    t

# =============================================================================
# Where each generic instance is first written (AGAST #3469)
# =============================================================================
#
# A failed trait bound is an error at the type argument as first written
# (`Holder<Nope>`, `total<Nope>(..)`), or at the call when its arguments were
# inferred (LANGUAGE_SPEC §11.5), as ritz0's monomorph notes an instance's
# first use.  ritz1's instance trackers keep only mangled names, so the parser
# notes each generic type and explicit call here, and infer_generic_calls each
# inferred call, after them.  trait_bound.ritz asks only once a bound has
# failed, so a list is enough; it is newest first, so the first use is the
# last match.
# struct GenericUse: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.generic_uses

pub fn generic_use_note(ctx: *ParseCtx, name_sv: StrView, suffix_sv: StrView, args: *GenericArg, at: SrcSpan, file: *u8)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if name == null or name_len <= 0 or suffix == null or suffix_len <= 0
        return
    let u: *GenericUse = malloc(sizeof(GenericUse)) as *GenericUse
    u.name = name
    u.name_len = name_len
    u.suffix = suffix
    u.suffix_len = suffix_len
    u.args = args
    u.at = at
    u.file = file
    u.next = ctx.generic_uses
    ctx.generic_uses = u

# A generic type's mangled name `Holder$Nope` is the instance `Holder` with
# suffix `$Nope`, as monomorph tracks it.
fn generic_use_note_mangled(ctx: *ParseCtx, mangled_sv: StrView, args: *GenericArg, at: SrcSpan, file: *u8)
    var mangled: *u8 = mangled_sv.ptr
    var len: i32 = mangled_sv.len as i32
    var k: i32 = 0
    while k < len and *(mangled + k) != '$'   # '$'
        k = k + 1
    if k > 0 and k < len
        generic_use_note(ctx, StrView { ptr: (mangled), len: (k) as i64 }, StrView { ptr: (mangled + k), len: (len - k) as i64 }, args, at, file)

# Every noted use, newest first (trait_bound.ritz's own searches).
pub fn generic_use_list(ctx: *ParseCtx) -> *GenericUse
    ctx.generic_uses

# The first noted use of the instance (name, suffix), or null.
pub fn generic_use_first(ctx: *ParseCtx, name_sv: StrView, suffix_sv: StrView) -> *GenericUse
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var found: *GenericUse = null
    var u: *GenericUse = ctx.generic_uses
    while u != null
        if u.name_len == name_len and u.suffix_len == suffix_len
            if memcmp(u.name, name, name_len as i64) == 0 and memcmp(u.suffix, suffix, suffix_len as i64) == 0
                found = u
        u = u.next
    found

# The slice type `[T]` (AGAST #1614): sugar for `Span<T>` (LANGUAGE_SPEC §3.4),
# as ritz0's make_slice_type desugars it.  `elem` is T, captured by
# first_generic_type_arg as for `Span<T>`, so `[u8]` is TypeKind.Struct "Span$u8":
# the same type, so either one fits wherever the other does.
pub fn type_slice(p: *Parser, elem: *GenericArg) -> *TypeRef
    return type_generic_with_saved(p, StrView { ptr: (c"Span"), len: (4) as i64 }, elem)

# =============================================================================
# Tuple types and tuple expressions (AGAST #2956)
# =============================================================================
#
# A tuple type `(A, B, ...)` is a struct ritz1 synthesizes the first time a
# spelling is seen, named as ritz0's mangle_type_name spells a TupleType:
# "tuple_" + the elements' generic-argument spellings joined by "_"
# (`(u32, u32)` is "tuple_u32_u32", `((i32, i64), u8)` is
# "tuple_tuple_i32_i64_u8").  Its fields are named "0", "1", ..., so `t.0`
# reads one, and it lays out as ritz0's literal `{A, B}`.  Being a plain
# struct, it travels everywhere one does: by value, as a generic argument
# (`Vec<(u32, u32)>` is `Vec$tuple_u32_u32`, as in ritz0), destructured by
# `let (x, y) = ..`.  One definition per spelling per compile: the registry
# is process-wide, and the module that first names a spelling owns its
# StructDef (imports merge into the main module).
#
# A tuple expression `(a, b)` parses as a struct literal with no type name
# (ident_len 0).  tuple_resolve_module, at module end, names it from its
# slot: the enclosing fn's return type (tail or `return`), an annotated
# `let` / `var`, an if/match arm in either, or an enclosing tuple literal's
# element.  `let (x, y) = (a, b)` (or an if / match of such) needs no type:
# tuple_split_decl binds each name to its element (AGAST #2974).  One left
# nameless is a located error.

# struct TupleElem: ast.ritz, beside ParseCtx (AGAST #4623).

# struct TupleReg: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.tuple_regs

# 1 once the current module's parse built a tuple literal (tuple_lit).
# State: ParseCtx.tuple_lits

# Called from grammar rule tuple_type_elem with the element's parsed
# *TypeRef (AGAST #4035: the type is the chain, not parser side state).
pub fn tuple_elem_new(p: *Parser, tr: *TypeRef) -> *TupleElem
    let te: *TupleElem = parser_alloc(p, sizeof(TupleElem)) as *TupleElem
    te.field = field_new(p, StrView { ptr: (null), len: (0) as i64 }, tr, parse_pos_line(p), parse_pos_col(p))
    te.ga = capture_first_generic_arg(p, tr)
    te.next = null
    return te

pub fn tuple_elem_link(first: *TupleElem, rest: *TupleElem) -> *TupleElem
    first.next = rest
    return first

# Forget every registered tuple (AGAST #3030).  The driver's alias re-parse
# (AGAST #1475) builds every module afresh; a registry kept from the first
# pass would make type_tuple skip declaring a spelling in the new module, so
# `type Mixed = (i32, i32)` named a struct no module declared.
pub fn tuple_regs_reset(ctx: *ParseCtx)
    ctx.tuple_regs = null

# The decimal spelling of element index i ("0", "1", ...), arena-allocated.
# sign + 10 digits of an i32 + NUL (AGAST #1820: no magic alloc sizes).
const I32_DEC_BUF: i64 = 12

fn tuple_index_name(p: *Parser, i: i32, out_len: *i32) -> *u8
    let buf: *u8 = parser_alloc(p, I32_DEC_BUF)
    let n: i32 = write_dec_i32(buf, i)
    *(buf + n) = 0
    *out_len = n
    return buf

# The registered tuple spelled (name, len), or null.
pub fn tuple_reg_lookup(ctx: *ParseCtx, name_sv: StrView) -> *TupleReg
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var r: *TupleReg = ctx.tuple_regs
    while r != null
        if r.def.name_len == len and memcmp(r.def.name, name, len as i64) == 0
            return r
        r = r.next
    return null

fn tuple_reg_find(ctx: *ParseCtx, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let r: *TupleReg = tuple_reg_lookup(ctx, StrView { ptr: (name), len: (len) as i64 })
    if r == null
        return null
    return r.def

# AGAST #2975: register a tuple monomorphization made (`tuple_i32_i32` from
# `tuple_T_T`), not yet in any module (tuple_reg_place puts it in one).
pub fn tuple_reg_add(ctx: *ParseCtx, def: *StructDef, elems: *TupleElem) -> *TupleReg
    let r: *TupleReg = calloc(1, sizeof(TupleReg)) as *TupleReg
    r.def = def
    r.elems = elems
    r.next = ctx.tuple_regs
    ctx.tuple_regs = r
    return r

# Add r's struct to m, once, when it is concrete: one still over a
# generic parameter (`tuple_i32_V` between the passes of <K, V>) is never
# emitted.
pub fn tuple_reg_place(r: *TupleReg, m: *Module)
    if r.placed == 1 or m == null or r.def.type_params != null
        return
    r.placed = 1
    module_add_struct(m, r.def)

# The tuple type `(A, B, ...)`: TypeKind.Struct named "tuple_A_B..." in
# the last_type_name side channel, its StructDef added to p.module the first time.
pub fn type_tuple(p: *Parser, elems: *TupleElem) -> *TypeRef
    var total: i32 = 5  # "tuple"
    var spell: *u8 = null
    var cur: *TupleElem = elems
    while cur != null
        total = total + 1 + generic_arg_spelling(cur.ga, @spell)
        cur = cur.next
    let name: *u8 = parser_alloc(p, (total + 1) as i64)
    memcpy(name, c"tuple", 5)
    var pos: i32 = 5
    cur = elems
    while cur != null
        *(name + pos) = 95  # '_'
        pos = pos + 1
        let n: i32 = generic_arg_spelling(cur.ga, @spell)
        for j in 0..n
            *(name + pos) = *(spell + j)
            pos = pos + 1
        cur = cur.next
    *(name + pos) = 0
    if tuple_reg_find(p.ctx, StrView { ptr: (name), len: (pos) as i64 }) == null
        var fields: *StructField = null
        var last: *StructField = null
        var i: i32 = 0
        cur = elems
        while cur != null
            let f: *StructField = cur.field
            var nlen: i32 = 0
            f.name = tuple_index_name(p, i, @nlen)
            f.name_len = nlen
            f.next = null
            if last == null
                fields = f
            else
                last.next = f
            last = f
            i = i + 1
            cur = cur.next
        let st: *StructDef = struct_def_new(p, StrView { ptr: (name), len: (pos) as i64 }, fields, 0, 0)
        module_add_struct(p.module, st)
        let r: *TupleReg = parser_alloc(p, sizeof(TupleReg)) as *TupleReg
        r.def = st
        r.fresh = 1
        r.elems = elems
        r.placed = 1
        r.next = p.ctx.tuple_regs
        p.ctx.tuple_regs = r
    let t: *TypeRef = typeref_new(p, TypeKind.Struct)
    t.name = name
    t.name_len = pos
    t

# The tuple expression `(first, rest...)`: a struct literal whose fields are
# "0", "1", ... and whose type name tuple_resolve_module fills in.
pub fn tuple_lit(p: *Parser, first: *Expr, rest: *Expr, line: i32, col: i32) -> *Expr
    first.next = rest
    var inits: *FieldInit = null
    var last: *FieldInit = null
    var i: i32 = 0
    var cur: *Expr = first
    while cur != null
        let nxt: *Expr = cur.next
        var nlen: i32 = 0
        let nm: *u8 = tuple_index_name(p, i, @nlen)
        cur.next = null
        let fi: *FieldInit = field_init_new(p, StrView { ptr: (nm), len: (nlen) as i64 }, cur)
        if last == null
            inits = fi
        else
            last.next = fi
        last = fi
        i = i + 1
        cur = nxt
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.StructLit
    e.span.line = line
    e.span.col = col
    e.ident_ptr = c""
    e.ident_len = 0
    e.args = inits as *Expr   # a struct literal's FieldInit list, recast
    e.next = null
    p.ctx.tuple_lits = 1
    return e

# The synthesized tuple struct a slot of struct type `name` names, or null.
fn tuple_slot(ctx: *ParseCtx, ty: TypeKind, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if ty != TypeKind.Struct or name == null
        return null
    return tuple_reg_find(ctx, StrView { ptr: (name), len: (len) as i64 })

# The return-type slot of the fn being walked (null when not a tuple).
# State: ParseCtx.tuple_ret_slot

fn tuple_resolve_arms(ctx: *ParseCtx, arm: *MatchArm, slot: *StructDef)
    while arm != null
        tuple_resolve_stmts(ctx, arm.body_stmts, null)
        tuple_resolve_expr(ctx, arm.body, slot)
        arm = arm.next

# Name the tuple literal `e` (if it is one) from `slot`, and its nested
# literals from slot's element types.  An if/match expression passes its
# slot to each arm's value.
fn tuple_resolve_expr(ctx: *ParseCtx, e: *Expr, slot: *StructDef)
    if e == null
        return
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        tuple_resolve_arms(ctx, e.args as *MatchArm, slot)
        return
    if e.kind != ExprKind.StructLit or e.ident_len != 0 or slot == null
        return
    # Element counts must agree, or the literal stays nameless (an error).
    var n_lit: i32 = 0
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        n_lit = n_lit + 1
        fi = fi.next
    var n_slot: i32 = 0
    var f: *StructField = slot.fields
    while f != null
        n_slot = n_slot + 1
        f = f.next
    if n_lit != n_slot
        return
    e.ident_ptr = slot.name
    e.ident_len = slot.name_len
    fi = e.args as *FieldInit
    f = slot.fields
    while fi != null
        tuple_resolve_expr(ctx, fi.value, tuple_slot(ctx, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }))
        fi = fi.next
        f = f.next

# =============================================================================
# `let (x, y) = ..` of a tuple with no tuple type (AGAST #2974)
# =============================================================================
#
# `let (x, y) = (a, b)`, or an if / match whose arms are such literals
# (`let (x0, x1) = if a <= b (a, b) else (b, a)`, angelo raster/fill.ritz),
# names no tuple type.  None is needed: each name is bound to its element
# directly.  A literal splits into
#
#     let x = a
#     let y = b
#
# and an if / match into the index of the arm it takes, then each element
# chosen by that index:
#
#     let $tk<N> = if a <= b 0 else 1        # the if / match, arms -> 0, 1, ..
#     let x0 = if $tk<N> == 0 a else b
#     let x1 = if $tk<N> == 0 b else a
#
# So the condition / scrutinee runs once, and of the chosen arm's elements
# each runs once, in order, as ritz0 runs them.  A local can't reuse a name
# in its fn, so `y`'s element can't read the `x` just bound.
#
# Split only when every arm is a bare literal of one element per name (AGAST
# #109: any number of names, not only two), and no match
# arm binds a name (its elements might read it, and the element `if`s are
# outside the arm).  Any other destructure (an arm with statements before
# its tuple, a `Some(v) =>` or bare `v =>` arm) stays a StmtKind.TupleDecl: the
# emitter names each arm's tuple as it emits it (tuple_lit_name, #3005).

# State: ParseCtx.tuple_p, .tuple_split_n

# A nameless tuple literal of exactly `n` elements, one per name of the
# destructure (AGAST #109: was two)?
fn tuple_split_pair(e: *Expr, n: i32) -> i32
    if e == null or e.kind != ExprKind.StructLit or e.ident_len != 0
        return 0
    var fi: *FieldInit = e.args as *FieldInit
    var k: i32 = 0
    while fi != null
        k = k + 1
        fi = fi.next
    (k == n) as i32

# Does match arm `arm` bind no name?  A bare `x =>` binds one unless it is a
# unit variant, which the parser can't tell; a qualified `E.V` (no
# pattern_span) never does.
fn tuple_split_arm_binds_none(arm: *MatchArm) -> i32
    let k: i32 = arm.pattern_kind
    if k == PAT_INT_LIT or k == PAT_WILDCARD or k == PAT_BOOL or k == PAT_STR or k == PAT_CHAR
        return 1
    if k == PAT_VARIANT
        return (arm.pattern_inner_kind != PAT_IDENT) as i32
    if k == PAT_IDENT
        return (arm.pattern_span.line == 0) as i32
    0

# The number of tuple literals `e` yields (one per arm, through nested if /
# match arms), or 0 when it is no splittable tree.
fn tuple_split_leaves(e: *Expr, names: i32) -> i32
    if tuple_split_pair(e, names) == 1
        return 1
    if e == null or (e.kind != ExprKind.If and e.kind != ExprKind.Match)
        return 0
    var n: i32 = 0
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        if arm.body_stmts != null or arm.is_pass != 0
            return 0
        if e.kind == ExprKind.Match and tuple_split_arm_binds_none(arm) == 0
            return 0
        let m: i32 = tuple_split_leaves(arm.body, names)
        if m == 0
            return 0
        n = n + m
        arm = arm.next
    n

# Replace each tuple literal of tree `e` by its index (0, 1, .. in arm
# order), recording the literal at leaves[index].  Returns the new tree.
fn tuple_split_index(ctx: *ParseCtx, e: *Expr, leaves: **Expr, next_idx: *i32, names: i32) -> *Expr
    if tuple_split_pair(e, names) == 1
        let i: i32 = *next_idx
        *(leaves + i) = e
        *next_idx = i + 1
        # Consumed: its elements moved into the split `let`s.
        e.ident_ptr = c"(split)"
        e.ident_len = 7
        return expr_int(ctx.tuple_p, i as i64, e.span.line, e.span.col)
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        arm.body = tuple_split_index(ctx, arm.body, leaves, next_idx, names)
        arm = arm.next
    e

# Element `j` of tuple literal `lit`.
fn tuple_split_elem(lit: *Expr, j: i32) -> *Expr
    var fi: *FieldInit = lit.args as *FieldInit
    var i: i32 = 0
    while i < j
        fi = fi.next
        i = i + 1
    fi.value

# `if k == 0 L0.j else if k == 1 L1.j .. else Ln-1.j`
fn tuple_split_pick(ctx: *ParseCtx, leaves: **Expr, n: i32, j: i32, k_sv: StrView, line: i32, col: i32) -> *Expr
    var k: *u8 = k_sv.ptr
    var k_len: i32 = k_sv.len as i32
    var acc: *Expr = tuple_split_elem(*(leaves + (n - 1)), j)
    var i: i32 = n - 2
    while i >= 0
        let lhs: *Expr = expr_ident(ctx.tuple_p, StrView { ptr: (k), len: (k_len) as i64 }, line, col)
        let cond: *Expr = expr_binary(ctx.tuple_p, OpKind.Eq, lhs, expr_int(ctx.tuple_p, i as i64, line, col))
        acc = expr_if_inline(ctx.tuple_p, cond, tuple_split_elem(*(leaves + i), j), acc, line, col)
        i = i - 1
    acc

# `let x = ..` for the destructure's name `which` (0, 1, then its tail).
fn tuple_split_let(ctx: *ParseCtx, s: *Stmt, which: i32, init: *Expr) -> *Stmt
    var d: *Stmt = null
    if which == 0
        d = stmt_let_decl(ctx.tuple_p, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, 0, init, s.span.line, s.span.col)
        d.name_span = s.name_span
    else if which == 1
        d = stmt_let_decl(ctx.tuple_p, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }, 0, init, s.span.line, s.span.col)
        d.name_span = s.name2_span
    else
        var t: *TupleName = s.tuple_more
        var i: i32 = 2
        while i < which
            t = t.next
            i = i + 1
        d = stmt_let_decl(ctx.tuple_p, StrView { ptr: (t.name), len: (t.len) as i64 }, 0, init, s.span.line, s.span.col)
        d.name_span = t.span
    d

# "$tk" + up to 10 digits of an i32 counter + NUL (AGAST #1820).
const TUPLE_SPLIT_NAME_BUF: i64 = 16

# Rewrite StmtKind.TupleDecl `s` in place into the `let`s above, when its init
# is a tuple literal or a splittable if / match of them.
fn tuple_split_decl(ctx: *ParseCtx, s: *Stmt)
    let init: *Expr = s.var_init
    let names: i32 = tuple_decl_arity(s)   # AGAST #109
    let n: i32 = tuple_split_leaves(init, names)
    if n == 0
        return
    let rest: *Stmt = s.next
    var first: *Stmt = null
    var last: *Stmt = null
    if tuple_split_pair(init, names) == 1
        init.ident_ptr = c"(split)"
        init.ident_len = 7
        var j: i32 = 0
        while j < names
            let d: *Stmt = tuple_split_let(ctx, s, j, tuple_split_elem(init, j))
            if first == null
                first = d
            else
                last.next = d
            last = d
            j = j + 1
    else
        let leaves: **Expr = parser_alloc(ctx.tuple_p, (n as i64) * 8) as **Expr
        var idx: i32 = 0
        let tree: *Expr = tuple_split_index(ctx, init, leaves, @idx, names)
        # "$tk<N>": no source name can collide with it.
        let k: *u8 = parser_alloc(ctx.tuple_p, TUPLE_SPLIT_NAME_BUF)
        memcpy(k, c"$tk", 3)
        let k_len: i32 = 3 + write_dec_i32(k + 3, ctx.tuple_split_n)
        *(k + k_len) = 0
        ctx.tuple_split_n = ctx.tuple_split_n + 1
        first = stmt_let_decl(ctx.tuple_p, StrView { ptr: (k), len: (k_len) as i64 }, 0, tree, s.span.line, s.span.col)
        last = first
        let line: i32 = s.span.line
        let col: i32 = s.span.col
        var j: i32 = 0
        while j < names
            let d: *Stmt = tuple_split_let(ctx, s, j, tuple_split_pick(ctx, leaves, n, j, StrView { ptr: (k), len: (k_len) as i64 }, line, col))
            last.next = d
            last = d
            j = j + 1
    last.next = rest
    # `s` is referenced by its predecessor: it becomes `first`.
    memcpy(s as *u8, first as *u8, sizeof(Stmt))

# Walk a statement list for tuple-literal slots.  `tail` is the slot of the
# list's last statement when it is the enclosing value (a fn body's tail).
fn tuple_resolve_stmts(ctx: *ParseCtx, first: *Stmt, tail: *StructDef)
    var s: *Stmt = first
    while s != null
        var here: *StructDef = null
        if s.next == null
            here = tail
        let k: StmtKind = s.kind
        match k
            StmtKind.Expr =>
                tuple_resolve_expr(ctx, s.expr, here)
            StmtKind.Return =>
                tuple_resolve_expr(ctx, s.return_value, ctx.tuple_ret_slot)
            StmtKind.VarDecl =>
                tuple_resolve_expr(ctx, s.var_init, tuple_slot(ctx, s.var_type, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }))
            StmtKind.TupleDecl =>
                tuple_split_decl(ctx, s)   # AGAST #2974
            StmtKind.If =>
                tuple_resolve_stmts(ctx, s.if_then, here)
                tuple_resolve_stmts(ctx, s.if_else, here)
            StmtKind.Match =>
                tuple_resolve_arms(ctx, s.if_then as *MatchArm, here)
            StmtKind.While | StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                tuple_resolve_stmts(ctx, s.while_body, null)
            StmtKind.Asm =>
                pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
            StmtKind.For =>
                tuple_resolve_stmts(ctx, s.for_body, null)
            _ => pass
        s = s.next

fn tuple_resolve_fn(ctx: *ParseCtx, f: *FnDef)
    ctx.tuple_ret_slot = tuple_slot(ctx, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    tuple_resolve_stmts(ctx, f.body, ctx.tuple_ret_slot)
    ctx.tuple_ret_slot = null

fn type_params_name(tp: *TypeParam, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    while tp != null
        if tp.name_len == len and memcmp(tp.name, name, len as i64) == 0
            return 1
        tp = tp.next
    return 0

# Is `name` a generic parameter of any fn, struct, impl or method in m?
fn module_names_type_param(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        if type_params_name(f.type_params, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        f = f.next
    var st: *StructDef = m.structs
    while st != null
        if type_params_name(st.type_params, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        st = st.next
    var ib: *ImplBlock = m.impls
    while ib != null
        if type_params_name(ib.type_params, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        var mt: *FnDef = ib.methods
        while mt != null
            if type_params_name(mt.type_params, StrView { ptr: (name), len: (len) as i64 }) == 1
                return 1
            mt = mt.next
        ib = ib.next
    return 0

# Append (name, len) to the parameter list `acc` unless it is there.
fn tuple_param_add(acc: *TypeParam, name_sv: StrView) -> *TypeParam
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if type_params_name(acc, StrView { ptr: (name), len: (len) as i64 }) == 1
        return acc
    let tp: *TypeParam = calloc(1, sizeof(TypeParam)) as *TypeParam
    tp.name = name
    tp.name_len = len
    tp.next = acc
    return tp

# The generic parameters of m that the struct-type name (name, len) names:
# a `$`-component that is one (`T`, `Vec$T`), or one a component that is a
# tuple names (`tuple_T_T`, `Vec$tuple_K_V`), added to `acc`.
fn tuple_name_params(ctx: *ParseCtx, m: *Module, name_sv: StrView, acc: *TypeParam) -> *TypeParam
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var out: *TypeParam = acc
    var pos: i32 = 0
    while pos < len
        var end: i32 = pos
        while end < len and *(name + end) != '$'   # '$'
            end = end + 1
        if module_names_type_param(m, StrView { ptr: (name + pos), len: (end - pos) as i64 }) == 1
            out = tuple_param_add(out, StrView { ptr: (name + pos), len: (end - pos) as i64 })
        else
            let inner: *StructDef = tuple_reg_find(ctx, StrView { ptr: (name + pos), len: (end - pos) as i64 })
            if inner != null
                var f: *StructField = inner.fields
                while f != null
                    if f.field_type == TypeKind.Struct and f.field_type_name != null
                        out = tuple_name_params(ctx, m, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, out)
                    f = f.next
        pos = end + 1
    out

# AGAST #2975: a tuple over a generic parameter (`-> (T, T)` in `fn f<T>`,
# `(K, V)` in `impl<K, V>`) is a template, as a generic struct is: its
# StructDef takes the parameters it names as type_params, so it is never
# emitted (a `%tuple_T_T = {%T, %T}` is invalid IR), and each instantiation
# substitutes it (monomorph's tuple_subst: `tuple_i32_i32` at T = i32).
# So is one whose element points at a parameter (`(*T, i32)`, `(@T, i32)`,
# AGAST #3173; `(**T, i32)`, #3184): tuple_subst substitutes the pointee.
# Checks the spellings this module registered, against every generic
# parameter name it declares.
fn tuple_mark_generic(p: *Parser)
    var r: *TupleReg = p.ctx.tuple_regs
    while r != null and r.fresh == 1
        r.fresh = 0
        var params: *TypeParam = null
        var f: *StructField = r.def.fields
        while f != null
            if f.field_type == TypeKind.Struct and f.field_type_name != null
                params = tuple_name_params(p.ctx, p.module, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, params)
                f = f.next
            else if (f.field_type == TypeKind.Ptr or f.field_type == TypeKind.PtrPtr or f.field_type == TypeKind.Ref or f.field_type == TypeKind.MutRef) and f.field_type_name != null and module_names_type_param(p.module, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) == 1
                # AGAST #3173: `*T` / `@T` / `@&T`, and `**T` (#3184);
                # tuple_subst substitutes the pointee.
                params = tuple_param_add(params, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
                f = f.next
            else
                f = f.next
        r.def.type_params = params
        r = r.next

# Module end: name every tuple literal of this module from its slot, and
# mark each tuple over a generic parameter a template.  A literal left nameless is
# named by the emitter (tuple_lit_name, AGAST #3005).
pub fn tuple_resolve_module(p: *Parser)
    tuple_mark_generic(p)
    if p.ctx.tuple_lits == 0
        return
    p.ctx.tuple_p = p
    var f: *FnDef = p.module.functions
    while f != null
        tuple_resolve_fn(p.ctx, f)
        f = f.next
    var ib: *ImplBlock = p.module.impls
    while ib != null
        var mt: *FnDef = ib.methods
        while mt != null
            tuple_resolve_fn(p.ctx, mt)
            mt = mt.next
        ib = ib.next
    p.ctx.tuple_lits = 0

# =============================================================================
# Statement helpers
# =============================================================================

# AGAST #2028: `let name ... = init` -- a stmt_var_decl whose binding is
# immutable.  let_check.ritz enforces it.
# AGAST #2407: record where statement `s`'s name is (binder_check.ritz).
# The grammar wraps each binding statement's action in this.
pub fn stmt_named(s: *Stmt, line: i32, col: i32) -> *Stmt
    s.name_span.line = line
    s.name_span.col = col
    return s

# The second name of `let (x, y) = ..` (AGAST #2407).
pub fn stmt_named2(s: *Stmt, line: i32, col: i32) -> *Stmt
    s.name2_span.line = line
    s.name2_span.col = col
    return s

pub fn stmt_let_decl(p: *Parser, name_sv: StrView, tr: *TypeRef, init: *Expr, line: i32, col: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *Stmt = stmt_var_decl(p, StrView { ptr: (name), len: (len) as i64 }, tr, init, line, col)
    s.var_is_let = 1
    return s

pub fn stmt_var_decl(p: *Parser, name_sv: StrView, tr: *TypeRef, init: *Expr, line: i32, col: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ty: TypeKind = tr_kind(tr)
    let facts: *TypeFacts = type_facts(p, tr)
    note_pass_binding(p.ctx, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3320
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.VarDecl
    s.var_is_let = 0
    s.name_span.line = 0   # AGAST #2407: stmt_named sets it
    s.name_span.col = 0
    # AGAST #2822: this decl's latches, not a nested typed `let`'s.
    if ty != TypeKind.Void
        pop_var_latch(p, line, col)
    # AGAST #1671: typed decls go through capture_var_type, which latched
    # var_fn_sig (null unless the type is a fn type).  Untyped ones have none.
    # On a `[N]fn(..)` array it is the element signature (AGAST #1747).
    s.var_fn_sig = null
    if ty == TypeKind.Ptr or ty == TypeKind.Array
        s.var_fn_sig = p.var_fn_sig
    s.span.line = line
    s.span.col = col
    s.var_name = name as *u8
    s.var_name_len = len
    s.var_ty = tr   # AGAST #4528: the parsed chain lowering types the local from
    # AGAST #1364: keep the written annotation for the narrowing check.
    s.var_declared_type = ty
    s.var_src_file = null
    if ty_int_in(ty, 8, 32) == 1
        s.var_src_file = parse_file_copy_shared(p)
    # Default to i64 for type inference (when ty == 0 aka TypeKind.Void)
    if ty == TypeKind.Void
        s.var_type = TypeKind.I64
        # AGAST #1521: `let b = x > 1` is a bool, as in ritz0. emit_var_decl
        # stores a bool in the same i64 slot, so the IR does not change; it
        # only lets print interpolation print `b` as true/false.
        if init != null
            if init.kind == ExprKind.Binary and op_is_cmp_or_logic(init.op)
                s.var_type = TypeKind.Bool
            else if init.kind == ExprKind.Unary and init.op == OpKind.Not
                s.var_type = TypeKind.Bool
    else
        s.var_type = ty
    # Copy struct type name from parser state
    # For TypeKind.Struct: the variable itself is a struct
    # For TypeKind.Ptr with pointee TypeKind.Struct: it's a pointer to a struct
    # Use var_type_name if available (set by capture_var_type before parsing initializer)
    # This prevents the type name from being clobbered by generic calls in the initializer
    if ty == TypeKind.Struct
        if p.var_type_name != null
            s.var_type_name = p.var_type_name as *u8
            s.var_type_name_len = p.var_type_name_len
        else
            s.var_type_name = facts.type_name
            s.var_type_name_len = facts.type_name_len
    else if ty == TypeKind.Ptr and p.var_pointee == TypeKind.Struct and p.var_type_name != null
        # AGAST #2822: `*S`, latched by capture_var_type (every typed decl
        # goes through it) before a `<*B>` in the initializer re-set it.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else if (ty == TypeKind.Ref or ty == TypeKind.MutRef) and p.var_type_name != null
        # AGAST #1754: reference to struct, latched by capture_var_type.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else if ty == TypeKind.PtrPtr and p.var_type_name != null
        # AGAST #1933: `**S` local, latched by capture_var_type.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else
        s.var_type_name = null
        s.var_type_name_len = 0
    # Copy array info from parser state if this is an array type
    s.var_array_shape = null
    s.var_pointee_array_shape = null   # AGAST #2570: inference sets it; #2098: or `*[N][M]T` below
    # AGAST #2822: latched by capture_var_type (every typed decl goes through
    # it) before a `<[M]U>` in the initializer re-set last_array_*.
    let arr: *ArrayElem = p.ctx.var_array
    s.var_array_elem_pointee = TypeKind.Void
    s.var_array = null
    if ty == TypeKind.Array and arr != null
        s.var_array = arr   # AGAST #2995
        s.var_array_size = p.ctx.var_array_size
        s.var_array_elem_type = arr.elem
        s.var_array_shape = arr.shape  # AGAST #1509
        s.var_array_elem_pointee = arr.pointee
        # For arrays of structs, store the struct name in var_type_name
        # so the emitter can allocate with correct element size
        if arr.elem == TypeKind.Struct
            s.var_type_name = arr.name
            s.var_type_name_len = arr.name_len
        else if (arr.elem == TypeKind.Ptr or arr.elem == TypeKind.PtrPtr or arr.elem == TypeKind.Ref or arr.elem == TypeKind.MutRef) and arr.name_len > 0
            # AGAST #184: [N]*Foo arrays (#2369: and [N]@Foo / [N]@&Foo) —
            # propagate the inner pointee
            # struct name so emit_member_ptr can resolve `arr[i].field`.
            s.var_type_name = arr.name
            s.var_type_name_len = arr.name_len
    else
        s.var_array_size = 0
        s.var_array_elem_type = TypeKind.Void
    # Copy pointee type from parser state if this is a pointer type
    # AGAST #2805: latched by capture_var_type for a typed decl with an
    # initializer, as the inner pointee slot below is.
    if (ty == TypeKind.Ptr or ty == TypeKind.PtrPtr) and init != null
        s.var_pointee_type = p.var_pointee
    else if ty == TypeKind.Ptr or ty == TypeKind.PtrPtr
        s.var_pointee_type = facts.pointee_type
    else if (ty == TypeKind.Ref or ty == TypeKind.MutRef) and s.var_type_name_len > 0
        s.var_pointee_type = TypeKind.Struct  # AGAST #1754, as param_new
    else
        s.var_pointee_type = TypeKind.I64  # Default
    # AGAST #2805: a typed decl with an initializer went through
    # capture_var_type, which latched the slot before the initializer was
    # parsed.  Without one (`var x: **S`) the parser state is still current.
    if init != null and ty != TypeKind.Void
        s.var_inner_pointee_type = p.var_inner_pointee
        s.var_inner_ref = p.var_inner_ref   # AGAST #2399
    else
        s.var_inner_pointee_type = ptr_ptr_inner_pointee(p, tr)
        s.var_inner_ref = inner_ref_of(p, tr)
    # AGAST #2822: a `*[N]T`'s pointee array, latched by capture_var_type.
    s.var_pointee_array_size = 0
    s.var_pointee_array_elem_type = TypeKind.Void
    s.var_pointee_array_elem_pointee = TypeKind.Void
    s.var_pointee_array_elem_name = null
    s.var_pointee_array_elem_name_len = 0
    if ty != TypeKind.Void
        s.var_pointee_array_elem_name = p.ctx.var_ptr_array_elem_name
        s.var_pointee_array_elem_name_len = p.ctx.var_ptr_array_elem_name_len
        s.var_pointee_array_size = p.ctx.var_ptr_array_size
        s.var_pointee_array_elem_type = p.ctx.var_ptr_array_elem
        s.var_pointee_array_elem_pointee = p.ctx.var_ptr_array_elem_pointee
        # AGAST #2098: and its shape, consumed: a decl that captured nothing (an
        # alias `var b: PA`) must not take an earlier `*[N][M]T`'s.
        if ty == TypeKind.Ptr or ty == TypeKind.PtrPtr   # #3635: `**[N][M]T` too
            s.var_pointee_array_shape = p.ctx.var_ptr_array_shape
        if ty == TypeKind.Ref or ty == TypeKind.MutRef   # #4122: `@*[N][M]T` / `@&*[N][M]T`
            s.var_pointee_array_shape = p.ctx.var_ptr_array_shape
        p.ctx.var_ptr_array_shape = null
    s.var_ref = null
    if (ty == TypeKind.Ref or ty == TypeKind.MutRef) and p.ctx.var_ref != null
        s.var_ref = p.ctx.var_ref
        stmt_take_var_ref(s)
    s.var_init = init
    s.next = null
    return s

# AGAST #2308: what `s.var_ref` records is what a `@T` local is registered with.
# Without the referent a `let p: @&i8` read and stored 8 bytes through `*p`,
# where the same type on a param stored one.
pub fn stmt_take_var_ref(s: *Stmt)
    let r: *Param = s.var_ref
    s.var_type_name = r.param_type_name
    s.var_type_name_len = r.param_type_name_len
    s.var_pointee_type = r.param_pointee_type
    s.var_pointee_array_size = r.param_pointee_array_size
    s.var_pointee_array_elem_type = r.param_pointee_array_elem_type
    s.var_pointee_array_elem_pointee = r.param_pointee_array_elem_pointee

pub fn stmt_return(p: *Parser, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Return
    s.span.line = line
    s.span.col = col
    s.return_value = val
    s.next = null
    return s

pub fn stmt_break(p: *Parser, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Break
    s.span.line = line
    s.span.col = col
    s.next = null
    return s

# `defer <stmt>` / `defer` + block (AGAST #1625): `body` (null for a bare
# `defer`) goes in while_body; see StmtKind.Defer.
pub fn stmt_defer(p: *Parser, body: *Stmt, is_block: i32, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Defer
    s.span.line = line
    s.span.col = col
    s.while_cond = null
    s.while_body = body
    s.defer_is_block = is_block
    s.next = null
    return s

# `unsafe` + block (AGAST #2248): the body goes in while_body; see StmtKind.Unsafe.
pub fn stmt_unsafe(p: *Parser, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Unsafe
    s.span.line = line
    s.span.col = col
    s.while_cond = null
    s.while_body = body
    s.next = null
    return s

# =============================================================================
# Inline assembly (LANGUAGE_SPEC §18.6, LARB R50, AGAST #3394)
# =============================================================================
#
# The grammar builds the clause list (asm_clause_new) and the line list
# (asm_line_new); stmt_asm puts them in an AsmBlock, adds an ASM_IN operand
# for each `{name}` no clause names, and reports, located, every §18.6 error
# that needs no types:
#   unknown ARCH; a clause word other than in/out/inout/clobber; `{` not
#   closed or not followed by a name; a name in two clauses; an unpinned
#   clause operand missing from the text; a register pinned twice, not a
#   general register, or rsp/rbp pinned or clobbered; a named label.
# The [[naked]] rules (no clause, no `{name}`, nothing but asm) are checked
# when the fn is dispatched (asm_check_naked).  `{name}` not in scope or not
# an integer or pointer, and `out` on a non-place, need types: they are
# checked where the block is lowered (emitter_asm.ritz, AGAST #3395).

# The arch name of the last block reported on, so a block the parser
# backtracks over and builds again is reported once.  Blocks are built in
# source order; reset per file by parser_reset_diagnostics.
# State: ParseCtx.asm_last_block

# `<file>:<line>:<col>: error: <pre><name><post>`, counted as a parse error.
fn asm_error(ctx: *ParseCtx, line: i32, col: i32, pre: *u8, name_sv: StrView, post: *u8)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    ctx.attr_errors = ctx.attr_errors + 1
    diag_error_name(ctx.parse_file, diag_span(line, col), pre, StrView { ptr: (name), len: (len) as i64 }, post)

# The x86_64 general register `name` names by its 64-bit name, as an index
# (the order of the hardware encoding), or ASM_REG_NONE.
pub fn asm_reg_index(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rax"), len: (3) as i64 })
        return 0
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rcx"), len: (3) as i64 })
        return 1
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rdx"), len: (3) as i64 })
        return 2
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rbx"), len: (3) as i64 })
        return 3
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rsp"), len: (3) as i64 })
        return ASM_REG_RSP
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rbp"), len: (3) as i64 })
        return ASM_REG_RBP
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rsi"), len: (3) as i64 })
        return 6
    if (StrView { ptr: (name), len: (len) as i64 }).eq(StrView { ptr: (c"rdi"), len: (3) as i64 })
        return 7
    # r8 .. r15
    if len >= 2 and len <= 3 and *name == 'r'
        var n: i32 = 0
        var i: i32 = 1
        while i < len
            let c: i32 = (*(name + i)) as i32
            if c < '0' or c > '9'
                return ASM_REG_NONE
            n = n * 10 + (c - 48)
            i = i + 1
        if *(name + 1) != '0' and n >= 8 and n <= 15
            return n
    ASM_REG_NONE

fn asm_is_name_start(c: i32) -> i32
    ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_') as i32

fn asm_is_name_char(c: i32) -> i32
    (asm_is_name_start(c) == 1 or (c >= '0' and c <= '9')) as i32

# Grammar action for one clause, `<kind> <name> (: <reg>)?`; `reg` is null
# without `: reg`.  The kind word is judged in stmt_asm: `in` is a keyword,
# the others are IDENTs.  For `clobber r11` the register is the "name".
pub fn asm_clause_new(p: *Parser, kind_sv: StrView, kline: i32, kcol: i32, name_sv: StrView, line: i32, col: i32, reg_sv: StrView, rline: i32, rcol: i32) -> *AsmOperand
    var kind: *u8 = kind_sv.ptr
    var kind_len: i32 = kind_sv.len as i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var reg: *u8 = reg_sv.ptr
    var reg_len: i32 = reg_sv.len as i32
    let o: *AsmOperand = parser_alloc(p, sizeof(AsmOperand)) as *AsmOperand
    o.name = name
    o.name_len = name_len
    o.span.line = line
    o.span.col = col
    o.kind = kind
    o.kind_len = kind_len
    o.kind_span.line = kline
    o.kind_span.col = kcol
    o.dir = ASM_UNKNOWN
    if (StrView { ptr: (kind), len: (kind_len) as i64 }).eq(StrView { ptr: (c"in"), len: (2) as i64 })
        o.dir = ASM_IN
    else if (StrView { ptr: (kind), len: (kind_len) as i64 }).eq(StrView { ptr: (c"out"), len: (3) as i64 })
        o.dir = ASM_OUT
    else if (StrView { ptr: (kind), len: (kind_len) as i64 }).eq(StrView { ptr: (c"inout"), len: (5) as i64 })
        o.dir = ASM_INOUT
    else if (StrView { ptr: (kind), len: (kind_len) as i64 }).eq(StrView { ptr: (c"clobber"), len: (7) as i64 })
        o.dir = ASM_CLOBBER
    o.reg = ASM_REG_NONE
    o.reg_name = reg
    o.reg_name_len = reg_len
    o.reg_span.line = rline
    o.reg_span.col = rcol
    if reg != null
        o.reg = asm_reg_index(StrView { ptr: (reg), len: (reg_len) as i64 })
    o.in_clause = 1
    o.text_span.line = 0
    o.text_span.col = 0
    o.next = null
    o

pub fn asm_operand_link(first: *AsmOperand, rest: *AsmOperand) -> *AsmOperand
    first.next = rest
    first

pub fn asm_line_new(p: *Parser, text_sv: StrView, line: i32, col: i32) -> *AsmLine
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    let l: *AsmLine = parser_alloc(p, sizeof(AsmLine)) as *AsmLine
    l.text = text
    l.len = len
    l.span.line = line
    l.span.col = col
    l.next = null
    l

pub fn asm_line_link(first: *AsmLine, rest: *AsmLine) -> *AsmLine
    first.next = rest
    first

# The operand of `b` named `name`, or null.
fn asm_find_operand(b: *AsmBlock, name_sv: StrView) -> *AsmOperand
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var o: *AsmOperand = b.operands
    while o != null
        if (StrView { ptr: (o.name), len: (o.name_len) as i64 }).eq(StrView { ptr: (name), len: (len) as i64 })
            return o
        o = o.next
    null

# Append `o` to b.operands.
fn asm_append_operand(b: *AsmBlock, o: *AsmOperand)
    o.next = null
    if b.operands == null
        b.operands = o
        return
    var t: *AsmOperand = b.operands
    while t.next != null
        t = t.next
    t.next = o

# 1 if register `reg`, written `text` at `at`, may be pinned or clobbered;
# reports it (when `report` is 1) if not.
fn asm_reg_ok(ctx: *ParseCtx, reg: i32, text_sv: StrView, at: SrcSpan, report: i32) -> i32
    var text: *u8 = text_sv.ptr
    var len: i32 = text_sv.len as i32
    if reg == ASM_REG_NONE
        if report == 1
            asm_error(ctx, at.line, at.col, c"'", StrView { ptr: (text), len: (len) as i64 }, c"' is not a general register (rax, rbx, rcx, rdx, rsi, rdi, r8-r15)")
        return 0
    if reg == ASM_REG_RSP or reg == ASM_REG_RBP
        if report == 1
            asm_error(ctx, at.line, at.col, c"asm can't pin or clobber '", StrView { ptr: (text), len: (len) as i64 }, c"'")
        return 0
    1

# Sort a block's clauses, in order: a clobber sets its bit in b.clobbers,
# any other is appended to b.operands.  Reports what is wrong with each.
fn asm_take_clauses(ctx: *ParseCtx, b: *AsmBlock, clauses: *AsmOperand, report: i32)
    var pinned: i32 = 0
    var o: *AsmOperand = clauses
    while o != null
        let nxt: *AsmOperand = o.next
        b.clause_count = b.clause_count + 1
        if b.first_clause.line == 0
            b.first_clause = o.kind_span
        if o.dir == ASM_UNKNOWN
            if report == 1
                asm_error(ctx, o.kind_span.line, o.kind_span.col, c"unknown asm clause '", StrView { ptr: (o.kind), len: (o.kind_len) as i64 }, c"' (in, out, inout or clobber)")
        else if o.dir == ASM_CLOBBER
            if o.reg_name != null
                if report == 1
                    asm_error(ctx, o.reg_span.line, o.reg_span.col, c"'clobber' takes one register, not '", StrView { ptr: (o.name), len: (o.name_len) as i64 }, c": ...'")
            else
                let reg: i32 = asm_reg_index(StrView { ptr: (o.name), len: (o.name_len) as i64 })
                if asm_reg_ok(ctx, reg, StrView { ptr: (o.name), len: (o.name_len) as i64 }, o.span, report) == 1
                    b.clobbers = b.clobbers | (1 << reg)
        else if asm_find_operand(b, StrView { ptr: (o.name), len: (o.name_len) as i64 }) != null
            if report == 1
                asm_error(ctx, o.span.line, o.span.col, c"'", StrView { ptr: (o.name), len: (o.name_len) as i64 }, c"' is named in two asm clauses")
        else
            if o.reg_name != null
                if asm_reg_ok(ctx, o.reg, StrView { ptr: (o.reg_name), len: (o.reg_name_len) as i64 }, o.reg_span, report) == 0
                    o.reg = ASM_REG_NONE
                else if (pinned & (1 << o.reg)) != 0
                    if report == 1
                        asm_error(ctx, o.reg_span.line, o.reg_span.col, c"asm register '", StrView { ptr: (o.reg_name), len: (o.reg_name_len) as i64 }, c"' is pinned twice")
                else
                    pinned = pinned | (1 << o.reg)
            asm_append_operand(b, o)
        o = nxt

# A named label at the start of line `l` (`loop:`, `.L1:`), reported; only
# numeric local labels (`1:`) are allowed (§18.6, #1371).
fn asm_check_label(ctx: *ParseCtx, l: *AsmLine, report: i32)
    if l.len == 0
        return
    let c0: i32 = (*l.text) as i32
    if asm_is_name_start(c0) == 0 and c0 != '.'   # '.'
        return
    var i: i32 = 1
    while i < l.len and (asm_is_name_char((*(l.text + i)) as i32) == 1 or *(l.text + i) == '.' or *(l.text + i) == '$')
        i = i + 1
    if i < l.len and *(l.text + i) == ':'   # ':'
        if report == 1
            asm_error(ctx, l.span.line, l.span.col, c"named label '", StrView { ptr: (l.text), len: (i) as i64 }, c"' in asm: use a numeric local label (1:, jumped to as 1b or 1f)")

# The `{name}`s of line `l`: each name no operand has yet becomes an ASM_IN
# operand; each operand found is marked as in the text.  `{{` and `}}` are a
# literal brace.  A `{` that isn't closed, or isn't a name, is reported.
fn asm_scan_line(p: *Parser, b: *AsmBlock, l: *AsmLine, report: i32)
    var i: i32 = 0
    while i < l.len
        let c: i32 = (*(l.text + i)) as i32
        if c == '{' and i + 1 < l.len and *(l.text + i + 1) == '{'   # `{{`
            i = i + 2
        else if c == '}' and i + 1 < l.len and *(l.text + i + 1) == '}'   # `}}`
            i = i + 2
        else if c == '{'
            var j: i32 = i + 1
            if j < l.len and asm_is_name_start((*(l.text + j)) as i32) == 1
                while j < l.len and asm_is_name_char((*(l.text + j)) as i32) == 1
                    j = j + 1
            if j < l.len and j > i + 1 and *(l.text + j) == '}'
                let name: *u8 = l.text + i + 1
                let len: i32 = j - i - 1
                var o: *AsmOperand = asm_find_operand(b, StrView { ptr: (name), len: (len) as i64 })
                if o == null
                    o = parser_alloc(p, sizeof(AsmOperand)) as *AsmOperand
                    o.name = name
                    o.name_len = len
                    o.span.line = l.span.line
                    o.span.col = l.span.col + i + 1
                    o.dir = ASM_IN
                    o.reg = ASM_REG_NONE
                    o.reg_name = null
                    o.reg_name_len = 0
                    o.in_clause = 0
                    o.text_span.line = 0
                    o.kind = null
                    o.kind_len = 0
                    asm_append_operand(b, o)
                if o.text_span.line == 0
                    o.text_span.line = l.span.line
                    o.text_span.col = l.span.col + i
                i = j + 1
            else
                if report == 1
                    var closed: i32 = 0
                    var k: i32 = i + 1
                    while k < l.len
                        if *(l.text + k) == '}'
                            closed = 1
                        k = k + 1
                    if closed == 0
                        asm_error(p.ctx, l.span.line, l.span.col + i, c"'{' in asm is not closed", StrView { ptr: (null), len: (0) as i64 }, c" (write '{{' for a literal '{')")
                    else
                        asm_error(p.ctx, l.span.line, l.span.col + i, c"'{' in asm must be followed by a name and '}'", StrView { ptr: (null), len: (0) as i64 }, c" (write '{{' for a literal '{')")
                i = l.len
        else
            i = i + 1

# Grammar action for an asm block (LANGUAGE_SPEC §18.6, AGAST #3394).
pub fn stmt_asm(p: *Parser, arch_sv: StrView, aline: i32, acol: i32, clauses: *AsmOperand, lines: *AsmLine, line: i32, col: i32) -> *Stmt
    var arch: *u8 = arch_sv.ptr
    var arch_len: i32 = arch_sv.len as i32
    # A block the parser backtracked over and builds again is not re-reported.
    var report: i32 = 0
    if p.ctx.asm_last_block == null or (arch as i64) > (p.ctx.asm_last_block as i64)
        report = 1
        p.ctx.asm_last_block = arch
    let b: *AsmBlock = parser_alloc(p, sizeof(AsmBlock)) as *AsmBlock
    b.arch = arch
    b.arch_len = arch_len
    b.lines = lines
    b.operands = null
    b.clobbers = 0
    b.clause_count = 0
    b.first_clause.line = 0
    b.first_clause.col = 0
    if not (StrView { ptr: (arch), len: (arch_len) as i64 }).eq(StrView { ptr: (c"x86_64"), len: (6) as i64 }) and report == 1
        asm_error(p.ctx, aline, acol, c"unknown asm architecture '", StrView { ptr: (arch), len: (arch_len) as i64 }, c"' (known: x86_64)")
    asm_take_clauses(p.ctx, b, clauses, report)
    var l: *AsmLine = lines
    while l != null
        asm_check_label(p.ctx, l, report)
        asm_scan_line(p, b, l, report)
        l = l.next
    # An unpinned clause operand has no register but the one {name} picks.
    var o: *AsmOperand = b.operands
    while o != null
        if o.in_clause == 1 and o.reg_name == null and o.text_span.line == 0 and report == 1
            asm_error(p.ctx, o.span.line, o.span.col, c"asm operand '", StrView { ptr: (o.name), len: (o.name_len) as i64 }, c"' is in a clause but not in the text: write {name} or pin it to a register")
        o = o.next
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Asm
    s.span.line = line
    s.span.col = col
    s.asm_block = b
    s.next = null
    return s

# The [[naked]] rules for fn `f` (§18.6, §17.5): its body holds only asm
# blocks, and they take no clause and no `{name}`: there is no frame.
fn asm_check_naked(ctx: *ParseCtx, f: *FnDef)
    var st: *Stmt = f.body
    while st != null
        if st.kind != StmtKind.Asm
            asm_error(ctx, st.span.line, st.span.col, c"a [[naked]] fn body may contain only asm blocks", StrView { ptr: (null), len: (0) as i64 }, c"")
        else
            let b: *AsmBlock = st.asm_block
            if b.clause_count > 0
                asm_error(ctx, b.first_clause.line, b.first_clause.col, c"an asm block in a [[naked]] fn takes no clauses", StrView { ptr: (null), len: (0) as i64 }, c"")
            var o: *AsmOperand = b.operands
            while o != null
                if o.text_span.line != 0
                    asm_error(ctx, o.text_span.line, o.text_span.col, c"an asm block in a [[naked]] fn takes no {name}: '", StrView { ptr: (o.name), len: (o.name_len) as i64 }, c"' has no frame to live in")
                o = o.next
        st = st.next

pub fn stmt_continue(p: *Parser, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Continue
    s.span.line = line
    s.span.col = col
    s.next = null
    return s

pub fn stmt_if(p: *Parser, cond: *Expr, then_body: *Stmt, else_body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.If
    s.span.line = line
    s.span.col = col
    s.if_cond = cond
    s.if_then = then_body
    s.if_else = else_body
    s.next = null
    return s

# `assert <cond>[, "message"]` — a runtime check that exits 1 on a falsy
# cond.  Condition lives in if_cond (slot reused from StmtKind.If); the message
# (null / 0 if none) in assert_msg.  emit_assert_stmt (emitter_print.ritz)
# lowers it (AGAST #1869).
pub fn stmt_assert(p: *Parser, cond: *Expr, msg_sv: StrView, line: i32, col: i32) -> *Stmt
    var msg: *u8 = msg_sv.ptr
    var msg_len: i32 = msg_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Assert
    s.span.line = line
    s.span.col = col
    s.if_cond = cond
    s.assert_msg = msg
    s.assert_msg_len = msg_len
    s.next = null
    return s

# `assert <cond>, c"..."`: the message is a "..." (StrView) literal only, so a
# c-string message is a located error at the literal, worded as ritz0's
# ASSERT_CSTRING_MESSAGE (AGAST #3794).  Returns a message-less assert so the
# parse goes on; ctx.attr_errors fails the compile.
pub fn assert_cstring_message_refused(p: *Parser, cond: *Expr, lit_line: i32, lit_col: i32, line: i32, col: i32) -> *Stmt
    if p.skip_item == 0
        diag_error(p.ctx.parse_file, diag_span(lit_line, lit_col), c"an assert message is a \"...\" literal: drop the `c`")
        p.ctx.attr_errors = p.ctx.attr_errors + 1
    stmt_assert(p, cond, StrView { ptr: (null), len: (0) as i64 }, line, col)

# `let (x, y, ...) = expr` — destructure.  First binding name lives in
# var_name (reuse), second in assign_target (reuse), any after the second
# in tuple_more (AGAST #109, stmt_tuple_more).  Init expr in var_init.  Emitter (see StmtKind.TupleDecl handler) emits the init as a
# struct value, alloca two i64 slots, extractvalue fields 0/1 with
# appropriate widening to i64, and registers both names as locals.
# `paren_line` / `paren_col` are where the pattern's `(` is: LARB R67's
# refusal points there (AGAST #3500), as ritz0's paren_span does (AGAST #3499).
pub fn stmt_tuple_decl(p: *Parser, name1_sv: StrView, name2_sv: StrView, init: *Expr, line: i32, col: i32, paren_line: i32, paren_col: i32) -> *Stmt
    var name1: *u8 = name1_sv.ptr
    var len1: i32 = name1_sv.len as i32
    var name2: *u8 = name2_sv.ptr
    var len2: i32 = name2_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.TupleDecl
    s.name_span.line = 0   # AGAST #2407: stmt_named and stmt_named2 set them
    s.name_span.col = 0
    s.name2_span.line = 0
    s.name2_span.col = 0
    s.span.line = line
    s.span.col = col
    s.paren_span.line = paren_line
    s.paren_span.col = paren_col
    s.var_name = name1 as *u8
    s.var_name_len = len1
    s.assign_target = name2 as *u8
    s.assign_target_len = len2
    s.tuple_more = null   # AGAST #109: stmt_tuple_more sets the tail
    s.var_init = init
    s.next = null
    return s

# AGAST #109: one name of a destructure's tail (`c` of `let (a, b, c) = e`).
pub fn tuple_name_new(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *TupleName
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let t: *TupleName = parser_alloc(p, sizeof(TupleName)) as *TupleName
    t.name = name
    t.len = len
    t.span.line = line
    t.span.col = col
    t.next = null
    return t

pub fn tuple_name_link(first: *TupleName, rest: *TupleName) -> *TupleName
    first.next = rest
    return first

# AGAST #109: give tuple decl `s` its names after the second.
pub fn stmt_tuple_more(s: *Stmt, more: *TupleName) -> *Stmt
    s.tuple_more = more
    return s

# AGAST #109: how many names tuple decl `s` binds, `_` included.
pub fn tuple_decl_arity(s: *Stmt) -> i32
    var n: i32 = 2
    var t: *TupleName = s.tuple_more
    while t != null
        n = n + 1
        t = t.next
    n

pub fn stmt_while(p: *Parser, cond: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.While
    s.span.line = line
    s.span.col = col
    s.while_cond = cond
    s.while_body = body
    s.next = null
    return s

pub fn stmt_for(p: *Parser, var_name_sv: StrView, start: *Expr, end: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.For
    s.name_span.line = 0   # AGAST #2407: stmt_named sets it
    s.name_span.col = 0
    s.span.line = line
    s.span.col = col
    s.for_var = var_name
    s.for_var_len = var_len
    s.for_start = start
    s.for_end = end
    s.for_body = body
    s.for_inclusive = 0
    s.next = null
    return s

# for_stmt : FOR IDENT IN expr DOTDOTEQ expr block  (AGAST #1530)
# Same StmtKind.For as `start..end`; emit_stmt lowers the bound as `<=`.
pub fn stmt_for_inclusive(p: *Parser, var_name_sv: StrView, start: *Expr, end: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    let s: *Stmt = stmt_for(p, StrView { ptr: (var_name), len: (var_len) as i64 }, start, end, body, line, col)
    s.for_inclusive = 1
    return s

# Infinite loop: loop { body } - use break to exit
# Reuses while_body field for the loop body (no condition needed)
pub fn stmt_loop(p: *Parser, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Loop
    s.span.line = line
    s.span.col = col
    s.while_cond = null  # No condition for infinite loop
    s.while_body = body
    s.next = null
    return s

pub fn stmt_assign_name(p: *Parser, name_sv: StrView, val: *Expr, line: i32, col: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Assign
    s.span.line = line
    s.span.col = col
    s.assign_target = name as *u8
    s.assign_target_len = len
    s.assign_value = val
    s.next = null
    return s

pub fn stmt_assign_index(p: *Parser, name_sv: StrView, idx: *Expr, val: *Expr, line: i32, col: i32, bline: i32, bcol: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.IndexAssign
    s.span.line = line
    s.span.col = col
    s.bracket.line = bline
    s.bracket.col = bcol
    s.assign_target = name as *u8
    s.assign_target_len = len
    s.assign_value = val
    # Store index expression in while_cond (reuse, like StmtKind.MemberIndexAssign)
    s.while_cond = idx
    s.next = null
    return s

pub fn stmt_assign_deref(p: *Parser, target: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Assign
    s.span.line = line
    s.span.col = col
    # Store target expression in assign_value's place, we need to reinterpret
    # For now, use target directly - emitter needs to handle ExprKind.Unary(DEREF) case
    s.assign_target = null
    s.assign_target_len = 0
    s.assign_value = val
    # AGAST #1304: store the target WRAPPED in ExprKind.Unary/OpKind.Deref.
    #
    # This used to stash the bare deref OPERAND, which made `*b.p = v`
    # indistinguishable from `b.p = v` — both produced StmtKind.Assign with
    # assign_target_len == 0 and an ExprKind.Member in if_cond.  emit_assign
    # checks ExprKind.Member first, so every `*expr.field = value` compiled to
    # a plain field store: it overwrote the POINTER instead of writing
    # through it.  That is what corrupted IoUring.sq_tail in
    # uring_sqe_submit (`*ring.sq_tail = tail + 1`) and segfaulted the
    # async_net / echo_server examples.
    #
    # Keeping the `*` in the AST matches ritz0, whose emitter likewise
    # tests UnaryOp('*') before Field.
    s.if_cond = expr_unary(p, OpKind.Deref, target, line, col)
    s.next = null
    return s

# AGAST #3015: where the token starting at `at` is, from the last few tokens
# before the parser's position (a field name just parsed); 0:0 if not there.
fn tok_span_back(p: *Parser, at: *u8, out: *SrcSpan)
    out.line = 0
    out.col = 0
    var i: i32 = p.pos
    if i >= p.token_count
        i = p.token_count - 1
    var n: i32 = 0
    while i >= 0 and n < 512
        let t: *Token = p.tokens + i
        if t.start == at
            out.line = t.line
            out.col = t.col
            return
        i -= 1
        n += 1

# Where the token after the one starting at `at` is: the `[` of `h.t[k] = v`
# after its field name (AGAST #2847).  Line 0 when it isn't found.
fn tok_span_after(p: *Parser, at: *u8, out: *SrcSpan)
    out.line = 0
    out.col = 0
    var i: i32 = p.pos
    if i >= p.token_count
        i = p.token_count - 1
    var n: i32 = 0
    while i >= 0 and n < 512
        let t: *Token = p.tokens + i
        if t.start == at
            if i + 1 < p.token_count
                let after: *Token = p.tokens + i + 1
                out.line = after.line
                out.col = after.col
            return
        i -= 1
        n += 1

# Member assignment through pointer: ptr.field = value
pub fn stmt_assign_member(p: *Parser, ptr_expr: *Expr, field_sv: StrView, val: *Expr, line: i32, col: i32) -> *Stmt
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.MemberAssign
    s.span.line = line
    s.span.col = col
    # Store pointer expression in if_cond
    s.if_cond = ptr_expr
    # Store field name in assign_target
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    tok_span_back(p, field, @s.bracket)   # AGAST #3015
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Indexed member assignment through pointer: ptr.field[index] = value
pub fn stmt_assign_member_index(p: *Parser, ptr_expr: *Expr, field_sv: StrView, idx: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.MemberIndexAssign
    s.span.line = line
    s.span.col = col
    # Store pointer expression in if_cond
    s.if_cond = ptr_expr
    # Store field name in assign_target
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    tok_span_back(p, field, @s.bracket)   # AGAST #3015
    tok_span_after(p, field, @s.index_at)   # AGAST #2847
    # Store index expression in while_cond (reuse)
    s.while_cond = idx
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# General expression assignment: expr = value
# This handles nested member access like r.origin.x = 10
pub fn stmt_assign_expr(p: *Parser, target: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Assign
    s.span.line = line
    s.span.col = col
    # Store target expression in if_cond (reuse)
    s.if_cond = target
    # Signal this is an expression assignment by setting assign_target_len = 0
    s.assign_target = null
    s.assign_target_len = 0
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Local struct field assignment: var.field = value
pub fn stmt_assign_local_field(p: *Parser, var_name_sv: StrView, field_sv: StrView, val: *Expr, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.LocalFieldAssign
    s.span.line = line
    s.span.col = col
    # Store variable name in var_name/var_name_len
    s.var_name = var_name as *u8
    s.var_name_len = var_len
    # Store field name in assign_target/assign_target_len
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    tok_span_back(p, field, @s.bracket)   # AGAST #3015
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Local struct field array assignment: var.field[index] = value
pub fn stmt_assign_local_field_index(p: *Parser, var_name_sv: StrView, field_sv: StrView, idx: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.LocalFieldIndexAssign
    s.span.line = line
    s.span.col = col
    # Store variable name in var_name/var_name_len
    s.var_name = var_name as *u8
    s.var_name_len = var_len
    # Store field name in assign_target/assign_target_len
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    tok_span_back(p, field, @s.bracket)   # AGAST #3015
    tok_span_after(p, field, @s.index_at)   # AGAST #2847
    # Store index expression in while_cond (reuse)
    s.while_cond = idx
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Desugar compound assignment: `name op= val` -> `name = name op val`
# op should be OpKind.Add, OpKind.Sub, OpKind.Mul, OpKind.Div
pub fn stmt_compound_assign(p: *Parser, name_sv: StrView, op: OpKind, val: *Expr, line: i32, col: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Create identifier expression for the variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = ExprKind.Ident
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = name
    ident.ident_len = len
    ident.next = null
    # Create binary expression: name op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = ident
    binary.right = val
    binary.next = null
    # Create assignment statement: name = (name op val)
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Assign
    s.span.line = line
    s.span.col = col
    s.assign_target = name
    s.assign_target_len = len
    s.assign_value = binary
    s.next = null
    return s

# Compound assignment for array index: arr[idx] op= val -> arr[idx] = arr[idx] op val
pub fn stmt_compound_assign_index(p: *Parser, name_sv: StrView, idx: *Expr, op: OpKind, val: *Expr, line: i32, col: i32, bline: i32, bcol: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Create identifier expression for array
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = ExprKind.Ident
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = name
    ident.ident_len = len
    ident.next = null
    # Create index expression for reading: arr[idx]
    let read_idx: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    read_idx.kind = ExprKind.Index
    read_idx.span.line = line
    read_idx.span.col = col
    read_idx.bracket.line = 0
    read_idx.left = ident
    read_idx.right = idx
    read_idx.next = null
    # Create binary expression: arr[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = read_idx
    binary.right = val
    binary.next = null
    # Create index assignment: arr[idx] = (arr[idx] op val)
    return stmt_assign_index(p, StrView { ptr: (name), len: (len) as i64 }, idx, binary, line, col, bline, bcol)

# Compound assignment for dereference: *ptr op= val -> *ptr = *ptr op val
pub fn stmt_compound_assign_deref(p: *Parser, target: *Expr, op: OpKind, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create deref expression for reading: *ptr
    let read_deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    read_deref.kind = ExprKind.Unary
    read_deref.span.line = line
    read_deref.span.col = col
    read_deref.op = OpKind.Deref
    read_deref.operand = target
    read_deref.next = null
    # Create binary expression: *ptr op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = read_deref
    binary.right = val
    binary.next = null
    # Create deref assignment: *ptr = (*ptr op val)
    return stmt_assign_deref(p, target, binary, line, col)

# Compound assignment for member: (*ptr).field op= val
#
# The statement is at the `(` (line, col); the `(*ptr).field op val` it
# synthesizes is at the `*` (star_line, star_col), where ritz0 places that
# binary's left operand and so reports a value narrowed into it (AGAST #4288).
pub fn stmt_compound_assign_member(p: *Parser, ptr_expr: *Expr, field_sv: StrView, op: OpKind, val: *Expr, line: i32, col: i32, star_line: i32, star_col: i32) -> *Stmt
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    # Create deref expression: *ptr
    let deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    deref.kind = ExprKind.Unary
    deref.span.line = star_line
    deref.span.col = star_col
    deref.op = OpKind.Deref
    deref.operand = ptr_expr
    deref.next = null
    # Create member access expression: (*ptr).field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = ExprKind.Member
    member.span.line = star_line
    member.span.col = star_col
    member.left = deref
    member.ident_ptr = field
    member.ident_len = field_len
    tok_span_back(p, field, @member.bracket)   # AGAST #3015
    member.next = null
    # Create binary expression: (*ptr).field op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = star_line
    binary.span.col = star_col
    binary_set_op(binary, op)
    binary.left = member
    binary.right = val
    binary.next = null
    # Create member assignment
    return stmt_assign_member(p, ptr_expr, StrView { ptr: (field), len: (field_len) as i64 }, binary, line, col)

# Compound assignment for indexed member: (*ptr).field[idx] op= val
# Synthesized at the `*`, as stmt_compound_assign_member is.
pub fn stmt_compound_assign_member_index(p: *Parser, ptr_expr: *Expr, field_sv: StrView, idx: *Expr, op: OpKind, val: *Expr, line: i32, col: i32, star_line: i32, star_col: i32) -> *Stmt
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    # Create deref expression: *ptr
    let deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    deref.kind = ExprKind.Unary
    deref.span.line = star_line
    deref.span.col = star_col
    deref.op = OpKind.Deref
    deref.operand = ptr_expr
    deref.next = null
    # Create member access expression: (*ptr).field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = ExprKind.Member
    member.span.line = star_line
    member.span.col = star_col
    member.left = deref
    member.ident_ptr = field
    member.ident_len = field_len
    tok_span_back(p, field, @member.bracket)   # AGAST #3015
    member.next = null
    # Create index expression: (*ptr).field[idx]
    let indexed: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    indexed.kind = ExprKind.Index
    indexed.span.line = star_line
    indexed.span.col = star_col
    indexed.bracket.line = 0
    indexed.left = member
    indexed.right = idx
    indexed.next = null
    # Create binary expression: (*ptr).field[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = star_line
    binary.span.col = star_col
    binary_set_op(binary, op)
    binary.left = indexed
    binary.right = val
    binary.next = null
    # Create member index assignment
    return stmt_assign_member_index(p, ptr_expr, StrView { ptr: (field), len: (field_len) as i64 }, idx, binary, line, col)

# Compound assignment for local field: var.field op= val
pub fn stmt_compound_assign_local_field(p: *Parser, var_name_sv: StrView, field_sv: StrView, op: OpKind, val: *Expr, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    # Create identifier for variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = ExprKind.Ident
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = var_name
    ident.ident_len = var_len
    ident.next = null
    # Create member access: var.field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = ExprKind.Member
    member.span.line = line
    member.span.col = col
    member.left = ident
    member.ident_ptr = field
    member.ident_len = field_len
    tok_span_back(p, field, @member.bracket)   # AGAST #3015
    member.next = null
    # Create binary: var.field op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = member
    binary.right = val
    binary.next = null
    # Create local field assignment
    return stmt_assign_local_field(p, StrView { ptr: (var_name), len: (var_len) as i64 }, StrView { ptr: (field), len: (field_len) as i64 }, binary, line, col)

# Compound assignment for local field index: var.field[idx] op= val
pub fn stmt_compound_assign_local_field_index(p: *Parser, var_name_sv: StrView, field_sv: StrView, idx: *Expr, op: OpKind, val: *Expr, line: i32, col: i32) -> *Stmt
    var var_name: *u8 = var_name_sv.ptr
    var var_len: i32 = var_name_sv.len as i32
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    # Create identifier for variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = ExprKind.Ident
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = var_name
    ident.ident_len = var_len
    ident.next = null
    # Create member access: var.field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = ExprKind.Member
    member.span.line = line
    member.span.col = col
    member.left = ident
    member.ident_ptr = field
    member.ident_len = field_len
    tok_span_back(p, field, @member.bracket)   # AGAST #3015
    member.next = null
    # Create index expression: var.field[idx]
    let indexed: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    indexed.kind = ExprKind.Index
    indexed.span.line = line
    indexed.span.col = col
    indexed.bracket.line = 0
    indexed.left = member
    indexed.right = idx
    indexed.next = null
    # Create binary: var.field[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = indexed
    binary.right = val
    binary.next = null
    # Create local field index assignment
    return stmt_assign_local_field_index(p, StrView { ptr: (var_name), len: (var_len) as i64 }, StrView { ptr: (field), len: (field_len) as i64 }, idx, binary, line, col)

# Compound assignment for general expression: expr op= val
pub fn stmt_compound_assign_expr(p: *Parser, target: *Expr, op: OpKind, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create binary: target op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = ExprKind.Binary
    binary.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    binary.span.line = line
    binary.span.col = col
    binary_set_op(binary, op)
    binary.left = target
    binary.right = val
    binary.next = null
    # Create expression assignment
    return stmt_assign_expr(p, target, binary, line, col)

# =============================================================================
# One lvalue assignment (AGAST #1819)
# =============================================================================
#
# assign_stmt parses every non-name, non-`*` target as one `postfix_expr`;
# these two classify the parsed lvalue into the statement the grammar's
# twelve special-case alternatives used to build, with the same nodes and
# spans, so Sema and the emitter see an unchanged AST:
#
#   n[i]        StmtKind.IndexAssign             (stmt_assign_index)
#   v.f         StmtKind.LocalFieldAssign       (stmt_assign_local_field)
#   v.f[i]      StmtKind.LocalFieldIndexAssign (stmt_assign_local_field_index)
#   (*e).f      StmtKind.MemberAssign            (stmt_assign_member)
#   (*e).f[i]   StmtKind.MemberIndexAssign      (stmt_assign_member_index)
#   anything    StmtKind.Assign on the expression (stmt_assign_expr)
#
# `at` is the token index the lvalue starts at (assign_stmt's start_pos; the
# zero-width assign_pos wrapper was dropped in AGAST #4378).  The old
# alternatives matched tokens, so a shape counts only when its tokens are
# the ones they named: an IDENT (not `self`, which lexes as SELF), a field
# that is an IDENT (not `self` or a tuple's `0`), exactly one `(` before
# the `*`, and a plain `[expr]` index (not a slice's range).

# The position of the lvalue's first token.  assign_stmt used to reach it
# through a zero-width `assign_pos` grammar rule; it now passes start_pos
# directly (AGAST #4378).  Kept because the pre-#4378 generated parser, and
# any out-of-tree caller, still names it.
pub fn assign_pos(p: *Parser) -> i32
    p.pos

fn lv_tok(p: *Parser, at: i32, k: i32) -> *Token
    if at + k >= p.token_count
        return p.tokens + (p.token_count - 1)
    p.tokens + (at + k)

# A field name the old `DOT IDENT` matched: not `self`, not a digit.
fn lv_field_is_ident(e: *Expr) -> i32
    if e.ident_len < 1
        return 0
    let c: u8 = *e.ident_ptr
    if c >= '0' and c <= '9'
        return 0
    # `self`
    if e.ident_len == 4 and c == 's' and *(e.ident_ptr + 1) == 'e' and *(e.ident_ptr + 2) == 'l' and *(e.ident_ptr + 3) == 'f'
        return 0
    1

# A plain `[expr]` index, not a `[lo..hi]` / `[lo:hi]` slice.
fn lv_plain_index(e: *Expr) -> i32
    (e.kind == ExprKind.Index and (e.right == null or e.right.kind != ExprKind.Range)) as i32

# `v` of `v.f` / `v[i]`: an IDENT-token identifier at `at`.
fn lv_is_ident_at(p: *Parser, at: i32, e: *Expr) -> i32
    (e.kind == ExprKind.Ident and lv_tok(p, at, 0).kind == TOK_IDENT) as i32

# `(*e)` at `at`: one `(`, then the `*` the ExprKind.Unary is.
fn lv_is_paren_deref_at(p: *Parser, at: i32, e: *Expr) -> i32
    if e.kind != ExprKind.Unary or e.op != OpKind.Deref
        return 0
    (lv_tok(p, at, 0).kind == TOK_LPAREN and lv_tok(p, at, 1).kind == TOK_STAR) as i32

# `lhs = val`: classify, then build what the matching alternative built.
# op 0 is plain `=`; otherwise the compound `op=` (compound_op's OP_*).
pub fn stmt_assign_lvalue(p: *Parser, at: i32, lhs: *Expr, op: OpKind, val: *Expr) -> *Stmt
    let t0: *Token = lv_tok(p, at, 0)
    # n[i]
    if lv_plain_index(lhs) == 1 and lv_is_ident_at(p, at, lhs.left) == 1
        let n: *Expr = lhs.left
        if op == OpKind.Unset
            return stmt_assign_index(p, StrView { ptr: (n.ident_ptr), len: (n.ident_len) as i64 }, lhs.right, val, t0.line, t0.col, lhs.bracket.line, lhs.bracket.col)
        return stmt_compound_assign_index(p, StrView { ptr: (n.ident_ptr), len: (n.ident_len) as i64 }, lhs.right, op, val, t0.line, t0.col, lhs.bracket.line, lhs.bracket.col)
    # v.f
    if lhs.kind == ExprKind.Member and lv_is_ident_at(p, at, lhs.left) == 1 and lv_tok(p, at, 2).kind == TOK_IDENT
        let v: *Expr = lhs.left
        if op == OpKind.Unset
            return stmt_assign_local_field(p, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 }, StrView { ptr: (lhs.ident_ptr), len: (lhs.ident_len) as i64 }, val, t0.line, t0.col)
        return stmt_compound_assign_local_field(p, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 }, StrView { ptr: (lhs.ident_ptr), len: (lhs.ident_len) as i64 }, op, val, t0.line, t0.col)
    # v.f[i]
    if lv_plain_index(lhs) == 1 and lhs.left.kind == ExprKind.Member and lv_is_ident_at(p, at, lhs.left.left) == 1 and lv_tok(p, at, 2).kind == TOK_IDENT
        let m: *Expr = lhs.left
        let v: *Expr = m.left
        if op == OpKind.Unset
            return stmt_assign_local_field_index(p, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 }, StrView { ptr: (m.ident_ptr), len: (m.ident_len) as i64 }, lhs.right, val, t0.line, t0.col)
        return stmt_compound_assign_local_field_index(p, StrView { ptr: (v.ident_ptr), len: (v.ident_len) as i64 }, StrView { ptr: (m.ident_ptr), len: (m.ident_len) as i64 }, lhs.right, op, val, t0.line, t0.col)
    # (*e).f
    if lhs.kind == ExprKind.Member and lv_is_paren_deref_at(p, at, lhs.left) == 1 and lv_field_is_ident(lhs) == 1
        let d: *Expr = lhs.left
        if op == OpKind.Unset
            return stmt_assign_member(p, d.operand, StrView { ptr: (lhs.ident_ptr), len: (lhs.ident_len) as i64 }, val, t0.line, t0.col)
        return stmt_compound_assign_member(p, d.operand, StrView { ptr: (lhs.ident_ptr), len: (lhs.ident_len) as i64 }, op, val, t0.line, t0.col, d.span.line, d.span.col)
    # (*e).f[i]
    if lv_plain_index(lhs) == 1 and lhs.left.kind == ExprKind.Member and lv_is_paren_deref_at(p, at, lhs.left.left) == 1 and lv_field_is_ident(lhs.left) == 1
        let m: *Expr = lhs.left
        let d: *Expr = m.left
        if op == OpKind.Unset
            return stmt_assign_member_index(p, d.operand, StrView { ptr: (m.ident_ptr), len: (m.ident_len) as i64 }, lhs.right, val, t0.line, t0.col)
        return stmt_compound_assign_member_index(p, d.operand, StrView { ptr: (m.ident_ptr), len: (m.ident_len) as i64 }, lhs.right, op, val, t0.line, t0.col, d.span.line, d.span.col)
    if op == OpKind.Unset
        return stmt_assign_expr(p, lhs, val, lhs.span.line, lhs.span.col)
    return stmt_compound_assign_expr(p, lhs, op, val, lhs.span.line, lhs.span.col)

# Helper to convert compound assignment token to binary operator
pub fn compound_tok_to_op(tok: i32) -> OpKind
    if tok == TOK_PLUS_EQ
        return OpKind.Add
    if tok == TOK_MINUS_EQ
        return OpKind.Sub
    if tok == TOK_STAR_EQ
        return OpKind.Mul
    if tok == TOK_SLASH_EQ
        return OpKind.Div
    # LARB R63 (AGAST #3486): the _WRAP code; binary_set_op splits it.
    if tok == TOK_PLUSPCT_EQ
        return OpKind.AddWrap
    if tok == TOK_MINUSPCT_EQ
        return OpKind.SubWrap
    if tok == TOK_STARPCT_EQ
        return OpKind.MulWrap
    return OpKind.Unset

# Helper to check if token is a compound assignment operator
pub fn is_compound_assign_tok(tok: i32) -> i32
    if tok == TOK_PLUS_EQ
        return 1
    if tok == TOK_MINUS_EQ
        return 1
    if tok == TOK_STAR_EQ
        return 1
    if tok == TOK_SLASH_EQ
        return 1
    if tok == TOK_PLUSPCT_EQ
        return 1
    if tok == TOK_MINUSPCT_EQ
        return 1
    if tok == TOK_STARPCT_EQ
        return 1
    return 0

pub fn stmt_expr(p: *Parser, e: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Expr
    s.span.line = line
    s.span.col = col
    s.expr = e
    s.next = null
    return s

pub fn stmt_link(first: *Stmt, rest: *Stmt) -> *Stmt
    first.next = rest
    return first

# =============================================================================
# Expression helpers
# =============================================================================

pub fn expr_int(p: *Parser, val: i64, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.IntLit
    e.span.line = line
    e.span.col = col
    e.int_val = val
    e.lit_kind = LIT_PLAIN
    e.ident_ptr = null      # no overflowed source text (expr_int_lit)
    e.ident_len = 0
    e.next = null
    return e

# `true` is the integer 1 to everything but tail_value.ritz, which needs it to
# judge `while true` (AGAST #2236), and bool_check.ritz.
pub fn expr_true(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 1, line, col)
    e.lit_kind = LIT_TRUE
    return e

# `false` is the integer 0 to everything but bool_check.ritz (AGAST #2342).
pub fn expr_false(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_FALSE
    return e

# `pass` in expression position is the integer 0 to everything but
# tail_value.ritz, where it is the absence of a value (AGAST #2236).
# AGAST #3320: `pass` is an identifier (LANGUAGE_SPEC §2), so it lexes as
# IDENT and names fns, params, locals and fields like any other.  As ritz0
# reads it, a bare `pass` is the binding of that name when one is in scope,
# and otherwise the no-op.  ctx.pass_bound is "the fn being parsed binds `pass`"
# (a param or a let/var/for), set as each binding is parsed and cleared at
# the fn's end, so it covers the reads after the binding.  It is per fn, not
# per block: a no-op `pass` after an inner block's `let pass` reads as the
# out-of-scope name.
# State: ParseCtx.pass_bound

fn is_pass_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4 and name != null and *name == 'p' and *(name + 1) == 'a' and *(name + 2) == 's' and *(name + 3) == 's'
        return 1
    return 0

pub fn note_pass_binding(ctx: *ParseCtx, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if is_pass_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        ctx.pass_bound = 1

# Grammar action for a `for` variable: noted before the body is parsed, which
# stmt_for's action (after the body) would be too late for.
pub fn for_var_name(ctx: *ParseCtx, tok: Token) -> Token
    note_pass_binding(ctx, StrView { ptr: (tok.start), len: (tok.len) as i64 })
    return tok

# A primary with no postfix ops (apply_postfix_p): a bare `pass` with no
# binding of that name in the fn is the no-op.  `pass(2)`, `s.pass` and a
# bound `pass` stay identifiers.
fn pass_or_ident(p: *Parser, e: *Expr) -> *Expr
    if e.kind == ExprKind.Ident and p.ctx.pass_bound == 0 and is_pass_name(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
        return expr_pass(p, e.span.line, e.span.col)
    return e

pub fn expr_pass(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_PASS
    return e

# `()` in expression position (AGAST #2272): integer 0 marked LIT_UNIT, as
# `pass` is.  A variant ctor stores no payload for it (`Ok(())`), so the 0
# never reaches a unit payload's zero bytes.
pub fn expr_unit(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_UNIT
    return e

# Is `e` the unit value `()`?
pub fn is_unit_expr(e: *Expr) -> i32
    if e == null
        return 0
    (e.kind == ExprKind.IntLit and e.lit_kind == LIT_UNIT) as i32

# Float literal — store the raw source bytes (digits + dot) in
# string_ptr/string_len so the emitter can re-parse to the right LLVM
# constant.  Default kind context (f32 vs f64) is decided by surrounding
# type info at use-site; the literal itself just carries the digits.
pub fn expr_float(p: *Parser, src_sv: StrView, line: i32, col: i32) -> *Expr
    var src: *u8 = src_sv.ptr
    var len: i32 = src_sv.len as i32
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.FloatLit
    e.span.line = line
    e.span.col = col
    e.string_ptr = src as *u8
    e.string_len = len
    e.next = null
    # AGAST #1615: a `f32` / `f64` suffix (absorbed by the lexer) types the
    # literal: `2.5f32` is `2.5 as f32`, as in ritz0. The digits keep their
    # own slot so the emitter never sees the suffix.
    if len > 3 and *(src + len - 3) == 'f'  # 'f'
        let s1: u8 = *(src + len - 2)
        let s2: u8 = *(src + len - 1)
        var sfx: TypeKind = TypeKind.Void
        if s1 == 51 and s2 == 50  # "32"
            sfx = TypeKind.F32
        else if s1 == 54 and s2 == 52  # "64"
            sfx = TypeKind.F64
        if sfx != TypeKind.Void
            e.string_len = len - 3
            float_text_with_point(p, e)
            let c: *Expr = expr_cast(p, e, sfx, TypeKind.Void)
            c.cast_pointee = TypeKind.Void
            return c
    float_text_with_point(p, e)
    return e

# AGAST #3929: the emitter writes a float literal's text into the IR as is,
# and LLVM reads a decimal float only with a `.` in it: `1e-5` is no LLVM
# constant.  An exponent literal with no fraction gets one, `1.0e-5`, in a
# copy (the same value); every other literal keeps its source bytes.
fn float_text_with_point(p: *Parser, e: *Expr)
    let src: *u8 = e.string_ptr
    let len: i32 = e.string_len
    var at: i32 = 0
    while at < len and *(src + at) != 'e' and *(src + at) != 'E'   # e E
        if *(src + at) == '.'                                       # .
            return
        at = at + 1
    if at == len
        return
    let out: *u8 = parser_alloc(p, (len + 2) as i64) as *u8
    var i: i32 = 0
    while i < at
        *(out + i) = *(src + i)
        i = i + 1
    *(out + at) = 46                                               # .
    *(out + at + 1) = 48                                           # 0
    while i < len
        *(out + i + 2) = *(src + i)
        i = i + 1
    e.string_ptr = out
    e.string_len = len + 2

pub fn expr_string(p: *Parser, tok: Token) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    # Distinguish c"..." / "..." based on lexer token kind. Kept in separate
    # AST nodes so the emitter types each one correctly:
    #   c"..."  (TOK_CSTRING)  -> *u8  (null-terminated)
    #   "..."   (TOK_STRING)   -> StrView { ptr, len }   (AGAST #98)
    # (s"..." / TOK_SSTRING was removed in AGAST #98.)
    if tok.kind == TOK_CSTRING
        e.kind = ExprKind.CstringLit
    else
        e.kind = ExprKind.StringLit
    e.span.line = tok.line
    e.span.col = tok.col
    # Use cooked string from lexer (escapes already processed)
    e.string_ptr = tok.string_val as *u8
    e.string_len = tok.string_len
    # AGAST #1521: also keep the RAW token text, quotes included. print's
    # interpolation splits the raw text, because the cooked text cannot tell
    # `\{x}` (a literal brace) from `{x}` (a placeholder). See
    # emitter_print.ritz. Nothing else reads these slots on a string literal.
    e.ident_ptr = tok.start
    e.ident_len = tok.len
    e.next = null
    return e

# The byte a TOK_CHAR token denotes, its escapes cooked.  One reader for both
# a char expression and a char pattern, so `'\x41' =>` is the int `'A' =>` is.
pub fn char_token_value(tok: Token) -> i64
    # Token format: 'x' or '\n' etc.
    let src: *u8 = tok.start
    if tok.len == 3
        # Simple char: 'x'
        return *(src + 1) as i64
    if tok.len >= 4
        # Escaped char: '\n', '\\', '\e', '\x1B' ...  The lexer already rejected
        # a bad escape (AGAST #1978, #1872), so the shared table always cooks.
        return lexer_cook_escape_at(src + 2, (tok.len - 3) as i64, 1) as i64
    0

pub fn expr_char(p: *Parser, tok: Token) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.CharLit
    e.span.line = tok.line
    e.span.col = tok.col
    e.int_val = char_token_value(tok)
    e.next = null
    return e

pub fn expr_nil(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.NilLit
    e.span.line = line
    e.span.col = col
    e.int_val = 0
    e.next = null
    return e

pub fn expr_ident(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Ident
    e.span.line = line
    e.span.col = col
    e.ident_ptr = name as *u8
    e.ident_len = len
    e.next = null
    return e

# `op` on an ExprKind.Binary, unwrapping a parser-side _WRAP code (LARB R63,
# AGAST #3486): `+%` is `OpKind.Add` with Expr.wrapping set, and so for `-%` and
# `*%`.  Every rule for `+` then applies unchanged; only the wider-slot walk
# and the integer-operand check read the flag.
fn binary_set_op(e: *Expr, op: OpKind)
    match op
        OpKind.AddWrap =>
            e.op = OpKind.Add
            e.wrapping = 1
        OpKind.SubWrap =>
            e.op = OpKind.Sub
            e.wrapping = 1
        OpKind.MulWrap =>
            e.op = OpKind.Mul
            e.wrapping = 1
        _ =>
            e.op = op

pub fn expr_binary(p: *Parser, op: OpKind, left: *Expr, right: *Expr) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Binary
    e.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    # Inherit span from left operand
    e.span.line = left.span.line
    e.span.col = left.span.col
    binary_set_op(e, op)
    e.left = left
    e.right = right
    e.next = null
    return e

pub fn expr_unary(p: *Parser, op: OpKind, operand: *Expr, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Unary
    e.span.line = line
    e.span.col = col
    e.op = op
    e.operand = operand
    e.next = null
    return e

pub fn expr_cast(p: *Parser, left: *Expr, target_type: TypeKind, cast_pointee: TypeKind) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Cast
    e.span = left.span
    e.left = left
    e.type_kind = target_type
    e.cast_pointee = cast_pointee
    e.cast_array = null
    e.cast_ptr_array = null
    e.fn_sig = null
    e.int_val = 0
    e.cast_ptr_kind = (TypeKind.Void as i32)
    e.ident_ptr = null
    e.ident_len = 0
    e.bracket.line = 0   # no `as` written (AGAST #3040)
    e.bracket.col = 0
    e.next = null
    return e

# ExprKind.TypeOperand (AGAST #2124): `count` values of leaf kind `t` (struct
# `name` when t == TypeKind.Struct).
pub fn expr_type_operand(p: *Parser, count: i64, t: TypeKind, name_sv: StrView, line: i32, col: i32) -> *Expr
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.TypeOperand
    e.span.line = line
    e.span.col = col
    e.int_val = count
    e.type_kind = t
    e.ident_ptr = null
    e.ident_len = 0
    if t == TypeKind.Struct
        e.ident_ptr = name
        e.ident_len = name_len
    e.next = null
    return e

# `sizeof([N]..T)` (AGAST #2124): an array type is no expression, so the
# grammar reads `IDENT ( [N] type_spec )` here.  Any callee but `sizeof`
# rejects (p.error) — `f([8]u8)` is not a program.  type_array_expr builds the
# whole `[N]..T` TypeRef; type_facts reads its shape.
pub fn sizeof_array_type_call(p: *Parser, name_tok: Token, lbracket: Token, len_expr: *Expr, elem: *TypeRef) -> *Expr
    if name_tok.len != 6 or memcmp(name_tok.start, c"sizeof", 6) != 0
        p.error = 1
        return null
    # AGAST #2167: any constant length, folded as a declaration's is.
    let t: *TypeRef = type_array_expr(p, len_expr, lbracket.line, lbracket.col, elem)
    let facts: *TypeFacts = type_facts(p, t)
    var count: i64 = facts.array_size as i64
    var leaf: TypeKind = facts.array_elem_type
    var leaf_name: *u8 = facts.array_elem_type_name
    var leaf_len: i32 = facts.array_elem_type_name_len
    let sh: *ArrayShape = facts.array_shape
    if sh != null
        count = 1
        var d: i32 = 0
        while d < sh.rank
            count = count * (sh.dims[d] as i64)
            d = d + 1
        leaf = sh.leaf_type
        leaf_name = sh.leaf_name
        leaf_len = sh.leaf_name_len
    let arg: *Expr = expr_type_operand(p, count, leaf, StrView { ptr: (leaf_name), len: (leaf_len) as i64 }, lbracket.line, lbracket.col)
    return expr_call(p, StrView { ptr: (name_tok.start), len: (name_tok.len) as i64 }, arg, name_tok.line, name_tok.col)

# `sizeof(Box<i64>)` (AGAST #3268): a generic instance as sizeof's operand.
# The grammar reads `IDENT ( IDENT < generic_args )`; any callee but `sizeof`
# rejects, as for sizeof_array_type_call.  The operand is one value of the
# struct type_spec would name: the same mangled "Box$i64".
pub fn sizeof_generic_type_call(p: *Parser, name_tok: Token, base_tok: Token, ga: *GenericArg) -> *Expr
    if name_tok.len != 6 or memcmp(name_tok.start, c"sizeof", 6) != 0
        p.error = 1
        return null
    let t: *TypeRef = type_generic_with_saved(p, StrView { ptr: (base_tok.start), len: (base_tok.len) as i64 }, ga)
    let facts: *TypeFacts = type_facts(p, t)
    let arg: *Expr = expr_type_operand(p, 1, facts.kind, StrView { ptr: (facts.type_name), len: (facts.type_name_len) as i64 }, base_tok.line, base_tok.col)
    return expr_call(p, StrView { ptr: (name_tok.start), len: (name_tok.len) as i64 }, arg, name_tok.line, name_tok.col)

pub fn expr_call(p: *Parser, name_sv: StrView, args: *Expr, line: i32, col: i32) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Call
    e.span.line = line
    e.span.col = col
    e.func_name = name as *u8
    e.func_name_len = len
    e.args = args
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.next = null
    return e

# Generic function call: name<type>(args) -> mangled_name(args)
# Mangles the function name like type_generic does for types
pub fn expr_generic_call(p: *Parser, name_sv: StrView, type_arg: *TypeRef, args: *Expr, line: i32, col: i32) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ta: TypeKind = tr_kind(type_arg)
    var tn_len: i32 = 0
    let tn: *u8 = tr_name(type_arg, @tn_len)
    # Build mangled name: name$type (e.g., vec_new$u8)
    # name + '$' + type suffix + NUL.  A struct type can be as long as its
    # parsed name; primitives add at most 3 chars ("i32").
    var suffix_cap: i32 = 3
    if ta == TypeKind.Struct
        suffix_cap = tn_len
    var mangled: *u8 = parser_alloc(p, (len + 1 + suffix_cap + 1) as i64) as *u8
    var pos: i32 = 0

    # Copy function name
    for i in 0..len
        *(mangled + pos) = *(name + i)
        pos = pos + 1

    # Add "$" separator
    *(mangled + pos) = 36  # '$'
    pos = pos + 1

    # Add type argument name based on type
    match ta
        TypeKind.U8 =>
            *(mangled + pos) = 117  # 'u'
            pos = pos + 1
            *(mangled + pos) = 56   # '8'
            pos = pos + 1
        TypeKind.I8 =>
            *(mangled + pos) = 105  # 'i'
            pos = pos + 1
            *(mangled + pos) = 56   # '8'
            pos = pos + 1
        TypeKind.I32 =>
            *(mangled + pos) = 105  # 'i'
            pos = pos + 1
            *(mangled + pos) = 51   # '3'
            pos = pos + 1
            *(mangled + pos) = 50   # '2'
            pos = pos + 1
        TypeKind.I64 =>
            *(mangled + pos) = 105  # 'i'
            pos = pos + 1
            *(mangled + pos) = 54   # '6'
            pos = pos + 1
            *(mangled + pos) = 52   # '4'
            pos = pos + 1
        TypeKind.Struct =>
            # Generic type or struct - use the parsed type's name
            for i in 0..tn_len
                *(mangled + pos) = *(tn + i)
                pos = pos + 1
        _ => pass

    # Create call expression with mangled name
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Call
    e.span.line = line
    e.span.col = col
    e.func_name = mangled
    e.func_name_len = pos
    e.args = args
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.next = null
    return e

pub fn expr_link(first: *Expr, rest: *Expr) -> *Expr
    first.next = rest
    return first

# Array literal: [e1, e2, ...]
# Stores the linked element list in `args` (parse_args already returns one).
# This kind is currently parser-only — emit_expr falls through to its
# unknown-kind branch. For const arrays this is harmless because the emitter
# inlines const values via find_const, never re-walking the original Expr.
pub fn expr_array(p: *Parser, head: *Expr, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.ArrayLit
    e.span.line = line
    e.span.col = col
    e.args = head
    e.int_val = 0
    e.next = null
    return e

# Array fill literal: `[value; N]` — repeated initializer (AGAST #178).
# Stores the value expression in `left`; the count is extracted from the
# count token directly (the grammar matches NUMBER, not a generic expr, to
# keep parity with ritz0 and avoid having to constant-fold here).
pub fn expr_array_fill(p: *Parser, value: *Expr, count_start_sv: StrView, line: i32, col: i32) -> *Expr
    var count_start: *u8 = count_start_sv.ptr
    var count_len: i32 = count_start_sv.len as i32
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.ArrayFill
    e.span.line = line
    e.span.col = col
    e.left = value
    e.int_val = parse_int(StrView { ptr: (count_start), len: (count_len) as i64 })
    e.next = null
    return e

# =============================================================================
# Binary operation chain helpers (for left-factored grammar)
# =============================================================================

pub fn binary_op_new(p: *Parser, op: OpKind, right: *Expr, next: *BinaryOp) -> *BinaryOp
    let b: *BinaryOp = parser_alloc(p, sizeof(BinaryOp)) as *BinaryOp
    b.op = op
    b.right = right
    b.next = next
    return b

# Apply binary operation chain with parser for allocations
pub fn apply_binary_opt_p(p: *Parser, left: *Expr, chain: *BinaryOp) -> *Expr
    if chain == null
        return left

    var result: *Expr = left
    var op: *BinaryOp = chain
    while op != null
        result = expr_binary(p, op.op, result, op.right)
        op = op.next
    return result

# =============================================================================
# Cast tail helpers (for cast expression parsing)
# =============================================================================

pub fn cast_tail_new(p: *Parser, tr: *TypeRef, next: *CastTail, as_line: i32, as_col: i32) -> *CastTail
    let ct: *CastTail = parser_alloc(p, sizeof(CastTail)) as *CastTail
    let ty: TypeKind = tr_kind(tr)
    let f: *TypeFacts = type_facts(p, tr)
    ct.cast_type = ty
    ct.next = next
    ct.as_at.line = as_line
    ct.as_at.col = as_col
    ct.cast_pointee = f.pointee_type
    # AGAST #2120: `as EfiFn` keeps the signature (with the alias's
    # [[callconv]]).  Only the outermost cast (next == null) takes it.
    ct.fn_sig = null
    if next == null and ty == TypeKind.Ptr
        ct.fn_sig = f.fn_sig
    ct.array = null
    if next == null and ty == TypeKind.Array
        ct.array = array_elem_of_type(p, tr)
    # AGAST #4122: `as *[N][M]..T` keeps its shape, as a `*[N][M]..T` return does.
    # AGAST #4154: and `as *[N]T` its element's name, for the `p#` view of a
    # `let p = x as *[N]S` (inferred_array_elem_name reads it via base_ptr_array).
    ct.ptr_array = null
    if next == null and ty == TypeKind.Ptr and f.pointee_type == TypeKind.Array
        ct.ptr_array = ptr_array_of_type(p, tr)
    ct.pointee_type = (TypeKind.Void as i32)
    ct.pointee_name = null
    ct.pointee_name_len = 0
    # AGAST #1453: record the pointee of `as *T` for the outermost cast only —
    # earlier tails stay unknown rather than pick up a later type's name.
    if next == null and ty == TypeKind.Ptr
        ct.pointee_type = (f.pointee_type as i32)
        if f.pointee_type == TypeKind.Struct
            ct.pointee_name = f.type_name
            ct.pointee_name_len = f.type_name_len
    # AGAST #3443: and the struct of `as @S` / `as @&S`.
    if next == null and (ty == TypeKind.Ref or ty == TypeKind.MutRef) and f.ref_inner_type == TypeKind.Struct
        ct.pointee_type = (TypeKind.Struct as i32)
        ct.pointee_name = f.type_name
        ct.pointee_name_len = f.type_name_len
    # AGAST #3757: and the scalar of `as @T` / `as @&T` (`(p as @&i32)[i] = v`
    # strides by it).
    if next == null and (ty == TypeKind.Ref or ty == TypeKind.MutRef) and primitive_name_len(f.ref_inner_type) > 0
        ct.pointee_type = (f.ref_inner_type as i32)
    # AGAST #2288: and the struct of `as C`, so `c as C` with `c:& C` can
    # read the referent.  pointee_type stays TypeKind.Void: there's no pointee.
    if next == null and ty == TypeKind.Struct
        ct.pointee_name = f.type_name
        ct.pointee_name_len = f.type_name_len
    # AGAST #2544: and of `as **S` (`***S`, ...): pointee_type is the packed
    # inner-pointee slot a `**S` local records (ptr_ptr_inner_pointee).
    if next == null and ty == TypeKind.PtrPtr
        ct.pointee_type = ptr_ptr_inner_pointee(p, tr)
        if ptr_ptr_slot_inner(ct.pointee_type) == TypeKind.Struct
            ct.pointee_name = f.type_name
            ct.pointee_name_len = f.type_name_len
    return ct

# AGAST #3435: the grammar's block_ended.  Matches nothing, and fails unless
# the token before p.pos is a DEDENT: a block operand (`5 + match x` + its
# arms) has ended, and the next line, whatever it starts with, is a new
# statement (§2.2).  Each operator tail tries it first, so it ends there.
pub fn block_ended_check(p: *Parser) -> i32
    if p.pos == 0 or (p.tokens + (p.pos - 1)).kind != TOK_DEDENT
        p.error = 1
    0

# AGAST #4543, #4553, #4049: where the last block `if` / `match` built as an
# expression operand ended (the token index after its DEDENT), or -1.  A
# statement whose value expression ends in that block has no NEWLINE after
# it — the block consumed the DEDENT — so the statement's terminator is
# `open_if_ended`, not `expr NEWLINE`.  Every operand form records it:
# else-less `if` (expr_if_open, #4543), `if`/`else` (expr_if_operand, #4553)
# and `match` (expr_match_operand, #4049).  Keyed by position, so a node
# built by a speculative alternative over different tokens cannot satisfy it.
# State: ParseCtx.open_if_end

pub fn open_if_note(ctx: *ParseCtx, end: i32)
    ctx.open_if_end = end

# The grammar's open_if_ended: matches nothing and fails unless this is
# exactly where a block operand ended.  A block operand (`5 + if c` + its
# body, AGAST #4543; `5 + if c` + body + `else` + body, #4553; `5 + match c`
# + its arms, #4049) ends the statement here.
pub fn open_if_ended_check(p: *Parser) -> i32
    if p.pos != p.ctx.open_if_end or p.pos == 0 or (p.tokens + (p.pos - 1)).kind != TOK_DEDENT
        p.error = 1
    0

# The grammar's else_absent: fails when an `else` follows, so the else-less
# alternatives in if_expr_rhs / primary_expr do not claim a block `if` that
# has one.  The form with an `else` is the first alternative and wins when it
# parses; this keeps a malformed one failing where it did (AGAST #4543).
pub fn else_absent_check(p: *Parser) -> i32
    if p.pos < p.token_count and (p.tokens + p.pos).kind == TOK_ELSE
        p.error = 1
    0

# AGAST #3124: the grammar's cast_type_end.  A cast's type is never followed
# by an operand, so one there means the type ran on into a comparison
# (`a as Sz < b, c > d` read as `Sz<b, c>`): fail, and cast_type retries the
# bare name.  ritz0's _OPERAND_START is the same set.
pub fn cast_type_end_check(p: *Parser) -> i32
    if p.pos < p.token_count
        let k: i32 = (p.tokens + p.pos).kind
        if k == TOK_IDENT or k == TOK_NUMBER or k == TOK_FLOAT or k == TOK_STRING
            p.error = 1
        else if k == TOK_CSTRING or k == TOK_CHAR or k == TOK_TRUE or k == TOK_FALSE
            p.error = 1
        else if k == TOK_NULL or k == TOK_NIL or k == TOK_SELF or k == TOK_LPAREN
            p.error = 1
        else if k == TOK_LBRACKET or k == TOK_AT or k == TOK_NOT or k == TOK_BANG or k == TOK_TILDE
            p.error = 1
    # AGAST #4021: a cast's type is noted; one that ran on into a comparison
    # drops the arguments it noted.
    if p.error != 0
        tn_drop_after_as(p)
    else
        tn_note_last(p, 1)
    return 0

pub fn apply_cast_tail(p: *Parser, expr: *Expr, tail: *CastTail) -> *Expr
    if tail == null
        return expr
    var result: *Expr = expr
    var ct: *CastTail = tail
    while ct != null
        result = expr_cast(p, result, ct.cast_type, ct.cast_pointee)
        result.cast_ptr_kind = ct.pointee_type
        result.ident_ptr = ct.pointee_name
        result.ident_len = ct.pointee_name_len
        result.fn_sig = ct.fn_sig
        result.cast_array = ct.array
        result.cast_ptr_array = ct.ptr_array   # AGAST #4122
        result.bracket = ct.as_at   # AGAST #3040
        ct = ct.next
    return result

# =============================================================================
# Postfix operation helpers
# =============================================================================

pub fn postfix_call(p: *Parser, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # #4035: the parser never records a call type suffix (it was always null),
    # so nothing carries one here.
    op.call_type_suffix = null
    op.call_type_suffix_len = 0
    op.next = null
    return op

# Generic function call - creates a call with type suffix from the type token
# The type_tok is the token for the type name (e.g., "u8", "String", etc.)
# Builds a suffix like "$u8" to be appended to the function name
# A generic call's one-token type argument (`g<Nope>`, `g<*Nope>`) as a
# GenericArg that only says where it is written (AGAST #3469).
fn generic_tok_arg(p: *Parser, tok: Token) -> *GenericArg
    let ga: *GenericArg = parser_alloc(p, sizeof(GenericArg)) as *GenericArg
    ga.ty = TypeKind.Void
    ga.name = null
    ga.name_len = 0
    ga.next = null
    ga.written = tok.start
    ga.written_len = tok.len
    ga.at = diag_span(tok.line, tok.col)
    ga

pub fn postfix_generic_call(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # Type suffix: "$" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    tn_note_tok(p, type_tok)   # AGAST #4171
    op.call_type_suffix = generic_tok_suffix(p, StrView { ptr: (null), len: (0) as i64 }, type_tok, @len)
    op.call_type_suffix_len = len
    op.call_targs = generic_tok_arg(p, type_tok)
    op.next = null
    return op

# Pointer-typed generic call (AGAST #186): `option_is_none<*Page>(@p)` builds
# a mangled suffix of `$ptr_Page` matching ritz0's name mangling so cross-
# module symbols line up.  Without this rule the parser silently dropped the
# enclosing fn definition (parse_item's anchor-skip recovery), and downstream
# the call fell through to `call i64 @<name>(...)` while the surrounding
# `ret %Option$` kept the struct type — clang IR verifier then rejected the
# i64-into-struct mismatch (mausoleum/concurrent_bench, btree_scan path).
pub fn postfix_generic_call_ptr(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # Type suffix: "$ptr_" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    tn_note_tok(p, type_tok)   # AGAST #4171
    op.call_type_suffix = generic_tok_suffix(p, StrView { ptr: (c"ptr_"), len: (4) as i64 }, type_tok, @len)
    op.call_type_suffix_len = len
    op.call_targs = generic_tok_arg(p, type_tok)
    op.next = null
    return op

# Generic call whose type argument is a full type_spec rather than a single
# token — `vec_new<Vec<i64>>()` (AGAST #1300).  Suffix is "$" + the argument's
# mangled name ("$Vec$i64"), or its primitive spelling for a primitive.
pub fn postfix_generic_call_arg(p: *Parser, ga: *GenericArg, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    tn_note_args(p, ga)   # AGAST #4171
    # "" + "$" + arg → "$<arg>", from the same speller as type annotations.
    var len: i32 = 0
    op.call_type_suffix = mangle_generic_args(p, StrView { ptr: (null), len: (0) as i64 }, ga, @len)
    op.call_type_suffix_len = len
    op.call_targs = ga
    op.next = null
    return op

# Is this captured type argument spelled like a VALUE — a bare lowercase
# identifier such as `b` in `f(a < b, c > (d))`?  Types are primitive
# keywords (lexed as their own tokens, never TypeKind.Struct), PascalCase names,
# or lowercase primitives that lex as IDENT but type_named turns into their
# own kinds (f32/f64; usize/isize, AGAST #2198).  A generic instantiation's
# captured name contains '$' and is a type whatever its case.
fn generic_arg_is_value_like(ga: *GenericArg) -> i32
    if ga.ty != TypeKind.Struct or ga.name == null or ga.name_len <= 0
        return 0
    let c0: u8 = *ga.name
    if c0 != '_' and (c0 < 'a' or c0 > 'z')  # not '_' and not 'a'..'z'
        return 0
    for i in 0..ga.name_len
        if *(ga.name + i) == '$'  # '$'
            return 0
    return 1

# Generic call with a full type-argument list (AGAST #1612): `second<i64,
# i32>(a, b)` → suffix "$i64$i32", the same per-argument mangling as generic
# struct types (#1574) and ritz0's fn instantiation names.
#
# `f(a < b, c > (d))` produces the same token stream.  A single-argument list
# is always a call (unchanged since #1300).  A list of two or more is a call
# unless an argument is value-like (generic_arg_is_value_like); then this
# action fails — p.error = 1 makes postfix_ops backtrack to before the `<`,
# which then parses as a comparison.  ritz0 differs here: it takes any list
# followed by `(` as type arguments (test_ritz1_multi_arg_generic_call.py).
pub fn postfix_generic_call_list(p: *Parser, ga: *GenericArg, args: *Expr) -> *PostfixOp
    if ga.next == null
        return postfix_generic_call_arg(p, ga, args)
    var cur: *GenericArg = ga
    while cur != null
        if generic_arg_is_value_like(cur) == 1
            p.error = 1
            return null
        cur = cur.next
    tn_note_args(p, ga)   # AGAST #4171: a call, not a comparison
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    var len: i32 = 0
    op.call_type_suffix = mangle_generic_args(p, StrView { ptr: (null), len: (0) as i64 }, ga, @len)
    op.call_type_suffix_len = len
    op.call_targs = ga
    op.next = null
    return op

pub fn postfix_index(p: *Parser, index: *Expr, line: i32, col: i32) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_INDEX
    op.index = index
    op.bracket.line = line
    op.bracket.col = col
    op.next = null
    return op

pub fn postfix_member(p: *Parser, name_sv: StrView) -> *PostfixOp
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_MEMBER
    op.member_name = name as *u8
    op.member_len = len
    tok_span_back(p, name, @op.bracket)   # AGAST #3015: the field name's place
    op.next = null
    return op

pub fn postfix_cast(p: *Parser, ty: TypeKind) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CAST
    op.cast_type = ty
    op.next = null
    return op

pub fn postfix_link(first: *PostfixOp, rest: *PostfixOp) -> *PostfixOp
    first.next = rest
    return first

# Old apply_postfix kept for reference - use apply_postfix_p instead
pub fn apply_postfix(base: *Expr, ops: *PostfixOp) -> *Expr
    return base

# Apply postfix operations with parser for allocation
pub fn apply_postfix_p(p: *Parser, base: *Expr, ops: *PostfixOp) -> *Expr
    if ops == null
        return pass_or_ident(p, base)

    # Apply each postfix operation, creating new expression nodes
    var result: *Expr = base
    var op: *PostfixOp = ops
    while op != null
        if op.kind == POSTFIX_CALL
            # Create call expression
            match result.kind
                ExprKind.Ident =>
                    # Modify ident to call in place (ident becomes call target)
                    result.kind = ExprKind.Call
                    result.func_name = result.ident_ptr
                    result.func_name_len = result.ident_len
                    # Copy type suffix for generic calls (e.g., "$u8" for vec_new<u8>())
                    result.call_type_suffix = op.call_type_suffix
                    result.call_type_suffix_len = op.call_type_suffix_len
                    result.args = op.args
                    if op.call_type_suffix != null and p.skip_item == 0
                        generic_use_note(p.ctx, StrView { ptr: (result.func_name), len: (result.func_name_len) as i64 }, StrView { ptr: (op.call_type_suffix), len: (op.call_type_suffix_len) as i64 }, op.call_targs, diag_span(0, 0), parse_file_copy_shared(p))
                ExprKind.Member =>
                    # Method call: expr.method(args)
                    # ExprKind.Member has: left = receiver, ident_ptr/len = method name
                    # Convert to ExprKind.Method by changing kind and adding args
                    result.kind = ExprKind.Method
                    result.args = op.args
                    # left and ident_ptr/ident_len are already set from POSTFIX_MEMBER
                _ =>
                    # AGAST #1747: a call through any other callee (`fs[1](3)`,
                    # `f(1)(2)`) is an indirect call: ExprKind.Call with no name,
                    # the callee expression in `left`.  This arm used to drop
                    # the call, so `fs[1](3)` evaluated to the fn pointer.
                    result = expr_nameless_call(p, result, op.args)
        else if op.kind == POSTFIX_INDEX
            # Create new index expression
            let index_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            index_expr.kind = ExprKind.Index
            index_expr.span = result.span
            index_expr.bracket = op.bracket
            index_expr.left = result
            index_expr.right = postfix_index_of(p, result, op)
            index_expr.next = null
            result = index_expr
        else if op.kind == POSTFIX_MEMBER
            # Create new member expression
            let member_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            member_expr.kind = ExprKind.Member
            member_expr.span = result.span
            member_expr.left = result
            member_expr.ident_ptr = op.member_name
            member_expr.ident_len = op.member_len
            member_expr.bracket = op.bracket   # AGAST #3015
            member_expr.next = null
            result = member_expr
        else if op.kind == POSTFIX_CAST
            # Create new cast expression
            let cast_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            cast_expr.kind = ExprKind.Cast
            cast_expr.fn_sig = null
            cast_expr.cast_array = null
            cast_expr.cast_ptr_array = null
            cast_expr.span = result.span
            cast_expr.left = result
            cast_expr.type_kind = op.cast_type
            cast_expr.cast_ptr_kind = (TypeKind.Void as i32)
            cast_expr.next = null
            result = cast_expr
        else if op.kind == POSTFIX_TRY
            # Try operator `expr?` — wrap running result in ExprKind.Try.
            # emit_expr_try propagates Err/None via early return. (AGAST #134)
            let try_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            try_expr.kind = ExprKind.Try
            try_expr.span = result.span
            try_expr.left = result
            try_expr.next = null
            result = try_expr
        op = op.next
    return result

# A call through a callee expression (AGAST #1747): ExprKind.Call with no name
# and the callee in `left`; emit_call evaluates it to the fn's address.
fn expr_nameless_call(p: *Parser, callee: *Expr, args: *Expr) -> *Expr
    let call_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    call_expr.kind = ExprKind.Call
    call_expr.span = callee.span
    call_expr.func_name = null
    call_expr.func_name_len = 0
    call_expr.call_type_suffix = null
    call_expr.call_type_suffix_len = 0
    call_expr.args = args
    call_expr.left = callee
    call_expr.right = null
    call_expr.operand = null
    call_expr.ident_ptr = null
    call_expr.ident_len = 0
    call_expr.next = null
    return call_expr

# apply_postfix_p for a parenthesised primary `(e)`.  AGAST #2120: `(t.f)(..)`
# calls the fn pointer stored in field f, as in ritz0; only the unparenthesised
# `t.f(..)` is a method call.  Without the parens to tell them apart, the
# call became `Tbl_f(t, ..)`, an undefined symbol.
pub fn apply_postfix_paren_p(p: *Parser, base: *Expr, ops: *PostfixOp) -> *Expr
    if ops != null and ops.kind == POSTFIX_CALL and base.kind == ExprKind.Member and ops.call_type_suffix_len == 0
        return apply_postfix_p(p, expr_nameless_call(p, base, ops.args), ops.next)
    return apply_postfix_p(p, base, ops)

# =============================================================================
# Struct literal helpers
# =============================================================================

pub fn field_init_new(p: *Parser, name_sv: StrView, val: *Expr) -> *FieldInit
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let f: *FieldInit = parser_alloc(p, sizeof(FieldInit)) as *FieldInit
    f.name = name as *u8
    f.name_len = len
    f.value = val
    f.next = null
    return f

pub fn field_init_link(first: *FieldInit, rest: *FieldInit) -> *FieldInit
    first.next = rest
    return first

pub fn ident_or_struct(p: *Parser, tok: Token, lit: *FieldInit) -> *Expr
    if lit == null
        # Just an identifier
        return expr_ident(p, StrView { ptr: (tok.start), len: (tok.len) as i64 }, tok.line, tok.col)
    return struct_lit_expr(p, tok, lit)

# `Unit {}` (AGAST #2955): a struct literal with no field inits.  Its null
# field list is what ident_or_struct reads as "just an identifier".
pub fn struct_lit_empty(p: *Parser, tok: Token) -> *Expr
    return struct_lit_expr(p, tok, null)

fn struct_lit_expr(p: *Parser, tok: Token, lit: *FieldInit) -> *Expr
    # AGAST #3993: the literal's name is a type name the AST keeps no slot
    # for; note it (#4021) so type_name_check.ritz refuses one that names
    # nothing, at the name.  An unannotated `let a = Nope { .. }` compiled to
    # an uninitialised alloca.  A token, not the action's p.pos: the
    # literal's fields have been parsed since its name.
    note_type_name_written(p, tok.start, tok.line, tok.col)
    tn_note(p, StrView { ptr: (tok.start), len: (tok.len) as i64 })
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.StructLit
    e.span.line = tok.line
    e.span.col = tok.col
    e.ident_ptr = tok.start as *u8
    e.ident_len = tok.len
    # Store field inits in args field (reuse)
    e.args = lit as *Expr
    e.next = null
    # AGAST #4187: a struct variant's name builds the variant
    # (`Log { level: 4 }`); named_variants.ritz turns it into the positional
    # call and accepts the name noted above.
    named_form_note(p, null, e, tok, StrView { ptr: (null), len: (0) as i64 })
    return e

# `E.V { a: 1, b: 2 }` (AGAST #4275): a qualified named variant literal.
# ExprKind.StructLit named `V`, with the receiver `E` in `left`;
# named_variants.ritz turns it into the method-call shape `E.V(1, 2)` parses
# to (ExprKind.Method), whatever `V` is.  `V` names no type: not noted as one.
pub fn qualified_struct_lit(p: *Parser, qual: Token, name: Token, lit: *FieldInit) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.StructLit
    e.span.line = qual.line
    e.span.col = qual.col
    e.ident_ptr = name.start as *u8
    e.ident_len = name.len
    e.left = expr_ident(p, StrView { ptr: (qual.start), len: (qual.len) as i64 }, qual.line, qual.col)
    e.bracket.line = name.line   # AGAST #3015: the member name's place
    e.bracket.col = name.col
    e.args = lit as *Expr
    e.next = null
    named_form_note(p, null, e, qual, StrView { ptr: (qual.start), len: (qual.len) as i64 })
    return e

# AGAST #4187: the named forms of a struct-declared variant
# (docs/ENUM_VARIANTS.md §4-5), a pattern `V { b, a }` / `E.V { .. }` and a
# struct literal that may name one, noted as they parse.  The variant may be
# declared later or in an import, so named_variants.ritz maps the names to
# field positions once the whole closure is parsed.  An alternative the
# parser backtracks out of leaves its note behind; nothing points at its
# node, and named_variants reports each source position once.
# struct NamedForm: ast.ritz, beside ParseCtx (AGAST #4623).

# State: ParseCtx.named_forms

pub fn named_forms(ctx: *ParseCtx) -> *NamedForm
    ctx.named_forms

# The driver re-parses from scratch (#1475).
pub fn named_forms_reset(ctx: *ParseCtx)
    ctx.named_forms = null

# `head` is where the form begins: the qualifier of `E.V { .. }`.
fn named_form_note(p: *Parser, arm: *MatchArm, lit: *Expr, head: Token, qual_sv: StrView)
    var qual: *u8 = qual_sv.ptr
    var qual_len: i32 = qual_sv.len as i32
    if p.skip_item != 0
        return
    let f: *NamedForm = parser_alloc(p, sizeof(NamedForm)) as *NamedForm
    f.arm = arm
    f.lit = lit
    if arm != null
        f.name = arm.pattern_name
        f.name_len = arm.pattern_name_len
    else
        f.name = lit.ident_ptr
        f.name_len = lit.ident_len
    f.qual = qual
    f.qual_len = qual_len
    f.span.line = head.line
    f.span.col = head.col
    f.file = parse_file_copy_shared(p)
    f.next = p.ctx.named_forms
    p.ctx.named_forms = f

# pattern : [IDENT '.'] IDENT '{' IDENT (',' IDENT)* '}'  (AGAST #4187).  The
# names bind as written until named_variants.ritz puts them in field order.
# `head` is the pattern's first token, `name` the variant's.
pub fn pattern_variant_named(p: *Parser, head: Token, name: Token, binds: *TupleName) -> *MatchArm
    let a: *MatchArm = pattern_variant_binds(p, StrView { ptr: (name.start), len: (name.len) as i64 }, binds)
    if head.start == name.start
        named_form_note(p, a, null, head, StrView { ptr: (null), len: (0) as i64 })
    else
        named_form_note(p, a, null, head, StrView { ptr: (head.start), len: (head.len) as i64 })
    return a

# Generic struct literal parsed through generic_args (AGAST #1300):
# `Pair<i64, Vec<i64>> { ... }`.  Mangles on every argument (AGAST #1574),
# from the capture records: parsing the literal's fields clobbers
# the last_type_name side channel.
pub fn generic_struct_lit_arg(p: *Parser, tok: Token, ga: *GenericArg, lit: *FieldInit) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.StructLit
    e.span.line = tok.line
    e.span.col = tok.col
    var len: i32 = 0
    e.ident_ptr = mangle_generic_args(p, StrView { ptr: (tok.start), len: (tok.len) as i64 }, ga, @len)
    e.ident_len = len
    # Store field inits in args field (reuse)
    e.args = lit as *Expr
    e.next = null
    return e

# =============================================================================
# Numeric parsing
# =============================================================================

# A NUMBER token's literal.  One of 2^64 or more doesn't fit an i64, which
# parse_int wraps it into: it keeps its source text in ident_ptr/ident_len, so
# literal_slot.ritz can refuse it and name it (AGAST #3083).  Null otherwise.
pub fn expr_int_lit(p: *Parser, start_sv: StrView, line: i32, col: i32) -> *Expr
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    let e: *Expr = expr_int(p, parse_int(StrView { ptr: (start), len: (len) as i64 }), line, col)
    if parse_int_overflows(StrView { ptr: (start), len: (len) as i64 }) == 1
        e.ident_ptr = start
        e.ident_len = len
    # AGAST #4245: a typed suffix (absorbed by the lexer, #107) types the
    # literal: `1u32` is `1 as u32`, as ritz0's _apply_literal_suffix has it
    # and as expr_float does for `2.5f32`.  Dropping it made `let p = 1u32`
    # an i64 local, so `take_u32(p)` was refused as a narrowing.
    let sfx: TypeKind = int_lit_suffix_type(StrView { ptr: (start), len: (len) as i64 })
    if sfx != TypeKind.Void
        let c: *Expr = expr_cast(p, e, sfx, TypeKind.Void)
        c.cast_pointee = TypeKind.Void
        return c
    return e

# The integer type a NUMBER token's suffix names (ritz0's NUMBER_SUFFIXES:
# `u8` .. `i64`, `usize`, `isize`), else TypeKind.Void.  No digit of any base is
# `u` or `i`, so the first one starts the suffix.  The lexer's `U` / `I`
# forms are not ritz0's and stay untyped, as before.
fn int_lit_suffix_type(start_sv: StrView) -> TypeKind
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    var at: i32 = 0
    while at < len and *(start + at) != 'u' and *(start + at) != 'i'   # 'u' 'i'
        at = at + 1
    let n: i32 = len - at - 1
    if n <= 0
        return TypeKind.Void
    let s: *u8 = start + at
    let uns: i32 = (*s == 'u') as i32
    if is_word_type_name(StrView { ptr: (s), len: (n + 1) as i64 }) == 1
        return word_type(s)
    if n == 1 and *(s + 1) == '8'   # 8
        if uns == 1
            return TypeKind.U8
        return TypeKind.I8
    if n != 2
        return TypeKind.Void
    let c1: u8 = *(s + 1)
    let c2: u8 = *(s + 2)
    if c1 == '1' and c2 == '6'   # 16
        if uns == 1
            return TypeKind.U16
        return TypeKind.I16
    if c1 == '3' and c2 == '2'   # 32
        if uns == 1
            return TypeKind.U32
        return TypeKind.I32
    if c1 == '6' and c2 == '4'   # 64
        if uns == 1
            return TypeKind.U64
        return TypeKind.I64
    TypeKind.Void

# The value of an integer literal (literal_slot.ritz, the emitter's R21
# operand typing), `-1` included: 1, and `out` set, if it is one.
pub fn lit_int_value(e: *Expr, out: *i64) -> i32
    if e.kind == ExprKind.IntLit and e.lit_kind == LIT_PLAIN
        *out = e.int_val
        return 1
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg and e.operand != null
        if e.operand.kind == ExprKind.IntLit and e.operand.lit_kind == LIT_PLAIN
            # `-9223372036854775808`: the negation wraps, by request (R63).
            *out = 0 -% e.operand.int_val
            return 1
    0

# The base of a NUMBER token's digits (10, 16 or 2), and where they start.
pub fn int_lit_base(start_sv: StrView, digits: **u8) -> i64
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    *digits = start
    if len >= 3 and *start == '0'  # '0'
        let prefix: i32 = *(start + 1) as i32
        if prefix == 120 or prefix == 88  # 'x' or 'X'
            *digits = start + 2
            return 16
        if prefix == 98 or prefix == 66   # 'b' or 'B'
            *digits = start + 2
            return 2
    10

# The value of one digit of `base`, or -1 if `ch` isn't one (a suffix).
pub fn int_lit_digit(ch: i32, base: i64) -> i64
    var d: i64 = -1
    if ch >= '0' and ch <= '9'
        d = (ch - 48) as i64
    else if base == 16 and ch >= 'A' and ch <= 'F'
        d = (ch - 55) as i64
    else if base == 16 and ch >= 'a' and ch <= 'f'
        d = (ch - 87) as i64
    if d >= base
        return -1
    d

# 1 if the literal is 2^64 or more: past every integer type.
pub fn parse_int_overflows(start_sv: StrView) -> i32
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    var digits: *u8 = null
    let base: i64 = int_lit_base(StrView { ptr: (start), len: (len) as i64 }, @digits)
    let n: i32 = len - (digits - start) as i32
    let max: u64 = 0xFFFFFFFFFFFFFFFF
    var val: u64 = 0
    for i in 0..n
        let d: i64 = int_lit_digit(*(digits + i) as i32, base)
        if d < 0
            return 0
        if val > (max - d as u64) / base as u64
            return 1
        val = val * base as u64 + d as u64
    0

pub fn parse_int(start_sv: StrView) -> i64
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    # Check for hex prefix (0x or 0X)
    if len >= 3 and *start == '0'  # '0'
        let prefix: i32 = *(start + 1) as i32
        if prefix == 120 or prefix == 88  # 'x' or 'X'
            return parse_hex(StrView { ptr: (start + 2), len: (len - 2) as i64 })
        if prefix == 98 or prefix == 66   # 'b' or 'B'
            return parse_binary(StrView { ptr: (start + 2), len: (len - 2) as i64 })
    # Decimal parsing.  Stops on the first non-digit so typed-int literal
    # suffixes (`42i32`, `100u16`, etc.) are naturally ignored — caller
    # used to have to pre-trim via int_lit_len; that's no longer required.
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        if ch < '0' or ch > '9'  # not '0'-'9'
            return val
        # Literal parsing keeps the value's low bits: a u64 literal's
        # magnitude wraps (LARB R63, `+%` / `*%`).
        val = val *% 10 +% (ch - 48) as i64
    return val

pub fn parse_hex(start_sv: StrView) -> i64
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    # Stops on the first non-hex-digit so a `42u8` style suffix on a hex
    # literal (`0xFFi32`) doesn't leak into the value.
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        var digit: i64 = -1
        if ch >= '0' and ch <= '9'       # '0'-'9'
            digit = (ch - 48) as i64
        else if ch >= 'A' and ch <= 'F'  # 'A'-'F'
            digit = (ch - 55) as i64
        else if ch >= 'a' and ch <= 'f' # 'a'-'f'
            digit = (ch - 87) as i64
        if digit < 0
            return val
        val = val *% 16 +% digit
    return val

pub fn parse_binary(start_sv: StrView) -> i64
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    # Stops on the first non-bit-digit (typed-int suffix tolerance).
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        if ch == '1'        # '1'
            val = val *% 2 +% 1
        else if ch == '0'   # '0'
            val = val *% 2
        else
            return val
    return val

# =============================================================================
# Match / pattern helpers
# =============================================================================

# Allocate a new MatchArm with int-literal pattern. Caller fills body + is_pass.
pub fn match_arm_int(p: *Parser, val: i64) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_INT_LIT
    a.pattern_int = val
    a.pattern_name = null
    a.pattern_name_len = 0
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.is_block = 0   # AGAST #3028
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    a.pattern_binds = null
    a.pattern_bind_count = 0
    a.pattern_field_sel = 0
    return a

# Allocate a new MatchArm with wildcard pattern (_). Caller fills body + is_pass.
pub fn match_arm_wildcard(p: *Parser) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_WILDCARD
    a.pattern_int = 0
    a.pattern_name = null
    a.pattern_name_len = 0
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.is_block = 0   # AGAST #3028
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    a.pattern_binds = null
    a.pattern_bind_count = 0
    a.pattern_field_sel = 0
    return a

# Allocate a new MatchArm with identifier binding OR unit-variant (e.g. x, None).
pub fn match_arm_ident(p: *Parser, name_sv: StrView) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_IDENT
    a.pattern_int = 0
    a.pattern_name = name
    a.pattern_name_len = name_len
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.is_block = 0   # AGAST #3028
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    a.qualifier = null
    a.qualifier_len = 0
    a.pattern_binds = null
    a.pattern_bind_count = 0
    a.pattern_field_sel = 0
    return a

# Allocate a new MatchArm with variant pattern Name(inner).
# inner_kind is PAT_WILDCARD or PAT_IDENT.
pub fn match_arm_variant(p: *Parser, name_sv: StrView, inner_kind: i32, inner_name_sv: StrView) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var inner_name: *u8 = inner_name_sv.ptr
    var inner_name_len: i32 = inner_name_sv.len as i32
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_VARIANT
    a.pattern_int = 0
    a.pattern_name = name
    a.pattern_name_len = name_len
    a.pattern_inner_kind = inner_kind
    a.pattern_inner_name = inner_name
    a.pattern_inner_name_len = inner_name_len
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.is_block = 0   # AGAST #3028
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    a.pattern_binds = null
    a.pattern_bind_count = 1
    a.pattern_field_sel = 0
    return a

# AGAST #1295: `V(a, b, ..)` / `E.V(a, b, ..)`, every positional binding of a
# multi-field variant; `binds` lists them in order (a `_` is a wildcard
# slot).  The arm starts with the first one selected (arm_select_bind).
pub fn pattern_variant_binds(p: *Parser, name_sv: StrView, binds: *TupleName) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let a: *MatchArm = pattern_variant_inner(p, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (binds.name), len: (binds.len) as i64 }, binds.span.line, binds.span.col)
    a.pattern_binds = binds
    var n: i32 = 0
    var b: *TupleName = binds
    while b != null
        n += 1
        b = b.next
    a.pattern_bind_count = n
    return a

# AGAST #1295: how many positional bindings `arm` names (0 unless it is a
# variant pattern; 1 for `Some(v)`).
pub fn arm_bind_count(arm: *MatchArm) -> i32
    if arm.pattern_kind != PAT_VARIANT
        return 0
    if arm.pattern_bind_count < 1
        return 1
    arm.pattern_bind_count

# AGAST #1295: make binding `k` of a multi-binding variant arm the one its
# pattern_inner_* fields describe, as field `k` of the variant
# (pattern_field_sel).  Passes written for the single `Some(v)` binding run
# once per binding this way; each loop ends with arm_select_bind(arm, 0),
# which restores the arm as the parser built it.  A no-op for an arm with
# one binding.
pub fn arm_select_bind(arm: *MatchArm, k: i32)
    if arm.pattern_binds == null
        return
    var b: *TupleName = arm.pattern_binds
    var i: i32 = 0
    while b != null and i < k
        b = b.next
        i += 1
    if b == null
        return
    arm.pattern_field_sel = k
    arm.pattern_inner_name = b.name
    arm.pattern_inner_name_len = b.len
    arm.pattern_inner_span.line = b.span.line
    arm.pattern_inner_span.col = b.span.col
    arm.pattern_inner_kind = PAT_IDENT
    if b.len == 1 and *b.name == '_'   # '_'
        arm.pattern_inner_kind = PAT_WILDCARD

# Set arm body (optionally marks is_pass when body_expr is null).
pub fn match_arm_set_body(arm: *MatchArm, body: *Expr, is_pass: i32)
    arm.body = body
    arm.is_pass = is_pass

# Link arms into a linked list (first.next = rest, returns first).
pub fn match_arm_link(first: *MatchArm, rest: *MatchArm) -> *MatchArm
    if first == null
        return rest
    first.next = rest
    return first

# Create StmtKind.Match: scrutinee stored in if_cond, arms stored in if_then (recast).
pub fn stmt_match(p: *Parser, scrutinee: *Expr, arms: *MatchArm, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = StmtKind.Match
    s.span.line = line
    s.span.col = col
    s.if_cond = scrutinee
    s.if_then = arms as *Stmt  # Reinterpret arm list as Stmt* slot (never dereferenced as Stmt)
    s.if_else = null
    s.next = null
    return s

# Create ExprKind.Match: scrutinee stored in left, arms stored in args (recast).
pub fn expr_match(p: *Parser, scrutinee: *Expr, arms: *MatchArm, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.Match
    e.span.line = line
    e.span.col = col
    e.left = scrutinee
    e.args = arms as *Expr  # Reinterpret arm list as Expr* slot
    e.next = null
    return e

# Create ExprKind.If (AGAST #1613): `if cond` + then block + `else` + else block,
# used as a value.  Each block becomes a wildcard MatchArm whose value is the
# block's trailing bare expression (match_arm_set_block), so emit_if_expr,
# monomorph and narrowing read the arms exactly as they read ExprKind.Match arms.
# `args` holds the then-arm; its `next` is the else-arm.
pub fn expr_if(p: *Parser, cond: *Expr, then_body: *Stmt, else_body: *Stmt, line: i32, col: i32) -> *Expr
    let then_arm: *MatchArm = if_arm_from_block(p, then_body)
    let else_arm: *MatchArm = if_arm_from_block(p, else_body)
    then_arm.next = else_arm
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.If
    e.span.line = line
    e.span.col = col
    e.left = cond
    e.args = then_arm as *Expr  # Reinterpret arm list as Expr* slot
    e.next = null
    return e

# Create ExprKind.If for an else-less block form used as a value (AGAST #4543):
# `let x = if c` + then body, or `5 + if c` + then body.  The missing `else`
# is #1406's error, reported by if_arm_value at the `if` when the value is
# wanted — exactly where ritz0 points — instead of failing the parse at the
# next token.  The missing arm is a `pass` arm: every reader of an ExprKind.If
# already handles one (narrowing, bool_check, float_slot, ...), and
# if_arm_check tells it apart by the arm's `else_missing` marker.  Only the
# refused program reaches it, since every value-wanted else-less `if` is an
# error before emit.  `open_if_note` records where the block ended so the
# statement terminator (open_if_ended) can accept it.
pub fn expr_if_open(p: *Parser, cond: *Expr, then_body: *Stmt, line: i32, col: i32) -> *Expr
    let then_arm: *MatchArm = if_arm_from_block(p, then_body)
    let else_arm: *MatchArm = match_arm_wildcard(p)
    match_arm_set_body(else_arm, null, 1)
    else_arm.else_missing = 1
    then_arm.next = else_arm
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = ExprKind.If
    e.span.line = line
    e.span.col = col
    e.left = cond
    e.args = then_arm as *Expr  # Reinterpret arm list as Expr* slot
    e.next = null
    open_if_note(p.ctx, p.pos)
    return e

# Create ExprKind.If for a block `if`/`else` used as an OPERAND (`5 + if c` +
# then body + `else` + else body), which ritz0 accepts (AGAST #4553).  The
# node is the same expr_if builds; this wrapper only records where the else
# block ended (open_if_note) so the statement holding the operand terminates
# with `open_if_ended`.  Kept apart from expr_if so the statement-level
# `let x = if … else …` forms (`if_expr_rhs`) are untouched.
pub fn expr_if_operand(p: *Parser, cond: *Expr, then_body: *Stmt, else_body: *Stmt, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_if(p, cond, then_body, else_body, line, col)
    open_if_note(p.ctx, p.pos)
    return e

# Create ExprKind.Match for a block `match` in primary_expr, which is only
# reached as an operand (`5 + match c` + its arms, AGAST #4049): match_stmt
# and match_expr_rhs claim the bare forms first.  Notes where the arms ended
# (open_if_note) so the statement holding the operand terminates with
# `open_if_ended`, as for a block `if` operand (#4553).
pub fn expr_match_operand(p: *Parser, scrutinee: *Expr, arms: *MatchArm, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_match(p, scrutinee, arms, line, col)
    open_if_note(p.ctx, p.pos)
    return e

# Create ExprKind.If for the inline form `if cond then a else b` (AGAST #1753).
# Each arm expression becomes a one-statement block (a bare expression
# statement), which is exactly the block form's shape for `if c` NEWLINE
# INDENT a DEDENT, so expr_if / if_arm_from_block build the same node.
pub fn expr_if_inline(p: *Parser, cond: *Expr, then_val: *Expr, else_val: *Expr, line: i32, col: i32) -> *Expr
    let then_body: *Stmt = stmt_expr(p, then_val, then_val.span.line, then_val.span.col)
    let else_body: *Stmt = stmt_expr(p, else_val, else_val.span.line, else_val.span.col)
    return expr_if(p, cond, then_body, else_body, line, col)

# A block ending in an `if`/`else` or a `match` STATEMENT takes its value: the
# grammar parses a nested `if` (and an `else if` chain, whose else block is a
# single if_stmt) as StmtKind.If and a nested `match` as StmtKind.Match, so the last
# one is rewritten here into a trailing ExprKind.If / ExprKind.Match expression
# statement, which match_arm_set_block then detaches as the value.  An
# else-less trailing `if` is left alone: it has no value.  Returns the head.
#
# AGAST #2429: match arms skipped this, so `Some(v) =>` + a block ending in
# `match v` / `if`..`else` yielded 0, silently.  The rewritten tail is an
# expression arm like `=> match v`, so a valueless one (void-call arms) is the
# located error #2046 gives that form when the outer value is wanted.
fn block_tail_as_value(p: *Parser, stmts: *Stmt) -> *Stmt
    var head: *Stmt = stmts
    var prev: *Stmt = null
    var last: *Stmt = stmts
    while last != null and last.next != null
        prev = last
        last = last.next
    var inner: *Expr = null
    if last != null and last.kind == StmtKind.If and last.if_else != null
        inner = expr_if(p, last.if_cond, last.if_then, last.if_else, last.span.line, last.span.col)
    else if last != null and last.kind == StmtKind.Match
        inner = expr_match(p, last.if_cond, last.if_then as *MatchArm, last.span.line, last.span.col)
    if inner != null
        let st: *Stmt = stmt_expr(p, inner, last.span.line, last.span.col)
        if prev == null
            head = st
        else
            prev.next = st
    return head

# One arm of an ExprKind.If: a wildcard arm whose value is the block's tail.
fn if_arm_from_block(p: *Parser, stmts: *Stmt) -> *MatchArm
    return match_arm_set_block(match_arm_wildcard(p), block_tail_as_value(p, stmts))

# A block-bodied match arm (`Some(v) =>` + indented statements, #1454): its
# value is the block's tail, a trailing match or if/else included (#2429).
pub fn match_arm_set_block_tail(p: *Parser, arm: *MatchArm, stmts: *Stmt) -> *MatchArm
    return match_arm_set_block(arm, block_tail_as_value(p, stmts))

# =============================================================================
# Wave 5F.2 — wrappers called from the canonical grammar (ritz1.grammar)
# =============================================================================
# These wrap the lower-level helpers above with the names / shapes the
# grammar productions reference.  Kept thin so generator output stays a
# direct translation of the grammar.

# pattern : NUMBER  →  PAT_INT_LIT.  Token text comes raw from the lexer; we
# parse it into an i64 here so the action stays a single function call.
pub fn pattern_lit_int(p: *Parser, start_sv: StrView) -> *MatchArm
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    return match_arm_int(p, parse_int(StrView { ptr: (start), len: (len) as i64 }))

# pattern : CHAR  →  PAT_CHAR, its byte in pattern_int.  A char literal is u8
# (§2.6), so its pattern is an integer literal pattern typed u8 (LANGUAGE_SPEC
# §8.2, LARB R72, AGAST #4196): it compares as PAT_INT_LIT does, and only a u8
# scrutinee takes it (match_check_reachable).
pub fn pattern_char(p: *Parser, tok: Token) -> *MatchArm
    let a: *MatchArm = match_arm_int(p, char_token_value(tok))
    a.pattern_kind = PAT_CHAR
    return a

# pattern : TRUE | FALSE  →  PAT_BOOL.  A PAT_INT_LIT of 1 or 0 would not do:
# a bool match must be covered by `true` and `false`, not by the integers they
# lower to, and neither may stand on an integer scrutinee (AGAST #2344).
pub fn pattern_bool(p: *Parser, val: i64, line: i32, col: i32) -> *MatchArm
    let a: *MatchArm = match_arm_int(p, val)
    a.pattern_kind = PAT_BOOL
    a.bool_span.line = line
    a.bool_span.col = col
    return a

# pattern : STRING  →  PAT_STR, holding the literal's cooked bytes, the ones a
# "..." expression has, so an arm equals exactly the values it reads as.  It
# compares a StrView scrutinee (LANGUAGE_SPEC §8.2, AGAST #1876).
pub fn pattern_str(p: *Parser, tok: Token) -> *MatchArm
    let a: *MatchArm = match_arm_int(p, 0)
    a.pattern_kind = PAT_STR
    a.pattern_name = tok.string_val as *u8
    a.pattern_name_len = tok.string_len
    return a

# pattern : IDENT  →  PAT_WILDCARD if `_`, else PAT_IDENT.
pub fn pattern_ident_or_wildcard(p: *Parser, name_sv: StrView) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name_len == 1
        if *name == '_'  # '_'
            return match_arm_wildcard(p)
    return match_arm_ident(p, StrView { ptr: (name), len: (name_len) as i64 })

# pattern : IDENT, with where it is: a bare name binds unless the match finds
# it tests, and a binding can't take a module value's name (AGAST #2407).
pub fn pattern_ident_at(p: *Parser, name_sv: StrView, line: i32, col: i32) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let a: *MatchArm = pattern_ident_or_wildcard(p, StrView { ptr: (name), len: (name_len) as i64 })
    if a.pattern_kind == PAT_IDENT
        a.pattern_span.line = line
        a.pattern_span.col = col
    return a

# Where an arm's pattern begins, kept for the error when the scrutinee's enum
# declares no variant of that name (AGAST #2431).  Returns arm.
pub fn pattern_head_at(arm: *MatchArm, line: i32, col: i32) -> *MatchArm
    arm.head_span.line = line
    arm.head_span.col = col
    return arm

# An or-pattern (AGAST #4450): `rest` is the alternatives after `first`, each
# chained from the one before by or_next.  Returns first.
pub fn pattern_or_link(first: *MatchArm, rest: *MatchArm) -> *MatchArm
    first.or_next = rest
    return first

# The pattern after `pat` in arm order, every alternative of an or-pattern
# counted (AGAST #4450); `arm` is `pat`'s arm, moved on when the walk leaves
# it.  Start with both at the first arm; null at the end.
pub fn arm_pattern_next(arm: **MatchArm, pat: *MatchArm) -> *MatchArm
    if pat.or_next != null
        return pat.or_next
    let a: *MatchArm = *arm
    *arm = a.next
    a.next

# `Q.N =>`: record Q (AGAST #2215), so emitter_match can tell `E.V` from `m.K`.
pub fn pattern_qualified_by(arm: *MatchArm, start_sv: StrView) -> *MatchArm
    var start: *u8 = start_sv.ptr
    var len: i32 = start_sv.len as i32
    arm.qualifier = start
    arm.qualifier_len = len
    return arm

# pattern : IDENT '(' IDENT ')'  →  PAT_VARIANT with inner = wildcard or bind.
# Inner ident `_` becomes a wildcard payload; any other ident is a binding, and
# binder_check.ritz refuses one named like a const, global or variant (#2407).
pub fn pattern_variant_inner(p: *Parser, name_sv: StrView, inner_sv: StrView, line: i32, col: i32) -> *MatchArm
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var inner: *u8 = inner_sv.ptr
    var inner_len: i32 = inner_sv.len as i32
    if inner_len == 1
        if *inner == '_'  # '_'
            return match_arm_variant(p, StrView { ptr: (name), len: (name_len) as i64 }, PAT_WILDCARD, StrView { ptr: (null), len: (0) as i64 })
    let a: *MatchArm = match_arm_variant(p, StrView { ptr: (name), len: (name_len) as i64 }, PAT_IDENT, StrView { ptr: (inner), len: (inner_len) as i64 })
    a.pattern_inner_span.line = line
    a.pattern_inner_span.col = col
    return a

# match_arm action: arm_body returns an expr_pass for the `pass` keyword, the
# expression otherwise.  A `pass` sets is_pass=1 with no body, and keeps only
# its position (AGAST #2236); otherwise store the body expr.  Returns arm.
pub fn match_arm_set_body_or_pass(arm: *MatchArm, body: *Expr) -> *MatchArm
    if body.kind == ExprKind.IntLit and body.lit_kind == LIT_PASS
        match_arm_set_body(arm, null as *Expr, 1)
        arm.pass_span.line = body.span.line
        arm.pass_span.col = body.span.col
    else
        match_arm_set_body(arm, body, 0)
    return arm

# match_arm action for a statement-bodied arm (AGAST #1454 / #1617):
#   `None =>` NEWLINE INDENT stmts DEDENT     (block arm)
#   `5 => r = 5`                              (assignment arm, one stmt)
# Like an `if` branch or a fn body, the block's value is its trailing bare
# expression.  That expression is detached from the statement list into
# arm.body, so emit_match_arm_body, narrowing and monomorph keep reading the
# arm's value from `body` exactly as for an expression arm; the remaining
# statements go to arm.body_stmts and are emitted first.  A block that does
# not end in a bare expression yields no value and is marked is_pass, the
# same default (`i64 0`) a `pass` arm contributes.
pub fn match_arm_set_block(arm: *MatchArm, stmts: *Stmt) -> *MatchArm
    arm.is_block = 1   # AGAST #3028
    var prev: *Stmt = null
    var last: *Stmt = stmts
    while last != null and last.next != null
        prev = last
        last = last.next
    if last != null and last.kind == StmtKind.Expr and last.expr != null
        arm.body = last.expr
        arm.is_pass = 0
        if prev == null
            arm.body_stmts = null
        else
            prev.next = null
            arm.body_stmts = stmts
    else
        arm.body = null
        arm.is_pass = 1
        arm.body_stmts = stmts
    return arm

# postfix_op : '?'  →  POSTFIX_TRY.  apply_postfix_p wraps the running
# postfix result in an ExprKind.Try node when it sees this op (AGAST #134).
pub fn postfix_try_new(p: *Parser) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_TRY
    op.next = null
    return op

# postfix_op : '[' expr '..' expr ']'  →  POSTFIX_INDEX wrapping an
# ExprKind.Range { lo, hi }.  Monomorph rewrites a String, Vec or Span slice
# into `.slice(lo, hi)`; emit_expr_index refuses the rest (AGAST #2521).
pub fn postfix_range_index(p: *Parser, lo: *Expr, hi: *Expr) -> *PostfixOp
    let r: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    r.kind = ExprKind.Range
    r.span = lo.span
    r.left = lo
    r.right = hi
    r.next = null
    return postfix_index(p, r, 0, 0)   # a slice's errors name the base

# postfix_op : '[' expr '..=' expr ']'  →  `[lo..hi + 1]`, as ritz0 lowers it
# (_emit_index).  ritz1 had no inclusive slice, so `v[1..=2]` didn't parse
# (AGAST #2451).
pub fn postfix_range_index_inclusive(p: *Parser, lo: *Expr, hi: *Expr) -> *PostfixOp
    let one: *Expr = expr_int(p, 1, hi.span.line, hi.span.col)
    return postfix_range_index(p, lo, expr_binary(p, OpKind.Add, hi, one))

# postfix_op : '[' ':' expr ']'  →  `[0..hi]`, ritz0's colon slice with the
# start left out (AGAST #3766).
pub fn postfix_open_start_slice(p: *Parser, hi: *Expr) -> *PostfixOp
    return postfix_range_index(p, expr_int(p, 0, hi.span.line, hi.span.col), hi)

# postfix_op : '[' expr ':' ']'  →  `[lo..a.len()]` (AGAST #3766).  The end
# needs the receiver, which isn't built yet: the range's `right` stays null
# and apply_postfix_p fills it in.
pub fn postfix_open_end_slice(p: *Parser, lo: *Expr) -> *PostfixOp
    let r: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    r.kind = ExprKind.Range
    r.span = lo.span
    r.left = lo
    r.right = null
    r.next = null
    return postfix_index(p, r, 0, 0)

# The index of `op` applied to `recv`: an open-ended range (postfix_open_end_slice)
# gets `recv.len()` as its end, in a node of its own so the op is never mutated.
fn postfix_index_of(p: *Parser, recv: *Expr, op: *PostfixOp) -> *Expr
    let ix: *Expr = op.index
    if ix == null or ix.kind != ExprKind.Range or ix.right != null
        return ix
    let r: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    r.kind = ExprKind.Range
    r.span = ix.span
    r.left = ix.left
    r.right = method_call_expr(p, recv, StrView { ptr: (c"len"), len: (3) as i64 }, null)
    r.next = null
    return r

# for_stmt : FOR IDENT IN expr block  →  StmtKind.For with iter expression
# stored in for_end (start = null sentinel).  emit_for handles the
# Vec/Span/Range iteration shapes (ritz-task-84 — for-iterables).
pub fn stmt_for_iter(p: *Parser, name_sv: StrView, iter: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    # The iterable form stores the iterable in for_start with for_end=null;
    # emit_for_iterable dispatches on for_end==null vs the range form's
    # for_end!=null.  Swapping these (start=null, end=iter) produced the
    # `store i64 %.0, ptr %.4` undefined-value crash because the range
    # path's emit_expr(for_start=null) never wrote to %.0.
    return stmt_for(p, StrView { ptr: (name), len: (name_len) as i64 }, iter, null as *Expr, body, line, col)

# enum_def : ENUM ... { skip-and-return-zero }
# Kept for grammar rules that record nothing (item_dispatch_enum does the
# bookkeeping for a real enum_def, whose variants the enum_def actions build).
pub fn enum_def_skip(p: *Parser) -> i32
    return 0

# enum_def's action: as enum_def_skip, latching `pub` for the enum just
# parsed (its generated `from` is `pub` iff it is, LANGUAGE_SPEC §10.4).
pub fn enum_def_end(p: *Parser, is_pub: i32) -> i32
    tn_claim(p, p.ctx.tn_enum_params, null)   # AGAST #4021
    p.ctx.tn_enum_params = null
    let e: *EnumDef = enum_cur(p)
    if e != null
        e.is_pub = is_pub
    return 0

# ============================================================================
# Enum declarations (AGAST #3994)
# ============================================================================
# When the parser sees `enum Shade ... Light ... Dark` it builds an EnumDef
# (ast.ritz) whose EnumVariant list holds Light then Dark.  Those nodes are
# the file's Module.enums; ctx.program_enums roots the merged program list once
# imports have resolved (main.ritz), so downstream references like
# `Shade.Light` still resolve to the variant's tag value (0, 1, ...).
#
# Lookup: enum_variant_index(enum_name, variant_name) returns index or -1.

# AGAST #1797: what each variant carries, so the emitter can give the enum
# ritz0's payload layout instead of a bare `{ i8 }` tag.
pub const ENUM_VARIANT_UNIT: i32 = 0
pub const ENUM_VARIANT_TUPLE: i32 = 1
pub const ENUM_VARIANT_STRUCT: i32 = 2

# The program's merged enum list: the Module.enums chain once parse_program
# has resolved every import.  It points at the AST's own nodes (a root, not a
# side table); `ei` in every accessor below indexes this chain in
# declaration order.
# State: ParseCtx.program_enums

# Set the program's enum root from the module parse_program just resolved.
pub fn enum_program_set(ctx: *ParseCtx, m: *Module)
    ctx.program_enums = m.enums

# Forget the program's enum root.  The driver's alias re-parse (AGAST #1475)
# parses every module a second time; the fresh Module carries the only enums
# that matter, so the root is cleared until that re-parse finishes.
pub fn enum_program_reset(ctx: *ParseCtx)
    ctx.program_enums = null

# Append `e` to the EnumDef chain rooted at `head`.
fn enum_list_append(head: *EnumDef, e: *EnumDef)
    var cur: *EnumDef = head
    while cur.next != null
        cur = cur.next
    cur.next = e

# The last EnumDef in a chain, or null.
fn enum_list_tail(head: *EnumDef) -> *EnumDef
    if head == null
        return null
    var cur: *EnumDef = head
    while cur.next != null
        cur = cur.next
    cur

# The program's `ei`-th enum, or null.
fn enum_node_at(ctx: *ParseCtx, ei: i32) -> *EnumDef
    if ei < 0
        return null
    var cur: *EnumDef = ctx.program_enums
    var i: i32 = 0
    while cur != null and i < ei
        cur = cur.next
        i = i + 1
    cur

# The `vi`-th variant of `e`, or null.
fn enum_variant_at_node(e: *EnumDef, vi: i32) -> *EnumVariant
    if e == null or vi < 0
        return null
    var v: *EnumVariant = e.variants
    var i: i32 = 0
    while v != null and i < vi
        v = v.next
        i = i + 1
    v

# The last variant of `e`, or null.
fn enum_variant_tail(e: *EnumDef) -> *EnumVariant
    if e == null
        return null
    var v: *EnumVariant = e.variants
    if v == null
        return null
    while v.next != null
        v = v.next
    v

# Count `e`'s variants.
fn enum_variant_count_node(e: *EnumDef) -> i32
    if e == null
        return 0
    var n: i32 = 0
    var v: *EnumVariant = e.variants
    while v != null
        n = n + 1
        v = v.next
    n

# The enum this file started last (the one its variants append to), or null.
fn enum_cur(p: *Parser) -> *EnumDef
    if p.module == null
        return null
    enum_list_tail(p.module.enums)

# Allocate and append a new EnumDef to the module being parsed.
fn enum_new(p: *Parser, name_sv: StrView, generic: i32, repr: TypeKind, line: i32) -> *EnumDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *EnumDef = parser_alloc(p, sizeof(EnumDef)) as *EnumDef
    e.name = name
    e.name_len = len
    e.generic = generic
    e.repr = repr
    e.is_pub = 0
    e.line = line
    e.variants = null
    e.next = null
    e.def_file = parse_file_copy_shared(p)   # AGAST #3494 (R65)
    if p.module.enums == null
        p.module.enums = e
    else
        enum_list_append(p.module.enums, e)
    e

fn enum_def_start_impl(p: *Parser, name_sv: StrView, generic: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    return enum_def_start_full(p, StrView { ptr: (name), len: (len) as i64 }, generic, TypeKind.Void, 0)

fn enum_def_start_full(p: *Parser, name_sv: StrView, generic: i32, repr: TypeKind, line: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    enum_new(p, StrView { ptr: (name), len: (len) as i64 }, generic, repr, line)
    if generic != ENUM_INSTANCE   # `Slot$i32` is declared by no file
        type_decl_log(p.ctx, StrView { ptr: (name), len: (len) as i64 })   # AGAST #3907
    return 0

# Called from grammar rule enum_def_header: starts a new EnumDef.
pub fn enum_def_start(p: *Parser, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    return enum_def_start_impl(p, StrView { ptr: (name), len: (len) as i64 }, 0)

# `enum Name<T>`: as enum_def_start, flagged generic (AGAST #1797).
pub fn enum_def_start_generic(p: *Parser, name_sv: StrView, params: *TypeParam) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    p.ctx.tn_enum_params = params   # AGAST #4021: in scope in its payloads
    return enum_def_start_impl(p, StrView { ptr: (name), len: (len) as i64 }, 1)

# `enum E: T` (LANGUAGE_SPEC §10.4): as enum_def_start, with representation
# type T, which must be an integer type (a located error otherwise).
pub fn enum_def_start_repr(p: *Parser, name_sv: StrView, tr: *TypeRef, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let repr: TypeKind = tr_kind(tr)
    var r: TypeKind = repr
    if is_int_const_type(repr) == 0 or repr == TypeKind.Bool
        if p.skip_item == 0
            diag_error_at(p.ctx.parse_file, diag_span(line, col))
            eprints("representation type of enum '")
            eprint_lexeme(StrView { ptr: (name), len: (len) as i64 })
            eprintln("' must be an integer type")
            p.ctx.attr_errors = p.ctx.attr_errors + 1
        r = TypeKind.I64
    return enum_def_start_full(p, StrView { ptr: (name), len: (len) as i64 }, 0, r, line)

# Called from grammar rule enum_variant: appends a unit variant to the most
# recent enum's variant list.
pub fn enum_variant_record(p: *Parser, name_sv: StrView, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    return enum_variant_record_impl(p, StrView { ptr: (name), len: (len) as i64 }, ENUM_VARIANT_UNIT, null, 0, 0, 0, line, col)

# `Name(T)` (AGAST #1797): the payload type is the type_spec just parsed;
# field_new captures its struct / pointer / array detail from the parser
# state exactly as for a struct field.
pub fn enum_variant_record_tuple(p: *Parser, name_sv: StrView, tr: *TypeRef, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let f: *StructField = field_new(p, StrView { ptr: (name), len: (len) as i64 }, tr, 0, 0)
    f.next = null
    nd_payload_reject(p.ctx, f, line, col)
    return enum_variant_record_impl(p, StrView { ptr: (name), len: (len) as i64 }, ENUM_VARIANT_TUPLE, f, 0, 0, 0, line, col)

# AGAST #1295: one payload type of a multi-field tuple variant `Name(T1, T2,
# ..)`.  Its own grammar rule, so field_new reads the parser's type detail
# (struct name, pointee, array shape) right after THIS type_spec, before the
# next one overwrites it.  Named by enum_variant_record_tuple_n.
pub fn variant_type_field(p: *Parser, tr: *TypeRef) -> *StructField
    # AGAST #4021: noted here for `A(T)` too, which enum_variant tries as
    # `A(T, ..)` first: this rule parses T before the missing comma fails it.
    tn_note_last(p, 1)
    let f: *StructField = field_new(p, StrView { ptr: (null), len: (0) as i64 }, tr, 0, 0)
    f.next = null
    return f

# AGAST #1295: `Name(T1, T2, ..)`, a tuple variant with two or more payload
# fields, laid out in order as a struct's fields are (user_enum_layout).
# Each field takes the variant's name, as the single-field form's does.
pub fn enum_variant_record_tuple_n(p: *Parser, name_sv: StrView, fields: *StructField, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *StructField = fields
    while f != null
        f.name = name
        f.name_len = len
        f = f.next
    nd_payload_reject(p.ctx, fields, line, col)
    return enum_variant_record_impl(p, StrView { ptr: (name), len: (len) as i64 }, ENUM_VARIANT_TUPLE, fields, 0, 0, 0, line, col)

# AGAST #2097: field_new now keeps an N-D field's shape, but an enum
# payload binding (`A(g) => g[i][j]`) has no N-D lowering: it was bound as
# one i64 and indexed as a byte pointer.  Keep #1509's located error there
# (ritz0 cannot index such a binding either).
fn nd_payload_reject(ctx: *ParseCtx, fields: *StructField, line: i32, col: i32)
    var f: *StructField = fields
    while f != null
        if f.array_shape != null
            nd_array_report(ctx, line, col, c"an enum variant payload")
            return
        f = f.next

# `Name` + an indented field block (AGAST #1797): the fields are the payload.
pub fn enum_variant_record_struct(p: *Parser, name_sv: StrView, fields: *StructField, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    nd_payload_reject(p.ctx, fields, line, col)
    tn_note_fields(p, fields)   # AGAST #4171
    return enum_variant_record_impl(p, StrView { ptr: (name), len: (len) as i64 }, ENUM_VARIANT_STRUCT, fields, 0, 0, 0, line, col)

# `Name = N` / `Name = -N` (LANGUAGE_SPEC §10.4): a unit variant with an
# explicit discriminant.
pub fn enum_variant_record_discr(p: *Parser, name_sv: StrView, num_sv: StrView, neg: i32, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var num: *u8 = num_sv.ptr
    var num_len: i32 = num_sv.len as i32
    var bits: i64 = parse_int(StrView { ptr: (num), len: (num_len) as i64 })
    var is_neg: i32 = 0
    if neg == 1 and bits != 0
        bits = 0 - bits
        is_neg = 1
    return enum_variant_record_impl(p, StrView { ptr: (name), len: (len) as i64 }, ENUM_VARIANT_UNIT, null, 1, bits, is_neg, line, col)

# A discriminant's value: negative bits when `neg`, else the bits as a u64.
fn eprint_discr(bits: i64, neg: i32)
    if neg == 1 or bits >= 0
        eprint_i64(bits)
        return
    # >= 2^63: print the u64 (bits / 10 as an unsigned shift-divide).
    let hi: i64 = ((bits >> 1) & 0x7FFFFFFFFFFFFFFF) / 5
    let lo: i64 = bits - hi * 10
    eprint_i64(hi)
    eprint_i64(lo)

# Does (bits, neg) fit representation type `ty`?
fn discr_fits(ty: TypeKind, bits: i64, neg: i32) -> i32
    if ty == TypeKind.U64
        return 1 - neg
    if neg == 0 and bits < 0
        return 0   # >= 2^63: only a u64 holds it
    var lo: i64 = 0
    var hi: i64 = 0
    match ty
        TypeKind.U8 =>
            hi = 255
        TypeKind.U16 =>
            hi = 65535
        TypeKind.U32 =>
            hi = 4294967295
        TypeKind.I8 =>
            lo = -128
            hi = 127
        TypeKind.I16 =>
            lo = -32768
            hi = 32767
        TypeKind.I32 =>
            lo = -2147483648
            hi = 2147483647
        _ =>
            return 1   # i64: every value of a 64-bit literal
    if bits < lo or bits > hi
        return 0
    return 1

# The checks of LANGUAGE_SPEC §10.4 on the variant just recorded (index `v`
# of the current enum `e`), each a located error at the variant's name.
# ritz0 enforces the same rules with the same text (parser.py,
# _check_discriminants).
fn enum_variant_check(p: *Parser, e: *EnumDef, v: i32, kind: i32, explicit: i32, line: i32, col: i32)
    if p.skip_item != 0
        return
    let repr: TypeKind = e.repr
    let ename: *u8 = e.name
    let elen: i32 = e.name_len
    let vnode: *EnumVariant = enum_variant_at_node(e, v)
    if vnode == null
        return
    let vname: *u8 = vnode.name
    let vlen: i32 = vnode.name_len
    if repr != TypeKind.Void and kind != ENUM_VARIANT_UNIT
        diag_error_at(p.ctx.parse_file, diag_span(line, col))
        eprints("variant '")
        eprint_lexeme(StrView { ptr: (vname), len: (vlen) as i64 })
        eprints("' of enum '")
        eprint_lexeme(StrView { ptr: (ename), len: (elen) as i64 })
        eprintln("' carries data, so the enum cannot have a representation type")
        p.ctx.attr_errors = p.ctx.attr_errors + 1
        return
    if repr == TypeKind.Void
        if explicit == 1
            diag_error_at(p.ctx.parse_file, diag_span(line, col))
            eprints("discriminant of variant '")
            eprint_lexeme(StrView { ptr: (vname), len: (vlen) as i64 })
            eprints("' needs a representation type: write 'enum ")
            eprint_lexeme(StrView { ptr: (ename), len: (elen) as i64 })
            eprintln(": <integer type>'")
            p.ctx.attr_errors = p.ctx.attr_errors + 1
        return
    let bits: i64 = vnode.discr
    let neg: i32 = vnode.discr_neg
    if discr_fits(repr, bits, neg) == 0
        diag_error_at(p.ctx.parse_file, diag_span(line, col))
        eprints("discriminant ")
        eprint_discr(bits, neg)
        eprints(" of variant '")
        eprint_lexeme(StrView { ptr: (vname), len: (vlen) as i64 })
        eprints("' does not fit enum '")
        eprint_lexeme(StrView { ptr: (ename), len: (elen) as i64 })
        eprints("''s representation type ")
        eprintln_cstr(primitive_name_from_type(repr))
        p.ctx.attr_errors = p.ctx.attr_errors + 1
        return
    var w: i32 = 0
    var wv: *EnumVariant = e.variants
    while wv != null and w < v
        if wv.discr == bits
            diag_error_at(p.ctx.parse_file, diag_span(line, col))
            eprints("variants '")
            eprint_lexeme(StrView { ptr: (wv.name), len: (wv.name_len) as i64 })
            eprints("' and '")
            eprint_lexeme(StrView { ptr: (vname), len: (vlen) as i64 })
            eprints("' of enum '")
            eprint_lexeme(StrView { ptr: (ename), len: (elen) as i64 })
            eprints("' have the same discriminant ")
            eprint_discr(bits, neg)
            eprintln("")
            p.ctx.attr_errors = p.ctx.attr_errors + 1
            return
        wv = wv.next
        w = w + 1

fn enum_variant_record_impl(p: *Parser, name_sv: StrView, kind: i32, fields: *StructField, explicit: i32, discr: i64, discr_neg: i32, line: i32, col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *EnumDef = enum_cur(p)
    if e == null
        return 0
    # The same token again: `enum_variants : enum_variant enum_variants`
    # fails after the last variant and backtracks into `enum_variant`, which
    # runs this action a second time for it.  That used to record a phantom
    # copy of every enum's last variant (AGAST #1880 found it: the copy
    # shares its discriminant).
    let last: *EnumVariant = enum_variant_tail(e)
    if last != null and last.name == name
        return 0
    # The discriminant: explicit, else the previous variant's + 1, else 0.
    var bits: i64 = discr
    var neg: i32 = discr_neg
    if explicit == 0
        bits = 0
        neg = 0
        if last != null
            bits = last.discr + 1
            neg = last.discr_neg
            if neg == 1 and bits == 0
                neg = 0
    let vnode: *EnumVariant = parser_alloc(p, sizeof(EnumVariant)) as *EnumVariant
    vnode.name = name
    vnode.name_len = len
    vnode.kind = kind
    vnode.fields = fields
    vnode.discr = bits
    vnode.discr_neg = neg
    vnode.next = null
    if e.variants == null
        e.variants = vnode
    else
        last.next = vnode
    enum_variant_check(p, e, enum_variant_count_node(e) - 1, kind, explicit, line, col)
    return 0

# Lookup: returns the variant's tag index (0-based) within an enum, or -1
# when either the enum or the variant is unknown.
pub fn enum_variant_index(ctx: *ParseCtx, enum_name_sv: StrView, var_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var var_name: *u8 = var_name_sv.ptr
    var var_name_len: i32 = var_name_sv.len as i32
    let e: *EnumDef = enum_find_node(ctx, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    if e == null
        return 0 - 1
    enum_variant_slot_node(e, StrView { ptr: (var_name), len: (var_name_len) as i64 })

# Returns 1 if name is a known enum type, 0 otherwise.
pub fn is_enum_type(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    (enum_find_node(ctx, StrView { ptr: (name), len: (len) as i64 }) != null) as i32

# --- AGAST #1797: enum / variant accessors for the emitter -----------------

# 1 when `e`'s name is `name`.
fn enum_name_eq(e: *EnumDef, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if e == null or e.name_len != len
        return 0
    let stored: *u8 = e.name
    for k in 0..len
        let sb: u8 = *(stored + k)
        let qb: u8 = *(name + k)
        if sb != qb
            return 0
    return 1

# The EnumDef named `name`, or null.  The first one recorded wins, as in
# enum_variant_index.
pub fn enum_find_node(ctx: *ParseCtx, name_sv: StrView) -> *EnumDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var e: *EnumDef = ctx.program_enums
    while e != null
        if enum_name_eq(e, StrView { ptr: (name), len: (len) as i64 }) == 1
            return e
        e = e.next
    null

# Index of the enum `name`, or -1.  The first one recorded wins.
pub fn enum_find(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var e: *EnumDef = ctx.program_enums
    var ei: i32 = 0
    while e != null
        if enum_name_eq(e, StrView { ptr: (name), len: (len) as i64 }) == 1
            return ei
        e = e.next
        ei = ei + 1
    return 0 - 1

pub fn enum_count(ctx: *ParseCtx) -> i32
    var n: i32 = 0
    var e: *EnumDef = ctx.program_enums
    while e != null
        n = n + 1
        e = e.next
    n

pub fn enum_name_at(ctx: *ParseCtx, ei: i32, out_len: *i32) -> *u8
    let e: *EnumDef = enum_node_at(ctx, ei)
    if e == null
        *out_len = 0
        return null
    *out_len = e.name_len
    e.name

pub fn enum_is_generic(ctx: *ParseCtx, ei: i32) -> i32
    let e: *EnumDef = enum_node_at(ctx, ei)
    if e == null
        return 0
    e.generic

# AGAST #2422: EnumDef.generic is ENUM_INSTANCE for `Slot$i32`, an instance of
# a generic enum that monomorph recorded (enum_record_instance).  It is a
# concrete enum (enum_is_generic(e) != 1), with ritz0's layout, but no declarer
# of its variants: the template `Slot` declares `Full`, however many instances.
pub const ENUM_INSTANCE: i32 = 2

# Record `name` (`Slot$i32`) as an instance of generic enum `base`: its variants
# in order, with their kinds and discriminants, variant `vi` carrying
# *(fields + vi).  Returns its index.
pub fn enum_record_instance(ctx: *ParseCtx, base: i32, name_sv: StrView, fields: **StructField) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let be: *EnumDef = enum_node_at(ctx, base)
    if be == null
        return 0 - 1
    let e: *EnumDef = malloc(sizeof(EnumDef)) as *EnumDef
    e.name = name
    e.name_len = len
    e.generic = ENUM_INSTANCE
    e.repr = TypeKind.Void
    e.is_pub = be.is_pub
    e.line = be.line
    e.variants = null
    e.next = null
    e.def_file = null   # AGAST #3494 (R65): an instance is declared by no file
    if ctx.program_enums == null
        ctx.program_enums = e
    else
        enum_list_append(ctx.program_enums, e)
    var vi: i32 = 0
    var bv: *EnumVariant = be.variants
    var last: *EnumVariant = null
    while bv != null
        let vnode: *EnumVariant = malloc(sizeof(EnumVariant)) as *EnumVariant
        vnode.name = bv.name
        vnode.name_len = bv.name_len
        vnode.kind = bv.kind
        vnode.fields = *(fields + vi)
        vnode.discr = bv.discr
        vnode.discr_neg = bv.discr_neg
        vnode.next = null
        if last == null
            e.variants = vnode
        else
            last.next = vnode
        last = vnode
        bv = bv.next
        vi = vi + 1
    enum_count(ctx) - 1

pub fn enum_variant_count(ctx: *ParseCtx, ei: i32) -> i32
    enum_variant_count_node(enum_node_at(ctx, ei))

# Name of variant `vi` of enum `ei`.
pub fn enum_variant_name(ctx: *ParseCtx, ei: i32, vi: i32, out_len: *i32) -> *u8
    let v: *EnumVariant = enum_variant_at_node(enum_node_at(ctx, ei), vi)
    if v == null
        *out_len = 0
        return null
    *out_len = v.name_len
    v.name

# Kind (ENUM_VARIANT_*) and payload fields of variant `vi` of enum `ei`.
pub fn enum_variant_kind(ctx: *ParseCtx, ei: i32, vi: i32) -> i32
    let v: *EnumVariant = enum_variant_at_node(enum_node_at(ctx, ei), vi)
    if v == null
        return ENUM_VARIANT_UNIT
    v.kind

pub fn enum_variant_fields(ctx: *ParseCtx, ei: i32, vi: i32) -> *StructField
    let v: *EnumVariant = enum_variant_at_node(enum_node_at(ctx, ei), vi)
    if v == null
        return null
    v.fields

# LANGUAGE_SPEC §10.4: enum `ei`'s representation type (0: none) and the
# discriminant bits of its variant `vi`.
pub fn enum_repr(ctx: *ParseCtx, ei: i32) -> TypeKind
    let e: *EnumDef = enum_node_at(ctx, ei)
    if e == null
        return TypeKind.Void
    e.repr

pub fn enum_variant_discr(ctx: *ParseCtx, ei: i32, vi: i32) -> i64
    let v: *EnumVariant = enum_variant_at_node(enum_node_at(ctx, ei), vi)
    if v == null
        return 0 as i64
    v.discr

# Field 0 of unit-variant user enum `ei` (LANGUAGE_SPEC §10.1, AGAST #4574):
# an `enum E: <int>` holds its discriminant in its repr type, any other enum
# a one-byte variant index.  enum_tag_llvm spells field 0's LLVM type;
# enum_tag_value is variant `vi`'s value there, as a signed literal of that
# width (`i32 -1`, never `i32 4294967295`).  Same layout as ritz0's
# _set_enum_body / _enum_tag_const.
pub fn enum_tag_llvm(ctx: *ParseCtx, ei: i32) -> *u8
    let r: TypeKind = enum_repr(ctx, ei)
    if ty_int_bits(r) == 0
        return c"i8"
    ty_mem_llvm(r)

pub fn enum_tag_value(ctx: *ParseCtx, ei: i32, vi: i32) -> i64
    let r: TypeKind = enum_repr(ctx, ei)
    let bits: i32 = ty_int_bits(r)
    if bits == 0
        return vi as i64
    let d: i64 = enum_variant_discr(ctx, ei, vi)
    if bits == 8
        return const_wrap_to_type(TypeKind.I8, d)
    if bits == 16
        return const_wrap_to_type(TypeKind.I16, d)
    if bits == 32
        return const_wrap_to_type(TypeKind.I32, d)
    d

# Bytes (and alignment) field 0 of enum `ei` occupies: its repr type's size,
# else 1 (the index tag).
pub fn enum_tag_size(ctx: *ParseCtx, ei: i32) -> i64
    let bits: i32 = ty_int_bits(enum_repr(ctx, ei))
    if bits == 0
        return 1
    (bits / 8) as i64

# 1 when enum `ei`'s field 0 holds a signed discriminant (an `iN` repr).
pub fn enum_tag_signed(ctx: *ParseCtx, ei: i32) -> i32
    ty_is_signed(enum_repr(ctx, ei))

# 1 when every variant's discriminant is its index (no `= N` moved one).
pub fn enum_discr_is_index(ctx: *ParseCtx, ei: i32) -> i32
    for vi in 0..enum_variant_count(ctx, ei)
        if enum_variant_discr(ctx, ei, vi) != vi as i64
            return 0
    return 1

# `E__from`, the fn `E.from(v)` calls (LANGUAGE_SPEC §10.4): the receiver's
# name + "__from", malloc'd.  *out_len gets its length.
pub fn enum_from_fn_name(name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let buf: *u8 = malloc((len + 7) as i64)
    for i in 0..len
        *(buf + i) = *(name + i)
    let suffix: *u8 = c"__from"
    for j in 0..6
        *(buf + len + j) = *(suffix + j)
    *(buf + len + 6) = 0
    *out_len = len + 6
    return buf

# Is `e` the method call `E.from(...)` on the bare name of an enum?
pub fn is_enum_from_call(ctx: *ParseCtx, e: *Expr) -> i32
    if e.kind != ExprKind.Method or e.left == null or e.left.kind != ExprKind.Ident
        return 0
    if e.ident_len != 4 or memcmp(e.ident_ptr, c"from", 4) != 0
        return 0
    if enum_find(ctx, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) < 0
        return 0
    return 1

# --- E.from source (LANGUAGE_SPEC §10.4) -----------------------------------
# ritz0 generates the same text (parser.py, enum_from_source): for each enum
# with a representation type,
#
#     [pub ]fn E__from(v: T) -> Option<E>
#         if v == <discriminant>
#             return Some(E.V)
#         ...
#         return None
#
# preceded by enough newlines that it starts on the enum's line.  The driver
# parses it into the enum's module (main.ritz, add_enum_from_fns).

# State: ParseCtx.gen_buf, .gen_len, .gen_cap

fn gen_push(ctx: *ParseCtx, b: *u8, n: i64)
    if ctx.gen_len + n + 1 > ctx.gen_cap
        var cap: i64 = ctx.gen_cap * 2 + n + 256
        ctx.gen_buf = realloc(ctx.gen_buf, cap)
        ctx.gen_cap = cap
    for i in 0..n
        *(ctx.gen_buf + ctx.gen_len + i) = *(b + i)
    ctx.gen_len = ctx.gen_len + n
    *(ctx.gen_buf + ctx.gen_len) = 0

fn gen_cstr(ctx: *ParseCtx, c: *u8)
    var n: i64 = 0
    while *(c + n) != 0
        n = n + 1
    gen_push(ctx, c, n)

# sign + 20 digits of a u64 + NUL (AGAST #1820: no magic alloc sizes).
const I64_DEC_BUF: i64 = 24

# The discriminant as a literal: decimal, or hex for a u64 >= 2^63.
fn gen_discr(ctx: *ParseCtx, bits: i64, neg: i32)
    let digits: *u8 = malloc(I64_DEC_BUF)
    var n: i32 = 0
    if neg == 0 and bits < 0
        gen_cstr(ctx, c"0x")
        while n < 16
            let nib: i64 = (bits >> ((15 - n) * 4) as i64) & 15
            if nib < 10
                *(digits + n) = (48 + nib) as u8
            else
                *(digits + n) = (87 + nib) as u8
            n = n + 1
        gen_push(ctx, digits, 16)
        free(digits)
        return
    var m: i64 = bits
    if neg == 1
        gen_cstr(ctx, c"-")
        m = 0 - bits
        if m < 0
            gen_cstr(ctx, c"9223372036854775808")
            free(digits)
            return
    while m > 0 or n == 0
        *(digits + n) = (48 + m % 10) as u8
        m = m / 10
        n = n + 1
    var i: i32 = n - 1
    while i >= 0
        gen_push(ctx, digits + i, 1)
        i = i - 1
    free(digits)

# Source of `from` for every enum with a representation type in `m` (the
# module just parsed), or null if there is none.  *out_len gets its length.
# The buffer is the caller's to keep.
pub fn enum_from_source(ctx: *ParseCtx, m: *Module, out_len: *i64) -> *u8
    ctx.gen_buf = null
    ctx.gen_len = 0
    ctx.gen_cap = 0
    var line: i32 = 1
    var e: *EnumDef = m.enums
    while e != null
        let repr: TypeKind = e.repr
        if repr != TypeKind.Void and e.generic == 0
            let ename: *u8 = e.name
            let elen: i64 = e.name_len as i64
            while line < e.line
                gen_cstr(ctx, c"\n")
                line = line + 1
            if e.is_pub == 1
                gen_cstr(ctx, c"pub ")
            gen_cstr(ctx, c"fn ")
            gen_push(ctx, ename, elen)
            gen_cstr(ctx, c"__from(v: ")
            gen_cstr(ctx, primitive_name_from_type(repr))
            gen_cstr(ctx, c") -> Option<")
            gen_push(ctx, ename, elen)
            gen_cstr(ctx, c">\n")
            line = line + 1
            var v: *EnumVariant = e.variants
            while v != null
                gen_cstr(ctx, c"    if v == ")
                gen_discr(ctx, v.discr, v.discr_neg)
                gen_cstr(ctx, c"\n        return Some(")
                gen_push(ctx, ename, elen)
                gen_cstr(ctx, c".")
                gen_push(ctx, v.name, v.name_len as i64)
                gen_cstr(ctx, c")\n")
                line = line + 2
                v = v.next
            gen_cstr(ctx, c"    return None\n")
            line = line + 1
        e = e.next
    *out_len = ctx.gen_len
    return ctx.gen_buf

# 1 when enum `a`'s name sorts before enum `b`'s (bytewise; a proper prefix
# sorts first), else 0.
fn enum_name_lt(a: *EnumDef, b: *EnumDef) -> i32
    let ap: *u8 = a.name
    let bp: *u8 = b.name
    let a_len: i32 = a.name_len
    let b_len: i32 = b.name_len
    var k: i32 = 0
    while k < a_len and k < b_len
        let ab: u8 = *(ap + k)
        let bb: u8 = *(bp + k)
        if ab < bb
            return 1
        if ab > bb
            return 0
        k = k + 1
    if a_len < b_len
        return 1
    return 0

# The tag of variant `name` within enum `e`, or -1.
fn enum_variant_slot_node(e: *EnumDef, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if e == null
        return 0 - 1
    var vi: i32 = 0
    var v: *EnumVariant = e.variants
    while v != null
        if v.name_len == len
            var same: i32 = 1
            let stored: *u8 = v.name
            for k in 0..len
                let sb: u8 = *(stored + k)
                let qb: u8 = *(name + k)
                if sb != qb
                    same = 0
            if same == 1
                return vi
        v = v.next
        vi = vi + 1
    return 0 - 1

# AGAST #1600 / #2039: the enum a bare variant name denotes, as a VALUE
# (`let s: S = B`) or a ctor call (`B()`, `Holds(x)`).  A name two or more
# non-generic enums declare is ambiguous whatever the expected type: it
# returns -2, with *out_vi set to the alphabetically-first declaring enum's
# index and *out_other to the second's, so the caller can name both (ritz0
# names the same two; declaration order differs between the compilers across
# imports).  -1 when no enum declares the name.  Otherwise the enum index,
# with *out_vi the variant's tag.
pub fn enum_of_variant_unique(ctx: *ParseCtx, name_sv: StrView, out_vi: *i32, out_other: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_vi = 0 - 1
    *out_other = 0 - 1
    # lo / hi: the two alphabetically-smallest distinct declarers so far.
    var lo: *EnumDef = null
    var lo_i: i32 = 0 - 1
    var lo_vi: i32 = 0 - 1
    var hi: *EnumDef = null
    var hi_i: i32 = 0 - 1
    var e: *EnumDef = ctx.program_enums
    var ei: i32 = 0
    while e != null
        if e.generic == 0
            let vi: i32 = enum_variant_slot_node(e, StrView { ptr: (name), len: (len) as i64 })
            if vi >= 0
                # The same enum recorded twice (a module reached again
                # through an import cycle, as tempest's tab.ritz is) is not
                # ambiguous; the list keys enums by name (enum_find).
                var dup: i32 = 0
                if lo != null and enum_name_eq(lo, StrView { ptr: (e.name), len: (e.name_len) as i64 }) == 1
                    dup = 1
                if hi != null and enum_name_eq(hi, StrView { ptr: (e.name), len: (e.name_len) as i64 }) == 1
                    dup = 1
                if dup == 0
                    if lo == null
                        lo = e
                        lo_i = ei
                        lo_vi = vi
                    else if enum_name_lt(e, lo) == 1
                        hi = lo
                        hi_i = lo_i
                        lo = e
                        lo_i = ei
                        lo_vi = vi
                    else if hi == null or enum_name_lt(e, hi) == 1
                        hi = e
                        hi_i = ei
        e = e.next
        ei = ei + 1
    if hi != null
        *out_vi = lo_i
        *out_other = hi_i
        return 0 - 2
    *out_vi = lo_vi
    return lo_i

# =============================================================================
# AGAST #1794: `id<@E>(e)` and `a[:]`
# =============================================================================
# Kept together here, apart from the generic-arg speller, so they stay out of
# that code's way.

# Reference-typed generic call: `id<@E>(e)` builds the suffix `$ref_E`, as
# ritz0 mangles a RefType argument (monomorph.py mangle_type_name).
# monomorph substitutes T with a pointer to E for it, as for `$ptr_E`
# (suffix_is_ptr): a reference is a pointer at the IR level.
pub fn postfix_generic_call_ref(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # "$ref_" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    tn_note_tok(p, type_tok)   # AGAST #4171
    op.call_type_suffix = generic_tok_suffix(p, StrView { ptr: (c"ref_"), len: (4) as i64 }, type_tok, @len)
    op.call_type_suffix_len = len
    op.call_targs = generic_tok_arg(p, type_tok)
    op.next = null
    return op

# full_slice_tail : '[' ':' ']' postfix_ops  →  a marker whose `next` holds
# the postfix ops that follow the slice.  Never null, so `full_slice_tail?`
# can tell "present with nothing after" from "absent".
pub fn full_slice_tail_new(p: *Parser, rest: *PostfixOp) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_INDEX
    op.args = null
    op.call_type_suffix = null
    op.call_type_suffix_len = 0
    op.index = null
    op.member_name = null
    op.member_len = 0
    op.bracket.line = 0
    op.next = rest
    return op

# The method call `recv.name(args)` (no generic suffix) as ExprKind.Method.
fn method_call_expr(p: *Parser, recv: *Expr, name_sv: StrView, args: *Expr) -> *Expr
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let m: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    m.kind = ExprKind.Method
    m.span = recv.span
    m.left = recv
    m.ident_ptr = name
    m.ident_len = name_len
    m.args = args
    m.call_type_suffix = null
    m.call_type_suffix_len = 0
    m.bracket.line = 0   # no name written here: errors fall back to span (#3419)
    m.bracket.col = 0
    m.next = null
    return m

# `a[:]`  →  `a.slice(0, a.len())`, then the ops after the slice.  This is
# ritz0's lowering (emitter _emit_slice): vec_slice<T>(&v, 0, len) for a Vec
# (a COPY: angelo's documented clone idiom), string_slice for a String, a
# sub-span for a Span.  Lowering through the method keeps it visible to
# monomorph, which instantiates vec_slice$T from the method call.  The
# receiver node is shared by both calls; ritz0 likewise requires an lvalue
# receiver, so evaluating it twice has no side effects to repeat.
pub fn apply_full_slice_p(p: *Parser, recv: *Expr, tail: *PostfixOp) -> *Expr
    if tail == null
        return recv
    let len_call: *Expr = method_call_expr(p, recv, StrView { ptr: (c"len"), len: (3) as i64 }, null)
    let zero: *Expr = expr_int(p, 0, recv.span.line, recv.span.col)
    let slice: *Expr = method_call_expr(p, recv, StrView { ptr: (c"slice"), len: (5) as i64 }, expr_link(zero, len_call))
    return apply_postfix_p(p, slice, tail.next)

# The TYPE_* kind a primitive type name spells ("u8", "i32", ..., "bool"),
# else 0.  Shared by monomorph (suffix -> substituted kind) and the let-path
# narrowing of a `-> *T` generic call (AGAST #1980).
# AGAST #1984: the inverse of primitive_type_from_name.  null / 0 for a
# non-primitive kind (struct, pointer, array, ...).
pub fn primitive_name_from_type(t: TypeKind) -> *u8
    match t
        TypeKind.U8 =>
            return c"u8"
        TypeKind.I8 =>
            return c"i8"
        TypeKind.U16 =>
            return c"u16"
        TypeKind.I16 =>
            return c"i16"
        TypeKind.U32 =>
            return c"u32"
        TypeKind.I32 =>
            return c"i32"
        TypeKind.U64 =>
            return c"u64"
        TypeKind.I64 =>
            return c"i64"
        TypeKind.F32 =>
            return c"f32"
        TypeKind.F64 =>
            return c"f64"
        TypeKind.Bool =>
            return c"bool"
        _ => pass
    null

pub fn primitive_name_len(t: TypeKind) -> i32
    if ty_int_bits(t) == 8
        return 2
    if t == TypeKind.Bool
        return 4
    if primitive_name_from_type(t) != null
        return 3
    0

pub fn primitive_type_from_name(name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return TypeKind.Void
    if len == 2
        if memcmp(name, c"u8", 2) == 0
            return TypeKind.U8
        if memcmp(name, c"i8", 2) == 0
            return TypeKind.I8
    if len == 3
        if memcmp(name, c"u16", 3) == 0
            return TypeKind.U16
        if memcmp(name, c"i16", 3) == 0
            return TypeKind.I16
        if memcmp(name, c"u32", 3) == 0
            return TypeKind.U32
        if memcmp(name, c"i32", 3) == 0
            return TypeKind.I32
        if memcmp(name, c"u64", 3) == 0
            return TypeKind.U64
        if memcmp(name, c"i64", 3) == 0
            return TypeKind.I64
        if memcmp(name, c"f32", 3) == 0
            return TypeKind.F32
        if memcmp(name, c"f64", 3) == 0
            return TypeKind.F64
    if len == 4
        if memcmp(name, c"bool", 4) == 0
            return TypeKind.Bool
    # AGAST #2198: as type_named parses them, so a monomorph's `v: T` at
    # T = usize (`Box$usize`) is the u64 field a written `v: usize` is.
    if is_word_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return word_type(name)
    TypeKind.Void

# `enum Slot<A, B>`'s parameters, read off the source after its name: the
# grammar's action records the enum as generic but drops the list
# (enum_def_header).  null when no `<...>` follows the name.
pub fn generic_enum_params(ctx: *ParseCtx, ei: i32) -> *TypeParam
    let e: *EnumDef = enum_node_at(ctx, ei)
    if e == null
        return null
    let name: *u8 = e.name
    var p: *u8 = name + e.name_len
    while *p == ' ' or *p == 9
        p = p + 1
    if *p != '<'   # '<'
        return null
    p = p + 1
    var first: *TypeParam = null
    var last: *TypeParam = null
    while *p != '>' and *p != 0 and *p != 10   # '>', NUL, newline
        if *p == ' ' or *p == 9 or *p == ','   # ' ', '\t', ','
            p = p + 1
        else
            let start: *u8 = p
            var n: i32 = 0
            while *p != '>' and *p != 0 and *p != 10 and *p != ' ' and *p != 9 and *p != ','
                p = p + 1
                n = n + 1
            let tp: *TypeParam = malloc(sizeof(TypeParam)) as *TypeParam
            tp.name = start
            tp.name_len = n
            tp.next = null
            tp.bounds = null
            if last == null
                first = tp
            else
                last.next = tp
            last = tp
    first

# AGAST #3021: how many type parameters generic enum `ei` declares
# (`enum Two<A, B>` 2), 0 for a concrete enum or an instance.
pub fn enum_type_param_count(ctx: *ParseCtx, ei: i32) -> i32
    if ei < 0 or enum_is_generic(ctx, ei) != 1
        return 0
    var n: i32 = 0
    var tp: *TypeParam = generic_enum_params(ctx, ei)
    while tp != null
        n = n + 1
        tp = tp.next
    n

# AGAST #2927: the generic enum (`enum Slot<T>`) that alone declares variant
# `name`, *out_vi its tag; -1 when none does, or another enum declares it too
# (#2039's ambiguity, reported where the constructor is emitted).  An instance
# (ENUM_INSTANCE) declares nothing of its own, and an enum recorded twice
# through an import cycle is one enum.
pub fn generic_enum_of_variant(ctx: *ParseCtx, name_sv: StrView, out_vi: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_vi = 0 - 1
    var found: *EnumDef = null
    var found_i: i32 = 0 - 1
    var e: *EnumDef = ctx.program_enums
    var ei: i32 = 0
    while e != null
        if e.generic != ENUM_INSTANCE
            let vi: i32 = enum_variant_slot_node(e, StrView { ptr: (name), len: (len) as i64 })
            if vi >= 0
                if found == null
                    found = e
                    found_i = ei
                    *out_vi = vi
                else if enum_name_eq(found, StrView { ptr: (e.name), len: (e.name_len) as i64 }) == 0
                    *out_vi = 0 - 1
                    return 0 - 1
        e = e.next
        ei = ei + 1
    if found == null or found.generic != 1
        *out_vi = 0 - 1
        return 0 - 1
    found_i
