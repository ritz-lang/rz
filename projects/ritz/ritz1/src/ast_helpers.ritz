# ritz1/src/ast_helpers.ritz - AST Helper Functions for Generated Parser
#
# These functions are called by the parser generated from ritz1.grammar.
# They allocate AST nodes using bump allocation from the parser arena.

# Import AST types only - no ritzlib dependencies for standalone compilation
import ast
import tokens_gen
import lexer_nfa
import ritzlib.memory
import ritzlib.io
import ritzlib.sys

# =============================================================================
# Parser allocation (bump allocator using parser's arena)
# =============================================================================

# AGAST #1730 — capacity in bytes of the arena the current parse allocates
# from, set by whoever mallocs it (parse_tokens, interp).  parser_alloc had
# no bound: ritz1's own emitter_stmt.ritz overran the fixed 4 MB arena by
# ~7.5k nodes and silently corrupted the heap until a small change made it
# fatal.  0 = unknown (no check).
var g_parser_arena_cap: i64 = 0

pub fn parser_arena_set_cap(cap: i64)
    g_parser_arena_cap = cap

pub fn parser_alloc(p: *Parser, size: i64) -> *u8
    # Bump allocator using the parser's heap arena
    # Align to 8-byte boundary for pointers
    let aligned_offset: i64 = (p.heap_offset + 7) & (0 - 8)
    let result: *u8 = p.heap_base + aligned_offset
    p.heap_offset = aligned_offset + size
    if g_parser_arena_cap > 0 and p.heap_offset > g_parser_arena_cap
        eprints_cstr(c"error: ritz1 parser arena exhausted; refusing to overrun the heap\n")
        sys_exit(70)
    return result

# =============================================================================
# Module helpers
# =============================================================================

var g_fn_count: i32 = 0

pub fn get_fn_count() -> i32
    g_fn_count

pub fn module_new(p: *Parser) -> *Module
    # One module_new per file parsed, so this is the per-parse reset point
    # for the dropped-item counter checked by module_require_eof.
    parser_reset_diagnostics()
    let m: *Module = parser_alloc(p, 56) as *Module  # Increased for impls field
    m.imports = null
    m.constants = null
    m.structs = null
    m.functions = null
    m.globals = null
    m.impls = null
    p.module = m
    return m

pub fn module_add_fn(m: *Module, f: *FnDef)
    g_fn_count = g_fn_count + 1
    if m.functions == null
        m.functions = f
    else
        # Append to end of list
        var curr: *FnDef = m.functions
        while curr.next != null
            curr = curr.next
        curr.next = f

# =============================================================================
# target_os conditional-compilation filter
# =============================================================================
#
# Items marked `[[target_os = "X"]]` are kept only when X is the target OS
# (`--target-os`, default "linux" as in ritz0; AGAST #1550).  The skipped
# variants must never reach the module — otherwise the wrong variant can win
# the name-based dedup, breaking syscalls (e.g. sys_mmap with 4 params
# instead of 6 → r8/r9 garbage → EINVAL → crash).
#
# parse_attr calls check_target_os_filter(p, ident, str) after successfully
# matching `[[ident = "string"]]`. If ident == "target_os" and string is not
# the target OS, we set p.skip_item = 1. parse_item consumes this flag and
# drops the item instead of adding it to the module.

# The target OS.  null means the default, "linux".  Set once by main.
var g_target_os: *u8 = null
var g_target_os_len: i32 = 0

pub fn set_target_os(os: *u8, os_len: i32)
    g_target_os = os
    g_target_os_len = os_len

# Check two byte buffers for exact equality over `len` bytes.
# Duplicated here (not imported from emitter_core) to keep ast_helpers
# free of emitter dependencies.
fn buf_eq(a: *u8, a_len: i32, b: *u8, b_len: i32) -> i32
    if a_len != b_len
        return 0
    for i in 0..a_len
        if *(a + i) != *(b + i)
            return 0
    1

# One row of the non-generic UFCS table: `pfx` when nothing matched yet and
# the receiver type is `ty`, else the earlier result unchanged.
pub fn ufcs_row(found: *u8, type_name: *u8, type_name_len: i32, ty: *u8, ty_len: i32, pfx: *u8, pfx_len: i32, out_len: *i32) -> *u8
    if found != null
        return found
    if buf_eq(type_name, type_name_len, ty, ty_len) == 0
        return null
    *out_len = pfx_len
    return pfx

# Free-function prefix for a method on a non-generic ritzlib type
# (`s.push_str(x)` -> `string_push_str(@s, x)`), or null. NOT the lowercased
# type name: Buffer -> buf_, ArgParser -> args_. Mirrors ritz0's
# UFCS_NON_GENERIC_PREFIXES (emitter_llvmlite.py); test_ritz1_ufcs_prefix.py
# asserts the two tables agree, so edit both. (AGAST #1368)  Here, not in
# emitter_expr_call, so monomorph's static-call rewrite reads it too (#2575).
pub fn ufcs_non_generic_prefix(type_name: *u8, type_name_len: i32, out_len: *i32) -> *u8
    var p: *u8 = null
    # BEGIN UFCS_NON_GENERIC_PREFIXES
    p = ufcs_row(p, type_name, type_name_len, c"String", 6, c"string_", 7, out_len)
    p = ufcs_row(p, type_name, type_name_len, c"GrowBuf", 7, c"growbuf_", 8, out_len)
    p = ufcs_row(p, type_name, type_name_len, c"Buffer", 6, c"buf_", 4, out_len)
    p = ufcs_row(p, type_name, type_name_len, c"ArgParser", 9, c"args_", 5, out_len)
    # END UFCS_NON_GENERIC_PREFIXES
    return p

pub fn check_target_os_filter(p: *Parser, ident_start: *u8, ident_len: i32, str_val: *u8, str_len: i32)
    # Only act on `target_os` attribute.
    if buf_eq(ident_start, ident_len, c"target_os", 9) == 0
        return
    if g_target_os == null
        if buf_eq(str_val, str_len, c"linux", 5) == 1
            return
    else if buf_eq(str_val, str_len, g_target_os, g_target_os_len) == 1
        return
    p.skip_item = 1

# AGAST #1908: `[[test]]` (LANGUAGE_SPEC §17.1).  attr_flag notes it for the
# item being parsed (ATTR_TEST in g_attr_bits); item_dispatch_fn records that
# FnDef in g_test_fns, and every dispatcher clears the note.  A side list
# rather than an FnDef field: FnDefs come from parser_alloc (not zeroed) and
# monomorph's malloc'd clones, so a new field would be garbage on every
# allocation site that did not set it.  Pointers are compared by identity: a
# clone is never a test.
var g_test_fns: *i64 = null
var g_test_fn_count: i64 = 0
var g_test_fn_cap: i64 = 0

fn test_fn_record(f: *FnDef)
    if g_test_fn_count == g_test_fn_cap
        var cap: i64 = g_test_fn_cap * 2
        if cap == 0
            cap = 16
        let grown: *i64 = realloc(g_test_fns as *u8, cap * 8) as *i64
        if grown == null
            eprints_cstr(c"error: ritz1: out of memory recording [[test]] functions\n")
            sys_exit(70)
        g_test_fns = grown
        g_test_fn_cap = cap
    *(g_test_fns + g_test_fn_count) = f as i64
    g_test_fn_count = g_test_fn_count + 1

# 1 if `f` was declared `[[test]]` (by identity; see above).
pub fn is_test_fn(f: *FnDef) -> i32
    let key: i64 = f as i64
    var i: i64 = 0
    while i < g_test_fn_count
        if *(g_test_fns + i) == key
            return 1
        i = i + 1
    0

# 1 if `f` was declared `[[test_helper]]` (AGAST #1869), or is a monomorph
# instance of such a fn (fn_copy_instance_attrs marks those).
pub fn is_test_helper_fn(f: *FnDef) -> i32
    if (item_attr_bits(f as *u8) & ATTR_TEST_HELPER) != 0
        return 1
    0

# 1 if `f` was declared `[[must_use]]` (AGAST #2137), or is a monomorph
# instance of such a fn (fn_copy_instance_attrs marks those).
pub fn is_must_use_fn(f: *FnDef) -> i32
    if f != null and (item_attr_bits(f as *u8) & ATTR_MUST_USE) != 0
        return 1
    0

pub fn test_fn_count() -> i64
    g_test_fn_count

pub fn test_fn_at(i: i64) -> *FnDef
    *(g_test_fns + i) as *FnDef

# Forget every recorded test fn: the driver re-parses from scratch (#1475).
pub fn test_fns_reset()
    g_test_fn_count = 0
    g_attr_bits = 0
    # The re-parse allocates new items, possibly at a freed item's address.
    g_item_attr_count = 0

# =============================================================================
# Item dispatchers — honour p.skip_item set by attrs (5F.3c)
# =============================================================================
#
# Conditional-compilation flow:
#   1. parse_attrs walks the [[ ... ]] attribute list.  For
#      `[[target_os = "<not the target>"]]`, attr_target_os sets p.skip_item = 1.
#   2. The matching `attrs <item>` alternative in parse_item then calls
#      one of these dispatchers, which:
#        - skip the module_add_* call when p.skip_item == 1
#        - reset p.skip_item to 0
#        - return 1 to signal "alternative matched" to the multi-alt
#          generator template (which only emits `return 1` on void rules;
#          we want explicit-return semantics here for the skip case).
#
# Without these, the grammar action would need to be multi-statement
# (`if not skipped: add_to_module; reset; return 1`), which ritzgen
# doesn't yet support — so we hide the conditional inside a helper.
pub fn item_dispatch_fn(p: *Parser, fn_def: *FnDef) -> i32
    if p.skip_item == 0
        module_add_fn(p.module, fn_def)
        # AGAST #2148: what main.ritz's fn-conflict checks read.
        fn_def.def_file = parse_file_copy_shared(p)
        if (g_attr_bits & ATTR_TARGET_OS) != 0
            fn_def.target_gated = 1
        if (g_attr_bits & ATTR_TEST) != 0
            if fn_is_decl(fn_def) == 1
                decl_refused(fn_def.line, c"[[test]] fn", fn_def.name, fn_def.name_len, null, 0, c"a test needs its body")
            test_fn_record(fn_def)
        let fn_bits: i32 = g_attr_bits & (ATTR_INLINE | ATTR_ALWAYS_INLINE | ATTR_NOINLINE | ATTR_WIN64 | ATTR_TEST_HELPER | ATTR_MUST_USE)
        if fn_bits != 0
            item_attr_record(fn_def as *u8, fn_bits)
    p.skip_item = 0
    g_attr_bits = 0
    return 1

pub fn item_dispatch_struct(p: *Parser, st: *StructDef) -> i32
    if p.skip_item == 0
        module_add_struct(p.module, st)
        if (g_attr_bits & ATTR_PACKED) != 0
            item_attr_record(st as *u8, ATTR_PACKED)
    p.skip_item = 0
    g_attr_bits = 0
    return 1

pub fn item_dispatch_const(p: *Parser, c: *ConstEntry) -> i32
    if p.skip_item == 0
        if (g_attr_bits & ATTR_TARGET_OS) != 0
            c.target_gated = 1
        module_add_const(p.module, c)
    p.skip_item = 0
    g_attr_bits = 0
    return 1

pub fn item_dispatch_global(p: *Parser, g: *GlobalVarDef) -> i32
    if p.skip_item == 0
        module_add_global_var(p.module, g)
    p.skip_item = 0
    g_attr_bits = 0
    return 1

pub fn item_dispatch_enum(p: *Parser) -> i32
    # enum has no AST node yet; just reset skip flag and report progress.
    p.skip_item = 0
    g_attr_bits = 0
    return 1

# =============================================================================
# Top-level parse termination check (AGAST #1301)
# =============================================================================
#
# `item*` in the module rule stops at the first item it cannot parse.  That
# stop is silent by construction: "no more items" and "this item is
# unparseable" look identical to the generated star-loop.  Before this
# check, the consequence was a module containing only the items before the
# failure, emitted as IR with a zero exit status — a genuine parser gap
# reported as an undefined symbol at link time, or (if nothing referenced
# the dropped function) as a silently wrong binary with no error at all.
#
# module_require_eof runs after item* and asserts the whole token stream was
# consumed.  If it wasn't, it reports file:line:col plus the leading tokens
# of the offending construct and sets p.error, which makes parse_module
# return null and the driver exit non-zero *before* any artifact is written.
#
# Fail loudly.  Partial output is strictly worse than a hard error.

# Path of the file currently being parsed, for diagnostics.  Set by the
# driver (main.ritz) before each parse; null renders as "<input>".
var g_parse_file: *u8

# Count of top-level items the anchor-skip recovery had to throw away for
# the module currently being parsed.  Reset by module_new (i.e. once per
# file), checked by module_require_eof.  Non-zero ⇒ hard parse failure.
var g_dropped_items: i32 = 0

pub fn parser_set_source_file(path: *u8)
    g_parse_file = path

pub fn parser_reset_diagnostics()
    g_dropped_items = 0
    g_attr_errors = 0
    g_attr_last_err = null
    g_array_len_line = -1
    g_array_len_col = -1

pub fn parser_dropped_items() -> i32
    g_dropped_items

# Write a token's raw lexeme (not NUL-terminated) to stderr.
fn eprint_lexeme(start: *u8, len: i32)
    if start == null
        return
    var i: i32 = 0
    while i < len
        eprint_char(*(start + i))
        i = i + 1

# Print "<file>:<line>:<col>: " for the token at p.pos.
fn eprint_parse_location(p: *Parser)
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    if p.pos < p.token_count
        let tok: *Token = p.tokens + p.pos
        eprint_i64(tok.line as i64)
        eprint_char(':')
        eprint_i64(tok.col as i64)
    else
        eprints_cstr(c"0:0")
    eprints_cstr(c": ")

# Print the leading tokens of the construct at p.pos: the first token's
# lexeme plus, when it is followed by an identifier, that identifier — so
# `fn nested(...)` reports as `fn nested` rather than a bare `fn`.
fn eprint_construct(p: *Parser)
    if p.pos >= p.token_count
        eprints_cstr(c"<end of file>")
        return
    let tok: *Token = p.tokens + p.pos
    eprint_lexeme(tok.start, tok.len)
    if p.pos + 1 < p.token_count
        let nxt: *Token = p.tokens + (p.pos + 1)
        if nxt.kind == TOK_IDENT
            eprint_char(' ')
            eprint_lexeme(nxt.start, nxt.len)

# =============================================================================
# Attributes (LANGUAGE_SPEC §17, AGAST #1847)
# =============================================================================
#
# Attributes are a closed set.  ritz1 used to accept every bare `[[name]]`
# and drop it, so a `[[packed]]` struct got natural alignment and a
# `[[naked]]` fn a prologue — silently.  Now each attribute is honoured or
# is a located error, and ritz0/parser.py ATTRS holds the same table:
#
#   test           fn      g_test_fns (the test table, #1908)
#   target_os=".." fn, struct, const   item filtered out unless it matches
#   packed         struct  `<{ ... }>`, no padding, alignment 1
#   inline         fn      LLVM inlinehint
#   always_inline  fn      LLVM alwaysinline
#   noinline       fn      LLVM noinline
#   callconv=".."  fn, extern fn, fn-type alias   "win64" -> win64cc on the
#                          define / declare / call ("c" is the default)
#   naked          fn      rejected: the body must be asm and ritz1 has no
#                          inline asm yet (AGAST #1619)
#
# The grammar runs these actions before it knows which item follows, and it
# backtracks: `attrs` is re-parsed for every `item` alternative tried.  So
# the item kind comes from token lookahead (attr_item_kind), the bits for the
# item are noted in g_attr_bits and committed by the item_dispatch_* that
# succeeds, and an error is printed once per attribute token.
# p.error cannot carry the failure — it is the generated parser's
# backtracking signal — so module_require_eof checks g_attr_errors.

const ATTR_TEST: i32 = 1
const ATTR_PACKED: i32 = 2
const ATTR_INLINE: i32 = 4
const ATTR_ALWAYS_INLINE: i32 = 8
const ATTR_NOINLINE: i32 = 16
const ATTR_WIN64: i32 = 32       # [[callconv = "win64"]] (AGAST #1879)
const ATTR_TEST_HELPER: i32 = 64 # [[test_helper]]: may `assert` (AGAST #1869)
const ATTR_TARGET_OS: i32 = 128  # any [[target_os = ..]] (AGAST #2149)
const ATTR_MUST_USE: i32 = 256   # [[must_use]]: result may not be discarded (AGAST #2137)

const ATTR_ITEM_OTHER: i32 = 0
const ATTR_ITEM_FN: i32 = 1
const ATTR_ITEM_STRUCT: i32 = 2
const ATTR_ITEM_CONST: i32 = 3
const ATTR_ITEM_EXTERN_FN: i32 = 4
const ATTR_ITEM_FN_ALIAS: i32 = 5    # `type X = fn(..) ..`

var g_attr_bits: i32 = 0
var g_attr_errors: i32 = 0
var g_attr_last_err: *u8 = null

# (item pointer, ATTR_* bits) pairs, for attributes the emitter reads.
var g_item_attrs: *i64 = null
var g_item_attr_count: i64 = 0
var g_item_attr_cap: i64 = 0

# The kind of item the attribute list at p.pos is attached to: skip the rest
# of the attribute lines and a `pub`, then look at the keyword.
fn attr_item_kind(p: *Parser) -> i32
    var i: i32 = p.pos
    while i < p.token_count
        let tok: *Token = p.tokens + i
        if tok.kind == TOK_LBRACKET2
            var at_eol: i32 = 0
            while at_eol == 0 and i < p.token_count
                let t2: *Token = p.tokens + i
                if t2.kind == TOK_NEWLINE
                    at_eol = 1
                i = i + 1
        else if tok.kind == TOK_PUB or tok.kind == TOK_NEWLINE
            i = i + 1
        else if tok.kind == TOK_FN
            return ATTR_ITEM_FN
        else if tok.kind == TOK_STRUCT
            return ATTR_ITEM_STRUCT
        else if tok.kind == TOK_CONST
            return ATTR_ITEM_CONST
        else if tok.kind == TOK_EXTERN and i + 1 < p.token_count and (p.tokens + (i + 1)).kind == TOK_FN
            return ATTR_ITEM_EXTERN_FN
        else if tok.kind == TOK_TYPE and i + 3 < p.token_count and (p.tokens + (i + 3)).kind == TOK_FN
            return ATTR_ITEM_FN_ALIAS
        else
            return ATTR_ITEM_OTHER
    ATTR_ITEM_OTHER

# `error: <file>:<line>:<col>: attribute '<name>' <msg>`, once per token.
fn attr_error(name: *u8, len: i32, line: i32, col: i32, msg: *u8)
    if name == g_attr_last_err
        return
    g_attr_last_err = name
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": attribute '")
    eprint_lexeme(name, len)
    eprints_cstr(c"' ")
    eprintln_cstr(msg)

fn attr_unknown(name: *u8, len: i32, line: i32, col: i32)
    if name == g_attr_last_err
        return
    g_attr_last_err = name
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": unknown attribute '")
    eprint_lexeme(name, len)
    eprintln_cstr(c"' (known: always_inline, callconv, inline, must_use, naked, noinline, packed, target_os, test, test_helper)")

# 1 for the attributes written bare, `[[name]]`.
fn attr_is_bare_name(name: *u8, len: i32) -> i32
    if buf_eq(name, len, c"test", 4) == 1 or buf_eq(name, len, c"packed", 6) == 1
        return 1
    if buf_eq(name, len, c"test_helper", 11) == 1 or buf_eq(name, len, c"must_use", 8) == 1
        return 1
    if buf_eq(name, len, c"naked", 5) == 1 or buf_eq(name, len, c"inline", 6) == 1
        return 1
    if buf_eq(name, len, c"always_inline", 13) == 1 or buf_eq(name, len, c"noinline", 8) == 1
        return 1
    0

# Grammar action for `[[name]]`.
pub fn attr_flag(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> i32
    var bit: i32 = 0
    var applies_to: i32 = ATTR_ITEM_FN
    if buf_eq(name, len, c"test", 4) == 1
        bit = ATTR_TEST
    else if buf_eq(name, len, c"test_helper", 11) == 1
        bit = ATTR_TEST_HELPER
    else if buf_eq(name, len, c"must_use", 8) == 1
        bit = ATTR_MUST_USE
    else if buf_eq(name, len, c"packed", 6) == 1
        bit = ATTR_PACKED
        applies_to = ATTR_ITEM_STRUCT
    else if buf_eq(name, len, c"inline", 6) == 1
        bit = ATTR_INLINE
    else if buf_eq(name, len, c"always_inline", 13) == 1
        bit = ATTR_ALWAYS_INLINE
    else if buf_eq(name, len, c"noinline", 8) == 1
        bit = ATTR_NOINLINE
    else if buf_eq(name, len, c"naked", 5) == 1
        attr_error(name, len, line, col, c"is not supported by ritz1: a [[naked]] fn body may contain only asm, and ritz1 has no inline asm yet (AGAST #1619)")
        return 0
    else if buf_eq(name, len, c"target_os", 9) == 1
        attr_error(name, len, line, col, c"needs a value: [[target_os = <os name string>]]")
        return 0
    else if buf_eq(name, len, c"callconv", 8) == 1
        attr_error(name, len, line, col, c"needs a value: [[callconv = \"win64\"]] or [[callconv = \"c\"]]")
        return 0
    else
        attr_unknown(name, len, line, col)
        return 0
    if attr_item_kind(p) != applies_to
        if applies_to == ATTR_ITEM_STRUCT
            attr_error(name, len, line, col, c"applies to struct items only")
        else
            attr_error(name, len, line, col, c"applies to fn items only")
        return 0
    g_attr_bits = g_attr_bits | bit
    0

# Grammar action for `[[name = "value"]]`.
pub fn attr_kv(p: *Parser, name: *u8, len: i32, line: i32, col: i32, str_val: *u8, str_len: i32) -> i32
    if buf_eq(name, len, c"target_os", 9) == 1
        let tk: i32 = attr_item_kind(p)
        if tk != ATTR_ITEM_FN and tk != ATTR_ITEM_STRUCT and tk != ATTR_ITEM_CONST
            attr_error(name, len, line, col, c"applies to fn, struct or const items only")
            return 0
        g_attr_bits = g_attr_bits | ATTR_TARGET_OS
        check_target_os_filter(p, name, len, str_val, str_len)
        return 0
    if buf_eq(name, len, c"callconv", 8) == 1
        # LANGUAGE_SPEC §17.7 (AGAST #1879).
        let ck: i32 = attr_item_kind(p)
        if ck != ATTR_ITEM_FN and ck != ATTR_ITEM_EXTERN_FN and ck != ATTR_ITEM_FN_ALIAS
            attr_error(name, len, line, col, c"applies to fn, extern fn or fn-type alias items only")
            return 0
        if buf_eq(str_val, str_len, c"win64", 5) == 1
            g_attr_bits = g_attr_bits | ATTR_WIN64
        else if buf_eq(str_val, str_len, c"c", 1) == 0
            if name != g_attr_last_err
                g_attr_last_err = name
                g_attr_errors = g_attr_errors + 1
                eprints_cstr(c"error: ")
                if g_parse_file != null
                    eprints_cstr(g_parse_file)
                else
                    eprints_cstr(c"<input>")
                eprint_char(':')
                eprint_i64(line as i64)
                eprint_char(':')
                eprint_i64(col as i64)
                eprints_cstr(c": unknown calling convention '")
                eprint_lexeme(str_val, str_len)
                eprintln_cstr(c"' (known: c, win64)")
        return 0
    if attr_is_bare_name(name, len) == 1
        attr_error(name, len, line, col, c"takes no value")
        return 0
    attr_unknown(name, len, line, col)
    0

fn item_attr_record(item: *u8, bits: i32)
    if g_item_attr_count + 2 > g_item_attr_cap
        var cap: i64 = g_item_attr_cap * 2
        if cap == 0
            cap = 32
        let grown: *i64 = realloc(g_item_attrs as *u8, cap * 8) as *i64
        if grown == null
            eprints_cstr(c"error: ritz1: out of memory recording attributes\n")
            sys_exit(70)
        g_item_attrs = grown
        g_item_attr_cap = cap
    *(g_item_attrs + g_item_attr_count) = item as i64
    *(g_item_attrs + g_item_attr_count + 1) = bits as i64
    g_item_attr_count = g_item_attr_count + 2

# ATTR_* bits recorded for `item` (by identity), 0 if none.
fn item_attr_bits(item: *u8) -> i32
    let key: i64 = item as i64
    var i: i64 = 0
    while i < g_item_attr_count
        if *(g_item_attrs + i) == key
            return *(g_item_attrs + i + 1) as i32
        i = i + 2
    0

# 1 if `st` was declared `[[packed]]` (or is a clone of one: monomorph marks
# its specialisations with struct_mark_packed).
pub fn struct_is_packed(st: *StructDef) -> i32
    if st == null
        return 0
    if (item_attr_bits(st as *u8) & ATTR_PACKED) != 0
        return 1
    0

pub fn struct_mark_packed(st: *StructDef)
    item_attr_record(st as *u8, ATTR_PACKED)

# LLVM fn attribute text for `f`'s inline attribute (with a leading space),
# or "" when it has none.
pub fn fn_inline_attr(f: *FnDef) -> *u8
    let bits: i32 = item_attr_bits(f as *u8)
    if (bits & ATTR_INLINE) != 0
        return c" inlinehint"
    if (bits & ATTR_ALWAYS_INLINE) != 0
        return c" alwaysinline"
    if (bits & ATTR_NOINLINE) != 0
        return c" noinline"
    c""

# The LLVM calling-convention keyword for `f` with a trailing space
# ("win64cc "), or "" for the C convention (LANGUAGE_SPEC §17.7, AGAST
# #1879).  `f` is a fn, an extern fn, or the signature of a fn type (a
# `[[callconv]]` fn-type alias's, which type_alias_record marks).
pub fn fn_callconv_kw(f: *FnDef) -> *u8
    if f != null and (item_attr_bits(f as *u8) & ATTR_WIN64) != 0
        return c"win64cc "
    c""

# A monomorph specialisation `dst` carries its template `src`'s
# [[callconv]] (#1879), [[test_helper]] (#1869) and [[must_use]] (#2137): it calls, is called and
# may assert as the template does.  One record: an item's bits are read from
# its first record only (item_attr_bits).
pub fn fn_copy_instance_attrs(dst: *FnDef, src: *FnDef)
    if src == null
        return
    let bits: i32 = item_attr_bits(src as *u8) & (ATTR_WIN64 | ATTR_TEST_HELPER | ATTR_MUST_USE)
    if bits != 0
        item_attr_record(dst as *u8, bits)

# Called by the generated anchor-skip recovery in parse_item BEFORE it
# skips the construct it could not parse.  p.pos is still at the first
# token of that construct (every failed alternative rewinds to start_pos).
#
# The skip itself is fine — it lets us report every bad item in one run —
# but it must not be silent, and it must not leave the parse "successful".
# Recording the drop here is what turns a vanished function into a
# compile-time error instead of a link-time mystery (AGAST #1301).
pub fn parser_report_dropped_item(p: *Parser) -> i32
    g_dropped_items = g_dropped_items + 1
    eprints_cstr(c"error: ")
    eprint_parse_location(p)
    eprints_cstr(c"cannot parse item starting at '")
    eprint_construct(p)
    eprintln_cstr(c"'")
    return 1

pub fn module_require_eof(p: *Parser) -> i32
    # A rejected attribute was reported where it was written (#1847).
    if g_attr_errors > 0
        p.error = 1
        return 1

    # Any item the recovery skipped is a dropped top-level definition.
    if g_dropped_items > 0
        eprints_cstr(c"error: ")
        if g_parse_file != null
            eprints_cstr(g_parse_file)
        else
            eprints_cstr(c"<input>")
        eprints_cstr(c": ")
        eprint_i64(g_dropped_items as i64)
        eprintln_cstr(c" top-level item(s) failed to parse; refusing to emit a partial module")
        p.error = 1
        return 1

    if p.pos >= p.token_count
        return 0
    let tok: *Token = p.tokens + p.pos
    if tok.kind == TOK_EOF
        return 0

    # Unconsumed tokens remain: item* stopped early without recovering.
    eprints_cstr(c"error: ")
    eprint_parse_location(p)
    eprints_cstr(c"cannot parse top-level item starting at '")
    eprint_construct(p)
    eprintln_cstr(c"'")
    eprintln_cstr(c"note: the rest of the file was not parsed; refusing to emit a partial module")
    p.error = 1
    return 1

pub fn module_add_struct(m: *Module, s: *StructDef)
    if m.structs == null
        m.structs = s
    else
        var curr: *StructDef = m.structs
        while curr.next != null
            curr = curr.next
        curr.next = s

pub fn module_add_const(m: *Module, c: *ConstEntry)
    if m.constants == null
        m.constants = c
    else
        var curr: *ConstEntry = m.constants
        while curr.next != null
            curr = curr.next
        curr.next = c

pub fn module_add_import(m: *Module, i: *ImportDecl)
    if m.imports == null
        m.imports = i
    else
        var curr: *ImportDecl = m.imports
        while curr.next != null
            curr = curr.next
        curr.next = i

pub fn module_add_global(m: *Module, g: *GlobalVarDef)
    if m.globals == null
        m.globals = g
    else
        var curr: *GlobalVarDef = m.globals
        while curr.next != null
            curr = curr.next
        curr.next = g

# Alias for generated parser (grammar uses module_add_global_var)
pub fn module_add_global_var(m: *Module, g: *GlobalVarDef)
    module_add_global(m, g)

pub fn module_add_impl(m: *Module, impl_block: *ImplBlock)
    if m.impls == null
        m.impls = impl_block
    else
        var curr: *ImplBlock = m.impls
        while curr.next != null
            curr = curr.next
        curr.next = impl_block

# =============================================================================
# Impl block helpers
# =============================================================================

# Create a new impl block
# For "impl<T> Drop for Vec<T>": trait_name="Drop", type_name="Vec", type_params=<T>
# For "impl<T> Vec<T>": trait_name=nil, type_name="Vec", type_params=<T>
# `impl Index for String` (LANGUAGE_SPEC §7.8, AGAST #1635): `[]` on a Vec,
# Span or String is the language's, so none can implement `Index`, `IndexMut`
# or `IndexSet`.  Located at the type's name; ritz0 says the same
# (ritz0/index_rules.py builtin_impl).  Backtracking can build a block twice:
# its name is reported once.
var g_index_impl_last_err: *u8 = null

fn index_impl_on_builtin(p: *Parser, trait_name: *u8, trait_len: i32, type_name: *u8, type_len: i32)
    if buf_eq(trait_name, trait_len, c"Index", 5) == 0 and buf_eq(trait_name, trait_len, c"IndexMut", 8) == 0 and buf_eq(trait_name, trait_len, c"IndexSet", 8) == 0
        return
    if buf_eq(type_name, type_len, c"Vec", 3) == 0 and buf_eq(type_name, type_len, c"Span", 4) == 0 and buf_eq(type_name, type_len, c"String", 6) == 0
        return
    if type_name == g_index_impl_last_err
        return
    g_index_impl_last_err = type_name
    var line: i32 = 0
    var col: i32 = 0
    var i: i32 = 0
    while i < p.token_count
        let t: *Token = p.tokens + i
        if t.start == type_name
            line = t.line
            col = t.col
            break
        i += 1
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": `")
    sys_write(2, type_name, type_len as i64)
    eprints_cstr(c"` is indexed by the language: it can't implement `")
    sys_write(2, trait_name, trait_len as i64)
    eprintln_cstr(c"` (§7.8)")

pub fn impl_block_new(p: *Parser, trait_name: *u8, trait_len: i32, type_name: *u8, type_len: i32, type_params: *TypeParam, methods: *FnDef) -> *ImplBlock
    if trait_name != null
        index_impl_on_builtin(p, trait_name, trait_len, type_name, type_len)
    let ib: *ImplBlock = parser_alloc(p, 56) as *ImplBlock
    ib.trait_name = trait_name
    ib.trait_name_len = trait_len
    ib.type_name = type_name
    ib.type_name_len = type_len
    ib.type_params = type_params
    ib.methods = methods
    ib.next = null
    var mt: *FnDef = methods
    while mt != null
        # AGAST #2913: a method's file, as item_dispatch_fn records a fn's, so
        # an error in an imported generic impl's instance names its module
        # (fn_source_file; specialize_impl_method's clone copies it).  Methods
        # never reach main.ritz's fn-conflict checks: those run on
        # m.functions before monomorph appends the specialised methods.
        mt.def_file = parse_file_copy_shared(p)
        if mt.type_params != null
            generic_method_error(mt, type_name, type_len)
        if type_params != null and fn_is_decl(mt) == 1
            decl_refused(mt.line, c"method", mt.name, mt.name_len, type_name, type_len, c"importers instantiate its body")
        if trait_len == 4 and name_is_drop(trait_name) == 1 and mt.name_len == 4 and name_is_drop_fn(mt.name) == 1
            drop_by_value_error(mt)
        if type_params == null
            impl_name_bare_self(mt, type_name, type_len)
        mt = mt.next
    return ib

# AGAST #1902: a method's own `<...>` (`impl Box` / `fn conv<T>`) is a
# located error.  Monomorph never specialises a method's type params, so the
# call lowered to `call %T @Box_conv` against `declare %T @Box_conv(...)`;
# ritz0 erased T instead.  The spec does not have them, and ritz0's
# parse_impl rejects them with the same message.  Printed once per method
# (the grammar may re-run the action on backtracking); module_require_eof
# fails the parse via g_attr_errors, the parse-time error count.
var g_generic_method_last_err: *u8 = null

fn generic_method_error(mt: *FnDef, type_name: *u8, type_len: i32)
    if mt.name == g_generic_method_last_err
        return
    g_generic_method_last_err = mt.name
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(mt.line as i64)
    eprints_cstr(c": method '")
    eprint_lexeme(mt.name, mt.name_len)
    eprints_cstr(c"' of '")
    eprint_lexeme(type_name, type_len)
    eprintln_cstr(c"' has its own type parameters; generic methods are not supported -- use a free generic fn")

# =============================================================================
# Declaration-only fns: `fn ... = extern` (LANGUAGE_SPEC §5.3, AGAST #1900)
# =============================================================================
#
# A declared fn or method has the one body every stripped import shares
# (main.ritz strip_to_interface, #1899), so it is emitted exactly as an
# imported definition is: main() never marks it is_local, the call site
# `declare`s it, and emitting it is a hard error.  It can't be null:
# `body == null` means `extern fn`.

var g_stripped_body: Stmt

pub fn stripped_body() -> *Stmt
    g_stripped_body.kind = STMT_STRIPPED
    g_stripped_body.next = null
    @g_stripped_body

pub fn fn_is_decl(f: *FnDef) -> i32
    if f.body == @g_stripped_body
        return 1
    0

# One error per item name (the grammar may re-run an action on
# backtracking); counted in g_attr_errors, which fails the parse.  ritz0
# prints the same words (parser.py DECL_REFUSED).
var g_decl_last_err: *u8 = null

# `owner` (a generic impl's type name) may be null.
fn decl_refused(line: i32, what: *u8, name: *u8, name_len: i32, owner: *u8, owner_len: i32, why: *u8)
    if name == g_decl_last_err
        return
    g_decl_last_err = name
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprints_cstr(c": ")
    eprints_cstr(what)
    eprints_cstr(c" '")
    eprint_lexeme(name, name_len)
    if owner != null
        eprints_cstr(c"' of generic impl '")
        eprint_lexeme(owner, owner_len)
    eprints_cstr(c"' cannot be declaration-only (= extern): ")
    eprintln_cstr(why)

# Grammar action: `[pub] fn name[<T>](params) [-> R] = extern`.
pub fn decl_fn_def_new(p: *Parser, name: *u8, len: i32, type_params: *TypeParam, params: *Param, ret: i32, line: i32, col: i32) -> *FnDef
    if type_params != null
        decl_refused(line, c"generic fn", name, len, null, 0, c"importers instantiate its body")
    generic_fn_def_new(p, name, len, type_params, params, ret, stripped_body(), line, col)

# Grammar action: `fn name(params) [-> R] = extern` in a trait.
pub fn trait_decl_refused(name: *u8, len: i32, line: i32) -> i32
    decl_refused(line, c"trait method", name, len, null, 0, c"a trait method is a signature already; drop '= extern'")
    0

# =============================================================================
# Global variable helpers
# =============================================================================

# Grammar signature: global_var_new(p, name, len, var_type, init_expr, line, col)
pub fn global_var_new(p: *Parser, name: *u8, len: i32, var_type: i32, init_expr: *Expr, line: i32, col: i32) -> *GlobalVarDef
    # AGAST #190: bumped from 64 → 96 to fit the array_* fields below.
    # Without the extra slack, parser_alloc handed back 64 bytes and the
    # `array_*` writes scribbled past the end of the allocation into the
    # next arena slab — corrupting whatever the parser allocated next.
    # AGAST #1501: 96 → 128 for src_file/line/col (struct is now 104 bytes).
    let g: *GlobalVarDef = parser_alloc(p, sizeof(GlobalVarDef)) as *GlobalVarDef
    g.name = name as *u8
    g.name_len = len
    g.var_type = var_type
    # For struct types, get the type name from parser state (set by parse_type_spec)
    if var_type == TYPE_STRUCT
        g.type_name = p.last_type_name
        g.type_name_len = p.last_type_name_len
    else
        g.type_name = null
        g.type_name_len = 0
    # Capture pointee type for `var g: *T = ...` declarations so emit can
    # scale pointer arithmetic and pick the right load/store width at use
    # sites (TYPE_I32 → load i32 + add stride 4, etc.).
    if var_type == TYPE_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
        g.pointee_type = p.last_pointee_type
    else
        g.pointee_type = TYPE_I64
    g.inner_pointee_type = ptr_ptr_inner_pointee(p, var_type)
    g.ptr_array = ptr_array_of_last(p, var_type)   # AGAST #2329
    # AGAST #190: capture array dimensions for `var g: [N]T` so the global
    # gets emitted as `[N x %T] zeroinitializer` and indexing GEPs can
    # synthesise the right stride.  Mirrors what var_decl does for locals
    # via stmt.var_array_size / var_array_elem_type.
    if var_type == TYPE_ARRAY
        g.array_size = p.last_array_size
        g.array_elem_type = p.last_array_elem_type
        g.array_elem_pointee = p.last_array_elem_pointee
        g.array_elem_type_name = p.last_array_elem_type_name
        g.array_elem_type_name_len = p.last_array_elem_type_name_len
        g.array_shape = p.last_array_shape  # AGAST #1509
    else
        g.array_shape = null
        g.array_size = 0
        g.array_elem_type = 0
        g.array_elem_type_name = null
        g.array_elem_type_name_len = 0
    # AGAST #1908: the St of `var g: *St` (struct size 120, within the 128),
    # and #2374: of `var g: @St`, which a method on `g` needs to be judged.
    if (var_type == TYPE_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF) and g.pointee_type == TYPE_STRUCT
        g.pointee_type_name = p.last_type_name
        g.pointee_type_name_len = p.last_type_name_len
    else if var_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(g.inner_pointee_type) == TYPE_STRUCT
        # AGAST #1944: and the S of `var g: **S` (any depth), so `*g + 1`
        # strides sizeof(S) as it does for a `**S` param or local.
        g.pointee_type_name = p.last_type_name
        g.pointee_type_name_len = p.last_type_name_len
    else
        g.pointee_type_name = null
        g.pointee_type_name_len = 0
    g.init_expr = init_expr
    g.src_file = parse_file_copy(p)
    g.line = line
    g.col = col
    g.next = null
    g.is_extern = 0
    g

# `extern var NAME: T` (LANGUAGE_SPEC §5.3, AGAST #1879): a global with no
# definition here.  emit_global_vars declares it `external global`.
pub fn extern_var_new(p: *Parser, name: *u8, len: i32, var_type: i32, line: i32, col: i32) -> *GlobalVarDef
    let g: *GlobalVarDef = global_var_new(p, name, len, var_type, 0 as *Expr, line, col) as *GlobalVarDef
    g.is_extern = 1
    g

# `extern var NAME: T = v` is a located error, not a parse stop: the symbol
# is defined in another object, so there is nothing to initialise.
pub fn extern_var_init_refused(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> *GlobalVarDef
    if p.skip_item == 0
        eprints_cstr(c"error: ")
        if g_parse_file != null
            eprints_cstr(g_parse_file)
        else
            eprints_cstr(c"<input>")
        eprint_char(':')
        eprint_i64(line as i64)
        eprint_char(':')
        eprint_i64(col as i64)
        eprints_cstr(c": extern var cannot have an initializer: '")
        eprint_lexeme(name, len)
        eprintln_cstr(c"' is defined in another object")
        g_attr_errors = g_attr_errors + 1
    extern_var_new(p, name, len, TYPE_I64, line, col)

# Copy of the current parse file's path in the parser arena, or null.
# g_parse_file itself is borrowed: for an import it points into a String the
# driver drops as soon as that import is parsed, long before emission.
fn parse_file_copy(p: *Parser) -> *u8
    if g_parse_file == null
        return null
    var n: i64 = 0
    while *(g_parse_file + n) != 0
        n = n + 1
    let buf: *u8 = parser_alloc(p, n + 1)
    var i: i64 = 0
    while i <= n
        *(buf + i) = *(g_parse_file + i)
        i = i + 1
    buf

# parse_file_copy, shared between consecutive callers that see the same path.
# AGAST #1364 records a path on every narrow-integer let/var, and a fresh copy
# each time would grow the arena by a path per declaration.  The cache is
# keyed on CONTENT, never on the g_parse_file pointer: that String is freed
# after each import, so a later file can arrive at the same address.
var g_shared_file_copy: *u8 = null

fn parse_file_copy_shared(p: *Parser) -> *u8
    if g_parse_file == null
        return null
    if g_shared_file_copy != null
        var i: i64 = 0
        while *(g_parse_file + i) != 0 and *(g_parse_file + i) == *(g_shared_file_copy + i)
            i = i + 1
        if *(g_parse_file + i) == 0 and *(g_shared_file_copy + i) == 0
            return g_shared_file_copy
    g_shared_file_copy = parse_file_copy(p)
    g_shared_file_copy

# =============================================================================
# Function definition helpers
# =============================================================================

# Link two FnDef nodes - used for building method lists in impl blocks
pub fn fn_link(first: *FnDef, rest: *FnDef) -> *FnDef
    if first == null
        return rest
    first.next = rest
    return first

pub fn fn_def_new(p: *Parser, name: *u8, len: i32, params: *Param, ret: i32, body: *Stmt, line: i32, col: i32) -> *FnDef
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.ret_written_void = 0   # AGAST #2236
    f.ret_fn_sig = fn_ret_fn_sig(ret)   # AGAST #2120
    f.ret_ref = fn_ret_ref(ret)         # AGAST #2308
    f.ret_array = fn_ret_array(ret)     # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(ret)   # AGAST #2329
    f.name = name as *u8
    f.name_len = len
    f.params = params
    # ret == 0 means TYPE_VOID (no return type specified)
    f.return_type = ret
    # If return type is a struct, copy the type name from parser state
    # Use fn_return_type_name if available (set after parsing return type but before parsing body)
    # Otherwise fall back to last_type_name
    #
    # AGAST #175: also propagate name for TYPE_PTR/TYPE_REF returns (e.g.
    # `-> *IoUringCqe`).  capture_fn_return_type now records the pointee
    # struct name in fn_return_type_name when ret is a pointer/ref kind, so
    # downstream var-decl narrowing can see the pointee type.
    if ret == TYPE_STRUCT
        var rt_name: *u8 = null
        var rt_len: i32 = 0
        if p.fn_return_type_name != null
            rt_name = p.fn_return_type_name as *u8
            rt_len = p.fn_return_type_name_len
        else
            rt_name = p.last_type_name as *u8
            rt_len = p.last_type_name_len
        # Normalize `-> void` (parsed as TYPE_STRUCT name="void") down to
        # TYPE_VOID so downstream emitter paths see a real void return.
        # Without this, `pub fn aes128_decrypt_block_ni(...) -> void`
        # emits `define %void @...` and `ret void zeroinitializer`,
        # both of which clang rejects.
        if rt_len == 4 and rt_name != null and *rt_name == 118 and *(rt_name + 1) == 111 and *(rt_name + 2) == 105 and *(rt_name + 3) == 100
            f.return_type = TYPE_VOID
            f.ret_written_void = 1   # AGAST #2236
            f.return_type_name = null
            f.return_type_name_len = 0
        else
            f.return_type_name = rt_name
            f.return_type_name_len = rt_len
    else if ret == TYPE_PTR
        # `-> *Struct` — pull the pointee struct name from fn_return_type_name
        # (saved by capture_fn_return_type before the body parses) so
        # call-site var-decl narrowing (`let x = make_struct_ptr()`) can
        # resolve `x.field`.  Without this, return_type_name stays null
        # and downstream member accesses fail with "; ERROR: unhandled
        # EXPR_MEMBER".
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = p.last_type_name as *u8
            f.return_type_name_len = p.last_type_name_len
    else if ret == TYPE_PTR or ret == TYPE_PTR_PTR or ret == TYPE_REF or ret == TYPE_MUT_REF
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = null
            f.return_type_name_len = 0
    else
        f.return_type_name = null
        f.return_type_name_len = 0
    f.body = body
    f.line = line
    f.next = null
    f.type_params = null  # Non-generic function (field at end to preserve layout)
    f.is_local = 0  # AGAST #194: main() flips this to 1 for the input file's fns.
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    return f

# Extern function declaration (no body) - forward declaration
pub fn extern_fn_def_new(p: *Parser, name: *u8, len: i32, params: *Param, ret: i32, line: i32, col: i32) -> *FnDef
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.ret_written_void = 0   # AGAST #2236
    f.ret_fn_sig = fn_ret_fn_sig(ret)   # AGAST #2120
    f.ret_ref = fn_ret_ref(ret)         # AGAST #2308
    f.ret_array = fn_ret_array(ret)     # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(ret)   # AGAST #2329
    f.name = name as *u8
    f.name_len = len
    f.params = params
    # ret == 0 means TYPE_VOID (no return type specified)
    f.return_type = ret
    if ret == TYPE_STRUCT
        var rt_name: *u8 = null
        var rt_len: i32 = 0
        if p.fn_return_type_name != null
            rt_name = p.fn_return_type_name as *u8
            rt_len = p.fn_return_type_name_len
        else
            rt_name = p.last_type_name as *u8
            rt_len = p.last_type_name_len
        # Normalize `-> void` to TYPE_VOID — see fn_def_new for rationale.
        if rt_len == 4 and rt_name != null and *rt_name == 118 and *(rt_name + 1) == 111 and *(rt_name + 2) == 105 and *(rt_name + 3) == 100
            f.return_type = TYPE_VOID
            f.ret_written_void = 1   # AGAST #2236
            f.return_type_name = null
            f.return_type_name_len = 0
        else
            f.return_type_name = rt_name
            f.return_type_name_len = rt_len
    else if ret == TYPE_PTR
        # `-> *Struct` — same rationale as fn_def_new.
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = p.last_type_name as *u8
            f.return_type_name_len = p.last_type_name_len
    else if ret == TYPE_PTR or ret == TYPE_PTR_PTR or ret == TYPE_REF or ret == TYPE_MUT_REF
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = null
            f.return_type_name_len = 0
    else
        f.return_type_name = null
        f.return_type_name_len = 0
    f.body = null  # No body for extern functions
    f.line = line
    f.next = null
    f.type_params = null  # Non-generic function (field at end to preserve layout)
    f.is_local = 0  # AGAST #194: extern decls always emit as `declare`; flag is unused
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    return f

# =============================================================================
# Parameter helpers
# =============================================================================

# AGAST #2139: 1 when last_type_name belongs to the just-parsed param type
# `ty`: a struct, or a pointer / reference whose (innermost) pointee is one.
# `*[N]S` / `@[N]S` keep S, and `name:& *S` (a TYPE_MUT_REF to a TYPE_PTR,
# #2075) keeps S, as before.
fn param_type_names_pointee(p: *Parser, ty: i32) -> i32
    if ty == TYPE_STRUCT
        return 1
    if ty == TYPE_PTR
        # AGAST #2145: a `fn(...) -> T` type is a TYPE_PTR too, but type_fn
        # sets no pointee, so last_pointee_type / last_type_name are left
        # from whatever came before (an earlier `*S` param, or the fn type's
        # own `*S` param).  Copying them made `f.w` GEP into S.
        if fresh_fn_sig(p) != null
            return 0
        if p.last_pointee_type == TYPE_STRUCT
            return 1
        if p.last_pointee_type == TYPE_ARRAY and p.last_array_elem_type == TYPE_STRUCT
            return 1
        # AGAST #2343: `*[N]*S`, as a by-value `[N]*S` is named.
        if p.last_pointee_type == TYPE_ARRAY and p.last_array_elem_type == TYPE_PTR and p.last_array_elem_pointee == TYPE_STRUCT
            return 1
        return 0
    if ty == TYPE_PTR_PTR
        if ptr_ptr_slot_inner(ptr_ptr_inner_pointee(p, ty)) == TYPE_STRUCT
            return 1
        # AGAST #2553: `**[N]S`, as `*[N]S` is named.  It named nothing, so
        # `(*r)[i].f` and `let p = *r; p[i].f` had no S.  The emitter keeps S
        # off the local's type_name (name_array_ptr_param).
        if ptr_names_array(p, ty) == 1 and p.last_array_elem_type == TYPE_STRUCT
            return 1
        return 0
    if ty == TYPE_REF or ty == TYPE_MUT_REF
        if p.last_ref_inner_type == TYPE_STRUCT
            return 1
        if p.last_ref_inner_type == TYPE_PTR and p.last_pointee_type == TYPE_STRUCT
            return 1
        # AGAST #2372: `@**S`, as `**S` is named above.
        if p.last_ref_inner_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(ptr_ptr_inner_pointee(p, ty)) == TYPE_STRUCT
            return 1
        if p.last_ref_inner_type == TYPE_ARRAY and p.last_array_elem_type == TYPE_STRUCT
            return 1
        if p.last_ref_inner_type == TYPE_ARRAY and p.last_array_elem_type == TYPE_PTR and p.last_array_elem_pointee == TYPE_STRUCT
            return 1   # AGAST #2343: `@[N]*S`
        return 0
    return 0

pub fn param_new(p: *Parser, name: *u8, len: i32, ty: i32, line: i32, col: i32) -> *Param
    nd_array_reject(p, ty, line, col, c"a parameter")  # AGAST #1509
    let param: *Param = param_of_type(p, name, len, ty)
    param.name_span.line = line   # AGAST #2407
    param.name_span.col = col
    return param

# The just-parsed type `ty` as a param declares it.  AGAST #2308: a `@T` local
# or return type is recorded this way too, so they all know the same things.
fn param_of_type(p: *Parser, name: *u8, len: i32, ty: i32) -> *Param
    let param: *Param = parser_alloc(p, sizeof(Param)) as *Param
    param.name = name as *u8
    param.name_span.line = 0
    param.name_span.col = 0
    param.name_len = len
    param.param_type = ty
    # Copy the struct type name from parser state for a struct, or a pointer
    # / reference whose pointee is a named type.  AGAST #2139: only then: a
    # primitive (`*u8`) never resets last_type_name, so it still names the
    # last named type parsed (an earlier `*Res` param, a `s: St` field).
    if param_type_names_pointee(p, ty) == 1
        param.param_type_name = p.last_type_name as *u8
        param.param_type_name_len = p.last_type_name_len
    else if ty == TYPE_ARRAY
        param.param_type_name = p.last_array_elem_type_name as *u8
        param.param_type_name_len = p.last_array_elem_type_name_len
    else
        param.param_type_name = null
        param.param_type_name_len = 0
    # Copy pointee/inner type from parser state if this is a pointer or reference type
    if ty == TYPE_PTR or ty == TYPE_PTR_PTR
        param.param_pointee_type = p.last_pointee_type
    else if ty == TYPE_REF or ty == TYPE_MUT_REF
        param.param_pointee_type = p.last_ref_inner_type
    else
        param.param_pointee_type = TYPE_I64  # Default
    param.param_inner_pointee_type = ptr_ptr_inner_pointee(p, ty)
    param.param_pointee_array_size = ptr_array_pointee_size(p, ty)
    param.param_pointee_array_elem_type = ptr_array_pointee_elem(p, ty)
    param.param_pointee_array_elem_pointee = ptr_array_elem_pointee(p, ty)
    # AGAST #2279, #2287: `@[N]T` and `@&[N]T` keep N and T, as `*[N]T` does.
    param.param_pointee_array_shape = null
    if (ty == TYPE_REF or ty == TYPE_MUT_REF) and p.last_ref_inner_type == TYPE_ARRAY
        param.param_pointee_array_size = p.last_array_size
        param.param_pointee_array_elem_type = p.last_array_elem_type
        param.param_pointee_array_elem_pointee = p.last_array_elem_pointee
        param.param_pointee_array_shape = p.last_array_shape
    param.param_ref_ptr_pointee = TYPE_VOID
    if (ty == TYPE_REF or ty == TYPE_MUT_REF) and p.last_ref_inner_type == TYPE_PTR
        param.param_ref_ptr_pointee = p.last_pointee_type
    param.param_array_size = 0
    param.param_array_elem_type = TYPE_VOID
    if ty == TYPE_ARRAY
        param.param_array_size = p.last_array_size
        param.param_array_elem_type = p.last_array_elem_type
        param.param_array_elem_pointee = p.last_array_elem_pointee
    param.next = null
    param.is_borrow = 0
    param.is_self_borrow = 0
    # AGAST #1671: a `fn(...) -> T` param keeps its signature.
    param.fn_sig = null
    if ty == TYPE_PTR
        param.fn_sig = fresh_fn_sig(p)
    return param

# AGAST #2329: the just-parsed `ty` as a param would hold it, when it's a `*[N]T`,
# `@[N]T` or `@&[N]T`, so a field, a global or a return type knows N and T, and
# `x[i]` on one is element i at stride T, as on a local (#2330, LARB R9).  null
# for any other type.
pub fn ptr_array_of_last(p: *Parser, ty: i32) -> *Param
    if ty == TYPE_PTR and p.last_pointee_type == TYPE_ARRAY
        return param_of_type(p, null, 0, ty)
    if (ty == TYPE_REF or ty == TYPE_MUT_REF) and p.last_ref_inner_type == TYPE_ARRAY
        return param_of_type(p, null, 0, ty)
    null

# `name:& T` (AGAST #1644): a TYPE_MUT_REF param that ritz0 auto-derefs.
pub fn param_borrow(p: *Parser, name: *u8, len: i32, ty: i32, line: i32, col: i32) -> *Param
    nd_array_reject(p, ty, line, col, c"a parameter")  # AGAST #1509
    let param: *Param = param_new(p, name, len, ty, line, col)
    param.is_borrow = 1
    # AGAST #2075: for `name:& *T` keep T (the borrowed pointer's own
    # pointee; type_ptr left it in last_pointee_type, and a struct T's name
    # in last_type_name, which param_new already copied).  The emitter binds
    # the borrow as a plain `*T` local, as ritz0 does (see
    # bind_scalar_borrow_param).  Only a borrow uses the field this way:
    # param_new leaves it TYPE_VOID for every other `@&*T`.
    if ty == TYPE_MUT_REF and p.last_ref_inner_type == TYPE_PTR
        param.param_inner_pointee_type = p.last_pointee_type
    return param

# `self:& T` (AGAST #2286): see Param.is_self_borrow.
pub fn param_self_borrow(p: *Parser, name: *u8, len: i32, ty: i32, line: i32, col: i32) -> *Param
    let param: *Param = param_new(p, name, len, ty, line, col)
    param.is_self_borrow = 1
    return param

pub fn param_link(first: *Param, rest: *Param) -> *Param
    first.next = rest
    return first

# Untyped `self` receiver in impl methods: `fn foo(self)` or `fn foo(self:&)`.
# impl_block_new names the type of a bare `self`, which makes it `self: T`, and
# emit_impl_method takes the type of a `self:&` from the ImplBlock.  Typed
# `self: T` / `self:& T` receivers do not come here: the grammar passes T to
# param_new, as it does for any other name (AGAST #1375, #1632).
pub fn param_self(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> *Param
    # Clear any "last type name" left by an earlier type_spec.
    p.last_type_name = null
    p.last_type_name_len = 0
    return param_new(p, name, len, TYPE_STRUCT, line, col)

# Bare `self:&`: the caller's place, where a bare `self` is a copy (AGAST #2393).
pub fn param_self_lent(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> *Param
    let param: *Param = param_self(p, name, len, line, col)
    param.is_self_borrow = 1
    return param

# 1 for a param named `self`.
pub fn param_is_self(p: *Param) -> i32
    if p == null or p.name_len != 4
        return 0
    if *p.name == 115 and *(p.name + 1) == 101 and *(p.name + 2) == 108 and *(p.name + 3) == 102
        return 1
    0

# 1 for a `self` passed as a `ptr`: a reference, a pointer or `self:&`.  A by-value
# `self` isn't: it's a by-value param, and goes as `s: T` goes (LARB R10, AGAST
# #2393).  A receiver whose type isn't a named struct or enum stays a `ptr`.
pub fn param_self_is_ptr(p: *Param) -> i32
    if param_is_self(p) == 0
        return 0
    if p.param_type == TYPE_STRUCT and p.is_self_borrow == 0 and p.param_type_name_len > 0
        return 0
    1

# 1 for a by-value `self`.
pub fn param_self_is_value(p: *Param) -> i32
    if param_is_self(p) == 1 and param_self_is_ptr(p) == 0
        return 1
    0

fn name_is_drop(n: *u8) -> i32
    (*n == 68 and *(n + 1) == 114 and *(n + 2) == 111 and *(n + 3) == 112) as i32

fn name_is_drop_fn(n: *u8) -> i32
    (*n == 100 and *(n + 1) == 114 and *(n + 2) == 111 and *(n + 3) == 112) as i32

# `fn drop(self)`: its own `self` would drop when it returned, and call it again
# (AGAST #2393).  ritz0 prints the same words (ref_rules.DROP_BY_VALUE).  Once per
# method: the grammar may re-run the action on backtracking.
var g_drop_last_err: *FnDef = null

fn drop_by_value_error(m: *FnDef)
    let p: *Param = m.params
    if param_is_self(p) == 0 or p.param_type != TYPE_STRUCT or p.is_self_borrow == 1 or m == g_drop_last_err
        return
    g_drop_last_err = m
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(m.line as i64)
    eprintln_cstr(c": `drop` can't take `self` by value: it would drop itself: write `self: @&T`")

# A bare `self` is `self: T` (AGAST #2393).  A generic impl's T is named when it's
# specialised, so that one stays as it was parsed.
fn impl_name_bare_self(m: *FnDef, type_name: *u8, type_len: i32)
    let p: *Param = m.params
    if param_is_self(p) == 0 or p.param_type != TYPE_STRUCT or p.is_self_borrow == 1 or p.param_type_name_len > 0
        return
    p.param_type_name = type_name
    p.param_type_name_len = type_len

# =============================================================================
# Struct definition helpers
# =============================================================================

pub fn struct_def_new(p: *Parser, name: *u8, len: i32, fields: *StructField, line: i32, col: i32) -> *StructDef
    let s: *StructDef = parser_alloc(p, 48) as *StructDef  # Increased for type_params field
    s.name = name as *u8
    s.name_len = len
    s.fields = fields
    s.next = null
    s.type_params = null  # Non-generic struct (field at end to preserve layout)
    return s

pub fn field_new(p: *Parser, name: *u8, len: i32, ty: i32, line: i32, col: i32) -> *StructField
    let f: *StructField = parser_alloc(p, sizeof(StructField)) as *StructField
    f.field_mut_ref = 0
    f.field_shared_ref = 0
    # AGAST #2097: an N-D field keeps its shape (it was a located error
    # under #1509, and a silent `[N x i64]` before that).
    f.array_shape = null
    if is_nd_array_type(p, ty) == 1
        f.array_shape = p.last_array_shape
    f.name = name as *u8
    # AGAST #1924: `rows: **i32` -> `*(*(s.rows + i) + k)` loads an i32.
    f.inner_pointee_type = ptr_ptr_inner_pointee(p, ty)
    f.name_len = len
    f.field_type = ty
    f.ptr_pointee = TYPE_VOID
    if ty == TYPE_PTR
        f.ptr_pointee = p.last_pointee_type
    f.ptr_array = ptr_array_of_last(p, ty)   # AGAST #2329
    # AGAST #2120: `f: EfiFn` keeps the signature, so `(t.f)(..)` calls typed.
    # The action runs after the field's NEWLINE, one token past the type.
    f.fn_sig = null
    if ty == TYPE_PTR and p.last_fn_sig != null and p.last_fn_sig_pos == p.pos - 1
        f.fn_sig = p.last_fn_sig
    # Copy struct type name if this is a struct-typed field OR a pointer-to-struct field
    # For *StructName, last_type_name is preserved from inner type parsing.
    # For *u8/*i32/etc. we must NOT inherit a stale last_type_name from a
    # previous sibling field — otherwise get_ptr_elem_size treats *u8 as
    # *SomeStruct and scales pointer arithmetic by that struct's size,
    # producing e.g. `mul i64 pos, 16` for `lex.src + pos` where src is *u8.
    if ty == TYPE_STRUCT
        f.field_type_name = p.last_type_name as *u8
        f.field_type_name_len = p.last_type_name_len
    else if ty == TYPE_PTR
        # Only inherit the name if the pointee is a struct — primitives
        # (u8/i32/i64) must have field_type_name_len = 0.
        if p.last_pointee_type == TYPE_STRUCT
            f.field_type_name = p.last_type_name as *u8
            f.field_type_name_len = p.last_type_name_len
        else
            f.field_type_name = null
            f.field_type_name_len = 0
    else if ty == TYPE_PTR_PTR
        # AGAST #184: **Foo / **u8 distinction via last_inner_pointee_type
        # (set by type_ptr's innermost call).  Only inherit last_type_name
        # when the innermost pointee is a named struct — otherwise we'd
        # inherit a stale name from a previous sibling field and
        # downstream find_struct calls would mis-resolve.
        if p.last_inner_pointee_type == TYPE_STRUCT
            f.field_type_name = p.last_type_name as *u8
            f.field_type_name_len = p.last_type_name_len
        else
            f.field_type_name = null
            f.field_type_name_len = 0
    else if ty == TYPE_REF or ty == TYPE_MUT_REF
        # Refs store the inner type in last_ref_inner_type.
        if p.last_ref_inner_type == TYPE_STRUCT
            f.field_type_name = p.last_type_name as *u8
            f.field_type_name_len = p.last_type_name_len
        else
            f.field_type_name = null
            f.field_type_name_len = 0
    else
        f.field_type_name = null
        f.field_type_name_len = 0
    # Copy array info from parser state if this is an array type
    if ty == TYPE_ARRAY
        f.array_size = p.last_array_size
        f.array_elem_type = p.last_array_elem_type
        f.array_elem_pointee = p.last_array_elem_pointee
        f.array_elem_type_name = p.last_array_elem_type_name
        f.array_elem_type_name_len = p.last_array_elem_type_name_len
    else
        f.array_size = 0
        f.array_elem_type = 0
        f.array_elem_type_name = null
        f.array_elem_type_name_len = 0
        # AGAST #1304: record the pointee of a primitive pointer field.
        # `array_elem_type` is the established slot for this — see
        # make_ptr_prim_field, which populates it for compiler-builtin
        # structs (Vec$T.data, Nfa.state_trans_offset).  User-declared
        # fields were never given one, so get_member_pointee_type fell
        # through to its `assume u8` default and `*ring.sq_tail` (a *i32)
        # emitted `load i8`, and get_ptr_elem_size scaled `field + i` by 1
        # instead of 4.  Struct pointer fields now carry the same pointee
        # info that local pointer vars do via LocalVar.pointee_type.
        # Struct pointees keep using field_type_name (set above); only
        # primitives are recorded here.
        if ty == TYPE_PTR and p.last_pointee_type != TYPE_STRUCT
            f.array_elem_type = p.last_pointee_type
        # AGAST #2050: a ref to a primitive (`p: @i32`, `@&u8`, `p:& f64`)
        # records its pointee the same way, so lower_ref_fields
        # (emitter.ritz) can rewrite it to a `*T` field.  Exactly the
        # primitive pointees ptr_field_elem_kind (emitter_core.ritz)
        # handles: integers, and f32/f64/bool since #2053.  Refs to
        # slices/pointers/arrays record nothing and stay on the fail-closed
        # ref path.
        if ty == TYPE_REF or ty == TYPE_MUT_REF
            f.field_mut_ref = (ty == TYPE_MUT_REF) as i32
            f.field_shared_ref = (ty == TYPE_REF) as i32
            let rt: i32 = p.last_ref_inner_type
            if rt == TYPE_I8 or rt == TYPE_U8 or rt == TYPE_I16 or rt == TYPE_U16
                f.array_elem_type = rt
            else if rt == TYPE_I32 or rt == TYPE_U32 or rt == TYPE_I64 or rt == TYPE_U64
                f.array_elem_type = rt
            else if rt == TYPE_F32 or rt == TYPE_F64 or rt == TYPE_BOOL
                f.array_elem_type = rt
    f.next = null
    return f

# Type parameter helpers (for generics)
pub fn type_param_new(p: *Parser, name: *u8, len: i32) -> *TypeParam
    let tp: *TypeParam = parser_alloc(p, 24) as *TypeParam
    tp.name = name as *u8
    tp.name_len = len
    tp.next = null
    return tp

pub fn type_param_link(first: *TypeParam, rest: *TypeParam) -> *TypeParam
    first.next = rest
    return first

# Generic function definition (with type parameters)
pub fn generic_fn_def_new(p: *Parser, name: *u8, len: i32, type_params: *TypeParam, params: *Param, ret: i32, body: *Stmt, line: i32, col: i32) -> *FnDef
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.ret_written_void = 0   # AGAST #2236
    f.ret_fn_sig = fn_ret_fn_sig(ret)   # AGAST #2120
    f.ret_ref = fn_ret_ref(ret)         # AGAST #2308
    f.ret_array = fn_ret_array(ret)     # AGAST #2343
    f.ret_ptr_array = fn_ret_ptr_array(ret)   # AGAST #2329
    f.name = name as *u8
    f.name_len = len
    f.params = params
    # ret == 0 means TYPE_VOID (no return type specified)
    f.return_type = ret
    if ret == TYPE_STRUCT
        var rt_name: *u8 = null
        var rt_len: i32 = 0
        if p.fn_return_type_name != null
            rt_name = p.fn_return_type_name as *u8
            rt_len = p.fn_return_type_name_len
        else
            rt_name = p.last_type_name as *u8
            rt_len = p.last_type_name_len
        # Normalize `-> void` to TYPE_VOID — see fn_def_new for rationale.
        if rt_len == 4 and rt_name != null and *rt_name == 118 and *(rt_name + 1) == 111 and *(rt_name + 2) == 105 and *(rt_name + 3) == 100
            f.return_type = TYPE_VOID
            f.ret_written_void = 1   # AGAST #2236
            f.return_type_name = null
            f.return_type_name_len = 0
        else
            f.return_type_name = rt_name
            f.return_type_name_len = rt_len
    else if ret == TYPE_PTR
        # `-> *Struct` — same rationale as fn_def_new.
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = p.last_type_name as *u8
            f.return_type_name_len = p.last_type_name_len
    else if ret == TYPE_PTR or ret == TYPE_PTR_PTR or ret == TYPE_REF or ret == TYPE_MUT_REF
        if p.fn_return_type_name != null and p.fn_return_type_name_len > 0
            f.return_type_name = p.fn_return_type_name as *u8
            f.return_type_name_len = p.fn_return_type_name_len
        else
            f.return_type_name = null
            f.return_type_name_len = 0
    else
        f.return_type_name = null
        f.return_type_name_len = 0
    f.body = body
    f.line = line
    f.next = null
    f.type_params = type_params  # Generic type parameters (field at end to preserve layout)
    f.is_local = 0  # AGAST #194: generic templates are skipped in emit (type_params != null)
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    return f

# Generic struct definition (with type parameters)
pub fn generic_struct_def_new(p: *Parser, name: *u8, len: i32, type_params: *TypeParam, fields: *StructField, line: i32, col: i32) -> *StructDef
    let s: *StructDef = parser_alloc(p, 48) as *StructDef
    s.name = name as *u8
    s.name_len = len
    s.fields = fields
    s.next = null
    s.type_params = type_params  # Generic type parameters (field at end to preserve layout)
    return s

pub fn field_link(first: *StructField, rest: *StructField) -> *StructField
    first.next = rest
    return first

# =============================================================================
# Const definition helpers
# =============================================================================

pub fn const_new(p: *Parser, name: *u8, len: i32, ty: i32, val: *Expr, line: i32, col: i32) -> *ConstEntry
    nd_array_reject(p, ty, line, col, c"a const")  # AGAST #1509
    # Bumped from 40 → 128 to fit the extra metadata fields appended to
    # ConstEntry for non-integer constants (value_expr, array_size, etc.).
    let c: *ConstEntry = parser_alloc(p, sizeof(ConstEntry)) as *ConstEntry
    c.name = name as *u8
    c.def_file = parse_file_copy_shared(p)
    c.target_gated = 0  # item_dispatch_const sets it
    c.name_len = len
    c.const_type = ty
    # AGAST #1502: `c.value` is what every use site reads (find_const), so it
    # must be the folded initializer.  It used to be `val.int_val`, which is
    # only meaningful on an int literal: `-7` is a unary-minus node whose
    # int_val is 0, so every negative const silently became 0.
    c.value = 0
    c.fold_state = CONST_FOLD_DONE
    c.src_file = null
    c.line = line
    c.col = col
    var folded: i64 = 0
    if val != null and const_fold_int(p.module.constants, val, 0, @folded) == 1
        c.value = const_wrap_to_type(ty, folded)
    else if is_int_const_type(ty) == 1
        # Names a const not seen yet (later in this file, or imported), or
        # is not a constant at all: the emitter decides once every module is
        # merged, and reports a located error if it still does not fold.
        c.fold_state = CONST_FOLD_PENDING
        c.src_file = parse_file_copy(p)
    else if val != null and val.kind == EXPR_INT_LIT
        # Non-integer declared types (float, struct/alias, ...) keep the
        # legacy literal fast path; their real lowering reads value_expr.
        c.value = val.int_val
    c.next = null
    # Preserve the full AST so the emitter can lower complex const shapes
    # (array literals, struct literals, string literals) later on.
    c.value_expr = val
    c.ptr_pointee = TYPE_VOID
    if ty == TYPE_PTR
        c.ptr_pointee = p.last_pointee_type
    # Capture array element info from the parser's latched state. When
    # ty != TYPE_ARRAY these are zero/null. parse_type_spec populates
    # p.last_array_* when it consumes `[N]T`.
    if ty == TYPE_ARRAY
        c.array_size = p.last_array_size
        c.array_elem_type = p.last_array_elem_type
        c.array_elem_pointee = p.last_array_elem_pointee
        c.array_elem_type_name = p.last_array_elem_type_name
        c.array_elem_type_name_len = p.last_array_elem_type_name_len
    else
        c.array_size = 0
        c.array_elem_type = 0
        c.array_elem_type_name = null
        c.array_elem_type_name_len = 0
    # AGAST #189 — capture the named-struct type for scalar struct consts
    # (`const FOO: StrView = "..."`).  parse_type_spec sets
    # p.last_type_name when it consumes a struct/named type; we latch it
    # so the emitter can lower the const as a `%StrView { ... }` global
    # and use-site loads can produce the proper aggregate.
    if ty == TYPE_STRUCT
        c.type_name = p.last_type_name
        c.type_name_len = p.last_type_name_len
    else
        c.type_name = null
        c.type_name_len = 0
    return c

# -----------------------------------------------------------------------------
# Integer const folding (AGAST #1502)
# -----------------------------------------------------------------------------

# 1 if `ty` is a declared type whose const must fold to an integer.
pub fn is_int_const_type(ty: i32) -> i32
    if ty == TYPE_I8 or ty == TYPE_I16 or ty == TYPE_I32 or ty == TYPE_I64
        return 1
    if ty == TYPE_U8 or ty == TYPE_U16 or ty == TYPE_U32 or ty == TYPE_U64
        return 1
    if ty == TYPE_BOOL
        return 1
    0

# `v` wrapped to the declared integer type `ty`, as runtime arithmetic at that
# width would leave it (AGAST #2154): `const M: u8 = 200 + 100` is 44, not
# 300.  Signed types sign-extend back to i64 (i8 200 is -56); unsigned ones
# zero-extend (u8 200 stays 200); bool keeps the low bit, as ritz0 does.
# i64/u64 and non-integer types are returned unchanged.
pub fn const_wrap_to_type(ty: i32, v: i64) -> i64
    if ty == TYPE_BOOL
        return v & 1
    if ty == TYPE_U8
        return v & 0xFF
    if ty == TYPE_U16
        return v & 0xFFFF
    if ty == TYPE_U32
        return v & 0xFFFFFFFF
    # Sign-extend as ((v & mask) ^ sign) - sign, not (v << k) >> k: ritz1's
    # `>>` is always a logical shift (AGAST #1637), so the shift form only
    # works when ritz0 builds this file.
    if ty == TYPE_I8
        return ((v & 0xFF) ^ 0x80) - 0x80
    if ty == TYPE_I16
        return ((v & 0xFFFF) ^ 0x8000) - 0x8000
    if ty == TYPE_I32
        return ((v & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000
    v

fn const_name_eq(c: *ConstEntry, name: *u8, len: i32) -> i32
    if c.name_len != len
        return 0
    var i: i32 = 0
    while i < len
        if *(c.name + i) != *(name + i)
            return 0
        i += 1
    1

# Resolve a PENDING integer const in place against `consts`: 1 and DONE if
# it folds, 0 and BAD otherwise (including a cycle back to itself).
pub fn const_resolve(consts: *ConstEntry, c: *ConstEntry) -> i32
    if c.fold_state == CONST_FOLD_DONE
        return 1
    if c.fold_state != CONST_FOLD_PENDING
        return 0
    c.fold_state = CONST_FOLD_ACTIVE
    var v: i64 = 0
    if c.value_expr != null and const_fold_int(consts, c.value_expr, 1, @v) == 1
        c.value = const_wrap_to_type(c.const_type, v)
        c.fold_state = CONST_FOLD_DONE
        return 1
    c.fold_state = CONST_FOLD_BAD
    0

# The value of the integer const `name` in `consts` (first occurrence wins,
# as in the emitter's const_map).  With resolve == 0 (parse time) only an
# already-folded const counts; with resolve == 1 (emit time, every module
# merged) a PENDING one is resolved first.
fn const_fold_ident(consts: *ConstEntry, name: *u8, len: i32, resolve: i32, out: *i64) -> i32
    var c: *ConstEntry = consts
    while c != null
        if const_name_eq(c, name, len) == 1
            if c.fold_state == CONST_FOLD_PENDING and resolve == 1
                const_resolve(consts, c)
            if c.fold_state != CONST_FOLD_DONE
                return 0
            # A float/struct const's `value` is not its value.
            if is_int_const_type(c.const_type) == 0
                return 0
            *out = c.value
            return 1
        c = c.next
    0

# Fold a constant integer expression into *out: int / char / bool literals,
# unary - ~ !, `as` casts (the value is kept; the const's own type governs its
# use), binary arithmetic, bitwise, shift, comparison and logical operators,
# and references to integer consts in `consts`.  Returns 1 on success, 0 if
# `e` is not such an expression (a call, an unknown name, division by zero,
# an out-of-range shift, ...).
pub fn const_fold_int(consts: *ConstEntry, e: *Expr, resolve: i32, out: *i64) -> i32
    if e == null
        return 0
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_CHAR_LIT
        *out = e.int_val
        return 1
    if e.kind == EXPR_IDENT
        return const_fold_ident(consts, e.ident_ptr, e.ident_len, resolve, out)
    if e.kind == EXPR_CAST
        return const_fold_int(consts, e.left, resolve, out)
    if e.kind == EXPR_UNARY
        var x: i64 = 0
        if const_fold_int(consts, e.operand, resolve, @x) == 0
            return 0
        if e.op == OP_NEG
            *out = 0 - x
            return 1
        if e.op == OP_BIT_NOT
            *out = 0 - x - 1
            return 1
        if e.op == OP_NOT
            if x == 0
                *out = 1
            else
                *out = 0
            return 1
        return 0
    if e.kind == EXPR_BINARY
        var a: i64 = 0
        var b: i64 = 0
        if const_fold_int(consts, e.left, resolve, @a) == 0
            return 0
        if const_fold_int(consts, e.right, resolve, @b) == 0
            return 0
        # AGAST #2356: the i64 `a` has lost whether it was a u64.
        if e.op == OP_SHR and b >= 0 and b <= 63 and const_expr_is_u64(consts, e.left) == 1
            *out = ((a as u64) >> (b as u64)) as i64
            return 1
        return const_fold_binary(e.op, a, b, out)
    0

# Is constant expression `e` a u64?  The rule of int_operand_shape in
# emitter_expr_arith.ritz, for the two widths a fold can tell apart: a literal
# only a u64 can hold, a u64 const, `as u64`, and any operator over those.
fn const_expr_is_u64(consts: *ConstEntry, e: *Expr) -> i32
    if e.kind == EXPR_INT_LIT
        if e.int_val < 0
            return 1
        return 0
    if e.kind == EXPR_CAST
        if e.op == TYPE_U64
            return 1
        return 0
    if e.kind == EXPR_IDENT
        var c: *ConstEntry = consts
        while c != null
            if const_name_eq(c, e.ident_ptr, e.ident_len) == 1
                if c.const_type == TYPE_U64
                    return 1
                return 0
            c = c.next
        return 0
    if e.kind == EXPR_UNARY
        return const_expr_is_u64(consts, e.operand)
    if e.kind == EXPR_BINARY
        if const_expr_is_u64(consts, e.left) == 1
            return 1
        if e.op != OP_SHL and e.op != OP_SHR
            return const_expr_is_u64(consts, e.right)
    0

fn const_fold_binary(op: i32, a: i64, b: i64, out: *i64) -> i32
    if op == OP_ADD
        *out = a + b
    else if op == OP_SUB
        *out = a - b
    else if op == OP_MUL
        *out = a * b
    else if op == OP_DIV or op == OP_MOD
        if b == 0
            return 0
        if op == OP_DIV
            *out = a / b
        else
            *out = a % b
    else if op == OP_BIT_AND
        *out = a & b
    else if op == OP_BIT_OR
        *out = a | b
    else if op == OP_BIT_XOR
        *out = a ^ b
    else if op == OP_SHL or op == OP_SHR
        if b < 0 or b > 63
            return 0
        if op == OP_SHL
            *out = a << b
        else
            *out = a >> b
    else
        let t: i32 = const_fold_compare(op, a, b)
        if t < 0
            return 0
        *out = t as i64
    1

# 1 / 0 for a comparison or logical operator, -1 if `op` is neither.
fn const_fold_compare(op: i32, a: i64, b: i64) -> i32
    var t: i32 = 0
    if op == OP_EQ
        if a == b
            t = 1
    else if op == OP_NE
        if a != b
            t = 1
    else if op == OP_LT
        if a < b
            t = 1
    else if op == OP_GT
        if a > b
            t = 1
    else if op == OP_LE
        if a <= b
            t = 1
    else if op == OP_GE
        if a >= b
            t = 1
    else if op == OP_AND
        if a != 0 and b != 0
            t = 1
    else if op == OP_OR
        if a != 0 or b != 0
            t = 1
    else
        return -1
    t

# =============================================================================
# Import helpers
# =============================================================================

pub fn import_new(p: *Parser, path: *ImportPath) -> *ImportDecl
    let i: *ImportDecl = parser_alloc(p, 24) as *ImportDecl
    i.path = path
    i.next = null
    return i

pub fn path_new(p: *Parser, seg: *u8, len: i32, rest: *ImportPath) -> *ImportPath
    let path: *ImportPath = parser_alloc(p, 24) as *ImportPath
    path.segment = seg as *u8
    path.segment_len = len
    path.next = rest
    return path

# =============================================================================
# Type helpers
# =============================================================================

pub fn type_named(p: *Parser, name: *u8, len: i32) -> i32
    # AGAST #1475: a type alias resolves to its target's parse state.
    if g_alias_count > 0
        let alias_ty: i32 = type_alias_resolve(p, name, len)
        if alias_ty != TYPE_VOID
            return alias_ty
    # Float types: f32 / f64 are first-class type kinds, not TYPE_STRUCT+name.
    # Detect by exact name and return the proper kind so downstream type-
    # tracking (get_expr_type, param_type, etc.) doesn't fall through to
    # struct-shape paths that emit `add i64`/`icmp` instead of fadd/fcmp.
    if len == 3
        if *(name + 0) == 102 and *(name + 1) == 51 and *(name + 2) == 50  # 'f','3','2'
            return TYPE_F32
        if *(name + 0) == 102 and *(name + 1) == 54 and *(name + 2) == 52  # 'f','6','4'
            return TYPE_F64
    # Store the type name in parser state for later retrieval by fn_def_new
    p.last_type_name = name
    p.last_type_name_len = len
    return TYPE_STRUCT

# Capture the return type name after parsing return_type but before parsing block.
# This prevents last_type_name from being overwritten by type_spec calls in the function body.
#
# AGAST #175: also capture for TYPE_PTR / TYPE_REF / TYPE_MUT_REF when the
# pointee was a named struct (last_type_name is still populated from the
# inner type_named call — type_ptr doesn't clear it).  Without this, callers
# like `let cqe = uring_peek_cqe(...)` (returning *IoUringCqe) couldn't
# resolve the pointee struct → var-decl narrowing missed → `cqe.field`
# member access fell through to "; ERROR: unhandled EXPR_MEMBER" with a
# stale `%.0` reference.
# AGAST #2120: the signature of the fn type the last `-> T` named (null for
# any other T), latched by capture_fn_return_type for the FnDef the
# enclosing fn_def action builds after the body.  Every `-> T` rewrites it,
# and fn_ret_fn_sig hands it out only for a TYPE_PTR return, so a fn with no
# `->` (TYPE_VOID) never sees a stale one.
var g_ret_fn_sig: *FnDef = null

fn fn_ret_fn_sig(ret: i32) -> *FnDef
    if ret == TYPE_PTR
        return g_ret_fn_sig
    return null

# AGAST #2308: a `-> @T` / `-> @&T`, latched as g_ret_fn_sig is.
var g_ret_ref: *Param = null

fn fn_ret_ref(ret: i32) -> *Param
    if ret == TYPE_REF or ret == TYPE_MUT_REF
        return g_ret_ref
    return null

# AGAST #2343: a `-> [N]T`, latched the same way.
var g_ret_array: *ArrayElem = null

# AGAST #2329: a `-> *[N]T`, `-> @[N]T` or `-> @&[N]T`, latched the same way.
var g_ret_ptr_array: *Param = null

fn fn_ret_ptr_array(ret: i32) -> *Param
    if ret == TYPE_PTR or ret == TYPE_REF or ret == TYPE_MUT_REF
        return g_ret_ptr_array
    return null

fn fn_ret_array(ret: i32) -> *ArrayElem
    if ret == TYPE_ARRAY
        return g_ret_array
    return null

pub fn capture_fn_return_type(p: *Parser, ret: i32) -> i32
    nd_array_reject(p, ret, parse_pos_line(p), parse_pos_col(p), c"a return type")  # AGAST #1509
    g_ret_fn_sig = fresh_fn_sig(p)   # the type_spec just ended here
    g_ret_ref = null
    g_ret_array = null
    if ret == TYPE_ARRAY
        g_ret_array = array_elem_of_last(p)
    g_ret_ptr_array = ptr_array_of_last(p, ret)   # AGAST #2329
    if ret == TYPE_REF or ret == TYPE_MUT_REF
        g_ret_ref = param_of_type(p, null, 0, ret)
    if ret == TYPE_STRUCT
        p.fn_return_type_name = p.last_type_name
        p.fn_return_type_name_len = p.last_type_name_len
    else if (ret == TYPE_REF or ret == TYPE_MUT_REF) and p.last_ref_inner_type != TYPE_STRUCT
        # AGAST #1453: `-> @i64` leaves last_type_name stale (from an earlier
        # `@P` param, say).  Only a struct referent names itself; var-decl
        # narrowing trusts this name for `let m = get(...)`.
        p.fn_return_type_name = null
        p.fn_return_type_name_len = 0
    else if ret == TYPE_PTR and primitive_name_len(p.last_pointee_type) > 0
        # AGAST #1984: `-> *i32` / `-> *u64`.  last_type_name is null (or
        # stale from an earlier `*S` param), so name the primitive pointee
        # itself, as monomorph does for a specialised `-> *T` (#1980);
        # emit_var_decl maps it to var_pointee_type for `let p = f()`.
        p.fn_return_type_name = primitive_name_from_type(p.last_pointee_type)
        p.fn_return_type_name_len = primitive_name_len(p.last_pointee_type)
    else if ret == TYPE_PTR_PTR
        # AGAST #2791: `-> **U` names U as monomorph names a `*T` at T = *U:
        # the primitive, or the struct.  A `***U` (packed inner) or an unknown
        # U names nothing, so a stale last_type_name can't type `let p = f()`.
        let inner: i32 = ptr_ptr_inner_pointee(p, ret)
        if primitive_name_len(inner) > 0
            p.fn_return_type_name = primitive_name_from_type(inner)
            p.fn_return_type_name_len = primitive_name_len(inner)
        else if inner == TYPE_STRUCT and p.last_type_name != null and p.last_type_name_len > 0
            p.fn_return_type_name = p.last_type_name
            p.fn_return_type_name_len = p.last_type_name_len
        else
            p.fn_return_type_name = null
            p.fn_return_type_name_len = 0
    else if ret == TYPE_PTR or ret == TYPE_REF or ret == TYPE_MUT_REF
        if p.last_type_name != null and p.last_type_name_len > 0
            p.fn_return_type_name = p.last_type_name
            p.fn_return_type_name_len = p.last_type_name_len
        else
            p.fn_return_type_name = null
            p.fn_return_type_name_len = 0
    else
        p.fn_return_type_name = null
        p.fn_return_type_name_len = 0
    return ret

# Capture the variable type name after parsing type_spec but before parsing initializer expr.
# This prevents last_type_name from being overwritten when the initializer contains a generic call.
# For example: var lines: Vec<LineBounds> = vec_with_cap<LineBounds>(64)
# After parsing Vec<LineBounds>, last_type_name is "Vec$LineBounds"
# But parsing vec_with_cap<LineBounds>(64) overwrites it with "LineBounds"
# We save to var_type_name (separate from fn_return_type_name) and stmt_var_decl reads from there.
#
# AGAST #2308: an initializer overwrites what a `@T` local's referent was parsed
# into as well, so it's latched here, whole.  A typed `let` nested in the
# initializer (a block arm) replaces the latch, as it does var_type_name, and a
# nested reference then wins.  No arm lends yet (#2309), which is when it matters.
var g_var_ref: *Param = null
# AGAST #2822: likewise a `[N]T` annotation's shape (`<[M]U>` in the
# initializer re-sets last_array_*), and a `*[N]T`'s pointee array.
var g_var_array: *ArrayElem = null
var g_var_array_size: i32 = 0
var g_var_ptr_array_size: i32 = 0
var g_var_ptr_array_elem: i32 = 0
var g_var_ptr_array_elem_pointee: i32 = 0

# AGAST #2822: one record of all the latches above per typed decl, so a typed
# `let` nested in the initializer (a block arm) can't replace the outer decl's.
# capture_var_type pushes one, tagged with where the annotation ends;
# stmt_var_decl restores the first one after its `let` (the inner decls'
# records sit above it) and drops it and everything above it.  The grammar
# backtracks: a re-capture first drops the records at or after its own end,
# which a failed alternative left behind.
struct VarLatch
    tokens: *Token
    line: i32
    col: i32
    below: *VarLatch
    type_name: *u8
    type_name_len: i32
    pointee: i32
    inner_pointee: i32
    fn_sig: *FnDef
    ref: *Param
    array: *ArrayElem
    array_size: i32
    ptr_array_size: i32
    ptr_array_elem: i32
    ptr_array_elem_pointee: i32

var g_var_latch: *VarLatch = null

# (line, col) strictly after (line2, col2).
fn pos_after(line: i32, col: i32, line2: i32, col2: i32) -> i32
    if line > line2 or (line == line2 and col > col2)
        return 1
    return 0

fn push_var_latch(p: *Parser)
    let end: *Token = p.tokens + (p.pos - 1)
    # A record from another file's parse, or one at/after this annotation
    # (a failed alternative's), is stale.
    while g_var_latch != null and (g_var_latch.tokens != p.tokens or pos_after(end.line, end.col, g_var_latch.line, g_var_latch.col) == 0)
        g_var_latch = g_var_latch.below
    let r: *VarLatch = parser_alloc(p, sizeof(VarLatch)) as *VarLatch
    r.tokens = p.tokens
    r.line = end.line
    r.col = end.col
    r.below = g_var_latch
    r.type_name = p.var_type_name
    r.type_name_len = p.var_type_name_len
    r.pointee = p.var_pointee
    r.inner_pointee = p.var_inner_pointee
    r.fn_sig = p.var_fn_sig
    r.ref = g_var_ref
    r.array = g_var_array
    r.array_size = g_var_array_size
    r.ptr_array_size = g_var_ptr_array_size
    r.ptr_array_elem = g_var_ptr_array_elem
    r.ptr_array_elem_pointee = g_var_ptr_array_elem_pointee
    g_var_latch = r

# Restore the latches of the typed decl whose `let` is at (line, col).
fn pop_var_latch(p: *Parser, line: i32, col: i32)
    var mine: *VarLatch = null
    var r: *VarLatch = g_var_latch
    while r != null and r.tokens == p.tokens and pos_after(r.line, r.col, line, col) != 0
        mine = r
        r = r.below
    if mine == null
        return
    g_var_latch = mine.below
    p.var_type_name = mine.type_name
    p.var_type_name_len = mine.type_name_len
    p.var_pointee = mine.pointee
    p.var_inner_pointee = mine.inner_pointee
    p.var_fn_sig = mine.fn_sig
    g_var_ref = mine.ref
    g_var_array = mine.array
    g_var_array_size = mine.array_size
    g_var_ptr_array_size = mine.ptr_array_size
    g_var_ptr_array_elem = mine.ptr_array_elem
    g_var_ptr_array_elem_pointee = mine.ptr_array_elem_pointee

pub fn capture_var_type(p: *Parser, ty: i32) -> i32
    g_var_ref = null
    if ty == TYPE_REF or ty == TYPE_MUT_REF
        g_var_ref = param_of_type(p, null, 0, ty)
    g_var_array = null
    g_var_array_size = 0
    if ty == TYPE_ARRAY
        g_var_array = array_elem_of_last(p)
        g_var_array_size = p.last_array_size
    g_var_ptr_array_size = ptr_array_pointee_size(p, ty)
    g_var_ptr_array_elem = ptr_array_pointee_elem(p, ty)
    g_var_ptr_array_elem_pointee = ptr_array_elem_pointee(p, ty)
    if ty == TYPE_STRUCT
        p.var_type_name = p.last_type_name
        p.var_type_name_len = p.last_type_name_len
    else if ty == TYPE_PTR and p.last_pointee_type == TYPE_STRUCT
        # AGAST #2822: `let p: *A = pick<*B>(..)` -- the `<*B>` re-sets
        # last_type_name, so p took B's field offsets and stride.
        p.var_type_name = p.last_type_name
        p.var_type_name_len = p.last_type_name_len
    else if (ty == TYPE_REF or ty == TYPE_MUT_REF) and p.last_ref_inner_type == TYPE_STRUCT
        # AGAST #1754: `let q: @&S = ...` / `let r: @S = ...` keep the pointee
        # struct name (as params do) so `q.a` resolves.
        p.var_type_name = p.last_type_name
        p.var_type_name_len = p.last_type_name_len
    else if ty == TYPE_PTR_PTR and ptr_ptr_slot_inner(ptr_ptr_inner_pointee(p, ty)) == TYPE_STRUCT
        # AGAST #1933: `let pp: **S = ...` keeps S (as a `**S` param does)
        # so `(**pp).f` resolves.  AGAST #1924: `***S` too; its depth rides
        # in var_inner_pointee_type.
        p.var_type_name = p.last_type_name
        p.var_type_name_len = p.last_type_name_len
    else
        p.var_type_name = null
        p.var_type_name_len = 0
    # AGAST #2805: `let qq: **S = vec_as_ptr<*S>(@w)` -- the `<*S>` re-sets
    # last_pointee_type, so stmt_var_decl read a `*S`'s pointee and slot for
    # qq: `qq + 1` strode sizeof(S), not 8, and `(*(qq + 1)).b` was "unhandled
    # EXPR_MEMBER".  `let p: *i32 = f<*u8>(..)` strode one byte the same way.
    p.var_pointee = p.last_pointee_type
    p.var_inner_pointee = ptr_ptr_inner_pointee(p, ty)
    # AGAST #1671: latch a `let f: fn(...) -> T` signature before the
    # initializer is parsed (it may contain fn types of its own).
    # AGAST #1747: on a `[N]fn(...) -> T` array it is the ELEMENT signature
    # (the fn type ends where the array type does); `fs[i](..)` calls by it.
    p.var_fn_sig = null
    if ty == TYPE_PTR or ty == TYPE_ARRAY
        p.var_fn_sig = fresh_fn_sig(p)
    push_var_latch(p)
    return ty

# =============================================================================
# Function-pointer types (AGAST #1671)
# =============================================================================
#
# `fn(u8) -> bool` lowers to TYPE_PTR like any pointer, but a call through
# such a value must use the callee's real LLVM signature: the callee is
# `define i1 @is_d(i8 ...)`, and calling it as `call i64 %f(i64 ...)` reads
# rax's garbage upper bits as the bool.  type_fn keeps the signature as a
# nameless FnDef (params + return type), the same shape a direct call
# consults, and leaves it in p.last_fn_sig tagged with the token position
# the type ended at.  fresh_fn_sig hands it out only while p.pos is still
# there, so it attaches to exactly the declaration whose type it is.
pub fn type_fn(p: *Parser, params: *Param, ret: i32) -> i32
    let f: *FnDef = parser_alloc(p, sizeof(FnDef)) as *FnDef
    f.ret_written_void = 0   # AGAST #2236
    f.name = null
    f.name_len = 0
    f.params = params
    f.return_type = ret
    f.return_type_name = null
    f.return_type_name_len = 0
    # A struct return names itself in last_type_name, which the return
    # type_spec just set (it is the last thing parsed before this action).
    if ret == TYPE_STRUCT
        f.return_type_name = p.last_type_name as *u8
        f.return_type_name_len = p.last_type_name_len
    f.body = null
    f.line = 0
    f.next = null
    f.type_params = null
    f.is_local = 0
    f.def_file = null  # AGAST #2148: item_dispatch_fn sets these three
    f.target_gated = 0
    f.from_generated = 0
    f.ret_fn_sig = null
    f.ret_ref = null
    f.ret_array = null
    f.ret_ptr_array = null
    p.last_fn_sig = f
    p.last_fn_sig_pos = p.pos
    return TYPE_PTR

# The signature of the fn type that ends at the current token, or null.
pub fn fresh_fn_sig(p: *Parser) -> *FnDef
    if p.last_fn_sig != null and p.last_fn_sig_pos == p.pos
        return p.last_fn_sig
    return null

# AGAST #1509: the shape of `[size]<inner>`, where <inner> is the array type
# whose info p.last_array_* / p.last_array_shape still hold.  A 1-D inner
# `[M]T` becomes rank 2 `[size][M]T`; a deeper inner gains one leading dim.
# Returns null (and reports) past MAX_ARRAY_RANK.
fn array_shape_prepend(p: *Parser, size: i32) -> *ArrayShape
    let sh: *ArrayShape = parser_alloc(p, sizeof(ArrayShape)) as *ArrayShape
    let inner: *ArrayShape = p.last_array_shape
    sh.dims[0] = size
    if inner == null
        sh.rank = 2
        sh.dims[1] = p.last_array_size
        sh.leaf_type = p.last_array_elem_type
        sh.leaf_name = p.last_array_elem_type_name
        sh.leaf_name_len = p.last_array_elem_type_name_len
        sh.leaf_pointee = p.last_array_elem_pointee
        return sh
    if inner.rank >= MAX_ARRAY_RANK
        eprints_cstr(c"error: ")
        eprint_parse_location(p)
        eprintln_cstr(c"array type has more than 8 dimensions")
        g_attr_errors = g_attr_errors + 1
        return null
    sh.rank = inner.rank + 1
    var d: i32 = 0
    while d < inner.rank
        sh.dims[d + 1] = inner.dims[d]
        d = d + 1
    sh.leaf_type = inner.leaf_type
    sh.leaf_name = inner.leaf_name
    sh.leaf_name_len = inner.leaf_name_len
    sh.leaf_pointee = inner.leaf_pointee
    return sh

# AGAST #1509: 1 when the type just parsed (`ty`, with p's array state) is
# a multi-dimensional array `[N][M]..T`.
pub fn is_nd_array_type(p: *Parser, ty: i32) -> i32
    if ty == TYPE_ARRAY and p.last_array_elem_type == TYPE_ARRAY
        return 1
    0

var g_nd_reject_line: i32 = -1
var g_nd_reject_col: i32 = -1

# AGAST #1509: fail closed where ritz1 cannot lower a multi-dimensional
# array type.  Only local and global `var` declarations and (AGAST #2097)
# struct fields carry an ArrayShape; an enum payload, parameter, return type, const or pointee of type
# `[N][M]T` used to be laid out as `[N x i64]` and miscompiled silently.
# `what` names the site ("a struct field", ...).  Reported once per source
# position (the grammar can re-run an action while backtracking); the
# parse-time error count (g_attr_errors) fails the compile.
# Returns 1 when it rejected `ty`.
pub fn nd_array_reject(p: *Parser, ty: i32, line: i32, col: i32, what: *u8) -> i32
    if is_nd_array_type(p, ty) == 0
        return 0
    return nd_array_report(line, col, what)

# The diagnostic itself, for sites that already know the type is N-D.
fn nd_array_report(line: i32, col: i32, what: *u8) -> i32
    if line == g_nd_reject_line and col == g_nd_reject_col
        return 1
    g_nd_reject_line = line
    g_nd_reject_col = col
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": a multi-dimensional array type is not supported as ")
    eprints_cstr(what)
    eprintln_cstr(c" in ritz1 (only a local or global `var` or a struct field can be one)")
    return 1

# The line / col of the token at p.pos (0 / 0 past the end), for sites whose
# action has no position of its own.
fn parse_pos_line(p: *Parser) -> i32
    if p.pos < p.token_count
        let tok: *Token = p.tokens + p.pos
        return tok.line
    0

fn parse_pos_col(p: *Parser) -> i32
    if p.pos < p.token_count
        let tok: *Token = p.tokens + p.pos
        return tok.col
    0

# Parse array size from digit string and store array info in parser state
pub fn type_array(p: *Parser, size_str: *u8, size_len: i32, elem_type: i32) -> i32
    # Parse the size string to an integer
    var size: i32 = 0
    for i in 0..size_len
        let digit: i32 = (*(size_str + i)) as i32 - 48  # '0' = 48
        size = size * 10 + digit
    type_array_sized(p, size, elem_type)

# AGAST #2153: `[N]T` / `[N * 2]T` — the length is a constant integer
# expression, folded now against the consts parsed so far.  Imports are merged
# only after parsing, so a const from an import, or one declared later in this
# file, does not fold here: that is a located error (the item still parses, so
# the message is the one the user sees), not a silently wrong length.
pub fn type_array_expr(p: *Parser, len_expr: *Expr, line: i32, col: i32, elem_type: i32) -> i32
    var v: i64 = 0
    if const_fold_int(p.module.constants, len_expr, 0, @v) == 0
        array_len_report(line, col, c"is not a constant integer expression ritz1 can fold here (only literals and consts declared earlier in this file)")
        v = 0
    else if v < 0 or v > 2147483647
        array_len_report(line, col, c"is out of range (it must be 0 to 2147483647)")
        v = 0
    type_array_sized(p, v as i32, elem_type)

# The backtracking parser re-runs an action each time it retries the
# alternative: report each `[` once, as nd_array_report does.
var g_array_len_line: i32 = -1
var g_array_len_col: i32 = -1

fn array_len_report(line: i32, col: i32, why: *u8)
    if line == g_array_len_line and col == g_array_len_col
        return
    g_array_len_line = line
    g_array_len_col = col
    g_attr_errors = g_attr_errors + 1
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": array length ")
    eprintln_cstr(why)

# AGAST #2343: the element of the `[N]T` just parsed.
fn array_elem_of_last(p: *Parser) -> *ArrayElem
    let a: *ArrayElem = parser_alloc(p, sizeof(ArrayElem)) as *ArrayElem
    a.elem = p.last_array_elem_type
    a.pointee = p.last_array_elem_pointee
    a.name = p.last_array_elem_type_name
    a.name_len = p.last_array_elem_type_name_len
    a.shape = p.last_array_shape
    return a

fn type_array_sized(p: *Parser, size: i32, elem_type: i32) -> i32
    # AGAST #1509: `[size]<array>` is multi-dimensional.  The inner array's
    # info is still in p.last_array_* (type_spec is right-recursive, so the
    # inner `[M]T` action ran just before this one): prepend `size` to its
    # shape before the 1-D fields below are overwritten with the outer dim.
    if elem_type == TYPE_ARRAY
        p.last_array_shape = array_shape_prepend(p, size)
    else
        p.last_array_shape = null
    # Store in parser state for field_new to retrieve
    p.last_array_size = size
    p.last_array_elem_type = elem_type
    p.last_array_elem_pointee = TYPE_VOID
    if elem_type == TYPE_PTR
        p.last_array_elem_pointee = p.last_pointee_type
    else if elem_type == TYPE_PTR_PTR
        # AGAST #2376: `[N]**T` records T packed as a `**T` does, so `**a[i]`
        # loads a T.  Every reader of an element's pointee asks for a TYPE_PTR
        # element first, and ptr_levels_of reads this one.
        p.last_array_elem_pointee = ptr_ptr_inner_pointee(p, TYPE_PTR_PTR)
    # If element type is a struct, capture the struct name from last_type_name
    if elem_type == TYPE_STRUCT
        p.last_array_elem_type_name = p.last_type_name
        p.last_array_elem_type_name_len = p.last_type_name_len
    else if (elem_type == TYPE_PTR or elem_type == TYPE_PTR_PTR) and p.last_inner_pointee_type == TYPE_STRUCT
        # AGAST #184: [N]*Foo / [N]**Foo — array of pointer-to-struct.
        # Save the deepest pointee struct name so emit_member_ptr can resolve
        # `arr[i].field` by loading the *Foo and GEPing into Foo. Without this,
        # ritz1's emit_member_ptr fell through to "; ERROR: unhandled
        # EXPR_MEMBER" for tome's `update[k].forward[k]` pattern (zset_add).
        p.last_array_elem_type_name = p.last_type_name
        p.last_array_elem_type_name_len = p.last_type_name_len
    else
        p.last_array_elem_type_name = null
        p.last_array_elem_type_name_len = 0
    return TYPE_ARRAY

# AGAST #1815: the innermost pointee of a just-parsed `**T`, for
# Param / Stmt / GlobalVarDef / StructField.  AGAST #1924: a `***T` (or
# deeper) packs its extra levels in as multiples of PTR_DEPTH_UNIT, so
# `*(*(*(ppp + i) + j) + k)` knows both the 8-byte strides and T.
# AGAST #2372: a reference to one (`@**T`) records the same, so `.` knows the depth.
pub fn ptr_ptr_inner_pointee(p: *Parser, ty: i32) -> i32
    var pointer: i32 = ty
    if ty == TYPE_REF or ty == TYPE_MUT_REF
        pointer = p.last_ref_inner_type
    if pointer != TYPE_PTR_PTR
        return TYPE_VOID
    if p.last_pointee_type == TYPE_PTR
        return p.last_inner_pointee_type
    if p.last_ptr_depth < 3 or p.last_inner_pointee_type == TYPE_VOID
        return TYPE_VOID
    return p.last_inner_pointee_type + (p.last_ptr_depth - 2) * PTR_DEPTH_UNIT

# AGAST #2343: U for a just-parsed `*[N]*U` (TYPE_VOID otherwise).
pub fn ptr_array_elem_pointee(p: *Parser, ty: i32) -> i32
    if ty != TYPE_PTR or p.last_pointee_type != TYPE_ARRAY or p.last_array_elem_type != TYPE_PTR
        return TYPE_VOID
    return p.last_array_elem_pointee

# AGAST #2539: 1 for a just-parsed `*[N]T` or `**[N]T`.  type_array set
# last_array_* while parsing the pointee, and the outer `*` of `**[N]T` parses
# nothing, so they are current in both.  A `**[N]T` records N and T as the
# `*[N]T` that `*r` reads does.
fn ptr_names_array(p: *Parser, ty: i32) -> i32
    if ty == TYPE_PTR and p.last_pointee_type == TYPE_ARRAY
        return 1
    if ty == TYPE_PTR_PTR and p.last_pointee_type == TYPE_PTR and p.last_inner_pointee_type == TYPE_ARRAY and p.last_ptr_depth == 2
        return 1
    0

# AGAST #1953: N for a just-parsed `*[N]T` (0 otherwise), or `**[N]T` (#2539).
pub fn ptr_array_pointee_size(p: *Parser, ty: i32) -> i32
    if ptr_names_array(p, ty) == 0
        return 0
    return p.last_array_size

# AGAST #1953: T for a just-parsed `*[N]T` (TYPE_VOID otherwise), or `**[N]T` (#2539).
pub fn ptr_array_pointee_elem(p: *Parser, ty: i32) -> i32
    if ptr_names_array(p, ty) == 0
        return TYPE_VOID
    return p.last_array_elem_type

# Handle pointer type *T
# Stores the pointee type and preserves type name if pointing to struct/generic
pub fn type_ptr(p: *Parser, inner_type: i32) -> i32
    nd_array_reject(p, inner_type, parse_pos_line(p), parse_pos_col(p), c"a pointee")  # AGAST #1509
    # Store pointee type for emitter
    p.last_pointee_type = inner_type
    # AGAST #184: track the deepest non-pointer pointee.  For **Foo the
    # innermost type_ptr call has inner_type=TYPE_STRUCT and we lock that
    # in; the outer call (inner_type=TYPE_PTR) leaves it alone.  This lets
    # field_new tell **Foo from **u8 even though both end up with
    # last_pointee_type=TYPE_PTR.
    if inner_type != TYPE_PTR and inner_type != TYPE_PTR_PTR
        p.last_inner_pointee_type = inner_type
        p.last_ptr_depth = 1
    else
        # AGAST #1924: one more level on the pointer just built.
        p.last_ptr_depth = p.last_ptr_depth + 1
    # Note: last_type_name/len was already set by parsing inner_type if it's a struct/generic
    # No need to modify it - stmt_var_decl will read both
    # Return TYPE_PTR_PTR for pointer-to-pointer types
    if inner_type == TYPE_PTR or inner_type == TYPE_PTR_PTR
        return TYPE_PTR_PTR
    return TYPE_PTR

# =============================================================================
# Type aliases (AGAST #1475)
# =============================================================================
#
# `type Name = T` is transparent, as in ritz0: the alias IS T.  ritz1 has no
# type objects, only a kind (TYPE_*) plus side-channel parser state that
# type_spec leaves behind (last_type_name for structs/generics, pointee info
# for pointers, element info for arrays, inner kind for refs).  So an alias
# is a snapshot of exactly that state, taken when its declaration is parsed,
# and type_named replays it wherever the alias name is used as a type.  The
# emitter and monomorph never see an alias name.
#
# The table is process-wide, not per-Parser: aliases must be visible across
# modules (goliath: `import goliath.error { ErrorCode }`).  Because an
# importer is parsed before its imports, and items may be used before they
# are declared, the driver re-parses everything once when the first pass
# recorded any alias (main.ritz, reparse_with_aliases).  Re-recording in that
# pass overwrites each entry by name, which is also how an alias of an alias
# declared later in the file settles.
#
# Parallel pointer arrays of heap entries (not an array of structs), the
# same shape the enum tracker below uses under self-hosting.

struct AliasEntry
    name: *u8
    name_len: i32
    kind: i32
    type_name: *u8
    type_name_len: i32
    pointee_type: i32
    inner_pointee_type: i32
    array_size: i32
    array_elem_type: i32
    array_elem_type_name: *u8
    array_elem_type_name_len: i32
    ref_inner_type: i32
    ptr_depth: i32         # AGAST #1924
    array_shape: *ArrayShape  # AGAST #1509
    fn_sig: *FnDef         # AGAST #1879: a fn type's signature (type_fn)

const MAX_TYPE_ALIASES: i32 = 1024
const ALIAS_ENTRY_BYTES: i64 = 128   # >= sizeof(AliasEntry), with headroom

var g_alias_table: **u8 = null
var g_alias_count: i32 = 0

pub fn type_alias_count() -> i32
    g_alias_count

fn type_alias_find(name: *u8, len: i32) -> *AliasEntry
    var i: i32 = 0
    while i < g_alias_count
        let e: *AliasEntry = *(g_alias_table + i) as *AliasEntry
        if buf_eq(e.name, e.name_len, name, len) == 1
            return e
        i = i + 1
    return null

# Does replaying this kind need the side-channel state?  Primitive kinds
# carry everything in the kind itself, and type_spec's primitive
# alternatives leave the parser state untouched, so an alias of one must
# too (otherwise it would replay whatever stale struct name happened to be
# in last_type_name when the alias was declared).
fn type_alias_kind_has_state(kind: i32) -> i32
    if kind == TYPE_PTR or kind == TYPE_PTR_PTR
        return 1
    if kind == TYPE_STRUCT or kind == TYPE_ARRAY or kind == TYPE_REF or kind == TYPE_MUT_REF
        return 1
    return 0

# Grammar action for type_alias_def.  Runs after type_spec, so the parser
# state is exactly the target type's.  attrs ran first, so p.skip_item is
# already set for a [[target_os = "<not linux>"]] alias: don't record it.
pub fn type_alias_record(p: *Parser, name: *u8, len: i32, kind: i32) -> i32
    if p.skip_item != 0
        return kind
    var e: *AliasEntry = type_alias_find(name, len)
    if e == null
        if g_alias_table == null
            g_alias_table = malloc((MAX_TYPE_ALIASES as i64) * 8) as **u8
        if g_alias_count >= MAX_TYPE_ALIASES
            # Never drop a declaration silently: an unrecorded alias would
            # surface much later as an unknown struct type.
            eprint_parse_location(p)
            eprintln_cstr(c"error: too many type aliases (raise MAX_TYPE_ALIASES)")
            p.error = 1
            return kind
        e = malloc(ALIAS_ENTRY_BYTES) as *AliasEntry
        *(g_alias_table + g_alias_count) = e as *u8
        g_alias_count = g_alias_count + 1
    e.name = name
    e.name_len = len
    e.kind = kind
    e.type_name = p.last_type_name
    e.type_name_len = p.last_type_name_len
    e.pointee_type = p.last_pointee_type
    e.inner_pointee_type = p.last_inner_pointee_type
    e.ptr_depth = p.last_ptr_depth
    e.array_size = p.last_array_size
    e.array_elem_type = p.last_array_elem_type
    e.array_elem_type_name = p.last_array_elem_type_name
    e.array_elem_type_name_len = p.last_array_elem_type_name_len
    e.array_shape = p.last_array_shape
    e.ref_inner_type = p.last_ref_inner_type
    # AGAST #1879: a fn-type alias keeps its signature, so a value typed
    # with the alias calls typed (and with the alias's [[callconv]]).
    e.fn_sig = g_alias_fn_sig
    g_alias_fn_sig = null
    if e.fn_sig != null and (g_attr_bits & ATTR_WIN64) != 0
        item_attr_record(e.fn_sig as *u8, ATTR_WIN64)
    return kind

# The signature of the fn type an alias names, latched by alias_type_latch
# where the type ends; null for any other type.
var g_alias_fn_sig: *FnDef = null

pub fn alias_type_latch(p: *Parser, kind: i32) -> i32
    g_alias_fn_sig = fresh_fn_sig(p)
    kind

# `sizeof(Alias)` (AGAST #2124): the alias's target as `count` values of leaf
# kind `*leaf` (struct `*leaf_name` for TYPE_STRUCT).  0 when `name` is no
# alias.  The emitter sizes the leaf; an alias of a pointer is one pointer.
pub fn type_alias_sizeof_shape(name: *u8, len: i32, count: *i64, leaf: *i32, leaf_name: **u8, leaf_len: *i32) -> i32
    let e: *AliasEntry = type_alias_find(name, len)
    if e == null
        return 0
    *count = 1
    *leaf = e.kind
    *leaf_name = e.type_name
    *leaf_len = e.type_name_len
    if e.kind == TYPE_ARRAY
        let sh: *ArrayShape = e.array_shape
        if sh != null
            var n: i64 = 1
            var d: i32 = 0
            while d < sh.rank
                n = n * (sh.dims[d] as i64)
                d = d + 1
            *count = n
            *leaf = sh.leaf_type
            *leaf_name = sh.leaf_name
            *leaf_len = sh.leaf_name_len
        else
            *count = e.array_size as i64
            *leaf = e.array_elem_type
            *leaf_name = e.array_elem_type_name
            *leaf_len = e.array_elem_type_name_len
    return 1

# Called from type_named.  Returns the alias's kind with its parse state
# replayed into p, or TYPE_VOID when `name` is not an alias (no alias can
# have kind TYPE_VOID: type_spec never yields it).
pub fn type_alias_resolve(p: *Parser, name: *u8, len: i32) -> i32
    let e: *AliasEntry = type_alias_find(name, len)
    if e == null
        return TYPE_VOID
    if type_alias_kind_has_state(e.kind) == 1
        p.last_type_name = e.type_name
        p.last_type_name_len = e.type_name_len
        p.last_pointee_type = e.pointee_type
        p.last_inner_pointee_type = e.inner_pointee_type
        p.last_ptr_depth = e.ptr_depth
        p.last_array_size = e.array_size
        p.last_array_elem_type = e.array_elem_type
        p.last_array_elem_type_name = e.array_elem_type_name
        p.last_array_elem_type_name_len = e.array_elem_type_name_len
        p.last_array_shape = e.array_shape
        p.last_ref_inner_type = e.ref_inner_type
    if e.fn_sig != null
        # As type_fn leaves it: fresh at the token after the alias name.
        p.last_fn_sig = e.fn_sig
        p.last_fn_sig_pos = p.pos
    return e.kind

# item dispatcher for type_alias_def: like item_dispatch_enum, the alias
# has no AST node (it lives in the alias table), so only reset skip_item.
pub fn item_dispatch_alias(p: *Parser) -> i32
    p.skip_item = 0
    g_attr_bits = 0
    return 1

# Handle immutable reference type @T
# References are semantically pointers for now - store the inner type info
pub fn type_ref(p: *Parser, inner_type: i32) -> i32
    # Store inner type information for emitter
    p.last_ref_inner_type = inner_type
    return TYPE_REF

# Handle mutable reference type @@T
# References are semantically pointers for now - store the inner type info
pub fn type_mut_ref(p: *Parser, inner_type: i32) -> i32
    # Store inner type information for emitter
    p.last_ref_inner_type = inner_type
    return TYPE_MUT_REF

# Saved identity of ONE generic type argument, captured right after it
# parses.  Without it, mangling `Result<Vec<u8>, StrView>` would read StrView
# as the first argument's name (parsing a later arg clobbers last_type_name).
#
# AGAST #1300: this used to be a single global save slot, which a generic in
# the TAIL overwrote before the outer type was mangled —
# `HashMap<String, Vec<Connection>>` mangled as `HashMap$Connection`.  Each
# capture now gets its own arena record, so nesting is reentrant.
#
# AGAST #1574: the records form the whole argument list (`next`), and EVERY
# argument drives mangling: `Pair<i64, i32>` is `Pair$i64$i32`, not
# `Pair$i64` (which left the second parameter unsubstituted and collided
# with `Pair<i64, i64>`).
struct GenericArg
    ty: i32
    name: *u8
    name_len: i32
    next: *GenericArg

# Called from grammar rules first_generic_type_arg / first_generic_type_arg_shr
# right after the argument's type_spec parses, while last_type_name is fresh.
pub fn capture_first_generic_arg(p: *Parser, ty: i32) -> *GenericArg
    nd_array_reject(p, ty, parse_pos_line(p), parse_pos_col(p), c"a generic type argument")  # AGAST #1509
    let ga: *GenericArg = parser_alloc(p, 32) as *GenericArg
    ga.ty = ty
    if ty == TYPE_STRUCT
        ga.name = p.last_type_name
        ga.name_len = p.last_type_name_len
    else if ty == TYPE_PTR or ty == TYPE_PTR_PTR
        # AGAST #1519: a pointer's pointee is only in parser state now, so
        # spell it here ("ptr_u8", "ptr_ptr_Foo"); generic_arg_spelling
        # returns the saved name.
        var n: i32 = 0
        ga.name = spell_ptr_generic_arg(p, ty, @n)
        ga.name_len = n
    else if ty == TYPE_ARRAY
        # AGAST #2832: `[2]i8` is "arr2_i8".  It spelled as nothing, so
        # `Box<[2]i8>` and `Box<[4]i64>` were one `%Box$`.
        var n: i32 = 0
        ga.name = spell_last_array(p, @n)
        ga.name_len = n
    else if ty == TYPE_VOID
        # AGAST #2272: `()`.  Only the unit type parses to TYPE_VOID here.
        ga.name = c"unit"
        ga.name_len = 4
    else
        ga.name = null
        ga.name_len = 0
    ga.next = null
    return ga

# Spelling of a primitive type argument, as ritz0 mangles it (its type
# name).  Returns its length (0 for a non-primitive) and the bytes in *out.
# AGAST #1922: only u8/i8/i32/i64/u64 were spelled, so `Option<u32>` mangled
# as `Option$` and tagged_enum_layout could not measure it.
fn primitive_arg_spelling(ty: i32, out: **u8) -> i32
    if ty == TYPE_U8
        *out = c"u8"
        return 2
    if ty == TYPE_I8
        *out = c"i8"
        return 2
    if ty == TYPE_U16
        *out = c"u16"
        return 3
    if ty == TYPE_I16
        *out = c"i16"
        return 3
    if ty == TYPE_U32
        *out = c"u32"
        return 3
    if ty == TYPE_I32
        *out = c"i32"
        return 3
    if ty == TYPE_U64
        *out = c"u64"
        return 3
    if ty == TYPE_I64
        *out = c"i64"
        return 3
    if ty == TYPE_F32
        *out = c"f32"
        return 3
    if ty == TYPE_F64
        *out = c"f64"
        return 3
    if ty == TYPE_BOOL
        *out = c"bool"
        return 4
    *out = null
    return 0

# Mangle the pointer type that just parsed as ritz0 does (monomorph.py
# mangle_type_name): "ptr_" per level, then the pointee's spelling — a
# primitive's name or the struct/generic name in last_type_name.  `*u8` is
# "ptr_u8", `**Foo` "ptr_ptr_Foo".  type_ptr records only the immediate and
# the innermost pointee, so depth is exact up to two levels; a deeper
# pointer spells as "" (clang then rejects the IR loudly).
fn spell_ptr_generic_arg(p: *Parser, ty: i32, out_len: *i32) -> *u8
    if p.last_inner_pointee_type == TYPE_ARRAY
        # AGAST #2832: `*[2]i8` is "ptr_arr2_i8".  The array's spelling stands
        # where a struct pointee's name would.
        var n: i32 = 0
        let arr: *u8 = spell_last_array(p, @n)
        return spell_ptr_parts(p, ty, p.last_pointee_type, TYPE_STRUCT, arr, n, out_len)
    return spell_ptr_parts(p, ty, p.last_pointee_type, p.last_inner_pointee_type, p.last_type_name, p.last_type_name_len, out_len)

# AGAST #2832: the `[N]E` that just parsed, spelled as ritz0's
# mangle_type_name means it: "arr" N "_" E, E being a primitive's name, a
# struct's, or "ptr_" + either for a one-level pointer element.  `[2]i8` is
# "arr2_i8", `[3]Foo` "arr3_Foo", `[4]*u8` "arr4_ptr_u8".  Any other element
# spells as "" (out_len 0), as an unspellable argument always has.  Reads
# p.last_array_*, which type_array wrote for this array.
fn spell_last_array(p: *Parser, out_len: *i32) -> *u8
    var elem: *u8 = null
    var elem_len: i32 = 0
    var ptr: i32 = 0
    let et: i32 = p.last_array_elem_type
    if et == TYPE_STRUCT
        elem = p.last_array_elem_type_name
        elem_len = p.last_array_elem_type_name_len
    else if et == TYPE_PTR
        ptr = 1
        if p.last_array_elem_pointee == TYPE_STRUCT
            elem = p.last_array_elem_type_name
            elem_len = p.last_array_elem_type_name_len
        else
            elem_len = primitive_arg_spelling(p.last_array_elem_pointee, @elem)
    else
        elem_len = primitive_arg_spelling(et, @elem)
    if elem_len <= 0 or elem == null
        *out_len = 0
        return null
    # "arr" + up to 10 digits + "_" + "ptr_" + elem
    let name: *u8 = parser_alloc(p, (elem_len + 19) as i64)
    *name = 97        # 'a'
    *(name + 1) = 114 # 'r'
    *(name + 2) = 114 # 'r'
    var pos: i32 = 3
    pos = pos + write_dec_i32(name + pos, p.last_array_size)
    *(name + pos) = 95  # '_'
    pos = pos + 1
    if ptr == 1
        *(name + pos) = 112      # 'p'
        *(name + pos + 1) = 116  # 't'
        *(name + pos + 2) = 114  # 'r'
        *(name + pos + 3) = 95   # '_'
        pos = pos + 4
    for i in 0..elem_len
        *(name + pos) = *(elem + i)
        pos = pos + 1
    *(name + pos) = 0
    *out_len = pos
    return name

# The decimal digits of n >= 0 at buf; returns how many.
fn write_dec_i32(buf: *u8, n: i32) -> i32
    var digits: [10]u8
    var count: i32 = 0
    var v: i32 = n
    if v <= 0
        *buf = 48  # '0'
        return 1
    while v > 0
        digits[count] = (48 + v % 10) as u8
        v = v / 10
        count = count + 1
    for i in 0..count
        *(buf + i) = digits[count - 1 - i]
    return count

# spell_ptr_generic_arg over explicit parts, so an alias table entry (which
# saved the same fields) spells without replaying itself into p.
fn spell_ptr_parts(p: *Parser, ty: i32, pointee: i32, inner: i32, type_name: *u8, type_name_len: i32, out_len: *i32) -> *u8
    var depth: i32 = 1
    if ty == TYPE_PTR_PTR
        if pointee != TYPE_PTR
            *out_len = 0
            return null
        depth = 2
    var base: *u8 = null
    var base_len: i32 = 0
    if inner == TYPE_STRUCT
        base = type_name
        base_len = type_name_len
    else
        base_len = primitive_arg_spelling(inner, @base)
    if base_len <= 0
        *out_len = 0
        return null
    let total: i32 = depth * 4 + base_len
    let name: *u8 = parser_alloc(p, (total + 1) as i64)
    var pos: i32 = 0
    for d in 0..depth
        *(name + pos) = 112      # 'p'
        *(name + pos + 1) = 116  # 't'
        *(name + pos + 2) = 114  # 'r'
        *(name + pos + 3) = 95   # '_'
        pos = pos + 4
    for i in 0..base_len
        *(name + pos) = *(base + i)
        pos = pos + 1
    *(name + pos) = 0
    *out_len = pos
    return name

# AGAST #2037: build a single-token generic call's suffix — "$" + prefix +
# the type argument's mangled spelling.  The token rules (`f<T>`, `f<*T>`,
# `f<@T>`) never pass the token through type_named, so an alias (`type Id =
# u32`) used to mangle by its own name ("$Id"), instantiating `Vec$Id` where
# a `Vec<Id>` field had resolved to `Vec$u32`.  An alias spells as its
# target, exactly as generic_arg_spelling would after type_named replayed it
# (the table entry holds the final target, so alias-of-alias is settled).
# Anything else spells as the token text.  Reads the table without touching
# parser state.
fn generic_tok_suffix(p: *Parser, prefix: *u8, prefix_len: i32, tok: Token, out_len: *i32) -> *u8
    var spell: *u8 = tok.start
    var spell_len: i32 = tok.len
    if g_alias_count > 0
        let e: *AliasEntry = type_alias_find(tok.start, tok.len)
        if e != null
            var n: i32 = 0
            if e.kind == TYPE_STRUCT
                spell = e.type_name
                n = e.type_name_len
            else if e.kind == TYPE_PTR or e.kind == TYPE_PTR_PTR
                spell = spell_ptr_parts(p, e.kind, e.pointee_type, e.inner_pointee_type, e.type_name, e.type_name_len, @n)
            else
                n = primitive_arg_spelling(e.kind, @spell)
            # A target with no spelling (array, fn type, ...) keeps the alias
            # name: no worse than before, and the mismatch stays visible.
            if n > 0
                spell_len = n
            else
                spell = tok.start
    let total: i32 = 1 + prefix_len + spell_len
    let buf: *u8 = parser_alloc(p, (total + 1) as i64)
    *buf = 36  # '$'
    for i in 0..prefix_len
        *(buf + 1 + i) = *(prefix + i)
    for i in 0..spell_len
        *(buf + 1 + prefix_len + i) = *(spell + i)
    *(buf + total) = 0
    *out_len = total
    return buf

# Prepend one captured argument to the (possibly null) list of those after it.
pub fn link_generic_arg(first: *GenericArg, rest: *GenericArg) -> *GenericArg
    first.next = rest
    return first

# Mangled spelling of one argument: the primitive's name, or the captured
# struct/generic/pointer name.  The one speller for generic type annotations,
# struct literals and generic-call suffixes.  Returns its length and stores
# the bytes' address in *out.
fn generic_arg_spelling(ga: *GenericArg, out: **u8) -> i32
    if ga.ty == TYPE_STRUCT or ga.ty == TYPE_PTR or ga.ty == TYPE_PTR_PTR or ga.ty == TYPE_ARRAY or ga.ty == TYPE_VOID
        *out = ga.name
        return ga.name_len
    return primitive_arg_spelling(ga.ty, out)

# Mangle `base<a1, a2, ...>` as "base$a1$a2..." (AGAST #1574), from the
# captured argument list.  Returns an arena-allocated, NUL-terminated name
# and its length in *out_len.
fn mangle_generic_args(p: *Parser, base_name: *u8, base_len: i32, ga: *GenericArg, out_len: *i32) -> *u8
    var total: i32 = base_len
    var spell: *u8 = null
    var cur: *GenericArg = ga
    while cur != null
        total = total + 1 + generic_arg_spelling(cur, @spell)
        cur = cur.next
    let mangled: *u8 = parser_alloc(p, (total + 1) as i64)
    var pos: i32 = 0
    for i in 0..base_len
        *(mangled + pos) = *(base_name + i)
        pos = pos + 1
    cur = ga
    while cur != null
        *(mangled + pos) = 36  # '$'
        pos = pos + 1
        let n: i32 = generic_arg_spelling(cur, @spell)
        for j in 0..n
            *(mangled + pos) = *(spell + j)
            pos = pos + 1
        cur = cur.next
    *(mangled + pos) = 0
    *out_len = pos
    return mangled

# Mangle a generic type like Result<Vec<u8>, StrView> → Result$Vec$u8$StrView
# from the arguments captured by capture_first_generic_arg.  Returns
# TYPE_STRUCT with the name in p.last_type_name, like type_generic.
pub fn type_generic_with_saved(p: *Parser, base_name: *u8, base_len: i32, ga: *GenericArg) -> i32
    var len: i32 = 0
    p.last_type_name = mangle_generic_args(p, base_name, base_len, ga, @len)
    p.last_type_name_len = len
    return TYPE_STRUCT

# The slice type `[T]` (AGAST #1614): sugar for `Span<T>` (LANGUAGE_SPEC §3.4),
# as ritz0's make_slice_type desugars it.  `elem` is T, captured by
# first_generic_type_arg as for `Span<T>`, so `[u8]` is TYPE_STRUCT "Span$u8":
# the same type, so either one fits wherever the other does.
pub fn type_slice(p: *Parser, elem: *GenericArg) -> i32
    return type_generic_with_saved(p, c"Span", 4, elem)

# =============================================================================
# Statement helpers
# =============================================================================

# AGAST #2028: `let name ... = init` -- a stmt_var_decl whose binding is
# immutable.  let_check.ritz enforces it.
# AGAST #2407: record where statement `s`'s name is (binder_check.ritz).
# The grammar wraps each binding statement's action in this.
pub fn stmt_named(s: *Stmt, line: i32, col: i32) -> *Stmt
    s.name_span.line = line
    s.name_span.col = col
    return s

# The second name of `let (x, y) = ..` (AGAST #2407).
pub fn stmt_named2(s: *Stmt, line: i32, col: i32) -> *Stmt
    s.name2_span.line = line
    s.name2_span.col = col
    return s

pub fn stmt_let_decl(p: *Parser, name: *u8, len: i32, ty: i32, init: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = stmt_var_decl(p, name, len, ty, init, line, col)
    s.var_is_let = 1
    return s

pub fn stmt_var_decl(p: *Parser, name: *u8, len: i32, ty: i32, init: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_VAR_DECL
    s.var_is_let = 0
    s.name_span.line = 0   # AGAST #2407: stmt_named sets it
    s.name_span.col = 0
    # AGAST #2822: this decl's latches, not a nested typed `let`'s.
    if ty != 0
        pop_var_latch(p, line, col)
    # AGAST #1671: typed decls go through capture_var_type, which latched
    # var_fn_sig (null unless the type is a fn type).  Untyped ones have none.
    # On a `[N]fn(..)` array it is the element signature (AGAST #1747).
    s.var_fn_sig = null
    if ty == TYPE_PTR or ty == TYPE_ARRAY
        s.var_fn_sig = p.var_fn_sig
    s.span.line = line
    s.span.col = col
    s.var_name = name as *u8
    s.var_name_len = len
    # AGAST #1364: keep the written annotation for the narrowing check.
    s.var_declared_type = ty
    s.var_src_file = null
    if ty == TYPE_I8 or ty == TYPE_U8 or ty == TYPE_I16 or ty == TYPE_U16 or ty == TYPE_I32 or ty == TYPE_U32
        s.var_src_file = parse_file_copy_shared(p)
    # Default to i64 for type inference (when ty == 0 aka TYPE_VOID)
    if ty == 0
        s.var_type = TYPE_I64
        # AGAST #1521: `let b = x > 1` is a bool, as in ritz0. emit_var_decl
        # stores a bool in the same i64 slot, so the IR does not change; it
        # only lets print interpolation print `b` as true/false.
        if init != null
            if init.kind == EXPR_BINARY and init.op >= OP_EQ and init.op <= OP_OR
                s.var_type = TYPE_BOOL
            else if init.kind == EXPR_UNARY and init.op == OP_NOT
                s.var_type = TYPE_BOOL
    else
        s.var_type = ty
    # Copy struct type name from parser state
    # For TYPE_STRUCT: the variable itself is a struct
    # For TYPE_PTR with pointee TYPE_STRUCT: it's a pointer to a struct
    # Use var_type_name if available (set by capture_var_type before parsing initializer)
    # This prevents the type name from being clobbered by generic calls in the initializer
    if ty == TYPE_STRUCT
        if p.var_type_name != null
            s.var_type_name = p.var_type_name as *u8
            s.var_type_name_len = p.var_type_name_len
        else
            s.var_type_name = p.last_type_name as *u8
            s.var_type_name_len = p.last_type_name_len
    else if ty == TYPE_PTR and p.var_pointee == TYPE_STRUCT and p.var_type_name != null
        # AGAST #2822: `*S`, latched by capture_var_type (every typed decl
        # goes through it) before a `<*B>` in the initializer re-set it.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else if (ty == TYPE_REF or ty == TYPE_MUT_REF) and p.var_type_name != null
        # AGAST #1754: reference to struct, latched by capture_var_type.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else if ty == TYPE_PTR_PTR and p.var_type_name != null
        # AGAST #1933: `**S` local, latched by capture_var_type.
        s.var_type_name = p.var_type_name as *u8
        s.var_type_name_len = p.var_type_name_len
    else
        s.var_type_name = null
        s.var_type_name_len = 0
    # Copy array info from parser state if this is an array type
    s.var_array_shape = null
    # AGAST #2822: latched by capture_var_type (every typed decl goes through
    # it) before a `<[M]U>` in the initializer re-set last_array_*.
    let arr: *ArrayElem = g_var_array
    s.var_array_elem_pointee = TYPE_VOID
    if ty == TYPE_ARRAY and arr != null
        s.var_array_size = g_var_array_size
        s.var_array_elem_type = arr.elem
        s.var_array_shape = arr.shape  # AGAST #1509
        s.var_array_elem_pointee = arr.pointee
        # For arrays of structs, store the struct name in var_type_name
        # so the emitter can allocate with correct element size
        if arr.elem == TYPE_STRUCT
            s.var_type_name = arr.name
            s.var_type_name_len = arr.name_len
        else if (arr.elem == TYPE_PTR or arr.elem == TYPE_PTR_PTR) and arr.name_len > 0
            # AGAST #184: [N]*Foo arrays — propagate the inner pointee
            # struct name so emit_member_ptr can resolve `arr[i].field`.
            s.var_type_name = arr.name
            s.var_type_name_len = arr.name_len
    else
        s.var_array_size = 0
        s.var_array_elem_type = 0
    # Copy pointee type from parser state if this is a pointer type
    # AGAST #2805: latched by capture_var_type for a typed decl with an
    # initializer, as the inner pointee slot below is.
    if (ty == TYPE_PTR or ty == TYPE_PTR_PTR) and init != null
        s.var_pointee_type = p.var_pointee
    else if ty == TYPE_PTR or ty == TYPE_PTR_PTR
        s.var_pointee_type = p.last_pointee_type
    else if (ty == TYPE_REF or ty == TYPE_MUT_REF) and s.var_type_name_len > 0
        s.var_pointee_type = TYPE_STRUCT  # AGAST #1754, as param_new
    else
        s.var_pointee_type = TYPE_I64  # Default
    # AGAST #2805: a typed decl with an initializer went through
    # capture_var_type, which latched the slot before the initializer was
    # parsed.  Without one (`var x: **S`) the parser state is still current.
    if init != null and ty != 0
        s.var_inner_pointee_type = p.var_inner_pointee
    else
        s.var_inner_pointee_type = ptr_ptr_inner_pointee(p, ty)
    # AGAST #2822: a `*[N]T`'s pointee array, latched by capture_var_type.
    s.var_pointee_array_size = 0
    s.var_pointee_array_elem_type = TYPE_VOID
    s.var_pointee_array_elem_pointee = TYPE_VOID
    if ty != 0
        s.var_pointee_array_size = g_var_ptr_array_size
        s.var_pointee_array_elem_type = g_var_ptr_array_elem
        s.var_pointee_array_elem_pointee = g_var_ptr_array_elem_pointee
    s.var_ref = null
    if (ty == TYPE_REF or ty == TYPE_MUT_REF) and g_var_ref != null
        s.var_ref = g_var_ref
        stmt_take_var_ref(s)
    s.var_init = init
    s.next = null
    return s

# AGAST #2308: what `s.var_ref` records is what a `@T` local is registered with.
# Without the referent a `let p: @&i8` read and stored 8 bytes through `*p`,
# where the same type on a param stored one.
pub fn stmt_take_var_ref(s: *Stmt)
    let r: *Param = s.var_ref
    s.var_type_name = r.param_type_name
    s.var_type_name_len = r.param_type_name_len
    s.var_pointee_type = r.param_pointee_type
    s.var_pointee_array_size = r.param_pointee_array_size
    s.var_pointee_array_elem_type = r.param_pointee_array_elem_type
    s.var_pointee_array_elem_pointee = r.param_pointee_array_elem_pointee

pub fn stmt_return(p: *Parser, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_RETURN
    s.span.line = line
    s.span.col = col
    s.return_value = val
    s.next = null
    return s

pub fn stmt_break(p: *Parser, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_BREAK
    s.span.line = line
    s.span.col = col
    s.next = null
    return s

# `defer <stmt>` / `defer` + block (AGAST #1625): `body` (null for a bare
# `defer`) goes in while_body; see STMT_DEFER.
pub fn stmt_defer(p: *Parser, body: *Stmt, is_block: i32, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_DEFER
    s.span.line = line
    s.span.col = col
    s.while_cond = null
    s.while_body = body
    s.defer_is_block = is_block
    s.next = null
    return s

pub fn stmt_continue(p: *Parser, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_CONTINUE
    s.span.line = line
    s.span.col = col
    s.next = null
    return s

pub fn stmt_if(p: *Parser, cond: *Expr, then_body: *Stmt, else_body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_IF
    s.span.line = line
    s.span.col = col
    s.if_cond = cond
    s.if_then = then_body
    s.if_else = else_body
    s.next = null
    return s

# `assert <cond>[, "message"]` — a runtime check that exits 1 on a falsy
# cond.  Condition lives in if_cond (slot reused from STMT_IF); the message
# (null / 0 if none) in assert_msg.  emit_assert_stmt (emitter_print.ritz)
# lowers it (AGAST #1869).
pub fn stmt_assert(p: *Parser, cond: *Expr, msg: *u8, msg_len: i32, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_ASSERT
    s.span.line = line
    s.span.col = col
    s.if_cond = cond
    s.assert_msg = msg
    s.assert_msg_len = msg_len
    s.next = null
    return s

# `let (x, y) = expr` — 2-field destructure.  First binding name lives in
# var_name (reuse), second in assign_target (reuse).  Init expr in
# var_init.  Emitter (see STMT_TUPLE_DECL handler) emits the init as a
# struct value, alloca two i64 slots, extractvalue fields 0/1 with
# appropriate widening to i64, and registers both names as locals.
pub fn stmt_tuple_decl(p: *Parser, name1: *u8, len1: i32, name2: *u8, len2: i32, init: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_TUPLE_DECL
    s.name_span.line = 0   # AGAST #2407: stmt_named and stmt_named2 set them
    s.name_span.col = 0
    s.name2_span.line = 0
    s.name2_span.col = 0
    s.span.line = line
    s.span.col = col
    s.var_name = name1 as *u8
    s.var_name_len = len1
    s.assign_target = name2 as *u8
    s.assign_target_len = len2
    s.var_init = init
    s.next = null
    return s

pub fn stmt_while(p: *Parser, cond: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_WHILE
    s.span.line = line
    s.span.col = col
    s.while_cond = cond
    s.while_body = body
    s.next = null
    return s

pub fn stmt_for(p: *Parser, var_name: *u8, var_len: i32, start: *Expr, end: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_FOR
    s.name_span.line = 0   # AGAST #2407: stmt_named sets it
    s.name_span.col = 0
    s.span.line = line
    s.span.col = col
    s.for_var = var_name
    s.for_var_len = var_len
    s.for_start = start
    s.for_end = end
    s.for_body = body
    s.for_inclusive = 0
    s.next = null
    return s

# for_stmt : FOR IDENT IN expr DOTDOTEQ expr block  (AGAST #1530)
# Same STMT_FOR as `start..end`; emit_stmt lowers the bound as `<=`.
pub fn stmt_for_inclusive(p: *Parser, var_name: *u8, var_len: i32, start: *Expr, end: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = stmt_for(p, var_name, var_len, start, end, body, line, col)
    s.for_inclusive = 1
    return s

# Infinite loop: loop { body } - use break to exit
# Reuses while_body field for the loop body (no condition needed)
pub fn stmt_loop(p: *Parser, body: *Stmt, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_LOOP
    s.span.line = line
    s.span.col = col
    s.while_cond = null  # No condition for infinite loop
    s.while_body = body
    s.next = null
    return s

pub fn stmt_assign_name(p: *Parser, name: *u8, len: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_ASSIGN
    s.span.line = line
    s.span.col = col
    s.assign_target = name as *u8
    s.assign_target_len = len
    s.assign_value = val
    s.next = null
    return s

pub fn stmt_assign_index(p: *Parser, name: *u8, len: i32, idx: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_INDEX_ASSIGN
    s.span.line = line
    s.span.col = col
    s.assign_target = name as *u8
    s.assign_target_len = len
    s.assign_value = val
    # Store index expression in while_cond (reuse, like STMT_MEMBER_INDEX_ASSIGN)
    s.while_cond = idx
    s.next = null
    return s

pub fn stmt_assign_deref(p: *Parser, target: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store target expression in assign_value's place, we need to reinterpret
    # For now, use target directly - emitter needs to handle EXPR_UNARY(DEREF) case
    s.assign_target = null
    s.assign_target_len = 0
    s.assign_value = val
    # AGAST #1304: store the target WRAPPED in EXPR_UNARY/OP_DEREF.
    #
    # This used to stash the bare deref OPERAND, which made `*b.p = v`
    # indistinguishable from `b.p = v` — both produced STMT_ASSIGN with
    # assign_target_len == 0 and an EXPR_MEMBER in if_cond.  emit_assign
    # checks EXPR_MEMBER first, so every `*expr.field = value` compiled to
    # a plain field store: it overwrote the POINTER instead of writing
    # through it.  That is what corrupted IoUring.sq_tail in
    # uring_sqe_submit (`*ring.sq_tail = tail + 1`) and segfaulted the
    # async_net / echo_server examples.
    #
    # Keeping the `*` in the AST matches ritz0, whose emitter likewise
    # tests UnaryOp('*') before Field.
    s.if_cond = expr_unary(p, OP_DEREF, target, line, col)
    s.next = null
    return s

# Member assignment through pointer: ptr.field = value
pub fn stmt_assign_member(p: *Parser, ptr_expr: *Expr, field: *u8, field_len: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_MEMBER_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store pointer expression in if_cond
    s.if_cond = ptr_expr
    # Store field name in assign_target
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Indexed member assignment through pointer: ptr.field[index] = value
pub fn stmt_assign_member_index(p: *Parser, ptr_expr: *Expr, field: *u8, field_len: i32, idx: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_MEMBER_INDEX_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store pointer expression in if_cond
    s.if_cond = ptr_expr
    # Store field name in assign_target
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    # Store index expression in while_cond (reuse)
    s.while_cond = idx
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# General expression assignment: expr = value
# This handles nested member access like r.origin.x = 10
pub fn stmt_assign_expr(p: *Parser, target: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store target expression in if_cond (reuse)
    s.if_cond = target
    # Signal this is an expression assignment by setting assign_target_len = 0
    s.assign_target = null
    s.assign_target_len = 0
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Local struct field assignment: var.field = value
pub fn stmt_assign_local_field(p: *Parser, var_name: *u8, var_len: i32, field: *u8, field_len: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_LOCAL_FIELD_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store variable name in var_name/var_name_len
    s.var_name = var_name as *u8
    s.var_name_len = var_len
    # Store field name in assign_target/assign_target_len
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Local struct field array assignment: var.field[index] = value
pub fn stmt_assign_local_field_index(p: *Parser, var_name: *u8, var_len: i32, field: *u8, field_len: i32, idx: *Expr, val: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_LOCAL_FIELD_INDEX_ASSIGN
    s.span.line = line
    s.span.col = col
    # Store variable name in var_name/var_name_len
    s.var_name = var_name as *u8
    s.var_name_len = var_len
    # Store field name in assign_target/assign_target_len
    s.assign_target = field as *u8
    s.assign_target_len = field_len
    # Store index expression in while_cond (reuse)
    s.while_cond = idx
    # Store value in assign_value
    s.assign_value = val
    s.next = null
    return s

# Desugar compound assignment: `name op= val` -> `name = name op val`
# op should be OP_ADD, OP_SUB, OP_MUL, OP_DIV
pub fn stmt_compound_assign(p: *Parser, name: *u8, len: i32, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create identifier expression for the variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = EXPR_IDENT
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = name
    ident.ident_len = len
    ident.next = null
    # Create binary expression: name op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = ident
    binary.right = val
    binary.next = null
    # Create assignment statement: name = (name op val)
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_ASSIGN
    s.span.line = line
    s.span.col = col
    s.assign_target = name
    s.assign_target_len = len
    s.assign_value = binary
    s.next = null
    return s

# Compound assignment for array index: arr[idx] op= val -> arr[idx] = arr[idx] op val
pub fn stmt_compound_assign_index(p: *Parser, name: *u8, len: i32, idx: *Expr, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create identifier expression for array
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = EXPR_IDENT
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = name
    ident.ident_len = len
    ident.next = null
    # Create index expression for reading: arr[idx]
    let read_idx: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    read_idx.kind = EXPR_INDEX
    read_idx.span.line = line
    read_idx.span.col = col
    read_idx.bracket.line = 0
    read_idx.left = ident
    read_idx.right = idx
    read_idx.next = null
    # Create binary expression: arr[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = read_idx
    binary.right = val
    binary.next = null
    # Create index assignment: arr[idx] = (arr[idx] op val)
    return stmt_assign_index(p, name, len, idx, binary, line, col)

# Compound assignment for dereference: *ptr op= val -> *ptr = *ptr op val
pub fn stmt_compound_assign_deref(p: *Parser, target: *Expr, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create deref expression for reading: *ptr
    let read_deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    read_deref.kind = EXPR_UNARY
    read_deref.span.line = line
    read_deref.span.col = col
    read_deref.op = OP_DEREF
    read_deref.operand = target
    read_deref.next = null
    # Create binary expression: *ptr op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = read_deref
    binary.right = val
    binary.next = null
    # Create deref assignment: *ptr = (*ptr op val)
    return stmt_assign_deref(p, target, binary, line, col)

# Compound assignment for member: (*ptr).field op= val
pub fn stmt_compound_assign_member(p: *Parser, ptr_expr: *Expr, field: *u8, field_len: i32, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create deref expression: *ptr
    let deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    deref.kind = EXPR_UNARY
    deref.span.line = line
    deref.span.col = col
    deref.op = OP_DEREF
    deref.operand = ptr_expr
    deref.next = null
    # Create member access expression: (*ptr).field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = EXPR_MEMBER
    member.span.line = line
    member.span.col = col
    member.left = deref
    member.ident_ptr = field
    member.ident_len = field_len
    member.next = null
    # Create binary expression: (*ptr).field op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = member
    binary.right = val
    binary.next = null
    # Create member assignment
    return stmt_assign_member(p, ptr_expr, field, field_len, binary, line, col)

# Compound assignment for indexed member: (*ptr).field[idx] op= val
pub fn stmt_compound_assign_member_index(p: *Parser, ptr_expr: *Expr, field: *u8, field_len: i32, idx: *Expr, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create deref expression: *ptr
    let deref: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    deref.kind = EXPR_UNARY
    deref.span.line = line
    deref.span.col = col
    deref.op = OP_DEREF
    deref.operand = ptr_expr
    deref.next = null
    # Create member access expression: (*ptr).field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = EXPR_MEMBER
    member.span.line = line
    member.span.col = col
    member.left = deref
    member.ident_ptr = field
    member.ident_len = field_len
    member.next = null
    # Create index expression: (*ptr).field[idx]
    let indexed: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    indexed.kind = EXPR_INDEX
    indexed.span.line = line
    indexed.span.col = col
    indexed.bracket.line = 0
    indexed.left = member
    indexed.right = idx
    indexed.next = null
    # Create binary expression: (*ptr).field[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = indexed
    binary.right = val
    binary.next = null
    # Create member index assignment
    return stmt_assign_member_index(p, ptr_expr, field, field_len, idx, binary, line, col)

# Compound assignment for local field: var.field op= val
pub fn stmt_compound_assign_local_field(p: *Parser, var_name: *u8, var_len: i32, field: *u8, field_len: i32, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create identifier for variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = EXPR_IDENT
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = var_name
    ident.ident_len = var_len
    ident.next = null
    # Create member access: var.field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = EXPR_MEMBER
    member.span.line = line
    member.span.col = col
    member.left = ident
    member.ident_ptr = field
    member.ident_len = field_len
    member.next = null
    # Create binary: var.field op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = member
    binary.right = val
    binary.next = null
    # Create local field assignment
    return stmt_assign_local_field(p, var_name, var_len, field, field_len, binary, line, col)

# Compound assignment for local field index: var.field[idx] op= val
pub fn stmt_compound_assign_local_field_index(p: *Parser, var_name: *u8, var_len: i32, field: *u8, field_len: i32, idx: *Expr, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create identifier for variable
    let ident: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    ident.kind = EXPR_IDENT
    ident.span.line = line
    ident.span.col = col
    ident.ident_ptr = var_name
    ident.ident_len = var_len
    ident.next = null
    # Create member access: var.field
    let member: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    member.kind = EXPR_MEMBER
    member.span.line = line
    member.span.col = col
    member.left = ident
    member.ident_ptr = field
    member.ident_len = field_len
    member.next = null
    # Create index expression: var.field[idx]
    let indexed: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    indexed.kind = EXPR_INDEX
    indexed.span.line = line
    indexed.span.col = col
    indexed.bracket.line = 0
    indexed.left = member
    indexed.right = idx
    indexed.next = null
    # Create binary: var.field[idx] op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = indexed
    binary.right = val
    binary.next = null
    # Create local field index assignment
    return stmt_assign_local_field_index(p, var_name, var_len, field, field_len, idx, binary, line, col)

# Compound assignment for general expression: expr op= val
pub fn stmt_compound_assign_expr(p: *Parser, target: *Expr, op: i32, val: *Expr, line: i32, col: i32) -> *Stmt
    # Create binary: target op val
    let binary: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    binary.kind = EXPR_BINARY
    binary.span.line = line
    binary.span.col = col
    binary.op = op
    binary.left = target
    binary.right = val
    binary.next = null
    # Create expression assignment
    return stmt_assign_expr(p, target, binary, line, col)

# Helper to convert compound assignment token to binary operator
pub fn compound_tok_to_op(tok: i32) -> i32
    if tok == TOK_PLUS_EQ
        return OP_ADD
    if tok == TOK_MINUS_EQ
        return OP_SUB
    if tok == TOK_STAR_EQ
        return OP_MUL
    if tok == TOK_SLASH_EQ
        return OP_DIV
    return 0

# Helper to check if token is a compound assignment operator
pub fn is_compound_assign_tok(tok: i32) -> i32
    if tok == TOK_PLUS_EQ
        return 1
    if tok == TOK_MINUS_EQ
        return 1
    if tok == TOK_STAR_EQ
        return 1
    if tok == TOK_SLASH_EQ
        return 1
    return 0

pub fn stmt_expr(p: *Parser, e: *Expr, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_EXPR
    s.span.line = line
    s.span.col = col
    s.expr = e
    s.next = null
    return s

pub fn stmt_link(first: *Stmt, rest: *Stmt) -> *Stmt
    first.next = rest
    return first

# =============================================================================
# Expression helpers
# =============================================================================

pub fn expr_int(p: *Parser, val: i64, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_INT_LIT
    e.span.line = line
    e.span.col = col
    e.int_val = val
    e.lit_kind = LIT_PLAIN
    e.next = null
    return e

# `true` is the integer 1 to everything but tail_value.ritz, which needs it to
# judge `while true` (AGAST #2236), and bool_check.ritz.
pub fn expr_true(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 1, line, col)
    e.lit_kind = LIT_TRUE
    return e

# `false` is the integer 0 to everything but bool_check.ritz (AGAST #2342).
pub fn expr_false(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_FALSE
    return e

# `pass` in expression position is the integer 0 to everything but
# tail_value.ritz, where it is the absence of a value (AGAST #2236).
pub fn expr_pass(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_PASS
    return e

# `()` in expression position (AGAST #2272): integer 0 marked LIT_UNIT, as
# `pass` is.  A variant ctor stores no payload for it (`Ok(())`), so the 0
# never reaches a unit payload's zero bytes.
pub fn expr_unit(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = expr_int(p, 0, line, col)
    e.lit_kind = LIT_UNIT
    return e

# Is `e` the unit value `()`?
pub fn is_unit_expr(e: *Expr) -> i32
    if e == null
        return 0
    (e.kind == EXPR_INT_LIT and e.lit_kind == LIT_UNIT) as i32

# Float literal — store the raw source bytes (digits + dot) in
# string_ptr/string_len so the emitter can re-parse to the right LLVM
# constant.  Default kind context (f32 vs f64) is decided by surrounding
# type info at use-site; the literal itself just carries the digits.
pub fn expr_float(p: *Parser, src: *u8, len: i32, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_FLOAT_LIT
    e.span.line = line
    e.span.col = col
    e.string_ptr = src as *u8
    e.string_len = len
    e.next = null
    # AGAST #1615: a `f32` / `f64` suffix (absorbed by the lexer) types the
    # literal: `2.5f32` is `2.5 as f32`, as in ritz0. The digits keep their
    # own slot so the emitter never sees the suffix.
    if len > 3 and *(src + len - 3) == 102  # 'f'
        let s1: u8 = *(src + len - 2)
        let s2: u8 = *(src + len - 1)
        var sfx: i32 = TYPE_VOID
        if s1 == 51 and s2 == 50  # "32"
            sfx = TYPE_F32
        else if s1 == 54 and s2 == 52  # "64"
            sfx = TYPE_F64
        if sfx != TYPE_VOID
            e.string_len = len - 3
            let c: *Expr = expr_cast(p, e, sfx)
            c.cast_pointee = TYPE_VOID
            return c
    return e

pub fn expr_string(p: *Parser, tok: Token) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    # Distinguish c"..." / "..." based on lexer token kind. Kept in separate
    # AST nodes so the emitter types each one correctly:
    #   c"..."  (TOK_CSTRING)  -> *u8  (null-terminated)
    #   "..."   (TOK_STRING)   -> StrView { ptr, len }   (AGAST #98)
    # (s"..." / TOK_SSTRING was removed in AGAST #98.)
    if tok.kind == TOK_CSTRING
        e.kind = EXPR_CSTRING_LIT
    else
        e.kind = EXPR_STRING_LIT
    e.span.line = tok.line
    e.span.col = tok.col
    # Use cooked string from lexer (escapes already processed)
    e.string_ptr = tok.string_val as *u8
    e.string_len = tok.string_len
    # AGAST #1521: also keep the RAW token text, quotes included. print's
    # interpolation splits the raw text, because the cooked text cannot tell
    # `\{x}` (a literal brace) from `{x}` (a placeholder). See
    # emitter_print.ritz. Nothing else reads these slots on a string literal.
    e.ident_ptr = tok.start
    e.ident_len = tok.len
    e.next = null
    return e

pub fn expr_char(p: *Parser, tok: Token) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_CHAR_LIT
    e.span.line = tok.line
    e.span.col = tok.col
    # Character value: either raw char or escaped
    # Token format: 'x' or '\n' etc.
    let src: *u8 = tok.start
    var c: i64 = 0
    if tok.len == 3
        # Simple char: 'x'
        c = *(src + 1) as i64
    else if tok.len == 4
        # Escaped char: '\n', '\t', '\\', '\'' ...  The lexer already rejected
        # an unknown escape (AGAST #1978), so the shared table always cooks.
        let esc: i32 = (*(src + 2)) as i32
        c = lexer_cook_escape(esc, 1) as i64
    e.int_val = c
    e.next = null
    return e

pub fn expr_nil(p: *Parser, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_NIL_LIT
    e.span.line = line
    e.span.col = col
    e.int_val = 0
    e.next = null
    return e

pub fn expr_ident(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_IDENT
    e.span.line = line
    e.span.col = col
    e.ident_ptr = name as *u8
    e.ident_len = len
    e.next = null
    return e

pub fn expr_binary(p: *Parser, op: i32, left: *Expr, right: *Expr) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_BINARY
    # Inherit span from left operand
    e.span.line = left.span.line
    e.span.col = left.span.col
    e.op = op
    e.left = left
    e.right = right
    e.next = null
    return e

pub fn expr_unary(p: *Parser, op: i32, operand: *Expr, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_UNARY
    e.span.line = line
    e.span.col = col
    e.op = op
    e.operand = operand
    e.next = null
    return e

pub fn expr_cast(p: *Parser, left: *Expr, target_type: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_CAST
    e.span = left.span
    e.left = left
    e.op = target_type
    e.cast_pointee = p.last_pointee_type
    e.cast_array = null
    e.fn_sig = null
    e.int_val = TYPE_VOID
    e.ident_ptr = null
    e.ident_len = 0
    e.next = null
    return e

# EXPR_TYPE_OPERAND (AGAST #2124): `count` values of leaf kind `t` (struct
# `name` when t == TYPE_STRUCT).
pub fn expr_type_operand(p: *Parser, count: i64, t: i32, name: *u8, name_len: i32, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_TYPE_OPERAND
    e.span.line = line
    e.span.col = col
    e.int_val = count
    e.op = t
    e.ident_ptr = null
    e.ident_len = 0
    if t == TYPE_STRUCT
        e.ident_ptr = name
        e.ident_len = name_len
    e.next = null
    return e

# `sizeof([N]..T)` (AGAST #2124): an array type is no expression, so the
# grammar reads `IDENT ( [N] type_spec )` here.  Any callee but `sizeof`
# rejects (p.error) — `f([8]u8)` is not a program.  type_array runs for the
# outer dimension, so p.last_array_* / last_array_shape describe the whole
# type, exactly as for a declaration.
pub fn sizeof_array_type_call(p: *Parser, name_tok: Token, num_tok: Token, elem_type: i32) -> *Expr
    if name_tok.len != 6 or memcmp(name_tok.start, c"sizeof", 6) != 0
        p.error = 1
        return null
    type_array(p, num_tok.start, num_tok.len, elem_type)
    var count: i64 = p.last_array_size as i64
    var leaf: i32 = p.last_array_elem_type
    var leaf_name: *u8 = p.last_array_elem_type_name
    var leaf_len: i32 = p.last_array_elem_type_name_len
    let sh: *ArrayShape = p.last_array_shape
    if sh != null
        count = 1
        var d: i32 = 0
        while d < sh.rank
            count = count * (sh.dims[d] as i64)
            d = d + 1
        leaf = sh.leaf_type
        leaf_name = sh.leaf_name
        leaf_len = sh.leaf_name_len
    let arg: *Expr = expr_type_operand(p, count, leaf, leaf_name, leaf_len, num_tok.line, num_tok.col)
    return expr_call(p, name_tok.start, name_tok.len, arg, name_tok.line, name_tok.col)

pub fn expr_call(p: *Parser, name: *u8, len: i32, args: *Expr, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_CALL
    e.span.line = line
    e.span.col = col
    e.func_name = name as *u8
    e.func_name_len = len
    e.args = args
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.next = null
    return e

# Generic function call: name<type>(args) -> mangled_name(args)
# Mangles the function name like type_generic does for types
pub fn expr_generic_call(p: *Parser, name: *u8, len: i32, type_arg: i32, args: *Expr, line: i32, col: i32) -> *Expr
    # Build mangled name: name$type (e.g., vec_new$u8)
    var mangled: *u8 = parser_alloc(p, 64) as *u8
    var pos: i32 = 0

    # Copy function name
    for i in 0..len
        *(mangled + pos) = *(name + i)
        pos = pos + 1

    # Add "$" separator
    *(mangled + pos) = 36  # '$'
    pos = pos + 1

    # Add type argument name based on type
    if type_arg == TYPE_U8
        *(mangled + pos) = 117  # 'u'
        pos = pos + 1
        *(mangled + pos) = 56   # '8'
        pos = pos + 1
    else if type_arg == TYPE_I8
        *(mangled + pos) = 105  # 'i'
        pos = pos + 1
        *(mangled + pos) = 56   # '8'
        pos = pos + 1
    else if type_arg == TYPE_I32
        *(mangled + pos) = 105  # 'i'
        pos = pos + 1
        *(mangled + pos) = 51   # '3'
        pos = pos + 1
        *(mangled + pos) = 50   # '2'
        pos = pos + 1
    else if type_arg == TYPE_I64
        *(mangled + pos) = 105  # 'i'
        pos = pos + 1
        *(mangled + pos) = 54   # '6'
        pos = pos + 1
        *(mangled + pos) = 52   # '4'
        pos = pos + 1
    else if type_arg == TYPE_STRUCT
        # Generic type or struct - use the last_type_name
        for i in 0..p.last_type_name_len
            *(mangled + pos) = *(p.last_type_name + i)
            pos = pos + 1

    # Create call expression with mangled name
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_CALL
    e.span.line = line
    e.span.col = col
    e.func_name = mangled
    e.func_name_len = pos
    e.args = args
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.next = null
    return e

pub fn expr_link(first: *Expr, rest: *Expr) -> *Expr
    first.next = rest
    return first

# Array literal: [e1, e2, ...]
# Stores the linked element list in `args` (parse_args already returns one).
# This kind is currently parser-only — emit_expr falls through to its
# unknown-kind branch. For const arrays this is harmless because the emitter
# inlines const values via find_const, never re-walking the original Expr.
pub fn expr_array(p: *Parser, head: *Expr, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_ARRAY_LIT
    e.span.line = line
    e.span.col = col
    e.args = head
    e.int_val = 0
    e.next = null
    return e

# Array fill literal: `[value; N]` — repeated initializer (AGAST #178).
# Stores the value expression in `left`; the count is extracted from the
# count token directly (the grammar matches NUMBER, not a generic expr, to
# keep parity with ritz0 and avoid having to constant-fold here).
pub fn expr_array_fill(p: *Parser, value: *Expr, count_start: *u8, count_len: i32, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_ARRAY_FILL
    e.span.line = line
    e.span.col = col
    e.left = value
    e.int_val = parse_int(count_start, count_len)
    e.next = null
    return e

# =============================================================================
# Binary operation chain helpers (for left-factored grammar)
# =============================================================================

pub fn binary_op_new(p: *Parser, op: i32, right: *Expr, next: *BinaryOp) -> *BinaryOp
    let b: *BinaryOp = parser_alloc(p, 24) as *BinaryOp
    b.op = op
    b.right = right
    b.next = next
    return b

# Apply binary operation chain with parser for allocations
pub fn apply_binary_opt_p(p: *Parser, left: *Expr, chain: *BinaryOp) -> *Expr
    if chain == null
        return left

    var result: *Expr = left
    var op: *BinaryOp = chain
    while op != null
        result = expr_binary(p, op.op, result, op.right)
        op = op.next
    return result

# =============================================================================
# Cast tail helpers (for cast expression parsing)
# =============================================================================

pub fn cast_tail_new(p: *Parser, ty: i32, next: *CastTail) -> *CastTail
    let ct: *CastTail = parser_alloc(p, sizeof(CastTail)) as *CastTail
    ct.cast_type = ty
    ct.next = next
    # AGAST #2120: `as EfiFn` keeps the signature (with the alias's
    # [[callconv]]).  Same outermost-only rule as the pointee below: only
    # then is the fn type the last thing parsed.
    ct.fn_sig = null
    if next == null and ty == TYPE_PTR
        ct.fn_sig = fresh_fn_sig(p)
    ct.array = null
    if next == null and ty == TYPE_ARRAY
        ct.array = array_elem_of_last(p)
    ct.pointee_type = TYPE_VOID
    ct.pointee_name = null
    ct.pointee_name_len = 0
    # AGAST #1453: record the pointee of `as *T`.  parse_cast_tail parses
    # this tail's type, THEN the rest of the chain, THEN calls us, so the
    # parser's last_* state belongs to this tail's type only when it is the
    # last in the chain (next == null).  That is the outermost cast — the
    # one whose type a `let x = ... as *T` takes.  Earlier tails stay
    # unknown rather than pick up a later type's name.
    if next == null and ty == TYPE_PTR
        ct.pointee_type = p.last_pointee_type
        # last_type_name is stale for a primitive pointee (`*u8`); only a
        # struct pointee names itself (same rule as stmt_var_decl).
        if p.last_pointee_type == TYPE_STRUCT
            ct.pointee_name = p.last_type_name as *u8
            ct.pointee_name_len = p.last_type_name_len
    return ct

pub fn apply_cast_tail(p: *Parser, expr: *Expr, tail: *CastTail) -> *Expr
    if tail == null
        return expr
    var result: *Expr = expr
    var ct: *CastTail = tail
    while ct != null
        result = expr_cast(p, result, ct.cast_type)
        result.int_val = ct.pointee_type as i64
        result.ident_ptr = ct.pointee_name
        result.ident_len = ct.pointee_name_len
        result.fn_sig = ct.fn_sig
        result.cast_array = ct.array
        ct = ct.next
    return result

# =============================================================================
# Postfix operation helpers
# =============================================================================

pub fn postfix_call(p: *Parser, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # Copy type suffix from parser state (set by p_skip_generic_args for generic calls)
    op.call_type_suffix = p.last_call_type_suffix
    op.call_type_suffix_len = p.last_call_type_suffix_len
    op.next = null
    return op

# Generic function call - creates a call with type suffix from the type token
# The type_tok is the token for the type name (e.g., "u8", "String", etc.)
# Builds a suffix like "$u8" to be appended to the function name
pub fn postfix_generic_call(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # Type suffix: "$" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    op.call_type_suffix = generic_tok_suffix(p, null, 0, type_tok, @len)
    op.call_type_suffix_len = len
    op.next = null
    return op

# Pointer-typed generic call (AGAST #186): `option_is_none<*Page>(@p)` builds
# a mangled suffix of `$ptr_Page` matching ritz0's name mangling so cross-
# module symbols line up.  Without this rule the parser silently dropped the
# enclosing fn definition (parse_item's anchor-skip recovery), and downstream
# the call fell through to `call i64 @<name>(...)` while the surrounding
# `ret %Option$` kept the struct type — clang IR verifier then rejected the
# i64-into-struct mismatch (mausoleum/concurrent_bench, btree_scan path).
pub fn postfix_generic_call_ptr(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # Type suffix: "$ptr_" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    op.call_type_suffix = generic_tok_suffix(p, c"ptr_", 4, type_tok, @len)
    op.call_type_suffix_len = len
    op.next = null
    return op

# Generic call whose type argument is a full type_spec rather than a single
# token — `vec_new<Vec<i64>>()` (AGAST #1300).  Suffix is "$" + the argument's
# mangled name ("$Vec$i64"), or its primitive spelling for a primitive.
pub fn postfix_generic_call_arg(p: *Parser, ga: *GenericArg, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # "" + "$" + arg → "$<arg>", from the same speller as type annotations.
    var len: i32 = 0
    op.call_type_suffix = mangle_generic_args(p, null, 0, ga, @len)
    op.call_type_suffix_len = len
    op.next = null
    return op

# Is this captured type argument spelled like a VALUE — a bare lowercase
# identifier such as `b` in `f(a < b, c > (d))`?  Types are primitive
# keywords (lexed as their own tokens, never TYPE_STRUCT), PascalCase names,
# or lowercase primitives that lex as IDENT (usize/isize; f32/f64 already
# come back as TYPE_F32/TYPE_F64).  A generic instantiation's captured name
# contains '$' and is a type whatever its case.
fn generic_arg_is_value_like(ga: *GenericArg) -> i32
    if ga.ty != TYPE_STRUCT or ga.name == null or ga.name_len <= 0
        return 0
    let c0: u8 = *ga.name
    if c0 != 95 and (c0 < 97 or c0 > 122)  # not '_' and not 'a'..'z'
        return 0
    for i in 0..ga.name_len
        if *(ga.name + i) == 36  # '$'
            return 0
    if ga.name_len == 5 and *(ga.name + 1) == 115 and *(ga.name + 2) == 105 and *(ga.name + 3) == 122 and *(ga.name + 4) == 101
        if c0 == 117 or c0 == 105  # "usize" / "isize"
            return 0
    return 1

# Generic call with a full type-argument list (AGAST #1612): `second<i64,
# i32>(a, b)` → suffix "$i64$i32", the same per-argument mangling as generic
# struct types (#1574) and ritz0's fn instantiation names.
#
# `f(a < b, c > (d))` produces the same token stream.  A single-argument list
# is always a call (unchanged since #1300).  A list of two or more is a call
# unless an argument is value-like (generic_arg_is_value_like); then this
# action fails — p.error = 1 makes postfix_ops backtrack to before the `<`,
# which then parses as a comparison.  ritz0 differs here: it takes any list
# followed by `(` as type arguments (test_ritz1_multi_arg_generic_call.py).
pub fn postfix_generic_call_list(p: *Parser, ga: *GenericArg, args: *Expr) -> *PostfixOp
    if ga.next == null
        return postfix_generic_call_arg(p, ga, args)
    var cur: *GenericArg = ga
    while cur != null
        if generic_arg_is_value_like(cur) == 1
            p.error = 1
            return null
        cur = cur.next
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    var len: i32 = 0
    op.call_type_suffix = mangle_generic_args(p, null, 0, ga, @len)
    op.call_type_suffix_len = len
    op.next = null
    return op

pub fn postfix_index(p: *Parser, index: *Expr, line: i32, col: i32) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_INDEX
    op.index = index
    op.bracket.line = line
    op.bracket.col = col
    op.next = null
    return op

pub fn postfix_member(p: *Parser, name: *u8, len: i32) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_MEMBER
    op.member_name = name as *u8
    op.member_len = len
    op.next = null
    return op

pub fn postfix_cast(p: *Parser, ty: i32) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CAST
    op.cast_type = ty
    op.next = null
    return op

pub fn postfix_link(first: *PostfixOp, rest: *PostfixOp) -> *PostfixOp
    first.next = rest
    return first

# Old apply_postfix kept for reference - use apply_postfix_p instead
pub fn apply_postfix(base: *Expr, ops: *PostfixOp) -> *Expr
    return base

# Apply postfix operations with parser for allocation
pub fn apply_postfix_p(p: *Parser, base: *Expr, ops: *PostfixOp) -> *Expr
    if ops == null
        return base

    # Apply each postfix operation, creating new expression nodes
    var result: *Expr = base
    var op: *PostfixOp = ops
    while op != null
        if op.kind == POSTFIX_CALL
            # Create call expression
            if result.kind == EXPR_IDENT
                # Modify ident to call in place (ident becomes call target)
                result.kind = EXPR_CALL
                result.func_name = result.ident_ptr
                result.func_name_len = result.ident_len
                # Copy type suffix for generic calls (e.g., "$u8" for vec_new<u8>())
                result.call_type_suffix = op.call_type_suffix
                result.call_type_suffix_len = op.call_type_suffix_len
                result.args = op.args
            else if result.kind == EXPR_MEMBER
                # Method call: expr.method(args)
                # EXPR_MEMBER has: left = receiver, ident_ptr/len = method name
                # Convert to EXPR_METHOD by changing kind and adding args
                result.kind = EXPR_METHOD
                result.args = op.args
                # left and ident_ptr/ident_len are already set from POSTFIX_MEMBER
            else
                # AGAST #1747: a call through any other callee (`fs[1](3)`,
                # `f(1)(2)`) is an indirect call: EXPR_CALL with no name,
                # the callee expression in `left`.  This arm used to drop
                # the call, so `fs[1](3)` evaluated to the fn pointer.
                result = expr_nameless_call(p, result, op.args)
        else if op.kind == POSTFIX_INDEX
            # Create new index expression
            let index_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            index_expr.kind = EXPR_INDEX
            index_expr.span = result.span
            index_expr.bracket = op.bracket
            index_expr.left = result
            index_expr.right = op.index
            index_expr.next = null
            result = index_expr
        else if op.kind == POSTFIX_MEMBER
            # Create new member expression
            let member_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            member_expr.kind = EXPR_MEMBER
            member_expr.span = result.span
            member_expr.left = result
            member_expr.ident_ptr = op.member_name
            member_expr.ident_len = op.member_len
            member_expr.next = null
            result = member_expr
        else if op.kind == POSTFIX_CAST
            # Create new cast expression
            let cast_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            cast_expr.kind = EXPR_CAST
            cast_expr.fn_sig = null
            cast_expr.cast_array = null
            cast_expr.span = result.span
            cast_expr.left = result
            cast_expr.op = op.cast_type
            cast_expr.next = null
            result = cast_expr
        else if op.kind == POSTFIX_TRY
            # Try operator `expr?` — wrap running result in EXPR_TRY.
            # emit_expr_try propagates Err/None via early return. (AGAST #134)
            let try_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
            try_expr.kind = EXPR_TRY
            try_expr.span = result.span
            try_expr.left = result
            try_expr.next = null
            result = try_expr
        op = op.next
    return result

# A call through a callee expression (AGAST #1747): EXPR_CALL with no name
# and the callee in `left`; emit_call evaluates it to the fn's address.
fn expr_nameless_call(p: *Parser, callee: *Expr, args: *Expr) -> *Expr
    let call_expr: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    call_expr.kind = EXPR_CALL
    call_expr.span = callee.span
    call_expr.func_name = null
    call_expr.func_name_len = 0
    call_expr.call_type_suffix = null
    call_expr.call_type_suffix_len = 0
    call_expr.args = args
    call_expr.left = callee
    call_expr.right = null
    call_expr.operand = null
    call_expr.ident_ptr = null
    call_expr.ident_len = 0
    call_expr.next = null
    return call_expr

# apply_postfix_p for a parenthesised primary `(e)`.  AGAST #2120: `(t.f)(..)`
# calls the fn pointer stored in field f, as in ritz0; only the unparenthesised
# `t.f(..)` is a method call.  Without the parens to tell them apart, the
# call became `Tbl_f(t, ..)`, an undefined symbol.
pub fn apply_postfix_paren_p(p: *Parser, base: *Expr, ops: *PostfixOp) -> *Expr
    if ops != null and ops.kind == POSTFIX_CALL and base.kind == EXPR_MEMBER and ops.call_type_suffix_len == 0
        return apply_postfix_p(p, expr_nameless_call(p, base, ops.args), ops.next)
    return apply_postfix_p(p, base, ops)

# =============================================================================
# Struct literal helpers
# =============================================================================

pub fn field_init_new(p: *Parser, name: *u8, len: i32, val: *Expr) -> *FieldInit
    let f: *FieldInit = parser_alloc(p, 32) as *FieldInit
    f.name = name as *u8
    f.name_len = len
    f.value = val
    f.next = null
    return f

pub fn field_init_link(first: *FieldInit, rest: *FieldInit) -> *FieldInit
    first.next = rest
    return first

pub fn ident_or_struct(p: *Parser, tok: Token, lit: *StructLit) -> *Expr
    if lit == null
        # Just an identifier
        return expr_ident(p, tok.start, tok.len, tok.line, tok.col)
    else
        # Struct literal
        let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
        e.kind = EXPR_STRUCT_LIT
        e.span.line = tok.line
        e.span.col = tok.col
        e.ident_ptr = tok.start as *u8
        e.ident_len = tok.len
        # Store field inits in args field (reuse)
        e.args = lit as *Expr
        e.next = null
        return e

# Generic struct literal parsed through generic_args (AGAST #1300):
# `Pair<i64, Vec<i64>> { ... }`.  Mangles on every argument (AGAST #1574),
# from the capture records: parsing the literal's fields clobbers
# p.last_type_name.
pub fn generic_struct_lit_arg(p: *Parser, tok: Token, ga: *GenericArg, lit: *StructLit) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_STRUCT_LIT
    e.span.line = tok.line
    e.span.col = tok.col
    var len: i32 = 0
    e.ident_ptr = mangle_generic_args(p, tok.start, tok.len, ga, @len)
    e.ident_len = len
    # Store field inits in args field (reuse)
    e.args = lit as *Expr
    e.next = null
    return e

# =============================================================================
# Numeric parsing
# =============================================================================

pub fn parse_int(start: *u8, len: i32) -> i64
    # Check for hex prefix (0x or 0X)
    if len >= 3 and *start == 48  # '0'
        let prefix: i32 = *(start + 1) as i32
        if prefix == 120 or prefix == 88  # 'x' or 'X'
            return parse_hex(start + 2, len - 2)
        if prefix == 98 or prefix == 66   # 'b' or 'B'
            return parse_binary(start + 2, len - 2)
    # Decimal parsing.  Stops on the first non-digit so typed-int literal
    # suffixes (`42i32`, `100u16`, etc.) are naturally ignored — caller
    # used to have to pre-trim via int_lit_len; that's no longer required.
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        if ch < 48 or ch > 57  # not '0'-'9'
            return val
        val = val * 10 + (ch - 48) as i64
    return val

pub fn parse_hex(start: *u8, len: i32) -> i64
    # Stops on the first non-hex-digit so a `42u8` style suffix on a hex
    # literal (`0xFFi32`) doesn't leak into the value.
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        var digit: i64 = -1
        if ch >= 48 and ch <= 57       # '0'-'9'
            digit = (ch - 48) as i64
        else if ch >= 65 and ch <= 70  # 'A'-'F'
            digit = (ch - 55) as i64
        else if ch >= 97 and ch <= 102 # 'a'-'f'
            digit = (ch - 87) as i64
        if digit < 0
            return val
        val = val * 16 + digit
    return val

pub fn parse_binary(start: *u8, len: i32) -> i64
    # Stops on the first non-bit-digit (typed-int suffix tolerance).
    var val: i64 = 0
    for i in 0..len
        let ch: i32 = *(start + i) as i32
        if ch == 49        # '1'
            val = val * 2 + 1
        else if ch == 48   # '0'
            val = val * 2
        else
            return val
    return val

# =============================================================================
# Match / pattern helpers
# =============================================================================

# Allocate a new MatchArm with int-literal pattern. Caller fills body + is_pass.
pub fn match_arm_int(p: *Parser, val: i64) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_INT_LIT
    a.pattern_int = val
    a.pattern_name = null
    a.pattern_name_len = 0
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    return a

# Allocate a new MatchArm with wildcard pattern (_). Caller fills body + is_pass.
pub fn match_arm_wildcard(p: *Parser) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_WILDCARD
    a.pattern_int = 0
    a.pattern_name = null
    a.pattern_name_len = 0
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    return a

# Allocate a new MatchArm with identifier binding OR unit-variant (e.g. x, None).
pub fn match_arm_ident(p: *Parser, name: *u8, name_len: i32) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_IDENT
    a.pattern_int = 0
    a.pattern_name = name
    a.pattern_name_len = name_len
    a.pattern_inner_kind = 0
    a.pattern_inner_name = null
    a.pattern_inner_name_len = 0
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    return a

# Allocate a new MatchArm with variant pattern Name(inner).
# inner_kind is PAT_WILDCARD or PAT_IDENT.
pub fn match_arm_variant(p: *Parser, name: *u8, name_len: i32, inner_kind: i32, inner_name: *u8, inner_name_len: i32) -> *MatchArm
    let a: *MatchArm = parser_alloc(p, sizeof(MatchArm)) as *MatchArm
    a.pattern_kind = PAT_VARIANT
    a.pattern_int = 0
    a.pattern_name = name
    a.pattern_name_len = name_len
    a.pattern_inner_kind = inner_kind
    a.pattern_inner_name = inner_name
    a.pattern_inner_name_len = inner_name_len
    a.body = null
    a.is_pass = 0
    a.body_stmts = null
    a.next = null
    a.pass_span.line = 0
    a.pass_span.col = 0
    a.pattern_span.line = 0
    a.pattern_span.col = 0
    return a

# Set arm body (optionally marks is_pass when body_expr is null).
pub fn match_arm_set_body(arm: *MatchArm, body: *Expr, is_pass: i32)
    arm.body = body
    arm.is_pass = is_pass

# Link arms into a linked list (first.next = rest, returns first).
pub fn match_arm_link(first: *MatchArm, rest: *MatchArm) -> *MatchArm
    if first == null
        return rest
    first.next = rest
    return first

# Create STMT_MATCH: scrutinee stored in if_cond, arms stored in if_then (recast).
pub fn stmt_match(p: *Parser, scrutinee: *Expr, arms: *MatchArm, line: i32, col: i32) -> *Stmt
    let s: *Stmt = parser_alloc(p, sizeof(Stmt)) as *Stmt
    s.kind = STMT_MATCH
    s.span.line = line
    s.span.col = col
    s.if_cond = scrutinee
    s.if_then = arms as *Stmt  # Reinterpret arm list as Stmt* slot (never dereferenced as Stmt)
    s.if_else = null
    s.next = null
    return s

# Create EXPR_MATCH: scrutinee stored in left, arms stored in args (recast).
pub fn expr_match(p: *Parser, scrutinee: *Expr, arms: *MatchArm, line: i32, col: i32) -> *Expr
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_MATCH
    e.span.line = line
    e.span.col = col
    e.left = scrutinee
    e.args = arms as *Expr  # Reinterpret arm list as Expr* slot
    e.next = null
    return e

# Create EXPR_IF (AGAST #1613): `if cond` + then block + `else` + else block,
# used as a value.  Each block becomes a wildcard MatchArm whose value is the
# block's trailing bare expression (match_arm_set_block), so emit_if_expr,
# monomorph and narrowing read the arms exactly as they read EXPR_MATCH arms.
# `args` holds the then-arm; its `next` is the else-arm.
pub fn expr_if(p: *Parser, cond: *Expr, then_body: *Stmt, else_body: *Stmt, line: i32, col: i32) -> *Expr
    let then_arm: *MatchArm = if_arm_from_block(p, then_body)
    let else_arm: *MatchArm = if_arm_from_block(p, else_body)
    then_arm.next = else_arm
    let e: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    e.kind = EXPR_IF
    e.span.line = line
    e.span.col = col
    e.left = cond
    e.args = then_arm as *Expr  # Reinterpret arm list as Expr* slot
    e.next = null
    return e

# Create EXPR_IF for the inline form `if cond then a else b` (AGAST #1753).
# Each arm expression becomes a one-statement block (a bare expression
# statement), which is exactly the block form's shape for `if c` NEWLINE
# INDENT a DEDENT, so expr_if / if_arm_from_block build the same node.
pub fn expr_if_inline(p: *Parser, cond: *Expr, then_val: *Expr, else_val: *Expr, line: i32, col: i32) -> *Expr
    let then_body: *Stmt = stmt_expr(p, then_val, then_val.span.line, then_val.span.col)
    let else_body: *Stmt = stmt_expr(p, else_val, else_val.span.line, else_val.span.col)
    return expr_if(p, cond, then_body, else_body, line, col)

# A block ending in an `if`/`else` or a `match` STATEMENT takes its value: the
# grammar parses a nested `if` (and an `else if` chain, whose else block is a
# single if_stmt) as STMT_IF and a nested `match` as STMT_MATCH, so the last
# one is rewritten here into a trailing EXPR_IF / EXPR_MATCH expression
# statement, which match_arm_set_block then detaches as the value.  An
# else-less trailing `if` is left alone: it has no value.  Returns the head.
#
# AGAST #2429: match arms skipped this, so `Some(v) =>` + a block ending in
# `match v` / `if`..`else` yielded 0, silently.  The rewritten tail is an
# expression arm like `=> match v`, so a valueless one (void-call arms) is the
# located error #2046 gives that form when the outer value is wanted.
fn block_tail_as_value(p: *Parser, stmts: *Stmt) -> *Stmt
    var head: *Stmt = stmts
    var prev: *Stmt = null
    var last: *Stmt = stmts
    while last != null and last.next != null
        prev = last
        last = last.next
    var inner: *Expr = null
    if last != null and last.kind == STMT_IF and last.if_else != null
        inner = expr_if(p, last.if_cond, last.if_then, last.if_else, last.span.line, last.span.col)
    else if last != null and last.kind == STMT_MATCH
        inner = expr_match(p, last.if_cond, last.if_then as *MatchArm, last.span.line, last.span.col)
    if inner != null
        let st: *Stmt = stmt_expr(p, inner, last.span.line, last.span.col)
        if prev == null
            head = st
        else
            prev.next = st
    return head

# One arm of an EXPR_IF: a wildcard arm whose value is the block's tail.
fn if_arm_from_block(p: *Parser, stmts: *Stmt) -> *MatchArm
    return match_arm_set_block(match_arm_wildcard(p), block_tail_as_value(p, stmts))

# A block-bodied match arm (`Some(v) =>` + indented statements, #1454): its
# value is the block's tail, a trailing match or if/else included (#2429).
pub fn match_arm_set_block_tail(p: *Parser, arm: *MatchArm, stmts: *Stmt) -> *MatchArm
    return match_arm_set_block(arm, block_tail_as_value(p, stmts))

# =============================================================================
# Wave 5F.2 — wrappers called from the canonical grammar (ritz1.grammar)
# =============================================================================
# These wrap the lower-level helpers above with the names / shapes the
# grammar productions reference.  Kept thin so generator output stays a
# direct translation of the grammar.

# pattern : NUMBER  →  PAT_INT_LIT.  Token text comes raw from the lexer; we
# parse it into an i64 here so the action stays a single function call.
pub fn pattern_lit_int(p: *Parser, start: *u8, len: i32) -> *MatchArm
    return match_arm_int(p, parse_int(start, len))

# pattern : TRUE | FALSE  →  PAT_BOOL.  A PAT_INT_LIT of 1 or 0 would not do:
# a bool match must be covered by `true` and `false`, not by the integers they
# lower to, and neither may stand on an integer scrutinee (AGAST #2344).
pub fn pattern_bool(p: *Parser, val: i64, line: i32, col: i32) -> *MatchArm
    let a: *MatchArm = match_arm_int(p, val)
    a.pattern_kind = PAT_BOOL
    a.bool_span.line = line
    a.bool_span.col = col
    return a

# pattern : IDENT  →  PAT_WILDCARD if `_`, else PAT_IDENT.
pub fn pattern_ident_or_wildcard(p: *Parser, name: *u8, name_len: i32) -> *MatchArm
    if name_len == 1
        if *name == 95  # '_'
            return match_arm_wildcard(p)
    return match_arm_ident(p, name, name_len)

# pattern : IDENT, with where it is: a bare name binds unless the match finds
# it tests, and a binding can't take a module value's name (AGAST #2407).
pub fn pattern_ident_at(p: *Parser, name: *u8, name_len: i32, line: i32, col: i32) -> *MatchArm
    let a: *MatchArm = pattern_ident_or_wildcard(p, name, name_len)
    if a.pattern_kind == PAT_IDENT
        a.pattern_span.line = line
        a.pattern_span.col = col
    return a

# Where an arm's pattern begins, kept for the error when the scrutinee's enum
# declares no variant of that name (AGAST #2431).  Returns arm.
pub fn pattern_head_at(arm: *MatchArm, line: i32, col: i32) -> *MatchArm
    arm.head_span.line = line
    arm.head_span.col = col
    return arm

# pattern : IDENT '(' IDENT ')'  →  PAT_VARIANT with inner = wildcard or bind.
# Inner ident `_` becomes a wildcard payload; any other ident is a binding, and
# binder_check.ritz refuses one named like a const, global or variant (#2407).
pub fn pattern_variant_inner(p: *Parser, name: *u8, name_len: i32, inner: *u8, inner_len: i32, line: i32, col: i32) -> *MatchArm
    if inner_len == 1
        if *inner == 95  # '_'
            return match_arm_variant(p, name, name_len, PAT_WILDCARD, null, 0)
    let a: *MatchArm = match_arm_variant(p, name, name_len, PAT_IDENT, inner, inner_len)
    a.pattern_inner_span.line = line
    a.pattern_inner_span.col = col
    return a

# match_arm action: arm_body returns an expr_pass for the `pass` keyword, the
# expression otherwise.  A `pass` sets is_pass=1 with no body, and keeps only
# its position (AGAST #2236); otherwise store the body expr.  Returns arm.
pub fn match_arm_set_body_or_pass(arm: *MatchArm, body: *Expr) -> *MatchArm
    if body.kind == EXPR_INT_LIT and body.lit_kind == LIT_PASS
        match_arm_set_body(arm, null as *Expr, 1)
        arm.pass_span.line = body.span.line
        arm.pass_span.col = body.span.col
    else
        match_arm_set_body(arm, body, 0)
    return arm

# match_arm action for a statement-bodied arm (AGAST #1454 / #1617):
#   `None =>` NEWLINE INDENT stmts DEDENT     (block arm)
#   `5 => r = 5`                              (assignment arm, one stmt)
# Like an `if` branch or a fn body, the block's value is its trailing bare
# expression.  That expression is detached from the statement list into
# arm.body, so emit_match_arm_body, narrowing and monomorph keep reading the
# arm's value from `body` exactly as for an expression arm; the remaining
# statements go to arm.body_stmts and are emitted first.  A block that does
# not end in a bare expression yields no value and is marked is_pass, the
# same default (`i64 0`) a `pass` arm contributes.
pub fn match_arm_set_block(arm: *MatchArm, stmts: *Stmt) -> *MatchArm
    var prev: *Stmt = null
    var last: *Stmt = stmts
    while last != null and last.next != null
        prev = last
        last = last.next
    if last != null and last.kind == STMT_EXPR and last.expr != null
        arm.body = last.expr
        arm.is_pass = 0
        if prev == null
            arm.body_stmts = null
        else
            prev.next = null
            arm.body_stmts = stmts
    else
        arm.body = null
        arm.is_pass = 1
        arm.body_stmts = stmts
    return arm

# postfix_op : '?'  →  POSTFIX_TRY.  apply_postfix_p wraps the running
# postfix result in an EXPR_TRY node when it sees this op (AGAST #134).
pub fn postfix_try_new(p: *Parser) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_TRY
    op.next = null
    return op

# postfix_op : '[' expr '..' expr ']'  →  POSTFIX_INDEX wrapping an
# EXPR_RANGE { lo, hi }.  emit_expr_index lowers the range to a slice
# (AGAST #110).
pub fn postfix_range_index(p: *Parser, lo: *Expr, hi: *Expr) -> *PostfixOp
    let r: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    r.kind = EXPR_RANGE
    r.span = lo.span
    r.left = lo
    r.right = hi
    r.next = null
    return postfix_index(p, r, 0, 0)   # a slice's errors name the base

# postfix_op : '[' expr '..=' expr ']'  →  `[lo..hi + 1]`, as ritz0 lowers it
# (_emit_index).  ritz1 had no inclusive slice, so `v[1..=2]` didn't parse
# (AGAST #2451).
pub fn postfix_range_index_inclusive(p: *Parser, lo: *Expr, hi: *Expr) -> *PostfixOp
    let one: *Expr = expr_int(p, 1, hi.span.line, hi.span.col)
    return postfix_range_index(p, lo, expr_binary(p, OP_ADD, hi, one))

# for_stmt : FOR IDENT IN expr block  →  STMT_FOR with iter expression
# stored in for_end (start = null sentinel).  emit_for handles the
# Vec/Span/Range iteration shapes (ritz-task-84 — for-iterables).
pub fn stmt_for_iter(p: *Parser, name: *u8, name_len: i32, iter: *Expr, body: *Stmt, line: i32, col: i32) -> *Stmt
    # The iterable form stores the iterable in for_start with for_end=null;
    # emit_for_iterable dispatches on for_end==null vs the range form's
    # for_end!=null.  Swapping these (start=null, end=iter) produced the
    # `store i64 %.0, ptr %.4` undefined-value crash because the range
    # path's emit_expr(for_start=null) never wrote to %.0.
    return stmt_for(p, name, name_len, iter, null as *Expr, body, line, col)

# enum_def : ENUM ... { skip-and-return-zero }
# ritz1's AST has no enum node yet — variant constructors resolve via
# call-site special-casing in the emitter (Some/Ok/None/Err) plus the
# unit-tag fallback layout.  This action just signals "syntactically
# valid, nothing to add to module".
pub fn enum_def_skip(p: *Parser) -> i32
    return 0

# enum_def's action: as enum_def_skip, latching `pub` for the enum just
# parsed (its generated `from` is `pub` iff it is, LANGUAGE_SPEC §10.4).
pub fn enum_def_end(p: *Parser, is_pub: i32) -> i32
    if g_enum_count > 0
        *(g_enum_pub + g_enum_count - 1) = is_pub
    return 0

# ============================================================================
# Enum variant tracker (for qualified enum-variant lookup at codegen)
# ============================================================================
# When the parser sees `enum Shade ... Light ... Dark`, ritz1 doesn't build
# a real enum AST node — but downstream code references like `Shade.Light`
# still need to resolve to the variant's tag value (0 for Light, 1 for Dark).
#
# Track each enum's variants in parallel arrays:
#   g_enum_names      → enum type names (e.g., "Shade")
#   g_enum_variant_starts → index into g_enum_variant_names where this enum's
#                           variants begin
#   g_enum_variant_count  → how many variants this enum has
#   g_enum_variant_names → flattened list of variant names across all enums
#
# Lookup: enum_variant_index(enum_name, variant_name) returns index or -1.

# Initial capacities; both tables grow by doubling (AGAST #1813).  They used
# to be hard limits: the 33rd enum was never registered and its variants were
# appended to the 32nd, with exit 0.
const ENUM_INIT_CAP: i32 = 32
const ENUM_VARIANT_INIT_CAP: i32 = 256

var g_enum_names: **u8 = null
var g_enum_name_lens: *i32 = null
var g_enum_variant_starts: *i32 = null
var g_enum_variant_counts: *i32 = null
var g_enum_count: i32 = 0

var g_enum_variant_names: **u8 = null
var g_enum_variant_name_lens: *i32 = null
var g_enum_variant_total: i32 = 0

# AGAST #1797: what each variant carries, so the emitter can give the enum
# ritz0's payload layout instead of a bare `{ i8 }` tag.
#   g_enum_generic[e]          1 for `enum Name<T>` (its payload types are
#                              unsubstituted; Option/Result have their own
#                              layout path, emitter_core tagged_enum_layout)
#   g_enum_variant_fields[v]   payload fields in declaration order, null for
#                              a unit variant
#   g_enum_variant_kinds[v]    ENUM_VARIANT_UNIT / _TUPLE / _STRUCT
pub const ENUM_VARIANT_UNIT: i32 = 0
pub const ENUM_VARIANT_TUPLE: i32 = 1
pub const ENUM_VARIANT_STRUCT: i32 = 2

var g_enum_generic: *i32 = null
var g_enum_variant_fields: **StructField = null
var g_enum_variant_kinds: *i32 = null

# AGAST #1880, LANGUAGE_SPEC §10.4:
#   g_enum_repr[e]            the representation type (TYPE_U64, ...), 0 for
#                             none
#   g_enum_pub[e] / _line[e]  `pub enum`; the line of its name (where the
#                             generated `from` source starts)
#   g_enum_variant_discr[v]   the discriminant's bits: an explicit `= N`, else
#                             the previous one + 1, the first 0
#   g_enum_variant_neg[v]     1 when the discriminant's value is negative
#                             (else the bits read as a u64)
var g_enum_repr: *i32 = null
var g_enum_pub: *i32 = null
var g_enum_line: *i32 = null
var g_enum_variant_discr: *i64 = null
var g_enum_variant_neg: *i32 = null

var g_enum_initialized: i32 = 0
var g_enum_cap: i32 = 0
var g_enum_variant_cap: i32 = 0

fn init_enum_tracker()
    if g_enum_initialized == 1
        return
    g_enum_cap = ENUM_INIT_CAP
    g_enum_variant_cap = ENUM_VARIANT_INIT_CAP
    g_enum_names = malloc((g_enum_cap as i64) * 8) as **u8
    g_enum_name_lens = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_variant_starts = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_variant_counts = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_variant_names = malloc((g_enum_variant_cap as i64) * 8) as **u8
    g_enum_variant_name_lens = malloc((g_enum_variant_cap as i64) * 4) as *i32
    g_enum_generic = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_variant_fields = malloc((g_enum_variant_cap as i64) * 8) as **StructField
    g_enum_variant_kinds = malloc((g_enum_variant_cap as i64) * 4) as *i32
    g_enum_repr = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_pub = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_line = malloc((g_enum_cap as i64) * 4) as *i32
    g_enum_variant_discr = malloc((g_enum_variant_cap as i64) * 8) as *i64
    g_enum_variant_neg = malloc((g_enum_variant_cap as i64) * 4) as *i32
    g_enum_initialized = 1
    g_enum_count = 0
    g_enum_variant_total = 0

# Forget every recorded enum.  The driver's alias re-parse (AGAST #1475)
# parses every module a second time; without this each enum would be
# recorded twice.
pub fn enum_tracker_reset()
    g_enum_count = 0
    g_enum_variant_total = 0

fn enum_def_start_impl(name: *u8, len: i32, generic: i32) -> i32
    return enum_def_start_full(name, len, generic, 0, 0)

fn enum_def_start_full(name: *u8, len: i32, generic: i32, repr: i32, line: i32) -> i32
    init_enum_tracker()
    if g_enum_count >= g_enum_cap
        let cap: i64 = (g_enum_cap as i64) * 2
        g_enum_names = realloc(g_enum_names as *u8, cap * 8) as **u8
        g_enum_name_lens = realloc(g_enum_name_lens as *u8, cap * 4) as *i32
        g_enum_variant_starts = realloc(g_enum_variant_starts as *u8, cap * 4) as *i32
        g_enum_variant_counts = realloc(g_enum_variant_counts as *u8, cap * 4) as *i32
        g_enum_generic = realloc(g_enum_generic as *u8, cap * 4) as *i32
        g_enum_repr = realloc(g_enum_repr as *u8, cap * 4) as *i32
        g_enum_pub = realloc(g_enum_pub as *u8, cap * 4) as *i32
        g_enum_line = realloc(g_enum_line as *u8, cap * 4) as *i32
        g_enum_cap = cap as i32
    *(g_enum_names + g_enum_count) = name
    *(g_enum_name_lens + g_enum_count) = len
    *(g_enum_variant_starts + g_enum_count) = g_enum_variant_total
    *(g_enum_variant_counts + g_enum_count) = 0
    *(g_enum_generic + g_enum_count) = generic
    *(g_enum_repr + g_enum_count) = repr
    *(g_enum_pub + g_enum_count) = 0
    *(g_enum_line + g_enum_count) = line
    g_enum_count = g_enum_count + 1
    return 0

# Called from grammar rule enum_def_header: starts a new enum-tracking entry.
pub fn enum_def_start(p: *Parser, name: *u8, len: i32) -> i32
    return enum_def_start_impl(name, len, 0)

# `enum Name<T>`: as enum_def_start, flagged generic (AGAST #1797).
pub fn enum_def_start_generic(p: *Parser, name: *u8, len: i32) -> i32
    return enum_def_start_impl(name, len, 1)

# `enum E: T` (LANGUAGE_SPEC §10.4): as enum_def_start, with representation
# type T, which must be an integer type (a located error otherwise).
pub fn enum_def_start_repr(p: *Parser, name: *u8, len: i32, repr: i32, line: i32, col: i32) -> i32
    var r: i32 = repr
    if is_int_const_type(repr) == 0 or repr == TYPE_BOOL
        if p.skip_item == 0
            enum_error_at(line, col)
            eprints_cstr(c"representation type of enum '")
            eprint_lexeme(name, len)
            eprintln_cstr(c"' must be an integer type")
            g_attr_errors = g_attr_errors + 1
        r = TYPE_I64
    return enum_def_start_full(name, len, 0, r, line)

# Called from grammar rule enum_variant: appends a unit variant to the most
# recent enum's variant list.
pub fn enum_variant_record(p: *Parser, name: *u8, len: i32, line: i32, col: i32) -> i32
    return enum_variant_record_impl(p, name, len, ENUM_VARIANT_UNIT, null, 0, 0, 0, line, col)

# `Name(T)` (AGAST #1797): the payload type is the type_spec just parsed;
# field_new captures its struct / pointer / array detail from the parser
# state exactly as for a struct field.
pub fn enum_variant_record_tuple(p: *Parser, name: *u8, len: i32, ty: i32, line: i32, col: i32) -> i32
    let f: *StructField = field_new(p, name, len, ty, 0, 0)
    f.next = null
    nd_payload_reject(f, line, col)
    return enum_variant_record_impl(p, name, len, ENUM_VARIANT_TUPLE, f, 0, 0, 0, line, col)

# AGAST #2097: field_new now keeps an N-D field's shape, but an enum
# payload binding (`A(g) => g[i][j]`) has no N-D lowering: it was bound as
# one i64 and indexed as a byte pointer.  Keep #1509's located error there
# (ritz0 cannot index such a binding either).
fn nd_payload_reject(fields: *StructField, line: i32, col: i32)
    var f: *StructField = fields
    while f != null
        if f.array_shape != null
            nd_array_report(line, col, c"an enum variant payload")
            return
        f = f.next

# `Name` + an indented field block (AGAST #1797): the fields are the payload.
pub fn enum_variant_record_struct(p: *Parser, name: *u8, len: i32, fields: *StructField, line: i32, col: i32) -> i32
    nd_payload_reject(fields, line, col)
    return enum_variant_record_impl(p, name, len, ENUM_VARIANT_STRUCT, fields, 0, 0, 0, line, col)

# `Name = N` / `Name = -N` (LANGUAGE_SPEC §10.4): a unit variant with an
# explicit discriminant.
pub fn enum_variant_record_discr(p: *Parser, name: *u8, len: i32, num: *u8, num_len: i32, neg: i32, line: i32, col: i32) -> i32
    var bits: i64 = parse_int(num, num_len)
    var is_neg: i32 = 0
    if neg == 1 and bits != 0
        bits = 0 - bits
        is_neg = 1
    return enum_variant_record_impl(p, name, len, ENUM_VARIANT_UNIT, null, 1, bits, is_neg, line, col)

# `error: <file>:<line>:<col>: ` -- a parse-time enum diagnostic's prefix.
fn enum_error_at(line: i32, col: i32)
    eprints_cstr(c"error: ")
    if g_parse_file != null
        eprints_cstr(g_parse_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": ")

# A discriminant's value: negative bits when `neg`, else the bits as a u64.
fn eprint_discr(bits: i64, neg: i32)
    if neg == 1 or bits >= 0
        eprint_i64(bits)
        return
    # >= 2^63: print the u64 (bits / 10 as an unsigned shift-divide).
    let hi: i64 = ((bits >> 1) & 0x7FFFFFFFFFFFFFFF) / 5
    let lo: i64 = bits - hi * 10
    eprint_i64(hi)
    eprint_i64(lo)

# Does (bits, neg) fit representation type `ty`?
fn discr_fits(ty: i32, bits: i64, neg: i32) -> i32
    if ty == TYPE_U64
        return 1 - neg
    if neg == 0 and bits < 0
        return 0   # >= 2^63: only a u64 holds it
    var lo: i64 = 0
    var hi: i64 = 0
    if ty == TYPE_U8
        hi = 255
    else if ty == TYPE_U16
        hi = 65535
    else if ty == TYPE_U32
        hi = 4294967295
    else if ty == TYPE_I8
        lo = -128
        hi = 127
    else if ty == TYPE_I16
        lo = -32768
        hi = 32767
    else if ty == TYPE_I32
        lo = -2147483648
        hi = 2147483647
    else
        return 1   # i64: every value of a 64-bit literal
    if bits < lo or bits > hi
        return 0
    return 1

# The checks of LANGUAGE_SPEC §10.4 on the variant just recorded (index `v`
# of the current enum `ei`), each a located error at the variant's name.
# ritz0 enforces the same rules with the same text (parser.py,
# _check_discriminants).
fn enum_variant_check(p: *Parser, ei: i32, v: i32, kind: i32, explicit: i32, line: i32, col: i32)
    if p.skip_item != 0
        return
    let repr: i32 = *(g_enum_repr + ei)
    let ename: *u8 = *(g_enum_names + ei)
    let elen: i32 = *(g_enum_name_lens + ei)
    let vname: *u8 = *(g_enum_variant_names + v)
    let vlen: i32 = *(g_enum_variant_name_lens + v)
    if repr != 0 and kind != ENUM_VARIANT_UNIT
        enum_error_at(line, col)
        eprints_cstr(c"variant '")
        eprint_lexeme(vname, vlen)
        eprints_cstr(c"' of enum '")
        eprint_lexeme(ename, elen)
        eprintln_cstr(c"' carries data, so the enum cannot have a representation type")
        g_attr_errors = g_attr_errors + 1
        return
    if repr == 0
        if explicit == 1
            enum_error_at(line, col)
            eprints_cstr(c"discriminant of variant '")
            eprint_lexeme(vname, vlen)
            eprints_cstr(c"' needs a representation type: write 'enum ")
            eprint_lexeme(ename, elen)
            eprintln_cstr(c": <integer type>'")
            g_attr_errors = g_attr_errors + 1
        return
    let bits: i64 = *(g_enum_variant_discr + v)
    let neg: i32 = *(g_enum_variant_neg + v)
    if discr_fits(repr, bits, neg) == 0
        enum_error_at(line, col)
        eprints_cstr(c"discriminant ")
        eprint_discr(bits, neg)
        eprints_cstr(c" of variant '")
        eprint_lexeme(vname, vlen)
        eprints_cstr(c"' does not fit enum '")
        eprint_lexeme(ename, elen)
        eprints_cstr(c"''s representation type ")
        eprintln_cstr(primitive_name_from_type(repr))
        g_attr_errors = g_attr_errors + 1
        return
    var w: i32 = *(g_enum_variant_starts + ei)
    while w < v
        if *(g_enum_variant_discr + w) == bits
            enum_error_at(line, col)
            eprints_cstr(c"variants '")
            eprint_lexeme(*(g_enum_variant_names + w), *(g_enum_variant_name_lens + w))
            eprints_cstr(c"' and '")
            eprint_lexeme(vname, vlen)
            eprints_cstr(c"' of enum '")
            eprint_lexeme(ename, elen)
            eprints_cstr(c"' have the same discriminant ")
            eprint_discr(bits, neg)
            eprintln_cstr(c"")
            g_attr_errors = g_attr_errors + 1
            return
        w = w + 1

fn enum_variant_record_impl(p: *Parser, name: *u8, len: i32, kind: i32, fields: *StructField, explicit: i32, discr: i64, discr_neg: i32, line: i32, col: i32) -> i32
    init_enum_tracker()
    if g_enum_count == 0
        return 0
    # The same token again: `enum_variants : enum_variant enum_variants`
    # fails after the last variant and backtracks into `enum_variant`, which
    # runs this action a second time for it.  That used to record a phantom
    # copy of every enum's last variant (AGAST #1880 found it: the copy
    # shares its discriminant).
    if *(g_enum_variant_counts + g_enum_count - 1) > 0
        if *(g_enum_variant_names + g_enum_variant_total - 1) == name
            return 0
    if g_enum_variant_total >= g_enum_variant_cap
        let vcap: i64 = (g_enum_variant_cap as i64) * 2
        g_enum_variant_names = realloc(g_enum_variant_names as *u8, vcap * 8) as **u8
        g_enum_variant_name_lens = realloc(g_enum_variant_name_lens as *u8, vcap * 4) as *i32
        g_enum_variant_fields = realloc(g_enum_variant_fields as *u8, vcap * 8) as **StructField
        g_enum_variant_kinds = realloc(g_enum_variant_kinds as *u8, vcap * 4) as *i32
        g_enum_variant_discr = realloc(g_enum_variant_discr as *u8, vcap * 8) as *i64
        g_enum_variant_neg = realloc(g_enum_variant_neg as *u8, vcap * 4) as *i32
        g_enum_variant_cap = vcap as i32
    *(g_enum_variant_names + g_enum_variant_total) = name
    *(g_enum_variant_name_lens + g_enum_variant_total) = len
    *(g_enum_variant_fields + g_enum_variant_total) = fields
    *(g_enum_variant_kinds + g_enum_variant_total) = kind
    # The discriminant: explicit, else the previous variant's + 1, else 0.
    let ei: i32 = g_enum_count - 1
    var bits: i64 = discr
    var neg: i32 = discr_neg
    if explicit == 0
        bits = 0
        neg = 0
        if *(g_enum_variant_counts + ei) > 0
            let prev: i32 = g_enum_variant_total - 1
            bits = *(g_enum_variant_discr + prev) + 1
            neg = *(g_enum_variant_neg + prev)
            if neg == 1 and bits == 0
                neg = 0
    *(g_enum_variant_discr + g_enum_variant_total) = bits
    *(g_enum_variant_neg + g_enum_variant_total) = neg
    let v: i32 = g_enum_variant_total
    g_enum_variant_total = g_enum_variant_total + 1
    *(g_enum_variant_counts + ei) = *(g_enum_variant_counts + ei) + 1
    enum_variant_check(p, ei, v, kind, explicit, line, col)
    return 0

# Lookup: returns the variant's tag index (0-based) within an enum, or -1
# when either the enum or the variant is unknown.
pub fn enum_variant_index(enum_name: *u8, enum_name_len: i32, var_name: *u8, var_name_len: i32) -> i32
    if g_enum_initialized == 0
        return 0 - 1
    var ei: i32 = 0
    while ei < g_enum_count
        if *(g_enum_name_lens + ei) == enum_name_len
            var match_e: i32 = 1
            for k in 0..enum_name_len
                if *(*(g_enum_names + ei) + k) != *(enum_name + k)
                    match_e = 0
            if match_e == 1
                let start: i32 = *(g_enum_variant_starts + ei)
                for vi in 0..*(g_enum_variant_counts + ei)
                    if *(g_enum_variant_name_lens + start + vi) == var_name_len
                        var match_v: i32 = 1
                        for k in 0..var_name_len
                            if *(*(g_enum_variant_names + start + vi) + k) != *(var_name + k)
                                match_v = 0
                        if match_v == 1
                            return vi
                return 0 - 1
        ei = ei + 1
    return 0 - 1

# Returns 1 if name is a known enum type, 0 otherwise.
pub fn is_enum_type(name: *u8, len: i32) -> i32
    if g_enum_initialized == 0
        return 0
    var ei: i32 = 0
    while ei < g_enum_count
        if *(g_enum_name_lens + ei) == len
            var match_e: i32 = 1
            for k in 0..len
                if *(*(g_enum_names + ei) + k) != *(name + k)
                    match_e = 0
            if match_e == 1
                return 1
        ei = ei + 1
    return 0

# --- AGAST #1797: enum / variant accessors for the emitter -----------------

fn enum_name_eq(ei: i32, name: *u8, len: i32) -> i32
    if *(g_enum_name_lens + ei) != len
        return 0
    let stored: *u8 = *(g_enum_names + ei)
    for k in 0..len
        let sb: u8 = *(stored + k)
        let qb: u8 = *(name + k)
        if sb != qb
            return 0
    return 1

# Tracker index of the enum `name`, or -1.  The first one recorded wins, as
# in enum_variant_index.
pub fn enum_find(name: *u8, len: i32) -> i32
    if g_enum_initialized == 0
        return 0 - 1
    var ei: i32 = 0
    while ei < g_enum_count
        if enum_name_eq(ei, name, len) == 1
            return ei
        ei = ei + 1
    return 0 - 1

pub fn enum_count() -> i32
    return g_enum_count

pub fn enum_name_at(ei: i32, out_len: *i32) -> *u8
    *out_len = *(g_enum_name_lens + ei)
    return *(g_enum_names + ei)

pub fn enum_is_generic(ei: i32) -> i32
    return *(g_enum_generic + ei)

# AGAST #2422: g_enum_generic[e] is ENUM_INSTANCE for `Slot$i32`, an instance of
# a generic enum that monomorph recorded (enum_record_instance).  It is a
# concrete enum (enum_is_generic(e) != 1), with ritz0's layout, but no declarer
# of its variants: the template `Slot` declares `Full`, however many instances.
pub const ENUM_INSTANCE: i32 = 2

# Record `name` (`Slot$i32`) as an instance of generic enum `base`: its variants
# in order, with their kinds and discriminants, variant `vi` carrying
# *(fields + vi).  Returns its tracker index.
pub fn enum_record_instance(base: i32, name: *u8, len: i32, fields: **StructField) -> i32
    enum_def_start_full(name, len, ENUM_INSTANCE, 0, *(g_enum_line + base))
    let ei: i32 = g_enum_count - 1
    *(g_enum_pub + ei) = *(g_enum_pub + base)
    let count: i32 = *(g_enum_variant_counts + base)
    for vi in 0..count
        if g_enum_variant_total >= g_enum_variant_cap
            let vcap: i64 = (g_enum_variant_cap as i64) * 2
            g_enum_variant_names = realloc(g_enum_variant_names as *u8, vcap * 8) as **u8
            g_enum_variant_name_lens = realloc(g_enum_variant_name_lens as *u8, vcap * 4) as *i32
            g_enum_variant_fields = realloc(g_enum_variant_fields as *u8, vcap * 8) as **StructField
            g_enum_variant_kinds = realloc(g_enum_variant_kinds as *u8, vcap * 4) as *i32
            g_enum_variant_discr = realloc(g_enum_variant_discr as *u8, vcap * 8) as *i64
            g_enum_variant_neg = realloc(g_enum_variant_neg as *u8, vcap * 4) as *i32
            g_enum_variant_cap = vcap as i32
        let from: i32 = *(g_enum_variant_starts + base) + vi
        let to: i32 = g_enum_variant_total
        *(g_enum_variant_names + to) = *(g_enum_variant_names + from)
        *(g_enum_variant_name_lens + to) = *(g_enum_variant_name_lens + from)
        *(g_enum_variant_kinds + to) = *(g_enum_variant_kinds + from)
        *(g_enum_variant_discr + to) = *(g_enum_variant_discr + from)
        *(g_enum_variant_neg + to) = *(g_enum_variant_neg + from)
        *(g_enum_variant_fields + to) = *(fields + vi)
        g_enum_variant_total = g_enum_variant_total + 1
        *(g_enum_variant_counts + ei) = *(g_enum_variant_counts + ei) + 1
    ei

pub fn enum_variant_count(ei: i32) -> i32
    return *(g_enum_variant_counts + ei)

# Name of variant `vi` of enum `ei`.
pub fn enum_variant_name(ei: i32, vi: i32, out_len: *i32) -> *u8
    let at: i32 = *(g_enum_variant_starts + ei) + vi
    *out_len = *(g_enum_variant_name_lens + at)
    return *(g_enum_variant_names + at)

# Kind (ENUM_VARIANT_*) and payload fields of variant `vi` of enum `ei`.
pub fn enum_variant_kind(ei: i32, vi: i32) -> i32
    return *(g_enum_variant_kinds + *(g_enum_variant_starts + ei) + vi)

pub fn enum_variant_fields(ei: i32, vi: i32) -> *StructField
    return *(g_enum_variant_fields + *(g_enum_variant_starts + ei) + vi)

# LANGUAGE_SPEC §10.4: enum `ei`'s representation type (0: none) and the
# discriminant bits of its variant `vi`.
pub fn enum_repr(ei: i32) -> i32
    return *(g_enum_repr + ei)

pub fn enum_variant_discr(ei: i32, vi: i32) -> i64
    return *(g_enum_variant_discr + *(g_enum_variant_starts + ei) + vi)

# 1 when every variant's discriminant is its index (no `= N` moved one).
pub fn enum_discr_is_index(ei: i32) -> i32
    for vi in 0..*(g_enum_variant_counts + ei)
        if enum_variant_discr(ei, vi) != vi as i64
            return 0
    return 1

# `E__from`, the fn `E.from(v)` calls (LANGUAGE_SPEC §10.4): the receiver's
# name + "__from", malloc'd.  *out_len gets its length.
pub fn enum_from_fn_name(name: *u8, len: i32, out_len: *i32) -> *u8
    let buf: *u8 = malloc((len + 7) as i64)
    for i in 0..len
        *(buf + i) = *(name + i)
    let suffix: *u8 = c"__from"
    for j in 0..6
        *(buf + len + j) = *(suffix + j)
    *(buf + len + 6) = 0
    *out_len = len + 6
    return buf

# Is `e` the method call `E.from(...)` on the bare name of an enum?
pub fn is_enum_from_call(e: *Expr) -> i32
    if e.kind != EXPR_METHOD or e.left == null or e.left.kind != EXPR_IDENT
        return 0
    if e.ident_len != 4 or memcmp(e.ident_ptr, c"from", 4) != 0
        return 0
    if enum_find(e.left.ident_ptr, e.left.ident_len) < 0
        return 0
    return 1

# --- E.from source (LANGUAGE_SPEC §10.4) -----------------------------------
# ritz0 generates the same text (parser.py, enum_from_source): for each enum
# with a representation type,
#
#     [pub ]fn E__from(v: T) -> Option<E>
#         if v == <discriminant>
#             return Some(E.V)
#         ...
#         return None
#
# preceded by enough newlines that it starts on the enum's line.  The driver
# parses it into the enum's module (main.ritz, add_enum_from_fns).

var g_gen_buf: *u8 = null
var g_gen_len: i64 = 0
var g_gen_cap: i64 = 0

fn gen_push(b: *u8, n: i64)
    if g_gen_len + n + 1 > g_gen_cap
        var cap: i64 = g_gen_cap * 2 + n + 256
        g_gen_buf = realloc(g_gen_buf, cap)
        g_gen_cap = cap
    for i in 0..n
        *(g_gen_buf + g_gen_len + i) = *(b + i)
    g_gen_len = g_gen_len + n
    *(g_gen_buf + g_gen_len) = 0

fn gen_cstr(c: *u8)
    var n: i64 = 0
    while *(c + n) != 0
        n = n + 1
    gen_push(c, n)

# The discriminant as a literal: decimal, or hex for a u64 >= 2^63.
fn gen_discr(bits: i64, neg: i32)
    let digits: *u8 = malloc(24)
    var n: i32 = 0
    if neg == 0 and bits < 0
        gen_cstr(c"0x")
        while n < 16
            let nib: i64 = (bits >> ((15 - n) * 4) as i64) & 15
            if nib < 10
                *(digits + n) = (48 + nib) as u8
            else
                *(digits + n) = (87 + nib) as u8
            n = n + 1
        gen_push(digits, 16)
        free(digits)
        return
    var m: i64 = bits
    if neg == 1
        gen_cstr(c"-")
        m = 0 - bits
        if m < 0
            gen_cstr(c"9223372036854775808")
            free(digits)
            return
    while m > 0 or n == 0
        *(digits + n) = (48 + m % 10) as u8
        m = m / 10
        n = n + 1
    var i: i32 = n - 1
    while i >= 0
        gen_push(digits + i, 1)
        i = i - 1
    free(digits)

# Source of `from` for every enum with a representation type recorded at
# tracker index >= first_ei (the module just parsed), or null if there is
# none.  *out_len gets its length.  The buffer is the caller's to keep.
pub fn enum_from_source(first_ei: i32, out_len: *i64) -> *u8
    g_gen_buf = null
    g_gen_len = 0
    g_gen_cap = 0
    var line: i32 = 1
    var ei: i32 = first_ei
    while ei < g_enum_count
        let repr: i32 = *(g_enum_repr + ei)
        if repr != 0 and *(g_enum_generic + ei) == 0
            let ename: *u8 = *(g_enum_names + ei)
            let elen: i64 = *(g_enum_name_lens + ei) as i64
            while line < *(g_enum_line + ei)
                gen_cstr(c"\n")
                line = line + 1
            if *(g_enum_pub + ei) == 1
                gen_cstr(c"pub ")
            gen_cstr(c"fn ")
            gen_push(ename, elen)
            gen_cstr(c"__from(v: ")
            gen_cstr(primitive_name_from_type(repr))
            gen_cstr(c") -> Option<")
            gen_push(ename, elen)
            gen_cstr(c">\n")
            line = line + 1
            let start: i32 = *(g_enum_variant_starts + ei)
            for vi in 0..*(g_enum_variant_counts + ei)
                gen_cstr(c"    if v == ")
                gen_discr(*(g_enum_variant_discr + start + vi), *(g_enum_variant_neg + start + vi))
                gen_cstr(c"\n        return Some(")
                gen_push(ename, elen)
                gen_cstr(c".")
                gen_push(*(g_enum_variant_names + start + vi), *(g_enum_variant_name_lens + start + vi) as i64)
                gen_cstr(c")\n")
                line = line + 2
            gen_cstr(c"    return None\n")
            line = line + 1
        ei = ei + 1
    *out_len = g_gen_len
    return g_gen_buf

# 1 when enum `ea`'s name sorts before enum `eb`'s (bytewise; a proper prefix
# sorts first), else 0.
fn enum_name_lt(ea: i32, eb: i32) -> i32
    let a: *u8 = *(g_enum_names + ea)
    let b: *u8 = *(g_enum_names + eb)
    let a_len: i32 = *(g_enum_name_lens + ea)
    let b_len: i32 = *(g_enum_name_lens + eb)
    var k: i32 = 0
    while k < a_len and k < b_len
        let ab: u8 = *(a + k)
        let bb: u8 = *(b + k)
        if ab < bb
            return 1
        if ab > bb
            return 0
        k = k + 1
    if a_len < b_len
        return 1
    return 0

# The tag of variant `name` within enum `ei`, or -1.
fn enum_variant_slot(ei: i32, name: *u8, len: i32) -> i32
    let start: i32 = *(g_enum_variant_starts + ei)
    let count: i32 = *(g_enum_variant_counts + ei)
    for vi in 0..count
        let vidx: i32 = start + vi
        if *(g_enum_variant_name_lens + vidx) == len
            var same: i32 = 1
            let stored: *u8 = *(g_enum_variant_names + vidx)
            for k in 0..len
                let sb: u8 = *(stored + k)
                let qb: u8 = *(name + k)
                if sb != qb
                    same = 0
            if same == 1
                return vi
    return 0 - 1

# AGAST #1600 / #2039: the enum a bare variant name denotes, as a VALUE
# (`let s: S = B`) or a ctor call (`B()`, `Holds(x)`).  A name two or more
# non-generic enums declare is ambiguous whatever the expected type: it
# returns -2, with *out_vi set to the alphabetically-first declaring enum's
# index and *out_other to the second's, so the caller can name both (ritz0
# names the same two; declaration order differs between the compilers across
# imports).  -1 when no enum declares the name.  Otherwise the enum index,
# with *out_vi the variant's tag.
pub fn enum_of_variant_unique(name: *u8, len: i32, out_vi: *i32, out_other: *i32) -> i32
    *out_vi = 0 - 1
    *out_other = 0 - 1
    if g_enum_initialized == 0
        return 0 - 1
    # lo / hi: the two alphabetically-smallest distinct declarers so far.
    var lo: i32 = 0 - 1
    var lo_vi: i32 = 0 - 1
    var hi: i32 = 0 - 1
    var ei: i32 = 0
    while ei < g_enum_count
        if *(g_enum_generic + ei) == 0
            let vi: i32 = enum_variant_slot(ei, name, len)
            if vi >= 0
                # The same enum recorded twice (a module reached again
                # through an import cycle, as tempest's tab.ritz is) is not
                # ambiguous; the tracker keys enums by name (enum_find).
                var dup: i32 = 0
                if lo >= 0 and enum_name_eq(ei, *(g_enum_names + lo), *(g_enum_name_lens + lo)) == 1
                    dup = 1
                if hi >= 0 and enum_name_eq(ei, *(g_enum_names + hi), *(g_enum_name_lens + hi)) == 1
                    dup = 1
                if dup == 0
                    if lo < 0
                        lo = ei
                        lo_vi = vi
                    else if enum_name_lt(ei, lo) == 1
                        hi = lo
                        lo = ei
                        lo_vi = vi
                    else if hi < 0 or enum_name_lt(ei, hi) == 1
                        hi = ei
        ei = ei + 1
    if hi >= 0
        *out_vi = lo
        *out_other = hi
        return 0 - 2
    *out_vi = lo_vi
    return lo

# =============================================================================
# AGAST #1794: `id<@E>(e)` and `a[:]`
# =============================================================================
# Kept together here, apart from the generic-arg speller, so they stay out of
# that code's way.

# Reference-typed generic call: `id<@E>(e)` builds the suffix `$ref_E`, as
# ritz0 mangles a RefType argument (monomorph.py mangle_type_name).
# monomorph substitutes T with a pointer to E for it, as for `$ptr_E`
# (suffix_is_ptr): a reference is a pointer at the IR level.
pub fn postfix_generic_call_ref(p: *Parser, type_tok: Token, args: *Expr) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_CALL
    op.args = args
    # "$ref_" + type_name (an alias spelled as its target, #2037).
    var len: i32 = 0
    op.call_type_suffix = generic_tok_suffix(p, c"ref_", 4, type_tok, @len)
    op.call_type_suffix_len = len
    op.next = null
    return op

# full_slice_tail : '[' ':' ']' postfix_ops  →  a marker whose `next` holds
# the postfix ops that follow the slice.  Never null, so `full_slice_tail?`
# can tell "present with nothing after" from "absent".
pub fn full_slice_tail_new(p: *Parser, rest: *PostfixOp) -> *PostfixOp
    let op: *PostfixOp = parser_alloc(p, sizeof(PostfixOp)) as *PostfixOp
    op.kind = POSTFIX_INDEX
    op.args = null
    op.call_type_suffix = null
    op.call_type_suffix_len = 0
    op.index = null
    op.member_name = null
    op.member_len = 0
    op.bracket.line = 0
    op.next = rest
    return op

# The method call `recv.name(args)` (no generic suffix) as EXPR_METHOD.
fn method_call_expr(p: *Parser, recv: *Expr, name: *u8, name_len: i32, args: *Expr) -> *Expr
    let m: *Expr = parser_alloc(p, sizeof(Expr)) as *Expr
    m.kind = EXPR_METHOD
    m.span = recv.span
    m.left = recv
    m.ident_ptr = name
    m.ident_len = name_len
    m.args = args
    m.call_type_suffix = null
    m.call_type_suffix_len = 0
    m.next = null
    return m

# `a[:]`  →  `a.slice(0, a.len())`, then the ops after the slice.  This is
# ritz0's lowering (emitter _emit_slice): vec_slice<T>(&v, 0, len) for a Vec
# (a COPY: angelo's documented clone idiom), string_slice for a String, a
# sub-span for a Span.  Lowering through the method keeps it visible to
# monomorph, which instantiates vec_slice$T from the method call.  The
# receiver node is shared by both calls; ritz0 likewise requires an lvalue
# receiver, so evaluating it twice has no side effects to repeat.
pub fn apply_full_slice_p(p: *Parser, recv: *Expr, tail: *PostfixOp) -> *Expr
    if tail == null
        return recv
    let len_call: *Expr = method_call_expr(p, recv, c"len", 3, null)
    let zero: *Expr = expr_int(p, 0, recv.span.line, recv.span.col)
    let slice: *Expr = method_call_expr(p, recv, c"slice", 5, expr_link(zero, len_call))
    return apply_postfix_p(p, slice, tail.next)

# The TYPE_* kind a primitive type name spells ("u8", "i32", ..., "bool"),
# else 0.  Shared by monomorph (suffix -> substituted kind) and the let-path
# narrowing of a `-> *T` generic call (AGAST #1980).
# AGAST #1984: the inverse of primitive_type_from_name.  null / 0 for a
# non-primitive kind (struct, pointer, array, ...).
pub fn primitive_name_from_type(t: i32) -> *u8
    if t == TYPE_U8
        return c"u8"
    if t == TYPE_I8
        return c"i8"
    if t == TYPE_U16
        return c"u16"
    if t == TYPE_I16
        return c"i16"
    if t == TYPE_U32
        return c"u32"
    if t == TYPE_I32
        return c"i32"
    if t == TYPE_U64
        return c"u64"
    if t == TYPE_I64
        return c"i64"
    if t == TYPE_F32
        return c"f32"
    if t == TYPE_F64
        return c"f64"
    if t == TYPE_BOOL
        return c"bool"
    null

pub fn primitive_name_len(t: i32) -> i32
    if t == TYPE_U8 or t == TYPE_I8
        return 2
    if t == TYPE_BOOL
        return 4
    if primitive_name_from_type(t) != null
        return 3
    0

pub fn primitive_type_from_name(name: *u8, len: i32) -> i32
    if name == null
        return 0
    if len == 2
        if memcmp(name, c"u8", 2) == 0
            return TYPE_U8
        if memcmp(name, c"i8", 2) == 0
            return TYPE_I8
    if len == 3
        if memcmp(name, c"u16", 3) == 0
            return TYPE_U16
        if memcmp(name, c"i16", 3) == 0
            return TYPE_I16
        if memcmp(name, c"u32", 3) == 0
            return TYPE_U32
        if memcmp(name, c"i32", 3) == 0
            return TYPE_I32
        if memcmp(name, c"u64", 3) == 0
            return TYPE_U64
        if memcmp(name, c"i64", 3) == 0
            return TYPE_I64
        if memcmp(name, c"f32", 3) == 0
            return TYPE_F32
        if memcmp(name, c"f64", 3) == 0
            return TYPE_F64
    if len == 4
        if memcmp(name, c"bool", 4) == 0
            return TYPE_BOOL
    0
