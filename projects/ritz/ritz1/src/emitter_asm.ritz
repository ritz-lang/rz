# emitter_asm.ritz - lower `asm` blocks to LLVM inline asm (AGAST #3395)
#
# LANGUAGE_SPEC §18.6 "Lowering", LARB R50.  The parser built and checked
# the block (stmt_asm, ast_helpers.ritz, AGAST #3394); every check that needs
# types is here.  Each block becomes one call:
#
#   %r = call <ret> asm sideeffect "<template>", "<constraints>"(<inputs>)
#
# * The operands are numbered outputs first (`out` and `inout`, in clause
#   order), then inputs (`in` and `inout`, clause operands then text-only
#   ones, in the order the parser listed them).
# * The template is the lines joined by `\0A`, with `{name}` -> `$N` (`${N}`
#   when a digit follows), `$` -> `$$`, `{{` / `}}` -> a brace, and `"`, `\`
#   and any unprintable byte as LLVM's `\XX`.
# * The constraints: per output `={reg}` if pinned, else `=&r` (the block may
#   write it before reading every input); per input the output number of an
#   `inout`, else `{reg}` if pinned, else `r`; then `~{reg}` for every
#   `clobber` clause and every general register the text names (as its
#   64-bit register; never rsp / rbp; never one pinned to an output, #3425),
#   then the fixed
#   `~{memory},~{dirflag},~{fpsr},~{flags}`.
# * The result: void with no output, the output's type with one, a literal
#   struct with several; each output is stored back to its place.
#
# An operand's LLVM type is its Ritz type's: i8 / i16 / i32 / i64 for the
# integers, which is what sets the register's width (`{port}` of a u16 is
# `%dx`), and `ptr` for `*T`, `@T`, `@&T`, `**T`.  It is loaded from and
# stored to its place at that type: a local's slot (a pointer local's is an
# i64 slot; LLVM's pointers are opaque, so a `ptr` load of it is the same 8
# bytes), or a global's (a narrow global lives in an i64 slot whose low bytes
# are the value, as every access reads it).  A const is an input only: its
# value.
#
# The errors (each at the operand: its clause name, else its first `{name}`):
# a name that is not a local, a parameter, a global or a const; a type that
# is not an integer or a pointer (a bool is an i1, which no register takes);
# `out` / `inout` on a `let` or a const.  `out` / `inout` are assignments for
# the borrow rules (§13.5): ref_check_asm, ref_check.ritz.
#
# [[naked]] (emit_naked_fn_body): the blocks, which take no operand
# (asm_check_naked), then `unreachable`.

import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.memory
import ritzlib.string
import ritzlib.strview

import ast
import types
import ast_helpers
import emitter_core
import text_bridge   # no_name / unnamed (AGAST #4696)
import diag          # diag_error_at (AGAST #3445)

# One operand of the block being lowered.
struct AsmOp
    op: *AsmOperand
    ty: StrView           # its LLVM type: "i8" .. "i64" or "ptr"
    addr: i32             # a local's slot register; -1 if not a local
    glob: *GlobalVarDef   # a global's definition; null if not a global
    is_const: bool        # a const (input only)
    const_value: i64
    out_idx: i32          # its output number; -1 for an `in`
    in_idx: i32           # its input's operand number; -1 for an `out`
    val: i32              # the register its input value was loaded into

# The 64-bit name of general register `i` (the ASM_REG_* index); no_name()
# for ASM_REG_NONE.
fn asm_reg_name(i: i32) -> StrView
    match i
        0 => "rax"
        1 => "rcx"
        2 => "rdx"
        3 => "rbx"
        4 => "rsp"
        5 => "rbp"
        6 => "rsi"
        7 => "rdi"
        8 => "r8"
        9 => "r9"
        10 => "r10"
        11 => "r11"
        12 => "r12"
        13 => "r13"
        14 => "r14"
        15 => "r15"
        _ => no_name()

# The register a two-letter `ax` / `cx` / `dx` / `bx` / `sp` / `bp` / `si` /
# `di` names, or ASM_REG_NONE.
fn asm_reg2(c0: u8, c1: u8) -> i32
    if c1 == 'x'
        if c0 == 'a'
            return 0
        if c0 == 'c'
            return 1
        if c0 == 'd'
            return 2
        if c0 == 'b'
            return 3
        return ASM_REG_NONE
    if c0 == 's' and c1 == 'p'
        return ASM_REG_RSP
    if c0 == 'b' and c1 == 'p'
        return ASM_REG_RBP
    if c0 == 's' and c1 == 'i'
        return 6
    if c0 == 'd' and c1 == 'i'
        return 7
    ASM_REG_NONE

# The general register `name` (after a `%`) is part of, as its ASM_REG_*
# index, or ASM_REG_NONE: `rax`, `eax`, `ax`, `al`, `ah`, `sil`, `r8d`,
# `r8w`, `r8b`, `r8l` ...
pub fn asm_text_reg(name_sv: StrView) -> i32
    let name: StrView = name_sv
    let len: i64 = name.len
    let r64: i32 = asm_reg_index(name)
    if r64 != ASM_REG_NONE
        return r64
    if len == 2
        let r16: i32 = asm_reg2(name.get(0), name.get(1))
        if r16 != ASM_REG_NONE
            return r16
        # al / ah, cl / ch, dl / dh, bl / bh
        let c1: u8 = name.get(1)
        if c1 == 'l' or c1 == 'h'
            let byte_of: i32 = asm_reg2(name.get(0), 'x')
            if byte_of >= 0 and byte_of <= 3
                return byte_of
        return ASM_REG_NONE
    if len == 3 and name.get(0) == 'e'   # eax, esp, esi ...
        return asm_reg2(name.get(1), name.get(2))
    if len == 3 and name.get(2) == 'l'   # spl, bpl, sil, dil
        let low: i32 = asm_reg2(name.get(0), name.get(1))
        if low >= ASM_REG_RSP
            return low
        return ASM_REG_NONE
    # r8d .. r15b: an r-register with a width suffix
    if len >= 3 and name.get(0) == 'r'
        let suffix: u8 = name.get(len - 1)
        if suffix == 'd' or suffix == 'w' or suffix == 'b' or suffix == 'l'
            let r: i32 = asm_reg_index(name.take(len - 1))
            if r >= 8
                return r
    ASM_REG_NONE

fn asm_is_reg_char(c: u8) -> bool
    (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9')

# The text of asm line `l`.
fn asm_line_text(l: *AsmLine) -> StrView
    l.text

# The name `o` gives.
fn asm_operand_name(o: *AsmOperand) -> StrView
    o.name

# The bit (1 << ASM_REG_*) of every general register the text names, other
# than rsp and rbp: the stack pointers are never clobbers (§18.6).
fn asm_text_clobbers(b: *AsmBlock) -> i32
    var mask: i32 = 0
    var l: *AsmLine = b.lines
    while l != null
        let text: StrView = asm_line_text(l)
        var i: i64 = 0
        while i < text.len
            if text.get(i) == '%'
                var j: i64 = i + 1
                while j < text.len and asm_is_reg_char(text.get(j))
                    j = j + 1
                let r: i32 = asm_text_reg(text.slice(i + 1, j))
                if r != ASM_REG_NONE and r != ASM_REG_RSP and r != ASM_REG_RBP
                    mask = mask | (1 << r)
                i = j
            else
                i = i + 1
        l = l.next
    mask

# `<file>:<line>:<col>: error: <msg>`, counted.  Nothing goes in the IR.
fn asm_error(s: *EmitterState, at: SrcSpan, msg: StrView)
    diag_error_at(emitter_source_file(), at)
    eprints(msg)
    eprints("\n")
    s.diag.error_count = s.diag.error_count + 1

# The LLVM type an operand of Ritz type `t` has: an integer's is types.ritz's,
# a pointer's `ptr`; no_name() for anything else.
fn asm_llvm_type(t: TypeKind) -> StrView
    if ty_int_bits(t) > 0
        return ty_mem_llvm(t)
    match t
        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef => "ptr"
        _ => no_name()

# What `o` names, when it can be the operand it is; else None with the error
# reported.  Its output / input numbers are -1 until emit_asm_block numbers it.
fn asm_resolve(s: *EmitterState, o: *AsmOperand) -> Option<AsmOp>
    let name: StrView = asm_operand_name(o)
    var op: AsmOp = AsmOp { op: o, ty: no_name(), addr: 0 - 1, glob: null, is_const: false, const_value: 0, out_idx: 0 - 1, in_idx: 0 - 1, val: 0 }
    var t: TypeKind = TypeKind.Void
    var is_let: bool = false
    let idx: i32 = find_local_idx(s, name)
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        t = lv_var_type(loc)
        if loc.is_bool == 1
            t = TypeKind.Bool   # an i64 slot that holds a bool (AGAST #1521)
        op.addr = loc.reg
        is_let = loc.is_let == 1
    else
        let g: *GlobalVarDef = find_global(s, name)
        if g != null
            t = g.var_type
            op.glob = g
        else
            let ce: *ConstEntry = find_const_entry(s, name)
            if ce == null
                var msg: String = string_new()
                format_into(@&msg, "asm operand '{name}' is not a local, a parameter or a global")
                asm_error(s, o.span, msg.as_view())
                return None
            t = ce.const_type
            op.is_const = true
            op.const_value = ce.value
    op.ty = asm_llvm_type(t)
    if unnamed(op.ty)
        var msg: String = string_new()
        format_into(@&msg, "asm operand '{name}' must be an integer or a pointer")
        asm_error(s, o.span, msg.as_view())
        return None
    if o.dir == ASM_OUT or o.dir == ASM_INOUT
        let dir: StrView = if o.dir == ASM_INOUT then "inout" else "out"
        if is_let
            var msg: String = string_new()
            format_into(@&msg, "asm '{dir}' operand '{name}' is a `let` binding, not an assignable place: declare it `var`")
            asm_error(s, o.span, msg.as_view())
            return None
        if op.is_const
            var msg: String = string_new()
            format_into(@&msg, "asm '{dir}' operand '{name}' is a const, not an assignable place")
            asm_error(s, o.span, msg.as_view())
            return None
    Some(op)

# The place `op` is: `%.N` (a local's slot) or `@name` (a global).
fn asm_emit_place(s: *EmitterState, op: *AsmOp)
    if op.glob != null
        let g: String = ir_name(op.glob.name)
        format_into(s, "@{g.as_view()}")
    else
        let addr: i32 = op.addr
        format_into(s, "%.{addr}")

# Load `op`'s input value into a new register.
fn asm_load_input(s: *EmitterState, op: *AsmOp) -> i32
    let r: i32 = next_reg(s)
    let ty: StrView = op.ty
    if op.is_const
        let v: i64 = op.const_value
        if ty.eq("ptr")
            format_into(s, "  %.{r} = inttoptr i64 {v} to ptr\n")
        else if ty.eq("i64")
            format_into(s, "  %.{r} = add i64 0, {v}\n")
        else
            format_into(s, "  %.{r} = trunc i64 {v} to {ty}\n")
        return r
    format_into(s, "  %.{r} = load {ty}, ptr ")
    asm_emit_place(s, op)
    format_into(s, "\n")
    r

# The operand of `ops` named `name`, or null.
fn asm_op_named(ops: *AsmOp, n: i32, name: StrView) -> *AsmOp
    for i in 0..n
        let op: *AsmOp = ops + i
        if asm_operand_name(op.op).eq(name)
            return op
    null

# Hex digit `d` (0 .. 15), upper case.
fn hex_digit(d: i32) -> u8
    if d < 10
        return (48 + d) as u8
    (55 + d) as u8

# The block's template (see the top of the file).
fn asm_template(b: *AsmBlock, ops: *AsmOp, n: i32) -> String
    var t: String = string_new()
    var l: *AsmLine = b.lines
    while l != null
        if l != b.lines
            format_into(@&t, "\\0A")
        let text: StrView = asm_line_text(l)
        var i: i64 = 0
        while i < text.len
            let c: u8 = text.get(i)
            if (c == '{' or c == '}') and i + 1 < text.len and text.get(i + 1) == c
                t.push(c)   # `{{` / `}}`
                i = i + 2
            else if c == '{'
                var j: i64 = i + 1
                while j < text.len and text.get(j) != '}'
                    j = j + 1
                let op: *AsmOp = asm_op_named(ops, n, text.slice(i + 1, j))
                if op == null or j >= text.len
                    t.push(c)   # never reached: stmt_asm checked the braces
                    i = i + 1
                else
                    var num: i32 = op.out_idx
                    if num < 0
                        num = op.in_idx
                    if j + 1 < text.len and text.get(j + 1) >= '0' and text.get(j + 1) <= '9'
                        format_into(@&t, "${{{num}}}")
                    else
                        format_into(@&t, "${num}")
                    i = j + 1
            else if c == '$'   # `$` is literal: `$$` to LLVM
                format_into(@&t, "$$")
                i = i + 1
            else if c == '"' or c == '\\' or c < ' ' or c > '~'
                t.push('\\')   # escaped for an LLVM string
                t.push(hex_digit((c >> 4) as i32))
                t.push(hex_digit((c & 15) as i32))
                i = i + 1
            else
                t.push(c)
                i = i + 1
        l = l.next
    t

# The block's constraint string (see the top of the file).  Each constraint
# is followed by its `,`; the fixed clobbers end the string.
fn asm_constraints(b: *AsmBlock, ops: *AsmOp, n: i32) -> String
    var c: String = string_new()
    # The outputs, in output order, which is operand order.
    for i in 0..n
        let op: *AsmOp = ops + i
        if op.out_idx >= 0
            let pin: StrView = asm_reg_name(op.op.reg)
            if unnamed(pin)
                format_into(@&c, "=&r,")
            else
                format_into(@&c, "={{{pin}}},")
    for i in 0..n
        let op: *AsmOp = ops + i
        if op.in_idx >= 0
            let pin: StrView = asm_reg_name(op.op.reg)
            let tie: i32 = op.out_idx
            if tie >= 0
                format_into(@&c, "{tie},")   # an inout: tied to its output
            else if unnamed(pin)
                format_into(@&c, "r,")
            else
                format_into(@&c, "{{{pin}}},")
    # A register pinned to an output is that output, not a clobber (#3425):
    # `={rax},0,~{rax}` lets LLVM drop an inout's tie, losing its input value.
    var pinned_out: i32 = 0
    for i in 0..n
        let op: *AsmOp = ops + i
        if op.out_idx >= 0 and op.op.reg != ASM_REG_NONE
            pinned_out = pinned_out | (1 << op.op.reg)
    let clobbers: i32 = (b.clobbers | asm_text_clobbers(b)) & ~pinned_out
    for r in 0..16
        if (clobbers & (1 << r)) != 0
            let reg: StrView = asm_reg_name(r as i32)
            format_into(@&c, "~{{{reg}}},")
    format_into(@&c, "~{{memory}},~{{dirflag}},~{{fpsr}},~{{flags}}")
    c

# The call's result type: void, the one output's type, or a literal struct.
fn asm_ret_type(ops: *AsmOp, n: i32, n_out: i32) -> String
    var t: String = string_new()
    if n_out == 0
        format_into(@&t, "void")
        return t
    if n_out > 1
        format_into(@&t, "{{ ")
    var sep: StrView = ""
    for i in 0..n
        let op: *AsmOp = ops + i
        if op.out_idx >= 0
            let ty: StrView = op.ty
            format_into(@&t, "{sep}{ty}")
            sep = ", "
    if n_out > 1
        format_into(@&t, " }}")
    t

# Lower the StmtKind.Asm `stmt` (LANGUAGE_SPEC §18.6, AGAST #3395).
pub fn emit_asm_block(s: *EmitterState, stmt: *Stmt)
    let b: *AsmBlock = stmt.asm_block
    var n: i32 = 0
    var o: *AsmOperand = b.operands
    while o != null
        n = n + 1
        o = o.next
    var ops: *AsmOp = null
    if n > 0
        ops = malloc((n as i64) * sizeof(AsmOp)) as *AsmOp
    # Resolve every operand; report every one that is wrong.
    var ok: bool = true
    o = b.operands
    var i: i32 = 0
    while o != null
        match asm_resolve(s, o)
            Some(op) =>
                *(ops + i) = op
            None =>
                ok = false
        i = i + 1
        o = o.next
    if not ok
        free(ops as *u8)
        return
    # Number them: outputs first, then inputs.
    var n_out: i32 = 0
    for k in 0..n
        let op: *AsmOp = ops + k
        if op.op.dir == ASM_OUT or op.op.dir == ASM_INOUT
            op.out_idx = n_out
            n_out = n_out + 1
    var next_in: i32 = n_out
    for k in 0..n
        let op: *AsmOp = ops + k
        if op.op.dir == ASM_IN or op.op.dir == ASM_INOUT
            op.in_idx = next_in
            next_in = next_in + 1
            op.val = asm_load_input(s, op)
    # The call.  The template's first byte is never a space (lexer_asm_text
    # starts a line past its indentation), so it can't read as a `  ret`.
    let ret_ty: String = asm_ret_type(ops, n, n_out)
    let tmpl: String = asm_template(b, ops, n)
    let cons: String = asm_constraints(b, ops, n)
    var res: i32 = 0
    if n_out > 0
        res = next_reg(s)
        format_into(s, "  %.{res} = call {ret_ty.as_view()} asm sideeffect \"{tmpl.as_view()}\", \"{cons.as_view()}\"(")
    else
        format_into(s, "  call void asm sideeffect \"{tmpl.as_view()}\", \"{cons.as_view()}\"(")
    var sep: StrView = ""
    for k in 0..n
        let op: *AsmOp = ops + k
        if op.in_idx >= 0
            let ty: StrView = op.ty
            let val: i32 = op.val
            format_into(s, "{sep}{ty} %.{val}")
            sep = ", "
    format_into(s, ")\n")
    # Each output back to its place.
    for k in 0..n
        let op: *AsmOp = ops + k
        if op.out_idx >= 0
            var v: i32 = res
            if n_out > 1
                v = next_reg(s)
                let field: i32 = op.out_idx
                format_into(s, "  %.{v} = extractvalue {ret_ty.as_view()} %.{res}, {field}\n")
            let ty: StrView = op.ty
            format_into(s, "  store {ty} %.{v}, ptr ")
            asm_emit_place(s, op)
            format_into(s, "\n")
    if ops != null
        free(ops as *u8)

# The body of a [[naked]] fn (§17.5, §18.6): its asm blocks, then
# `unreachable`: the asm returns by itself.  No parameter is spilled, no
# frame is made.
pub fn emit_naked_fn_body(s: *EmitterState, f: *FnDef)
    var st: *Stmt = f.body
    while st != null
        if st.kind == StmtKind.Asm
            emit_asm_block(s, st)
        st = st.next
    format_into(s, "  unreachable\n")
