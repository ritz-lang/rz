# ritz1/src/emitter_types.ritz - what an expression's type, struct, pointee
# or element is, asked before it is emitted
#
# The half of emitter_core that asks the emitter modules above it: method
# callee lookup (emitter_expr_call), index-through views (index_through),
# deref pointee names (emitter_expr_arith) and emit_expr for a spill.  Moved
# out of emitter_core by AGAST #1818 so emitter_core imports no emitter
# module above it.  Every fn here reaches one of those; one that doesn't
# belongs in emitter_core.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview    # strview_eq / strview_starts_with_cstr
import ritzlib.fmt.digits
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.hashmap
import ast
import diag            # diag_error_at, fn_display_name (AGAST #3445, #3621, #4018)
import types           # the one primitive type table (AGAST #1889)
import sha256          # sha256_hex, for a private fn's symbol (AGAST #4356)
import ast_helpers   # is_enum_type / enum_variant_index (AGAST #1660)
import index_through # index_through (AGAST #2440)
import tokens_gen
import emitter_ir      # ir_alloca (AGAST #4460)
import emitter_expr
import emitter_expr_arith
import emitter_expr_call
import monomorph       # MonoCtx, EmitterState.mono (AGAST #4454)
import emitter_core

# AGAST #2329: what a `*[N]T`, `@[N]T` or `@&[N]T` base that isn't a local was
# declared as: a field `h.r`, a global `g` or a call `h(p)`.  Each records the type
# as a param would (ptr_array_of_last), so `x[i]` on one is element i at stride T,
# as on a local (LARB R9).  null for anything else, a local included.
pub fn base_ptr_array(s: *EmitterState, e: *Expr) -> *Param
    if e == null
        return null
    var pa: *Param = null
    match e.kind
        ExprKind.Member =>
            let f: *StructField = member_field_def(s, e)
            if f != null
                pa = f.ptr_array
        ExprKind.Ident =>
            if find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
                return null
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g != null
                pa = g.ptr_array
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, e)
            if fd != null
                pa = fd.ret_ptr_array
        ExprKind.Cast =>
            pa = e.cast_ptr_array   # AGAST #4122: `x as *[N][M]T`
        _ => pass
    if pa == null or pa.param_pointee_array_size <= 0
        return null
    # AGAST #4122: a `**[N][M]T` field, global or return records its `*x`
    # (ptr_array_of_last); x itself is no array pointer.  base_plane_ptr_ptr.
    if pa.param_type == TypeKind.PtrPtr
        return null
    pa

# AGAST #4122: the shape of the `*[N][M]..T` that `*e` reads, `e` a `**[N][M]..T`
# field `s.q`, global `gq` or call `f()`; null for anything else, a local included.
fn base_plane_ptr_ptr(s: *EmitterState, e: *Expr) -> *ArrayShape
    var pa: *Param = null
    match e.kind
        ExprKind.Member =>
            let f: *StructField = member_field_def(s, e)
            if f != null
                pa = f.ptr_array
        ExprKind.Ident =>
            if find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
                return null
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g != null
                pa = g.ptr_array
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, e)
            if fd != null
                pa = fd.ret_ptr_array
        _ => pass
    if pa == null or pa.param_type != TypeKind.PtrPtr
        return null
    pa.param_pointee_array_shape

# AGAST #2304: the stride of `x + k` on `x`, a `*[N]T` field or global: a row,
# N * sizeof(T), as on a local (#2330, LARB R9).  A global stepped one byte and a
# field refused.  0 when `x` isn't one or T has no size.
pub fn base_ptr_array_row_size(s: *EmitterState, e: *Expr) -> i64
    let pa: *Param = base_ptr_array(s, e)
    if pa == null or pa.param_type != TypeKind.Ptr
        return 0
    let elem: i64 = ptr_pointee_size(s, pa.param_pointee_array_elem_type, StrView { ptr: (pa.param_type_name), len: (pa.param_type_name_len) as i64 })
    if elem <= 0
        return 0
    elem * (pa.param_pointee_array_size as i64)

# AGAST #2329: the view of `root`, a base_ptr_array, as add_array_view would bind it
# for a local, but in no scope, holding `root` in array_base; null if it has none.
pub fn base_array_view(s: *EmitterState, root: *Expr) -> *LocalVar
    let pa: *Param = base_ptr_array(s, root)
    if pa == null
        return null
    return unscoped_array_view(s, root, pa.param_pointee_array_elem_type, StrView { ptr: (pa.param_type_name), len: (pa.param_type_name_len) as i64 }, pa.param_pointee_array_elem_pointee)

var g_base_spills: i32 = 0

# "#" + up to 20 digits of an i64 + NUL (AGAST #1820: no magic alloc sizes).
const BASE_SPILL_NAME_BUF: i64 = 24


# AGAST #2329: `view`, bound, at an emitting site.  A base_array_view's base is
# evaluated once, into a `*T` local named `#k`, so `x[i]` is `*(#k + i)` the way a
# local's is `*(p# + i)`; anything else is `view` itself.
pub fn through_spill(s: *EmitterState, view: *LocalVar) -> *LocalVar
    if view == null or lv_array_base(view) == null
        return view
    let val: i32 = emit_expr(s, lv_array_base(view))
    let slot: i32 = entry_alloca(s, c"i64", null)
    emit_store_typed(s, IR_TY_I64, val, slot)
    g_base_spills = g_base_spills + 1
    let name: *u8 = malloc(BASE_SPILL_NAME_BUF)
    *name = 35   # '#': no identifier has one
    let len: i32 = 1 + fmt_i64_into(Span<u8> { ptr: name + 1, len: BASE_SPILL_NAME_BUF - 1 }, g_base_spills as i64).len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, slot, TypeKind.Ptr, StrView { ptr: (lv_type_name(view)), len: (lv_type_name_len(view)) as i64 }, lv_pointee_type(view), 0, TypeKind.Void)
    let bound: *LocalVar = local_at(s, s.local_count - 1)
    lv_mark_array_view(bound)
    bound

# The FnDef a call expression names: `func_name` plus its generic suffix
# (`vec_new` + `$u8`).  Replaces nine copies of a loop that built the name in
# a fixed [256]u8 stack buffer with no bounds check (AGAST #1813).
pub fn find_call_fn(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len == 0
        return call_callee_sig(s, e)   # AGAST #1747
    if e.call_type_suffix_len <= 0
        # AGAST #3666: a typed fn-pointer local of this name is the callee, as
        # emit_call has it (#2246), so `let r = h(s)` takes h's result type.
        if find_local(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) >= 0
            let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
            if lv != null and lv_fn_sig(lv) != null and lv_var_type(lv) != TypeKind.Array
                return lv_fn_sig(lv)
        let f: *FnDef = find_fn(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if f != null
            return f
        # R10: `let p = C_mk(c)` takes the method's type (AGAST #2447).
        return find_impl_method_by_symbol(s.module, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    let n: i32 = e.func_name_len + e.call_type_suffix_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + n) = 0
    let fd: *FnDef = find_fn(s, StrView { ptr: (buf), len: (n) as i64 })
    free(buf)
    return fd

# AGAST #1747: the signature of a nameless call's callee expression
# (`fs[i](..)`, built by apply_postfix_p with the callee in `left`), or null
# when it is not statically known.  An element of a `[N]fn(..) -> T` local
# carries the element signature on the local (set_local_fn_sig).
#
# AGAST #2120: so do the other callees whose type is a fn type, so a call
# through each is typed and keeps a fn-type alias's [[callconv]] (the
# signature is the alias's, which carries it): a cast `(p as EfiFn)(..)`, a
# field `(t.f)(..)`, and a fn's result `get()(..)`.
pub fn call_callee_sig(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len != 0
        return null
    value_fn_sig(s, e.left)

# The signature of the fn value `c` (null when not statically known): the
# callee of a nameless call, or an untyped `let h = c` (AGAST #3666).
pub fn value_fn_sig(s: *EmitterState, c: *Expr) -> *FnDef
    if c == null
        return null
    if c.kind == ExprKind.Index and c.left != null and c.left.kind == ExprKind.Ident
        let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (c.left.ident_ptr), len: (c.left.ident_len) as i64 })
        if lv != null and lv_var_type(lv) == TypeKind.Array
            return lv_fn_sig(lv)
    # AGAST #3666: an element of a `fs: [N]fn(..) -> T` field, `(t.fs[i])(..)`.
    # It was the untyped `call i64 %f(i64 ..)`, wrong for a by-value struct.
    else if c.kind == ExprKind.Index and c.left != null and c.left.kind == ExprKind.Member and c.right != null and c.right.kind != ExprKind.Range
        let af: *StructField = member_field_def(s, c.left)
        if af != null and af.field_type == TypeKind.Array
            return af.elem_fn_sig
    else
        match c.kind
            ExprKind.Cast =>
                return c.fn_sig
            ExprKind.Member =>
                let f: *StructField = member_field_def(s, c)
                if f != null and f.field_type == TypeKind.Ptr
                    return f.fn_sig
            ExprKind.Call =>
                let fd: *FnDef = find_call_fn(s, c)
                if fd != null and fd.return_type == TypeKind.Ptr
                    return fd.ret_fn_sig
            _ => pass
    return null

# Coerce the struct value `val` produced by `expr` to the named return type
# `dst_name` when the two are the Span$u8 ↔ StrView layout-equivalent pair;
# otherwise return `val` unchanged.  Shared by every struct `ret` site: the
# explicit `return <expr>` path (#168) and the implicit tail-expression return
# in the emit_fn / emit_impl_method epilogue (#1643), where a tail `"no"` in a
# `-> StrView` fn lowered to `ret %StrView <%Span$u8 value>`.
pub fn coerce_struct_ret_value(s: *EmitterState, expr: *Expr, val: i32, dst_name_sv: StrView) -> i32
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_len: i32 = dst_name_sv.len as i32
    var src_name: *u8 = null
    var src_len: i32 = 0
    resolve_expr_struct_name(s, expr, @src_name, @src_len)
    if is_layout_equiv_pair(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (dst_name), len: (dst_len) as i64 }) == 1
        return rebuild_layout_equiv(s, val, StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (dst_name), len: (dst_len) as i64 })
    val

# Best-effort resolve the LLVM struct type-name produced by an expression.
# Writes the name pointer and length into the out-pointers, or null/0 if
# the producer's struct type isn't statically known.  Used to detect
# Span$u8 ↔ StrView layout-equivalence pairs at store/assign sites.
pub fn resolve_expr_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    # Bare "..." literal lowers to %Span$u8 (AGAST #98).
    if e.kind == ExprKind.StringLit
        let lit_sv: StrView = strlit_struct(s)
        *out_name = lit_sv.ptr
        *out_len = lit_sv.len as i32
        return
    # AGAST #2131: a struct-target cast (`"..." as StrView`) emits its
    # operand's register unchanged, so its LLVM type is the operand's.
    # Reporting that lets the store/arg/return coercions rebuild a
    # `%Span$u8` into the `%StrView` the slot expects.
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.Struct
        # AGAST #3004: `r as C` through a reference loads the `%C` itself.
        let reads_referent: fn(*EmitterState, *Expr) -> i32 = s.ref_cast_reads_referent_fn
        if reads_referent(s, e) == 1
            *out_name = e.ident_ptr
            *out_len = e.ident_len
            return
        resolve_expr_struct_name(s, e.left, out_name, out_len)
        return
    # Builtin StrView.as_bytes() -> %Span$u8.
    match e.kind
        ExprKind.Method =>
            if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 1
                *out_name = c"Span$u8"
                *out_len = 7
                return
            # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum.
            qualified_variant_enum(s, e, out_name, out_len)
            if *out_name != null
                return
            # Impl-method call: walk receiver's struct type then impl table.
            var recv_tn: *u8 = null
            var recv_tn_len: i32 = 0
            let rcv: *Expr = e.left
            if rcv != null and rcv.kind == ExprKind.Ident
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 })
                if loc != null and lv_type_name_len(loc) > 0
                    recv_tn = lv_type_name(loc)
                    recv_tn_len = lv_type_name_len(loc)
            if recv_tn != null and recv_tn_len > 0
                var ib: *ImplBlock = s.module.impls
                while ib != null
                    if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (recv_tn), len: (recv_tn_len) as i64 }) == 1
                        var m: *FnDef = ib.methods
                        while m != null
                            if name_eq(StrView { ptr: (m.name), len: (m.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                                if m.return_type == TypeKind.Struct and m.return_type_name_len > 0
                                    *out_name = m.return_type_name
                                    *out_len = m.return_type_name_len
                                return
                            m = m.next
                        return
                    ib = ib.next
            return
        # Local binding to a known struct type.  Gate on `var_type == TypeKind.Struct`
        # — pointer-typed locals (`s: *StrView`, `cstr: *u8`) carry the pointee
        # name in `type_name` (set by param_new for TypeKind.Ptr per ast_helpers.ritz)
        # but their loaded register holds an `i64`, not the struct aggregate.
        # Reporting the struct name in that case fools callers like
        # try_emit_span_to_i64_arg into emitting `extractvalue %StrView i64`.
        # (AGAST #176)
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if loc != null and lv_type_name_len(loc) > 0 and lv_var_type(loc) == TypeKind.Struct
                *out_name = lv_type_name(loc)
                *out_len = lv_type_name_len(loc)
                return
            # AGAST #189 — scalar struct consts (`const FOO: StrView = "..."`)
            # carry the struct type name in the ConstEntry; surface it so the
            # call-site coercion cascade (try_emit_span_to_i64_arg) can match
            # it like any other StrView/Span aggregate when the param is i64-
            # shaped (`@StrView`, `*u8`, etc.).
            let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if ce != null and ce.const_type == TypeKind.Struct and ce.type_name_len > 0
                *out_name = ce.type_name
                *out_len = ce.type_name_len
                return
            # AGAST #1600: a bare unit variant `B` is a value of its enum.
            var vi: i32 = 0
            var other: i32 = 0
            let ei: i32 = bare_unit_variant_enum(s, e, @vi, @other)
            if ei >= 0
                *out_name = enum_name_at(s.mono.pctx, ei, out_len)
            return
        # Function-call return-type lookup.
        ExprKind.Call =>
            # AGAST #1797: a user-enum payload ctor `Holds(x)` is the enum.
            user_variant_ctor_enum(s.mono.pctx, e, out_name, out_len)
            if *out_name != null
                return
            let fdr: *FnDef = find_call_fn(s, e)
            if fdr != null and fdr.return_type == TypeKind.Struct and fdr.return_type_name_len > 0
                *out_name = fdr.return_type_name
                *out_len = fdr.return_type_name_len
            return
        # Struct literal carries its own type name.
        ExprKind.StructLit =>
            if e.ident_ptr != null and e.ident_len > 0
                *out_name = e.ident_ptr as *u8
                *out_len = e.ident_len
            return
        _ => pass

# AGAST #1647: the struct a call or method call returns BY VALUE, so a field
# can be read off it: `mk(true).b`, `p.pair().a`, `Q.make(1).x`.  Writes the
# struct name, or null/0 when the callee or its struct return isn't known.
#
# A method's receiver names its impl as method_recv_type_name resolves it:
# a local, global or type (`Q.make`), a call or method chain (`a.b().c().x`,
# #2594), a field (`self.f.get(1)`) or an element (`self.ws[i].m()`, #3622).
pub fn call_result_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null
        # AGAST #3161: no FnDef, but a built-in Span slice (`s.slice(1, 3).len()`).
        span_builtin_slice_struct(s, e, out_name, out_len)
        # AGAST #3620: or `.unwrap()` / `.unwrap_or(d)` of an Option<S> or
        # Result<S, E>, whose S names the next link of a chain
        # (`r.focused_window().unwrap().raw()`, prism's test_input).
        if *out_len == 0
            unwrap_payload_struct_name(s, e, out_name, out_len)
            if *out_len > 0 and find_struct(s, StrView { ptr: (*out_name), len: (*out_len) as i64 }) == null
                *out_name = null
                *out_len = 0
        return
    if fd.return_type != TypeKind.Struct or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# `init` = `r.unwrap()` / `r.unwrap_or(d)`, r an Option<T> or Result<T, E>:
# the mangled `Option$T` / `Result$T$E` name of that carrier, or null/0.  The
# two payload helpers below share this lookup.  (AGAST #3250 / #2863: the
# `unwrap_or` select is on the payload too, so it types a let the same way.)
fn unwrap_receiver_enum_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if init.kind != ExprKind.Method or init.left == null
        return 0
    let is_unwrap: bool = init.args == null and name_eq(StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }, StrView { ptr: (c"unwrap"), len: (6) as i64 }) == 1
    let is_unwrap_or: bool = init.args != null and init.args.next == null and name_eq(StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }, StrView { ptr: (c"unwrap_or"), len: (9) as i64 }) == 1
    if not is_unwrap and not is_unwrap_or
        return 0
    var enum_name: *u8 = null
    var enum_len: i32 = 0
    call_result_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        resolve_expr_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        return 0
    if not (StrView { ptr: (enum_name), len: (enum_len) as i64 }).starts_with(StrView { ptr: (c"Option$"), len: (7) as i64 }) and not (StrView { ptr: (enum_name), len: (enum_len) as i64 }).starts_with(StrView { ptr: (c"Result$"), len: (7) as i64 })
        return 0
    *out_name = enum_name
    *out_len = enum_len
    1

# AGAST #2594: the struct payload `init` = `r.unwrap()` gives, `r` an
# Option<S> or Result<S, E> (try_emit_enum_unwrap loads it as a `%S`), or
# null/0.  AGAST #3250 / #2863: `r.unwrap_or(d)` gives the same `%S` (its
# select is on `%S`), so `let t = r.unwrap_or(d)` is an `%S` slot too.
pub fn unwrap_payload_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    var enum_name: *u8 = null
    var enum_len: i32 = 0
    if unwrap_receiver_enum_name(s, init, @enum_name, @enum_len) == 0
        return
    # A user-enum payload too (AGAST #3620), as try_emit_enum_unwrap loads it.
    var pay_len: i32 = 0
    let pay: *u8 = tagged_enum_payload_named(s, StrView { ptr: (enum_name), len: (enum_len) as i64 }, @pay_len, 1)
    if pay != null and pay_len > 0
        *out_name = pay
        *out_len = pay_len

# AGAST #4458: the pointer an un-annotated `let x = r.unwrap()` holds when the
# Option / Result payload is a reference or pointer: `Option<@&Font>` gives an
# `@&Font` local, `Option<*T>` a `*T`, exactly as `let x: @&Font = ...`
# declares it.  The #2576 arm only recognised a struct payload, so the slot
# stayed i64: `x.f` was "unhandled EXPR_MEMBER" and passing `x` to a `:& T` /
# `@T` parameter failed borrow_arg_kind.
#
# The payload is the carrier's first mangled argument (`ref_T` / `refmut_T` /
# `ptr_T`, ast_helpers' mangle_type_name spelling), which tagged_enum_arg
# splits off both Option and Result.  Writes the kind (TypeKind.Ref /
# TypeKind.MutRef / TypeKind.Ptr, or TypeKind.PtrPtr for a `ptr_ptr_` payload) and the
# pointee: its name when it is a struct / enum (`@&Font` -> "Font"), else a
# primitive kind with no name, as an annotated local records it.  Returns 1
# when it typed the payload, 0 otherwise (then out_kind is TypeKind.Void).
pub fn unwrap_payload_pointer_type(s: *EmitterState, init: *Expr, out_kind: *TypeKind, out_name: **u8, out_len: *i32, out_pointee: *TypeKind) -> i32
    *out_kind = TypeKind.Void
    *out_name = null
    *out_len = 0
    *out_pointee = TypeKind.Void
    var enum_name: *u8 = null
    var enum_len: i32 = 0
    if unwrap_receiver_enum_name(s, init, @enum_name, @enum_len) == 0
        return 0
    var pay_len: i32 = 0
    let pay: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_len) as i64 }, 0, @pay_len)
    if pay == null or pay_len <= 0
        return 0
    var kind: TypeKind = TypeKind.Void
    var skip: i32 = 0
    if pay_len > 7 and memcmp(pay, c"refmut_", 7) == 0
        kind = TypeKind.MutRef
        skip = 7
    else if pay_len > 4 and memcmp(pay, c"ref_", 4) == 0
        kind = TypeKind.Ref
        skip = 4
    else if pay_len > 4 and memcmp(pay, c"ptr_", 4) == 0
        kind = TypeKind.Ptr
        skip = 4
    else
        return 0
    let base: *u8 = pay + skip
    let base_len: i32 = pay_len - skip
    if base_len <= 0
        return 0
    if base_len > 4 and memcmp(base, c"ptr_", 4) == 0
        # `*T` with T itself a pointer (`**Font`), or a `@**Font` / `@&**Font`.
        let inner: *u8 = base + 4
        let inner_len: i32 = base_len - 4
        if inner_len <= 0
            return 0
        if kind == TypeKind.Ptr
            *out_kind = TypeKind.PtrPtr
            if find_struct(s, StrView { ptr: (inner), len: (inner_len) as i64 }) != null
                *out_name = inner
                *out_len = inner_len
            else if ty_from_name(StrView { ptr: (inner), len: (inner_len) as i64 }) == TypeKind.Void and is_tagged_enum_type(StrView { ptr: (inner), len: (inner_len) as i64 }) == 0 and user_enum_index(s.mono.pctx, StrView { ptr: (inner), len: (inner_len) as i64 }) < 0
                return 0
        else
            *out_kind = kind
        *out_pointee = TypeKind.Ptr
        return 1
    let st: *StructDef = find_struct(s, StrView { ptr: (base), len: (base_len) as i64 })
    if st != null or is_tagged_enum_type(StrView { ptr: (base), len: (base_len) as i64 }) == 1 or user_enum_index(s.mono.pctx, StrView { ptr: (base), len: (base_len) as i64 }) >= 0
        *out_kind = kind
        *out_name = base
        *out_len = base_len
        *out_pointee = TypeKind.Struct
        return 1
    let prim: TypeKind = ty_from_name(StrView { ptr: (base), len: (base_len) as i64 })
    if prim == TypeKind.Void
        return 0
    *out_kind = kind
    *out_pointee = prim
    1

# AGAST #3161: `.slice(lo, hi)` on a `Span<T>` that no FnDef resolves (the
# callers ask only once method_callee_def found none) is try_emit_span_builtin's
# struct operation, whose result is the receiver's own %Span$T: name it, so an
# untyped `let t = s.slice(1, 3)` or a chain `s.slice(1, 3).len()` has a type
# with no ritzlib.span to give one.  The receiver is a local (its type, or its
# pointee for `*Span<T>`) or a call or method call call_result_struct_name
# types (another slice: `s.slice(0, 4).slice(2, 3)`).  Null/0 otherwise.
pub fn span_builtin_slice_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != ExprKind.Method or e.left == null
        return
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"slice"), len: (5) as i64 }) == 0
        return
    if e.args == null or e.args.next == null or e.args.next.next != null
        return
    var recv: *u8 = null
    var recv_len: i32 = 0
    if e.left.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if loc != null
            recv = lv_type_name(loc)
            recv_len = lv_type_name_len(loc)
    else
        call_result_struct_name(s, e.left, @recv, @recv_len)
    if recv == null or not (StrView { ptr: (recv), len: (recv_len) as i64 }).starts_with(StrView { ptr: (c"Span$"), len: (5) as i64 })
        return
    *out_name = recv
    *out_len = recv_len

# AGAST #2870: the pointee a call or method call returns a `*S` of, by the same
# callee resolution: `mkp()[i].f` is element i of what it points at.  Null/0
# otherwise.  A scalar pointee is named too (monomorph's `-> *T` names "i32"):
# find_struct, the caller's, turns it away.
pub fn call_result_pointee_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null or fd.return_type != TypeKind.Ptr or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #2299: the struct S a call returning `*S` points at, so `e[i]` is an
# S in place; null when the callee is unknown or returns anything else.
pub fn call_ptr_elem_struct(s: *EmitterState, e: *Expr) -> *StructDef
    var name: *u8 = null
    var len: i32 = 0
    call_result_pointee_struct(s, e, @name, @len)
    if len <= 0
        return null
    find_struct(s, StrView { ptr: (name), len: (len) as i64 })

# AGAST #2879: the struct S a call or method call returns a `*S` to, so a
# field of its result is a place: `sp(@s).x = 3`, `s.me().arr[2] = 5`.  The
# callee is found as call_result_struct_name finds it; null when it isn't
# known, or returns anything but a pointer to a struct.
pub fn call_result_ptr_struct(s: *EmitterState, e: *Expr) -> *StructDef
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null or fd.return_type_name_len <= 0
        return null
    # AGAST #3015: an `@S` / `@&S` result is S's address too (`deref`'s, whose
    # reference is the receiver of a method reached through `Deref`).
    if fd.return_type != TypeKind.Ptr and fd.return_type != TypeKind.Ref and fd.return_type != TypeKind.MutRef
        return null
    if fd.ret_ptr_array != null
        return null
    find_struct(s, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })

# The FnDef call_result_struct_name resolves `e` to, or null.
pub fn call_callee_def(s: *EmitterState, e: *Expr) -> *FnDef
    if e == null
        return null
    var fd: *FnDef = null
    if e.kind == ExprKind.Call
        fd = find_call_fn(s, e)
    else if e.kind == ExprKind.Method and e.left != null
        # The impl the receiver names, as emit_expr_method dispatches it: a
        # local, global or type (AGAST #2044), a call or method chain (#2295,
        # #2594, #2946, #2883), a field (`self.f.get(1)`) or an element
        # (`self.ws[i].bounds()`, #3622).  One resolver, method_recv_type_name.
        var recv_len: i32 = 0
        let recv: *u8 = method_recv_type_name(s, e, @recv_len)
        if recv != null and recv_len > 0
            var ib: *ImplBlock = s.module.impls
            while ib != null and fd == null
                if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (recv), len: (recv_len) as i64 }) == 1
                    var m: *FnDef = ib.methods
                    while m != null and fd == null
                        if name_eq(StrView { ptr: (m.name), len: (m.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                            fd = m
                        m = m.next
                ib = ib.next
            # AGAST #2726: no impl of that name -- a UFCS helper or a
            # specialized generic impl method, as emit_expr_method dispatches.
            # #2451 makes `v[lo..hi]` the call `v.slice(lo, hi)` (vec_slice$T /
            # span_slice$T), so `v[1..3].len` is a field of this call's result.
            if fd == null
                fd = method_callee_def(s, StrView { ptr: (recv), len: (recv_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    fd

# AGAST #2302: the `-> [N]T` (as a by-value param holds it) of the call `e`,
# or null.  A call through a `fn() -> [N]T` local is typed by its signature, as
# emit_expr's ExprKind.Call arm calls it; a direct, method or static call by its
# FnDef.
pub fn call_ret_array(s: *EmitterState, e: *Expr) -> *Param
    if e == null or (e.kind != ExprKind.Call and e.kind != ExprKind.Method)
        return null
    if e.kind == ExprKind.Call and e.func_name_len > 0 and e.call_type_suffix_len == 0
        let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if lv != null
            return ret_array_of(lv_fn_sig(lv))
    return ret_array_of(call_callee_def(s, e))

# AGAST #175: type-only resolution of an ExprKind.Member chain rooted at an
# identifier (local or global).  Returns the *StructField for the innermost
# field (e.g. for `a.b.c` returns the field for `c`), or null if any link in
# the chain can't be resolved.  Mirrors emit_member_ptr's traversal but
# emits no IR — used by var-decl narrowing to infer pointee types for
# `let x = @a.b.c[i]` so the binding registers as a *Struct with the right
# type_name.  Without this, chained-member addr-of falls through to
# "; ERROR: unhandled EXPR_MEMBER".
pub fn resolve_member_chain_field(s: *EmitterState, e: *Expr) -> *StructField
    if e == null
        return null
    if e.kind != ExprKind.Member
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    match e.left.kind
        ExprKind.Ident =>
            let mloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if mloc != null and lv_type_name_len(mloc) > 0
                if lv_var_type(mloc) == TypeKind.Ptr or lv_var_type(mloc) == TypeKind.PtrPtr or lv_var_type(mloc) == TypeKind.Struct or lv_var_type(mloc) == TypeKind.Ref or lv_var_type(mloc) == TypeKind.MutRef
                    sname = lv_type_name(mloc)
                    sname_len = lv_type_name_len(mloc)
            if sname == null
                let mglob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                if mglob != null and mglob.var_type == TypeKind.Struct and mglob.type_name_len > 0
                    sname = mglob.type_name
                    sname_len = mglob.type_name_len
                # AGAST #4450: `g.f` through a `var g: *S` (or `@S`), as
                # emit_member_ptr reaches it.  Unresolved, an enum field read
                # there was no `%E` to its consumers: `g.f as i32` truncated it
                # as an i64.
                else if mglob != null
                    sname = global_pointee_struct(mglob, @sname_len)
        ExprKind.Member =>
            # Recurse: resolve parent's field, then dereference into the field's struct
            let parent_field: *StructField = resolve_member_chain_field(s, e.left)
            if parent_field != null
                if parent_field.field_type == TypeKind.Struct and parent_field.field_type_name_len > 0
                    sname = parent_field.field_type_name
                    sname_len = parent_field.field_type_name_len
                else if (parent_field.field_type == TypeKind.Ptr or parent_field.field_type == TypeKind.PtrPtr) and parent_field.field_type_name_len > 0
                    sname = parent_field.field_type_name
                    sname_len = parent_field.field_type_name_len
        # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
        ExprKind.Call | ExprKind.Method =>
            call_result_struct_name(s, e.left, @sname, @sname_len)
            # AGAST #2517: `mkp().f`, a field of the struct a `*S` call points
            # at, as emit_member_ptr reaches it (#2879): `mkp().m[1][2]` indexes it.
            if sname == null
                let pst: *StructDef = call_result_ptr_struct(s, e.left)
                if pst != null
                    return member_field_of(s, pst, e)
        # AGAST #2152: `arr[i].f` / `p[i].f` / `o.items[i].f` / `g[i][j].f`.
        ExprKind.Index =>
            index_elem_struct_name(s, e.left, @sname, @sname_len)
        # AGAST #2152: `(*p).f` / `(*w.p).f`.
        _ =>
            if e.left.kind == ExprKind.Unary and e.left.op == OpKind.Deref
                deref_member_base_struct_name(s, e.left.operand, @sname, @sname_len)
    if sname == null or sname_len == 0
        return null
    member_field_of(s, find_struct(s, StrView { ptr: (sname), len: (sname_len) as i64 }), e)

# AGAST #2152: the struct an index expression `ie` yields an element of, for
# a `.field` on it, or null/0.  Type-only; mirrors emit_member_ptr's
# ExprKind.Index arms (an N-D chain with a struct leaf, a struct-array or
# `**S` field, a struct / pointer-to-struct array local, a `*S` local, a
# struct-array global).  Shapes emit_member_ptr does not lower stay null.
pub fn index_elem_struct_name(s: *EmitterState, ie: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if ie == null or ie.kind != ExprKind.Index or ie.left == null
        return
    if index_through_struct(s, ie, out_name, out_len) == 1
        return   # AGAST #2440
    # AGAST #2332: an element of `[N]*S`, whatever holds the array.
    if array_elem_pointee(s, ie, out_name, out_len) == TypeKind.Struct
        return
    if array_elem_pointee(s, ie.left, out_name, out_len) == TypeKind.Struct
        return   # `a[i][j]`
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, ie, @nd_depth)
    if nd_sh != null
        if nd_depth == nd_sh.rank and nd_sh.leaf_type == TypeKind.Struct
            *out_name = nd_sh.leaf_name
            *out_len = nd_sh.leaf_name_len
        return
    let b: *Expr = ie.left
    if b.kind == ExprKind.Member
        let f: *StructField = resolve_member_chain_field(s, b)
        if f == null
            return
        if f.field_type == TypeKind.Array and f.array_elem_type_name_len > 0
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
        else if f.field_type == TypeKind.PtrPtr and f.field_type_name_len > 0
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        # AGAST #3972: an element of a `*S` field, `s.rs[i]`, as emit_member_ptr
        # lowers it.  `let m = @s.rs[0].m` left `m` untyped.
        else if ptr_field_struct_elem(s, f) == 1
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    if b.kind != ExprKind.Ident
        return
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if lv != null
        if lv_type_name_len(lv) <= 0
            return
        let ae: TypeKind = lv_array_elem_type(lv)
        if lv_var_type(lv) == TypeKind.Array and (ae == TypeKind.Struct or ae == TypeKind.Ptr or ae == TypeKind.PtrPtr)
            *out_name = lv_type_name(lv)
            *out_len = lv_type_name_len(lv)
        else if lv_var_type(lv) == TypeKind.Ptr
            *out_name = lv_type_name(lv)
            *out_len = lv_type_name_len(lv)
        return
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if g != null and g.var_type == TypeKind.Array and g.array_elem_type == TypeKind.Struct and g.array_elem_type_name_len > 0
        *out_name = g.array_elem_type_name
        *out_len = g.array_elem_type_name_len
        return
    # AGAST #3671: an element of a module `const T: [N]S = [...]`, which
    # emit_member_ptr reaches like a `[N]S` global.  Unnamed, `T[0].s` typed
    # as i64 (`*(T[0].s + 1)` loaded 8 bytes) and an f32 `T[0].a` as f64.
    let ce: *ConstEntry = const_struct_array_elem(s, ie)
    if ce != null
        *out_name = ce.array_elem_type_name
        *out_len = ce.array_elem_type_name_len

# AGAST #3360: `e` is `A[i]` of a module `const A: [N]S = [...]` that no
# local or global of the name shadows: A's ConstEntry, else null.  Its
# element is a place in the const's read-only data, so a method call on it
# lends it as a global's would; let_check refuses every mutable lend.
pub fn const_struct_array_elem(s: *EmitterState, e: *Expr) -> *ConstEntry
    if e == null or e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Ident
        return null
    if e.right == null or e.right.kind == ExprKind.Range
        return null
    if find_local_idx(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) >= 0 or find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) != null
        return null
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if ce == null or ce.const_type != TypeKind.Array or ce.array_elem_type != TypeKind.Struct or ce.array_elem_type_name_len <= 0
        return null
    # emit_const_array_entry declares `[N x %S]` for a literal or a struct
    # fill (const_struct_fill_global: AGAST #3946, #3978).
    if ce.value_expr == null or (ce.value_expr.kind != ExprKind.ArrayLit and const_struct_fill_global(ce) == 0)
        return null
    ce

# AGAST #2592: the struct `ie` reads by value -- an element of a `[N]S` local,
# global or field, which emit_expr_index loads as a `%S` -- or null/0.  Unlike
# index_elem_struct_name, an element of `[N]*S` or of a `*S` is a pointer, not
# an S, so it names nothing here.
pub fn index_struct_value_name(s: *EmitterState, ie: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if ie == null or ie.kind != ExprKind.Index or ie.left == null or ie.right == null
        return
    if ie.right.kind == ExprKind.Range
        return
    # AGAST #3306: a full-depth chain over an N-D `[..]S` (local, global,
    # field, plane pointer) is the `%S` emit_nd_index_value loads; a row
    # (`g[i]` of `[N][M]S`) is no S, whatever the base's element type says.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, ie, @nd_depth)
    if nd_sh != null
        if nd_depth == nd_sh.rank and nd_sh.leaf_type == TypeKind.Struct and nd_sh.leaf_name_len > 0
            *out_name = nd_sh.leaf_name
            *out_len = nd_sh.leaf_name_len
        return
    let b: *Expr = ie.left
    if b.kind == ExprKind.Member
        let f: *StructField = resolve_member_chain_field(s, b)
        if f != null and f.field_type == TypeKind.Array and f.array_elem_type == TypeKind.Struct and f.array_elem_type_name_len > 0
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
        # AGAST #3972: and an element of a `*S` field, which emit_expr_index
        # loads as the %S.  `let e = h.f[i]` stayed an i64: "unhandled EXPR_MEMBER".
        else if ptr_field_struct_elem(s, f) == 1
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    if b.kind != ExprKind.Ident
        return
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if lv != null
        if lv_var_type(lv) == TypeKind.Array and lv_array_elem_type(lv) == TypeKind.Struct and lv_type_name_len(lv) > 0
            *out_name = lv_type_name(lv)
            *out_len = lv_type_name_len(lv)
        return
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if g != null and g.var_type == TypeKind.Array and g.array_elem_type == TypeKind.Struct and g.array_elem_type_name_len > 0
        *out_name = g.array_elem_type_name
        *out_len = g.array_elem_type_name_len
        return
    # AGAST #1866: an element of a `const T: [N]S` table (`[N]StrView` too),
    # so `let r = T[i]` infers an S as ritz0 does, not "a whole struct".
    let ce: *ConstEntry = const_struct_array_elem(s, ie)
    if ce != null
        *out_name = ce.array_elem_type_name
        *out_len = ce.array_elem_type_name_len

# AGAST #2152: the struct `(*op).field` reads a field of: the pointee of a
# `*S` local or global, or of a `*S` field (`(*w.p).f`), or null/0.
pub fn deref_member_base_struct_name(s: *EmitterState, op: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if op == null
        return
    match op.kind
        ExprKind.Ident =>
            let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (op.ident_ptr), len: (op.ident_len) as i64 })
            if lv != null
                if lv_var_type(lv) == TypeKind.Ptr and lv_type_name_len(lv) > 0
                    *out_name = lv_type_name(lv)
                    *out_len = lv_type_name_len(lv)
                return
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (op.ident_ptr), len: (op.ident_len) as i64 })
            if g != null and g.var_type == TypeKind.Ptr and g.pointee_type == TypeKind.Struct and g.pointee_type_name_len > 0
                *out_name = g.pointee_type_name
                *out_len = g.pointee_type_name_len
            return
        ExprKind.Member =>
            let f: *StructField = resolve_member_chain_field(s, op)
            if f != null and f.field_type == TypeKind.Ptr and f.field_type_name_len > 0
                *out_name = f.field_type_name
                *out_len = f.field_type_name_len
            return
        _ => pass
    # AGAST #3015: `(*S_deref(@b)).f`, a field reached through `Deref` (R17),
    # and any call returning `*S`, `@S` or `@&S`.
    if op.kind == ExprKind.Call or op.kind == ExprKind.Method
        let cst: *StructDef = call_result_ptr_struct(s, op)
        if cst != null
            *out_name = cst.name
            *out_len = cst.name_len



# AGAST #1509 / #2097: type-only N-D array shape resolution (moved here from
# emitter_expr_arith by #2152, since resolve_member_chain_field now needs it
# for an indexed base `g[i][j].m` and nd_array_member_shape needs that).

# The shape of the N-D array an index chain `e` indexes, with the number of
# indices in *out_depth, or null when `e` is not such a chain (base is not a
# local / global N-D array, or the chain is deeper than its rank).  Emits
# nothing, so callers can test before committing to the N-D path.
pub fn nd_index_shape(s: *EmitterState, e: *Expr, out_depth: *i32) -> *ArrayShape
    if e == null or e.kind != ExprKind.Index
        return null
    var depth: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @depth)
    if depth == 0   # AGAST #4122: `a[k]` itself is the plane pointer, no chain
        return null
    var sh: *ArrayShape = nd_array_base_shape(s, base)
    if sh == null
        sh = plane_ptr_shape(s, base)   # AGAST #2570: `q[i][j]`, q a plane pointer
    if sh == null or depth > sh.rank
        return null
    *out_depth = depth
    return sh

# AGAST #3306: the struct S when `e` is a full-depth index chain over an N-D
# `[..]S` (`g[i][j]`, `s.m[i][j]`, `q[i][j]`), whose element is a `%S`
# place; null for a row, a scalar leaf, a leaf naming no struct (#3141) or
# anything else.
pub fn nd_struct_leaf(s: *EmitterState, e: *Expr) -> *StructDef
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth != sh.rank or sh.leaf_type != TypeKind.Struct or sh.leaf_name_len <= 0
        return null
    find_struct(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })

# AGAST #2570: the plane `[M][N]..T` that the local `e` points at, when `e`
# is a plane pointer (LocalVar.pointee_array_shape); null otherwise.  Not in
# nd_array_name_shape: that one says the name IS an array (whole-array
# assignment, argument dims), which a pointer isn't.
# AGAST #2098: `*q` too, the whole `[M][N]..T` q points at, so `(*q)[i][j]` is
# `q[i][j]`.
#
# AGAST #3635: and a `*[N][M]..T` held elsewhere: a field `s.p`, a global `gp`
# or a call `f()` (base_ptr_array, which records the shape), or `*` of one;
# and `*r`, r a `**[N][M]..T` local or param (r itself is no plane pointer).
# emit_plane_ptr loads the pointer each of these is.
pub fn plane_ptr_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null
        return null
    var x: *Expr = e
    var deref: i32 = 0
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        x = e.operand
        deref = 1
    if x.kind == ExprKind.Ident
        let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if lv != null
            # AGAST #4122: `*r` too, r an `@*[N][M]T` / `@&*[N][M]T` local or param.
            if local_holds_plane_ptr(lv) == 1 and deref == 0
                return null
            return lv_pointee_array_shape(lv)
    # AGAST #4122: `a[k]` (and `*a[k]`), a `[K]*[N][M]T` local's element.
    let el: *ArrayShape = elem_plane_ptr_shape(s, x)
    if el != null
        return el
    # AGAST #4122: `*s.q`, `*gq`, `*f()` through a `**[N][M]T` field, global, call.
    if deref == 1
        let held: *ArrayShape = base_plane_ptr_ptr(s, x)
        if held != null
            return held
    let pa: *Param = base_ptr_array(s, x)
    if pa == null or pa.param_type != TypeKind.Ptr
        return null
    pa.param_pointee_array_shape

# AGAST #2098 / #3635: the `ptr` a plane_ptr_shape base `e` is, in a register:
# a local's slot loaded (twice for `*r`, r a `**`), else `e` (or the X of a
# `*X`) evaluated.
pub fn emit_plane_ptr(s: *EmitterState, e: *Expr) -> i32
    var x: *Expr = e
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        x = e.operand
    if x.kind == ExprKind.Ident
        let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if lv != null
            var r: i32 = next_reg(s)
            emit_load_into(s, IR_TY_PTR, r, lv.reg)
            if local_holds_plane_ptr(lv) == 1   # AGAST #4122: a ref too
                let r2: i32 = next_reg(s)
                emit_load_into(s, IR_TY_PTR, r2, r)
                r = r2
            return r
    let v: i32 = emit_expr(s, x)
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, v)
    emit_str(s, c" to ptr\n")
    # AGAST #4122: `*s.q` / `*gq` / `*f()` loads the `*[N][M]T` the `**` holds.
    if x != e and base_plane_ptr_ptr(s, x) != null
        let held: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, held, ptr)
        return held
    ptr

# AGAST #2570: the plane `e`, an index chain two or more short of its N-D
# array's rank, names: the dims after the chain, and the leaf.  `@x[i]` with
# `x: [L][M][N]T` is `[M][N]T`.  null for anything else (a row or an element
# is one or no dimension: other arms type those).
pub fn nd_plane_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth > sh.rank - 2
        return null
    nd_shape_from(sh, depth)

# AGAST #2097: the ArrayShape of an N-D struct field named by the member
# chain `e` (`s.m`, `p.m`, `a.b.m`, local or global), or null.  Type-only:
# emits nothing (resolve_member_chain_field mirrors emit_member_ptr).
pub fn nd_array_member_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != ExprKind.Member
        return null
    let f: *StructField = resolve_member_chain_field(s, e)
    if f == null or f.field_type != TypeKind.Array
        return null
    return f.array_shape

# The N-D array an index chain's base names: a local / global, or a field.
pub fn nd_array_base_shape(s: *EmitterState, base: *Expr) -> *ArrayShape
    if base == null
        return null
    if base.kind == ExprKind.Member
        return nd_array_member_shape(s, base)
    return nd_array_ident_shape(s, base)

# AGAST #1660 — the unit (fieldless) enum an expression's value is, if any.
#
# ritz1 holds a unit-enum value as its `%Enum = type { i8 }` aggregate, never
# as an i64: the qualified-variant ctor (`Kind.A`), an enum-typed param or
# `let` local, an enum-returning call and an enum-typed field load all hand
# back a `%Kind` register.  Callers that would otherwise treat the register as
# i64 (var-decl slot inference, `==` / `!=`) ask this first.  Writes the enum
# name, or null/0 when `e` is not statically a unit enum.  Result$/Option$
# tagged enums are excluded: their aggregate is `{ i8, [N x i8] }`.
pub fn unit_enum_expr_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var name: *u8 = null
    var name_len: i32 = 0
    match e.kind
        ExprKind.Member =>
            # Qualified variant `Kind.A` (same test as emit_expr_member).
            if e.left != null and e.left.kind == ExprKind.Ident
                if is_enum_type(s.mono.pctx, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == 1
                    if enum_variant_index(s.mono.pctx, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
                        name = e.left.ident_ptr as *u8
                        name_len = e.left.ident_len
            # Enum-typed struct field, at any depth / through any pointer.
            if name == null
                let fld: *StructField = resolve_member_chain_field(s, e)
                if fld != null and fld.field_type == TypeKind.Struct and fld.field_type_name_len > 0
                    name = fld.field_type_name
                    name_len = fld.field_type_name_len
        ExprKind.Index =>
            # AGAST #4450: an element read from memory loads the `%Enum` too: of
            # an `[N]E` local, global or field (index_struct_value_name, the `%S`
            # emit_expr_index loads), or `p[i]` through a `*E`, which is
            # `*(p + i)` (deref_pointee_struct_name, the deref arm's name).
            index_struct_value_name(s, e, @name, @name_len)
            if name == null
                ptr_index_user_enum(s, e, @name, @name_len)
        _ =>
            if e.kind == ExprKind.Unary and e.op == OpKind.Deref
                # AGAST #2539 / #4450: `*p`, `*(p + i)` with `p: *E` loads the `%E`.
                if e.operand != null
                    deref_pointee_struct_name(s, e.operand, @name, @name_len)
            else
                resolve_expr_struct_name(s, e, @name, @name_len)
                # AGAST #4450: an enum-typed global (`var g: E`) loads the `%E`, as a
                # local does.  resolve_expr_struct_name types locals only; a local of
                # the name shadows the global.
                if name == null and e.kind == ExprKind.Ident and find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == null
                    let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                    if g != null and g.var_type == TypeKind.Struct and g.type_name_len > 0
                        name = g.type_name
                        name_len = g.type_name_len
                # AGAST #4445: a call's or impl-method's result.  resolve_expr_struct_name's
                # impl walk matches only an exact impl type name, so a monomorphised
                # method (`GMap$i64_i64_slot_state`) on a generic instantiation was never
                # named: `m.slot_state() == GSlot.Full` emitted `icmp eq i64 %<%GSlot>`
                # (clang rejects) and an unannotated `let` kept an i64 slot.  The call
                # resolver also knows the specialised impl methods (method_callee_def).
                if name == null and (e.kind == ExprKind.Call or e.kind == ExprKind.Method)
                    call_result_struct_name(s, e, @name, @name_len)
    if name == null or name_len == 0
        return
    if is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1
        return
    if is_enum_type(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return
    *out_name = name
    *out_len = name_len

# AGAST #4450: the user enum E of `p[i]` read through a pointer base `p`
# that is a `*E` (a local, param, global, field, call or cast), which
# emit_expr_index lowers as `*(p + i)`: the `%E` at E's stride.  null/0 for
# anything else, a range included.
pub fn ptr_index_user_enum(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != ExprKind.Index or e.left == null or e.right == null
        return
    if e.right.kind == ExprKind.Range
        return
    var name: *u8 = null
    var len: i32 = 0
    deref_pointee_struct_name(s, e.left, @name, @len)
    if is_user_enum_name(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }) == 0
        return
    # Only now ask expr_is_pointer: its ptr_arith_elem_size fails closed with
    # an emitter error on a pointee it can't size (`h()[i]` with `h` returning
    # a `*[N]*T`), and this is a probe that every Index read goes through
    # (unit_enum_expr_name).  A base already naming an enum pointee sizes.
    if expr_is_pointer(s, e.left) == 0
        return
    *out_name = name
    *out_len = len

# AGAST #176 — Span$u8 / StrView -> i64 coercion at call-site arg passing.
#
# rzrz (and any caller) passes bare `"..."` literals (which lower to %Span$u8
# per #98) to legacy `*u8` / `i64` params (e.g. `eprints_cstr`).  Without a
# coercion the %Span$u8 aggregate flows straight into the call as
# `call ... (i64 %.span)` and the IR verifier rejects the type mismatch.
#
# Mirrors #168's store-site decompose-and-rebuild but emits a single
# `extractvalue` + `ptrtoint` (we only need the ptr field; len is dropped).
#
# Returns a freshly-allocated i64 register holding the coerced value, or -1
# when no coercion was applied (param isn't pointer/i64-shaped, or the arg
# isn't statically resolvable as Span$u8/StrView — caller falls through to
# its existing branch).  Both Span$u8 and StrView are `{ ptr, i64 }` so the
# extract pattern is identical.
pub fn try_emit_span_to_i64_arg(s: *EmitterState, arg_e: *Expr, param_type: TypeKind, src_reg: i32) -> i32
    # Param must lower to `i64` in the call signature.  TypeKind.Ptr / TypeKind.PtrPtr
    # / TypeKind.Ref emit i64 (see emit_llvm_type); TypeKind.I64 / TypeKind.U64 are i64
    # directly.  TypeKind.MutRef emits `ptr` so it has its own inttoptr branch
    # in the cascade — skip here to avoid double-handling.
    if ty_int_bits(param_type) != 64 and param_type != TypeKind.Ptr and param_type != TypeKind.PtrPtr and param_type != TypeKind.Ref
        return -1
    if arg_e == null
        return -1
    var src_name: *u8 = null
    var src_name_len: i32 = 0
    resolve_expr_struct_name(s, arg_e, @src_name, @src_name_len)
    if src_name == null
        return -1
    if src_name_len == 0
        return -1
    let is_span_u8: i32 = name_eq(StrView { ptr: (src_name), len: (src_name_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 })
    let is_strview: i32 = name_eq(StrView { ptr: (src_name), len: (src_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    if is_span_u8 == 0 and is_strview == 0
        return -1
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (src_name), len: (src_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, src_reg)
    emit_str(s, IR_COMMA_0)
    let pi: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pi)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, p)
    emit_str(s, IR_TO_I64)
    pi

# =============================================================================
# Native-pointer load/store helpers (task #73 migration)
#
# These replace the old pattern:
#     %v = load i64, ptr %slot
#     %p = inttoptr i64 %v to ptr
# with:
#     %p = load ptr, ptr %slot
#
# Per-site migration keeps the cascade contained — each call site can be
# converted independently, with ritz0 tests + "ritz1 compiles trivial" as gate.
# LLVM opaque pointers mean the alloca type doesn't need to change — we can
# load either i64 or ptr from the same `alloca i64` slot.
# =============================================================================

pub fn member_field_def(s: *EmitterState, e: *Expr) -> *StructField
    if e == null or e.kind != ExprKind.Member or e.left == null
        return null
    var recv: *u8 = null
    var recv_len: i32 = 0
    match e.left.kind
        ExprKind.Ident =>
            let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if lv != null
                recv = lv_type_name(lv)
                recv_len = lv_type_name_len(lv)
            else
                let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                if glob != null
                    recv = glob.type_name
                    recv_len = glob.type_name_len
                    # AGAST #1554: `g.f` with `var g: *S` / `@S`.  Unnamed,
                    # `g.items + 1` on an `items: *D` field strode 1 byte, SILENT.
                    if recv == null
                        recv = global_pointee_struct(glob, @recv_len)
                else
                    # AGAST #3824: `K.f` on a struct const.  Unnamed, `K.ptr + 4`
                    # was untyped and `*(K.ptr + 4)` loaded an i64, SILENT.
                    let kce: *ConstEntry = struct_const_global(s, e.left)
                    if kce != null
                        recv = kce.type_name
                        recv_len = kce.type_name_len
        ExprKind.Member =>
            let pf: *StructField = member_field_def(s, e.left)
            var pk: TypeKind = TypeKind.Void
            if pf != null
                pk = pf.field_type
            if pk == TypeKind.Struct or pk == TypeKind.Ptr or pk == TypeKind.Ref or pk == TypeKind.MutRef
                recv = pf.field_type_name
                recv_len = pf.field_type_name_len
        # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
        ExprKind.Call | ExprKind.Method =>
            call_result_struct_name(s, e.left, @recv, @recv_len)
        # AGAST #2332: `a[i].f` with `a: [N]*S`, so `f` has its own type.  #2566: and
        # `a[i].f` with `a: [N]S` by value (a local, global or field), through
        # index_elem_struct_name, which mirrors emit_member_ptr.  Untyped, `a[1].p + 1`
        # on a `p: *i32` stepped one byte, SILENT, and `a[i].vf[j]` found no Vec.
        ExprKind.Index =>
            index_elem_struct_name(s, e.left, @recv, @recv_len)
        # AGAST #2450: `(*p).f`, `(*(p + k)).f`, `(*(v.data)).f`: the struct `*X`
        # loads.  Unresolved, `(*hp).q + 1` on a `q: *i32` stepped one byte.
        _ =>
            if e.left.kind == ExprKind.Unary and e.left.op == OpKind.Deref and e.left.operand != null
                deref_pointee_struct_name(s, e.left.operand, @recv, @recv_len)
                # AGAST #2331: `(*q).f` with `q: **S`, `@*S` or `@&*S`: `*q` is a `*S`,
                # and `.` sees through it.  Untyped, `(*q).data + i` stepped one byte.
                if recv == null and e.left.operand.kind == ExprKind.Ident
                    let dq: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.operand.ident_ptr), len: (e.left.operand.ident_len) as i64 })
                    if dq != null and ptr_to_struct_ptr(dq) == 1
                        recv = lv_type_name(dq)
                        recv_len = lv_type_name_len(dq)
    if recv == null or recv_len <= 0
        return null
    let st: *StructDef = find_struct(s, StrView { ptr: (recv), len: (recv_len) as i64 })
    if st == null
        return null
    let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if idx < 0
        return null
    get_field_type(st, idx)

# Compute size of pointed-to element for pointer arithmetic on a pointer expression.
# Handles identifiers (looks up LocalVar.pointee_type + type_name) and member accesses
# (looks up struct field's pointee info).
#
# AGAST #1451: fails CLOSED.  This used to answer 1 (or 8, via
# get_struct_size_by_name's miss value) for anything it could not resolve,
# and every such guess was a silent wrong address: `let base: *LB` locals
# were registered with pointee TypeKind.I64 and scaled by 8 instead of 16.  An
# unknown pointee is now a located emitter error naming the operand.
fn get_ptr_elem_size(s: *EmitterState, e: *Expr) -> i64
    match e.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if loc == null
                return ptr_elem_size_unknown(s, e.span, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            # For TypeKind.PtrPtr the element is a pointer (8 bytes)
            if lv_var_type(loc) == TypeKind.PtrPtr
                return 8
            if lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.Ref or lv_var_type(loc) == TypeKind.MutRef
                # AGAST #2330, LARB R9: `p + i` on a `*[N]T` walks rows, at stride `[N]T`.
                if lv_pointee_type(loc) == TypeKind.Array and lv_pointee_array_size(loc) > 0
                    var row_len: i32 = 0
                    let row_name: *u8 = array_ptr_elem_name(loc, @row_len)   # #2548
                    let row_elem: i64 = ptr_pointee_size(s, lv_pointee_array_elem_type(loc), StrView { ptr: (row_name), len: (row_len) as i64 })
                    if row_elem > 0
                        return row_elem * (lv_pointee_array_size(loc) as i64)
                let size: i64 = ptr_pointee_size(s, lv_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
                if size > 0
                    return size
            return ptr_elem_size_unknown(s, e.span, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        ExprKind.Member =>
            # AGAST #1673: any member chain (`o.inner.buf.p`), not just `local.f`.
            let field: *StructField = member_field_def(s, e)
            if field != null
                if field.field_type == TypeKind.PtrPtr
                    return 8
                if field.field_type == TypeKind.Ptr or field.field_type == TypeKind.Ref or field.field_type == TypeKind.MutRef
                    # A struct pointee is named by field_type_name; a
                    # primitive one is recorded in array_elem_type
                    # (ast_helpers field_new, AGAST #1304).
                    var fsize: i64 = 0
                    if field.field_type_name_len > 0
                        fsize = ptr_pointee_size(s, TypeKind.Struct, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
                    else
                        fsize = ptr_pointee_size(s, field.array_elem_type, StrView { ptr: (null), len: (0) as i64 })
                    if fsize > 0
                        return fsize
            return ptr_elem_size_unknown(s, e.span, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        _ => pass
    emit_ir_error(s, e.span, c"pointer arithmetic: element size of pointee unknown for a non-name operand")
    return 1

# AGAST #2332: U when `x` is an element of a `[N]*U` array (local, param, global,
# or field at any depth, N-D too) or that element `+ k`, with a struct U's name in
# *out_name / *out_len.  TypeKind.Void for anything else, so an integer `a[i] + 1`
# stays an integer.  `p[i]` through a `*[N]*U` is such an element too (#2522); a
# `[N]**U` element is ptr_levels_of's.
pub fn array_elem_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> TypeKind
    *out_name = null
    *out_len = 0
    var b: *Expr = x
    while b != null and b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
        if is_ptr_distance(s, b) == 1
            return TypeKind.Void
        b = b.left
    var elem: TypeKind = TypeKind.Void
    var pointee_slot: i32 = 0
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, b, @elem, @pointee_slot, @name, @name_len)
    let pointee: TypeKind = ptr_slot_flat(pointee_slot)
    elem_recorded_pointee(s, elem, pointee, StrView { ptr: (name), len: (name_len) as i64 }, out_name, out_len)

# What the array that `b` = `a[i]` indexes records of its element: the element's
# kind, what it points at (U for `[N]*U`, the packed inner-pointee slot for
# `[N]**U`, AGAST #2376) and the struct name.  TypeKind.Void in *out_elem when `b`
# isn't a whole element of a recorded array.
pub fn array_elem_record(s: *EmitterState, b: *Expr, out_elem: *TypeKind, out_pointee: *i32, out_name: **u8, out_len: *i32)
    *out_elem = TypeKind.Void
    *out_pointee = (TypeKind.Void as i32)
    *out_name = null
    *out_len = 0
    if b == null or b.kind != ExprKind.Index or b.left == null
        return
    if b.right != null and b.right.kind == ExprKind.Range
        return
    # AGAST #2522: `p[i]` through a `*[N]*U`, `@[N]*U` or `@&[N]*U` is an element of
    # the array behind it (LARB R9), and its `**U` view records U.  Without this
    # `*p[i] = v` stored 8 bytes into a U, and `p[i][j]` / `p[i] + k` had no stride.
    let view: *LocalVar = index_through(s, b)
    if view != null and lv_is_array_view(view) == 1
        if lv_var_type(view) == TypeKind.PtrPtr
            *out_elem = TypeKind.Ptr
            *out_pointee = lv_inner_pointee_type(view)
            *out_name = lv_type_name(view)
            *out_len = lv_type_name_len(view)
        return
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, b, @depth)
    if sh != null
        if depth == sh.rank
            *out_elem = sh.leaf_type
            *out_pointee = (sh.leaf_pointee as i32)
            *out_name = sh.leaf_name
            *out_len = sh.leaf_name_len
    else
        match b.left.kind
            ExprKind.Member =>
                let f: *StructField = resolve_member_chain_field(s, b.left)
                if f != null and f.field_type == TypeKind.Array
                    *out_elem = f.array_elem_type
                    *out_pointee = (f.array_elem_pointee as i32)
                    *out_name = f.array_elem_type_name
                    *out_len = f.array_elem_type_name_len
            ExprKind.Ident =>
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                if loc != null
                    if lv_var_type(loc) == TypeKind.Array
                        *out_elem = lv_array_elem_type(loc)
                        *out_pointee = (lv_array_elem_pointee(loc) as i32)
                        *out_name = lv_type_name(loc)
                        *out_len = lv_type_name_len(loc)
                else
                    let g: *GlobalVarDef = find_global(s, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                    if g != null and g.var_type == TypeKind.Array
                        *out_elem = g.array_elem_type
                        *out_pointee = (g.array_elem_pointee as i32)
                        *out_name = g.array_elem_type_name
                        *out_len = g.array_elem_type_name_len
                    else
                        # AGAST #1866: an element of a `const T: [N]*U` table.  Without
                        # this `*(T[i] + 1)` loaded an i64, not a U.
                        let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                        if ce != null and ce.const_type == TypeKind.Array
                            *out_elem = ce.array_elem_type
                            *out_pointee = (ce.array_elem_pointee as i32)
                            *out_name = ce.array_elem_type_name
                            *out_len = ce.array_elem_type_name_len
            _ => pass

# AGAST #2369: what `x` = `a[i]` refers to when `a` is an `[N]@U` or `[N]@&U`,
# as array_elem_pointee answers for an `[N]*U`.  Apart from it because a
# reference has no arithmetic or index of its own (LARB R9): only `.` reaches
# through one, so only the member paths ask.
pub fn array_elem_referent(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> TypeKind
    var elem: TypeKind = TypeKind.Void
    var pointee_slot: i32 = 0
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, x, @elem, @pointee_slot, @name, @name_len)
    let pointee: TypeKind = ptr_slot_flat(pointee_slot)
    if elem != TypeKind.Ref and elem != TypeKind.MutRef
        *out_name = null
        *out_len = 0
        return TypeKind.Void
    elem_recorded_pointee(s, TypeKind.Ptr, pointee, StrView { ptr: (name), len: (name_len) as i64 }, out_name, out_len)

# array_elem_pointee, when the caller doesn't need a struct's name.
pub fn array_elem_pointee_kind(s: *EmitterState, x: *Expr) -> TypeKind
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_pointee(s, x, @name, @name_len)

# AGAST #2928 / #2597: 1 when `e` is `q - p` on two pointers.  That's a distance
# (LANGUAGE_SPEC §7.1 "Pointer difference"): an i64 count of elements, with no
# stride of its own, so `(q - p) + 1` is one more.  #2332 had this for `a[i] - q`
# with `a: [N]*T` only, and in bytes; every other pair was `q - p * sizeof(T)`.
# The right operand is checked first: it's what tells `p - n` from `q - p`, and
# it keeps a long `a - b - c` integer chain from re-walking its left side.
pub fn is_ptr_distance(s: *EmitterState, e: *Expr) -> i32
    if e.kind != ExprKind.Binary or e.op != OpKind.Sub
        return 0
    if expr_is_pointer(s, e.right) == 0
        return 0
    expr_is_pointer(s, e.left)

# 1 when `x` is a pointer value: one ptr_arith_elem_size strides, an element of
# a `[N]*T` array, or anything get_expr_type types as a pointer or reference.
pub fn expr_is_pointer(s: *EmitterState, x: *Expr) -> i32
    if x == null
        return 0
    if array_elem_pointee_kind(s, x) != TypeKind.Void or ptr_arith_elem_size(s, x) != 0
        return 1
    let t: TypeKind = expr_slot_ty(x)
    (t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef) as i32

# AGAST #2332: 1 when `e` is `a[i][j]` over an `a: [N]*T` element.  That's a
# pointer index, not an array's, and elem_index_as_deref lowers it.
pub fn is_array_elem_index(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Index
        return 0
    (array_elem_pointee_kind(s, e.left) != TypeKind.Void) as i32

# AGAST #3058: 1 when `e` is `b[i][j]` over a `b: [N]**T` element (or deeper),
# which indexes the `**T` b[i] as a pointer: `*(b[i] + j)`.  A range isn't one.
pub fn is_ptr_ptr_elem_index(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Index
        return 0
    if e.right == null or e.right.kind == ExprKind.Range
        return 0
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    (ptr_levels_of(s, e.left, @inner, @name, @name_len) >= 2) as i32

# AGAST #3052: the S of `p[i]` with `p` a `*S` local (or param), as `*(p + i)`
# loads it (#2542), into `*out_name` / `*out_len`; null/0 for anything else.  A
# range isn't one.  The name is deref_pointee_struct_name's, so a tagged enum
# pointee answers too.
pub fn ptr_local_struct_index(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Ident
        return
    if e.right == null or e.right.kind == ExprKind.Range
        return
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if lv == null or lv_var_type(lv) != TypeKind.Ptr or lv_pointee_type(lv) != TypeKind.Struct
        return
    deref_pointee_struct_name(s, e.left, out_name, out_len)

# Fill `sum` and `deref` with `*(a[i] + j)` for `e` = `a[i][j]`, so the load and
# the store take the `*` paths: one width and one stride, struct T included.
pub fn elem_index_as_deref(s: *EmitterState, e: *Expr, sum: *Expr, deref: *Expr)
    sum.kind = ExprKind.Binary
    sum.slot_type = TypeKind.Void      # AGAST #3225: no wider slot yet
    sum.span = e.span
    sum.op = OpKind.Add
    sum.left = e.left
    sum.right = e.right
    sum.next = null
    deref.kind = ExprKind.Unary
    deref.span = e.span
    deref.op = OpKind.Deref
    deref.operand = sum
    deref.next = null
    # AGAST #4410: these nodes never meet Sema's walk, so note the slots the
    # emit path reads: the `+` keeps its left operand's pointer slot, and the
    # deref is the element `e` names (formerly get_expr_type's answer).
    if e.left != null
        expr_note_sema_ty(sum, expr_slot_ty(e.left))
    # The deref is its element: array_elem_pointee_kind on the `+ k` operand
    # (formerly get_expr_type's answer); i64 is its default.
    let dpt: TypeKind = array_elem_pointee_kind(s, sum)
    expr_note_sema_ty(deref, dpt)

# AGAST #1924: the static pointer type of `x`, as a level count plus the
# innermost pointee.  Returns the levels (1 = `*T`, 2 = `**T`, 3 = `***T`)
# and writes T to *out_inner and, for a struct T, its name to *out_name /
# *out_len.  0 when unknown.
#
# Only shapes rooted in a recorded `**T` (or deeper) answer: an identifier
# (local, param, global) or a struct field at any member-chain depth, then
# `y + k` / `y - k` (same type as y) and `*y` (one level fewer).  So
# `*(*(h.rows + i) + k)`, `*(*(*(ppp + i) + j) + k)` and `*(g + i) + k`
# all resolve.  A plain `*T` base answers 0: the callers already handle it.
#
# #1815 / #1941 resolved identifier bases only, exactly two levels deep, so
# a `**T` field, a `***T`, a global `**S` and a monomorphised `**T` param
# still loaded i64 and stepped one byte.
pub fn ptr_levels_of(s: *EmitterState, x: *Expr, out_inner: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    *out_inner = TypeKind.Void
    *out_name = null
    *out_len = 0
    if x == null
        return 0
    match x.kind
        ExprKind.Binary =>
            if x.op == OpKind.Add or x.op == OpKind.Sub
                return ptr_levels_of(s, x.left, out_inner, out_name, out_len)
            return 0
        ExprKind.Unary =>
            if (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null and x.operand.kind == ExprKind.Index
                return addr_of_elem_levels(s, x.operand, out_inner, out_name, out_len)
            if x.op != OpKind.Deref or x.operand == null
                return 0
            let sub: i32 = ptr_levels_of(s, x.operand, out_inner, out_name, out_len)
            if sub < 2
                *out_inner = TypeKind.Void
                *out_name = null
                *out_len = 0
                return 0
            return sub - 1
        _ => pass
    var slot: i32 = (TypeKind.Void as i32)
    var name: *u8 = null
    var name_len: i32 = 0
    match x.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if loc != null
                # AGAST #3079: an `@*T` / `@&*T` is as deep as a `**T` and packs T
                # the same way (`let r = @q` of a `*E`: `**r = E.B` stores an %E).
                if lv_var_type(loc) != TypeKind.PtrPtr and ref_to_ptr(loc) == 0
                    return 0
                slot = lv_inner_pointee_type(loc)
                name = lv_type_name(loc)
                name_len = lv_type_name_len(loc)
            else
                let glob: *GlobalVarDef = find_global(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
                if glob == null or glob.var_type != TypeKind.PtrPtr
                    return 0
                slot = glob.inner_pointee_type
                name = glob.pointee_type_name
                name_len = glob.pointee_type_name_len
        ExprKind.Member =>
            let fld: *StructField = member_field_def(s, x)
            if fld == null or fld.field_type != TypeKind.PtrPtr
                return 0
            slot = fld.inner_pointee_type
            name = fld.field_type_name
            name_len = fld.field_type_name_len
        ExprKind.Index =>
            # AGAST #2376: an element of a `[N]**T` array, which records T packed.
            var elem: TypeKind = TypeKind.Void
            array_elem_record(s, x, @elem, @slot, @name, @name_len)
            if elem != TypeKind.PtrPtr
                return 0
        ExprKind.Cast =>
            # AGAST #2544: `x as **S`, whose slot cast_tail_new records.
            if x.type_kind != TypeKind.PtrPtr
                return 0
            slot = x.cast_ptr_kind
            name = x.ident_ptr
            name_len = x.ident_len
        ExprKind.Call | ExprKind.Method =>
            # AGAST #2544: `f()` with `f() -> **S`.  The FnDef names S with a
            # `ptr_` per level past two (monomorph's spelling, #2791); only a
            # struct S is recorded by name, so a `-> **u8` answers 0.
            # AGAST #4537: `(*((w.as_ptr()) + 1)).b` roots the same `**S` at a
            # method call, which call_fn_def dispatches as it does a call.
            let fd: *FnDef = call_fn_def(s, x)
            if fd == null or fd.return_type != TypeKind.PtrPtr or fd.return_type_name == null
                return 0
            name = fd.return_type_name
            name_len = fd.return_type_name_len
            var extra: i32 = 0
            while name_len > 4 and memcmp(name, c"ptr_", 4) == 0
                name = name + 4
                name_len = name_len - 4
                extra = extra + 1
            if find_struct(s, StrView { ptr: (name), len: (name_len) as i64 }) == null
                return 0
            slot = ptr_slot_deepen((TypeKind.Struct as i32), extra)
        _ =>
            return 0
    let levels: i32 = ptr_ptr_slot_levels(slot)
    if levels < 2
        return 0
    let inner: TypeKind = ptr_ptr_slot_inner(slot)
    *out_inner = inner
    # A primitive `**u8` param still carries a stale parser type name.
    if inner == TypeKind.Struct
        *out_name = name
        *out_len = name_len
    return levels

# AGAST #2575 / #2598: the pointee of `x` when it is pointer arithmetic on a
# `*T`: `y + k` or `y - k` down the left spine (as ptr_arith_elem_size reads a
# chain), rooted in a call returning `*T` (`vec_as_ptr<E>(@v) + 1`,
# `mkp() + 1`) or a `*T` local or param (`p + 1`).  Returns TypeKind.Struct and
# writes the struct's name for a `*S`, the primitive kind (TypeKind.I32, ...) for
# a scalar `*T`, else 0.  An un-annotated `let e = <x>` takes `*T` from it, as
# if annotated.  It was an i64 with no pointee: `e.b` was "unhandled
# ExprKind.Member", `*e = v` stored 8 bytes whatever T was, and `e + 1` stepped
# one byte (#2598, silently).
pub fn ptr_arith_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> TypeKind
    *out_name = null
    *out_len = 0
    if x == null or x.kind != ExprKind.Binary or (x.op != OpKind.Add and x.op != OpKind.Sub)
        return TypeKind.Void
    # `q - p` of two pointers is a count, not a pointer.
    if x.op == OpKind.Sub and (ptr_arith_elem_size(s, x.right) != 0 or ptr_root_pointee(s, x.right, out_name, out_len) != TypeKind.Void)
        *out_name = null
        *out_len = 0
        return TypeKind.Void
    if x.left.kind == ExprKind.Binary
        return ptr_arith_pointee(s, x.left, out_name, out_len)
    ptr_root_pointee(s, x.left, out_name, out_len)

# The pointee of `x` when it is a call returning `*T` or a `*T` local or
# param: TypeKind.Struct (name written) for a `*S`, the primitive kind for a
# scalar `*T`, else 0.
pub fn ptr_root_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> TypeKind
    var name: *u8 = null
    var name_len: i32 = 0
    # AGAST #4537: a method call returning `*T` is the same root as a call
    # (`let e = v.as_ptr() + 1` after ritzlib's vec_as_ptr became a method).
    # `call_fn_def` dispatches both the call and the method (AGAST #4060).
    match x.kind
        ExprKind.Call | ExprKind.Method =>
            return fn_ptr_return_pointee(s, call_fn_def(s, x), out_name, out_len)
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if loc == null
                return TypeKind.Void
            # An inferred `let q = @x[i]` is an `@T` and doesn't step (LARB R20).
            if lv_var_type(loc) != TypeKind.Ptr
                return TypeKind.Void
            if primitive_name_len(lv_pointee_type(loc)) > 0
                return lv_pointee_type(loc)
            name = lv_type_name(loc)
            name_len = lv_type_name_len(loc)
        # AGAST #2596: a `*T` field at any depth, `v.data` of a `Vec<E>`.  A
        # struct pointee is named by field_type_name, a primitive one recorded in
        # array_elem_type (#1304), as ptr_arith_elem_size reads it.
        ExprKind.Member =>
            let fld: *StructField = member_field_def(s, x)
            if fld == null or fld.field_type != TypeKind.Ptr
                return TypeKind.Void
            if fld.field_type_name_len == 0
                if primitive_name_len(fld.array_elem_type) > 0
                    return fld.array_elem_type
                return TypeKind.Void
            name = fld.field_type_name
            name_len = fld.field_type_name_len
        # AGAST #3204: `p as *T`, the step R20 (#3106) gives an `@T`.  The parser
        # records the pointee on the cast (cast_ptr_kind = kind, ident_ptr = struct
        # name; apply_cast_tail), so `let q = (p as *C) + 1` is a `*C`, as
        # `let q = p as *C` already was.  It was an i64: `q.x` "unhandled
        # ExprKind.Member", `*q` an 8-byte load.
        ExprKind.Cast =>
            if x.type_kind != TypeKind.Ptr
                return TypeKind.Void
            let ck: TypeKind = ptr_slot_flat(x.cast_ptr_kind)
            if primitive_name_len(ck) > 0
                return ck
            if ck != TypeKind.Struct
                return TypeKind.Void
            name = x.ident_ptr
            name_len = x.ident_len
        _ =>
            return TypeKind.Void
    # AGAST #4450: a user enum pointee is named as a struct's is.
    if is_elem_aggregate_name(s, StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return TypeKind.Void
    *out_name = name
    *out_len = name_len
    TypeKind.Struct

# The FnDef a call `f()` (find_call_fn) or, AGAST #4060, a method call
# `b.m()` (method_call_def) dispatches to; null for any other expression.
pub fn call_fn_def(s: *EmitterState, x: *Expr) -> *FnDef
    match x.kind
        ExprKind.Call =>
            return find_call_fn(s, x)
        ExprKind.Method =>
            return method_call_def(s, x)
        _ => pass
    null

# AGAST #2376:`@a[i]` points at an element that is itself a pointer: a `**U`
# for `a: [N]*U`, one level more than the element for `a: [N]**U`.  0 for any
# other element, which isn't a pointer to pointer.
fn addr_of_elem_levels(s: *EmitterState, x: *Expr, out_inner: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    var elem: TypeKind = TypeKind.Void
    var pointee: i32 = (TypeKind.Void as i32)
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, x, @elem, @pointee, @name, @name_len)
    if elem == TypeKind.Ptr
        let u: TypeKind = elem_recorded_pointee(s, elem, ptr_slot_flat(pointee), StrView { ptr: (name), len: (name_len) as i64 }, out_name, out_len)
        if u == TypeKind.Void
            return 0
        *out_inner = u
        return 2
    if elem != TypeKind.PtrPtr or ptr_ptr_slot_levels(pointee) < 2
        return 0
    *out_inner = ptr_ptr_slot_inner(pointee)
    if *out_inner == TypeKind.Struct
        *out_name = name
        *out_len = name_len
    ptr_ptr_slot_levels(pointee) + 1

# AGAST #1815: the element a `*(pp + i)` (or `*pp`) points at, when that is
# a primitive T: `*(*(pp + i) + k)` loads a T and `*(pp + i) + k` strides by
# sizeof(T).  TypeKind.Void when unknown (not a deref, a struct T, or itself a
# pointer, which loads and stores as i64 anyway) — callers keep their
# previous behaviour then.  AGAST #1924: any base ptr_levels_of resolves.
#
# ritz1's own enum tracker read its `**u8` name table this way under
# self-hosting and got `load i64` for each byte, so it carried a "load each
# byte through an explicit let" workaround (ast_helpers.ritz) for years.
fn deref_ptr_ptr_elem_type(s: *EmitterState, d: *Expr) -> TypeKind
    if d == null or d.kind != ExprKind.Unary or d.op != OpKind.Deref or d.operand == null
        return TypeKind.Void
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1
        return TypeKind.Void
    if inner == TypeKind.Struct or ptr_pointee_size(s, inner, StrView { ptr: (null), len: (0) as i64 }) == 0
        return TypeKind.Void
    return inner

# AGAST #3186: the scalar T an element `x[i]` points at when `x` is a `**T`
# (exactly two levels), or TypeKind.Void: not that shape, or T is a struct
# (deref_pointee_struct_name names those) or has no known size.
fn ptr_ptr_index_scalar(s: *EmitterState, x: *Expr) -> TypeKind
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, x, @inner, @name, @name_len) != 2
        return TypeKind.Void
    if inner == TypeKind.Struct or ptr_pointee_size(s, inner, StrView { ptr: (null), len: (0) as i64 }) == 0
        return TypeKind.Void
    return inner

# AGAST #2537: the scalar T that `(*r)[i]` reads when `*r` is a `*T` (`r: **T`,
# a `let r = @q` or a `**T` param).  emit_expr_index fell to its byte path for
# it (`getelementptr i8` + `load i8`) whatever T was, while `*(*r + k)` already
# had T's stride.  TypeKind.Void when not that shape, or T isn't a scalar, or the
# index is a range (refused before this is asked).
pub fn deref_index_elem(s: *EmitterState, e: *Expr) -> TypeKind
    if e == null or e.kind != ExprKind.Index or e.left == null
        return TypeKind.Void
    if e.right != null and e.right.kind == ExprKind.Range
        return TypeKind.Void
    let t: TypeKind = deref_ptr_ptr_elem_type(s, e.left)
    if ty_int_in(t, 8, 32) == 1
        return t
    if ty_int_bits(t) == 64 or t == TypeKind.F32 or t == TypeKind.F64 or t == TypeKind.Bool
        return t
    return TypeKind.Void

# AGAST #1941 / #1924: the element stride of a pointer-valued `*y`, for
# `*pp + 1` / `*(pp + i) + k`: sizeof(T) when `*y` is a `*T` (struct T
# included: sizeof(S)), 8 when it is itself a pointer to pointer
# (`*ppp + 1` with `ppp: ***S`, #1944).  0 when not that shape, which
# ptr_arith_elem_size reads as "not a pointer" (a raw byte add).
fn deref_ptr_ptr_stride(s: *EmitterState, d: *Expr) -> i64
    if d == null or d.kind != ExprKind.Unary or d.op != OpKind.Deref or d.operand == null
        return 0
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    let levels: i32 = ptr_levels_of(s, d, @inner, @name, @name_len)
    if levels >= 2
        return 8
    if levels == 1
        return ptr_pointee_size(s, inner, StrView { ptr: (name), len: (name_len) as i64 })
    return 0

# AGAST #1924: the struct S that a pointer-valued `*y` points at (`*(pp + i)`
# with `pp: **S`, `*(t.cells + i)` with a `**S` field, `*g`), so
# `*(*(pp + i) + k)` loads `%S` and `(*(*(pp + i) + k)).f` resolves.
# Writes null/0 when not that shape.
pub fn deref_ptr_ptr_struct_name(s: *EmitterState, d: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if d == null or d.kind != ExprKind.Unary or d.op != OpKind.Deref or d.operand == null
        return
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1 or inner != TypeKind.Struct
        return
    *out_name = name
    *out_len = name_len

# Classify an operand of `+`/`-` as pointer arithmetic, and if so give its
# element stride.  Returns 0 for "not a pointer", otherwise the element size
# in bytes (never 0, so 0 is an unambiguous sentinel).
#
# AGAST #1361.  This was previously inline in emit_expr_binary and handled
# exactly two shapes: ExprKind.Ident (`p + i`) and ExprKind.Member (`s.ptr + i`).
# An unparenthesised chain associates to the left:
#
#     lines.data + i - 1   ==   SUB( ADD( MEMBER(lines,data), i ), 1 )
#
# so the outer SUB's left operand is ExprKind.Binary, matched neither arm, and
# the `- 1` was emitted as a raw BYTE subtraction.  For a 16-byte element
# that lands 15 bytes short and every field load reads across the element
# boundary.  It does not crash — it silently computes a wrong address, which
# is how `tier2_stdlib/14_uniq` shipped passing every line through instead of
# deduplicating for as long as ritz1 has existed.
#
# The recursion is deliberately down the LEFT spine only: `p + i` is a
# pointer, `i + p` is not treated as one here (that asymmetry is pre-existing
# and shared with the two original arms).  Pointer DIFFERENCE (`p - q`, which
# yields an integer, not a pointer) is likewise still mis-scaled — but it was
# already mis-scaled at depth 0 before this change, so propagating the same
# classification through a chain keeps behaviour consistent rather than
# introducing a second, differently-wrong rule.  Tracked separately.
pub fn ptr_arith_elem_size(s: *EmitterState, e: *Expr) -> i64
    match e.kind
        ExprKind.Ident =>
            let lt: TypeKind = find_local_type(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if lt == TypeKind.Ptr or lt == TypeKind.PtrPtr or lt == TypeKind.Ref or lt == TypeKind.MutRef
                return get_ptr_elem_size(s, e)
            if lt == TypeKind.Unknown
                # Global pointer var: the ident isn't a local (find_local_type
                # returns TypeKind.Unknown since AGAST #1328; it used to return a
                # TypeKind.I64 miss value, so this arm previously also ran for real
                # i64 locals that shadow a global — now it is miss-only).
                # Without this branch, `*(g_arr + i) = ...` for `var g_arr: *T`
                # emits raw `add i64 base, i` (no stride), then stores i64 —
                # wrong for *i32 globals (which the monomorph instantiation
                # tracker uses heavily).  Was the source of the selfhost 8-test
                # gap (vec_push\$T not specialized → declare i64 extern instead
                # of `define i32`).
                let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if glob != null
                    if glob.var_type == TypeKind.PtrPtr
                        return 8
                    let grow: i64 = base_ptr_array_row_size(s, e)   # AGAST #2304
                    if grow > 0
                        return grow
                    if glob.var_type == TypeKind.Ptr or glob.var_type == TypeKind.Ref or glob.var_type == TypeKind.MutRef
                        # AGAST #2034: size the pointee with ptr_pointee_size, the
                        # table locals and params use.  This arm used to list
                        # only the integer widths, so `g + 1` on a `*f32` / `*f64`
                        # global stepped one byte.  `*S` globals are sized by
                        # emit_expr_binary's deref_pointee_struct_name first; an
                        # unknown pointee keeps the old 1-byte stride.
                        let gsz: i64 = ptr_pointee_size(s, glob.pointee_type, StrView { ptr: (null), len: (0) as i64 })
                        if gsz > 0
                            return gsz
                        return 1
            return 0
        ExprKind.Member =>
            # Member field access — check if the field is a pointer type.
            # AGAST #1673: at any chain depth.  `o.mid.buf.p + 1` used to match
            # only `local.f` and fall through to a raw BYTE add for an *i32.
            let fld: *StructField = member_field_def(s, e)
            if fld != null
                let frow: i64 = base_ptr_array_row_size(s, e)   # AGAST #2304
                if frow > 0
                    return frow
                if fld.field_type == TypeKind.Ptr or fld.field_type == TypeKind.PtrPtr or fld.field_type == TypeKind.Ref or fld.field_type == TypeKind.MutRef
                    return get_ptr_elem_size(s, e)
            return 0
        ExprKind.Binary =>
            # A chain: `(ptr ± a) ± b`.  The inner result is a pointer iff the
            # inner expression was itself pointer arithmetic, and it carries the
            # same stride.
            if e.op == OpKind.Add or e.op == OpKind.Sub
                if is_ptr_distance(s, e) == 1
                    return 0   # AGAST #2928: `q - p` is a count, not a pointer
                return ptr_arith_elem_size(s, e.left)
            return 0
        ExprKind.Index =>
            # AGAST #2332: `a[i] + k` with `a: [N]*T` strides by sizeof(T).
            var ae_name: *u8 = null
            var ae_len: i32 = 0
            let ae: TypeKind = array_elem_pointee(s, e, @ae_name, @ae_len)
            # AGAST #3058: `b[i] + k` with `b: [N]**T` steps a pointer, 8 bytes.  It
            # was a raw byte add, so `b[i][1]` read 1 byte into b[i]'s first pointer.
            if ae == TypeKind.Void
                var pp_inner: TypeKind = TypeKind.Void
                if ptr_levels_of(s, e, @pp_inner, @ae_name, @ae_len) >= 2
                    return 8
            return ptr_pointee_size(s, ae, StrView { ptr: (ae_name), len: (ae_len) as i64 })
        ExprKind.Unary =>
            # AGAST #1603: `@arr[i] + n`.  The address of an indexed element is a
            # pointer to that element, so it strides by the element size.  Without
            # this arm the sum classified as "not a pointer" and `+ n` was a raw
            # BYTE offset — `@arr[0] + 2` on a [4]i32 landed half-way into
            # element 0.  (`let q: *i32 = @arr[0]` then `q + 2` was always fine:
            # q is an identifier with a recorded pointee.)
            if (e.op == OpKind.Addr or e.op == OpKind.AddrMut) and e.operand != null and e.operand.kind == ExprKind.Index
                return index_elem_size(s, e.operand)
            # AGAST #1815 / #1941 / #1924: `*(pp + i) + k` for `pp: **T`
            # strides by sizeof(T) (sizeof(S) for `**S`, 8 for `***T`), whatever
            # the base: local, param, global or struct field.
            return deref_ptr_ptr_stride(s, e)
        ExprKind.Call | ExprKind.Method =>
            # AGAST #2540: `f() + k` with `f() -> *T` strides by sizeof(T).  It
            # was a raw byte add, so `*(ident(p) + 2)` on a `*i32` read 2 bytes
            # in.  capture_fn_return_type names a primitive pointee ("i32") on
            # return_type_name (#1984); a struct pointee names the struct.
            # AGAST #4060: and `b.m() + k`, a method returning `*T` / `**T`.
            let fd: *FnDef = call_fn_def(s, e)
            if fd == null
                return 0
            if fd.return_type == TypeKind.PtrPtr
                return 8
            if fd.return_type != TypeKind.Ptr
                return 0
            let rp: TypeKind = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            var csz: i64 = 0
            if rp != TypeKind.Void   # primitive_type_from_name's miss value
                csz = ptr_pointee_size(s, rp, StrView { ptr: (null), len: (0) as i64 })
            else
                csz = ptr_pointee_size(s, TypeKind.Struct, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            # AGAST #2791: the call IS a pointer, so 0 ("not a pointer") would
            # be a raw byte add.  Fail closed (#1451), as a local's stride does.
            if csz > 0
                return csz
            return ptr_elem_size_unknown(s, e.span, StrView { ptr: (fd.name), len: (fd.name_len) as i64 })
        _ => pass
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.Ptr
        # AGAST #2540: `(x as *T) + k`.  apply_cast_tail records the pointee
        # kind on int_val and a struct pointee's name on ident_ptr (#1453).
        return ptr_pointee_size(s, ptr_slot_flat(e.cast_ptr_kind), StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.PtrPtr
        # AGAST #3834: `(x as **T) + k` steps a pointer, 8 bytes, as a
        # `**T` local or global does.  It was a raw byte add, so
        # `*((x as **T) + 1)` loaded a pointer from 1 byte in: a SIGSEGV.
        return 8
    # AGAST #4475: `c"..." + i` is arithmetic on a `*u8` (stride 1). It was
    # a raw i64 add, so the address lost the byte element and the deref
    # loaded i64. Sema names the pointee (sx_inline_prim_pointee).
    if e.kind == ExprKind.CstringLit
        return 1
    return 0

# Byte size of the element an index expression `base[i]` names, for
# `@base[i]` pointer arithmetic (AGAST #1603).  `base` is a local or global
# `[N]T` array, or a pointer (whose stride ptr_arith_elem_size already knows).
# Fails CLOSED like get_ptr_elem_size (#1451): an array whose element size is
# unresolvable is a located emitter error, never a guessed stride.
fn index_elem_size(s: *EmitterState, idx: *Expr) -> i64
    let base: *Expr = idx.left
    if base == null
        return 0
    if base.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if loc != null and lv_var_type(loc) == TypeKind.Array
            let lsize: i64 = ptr_pointee_size(s, lv_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            if lsize > 0
                return lsize
            return ptr_elem_size_unknown(s, base.span, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if loc == null
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if glob != null and glob.var_type == TypeKind.Array
                let gsize: i64 = ptr_pointee_size(s, glob.array_elem_type, StrView { ptr: (glob.array_elem_type_name), len: (glob.array_elem_type_name_len) as i64 })
                if gsize > 0
                    return gsize
                return ptr_elem_size_unknown(s, base.span, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
    # AGAST #4249: `@x.buf[0] + i` with `buf: [N]T` a struct field strides by
    # sizeof(T).  The member fell to ptr_arith_elem_size, which knows only a
    # pointer field, so it was a raw byte add.  N-D fields keep that path.
    if base.kind == ExprKind.Member
        let fld: *StructField = member_field_def(s, base)
        if fld != null and fld.field_type == TypeKind.Array and fld.array_shape == null
            let fsize: i64 = ptr_pointee_size(s, fld.array_elem_type, StrView { ptr: (fld.array_elem_type_name), len: (fld.array_elem_type_name_len) as i64 })
            if fsize > 0
                return fsize
    # AGAST #2440: through a reference or pointer it's the buffer's element.
    let through: *LocalVar = index_through(s, idx)
    if through != null and lv_array_base(through) != null
        return ptr_pointee_size(s, lv_pointee_type(through), StrView { ptr: (lv_type_name(through)), len: (lv_type_name_len(through)) as i64 })   # #2329
    if through != null
        var th: ThroughIndex
        index_through_fill(s, idx, through, @th)
        return ptr_arith_elem_size(s, @th.sum)
    # `@p[i]` for a pointer `p`: the element is p's pointee.
    return ptr_arith_elem_size(s, base)

# Helper: get pointee type for a struct member that is a pointer
# e.g., for span.ptr (where ptr is *u8), returns TypeKind.U8.
#
# AGAST #1304: this GUESSES TypeKind.U8 for a pointer field whose pointee it
# cannot determine (monomorphised `Vec<T>.data`, for one).  That guess is
# right often enough for loads, but callers that need to know the
# difference between "it is a u8" and "no idea" must use
# get_member_pointee_type_exact below, which returns TypeKind.Void (0) for the
# unknown case.  emit_assign's deref-store depends on that distinction:
# guessing u8 there truncates a struct RHS to one byte.
fn get_member_pointee_type(s: *EmitterState, e: *Expr) -> TypeKind
    let exact: TypeKind = get_member_pointee_type_exact(s, e)
    if exact == TypeKind.Void
        return TypeKind.U8
    return exact

# Like get_member_pointee_type but returns TypeKind.Void (0) rather than
# guessing TypeKind.U8 when the field's pointee type is not recorded.
pub fn get_member_pointee_type_exact(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind != ExprKind.Member
        return TypeKind.I64
    # Resolve the field through the whole receiver chain.  Nesting is
    # critical for selfhost: ritz1's own emit_expr_method does
    # `*(e.left.ident_ptr + i)`, and an unresolved receiver returned
    # TypeKind.I64 → OpKind.Deref emitted `load i64` instead of `load i8`.  This
    # handled exactly `local.f` and `local.m.f` until AGAST #1673;
    # `o.inner.name.ptr` (3+ levels) still loaded i64.
    let field: *StructField = member_field_def(s, e)
    # Return the pointee type based on field's pointer kind.
    # `array_elem_type` is where make_ptr_prim_field records the
    # pointee for primitive pointers (NFA's *i64 indices, Vec$T
    # data, etc.) — without honoring the i16/i32/i64 cases here,
    # `*(struct.ptr_field + i)` would default to TypeKind.U8 and
    # emit `load i8`, garbling the actual i64/i32/i16 read.
    # Was the selfhost blocker for the Tier 1 NFA optimization
    # — `nfa.state_trans_offset` is `*i32`; reading it as i8
    # gave bogus offsets and the lexer matched no patterns.
    if field != null and field.field_type == TypeKind.Ptr
        let pe: TypeKind = field.array_elem_type
        if ty_int_in(pe, 8, 16) == 1
            return pe
        if ty_int_in(pe, 32, 64) == 1
            return pe
        # AGAST #2053: a `*f32` / `*f64` / `*bool` field.  These fell to
        # the unknown case, so `*r.p` loaded `i8` (the u8 guess) and
        # `*r.p = v` stored `i64 %double`.
        if pe == TypeKind.F32 or pe == TypeKind.F64 or pe == TypeKind.Bool
            return pe
        # Pointee not recorded — e.g. `data: *T` in a
        # monomorphised generic, where the substituted field
        # carries no array_elem_type.  Report "unknown" and let
        # the caller decide; get_member_pointee_type still
        # guesses u8 for the load paths that relied on it.
        return TypeKind.Void
    return TypeKind.I64

# AGAST #1304: pointee type of the pointer expression `ptr` in `*ptr = v`,
# i.e. the width of the destination slot.  Mirrors get_expr_type's OpKind.Deref
# arm but returns TypeKind.Void instead of guessing when the pointee is not
# recorded, so emit_assign can fall back to the RHS's own type rather than
# truncating it.  TypeKind.I64 doubles as "unknown" in the local/global pointee
# tables, and an i64 store is the default anyway, so it is reported as-is.
pub fn get_deref_store_type(s: *EmitterState, ptr_expr: *Expr) -> TypeKind
    # AGAST #2119: `*(@s as *i8) = v` / `*@g = v` store the stated pointee.
    let inl_pt: TypeKind = inline_deref_scalar_pointee(s, ptr_expr)
    if inl_pt != TypeKind.Void
        return inl_pt
    # AGAST #2332: `*a[i] = v` / `*(a[i] + k) = v` with `a: [N]*T`.
    let el_pt: TypeKind = array_elem_pointee_kind(s, ptr_expr)
    if el_pt != TypeKind.Void
        return el_pt
    # AGAST #3186: `*X[i] = v` with `X` a `**T` (a field `h.f`, a local, a
    # param): `X[i]` is the `*T` `*(X + i)`, so the slot is a T.  Unresolved,
    # this stored the RHS's whole i64 over a 4- or 1-byte T.
    if ptr_expr.kind == ExprKind.Index and ptr_expr.right != null and ptr_expr.right.kind != ExprKind.Range
        let ix_pt: TypeKind = ptr_ptr_index_scalar(s, ptr_expr.left)
        if ix_pt != TypeKind.Void
            return ix_pt
    match ptr_expr.kind
        ExprKind.Ident =>
            let lpt: TypeKind = find_local_pointee_type(s, StrView { ptr: (ptr_expr.ident_ptr), len: (ptr_expr.ident_len) as i64 })
            if lpt != TypeKind.I64
                return lpt
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (ptr_expr.ident_ptr), len: (ptr_expr.ident_len) as i64 })
            if glob != null
                return glob.pointee_type
            return TypeKind.Void
        ExprKind.Member =>
            return get_member_pointee_type_exact(s, ptr_expr)
        ExprKind.Binary =>
            # `*(base + i) = v` — the slot width comes from `base`.
            let base: *Expr = find_base_expr(ptr_expr)
            match base.kind
                ExprKind.Ident =>
                    let blpt: TypeKind = find_local_pointee_type(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                    if blpt != TypeKind.I64
                        return blpt
                    let bglob: *GlobalVarDef = find_global(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                    if bglob != null
                        return bglob.pointee_type
                    return TypeKind.Void
                ExprKind.Member =>
                    return get_member_pointee_type_exact(s, base)
                _ => pass
            # AGAST #1815: `*(*(pp + i) + k) = v`.
            return deref_ptr_ptr_elem_type(s, base)
        ExprKind.Unary =>
            # AGAST #1815: `**pp = v`.
            return deref_ptr_ptr_elem_type(s, ptr_expr)
        _ => pass
    return TypeKind.Void

# AGAST #4180: the struct a `(*p).m()` or `(p as @S).m()` receiver reaches,
# as emit_expr_method's deref and cast arms (#2145, #4161) dispatch it, or
# null.  So a member of the result (`(*p).me().x`) finds its struct.
pub fn deref_cast_recv_struct(s: *EmitterState, rcv: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if rcv.kind == ExprKind.Unary and rcv.op == OpKind.Deref
        var dname: *u8 = null
        deref_pointee_struct_name(s, rcv.operand, @dname, out_len)
        return dname
    if rcv.kind == ExprKind.Cast and (rcv.type_kind == TypeKind.Ptr or rcv.type_kind == TypeKind.Ref or rcv.type_kind == TypeKind.MutRef) and rcv.cast_ptr_kind == (TypeKind.Struct as i32)
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    null

# AGAST #2068: the struct name a method call `e` dispatches on, as
# emit_expr_method resolves it, or null.  `*out_len` gets its length.
# AGAST #3267: a `%Span$u8` receiver (ritz1's `let h = "..."`) with no
# `Span$u8_<m>` of its own dispatches to `impl StrView`'s `m`, as
# emit_expr_method does, so a chained `h.slice(..).get(..)` is typed by
# StrView_slice's return.  The UFCS fallback did this until R66 (#3497).
pub fn method_recv_type_name(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    let tn: *u8 = method_recv_type_name_of(s, e, out_len)
    if tn == null or name_eq(StrView { ptr: (tn), len: (*out_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 }) == 0
        return tn
    if span_u8_method_is_strview(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
        *out_len = 7
        return c"StrView"
    tn

# 1 when `Span$u8` has no method `m` (a specialised `Span$u8_<m>`) and
# `impl StrView` has one (`StrView_<m>`).  AGAST #4684: a trait impl on the
# one instantiation (`impl Bytes for Span<u8>`, R36's revisit) is a method of
# its own too, imported or not, so `a.eq(@b)` calls `Span$u8_eq` as ritz0
# does, not `StrView_eq` with a `@Span<u8>` argument.
pub fn span_u8_method_is_strview(s: *EmitterState, m_sv: StrView) -> i32
    if find_impl_method(s, "Span$u8", m_sv) != null
        return 0
    let n: i32 = 8 + m_sv.len as i32
    let buf: *u8 = malloc(n as i64 + 1)
    memcpy(buf, c"Span$u8_", 8)
    memcpy(buf + 8, m_sv.ptr, m_sv.len)
    *(buf + n) = 0
    let own: *FnDef = find_fn(s, StrView { ptr: (buf), len: (n) as i64 })
    memcpy(buf, c"StrView_", 8)
    let sv: *FnDef = find_impl_method_by_symbol(s.module, StrView { ptr: (buf), len: (n) as i64 })
    free(buf)
    (own == null and sv != null) as i32

fn method_recv_type_name_of(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
# Receivers: a local (value or pointer -- loc.type_name names the struct
# either way), a struct / `*S` global, a static `Type.m()`, a struct
# literal, a struct-returning call, and a struct / pointer field.
    *out_len = 0
    let rcv: *Expr = e.left
    if rcv == null
        return null
    match rcv.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 })
            if loc != null
                *out_len = lv_type_name_len(loc)
                return lv_type_name(loc)
            var glob: *GlobalVarDef = find_global(s, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 })
            if glob != null and global_is_receiver(glob) == 0 and impl_type_named(s, StrView { ptr: (rcv.ident_ptr), len: (rcv.ident_len) as i64 }) == 1
                glob = null
            if glob != null
                if glob.var_type == TypeKind.Struct
                    *out_len = glob.type_name_len
                    return glob.type_name
                if glob.var_type == TypeKind.Ptr and glob.pointee_type == TypeKind.Struct
                    *out_len = glob.pointee_type_name_len
                    return glob.pointee_type_name
                return null
            # Neither local nor global: a static call names its impl type.
            *out_len = rcv.ident_len
            return rcv.ident_ptr as *u8
        ExprKind.StructLit =>
            *out_len = rcv.ident_len
            return rcv.ident_ptr as *u8
        # AGAST #3156: a bare "..." is a StrView (#98), so `"lit".m()` dispatches
        # as on a StrView local.  (Its value is a %Span$u8 of the same layout;
        # emit_expr_method rebuilds it under the StrView name.)  A c"..." is a
        # `*u8` and has no methods.
        ExprKind.StringLit =>
            *out_len = 7
            return c"StrView"
        # AGAST #2295 / #3620: a call's or method call's struct return names the
        # impl (`mp().get()`, `Color.red().is_opaque()`, `c.me().is_zero()`).
        # #2946 / #2883: or its `*S` return (`sp(@s).me()`, `s.me().me()`), as
        # emit_expr_method's ExprKind.Call / ExprKind.Method arms dispatch it.
        ExprKind.Call | ExprKind.Method =>
            var cname: *u8 = null
            call_result_struct_name(s, rcv, @cname, out_len)
            if *out_len > 0
                return cname
            let cst: *StructDef = call_result_ptr_struct(s, rcv)
            if cst != null
                *out_len = cst.name_len
                return cst.name
            *out_len = 0
            return null
        ExprKind.Member =>
            let fld: *StructField = member_field_def(s, rcv)
            if fld != null and (fld.field_type == TypeKind.Struct or fld.field_type == TypeKind.Ptr or fld.field_type == TypeKind.Ref or fld.field_type == TypeKind.MutRef)
                *out_len = fld.field_type_name_len
                return fld.field_type_name
            return null
        # AGAST #3622: an element (`self.ws[i].m()` over a `Vec<S>` field,
        # `arr[i].m()`, `p[i].m()`, `a[i][j].m()`): the struct it is, or points
        # at, as emit_expr_method's ExprKind.Index arms dispatch on.
        ExprKind.Index =>
            var iname: *u8 = null
            index_elem_struct_name(s, rcv, @iname, out_len)
            return iname
        ExprKind.Unary | ExprKind.Cast =>
            return deref_cast_recv_struct(s, rcv, out_len)   # AGAST #4180
        _ => pass
    null

# AGAST #2068: TypeKind.F32 / TypeKind.F64 when `e` calls a user impl method that
# returns one, 0 otherwise.  emit_expr_method leaves that result in a
# `float` / `double` register, so `p.scale(f) + 0.5` must be float math at
# the method's width -- get_expr_type used to call it i64, and the add ran
# at the literal's `double` (`fadd double %<float>`, rejected by clang).
pub fn user_method_float_ret(s: *EmitterState, e: *Expr) -> TypeKind
    let t: TypeKind = user_method_ret_type(s, e)
    if t == TypeKind.F32 or t == TypeKind.F64
        return t
    TypeKind.Void

# The declared return type of user method call `e`, or TypeKind.Unknown.
pub fn user_method_ret_type(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind != ExprKind.Method
        return TypeKind.Unknown
    var tn_len: i32 = 0
    let tn: *u8 = method_recv_type_name(s, e, @tn_len)
    if tn == null or tn_len == 0
        return TypeKind.Unknown
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (tn), len: (tn_len) as i64 }) == 1
            var m: *FnDef = ib.methods
            while m != null
                if name_eq(StrView { ptr: (m.name), len: (m.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                    return m.return_type
                m = m.next
        ib = ib.next
    TypeKind.Unknown

# The pointee type a pointer expression states inline, or TypeKind.Void: `<e> as
# *T` (the cast records T; AGAST #1453), `@x` (x's own type) and a call that
# returns a reference (#2308).  Shared by the memory builtins (#1879) and the
# `*p` load / `*p = v` store widths (#2119), which otherwise only know a typed
# binding's pointee.
fn inline_ptr_pointee(s: *EmitterState, p: *Expr) -> TypeKind
    if p == null
        return TypeKind.Void
    match p.kind
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, p)
            # AGAST #2540: `*f()` with `f() -> *T` (T scalar) loads a T, not an
            # i64: capture_fn_return_type names the primitive pointee (#1984).
            if fd != null and fd.return_type == TypeKind.Ptr
                return primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            return ret_ref_scalar_pointee(fd)
        ExprKind.Method =>
            # AGAST #2327: so does `*x.m()` of a `-> @T` / `-> @&T` method, its
            # callee resolved as `let p = x.m()` resolves it (#2308).
            var mt_len: i32 = 0
            let mt: *u8 = method_recv_type_name(s, p, @mt_len)
            if mt == null or mt_len <= 0
                return TypeKind.Void
            let md: *FnDef = method_callee_def(s, StrView { ptr: (mt), len: (mt_len) as i64 }, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
            # AGAST #3176: and of a `-> *T` method, as the call arm does (#2540).
            if md != null and md.return_type == TypeKind.Ptr
                return primitive_type_from_name(StrView { ptr: (md.return_type_name), len: (md.return_type_name_len) as i64 })
            return ret_ref_scalar_pointee(md)
        _ => pass
    if p.kind == ExprKind.Binary and (p.op == OpKind.Add or p.op == OpKind.Sub) and p.left != null
        # AGAST #2540: `*(f() + k)` / `*((x as *T) + k)` point at the same T
        # as their left operand; ptr_arith_elem_size steps by its size.
        # AGAST #4060: and `*(b.m() + k)`, a `-> *T` method.  It loaded an i64.
        if is_ptr_distance(s, p) == 1
            return TypeKind.Void
        let lk: ExprKind = p.left.kind
        if lk == ExprKind.Call or lk == ExprKind.Method or lk == ExprKind.Cast or lk == ExprKind.Binary
            return inline_ptr_pointee(s, p.left)
        return TypeKind.Void
    if p.kind == ExprKind.Cast and p.type_kind == TypeKind.Ptr and p.cast_ptr_kind != (TypeKind.Void as i32)
        return ptr_slot_flat(p.cast_ptr_kind)
    if p.kind == ExprKind.Unary and (p.op == OpKind.Addr or p.op == OpKind.AddrMut) and p.operand != null
        let ae: TypeKind = addr_of_array_elem_type(s, p.operand)
        if ae != TypeKind.Void
            return ae
        let lent: *LocalVar = lent_ptr_local(s, p.operand)
        if lent != null
            return lv_pointee_type(lent)   # AGAST #2286: it reads as the pointer
        return expr_slot_ty(p.operand)
    TypeKind.Void

# The element type of `arr[i]` over an inline array (local, global or
# field), or TypeKind.Void.  get_expr_type calls an integer element i64 (its
# value-model width), but `@arr[i]` points at the element's own slot.
fn addr_of_array_elem_type(s: *EmitterState, x: *Expr) -> TypeKind
    if x.kind != ExprKind.Index or x.left == null
        return TypeKind.Void
    if x.right != null and x.right.kind == ExprKind.Range
        return TypeKind.Void
    if x.left.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if loc != null
            if lv_var_type(loc) == TypeKind.Array
                return lv_array_elem_type(loc)
            return TypeKind.Void
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if glob != null and glob.var_type == TypeKind.Array
            return glob.array_elem_type
        return TypeKind.Void
    if x.left.kind == ExprKind.Member
        let f: *StructField = member_field_def(s, x.left)
        if f != null and f.field_type == TypeKind.Array
            return f.array_elem_type
    TypeKind.Void

# AGAST #2119: the scalar (integer / float / bool) pointee of `*p` when `p`
# states it inline, else TypeKind.Void.  `*(@s as *i8)` and `*@g` (g: u32)
# loaded and stored i64, reading / clobbering the slot's neighbours.
# Aggregates are left to deref_pointee_struct_name, which names them.
pub fn inline_deref_scalar_pointee(s: *EmitterState, p: *Expr) -> TypeKind
    let t: TypeKind = inline_ptr_pointee(s, p)
    if t != TypeKind.Void and primitive_name_len(t) > 0
        return t
    TypeKind.Void

# The pointee type of a memory builtin's pointer operand.  ritz1's `*p`
# inference only knows a typed binding's pointee (a `*(@x as *u32)` deref
# loads i64), and an atomic must not silently widen, so the two shapes a
# kernel writes inline are resolved here first: `<e> as *T` (the cast
# records T) and `@x` (x's own type).
pub fn mem_builtin_pointee(s: *EmitterState, arg: *Expr) -> TypeKind
    if arg == null
        return TypeKind.Void
    let inl: TypeKind = inline_ptr_pointee(s, arg)
    if inl != TypeKind.Void
        return inl
    # AGAST #4410: get_deref_store_type reports TypeKind.Void for a pointee it
    # cannot name; get_expr_type's `*arg` default (and its i64 miss value)
    # was i64, which is also the atomic default width.
    let dst: TypeKind = get_deref_store_type(s, arg)
    if dst != TypeKind.Void
        return dst
    TypeKind.I64

# The type a memory builtin call evaluates to: the pointee for the
# value-returning ones, TypeKind.Void for the stores and fence.
fn mem_builtin_result_type(s: *EmitterState, e: *Expr, id: i32) -> TypeKind
    if id == MEM_VOLATILE_STORE or id == MEM_ATOMIC_STORE or id == MEM_FENCE
        return TypeKind.Void
    mem_builtin_pointee(s, e.args)

pub fn synth_slot_ty(s: *EmitterState, e: *Expr) -> TypeKind
    # Returns the Ritz type of an expression
    # AGAST #4404 (#1816): a literal's slot type is decided by the node
    # itself, so Sema annotates it (sema_walk -> sema_note_expr_ty) and the
    # emitter reads the annotation (expr_slot_ty) instead of keeping its own
    # copy of the rule.
    var kty: TypeKind = TypeKind.Void
    match e.kind
        ExprKind.IntLit | ExprKind.FloatLit | ExprKind.CharLit | ExprKind.StringLit | ExprKind.CstringLit | ExprKind.NilLit =>
            return expr_slot_ty(e)
        ExprKind.Ident =>
            # AGAST #1325: locals first (they shadow globals), then globals.
            # This arm used to consult only the locals table, so a global
            # `var g: *i32` reported TypeKind.I64 — find_local_type's miss value,
            # indistinguishable from a real i64 local.  Every caller that
            # branches on TypeKind.Ptr therefore skipped its pointer path for
            # globals, which made the global-pointee fallbacks in the OpKind.Deref
            # arm below unreachable: `*(g + i)` fell through to the i64-load
            # default and read two i32 slots as one i64.  Stores were already
            # global-aware (get_deref_store_type), so the corruption was
            # load-side only and silent.
            let lidx: i32 = find_local_idx(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if lidx >= 0
                let loc: *LocalVar = local_at(s, lidx)
                return lv_var_type(loc)
            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if glob != null
                return glob.var_type
            # AGAST #2155: `const F: f64 = -1` is a double, not the i64 it folded to.
            var folded: i64 = 0
            let cft: TypeKind = const_int_init_float_ty(s, find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }), @folded)
            if cft != TypeKind.Void
                return cft
            # AGAST #2176: so is `const G: f32 = 2.5`, an f32.
            let lft: TypeKind = const_float_lit_init_ty(find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }))
            if lft != TypeKind.Void
                return lft
            return TypeKind.I64
        ExprKind.Index =>
            if synth_slot_ty_index(s, e, @kty) == 1
                return kty
        ExprKind.Unary =>
            if synth_slot_ty_unary(s, e, @kty) == 1
                return kty
        ExprKind.Binary =>
            # AGAST #1965: float arithmetic is computed at binop_float_width
            # (`y * 2.0` is f32, `y * x` with `x: f64` is f64), not the left type.
            # AGAST #3817: `%` too, or `y % x` read as f32 was fpext'd again.
            if e.op == OpKind.Add or e.op == OpKind.Sub or e.op == OpKind.Mul or e.op == OpKind.Div or e.op == OpKind.Mod
                let bw: TypeKind = binop_float_width(s, e)
                if bw != TypeKind.Void
                    return bw
            # AGAST #3931: a comparison is a bool whatever its operands, held in
            # the emitter's bool slot, TypeKind.I64 (#1646), as Sema's sema_expr_ty
            # types it TypeKind.Bool.  Sema annotates the slot (AGAST #4404).
            if op_is_comparison(e.op)
                return expr_slot_ty(e)
            return synth_slot_ty(s, e.left)  # Binary ops preserve left type (simplified)
        ExprKind.Member =>
            # Look up the field type through the whole receiver chain.  Without
            # nesting, get_expr_type returns TypeKind.I64 for `e.left.ident_ptr`, so
            # the surrounding OpKind.Deref on `*(e.left.ident_ptr + i)` falls to the
            # i64-load default (selfhost static-method dispatch read 8 bytes
            # instead of 1).  Handled only `l.f` / `l.m.f` until AGAST #1673.
            let mfield: *StructField = member_field_def(s, e)
            if mfield != null
                return mfield.field_type
            return TypeKind.I64  # Default for unknown member access
        ExprKind.Call =>
            # AGAST #1879: volatile / atomic builtins return their pointee type.
            let mem_id: i32 = mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
            if mem_id != 0
                return mem_builtin_result_type(s, e, mem_id)
            # AGAST #3995: a user-enum variant ctor `One(3)` / `Rect(3, 4)` is
            # its enum, as emit_expr_call builds it ahead of any fn of the name.
            var uen: *u8 = null
            var uen_len: i32 = 0
            user_enum_ctor_call(s.mono.pctx, e, @uen, @uen_len)
            if uen != null
                return TypeKind.Struct
            # Look up function return type
            # Build full function name with type suffix if generic
            let fn_def: *FnDef = find_call_fn(s, e)
            if fn_def != null
                return fn_def.return_type

            return TypeKind.I64  # Default for unknown functions
        ExprKind.Cast =>
            # Target type stored in e.op (set by expr_cast helper); Sema
            # annotates it (AGAST #4404).
            return expr_slot_ty(e)
        ExprKind.Method =>
            # AGAST #1370: `x.ceil()` on an f32 is an f32 (a `float` register),
            # so `let y = x.ceil()` infers f32 and `x.floor() + 0.5` is f32 math.
            let fmt: TypeKind = float_method_result_ty(s, e)
            if fmt != TypeKind.Void
                return fmt
            # AGAST #2068: a user method's f32 / f64 return.
            let umt: TypeKind = user_method_float_ret(s, e)
            if umt != TypeKind.Void
                return umt
        _ => pass
    TypeKind.I64  # Default fallback

# synth_slot_ty of `a[i]`: 1 (type in *out) when it names one.
fn synth_slot_ty_index(s: *EmitterState, e: *Expr, out: *TypeKind) -> i32
    # AGAST #2332: `a[i][j]` with `a: [N]*T` is a T.
    if is_array_elem_index(s, e) == 1
        *out = array_elem_pointee_kind(s, e.left)
        return 1
    # AGAST #2440: what `*(p.data + i)` is.
    let through: *LocalVar = index_through(s, e)
    if through != null and lv_array_base(through) != null
        *out = lv_pointee_type(through)  # the element of `h.r[i]`, `g[i]`, `h(p)[i]` (#2329)
        return 1
    if through != null
        var th: ThroughIndex
        index_through_fill(s, e, through, @th)
        *out = synth_slot_ty(s, @th.deref)
        return 1
    # AGAST #2537: `(*r)[i]` with `r: **T` is a T, as `*(*r + i)` is.
    let dix: TypeKind = deref_index_elem(s, e)
    if dix != TypeKind.Void
        *out = dix
        return 1
    # AGAST #4450: `p[i]` through a `*E` (a local, param, global, field
    # or call), E a user enum, loads the `%E` (emit_expr_index lowers it
    # `*(p + i)`), as Sema types it.  The `*T` arm below called it the
    # byte path's u8.
    var pe_name: *u8 = null
    var pe_len: i32 = 0
    ptr_index_user_enum(s, e, @pe_name, @pe_len)
    if pe_len > 0
        *out = TypeKind.Struct
        return 1
    # AGAST #2767: a full-rank `x[i][j]` over an N-D `[N][M]f32` / `f64`
    # (local, global or field) loads a `float` / `double`, as the 1-D
    # arms below say for `[N]f32`.  It fell to the i64 default, so a
    # literal beside it stayed a double (`fcmp double` on a `float`) and
    # `x[i][j] + 1.0` was stored as an i64.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null and nd_depth == nd_sh.rank and (e.right == null or e.right.kind != ExprKind.Range)
        match nd_sh.leaf_type
            TypeKind.F32 | TypeKind.F64 =>
                *out = nd_sh.leaf_type
                return 1
            # AGAST #4428: a full-rank index over an N-D array of pointers is
            # that pointer (Sema's array view types it so).
            TypeKind.Ptr | TypeKind.PtrPtr =>
                *out = nd_sh.leaf_type
                return 1
            _ => pass
    # Indexing: result type depends on base type.
    # AGAST #1328: resolve the base through locals THEN globals — the old
    # code only saw locals, and find_local_type's TypeKind.I64 miss value made
    # a global pointer base look like an i64, so `g[i]` on `var g: *i32`
    # skipped both pointer branches and fell to the i64 default.
    match e.left.kind
        ExprKind.Ident =>
            # AGAST #2321: as `a[i]` below.
            let ap: *LocalVar = array_ptr_index_base(s, e.left)
            if ap != null
                let ap_elem: TypeKind = lv_pointee_array_elem_type(ap)
                if ap_elem == TypeKind.F32 or ap_elem == TypeKind.F64
                    *out = ap_elem
                    return 1
                *out = TypeKind.I64
                return 1
            var base_type: TypeKind = find_local_type(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            var pointee: TypeKind = TypeKind.Unknown
            if base_type == TypeKind.Unknown
                let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                if glob != null
                    base_type = glob.var_type
                    pointee = glob.pointee_type
            else
                pointee = find_local_pointee_type(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            match base_type
                TypeKind.PtrPtr =>
                    *out = TypeKind.Ptr  # **u8 indexed gives *u8
                    return 1
                TypeKind.Ptr =>
                    # Element type of *T indexing is the pointee when recorded.
                    # AGAST #1973: `p[i]` through a *f32 / *f64 loads a `float` /
                    # `double`.
                    if ty_is_int(pointee) == 1 or ty_is_float(pointee) == 1
                        *out = pointee
                        return 1
                    *out = TypeKind.U8  # *u8 (or unrecorded pointee) indexed gives u8
                    return 1
                TypeKind.Array =>
                    # AGAST #1966: `loc[i]` over a local `[N]f32` / `[N]f64` loads
                    # a `float` / `double` (local_array_elem_llvm); say so, or a
                    # binop / compare over it picks the other operand's width.
                    # AGAST #1970: likewise a global `[N]f32` / `[N]f64`
                    # (global_array_elem_llvm).  (No range case: an array can't be
                    # sliced, #2521.)
                    let arr_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                    var arr_elem: TypeKind = TypeKind.Unknown
                    if arr_loc != null
                        arr_elem = lv_array_elem_type(arr_loc)
                    else
                        let arr_glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                        if arr_glob != null
                            arr_elem = arr_glob.array_elem_type
                    if arr_elem == TypeKind.F32 or arr_elem == TypeKind.F64
                        *out = arr_elem
                        return 1
                _ => pass
        ExprKind.Member =>
            # AGAST #1954: `x.f[i]` over a `[N]f32` / `[N]f64` field (any
            # receiver depth, struct pointers included) loads a `float` /
            # `double` (field_array_elem_llvm) — the element's own type.
            let af: *StructField = member_field_def(s, e.left)
            if af != null and af.field_type == TypeKind.Array and (af.array_elem_type == TypeKind.F32 or af.array_elem_type == TypeKind.F64)
                *out = af.array_elem_type
                return 1
            # AGAST #2053: `x.p[i]` through a `*f32` / `*f64` field loads a
            # `float` / `double` (ptr_field_elem_llvm) and is not widened.
            if af != null and af.field_type == TypeKind.Ptr
                let pk: TypeKind = ptr_field_elem_kind(af)
                if pk == TypeKind.F32 or pk == TypeKind.F64
                    *out = pk
                    return 1
        _ => pass
    *out = TypeKind.I64  # Default
    return 1

# synth_slot_ty of `*p`, `-x`, `@x`: 1 (type in *out) when it names one.
fn synth_slot_ty_unary(s: *EmitterState, e: *Expr, out: *TypeKind) -> i32
    # AGAST #4404: these four are node-local; Sema annotates them.
    match e.op
        OpKind.Addr | OpKind.AddrMut | OpKind.Not | OpKind.BitNot =>
            *out = expr_slot_ty(e)
            return 1
        OpKind.Deref =>
            # AGAST #2119: `*(@s as *i8)` / `*@g` load the stated pointee.
            let inl_pt: TypeKind = inline_deref_scalar_pointee(s, e.operand)
            if inl_pt != TypeKind.Void
                *out = inl_pt
                return 1
            # AGAST #4249: `*(@a[0] + i)` / `*(@x - k)` load the base's
            # inline pointee too.  The ptr+offset arm below knows only an
            # ident / member / `*pp` base, so this loaded i64: 21_ls's
            # newline count over a `[N]u8` saw one line of six.
            if e.operand.kind == ExprKind.Binary and (e.operand.op == OpKind.Add or e.operand.op == OpKind.Sub)
                let off_pt: TypeKind = inline_deref_scalar_pointee(s, find_base_expr(e.operand))
                if off_pt != TypeKind.Void
                    *out = off_pt
                    return 1
            # AGAST #2332: `*a[i]` / `*(a[i] + k)` with `a: [N]*T`.
            let el_pt: TypeKind = array_elem_pointee_kind(s, e.operand)
            if el_pt != TypeKind.Void
                *out = el_pt
                return 1
            # AGAST #3186: `*X[i]` with `X` a `**T` loads a T, as
            # get_deref_store_type stores one.  It loaded i64.
            if e.operand.kind == ExprKind.Index and e.operand.right != null and e.operand.right.kind != ExprKind.Range
                let ix_pt: TypeKind = ptr_ptr_index_scalar(s, e.operand.left)
                if ix_pt != TypeKind.Void
                    *out = ix_pt
                    return 1
            # AGAST #1924: `*(ppp + i)` with `ppp: ***T` is itself a `**T`.
            # The arm below calls every deref of a `**` a `*T`, so the next
            # deref out lost the pointee and `*(*(*(ppp + i) + j) + k)`
            # loaded i64.
            var dl_inner: TypeKind = TypeKind.Void
            var dl_name: *u8 = null
            var dl_len: i32 = 0
            let dl_levels: i32 = ptr_levels_of(s, e, @dl_inner, @dl_name, @dl_len)
            if dl_levels >= 2
                *out = TypeKind.PtrPtr
                return 1
            # AGAST #2376: `*a[i]` with `a: [N]**T` (or `*@a[i]` with `a: [N]*T`)
            # is a `*T`, so `**a[i]` reads its T below.  The element itself isn't
            # typed as a `**`.
            if dl_levels == 1 and elem_rooted(e.operand) == 1
                *out = TypeKind.Ptr
                return 1
            let inner_type: TypeKind = synth_slot_ty(s, e.operand)
            match inner_type
                TypeKind.PtrPtr =>
                    *out = TypeKind.Ptr  # Deref **T gives *T
                    return 1
                TypeKind.Ptr =>
                    # Deref *T gives T - look up what T is
                    # If operand is an identifier, look up its pointee type
                    match e.operand.kind
                        ExprKind.Ident =>
                            let local_pt: TypeKind = find_local_pointee_type(s, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
                            if local_pt != TypeKind.I64
                                *out = local_pt
                                return 1
                            # Fall back to global pointee — without this, *(g_ptr)
                            # for a global *i32 reads as i64 (selfhost monomorph
                            # bug).
                            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
                            if glob != null
                                *out = glob.pointee_type
                                return 1
                            *out = local_pt
                            return 1
                        # If operand is ptr+offset, find base expression and get its pointee type
                        ExprKind.Binary =>
                            let base: *Expr = find_base_expr(e.operand)
                            match base.kind
                                ExprKind.Ident =>
                                    let lpt: TypeKind = find_local_pointee_type(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                                    if lpt != TypeKind.I64
                                        *out = lpt
                                        return 1
                                    let glob: *GlobalVarDef = find_global(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                                    if glob != null
                                        *out = glob.pointee_type
                                        return 1
                                    *out = lpt
                                    return 1
                                ExprKind.Member =>
                                    # Member+offset dereference (e.g., *(span.ptr + i))
                                    *out = get_member_pointee_type(s, base)
                                    return 1
                                _ => pass
                            # AGAST #1815: `*(*(pp + i) + k)` for `pp: **T`.
                            let bdpt: TypeKind = deref_ptr_ptr_elem_type(s, base)
                            if bdpt != TypeKind.Void
                                *out = bdpt
                                return 1
                        # AGAST #1815: `**pp` / `*(*(pp + i))` for `pp: **T`.
                        ExprKind.Unary =>
                            let udpt: TypeKind = deref_ptr_ptr_elem_type(s, e.operand)
                            if udpt != TypeKind.Void
                                *out = udpt
                                return 1
                        # Bare member deref: `*param.name` where param.name is *u8
                        # (selfhost-only bug — emit_impl_method's `is_self` check
                        # `*param.name == 115` was loading i64 instead of i8 because
                        # this branch defaulted to TypeKind.I64).  Reuse the helper
                        # already used for the member+offset path.
                        ExprKind.Member =>
                            *out = get_member_pointee_type(s, e.operand)
                            return 1
                        _ => pass
                    *out = TypeKind.I64  # Default for unknown pointer dereference
                    return 1
                _ =>
                    if (inner_type == TypeKind.MutRef or inner_type == TypeKind.Ref) and e.operand.kind == ExprKind.Ident
                        # AGAST #1644: `*x` with `x: @&i32` loads the pointee's
                        # width, as `*q` with `q: *i32` does.  Struct pointees are
                        # resolved by name in the OpKind.Deref arm before this is asked.
                        # AGAST #2308: so does `x: @i32`, which loaded 8 bytes.
                        let mr_pt: TypeKind = find_local_pointee_type(s, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
                        if mr_pt != TypeKind.Struct
                            *out = mr_pt
                            return 1
                        *out = TypeKind.I64
                        return 1
                    else
                        *out = TypeKind.I64  # Deref *T gives value
                        return 1
        _ => pass
    *out = synth_slot_ty(s, e.operand)
    return 1

