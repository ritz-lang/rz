# ritz1/src/ref_loan.ritz - borrows of overlapping places conflict (§13.5)
#
# LANGUAGE_SPEC §13.5's first rule (LARB rulings R11 and R11a, AGAST #2438),
# on Sema since AGAST #3506 (#1816).  A borrow is of a place: a root local and
# its field and index steps.  Two places overlap when one's path is a prefix
# of the other's (field names must match; any two indexes are equal).  While a
# binding holds an `@T` of a place, or within one call's arguments, a mutable
# borrow of an overlapping place is a located error naming both places; while
# it holds an `@&T`, any borrow is.  The mutable borrows are `@&p`, `p` bare
# into a `:&` param, a receiver taken `self: @&T` (or as a UFCS fn's first
# `self:&` param), and a write into p's own storage.
#
# LARB R57 (AGAST #3473): a `Span<T>` made from a local root in a Span slot,
# `@x` or a view `v[a..b]` of a Vec or String, is an `@` of that root: monomorph
# has already made the view a `Span$T { ptr: v.data + a, len: b - a }` struct
# literal (ast_query.span_view_base).  So it lends v to the end of its block,
# and moving an overlapping place conflicts with it as a mutable borrow does
# (ref_loan_move_conflict, asked by own_check.ritz's move check).  A Span's
# slice views what that Span does, so it lends nothing.
#
# A loan lasts to the end of its holder's block.  Loans are lexical, so
# Sema's blocks end them: sema_walk calls ref_loan_enter / ref_loan_leave
# around each statement list and match arm, where the emitter's own_pop_scope
# used to call ref_loans_end.  Only a declaration's value is held
# (ref_loan_after), so `p = @x` and a call's `@x` borrow nothing past the
# statement.  `@x` held in a `*T` isn't a borrow (#2371).
#
# ritz0's twin is the loan half of move_checker.py, and
# ritz0/test_borrow_conflict_all_compilers.py holds all three compilers to it.
#
# A place's steps are typed from Sema's scope (ref_check.ritz's rs_ty, which
# ref_value.ritz's checks share since AGAST #3926): what it can't type borrows
# nothing, rather than refuse a valid program on a guess.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str     # memset

import ast
import ast_helpers
import diag
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema
import sema_type
import bool_check     # sbk_method_def, sbk_global
import deref_field    # df_is_step, df_deref_step_recv (AGAST #3015)
import ref_check      # rs_ty and friends: Sema's place typing (AGAST #3926)
import struct_index   # SI_USE_* (AGAST #2847)

# A loan of a place, held by a binding declared at block depth `depth`.
# `root` is the place's local's index in Sema's scope, and `place` the borrowed
# expression (an ident, member or index chain down to it).
struct RefLoan
    root: i32
    mutable: i32
    depth: i32
    place: *Expr
    # A `for`'s loan on the place its iterable indexes into (AGAST #2439): only a
    # use of that place, or of one holding it, conflicts.  `vs[0].a[2] = 50` is
    # inside `vs`: it can't move the buffer, and stays legal.
    outer: i32

var RL_LOANS: *RefLoan = null
var RL_COUNT: i32 = 0
var RL_CAP: i32 = 0
# The block depth of the statement being walked: the fn body is 1.
var RL_DEPTH: i32 = 0
# Call arguments being walked, and the depth of an argument's loan: deeper than
# any block, so only rl_args ends it.
var RL_IN_ARGS: i32 = 0
const RL_ARG: i32 = 1000000000
# Where the last conflict was reported: one report per place.
var RL_LAST_LINE: i32 = 0
var RL_LAST_COL: i32 = 0

# --- Blocks --------------------------------------------------------------------

pub fn ref_loan_begin_fn()
    RL_COUNT = 0
    RL_DEPTH = 0
    RL_IN_ARGS = 0
    RL_LAST_LINE = 0
    RL_LAST_COL = 0

pub fn ref_loan_enter()
    RL_DEPTH = RL_DEPTH + 1

# A block ends: so does every loan its bindings held.
pub fn ref_loan_leave()
    RL_DEPTH = RL_DEPTH - 1
    rl_end(RL_DEPTH)

fn rl_end(depth: i32)
    let loans: *RefLoan = RL_LOANS
    var kept: i32 = 0
    for i in 0..RL_COUNT
        let l: *RefLoan = loans + i
        if l.depth <= depth or l.depth == RL_ARG
            let to: *RefLoan = loans + kept
            to.root = l.root
            to.mutable = l.mutable
            to.depth = l.depth
            to.place = l.place
            to.outer = l.outer
            kept = kept + 1
    RL_COUNT = kept

fn rl_add(root: i32, place: *Expr, mutable: i32, depth: i32) -> *RefLoan
    if RL_COUNT == RL_CAP
        let cap: i32 = RL_CAP * 2 + 16
        let grown: *RefLoan = malloc((cap as i64) * sizeof(RefLoan)) as *RefLoan
        let was: *RefLoan = RL_LOANS
        for i in 0..RL_COUNT
            let from: *RefLoan = was + i
            let to: *RefLoan = grown + i
            to.root = from.root
            to.mutable = from.mutable
            to.depth = from.depth
            to.place = from.place
            to.outer = from.outer
        if RL_LOANS != null
            free(RL_LOANS as *u8)
        RL_LOANS = grown
        RL_CAP = cap
    let l: *RefLoan = RL_LOANS + RL_COUNT
    l.root = root
    l.mutable = mutable
    l.depth = depth
    l.place = place
    l.outer = 0
    RL_COUNT = RL_COUNT + 1
    l

# The index of the innermost local named `name` in Sema's scope, or -1.
fn rl_local_idx(sm: *Sema, name_sv: StrView) -> i32
    var i: i32 = sm.scope_top - 1
    while i >= 0
        let v: *SemaVar = @sm.scope[i]
        if name_eq(v.name, name_sv) == 1
            return i
        i = i - 1
    0 - 1

# 1 when `stmt`, a declaration, writes a `Span<T>` type (LARB R57): a view it
# binds lends its root for both of §13.5's rules.
fn rl_is_span_decl(stmt: *Stmt) -> i32
    if stmt.var_declared_type != TypeKind.Struct or stmt.var_type_name.len <= 5
        return 0
    ((stmt.var_type_name).starts_with("Span$")) as i32

# 1 when `t` is a Vec or String: a `v[a..b]` of one in a Span slot is a view of
# v's storage rather than a copy (§7.8, LARB R57).  A Span's slice views what
# that Span does, so it lends nothing here.
fn rl_is_vec_or_string(t: *SemaTy) -> i32
    if t.kind != TypeKind.Struct or t.name.ptr == null
        return 0
    if t.name.len > 4 and t.name.starts_with("Vec$")
        return 1
    name_eq(t.name, "String")

# --- Places ----------------------------------------------------------------------

# The index of the local whose storage the place `e0` is in, reached by fields and
# indexes with no pointer or reference on the way, or -1.  An index into a Vec
# counts as a step of its place (R11a): `@vs[0]` is a loan of `vs[_]`, and a write
# into `vs[0].a` is a write inside it.
fn rl_root(sm: *Sema, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        if e.kind == ExprKind.Ident
            return rl_local_idx(sm, e.ident)
        # AGAST #3015: a step through `Deref` (R17 rule 6) is a step of its
        # receiver's place.
        let through: *Expr = df_deref_step_recv(e)
        if through != null
            e = through
            continue
        if e.kind != ExprKind.Member and e.kind != ExprKind.Index
            return 0 - 1
        var base: SemaTy
        if rs_loan_ty(sm, e.left, @base) == 0 or ref_is_pointer(base.kind) == 1
            return 0 - 1
        if e.kind == ExprKind.Index
            if e.right == null or e.right.kind == ExprKind.Range
                return 0 - 1
        e = e.left
    0 - 1

# The place one step up from `e`: a field's or index's base, or the receiver of
# a step `*` through `Deref` (AGAST #3015); null at the root.
fn rl_up(e: *Expr) -> *Expr
    if e.kind == ExprKind.Member or e.kind == ExprKind.Index
        return e.left
    df_deref_step_recv(e)

# How many field, index and `*` steps place `e` takes below its root.
fn rl_depth(e0: *Expr) -> i32
    var n: i32 = 0
    var e: *Expr = e0
    while e != null and rl_up(e) != null
        n = n + 1
        e = rl_up(e)
    n

# Two steps are the same: one field, or any two indexes, or two `*` steps.  A `*`
# step overlaps any own field of its root, which may re-aim it (R17 rule 6).
fn rl_step_eq(a: *Expr, b: *Expr) -> i32
    if df_deref_step_recv(a) != null or df_deref_step_recv(b) != null
        return 1
    if a.kind != b.kind
        return 0
    if a.kind == ExprKind.Index
        return 1
    name_eq(a.ident, b.ident)

# Do places `a0` and `b0`, of one root, overlap: is one's path a prefix of the
# other's?  Trim the longer to the shorter's length, then compare step by step.
fn rl_overlap(a0: *Expr, b0: *Expr) -> i32
    var a: *Expr = a0
    var b: *Expr = b0
    var da: i32 = rl_depth(a)
    var db: i32 = rl_depth(b)
    while da > db
        a = rl_up(a)
        da = da - 1
    while db > da
        b = rl_up(b)
        db = db - 1
    while da > 0
        if rl_step_eq(a, b) == 0
            return 0
        a = rl_up(a)
        b = rl_up(b)
        da = da - 1
    1

# The loan a new borrow of `place` on local `root` (`mutable` or not) conflicts
# with, or null: an overlapping mutable loan first, else, for a mutable borrow, an
# overlapping shared one.  As ritz0's MoveChecker._conflict.
fn rl_conflict(root: i32, place: *Expr, mutable: i32) -> *RefLoan
    let loans: *RefLoan = RL_LOANS
    var shared: *RefLoan = null
    for i in 0..RL_COUNT
        let l: *RefLoan = loans + i
        if l.root == root and rl_overlap(l.place, place) == 1 and (l.outer == 0 or rl_depth(place) <= rl_depth(l.place))
            if l.mutable == 1
                return l
            if shared == null
                shared = l
    if mutable == 1
        return shared
    null

# `c.x`, `vs[_]`: a place as the error names it.
fn rl_eprint_place(e: *Expr)
    if e == null
        return
    # A `*` step through `Deref` isn't spelled: `b.a`, not `(*b).a` (R17).
    let through: *Expr = df_deref_step_recv(e)
    if through != null
        rl_eprint_place(through)
        return
    match e.kind
        ExprKind.Member =>
            rl_eprint_place(e.left)
            eprint_char('.')
            eprint_bytes(e.ident)
        ExprKind.Index =>
            rl_eprint_place(e.left)
            eprints("[_]")
        _ =>
            eprint_bytes(e.ident)

# A borrow of `place`, on local `root`, at line:col: `what` is 0 for a borrow,
# 1 for a write and 2 for a move (LARB R57: moving a place conflicts with a
# live `@` of an overlapping one, as a mutable borrow does).  1 if there's no
# conflict, so the borrow can be lent; 0 otherwise.
fn rl_use(sm: *Sema, line: i32, col: i32, root: i32, place: *Expr, mutable: i32, what: i32) -> i32
    if root < 0
        return 0
    let l: *RefLoan = rl_conflict(root, place, mutable)
    if l == null
        return 1
    if line == RL_LAST_LINE and col == RL_LAST_COL
        return 0
    RL_LAST_LINE = line
    RL_LAST_COL = col
    diag_error_at(sema_file(sm), diag_span(line, col))
    sm.error_count = sm.error_count + 1
    if what == 1
        eprints("cannot assign to `")
    else if what == 2
        eprints("cannot move out of `")
    else
        eprints("cannot borrow `")
    rl_eprint_place(place)
    if what == 1 or what == 2
        eprints("` - `")
    else if mutable == 1
        eprints("` as mutable - `")
    else
        eprints("` as immutable - `")
    rl_eprint_place(l.place)
    if l.mutable == 1
        eprints("` is already borrowed as mutable\n")
    else
        eprints("` is already borrowed as immutable\n")
    0

# LARB R57 (AGAST #3473): a move of the place `place` is refused while a live
# loan of an overlapping place is held, as a mutable borrow of it would be.
# 1 when it reported, so the move check stops there.
pub fn ref_loan_move_conflict(sm: *Sema, place: *Expr) -> i32
    if place == null
        return 0
    let root: i32 = rl_root(sm, place)
    if root < 0
        return 0
    (rl_use(sm, place.span.line, place.span.col, root, place, 1, 2) == 0) as i32

# --- Borrows -----------------------------------------------------------------------

# A place (a local, a field or an element) passed bare into the `:&` param `p` is
# an `@&` of it (#2335, R11a).  A pointer into a `:& U` isn't a place of `U`: it
# passes what it points at.  As ritz0's MoveChecker._check_place_borrow.
fn rl_lends_place(sm: *Sema, a: *Expr, p: *Param) -> i32
    if a.kind != ExprKind.Ident and a.kind != ExprKind.Member and a.kind != ExprKind.Index
        return 0
    var t: SemaTy
    if rs_ty(sm, a, @t) == 1 and ref_is_pointer(t.kind) == 1 and p.param_pointee_type != TypeKind.Ptr
        return 0
    1

# 1 when param `p`, the first of fn `f`, lends its argument as a `:&` one does.
# AGAST #3278: a free call of a method taking `self:& C` (typed, or bare in a
# non-generic impl) lends its receiver, as emitter_expr_call's
# lent_self_call_view reads it.
pub fn rl_param_lends(sm: *Sema, f: *FnDef, p: *Param) -> i32
    if p.is_borrow == 1
        return 1
    if p != f.params or param_is_self(p) == 0 or p.is_self_borrow == 0
        return 0
    if p.param_type == TypeKind.MutRef and p.param_type_name.len > 0
        return 1
    if p.param_type != TypeKind.Struct or p.param_type_name.len > 0
        return 0
    (sema_impl_of(sm, f) != null) as i32

# A call's arguments, against `f`'s params from `p0`: an argument's loan
# lasts until the call's arguments are done (#2438).  A free call's first
# param may be a lent `self` (rl_param_lends).
fn rl_args(sm: *Sema, a0: *Expr, f: *FnDef, p0: *Param)
    let loans: i32 = RL_COUNT
    RL_IN_ARGS = RL_IN_ARGS + 1
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null
            if rl_param_lends(sm, f, p) == 1 and rl_lends_place(sm, a, p) == 1
                let root: i32 = rl_root(sm, a)
                if rl_use(sm, a.span.line, a.span.col, root, a, 1, 0) == 1
                    rl_add(root, a, 1, RL_ARG)
            p = p.next
        rl_walk(sm, a)
        a = a.next
    RL_IN_ARGS = RL_IN_ARGS - 1
    if RL_COUNT > loans
        RL_COUNT = loans

fn rl_walk_list(sm: *Sema, a0: *Expr)
    var a: *Expr = a0
    while a != null
        rl_walk(sm, a)
        a = a.next

# The method `e` takes its receiver as `p`, its first param.  `self: *T` and
# `self: @T` don't borrow it mutably, and nor does a receiver that's a pointer.
fn rl_receiver(sm: *Sema, e: *Expr, p: *Param)
    if p == null or p.param_type != TypeKind.MutRef
        return
    var t: SemaTy
    if rs_ty(sm, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
        return
    rl_use(sm, e.left.span.line, e.left.span.col, rl_root(sm, e.left), e.left, 1, 0)

# 1 when `e` is `E.V(..)` of a user enum `E` (no local or global named E).
pub fn rl_qualified_variant(sm: *Sema, e: *Expr) -> i32
    let q: *Expr = e.left
    if q == null or q.kind != ExprKind.Ident
        return 0
    if sema_find_local(sm, q.ident) != null or sbk_global(sm, q.ident) != null
        return 0
    let ei: i32 = enum_find(sm.pctx, q.ident)
    if ei < 0
        return 0
    (enum_variant_index(sm.pctx, q.ident, e.ident) >= 0) as i32

# Every borrow inside `e`.  An `if` or `match` is its condition here: its arms
# are statement lists and values the walk reaches with their bindings.
fn rl_walk(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Call =>
            if e.func_name.len == 6 and name_eq(e.func_name, "sizeof") == 1
                return
            # AGAST #3015: `S_deref(@b)` made for `b.f` (R17) is a step of the
            # place `b.f`, which the borrow it's in is of; it lends nothing itself.
            if df_is_step(e) == 1
                let sa: *Expr = e.args
                if sa != null and sa.kind == ExprKind.Unary and (sa.op == OpKind.Addr or sa.op == OpKind.AddrMut)
                    rl_walk(sm, sa.operand)
                else
                    rl_walk(sm, sa)
                return
            var en: *u8 = null
            var el: i32 = 0
            user_variant_ctor_enum(sm.pctx, e, @en, @el)
            if en != null
                rl_walk_list(sm, e.args)
                return
            # A call through a `fn(...)` local or param: a local named like a fn
            # is the local, as emit_call calls it (#2407, #2417).
            let f: *FnDef = rs_call_fn(sm, e)
            var p: *Param = null
            if f != null
                p = f.params
            rl_args(sm, e.args, f, p)
        ExprKind.Method =>
            if rl_qualified_variant(sm, e) == 1
                rl_walk_list(sm, e.args)
                return
            if e.index_step != null
                rl_index_step(sm, e)
                return
            rl_walk(sm, e.left)
            var mp: *Param = null
            let m: *FnDef = rs_method_def(sm, e)
            if m != null
                # A method found by a looser name, `v.push(x)` for `vec_push(v, x)`,
                # takes the receiver as an argument: its params don't line up, so
                # the arguments lend nothing, as in ritz0.
                mp = m.params
                rl_receiver(sm, e, mp)
                if mp != null and name_eq(mp.name, "self") == 1
                    mp = mp.next
                else
                    mp = null
            rl_args(sm, e.args, m, mp)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                rl_walk(sm, fi.value)
                fi = fi.next
        ExprKind.ArrayLit =>
            rl_walk_list(sm, e.args)
        ExprKind.ArrayFill =>
            rl_walk(sm, e.left)
        ExprKind.Unary =>
            if e.op == OpKind.AddrMut or e.op == OpKind.Addr
                var mutable: i32 = 0
                if e.op == OpKind.AddrMut
                    mutable = 1
                let root: i32 = rl_root(sm, e.operand)
                if rl_use(sm, e.span.line, e.span.col, root, e.operand, mutable, 0) == 1 and RL_IN_ARGS > 0
                    rl_add(root, e.operand, mutable, RL_ARG)
            rl_walk(sm, e.operand)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            rl_walk(sm, e.left)
            rl_walk(sm, e.right)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.Match | ExprKind.If =>
            rl_walk(sm, e.left)
        _ => pass

# `m[k]` on a struct that monomorph made `m.index(k)`, `m.index_mut(k)` or
# `m.index_set(k, v)` (§7.8, AGAST #2847): a borrow or a write of the place
# `m[k]`, as ritz0's move checker sees it before lowering (R11a: `[k]` is an
# index step).  A read borrows nothing; its receiver isn't one either.
fn rl_index_step(sm: *Sema, e: *Expr)
    rl_walk(sm, e.left)
    rl_walk_list(sm, e.args)
    let st: *IndexStep = e.index_step
    if st.place == null
        return
    let root: i32 = rl_root(sm, st.place)
    if st.addr == 1
        # `@m[k]` / `@&m[k]`, as the `@x` of rl_walk.
        let mutable: i32 = (st.use == SI_USE_ADDR_MUT) as i32
        if rl_use(sm, e.span.line, e.span.col, root, st.place, mutable, 0) == 1 and RL_IN_ARGS > 0
            rl_add(root, st.place, mutable, RL_ARG)
    else if st.use == SI_USE_ASSIGN or st.use == SI_USE_COMPOUND
        rl_use(sm, st.at.line, st.at.col, root, st.place, 1, 1)
    else if st.use == SI_USE_FIELD_STORE
        # `m[k].f… = x` (AGAST #4160): a write of the place `m[k].f…` when
        # each field's owner is a struct held by value.  `root` is m[k]'s:
        # rl_root can't type the copied chain above it.
        var b: SemaTy
        if rl_store_ty(sm, st.place.left, e, @b) == 1 and b.kind == TypeKind.Struct
            rl_use(sm, st.at.line, st.at.col, rl_root(sm, rl_store_index(st.place)), st.place, 1, 1)

# The `m[k]` at the bottom of si_field_place's `m[k].f…` chain `p`.
fn rl_store_index(p: *Expr) -> *Expr
    var e: *Expr = p
    while e.kind == ExprKind.Member
        e = e.left
    e

# The type of `p`, a step of a `m[k].f…` chain whose `m[k]` is `*call`; 0 when
# a field's owner isn't a struct held by value: a store through a pointer field
# writes outside m, as ritz0's MoveChecker._write_place.
fn rl_store_ty(sm: *Sema, p: *Expr, call: *Expr, out: *SemaTy) -> i32
    if p.kind != ExprKind.Member
        var d: Expr
        memset(@d as *u8, 0, sizeof(Expr))
        d.kind = ExprKind.Unary
        d.op = OpKind.Deref
        d.operand = call
        return rs_ty(sm, @d, out)
    var b: SemaTy
    if rl_store_ty(sm, p.left, call, @b) == 0 or b.kind != TypeKind.Struct
        return 0
    let st: *StructDef = sema_find_struct(sm, b.name)
    if st == null
        return 0
    let fi: i32 = find_field_index(st, p.ident)
    if fi < 0
        return 0
    rs_of_field(get_field_type(st, fi), out)

pub fn rl_expr_ident(e: *Expr, name_sv: StrView)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = ExprKind.Ident
    e.ident = name_sv

pub fn rl_expr_member(e: *Expr, base: *Expr, name_sv: StrView)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = ExprKind.Member
    e.left = base
    e.ident = name_sv

pub fn rl_expr_index(e: *Expr, base: *Expr, index: *Expr)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = ExprKind.Index
    e.left = base
    e.right = index

# A write into a local's own storage, in each statement form the parser splits a
# place into.  The place put back together is on the stack: a write is never
# held, only named by the error.
fn rl_write(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    var root: Expr
    var member: Expr
    var element: Expr
    var at: i32 = 0 - 1
    var place: *Expr = null
    match k
        StmtKind.Assign =>
            if stmt.assign_target.len > 0
                rl_expr_ident(@root, stmt.assign_target)
                place = @root
                at = rl_local_idx(sm, stmt.assign_target)
            else
                place = stmt.if_cond as *Expr
                at = rl_root(sm, place)
        StmtKind.IndexAssign =>
            rl_expr_ident(@root, stmt.assign_target)
            rl_expr_index(@element, @root, stmt.while_cond)
            place = @element
            at = rl_root(sm, @element)
        StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            if k == StmtKind.LocalFieldAssign or k == StmtKind.LocalFieldIndexAssign
                rl_expr_ident(@root, stmt.var_name)
                rl_expr_member(@member, @root, stmt.assign_target)
            else
                rl_expr_member(@member, stmt.if_cond as *Expr, stmt.assign_target)
            if k == StmtKind.LocalFieldAssign or k == StmtKind.MemberAssign
                place = @member
            else
                rl_expr_index(@element, @member, stmt.while_cond)
                place = @element
            at = rl_root(sm, place)
        _ =>
            return
    rl_use(sm, stmt.span.line, stmt.span.col, at, place, 1, 1)

# The loan a `for` over a place holds for its body (LARB R11, AGAST #2439).  A
# `for` walks a place in place (§6.3), so when the place's path crosses an index
# into anything but an array (a Vec, a Span, a pointer), a push may move the
# storage it walks.  The loan is an `@` of the base of the last such index: `vs`
# in `vs[0].a`, `s.vs` in `s.vs[0].a`.  It lasts as the body's block does.  As
# ritz0's MoveChecker._for_loan.
fn rl_for_hold(sm: *Sema, stmt: *Stmt)
    if stmt.for_end != null or stmt.for_start == null
        return
    var e: *Expr = stmt.for_start
    while e.kind == ExprKind.Unary and e.op == OpKind.Addr
        e = e.operand
    var base: *Expr = null
    while base == null and (e.kind == ExprKind.Member or e.kind == ExprKind.Index)
        if e.kind == ExprKind.Index
            var t: SemaTy
            if rs_loan_ty(sm, e.left, @t) == 1 and t.kind != TypeKind.Array
                base = e.left
        e = e.left
    if base == null
        return
    let root: i32 = rl_root(sm, base)
    if root < 0
        return
    let l: *RefLoan = rl_add(root, base, 0, RL_DEPTH + 1)
    l.outer = 1

# An asm block (§18.6, AGAST #3395) assigns its `out` / `inout` operands
# (§13.5): each is a write of its local, as `x = ..` is, at the operand.
fn rl_asm(sm: *Sema, stmt: *Stmt)
    var o: *AsmOperand = stmt.asm_block.operands
    while o != null
        if o.dir == ASM_OUT or o.dir == ASM_INOUT
            let at: i32 = rl_local_idx(sm, StrView { ptr: (o.name), len: (o.name_len) as i64 })
            if at >= 0
                var id: Expr
                rl_expr_ident(@id, StrView { ptr: (o.name), len: (o.name_len) as i64 })
                id.span = o.span
                rl_use(sm, o.span.line, o.span.col, at, @id, 1, 1)
        o = o.next

# The `@place` and `@&place` a declaration's binding holds: its value, or an arm's
# tail of an `if` or `match` value.  In a Span slot (`span_slot` 1) a view
# `v[a..b]` of a Vec or String is an `@` of `v` too (LARB R57); a Span's slice
# views what that Span does.
fn rl_hold(sm: *Sema, e: *Expr, span_slot: i32)
    if e == null
        return
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        let root: i32 = rl_root(sm, e.operand)
        if root >= 0
            var mutable: i32 = 0
            if e.op == OpKind.AddrMut
                mutable = 1
            rl_add(root, e.operand, mutable, RL_DEPTH)
    else if e.kind == ExprKind.Method and e.index_step != null and e.index_step.addr == 1
        # `@m[k]` / `@&m[k]` on a struct, now its `index` / `index_mut` call.
        let st: *IndexStep = e.index_step
        let sroot: i32 = rl_root(sm, st.place)
        if sroot >= 0
            rl_add(sroot, st.place, (st.use == SI_USE_ADDR_MUT) as i32, RL_DEPTH)
    else if e.kind == ExprKind.If or e.kind == ExprKind.Match
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0 and arm.body != null
                rl_hold(sm, arm.body, span_slot)
            else if arm.body_stmts != null
                var st: *Stmt = arm.body_stmts
                while st.next != null
                    st = st.next
                if st.kind == StmtKind.Expr
                    rl_hold(sm, st.expr, span_slot)
            arm = arm.next
    else if span_slot == 1
        # A view `v[a..b]` of a Vec or String: monomorph has made it a Span
        # struct literal, `Span$T { ptr: v.data + a, len: b - a }`, or left the
        # index for the emitter to refuse.
        let base: *Expr = span_view_base(e)
        if base != null
            var t: SemaTy
            if rs_loan_ty(sm, base, @t) == 1 and rl_is_vec_or_string(@t) == 1
                let root: i32 = rl_root(sm, base)
                if root >= 0
                    rl_add(root, base, 0, RL_DEPTH)

# --- The walk's hooks ---------------------------------------------------------------

# Statement `stmt`, before the statements nested in it: its own place and
# values (an `if` or loop's condition, a `for`'s range).
pub fn ref_loan_check_stmt(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    # What a write's place evaluates on the way: its base and its index.
    if k == StmtKind.MemberAssign or k == StmtKind.MemberIndexAssign or k == StmtKind.Assign and stmt.assign_target.len == 0
        rl_walk(sm, stmt.if_cond as *Expr)
    if k == StmtKind.IndexAssign or k == StmtKind.LocalFieldIndexAssign or k == StmtKind.MemberIndexAssign
        rl_walk(sm, stmt.while_cond)
    rl_write(sm, stmt)
    match k
        StmtKind.VarDecl | StmtKind.TupleDecl =>
            rl_walk(sm, stmt.var_init)
        StmtKind.Return =>
            rl_walk(sm, stmt.return_value)
        StmtKind.Expr =>
            rl_walk(sm, stmt.expr)
        StmtKind.Match | StmtKind.If | StmtKind.Assert =>
            rl_walk(sm, stmt.if_cond as *Expr)
        StmtKind.While =>
            rl_walk(sm, stmt.while_cond)
        StmtKind.Asm =>
            rl_asm(sm, stmt)
        StmtKind.For =>
            rl_for_hold(sm, stmt)
            rl_walk(sm, stmt.for_start)
            rl_walk(sm, stmt.for_end)
        StmtKind.Assign | StmtKind.LocalFieldAssign | StmtKind.MemberAssign | StmtKind.IndexAssign | StmtKind.LocalFieldIndexAssign | StmtKind.MemberIndexAssign =>
            rl_walk(sm, stmt.assign_value)
        _ => pass

# A match arm's value.
pub fn ref_loan_check_value(sm: *Sema, e: *Expr)
    rl_walk(sm, e)

# After statement `stmt` and what's nested in it, with a declaration's binding
# in scope: what it holds is held to the end of its block.  `@x` held in a
# `*T` isn't a borrow (#2371).
pub fn ref_loan_after(sm: *Sema, stmt: *Stmt)
    if stmt.kind == StmtKind.VarDecl and stmt.var_declared_type != TypeKind.Ptr
        rl_hold(sm, stmt.var_init, rl_is_span_decl(stmt))
