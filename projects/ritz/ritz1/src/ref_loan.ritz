# ritz1/src/ref_loan.ritz - borrows of overlapping places conflict (§13.5)
#
# LANGUAGE_SPEC §13.5's first rule (LARB rulings R11 and R11a, AGAST #2438),
# on Sema since AGAST #3506 (#1816).  A borrow is of a place: a root local and
# its field and index steps.  Two places overlap when one's path is a prefix
# of the other's (field names must match; any two indexes are equal).  While a
# binding holds an `@T` of a place, or within one call's arguments, a mutable
# borrow of an overlapping place is a located error naming both places; while
# it holds an `@&T`, any borrow is.  The mutable borrows are `@&p`, `p` bare
# into a `:&` param, a receiver taken `self: @&T` (or as a UFCS fn's first
# `self:&` param), and a write into p's own storage.
#
# A loan lasts to the end of its holder's block.  Loans are lexical, so
# Sema's blocks end them: sema_walk calls ref_loan_enter / ref_loan_leave
# around each statement list and match arm, where the emitter's own_pop_scope
# used to call ref_loans_end.  Only a declaration's value is held
# (ref_loan_after), so `p = @x` and a call's `@x` borrow nothing past the
# statement.  `@x` held in a `*T` isn't a borrow (#2371).
#
# ritz0's twin is the loan half of move_checker.py, and
# ritz0/test_borrow_conflict_all_compilers.py holds all three compilers to it.
#
# A place's steps are typed from Sema's scope (ref_check.ritz's rs_ty, which
# ref_value.ritz's checks share since AGAST #3926): what it can't type borrows
# nothing, rather than refuse a valid program on a guess.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str     # memset

import ast
import ast_helpers
import diag
import emitter_core   # name_eq, find_field_index, get_field_type, eprint_*
import sema
import sema_type
import bool_check     # sbk_method_def, sbk_global
import deref_field    # df_is_step, df_deref_step_recv (AGAST #3015)
import ref_check      # rs_ty and friends: Sema's place typing (AGAST #3926)

# A loan of a place, held by a binding declared at block depth `depth`.
# `root` is the place's local's index in Sema's scope, and `place` the borrowed
# expression (an ident, member or index chain down to it).
struct RefLoan
    root: i32
    mutable: i32
    depth: i32
    place: *Expr
    # A `for`'s loan on the place its iterable indexes into (AGAST #2439): only a
    # use of that place, or of one holding it, conflicts.  `vs[0].a[2] = 50` is
    # inside `vs`: it can't move the buffer, and stays legal.
    outer: i32

var RL_LOANS: *RefLoan = null
var RL_COUNT: i32 = 0
var RL_CAP: i32 = 0
# The block depth of the statement being walked: the fn body is 1.
var RL_DEPTH: i32 = 0
# Call arguments being walked, and the depth of an argument's loan: deeper than
# any block, so only rl_args ends it.
var RL_IN_ARGS: i32 = 0
const RL_ARG: i32 = 1000000000
# Where the last conflict was reported: one report per place.
var RL_LAST_LINE: i32 = 0
var RL_LAST_COL: i32 = 0

# --- Blocks --------------------------------------------------------------------

pub fn ref_loan_begin_fn()
    RL_COUNT = 0
    RL_DEPTH = 0
    RL_IN_ARGS = 0
    RL_LAST_LINE = 0
    RL_LAST_COL = 0

pub fn ref_loan_enter()
    RL_DEPTH = RL_DEPTH + 1

# A block ends: so does every loan its bindings held.
pub fn ref_loan_leave()
    RL_DEPTH = RL_DEPTH - 1
    rl_end(RL_DEPTH)

fn rl_end(depth: i32)
    let loans: *RefLoan = RL_LOANS
    var kept: i32 = 0
    for i in 0..RL_COUNT
        let l: *RefLoan = loans + i
        if l.depth <= depth or l.depth == RL_ARG
            let to: *RefLoan = loans + kept
            to.root = l.root
            to.mutable = l.mutable
            to.depth = l.depth
            to.place = l.place
            to.outer = l.outer
            kept = kept + 1
    RL_COUNT = kept

fn rl_add(root: i32, place: *Expr, mutable: i32, depth: i32) -> *RefLoan
    if RL_COUNT == RL_CAP
        let cap: i32 = RL_CAP * 2 + 16
        let grown: *RefLoan = malloc((cap as i64) * sizeof(RefLoan)) as *RefLoan
        let was: *RefLoan = RL_LOANS
        for i in 0..RL_COUNT
            let from: *RefLoan = was + i
            let to: *RefLoan = grown + i
            to.root = from.root
            to.mutable = from.mutable
            to.depth = from.depth
            to.place = from.place
            to.outer = from.outer
        if RL_LOANS != null
            free(RL_LOANS as *u8)
        RL_LOANS = grown
        RL_CAP = cap
    let l: *RefLoan = RL_LOANS + RL_COUNT
    l.root = root
    l.mutable = mutable
    l.depth = depth
    l.place = place
    l.outer = 0
    RL_COUNT = RL_COUNT + 1
    l

# The index of the innermost local named `name` in Sema's scope, or -1.
fn rl_local_idx(sm: *Sema, name: *u8, len: i32) -> i32
    var i: i32 = sm.scope_top - 1
    while i >= 0
        let v: *SemaVar = @sm.scope[i]
        if name_eq(v.name, v.name_len, name, len) == 1
            return i
        i = i - 1
    0 - 1

# --- Places ----------------------------------------------------------------------

# The index of the local whose storage the place `e0` is in, reached by fields and
# indexes with no pointer or reference on the way, or -1.  An index into a Vec
# counts as a step of its place (R11a): `@vs[0]` is a loan of `vs[_]`, and a write
# into `vs[0].a` is a write inside it.
fn rl_root(sm: *Sema, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        if e.kind == EXPR_IDENT
            return rl_local_idx(sm, e.ident_ptr, e.ident_len)
        # AGAST #3015: a step through `Deref` (R17 rule 6) is a step of its
        # receiver's place.
        let through: *Expr = df_deref_step_recv(e)
        if through != null
            e = through
            continue
        if e.kind != EXPR_MEMBER and e.kind != EXPR_INDEX
            return 0 - 1
        var base: SemaTy
        if rs_loan_ty(sm, e.left, @base) == 0 or ref_is_pointer(base.kind) == 1
            return 0 - 1
        if e.kind == EXPR_INDEX
            if e.right == null or e.right.kind == EXPR_RANGE
                return 0 - 1
        e = e.left
    0 - 1

# The place one step up from `e`: a field's or index's base, or the receiver of
# a step `*` through `Deref` (AGAST #3015); null at the root.
fn rl_up(e: *Expr) -> *Expr
    if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
        return e.left
    df_deref_step_recv(e)

# How many field, index and `*` steps place `e` takes below its root.
fn rl_depth(e0: *Expr) -> i32
    var n: i32 = 0
    var e: *Expr = e0
    while e != null and rl_up(e) != null
        n = n + 1
        e = rl_up(e)
    n

# Two steps are the same: one field, or any two indexes, or two `*` steps.  A `*`
# step overlaps any own field of its root, which may re-aim it (R17 rule 6).
fn rl_step_eq(a: *Expr, b: *Expr) -> i32
    if df_deref_step_recv(a) != null or df_deref_step_recv(b) != null
        return 1
    if a.kind != b.kind
        return 0
    if a.kind == EXPR_INDEX
        return 1
    name_eq(a.ident_ptr, a.ident_len, b.ident_ptr, b.ident_len)

# Do places `a0` and `b0`, of one root, overlap: is one's path a prefix of the
# other's?  Trim the longer to the shorter's length, then compare step by step.
fn rl_overlap(a0: *Expr, b0: *Expr) -> i32
    var a: *Expr = a0
    var b: *Expr = b0
    var da: i32 = rl_depth(a)
    var db: i32 = rl_depth(b)
    while da > db
        a = rl_up(a)
        da = da - 1
    while db > da
        b = rl_up(b)
        db = db - 1
    while da > 0
        if rl_step_eq(a, b) == 0
            return 0
        a = rl_up(a)
        b = rl_up(b)
        da = da - 1
    1

# The loan a new borrow of `place` on local `root` (`mutable` or not) conflicts
# with, or null: an overlapping mutable loan first, else, for a mutable borrow, an
# overlapping shared one.  As ritz0's MoveChecker._conflict.
fn rl_conflict(root: i32, place: *Expr, mutable: i32) -> *RefLoan
    let loans: *RefLoan = RL_LOANS
    var shared: *RefLoan = null
    for i in 0..RL_COUNT
        let l: *RefLoan = loans + i
        if l.root == root and rl_overlap(l.place, place) == 1 and (l.outer == 0 or rl_depth(place) <= rl_depth(l.place))
            if l.mutable == 1
                return l
            if shared == null
                shared = l
    if mutable == 1
        return shared
    null

# `c.x`, `vs[_]`: a place as the error names it.
fn rl_eprint_place(e: *Expr)
    if e == null
        return
    # A `*` step through `Deref` isn't spelled: `b.a`, not `(*b).a` (R17).
    let through: *Expr = df_deref_step_recv(e)
    if through != null
        rl_eprint_place(through)
        return
    if e.kind == EXPR_MEMBER
        rl_eprint_place(e.left)
        eprint_char('.')
        eprint_bytes(e.ident_ptr, e.ident_len)
    else if e.kind == EXPR_INDEX
        rl_eprint_place(e.left)
        eprints_cstr(c"[_]")
    else
        eprint_bytes(e.ident_ptr, e.ident_len)

# A borrow of `place`, on local `root`, at line:col (a write when `assign` is 1).
# 1 if there's no conflict, so the borrow can be lent; 0 otherwise.
fn rl_use(sm: *Sema, line: i32, col: i32, root: i32, place: *Expr, mutable: i32, assign: i32) -> i32
    if root < 0
        return 0
    let l: *RefLoan = rl_conflict(root, place, mutable)
    if l == null
        return 1
    if line == RL_LAST_LINE and col == RL_LAST_COL
        return 0
    RL_LAST_LINE = line
    RL_LAST_COL = col
    diag_error_at(sema_file(sm), diag_span(line, col))
    sm.error_count = sm.error_count + 1
    if assign == 1
        eprints_cstr(c"cannot assign to `")
    else
        eprints_cstr(c"cannot borrow `")
    rl_eprint_place(place)
    if assign == 1
        eprints_cstr(c"` - `")
    else if mutable == 1
        eprints_cstr(c"` as mutable - `")
    else
        eprints_cstr(c"` as immutable - `")
    rl_eprint_place(l.place)
    if l.mutable == 1
        eprints_cstr(c"` is already borrowed as mutable\n")
    else
        eprints_cstr(c"` is already borrowed as immutable\n")
    0

# --- Borrows -----------------------------------------------------------------------

# A place (a local, a field or an element) passed bare into the `:&` param `p` is
# an `@&` of it (#2335, R11a).  A pointer into a `:& U` isn't a place of `U`: it
# passes what it points at.  As ritz0's MoveChecker._check_place_borrow.
fn rl_lends_place(sm: *Sema, a: *Expr, p: *Param) -> i32
    if a.kind != EXPR_IDENT and a.kind != EXPR_MEMBER and a.kind != EXPR_INDEX
        return 0
    var t: SemaTy
    if rs_ty(sm, a, @t) == 1 and ref_is_pointer(t.kind) == 1 and p.param_pointee_type != TYPE_PTR
        return 0
    1

# 1 when param `p`, the first of fn `f`, lends its argument as a `:&` one does.
# AGAST #3278: a free call of a method taking `self:& C` (typed, or bare in a
# non-generic impl) lends its receiver, as emitter_expr_call's
# lent_self_call_view reads it.
pub fn rl_param_lends(sm: *Sema, f: *FnDef, p: *Param) -> i32
    if p.is_borrow == 1
        return 1
    if p != f.params or param_is_self(p) == 0 or p.is_self_borrow == 0
        return 0
    if p.param_type == TYPE_MUT_REF and p.param_type_name_len > 0
        return 1
    if p.param_type != TYPE_STRUCT or p.param_type_name_len > 0
        return 0
    (sema_impl_of(sm, f) != null) as i32

# A call's arguments, against `f`'s params from `p0`: an argument's loan
# lasts until the call's arguments are done (#2438).  A free call's first
# param may be a lent `self` (rl_param_lends).
fn rl_args(sm: *Sema, a0: *Expr, f: *FnDef, p0: *Param)
    let loans: i32 = RL_COUNT
    RL_IN_ARGS = RL_IN_ARGS + 1
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null
            if rl_param_lends(sm, f, p) == 1 and rl_lends_place(sm, a, p) == 1
                let root: i32 = rl_root(sm, a)
                if rl_use(sm, a.span.line, a.span.col, root, a, 1, 0) == 1
                    rl_add(root, a, 1, RL_ARG)
            p = p.next
        rl_walk(sm, a)
        a = a.next
    RL_IN_ARGS = RL_IN_ARGS - 1
    if RL_COUNT > loans
        RL_COUNT = loans

fn rl_walk_list(sm: *Sema, a0: *Expr)
    var a: *Expr = a0
    while a != null
        rl_walk(sm, a)
        a = a.next

# The method `e` takes its receiver as `p`, its first param.  `self: *T` and
# `self: @T` don't borrow it mutably, and nor does a receiver that's a pointer.
fn rl_receiver(sm: *Sema, e: *Expr, p: *Param)
    if p == null or p.param_type != TYPE_MUT_REF
        return
    var t: SemaTy
    if rs_ty(sm, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
        return
    rl_use(sm, e.left.span.line, e.left.span.col, rl_root(sm, e.left), e.left, 1, 0)

# 1 when `e` is `E.V(..)` of a user enum `E` (no local or global named E).
pub fn rl_qualified_variant(sm: *Sema, e: *Expr) -> i32
    let q: *Expr = e.left
    if q == null or q.kind != EXPR_IDENT
        return 0
    if sema_find_local(sm, q.ident_ptr, q.ident_len) != null or sbk_global(sm, q.ident_ptr, q.ident_len) != null
        return 0
    let ei: i32 = enum_find(q.ident_ptr, q.ident_len)
    if ei < 0
        return 0
    (enum_variant_index(q.ident_ptr, q.ident_len, e.ident_ptr, e.ident_len) >= 0) as i32

# Every borrow inside `e`.  An `if` or `match` is its condition here: its arms
# are statement lists and values the walk reaches with their bindings.
fn rl_walk(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_CALL
        if e.func_name_len == 6 and name_eq(e.func_name, e.func_name_len, c"sizeof", 6) == 1
            return
        # AGAST #3015: `S_deref(@b)` made for `b.f` (R17) is a step of the
        # place `b.f`, which the borrow it's in is of; it lends nothing itself.
        if df_is_step(e) == 1
            let sa: *Expr = e.args
            if sa != null and sa.kind == EXPR_UNARY and (sa.op == OP_ADDR or sa.op == OP_ADDR_MUT)
                rl_walk(sm, sa.operand)
            else
                rl_walk(sm, sa)
            return
        var en: *u8 = null
        var el: i32 = 0
        user_variant_ctor_enum(e, @en, @el)
        if en != null
            rl_walk_list(sm, e.args)
            return
        # A call through a `fn(...)` local or param: a local named like a fn
        # is the local, as emit_call calls it (#2407, #2417).
        let f: *FnDef = rs_call_fn(sm, e)
        var p: *Param = null
        if f != null
            p = f.params
        rl_args(sm, e.args, f, p)
    else if k == EXPR_METHOD
        if rl_qualified_variant(sm, e) == 1
            rl_walk_list(sm, e.args)
            return
        rl_walk(sm, e.left)
        var mp: *Param = null
        let m: *FnDef = rs_method_def(sm, e)
        if m != null
            # A method found by a looser name, `v.push(x)` for `vec_push(v, x)`,
            # takes the receiver as an argument: its params don't line up, so
            # the arguments lend nothing, as in ritz0.
            mp = m.params
            rl_receiver(sm, e, mp)
            if mp != null and name_eq(mp.name, mp.name_len, c"self", 4) == 1
                mp = mp.next
            else
                mp = null
        rl_args(sm, e.args, m, mp)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            rl_walk(sm, fi.value)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        rl_walk_list(sm, e.args)
    else if k == EXPR_ARRAY_FILL
        rl_walk(sm, e.left)
    else if k == EXPR_UNARY
        if e.op == OP_ADDR_MUT or e.op == OP_ADDR
            var mutable: i32 = 0
            if e.op == OP_ADDR_MUT
                mutable = 1
            let root: i32 = rl_root(sm, e.operand)
            if rl_use(sm, e.span.line, e.span.col, root, e.operand, mutable, 0) == 1 and RL_IN_ARGS > 0
                rl_add(root, e.operand, mutable, RL_ARG)
        rl_walk(sm, e.operand)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        rl_walk(sm, e.left)
        rl_walk(sm, e.right)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_MATCH or k == EXPR_IF
        rl_walk(sm, e.left)

pub fn rl_expr_ident(e: *Expr, name: *u8, len: i32)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_IDENT
    e.ident_ptr = name
    e.ident_len = len

pub fn rl_expr_member(e: *Expr, base: *Expr, name: *u8, len: i32)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_MEMBER
    e.left = base
    e.ident_ptr = name
    e.ident_len = len

pub fn rl_expr_index(e: *Expr, base: *Expr, index: *Expr)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_INDEX
    e.left = base
    e.right = index

# A write into a local's own storage, in each statement form the parser splits a
# place into.  The place put back together is on the stack: a write is never
# held, only named by the error.
fn rl_write(sm: *Sema, stmt: *Stmt)
    let k: i32 = stmt.kind
    var root: Expr
    var member: Expr
    var element: Expr
    var at: i32 = 0 - 1
    var place: *Expr = null
    if k == STMT_ASSIGN
        if stmt.assign_target_len > 0
            rl_expr_ident(@root, stmt.assign_target, stmt.assign_target_len)
            place = @root
            at = rl_local_idx(sm, stmt.assign_target, stmt.assign_target_len)
        else
            place = stmt.if_cond as *Expr
            at = rl_root(sm, place)
    else if k == STMT_INDEX_ASSIGN
        rl_expr_ident(@root, stmt.assign_target, stmt.assign_target_len)
        rl_expr_index(@element, @root, stmt.while_cond)
        place = @element
        at = rl_root(sm, @element)
    else if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
            rl_expr_ident(@root, stmt.var_name, stmt.var_name_len)
            rl_expr_member(@member, @root, stmt.assign_target, stmt.assign_target_len)
        else
            rl_expr_member(@member, stmt.if_cond as *Expr, stmt.assign_target, stmt.assign_target_len)
        if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_MEMBER_ASSIGN
            place = @member
        else
            rl_expr_index(@element, @member, stmt.while_cond)
            place = @element
        at = rl_root(sm, place)
    else
        return
    rl_use(sm, stmt.span.line, stmt.span.col, at, place, 1, 1)

# The loan a `for` over a place holds for its body (LARB R11, AGAST #2439).  A
# `for` walks a place in place (§6.3), so when the place's path crosses an index
# into anything but an array (a Vec, a Span, a pointer), a push may move the
# storage it walks.  The loan is an `@` of the base of the last such index: `vs`
# in `vs[0].a`, `s.vs` in `s.vs[0].a`.  It lasts as the body's block does.  As
# ritz0's MoveChecker._for_loan.
fn rl_for_hold(sm: *Sema, stmt: *Stmt)
    if stmt.for_end != null or stmt.for_start == null
        return
    var e: *Expr = stmt.for_start
    while e.kind == EXPR_UNARY and e.op == OP_ADDR
        e = e.operand
    var base: *Expr = null
    while base == null and (e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX)
        if e.kind == EXPR_INDEX
            var t: SemaTy
            if rs_loan_ty(sm, e.left, @t) == 1 and t.kind != TYPE_ARRAY
                base = e.left
        e = e.left
    if base == null
        return
    let root: i32 = rl_root(sm, base)
    if root < 0
        return
    let l: *RefLoan = rl_add(root, base, 0, RL_DEPTH + 1)
    l.outer = 1

# An asm block (§18.6, AGAST #3395) assigns its `out` / `inout` operands
# (§13.5): each is a write of its local, as `x = ..` is, at the operand.
fn rl_asm(sm: *Sema, stmt: *Stmt)
    var o: *AsmOperand = stmt.asm_block.operands
    while o != null
        if o.dir == ASM_OUT or o.dir == ASM_INOUT
            let at: i32 = rl_local_idx(sm, o.name, o.name_len)
            if at >= 0
                var id: Expr
                rl_expr_ident(@id, o.name, o.name_len)
                id.span = o.span
                rl_use(sm, o.span.line, o.span.col, at, @id, 1, 1)
        o = o.next

# The `@place` and `@&place` a declaration's binding holds: its value, or an arm's
# tail of an `if` or `match` value.
fn rl_hold(sm: *Sema, e: *Expr)
    if e == null
        return
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        let root: i32 = rl_root(sm, e.operand)
        if root >= 0
            var mutable: i32 = 0
            if e.op == OP_ADDR_MUT
                mutable = 1
            rl_add(root, e.operand, mutable, RL_DEPTH)
    else if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0 and arm.body != null
                rl_hold(sm, arm.body)
            else if arm.body_stmts != null
                var st: *Stmt = arm.body_stmts
                while st.next != null
                    st = st.next
                if st.kind == STMT_EXPR
                    rl_hold(sm, st.expr)
            arm = arm.next

# --- The walk's hooks ---------------------------------------------------------------

# Statement `stmt`, before the statements nested in it: its own place and
# values (an `if` or loop's condition, a `for`'s range).
pub fn ref_loan_check_stmt(sm: *Sema, stmt: *Stmt)
    let k: i32 = stmt.kind
    # What a write's place evaluates on the way: its base and its index.
    if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_ASSIGN and stmt.assign_target_len == 0
        rl_walk(sm, stmt.if_cond as *Expr)
    if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        rl_walk(sm, stmt.while_cond)
    rl_write(sm, stmt)
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        rl_walk(sm, stmt.var_init)
    else if k == STMT_RETURN
        rl_walk(sm, stmt.return_value)
    else if k == STMT_EXPR
        rl_walk(sm, stmt.expr)
    else if k == STMT_MATCH or k == STMT_IF or k == STMT_ASSERT
        rl_walk(sm, stmt.if_cond as *Expr)
    else if k == STMT_WHILE
        rl_walk(sm, stmt.while_cond)
    else if k == STMT_ASM
        rl_asm(sm, stmt)
    else if k == STMT_FOR
        rl_for_hold(sm, stmt)
        rl_walk(sm, stmt.for_start)
        rl_walk(sm, stmt.for_end)
    else if k == STMT_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        rl_walk(sm, stmt.assign_value)

# A match arm's value.
pub fn ref_loan_check_value(sm: *Sema, e: *Expr)
    rl_walk(sm, e)

# After statement `stmt` and what's nested in it, with a declaration's binding
# in scope: what it holds is held to the end of its block.  `@x` held in a
# `*T` isn't a borrow (#2371).
pub fn ref_loan_after(sm: *Sema, stmt: *Stmt)
    if stmt.kind == STMT_VAR_DECL and stmt.var_declared_type != TYPE_PTR
        rl_hold(sm, stmt.var_init)
