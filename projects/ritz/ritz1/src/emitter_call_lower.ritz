pub fn call_reg_slots(args: *Expr, min: i32) -> *i32
    var n: i32 = 0
    var a: *Expr = args
    while a != null
        n = n + 1
        a = a.next
    if n < min
        n = min
    if n < 1
        n = 1
    return malloc((n as i64) * 4) as *i32

# =============================================================================
# Method-dispatch helpers (ported from ritz0 Wave-1 commit 0278a27).
#
# Runs before the regular impl-table lookup so missing UFCS wrappers don't
# block obvious intrinsic patterns. Mirrors the dispatch chain from the
# holy-fuck-wip branch — StrView builtins, Vec/Span/StrView .len(), and a
# UFCS fallback that rewrites `v.method(args)` -> `vec_method$T(&v, args)`
# (similarly for Span$T, StrView) when the monomorphized wrapper exists.
# =============================================================================

# The name `e` spells (an Ident, a Member's field, a Method's method).
fn ident_sv(e: *Expr) -> StrView
    e.ident

# The type name param `p` declares (a struct's, a Span$T's ...).
fn param_type_sv(p: *Param) -> StrView
    p.param_type_name

# The type name local `loc` records.
fn lv_type_sv(loc: *LocalVar) -> StrView
    StrView { ptr: lv_type_name(loc), len: lv_type_name_len(loc) as i64 }

# StrView.as_bytes() -> Span<u8> — bypasses the missing StrView_as_bytes impl
# Returns -1 if not applicable, else the LLVM register holding the Span<u8>.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is *StrView);
# 0 when the stack slot is the struct itself.
pub fn try_emit_strview_as_bytes(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    # Method must be "as_bytes"
    if name_eq(ident_sv(e), "as_bytes") == 0
        return -1
    # No args
    if e.args != null
        return -1
    # AGAST #3699: `let s = "abc"` is a StrView (#3579) in a `%Span$u8` slot,
    # the same `{ ptr, i64 }`: its bytes are the slot's value.
    if name_eq(type_name_sv, "Span$u8") == 1 and is_str_view_local(s, e.left)
        let bytes: i32 = next_reg(s)
        emit_load_into(s, "%Span$u8", bytes, receiver_reg)
        return bytes
    # Must be "StrView"
    if name_eq(type_name_sv, "StrView") == 0
        return -1

    # If the receiver is *StrView (pointer), dereference once to get ptr-to-struct.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_load_into(s, "ptr", loaded, receiver_reg)
        struct_ptr = loaded

    # Load %StrView from the receiver pointer
    let sv: i32 = next_reg(s)
    emit_load_into(s, "%StrView", sv, struct_ptr)

    # Extract the ptr and len fields
    let ptr_reg: i32 = next_reg(s)
    format_into(s, "  %.{ptr_reg} = extractvalue %StrView %.{sv}, 0\n")

    let len_reg: i32 = next_reg(s)
    format_into(s, "  %.{len_reg} = extractvalue %StrView %.{sv}, 1\n")

    # Build the %Span$u8 { ptr, i64 } value inline
    let span1: i32 = next_reg(s)
    format_into(s, "  %.{span1} = insertvalue %Span$u8 undef, ptr %.{ptr_reg}, 0\n")

    let span2: i32 = next_reg(s)
    format_into(s, "  %.{span2} = insertvalue %Span$u8 %.{span1}, i64 %.{len_reg}, 1\n")
    return span2

# Vec/Span/StrView .len() — load the len field (index 1) directly.
# Returns -1 if not applicable, else the register holding an i64 length.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is
# *Vec<T> etc.); 0 when the stack slot *is* the struct.
pub fn try_emit_len_builtin(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    # Must be .len() with no args, on a Vec$T, Span$T, or StrView
    if name_eq(ident_sv(e), "len") == 0 or e.args != null
        return -1
    if not (type_name_sv.starts_with("Vec$") or type_name_sv.starts_with("Span$") or name_eq(type_name_sv, "StrView") == 1)
        return -1

    # If the receiver is a pointer, load the stack slot to get the actual struct pointer.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_load_into(s, "ptr", loaded, receiver_reg)
        struct_ptr = loaded

    # %len_ptr = getelementptr %Type, ptr %r, i32 0, i32 1
    # %len    = load i64, ptr %len_ptr
    let len_ptr: i32 = next_reg(s)
    gep_struct_open(s, len_ptr, type_name_sv)
    format_into(s, ", ptr %.{struct_ptr}, i32 0, i32 1\n")

    let len_val: i32 = next_reg(s)
    emit_load_into(s, "i64", len_val, len_ptr)
    return len_val

# `%StrView undef` with its ptr field set to `ptr_reg`; the caller sets the len.
fn strview_with_ptr(s: *EmitterState, ptr_reg: i32) -> i32
    let half: i32 = next_reg(s)
    format_into(s, "  %.{half} = insertvalue %StrView undef, ptr %.{ptr_reg}, 0\n")
    half

# A string literal passed to a `StrView` param, rebuilt as a %StrView value.
# `reg` is emit_expr's result for `arg`. Also rebuilds any other arg whose
# value is a %Span$u8 (e.g. an un-annotated literal local, #2103). Returns
# the %StrView register, or -1 when no rebuild is needed (the caller passes
# the value through).
pub fn emit_strview_from_lit(s: *EmitterState, arg: *Expr, reg: i32) -> i32
    if arg == null
        return -1
    match arg.kind
        ExprKind.StringLit =>
            # Bare "..." already produced a %Span$u8 aggregate. Span<u8> and
            # StrView are layout-compatible but nominally distinct in LLVM IR,
            # so rebuild the aggregate under the StrView name.
            let lit_ty: String = ir_name(strlit_struct(s))   # AGAST #4666
            let p: i32 = next_reg(s)
            format_into(s, "  %.{p} = extractvalue %{lit_ty.as_view()} %.{reg}, 0\n")
            let l: i32 = next_reg(s)
            format_into(s, "  %.{l} = extractvalue %{lit_ty.as_view()} %.{reg}, 1\n")
            let half: i32 = strview_with_ptr(s, p)
            let sv: i32 = next_reg(s)
            format_into(s, "  %.{sv} = insertvalue %StrView %.{half}, i64 %.{l}, 1\n")
            return sv
        ExprKind.CstringLit =>
            # c"..." is a pointer (as i64); its length is known statically.
            let p: i32 = next_reg(s)
            format_into(s, "  %.{p} = inttoptr i64 %.{reg} to ptr\n")
            let half: i32 = strview_with_ptr(s, p)
            let sv: i32 = next_reg(s)
            format_into(s, "  %.{sv} = insertvalue %StrView %.{half}, i64 {arg.string_val.len}, 1\n")
            return sv
        _ => pass
    # AGAST #2103: any other %Span$u8-valued arg -- an un-annotated
    # `let t = "..."` / `var w = "..."` local is typed Span$u8 -- is
    # the layout-equivalent pair (#168) and is rebuilt the same way.
    let src: StrView = resolve_expr_struct_name(s, arg)
    if is_layout_equiv_pair(src, "StrView") == 1
        return rebuild_layout_equiv(s, reg, src, "StrView")
    -1

# `<type>_<method>`; `lower` lowercases the type's ASCII letters (`Foo`,
# `cmp` -> `foo_cmp`).
fn method_fn_name(type_name: StrView, method: StrView, lower: bool) -> String
    var name: String = string_with_cap(type_name.len + 1 + method.len)
    for i in 0..type_name.len
        let c: u8 = type_name.get(i)
        if lower and c >= 'A' and c <= 'Z'
            name.push(c + 32)
        else
            name.push(c)
    name.push('_')
    name.push_str(method)
    name

# Is there a fn `<type>_<method>` (or `<lowercased type>_<method>`)?
fn has_method_fn(s: *EmitterState, type_name: StrView, method: StrView, lower: bool) -> bool
    let name: String = method_fn_name(type_name, method, lower)
    find_fn(s, name.as_view()) != null

# AGAST #3244 (LANGUAGE_SPEC §9): method syntax reaches only impl methods,
# ritzlib's types included since LARB R66 (#3497).  `a.cmp(b)` on
# a struct with no `cmp` in an impl, a free `foo_cmp` notwithstanding, is
# refused at the method name, in ritz0's words (ref_rules.no_method):
#   no method `cmp` on `Foo`: declare it in `impl Foo`, or call `foo_cmp(a, b)`
# It called an undeclared `@Foo_cmp(...)` and failed to link.  Only for a
# non-generic struct with no `Foo_cmp` fn.  A Deref type's `w.get()` of its
# target's method never gets here: deref_field.ritz rewrote it.  True once refused.
#
# AGAST #1572: an enum too, and a generic instance (`W$i32`, `Vec$i32`).  An
# instance's impl methods are monomorphized, `internal`, in each module
# that calls them, so one find_spec_impl_method missed is defined nowhere.
# Its message has no `impl W$i32` hint: there is no such impl to write.
#
# AGAST #4262: a builtin-generic Option/Result instance whose ritzlib module
# isn't imported registers no enum, yet is one: its builtins (unwrap,
# unwrap_or, is_some...) returned above, so anything else is refused too.
#
# LARB R66 (#3497): a StrView too, which the `strview_*` fallback caught until
# then.  Like an instance it gets no hint: its impl is ritzlib's.
pub fn refuse_no_method(s: *EmitterState, e: *Expr, type_name: StrView) -> bool
    let builtin_carrier: bool = type_name.starts_with("Option$") or type_name.starts_with("Result$")
    let is_strview: bool = name_eq(type_name, "StrView") == 1
    if not builtin_carrier and not is_strview and find_struct(s, type_name) == null and is_enum_type(s.sym.mono.pctx, type_name) == 0
        return false
    if has_method_fn(s, type_name, ident_sv(e), false)
        return false
    format_into(s, "  ; ERROR: no method (AGAST #3244)\n")
    # Where the method name is (AGAST #3015), else the call.
    var at: SrcSpan = e.span
    if e.bracket.line > 0
        at = e.bracket
    diag_error_at(emitter_source_file(), at)
    eprints("no method `")
    eprint_bytes(ident_sv(e))
    eprints("` on `")
    # AGAST #3697: `let s = "abc"` lowers to `%Span$u8` but is the StrView the
    # user wrote (#3579), as ritz0 names it.  Still no hint: its impl is ritzlib's.
    if is_str_view_local(s, e.left)
        eprints("StrView")
    else
        eprint_bytes(type_name)
    s.diag.error_count = s.diag.error_count + 1
    if is_strview or type_name.find_byte('$') < type_name.len
        eprints("`\n")
        return true
    eprints("`: declare it in `impl ")
    eprint_bytes(type_name)
    eprint_char('`')
    if has_method_fn(s, type_name, ident_sv(e), true)
        let free_fn: String = method_fn_name(type_name, ident_sv(e), true)
        eprints(", or call `")
        eprint_bytes(free_fn.as_view())
        eprint_free_call_args(e)
        eprint_char('`')
    eprint_char('\n')
    true

# Does `recv` name a local bound to an unannotated `"..."` (AGAST #3579)?
fn is_str_view_local(s: *EmitterState, recv: *Expr) -> bool
    if recv == null or recv.kind != ExprKind.Ident
        return false
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(recv))
    loc != null and loc.str_view != 0

# `(a, b)` for `a.cmp(b)`: the receiver and arguments by name, or `(...)` when
# one isn't a plain name.
fn eprint_free_call_args(e: *Expr)
    var all_idents: bool = e.left != null and e.left.kind == ExprKind.Ident
    var a: *Expr = e.args
    while a != null
        if a.kind != ExprKind.Ident
            all_idents = false
        a = a.next
    if not all_idents
        eprints("(...)")
        return
    eprint_char('(')
    eprint_bytes(ident_sv(e.left))
    a = e.args
    while a != null
        eprints(", ")
        eprint_bytes(ident_sv(a))
        a = a.next
    eprint_char(')')

# The by-value `self` argument read from the receiver at `recv`, a `ptr`.  It's
# read here, before the arguments, because that's when a call evaluates its
# receiver: `c.g(bump(@&c))` passes the c from before the bump (AGAST #2393).
pub fn emit_self_value(s: *EmitterState, p: *Param, recv: i32) -> i32
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, p.param_type, val, param_type_sv(p), recv, no_name())
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, null, val, p)
    val

# Tagged-enum variant constructors (ritz-task-133 rewrite).
#
# Layout (ritz0 parity, AGAST #1898):
# `%Result$... = type { i8 tag, [P x i8] pad, [N x i8] payload }` — declared
# once per instantiation by emit_tagged_enum_types in emitter.ritz; see
# tagged_enum_layout in emitter_core.
# Tag convention matches ritz0:
#   Ok   -> 0   Err  -> 1    (enum Result { Ok(T), Err(E) })
#   Some -> 0   None -> 1    (enum Option { Some(T), None })
#
# Construction shape:
#   %a = alloca %Result$T
#   %pt = getelementptr %Result$T, ptr %a, i32 0, i32 0
#   store i8 <tag>, ptr %pt
#   %pp = getelementptr %Result$T, ptr %a, i32 0, i32 2    ; [N x i8]
#   store <payload-llvm-type> %v, ptr %pp                  ; scalars at own width
#   %r = load %Result$T, ptr %a
# See emitter_match.ritz for the consumer side (extract tag, load payload).
# Resolve the enum name to alloca for a variant constructor.  Prefers an
# explicit context set by emit_var_decl for `let r: Result<_,_> = Ok(x)`
# bindings; falls back to the enclosing function's return type (which covers
# tail-expression returns inside a Result/Option-returning function — the
# common case).  `no_name()` when no enum context is available; callers should
# emit a defensive zero value rather than invalid IR in that case.
pub fn resolve_enum_ctx(s: *EmitterState) -> StrView
    let ctx: StrView = StrView { ptr: s.fcx.ctx_enum_name, len: s.fcx.ctx_enum_name_len as i64 }
    if ctx.ptr != null and ctx.len > 0 and is_tagged_enum_type(ctx) == 1
        return ctx
    # AGAST #1498: inside a call argument the enclosing fn's return type
    # says nothing about the argument's type — borrowing it built an
    # %Option$i64 for an Option<i32> param.
    if s.fcx.ctx_enum_arg == 1
        return no_name()
    let ret: StrView = StrView { ptr: s.fcx.ret_type_name, len: s.fcx.ret_type_name_len as i64 }
    if ret.ptr != null and ret.len > 0 and is_tagged_enum_type(ret) == 1
        return ret
    no_name()

# The EmitterState form of ast_query's lent_self_call_view_in (AGAST #4391:
# the pure part moved to ast_query, this wrapper stays here).
pub fn lent_self_call_view(s: *EmitterState, f: *FnDef) -> *FnDef
    lent_self_call_view_in(s.sym.module, f)

# AGAST #2502: the `[N]T` local `@e` names when `e` is `@a` and the slot
# `name` is a `Span<T>` / `[T]` (one type since #1614); else null.
pub fn span_array_source(s: *EmitterState, e: *Expr, name: StrView) -> *LocalVar
    if e == null or name.ptr == null or name.len <= 5 or not name.starts_with("Span$")
        return null
    if e.kind != ExprKind.Unary or e.op != OpKind.Addr or e.operand == null
        return null
    if e.operand.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(e.operand))
    if loc == null or lv_var_type(loc) != TypeKind.Array
        return null
    return loc

# `{ ptr, <len> }` as a `%<span_name>` register, `len` an i64 register.
fn emit_span_pair(s: *EmitterState, span_name: StrView, ptr: i32, len: i32) -> i32
    let ty: String = ir_name(span_name)
    let sp1: i32 = next_reg(s)
    format_into(s, "  %.{sp1} = insertvalue %{ty.as_view()} undef, ptr %.{ptr}, 0\n")
    let sp2: i32 = next_reg(s)
    format_into(s, "  %.{sp2} = insertvalue %{ty.as_view()} %.{sp1}, i64 %.{len}, 1\n")
    sp2

# `{ ptr, n }` as a `%<span_name>` register, `n` a constant.
pub fn emit_span_value(s: *EmitterState, ptr: i32, n: i32, span_name: StrView) -> i32
    let ty: String = ir_name(span_name)
    let sp1: i32 = next_reg(s)
    format_into(s, "  %.{sp1} = insertvalue %{ty.as_view()} undef, ptr %.{ptr}, 0\n")
    let sp2: i32 = next_reg(s)
    format_into(s, "  %.{sp2} = insertvalue %{ty.as_view()} %.{sp1}, i64 {n}, 1\n")
    sp2

# The `%Span$T` (span_sv) `{ v.data, v.len }` of the `%Vec$T` (vec_sv) at
# `vec_ptr`: a view of the Vec's elements, as ritz0 coerces `@v` (bedc85b).
pub fn emit_span_of_vec_ptr(s: *EmitterState, vec_sv: StrView, vec_ptr: i32, span_sv: StrView) -> i32
    let data_pp: i32 = next_reg(s)
    gep_struct_open(s, data_pp, vec_sv)
    format_into(s, ", ptr %.{vec_ptr}, i32 0, i32 0\n")
    let data: i32 = next_reg(s)
    emit_load_into(s, "ptr", data, data_pp)
    let len_p: i32 = next_reg(s)
    gep_struct_open(s, len_p, vec_sv)
    format_into(s, ", ptr %.{vec_ptr}, i32 0, i32 1\n")
    let len: i32 = next_reg(s)
    emit_load_into(s, "i64", len, len_p)
    emit_span_pair(s, span_sv, data, len)

# `Span$T` `name` against an `[N]T` of element `et` (`et_name` a struct's): true
# when T is that element, else the located array-store error.
pub fn span_elem_fits(s: *EmitterState, e: *Expr, et: TypeKind, et_name: StrView, name: StrView) -> bool
    var elem: StrView = et_name
    if et != TypeKind.Struct
        elem = primitive_arg_name(et)
    if elem.ptr == null or elem.len <= 0
        return true
    if name.len == 5 + elem.len and name.ends_with(elem)
        return true
    ref_array_error(s, e)
    false

# AGAST #2305: the whole `[N]u8` / `[N]i8` array `arg` passes to the StrView
# param `p`, bare (`g(a)`) or as `@a`, or null.  ritz0 makes it the StrView
# `{ &a[0], N }` for a local, a global or an inline field; any other element is
# its "Type of #1 arg mismatch".  AGAST #3335: so it does for a `*[N]u8` /
# `*[N]i8` local, param or field `pb` passed bare, `{ pb, N }`; ritz1 passed
# its i64 where the %StrView goes, which only clang refused.  Emits nothing.
pub fn strview_array_src(s: *EmitterState, arg: *Expr, p: *Param) -> *Expr
    if p == null or p.param_type != TypeKind.Struct or name_eq(param_type_sv(p), "StrView") == 0
        return null
    if strview_array_ptr(s, arg)
        return arg
    var x: *Expr = arg
    if x.kind == ExprKind.Unary and (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null
        x = x.operand
    var src: ArraySrc
    if arg_array_shape(s, x, @src) == 0 or ty_int_bits(src.elem) != 8
        return null
    x

# Is `e`, a local, param or field, a `*[N]u8` / `*[N]i8` (#3335)?
pub fn strview_array_ptr(s: *EmitterState, e: *Expr) -> bool
    if e.kind != ExprKind.Ident and e.kind != ExprKind.Member
        return false
    var src: ArraySrc
    if array_ptr_shape(s, e, @src) == 0
        return false
    ty_int_bits(src.elem) == 8

# AGAST #2781, #2366: `@a` with `a: [N]T1` fits the `Span$T2` slot `name` only
# when T1 is T2, or the Span views the array at T2's stride.  The
# array-store rule (LARB R5, #2343): the same located error as ritz0, at `e`.
# Compared as monomorphisation spells T: `u8`, a struct's name, `ptr_u8`.  An
# element this can't spell (a deeper pointer, a nested array) isn't judged.
pub fn span_array_elem_fits(s: *EmitterState, e: *Expr, loc: *LocalVar, name: StrView) -> bool
    if lv_array_shape(loc) != null
        return true
    # name is `Span$` + [`ptr_`] + elem.
    var elem: StrView = no_name()
    var prefix: StrView = ""
    match lv_array_elem_type(loc)
        TypeKind.Struct =>
            elem = lv_type_sv(loc)
        TypeKind.Ptr =>
            elem = primitive_arg_name(lv_array_elem_pointee(loc))
            prefix = "ptr_"
        _ =>
            elem = primitive_arg_name(lv_array_elem_type(loc))
    if elem.ptr == null or elem.len <= 0
        return true
    if name.len == 5 + prefix.len + elem.len and name.skip(5).starts_with(prefix) and name.ends_with(elem)
        return true
    ref_array_error(s, e)
    false

# The LLVM type of an element of the local array `loc` (`i32`, `ptr`), for
# its `[N x T]`.
fn span_array_elem_ty(loc: *LocalVar) -> StrView
    let et: TypeKind = lv_array_elem_type(loc)
    match ty_int_bits(et)
        8 => return "i8"
        16 => return "i16"
        32 => return "i32"
        64 => return "i64"
        _ => pass
    if et == TypeKind.Ptr or et == TypeKind.PtrPtr
        return "ptr"
    "i64"

# `Span { &a[0], N }` of the `[N]T` local `loc`, as a `%<span_name>` register.
pub fn emit_span_of_array(s: *EmitterState, loc: *LocalVar, span_name: StrView) -> i32
    let elem0: i32 = next_reg(s)
    let n: i32 = lv_array_size(loc)
    format_into(s, "  %.{elem0} = getelementptr [{n} x {span_array_elem_ty(loc)}], ptr %.{loc.reg}, i64 0, i64 0\n")
    emit_span_value(s, elem0, n, span_name)

# The `name:& T` param `e` names, or null (LocalVar.is_lent, AGAST #2250).
pub fn lent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(e))
    if loc == null or lv_is_lent(loc) == 0
        return null
    return loc

# AGAST #2287, #2302: an `-> [N]T` callee whose `[N x T]` isn't known (no
# ret_array_param) has no array return: the i64 it would come back in is no
# array.  True once refused.  Every parsed `-> [N]T` has one; this fails closed.
pub fn refuse_array_return(s: *EmitterState, e: *Expr, callee: *FnDef) -> bool
    if callee == null or callee.return_type != TypeKind.Array or ret_array_of(callee) != null
        return false
    emit_whole_array_error(s, e)
    true

# `g(p)` with `p: *[N]T` into a by-value `[N]T`: the array behind the pointer.
pub fn emit_array_ptr_arg_copy(s: *EmitterState, value: *Expr, loc: *LocalVar, slot: i32, p: *Param)
    if lv_pointee_array_size(loc) != p.param_array_size
        emit_ir_error_sv(s, value.span, "array length does not match the local array's length")
        return
    if not array_store_fits(s, value, lv_pointee_array_elem_type(loc), lv_type_sv(loc), p.param_array_elem_type, param_type_sv(p))
        return
    emit_local_array_copy(s, p.param_array_size, p.param_array_elem_type, param_type_sv(p), emit_load_ptr(s, loc.reg), slot)

# True when `arg` came back from emit_call_arg as an address, for `@&T` param `p` of
# a cascade that otherwise leaves its value alone.
pub fn param_takes_addr_value(s: *EmitterState, arg: *Expr, p: *Param) -> bool
    if p.param_type != TypeKind.MutRef
        return false
    if param_takes_array_ref(p) == 1
        return true
    if borrow_arg_kind(s, arg, p) == BorrowKind.Place
        return true
    false

pub fn arg_field_is_array(s: *EmitterState, arg: *Expr) -> bool
    let f: *StructField = member_field_def(s, arg)
    if f == null or f.field_type != TypeKind.Array or f.array_shape != null
        return false
    true

# AGAST #2278: the `self:& T` / `self:&` receiver `e` names, or null.
pub fn lent_self_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(e))
    if loc == null or lv_is_lent_self(loc) == 0
        return null
    return loc

# AGAST #2288: the `c:& C` param `e` names, when C is a struct, or null.  A
# by-value read with no slot type at hand (an if / match arm, a `c as C`)
# takes C from the param itself: an integer T is already a plain local and
# `a:& [N]T` an array one.
pub fn lent_referent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_local(s, e)
    if loc == null or lv_var_type(loc) != TypeKind.MutRef or lv_pointee_type(loc) != TypeKind.Struct
        return null
    return loc

pub fn emit_array_return_slot(s: *EmitterState, ra: *Param) -> i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_array_value_llvm_type(s, ra)
    format_into(s, "  ; #2302 array return\n")
    entry_alloca_reg_end(s)
    slot

# `ret` the `[N x T]` at `slot`: by value, or through the sret pointer.
pub fn emit_array_return_from(s: *EmitterState, ra: *Param, slot: i32) -> i32
    if array_param_uses_byval(s, ra) == 1
        format_into(s, "  call void @__ritz_sret_copy(ptr %ret.sret, ptr %.{slot}, ")
        emit_array_sret_size(s, ra)
        format_into(s, ")\n")
        format_into(s, "  ret void\n")   # a `ret` starts its piece (the sink's ret hook)
        s.ir.sret_helpers_used = 1
        return 1
    let val: i32 = next_reg(s)
    format_into(s, "  %.{val} = load ")
    emit_array_value_llvm_type(s, ra)
    format_into(s, ", ptr %.{slot}\n")
    format_into(s, "  ret ")
    emit_array_value_llvm_type(s, ra)
    format_into(s, " %.{val}\n")
    1

# AGAST #2279: the local `e` names, when its slot can be loaded as the struct a
# fn returns; null otherwise.  A pointer or reference slot holds an address and
# an array slot its first element, so loading either as the struct is a silent
# wrong value.  They take the generic path, whose mismatch clang refuses.
pub fn struct_value_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(e))
    if loc == null
        return null
    let t: TypeKind = lv_var_type(loc)
    if t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef or t == TypeKind.Array
        return null
    return loc

# AGAST #2279: the `a:& [N]T` param `e` names, read whole, or null.  It's an
# array local whose slot is the array behind the borrow (#2290).  A move-only T
# was refused on Sema (own_check.ritz's oc_lent_read, AGAST #3507); the caller
# still checks the slot's length and element type.
pub fn lent_array_local(s: *EmitterState, e: *Expr) -> *LocalVar
    lent_array_ident(s, e)

# AGAST #1948: the struct an argument expression statically points at, or
# `no_name()` when it is not one of the shapes whose pointee ritz1 knows for sure:
#   `@x` / `@&x`     x a struct-typed local, or a struct-typed field chain;
#   `x`              x a local declared `*T` / `@T` / `@&T` with T a struct.
# Anything else (casts, calls, arithmetic, globals) answers no_name(): the check
# fails OPEN on shapes it cannot type, never by guessing.
pub fn arg_pointee_struct(s: *EmitterState, arg: *Expr) -> StrView
    let name: StrView = arg_pointee_name(s, arg)
    if name.ptr == null or name.len <= 0 or find_struct(s, name) == null
        return no_name()
    name

# The struct name arg_pointee_struct reads off `arg`, before it checks that
# the struct exists.
fn arg_pointee_name(s: *EmitterState, arg: *Expr) -> StrView
    if arg == null
        return no_name()
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        let x: *Expr = arg.operand
        if x == null
            return no_name()
        match x.kind
            ExprKind.Ident =>
                let loc: *LocalVar = find_local_struct_name(s, ident_sv(x))
                if loc == null or (lv_var_type(loc) != TypeKind.Struct and lent_struct_local(s, x) == null)
                    return no_name()
                return lv_type_sv(loc)
            ExprKind.Member =>
                let f: *StructField = member_field_def(s, x)
                if f == null or f.field_type != TypeKind.Struct
                    return no_name()
                return f.field_type_name
            _ => pass
        return no_name()
    if arg.kind != ExprKind.Ident
        return no_name()
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(arg))
    if loc == null or lv_pointee_type(loc) != TypeKind.Struct
        return no_name()
    let t: TypeKind = lv_var_type(loc)
    if t != TypeKind.Ptr and t != TypeKind.Ref and t != TypeKind.MutRef
        return no_name()
    lv_type_sv(loc)

# What the place `value` holds: its array's dimensions in `out`, or that it's no
# array, or ARG_DIMS_UNKNOWN when ritz1 can't tell from here.  Emits nothing.
fn place_array_dims(s: *EmitterState, value: *Expr, out: *ArrayDims) -> i32
    var src: ArraySrc
    if arg_array_shape(s, value, @src) == 1
        return array_dims_1d(out, src.size, src.elem, StrView { ptr: src.name, len: src.name_len as i64 })
    match value.kind
        ExprKind.Ident =>
            let sh: *ArrayShape = nd_array_ident_shape(s, value)
            if sh != null
                return array_dims_nd(out, sh, 0)
            if find_local_struct_name(s, ident_sv(value)) != null or find_global(s, ident_sv(value)) != null
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        ExprKind.Member =>
            let msh: *ArrayShape = nd_array_member_shape(s, value)
            if msh != null
                return array_dims_nd(out, msh, 0)
            let f: *StructField = member_field_def(s, value)
            if f != null and f.field_type != TypeKind.Array
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        _ => pass
    if value.kind == ExprKind.Index
        var depth: i32 = 0
        let ish: *ArrayShape = nd_index_shape(s, value, @depth)
        if ish != null
            return array_dims_nd(out, ish, depth)
        # An element of a 1-D array.
        var base: ArrayDims
        if value.left.kind != ExprKind.Index and place_array_dims(s, value.left, @base) == ARG_DIMS_ARRAY
            return ARG_DIMS_NOT_ARRAY
    ARG_DIMS_UNKNOWN

# What `arg` points at, for a param that takes an array by address.
fn ref_arg_dims(s: *EmitterState, arg: *Expr, out: *ArrayDims) -> i32
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return place_array_dims(s, arg.operand, out)
    if arg.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, ident_sv(arg))
        if loc != null and lv_var_type(loc) != TypeKind.Array
            let ploc: *LocalVar = array_ptr_local(s, arg)
            if ploc != null
                # AGAST #4122: a plane pointer `*[N][M]T` points at its shape,
                # not the flat `[N*M]T` it is kept as (`:& *[N][M]T` takes it).
                if lv_pointee_array_shape(ploc) != null and lv_var_type(ploc) == TypeKind.Ptr
                    return array_dims_nd(out, lv_pointee_array_shape(ploc), 0)
                return array_dims_1d(out, lv_pointee_array_size(ploc), lv_pointee_array_elem_type(ploc), array_ptr_elem(ploc))   # #2548
            if lv_is_lent(loc) == 1
                return ARG_DIMS_NOT_ARRAY
            # AGAST #2323: `let p: @[N]T = @a` and `var p = @a` record N and T,
            # and array_ptr_local answered for them.  A pointer local whose
            # pointee is known and no array (`p: *i32`, `*u8`, `**T`, `@S`) is
            # what ritz0 refuses: `a[i]` in the callee would read past it.  One
            # that records no pointee, or an array without its N, says nothing.
            if lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.PtrPtr or lv_var_type(loc) == TypeKind.Ref or lv_var_type(loc) == TypeKind.MutRef
                if lv_pointee_type(loc) == TypeKind.Array or lv_pointee_type(loc) == TypeKind.Unknown or lv_pointee_type(loc) == TypeKind.Void
                    return ARG_DIMS_UNKNOWN
                return ARG_DIMS_NOT_ARRAY
    return place_array_dims(s, arg, out)

# Fill `out` when `arg` is a whole 1-D array, as a place or an inline field.
pub fn arg_array_shape(s: *EmitterState, arg: *Expr, out: *ArraySrc) -> i32
    if array_place_shape(s, arg, out) == 1
        return 1
    if arg.kind == ExprKind.Member and arg_field_is_array(s, arg)
        let f: *StructField = member_field_def(s, arg)
        return array_src_set(out, f.array_size, f.array_elem_type, f.array_elem_type_name)
    0

# AGAST #2335: what a bare argument to a `name:& T` param is.  LARB R1's second
# exception: a place of type `T` is borrowed, as if written `@&x`, the language's
# only implicit borrow, for every T.  What isn't a place of `T` passes if it's a
# pointer to one (an `@&T` or a `*T`), whether a place or a call result.  An
# rvalue is refused: there's nothing for the caller to observe.
pub enum BorrowKind
    Pass      # as it's written, by the value paths
    Place     # a place of `T`: its address
    Rvalue
    Misfit    # a place of something else
    Untyped   # an argument ritz1 can't type from here
    Shared    # reached through an `@T`, which is read-only

# The type of a place, as far as ritz1 can tell without emitting it.  `name` is
# a struct's, or for a pointer the struct it points at.
struct PlaceType
    kind: TypeKind
    pointee: TypeKind
    name: StrView

fn place_type_set(out: *PlaceType, kind: TypeKind, pointee: TypeKind, name: StrView) -> bool
    out.kind = kind
    out.pointee = pointee
    out.name = name
    true

fn kind_is_pointer(t: TypeKind) -> bool
    t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef

# What `*x` gives, for `x` of type `base`.
fn place_deref_type(base: *PlaceType, out: *PlaceType) -> bool
    var held: TypeKind = TypeKind.Unknown
    if base.name.len > 0
        held = TypeKind.Struct
    if base.kind == TypeKind.PtrPtr
        return place_type_set(out, TypeKind.Ptr, held, base.name)
    if not kind_is_pointer(base.kind)
        return false
    return place_type_set(out, base.pointee, held, base.name)

# What `x[i]` gives.  The array shapes know what they hold; a pointer is `*x`.
fn place_index_type(s: *EmitterState, value: *Expr, out: *PlaceType) -> bool
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, value, @depth)
    if sh != null
        if depth < sh.rank
            return place_type_set(out, TypeKind.Array, TypeKind.Unknown, sh.leaf_name)
        return place_type_set(out, sh.leaf_type, TypeKind.Unknown, sh.leaf_name)
    var src: ArraySrc
    if arg_array_shape(s, value.left, @src) == 1
        var held: TypeKind = TypeKind.Unknown
        if src.name_len > 0
            held = TypeKind.Struct
        return place_type_set(out, src.elem, held, StrView { ptr: src.name, len: src.name_len as i64 })
    var base: PlaceType
    if not place_type_of(s, value.left, @base)
        return false
    return place_deref_type(@base, out)

# The field `e` names on a base member_field_def can't see through: `a[i].f`,
# `(*c).f`.  Null when the base is no struct, or a pointer to one.
fn place_field_def(s: *EmitterState, e: *Expr) -> *StructField
    var base: PlaceType
    if not place_type_of(s, e.left, @base) or base.name.len <= 0
        return null
    let st: *StructDef = find_struct(s, base.name)
    if st == null
        return null
    let idx: i32 = find_field_index(st, ident_sv(e))
    if idx < 0
        return null
    get_field_type(st, idx)

# True, with `out` filled, when ritz1 can type the place `e`.
fn place_type_of(s: *EmitterState, e: *Expr, out: *PlaceType) -> bool
    match e.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, ident_sv(e))
            if loc != null
                return place_type_set(out, lv_var_type(loc), lv_pointee_type(loc), lv_type_sv(loc))
            let g: *GlobalVarDef = find_global(s, ident_sv(e))
            if g == null
                return false
            if kind_is_pointer(g.var_type)
                return place_type_set(out, g.var_type, g.pointee_type, g.pointee_type_name)
            return place_type_set(out, g.var_type, TypeKind.Unknown, g.type_name)
        ExprKind.Member =>
            var f: *StructField = member_field_def(s, e)
            if f == null
                f = place_field_def(s, e)
            if f == null
                return false
            return place_type_set(out, f.field_type, ptr_field_elem_kind(f), f.field_type_name)
        ExprKind.Index =>
            return place_index_type(s, e, out)
        _ => pass
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref
        var base: PlaceType
        var pointer: *Expr = e.operand
        if pointer.kind == ExprKind.Binary
            pointer = find_base_expr(pointer)
        if not place_type_of(s, pointer, @base)
            return false
        return place_deref_type(@base, out)
    false

# Is `e` a place?  One that names storage the caller can see afterwards.
fn arg_is_place(s: *EmitterState, e: *Expr) -> bool
    var root: *Expr = e
    while root.kind == ExprKind.Member or root.kind == ExprKind.Index
        if root.kind == ExprKind.Index and root.right != null and root.right.kind == ExprKind.Range
            return false
        root = root.left
    if root.kind == ExprKind.Unary and root.op == OpKind.Deref
        return true
    if root.kind == ExprKind.Ident
        if find_local_struct_name(s, ident_sv(root)) != null
            return true
        return find_global(s, ident_sv(root)) != null
    # A field or element of a call result: `@&g().x` isn't lowered either.
    false

# The struct a method receiver names (by value or through a pointer), or
# null when ritz1 cannot type it without emitting it.
# True when `recv` names no value, so it's the type of a static call.  A global
# named like a type with an impl doesn't shadow it unless it can be a receiver
# (a struct or `*S`), as in ritz0 (AGAST #2575); a local or param does.
pub fn method_recv_is_type(s: *EmitterState, recv: *Expr) -> bool
    if recv == null or recv.kind != ExprKind.Ident
        return false
    if find_local_struct_name(s, ident_sv(recv)) != null
        return false
    let g: *GlobalVarDef = find_global(s, ident_sv(recv))
    if g == null
        return true
    if global_is_receiver(g) == 1
        return false
    impl_type_named(s, ident_sv(recv)) == 1

# AGAST #3309: `Slot.mk(5)` on `impl<T> Slot<T>` spells no type argument, so
# it calls the method of the instance whose slot it fills (a typed `let`, a
# parameter, the fn's return type), as ritz0 does (AGAST #2185): into a
# `Slot<i32>` that's `Slot$i32_mk`, which monomorph specialised.  It called the
# template's `Slot_mk`, with `%T` in its IR, and clang refused it unlocated.
# Returns that method, whose name is the symbol to call; with no such slot,
# or another type's, refuses at the call with ritz0's text and returns null.
pub fn generic_static_method(s: *EmitterState, e: *Expr) -> *FnDef
    let recv: StrView = ident_sv(e.left)
    let method: StrView = ident_sv(e)
    let inst: StrView = slot_struct(s)
    if inst.ptr != null and inst.len > recv.len + 1 and inst.starts_with(recv) and inst.get(recv.len) == '$'
        var symbol: String = string_with_cap(inst.len + 1 + method.len)
        symbol.push_str(inst)
        symbol.push('_')
        symbol.push_str(method)
        let fd: *FnDef = find_fn(s, symbol.as_view())
        if fd != null
            return fd
    var msg: String = string_new()
    format_into(@&msg, "can't infer the type arguments of `{recv}` for `{recv}.{method}`: give the binding a type")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    null

# The `Span$T` the slot being emitted into names, or `no_name()`.
fn slot_span_type(s: *EmitterState) -> StrView
    let t: StrView = slot_struct(s)
    if t.ptr == null or t.len <= 5 or not t.starts_with("Span$")
        return no_name()
    t

# Is `e` `Span.<method>(...)`, on the type `Span` (not a value of that name)?
fn is_span_type_call(s: *EmitterState, e: *Expr) -> bool
    let recv: *Expr = e.left
    if recv == null or recv.kind != ExprKind.Ident or name_eq(ident_sv(recv), "Span") == 0
        return false
    method_recv_is_type(s, recv)

# AGAST #2296: `Span.empty()`, whose receiver is the type `Span` and whose T
# is never spelled: the slot it lands in names the `Span$T` (slot_struct_name),
# and the value is `{ null, 0 }` without ritzlib.span, as in ritz0's
# _try_emit_associated_builtin_call.  With no `Span$T` slot it is a located
# refusal, ritz0's text.  -1 when `e` isn't a call on the type `Span`.
pub fn try_emit_span_assoc(s: *EmitterState, e: *Expr) -> i32
    if not is_span_type_call(s, e)
        return -1
    let span: StrView = slot_span_type(s)
    if unnamed(span)
        return emit_qualified_variant_error_sv(s, e, "needs its type argument from the slot it lands in: a `-> Span<T>` return, a `let s: Span<T>` or a `Span<T>` parameter")
    if name_eq(ident_sv(e), "empty") == 0 or e.args != null
        return -1
    let ty: String = ir_name(span)
    let half: i32 = next_reg(s)
    format_into(s, "  %.{half} = insertvalue %{ty.as_view()} undef, ptr null, 0  ; Span.empty()\n")
    let out: i32 = next_reg(s)
    format_into(s, "  %.{out} = insertvalue %{ty.as_view()} %.{half}, i64 0, 1\n")
    return out

# AGAST #4194: the `Span$T` a `Span.empty()` arm built (its slot's, as
# try_emit_span_assoc took it), so an if / match of such arms has a `%Span$T`
# phi, not an i64 one.  `no_name()` for any other expression.
pub fn span_assoc_arm_type(s: *EmitterState, e: *Expr) -> StrView
    if e == null or e.kind != ExprKind.Method or e.args != null or name_eq(ident_sv(e), "empty") == 0
        return no_name()
    if not is_span_type_call(s, e)
        return no_name()
    slot_span_type(s)

# AGAST #2394: true when the call or method `arg` already returns an address
# (`-> @T`, `-> @&T` or `-> *T`, all i64 at a call), so an `@T` param takes
# its result as is.  Only a `-> T` struct result is a value to spill and
# auto-borrow: `sid(sid(p))` spilled sid's `@C` as a `%C` and clang refused it.
pub fn call_returns_address(s: *EmitterState, arg: *Expr) -> bool
    var t: TypeKind = expr_slot_ty(arg)
    # get_expr_type types a method's float result only.
    if arg.kind == ExprKind.Method
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return false
        t = m.return_type
    t == TypeKind.Ref or t == TypeKind.MutRef or t == TypeKind.Ptr

# What `arg`, no place, does for `p`: it passes if it's the pointer `p` is.
fn rvalue_borrow_kind(s: *EmitterState, arg: *Expr, p: *Param) -> BorrowKind
    if arg.kind == ExprKind.NilLit or arg.kind == ExprKind.CstringLit
        return BorrowKind.Rvalue
    var t: TypeKind = expr_slot_ty(arg)
    # get_expr_type types a method's float result only.
    if arg.kind == ExprKind.Method
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return BorrowKind.Untyped
        t = m.return_type
    if t == TypeKind.Ref
        return BorrowKind.Shared
    if p.param_pointee_type == TypeKind.Ptr
        if t == TypeKind.PtrPtr
            return BorrowKind.Pass
    else if kind_is_pointer(t)
        return BorrowKind.Pass
    BorrowKind.Rvalue

# Is pointer place `pl` the `*U` that `p`, a `:& *U`, borrows?
fn pointer_place_fits(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> bool
    let want: TypeKind = p.param_ref_ptr_pointee
    # Unrecorded on one side: nothing to compare, as call_check's ca_struct_ptr.
    if want == TypeKind.Void or pl.pointee == TypeKind.Unknown
        return true
    # AGAST #3101: `r:& T` at T = `*[N]E` takes a `*[N]E` place: the same N
    # and E, as ritz0 compares `[3 x i32]**` with `[2 x i32]**`.
    if want == TypeKind.Array and p.param_pointee_array_size > 0
        if pl.pointee != TypeKind.Array
            return false
        var got: ArrayDims
        if ref_arg_dims(s, arg, @got) != ARG_DIMS_ARRAY
            return true
        var dims: ArrayDims
        param_pointee_dims(@dims, p)
        return array_dims_match(@got, @dims) == 1
    if want == TypeKind.Struct or pl.pointee == TypeKind.Struct
        return want == pl.pointee and name_eq(param_type_sv(p), pl.name) == 1
    # Exactly, as place_fits_borrow: a `*u32` isn't the `*i32` (#2530).
    want == pl.pointee

# Does the place `arg`, of type `pl`, hold the `T` of `p`?  Exactly, not by
# width (Aaron's ruling on AGAST #2368), so `:& u32` doesn't take an `i32` (#2530).
fn place_fits_borrow(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> bool
    let pt: TypeKind = p.param_pointee_type
    match pl.kind
        TypeKind.Struct =>
            return pt == TypeKind.Struct and name_eq(param_type_sv(p), pl.name) == 1
        TypeKind.Array =>
            if pt != TypeKind.Array
                return false
            var got: ArrayDims
            var want: ArrayDims
            if place_array_dims(s, arg, @got) != ARG_DIMS_ARRAY
                return false
            param_pointee_dims(@want, p)
            return array_dims_match(@got, @want) == 1
        _ => pass
    # AGAST #2994: a `bool` local or param is a `bool`, though its slot is
    # kept as an i64, as ref_bool_local; so it fits no `:& i64` either.
    if arg.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, ident_sv(arg))
        if loc != null and loc.is_bool == 1
            return pt == TypeKind.Bool
    pl.kind == pt

# AGAST #2354: does `arg` name a by-value `@&U` param of the fn being emitted?
fn ident_is_ref_param(arg: *Expr) -> bool
    let f: *FnDef = emitter_current_fn()
    if arg.kind != ExprKind.Ident or f == null
        return false
    var q: *Param = f.params
    while q != null
        if q.param_type == TypeKind.MutRef and q.is_borrow == 0 and name_eq(q.name, ident_sv(arg)) == 1
            return true
        q = q.next
    false

# What a pointer place does for `p`: `*U` into `:& *U` is a place of `T`; into
# `:& U`, or `**U` into `:& *U`, it's the pointer to one, and passes.
# AGAST #2372: a `**S` as deep as `:& **S` is a place of it too: passing its value
# left the callee one level short.
fn pointer_place_kind(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> BorrowKind
    if param_borrows_struct_ptr_ptr(p) == 1
        if ptr_levels_of(s, arg).levels == ptr_ptr_ident_levels(p.param_inner_pointee_type)
            return BorrowKind.Place
    if p.param_pointee_type != TypeKind.Ptr
        return BorrowKind.Pass
    if pl.kind == TypeKind.PtrPtr or pl.pointee == TypeKind.Ptr
        return BorrowKind.Pass
    # AGAST #2354: an `@&U` place holds a pointer as a `*U` does, so it's the
    # place `:& *U`, `:& @&U` (and `:& T` at T = `@&U`) borrow, as on ritz0.
    # An `@U` one never gets here: place_behind_shared_ref refused it.  An
    # `@&U` param is no place: ritz0 gives it no storage to borrow.
    if pl.kind != TypeKind.Ptr and (pl.kind != TypeKind.MutRef or ident_is_ref_param(arg))
        return BorrowKind.Misfit
    if pointer_place_fits(s, arg, pl, p)
        return BorrowKind.Place
    BorrowKind.Misfit

# Is the place `e` an `@T`, or is the nearest indirection on its path to the
# root one?  An `@&T` or `*T` nearer than that makes it writable.
fn place_behind_shared_ref(s: *EmitterState, e: *Expr) -> bool
    var pl: PlaceType
    if place_type_of(s, e, @pl) and pl.kind == TypeKind.Ref
        return true
    var at: *Expr = e
    while at != null
        if at.kind == ExprKind.Member or at.kind == ExprKind.Index
            at = at.left
        else if at.kind == ExprKind.Unary and at.op == OpKind.Deref
            at = at.operand
            if at.kind == ExprKind.Binary
                at = find_base_expr(at)
        else
            return false
        if place_type_of(s, at, @pl)
            if pl.kind == TypeKind.Ref
                return true
            if kind_is_pointer(pl.kind)
                return false
    false

# Emits nothing, so it can be asked again at each step of a call.  What it
# refuses (a temporary, a misfit, through an `@T`, untypable) is said on Sema,
# by call_check's ca_borrow (AGAST #4244); here only BorrowKind.Place is lowered.
pub fn borrow_arg_kind(s: *EmitterState, arg: *Expr, p: *Param) -> BorrowKind
    if p == null or p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return BorrowKind.Pass
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return BorrowKind.Pass
    # An `a:& [N]T` param reads as the pointer it's bound to.
    if lent_array_ident(s, arg) != null
        return BorrowKind.Pass
    if not arg_is_place(s, arg)
        return rvalue_borrow_kind(s, arg, p)
    if place_behind_shared_ref(s, arg)
        return BorrowKind.Shared
    var pl: PlaceType
    if not place_type_of(s, arg, @pl) or pl.kind == TypeKind.Unknown
        return BorrowKind.Untyped
    if kind_is_pointer(pl.kind)
        return pointer_place_kind(s, arg, @pl, p)
    if place_fits_borrow(s, arg, @pl, p)
        return BorrowKind.Place
    BorrowKind.Misfit

# AGAST #1739 — a large by-value struct param is passed `ptr byval(%T)`.
# Spill the argument into a fresh slot right after evaluating it, before the
# next argument runs (which keeps evaluation order: a later arg cannot change
# what this one passes).  The value is almost always a `load %T` just
# emitted, so the store site emits this store as a pointer-to-pointer
# @__ritz_sret_copy (#4461).  Returns the slot; every arg-coercion
# cascade passes it through and the call writes it as `ptr byval(%T)`.
pub fn spill_byval_arg(s: *EmitterState, arg: *Expr, reg: i32, p: *Param) -> i32
    var val: i32 = reg
    # `f(@x)` for a by-value param: emit_expr gave the address as an i64
    # (the same case the free-call fallback cascade materialises with a
    # load).
    if arg != null and arg.kind == ExprKind.Unary
        if arg.op == OpKind.Addr or arg.op == OpKind.AddrMut
            let pp: i32 = ir_inttoptr_ptr(s.ir.out, @s.fcx.reg_counter, reg)
            val = next_reg(s)
            let pty: String = ir_name(param_type_sv(p))
            format_into(s, "  %.{val} = load %{pty.as_view()}, ptr %.{pp}\n")
    let slot: i32 = next_reg(s)
    let ty: String = ir_name(param_type_sv(p))
    entry_alloca_reg_begin_named(s, slot)
    format_into(s, "{ty.as_view()}  ; #1739 byval arg\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, param_type_sv(p), val, slot)
    return slot

# The constructor emit_ctor_type_error last refused.
pub var g_ctor_refused: *Expr = null

# "this constructor's type can't be inferred here", at `ctor`, once: a let or
# arms that couldn't name the enum say so, and then the constructor, emitted
# with none, reaches the fallback below (AGAST #2430, #2454).
pub fn emit_ctor_type_error(s: *EmitterState, ctor: *Expr)
    if ctor == g_ctor_refused
        return
    g_ctor_refused = ctor
    emit_nd_error_sv(s, ctor.span.line, ctor.span.col, "this constructor's type can't be inferred here: bind it with a typed `let` first")

# AGAST #2454: a Some/None/Ok/Err that nothing gives an enum is a located
# error.  It lowered to `add i64 0, 0` and the program ran on that zero: an
# array literal's, an if / match arm's, `a[i] = ` and a statement's all did,
# until each took its enum.  Inside a call argument or a slot whose type isn't
# an enum it is #1498 / #2142's refusal, now located too.  Returns an i64 zero
# so the rest of the fn still emits; the error stops the output.
pub fn emit_no_enum_ctx_error(s: *EmitterState, ctor: *Expr) -> i32
    if s.fcx.ctx_enum_arg == 1
        emit_nd_error_sv(s, ctor.span.line, ctor.span.col, "variant constructor has no enum context: the parameter or slot it goes into is not an Option/Result")
    else
        emit_ctor_type_error(s, ctor)
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0  ; constructor with no enum (error)\n")
    return z

# AGAST #2453: true when the call `e` named like a builtin constructor (Some /
# Ok / None / Err) is a user enum's variant here: a user enum declares it (or
# two do: try_emit_user_variant_ctor reports that) and no Option / Result
# slot gives the builtin an enum.  ritz0's slot decides the same way: in an
# Option-returning fn the tail `Some(7)` stays the builtin.
pub fn users_variant_wins(s: *EmitterState, e: *Expr) -> bool
    let fname: StrView = e.func_name
    if is_variant_carrier(fname) == 0 and is_variant_null(fname) == 0
        return false
    var a: i32 = 0
    var b: i32 = 0
    if user_variant_ctor_ambiguous(s.sym.mono.pctx, e, @a, @b) == 0
        let en: StrView = user_ctor_enum(s.sym.mono.pctx, e)
        if unnamed(en)
            return false
        # The let's slot is this user enum (`let x: E = Ok(5)`, or an untyped
        # let #1797 typed %E): the user's variant, whatever the fn returns.
        if s.fcx.ctx_enum_name != null and name_eq(StrView { ptr: s.fcx.ctx_enum_name, len: s.fcx.ctx_enum_name_len as i64 }, en) == 1
            return true
    if unnamed(resolve_enum_ctx(s))
        return true
    false

# A struct-typed name (`ty` TypeKind.Struct with a name), else `no_name()`.
fn struct_type_name(ty: TypeKind, name: StrView) -> StrView
    if ty != TypeKind.Struct or name.len <= 0
        return no_name()
    name

# The struct or enum a variant payload's register holds, `no_name()` for an
# i64-width scalar.  ritz1 lacks a full expr-type oracle so this peeks at the
# expression form: emit_variant_build stores by it, and a constructor
# scrutinee is named by it (AGAST #2419), so the two can't disagree.
pub fn variant_payload_aggregate(s: *EmitterState, payload_expr: *Expr) -> StrView
    match payload_expr.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, ident_sv(payload_expr))
            if loc != null and lv_var_type(loc) == TypeKind.Struct and lv_type_name_len(loc) > 0
                return lv_type_sv(loc)
            # AGAST #2144: `Ok(Vacant)` / `Some(Vacant)`, a bare unit variant
            # of a user enum, is the enum aggregate as `Ok(Opt.Vacant)` is
            # (it was stored as an i64: invalid IR).  A same-named const /
            # local / global / fn wins, as in emit_expr_ident.
            var bvi: i32 = 0
            var bother: i32 = 0
            let bei: i32 = bare_unit_variant_enum(s, payload_expr, @bvi, @bother)
            if bei >= 0
                return enum_name_view(s.sym.mono.pctx, bei)
        ExprKind.StringLit =>
            # Bare "..." lowers to a %Span$u8 aggregate (AGAST #98) —
            # layout-equal to StrView; storing it as i64 was invalid IR
            # for `Some("10")` (AGAST #1498).
            return "Span$u8"
        ExprKind.StructLit =>
            # AGAST #1362: `Some(Point { .. })` / `Ok(Font { .. })` — the
            # rvalue struct literal yields its loaded `%Struct` aggregate.
            let lit_st: *StructDef = find_struct(s, ident_sv(payload_expr))
            if lit_st != null
                return lit_st.name
        ExprKind.Member =>
            # AGAST #1664: `Some(s.value)` with a struct-typed field (StrView,
            # at any depth, through @ / * / by value) — the field load yields
            # the `%Struct` aggregate, not an i64.
            let fld: *StructField = resolve_member_chain_field(s, payload_expr)
            if fld != null
                let fname: StrView = struct_type_name(fld.field_type, fld.field_type_name)
                if not unnamed(fname)
                    return fname
            # AGAST #1466: `Err(ArgError.Bad)`, a qualified unit variant, is
            # the enum aggregate too.
            return named_by(qualified_variant_enum, s, payload_expr)
        ExprKind.Call =>
            # AGAST #1466: a user-enum ctor `Err(Missing(5))` is the enum
            # aggregate (it was stored as an i64: invalid IR).
            let en: StrView = user_ctor_enum(s.sym.mono.pctx, payload_expr)
            if not unnamed(en)
                return en
            let fn_def: *FnDef = find_call_fn(s, payload_expr)
            if fn_def != null
                return struct_type_name(fn_def.return_type, fn_def.return_type_name)
        ExprKind.Method =>
            # AGAST #1466: `Err(ArgError.Missing(s))`, likewise.
            let qen: StrView = named_by(qualified_variant_enum, s, payload_expr)
            if not unnamed(qen)
                return qen
            # AGAST #2572: `Some(v[lo..hi])` is `Some(v.slice(lo, hi))` after
            # #2451's rewrite: the `%Span$T` / `%Vec$T` / `%String` the callee
            # returns (it was stored as an i64: invalid IR).
            let md: *FnDef = method_call_def(s, payload_expr)
            if md != null
                return struct_type_name(md.return_type, md.return_type_name)
        _ => pass
    no_name()

# The struct / enum type variant `tag` of `enum_name` declares for its payload:
# a tagged enum's type argument, or a user enum's (or instance's) tuple field.
# `no_name()` when the payload is a scalar or unknown.
pub fn variant_payload_type_name(s: *EmitterState, enum_name: StrView, tag: i32) -> StrView
    let uf: *StructField = user_enum_tuple_field(s.sym.mono.pctx, enum_name, tag)
    if uf != null and uf.field_type == TypeKind.Struct
        return uf.field_type_name
    tagged_payload(s, enum_name, tag)

# AGAST #3029: 1, and the `[N]T` in *out, when `e` is an array literal or fill
# and variant `tag` of `enum_name` declares an array payload: a user enum's
# tuple field (`V([2]u8)`) or a tagged enum's argument (`Option<[2]u8>`, spelt
# `arr2_u8`).  0 for anything else.
pub fn variant_array_payload(s: *EmitterState, enum_name: StrView, tag: i32, e: *Expr, out: *ArrayArg) -> i32
    if e == null or (e.kind != ExprKind.ArrayLit and e.kind != ExprKind.ArrayFill)
        return 0
    variant_array_type(s, enum_name, tag, out)

# AGAST #3029: 1, and the `[N]T` in *out, when variant `tag` of `enum_name`
# declares an array payload.  The match binding reads it back at that type
# (emit_array_payload_bind).
pub fn variant_array_type(s: *EmitterState, enum_name: StrView, tag: i32, out: *ArrayArg) -> i32
    if enum_name.ptr == null or enum_name.len <= 0
        return 0
    let uf: *StructField = user_enum_tuple_field(s.sym.mono.pctx, enum_name, tag)
    if uf != null
        if uf.field_type != TypeKind.Array or uf.array_size <= 0
            return 0
        out.size = uf.array_size
        out.elem = uf.array_elem_type
        out.pointee = uf.array_elem_pointee
        out.name = uf.array_elem_type_name
        return 1
    let arg: StrView = tagged_payload(s, enum_name, tag)
    if unnamed(arg)
        return 0
    array_arg_decode(arg, out)

# `alloca %Enum`, zeroed, with tag `tag` stored at field 0; returns the slot.
pub fn emit_variant_slot(s: *EmitterState, enum_name: StrView, tag: i32) -> i32
    let ty: String = ir_name(enum_name)
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    format_into(s, "{ty.as_view()}  ; variant ctor\n")
    entry_alloca_reg_end(s)

    # Zero the whole struct so padding bytes are deterministic (matches
    # ritz0's default-initialized alloca).
    format_into(s, "  store %{ty.as_view()} zeroinitializer, ptr %.{slot}\n")

    # Store tag at field 0 (i8; a repr enum's discriminant, AGAST #4574).
    let tag_ptr: i32 = next_reg(s)
    gep_struct_open(s, tag_ptr, enum_name)
    format_into(s, ", ptr %.{slot}, i32 0, i32 0\n")
    emit_store_imm(s, enum_tag_ty_named(s.sym.mono.pctx, enum_name), enum_tag_value_named(s.sym.mono.pctx, enum_name, tag), tag_ptr)
    slot

# Load the enum assembled at `slot` as a value.
pub fn emit_variant_load(s: *EmitterState, slot: i32, enum_name: StrView) -> i32
    let ty: String = ir_name(enum_name)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = load %{ty.as_view()}, ptr %.{slot}\n")
    result

# "variant `V` takes N payload value(s), got M" for variant `vi` of enum `ei`
# given the list `args`: at its first value, else at `call` (AGAST #4153).
pub fn emit_payload_count_error(s: *EmitterState, ei: i32, vi: i32, args: *Expr, call: SrcSpan)
    var got: i32 = 0
    var a: *Expr = args
    while a != null
        got += 1
        a = a.next
    var at: SrcSpan = call
    if args != null
        at = args.span
    let variant: StrView = enum_variant_label(s.sym.mono.pctx, ei, vi)
    let takes: i32 = enum_variant_field_count(s.sym.mono.pctx, ei, vi)
    var msg: String = string_new()
    format_into(@&msg, "variant `{variant}` takes {takes} payload value(s), got {got}")
    emit_nd_error_sv(s, at.line, at.col, msg.as_view())

# The call `e` to variant `vi` of enum `ei`, refused with the count (AGAST
# #4153).  Returns an i64 zero so the rest of the fn still emits; the error
# stops the output.
pub fn emit_payload_count_refusal(s: *EmitterState, ei: i32, vi: i32, e: *Expr) -> i32
    emit_payload_count_error(s, ei, vi, e.args, e.span)
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0  ; miscounted variant payload (error)\n")
    return z

# The vector type the simd_* or x86 intrinsic call `call` gives its result,
# by its own operands: `no_name()` when that is the binding context's, or
# when `call` is no intrinsic.  Each arm repeats the choice its emitter
# makes (AGAST #2052) — keep them in step:
#   simd_xor/simd_add          (emit_simd_binop)   first, then second operand
#   simd_insert/shuffle/rotl   (emit_simd_insert/_shuffle/_rotl) first operand
#   simd_load/simd_loadu       (emit_simd_loadu)   context chain only
# each of those defaulting to v4i32.  An AES-NI call has its state operand's
# type (AGAST #1609); simd_clmul / simd_sad always emit <2 x i64>, whatever
# the binding context says (AGAST #2051).
fn simd_call_result_type(s: *EmitterState, call: *Expr) -> StrView
    let ci: *CallIntrinsic = call_intrinsic_named(call.func_name)
    if ci == null
        return no_name()
    var ty: StrView = no_name()
    match ci.op
        CallIntrinsicOp.X86V2i64 | CallIntrinsicOp.AesKeygenAssist =>
            return simd_arg_own_type(s, call.args)
        CallIntrinsicOp.SimdSad | CallIntrinsicOp.SimdClmul =>
            return "v2i64"
        CallIntrinsicOp.SimdXor | CallIntrinsicOp.SimdAdd =>
            if call.args == null or call.args.next == null
                return no_name()
            ty = resolve_simd_arg_type(s, call.args)
            if unnamed(ty)
                ty = resolve_simd_arg_type(s, call.args.next)
        CallIntrinsicOp.SimdInsert | CallIntrinsicOp.SimdShuffle | CallIntrinsicOp.SimdRotl =>
            if call.args == null
                return no_name()
            ty = resolve_simd_arg_type(s, call.args)
        CallIntrinsicOp.SimdLoad =>
            ty = resolve_simd_arg_type(s, null)
        CallIntrinsicOp.SimdStore | CallIntrinsicOp.SimdExtract | CallIntrinsicOp.X86V4i32 | CallIntrinsicOp.Xgetbv =>
            return no_name()
    if unnamed(ty)
        return "v4i32"
    ty

# The vector type `arg` itself has: a vector local's (locals carry
# `type_name = "v4i32"` etc.), through a `*p`, or an intrinsic call's.
fn simd_arg_own_type(s: *EmitterState, arg: *Expr) -> StrView
    if arg == null
        return no_name()
    match arg.kind
        ExprKind.Ident =>
            let lv: *LocalVar = find_local_struct_name(s, ident_sv(arg))
            if lv != null and is_simd_vector_type_name(lv_type_sv(lv)) == 1
                return lv_type_sv(lv)
        ExprKind.Unary =>
            # `*p` — check the operand (deref of *v4i32 → v4i32 value).
            return simd_arg_own_type(s, arg.operand)
        ExprKind.Call =>
            return simd_call_result_type(s, arg)
        _ => pass
    no_name()

# The vector type the binding context gives: the slot's, else the enclosing
# fn's return type — needed for tail-expression `return simd_loadu(...)`
# shapes (squeeze/crc32_simd has `fn load_vec(...) -> v2i64 \n
# simd_loadu(data as *i64)`).
fn simd_ctx_type(s: *EmitterState) -> StrView
    if s.fcx.ctx_simd_name != null and s.fcx.ctx_simd_name_len > 0
        return StrView { ptr: s.fcx.ctx_simd_name, len: s.fcx.ctx_simd_name_len as i64 }
    let ret: StrView = StrView { ptr: s.fcx.ret_type_name, len: s.fcx.ret_type_name_len as i64 }
    if ret.ptr != null and ret.len > 0 and is_simd_vector_type_name(ret) == 1
        return ret
    no_name()

# The SIMD vector type name of an arg expression: its own (simd_arg_own_type),
# else the binding context's.  `no_name()` when neither says.
pub fn resolve_simd_arg_type(s: *EmitterState, arg: *Expr) -> StrView
    let own: StrView = simd_arg_own_type(s, arg)
    if not unnamed(own)
        return own
    simd_ctx_type(s)

pub fn emit_mem_int_ty(s: *EmitterState, bits: i32)
    format_into(s, "i{bits}")

# Truncate an i64 value register to `bits` (no-op at 64).
pub fn mem_narrow(s: *EmitterState, v: i32, bits: i32) -> i32
    if bits == 64
        return v
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = trunc i64 %.{v} to i{bits}\n")
    r

# Extend an iN result to the i64 value model by the pointee's signedness.
pub fn mem_widen(s: *EmitterState, v: i32, bits: i32, ty: TypeKind) -> i32
    if bits == 64
        return v
    let ext: StrView = if ty_is_signed(ty) == 1 then "sext" else "zext"
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = {ext} i{bits} %.{v} to i64\n")
    r

# Size of one value of kind `t` (struct / enum `name` when t == TypeKind.Struct;
# a primitive spelled as a name is accepted too), or -1 for a type that does
# not exist.  Unlike elem_size_align, never falls back to 8.
fn sizeof_kind_size(s: *EmitterState, t: TypeKind, name: StrView) -> i64
    match t
        TypeKind.Struct =>
            if name.ptr == null or name.len <= 0
                return -1
            let prim: i64 = ty_store_size(ty_from_name(name))
            if prim > 0
                return prim
            if find_struct(s, name) != null or is_tagged_enum_type(name) == 1 or user_enum_index(s.sym.mono.pctx, name) >= 0
                return get_struct_size_by_name(s, name)
            return -1
        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
            return 8
        _ => pass
    let sz: i64 = ptr_pointee_size(s, t, no_name())
    if sz > 0
        return sz
    return -1

fn sizeof_shape_size(s: *EmitterState, sh: *ArrayShape, skip_outer: i32) -> i64
    var n: i64 = 1
    var d: i32 = skip_outer
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    let leaf: i64 = sizeof_kind_size(s, sh.leaf_type, sh.leaf_name)
    if leaf < 0
        return -1
    return n * leaf

fn sizeof_times(count: i64, elem: i64) -> i64
    if elem < 0
        return -1
    return count * elem

# A type alias `name`, sized; -1 when `name` is no alias (or sizes to nothing).
fn sizeof_alias_size(s: *EmitterState, name_sv: StrView) -> i64
    var count: i64 = 0
    var leaf: TypeKind = TypeKind.Void
    var leaf_name: *u8 = null
    var leaf_len: i32 = 0
    if type_alias_sizeof_shape(s.sym.mono.pctx, name_sv, @count, @leaf, @leaf_name, @leaf_len) == 0
        return -1
    return sizeof_times(count, sizeof_kind_size(s, leaf, StrView { ptr: leaf_name, len: leaf_len as i64 }))

# Is `name` a value in scope: a local or param, a global or a const?
fn sizeof_is_value(s: *EmitterState, name: StrView) -> bool
    find_local_idx(s, name) >= 0 or find_global(s, name) != null or find_const_entry(s, name) != null

# A type spelled as an identifier: a primitive, struct, enum or alias.
fn sizeof_type_name_size(s: *EmitterState, name_sv: StrView) -> i64
    let alias_sz: i64 = sizeof_alias_size(s, name_sv)
    if alias_sz >= 0
        return alias_sz
    return sizeof_kind_size(s, TypeKind.Struct, name_sv)

# Does `e` spell a type rather than a value (`u8`, `Pair`, `*Pair`)?  The
# operand of `sizeof(*u8)` parses as a deref of the name `u8`.
fn sizeof_names_type(s: *EmitterState, e: *Expr) -> bool
    if e == null
        return false
    match e.kind
        ExprKind.TypeOperand =>
            return true
        ExprKind.Ident =>
            return not sizeof_is_value(s, ident_sv(e)) and sizeof_type_name_size(s, ident_sv(e)) >= 0
        ExprKind.Unary =>
            if e.op == OpKind.Deref or e.op == OpKind.Addr or e.op == OpKind.AddrMut
                return sizeof_names_type(s, e.operand)
        _ => pass
    false

# The newest declaration of `name` in this function (null if none, or if
# the table overflowed and can no longer be trusted).
fn sizeof_find_decl(s: *EmitterState, name_sv: StrView) -> *NarrowDecl
    if s.fcx.narrow_decl_overflow != 0
        return null
    var i: i32 = s.fcx.narrow_decl_count - 1
    while i >= 0
        let d: *NarrowDecl = @s.fcx.narrow_decls[i]
        if name_eq(StrView { ptr: d.name, len: d.name_len as i64 }, name_sv) == 1
            return d
        i = i - 1
    return null

fn sizeof_local_size(s: *EmitterState, lv: *LocalVar, depth: i32) -> i64
    let t: TypeKind = lv_var_type(lv)
    match t
        TypeKind.Array =>
            if lv_array_shape(lv) != null
                return sizeof_shape_size(s, lv_array_shape(lv), 0)
            return sizeof_times(lv_array_size(lv) as i64, sizeof_kind_size(s, lv_array_elem_type(lv), lv_type_sv(lv)))
        TypeKind.Struct =>
            return sizeof_kind_size(s, TypeKind.Struct, lv_type_sv(lv))
        _ => pass
    if lv.is_bool == 1
        return 1
    if ty_bits(t) == 0
        return sizeof_kind_size(s, t, lv_type_sv(lv))
    # An integer slot: ritz1 keeps every integer in i64, and the parser
    # defaults a missing annotation to TypeKind.I64, so the slot can't say.
    # An unannotated `let x = init` has init's type, as in ritz0.
    let d: *NarrowDecl = sizeof_find_decl(s, lv.name)
    if d != null and d.declared == TypeKind.Void
        if d.init == null
            return -1
        return sizeof_expr_size(s, d.init, depth + 1)
    return sizeof_kind_size(s, t, no_name())

fn sizeof_global_size(s: *EmitterState, g: *GlobalVarDef) -> i64
    if g.var_type == TypeKind.Array
        if g.array_shape != null
            return sizeof_shape_size(s, g.array_shape, 0)
        return sizeof_times(g.array_size as i64, sizeof_kind_size(s, g.array_elem_type, g.array_elem_type_name))
    return sizeof_kind_size(s, g.var_type, g.type_name)

fn sizeof_ident_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    # A value in scope wins over a type of the same name, as in ritz0.
    # The written integer type first (narrow_ident_type: consts, annotated
    # locals, params, narrow globals).
    let nt: TypeKind = narrow_ident_type(s, e)
    if nt != TypeKind.NarrowUnknown
        return sizeof_kind_size(s, nt, no_name())
    let lidx: i32 = find_local_idx(s, ident_sv(e))
    if lidx >= 0
        return sizeof_local_size(s, local_at(s, lidx), depth)
    let g: *GlobalVarDef = find_global(s, ident_sv(e))
    if g != null
        return sizeof_global_size(s, g)
    let ce: *ConstEntry = find_const_entry(s, ident_sv(e))
    if ce != null
        if ce.const_type == TypeKind.Array
            return sizeof_times(ce.array_size as i64, sizeof_kind_size(s, ce.array_elem_type, ce.array_elem_type_name))
        return sizeof_kind_size(s, ce.const_type, ce.type_name)
    return sizeof_type_name_size(s, ident_sv(e))

# The struct an element of array `b` (a local or global ident) is, or `no_name()`.
fn sizeof_array_elem_struct(s: *EmitterState, b: *Expr) -> StrView
    if b.kind != ExprKind.Ident
        return no_name()
    let lidx: i32 = find_local_idx(s, ident_sv(b))
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        if lv_var_type(lv) == TypeKind.Array and lv_array_shape(lv) == null and lv_array_elem_type(lv) == TypeKind.Struct
            return lv_type_sv(lv)
        return no_name()
    let g: *GlobalVarDef = find_global(s, ident_sv(b))
    if g != null and g.var_type == TypeKind.Array and g.array_shape == null and g.array_elem_type == TypeKind.Struct
        return g.array_elem_type_name
    no_name()

# The field `e` (an ExprKind.Member) names: member_field_def's receivers, plus
# an element of a struct array (`ps[i].f`).
fn sizeof_member_field(s: *EmitterState, e: *Expr) -> *StructField
    let f: *StructField = member_field_def(s, e)
    if f != null
        return f
    # AGAST #2152: `arr[i].m`, `(*p).m`, `g[i][j].m` -- the emitter's own
    # type-only resolver.
    let rf: *StructField = resolve_member_chain_field(s, e)
    if rf != null
        return rf
    if e.left == null or e.left.kind != ExprKind.Index
        return null
    let sname: StrView = sizeof_array_elem_struct(s, e.left.left)
    if unnamed(sname)
        return null
    let st: *StructDef = find_struct(s, sname)
    if st == null
        return null
    let idx: i32 = find_field_index(st, ident_sv(e))
    if idx < 0
        return null
    return get_field_type(st, idx)

# `base[i]`: one element of an array (local, global or field) or pointer.
fn sizeof_index_size(s: *EmitterState, e: *Expr) -> i64
    if e.right != null and e.right.kind == ExprKind.Range
        return -1
    # AGAST #2152: any index chain over an N-D array (local, global or a
    # field through any base): `s.m[0][1]`, `arr[1].m[0][2]`, `g[1][2]`.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null
        return sizeof_shape_size(s, nd_sh, nd_depth)
    let b: *Expr = e.left
    if b.kind == ExprKind.Member
        let f: *StructField = member_field_def(s, b)
        if f == null
            return -1
        if f.field_type == TypeKind.Array and f.array_shape != null
            return sizeof_shape_size(s, f.array_shape, 1)   # AGAST #2097: a row
        match f.field_type
            TypeKind.Array =>
                return sizeof_kind_size(s, f.array_elem_type, f.array_elem_type_name)
            TypeKind.Ptr =>
                return sizeof_kind_size(s, ptr_field_elem_kind(f), f.field_type_name)
            _ => pass
        return -1
    if b.kind != ExprKind.Ident
        return -1
    let lidx: i32 = find_local_idx(s, ident_sv(b))
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        match lv_var_type(lv)
            TypeKind.Array =>
                if lv_array_shape(lv) != null
                    return sizeof_shape_size(s, lv_array_shape(lv), 1)
                return sizeof_kind_size(s, lv_array_elem_type(lv), lv_type_sv(lv))
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>
                return sizeof_kind_size(s, lv_pointee_type(lv), lv_type_sv(lv))
            _ => pass
        return -1
    let g: *GlobalVarDef = find_global(s, ident_sv(b))
    if g != null
        match g.var_type
            TypeKind.Array =>
                if g.array_shape != null
                    return sizeof_shape_size(s, g.array_shape, 1)
                return sizeof_kind_size(s, g.array_elem_type, g.array_elem_type_name)
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>   # AGAST #1554: S is in pointee_type_name
                return sizeof_kind_size(s, g.pointee_type, g.pointee_type_name)
            _ => pass
    return -1

# `*p`: the pointee of a pointer local / param / global, or of a pointer
# field (`*w.t.v`, through a generic instance's fields too: AGAST #3747).
fn sizeof_deref_size(s: *EmitterState, e: *Expr) -> i64
    let o: *Expr = e.operand
    if o != null and o.kind == ExprKind.Member
        let f: *StructField = sizeof_member_field(s, o)
        if f == null
            return -1
        match f.field_type
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>
                return sizeof_kind_size(s, ptr_field_elem_kind(f), f.field_type_name)
            _ => pass
        return -1
    if o == null or o.kind != ExprKind.Ident
        return -1
    let lidx: i32 = find_local_idx(s, ident_sv(o))
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        match lv_var_type(lv)
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                return sizeof_kind_size(s, lv_pointee_type(lv), lv_type_sv(lv))
            _ => pass
        return -1
    let g: *GlobalVarDef = find_global(s, ident_sv(o))
    if g != null
        match g.var_type
            TypeKind.PtrPtr =>
                return 8
            # AGAST #1554: a global keeps a struct pointee's name in
            # pointee_type_name (type_name is null), and `@S` is a pointer too.
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                return sizeof_kind_size(s, g.pointee_type, g.pointee_type_name)
            _ => pass
    return -1

# Size of `e`'s type, or -1 when it can't be determined.  `depth` bounds the
# walk through unannotated locals' initialisers.
fn sizeof_expr_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    if e == null or depth > 16
        return -1
    let k: ExprKind = e.kind
    match k
        ExprKind.TypeOperand =>
            return sizeof_times(e.int_val, sizeof_kind_size(s, e.type_kind, ident_sv(e)))
        ExprKind.Ident =>
            return sizeof_ident_size(s, e, depth)
        ExprKind.IntLit | ExprKind.FloatLit | ExprKind.CstringLit =>
            return 8
        ExprKind.CharLit =>
            return 1
        ExprKind.StringLit =>
            return sizeof_kind_size(s, TypeKind.Struct, "StrView")
        ExprKind.Member =>
            let f: *StructField = sizeof_member_field(s, e)
            if f == null
                return -1
            if f.field_type == TypeKind.Array and f.array_shape != null
                return sizeof_shape_size(s, f.array_shape, 0)   # AGAST #2097
            if f.field_type == TypeKind.Array
                return sizeof_times(f.array_size as i64, sizeof_kind_size(s, f.array_elem_type, f.array_elem_type_name))
            return sizeof_kind_size(s, f.field_type, f.field_type_name)
        ExprKind.Index =>
            return sizeof_index_size(s, e)
        ExprKind.Unary =>
            if sizeof_names_type(s, e)
                return 8   # `*u8`, `@Pair`: a pointer type
            match e.op
                OpKind.Addr | OpKind.AddrMut =>
                    return 8
                OpKind.Deref =>
                    return sizeof_deref_size(s, e)
                _ => pass
            return sizeof_expr_size(s, e.operand, depth + 1)
        ExprKind.Binary =>
            # As ritz0: a comparison or `and`/`or` is a bool, anything else
            # has its left operand's type.
            if op_is_cmp_or_logic(e.op)
                return 1
            return sizeof_expr_size(s, e.left, depth + 1)
        ExprKind.Cast =>
            return sizeof_kind_size(s, e.type_kind, no_name())
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, e)
            if fd == null
                return -1
            return sizeof_kind_size(s, fd.return_type, fd.return_type_name)
        _ => pass
    return -1

# "error: <file>:<line>:<col>: sizeof: ..." — counted, so main refuses to
# write the output.
fn sizeof_error(s: *EmitterState, e: *Expr, name: StrView)
    format_into(s, "  ; ERROR: sizeof operand\n")
    diag_error_at(emitter_source_file(), e.span)
    if unnamed(name)
        eprints("sizeof: cannot determine the type of this expression\n")
    else
        eprints("sizeof: unknown type or value `")
        eprint_bytes(name)
        eprints("`\n")
    s.diag.error_count = s.diag.error_count + 1

# The constant `sizeof(...)` folds to; reports and returns 0 when unknown.
pub fn sizeof_call_value(s: *EmitterState, e: *Expr) -> i64
    let arg: *Expr = e.args
    if arg == null or arg.next != null
        emit_nd_error_sv(s, e.span.line, e.span.col, "sizeof takes exactly one argument (a type or an expression)")
        return 0
    let sz: i64 = sizeof_expr_size(s, arg, 0)
    if sz >= 0
        return sz
    if arg.kind == ExprKind.Ident and not sizeof_is_value(s, ident_sv(arg))
        sizeof_error(s, arg, ident_sv(arg))
    else
        sizeof_error(s, arg, no_name())
    return 0

# A call-position compiler intrinsic, lowered inline and never an extern.
# SIMD builtins (AGAST #167) become native LLVM vector instructions: the
# generic call path's `call i64 @simd_loadu(ptr ...)` then `store %v4i32`
# failed the IR verifier (ritz0's _try_emit_simd_builtin).  The x86 SHA-NI /
# AES-NI ones take and return vectors and map onto `llvm.x86.*` directly.
enum CallIntrinsicOp
    SimdLoad
    SimdStore
    SimdXor
    SimdAdd
    SimdExtract
    SimdInsert
    SimdShuffle
    SimdRotl
    SimdSad
    SimdClmul
    X86V4i32
    X86V2i64
    AesKeygenAssist
    Xgetbv

# `llvm` names an X86* op's LLVM intrinsic; `arg` is its operand count, or a
# SimdLoad / SimdStore's unaligned flag.
struct CallIntrinsic
    name: StrView
    op: CallIntrinsicOp
    llvm: StrView
    arg: i32

const CALL_INTRINSICS: [22]CallIntrinsic = [
    CallIntrinsic { name: "simd_loadu", op: CallIntrinsicOp.SimdLoad, llvm: "", arg: 1 },
    CallIntrinsic { name: "simd_load", op: CallIntrinsicOp.SimdLoad, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_storeu", op: CallIntrinsicOp.SimdStore, llvm: "", arg: 1 },
    CallIntrinsic { name: "simd_store", op: CallIntrinsicOp.SimdStore, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_xor", op: CallIntrinsicOp.SimdXor, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_add", op: CallIntrinsicOp.SimdAdd, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_extract", op: CallIntrinsicOp.SimdExtract, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_insert", op: CallIntrinsicOp.SimdInsert, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_shuffle", op: CallIntrinsicOp.SimdShuffle, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_rotl", op: CallIntrinsicOp.SimdRotl, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_sad", op: CallIntrinsicOp.SimdSad, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_clmul", op: CallIntrinsicOp.SimdClmul, llvm: "", arg: 0 },
    CallIntrinsic { name: "sha256rnds2", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256rnds2", arg: 3 },
    CallIntrinsic { name: "sha256msg1", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256msg1", arg: 2 },
    CallIntrinsic { name: "sha256msg2", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256msg2", arg: 2 },
    CallIntrinsic { name: "aesenc", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesenc", arg: 2 },
    CallIntrinsic { name: "aesenclast", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesenclast", arg: 2 },
    CallIntrinsic { name: "aesdec", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesdec", arg: 2 },
    CallIntrinsic { name: "aesdeclast", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesdeclast", arg: 2 },
    CallIntrinsic { name: "aesimc", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesimc", arg: 1 },
    CallIntrinsic { name: "aeskeygenassist", op: CallIntrinsicOp.AesKeygenAssist, llvm: "", arg: 0 },
    CallIntrinsic { name: "xgetbv", op: CallIntrinsicOp.Xgetbv, llvm: "", arg: 0 }
]

# The intrinsic `name` calls, or null.
pub fn call_intrinsic_named(name: StrView) -> *CallIntrinsic
    for i in 0..22
        if name_eq(name, CALL_INTRINSICS[i].name) == 1
            return @CALL_INTRINSICS[i]
    null

# The `call` keyword and result type after `%r = `, for a first-class result.
# `call_cc` is the calling convention, with its trailing space, or "".
pub fn emit_call_ret_kw(s: *EmitterState, fn_def: *FnDef, ret_type: TypeKind, ret_sv: StrView, call_cc: StrView)
    format_into(s, " = call {call_cc}")
    if ret_array_of(fn_def) != null
        # AGAST #2302: a `[N x T]` value, which emit_array_local_whole_assign
        # stores; a discarded call drops it.
        emit_fn_ret_llvm_type(s, fn_def)
        format_into(s, " ")
    else if ret_type == TypeKind.Struct and ret_sv.len > 0
        # emit_llvm_type_struct routes tagged-enum Result$/Option$ to i64
        # (task-99 cluster #3).
        emit_llvm_type_struct(s, TypeKind.Struct, ret_sv)
        format_into(s, " ")
    else
        # As the callee is defined: `define i1 @f(...)` for a bool (the
        # zext-to-i64 is widen_call_result's), `ptr` for an `@&T`, and i64 for
        # a `*T` / `@T` (ritz1's value model); never Void (`call void` is the
        # caller's).
        format_into(s, "{llvm_text(ty_value_llvm(ret_type))} ")

# A call's result in the i64 value model: narrow ints and bools extended.
pub fn widen_call_result(s: *EmitterState, ret_type: TypeKind, ret_sv: StrView, call_result: i32) -> i32
    var t: TypeKind = ret_type
    if ret_type == TypeKind.Struct and ret_sv.len > 0 and is_primitive_type_name(ret_sv) == 1
        # Post-monomorph primitive return (vec_push_u16_method parity):
        # generic `T` substituted with u16/i32/etc. leaves TypeKind.Struct in
        # the AST.  emit_llvm_type_struct emitted the LLVM primitive type
        # for the `call` opcode; now extend to i64 so the caller's
        # expression-level representation stays uniform.  A bool, usize,
        # isize, u64, i64, f32 or f64 needs no extension.
        t = ty_from_name(ret_sv)
        if ty_int_bits(t) == 0 or ty_int_bits(t) == 64
            return call_result
    match t
        TypeKind.Bool => return ir_zext_i1_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.I32 => return ir_sext_i32_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.U32 => return ir_zext_i32_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.I16 => return ir_sext_i16_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.U16 => return ir_zext_i16_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.I8 => return ir_sext_i8_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        TypeKind.U8 => return ir_zext_i8_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        # A `-> @&T` call returns a ptr: an i64 for the value model.
        TypeKind.MutRef => return ir_ptrtoint_i64(s.ir.out, @s.fcx.reg_counter, call_result)
        # `-> *T` / `-> @T` calls return an i64 already, as does the rest.
        _ => pass
    call_result

# AGAST #4603: `br` on the Option / Result tag in `tag_reg` (an i8; Some /
# Ok is 0): a None / Err goes to a block that calls `llvm.trap` and ends
# `unreachable`, ritz0's `unwrap.bad`.  Emission carries on in the Some / Ok
# block.  No `declare`: LLVM's IR parser declares an `llvm.*` intrinsic itself,
# as it does the undeclared `@llvm.memcpy` calls elsewhere.
pub fn emit_unwrap_tag_trap(s: *EmitterState, tag_reg: i32)
    let ok_i1: i32 = next_reg(s)
    format_into(s, "  %.{ok_i1} = icmp eq i8 %.{tag_reg}, 0  ; unwrap tag check (Ok/Some == 0)\n")
    let l_ok: i32 = next_label(s)
    let l_bad: i32 = next_label(s)
    format_into(s, "  br i1 %.{ok_i1}, label %L{l_ok}, label %L{l_bad}\n")
    begin_block(s, l_bad)
    format_into(s, "  call void @llvm.trap()  ; unwrap of None / Err\n  unreachable\n")
    begin_block(s, l_ok)

# Intrinsic declarations referenced by the current module: bit
# (method_id * 4 + width_index).  Cleared once emitted.
pub var g_bitops_decl_mask: i64 = 0

# A BitOps integer method and the `llvm.*` intrinsic it lowers to.  Its index
# is the method id (bitops_method_id).
struct BitOp
    method: StrView
    intrinsic: StrView

const BIT_OPS: [6]BitOp = [
    BitOp { method: "rotl", intrinsic: "fshl" },
    BitOp { method: "rotr", intrinsic: "fshr" },
    BitOp { method: "clz", intrinsic: "ctlz" },
    BitOp { method: "ctz", intrinsic: "cttz" },
    BitOp { method: "popcnt", intrinsic: "ctpop" },
    BitOp { method: "swap_bytes", intrinsic: "bswap" }
]

# 0 rotl, 1 rotr, 2 clz, 3 ctz, 4 popcnt, 5 swap_bytes; -1 otherwise.
pub fn bitops_method_id(name: StrView) -> i32
    for i in 0..6
        if name_eq(name, BIT_OPS[i].method) == 1
            return i as i32
    -1

# Static type of a BitOps receiver.  get_expr_type reports TypeKind.I64 for any
# method call; a BitOps chain is refined here so `x.rotl(1).rotl(2)` rotates
# at x's width, as ritz0 does.  A binary keeps get_expr_type's left-operand
# typing — ritz0 also types `(0 | x)` as i64, and the two must agree.
pub fn int_method_recv_type(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind == ExprKind.Method
        let mid: i32 = bitops_method_id(ident_sv(e))
        if mid == 2 or mid == 3 or mid == 4
            return TypeKind.U8
        if mid >= 0
            return int_method_recv_type(s, e.left)
    if e.kind == ExprKind.Binary
        return int_method_recv_type(s, e.left)
    expr_slot_ty(e)

# `@llvm.<intrinsic>.iN` for BitOps method `mid` at `bits`.
pub fn emit_bitops_intrinsic_name(s: *EmitterState, mid: i32, bits: i32)
    format_into(s, "@llvm.{BIT_OPS[mid].intrinsic}.i{bits}")

# Emit `declare`s for every BitOps intrinsic this module called.  Called from
# emit_module's trailer; the mask is reset so a later module starts clean.
# The rotates (fshl / fshr) take three operands, ctlz / cttz an i1 flag after
# theirs.
pub fn emit_bitops_intrinsic_decls(s: *EmitterState)
    for m in 0..6
        let mid: i32 = m as i32
        for wi in 0..4
            let bit: i64 = (mid * 4) as i64 + wi
            let bits: i32 = (8 << wi) as i32
            if ((g_bitops_decl_mask >> bit) & 1) == 1
                format_into(s, "declare i{bits} ")
                emit_bitops_intrinsic_name(s, mid, bits)
                if mid <= 1
                    format_into(s, "(i{bits}, i{bits}, i{bits})\n")
                else if mid <= 3
                    format_into(s, "(i{bits}, i1)\n")
                else
                    format_into(s, "(i{bits})\n")
    g_bitops_decl_mask = 0

# llvm.fabs declarations referenced by the current module: bit 0 f32, bit 1
# f64.  Cleared once emitted.
pub var g_float_decl_mask: i64 = 0

# The LLVM type of float kind `ft`: `float` for an f32, else `double`.
fn float_llvm_ty(ft: TypeKind) -> StrView
    if ft == TypeKind.F32 then "float" else "double"

pub fn emit_float_llvm_ty(s: *EmitterState, ft: TypeKind)
    format_into(s, "{float_llvm_ty(ft)}")

# Emit `declare`s for every float intrinsic this module called.  Called from
# emit_module's trailer, beside emit_bitops_intrinsic_decls.
pub fn emit_float_intrinsic_decls(s: *EmitterState)
    if (g_float_decl_mask & 1) == 1
        format_into(s, "declare float @llvm.fabs.f32(float)\n")
    if (g_float_decl_mask & 2) == 2
        format_into(s, "declare double @llvm.fabs.f64(double)\n")
    g_float_decl_mask = 0
    for k in 0..16
        if ((g_fptoi_sat_mask >> k) & 1) == 1
            let sat: FptoiSat = fptoi_sat_of(k as i32)
            format_into(s, "declare i{sat.bits} @llvm.fpto{sat.sign}i.sat.i{sat.bits}.{sat.src}({sat.src_ty})\n")
    g_fptoi_sat_mask = 0

# llvm.fpto[su]i.sat declarations referenced by the current module, one bit per
# (source width, signedness, target width): see fptoi_sat_key.  Cleared once
# emitted, by emit_float_intrinsic_decls.
pub var g_fptoi_sat_mask: i64 = 0

# Bit index for a saturating conversion: bit 3 = f64 source, bit 2 = unsigned,
# bits 0-1 = log2(target bits / 8).
fn fptoi_sat_key(ft: TypeKind, bits: i32, unsigned: bool) -> i32
    var k: i32 = 3
    if bits == 8
        k = 0
    else if bits == 16
        k = 1
    else if bits == 32
        k = 2
    if unsigned
        k = k + 4
    if ft != TypeKind.F32
        k = k + 8
    k

# The parts of `iN @llvm.fpto[su]i.sat.iN.f{32,64}` for key `k`.
struct FptoiSat
    bits: i32
    sign: StrView     # `s` / `u`
    src: StrView      # `f32` / `f64`
    src_ty: StrView   # `float` / `double`

fn fptoi_sat_of(k: i32) -> FptoiSat
    let f64_src: bool = (k & 8) == 8
    let sign: StrView = if (k & 4) == 4 then "u" else "s"
    let src: StrView = if f64_src then "f64" else "f32"
    let src_ty: StrView = if f64_src then "double" else "float"
    FptoiSat { bits: (8 << (k & 3)) as i32, sign: sign, src: src, src_ty: src_ty }

# `x as <int>` for a float `x` of type ft (LANGUAGE_SPEC §7.5, AGAST #2192):
# round toward zero, saturate at the target's range, NaN is 0, then extend back
# to the i64 every integer is carried in, by the target's signedness.  A bare
# fptosi is poison out of range (`200.0 as u8` through an i8), and could not
# reach a u64 above 2^63 at all.  ritz0's _emit_float_to_int_sat.
pub fn emit_float_to_int_sat(s: *EmitterState, ft: TypeKind, x: i32, target_ty: TypeKind) -> i32
    var signed: i32 = 1
    let bits: i32 = type_code_scalar_bits(target_ty, @signed)
    let unsigned: bool = signed == 0 or target_ty == TypeKind.U64
    let k: i32 = fptoi_sat_key(ft, bits, unsigned)
    g_fptoi_sat_mask = g_fptoi_sat_mask | (1 << k)
    let sat: FptoiSat = fptoi_sat_of(k)
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = call i{sat.bits} @llvm.fpto{sat.sign}i.sat.i{sat.bits}.{sat.src}({float_llvm_ty(ft)} %.{x})\n")
    if bits == 64
        return r
    let ext: StrView = if unsigned then "zext" else "sext"
    let wide: i32 = next_reg(s)
    format_into(s, "  %.{wide} = {ext} i{bits} %.{r} to i64\n")
    wide

# `t = sitofp(fptosi(x))`: truncation toward zero through i64.
pub fn emit_float_trunc(s: *EmitterState, ft: TypeKind, x: i32) -> i32
    let fty: StrView = float_llvm_ty(ft)
    let i: i32 = next_reg(s)
    format_into(s, "  %.{i} = fptosi {fty} %.{x} to i64\n")
    let t: i32 = next_reg(s)
    format_into(s, "  %.{t} = sitofp i64 %.{i} to {fty}\n")
    t

# `<dst> = select i1 <c>, T <a>, T <b>`
pub fn emit_float_select(s: *EmitterState, ft: TypeKind, cond: i32, a: i32, b: i32) -> i32
    let fty: StrView = float_llvm_ty(ft)
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = select i1 %.{cond}, {fty} %.{a}, {fty} %.{b}\n")
    r

# `E.from(v)` on the bare name of an enum (not a local or global) that is
# still a method call here: monomorph rewrites every one into `E__from(v)`
# when the generated fn exists (rewrite_enum_from_call, in both its walk and
# its clones of generic bodies), so this is the enum without one -- the
# located error ritz0 gives (enum_from.py).  -1 when `e` is no such call.
pub fn try_emit_enum_from(s: *EmitterState, e: *Expr) -> i32
    if is_enum_from_call(s.sym.mono.pctx, e) == 0
        return -1
    let en: StrView = ident_sv(e.left)
    if find_local(s, en) >= 0 or find_global(s, en) != null
        return -1
    format_into(s, "  ; ERROR: enum has no from\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints("enum '")
    eprint_bytes(en)
    eprints("' has no 'from': that needs a representation type ('enum ")
    eprint_bytes(en)
    eprints(": <integer type>') and its module must import ritzlib.option\n")
    s.diag.error_count = s.diag.error_count + 1
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0\n")
    z

# LANGUAGE_SPEC §5.4 (AGAST #2403): a `self` that's a pointer to a pointer
# takes the levels it asks for, so a place one level short of it is lent, as
# `T.m(x)` of a by-value `self`: a type isn't a receiver, and the struct has no
# `self` slot to go to, as in ritz0 (ref_rules.static_call_of_self, AGAST #2292).
# Unlocated, a struct local's `%C` went to the `ptr` and segfaulted.
pub fn static_call_of_self_error(s: *EmitterState, e: *Expr, m: *FnDef)
    let ty: StrView = ident_sv(e.left)
    let method: StrView = m.name
    format_into(s, "  ; ERROR: static call of a `self` method (AGAST #2292)\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints("Static method call Type.method() but method '")
    eprint_bytes(method)
    # The hint, as ritz0 words it: `c.get()` or `C_get(@&c)` (`C_get(c)` of a
    # by-value `self`), the type's name in lower case for the receiver (#3236).
    eprints("' expects 'self' parameter: write `")
    eprint_lower(ty)
    eprint_char('.')
    eprint_bytes(method)
    eprints("()` or `")
    eprint_bytes(ty)
    eprint_char('_')
    eprint_bytes(method)
    eprint_char('(')
    if param_self_is_value(m.params) == 0
        eprints("@&")
    eprint_lower(ty)
    eprints(")`\n")
    s.diag.error_count = s.diag.error_count + 1

# `text` to stderr, ASCII upper case lowered.
fn eprint_lower(text: StrView)
    for i in 0..text.len
        let ch: u8 = text.get(i)
        if ch >= 'A' and ch <= 'Z'
            eprint_char(ch + 32)
        else
            eprint_char(ch)

# `@&recv` (`@recv` for `@*S`), the rule `name:& *U` has (§13.3).  Nothing else
# is borrowed for it: a call result, or a receiver two levels short, is
# refused.  `recv_levels` is what the receiver holds, -1 if unknown.  True
# when it reported an error.
pub fn refuse_receiver_short_of_self(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32) -> bool
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return false
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels >= want
        return false
    # A place one short is lent; a `let`'s is refused on Sema (let_check_receiver).
    if recv_levels + 1 == want and arg_is_place(s, recv)
        return false
    format_into(s, "  ; ERROR: receiver short of `self` (AGAST #2403)\n")
    diag_error_at(emitter_source_file(), recv.span)
    eprints("a receiver of a pointer `self` must be a place one level short of it, or have its levels\n")
    s.diag.error_count = s.diag.error_count + 1
    true

# AGAST #3071: true for `a[i]` of a local array, which emit_lvalue_ptr places.
pub fn recv_elem_is_local_array(s: *EmitterState, recv: *Expr) -> bool
    if recv.left == null or recv.left.kind != ExprKind.Ident
        return false
    let arr: *LocalVar = find_local_struct_name(s, ident_sv(recv.left))
    arr != null and lv_var_type(arr) == TypeKind.Array

# AGAST #3071: `self: **S` (any `self` two levels or more from its struct) is
# passed at the levels it declares, from `base`, the receiver's place, which
# holds `recv_levels` pointers.  1 when it set `*out`.  A receiver with no
# place is an error here, not a `*S` passed as the `**S`.
pub fn pass_self_at_its_levels(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32, base: i32, out: *i32) -> i32
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return 0
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels + 1 < want
        return 0
    if base < 0
        emit_nd_error_sv(s, recv.span.line, recv.span.col, "this receiver of a `self` two levels from its struct isn't lowered (AGAST #2404)")
        return 0
    *out = emit_load_levels(s, base, recv_levels + 1 - want)
    1

# AGAST #2404: the levels between `recv` and its struct when it's a `**S` or
# deeper that no arm of emit_expr_method names: a global (`var G: **S`), an
# element of a `[N]**S` array, or `a[i]` through a `***S`.  ptr_levels_of types
# all but the last; `a[i]` on a pointer is one level short of `a`.  The
# levels and the struct's name; 0 levels and `no_name()` otherwise.
pub fn recv_ptr_ptr_levels(s: *EmitterState, recv: *Expr) -> PtrLevels
    var pl: PtrLevels = PtrLevels { levels: 0, inner: TypeKind.Void, name: no_name() }
    if recv.kind == ExprKind.Ident or recv.kind == ExprKind.Index
        pl = ptr_levels_of(s, recv)
    if pl.levels == 0 and recv.kind == ExprKind.Index and recv.left != null and (recv.right == null or recv.right.kind != ExprKind.Range)
        pl = ptr_levels_of(s, recv.left)
        pl.levels = pl.levels - 1
    if pl.levels < 2 or pl.inner != TypeKind.Struct or pl.name.len <= 0
        return PtrLevels { levels: 0, inner: TypeKind.Void, name: no_name() }
    pl

# AGAST #3199: S when the index `ie` (`a[i]`) yields a `*S` -- `a: [N]*S`,
# whose `*(a[i] + j)` deref_pointee_struct_name names -- else null.  Only a
# struct find_struct lists: its trusted names include enums.
pub fn index_elem_ptr_struct(s: *EmitterState, ie: *Expr) -> *StructDef
    let name: StrView = deref_pointee_struct_name(s, ie)
    if name.len <= 0
        return null
    find_struct(s, name)

# AGAST #3234: S when the field chain `m` (`v.a`, `x.y.a`) is an inline `[N]S`
# array field, else null.  Type-only: nothing is emitted.
pub fn field_struct_array_elem(s: *EmitterState, m: *Expr) -> *StructDef
    let f: *StructField = resolve_member_chain_field(s, m)
    if f == null or f.field_type != TypeKind.Array or f.array_elem_type != TypeKind.Struct or f.array_shape != null
        return null
    if f.array_elem_type_name.len <= 0
        return null
    find_struct(s, f.array_elem_type_name)

# Is `p` a `Span<T>` parameter (`Span$...`)?
pub fn is_span_param(p: *Param) -> bool
    if p.param_type != TypeKind.Struct or p.param_type_name.ptr == null or p.param_type_name.len <= 4
        return false
    param_type_sv(p).starts_with("Span$")

# AGAST #4294 (R36's revisit): the impl target a receiver names when it is a
# primitive or a `*u8` — `i64`, `bool`, `ptr_u8`.  `no_name()` for anything
# else.  A declared type keeps its name (the arms above resolve those).
# ritz1's value model puts a `*u8` in a slot as an i64, so only the declared
# pointee says.
pub fn builtin_receiver_name(s: *EmitterState, recv: *Expr) -> StrView
    if recv == null or recv.kind != ExprKind.Ident
        return no_name()
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(recv))
    if loc == null or lv_type_name_len(loc) > 0
        return no_name()
    if loc.is_bool == 1
        # A bool local's slot is an i64 (var_type TypeKind.I64); is_bool remembers
        # the declared type (AGAST #1521).
        return "bool"
    match lv_var_type(loc)
        TypeKind.Ref | TypeKind.MutRef =>
            if lv_pointee_type(loc) == TypeKind.Ptr and lv_inner_pointee_type(loc) == (TypeKind.U8 as i32)
                return "ptr_u8"
            return primitive_spelling(lv_pointee_type(loc))
        TypeKind.Ptr =>
            if lv_pointee_type(loc) == TypeKind.U8
                return "ptr_u8"
            return no_name()
        _ => pass
    primitive_spelling(lv_var_type(loc))

# A `"..."`, or a literal local (both %Span$u8, #98, #2103), into a method's
# `StrView` param `p`: rebuilt as a %StrView, as the free-call and UFCS arms
# do (emit_strview_from_lit).  Shared by the instance and static arms, which
# passed the %Span$u8 register under %StrView (AGAST #3495: `impl String`'s
# `String.from("x")`, `s.push_str("x")`).  -1 when nothing is rebuilt.
pub fn method_strview_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    if name_eq(param_type_sv(p), "StrView") == 0
        return -1
    return emit_strview_from_lit(s, arg, reg)

# Arg narrow — the `iN` a method call's integer or bool arg is truncated to
# to match its param `p`, or `no_name()` when the i64 register passes as is
# (a wide or non-integer param; every bool value is an i64 register, AGAST
# #1646 / #3001).  Shared by the instance (AGAST #1607) and static
# (`T.m(...)`, AGAST #1733) method arms.
pub fn method_arg_narrow_ty(p: *Param) -> StrView
    match ty_int_bits(p.param_type)
        8 => return "i8"
        16 => return "i16"
        32 => return "i32"
        _ => pass
    if p.param_type == TypeKind.Bool
        return "i1"
    no_name()

# Float arg — coerce a method call's arg register `reg` to its `f32` / `f64`
# param `p`: fptrunc a double (a float literal is always one), fpext a float,
# sitofp an integer (an i64 register), as the free-call cascade does.  Returns
# `reg` for a non-float param or an arg already at the param's width.  Shared
# by the instance and static method arms (AGAST #2561): the instance arm had
# no float arm, so `a.lerp(b, 0.25)` passed `float %<double>`.
pub fn method_float_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    if p.param_type != TypeKind.F32 and p.param_type != TypeKind.F64
        return reg
    var src_ty: TypeKind = TypeKind.I64
    if arg != null
        src_ty = float_arg_src_type(s, arg, p.param_type)
    if src_ty != TypeKind.F32 and src_ty != TypeKind.F64
        return emit_int_into_float_slot(s, reg, float_slot_unsigned(arg), p.param_type)
    emit_float_coerce(s, reg, src_ty, p.param_type)

# The type of argument `arg`'s register for a float param of type `pft`.  An
# if / match there merged at `pft` (emit_call_arg's hint, LARB R43), while
# get_expr_type falls back to i64 for it: a phi double was sitofp'd again.
pub fn float_arg_src_type(s: *EmitterState, arg: *Expr, pft: TypeKind) -> TypeKind
    if pft != TypeKind.Void and (arg.kind == ExprKind.If or arg.kind == ExprKind.Match)
        return pft
    expr_slot_ty(arg)

# TypeKind.F32 / TypeKind.F64 when param `p` is a float: declared so, or a generic
# `T` monomorph substituted with f32 / f64 and left TypeKind.Struct.  Else 0.
pub fn param_float_type(p: *Param) -> TypeKind
    if p.param_type == TypeKind.F32 or p.param_type == TypeKind.F64
        return p.param_type
    if p.param_type != TypeKind.Struct
        return TypeKind.Void
    if name_eq(param_type_sv(p), "f32") == 1
        return TypeKind.F32
    if name_eq(param_type_sv(p), "f64") == 1
        return TypeKind.F64
    TypeKind.Void

# `%t = trunc i64 <reg> to <ty>` (ty from method_arg_narrow_ty); returns %t.
pub fn emit_method_arg_trunc(s: *EmitterState, reg: i32, ty: StrView) -> i32
    let t: i32 = next_reg(s)
    format_into(s, "  %.{t} = trunc i64 %.{reg} to {ty}\n")
    return t

# Return narrow — extend a method call's bool/i8/i16/i32 (and unsigned)
# result back to i64 so consumers see the i64 value-model register.  Shared
# by the instance and static (`T.m(...)`, AGAST #1962) method arms; any other
# return type passes through unchanged.
pub fn widen_method_result(s: *EmitterState, result: i32, rtype: TypeKind) -> i32
    let bits: i32 = ty_bits(rtype)   # a bool is 1
    if bits == 0 or bits == 64
        return result
    let ext_op: StrView = if ty_is_signed(rtype) == 1 then "sext" else "zext"
    let ext: i32 = next_reg(s)
    format_into(s, "  %.{ext} = {ext_op} i{bits} %.{result} to i64\n")
    ext



# =============================================================================
# From emitter_expr.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# `base` loaded `levels` times.
pub fn emit_load_levels(s: *EmitterState, base: i32, levels: i32) -> i32
    var reg: i32 = base
    for i in 0..levels
        reg = emit_load_ptr(s, reg)
    reg


# =============================================================================
# From emitter_expr_access.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# AGAST #3054: an array Sema refused in a pointer slot's own words never gets
# here (ref_value.ritz): any Sema error stops the compile before emission.
pub fn emit_whole_array_error(s: *EmitterState, e: *Expr)
    emit_nd_error_sv(s, e.span.line, e.span.col, "a whole array is not a value here (index it, copy it into an array of the same type, or take its address with @)")


# =============================================================================
# From emitter_stmt.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# AGAST #2343: an array store takes the same element type, by kind: `[N]u32` is
# not `[N]i32`.  ref_into has said so already for whatever it can name.
pub fn array_store_fits(s: *EmitterState, value: *Expr, a: TypeKind, a_name_sv: StrView, b: TypeKind, b_name_sv: StrView) -> bool
    if a == b and array_elem_types_match(a, a_name_sv, b, b_name_sv) == 1
        return true
    ref_array_error(s, value)
    false

# AGAST #2287: the shape of a whole array an expression reads.
struct ArraySrc
    size: i32
    elem: TypeKind
    name: *u8
    name_len: i32

pub fn array_src_set(out: *ArraySrc, size: i32, elem: TypeKind, name: StrView) -> i32
    out.size = size
    out.elem = elem
    out.name = name.ptr
    out.name_len = name.len as i32
    1

# The `p: *[N]T` / `@[N]T` / `@&[N]T` local `e` names, or null.  `a:& [N]T` counts:
# as in ritz0, `*a` reads the array.
pub fn array_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, ident_sv(e))
    if loc == null or lv_pointee_type(loc) != TypeKind.Array or lv_pointee_array_size(loc) <= 0
        return null
    if lent_array_ident(s, e) != null
        return loc
    return array_ptr_index_base(s, e)

# AGAST #2304: fill `out` with N and T when `*e` is a whole `[N]T` place: `e` an
# array_ptr_local, a `*[N]T` field or global that records them (base_ptr_array),
# or `x + k` / `x - k` over a `*[N]T` one, which steps whole rows (#2330).  N
# and T are the pointer's own, never the value's: with no N there is no
# length to check a store against.  Emits nothing.
pub fn array_ptr_shape(s: *EmitterState, e: *Expr, out: *ArraySrc) -> i32
    if e == null
        return 0
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        return array_src_set(out, lv_pointee_array_size(loc), lv_pointee_array_elem_type(loc), array_ptr_elem(loc))   # #2548
    if e.kind == ExprKind.Binary
        if e.op != OpKind.Add and e.op != OpKind.Sub
            return 0
        if not array_ptr_steps(s, e.left) or is_ptr_distance(s, e) == 1
            return 0
        return array_ptr_shape(s, e.left, out)
    let pa: *Param = base_ptr_array(s, e)
    if pa == null
        return 0
    array_src_set(out, pa.param_pointee_array_size, pa.param_pointee_array_elem_type, param_type_sv(pa))

# Does `x + k` on `e` step rows of a `*[N]T`?  Yes when: `e` is a `*[N]T` local or param,
# field or global, or such a step itself.  `@[N]T` and `a:& [N]T` aren't.
fn array_ptr_steps(s: *EmitterState, e: *Expr) -> bool
    if e.kind == ExprKind.Binary
        if (e.op == OpKind.Add or e.op == OpKind.Sub) and is_ptr_distance(s, e) == 0
            return array_ptr_steps(s, e.left)
        return false
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        return lv_var_type(loc) == TypeKind.Ptr
    base_ptr_array_row_size(s, e) > 0

# Fill `out` when `value` reads a whole 1-D array out of a place that needs no
# code to find: a local or by-value param, `a:& [N]T`, a global, `*p`.  Returns
# 0 for anything else.  Emits nothing, so a check can ask before emitting.
pub fn array_place_shape(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, ident_sv(value))
        if loc != null
            if lv_var_type(loc) == TypeKind.Array and lv_array_shape(loc) == null
                return array_src_set(out, lv_array_size(loc), lv_array_elem_type(loc), lv_type_sv(loc))
            return 0
        let g: *GlobalVarDef = find_global(s, ident_sv(value))
        if g != null and g.var_type == TypeKind.Array and g.array_shape == null
            return array_src_set(out, g.array_size, g.array_elem_type, g.array_elem_type_name)
        return 0
    if value.kind == ExprKind.Unary and value.op == OpKind.Deref
        # AGAST #2305: `*@a` / `*@&a` reads the array `a` is, as ritz0 has it.
        let inner: *Expr = addr_of_array_place(s, value.operand)
        if inner != null
            return array_place_shape(s, inner, out)
        return array_ptr_shape(s, value.operand, out)   # AGAST #2304
    0

# AGAST #2305: `x` when `e` is `@x` or `@&x` over a whole 1-D array place, so
# `*e` is that place; null otherwise.  Emits nothing.
pub fn addr_of_array_place(s: *EmitterState, e: *Expr) -> *Expr
    if e == null or e.kind != ExprKind.Unary or (e.op != OpKind.Addr and e.op != OpKind.AddrMut)
        return null
    let x: *Expr = e.operand
    if x == null or (x.kind != ExprKind.Ident and x.kind != ExprKind.Unary)
        return null
    var sh: ArraySrc
    if array_place_shape(s, x, @sh) == 0
        return null
    x

# Copy a whole local `[N x T]` from `src_ptr` over `dst_ptr` as one aggregate
# load + store: every element is read before any is written.
pub fn emit_local_array_copy(s: *EmitterState, size: i32, et: TypeKind, name_sv: StrView, src_ptr: i32, dst_ptr: i32)
    # AGAST #2306: an array of at least SRET_MIN_BYTES is copied pointer-to-
    # pointer, as #1732 copies a large struct: clang -O2 splits a first-class
    # `[N x T]` load/store into one scalar per element and hangs at 64 KB.
    # The two arrays are distinct or the same, never partially overlapping.
    var align: i64 = 8
    if elem_size_align(s, et, name_sv, @align) * (size as i64) >= SRET_MIN_BYTES
        format_into(s, "  call void @__ritz_sret_copy(ptr %.{dst_ptr}, ptr %.{src_ptr}, i64 ptrtoint (ptr getelementptr (")
        emit_local_array_llvm_type(s, size, et, name_sv)
        format_into(s, ", ptr null, i32 1) to i64))\n")
        s.ir.sret_helpers_used = 1
        return
    let agg: i32 = next_reg(s)
    format_into(s, "  %.{agg} = load ")
    emit_local_array_llvm_type(s, size, et, name_sv)
    format_into(s, ", ptr %.{src_ptr}\n  store ")
    emit_local_array_llvm_type(s, size, et, name_sv)
    format_into(s, " %.{agg}, ptr %.{dst_ptr}\n")
