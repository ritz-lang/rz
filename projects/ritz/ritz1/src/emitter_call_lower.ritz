# ritz1/src/emitter_call_lower.ritz - the call path's parts that never recurse into emit_expr: argument and receiver place facts, conversions, sizeof, enum payload shapes, builtin method pieces, the intrinsic table
#
# Split out by AGAST #1818: these never reach emit_expr / emit_stmt, so they
# sit below the emitter import cycle and the cycle's modules import them.

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import emitter_core
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import diag           # diag_error_at (AGAST #3621)
import binder_check   # binder_call_refuse (AGAST #2407)
import float_slot     # float_slot_unsigned (AGAST #2945, #4376)
import interp       # interp_lit_has_placeholder (AGAST #4381)
import narrowing
import monomorph     # array_arg_decode (AGAST #3029)
import ownership     # own_temp_slot_of (AGAST #2262)
import ritzlib.memory
import ref_check
import ritzlib.io
import ritzlib.str
import ritzlib.cstr
import ritzlib.strview    # strview_starts_with (was the local starts_with)
import ritzlib.sys
import ritzlib.gvec
import tokens_gen
import bool_check   # AGAST #2342
import bool_kind
import struct_index # si_once_* (AGAST #1635)
import sema_probe   # RITZ1_SEMA_PROBE (AGAST #3501)
import ritzlib.fmt.digits
import ritzlib.hash
import ritzlib.hashmap
import deref_field          # df_no_field_once (AGAST #3015)
import sema_type    # name_is_indexable (AGAST #3510)
import emitter_asm   # emit_asm_block (AGAST #3395)
import tail_value   # tail_stmts_diverge (AGAST #3323)

pub fn call_reg_slots(args: *Expr, min: i32) -> *i32
    var n: i32 = 0
    var a: *Expr = args
    while a != null
        n = n + 1
        a = a.next
    if n < min
        n = min
    if n < 1
        n = 1
    return malloc((n as i64) * 4) as *i32

# =============================================================================
# Method-dispatch helpers (ported from ritz0 Wave-1 commit 0278a27).
#
# Runs before the regular impl-table lookup so missing UFCS wrappers don't
# block obvious intrinsic patterns. Mirrors the dispatch chain from the
# holy-fuck-wip branch — StrView builtins, Vec/Span/StrView .len(), and a
# UFCS fallback that rewrites `v.method(args)` -> `vec_method$T(&v, args)`
# (similarly for Span$T, StrView) when the monomorphized wrapper exists.
# =============================================================================

# 1 if a TypeKind.Struct param named (name, len) is no struct at all, so an integer
# arg goes as it is (never the newtype-box refusal, #3420).  A tagged enum's arg is already the enum struct, even a bare
# `None`, which get_expr_type reports as i64 (AGAST #1498).  AGAST #2411: so is
# a user enum's (`v.push(C.B)` on a Vec<C>), and `usize` / `isize` are the i64
# the arg already is: boxing either wrote `store i64` of a `%C`, or an
# `alloca %usize`.
fn param_takes_arg_unboxed(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    if user_enum_index(ctx, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"usize"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"isize"), len: (5) as i64 }) == 1
        return 1
    0

# 1 if `e` already is a struct `%S` value, which the newtype-box refusal must
# pass as it is: get_expr_type reports each of these as an i64, so the box used
# to `store i64` the `%S`, and would refuse it now.  Asked by both the UFCS (`v.push(..)`) and the
# impl-method arg cascades.
#   - a struct literal (#1362)
#   - `*p` of a `*S` / `@S` / `@&S` (AGAST #2560)
#   - a call or method call returning a struct: `r.add(S.mk(5))` (#2413),
#     `v.push(E.new(t, 13))` (AGAST #3241)
#   - an element of a `[N]S` or a Vec<S> (#3420)
fn arg_is_struct_value(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.StructLit
        return 1
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref
        var dname: *u8 = null
        var dlen: i32 = 0
        deref_pointee_struct_name(s, e.operand, @dname, @dlen)
        if dlen > 0
            return 1
    if e.kind == ExprKind.Call or e.kind == ExprKind.Method
        var cname: *u8 = null
        var clen: i32 = 0
        call_result_struct_name(s, e, @cname, @clen)
        if clen > 0
            return 1
    # An element of a `[N]S` (index_struct_value_name), or of a Vec<S> local
    # or field (index_through): get_expr_type calls each an i64, so the box
    # stored the `%S` as one, and its refusal said "an integer" for angelo's
    # `add_line(fl[j], ..)` (#3420).
    if e.kind == ExprKind.Index and e.left != null
        var iname: *u8 = null
        var ilen: i32 = 0
        index_struct_value_name(s, e, @iname, @ilen)
        if ilen > 0
            return 1
        if index_through_value_struct(s, e, @iname, @ilen) == 1
            return 1
    0

# StrView.as_bytes() -> Span<u8> — bypasses the missing StrView_as_bytes impl
# Returns -1 if not applicable, else the LLVM register holding the Span<u8>.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is *StrView);
# 0 when the stack slot is the struct itself.
pub fn try_emit_strview_as_bytes(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    # Method must be "as_bytes"
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 0
        return -1
    # No args
    if e.args != null
        return -1
    # AGAST #3699: `let s = "abc"` is a StrView (#3579) in a `%Span$u8` slot,
    # the same `{ ptr, i64 }`: its bytes are the slot's value.
    if name_eq(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 }) == 1 and is_str_view_local(s, e.left) == 1
        let bytes: i32 = next_reg(s)
        emit_load_into(s, IR_TY_SPAN_U8, bytes, receiver_reg)
        return bytes
    # Must be "StrView"
    if name_eq(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 0
        return -1

    # If the receiver is *StrView (pointer), dereference once to get ptr-to-struct.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, loaded, receiver_reg)
        struct_ptr = loaded

    # Load %StrView from the receiver pointer
    let sv: i32 = next_reg(s)
    emit_load_into(s, IR_TY_STRVIEW, sv, struct_ptr)

    # Extract the ptr and len fields
    let ptr_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, sv)
    emit_str(s, IR_COMMA_0)

    let len_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, sv)
    emit_str(s, IR_COMMA_1)

    # Build the %Span$u8 { ptr, i64 } value inline
    let span1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, span1)
    emit_str(s, c" = insertvalue %Span$u8 undef, ptr ")
    emit_reg(s, ptr_reg)
    emit_str(s, IR_COMMA_0)

    let span2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, span2)
    emit_str(s, c" = insertvalue %Span$u8 ")
    emit_reg(s, span1)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, len_reg)
    emit_str(s, IR_COMMA_1)
    return span2

# Vec/Span/StrView .len() — load the len field (index 1) directly.
# Returns -1 if not applicable, else the register holding an i64 length.
# recv_is_ptr_of_ptr = 1 when the stack slot holds a pointer value (receiver is
# *Vec<T> etc.); 0 when the stack slot *is* the struct.
pub fn try_emit_len_builtin(s: *EmitterState, e: *Expr, type_name_sv: StrView, receiver_reg: i32, recv_is_ptr_of_ptr: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    # Must be .len() with no args
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"len"), len: (3) as i64 }) == 0
        return -1
    if e.args != null
        return -1

    # Type must be Vec$T, Span$T, or StrView
    var matched: i32 = 0
    if (StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Vec$"), len: (4) as i64 })
        matched = 1
    else if (StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Span$"), len: (5) as i64 })
        matched = 1
    else if name_eq(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        matched = 1
    if matched == 0
        return -1

    # If the receiver is a pointer, load the stack slot to get the actual struct pointer.
    var struct_ptr: i32 = receiver_reg
    if recv_is_ptr_of_ptr == 1
        let loaded: i32 = next_reg(s)
        emit_load_into(s, IR_TY_PTR, loaded, receiver_reg)
        struct_ptr = loaded

    # %len_ptr = getelementptr %Type, ptr %r, i32 0, i32 1
    # %len    = load i64, ptr %len_ptr
    let len_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, struct_ptr)
    emit_str(s, c", i32 0, i32 1\n")

    let len_val: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I64, len_val, len_ptr)
    return len_val

# A string literal passed to a `StrView` param, rebuilt as a %StrView value.
# `reg` is emit_expr's result for `arg`. Also rebuilds any other arg whose
# value is a %Span$u8 (e.g. an un-annotated literal local, #2103). Returns
# the %StrView register, or -1 when no rebuild is needed (the caller passes
# the value through).
pub fn emit_strview_from_lit(s: *EmitterState, arg: *Expr, reg: i32) -> i32
    if arg == null
        return -1
    var p: i32 = 0 - 1
    var l: i32 = 0 - 1
    match arg.kind
        ExprKind.StringLit =>
            # Bare "..." already produced a %Span$u8 aggregate. Span<u8> and
            # StrView are layout-compatible but nominally distinct in LLVM IR,
            # so rebuild the aggregate under the StrView name.
            p = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, p)
            emit_sv(s, " = extractvalue %")
            emit_name(s, strlit_struct(s))   # AGAST #4666
            emit_str(s, IR_SP)
            emit_reg(s, reg)
            emit_str(s, IR_COMMA_0)
            l = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, l)
            emit_sv(s, " = extractvalue %")
            emit_name(s, strlit_struct(s))
            emit_str(s, IR_SP)
            emit_reg(s, reg)
            emit_str(s, IR_COMMA_1)
        ExprKind.CstringLit =>
            # c"..." is a pointer (as i64); its length is known statically.
            p = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, p)
            emit_str(s, IR_INTTOPTR)
            emit_reg(s, reg)
            emit_str(s, c" to ptr\n")
        _ =>
            # AGAST #2103: any other %Span$u8-valued arg -- an un-annotated
            # `let t = "..."` / `var w = "..."` local is typed Span$u8 -- is
            # the layout-equivalent pair (#168) and is rebuilt the same way.
            var src_name: *u8 = null
            var src_len: i32 = 0
            resolve_expr_struct_name(s, arg, @src_name, @src_len)
            if is_layout_equiv_pair(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
                return rebuild_layout_equiv(s, reg, StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
            return -1
    let sv1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sv1)
    emit_str(s, c" = insertvalue %StrView undef, ptr ")
    emit_reg(s, p)
    emit_str(s, IR_COMMA_0)
    let sv2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sv2)
    emit_str(s, c" = insertvalue %StrView ")
    emit_reg(s, sv1)
    emit_str(s, IR_I64_SEP)
    if l >= 0
        emit_reg(s, l)
    else
        emit_int(s, arg.string_len as i64)
    emit_str(s, IR_COMMA_1)
    return sv2

# `<type><sep><method>`, heap-allocated; `lower` lowercases the type's ASCII
# letters (`Foo`, `cmp` -> `foo_cmp`).  *out_len is its length.
fn method_fn_name(type_name_sv: StrView, method_sv: StrView, lower: i32, out_len: *i32) -> *u8
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var method: *u8 = method_sv.ptr
    var method_len: i32 = method_sv.len as i32
    let n: i32 = type_name_len + 1 + method_len
    let buf: *u8 = malloc(n as i64)
    for i in 0..type_name_len
        var c: u8 = *(type_name + i)
        if lower == 1 and c >= 'A' and c <= 'Z'
            c = c + 32
        buf[i] = c
    buf[type_name_len] = '_'
    for i in 0..method_len
        buf[type_name_len + 1 + i] = *(method + i)
    *out_len = n
    buf

# Is there a fn `<type>_<method>` (or `<lowercased type>_<method>`)?
fn has_method_fn(s: *EmitterState, type_name_sv: StrView, method_sv: StrView, lower: i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var method: *u8 = method_sv.ptr
    var method_len: i32 = method_sv.len as i32
    var n: i32 = 0
    let name: *u8 = method_fn_name(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (method), len: (method_len) as i64 }, lower, @n)
    let fd: *FnDef = find_fn(s, StrView { ptr: (name), len: (n) as i64 })
    free(name)
    if fd == null
        return 0
    1

# AGAST #3244 (LANGUAGE_SPEC §9): method syntax reaches only impl methods,
# ritzlib's types included since LARB R66 (#3497).  `a.cmp(b)` on
# a struct with no `cmp` in an impl, a free `foo_cmp` notwithstanding, is
# refused at the method name, in ritz0's words (ref_rules.no_method):
#   no method `cmp` on `Foo`: declare it in `impl Foo`, or call `foo_cmp(a, b)`
# It called an undeclared `@Foo_cmp(...)` and failed to link.  Only for a
# non-generic struct with no `Foo_cmp` fn.  A Deref type's `w.get()` of its
# target's method never gets here: deref_field.ritz rewrote it.  1 once refused.
#
# AGAST #1572: an enum too, and a generic instance (`W$i32`, `Vec$i32`).  An
# instance's impl methods are monomorphized, `internal`, in each module
# that calls them, so one find_spec_impl_method missed is defined nowhere.
# Its message has no `impl W$i32` hint: there is no such impl to write.
#
# AGAST #4262: a builtin-generic Option/Result instance whose ritzlib module
# isn't imported registers no enum, yet is one: its builtins (unwrap,
# unwrap_or, is_some...) returned above, so anything else is refused too.
#
# LARB R66 (#3497): a StrView too, which the `strview_*` fallback caught until
# then.  Like an instance it gets no hint: its impl is ritzlib's.
pub fn refuse_no_method(s: *EmitterState, e: *Expr, type_name_sv: StrView) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var builtin_carrier: i32 = 0
    if (StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Option$"), len: (7) as i64 }) or (StrView { ptr: (type_name), len: (type_name_len) as i64 }).starts_with(StrView { ptr: (c"Result$"), len: (7) as i64 })
        builtin_carrier = 1
    let sv: i32 = name_eq(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    if builtin_carrier == 0 and sv == 0 and find_struct(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }) == null and is_enum_type(s.mono.pctx, StrView { ptr: (type_name), len: (type_name_len) as i64 }) == 0
        return 0
    var instance: i32 = sv
    for i in 0..type_name_len
        if *(type_name + i) == '$'
            instance = 1
    if has_method_fn(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, 0) == 1
        return 0
    emit_str(s, c"  ; ERROR: no method (AGAST #3244)\n")
    # Where the method name is (AGAST #3015), else the call.
    var at: SrcSpan = e.span
    if e.bracket.line > 0
        at = e.bracket
    diag_error_at(emitter_source_file(), at)
    eprints("no method `")
    eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    eprints("` on `")
    # AGAST #3697: `let s = "abc"` lowers to `%Span$u8` but is the StrView the
    # user wrote (#3579), as ritz0 names it.  Still no hint: its impl is ritzlib's.
    if is_str_view_local(s, e.left) == 1
        eprints("StrView")
    else
        eprint_bytes(StrView { ptr: (type_name), len: (type_name_len) as i64 })
    if instance == 1
        eprints("`\n")
        s.error_count = s.error_count + 1
        return 1
    eprints("`: declare it in `impl ")
    eprint_bytes(StrView { ptr: (type_name), len: (type_name_len) as i64 })
    eprint_char('`')
    if has_method_fn(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, 1) == 1
        eprints(", or call `")
        var n: i32 = 0
        let name: *u8 = method_fn_name(StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, 1, @n)
        eprint_bytes(StrView { ptr: (name), len: (n) as i64 })
        free(name)
        eprint_free_call_args(e)
        eprint_char('`')
    eprint_char('\n')
    s.error_count = s.error_count + 1
    1

# 1 when `recv` names a local bound to an unannotated `"..."` (AGAST #3579).
fn is_str_view_local(s: *EmitterState, recv: *Expr) -> i32
    if recv == null or recv.kind != ExprKind.Ident
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
    if loc == null or loc.str_view == 0
        return 0
    1

# `(a, b)` for `a.cmp(b)`: the receiver and arguments by name, or `(...)` when
# one isn't a plain name.
fn eprint_free_call_args(e: *Expr)
    var all_idents: i32 = 1
    if e.left == null or e.left.kind != ExprKind.Ident
        all_idents = 0
    var a: *Expr = e.args
    while a != null
        if a.kind != ExprKind.Ident
            all_idents = 0
        a = a.next
    if all_idents == 0
        eprints("(...)")
        return
    eprint_char('(')
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    a = e.args
    while a != null
        eprints(", ")
        eprint_bytes(StrView { ptr: (a.ident_ptr), len: (a.ident_len) as i64 })
        a = a.next
    eprint_char(')')

# The by-value `self` argument read from the receiver at `recv`, a `ptr`.  It's
# read here, before the arguments, because that's when a call evaluates its
# receiver: `c.g(bump(@&c))` passes the c from before the bump (AGAST #2393).
pub fn emit_self_value(s: *EmitterState, p: *Param, recv: i32) -> i32
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, p.param_type, val, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, recv, null, 0)
    if param_uses_byval(s, p) == 1
        return spill_byval_arg(s, null, val, p)
    val

# Tagged-enum variant constructors (ritz-task-133 rewrite).
#
# Layout (ritz0 parity, AGAST #1898):
# `%Result$... = type { i8 tag, [P x i8] pad, [N x i8] payload }` — declared
# once per instantiation by emit_tagged_enum_types in emitter.ritz; see
# tagged_enum_layout in emitter_core.
# Tag convention matches ritz0:
#   Ok   -> 0   Err  -> 1    (enum Result { Ok(T), Err(E) })
#   Some -> 0   None -> 1    (enum Option { Some(T), None })
#
# Construction shape:
#   %a = alloca %Result$T
#   %pt = getelementptr %Result$T, ptr %a, i32 0, i32 0
#   store i8 <tag>, ptr %pt
#   %pp = getelementptr %Result$T, ptr %a, i32 0, i32 2    ; [N x i8]
#   store <payload-llvm-type> %v, ptr %pp                  ; scalars at own width
#   %r = load %Result$T, ptr %a
# See emitter_match.ritz for the consumer side (extract tag, load payload).
# Resolve the enum name to alloca for a variant constructor.  Prefers an
# explicit context set by emit_var_decl for `let r: Result<_,_> = Ok(x)`
# bindings; falls back to the enclosing function's return type (which covers
# tail-expression returns inside a Result/Option-returning function — the
# common case).  Returns 0 when no enum context is available; callers should
# emit a defensive zero value rather than invalid IR in that case.
pub fn resolve_enum_ctx(s: *EmitterState, out_name: **u8, out_len: *i32) -> i32
    if s.ctx_enum_name != null
        if s.ctx_enum_name_len > 0
            if is_tagged_enum_type(StrView { ptr: (s.ctx_enum_name), len: (s.ctx_enum_name_len) as i64 }) == 1
                *out_name = s.ctx_enum_name
                *out_len = s.ctx_enum_name_len
                return 1
    # AGAST #1498: inside a call argument the enclosing fn's return type
    # says nothing about the argument's type — borrowing it built an
    # %Option$i64 for an Option<i32> param.
    if s.ctx_enum_arg == 1
        *out_name = null
        *out_len = 0
        return 0
    if s.ret_type_name != null
        if s.ret_type_name_len > 0
            if is_tagged_enum_type(StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
                *out_name = s.ret_type_name
                *out_len = s.ret_type_name_len
                return 1
    *out_name = null
    *out_len = 0
    return 0

# The EmitterState form of ast_query's lent_self_call_view_in (AGAST #4391:
# the pure part moved to ast_query, this wrapper stays here).
pub fn lent_self_call_view(s: *EmitterState, f: *FnDef) -> *FnDef
    lent_self_call_view_in(s.module, f)

# AGAST #2502: the `[N]T` local `@e` names when `e` is `@a` and the slot
# (name, name_len) is a `Span<T>` / `[T]` (one type since #1614); else null.
pub fn span_array_source(s: *EmitterState, e: *Expr, name_sv: StrView) -> *LocalVar
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if e == null or name == null or name_len <= 5
        return null
    if memcmp(name, c"Span$", 5) != 0
        return null
    if e.kind != ExprKind.Unary or e.op != OpKind.Addr or e.operand == null
        return null
    if e.operand.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
    if loc == null or lv_var_type(loc) != TypeKind.Array
        return null
    return loc

# The `%Span$T` (span_sv) `{ v.data, v.len }` of the `%Vec$T` (vec_sv) at
# `vec_ptr`: a view of the Vec's elements, as ritz0 coerces `@v` (bedc85b).
pub fn emit_span_of_vec_ptr(s: *EmitterState, vec_sv: StrView, vec_ptr: i32, span_sv: StrView) -> i32
    let data_pp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, data_pp)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, vec_sv)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, vec_ptr)
    emit_sv(s, ", i32 0, i32 0\n")
    let data: i32 = next_reg(s)
    emit_load_into(s, IR_TY_PTR, data, data_pp)
    let len_p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len_p)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, vec_sv)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, vec_ptr)
    emit_sv(s, ", i32 0, i32 1\n")
    let len: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I64, len, len_p)
    let sp1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp1)
    emit_sv(s, " = insertvalue %")
    emit_name(s, span_sv)
    emit_sv(s, " undef, ptr ")
    emit_reg(s, data)
    emit_str(s, IR_COMMA_0)
    let sp2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp2)
    emit_sv(s, " = insertvalue %")
    emit_name(s, span_sv)
    emit_str(s, IR_SP)
    emit_reg(s, sp1)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, len)
    emit_str(s, IR_COMMA_1)
    sp2

# `Span$T` (name, name_len) against an `[N]T` of element `et` (`et_name` a
# struct's): 1 when T is that element, else the located array-store error.
pub fn span_elem_fits(s: *EmitterState, e: *Expr, et: TypeKind, et_name_sv: StrView, name_sv: StrView) -> i32
    var et_name: *u8 = et_name_sv.ptr
    var et_name_len: i32 = et_name_sv.len as i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var elem: *u8 = null
    var elem_len: i32 = 0
    if et == TypeKind.Struct
        elem = et_name
        elem_len = et_name_len
    else
        elem_len = primitive_arg_spelling(et, @elem)
    if elem == null or elem_len <= 0
        return 1
    if name_len == 5 + elem_len and memcmp(name + 5, elem, elem_len as i64) == 0
        return 1
    ref_array_error(s, e)
    0

# AGAST #2305: the whole `[N]u8` / `[N]i8` array `arg` passes to the StrView
# param `p`, bare (`g(a)`) or as `@a`, or null.  ritz0 makes it the StrView
# `{ &a[0], N }` for a local, a global or an inline field; any other element is
# its "Type of #1 arg mismatch".  AGAST #3335: so it does for a `*[N]u8` /
# `*[N]i8` local, param or field `pb` passed bare, `{ pb, N }`; ritz1 passed
# its i64 where the %StrView goes, which only clang refused.  Emits nothing.
pub fn strview_array_src(s: *EmitterState, arg: *Expr, p: *Param) -> *Expr
    if p == null or p.param_type != TypeKind.Struct or name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 0
        return null
    if strview_array_ptr(s, arg) == 1
        return arg
    var x: *Expr = arg
    if x.kind == ExprKind.Unary and (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null
        x = x.operand
    var src: ArraySrc
    if arg_array_shape(s, x, @src) == 0
        return null
    if ty_int_bits(src.elem) != 8
        return null
    x

# 1 when `e`, a local, param or field, is a `*[N]u8` / `*[N]i8` (#3335).
pub fn strview_array_ptr(s: *EmitterState, e: *Expr) -> i32
    if e.kind != ExprKind.Ident and e.kind != ExprKind.Member
        return 0
    var src: ArraySrc
    if array_ptr_shape(s, e, @src) == 0
        return 0
    (ty_int_bits(src.elem) == 8) as i32

# `{ ptr, n }` as a `%<span_name>` register.
pub fn emit_span_value(s: *EmitterState, ptr: i32, n: i32, span_name_sv: StrView) -> i32
    var span_name: *u8 = span_name_sv.ptr
    var span_name_len: i32 = span_name_sv.len as i32
    let sp1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (span_name), len: (span_name_len) as i64 })
    emit_str(s, c" undef, ptr ")
    emit_reg(s, ptr)
    emit_str(s, IR_COMMA_0)
    let sp2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (span_name), len: (span_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, sp1)
    emit_str(s, IR_I64_SEP)
    emit_int(s, n as i64)
    emit_str(s, IR_COMMA_1)
    sp2

# AGAST #2781, #2366: `@a` with `a: [N]T1` fits the `Span$T2` slot (name,
# name_len) only when T1 is T2, or the Span views the array at T2's stride.  The
# array-store rule (LARB R5, #2343): the same located error as ritz0, at `e`.
# Compared as monomorphisation spells T: `u8`, a struct's name, `ptr_u8`.  An
# element this can't spell (a deeper pointer, a nested array) isn't judged.
pub fn span_array_elem_fits(s: *EmitterState, e: *Expr, loc: *LocalVar, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if lv_array_shape(loc) != null
        return 1
    var elem: *u8 = null
    var elem_len: i32 = 0
    var ptr_prefix: i32 = 0
    match lv_array_elem_type(loc)
        TypeKind.Struct =>
            elem = lv_type_name(loc)
            elem_len = lv_type_name_len(loc)
        TypeKind.Ptr =>
            elem_len = primitive_arg_spelling(lv_array_elem_pointee(loc), @elem)
            ptr_prefix = 4
        _ =>
            elem_len = primitive_arg_spelling(lv_array_elem_type(loc), @elem)
    if elem == null or elem_len <= 0
        return 1
    # name is `Span$` + [`ptr_`] + elem.
    if name_len == 5 + ptr_prefix + elem_len
        if ptr_prefix == 0 or memcmp(name + 5, c"ptr_", 4) == 0
            if memcmp(name + 5 + ptr_prefix, elem, elem_len as i64) == 0
                return 1
    ref_array_error(s, e)
    0

# `Span { &a[0], N }` of the `[N]T` local `loc`, as a `%<span_name>` register.
pub fn emit_span_of_array(s: *EmitterState, loc: *LocalVar, span_name_sv: StrView) -> i32
    var span_name: *u8 = span_name_sv.ptr
    var span_name_len: i32 = span_name_sv.len as i32
    let elem0: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem0)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, lv_array_size(loc) as i64)
    emit_str(s, IR_X)
    if ty_int_bits(lv_array_elem_type(loc)) == 32
        emit_str(s, c"i32")
    else if ty_int_bits(lv_array_elem_type(loc)) == 64
        emit_str(s, c"i64")
    else if ty_int_bits(lv_array_elem_type(loc)) == 8
        emit_str(s, c"i8")
    else if ty_int_bits(lv_array_elem_type(loc)) == 16
        emit_str(s, c"i16")
    else if lv_array_elem_type(loc) == TypeKind.Ptr or lv_array_elem_type(loc) == TypeKind.PtrPtr
        emit_str(s, c"ptr")
    else
        emit_str(s, c"i64")
    emit_str(s, IR_RBRACK_PTR)
    emit_reg(s, loc.reg)
    emit_str(s, c", i64 0, i64 0\n")
    let sp1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (span_name), len: (span_name_len) as i64 })
    emit_str(s, c" undef, ptr ")
    emit_reg(s, elem0)
    emit_str(s, IR_COMMA_0)
    let sp2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, sp2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (span_name), len: (span_name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, sp1)
    emit_str(s, IR_I64_SEP)
    emit_int(s, lv_array_size(loc) as i64)
    emit_str(s, IR_COMMA_1)
    return sp2

# The `name:& T` param `e` names, or null (LocalVar.is_lent, AGAST #2250).
pub fn lent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_is_lent(loc) == 0
        return null
    return loc

# AGAST #2287, #2302: an `-> [N]T` callee whose `[N x T]` isn't known (no
# ret_array_param) has no array return: the i64 it would come back in is no
# array.  1 once refused.  Every parsed `-> [N]T` has one; this fails closed.
pub fn refuse_array_return(s: *EmitterState, e: *Expr, callee: *FnDef) -> i32
    if callee == null or callee.return_type != TypeKind.Array or ret_array_of(callee) != null
        return 0
    emit_whole_array_error(s, e)
    1

# `g(p)` with `p: *[N]T` into a by-value `[N]T`: the array behind the pointer.
pub fn emit_array_ptr_arg_copy(s: *EmitterState, value: *Expr, loc: *LocalVar, slot: i32, p: *Param)
    if lv_pointee_array_size(loc) != p.param_array_size
        emit_ir_error(s, value.span, c"array length does not match the local array's length")
        return
    if array_store_fits(s, value, lv_pointee_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }) == 0
        return
    emit_local_array_copy(s, p.param_array_size, p.param_array_elem_type, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, emit_load_ptr(s, loc.reg), slot)

# 1 when `arg` came back from emit_call_arg as an address, for `@&T` param `p` of
# a cascade that otherwise leaves its value alone.
pub fn param_takes_addr_value(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if p.param_type != TypeKind.MutRef
        return 0
    if param_takes_array_ref(p) == 1
        return 1
    if borrow_arg_kind(s, arg, p) == BORROW_PLACE
        return 1
    0

pub fn arg_field_is_array(s: *EmitterState, arg: *Expr) -> i32
    let f: *StructField = member_field_def(s, arg)
    if f == null or f.field_type != TypeKind.Array or f.array_shape != null
        return 0
    1

# AGAST #2278: the `self:& T` / `self:&` receiver `e` names, or null.
pub fn lent_self_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_is_lent_self(loc) == 0
        return null
    return loc

# AGAST #2288: the `c:& C` param `e` names, when C is a struct, or null.  A
# by-value read with no slot type at hand (an if / match arm, a `c as C`)
# takes C from the param itself: an integer T is already a plain local and
# `a:& [N]T` an array one.
pub fn lent_referent_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_local(s, e)
    if loc == null or lv_var_type(loc) != TypeKind.MutRef or lv_pointee_type(loc) != TypeKind.Struct
        return null
    return loc

pub fn emit_array_return_slot(s: *EmitterState, ra: *Param) -> i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_array_value_llvm_type(s, ra)
    emit_str(s, c"  ; #2302 array return\n")
    entry_alloca_reg_end(s)
    slot

# `ret` the `[N x T]` at `slot`: by value, or through the sret pointer.
pub fn emit_array_return_from(s: *EmitterState, ra: *Param, slot: i32) -> i32
    if array_param_uses_byval(s, ra) == 1
        emit_str(s, c"  call void @__ritz_sret_copy(ptr %ret.sret, ptr ")
        emit_reg(s, slot)
        emit_str(s, IR_COMMA)
        emit_array_sret_size(s, ra)
        emit_str(s, IR_CLOSE)
        emit_str(s, c"  ret void\n")   # a `ret` starts its string (emit_str)
        s.sret_helpers_used = 1
        return 1
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD)
    emit_array_value_llvm_type(s, ra)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    emit_str(s, c"  ret ")
    emit_array_value_llvm_type(s, ra)
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_NL)
    1

# AGAST #2279: the local `e` names, when its slot can be loaded as the struct a
# fn returns; null otherwise.  A pointer or reference slot holds an address and
# an array slot its first element, so loading either as the struct is a silent
# wrong value.  They take the generic path, whose mismatch clang refuses.
pub fn struct_value_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null
        return null
    let t: TypeKind = lv_var_type(loc)
    if t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef or t == TypeKind.Array
        return null
    return loc

# AGAST #2279: the `a:& [N]T` param `e` names, read whole, or null.  It's an
# array local whose slot is the array behind the borrow (#2290).  A move-only T
# was refused on Sema (own_check.ritz's oc_lent_read, AGAST #3507); the caller
# still checks the slot's length and element type.
pub fn lent_array_local(s: *EmitterState, e: *Expr) -> *LocalVar
    lent_array_ident(s, e)

# AGAST #1948: the struct an argument expression statically points at, or
# null when it is not one of the shapes whose pointee ritz1 knows for sure:
#   `@x` / `@&x`     x a struct-typed local, or a struct-typed field chain;
#   `x`              x a local declared `*T` / `@T` / `@&T` with T a struct.
# Anything else (casts, calls, arithmetic, globals) answers null: the check
# fails OPEN on shapes it cannot type, never by guessing.
pub fn arg_pointee_struct(s: *EmitterState, arg: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if arg == null
        return null
    var name: *u8 = null
    var len: i32 = 0
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        let x: *Expr = arg.operand
        if x == null
            return null
        match x.kind
            ExprKind.Ident =>
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
                if loc == null or (lv_var_type(loc) != TypeKind.Struct and lent_struct_local(s, x) == null)
                    return null
                name = lv_type_name(loc)
                len = lv_type_name_len(loc)
            ExprKind.Member =>
                let f: *StructField = member_field_def(s, x)
                if f == null or f.field_type != TypeKind.Struct
                    return null
                name = f.field_type_name
                len = f.field_type_name_len
            _ =>
                return null
    else if arg.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
        if loc == null
            return null
        if lv_var_type(loc) != TypeKind.Ptr and lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef
            return null
        if lv_pointee_type(loc) != TypeKind.Struct
            return null
        name = lv_type_name(loc)
        len = lv_type_name_len(loc)
    else
        return null
    if name == null or len <= 0
        return null
    if find_struct(s, StrView { ptr: (name), len: (len) as i64 }) == null
        return null
    *out_len = len
    return name

# `file:line:col: error: argument N of `f` has the wrong type: `, as ritz0 words
# it; the caller finishes the line and counts the error.
fn eprint_arg_type_error(call: *Expr, fname_sv: StrView, argno: i32)
    var fname: *u8 = fname_sv.ptr
    var flen: i32 = fname_sv.len as i32
    diag_error_at(emitter_source_file(), call.span)
    eprint("argument {argno as i64} of `")
    for i in 0..flen
        eprint_char(*(fname + i))
    eprints("` has the wrong type: ")

# What the place `value` holds: its array's dimensions in `out`, or that it's no
# array, or ARG_DIMS_UNKNOWN when ritz1 can't tell from here.  Emits nothing.
fn place_array_dims(s: *EmitterState, value: *Expr, out: *ArrayDims) -> i32
    var src: ArraySrc
    if arg_array_shape(s, value, @src) == 1
        return array_dims_1d(out, src.size, src.elem, StrView { ptr: (src.name), len: (src.name_len) as i64 })
    match value.kind
        ExprKind.Ident =>
            let sh: *ArrayShape = nd_array_ident_shape(s, value)
            if sh != null
                return array_dims_nd(out, sh, 0)
            if find_local_struct_name(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 }) != null or find_global(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 }) != null
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        ExprKind.Member =>
            let msh: *ArrayShape = nd_array_member_shape(s, value)
            if msh != null
                return array_dims_nd(out, msh, 0)
            let f: *StructField = member_field_def(s, value)
            if f != null and f.field_type != TypeKind.Array
                return ARG_DIMS_NOT_ARRAY
            return ARG_DIMS_UNKNOWN
        _ => pass
    if value.kind == ExprKind.Index
        var depth: i32 = 0
        let ish: *ArrayShape = nd_index_shape(s, value, @depth)
        if ish != null
            return array_dims_nd(out, ish, depth)
        # An element of a 1-D array.
        var base: ArrayDims
        if value.left.kind != ExprKind.Index and place_array_dims(s, value.left, @base) == ARG_DIMS_ARRAY
            return ARG_DIMS_NOT_ARRAY
    ARG_DIMS_UNKNOWN

# What `arg` points at, for a param that takes an array by address.
fn ref_arg_dims(s: *EmitterState, arg: *Expr, out: *ArrayDims) -> i32
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return place_array_dims(s, arg.operand, out)
    if arg.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
        if loc != null and lv_var_type(loc) != TypeKind.Array
            let ploc: *LocalVar = array_ptr_local(s, arg)
            if ploc != null
                # AGAST #4122: a plane pointer `*[N][M]T` points at its shape,
                # not the flat `[N*M]T` it is kept as (`:& *[N][M]T` takes it).
                if lv_pointee_array_shape(ploc) != null and lv_var_type(ploc) == TypeKind.Ptr
                    return array_dims_nd(out, lv_pointee_array_shape(ploc), 0)
                var en_len: i32 = 0
                let en: *u8 = array_ptr_elem_name(ploc, @en_len)   # #2548
                return array_dims_1d(out, lv_pointee_array_size(ploc), lv_pointee_array_elem_type(ploc), StrView { ptr: (en), len: (en_len) as i64 })
            if lv_is_lent(loc) == 1
                return ARG_DIMS_NOT_ARRAY
            # AGAST #2323: `let p: @[N]T = @a` and `var p = @a` record N and T,
            # and array_ptr_local answered for them.  A pointer local whose
            # pointee is known and no array (`p: *i32`, `*u8`, `**T`, `@S`) is
            # what ritz0 refuses: `a[i]` in the callee would read past it.  One
            # that records no pointee, or an array without its N, says nothing.
            if lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.PtrPtr or lv_var_type(loc) == TypeKind.Ref or lv_var_type(loc) == TypeKind.MutRef
                if lv_pointee_type(loc) == TypeKind.Array or lv_pointee_type(loc) == TypeKind.Unknown or lv_pointee_type(loc) == TypeKind.Void
                    return ARG_DIMS_UNKNOWN
                return ARG_DIMS_NOT_ARRAY
    return place_array_dims(s, arg, out)

# Fill `out` when `arg` is a whole 1-D array, as a place or an inline field.
pub fn arg_array_shape(s: *EmitterState, arg: *Expr, out: *ArraySrc) -> i32
    if array_place_shape(s, arg, out) == 1
        return 1
    if arg.kind == ExprKind.Member and arg_field_is_array(s, arg) == 1
        let f: *StructField = member_field_def(s, arg)
        return array_src_set(out, f.array_size, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
    0

# AGAST #2335: what a bare argument to a `name:& T` param is.  LARB R1's second
# exception: a place of type `T` is borrowed, as if written `@&x`, the language's
# only implicit borrow, for every T.  What isn't a place of `T` passes if it's a
# pointer to one (an `@&T` or a `*T`), whether a place or a call result.  An
# rvalue is refused: there's nothing for the caller to observe.
const BORROW_PASS: i32 = 0      # as it's written, by the value paths
const BORROW_PLACE: i32 = 1     # a place of `T`: its address
const BORROW_RVALUE: i32 = 2
const BORROW_MISFIT: i32 = 3    # a place of something else
const BORROW_UNTYPED: i32 = 4   # an argument ritz1 can't type from here
const BORROW_SHARED: i32 = 5    # reached through an `@T`, which is read-only

# The type of a place, as far as ritz1 can tell without emitting it.  `name` is
# a struct's, or for a pointer the struct it points at.
struct PlaceType
    kind: TypeKind
    pointee: TypeKind
    name: *u8
    name_len: i32

fn place_type_set(out: *PlaceType, kind: TypeKind, pointee: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = name_len
    1

fn kind_is_pointer(t: TypeKind) -> i32
    if t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef
        return 1
    0

# What `*x` gives, for `x` of type `base`.
fn place_deref_type(base: *PlaceType, out: *PlaceType) -> i32
    var held: TypeKind = TypeKind.Unknown
    if base.name_len > 0
        held = TypeKind.Struct
    if base.kind == TypeKind.PtrPtr
        return place_type_set(out, TypeKind.Ptr, held, StrView { ptr: (base.name), len: (base.name_len) as i64 })
    if kind_is_pointer(base.kind) == 0
        return 0
    return place_type_set(out, base.pointee, held, StrView { ptr: (base.name), len: (base.name_len) as i64 })

# What `x[i]` gives.  The array shapes know what they hold; a pointer is `*x`.
fn place_index_type(s: *EmitterState, value: *Expr, out: *PlaceType) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, value, @depth)
    if sh != null
        if depth < sh.rank
            return place_type_set(out, TypeKind.Array, TypeKind.Unknown, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        return place_type_set(out, sh.leaf_type, TypeKind.Unknown, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    var src: ArraySrc
    if arg_array_shape(s, value.left, @src) == 1
        var held: TypeKind = TypeKind.Unknown
        if src.name_len > 0
            held = TypeKind.Struct
        return place_type_set(out, src.elem, held, StrView { ptr: (src.name), len: (src.name_len) as i64 })
    var base: PlaceType
    if place_type_of(s, value.left, @base) == 0
        return 0
    return place_deref_type(@base, out)

# The field `e` names on a base member_field_def can't see through: `a[i].f`,
# `(*c).f`.  Null when the base is no struct, or a pointer to one.
fn place_field_def(s: *EmitterState, e: *Expr) -> *StructField
    var base: PlaceType
    if place_type_of(s, e.left, @base) == 0 or base.name_len <= 0
        return null
    let st: *StructDef = find_struct(s, StrView { ptr: (base.name), len: (base.name_len) as i64 })
    if st == null
        return null
    let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if idx < 0
        return null
    get_field_type(st, idx)

# 1 and `out` when ritz1 can type the place `e`.
fn place_type_of(s: *EmitterState, e: *Expr, out: *PlaceType) -> i32
    match e.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if loc != null
                return place_type_set(out, lv_var_type(loc), lv_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g == null
                return 0
            if kind_is_pointer(g.var_type) == 1
                return place_type_set(out, g.var_type, g.pointee_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })
            return place_type_set(out, g.var_type, TypeKind.Unknown, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        ExprKind.Member =>
            var f: *StructField = member_field_def(s, e)
            if f == null
                f = place_field_def(s, e)
            if f == null
                return 0
            return place_type_set(out, f.field_type, ptr_field_elem_kind(f), StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        ExprKind.Index =>
            return place_index_type(s, e, out)
        _ => pass
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref
        var base: PlaceType
        var pointer: *Expr = e.operand
        if pointer.kind == ExprKind.Binary
            pointer = find_base_expr(pointer)
        if place_type_of(s, pointer, @base) == 0
            return 0
        return place_deref_type(@base, out)
    0

# 1 when `e` is a place: it names storage the caller can see afterwards.
fn arg_is_place(s: *EmitterState, e: *Expr) -> i32
    var root: *Expr = e
    while root.kind == ExprKind.Member or root.kind == ExprKind.Index
        if root.kind == ExprKind.Index and root.right != null and root.right.kind == ExprKind.Range
            return 0
        root = root.left
    if root.kind == ExprKind.Unary and root.op == OpKind.Deref
        return 1
    if root.kind == ExprKind.Ident
        if find_local_struct_name(s, StrView { ptr: (root.ident_ptr), len: (root.ident_len) as i64 }) != null
            return 1
        return (find_global(s, StrView { ptr: (root.ident_ptr), len: (root.ident_len) as i64 }) != null) as i32
    # A field or element of a call result: `@&g().x` isn't lowered either.
    0

# The struct a method receiver names (by value or through a pointer), or
# null when ritz1 cannot type it without emitting it.
# 1 when `recv` names no value, so it's the type of a static call.  A global
# named like a type with an impl doesn't shadow it unless it can be a receiver
# (a struct or `*S`), as in ritz0 (AGAST #2575); a local or param does.
pub fn method_recv_is_type(s: *EmitterState, recv: *Expr) -> i32
    if recv == null or recv.kind != ExprKind.Ident
        return 0
    if find_local_struct_name(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 }) != null
        return 0
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
    if g == null
        return 1
    if global_is_receiver(g) == 1
        return 0
    impl_type_named(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })

# AGAST #3309: `Slot.mk(5)` on `impl<T> Slot<T>` spells no type argument, so
# it calls the method of the instance whose slot it fills (a typed `let`, a
# parameter, the fn's return type), as ritz0 does (AGAST #2185): into a
# `Slot<i32>` that's `Slot$i32_mk`, which monomorph specialised.  It called the
# template's `Slot_mk`, with `%T` in its IR, and clang refused it unlocated.
# Returns that method with its symbol in out_name/out_len; with no such slot,
# or another type's, refuses at the call with ritz0's text and returns null.
pub fn generic_static_method(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> *FnDef
    let rp: *u8 = e.left.ident_ptr
    let rl: i32 = e.left.ident_len
    var tlen: i32 = 0
    let tname: *u8 = slot_struct_name(s, @tlen)
    if tname != null and tlen > rl + 1 and *(tname + rl) == '$' and memcmp(tname, rp, rl as i64) == 0
        let len: i32 = tlen + 1 + e.ident_len
        let name: *u8 = malloc(len as i64 + 1) as *u8
        memcpy(name, tname, tlen as i64)
        *(name + tlen) = 95   # '_'
        memcpy(name + tlen + 1, e.ident_ptr, e.ident_len as i64)
        *(name + len) = 0
        let fd: *FnDef = find_fn(s, StrView { ptr: (name), len: (len) as i64 })
        if fd != null
            *out_name = name
            *out_len = len
            return fd
        free(name)
    emit_nd_error_begin(s, e.span.line, e.span.col)
    eprints("can't infer the type arguments of `")
    eprint_bytes(StrView { ptr: (rp), len: (rl) as i64 })
    eprints("` for `")
    eprint_bytes(StrView { ptr: (rp), len: (rl) as i64 })
    eprints(".")
    eprint_bytes(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    eprints("`: give the binding a type\n")
    null

# AGAST #2296: `Span.empty()`, whose receiver is the type `Span` and whose T
# is never spelled: the slot it lands in names the `Span$T` (slot_struct_name),
# and the value is `{ null, 0 }` without ritzlib.span, as in ritz0's
# _try_emit_associated_builtin_call.  With no `Span$T` slot it is a located
# refusal, ritz0's text.  -1 when `e` isn't a call on the type `Span`.
pub fn try_emit_span_assoc(s: *EmitterState, e: *Expr) -> i32
    let recv: *Expr = e.left
    if recv == null or recv.kind != ExprKind.Ident or name_eq(StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 0
        return 0 - 1
    if method_recv_is_type(s, recv) == 0
        return 0 - 1
    var tlen: i32 = 0
    let tname: *u8 = slot_struct_name(s, @tlen)
    if tname == null or tlen <= 5 or memcmp(tname, c"Span$", 5) != 0
        return emit_qualified_variant_error(s, e, c"needs its type argument from the slot it lands in: a `-> Span<T>` return, a `let s: Span<T>` or a `Span<T>` parameter")
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"empty"), len: (5) as i64 }) == 0 or e.args != null
        return 0 - 1
    let half: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, half)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (tname), len: (tlen) as i64 })
    emit_str(s, c" undef, ptr null, 0  ; Span.empty()\n")
    let out: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, out)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (tname), len: (tlen) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, half)
    emit_str(s, c", i64 0, 1\n")
    return out

# AGAST #4194: the `Span$T` a `Span.empty()` arm built (its slot's, as
# try_emit_span_assoc took it), so an if / match of such arms has a `%Span$T`
# phi, not an i64 one.  Leaves *out alone for any other expression.
pub fn span_assoc_arm_type(s: *EmitterState, e: *Expr, out: **u8, out_len: *i32)
    if e == null or e.kind != ExprKind.Method or e.args != null
        return
    let recv: *Expr = e.left
    if recv == null or recv.kind != ExprKind.Ident or name_eq(StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 0
        return
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"empty"), len: (5) as i64 }) == 0 or method_recv_is_type(s, recv) == 0
        return
    var tlen: i32 = 0
    let tname: *u8 = slot_struct_name(s, @tlen)
    if tname != null and tlen > 5 and memcmp(tname, c"Span$", 5) == 0
        *out = tname
        *out_len = tlen

# AGAST #2394: 1 when the call or method `arg` already returns an address
# (`-> @T`, `-> @&T` or `-> *T`, all i64 at a call), so an `@T` param takes
# its result as is.  Only a `-> T` struct result is a value to spill and
# auto-borrow: `sid(sid(p))` spilled sid's `@C` as a `%C` and clang refused it.
pub fn call_returns_address(s: *EmitterState, arg: *Expr) -> i32
    var t: TypeKind = expr_slot_ty(arg)
    # get_expr_type types a method's float result only.
    if arg.kind == ExprKind.Method
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return 0
        t = m.return_type
    (t == TypeKind.Ref or t == TypeKind.MutRef or t == TypeKind.Ptr) as i32

# What `arg`, no place, does for `p`: it passes if it's the pointer `p` is.
fn rvalue_borrow_kind(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if arg.kind == ExprKind.NilLit or arg.kind == ExprKind.CstringLit
        return BORROW_RVALUE
    var t: TypeKind = expr_slot_ty(arg)
    # get_expr_type types a method's float result only.
    if arg.kind == ExprKind.Method
        let m: *FnDef = method_call_def(s, arg)
        if m == null
            return BORROW_UNTYPED
        t = m.return_type
    if t == TypeKind.Ref
        return BORROW_SHARED
    if p.param_pointee_type == TypeKind.Ptr
        if t == TypeKind.PtrPtr
            return BORROW_PASS
    else if kind_is_pointer(t) == 1
        return BORROW_PASS
    BORROW_RVALUE

# 1 when pointer place `pl` is the `*U` that `p`, a `:& *U`, borrows.
fn pointer_place_fits(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    let want: TypeKind = p.param_ref_ptr_pointee
    # Unrecorded on one side: nothing to compare, as call_check's ca_struct_ptr.
    if want == TypeKind.Void or pl.pointee == TypeKind.Unknown
        return 1
    # AGAST #3101: `r:& T` at T = `*[N]E` takes a `*[N]E` place: the same N
    # and E, as ritz0 compares `[3 x i32]**` with `[2 x i32]**`.
    if want == TypeKind.Array and p.param_pointee_array_size > 0
        if pl.pointee != TypeKind.Array
            return 0
        var got: ArrayDims
        if ref_arg_dims(s, arg, @got) != ARG_DIMS_ARRAY
            return 1
        var dims: ArrayDims
        param_pointee_dims(@dims, p)
        return array_dims_match(@got, @dims)
    if want == TypeKind.Struct or pl.pointee == TypeKind.Struct
        return (want == pl.pointee and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (pl.name), len: (pl.name_len) as i64 }) == 1) as i32
    # Exactly, as place_fits_borrow: a `*u32` isn't the `*i32` (#2530).
    return (want == pl.pointee) as i32

# 1 when the place `arg`, of type `pl`, holds the `T` of `p`: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `:& u32` doesn't take an `i32` (#2530).
fn place_fits_borrow(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    let pt: TypeKind = p.param_pointee_type
    if pl.kind != TypeKind.Array and pl.kind != TypeKind.Struct
        # AGAST #2994: a `bool` local or param is a `bool`, though its slot is
        # kept as an i64, as ref_bool_local; so it fits no `:& i64` either.
        if arg.kind == ExprKind.Ident
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
            if loc != null and loc.is_bool == 1
                return (pt == TypeKind.Bool) as i32
        return (pl.kind == pt) as i32
    match pl.kind
        TypeKind.Struct =>
            return (pt == TypeKind.Struct and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (pl.name), len: (pl.name_len) as i64 }) == 1) as i32
        TypeKind.Array =>
            if pt != TypeKind.Array
                return 0
            var got: ArrayDims
            var want: ArrayDims
            if place_array_dims(s, arg, @got) != ARG_DIMS_ARRAY
                return 0
            param_pointee_dims(@want, p)
            return array_dims_match(@got, @want)
        _ => pass
    0

# AGAST #2354: 1 when `arg` names a by-value `@&U` param of the fn being emitted.
fn ident_is_ref_param(arg: *Expr) -> i32
    let f: *FnDef = emitter_current_fn()
    if arg.kind != ExprKind.Ident or f == null
        return 0
    var q: *Param = f.params
    while q != null
        if q.param_type == TypeKind.MutRef and q.is_borrow == 0 and name_eq(StrView { ptr: (q.name), len: (q.name_len) as i64 }, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 }) == 1
            return 1
        q = q.next
    0

# What a pointer place does for `p`: `*U` into `:& *U` is a place of `T`; into
# `:& U`, or `**U` into `:& *U`, it's the pointer to one, and passes.
# AGAST #2372: a `**S` as deep as `:& **S` is a place of it too: passing its value
# left the callee one level short.
fn pointer_place_kind(s: *EmitterState, arg: *Expr, pl: *PlaceType, p: *Param) -> i32
    if param_borrows_struct_ptr_ptr(p) == 1
        var inner: TypeKind = TypeKind.Void
        var name: *u8 = null
        var name_len: i32 = 0
        if ptr_levels_of(s, arg, @inner, @name, @name_len) == ptr_ptr_ident_levels(p.param_inner_pointee_type)
            return BORROW_PLACE
    if p.param_pointee_type != TypeKind.Ptr
        return BORROW_PASS
    if pl.kind == TypeKind.PtrPtr or pl.pointee == TypeKind.Ptr
        return BORROW_PASS
    # AGAST #2354: an `@&U` place holds a pointer as a `*U` does, so it's the
    # place `:& *U`, `:& @&U` (and `:& T` at T = `@&U`) borrow, as on ritz0.
    # An `@U` one never gets here: place_behind_shared_ref refused it.  An
    # `@&U` param is no place: ritz0 gives it no storage to borrow.
    if pl.kind != TypeKind.Ptr and (pl.kind != TypeKind.MutRef or ident_is_ref_param(arg) == 1)
        return BORROW_MISFIT
    if pointer_place_fits(s, arg, pl, p) == 1
        return BORROW_PLACE
    BORROW_MISFIT

# 1 when the place `e` is an `@T`, or the nearest indirection on its path to the
# root is one.  An `@&T` or `*T` nearer than that makes it writable.
fn place_behind_shared_ref(s: *EmitterState, e: *Expr) -> i32
    var pl: PlaceType
    if place_type_of(s, e, @pl) == 1 and pl.kind == TypeKind.Ref
        return 1
    var at: *Expr = e
    while at != null
        if at.kind == ExprKind.Member or at.kind == ExprKind.Index
            at = at.left
        else if at.kind == ExprKind.Unary and at.op == OpKind.Deref
            at = at.operand
            if at.kind == ExprKind.Binary
                at = find_base_expr(at)
        else
            return 0
        if place_type_of(s, at, @pl) == 1
            if pl.kind == TypeKind.Ref
                return 1
            if kind_is_pointer(pl.kind) == 1
                return 0
    0

# Emits nothing, so it can be asked again at each step of a call.  What it
# refuses (a temporary, a misfit, through an `@T`, untypable) is said on Sema,
# by call_check's ca_borrow (AGAST #4244); here only BORROW_PLACE is lowered.
pub fn borrow_arg_kind(s: *EmitterState, arg: *Expr, p: *Param) -> i32
    if p == null or p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return BORROW_PASS
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut)
        return BORROW_PASS
    # An `a:& [N]T` param reads as the pointer it's bound to.
    if lent_array_ident(s, arg) != null
        return BORROW_PASS
    if arg_is_place(s, arg) == 0
        return rvalue_borrow_kind(s, arg, p)
    if place_behind_shared_ref(s, arg) == 1
        return BORROW_SHARED
    var pl: PlaceType
    if place_type_of(s, arg, @pl) == 0 or pl.kind == TypeKind.Unknown
        return BORROW_UNTYPED
    if kind_is_pointer(pl.kind) == 1
        return pointer_place_kind(s, arg, @pl, p)
    if place_fits_borrow(s, arg, @pl, p) == 1
        return BORROW_PLACE
    BORROW_MISFIT

# AGAST #1739 — a large by-value struct param is passed `ptr byval(%T)`.
# Spill the argument into a fresh slot right after evaluating it, before the
# next argument runs (which keeps evaluation order: a later arg cannot change
# what this one passes).  The value is almost always a `load %T` just
# emitted, so the store site emits this store as a pointer-to-pointer
# @__ritz_sret_copy (#4461).  Returns the slot; every arg-coercion
# cascade passes it through and the call writes it as `ptr byval(%T)`.
pub fn spill_byval_arg(s: *EmitterState, arg: *Expr, reg: i32, p: *Param) -> i32
    var val: i32 = reg
    # `f(@x)` for a by-value param: emit_expr gave the address as an i64
    # (the same case the free-call fallback cascade materialises with a
    # load).
    if arg != null and arg.kind == ExprKind.Unary
        if arg.op == OpKind.Addr or arg.op == OpKind.AddrMut
            let pp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, reg)
            val = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, val)
            emit_str(s, IR_LOAD_NAMED)
            emit_name(s, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, pp)
            emit_str(s, IR_NL)
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    emit_name(s, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
    emit_str(s, c"  ; #1739 byval arg\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, val, slot)
    return slot

# The constructor emit_ctor_type_error last refused.
pub var g_ctor_refused: *Expr = null

# "this constructor's type can't be inferred here", at `ctor`, once: a let or
# arms that couldn't name the enum say so, and then the constructor, emitted
# with none, reaches the fallback below (AGAST #2430, #2454).
pub fn emit_ctor_type_error(s: *EmitterState, ctor: *Expr)
    if ctor == g_ctor_refused
        return
    g_ctor_refused = ctor
    emit_nd_error(s, ctor.span.line, ctor.span.col, c"this constructor's type can't be inferred here: bind it with a typed `let` first")

# AGAST #2454: a Some/None/Ok/Err that nothing gives an enum is a located
# error.  It lowered to `add i64 0, 0` and the program ran on that zero: an
# array literal's, an if / match arm's, `a[i] = ` and a statement's all did,
# until each took its enum.  Inside a call argument or a slot whose type isn't
# an enum it is #1498 / #2142's refusal, now located too.  Returns an i64 zero
# so the rest of the fn still emits; the error stops the output.
pub fn emit_no_enum_ctx_error(s: *EmitterState, ctor: *Expr) -> i32
    if s.ctx_enum_arg == 1
        emit_nd_error(s, ctor.span.line, ctor.span.col, c"variant constructor has no enum context: the parameter or slot it goes into is not an Option/Result")
    else
        emit_ctor_type_error(s, ctor)
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0  ; constructor with no enum (error)\n")
    return z

# AGAST #2453: 1 when the call `e` named like a builtin constructor (Some /
# Ok / None / Err) is a user enum's variant here: a user enum declares it (or
# two do: try_emit_user_variant_ctor reports that) and no Option / Result
# slot gives the builtin an enum.  ritz0's slot decides the same way: in an
# Option-returning fn the tail `Some(7)` stays the builtin.
pub fn users_variant_wins(s: *EmitterState, e: *Expr) -> i32
    if is_variant_carrier(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 0 and is_variant_null(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 0
        return 0
    var a: i32 = 0
    var b: i32 = 0
    if user_variant_ctor_ambiguous(s.mono.pctx, e, @a, @b) == 0
        var en: *u8 = null
        var en_len: i32 = 0
        user_variant_ctor_enum(s.mono.pctx, e, @en, @en_len)
        if en == null
            return 0
        # The let's slot is this user enum (`let x: E = Ok(5)`, or an untyped
        # let #1797 typed %E): the user's variant, whatever the fn returns.
        if s.ctx_enum_name != null and name_eq(StrView { ptr: (s.ctx_enum_name), len: (s.ctx_enum_name_len) as i64 }, StrView { ptr: (en), len: (en_len) as i64 }) == 1
            return 1
    var bn: *u8 = null
    var bn_len: i32 = 0
    if resolve_enum_ctx(s, @bn, @bn_len) == 1
        return 0
    return 1

# The struct or enum a variant payload's register holds, null/0 for an i64-width
# scalar.  ritz1 lacks a full expr-type oracle so this peeks at the expression
# form: emit_variant_build stores by it, and a constructor scrutinee is named by
# it (AGAST #2419), so the two can't disagree.
pub fn variant_payload_aggregate(s: *EmitterState, payload_expr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    match payload_expr.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (payload_expr.ident_ptr), len: (payload_expr.ident_len) as i64 })
            if loc != null
                if lv_var_type(loc) == TypeKind.Struct
                    if lv_type_name_len(loc) > 0
                        *out_name = lv_type_name(loc)
                        *out_len = lv_type_name_len(loc)
                        return
            # AGAST #2144: `Ok(Vacant)` / `Some(Vacant)`, a bare unit variant
            # of a user enum, is the enum aggregate as `Ok(Opt.Vacant)` is
            # (it was stored as an i64: invalid IR).  A same-named const /
            # local / global / fn wins, as in emit_expr_ident.
            var bvi: i32 = 0
            var bother: i32 = 0
            let bei: i32 = bare_unit_variant_enum(s, payload_expr, @bvi, @bother)
            if bei >= 0
                *out_name = enum_name_at(s.mono.pctx, bei, out_len)
        ExprKind.StringLit =>
            # Bare "..." lowers to a %Span$u8 aggregate (AGAST #98) —
            # layout-equal to StrView; storing it as i64 was invalid IR
            # for `Some("10")` (AGAST #1498).
            *out_name = c"Span$u8"
            *out_len = 7
        ExprKind.StructLit =>
            # AGAST #1362: `Some(Point { .. })` / `Ok(Font { .. })` — the
            # rvalue struct literal yields its loaded `%Struct` aggregate.
            let lit_st: *StructDef = find_struct(s, StrView { ptr: (payload_expr.ident_ptr), len: (payload_expr.ident_len) as i64 })
            if lit_st != null
                *out_name = lit_st.name
                *out_len = lit_st.name_len
        ExprKind.Member =>
            # AGAST #1664: `Some(s.value)` with a struct-typed field (StrView,
            # at any depth, through @ / * / by value) — the field load yields
            # the `%Struct` aggregate, not an i64.
            let fld: *StructField = resolve_member_chain_field(s, payload_expr)
            if fld != null
                if fld.field_type == TypeKind.Struct
                    if fld.field_type_name_len > 0
                        *out_name = fld.field_type_name
                        *out_len = fld.field_type_name_len
                        return
            # AGAST #1466: `Err(ArgError.Bad)`, a qualified unit variant, is
            # the enum aggregate too.
            qualified_variant_enum(s, payload_expr, out_name, out_len)
        ExprKind.Call =>
            # AGAST #1466: a user-enum ctor `Err(Missing(5))` is the enum
            # aggregate (it was stored as an i64: invalid IR).
            user_variant_ctor_enum(s.mono.pctx, payload_expr, out_name, out_len)
            if *out_name != null
                return
            let fn_def: *FnDef = find_call_fn(s, payload_expr)
            if fn_def != null
                if fn_def.return_type == TypeKind.Struct
                    if fn_def.return_type_name_len > 0
                        *out_name = fn_def.return_type_name
                        *out_len = fn_def.return_type_name_len
        ExprKind.Method =>
            # AGAST #1466: `Err(ArgError.Missing(s))`, likewise.
            qualified_variant_enum(s, payload_expr, out_name, out_len)
            if *out_name != null
                return
            # AGAST #2572: `Some(v[lo..hi])` is `Some(v.slice(lo, hi))` after
            # #2451's rewrite: the `%Span$T` / `%Vec$T` / `%String` the callee
            # returns (it was stored as an i64: invalid IR).
            let md: *FnDef = method_call_def(s, payload_expr)
            if md != null
                if md.return_type == TypeKind.Struct
                    if md.return_type_name_len > 0
                        *out_name = md.return_type_name
                        *out_len = md.return_type_name_len
        _ => pass

# The struct / enum type variant `tag` of `enum_name` declares for its payload:
# a tagged enum's type argument, or a user enum's (or instance's) tuple field.
# null (out_len 0) when the payload is a scalar or unknown.
pub fn variant_payload_type_name(s: *EmitterState, enum_name_sv: StrView, tag: i32, out_len: *i32) -> *u8
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var pay: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, out_len)
    let uf: *StructField = user_enum_tuple_field(s.mono.pctx, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag)
    if uf != null and uf.field_type == TypeKind.Struct
        pay = uf.field_type_name
        *out_len = uf.field_type_name_len
    pay

# AGAST #3029: 1, and the `[N]T` in *out, when `e` is an array literal or fill
# and variant `tag` of `enum_name` declares an array payload: a user enum's
# tuple field (`V([2]u8)`) or a tagged enum's argument (`Option<[2]u8>`, spelt
# `arr2_u8`).  0 for anything else.
pub fn variant_array_payload(s: *EmitterState, enum_name_sv: StrView, tag: i32, e: *Expr, out: *ArrayArg) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if e == null or (e.kind != ExprKind.ArrayLit and e.kind != ExprKind.ArrayFill)
        return 0
    variant_array_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, out)

# AGAST #3029: 1, and the `[N]T` in *out, when variant `tag` of `enum_name`
# declares an array payload.  The match binding reads it back at that type
# (emit_array_payload_bind).
pub fn variant_array_type(s: *EmitterState, enum_name_sv: StrView, tag: i32, out: *ArrayArg) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if enum_name == null or enum_name_len <= 0
        return 0
    let uf: *StructField = user_enum_tuple_field(s.mono.pctx, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag)
    if uf != null
        if uf.field_type != TypeKind.Array or uf.array_size <= 0
            return 0
        out.size = uf.array_size
        out.elem = uf.array_elem_type
        out.pointee = uf.array_elem_pointee
        out.name = uf.array_elem_type_name
        out.name_len = uf.array_elem_type_name_len
        return 1
    var arg_len: i32 = 0
    let arg: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, @arg_len)
    if arg == null or arg_len <= 0
        return 0
    array_arg_decode(StrView { ptr: (arg), len: (arg_len) as i64 }, out)

# `alloca %Enum`, zeroed, with tag `tag` stored at field 0; returns the slot.
pub fn emit_variant_slot(s: *EmitterState, enum_name_sv: StrView, tag: i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, c"  ; variant ctor\n")
    entry_alloca_reg_end(s)

    # Zero the whole struct so padding bytes are deterministic (matches
    # ritz0's default-initialized alloca).
    emit_str(s, IR_STORE_STRUCT)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, c" zeroinitializer, ptr ")
    emit_reg(s, slot)
    emit_str(s, IR_NL)

    # Store tag at field 0 (i8; a repr enum's discriminant, AGAST #4574).
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, c", i32 0, i32 0\n")
    emit_store_imm(s, enum_tag_ty_named(s.mono.pctx, enum_name_sv), enum_tag_value_named(s.mono.pctx, enum_name_sv, tag), tag_ptr)
    slot

# Load the enum assembled at `slot` as a value.
pub fn emit_variant_load(s: *EmitterState, slot: i32, enum_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let result: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, result)
    emit_str(s, IR_LOAD_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    result

# "variant `V` takes N payload value(s), got M" for variant `vi` of enum `ei`
# given the list `args`: at its first value, else at `call` (AGAST #4153).
pub fn emit_payload_count_error(s: *EmitterState, ei: i32, vi: i32, args: *Expr, call: SrcSpan)
    var na: i32 = 0
    var a: *Expr = args
    while a != null
        na += 1
        a = a.next
    var at: SrcSpan = call
    if args != null
        at = args.span
    emit_nd_error_begin(s, at.line, at.col)
    eprints("variant `")
    var vn_len: i32 = 0
    let vn: *u8 = enum_variant_name(s.mono.pctx, ei, vi, @vn_len)
    eprint_bytes(StrView { ptr: (vn), len: (vn_len) as i64 })
    eprint("` takes {enum_variant_field_count(s.mono.pctx, ei, vi) as i64} payload value(s), got {na as i64}\n")

# The call `e` to variant `vi` of enum `ei`, refused with the count (AGAST
# #4153).  Returns an i64 zero so the rest of the fn still emits; the error
# stops the output.
pub fn emit_payload_count_refusal(s: *EmitterState, ei: i32, vi: i32, e: *Expr) -> i32
    emit_payload_count_error(s, ei, vi, e.args, e.span)
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0  ; miscounted variant payload (error)\n")
    return z

# The AES-NI builtins lowered by emit_x86_intrinsic_v2i64.
fn is_aesni_builtin(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesenc"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesenclast"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesdec"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesdeclast"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aesimc"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"aeskeygenassist"), len: (15) as i64 }) == 1
        return 1
    0

# The simd_* builtins whose emitters (emit_simd_clmul, emit_simd_sad) always
# return <2 x i64>, independent of their operands' types.
fn is_v2i64_result_builtin(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_clmul"), len: (10) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"simd_sad"), len: (8) as i64 }) == 1
        return 1
    0

# AGAST #2052: the vector type a type-preserving simd_* call's emitter gives
# its result, so a consumer of the nested call (simd_storeu, an AES-NI
# operand, another binop) types it the same way.  Each branch repeats the
# choice its emitter makes — keep them in step:
#   simd_xor/simd_add          (emit_simd_binop)   first, then second operand
#   simd_insert/shuffle/rotl   (emit_simd_insert/_shuffle/_rotl) first operand
#   simd_load/simd_loadu       (emit_simd_loadu)   context chain only
# each defaulting to v4i32.  Returns 0 for any other call (not one of these).
fn resolve_simd_call_result_type(s: *EmitterState, call: *Expr, out_name: **u8, out_len: *i32) -> i32
    let n: *u8 = call.func_name
    let nl: i32 = call.func_name_len
    var found: i32 = 0
    if name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_xor"), len: (8) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_add"), len: (8) as i64 }) == 1
        if call.args == null or call.args.next == null
            return 0
        found = resolve_simd_arg_type(s, call.args, out_name, out_len)
        if found == 0
            found = resolve_simd_arg_type(s, call.args.next, out_name, out_len)
    else if name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_insert"), len: (11) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_shuffle"), len: (12) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_rotl"), len: (9) as i64 }) == 1
        if call.args == null
            return 0
        found = resolve_simd_arg_type(s, call.args, out_name, out_len)
    else if name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_loadu"), len: (10) as i64 }) == 1 or name_eq(StrView { ptr: (n), len: (nl) as i64 }, StrView { ptr: (c"simd_load"), len: (9) as i64 }) == 1
        found = resolve_simd_arg_type(s, null, out_name, out_len)
    else
        return 0
    if found == 0
        *out_name = c"v4i32"
        *out_len = 5
    1

# Resolve SIMD vector type-name for an arg expression — looks at ident
# locals first (they carry `type_name = "v4i32"` etc.), then falls back to
# the binding context.  Returns 1 if resolved, 0 otherwise.  An AES-NI call
# resolves to its state operand's type.
pub fn resolve_simd_arg_type(s: *EmitterState, arg: *Expr, out_name: **u8, out_len: *i32) -> i32
    if arg != null
        match arg.kind
            ExprKind.Ident =>
                let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
                if lv != null
                    if is_simd_vector_type_name(StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 }) == 1
                        *out_name = lv_type_name(lv)
                        *out_len = lv_type_name_len(lv)
                        return 1
            ExprKind.Unary =>
                # `*p` — check the operand (deref of *v4i32 → v4i32 value).
                return resolve_simd_arg_type(s, arg.operand, out_name, out_len)
            _ =>
                if arg.kind == ExprKind.Call and is_aesni_builtin(StrView { ptr: (arg.func_name), len: (arg.func_name_len) as i64 }) == 1
                    # An AES-NI call has its state operand's type (AGAST #1609).
                    if resolve_simd_arg_type(s, arg.args, out_name, out_len) == 1
                        return 1
                else if arg.kind == ExprKind.Call and is_v2i64_result_builtin(StrView { ptr: (arg.func_name), len: (arg.func_name_len) as i64 }) == 1
                    # simd_clmul / simd_sad always emit <2 x i64>, whatever the
                    # binding context says (AGAST #2051).
                    *out_name = c"v2i64"
                    *out_len = 5
                    return 1
                else if arg.kind == ExprKind.Call and resolve_simd_call_result_type(s, arg, out_name, out_len) == 1
                    # A type-preserving simd_* call (AGAST #2052).
                    return 1
    if s.ctx_simd_name != null
        if s.ctx_simd_name_len > 0
            *out_name = s.ctx_simd_name
            *out_len = s.ctx_simd_name_len
            return 1
    # Fall through to the enclosing fn's return type — needed for tail-
    # expression `return simd_loadu(...)` shapes (squeeze/crc32_simd has
    # `fn load_vec(...) -> v2i64 \n  simd_loadu(data as *i64)`).
    if s.ret_type_name != null
        if s.ret_type_name_len > 0
            if is_simd_vector_type_name(StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
                *out_name = s.ret_type_name
                *out_len = s.ret_type_name_len
                return 1
    0

pub fn emit_mem_int_ty(s: *EmitterState, bits: i32)
    emit_str(s, c"i")
    emit_int(s, bits as i64)

# Truncate an i64 value register to `bits` (no-op at 64).
pub fn mem_narrow(s: *EmitterState, v: i32, bits: i32) -> i32
    if bits == 64
        return v
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_TRUNC)
    emit_reg(s, v)
    emit_str(s, IR_TO_SP)
    emit_mem_int_ty(s, bits)
    emit_str(s, IR_NL)
    r

# Extend an iN result to the i64 value model by the pointee's signedness.
pub fn mem_widen(s: *EmitterState, v: i32, bits: i32, ty: TypeKind) -> i32
    if bits == 64
        return v
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    if ty_is_signed(ty) == 1
        emit_str(s, c" = sext ")
    else
        emit_str(s, c" = zext ")
    emit_mem_int_ty(s, bits)
    emit_str(s, IR_SP)
    emit_reg(s, v)
    emit_str(s, IR_TO_I64)
    r

# Size of one value of kind `t` (struct / enum `name` when t == TypeKind.Struct;
# a primitive spelled as a name is accepted too), or -1 for a type that does
# not exist.  Unlike elem_size_align, never falls back to 8.
fn sizeof_kind_size(s: *EmitterState, t: TypeKind, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    match t
        TypeKind.Struct =>
            if name == null or name_len <= 0
                return -1
            let prim: i64 = ty_store_size(ty_from_name(StrView { ptr: (name), len: (name_len) as i64 }))
            if prim > 0
                return prim
            if find_struct(s, StrView { ptr: (name), len: (name_len) as i64 }) != null or is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1 or user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 }) >= 0
                return get_struct_size_by_name(s, StrView { ptr: (name), len: (name_len) as i64 })
            return -1
        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
            return 8
        _ => pass
    let sz: i64 = ptr_pointee_size(s, t, StrView { ptr: (null), len: (0) as i64 })
    if sz > 0
        return sz
    return -1

fn sizeof_shape_size(s: *EmitterState, sh: *ArrayShape, skip_outer: i32) -> i64
    var n: i64 = 1
    var d: i32 = skip_outer
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    let leaf: i64 = sizeof_kind_size(s, sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    if leaf < 0
        return -1
    return n * leaf

fn sizeof_times(count: i64, elem: i64) -> i64
    if elem < 0
        return -1
    return count * elem

# A type alias `name`, sized; -1 when `name` is no alias (or sizes to nothing).
fn sizeof_alias_size(s: *EmitterState, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var count: i64 = 0
    var leaf: TypeKind = TypeKind.Void
    var leaf_name: *u8 = null
    var leaf_len: i32 = 0
    if type_alias_sizeof_shape(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }, @count, @leaf, @leaf_name, @leaf_len) == 0
        return -1
    return sizeof_times(count, sizeof_kind_size(s, leaf, StrView { ptr: (leaf_name), len: (leaf_len) as i64 }))

# 1 when `name` is a value in scope: a local or param, a global or a const.
fn sizeof_is_value(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if find_local_idx(s, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    if find_global(s, StrView { ptr: (name), len: (len) as i64 }) != null
        return 1
    if find_const_entry(s, StrView { ptr: (name), len: (len) as i64 }) != null
        return 1
    return 0

# A type spelled as an identifier: a primitive, struct, enum or alias.
fn sizeof_type_name_size(s: *EmitterState, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let alias_sz: i64 = sizeof_alias_size(s, StrView { ptr: (name), len: (len) as i64 })
    if alias_sz >= 0
        return alias_sz
    return sizeof_kind_size(s, TypeKind.Struct, StrView { ptr: (name), len: (len) as i64 })

# 1 when `e` spells a type rather than a value (`u8`, `Pair`, `*Pair`): the
# operand of `sizeof(*u8)` parses as a deref of the name `u8`.
fn sizeof_names_type(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    match e.kind
        ExprKind.TypeOperand =>
            return 1
        ExprKind.Ident =>
            if sizeof_is_value(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
                return 0
            if sizeof_type_name_size(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
                return 1
            return 0
        _ => pass
    if e.kind == ExprKind.Unary and (e.op == OpKind.Deref or e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        return sizeof_names_type(s, e.operand)
    return 0

# The newest declaration of `name` in this function (null if none, or if
# the table overflowed and can no longer be trusted).
fn sizeof_find_decl(s: *EmitterState, name_sv: StrView) -> *NarrowDecl
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if s.narrow_decl_overflow != 0
        return null
    var i: i32 = s.narrow_decl_count - 1
    while i >= 0
        let d: *NarrowDecl = @s.narrow_decls[i]
        if name_eq(StrView { ptr: (d.name), len: (d.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return d
        i = i - 1
    return null

fn sizeof_local_size(s: *EmitterState, lv: *LocalVar, depth: i32) -> i64
    let t: TypeKind = lv_var_type(lv)
    match t
        TypeKind.Array =>
            if lv_array_shape(lv) != null
                return sizeof_shape_size(s, lv_array_shape(lv), 0)
            return sizeof_times(lv_array_size(lv) as i64, sizeof_kind_size(s, lv_array_elem_type(lv), StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 }))
        TypeKind.Struct =>
            return sizeof_kind_size(s, TypeKind.Struct, StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 })
        _ => pass
    if lv.is_bool == 1
        return 1
    if ty_bits(t) == 0
        return sizeof_kind_size(s, t, StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 })
    # An integer slot: ritz1 keeps every integer in i64, and the parser
    # defaults a missing annotation to TypeKind.I64, so the slot can't say.
    # An unannotated `let x = init` has init's type, as in ritz0.
    let d: *NarrowDecl = sizeof_find_decl(s, StrView { ptr: (lv.name), len: (lv.name_len) as i64 })
    if d != null and d.declared == TypeKind.Void
        if d.init == null
            return -1
        return sizeof_expr_size(s, d.init, depth + 1)
    return sizeof_kind_size(s, t, StrView { ptr: (null), len: (0) as i64 })

fn sizeof_global_size(s: *EmitterState, g: *GlobalVarDef) -> i64
    if g.var_type == TypeKind.Array
        if g.array_shape != null
            return sizeof_shape_size(s, g.array_shape, 0)
        return sizeof_times(g.array_size as i64, sizeof_kind_size(s, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 }))
    return sizeof_kind_size(s, g.var_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })

fn sizeof_ident_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    # A value in scope wins over a type of the same name, as in ritz0.
    # The written integer type first (narrow_ident_type: consts, annotated
    # locals, params, narrow globals).
    let nt: TypeKind = narrow_ident_type(s, e)
    if nt != TypeKind.NarrowUnknown
        return sizeof_kind_size(s, nt, StrView { ptr: (null), len: (0) as i64 })
    let lidx: i32 = find_local_idx(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if lidx >= 0
        return sizeof_local_size(s, local_at(s, lidx), depth)
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if g != null
        return sizeof_global_size(s, g)
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if ce != null
        if ce.const_type == TypeKind.Array
            return sizeof_times(ce.array_size as i64, sizeof_kind_size(s, ce.array_elem_type, StrView { ptr: (ce.array_elem_type_name), len: (ce.array_elem_type_name_len) as i64 }))
        return sizeof_kind_size(s, ce.const_type, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    return sizeof_type_name_size(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# The struct an element of array `b` (a local or global ident) is, or 0.
fn sizeof_array_elem_struct(s: *EmitterState, b: *Expr, name: **u8, len: *i32) -> i32
    if b.kind != ExprKind.Ident
        return 0
    let lidx: i32 = find_local_idx(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        if lv_var_type(lv) == TypeKind.Array and lv_array_shape(lv) == null and lv_array_elem_type(lv) == TypeKind.Struct
            *name = lv_type_name(lv)
            *len = lv_type_name_len(lv)
            return 1
        return 0
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if g != null and g.var_type == TypeKind.Array and g.array_shape == null and g.array_elem_type == TypeKind.Struct
        *name = g.array_elem_type_name
        *len = g.array_elem_type_name_len
        return 1
    return 0

# The field `e` (an ExprKind.Member) names: member_field_def's receivers, plus
# an element of a struct array (`ps[i].f`).
fn sizeof_member_field(s: *EmitterState, e: *Expr) -> *StructField
    let f: *StructField = member_field_def(s, e)
    if f != null
        return f
    # AGAST #2152: `arr[i].m`, `(*p).m`, `g[i][j].m` -- the emitter's own
    # type-only resolver.
    let rf: *StructField = resolve_member_chain_field(s, e)
    if rf != null
        return rf
    if e.left == null or e.left.kind != ExprKind.Index
        return null
    var sname: *u8 = null
    var slen: i32 = 0
    if sizeof_array_elem_struct(s, e.left.left, @sname, @slen) == 0
        return null
    let st: *StructDef = find_struct(s, StrView { ptr: (sname), len: (slen) as i64 })
    if st == null
        return null
    let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if idx < 0
        return null
    return get_field_type(st, idx)

# `base[i]`: one element of an array (local, global or field) or pointer.
fn sizeof_index_size(s: *EmitterState, e: *Expr) -> i64
    if e.right != null and e.right.kind == ExprKind.Range
        return -1
    # AGAST #2152: any index chain over an N-D array (local, global or a
    # field through any base): `s.m[0][1]`, `arr[1].m[0][2]`, `g[1][2]`.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null
        return sizeof_shape_size(s, nd_sh, nd_depth)
    let b: *Expr = e.left
    if b.kind == ExprKind.Member
        let f: *StructField = member_field_def(s, b)
        if f == null
            return -1
        if f.field_type == TypeKind.Array and f.array_shape != null
            return sizeof_shape_size(s, f.array_shape, 1)   # AGAST #2097: a row
        match f.field_type
            TypeKind.Array =>
                return sizeof_kind_size(s, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
            TypeKind.Ptr =>
                return sizeof_kind_size(s, ptr_field_elem_kind(f), StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            _ => pass
        return -1
    if b.kind != ExprKind.Ident
        return -1
    let lidx: i32 = find_local_idx(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        match lv_var_type(lv)
            TypeKind.Array =>
                if lv_array_shape(lv) != null
                    return sizeof_shape_size(s, lv_array_shape(lv), 1)
                return sizeof_kind_size(s, lv_array_elem_type(lv), StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 })
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>
                return sizeof_kind_size(s, lv_pointee_type(lv), StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 })
            _ => pass
        return -1
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
    if g != null
        match g.var_type
            TypeKind.Array =>
                if g.array_shape != null
                    return sizeof_shape_size(s, g.array_shape, 1)
                return sizeof_kind_size(s, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>   # AGAST #1554: S is in pointee_type_name
                return sizeof_kind_size(s, g.pointee_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })
            _ => pass
    return -1

# `*p`: the pointee of a pointer local / param / global, or of a pointer
# field (`*w.t.v`, through a generic instance's fields too: AGAST #3747).
fn sizeof_deref_size(s: *EmitterState, e: *Expr) -> i64
    let o: *Expr = e.operand
    if o != null and o.kind == ExprKind.Member
        let f: *StructField = sizeof_member_field(s, o)
        if f == null
            return -1
        match f.field_type
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr =>
                return sizeof_kind_size(s, ptr_field_elem_kind(f), StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            _ => pass
        return -1
    if o == null or o.kind != ExprKind.Ident
        return -1
    let lidx: i32 = find_local_idx(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
    if lidx >= 0
        let lv: *LocalVar = local_at(s, lidx)
        match lv_var_type(lv)
            TypeKind.PtrPtr =>
                return 8
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                return sizeof_kind_size(s, lv_pointee_type(lv), StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 })
            _ => pass
        return -1
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
    if g != null
        match g.var_type
            TypeKind.PtrPtr =>
                return 8
            # AGAST #1554: a global keeps a struct pointee's name in
            # pointee_type_name (type_name is null), and `@S` is a pointer too.
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                return sizeof_kind_size(s, g.pointee_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })
            _ => pass
    return -1

# Size of `e`'s type, or -1 when it can't be determined.  `depth` bounds the
# walk through unannotated locals' initialisers.
fn sizeof_expr_size(s: *EmitterState, e: *Expr, depth: i32) -> i64
    if e == null or depth > 16
        return -1
    let k: ExprKind = e.kind
    match k
        ExprKind.TypeOperand =>
            return sizeof_times(e.int_val, sizeof_kind_size(s, e.type_kind, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }))
        ExprKind.Ident =>
            return sizeof_ident_size(s, e, depth)
        ExprKind.IntLit | ExprKind.FloatLit | ExprKind.CstringLit =>
            return 8
        ExprKind.CharLit =>
            return 1
        ExprKind.StringLit =>
            return sizeof_kind_size(s, TypeKind.Struct, StrView { ptr: (c"StrView"), len: (7) as i64 })
        ExprKind.Member =>
            let f: *StructField = sizeof_member_field(s, e)
            if f == null
                return -1
            if f.field_type == TypeKind.Array and f.array_shape != null
                return sizeof_shape_size(s, f.array_shape, 0)   # AGAST #2097
            if f.field_type == TypeKind.Array
                return sizeof_times(f.array_size as i64, sizeof_kind_size(s, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }))
            return sizeof_kind_size(s, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
        ExprKind.Index =>
            return sizeof_index_size(s, e)
        ExprKind.Unary =>
            if sizeof_names_type(s, e) == 1
                return 8   # `*u8`, `@Pair`: a pointer type
            match e.op
                OpKind.Addr | OpKind.AddrMut =>
                    return 8
                OpKind.Deref =>
                    return sizeof_deref_size(s, e)
                _ => pass
            return sizeof_expr_size(s, e.operand, depth + 1)
        ExprKind.Binary =>
            # As ritz0: a comparison or `and`/`or` is a bool, anything else
            # has its left operand's type.
            if op_is_cmp_or_logic(e.op)
                return 1
            return sizeof_expr_size(s, e.left, depth + 1)
        ExprKind.Cast =>
            return sizeof_kind_size(s, e.type_kind, StrView { ptr: (null), len: (0) as i64 })
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, e)
            if fd == null
                return -1
            return sizeof_kind_size(s, fd.return_type, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
        _ => pass
    return -1

# "error: <file>:<line>:<col>: sizeof: ..." — counted, so main refuses to
# write the output.
fn sizeof_error(s: *EmitterState, e: *Expr, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    emit_str(s, c"  ; ERROR: sizeof operand\n")
    diag_error_at(emitter_source_file(), e.span)
    if name != null
        eprints("sizeof: unknown type or value `")
        var i: i32 = 0
        while i < len
            eprint_char(*(name + i))
            i += 1
        eprints("`\n")
    else
        eprints("sizeof: cannot determine the type of this expression\n")
    s.error_count = s.error_count + 1

# The constant `sizeof(...)` folds to; reports and returns 0 when unknown.
pub fn sizeof_call_value(s: *EmitterState, e: *Expr) -> i64
    let arg: *Expr = e.args
    if arg == null or arg.next != null
        emit_nd_error(s, e.span.line, e.span.col, c"sizeof takes exactly one argument (a type or an expression)")
        return 0
    let sz: i64 = sizeof_expr_size(s, arg, 0)
    if sz >= 0
        return sz
    if arg.kind == ExprKind.Ident and sizeof_is_value(s, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 }) == 0
        sizeof_error(s, arg, StrView { ptr: (arg.ident_ptr), len: (arg.ident_len) as i64 })
    else
        sizeof_error(s, arg, StrView { ptr: (null), len: (0) as i64 })
    return 0

# A call-position compiler intrinsic, lowered inline and never an extern.
# SIMD builtins (AGAST #167) become native LLVM vector instructions: the
# generic call path's `call i64 @simd_loadu(ptr ...)` then `store %v4i32`
# failed the IR verifier (ritz0's _try_emit_simd_builtin).  The x86 SHA-NI /
# AES-NI ones take and return vectors and map onto `llvm.x86.*` directly.
enum CallIntrinsicOp
    SimdLoad
    SimdStore
    SimdXor
    SimdAdd
    SimdExtract
    SimdInsert
    SimdShuffle
    SimdRotl
    SimdSad
    SimdClmul
    X86V4i32
    X86V2i64
    AesKeygenAssist
    Xgetbv

# `llvm` names an X86* op's LLVM intrinsic; `arg` is its operand count, or a
# SimdLoad / SimdStore's unaligned flag.
struct CallIntrinsic
    name: StrView
    op: CallIntrinsicOp
    llvm: StrView
    arg: i32

const CALL_INTRINSICS: [22]CallIntrinsic = [
    CallIntrinsic { name: "simd_loadu", op: CallIntrinsicOp.SimdLoad, llvm: "", arg: 1 },
    CallIntrinsic { name: "simd_load", op: CallIntrinsicOp.SimdLoad, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_storeu", op: CallIntrinsicOp.SimdStore, llvm: "", arg: 1 },
    CallIntrinsic { name: "simd_store", op: CallIntrinsicOp.SimdStore, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_xor", op: CallIntrinsicOp.SimdXor, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_add", op: CallIntrinsicOp.SimdAdd, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_extract", op: CallIntrinsicOp.SimdExtract, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_insert", op: CallIntrinsicOp.SimdInsert, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_shuffle", op: CallIntrinsicOp.SimdShuffle, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_rotl", op: CallIntrinsicOp.SimdRotl, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_sad", op: CallIntrinsicOp.SimdSad, llvm: "", arg: 0 },
    CallIntrinsic { name: "simd_clmul", op: CallIntrinsicOp.SimdClmul, llvm: "", arg: 0 },
    CallIntrinsic { name: "sha256rnds2", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256rnds2", arg: 3 },
    CallIntrinsic { name: "sha256msg1", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256msg1", arg: 2 },
    CallIntrinsic { name: "sha256msg2", op: CallIntrinsicOp.X86V4i32, llvm: "llvm.x86.sha256msg2", arg: 2 },
    CallIntrinsic { name: "aesenc", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesenc", arg: 2 },
    CallIntrinsic { name: "aesenclast", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesenclast", arg: 2 },
    CallIntrinsic { name: "aesdec", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesdec", arg: 2 },
    CallIntrinsic { name: "aesdeclast", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesdeclast", arg: 2 },
    CallIntrinsic { name: "aesimc", op: CallIntrinsicOp.X86V2i64, llvm: "llvm.x86.aesni.aesimc", arg: 1 },
    CallIntrinsic { name: "aeskeygenassist", op: CallIntrinsicOp.AesKeygenAssist, llvm: "", arg: 0 },
    CallIntrinsic { name: "xgetbv", op: CallIntrinsicOp.Xgetbv, llvm: "", arg: 0 }
]

# The intrinsic `name` calls, or null.
pub fn call_intrinsic_named(name: StrView) -> *CallIntrinsic
    for i in 0..22
        if name_eq(name, CALL_INTRINSICS[i].name) == 1
            return @CALL_INTRINSICS[i]
    null

# The `call` keyword and result type after `%r = `, for a first-class result.
pub fn emit_call_ret_kw(s: *EmitterState, fn_def: *FnDef, ret_type: TypeKind, ret_sv: StrView, call_cc: *u8)
    let ret_struct_name: *u8 = ret_sv.ptr
    let ret_struct_name_len: i32 = ret_sv.len as i32
    if ret_array_of(fn_def) != null
        # AGAST #2302: a `[N x T]` value, which emit_array_local_whole_assign
        # stores; a discarded call drops it.
        emit_str(s, IR_CALL)
        emit_str(s, call_cc)
        emit_fn_ret_llvm_type(s, fn_def)
        emit_str(s, IR_SP)
    else if ret_type == TypeKind.Struct and ret_struct_name_len > 0
        # emit_llvm_type_struct routes tagged-enum Result$/Option$ to i64
        # (task-99 cluster #3).
        emit_str(s, IR_CALL)
        emit_str(s, call_cc)
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 })
        emit_str(s, IR_SP)
    else
        match ret_type
            TypeKind.Bool =>
                # Bool-returning fns emit `define i1 @f(...)`, so the call must
                # match: `call i1 @f(...)`.  Without this branch the call site
                # emits `call i64` and clang rejects the type mismatch.  The
                # zext-to-i64 happens below in the return-narrow block.
                emit_str(s, IR_CALL)
                emit_str(s, call_cc)
                emit_str(s, c"i1 ")
            TypeKind.F32 =>
                emit_str(s, IR_CALL)
                emit_str(s, call_cc)
                emit_str(s, c"float ")
            TypeKind.F64 =>
                emit_str(s, IR_CALL)
                emit_str(s, call_cc)
                emit_str(s, c"double ")
            _ =>
                if ty_int_bits(ret_type) == 32
                    emit_str(s, IR_CALL)
                    emit_str(s, call_cc)
                    emit_str(s, c"i32 ")
                else if ty_int_bits(ret_type) == 16
                    emit_str(s, IR_CALL)
                    emit_str(s, call_cc)
                    emit_str(s, c"i16 ")
                else if ty_int_bits(ret_type) == 8
                    emit_str(s, IR_CALL)
                    emit_str(s, call_cc)
                    emit_str(s, c"i8 ")
                else
                    match ret_type
                        TypeKind.MutRef =>
                            emit_str(s, IR_CALL)
                            emit_str(s, call_cc)
                            emit_str(s, c"ptr ")
                        TypeKind.Ptr | TypeKind.Ref =>
                            # Match definition's return type (emit_llvm_type emits i64 for TypeKind.Ptr/TypeKind.Ref)
                            emit_str(s, IR_CALL)
                            emit_str(s, call_cc)
                            emit_str(s, c"i64 ")
                        _ =>
                            emit_str(s, IR_CALL)
                            emit_str(s, call_cc)
                            emit_str(s, c"i64 ")

# A call's result in the i64 value model: narrow ints and bools extended.
pub fn widen_call_result(s: *EmitterState, ret_type: TypeKind, ret_sv: StrView, call_result: i32) -> i32
    let ret_struct_name: *u8 = ret_sv.ptr
    let ret_struct_name_len: i32 = ret_sv.len as i32
    match ret_type
        TypeKind.Bool =>
            let ext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.I32 =>
            let ext: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.U32 =>
            let ext: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.I16 =>
            let ext: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.U16 =>
            let ext: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.I8 =>
            let ext: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, call_result)
            return ext
        TypeKind.U8 =>
            let ext: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, call_result)
            return ext
        _ =>
            if ret_type == TypeKind.Struct and ret_struct_name_len > 0 and is_primitive_type_name(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }) == 1
                # Post-monomorph primitive return (vec_push_u16_method parity):
                # generic `T` substituted with u16/i32/etc. leaves TypeKind.Struct in
                # the AST.  emit_llvm_type_struct emitted the LLVM primitive type
                # for the `call` opcode; now extend to i64 so the caller's
                # expression-level representation stays uniform.
                if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1
                    let e8: i32 = ir_zext_i8_i64(s.out, @s.reg_counter, call_result)
                    return e8
                else if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
                    let e8s: i32 = ir_sext_i8_i64(s.out, @s.reg_counter, call_result)
                    return e8s
                else if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"u16"), len: (3) as i64 }) == 1
                    let e16: i32 = ir_zext_i16_i64(s.out, @s.reg_counter, call_result)
                    return e16
                else if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"i16"), len: (3) as i64 }) == 1
                    let e16s: i32 = ir_sext_i16_i64(s.out, @s.reg_counter, call_result)
                    return e16s
                else if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"u32"), len: (3) as i64 }) == 1
                    let e32: i32 = ir_zext_i32_i64(s.out, @s.reg_counter, call_result)
                    return e32
                else if name_eq(StrView { ptr: (ret_struct_name), len: (ret_struct_name_len) as i64 }, StrView { ptr: (c"i32"), len: (3) as i64 }) == 1
                    let e32s: i32 = ir_sext_i32_i64(s.out, @s.reg_counter, call_result)
                    return e32s
                # bool/usize/isize/u64/i64/f32/f64: no extension.
                return call_result
            else if ret_type == TypeKind.MutRef
                # TypeKind.MutRef call returns ptr — convert to i64 for consistent value representation
                let pti: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, call_result)
                return pti
    # TypeKind.Ptr/TypeKind.Ref calls now return i64 directly — no conversion needed
    return call_result

# AGAST #4603: `br` on the Option / Result tag in `tag_reg` (an i8; Some /
# Ok is 0): a None / Err goes to a block that calls `llvm.trap` and ends
# `unreachable`, ritz0's `unwrap.bad`.  Emission carries on in the Some / Ok
# block.  No `declare`: LLVM's IR parser declares an `llvm.*` intrinsic itself,
# as it does the undeclared `@llvm.memcpy` calls elsewhere.
pub fn emit_unwrap_tag_trap(s: *EmitterState, tag_reg: i32)
    let ok_i1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ok_i1)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", 0  ; unwrap tag check (Ok/Some == 0)\n")
    let l_ok: i32 = next_label(s)
    let l_bad: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, ok_i1)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, l_ok)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, l_bad)
    emit_str(s, IR_NL)
    begin_block(s, l_bad)
    emit_str(s, c"  call void @llvm.trap()  ; unwrap of None / Err\n")
    emit_str(s, c"  unreachable\n")
    begin_block(s, l_ok)

# Intrinsic declarations referenced by the current module: bit
# (method_id * 4 + width_index).  Cleared once emitted.
pub var g_bitops_decl_mask: i64 = 0

# 0 rotl, 1 rotr, 2 clz, 3 ctz, 4 popcnt, 5 swap_bytes; -1 otherwise.
pub fn bitops_method_id(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4
        if *(name) == 'r' and *(name + 1) == 'o' and *(name + 2) == 't'
            if *(name + 3) == 'l'
                return 0
            if *(name + 3) == 'r'
                return 1
    if len == 3
        if *(name + 1) == 'l' and *(name + 2) == 'z' and *(name) == 'c'
            return 2
        if *(name + 1) == 't' and *(name + 2) == 'z' and *(name) == 'c'
            return 3
    if len == 6
        if *(name) == 'p' and *(name + 1) == 'o' and *(name + 2) == 'p' and *(name + 3) == 'c' and *(name + 4) == 'n' and *(name + 5) == 't'
            return 4
    if len == 10
        let want: *u8 = c"swap_bytes"
        for i in 0..10
            if *(name + i) != *(want + i)
                return 0 - 1
        return 5
    0 - 1

# Static type of a BitOps receiver.  get_expr_type reports TypeKind.I64 for any
# method call; a BitOps chain is refined here so `x.rotl(1).rotl(2)` rotates
# at x's width, as ritz0 does.  A binary keeps get_expr_type's left-operand
# typing — ritz0 also types `(0 | x)` as i64, and the two must agree.
pub fn int_method_recv_type(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind == ExprKind.Method
        let mid: i32 = bitops_method_id(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if mid == 2 or mid == 3 or mid == 4
            return TypeKind.U8
        if mid >= 0
            return int_method_recv_type(s, e.left)
    if e.kind == ExprKind.Binary
        return int_method_recv_type(s, e.left)
    expr_slot_ty(e)

pub fn emit_bitops_intrinsic_name(s: *EmitterState, mid: i32, bits: i32)
    if mid == 0
        emit_str(s, c"@llvm.fshl.i")
    else if mid == 1
        emit_str(s, c"@llvm.fshr.i")
    else if mid == 2
        emit_str(s, c"@llvm.ctlz.i")
    else if mid == 3
        emit_str(s, c"@llvm.cttz.i")
    else if mid == 4
        emit_str(s, c"@llvm.ctpop.i")
    else
        emit_str(s, c"@llvm.bswap.i")
    emit_int(s, bits as i64)

# Emit `declare`s for every BitOps intrinsic this module called.  Called from
# emit_module's trailer; the mask is reset so a later module starts clean.
pub fn emit_bitops_intrinsic_decls(s: *EmitterState)
    var mid: i32 = 0
    while mid < 6
        var wi: i32 = 0
        while wi < 4
            let bit: i64 = (mid * 4 + wi) as i64
            let bits: i32 = 8 << wi
            wi = wi + 1
            if ((g_bitops_decl_mask >> bit) & 1) == 1
                emit_str(s, c"declare i")
                emit_int(s, bits as i64)
                emit_str(s, IR_SP)
                emit_bitops_intrinsic_name(s, mid, bits)
                emit_str(s, c"(i")
                emit_int(s, bits as i64)
                if mid == 0 or mid == 1
                    emit_str(s, c", i")
                    emit_int(s, bits as i64)
                    emit_str(s, c", i")
                    emit_int(s, bits as i64)
                else if mid == 2 or mid == 3
                    emit_str(s, c", i1")
                emit_str(s, IR_CLOSE)
        mid = mid + 1
    g_bitops_decl_mask = 0

# llvm.fabs declarations referenced by the current module: bit 0 f32, bit 1
# f64.  Cleared once emitted.
pub var g_float_decl_mask: i64 = 0

pub fn emit_float_llvm_ty(s: *EmitterState, ft: TypeKind)
    if ft == TypeKind.F32
        emit_str(s, c"float")
    else
        emit_str(s, c"double")

# Emit `declare`s for every float intrinsic this module called.  Called from
# emit_module's trailer, beside emit_bitops_intrinsic_decls.
pub fn emit_float_intrinsic_decls(s: *EmitterState)
    if (g_float_decl_mask & 1) == 1
        emit_str(s, c"declare float @llvm.fabs.f32(float)\n")
    if (g_float_decl_mask & 2) == 2
        emit_str(s, c"declare double @llvm.fabs.f64(double)\n")
    g_float_decl_mask = 0
    var k: i32 = 0
    while k < 16
        if ((g_fptoi_sat_mask >> k) & 1) == 1
            emit_str(s, c"declare ")
            fptoi_sat_name(s, k, 1)
            emit_str(s, c"(")
            emit_float_llvm_ty(s, fptoi_sat_src(k))
            emit_str(s, IR_CLOSE)
        k += 1
    g_fptoi_sat_mask = 0

# llvm.fpto[su]i.sat declarations referenced by the current module, one bit per
# (source width, signedness, target width): see fptoi_sat_key.  Cleared once
# emitted, by emit_float_intrinsic_decls.
pub var g_fptoi_sat_mask: i64 = 0

# Bit index for a saturating conversion: bit 3 = f64 source, bit 2 = unsigned,
# bits 0-1 = log2(target bits / 8).
fn fptoi_sat_key(ft: TypeKind, bits: i32, unsigned: i32) -> i32
    var k: i32 = 3
    if bits == 8
        k = 0
    else if bits == 16
        k = 1
    else if bits == 32
        k = 2
    if unsigned == 1
        k = k + 4
    if ft != TypeKind.F32
        k = k + 8
    k

fn fptoi_sat_src(k: i32) -> TypeKind
    if (k & 8) == 8
        return TypeKind.F64
    TypeKind.F32

fn fptoi_sat_bits(k: i32) -> i32
    8 << (k & 3)

# `iN @llvm.fpto[su]i.sat.iN.f{32,64}`, without the `iN ` return type unless
# `with_ret`.
fn fptoi_sat_name(s: *EmitterState, k: i32, with_ret: i32)
    if with_ret == 1
        emit_str(s, c"i")
        emit_int(s, fptoi_sat_bits(k) as i64)
        emit_str(s, IR_SP)
    if (k & 4) == 4
        emit_str(s, c"@llvm.fptoui.sat.i")
    else
        emit_str(s, c"@llvm.fptosi.sat.i")
    emit_int(s, fptoi_sat_bits(k) as i64)
    if (k & 8) == 8
        emit_str(s, c".f64")
    else
        emit_str(s, c".f32")

# `x as <int>` for a float `x` of type ft (LANGUAGE_SPEC §7.5, AGAST #2192):
# round toward zero, saturate at the target's range, NaN is 0, then extend back
# to the i64 every integer is carried in, by the target's signedness.  A bare
# fptosi is poison out of range (`200.0 as u8` through an i8), and could not
# reach a u64 above 2^63 at all.  ritz0's _emit_float_to_int_sat.
pub fn emit_float_to_int_sat(s: *EmitterState, ft: TypeKind, x: i32, target_ty: TypeKind) -> i32
    var signed: i32 = 1
    let bits: i32 = type_code_scalar_bits(target_ty, @signed)
    if target_ty == TypeKind.U64
        signed = 0
    let k: i32 = fptoi_sat_key(ft, bits, 1 - signed)
    g_fptoi_sat_mask = g_fptoi_sat_mask | (1 << k)
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_CALL)
    fptoi_sat_name(s, k, 1)
    emit_str(s, c"(")
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, x)
    emit_str(s, IR_CLOSE)
    if bits == 64
        return r
    let ext: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ext)
    if signed == 1
        emit_str(s, c" = sext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_reg(s, r)
    emit_str(s, IR_TO_I64)
    ext

# `t = sitofp(fptosi(x))`: truncation toward zero through i64.
pub fn emit_float_trunc(s: *EmitterState, ft: TypeKind, x: i32) -> i32
    let i: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, i)
    emit_str(s, c" = fptosi ")
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, x)
    emit_str(s, IR_TO_I64)
    let t: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, t)
    emit_str(s, c" = sitofp i64 ")
    emit_reg(s, i)
    emit_str(s, IR_TO_SP)
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_NL)
    t

# `<dst> = <op> T <a>, <constant>`
pub fn emit_float_binop_const(s: *EmitterState, op: *u8, ft: TypeKind, a: i32, k: *u8) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = ")
    emit_str(s, op)
    emit_str(s, IR_SP)
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, a)
    emit_str(s, IR_COMMA)
    emit_str(s, k)
    emit_str(s, IR_NL)
    r

# `<dst> = fcmp <pred> T <a>, <b>`
pub fn emit_float_fcmp(s: *EmitterState, pred: *u8, ft: TypeKind, a: i32, b: i32) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = fcmp ")
    emit_str(s, pred)
    emit_str(s, IR_SP)
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, a)
    emit_str(s, IR_COMMA)
    emit_reg(s, b)
    emit_str(s, IR_NL)
    r

# `<dst> = select i1 <c>, T <a>, T <b>`
pub fn emit_float_select(s: *EmitterState, ft: TypeKind, cond: i32, a: i32, b: i32) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = select i1 ")
    emit_reg(s, cond)
    emit_str(s, IR_COMMA)
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, a)
    emit_str(s, IR_COMMA)
    emit_float_llvm_ty(s, ft)
    emit_str(s, IR_SP)
    emit_reg(s, b)
    emit_str(s, IR_NL)
    r

# `E.from(v)` on the bare name of an enum (not a local or global) that is
# still a method call here: monomorph rewrites every one into `E__from(v)`
# when the generated fn exists (rewrite_enum_from_call, in both its walk and
# its clones of generic bodies), so this is the enum without one -- the
# located error ritz0 gives (enum_from.py).  -1 when `e` is no such call.
pub fn try_emit_enum_from(s: *EmitterState, e: *Expr) -> i32
    if is_enum_from_call(s.mono.pctx, e) == 0
        return 0 - 1
    if find_local(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) >= 0
        return 0 - 1
    if find_global(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) != null
        return 0 - 1
    emit_str(s, c"  ; ERROR: enum has no from\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints("enum '")
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    eprints("' has no 'from': that needs a representation type ('enum ")
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    eprints(": <integer type>') and its module must import ritzlib.option\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, IR_ADD_ZERO)
    z

# LANGUAGE_SPEC §5.4 (AGAST #2403): a `self` that's a pointer to a pointer
# takes the levels it asks for, so a place one level short of it is lent, as
# `T.m(x)` of a by-value `self`: a type isn't a receiver, and the struct has no
# `self` slot to go to, as in ritz0 (ref_rules.static_call_of_self, AGAST #2292).
# Unlocated, a struct local's `%C` went to the `ptr` and segfaulted.
pub fn static_call_of_self_error(s: *EmitterState, e: *Expr, m: *FnDef)
    emit_str(s, c"  ; ERROR: static call of a `self` method (AGAST #2292)\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints("Static method call Type.method() but method '")
    eprint_bytes(StrView { ptr: (m.name), len: (m.name_len) as i64 })
    # The hint, as ritz0 words it: `c.get()` or `C_get(@&c)` (`C_get(c)` of a
    # by-value `self`), the type's name in lower case for the receiver (#3236).
    eprints("' expects 'self' parameter: write `")
    eprint_lower(e.left.ident_ptr, e.left.ident_len)
    eprint_char('.')
    eprint_bytes(StrView { ptr: (m.name), len: (m.name_len) as i64 })
    eprints("()` or `")
    eprint_bytes(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    eprint_char('_')
    eprint_bytes(StrView { ptr: (m.name), len: (m.name_len) as i64 })
    eprint_char('(')
    if param_self_is_value(m.params) == 0
        eprints("@&")
    eprint_lower(e.left.ident_ptr, e.left.ident_len)
    eprints(")`\n")
    s.error_count = s.error_count + 1

# `n` bytes of `p` to stderr, ASCII upper case lowered.
fn eprint_lower(p: *u8, n: i32)
    for i in 0..n
        let ch: u8 = *(p + i)
        if ch >= 'A' and ch <= 'Z'
            eprint_char(ch + 32)
        else
            eprint_char(ch)

# `@&recv` (`@recv` for `@*S`), the rule `name:& *U` has (§13.3).  Nothing else
# is borrowed for it: a call result, or a receiver two levels short, is
# refused.  `recv_levels` is what the receiver holds, -1 if unknown.  1 when
# it reported an error.
pub fn refuse_receiver_short_of_self(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32) -> i32
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return 0
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels >= want
        return 0
    # A place one short is lent; a `let`'s is refused on Sema (let_check_receiver).
    if recv_levels + 1 == want and arg_is_place(s, recv) == 1
        return 0
    emit_str(s, c"  ; ERROR: receiver short of `self` (AGAST #2403)\n")
    diag_error_at(emitter_source_file(), recv.span)
    eprints("a receiver of a pointer `self` must be a place one level short of it, or have its levels\n")
    s.error_count = s.error_count + 1
    1

# AGAST #3071: 1 for `a[i]` of a local array, which emit_lvalue_ptr places.
pub fn recv_elem_is_local_array(s: *EmitterState, recv: *Expr) -> i32
    if recv.left == null or recv.left.kind != ExprKind.Ident
        return 0
    let arr: *LocalVar = find_local_struct_name(s, StrView { ptr: (recv.left.ident_ptr), len: (recv.left.ident_len) as i64 })
    (arr != null and lv_var_type(arr) == TypeKind.Array) as i32

# AGAST #3071: `self: **S` (any `self` two levels or more from its struct) is
# passed at the levels it declares, from `base`, the receiver's place, which
# holds `recv_levels` pointers.  1 when it set `*out`.  A receiver with no
# place is an error here, not a `*S` passed as the `**S`.
pub fn pass_self_at_its_levels(s: *EmitterState, recv: *Expr, mfn: *FnDef, recv_levels: i32, base: i32, out: *i32) -> i32
    if mfn == null or param_is_self(mfn.params) == 0 or recv_levels < 0
        return 0
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or recv_levels + 1 < want
        return 0
    if base < 0
        emit_nd_error(s, recv.span.line, recv.span.col, c"this receiver of a `self` two levels from its struct isn't lowered (AGAST #2404)")
        return 0
    *out = emit_load_levels(s, base, recv_levels + 1 - want)
    1

# AGAST #2404: the levels between `recv` and its struct when it's a `**S` or
# deeper that no arm of emit_expr_method names: a global (`var G: **S`), an
# element of a `[N]**S` array, or `a[i]` through a `***S`.  ptr_levels_of types
# all but the last; `a[i]` on a pointer is one level short of `a`.  0 otherwise,
# with *out_name / *out_len the struct's name when it isn't.
pub fn recv_ptr_ptr_levels(s: *EmitterState, recv: *Expr, out_name: **u8, out_len: *i32) -> i32
    var inner: TypeKind = TypeKind.Void
    var levels: i32 = 0
    if recv.kind == ExprKind.Ident or recv.kind == ExprKind.Index
        levels = ptr_levels_of(s, recv, @inner, out_name, out_len)
    if levels == 0 and recv.kind == ExprKind.Index and recv.left != null and (recv.right == null or recv.right.kind != ExprKind.Range)
        levels = ptr_levels_of(s, recv.left, @inner, out_name, out_len) - 1
    if levels < 2 or inner != TypeKind.Struct or *out_len <= 0
        *out_name = null
        *out_len = 0
        return 0
    levels

# AGAST #3199: S when the index `ie` (`a[i]`) yields a `*S` -- `a: [N]*S`,
# whose `*(a[i] + j)` deref_pointee_struct_name names -- else null.  Only a
# struct find_struct lists: its trusted names include enums.
pub fn index_elem_ptr_struct(s: *EmitterState, ie: *Expr) -> *StructDef
    var name: *u8 = null
    var name_len: i32 = 0
    deref_pointee_struct_name(s, ie, @name, @name_len)
    if name_len <= 0
        return null
    find_struct(s, StrView { ptr: (name), len: (name_len) as i64 })

# AGAST #3234: S when the field chain `m` (`v.a`, `x.y.a`) is an inline `[N]S`
# array field, else null.  Type-only: nothing is emitted.
pub fn field_struct_array_elem(s: *EmitterState, m: *Expr) -> *StructDef
    let f: *StructField = resolve_member_chain_field(s, m)
    if f == null or f.field_type != TypeKind.Array or f.array_elem_type != TypeKind.Struct or f.array_shape != null
        return null
    if f.array_elem_type_name_len <= 0
        return null
    find_struct(s, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })

# Is `p` a `Span<T>` parameter (`Span$...`)?
pub fn is_span_param(p: *Param) -> i32
    if p.param_type != TypeKind.Struct or p.param_type_name == null or p.param_type_name_len <= 4
        return 0
    if *(p.param_type_name + 0) == 'S' and *(p.param_type_name + 1) == 'p' and *(p.param_type_name + 2) == 'a' and *(p.param_type_name + 3) == 'n' and *(p.param_type_name + 4) == '$'
        return 1
    0

# AGAST #4294 (R36's revisit): the impl target a receiver names when it is a
# primitive or a `*u8` — `i64`, `bool`, `ptr_u8`.  Null for anything else.  A
# declared type keeps its name (the arms above resolve those).  ritz1's value
# model puts a `*u8` in a slot as an i64, so only the declared pointee says.
pub fn builtin_receiver_name(s: *EmitterState, recv: *Expr, out_len: *i32) -> *u8
    if recv == null or recv.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (recv.ident_ptr), len: (recv.ident_len) as i64 })
    if loc == null or lv_type_name_len(loc) > 0
        return null
    var name: *u8 = null
    if loc.is_bool == 1
        # A bool local's slot is an i64 (var_type TypeKind.I64); is_bool remembers
        # the declared type (AGAST #1521).
        name = c"bool"
    else
        match lv_var_type(loc)
            TypeKind.Ref | TypeKind.MutRef =>
                if lv_pointee_type(loc) == TypeKind.Ptr and lv_inner_pointee_type(loc) == (TypeKind.U8 as i32)
                    name = c"ptr_u8"
                else
                    name = primitive_name_from_type(lv_pointee_type(loc))
            TypeKind.Ptr =>
                if lv_pointee_type(loc) == TypeKind.U8
                    name = c"ptr_u8"
            _ =>
                name = primitive_name_from_type(lv_var_type(loc))
    if name == null
        return null
    if name_eq(StrView { ptr: (name), len: (2) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (2) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
        *out_len = 2
    else
        *out_len = strlen(name) as i32
    name

# A `"..."`, or a literal local (both %Span$u8, #98, #2103), into a method's
# `StrView` param `p`: rebuilt as a %StrView, as the free-call and UFCS arms
# do (emit_strview_from_lit).  Shared by the instance and static arms, which
# passed the %Span$u8 register under %StrView (AGAST #3495: `impl String`'s
# `String.from("x")`, `s.push_str("x")`).  -1 when nothing is rebuilt.
pub fn method_strview_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    if name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 0
        return -1
    return emit_strview_from_lit(s, arg, reg)

# Arg narrow — the `trunc i64 ... to iN` suffix a method call's integer or
# bool arg needs to match its param `p`, or null when the i64 register passes
# as is (a wide or non-integer param; every bool value is an i64 register,
# AGAST #1646 / #3001).  Shared by the instance (AGAST #1607) and static
# (`T.m(...)`, AGAST #1733) method arms.
pub fn method_arg_narrow_suffix(s: *EmitterState, p: *Param, arg: *Expr) -> *u8
    if ty_int_bits(p.param_type) == 8
        return c" to i8\n"
    if ty_int_bits(p.param_type) == 16
        return c" to i16\n"
    if ty_int_bits(p.param_type) == 32
        return c" to i32\n"
    if p.param_type == TypeKind.Bool
        return c" to i1\n"
    return null

# Float arg — coerce a method call's arg register `reg` to its `f32` / `f64`
# param `p`: fptrunc a double (a float literal is always one), fpext a float,
# sitofp an integer (an i64 register), as the free-call cascade does.  Returns
# `reg` for a non-float param or an arg already at the param's width.  Shared
# by the instance and static method arms (AGAST #2561): the instance arm had
# no float arm, so `a.lerp(b, 0.25)` passed `float %<double>`.
pub fn method_float_arg(s: *EmitterState, p: *Param, arg: *Expr, reg: i32) -> i32
    if p.param_type != TypeKind.F32 and p.param_type != TypeKind.F64
        return reg
    var src_ty: TypeKind = TypeKind.I64
    if arg != null
        src_ty = float_arg_src_type(s, arg, p.param_type)
    if src_ty != TypeKind.F32 and src_ty != TypeKind.F64
        return emit_int_into_float_slot(s, reg, float_slot_unsigned(arg), p.param_type)
    emit_float_coerce(s, reg, src_ty, p.param_type)

# The type of argument `arg`'s register for a float param of type `pft`.  An
# if / match there merged at `pft` (emit_call_arg's hint, LARB R43), while
# get_expr_type falls back to i64 for it: a phi double was sitofp'd again.
pub fn float_arg_src_type(s: *EmitterState, arg: *Expr, pft: TypeKind) -> TypeKind
    if pft != TypeKind.Void and (arg.kind == ExprKind.If or arg.kind == ExprKind.Match)
        return pft
    expr_slot_ty(arg)

# TypeKind.F32 / TypeKind.F64 when param `p` is a float: declared so, or a generic
# `T` monomorph substituted with f32 / f64 and left TypeKind.Struct.  Else 0.
pub fn param_float_type(p: *Param) -> TypeKind
    if p.param_type == TypeKind.F32 or p.param_type == TypeKind.F64
        return p.param_type
    if p.param_type != TypeKind.Struct
        return TypeKind.Void
    if name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"f32"), len: (3) as i64 }) == 1
        return TypeKind.F32
    if name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (c"f64"), len: (3) as i64 }) == 1
        return TypeKind.F64
    TypeKind.Void

# Emit `%t = trunc i64 <reg><suffix>` and return %t.  One format_into
# rather than five emit_str / emit_reg calls (AGAST #1824).
pub fn emit_method_arg_trunc(s: *EmitterState, reg: i32, suffix: *u8) -> i32
    let t: i32 = next_reg(s)
    format_into(s.out, "  %.{t} = trunc i64 %.{reg}{suffix}")
    return t

# Return narrow — extend a method call's bool/i8/i16/i32 (and unsigned)
# result back to i64 so consumers see the i64 value-model register.  Shared
# by the instance and static (`T.m(...)`, AGAST #1962) method arms; any other
# return type passes through unchanged.
pub fn widen_method_result(s: *EmitterState, result: i32, rtype: TypeKind) -> i32
    var nw_op: *u8 = null
    match rtype
        TypeKind.Bool =>
            nw_op = c" = zext i1 "
        TypeKind.I32 =>
            nw_op = c" = sext i32 "
        TypeKind.U32 =>
            nw_op = c" = zext i32 "
        TypeKind.I16 =>
            nw_op = c" = sext i16 "
        TypeKind.U16 =>
            nw_op = c" = zext i16 "
        TypeKind.I8 =>
            nw_op = c" = sext i8 "
        TypeKind.U8 =>
            nw_op = c" = zext i8 "
        _ => pass
    if nw_op != null
        let ext: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, ext)
        emit_str(s, nw_op)
        emit_reg(s, result)
        emit_str(s, IR_TO_I64)
        return ext

    return result



# =============================================================================
# From emitter_expr.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# `base` loaded `levels` times.
pub fn emit_load_levels(s: *EmitterState, base: i32, levels: i32) -> i32
    var reg: i32 = base
    for i in 0..levels
        reg = emit_load_ptr(s, reg)
    reg


# =============================================================================
# From emitter_expr_access.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# AGAST #3054: an array Sema refused in a pointer slot's own words never gets
# here (ref_value.ritz): any Sema error stops the compile before emission.
pub fn emit_whole_array_error(s: *EmitterState, e: *Expr)
    emit_nd_error(s, e.span.line, e.span.col, c"a whole array is not a value here (index it, copy it into an array of the same type, or take its address with @)")


# =============================================================================
# From emitter_stmt.ritz (AGAST #1818): pure helpers the above needs.
# =============================================================================
# AGAST #2343: an array store takes the same element type, by kind: `[N]u32` is
# not `[N]i32`.  ref_into has said so already for whatever it can name.
pub fn array_store_fits(s: *EmitterState, value: *Expr, a: TypeKind, a_name_sv: StrView, b: TypeKind, b_name_sv: StrView) -> i32
    var a_name: *u8 = a_name_sv.ptr
    var a_len: i32 = a_name_sv.len as i32
    var b_name: *u8 = b_name_sv.ptr
    var b_len: i32 = b_name_sv.len as i32
    if a == b and array_elem_types_match(a, StrView { ptr: (a_name), len: (a_len) as i64 }, b, StrView { ptr: (b_name), len: (b_len) as i64 }) == 1
        return 1
    ref_array_error(s, value)
    0

# AGAST #2287: the shape of a whole array an expression reads.
struct ArraySrc
    size: i32
    elem: TypeKind
    name: *u8
    name_len: i32

pub fn array_src_set(out: *ArraySrc, size: i32, elem: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.size = size
    out.elem = elem
    out.name = name
    out.name_len = name_len
    1

# The `p: *[N]T` / `@[N]T` / `@&[N]T` local `e` names, or null.  `a:& [N]T` counts:
# as in ritz0, `*a` reads the array.
pub fn array_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_pointee_type(loc) != TypeKind.Array or lv_pointee_array_size(loc) <= 0
        return null
    if lent_array_ident(s, e) != null
        return loc
    return array_ptr_index_base(s, e)

# AGAST #2304: fill `out` with N and T when `*e` is a whole `[N]T` place: `e` an
# array_ptr_local, a `*[N]T` field or global that records them (base_ptr_array),
# or `x + k` / `x - k` over a `*[N]T` one, which steps whole rows (#2330).  N
# and T are the pointer's own, never the value's: with no N there is no
# length to check a store against.  Emits nothing.
pub fn array_ptr_shape(s: *EmitterState, e: *Expr, out: *ArraySrc) -> i32
    if e == null
        return 0
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        var en_len: i32 = 0
        let en: *u8 = array_ptr_elem_name(loc, @en_len)   # #2548
        return array_src_set(out, lv_pointee_array_size(loc), lv_pointee_array_elem_type(loc), StrView { ptr: (en), len: (en_len) as i64 })
    if e.kind == ExprKind.Binary
        if e.op != OpKind.Add and e.op != OpKind.Sub
            return 0
        if array_ptr_steps(s, e.left) == 0 or is_ptr_distance(s, e) == 1
            return 0
        return array_ptr_shape(s, e.left, out)
    let pa: *Param = base_ptr_array(s, e)
    if pa == null
        return 0
    array_src_set(out, pa.param_pointee_array_size, pa.param_pointee_array_elem_type, StrView { ptr: (pa.param_type_name), len: (pa.param_type_name_len) as i64 })

# 1 when `x + k` on `e` steps rows of a `*[N]T`: `e` is a `*[N]T` local or param,
# field or global, or such a step itself.  `@[N]T` and `a:& [N]T` aren't.
fn array_ptr_steps(s: *EmitterState, e: *Expr) -> i32
    if e.kind == ExprKind.Binary
        if (e.op == OpKind.Add or e.op == OpKind.Sub) and is_ptr_distance(s, e) == 0
            return array_ptr_steps(s, e.left)
        return 0
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        if lv_var_type(loc) == TypeKind.Ptr
            return 1
        return 0
    if base_ptr_array_row_size(s, e) > 0
        return 1
    0

# Fill `out` when `value` reads a whole 1-D array out of a place that needs no
# code to find: a local or by-value param, `a:& [N]T`, a global, `*p`.  Returns
# 0 for anything else.  Emits nothing, so a check can ask before emitting.
pub fn array_place_shape(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
        if loc != null
            if lv_var_type(loc) == TypeKind.Array and lv_array_shape(loc) == null
                return array_src_set(out, lv_array_size(loc), lv_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            return 0
        let g: *GlobalVarDef = find_global(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
        if g != null and g.var_type == TypeKind.Array and g.array_shape == null
            return array_src_set(out, g.array_size, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        return 0
    if value.kind == ExprKind.Unary and value.op == OpKind.Deref
        # AGAST #2305: `*@a` / `*@&a` reads the array `a` is, as ritz0 has it.
        let inner: *Expr = addr_of_array_place(s, value.operand)
        if inner != null
            return array_place_shape(s, inner, out)
        return array_ptr_shape(s, value.operand, out)   # AGAST #2304
    0

# AGAST #2305: `x` when `e` is `@x` or `@&x` over a whole 1-D array place, so
# `*e` is that place; null otherwise.  Emits nothing.
pub fn addr_of_array_place(s: *EmitterState, e: *Expr) -> *Expr
    if e == null or e.kind != ExprKind.Unary or (e.op != OpKind.Addr and e.op != OpKind.AddrMut)
        return null
    let x: *Expr = e.operand
    if x == null or (x.kind != ExprKind.Ident and x.kind != ExprKind.Unary)
        return null
    var sh: ArraySrc
    if array_place_shape(s, x, @sh) == 0
        return null
    x

# Copy a whole local `[N x T]` from `src_ptr` over `dst_ptr` as one aggregate
# load + store: every element is read before any is written.
pub fn emit_local_array_copy(s: *EmitterState, size: i32, et: TypeKind, name_sv: StrView, src_ptr: i32, dst_ptr: i32)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    # AGAST #2306: an array of at least SRET_MIN_BYTES is copied pointer-to-
    # pointer, as #1732 copies a large struct: clang -O2 splits a first-class
    # `[N x T]` load/store into one scalar per element and hangs at 64 KB.
    # The two arrays are distinct or the same, never partially overlapping.
    var align: i64 = 8
    if elem_size_align(s, et, StrView { ptr: (name), len: (name_len) as i64 }, @align) * (size as i64) >= SRET_MIN_BYTES
        emit_str(s, c"  call void @__ritz_sret_copy(ptr ")
        emit_reg(s, dst_ptr)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, src_ptr)
        emit_str(s, c", i64 ptrtoint (ptr getelementptr (")
        emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
        emit_str(s, c", ptr null, i32 1) to i64))\n")
        s.sret_helpers_used = 1
        return
    let agg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, agg)
    emit_str(s, IR_LOAD)
    emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, agg)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst_ptr)
    emit_str(s, IR_NL)
