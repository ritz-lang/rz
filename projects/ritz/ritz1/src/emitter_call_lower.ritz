import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import diag           # diag_error_at (AGAST #3621)
import binder_check   # binder_call_refuse (AGAST #2407)
import float_slot     # float_slot_unsigned (AGAST #2945, #4376)
import interp_text  # interp_lit_has_placeholder (AGAST #4381)
import narrowing
import monomorph     # array_arg_decode (AGAST #3029)
import ownership     # own_temp_slot_of (AGAST #2262)
import ritzlib.memory
import ref_check
import ritzlib.io
import ritzlib.str
import ritzlib.string
import ritzlib.cstr
import ritzlib.strview    # strview_starts_with (was the local starts_with)
import ritzlib.sys
