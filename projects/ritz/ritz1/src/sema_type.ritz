# ritz1/src/sema_type.ritz - Sema's expression typer (AGAST #3501, #1816)
#
# sema_expr_ty types an expression from the AST and Sema's typed scope
# alone, for the checks moving off the emitter (#3502-#3514), which today
# read get_expr_type / LocalVar mid-lowering.  It answers TYPE_UNKNOWN
# rather than guess: a check treats that as bool_check treats BK_UNSURE.
#
# It covers the shapes bool_check needs first: literals, identifiers (locals,
# then globals, then consts), calls (through a local's fn signature, else
# sema_call_fn), comparisons and logical operators, `not` / `-` / `@`, casts,
# member access on a struct or a pointer to one, arithmetic whose operands
# agree, and a struct literal (for bool_check, #3502).  And a receiver's
# shapes, which deref_field typed on its own until AGAST #3810: `*p` of a
# pointer to a struct, a struct element `a[i]` (sema_elem_ty), a method call's
# result and `E.V(..)`.  (A deref step's `S_deref(..)` is a call like any
# other, found by its symbol.)  Anything else is
# TYPE_UNKNOWN until a check move needs it.
#
# sema_walk binds what it can type with these: sema_elem_ty a `for x in a`
# variable, sema_arm_payload_ty a `V(x)` arm binding, sema_tuple_field_ty a
# `let (a, b)` binding.
#
# A bool is TYPE_BOOL here, where the emitter's LocalVar and get_expr_type say
# TYPE_I64 (its bool slot, #1646).  sema_probe.ritz pins the answers against
# get_expr_type and bool_kind on every expression the emitter lowers
# (RITZ1_SEMA_PROBE=1; ritz0/test_ritz1_sema_type.py).

import ritzlib.sys

import ast
import ast_helpers
import emitter_core
import sema

fn sema_ty_set(t: *SemaTy, kind: i32, name: *u8, name_len: i32, pointee: i32, fn_sig: *FnDef) -> i32
    t.kind = kind
    t.name = name
    t.name_len = name_len
    t.pointee = pointee
    t.fn_sig = fn_sig
    kind

fn sema_ty_copy(dst: *SemaTy, src: *SemaTy) -> i32
    sema_ty_set(dst, src.kind, src.name, src.name_len, src.pointee, src.fn_sig)

fn sema_ty_none(t: *SemaTy) -> i32
    sema_ty_unknown(t)
    TYPE_UNKNOWN

# 1 for a fixed-width integer kind.
pub fn sema_is_int_kind(k: i32) -> i32
    (k == TYPE_I8 or k == TYPE_I16 or k == TYPE_I32 or k == TYPE_I64 or k == TYPE_U8 or k == TYPE_U16 or k == TYPE_U32 or k == TYPE_U64) as i32

fn sema_is_int_lit(e: *Expr) -> i32
    (e.kind == EXPR_INT_LIT and e.lit_kind == LIT_PLAIN) as i32

# The type of the name `name`: a local, a global or a typed const (AGAST #3755
# reads it for `n[i] = v`, whose target is a name, not an Expr).
pub fn sema_name_ty(sm: *Sema, name: *u8, len: i32, t: *SemaTy) -> i32
    let v: *SemaVar = sema_find_local(sm, name, len)
    if v != null
        return sema_ty_set(t, v.kind, v.type_name, v.type_name_len, v.pointee, v.fn_sig)
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(g.name, g.name_len, name, len) == 1
            # `var g: *S` names S as its pointee, not its type (AGAST #1554).
            if g.type_name == null and g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT
                return sema_ty_set(t, g.var_type, g.pointee_type_name, g.pointee_type_name_len, g.pointee_type, null)
            return sema_ty_set(t, g.var_type, g.type_name, g.type_name_len, g.pointee_type, null)
        g = g.next
    # A const's own type, where its value was folded: an untyped `const N = 4`
    # and a float const are left to the emitter's folding.
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(c.name, c.name_len, name, len) == 1
            if sema_is_int_kind(c.const_type) == 1 or c.const_type == TYPE_BOOL
                return sema_ty_set(t, c.const_type, null, 0, TYPE_VOID, null)
            return sema_ty_none(t)
        c = c.next
    sema_ty_none(t)

fn sema_fn_ret_ty(fd: *FnDef, t: *SemaTy) -> i32
    if fd.return_type == TYPE_VOID
        return sema_ty_none(t)
    sema_ty_set(t, fd.return_type, fd.return_type_name, fd.return_type_name_len, TYPE_VOID, fd.ret_fn_sig)

fn sema_call_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.func_name_len == 0
        return sema_ty_none(t)
    # A call through a local is its signature's, never a fn of that name.
    let v: *SemaVar = sema_find_local(sm, e.func_name, e.func_name_len)
    if v != null
        if v.fn_sig != null
            return sema_fn_ret_ty(v.fn_sig, t)
        return sema_ty_none(t)
    if mem_builtin_id(e.func_name, e.func_name_len) != 0
        return sema_ty_none(t)
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd == null
        return sema_ty_none(t)
    sema_fn_ret_ty(fd, t)

fn sema_is_ptr_kind(k: i32) -> i32
    (k == TYPE_PTR or k == TYPE_REF or k == TYPE_MUT_REF) as i32

# The struct a receiver of kind `r` is, or points at.  A fn's `-> @T` keeps no
# pointee kind: its name says it is a struct.
pub fn sema_recv_struct(sm: *Sema, r: *SemaTy) -> *StructDef
    if r.kind == TYPE_STRUCT
        return sema_find_struct(sm, r.name, r.name_len)
    if sema_is_ptr_kind(r.kind) == 1
        if r.pointee == TYPE_STRUCT or r.pointee == TYPE_VOID
            return sema_find_struct(sm, r.name, r.name_len)
    null

fn sema_member_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.left == null
        return sema_ty_none(t)
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @r) == TYPE_UNKNOWN
        # AGAST #3824: `K.f` on `const K: StrView = "..."`, a `%S` global the
        # emitter reads fields out of; `let q = K.ptr + 1` typed nothing.
        # Only the field: a bare `K` stays unknown, as the emitter's
        # get_expr_type has it as i64.
        let ce: *ConstEntry = sema_struct_const(sm, e.left)
        if ce == null
            return sema_ty_none(t)
        sema_ty_set(@r, TYPE_STRUCT, ce.type_name, ce.type_name_len, TYPE_VOID, null)
    sema_field_ty(sm, @r, e.ident_ptr, e.ident_len, t)

# AGAST #3824: the const `id` names, if it is a string-initialised struct
# const (emitter_core's struct_const_global, over Sema's module); else null.
fn sema_struct_const(sm: *Sema, id: *Expr) -> *ConstEntry
    if id == null or id.kind != EXPR_IDENT
        return null
    if sema_find_local(sm, id.ident_ptr, id.ident_len) != null
        return null
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(c.name, c.name_len, id.ident_ptr, id.ident_len) == 1
            if c.const_type == TYPE_STRUCT and c.type_name_len > 0 and c.value_expr != null and c.value_expr.kind == EXPR_STRING_LIT
                return c
            return null
        c = c.next
    null

# The type of field `name` of `r`, a struct or a pointer or reference to one
# (AGAST #3799 reads it for `s.f[i] = v`, whose target is a field name).
pub fn sema_field_ty(sm: *Sema, r: *SemaTy, name: *u8, len: i32, t: *SemaTy) -> i32
    if r.kind == TYPE_UNKNOWN
        return sema_ty_none(t)
    let st: *StructDef = sema_recv_struct(sm, r)
    if st == null
        return sema_ty_none(t)
    let idx: i32 = find_field_index(st, name, len)
    if idx < 0
        return sema_ty_none(t)
    let f: *StructField = get_field_type(st, idx)
    var pointee: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        pointee = f.ptr_pointee
    sema_ty_set(t, f.field_type, f.field_type_name, f.field_type_name_len, pointee, f.fn_sig)

# `a op b` for an arithmetic or bitwise op: the operands' type when they
# agree, an integer literal taking the other side's integer type, f32 with
# f64 the f64, and
# `p + n` / `p - n` a pointer.  Anything else is unknown.
fn sema_arith_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    var l: SemaTy
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @l) == TYPE_UNKNOWN
        return sema_ty_none(t)
    if sema_expr_ty(sm, e.right, @r) == TYPE_UNKNOWN
        return sema_ty_none(t)
    if l.kind == TYPE_PTR and (e.op == OP_ADD or e.op == OP_SUB) and sema_is_int_kind(r.kind) == 1
        return sema_ty_copy(t, @l)
    if sema_is_int_kind(l.kind) == 1 and sema_is_int_lit(e.right) == 1
        return sema_ty_copy(t, @l)
    if (l.kind == TYPE_F32 or l.kind == TYPE_F64) and (r.kind == TYPE_F32 or r.kind == TYPE_F64)
        # A float literal takes the other side's width; an f32 meeting an f64
        # widens to it (LANGUAGE_SPEC §7.1, AGAST #3607), as binop_float_width.
        if is_float_lit_operand(e.right) == 1
            return sema_ty_copy(t, @l)
        if is_float_lit_operand(e.left) == 1
            return sema_ty_copy(t, @r)
        if l.kind != r.kind
            return sema_ty_set(t, TYPE_F64, null, 0, TYPE_VOID, null)
    if l.kind == r.kind and (sema_is_int_kind(l.kind) == 1 or l.kind == TYPE_F32 or l.kind == TYPE_F64)
        return sema_ty_copy(t, @l)
    sema_ty_none(t)

fn sema_unary_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.op == OP_NOT
        return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
    if e.op == OP_NEG
        var o: SemaTy
        let k: i32 = sema_expr_ty(sm, e.operand, @o)
        if sema_is_int_kind(k) == 1 or k == TYPE_F32 or k == TYPE_F64
            return sema_ty_copy(t, @o)
        return sema_ty_none(t)
    if e.op == OP_ADDR or e.op == OP_ADDR_MUT
        # The pointer the emitter makes of it: `@x` a TYPE_PTR, `@&x` a
        # TYPE_MUT_REF, to x's type.
        var kind: i32 = TYPE_PTR
        if e.op == OP_ADDR_MUT
            kind = TYPE_MUT_REF
        var o: SemaTy
        let ok: i32 = sema_expr_ty(sm, e.operand, @o)
        if ok == TYPE_UNKNOWN or ok == TYPE_PTR or ok == TYPE_PTR_PTR or ok == TYPE_REF or ok == TYPE_MUT_REF or ok == TYPE_ARRAY
            return sema_ty_set(t, kind, null, 0, TYPE_VOID, null)
        return sema_ty_set(t, kind, o.name, o.name_len, ok, null)
    if e.op == OP_DEREF
        # `*p` of a pointer or reference to a struct: the struct.
        var o: SemaTy
        sema_expr_ty(sm, e.operand, @o)
        if sema_is_ptr_kind(o.kind) == 1 and sema_recv_struct(sm, @o) != null
            return sema_ty_set(t, TYPE_STRUCT, o.name, o.name_len, TYPE_VOID, null)
    sema_ty_none(t)

# --- A receiver's shapes (AGAST #3810) -------------------------------------

# A struct element of `b` (`b[i]`, or what `for x in b` binds): of a `[N]S`
# local, global or field, of a `*S`, or of a Vec$S (through a `@Vec<S>` /
# `*Vec<S>` too).  Unknown for any other element.
pub fn sema_elem_ty(sm: *Sema, b: *Expr, t: *SemaTy) -> i32
    if b == null
        return sema_ty_none(t)
    if b.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, b.ident_ptr, b.ident_len)
        if v != null and v.kind == TYPE_ARRAY
            if v.elem == TYPE_STRUCT and v.type_name_len > 0
                return sema_ty_set(t, TYPE_STRUCT, v.type_name, v.type_name_len, TYPE_VOID, null)
            if sema_is_ptr_kind(v.elem) == 1 and v.type_name_len > 0
                return sema_ty_set(t, v.elem, v.type_name, v.type_name_len, TYPE_STRUCT, null)
            return sema_ty_none(t)
        if v == null
            var g: *GlobalVarDef = sm.module.globals
            while g != null
                if name_eq(g.name, g.name_len, b.ident_ptr, b.ident_len) == 1
                    if g.var_type == TYPE_ARRAY and g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
                        return sema_ty_set(t, TYPE_STRUCT, g.array_elem_type_name, g.array_elem_type_name_len, TYPE_VOID, null)
                    g = null
                else
                    g = g.next
    if b.kind == EXPR_MEMBER and b.left != null
        var r: SemaTy
        sema_expr_ty(sm, b.left, @r)
        let st: *StructDef = sema_recv_struct(sm, @r)
        if st != null
            let fi: i32 = find_field_index(st, b.ident_ptr, b.ident_len)
            if fi >= 0
                let f: *StructField = get_field_type(st, fi)
                if f.field_type == TYPE_ARRAY
                    if f.array_elem_type == TYPE_STRUCT and f.array_elem_type_name_len > 0
                        return sema_ty_set(t, TYPE_STRUCT, f.array_elem_type_name, f.array_elem_type_name_len, TYPE_VOID, null)
                    return sema_ty_none(t)
    var bt: SemaTy
    sema_expr_ty(sm, b, @bt)
    # A Vec's element is what its `data: *T` points at.
    let held: i32 = (bt.kind == TYPE_STRUCT or (sema_is_ptr_kind(bt.kind) == 1 and bt.pointee == TYPE_STRUCT)) as i32
    if held == 1 and bt.name_len > 4 and name_eq(bt.name, 4, c"Vec$", 4) == 1
        let vst: *StructDef = sema_find_struct(sm, bt.name, bt.name_len)
        if vst != null
            let di: i32 = find_field_index(vst, c"data", 4)
            if di >= 0
                let df: *StructField = get_field_type(vst, di)
                if df.field_type == TYPE_PTR and df.field_type_name_len > 0
                    return sema_ty_set(t, TYPE_STRUCT, df.field_type_name, df.field_type_name_len, TYPE_VOID, null)
        return sema_ty_none(t)
    if sema_is_ptr_kind(bt.kind) == 1 and bt.pointee == TYPE_STRUCT and bt.name_len > 0
        return sema_ty_set(t, TYPE_STRUCT, bt.name, bt.name_len, TYPE_VOID, null)
    sema_ty_none(t)

fn sema_index_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.right != null and e.right.kind == EXPR_RANGE
        return sema_ty_none(t)
    sema_elem_ty(sm, e.left, t)

# `x.m(..)`: the method's result, on a struct or a pointer to one; `E.V(..)`
# builds the enum E.
fn sema_method_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    let el: *Expr = e.left
    if el == null
        return sema_ty_none(t)
    if el.kind == EXPR_IDENT and sema_find_local(sm, el.ident_ptr, el.ident_len) == null and user_enum_index(el.ident_ptr, el.ident_len) >= 0
        return sema_ty_set(t, TYPE_STRUCT, el.ident_ptr, el.ident_len, TYPE_VOID, null)
    var r: SemaTy
    sema_expr_ty(sm, el, @r)
    let st: *StructDef = sema_recv_struct(sm, @r)
    if st == null
        return sema_ty_none(t)
    let fd: *FnDef = sema_method_fn(sm, st.name, st.name_len, e.ident_ptr, e.ident_len)
    if fd == null
        return sema_ty_none(t)
    sema_fn_ret_ty(fd, t)

fn sema_struct_ty(st: *StructDef, t: *SemaTy) -> i32
    if st == null
        return sema_ty_none(t)
    sema_ty_set(t, TYPE_STRUCT, st.name, st.name_len, TYPE_VOID, null)

# The struct named `name`, unless it is a generic's template: a monomorphised
# name (`Span$u8`) never names one, so `Result$Span$u8$i32` splits after `u8`.
fn sema_find_concrete(sm: *Sema, name: *u8, len: i32) -> *StructDef
    let st: *StructDef = sema_find_struct(sm, name, len)
    if st != null and st.type_params != null
        return null
    st

# The struct an `Option$S` carries in Some, or a `Result$S$E` in Ok / Err (its
# shortest `$`-split naming structs on both sides is taken); null otherwise.
fn sema_tagged_payload(sm: *Sema, name: *u8, len: i32, is_err: i32) -> *StructDef
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(name, d, c"Option", 6) == 1
        if is_err == 1
            return null
        return sema_find_concrete(sm, sfx, sfx_len)
    if name_eq(name, d, c"Result", 6) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            let ok: *StructDef = sema_find_concrete(sm, sfx, cut)
            if ok != null or cut + 1 < sfx_len
                if is_err == 0 and ok != null
                    return ok
                if is_err == 1
                    let er: *StructDef = sema_find_concrete(sm, sfx + cut + 1, sfx_len - cut - 1)
                    if er != null
                        return er
        cut += 1
    null

# A match arm's binding `V(x)` on `scrut`: V's payload.  Unknown for a
# catch-all name, as the emitter left it: a `match` on a struct value is
# refused (by ritz0 too), and typing one only lets `.` reach unlowerable IR.
pub fn sema_arm_payload_ty(sm: *Sema, arm: *MatchArm, scrut: *Expr, t: *SemaTy) -> i32
    if scrut == null or arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT
        return sema_ty_none(t)
    var s: SemaTy
    sema_expr_ty(sm, scrut, @s)
    if s.kind == TYPE_UNKNOWN or s.name == null or s.name_len <= 0
        return sema_ty_none(t)
    if is_tagged_enum_type(s.name, s.name_len) == 1
        var is_err: i32 = 0
        if name_eq(arm.pattern_name, arm.pattern_name_len, c"Err", 3) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"None", 4) == 1
            is_err = 1
        return sema_struct_ty(sema_tagged_payload(sm, s.name, s.name_len, is_err), t)
    if user_enum_index(s.name, s.name_len) >= 0
        let uf: *StructField = user_enum_tuple_field(s.name, s.name_len, enum_variant_index(s.name, s.name_len, arm.pattern_name, arm.pattern_name_len))
        if uf != null
            var pointee: i32 = TYPE_VOID
            if uf.field_type == TYPE_PTR
                pointee = uf.ptr_pointee
            return sema_ty_set(t, uf.field_type, uf.field_type_name, uf.field_type_name_len, pointee, uf.fn_sig)
    sema_ty_none(t)

# Field `i` of the tuple struct `tup` (a `let (a, b, ..)`'s initialiser's type).
pub fn sema_tuple_field_ty(sm: *Sema, tup: *SemaTy, i: i32, t: *SemaTy) -> i32
    let st: *StructDef = sema_recv_struct(sm, tup)
    if st == null
        return sema_ty_none(t)
    var f: *StructField = st.fields
    var k: i32 = 0
    while f != null and k < i
        f = f.next
        k += 1
    if f == null
        return sema_ty_none(t)
    var pointee: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        pointee = f.ptr_pointee
    sema_ty_set(t, f.field_type, f.field_type_name, f.field_type_name_len, pointee, f.fn_sig)

# The type of `e` into `t`, returning its kind; TYPE_UNKNOWN when Sema can't
# say.  `e` may be null.
pub fn sema_expr_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e == null
        return sema_ty_none(t)
    let k: i32 = e.kind
    if k == EXPR_INT_LIT
        if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
            return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
        if e.lit_kind == LIT_PLAIN
            return sema_ty_set(t, TYPE_I64, null, 0, TYPE_VOID, null)
        return sema_ty_none(t)
    if k == EXPR_CHAR_LIT
        return sema_ty_set(t, TYPE_U8, null, 0, TYPE_VOID, null)
    if k == EXPR_FLOAT_LIT
        return sema_ty_set(t, TYPE_F64, null, 0, TYPE_VOID, null)
    if k == EXPR_NIL_LIT
        return sema_ty_set(t, TYPE_PTR, null, 0, TYPE_VOID, null)
    if k == EXPR_CSTRING_LIT
        return sema_ty_set(t, TYPE_PTR, null, 0, TYPE_U8, null)
    if k == EXPR_STRING_LIT
        return sema_ty_set(t, TYPE_STRUCT, c"StrView", 7, TYPE_VOID, null)
    if k == EXPR_STRUCT_LIT
        return sema_ty_set(t, TYPE_STRUCT, e.ident_ptr, e.ident_len, TYPE_VOID, null)
    if k == EXPR_IDENT
        return sema_name_ty(sm, e.ident_ptr, e.ident_len, t)
    if k == EXPR_BINARY
        if e.op >= OP_EQ and e.op <= OP_OR
            return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
        return sema_arith_ty(sm, e, t)
    if k == EXPR_UNARY
        return sema_unary_ty(sm, e, t)
    if k == EXPR_CAST
        return sema_ty_set(t, e.op, e.ident_ptr, e.ident_len, e.int_val as i32, e.fn_sig)
    if k == EXPR_CALL
        return sema_call_ty(sm, e, t)
    if k == EXPR_MEMBER
        return sema_member_ty(sm, e, t)
    if k == EXPR_INDEX
        return sema_index_ty(sm, e, t)
    if k == EXPR_METHOD
        return sema_method_ty(sm, e, t)
    sema_ty_none(t)

# The kind of `e`: a TYPE_*, or TYPE_UNKNOWN.
pub fn sema_expr_type(sm: *Sema, e: *Expr) -> i32
    var t: SemaTy
    sema_expr_ty(sm, e, @t)
