# ritz1/src/sema_type.ritz - Sema's expression typer (AGAST #3501, #1816)
#
# sema_expr_ty types an expression from the AST and Sema's typed scope
# alone, for the checks moving off the emitter (#3502-#3514), which today
# read get_expr_type / LocalVar mid-lowering.  It answers TypeKind.Unknown
# rather than guess: a check treats that as bool_check treats BK_UNSURE.
#
# It covers the shapes bool_check needs first: literals, identifiers (locals,
# then globals, then consts), calls (through a local's fn signature, else
# sema_call_fn), comparisons and logical operators, `not` / `-` / `@`, casts,
# member access on a struct or a pointer to one, arithmetic whose operands
# agree, a struct literal (for bool_check, #3502), and an if / match
# expression whose arm the walk typed as a struct (#3042).  And a receiver's
# shapes, which deref_field typed on its own until AGAST #3810: `*p` of a
# pointer to a struct, an element `a[i]` (sema_elem_ty, Sema's one element
# typer: a struct, a scalar, a pointer, or an N-D array's row, #3943 / #4259),
# a method call's result, `E.V(..)` and a `c?`'s Ok / Some struct (#3974).  (A deref step's
# `S_deref(..)` is a call like any other, found by its symbol.)  And what the
# move check typed on its own until AGAST #4251: a unit variant `E.V`, `*p` of
# a pointer to a user enum, `T.f(..)` of a static method, a nameless tuple
# literal (Sema's own `(tuple)N` struct, sema_tuple_ty) and `Some(x)`'s payload
# as a scrutinee (sema_ctor_payload_ty).  Anything else is TypeKind.Unknown until
# a check move needs it.
#
# sema_walk binds what it can type with these: sema_elem_ty a `for x in a`
# variable, sema_arm_payload_ty a `V(x)` arm binding, sema_tuple_field_ty a
# `let (a, b)` binding.
#
# A bool is TypeKind.Bool here, where the emitter's LocalVar and get_expr_type say
# TypeKind.I64 (its bool slot, #1646).  sema_probe.ritz pins the answers against
# get_expr_type and bool_kind on every expression the emitter lowers
# (RITZ1_SEMA_PROBE=1; ritz0/test_ritz1_sema_type.py).

import ritzlib.sys
import ritzlib.str
import ritzlib.hashmap
import ritzlib.memory

import ast
import types
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema

fn sema_ty_set(t: *SemaTy, kind: TypeKind, name_sv: StrView, pointee: TypeKind, fn_sig: *FnDef) -> TypeKind
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    t.kind = kind
    t.name = name
    t.name_len = name_len
    t.pointee = pointee
    t.fn_sig = fn_sig
    t.shape = null
    kind

fn sema_ty_copy(dst: *SemaTy, src: *SemaTy) -> TypeKind
    sema_ty_set(dst, src.kind, StrView { ptr: (src.name), len: (src.name_len) as i64 }, src.pointee, src.fn_sig)
    dst.shape = src.shape
    dst.kind

fn sema_ty_none(t: *SemaTy) -> TypeKind
    sema_ty_unknown(t)
    TypeKind.Unknown

# 1 for a fixed-width integer kind.
pub fn sema_is_int_kind(k: TypeKind) -> i32
    (ty_is_int(k) == 1) as i32

fn sema_is_int_lit(e: *Expr) -> i32
    (e.kind == ExprKind.IntLit and e.lit_kind == LIT_PLAIN) as i32

# The type of the name `name`: a local, a global or a typed const (AGAST #3755
# reads it for `n[i] = v`, whose target is a name, not an Expr).
pub fn sema_name_ty(sm: *Sema, name_sv: StrView, t: *SemaTy) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v != null
        if v.kind == TypeKind.Array
            sema_arr_ty(t, v.index_elem, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, v.shape)
            t.fn_sig = v.fn_sig
            return TypeKind.Array
        return sema_ty_set(t, v.kind, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, v.pointee, v.fn_sig)
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            if g.var_type == TypeKind.Array
                sema_arr_ty(t, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 }, g.array_shape)
                t.fn_sig = g.fn_sig   # AGAST #4324: `var g: [N]fn(..) -> T`
                return TypeKind.Array
            # `var g: *S` names S as its pointee, not its type (AGAST #1554).
            if g.type_name == null and g.var_type == TypeKind.Ptr and g.pointee_type == TypeKind.Struct
                return sema_ty_set(t, g.var_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 }, g.pointee_type, g.fn_sig)
            return sema_ty_set(t, g.var_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 }, g.pointee_type, g.fn_sig)
        g = g.next
    # A const's own type, where its value was folded: an untyped `const N = 4`
    # and a float const are left to the emitter's folding.
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            # AGAST #4403: a `const KS: [N]T` is an array of T, so `KS[i]`
            # is T (sema_arr_elem).  The parser records T on the entry.
            if c.const_type == TypeKind.Array
                return sema_arr_ty(t, c.array_elem_type, StrView { ptr: (c.array_elem_type_name), len: (c.array_elem_type_name_len) as i64 }, null)
            if sema_is_int_kind(c.const_type) == 1 or c.const_type == TypeKind.Bool
                return sema_ty_set(t, c.const_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
            return sema_ty_none(t)
        c = c.next
    sema_ty_none(t)

fn sema_fn_ret_ty(fd: *FnDef, t: *SemaTy) -> TypeKind
    if fd.return_type == TypeKind.Void
        return sema_ty_none(t)
    # AGAST #4410: a `-> *T` / `-> @T` return names its pointee.  Without it
    # `f()[i]` and `*f()` could not be typed (the emitter's call-result view
    # reads the pointee).
    var pointee: TypeKind = TypeKind.Void
    if fd.return_type == TypeKind.Ptr or fd.return_type == TypeKind.Ref or fd.return_type == TypeKind.MutRef
        pointee = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
        if pointee == TypeKind.Void and fd.return_type_name_len > 0
            pointee = TypeKind.Struct
    sema_ty_set(t, fd.return_type, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }, pointee, fd.ret_fn_sig)

fn sema_call_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    if e.func_name_len == 0
        return sema_ty_none(t)
    # AGAST #3995: a user-enum variant ctor `One(3)` builds its enum, ahead
    # of a local or fn of that name (emit_expr_call's order).
    var en: *u8 = null
    var en_len: i32 = 0
    user_enum_ctor_call(e, @en, @en_len)
    if en != null
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (en), len: (en_len) as i64 }, TypeKind.Void, null)
    # A call through a local is its signature's, never a fn of that name.
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if v != null
        if v.fn_sig != null
            return sema_fn_ret_ty(v.fn_sig, t)
        return sema_ty_none(t)
    if mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) != 0
        return sema_ty_none(t)
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd == null
        return sema_ty_none(t)
    sema_fn_ret_ty(fd, t)

fn sema_is_ptr_kind(k: TypeKind) -> i32
    (k == TypeKind.Ptr or k == TypeKind.Ref or k == TypeKind.MutRef) as i32

# `x`, when it names a (non-generic) user enum and no local; else null.
pub fn sema_enum_name(sm: *Sema, x: *Expr) -> *Expr
    if x == null or x.kind != ExprKind.Ident or sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) != null
        return null
    if user_enum_index(StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) < 0
        return null
    x

# The struct a receiver of kind `r` is, or points at.  A fn's `-> @T` keeps no
# pointee kind: its name says it is a struct.
pub fn sema_recv_struct(sm: *Sema, r: *SemaTy) -> *StructDef
    if r.kind == TypeKind.Struct
        # A nameless tuple's (AGAST #4251): `p.0`, `let (a, b) = p`.
        let tup: *StructDef = sema_tuple_struct(StrView { ptr: (r.name), len: (r.name_len) as i64 })
        if tup != null
            return tup
        return sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    if sema_is_ptr_kind(r.kind) == 1
        if r.pointee == TypeKind.Struct or r.pointee == TypeKind.Void
            return sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    null

fn sema_member_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    if e.left == null
        return sema_ty_none(t)
    # AGAST #4251: `E.V`, a user enum's unit variant, builds the enum E.
    let en: *Expr = sema_enum_name(sm, e.left)
    if en != null and enum_variant_index(StrView { ptr: (en.ident_ptr), len: (en.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (en.ident_ptr), len: (en.ident_len) as i64 }, TypeKind.Void, null)
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @r) == TypeKind.Unknown
        # AGAST #3824: `K.f` on `const K: StrView = "..."`, a `%S` global the
        # emitter reads fields out of; `let q = K.ptr + 1` typed nothing.
        # Only the field: a bare `K` stays unknown, as the emitter's
        # get_expr_type has it as i64.
        let ce: *ConstEntry = sema_struct_const(sm, e.left)
        if ce == null
            return sema_ty_none(t)
        sema_ty_set(@r, TypeKind.Struct, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 }, TypeKind.Void, null)
    sema_field_ty(sm, @r, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, t)

# AGAST #3824: the const `id` names, if it is a string-initialised struct
# const (emitter_core's struct_const_global, over Sema's module); else null.
fn sema_struct_const(sm: *Sema, id: *Expr) -> *ConstEntry
    if id == null or id.kind != ExprKind.Ident
        return null
    if sema_find_local(sm, StrView { ptr: (id.ident_ptr), len: (id.ident_len) as i64 }) != null
        return null
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, StrView { ptr: (id.ident_ptr), len: (id.ident_len) as i64 }) == 1
            if c.const_type == TypeKind.Struct and c.type_name_len > 0 and c.value_expr != null and c.value_expr.kind == ExprKind.StringLit
                return c
            return null
        c = c.next
    null

# The type of field `name` of `r`, a struct or a pointer or reference to one
# (AGAST #3799 reads it for `s.f[i] = v`, whose target is a field name).
pub fn sema_field_ty(sm: *Sema, r: *SemaTy, name_sv: StrView, t: *SemaTy) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if r.kind == TypeKind.Unknown
        return sema_ty_none(t)
    let st: *StructDef = sema_recv_struct(sm, r)
    if st == null
        return sema_ty_none(t)
    let idx: i32 = find_field_index(st, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return sema_ty_none(t)
    let f: *StructField = get_field_type(st, idx)
    if f.field_type == TypeKind.Array
        return sema_arr_ty(t, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, f.array_shape)
    var pointee: TypeKind = TypeKind.Void
    if f.field_type == TypeKind.Ptr
        pointee = f.ptr_pointee
    sema_ty_set(t, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, pointee, f.fn_sig)

# `a op b` for an arithmetic or bitwise op: the operands' type when they
# agree, an integer literal taking the other side's integer type, f32 with
# f64 the f64, and
# `p + n` / `p - n` a pointer.  Anything else is unknown.
fn sema_arith_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    var l: SemaTy
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @l) == TypeKind.Unknown
        return sema_ty_none(t)
    if sema_expr_ty(sm, e.right, @r) == TypeKind.Unknown
        return sema_ty_none(t)
    if l.kind == TypeKind.Ptr and (e.op == OpKind.Add or e.op == OpKind.Sub) and sema_is_int_kind(r.kind) == 1
        return sema_ty_copy(t, @l)
    if sema_is_int_kind(l.kind) == 1 and sema_is_int_lit(e.right) == 1
        return sema_ty_copy(t, @l)
    if (l.kind == TypeKind.F32 or l.kind == TypeKind.F64) and (r.kind == TypeKind.F32 or r.kind == TypeKind.F64)
        # A float literal takes the other side's width; an f32 meeting an f64
        # widens to it (LANGUAGE_SPEC §7.1, AGAST #3607), as binop_float_width.
        if is_float_lit_operand(e.right) == 1
            return sema_ty_copy(t, @l)
        if is_float_lit_operand(e.left) == 1
            return sema_ty_copy(t, @r)
        if l.kind != r.kind
            return sema_ty_set(t, TypeKind.F64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    if l.kind == r.kind and (sema_is_int_kind(l.kind) == 1 or l.kind == TypeKind.F32 or l.kind == TypeKind.F64)
        return sema_ty_copy(t, @l)
    sema_ty_none(t)

fn sema_unary_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    match e.op
        OpKind.Not =>
            return sema_ty_set(t, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
        OpKind.Neg =>
            var o: SemaTy
            let k: TypeKind = sema_expr_ty(sm, e.operand, @o)
            if sema_is_int_kind(k) == 1 or k == TypeKind.F32 or k == TypeKind.F64
                return sema_ty_copy(t, @o)
            return sema_ty_none(t)
        OpKind.Addr | OpKind.AddrMut =>
            # The pointer the emitter makes of it: `@x` a TypeKind.Ptr, `@&x` a
            # TypeKind.MutRef, to x's type.
            var kind: TypeKind = TypeKind.Ptr
            if e.op == OpKind.AddrMut
                kind = TypeKind.MutRef
            var o: SemaTy
            let ok: TypeKind = sema_expr_ty(sm, e.operand, @o)
            if ok == TypeKind.Unknown or ok == TypeKind.Ptr or ok == TypeKind.PtrPtr or ok == TypeKind.Ref or ok == TypeKind.MutRef or ok == TypeKind.Array
                # AGAST #4410: `@c` of a scalar `:& T` borrow param is a `*T`; the
                # param itself is bound unknown (it reads as `*c`), but its
                # pointee is T.  The emitter records T as the pointer's pointee.
                var bet: TypeKind = TypeKind.Void
                if ok == TypeKind.Unknown and e.operand != null and e.operand.kind == ExprKind.Ident
                    let bv: *SemaVar = sema_find_local(sm, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
                    if bv != null and bv.lent != null
                        bet = bv.lent.param_pointee_type
                return sema_ty_set(t, kind, StrView { ptr: (null), len: (0) as i64 }, bet, null)
            return sema_ty_set(t, kind, StrView { ptr: (o.name), len: (o.name_len) as i64 }, ok, null)
        _ => pass
    if e.op == OpKind.Deref
        # `*p` of a pointer or reference to a struct: the struct.
        var o: SemaTy
        sema_expr_ty(sm, e.operand, @o)
        if sema_is_ptr_kind(o.kind) == 1 and sema_recv_struct(sm, @o) != null
            return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (o.name), len: (o.name_len) as i64 }, TypeKind.Void, null)
        # AGAST #4251: or to a user enum (`match *p` of a `p: *E`).
        if sema_is_ptr_kind(o.kind) == 1 and (o.pointee == TypeKind.Struct or o.pointee == TypeKind.Void) and user_enum_index(StrView { ptr: (o.name), len: (o.name_len) as i64 }) >= 0
            return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (o.name), len: (o.name_len) as i64 }, TypeKind.Void, null)
    sema_ty_none(t)

# --- One element typer: what `x[i]` is (AGAST #3810, #3943, #4259) ----------
#
# `x[i]`, and what `for x in b` binds, is typed here and nowhere else on Sema:
# sema_expr_ty, ref_check's rs_ty (whose steps read sema_arr_elem), the slot
# rules' sema_named_elem / sema_index_slot and let_check's let_through_elem
# (sema_buffer_ty) all take their element from it.
#
# An array is typed by its element: kind TypeKind.Array, pointee the element's
# kind (the leaf T of an N-D `[N][M]..T`), name the leaf's struct, shape its N-D
# shape (null for one dimension).  An N-D array's `x[i]` is a row, one
# dimension fewer (#2555), and only the full-rank `x[i][j]..` is its leaf T.

# `t`, an array of `elem` (its struct `name`), of N-D `shape` or null.  An N-D
# array's element is its leaf (a parsed `[N][M]T` says TypeKind.Array there).
pub fn sema_arr_ty(t: *SemaTy, elem: TypeKind, name_sv: StrView, shape: *ArrayShape) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if shape != null and shape.rank >= 2
        sema_ty_set(t, TypeKind.Array, StrView { ptr: (shape.leaf_name), len: (shape.leaf_name_len) as i64 }, shape.leaf_type, null)
        t.shape = shape
        return TypeKind.Array
    sema_ty_set(t, TypeKind.Array, StrView { ptr: (name), len: (len) as i64 }, elem, null)

# `a[i]` of the array `a`, typed as above: a row of an N-D array, else its
# element (a struct, a scalar, or a pointer, to the struct its name says).
# Unknown when the element isn't known.
pub fn sema_arr_elem(a: *SemaTy, t: *SemaTy) -> TypeKind
    let sh: *ArrayShape = a.shape
    if sh != null and sh.rank >= 2
        var row: *ArrayShape = null
        if sh.rank > 2
            row = nd_shape_from(sh, 1)
        return sema_arr_ty(t, sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, row)
    let k: TypeKind = a.pointee
    match k
        TypeKind.Void | TypeKind.Unknown | TypeKind.PtrPtr =>
            return sema_ty_none(t)
        TypeKind.Array =>
            # A row Sema has no shape for: an array, of what it can't say.
            return sema_ty_set(t, TypeKind.Array, StrView { ptr: (a.name), len: (a.name_len) as i64 }, TypeKind.Void, null)
        _ => pass
    if sema_is_ptr_kind(k) == 1 and a.name_len > 0
        return sema_ty_set(t, k, StrView { ptr: (a.name), len: (a.name_len) as i64 }, TypeKind.Struct, null)
    sema_ty_set(t, k, StrView { ptr: (a.name), len: (a.name_len) as i64 }, TypeKind.Void, null)

# The element of a Vec, Span or String, or of what a pointer or reference to
# one points at, `bt`: its kind (a String's bytes are u8, a Vec's or Span's
# what its `data` / `ptr` field points at) and struct name.  Unknown for
# anything else.  through_named_elem's sees_through / indexes_itself.
pub fn sema_buffer_ty(sm: *Sema, bt: *SemaTy, t: *SemaTy) -> TypeKind
    let kind: TypeKind = bt.kind
    if kind != TypeKind.Struct and (sema_is_ptr_kind(kind) == 0 or bt.pointee != TypeKind.Struct)
        return sema_ty_none(t)
    if name_is_indexable(StrView { ptr: (bt.name), len: (bt.name_len) as i64 }) == 0
        return sema_ty_none(t)
    if name_eq(StrView { ptr: (bt.name), len: (bt.name_len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 1
        return sema_ty_set(t, TypeKind.U8, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (bt.name), len: (bt.name_len) as i64 })
    if st == null
        return sema_ty_none(t)
    var idx: i32 = find_field_index(st, StrView { ptr: (c"data"), len: (4) as i64 })
    if idx < 0
        idx = find_field_index(st, StrView { ptr: (c"ptr"), len: (3) as i64 })
    if idx < 0
        return sema_ty_none(t)
    let f: *StructField = get_field_type(st, idx)
    sema_ty_set(t, ptr_field_elem_kind(f), StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, TypeKind.Void, null)

# The element of `b` (`b[i]`, or what `for x in b` binds): of an array local,
# global or field (a row of an N-D one), of the `[N]T` a `*[N]T` local's view
# reads, of a Vec, Span or String (or a pointer to one), or what a `*T` points
# at.  Unknown for any other.
pub fn sema_elem_ty(sm: *Sema, b: *Expr, t: *SemaTy) -> TypeKind
    if b == null
        return sema_ty_none(t)
    var bt: SemaTy
    sema_expr_ty(sm, b, @bt)
    if bt.kind == TypeKind.Array
        return sema_arr_elem(@bt, t)
    if b.kind == ExprKind.Ident
        # A `*[N]T` (`@[N]T`, `@&[N]T`): its `[N]T`'s element.
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
        if v != null and sema_is_ptr_kind(v.kind) == 1 and v.index_elem != TypeKind.Void
            var a: SemaTy
            sema_arr_ty(@a, v.index_elem, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, v.shape)
            return sema_arr_elem(@a, t)
    if sema_buffer_ty(sm, @bt, t) != TypeKind.Unknown
        return t.kind
    if sema_is_ptr_kind(bt.kind) == 1 and bt.pointee == TypeKind.Struct and bt.name_len > 0
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (bt.name), len: (bt.name_len) as i64 }, TypeKind.Void, null)
    # A `*T` buffer of scalars: an `@T` is one value (index_refuse refuses it).
    if bt.kind == TypeKind.Ptr and primitive_name_len(bt.pointee) > 0
        return sema_ty_set(t, bt.pointee, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    sema_ty_none(t)

fn sema_index_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    if e.right != null and e.right.kind == ExprKind.Range
        return sema_ty_none(t)
    sema_elem_ty(sm, e.left, t)

# AGAST #4403: a `Span$T` method the emitter lowers inline
# (emitter_expr_call's try_emit_len_builtin / try_emit_span_builtin) and so
# has no FnDef to read: `.len()` an i64, `.is_empty()` a bool, `.slice(
# lo, hi)` the same Span$T.  TypeKind.Unknown for any other.  Called only when
# sema_method_fn found no method, as the emitter's dispatch falls back.
pub fn sema_span_method_ty(tn_sv: StrView, e: *Expr, t: *SemaTy) -> TypeKind
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if tn == null or tn_len <= 5 or memcmp(tn, c"Span$", 5 as i64) != 0
        return sema_ty_none(t)
    if e.args == null and name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"len"), len: (3) as i64 }) == 1
        return sema_ty_set(t, TypeKind.I64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    if e.args == null and name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_empty"), len: (8) as i64 }) == 1
        return sema_ty_set(t, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"slice"), len: (5) as i64 }) == 1 and e.args != null and e.args.next != null and e.args.next.next == null
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (tn), len: (tn_len) as i64 }, TypeKind.Void, null)
    sema_ty_none(t)

# 1 when `r` is the struct `name` or a pointer or reference to one.
fn sema_recv_named(r: *SemaTy, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if r.kind == TypeKind.Struct
        return name_eq(StrView { ptr: (r.name), len: (r.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 })
    if sema_is_ptr_kind(r.kind) == 1 and (r.pointee == TypeKind.Struct or r.pointee == TypeKind.Void)
        return name_eq(StrView { ptr: (r.name), len: (r.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 })
    0

# `x.m(..)`: the method's result, on a struct or a pointer to one; `E.V(..)`
# builds the enum E.
fn sema_method_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    let el: *Expr = e.left
    if el == null
        return sema_ty_none(t)
    if sema_enum_name(sm, el) != null
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (el.ident_ptr), len: (el.ident_len) as i64 }, TypeKind.Void, null)
    var r: SemaTy
    sema_expr_ty(sm, el, @r)
    # AGAST #4403: StrView.as_bytes() is an emitter intrinsic
    # (try_emit_strview_as_bytes) with no FnDef, so sema_method_fn finds
    # nothing and `let bytes = s.as_bytes()` stayed untyped.  It is the
    # `Span$u8` the emitter lowers, as bool_check's bk_is_strview_as_bytes.
    if e.args == null and sema_recv_named(@r, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1 and name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 1
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (c"Span$u8"), len: (7) as i64 }, TypeKind.Void, null)
    var st: *StructDef = sema_recv_struct(sm, @r)
    if st == null and el.kind == ExprKind.Ident and r.kind == TypeKind.Unknown and sema_find_local(sm, StrView { ptr: (el.ident_ptr), len: (el.ident_len) as i64 }) == null
        # AGAST #4251: `T.f(..)`, a static method of the struct T.
        st = sema_find_struct(sm, StrView { ptr: (el.ident_ptr), len: (el.ident_len) as i64 })
    # AGAST #4403: a monomorphised Span (`bytes: Span$u8`, `s.as_bytes()`)
    # may name no StructDef in Sema's map, which the emitter only spells as
    # it lowers.  Its accessors are still typeable (the specialised
    # `Span$u8_len`, else sema_span_method_ty's builtins above), so take
    # the name off r.  Other unresolved receivers stay unknown: typing one
    # `Option$i32.unwrap_or()` I32 would disagree with the emitter's i64
    # local (test_issue_option_unwrap_or_method).
    var tn: *u8 = null
    var tn_len: i32 = 0
    if st != null
        tn = st.name
        tn_len = st.name_len
    else
        if r.kind != TypeKind.Struct and sema_is_ptr_kind(r.kind) == 0
            return sema_ty_none(t)
        if r.name == null or r.name_len <= 5 or memcmp(r.name, c"Span$", 5 as i64) != 0
            return sema_ty_none(t)
        tn = r.name
        tn_len = r.name_len
    let fd: *FnDef = sema_method_fn(sm, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if fd != null
        return sema_fn_ret_ty(fd, t)
    sema_span_method_ty(StrView { ptr: (tn), len: (tn_len) as i64 }, e, t)

fn sema_struct_ty(st: *StructDef, t: *SemaTy) -> TypeKind
    if st == null
        return sema_ty_none(t)
    sema_ty_set(t, TypeKind.Struct, StrView { ptr: (st.name), len: (st.name_len) as i64 }, TypeKind.Void, null)

# The struct named `name`, unless it is a generic's template: a monomorphised
# name (`Span$u8`) never names one, so `Result$Span$u8$i32` splits after `u8`.
fn sema_find_concrete(sm: *Sema, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 })
    if st != null and st.type_params != null
        return null
    st

# The struct an `Option$S` carries in Some, or a `Result$S$E` in Ok / Err (its
# shortest `$`-split naming structs on both sides is taken); null otherwise.
pub fn sema_tagged_payload(sm: *Sema, name_sv: StrView, is_err: i32) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        if is_err == 1
            return null
        return sema_find_concrete(sm, StrView { ptr: (sfx), len: (sfx_len) as i64 })
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            let ok: *StructDef = sema_find_concrete(sm, StrView { ptr: (sfx), len: (cut) as i64 })
            if ok != null or cut + 1 < sfx_len
                if is_err == 0 and ok != null
                    return ok
                if is_err == 1
                    let er: *StructDef = sema_find_concrete(sm, StrView { ptr: (sfx + cut + 1), len: (sfx_len - cut - 1) as i64 })
                    if er != null
                        return er
        cut += 1
    null

# AGAST #4265: the user enum (`Errno`, a local `enum E2`) an `Option$E` /
# `Result$T$E` carries in Some / Ok (is_err 0) or Err (1), as a slice of `name`
# into `out_len`; null if that payload is no (non-generic) user enum.  A
# Result's split is the first `$` with a user enum on the side wanted.
fn sema_tagged_enum_payload(name_sv: StrView, is_err: i32, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *out_len = 0
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        if is_err == 1 or user_enum_index(StrView { ptr: (sfx), len: (sfx_len) as i64 }) < 0
            return null
        *out_len = sfx_len
        return sfx
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            if is_err == 0 and user_enum_index(StrView { ptr: (sfx), len: (cut) as i64 }) >= 0
                *out_len = cut
                return sfx
            if is_err == 1 and user_enum_index(StrView { ptr: (sfx + cut + 1), len: (sfx_len - cut - 1) as i64 }) >= 0
                *out_len = sfx_len - cut - 1
                return sfx + cut + 1
        cut += 1
    null

# AGAST #4410: the primitive kind `Option<T>` / `Result<T, E>` carries in its
# Some / Ok (is_err 0) or Err (is_err 1) payload, or TypeKind.Void.  Sema's
# payload typer only named concrete structs (#3810, #4265); a scalar payload
# is what `Some(v)` binds, so the slot move needs it.
fn sema_tagged_primitive_payload(name_sv: StrView, is_err: i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return TypeKind.Void
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        if is_err == 1
            return TypeKind.Void
        return primitive_type_from_name(StrView { ptr: (sfx), len: (sfx_len) as i64 })
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 0
        return TypeKind.Void
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            if is_err == 0
                return primitive_type_from_name(StrView { ptr: (sfx), len: (cut) as i64 })
            return primitive_type_from_name(StrView { ptr: (sfx + cut + 1), len: (sfx_len - cut - 1) as i64 })
        cut += 1
    TypeKind.Void

# AGAST #4448: the primitive `T` a one-level pointer payload points at, for a
# mangled `ptr_T` argument; TypeKind.Void otherwise.  As the emitter's
# carrier_payload_ptr_primitive reads it.
fn sema_ptr_primitive_name(name: *u8, len: i32) -> TypeKind
    if len <= 4 or memcmp(name, c"ptr_", 4) != 0
        return TypeKind.Void
    primitive_type_from_name(StrView { ptr: (name + 4), len: (len - 4) as i64 })

# AGAST #4448: the primitive pointer kind `Option<*T>` / `Result<*T, E>`
# carries in its Some / Ok (is_err 0) or Err (is_err 1) payload, or
# TypeKind.Void.  The emitter binds such an arm's `n` as a `*T` local; without
# this, Sema left the binding unknown and the checks read it as an i64.
fn sema_tagged_pointer_payload(name: *u8, len: i32, is_err: i32) -> TypeKind
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return TypeKind.Void
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        if is_err == 1
            return TypeKind.Void
        return sema_ptr_primitive_name(sfx, sfx_len)
    if name_eq(StrView { ptr: (name), len: (d) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 0
        return TypeKind.Void
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            if is_err == 0
                return sema_ptr_primitive_name(sfx, cut)
            return sema_ptr_primitive_name(sfx + cut + 1, sfx_len - cut - 1)
        cut += 1
    TypeKind.Void

# A match arm's binding `V(x)` on `scrut`: V's payload.  Unknown for a
# catch-all name, as the emitter left it: a `match` on a struct value is
# refused (by ritz0 too), and typing one only lets `.` reach unlowerable IR.
pub fn sema_arm_payload_ty(sm: *Sema, arm: *MatchArm, scrut: *Expr, t: *SemaTy) -> TypeKind
    if scrut == null or arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT
        return sema_ty_none(t)
    var s: SemaTy
    sema_expr_ty(sm, scrut, @s)
    if s.kind == TypeKind.Unknown
        return sema_ctor_payload_ty(sm, arm, scrut, t)
    sema_named_payload_ty(sm, arm, StrView { ptr: (s.name), len: (s.name_len) as i64 }, t)

# The type of `arm`'s payload binding over a scrutinee of the type named
# `name_sv` (`Option$T` / `Result$T$E` / a user enum).  AGAST #4590: the
# move check asks it with the type ref_check gave a scrutinee Sema can't.
pub fn sema_named_payload_ty(sm: *Sema, arm: *MatchArm, name_sv: StrView, t: *SemaTy) -> TypeKind
    var s: SemaTy
    s.name = name_sv.ptr
    s.name_len = name_sv.len as i32
    if s.name == null or s.name_len <= 0
        return sema_ty_none(t)
    if is_tagged_enum_type(StrView { ptr: (s.name), len: (s.name_len) as i64 }) == 1
        var is_err: i32 = 0
        if name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1 or name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
            is_err = 1
        let st: *StructDef = sema_tagged_payload(sm, StrView { ptr: (s.name), len: (s.name_len) as i64 }, is_err)
        if st != null
            return sema_struct_ty(st, t)
        # AGAST #4265: a user-enum payload is that enum, as a `let x: E` is.
        var en_len: i32 = 0
        let en: *u8 = sema_tagged_enum_payload(StrView { ptr: (s.name), len: (s.name_len) as i64 }, is_err, @en_len)
        if en != null
            return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (en), len: (en_len) as i64 }, TypeKind.Void, null)
        # AGAST #4448: a one-level pointer payload (`Option<*u8>`'s
        # `Some(n)`) is that `*T`, as the emitter binds the local.
        let pk_ptr: TypeKind = sema_tagged_pointer_payload(s.name, s.name_len, is_err)
        if pk_ptr != TypeKind.Void
            return sema_ty_set(t, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, pk_ptr, null)
        # AGAST #4410: a primitive payload (`Option<f64>`'s `Some(v)`,
        # `Result$i32$T`'s `Err(e)`) is that scalar.  The emitter binds the
        # name as its slot, so `.` and the checks need it typed.
        let pk: TypeKind = sema_tagged_primitive_payload(StrView { ptr: (s.name), len: (s.name_len) as i64 }, is_err)
        if pk != TypeKind.Void
            return sema_ty_set(t, pk, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
        return sema_ty_none(t)
    if user_enum_index(StrView { ptr: (s.name), len: (s.name_len) as i64 }) >= 0
        let uf: *StructField = user_enum_tuple_field(StrView { ptr: (s.name), len: (s.name_len) as i64 }, arm_variant_sel(StrView { ptr: (s.name), len: (s.name_len) as i64 }, arm))
        # A u64 payload stays unknown: the emitter binds it as an i64 local
        # (its u64 is kept for the lossy-conversion check alone).
        if uf != null and uf.field_type != TypeKind.U64
            var pointee: TypeKind = TypeKind.Void
            if uf.field_type == TypeKind.Ptr
                pointee = uf.ptr_pointee
            return sema_ty_set(t, uf.field_type, StrView { ptr: (uf.field_type_name), len: (uf.field_type_name_len) as i64 }, pointee, uf.fn_sig)
    sema_ty_none(t)

# AGAST #4251: `match Some(x)` / `Ok(x)` / `Err(x)`, the enum the emitter
# resolves from the arms: the arm of the constructor's own variant binds x,
# when x is a struct.  Unknown otherwise.
fn sema_ctor_payload_ty(sm: *Sema, arm: *MatchArm, scrut: *Expr, t: *SemaTy) -> TypeKind
    if scrut.kind != ExprKind.Call or scrut.args == null or scrut.args.next != null
        return sema_ty_none(t)
    let n: *u8 = scrut.func_name
    let l: i32 = scrut.func_name_len
    if name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 0 and name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 0 and name_eq(StrView { ptr: (n), len: (l) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 0
        return sema_ty_none(t)
    if name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (n), len: (l) as i64 }) == 0
        return sema_ty_none(t)
    var x: SemaTy
    sema_expr_ty(sm, scrut.args, @x)
    # AGAST #4410: a float payload is that width, so `Some(x)` of an f32 binds
    # `v` as f32 (`(v * 2.0) as i32`).  Other scalars stay unknown, as before.
    if x.kind == TypeKind.F32 or x.kind == TypeKind.F64
        return sema_ty_copy(t, @x)
    if x.kind != TypeKind.Struct or x.name == null or x.name_len <= 0
        return sema_ty_none(t)
    sema_ty_copy(t, @x)

# `c?`: the struct c's Result<T, E> carries in Ok, or its Option<T> in Some
# (AGAST #3974: `let x = f()?` bound x untyped).  Unknown for any other
# payload, as the emitter's `?` var-decl path types only a struct one.
fn sema_try_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    var c: SemaTy
    sema_expr_ty(sm, e.left, @c)
    if c.kind != TypeKind.Struct or c.name == null or c.name_len <= 0
        return sema_ty_none(t)
    sema_struct_ty(sema_tagged_payload(sm, StrView { ptr: (c.name), len: (c.name_len) as i64 }, 0), t)

# Field `i` of the tuple struct `tup` (a `let (a, b, ..)`'s initialiser's type).
pub fn sema_tuple_field_ty(sm: *Sema, tup: *SemaTy, i: i32, t: *SemaTy) -> TypeKind
    let st: *StructDef = sema_recv_struct(sm, tup)
    if st == null
        return sema_ty_none(t)
    var f: *StructField = st.fields
    var k: i32 = 0
    while f != null and k < i
        f = f.next
        k += 1
    if f == null
        return sema_ty_none(t)
    var pointee: TypeKind = TypeKind.Void
    match f.field_type
        TypeKind.Ptr =>
            pointee = f.ptr_pointee
        TypeKind.PtrPtr =>
            # AGAST #4428: a `**T` element binds as a `**T` local, whose pointee
            # is the inner `*T` (the packed slot is sema_tuple_field_inner's).
            pointee = TypeKind.Ptr
        _ => pass
    sema_ty_set(t, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, pointee, f.fn_sig)

# AGAST #4428: the packed inner pointee of tuple field `i` (`U` for a `**U`
# element, a deeper `T + PTR_DEPTH_UNIT` for `***T`), else TypeKind.Void.
pub fn sema_tuple_field_inner(sm: *Sema, tup: *SemaTy, i: i32) -> i32
    let st: *StructDef = sema_recv_struct(sm, tup)
    if st == null
        return (TypeKind.Void as i32)
    var f: *StructField = st.fields
    var k: i32 = 0
    while f != null and k < i
        f = f.next
        k += 1
    if f == null or f.field_type != TypeKind.PtrPtr
        return (TypeKind.Void as i32)
    f.inner_pointee_type

# AGAST #4251: a nameless tuple literal `(a, b, ..)` is a struct of its
# elements, which Sema makes once per literal (sema_tuple_new): a struct
# element is that struct, any other is left unknown.
var g_sema_tuple_of: *HashMapI64 = null
var g_sema_tuple_of_ready: i32 = 0

fn sema_tuple_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    var fi: *FieldInit = e.args as *FieldInit
    if fi == null or fi.name_len != 1 or *fi.name != '0'
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
    if g_sema_tuple_of_ready == 0
        g_sema_tuple_of = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_sema_tuple_of = hashmap_i64_with_cap(256)
        g_sema_tuple_of_ready = 1
    var st: *StructDef = (*g_sema_tuple_of).get(e as i64) as *StructDef
    if st == null
        var first: *StructField = null
        var last: *StructField = null
        while fi != null
            let f: *StructField = calloc(1, sizeof(StructField)) as *StructField
            f.name = fi.name
            f.name_len = fi.name_len
            f.field_type = TypeKind.Unknown
            f.inner_pointee_type = (TypeKind.Void as i32)
            var x: SemaTy
            sema_expr_ty(sm, fi.value, @x)
            if x.kind == TypeKind.Struct and x.name != null and x.name_len > 0
                f.field_type = TypeKind.Struct
                f.field_type_name = x.name
                f.field_type_name_len = x.name_len
            else if x.kind == TypeKind.Ptr or x.kind == TypeKind.PtrPtr or x.kind == TypeKind.Ref or x.kind == TypeKind.MutRef
                # AGAST #4410: a pointer element is its pointer kind, so a
                # `let (q, n) = t` binding takes it and `*q` keeps its width.
                f.field_type = x.kind
                f.ptr_pointee = x.pointee
                f.array_elem_type = x.pointee   # what `*(t.0)` loads
                f.field_type_name = x.name
                f.field_type_name_len = x.name_len
            else if ty_is_int(x.kind) == 1 or ty_is_float(x.kind) == 1 or x.kind == TypeKind.Bool
                # A scalar element likewise: `let (x, y) = t` is x's own slot.
                f.field_type = x.kind
            if last == null
                first = f
            else
                last.next = f
            last = f
            fi = fi.next
        st = sema_tuple_new(first)
        (*g_sema_tuple_of).insert(e as i64, st as i64)
    sema_ty_set(t, TypeKind.Struct, StrView { ptr: (st.name), len: (st.name_len) as i64 }, TypeKind.Void, null)

# The type of `e` into `t`, returning its kind; TypeKind.Unknown when Sema can't
# say.  `e` may be null.
pub fn sema_expr_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> TypeKind
    if e == null
        return sema_ty_none(t)
    let k: ExprKind = e.kind
    match k
        ExprKind.IntLit =>
            if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
                return sema_ty_set(t, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
            if e.lit_kind == LIT_PLAIN
                return sema_ty_set(t, TypeKind.I64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
            return sema_ty_none(t)
        ExprKind.CharLit =>
            return sema_ty_set(t, TypeKind.U8, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
        ExprKind.FloatLit =>
            return sema_ty_set(t, TypeKind.F64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
        ExprKind.NilLit =>
            return sema_ty_set(t, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
        ExprKind.CstringLit =>
            return sema_ty_set(t, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 }, TypeKind.U8, null)
        ExprKind.StringLit =>
            return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (c"StrView"), len: (7) as i64 }, TypeKind.Void, null)
        ExprKind.StructLit =>
            if e.ident_len == 0
                return sema_tuple_ty(sm, e, t)
            return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, TypeKind.Void, null)
        ExprKind.Ident =>
            return sema_name_ty(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, t)
        ExprKind.Binary =>
            if op_is_cmp_or_logic(e.op)
                return sema_ty_set(t, TypeKind.Bool, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Void, null)
            return sema_arith_ty(sm, e, t)
        ExprKind.Unary =>
            return sema_unary_ty(sm, e, t)
        ExprKind.Cast =>
            return sema_ty_set(t, e.type_kind, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, ptr_slot_flat(e.cast_ptr_kind), e.fn_sig)
        ExprKind.Call =>
            return sema_call_ty(sm, e, t)
        ExprKind.Member =>
            return sema_member_ty(sm, e, t)
        _ => pass
    if (k == ExprKind.If or k == ExprKind.Match) and e.value_ty_name != null
        # AGAST #3042: the struct its first typed arm yields, which the walk
        # notes as it leaves that arm (sema_note_arm_value); unknown before.
        return sema_ty_set(t, TypeKind.Struct, StrView { ptr: (e.value_ty_name), len: (e.value_ty_name_len) as i64 }, TypeKind.Void, null)
    match k
        ExprKind.Index =>
            return sema_index_ty(sm, e, t)
        ExprKind.Method =>
            return sema_method_ty(sm, e, t)
        ExprKind.Try =>
            return sema_try_ty(sm, e, t)
        _ => pass
    sema_ty_none(t)

# The kind of `e`: a TYPE_*, or TypeKind.Unknown.
pub fn sema_expr_type(sm: *Sema, e: *Expr) -> TypeKind
    var t: SemaTy
    sema_expr_ty(sm, e, @t)


# ---- What `x[i]` holds (AGAST #3510, #1816) ----
#
# index_through.ritz lowers `[]` through a pointer or reference (#2440), and
# the emitter's checks asked it, mid-lowering, what such an element is
# (through_elem_kind, through_named_elem).  That is a type fact, not codegen:
# Sema answers it here, from its typed scope, for the slot rules that moved
# onto it (literal_slot.ritz).  index_through keeps the lowering (the view it
# spills, the `*(p.data + i)` it fills).
#
# An element is described as a slot is: a TYPE_* kind and, for a pointer, its
# pointee.  TypeKind.Void means "not an element Sema can name": the slot rules
# then say nothing, as they did when the emitter couldn't type the target.
#
# SemaVar.index_elem is the element of a declared `[N]T` local or param, or of the
# `[N]T` a `*[N]T` / `@[N]T` / `@&[N]T` one points at (sema_index_note_*):
# the emitter's LocalVar.array_elem_type and its `p#` view (#2330).

fn sx_starts(name_sv: StrView, prefix_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var prefix: *u8 = prefix_sv.ptr
    var prefix_len: i32 = prefix_sv.len as i32
    if len <= prefix_len
        return 0
    (memcmp(name, prefix, prefix_len as i64) == 0) as i32

# 1 when a struct of this name indexes: a Vec, Span or String (#2440, #2442).
pub fn name_is_indexable(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return 0
    if sx_starts(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Vec$"), len: (4) as i64 }) == 1 or sx_starts(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Span$"), len: (5) as i64 }) == 1
        return 1
    name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 })

# The element kind of a Vec, Span or String named `name`, as through_elem_kind
# answers for one: a String's bytes are u8, a Vec's or Span's the pointee of its
# `data` / `ptr` field.  TypeKind.Unknown when the struct or field isn't found.
pub fn sema_buffer_elem(sm: *Sema, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var bt: SemaTy
    sema_ty_set(@bt, TypeKind.Struct, StrView { ptr: (name), len: (len) as i64 }, TypeKind.Void, null)
    var t: SemaTy
    sema_buffer_ty(sm, @bt, @t)

# The element kind of `v[i]` when `v`, of kind `kind` (pointing at `pointee`,
# naming `name`), is a Vec, Span or String or one level of pointer or
# reference to one; else TypeKind.Void.  through_named_elem's sees_through /
# indexes_itself.
pub fn sema_through_elem(sm: *Sema, kind: TypeKind, pointee: TypeKind, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if kind != TypeKind.Struct
        if kind != TypeKind.Ptr and kind != TypeKind.Ref and kind != TypeKind.MutRef
            return TypeKind.Void
        if pointee != TypeKind.Struct
            return TypeKind.Void
    if name_is_indexable(StrView { ptr: (name), len: (len) as i64 }) == 0
        return TypeKind.Void
    sema_buffer_elem(sm, StrView { ptr: (name), len: (len) as i64 })

# 1 when an array of `elem` named `name` gets the emitter's `p#` view
# (add_array_view's array_view_elem_ok): a scalar, a pointer, or a known struct.
pub fn sx_view_elem_ok(sm: *Sema, elem: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    match elem
        TypeKind.Struct =>
            return (len > 0 and sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) != null) as i32
        TypeKind.Ptr =>
            return 1
        TypeKind.PtrPtr | TypeKind.Void | TypeKind.Unknown | TypeKind.Array =>
            return 0
        _ => pass
    (primitive_name_len(elem) > 0) as i32

# T of the `[N]T` the `*[N]T` / `@[N]T` / `@&[N]T` local or param `v` points at,
# when the emitter gives it a `p#` view (add_array_view); TypeKind.Void otherwise.
#
# A pointer to an N-D array is a plane pointer (#2570), whose `p[i]` is a row:
# it has no view (AGAST #4259).
pub fn sema_view_elem(sm: *Sema, v: *SemaVar) -> TypeKind
    if v.kind != TypeKind.Ptr and v.kind != TypeKind.Ref and v.kind != TypeKind.MutRef
        return TypeKind.Void
    if v.shape != null and v.shape.rank >= 2
        return TypeKind.Void
    if v.index_elem == TypeKind.Void or sx_view_elem_ok(sm, v.index_elem, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }) == 0
        return TypeKind.Void
    v.index_elem

# The slot `a[i]` is, for an array `a` typed as sema_arr_ty types one: the
# kind of the element Sema's one element typer gives it (sema_arr_elem, AGAST
# #4290), a row of an N-D array a TypeKind.Array.  An element it leaves unknown
# keeps the kind it was written with (a `[N]**T`'s TypeKind.PtrPtr), as the
# emitter's lit_into_element reads it.  `elem_pointee` is U of a `[N]*U`, what
# `*a[i]` reads.
fn sx_arr_slot(a: *SemaTy, elem_pointee: TypeKind, kind: *TypeKind, pointee: *TypeKind)
    var t: SemaTy
    if sema_arr_elem(a, @t) == TypeKind.Unknown
        *kind = a.pointee
    else
        *kind = t.kind
    *pointee = elem_pointee

# The slot `name[i]` is, for a local or global `name`: through a Vec, Span,
# String or `*[N]T` (#2440, #2330), an element of a `[N]T`, or what a `*T`
# points at.  The emitter's lit_into_element.
pub fn sema_named_elem(sm: *Sema, name_sv: StrView, kind: *TypeKind, pointee: *TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *kind = TypeKind.Void
    *pointee = TypeKind.Void
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v != null
        let k: TypeKind = v.kind
        let view: TypeKind = sema_view_elem(sm, v)
        if view != TypeKind.Void
            *kind = view
            return
        let through: TypeKind = sema_through_elem(sm, k, v.pointee, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
        if through != TypeKind.Void
            *kind = through
            return
        match k
            TypeKind.Array =>
                var a: SemaTy
                sema_arr_ty(@a, v.index_elem, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, v.shape)
                sx_arr_slot(@a, v.elem_pointee, kind, pointee)
            TypeKind.Ptr =>
                *kind = v.pointee
            _ => pass
        return
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            if g.var_type == TypeKind.Array
                var a: SemaTy
                sema_arr_ty(@a, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 }, g.array_shape)
                sx_arr_slot(@a, g.array_elem_pointee, kind, pointee)
            return
        g = g.next

# The slot an index target `e` (an ExprKind.Index) is, as the emitter's
# lit_into_target typed it: `a[i][j]` over an `a: [N]*T` (#2332), an index
# through a Vec, Span or String (#2440), `name[i]`, `x.f[i]` over an array
# field.  A slice is no slot.
pub fn sema_index_slot(sm: *Sema, e: *Expr, kind: *TypeKind, pointee: *TypeKind)
    *kind = TypeKind.Void
    *pointee = TypeKind.Void
    if e == null or e.kind != ExprKind.Index or e.left == null or e.right == null or e.right.kind == ExprKind.Range
        return
    let base: *Expr = e.left
    if base.kind == ExprKind.Index and base.left != null and base.left.kind == ExprKind.Ident
        # `a[i][j]`: an `a: [N]*T` element is a pointer, indexed at T (#2332).
        let av: *SemaVar = sema_find_local(sm, StrView { ptr: (base.left.ident_ptr), len: (base.left.ident_len) as i64 })
        if av != null and av.kind == TypeKind.Array and av.index_elem == TypeKind.Ptr and av.elem_pointee != TypeKind.Void
            *kind = av.elem_pointee
            return
        # `v[i][j]` with `v[i]` itself a Vec, Span or String (#2442).
        if av != null and av.kind != TypeKind.Array
            let outer: TypeKind = sema_through_elem(sm, av.kind, av.pointee, StrView { ptr: (av.type_name), len: (av.type_name_len) as i64 })
            if outer == TypeKind.Struct
                sx_struct_elem_slot(sm, av, kind)
        return
    if base.kind == ExprKind.Unary and base.op == OpKind.Deref and base.operand != null and base.operand.kind == ExprKind.Ident
        # `(*p)[i]` with `p` a pointer to a Vec, Span or String, or to a `[N]T`.
        let pv: *SemaVar = sema_find_local(sm, StrView { ptr: (base.operand.ident_ptr), len: (base.operand.ident_len) as i64 })
        if pv == null or pv.kind == TypeKind.Struct
            return
        if pv.index_elem != TypeKind.Void and sx_view_elem_ok(sm, pv.index_elem, StrView { ptr: (pv.type_name), len: (pv.type_name_len) as i64 }) == 1
            *kind = pv.index_elem
            return
        *kind = sema_through_elem(sm, pv.kind, pv.pointee, StrView { ptr: (pv.type_name), len: (pv.type_name_len) as i64 })
        return
    if base.kind == ExprKind.Ident
        sema_named_elem(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 }, kind, pointee)
        return
    if base.kind == ExprKind.Member
        var r: SemaTy
        if sema_expr_ty(sm, base.left, @r) == TypeKind.Unknown
            return
        let st: *StructDef = sx_recv_struct(sm, @r)
        if st == null
            return
        let idx: i32 = find_field_index(st, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if idx < 0
            return
        sema_field_elem(sm, get_field_type(st, idx), kind, pointee)

# The slot `x.f[i]` is, for the field `f`: an element of a `[N]T` field, or
# through a Vec, Span or String field, or a pointer to one (#2564).  Shared
# with slot_narrowing's indexed field stores (AGAST #4309).
pub fn sema_field_elem(sm: *Sema, f: *StructField, kind: *TypeKind, pointee: *TypeKind)
    *kind = TypeKind.Void
    *pointee = TypeKind.Void
    if f == null
        return
    if f.field_type == TypeKind.Array
        var a: SemaTy
        sema_arr_ty(@a, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, f.array_shape)
        sx_arr_slot(@a, f.array_elem_pointee, kind, pointee)
        return
    var fp: TypeKind = TypeKind.Void
    if f.field_type == TypeKind.Ptr
        fp = f.ptr_pointee
    let through: TypeKind = sema_through_elem(sm, f.field_type, fp, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    if through != TypeKind.Void
        *kind = through

# The struct a receiver of type `r` is, or points at.
fn sx_recv_struct(sm: *Sema, r: *SemaTy) -> *StructDef
    if r.kind == TypeKind.Struct
        return sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    if (r.kind == TypeKind.Ptr or r.kind == TypeKind.Ref or r.kind == TypeKind.MutRef) and r.pointee == TypeKind.Struct
        return sema_find_struct(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 })
    null

# `v[i][j]` where `v`'s element is a struct: the element's element, when that
# struct is itself a Vec, Span or String (index_through_element).
fn sx_struct_elem_slot(sm: *Sema, v: *SemaVar, kind: *TypeKind)
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    if st == null or name_eq(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 1
        return
    var idx: i32 = find_field_index(st, StrView { ptr: (c"data"), len: (4) as i64 })
    if idx < 0
        idx = find_field_index(st, StrView { ptr: (c"ptr"), len: (3) as i64 })
    if idx < 0
        return
    let f: *StructField = get_field_type(st, idx)
    if f.field_type_name_len <= 0 or name_is_indexable(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) == 0
        return
    let inner: TypeKind = sema_buffer_elem(sm, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    if inner != TypeKind.Unknown
        *kind = inner

# --- SemaVar.index_elem ----------------------------------------------------------------

fn sx_last(sm: *Sema, name_sv: StrView) -> *SemaVar
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if sm.scope_top <= 0
        return null
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if v.name != name or v.name_len != len
        return null
    v

# The `let` / `var` sema_walk just bound: a written `[N]T` or `*[N]T`, or an
# unannotated pointer whose initialiser is one (`let q = p`, `p + k`, `@a`).
pub fn sema_index_note_decl(sm: *Sema, st: *Stmt)
    let v: *SemaVar = sx_last(sm, StrView { ptr: (st.var_name), len: (st.var_name_len) as i64 })
    if v == null
        return
    if st.var_declared_type == TypeKind.Void
        if v.kind == TypeKind.Ptr or v.kind == TypeKind.Ref or v.kind == TypeKind.MutRef
            # Judged before the name is in scope, as `let q = q` reads the outer q.
            sm.scope_top = sm.scope_top - 1
            v.index_elem = sx_init_elem(sm, st.var_init, @v.shape, @v.elem_pointee)
            sm.scope_top = sm.scope_top + 1
        return
    if st.var_type == TypeKind.Array
        v.index_elem = st.var_array_elem_type
        v.shape = st.var_array_shape
        # AGAST #4428: the U of a `[N]*U` / `[N]**U` element, so `*a[i]` and
        # `**a[i]` read its width (array_elem_record's out_pointee).
        v.elem_pointee = st.var_array_elem_pointee
    else if (st.var_type == TypeKind.Ptr or st.var_type == TypeKind.Ref or st.var_type == TypeKind.MutRef) and st.var_pointee_type == TypeKind.Array
        v.index_elem = st.var_pointee_array_elem_type
        v.shape = st.var_pointee_array_shape
        v.elem_pointee = st.var_pointee_array_elem_pointee
    else if st.var_type == TypeKind.PtrPtr and st.var_pointee_array_size > 0
        # AGAST #4428: a `**[N]T`, whose `*r` is the `*[N]T` (what
        # array_ptr_ptr_deref_base reads).  The fields describe that array;
        # `r[i]` is still a `*T` (kind rules above sx_local_index_slot_ty).
        v.index_elem = st.var_pointee_array_elem_type
        v.shape = st.var_pointee_array_shape
        v.elem_pointee = st.var_pointee_array_elem_pointee

# The element of the `[N]T` initialiser `init` points at (and its N-D shape
# into *shape, its U into *pointee): a pointer local that has one, under any
# `+ k` / `- k`, or `@a` / `@&a` of a `[N]T` local.
fn sx_init_elem(sm: *Sema, init: *Expr, shape: **ArrayShape, pointee: *TypeKind) -> TypeKind
    *pointee = TypeKind.Void
    var x: *Expr = init
    while x != null and x.kind == ExprKind.Binary and (x.op == OpKind.Add or x.op == OpKind.Sub)
        x = x.left
    if x == null
        return TypeKind.Void
    if x.kind == ExprKind.Unary and (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null and x.operand.kind == ExprKind.Ident
        let a: *SemaVar = sema_find_local(sm, StrView { ptr: (x.operand.ident_ptr), len: (x.operand.ident_len) as i64 })
        if a != null and a.kind == TypeKind.Array
            *shape = a.shape
            *pointee = a.elem_pointee
            return a.index_elem
        return TypeKind.Void
    if x.kind != ExprKind.Ident
        return TypeKind.Void
    let p: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
    if p == null or p.kind == TypeKind.Array
        return TypeKind.Void
    *shape = p.shape
    *pointee = p.elem_pointee
    p.index_elem

# The param sema_walk just bound.
pub fn sema_index_note_param(sm: *Sema, p: *Param)
    let v: *SemaVar = sx_last(sm, StrView { ptr: (p.name), len: (p.name_len) as i64 })
    if v == null
        return
    if p.param_type == TypeKind.Array
        v.index_elem = p.param_array_elem_type
        v.shape = p.param_array_shape
        v.elem_pointee = p.param_array_elem_pointee
    else if (p.param_type == TypeKind.Ptr or p.param_type == TypeKind.Ref or p.param_type == TypeKind.MutRef) and p.param_pointee_type == TypeKind.Array
        v.index_elem = p.param_pointee_array_elem_type
        v.shape = p.param_pointee_array_shape
        v.elem_pointee = p.param_pointee_array_elem_pointee

# AGAST #4428: write a pointer binding's kind / pointee / inner from
# ptr_levels, as the emitter's infer_elem_ptr_ptr_let does (and then
# type_ref_view_let: an `@place` binding is a REF, `@&place` a MUT_REF).
fn sema_note_ptr_levels(lv: *SemaVar, levels: i32, inner: TypeKind, name_sv: StrView, ref_kind: TypeKind)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if levels == 1
        lv.kind = TypeKind.Ptr
        if ref_kind != TypeKind.Void
            lv.kind = ref_kind
        lv.pointee = inner
    else
        lv.kind = TypeKind.PtrPtr
        if ref_kind != TypeKind.Void
            lv.kind = ref_kind
        lv.pointee = TypeKind.Ptr
        lv.inner = ptr_slot_deepen((inner as i32), levels - 2)
    if inner == TypeKind.Struct
        lv.type_name = name
        lv.type_name_len = name_len

# AGAST #4428: note the binding a pointer initialiser infers on the
# initialiser node itself, for emit_var_decl to apply where its own views
# can't name a base (a `& [N]**T` borrow param).
fn sx_note_init_levels(init: *Expr, levels: i32, inner: TypeKind, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    init.sema_levels = levels
    init.sema_inner = (inner as i32)
    init.sema_ptr_name = name
    init.sema_ptr_name_len = name_len

# AGAST #4428: the type an unannotated `let` / `var` takes from an
# array-element or element-address initialiser, as emit_var_decl's
# infer_array_elem_let / infer_elem_ptr_ptr_let type it: a `*U` for a
# `[N]*U` element, a `*T` / `**T` for a `[N]**T` element or its address, or
# the element address `@a[i][j]`.  Writes the scope's last binding.
pub fn sema_note_elem_init(sm: *Sema, st: *Stmt)
    if st == null or sm.scope_top <= 0 or st.var_declared_type != TypeKind.Void or st.var_init == null
        return
    let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
    let init: *Expr = st.var_init
    # An `@place` / `@&place` binding is a REF / MUT_REF in the emitter
    # (type_ref_view_let), whatever its levels.
    var ref_kind: TypeKind = TypeKind.Void
    if init.kind == ExprKind.Unary
        match init.op
            OpKind.Addr =>
                ref_kind = TypeKind.Ref
            OpKind.AddrMut =>
                ref_kind = TypeKind.MutRef
            _ => pass
    # `@a[i][j]` with `a: [N]*T` is `a[i] + j`, a `*T`: the element pointee
    # is the left operand's (elem_index_as_deref drops through the sum).
    if init.kind == ExprKind.Unary and (init.op == OpKind.Addr or init.op == OpKind.AddrMut) and init.operand != null and sx_is_array_elem_index(sm, init.operand) == 1
        var pname: *u8 = null
        var plen: i32 = 0
        let pt: TypeKind = sx_array_elem_pointee(sm, init.operand.left, @pname, @plen)
        if pt != TypeKind.Void
            lv.kind = TypeKind.Ptr
            if ref_kind != TypeKind.Void
                lv.kind = ref_kind
            lv.pointee = pt
            if pt == TypeKind.Struct
                lv.type_name = pname
                lv.type_name_len = plen
            sx_note_init_levels(init, 1, pt, StrView { ptr: (pname), len: (plen) as i64 })
            return
    # `a[i]`, `a[i] + k` and a full-rank N-D leaf over a `[N]*T`: the
    # emitter's infer_array_elem_let types the local `*T` from the element
    # pointee (array_elem_pointee walks the sum to its left operand).
    var pname: *u8 = null
    var plen: i32 = 0
    let pt: TypeKind = sx_array_elem_pointee(sm, init, @pname, @plen)
    if pt != TypeKind.Void
        lv.kind = TypeKind.Ptr
        if ref_kind != TypeKind.Void
            lv.kind = ref_kind
        lv.pointee = pt
        if pt == TypeKind.Struct
            lv.type_name = pname
            lv.type_name_len = plen
        sx_note_init_levels(init, 1, pt, StrView { ptr: (pname), len: (plen) as i64 })
        return
    # `let p = *r` with `r: **[N]T` is the `*[N]T` (array_ptr_ptr_deref_base).
    # Its element and shape come from r's recorded pointee array.
    if init.kind == ExprKind.Unary and init.op == OpKind.Deref and init.operand != null and init.operand.kind == ExprKind.Ident
        let rv: *SemaVar = sema_find_local(sm, StrView { ptr: (init.operand.ident_ptr), len: (init.operand.ident_len) as i64 })
        if rv != null and rv.kind == TypeKind.PtrPtr and rv.index_elem != TypeKind.Void
            lv.kind = TypeKind.Ptr
            lv.pointee = TypeKind.Array
            lv.index_elem = rv.index_elem
            lv.shape = rv.shape
            lv.elem_pointee = rv.elem_pointee
            return
    if init.kind == ExprKind.Index
        # `b[i][j]` with `b: [N]**T` is `*(b[i] + j)`, one level under b[i].
        if init.left != null and init.left.kind == ExprKind.Index
            var inner: TypeKind = TypeKind.Void
            var lname: *u8 = null
            var llen: i32 = 0
            let levels: i32 = sx_ptr_levels_into(sm, init.left, @inner, @lname, @llen)
            if levels >= 2 and inner != TypeKind.Void
                sema_note_ptr_levels(lv, levels - 1, inner, StrView { ptr: (lname), len: (llen) as i64 }, ref_kind)
                sx_note_init_levels(init, levels - 1, inner, StrView { ptr: (lname), len: (llen) as i64 })
                return
    var inner2: TypeKind = TypeKind.Void
    var oname: *u8 = null
    var olen: i32 = 0
    let levels2: i32 = sx_ptr_levels_into(sm, init, @inner2, @oname, @olen)
    if levels2 == 0 or inner2 == TypeKind.Void
        return
    sema_note_ptr_levels(lv, levels2, inner2, StrView { ptr: (oname), len: (olen) as i64 }, ref_kind)
    sx_note_init_levels(init, levels2, inner2, StrView { ptr: (oname), len: (olen) as i64 })

# ---- The slot type the emitter reads (AGAST #4410, rest of #4404) -----------
#
# get_expr_type's remaining arms, on Sema's typed scope.  A slot is coarser
# than a source type: `let b: bool` is an i64 slot (#1646), an integer
# element of a local `[N]T` is i64 (the value model's width), and a node
# Sema can't place falls to the emitter's i64 default.  Where the emitter's
# arm is exact -- the pointee of a `*T` index, a through-a-Vec element, a
# float array's leaf -- the slot keeps that width, because the former call
# sites branch on it.  sema_walk notes the answer on every expression it
# reaches (sema_note_expr_ty) and the emitter reads it via expr_slot_ty.

# AGAST #4410: the float width an unannotated `let v = if / match ...` slot
# takes from its arms -- the emitter's last_match_float_ty -- or 0 when no arm
# is a float.  Read at bind time (sema_walk), so the local's own name carries
# it without changing get_expr_type's i64 answer for the if / match node.
pub fn sema_arm_float_slot(sm: *Sema, e: *Expr) -> TypeKind
    if e == null or (e.kind != ExprKind.If and e.kind != ExprKind.Match)
        return TypeKind.Void
    var arm: *MatchArm = e.args as *MatchArm
    var merged: TypeKind = TypeKind.Void
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            var kk: TypeKind = expr_sema_ty(arm.body)
            if arm.body.kind == ExprKind.If or arm.body.kind == ExprKind.Match
                kk = sema_arm_float_slot(sm, arm.body)
            if kk == TypeKind.F32 or kk == TypeKind.F64
                if merged == TypeKind.Void
                    merged = kk
                else if merged == TypeKind.F32 and (kk == TypeKind.F32 or is_float_lit_operand(arm.body) == 1)
                    merged = TypeKind.F32
                else
                    merged = TypeKind.F64
        arm = arm.next
    merged

# `k` in the emitter's value model: a bool is an i64 slot, an untyped local
# or unknown is its i64 default.  Anything else keeps its width.
fn sx_slot_kind(k: TypeKind) -> TypeKind
    if k == TypeKind.Bool or k == TypeKind.Unknown
        return TypeKind.I64
    k

# The const `name` names, or null.
fn sx_find_const(sm: *Sema, name_sv: StrView) -> *ConstEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return c
        c = c.next
    null

# The global `name` names, or null.
fn sx_find_global(sm: *Sema, name_sv: StrView) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return g
        g = g.next
    null

# AGAST #2155: a float const initialised by an integer expression is a
# float slot (emitter_core's const_int_init_float_ty), 0 otherwise.
fn sx_const_int_init_float_ty(sm: *Sema, ce: *ConstEntry) -> TypeKind
    if ce == null or (ce.const_type != TypeKind.F32 and ce.const_type != TypeKind.F64)
        return TypeKind.Void
    var folded: i64 = 0
    if const_fold_int(sm.module.constants, ce.value_expr, 1, @folded) == 0
        return TypeKind.Void
    ce.const_type

# AGAST #2176: a float const initialised by a float literal, likewise.
fn sx_const_float_lit_init_ty(ce: *ConstEntry) -> TypeKind
    if ce == null or (ce.const_type != TypeKind.F32 and ce.const_type != TypeKind.F64)
        return TypeKind.Void
    if ce.value_expr == null or is_float_lit_operand(ce.value_expr) == 0
        return TypeKind.Void
    ce.const_type

# The slot a `name:& T` borrow param's local reads as: bind_scalar_borrow_param
# binds the pointee as a plain T local (an array, a `*T` / `**S`, or a scalar),
# and a struct pointee keeps the normal `:&` binding (TypeKind.MutRef).
fn sx_lent_slot_ty(p: *Param) -> TypeKind
    if p.param_type == TypeKind.Array
        return TypeKind.Array
    let pt: TypeKind = p.param_pointee_type
    match pt
        TypeKind.Array =>
            return TypeKind.Array
        TypeKind.Ptr | TypeKind.PtrPtr =>
            return pt
        TypeKind.Struct =>
            return TypeKind.MutRef
        _ => pass
    # An integer / bool / float scalar binds as itself (a bool's slot is a
    # bool local here, not the i64 a declared `let b: bool` takes).
    pt

# The slot the local `v` names reads as from the emitter's LocalVar: its
# declared kind, an i64 for a bool, the initialiser's kind for an untyped let.
fn sx_var_slot_ty(v: *SemaVar) -> TypeKind
    if v.kind == TypeKind.Unknown
        if v.lent != null
            return sx_lent_slot_ty(v.lent)
        # An unannotated `let`: the initialiser's slot, which emit_var_decl
        # infers (a float method's width, else i64).  Not let_check's view:
        # that types a `match` initialiser's arms, where the emitter keeps i64.
        if v.init_slot != TypeKind.Unknown
            return sx_slot_kind(v.init_slot)
        # `let a = [..]` / `[x; N]`: an array local (AGAST #2266 / #3014).
        if v.let_kind == TypeKind.Array
            return TypeKind.Array
        return TypeKind.I64
    sx_slot_kind(v.kind)

# `name` as an identifier: a local, a global, a float const's folding, else
# the emitter's i64.  An integer const is i64 there (only the float folders
# are read).
fn sx_ident_slot_ty(sm: *Sema, e: *Expr) -> TypeKind
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if v != null
        return sx_var_slot_ty(v)
    let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if g != null
        return g.var_type
    let ce: *ConstEntry = sx_find_const(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    let cft: TypeKind = sx_const_int_init_float_ty(sm, ce)
    if cft != TypeKind.Void
        return cft
    let lft: TypeKind = sx_const_float_lit_init_ty(ce)
    if lft != TypeKind.Void
        return lft
    TypeKind.I64

# The fn a call names, as the emitter's find_call_fn resolves it.
fn sx_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name_len == 0
        return null
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if v != null
        return v.fn_sig
    sema_call_fn(sm, e)

# The pointee a `*T` / `@T` return names, TypeKind.Void otherwise.
fn sx_ret_pointee(fd: *FnDef) -> TypeKind
    if fd.return_type != TypeKind.Ptr and fd.return_type != TypeKind.Ref and fd.return_type != TypeKind.MutRef
        return TypeKind.Void
    let k: TypeKind = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
    if k != TypeKind.Void
        return k
    TypeKind.Struct

# The impl method `e` calls, as sema_impl_method resolves it.
fn sx_method_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.left == null
        return null
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @r) == TypeKind.Unknown
        if e.left.kind == ExprKind.Ident and sema_find_local(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == null
            let st: *StructDef = sema_find_struct(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if st != null
                return sema_impl_method(sm, StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        return null
    let st: *StructDef = sema_recv_struct(sm, @r)
    if st == null
        if r.name_len <= 5 or memcmp(r.name, c"Span$", 5 as i64) != 0
            return null
        return sema_impl_method(sm, StrView { ptr: (r.name), len: (r.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    sema_impl_method(sm, StrView { ptr: (st.name), len: (st.name_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# The field a member chain names, as emitter_core's member_field_def: a local
# or global receiver's struct (or the struct it points at), a struct const,
# or a field of an outer field.
fn sx_member_field(sm: *Sema, e: *Expr) -> *StructField
    if e == null or e.kind != ExprKind.Member or e.left == null
        return null
    # emitter_core's member_field_def names a receiver's struct from a local,
    # global, struct const, member chain, call, index or deref -- not a cast,
    # so `(p as *S).f` is its i64 default.
    if e.left.kind == ExprKind.Cast
        return null
    # AGAST #4410: `x.forward[i].f` -- an element of a `[N]*S` / `**S` /
    # `[N]S` base.  index_elem_struct_name names the struct there.
    if e.left.kind == ExprKind.Index
        var iel: i32 = 0
        let ien: *u8 = sx_index_struct_name(sm, e.left, @iel)
        if ien != null and iel > 0
            let ist: *StructDef = sema_find_struct(sm, StrView { ptr: (ien), len: (iel) as i64 })
            if ist != null
                let iidx: i32 = find_field_index(ist, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
                if iidx >= 0
                    return get_field_type(ist, iidx)
        # Fall through to the general receiver path when the element isn't
        # named there (an array or tuple element Sema already types).
    # A deref of `@x` names only an identifier's struct (deref_pointee_struct_name
    # reads resolve_expr_struct_name, which types locals and globals), so
    # `(*(@o.s)).f` and `(*(@a[i])).f` are its i64 default too.
    if e.left.kind == ExprKind.Unary and e.left.op == OpKind.Deref and e.left.operand != null
        let reop: *Expr = e.left.operand
        if reop.kind == ExprKind.Unary and (reop.op == OpKind.Addr or reop.op == OpKind.AddrMut)
            if reop.operand == null or reop.operand.kind != ExprKind.Ident
                return null
    var st: *StructDef = null
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @r) != TypeKind.Unknown
        st = sema_recv_struct(sm, @r)
    if st == null and e.left.kind == ExprKind.Ident
        # member_field_def names an identifier receiver's struct by its
        # type_name at any pointer level (`**K` too; `sema_recv_struct` stops
        # at one), else a struct const (`K.f`).  A tuple's name finds no
        # StructDef and stays null, as before.
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if v != null and v.type_name_len > 0
            st = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
        else
            let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
            if g != null and g.type_name_len > 0
                st = sema_find_struct(sm, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
            else
                let ce: *ConstEntry = sx_find_const(sm, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                if ce != null and ce.const_type == TypeKind.Struct and ce.type_name_len > 0
                    st = sema_find_struct(sm, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    if st == null
        return null
    let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if idx < 0
        return null
    get_field_type(st, idx)

# The slot `x.f` reads: the field's own kind (the emitter does not coarsen a
# member), i64 for a user enum's unit variant `E.V` (the emitter's default).
fn sx_member_slot_ty(sm: *Sema, e: *Expr) -> TypeKind
    if e.left == null
        return TypeKind.I64
    let en: *Expr = sema_enum_name(sm, e.left)
    if en != null and enum_variant_index(StrView { ptr: (en.ident_ptr), len: (en.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
        return TypeKind.I64
    let f: *StructField = sx_member_field(sm, e)
    if f != null and f.field_type != TypeKind.Unknown and f.field_type != TypeKind.Void
        return f.field_type
    TypeKind.I64

# The struct an element `ie` = `b[i]` names, as emitter_core's
# index_elem_struct_name: a `[N]*S` / **S field, a `[N]S` array, a `*S`
# local, or a `[N]S` global; null of any other.
fn sx_index_struct_name(sm: *Sema, ie: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if ie == null or ie.kind != ExprKind.Index or ie.left == null
        return null
    let b: *Expr = ie.left
    # An N-D array field's full-rank element, `T[0].n[0][0]` over `n: [2][1]In`.
    match b.kind
        ExprKind.Index =>
            var depth: i32 = 0
            var rb: *Expr = b
            while rb != null and rb.kind == ExprKind.Index and rb.left != null
                depth = depth + 1
                rb = rb.left
            if rb != null and rb.kind == ExprKind.Member and rb.left != null
                var rr: SemaTy
                if sema_expr_ty(sm, rb.left, @rr) != TypeKind.Unknown
                    let rst: *StructDef = sema_recv_struct(sm, @rr)
                    if rst != null
                        let ridx: i32 = find_field_index(rst, StrView { ptr: (rb.ident_ptr), len: (rb.ident_len) as i64 })
                        if ridx >= 0
                            let rf: *StructField = get_field_type(rst, ridx)
                            if rf.array_shape != null and depth + 1 == rf.array_shape.rank and rf.array_shape.leaf_type == TypeKind.Struct and rf.array_shape.leaf_name_len > 0
                                *out_len = rf.array_shape.leaf_name_len
                                return rf.array_shape.leaf_name
            return null
        ExprKind.Member =>
            # The field where `b`'s own receiver names the struct (no recursion
            # through sx_member_field: it calls this fn for an INDEX receiver).
            if b.left == null
                return null
            var r: SemaTy
            if sema_expr_ty(sm, b.left, @r) == TypeKind.Unknown
                return null
            let mst: *StructDef = sema_recv_struct(sm, @r)
            if mst == null
                return null
            let midx: i32 = find_field_index(mst, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
            if midx < 0
                return null
            let f: *StructField = get_field_type(mst, midx)
            if f.field_type_name_len <= 0
                return null
            match f.field_type
                TypeKind.PtrPtr =>
                    *out_len = f.field_type_name_len
                    return f.field_type_name
                TypeKind.Ptr =>
                    *out_len = f.field_type_name_len
                    return f.field_type_name
                _ => pass
            if f.field_type == TypeKind.Array and (f.array_elem_type == TypeKind.Struct or f.array_elem_type == TypeKind.Ptr or f.array_elem_type == TypeKind.PtrPtr)
                *out_len = f.array_elem_type_name_len
                return f.array_elem_type_name
            # A Vec / Span / String field (`table.edges[0].y_min`).
            if f.field_type_name != null and f.field_type_name_len > 0
                var fbt: SemaTy
                sema_ty_set(@fbt, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, f.ptr_pointee, null)
                var fet: SemaTy
                if sema_buffer_ty(sm, @fbt, @fet) != TypeKind.Unknown and fet.kind == TypeKind.Struct and fet.name_len > 0
                    *out_len = fet.name_len
                    return fet.name
            return null
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
            if v != null
                if v.kind == TypeKind.Array or v.kind == TypeKind.Ptr or v.kind == TypeKind.PtrPtr
                    if v.type_name_len <= 0
                        return null
                    *out_len = v.type_name_len
                    return v.type_name
                # A `& [N]S` borrow param binds as an array local; its type
                # name is the element struct.
                if v.kind == TypeKind.Unknown and v.lent != null and v.lent.param_pointee_type == TypeKind.Array and v.lent.param_type_name_len > 0
                    *out_len = v.lent.param_type_name_len
                    return v.lent.param_type_name
                # A Vec / Span / String element (`points[0].x`, points: Vec<T>).
                if v.type_name != null and v.type_name_len > 0
                    var bt: SemaTy
                    sema_ty_set(@bt, v.kind, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }, v.pointee, null)
                    var et: SemaTy
                    if sema_buffer_ty(sm, @bt, @et) != TypeKind.Unknown and et.kind == TypeKind.Struct and et.name_len > 0
                        *out_len = et.name_len
                        return et.name
                return null
            let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
            if g != null and g.var_type == TypeKind.Array and g.array_elem_type == TypeKind.Struct and g.array_elem_type_name_len > 0
                *out_len = g.array_elem_type_name_len
                return g.array_elem_type_name
            return null
        _ => pass
    null

# The pointee of `x[i]`'s element when the array is a `[N]*T` (emitter's
# array_elem_pointee_kind), else TypeKind.Void.
fn sema_index_slot_pointee(sm: *Sema, x: *Expr) -> TypeKind
    if x == null
        return TypeKind.Void
    # `*(T[i] + 1)` / `*(a[i] + k)`: the index that `x` adds to.
    if x.kind == ExprKind.Binary and (x.op == OpKind.Add or x.op == OpKind.Sub)
        return sema_index_slot_pointee(sm, x.left)
    if x.kind != ExprKind.Index or x.left == null
        return TypeKind.Void
    if x.right != null and x.right.kind == ExprKind.Range
        return TypeKind.Void
    # An N-D array's full-rank pointer leaf: `T[0].s[0][0]` over
    # `s: [1][2]*u8` points at a u8.
    if x.kind == ExprKind.Index and x.left != null and x.left.kind == ExprKind.Index
        var nd_depth: i32 = 0
        var nd_root: *Expr = x.left
        while nd_root != null and nd_root.kind == ExprKind.Index and nd_root.left != null
            nd_depth = nd_depth + 1
            nd_root = nd_root.left
        if nd_root != null and nd_root.kind == ExprKind.Member and nd_root.left != null
            var nr: SemaTy
            if sema_expr_ty(sm, nd_root.left, @nr) != TypeKind.Unknown
                let nst: *StructDef = sema_recv_struct(sm, @nr)
                if nst != null
                    let nidx: i32 = find_field_index(nst, StrView { ptr: (nd_root.ident_ptr), len: (nd_root.ident_len) as i64 })
                    if nidx >= 0
                        let nf: *StructField = get_field_type(nst, nidx)
                        if nf.array_shape != null and nd_depth + 1 == nf.array_shape.rank and nf.array_shape.leaf_type == TypeKind.Ptr
                            return nf.array_shape.leaf_pointee
    # An untyped `let a = [@p, ..]` (`[N]*T`): its element points at T.
    if x.left.kind == ExprKind.Ident
        let av: *SemaVar = sema_find_local(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if av != null and av.kind == TypeKind.Unknown and av.let_kind == TypeKind.Array and av.let_elem == TypeKind.Ptr and av.pointee != TypeKind.Void
            return av.pointee
        # A `b:& [N]*T` borrow param binds as an `[N]*T` array local.  A
        # `[N]**T` element's packed inner is not the element's pointee.
        if av != null and av.kind == TypeKind.Unknown and av.lent != null and av.lent.param_pointee_type == TypeKind.Array
            if av.lent.param_pointee_array_elem_type == TypeKind.Ptr and av.lent.param_pointee_array_elem_pointee != TypeKind.Void
                return av.lent.param_pointee_array_elem_pointee
    # A module const's `[N]*U` table: `T[i]` points at a U (AGAST #1866).
    if x.left.kind == ExprKind.Ident and sema_find_local(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 }) == null and sx_find_global(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 }) == null
        let ce: *ConstEntry = sx_find_const(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if ce != null and ce.const_type == TypeKind.Array and ce.array_elem_type == TypeKind.Ptr
            return ce.array_elem_pointee
    var kind: TypeKind = TypeKind.Void
    var pointee: TypeKind = TypeKind.Void
    sema_index_slot(sm, x, @kind, @pointee)
    # array_elem_peintee_kind answers only for a `[N]*T` element (a PTR); a
    # `[N]**T` element's packed inner is not that pointee.
    if kind == TypeKind.Ptr and pointee != TypeKind.Void
        return pointee
    # A `[N]*T` field: `h.a[1]` points at a T, recorded (or named) on the field.
    if x.left.kind == ExprKind.Member
        let f: *StructField = sx_member_field(sm, x.left)
        if f != null and f.field_type == TypeKind.Array and f.array_elem_type == TypeKind.Ptr
            if f.array_elem_pointee != TypeKind.Void
                return f.array_elem_pointee
            let pn: TypeKind = primitive_type_from_name(StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
            if pn != TypeKind.Void
                return pn
    # Anything else (a row, a `[N]**T` element's packed inner) is not the
    # element's pointee: ptr_levels handles those shapes.
    TypeKind.Void

# The slot of `x[i]` where `x` is a local: an array's element (a float leaf
# keeps its width, an integer one is i64), a `*[N]T` view's element, a Vec /
# Span / String element (exact), a `*T`'s pointee (int and float exact, else
# u8), a `**T`'s `*T`.
fn sx_local_index_slot_ty(sm: *Sema, v: *SemaVar, kind: TypeKind) -> TypeKind
    # A `b:& [N]T` borrow param binds as an array local
    # (bind_scalar_borrow_param), so `b[i]` is its element: float exact, else
    # the emitter's i64.
    if v.kind == TypeKind.Unknown and v.lent != null and v.lent.param_pointee_type == TypeKind.Array
        let elem: TypeKind = v.lent.param_pointee_array_elem_type
        if elem == TypeKind.F32 or elem == TypeKind.F64
            return elem
        return TypeKind.I64
    # An untyped `let q = a[1]` of a `[N]*T` element is a `*T` (its init_slot),
    # with T recorded in the local's pointee.
    if v.kind == TypeKind.Unknown and v.init_slot == TypeKind.Ptr and v.pointee != TypeKind.Void
        if v.pointee == TypeKind.F32 or v.pointee == TypeKind.F64
            return v.pointee
        if ty_is_int(v.pointee) == 1
            return v.pointee
        return TypeKind.U8
    if v.index_elem != TypeKind.Void and (v.kind == TypeKind.Ptr or v.kind == TypeKind.Ref or v.kind == TypeKind.MutRef)
        if v.shape != null and v.shape.rank >= 2
            return TypeKind.I64
        if v.index_elem == TypeKind.F32 or v.index_elem == TypeKind.F64
            return v.index_elem
        return TypeKind.I64
    let th: TypeKind = sema_through_elem(sm, v.kind, v.pointee, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    if th != TypeKind.Void
        return th
    # An untyped `let a = [..]` is an `[N]T` local let_check typed.
    if v.kind == TypeKind.Unknown and v.let_kind == TypeKind.Array
        if v.let_elem != TypeKind.Void
            if v.let_elem == TypeKind.F32 or v.let_elem == TypeKind.F64
                return v.let_elem
        return TypeKind.I64
    match v.kind
        TypeKind.Array =>
            if kind == TypeKind.F32 or kind == TypeKind.F64
                return kind
            return TypeKind.I64
        TypeKind.Ptr =>
            if ty_is_int(kind) == 1 or ty_is_float(kind) == 1
                return kind
            # `let p = pi()` with `pi() -> *i32`: sema_fn_ret_ty keeps the return
            # name, not the pointee, so read the primitive off it.
            let pn: TypeKind = primitive_type_from_name(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
            if pn != TypeKind.Void
                return pn
            return TypeKind.U8
        TypeKind.PtrPtr =>
            return TypeKind.Ptr
        _ => pass
    TypeKind.I64

# The slot of `x[i]` where `x` is a global (the emitter resolves a global
# base only for arrays and pointers; anything else is its i64 default).
fn sx_global_index_slot_ty(g: *GlobalVarDef, kind: TypeKind) -> TypeKind
    match g.var_type
        TypeKind.Array =>
            if kind == TypeKind.F32 or kind == TypeKind.F64
                return kind
            return TypeKind.I64
        TypeKind.PtrPtr =>
            return TypeKind.Ptr
        TypeKind.Ptr =>
            if ty_is_int(g.pointee_type) == 1 or ty_is_float(g.pointee_type) == 1
                return g.pointee_type
            let pn: TypeKind = primitive_type_from_name(StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })
            if pn != TypeKind.Void
                return pn
            return TypeKind.U8
        _ => pass
    TypeKind.I64

# The slot of `x.f[i]`: an array field's float leaf, a `*T` field's float
# pointee, a Vec / Span / String field's element; else i64.
fn sx_member_index_slot_ty(sm: *Sema, base: *Expr, kind: TypeKind) -> TypeKind
    let f: *StructField = sx_member_field(sm, base)
    if f == null
        return TypeKind.I64
    match f.field_type
        TypeKind.Array =>
            if f.array_elem_type == TypeKind.F32 or f.array_elem_type == TypeKind.F64
                return f.array_elem_type
            return TypeKind.I64
        TypeKind.Ptr =>
            let pk: TypeKind = ptr_field_elem_kind(f)
            if pk == TypeKind.F32 or pk == TypeKind.F64
                return pk
            return TypeKind.I64
        _ => pass
    let th: TypeKind = sema_through_elem(sm, f.field_type, f.ptr_pointee, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    if th != TypeKind.Void
        return th
    TypeKind.I64

# T of the `[N]T` that a `*[N]T` / `@[N]T` / `@&[N]T` return names, or VOID.
fn sx_fn_array_elem(fd: *FnDef) -> TypeKind
    if fd == null or fd.ret_ptr_array == null
        return TypeKind.Void
    let p: *Param = fd.ret_ptr_array
    if p.param_pointee_array_size <= 0
        return TypeKind.Void
    return p.param_pointee_array_elem_type

# T of the `[N]T` that `base` (a field, a global or a call of `*[N]T` /
# `@[N]T` / `@&[N]T`) points at -- `h.r[i]`, `g[i]`, `f()[i]` -- or
# TypeKind.Void.  ref_check's rs_base_array_kind, for the slot typer.  A local's
# view is sx_local_index_slot_ty's (its index_elem).
fn sx_base_array_elem(sm: *Sema, base: *Expr) -> TypeKind
    if base == null
        return TypeKind.Void
    match base.kind
        ExprKind.Ident =>
            if sema_find_local(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 }) != null
                return TypeKind.Void
            let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if g == null or g.ptr_array == null or g.ptr_array.param_pointee_array_size <= 0
                return TypeKind.Void
            return g.ptr_array.param_pointee_array_elem_type
        ExprKind.Member =>
            let f: *StructField = sx_member_field(sm, base)
            if f == null or f.ptr_array == null or f.ptr_array.param_pointee_array_size <= 0
                return TypeKind.Void
            return f.ptr_array.param_pointee_array_elem_type
        ExprKind.Call =>
            return sx_fn_array_elem(sx_call_fn(sm, base))
        ExprKind.Method =>
            return sx_fn_array_elem(sx_method_fn(sm, base))
        _ => pass
    TypeKind.Void

# The slot `x[i]` reads.
fn sx_index_slot_ty(sm: *Sema, e: *Expr) -> TypeKind
    if e.left == null
        return TypeKind.I64
    let base: *Expr = e.left
    # `a[i][j]` over an `a: [N]*T` is a T.
    if sx_is_array_elem_index(sm, e) == 1
        return sx_array_elem_pointee_kind(sm, base)
    # `(*r)[i]` with `r` a `**T` reads a T (emitter_core's deref_index_elem).
    let dix: TypeKind = sx_deref_index_elem(sm, e)
    if dix != TypeKind.Void
        return dix
    # A full-rank `x[i][j]` over an N-D `[N][M]f32` / `f64` loads its leaf.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = sx_nd_index_shape(sm, e, @nd_depth)
    if nd_sh != null and nd_depth == nd_sh.rank and (e.right == null or e.right.kind != ExprKind.Range)
        if nd_sh.leaf_type == TypeKind.F32 or nd_sh.leaf_type == TypeKind.F64
            return nd_sh.leaf_type
    # `h.r[i]` / `g[i]` / `f()[i]` over a pointer to an array: its element.
    let ae: TypeKind = sx_base_array_elem(sm, base)
    if ae != TypeKind.Void
        if ae == TypeKind.F32 or ae == TypeKind.F64
            return ae
        return TypeKind.I64
    # AGAST #4450: `p[i]` through a `*E`, E a user (unit) enum, loads the
    # `%E` (emitter_core's ptr_index_user_enum; emit_expr_index lowers it
    # `*(p + i)`), the struct-kind slot synth_slot_ty names.
    if e.right == null or e.right.kind != ExprKind.Range
        var pt: SemaTy
        sema_expr_ty(sm, base, @pt)
        if sema_is_ptr_kind(pt.kind) == 1 and pt.pointee == TypeKind.Struct and pt.name_len > 0
            let pn: StrView = StrView { ptr: (pt.name), len: (pt.name_len) as i64 }
            if is_enum_type(pn) == 1 and is_tagged_enum_type(pn) == 0
                return TypeKind.Struct
    var kind: TypeKind = TypeKind.Void
    var pointee: TypeKind = TypeKind.Void
    sema_index_slot(sm, e, @kind, @pointee)
    match base.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if v != null
                return sx_local_index_slot_ty(sm, v, kind)
            let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if g != null
                return sx_global_index_slot_ty(g, kind)
            let ce: *ConstEntry = sx_find_const(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if ce != null and ce.const_type == TypeKind.Array
                if ce.array_elem_type == TypeKind.F32 or ce.array_elem_type == TypeKind.F64
                    return ce.array_elem_type
                return TypeKind.I64
            return TypeKind.I64
        ExprKind.Member =>
            return sx_member_index_slot_ty(sm, base, kind)
        _ => pass
    # An index through an element, a deref, a call or a method: Sema's one
    # element typer already names the slot exactly (a `mk()[0]` over a
    # Vec<u8> is a u8, a Span's element its leaf).
    var et: SemaTy
    let ek: TypeKind = sema_elem_ty(sm, base, @et)
    if ek != TypeKind.Unknown
        return ek
    if kind != TypeKind.Void
        return kind
    TypeKind.I64

# The float width of a binop operand, or 0 (emitter_core's
# binop_operand_float_ty on Sema's typer).
fn sx_operand_float_ty(sm: *Sema, x: *Expr) -> TypeKind
    if x == null
        return TypeKind.Void
    var t: SemaTy
    let k: TypeKind = sema_expr_ty(sm, x, @t)
    if k == TypeKind.F32 or k == TypeKind.F64
        return k
    if x.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if v != null
            # An untyped `let r = x.floor() + 0.5` is a float slot its
            # initialiser fixed; sema_expr_ty leaves it unknown.
            let sk: TypeKind = sx_var_slot_ty(v)
            if sk == TypeKind.F32 or sk == TypeKind.F64
                return sk
            if v.type_name_len >= 3
                if memcmp(v.type_name, c"f32", 3 as i64) == 0
                    return TypeKind.F32
                if memcmp(v.type_name, c"f64", 3 as i64) == 0
                    return TypeKind.F64
        return TypeKind.Void
    if x.kind == ExprKind.Method
        # A float primitive method (`.floor()`) keeps its receiver's width,
        # as get_expr_type's float_method_result_ty says.
        if x.left != null and x.args == null and sx_is_float_primitive(StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }) == 1
            return sx_operand_float_ty(sm, x.left)
        let fd: *FnDef = sx_method_fn(sm, x)
        if fd != null and (fd.return_type == TypeKind.F32 or fd.return_type == TypeKind.F64)
            return fd.return_type
    if x.kind == ExprKind.Unary and x.op == OpKind.Deref and x.operand != null
        # `*(p + 1) * 2.0`: the deref is its pointee's width.
        var b: *Expr = x.operand
        while b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
            b = b.left
        if b.kind == ExprKind.Ident
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
            if v != null
                if v.pointee == TypeKind.F32 or v.pointee == TypeKind.F64
                    return v.pointee
                let pn: TypeKind = primitive_type_from_name(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
                if pn == TypeKind.F32 or pn == TypeKind.F64
                    return pn
        if b.kind == ExprKind.Member
            let f: *StructField = sx_member_field(sm, b)
            if f != null and (f.array_elem_type == TypeKind.F32 or f.array_elem_type == TypeKind.F64)
                return f.array_elem_type
        return TypeKind.Void
    return TypeKind.Void

# 1 for `ceil` / `floor` / `round` / `abs`, the float primitive methods.
fn sx_is_float_primitive(n_sv: StrView) -> i32
    var n: *u8 = n_sv.ptr
    var len: i32 = n_sv.len as i32
    if len == 4 and memcmp(n, c"ceil", 4 as i64) == 0
        return 1
    if len == 5 and (memcmp(n, c"floor", 5 as i64) == 0 or memcmp(n, c"round", 5 as i64) == 0)
        return 1
    if len == 3 and memcmp(n, c"abs", 3 as i64) == 0
        return 1
    0

# The f32 / f64 a method call evaluates to, or 0: the emitter's METHOD arm
# only answers floats (everything else is its i64 default).
fn sx_method_float_ty(sm: *Sema, e: *Expr) -> TypeKind
    if e.left == null
        return TypeKind.Void
    if e.args == null and e.ident_len > 0
        # A float primitive method on a float receiver keeps its width.
        let n: *u8 = e.ident_ptr
        let is_prim: i32 = ((e.ident_len == 4 and memcmp(n, c"ceil", 4 as i64) == 0) or (e.ident_len == 5 and memcmp(n, c"floor", 5 as i64) == 0) or (e.ident_len == 5 and memcmp(n, c"round", 5 as i64) == 0) or (e.ident_len == 3 and memcmp(n, c"abs", 3 as i64) == 0)) as i32
        if is_prim == 1
            let ft: TypeKind = sx_operand_float_ty(sm, e.left)
            if ft != TypeKind.Void
                return ft
    let fd: *FnDef = sx_method_fn(sm, e)
    if fd == null
        return TypeKind.Void
    if fd.return_type == TypeKind.F32 or fd.return_type == TypeKind.F64
        return fd.return_type
    TypeKind.Void

# The pointee `p` names, or TypeKind.Void: a typed binding's, a cast's written
# target, a field's, a call's return, or the base of `base + k`.
fn sx_pointee_ty(sm: *Sema, p: *Expr) -> TypeKind
    if p == null
        return TypeKind.Void
    if p.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
        if v != null
            if v.lent != null and v.kind == TypeKind.Unknown
                return v.lent.param_pointee_type
            return v.pointee
        let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
        if g != null
            return g.pointee_type
        return TypeKind.Void
    if p.kind == ExprKind.Cast and p.type_kind == TypeKind.Ptr
        return ptr_slot_flat(p.cast_ptr_kind)
    if p.kind == ExprKind.Member
        let f: *StructField = sx_member_field(sm, p)
        if f != null
            if f.field_type == TypeKind.Ptr or f.field_type == TypeKind.Ref or f.field_type == TypeKind.MutRef
                if f.ptr_pointee != TypeKind.Void
                    return f.ptr_pointee
                return f.array_elem_type
            return f.field_type
        return TypeKind.Void
    if p.kind == ExprKind.Binary and (p.op == OpKind.Add or p.op == OpKind.Sub)
        return sx_pointee_ty(sm, p.left)
    match p.kind
        ExprKind.Call =>
            let fd: *FnDef = sx_call_fn(sm, p)
            if fd == null
                return TypeKind.Void
            return sx_ret_pointee(fd)
        ExprKind.Method =>
            let fd: *FnDef = sx_method_fn(sm, p)
            if fd == null
                return TypeKind.Void
            return sx_ret_pointee(fd)
        ExprKind.Index =>
            return sema_index_slot_pointee(sm, p)
        _ => pass
    TypeKind.Void

# The scalar slot of an operand `@x` reads, or TypeKind.Void: a typed binding's
# own kind, else Sema's source kind when primitive.
fn sx_operand_prim_slot(sm: *Sema, x: *Expr) -> TypeKind
    if x == null
        return TypeKind.Void
    if x.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if v != null
            let k: TypeKind = sx_var_slot_ty(v)
            if primitive_name_len(k) > 0
                return k
            return TypeKind.Void
        let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if g != null and primitive_name_len(g.var_type) > 0
            return g.var_type
        return TypeKind.Void
    var t: SemaTy
    let k: TypeKind = sema_expr_ty(sm, x, @t)
    if primitive_name_len(k) > 0
        return k
    # The emitter's inline_ptr_pointee falls back to expr_slot_ty, the node's
    # Sema annotation: `*@a[i][j]` over a `[N]*T` is the element's own slot.
    let sl: TypeKind = sema_slot_ty(sm, x)
    if primitive_name_len(sl) > 0
        return sl
    TypeKind.Void

# The element type of `arr[i]` over an inline array, as emitter_core's
# addr_of_array_elem_type reads it; VOID otherwise.
fn sx_addr_of_array_elem_type(sm: *Sema, x: *Expr) -> TypeKind
    if x == null or x.kind != ExprKind.Index or x.left == null
        return TypeKind.Void
    if x.right != null and x.right.kind == ExprKind.Range
        return TypeKind.Void
    if x.left.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if v != null
            if v.kind == TypeKind.Array
                return v.index_elem
            return TypeKind.Void
        let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (x.left.ident_ptr), len: (x.left.ident_len) as i64 })
        if g != null and g.var_type == TypeKind.Array
            return g.array_elem_type
        return TypeKind.Void
    if x.left.kind == ExprKind.Member
        let f: *StructField = sx_member_field(sm, x.left)
        if f != null and f.field_type == TypeKind.Array
            return f.array_elem_type
    TypeKind.Void

# The scalar pointee a pointer expression states inline -- `<e> as *T`,
# `@x`, a call or method returning `*T`, and the base of `base + k` --
# as emitter_core's inline_deref_scalar_pointee; VOID otherwise.
fn sx_inline_prim_pointee(sm: *Sema, p: *Expr) -> TypeKind
    if p == null
        return TypeKind.Void
    # AGAST #4475: `c"..."` is a `*u8`. `*(c"..." + i)` fell through to the
    # i64 default (`load i64` of the literal's address) while `*(p + i)` on
    # a `*u8` loaded i8. A suffix compare then read seven bytes past the
    # character. The stride is ptr_arith_elem_size's.
    match p.kind
        ExprKind.CstringLit =>
            return TypeKind.U8
        # `*(T[0].s[0][0] + 1)`: an N-D pointer-array element's pointee.
        ExprKind.Index =>
            let ipt: TypeKind = sema_index_slot_pointee(sm, p)
            if primitive_name_len(ipt) > 0
                return ipt
            return TypeKind.Void
        _ => pass
    if p.kind == ExprKind.Cast and p.type_kind == TypeKind.Ptr
        let t: TypeKind = ptr_slot_flat(p.cast_ptr_kind)
        if primitive_name_len(t) > 0
            return t
        return TypeKind.Void
    if p.kind == ExprKind.Unary and (p.op == OpKind.Addr or p.op == OpKind.AddrMut) and p.operand != null
        let ae: TypeKind = sx_addr_of_array_elem_type(sm, p.operand)
        if primitive_name_len(ae) > 0
            return ae
        return sx_operand_prim_slot(sm, p.operand)
    if p.kind == ExprKind.Binary and (p.op == OpKind.Add or p.op == OpKind.Sub) and p.left != null
        if p.left.kind == ExprKind.Call or p.left.kind == ExprKind.Method or p.left.kind == ExprKind.Cast or p.left.kind == ExprKind.Binary
            return sx_inline_prim_pointee(sm, p.left)
        return TypeKind.Void
    match p.kind
        ExprKind.Call =>
            let fd: *FnDef = sx_call_fn(sm, p)
            if fd != null and (fd.return_type == TypeKind.Ptr or fd.return_type == TypeKind.Ref or fd.return_type == TypeKind.MutRef)
                if fd.ret_ref != null and primitive_name_len(fd.ret_ref.param_pointee_type) > 0
                    return fd.ret_ref.param_pointee_type
                return primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            return TypeKind.Void
        ExprKind.Method =>
            let fd: *FnDef = sx_method_fn(sm, p)
            if fd != null and (fd.return_type == TypeKind.Ptr or fd.return_type == TypeKind.Ref or fd.return_type == TypeKind.MutRef)
                if fd.ret_ref != null and primitive_name_len(fd.ret_ref.param_pointee_type) > 0
                    return fd.ret_ref.param_pointee_type
                return primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
            return TypeKind.Void
        _ => pass
    TypeKind.Void

# The pointee of a memory builtin's pointer argument: a stated `<e> as *T` /
# `@x`, else what `*arg` would load.
fn sx_mem_pointee(sm: *Sema, arg: *Expr) -> TypeKind
    if arg == null
        return TypeKind.Void
    if arg.kind == ExprKind.Cast and arg.type_kind == TypeKind.Ptr and arg.cast_ptr_kind != (TypeKind.Void as i32)
        return ptr_slot_flat(arg.cast_ptr_kind)
    if arg.kind == ExprKind.Unary and (arg.op == OpKind.Addr or arg.op == OpKind.AddrMut) and arg.operand != null
        let t: TypeKind = sx_operand_prim_slot(sm, arg.operand)
        if t != TypeKind.Void
            return t
        return TypeKind.Void
    let pt: TypeKind = sx_pointee_ty(sm, arg)
    if pt != TypeKind.Void
        return pt
    TypeKind.I64

# The signature of the fn value a nameless call names (`fs[i](..)`,
# `(p as EfiFn)(..)`, `(t.f)(..)`), as emitter_core's value_fn_sig resolves
# it from the local's / field's element signature.
fn sx_value_fn_sig(sm: *Sema, c: *Expr) -> *FnDef
    if c == null
        return null
    if c.kind == ExprKind.Index and c.left != null and c.left.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (c.left.ident_ptr), len: (c.left.ident_len) as i64 })
        if v != null and v.kind == TypeKind.Array
            return v.elem_fn_sig
        return null
    if c.kind == ExprKind.Index and c.left != null and c.left.kind == ExprKind.Member and c.right != null and c.right.kind != ExprKind.Range
        let af: *StructField = sx_member_field(sm, c.left)
        if af != null and af.field_type == TypeKind.Array
            return af.elem_fn_sig
        return null
    match c.kind
        ExprKind.Cast =>
            return c.fn_sig
        ExprKind.Member =>
            let f: *StructField = sx_member_field(sm, c)
            if f != null and f.field_type == TypeKind.Ptr
                return f.fn_sig
            return null
        _ => pass
    if c.kind == ExprKind.Call
        let fd: *FnDef = sx_call_fn(sm, c)
        if fd != null and fd.return_type == TypeKind.Ptr
            return fd.ret_fn_sig
    null

# The slot `f(...)`: a memory builtin's pointee (VOID for its stores), a user
# enum variant ctor's struct, else the resolved fn's return type (VOID for a
# void fn), else i64.
fn sx_call_slot_ty(sm: *Sema, e: *Expr) -> TypeKind
    if e.func_name_len == 0
        let fd: *FnDef = sx_value_fn_sig(sm, e.left)
        if fd != null
            return fd.return_type
        return TypeKind.I64
    let mid: i32 = mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if mid != 0
        if mid == MEM_VOLATILE_STORE or mid == MEM_ATOMIC_STORE or mid == MEM_FENCE
            return TypeKind.Void
        return sx_mem_pointee(sm, e.args)
    var en: *u8 = null
    var en_len: i32 = 0
    user_enum_ctor_call(e, @en, @en_len)
    if en != null
        return TypeKind.Struct
    let fd: *FnDef = sx_call_fn(sm, e)
    if fd != null
        return fd.return_type
    TypeKind.I64

# AGAST #4428: the five array views the emitter kept on LocalVar, ported onto
# Sema's typed scope so the slot typer reads one place: array_elem_record,
# array_elem_pointee_kind, addr_of_elem_levels, nd_index_shape and
# ptr_ptr_index_scalar (emitter_core).  The row shapes that pinned them are
# test_ritz1_array_ptr_element.py's `[N]**T`, `[N][M]*T` and address-of-element
# rows (AGAST #2376 / #2379 / #3058).

# What an array's record says its element points at, as elem_recorded_pointee:
# U for a TypeKind.Ptr element recording U, else VOID.
fn sx_elem_recorded_pointee(elem: TypeKind, pointee: TypeKind) -> TypeKind
    if elem != TypeKind.Ptr
        return TypeKind.Void
    if pointee == TypeKind.Struct
        return TypeKind.Struct
    if primitive_name_len(pointee) > 0
        return pointee
    TypeKind.Void

# nd_index_shape on Sema: the `[N][M]..T` an index chain `e` indexes into,
# with the number of indexes in *out_depth; null when it indexes none.  A
# plane pointer (`*[N][M]..T`, whose shape SemaVar.shape holds) answers too.
fn sx_nd_index_shape(sm: *Sema, e: *Expr, out_depth: *i32) -> *ArrayShape
    if e == null or e.kind != ExprKind.Index
        return null
    var depth: i32 = 0
    var base: *Expr = e
    while base.kind == ExprKind.Index
        depth = depth + 1
        base = base.left
    var sh: *ArrayShape = null
    match base.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
            if v != null
                # A `[N][M]..T` local's own shape, or a plane pointer's.
                if v.kind == TypeKind.Array or sema_is_ptr_kind(v.kind) == 1
                    sh = v.shape
            else
                let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                if g != null and g.var_type == TypeKind.Array
                    sh = g.array_shape
        ExprKind.Member =>
            let f: *StructField = sx_member_field(sm, base)
            if f != null and f.field_type == TypeKind.Array
                sh = f.array_shape
        _ => pass
    if sh == null or depth > sh.rank
        return null
    *out_depth = depth
    sh

# What the array that `b` = `a[i]` indexes records of its element: its kind,
# what it points at (U for `[N]*U`, the packed inner for `[N]**U`), and the
# struct name.  TypeKind.Void in *out_elem when `b` isn't a whole element of a
# recorded array (array_elem_record).
fn sx_array_elem_record(sm: *Sema, b: *Expr, out_elem: *TypeKind, out_pointee: *i32, out_name: **u8, out_len: *i32)
    *out_elem = TypeKind.Void
    *out_pointee = (TypeKind.Void as i32)
    *out_name = null
    *out_len = 0
    if b == null or b.kind != ExprKind.Index or b.left == null
        return
    if b.right != null and b.right.kind == ExprKind.Range
        return
    # The record of the array behind a `*[N]T` / `& [N]T` view: its element.
    # A plane pointer (`*[N][M]..T`, whose shape is recorded) has no view.
    if b.left.kind == ExprKind.Ident
        let pv: *SemaVar = sema_find_local(sm, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
        if pv != null and (pv.kind == TypeKind.Ptr or pv.kind == TypeKind.Ref or pv.kind == TypeKind.MutRef) and pv.pointee == TypeKind.Array and pv.shape == null
            *out_elem = pv.index_elem
            *out_pointee = (pv.elem_pointee as i32)
            *out_name = pv.type_name
            *out_len = pv.type_name_len
            return
    var depth: i32 = 0
    let sh: *ArrayShape = sx_nd_index_shape(sm, b, @depth)
    if sh != null
        if depth == sh.rank
            *out_elem = sh.leaf_type
            *out_pointee = (sh.leaf_pointee as i32)
            *out_name = sh.leaf_name
            *out_len = sh.leaf_name_len
    else
        match b.left.kind
            ExprKind.Member =>
                let f: *StructField = sx_member_field(sm, b.left)
                if f != null and f.field_type == TypeKind.Array
                    *out_elem = f.array_elem_type
                    *out_pointee = (f.array_elem_pointee as i32)
                    *out_name = f.array_elem_type_name
                    *out_len = f.array_elem_type_name_len
            ExprKind.Ident =>
                let v: *SemaVar = sema_find_local(sm, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                if v != null
                    # A `b:& [N]T` borrow param binds as an unknown local; its array
                    # is the param's.
                    if v.kind == TypeKind.Unknown and v.lent != null and v.lent.param_pointee_type == TypeKind.Array
                        *out_elem = v.lent.param_pointee_array_elem_type
                        *out_pointee = (v.lent.param_pointee_array_elem_pointee as i32)
                        *out_name = v.lent.param_type_name
                        *out_len = v.lent.param_type_name_len
                    else if v.kind == TypeKind.Array
                        *out_elem = v.index_elem
                        *out_pointee = (v.elem_pointee as i32)
                        *out_name = v.type_name
                        *out_len = v.type_name_len
                else
                    let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                    if g != null and g.var_type == TypeKind.Array
                        *out_elem = g.array_elem_type
                        *out_pointee = (g.array_elem_pointee as i32)
                        *out_name = g.array_elem_type_name
                        *out_len = g.array_elem_type_name_len
                    else
                        # An element of a `const T: [N]*U` table (AGAST #1866).
                        let ce: *ConstEntry = sx_find_const(sm, StrView { ptr: (b.left.ident_ptr), len: (b.left.ident_len) as i64 })
                        if ce != null and ce.const_type == TypeKind.Array
                            *out_elem = ce.array_elem_type
                            *out_pointee = (ce.array_elem_pointee as i32)
                            *out_name = ce.array_elem_type_name
                            *out_len = ce.array_elem_type_name_len
            _ => pass

# U when `x` is an element of a `[N]*U` array (local, param, global, field or
# const, N-D too) or that element `+ k`, with a struct U's name; VOID
# otherwise (array_elem_pointee).  A `[N]**U` element is ptr_levels' shape.
fn sx_array_elem_pointee(sm: *Sema, x: *Expr, out_name: **u8, out_len: *i32) -> TypeKind
    *out_name = null
    *out_len = 0
    var b: *Expr = x
    while b != null and b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
        # `q - p` is a count, not an element (is_ptr_distance).
        if b.op == OpKind.Sub
            var rinner: TypeKind = TypeKind.Void
            if sx_ptr_levels_into(sm, b.right, @rinner, null, null) > 0
                return TypeKind.Void
            if sx_array_elem_pointee_kind(sm, b.right) != TypeKind.Void
                return TypeKind.Void
        b = b.left
    var elem: TypeKind = TypeKind.Void
    var pointee_slot: i32 = 0
    var name: *u8 = null
    var name_len: i32 = 0
    sx_array_elem_record(sm, b, @elem, @pointee_slot, @name, @name_len)
    let pointee: TypeKind = ptr_slot_flat(pointee_slot)
    if sx_elem_recorded_pointee(elem, pointee) == TypeKind.Struct
        *out_name = name
        *out_len = name_len
    sx_elem_recorded_pointee(elem, pointee)

# array_elem_pointee, when the caller doesn't need a struct's name.
fn sx_array_elem_pointee_kind(sm: *Sema, x: *Expr) -> TypeKind
    var name: *u8 = null
    var name_len: i32 = 0
    sx_array_elem_pointee(sm, x, @name, @name_len)

# 1 when `e` is `a[i][j]` over an `a: [N]*T` element (is_array_elem_index).
fn sx_is_array_elem_index(sm: *Sema, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Index
        return 0
    (sx_array_elem_pointee_kind(sm, e.left) != TypeKind.Void) as i32

# 1 when `x` (past any `+ k`) is an array element `a[i]` or its address
# `@a[i]` (elem_rooted).
fn sx_elem_rooted(x: *Expr) -> i32
    var b: *Expr = x
    while b != null and b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
        b = b.left
    if b == null
        return 0
    if b.kind == ExprKind.Unary and (b.op == OpKind.Addr or b.op == OpKind.AddrMut)
        b = b.operand
    (b != null and b.kind == ExprKind.Index) as i32

# `@a[i]` points at an element that is itself a pointer: a `**U` for
# `a: [N]*U`, one level more than the element for `a: [N]**U` (0 otherwise).
fn sx_addr_of_elem_levels(sm: *Sema, x: *Expr, out_inner: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    *out_inner = TypeKind.Void
    if out_name != null
        *out_name = null
    if out_len != null
        *out_len = 0
    var elem: TypeKind = TypeKind.Void
    var pointee: i32 = (TypeKind.Void as i32)
    var name: *u8 = null
    var name_len: i32 = 0
    sx_array_elem_record(sm, x, @elem, @pointee, @name, @name_len)
    if elem == TypeKind.Ptr
        let u: TypeKind = sx_elem_recorded_pointee(elem, ptr_slot_flat(pointee))
        if u == TypeKind.Void
            return 0
        *out_inner = u
        if u == TypeKind.Struct
            if out_name != null
                *out_name = name
            if out_len != null
                *out_len = name_len
        return 2
    if elem != TypeKind.PtrPtr or ptr_ptr_slot_levels(pointee) < 2
        return 0
    *out_inner = ptr_ptr_slot_inner(pointee)
    if *out_inner == TypeKind.Struct
        if out_name != null
            *out_name = name
        if out_len != null
            *out_len = name_len
    ptr_ptr_slot_levels(pointee) + 1

# The static pointer levels of `x`, as emitter_core's ptr_levels_of reads
# them, with the innermost pointee in *out_inner (a struct's name out too);
# 0 for a plain `*T` base.
fn sx_ptr_levels_into(sm: *Sema, x: *Expr, out_inner: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    *out_inner = TypeKind.Void
    if out_name != null
        *out_name = null
    if out_len != null
        *out_len = 0
    if x == null
        return 0
    match x.kind
        ExprKind.Binary =>
            if x.op == OpKind.Add or x.op == OpKind.Sub
                return sx_ptr_levels_into(sm, x.left, out_inner, out_name, out_len)
            return 0
        ExprKind.Unary =>
            # `@a[i]` / `@&a[i]`: the element's address (addr_of_elem_levels).
            if (x.op == OpKind.Addr or x.op == OpKind.AddrMut) and x.operand != null and x.operand.kind == ExprKind.Index
                return sx_addr_of_elem_levels(sm, x.operand, out_inner, out_name, out_len)
            if x.op != OpKind.Deref or x.operand == null
                return 0
            var inner: TypeKind = TypeKind.Void
            var in_name: *u8 = null
            var in_len: i32 = 0
            let sub: i32 = sx_ptr_levels_into(sm, x.operand, @inner, @in_name, @in_len)
            if sub < 2
                *out_inner = TypeKind.Void
                return 0
            *out_inner = inner
            if out_name != null
                *out_name = in_name
            if out_len != null
                *out_len = in_len
            return sub - 1
        _ => pass
    var slot: i32 = (TypeKind.Void as i32)
    var name: *u8 = null
    var name_len: i32 = 0
    match x.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
            if v != null
                if v.kind == TypeKind.PtrPtr
                    slot = v.inner
                # `let r = @q` with `q: *T` is a `**T` held as a PTR local; its
                # inner-pointee slot says so (AGAST #2532).
                else if (v.kind == TypeKind.Ptr or v.kind == TypeKind.Ref or v.kind == TypeKind.MutRef) and v.inner != (TypeKind.Void as i32) and ptr_ptr_slot_levels(v.inner) >= 2
                    slot = v.inner
                else
                    return 0
                name = v.type_name
                name_len = v.type_name_len
            else
                let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
                if g == null or g.var_type != TypeKind.PtrPtr
                    return 0
                slot = g.inner_pointee_type
                name = g.pointee_type_name
                name_len = g.pointee_type_name_len
        ExprKind.Member =>
            let f: *StructField = sx_member_field(sm, x)
            if f == null or f.field_type != TypeKind.PtrPtr
                return 0
            slot = f.inner_pointee_type
            name = f.field_type_name
            name_len = f.field_type_name_len
        ExprKind.Index =>
            # An element of a `[N]**T` array, which records T packed (AGAST #2376).
            var elem: TypeKind = TypeKind.Void
            var el_name: *u8 = null
            var el_len: i32 = 0
            sx_array_elem_record(sm, x, @elem, @slot, @el_name, @el_len)
            if elem != TypeKind.PtrPtr
                return 0
            name = el_name
            name_len = el_len
        ExprKind.Cast =>
            # `x as **S`, whose slot cast_tail_new records (AGAST #2544).
            if x.type_kind != TypeKind.PtrPtr
                return 0
            slot = x.cast_ptr_kind
            name = x.ident_ptr
            name_len = x.ident_len
        ExprKind.Call =>
            # `f() -> **S` (AGAST #2544).  The FnDef names S with a `ptr_` per
            # level past two (monomorph's spelling); only a struct answers.
            let fd: *FnDef = sx_call_fn(sm, x)
            if fd == null or fd.return_type != TypeKind.PtrPtr or fd.return_type_name == null
                return 0
            name = fd.return_type_name
            name_len = fd.return_type_name_len
            var extra: i32 = 0
            while name_len > 4 and memcmp(name, c"ptr_", 4 as i64) == 0
                name = name + 4
                name_len = name_len - 4
                extra = extra + 1
            if sema_find_struct(sm, StrView { ptr: (name), len: (name_len) as i64 }) == null
                return 0
            slot = ptr_slot_deepen((TypeKind.Struct as i32), extra)
        _ =>
            return 0
    let levels: i32 = ptr_ptr_slot_levels(slot)
    if levels < 2
        return 0
    let inner: TypeKind = ptr_ptr_slot_inner(slot)
    *out_inner = inner
    if inner == TypeKind.Struct
        if out_name != null
            *out_name = name
        if out_len != null
            *out_len = name_len
    levels

# The scalar T behind `*base` when `base` is a `*T` (a `**T` deref), or VOID.
fn sx_deref_ptr_ptr_elem(sm: *Sema, base: *Expr) -> TypeKind
    if base == null or base.kind != ExprKind.Unary or base.op != OpKind.Deref
        return TypeKind.Void
    var inner: TypeKind = TypeKind.Void
    if sx_ptr_levels_into(sm, base, @inner, null, null) != 1
        return TypeKind.Void
    if inner == TypeKind.Struct or inner == TypeKind.Void
        return TypeKind.Void
    inner

# The scalar T that `(*r)[i]` reads when `*r` is a `*T` (deref_index_elem).
fn sx_deref_index_elem(sm: *Sema, e: *Expr) -> TypeKind
    if e == null or e.kind != ExprKind.Index or e.left == null
        return TypeKind.Void
    if e.right != null and e.right.kind == ExprKind.Range
        return TypeKind.Void
    let t: TypeKind = sx_deref_ptr_ptr_elem(sm, e.left)
    if ty_is_int(t) == 1 or ty_is_float(t) == 1 or t == TypeKind.Bool
        return t
    TypeKind.Void

# The pointee of a member chain `x.f`, as get_member_pointee_type: a
# primitive recording, else u8 for a `*T` field, else i64.
fn sx_member_pointee(sm: *Sema, e: *Expr) -> TypeKind
    let f: *StructField = sx_member_field(sm, e)
    if f == null
        return TypeKind.I64
    if f.field_type != TypeKind.Ptr and f.field_type != TypeKind.Ref and f.field_type != TypeKind.MutRef
        return TypeKind.I64
    let pe: TypeKind = f.array_elem_type
    if ty_is_int(pe) == 1 or ty_is_float(pe) == 1 or pe == TypeKind.Bool
        return pe
    if f.ptr_pointee != TypeKind.Void
        return f.ptr_pointee
    TypeKind.U8

# The T behind `X[i]` with `X` a `**T` (exactly two levels), or VOID.
fn sx_ptr_ptr_index_scalar(sm: *Sema, x: *Expr) -> TypeKind
    if x == null
        return TypeKind.Void
    var inner: TypeKind = TypeKind.Void
    if sx_ptr_levels_into(sm, x, @inner, null, null) != 2
        return TypeKind.Void
    if inner == TypeKind.Struct or inner == TypeKind.Void
        return TypeKind.Void
    inner

# The local `name`'s recorded pointee, as find_local_pointee_type: i64 for
# a miss, and i64 for a scalar `:&` borrow (bound as a plain T local).
fn sx_local_pointee(sm: *Sema, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v == null
        return TypeKind.I64
    if v.kind == TypeKind.Unknown and v.lent != null
        return TypeKind.I64
    if v.pointee != TypeKind.Void
        return v.pointee
    # `let p = pi()` with `pi() -> *i32`: sema_fn_ret_ty records the return
    # name, not the pointee, so read a primitive off it.  A non-primitive name
    # is not taken as a struct: get_expr_type's find_local_pointee_type knows
    # only a recorded pointee, and guessing one made `*(@h)` (h:& **C) a
    # struct deref the emitter could not name.
    let pn: TypeKind = primitive_type_from_name(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
    if pn != TypeKind.Void
        return pn
    TypeKind.I64

# The slot the emitter reads for `e`: the node-local rule first (literals, a
# cast, a comparison, `@` / `@&` / `not` / `~`), then the state-dependent
# arms moved onto Sema (AGAST #4410).  The deref and arithmetic arms recurse
# through this fn, as the emitter's do.
pub fn sema_slot_ty(sm: *Sema, e: *Expr) -> TypeKind
    if e == null
        return TypeKind.Unknown
    let local: TypeKind = expr_local_slot_ty(e)
    if local != TypeKind.Unknown
        return local
    let k: ExprKind = e.kind
    match k
        ExprKind.Ident =>
            return sx_ident_slot_ty(sm, e)
        ExprKind.Unary =>
            if e.op != OpKind.Deref
                return sema_slot_ty(sm, e.operand)   # OpKind.Neg: the operand's slot
            let p: *Expr = e.operand
            if p == null
                return TypeKind.I64
            # A stated scalar pointee: `*(@s as *i8)`, `*@g`, `*((x as *T) + k)`.
            let inl: TypeKind = sx_inline_prim_pointee(sm, p)
            if inl != TypeKind.Void
                return inl
            # AGAST #4249: `*(@a[i] + k)` loads the base's inline pointee.
            if p.kind == ExprKind.Binary and (p.op == OpKind.Add or p.op == OpKind.Sub)
                let bpt: TypeKind = sx_inline_prim_pointee(sm, find_base_expr(p))
                if bpt != TypeKind.Void
                    return bpt
            # `*a[i]` with `a: [N]*T` reads its T; a full-rank `b[i][j]` over an
            # N-D `[N][M]*T` reads its pointer leaf's pointee (array_elem_pointee).
            let el: TypeKind = sx_array_elem_pointee_kind(sm, p)
            if el != TypeKind.Void
                return el
            let eli: TypeKind = sema_index_slot_pointee(sm, p)
            if eli != TypeKind.Void
                return eli
            # `*X[i]` with `X` a `**T` reads its T (AGAST #3186).
            if p.kind == ExprKind.Index and p.right != null and p.right.kind != ExprKind.Range and p.left != null
                let ix: TypeKind = sx_ptr_ptr_index_scalar(sm, p.left)
                if ix != TypeKind.Void
                    return ix
            # `*(ppp + i)` with `ppp: ***T` is itself a `**T` (AGAST #1924).
            var dl_inner: TypeKind = TypeKind.Void
            let dl_levels: i32 = sx_ptr_levels_into(sm, e, @dl_inner, null, null)
            if dl_levels >= 2
                return TypeKind.PtrPtr
            # AGAST #2376: `*a[i]` with `a: [N]**T` (or `*@a[i]` with
            # `a: [N]*T`) is a `*T`, so `**a[i]` reads its T below.  The
            # element itself isn't typed as a `**`.
            if dl_levels == 1 and sx_elem_rooted(p) == 1
                return TypeKind.Ptr
            let inner_type: TypeKind = sema_slot_ty(sm, p)
            match inner_type
                TypeKind.PtrPtr =>
                    return TypeKind.Ptr
                TypeKind.Ptr =>
                    if p.kind == ExprKind.Ident
                        let lpt: TypeKind = sx_local_pointee(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
                        if lpt != TypeKind.I64
                            return lpt
                        let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
                        if g != null
                            return g.pointee_type
                        return lpt
                    if p.kind == ExprKind.Binary
                        let base: *Expr = find_base_expr(p)
                        match base.kind
                            ExprKind.Ident =>
                                let lpt: TypeKind = sx_local_pointee(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                                if lpt != TypeKind.I64
                                    return lpt
                                let g: *GlobalVarDef = sx_find_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                                if g != null
                                    return g.pointee_type
                                return lpt
                            ExprKind.Member =>
                                return sx_member_pointee(sm, base)
                            _ => pass
                        let bd: TypeKind = sx_deref_ptr_ptr_elem(sm, base)
                        if bd != TypeKind.Void
                            return bd
                    if p.kind == ExprKind.Unary
                        let ud: TypeKind = sx_deref_ptr_ptr_elem(sm, p)
                        if ud != TypeKind.Void
                            return ud
                    if p.kind == ExprKind.Member
                        return sx_member_pointee(sm, p)
                    return TypeKind.I64
                _ => pass
            if (inner_type == TypeKind.Ref or inner_type == TypeKind.MutRef) and p.kind == ExprKind.Ident
                let mr: TypeKind = sx_local_pointee(sm, StrView { ptr: (p.ident_ptr), len: (p.ident_len) as i64 })
                if mr != TypeKind.Struct
                    return mr
                return TypeKind.I64
            # `*r.p` with `p: @T` / `@&T`: the emitter rewrites the field to a
            # `*T` after the walk, so its recorded pointee is the read width.
            if (inner_type == TypeKind.Ref or inner_type == TypeKind.MutRef) and p.kind == ExprKind.Member
                return sx_member_pointee(sm, p)
            return TypeKind.I64
        ExprKind.Binary =>
            if op_is_comparison(e.op)
                return TypeKind.I64
            if e.op == OpKind.Add or e.op == OpKind.Sub or e.op == OpKind.Mul or e.op == OpKind.Div or e.op == OpKind.Mod
                # Float arithmetic is computed at binop_float_width: f32 when both
                # sides are f32, or one is f32 and the other a literal; else f64.
                let lk: TypeKind = sema_slot_ty(sm, e.left)
                let rk: TypeKind = sema_slot_ty(sm, e.right)
                var lft: TypeKind = TypeKind.Void
                var rft: TypeKind = TypeKind.Void
                if lk == TypeKind.F32 or lk == TypeKind.F64
                    lft = lk
                if rk == TypeKind.F32 or rk == TypeKind.F64
                    rft = rk
                if lft != TypeKind.Void or rft != TypeKind.Void
                    if lft == TypeKind.F32 and (rft == TypeKind.F32 or is_float_lit_operand(e.right) == 1)
                        return TypeKind.F32
                    if rft == TypeKind.F32 and is_float_lit_operand(e.left) == 1
                        return TypeKind.F32
                    return TypeKind.F64
            return sema_slot_ty(sm, e.left)
        ExprKind.Member =>
            return sx_member_slot_ty(sm, e)
        ExprKind.Index =>
            return sx_index_slot_ty(sm, e)
        ExprKind.Call =>
            return sx_call_slot_ty(sm, e)
        ExprKind.Method =>
            let f: TypeKind = sx_method_float_ty(sm, e)
            if f != TypeKind.Void
                return f
            return TypeKind.I64
        _ => pass
    # A struct literal, an if / match, a try, an array literal: the emitter's
    # final default.
    TypeKind.I64

# AGAST #4410: U when `for x in it` binds a `*U` (an element of a `[N]*U`
# local, global, const or field), else TypeKind.Void.  The emitter's for binding
# records it as LocalVar.pointee_type.
pub fn sema_iter_pointee(sm: *Sema, it: *Expr) -> TypeKind
    if it == null
        return TypeKind.Void
    match it.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 })
            if v != null
                if v.kind == TypeKind.Array and v.elem_pointee != TypeKind.Void
                    return v.elem_pointee
                # A `b:& [N]*T` borrow param binds as an `[N]*T` array local.
                if v.kind == TypeKind.Unknown and v.lent != null and v.lent.param_pointee_type == TypeKind.Array and v.lent.param_pointee_array_elem_pointee != TypeKind.Void
                    return v.lent.param_pointee_array_elem_pointee
                # A Vec / Span of `*U`: its data field's element pointer points at U.
                if v.type_name != null and v.type_name_len > 0 and name_is_indexable(StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 }) == 1
                    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (v.type_name), len: (v.type_name_len) as i64 })
                    if st != null
                        var idx: i32 = find_field_index(st, StrView { ptr: (c"data"), len: (4) as i64 })
                        if idx < 0
                            idx = find_field_index(st, StrView { ptr: (c"ptr"), len: (3) as i64 })
                        if idx >= 0
                            let f: *StructField = get_field_type(st, idx)
                            if ptr_field_elem_kind(f) == TypeKind.Ptr
                                if f.inner_pointee_type != (TypeKind.Void as i32)
                                    return ptr_ptr_slot_inner(f.inner_pointee_type)
                                if f.array_elem_pointee != TypeKind.Void
                                    return f.array_elem_pointee
                            if f.field_type == TypeKind.PtrPtr and f.inner_pointee_type != (TypeKind.Void as i32)
                                return ptr_ptr_slot_inner(f.inner_pointee_type)
                            if f.array_elem_type == TypeKind.Ptr and f.array_elem_pointee != TypeKind.Void
                                return f.array_elem_pointee
                            # A monomorphised `Vec<*T>`'s data field records only
                            # PTR_PTR, but the Vec name spells the element:
                            # `Vec$ptr_i32` / `Vec$ptr_u8`.
                            if f.field_type == TypeKind.PtrPtr and f.inner_pointee_type == (TypeKind.Void as i32) and f.field_type_name_len == 0
                                var d: i32 = 0
                                while d < v.type_name_len and *(v.type_name + d) != '$'
                                    d = d + 1
                                if d + 5 <= v.type_name_len and memcmp(v.type_name + d + 1, c"ptr_", 4 as i64) == 0
                                    let pk: TypeKind = primitive_type_from_name(StrView { ptr: (v.type_name + d + 5), len: (v.type_name_len - d - 5) as i64 })
                                    if pk != TypeKind.Void
                                        return pk
                return TypeKind.Void
            var g: *GlobalVarDef = sm.module.globals
            while g != null
                if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 }) == 1
                    if g.var_type == TypeKind.Array and g.array_elem_pointee != TypeKind.Void
                        return g.array_elem_pointee
                    return TypeKind.Void
                g = g.next
            var ce: *ConstEntry = sm.module.constants
            while ce != null
                if name_eq(StrView { ptr: (ce.name), len: (ce.name_len) as i64 }, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 }) == 1
                    if ce.const_type == TypeKind.Array and ce.array_elem_pointee != TypeKind.Void
                        return ce.array_elem_pointee
                    return TypeKind.Void
                ce = ce.next
            return TypeKind.Void
        ExprKind.Member =>
            if it.left == null
                return TypeKind.Void
            var r: SemaTy
            if sema_expr_ty(sm, it.left, @r) == TypeKind.Unknown
                return TypeKind.Void
            let st: *StructDef = sema_recv_struct(sm, @r)
            if st == null
                return TypeKind.Void
            let idx: i32 = find_field_index(st, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 })
            if idx < 0
                return TypeKind.Void
            let f: *StructField = get_field_type(st, idx)
            if f.field_type == TypeKind.Array and f.array_elem_pointee != TypeKind.Void
                return f.array_elem_pointee
            return TypeKind.Void
        _ => pass
    TypeKind.Void

# AGAST #4410: the element kind `for x in it` binds, or TypeKind.Unknown: the
# shapes sema_elem_ty can't place -- an untyped `let a = [..]`, a `& [N]T`
# borrow param, an array literal, a `[N]T` field.
pub fn sema_iter_elem_slot(sm: *Sema, it: *Expr) -> TypeKind
    if it == null
        return TypeKind.Unknown
    match it.kind
        ExprKind.ArrayLit | ExprKind.ArrayFill =>
            var first: *Expr = it.args
            if it.kind == ExprKind.ArrayFill
                first = it.left
            return expr_sema_ty(first)
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 })
            if v != null
                if v.kind == TypeKind.Array and v.index_elem != TypeKind.Void
                    return v.index_elem
                if v.kind == TypeKind.Unknown and v.let_kind == TypeKind.Array and v.let_elem != TypeKind.Void
                    return v.let_elem
                if v.kind == TypeKind.Unknown and v.lent != null and v.lent.param_pointee_type == TypeKind.Array
                    return v.lent.param_pointee_array_elem_type
                return TypeKind.Unknown
            var g: *GlobalVarDef = sm.module.globals
            while g != null
                if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 }) == 1
                    if g.var_type == TypeKind.Array
                        return g.array_elem_type
                    return TypeKind.Unknown
                g = g.next
            var ce: *ConstEntry = sm.module.constants
            while ce != null
                if name_eq(StrView { ptr: (ce.name), len: (ce.name_len) as i64 }, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 }) == 1
                    if ce.const_type == TypeKind.Array
                        return ce.array_elem_type
                    return TypeKind.Unknown
                ce = ce.next
            return TypeKind.Unknown
        _ => pass
    if it.kind == ExprKind.Member and it.left != null
        var r: SemaTy
        if sema_expr_ty(sm, it.left, @r) != TypeKind.Unknown
            let st: *StructDef = sema_recv_struct(sm, @r)
            if st != null
                let idx: i32 = find_field_index(st, StrView { ptr: (it.ident_ptr), len: (it.ident_len) as i64 })
                if idx >= 0
                    let f: *StructField = get_field_type(st, idx)
                    if f.field_type == TypeKind.Array
                        return f.array_elem_type
        return TypeKind.Unknown
    var t: SemaTy
    let k: TypeKind = sema_elem_ty(sm, it, @t)
    if k != TypeKind.Unknown
        return k
    TypeKind.Unknown

# AGAST #4404 (#1816): note Sema's slot type on the node, for the emitter to
# read instead of re-deriving one from EmitterState.  sema_walk calls this for
# every expression it reaches, in that expression's own scope, so the first
# visit wins: a node is typed where it is written.  AGAST #4410: the whole
# emitter slot rule now lives in sema_slot_ty, so every kind gets one.
pub fn sema_note_expr_ty(sm: *Sema, e: *Expr)
    if e == null or expr_has_sema_ty(e) == 1
        return
    expr_note_sema_ty(e, sema_slot_ty(sm, e))

# AGAST #4404: a global's or const's initialiser is read by the emitter
# outside any fn walk, so annotate those roots too.
pub fn sema_note_module_inits(sm: *Sema)
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        sema_note_expr_ty(sm, g.init_expr)
        g = g.next
    var c: *ConstEntry = sm.module.constants
    while c != null
        sema_note_expr_ty(sm, c.value_expr)
        c = c.next

# LARB R79 (AGAST #4007): `Future` is the built-in "some async fn's future".
# It has no size, so only a reference holds one: every generated
# `<fn>$Future` fits an `@&Future` slot, by reference.  `$` is no identifier
# character, so only the lowering's own names can match (AGAST #3606).
pub fn sema_future_ref_fits(want_name: *u8, want_len: i32, got_name: *u8, got_len: i32) -> i32
    if want_name == null or want_len != 6
        return 0
    if name_eq(StrView { ptr: (want_name), len: (6) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 }) == 0
        return 0
    if got_name == null or got_len <= 7
        return 0
    # `NAME$Future`'s suffix, compared as a StrView: a byte loop here loads
    # the literal at the wrong width when ritz1 compiles itself (#4007).
    if name_eq(StrView { ptr: (got_name + (got_len - 7)), len: (7) as i64 }, StrView { ptr: (c"$Future"), len: (7) as i64 }) == 1
        return 1
    0
