# ritz1/src/sema_type.ritz - Sema's expression typer (AGAST #3501, #1816)
#
# sema_expr_ty types an expression from the AST and Sema's typed scope
# alone, for the checks moving off the emitter (#3502-#3514), which today
# read get_expr_type / LocalVar mid-lowering.  It answers TYPE_UNKNOWN
# rather than guess: a check treats that as bool_check treats BK_UNSURE.
#
# It covers the shapes bool_check needs first: literals, identifiers (locals,
# then globals, then consts), calls (through a local's fn signature, else
# sema_call_fn), comparisons and logical operators, `not` / `-` / `@`, casts,
# member access on a struct or a pointer to one, arithmetic whose operands
# agree, a struct literal (for bool_check, #3502), and an if / match
# expression whose arm the walk typed as a struct (#3042).  And a receiver's
# shapes, which deref_field typed on its own until AGAST #3810: `*p` of a
# pointer to a struct, an element `a[i]` (sema_elem_ty, Sema's one element
# typer: a struct, a scalar, a pointer, or an N-D array's row, #3943 / #4259),
# a method call's result, `E.V(..)` and a `c?`'s Ok / Some struct (#3974).  (A deref step's
# `S_deref(..)` is a call like any other, found by its symbol.)  And what the
# move check typed on its own until AGAST #4251: a unit variant `E.V`, `*p` of
# a pointer to a user enum, `T.f(..)` of a static method, a nameless tuple
# literal (Sema's own `(tuple)N` struct, sema_tuple_ty) and `Some(x)`'s payload
# as a scrutinee (sema_ctor_payload_ty).  Anything else is TYPE_UNKNOWN until
# a check move needs it.
#
# sema_walk binds what it can type with these: sema_elem_ty a `for x in a`
# variable, sema_arm_payload_ty a `V(x)` arm binding, sema_tuple_field_ty a
# `let (a, b)` binding.
#
# A bool is TYPE_BOOL here, where the emitter's LocalVar and get_expr_type say
# TYPE_I64 (its bool slot, #1646).  sema_probe.ritz pins the answers against
# get_expr_type and bool_kind on every expression the emitter lowers
# (RITZ1_SEMA_PROBE=1; ritz0/test_ritz1_sema_type.py).

import ritzlib.sys
import ritzlib.str
import ritzlib.hashmap
import ritzlib.memory

import ast
import types
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema

fn sema_ty_set(t: *SemaTy, kind: i32, name: *u8, name_len: i32, pointee: i32, fn_sig: *FnDef) -> i32
    t.kind = kind
    t.name = name
    t.name_len = name_len
    t.pointee = pointee
    t.fn_sig = fn_sig
    t.shape = null
    kind

fn sema_ty_copy(dst: *SemaTy, src: *SemaTy) -> i32
    sema_ty_set(dst, src.kind, src.name, src.name_len, src.pointee, src.fn_sig)
    dst.shape = src.shape
    dst.kind

fn sema_ty_none(t: *SemaTy) -> i32
    sema_ty_unknown(t)
    TYPE_UNKNOWN

# 1 for a fixed-width integer kind.
pub fn sema_is_int_kind(k: i32) -> i32
    (ty_is_int(k) == 1) as i32

fn sema_is_int_lit(e: *Expr) -> i32
    (e.kind == EXPR_INT_LIT and e.lit_kind == LIT_PLAIN) as i32

# The type of the name `name`: a local, a global or a typed const (AGAST #3755
# reads it for `n[i] = v`, whose target is a name, not an Expr).
pub fn sema_name_ty(sm: *Sema, name: *u8, len: i32, t: *SemaTy) -> i32
    let v: *SemaVar = sema_find_local(sm, name, len)
    if v != null
        if v.kind == TYPE_ARRAY
            sema_arr_ty(t, v.index_elem, v.type_name, v.type_name_len, v.shape)
            t.fn_sig = v.fn_sig
            return TYPE_ARRAY
        return sema_ty_set(t, v.kind, v.type_name, v.type_name_len, v.pointee, v.fn_sig)
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(g.name, g.name_len, name, len) == 1
            if g.var_type == TYPE_ARRAY
                return sema_arr_ty(t, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len, g.array_shape)
            # `var g: *S` names S as its pointee, not its type (AGAST #1554).
            if g.type_name == null and g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT
                return sema_ty_set(t, g.var_type, g.pointee_type_name, g.pointee_type_name_len, g.pointee_type, null)
            return sema_ty_set(t, g.var_type, g.type_name, g.type_name_len, g.pointee_type, null)
        g = g.next
    # A const's own type, where its value was folded: an untyped `const N = 4`
    # and a float const are left to the emitter's folding.
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(c.name, c.name_len, name, len) == 1
            if sema_is_int_kind(c.const_type) == 1 or c.const_type == TYPE_BOOL
                return sema_ty_set(t, c.const_type, null, 0, TYPE_VOID, null)
            return sema_ty_none(t)
        c = c.next
    sema_ty_none(t)

fn sema_fn_ret_ty(fd: *FnDef, t: *SemaTy) -> i32
    if fd.return_type == TYPE_VOID
        return sema_ty_none(t)
    sema_ty_set(t, fd.return_type, fd.return_type_name, fd.return_type_name_len, TYPE_VOID, fd.ret_fn_sig)

fn sema_call_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.func_name_len == 0
        return sema_ty_none(t)
    # AGAST #3995: a user-enum variant ctor `One(3)` builds its enum, ahead
    # of a local or fn of that name (emit_expr_call's order).
    var en: *u8 = null
    var en_len: i32 = 0
    user_enum_ctor_call(e, @en, @en_len)
    if en != null
        return sema_ty_set(t, TYPE_STRUCT, en, en_len, TYPE_VOID, null)
    # A call through a local is its signature's, never a fn of that name.
    let v: *SemaVar = sema_find_local(sm, e.func_name, e.func_name_len)
    if v != null
        if v.fn_sig != null
            return sema_fn_ret_ty(v.fn_sig, t)
        return sema_ty_none(t)
    if mem_builtin_id(e.func_name, e.func_name_len) != 0
        return sema_ty_none(t)
    let fd: *FnDef = sema_call_fn(sm, e)
    if fd == null
        return sema_ty_none(t)
    sema_fn_ret_ty(fd, t)

fn sema_is_ptr_kind(k: i32) -> i32
    (k == TYPE_PTR or k == TYPE_REF or k == TYPE_MUT_REF) as i32

# `x`, when it names a (non-generic) user enum and no local; else null.
pub fn sema_enum_name(sm: *Sema, x: *Expr) -> *Expr
    if x == null or x.kind != EXPR_IDENT or sema_find_local(sm, x.ident_ptr, x.ident_len) != null
        return null
    if user_enum_index(x.ident_ptr, x.ident_len) < 0
        return null
    x

# The struct a receiver of kind `r` is, or points at.  A fn's `-> @T` keeps no
# pointee kind: its name says it is a struct.
pub fn sema_recv_struct(sm: *Sema, r: *SemaTy) -> *StructDef
    if r.kind == TYPE_STRUCT
        # A nameless tuple's (AGAST #4251): `p.0`, `let (a, b) = p`.
        let tup: *StructDef = sema_tuple_struct(r.name, r.name_len)
        if tup != null
            return tup
        return sema_find_struct(sm, r.name, r.name_len)
    if sema_is_ptr_kind(r.kind) == 1
        if r.pointee == TYPE_STRUCT or r.pointee == TYPE_VOID
            return sema_find_struct(sm, r.name, r.name_len)
    null

fn sema_member_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.left == null
        return sema_ty_none(t)
    # AGAST #4251: `E.V`, a user enum's unit variant, builds the enum E.
    let en: *Expr = sema_enum_name(sm, e.left)
    if en != null and enum_variant_index(en.ident_ptr, en.ident_len, e.ident_ptr, e.ident_len) >= 0
        return sema_ty_set(t, TYPE_STRUCT, en.ident_ptr, en.ident_len, TYPE_VOID, null)
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @r) == TYPE_UNKNOWN
        # AGAST #3824: `K.f` on `const K: StrView = "..."`, a `%S` global the
        # emitter reads fields out of; `let q = K.ptr + 1` typed nothing.
        # Only the field: a bare `K` stays unknown, as the emitter's
        # get_expr_type has it as i64.
        let ce: *ConstEntry = sema_struct_const(sm, e.left)
        if ce == null
            return sema_ty_none(t)
        sema_ty_set(@r, TYPE_STRUCT, ce.type_name, ce.type_name_len, TYPE_VOID, null)
    sema_field_ty(sm, @r, e.ident_ptr, e.ident_len, t)

# AGAST #3824: the const `id` names, if it is a string-initialised struct
# const (emitter_core's struct_const_global, over Sema's module); else null.
fn sema_struct_const(sm: *Sema, id: *Expr) -> *ConstEntry
    if id == null or id.kind != EXPR_IDENT
        return null
    if sema_find_local(sm, id.ident_ptr, id.ident_len) != null
        return null
    var c: *ConstEntry = sm.module.constants
    while c != null
        if name_eq(c.name, c.name_len, id.ident_ptr, id.ident_len) == 1
            if c.const_type == TYPE_STRUCT and c.type_name_len > 0 and c.value_expr != null and c.value_expr.kind == EXPR_STRING_LIT
                return c
            return null
        c = c.next
    null

# The type of field `name` of `r`, a struct or a pointer or reference to one
# (AGAST #3799 reads it for `s.f[i] = v`, whose target is a field name).
pub fn sema_field_ty(sm: *Sema, r: *SemaTy, name: *u8, len: i32, t: *SemaTy) -> i32
    if r.kind == TYPE_UNKNOWN
        return sema_ty_none(t)
    let st: *StructDef = sema_recv_struct(sm, r)
    if st == null
        return sema_ty_none(t)
    let idx: i32 = find_field_index(st, name, len)
    if idx < 0
        return sema_ty_none(t)
    let f: *StructField = get_field_type(st, idx)
    if f.field_type == TYPE_ARRAY
        return sema_arr_ty(t, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, f.array_shape)
    var pointee: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        pointee = f.ptr_pointee
    sema_ty_set(t, f.field_type, f.field_type_name, f.field_type_name_len, pointee, f.fn_sig)

# `a op b` for an arithmetic or bitwise op: the operands' type when they
# agree, an integer literal taking the other side's integer type, f32 with
# f64 the f64, and
# `p + n` / `p - n` a pointer.  Anything else is unknown.
fn sema_arith_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    var l: SemaTy
    var r: SemaTy
    if sema_expr_ty(sm, e.left, @l) == TYPE_UNKNOWN
        return sema_ty_none(t)
    if sema_expr_ty(sm, e.right, @r) == TYPE_UNKNOWN
        return sema_ty_none(t)
    if l.kind == TYPE_PTR and (e.op == OP_ADD or e.op == OP_SUB) and sema_is_int_kind(r.kind) == 1
        return sema_ty_copy(t, @l)
    if sema_is_int_kind(l.kind) == 1 and sema_is_int_lit(e.right) == 1
        return sema_ty_copy(t, @l)
    if (l.kind == TYPE_F32 or l.kind == TYPE_F64) and (r.kind == TYPE_F32 or r.kind == TYPE_F64)
        # A float literal takes the other side's width; an f32 meeting an f64
        # widens to it (LANGUAGE_SPEC §7.1, AGAST #3607), as binop_float_width.
        if is_float_lit_operand(e.right) == 1
            return sema_ty_copy(t, @l)
        if is_float_lit_operand(e.left) == 1
            return sema_ty_copy(t, @r)
        if l.kind != r.kind
            return sema_ty_set(t, TYPE_F64, null, 0, TYPE_VOID, null)
    if l.kind == r.kind and (sema_is_int_kind(l.kind) == 1 or l.kind == TYPE_F32 or l.kind == TYPE_F64)
        return sema_ty_copy(t, @l)
    sema_ty_none(t)

fn sema_unary_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.op == OP_NOT
        return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
    if e.op == OP_NEG
        var o: SemaTy
        let k: i32 = sema_expr_ty(sm, e.operand, @o)
        if sema_is_int_kind(k) == 1 or k == TYPE_F32 or k == TYPE_F64
            return sema_ty_copy(t, @o)
        return sema_ty_none(t)
    if e.op == OP_ADDR or e.op == OP_ADDR_MUT
        # The pointer the emitter makes of it: `@x` a TYPE_PTR, `@&x` a
        # TYPE_MUT_REF, to x's type.
        var kind: i32 = TYPE_PTR
        if e.op == OP_ADDR_MUT
            kind = TYPE_MUT_REF
        var o: SemaTy
        let ok: i32 = sema_expr_ty(sm, e.operand, @o)
        if ok == TYPE_UNKNOWN or ok == TYPE_PTR or ok == TYPE_PTR_PTR or ok == TYPE_REF or ok == TYPE_MUT_REF or ok == TYPE_ARRAY
            return sema_ty_set(t, kind, null, 0, TYPE_VOID, null)
        return sema_ty_set(t, kind, o.name, o.name_len, ok, null)
    if e.op == OP_DEREF
        # `*p` of a pointer or reference to a struct: the struct.
        var o: SemaTy
        sema_expr_ty(sm, e.operand, @o)
        if sema_is_ptr_kind(o.kind) == 1 and sema_recv_struct(sm, @o) != null
            return sema_ty_set(t, TYPE_STRUCT, o.name, o.name_len, TYPE_VOID, null)
        # AGAST #4251: or to a user enum (`match *p` of a `p: *E`).
        if sema_is_ptr_kind(o.kind) == 1 and (o.pointee == TYPE_STRUCT or o.pointee == TYPE_VOID) and user_enum_index(o.name, o.name_len) >= 0
            return sema_ty_set(t, TYPE_STRUCT, o.name, o.name_len, TYPE_VOID, null)
    sema_ty_none(t)

# --- One element typer: what `x[i]` is (AGAST #3810, #3943, #4259) ----------
#
# `x[i]`, and what `for x in b` binds, is typed here and nowhere else on Sema:
# sema_expr_ty, ref_check's rs_ty (whose steps read sema_arr_elem), the slot
# rules' sema_named_elem / sema_index_slot and let_check's let_through_elem
# (sema_buffer_ty) all take their element from it.
#
# An array is typed by its element: kind TYPE_ARRAY, pointee the element's
# kind (the leaf T of an N-D `[N][M]..T`), name the leaf's struct, shape its N-D
# shape (null for one dimension).  An N-D array's `x[i]` is a row, one
# dimension fewer (#2555), and only the full-rank `x[i][j]..` is its leaf T.

# `t`, an array of `elem` (its struct `name`), of N-D `shape` or null.  An N-D
# array's element is its leaf (a parsed `[N][M]T` says TYPE_ARRAY there).
pub fn sema_arr_ty(t: *SemaTy, elem: i32, name: *u8, len: i32, shape: *ArrayShape) -> i32
    if shape != null and shape.rank >= 2
        sema_ty_set(t, TYPE_ARRAY, shape.leaf_name, shape.leaf_name_len, shape.leaf_type, null)
        t.shape = shape
        return TYPE_ARRAY
    sema_ty_set(t, TYPE_ARRAY, name, len, elem, null)

# `a[i]` of the array `a`, typed as above: a row of an N-D array, else its
# element (a struct, a scalar, or a pointer, to the struct its name says).
# Unknown when the element isn't known.
pub fn sema_arr_elem(a: *SemaTy, t: *SemaTy) -> i32
    let sh: *ArrayShape = a.shape
    if sh != null and sh.rank >= 2
        var row: *ArrayShape = null
        if sh.rank > 2
            row = nd_shape_from(sh, 1)
        return sema_arr_ty(t, sh.leaf_type, sh.leaf_name, sh.leaf_name_len, row)
    let k: i32 = a.pointee
    if k == TYPE_VOID or k == TYPE_UNKNOWN or k == TYPE_PTR_PTR
        return sema_ty_none(t)
    if k == TYPE_ARRAY
        # A row Sema has no shape for: an array, of what it can't say.
        return sema_ty_set(t, TYPE_ARRAY, a.name, a.name_len, TYPE_VOID, null)
    if sema_is_ptr_kind(k) == 1 and a.name_len > 0
        return sema_ty_set(t, k, a.name, a.name_len, TYPE_STRUCT, null)
    sema_ty_set(t, k, a.name, a.name_len, TYPE_VOID, null)

# The element of a Vec, Span or String, or of what a pointer or reference to
# one points at, `bt`: its kind (a String's bytes are u8, a Vec's or Span's
# what its `data` / `ptr` field points at) and struct name.  Unknown for
# anything else.  through_named_elem's sees_through / indexes_itself.
pub fn sema_buffer_ty(sm: *Sema, bt: *SemaTy, t: *SemaTy) -> i32
    let kind: i32 = bt.kind
    if kind != TYPE_STRUCT and (sema_is_ptr_kind(kind) == 0 or bt.pointee != TYPE_STRUCT)
        return sema_ty_none(t)
    if name_is_indexable(bt.name, bt.name_len) == 0
        return sema_ty_none(t)
    if name_eq(bt.name, bt.name_len, c"String", 6) == 1
        return sema_ty_set(t, TYPE_U8, null, 0, TYPE_VOID, null)
    let st: *StructDef = sema_find_struct(sm, bt.name, bt.name_len)
    if st == null
        return sema_ty_none(t)
    var idx: i32 = find_field_index(st, c"data", 4)
    if idx < 0
        idx = find_field_index(st, c"ptr", 3)
    if idx < 0
        return sema_ty_none(t)
    let f: *StructField = get_field_type(st, idx)
    sema_ty_set(t, ptr_field_elem_kind(f), f.field_type_name, f.field_type_name_len, TYPE_VOID, null)

# The element of `b` (`b[i]`, or what `for x in b` binds): of an array local,
# global or field (a row of an N-D one), of the `[N]T` a `*[N]T` local's view
# reads, of a Vec, Span or String (or a pointer to one), or what a `*T` points
# at.  Unknown for any other.
pub fn sema_elem_ty(sm: *Sema, b: *Expr, t: *SemaTy) -> i32
    if b == null
        return sema_ty_none(t)
    var bt: SemaTy
    sema_expr_ty(sm, b, @bt)
    if bt.kind == TYPE_ARRAY
        return sema_arr_elem(@bt, t)
    if b.kind == EXPR_IDENT
        # A `*[N]T` (`@[N]T`, `@&[N]T`): its `[N]T`'s element.
        let v: *SemaVar = sema_find_local(sm, b.ident_ptr, b.ident_len)
        if v != null and sema_is_ptr_kind(v.kind) == 1 and v.index_elem != TYPE_VOID
            var a: SemaTy
            sema_arr_ty(@a, v.index_elem, v.type_name, v.type_name_len, v.shape)
            return sema_arr_elem(@a, t)
    if sema_buffer_ty(sm, @bt, t) != TYPE_UNKNOWN
        return t.kind
    if sema_is_ptr_kind(bt.kind) == 1 and bt.pointee == TYPE_STRUCT and bt.name_len > 0
        return sema_ty_set(t, TYPE_STRUCT, bt.name, bt.name_len, TYPE_VOID, null)
    # A `*T` buffer of scalars: an `@T` is one value (index_refuse refuses it).
    if bt.kind == TYPE_PTR and primitive_name_len(bt.pointee) > 0
        return sema_ty_set(t, bt.pointee, null, 0, TYPE_VOID, null)
    sema_ty_none(t)

fn sema_index_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e.right != null and e.right.kind == EXPR_RANGE
        return sema_ty_none(t)
    sema_elem_ty(sm, e.left, t)

# `x.m(..)`: the method's result, on a struct or a pointer to one; `E.V(..)`
# builds the enum E.
fn sema_method_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    let el: *Expr = e.left
    if el == null
        return sema_ty_none(t)
    if sema_enum_name(sm, el) != null
        return sema_ty_set(t, TYPE_STRUCT, el.ident_ptr, el.ident_len, TYPE_VOID, null)
    var r: SemaTy
    sema_expr_ty(sm, el, @r)
    var st: *StructDef = sema_recv_struct(sm, @r)
    if st == null and el.kind == EXPR_IDENT and r.kind == TYPE_UNKNOWN and sema_find_local(sm, el.ident_ptr, el.ident_len) == null
        # AGAST #4251: `T.f(..)`, a static method of the struct T.
        st = sema_find_struct(sm, el.ident_ptr, el.ident_len)
    if st == null
        return sema_ty_none(t)
    let fd: *FnDef = sema_method_fn(sm, st.name, st.name_len, e.ident_ptr, e.ident_len)
    if fd == null
        return sema_ty_none(t)
    sema_fn_ret_ty(fd, t)

fn sema_struct_ty(st: *StructDef, t: *SemaTy) -> i32
    if st == null
        return sema_ty_none(t)
    sema_ty_set(t, TYPE_STRUCT, st.name, st.name_len, TYPE_VOID, null)

# The struct named `name`, unless it is a generic's template: a monomorphised
# name (`Span$u8`) never names one, so `Result$Span$u8$i32` splits after `u8`.
fn sema_find_concrete(sm: *Sema, name: *u8, len: i32) -> *StructDef
    let st: *StructDef = sema_find_struct(sm, name, len)
    if st != null and st.type_params != null
        return null
    st

# The struct an `Option$S` carries in Some, or a `Result$S$E` in Ok / Err (its
# shortest `$`-split naming structs on both sides is taken); null otherwise.
pub fn sema_tagged_payload(sm: *Sema, name: *u8, len: i32, is_err: i32) -> *StructDef
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(name, d, c"Option", 6) == 1
        if is_err == 1
            return null
        return sema_find_concrete(sm, sfx, sfx_len)
    if name_eq(name, d, c"Result", 6) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            let ok: *StructDef = sema_find_concrete(sm, sfx, cut)
            if ok != null or cut + 1 < sfx_len
                if is_err == 0 and ok != null
                    return ok
                if is_err == 1
                    let er: *StructDef = sema_find_concrete(sm, sfx + cut + 1, sfx_len - cut - 1)
                    if er != null
                        return er
        cut += 1
    null

# AGAST #4265: the user enum (`Errno`, a local `enum E2`) an `Option$E` /
# `Result$T$E` carries in Some / Ok (is_err 0) or Err (1), as a slice of `name`
# into `out_len`; null if that payload is no (non-generic) user enum.  A
# Result's split is the first `$` with a user enum on the side wanted.
fn sema_tagged_enum_payload(name: *u8, len: i32, is_err: i32, out_len: *i32) -> *u8
    *out_len = 0
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(name, d, c"Option", 6) == 1
        if is_err == 1 or user_enum_index(sfx, sfx_len) < 0
            return null
        *out_len = sfx_len
        return sfx
    if name_eq(name, d, c"Result", 6) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            if is_err == 0 and user_enum_index(sfx, cut) >= 0
                *out_len = cut
                return sfx
            if is_err == 1 and user_enum_index(sfx + cut + 1, sfx_len - cut - 1) >= 0
                *out_len = sfx_len - cut - 1
                return sfx + cut + 1
        cut += 1
    null

# A match arm's binding `V(x)` on `scrut`: V's payload.  Unknown for a
# catch-all name, as the emitter left it: a `match` on a struct value is
# refused (by ritz0 too), and typing one only lets `.` reach unlowerable IR.
pub fn sema_arm_payload_ty(sm: *Sema, arm: *MatchArm, scrut: *Expr, t: *SemaTy) -> i32
    if scrut == null or arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT
        return sema_ty_none(t)
    var s: SemaTy
    sema_expr_ty(sm, scrut, @s)
    if s.kind == TYPE_UNKNOWN
        return sema_ctor_payload_ty(sm, arm, scrut, t)
    if s.name == null or s.name_len <= 0
        return sema_ty_none(t)
    if is_tagged_enum_type(s.name, s.name_len) == 1
        var is_err: i32 = 0
        if name_eq(arm.pattern_name, arm.pattern_name_len, c"Err", 3) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"None", 4) == 1
            is_err = 1
        let st: *StructDef = sema_tagged_payload(sm, s.name, s.name_len, is_err)
        if st != null
            return sema_struct_ty(st, t)
        # AGAST #4265: a user-enum payload is that enum, as a `let x: E` is.
        var en_len: i32 = 0
        let en: *u8 = sema_tagged_enum_payload(s.name, s.name_len, is_err, @en_len)
        if en != null
            return sema_ty_set(t, TYPE_STRUCT, en, en_len, TYPE_VOID, null)
        return sema_ty_none(t)
    if user_enum_index(s.name, s.name_len) >= 0
        let uf: *StructField = user_enum_tuple_field(s.name, s.name_len, arm_variant_sel(s.name, s.name_len, arm))
        # A u64 payload stays unknown: the emitter binds it as an i64 local
        # (its u64 is kept for the lossy-conversion check alone).
        if uf != null and uf.field_type != TYPE_U64
            var pointee: i32 = TYPE_VOID
            if uf.field_type == TYPE_PTR
                pointee = uf.ptr_pointee
            return sema_ty_set(t, uf.field_type, uf.field_type_name, uf.field_type_name_len, pointee, uf.fn_sig)
    sema_ty_none(t)

# AGAST #4251: `match Some(x)` / `Ok(x)` / `Err(x)`, the enum the emitter
# resolves from the arms: the arm of the constructor's own variant binds x,
# when x is a struct.  Unknown otherwise.
fn sema_ctor_payload_ty(sm: *Sema, arm: *MatchArm, scrut: *Expr, t: *SemaTy) -> i32
    if scrut.kind != EXPR_CALL or scrut.args == null or scrut.args.next != null
        return sema_ty_none(t)
    let n: *u8 = scrut.func_name
    let l: i32 = scrut.func_name_len
    if name_eq(n, l, c"Some", 4) == 0 and name_eq(n, l, c"Ok", 2) == 0 and name_eq(n, l, c"Err", 3) == 0
        return sema_ty_none(t)
    if name_eq(arm.pattern_name, arm.pattern_name_len, n, l) == 0
        return sema_ty_none(t)
    var x: SemaTy
    sema_expr_ty(sm, scrut.args, @x)
    if x.kind != TYPE_STRUCT or x.name == null or x.name_len <= 0
        return sema_ty_none(t)
    sema_ty_copy(t, @x)

# `c?`: the struct c's Result<T, E> carries in Ok, or its Option<T> in Some
# (AGAST #3974: `let x = f()?` bound x untyped).  Unknown for any other
# payload, as the emitter's `?` var-decl path types only a struct one.
fn sema_try_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    var c: SemaTy
    sema_expr_ty(sm, e.left, @c)
    if c.kind != TYPE_STRUCT or c.name == null or c.name_len <= 0
        return sema_ty_none(t)
    sema_struct_ty(sema_tagged_payload(sm, c.name, c.name_len, 0), t)

# Field `i` of the tuple struct `tup` (a `let (a, b, ..)`'s initialiser's type).
pub fn sema_tuple_field_ty(sm: *Sema, tup: *SemaTy, i: i32, t: *SemaTy) -> i32
    let st: *StructDef = sema_recv_struct(sm, tup)
    if st == null
        return sema_ty_none(t)
    var f: *StructField = st.fields
    var k: i32 = 0
    while f != null and k < i
        f = f.next
        k += 1
    if f == null
        return sema_ty_none(t)
    var pointee: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        pointee = f.ptr_pointee
    sema_ty_set(t, f.field_type, f.field_type_name, f.field_type_name_len, pointee, f.fn_sig)

# AGAST #4251: a nameless tuple literal `(a, b, ..)` is a struct of its
# elements, which Sema makes once per literal (sema_tuple_new): a struct
# element is that struct, any other is left unknown.
var g_sema_tuple_of: HashMapI64
var g_sema_tuple_of_ready: i32 = 0

fn sema_tuple_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    var fi: *FieldInit = e.args as *FieldInit
    if fi == null or fi.name_len != 1 or *fi.name != '0'
        return sema_ty_set(t, TYPE_STRUCT, null, 0, TYPE_VOID, null)
    if g_sema_tuple_of_ready == 0
        g_sema_tuple_of = hashmap_i64_with_cap(256)
        g_sema_tuple_of_ready = 1
    var st: *StructDef = hashmap_i64_get(@g_sema_tuple_of, e as i64) as *StructDef
    if st == null
        var first: *StructField = null
        var last: *StructField = null
        while fi != null
            let f: *StructField = calloc(1, sizeof(StructField)) as *StructField
            f.name = fi.name
            f.name_len = fi.name_len
            f.field_type = TYPE_UNKNOWN
            f.inner_pointee_type = TYPE_VOID
            var x: SemaTy
            sema_expr_ty(sm, fi.value, @x)
            if x.kind == TYPE_STRUCT and x.name != null and x.name_len > 0
                f.field_type = TYPE_STRUCT
                f.field_type_name = x.name
                f.field_type_name_len = x.name_len
            if last == null
                first = f
            else
                last.next = f
            last = f
            fi = fi.next
        st = sema_tuple_new(first)
        hashmap_i64_insert(@&g_sema_tuple_of, e as i64, st as i64)
    sema_ty_set(t, TYPE_STRUCT, st.name, st.name_len, TYPE_VOID, null)

# The type of `e` into `t`, returning its kind; TYPE_UNKNOWN when Sema can't
# say.  `e` may be null.
pub fn sema_expr_ty(sm: *Sema, e: *Expr, t: *SemaTy) -> i32
    if e == null
        return sema_ty_none(t)
    let k: i32 = e.kind
    if k == EXPR_INT_LIT
        if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
            return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
        if e.lit_kind == LIT_PLAIN
            return sema_ty_set(t, TYPE_I64, null, 0, TYPE_VOID, null)
        return sema_ty_none(t)
    if k == EXPR_CHAR_LIT
        return sema_ty_set(t, TYPE_U8, null, 0, TYPE_VOID, null)
    if k == EXPR_FLOAT_LIT
        return sema_ty_set(t, TYPE_F64, null, 0, TYPE_VOID, null)
    if k == EXPR_NIL_LIT
        return sema_ty_set(t, TYPE_PTR, null, 0, TYPE_VOID, null)
    if k == EXPR_CSTRING_LIT
        return sema_ty_set(t, TYPE_PTR, null, 0, TYPE_U8, null)
    if k == EXPR_STRING_LIT
        return sema_ty_set(t, TYPE_STRUCT, c"StrView", 7, TYPE_VOID, null)
    if k == EXPR_STRUCT_LIT
        if e.ident_len == 0
            return sema_tuple_ty(sm, e, t)
        return sema_ty_set(t, TYPE_STRUCT, e.ident_ptr, e.ident_len, TYPE_VOID, null)
    if k == EXPR_IDENT
        return sema_name_ty(sm, e.ident_ptr, e.ident_len, t)
    if k == EXPR_BINARY
        if e.op >= OP_EQ and e.op <= OP_OR
            return sema_ty_set(t, TYPE_BOOL, null, 0, TYPE_VOID, null)
        return sema_arith_ty(sm, e, t)
    if k == EXPR_UNARY
        return sema_unary_ty(sm, e, t)
    if k == EXPR_CAST
        return sema_ty_set(t, e.op, e.ident_ptr, e.ident_len, e.int_val as i32, e.fn_sig)
    if k == EXPR_CALL
        return sema_call_ty(sm, e, t)
    if k == EXPR_MEMBER
        return sema_member_ty(sm, e, t)
    if (k == EXPR_IF or k == EXPR_MATCH) and e.value_ty_name != null
        # AGAST #3042: the struct its first typed arm yields, which the walk
        # notes as it leaves that arm (sema_note_arm_value); unknown before.
        return sema_ty_set(t, TYPE_STRUCT, e.value_ty_name, e.value_ty_name_len, TYPE_VOID, null)
    if k == EXPR_INDEX
        return sema_index_ty(sm, e, t)
    if k == EXPR_METHOD
        return sema_method_ty(sm, e, t)
    if k == EXPR_TRY
        return sema_try_ty(sm, e, t)
    sema_ty_none(t)

# The kind of `e`: a TYPE_*, or TYPE_UNKNOWN.
pub fn sema_expr_type(sm: *Sema, e: *Expr) -> i32
    var t: SemaTy
    sema_expr_ty(sm, e, @t)

# ---- What `x[i]` holds (AGAST #3510, #1816) ----
#
# index_through.ritz lowers `[]` through a pointer or reference (#2440), and
# the emitter's checks asked it, mid-lowering, what such an element is
# (through_elem_kind, through_named_elem).  That is a type fact, not codegen:
# Sema answers it here, from its typed scope, for the slot rules that moved
# onto it (literal_slot.ritz).  index_through keeps the lowering (the view it
# spills, the `*(p.data + i)` it fills).
#
# An element is described as a slot is: a TYPE_* kind and, for a pointer, its
# pointee.  TYPE_VOID means "not an element Sema can name": the slot rules
# then say nothing, as they did when the emitter couldn't type the target.
#
# SemaVar.index_elem is the element of a declared `[N]T` local or param, or of the
# `[N]T` a `*[N]T` / `@[N]T` / `@&[N]T` one points at (sema_index_note_*):
# the emitter's LocalVar.array_elem_type and its `p#` view (#2330).

fn sx_starts(name: *u8, len: i32, prefix: *u8, prefix_len: i32) -> i32
    if len <= prefix_len
        return 0
    (memcmp(name, prefix, prefix_len as i64) == 0) as i32

# 1 when a struct of this name indexes: a Vec, Span or String (#2440, #2442).
pub fn name_is_indexable(name: *u8, len: i32) -> i32
    if name == null
        return 0
    if sx_starts(name, len, c"Vec$", 4) == 1 or sx_starts(name, len, c"Span$", 5) == 1
        return 1
    name_eq(name, len, c"String", 6)

# The element kind of a Vec, Span or String named `name`, as through_elem_kind
# answers for one: a String's bytes are u8, a Vec's or Span's the pointee of its
# `data` / `ptr` field.  TYPE_UNKNOWN when the struct or field isn't found.
pub fn sema_buffer_elem(sm: *Sema, name: *u8, len: i32) -> i32
    var bt: SemaTy
    sema_ty_set(@bt, TYPE_STRUCT, name, len, TYPE_VOID, null)
    var t: SemaTy
    sema_buffer_ty(sm, @bt, @t)

# The element kind of `v[i]` when `v`, of kind `kind` (pointing at `pointee`,
# naming `name`), is a Vec, Span or String or one level of pointer or
# reference to one; else TYPE_VOID.  through_named_elem's sees_through /
# indexes_itself.
pub fn sema_through_elem(sm: *Sema, kind: i32, pointee: i32, name: *u8, len: i32) -> i32
    if kind != TYPE_STRUCT
        if kind != TYPE_PTR and kind != TYPE_REF and kind != TYPE_MUT_REF
            return TYPE_VOID
        if pointee != TYPE_STRUCT
            return TYPE_VOID
    if name_is_indexable(name, len) == 0
        return TYPE_VOID
    sema_buffer_elem(sm, name, len)

# 1 when an array of `elem` named `name` gets the emitter's `p#` view
# (add_array_view's array_view_elem_ok): a scalar, a pointer, or a known struct.
pub fn sx_view_elem_ok(sm: *Sema, elem: i32, name: *u8, len: i32) -> i32
    if elem == TYPE_STRUCT
        return (len > 0 and sema_find_struct(sm, name, len) != null) as i32
    if elem == TYPE_PTR
        return 1
    if elem == TYPE_PTR_PTR or elem == TYPE_VOID or elem == TYPE_UNKNOWN or elem == TYPE_ARRAY
        return 0
    (primitive_name_len(elem) > 0) as i32

# T of the `[N]T` the `*[N]T` / `@[N]T` / `@&[N]T` local or param `v` points at,
# when the emitter gives it a `p#` view (add_array_view); TYPE_VOID otherwise.
#
# A pointer to an N-D array is a plane pointer (#2570), whose `p[i]` is a row:
# it has no view (AGAST #4259).
pub fn sema_view_elem(sm: *Sema, v: *SemaVar) -> i32
    if v.kind != TYPE_PTR and v.kind != TYPE_REF and v.kind != TYPE_MUT_REF
        return TYPE_VOID
    if v.shape != null and v.shape.rank >= 2
        return TYPE_VOID
    if v.index_elem == TYPE_VOID or sx_view_elem_ok(sm, v.index_elem, v.type_name, v.type_name_len) == 0
        return TYPE_VOID
    v.index_elem

# The slot `name[i]` is, for a local or global `name`: through a Vec, Span,
# String or `*[N]T` (#2440, #2330), an element of a `[N]T`, or what a `*T`
# points at.  The emitter's lit_into_element.
pub fn sema_named_elem(sm: *Sema, name: *u8, len: i32, kind: *i32, pointee: *i32)
    *kind = TYPE_VOID
    *pointee = TYPE_VOID
    let v: *SemaVar = sema_find_local(sm, name, len)
    if v != null
        let k: i32 = v.kind
        let view: i32 = sema_view_elem(sm, v)
        if view != TYPE_VOID
            *kind = view
            return
        let through: i32 = sema_through_elem(sm, k, v.pointee, v.type_name, v.type_name_len)
        if through != TYPE_VOID
            *kind = through
            return
        if k == TYPE_ARRAY
            *kind = v.index_elem
            *pointee = v.elem_pointee
        else if k == TYPE_PTR
            *kind = v.pointee
        return
    var g: *GlobalVarDef = sm.module.globals
    while g != null
        if name_eq(g.name, g.name_len, name, len) == 1
            if g.var_type == TYPE_ARRAY
                *kind = g.array_elem_type
                *pointee = g.array_elem_pointee
            return
        g = g.next

# The slot an index target `e` (an EXPR_INDEX) is, as the emitter's
# lit_into_target typed it: `a[i][j]` over an `a: [N]*T` (#2332), an index
# through a Vec, Span or String (#2440), `name[i]`, `x.f[i]` over an array
# field.  A slice is no slot.
pub fn sema_index_slot(sm: *Sema, e: *Expr, kind: *i32, pointee: *i32)
    *kind = TYPE_VOID
    *pointee = TYPE_VOID
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.right == null or e.right.kind == EXPR_RANGE
        return
    let base: *Expr = e.left
    if base.kind == EXPR_INDEX and base.left != null and base.left.kind == EXPR_IDENT
        # `a[i][j]`: an `a: [N]*T` element is a pointer, indexed at T (#2332).
        let av: *SemaVar = sema_find_local(sm, base.left.ident_ptr, base.left.ident_len)
        if av != null and av.kind == TYPE_ARRAY and av.index_elem == TYPE_PTR and av.elem_pointee != TYPE_VOID
            *kind = av.elem_pointee
            return
        # `v[i][j]` with `v[i]` itself a Vec, Span or String (#2442).
        if av != null and av.kind != TYPE_ARRAY
            let outer: i32 = sema_through_elem(sm, av.kind, av.pointee, av.type_name, av.type_name_len)
            if outer == TYPE_STRUCT
                sx_struct_elem_slot(sm, av, kind)
        return
    if base.kind == EXPR_UNARY and base.op == OP_DEREF and base.operand != null and base.operand.kind == EXPR_IDENT
        # `(*p)[i]` with `p` a pointer to a Vec, Span or String, or to a `[N]T`.
        let pv: *SemaVar = sema_find_local(sm, base.operand.ident_ptr, base.operand.ident_len)
        if pv == null or pv.kind == TYPE_STRUCT
            return
        if pv.index_elem != TYPE_VOID and sx_view_elem_ok(sm, pv.index_elem, pv.type_name, pv.type_name_len) == 1
            *kind = pv.index_elem
            return
        *kind = sema_through_elem(sm, pv.kind, pv.pointee, pv.type_name, pv.type_name_len)
        return
    if base.kind == EXPR_IDENT
        sema_named_elem(sm, base.ident_ptr, base.ident_len, kind, pointee)
        return
    if base.kind == EXPR_MEMBER
        var r: SemaTy
        if sema_expr_ty(sm, base.left, @r) == TYPE_UNKNOWN
            return
        let st: *StructDef = sx_recv_struct(sm, @r)
        if st == null
            return
        let idx: i32 = find_field_index(st, base.ident_ptr, base.ident_len)
        if idx < 0
            return
        sema_field_elem(sm, get_field_type(st, idx), kind, pointee)

# The slot `x.f[i]` is, for the field `f`: an element of a `[N]T` field, or
# through a Vec, Span or String field, or a pointer to one (#2564).  Shared
# with slot_narrowing's indexed field stores (AGAST #4309).
pub fn sema_field_elem(sm: *Sema, f: *StructField, kind: *i32, pointee: *i32)
    *kind = TYPE_VOID
    *pointee = TYPE_VOID
    if f == null
        return
    if f.field_type == TYPE_ARRAY
        *kind = f.array_elem_type
        *pointee = f.array_elem_pointee
        return
    var fp: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        fp = f.ptr_pointee
    let through: i32 = sema_through_elem(sm, f.field_type, fp, f.field_type_name, f.field_type_name_len)
    if through != TYPE_VOID
        *kind = through

# The struct a receiver of type `r` is, or points at.
fn sx_recv_struct(sm: *Sema, r: *SemaTy) -> *StructDef
    if r.kind == TYPE_STRUCT
        return sema_find_struct(sm, r.name, r.name_len)
    if (r.kind == TYPE_PTR or r.kind == TYPE_REF or r.kind == TYPE_MUT_REF) and r.pointee == TYPE_STRUCT
        return sema_find_struct(sm, r.name, r.name_len)
    null

# `v[i][j]` where `v`'s element is a struct: the element's element, when that
# struct is itself a Vec, Span or String (index_through_element).
fn sx_struct_elem_slot(sm: *Sema, v: *SemaVar, kind: *i32)
    let st: *StructDef = sema_find_struct(sm, v.type_name, v.type_name_len)
    if st == null or name_eq(v.type_name, v.type_name_len, c"String", 6) == 1
        return
    var idx: i32 = find_field_index(st, c"data", 4)
    if idx < 0
        idx = find_field_index(st, c"ptr", 3)
    if idx < 0
        return
    let f: *StructField = get_field_type(st, idx)
    if f.field_type_name_len <= 0 or name_is_indexable(f.field_type_name, f.field_type_name_len) == 0
        return
    let inner: i32 = sema_buffer_elem(sm, f.field_type_name, f.field_type_name_len)
    if inner != TYPE_UNKNOWN
        *kind = inner

# --- SemaVar.index_elem ----------------------------------------------------------------

fn sx_last(sm: *Sema, name: *u8, len: i32) -> *SemaVar
    if sm.scope_top <= 0
        return null
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if v.name != name or v.name_len != len
        return null
    v

# The `let` / `var` sema_walk just bound: a written `[N]T` or `*[N]T`, or an
# unannotated pointer whose initialiser is one (`let q = p`, `p + k`, `@a`).
pub fn sema_index_note_decl(sm: *Sema, st: *Stmt)
    let v: *SemaVar = sx_last(sm, st.var_name, st.var_name_len)
    if v == null
        return
    if st.var_declared_type == TYPE_VOID
        if v.kind == TYPE_PTR or v.kind == TYPE_REF or v.kind == TYPE_MUT_REF
            # Judged before the name is in scope, as `let q = q` reads the outer q.
            sm.scope_top = sm.scope_top - 1
            v.index_elem = sx_init_elem(sm, st.var_init, @v.shape)
            sm.scope_top = sm.scope_top + 1
        return
    if st.var_type == TYPE_ARRAY
        v.index_elem = st.var_array_elem_type
        v.shape = st.var_array_shape
    else if (st.var_type == TYPE_PTR or st.var_type == TYPE_REF or st.var_type == TYPE_MUT_REF) and st.var_pointee_type == TYPE_ARRAY
        v.index_elem = st.var_pointee_array_elem_type
        v.shape = st.var_pointee_array_shape

# The element of the `[N]T` initialiser `init` points at (and its N-D shape
# into *shape): a pointer local that has one, under any `+ k` / `- k`, or
# `@a` / `@&a` of a `[N]T` local.
fn sx_init_elem(sm: *Sema, init: *Expr, shape: **ArrayShape) -> i32
    var x: *Expr = init
    while x != null and x.kind == EXPR_BINARY and (x.op == OP_ADD or x.op == OP_SUB)
        x = x.left
    if x == null
        return TYPE_VOID
    if x.kind == EXPR_UNARY and (x.op == OP_ADDR or x.op == OP_ADDR_MUT) and x.operand != null and x.operand.kind == EXPR_IDENT
        let a: *SemaVar = sema_find_local(sm, x.operand.ident_ptr, x.operand.ident_len)
        if a != null and a.kind == TYPE_ARRAY
            *shape = a.shape
            return a.index_elem
        return TYPE_VOID
    if x.kind != EXPR_IDENT
        return TYPE_VOID
    let p: *SemaVar = sema_find_local(sm, x.ident_ptr, x.ident_len)
    if p == null or p.kind == TYPE_ARRAY
        return TYPE_VOID
    *shape = p.shape
    p.index_elem

# The param sema_walk just bound.
pub fn sema_index_note_param(sm: *Sema, p: *Param)
    let v: *SemaVar = sx_last(sm, p.name, p.name_len)
    if v == null
        return
    if p.param_type == TYPE_ARRAY
        v.index_elem = p.param_array_elem_type
        v.shape = p.param_array_shape
    else if (p.param_type == TYPE_PTR or p.param_type == TYPE_REF or p.param_type == TYPE_MUT_REF) and p.param_pointee_type == TYPE_ARRAY
        v.index_elem = p.param_pointee_array_elem_type
        v.shape = p.param_pointee_array_shape
