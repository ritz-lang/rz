# ritz1/src/types.ritz - the ONE table of primitive type facts, plus the one
# compiler-supplied struct layout: the `{ ptr, len }` view (AGAST #4545)
#
# AGAST #1889 (#1814 FIX step 2, review ritz1.md F2).  Every fact ritz1 needs
# about a primitive type kind (TYPE_* from ast.ritz) is answered here, and
# only here:
#
#     ty_mem_llvm     LLVM spelling of the type IN MEMORY: a struct field, an
#                     array element, a pointee, an alloca / global slot
#     ty_value_llvm   LLVM spelling of the type as a VALUE (fn params,
#                     returns, extern decls): ritz1's unified value model
#                     carries pointers and `@T` as i64
#     ty_store_size   bytes one value occupies (x86_64 DataLayout)
#     ty_align        natural alignment
#     ty_bits         integer / bool width in bits (bool = 1)
#     ty_int_bits     integer width in bits, 0 for bool and non-integers
#     ty_is_signed / ty_is_unsigned / ty_is_int
#     ty_name         the Ritz spelling (`u16`), for messages
#     ty_from_name    the primitive kind a Ritz spelling names
#
# There used to be a dozen-plus copies of these ladders (emit_llvm_type,
# array_elem_llvm, field_array_elem_llvm, const_array_elem_llvm,
# narrow_int_width, int_prim_bits, prim_name_size, ptr_pointee_size, ...),
# each knowing a different subset of the primitives; every new primitive had
# to be added to all of them, and the ones that were missed miscompiled
# (#1564, #1814, #1966, #2063).  A new primitive is now one row in each
# function below.  ritz0/test_ritz1_type_layout_table.py pins the table to
# ritz0's layout, and its static test keeps the copies from growing back.
#
# Struct / enum / tagged-enum kinds need the emitter's struct table and are
# answered there (elem_size_align, get_struct_size_by_name); every function
# here answers "unknown" (0 / null) for them so a caller cannot mistake a
# guess for a fact.

import ast
import ritzlib.memory   # calloc for the view layout below (AGAST #4545)
import ritzlib.strview  # StrView, strview_empty (AGAST #4772)

# 1 for the eight integer kinds (not bool).
pub fn ty_is_int(t: TypeKind) -> i32
    (ty_int_bits(t) > 0) as i32

pub fn ty_is_signed(t: TypeKind) -> i32
    if t == TypeKind.I8 or t == TypeKind.I16 or t == TypeKind.I32 or t == TypeKind.I64
        return 1
    0

pub fn ty_is_unsigned(t: TypeKind) -> i32
    if t == TypeKind.U8 or t == TypeKind.U16 or t == TypeKind.U32 or t == TypeKind.U64
        return 1
    0

# Width in bits of an integer kind; 0 for bool and everything else.
pub fn ty_int_bits(t: TypeKind) -> i32
    match t
        TypeKind.I8 | TypeKind.U8 =>
            return 8
        TypeKind.I16 | TypeKind.U16 =>
            return 16
        TypeKind.I32 | TypeKind.U32 =>
            return 32
        TypeKind.I64 | TypeKind.U64 =>
            return 64
        _ => pass
    0

# 1 when `t` is an integer kind whose width lies in lo..hi bits
# (`ty_int_in(t, 8, 16)`: i8/u8/i16/u16).
pub fn ty_int_in(t: TypeKind, lo: i32, hi: i32) -> i32
    let bits: i32 = ty_int_bits(t)
    (bits > 0 and bits >= lo and bits <= hi) as i32

# Width in bits of an integer or bool kind (bool = 1); 0 for anything else.
pub fn ty_bits(t: TypeKind) -> i32
    if t == TypeKind.Bool
        return 1
    ty_int_bits(t)

pub fn ty_is_float(t: TypeKind) -> i32
    (t == TypeKind.F32 or t == TypeKind.F64) as i32

pub fn ty_is_ptr(t: TypeKind) -> i32
    (t == TypeKind.Ptr or t == TypeKind.PtrPtr) as i32

# Bytes one value of kind `t` occupies; 0 when `t` is not a primitive
# (struct, enum, array, ref, void) -- never a guess.
pub fn ty_store_size(t: TypeKind) -> i64
    if t == TypeKind.Bool
        return 1
    let bits: i32 = ty_int_bits(t)
    if bits > 0
        return (bits / 8) as i64
    if t == TypeKind.F32
        return 4
    if t == TypeKind.F64 or ty_is_ptr(t) == 1
        return 8
    0

# Natural alignment of a primitive kind (its size on x86_64); 0 if unknown.
pub fn ty_align(t: TypeKind) -> i64
    ty_store_size(t)

# LLVM spelling of kind `t` in memory: `[N x <this>]` arrays, struct
# fields, pointees, slots.  null for a kind that is not a primitive
# (struct / enum / array / ref / void), which the caller spells itself.
pub fn ty_mem_llvm(t: TypeKind) -> *u8
    let bits: i32 = ty_int_bits(t)
    if bits == 8
        return c"i8"
    if bits == 16
        return c"i16"
    if bits == 32
        return c"i32"
    if bits == 64
        return c"i64"
    match t
        TypeKind.Bool =>
            return c"i1"
        TypeKind.F32 =>
            return c"float"
        TypeKind.F64 =>
            return c"double"
        _ => pass
    if ty_is_ptr(t) == 1
        return c"ptr"
    null

# LLVM spelling of kind `t` as a value (params, returns, call operands).
# Pointers and `@T` are carried as i64 (ritz1's unified value model); an
# `@&T` is a `ptr`; anything unknown is i64.
pub fn ty_value_llvm(t: TypeKind) -> *u8
    match t
        TypeKind.Void =>
            return c"void"
        TypeKind.MutRef =>
            return c"ptr"
        _ => pass
    if ty_is_ptr(t) == 1 or t == TypeKind.Ref
        return c"i64"
    let m: *u8 = ty_mem_llvm(t)
    if m == null
        return c"i64"
    m

# The Ritz spelling of a primitive kind (`u16`); "i64" for anything else,
# which is how ritz1 types an unknown integer.
#
# AGAST #4772 note: ty_mem_llvm/ty_value_llvm stay *u8 (not StrView)
# because emitter*.ritz calls them directly as a C string (e.g.
# `let m: *u8 = ty_mem_llvm(t)` in emitter_core.ritz).  ty_name is a
# StrView (AGAST #4919): every caller prints or compares it.
pub fn ty_name(t: TypeKind) -> StrView
    match t
        TypeKind.I8 =>
            return "i8"
        TypeKind.U8 =>
            return "u8"
        TypeKind.I16 =>
            return "i16"
        TypeKind.U16 =>
            return "u16"
        TypeKind.I32 =>
            return "i32"
        TypeKind.U32 =>
            return "u32"
        TypeKind.U64 =>
            return "u64"
        TypeKind.Bool =>
            return "bool"
        TypeKind.F32 =>
            return "f32"
        TypeKind.F64 =>
            return "f64"
        _ => pass
    "i64"

fn ty_name_is(name: StrView, want: StrView) -> i32
    if name.len != want.len
        return 0
    var i: i32 = 0
    while i < name.len
        if name.get(i) != want.get(i)
            return 0
        i = i + 1
    1

# The primitive kind the Ritz spelling `name` names (`usize` is u64,
# `isize` is i64, #3464); TypeKind.Void when `name` is not a primitive.
pub fn ty_from_name(name: StrView) -> TypeKind
    if name.ptr == null or name.len < 2 or name.len > 5
        return TypeKind.Void
    # Every primitive kind lies in TypeKind.I32 (1) .. TypeKind.F64 (13); the two
    # pointer kinds in that range have no word spelling.
    var code: i32 = TypeKind.I32 as i32
    while code <= (TypeKind.F64 as i32)
        let t: TypeKind = type_kind_of(code)
        if ty_is_ptr(t) == 0 and ty_name_is(name, ty_name(t)) == 1
            return t
        code = code + 1
    if ty_name_is(name, "isize") == 1
        return TypeKind.I64
    if ty_name_is(name, "usize") == 1
        return TypeKind.U64
    TypeKind.Void

# =============================================================================
# `*TypeRef` forms (AGAST #4035)
#
# The parser builds a recursive TypeRef (ast.ritz); these answer the same
# primitive facts `ty_*` does, deriving the flat kind the table takes.  The
# chain is the type: `pointee` / `elem`, not a separate depth count.
# =============================================================================

# The flat kind a TypeRef stands for.  Any depth >= 2 is TypeKind.PtrPtr, as the
# flat model had it; the chain carries the depth (`tr_depth`).
pub fn tr_flat(tr: *TypeRef) -> TypeKind
    if tr == null
        return TypeKind.Void
    tr.kind

pub fn tr_is_ptr(tr: *TypeRef) -> i32
    ty_is_ptr(tr_flat(tr))

pub fn tr_store_size(tr: *TypeRef) -> i64
    ty_store_size(tr_flat(tr))

pub fn tr_align(tr: *TypeRef) -> i64
    ty_align(tr_flat(tr))

pub fn tr_mem_llvm(tr: *TypeRef) -> *u8
    ty_mem_llvm(tr_flat(tr))

pub fn tr_value_llvm(tr: *TypeRef) -> *u8
    ty_value_llvm(tr_flat(tr))

pub fn tr_pointee(tr: *TypeRef) -> *TypeRef
    if tr == null
        return null
    tr.pointee

pub fn tr_elem(tr: *TypeRef) -> *TypeRef
    if tr == null
        return null
    tr.elem

# The pointer depth: 1 for `*T`, 2 for `**T`, ...  0 for anything else.
pub fn tr_depth(tr: *TypeRef) -> i32
    if tr == null
        return 0
    match tr.kind
        TypeKind.Ptr =>
            return 1
        TypeKind.PtrPtr =>
            if tr.pointee == null
                return 2
            if tr.pointee.kind == TypeKind.Ptr
                return 2
            return 1 + tr_depth(tr.pointee)
        _ => pass
    0

# The name a struct type carries: its own, or the deepest struct a pointer /
# reference / array wraps.  `strview_empty()` when nothing in the chain is a
# struct.
pub fn tr_name(tr: *TypeRef) -> StrView
    if tr == null
        return strview_empty()
    if tr.kind == TypeKind.Struct
        return tr.name
    if tr.pointee != null
        return tr_name(tr.pointee)
    if tr.elem != null
        return tr_name(tr.elem)
    strview_empty()

# =============================================================================
# The compiler-supplied `{ ptr, len }` view (AGAST #4545)
#
# A bare string literal lowers to a `%Span$u8` aggregate of type StrView, and
# `v[lo..hi]` lowers to a `Span$T { ptr, len }`.  That one shape used to be
# built three times — Sema's static view, the emitter's string-literal
# fallback, and monomorph's `Span<T>` template — and its field names assumed
# in a fourth place (monomorph's span_view_in_place).  They drifted
# independently.  It is built here, once, and its names are exposed so
# lowering and validation cannot spell them differently from the layout.
#
# `view_struct_new` is the only place the StructDef and its fields are made.
# Callers keep their own ordering: the emitter APPENDS the struct, monomorph
# PREPENDS its template, and each arranges that (order is semantic).
# `view_layout_ok` is the only check of a source layout against the literal's.
# =============================================================================

pub const VIEW_PTR_NAME_LEN: i32 = 3
pub const VIEW_LEN_NAME_LEN: i32 = 3

# The view's field names, in declaration order.
pub fn view_ptr_name() -> StrView
    "ptr"

pub fn view_len_name() -> StrView
    "len"

# A fresh StructField of the view: named, typed, and every specialization
# field at its TypeKind.Void / null default (calloc zeroes them).
fn view_field_new(name: StrView, ty: TypeKind) -> *StructField
    let f: *StructField = calloc(1, sizeof(StructField)) as *StructField
    f.name = name
    f.field_type = ty
    f.inner_pointee_type = (TypeKind.Void as i32)
    f.field_ref_ptr_pointee = TypeKind.Void
    f

# The `{ ptr: *P, len: i64 }` StructDef named `name_sv`.  `generic` = 1 makes
# the pointee the unsubstituted type parameter `T` (monomorph's template,
# whose fields clone_struct_fields substitutes); `generic` = 0 makes it the
# concrete `u8` view a string literal / `Span$u8` / `StrView` has.  `next`,
# `type_params` stay null and `def_file` empty: the caller links it into the module
# and, for the template, adds its `<T>`.
pub fn view_struct_new(name_sv: StrView, generic: i32) -> *StructDef
    let ptr_f: *StructField = view_field_new(view_ptr_name(), TypeKind.Ptr)
    if generic == 1
        ptr_f.ptr_pointee = TypeKind.Struct
        ptr_f.field_type_name = "T"
    else
        ptr_f.array_elem_type = TypeKind.U8   # the pointee, for `span.ptr + i` stride
    ptr_f.next = view_field_new(view_len_name(), TypeKind.I64)
    let st: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
    st.name = name_sv
    st.fields = ptr_f
    st

# 1 if `st` has exactly the `{ ptr, i64 }` shape string literals are lowered
# to: two fields, a pointer then an i64.  A source layout that differs cannot
# honour the hard-coded literal lowering and is an error, not a shadow.
pub fn view_layout_ok(st: *StructDef) -> i32
    let f1: *StructField = st.fields
    if f1 == null
        return 0
    if f1.field_type != TypeKind.Ptr
        return 0
    let f2: *StructField = f1.next
    if f2 == null
        return 0
    if f2.field_type != TypeKind.I64
        return 0
    if f2.next != null
        return 0
    1
