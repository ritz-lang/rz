# ritz1/src/emitter_seam.ritz - the emitter's one dispatch seam
#
# AGAST #4697.  Statements and expressions nest, so the emitter recurses: a
# call emits its arguments, a match its arms, an array literal its elements.
# Through imports that recursion made seven modules (emitter_expr, _access,
# _arith, _call, emitter_match, emitter_print, emitter_stmt) one import
# cycle; moving code between them could not break it (#1818).
#
# Every module of the emitter now recurses through these wrappers instead,
# each a call through EmitterState.emit (emitter_core.ritz's EmitTable),
# which emit_module wires once to the `*_impl` fn doing the work.  This
# module imports only what the signatures name, so any emitter module can
# import it, and the modules can be ordered: emitter_expr_access,
# emitter_print, emitter_match, emitter_aggregate, emitter_expr,
# emitter_expr_arith, emitter_expr_call, emitter_dispatch, emitter_stmt,
# each importing only those before it.


import ast
import emitter_core

# A value's register: emitter_dispatch's emit_expr_impl.
pub fn emit_expr(s: *EmitterState, e: *Expr) -> i32
    let f: fn(*EmitterState, *Expr) -> i32 = s.emit.expr
    f(s, e)

# A condition's i1 register, for a `br`, a phi or a `ret i1`:
# emitter_dispatch's emit_cond_impl (AGAST #4854).
pub fn emit_cond(s: *EmitterState, e: *Expr) -> i32
    let f: fn(*EmitterState, *Expr) -> i32 = s.emit.cond
    f(s, e)

# A statement: emitter_stmt's emit_stmt_impl.
pub fn emit_stmt(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    let f: fn(*EmitterState, *Stmt, TypeKind) = s.emit.stmt
    f(s, stmt, ret_type)

# A place's address: emitter_expr_arith's emit_lvalue_ptr_impl.
pub fn emit_lvalue_ptr(s: *EmitterState, op: *Expr) -> i32
    let f: fn(*EmitterState, *Expr) -> i32 = s.emit.lvalue_ptr
    f(s, op)

# A field's address: emitter_expr's emit_member_ptr_impl.
pub fn emit_member_ptr(s: *EmitterState, e: *Expr, result: *MemberPtrResult)
    let f: fn(*EmitterState, *Expr, *MemberPtrResult) = s.emit.member_ptr
    f(s, e, result)

# A value stored into a typed slot: emitter_expr_call's emit_expr_into_slot_impl.
pub fn emit_expr_into_slot(s: *EmitterState, e: *Expr, ty: TypeKind, name: StrView) -> i32
    let f: fn(*EmitterState, *Expr, TypeKind, StrView) -> i32 = s.emit.into_slot
    f(s, e, ty, name)

# A value stored into a struct field: emitter_expr_call's emit_expr_into_field_impl.
pub fn emit_expr_into_field(s: *EmitterState, e: *Expr, field: *StructField) -> i32
    let f: fn(*EmitterState, *Expr, *StructField) -> i32 = s.emit.into_field
    f(s, e, field)

# A method call: emitter_expr_call's emit_expr_method_impl.
pub fn emit_expr_method(s: *EmitterState, e: *Expr) -> i32
    let f: fn(*EmitterState, *Expr) -> i32 = s.emit.method
    f(s, e)

# An array value over a local array: emitter_aggregate's
# emit_array_local_whole_assign_impl.
pub fn emit_array_local_whole_assign(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name: StrView, value: *Expr)
    let f: fn(*EmitterState, i32, i32, TypeKind, StrView, *Expr) = s.emit.array_assign
    f(s, dst_ptr, dst_size, dst_et, dst_name, value)
