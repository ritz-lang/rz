# The Option / Result `e` is, by its type, or as a constructor naming one.
fn tagged_enum_operand(s: *EmitterState, e: *Expr) -> StrView
    if builtin_tagged_ctor(s, e) == 1
        let ctor: StrView = ctor_scrutinee_enum(s, e)
        if not unnamed(ctor)
            return ctor
        # A payload ritz1 can't name: its family will do.
        if ctor_family_is(e, "Option$") == 1
            return "Option"
        return "Result"
    let typed: StrView = match_scrutinee_type(s, e)
    if not unnamed(typed) and is_tagged_enum_type(typed) == 1
        return typed
    no_name()

# `==` or `!=`, as the refusals quote it.
fn eq_op_quoted(e: *Expr) -> StrView
    if e.op == OpKind.Ne
        return "'!='"
    "'=='"

# AGAST #2454: `o == None`, `r != Ok(5)`, `o == p` over an Option or a Result is
# ritz0's located refusal: a variant carries a payload, so `==` would compare
# the tags alone.  ritz1 compiled it: `None` had no enum and was the `add i64
# 0, 0` fallback, and two Options were an `icmp` clang rejects.  A user's
# payload enum is refuse_aggregate_eq's (#2510).  1 when refused.
fn refuse_tagged_enum_eq(s: *EmitterState, e: *Expr) -> bool
    var name: StrView = tagged_enum_operand(s, e.left)
    if unnamed(name) or builtin_tagged_ctor(s, e.left) == 1
        # A typed side names the enum better than a constructor's guess.
        let rname: StrView = tagged_enum_operand(s, e.right)
        if not unnamed(rname) and (unnamed(name) or builtin_tagged_ctor(s, e.right) == 0)
            name = rname
    if unnamed(name)
        return false
    let op: StrView = eq_op_quoted(e)
    var msg: String = string_new()
    format_into(@&msg, "{op} is not supported for struct type '{name}' — a variant carries a payload, so `==` would compare tags only; use `match` to test the variant")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    true

# The by-value struct or user enum `e` is, as its LLVM type names it; unnamed
# when it is a scalar, a pointer, or not statically known.
fn eq_aggregate_operand(s: *EmitterState, e: *Expr) -> StrView
    let none: StrView = no_name()
    if e == null
        return none
    var name: StrView = none
    if e.kind == ExprKind.Member
        name = named_by(qualified_variant_enum, s, e)   # `Shape.Dot`
        if unnamed(name)
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type == TypeKind.Struct and fld.field_type_name_len > 0
                name = StrView { ptr: fld.field_type_name, len: fld.field_type_name_len as i64 }
    else if e.kind == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        name = deref_pointee_struct_name(s, e.operand)   # AGAST #2525: `*q`
    else
        name = resolve_expr_struct_name(s, e)
    if unnamed(name) or name.len == 0 or is_tagged_enum_type(name) == 1
        return none
    let ei: i32 = enum_find(s.mono.pctx, name)
    if ei >= 0
        # A fieldless enum compares its tags (#1660); one with a payload can't.
        if not enum_has_payload(s, ei)
            return none
    else if find_struct(s, name) == null and name_eq(name, "StrView") == 0 and name_eq(name, "String") == 0
        return none
    name

# Does any variant of enum `ei` carry a payload?
fn enum_has_payload(s: *EmitterState, ei: i32) -> bool
    for vi in 0..enum_variant_count(s.mono.pctx, ei)
        if enum_variant_kind(s.mono.pctx, ei, vi) != ENUM_VARIANT_UNIT
            return true
    false

# What to do instead of `==` on the aggregate `name`.
fn aggregate_eq_hint(s: *EmitterState, name: StrView) -> StrView
    if enum_find(s.mono.pctx, name) >= 0
        return " — a variant carries a payload, so `==` would compare tags only; use `match` to test the variant"
    if name_eq(name, "StrView") == 1
        return " — use a.eq(b) from ritzlib.strview"
    if name_eq(name, "String") == 1
        return " — use a.eq_string(@b) from ritzlib.string"
    ""

# AGAST #2510: `==` / `!=` on a user enum whose variants carry a payload, or on
# a struct, is ritz0's located refusal (_reject_aggregate_compare).  ritz1
# compared a payload enum's tags alone (`Circle(1) == Circle(2)` was true) and
# wrote a struct as an `icmp eq i64` clang rejects.  The left operand names the
# type, as in ritz0; the right one when the left is no aggregate.  1 when refused.
fn refuse_aggregate_eq(s: *EmitterState, e: *Expr) -> bool
    var name: StrView = eq_aggregate_operand(s, e.left)
    if unnamed(name)
        name = eq_aggregate_operand(s, e.right)
    if unnamed(name)
        return false
    let op: StrView = eq_op_quoted(e)
    let hint: StrView = aggregate_eq_hint(s, name)
    var msg: String = string_new()
    format_into(@&msg, "{op} is not supported for struct type '{name}'{hint}")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    true

# The source spelling of an operator; unnamed for OpKind.Unset.
fn binary_op_spelling(op: OpKind) -> StrView
    match op
        OpKind.Unset => no_name()
        OpKind.And => "and"
        OpKind.Or => "or"
        OpKind.Neg => "-"
        OpKind.Not => "not"
        OpKind.Deref => "*"
        OpKind.Addr => "@"
        OpKind.AddrMut => "@&"
        OpKind.BitNot => "~"
        OpKind.AddWrap => "+%"
        OpKind.SubWrap => "-%"
        OpKind.MulWrap => "*%"
        OpKind.Eq => "=="
        OpKind.Ne => "!="
        OpKind.Lt => "<"
        OpKind.Gt => ">"
        OpKind.Le => "<="
        OpKind.Ge => ">="
        OpKind.BitAnd => "&"
        OpKind.BitOr => "|"
        OpKind.BitXor => "^"
        OpKind.Shl => "<<"
        OpKind.Shr => ">>"
        OpKind.Add => "+"
        OpKind.Sub => "-"
        OpKind.Mul => "*"
        OpKind.Div => "/"
        OpKind.Mod => "%"

# AGAST #2525: `*(q + 1) + 1`, `*q < 5` with `q: *S`: the deref loads a `%S`,
# which ritz1 wrote where clang wanted an i64, unlocated.  ritz0's refusal
# (_reject_struct_operand), located at the operand.  A `[N]S` element is
# whole_struct_elem_refused's; `==` / `!=` on a struct refuse_aggregate_eq's
# first.  1 when refused.
fn refuse_struct_deref_operand(s: *EmitterState, e: *Expr) -> bool
    var side: *Expr = e.left
    var name: StrView = deref_struct_name(s, side)
    if unnamed(name)
        side = e.right
        name = deref_struct_name(s, side)
    if unnamed(name)
        return false
    let op: StrView = binary_op_spelling(e.op)
    var msg: String = string_new()
    format_into(@&msg, "`{op}` on struct `{name}`: a struct is not an integer (read one of its fields)")
    emit_nd_error_sv(s, side.span.line, side.span.col, msg.as_view())
    true

# The struct a `*p` operand loads, when `side` is one; unnamed otherwise.
fn deref_struct_name(s: *EmitterState, side: *Expr) -> StrView
    if side != null and side.kind == ExprKind.Unary and side.op == OpKind.Deref
        return struct_value_name(s, side)
    no_name()

# AGAST #2514: `p == "lit"` / `p != "lit"` (the literal on either side) with
# `p` a pointer is ritz0's located refusal (_reject_pointer_strlit_compare).
# A bare literal is a StrView, so ritz1 compared a pointer with a `Span$u8`
# and #2510 named that type with no hint.  Refused, not lowered to `*u8`: a
# `*u8` is not necessarily a string.  A `*u8` slot is untouched.  1 when refused.
# AGAST #3196: a C-string literal (`p == c"lit"`) too — it type-checks as
# `*u8 == *u8` but compares the pointer with the literal's address, not its text.
fn is_any_string_lit(e: *Expr) -> bool
    e != null and (e.kind == ExprKind.StringLit or e.kind == ExprKind.CstringLit)

fn refuse_pointer_strlit_eq(s: *EmitterState, e: *Expr) -> bool
    let hit: bool = (is_any_string_lit(e.left) and expr_is_pointer(s, e.right) == 1) or (is_any_string_lit(e.right) and expr_is_pointer(s, e.left) == 1)
    if not hit
        return false
    let op: StrView = eq_op_quoted(e)
    var msg: String = string_new()
    format_into(@&msg, "{op} is not supported between a pointer and a string literal — a *u8 is not necessarily a string; compare it with streq(p, c\"...\") from ritzlib.str")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    true

pub fn emit_expr_binary(s: *EmitterState, e: *Expr) -> i32
    # Short-circuit logical AND / OR.  Without this, ritz1 emits
    #   %r = and i64 %left, %right
    # which evaluates BOTH operands eagerly — `a and *p == 'x'` always
    # dereferences `p` even when `a` is false.  ritz0 implements proper
    # short-circuit via control flow + phi.  The selfhost-emit-strview
    # SEGV (Wave 5E) was a downstream consequence: a code path inside
    # emit_expr_call had `param_type == TypeKind.Struct and *(param_type_name + 0)
    # == 'S' and ...` — when the param was a non-struct, the deref of a
    # null name fired anyway.  See ritz0 _emit_short_circuit_and (~3942).
    match e.op
        OpKind.And =>
            return emit_logical_and(s, e)
        OpKind.Or =>
            return emit_logical_or(s, e)
        _ => pass

    # Check if this is pointer arithmetic (ptr + int or ptr - int).
    # If the left operand is a pointer, scale the right operand by the
    # pointee size.  ptr_arith_elem_size (emitter_core) owns the whole
    # classification — simple identifier (`p + i`), member access
    # (`s.ptr + i`), global pointer var, and, since AGAST #1361, a
    # left-associated chain (`s.ptr + i - 1`) whose left operand is itself
    # a binary expression.  It returns 0 for "not a pointer"; a real element
    # size is never 0, so the sentinel is unambiguous.
    # AGAST #2928 / #2597: `q - p` on two pointers is their distance in
    # elements of the left's pointee: (q - p) / sizeof(T), an i64.
    # is_ptr_distance is a `-` only, so it lives under the one `+`/`-` test.
    var is_ptr_arith: bool = false
    var ptr_elem_size: i64 = 1
    if e.op == OpKind.Add or e.op == OpKind.Sub
        if refuse_ref_arith(s, e)
            return 0   # AGAST #3037, LARB R16
        if is_ptr_distance(s, e) == 1
            return emit_ptr_distance(s, e)
        let elem: i64 = ptr_operand_stride(s, e.left)
        if elem != 0
            is_ptr_arith = true
            ptr_elem_size = elem

    # The first refusal that applies reports; `or` stops there.
    # AGAST #2514, #2454, #2510.
    if e.op == OpKind.Eq or e.op == OpKind.Ne
        if refuse_pointer_strlit_eq(s, e) or refuse_tagged_enum_eq(s, e) or refuse_aggregate_eq(s, e)
            return 0
    if refuse_struct_deref_operand(s, e)
        return 0   # AGAST #2525

    var left_reg: i32 = emit_expr(s, e.left)
    var right_reg: i32 = emit_expr(s, e.right)

    # AGAST #1754: `p == s` with `p: *S` (i64) and `s: @&S` (`ptr`) -- the
    # compares below are all `icmp ... i64`, so bring a `ptr` operand into
    # the i64 value model.  A no-op for every non-`ptr` operand.
    if is_compare(e.op)
        left_reg = ptr_value_to_i64(s, e.left, left_reg)
        right_reg = ptr_value_to_i64(s, e.right, right_reg)

    # AGAST #1660: a unit-enum operand is a `%Kind = { i8 }` aggregate, not
    # an i64 (`k == Kind.A`, `e.kind != c`, `x == y` on enum params).
    # Compare the tags: extract field 0 and widen it to the i64 the integer
    # compare below expects.  Either side may be the enum.
    if e.op == OpKind.Eq or e.op == OpKind.Ne
        left_reg = unit_enum_tag_to_i64(s, e.left, left_reg)
        right_reg = unit_enum_tag_to_i64(s, e.right, right_reg)

    # For pointer arithmetic, scale the offset
    var scaled_right: i32 = right_reg
    if is_ptr_arith and ptr_elem_size > 1
        scaled_right = next_reg(s)
        format_into(s, "  %.{scaled_right} = mul i64 %.{right_reg}, {ptr_elem_size}\n")

    # For pointer arithmetic, emit as `getelementptr i8` to preserve LLVM
    # pointer provenance (prevents -O2 mis-optimization of inttoptr-derived
    # stores). Result is ptrtoint'd back to i64 for the unified value model.
    if is_ptr_arith
        # Convert left i64 → ptr.  AGAST #2554: an `@&T` / `@&[N]T` operand
        # (a param, an `@&` local, `@&v`) is already a `ptr`, and an
        # inttoptr of it is invalid IR; use it as is.
        var left_as_ptr: i32 = left_reg
        if expr_is_ptr_valued(s, e.left) == 0
            left_as_ptr = next_reg(s)
            format_into(s, "  %.{left_as_ptr} = inttoptr i64 %.{left_reg} to ptr\n")

        # For SUB, negate the scaled offset
        var offset_reg: i32 = scaled_right
        if e.op == OpKind.Sub
            offset_reg = next_reg(s)
            format_into(s, "  %.{offset_reg} = sub i64 0, %.{scaled_right}\n")

        # getelementptr i8, ptr %left, i64 %offset — preserves provenance
        let gep_reg: i32 = next_reg(s)
        format_into(s, "  %.{gep_reg} = getelementptr i8, ptr %.{left_as_ptr}, i64 %.{offset_reg}\n")

        # ptrtoint back to i64 (unified value model)
        let ptr_result: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, gep_reg)
        return ptr_result

    # Float arithmetic / comparison dispatch.  When either operand is a
    # float, route through fadd/fsub/fmul/fdiv/fcmp (or the fmod helper) instead of i64 ops.
    # The float result stays as `float`/`double` (no widening to i64) so
    # the surrounding emit-llvm-type knows what shape to write.  ritz0 uses
    # the same pattern via NamedType("f32")/("f64") string-name dispatch.
    let fty_t: TypeKind = binop_float_width(s, e)
    if fty_t != TypeKind.Void
        return emit_float_binop(s, e, fty_t, left_reg, scaled_right)

    # LARB R21 (AGAST #3112): a literal operand is the other operand's type, so
    # one that can't be is refused, as in a slot: `x + 300` with `x: u8`.  That
    # refusal is Sema's (literal_slot.ritz, literal_operand_check, #3510).  The
    # value needs nothing more here: int_operand_shape gives `x + 1` x's shape,
    # so a compare or a narrow slot reads it back at that width.

    # AGAST #1604: u64 operands take the unsigned compare / div / rem.  Every
    # integer is held in an i64; u8/u16/u32 are zero-extended into it, so they
    # are never negative there and the signed ops already agree.  A u64 with
    # the top bit set is negative as an i64, so `sgt`/`sdiv`/`srem` got it
    # wrong.  Like ritz0, either operand being u64 is enough (`a > 1` with
    # `a: u64`).  AGAST #2361: int_operand_shape says which is, as for `>>`, so
    # `(a ^ z) > 1`, `K[0] / 2` and `s.get() % 10` are a u64's too, and a narrow
    # operand is brought back to its type first: `~s` on a u8 is 248, not -8.
    # AGAST #3063: so is one `==` / `!=` reads: `(a + a) == 144` on a u8 of 200.
    var unsigned: bool = false
    if e.op == OpKind.Div or e.op == OpKind.Mod or e.op == OpKind.Lt or e.op == OpKind.Gt or e.op == OpKind.Le or e.op == OpKind.Ge or e.op == OpKind.Eq or e.op == OpKind.Ne
        var lu: i32 = 0
        var ru: i32 = 0
        let lb: i32 = int_operand_shape(s, e.left, @lu)
        let rb: i32 = int_operand_shape(s, e.right, @ru)
        let wider: TypeKind = wider_slot_type(s, e)
        if wider != TypeKind.Void
            # AGAST #3225: in a wider slot `/` and `%` run at the slot's type,
            # on operands that didn't wrap below it: read back at that type.
            let wb: i32 = ty_bits(wider)
            let wu: i32 = ty_is_unsigned(wider)
            left_reg = emit_narrow_operand(s, e.left, left_reg, wb, wu == 1)
            scaled_right = emit_narrow_operand(s, e.right, scaled_right, wb, wu == 1)
            if wb == 64 and wu == 1
                unsigned = true
        else
            left_reg = emit_narrow_operand(s, e.left, left_reg, lb, lu == 1)
            scaled_right = emit_narrow_operand(s, e.right, scaled_right, rb, ru == 1)
            if (lb == 64 and lu == 1) or (rb == 64 and ru == 1)
                unsigned = true

    # AGAST #2356: `>>` follows the left operand alone, never the count.
    var shr_u: i32 = 0
    if e.op == OpKind.Shr
        let shr_bits: i32 = int_operand_shape(s, e.left, @shr_u)
        left_reg = emit_narrow_operand(s, e.left, left_reg, shr_bits, shr_u == 1)

    # AGAST #1869: a failing `assert a OP b` prints the two operands, as the
    # i64s this compare reads (not a re-evaluation; see emit_assert_stmt).
    # The float path above records nothing, so its asserts print no values.
    if e == s.assert_cap_expr
        s.assert_cap_l = left_reg
        s.assert_cap_r = scaled_right
        s.assert_cap_ok = 1

    # LARB R63 (AGAST #3489): `+ - *` checked; `/ %` and a shift count guarded.
    let checked: i32 = arith_trap_guard(s, e, left_reg, scaled_right)
    if checked >= 0
        return checked

    let opcode: StrView = int_binop_opcode(e.op, unsigned, shr_u != 0)
    if unnamed(opcode)
        emit_ir_error_sv(s, e.span, "no integer opcode for this binary operator")
        return 0
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = {opcode}%.{left_reg}, %.{scaled_right}\n")

    if is_compare(e.op)
        return ir_zext_i1_i64(s.out, @s.reg_counter, result)

    # LARB R63 (AGAST #3486): `+%` / `-%` / `*%` wrap at their operand type.
    # The sum is an i64 like every integer, so a wider slot would otherwise see
    # 300 for 200 +% 100; trunc it back to the operand type and extend it, as
    # a store to that type would.  ritz0 stops its slot walk instead; the two
    # agree because this read-back is what that store would do.
    if e.wrapping == 1
        var wuns: i32 = 0
        let wbits: i32 = int_operand_shape(s, e, @wuns)
        if wbits < 64
            let wrapped_low: i32 = next_reg(s)
            format_into(s, "  %.{wrapped_low} = trunc i64 %.{result} to i{wbits}\n")
            let wrapped_wide: i32 = next_reg(s)
            let extend: StrView = if wuns == 1 then "zext" else "sext"
            format_into(s, "  %.{wrapped_wide} = {extend} i{wbits} %.{wrapped_low} to i64\n")
            return wrapped_wide

    return result

# The integer op's opcode and operand type after `%r = ` (`unsigned`: unsigned
# div / rem / compare; `shr_unsigned`: logical shift right).  Unnamed for an
# operator that never gets here: `and` / `or` short-circuit before it, and the
# rest are unary, unset, or parser-only.
fn int_binop_opcode(op: OpKind, unsigned: bool, shr_unsigned: bool) -> StrView
    match op
        OpKind.Add => "add i64 "
        OpKind.Sub => "sub i64 "
        OpKind.Mul => "mul i64 "
        OpKind.Div => if unsigned then "udiv i64 " else "sdiv i64 "
        OpKind.Mod => if unsigned then "urem i64 " else "srem i64 "
        OpKind.Eq => "icmp eq i64 "
        OpKind.Ne => "icmp ne i64 "
        OpKind.Lt => if unsigned then "icmp ult i64 " else "icmp slt i64 "
        OpKind.Gt => if unsigned then "icmp ugt i64 " else "icmp sgt i64 "
        OpKind.Le => if unsigned then "icmp ule i64 " else "icmp sle i64 "
        OpKind.Ge => if unsigned then "icmp uge i64 " else "icmp sge i64 "
        OpKind.BitAnd => "and i64 "
        OpKind.BitOr => "or i64 "
        OpKind.BitXor => "xor i64 "
        OpKind.Shl => "shl i64 "
        OpKind.Shr => if shr_unsigned then "lshr i64 " else "ashr i64 "
        OpKind.Unset | OpKind.And | OpKind.Or | OpKind.Neg | OpKind.Not | OpKind.Deref | OpKind.Addr | OpKind.BitNot | OpKind.AddrMut | OpKind.AddWrap | OpKind.SubWrap | OpKind.MulWrap => no_name()

# `a and b`, short-circuit: a phi over the two exits.
fn emit_logical_and(s: *EmitterState, e: *Expr) -> i32
    # Synthetic anchor block — gives us a known predecessor label for
    # the phi.  s.current_label may be stale at the function entry
    # block (which is named `entry`, not a number), so we can't rely
    # on it being a valid number.  LLVM optimizes the trivial branch
    # away.
    let sa_anchor: i32 = next_label(s)
    format_into(s, "  br label %L{sa_anchor}\n")
    begin_block(s, sa_anchor)
    let sa_left_val: i32 = emit_expr(s, e.left)
    let sa_left_bool: i32 = next_reg(s)
    format_into(s, "  %.{sa_left_bool} = icmp ne i64 %.{sa_left_val}, 0\n")
    let sa_entry_label: i32 = s.current_label
    let sa_right_label: i32 = next_label(s)
    let sa_end_label: i32 = next_label(s)
    format_into(s, "  br i1 %.{sa_left_bool}, label %L{sa_right_label}, label %L{sa_end_label}\n")
    # Right branch — only entered when left was truthy
    begin_block(s, sa_right_label)
    let sa_right_val: i32 = emit_expr(s, e.right)
    let sa_right_bool: i32 = next_reg(s)
    format_into(s, "  %.{sa_right_bool} = icmp ne i64 %.{sa_right_val}, 0\n")
    let sa_right_ext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, sa_right_bool)
    let sa_right_exit: i32 = s.current_label
    format_into(s, "  br label %L{sa_end_label}\n")
    # End — phi merges short-circuit (false) and full-eval branches.
    begin_block(s, sa_end_label)
    let sa_phi: i32 = next_reg(s)
    format_into(s, "  %.{sa_phi} = phi i64 [ 0, %L{sa_entry_label} ], [ %.{sa_right_ext}, %L{sa_right_exit} ]\n")
    return sa_phi

# `a or b`, short-circuit: a phi over the two exits.
fn emit_logical_or(s: *EmitterState, e: *Expr) -> i32
    let so_anchor: i32 = next_label(s)
    format_into(s, "  br label %L{so_anchor}\n")
    begin_block(s, so_anchor)
    let so_left_val: i32 = emit_expr(s, e.left)
    let so_left_bool: i32 = next_reg(s)
    format_into(s, "  %.{so_left_bool} = icmp ne i64 %.{so_left_val}, 0\n")
    let so_entry_label: i32 = s.current_label
    let so_right_label: i32 = next_label(s)
    let so_end_label: i32 = next_label(s)
    # Inverted: if left truthy, skip right (result already true).
    format_into(s, "  br i1 %.{so_left_bool}, label %L{so_end_label}, label %L{so_right_label}\n")
    begin_block(s, so_right_label)
    let so_right_val: i32 = emit_expr(s, e.right)
    let so_right_bool: i32 = next_reg(s)
    format_into(s, "  %.{so_right_bool} = icmp ne i64 %.{so_right_val}, 0\n")
    let so_right_ext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, so_right_bool)
    let so_right_exit: i32 = s.current_label
    format_into(s, "  br label %L{so_end_label}\n")
    begin_block(s, so_end_label)
    let so_phi: i32 = next_reg(s)
    format_into(s, "  %.{so_phi} = phi i64 [ 1, %L{so_entry_label} ], [ %.{so_right_ext}, %L{so_right_exit} ]\n")
    return so_phi

# A float binary op at width `fty_t`: each operand coerced to it, then the
# `f`-prefixed op or compare (AGAST #1965).
fn emit_float_binop(s: *EmitterState, e: *Expr, fty_t: TypeKind, left_in: i32, right_in: i32) -> i32
    var left_reg: i32 = left_in
    var scaled_right: i32 = right_in
    # AGAST #1965: coerce each float operand to the op's width -- fptrunc
    # a double literal for an f32 op, fpext an f32 operand for an f64
    # op.  `fcmp one float %f32, %double` is invalid IR.
    let lft: TypeKind = binop_operand_float_ty(s, e.left)
    let rft: TypeKind = binop_operand_float_ty(s, e.right)
    # AGAST #4285: an integer literal operand (`x != 2`, `1 + x`) is in a
    # float slot (§7.5): its i64 register is sitofp'd to the op's width.
    if lft != TypeKind.Void
        left_reg = emit_float_coerce(s, left_reg, lft, fty_t)
    else if fs_literal_only(e.left) == 1
        left_reg = emit_float_coerce(s, left_reg, TypeKind.I64, fty_t)
    if rft != TypeKind.Void
        scaled_right = emit_float_coerce(s, scaled_right, rft, fty_t)
    else if fs_literal_only(e.right) == 1
        scaled_right = emit_float_coerce(s, scaled_right, TypeKind.I64, fty_t)
    let fty: StrView = float_llvm_name(fty_t)
    if e.op == OpKind.Mod
        # AGAST #3817: not `frem`, which lowers to a libm fmod call; Ritz
        # links no libc.  The module defines the helper (emit_fmod_helpers).
        var callee: StrView = "@__ritz_fmod(double "
        if fty_t == TypeKind.F32
            callee = "@__ritz_fmodf(float "
            s.fmod_helpers_used = s.fmod_helpers_used | 2
        else
            s.fmod_helpers_used = s.fmod_helpers_used | 1
        let fmod_r: i32 = next_reg(s)
        format_into(s, "  %.{fmod_r} = call {fty} {callee}%.{left_reg}, {fty} %.{scaled_right})\n")
        return fmod_r
    let opcode: StrView = float_binop_opcode(e.op)
    if unnamed(opcode)
        emit_ir_error_sv(s, e.span, "this operator does not take a float operand")
        return 0
    let result_f: i32 = next_reg(s)
    format_into(s, "  %.{result_f} = {opcode}{fty} %.{left_reg}, %.{scaled_right}\n")
    # Comparison ops produce i1 — zext to i64 for unified value model.
    if is_compare(e.op)
        return ir_zext_i1_i64(s.out, @s.reg_counter, result_f)
    result_f

# The float op or ordered compare, as the opcode and its trailing space.
# Unnamed for an operator with none: `%` is emit_float_binop's fmod call, and
# the bitwise ops, shifts, `and` / `or` and the unary ops take no float.
fn float_binop_opcode(op: OpKind) -> StrView
    match op
        OpKind.Add => "fadd "
        OpKind.Sub => "fsub "
        OpKind.Mul => "fmul "
        OpKind.Div => "fdiv "
        OpKind.Eq => "fcmp oeq "
        OpKind.Ne => "fcmp une "
        OpKind.Lt => "fcmp olt "
        OpKind.Gt => "fcmp ogt "
        OpKind.Le => "fcmp ole "
        OpKind.Ge => "fcmp oge "
        OpKind.Unset | OpKind.Mod | OpKind.And | OpKind.Or | OpKind.BitAnd | OpKind.BitOr | OpKind.BitXor | OpKind.Shl | OpKind.Shr | OpKind.Neg | OpKind.Not | OpKind.Deref | OpKind.Addr | OpKind.BitNot | OpKind.AddrMut | OpKind.AddWrap | OpKind.SubWrap | OpKind.MulWrap => no_name()

# `==`, `!=`, `<`, `>`, `<=`, `>=`: the ops whose result is an i1.
fn is_compare(op: OpKind) -> bool
    op == OpKind.Eq or op == OpKind.Ne or op == OpKind.Lt or op == OpKind.Gt or op == OpKind.Le or op == OpKind.Ge


# AGAST #3225: the slot `/` or `%` node `e` lands in directly, when it's wider
# than `e`'s own integer type (literal_slot.ritz, lit_slot_arith); else
# TypeKind.Void.  ritz0's _wider_slot.  LARB R63 (AGAST #3489): `+ - *` and
# `<<` record it too, since that is the type their overflow is checked at.
fn wider_slot_type(s: *EmitterState, e: *Expr) -> TypeKind
    match e.op
        OpKind.Div | OpKind.Mod | OpKind.Add | OpKind.Sub | OpKind.Mul | OpKind.Shl => pass
        _ =>
            return TypeKind.Void
    let t: TypeKind = e.slot_type
    let bits: i32 = ty_bits(t)
    if bits <= 1
        return TypeKind.Void
    var uns: i32 = 0
    if bits <= int_operand_shape(s, e, @uns)
        return TypeKind.Void
    t

# AGAST #2356: a register holds an i64, so `a + a` or `~a` on a u8 can sit outside
# the u8's range, and the bits a `>>` brings down would be ones the type does not
# have.  Bring such a value back to its type.  `/`, `%` and every compare
# read the whole register too (#2361, #3063).  Only an operator can leave the
# range: a name, load, call or cast is already extended from its width.
fn emit_narrow_operand(s: *EmitterState, e: *Expr, reg: i32, bits: i32, unsigned: bool) -> i32
    if bits >= 64
        return reg
    if e.kind != ExprKind.Binary and e.kind != ExprKind.Unary
        return reg
    if e.kind == ExprKind.Unary and e.op != OpKind.Neg and e.op != OpKind.BitNot
        return reg
    let low: i32 = next_reg(s)
    format_into(s, "  %.{low} = trunc i64 %.{reg} to i{bits}\n")
    let wide: i32 = next_reg(s)
    let extend: StrView = if unsigned then "zext" else "sext"
    format_into(s, "  %.{wide} = {extend} i{bits} %.{low} to i64\n")
    wide

# AGAST #1660 — `reg` (the value of `operand`) as an i64.  A unit-enum
# operand's `%Kind` aggregate becomes its zero-extended i8 tag; any other
# operand is already i64 and is returned unchanged.
fn unit_enum_tag_to_i64(s: *EmitterState, operand: *Expr, reg: i32) -> i32
    # AGAST #2539: `*q` / `**r` loads the %E deref_pointee_struct_name names;
    # unit_enum_expr_name knows every memory read (AGAST #4450).
    let en: StrView = unit_enum_expr_name(s, operand)
    if en.len == 0
        return reg
    let tag: i32 = next_reg(s)
    let en_ir: String = ir_name(en)
    format_into(s, "  %.{tag} = extractvalue %{en_ir.as_view()} %.{reg}, 0\n")
    # AGAST #4574: a repr enum's tag is its repr type; equality only needs
    # both sides widened alike.
    let tag_ty: StrView = enum_tag_ty_named(s.mono.pctx, en)
    let uei: i32 = user_enum_index(s.mono.pctx, en)
    if uei >= 0 and enum_tag_size(s.mono.pctx, uei) == 8
        return tag
    let wide: i32 = next_reg(s)
    format_into(s, "  %.{wide} = zext {tag_ty} %.{tag} to i64\n")
    wide

# AGAST #1505 — static pointee struct of a deref operand.
#
# `*op` must load the pointee's LLVM type.  The OpKind.Deref arm used to name the
# struct only for a bare parameter identifier (`*p`) and silently `load i64`
# for everything else, which clang rejects the moment the value is stored into
# a struct slot:
#
#     let d: D = *(p + i)         # pointer arithmetic on a *D
#     let q: *D = ...; *q         # let-local pointer
#     *(h.items + i)              # pointer-typed struct field (21_ls)
#     *name                       # `name: @StrView` reference param (ritzunit)
#
# Walks the operand's static type: `+`/`-` keep the pointer's type, so the
# chain is followed down its left spine to the base pointer; the base is a
# local/global pointer or reference, or a struct field.  A candidate name is
# accepted only if it names a struct find_struct knows or a tagged enum
# (`Option$T`) — primitive pointees the parser spelt as type names (`*u8` →
# "u8") never resolve, so they keep their width-specific loads.  A bare `*p`
# keeps its pre-#1505 unverified trust.  Writes null/0 when the pointee is not
# a known aggregate.
# What `x + 1` steps by when `x` is a pointer: sizeof its pointee.  0 when `x`
# isn't a pointer (a real element size is never 0).
fn ptr_operand_stride(s: *EmitterState, x: *Expr) -> i64
    # AGAST #1505: an operand statically known to be `*S` strides by
    # sizeof(S) — the same resolution the OpKind.Deref arm loads through, so
    # `*(q + i)` steps and loads the same type.  ptr_arith_elem_size
    # alone does not scale a nested `a.b.items` field at all.
    let pointee: StrView = deref_pointee_struct_name(s, x)
    # Only a StructDef or a user enum (user_enum_size, AGAST #4574: an
    # `enum E: i32` steps 4 bytes) has a size here; get_struct_size_by_name
    # says 8 for a tagged enum, so those keep ptr_arith_elem_size's answer.
    if pointee.len > 0 and (find_struct(s, pointee) != null or user_enum_index(s.mono.pctx, pointee) >= 0)
        return get_struct_size_by_name(s, pointee)
    ptr_arith_elem_size(s, x)

# AGAST #3037, LARB R16: `p + i`, `i + p`, `p - i`, `p += i`, `p -= i` and
# `p - q` with `p` an `@T` / `@&T` and T not an array.  A reference names one
# value, so `p + 1` names one that was never lent; `(p as *T) + 1` is the way
# out.  The row walk on `@[N]T` / `@&[N]T` stays legal (§7.8, #2554, R18).
# `+=` / `-=` reach here desugared.  The words are ritz0's array_rules.ref_arith.
fn refuse_ref_arith(s: *EmitterState, e: *Expr) -> bool
    var pointee: String = ref_arith_pointee(s, e.left)
    if pointee.is_empty()
        pointee = ref_arith_pointee(s, e.right)
    if pointee.is_empty()
        return false
    let op: StrView = if e.op == OpKind.Sub then "-" else "+"
    var msg: String = string_new()
    format_into(@&msg, "a reference is one value, not a buffer: `{op}` needs a `*T`; write `(p as *{pointee.as_view()}) {op} 1`")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    true

# The T of an `@T` / `@&T` local or param `x` whose T isn't an array, as Ritz
# spells it ("i32", "S", "*u8"; "T" when unknown); empty when `x` isn't one.
fn ref_arith_pointee(s: *EmitterState, x: *Expr) -> String
    var name: String = string_new()
    if x == null or x.kind != ExprKind.Ident
        return name
    let loc: *LocalVar = find_local_struct_name(s, x.ident)
    if loc == null or (lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef)
        return name
    let pointee: TypeKind = lv_pointee_type(loc)
    if pointee == TypeKind.Array
        return name
    let prim: StrView = primitive_spelling(pointee)
    let inner: StrView = primitive_spelling(ptr_slot_flat(lv_inner_pointee_type(loc)))
    if not unnamed(prim)
        name.push_str(prim)
    else if pointee == TypeKind.Ptr and not unnamed(inner)
        format_into(@&name, "*{inner}")
    else if lv_type_name_len(loc) > 0
        name.push_str(StrView { ptr: lv_type_name(loc), len: lv_type_name_len(loc) as i64 })
    else
        name.push_str("T")
    name

# AGAST #2928: `q - p` on two pointers, as an i64 count of elements.  Both
# sides come into the i64 value model (an `@&T` operand is a `ptr`, #1754),
# and the byte distance divides by the left's stride (plain sdiv, as ritz0:
# `exact` would make an unaligned pair poison).
fn emit_ptr_distance(s: *EmitterState, e: *Expr) -> i32
    if refuse_mixed_ptr_distance(s, e)
        return 0   # AGAST #2957
    var stride: i64 = ptr_operand_stride(s, e.left)
    if stride <= 0
        stride = 1
    let l: i32 = ptr_value_to_i64(s, e.left, emit_expr(s, e.left))
    let r: i32 = ptr_value_to_i64(s, e.right, emit_expr(s, e.right))
    let bytes: i32 = next_reg(s)
    format_into(s, "  %.{bytes} = sub i64 %.{l}, %.{r}\n")
    if stride == 1
        return bytes
    let count: i32 = next_reg(s)
    format_into(s, "  %.{count} = sdiv i64 %.{bytes}, {stride}\n")
    count

# AGAST #2957: LANGUAGE_SPEC §7.1 — only two pointers to the same T have a
# distance; `*i32 - *u8` has no common element to count in.  ritz1 divided the
# byte distance by the left's stride.  Refuse it, located, in ritz0's words,
# which name the pointer types as LLVM spells them (`*u8` is `i8*`, so `*u8`
# and `*i8` are the same type, as in ritz0).  An operand whose pointee isn't
# statically known keeps the old behaviour: never refuse on a guess.
fn refuse_mixed_ptr_distance(s: *EmitterState, e: *Expr) -> bool
    let left: String = ptr_distance_pointee(s, e.left)
    if left.is_empty()
        return false
    let right: String = ptr_distance_pointee(s, e.right)
    if right.is_empty() or left.as_view().eq(right.as_view())
        return false
    var msg: String = string_new()
    format_into(@&msg, "pointer difference needs two pointers to the same type, got `{left.as_view()}*` and `{right.as_view()}*`")
    emit_nd_error_sv(s, e.span.line, e.span.col, msg.as_view())
    true

# The pointee of the pointer operand `x` of `q - p`, as LLVM names it ("i32",
# "%struct.E"); empty when it isn't statically known.  `p + k` / `p - k` keep
# p's type, so a chain is read down its left spine.
fn ptr_distance_pointee(s: *EmitterState, x: *Expr) -> String
    var pointee: String = string_new()
    var base: *Expr = x
    while base != null and base.kind == ExprKind.Binary and (base.op == OpKind.Add or base.op == OpKind.Sub) and is_ptr_distance(s, base) == 0
        base = base.left
    if base == null
        return pointee
    var kind: TypeKind = TypeKind.Void
    var name: StrView = no_name()
    if base.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, base.ident)
        if loc != null
            if lv_var_type(loc) != TypeKind.Ptr and lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef
                return pointee
            kind = lv_pointee_type(loc)
            name = StrView { ptr: lv_type_name(loc), len: lv_type_name_len(loc) as i64 }
        else
            let glob: *GlobalVarDef = find_global(s, base.ident)
            if glob == null or glob.var_type != TypeKind.Ptr
                return pointee
            kind = glob.pointee_type
            name = StrView { ptr: glob.pointee_type_name, len: glob.pointee_type_name_len as i64 }
    else
        let root: NamedKind = ptr_root_pointee(s, base)
        kind = root.kind
        name = root.name
    let scalar: StrView = scalar_llvm_name(kind)
    if not unnamed(scalar)
        pointee.push_str(scalar)
    else if kind == TypeKind.Struct and name.len > 0 and find_struct(s, name) != null
        format_into(@&pointee, "%struct.{name}")
    pointee

# A scalar kind's LLVM type, as emit_llvm_type spells it; unnamed for any other.
fn scalar_llvm_name(t: TypeKind) -> StrView
    match ty_int_bits(t)
        8 => return "i8"
        16 => return "i16"
        32 => return "i32"
        64 => return "i64"
        _ => pass
    match t
        TypeKind.F32 => "float"
        TypeKind.F64 => "double"
        TypeKind.Bool => "i1"
        _ => no_name()

# AGAST #2544: 1 when `op` is an if-expression some arm of which points at an
# aggregate, so a deref of it the arms don't agree on is #1505's located error,
# not a `load i64` clang rejects.
fn if_arm_names_pointee(s: *EmitterState, op: *Expr) -> bool
    if op == null or op.kind != ExprKind.If
        return false
    var arm: *MatchArm = op.args as *MatchArm
    while arm != null
        if deref_pointee_struct_name(s, arm.body).len > 0
            return true
        arm = arm.next
    false

# AGAST #1488: the address of an lvalue, as a `ptr` register, or -1 when
# `op` is not an lvalue this emitter can address.  Shared by `@` (OpKind.Addr,
# which ptrtoints the result to the i64 value model) and `@&` (OpKind.AddrMut,
# which yields the ptr itself).  Before #1488 these shapes lived inline in
# OpKind.Addr only, and `@&` handled nothing but a bare local, so `@&s.field`,
# `@&p.a.b`, `@&arr[i].f` and `@&g` were all "cannot take mutable address".
# Emits no diagnostic of its own: the caller reports the failure.
# The GEP element type of `p[i]` for `p: *T`, given T's kind (pointee_type)
# and, for a struct, its name.  AGAST #1908: a struct pointee used to fall
# to the i8 default, so `@tests[1]` over `*RitzTest` pointed one BYTE in.
fn emit_ptr_elem_gep_type(s: *EmitterState, pointee_type: TypeKind, name: StrView)
    if pointee_type == TypeKind.Struct and name.len > 0
        emit_llvm_type_struct(s, TypeKind.Struct, name)
        return
    format_into(s, "{ptr_elem_gep_scalar(pointee_type)}")

# The GEP element type of a scalar `*T`: i8 by default (covers *u8 / *i8, the
# most common).
fn ptr_elem_gep_scalar(pointee_type: TypeKind) -> StrView
    if ty_int_bits(pointee_type) == 32
        return "i32"
    if ty_int_bits(pointee_type) == 64
        return "i64"
    if ty_int_bits(pointee_type) == 16
        return "i16"
    if pointee_type == TypeKind.Ptr or pointee_type == TypeKind.PtrPtr
        return "ptr"
    "i8"

# =============================================================================
# Multi-dimensional arrays (AGAST #1509)
# =============================================================================
#
# `var g: [N][M]..T` (local or global) carries an ArrayShape.  An index
# chain `g[i0][i1]..[ik-1]` (k <= rank) over it is ONE GEP over the full
# nested type, `getelementptr [N x [M x T]], ptr <g>, i64 0, i64 i0, i64 i1`,
# giving the element (k == rank) or a sub-array (k < rank).  Loads, stores,
# `@` and `.field` on a struct leaf all start from it.  Before #1509 the
# inner array was flattened to one i64 and every one of these miscompiled
# (or, for `@`, failed "cannot take address").

struct NdIndexPtr
    reg: i32              # ptr register of the element / sub-array
    depth: i32            # indices applied, 1..shape.rank
    shape: *ArrayShape

# nd_index_shape and the nd_array_*_shape helpers live in emitter_core
# (AGAST #2152): resolve_member_chain_field needs them for an indexed base.

# AGAST #2570: `q[i][j][k]` with more indices than q's plane has dimensions.
# index_through leaves a plane pointer to the N-D path, which can't take it,
# and the rest read past q (it crashed): refused, located, as ritz0 refuses it.
# Returns 1 with a full-depth *out over %0 when it refused (the error fails the
# build; callers then don't report again), 0 when `e` isn't such a chain.
fn nd_plane_overindex(s: *EmitterState, e: *Expr, out: *NdIndexPtr) -> i32
    if e == null or e.kind != ExprKind.Index
        return 0
    var chain: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @chain)   # AGAST #4122: `a[k]` a base
    if chain == 0   # `a[k]` itself: the plane pointer, not an index into it
        return 0
    let sh: *ArrayShape = plane_ptr_shape(s, base)
    if sh == null
        return 0
    emit_nd_error_sv(s, e.span.line, e.span.col, "this indexes more dimensions than the plane of the multi-dimensional array it points at has")
    out.reg = 0
    out.depth = sh.rank
    out.shape = sh
    return 1

# Emit the GEP for an N-D index chain `e` into *out.  Returns 0 (emitting
# nothing) when nd_index_shape does not recognise `e`.  The indices are
# evaluated in source order, outermost dimension first.
pub fn emit_nd_index_ptr(s: *EmitterState, e: *Expr, out: *NdIndexPtr) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null
        return nd_plane_overindex(s, e, out)
    var chain: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @chain)   # AGAST #4122: `a[k]` a base
    # AGAST #2097: a field base `s.m` / `p.m` / `a.b.m` is addressed before
    # the indices are evaluated, as ritz0 does.
    var base_reg: i32 = 0
    let plane_sh: *ArrayShape = plane_ptr_shape(s, base)   # #3635: `s.p[i][j]` is one
    if base.kind == ExprKind.Member and plane_sh == null
        var mp: MemberPtrResult
        emit_member_ptr(s, base, @mp)
        # Reported, then emitted anyway (over %.0) so callers do not fall
        # through to a 1-D path and report again; the error fails the build.
        if mp.success != 1
            emit_nd_error_sv(s, e.span.line, e.span.col, "cannot address the multi-dimensional array field this index chain starts from in ritz1")
        base_reg = mp.reg
    # AGAST #2570: a plane pointer `q` is GEP'd from its value, not its slot.
    # Loaded before the indices, as a field base is addressed before them.
    var plane: i32 = 0
    # AGAST #2098: `(*q)[i][j]` is `q[i][j]`; #3635: a field, global or call
    # base too, and `(*r)[i][j]` through a `**`.
    if plane_sh != null
        plane = 1
        base_reg = emit_plane_ptr(s, base)
    var regs: [8]i32
    var j: i32 = 0
    while j < depth
        # The j-th index (source order) sits depth-1-j levels below `e`.
        var node: *Expr = e
        var k: i32 = 0
        while k < depth - 1 - j
            node = node.left
            k = k + 1
        regs[j] = emit_expr(s, node.right)
        j = j + 1
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = getelementptr ")
    emit_array_shape_llvm(s, sh, 0)
    format_into(s, ", ptr ")
    if plane == 1 or base.kind == ExprKind.Member
        format_into(s, "%.{base_reg}")
    else
        let lv: *LocalVar = find_local_struct_name(s, base.ident)
        if lv != null
            format_into(s, "%.{lv.reg}")
        else
            let name_ir1: String = ir_name(base.ident)
            format_into(s, "@{name_ir1.as_view()}")
    format_into(s, ", i64 0")
    j = 0
    while j < depth
        format_into(s, ", i64 %.{regs[j]}")
        j = j + 1
    format_into(s, "\n")
    out.reg = r
    out.depth = depth
    out.shape = sh
    return 1

# The value of `e` = `g[i]..[k]` over an N-D array, in *out_reg.  Returns 0
# when `e` is not an N-D index chain.  Only a full-depth chain to a leaf is a
# value; a row (`g[i]` of `[N][M]T`) is a located error rather than a guess
# at an aggregate load.  AGAST #3322: a row bound to an `[M]T` local
# (`let r = g[i]`, annotated or not) or passed to an `[M]T` parameter is
# copied by the whole-array paths and never reaches here.
#
# AGAST #3306: a full-depth chain to a struct leaf loads the `%P` at the
# element's address, as #2099 stores one: a copy only (`let p: P = g[i][j]`,
# `g[0][0] = g[2][1]`, `f(g[i][j])`), as a 1-D `[N]S` element is (#2330).
# A leaf naming no struct (a generic clone that kept `T`, #3141) stays the
# located error: `load %T` would be invalid IR.
pub fn emit_nd_index_value(s: *EmitterState, e: *Expr, out_reg: *i32) -> i32
    var ndp: NdIndexPtr
    if emit_nd_index_ptr(s, e, @ndp) == 0
        return 0
    let sh: *ArrayShape = ndp.shape
    var leaf_st: *StructDef = null
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0
        leaf_st = find_struct(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    if ndp.depth < sh.rank or (sh.leaf_type == TypeKind.Struct and leaf_st == null)
        emit_nd_error_sv(s, e.span.line, e.span.col, "a row or a struct element of a multi-dimensional array is not a value in ritz1 (index every dimension, use .field, or take its address with @)")
        *out_reg = 0
        return 1
    if sh.leaf_type == TypeKind.Struct
        *out_reg = 0
        if whole_struct_elem_refused(s, e)
            return 1
        let sv: i32 = next_reg(s)
        emit_struct_load_or_defer(s, TypeKind.Struct, sv, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, ndp.reg, no_name())
        *out_reg = sv
        return 1
    let ty: StrView = elem_mem_llvm(sh.leaf_type)
    let v: i32 = next_reg(s)
    format_into(s, "  %.{v} = load {ty}, ptr %.{ndp.reg}\n")
    *out_reg = emit_array_elem_widen(s, v, sh.leaf_type, elem_mem_llvm(sh.leaf_type))
    return 1

# AGAST #3145: `@x[lo..hi]` refused at the index, in ritz0's words (#3088).  A
# String, Vec or Span slice is a new value with no place to point at; anything
# else isn't sliced, and emit_expr_index says so as it does for `x[lo..hi]`.
# Both were unlocated: "unknown expression kind" or "cannot take address".
fn addr_of_slice_refused(s: *EmitterState, op: *Expr)
    if slice_base_is_sliceable(s, op.left)
        emit_nd_error_sv(s, op.span.line, op.span.col, "can't take the address of a slice")
        return
    emit_expr_index(s, op)

# True when `base` (`v`, `*p`, `b.f`) is a String, Vec or Span, or a pointer to
# one, as ritz0's _slice_ritz_type reads it.
fn slice_base_is_sliceable(s: *EmitterState, base: *Expr) -> bool
    var b: *Expr = base
    if b != null and b.kind == ExprKind.Unary and b.op == OpKind.Deref
        b = b.operand
    if b == null
        return false
    match b.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, b.ident)
            if loc == null
                return false
            let vt: TypeKind = lv_var_type(loc)
            if vt != TypeKind.Struct and vt != TypeKind.Ptr and vt != TypeKind.Ref and vt != TypeKind.MutRef
                return false
            return is_sliceable_name(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        ExprKind.Member =>
            let fld: *StructField = resolve_member_chain_field(s, b)
            if fld == null
                return false
            let ft: TypeKind = fld.field_type
            if ft != TypeKind.Struct and ft != TypeKind.Ptr and ft != TypeKind.Ref and ft != TypeKind.MutRef
                return false
            return is_sliceable_name(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
        _ => pass
    return false

# AGAST #2518 / #3050: `@mk()` / `@&mk()` straight into a call's argument (the
# only place ref_check lets one be): the struct or array the call returns, spilled to a
# slot that lives until that call returns.  A move-only result is already in
# the slot own_note_temp spilled it to, so the callee and the drop see one
# value (own_lend_temps drops it when the call returns).  0 if `op` is no such call.
fn emit_call_temp_ptr(s: *EmitterState, op: *Expr) -> i32
    if op.kind != ExprKind.Call and op.kind != ExprKind.Method
        return 0
    if ref_temp_call(s, op) != op
        return 0
    # AGAST #3214: a `-> [N]T` result, `suma(@mka())`, is spilled as `for x in
    # mka()` spills it (#2997): its `[N x T]`, or the sret slot it's returned
    # through (#3181).  It was "cannot take address", unlocated.
    let ra: *Param = call_ret_array(s, op)
    if ra != null
        return emit_call_array_temp(s, op, ra)
    let result_struct: StrView = call_result_struct_name(s, op)
    if result_struct.len <= 0
        return 0
    let v: i32 = emit_expr(s, op)
    let held: i32 = own_temp_slot_of(s, v)
    if held > 0
        return held
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_llvm_type_struct(s, TypeKind.Struct, result_struct)
    format_into(s, "  ; #3050 lent temporary\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, result_struct, v, slot)
    slot

# AGAST #3978: 1 if `c` is `const D: [N]StrView = ["s"; N]`, the one struct
# fill §3.3 allows (ritz0's is_strview_array fill).  emit_const_array_entry
# lowers it as a `[N x %StrView]` of N views over one backing string.
pub fn const_strview_fill(c: *ConstEntry) -> i32
    if const_struct_fill_global(c) == 0 or c.value_expr.left == null or c.value_expr.left.kind != ExprKind.StringLit
        return 0
    name_eq(StrView { ptr: (c.array_elem_type_name), len: (c.array_elem_type_name_len) as i64 }, "StrView")

# AGAST #3946: 1 if `c` is a struct table written as a fill, which §3.3
# refuses (emitter.ritz const_struct_fill_error), a `[N]StrView` fill of a
# string literal aside (AGAST #3978).
pub fn const_struct_fill_refused(c: *ConstEntry) -> i32
    if const_struct_fill_global(c) == 0 or const_strview_fill(c) == 1
        return 0
    1

# LARB R48 (AGAST #3392): `@A` and `@A[i]` of a const array are shared
# references into its read-only global, `@[N]T` and `@T` (ritz0 #3391).  `@A`
# is the global itself; `@A[i]` GEPs it as the read `A[i]` does, a struct
# element as `[N x %S]` and a primitive at its stored width.  `@A[i].f` reaches
# the element through here too (emit_member_ptr).  -1 when `op` is neither.
# let_check still refuses `@&` of either: a const is never writable.
pub fn emit_const_array_ptr(s: *EmitterState, op: *Expr) -> i32
    if op.kind == ExprKind.Ident
        let ce: *ConstEntry = unshadowed_const(s, op.ident)
        if const_array_global(ce) == 0
            return -1
        let whole: i32 = next_reg(s)
        let name_ir2: String = ir_name(StrView { ptr: (ce.name), len: (ce.name_len) as i64 })
        format_into(s, "  %.{whole} = getelementptr i8, ptr @{name_ir2.as_view()}, i64 0\n")
        return whole
    if op.kind != ExprKind.Index or op.left == null or op.left.kind != ExprKind.Ident
        return -1
    if op.right == null or op.right.kind == ExprKind.Range
        return -1
    let carr: *ConstEntry = unshadowed_const(s, op.left.ident)
    if const_array_global(carr) == 0
        return -1
    if carr.array_elem_type == TypeKind.Struct
        if const_struct_table(carr) == 0
            return -1
        return emit_struct_array_elem_ptr(s, StrView { ptr: (carr.name), len: (carr.name_len) as i64 }, carr.array_size, StrView { ptr: carr.array_elem_type_name, len: carr.array_elem_type_name_len as i64 }, op.right)
    let cty: StrView = const_elem_llvm(carr.array_elem_type)
    if unnamed(cty)
        return -1
    let cidx: i32 = emit_expr(s, op.right)
    let cptr: i32 = next_reg(s)
    let name_ir3: String = ir_name(StrView { ptr: (carr.name), len: (carr.name_len) as i64 })
    format_into(s, "  %.{cptr} = getelementptr [{carr.array_size as i64} x {cty}], ptr @{name_ir3.as_view()}, i64 0, i64 %.{cidx}\n")
    cptr

# LARB R48: a const scalar is inlined, so `@N` has no storage to point at.  A
# located error at the `@`, in ritz0's words; it was an unlocated "cannot take
# address" (`@&N`: "cannot take mutable address").  1 when `e` (`@op` or
# `@&op`) was refused.
fn const_scalar_addr_refused(s: *EmitterState, e: *Expr) -> bool
    let op: *Expr = e.operand
    if op == null or op.kind != ExprKind.Ident
        return false
    let ce: *ConstEntry = unshadowed_const(s, op.ident)
    # LARB R48 / R60: a struct or enum const is read-only data, so `@C` is
    # `@S`; only a scalar const has no storage to point at.
    if ce == null or ce.const_type == TypeKind.Array or ce.const_type == TypeKind.Struct
        return false
    format_into(s, "  ; ERROR: address of a const scalar\n")
    diag_error_at(emitter_source_file(), e.span)
    let name: StrView = op.ident
    eprint("cannot take the address of const `{name}`; a const scalar has no storage\n")
    s.error_count = s.error_count + 1
    true

# The address of the place `op` names by its own kind, when it is one this
# emitter can address.
fn place_address(s: *EmitterState, op: *Expr) -> Option<i32>
    match op.kind
        ExprKind.Ident => lvalue_ptr_of_ident(s, op)
        ExprKind.Index => lvalue_ptr_of_index(s, op)
        ExprKind.Member => lvalue_ptr_of_member(s, op)
        _ => None

pub fn emit_lvalue_ptr(s: *EmitterState, op: *Expr) -> i32
    # AGAST #3234: `look(@mka()[1])`, an element of a call's array lent to a
    # call (#3050; ref_check refuses any other `@` of it): the element's
    # address in the spill emit_expr reads it from.
    let ca_root: *Expr = call_array_index_root(s, op)
    if ca_root != null
        let ca_call: *Expr = call_array_spill(s, ca_root)
        let ca_ptr: i32 = emit_lvalue_ptr(s, op)
        call_array_unspill(ca_root, ca_call)
        return ca_ptr
    let call_temp: i32 = emit_call_temp_ptr(s, op)
    if call_temp > 0
        return call_temp
    # AGAST #2379: `a[i][j]` with `a: [N]*T` is `*(a[i] + j)` (#2332), so its
    # address is `a[i] + j`.  It was "cannot take address".
    if is_array_elem_index(s, op) == 1
        if op.right != null and op.right.kind == ExprKind.Range
            emit_nd_error_sv(s, op.span.line, op.span.col, "an element of an array of pointers can't be sliced (only String, Vec and Span can)")
            return 0
        var ei_sum: Expr
        var ei_deref: Expr
        elem_index_as_deref(s, op, @ei_sum, @ei_deref)
        let ei_val: i32 = emit_expr(s, @ei_sum)
        let ei_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ei_val)
        return ei_ptr
    # AGAST #3145: `@x[lo..hi]` is no element, so it has no address.
    if op.kind == ExprKind.Index and op.right != null and op.right.kind == ExprKind.Range
        addr_of_slice_refused(s, op)
        return 0
    let const_ptr: i32 = emit_const_array_ptr(s, op)   # LARB R48
    if const_ptr >= 0
        return const_ptr
    # AGAST #1509: `@g[i][j]` / `@g[i]` over a multi-dimensional array.
    var nd_addr: NdIndexPtr
    if emit_nd_index_ptr(s, op, @nd_addr) == 1
        return nd_addr.reg
    match place_address(s, op)
        Some(addr) => return addr
        None => pass
    # AGAST #184: generic addr-of-MEMBER fallback. Anything that
    # `emit_member_ptr` knows how to GEP — including the new
    # `parent.fwd[i].field` over **Foo case — gets handled here
    # without each shape needing its own bespoke OpKind.Addr branch.
    # Without this, the call-site emitted undef `%.0` after the
    # explicit cases above all missed (e.g. ExprKind.Member over an
    # ExprKind.Index base).  Lives at the OpKind.Addr level (outside the
    # operand-kind branches) so it catches anything those missed.
    if op.kind == ExprKind.Member
        var fb_result: MemberPtrResult
        emit_member_ptr(s, op, @fb_result)
        if fb_result.success == 1
            return fb_result.reg
    # AGAST #184: addr-of-INDEX fallback for arbitrarily-deep
    # MEMBER chains.  `@doc.fields[i].key[0]` (mausoleum's
    # doc_find_field_index) is INDEX-of-MEMBER-of-INDEX-of-MEMBER-of-IDENT
    # — the existing OpKind.Addr branches only matched the simpler
    # 1- or 2-level chains, leaving deeper shapes to fall through
    # to "; ERROR: cannot take address" + undef %.0 at the call site.
    #
    # Strategy: when the operand is INDEX with a MEMBER base, use
    # emit_member_ptr to compute the address of the (array) field,
    # then GEP into it by the index using the array element type.
    if op.kind == ExprKind.Index
        if op.left.kind == ExprKind.Member
            var idx_fb: MemberPtrResult
            emit_member_ptr(s, op.left, @idx_fb)
            if idx_fb.success == 1
                let idx_fb_field: *StructField = idx_fb.field
                if idx_fb_field.field_type == TypeKind.Array
                    let idx_v: i32 = emit_expr(s, op.right)
                    let elem_ptr_fb: i32 = next_reg(s)
                    format_into(s, "  %.{elem_ptr_fb} = getelementptr [{idx_fb_field.array_size as i64} x ")
                    if idx_fb_field.array_elem_type == TypeKind.Struct and idx_fb_field.array_elem_type_name_len > 0
                        let name_ir4: String = ir_name(StrView { ptr: (idx_fb_field.array_elem_type_name), len: (idx_fb_field.array_elem_type_name_len) as i64 })
                        format_into(s, "%{name_ir4.as_view()}")
                    else
                        # AGAST #1814: the field's declared element type.
                        format_into(s, "{elem_mem_llvm(idx_fb_field.array_elem_type)}")
                    format_into(s, "], ptr %.{idx_fb.reg}, i64 0, i64 %.{idx_v}\n")
                    return elem_ptr_fb
    # AGAST #1599: `@*e` / `@&*e` — the address of `*e` is `e` itself, so
    # emit the pointer operand without loading through it.  Same ptr
    # normalisation as the OpKind.Deref value path: ritz1 carries most pointers
    # as i64, but a TypeKind.MutRef (`x: @&T` / `x:& T`) already loads as `ptr`.
    if op.kind == ExprKind.Unary and op.op == OpKind.Deref
        let deref_addr: i32 = emit_expr(s, op.operand)
        if deref_operand_is_ptr(s, op.operand) != 0
            return deref_addr
        let deref_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, deref_addr)
        return deref_ptr
    return -1

# `x` as a place: its address, when lowered.
fn lvalue_ptr_of_ident(s: *EmitterState, op: *Expr) -> Option<i32>
    # LARB R48 / R60: `@C` of a struct or enum const is `@S`, a pointer
    # into its read-only data (emit_const_struct_entry).
    let dce: *ConstEntry = unshadowed_const(s, op.ident)
    if dce != null and dce.const_type == TypeKind.Struct and dce.type_name_len > 0 and dce.value_expr != null
        let dres: i32 = next_reg(s)
        let name_ir5: String = ir_name(StrView { ptr: (dce.name), len: (dce.name_len) as i64 })
        format_into(s, "  %.{dres} = getelementptr i8, ptr @{name_ir5.as_view()}, i64 0\n")
        return Some(dres)
    let loc: i32 = find_local(s, op.ident)
    if loc >= 0
        # AGAST #2286: `@c` of `c:& C` is the borrow's pointer.  The slot's
        # own address is a pointer to that pointer.
        if lent_ptr_local(s, op) != null
            return Some(emit_load_ptr(s, loc))
        # Convert ptr (alloca) to i64
        return Some(loc)
    # Fall through: not a local, try a global. `@g_processed` (a
    # `var g_processed: Vec<String>` at module scope) used to silently
    # produce "ERROR: cannot take address" because this branch only
    # checked find_local — pre-existing limitation that didn't fire
    # until idiomatic main.ritz introduced struct-typed globals.
    let glob: *GlobalVarDef = find_global(s, op.ident)
    if glob != null
        # A global's address is the constant `@name`; GEP it by 0 to get
        # it into a register, since callers want a reg for both @ and @&.
        let result: i32 = next_reg(s)
        let name_ir6: String = ir_name(StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
        format_into(s, "  %.{result} = getelementptr i8, ptr @{name_ir6.as_view()}, i64 0\n")
        return Some(result)
    None

# `a[i]` as a place: its address, when lowered.
fn lvalue_ptr_of_index(s: *EmitterState, op: *Expr) -> Option<i32>
    # AGAST #2440: `@p[i]` through a reference or pointer: `p.data + i`.
    if through_slice_refused(s, op) == 1
        return Some(0)
    let through: *LocalVar = index_through(s, op)
    if through != null
        var th: ThroughIndex
        index_through_fill(s, op, through_spill(s, through), @th)
        let th_val: i32 = emit_expr(s, @th.sum)
        let th_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, th_val)
        return Some(th_ptr)
    # AGAST #2321: ritz0 lowers this at stride `[N]T`, past the end of the
    # array, against its own read; ritz1 stepped by a byte.  Neither (#2330).
    if array_ptr_index_base(s, op.left) != null
        emit_nd_error_sv(s, op.span.line, op.span.col, "the address of an element through a pointer to an array is refused (cast the pointer to `*T` and index that)")
        return Some(0)
    # AGAST #2204: `@b.f[i]` with a `f: *T` field, whatever `b` is (a struct
    # value, a `*S`, a member chain), is `b.f + i`: the sum the read
    # `*(b.f + i)` steps by one T.  A struct value's field was "cannot take
    # address"; through a `*S` it stepped a byte, so a `*u32` read garbage.
    let pf_field: *StructField = resolve_member_chain_field(s, op.left)
    if pf_field != null and pf_field.field_type == TypeKind.Ptr
        var pf_sum: Expr
        var pf_deref: Expr
        elem_index_as_deref(s, op, @pf_sum, @pf_deref)
        let pf_val: i32 = emit_expr(s, @pf_sum)
        let pf_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, pf_val)
        return Some(pf_ptr)
    # Handle @arr[i] - address of array element
    match op.left.kind
        ExprKind.Ident => lvalue_ptr_index_of_ident(s, op)
        ExprKind.Member => lvalue_ptr_index_of_member(s, op)
        _ => None

# `a[i]` with `a` named: its address, when lowered.
fn lvalue_ptr_index_of_ident(s: *EmitterState, op: *Expr) -> Option<i32>
    let local: *LocalVar = find_local_struct_name(s, op.left.ident)
    if local != null
        match lv_var_type(local)
            TypeKind.Array =>
                # Array local - use GEP [0, index] to get element address
                let idx: i32 = emit_expr(s, op.right)
                let elem_ptr: i32 = next_reg(s)
                format_into(s, "  %.{elem_ptr} = getelementptr [{lv_array_size(local) as i64} x ")
                if lv_array_elem_type(local) == TypeKind.Struct and lv_type_name_len(local) > 0
                    # AGAST #190: `@arr[i]` over `var arr: [N]Struct`
                    # — emit `[N x %T]` so the GEP stride matches the
                    # struct-element layout.  Without this, the
                    # downstream `ptrtoint` produces a pointer
                    # computed against an `[N x i64]` stride that
                    # disagrees with the alloca's `[N x %T]` layout.
                    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                else
                    # AGAST #1564: the alloca's own element type;
                    # u32/u16/i16 used to stride as i64.
                    format_into(s, "{elem_mem_llvm(lv_array_elem_type(local))}")
                format_into(s, "], ptr %.{local.reg}, i64 0, i64 %.{idx}\n")
                # Convert to i64
                return Some(elem_ptr)
            TypeKind.Ptr =>
                # @ptr_var[i] where ptr_var: *T — load the pointer,
                # GEP by element, convert to i64. Common in cryptosec
                # (e.g. `load_u64_be(@data[0])` with `data: *u8`).
                # Without this branch the address-of falls through
                # to "; ERROR: cannot take address" and the caller
                # references undef %.0.
                let loaded_p: i32 = emit_load_ptr(s, local.reg)
                let idx_p: i32 = emit_expr(s, op.right)
                let elem_ptr_p: i32 = next_reg(s)
                format_into(s, "  %.{elem_ptr_p} = getelementptr ")
                emit_ptr_elem_gep_type(s, lv_pointee_type(local), StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                format_into(s, ", ptr %.{loaded_p}, i64 %.{idx_p}\n")
                return Some(elem_ptr_p)
            _ => pass
    # If `op.left` is an ident but no matching local
    # was found, try the global table.  Squeeze's inflate
    # computes `@g_fixed_litlen_lengths[0]` and friends —
    # the global is `[288]u8` so a byte-level GEP works.
    # AGAST #190 extends this with a proper struct-array
    # branch: nexus's `var g_fallback: [100]FallbackPage`
    # needs `[100 x %FallbackPage]` GEP, not byte-level —
    # otherwise `@g_fallback[idx]` returns a pointer that
    # disagrees with the global's actual `[100 x %T]`
    # layout and downstream member loads pull garbage.
    let glob_arr: *GlobalVarDef = find_global(s, op.left.ident)
    if glob_arr != null
        if glob_arr.var_type == TypeKind.Array and glob_arr.array_elem_type == TypeKind.Struct and glob_arr.array_elem_type_name_len > 0
            let gas_idx: i32 = emit_expr(s, op.right)
            let gas_elem: i32 = next_reg(s)
            format_into(s, "  %.{gas_elem} = getelementptr [{glob_arr.array_size as i64} x ")
            emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (glob_arr.array_elem_type_name), len: (glob_arr.array_elem_type_name_len) as i64 })
            let name_ir7: String = ir_name(StrView { ptr: (glob_arr.name), len: (glob_arr.name_len) as i64 })
            format_into(s, "], ptr @{name_ir7.as_view()}, i64 0, i64 %.{gas_idx}\n")
            return Some(gas_elem)
        # AGAST #1908: `@g[i]` with `var g: *T` indexes the pointee,
        # not the global's own storage: load g, then GEP one T.
        if glob_arr.var_type == TypeKind.Ptr
            let gp_base: i32 = next_reg(s)
            emit_load_global(s, "ptr", gp_base, StrView { ptr: (glob_arr.name), len: (glob_arr.name_len) as i64 })
            let gp_idx: i32 = emit_expr(s, op.right)
            let gp_elem: i32 = next_reg(s)
            format_into(s, "  %.{gp_elem} = getelementptr ")
            emit_ptr_elem_gep_type(s, glob_arr.pointee_type, StrView { ptr: (glob_arr.pointee_type_name), len: (glob_arr.pointee_type_name_len) as i64 })
            format_into(s, ", ptr %.{gp_base}, i64 %.{gp_idx}\n")
            return Some(gp_elem)
        # AGAST #1984: `@g[i]` over a primitive `var g: [N]T` steps one
        # T, as `g[i]` loads/stores do (#1504).  The byte GEP below made
        # `@g_u64[1]` point one BYTE in.
        if glob_arr.var_type == TypeKind.Array and glob_arr.array_elem_type != TypeKind.Struct
            let gp_aidx: i32 = emit_expr(s, op.right)
            let gp_aelem: i32 = next_reg(s)
            let name_ir8: String = ir_name(StrView { ptr: (glob_arr.name), len: (glob_arr.name_len) as i64 })
            format_into(s, "  %.{gp_aelem} = getelementptr [{glob_arr.array_size as i64} x {elem_mem_llvm(glob_arr.array_elem_type)}], ptr @{name_ir8.as_view()}, i64 0, i64 %.{gp_aidx}\n")
            return Some(gp_aelem)
        let ga_idx: i32 = emit_expr(s, op.right)
        let ga_elem: i32 = next_reg(s)
        let name_ir9: String = ir_name(StrView { ptr: (glob_arr.name), len: (glob_arr.name_len) as i64 })
        format_into(s, "  %.{ga_elem} = getelementptr i8, ptr @{name_ir9.as_view()}, i64 %.{ga_idx}\n")
        return Some(ga_elem)
    None

# Handle @global.array_field[i] - address of global struct's array field element
fn lvalue_ptr_index_of_member(s: *EmitterState, op: *Expr) -> Option<i32>
    match op.left.left.kind
        ExprKind.Ident =>
            # Try to find as global variable
            let glob: *GlobalVarDef = find_global(s, op.left.left.ident)
            if glob != null
                if glob.var_type == TypeKind.Struct
                    let st: *StructDef = find_struct(s, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 })
                    if st != null
                        let field_idx: i32 = find_field_index(st, op.left.ident)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            if field.field_type == TypeKind.Array
                                # Found an array field in global struct
                                # Emit GEP to array field, then index into it
                                # getelementptr %StructType, ptr @global, i32 0, i32 field_idx, i64 index
                                let idx: i32 = emit_expr(s, op.right)
                                let elem_ptr: i32 = next_reg(s)
                                gep_struct_open(s, elem_ptr, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                                let name_ir10: String = ir_name(StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                                format_into(s, ", ptr @{name_ir10.as_view()}, i32 0, i32 {field_idx as i64}, i64 %.{idx}\n")
                                # Convert to i64
                                return Some(elem_ptr)
            # Handle @ptr_to_struct.array_field[i] - address of element in array field via pointer
            let local: *LocalVar = find_local_struct_name(s, op.left.left.ident)
            if local != null
                if lv_var_type(local) == TypeKind.Ptr and lv_type_name_len(local) > 0
                    # It's a pointer to a struct with a known type name
                    let st: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                    if st != null
                        let field_idx: i32 = find_field_index(st, op.left.ident)
                        if field_idx >= 0
                            let field: *StructField = get_field_type(st, field_idx)
                            if field.field_type == TypeKind.Array
                                # Load the pointer from the local, GEP to array field, index into it
                                let loaded_ptr: i32 = emit_load_ptr(s, local.reg)
                                # GEP to array field, then to element
                                let idx: i32 = emit_expr(s, op.right)
                                let elem_ptr: i32 = next_reg(s)
                                gep_struct_open(s, elem_ptr, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                                format_into(s, ", ptr %.{loaded_ptr}, i32 0, i32 {field_idx as i64}, i64 %.{idx}\n")
                                # Convert to i64
                                return Some(elem_ptr)
                            # A `*T` field is the #2204 sum above.
                # task-170: @local_struct.array_field[i] — local stack-
                # allocated struct (TypeKind.Struct, not PTR). e.g.
                # `var addr: SockAddrIn` then `memset(@addr.zero[0],...)`
                # in ritzlib/net.ritz. Without this branch it falls
                # through to "; ERROR: cannot take address" — same
                # symptom as the chained-member case but a different
                # base shape.
                if lv_var_type(local) == TypeKind.Struct and lv_type_name_len(local) > 0
                    let st_ls: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                    if st_ls != null
                        let field_idx_ls: i32 = find_field_index(st_ls, op.left.ident)
                        if field_idx_ls >= 0
                            let field_ls: *StructField = get_field_type(st_ls, field_idx_ls)
                            if field_ls.field_type == TypeKind.Array
                                let idx_ls: i32 = emit_expr(s, op.right)
                                let elem_ptr_ls: i32 = next_reg(s)
                                gep_struct_open(s, elem_ptr_ls, StrView { ptr: (st_ls.name), len: (st_ls.name_len) as i64 })
                                format_into(s, ", ptr %.{local.reg}, i32 0, i32 {field_idx_ls as i64}, i64 %.{idx_ls}\n")
                                return Some(elem_ptr_ls)
        # task-170 site-1: chained-member addr-of-index, e.g.
        # `@p.command.args[i]` where `p.command` itself is a member
        # access (RespParser.command yields a RespCommand struct
        # field, whose `args` field is an array). emit_member_ptr
        # already handles arbitrarily-nested member chains — use it
        # to compute a ptr to the array field, then GEP by index.
        ExprKind.Member =>
            var inner_result_cm: MemberPtrResult
            emit_member_ptr(s, op.left, @inner_result_cm)
            if inner_result_cm.success == 1
                let inner_field_cm: *StructField = inner_result_cm.field
                if inner_field_cm.field_type == TypeKind.Array
                    let idx_cm: i32 = emit_expr(s, op.right)
                    let elem_ptr_cm: i32 = next_reg(s)
                    format_into(s, "  %.{elem_ptr_cm} = getelementptr [{inner_field_cm.array_size as i64} x ")
                    if inner_field_cm.array_elem_type == TypeKind.Struct and inner_field_cm.array_elem_type_name_len > 0
                        let name_ir11: String = ir_name(StrView { ptr: (inner_field_cm.array_elem_type_name), len: (inner_field_cm.array_elem_type_name_len) as i64 })
                        format_into(s, "%{name_ir11.as_view()}")
                    else
                        # AGAST #1814: the field's declared element type.
                        format_into(s, "{elem_mem_llvm(inner_field_cm.array_elem_type)}")
                    format_into(s, "], ptr %.{inner_result_cm.reg}, i64 0, i64 %.{idx_cm}\n")
                    return Some(elem_ptr_cm)
        _ => pass
    None


# `e.f` as a place: its address, when lowered.
fn lvalue_ptr_of_member(s: *EmitterState, op: *Expr) -> Option<i32>
    # Handle @local_struct.field - address of a field in a local struct
    if op.left.kind == ExprKind.Ident
        # Try to find as local struct variable
        let local: *LocalVar = find_local_struct_name(s, op.left.ident)
        if local != null
            # Check if it's a struct, or a pointer/reference to a struct
            var is_struct_or_ref: bool = false
            match lv_var_type(local)
                TypeKind.Struct =>
                    is_struct_or_ref = true
                TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                    # Check if it points to a struct (has type_name set)
                    if lv_type_name_len(local) > 0
                        is_struct_or_ref = true
                _ => pass
            if is_struct_or_ref
                # Found a local struct or ref to struct - get the struct definition
                let st: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                if st != null
                    let field_idx: i32 = find_field_index(st, op.ident)
                    if field_idx >= 0
                        if lv_var_type(local) == TypeKind.Struct
                            # Direct struct - GEP from local.reg directly
                            let field_ptr: i32 = next_reg(s)
                            gep_struct_open(s, field_ptr, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                            format_into(s, ", ptr %.{local.reg}, i32 0, i32 {field_idx as i64}\n")
                            # Convert pointer to i64
                            return Some(field_ptr)
                        else
                            # Ptr/ref - native ptr load (task #73 migration)
                            let loaded_ptr: i32 = emit_load_levels(s, local.reg, local_struct_levels(local))
                            let field_ptr: i32 = next_reg(s)
                            gep_struct_open(s, field_ptr, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                            format_into(s, ", ptr %.{loaded_ptr}, i32 0, i32 {field_idx as i64}\n")
                            # Convert pointer to i64
                            return Some(field_ptr)
    None


# AGAST #1959 / #1955 / #1541: the LLVM float type of a negated operand, or
# null when it is an integer.  A float literal is `double` (get_expr_type
# says f64), so `-1.5` is a double that the f32 binding / argument sites
# narrow just as they narrow `1.5`.
fn neg_float_llvm_type(s: *EmitterState, operand: *Expr) -> StrView
    match expr_slot_ty(operand)
        TypeKind.F32 => "float"
        TypeKind.F64 => "double"
        _ => no_name()

pub fn emit_expr_unary(s: *EmitterState, e: *Expr) -> i32
    match e.op
        OpKind.Neg =>
            let fty: StrView = neg_float_llvm_type(s, e.operand)
            let operand: i32 = emit_expr(s, e.operand)
            let result: i32 = next_reg(s)
            if not unnamed(fty)
                # `fneg`, as ritz0 emits: `sub i64 0, %double` is invalid IR.
                format_into(s, "  %.{result} = fneg {fty} %.{operand}\n")
                return result
            format_into(s, "  %.{result} = sub i64 0, %.{operand}\n")
            return result
        OpKind.Not =>
            let operand: i32 = emit_expr(s, e.operand)
            let result: i32 = next_reg(s)
            format_into(s, "  %.{result} = icmp eq i64 %.{operand}, 0\n")
            let ext: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, result)
            return ext
        OpKind.Deref => emit_unary_deref(s, e)
        OpKind.Addr => emit_unary_addr(s, e)
        OpKind.AddrMut => emit_unary_addr_mut(s, e)
        OpKind.BitNot => emit_unary_bitnot(s, e)
        OpKind.Unset | OpKind.Add | OpKind.Sub | OpKind.Mul | OpKind.Div | OpKind.Mod | OpKind.Eq | OpKind.Ne | OpKind.Lt | OpKind.Gt | OpKind.Le | OpKind.Ge | OpKind.And | OpKind.Or | OpKind.BitAnd | OpKind.BitOr | OpKind.BitXor | OpKind.Shl | OpKind.Shr | OpKind.AddWrap | OpKind.SubWrap | OpKind.MulWrap =>
            emit_ir_error_sv(s, e.span, "not a unary operator")
            0

# `*p`: the value it points at, loaded at its pointee type.
fn emit_unary_deref(s: *EmitterState, e: *Expr) -> i32
    if deref_names_array(s, e.operand)
        emit_whole_array_error(s, e)   # AGAST #2287: `*p` for `p: *[N]T`; #2304: `*w.p`, `*P`, `*(p + 1)`
        return 0
    # AGAST #2971: `*h` of an integer or `bool` borrow `h:& T` is `h`, as
    # ritz0 reads it (#2045): bind_scalar_borrow_param binds `h` as the
    # caller's T, so it already reads as the referent.  This loaded
    # through the int's value as an address, and segfaulted.
    if lent_scalar_ident(s, e.operand) != null
        return emit_expr(s, e.operand)
    let addr: i32 = emit_expr(s, e.operand)
    # Convert i64 address to ptr.  AGAST #1644: a TypeKind.MutRef local
    # (`x: @&T`) already loads as `ptr`, so casting it is invalid IR.
    # Mirrors the `*x = v` store path (AGAST #173).
    var ptr: i32 = addr
    if deref_operand_is_ptr(s, e.operand) == 0
        ptr = next_reg(s)
        format_into(s, "  %.{ptr} = inttoptr i64 %.{addr} to ptr\n")
    # AGAST #1505: a pointee statically known to be a struct loads that
    # struct, whatever get_expr_type guessed (it reports TypeKind.I64 for a
    # let-local `*S` and TypeKind.U8 for an unrecorded `*S` field pointee).
    let sname: StrView = deref_pointee_struct_name(s, e.operand)
    if sname.len > 0
        let sresult: i32 = next_reg(s)
        # AGAST #2204: a `*v4i32` pointee is the vector `<4 x i32>`, not a
        # struct `%v4i32` (clang: "load operand must be a pointer to a
        # first class type").  emit_llvm_type_struct maps SIMD names.
        emit_struct_load_or_defer(s, TypeKind.Struct, sresult, sname, ptr, no_name())
        return sresult
    # Determine load type based on pointee type
    let deref_type: TypeKind = expr_slot_ty(e)
    match deref_type
        TypeKind.F32 | TypeKind.F64 =>
            # AGAST #2022: a *f32 / *f64 pointee loads `float` / `double`
            # and is returned as-is (no widen), as `p[i]` does (#1973).  It
            # fell to the i64 default, so `*p != x` emitted
            # `fcmp float <i64>`, which clang rejects.
            let fresult: i32 = next_reg(s)
            format_into(s, "  %.{fresult} = load {elem_mem_llvm(deref_type)}, ptr %.{ptr}\n")
            return fresult
        TypeKind.Bool =>
            # AGAST #2053: a `*bool` pointee is an `i1`; zext it to the i64
            # bools are carried in.  (The i64 default read 7 bytes past it.)
            let bval: i32 = next_reg(s)
            emit_load_into(s, "i1", bval, ptr)
            let bresult: i32 = ir_zext_i1_i64(s.out, @s.reg_counter, bval)
            return bresult
        _ =>
            if ty_int_bits(deref_type) == 8
                # Load i8 and sign/zero-extend to i64.  AGAST #2021: `*p` on a
                # *i8 sexts, as p[i] does; zext made a negative pointee 0xFD.
                let byte_val: i32 = next_reg(s)
                emit_load_into(s, "i8", byte_val, ptr)
                let result: i32 = next_reg(s)
                format_into(s, "  %.{result}")
                if deref_type == TypeKind.I8
                    format_into(s, " = sext i8 ")
                else
                    format_into(s, " = zext i8 ")
                format_into(s, "%.{byte_val} to i64\n")
                return result
            else if ty_int_bits(deref_type) == 16
                # Load i16 and sign/zero-extend to i64
                let val16: i32 = next_reg(s)
                emit_load_into(s, "i16", val16, ptr)
                let result: i32 = next_reg(s)
                format_into(s, "  %.{result}")
                if deref_type == TypeKind.I16
                    format_into(s, " = sext i16 ")
                else
                    format_into(s, " = zext i16 ")
                format_into(s, "%.{val16} to i64\n")
                return result
            else if ty_int_bits(deref_type) == 32
                # Load i32 and sign/zero-extend to i64 (unified value model)
                # Critical: reading i64 from a 4-byte slot reads 4 bytes of
                # adjacent stack/heap = garbage upper half.
                let val32: i32 = next_reg(s)
                emit_load_into(s, "i32", val32, ptr)
                let result: i32 = next_reg(s)
                format_into(s, "  %.{result}")
                if deref_type == TypeKind.I32
                    format_into(s, " = sext i32 ")
                else
                    format_into(s, " = zext i32 ")
                format_into(s, "%.{val32} to i64\n")
                return result
            else if deref_type == TypeKind.Struct or if_arm_names_pointee(s, e.operand)
                # AGAST #1505: the pointee is a struct but deref_pointee_struct_name
                # could not name it.  This used to fall back silently to
                # `load i64`, which clang rejects as soon as the value meets a
                # struct slot.  Report it at the deref's source position instead.
                emit_ir_error_sv(s, e.span, "cannot determine the struct type loaded by this '*' deref")
                let result: i32 = next_reg(s)
                emit_load_into(s, "i64", result, ptr)
                return result
            else
                # Default: load i64
                let result: i32 = next_reg(s)
                emit_load_into(s, "i64", result, ptr)
                return result

# `@x`: its address, in the i64 value model.
fn emit_unary_addr(s: *EmitterState, e: *Expr) -> i32
    if const_scalar_addr_refused(s, e)
        return 0
    let lend_from: i32 = own_temp_mark(s)
    let addr_ptr: i32 = emit_lvalue_ptr(s, e.operand)
    own_lend_temps(s, e.operand, lend_from)   # AGAST #3050
    if addr_ptr >= 0
        # `@expr` is an i64 in ritz1's value model.
        let result: i32 = ir_ptrtoint_i64(s.out, @s.reg_counter, addr_ptr)
        return result
    emit_ir_error_sv(s, e.span, "cannot take address")
    return 0

# `@&x`: its address, as a `ptr`.
fn emit_unary_addr_mut(s: *EmitterState, e: *Expr) -> i32
    # @&expr - mutable address-of, returns ptr type (not i64)
    if const_scalar_addr_refused(s, e)   # LARB R48: `@&N`
        return 0
    let lend_mut_from: i32 = own_temp_mark(s)
    let addr_mut_ptr: i32 = emit_lvalue_ptr(s, e.operand)
    own_lend_temps(s, e.operand, lend_mut_from)   # AGAST #3050
    if addr_mut_ptr >= 0
        return addr_mut_ptr
    emit_ir_error_sv(s, e.span, "cannot take mutable address")
    return 0

# `~x`, read back at x's type.
fn emit_unary_bitnot(s: *EmitterState, e: *Expr) -> i32
    let operand: i32 = emit_expr(s, e.operand)
    let result: i32 = next_reg(s)
    format_into(s, "  %.{result} = xor i64 %.{operand}, -1\n")
    # AGAST #3225: `~m` on a u32 of 0 is 4294967295, not the i64's -1, in
    # whatever it lands in: a wider slot (`let w: i64 = ~m`) or a sum that
    # runs there (`~m + 1`) reads it as is, so it's brought back here.
    var not_uns: i32 = 0
    let not_bits: i32 = int_operand_shape(s, e.operand, @not_uns)
    return emit_narrow_operand(s, e, result, not_bits, not_uns == 1)


# =============================================================================
# Integer overflow traps (LARB R63, AGAST #3489)
# =============================================================================
# ritz0's #3488 (emitter/exprs.py, _emit_checked_int_arith and its guards), on
# ritz1's i64 value model.  `+`, `-` and `*` stop the program on overflow at
# their type: the wider slot's (#3225) when they land directly in one, else
# int_operand_shape's.  `+%`, `-%` and `*%` wrap and never come here.  `/` and
# `%` stop on a zero divisor and on signed MIN / -1, and a shift on a count
# outside 0..width-1; bits `<<` shifts out are not an overflow.
#
# The operands are brought to the operation's type (trunc), run through
# `llvm.<s|u><op>.with.overflow.iN`, and the result is extended back to the
# i64 every integer is held in, by the type's signedness.  The overflow flag
# branches to a block that calls @__ritz_overflow_trap, a cold module-local
# fn that writes the located message to stderr and exits 1, then
# `unreachable`.  The message is ritz0's: `<file>:<line>:<col>: integer
# overflow in `+``.  Two constant operands make the trap certain, so that is
# a compile error instead, as in ritz0.
#
# A freestanding target stops through ritz_platform_fatal instead (AGAST
# #4607), with no trailing newline in the message: the hook adds it (#4617).

# The intrinsics this module called, and whether it called the trap fn:
# bit (op * 2 + unsigned) * 4 + width index, and OVF_TRAP_USED.  Read and
# cleared by emit_overflow_helpers at the end of the module.
var g_ovf_used: i32 = 0
const OVF_TRAP_USED: i32 = 16777216    # 1 << 24, past the 24 intrinsic bits


fn ovf_width_index(bits: i32) -> i32
    match bits
        8 => 0
        16 => 1
        32 => 2
        _ => 3

# The `.with.overflow` intrinsic `op` is checked through (ovf_intrinsic's
# index), or None for an operator with none.
fn ovf_op_index(op: OpKind) -> Option<i32>
    match op
        OpKind.Add => Some(0)
        OpKind.Sub => Some(1)
        OpKind.Mul => Some(2)
        _ => None

# Why a checked operation stops the program, as ritz0 words it.
enum Trap
    Safe
    Overflow
    DivideByZero
    ShiftRange

fn trap_text(t: Trap) -> StrView
    match t
        Trap.Overflow => "integer overflow in"
        Trap.DivideByZero => "division by zero in"
        Trap.ShiftRange => "shift count out of range in"
        Trap.Safe => ""   # nothing stops: never printed

# The type an operation runs at: its width (8, 16, 32 or 64) and signedness.
struct OperandType
    bits: i32
    unsigned: bool

# What `e` runs at: its wider slot's type, else its operands' (int_operand_shape,
# ritz0's unified operand type).
fn ovf_op_type(s: *EmitterState, e: *Expr) -> OperandType
    var bits: i32 = 0
    var uns: i32 = 0
    let wider: TypeKind = wider_slot_type(s, e)
    if wider != TypeKind.Void
        uns = ty_is_unsigned(wider)
        bits = ty_bits(wider)
    else
        bits = int_operand_shape(s, e, @uns)
    if bits != 8 and bits != 16 and bits != 32
        bits = 64
    OperandType { bits: bits, unsigned: uns == 1 }

# The minimum of the signed `bits`-wide type; `-%` because at 64 bits it is
# 0 -% i64::MIN, which wraps to itself (LARB R63).
fn ovf_type_min(bits: i32) -> i64
    0 -% (1 << (bits as i64 - 1))

# The source's base name, as an assert's message gives it.
fn source_base_name() -> StrView
    let file: *u8 = emitter_source_file()
    if file == null
        return "?"
    let path: StrView = strview_from_cstr(file)
    var start: i64 = 0
    for k in 0..path.len
        if path.get(k) == '/'
            start = k + 1
    StrView { ptr: path.ptr + start, len: path.len - start }

# A trap's message as a string-table entry: `<file>:<line>:<col>: <what> `<op>`\n`.
# Freestanding, it has no `\n`: ritz_platform_fatal adds it (#4617).
struct TrapMessage
    index: i32    # its string-table entry
    len: i64

fn trap_message(s: *EmitterState, e: *Expr, what: Trap) -> TrapMessage
    let file: StrView = source_base_name()
    let op: StrView = binary_op_spelling(e.op)
    let newline: StrView = if (s.platform_stop & PSTOP_FREESTANDING) == 0 then "\n" else ""
    var text: String = string_new()
    format_into(@&text, "{file}:{e.span.line}:{e.span.col}: {trap_text(what)} `{op}`{newline}")
    TrapMessage { index: intern_string(s, text.as_view()), len: text.len() }

# Stop the program, with `what` at `e`, when i1 register `cond` is true; the
# builder continues in the block where it is false.
fn ovf_guard(s: *EmitterState, e: *Expr, cond: i32, what: Trap)
    let msg: TrapMessage = trap_message(s, e, what)
    let bad: i32 = next_label(s)
    let ok: i32 = next_label(s)
    format_into(s, "  br i1 %.{cond}, label %L{bad}, label %L{ok}\n")
    begin_block(s, bad)
    format_into(s, "  call void @__ritz_overflow_trap(ptr @.str.{msg.index}, i64 {msg.len})\n  unreachable\n")
    begin_block(s, ok)
    g_ovf_used = g_ovf_used | OVF_TRAP_USED

# The value of a constant operand: a literal, `-literal`, or an integer const
# no local or global shadows; None for anything else.
fn ovf_const_operand(s: *EmitterState, e: *Expr) -> Option<i64>
    var lit: i64 = 0
    if lit_int_value(e, @lit) == 1
        return Some(lit)
    if e.kind != ExprKind.Ident
        return None
    let ce: *ConstEntry = unshadowed_const(s, e.ident)
    if ce == null or ce.fold_state != CONST_FOLD_DONE or is_int_const_type(ce.const_type) == 0
        return None
    Some(ce.value)

# What a constant `e` can only do: stop the program (ritz0's
# _check_constant_arith, _guard_division and _guard_shift_count on two
# constants, one, the count, for a shift), or nothing.
fn const_trap(s: *EmitterState, e: *Expr, ty: OperandType) -> Trap
    let right: Option<i64> = ovf_const_operand(s, e.right)
    var b: i64 = 0
    match right
        Some(v) => b = v
        None => return Trap.Safe
    if e.op == OpKind.Shl or e.op == OpKind.Shr
        if b >= 0 and b < ty.bits as i64
            return Trap.Safe
        return Trap.ShiftRange
    var a: i64 = 0
    match ovf_const_operand(s, e.left)
        Some(v) => a = v
        None => return Trap.Safe
    if ty.bits < 64 and ty.unsigned
        let mask: i64 = (1 << (ty.bits as i64)) - 1
        a = a & mask
        b = b & mask
    if e.op == OpKind.Div or e.op == OpKind.Mod
        if b == 0
            return Trap.DivideByZero
        if not ty.unsigned and b == -1 and a == ovf_type_min(ty.bits)
            return Trap.Overflow
        return Trap.Safe
    let uns: i32 = if ty.unsigned then 1 else 0
    if int_op_overflows(e.op, a, b, ty.bits, uns) == 1
        return Trap.Overflow
    Trap.Safe

# Refuse a constant `e` whose operation can only stop the program: true if
# refused.
fn ovf_const_refused(s: *EmitterState, e: *Expr, ty: OperandType) -> bool
    let trap: Trap = const_trap(s, e, ty)
    if trap == Trap.Safe
        return false
    emit_nd_error_begin(s, e.span.line, e.span.col)
    eprint("{trap_text(trap)} `{binary_op_spelling(e.op)}`\n")
    true

# `@llvm.<s|u><add|sub|mul>.with.overflow.i<bits>`: what the intrinsic is called.
fn ovf_intrinsic(opi: i32, unsigned: bool, bits: i32) -> String
    let sign: StrView = if unsigned then "u" else "s"
    let op: StrView = match opi
        0 => "add"
        1 => "sub"
        _ => "mul"
    var name: String = string_new()
    format_into(@&name, "@llvm.{sign}{op}.with.overflow.i{bits}")
    name

# `reg` (an i64) at `bits`, a new register.
fn ovf_trunc(s: *EmitterState, reg: i32, bits: i32) -> i32
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = trunc i64 %.{reg} to i{bits}\n")
    r

# `left op right` (`+`, `-` or `*`) at e's type, stopping on overflow; the
# result is an i64 register, 0 if the operation was refused.
fn ovf_checked_arith(s: *EmitterState, e: *Expr, left: i32, right: i32) -> i32
    var opi: i32 = 0
    match ovf_op_index(e.op)
        Some(i) => opi = i
        None =>
            emit_ir_error_sv(s, e.span, "no overflow check for this operator")
            return 0
    let ty: OperandType = ovf_op_type(s, e)
    let bits: i32 = ty.bits
    if ovf_const_refused(s, e, ty)
        return 0
    var a: i32 = left
    var b: i32 = right
    if bits < 64
        a = ovf_trunc(s, left, bits)
        b = ovf_trunc(s, right, bits)
    let uns: i32 = if ty.unsigned then 1 else 0
    g_ovf_used = g_ovf_used | (1 << ((opi * 2 + uns) * 4 + ovf_width_index(bits)))
    let pair: i32 = next_reg(s)
    let callee: String = ovf_intrinsic(opi, ty.unsigned, bits)
    format_into(s, "  %.{pair} = call {{ i{bits}, i1 }} {callee.as_view()}(i{bits} %.{a}, i{bits} %.{b})\n")
    let val: i32 = ovf_extract(s, pair, bits, 0)
    let flag: i32 = ovf_extract(s, pair, bits, 1)
    ovf_guard(s, e, flag, Trap.Overflow)
    if bits == 64
        return val
    let wide: i32 = next_reg(s)
    let extend: StrView = if ty.unsigned then "zext" else "sext"
    format_into(s, "  %.{wide} = {extend} i{bits} %.{val} to i64\n")
    wide

fn ovf_extract(s: *EmitterState, pair: i32, bits: i32, field: i32) -> i32
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = extractvalue {{ i{bits}, i1 }} %.{pair}, {field}\n")
    r

# An i1 register: `reg pred value` on i64s.
fn ovf_icmp(s: *EmitterState, pred: StrView, reg: i32, value: i64) -> i32
    let r: i32 = next_reg(s)
    format_into(s, "  %.{r} = icmp {pred} i64 %.{reg}, {value}\n")
    r

# `/` and `%`: stop on a zero divisor, and on signed MIN / -1 at e's type.
# The operands are already read back at that type (emit_expr_binary).  False
# if the operation was refused.
fn ovf_division_guard(s: *EmitterState, e: *Expr, left: i32, right: i32) -> bool
    let ty: OperandType = ovf_op_type(s, e)
    if ovf_const_refused(s, e, ty)
        return false
    ovf_guard(s, e, ovf_icmp(s, "eq", right, 0), Trap.DivideByZero)
    if ty.unsigned
        return true
    let is_min: i32 = ovf_icmp(s, "eq", left, ovf_type_min(ty.bits))
    let is_m1: i32 = ovf_icmp(s, "eq", right, -1)
    let both: i32 = next_reg(s)
    format_into(s, "  %.{both} = and i1 %.{is_min}, %.{is_m1}\n")
    ovf_guard(s, e, both, Trap.Overflow)
    true

# `<<` and `>>`: stop unless the count is in 0..width-1.  An unsigned compare
# catches a negative count too: as a u64 it is far above the width.  False if
# the operation was refused.
fn ovf_shift_guard(s: *EmitterState, e: *Expr, count: i32) -> bool
    let ty: OperandType = ovf_op_type(s, e)
    if ovf_const_refused(s, e, ty)
        return false
    ovf_guard(s, e, ovf_icmp(s, "uge", count, ty.bits as i64), Trap.ShiftRange)
    true

# emit_expr_binary's integer step: the result register of a checked `+ - *`
# (0 if refused), 0 for a refused `/ % << >>`, else -1: the caller emits the
# operation itself, after any guard this emitted.
fn arith_trap_guard(s: *EmitterState, e: *Expr, left: i32, right: i32) -> i32
    match e.op
        OpKind.Add | OpKind.Sub | OpKind.Mul =>
            if e.wrapping == 1
                return -1
            return ovf_checked_arith(s, e, left, right)
        OpKind.Div | OpKind.Mod =>
            if not ovf_division_guard(s, e, left, right)
                return 0
        OpKind.Shl | OpKind.Shr =>
            if not ovf_shift_guard(s, e, right)
                return 0
        _ => pass
    -1

# The declarations of the intrinsics this module called and its trap fn;
# resets the record for the next module.  `cold` keeps the trap blocks off
# the hot path; `noinline` keeps each a call, not a copy of the syscalls.
pub fn emit_overflow_helpers(s: *EmitterState)
    var bit: i32 = 0
    while bit < 24
        if (g_ovf_used & (1 << bit)) != 0
            var bits: i32 = 64
            if bit % 4 < 3
                bits = 8 << (bit % 4)
            let callee: String = ovf_intrinsic(bit / 8, ((bit / 4) % 2) == 1, bits)
            format_into(s, "declare {{ i{bits}, i1 }} {callee.as_view()}(i{bits}, i{bits})\n")
        bit += 1
    if (g_ovf_used & OVF_TRAP_USED) != 0
        format_into(s, "define internal void @__ritz_overflow_trap(ptr %msg, i64 %len) cold noinline noreturn nounwind")
        emit_no_red_zone_attr(s)
        format_into(s, " {{\nentry:\n")
        if (s.platform_stop & PSTOP_FREESTANDING) != 0
            # A kernel stops through its own hook, as ritz0's _emit_trap
            # does: no exit syscall in its IR (AGAST #4607).
            s.platform_stop = s.platform_stop | PSTOP_USED
            format_into(s, "  call void @ritz_platform_fatal(ptr %msg, i64 %len, i32 1)\n  unreachable\n}}\n")
        else
            format_into(s, "  %w = call i64 asm sideeffect \"syscall\", \"=&{{rax}},{{rax}},{{rdi}},{{rsi}},{{rdx}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 1, i64 2, ptr %msg, i64 %len)\n  %x = call i64 asm sideeffect \"syscall\", \"=&{{rax}},{{rax}},{{rdi}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 60, i64 1)\n  unreachable\n}}\n")
    g_ovf_used = 0
