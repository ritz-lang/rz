# Auto-extracted from emitter_expr.ritz — BINARY + UNARY expression codegen.
# Part of the emit_expr split (#73 follow-on). Each function takes the
# EmitterState and an *Expr of the matching EXPR_* kind and returns the result
# register index, or 0 on an error path.

import ast
import ast_helpers   # is_enum_type (AGAST #2539)
import emitter_core
import index_through
import emitter_expr
import emitter_expr_access   # emit_whole_array_error (AGAST #2287)
import emitter_stmt          # array_ptr_local (AGAST #2287)
import bool_check   # AGAST #2342
import emitter_expr_call   # method_call_def (AGAST #1635)


# The Option / Result `e` is, by its type, or as a constructor naming one; null.
fn tagged_enum_operand(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if builtin_tagged_ctor(s, e) == 1
        ctor_scrutinee_enum(s, e, out_name, out_len)
        if *out_name == null   # a payload ritz1 can't name: its family will do
            if ctor_family_is(e, c"Option$", 7) == 1
                *out_name = c"Option"
                *out_len = 6
            else
                *out_name = c"Result"
                *out_len = 6
        return
    var name: *u8 = null
    var len: i32 = 0
    match_scrutinee_type(s, e, @name, @len)
    if name != null and is_tagged_enum_type(name, len) == 1
        *out_name = name
        *out_len = len

# AGAST #2454: `o == None`, `r != Ok(5)`, `o == p` over an Option or a Result is
# ritz0's located refusal: a variant carries a payload, so `==` would compare
# the tags alone.  ritz1 compiled it: `None` had no enum and was the `add i64
# 0, 0` fallback, and two Options were an `icmp` clang rejects.  A user's
# payload enum is refuse_aggregate_eq's (#2510).  1 when refused.
fn refuse_tagged_enum_eq(s: *EmitterState, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    tagged_enum_operand(s, e.left, @name, @len)
    if name == null or builtin_tagged_ctor(s, e.left) == 1
        # A typed side names the enum better than a constructor's guess.
        var rname: *u8 = null
        var rlen: i32 = 0
        tagged_enum_operand(s, e.right, @rname, @rlen)
        if rname != null and (name == null or builtin_tagged_ctor(s, e.right) == 0)
            name = rname
            len = rlen
    if name == null
        return 0
    var op: *u8 = c"'=='"
    if e.op == OP_NE
        op = c"'!='"
    var n: i32 = 0
    let head: *u8 = ctor_join(op, 4, c" is not supported for struct type '", strlen(c" is not supported for struct type '") as i32, name, len, @n)
    let tail: *u8 = c"' — a variant carries a payload, so `==` would compare tags only; use `match` to test the variant"
    let msg: *u8 = ctor_join(head, n, tail, strlen(tail) as i32, c"", 0, @n)
    emit_nd_error(s, e.span.line, e.span.col, msg)
    1

# The by-value struct or user enum `e` is, as its LLVM type names it; null when
# it is a scalar, a pointer, or not statically known.
fn eq_aggregate_operand(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var name: *u8 = null
    var len: i32 = 0
    if e.kind == EXPR_MEMBER
        qualified_variant_enum(s, e, @name, @len)   # `Shape.Dot`
        if name == null
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type == TYPE_STRUCT and fld.field_type_name_len > 0
                name = fld.field_type_name
                len = fld.field_type_name_len
    else
        resolve_expr_struct_name(s, e, @name, @len)
    if name == null or len == 0 or is_tagged_enum_type(name, len) == 1
        return
    let ei: i32 = enum_find(name, len)
    if ei >= 0
        # A fieldless enum compares its tags (#1660); one with a payload can't.
        var vi: i32 = 0
        var payload: i32 = 0
        while vi < enum_variant_count(ei)
            if enum_variant_kind(ei, vi) != ENUM_VARIANT_UNIT
                payload = 1
            vi = vi + 1
        if payload == 0
            return
    else if find_struct(s, name, len) == null and name_eq(name, len, c"StrView", 7) == 0 and name_eq(name, len, c"String", 6) == 0
        return
    *out_name = name
    *out_len = len

# AGAST #2510: `==` / `!=` on a user enum whose variants carry a payload, or on
# a struct, is ritz0's located refusal (_reject_aggregate_compare).  ritz1
# compared a payload enum's tags alone (`Circle(1) == Circle(2)` was true) and
# wrote a struct as an `icmp eq i64` clang rejects.  The left operand names the
# type, as in ritz0; the right one when the left is no aggregate.  1 when refused.
fn refuse_aggregate_eq(s: *EmitterState, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    eq_aggregate_operand(s, e.left, @name, @len)
    if name == null
        eq_aggregate_operand(s, e.right, @name, @len)
    if name == null
        return 0
    var op: *u8 = c"'=='"
    if e.op == OP_NE
        op = c"'!='"
    var hint: *u8 = c""
    if enum_find(name, len) >= 0
        hint = c" — a variant carries a payload, so `==` would compare tags only; use `match` to test the variant"
    else if name_eq(name, len, c"StrView", 7) == 1
        hint = c" — use strview_eq(@a, @b) from ritzlib.strview"
    else if name_eq(name, len, c"String", 6) == 1
        hint = c" — use string_eq_string(@a, @b) from ritzlib.string"
    var n: i32 = 0
    let head: *u8 = ctor_join(op, 4, c" is not supported for struct type '", strlen(c" is not supported for struct type '") as i32, name, len, @n)
    let msg: *u8 = ctor_join(head, n, c"'", 1, hint, strlen(hint) as i32, @n)
    emit_nd_error(s, e.span.line, e.span.col, msg)
    1

fn emit_expr_binary(s: *EmitterState, e: *Expr) -> i32
    bool_check_binary(s, e)   # AGAST #2342
    # Short-circuit logical AND / OR.  Without this, ritz1 emits
    #   %r = and i64 %left, %right
    # which evaluates BOTH operands eagerly — `a and *p == 'x'` always
    # dereferences `p` even when `a` is false.  ritz0 implements proper
    # short-circuit via control flow + phi.  The selfhost-emit-strview
    # SEGV (Wave 5E) was a downstream consequence: a code path inside
    # emit_expr_call had `param_type == TYPE_STRUCT and *(param_type_name + 0)
    # == 'S' and ...` — when the param was a non-struct, the deref of a
    # null name fired anyway.  See ritz0 _emit_short_circuit_and (~3942).
    if e.op == OP_AND
        # Synthetic anchor block — gives us a known predecessor label for
        # the phi.  s.current_label may be stale at the function entry
        # block (which is named `entry`, not a number), so we can't rely
        # on it being a valid number.  LLVM optimizes the trivial branch
        # away.
        let sa_anchor: i32 = next_label(s)
        emit_str(s, c"  br label %")
        emit_label(s, sa_anchor)
        emit_str(s, c"\n")
        begin_block(s, sa_anchor)
        let sa_left_val: i32 = emit_expr(s, e.left)
        let sa_left_bool: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sa_left_bool)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, sa_left_val)
        emit_str(s, c", 0\n")
        let sa_entry_label: i32 = s.current_label
        let sa_right_label: i32 = next_label(s)
        let sa_end_label: i32 = next_label(s)
        emit_str(s, c"  br i1 ")
        emit_reg(s, sa_left_bool)
        emit_str(s, c", label %")
        emit_label(s, sa_right_label)
        emit_str(s, c", label %")
        emit_label(s, sa_end_label)
        emit_str(s, c"\n")
        # Right branch — only entered when left was truthy
        begin_block(s, sa_right_label)
        let sa_right_val: i32 = emit_expr(s, e.right)
        let sa_right_bool: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sa_right_bool)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, sa_right_val)
        emit_str(s, c", 0\n")
        let sa_right_ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sa_right_ext)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, sa_right_bool)
        emit_str(s, c" to i64\n")
        let sa_right_exit: i32 = s.current_label
        emit_str(s, c"  br label %")
        emit_label(s, sa_end_label)
        emit_str(s, c"\n")
        # End — phi merges short-circuit (false) and full-eval branches.
        begin_block(s, sa_end_label)
        let sa_phi: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sa_phi)
        emit_str(s, c" = phi i64 [ 0, %")
        emit_label(s, sa_entry_label)
        emit_str(s, c" ], [ ")
        emit_reg(s, sa_right_ext)
        emit_str(s, c", %")
        emit_label(s, sa_right_exit)
        emit_str(s, c" ]\n")
        return sa_phi
    if e.op == OP_OR
        let so_anchor: i32 = next_label(s)
        emit_str(s, c"  br label %")
        emit_label(s, so_anchor)
        emit_str(s, c"\n")
        begin_block(s, so_anchor)
        let so_left_val: i32 = emit_expr(s, e.left)
        let so_left_bool: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, so_left_bool)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, so_left_val)
        emit_str(s, c", 0\n")
        let so_entry_label: i32 = s.current_label
        let so_right_label: i32 = next_label(s)
        let so_end_label: i32 = next_label(s)
        # Inverted: if left truthy, skip right (result already true).
        emit_str(s, c"  br i1 ")
        emit_reg(s, so_left_bool)
        emit_str(s, c", label %")
        emit_label(s, so_end_label)
        emit_str(s, c", label %")
        emit_label(s, so_right_label)
        emit_str(s, c"\n")
        begin_block(s, so_right_label)
        let so_right_val: i32 = emit_expr(s, e.right)
        let so_right_bool: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, so_right_bool)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, so_right_val)
        emit_str(s, c", 0\n")
        let so_right_ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, so_right_ext)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, so_right_bool)
        emit_str(s, c" to i64\n")
        let so_right_exit: i32 = s.current_label
        emit_str(s, c"  br label %")
        emit_label(s, so_end_label)
        emit_str(s, c"\n")
        begin_block(s, so_end_label)
        let so_phi: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, so_phi)
        emit_str(s, c" = phi i64 [ 1, %")
        emit_label(s, so_entry_label)
        emit_str(s, c" ], [ ")
        emit_reg(s, so_right_ext)
        emit_str(s, c", %")
        emit_label(s, so_right_exit)
        emit_str(s, c" ]\n")
        return so_phi

    # Check if this is pointer arithmetic (ptr + int or ptr - int).
    # If the left operand is a pointer, scale the right operand by the
    # pointee size.  ptr_arith_elem_size (emitter_core) owns the whole
    # classification — simple identifier (`p + i`), member access
    # (`s.ptr + i`), global pointer var, and, since AGAST #1361, a
    # left-associated chain (`s.ptr + i - 1`) whose left operand is itself
    # a binary expression.  It returns 0 for "not a pointer"; a real element
    # size is never 0, so the sentinel is unambiguous.
    # AGAST #2928 / #2597: `q - p` on two pointers is their distance in
    # elements of the left's pointee: (q - p) / sizeof(T), an i64.
    if is_ptr_distance(s, e) == 1
        return emit_ptr_distance(s, e)

    var is_ptr_arith: i32 = 0
    var ptr_elem_size: i64 = 1
    if e.op == OP_ADD or e.op == OP_SUB
        let elem: i64 = ptr_operand_stride(s, e.left)
        if elem != 0
            is_ptr_arith = 1
            ptr_elem_size = elem

    if (e.op == OP_EQ or e.op == OP_NE) and refuse_tagged_enum_eq(s, e) == 1
        return 0   # AGAST #2454
    if (e.op == OP_EQ or e.op == OP_NE) and refuse_aggregate_eq(s, e) == 1
        return 0   # AGAST #2510

    var left_reg: i32 = emit_expr(s, e.left)
    var right_reg: i32 = emit_expr(s, e.right)

    # AGAST #1754: `p == s` with `p: *S` (i64) and `s: @&S` (`ptr`) -- the
    # compares below are all `icmp ... i64`, so bring a `ptr` operand into
    # the i64 value model.  A no-op for every non-`ptr` operand.
    if e.op == OP_EQ or e.op == OP_NE or e.op == OP_LT or e.op == OP_GT or e.op == OP_LE or e.op == OP_GE
        left_reg = ptr_value_to_i64(s, e.left, left_reg)
        right_reg = ptr_value_to_i64(s, e.right, right_reg)

    # AGAST #1660: a unit-enum operand is a `%Kind = { i8 }` aggregate, not
    # an i64 (`k == Kind.A`, `e.kind != c`, `x == y` on enum params).
    # Compare the tags: extract field 0 and widen it to the i64 the integer
    # compare below expects.  Either side may be the enum.
    if e.op == OP_EQ or e.op == OP_NE
        left_reg = unit_enum_tag_to_i64(s, e.left, left_reg)
        right_reg = unit_enum_tag_to_i64(s, e.right, right_reg)

    # For pointer arithmetic, scale the offset
    var scaled_right: i32 = right_reg
    if is_ptr_arith == 1 and ptr_elem_size > 1
        scaled_right = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, scaled_right)
        emit_str(s, c" = mul i64 ")
        emit_reg(s, right_reg)
        emit_str(s, c", ")
        emit_int(s, ptr_elem_size)
        emit_str(s, c"\n")

    # For pointer arithmetic, emit as `getelementptr i8` to preserve LLVM
    # pointer provenance (prevents -O2 mis-optimization of inttoptr-derived
    # stores). Result is ptrtoint'd back to i64 for the unified value model.
    if is_ptr_arith == 1
        # Convert left i64 → ptr.  AGAST #2554: an `@&T` / `@&[N]T` operand
        # (a param, an `@&` local, `@&v`) is already a `ptr`, and an
        # inttoptr of it is invalid IR; use it as is.
        var left_as_ptr: i32 = left_reg
        if expr_is_ptr_valued(s, e.left) == 0
            left_as_ptr = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, left_as_ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, left_reg)
            emit_str(s, c" to ptr\n")

        # For SUB, negate the scaled offset
        var offset_reg: i32 = scaled_right
        if e.op == OP_SUB
            offset_reg = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, offset_reg)
            emit_str(s, c" = sub i64 0, ")
            emit_reg(s, scaled_right)
            emit_str(s, c"\n")

        # getelementptr i8, ptr %left, i64 %offset — preserves provenance
        let gep_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, gep_reg)
        emit_str(s, c" = getelementptr i8, ptr ")
        emit_reg(s, left_as_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, offset_reg)
        emit_str(s, c"\n")

        # ptrtoint back to i64 (unified value model)
        let ptr_result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr_result)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, gep_reg)
        emit_str(s, c" to i64\n")
        return ptr_result

    # Float arithmetic / comparison dispatch.  When either operand is a
    # float, route through fadd/fsub/fmul/fdiv/fcmp instead of i64 ops.
    # The float result stays as `float`/`double` (no widening to i64) so
    # the surrounding emit-llvm-type knows what shape to write.  ritz0 uses
    # the same pattern via NamedType("f32")/("f64") string-name dispatch.
    let lty: i32 = get_expr_type(s, e.left)
    let rty: i32 = get_expr_type(s, e.right)
    let fty_t: i32 = binop_float_width(s, e)
    if fty_t != 0
        # AGAST #1965: coerce each float operand to the op's width -- fptrunc
        # a double literal for an f32 op, fpext an f32 operand for an f64
        # op.  `fcmp one float %f32, %double` is invalid IR.
        let lft: i32 = binop_operand_float_ty(s, e.left)
        let rft: i32 = binop_operand_float_ty(s, e.right)
        if lft != 0
            left_reg = emit_float_coerce(s, left_reg, lft, fty_t)
        if rft != 0
            scaled_right = emit_float_coerce(s, scaled_right, rft, fty_t)
        let fty: *u8 = float_llvm_name(fty_t)
        let result_f: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result_f)
        emit_str(s, c" = ")
        if e.op == OP_ADD
            emit_str(s, c"fadd ")
        else if e.op == OP_SUB
            emit_str(s, c"fsub ")
        else if e.op == OP_MUL
            emit_str(s, c"fmul ")
        else if e.op == OP_DIV
            emit_str(s, c"fdiv ")
        else if e.op == OP_EQ
            emit_str(s, c"fcmp oeq ")
        else if e.op == OP_NE
            emit_str(s, c"fcmp one ")
        else if e.op == OP_LT
            emit_str(s, c"fcmp olt ")
        else if e.op == OP_GT
            emit_str(s, c"fcmp ogt ")
        else if e.op == OP_LE
            emit_str(s, c"fcmp ole ")
        else if e.op == OP_GE
            emit_str(s, c"fcmp oge ")
        else
            emit_str(s, c"fadd ")
        emit_str(s, fty)
        emit_str(s, c" ")
        emit_reg(s, left_reg)
        emit_str(s, c", ")
        emit_reg(s, scaled_right)
        emit_str(s, c"\n")
        # Comparison ops produce i1 — zext to i64 for unified value model.
        if e.op == OP_EQ or e.op == OP_NE or e.op == OP_LT or e.op == OP_GT or e.op == OP_LE or e.op == OP_GE
            let ext: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ext)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, result_f)
            emit_str(s, c" to i64\n")
            return ext
        return result_f

    # AGAST #1604: u64 operands take the unsigned compare / div / rem.  Every
    # integer is held in an i64; u8/u16/u32 are zero-extended into it, so they
    # are never negative there and the signed ops already agree.  A u64 with
    # the top bit set is negative as an i64, so `sgt`/`sdiv`/`srem` got it
    # wrong.  Like ritz0's _infer_unsigned_expr, either operand being u64 is
    # enough (`a > 1` with `a: u64`).
    var uns: i32 = 0
    if lty == TYPE_U64 or rty == TYPE_U64
        uns = 1

    # AGAST #2356: `>>` follows the left operand alone, never the count.
    var shr_uns: i32 = 0
    if e.op == OP_SHR
        let shr_bits: i32 = int_operand_shape(s, e.left, @shr_uns)
        left_reg = emit_shr_operand(s, e.left, left_reg, shr_bits, shr_uns)

    # AGAST #1869: a failing `assert a OP b` prints the two operands, as the
    # i64s this compare reads (not a re-evaluation; see emit_assert_stmt).
    # The float path above records nothing, so its asserts print no values.
    if e == s.assert_cap_expr
        s.assert_cap_l = left_reg
        s.assert_cap_r = scaled_right
        s.assert_cap_ok = 1

    let result: i32 = next_reg(s)

    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = ")

    if e.op == OP_ADD
        emit_str(s, c"add i64 ")
    else if e.op == OP_SUB
        emit_str(s, c"sub i64 ")
    else if e.op == OP_MUL
        emit_str(s, c"mul i64 ")
    else if e.op == OP_DIV
        if uns == 1
            emit_str(s, c"udiv i64 ")
        else
            emit_str(s, c"sdiv i64 ")
    else if e.op == OP_MOD
        if uns == 1
            emit_str(s, c"urem i64 ")
        else
            emit_str(s, c"srem i64 ")
    else if e.op == OP_EQ
        emit_str(s, c"icmp eq i64 ")
    else if e.op == OP_NE
        emit_str(s, c"icmp ne i64 ")
    else if e.op == OP_LT
        if uns == 1
            emit_str(s, c"icmp ult i64 ")
        else
            emit_str(s, c"icmp slt i64 ")
    else if e.op == OP_GT
        if uns == 1
            emit_str(s, c"icmp ugt i64 ")
        else
            emit_str(s, c"icmp sgt i64 ")
    else if e.op == OP_LE
        if uns == 1
            emit_str(s, c"icmp ule i64 ")
        else
            emit_str(s, c"icmp sle i64 ")
    else if e.op == OP_GE
        if uns == 1
            emit_str(s, c"icmp uge i64 ")
        else
            emit_str(s, c"icmp sge i64 ")
    else if e.op == OP_AND
        emit_str(s, c"and i64 ")
    else if e.op == OP_OR
        emit_str(s, c"or i64 ")
    else if e.op == OP_BIT_AND
        emit_str(s, c"and i64 ")
    else if e.op == OP_BIT_OR
        emit_str(s, c"or i64 ")
    else if e.op == OP_BIT_XOR
        emit_str(s, c"xor i64 ")
    else if e.op == OP_SHL
        emit_str(s, c"shl i64 ")
    else if e.op == OP_SHR
        if shr_uns == 1
            emit_str(s, c"lshr i64 ")
        else
            emit_str(s, c"ashr i64 ")
    else
        emit_str(s, c"add i64 ")

    emit_reg(s, left_reg)
    emit_str(s, c", ")
    emit_reg(s, scaled_right)
    emit_str(s, c"\n")

    if e.op == OP_EQ or e.op == OP_NE or e.op == OP_LT or e.op == OP_GT or e.op == OP_LE or e.op == OP_GE
        let ext_result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext_result)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return ext_result

    return result

# AGAST #2356: the width in bits of integer expression `e`, with *uns set if it
# is unsigned.  get_expr_type says a binary has its left operand's type, which
# would make `(1 + a) >> 1` signed for `a: u64`.  Here the wider operand wins, at
# equal width the unsigned one does (as #1604 has it for `/` and `<`), and a
# shift keeps its left operand's signedness.  A literal is an i64, unless only a
# u64 can hold it, in which case the lexer has wrapped it negative: `-8` is a
# negated literal.  This is ritz0's _int_shape.
pub fn int_operand_shape(s: *EmitterState, e: *Expr, uns: *i32) -> i32
    *uns = 0
    if e.kind == EXPR_INT_LIT
        if e.int_val < 0
            *uns = 1
        return 64
    if e.kind == EXPR_UNARY and (e.op == OP_NEG or e.op == OP_BIT_NOT)
        return int_operand_shape(s, e.operand, uns)
    if e.kind == EXPR_BINARY and is_int_arith_op(e.op) == 1
        var lu: i32 = 0
        var ru: i32 = 0
        let lb: i32 = int_operand_shape(s, e.left, @lu)
        let rb: i32 = int_operand_shape(s, e.right, @ru)
        if e.op == OP_SHL or e.op == OP_SHR
            *uns = lu
            if rb > lb
                return rb
            return lb
        if lb > rb
            *uns = lu
            return lb
        if rb > lb
            *uns = ru
            return rb
        *uns = lu | ru
        return lb
    # A compare or `and` is a bool in an i64, whatever its operands are.
    if e.kind == EXPR_BINARY
        return 64
    let t: i32 = int_leaf_type(s, e)
    if t == TYPE_U64
        *uns = 1
        return 64
    var signed: i32 = 1
    let bits: i32 = type_code_scalar_bits(t, @signed)
    *uns = 1 - signed
    bits

# The declared type of a non-operator expression.  get_expr_type answers what its
# callers need, whether a value is a float or a pointer, so a u64 array element,
# const or method result is the i64 it is held in.  Every one of those is a u64
# that an `ashr` would sign-fill, so the forms it can't type are resolved here.
fn int_leaf_type(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        if find_local_idx(s, e.ident_ptr, e.ident_len) < 0 and find_global(s, e.ident_ptr, e.ident_len) == null
            let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
            if ce != null
                return ce.const_type
    else if e.kind == EXPR_INDEX and (e.right == null or e.right.kind != EXPR_RANGE)
        let et: i32 = indexed_elem_type(s, e.left)
        if et != TYPE_UNKNOWN
            return et
    else if e.kind == EXPR_MEMBER and e.left != null
        # `x[i].f` and `(*p).f`: a field of the element's or pointee's struct.
        var sn: *u8 = null
        var sl: i32 = 0
        if e.left.kind == EXPR_INDEX
            index_elem_struct_name(s, e.left, @sn, @sl)
        else if e.left.kind == EXPR_UNARY and e.left.op == OP_DEREF
            deref_member_base_struct_name(s, e.left.operand, @sn, @sl)
        if sl > 0
            let st: *StructDef = find_struct(s, sn, sl)
            if st != null
                let fi: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                if fi >= 0
                    let ef: *StructField = get_field_type(st, fi)
                    return ef.field_type
    else if e.kind == EXPR_METHOD
        let mt: i32 = user_method_ret_type(s, e)
        if mt != TYPE_UNKNOWN
            return mt
    else if e.kind == EXPR_CALL
        # A call through a `fn(...) -> T` local.
        let lv: *LocalVar = find_local_struct_name(s, e.func_name, e.func_name_len)
        if lv != null and lv.fn_sig != null
            return lv.fn_sig.return_type
    get_expr_type(s, e)

# The element type of array or pointer `base`, for what get_expr_type leaves at
# i64: a `[N]T` local, global or const, and an array or `*T` field.
fn indexed_elem_type(s: *EmitterState, base: *Expr) -> i32
    if base.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, base.ident_ptr, base.ident_len)
        if lv != null
            if lv.var_type == TYPE_ARRAY
                return lv.array_elem_type
            return vec_name_elem_type(lv.type_name, lv.type_name_len)
        let g: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
        if g != null
            if g.var_type == TYPE_ARRAY
                return g.array_elem_type
            return TYPE_UNKNOWN
        let ce: *ConstEntry = find_const_entry(s, base.ident_ptr, base.ident_len)
        if ce != null and ce.const_type == TYPE_ARRAY
            return ce.array_elem_type
    else if base.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, base)
        if f != null
            if f.field_type == TYPE_ARRAY
                return f.array_elem_type
            let vt: i32 = vec_name_elem_type(f.field_type_name, f.field_type_name_len)
            if vt != TYPE_UNKNOWN
                return vt
            return ptr_field_elem_kind(f)
    TYPE_UNKNOWN

# The integer element of monomorphised `Vec$T` (`v[i]` is the index sugar), or
# TYPE_UNKNOWN for any other name.
fn vec_name_elem_type(name: *u8, len: i32) -> i32
    if name == null or len < 6 or *name != 'V' or *(name + 1) != 'e' or *(name + 2) != 'c' or *(name + 3) != '$'
        return TYPE_UNKNOWN
    let en: *u8 = name + 4
    let el: i32 = len - 4
    if name_eq(en, el, c"u8", 2) == 1
        return TYPE_U8
    if name_eq(en, el, c"i8", 2) == 1
        return TYPE_I8
    if name_eq(en, el, c"u16", 3) == 1
        return TYPE_U16
    if name_eq(en, el, c"i16", 3) == 1
        return TYPE_I16
    if name_eq(en, el, c"u32", 3) == 1
        return TYPE_U32
    if name_eq(en, el, c"i32", 3) == 1
        return TYPE_I32
    if name_eq(en, el, c"u64", 3) == 1
        return TYPE_U64
    TYPE_UNKNOWN

fn is_int_arith_op(op: i32) -> i32
    if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or op == OP_MOD
        return 1
    if op == OP_BIT_AND or op == OP_BIT_OR or op == OP_BIT_XOR or op == OP_SHL or op == OP_SHR
        return 1
    0

# AGAST #2356: a register holds an i64, so `a + a` or `~a` on a u8 can sit outside
# the u8's range, and the bits a `>>` brings down would be ones the type does not
# have.  Bring such a value back to its type.  Only an operator can leave the
# range: a name, load, call or cast is already extended from its width.
fn emit_shr_operand(s: *EmitterState, e: *Expr, reg: i32, bits: i32, uns: i32) -> i32
    if bits >= 64
        return reg
    if e.kind != EXPR_BINARY and e.kind != EXPR_UNARY
        return reg
    if e.kind == EXPR_UNARY and e.op != OP_NEG and e.op != OP_BIT_NOT
        return reg
    let low: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, low)
    emit_str(s, c" = trunc i64 ")
    emit_reg(s, reg)
    emit_str(s, c" to i")
    emit_int(s, bits as i64)
    emit_str(s, c"\n")
    let wide: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, wide)
    if uns == 1
        emit_str(s, c" = zext i")
    else
        emit_str(s, c" = sext i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, low)
    emit_str(s, c" to i64\n")
    wide

# AGAST #1660 — `reg` (the value of `operand`) as an i64.  A unit-enum
# operand's `%Kind` aggregate becomes its zero-extended i8 tag; any other
# operand is already i64 and is returned unchanged.
fn unit_enum_tag_to_i64(s: *EmitterState, operand: *Expr, reg: i32) -> i32
    var en_name: *u8 = null
    var en_len: i32 = 0
    unit_enum_expr_name(s, operand, @en_name, @en_len)
    # AGAST #2539: `*q` / `**r` loaded the %E deref_pointee_struct_name named.
    if en_len == 0 and operand != null and operand.kind == EXPR_UNARY and operand.op == OP_DEREF
        deref_pointee_struct_name(s, operand.operand, @en_name, @en_len)
        if en_len > 0 and (is_enum_type(en_name, en_len) == 0 or is_tagged_enum_type(en_name, en_len) == 1)
            en_len = 0
    if en_len == 0
        return reg
    let tag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag)
    emit_str(s, c" = extractvalue %")
    emit_name(s, en_name, en_len)
    emit_str(s, c" ")
    emit_reg(s, reg)
    emit_str(s, c", 0\n")
    let wide: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, wide)
    emit_str(s, c" = zext i8 ")
    emit_reg(s, tag)
    emit_str(s, c" to i64\n")
    wide

# AGAST #1505 — static pointee struct of a deref operand.
#
# `*op` must load the pointee's LLVM type.  The OP_DEREF arm used to name the
# struct only for a bare parameter identifier (`*p`) and silently `load i64`
# for everything else, which clang rejects the moment the value is stored into
# a struct slot:
#
#     let d: D = *(p + i)         # pointer arithmetic on a *D
#     let q: *D = ...; *q         # let-local pointer
#     *(h.items + i)              # pointer-typed struct field (21_ls)
#     *name                       # `name: @StrView` reference param (ritzunit)
#
# Walks the operand's static type: `+`/`-` keep the pointer's type, so the
# chain is followed down its left spine to the base pointer; the base is a
# local/global pointer or reference, or a struct field.  A candidate name is
# accepted only if it names a struct find_struct knows or a tagged enum
# (`Option$T`) — primitive pointees the parser spelt as type names (`*u8` →
# "u8") never resolve, so they keep their width-specific loads.  A bare `*p`
# keeps its pre-#1505 unverified trust.  Writes null/0 when the pointee is not
# a known aggregate.
# What `x + 1` steps by when `x` is a pointer: sizeof its pointee.  0 when `x`
# isn't a pointer (a real element size is never 0).
fn ptr_operand_stride(s: *EmitterState, x: *Expr) -> i64
    # AGAST #1505: an operand statically known to be `*S` strides by
    # sizeof(S) — the same resolution the OP_DEREF arm loads through, so
    # `*(q + i)` steps and loads the same type.  ptr_arith_elem_size
    # alone does not scale a nested `a.b.items` field at all.
    var ps_name: *u8 = null
    var ps_len: i32 = 0
    deref_pointee_struct_name(s, x, @ps_name, @ps_len)
    # Only a StructDef has a size here; get_struct_size_by_name says 8
    # for a tagged enum, so those keep ptr_arith_elem_size's answer.
    if ps_len > 0 and find_struct(s, ps_name, ps_len) != null
        return get_struct_size_by_name(s, ps_name, ps_len)
    ptr_arith_elem_size(s, x)

# AGAST #2928: `q - p` on two pointers, as an i64 count of elements.  Both
# sides come into the i64 value model (an `@&T` operand is a `ptr`, #1754),
# and the byte distance divides by the left's stride (plain sdiv, as ritz0:
# `exact` would make an unaligned pair poison).
fn emit_ptr_distance(s: *EmitterState, e: *Expr) -> i32
    var stride: i64 = ptr_operand_stride(s, e.left)
    if stride <= 0
        stride = 1
    let l: i32 = ptr_value_to_i64(s, e.left, emit_expr(s, e.left))
    let r: i32 = ptr_value_to_i64(s, e.right, emit_expr(s, e.right))
    let bytes: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, bytes)
    emit_str(s, c" = sub i64 ")
    emit_reg(s, l)
    emit_str(s, c", ")
    emit_reg(s, r)
    emit_str(s, c"\n")
    if stride == 1
        return bytes
    let count: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, count)
    emit_str(s, c" = sdiv i64 ")
    emit_reg(s, bytes)
    emit_str(s, c", ")
    emit_int(s, stride)
    emit_str(s, c"\n")
    count

fn deref_pointee_struct_name(s: *EmitterState, op: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var base: *Expr = op
    while base != null and base.kind == EXPR_BINARY and (base.op == OP_ADD or base.op == OP_SUB)
        base = base.left
    if base == null
        return
    var cand: *u8 = null
    var cand_len: i32 = 0
    # The pre-#1505 path: a bare `*p` on a local with a recorded struct
    # pointee loaded `%<type_name>` unverified.  Keep trusting it — its names
    # include tagged enums and other aggregates find_struct does not list.
    var trusted: i32 = 0
    if base.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, base.ident_ptr, base.ident_len)
        if lv != null
            # Only a recorded TYPE_STRUCT pointee is trusted: the parser can
            # leave a stale type_name on a primitive pointer param
            # (`lex: *Lexer, out: *i64` gives `out` the name "Lexer").
            let is_ptr: bool = lv.var_type == TYPE_PTR or lv.var_type == TYPE_REF or lv.var_type == TYPE_MUT_REF
            if base == op and lv.pointee_type == TYPE_STRUCT
                cand = lv.type_name
                cand_len = lv.type_name_len
                trusted = 1
            else if is_ptr and lv.pointee_type == TYPE_STRUCT
                cand = lv.type_name
                cand_len = lv.type_name_len
        else
            let glob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
            if glob != null and glob.var_type == TYPE_PTR and glob.pointee_type == TYPE_STRUCT
                # AGAST #2359: a `var G: *S` keeps S in pointee_type_name;
                # type_name is set only for a by-value `var g: S`.  Reading
                # type_name gave null here, so `G + i` strode 1 byte.
                cand = glob.pointee_type_name
                cand_len = glob.pointee_type_name_len
    else if base.kind == EXPR_INDEX
        # AGAST #2332: `*a[i]` / `*(a[i] + k)` with `a: [N]*S`.
        array_elem_pointee(s, base, @cand, @cand_len)
        trusted = 1   # the array's own record, and an enum isn't a StructDef
    else if base.kind == EXPR_UNARY and base.op == OP_DEREF
        # AGAST #1924: `*(*(pp + i) + k)` / `**pp` with `pp: **S` (local,
        # param, global or field) loads an S.
        deref_ptr_ptr_struct_name(s, base, @cand, @cand_len)
    else if base.kind == EXPR_UNARY and (base.op == OP_ADDR or base.op == OP_ADDR_MUT)
        # AGAST #1746: `*@x` is x's own struct type.  It loaded i64, which a
        # by-value or struct store of the result rejects.
        let lent: *LocalVar = lent_struct_local(s, base.operand)
        if lent != null
            cand = lent.type_name   # AGAST #2286: `c` itself reads as the pointer
            cand_len = lent.type_name_len
        else
            resolve_expr_struct_name(s, base.operand, @cand, @cand_len)
    else if base.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, base)
        if f != null and f.field_type == TYPE_PTR
            # make_ptr_prim_field records primitive pointees here.
            let pe: i32 = f.array_elem_type
            let prim: bool = pe == TYPE_U8 or pe == TYPE_I8 or pe == TYPE_U16 or pe == TYPE_I16 or pe == TYPE_U32 or pe == TYPE_I32 or pe == TYPE_U64 or pe == TYPE_I64
            if not prim
                cand = f.field_type_name
                cand_len = f.field_type_name_len
    else if base.kind == EXPR_CALL
        # AGAST #2526: `*f()` / `*(f() + i)` with `f() -> *S` (or `-> @S`)
        # loads an S.  capture_fn_return_type names a primitive pointee
        # ("i32") rather than leaving a stale struct name, and find_struct
        # below rejects it, so `-> *i32` keeps its width-specific load.
        let fd: *FnDef = find_call_fn(s, base)
        if fd != null and (fd.return_type == TYPE_PTR or fd.return_type == TYPE_REF or fd.return_type == TYPE_MUT_REF)
            cand = fd.return_type_name
            cand_len = fd.return_type_name_len
    else if base.kind == EXPR_METHOD
        # AGAST #1635: `*m.index(k)`, a struct's `m[k]`, with `index -> @S`
        # (or `index_mut -> @&S`) loads an S.
        let mfd: *FnDef = method_call_def(s, base)
        if mfd != null and (mfd.return_type == TYPE_PTR or mfd.return_type == TYPE_REF or mfd.return_type == TYPE_MUT_REF)
            cand = mfd.return_type_name
            cand_len = mfd.return_type_name_len
    else if base.kind == EXPR_CAST and base.op == TYPE_PTR and base.int_val == (TYPE_STRUCT as i64)
        # AGAST #2526: `*(x as *S)` / `*((x as *S) + i)`.  apply_cast_tail
        # records a struct pointee's name on the node (AGAST #1453).
        cand = base.ident_ptr
        cand_len = base.ident_len
    if cand == null or cand_len <= 0
        return
    # `Option$T` / `Result$T,E` are tagged-enum aggregates, not StructDefs.
    # AGAST #2539: so is a plain enum: `**r` with `r: **Color` loads a %Color.
    if trusted == 0 and is_tagged_enum_type(cand, cand_len) == 0 and is_enum_type(cand, cand_len) == 0
        let st: *StructDef = find_struct(s, cand, cand_len)
        if st == null
            return
    *out_name = cand
    *out_len = cand_len

# AGAST #1488: the address of an lvalue, as a `ptr` register, or -1 when
# `op` is not an lvalue this emitter can address.  Shared by `@` (OP_ADDR,
# which ptrtoints the result to the i64 value model) and `@&` (OP_ADDR_MUT,
# which yields the ptr itself).  Before #1488 these shapes lived inline in
# OP_ADDR only, and `@&` handled nothing but a bare local, so `@&s.field`,
# `@&p.a.b`, `@&arr[i].f` and `@&g` were all "cannot take mutable address".
# Emits no diagnostic of its own: the caller reports the failure.
# The GEP element type of `p[i]` for `p: *T`, given T's kind (pointee_type)
# and, for a struct, its name.  AGAST #1908: a struct pointee used to fall
# to the i8 default, so `@tests[1]` over `*RitzTest` pointed one BYTE in.
fn emit_ptr_elem_gep_type(s: *EmitterState, pointee_type: i32, name: *u8, name_len: i32)
    if pointee_type == TYPE_I32 or pointee_type == TYPE_U32
        emit_str(s, c"i32")
    else if pointee_type == TYPE_I64 or pointee_type == TYPE_U64
        emit_str(s, c"i64")
    else if pointee_type == TYPE_I16 or pointee_type == TYPE_U16
        emit_str(s, c"i16")
    else if pointee_type == TYPE_PTR or pointee_type == TYPE_PTR_PTR
        emit_str(s, c"ptr")
    else if pointee_type == TYPE_STRUCT and name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, name, name_len)
    else
        # Default to i8 (covers *u8 / *i8 — most common).
        emit_str(s, c"i8")

# =============================================================================
# Multi-dimensional arrays (AGAST #1509)
# =============================================================================
#
# `var g: [N][M]..T` (local or global) carries an ArrayShape.  An index
# chain `g[i0][i1]..[ik-1]` (k <= rank) over it is ONE GEP over the full
# nested type, `getelementptr [N x [M x T]], ptr <g>, i64 0, i64 i0, i64 i1`,
# giving the element (k == rank) or a sub-array (k < rank).  Loads, stores,
# `@` and `.field` on a struct leaf all start from it.  Before #1509 the
# inner array was flattened to one i64 and every one of these miscompiled
# (or, for `@`, failed "cannot take address").

struct NdIndexPtr
    reg: i32              # ptr register of the element / sub-array
    depth: i32            # indices applied, 1..shape.rank
    shape: *ArrayShape

# nd_index_shape and the nd_array_*_shape helpers live in emitter_core
# (AGAST #2152): resolve_member_chain_field needs them for an indexed base.

# Emit the GEP for an N-D index chain `e` into *out.  Returns 0 (emitting
# nothing) when nd_index_shape does not recognise `e`.  The indices are
# evaluated in source order, outermost dimension first.
fn emit_nd_index_ptr(s: *EmitterState, e: *Expr, out: *NdIndexPtr) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null
        return 0
    var base: *Expr = e
    while base.kind == EXPR_INDEX
        base = base.left
    # AGAST #2097: a field base `s.m` / `p.m` / `a.b.m` is addressed before
    # the indices are evaluated, as ritz0 does.
    var base_reg: i32 = 0
    if base.kind == EXPR_MEMBER
        var mp: MemberPtrResult
        emit_member_ptr(s, base, @mp)
        # Reported, then emitted anyway (over %.0) so callers do not fall
        # through to a 1-D path and report again; the error fails the build.
        if mp.success != 1
            emit_nd_error(s, e.span.line, e.span.col, c"cannot address the multi-dimensional array field this index chain starts from in ritz1")
        base_reg = mp.reg
    var regs: [8]i32
    var j: i32 = 0
    while j < depth
        # The j-th index (source order) sits depth-1-j levels below `e`.
        var node: *Expr = e
        var k: i32 = 0
        while k < depth - 1 - j
            node = node.left
            k = k + 1
        regs[j] = emit_expr(s, node.right)
        j = j + 1
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = getelementptr ")
    emit_array_shape_llvm(s, sh, 0)
    emit_str(s, c", ptr ")
    if base.kind == EXPR_MEMBER
        emit_reg(s, base_reg)
    else
        let lv: *LocalVar = find_local_struct_name(s, base.ident_ptr, base.ident_len)
        if lv != null
            emit_reg(s, lv.reg)
        else
            emit_str(s, c"@")
            emit_name(s, base.ident_ptr, base.ident_len)
    emit_str(s, c", i64 0")
    j = 0
    while j < depth
        emit_str(s, c", i64 ")
        emit_reg(s, regs[j])
        j = j + 1
    emit_str(s, c"\n")
    out.reg = r
    out.depth = depth
    out.shape = sh
    return 1

# The value of `e` = `g[i]..[k]` over an N-D array, in *out_reg.  Returns 0
# when `e` is not an N-D index chain.  Only a full-depth chain to a scalar
# leaf is a value; a row (`g[i]` of `[N][M]T`) or a struct leaf by value is
# a located error rather than a guess at an aggregate load.
fn emit_nd_index_value(s: *EmitterState, e: *Expr, out_reg: *i32) -> i32
    var ndp: NdIndexPtr
    if emit_nd_index_ptr(s, e, @ndp) == 0
        return 0
    let sh: *ArrayShape = ndp.shape
    if ndp.depth < sh.rank or sh.leaf_type == TYPE_STRUCT
        emit_nd_error(s, e.span.line, e.span.col, c"a row or a struct element of a multi-dimensional array is not a value in ritz1 (index every dimension, use .field, or take its address with @)")
        *out_reg = 0
        return 1
    let ty: *u8 = local_array_elem_llvm(sh.leaf_type)
    let v: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, v)
    emit_str(s, c" = load ")
    emit_str(s, ty)
    emit_str(s, c", ptr ")
    emit_reg(s, ndp.reg)
    emit_str(s, c"\n")
    *out_reg = emit_array_elem_widen(s, v, sh.leaf_type, ty)
    return 1

fn emit_lvalue_ptr(s: *EmitterState, op: *Expr) -> i32
    # AGAST #1509: `@g[i][j]` / `@g[i]` over a multi-dimensional array.
    var nd_addr: NdIndexPtr
    if emit_nd_index_ptr(s, op, @nd_addr) == 1
        return nd_addr.reg
    if op.kind == EXPR_IDENT
        let loc: i32 = find_local(s, op.ident_ptr, op.ident_len)
        if loc >= 0
            # AGAST #2286: `@c` of `c:& C` is the borrow's pointer.  The slot's
            # own address is a pointer to that pointer.
            if lent_ptr_local(s, op) != null
                return emit_load_ptr(s, loc)
            # Convert ptr (alloca) to i64
            return loc
        # Fall through: not a local, try a global. `@g_processed` (a
        # `var g_processed: Vec<String>` at module scope) used to silently
        # produce "ERROR: cannot take address" because this branch only
        # checked find_local — pre-existing limitation that didn't fire
        # until idiomatic main.ritz introduced struct-typed globals.
        let glob: *GlobalVarDef = find_global(s, op.ident_ptr, op.ident_len)
        if glob != null
            # A global's address is the constant `@name`; GEP it by 0 to get
            # it into a register, since callers want a reg for both @ and @&.
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            emit_str(s, c" = getelementptr i8, ptr @")
            emit_name(s, glob.name, glob.name_len)
            emit_str(s, c", i64 0\n")
            return result
    else if op.kind == EXPR_INDEX
        # AGAST #2440: `@p[i]` through a reference or pointer: `p.data + i`.
        if index_refused(s, op) == 1
            return 0
        let through: *LocalVar = index_through(s, op)
        if through != null
            var th: ThroughIndex
            index_through_fill(op, through_spill(s, through), @th)
            let th_val: i32 = emit_expr(s, @th.sum)
            let th_ptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, th_ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, th_val)
            emit_str(s, c" to ptr\n")
            return th_ptr
        # AGAST #2321: ritz0 lowers this at stride `[N]T`, past the end of the
        # array, against its own read; ritz1 stepped by a byte.  Neither (#2330).
        if array_ptr_index_base(s, op.left) != null
            emit_nd_error(s, op.span.line, op.span.col, c"the address of an element through a pointer to an array is refused (cast the pointer to `*T` and index that)")
            return 0
        # Handle @arr[i] - address of array element
        if op.left.kind == EXPR_IDENT
            let local: *LocalVar = find_local_struct_name(s, op.left.ident_ptr, op.left.ident_len)
            if local != null
                if local.var_type == TYPE_ARRAY
                    # Array local - use GEP [0, index] to get element address
                    let idx: i32 = emit_expr(s, op.right)
                    let elem_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, elem_ptr)
                    emit_str(s, c" = getelementptr [")
                    emit_int(s, local.array_size as i64)
                    emit_str(s, c" x ")
                    if local.array_elem_type == TYPE_STRUCT and local.type_name_len > 0
                        # AGAST #190: `@arr[i]` over `var arr: [N]Struct`
                        # — emit `[N x %T]` so the GEP stride matches the
                        # struct-element layout.  Without this, the
                        # downstream `ptrtoint` produces a pointer
                        # computed against an `[N x i64]` stride that
                        # disagrees with the alloca's `[N x %T]` layout.
                        emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
                    else
                        # AGAST #1564: the alloca's own element type;
                        # u32/u16/i16 used to stride as i64.
                        emit_str(s, local_array_elem_llvm(local.array_elem_type))
                    emit_str(s, c"], ptr ")
                    emit_reg(s, local.reg)
                    emit_str(s, c", i64 0, i64 ")
                    emit_reg(s, idx)
                    emit_str(s, c"\n")
                    # Convert to i64
                    return elem_ptr
                else if local.var_type == TYPE_PTR
                    # @ptr_var[i] where ptr_var: *T — load the pointer,
                    # GEP by element, convert to i64. Common in cryptosec
                    # (e.g. `load_u64_be(@data[0])` with `data: *u8`).
                    # Without this branch the address-of falls through
                    # to "; ERROR: cannot take address" and the caller
                    # references undef %.0.
                    let loaded_p: i32 = emit_load_ptr(s, local.reg)
                    let idx_p: i32 = emit_expr(s, op.right)
                    let elem_ptr_p: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, elem_ptr_p)
                    emit_str(s, c" = getelementptr ")
                    emit_ptr_elem_gep_type(s, local.pointee_type, local.type_name, local.type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, loaded_p)
                    emit_str(s, c", i64 ")
                    emit_reg(s, idx_p)
                    emit_str(s, c"\n")
                    return elem_ptr_p
            # If `op.left` is an ident but no matching local
            # was found, try the global table.  Squeeze's inflate
            # computes `@g_fixed_litlen_lengths[0]` and friends —
            # the global is `[288]u8` so a byte-level GEP works.
            # AGAST #190 extends this with a proper struct-array
            # branch: nexus's `var g_fallback: [100]FallbackPage`
            # needs `[100 x %FallbackPage]` GEP, not byte-level —
            # otherwise `@g_fallback[idx]` returns a pointer that
            # disagrees with the global's actual `[100 x %T]`
            # layout and downstream member loads pull garbage.
            let glob_arr: *GlobalVarDef = find_global(s, op.left.ident_ptr, op.left.ident_len)
            if glob_arr != null
                if glob_arr.var_type == TYPE_ARRAY and glob_arr.array_elem_type == TYPE_STRUCT and glob_arr.array_elem_type_name_len > 0
                    let gas_idx: i32 = emit_expr(s, op.right)
                    let gas_elem: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gas_elem)
                    emit_str(s, c" = getelementptr [")
                    emit_int(s, glob_arr.array_size as i64)
                    emit_str(s, c" x ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, glob_arr.array_elem_type_name, glob_arr.array_elem_type_name_len)
                    emit_str(s, c"], ptr @")
                    emit_name(s, glob_arr.name, glob_arr.name_len)
                    emit_str(s, c", i64 0, i64 ")
                    emit_reg(s, gas_idx)
                    emit_str(s, c"\n")
                    return gas_elem
                # AGAST #1908: `@g[i]` with `var g: *T` indexes the pointee,
                # not the global's own storage: load g, then GEP one T.
                if glob_arr.var_type == TYPE_PTR
                    let gp_base: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gp_base)
                    emit_str(s, c" = load ptr, ptr @")
                    emit_name(s, glob_arr.name, glob_arr.name_len)
                    emit_str(s, c"\n")
                    let gp_idx: i32 = emit_expr(s, op.right)
                    let gp_elem: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gp_elem)
                    emit_str(s, c" = getelementptr ")
                    emit_ptr_elem_gep_type(s, glob_arr.pointee_type, glob_arr.pointee_type_name, glob_arr.pointee_type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, gp_base)
                    emit_str(s, c", i64 ")
                    emit_reg(s, gp_idx)
                    emit_str(s, c"\n")
                    return gp_elem
                # AGAST #1984: `@g[i]` over a primitive `var g: [N]T` steps one
                # T, as `g[i]` loads/stores do (#1504).  The byte GEP below made
                # `@g_u64[1]` point one BYTE in.
                if glob_arr.var_type == TYPE_ARRAY and glob_arr.array_elem_type != TYPE_STRUCT
                    let gp_aidx: i32 = emit_expr(s, op.right)
                    let gp_aelem: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gp_aelem)
                    emit_str(s, c" = getelementptr [")
                    emit_int(s, glob_arr.array_size as i64)
                    emit_str(s, c" x ")
                    emit_str(s, global_array_elem_llvm(glob_arr))
                    emit_str(s, c"], ptr @")
                    emit_name(s, glob_arr.name, glob_arr.name_len)
                    emit_str(s, c", i64 0, i64 ")
                    emit_reg(s, gp_aidx)
                    emit_str(s, c"\n")
                    return gp_aelem
                let ga_idx: i32 = emit_expr(s, op.right)
                let ga_elem: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, ga_elem)
                emit_str(s, c" = getelementptr i8, ptr @")
                emit_name(s, glob_arr.name, glob_arr.name_len)
                emit_str(s, c", i64 ")
                emit_reg(s, ga_idx)
                emit_str(s, c"\n")
                return ga_elem
        # Handle @global.array_field[i] - address of global struct's array field element
        else if op.left.kind == EXPR_MEMBER
            if op.left.left.kind == EXPR_IDENT
                # Try to find as global variable
                let glob: *GlobalVarDef = find_global(s, op.left.left.ident_ptr, op.left.left.ident_len)
                if glob != null
                    if glob.var_type == TYPE_STRUCT
                        let st: *StructDef = find_struct(s, glob.type_name, glob.type_name_len)
                        if st != null
                            let field_idx: i32 = find_field_index(st, op.left.ident_ptr, op.left.ident_len)
                            if field_idx >= 0
                                let field: *StructField = get_field_type(st, field_idx)
                                if field.field_type == TYPE_ARRAY
                                    # Found an array field in global struct
                                    # Emit GEP to array field, then index into it
                                    # getelementptr %StructType, ptr @global, i32 0, i32 field_idx, i64 index
                                    let idx: i32 = emit_expr(s, op.right)
                                    let elem_ptr: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, elem_ptr)
                                    emit_str(s, c" = getelementptr %")
                                    emit_name(s, st.name, st.name_len)
                                    emit_str(s, c", ptr @")
                                    emit_name(s, glob.name, glob.name_len)
                                    emit_str(s, c", i32 0, i32 ")
                                    emit_int(s, field_idx as i64)
                                    emit_str(s, c", i64 ")
                                    emit_reg(s, idx)
                                    emit_str(s, c"\n")
                                    # Convert to i64
                                    return elem_ptr
                # Handle @ptr_to_struct.array_field[i] - address of element in array field via pointer
                let local: *LocalVar = find_local_struct_name(s, op.left.left.ident_ptr, op.left.left.ident_len)
                if local != null
                    if local.var_type == TYPE_PTR and local.type_name_len > 0
                        # It's a pointer to a struct with a known type name
                        let st: *StructDef = find_struct(s, local.type_name, local.type_name_len)
                        if st != null
                            let field_idx: i32 = find_field_index(st, op.left.ident_ptr, op.left.ident_len)
                            if field_idx >= 0
                                let field: *StructField = get_field_type(st, field_idx)
                                if field.field_type == TYPE_ARRAY
                                    # Load the pointer from the local, GEP to array field, index into it
                                    let loaded_ptr: i32 = emit_load_ptr(s, local.reg)
                                    # GEP to array field, then to element
                                    let idx: i32 = emit_expr(s, op.right)
                                    let elem_ptr: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, elem_ptr)
                                    emit_str(s, c" = getelementptr %")
                                    emit_name(s, st.name, st.name_len)
                                    emit_str(s, c", ptr ")
                                    emit_reg(s, loaded_ptr)
                                    emit_str(s, c", i32 0, i32 ")
                                    emit_int(s, field_idx as i64)
                                    emit_str(s, c", i64 ")
                                    emit_reg(s, idx)
                                    emit_str(s, c"\n")
                                    # Convert to i64
                                    return elem_ptr
                                else if field.field_type == TYPE_PTR
                                    # @ptr_to_struct.ptr_field[i] — the field
                                    # is a raw pointer (e.g. *u8 buffer in
                                    # cryptosec's DerElement.content).  Load
                                    # the parent ptr, GEP to the field, load
                                    # the field-pointer, then GEP into that
                                    # buffer by index.  Element type defaults
                                    # to i8 since the common case is *u8 and
                                    # GlobalVarDef-style element-type info
                                    # isn't tracked on StructField.
                                    let parent_ptr: i32 = emit_load_ptr(s, local.reg)
                                    let fld_addr: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, fld_addr)
                                    emit_str(s, c" = getelementptr %")
                                    emit_name(s, st.name, st.name_len)
                                    emit_str(s, c", ptr ")
                                    emit_reg(s, parent_ptr)
                                    emit_str(s, c", i32 0, i32 ")
                                    emit_int(s, field_idx as i64)
                                    emit_str(s, c"\n")
                                    let buf_ptr: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, buf_ptr)
                                    emit_str(s, c" = load ptr, ptr ")
                                    emit_reg(s, fld_addr)
                                    emit_str(s, c"\n")
                                    let pf_idx: i32 = emit_expr(s, op.right)
                                    let pf_elem: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, pf_elem)
                                    emit_str(s, c" = getelementptr i8, ptr ")
                                    emit_reg(s, buf_ptr)
                                    emit_str(s, c", i64 ")
                                    emit_reg(s, pf_idx)
                                    emit_str(s, c"\n")
                                    return pf_elem
                    # task-170: @local_struct.array_field[i] — local stack-
                    # allocated struct (TYPE_STRUCT, not PTR). e.g.
                    # `var addr: SockAddrIn` then `memset(@addr.zero[0],...)`
                    # in ritzlib/net.ritz. Without this branch it falls
                    # through to "; ERROR: cannot take address" — same
                    # symptom as the chained-member case but a different
                    # base shape.
                    if local.var_type == TYPE_STRUCT and local.type_name_len > 0
                        let st_ls: *StructDef = find_struct(s, local.type_name, local.type_name_len)
                        if st_ls != null
                            let field_idx_ls: i32 = find_field_index(st_ls, op.left.ident_ptr, op.left.ident_len)
                            if field_idx_ls >= 0
                                let field_ls: *StructField = get_field_type(st_ls, field_idx_ls)
                                if field_ls.field_type == TYPE_ARRAY
                                    let idx_ls: i32 = emit_expr(s, op.right)
                                    let elem_ptr_ls: i32 = next_reg(s)
                                    emit_str(s, c"  ")
                                    emit_reg(s, elem_ptr_ls)
                                    emit_str(s, c" = getelementptr %")
                                    emit_name(s, st_ls.name, st_ls.name_len)
                                    emit_str(s, c", ptr ")
                                    emit_reg(s, local.reg)
                                    emit_str(s, c", i32 0, i32 ")
                                    emit_int(s, field_idx_ls as i64)
                                    emit_str(s, c", i64 ")
                                    emit_reg(s, idx_ls)
                                    emit_str(s, c"\n")
                                    return elem_ptr_ls
            # task-170 site-1: chained-member addr-of-index, e.g.
            # `@p.command.args[i]` where `p.command` itself is a member
            # access (RespParser.command yields a RespCommand struct
            # field, whose `args` field is an array). emit_member_ptr
            # already handles arbitrarily-nested member chains — use it
            # to compute a ptr to the array field, then GEP by index.
            else if op.left.left.kind == EXPR_MEMBER
                var inner_result_cm: MemberPtrResult
                emit_member_ptr(s, op.left, @inner_result_cm)
                if inner_result_cm.success == 1
                    let inner_field_cm: *StructField = inner_result_cm.field
                    if inner_field_cm.field_type == TYPE_ARRAY
                        let idx_cm: i32 = emit_expr(s, op.right)
                        let elem_ptr_cm: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, elem_ptr_cm)
                        emit_str(s, c" = getelementptr [")
                        emit_int(s, inner_field_cm.array_size as i64)
                        emit_str(s, c" x ")
                        if inner_field_cm.array_elem_type == TYPE_STRUCT and inner_field_cm.array_elem_type_name_len > 0
                            emit_str(s, c"%")
                            emit_name(s, inner_field_cm.array_elem_type_name, inner_field_cm.array_elem_type_name_len)
                        else
                            # AGAST #1814: the field's declared element type.
                            emit_str(s, field_array_elem_llvm(inner_field_cm.array_elem_type))
                        emit_str(s, c"], ptr ")
                        emit_reg(s, inner_result_cm.reg)
                        emit_str(s, c", i64 0, i64 ")
                        emit_reg(s, idx_cm)
                        emit_str(s, c"\n")
                        return elem_ptr_cm
    else if op.kind == EXPR_MEMBER
        # Handle @local_struct.field - address of a field in a local struct
        if op.left.kind == EXPR_IDENT
            # Try to find as local struct variable
            let local: *LocalVar = find_local_struct_name(s, op.left.ident_ptr, op.left.ident_len)
            if local != null
                # Check if it's a struct, or a pointer/reference to a struct
                var is_struct_or_ref: i32 = 0
                if local.var_type == TYPE_STRUCT
                    is_struct_or_ref = 1
                else if local.var_type == TYPE_PTR or local.var_type == TYPE_REF or local.var_type == TYPE_MUT_REF
                    # Check if it points to a struct (has type_name set)
                    if local.type_name_len > 0
                        is_struct_or_ref = 1
                if is_struct_or_ref == 1
                    # Found a local struct or ref to struct - get the struct definition
                    let st: *StructDef = find_struct(s, local.type_name, local.type_name_len)
                    if st != null
                        let field_idx: i32 = find_field_index(st, op.ident_ptr, op.ident_len)
                        if field_idx >= 0
                            if local.var_type == TYPE_STRUCT
                                # Direct struct - GEP from local.reg directly
                                let field_ptr: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, field_ptr)
                                emit_str(s, c" = getelementptr %")
                                emit_name(s, st.name, st.name_len)
                                emit_str(s, c", ptr ")
                                emit_reg(s, local.reg)
                                emit_str(s, c", i32 0, i32 ")
                                emit_int(s, field_idx as i64)
                                emit_str(s, c"\n")
                                # Convert pointer to i64
                                return field_ptr
                            else
                                # Ptr/ref - native ptr load (task #73 migration)
                                let loaded_ptr: i32 = emit_load_levels(s, local.reg, local_struct_levels(local))
                                let field_ptr: i32 = next_reg(s)
                                emit_str(s, c"  ")
                                emit_reg(s, field_ptr)
                                emit_str(s, c" = getelementptr %")
                                emit_name(s, st.name, st.name_len)
                                emit_str(s, c", ptr ")
                                emit_reg(s, loaded_ptr)
                                emit_str(s, c", i32 0, i32 ")
                                emit_int(s, field_idx as i64)
                                emit_str(s, c"\n")
                                # Convert pointer to i64
                                return field_ptr
    # AGAST #184: generic addr-of-MEMBER fallback. Anything that
    # `emit_member_ptr` knows how to GEP — including the new
    # `parent.fwd[i].field` over **Foo case — gets handled here
    # without each shape needing its own bespoke OP_ADDR branch.
    # Without this, the call-site emitted undef `%.0` after the
    # explicit cases above all missed (e.g. EXPR_MEMBER over an
    # EXPR_INDEX base).  Lives at the OP_ADDR level (outside the
    # operand-kind branches) so it catches anything those missed.
    if op.kind == EXPR_MEMBER
        var fb_result: MemberPtrResult
        emit_member_ptr(s, op, @fb_result)
        if fb_result.success == 1
            return fb_result.reg
    # AGAST #184: addr-of-INDEX fallback for arbitrarily-deep
    # MEMBER chains.  `@doc.fields[i].key[0]` (mausoleum's
    # doc_find_field_index) is INDEX-of-MEMBER-of-INDEX-of-MEMBER-of-IDENT
    # — the existing OP_ADDR branches only matched the simpler
    # 1- or 2-level chains, leaving deeper shapes to fall through
    # to "; ERROR: cannot take address" + undef %.0 at the call site.
    #
    # Strategy: when the operand is INDEX with a MEMBER base, use
    # emit_member_ptr to compute the address of the (array) field,
    # then GEP into it by the index using the array element type.
    if op.kind == EXPR_INDEX
        if op.left.kind == EXPR_MEMBER
            var idx_fb: MemberPtrResult
            emit_member_ptr(s, op.left, @idx_fb)
            if idx_fb.success == 1
                let idx_fb_field: *StructField = idx_fb.field
                if idx_fb_field.field_type == TYPE_ARRAY
                    let idx_v: i32 = emit_expr(s, op.right)
                    let elem_ptr_fb: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, elem_ptr_fb)
                    emit_str(s, c" = getelementptr [")
                    emit_int(s, idx_fb_field.array_size as i64)
                    emit_str(s, c" x ")
                    if idx_fb_field.array_elem_type == TYPE_STRUCT and idx_fb_field.array_elem_type_name_len > 0
                        emit_str(s, c"%")
                        emit_name(s, idx_fb_field.array_elem_type_name, idx_fb_field.array_elem_type_name_len)
                    else
                        # AGAST #1814: the field's declared element type.
                        emit_str(s, field_array_elem_llvm(idx_fb_field.array_elem_type))
                    emit_str(s, c"], ptr ")
                    emit_reg(s, idx_fb.reg)
                    emit_str(s, c", i64 0, i64 ")
                    emit_reg(s, idx_v)
                    emit_str(s, c"\n")
                    return elem_ptr_fb
    # AGAST #1599: `@*e` / `@&*e` — the address of `*e` is `e` itself, so
    # emit the pointer operand without loading through it.  Same ptr
    # normalisation as the OP_DEREF value path: ritz1 carries most pointers
    # as i64, but a TYPE_MUT_REF (`x: @&T` / `x:& T`) already loads as `ptr`.
    if op.kind == EXPR_UNARY and op.op == OP_DEREF
        let deref_addr: i32 = emit_expr(s, op.operand)
        if deref_operand_is_ptr(s, op.operand) != 0
            return deref_addr
        let deref_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, deref_ptr)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, deref_addr)
        emit_str(s, c" to ptr\n")
        return deref_ptr
    return -1

# AGAST #1959 / #1955 / #1541: the LLVM float type of a negated operand, or
# null when it is an integer.  A float literal is `double` (get_expr_type
# says f64), so `-1.5` is a double that the f32 binding / argument sites
# narrow just as they narrow `1.5`.
fn neg_float_llvm_type(s: *EmitterState, operand: *Expr) -> *u8
    let ty: i32 = get_expr_type(s, operand)
    if ty == TYPE_F32
        return c"float"
    if ty == TYPE_F64
        return c"double"
    return null

fn emit_expr_unary(s: *EmitterState, e: *Expr) -> i32
    bool_check_unary(s, e)   # AGAST #2342
    if e.op == OP_NEG
        let fty: *u8 = neg_float_llvm_type(s, e.operand)
        let operand: i32 = emit_expr(s, e.operand)
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        if fty != null
            # `fneg`, as ritz0 emits: `sub i64 0, %double` is invalid IR.
            emit_str(s, c" = fneg ")
            emit_str(s, fty)
            emit_str(s, c" ")
            emit_reg(s, operand)
            emit_str(s, c"\n")
            return result
        emit_str(s, c" = sub i64 0, ")
        emit_reg(s, operand)
        emit_str(s, c"\n")
        return result
    else if e.op == OP_NOT
        let operand: i32 = emit_expr(s, e.operand)
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, operand)
        emit_str(s, c", 0\n")
        let ext: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ext)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, result)
        emit_str(s, c" to i64\n")
        return ext
    else if e.op == OP_DEREF and array_ptr_local(s, e.operand) != null
        emit_whole_array_error(s, e)   # AGAST #2287: `*p` for `p: *[N]T`
        return 0
    else if e.op == OP_DEREF
        let addr: i32 = emit_expr(s, e.operand)
        # Convert i64 address to ptr.  AGAST #1644: a TYPE_MUT_REF local
        # (`x: @&T`) already loads as `ptr`, so casting it is invalid IR.
        # Mirrors the `*x = v` store path (AGAST #173).
        var ptr: i32 = addr
        if deref_operand_is_ptr(s, e.operand) == 0
            ptr = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, addr)
            emit_str(s, c" to ptr\n")
        # AGAST #1505: a pointee statically known to be a struct loads that
        # struct, whatever get_expr_type guessed (it reports TYPE_I64 for a
        # let-local `*S` and TYPE_U8 for an unrecorded `*S` field pointee).
        var sname: *u8 = null
        var sname_len: i32 = 0
        deref_pointee_struct_name(s, e.operand, @sname, @sname_len)
        if sname_len > 0
            # AGAST #2286: `*@c` reads `c:& C` by value, as `c` itself does.
            if e.operand.kind == EXPR_UNARY and lent_struct_local(s, e.operand.operand) != null
                own_check_lent_read(s, e.operand.operand, sname, sname_len)
            let sresult: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, sresult)
            emit_str(s, c" = load %")
            emit_name(s, sname, sname_len)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            return sresult
        # Determine load type based on pointee type
        let deref_type: i32 = get_expr_type(s, e)
        if deref_type == TYPE_F32 or deref_type == TYPE_F64
            # AGAST #2022: a *f32 / *f64 pointee loads `float` / `double`
            # and is returned as-is (no widen), as `p[i]` does (#1973).  It
            # fell to the i64 default, so `*p != x` emitted
            # `fcmp float <i64>`, which clang rejects.
            let fresult: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, fresult)
            emit_str(s, c" = load ")
            emit_str(s, local_array_elem_llvm(deref_type))
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            return fresult
        else if deref_type == TYPE_BOOL
            # AGAST #2053: a `*bool` pointee is an `i1`; zext it to the i64
            # bools are carried in.  (The i64 default read 7 bytes past it.)
            let bval: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bval)
            emit_str(s, c" = load i1, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            let bresult: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bresult)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, bval)
            emit_str(s, c" to i64\n")
            return bresult
        else if deref_type == TYPE_U8 or deref_type == TYPE_I8
            # Load i8 and sign/zero-extend to i64.  AGAST #2021: `*p` on a
            # *i8 sexts, as p[i] does; zext made a negative pointee 0xFD.
            let byte_val: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, byte_val)
            emit_str(s, c" = load i8, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            if deref_type == TYPE_I8
                emit_str(s, c" = sext i8 ")
            else
                emit_str(s, c" = zext i8 ")
            emit_reg(s, byte_val)
            emit_str(s, c" to i64\n")
            return result
        else if deref_type == TYPE_U16 or deref_type == TYPE_I16
            # Load i16 and sign/zero-extend to i64
            let val16: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, val16)
            emit_str(s, c" = load i16, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            if deref_type == TYPE_I16
                emit_str(s, c" = sext i16 ")
            else
                emit_str(s, c" = zext i16 ")
            emit_reg(s, val16)
            emit_str(s, c" to i64\n")
            return result
        else if deref_type == TYPE_I32 or deref_type == TYPE_U32
            # Load i32 and sign/zero-extend to i64 (unified value model)
            # Critical: reading i64 from a 4-byte slot reads 4 bytes of
            # adjacent stack/heap = garbage upper half.
            let val32: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, val32)
            emit_str(s, c" = load i32, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            if deref_type == TYPE_I32
                emit_str(s, c" = sext i32 ")
            else
                emit_str(s, c" = zext i32 ")
            emit_reg(s, val32)
            emit_str(s, c" to i64\n")
            return result
        else if deref_type == TYPE_STRUCT
            # AGAST #1505: the pointee is a struct but deref_pointee_struct_name
            # could not name it.  This used to fall back silently to
            # `load i64`, which clang rejects as soon as the value meets a
            # struct slot.  Report it at the deref's source position instead.
            eprint_i64(e.span.line as i64)
            eprint_char(':')
            eprint_i64(e.span.col as i64)
            eprints_cstr(c": ")
            emit_ir_error(s, c"cannot determine the struct type loaded by this '*' deref")
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            emit_str(s, c" = load i64, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            return result
        else
            # Default: load i64
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            emit_str(s, c" = load i64, ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
            return result
    else if e.op == OP_ADDR
        let addr_ptr: i32 = emit_lvalue_ptr(s, e.operand)
        if addr_ptr >= 0
            # `@expr` is an i64 in ritz1's value model.
            let result: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, result)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, addr_ptr)
            emit_str(s, c" to i64\n")
            return result
        emit_ir_error(s, c"cannot take address")
        return 0
    else if e.op == OP_ADDR_MUT
        # @&expr - mutable address-of, returns ptr type (not i64)
        let addr_mut_ptr: i32 = emit_lvalue_ptr(s, e.operand)
        if addr_mut_ptr >= 0
            return addr_mut_ptr
        emit_ir_error(s, c"cannot take mutable address")
        return 0
    else if e.op == OP_BIT_NOT
        let operand: i32 = emit_expr(s, e.operand)
        let result: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, result)
        emit_str(s, c" = xor i64 ")
        emit_reg(s, operand)
        emit_str(s, c", -1\n")
        return result
    return 0

