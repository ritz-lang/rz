# Auto-extracted from emitter_expr.ritz — BINARY + UNARY expression codegen.
# Part of the emit_expr split (#73 follow-on). Each function takes the
# EmitterState and an *Expr of the matching EXPR_* kind and returns the result
# register index, or 0 on an error path.

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers   # is_enum_type (AGAST #2539)
import emitter_core
import text_bridge      # StrView views of the older *u8 text APIs (AGAST #4696)
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import diag           # diag_error_at (AGAST #3445)
import emitter_expr
import emitter_expr_access   # emit_whole_array_error (AGAST #2287)
import emitter_stmt          # array_ptr_local (AGAST #2287)
import emitter_expr_call   # method_call_def (AGAST #1635)
import ref_check           # ref_temp_call (AGAST #3050)
import ownership           # own_temp_slot_of, own_lend_temps (AGAST #3050)
import narrowing           # emit_narrow_operand (AGAST #3225)
import emitter_match
import float_slot            # fs_literal_only (AGAST #4285)
import ritzlib.cstr
import ritzlib.io
import ritzlib.str
