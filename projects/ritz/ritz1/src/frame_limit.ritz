# frame_limit.ritz - refuse a fn whose stack frame exceeds the stack (AGAST #3739)
#
# ritz0's frame_too_large (#3738), with the same rule and words.  lexis's
# `main` held its stylesheet and selector map by value and compiled to a
# ~191 GiB frame; ritz1 accepted it in silence and the binary SIGSEGV'd on
# entry (#3700).
#
# THE RULE.  A fn's frame is the sum of its allocas' sizes: its locals, its
# by-value params' copies and its by-value temporaries (an sret slot, a lent
# copy), each its type's padded size (elem_size_align's layout) times its
# constant count.  An alloca with a runtime count is no fixed frame and is
# skipped.  Over FRAME_LIMIT_BYTES (8 MiB, the default `ulimit -s`) the fn
# is refused, at its largest alloca (the first emitted wins a tie): a local
# at its `let` / `var`, a temporary at the innermost expression being
# emitted when its slot was made.  Exactly the limit compiles.  There is no
# opt-out: a deliberately big frame goes on the heap or in a static.
#
# ritz1 writes IR as text, so this reads the finished body: each
# `  %r = alloca <type>[, i64 <n>]` line is sized from its type text.  Static
# allocas reach the body at the entry block, spliced there by
# splice_entry_allocas (AGAST #4460); the (offset, span) marks are
# EmitterState.fm, rebuilt by that splice from the ea_marks each entry_alloca
# recorded as it emitted its line.  Whose slot it is, EmitterState.fs, every
# (reg, name) add_local_full registered.

import ritzlib.sys
import ritzlib.io
import ritzlib.string
import ritzlib.strview  # SplitPair (split_digits)
import ritzlib.option   # fl_alloca, parse_i64

import ast
import diag
import emitter_core

const FRAME_LIMIT_BYTES: i64 = 8388608

# An LLVM type read off IR text: its padded size, its alignment, and the
# text after it, where the scan carries on.
struct FlType
    size: i64
    align: i64
    rest: StrView

# The decimal number `digits` spells (split_digits's `before`); 0 for none.
fn fl_number(digits: StrView) -> i64
    digits.parse_i64().unwrap_or(0)

fn fl_is_digit(c: u8) -> bool
    c >= '0' and c <= '9'

fn fl_round_up(n: i64, align: i64) -> i64
    if align <= 1
        return n
    let rem: i64 = n % align
    if rem == 0
        return n
    n + (align - rem)

# 1 for a byte that ends a `%Name` type in IR text.
fn fl_name_end(c: u8) -> i32
    if c == ' ' or c == ',' or c == ']' or c == '}' or c == '>' or c == ';' or c == '\n' or c == '\t'
        return 1
    0

# How many bytes from the start of `text` are a type name: up to the first
# byte that ends one.
fn fl_name_len(text: StrView) -> i64
    var n: i64 = 0
    while n < text.len and fl_name_end(text.get(n)) == 0
        n += 1
    n

# The LLVM type spelled at the start of `text` (after any spaces): `iN`,
# `ptr`, `float`, `double`, `%Name` (sized by elem_size_align, the layout its
# `= type` declaration is written with), `[N x T]`, `<N x T>`, `{ T, .. }`
# and packed `<{ T, .. }>`.
fn fl_type_size(s: *EmitterState, text: StrView) -> FlType
    var r: StrView = text.trim_start_byte(' ')
    if r.len == 0
        return FlType { size: 0, align: 1, rest: r }
    let c: u8 = r.get(0)
    let packed: bool = r.starts_with("<{")
    if c == '{' or packed
        var brace: i64 = 1          # `{` / `<{`, and its `}` / `}>`
        if packed
            brace = 2
        r = r.skip(brace)
        var off: i64 = 0
        var max_align: i64 = 1
        while r.len > 0
            r = r.trim_start_byte(' ')
            if r.len == 0 or r.get(0) == '}'
                break
            let field: FlType = fl_type_size(s, r)
            var fa: i64 = field.align
            if packed
                fa = 1
            off = fl_round_up(off, fa) + field.size
            if fa > max_align
                max_align = fa
            r = field.rest.trim_start_byte(' ')
            if r.len > 0 and r.get(0) == ','
                r = r.skip(1)
        return FlType { size: fl_round_up(off, max_align), align: max_align, rest: r.skip(brace) }
    if c == '[' or c == '<'
        let count: SplitPair = r.skip(1).trim_start_byte(' ').split_digits()
        # Past the spaces and the `x`; fl_type_size skips the spaces after it.
        let elem: FlType = fl_type_size(s, count.after.trim_start_byte(' ').skip(1))
        let close: StrView = elem.rest.trim_start_byte(' ').skip(1)   # `]` / `>`
        return FlType { size: fl_number(count.before) * elem.size, align: elem.align, rest: close }
    if c == '%'
        let name: StrView = r.skip(1)
        var align: i64 = 1
        if name.len > 0 and name.get(0) == '"'
            let quoted: StrView = name.skip(1)
            let qlen: i64 = quoted.find_byte('"')
            let qsize: i64 = elem_size_align(s, TypeKind.Struct, quoted.take(qlen), @align)
            return FlType { size: qsize, align: align, rest: quoted.skip(qlen + 1) }
        let nlen: i64 = fl_name_len(name)
        let size: i64 = elem_size_align(s, TypeKind.Struct, name.take(nlen), @align)
        return FlType { size: size, align: align, rest: name.skip(nlen) }
    if c == 'i' and r.len > 1 and fl_is_digit(r.get(1))
        let bits: SplitPair = r.skip(1).split_digits()
        let nbits: i64 = fl_number(bits.before)
        var bytes: i64 = 1
        while bytes * 8 < nbits
            bytes = bytes * 2
        var ialign: i64 = bytes
        if bytes > 16
            ialign = 16
        return FlType { size: bytes, align: ialign, rest: bits.after }
    if r.starts_with("ptr")
        return FlType { size: 8, align: 8, rest: r.skip(3) }
    if r.starts_with("double")
        return FlType { size: 8, align: 8, rest: r.skip(6) }
    if r.starts_with("float")
        return FlType { size: 4, align: 4, rest: r.skip(5) }
    if r.starts_with("half")
        return FlType { size: 2, align: 2, rest: r.skip(4) }
    # fp128, x86_fp80 and anything else: 16, as LLVM lays out the first two.
    FlType { size: 16, align: 16, rest: r.skip(fl_name_len(r)) }

# A fixed-size alloca: the bytes it takes in the frame, and its `%.N`
# register (-1 for a named one).
struct FlAlloca
    bytes: i64
    reg: i32

# The alloca on `line`: its type's size times its constant count.  None for
# a line that is no alloca, or one whose count is a register (a runtime size
# is no fixed frame).
fn fl_alloca(s: *EmitterState, line: StrView) -> Option<FlAlloca>
    if line.len < 4 or not line.starts_with("  %")
        return None
    let name: StrView = line.skip(3)
    var reg: i32 = -1
    if name.get(0) == '.'
        let num: SplitPair = name.skip(1).split_digits()
        if num.before.len > 0
            reg = fl_number(num.before) as i32
    let assign: StrView = name.skip(name.find_byte(' '))
    if not assign.starts_with(" = alloca ")
        return None
    let ty: FlType = fl_type_size(s, assign.skip(10))
    var r: StrView = ty.rest.trim_start_byte(' ')
    if r.len == 0 or r.get(0) != ','
        return Some(FlAlloca { bytes: ty.size, reg: reg })
    r = r.skip(1).trim_start_byte(' ')
    if r.starts_with("align")
        return Some(FlAlloca { bytes: ty.size, reg: reg })
    r = r.skip(r.find_byte(' ')).trim_start_byte(' ')   # past the count's type
    let count: SplitPair = r.split_digits()
    if count.before.len == 0
        return None   # `, i64 %.N`: a runtime count
    Some(FlAlloca { bytes: ty.size * fl_number(count.before), reg: reg })

# `16777216 bytes (16 MiB)`: exact, then readable.  ritz0's _fmt_bytes:
# whole numbers without decimals, others to 1 place (Python's `.1f`, so a
# tie rounds to even).
fn fl_push_bytes(m: @&String, n: i64)
    m.push_i64(n)
    m.push_str(" bytes")
    var unit: StrView = "GiB"
    var size: i64 = 1073741824
    if n < size
        unit = "MiB"
        size = 1048576
    if n < size
        unit = "KiB"
        size = 1024
    if n < size
        return
    m.push_str(" (")
    if n % size == 0
        m.push_i64(n / size)
    else
        var tenths: i64 = (n * 10) / size
        let rem: i64 = (n * 10) % size
        if rem * 2 > size or (rem * 2 == size and tenths % 2 == 1)
            tenths += 1
        m.push_i64(tenths / 10)
        m.push_str(".")
        m.push_i64(tenths % 10)
    m.push_str(" ")
    m.push_str(unit)
    m.push_str(")")

# Refuse `f` if the allocas in s.ir.out from body_start on sum past the limit.
# Called once the body is complete, before the splices that rewrite it
# (AGAST #4461's deferred loads and on), so the fm marks' offsets still hold.
pub fn refuse_huge_frame(s: *EmitterState, f: *FnDef, body_start: i64)
    let ir: StrView = s.ir.out.as_view()
    var total: i64 = 0
    var big: i64 = -1
    var big_reg: i32 = -1
    var big_line: i32 = 0
    var big_col: i32 = 0
    var mi: i32 = 0
    var o: i64 = body_start
    while o < ir.len
        let rest: StrView = ir.skip(o)
        let ll: i64 = rest.find_byte('\n')
        match fl_alloca(s, rest.take(ll))
            Some(a) =>
                total = total + a.bytes
                if a.bytes > big
                    while mi + 1 < s.fcx.fm_count
                        let next_mark: *FrameMark = s.fcx.fm + ((mi + 1) as i64)
                        if next_mark.off > o
                            break
                        mi += 1
                    let mark: *FrameMark = s.fcx.fm + (mi as i64)
                    big = a.bytes
                    big_reg = a.reg
                    big_line = mark.line
                    big_col = mark.col
            None => pass
        o = o + ll + 1
    if total <= FRAME_LIMIT_BYTES
        return
    var m: String = string_new()
    m.push_str("fn `")
    let shown: StrView = fn_display_name(f)
    m.push_span(Span<u8> { ptr: (shown.ptr), len: (shown.len) as i64 })
    m.push_str("` needs a ")
    fl_push_bytes(@&m, total)
    m.push_str(" stack frame, over the ")
    fl_push_bytes(@&m, FRAME_LIMIT_BYTES)
    m.push_str(" stack; ")
    var named: i32 = 0
    if big_reg >= 0
        var k: i32 = 0
        while k < s.fcx.fs_count and named == 0
            let slot: *FrameSlot = s.fcx.fs + (k as i64)
            if slot.reg == big_reg and slot.name.len > 0
                m.push_str("`")
                m.push_str(slot.name)
                m.push_str("`")
                named = 1
            k += 1
    if named == 0
        m.push_str("a by-value temporary")
    m.push_str(" here takes ")
    fl_push_bytes(@&m, big)
    m.push_str(": put it on the heap or in a static")
    diag_error_buf(emitter_source_file(), diag_span(big_line, big_col), @m)
    s.diag.error_count = s.diag.error_count + 1
