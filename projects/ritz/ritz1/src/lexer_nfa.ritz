# ritz1/src/lexer.ritz - Multi-Pattern NFA Lexer
#
# Lexer that uses multiple NFA patterns to tokenize source code.
# Uses longest-match with first-definition priority (flex-style).
#
# Architecture:
#   1. Each token pattern is compiled to an NFA fragment
#   2. All fragments are combined into a single NFA with shared start state
#   3. Each accepting state records its token type and priority
#   4. Lexer simulates NFA, tracking longest match and best priority

import tokens_gen
import nfa
import regex
import ritzlib.strview
import ritzlib.memory

# Pre-allocated limits
const MAX_PATTERNS: i32 = 64
const MAX_TOKEN_LEN: i32 = 4096

# Bracket tokens are defined in tokens.ritz
# TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE, TOK_LBRACKET, TOK_RBRACKET

# Token pattern with priority
struct TokenPattern
  token_type: i32
  priority: i32       # Lower = higher priority (first defined wins)
  frag: NFAFragment

# Maximum indentation depth (nested blocks): the size of Lexer.indent_stack.
# Deeper nesting is a located lexer error (AGAST #1813); it used to be pushed
# with no bounds check, writing past the array into the fields after it.
const MAX_INDENT_DEPTH: i32 = 64

# Maximum bracket nesting: the size of Lexer.bracket_kinds.  Deeper is a
# located lexer error (AGAST #3447); past it the kinds used to go unrecorded,
# silently.  ritz0 has no limit.
const MAX_BRACKET_DEPTH: i32 = 64

# Initial capacity of the cooked-string scratch buffer.  This is a starting
# size, NOT a cap — `lexer_str_push` grows it geometrically.  See the
# `string_buf` comment on `struct Lexer`.
const STRING_SCRATCH_INIT: i32 = 256

# Lexer state
# NOTE: Using i64 for position/length fields to handle large files; i32 elsewhere for efficiency
struct Lexer
  src: *u8
  len: i64                 # File size (use i64 for large files)
  pos: i64                 # Current position (use i64 for large files)
  line: i32
  col: i32
  nfa: *NFA
  # Patterns array (external, pre-allocated)
  patterns: *TokenPattern
  pattern_count: i32
  # Indentation tracking - array embedded in struct
  # NOTE: Using i32 instead of i64 since indent depth is at most 64
  indent_stack: [64]i32    # Stack of indentation levels
  indent_depth: i32        # Current depth in indent_stack
  at_line_start: i32       # 1 if at start of line, 0 otherwise
  pending_dedents: i32     # Number of DEDENT tokens to emit
  bracket_depth: i32       # Nesting depth of (), [], {} - no NEWLINE/INDENT/DEDENT when > 0
  # The open brackets' kinds (`(`, `[` or `{`), for the error below.
  bracket_kinds: [64]u8    # MAX_BRACKET_DEPTH
  # No block opens inside brackets (LARB R46a, AGAST #3388): their line
  # breaks and indentation are ignored, so a `match` there, or an `if` whose
  # line ends before its `then`, is refused at the keyword.  #2369's "layout
  # frame", which laid a bracket's lines out again after an `if` condition,
  # is gone.  if_line is the line of an `if` inside brackets still waiting
  # for its `then`, 0 if none.
  if_line: i32
  if_col: i32
  if_start: *u8
  if_depth: i32            # the bracket depth it is at
  line_indent: i32         # leading spaces of the current line
  last_kind: i32           # the last token returned
  # Continuation lines (LARB R46, AGAST #3388).  The line after one that
  # ends, outside brackets, in a binary operator or `as` opens and closes no
  # block, and must be indented at least as far as its statement.  A trailing
  # `>` / `>>` may close a generic list instead: on a line holding a
  # declaration keyword (decl_line), as in `fn f() -> Vec<T>`, it opens the
  # body's block; elsewhere (a field `data: Vec<u8>`) the next line is a
  # continuation only if it is deeper (cont_line 2).
  cont_line: i32           # 1 if the next line is a continuation, 2 if it is when deeper
  decl_line: i32           # 1 once this line has `fn`, `struct`, ... outside brackets
  # Cooked-string scratch buffer (escapes expanded).  ritz-task-1267.
  #
  # This used to be a fixed `[8192]i8` arena shared by *every* string
  # literal in the file, with each write guarded by `if pos < MAX_STRING_LEN`.
  # Once a source file's literals totalled more than 8 KiB the guard
  # silently stopped writing: the token that straddled the boundary got a
  # truncated `string_len` and every literal after it got `string_len == 0`.
  # ritz1 compiling its own `emitter.ritz` (8 KiB of literals by
  # `register_builtin_structs`) therefore emitted `@.str.N = [1 x i8] c"\00"`
  # for the tail of the module — producing, among other things, a struct
  # named `%\00\00\00` and a `.ll` with no `; ModuleID` header.  A compiler
  # must never silently drop source, and a fixed arena can't express
  # "however many literals this file has", so the arena is gone.
  #
  # Now: a single heap scratch buffer that grows on demand and is rewound
  # (`string_pos = 0`) at the start of each literal.  `lexer_str_finish`
  # copies the finished literal into its own exact-sized heap allocation,
  # so token `string_val` pointers are stable for the life of the process
  # and are unaffected by later growth or by `lexer_reset` between files.
  string_buf: *i8          # heap scratch; null until the first literal
  string_cap: i32          # bytes allocated in string_buf
  string_pos: i32          # write cursor within the literal being cooked
  # AGAST #1813: the message for the TOK_ERROR just returned, or null for an
  # unrecognised character.  Set by lexer_fail, which also stops the lexer.
  error_msg: *u8
  # asm body mode (LANGUAGE_SPEC §18.6, AGAST #3394).  An `asm` block's body is
  # text, not Ritz: `movq $3, %rcx` and `nopl (%rax)` must reach the parser
  # whole.  A line that starts with `asm` (outside brackets) and ends in `:`
  # puts the lexer in this mode for the lines indented under it: each becomes
  # one TOK_ASM_LINE (lexer_asm_line), then NEWLINE.  The first gets the
  # block's INDENT; a deeper one gets no INDENT of its own (its extra
  # indentation is dropped).  The first line no deeper than the `asm` line
  # leaves the mode and is laid out as usual, DEDENTing the body.
  asm_line: i32            # 1 from an `asm` at bracket depth 0 to its NEWLINE
  asm_base: i32            # that line's indentation
  asm_raw: i32             # 1 while lexing an asm body
  asm_body: i32            # 1 once the body's INDENT has been pushed

# Reset lexer for new source (preserves NFA and patterns, resets state)
# Use this when reusing a lexer for multiple files to avoid stack overflow
pub fn lexer_reset(lex: *Lexer, src: *u8, len: i64) -> i32
  lex.src = src
  lex.len = len
  lex.pos = 0
  lex.line = 1
  lex.col = 1
  # Reset indentation tracking (MUST be 1, not 0!)
  lex.indent_stack[0] = 0  # Base indentation level is 0
  lex.indent_depth = 1     # Stack has one element (important!)
  lex.at_line_start = 1    # Start at beginning of first line
  lex.pending_dedents = 0
  lex.bracket_depth = 0    # Not inside any brackets
  lexer_layout_reset(lex)
  lexer_asm_reset(lex)
  # Reset string buffer
  lex.string_pos = 0
  lex.error_msg = null
  0

# No pending `if`, no continuation, no token seen.
fn lexer_layout_reset(lex: *Lexer)
  lex.line_indent = 0
  lex.if_line = 0
  lex.if_col = 0
  lex.if_start = null
  lex.if_depth = 0
  lex.last_kind = 0
  lex.cont_line = 0
  lex.decl_line = 0

# Not in, or about to enter, an asm body.
fn lexer_asm_reset(lex: *Lexer)
  lex.asm_line = 0
  lex.asm_base = 0
  lex.asm_raw = 0
  lex.asm_body = 0

# At the start of a line in asm body mode (AGAST #3394), with lex.pos at its
# first byte.  Returns 1 with a token in out_tok (the body's INDENT, or a tab
# error), 0 to go on scanning: a blank or comment-only line was skipped, the
# line's text is next (at_line_start is 0), or the line ends the body (the
# mode is off and at_line_start still 1, so it is laid out as usual).
fn lexer_asm_line_start(lex: *Lexer, out_tok: *Token) -> i32
  var indent: i32 = 0
  while lexer_peek_at(lex, indent) == 32  # space
    indent = indent + 1
  let c: i32 = lexer_peek_at(lex, indent)
  # A blank or comment-only line, a tab, or the end of input: as anywhere.
  if c == 10 or c == 35 or c == 9 or lex.pos + indent >= lex.len
    return lexer_handle_indent(lex, out_tok)
  if indent <= lex.asm_base
    lex.asm_raw = 0
    return 0
  lex.pos = lex.pos + indent
  lex.col = lex.col + indent
  lex.line_indent = indent
  lex.at_line_start = 0
  if lex.asm_body == 1
    return 0
  if lex.indent_depth >= MAX_INDENT_DEPTH
    return lexer_fail(lex, out_tok, c"blocks nested more than 64 levels deep")
  lex.asm_body = 1
  lex.indent_stack[lex.indent_depth] = indent
  lex.indent_depth = lex.indent_depth + 1
  *out_tok = token_new(TOK_INDENT, lex.pos, 0, lex.line, lex.col)
  1

# One line of an asm body, from lex.pos (past its indentation) to the end of
# the line, as TOK_ASM_LINE.  A `#` and what follows it is a comment and is
# left out, as is trailing whitespace; the newline is lexed next, as usual.
fn lexer_asm_text(lex: *Lexer) -> Token
  let start: i64 = lex.pos
  let line: i32 = lex.line
  let col: i32 = lex.col
  var end: i64 = start
  while end < lex.len and *(lex.src + end) != 10 and *(lex.src + end) != 35
    end = end + 1
  var stop: i64 = end
  while end < lex.len and *(lex.src + end) != 10
    end = end + 1
  while stop > start and (*(lex.src + stop - 1) == 32 or *(lex.src + stop - 1) == 9 or *(lex.src + stop - 1) == 13)
    stop = stop - 1
  lex.col = lex.col + (end - start) as i32
  lex.pos = end
  var tok: Token = token_new(TOK_ASM_LINE, start, (stop - start) as i32, line, col)
  tok.start = lex.src + start
  tok

# 1 if `kind` is an infix operator, one a line can end in with the expression
# going on: ritz0's Parser.PRECEDENCE less the ranges, which ritz1's grammar
# takes in `for` headers and slices only.
fn lexer_is_infix(kind: i32) -> i32
  if kind == TOK_OR or kind == TOK_OROR or kind == TOK_AND or kind == TOK_ANDAND
    return 1
  if kind == TOK_PIPE or kind == TOK_CARET or kind == TOK_AMP
    return 1
  if kind == TOK_EQ or kind == TOK_NE or kind == TOK_LT or kind == TOK_LE
    return 1
  if kind == TOK_GT or kind == TOK_GE or kind == TOK_SHL or kind == TOK_SHR
    return 1
  if kind == TOK_PLUS or kind == TOK_MINUS or kind == TOK_STAR or kind == TOK_SLASH
    return 1
  if kind == TOK_PERCENT or kind == TOK_AS
    return 1
  0

# The line just ended (outside brackets) makes the next a continuation (LARB
# R46) if it ends in an infix operator: 1, or 2 for a `>` / `>>`, which may
# close a generic list (`data: Vec<u8>`), so only a deeper line continues it.
# On a declaration's line (`fn f() -> Vec<T>`) a `>` / `>>` is that close: 0.
fn lexer_ends_in_operator(lex: *Lexer) -> i32
  if lexer_is_infix(lex.last_kind) == 0
    return 0
  if lex.last_kind == TOK_GT or lex.last_kind == TOK_SHR
    if lex.decl_line == 1
      return 0
    return 2
  1

# Fatal TOK_ERROR at an `if` / `match` keyword (start, line, col) that would open
# a block inside brackets (LARB R46a), naming the innermost bracket.  ritz0's
# message (#3429).
fn lexer_fail_block(lex: *Lexer, start: *u8, line: i32, col: i32) -> Token
  var bracket: u8 = 40
  if lex.bracket_depth >= 1 and lex.bracket_depth <= MAX_BRACKET_DEPTH
    bracket = lex.bracket_kinds[lex.bracket_depth - 1]
  lex.error_msg = c"a block can't open inside `(`: bind the `if`/`match` to a `let` first"
  if bracket == 91
    lex.error_msg = c"a block can't open inside `[`: bind the `if`/`match` to a `let` first"
  if bracket == 123
    lex.error_msg = c"a block can't open inside `{`: bind the `if`/`match` to a `let` first"
  lex.pos = lex.len
  lex.pending_dedents = 0
  lex.cont_line = 0
  var tok: Token = token_new(TOK_ERROR, 0, 1, line, col)
  tok.start = start
  tok

# Return a located, fatal TOK_ERROR at the current position and stop lexing:
# the next lexer_next returns EOF.  The tab case used to return TOK_ERROR
# without advancing, so tokenize looped forever printing the same error.
fn lexer_fail(lex: *Lexer, out_tok: *Token, msg: *u8) -> i32
  *out_tok = token_new(TOK_ERROR, lex.pos, 1, lex.line, lex.col)
  lex.error_msg = msg
  lex.pos = lex.len
  lex.pending_dedents = 0
  1

# The byte an escape `\<esc>` cooks to, or -1 if the language defines no such
# escape (AGAST #1978).  The one table for every literal kind: the "..." and
# c"..." scanners below, the TOK_CHAR check, and ast_helpers' expr_char.
# `braces` is 1 for "..." and '.' literals, which (as in ritz0) also accept
# `\{` and `\}`; c"..." has no interpolation, so there they are unknown.
# Every arm used to end in "unknown escape -> the literal char", which
# silently turned c"a\xC3b" into "axC3b".  `\xNN` is deliberately absent:
# LANGUAGE_SPEC lists the escapes, and widening it is a LARB decision.
pub fn lexer_cook_escape(esc: i32, braces: i32) -> i32
  if esc == 110       # \n
    return 10
  if esc == 116       # \t
    return 9
  if esc == 114       # \r
    return 13
  if esc == 92        # \\
    return 92
  if esc == 34        # \"
    return 34
  if esc == 39        # \'
    return 39
  if esc == 48        # \0
    return 0
  if braces == 1 and (esc == 123 or esc == 125)  # \{ \}
    return esc
  -1

# Fatal, located TOK_ERROR for an unknown escape `\<esc>` whose escape char
# (the byte after the backslash) is at source offset `pos` -- the column
# ritz0 reports -- naming the escape as ritz0 does:
#   Unknown escape sequence '\x'
fn lexer_fail_escape(lex: *Lexer, pos: i64, line: i32, col: i32, esc: i32) -> Token
  let prefix: *u8 = c"Unknown escape sequence '\\"
  var n: i64 = 0
  while *(prefix + n) != 0
    n = n + 1
  # prefix + escape byte + closing quote + NUL.  Fatal path: never freed.
  let msg: *u8 = malloc(n + 3)
  for i in 0..n
    *(msg + i) = *(prefix + i)
  *(msg + n) = esc as u8
  *(msg + n + 1) = 39
  *(msg + n + 2) = 0
  lex.error_msg = msg
  lex.pos = lex.len
  lex.pending_dedents = 0
  var tok: Token = token_new(TOK_ERROR, pos, 1, line, col)
  tok.start = lex.src + pos
  tok

# Initialize a lexer with source and pre-allocated NFA/patterns storage
pub fn lexer_init(lex: *Lexer, src: *u8, len: i32, nfa: *NFA, patterns: *TokenPattern) -> i32
  lex.src = src
  lex.len = len
  lex.pos = 0
  lex.line = 1
  lex.col = 1
  lex.nfa = nfa
  lex.patterns = patterns
  lex.pattern_count = 0
  # Initialize indentation tracking
  lex.indent_stack[0] = 0  # Base indentation level is 0
  lex.indent_depth = 1     # Stack has one element
  lex.at_line_start = 1    # Start at beginning of first line
  lex.pending_dedents = 0
  lex.bracket_depth = 0    # Not inside any brackets
  lexer_layout_reset(lex)
  lexer_asm_reset(lex)
  lex.error_msg = null
  # Initialize the cooked-string scratch.  Lexers are usually `var lex: Lexer`
  # on the stack, so these MUST be zeroed here — a garbage `string_buf` would
  # be handed straight to realloc.
  lex.string_buf = null
  lex.string_cap = 0
  lex.string_pos = 0
  0

# ============================================================================
# Cooked-string scratch buffer (ritz-task-1267)
# ============================================================================
#
# Contract: `lexer_str_begin` before the first byte of a literal,
# `lexer_str_push` per cooked byte, `lexer_str_finish` to take ownership of
# an exact-sized, NUL-terminated heap copy.  The scratch itself is reused
# across literals; the copy is what tokens point at.

# Rewind the scratch to the start of a fresh literal.
fn lexer_str_begin(lex: *Lexer)
  lex.string_pos = 0

# Append one cooked byte, growing the scratch geometrically.  There is
# deliberately no upper bound: the only limit on a string literal's length
# is available memory.
fn lexer_str_push(lex: *Lexer, b: i8)
  if lex.string_pos >= lex.string_cap
    var new_cap: i32 = lex.string_cap * 2
    if new_cap < STRING_SCRATCH_INIT
      new_cap = STRING_SCRATCH_INIT
    let grown: *u8 = realloc(lex.string_buf as *u8, new_cap as i64)
    if grown == null
      return
    lex.string_buf = grown as *i8
    lex.string_cap = new_cap
  *(lex.string_buf + lex.string_pos) = b
  lex.string_pos = lex.string_pos + 1

# Copy the cooked literal into its own heap allocation and return it.
# NUL-terminated so callers that treat it as a cstring keep working; the
# authoritative length is `lex.string_pos` (embedded NULs are legal).
fn lexer_str_finish(lex: *Lexer) -> *u8
  let n: i32 = lex.string_pos
  let out: *u8 = malloc((n as i64) + 1)
  if out == null
    return null
  var i: i32 = 0
  while i < n
    *(out + i) = (*(lex.string_buf + i)) as u8
    i = i + 1
  *(out + n) = 0
  out

# Add a token pattern to the lexer.
#
# `pattern` is a StrView holding either a quoted literal ("fn") or a regex
# source ("[a-zA-Z_][a-zA-Z0-9_]*").  The literal/regex distinction is the
# `is_literal` flag — 1 for verbatim string match, 0 for regex compilation.
#
# Combining the old `*u8 + i32 len` pair into a StrView keeps the call site
# honest: every caller already had to know the length anyway, and bare
# string literals lower to StrView in ritz1, so the generated lexer setup
# just writes `lexer_add_pattern(lex, "fn", TOK_FN, 1)` instead of the
# manually-counted `c"fn", 2` C-style pair.
pub fn lexer_add_pattern(lex: *Lexer, pattern: StrView, token_type: i32, is_literal: i32) -> i32
  let idx: i64 = lex.pattern_count
  let nfa: *NFA = lex.nfa
  let pattern_src: *u8 = pattern.ptr
  let pattern_len: i32 = pattern.len as i32

  # First pattern? Create the shared start state
  if idx == 0
    let start: i32 = nfa_add_state(nfa, 0, 0)
    nfa.start_state = start

  # Build NFA fragment for this pattern
  var frag: NFAFragment = NFAFragment { start: 0, end: 0 }
  if is_literal == 1
    frag = regex_parse_literal(pattern_src, pattern_len, nfa)
  else
    frag = regex_parse(pattern_src, pattern_len, nfa)

  # Mark the end state as accepting with this token type
  let end_state: *NFAState = nfa.states + frag.end
  end_state.is_accept = 1
  end_state.token_type = token_type

  # Connect this pattern's start to the shared start via epsilon
  nfa_add_epsilon_trans(nfa, nfa.start_state, frag.start)

  lex.pattern_count = idx + 1
  (idx) as i32

# Finalize the lexer - build per-state transition index (Tier 1 NFA opt)
pub fn lexer_finalize(lex: *Lexer) -> i32
  # Patterns are already connected to start state during lexer_add_pattern.
  # Now build the state-indexed transition table so simulation can iterate
  # only this state's outgoing transitions (was 98.79% of compile time).
  nfa_finalize(lex.nfa)
  0

# =============================================================================
# NFA Simulation for Longest Match
# =============================================================================

# Try to match from current position, returns (token_type, match_length)
# Returns token_type = -1 if no match
# This uses a simple recursive simulation - not optimal but correct

# Helper: Check if we can reach an accepting state from given state
# Returns the token type if accepting, -1 otherwise
fn lexer_check_accept(lex: *Lexer, state: i32) -> i32
  let nfa: *NFA = lex.nfa
  let state_ptr: *NFAState = nfa.states + state

  if state_ptr.is_accept == 1
    return state_ptr.token_type

  # Check epsilon transitions (Tier 1: state-indexed lookup)
  let state_i64: i64 = state as i64
  let off: i64 = *(nfa.state_trans_offset + state_i64) as i64
  let cnt: i64 = *(nfa.state_trans_count + state_i64) as i64
  var k: i64 = 0
  while k < cnt
    let i: i64 = *(nfa.trans_indices + off + k) as i64
    let trans_ptr: *Transition = nfa.transitions + i
    if trans_ptr.kind == TR_EPSILON
      let result: i32 = lexer_check_accept(lex, trans_ptr.to_state)
      if result >= 0
        return result
    k = k + 1

  return -1

# Recursive match: try to match from state at position, track best match
# best_type and best_len are pointers to track the best match found so far
# best_priority tracks which pattern matched (lower priority number = higher priority)
fn lexer_match_from(lex: *Lexer, state: i32, pos: i64, best_type: *i32, best_len: *i32, best_priority: *i64) -> i32
  let nfa: *NFA = lex.nfa
  let state_ptr: *NFAState = nfa.states + state
  let current_len: i32 = (pos - lex.pos) as i32

  # Check if this state is accepting
  if state_ptr.is_accept == 1
    # Update best if this is longer, or same length but LOWER token type
    # Token numbering: Keywords are 10-26 (lower IDs), Identifiers are 53+ (higher IDs)
    # So we prefer LOWER token_type values for same-length matches (keywords > ident)
    # Special case: if best_type is -1 (no match yet), always update
    if current_len > (*best_len) or (current_len == (*best_len) and ((*best_type) < 0 or state_ptr.token_type < (*best_type)))
      (*best_type) = state_ptr.token_type
      (*best_len) = current_len
      (*best_priority) = 0  # Just reset, not used anymore

  # Try epsilon transitions first (without consuming input)
  # Tier 1: state-indexed lookup — only iterate this state's outgoing trans
  let state_i64: i64 = state as i64
  let off: i64 = *(nfa.state_trans_offset + state_i64) as i64
  let cnt: i64 = *(nfa.state_trans_count + state_i64) as i64
  var ke: i64 = 0
  while ke < cnt
    let ie: i64 = *(nfa.trans_indices + off + ke) as i64
    let trans_pe: *Transition = nfa.transitions + ie
    if trans_pe.kind == TR_EPSILON
      lexer_match_from(lex, trans_pe.to_state, pos, best_type, best_len, best_priority)
    ke = ke + 1

  # If at end of input, we're done with character transitions
  if pos >= lex.len
    return 0

  # Get current character
  let ch: i32 = (*(lex.src + pos)) & 255

  # Try character transitions
  var kc: i64 = 0
  while kc < cnt
    let ic: i64 = *(nfa.trans_indices + off + kc) as i64
    let trans_pc: *Transition = nfa.transitions + ic
    if trans_matches(trans_pc, ch) == 1
      lexer_match_from(lex, trans_pc.to_state, pos + 1, best_type, best_len, best_priority)
    kc = kc + 1

  0

# Debug: Print NFA structure to stderr
# NOTE: debug_print/debug_print_int must be defined by the main program
fn lexer_debug_nfa(debug: i32, nfa: *NFA) -> i32
  # Disabled for standalone tests - enable in main_new.ritz
  0

# Helper: get current character at position
fn lexer_peek_at(lex: *Lexer, offset: i32) -> i32
  let pos: i64 = lex.pos + offset
  if pos >= lex.len
    return 0  # EOF
  (*(lex.src + pos)) & 255

# Helper: skip a line comment (starting at #)
fn lexer_skip_comment(lex: *Lexer) -> i32
  while lex.pos < lex.len
    let ch: i32 = lexer_peek_at(lex, 0)
    if ch == 10  # newline
      return 0
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
  0

# Handle indentation at line start
# Returns: 1 if we should return a token, 0 if we should continue scanning
fn lexer_handle_indent(lex: *Lexer, out_tok: *Token) -> i32
  # Count leading spaces
  var indent: i32 = 0
  while lexer_peek_at(lex, indent) == 32  # space
    indent = indent + 1

  # Check for tab (error); ritz0's message.
  if lexer_peek_at(lex, indent) == 9  # tab
    lex.pos = lex.pos + indent
    lex.col = lex.col + indent
    return lexer_fail(lex, out_tok, c"Tabs not allowed for indentation; use spaces")

  # Skip blank lines (just newline after spaces)
  if lexer_peek_at(lex, indent) == 10  # newline
    lex.pos = lex.pos + indent + 1
    lex.line = lex.line + 1
    lex.col = 1
    # Stay at line start for next line
    return 0  # Continue scanning

  # Skip comment-only lines (but NOT @attributes)
  if lexer_peek_at(lex, indent) == 35  # '#'
    lex.pos = lex.pos + indent
    lex.col = lex.col + indent
    lexer_skip_comment(lex)
    # The main loop will handle the newline
    return 0  # Continue scanning

  # Advance past leading spaces
  lex.pos = lex.pos + indent
  lex.col = lex.col + indent
  lex.line_indent = indent

  # Get current indentation level from stack
  let current: i32 = lex.indent_stack[lex.indent_depth - 1]

  # A continuation (LARB R46) opens and closes no block.  `current` is its
  # statement's indentation: continuation lines push none.  ritz0's message,
  # at column 1.  After a `>` / `>>` (cont_line 2) only a deeper line is one.
  if lex.cont_line == 2 and indent <= current
    lex.cont_line = 0
  if lex.cont_line != 0
    lex.cont_line = 0
    lex.at_line_start = 0
    if indent < current
      lex.col = 1
      return lexer_fail(lex, out_tok, c"continuation line is indented less than the statement it continues; indent it at least as far as the statement's first line")
    return 0

  if indent > current
    # Deeper indentation - push and emit INDENT
    if lex.indent_depth >= MAX_INDENT_DEPTH
      return lexer_fail(lex, out_tok, c"blocks nested more than 64 levels deep")
    lex.indent_stack[lex.indent_depth] = indent
    lex.indent_depth = lex.indent_depth + 1
    *out_tok = token_new(TOK_INDENT, lex.pos, 0, lex.line, lex.col)
    lex.at_line_start = 0
    return 1

  if indent < current
    # Shallower indentation - pop and queue DEDENTs
    var count: i32 = 0
    while lex.indent_depth > 1
      if lex.indent_stack[lex.indent_depth - 1] <= indent
        break
      lex.indent_depth = lex.indent_depth - 1
      count = count + 1
    # Queue all but one DEDENT (we return the first one now)
    lex.pending_dedents = count - 1
    *out_tok = token_new(TOK_DEDENT, lex.pos, 0, lex.line, lex.col)
    lex.at_line_start = 0
    return 1

  # Same indentation - just continue
  lex.at_line_start = 0
  0

# Get next token from the lexer, noting the `if` / `match` inside brackets
# (LARB R46a) and the declaration keywords (LARB R46).
pub fn lexer_next(lex: *Lexer) -> Token
  var tok: Token = lexer_next_token(lex)
  # AGAST #3394: `asm ... :` NEWLINE starts an asm body.
  if tok.kind == TOK_ASM and lex.bracket_depth == 0
    lex.asm_line = 1
    lex.asm_base = lex.line_indent
  if tok.kind == TOK_NEWLINE and lex.asm_line == 1
    lex.asm_line = 0
    if lex.last_kind == TOK_COLON and lex.bracket_depth == 0
      lex.asm_raw = 1
      lex.asm_body = 0
  # LARB R46a: a `match` always opens a block; an `if` inside brackets waits
  # for its `then` (the newline check in lexer_next_token).
  if lex.bracket_depth > 0
    if tok.kind == TOK_MATCH
      return lexer_fail_block(lex, tok.start, tok.line, tok.col)
    if tok.kind == TOK_IF
      lex.if_line = tok.line
      lex.if_col = tok.col
      lex.if_start = tok.start
      lex.if_depth = lex.bracket_depth
    if tok.kind == TOK_THEN
      lex.if_line = 0
  if lex.bracket_depth == 0
    if tok.kind == TOK_FN or tok.kind == TOK_STRUCT or tok.kind == TOK_ENUM
      lex.decl_line = 1
    if tok.kind == TOK_IMPL or tok.kind == TOK_TRAIT or tok.kind == TOK_TYPE or tok.kind == TOK_EXTERN
      lex.decl_line = 1
  lex.last_kind = tok.kind
  tok

# Returns a Token struct
fn lexer_next_token(lex: *Lexer) -> Token
  # First, emit any pending DEDENTs
  if lex.pending_dedents > 0
    lex.pending_dedents = lex.pending_dedents - 1
    return token_new(TOK_DEDENT, lex.pos, 0, lex.line, lex.col)

  # Main lexing loop
  while lex.pos < lex.len
    # Handle line start (indentation) - but NOT inside brackets
    if lex.at_line_start == 1
      # Inside brackets, just skip leading whitespace, no INDENT/DEDENT
      if lex.bracket_depth > 0
        # Skip leading whitespace on this line
        lex.line_indent = 0
        while lex.pos < lex.len
          let ws: i32 = lexer_peek_at(lex, 0)
          if ws == 32  # space
            lex.pos = lex.pos + 1
            lex.col = lex.col + 1
            lex.line_indent = lex.line_indent + 1
          else
            break
        lex.at_line_start = 0
        continue
      var indent_tok: Token = token_new(TOK_ERROR, 0, 0, 0, 0)
      if lex.asm_raw == 1
        if lexer_asm_line_start(lex, @indent_tok) == 1
          return indent_tok
        continue
      if lexer_handle_indent(lex, @indent_tok) == 1
        return indent_tok
      continue  # Line was blank or comment-only, try again

    # Check for newline - emit NEWLINE token (but not inside brackets)
    let ch: i32 = lexer_peek_at(lex, 0)
    if ch == 10  # newline
      let start: i64 = lex.pos
      let line: i32 = lex.line
      let col: i32 = lex.col
      lex.pos = lex.pos + 1
      lex.line = lex.line + 1
      lex.col = 1
      lex.at_line_start = 1
      # Inside brackets, skip newline (don't emit token) - allows multi-line
      # struct literals.  An `if` here whose line ended before its `then`,
      # other than after an operator (its condition goes on), would open a
      # block (LARB R46a).
      if lex.bracket_depth > 0
        if lex.if_line != 0 and lex.if_depth == lex.bracket_depth and lexer_is_infix(lex.last_kind) == 0
          return lexer_fail_block(lex, lex.if_start, lex.if_line, lex.if_col)
        continue
      # Outside them, a line ending in an operator makes the next one a
      # continuation (LARB R46).
      lex.cont_line = lexer_ends_in_operator(lex)
      lex.decl_line = 0
      var tok: Token = token_new(TOK_NEWLINE, start, 1, line, col)
      tok.start = lex.src + start
      return tok

    # An asm body line is text (AGAST #3394).
    if lex.asm_raw == 1
      return lexer_asm_text(lex)

    # Check for inline comment - skip to end of line
    if ch == 35  # '#'
      lexer_skip_comment(lex)
      continue

    # Special case: String literals (workaround for NFA negation bug)
    # Pattern: "..." (anything except unescaped quotes)
    # We build a "cooked" string with escape sequences processed
    if ch == 34  # opening quote
      let start: i64 = lex.pos
      let line: i32 = lex.line
      let col: i32 = lex.col
      lex.pos = lex.pos + 1  # skip opening quote
      lex.col = lex.col + 1

      # Reset string buffer position for this string
      lexer_str_begin(lex)

      # Scan until closing quote, processing escapes into string_buf
      var found_close: i32 = 0
      while lex.pos < lex.len
        let str_ch: i32 = lexer_peek_at(lex, 0)
        if str_ch == 34  # closing quote
          found_close = 1
          lex.pos = lex.pos + 1
          lex.col = lex.col + 1
          break
        if str_ch == 10  # newline - unterminated string
          break

        # Check for escape sequence
        if str_ch == 92  # backslash
          lex.pos = lex.pos + 1
          lex.col = lex.col + 1
          if lex.pos < lex.len
            let esc_ch: i32 = lexer_peek_at(lex, 0)
            let cooked: i32 = lexer_cook_escape(esc_ch, 1)
            if cooked < 0
              return lexer_fail_escape(lex, lex.pos, lex.line, lex.col, esc_ch)
            # Store cooked char in buffer
            lexer_str_push(lex, cooked as i8)
            lex.pos = lex.pos + 1
            lex.col = lex.col + 1
        else
          # Regular character - copy as-is
          lexer_str_push(lex, str_ch as i8)
          lex.pos = lex.pos + 1
          lex.col = lex.col + 1

      if found_close == 1
        # A token's span length is bounded by Token.len, which is i32; the
        # *position* stays i64 (#1399). The narrowing is explicit so it is
        # visible, not so it is silent.
        let len: i32 = (lex.pos - start) as i32
        var tok: Token = token_new(TOK_STRING, start, len, line, col)
        tok.start = lex.src + start
        # Set cooked string pointer and length
        tok.string_val = lexer_str_finish(lex)
        tok.string_len = lex.string_pos
        return tok
      # If unterminated, fall through to error handling below

    # Try NFA-based pattern matching
    var best_type: i32 = -1
    var best_len: i32 = 0
    var best_priority: i64 = 9999  # Initialize to low priority
    let start_state_for_match: i32 = (*lex.nfa).start_state

    lexer_match_from(lex, start_state_for_match, lex.pos, @best_type, @best_len, @best_priority)

    # Only accept a match if we consumed at least one character
    if best_type < 0 or best_len <= 0
      # No match - return error token for single char
      let start: i64 = lex.pos
      let line: i32 = lex.line
      let col: i32 = lex.col
      lex.pos = lex.pos + 1
      lex.col = lex.col + 1
      var tok: Token = token_new(TOK_ERROR, start, 1, line, col)
      tok.start = lex.src + start
      return tok

    # Check if this is a skip token (whitespace, comments)
    # Skip tokens that should be ignored during parsing
    if best_type == TOK_SKIP or best_type == TOK_WHITESPACE or best_type == TOK_COMMENT
      # Skip this token and continue (suppress debug output)
      lex.pos = lex.pos + best_len
      lex.col = lex.col + best_len
      continue

    # AGAST #3232: a number straight after `.` is a tuple field index, never
    # a float, so `p.0.1` is p . 0 . 1. The NFA's `[0-9]+\.[0-9]+` took `0.1`
    # there as one TOK_FLOAT. Cut it back to its leading digits, a bare
    # TOK_NUMBER, as ritz0 does (#2284); the next call lexes `.` then `1`.
    if best_type == TOK_FLOAT and lex.last_kind == TOK_DOT
      var int_len: i32 = 0
      while int_len < best_len and *(lex.src + lex.pos + int_len) != 46  # '.'
        int_len = int_len + 1
      best_type = TOK_NUMBER
      best_len = int_len

    # AGAST #107: typed integer-literal suffix.
    # Absorb optional `[uUiI](8|16|32|64|size)` after a TOK_NUMBER so that
    # `0u8`, `123u16`, `0usize`, `0x10i32` lex as one number token. The
    # suffix is only consumed when not followed by another alnum/underscore
    # char (so `5usize_max` stays split as `5` + ident).
    # parse_int() (ast_helpers) still sees the suffix chars, so the parse
    # site uses int_lit_len() to trim the suffix before parsing digits.
    if best_type == TOK_NUMBER
      let sfx_pos: i64 = lex.pos + best_len
      if sfx_pos < lex.len
        let s0: i32 = *(lex.src + sfx_pos) & 255
        # 'u'=117, 'U'=85, 'i'=105, 'I'=73
        if s0 == 117 or s0 == 85 or s0 == 105 or s0 == 73
          var ext: i32 = 0
          # "size" (4 chars after prefix)
          if sfx_pos + 4 < lex.len
            let c1: i32 = *(lex.src + sfx_pos + 1) & 255
            let c2: i32 = *(lex.src + sfx_pos + 2) & 255
            let c3: i32 = *(lex.src + sfx_pos + 3) & 255
            let c4: i32 = *(lex.src + sfx_pos + 4) & 255
            # 's'=115, 'i'=105, 'z'=122, 'e'=101
            if c1 == 115 and c2 == 105 and c3 == 122 and c4 == 101
              ext = 5
          # "16" | "32" | "64" (2 chars after prefix)
          if ext == 0 and sfx_pos + 2 < lex.len
            let c1: i32 = *(lex.src + sfx_pos + 1) & 255
            let c2: i32 = *(lex.src + sfx_pos + 2) & 255
            # '1'=49 '6'=54 | '3'=51 '2'=50 | '6'=54 '4'=52
            if c1 == 49 and c2 == 54
              ext = 3
            else if c1 == 51 and c2 == 50
              ext = 3
            else if c1 == 54 and c2 == 52
              ext = 3
          # "8" (1 char after prefix)
          if ext == 0 and sfx_pos + 1 < lex.len
            let c1: i32 = *(lex.src + sfx_pos + 1) & 255
            if c1 == 56  # '8'
              ext = 2
          # Edge case: suffix at very end of buffer. sfx_pos+1 == lex.len
          # means the prefix char itself is the last byte — not a suffix.
          if ext > 0
            let after: i64 = sfx_pos + ext
            var ok: i32 = 1
            if after < lex.len
              let ac: i32 = *(lex.src + after) & 255
              # a-z, A-Z, 0-9, or '_' → suffix is actually part of a
              # longer identifier like `usize_max`; don't consume.
              if (ac >= 97 and ac <= 122) or (ac >= 65 and ac <= 90) or (ac >= 48 and ac <= 57) or ac == 95
                ok = 0
            if ok == 1
              best_len = best_len + ext

    # AGAST #1615: float-literal suffix. Absorb `f32` / `f64` after a
    # TOK_FLOAT so `2.5f32` lexes as one token. expr_float() trims the
    # suffix off and casts the literal to it, as ritz0 does. No follow-char
    # guard (unlike the integer suffixes, where `5usize_max` must stay split):
    # an identifier char straight after a float is refused either way —
    # `2.5f32x` lexes as `2.5f32` + `x`, a parse error.
    if best_type == TOK_FLOAT and lex.pos + best_len + 2 < lex.len
      let fp: i64 = lex.pos + best_len
      let f0: i32 = *(lex.src + fp) & 255
      let f1: i32 = *(lex.src + fp + 1) & 255
      let f2: i32 = *(lex.src + fp + 2) & 255
      # 'f'=102; '3'=51 '2'=50 | '6'=54 '4'=52
      if f0 == 102 and ((f1 == 51 and f2 == 50) or (f1 == 54 and f2 == 52))
        best_len = best_len + 3

    # Check for c"..." string prefix.
    # If the NFA matched a 1-char identifier 'c' and next char is '"',
    # scan it as a c-string literal.
    # (AGAST #98: the s"..." prefix was removed — bare "..." produces
    # StrView which is layout-compatible with the old Span<u8> semantics.)
    if best_type == TOK_IDENT and best_len == 1 and lex.pos + 1 < lex.len and *(lex.src + lex.pos + 1) == 34
        let prefix_ch: i32 = *(lex.src + lex.pos)
        if prefix_ch == 99
            let start: i64 = lex.pos
            let line: i32 = lex.line
            let col: i32 = lex.col
            lex.pos = lex.pos + 2  # skip prefix + opening quote
            lex.col = lex.col + 2
            lexer_str_begin(lex)
            var found_close: i32 = 0
            while lex.pos < lex.len
                let str_ch: i32 = lexer_peek_at(lex, 0)
                if str_ch == 34  # closing quote
                    found_close = 1
                    lex.pos = lex.pos + 1
                    lex.col = lex.col + 1
                    break
                if str_ch == 10  # newline - unterminated
                    break
                if str_ch == 92  # backslash escape
                    lex.pos = lex.pos + 1
                    lex.col = lex.col + 1
                    if lex.pos < lex.len
                        let esc_ch: i32 = lexer_peek_at(lex, 0)
                        let cooked: i32 = lexer_cook_escape(esc_ch, 0)
                        if cooked < 0
                            return lexer_fail_escape(lex, lex.pos, lex.line, lex.col, esc_ch)
                        lexer_str_push(lex, cooked as i8)
                        lex.pos = lex.pos + 1
                        lex.col = lex.col + 1
                else
                    lexer_str_push(lex, str_ch as i8)
                    lex.pos = lex.pos + 1
                    lex.col = lex.col + 1
            if found_close == 1
                # A token's span length is bounded by Token.len, which is i32; the
                # *position* stays i64 (#1399). The narrowing is explicit so it is
                # visible, not so it is silent.
                let len: i32 = (lex.pos - start) as i32
                var tok: Token = token_new(TOK_CSTRING, start, len, line, col)
                tok.start = lex.src + start
                tok.string_val = lexer_str_finish(lex)
                tok.string_len = lex.string_pos
                return tok

    # Create and return the token
    let start: i64 = lex.pos
    let line: i32 = lex.line
    let col: i32 = lex.col

    # Advance position
    lex.pos = lex.pos + best_len
    lex.col = lex.col + best_len

    # Track bracket depth for suppressing INDENT/DEDENT inside brackets
    if best_type == TOK_LPAREN or best_type == TOK_LBRACKET or best_type == TOK_LBRACE
      if lex.bracket_depth >= MAX_BRACKET_DEPTH
        var err: Token = token_new(TOK_ERROR, 0, 1, line, col)
        err.start = lex.src + start
        lex.error_msg = c"brackets nested more than 64 levels deep"
        lex.pos = lex.len
        lex.pending_dedents = 0
        return err
      lex.bracket_kinds[lex.bracket_depth] = *(lex.src + start)
      lex.bracket_depth = lex.bracket_depth + 1
    if best_type == TOK_RPAREN or best_type == TOK_RBRACKET or best_type == TOK_RBRACE
      if lex.bracket_depth > 0
        lex.bracket_depth = lex.bracket_depth - 1

    # Create token with proper start pointer
    var tok: Token = token_new(best_type, start, best_len, line, col)
    # Set the start pointer to point into the source buffer
    tok.start = lex.src + start

    # CSTRING / STRING cooking after NFA match.  The NFA only knows the
    # raw byte span; tokens have a separate `string_val/string_len` slot
    # for the cooked (escape-processed) content, which expr_string reads.
    # Without this pass the cooked slot stays null and `c"hello"` lowers
    # to an empty string at emit time.  The special-case CSTRING-via-
    # IDENT-prefix path above is the legacy workaround for when the NFA
    # negation bug masked CSTRING matches; with the negation fixed,
    # CSTRING wins the longest match and we cook here.
    # A char literal `'\X'` is cooked later, by expr_char; reject an unknown
    # escape here so it is a located lexer error like the string kinds.
    if best_type == TOK_CHAR and best_len == 4 and ((*(lex.src + start + 1)) & 255) == 92
      let esc: i32 = (*(lex.src + start + 2)) & 255
      if lexer_cook_escape(esc, 1) < 0
        return lexer_fail_escape(lex, start + 2, line, col + 2, esc)
    if best_type == TOK_CSTRING or best_type == TOK_STRING
      var prefix: i32 = 1  # default: `"`
      var braces: i32 = 1
      if best_type == TOK_CSTRING
        prefix = 2  # `c"`
        braces = 0
      var i: i32 = prefix
      lexer_str_begin(lex)
      while i < best_len - 1  # stop before closing quote
        let raw: i32 = (*(lex.src + start + i)) & 255
        if raw == 92 and i + 1 < best_len - 1  # backslash escape
          let esc: i32 = (*(lex.src + start + i + 1)) & 255
          let cooked: i32 = lexer_cook_escape(esc, braces)
          if cooked < 0
            return lexer_fail_escape(lex, start + i + 1, line, col + i + 1, esc)
          lexer_str_push(lex, cooked as i8)
          i = i + 2
        else
          lexer_str_push(lex, raw as i8)
          i = i + 1
      tok.string_val = lexer_str_finish(lex)
      tok.string_len = lex.string_pos
    return tok

  # End of input - emit any remaining DEDENTs
  if lex.indent_depth > 1
    lex.indent_depth = lex.indent_depth - 1
    return token_new(TOK_DEDENT, lex.pos, 0, lex.line, lex.col)

  # Finally return EOF
  token_new(TOK_EOF, lex.pos, 0, lex.line, lex.col)
